Chapter: Bench Collatz
  cites Foreword chapter Console
  cites Foreword chapter MathLib

Section: Definitions

  collatz : Integer, Integer -> Integer
  collatz (n) (steps) = if n == 1 then steps else if math-mod n 2 == 0 then collatz (n / 2) (steps + 1) else collatz (3 * n + 1) (steps + 1)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (collatz 837799 0))
  end

