Chapter: Bench Tak
  cites Foreword chapter Console

Section: Definitions

  tak : Integer, Integer, Integer -> Integer
  tak (x) (y) (z) = if y >= x then z else tak (tak (x - 1) y z) (tak (y - 1) z x) (tak (z - 1) x y)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (tak 24 16 8))
  end

