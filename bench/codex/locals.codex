Chapter: Bench Locals
  cites Foreword chapter Console

Section: Definitions

  compute : Integer, Integer -> Integer
  compute (n) (acc) =
    if n == 0 then acc
    else
      let a = n + 1
      in let b = n * 2
      in let c = n - 3
      in let d = a * b
      in let e = b + c
      in let f = c * a
      in compute (n - 1) (acc + d + e + f)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (compute 1000 0))
  end

