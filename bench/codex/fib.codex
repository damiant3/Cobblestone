Chapter: Bench Fib
  cites Foreword chapter Console
  cites Codex chapter General

Section: Definitions

  fib : Integer -> Integer
  fib (n) = if n == 0 then 0 else if n == 1 then 1 else fib (n - 1) + fib (n - 2)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (fib 35))
  end

