Chapter: Bench Ack
  cites Foreword chapter Console

Section: Definitions

  ack : Integer, Integer -> Integer
  ack (m) (n) = if m == 0 then n + 1 else if n == 0 then ack (m - 1) 1 else ack (m - 1) (ack m (n - 1))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (ack 3 9))
  end

