Section: Body

  opening : [Console] Nothing = act
    print-line (fmt-pad-left "hi" 6 " ")
    print-line (fmt-pad-right "hi" 6 ".")
    print-line (fmt-center "hi" 8 "-")
    print-line (fmt-repeat "ab" 3)
    print-line (fmt-join ["a", "b", "c"] ", ")
    print-line (fmt-commas 1234567)
    print-line (fmt-commas 42)
    print-line (fmt-commas (0 - 9876543))
    print-line (fmt-fixed-width 7 4)
    print-line (fmt-hex 255)
    print-line (fmt-hex 4096)
    print-line (fmt-hex-pad 15 4)
    print-line (fmt-bool True)
    print-line (fmt-yes-no False)
  end

