Chapter: TomlTest
  cites Encode chapter Toml
  cites Foreword chapter Maybe

Section: Body

  opening : [Console] Nothing = act
    let input = "title = \"My Config\"\nport = 8080\ndebug = true\n"
    in when toml-parse input
      is Just (v) ->
        act
          print-line ("title=" & toml-get-str v "title" "?")
          print-line ("port=" & show (toml-get-int v "port" 0))
          print-line ("debug=" & if toml-get-bool v "debug" False then "true" else "false")
          print-line ("missing=" & toml-get-str v "nope" "default")
          let emitted = toml-emit v
          in print-line ("emit-ok=" & if text-length emitted > 0 then "yes" else "no")
        end
      is None -> print-line "parse=fail"
  end

