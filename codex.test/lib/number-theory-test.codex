Chapter: NumberTheoryTest
  cites Foreword chapter NumberTheory

Section: Body

  opening : [Console] Nothing = act
    print-line ("gcd(12,8)=" & show (gcd 12 8))
    print-line ("gcd(17,13)=" & show (gcd 17 13))
    print-line ("lcm(4,6)=" & show (lcm 4 6))
    print-line ("lcm(7,5)=" & show (lcm 7 5))
    print-line ("mod-exp(2,10,1000)=" & show (mod-exp 2 10 1000))
    print-line ("mod-exp(3,7,100)=" & show (mod-exp 3 7 100))
    print-line ("is-prime(2)=" & show-bool (is-prime 2))
    print-line ("is-prime(17)=" & show-bool (is-prime 17))
    print-line ("is-prime(15)=" & show-bool (is-prime 15))
    print-line ("is-prime(1)=" & show-bool (is-prime 1))
    print-line ("primes=" & show (list-length (primes-up-to 30)))
    print-line ("totient(12)=" & show (euler-totient 12))
    print-line ("factors(60)=" & show (list-length (factor 60)))
    print-line ("mod-inv(3,7)=" & show (mod-inverse 3 7))
  end

  show-bool : Boolean -> Text
  show-bool (b) = if b then "true" else "false"

