Chapter: NumericTest
  cites Math chapter Numeric

Section: Body

  test-f : Integer -> Integer
  test-f (x) = x * x - 4000

  test-df : Integer -> Integer
  test-df (x) = 2 * x

  test-ode : Integer, Integer -> Integer
  test-ode (t) (y) = 0 - y

  opening : [Console] Nothing = act
    let root = bisect test-f 0 4000 50
    in print-line ("bisect=" & show root)
    let newton-root = newton test-f test-df 3000 20
    in print-line ("newton=" & show newton-root)
    let trap = integrate-trapezoid (\x -> x * x / 1000) 0 3000 100
    in print-line ("trap=" & show trap)
    let simp = integrate-simpson (\x -> x * x / 1000) 0 3000 100
    in print-line ("simpson=" & show simp)
    let step = rk4-step test-ode 0 1000 100
    in print-line ("rk4-t=" & show (step.rk-t))
    let rk-ok = if step.rk-y < 1000 then "decaying" else "wrong"
    in print-line ("rk4-y=" & rk-ok)
    let solution = rk4-solve test-ode 0 1000 1000 10
    in print-line ("rk4-steps=" & show (list-length solution))
  end

