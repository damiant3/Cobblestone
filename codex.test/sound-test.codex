Chapter: SoundTest
  cites Codex chapter General
  cites Signal chapter Oscillator
  cites Signal chapter AudioEffect
  cites Signal chapter MusicTheory
  cites Foreword chapter CircularBuffer
  cites Foreword chapter Maybe

Section: Body

  test-osc-bank : Text =
    let bank = osc-add (osc-add (osc-bank-new 8000) 440 500 osc-type-sine 0) 880 300 osc-type-square 0
    in let samples = osc-bank-render bank 16
    in "bank: count=" & show (bank.ob-count) & " samples=" & show (list-length samples) & " peak=" & show (osc-peak samples)

  test-fm : Text =
    let samples = osc-fm-render 440 110 200 1000 8000 16
    in "fm: samples=" & show (list-length samples) & " peak=" & show (osc-peak samples)

  test-pulse : Text =
    let bank = osc-add (osc-bank-new 8000) 440 1000 osc-type-pulse 250
    in let samples = osc-bank-render bank 8
    in "pulse: peak=" & show (osc-peak samples)

  test-distortion : Text =
    let input = [500, 800, 1200, 400, 0 - 600, 0 - 1000]
    in let output = fx-distortion input 2000
    in let peak = fx-find-peak output 0 (list-length output) 0
    in "dist: peak=" & show peak & " clipped=" & show (peak <= 1000)

  test-compress : Text =
    let input = [200, 500, 800, 1200, 1500]
    in let output = fx-compress input 500 4000
    in let last = list-at output 4
    in "comp: last=" & show last & " reduced=" & show (last < 1500)

  test-eq : Text =
    let input = [1000, 0 - 500, 800, 0 - 300, 600]
    in let output = fx-eq3 input 500 1000 1500
    in "eq: samples=" & show (list-length output)

  test-note-freq : Text =
    let a4 = note-freq 69
    in let c4 = note-freq 60
    in "A4=" & show a4 & "Hz C4=" & show c4 & "Hz"

  test-scale : Text =
    let cmaj = scale-major 60
    in "C-major=" & show (list-length cmaj) & " notes"

  test-chord : Text =
    "Cmaj=" & format-chord (chord-major 60) & " Amin=" & format-chord (chord-minor 69)

  test-tempo : Text =
    let quarter = mt-note-duration 120 4
    in let eighth = mt-note-duration 120 8
    in "quarter=" & show quarter & "ms eighth=" & show eighth & "ms"

  opening : [Console] Nothing = act
    print-line test-osc-bank
    print-line test-fm
    print-line test-pulse
    print-line test-distortion
    print-line test-compress
    print-line test-eq
    print-line test-note-freq
    print-line test-scale
    print-line test-chord
    print-line test-tempo
  end

