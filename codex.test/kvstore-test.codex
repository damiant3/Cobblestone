Chapter: KvStoreTest
  cites Codex chapter General
  cites Foreword chapter KvStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe

Section: Body

  test-basic : Text =
    let s = kv-put (kv-put kv-empty "name" "codex") "version" "1.0"
    in "size=" & show (kv-size s) & " " & format-kv s "name" & " " & format-kv s "version"

  test-overwrite : Text =
    let s = kv-put (kv-put kv-empty "x" "old") "x" "new"
    in "size=" & show (kv-size s) & " " & format-kv s "x"

  test-delete : Text =
    let s = kv-delete (kv-put (kv-put kv-empty "a" "1") "b" "2") "a"
    in "size=" & show (kv-size s) & " has-a=" & show (kv-has s "a") & " has-b=" & show (kv-has s "b")

  test-get-or : Text =
    let s = kv-put kv-empty "x" "42"
    in "x=" & kv-get-or s "x" "0" & " y=" & kv-get-or s "y" "default"

  test-bulk : Text =
    let s = kv-put-all kv-empty ["a", "b", "c"] ["1", "2", "3"]
    in "bulk=" & show (kv-size s) & " " & format-kv s "b"

  opening : [Console] Nothing = act
    print-line test-basic
    print-line test-overwrite
    print-line test-delete
    print-line test-get-or
    print-line test-bulk
  end

