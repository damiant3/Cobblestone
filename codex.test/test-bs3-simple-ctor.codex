Chapter: TestSimple

Section: Types
  Box (a) =
   | Wrap (a)

  Thing = record {
   name : Text,
   body : Text
  }

Section: Defs
  extract : Box Thing -> Text
  extract (m) =
   when m
    is Wrap (t) -> t.name

  opening : [Console] Nothing = act
   let sample = Wrap (Thing { name = "hi", body = "b" })
   in print-line (extract sample)
  end
