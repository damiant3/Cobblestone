Chapter: PolyRuntime

  cites Codex chapter General

  cites Codex chapter Text



Section: Identity and constant

  id : a -> a

  id (x) = x



  const-fn : a, b -> a

  const-fn (x) (y) = x



Section: Maybe-like

  Opt (a) =

   | Some (a)

   | Nada



  opt-map : (a -> b), Opt a -> Opt b

  opt-map (f) (m) = when m

    is Some (x) -> Some (f x)

    is Nada -> Nada



  opt-or : a, Opt a -> a

  opt-or (d) (m) = when m

    is Some (x) -> x

    is Nada -> d



Section: Record

  Box (a) = record { value : a }



  unbox : Box a -> a

  unbox (b) = b.value



  rebox : (a -> b), Box a -> Box b

  rebox (f) (b) = Box { value = f (b.value) }



Section: Nested pair

  Pair-r (a) (b) = record { first : a, second : b }



  swap-pair : Pair-r a b -> Pair-r b a

  swap-pair (p) = Pair-r { first = p.second, second = p.first }



Section: Higher order

  apply-fn : (a -> b), a -> b

  apply-fn (f) (x) = f x



  inc : Integer -> Integer

  inc (n) = n + 1



Section: Driver

  opening : [Console] Nothing = act

    print-line ("id: " & show (id 7))

    print-line ("const: " & show (const-fn 42 99))

    print-line ("opt-map Some: " & show (opt-or 0 (opt-map inc (Some 41))))

    print-line ("opt-map Nada: " & show (opt-or 0 (opt-map inc Nada)))

    print-line ("unbox: " & show (unbox (Box { value = 123 })))

    print-line ("rebox: " & show (unbox (rebox inc (Box { value = 41 }))))

    print-line ("swap first: " & (swap-pair (Pair-r { first = 10, second = "hi" })).first)

    print-line ("swap second: " & show (swap-pair (Pair-r { first = 10, second = "hi" })).second)

    print-line ("apply-fn: " & show (apply-fn inc 41))

  end



