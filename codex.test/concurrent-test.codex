Chapter: Concurrent Test



  cites Foreword chapter Console

  cites Foreword chapter Concurrent

  cites Foreword chapter Maybe



Section: Definitions



  square : Integer -> Integer

  square (x) = x * x



  is-even : Integer -> Boolean

  is-even (n) = n - (n / 2) * 2 == 0



  show-list : List Integer -> Text

  show-list (xs) = show-list-loop xs 0 (list-length xs) ""



  show-list-loop : List Integer, Integer, Integer, Text -> Text

  show-list-loop (xs) (i) (len) (acc) =

    if i == len then acc

    else if i == 0 then show-list-loop xs 1 len (show (list-at xs 0))

    else show-list-loop xs (i + 1) len (acc & " " & show (list-at xs i))



  add : Integer, Integer -> Integer

  add (a) (b) = a + b



  test-concurrent : Text =

    let squared = par-map square [1, 2, 3, 4, 5]

    in let sum = par-reduce add 0 [10, 20, 30, 40]

    in let evens = par-filter is-even [1, 2, 3, 4, 5, 6]

    in let doubled = par-pipeline square (\x -> x + 1) [1, 2, 3]

    in let zipped = par-zip-with add [1, 2, 3] [10, 20, 30]

    in let r = race [\dummy -> 42]

    in let rv = when r

      is Just (v) -> show v

      is None -> "none"

    in show-list squared & "\n" & show sum & "\n" & show-list evens & "\n" & show-list doubled & "\n" & show-list zipped & "\n" & rv



  opening : [Console, Concurrent] Nothing = act

    print-line test-concurrent

  end



