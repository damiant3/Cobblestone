Chapter: ForkCapture

  cites Codex chapter Concurrency



Section: Definitions



  make-thunk : Integer, Nothing -> Integer

  make-thunk (n) (x) = n * 2



  opening : [Concurrent] Integer = act

    t1 <- fork (make-thunk 10)

    t2 <- fork (make-thunk 11)

    a <- await t1

    b <- await t2

    a + b

  end



