  cites Foreword chapter CCE

Section: Definitions

  show-index : Maybe Integer -> Text
  show-index (r) = when r
    is Just (i) -> show i
    is None -> "none"

  opening : [Console] Nothing = act
    print-line (show (text-contains "hello world" "world"))
    print-line (show (text-contains "hello world" "xyz"))
    print-line (show (starts-with "hello world" "hello"))
    print-line (show (ends-with "hello world" "world"))
    print-line (show-index (index-of "abcdef" "cd"))
    print-line (show-index (index-of "abcdef" "zz"))
    print-line (text-trim "  spaces  ")
    print-line (show (count-occurrences "abababab" "ab"))
    print-line (text-to-upper "hello")
    print-line (text-to-lower "WORLD")
  end

