Chapter: CircBufTest
  cites Codex chapter General
  cites Foreword chapter CircularBuffer
  cites Foreword chapter Maybe

Section: Body

  test-push-pop : Text =
    let b = circbuf-push-back (circbuf-push-back (circbuf-push-back (circbuf-new 5) 10) 20) 30
    in let f = circbuf-front b
    in let bk = circbuf-back b
    in when f is Just (fv) -> when bk is Just (bv) -> "count=" & show (circbuf-count b) & " front=" & show fv & " back=" & show bv is None -> "bk-none" is None -> "f-none"

  test-overflow : Text =
    let b = circbuf-push-back (circbuf-push-back (circbuf-push-back (circbuf-push-back (circbuf-new 3) 1) 2) 3) 4
    in let f = circbuf-front b
    in when f is Just (fv) -> "overflow front=" & show fv & " count=" & show (circbuf-count b) is None -> "none"

  test-pop : Text =
    let b = circbuf-pop-front (circbuf-push-back (circbuf-push-back (circbuf-new 5) 10) 20)
    in let f = circbuf-front b
    in when f is Just (fv) -> "after-pop=" & show fv & " count=" & show (circbuf-count b) is None -> "empty"

  test-to-list : Text =
    let b = circbuf-push-back (circbuf-push-back (circbuf-push-back (circbuf-new 5) 1) 2) 3
    in let lst = circbuf-to-list b
    in "list=" & show (list-at lst 0) & "," & show (list-at lst 1) & "," & show (list-at lst 2)

  test-sum : Text =
    let b = circbuf-push-back (circbuf-push-back (circbuf-push-back (circbuf-new 10) 100) 200) 300
    in "sum=" & show (circbuf-sum b)

  opening : [Console] Nothing = act
    print-line test-push-pop
    print-line test-overflow
    print-line test-pop
    print-line test-to-list
    print-line test-sum
  end

