Chapter: ImageCodecTest
  cites Codex chapter General
  cites Encode chapter Gif
  cites Encode chapter Png
  cites Encode chapter Tiff
  cites Encode chapter Jpeg
  cites Encode chapter Crc32
  cites Game chapter Color
  cites Foreword chapter CCE

Section: Body

  test-pixels : List Rgb
  test-pixels = [rgb 255 0 0, rgb 0 255 0, rgb 0 0 255, rgb 255 255 0]

  test-gif : Text =
    let pal = gif-default-palette
    in let indices = [224, 28, 3, 252]
    in let encoded = gif-encode 2 2 pal indices
    in let magic = list-at encoded 0
    in "gif: size=" & show (list-length encoded) & " magic=" & show magic

  test-png : Text =
    let encoded = png-encode 2 2 test-pixels
    in let sig0 = list-at encoded 0
    in let sig1 = list-at encoded 1
    in "png: size=" & show (list-length encoded) & " sig=" & show sig0 & "," & show sig1

  test-tiff : Text =
    let encoded = tiff-encode 2 2 test-pixels
    in let byte-order = list-at encoded 0
    in let magic = list-at encoded 2
    in "tiff: size=" & show (list-length encoded) & " bo=" & show byte-order & " magic=" & show magic

  test-jpeg : Text =
    let encoded = jpeg-encode-gray 8 8 (jpeg-test-pixels 64 0 []) 75
    in let soi0 = list-at encoded 0
    in let soi1 = list-at encoded 1
    in "jpeg: size=" & show (list-length encoded) & " soi=" & show soi0 & "," & show soi1

  jpeg-test-pixels : Integer, Integer, List Rgb -> List Rgb
  jpeg-test-pixels (n) (i) (acc) =
    if i >= n then acc
    else jpeg-test-pixels n (i + 1) (list-push acc (rgb 128 128 128))

  opening : [Console] Nothing = act
    print-line test-gif
    print-line test-png
    print-line test-tiff
    print-line test-jpeg
  end

