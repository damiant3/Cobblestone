Chapter: List Test
  cites Codex chapter General

  cites Foreword chapter List

Section: Definitions

  double : Integer -> Integer
  double (n) = n * 2

  is-even : Integer -> Boolean
  is-even (n) = (n / 2) * 2 == n

  add : Integer, Integer -> Integer
  add (a) (b) = a + b

  show-list : ConsList Integer -> Text
  show-list (xs) = when xs
    is Cons (h) (t) -> if cl-is-empty t then show h else show h & ", " & show-list t
    is Nil -> ""

  check : Text, Text, Text -> Text
  check (name) (actual) (expected) =
    if actual == expected then "PASS: " & name
    else "FAIL: " & name & " expected [" & expected & "] got [" & actual & "]"

  nums : ConsList Integer = cl-cons 1 (cl-cons 2 (cl-cons 3 (cl-cons 4 (cl-cons 5 cl-nil))))

  opening : [Console] Nothing = act
    print-line "=== ConsList Prelude Module ==="
    print-line ""
    print-line (check "length" (show (cl-length nums)) "5")
    print-line (check "head" (show (cl-head nums)) "1")
    print-line (check "tail length" (show (cl-length (cl-tail nums))) "4")
    print-line (check "map double" (show-list (cl-map double nums)) "2, 4, 6, 8, 10")
    print-line (check "filter even" (show-list (cl-filter is-even nums)) "2, 4")
    print-line (check "foldl sum" (show (cl-foldl add 0 nums)) "15")
    print-line (check "reverse" (show-list (cl-reverse nums)) "5, 4, 3, 2, 1")
    print-line (check "append" (show-list (cl-append (cl-cons 1 (cl-cons 2 cl-nil)) (cl-cons 3 (cl-cons 4 cl-nil)))) "1, 2, 3, 4")
    print-line (check "take 3" (show-list (cl-take 3 nums)) "1, 2, 3")
    print-line (check "drop 3" (show-list (cl-drop 3 nums)) "4, 5")
    print-line (check "any even" (show (cl-any is-even nums)) "True")
    print-line (check "all even" (show (cl-all is-even nums)) "False")
    print-line (check "sum" (show (cl-sum nums)) "15")
    print-line (check "is-empty nil" (show (cl-is-empty cl-nil)) "True")
    print-line (check "is-empty cons" (show (cl-is-empty nums)) "False")
    print-line ""
    print-line "All PASS = functional cons-list with map, filter, fold, reverse, take, drop."
  end

