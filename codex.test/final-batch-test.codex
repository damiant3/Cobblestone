  cites Foreword chapter Maybe

Section: Body

  test-schedule : Text =
    let parsed = schedule "daily at 9:30am"
    in when parsed
      is Just (s) -> let matches = sched-matches s 0 1 15 9 30
        in let no-match = sched-matches s 0 1 15 10 0
        in "sched: " & format-sched s & " match=" & show matches & " no=" & show no-match
      is None -> "sched: parse failed"

  test-sched-pm : Text =
    let parsed = schedule "daily at 2:30 pm"
    in when parsed
      is Just (s) -> "pm: " & format-sched s & " match=" & show (sched-matches s 0 1 15 14 30)
      is None -> "pm: parse failed"

  test-sched-every : Text =
    let parsed = schedule "every 5 minutes"
    in when parsed
      is Just (s) -> let m1 = sched-matches s 300 0 1 0 5
        in "every-5m: " & format-sched s & " @300=" & show m1
      is None -> "every: parse failed"

  test-sched-weekly : Text =
    let parsed = schedule "weekly on monday at 2pm"
    in when parsed
      is Just (s) -> "weekly: " & format-sched s
      is None -> "weekly: parse failed"

  test-sched-between : Text =
    let parsed = schedule "every 30 minutes between 9am and 5pm"
    in when parsed
      is Just (s) -> "between: " & format-sched s
      is None -> "between: parse failed"

  test-pattern : Text =
    let p = pattern "letters @ letters"
    in let r = pat-match p "user@host" 0
    in "pattern: " & format-match r

  test-pat-digits : Text =
    let p = pattern "digits"
    in let r = pat-match p "12345abc" 0
    in "digits: " & format-match r

  test-pat-english : Text =
    let p = pattern "optional - digits"
    in let r1 = pat-match p "42" 0
    in let r2 = pat-match p "-7" 0
    in "optional: pos=" & show (r1.mr-consumed) & " neg=" & show (r2.mr-consumed)

  test-pat-find : Text =
    let p = pattern "world"
    in let pos = pat-find p "hello world"
    in "find: pos=" & show pos

  test-rate-limiter : Text =
    let bucket = tb-new 10 5
    in let after = tb-try-consume bucket 3 0
    in "rl: " & format-tb after

  test-rate-burst : Text =
    let bucket = tb-new 5 1
    in let b1 = tb-try-consume bucket 5 0
    in let can = tb-can-consume b1 1 0
    in let can2 = tb-can-consume b1 1 2000
    in "burst: empty=" & show can & " after-2s=" & show can2

  test-cms : Text =
    let s0 = cms-new 100 4
    in let s1 = cms-add (cms-add (cms-add s0 "hello" 1) "world" 1) "hello" 1
    in "cms: hello=" & show (cms-count s1 "hello") & " world=" & show (cms-count s1 "world") & " " & format-cms s1

  test-geo : Text =
    let london = geo-point 51507 (0 - 127)
    in let paris = geo-point 48857 2352
    in let dist = geo-distance london paris
    in "geo: london-paris=" & show dist & "m"

  test-geo-bounds : Text =
    let center = geo-point 40712 (0 - 74006)
    in let bounds = geo-bounds center 10000
    in "bounds: " & format-geo-bounds bounds

  opening : [Console] Nothing = act
    print-line test-schedule
    print-line test-sched-pm
    print-line test-sched-every
    print-line test-sched-weekly
    print-line test-sched-between
    print-line test-pattern
    print-line test-pat-digits
    print-line test-pat-english
    print-line test-pat-find
    print-line test-rate-limiter
    print-line test-rate-burst
    print-line test-cms
    print-line test-geo
    print-line test-geo-bounds
  end

