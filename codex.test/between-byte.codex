Chapter: BetweenByte

Section: Types

  Counter = record {
    n : Integer between 0 and 255
  }

Section: Definitions

  bump : Counter -> Counter
  bump (c) = __record-set c "n" (__narrow (c.n + 1))

  opening : Integer =
   let c0 = Counter { n = 5 }
   in let c1 = bump c0
   in c1.n

