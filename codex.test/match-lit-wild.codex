Chapter: MatchLitWild
  cites Codex chapter General

Section: Definitions

  classify : Integer -> Text
  classify (n) = when n
    is 0 -> "zero"
    is 1 -> "one"
    is 42 -> "answer"
    is otherwise -> "other"

  opening : Text = classify 42 & "/" & classify 1 & "/" & classify 99

