Chapter: RasterizerTest
  cites Codex chapter General
  cites Game chapter Rasterizer
  cites Math chapter Geometry
  cites Math chapter Quaternion
  cites Game chapter Bresenham

Section: Body

  test-framebuf : Text =
    let fb = fb-new 10 10 0
    in let fb2 = fb-set fb 5 5 1
    in "get=" & show (fb-get fb2 5 5) & " oob=" & show (fb-get fb2 99 99)

  test-hline : Text =
    let fb = fb-new 10 10 0
    in let fb2 = fb-hline fb 2 7 3 1
    in "hline=" & show (fb-count-color fb2 1)

  test-line : Text =
    let fb = fb-new 10 10 0
    in let fb2 = fb-line fb 0 0 9 9 1
    in "diag=" & show (fb-count-color fb2 1)

  test-rect : Text =
    let fb = fb-new 10 10 0
    in let fb2 = fb-rect fb 2 2 4 3 1
    in "rect=" & show (fb-count-color fb2 1)

  test-circle : Text =
    let fb = fb-new 20 20 0
    in let fb2 = fb-circle-filled fb 10 10 5 1
    in "filled-circle=" & show (fb-count-color fb2 1)

  test-triangle : Text =
    let fb = fb-new 20 20 0
    in let fb2 = fb-tri fb 10 2 2 18 18 18 1
    in "tri=" & show (fb-count-color fb2 1)

  test-polygon : Text =
    let pts = [vec2-new 0 0, vec2-new 9 0, vec2-new 9 9, vec2-new 0 9]
    in let fb = fb-new 10 10 0
    in let fb2 = fb-polygon fb pts 1
    in "poly-outline=" & show (fb-count-color fb2 1)

  opening : [Console] Nothing = act
    print-line test-framebuf
    print-line test-hline
    print-line test-line
    print-line test-rect
    print-line test-circle
    print-line test-triangle
    print-line test-polygon
  end

