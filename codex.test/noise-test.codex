Chapter: NoiseTest
  cites Codex chapter General
  cites Signal chapter Noise
  cites Signal chapter Perlin

Section: Body

  test-value-1d : Text =
    let a = value-noise-1d 0
    in let b = value-noise-1d 500
    in let c = value-noise-1d 1000
    in "v1d: a=" & show a & " b=" & show b & " c=" & show c

  test-value-2d : Text =
    let a = value-noise-2d 0 0
    in let b = value-noise-2d 500 500
    in let c = value-noise-2d 1000 1000
    in "v2d: a=" & show a & " b=" & show b & " c=" & show c

  test-continuity : Text =
    let a = value-noise-2d 999 500
    in let b = value-noise-2d 1000 500
    in let c = value-noise-2d 1001 500
    in let diff-ab = noise-test-abs (b - a)
    in let diff-bc = noise-test-abs (c - b)
    in "continuous=" & show (diff-ab < 50) & "," & show (diff-bc < 50)

  test-worley : Text =
    let w = worley-2d 500 500
    in "f1=" & show (w.w-f1) & " f2=" & show (w.w-f2) & " f2>f1=" & show (w.w-f2 >= w.w-f1)

  test-fbm : Text =
    let a = fbm-2d 500 500 4 2000 500
    in let b = fbm-2d 3000 3000 4 2000 500
    in "fbm-a=" & show a & " fbm-b=" & show b & " differ=" & show (a /= b)

  test-warp : Text =
    let a = warp-2d 500 500 500
    in let b = warp-2d 500 500 0
    in let plain = value-noise-2d 500 500
    in "warped=" & show a & " unwarped=" & show b & " plain=" & show plain

  test-map : Text =
    let m = noise-map-2d 4 4 500
    in let mn = noise-map-min m
    in let mx = noise-map-max m
    in "map=" & show (list-length m) & " min=" & show mn & " max=" & show mx & " range=" & show (mx >= mn)

  noise-test-abs : Integer -> Integer
  noise-test-abs (n) = if n < 0 then -n else n

  opening : [Console] Nothing = act
    print-line test-value-1d
    print-line test-value-2d
    print-line test-continuity
    print-line test-worley
    print-line test-fbm
    print-line test-warp
    print-line test-map
  end

