Chapter: SHA-256 Test



  cites Foreword chapter Console

  cites Foreword chapter Sha256



Section: Definitions



  h : List Integer -> Text

  h (msg) = sha256-to-hex (sha256 msg)



  range-list : Integer, Integer, List Integer -> List Integer

  range-list (i) (n) (acc) =

    if i == n then acc

    else range-list (i + 1) n (list-push acc i)



  opening : [Console] Nothing = act

    print-line (h [])

    print-line (h [171])

    print-line (h [97, 98, 99])

    print-line (h (range-list 0 55 []))

    print-line (h (range-list 0 56 []))

    print-line (h (range-list 0 64 []))

    print-line (h (range-list 0 112 []))

  end



