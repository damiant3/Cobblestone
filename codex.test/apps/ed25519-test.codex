Chapter: Ed25519 Test



  cites Foreword chapter Console

  cites Foreword chapter Ed25519

  cites Foreword chapter Sha512



Section: Definitions



  make-key : Integer, Integer, List Integer -> List Integer

  make-key (val) (n) (acc) =

    if n <= 0 then acc

    else make-key val (n - 1) (list-push acc val)



  opening : [Console] Nothing = act

    let sk1 = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

    in let sk2 = make-key 75 32 []

    in act

      print-line (bytes-to-hex (ed25519-public-key sk1))

      print-line (bytes-to-hex (ed25519-public-key sk2))

    end

  end



