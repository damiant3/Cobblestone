Chapter: DiskFactsMulti
  cites Codex chapter General
  cites Kernel chapter DiskFacts
  cites Foreword chapter FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256

Section: Body
  opening : Integer =
    let store = disk-init
    in let s1 = disk-write-fact store DefinitionFact "alpha" 1
    in let s2 = disk-write-fact s1 ProofFact "beta" 2
    in let s3 = disk-write-fact s2 PolicyFact "gamma" 3
    in let flushed = disk-checkpoint s3
    in disk-fact-count s3
