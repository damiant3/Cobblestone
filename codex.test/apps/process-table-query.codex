Chapter: ProcessTableQuery
  cites Codex chapter General

Section: Body
  opening : Integer =
    let count-before = process-count
    in let my-status = process-status (process-get-pid)
    in let child = process-spawn (\x -> poke-byte 28000 0 1)
    in let count-during = process-count
    in let w = process-wait child
    in let child-status = process-status child
    in let bad = process-status 99
    in count-before * 10000 + my-status * 1000 + count-during * 100 + child-status * 10 + bad
