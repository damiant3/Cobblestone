Chapter: SupervisorPattern
  cites Codex chapter General

Section: Body
  worker : Integer, Integer -> Integer
  worker (ch) (value) =
    let s = chan-kern-send ch (value * value)
    in 0

  opening : Integer =
    let ch = chan-kern-create 8
    in let w1 = process-spawn (\x -> worker ch 3)
    in let w2 = process-spawn (\x -> worker ch 5)
    in let w3 = process-spawn (\x -> worker ch 7)
    in let p1 = process-wait w1
    in let p2 = process-wait w2
    in let p3 = process-wait w3
    in let v1 = chan-kern-recv ch
    in let v2 = chan-kern-recv ch
    in let v3 = chan-kern-recv ch
    in let cl = chan-kern-close ch
    in v1 + v2 + v3
