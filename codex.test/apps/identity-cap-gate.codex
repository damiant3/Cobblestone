Chapter: IdentityCapGate

Section: Body
  opening : [Console] Nothing = act
    let ch = chan-kern-create 4
    in let parent-id-w0 = hardware-random
    in let s = identity-set 0 parent-id-w0
    in let child = process-spawn (\x ->
      let my-id = identity-whoami 0
      in let parent-id = identity-get-proc 0 0
      in let has-ipc = chan-kern-send ch my-id
      in let has-ipc2 = chan-kern-send ch parent-id
      in 0)
    in let restrict-id = process-restrict-cap child 15
    in let wt = process-wait child
    in let child-id = chan-kern-recv ch
    in let reported-parent = chan-kern-recv ch
    in if child-id == parent-id-w0 then
      if reported-parent == parent-id-w0 then
        if restrict-id == 0 then act
          print-line "PASS"
        end
        else print-line "FAIL: restrict failed"
      else print-line "FAIL: child saw wrong parent id"
    else print-line "FAIL: child identity wrong"
  end
