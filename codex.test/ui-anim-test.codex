Chapter: UiAnimTest
  cites Codex chapter General
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Animation

Section: Body

  test-throbber-spin : Text =
    let thr = throbber-spin 1000 16 16711680
    in let t1 = throbber-tick thr 250
    in let t2 = throbber-tick t1 250
    in "phase1=" & show (t1.thr-phase) & " phase2=" & show (t2.thr-phase) & " angle1=" & show (throbber-spin-angle t1)

  test-throbber-pulse : Text =
    let thr = throbber-pulse 1000 8 65280
    in let t1 = throbber-tick thr 250
    in let t2 = throbber-tick t1 500
    in "scale1=" & show (throbber-pulse-scale t1) & " scale2=" & show (throbber-pulse-scale t2)

  test-throbber-bounce : Text =
    let thr = throbber-bounce 1000 20 255
    in let t1 = throbber-tick thr 500
    in "offset=" & show (throbber-bounce-offset t1)

  test-throbber-stop : Text =
    let thr = throbber-spin 1000 16 0
    in let stopped = throbber-stop thr
    in let t1 = throbber-tick stopped 500
    in "active=" & anim-bool (t1.thr-active) & " phase=" & show (t1.thr-phase)

  test-transition : Text =
    let tr = transition-new "x" 0 100 1000 0
    in let t1 = transition-tick tr 500
    in let t2 = transition-tick t1 600
    in "v1=" & show (transition-value t1) & " v2=" & show (transition-value t2) & " done=" & anim-bool (t2.tr-done)

  test-keyframe : Text =
    let frames = [keyframe 0 0, keyframe 500 100, keyframe 1000 50]
    in let ks = keyframe-seq frames False
    in let k1 = keyframe-tick ks 250
    in let k2 = keyframe-tick k1 500
    in "v1=" & show (keyframe-value k1) & " v2=" & show (keyframe-value k2)

  test-keyframe-loop : Text =
    let frames = [keyframe 0 0, keyframe 100 1000]
    in let ks = keyframe-seq frames True
    in let k1 = keyframe-tick ks 150
    in "looped=" & anim-bool (k1.ks-looping) & " done=" & anim-bool (k1.ks-done)

  test-anim-set : Text =
    let as0 = anim-set-new
    in let as1 = anim-set-add as0 "fade" (transition-new "opacity" 0 1000 500 0)
    in let as2 = anim-set-tick as1 500
    in "done=" & anim-bool (anim-set-all-done as2)

  anim-bool : Boolean -> Text
  anim-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line test-throbber-spin
    print-line test-throbber-pulse
    print-line test-throbber-bounce
    print-line test-throbber-stop
    print-line test-transition
    print-line test-keyframe
    print-line test-keyframe-loop
    print-line test-anim-set
  end

