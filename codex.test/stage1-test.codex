Chapter: Stage1 Test
  cites Codex chapter General

Section: Definitions

  square : Integer -> Integer
  square (x) = x * x

  greet : Text -> Text
  greet (name) = "Hello, " & name & "!"

  opening : [Console] Nothing = act
    print-line (greet "Codex")
    print-line (show (square 7))
  end

