Chapter: Tco Generic Record
  cites Codex chapter General
  cites Codex chapter Text

Section: Types
  Acc (a) = record {
    value : a,
    count : Integer
  }

Section: Loop
  loop-add : Integer -> Acc Integer -> Acc Integer
  loop-add (n) (acc) =
    if n <= 0 then acc
    else loop-add (n - 1) (Acc { value = acc.value + n, count = acc.count + 1 })

Section: Driver
  result : Acc Integer
  result = loop-add 10 (Acc { value = 0, count = 0 })

  opening : [Console] Nothing = act
    print-line (integer-to-text result.value)
    print-line (integer-to-text result.count)
  end

