Chapter: Bounded Integer Ops
  cites Codex chapter Text

Section: Types

  Byte = record {
   val : Integer between 0 and 255
  }

  Port = record {
   num : Integer between 0 and 65535
  }

  Pair = record {
   lo : Integer between 0 and 255,
   hi : Integer between 0 and 255
  }

Section: Definitions

  make-byte : Integer -> Byte
  make-byte (n) = Byte { val = __narrow n }

  byte-add : Byte -> Byte -> Byte
  byte-add (a) (b) = make-byte (a.val + b.val)

  byte-mul : Byte -> Integer -> Byte
  byte-mul (b) (n) = make-byte (b.val * n)

  split-u16 : Port -> Pair
  split-u16 (p) =
   let lo = __narrow (int-mod (p.num) 256)
   in let hi = __narrow (p.num / 256)
   in Pair { lo = lo, hi = hi }

  join-pair : Pair -> Integer
  join-pair (p) = p.hi * 256 + p.lo

  sum-bytes-acc : List Byte -> Integer -> Integer -> Integer
  sum-bytes-acc (bs) (i) (acc) =
   if i == list-length bs then acc
   else sum-bytes-acc bs (i + 1) (acc + (list-at bs i).val)

  opening : [Console] Nothing =
   let a = make-byte 100
   in let b = make-byte 55
   in let c = byte-add a b
   in let d = byte-mul b 3
   in let port = Port { num = 4660 }
   in let parts = split-u16 port
   in let rejoined = join-pair parts
   in let bytes = [make-byte 10, make-byte 20, make-byte 30, make-byte 40]
   in let total = sum-bytes-acc bytes 0 0
   in act
    print-line (integer-to-text (c.val))
    print-line (integer-to-text (d.val))
    print-line (integer-to-text (parts.lo))
    print-line (integer-to-text (parts.hi))
    print-line (integer-to-text rejoined)
    print-line (integer-to-text total)
   end

