  cites Codex chapter Text

Section: Definitions

  Person = record { name : Text, age : Integer }

  people : List Person = [
    Person { name = "Alice", age = 30 },
    Person { name = "Bob",   age = 25 },
    Person { name = "Carol", age = 40 }
  ]

  ages-sum : List Person -> Integer -> Integer -> Integer
  ages-sum (ps) (i) (acc) =
    if i >= list-length ps then acc
    else ages-sum ps (i + 1) (acc + (list-at ps i).age)

  opening : Text = "total=" ++ show (ages-sum people 0 0)

