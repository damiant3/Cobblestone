  cites Codex chapter Lists

Section: Definitions

  opening : [Console] Nothing = act
    s <- "hello world"
    print-line (substring s 0 5)
    print-line (substring s 6 5)
    print-line (text-replace s "world" "codex")
    print-line (if text-starts-with s "hello" then "yes" else "no")
    print-line (if text-starts-with s "world" then "yes" else "no")
    parts <- text-split "a,b,c" ","
    print-line (integer-to-text (list-length parts))
    print-line (text-concat-list ["x", "-", "y", "-", "z"])
  end

