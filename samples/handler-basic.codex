Chapter: HandlerBasic
  cites Codex chapter General

Section: Effect
  effect Counter where
    tick : [Counter] Integer

Section: Body
  do-three : [Counter] Integer
  do-three = act
    a <- tick
    b <- tick
    c <- tick
    a + b + c
  end

  opening : Integer = with Counter do-three
    tick (resume) = resume 7

