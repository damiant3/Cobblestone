Chapter: Maybe

Section: Maybe
  Maybe (a) =
   | Just (a)
   | None

Chapter: TestMaybe

Section: Types
  Def = record {
   name : Text,
   body : Text
  }

Section: Defs
  extract-name : Maybe Def -> Text
  extract-name (m) =
   when m
    is Just (d) -> d.name
    is None -> "none"

  opening : [Console] Nothing = act
   let sample = Just (Def { name = "hello", body = "world" })
   in print-line (extract-name sample)
  end
