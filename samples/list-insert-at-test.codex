Chapter: ListInsertAtTest
  cites Codex chapter Lists
  cites Codex chapter Text

Section: Definitions

  opening : Text =
    let xs = [1, 2, 4, 5]
    in let ys = list-insert-at xs 2 3
    in integer-to-text (list-at ys 0) ++ "/" ++
       integer-to-text (list-at ys 1) ++ "/" ++
       integer-to-text (list-at ys 2) ++ "/" ++
       integer-to-text (list-at ys 3) ++ "/" ++
       integer-to-text (list-at ys 4)

