Chapter: NicProbe
  cites Codex chapter General

Section: Body
  opening : [Console] Nothing = act
    let status = net-status
    in act
      print-line ("nic-present=" & show status)
      if status == 1 then act
        print-line ("mac0=" & show (net-get-hwaddr 0))
        print-line ("mac1=" & show (net-get-hwaddr 1))
        print-line ("mac2=" & show (net-get-hwaddr 2))
        print-line ("mac3=" & show (net-get-hwaddr 3))
        print-line ("mac4=" & show (net-get-hwaddr 4))
        print-line ("mac5=" & show (net-get-hwaddr 5))
      end
      else print-line "no nic"
    end
  end

