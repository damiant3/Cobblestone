Chapter: VgaShell
  cites Codex chapter General

 Bare-metal VGA text shell. Reads keyboard scancodes, renders typed
 text to VGA memory, scrolls on newline. Proves keyboard + VGA
 display work in codex-vm.

Section: VGA Constants
  vga-base : Integer = 753664
  vga-cols : Integer = 80
  vga-rows : Integer = 25
  vga-white-on-black : Integer = 7
  vga-green-on-black : Integer = 10
  vga-cyan-on-black : Integer = 11
  vga-yellow-on-black : Integer = 14

Section: Scancode to ASCII
  scancode-to-ascii : Integer -> Integer
  scancode-to-ascii (sc) =
    if sc == 2 then 49 else if sc == 3 then 50 else if sc == 4 then 51
    else if sc == 5 then 52 else if sc == 6 then 53 else if sc == 7 then 54
    else if sc == 8 then 55 else if sc == 9 then 56 else if sc == 10 then 57
    else if sc == 11 then 48
    else if sc == 16 then 113 else if sc == 17 then 119 else if sc == 18 then 101
    else if sc == 19 then 114 else if sc == 20 then 116 else if sc == 21 then 121
    else if sc == 22 then 117 else if sc == 23 then 105 else if sc == 24 then 111
    else if sc == 25 then 112
    else if sc == 30 then 97 else if sc == 31 then 115 else if sc == 32 then 100
    else if sc == 33 then 102 else if sc == 34 then 103 else if sc == 35 then 104
    else if sc == 36 then 106 else if sc == 37 then 107 else if sc == 38 then 108
    else if sc == 44 then 122 else if sc == 45 then 120 else if sc == 46 then 99
    else if sc == 47 then 118 else if sc == 48 then 98 else if sc == 49 then 110
    else if sc == 50 then 109
    else if sc == 57 then 32
    else if sc == 28 then 10
    else if sc == 14 then 8
    else 0

Section: VGA Primitives
  vga-put-char : Integer, Integer, Integer, Integer -> Integer
  vga-put-char (col) (row) (ch) (attr) =
    let offset = (row * vga-cols + col) * 2
    in let w1 = poke-byte vga-base offset ch
    in poke-byte vga-base (offset + 1) attr

  vga-clear-row : Integer, Integer, Integer -> Integer
  vga-clear-row (row) (col) (attr) =
    if col >= vga-cols then 0
    else let w = vga-put-char col row 32 attr
    in vga-clear-row row (col + 1) attr

  vga-clear-screen : Integer -> Integer
  vga-clear-screen (row) =
    if row >= vga-rows then 0
    else let w = vga-clear-row row 0 vga-white-on-black
    in vga-clear-screen (row + 1)

  vga-scroll-up : Integer -> Integer
  vga-scroll-up (row) =
    if row >= vga-rows - 1 then vga-clear-row (vga-rows - 1) 0 vga-white-on-black
    else let src = ((row + 1) * vga-cols) * 2
    in let dst = (row * vga-cols) * 2
    in let copy = vga-copy-row dst src 0
    in vga-scroll-up (row + 1)

  vga-copy-row : Integer, Integer, Integer -> Integer
  vga-copy-row (dst) (src) (i) =
    if i >= vga-cols * 2 then 0
    else let b = peek-byte vga-base (src + i)
    in let w = poke-byte vga-base (dst + i) b
    in vga-copy-row dst src (i + 1)

Section: String Rendering
  vga-put-string : Text, Integer, Integer, Integer, Integer -> Integer
  vga-put-string (s) (i) (col) (row) (attr) =
    if i >= text-length s then col
    else let ch = char-code-at s i
    in let w = vga-put-char col row ch attr
    in vga-put-string s (i + 1) (col + 1) row attr

Section: Shell State
  ShellState = record {
    cursor-col : Integer,
    cursor-row : Integer,
    input-buf : Text,
    last-key : Integer
  }

  shell-init : ShellState
  shell-init = ShellState { cursor-col = 2, cursor-row = 2, input-buf = "", last-key = 0 }

Section: Shell Logic
  shell-newline : ShellState -> ShellState
  shell-newline (st) =
    if st.cursor-row >= vga-rows - 2 then
      let s = vga-scroll-up 0
      in ShellState { cursor-col = 2, cursor-row = st.cursor-row, input-buf = "", last-key = st.last-key }
    else ShellState { cursor-col = 2, cursor-row = st.cursor-row + 1, input-buf = "", last-key = st.last-key }

  shell-echo-command : ShellState -> ShellState
  shell-echo-command (st) =
    let next = shell-newline st
    in let msg = if st.input-buf == "hello" then "Hello, Codex!"
      else if st.input-buf == "info" then "codex-vm VGA shell v0.1"
      else if st.input-buf == "clear" then ""
      else if st.input-buf == "nic" then "nic=" & show (net-status)
      else if st.input-buf == "help" then "Commands: hello info clear nic help"
      else "unknown: " & st.input-buf
    in if st.input-buf == "clear" then
      let c = vga-clear-screen 0
      in let p = vga-put-string "codex> " 0 0 1 vga-green-on-black
      in ShellState { cursor-col = 2, cursor-row = 2, input-buf = "", last-key = 0 }
    else
      let p = vga-put-string msg 0 2 (next.cursor-row) vga-cyan-on-black
      in let next2 = shell-newline next
      in let p2 = vga-put-string "> " 0 0 (next2.cursor-row) vga-green-on-black
      in next2

  shell-handle-key : ShellState, Integer -> ShellState
  shell-handle-key (st) (sc) =
    if sc >= 128 then st
    else let ascii = scancode-to-ascii sc
    in if ascii == 0 then st
    else if ascii == 10 then shell-echo-command st
    else if ascii == 8 then
      if text-length (st.input-buf) > 0 then
        let new-buf = substring (st.input-buf) 0 (text-length (st.input-buf) - 1)
        in let w = vga-put-char (st.cursor-col - 1) (st.cursor-row) 32 vga-white-on-black
        in ShellState { cursor-col = st.cursor-col - 1, cursor-row = st.cursor-row, input-buf = new-buf, last-key = sc }
      else st
    else
      let w = vga-put-char (st.cursor-col) (st.cursor-row) ascii vga-yellow-on-black
      in ShellState { cursor-col = st.cursor-col + 1, cursor-row = st.cursor-row, input-buf = st.input-buf & char-from-code ascii, last-key = sc }

Section: Main Loop
  shell-loop : ShellState -> [Console] Nothing
  shell-loop (st) = act
    let key = read-key
    in if key == 0 then shell-loop st
    else if key == st.last-key then shell-loop st
    else let st2 = shell-handle-key (__record-set st "last-key" key) key
    in shell-loop st2
  end

Section: Body
  opening : [Console] Nothing = act
    let c = vga-clear-screen 0
    in let t = vga-put-string "Codex VGA Shell" 0 2 0 vga-cyan-on-black
    in let p = vga-put-string "> " 0 0 2 vga-green-on-black
    in shell-loop shell-init
  end

