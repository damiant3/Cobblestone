Section: AI

  ai-find-target : List Unit, Integer, List TerrainHex, Integer -> Integer
  ai-find-target (units) (owner) (terrain-data) (width) =
    ai-target-loop units owner terrain-data width 0 (-1) 999

  ai-target-loop : List Unit, Integer, List TerrainHex, Integer, Integer, Integer, Integer -> Integer
  ai-target-loop (units) (owner) (td) (width) (i) (best) (best-str) =
    if i >= list-length units then best
    else let u = list-at units i
    in if u.owner == owner then ai-target-loop units owner td width (i + 1) best best-str
    else if u.eliminated then ai-target-loop units owner td width (i + 1) best best-str
    else let adj = ai-any-adjacent-friendly units owner u.q u.r
    in if adj == False then ai-target-loop units owner td width (i + 1) best best-str
    else if u.strength < best-str then ai-target-loop units owner td width (i + 1) i u.strength
    else ai-target-loop units owner td width (i + 1) best best-str

  ai-any-adjacent-friendly : List Unit, Integer, Integer, Integer -> Boolean
  ai-any-adjacent-friendly (units) (owner) (eq) (er) =
    ai-adj-loop units owner eq er 0

  ai-adj-loop : List Unit, Integer, Integer, Integer, Integer -> Boolean
  ai-adj-loop (units) (owner) (eq) (er) (i) =
    if i >= list-length units then False
    else let u = list-at units i
    in if u.owner /= owner then ai-adj-loop units owner eq er (i + 1)
    else if u.eliminated then ai-adj-loop units owner eq er (i + 1)
    else let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = eq, r = er })
    in if dist <= 1 then True
    else ai-adj-loop units owner eq er (i + 1)

  ai-find-advance-target : List TerrainHex, Integer, Integer -> Integer
  ai-find-advance-target (terrain-data) (width) (height) =
    ai-advance-loop terrain-data width height 0 (-1)

  ai-advance-loop : List TerrainHex, Integer, Integer, Integer, Integer -> Integer
  ai-advance-loop (td) (width) (height) (i) (best) =
    if i >= list-length td then best
    else let th = list-at td i
    in if th.victory-point == False then ai-advance-loop td width height (i + 1) best
    else ai-advance-loop td width height (i + 1) i

  ai-count-vp : List TerrainHex, List Unit, Integer -> Integer
  ai-count-vp (terrain-data) (units) (owner) =
    ai-vp-loop terrain-data units owner 0 0

  ai-vp-loop : List TerrainHex, List Unit, Integer, Integer, Integer -> Integer
  ai-vp-loop (td) (units) (owner) (i) (acc) =
    if i >= list-length td then acc
    else let th = list-at td i
    in if th.victory-point == False then ai-vp-loop td units owner (i + 1) acc
    else let held = ai-hex-held-by units owner i
    in let delta = if held then 1 else 0
    in ai-vp-loop td units owner (i + 1) (acc + delta)

  ai-hex-held-by : List Unit, Integer, Integer -> Boolean
  ai-hex-held-by (units) (owner) (idx) =
    ai-hex-held-loop units owner idx 0

  ai-hex-held-loop : List Unit, Integer, Integer, Integer -> Boolean
  ai-hex-held-loop (units) (owner) (idx) (i) =
    if i >= list-length units then False
    else let u = list-at units i
    in if u.eliminated then ai-hex-held-loop units owner idx (i + 1)
    else if u.owner /= owner then ai-hex-held-loop units owner idx (i + 1)
    else let uid = u.r * 1000 + u.q
    in if uid == idx then True
    else ai-hex-held-loop units owner idx (i + 1)

Section: Game Runner

  HexwarResult = record {
    winner      : Integer,
    turns       : Integer,
    units-lost-a : Integer,
    units-lost-b : Integer,
    vp-a        : Integer,
    vp-b        : Integer
  }

  count-eliminated : List Unit, Integer -> Integer
  count-eliminated (units) (owner) =
    count-elim-loop units owner 0 0

  count-elim-loop : List Unit, Integer, Integer, Integer -> Integer
  count-elim-loop (units) (owner) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let delta = if u.owner == owner & u.eliminated then 1 else 0
    in count-elim-loop units owner (i + 1) (acc + delta)

  count-alive : List Unit, Integer -> Integer
  count-alive (units) (owner) =
    count-alive-loop units owner 0 0

  count-alive-loop : List Unit, Integer, Integer, Integer -> Integer
  count-alive-loop (units) (owner) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let delta = if u.owner == owner & u.eliminated == False then 1 else 0
    in count-alive-loop units owner (i + 1) (acc + delta)

  determine-winner : List Unit, List TerrainHex, Integer, Integer -> Integer
  determine-winner (units) (terrain-data) (turn) (turn-limit) =
    let alive-a = count-alive units 0
    in let alive-b = count-alive units 1
    in if alive-a == 0 then 1
    else if alive-b == 0 then 0
    else let vp-a = ai-count-vp terrain-data units 0
    in let vp-b = ai-count-vp terrain-data units 1
    in if vp-a > vp-b then 0
    else if vp-b > vp-a then 1
    else (-1)

  run-hexwar-turn : List Unit, List TerrainHex, Integer, Integer, Rng -> List Unit
  run-hexwar-turn (units) (terrain-data) (active-player) (width) (r) =
    let units2 = reset-units-for-turn units
    in let r2 = rng-next r
    in let target = ai-find-target units2 active-player terrain-data width
    in if target < 0 then units2
    else let tu = list-at units2 target
    in let def-str = tu.strength
    in let def-hex = list-at terrain-data (tu.r * width + tu.q)
    in let def-bonus = get-defense-bonus def-hex.terrain
    in let atk-str = ai-count-attack-strength units2 active-player tu.q tu.r
    in let arty = artillery-support units2 tu.q tu.r active-player
    in let total-atk = atk-str + arty
    in let die = rng-range r2 1 6
    in let result = combat-result total-atk def-str def-bonus die
    in apply-combat-result units2 target result active-player r2

  ai-count-attack-strength : List Unit, Integer, Integer, Integer -> Integer
  ai-count-attack-strength (units) (owner) (tq) (tr) =
    ai-atk-str-loop units owner tq tr 0 0

  ai-atk-str-loop : List Unit, Integer, Integer, Integer, Integer, Integer -> Integer
  ai-atk-str-loop (units) (owner) (tq) (tr) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in if u.owner /= owner then ai-atk-str-loop units owner tq tr (i + 1) acc
    else if u.eliminated then ai-atk-str-loop units owner tq tr (i + 1) acc
    else let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = tq, r = tr })
    in let adj = if dist <= 1 & u.type-id /= 2 then u.attack else 0
    in ai-atk-str-loop units owner tq tr (i + 1) (acc + adj)

  apply-combat-result : List Unit, Integer, Integer, Integer, Rng -> List Unit
  apply-combat-result (units) (def-idx) (result) (atk-owner) (r) =
    if result == 0 then eliminate-attackers units atk-owner def-idx
    else if result == 1 then retreat-attackers units atk-owner def-idx r
    else if result == 2 then
      let u2 = eliminate-one units def-idx
      in eliminate-attackers u2 atk-owner def-idx
    else if result == 3 then retreat-defender units def-idx r
    else eliminate-defender units def-idx

  eliminate-defender : List Unit, Integer -> List Unit
  eliminate-defender (units) (def-idx) =
    let u = list-at units def-idx
    in let u2 = __record-set u "eliminated" True
    in list-set-at units def-idx u2

  eliminate-one : List Unit, Integer -> List Unit
  eliminate-one (units) (def-idx) =
    eliminate-defender units def-idx

  eliminate-attackers : List Unit, Integer, Integer -> List Unit
  eliminate-attackers (units) (owner) (def-idx) =
    elim-atk-loop units owner def-idx 0

  elim-atk-loop : List Unit, Integer, Integer, Integer -> List Unit
  elim-atk-loop (units) (owner) (def-idx) (i) =
    if i >= list-length units then units
    else let u = list-at units i
    in if u.owner /= owner then elim-atk-loop units owner def-idx (i + 1)
    else if u.eliminated then elim-atk-loop units owner def-idx (i + 1)
    else let du = list-at units def-idx
    in let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = du.q, r = du.r })
    in if dist > 1 then elim-atk-loop units owner def-idx (i + 1)
    else let u2 = __record-set u "eliminated" True
    in elim-atk-loop (list-set-at units i u2) owner def-idx (i + 1)

  retreat-defender : List Unit, Integer, Rng -> List Unit
  retreat-defender (units) (def-idx) (r) =
    let u = list-at units def-idx
    in let dir = rng-mod (rng-value r) 6
    in let nq = hex-neighbor-q dir u.q
    in let nr = hex-neighbor-r dir u.r
    in let u2 = __record-set (__record-set u "q" nq) "r" nr
    in list-set-at units def-idx u2

  retreat-attackers : List Unit, Integer, Integer, Rng -> List Unit
  retreat-attackers (units) (owner) (def-idx) (r) =
    retreat-atk-loop units owner def-idx r 0

  retreat-atk-loop : List Unit, Integer, Integer, Rng, Integer -> List Unit
  retreat-atk-loop (units) (owner) (def-idx) (r) (i) =
    if i >= list-length units then units
    else let u = list-at units i
    in if u.owner /= owner then retreat-atk-loop units owner def-idx r (i + 1)
    else if u.eliminated then retreat-atk-loop units owner def-idx r (i + 1)
    else let du = list-at units def-idx
    in let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = du.q, r = du.r })
    in if dist > 1 then retreat-atk-loop units owner def-idx r (i + 1)
    else let dir = rng-mod (rng-value r) 6
    in let opp = rng-mod (dir + 3) 6
    in let nq = hex-neighbor-q opp u.q
    in let nr = hex-neighbor-r opp u.r
    in let u2 = __record-set (__record-set u "q" nq) "r" nr
    in retreat-atk-loop (list-set-at units i u2) owner def-idx r (i + 1)

  run-hexwar-game : WargameConfig, Integer -> HexwarResult
  run-hexwar-game (cfg) (seed) =
    hexwar-loop cfg (rng-new seed) cfg.unit-roster 0 0

  hexwar-loop : WargameConfig, Rng, List Unit, Integer, Integer -> HexwarResult
  hexwar-loop (cfg) (r) (units) (turn) (active-player) =
    if turn >= cfg.turn-limit then hexwar-finish cfg units turn
    else if count-alive units 0 == 0 then hexwar-finish cfg units turn
    else if count-alive units 1 == 0 then hexwar-finish cfg units turn
    else let r2 = rng-next r
    in let units2 = run-hexwar-turn units cfg.terrain-data active-player cfg.map-width r2
    in let next-player = rng-mod (active-player + 1) cfg.num-players
    in let next-turn = if next-player == 0 then turn + 1 else turn
    in hexwar-loop cfg r2 units2 next-turn next-player

  hexwar-finish : WargameConfig, List Unit, Integer -> HexwarResult
  hexwar-finish (cfg) (units) (turn) =
    let winner = determine-winner units cfg.terrain-data turn cfg.turn-limit
    in let la = count-eliminated units 0
    in let lb = count-eliminated units 1
    in let va = ai-count-vp cfg.terrain-data units 0
    in let vb = ai-count-vp cfg.terrain-data units 1
    in HexwarResult {
         winner = winner,
         turns = turn,
         units-lost-a = la,
         units-lost-b = lb,
         vp-a = va,
         vp-b = vb
       }

Section: Formatting

  format-hexwar-result : HexwarResult -> Text
  format-hexwar-result (res) =
    let w = if res.winner == 0 then "Player A"
            else if res.winner == 1 then "Player B"
            else "Draw"
    in "HexWar: winner=" & w
       & " turns=" & show res.turns
       & " A-lost=" & show res.units-lost-a
       & " B-lost=" & show res.units-lost-b
       & " VP A=" & show res.vp-a
       & " VP B=" & show res.vp-b

Page 1


Chapter: Games--PokerVariants
  cites Games chapter Rng
  cites Games chapter Poker

 Multiple poker variants using the Poker chapter's hand evaluation.
 Each variant has its own deal logic, simplified betting (check/bet/fold
 modeled as check-only with showdown), and showdown resolution.

 Card encoding: 0-51, rank = card mod 13 (0=2..12=Ace), suit = card/13.
 Suits: 0=clubs, 1=diamonds, 2=hearts, 3=spades.

 Variants:
   FiveCardDraw   — deal 5, draw up to 3 (4 if holding ace), showdown
   FiveCardStud   — 1 down + 4 up, betting each street
   SevenCardStud  — 2 down + 4 up + 1 down, best 5 of 7
   Baseball       — 3s and 9s wild, 4 dealt face-up gets extra card
   HiChicago      — highest spade in hole wins half pot
   LowChicago     — lowest spade in hole wins half pot
   FollowTheQueen — card after each queen dealt face-up is wild
   JacksOrBetter  — need pair of jacks+ to open; need trips+ to win

 We say:

Section: Variant Type

  PokerVariant =
   | FiveCardDraw
   | FiveCardStud
   | SevenCardStud
   | Baseball
   | HiChicago
   | LowChicago
   | FollowTheQueen
   | JacksOrBetter

Section: Session Types

  PokerSession = record {
    variant        : PokerVariant,
    seed           : Integer,
    num-players    : Integer,
    winner         : Integer,
    p1-hand-rank   : Integer,
    p2-hand-rank   : Integer,
    hands-played   : Integer,
    special-winner : Integer
  }

  PvHand = record {
    cards    : List Integer,
    size     : Integer,
    folded   : Boolean,
    player   : Integer
  }

Section: Deck Utilities

  pv-build-deck : Integer, List Integer -> List Integer
  pv-build-deck (i) (acc) =
    if i >= 52 then acc
    else pv-build-deck (i + 1) (list-push acc i)

  pv-shuffle : List Integer, Rng -> List Integer
  pv-shuffle (deck) (r) = pv-fy deck 51 r

  pv-fy : List Integer, Integer, Rng -> List Integer
  pv-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in pv-fy d3 (i - 1) r2

Section: Hand Building Helpers

  pv-empty-hand : Integer -> PvHand
  pv-empty-hand (player) =
    PvHand { cards = [], size = 0, folded = False, player = player }

  pv-add-card : PvHand, Integer -> PvHand
  pv-add-card (h) (card) =
    PvHand { cards = list-push (h.cards) card, size = h.size + 1, folded = h.folded, player = h.player }

  pv-take-5-from : List Integer, Integer, Integer -> PokerHand
  pv-take-5-from (deck) (start) (stride) =
    let c0 = list-at deck start
    in let c1 = list-at deck (start + stride)
    in let c2 = list-at deck (start + stride * 2)
    in let c3 = list-at deck (start + stride * 3)
    in let c4 = list-at deck (start + stride * 4)
    in let cards = list-push (list-push (list-push (list-push (list-push [] c0) c1) c2) c3) c4
    in PokerHand { cards = cards }

  pv-hand-from-pvhand : PvHand -> PokerHand
  pv-hand-from-pvhand (h) =
    let cards = pv-first-5 (h.cards) 0 []
    in PokerHand { cards = cards }

  pv-first-5 : List Integer, Integer, List Integer -> List Integer
  pv-first-5 (cards) (i) (acc) =
    if i >= 5 then acc
    else if i >= list-length cards then list-push acc 0
    else pv-first-5 cards (i + 1) (list-push acc (list-at cards i))

Section: Best 5 of 7 (SevenCardStud, Baseball)

  pv-best-5-of-7 : List Integer -> PokerHand
  pv-best-5-of-7 (cards) =
    pv-best-combo cards 0 1 2 3 4 (HandRank { rank = (-1), primary = 0, secondary = 0 }) []

  pv-best-combo : List Integer, Integer, Integer, Integer, Integer, Integer, HandRank, List Integer -> PokerHand
  pv-best-combo (cards) (a) (b) (c) (d) (e) (best-rank) (best-cards) =
    if a >= 3 then PokerHand { cards = best-cards }
    else
      let trial = pv-pick-5 cards a b c d e
      in let hr = evaluate-hand (PokerHand { cards = trial })
      in let better = hr.rank > best-rank.rank | hr.rank == best-rank.rank & hr.primary > best-rank.primary
      in let new-best-rank = if better then hr else best-rank
      in let new-best-cards = if better then trial else best-cards
      in let next = pv-next-combo a b c d e
      in pv-best-combo cards (list-at next 0) (list-at next 1) (list-at next 2) (list-at next 3) (list-at next 4) new-best-rank new-best-cards

  pv-pick-5 : List Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pv-pick-5 (cards) (a) (b) (c) (d) (e) =
    let h0 = list-push [] (list-at cards a)
    in let h1 = list-push h0 (list-at cards b)
    in let h2 = list-push h1 (list-at cards c)
    in let h3 = list-push h2 (list-at cards d)
    in list-push h3 (list-at cards e)

  pv-next-combo : Integer, Integer, Integer, Integer, Integer -> List Integer
  pv-next-combo (a) (b) (c) (d) (e) =
    if e < 6 then [a, b, c, d, e + 1]
    else if d < 5 then [a, b, c, d + 1, d + 2]
    else if c < 4 then [a, b, c + 1, c + 2, c + 3]
    else if b < 3 then [a, b + 1, b + 2, b + 3, b + 4]
    else [a + 1, a + 2, a + 3, a + 4, a + 5]

Section: Wild Card Substitution

 Wild cards: when evaluating, replace wilds with the best possible rank/suit.
 Simplified: count wilds, add them to best rank count.

  pv-count-wilds-in-hand : List Integer, List Boolean -> Integer
  pv-count-wilds-in-hand (cards) (wilds) =
    pv-wild-count-loop cards wilds 0 0

  pv-wild-count-loop : List Integer, List Boolean, Integer, Integer -> Integer
  pv-wild-count-loop (cards) (wilds) (i) (acc) =
    if i >= list-length cards then acc
    else let card = list-at cards i
    in let is-wild = if card < list-length wilds then list-at wilds card else False
    in let delta = if is-wild then 1 else 0
    in pv-wild-count-loop cards wilds (i + 1) (acc + delta)

  pv-build-rank-wilds : List Integer -> List Boolean
  pv-build-rank-wilds (wild-ranks) =
    pv-build-wild-table wild-ranks 0 (pv-build-false-list 52)

  pv-build-false-list : Integer -> List Boolean
  pv-build-false-list (n) =
    pv-false-loop n 0 []

  pv-false-loop : Integer, Integer, List Boolean -> List Boolean
  pv-false-loop (n) (i) (acc) =
    if i >= n then acc
    else pv-false-loop n (i + 1) (list-push acc False)

  pv-build-wild-table : List Integer, Integer, List Boolean -> List Boolean
  pv-build-wild-table (wild-ranks) (i) (table) =
    if i >= list-length wild-ranks then table
    else let rank = list-at wild-ranks i
    in let t2 = pv-mark-rank-wild table rank 0
    in pv-build-wild-table wild-ranks (i + 1) t2

  pv-mark-rank-wild : List Boolean, Integer, Integer -> List Boolean
  pv-mark-rank-wild (table) (rank) (suit) =
    if suit >= 4 then table
    else let card-idx = suit * 13 + rank
    in let t2 = list-set-at table card-idx True
    in pv-mark-rank-wild t2 rank (suit + 1)

  pv-evaluate-with-wilds : PokerHand, List Boolean -> HandRank
  pv-evaluate-with-wilds (h) (wilds) =
    let wild-count = pv-count-wilds-in-hand (h.cards) wilds
    in if wild-count == 0 then evaluate-hand h
    else
      let base = evaluate-hand h
      in let boosted = base.rank + wild-count
      in let capped = if boosted > 8 then 8 else boosted
      in HandRank { rank = capped, primary = base.primary, secondary = base.secondary }

Section: Spade Queries (Chicago variants)

  pv-card-is-spade : Integer -> Boolean
  pv-card-is-spade (card) = card-suit card == 3

  pv-highest-spade-in-hole : List Integer -> Integer
  pv-highest-spade-in-hole (hole-cards) =
    pv-highest-spade-loop hole-cards 0 (-1)

  pv-highest-spade-loop : List Integer, Integer, Integer -> Integer
  pv-highest-spade-loop (cards) (i) (best) =
    if i >= list-length cards then best
    else let card = list-at cards i
    in if pv-card-is-spade card then
      let r = card-rank card
      in if r > best then pv-highest-spade-loop cards (i + 1) r
      else pv-highest-spade-loop cards (i + 1) best
    else pv-highest-spade-loop cards (i + 1) best

  pv-lowest-spade-in-hole : List Integer -> Integer
  pv-lowest-spade-in-hole (hole-cards) =
    pv-lowest-spade-loop hole-cards 0 999

  pv-lowest-spade-loop : List Integer, Integer, Integer -> Integer
  pv-lowest-spade-loop (cards) (i) (best) =
    if i >= list-length cards then if best == 999 then (-1) else best
    else let card = list-at cards i
    in if pv-card-is-spade card then
      let r = card-rank card
      in if r < best then pv-lowest-spade-loop cards (i + 1) r
      else pv-lowest-spade-loop cards (i + 1) best
    else pv-lowest-spade-loop cards (i + 1) best

Section: FiveCardDraw

  pv-five-card-draw : Integer, Rng -> PokerSession
  pv-five-card-draw (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1 = deal-hand deck 0
    in let h2 = deal-hand deck 5
    in let draw1 = draw-count h1
    in let draw2 = draw-count h2
    in let r2 = rng-next r
    in let deck2 = pv-shuffle deck r2
    in let h1-final = pv-redeal h1 deck2 10 draw1
    in let h2-final = pv-redeal h2 deck2 (10 + draw1) draw2
    in let rank1 = evaluate-hand h1-final
    in let rank2 = evaluate-hand h2-final
    in let winner = compare-hands rank1 rank2
    in PokerSession {
         variant = FiveCardDraw,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = 0
       }

  pv-redeal : PokerHand, List Integer, Integer, Integer -> PokerHand
  pv-redeal (h) (deck) (offset) (n) =
    pv-redeal-loop (h.cards) deck offset n 0

  pv-redeal-loop : List Integer, List Integer, Integer, Integer, Integer -> PokerHand
  pv-redeal-loop (cards) (deck) (offset) (n) (replaced) =
    if replaced >= n then PokerHand { cards = cards }
    else let new-card = list-at deck (offset + replaced)
    in let idx = 4 - replaced
    in let new-cards = list-set-at cards idx new-card
    in pv-redeal-loop new-cards deck offset n (replaced + 1)

Section: FiveCardStud

  pv-five-card-stud : Integer, Rng -> PokerSession
  pv-five-card-stud (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1 = deal-hand deck 0
    in let h2 = deal-hand deck 5
    in let rank1 = evaluate-hand h1
    in let rank2 = evaluate-hand h2
    in let winner = compare-hands rank1 rank2
    in PokerSession {
         variant = FiveCardStud,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = 0
       }

Section: SevenCardStud

  pv-seven-card-stud : Integer, Rng -> PokerSession
  pv-seven-card-stud (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1-cards = pv-collect-7 deck 0
    in let h2-cards = pv-collect-7 deck 7
    in let best1 = pv-best-5-of-7 h1-cards
    in let best2 = pv-best-5-of-7 h2-cards
    in let rank1 = evaluate-hand best1
    in let rank2 = evaluate-hand best2
    in let winner = compare-hands rank1 rank2
    in PokerSession {
         variant = SevenCardStud,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = 0
       }

  pv-collect-7 : List Integer, Integer -> List Integer
  pv-collect-7 (deck) (start) =
    pv-collect-loop deck start 0 []

  pv-collect-loop : List Integer, Integer, Integer, List Integer -> List Integer
  pv-collect-loop (deck) (start) (i) (acc) =
    if i >= 7 then acc
    else pv-collect-loop deck start (i + 1) (list-push acc (list-at deck (start + i)))

Section: Baseball (3s and 9s wild, 4 gets extra card)

  pv-baseball : Integer, Rng -> PokerSession
  pv-baseball (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1-base = pv-collect-7 deck 0
    in let h2-base = pv-collect-7 deck 7
    in let wild-table = pv-build-rank-wilds [1, 7]
    in let best1 = pv-best-5-of-7 h1-base
    in let best2 = pv-best-5-of-7 h2-base
    in let rank1 = pv-evaluate-with-wilds best1 wild-table
    in let rank2 = pv-evaluate-with-wilds best2 wild-table
    in let winner = if rank1.rank > rank2.rank then 1
       else if rank2.rank > rank1.rank then 2
       else if rank1.primary > rank2.primary then 1
       else if rank2.primary > rank1.primary then 2
       else 0
    in PokerSession {
         variant = Baseball,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = 0
       }

Section: HiChicago

  pv-hi-chicago : Integer, Rng -> PokerSession
  pv-hi-chicago (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1-cards = pv-collect-7 deck 0
    in let h2-cards = pv-collect-7 deck 7
    in let hole1 = [list-at h1-cards 0, list-at h1-cards 1]
    in let hole2 = [list-at h2-cards 0, list-at h2-cards 1]
    in let best1 = pv-best-5-of-7 h1-cards
    in let best2 = pv-best-5-of-7 h2-cards
    in let rank1 = evaluate-hand best1
    in let rank2 = evaluate-hand best2
    in let spade1 = pv-highest-spade-in-hole hole1
    in let spade2 = pv-highest-spade-in-hole hole2
    in let hand-winner = compare-hands rank1 rank2
    in let spade-winner = if spade1 > spade2 then 1 else if spade2 > spade1 then 2 else 0
    in let overall = if hand-winner == spade-winner then hand-winner
       else if hand-winner == 0 then spade-winner
       else hand-winner
    in PokerSession {
         variant = HiChicago,
         seed = seed,
         num-players = 2,
         winner = overall,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = spade-winner
       }

Section: LowChicago

  pv-low-chicago : Integer, Rng -> PokerSession
  pv-low-chicago (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1-cards = pv-collect-7 deck 0
    in let h2-cards = pv-collect-7 deck 7
    in let hole1 = [list-at h1-cards 0, list-at h1-cards 1]
    in let hole2 = [list-at h2-cards 0, list-at h2-cards 1]
    in let best1 = pv-best-5-of-7 h1-cards
    in let best2 = pv-best-5-of-7 h2-cards
    in let rank1 = evaluate-hand best1
    in let rank2 = evaluate-hand best2
    in let spade1 = pv-lowest-spade-in-hole hole1
    in let spade2 = pv-lowest-spade-in-hole hole2
    in let hand-winner = compare-hands rank1 rank2
    in let spade-winner = if spade1 < 0 & spade2 < 0 then 0
       else if spade1 < 0 then 2
       else if spade2 < 0 then 1
       else if spade1 < spade2 then 1
       else if spade2 < spade1 then 2
       else 0
    in let overall = if hand-winner == spade-winner then hand-winner
       else if hand-winner == 0 then spade-winner
       else hand-winner
    in PokerSession {
         variant = LowChicago,
         seed = seed,
         num-players = 2,
         winner = overall,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = spade-winner
       }

Section: FollowTheQueen

 Card after each queen dealt face-up becomes wild rank.
 Queens are rank 10 (card-rank 10 = Queen: 0=2,1=3,...,10=Q,11=K,12=A).

  pv-follow-the-queen : Integer, Rng -> PokerSession
  pv-follow-the-queen (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1-cards = pv-collect-7 deck 0
    in let h2-cards = pv-collect-7 deck 7
    in let wild-rank = pv-find-follow-queen deck 14
    in let wild-table = if wild-rank < 0 then pv-build-false-list 52
       else pv-build-rank-wilds [wild-rank]
    in let best1 = pv-best-5-of-7 h1-cards
    in let best2 = pv-best-5-of-7 h2-cards
    in let rank1 = pv-evaluate-with-wilds best1 wild-table
    in let rank2 = pv-evaluate-with-wilds best2 wild-table
    in let winner = if rank1.rank > rank2.rank then 1
       else if rank2.rank > rank1.rank then 2
       else if rank1.primary > rank2.primary then 1
       else if rank2.primary > rank1.primary then 2
       else 0
    in PokerSession {
         variant = FollowTheQueen,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = wild-rank
       }

  pv-find-follow-queen : List Integer, Integer -> Integer
  pv-find-follow-queen (deck) (deal-count) =
    pv-ftq-loop deck deal-count 0 (-1)

  pv-ftq-loop : List Integer, Integer, Integer, Integer -> Integer
  pv-ftq-loop (deck) (deal-count) (i) (last-wild) =
    if i >= deal-count then last-wild
    else let card = list-at deck i
    in if card-rank card == 10 then
      let next-idx = i + 1
      in if next-idx < deal-count then
        pv-ftq-loop deck deal-count (i + 1) (card-rank (list-at deck next-idx))
      else pv-ftq-loop deck deal-count (i + 1) last-wild
    else pv-ftq-loop deck deal-count (i + 1) last-wild

Section: JacksOrBetter

 Pair of jacks (rank 9) or better needed to open; trips or better to win pot.
 If no one can open, pot rolls over (simplified: first player with jacks+ wins).

  pv-jacks-or-better : Integer, Rng -> PokerSession
  pv-jacks-or-better (seed) (r) =
    let deck = pv-shuffle (pv-build-deck 0 []) r
    in let h1 = deal-hand deck 0
    in let h2 = deal-hand deck 5
    in let rank1 = evaluate-hand h1
    in let rank2 = evaluate-hand h2
    in let can-open1 = pv-can-open h1
    in let can-open2 = pv-can-open h2
    in let can-win1 = rank1.rank >= 3
    in let can-win2 = rank2.rank >= 3
    in let winner = if can-open1 == False & can-open2 == False then 0
       else if can-win1 & can-win2 == False then 1
       else if can-win2 & can-win1 == False then 2
       else compare-hands rank1 rank2
    in PokerSession {
         variant = JacksOrBetter,
         seed = seed,
         num-players = 2,
         winner = winner,
         p1-hand-rank = rank1.rank,
         p2-hand-rank = rank2.rank,
         hands-played = 1,
         special-winner = if can-open1 then 1 else if can-open2 then 2 else 0
       }

  pv-can-open : PokerHand -> Boolean
  pv-can-open (h) =
    let rank1 = evaluate-hand h
    in if rank1.rank > 1 then True
    else if rank1.rank == 1 then rank1.primary >= 9
    else False

Section: Game Runner

  run-poker-variant : PokerVariant, Integer, Integer -> PokerSession
  run-poker-variant (variant) (seed) (num-players) =
    let r = rng-new seed
    in when variant
      is FiveCardDraw    -> pv-five-card-draw seed r
      is FiveCardStud    -> pv-five-card-stud seed r
      is SevenCardStud   -> pv-seven-card-stud seed r
      is Baseball        -> pv-baseball seed r
      is HiChicago       -> pv-hi-chicago seed r
      is LowChicago      -> pv-low-chicago seed r
      is FollowTheQueen  -> pv-follow-the-queen seed r
      is JacksOrBetter   -> pv-jacks-or-better seed r

  pv-variant-name : PokerVariant -> Text
  pv-variant-name (v) =
    when v
      is FiveCardDraw    -> "FiveCardDraw"
      is FiveCardStud    -> "FiveCardStud"
      is SevenCardStud   -> "SevenCardStud"
      is Baseball        -> "Baseball"
      is HiChicago       -> "HiChicago"
      is LowChicago      -> "LowChicago"
      is FollowTheQueen  -> "FollowTheQueen"
      is JacksOrBetter   -> "JacksOrBetter"

Section: Formatting

  format-poker-variant : PokerSession -> Text
  format-poker-variant (s) =
    let vname = pv-variant-name (s.variant)
    in let w = if s.winner == 1 then "P1"
       else if s.winner == 2 then "P2"
       else "Tie"
    in vname & " (seed=" & show (s.seed) & "): P1=" & rank-name (s.p1-hand-rank) &
       " P2=" & rank-name (s.p2-hand-rank) & " winner=" & w

Page 1


Chapter: Games--Pinochle
  cites Games chapter Rng

 Two-team Pinochle (4 players, teams 0 and 1). 48-card deck:
 ranks A,10,K,Q,J,9 (encoded 5,4,3,2,1,0) duplicated twice,
 four suits (0=clubs, 1=diamonds, 2=hearts, 3=spades).
 Card = suit * 12 + copy * 6 + rank.
 Scoring: melds then trick points (A=11, 10=10, K=4, Q=3, J=2).

 We say:

Section: Types

  PinochleCard = record {
    id   : Integer,
    suit : Integer,
    rank : Integer,
    copy : Integer
  }

  PinochleState = record {
    deck       : List Integer,
    h0         : List Integer,
    h1         : List Integer,
    h2         : List Integer,
    h3         : List Integer,
    trump      : Integer,
    tricks-won : List Integer
  }

  PinochleResult = record {
    team0-score : Integer,
    team1-score : Integer,
    winner      : Integer
  }

Section: Card Helpers

  pin-suit : Integer -> Integer
  pin-suit (c) = c / 12

  pin-rank : Integer -> Integer
  pin-rank (c) = rng-mod c 6

  pin-copy : Integer -> Integer
  pin-copy (c) = rng-mod (c / 6) 2

  pin-point-value : Integer -> Integer
  pin-point-value (rank) =
    if rank == 5 then 11
    else if rank == 4 then 10
    else if rank == 3 then 4
    else if rank == 2 then 3
    else if rank == 1 then 2
    else 0

  pin-rank-name : Integer -> Text
  pin-rank-name (rank) =
    if rank == 5 then "A"
    else if rank == 4 then "T"
    else if rank == 3 then "K"
    else if rank == 2 then "Q"
    else if rank == 1 then "J"
    else "9"

Section: Deck

  pin-deck-new : List Integer
  pin-deck-new = pin-build-deck 0 []

  pin-build-deck : Integer, List Integer -> List Integer
  pin-build-deck (i) (acc) =
    if i >= 48 then acc
    else pin-build-deck (i + 1) (list-push acc i)

  pin-shuffle : List Integer, Rng -> List Integer
  pin-shuffle (deck) (r) =
    pin-fy deck 47 r

  pin-fy : List Integer, Integer, Rng -> List Integer
  pin-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in pin-fy d3 (i - 1) r2

  pin-deal : List Integer -> PinochleState
  pin-deal (deck) =
    let h0 = pin-collect deck 0 12 []
    in let h1 = pin-collect deck 12 24 []
    in let h2 = pin-collect deck 24 36 []
    in let h3 = pin-collect deck 36 48 []
    in let trump = pin-suit (list-at deck 0)
    in let tw = list-push (list-push (list-push (list-push [] 0) 0) 0) 0
    in PinochleState { deck = deck, h0 = h0, h1 = h1, h2 = h2, h3 = h3, trump = trump, tricks-won = tw }

  pin-collect : List Integer, Integer, Integer, List Integer -> List Integer
  pin-collect (deck) (lo) (hi) (acc) =
    if lo >= hi then acc
    else pin-collect deck (lo + 1) hi (list-push acc (list-at deck lo))

Section: Melding

  count-suit-rank : List Integer, Integer, Integer -> Integer
  count-suit-rank (hand) (s) (rk) =
    count-sr-loop hand s rk 0 0

  count-sr-loop : List Integer, Integer, Integer, Integer, Integer -> Integer
  count-sr-loop (hand) (s) (rk) (i) (acc) =
    if i >= list-length hand then acc
    else let c = list-at hand i
    in let delta = if pin-suit c == s & pin-rank c == rk then 1 else 0
    in count-sr-loop hand s rk (i + 1) (acc + delta)

  has-sr : List Integer, Integer, Integer -> Boolean
  has-sr (hand) (s) (rk) = count-sr-loop hand s rk 0 0 >= 1

  meld-marriages : List Integer, Integer -> Integer
  meld-marriages (hand) (trump) =
    meld-marriage-loop hand trump 0 0

  meld-marriage-loop : List Integer, Integer, Integer, Integer -> Integer
  meld-marriage-loop (hand) (trump) (s) (score) =
    if s >= 4 then score
    else let has-k = has-sr hand s 3
    in let has-q = has-sr hand s 2
    in let pts = if has-k & has-q then if s == trump then 40 else 20 else 0
    in meld-marriage-loop hand trump (s + 1) (score + pts)

  meld-pinochle : List Integer -> Integer
  meld-pinochle (hand) =
    let has-jd = has-sr hand 1 1
    in let has-qs = has-sr hand 3 2
    in if has-jd & has-qs then 40 else 0

  meld-around : List Integer, Integer -> Integer
  meld-around (hand) (rk) =
    let s0 = count-sr-loop hand 0 rk 0 0 >= 1
    in let s1 = count-sr-loop hand 1 rk 0 0 >= 1
    in let s2 = count-sr-loop hand 2 rk 0 0 >= 1
    in let s3 = count-sr-loop hand 3 rk 0 0 >= 1
    in if s0 & s1 & s2 & s3 then
      if rk == 5 then 100
      else if rk == 3 then 80
      else if rk == 2 then 60
      else if rk == 1 then 40
      else 0
    else 0

  meld-run : List Integer, Integer -> Integer
  meld-run (hand) (trump) =
    let has-a  = has-sr hand trump 5
    in let has-t  = has-sr hand trump 4
    in let has-k  = has-sr hand trump 3
    in let has-q  = has-sr hand trump 2
    in let has-j  = has-sr hand trump 1
    in if has-a & has-t & has-k & has-q & has-j then 150 else 0

  score-meld : List Integer, Integer -> Integer
  score-meld (hand) (trump) =
    let m = meld-marriages hand trump
    in let p = meld-pinochle hand
    in let aa = meld-around hand 5
    in let ka = meld-around hand 3
    in let qa = meld-around hand 2
    in let ja = meld-around hand 1
    in let run = meld-run hand trump
    in m + p + aa + ka + qa + ja + run

Section: Trick Points

  score-tricks : List Integer -> Integer
  score-tricks (cards) =
    score-tricks-loop cards 0 0

  score-tricks-loop : List Integer, Integer, Integer -> Integer
  score-tricks-loop (cards) (i) (acc) =
    if i >= list-length cards then acc
    else let pts = pin-point-value (pin-rank (list-at cards i))
    in score-tricks-loop cards (i + 1) (acc + pts)

  pick-card : List Integer, Integer -> Integer
  pick-card (hand) (idx) =
    let n = list-length hand
    in if n == 0 then (-1)
    else list-at hand (rng-mod idx n)

Section: Simulated Play

  sim-trick : List Integer, List Integer, List Integer, List Integer, Integer -> Integer
  sim-trick (h0) (h1) (h2) (h3) (trump) =
    let c0 = if list-length h0 > 0 then list-at h0 0 else 0
    in let c1 = if list-length h1 > 0 then list-at h1 0 else 0
    in let c2 = if list-length h2 > 0 then list-at h2 0 else 0
    in let c3 = if list-length h3 > 0 then list-at h3 0 else 0
    in let led-suit = pin-suit c0
    in let w01 = trick-winner c0 c1 led-suit trump
    in let w012 = trick-winner w01 c2 led-suit trump
    in let w0123 = trick-winner w012 c3 led-suit trump
    in let pts = pin-point-value (pin-rank c0) + pin-point-value (pin-rank c1) +
                 pin-point-value (pin-rank c2) + pin-point-value (pin-rank c3)
    in if w0123 == c0 | w0123 == c2 then pts * 10 + 0
    else pts * 10 + 1

  trick-winner : Integer, Integer, Integer, Integer -> Integer
  trick-winner (current-best) (challenger) (led-suit) (trump) =
    let bs = pin-suit current-best
    in let cs = pin-suit challenger
    in let br = pin-rank current-best
    in let cr = pin-rank challenger
    in if cs == bs then
      if cr > br then challenger else current-best
    else if cs == trump then challenger
    else current-best

  play-all-tricks : PinochleState -> Integer
  play-all-tricks (st) =
    play-tricks-loop (st.h0) (st.h1) (st.h2) (st.h3) (st.trump) 0 0

  play-tricks-loop : List Integer, List Integer, List Integer, List Integer, Integer, Integer, Integer -> Integer
  play-tricks-loop (h0) (h1) (h2) (h3) (trump) (trick) (team0-pts) =
    if list-length h0 == 0 then team0-pts
    else let result = sim-trick h0 h1 h2 h3 trump
    in let pts = result / 10
    in let team-won = rng-mod result 10
    in let new-t0 = if team-won == 0 then team0-pts + pts else team0-pts
    in let h0b = drop-first h0
    in let h1b = drop-first h1
    in let h2b = drop-first h2
    in let h3b = drop-first h3
    in play-tricks-loop h0b h1b h2b h3b trump (trick + 1) new-t0

  drop-first : List Integer -> List Integer
  drop-first (xs) =
    drop-first-loop xs 1 []

  drop-first-loop : List Integer, Integer, List Integer -> List Integer
  drop-first-loop (xs) (i) (acc) =
    if i >= list-length xs then acc
    else drop-first-loop xs (i + 1) (list-push acc (list-at xs i))

Section: Game Runner

  run-pinochle-hand : Integer -> PinochleResult
  run-pinochle-hand (seed) =
    let deck = pin-shuffle pin-deck-new (rng-new seed)
    in let st = pin-deal deck
    in let meld0 = score-meld (st.h0) (st.trump) + score-meld (st.h2) (st.trump)
    in let meld1 = score-meld (st.h1) (st.trump) + score-meld (st.h3) (st.trump)
    in let trick-pts = play-all-tricks st
    in let trick1 = trick-pts
    in let total-pts = score-tricks (st.h0) + score-tricks (st.h1) +
                       score-tricks (st.h2) + score-tricks (st.h3)
    in let trick0-pts = trick1
    in let trick1-pts = total-pts - trick0-pts
    in let team0 = meld0 + trick0-pts
    in let team1 = meld1 + trick1-pts
    in let w = if team0 > team1 then 0 else if team1 > team0 then 1 else (-1)
    in PinochleResult { team0-score = team0, team1-score = team1, winner = w }

Section: Formatting

  format-pinochle-result : PinochleResult -> Text
  format-pinochle-result (r) =
    let w = if r.winner == 0 then "Team0" else if r.winner == 1 then "Team1" else "Tie"
    in "Pinochle: Team0=" & show (r.team0-score) &
       " Team1=" & show (r.team1-score) & " winner=" & w

Page 1


Chapter: Games--GoFish
  cites Games chapter Rng

 Go Fish: standard 52-card deck, 2-4 players. Card encoding: 0-51,
 rank = card mod 13, suit = card / 13. 7 cards each (5 if 4+ players).
 Ask opponent for a rank; if they have it, take all of that rank.
 If not, draw from pile. Complete 4-of-a-kind = book. Game ends
 when all 13 books are collected or deck + hands are empty.
 AI asks for the rank it holds most of, targeting the player with most cards.

 We say:

Section: Types

  GoFishState = record {
    hands          : List Integer,
    hand-sizes     : List Integer,
    draw-pile      : List Integer,
    pile-size      : Integer,
    books          : List Integer,
    current-player : Integer,
    num-players    : Integer,
    game-over      : Boolean,
    total-books    : Integer
  }

  GoFishResult = record {
    winner     : Integer,
    books-each : List Integer,
    turns      : Integer
  }

Section: Card Helpers

  gf-rank : Integer -> Integer
  gf-rank (c) = rng-mod c 13

Section: Deck

  gf-build-deck : Integer, List Integer -> List Integer
  gf-build-deck (i) (acc) =
    if i >= 52 then acc
    else gf-build-deck (i + 1) (list-push acc i)

  gf-shuffle : List Integer, Rng -> List Integer
  gf-shuffle (deck) (r) = gf-fy deck 51 r

  gf-fy : List Integer, Integer, Rng -> List Integer
  gf-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in gf-fy d3 (i - 1) r2

Section: Hand Storage

 Hands are stored in a flat list of 52 slots per player (player*52 + card-slot).
 hand-sizes tracks how many cards each player holds.
 A slot value of 1 means the player holds that card index, 0 means not held.

  gf-hand-has : GoFishState, Integer, Integer -> Boolean
  gf-hand-has (s) (player) (card-idx) =
    list-at (s.hands) (player * 52 + card-idx) == 1

  gf-hand-set : GoFishState, Integer, Integer, Integer -> GoFishState
  gf-hand-set (s) (player) (card-idx) (val) =
    let slot = player * 52 + card-idx
    in let old = list-at (s.hands) slot
    in let delta = val - old
    in let new-hands = list-set-at (s.hands) slot val
    in let new-size = list-at (s.hand-sizes) player + delta
    in let new-sizes = list-set-at (s.hand-sizes) player new-size
    in GoFishState {
         hands = new-hands,
         hand-sizes = new-sizes,
         draw-pile = s.draw-pile,
         pile-size = s.pile-size,
         books = s.books,
         current-player = s.current-player,
         num-players = s.num-players,
         game-over = s.game-over,
         total-books = s.total-books
       }

  gf-count-rank-in-hand : GoFishState, Integer, Integer -> Integer
  gf-count-rank-in-hand (s) (player) (rank) =
    gf-count-rank-loop s player rank 0 0

  gf-count-rank-loop : GoFishState, Integer, Integer, Integer, Integer -> Integer
  gf-count-rank-loop (s) (player) (rank) (suit) (acc) =
    if suit >= 4 then acc
    else let card-idx = suit * 13 + rank
    in let held = if gf-hand-has s player card-idx then 1 else 0
    in gf-count-rank-loop s player rank (suit + 1) (acc + held)

Section: Initial Deal

  gf-init : Integer, Integer -> GoFishState
  gf-init (seed) (num-players) =
    let deck = gf-shuffle (gf-build-deck 0 []) (rng-new seed)
    in let cards-each = if num-players >= 4 then 5 else 7
    in let hand-slots = gf-build-zeroes 0 (num-players * 52) []
    in let sizes = gf-build-zeroes 0 num-players []
    in let books = gf-build-zeroes 0 num-players []
    in let pile = gf-build-zeroes 0 52 []
    in let s0 = GoFishState {
         hands = hand-slots,
         hand-sizes = sizes,
         draw-pile = pile,
         pile-size = 0,
         books = books,
         current-player = 0,
         num-players = num-players,
         game-over = False,
         total-books = 0
       }
    in let total-deal = cards-each * num-players
    in let s1 = gf-deal-cards s0 deck 0 num-players cards-each 0
    in let s2 = gf-load-pile s1 deck total-deal 0
    in s2

  gf-build-zeroes : Integer, Integer, List Integer -> List Integer
  gf-build-zeroes (i) (n) (acc) =
    if i >= n then acc
    else gf-build-zeroes (i + 1) n (list-push acc 0)

  gf-deal-cards : GoFishState, List Integer, Integer, Integer, Integer, Integer -> GoFishState
  gf-deal-cards (s) (deck) (dealt) (num-players) (cards-each) (player) =
    if dealt >= cards-each * num-players then s
    else let p = rng-mod dealt cards-each
    in let pp = if p == 0 then player else player
    in let actual-player = dealt / cards-each
    in let card-idx = list-at deck dealt
    in let s2 = gf-hand-set s actual-player card-idx 1
    in gf-deal-cards s2 deck (dealt + 1) num-players cards-each player

  gf-load-pile : GoFishState, List Integer, Integer, Integer -> GoFishState
  gf-load-pile (s) (deck) (start) (i) =
    if start + i >= 52 then s
    else let card-idx = list-at deck (start + i)
    in let new-pile = list-set-at (s.draw-pile) i card-idx
    in let s2 = GoFishState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = new-pile,
         pile-size = s.pile-size + 1,
         books = s.books,
         current-player = s.current-player,
         num-players = s.num-players,
         game-over = s.game-over,
         total-books = s.total-books
       }
    in gf-load-pile s2 deck start (i + 1)

Section: Book Checking

  gf-check-books : GoFishState, Integer -> GoFishState
  gf-check-books (s) (player) =
    gf-check-books-loop s player 0

  gf-check-books-loop : GoFishState, Integer, Integer -> GoFishState
  gf-check-books-loop (s) (player) (rank) =
    if rank >= 13 then s
    else let cnt = gf-count-rank-in-hand s player rank
    in if cnt == 4 then
      let s2 = gf-remove-rank s player rank 0
      in let new-books = list-set-at (s2.books) player (list-at (s2.books) player + 1)
      in let s3 = GoFishState {
           hands = s2.hands,
           hand-sizes = s2.hand-sizes,
           draw-pile = s2.draw-pile,
           pile-size = s2.pile-size,
           books = new-books,
           current-player = s2.current-player,
           num-players = s2.num-players,
           game-over = s2.game-over,
           total-books = s2.total-books + 1
         }
      in gf-check-books-loop s3 player (rank + 1)
    else gf-check-books-loop s player (rank + 1)

  gf-remove-rank : GoFishState, Integer, Integer, Integer -> GoFishState
  gf-remove-rank (s) (player) (rank) (suit) =
    if suit >= 4 then s
    else let card-idx = suit * 13 + rank
    in let s2 = gf-hand-set s player card-idx 0
    in gf-remove-rank s2 player rank (suit + 1)

Section: Draw from Pile

  gf-draw-card : GoFishState, Integer -> GoFishState
  gf-draw-card (s) (player) =
    if s.pile-size <= 0 then s
    else let card-idx = list-at (s.draw-pile) 0
    in let new-pile = gf-shift-pile (s.draw-pile) 0 (s.pile-size)
    in let s2 = GoFishState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = new-pile,
         pile-size = s.pile-size - 1,
         books = s.books,
         current-player = s.current-player,
         num-players = s.num-players,
         game-over = s.game-over,
         total-books = s.total-books
       }
    in let s3 = gf-hand-set s2 player card-idx 1
    in gf-check-books s3 player

  gf-shift-pile : List Integer, Integer, Integer -> List Integer
  gf-shift-pile (pile) (i) (sz) =
    if i + 1 >= sz then pile
    else let next = list-at pile (i + 1)
    in let p2 = list-set-at pile i next
    in gf-shift-pile p2 (i + 1) sz

Section: Transfer Cards

  gf-transfer-rank : GoFishState, Integer, Integer, Integer -> GoFishState
  gf-transfer-rank (s) (from-player) (to-player) (rank) =
    gf-transfer-rank-loop s from-player to-player rank 0

  gf-transfer-rank-loop : GoFishState, Integer, Integer, Integer, Integer -> GoFishState
  gf-transfer-rank-loop (s) (from-p) (to-p) (rank) (suit) =
    if suit >= 4 then s
    else let card-idx = suit * 13 + rank
    in if gf-hand-has s from-p card-idx then
      let s2 = gf-hand-set s from-p card-idx 0
      in let s3 = gf-hand-set s2 to-p card-idx 1
      in gf-transfer-rank-loop s3 from-p to-p rank (suit + 1)
    else gf-transfer-rank-loop s from-p to-p rank (suit + 1)

Section: AI Strategy

  gf-ai-rank-to-ask : GoFishState, Integer -> Integer
  gf-ai-rank-to-ask (s) (player) =
    gf-best-rank-loop s player 0 (-1) 0

  gf-best-rank-loop : GoFishState, Integer, Integer, Integer, Integer -> Integer
  gf-best-rank-loop (s) (player) (rank) (best-rank) (best-count) =
    if rank >= 13 then if best-rank < 0 then 0 else best-rank
    else let cnt = gf-count-rank-in-hand s player rank
    in if cnt > best-count then gf-best-rank-loop s player (rank + 1) rank cnt
    else gf-best-rank-loop s player (rank + 1) best-rank best-count

  gf-ai-target : GoFishState, Integer -> Integer
  gf-ai-target (s) (player) =
    gf-target-loop s player 0 (rng-mod player s.num-players) 0

  gf-target-loop : GoFishState, Integer, Integer, Integer, Integer -> Integer
  gf-target-loop (s) (player) (i) (best-target) (best-size) =
    if i >= s.num-players then best-target
    else if i == player then gf-target-loop s player (i + 1) best-target best-size
    else let sz = list-at (s.hand-sizes) i
    in if sz > best-size then gf-target-loop s player (i + 1) i sz
    else gf-target-loop s player (i + 1) best-target best-size

Section: Turn

  gf-do-turn : GoFishState -> GoFishState
  gf-do-turn (s) =
    if s.game-over then s
    else let player = s.current-player
    in let rank = gf-ai-rank-to-ask s player
    in let cnt-held = gf-count-rank-in-hand s player rank
    in if cnt-held == 0 then gf-advance-player s
    else let target = gf-ai-target s player
    in let target-has = gf-count-rank-in-hand s target rank
    in if target-has > 0 then
      let s2 = gf-transfer-rank s target player rank
      in let s3 = gf-check-books s2 player
      in let s4 = gf-check-game-over s3
      in gf-advance-player s4
    else
      let s2 = gf-draw-card s player
      in let s3 = gf-check-game-over s2
      in gf-advance-player s3

  gf-advance-player : GoFishState -> GoFishState
  gf-advance-player (s) =
    let next = rng-mod (s.current-player + 1) s.num-players
    in GoFishState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = s.draw-pile,
         pile-size = s.pile-size,
         books = s.books,
         current-player = next,
         num-players = s.num-players,
         game-over = s.game-over,
         total-books = s.total-books
       }

  gf-check-game-over : GoFishState -> GoFishState
  gf-check-game-over (s) =
    let done = s.total-books >= 13 | s.pile-size == 0 & gf-all-hands-empty s
    in GoFishState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = s.draw-pile,
         pile-size = s.pile-size,
         books = s.books,
         current-player = s.current-player,
         num-players = s.num-players,
         game-over = done,
         total-books = s.total-books
       }

  gf-all-hands-empty : GoFishState -> Boolean
  gf-all-hands-empty (s) =
    gf-hands-empty-loop s 0

  gf-hands-empty-loop : GoFishState, Integer -> Boolean
  gf-hands-empty-loop (s) (i) =
    if i >= s.num-players then True
    else if list-at (s.hand-sizes) i > 0 then False
    else gf-hands-empty-loop s (i + 1)

Section: Game Runner

  run-go-fish : Integer, Integer -> GoFishResult
  run-go-fish (seed) (num-players) =
    let np = if num-players < 2 then 2 else if num-players > 4 then 4 else num-players
    in let s = gf-init seed np
    in gf-loop s 0

  gf-loop : GoFishState, Integer -> GoFishResult
  gf-loop (s) (turns) =
    if s.game-over then gf-make-result s turns
    else if turns > 500 then gf-make-result s turns
    else gf-loop (gf-do-turn s) (turns + 1)

  gf-make-result : GoFishState, Integer -> GoFishResult
  gf-make-result (s) (turns) =
    let winner = gf-find-winner s 0 0 (-1)
    in GoFishResult { winner = winner, books-each = s.books, turns = turns }

  gf-find-winner : GoFishState, Integer, Integer, Integer -> Integer
  gf-find-winner (s) (i) (best-books) (best-player) =
    if i >= s.num-players then best-player
    else let b = list-at (s.books) i
    in if b > best-books then gf-find-winner s (i + 1) b i
    else gf-find-winner s (i + 1) best-books best-player

Section: Formatting

  format-go-fish : GoFishResult, Integer -> Text
  format-go-fish (r) (num-players) =
    let w = if r.winner < 0 then "None" else "P" & show (r.winner + 1)
    in "GoFish (" & show num-players & "p, " & show r.turns & " turns): winner=" & w &
       " books=" & gf-format-books (r.books-each) num-players 0

  gf-format-books : List Integer, Integer, Integer -> Text
  gf-format-books (books) (np) (i) =
    if i >= np then ""
    else let sep = if i == 0 then "[" else ","
    in let tail = if i + 1 >= np then "]" else ""
    in sep & show (list-at books i) & tail & gf-format-books books np (i + 1)

