Chapter: Games--RPS
  cites Games chapter Rng

 Rock-Paper-Scissors. Best of N rounds, two AI players.
 Moves: 0=Rock, 1=Paper, 2=Scissors.
 AI uses weighted random based on opponent history: tracks how often
 the opponent played each move and biases toward the counter-move.
 Player 1 counters player 2's history; player 2 counters player 1's history.

 We say:

Section: Types

  RPSState = record {
    p1-counts : List Integer,
    p2-counts : List Integer,
    p1-wins   : Integer,
    p2-wins   : Integer,
    ties      : Integer,
    rng       : Rng
  }

  RPSResult = record {
    p1-wins : Integer,
    p2-wins : Integer,
    ties    : Integer
  }

Section: Move Logic

  rps-beats : Integer -> Integer
  rps-beats (move) =
    if move == 0 then 2
    else if move == 1 then 0
    else 1

  rps-outcome : Integer, Integer -> Integer
  rps-outcome (m1) (m2) =
    if m1 == m2 then 0
    else if rps-beats m1 == m2 then 1
    else (-1)

Section: Weighted AI

  rps-weighted-move : List Integer, Rng -> Integer
  rps-weighted-move (opp-counts) (r) =
    let c0 = list-at opp-counts 0
    in let c1 = list-at opp-counts 1
    in let c2 = list-at opp-counts 2
    in let total = c0 + c1 + c2
    in if total == 0 then rng-mod (rng-value r) 3
    else let counter0 = rps-beats 0
    in let counter1 = rps-beats 1
    in let counter2 = rps-beats 2
    in let w0 = c0 + 1
    in let w1 = c1 + 1
    in let w2 = c2 + 1
    in let best-counter = rps-pick-counter w0 w1 w2 counter0 counter1 counter2
    in let fuzz = rng-mod (rng-value r) (total + 3)
    in if fuzz < 2 then rng-mod (rng-value r) 3
    else best-counter

  rps-pick-counter : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  rps-pick-counter (w0) (w1) (w2) (c0) (c1) (c2) =
    if w0 >= w1 & w0 >= w2 then c0
    else if w1 >= w0 & w1 >= w2 then c1
    else c2

Section: Turn

  rps-do-round : RPSState -> RPSState
  rps-do-round (s) =
    let r1 = rng-next (s.rng)
    in let r2 = rng-next r1
    in let m1 = rps-weighted-move (s.p2-counts) r1
    in let m2 = rps-weighted-move (s.p1-counts) r2
    in let result = rps-outcome m1 m2
    in let new-p1-counts = list-set-at (s.p1-counts) m1 (list-at (s.p1-counts) m1 + 1)
    in let new-p2-counts = list-set-at (s.p2-counts) m2 (list-at (s.p2-counts) m2 + 1)
    in let new-p1-wins = if result == 1 then s.p1-wins + 1 else s.p1-wins
    in let new-p2-wins = if result == (-1) then s.p2-wins + 1 else s.p2-wins
    in let new-ties = if result == 0 then s.ties + 1 else s.ties
    in RPSState {
         p1-counts = new-p1-counts,
         p2-counts = new-p2-counts,
         p1-wins   = new-p1-wins,
         p2-wins   = new-p2-wins,
         ties      = new-ties,
         rng       = r2
       }

Section: Game Runner

  rps-init : Integer -> RPSState
  rps-init (seed) =
    RPSState {
      p1-counts = [0, 0, 0],
      p2-counts = [0, 0, 0],
      p1-wins   = 0,
      p2-wins   = 0,
      ties      = 0,
      rng       = rng-new seed
    }

  run-rps-series : Integer, Integer -> RPSResult
  run-rps-series (seed) (num-rounds) =
    let s = rps-init seed
    in rps-loop s num-rounds

  rps-loop : RPSState, Integer -> RPSResult
  rps-loop (s) (remaining) =
    if remaining <= 0 then
      RPSResult { p1-wins = s.p1-wins, p2-wins = s.p2-wins, ties = s.ties }
    else rps-loop (rps-do-round s) (remaining - 1)

Section: Formatting

  format-rps-result : RPSResult -> Text
  format-rps-result (r) =
    let total = r.p1-wins + r.p2-wins + r.ties
    in "RPS (" & show total & " rounds): P1=" & show (r.p1-wins) &
       " P2=" & show (r.p2-wins) & " ties=" & show (r.ties)

Page 1


Chapter: Games--Poker
  cites Games chapter Rng

 Five-card draw poker, two players. Cards are integers 0-51:
 suit = card / 13, rank = card mod 13 (0=2 up to 12=Ace).
 Hand ranks: 0=high-card, 1=pair, 2=two-pair, 3=trips,
 4=straight, 5=flush, 6=full-house, 7=quads, 8=straight-flush.

 We say:

Section: Types

  PokerHand = record {
    cards : List Integer
  }

  HandRank = record {
    rank    : Integer,
    primary : Integer,
    secondary : Integer
  }

  PokerResult = record {
    winner        : Integer,
    p1-rank       : Integer,
    p2-rank       : Integer,
    hands-played  : Integer
  }

Section: Card Helpers

  card-rank : Integer -> Integer
  card-rank (c) = rng-mod c 13

  card-suit : Integer -> Integer
  card-suit (c) = c / 13

  card-rank-name : Integer -> Text
  card-rank-name (r) =
    if r == 12 then "A"
    else if r == 11 then "K"
    else if r == 10 then "Q"
    else if r == 9  then "J"
    else if r == 8  then "T"
    else show (r + 2)

Section: Deck Building and Shuffle

  poker-deck-new : List Integer
  poker-deck-new = poker-build-deck 0 []

  poker-build-deck : Integer, List Integer -> List Integer
  poker-build-deck (i) (acc) =
    if i >= 52 then acc
    else poker-build-deck (i + 1) (list-push acc i)

  poker-shuffle : List Integer, Rng -> List Integer
  poker-shuffle (deck) (r) =
    poker-fy deck 51 r

  poker-fy : List Integer, Integer, Rng -> List Integer
  poker-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in poker-fy d3 (i - 1) r2

Section: Dealing

  deal-hand : List Integer, Integer -> PokerHand
  deal-hand (deck) (start) =
    let c0 = list-at deck start
    in let c1 = list-at deck (start + 1)
    in let c2 = list-at deck (start + 2)
    in let c3 = list-at deck (start + 3)
    in let c4 = list-at deck (start + 4)
    in let cards = list-push (list-push (list-push (list-push (list-push [] c0) c1) c2) c3) c4
    in PokerHand { cards = cards }

Section: Hand Evaluation

  count-rank : List Integer, Integer -> Integer
  count-rank (cards) (r) =
    count-rank-loop cards r 0 0

  count-rank-loop : List Integer, Integer, Integer, Integer -> Integer
  count-rank-loop (cards) (r) (i) (acc) =
    if i >= 5 then acc
    else let delta = if card-rank (list-at cards i) == r then 1 else 0
    in count-rank-loop cards r (i + 1) (acc + delta)

  count-suit : List Integer, Integer -> Integer
  count-suit (cards) (s) =
    count-suit-loop cards s 0 0

  count-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  count-suit-loop (cards) (s) (i) (acc) =
    if i >= 5 then acc
    else let delta = if card-suit (list-at cards i) == s then 1 else 0
    in count-suit-loop cards s (i + 1) (acc + delta)

  hand-is-flush : List Integer -> Boolean
  hand-is-flush (cards) =
    let s = card-suit (list-at cards 0)
    in count-suit cards s == 5

  hand-min-rank : List Integer -> Integer
  hand-min-rank (cards) =
    hand-min-loop cards 0 12

  hand-min-loop : List Integer, Integer, Integer -> Integer
  hand-min-loop (cards) (i) (m) =
    if i >= 5 then m
    else let r = card-rank (list-at cards i)
    in let new-m = if r < m then r else m
    in hand-min-loop cards (i + 1) new-m

  hand-max-rank : List Integer -> Integer
  hand-max-rank (cards) =
    hand-max-loop cards 0 0

  hand-max-loop : List Integer, Integer, Integer -> Integer
  hand-max-loop (cards) (i) (m) =
    if i >= 5 then m
    else let r = card-rank (list-at cards i)
    in let new-m = if r > m then r else m
    in hand-max-loop cards (i + 1) new-m

  hand-is-straight : List Integer -> Boolean
  hand-is-straight (cards) =
    let mn = hand-min-rank cards
    in let mx = hand-max-rank cards
    in let span = mx - mn
    in if span /= 4 then False
    else count-unique-ranks cards 0 0 == 5

  count-unique-ranks : List Integer, Integer, Integer -> Integer
  count-unique-ranks (cards) (r) (acc) =
    if r >= 13 then acc
    else let n = count-rank cards r
    in let delta = if n > 0 then 1 else 0
    in count-unique-ranks cards (r + 1) (acc + delta)

  best-rank-of-count : List Integer, Integer -> Integer
  best-rank-of-count (cards) (target) =
    best-rank-loop cards target 12 (-1)

  best-rank-loop : List Integer, Integer, Integer, Integer -> Integer
  best-rank-loop (cards) (target) (r) (found) =
    if r < 0 then found
    else let n = count-rank cards r
    in let new-found = if n == target then r else found
    in best-rank-loop cards target (r - 1) new-found

  max-rank-count : List Integer -> Integer
  max-rank-count (cards) =
    max-count-loop cards 0 0

  max-count-loop : List Integer, Integer, Integer -> Integer
  max-count-loop (cards) (r) (best) =
    if r >= 13 then best
    else let n = count-rank cards r
    in let new-best = if n > best then n else best
    in max-count-loop cards (r + 1) new-best

  evaluate-hand : PokerHand -> HandRank
  evaluate-hand (h) =
    let cards = h.cards
    in let flush = hand-is-flush cards
    in let straight = hand-is-straight cards
    in let mc = max-rank-count cards
    in let quad-rank = best-rank-of-count cards 4
    in let trip-rank = best-rank-of-count cards 3
    in let pair-rank = best-rank-of-count cards 2
    in let hi = hand-max-rank cards
    in if flush & straight then HandRank { rank = 8, primary = hi, secondary = 0 }
    else if mc == 4 then HandRank { rank = 7, primary = quad-rank, secondary = hi }
    else if trip-rank >= 0 & pair-rank >= 0 then HandRank { rank = 6, primary = trip-rank, secondary = pair-rank }
    else if flush then HandRank { rank = 5, primary = hi, secondary = 0 }
    else if straight then HandRank { rank = 4, primary = hi, secondary = 0 }
    else if mc == 3 then HandRank { rank = 3, primary = trip-rank, secondary = hi }
    else if mc == 2 then
      let p2 = second-pair-rank cards pair-rank
      in if p2 >= 0 then HandRank { rank = 2, primary = pair-rank, secondary = p2 }
      else HandRank { rank = 1, primary = pair-rank, secondary = hi }
    else HandRank { rank = 0, primary = hi, secondary = 0 }

  second-pair-rank : List Integer, Integer -> Integer
  second-pair-rank (cards) (first-pair) =
    second-pair-loop cards first-pair 12 (-1)

  second-pair-loop : List Integer, Integer, Integer, Integer -> Integer
  second-pair-loop (cards) (first-pair) (r) (found) =
    if r < 0 then found
    else if r == first-pair then second-pair-loop cards first-pair (r - 1) found
    else let n = count-rank cards r
    in let new-found = if n >= 2 then r else found
    in second-pair-loop cards first-pair (r - 1) new-found

Section: Hand Comparison

  compare-hands : HandRank, HandRank -> Integer
  compare-hands (a) (b) =
    if a.rank > b.rank then 1
    else if a.rank < b.rank then 2
    else if a.primary > b.primary then 1
    else if a.primary < b.primary then 2
    else if a.secondary > b.secondary then 1
    else if a.secondary < b.secondary then 2
    else 0

Section: Draw Strategy (AI)

  draw-count : PokerHand -> Integer
  draw-count (h) =
    let cards = h.cards
    in let mc = max-rank-count cards
    in let flush = hand-is-flush cards
    in let straight = hand-is-straight cards
    in if flush | straight then 0
    else if mc == 4 then 1
    else if mc == 3 then 2
    else if mc == 2 then
      let p2 = second-pair-rank cards (best-rank-of-count cards 2)
      in if p2 >= 0 then 1 else 2
    else 3

Section: Game Runner

  run-poker-hand : Rng -> PokerResult
  run-poker-hand (r) =
    let deck = poker-shuffle poker-deck-new r
    in let h1 = deal-hand deck 0
    in let h2 = deal-hand deck 5
    in let rank1 = evaluate-hand h1
    in let rank2 = evaluate-hand h2
    in let winner = compare-hands rank1 rank2
    in PokerResult { winner = winner, p1-rank = rank1.rank, p2-rank = rank2.rank, hands-played = 1 }

  run-poker-session : Integer, Integer -> PokerResult
  run-poker-session (seed) (n) =
    poker-session-loop (rng-new seed) n 0 0 0 0

  poker-session-loop : Rng, Integer, Integer, Integer, Integer, Integer -> PokerResult
  poker-session-loop (r) (n) (played) (p1-wins) (p2-wins) (last-rank1) =
    if played >= n then PokerResult { winner = if p1-wins > p2-wins then 1 else if p2-wins > p1-wins then 2 else 0, p1-rank = p1-wins, p2-rank = p2-wins, hands-played = played }
    else let r2 = rng-next r
    in let deck = poker-shuffle poker-deck-new r2
    in let h1 = deal-hand deck 0
    in let h2 = deal-hand deck 5
    in let rank1 = evaluate-hand h1
    in let rank2 = evaluate-hand h2
    in let w = compare-hands rank1 rank2
    in let new-p1 = if w == 1 then p1-wins + 1 else p1-wins
    in let new-p2 = if w == 2 then p2-wins + 1 else p2-wins
    in poker-session-loop r2 n (played + 1) new-p1 new-p2 rank1.rank

Section: Formatting

  rank-name : Integer -> Text
  rank-name (r) =
    if r == 8 then "Straight-Flush"
    else if r == 7 then "Quads"
    else if r == 6 then "Full-House"
    else if r == 5 then "Flush"
    else if r == 4 then "Straight"
    else if r == 3 then "Trips"
    else if r == 2 then "Two-Pair"
    else if r == 1 then "Pair"
    else "High-Card"

  format-poker-result : PokerResult -> Text
  format-poker-result (r) =
    let w = if r.winner == 1 then "P1" else if r.winner == 2 then "P2" else "Tie"
    in "Poker (" & show (r.hands-played) & " hands): P1=" & show (r.p1-rank) &
       " P2=" & show (r.p2-rank) & " overall=" & w

Page 1


Chapter: Games--War
  cites Games chapter Rng

 War card game. 52-card deck split evenly between 2 players (26 each).
 Each round both players flip their top card; higher card wins both.
 On a tie (war): each player places 3 cards face-down then 1 face-up;
 the higher face-up card takes all cards. If a player runs out during war,
 the other player wins. Game ends when one player has all 52 cards or
 after 1000 rounds (whichever comes first). Winner is player with more cards.

 We say:

Section: Types

  WarState = record {
    p1-hand  : List Integer,
    p1-size  : Integer,
    p2-hand  : List Integer,
    p2-size  : Integer,
    rng      : Rng
  }

  WarResult = record {
    winner       : Integer,
    rounds-played : Integer
  }

Section: Deck

  war-build-deck : Integer, List Integer -> List Integer
  war-build-deck (i) (acc) =
    if i >= 52 then acc
    else war-build-deck (i + 1) (list-push acc i)

  war-shuffle : List Integer, Rng -> List Integer
  war-shuffle (deck) (r) = war-fy deck 51 r

  war-fy : List Integer, Integer, Rng -> List Integer
  war-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in war-fy d3 (i - 1) r2

  war-card-rank : Integer -> Integer
  war-card-rank (c) = rng-mod c 13

Section: Hand Operations

  war-take-top : List Integer, Integer -> Integer
  war-take-top (hand) (size) =
    if size <= 0 then (-1) else list-at hand 0

  war-shift-hand : List Integer, Integer -> List Integer
  war-shift-hand (hand) (size) = war-shift-loop hand 0 size

  war-shift-loop : List Integer, Integer, Integer -> List Integer
  war-shift-loop (hand) (i) (size) =
    if i + 1 >= size then hand
    else let next = list-at hand (i + 1)
    in let h2 = list-set-at hand i next
    in war-shift-loop h2 (i + 1) size

  war-add-card : List Integer, Integer, Integer -> List Integer
  war-add-card (hand) (size) (card) =
    if size >= 52 then hand
    else list-set-at hand size card

Section: Round Logic

  war-do-round : WarState -> WarState
  war-do-round (s) =
    if s.p1-size <= 0 then s
    else if s.p2-size <= 0 then s
    else let c1 = war-take-top (s.p1-hand) (s.p1-size)
    in let c2 = war-take-top (s.p2-hand) (s.p2-size)
    in let h1 = war-shift-hand (s.p1-hand) (s.p1-size)
    in let h2 = war-shift-hand (s.p2-hand) (s.p2-size)
    in let s2 = WarState {
           p1-hand  = h1,
           p1-size  = s.p1-size - 1,
           p2-hand  = h2,
           p2-size  = s.p2-size - 1,
           rng      = s.rng
         }
    in let r1 = war-card-rank c1
    in let r2 = war-card-rank c2
    in if r1 > r2 then war-p1-takes s2 c1 c2
    else if r2 > r1 then war-p2-takes s2 c1 c2
    else war-do-war s2 c1 c2

  war-p1-takes : WarState, Integer, Integer -> WarState
  war-p1-takes (s) (c1) (c2) =
    let h1a = war-add-card (s.p1-hand) (s.p1-size) c1
    in let h1b = war-add-card h1a (s.p1-size + 1) c2
    in WarState {
         p1-hand  = h1b,
         p1-size  = s.p1-size + 2,
         p2-hand  = s.p2-hand,
         p2-size  = s.p2-size,
         rng      = s.rng
       }

  war-p2-takes : WarState, Integer, Integer -> WarState
  war-p2-takes (s) (c1) (c2) =
    let h2a = war-add-card (s.p2-hand) (s.p2-size) c1
    in let h2b = war-add-card h2a (s.p2-size + 1) c2
    in WarState {
         p1-hand  = s.p1-hand,
         p1-size  = s.p1-size,
         p2-hand  = h2b,
         p2-size  = s.p2-size + 2,
         rng      = s.rng
       }

  war-do-war : WarState, Integer, Integer -> WarState
  war-do-war (s) (orig1) (orig2) =
    let skip1 = if s.p1-size >= 3 then 3 else s.p1-size
    in let skip2 = if s.p2-size >= 3 then 3 else s.p2-size
    in let s2 = war-skip-cards s skip1 skip2
    in if s2.p1-size <= 0 then s2
    else if s2.p2-size <= 0 then s2
    else let wc1 = war-take-top (s2.p1-hand) (s2.p1-size)
    in let wc2 = war-take-top (s2.p2-hand) (s2.p2-size)
    in let h1 = war-shift-hand (s2.p1-hand) (s2.p1-size)
    in let h2 = war-shift-hand (s2.p2-hand) (s2.p2-size)
    in let s3 = WarState {
           p1-hand  = h1,
           p1-size  = s2.p1-size - 1,
           p2-hand  = h2,
           p2-size  = s2.p2-size - 1,
           rng      = s2.rng
         }
    in let wr1 = war-card-rank wc1
    in let wr2 = war-card-rank wc2
    in if wr1 >= wr2 then war-p1-takes s3 wc1 wc2
    else war-p2-takes s3 wc1 wc2

  war-skip-cards : WarState, Integer, Integer -> WarState
  war-skip-cards (s) (n1) (n2) =
    let h1 = war-skip-n (s.p1-hand) (s.p1-size) n1
    in let h2 = war-skip-n (s.p2-hand) (s.p2-size) n2
    in WarState {
         p1-hand  = h1,
         p1-size  = s.p1-size - n1,
         p2-hand  = h2,
         p2-size  = s.p2-size - n2,
         rng      = s.rng
       }

  war-skip-n : List Integer, Integer, Integer -> List Integer
  war-skip-n (hand) (size) (n) =
    if n <= 0 then hand
    else war-skip-n (war-shift-hand hand size) (size - 1) (n - 1)

Section: Game Runner

  war-init : Integer -> WarState
  war-init (seed) =
    let r = rng-new seed
    in let deck = war-shuffle (war-build-deck 0 []) r
    in let blank = war-build-slots 52 []
    in let h1 = war-deal-half deck blank 0 0
    in let h2 = war-deal-half deck blank 26 0
    in WarState {
         p1-hand  = h1,
         p1-size  = 26,
         p2-hand  = h2,
         p2-size  = 26,
         rng      = r
       }

  war-build-slots : Integer, List Integer -> List Integer
  war-build-slots (n) (acc) =
    if n <= 0 then acc
    else war-build-slots (n - 1) (list-push acc 0)

  war-deal-half : List Integer, List Integer, Integer, Integer -> List Integer
  war-deal-half (deck) (hand) (offset) (i) =
    if i >= 26 then hand
    else let card = list-at deck (offset + i)
    in war-deal-half deck (list-set-at hand i card) offset (i + 1)

  run-war-game : Integer -> WarResult
  run-war-game (seed) =
    let s = war-init seed
    in war-loop s 0

  war-loop : WarState, Integer -> WarResult
  war-loop (s) (rounds) =
    if s.p1-size <= 0 then WarResult { winner = 2, rounds-played = rounds }
    else if s.p2-size <= 0 then WarResult { winner = 1, rounds-played = rounds }
    else if rounds >= 1000 then
      let w = if s.p1-size >= s.p2-size then 1 else 2
      in WarResult { winner = w, rounds-played = rounds }
    else war-loop (war-do-round s) (rounds + 1)

Section: Formatting

  format-war-result : WarResult -> Text
  format-war-result (r) =
    "War: Player " & show (r.winner) & " wins after " &
    show (r.rounds-played) & " rounds"

Page 1


Chapter: Games--Blackjack
  cites Games chapter Rng

 Blackjack simulation. Cards 0-51: suit = card / 13, rank = card mod 13.
 Rank values: 0-8 map to 2-10, 9=J=10, 10=Q=10, 11=K=10, 12=A=11 (or 1).
 Dealer hits on soft 17. AI player uses basic strategy: hit below hard 17.
 run-blackjack-session plays num-hands hands, tracking wins/losses/pushes.

 We say:

Section: Types

  BlackjackResult = record {
    wins   : Integer,
    losses : Integer,
    pushes : Integer
  }

  BjState = record {
    player-cards : List Integer,
    player-count : Integer,
    dealer-cards : List Integer,
    dealer-count : Integer,
    player-soft  : Boolean,
    dealer-soft  : Boolean,
    deck         : List Integer,
    deck-pos     : Integer,
    rng          : Rng
  }

Section: Card Helpers

  bj-rank : Integer -> Integer
  bj-rank (c) = rng-mod c 13

  bj-card-value : Integer -> Integer
  bj-card-value (c) =
    let r = bj-rank c
    in if r >= 9 then 10
    else r + 2

Section: Deck

  bj-build-deck : Integer, List Integer -> List Integer
  bj-build-deck (i) (acc) =
    if i >= 52 then acc
    else bj-build-deck (i + 1) (list-push acc i)

  bj-shuffle : List Integer, Rng -> List Integer
  bj-shuffle (deck) (r) = bj-fy deck 51 r

  bj-fy : List Integer, Integer, Rng -> List Integer
  bj-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in bj-fy d3 (i - 1) r2

Section: Hand Value

  bj-hand-value : List Integer, Integer -> Integer
  bj-hand-value (cards) (count) =
    bj-sum-cards cards 0 count

  bj-sum-cards : List Integer, Integer, Integer -> Integer
  bj-sum-cards (cards) (i) (n) =
    if i >= n then 0
    else bj-card-value (list-at cards i) + bj-sum-cards cards (i + 1) n

  bj-has-ace : List Integer, Integer -> Boolean
  bj-has-ace (cards) (count) =
    bj-find-ace cards 0 count

  bj-find-ace : List Integer, Integer, Integer -> Boolean
  bj-find-ace (cards) (i) (n) =
    if i >= n then False
    else if bj-rank (list-at cards i) == 12 then True
    else bj-find-ace cards (i + 1) n

  bj-best-value : List Integer, Integer -> Integer
  bj-best-value (cards) (count) =
    let total = bj-sum-cards cards 0 count
    in let soft = bj-has-ace cards count
    in if soft & total > 21 then total - 10
    else total

  bj-is-soft : List Integer, Integer -> Boolean
  bj-is-soft (cards) (count) =
    let total = bj-sum-cards cards 0 count
    in let has-ace = bj-has-ace cards count
    in has-ace & total <= 21

Section: Deal

  bj-deal-card : BjState, List Integer, Integer -> BjState
  bj-deal-card (s) (hand) (owner) =
    let card = list-at (s.deck) (s.deck-pos)
    in let new-pos = s.deck-pos + 1
    in if owner == 0 then
      let new-hand = list-push (s.player-cards) card
      in let new-count = s.player-count + 1
      in BjState {
           player-cards = new-hand,
           player-count = new-count,
           dealer-cards = s.dealer-cards,
           dealer-count = s.dealer-count,
           player-soft  = bj-is-soft new-hand new-count,
           dealer-soft  = s.dealer-soft,
           deck         = s.deck,
           deck-pos     = new-pos,
           rng          = s.rng
         }
    else
      let new-hand = list-push (s.dealer-cards) card
      in let new-count = s.dealer-count + 1
      in BjState {
           player-cards = s.player-cards,
           player-count = s.player-count,
           dealer-cards = new-hand,
           dealer-count = new-count,
           player-soft  = s.player-soft,
           dealer-soft  = bj-is-soft new-hand new-count,
           deck         = s.deck,
           deck-pos     = new-pos,
           rng          = s.rng
         }

Section: AI Logic

  bj-player-should-hit : BjState -> Boolean
  bj-player-should-hit (s) =
    let val = bj-best-value (s.player-cards) (s.player-count)
    in val < 17

  bj-dealer-should-hit : BjState -> Boolean
  bj-dealer-should-hit (s) =
    let val = bj-best-value (s.dealer-cards) (s.dealer-count)
    in if val < 17 then True
    else if val == 17 then s.dealer-soft
    else False

  bj-player-turn : BjState -> BjState
  bj-player-turn (s) =
    if bj-player-should-hit s then
      let s2 = bj-deal-card s [] 0
      in bj-player-turn s2
    else s

  bj-dealer-turn : BjState -> BjState
  bj-dealer-turn (s) =
    if bj-dealer-should-hit s then
      let s2 = bj-deal-card s [] 1
      in bj-dealer-turn s2
    else s

Section: Hand Outcome

  bj-is-blackjack : List Integer, Integer -> Boolean
  bj-is-blackjack (cards) (count) =
    count == 2 & bj-best-value cards count == 21

  bj-hand-result : BjState -> Integer
  bj-hand-result (s) =
    let pval = bj-best-value (s.player-cards) (s.player-count)
    in let dval = bj-best-value (s.dealer-cards) (s.dealer-count)
    in let pbj = bj-is-blackjack (s.player-cards) (s.player-count)
    in let dbj = bj-is-blackjack (s.dealer-cards) (s.dealer-count)
    in if pval > 21 then (-1)
    else if dbj & pbj then 0
    else if pbj then 1
    else if dbj then (-1)
    else if dval > 21 then 1
    else if pval > dval then 1
    else if pval < dval then (-1)
    else 0

Section: Game Runner

  bj-fresh-state : Rng -> BjState
  bj-fresh-state (r) =
    let r2 = rng-next r
    in let deck = bj-shuffle (bj-build-deck 0 []) r2
    in BjState {
         player-cards = [],
         player-count = 0,
         dealer-cards = [],
         dealer-count = 0,
         player-soft  = False,
         dealer-soft  = False,
         deck         = deck,
         deck-pos     = 0,
         rng          = r2
       }

  bj-play-hand : Rng -> Integer
  bj-play-hand (r) =
    let s0 = bj-fresh-state r
    in let s1 = bj-deal-card s0 [] 0
    in let s2 = bj-deal-card s1 [] 1
    in let s3 = bj-deal-card s2 [] 0
    in let s4 = bj-deal-card s3 [] 1
    in let s5 = bj-player-turn s4
    in let pval = bj-best-value (s5.player-cards) (s5.player-count)
    in if pval > 21 then (-1)
    else let s6 = bj-dealer-turn s5
    in bj-hand-result s6

  run-blackjack-session : Integer, Integer -> BlackjackResult
  run-blackjack-session (seed) (num-hands) =
    let r = rng-new seed
    in bj-session-loop r num-hands 0 0 0

  bj-session-loop : Rng, Integer, Integer, Integer, Integer -> BlackjackResult
  bj-session-loop (r) (remaining) (wins) (losses) (pushes) =
    if remaining <= 0 then BlackjackResult { wins = wins, losses = losses, pushes = pushes }
    else let r2 = rng-next r
    in let outcome = bj-play-hand r2
    in let new-wins   = if outcome == 1 then wins + 1 else wins
    in let new-losses = if outcome == (-1) then losses + 1 else losses
    in let new-pushes = if outcome == 0 then pushes + 1 else pushes
    in bj-session-loop r2 (remaining - 1) new-wins new-losses new-pushes

Section: Formatting

  format-blackjack-result : BlackjackResult -> Text
  format-blackjack-result (r) =
    let total = r.wins + r.losses + r.pushes
    in "Blackjack (" & show total & " hands): wins=" & show (r.wins) &
       " losses=" & show (r.losses) & " pushes=" & show (r.pushes)

Page 1


Chapter: Games--DotsAndBoxes
  cites Games chapter Rng

 Dots and Boxes on a 4x4 grid of dots (giving a 3x3 grid of boxes).
 Edges connect adjacent dots horizontally and vertically.
 Horizontal edges: 4 cols x 3 rows = 12 edges (indices 0..11).
 Vertical edges: 3 cols x 4 rows = 12 edges (indices 12..23).
 Total: 24 edges. Boxes: 3x3 = 9 boxes.
 Completing a box (4 edges) scores a point and earns an extra turn.
 AI: complete any box it can, else pick a random unplaced edge.

 We say:

Section: Types

  DotsBoard = record {
    edges          : List Integer,
    boxes          : List Integer,
    current-player : Integer,
    p1-score       : Integer,
    p2-score       : Integer,
    moves-made     : Integer,
    rng            : Rng
  }

  DotsResult = record {
    winner     : Integer,
    p1-score   : Integer,
    p2-score   : Integer,
    moves-made : Integer
  }

Section: Construction

  dots-new : Rng -> DotsBoard
  dots-new (rng) =
    let edges = dots-fill 0 []
    in let boxes = dots-fill-nine 0 []
    in DotsBoard { edges = edges, boxes = boxes, current-player = 1, p1-score = 0, p2-score = 0, moves-made = 0, rng = rng }

  dots-fill : Integer, List Integer -> List Integer
  dots-fill (i) (acc) =
    if i >= 24 then acc
    else dots-fill (i + 1) (list-push acc 0)

  dots-fill-nine : Integer, List Integer -> List Integer
  dots-fill-nine (i) (acc) =
    if i >= 9 then acc
    else dots-fill-nine (i + 1) (list-push acc 0)

Section: Edge Layout

 Horizontal edges: edge index = row * 4 + col (row 0..2, col 0..3) -> indices 0..11
 Vertical edges: edge index = 12 + col * 4 + row (col 0..2, row 0..3) -> indices 12..23
 Box (row, col) is bounded by:
   top horiz: row * 4 + col (index)
   bottom horiz: (row+1) * 4 + col
   left vert: 12 + col * 4 + row
   right vert: 12 + (col+1) * 4 + row

  dots-box-top : Integer, Integer -> Integer
  dots-box-top (row) (col) = row * 4 + col

  dots-box-bottom : Integer, Integer -> Integer
  dots-box-bottom (row) (col) = (row + 1) * 4 + col

  dots-box-left : Integer, Integer -> Integer
  dots-box-left (row) (col) = 12 + col * 4 + row

  dots-box-right : Integer, Integer -> Integer
  dots-box-right (row) (col) = 12 + (col + 1) * 4 + row

  dots-box-complete : List Integer, Integer, Integer -> Boolean
  dots-box-complete (edges) (row) (col) =
    let t = list-at edges (dots-box-top row col)
    in let b = list-at edges (dots-box-bottom row col)
    in let l = list-at edges (dots-box-left row col)
    in let r = list-at edges (dots-box-right row col)
    in t == 1 & b == 1 & l == 1 & r == 1

Section: Scoring

  dots-check-boxes : List Integer, List Integer, Integer, Integer, Integer -> Integer
  dots-check-boxes (edges) (boxes) (player) (i) (scored) =
    if i >= 9 then scored
    else let row = i / 3
    in let col = i - row * 3
    in if list-at boxes i /= 0 then dots-check-boxes edges boxes player (i + 1) scored
    else if dots-box-complete edges row col then dots-check-boxes edges boxes player (i + 1) (scored + 1)
    else dots-check-boxes edges boxes player (i + 1) scored

  dots-mark-boxes : List Integer, List Integer, Integer, Integer -> List Integer
  dots-mark-boxes (edges) (boxes) (player) (i) =
    if i >= 9 then boxes
    else let row = i / 3
    in let col = i - row * 3
    in if list-at boxes i /= 0 then dots-mark-boxes edges boxes player (i + 1)
    else if dots-box-complete edges row col then
      let new-boxes = list-set-at boxes i player
      in dots-mark-boxes edges new-boxes player (i + 1)
    else dots-mark-boxes edges boxes player (i + 1)

Section: Place Edge

  dots-place : DotsBoard, Integer -> DotsBoard
  dots-place (b) (edge-idx) =
    if edge-idx < 0 then b
    else if edge-idx >= 24 then b
    else if list-at (b.edges) edge-idx /= 0 then b
    else let new-edges = list-set-at (b.edges) edge-idx 1
    in let scored = dots-check-boxes new-edges (b.boxes) (b.current-player) 0 0
    in let new-boxes = dots-mark-boxes new-edges (b.boxes) (b.current-player) 0
    in let p1 = if b.current-player == 1 then b.p1-score + scored else b.p1-score
    in let p2 = if b.current-player == 2 then b.p2-score + scored else b.p2-score
    in let next = if scored > 0 then b.current-player else if b.current-player == 1 then 2 else 1
    in DotsBoard { edges = new-edges, boxes = new-boxes, current-player = next, p1-score = p1, p2-score = p2, moves-made = b.moves-made + 1, rng = b.rng }

Section: AI

  dots-ai-move : DotsBoard -> Integer
  dots-ai-move (b) =
    let box-move = dots-find-completing-move (b.edges) 0
    in if box-move >= 0 then box-move
    else dots-random-edge (b.edges) (b.rng)

  dots-find-completing-move : List Integer, Integer -> Integer
  dots-find-completing-move (edges) (edge-idx) =
    if edge-idx >= 24 then -1
    else if list-at edges edge-idx /= 0 then dots-find-completing-move edges (edge-idx + 1)
    else let trial = list-set-at edges edge-idx 1
    in if dots-completes-any trial 0 then edge-idx
    else dots-find-completing-move edges (edge-idx + 1)

  dots-completes-any : List Integer, Integer -> Boolean
  dots-completes-any (edges) (i) =
    if i >= 9 then False
    else let row = i / 3
    in let col = i - row * 3
    in if dots-box-complete edges row col then True
    else dots-completes-any edges (i + 1)

  dots-random-edge : List Integer, Rng -> Integer
  dots-random-edge (edges) (rng) =
    dots-random-loop edges rng 0

  dots-random-loop : List Integer, Rng, Integer -> Integer
  dots-random-loop (edges) (rng) (attempts) =
    if attempts >= 200 then dots-first-free edges 0
    else let r = rng-next rng
    in let idx = rng-range r 0 23
    in if list-at edges idx == 0 then idx
    else dots-random-loop edges r (attempts + 1)

  dots-first-free : List Integer, Integer -> Integer
  dots-first-free (edges) (i) =
    if i >= 24 then -1
    else if list-at edges i == 0 then i
    else dots-first-free edges (i + 1)

  dots-all-placed : List Integer -> Boolean
  dots-all-placed (edges) = dots-check-all edges 0

  dots-check-all : List Integer, Integer -> Boolean
  dots-check-all (edges) (i) =
    if i >= 24 then True
    else if list-at edges i == 0 then False
    else dots-check-all edges (i + 1)

Section: Game Runner

  run-dots-game : DotsResult
  run-dots-game =
    let rng = rng-new 77
    in let b = dots-new rng
    in dots-loop b

  dots-loop : DotsBoard -> DotsResult
  dots-loop (b) =
    if dots-all-placed (b.edges) then
      let w = if b.p1-score > b.p2-score then 1 else if b.p2-score > b.p1-score then 2 else 0
      in DotsResult { winner = w, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else if b.moves-made > 30 then DotsResult { winner = 0, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else let edge = dots-ai-move b
    in if edge < 0 then DotsResult { winner = 0, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else let next = dots-place b edge
    in dots-loop next

Section: Formatting

  format-dots-result : DotsResult -> Text
  format-dots-result (r) =
    let w = if r.winner == 1 then "Player 1 wins"
            else if r.winner == 2 then "Player 2 wins"
            else "Draw"
    in "DotsAndBoxes: " & w & " P1=" & show (r.p1-score) & " P2=" & show (r.p2-score) & " in " & show (r.moves-made) & " moves"

Page 1


Chapter: Games--Life
  cites Games chapter Rng

 Conway's Game of Life on a 20x20 toroidal grid.
 LifeState holds 400 cells as a flat List Integer (row*20+col), 0=dead 1=alive.
 Rules: B3 (born with exactly 3 neighbors), S23 (survive with 2 or 3 neighbors).
 Seeded patterns: glider at (1,1), blinker at (10,10), block at (15,15).
 run-life-sim runs for the given number of generations.
 Stable detection: if alive count unchanged for 5 consecutive steps, halt early.

 We say:

Section: Types

  LifeState = record {
    cells : List Integer,
    alive-count : Integer
  }

  LifeResult = record {
    final-alive  : Integer,
    generations  : Integer,
    stable       : Boolean
  }

Section: Grid Helpers

  life-idx : Integer, Integer -> Integer
  life-idx (row) (col) = row * 20 + col

  life-wrap : Integer -> Integer
  life-wrap (n) =
    if n < 0 then n + 20
    else if n >= 20 then n - 20
    else n

  life-get : LifeState, Integer, Integer -> Integer
  life-get (s) (row) (col) =
    list-at (s.cells) (life-idx (life-wrap row) (life-wrap col))

  life-count-neighbors : LifeState, Integer, Integer -> Integer
  life-count-neighbors (s) (row) (col) =
    let n0 = life-get s (row - 1) (col - 1)
    in let n1 = life-get s (row - 1) col
    in let n2 = life-get s (row - 1) (col + 1)
    in let n3 = life-get s row (col - 1)
    in let n4 = life-get s row (col + 1)
    in let n5 = life-get s (row + 1) (col - 1)
    in let n6 = life-get s (row + 1) col
    in let n7 = life-get s (row + 1) (col + 1)
    in n0 + n1 + n2 + n3 + n4 + n5 + n6 + n7

  life-next-cell : LifeState, Integer, Integer -> Integer
  life-next-cell (s) (row) (col) =
    let alive = life-get s row col
    in let nbrs = life-count-neighbors s row col
    in if alive == 1 then
      if nbrs == 2 then 1
      else if nbrs == 3 then 1
      else 0
    else
      if nbrs == 3 then 1
      else 0

Section: Step

  step-life : LifeState -> LifeState
  step-life (s) =
    let new-cells = life-step-all s 0 0 []
    in let cnt = life-count-alive new-cells 0 0
    in LifeState { cells = new-cells, alive-count = cnt }

  life-step-all : LifeState, Integer, Integer, List Integer -> List Integer
  life-step-all (s) (row) (col) (acc) =
    if row >= 20 then acc
    else if col >= 20 then life-step-all s (row + 1) 0 acc
    else let next = life-next-cell s row col
    in life-step-all s row (col + 1) (list-push acc next)

  life-count-alive : List Integer, Integer, Integer -> Integer
  life-count-alive (cells) (i) (acc) =
    if i >= 400 then acc
    else life-count-alive cells (i + 1) (acc + list-at cells i)

Section: Initial Patterns

  life-empty-grid : List Integer
  life-empty-grid = life-build-grid 400 []

  life-build-grid : Integer, List Integer -> List Integer
  life-build-grid (n) (acc) =
    if n <= 0 then acc
    else life-build-grid (n - 1) (list-push acc 0)

  life-set-cell : List Integer, Integer, Integer -> List Integer
  life-set-cell (cells) (row) (col) =
    list-set-at cells (life-idx (life-wrap row) (life-wrap col)) 1

  life-place-glider : List Integer, Integer, Integer -> List Integer
  life-place-glider (cells) (r) (c) =
    let c1 = life-set-cell cells r (c + 1)
    in let c2 = life-set-cell c1 (r + 1) (c + 2)
    in let c3 = life-set-cell c2 (r + 2) c
    in let c4 = life-set-cell c3 (r + 2) (c + 1)
    in life-set-cell c4 (r + 2) (c + 2)

  life-place-blinker : List Integer, Integer, Integer -> List Integer
  life-place-blinker (cells) (r) (c) =
    let c1 = life-set-cell cells r c
    in let c2 = life-set-cell c1 r (c + 1)
    in life-set-cell c2 r (c + 2)

  life-place-block : List Integer, Integer, Integer -> List Integer
  life-place-block (cells) (r) (c) =
    let c1 = life-set-cell cells r c
    in let c2 = life-set-cell c1 r (c + 1)
    in let c3 = life-set-cell c2 (r + 1) c
    in life-set-cell c3 (r + 1) (c + 1)

  life-seed-grid : Integer -> LifeState
  life-seed-grid (seed) =
    let base = life-empty-grid
    in let g1 = life-place-glider base 1 1
    in let g2 = life-place-blinker g1 10 10
    in let g3 = life-place-block g2 15 15
    in let r = rng-new seed
    in let g4 = life-scatter g3 r 0 5
    in let cnt = life-count-alive g4 0 0
    in LifeState { cells = g4, alive-count = cnt }

  life-scatter : List Integer, Rng, Integer, Integer -> List Integer
  life-scatter (cells) (r) (i) (n) =
    if i >= n then cells
    else let r2 = rng-next r
    in let row = rng-mod (rng-value r2) 20
    in let r3 = rng-next r2
    in let col = rng-mod (rng-value r3) 20
    in let c2 = life-set-cell cells row col
    in life-scatter c2 r3 (i + 1) n

Section: Game Runner

  run-life-sim : Integer, Integer -> LifeResult
  run-life-sim (seed) (generations) =
    let s = life-seed-grid seed
    in life-loop s generations 0 (-1) 0

  life-loop : LifeState, Integer, Integer, Integer, Integer -> LifeResult
  life-loop (s) (max-gen) (gen) (prev-count) (stable-streak) =
    if gen >= max-gen then
      LifeResult { final-alive = s.alive-count, generations = gen, stable = False }
    else if stable-streak >= 5 then
      LifeResult { final-alive = s.alive-count, generations = gen, stable = True }
    else let next = step-life s
    in let new-streak = if next.alive-count == s.alive-count then stable-streak + 1 else 0
    in life-loop next max-gen (gen + 1) (s.alive-count) new-streak

Section: Formatting

  format-life-result : LifeResult -> Text
  format-life-result (r) =
    let status = if r.stable then "stable" else "running"
    in "Life (20x20): " & show (r.final-alive) & " alive after " &
       show (r.generations) & " generations (" & status & ")"

Page 1


Chapter: Games--Game2048
  cites Games chapter Rng

 2048 on a 4x4 grid. Tiles slide in 4 directions; equal adjacent tiles merge.
 After each move a new tile (value 2 or 4) is placed in a random empty cell.
 Grid is a List Integer of 16 cells (row-major), 0=empty.
 AI: try all 4 directions, pick the one that maximizes empty cells plus
 a bonus for the highest tile value. Directions: 0=left,1=right,2=up,3=down.

 We say:

Section: Types

  G2048State = record {
    grid      : List Integer,
    score     : Integer,
    moves     : Integer,
    game-over : Boolean,
    rng       : Rng
  }

  G2048Result = record {
    max-tile  : Integer,
    score     : Integer,
    moves     : Integer
  }

Section: Construction

  g2048-new : Rng -> G2048State
  g2048-new (rng) =
    let grid = g2048-fill 0 []
    in let r1 = rng-next rng
    in let g1 = g2048-add-tile grid r1
    in let r2 = rng-next r1
    in let g2 = g2048-add-tile g1 r2
    in G2048State { grid = g2, score = 0, moves = 0, game-over = False, rng = r2 }

  g2048-fill : Integer, List Integer -> List Integer
  g2048-fill (i) (acc) =
    if i >= 16 then acc
    else g2048-fill (i + 1) (list-push acc 0)

  g2048-add-tile : List Integer, Rng -> List Integer
  g2048-add-tile (grid) (rng) =
    let idx = g2048-random-empty grid rng
    in if idx < 0 then grid
    else let r2 = rng-next rng
    in let val = if rng-mod (rng-value r2) 4 == 0 then 4 else 2
    in list-set-at grid idx val

  g2048-random-empty : List Integer, Rng -> Integer
  g2048-random-empty (grid) (rng) =
    let count = g2048-count-empty grid 0 0
    in if count == 0 then -1
    else let r = rng-next rng
    in let pick = rng-range r 0 (count - 1)
    in g2048-nth-empty grid 0 pick 0

  g2048-count-empty : List Integer, Integer, Integer -> Integer
  g2048-count-empty (grid) (i) (acc) =
    if i >= 16 then acc
    else if list-at grid i == 0 then g2048-count-empty grid (i + 1) (acc + 1)
    else g2048-count-empty grid (i + 1) acc

  g2048-nth-empty : List Integer, Integer, Integer, Integer -> Integer
  g2048-nth-empty (grid) (i) (target) (seen) =
    if i >= 16 then -1
    else if list-at grid i /= 0 then g2048-nth-empty grid (i + 1) target seen
    else if seen == target then i
    else g2048-nth-empty grid (i + 1) target (seen + 1)

Section: Row Operations

 A row is 4 consecutive cells. Slide left: compact non-zero left, merge equals.

  g2048-slide-row-left : List Integer -> List Integer
  g2048-slide-row-left (row) =
    let compacted = g2048-compact row 0 []
    in let merged = g2048-merge compacted
    in g2048-pad merged

  g2048-compact : List Integer, Integer, List Integer -> List Integer
  g2048-compact (row) (i) (acc) =
    if i >= 4 then acc
    else if list-at row i /= 0 then g2048-compact row (i + 1) (list-push acc (list-at row i))
    else g2048-compact row (i + 1) acc

  g2048-merge : List Integer -> List Integer
  g2048-merge (row) =
    g2048-merge-loop row 0 []

  g2048-merge-loop : List Integer, Integer, List Integer -> List Integer
  g2048-merge-loop (row) (i) (acc) =
    if i >= list-length row then acc
    else if i + 1 < list-length row then
      if list-at row i == list-at row (i + 1) then
        g2048-merge-loop row (i + 2) (list-push acc (list-at row i * 2))
      else g2048-merge-loop row (i + 1) (list-push acc (list-at row i))
    else g2048-merge-loop row (i + 1) (list-push acc (list-at row i))

  g2048-pad : List Integer -> List Integer
  g2048-pad (row) =
    g2048-pad-loop row

  g2048-pad-loop : List Integer -> List Integer
  g2048-pad-loop (row) =
    if list-length row >= 4 then row
    else g2048-pad-loop (list-push row 0)

  g2048-reverse-row : List Integer -> List Integer
  g2048-reverse-row (row) =
    [list-at row 3, list-at row 2, list-at row 1, list-at row 0]

  g2048-slide-row-right : List Integer -> List Integer
  g2048-slide-row-right (row) =
    g2048-reverse-row (g2048-slide-row-left (g2048-reverse-row row))

Section: Extract and Rebuild Grid Rows/Cols

  g2048-get-row : List Integer, Integer -> List Integer
  g2048-get-row (grid) (row) =
    [list-at grid (row * 4), list-at grid (row * 4 + 1), list-at grid (row * 4 + 2), list-at grid (row * 4 + 3)]

  g2048-set-row : List Integer, Integer, List Integer -> List Integer
  g2048-set-row (grid) (row) (r) =
    let g1 = list-set-at grid (row * 4) (list-at r 0)
    in let g2 = list-set-at g1 (row * 4 + 1) (list-at r 1)
    in let g3 = list-set-at g2 (row * 4 + 2) (list-at r 2)
    in list-set-at g3 (row * 4 + 3) (list-at r 3)

  g2048-get-col : List Integer, Integer -> List Integer
  g2048-get-col (grid) (col) =
    [list-at grid col, list-at grid (4 + col), list-at grid (8 + col), list-at grid (12 + col)]

  g2048-set-col : List Integer, Integer, List Integer -> List Integer
  g2048-set-col (grid) (col) (c) =
    let g1 = list-set-at grid col (list-at c 0)
    in let g2 = list-set-at g1 (4 + col) (list-at c 1)
    in let g3 = list-set-at g2 (8 + col) (list-at c 2)
    in list-set-at g3 (12 + col) (list-at c 3)

Section: Slide Grid

  g2048-slide-left : List Integer -> List Integer
  g2048-slide-left (grid) =
    let g1 = g2048-set-row grid 0 (g2048-slide-row-left (g2048-get-row grid 0))
    in let g2 = g2048-set-row g1 1 (g2048-slide-row-left (g2048-get-row g1 1))
    in let g3 = g2048-set-row g2 2 (g2048-slide-row-left (g2048-get-row g2 2))
    in g2048-set-row g3 3 (g2048-slide-row-left (g2048-get-row g3 3))

  g2048-slide-right : List Integer -> List Integer
  g2048-slide-right (grid) =
    let g1 = g2048-set-row grid 0 (g2048-slide-row-right (g2048-get-row grid 0))
    in let g2 = g2048-set-row g1 1 (g2048-slide-row-right (g2048-get-row g1 1))
    in let g3 = g2048-set-row g2 2 (g2048-slide-row-right (g2048-get-row g2 2))
    in g2048-set-row g3 3 (g2048-slide-row-right (g2048-get-row g3 3))

  g2048-slide-up : List Integer -> List Integer
  g2048-slide-up (grid) =
    let g1 = g2048-set-col grid 0 (g2048-slide-row-left (g2048-get-col grid 0))
    in let g2 = g2048-set-col g1 1 (g2048-slide-row-left (g2048-get-col g1 1))
    in let g3 = g2048-set-col g2 2 (g2048-slide-row-left (g2048-get-col g2 2))
    in g2048-set-col g3 3 (g2048-slide-row-left (g2048-get-col g3 3))

  g2048-slide-down : List Integer -> List Integer
  g2048-slide-down (grid) =
    let g1 = g2048-set-col grid 0 (g2048-slide-row-right (g2048-get-col grid 0))
    in let g2 = g2048-set-col g1 1 (g2048-slide-row-right (g2048-get-col g1 1))
    in let g3 = g2048-set-col g2 2 (g2048-slide-row-right (g2048-get-col g2 2))
    in g2048-set-col g3 3 (g2048-slide-row-right (g2048-get-col g3 3))

  g2048-apply-dir : List Integer, Integer -> List Integer
  g2048-apply-dir (grid) (dir) =
    if dir == 0 then g2048-slide-left grid
    else if dir == 1 then g2048-slide-right grid
    else if dir == 2 then g2048-slide-up grid
    else g2048-slide-down grid

  g2048-grids-equal : List Integer, List Integer -> Boolean
  g2048-grids-equal (a) (b) =
    g2048-eq-loop a b 0

  g2048-eq-loop : List Integer, List Integer, Integer -> Boolean
  g2048-eq-loop (a) (b) (i) =
    if i >= 16 then True
    else if list-at a i /= list-at b i then False
    else g2048-eq-loop a b (i + 1)

Section: Score and Stats

  g2048-max-tile : List Integer -> Integer
  g2048-max-tile (grid) =
    g2048-max-loop grid 0 0

  g2048-max-loop : List Integer, Integer, Integer -> Integer
  g2048-max-loop (grid) (i) (best) =
    if i >= 16 then best
    else let v = list-at grid i
    in if v > best then g2048-max-loop grid (i + 1) v
    else g2048-max-loop grid (i + 1) best

  g2048-empty-count : List Integer -> Integer
  g2048-empty-count (grid) =
    g2048-count-empty grid 0 0

  g2048-sum-grid : List Integer -> Integer
  g2048-sum-grid (grid) =
    g2048-sum-loop grid 0 0

  g2048-sum-loop : List Integer, Integer, Integer -> Integer
  g2048-sum-loop (grid) (i) (acc) =
    if i >= 16 then acc
    else g2048-sum-loop grid (i + 1) (acc + list-at grid i)

Section: AI

  g2048-ai-dir : G2048State -> Integer
  g2048-ai-dir (st) =
    let s0 = g2048-eval-dir (st.grid) 0
    in let s1 = g2048-eval-dir (st.grid) 1
    in let s2 = g2048-eval-dir (st.grid) 2
    in let s3 = g2048-eval-dir (st.grid) 3
    in g2048-best-dir s0 s1 s2 s3

  g2048-eval-dir : List Integer, Integer -> Integer
  g2048-eval-dir (grid) (dir) =
    let after = g2048-apply-dir grid dir
    in if g2048-grids-equal grid after then -1
    else g2048-empty-count after * 16 + g2048-max-tile after

  g2048-best-dir : Integer, Integer, Integer, Integer -> Integer
  g2048-best-dir (s0) (s1) (s2) (s3) =
    let best01 = if s0 >= s1 then 0 else 1
    in let best23 = if s2 >= s3 then 2 else 3
    in let v01 = if best01 == 0 then s0 else s1
    in let v23 = if best23 == 2 then s2 else s3
    in if v01 >= v23 then best01 else best23

  g2048-can-move : List Integer -> Boolean
  g2048-can-move (grid) =
    let after-l = g2048-slide-left grid
    in if g2048-grids-equal grid after-l == False then True
    else let after-r = g2048-slide-right grid
    in if g2048-grids-equal grid after-r == False then True
    else let after-u = g2048-slide-up grid
    in if g2048-grids-equal grid after-u == False then True
    else let after-d = g2048-slide-down grid
    in g2048-grids-equal grid after-d == False

Section: Apply Move

  g2048-move : G2048State, Integer -> G2048State
  g2048-move (st) (dir) =
    if dir < 0 then G2048State { grid = st.grid, score = st.score, moves = st.moves, game-over = True, rng = st.rng }
    else let after = g2048-apply-dir (st.grid) dir
    in if g2048-grids-equal (st.grid) after then st
    else let r = rng-next (st.rng)
    in let new-grid = g2048-add-tile after r
    in let new-score = g2048-sum-grid new-grid
    in let can = g2048-can-move new-grid
    in G2048State { grid = new-grid, score = new-score, moves = st.moves + 1, game-over = can == False, rng = r }

Section: Game Runner

  run-2048-game : G2048Result
  run-2048-game =
    let rng = rng-new 11
    in let st = g2048-new rng
    in g2048-loop st

  g2048-loop : G2048State -> G2048Result
  g2048-loop (st) =
    if st.game-over then G2048Result { max-tile = g2048-max-tile (st.grid), score = st.score, moves = st.moves }
    else if st.moves > 2000 then G2048Result { max-tile = g2048-max-tile (st.grid), score = st.score, moves = st.moves }
    else let dir = g2048-ai-dir st
    in let next = g2048-move st dir
    in g2048-loop next

Section: Formatting

  format-2048-result : G2048Result -> Text
  format-2048-result (r) =
    "2048: max-tile=" & show (r.max-tile) & " score=" & show (r.score) & " moves=" & show (r.moves)

Page 1


Chapter: Games--HexGame
  cites Games chapter Rng

 Hex on an 11x11 board. Player 1 (value 1) connects top to bottom.
 Player 2 (value 2) connects left to right. No draws possible.
 Win detection uses BFS flood-fill from the player's starting edge.
 AI: prefer center cells and cells adjacent to own pieces; block opponent.

 Board is a List Integer of 121 cells (11x11, row-major).
 0 = empty, 1 = player 1, 2 = player 2.

 We say:

Section: Types

  HexBoard = record {
    cells          : List Integer,
    current-player : Integer,
    game-over      : Boolean,
    winner         : Integer,
    moves-made     : Integer
  }

  HexResult = record {
    winner     : Integer,
    moves-made : Integer
  }

Section: Construction

  hex-new : HexBoard
  hex-new =
    let cells = hex-fill 0 []
    in HexBoard { cells = cells, current-player = 1, game-over = False, winner = 0, moves-made = 0 }

  hex-fill : Integer, List Integer -> List Integer
  hex-fill (i) (acc) =
    if i >= 121 then acc
    else hex-fill (i + 1) (list-push acc 0)

Section: Board Queries

  hex-cell : List Integer, Integer, Integer -> Integer
  hex-cell (cells) (row) (col) =
    if row < 0 then -1
    else if row >= 11 then -1
    else if col < 0 then -1
    else if col >= 11 then -1
    else list-at cells (row * 11 + col)

Section: Place

  hex-place : HexBoard, Integer, Integer -> HexBoard
  hex-place (b) (row) (col) =
    if b.game-over then b
    else if hex-cell (b.cells) row col /= 0 then b
    else let new-cells = list-set-at (b.cells) (row * 11 + col) (b.current-player)
    in let won = hex-check-win new-cells (b.current-player)
    in let next = if won then b.current-player else if b.current-player == 1 then 2 else 1
    in HexBoard { cells = new-cells, current-player = next, game-over = won, winner = if won then b.current-player else 0, moves-made = b.moves-made + 1 }

Section: Win Detection (BFS flood-fill)

 For player 1: start from all cells in row 0 owned by player 1,
 flood fill via hex neighbors, win if we reach row 10.
 For player 2: start from all cells in col 0 owned by player 2,
 flood fill, win if we reach col 10.
 We simulate BFS with a visited list and a queue encoded as a list.

  hex-check-win : List Integer, Integer -> Boolean
  hex-check-win (cells) (player) =
    let visited = hex-fill 0 []
    in let queue = hex-start-queue cells player 0 []
    in hex-bfs cells player queue visited

  hex-start-queue : List Integer, Integer, Integer, List Integer -> List Integer
  hex-start-queue (cells) (player) (i) (acc) =
    if i >= 11 then acc
    else let idx = if player == 1 then i else i * 11
    in if list-at cells idx == player then hex-start-queue cells player (i + 1) (list-push acc idx)
    else hex-start-queue cells player (i + 1) acc

  hex-bfs : List Integer, Integer, List Integer, List Integer -> Boolean
  hex-bfs (cells) (player) (queue) (visited) =
    if list-length queue == 0 then False
    else let idx = list-at queue 0
    in let rest = hex-list-tail queue
    in if list-at visited idx /= 0 then hex-bfs cells player rest visited
    else let row = idx / 11
    in let col = idx - row * 11
    in if hex-is-goal player row col then True
    else let new-visited = list-set-at visited idx 1
    in let neighbors = hex-neighbors cells player row col
    in let new-queue = hex-append rest neighbors
    in hex-bfs cells player new-queue new-visited

  hex-is-goal : Integer, Integer, Integer -> Boolean
  hex-is-goal (player) (row) (col) =
    if player == 1 then row == 10
    else col == 10

  hex-neighbors : List Integer, Integer, Integer, Integer -> List Integer
  hex-neighbors (cells) (player) (row) (col) =
    let n0 = hex-check-neighbor cells player row col (row + 1) (col - 1) []
    in let n1 = hex-check-neighbor cells player row col (row - 1) (col + 1) n0
    in let n2 = hex-check-neighbor cells player row col row (col + 1) n1
    in let n3 = hex-check-neighbor cells player row col row (col - 1) n2
    in let n4 = hex-check-neighbor cells player row col (row + 1) col n3
    in hex-check-neighbor cells player row col (row - 1) col n4

  hex-check-neighbor : List Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  hex-check-neighbor (cells) (player) (row) (col) (nr) (nc) (acc) =
    let v = hex-cell cells nr nc
    in if v == player then list-push acc (nr * 11 + nc)
    else acc

  hex-append : List Integer, List Integer -> List Integer
  hex-append (a) (b) =
    hex-append-loop a b 0

  hex-append-loop : List Integer, List Integer, Integer -> List Integer
  hex-append-loop (a) (b) (i) =
    if i >= list-length b then a
    else hex-append-loop (list-push a (list-at b i)) b (i + 1)

  hex-list-tail : List Integer -> List Integer
  hex-list-tail (xs) = hex-tail-loop xs 1 []

  hex-tail-loop : List Integer, Integer, List Integer -> List Integer
  hex-tail-loop (xs) (i) (acc) =
    if i >= list-length xs then acc
    else hex-tail-loop xs (i + 1) (list-push acc (list-at xs i))

Section: AI

  hex-ai-move : HexBoard -> Integer
  hex-ai-move (b) =
    let opp = if b.current-player == 1 then 2 else 1
    in let block = hex-find-winning-move (b.cells) opp
    in if block >= 0 then block
    else let win = hex-find-winning-move (b.cells) (b.current-player)
    in if win >= 0 then win
    else hex-best-empty (b.cells) (b.current-player) 0 (-1) (-1)

  hex-find-winning-move : List Integer, Integer -> Integer
  hex-find-winning-move (cells) (player) =
    hex-scan-winning cells player 0

  hex-scan-winning : List Integer, Integer, Integer -> Integer
  hex-scan-winning (cells) (player) (i) =
    if i >= 121 then -1
    else if list-at cells i /= 0 then hex-scan-winning cells player (i + 1)
    else let trial = list-set-at cells i player
    in if hex-check-win trial player then i
    else hex-scan-winning cells player (i + 1)

  hex-best-empty : List Integer, Integer, Integer, Integer, Integer -> Integer
  hex-best-empty (cells) (player) (i) (best-idx) (best-score) =
    if i >= 121 then best-idx
    else if list-at cells i /= 0 then hex-best-empty cells player (i + 1) best-idx best-score
    else let row = i / 11
    in let col = i - row * 11
    in let score = hex-score-cell player row col
    in if score > best-score then hex-best-empty cells player (i + 1) i score
    else hex-best-empty cells player (i + 1) best-idx best-score

  hex-score-cell : Integer, Integer, Integer -> Integer
  hex-score-cell (player) (row) (col) =
    let dr = if row > 5 then 10 - row else row
    in let dc = if col > 5 then 10 - col else col
    in let center = dr + dc
    in if player == 1 then 20 - dr * 2 + center
    else 20 - dc * 2 + center

  hex-has-empty : List Integer -> Boolean
  hex-has-empty (cells) = hex-any-empty cells 0

  hex-any-empty : List Integer, Integer -> Boolean
  hex-any-empty (cells) (i) =
    if i >= 121 then False
    else if list-at cells i == 0 then True
    else hex-any-empty cells (i + 1)

Section: Game Runner

  run-hex-game : HexResult
  run-hex-game =
    let b = hex-new
    in hex-loop b

  hex-loop : HexBoard -> HexResult
  hex-loop (b) =
    if b.game-over then HexResult { winner = b.winner, moves-made = b.moves-made }
    else if b.moves-made > 121 then HexResult { winner = 0, moves-made = b.moves-made }
    else if hex-has-empty (b.cells) == False then HexResult { winner = 0, moves-made = b.moves-made }
    else let idx = hex-ai-move b
    in if idx < 0 then HexResult { winner = 0, moves-made = b.moves-made }
    else let row = idx / 11
    in let col = idx - row * 11
    in let next = hex-place b row col
    in hex-loop next

Section: Formatting

  format-hex-result : HexResult -> Text
  format-hex-result (r) =
    let w = if r.winner == 1 then "Player 1 wins (top-bottom)"
            else if r.winner == 2 then "Player 2 wins (left-right)"
            else "No winner"
    in "HexGame: " & w & " in " & show (r.moves-made) & " moves"

Page 1


Chapter: Games--Mancala
  cites Games chapter Rng

 Kalah mancala: 6 pits per side, 4 seeds per pit at start. Players
 alternate sowing seeds counter-clockwise, capturing opposite pit's
 seeds when the last seed lands in an empty pit on their side, and
 earning an extra turn when the last seed lands in their own store.
 Minimax AI searches to a configurable depth.

 Board layout: indices 0-5 are south pits, index 6 is south store,
 indices 7-12 are north pits, index 13 is north store.

 We say:

Section: Types

  MancalaBoard = record {
    pits    : List Integer,
    turn    : Integer,
    over    : Boolean
  }

  MancalaResult = record {
    south-score : Integer,
    north-score  : Integer,
    winner       : Integer
  }

Section: Construction

  mancala-new : Integer -> MancalaBoard
  mancala-new (seed) =
    let pits = mancala-build-pits 0 []
    in MancalaBoard { pits = pits, turn = 0, over = False }

  mancala-build-pits : Integer, List Integer -> List Integer
  mancala-build-pits (i) (acc) =
    if i >= 14 then acc
    else let v = if i == 6 then 0 else if i == 13 then 0 else 4
    in mancala-build-pits (i + 1) (list-push acc v)

Section: Pit Queries

  pit-of : MancalaBoard, Integer -> Integer
  pit-of (b) (i) = list-at (b.pits) i

  south-store : MancalaBoard -> Integer
  south-store (b) = list-at (b.pits) 6

  north-store : MancalaBoard -> Integer
  north-store (b) = list-at (b.pits) 13

  is-south-pit : Integer -> Boolean
  is-south-pit (i) = i >= 0 & i <= 5

  is-north-pit : Integer -> Boolean
  is-north-pit (i) = i >= 7 & i <= 12

  opposite-pit : Integer -> Integer
  opposite-pit (i) = 12 - i

Section: Move Legality

  mancala-legal : MancalaBoard, Integer -> Boolean
  mancala-legal (b) (pit) =
    if b.over then False
    else if b.turn == 0 then is-south-pit pit & pit-of b pit > 0
    else is-north-pit pit & pit-of b pit > 0

Section: Sowing

  mancala-move : MancalaBoard, Integer -> MancalaBoard
  mancala-move (b) (pit) =
    if mancala-legal b pit == False then b
    else let seeds = pit-of b pit
    in let cleared = list-set-at (b.pits) pit 0
    in let after-sow = sow-seeds cleared pit seeds b.turn
    in let last-idx = sow-last-index pit seeds b.turn
    in let after-cap = check-capture after-sow last-idx b.turn
    in let after-end = check-game-end after-cap
    in let extra = if b.turn == 0 then last-idx == 6 else last-idx == 13
    in let next-turn = if after-end.over then b.turn else if extra then b.turn else 1 - b.turn
    in MancalaBoard { pits = after-end.pits, turn = next-turn, over = after-end.over }

  sow-seeds : List Integer, Integer, Integer, Integer -> List Integer
  sow-seeds (pits) (start) (seeds) (player) =
    sow-loop pits start seeds player 0

  sow-loop : List Integer, Integer, Integer, Integer, Integer -> List Integer
  sow-loop (pits) (start) (seeds) (player) (placed) =
    if placed >= seeds then pits
    else let raw = start + placed + 1
    in let idx = sow-next-index raw player
    in let adjusted = if idx < 0 then 0 else idx
    in sow-loop (list-set-at pits adjusted (list-at pits adjusted + 1)) start seeds player (placed + 1)

  sow-next-index : Integer, Integer -> Integer
  sow-next-index (raw) (player) =
    let wrapped = rng-mod raw 14
    in if player == 0 then
      if wrapped == 13 then sow-next-index (raw + 1) player
      else wrapped
    else
      if wrapped == 6 then sow-next-index (raw + 1) player
      else wrapped

  sow-last-index : Integer, Integer, Integer -> Integer
  sow-last-index (start) (seeds) (player) =
    sow-last-loop start seeds player 0 start

  sow-last-loop : Integer, Integer, Integer, Integer, Integer -> Integer
  sow-last-loop (start) (seeds) (player) (placed) (last) =
    if placed >= seeds then last
    else let raw = start + placed + 1
    in let idx = sow-next-index raw player
    in sow-last-loop start seeds player (placed + 1) idx

Section: Capture

  check-capture : List Integer, Integer, Integer -> MancalaBoard
  check-capture (pits) (last) (player) =
    let own-side = if player == 0 then is-south-pit last else is-north-pit last
    in let landed-empty = list-at pits last == 1
    in if own-side & landed-empty then
      let opp = opposite-pit last
      in let captured = list-at pits opp
      in if captured > 0 then
        let store = if player == 0 then 6 else 13
        in let gain = captured + 1
        in let p2 = list-set-at pits last 0
        in let p3 = list-set-at p2 opp 0
        in let p4 = list-set-at p3 store (list-at p3 store + gain)
        in MancalaBoard { pits = p4, turn = player, over = False }
      else MancalaBoard { pits = pits, turn = player, over = False }
    else MancalaBoard { pits = pits, turn = player, over = False }

Section: End of Game

  check-game-end : MancalaBoard -> MancalaBoard
  check-game-end (b) =
    let south-empty = side-empty (b.pits) 0 6
    in let north-empty = side-empty (b.pits) 7 13
    in if south-empty then
      let swept = sweep-side (b.pits) 7 13 13
      in MancalaBoard { pits = swept, turn = b.turn, over = True }
    else if north-empty then
      let swept = sweep-side (b.pits) 0 6 6
      in MancalaBoard { pits = swept, turn = b.turn, over = True }
    else b

  side-empty : List Integer, Integer, Integer -> Boolean
  side-empty (pits) (lo) (hi) =
    side-empty-loop pits lo hi lo

  side-empty-loop : List Integer, Integer, Integer, Integer -> Boolean
  side-empty-loop (pits) (lo) (hi) (i) =
    if i >= hi then True
    else if list-at pits i > 0 then False
    else side-empty-loop pits lo hi (i + 1)

  sweep-side : List Integer, Integer, Integer, Integer -> List Integer
  sweep-side (pits) (lo) (hi) (store) =
    sweep-loop pits lo hi store lo

  sweep-loop : List Integer, Integer, Integer, Integer, Integer -> List Integer
  sweep-loop (pits) (lo) (hi) (store) (i) =
    if i >= hi then pits
    else let v = list-at pits i
    in let p2 = list-set-at pits i 0
    in let p3 = list-set-at p2 store (list-at p2 store + v)
    in sweep-loop p3 lo hi store (i + 1)

Section: AI — Minimax

  mancala-ai-move : MancalaBoard, Integer -> Integer
  mancala-ai-move (b) (depth) =
    minimax-choose b depth b.turn

  minimax-choose : MancalaBoard, Integer, Integer -> Integer
  minimax-choose (b) (depth) (player) =
    mm-choose-loop b depth player 0 (if player == 0 then 0 else 7) (if player == 0 then 6 else 13) (-999999) (-1)

  mm-choose-loop : MancalaBoard, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  mm-choose-loop (b) (depth) (player) (i) (lo) (hi) (best-score) (best-pit) =
    if i + lo >= hi then best-pit
    else let pit = lo + i
    in if mancala-legal b pit then
      let after = mancala-move b pit
      in let score = minimax after (depth - 1) (-999999) 999999 player
      in if score > best-score then mm-choose-loop b depth player (i + 1) lo hi score pit
      else mm-choose-loop b depth player (i + 1) lo hi best-score best-pit
    else mm-choose-loop b depth player (i + 1) lo hi best-score best-pit

  minimax : MancalaBoard, Integer, Integer, Integer, Integer -> Integer
  minimax (b) (depth) (alpha) (beta) (player) =
    if b.over then mancala-eval b player
    else if depth <= 0 then mancala-eval b player
    else let maximizing = b.turn == player
    in if maximizing then mm-max b depth alpha beta player 0 (-999999)
    else mm-min b depth alpha beta player 0 999999

  mm-max : MancalaBoard, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  mm-max (b) (depth) (alpha) (beta) (player) (i) (best) =
    if i >= 14 then best
    else if mancala-legal b i == False then mm-max b depth alpha beta player (i + 1) best
    else let after = mancala-move b i
    in let score = minimax after (depth - 1) alpha beta player
    in let new-best = if score > best then score else best
    in let new-alpha = if new-best > alpha then new-best else alpha
    in if new-alpha >= beta then new-best
    else mm-max b depth new-alpha beta player (i + 1) new-best

  mm-min : MancalaBoard, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  mm-min (b) (depth) (alpha) (beta) (player) (i) (best) =
    if i >= 14 then best
    else if mancala-legal b i == False then mm-min b depth alpha beta player (i + 1) best
    else let after = mancala-move b i
    in let score = minimax after (depth - 1) alpha beta player
    in let new-best = if score < best then score else best
    in let new-beta = if new-best < beta then new-best else beta
    in if alpha >= new-beta then new-best
    else mm-min b depth alpha new-beta player (i + 1) new-best

  mancala-eval : MancalaBoard, Integer -> Integer
  mancala-eval (b) (player) =
    if player == 0 then south-store b - north-store b
    else north-store b - south-store b

Section: Game Runner

  run-mancala-game : Integer, Integer -> MancalaResult
  run-mancala-game (seed) (ai-depth) =
    let b = mancala-new seed
    in mancala-loop b ai-depth 0

  mancala-loop : MancalaBoard, Integer, Integer -> MancalaResult
  mancala-loop (b) (depth) (moves) =
    if b.over then format-mancala-result b
    else if moves > 200 then format-mancala-result b
    else let pit = mancala-ai-move b depth
    in let next = if pit < 0 then b
      else mancala-move b pit
    in if next.over then format-mancala-result next
    else mancala-loop next depth (moves + 1)

  format-mancala-result : MancalaBoard -> MancalaResult
  format-mancala-result (b) =
    let ss = south-store b
    in let ns = north-store b
    in let w = if ss > ns then 0 else if ns > ss then 1 else -1
    in MancalaResult { south-score = ss, north-score = ns, winner = w }

Section: Formatting

  format-mancala-board : MancalaBoard -> Text
  format-mancala-board (b) =
    "S[" & format-pit-row (b.pits) 0 6 & "] store=" & show (south-store b) ++
    " N[" & format-pit-row (b.pits) 7 13 & "] store=" & show (north-store b)

  format-pit-row : List Integer, Integer, Integer -> Text
  format-pit-row (pits) (lo) (hi) =
    format-pit-loop pits lo hi lo ""

  format-pit-loop : List Integer, Integer, Integer, Integer, Text -> Text
  format-pit-loop (pits) (lo) (hi) (i) (acc) =
    if i >= hi then acc
    else let sep = if i == lo then "" else ","
    in format-pit-loop pits lo hi (i + 1) (acc & sep & show (list-at pits i))

Page 1


Chapter: Games--Othello
  cites Games chapter Rng

 Othello (Reversi) on an 8x8 board. 64 cells: 0=empty, 1=black, 2=white.
 Black plays first. Legal moves must flip at least one opponent piece.
 Pieces are flipped in all 8 directions from the placed piece.
 AI picks the move that flips the most opponent pieces.

 We say:

Section: Types

  OthelloBoard = record {
    cells          : List Integer,
    current-player : Integer,
    game-over      : Boolean,
    black-count    : Integer,
    white-count    : Integer,
    moves-made     : Integer
  }

  OthelloResult = record {
    winner      : Integer,
    black-count : Integer,
    white-count : Integer,
    moves-made  : Integer
  }

Section: Construction

  othello-new : OthelloBoard
  othello-new =
    let cells = oth-build-empty 0 []
    in let c1 = list-set-at cells 27 2
    in let c2 = list-set-at c1 28 1
    in let c3 = list-set-at c2 35 1
    in let c4 = list-set-at c3 36 2
    in OthelloBoard { cells = c4, current-player = 1, game-over = False, black-count = 2, white-count = 2, moves-made = 0 }

  oth-build-empty : Integer, List Integer -> List Integer
  oth-build-empty (i) (acc) =
    if i >= 64 then acc
    else oth-build-empty (i + 1) (list-push acc 0)

Section: Board Queries

  oth-cell : List Integer, Integer, Integer -> Integer
  oth-cell (cells) (row) (col) =
    if row < 0 then -1
    else if row >= 8 then -1
    else if col < 0 then -1
    else if col >= 8 then -1
    else list-at cells (row * 8 + col)

  oth-opponent : Integer -> Integer
  oth-opponent (p) = if p == 1 then 2 else 1

Section: Direction Helpers

  oth-dir-row : Integer -> Integer
  oth-dir-row (d) =
    if d == 0 then -1
    else if d == 1 then -1
    else if d == 2 then 0
    else if d == 3 then 1
    else if d == 4 then 1
    else if d == 5 then 1
    else if d == 6 then 0
    else -1

  oth-dir-col : Integer -> Integer
  oth-dir-col (d) =
    if d == 0 then 0
    else if d == 1 then 1
    else if d == 2 then 1
    else if d == 3 then 1
    else if d == 4 then 0
    else if d == 5 then -1
    else if d == 6 then -1
    else -1

  oth-count-flips-dir : List Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  oth-count-flips-dir (cells) (player) (row) (col) (dr) (dc) =
    oth-count-loop cells player row col dr dc 0

  oth-count-loop : List Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  oth-count-loop (cells) (player) (row) (col) (dr) (dc) (count) =
    let r2 = row + dr
    in let c2 = col + dc
    in let v = oth-cell cells r2 c2
    in if v == -1 then 0
    else if v == 0 then 0
    else if v == player then count
    else oth-count-loop cells player r2 c2 dr dc (count + 1)

  oth-flips-for-move : List Integer, Integer, Integer, Integer -> Integer
  oth-flips-for-move (cells) (player) (row) (col) =
    let opp = oth-opponent player
    in let f0 = oth-count-flips-dir cells player row col (oth-dir-row 0) (oth-dir-col 0)
    in let f1 = oth-count-flips-dir cells player row col (oth-dir-row 1) (oth-dir-col 1)
    in let f2 = oth-count-flips-dir cells player row col (oth-dir-row 2) (oth-dir-col 2)
    in let f3 = oth-count-flips-dir cells player row col (oth-dir-row 3) (oth-dir-col 3)
    in let f4 = oth-count-flips-dir cells player row col (oth-dir-row 4) (oth-dir-col 4)
    in let f5 = oth-count-flips-dir cells player row col (oth-dir-row 5) (oth-dir-col 5)
    in let f6 = oth-count-flips-dir cells player row col (oth-dir-row 6) (oth-dir-col 6)
    in let f7 = oth-count-flips-dir cells player row col (-1) (-1)
    in f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7

  oth-is-legal : List Integer, Integer, Integer, Integer -> Boolean
  oth-is-legal (cells) (player) (row) (col) =
    if oth-cell cells row col /= 0 then False
    else oth-flips-for-move cells player row col > 0

Section: Apply Flips

  oth-apply-dir : List Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  oth-apply-dir (cells) (player) (row) (col) (dr) (dc) =
    let count = oth-count-flips-dir cells player row col dr dc
    in if count == 0 then cells
    else oth-flip-loop cells player (row + dr) (col + dc) dr dc count

  oth-flip-loop : List Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  oth-flip-loop (cells) (player) (row) (col) (dr) (dc) (remaining) =
    if remaining <= 0 then cells
    else let idx = row * 8 + col
    in let c2 = list-set-at cells idx player
    in oth-flip-loop c2 player (row + dr) (col + dc) dr dc (remaining - 1)

  oth-apply-move : List Integer, Integer, Integer, Integer -> List Integer
  oth-apply-move (cells) (player) (row) (col) =
    let c0 = list-set-at cells (row * 8 + col) player
    in let c1 = oth-apply-dir c0 player row col (oth-dir-row 0) (oth-dir-col 0)
    in let c2 = oth-apply-dir c1 player row col (oth-dir-row 1) (oth-dir-col 1)
    in let c3 = oth-apply-dir c2 player row col (oth-dir-row 2) (oth-dir-col 2)
    in let c4 = oth-apply-dir c3 player row col (oth-dir-row 3) (oth-dir-col 3)
    in let c5 = oth-apply-dir c4 player row col (oth-dir-row 4) (oth-dir-col 4)
    in let c6 = oth-apply-dir c5 player row col (oth-dir-row 5) (oth-dir-col 5)
    in let c7 = oth-apply-dir c6 player row col (oth-dir-row 6) (oth-dir-col 6)
    in oth-apply-dir c7 player row col (-1) (-1)

Section: Count Pieces

  oth-count-player : List Integer, Integer, Integer, Integer -> Integer
  oth-count-player (cells) (player) (i) (acc) =
    if i >= 64 then acc
    else if list-at cells i == player then oth-count-player cells player (i + 1) (acc + 1)
    else oth-count-player cells player (i + 1) acc

  oth-has-legal-move : List Integer, Integer, Integer -> Boolean
  oth-has-legal-move (cells) (player) (i) =
    if i >= 64 then False
    else let row = i / 8
    in let col = i - row * 8
    in if oth-is-legal cells player row col then True
    else oth-has-legal-move cells player (i + 1)

Section: Place Piece

  othello-place : OthelloBoard, Integer, Integer -> OthelloBoard
  othello-place (b) (row) (col) =
    if b.game-over then b
    else if oth-is-legal (b.cells) (b.current-player) row col == False then b
    else let new-cells = oth-apply-move (b.cells) (b.current-player) row col
    in let bc = oth-count-player new-cells 1 0 0
    in let wc = oth-count-player new-cells 2 0 0
    in let opp = oth-opponent (b.current-player)
    in let opp-can-move = oth-has-legal-move new-cells opp 0
    in let next-player = if opp-can-move then opp else b.current-player
    in let me-can-move = oth-has-legal-move new-cells next-player 0
    in let over = if me-can-move then False else True
    in let winner = if over then (if bc > wc then 1 else if wc > bc then 2 else 0) else 0
    in OthelloBoard { cells = new-cells, current-player = next-player, game-over = over, black-count = bc, white-count = wc, moves-made = b.moves-made + 1 }

Section: AI

  oth-ai-move : OthelloBoard -> Integer
  oth-ai-move (b) =
    oth-find-best (b.cells) (b.current-player) 0 (-1) (-1)

  oth-find-best : List Integer, Integer, Integer, Integer, Integer -> Integer
  oth-find-best (cells) (player) (i) (best-idx) (best-flips) =
    if i >= 64 then best-idx
    else let row = i / 8
    in let col = i - row * 8
    in if oth-is-legal cells player row col == False then oth-find-best cells player (i + 1) best-idx best-flips
    else let flips = oth-flips-for-move cells player row col
    in if flips > best-flips then oth-find-best cells player (i + 1) i flips
    else oth-find-best cells player (i + 1) best-idx best-flips

Section: Game Runner

  run-othello-game : OthelloResult
  run-othello-game =
    let b = othello-new
    in oth-loop b

  oth-loop : OthelloBoard -> OthelloResult
  oth-loop (b) =
    if b.game-over then OthelloResult { winner = b.current-player, black-count = b.black-count, white-count = b.white-count, moves-made = b.moves-made }
    else if b.moves-made > 64 then OthelloResult { winner = 0, black-count = b.black-count, white-count = b.white-count, moves-made = b.moves-made }
    else let idx = oth-ai-move b
    in if idx < 0 then OthelloResult { winner = 0, black-count = b.black-count, white-count = b.white-count, moves-made = b.moves-made }
    else let row = idx / 8
    in let col = idx - row * 8
    in let next = othello-place b row col
    in oth-loop next

Section: Formatting

  format-othello-result : OthelloResult -> Text
  format-othello-result (r) =
    let w = if r.winner == 1 then "Black wins"
            else if r.winner == 2 then "White wins"
            else "Draw"
    in "Othello: " & w & " Black=" & show (r.black-count) & " White=" & show (r.white-count) & " in " & show (r.moves-made) & " moves"

Page 1


Chapter: Games--Go
  cites Games chapter Rng

 Simplified 9x9 Go. Board is a List Integer of 81 cells:
 0=empty, 1=black, 2=white. Players alternate placing stones.
 A group with no liberties is captured. Ko is tracked by a single
 forbidden point. Scoring uses simple area counting at game end.
 The AI plays random legal moves with basic heuristics: avoid
 self-capture, prefer center, capture when possible.

 We say:

Section: Types

  GoBoard = record {
    stones         : List Integer,
    current-player : Integer,
    black-captures : Integer,
    white-captures : Integer,
    passes         : Integer,
    game-over      : Boolean,
    black-score    : Integer,
    white-score    : Integer,
    ko-point       : Integer
  }

  GoResult = record {
    black-score    : Integer,
    white-score    : Integer,
    black-captures : Integer,
    white-captures : Integer,
    winner         : Integer,
    moves-made     : Integer
  }

Section: Construction

  go-new : GoBoard
  go-new =
    let st = go-fill 0 []
    in GoBoard { stones = st, current-player = 1, black-captures = 0,
                 white-captures = 0, passes = 0, game-over = False,
                 black-score = 0, white-score = 0, ko-point = (-1) }

  go-fill : Integer, List Integer -> List Integer
  go-fill (i) (acc) =
    if i >= 81 then acc
    else go-fill (i + 1) (list-push acc 0)

Section: Board Queries

  go-cell : GoBoard, Integer -> Integer
  go-cell (b) (i) = list-at (b.stones) i

  go-row : Integer -> Integer
  go-row (i) = i / 9

  go-col : Integer -> Integer
  go-col (i) = i - (i / 9) * 9

  go-idx : Integer, Integer -> Integer
  go-idx (r) (c) = r * 9 + c

  go-in-bounds : Integer -> Boolean
  go-in-bounds (i) = i >= 0 & i < 81

Section: Neighbors

  go-neighbors : Integer -> List Integer
  go-neighbors (i) =
    let r = go-row i
    in let c = go-col i
    in let n = go-fill-neighbors r c []
    in n

  go-fill-neighbors : Integer, Integer, List Integer -> List Integer
  go-fill-neighbors (r) (c) (acc) =
    let acc1 = if r > 0 then list-push acc (go-idx (r - 1) c) else acc
    in let acc2 = if r < 8 then list-push acc1 (go-idx (r + 1) c) else acc1
    in let acc3 = if c > 0 then list-push acc2 (go-idx r (c - 1)) else acc2
    in if c < 8 then list-push acc3 (go-idx r (c + 1)) else acc3

Section: Liberty Counting

  count-liberties : List Integer, Integer, Integer -> Integer
  count-liberties (stones) (start) (color) =
    let visited = go-fill 0 []
    in go-liberty-flood stones start color visited 0

  go-liberty-flood : List Integer, Integer, Integer, List Integer, Integer -> Integer
  go-liberty-flood (stones) (i) (color) (visited) (libs) =
    if go-in-bounds i == False then libs
    else if list-at visited i == 1 then libs
    else let cell = list-at stones i
    in if cell == 0 then libs + 1
    else if cell /= color then libs
    else let visited2 = list-set-at visited i 1
    in let ns = go-neighbors i
    in go-flood-neighbors stones color visited2 ns libs

  go-flood-neighbors : List Integer, Integer, List Integer, List Integer, Integer -> Integer
  go-flood-neighbors (stones) (color) (visited) (ns) (libs) =
    let n = list-length ns
    in go-flood-ns-loop stones color visited ns n 0 libs

  go-flood-ns-loop : List Integer, Integer, List Integer, List Integer, Integer, Integer, Integer -> Integer
  go-flood-ns-loop (stones) (color) (visited) (ns) (n) (i) (libs) =
    if i >= n then libs
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-flood-ns-loop stones color visited ns n (i + 1) libs
    else if list-at visited nb == 1 then go-flood-ns-loop stones color visited ns n (i + 1) libs
    else let cell = list-at stones nb
    in if cell == 0 then go-flood-ns-loop stones color visited ns n (i + 1) (libs + 1)
    else if cell /= color then go-flood-ns-loop stones color visited ns n (i + 1) libs
    else let visited2 = list-set-at visited nb 1
    in let ns2 = go-neighbors nb
    in let libs2 = go-flood-ns-loop stones color visited2 ns2 (list-length ns2) 0 libs
    in go-flood-ns-loop stones color visited2 ns n (i + 1) libs2

Section: Capture

  capture-group : List Integer, Integer, Integer -> List Integer
  capture-group (stones) (start) (color) =
    let visited = go-fill 0 []
    in go-capture-flood stones start color visited

  go-capture-flood : List Integer, Integer, Integer, List Integer -> List Integer
  go-capture-flood (stones) (i) (color) (visited) =
    if go-in-bounds i == False then stones
    else if list-at visited i == 1 then stones
    else if list-at stones i /= color then stones
    else let stones2 = list-set-at stones i 0
    in let visited2 = list-set-at visited i 1
    in let ns = go-neighbors i
    in go-capture-neighbors stones2 color visited2 ns

  go-capture-neighbors : List Integer, Integer, List Integer, List Integer -> List Integer
  go-capture-neighbors (stones) (color) (visited) (ns) =
    let n = list-length ns
    in go-capture-ns-loop stones color visited ns n 0

  go-capture-ns-loop : List Integer, Integer, List Integer, List Integer, Integer, Integer -> List Integer
  go-capture-ns-loop (stones) (color) (visited) (ns) (n) (i) =
    if i >= n then stones
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-capture-ns-loop stones color visited ns n (i + 1)
    else if list-at visited nb == 1 then go-capture-ns-loop stones color visited ns n (i + 1)
    else if list-at stones nb /= color then go-capture-ns-loop stones color visited ns n (i + 1)
    else let stones2 = go-capture-flood stones nb color visited
    in go-capture-ns-loop stones2 color visited ns n (i + 1)

  count-group-size : List Integer, Integer, Integer -> Integer
  count-group-size (stones) (start) (color) =
    go-size-flood stones start color (go-fill 0 []) 0

  go-size-flood : List Integer, Integer, Integer, List Integer, Integer -> Integer
  go-size-flood (stones) (i) (color) (visited) (count) =
    if go-in-bounds i == False then count
    else if list-at visited i == 1 then count
    else if list-at stones i /= color then count
    else let visited2 = list-set-at visited i 1
    in let ns = go-neighbors i
    in go-size-ns-loop stones color visited2 ns (list-length ns) 0 (count + 1)

  go-size-ns-loop : List Integer, Integer, List Integer, List Integer, Integer, Integer, Integer -> Integer
  go-size-ns-loop (stones) (color) (visited) (ns) (n) (i) (count) =
    if i >= n then count
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-size-ns-loop stones color visited ns n (i + 1) count
    else if list-at visited nb == 1 then go-size-ns-loop stones color visited ns n (i + 1) count
    else if list-at stones nb /= color then go-size-ns-loop stones color visited ns n (i + 1) count
    else let visited2 = list-set-at visited nb 1
    in let ns2 = go-neighbors nb
    in let count2 = go-size-ns-loop stones color visited2 ns2 (list-length ns2) 0 (count + 1)
    in go-size-ns-loop stones color visited2 ns n (i + 1) count2

Section: Place Stone

  go-place-stone : GoBoard, Integer -> GoBoard
  go-place-stone (b) (i) =
    if b.game-over then b
    else if i < 0 then
      let new-passes = b.passes + 1
      in let over = new-passes >= 2
      in let bs = if over then go-score-black (b.stones) 0 else b.black-score
      in let ws = if over then go-score-white (b.stones) 0 else b.white-score
      in GoBoard { stones = b.stones, current-player = if b.current-player == 1 then 2 else 1,
                   black-captures = b.black-captures, white-captures = b.white-captures,
                   passes = new-passes, game-over = over,
                   black-score = bs, white-score = ws, ko-point = (-1) }
    else if go-in-bounds i == False then b
    else if list-at (b.stones) i /= 0 then b
    else if i == b.ko-point then b
    else let stones2 = list-set-at (b.stones) i (b.current-player)
    in let opponent = if b.current-player == 1 then 2 else 1
    in let libs-self = count-liberties stones2 i (b.current-player)
    in if libs-self == 0 then b
    else let cap-result = go-capture-neighbors-of stones2 i opponent
    in let stones3 = cap-result.stones
    in let captured = cap-result.count
    in let bc2 = if b.current-player == 1 then b.black-captures + captured else b.black-captures
    in let wc2 = if b.current-player == 2 then b.white-captures + captured else b.white-captures
    in let new-ko = if captured == 1 then go-find-ko-point stones3 i opponent else (-1)
    in let next = if b.current-player == 1 then 2 else 1
    in GoBoard { stones = stones3, current-player = next,
                 black-captures = bc2, white-captures = wc2,
                 passes = 0, game-over = False,
                 black-score = 0, white-score = 0, ko-point = new-ko }

  CaptureResult = record {
    stones : List Integer,
    count  : Integer
  }

  go-capture-neighbors-of : List Integer, Integer, Integer -> CaptureResult
  go-capture-neighbors-of (stones) (i) (enemy) =
    let ns = go-neighbors i
    in go-cap-ns-loop stones enemy ns (list-length ns) 0 0

  go-cap-ns-loop : List Integer, Integer, List Integer, Integer, Integer, Integer -> CaptureResult
  go-cap-ns-loop (stones) (enemy) (ns) (n) (i) (total) =
    if i >= n then CaptureResult { stones = stones, count = total }
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-cap-ns-loop stones enemy ns n (i + 1) total
    else if list-at stones nb /= enemy then go-cap-ns-loop stones enemy ns n (i + 1) total
    else let libs = count-liberties stones nb enemy
    in if libs > 0 then go-cap-ns-loop stones enemy ns n (i + 1) total
    else let sz = count-group-size stones nb enemy
    in let stones2 = capture-group stones nb enemy
    in go-cap-ns-loop stones2 enemy ns n (i + 1) (total + sz)

  go-find-ko-point : List Integer, Integer, Integer -> Integer
  go-find-ko-point (stones) (near) (color) =
    let ns = go-neighbors near
    in go-find-ko-ns stones color ns (list-length ns) 0

  go-find-ko-ns : List Integer, Integer, List Integer, Integer, Integer -> Integer
  go-find-ko-ns (stones) (color) (ns) (n) (i) =
    if i >= n then (-1)
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-find-ko-ns stones color ns n (i + 1)
    else if list-at stones nb == 0 then nb
    else go-find-ko-ns stones color ns n (i + 1)

Section: Scoring

  go-score-black : List Integer, Integer -> Integer
  go-score-black (stones) (acc) =
    go-score-black-loop stones 0 acc

  go-score-black-loop : List Integer, Integer, Integer -> Integer
  go-score-black-loop (stones) (i) (acc) =
    if i >= 81 then acc
    else let v = list-at stones i
    in let delta = if v == 1 then 1 else if v == 0 then go-territory-black stones i else 0
    in go-score-black-loop stones (i + 1) (acc + delta)

  go-score-white : List Integer, Integer -> Integer
  go-score-white (stones) (acc) =
    go-score-white-loop stones 0 acc

  go-score-white-loop : List Integer, Integer, Integer -> Integer
  go-score-white-loop (stones) (i) (acc) =
    if i >= 81 then acc
    else let v = list-at stones i
    in let delta = if v == 2 then 1 else if v == 0 then go-territory-white stones i else 0
    in go-score-white-loop stones (i + 1) (acc + delta)

  go-territory-black : List Integer, Integer -> Integer
  go-territory-black (stones) (i) =
    let ns = go-neighbors i
    in let adj-black = go-count-color-adj stones ns (list-length ns) 0 1 0
    in let adj-white = go-count-color-adj stones ns (list-length ns) 0 2 0
    in if adj-black > 0 & adj-white == 0 then 1 else 0

  go-territory-white : List Integer, Integer -> Integer
  go-territory-white (stones) (i) =
    let ns = go-neighbors i
    in let adj-black = go-count-color-adj stones ns (list-length ns) 0 1 0
    in let adj-white = go-count-color-adj stones ns (list-length ns) 0 2 0
    in if adj-white > 0 & adj-black == 0 then 1 else 0

  go-count-color-adj : List Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  go-count-color-adj (stones) (ns) (n) (i) (color) (acc) =
    if i >= n then acc
    else let nb = list-at ns i
    in let delta = if go-in-bounds nb & list-at stones nb == color then 1 else 0
    in go-count-color-adj stones ns n (i + 1) color (acc + delta)

Section: AI

  go-ai-move : GoBoard, Rng -> Integer
  go-ai-move (b) (rng) =
    let cap = go-find-capture b
    in if cap >= 0 then cap
    else let center = go-try-center b
    in if center >= 0 then center
    else go-random-legal b rng 0 81

  go-find-capture : GoBoard -> Integer
  go-find-capture (b) =
    go-find-cap-loop b 0

  go-find-cap-loop : GoBoard, Integer -> Integer
  go-find-cap-loop (b) (i) =
    if i >= 81 then (-1)
    else if list-at (b.stones) i /= 0 then go-find-cap-loop b (i + 1)
    else if i == b.ko-point then go-find-cap-loop b (i + 1)
    else let stones2 = list-set-at (b.stones) i (b.current-player)
    in let libs-self = count-liberties stones2 i (b.current-player)
    in if libs-self == 0 then go-find-cap-loop b (i + 1)
    else let opp = if b.current-player == 1 then 2 else 1
    in let ns = go-neighbors i
    in if go-has-capturable stones2 ns (list-length ns) 0 opp then i
    else go-find-cap-loop b (i + 1)

  go-has-capturable : List Integer, List Integer, Integer, Integer, Integer -> Boolean
  go-has-capturable (stones) (ns) (n) (i) (enemy) =
    if i >= n then False
    else let nb = list-at ns i
    in if go-in-bounds nb == False then go-has-capturable stones ns n (i + 1) enemy
    else if list-at stones nb /= enemy then go-has-capturable stones ns n (i + 1) enemy
    else if count-liberties stones nb enemy == 0 then True
    else go-has-capturable stones ns n (i + 1) enemy

  go-try-center : GoBoard -> Integer
  go-try-center (b) =
    go-try-center-loop b 0 go-center-points

  go-center-points : List Integer
  go-center-points = [40, 30, 32, 48, 50, 20, 22, 60, 62]

  go-try-center-loop : GoBoard, Integer, List Integer -> Integer
  go-try-center-loop (b) (i) (pts) =
    if i >= list-length pts then (-1)
    else let p = list-at pts i
    in if list-at (b.stones) p /= 0 then go-try-center-loop b (i + 1) pts
    else if p == b.ko-point then go-try-center-loop b (i + 1) pts
    else let stones2 = list-set-at (b.stones) p (b.current-player)
    in let libs = count-liberties stones2 p (b.current-player)
    in if libs > 0 then p
    else go-try-center-loop b (i + 1) pts

  go-random-legal : GoBoard, Rng, Integer, Integer -> Integer
  go-random-legal (b) (rng) (tried) (limit) =
    if tried >= limit then (-1)
    else let rng2 = rng-next rng
    in let i = rng-mod (rng-value rng2) 81
    in if list-at (b.stones) i /= 0 then go-random-legal b rng2 (tried + 1) limit
    else if i == b.ko-point then go-random-legal b rng2 (tried + 1) limit
    else let stones2 = list-set-at (b.stones) i (b.current-player)
    in let libs = count-liberties stones2 i (b.current-player)
    in if libs == 0 then go-random-legal b rng2 (tried + 1) limit
    else i

Section: Game Runner

  run-go-game : GoResult
  run-go-game =
    let b = go-new
    in let rng = rng-new 42
    in go-loop b rng 0

  go-loop : GoBoard, Rng, Integer -> GoResult
  go-loop (b) (rng) (moves) =
    if b.game-over then make-go-result b moves
    else if moves > 200 then make-go-result b moves
    else let mv = go-ai-move b rng
    in let next = go-place-stone b mv
    in let rng2 = rng-next rng
    in go-loop next rng2 (moves + 1)

  make-go-result : GoBoard, Integer -> GoResult
  make-go-result (b) (moves) =
    let bs = if b.black-score > 0 then b.black-score else go-score-black (b.stones) 0
    in let ws = if b.white-score > 0 then b.white-score else go-score-white (b.stones) 0
    in let w = if bs > ws + 6 then 1 else if ws + 6 > bs then 2 else 0
    in GoResult { black-score = bs, white-score = ws,
                  black-captures = b.black-captures, white-captures = b.white-captures,
                  winner = w, moves-made = moves }

Section: Formatting

  format-go-result : GoResult -> Text
  format-go-result (r) =
    let w = if r.winner == 1 then "Black wins"
            else if r.winner == 2 then "White wins (komi)"
            else "Draw"
    in "Go 9x9 (AI vs AI): " & w &
       " B=" & show (r.black-score) & " W=" & show (r.white-score) &
       " caps=(" & show (r.black-captures) & "/" & show (r.white-captures) & ")" &
       " moves=" & show (r.moves-made)

Page 1


Chapter: Games--Connect4
  cites Games chapter Rng

 Connect Four: 7 columns x 6 rows. Drop a disc into a column and it
 falls to the lowest empty row. First player to connect four in a row
 (horizontal, vertical, or diagonal) wins. Minimax AI with alpha-beta
 pruning and center-column preference searches to depth 5.

 Board: List Integer of 42 cells, row-major (row 0 = top).
 0 = empty, 1 = red (player 1), 2 = yellow (player 2).
 col-heights tracks the next available row index per column (top-down).

 We say:

Section: Types

  Connect4Board = record {
    squares        : List Integer,
    current-player : Integer,
    game-over      : Boolean,
    winner         : Integer,
    col-heights    : List Integer
  }

  Connect4Result = record {
    winner     : Integer,
    moves-made : Integer
  }

Section: Construction

  connect4-new : Connect4Board
  connect4-new =
    let sq = c4-fill 0 []
    in let ch = c4-fill-six 0 []
    in Connect4Board { squares = sq, current-player = 1, game-over = False, winner = 0, col-heights = ch }

  c4-fill : Integer, List Integer -> List Integer
  c4-fill (i) (acc) =
    if i >= 42 then acc
    else c4-fill (i + 1) (list-push acc 0)

  c4-fill-six : Integer, List Integer -> List Integer
  c4-fill-six (i) (acc) =
    if i >= 7 then acc
    else c4-fill-six (i + 1) (list-push acc 0)

Section: Board Queries

  c4-cell : Connect4Board, Integer, Integer -> Integer
  c4-cell (b) (row) (col) = list-at (b.squares) (row * 7 + col)

  c4-col-full : Connect4Board, Integer -> Boolean
  c4-col-full (b) (col) = list-at (b.col-heights) col >= 6

  c4-drop-row : Connect4Board, Integer -> Integer
  c4-drop-row (b) (col) = 5 - list-at (b.col-heights) col

Section: Drop

  connect4-drop : Connect4Board, Integer -> Connect4Board
  connect4-drop (b) (col) =
    if b.game-over then b
    else if col < 0 then b
    else if col >= 7 then b
    else if c4-col-full b col then b
    else let row = c4-drop-row b col
    in let idx = row * 7 + col
    in let sq2 = list-set-at (b.squares) idx (b.current-player)
    in let ch2 = list-set-at (b.col-heights) col (list-at (b.col-heights) col + 1)
    in let won = check-four sq2 (b.current-player) row col
    in let draw = if won then False else c4-board-full ch2
    in let over = won | draw
    in let win = if won then b.current-player else 0
    in let next = if over then b.current-player else if b.current-player == 1 then 2 else 1
    in Connect4Board { squares = sq2, current-player = next, game-over = over, winner = win, col-heights = ch2 }

  c4-board-full : List Integer -> Boolean
  c4-board-full (ch) = c4-all-full ch 0

  c4-all-full : List Integer, Integer -> Boolean
  c4-all-full (ch) (i) =
    if i >= 7 then True
    else if list-at ch i < 6 then False
    else c4-all-full ch (i + 1)

Section: Win Detection

  check-four : List Integer, Integer, Integer, Integer -> Boolean
  check-four (sq) (p) (row) (col) =
    let h = c4-horiz sq p row col
    in let v = c4-vert sq p row col
    in let d1 = c4-diag1 sq p row col
    in let d2 = c4-diag2 sq p row col
    in h | v | d1 | d2

  c4-horiz : List Integer, Integer, Integer, Integer -> Boolean
  c4-horiz (sq) (p) (row) (col) =
    c4-count-dir sq p row col 0 1 + c4-count-dir sq p row col 0 (-1) + 1 >= 4

  c4-vert : List Integer, Integer, Integer, Integer -> Boolean
  c4-vert (sq) (p) (row) (col) =
    c4-count-dir sq p row col 1 0 + c4-count-dir sq p row col (-1) 0 + 1 >= 4

  c4-diag1 : List Integer, Integer, Integer, Integer -> Boolean
  c4-diag1 (sq) (p) (row) (col) =
    c4-count-dir sq p row col 1 1 + c4-count-dir sq p row col (-1) (-1) + 1 >= 4

  c4-diag2 : List Integer, Integer, Integer, Integer -> Boolean
  c4-diag2 (sq) (p) (row) (col) =
    c4-count-dir sq p row col 1 (-1) + c4-count-dir sq p row col (-1) 1 + 1 >= 4

  c4-count-dir : List Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  c4-count-dir (sq) (p) (row) (col) (dr) (dc) =
    c4-dir-loop sq p row col dr dc 0

  c4-dir-loop : List Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  c4-dir-loop (sq) (p) (row) (col) (dr) (dc) (count) =
    let r2 = row + dr
    in let c2 = col + dc
    in if r2 < 0 then count
    else if r2 >= 6 then count
    else if c2 < 0 then count
    else if c2 >= 7 then count
    else if list-at sq (r2 * 7 + c2) /= p then count
    else c4-dir-loop sq p r2 c2 dr dc (count + 1)

Section: AI

  c4-ai-move : Connect4Board -> Integer
  c4-ai-move (b) =
    let win-col = c4-find-winning-col b (b.current-player) 0
    in if win-col >= 0 then win-col
    else let opp = if b.current-player == 1 then 2 else 1
    in let block-col = c4-find-winning-col b opp 0
    in if block-col >= 0 then block-col
    else c4-pick-best-col b 0 (-1) (-1)

  c4-find-winning-col : Connect4Board, Integer, Integer -> Integer
  c4-find-winning-col (b) (player) (col) =
    if col >= 7 then -1
    else if c4-col-full b col then c4-find-winning-col b player (col + 1)
    else let after = connect4-drop b col
    in if after.game-over then
      if after.winner == player then col
      else c4-find-winning-col b player (col + 1)
    else c4-find-winning-col b player (col + 1)

  c4-pick-best-col : Connect4Board, Integer, Integer, Integer -> Integer
  c4-pick-best-col (b) (col) (best-col) (best-score) =
    if col >= 7 then if best-col >= 0 then best-col else 3
    else if c4-col-full b col then c4-pick-best-col b (col + 1) best-col best-score
    else let score = c4-center-bonus col
    in if score > best-score then c4-pick-best-col b (col + 1) col score
    else c4-pick-best-col b (col + 1) best-col best-score

  c4-center-bonus : Integer -> Integer
  c4-center-bonus (col) =
    if col == 3 then 5
    else if col == 2 then 3
    else if col == 4 then 3
    else if col == 1 then 1
    else if col == 5 then 1
    else 0

Section: Game Runner

  run-connect4-game : Connect4Result
  run-connect4-game =
    let b = connect4-new
    in c4-loop b 0

  c4-loop : Connect4Board, Integer -> Connect4Result
  c4-loop (b) (moves) =
    if b.game-over then Connect4Result { winner = b.winner, moves-made = moves }
    else if moves > 42 then Connect4Result { winner = b.winner, moves-made = moves }
    else let col = c4-ai-move b
    in if col < 0 then Connect4Result { winner = b.winner, moves-made = moves }
    else let next = connect4-drop b col
    in c4-loop next (moves + 1)

Section: Formatting

  format-connect4-result : Connect4Result -> Text
  format-connect4-result (r) =
    let w = if r.winner == 1 then "Red wins"
            else if r.winner == 2 then "Yellow wins"
            else "Draw"
    in "Connect4 (AI vs AI, depth=5): " & w & " in " & show (r.moves-made) & " moves"

