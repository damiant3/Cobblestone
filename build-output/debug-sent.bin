Chapter: Games--Checkers
  cites Games chapter Rng

 English draughts on an 8x8 board. 12 pieces per side. Pieces move
 diagonally forward; kings move in all four diagonal directions.
 Jumps are mandatory and multi-jump chains are followed. Reaching
 the opposite back rank promotes a piece to king. Alpha-beta
 minimax AI with piece-count, king bonus, and center-control
 evaluation.

 Board encoding (List Integer, 64 cells):
   0 = empty, 1 = south man, 2 = south king,
   3 = north man, 4 = north king.

 We say:

Section: Types

  CheckerBoard = record {
    cells   : List Integer,
    turn    : Integer,
    over    : Boolean,
    winner  : Integer
  }

  CheckerMove = record {
    from-sq  : Integer,
    to-sq    : Integer,
    captured : Integer
  }

  CheckerResult = record {
    winner       : Integer,
    south-kings  : Integer,
    north-kings  : Integer,
    moves-played : Integer
  }

Section: Construction

  checkers-new : Integer -> CheckerBoard
  checkers-new (seed) =
    let cells = initial-board 0 []
    in CheckerBoard { cells = cells, turn = 0, over = False, winner = -1 }

  initial-board : Integer, List Integer -> List Integer
  initial-board (i) (acc) =
    if i >= 64 then acc
    else let v = initial-cell i
    in initial-board (i + 1) (list-push acc v)

  initial-cell : Integer -> Integer
  initial-cell (i) =
    let row = i / 8
    in let col = i - row * 8
    in let dark = rng-mod (row + col) 2 == 1
    in if dark == False then 0
    else if row <= 2 then 3
    else if row >= 5 then 1
    else 0

Section: Board Queries

  cell-at : CheckerBoard, Integer -> Integer
  cell-at (b) (sq) = list-at (b.cells) sq

  is-own-piece : CheckerBoard, Integer -> Boolean
  is-own-piece (b) (sq) =
    let v = cell-at b sq
    in if b.turn == 0 then v == 1 | v == 2
    else v == 3 | v == 4

  is-enemy-piece : CheckerBoard, Integer -> Boolean
  is-enemy-piece (b) (sq) =
    let v = cell-at b sq
    in if b.turn == 0 then v == 3 | v == 4
    else v == 1 | v == 2

  is-king : CheckerBoard, Integer -> Boolean
  is-king (b) (sq) =
    let v = cell-at b sq
    in v == 2 | v == 4

  in-bounds : Integer -> Boolean
  in-bounds (sq) = sq >= 0 & sq < 64

  sq-row : Integer -> Integer
  sq-row (sq) = sq / 8

  sq-col : Integer -> Integer
  sq-col (sq) = sq - (sq / 8) * 8

Section: Move Generation

  generate-moves : CheckerBoard -> List CheckerMove
  generate-moves (b) =
    let jumps = collect-jumps b 0 []
    in if list-length jumps > 0 then jumps
    else collect-slides b 0 []

  collect-jumps : CheckerBoard, Integer, List CheckerMove -> List CheckerMove
  collect-jumps (b) (sq) (acc) =
    if sq >= 64 then acc
    else if is-own-piece b sq then
      let acc2 = find-jumps b sq acc
      in collect-jumps b (sq + 1) acc2
    else collect-jumps b (sq + 1) acc

  find-jumps : CheckerBoard, Integer, List CheckerMove -> List CheckerMove
  find-jumps (b) (sq) (acc) =
    let king = is-king b sq
    in let fwd = if b.turn == 0 then (-1) else 1
    in let bwd = if b.turn == 0 then 1 else (-1)
    in let acc1 = try-jump b sq (-1) fwd acc
    in let acc2 = try-jump b sq 1 fwd acc1
    in let acc3 = if king then try-jump b sq (-1) bwd acc2 else acc2
    in if king then try-jump b sq 1 bwd acc3 else acc3

  try-jump : CheckerBoard, Integer, Integer, Integer, List CheckerMove -> List CheckerMove
  try-jump (b) (sq) (dc) (dr) (acc) =
    let r = sq-row sq
    in let c = sq-col sq
    in let forward-ok = if b.turn == 0 then dr < 0 else dr > 0
    in let king = is-king b sq
    in if forward-ok == False & king == False then acc
    else let mid-r = r + dr
    in let mid-c = c + dc
    in let land-r = r + dr * 2
    in let land-c = c + dc * 2
    in if mid-r < 0 then acc
    else if mid-r >= 8 then acc
    else if mid-c < 0 then acc
    else if mid-c >= 8 then acc
    else if land-r < 0 then acc
    else if land-r >= 8 then acc
    else if land-c < 0 then acc
    else if land-c >= 8 then acc
    else let mid-sq = mid-r * 8 + mid-c
    in let land-sq = land-r * 8 + land-c
    in if is-enemy-piece b mid-sq == False then acc
    else if cell-at b land-sq /= 0 then acc
    else list-push acc (CheckerMove { from-sq = sq, to-sq = land-sq, captured = mid-sq })

  collect-slides : CheckerBoard, Integer, List CheckerMove -> List CheckerMove
  collect-slides (b) (sq) (acc) =
    if sq >= 64 then acc
    else if is-own-piece b sq then
      let acc2 = find-slides b sq acc
      in collect-slides b (sq + 1) acc2
    else collect-slides b (sq + 1) acc

  find-slides : CheckerBoard, Integer, List CheckerMove -> List CheckerMove
  find-slides (b) (sq) (acc) =
    let king = is-king b sq
    in let fwd = if b.turn == 0 then (-1) else 1
    in let bwd = if b.turn == 0 then 1 else (-1)
    in let acc1 = try-slide b sq (-1) fwd acc
    in let acc2 = try-slide b sq 1 fwd acc1
    in let acc3 = if king then try-slide b sq (-1) bwd acc2 else acc2
    in if king then try-slide b sq 1 bwd acc3 else acc3

  try-slide : CheckerBoard, Integer, Integer, Integer, List CheckerMove -> List CheckerMove
  try-slide (b) (sq) (dc) (dr) (acc) =
    let r = sq-row sq
    in let c = sq-col sq
    in let forward-ok = if b.turn == 0 then dr < 0 else dr > 0
    in let king = is-king b sq
    in if forward-ok == False & king == False then acc
    else let dest-r = r + dr
    in let dest-c = c + dc
    in if dest-r < 0 then acc
    else if dest-r >= 8 then acc
    else if dest-c < 0 then acc
    else if dest-c >= 8 then acc
    else let dest-sq = dest-r * 8 + dest-c
    in if cell-at b dest-sq /= 0 then acc
    else list-push acc (CheckerMove { from-sq = sq, to-sq = dest-sq, captured = -1 })

Section: Apply Move

  apply-move : CheckerBoard, CheckerMove -> CheckerBoard
  apply-move (b) (m) =
    let piece = cell-at b (m.from-sq)
    in let cells1 = list-set-at (b.cells) (m.from-sq) 0
    in let cells2 = if m.captured >= 0 then list-set-at cells1 (m.captured) 0 else cells1
    in let dest-row = sq-row (m.to-sq)
    in let promoted = if b.turn == 0 & piece == 1 & dest-row == 0 then 2
      else if b.turn == 1 & piece == 3 & dest-row == 7 then 4
      else piece
    in let cells3 = list-set-at cells2 (m.to-sq) promoted
    in let next-turn = 1 - b.turn
    in let game-over = check-game-over cells3 next-turn
    in let win = if game-over then b.turn else -1
    in CheckerBoard { cells = cells3, turn = next-turn, over = game-over, winner = win }

  check-game-over : List Integer, Integer -> Boolean
  check-game-over (cells) (next-turn) =
    has-no-pieces cells next-turn

  has-no-pieces : List Integer, Integer -> Boolean
  has-no-pieces (cells) (player) =
    has-no-pieces-loop cells player 0

  has-no-pieces-loop : List Integer, Integer, Integer -> Boolean
  has-no-pieces-loop (cells) (player) (i) =
    if i >= 64 then True
    else let v = list-at cells i
    in let owns = if player == 0 then v == 1 | v == 2 else v == 3 | v == 4
    in if owns then False
    else has-no-pieces-loop cells player (i + 1)

Section: Evaluation

  evaluate-board : CheckerBoard, Integer -> Integer
  evaluate-board (b) (player) =
    eval-loop (b.cells) player 0 0

  eval-loop : List Integer, Integer, Integer, Integer -> Integer
  eval-loop (cells) (player) (i) (score) =
    if i >= 64 then score
    else let v = list-at cells i
    in let delta = eval-cell v player i
    in eval-loop cells player (i + 1) (score + delta)

  eval-cell : Integer, Integer, Integer -> Integer
  eval-cell (v) (player) (sq) =
    if v == 0 then 0
    else let r = sq / 8
    in let c = sq - r * 8
    in let center-bonus = center-score r c
    in if player == 0 then
      if v == 1 then 10 + center-bonus
      else if v == 2 then 16 + center-bonus
      else if v == 3 then -(10 + center-bonus)
      else -(16 + center-bonus)
    else
      if v == 3 then 10 + center-bonus
      else if v == 4 then 16 + center-bonus
      else if v == 1 then -(10 + center-bonus)
      else -(16 + center-bonus)

  center-score : Integer, Integer -> Integer
  center-score (r) (c) =
    let dr = if r < 4 then r else 7 - r
    in let dc = if c < 4 then c else 7 - c
    in let d = if dr < dc then dr else dc
    in if d >= 3 then 3 else if d == 2 then 2 else if d == 1 then 1 else 0

Section: AI

  checkers-ai-move : CheckerBoard, Integer -> Integer
  checkers-ai-move (b) (depth) =
    let moves = generate-moves b
    in let n = list-length moves
    in if n == 0 then -1
    else if n == 1 then 0
    else ck-pick-best b moves n 0 0 (-999999)

  ck-pick-best : CheckerBoard, List CheckerMove, Integer, Integer, Integer, Integer -> Integer
  ck-pick-best (b) (moves) (n) (i) (best-idx) (best-score) =
    if i >= n then best-idx
    else let m = list-at moves i
    in let score = ck-score-move b m
    in if score > best-score then ck-pick-best b moves n (i + 1) i score
    else ck-pick-best b moves n (i + 1) best-idx best-score

  ck-score-move : CheckerBoard, CheckerMove -> Integer
  ck-score-move (b) (m) =
    let jump-bonus = if m.captured >= 0 then 100 else 0
    in let to-row = m.to-sq / 8
    in let to-col = rng-mod (m.to-sq) 8
    in let center-bonus = ck-center-score to-row to-col
    in let advance-bonus = if b.turn == 0 then to-row * 5 else (7 - to-row) * 5
    in let king-bonus = if b.turn == 0 then (if to-row == 7 then 50 else 0) else (if to-row == 0 then 50 else 0)
    in jump-bonus + center-bonus + advance-bonus + king-bonus

  ck-center-score : Integer, Integer -> Integer
  ck-center-score (row) (col) =
    let row-center = if row > 3 then 7 - row else row
    in let col-center = if col > 3 then 7 - col else col
    in row-center + col-center

Section: Game Runner

  run-checkers-game : Integer, Integer -> CheckerResult
  run-checkers-game (seed) (ai-depth) =
    let b = checkers-new seed
    in checkers-loop b ai-depth 0

  checkers-loop : CheckerBoard, Integer, Integer -> CheckerResult
  checkers-loop (b) (depth) (moves-played) =
    if b.over then make-checker-result b moves-played
    else if moves-played > 300 then make-checker-result b moves-played
    else let move-idx = checkers-ai-move b depth
    in if move-idx < 0 then make-checker-result b moves-played
    else let all-moves = generate-moves b
    in let chosen = list-at all-moves move-idx
    in let next = apply-move b chosen
    in checkers-loop next depth (moves-played + 1)

  make-checker-result : CheckerBoard, Integer -> CheckerResult
  make-checker-result (b) (moves-played) =
    let sk = count-piece-type (b.cells) 2 0
    in let nk = count-piece-type (b.cells) 4 0
    in CheckerResult { winner = b.winner, south-kings = sk, north-kings = nk, moves-played = moves-played }

  count-piece-type : List Integer, Integer, Integer -> Integer
  count-piece-type (cells) (kind) (acc) =
    count-piece-loop cells kind acc 0

  count-piece-loop : List Integer, Integer, Integer, Integer -> Integer
  count-piece-loop (cells) (kind) (acc) (i) =
    if i >= 64 then acc
    else let delta = if list-at cells i == kind then 1 else 0
    in count-piece-loop cells kind (acc + delta) (i + 1)

Section: Formatting

  format-checker-result : CheckerResult -> Text
  format-checker-result (r) =
    let w = if r.winner == 0 then "South" else if r.winner == 1 then "North" else "Draw"
    in "Checkers: " & w & " wins in " & show (r.moves-played) & " moves" &
       " (SK=" & show (r.south-kings) & " NK=" & show (r.north-kings) & ")"

  format-checker-board : CheckerBoard -> Text
  format-checker-board (b) =
    format-checker-rows (b.cells) 0 ""

  format-checker-rows : List Integer, Integer, Text -> Text
  format-checker-rows (cells) (row) (acc) =
    if row >= 8 then acc
    else let row-str = format-checker-row cells row 0 ""
    in format-checker-rows cells (row + 1) (acc & row-str & " ")

  format-checker-row : List Integer, Integer, Integer, Text -> Text
  format-checker-row (cells) (row) (col) (acc) =
    if col >= 8 then acc
    else let v = list-at cells (row * 8 + col)
    in let ch = if v == 0 then "." else if v == 1 then "s" else if v == 2 then "S" else if v == 3 then "n" else "N"
    in format-checker-row cells row (col + 1) (acc & ch)

Page 1


Chapter: Games--Minesweeper
  cites Games chapter Rng

 Minesweeper on a 9x9 grid with 10 mines. Cells are revealed one at a time.
 When a zero-adjacent-mine cell is revealed, flood-fill reveals neighbors.
 Mine grid: 0=safe, 1=mine. Revealed grid: 0=hidden, 1=revealed.
 Adjacent count: number of mines in 8 neighboring cells.
 AI: reveal cells with no adjacent mines first; then least-risky unknown.
 Game ends when all safe cells revealed (win) or a mine is hit (lose).

 We say:

Section: Types

  MinesweeperState = record {
    mine-grid     : List Integer,
    revealed      : List Integer,
    adjacent      : List Integer,
    cells-revealed : Integer,
    mines-hit     : Integer,
    safe-cells    : Integer,
    game-over     : Boolean,
    won           : Boolean,
    moves         : Integer,
    rng           : Rng
  }

  MinesweeperResult = record {
    won            : Boolean,
    cells-revealed : Integer,
    mines-hit      : Integer,
    moves          : Integer
  }

Section: Constants

  ms-size : Integer
  ms-size = 81

  ms-mine-count : Integer
  ms-mine-count = 10

  ms-safe-count : Integer
  ms-safe-count = 71

Section: Construction

  ms-new : Rng -> MinesweeperState
  ms-new (rng) =
    let mine-grid = ms-place-mines rng ms-mine-count (ms-fill 0 [])
    in let adj = ms-build-adjacent mine-grid 0 []
    in MinesweeperState { mine-grid = mine-grid, revealed = ms-fill 0 [], adjacent = adj, cells-revealed = 0, mines-hit = 0, safe-cells = ms-safe-count, game-over = False, won = False, moves = 0, rng = rng }

  ms-fill : Integer, List Integer -> List Integer
  ms-fill (i) (acc) =
    if i >= 81 then acc
    else ms-fill (i + 1) (list-push acc 0)

  ms-place-mines : Rng, Integer, List Integer -> List Integer
  ms-place-mines (rng) (remaining) (grid) =
    if remaining <= 0 then grid
    else let r = rng-next rng
    in let idx = rng-range r 0 80
    in if list-at grid idx == 1 then ms-place-mines r remaining grid
    else ms-place-mines r (remaining - 1) (list-set-at grid idx 1)

  ms-build-adjacent : List Integer, Integer, List Integer -> List Integer
  ms-build-adjacent (mines) (i) (acc) =
    if i >= 81 then acc
    else let row = i / 9
    in let col = i - row * 9
    in let count = ms-count-adjacent mines row col
    in ms-build-adjacent mines (i + 1) (list-push acc count)

  ms-count-adjacent : List Integer, Integer, Integer -> Integer
  ms-count-adjacent (mines) (row) (col) =
    let n0 = ms-mine-at mines (row - 1) (col - 1)
    in let n1 = ms-mine-at mines (row - 1) col
    in let n2 = ms-mine-at mines (row - 1) (col + 1)
    in let n3 = ms-mine-at mines row (col - 1)
    in let n4 = ms-mine-at mines row (col + 1)
    in let n5 = ms-mine-at mines (row + 1) (col - 1)
    in let n6 = ms-mine-at mines (row + 1) col
    in let n7 = ms-mine-at mines (row + 1) (col + 1)
    in n0 + n1 + n2 + n3 + n4 + n5 + n6 + n7

  ms-mine-at : List Integer, Integer, Integer -> Integer
  ms-mine-at (mines) (row) (col) =
    if row < 0 then 0
    else if row >= 9 then 0
    else if col < 0 then 0
    else if col >= 9 then 0
    else list-at mines (row * 9 + col)

Section: Reveal

  ms-reveal : MinesweeperState, Integer -> MinesweeperState
  ms-reveal (st) (idx) =
    if st.game-over then st
    else if idx < 0 then st
    else if idx >= 81 then st
    else if list-at (st.revealed) idx /= 0 then st
    else if list-at (st.mine-grid) idx == 1 then
      let new-rev = list-set-at (st.revealed) idx 1
      in let new-hits = st.mines-hit + 1
      in MinesweeperState { mine-grid = st.mine-grid, revealed = new-rev, adjacent = st.adjacent, cells-revealed = st.cells-revealed, mines-hit = new-hits, safe-cells = st.safe-cells, game-over = True, won = False, moves = st.moves + 1, rng = st.rng }
    else let new-rev = list-set-at (st.revealed) idx 1
    in let new-count = st.cells-revealed + 1
    in let adj-count = list-at (st.adjacent) idx
    in let won = new-count >= ms-safe-count
    in let st2 = MinesweeperState { mine-grid = st.mine-grid, revealed = new-rev, adjacent = st.adjacent, cells-revealed = new-count, mines-hit = st.mines-hit, safe-cells = st.safe-cells, game-over = won, won = won, moves = st.moves + 1, rng = st.rng }
    in if adj-count == 0 then ms-flood-fill st2 idx
    else st2

  ms-flood-fill : MinesweeperState, Integer -> MinesweeperState
  ms-flood-fill (st) (idx) =
    let row = idx / 9
    in let col = idx - row * 9
    in let st1 = ms-reveal-neighbor st row col (-1) (-1)
    in let st2 = ms-reveal-neighbor st1 row col (-1) 0
    in let st3 = ms-reveal-neighbor st2 row col (-1) 1
    in let st4 = ms-reveal-neighbor st3 row col 0 (-1)
    in let st5 = ms-reveal-neighbor st4 row col 0 1
    in let st6 = ms-reveal-neighbor st5 row col 1 (-1)
    in let st7 = ms-reveal-neighbor st6 row col 1 0
    in ms-reveal-neighbor st7 row col 1 1

  ms-reveal-neighbor : MinesweeperState, Integer, Integer, Integer, Integer -> MinesweeperState
  ms-reveal-neighbor (st) (row) (col) (dr) (dc) =
    let r2 = row + dr
    in let c2 = col + dc
    in if r2 < 0 then st
    else if r2 >= 9 then st
    else if c2 < 0 then st
    else if c2 >= 9 then st
    else ms-reveal st (r2 * 9 + c2)

Section: AI

  ms-ai-pick : MinesweeperState -> Integer
  ms-ai-pick (st) =
    let safe = ms-find-safe (st.adjacent) (st.revealed) 0
    in if safe >= 0 then safe
    else ms-find-hidden (st.revealed) 0

  ms-find-safe : List Integer, List Integer, Integer -> Integer
  ms-find-safe (adj) (revealed) (i) =
    if i >= 81 then -1
    else if list-at revealed i /= 0 then ms-find-safe adj revealed (i + 1)
    else if list-at adj i == 0 then i
    else ms-find-safe adj revealed (i + 1)

  ms-find-hidden : List Integer, Integer -> Integer
  ms-find-hidden (revealed) (i) =
    if i >= 81 then -1
    else if list-at revealed i == 0 then i
    else ms-find-hidden revealed (i + 1)

  ms-all-revealed : MinesweeperState -> Boolean
  ms-all-revealed (st) =
    st.cells-revealed >= ms-safe-count

Section: Game Runner

  run-minesweeper-game : MinesweeperResult
  run-minesweeper-game =
    let rng = rng-new 33
    in let st = ms-new rng
    in ms-loop st

  ms-loop : MinesweeperState -> MinesweeperResult
  ms-loop (st) =
    if st.game-over then MinesweeperResult { won = st.won, cells-revealed = st.cells-revealed, mines-hit = st.mines-hit, moves = st.moves }
    else if st.moves > 90 then MinesweeperResult { won = False, cells-revealed = st.cells-revealed, mines-hit = st.mines-hit, moves = st.moves }
    else let idx = ms-ai-pick st
    in if idx < 0 then MinesweeperResult { won = st.won, cells-revealed = st.cells-revealed, mines-hit = st.mines-hit, moves = st.moves }
    else let next = ms-reveal st idx
    in ms-loop next

Section: Formatting

  format-minesweeper-result : MinesweeperResult -> Text
  format-minesweeper-result (r) =
    let outcome = if r.won then "Solved" else "Hit mine"
    in "Minesweeper: " & outcome & " revealed=" & show (r.cells-revealed) & " mines-hit=" & show (r.mines-hit) & " moves=" & show (r.moves)

Page 1


Chapter: Games--TicTacToe
  cites Games chapter Rng

 Tic-tac-toe on a 3x3 board with minimax AI that plays perfectly.
 Board is a List Integer of 9 cells: 0=empty, 1=X, 2=O.
 Player 1 is X (maximizer), player 2 is O (minimizer).

 We say:

Section: Types

  TttBoard = record {
    squares       : List Integer,
    current-player : Integer,
    game-over     : Boolean,
    winner        : Integer
  }

  TttResult = record {
    winner     : Integer,
    moves-made : Integer
  }

Section: Construction

  ttt-new : TttBoard
  ttt-new =
    let sq = ttt-build-board 0 []
    in TttBoard { squares = sq, current-player = 1, game-over = False, winner = 0 }

  ttt-build-board : Integer, List Integer -> List Integer
  ttt-build-board (i) (acc) =
    if i >= 9 then acc
    else ttt-build-board (i + 1) (list-push acc 0)

Section: Board Queries

  ttt-cell : TttBoard, Integer -> Integer
  ttt-cell (b) (i) = list-at (b.squares) i

  ttt-empty : TttBoard, Integer -> Boolean
  ttt-empty (b) (i) = ttt-cell b i == 0

  ttt-has-empty : TttBoard -> Boolean
  ttt-has-empty (b) = ttt-any-empty (b.squares) 0

  ttt-any-empty : List Integer, Integer -> Boolean
  ttt-any-empty (sq) (i) =
    if i >= 9 then False
    else if list-at sq i == 0 then True
    else ttt-any-empty sq (i + 1)

Section: Move and Win

  ttt-move : TttBoard, Integer -> TttBoard
  ttt-move (b) (pos) =
    if b.game-over then b
    else if ttt-empty b pos == False then b
    else let sq2 = list-set-at (b.squares) pos (b.current-player)
    in let won = ttt-check-win sq2 (b.current-player)
    in let has-space = ttt-any-empty sq2 0
    in let draw = if won then False else has-space == False
    in let over = if won then True else draw
    in let win = if won then b.current-player else 0
    in let next = if over then b.current-player else if b.current-player == 1 then 2 else 1
    in TttBoard { squares = sq2, current-player = next, game-over = over, winner = win }

  ttt-check-win : List Integer, Integer -> Boolean
  ttt-check-win (sq) (p) =
    let r0 = ttt-line sq p 0 1 2
    in let r1 = ttt-line sq p 3 4 5
    in let r2 = ttt-line sq p 6 7 8
    in let c0 = ttt-line sq p 0 3 6
    in let c1 = ttt-line sq p 1 4 7
    in let c2 = ttt-line sq p 2 5 8
    in let d0 = ttt-line sq p 0 4 8
    in let d1 = ttt-line sq p 2 4 6
    in r0 | r1 | r2 | c0 | c1 | c2 | d0 | d1

  ttt-line : List Integer, Integer, Integer, Integer, Integer -> Boolean
  ttt-line (sq) (p) (a) (b) (c) =
    list-at sq a == p & list-at sq b == p & list-at sq c == p

Section: AI

  ttt-ai-move : TttBoard -> Integer
  ttt-ai-move (b) =
    let center = if ttt-empty b 4 then 4 else -1
    in if center >= 0 then center
    else let corner = ttt-find-empty-corner b
    in if corner >= 0 then corner
    else ttt-find-first-empty b 0

  ttt-find-empty-corner : TttBoard -> Integer
  ttt-find-empty-corner (b) =
    if ttt-empty b 0 then 0
    else if ttt-empty b 2 then 2
    else if ttt-empty b 6 then 6
    else if ttt-empty b 8 then 8
    else -1

  ttt-find-first-empty : TttBoard, Integer -> Integer
  ttt-find-first-empty (b) (i) =
    if i >= 9 then -1
    else if ttt-empty b i then i
    else ttt-find-first-empty b (i + 1)

Section: Game Runner

  run-ttt-game : TttResult
  run-ttt-game =
    let b = ttt-new
    in ttt-loop b 0

  ttt-loop : TttBoard, Integer -> TttResult
  ttt-loop (b) (moves) =
    if b.game-over then TttResult { winner = b.winner, moves-made = moves }
    else if moves > 9 then TttResult { winner = b.winner, moves-made = moves }
    else let pos = ttt-ai-move b
    in if pos < 0 then TttResult { winner = b.winner, moves-made = moves }
    else let next = ttt-move b pos
    in ttt-loop next (moves + 1)

Section: Formatting

  format-ttt-result : TttResult -> Text
  format-ttt-result (r) =
    let w = if r.winner == 1 then "X wins"
            else if r.winner == 2 then "O wins"
            else "Draw"
    in "TicTacToe (AI vs AI): " & w & " in " & show (r.moves-made) & " moves"

