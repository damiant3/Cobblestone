Chapter: Encode--Json
  cites Foreword chapter Maybe
  cites Foreword chapter CCE

 Minimal JSON value representation, emitter, and parser.
 Supports null, booleans, integers, strings, arrays, and objects.
 Objects are lists of key-value pairs (preserves insertion order).

 We say:

Section: Value Type
  JsonValue =
    | JsonNull
    | JsonBool (Boolean)
    | JsonInt (Integer)
    | JsonStr (Text)
    | JsonArray (List JsonValue)
    | JsonObject (List JsonPair)

  JsonPair = record {
    key : Text,
    value : JsonValue
  }

Section: Constructors
  json-null : JsonValue = JsonNull

  json-bool : Boolean -> JsonValue
  json-bool (b) = JsonBool b

  json-int : Integer -> JsonValue
  json-int (n) = JsonInt n

  json-str : Text -> JsonValue
  json-str (s) = JsonStr s

  json-array : List JsonValue -> JsonValue
  json-array (items) = JsonArray items

  json-object : List JsonPair -> JsonValue
  json-object (pairs) = JsonObject pairs

  json-pair : Text, JsonValue -> JsonPair
  json-pair (k) (v) = JsonPair { key = k, value = v }

Section: Emitter
  json-emit : JsonValue -> Text
  json-emit (v) = when v
    is JsonNull -> "null"
    is JsonBool (b) -> if b then "true" else "false"
    is JsonInt (n) -> show n
    is JsonStr (s) -> json-quote s
    is JsonArray (items) -> "[" & json-emit-array items 0 (list-length items) "" & "]"
    is JsonObject (pairs) -> "{" & json-emit-object pairs 0 (list-length pairs) "" & "}"

  json-quote : Text -> Text
  json-quote (s) = "\"" & json-escape s 0 (text-length s) "" & "\""

  json-escape : Text, Integer, Integer, Text -> Text
  json-escape (s) (i) (len) (acc) =
    if i >= len then acc
    else let c = char-code (char-at s i)
    in let u = to-unicode c
    in if u == 34 then json-escape s (i + 1) len (acc & "\\\"")
    else if u == 92 then json-escape s (i + 1) len (acc & "\\\\")
    else if u == 10 then json-escape s (i + 1) len (acc & "\\n")
    else if u == 13 then json-escape s (i + 1) len (acc & "\\r")
    else if u == 9 then json-escape s (i + 1) len (acc & "\\t")
    else json-escape s (i + 1) len (acc & char-to-text (char-at s i))

  json-emit-array : List JsonValue, Integer, Integer, Text -> Text
  json-emit-array (items) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in json-emit-array items (i + 1) len (acc & sep & json-emit (list-at items i))

  json-emit-object : List JsonPair, Integer, Integer, Text -> Text
  json-emit-object (pairs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let p = list-at pairs i
    in json-emit-object pairs (i + 1) len (acc & sep & json-quote (p.key) & ":" & json-emit (p.value))

Section: Object Access
  json-get : JsonValue, Text -> Maybe JsonValue
  json-get (v) (key) = when v
    is JsonObject (pairs) -> json-find-key pairs key 0 (list-length pairs)
    is otherwise -> None

  json-find-key : List JsonPair, Text, Integer, Integer -> Maybe JsonValue
  json-find-key (pairs) (key) (i) (len) =
    if i >= len then None
    else let p = list-at pairs i
    in if p.key == key then Just (p.value)
    else json-find-key pairs key (i + 1) len

  json-get-str : JsonValue, Text, Text -> Text
  json-get-str (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonStr (s) -> s
        is otherwise -> default-val
      is None -> default-val

  json-get-int : JsonValue, Text, Integer -> Integer
  json-get-int (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonInt (n) -> n
        is otherwise -> default-val
      is None -> default-val

  json-get-bool : JsonValue, Text, Boolean -> Boolean
  json-get-bool (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonBool (b) -> b
        is otherwise -> default-val
      is None -> default-val

Section: Array Access
  json-array-length : JsonValue -> Integer
  json-array-length (v) = when v
    is JsonArray (items) -> list-length items
    is otherwise -> 0

  json-array-at : JsonValue, Integer -> Maybe JsonValue
  json-array-at (v) (i) = when v
    is JsonArray (items) ->
      if i < 0 then None
      else if i >= list-length items then None
      else Just (list-at items i)
    is otherwise -> None

Section: Parser

 Recursive-descent JSON parser. Total: malformed input yields
 None, never crashes the caller. Handles null, booleans, integer
 numbers, double-quoted strings with the standard escapes
 (\" \\ \/ \b \f \n \r \t \uXXXX), arrays, and objects.
 Whitespace tolerant per RFC 8259.

  JsonParseResult = record {
    value : JsonValue,
    next : Integer,
    ok : Boolean
  }

  parse-fail : Integer -> JsonParseResult
  parse-fail (at) = JsonParseResult { value = JsonNull, next = at, ok = False }

  parse-ok : JsonValue, Integer -> JsonParseResult
  parse-ok (v) (next) = JsonParseResult { value = v, next = next, ok = True }

  json-parse : Text -> Maybe JsonValue
  json-parse (s) =
    let r = json-parse-value s 0 (text-length s)
    in if r.ok then Just (r.value) else None

Section: Whitespace and Codepoints

 All character comparisons go through to-unicode so the parser
 is correct on the CCE-internal source. The JSON syntax tokens
 are all ASCII, where CCE and Unicode agree, but using
 to-unicode keeps the convention consistent with json-escape.

  cp-at : Text, Integer -> Integer
  cp-at (s) (i) = to-unicode (char-code (char-at s i))

  is-ws : Integer -> Boolean
  is-ws (cp) =
    if cp == 32 then True
    else if cp == 9 then True
    else if cp == 10 then True
    else if cp == 13 then True
    else False

  skip-ws : Text, Integer, Integer -> Integer
  skip-ws (s) (i) (len) =
    if i >= len then i
    else if is-ws (cp-at s i) then skip-ws s (i + 1) len
    else i

  is-digit : Integer -> Boolean
  is-digit (cp) = if cp >= 48 then if cp <= 57 then True else False else False

  is-hex-digit : Integer -> Boolean
  is-hex-digit (cp) =
    if is-digit cp then True
    else if cp >= 65 then if cp <= 70 then True
      else if cp >= 97 then if cp <= 102 then True else False
      else False
    else if cp >= 97 then if cp <= 102 then True else False
    else False

  hex-digit-value : Integer -> Integer
  hex-digit-value (cp) =
    if is-digit cp then cp - 48
    else if cp >= 97 then cp - 87
    else cp - 55

Section: Value Dispatch

  json-parse-value : Text, Integer, Integer -> JsonParseResult
  json-parse-value (s) (i) (len) =
    let p = skip-ws s i len
    in if p >= len then parse-fail p
    else dispatch-on-first s p len (cp-at s p)

  dispatch-on-first : Text, Integer, Integer, Integer -> JsonParseResult
  dispatch-on-first (s) (i) (len) (cp) =
    if cp == 110 then json-parse-null s i len
    else if cp == 116 then json-parse-true s i len
    else if cp == 102 then json-parse-false s i len
    else if cp == 34 then json-parse-string-value s i len
    else if cp == 91 then json-parse-array s i len
    else if cp == 123 then json-parse-object s i len
    else if cp == 45 then json-parse-number s i len
    else if is-digit cp then json-parse-number s i len
    else parse-fail i

Section: Literal Keywords

  match-keyword : Text, Integer, Integer, Text -> Boolean
  match-keyword (s) (i) (len) (kw) =
    let kn = text-length kw
    in if i + kn > len then False
    else substring s i kn == kw

  json-parse-null : Text, Integer, Integer -> JsonParseResult
  json-parse-null (s) (i) (len) =
    if match-keyword s i len "null" then parse-ok JsonNull (i + 4)
    else parse-fail i

  json-parse-true : Text, Integer, Integer -> JsonParseResult
  json-parse-true (s) (i) (len) =
    if match-keyword s i len "true" then parse-ok (JsonBool True) (i + 4)
    else parse-fail i

  json-parse-false : Text, Integer, Integer -> JsonParseResult
  json-parse-false (s) (i) (len) =
    if match-keyword s i len "false" then parse-ok (JsonBool False) (i + 5)
    else parse-fail i

Section: Numbers

 Integers only. Optional leading minus, then one-or-more digits.
 Decimal points and exponents are rejected — the existing
 JsonInt is integer-typed.

  json-parse-number : Text, Integer, Integer -> JsonParseResult
  json-parse-number (s) (i) (len) =
    let neg = is-minus s i len
    in let start = if neg then i + 1 else i
    in let stop = scan-digits s start len
    in if stop == start then parse-fail i
    else parse-ok (JsonInt (digits-to-int s start stop neg 0)) stop

  is-minus : Text, Integer, Integer -> Boolean
  is-minus (s) (i) (len) =
    if i >= len then False
    else cp-at s i == 45

  scan-digits : Text, Integer, Integer -> Integer
  scan-digits (s) (i) (len) =
    if i >= len then i
    else if is-digit (cp-at s i) then scan-digits s (i + 1) len
    else i

  digits-to-int : Text, Integer, Integer, Boolean, Integer -> Integer
  digits-to-int (s) (i) (stop) (neg) (acc) =
    if i >= stop then if neg then 0 - acc else acc
    else digits-to-int s (i + 1) stop neg (acc * 10 + (cp-at s i - 48))

Section: Strings

 Double-quoted, with the standard JSON escapes. \uXXXX yields
 the codepoint converted back to CCE via from-unicode.

  json-parse-string-value : Text, Integer, Integer -> JsonParseResult
  json-parse-string-value (s) (i) (len) =
    let r = read-string-body s (i + 1) len ""
    in if r.ok then parse-ok (JsonStr (r.value-text)) (r.next)
    else parse-fail i

  StringReadResult = record {
    value-text : Text,
    next : Integer,
    ok : Boolean
  }

  string-fail : Integer -> StringReadResult
  string-fail (at) = StringReadResult { value-text = "", next = at, ok = False }

  string-ok : Text, Integer -> StringReadResult
  string-ok (t) (n) = StringReadResult { value-text = t, next = n, ok = True }

  read-string-body : Text, Integer, Integer, Text -> StringReadResult
  read-string-body (s) (i) (len) (acc) =
    if i >= len then string-fail i
    else read-string-step s i len acc (cp-at s i)

  read-string-step : Text, Integer, Integer, Text, Integer -> StringReadResult
  read-string-step (s) (i) (len) (acc) (cp) =
    if cp == 34 then string-ok acc (i + 1)
    else if cp == 92 then read-string-escape s (i + 1) len acc
    else read-string-body s (i + 1) len (acc & char-to-text (char-at s i))

  read-string-escape : Text, Integer, Integer, Text -> StringReadResult
  read-string-escape (s) (i) (len) (acc) =
    if i >= len then string-fail i
    else apply-escape s i len acc (cp-at s i)

  apply-escape : Text, Integer, Integer, Text, Integer -> StringReadResult
  apply-escape (s) (i) (len) (acc) (cp) =
    if cp == 34 then read-string-body s (i + 1) len (acc & "\"")
    else if cp == 92 then read-string-body s (i + 1) len (acc & "\\")
    else if cp == 47 then read-string-body s (i + 1) len (acc & "/")
    else if cp == 98 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 8)))
    else if cp == 102 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 12)))
    else if cp == 110 then read-string-body s (i + 1) len (acc & "\n")
    else if cp == 114 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 13)))
    else if cp == 116 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 9)))
    else if cp == 117 then read-unicode-escape s (i + 1) len acc
    else string-fail i

  read-unicode-escape : Text, Integer, Integer, Text -> StringReadResult
  read-unicode-escape (s) (i) (len) (acc) =
    if i + 4 > len then string-fail i
    else if four-hex-digits s i then
      let cp = unicode-from-hex-quad s i
      in read-string-body s (i + 4) len (acc & char-to-text (code-to-char (from-unicode cp)))
    else string-fail i

  four-hex-digits : Text, Integer -> Boolean
  four-hex-digits (s) (i) =
    if is-hex-digit (cp-at s i) == False then False
    else if is-hex-digit (cp-at s (i + 1)) == False then False
    else if is-hex-digit (cp-at s (i + 2)) == False then False
    else if is-hex-digit (cp-at s (i + 3)) == False then False
    else True

  unicode-from-hex-quad : Text, Integer -> Integer
  unicode-from-hex-quad (s) (i) =
    hex-digit-value (cp-at s i) * 4096
    + hex-digit-value (cp-at s (i + 1)) * 256
    + hex-digit-value (cp-at s (i + 2)) * 16
    + hex-digit-value (cp-at s (i + 3))

Section: Arrays

  json-parse-array : Text, Integer, Integer -> JsonParseResult
  json-parse-array (s) (i) (len) =
    let p = skip-ws s (i + 1) len
    in if p >= len then parse-fail i
    else if cp-at s p == 93 then parse-ok (JsonArray []) (p + 1)
    else read-array-items s p len []

  read-array-items : Text, Integer, Integer, List JsonValue -> JsonParseResult
  read-array-items (s) (i) (len) (acc) =
    let r = json-parse-value s i len
    in if r.ok == False then parse-fail i
    else array-after-item s (skip-ws s (r.next) len) len (list-snoc acc (r.value))

  array-after-item : Text, Integer, Integer, List JsonValue -> JsonParseResult
  array-after-item (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 93 then parse-ok (JsonArray acc) (i + 1)
    else if cp-at s i == 44 then read-array-items s (skip-ws s (i + 1) len) len acc
    else parse-fail i

Section: Objects

  json-parse-object : Text, Integer, Integer -> JsonParseResult
  json-parse-object (s) (i) (len) =
    let p = skip-ws s (i + 1) len
    in if p >= len then parse-fail i
    else if cp-at s p == 125 then parse-ok (JsonObject []) (p + 1)
    else read-object-pairs s p len []

  read-object-pairs : Text, Integer, Integer, List JsonPair -> JsonParseResult
  read-object-pairs (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 34 then read-object-key-value s i len acc
    else parse-fail i

  read-object-key-value : Text, Integer, Integer, List JsonPair -> JsonParseResult
  read-object-key-value (s) (i) (len) (acc) =
    let kr = read-string-body s (i + 1) len ""
    in if kr.ok == False then parse-fail i
    else expect-colon-then-value s (skip-ws s (kr.next) len) len acc (kr.value-text)

  expect-colon-then-value : Text, Integer, Integer, List JsonPair, Text -> JsonParseResult
  expect-colon-then-value (s) (i) (len) (acc) (key) =
    if i >= len then parse-fail i
    else if cp-at s i == 58 then read-object-value s (skip-ws s (i + 1) len) len acc key
    else parse-fail i

  read-object-value : Text, Integer, Integer, List JsonPair, Text -> JsonParseResult
  read-object-value (s) (i) (len) (acc) (key) =
    let r = json-parse-value s i len
    in if r.ok == False then parse-fail i
    else object-after-value s (skip-ws s (r.next) len) len (list-snoc acc (json-pair key (r.value)))

  object-after-value : Text, Integer, Integer, List JsonPair -> JsonParseResult
  object-after-value (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 125 then parse-ok (JsonObject acc) (i + 1)
    else if cp-at s i == 44 then read-object-pairs s (skip-ws s (i + 1) len) len acc
    else parse-fail i

Page 1


Chapter: Games--HexWar
  cites Games chapter Rng

 Hex-and-counter wargame engine in the Avalon Hill tradition.
 Covers Panzerblitz, Squad Leader, Stalingrad, Afrika Korps, and any
 similar game. Everything is data-driven: terrain costs, unit stats,
 and the CRT are all lookup tables. A new scenario is a new config
 record, not new code.

 Axial hex coordinates. Terrain encoded as integers 0-9. Unit types
 encoded as integers 0-9. Combat results encoded as integers 0-4:
 0=AE (attacker eliminated), 1=AR (attacker retreat), 2=EX (exchange),
 3=DR (defender retreat), 4=DE (defender eliminated).

 We say:

Section: Hex Grid

  HexCoord = record {
    q : Integer,
    r : Integer
  }

  hex-distance : HexCoord, HexCoord -> Integer
  hex-distance (a) (b) =
    let dq = a.q - b.q
    in let dr = a.r - b.r
    in let ds = dq + dr
    in let aq = if dq < 0 then -dq else dq
    in let ar = if dr < 0 then -dr else dr
    in let as = if ds < 0 then -ds else ds
    in let sum = aq + ar + as
    in sum / 2

  hex-neighbor-q : Integer, Integer -> Integer
  hex-neighbor-q (dir) (q) =
    if dir == 0 then q + 1
    else if dir == 1 then q + 1
    else if dir == 2 then q
    else if dir == 3 then q - 1
    else if dir == 4 then q - 1
    else q

  hex-neighbor-r : Integer, Integer -> Integer
  hex-neighbor-r (dir) (r) =
    if dir == 0 then r
    else if dir == 1 then r - 1
    else if dir == 2 then r - 1
    else if dir == 3 then r
    else if dir == 4 then r + 1
    else r + 1

  hex-neighbors : HexCoord -> List HexCoord
  hex-neighbors (h) =
    hex-neighbors-loop h 0 []

  hex-neighbors-loop : HexCoord, Integer, List HexCoord -> List HexCoord
  hex-neighbors-loop (h) (dir) (acc) =
    if dir >= 6 then acc
    else let nq = hex-neighbor-q dir h.q
    in let nr = hex-neighbor-r dir h.r
    in hex-neighbors-loop h (dir + 1) (list-push acc (HexCoord { q = nq, r = nr }))

  hex-valid : HexCoord, Integer, Integer -> Boolean
  hex-valid (h) (width) (height) =
    h.q >= 0 & h.q < width & h.r >= 0 & h.r < height

  hex-index : HexCoord, Integer -> Integer
  hex-index (h) (width) = h.r * width + h.q

  hex-from-index : Integer, Integer -> HexCoord
  hex-from-index (idx) (width) =
    HexCoord { q = rng-mod idx width, r = idx / width }

Section: Terrain System

 TerrainType integers: 0=Clear, 1=Forest, 2=Hill, 3=Mountain,
 4=River, 5=Road, 6=City, 7=Marsh, 8=Desert, 9=Ocean.

  TerrainHex = record {
    terrain      : Integer,
    elevation    : Integer,
    fortified    : Boolean,
    victory-point : Boolean
  }

 Movement cost table: 10 terrain types x 3 unit categories
 (0=foot/infantry, 1=armor/mech, 2=all). Encoded as flat list
 of length 30, indexed by terrain*3 + unit-category.
 Value 99 means impassable.

  terrain-move-cost : List Integer
  terrain-move-cost =
    list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    [] 1) 1) 1)
       2) 3) 99)
       2) 2) 2)
       3) 99) 99)
       2) 3) 99)
       1) 1) 1)
       2) 2) 2)
       3) 99) 99)
       1) 2) 1)
       99) 99) 99)

  terrain-defense-bonus : List Integer
  terrain-defense-bonus =
    list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    [] 0) 1) 1) 2) 0) 0) 2) 1) 0) 99)

  get-move-cost : Integer, Integer -> Integer
  get-move-cost (terrain) (unit-cat) =
    list-at terrain-move-cost (terrain * 3 + unit-cat)

  get-defense-bonus : Integer -> Integer
  get-defense-bonus (terrain) =
    list-at terrain-defense-bonus terrain

  unit-category : Integer -> Integer
  unit-category (type-id) =
    if type-id == 0 then 0
    else if type-id == 1 then 1
    else if type-id == 2 then 0
    else if type-id == 3 then 1
    else if type-id == 4 then 0
    else if type-id == 5 then 0
    else if type-id == 6 then 1
    else if type-id == 7 then 1
    else if type-id == 8 then 0
    else 2

Section: Unit System

 UnitType integers: 0=Infantry, 1=Armor, 2=Artillery, 3=Mechanized,
 4=Cavalry, 5=HQ, 6=AntiTank, 7=AntiAir, 8=Engineer, 9=Supply.

  Unit = record {
    id           : Integer,
    type-id      : Integer,
    owner        : Integer,
    q            : Integer,
    r            : Integer,
    strength     : Integer,
    max-strength : Integer,
    movement     : Integer,
    max-movement : Integer,
    attack       : Integer,
    defense      : Integer,
    range        : Integer,
    experience   : Integer,
    disrupted    : Boolean,
    eliminated   : Boolean,
    has-moved    : Boolean,
    has-attacked : Boolean
  }

 Unit stats table: 10 types x 6 stats (attack, defense, move, range,
 max-strength, category). Flat list of 60 entries.

  unit-stats-table : List Integer
  unit-stats-table =
    list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    [] 3) 3) 4) 1) 6) 0)
       6) 4) 6) 1) 4) 1)
       4) 2) 3) 3) 4) 0)
       5) 4) 5) 1) 4) 1)
       3) 3) 6) 1) 4) 0)
       1) 1) 3) 1) 2) 0)
       5) 4) 4) 1) 4) 1)
       3) 5) 4) 1) 4) 1)
       3) 3) 4) 1) 4) 0)
       1) 1) 4) 1) 2) 2)

  unit-stat : Integer, Integer -> Integer
  unit-stat (type-id) (stat) =
    list-at unit-stats-table (type-id * 6 + stat)

  make-unit : Integer, Integer, Integer, Integer, Integer -> Unit
  make-unit (id) (type-id) (owner) (q) (r) =
    let atk = unit-stat type-id 0
    in let def = unit-stat type-id 1
    in let mov = unit-stat type-id 2
    in let rng = unit-stat type-id 3
    in let str = unit-stat type-id 4
    in Unit {
         id = id, type-id = type-id, owner = owner,
         q = q, r = r,
         strength = str, max-strength = str,
         movement = mov, max-movement = mov,
         attack = atk, defense = def, range = rng,
         experience = 0,
         disrupted = False, eliminated = False,
         has-moved = False, has-attacked = False
       }

  hex-unit-count : List Unit, Integer, Integer -> Integer
  hex-unit-count (units) (q) (r) =
    hex-unit-count-loop units q r 0 0

  hex-unit-count-loop : List Unit, Integer, Integer, Integer, Integer -> Integer
  hex-unit-count-loop (units) (q) (r) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let here = if u.q == q & u.r == r & u.eliminated == False then 1 else 0
    in hex-unit-count-loop units q r (i + 1) (acc + here)

Section: Combat Resolution

 CRT encoded as flat list. Odds columns: 0=1:3, 1=1:2, 2=1:1,
 3=2:1, 4=3:1, 5=4:1, 6=5:1+. Die rows 1-6, 6 columns each.
 Results: 0=AE, 1=AR, 2=EX, 3=DR, 4=DE.

  crt-table : List Integer
  crt-table =
    list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push
    (list-push (list-push
    [] 0) 0) 1) 1) 2) 3)
       0) 1) 1) 2) 3) 3)
       1) 1) 2) 3) 3) 4)
       1) 1) 2) 3) 4) 4)
       1) 2) 3) 3) 4) 4)
       2) 2) 3) 4) 4) 4)
       2) 3) 3) 4) 4) 4)

  crt-lookup : Integer, Integer -> Integer
  crt-lookup (die) (col) =
    let row = die - 1
    in list-at crt-table (row * 6 + col)

  calc-odds-col : Integer, Integer -> Integer
  calc-odds-col (atk) (def) =
    if def <= 0 then 5
    else let ratio = atk / def
    in if ratio == 0 then
         if atk * 2 <= def then 0 else 1
       else if ratio >= 4 then 5
       else if ratio >= 3 then 4
       else if ratio >= 2 then 3
       else 2

  apply-column-shifts : Integer, Integer -> Integer
  apply-column-shifts (col) (shifts) =
    let shifted = col + shifts
    in if shifted < 0 then 0
    else if shifted > 5 then 5
    else shifted

  combat-result : Integer, Integer, Integer, Integer -> Integer
  combat-result (atk-str) (def-str) (terrain-bonus) (die) =
    let base-col = calc-odds-col atk-str def-str
    in let shifted = apply-column-shifts base-col (-terrain-bonus)
    in crt-lookup die shifted

  artillery-support : List Unit, Integer, Integer, Integer -> Integer
  artillery-support (units) (target-q) (target-r) (owner) =
    arty-support-loop units target-q target-r owner 0 0

  arty-support-loop : List Unit, Integer, Integer, Integer, Integer, Integer -> Integer
  arty-support-loop (units) (tq) (tr) (owner) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let is-arty = if u.type-id == 2 & u.owner == owner & u.eliminated == False & u.has-attacked == False then 1 else 0
    in let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = tq, r = tr })
    in let in-range = if dist <= u.range & dist > 1 then 1 else 0
    in let contrib = is-arty * in-range * u.strength
    in arty-support-loop units tq tr owner (i + 1) (acc + contrib)

Section: Movement System

  can-enter-hex : Integer, Integer, List TerrainHex, Integer, Integer -> Boolean
  can-enter-hex (q) (r) (terrain-data) (width) (type-id) =
    let idx = r * width + q
    in let th = list-at terrain-data idx
    in let cat = unit-category type-id
    in let cost = get-move-cost th.terrain cat
    in cost < 99

  hex-move-cost : Integer, Integer, List TerrainHex, Integer, Integer -> Integer
  hex-move-cost (q) (r) (terrain-data) (width) (type-id) =
    let idx = r * width + q
    in let th = list-at terrain-data idx
    in let cat = unit-category type-id
    in let base = get-move-cost th.terrain cat
    in let road-bonus = if th.terrain == 5 then (-1) else 0
    in let adjusted = base + road-bonus
    in if adjusted < 1 then 1 else adjusted

  in-enemy-zoc : HexCoord, List Unit, Integer -> Boolean
  in-enemy-zoc (h) (units) (owner) =
    zoc-check-loop h units owner 0

  zoc-check-loop : HexCoord, List Unit, Integer, Integer -> Boolean
  zoc-check-loop (h) (units) (owner) (i) =
    if i >= list-length units then False
    else let u = list-at units i
    in if u.owner == owner then zoc-check-loop h units owner (i + 1)
    else if u.eliminated then zoc-check-loop h units owner (i + 1)
    else let ud = hex-distance h (HexCoord { q = u.q, r = u.r })
    in if ud <= 1 then True
    else zoc-check-loop h units owner (i + 1)

  zoc-move-penalty : HexCoord, List Unit, Integer -> Integer
  zoc-move-penalty (h) (units) (owner) =
    if in-enemy-zoc h units owner then 2 else 0

  can-move-to : Unit, Integer, Integer, List TerrainHex, List Unit, Integer -> Boolean
  can-move-to (u) (tq) (tr) (terrain-data) (units) (width) =
    let cost = hex-move-cost tq tr terrain-data width u.type-id
    in let penalty = zoc-move-penalty (HexCoord { q = tq, r = tr }) units u.owner
    in let total = cost + penalty
    in u.movement >= total & can-enter-hex tq tr terrain-data width u.type-id

  spend-movement : Unit, Integer, Integer, List TerrainHex, List Unit, Integer -> Unit
  spend-movement (u) (tq) (tr) (terrain-data) (units) (width) =
    let cost = hex-move-cost tq tr terrain-data width u.type-id
    in let penalty = zoc-move-penalty (HexCoord { q = tq, r = tr }) units u.owner
    in let total = cost + penalty
    in __record-set (__record-set (__record-set u "q" tq) "r" tr) "movement" (u.movement - total)

Section: Supply System

  is-supply-source : Integer, Integer, Integer, Integer, Integer -> Boolean
  is-supply-source (q) (r) (owner) (map-width) (map-height) =
    if owner == 0 then q == 0
    else q == map-width - 1

  trace-supply-loop : HexCoord, List Unit, Integer, Integer, Integer, Integer -> Boolean
  trace-supply-loop (h) (units) (owner) (width) (height) (fuel) =
    if fuel <= 0 then False
    else if is-supply-source h.q h.r owner width height then True
    else let blocked = in-enemy-zoc h units owner
    in if blocked then False
    else trace-supply-neighbor h units owner width height fuel 0

  trace-supply-neighbor : HexCoord, List Unit, Integer, Integer, Integer, Integer, Integer -> Boolean
  trace-supply-neighbor (h) (units) (owner) (width) (height) (fuel) (dir) =
    if dir >= 6 then False
    else let nq = hex-neighbor-q dir h.q
    in let nr = hex-neighbor-r dir h.r
    in let nh = HexCoord { q = nq, r = nr }
    in if hex-valid nh width height == False then trace-supply-neighbor h units owner width height fuel (dir + 1)
    else if trace-supply-loop nh units owner width height (fuel - 1) then True
    else trace-supply-neighbor h units owner width height fuel (dir + 1)

  unit-in-supply : Unit, List Unit, Integer, Integer -> Boolean
  unit-in-supply (u) (units) (width) (height) =
    let h = HexCoord { q = u.q, r = u.r }
    in trace-supply-loop h units u.owner width height 8

Section: Turn Structure

  Phase = record {
    number : Integer
  }

  phase-movement : Integer
  phase-movement = 0

  phase-combat : Integer
  phase-combat = 1

  phase-exploitation : Integer
  phase-exploitation = 2

  Turn = record {
    number        : Integer,
    phase         : Integer,
    active-player : Integer
  }

  advance-phase : Turn, Integer -> Turn
  advance-phase (t) (num-players) =
    if t.phase < 2 then
      Turn { number = t.number, phase = t.phase + 1, active-player = t.active-player }
    else let next-player = rng-mod (t.active-player + 1) num-players
    in let next-num = if next-player == 0 then t.number + 1 else t.number
    in Turn { number = next-num, phase = 0, active-player = next-player }

  reset-units-for-turn : List Unit -> List Unit
  reset-units-for-turn (units) =
    reset-units-loop units 0

  reset-units-loop : List Unit, Integer -> List Unit
  reset-units-loop (units) (i) =
    if i >= list-length units then units
    else let u = list-at units i
    in let u2 = __record-set (__record-set (__record-set u "has-moved" False) "has-attacked" False) "movement" u.max-movement
    in reset-units-loop (list-set-at units i u2) (i + 1)

Section: Game Configuration

  WargameConfig = record {
    map-width      : Integer,
    map-height     : Integer,
    num-players    : Integer,
    turn-limit     : Integer,
    stacking-limit : Integer,
    terrain-data   : List TerrainHex,
    unit-roster    : List Unit
  }

  flat-terrain : Integer, Integer -> List TerrainHex
  flat-terrain (w) (h) =
    flat-terrain-loop w h (w * h) 0 []

  flat-terrain-loop : Integer, Integer, Integer, Integer, List TerrainHex -> List TerrainHex
  flat-terrain-loop (w) (h) (total) (i) (acc) =
    if i >= total then acc
    else let th = TerrainHex { terrain = 0, elevation = 0, fortified = False, victory-point = False }
    in flat-terrain-loop w h total (i + 1) (list-push acc th)

  set-terrain-at : List TerrainHex, Integer, Integer, Integer, Integer, Integer, Boolean, Boolean -> List TerrainHex
  set-terrain-at (td) (width) (q) (r) (terr) (elev) (fort) (vp) =
    let idx = r * width + q
    in let th = TerrainHex { terrain = terr, elevation = elev, fortified = fort, victory-point = vp }
    in list-set-at td idx th

  scenario-stalingrad : WargameConfig
  scenario-stalingrad =
    let w = 20
    in let h = 15
    in let td0 = flat-terrain w h
    in let td1 = set-terrain-at td0 w 10 7 6 1 True True
    in let td2 = set-terrain-at td1 w 11 7 2 1 False True
    in let td3 = set-terrain-at td2 w 9 7 4 0 False False
    in let td4 = set-terrain-at td3 w 10 5 2 0 False False
    in let td5 = set-terrain-at td4 w 10 9 1 0 False False
    in let ru1 = make-unit 0 0 0 0 7
    in let ru2 = make-unit 1 1 0 1 7
    in let ru3 = make-unit 2 2 0 0 8
    in let ge1 = make-unit 3 0 1 19 7
    in let ge2 = make-unit 4 1 1 18 7
    in let ge3 = make-unit 5 6 1 19 8
    in let roster = list-push (list-push (list-push (list-push (list-push (list-push [] ru1) ru2) ru3) ge1) ge2) ge3
    in WargameConfig {
         map-width = w, map-height = h,
         num-players = 2, turn-limit = 20,
         stacking-limit = 3,
         terrain-data = td5,
         unit-roster = roster
       }

  scenario-normandy : WargameConfig
  scenario-normandy =
    let w = 15
    in let h = 12
    in let td0 = flat-terrain w h
    in let td1 = set-terrain-at td0 w 0 0 9 0 False False
    in let td2 = set-terrain-at td1 w 1 0 9 0 False False
    in let td3 = set-terrain-at td2 w 7 5 6 0 False True
    in let td4 = set-terrain-at td3 w 7 3 1 0 False False
    in let td5 = set-terrain-at td4 w 3 4 2 1 False False
    in let al1 = make-unit 0 0 0 0 11
    in let al2 = make-unit 1 3 0 1 11
    in let ax1 = make-unit 2 0 1 14 5
    in let ax2 = make-unit 3 1 1 13 5
    in let roster = list-push (list-push (list-push (list-push [] al1) al2) ax1) ax2
    in WargameConfig {
         map-width = w, map-height = h,
         num-players = 2, turn-limit = 12,
         stacking-limit = 2,
         terrain-data = td5,
         unit-roster = roster
       }

  scenario-bulge : WargameConfig
  scenario-bulge =
    let w = 18
    in let h = 14
    in let td0 = flat-terrain w h
    in let td1 = set-terrain-at td0 w 9 7 1 0 False True
    in let td2 = set-terrain-at td1 w 8 6 2 1 False False
    in let td3 = set-terrain-at td2 w 10 8 1 0 False False
    in let td4 = set-terrain-at td3 w 4 4 2 1 False True
    in let us1 = make-unit 0 0 0 0 7
    in let us2 = make-unit 1 6 0 1 7
    in let ge1 = make-unit 2 0 1 17 7
    in let ge2 = make-unit 3 1 1 16 7
    in let ge3 = make-unit 4 2 1 17 6
    in let roster = list-push (list-push (list-push (list-push (list-push [] us1) us2) ge1) ge2) ge3
    in WargameConfig {
         map-width = w, map-height = h,
         num-players = 2, turn-limit = 16,
         stacking-limit = 3,
         terrain-data = td4,
         unit-roster = roster
       }

  scenario-panzerblitz : WargameConfig
  scenario-panzerblitz =
    let w = 16
    in let h = 12
    in let td0 = flat-terrain w h
