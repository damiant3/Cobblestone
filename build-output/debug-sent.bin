Chapter: Games--Rng

 Deterministic PRNG for game simulations. LCG-based, same as CardGen.

 We say:

Section: Core

  Rng = record {
    state : Integer
  }

  rng-new : Integer -> Rng
  rng-new (seed) = Rng { state = seed }

  rng-next : Rng -> Rng
  rng-next (r) =
    let h = r.state * 1103515245 + 12345
    in let positive = if h < 0 then -h else h
    in Rng { state = positive }

  rng-value : Rng -> Integer
  rng-value (r) = r.state

  rng-range : Rng, Integer, Integer -> Integer
  rng-range (r) (lo) (hi) =
    let span = hi - lo + 1
    in lo + rng-mod (rng-value r) span

  rng-mod : Integer, Integer -> Integer
  rng-mod (val) (modulus) =
    if modulus <= 0 then 0
    else val - (val / modulus) * modulus

