Chapter: Games--CrazyEights
  cites Games chapter Rng

 Crazy Eights: standard 52-card deck, 2-4 players, 7 cards each.
 Card encoding: 0-51, rank = card mod 13 (0=2,1=3,...,6=8,...,12=A),
 suit = card / 13. Play a card matching the top discard's rank or suit.
 Eights (rank 6) are wild; player chooses new suit. Special: rank 0
 (2s) makes next player draw 2. First player to empty hand wins.
 AI plays matching non-eight first, then eight choosing most-held suit,
 then draws if forced.

 We say:

Section: Types

  CrazyEightsState = record {
    hands          : List Integer,
    hand-sizes     : List Integer,
    draw-pile      : List Integer,
    pile-size      : Integer,
    discard-rank   : Integer,
    discard-suit   : Integer,
    current-player : Integer,
    num-players    : Integer,
    direction      : Integer,
    draw-penalty   : Integer,
    game-over      : Boolean,
    winner         : Integer,
    declared-suit  : Integer
  }

  CrazyEightsResult = record {
    winner      : Integer,
    turns       : Integer,
    num-players : Integer
  }

Section: Card Helpers

  ce-rank : Integer -> Integer
  ce-rank (c) = rng-mod c 13

  ce-suit : Integer -> Integer
  ce-suit (c) = c / 13

Section: Deck

  ce-build-deck : Integer, List Integer -> List Integer
  ce-build-deck (i) (acc) =
    if i >= 52 then acc
    else ce-build-deck (i + 1) (list-push acc i)

  ce-shuffle : List Integer, Rng -> List Integer
  ce-shuffle (deck) (r) = ce-fy deck 51 r

  ce-fy : List Integer, Integer, Rng -> List Integer
  ce-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in ce-fy d3 (i - 1) r2

Section: Hand Storage

 Hands stored as flat list: num-players * 52 slots. Slot = player*52 + card-idx.

  ce-hand-has : CrazyEightsState, Integer, Integer -> Boolean
  ce-hand-has (s) (player) (card-idx) =
    list-at (s.hands) (player * 52 + card-idx) == 1

  ce-hand-set : CrazyEightsState, Integer, Integer, Integer -> CrazyEightsState
  ce-hand-set (s) (player) (card-idx) (val) =
    let slot = player * 52 + card-idx
    in let old = list-at (s.hands) slot
    in let delta = val - old
    in let new-hands = list-set-at (s.hands) slot val
    in let new-size = list-at (s.hand-sizes) player + delta
    in let new-sizes = list-set-at (s.hand-sizes) player new-size
    in CrazyEightsState {
         hands = new-hands,
         hand-sizes = new-sizes,
         draw-pile = s.draw-pile,
         pile-size = s.pile-size,
         discard-rank = s.discard-rank,
         discard-suit = s.discard-suit,
         current-player = s.current-player,
         num-players = s.num-players,
         direction = s.direction,
         draw-penalty = s.draw-penalty,
         game-over = s.game-over,
         winner = s.winner,
         declared-suit = s.declared-suit
       }

Section: Initialization

  ce-build-zeroes : Integer, Integer, List Integer -> List Integer
  ce-build-zeroes (i) (n) (acc) =
    if i >= n then acc
    else ce-build-zeroes (i + 1) n (list-push acc 0)

  ce-init : Integer, Integer -> CrazyEightsState
  ce-init (seed) (num-players) =
    let np = if num-players < 2 then 2 else if num-players > 4 then 4 else num-players
    in let deck = ce-shuffle (ce-build-deck 0 []) (rng-new seed)
    in let hand-slots = ce-build-zeroes 0 (np * 52) []
    in let sizes = ce-build-zeroes 0 np []
    in let pile-list = ce-build-zeroes 0 52 []
    in let s0 = CrazyEightsState {
         hands = hand-slots,
         hand-sizes = sizes,
         draw-pile = pile-list,
         pile-size = 0,
         discard-rank = 0,
         discard-suit = 0,
         current-player = 0,
         num-players = np,
         direction = 1,
         draw-penalty = 0,
         game-over = False,
         winner = 0,
         declared-suit = 0
       }
    in let s1 = ce-deal s0 deck 0 np 0
    in let top-card = list-at deck (7 * np)
    in let pile-start = 7 * np + 1
    in let s2 = ce-load-pile s1 deck pile-start 0 (52 - pile-start)
    in CrazyEightsState {
         hands = s2.hands,
         hand-sizes = s2.hand-sizes,
         draw-pile = s2.draw-pile,
         pile-size = s2.pile-size,
         discard-rank = ce-rank top-card,
         discard-suit = ce-suit top-card,
         current-player = 0,
         num-players = np,
         direction = 1,
         draw-penalty = 0,
         game-over = False,
         winner = 0,
         declared-suit = ce-suit top-card
       }

  ce-deal : CrazyEightsState, List Integer, Integer, Integer, Integer -> CrazyEightsState
  ce-deal (s) (deck) (dealt) (np) (player) =
    if dealt >= 7 * np then s
    else let actual-player = dealt / 7
    in let card-idx = list-at deck dealt
    in let s2 = ce-hand-set s actual-player card-idx 1
    in ce-deal s2 deck (dealt + 1) np player

  ce-load-pile : CrazyEightsState, List Integer, Integer, Integer, Integer -> CrazyEightsState
  ce-load-pile (s) (deck) (start) (i) (count) =
    if i >= count then s
    else if start + i >= 52 then s
    else let card-idx = list-at deck (start + i)
    in let new-pile = list-set-at (s.draw-pile) i card-idx
    in let s2 = CrazyEightsState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = new-pile,
         pile-size = s.pile-size + 1,
         discard-rank = s.discard-rank,
         discard-suit = s.discard-suit,
         current-player = s.current-player,
         num-players = s.num-players,
         direction = s.direction,
         draw-penalty = s.draw-penalty,
         game-over = s.game-over,
         winner = s.winner,
         declared-suit = s.declared-suit
       }
    in ce-load-pile s2 deck start (i + 1) count

Section: Play Logic

  ce-can-play : CrazyEightsState, Integer, Integer -> Boolean
  ce-can-play (s) (player) (card-idx) =
    if ce-hand-has s player card-idx == False then False
    else let r = ce-rank card-idx
    in let suit = ce-suit card-idx
    in if r == 6 then True
    else if r == s.discard-rank then True
    else suit == s.declared-suit

  ce-find-play : CrazyEightsState, Integer -> Integer
  ce-find-play (s) (player) =
    ce-find-non-eight s player 0

  ce-find-non-eight : CrazyEightsState, Integer, Integer -> Integer
  ce-find-non-eight (s) (player) (i) =
    if i >= 52 then ce-find-eight s player 0
    else if ce-hand-has s player i == False then ce-find-non-eight s player (i + 1)
    else let r = ce-rank i
    in if r == 6 then ce-find-non-eight s player (i + 1)
    else if ce-can-play s player i then i
    else ce-find-non-eight s player (i + 1)

  ce-find-eight : CrazyEightsState, Integer, Integer -> Integer
  ce-find-eight (s) (player) (i) =
    if i >= 52 then (-1)
    else if ce-hand-has s player i == False then ce-find-eight s player (i + 1)
    else let r = ce-rank i
    in if r == 6 then i
    else ce-find-eight s player (i + 1)

  ce-best-suit-for-player : CrazyEightsState, Integer -> Integer
  ce-best-suit-for-player (s) (player) =
    ce-best-suit-loop s player 0 0 0

  ce-best-suit-loop : CrazyEightsState, Integer, Integer, Integer, Integer -> Integer
  ce-best-suit-loop (s) (player) (suit) (best-suit) (best-count) =
    if suit >= 4 then best-suit
    else let cnt = ce-count-suit-in-hand s player suit
    in if cnt > best-count then ce-best-suit-loop s player (suit + 1) suit cnt
    else ce-best-suit-loop s player (suit + 1) best-suit best-count

  ce-count-suit-in-hand : CrazyEightsState, Integer, Integer -> Integer
  ce-count-suit-in-hand (s) (player) (suit) =
    ce-count-suit-loop s player suit 0 0

  ce-count-suit-loop : CrazyEightsState, Integer, Integer, Integer, Integer -> Integer
  ce-count-suit-loop (s) (player) (suit) (rank) (acc) =
    if rank >= 13 then acc
    else let card-idx = suit * 13 + rank
    in let held = if ce-hand-has s player card-idx then 1 else 0
    in ce-count-suit-loop s player suit (rank + 1) (acc + held)

Section: Drawing

  ce-draw-one : CrazyEightsState, Integer -> CrazyEightsState
  ce-draw-one (s) (player) =
    if s.pile-size <= 0 then s
    else let card-idx = list-at (s.draw-pile) 0
    in let new-pile = ce-shift-pile (s.draw-pile) 0 (s.pile-size)
    in let s2 = CrazyEightsState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = new-pile,
         pile-size = s.pile-size - 1,
         discard-rank = s.discard-rank,
         discard-suit = s.discard-suit,
         current-player = s.current-player,
         num-players = s.num-players,
         direction = s.direction,
         draw-penalty = s.draw-penalty,
         game-over = s.game-over,
         winner = s.winner,
         declared-suit = s.declared-suit
       }
    in ce-hand-set s2 player card-idx 1

  ce-shift-pile : List Integer, Integer, Integer -> List Integer
  ce-shift-pile (pile) (i) (sz) =
    if i + 1 >= sz then pile
    else let next = list-at pile (i + 1)
    in let p2 = list-set-at pile i next
    in ce-shift-pile p2 (i + 1) sz

  ce-draw-n : CrazyEightsState, Integer, Integer -> CrazyEightsState
  ce-draw-n (s) (player) (n) =
    if n <= 0 then s
    else ce-draw-n (ce-draw-one s player) player (n - 1)

Section: Advance Player

  ce-next-player : CrazyEightsState -> Integer
  ce-next-player (s) =
    rng-mod (s.current-player + s.direction + s.num-players) s.num-players

  ce-advance : CrazyEightsState -> CrazyEightsState
  ce-advance (s) =
    let next = ce-next-player s
    in CrazyEightsState {
         hands = s.hands,
         hand-sizes = s.hand-sizes,
         draw-pile = s.draw-pile,
         pile-size = s.pile-size,
         discard-rank = s.discard-rank,
         discard-suit = s.discard-suit,
         current-player = next,
         num-players = s.num-players,
         direction = s.direction,
         draw-penalty = s.draw-penalty,
         game-over = s.game-over,
         winner = s.winner,
         declared-suit = s.declared-suit
       }

Section: Play Card

  ce-play-card : CrazyEightsState, Integer, Integer -> CrazyEightsState
  ce-play-card (s) (player) (card-idx) =
    let r = ce-rank card-idx
    in let new-suit = if r == 6 then ce-best-suit-for-player s player else ce-suit card-idx
    in let s2 = ce-hand-set s player card-idx 0
    in let is-two = r == 0
    in let new-penalty = if is-two then s2.draw-penalty + 2 else s2.draw-penalty
    in let s3 = CrazyEightsState {
         hands = s2.hands,
         hand-sizes = s2.hand-sizes,
         draw-pile = s2.draw-pile,
         pile-size = s2.pile-size,
         discard-rank = r,
         discard-suit = ce-suit card-idx,
         current-player = s2.current-player,
         num-players = s2.num-players,
         direction = s2.direction,
         draw-penalty = new-penalty,
         game-over = s2.game-over,
         winner = s2.winner,
         declared-suit = new-suit
       }
    in if list-at (s3.hand-sizes) player == 0 then
      CrazyEightsState {
        hands = s3.hands,
        hand-sizes = s3.hand-sizes,
        draw-pile = s3.draw-pile,
        pile-size = s3.pile-size,
        discard-rank = s3.discard-rank,
        discard-suit = s3.discard-suit,
        current-player = s3.current-player,
        num-players = s3.num-players,
        direction = s3.direction,
        draw-penalty = s3.draw-penalty,
        game-over = True,
        winner = player,
        declared-suit = s3.declared-suit
      }
    else ce-advance s3

Section: Turn

  ce-do-turn : CrazyEightsState -> CrazyEightsState
  ce-do-turn (s) =
    if s.game-over then s
    else let player = s.current-player
    in if s.draw-penalty > 0 then
      let s2 = ce-draw-n s player (s.draw-penalty)
      in let s3 = CrazyEightsState {
           hands = s2.hands,
           hand-sizes = s2.hand-sizes,
           draw-pile = s2.draw-pile,
           pile-size = s2.pile-size,
           discard-rank = s2.discard-rank,
           discard-suit = s2.discard-suit,
           current-player = s2.current-player,
           num-players = s2.num-players,
           direction = s2.direction,
           draw-penalty = 0,
           game-over = s2.game-over,
           winner = s2.winner,
           declared-suit = s2.declared-suit
         }
      in ce-advance s3
    else let card = ce-find-play s player
    in if card >= 0 then ce-play-card s player card
    else let s2 = ce-draw-one s player
    in ce-advance s2

Section: Game Runner

  run-crazy-eights : Integer, Integer -> CrazyEightsResult
  run-crazy-eights (seed) (num-players) =
    let np = if num-players < 2 then 2 else if num-players > 4 then 4 else num-players
    in let s = ce-init seed np
    in ce-loop s 0

  ce-loop : CrazyEightsState, Integer -> CrazyEightsResult
  ce-loop (s) (turns) =
    if s.game-over then CrazyEightsResult { winner = s.winner, turns = turns, num-players = s.num-players }
    else if turns > 1000 then CrazyEightsResult { winner = (-1), turns = turns, num-players = s.num-players }
    else ce-loop (ce-do-turn s) (turns + 1)

Section: Formatting

  format-crazy-eights : CrazyEightsResult -> Text
  format-crazy-eights (r) =
    let w = if r.winner < 0 then "Draw" else "P" & show (r.winner + 1)
    in "CrazyEights (" & show r.num-players & "p, " & show r.turns & " turns): winner=" & w

Page 1


Chapter: Games--Bridge
  cites Games chapter Rng

 Contract Bridge, 4 players (N/S team 0 vs E/W team 1).
 Standard 52-card deck: suit = card / 13, rank = card mod 13
 (0=2 up to 12=Ace). HCP: A=4, K=3, Q=2, J=1.
 Simplified bidding: count HCP and longest suit, bid accordingly.
 Declarer plays both own hand and dummy. Score for making/defeating.

 We say:

Section: Types

  BridgeHand = record {
    cards : List Integer
  }

  BridgeState = record {
    north   : List Integer,
    south   : List Integer,
    east    : List Integer,
    west    : List Integer,
    trump   : Integer,
    contract : Integer,
    declarer : Integer
  }

  BridgeResult = record {
    declarer-team  : Integer,
    contract-level : Integer,
    tricks-made    : Integer,
    score          : Integer
  }

Section: Card Helpers

  br-suit : Integer -> Integer
  br-suit (c) = c / 13

  br-rank : Integer -> Integer
  br-rank (c) = rng-mod c 13

  br-hcp : Integer -> Integer
  br-hcp (c) =
    let r = br-rank c
    in if r == 12 then 4
    else if r == 11 then 3
    else if r == 10 then 2
    else if r == 9  then 1
    else 0

Section: Deck and Shuffle

  br-deck-new : List Integer
  br-deck-new = br-build-deck 0 []

  br-build-deck : Integer, List Integer -> List Integer
  br-build-deck (i) (acc) =
    if i >= 52 then acc
    else br-build-deck (i + 1) (list-push acc i)

  br-shuffle : List Integer, Rng -> List Integer
  br-shuffle (deck) (r) = br-fy deck 51 r

  br-fy : List Integer, Integer, Rng -> List Integer
  br-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in br-fy d3 (i - 1) r2

  br-collect : List Integer, Integer, Integer -> List Integer
  br-collect (deck) (lo) (hi) =
    br-collect-loop deck lo hi []

  br-collect-loop : List Integer, Integer, Integer, List Integer -> List Integer
  br-collect-loop (deck) (lo) (hi) (acc) =
    if lo >= hi then acc
    else br-collect-loop deck (lo + 1) hi (list-push acc (list-at deck lo))

  br-deal : List Integer -> BridgeState
  br-deal (deck) =
    let north = br-collect deck 0 13
    in let east  = br-collect deck 13 26
    in let south = br-collect deck 26 39
    in let west  = br-collect deck 39 52
    in BridgeState { north = north, south = south, east = east, west = west,
                     trump = 4, contract = 1, declarer = 0 }

Section: Point Counting

  hand-hcp : List Integer -> Integer
  hand-hcp (cards) =
    hand-hcp-loop cards 0 0

  hand-hcp-loop : List Integer, Integer, Integer -> Integer
  hand-hcp-loop (cards) (i) (acc) =
    if i >= list-length cards then acc
    else hand-hcp-loop cards (i + 1) (acc + br-hcp (list-at cards i))

  count-suit-in-hand : List Integer, Integer -> Integer
  count-suit-in-hand (cards) (s) =
    count-suit-loop cards s 0 0

  count-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  count-suit-loop (cards) (s) (i) (acc) =
    if i >= list-length cards then acc
    else let delta = if br-suit (list-at cards i) == s then 1 else 0
    in count-suit-loop cards s (i + 1) (acc + delta)

  longest-suit : List Integer -> Integer
  longest-suit (cards) =
    longest-suit-loop cards 0 0 0

  longest-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  longest-suit-loop (cards) (s) (best-count) (best-suit) =
    if s >= 4 then best-suit
    else let n = count-suit-in-hand cards s
    in if n > best-count then longest-suit-loop cards (s + 1) n s
    else longest-suit-loop cards (s + 1) best-count best-suit

Section: Bidding

  bid-hand : List Integer -> Integer
  bid-hand (cards) =
    let pts = hand-hcp cards
    in let suit = longest-suit cards
    in if pts >= 25 then suit * 10 + 6
    else if pts >= 22 then suit * 10 + 5
    else if pts >= 19 then suit * 10 + 4
    else if pts >= 16 then suit * 10 + 3
    else if pts >= 13 then suit * 10 + 2
    else if pts >= 10 then suit * 10 + 1
    else (-1)

  combine-bids : Integer, Integer -> Integer
  combine-bids (b1) (b2) =
    if b1 < 0 & b2 < 0 then (-1)
    else if b1 < 0 then b2
    else if b2 < 0 then b1
    else let level1 = rng-mod b1 10
    in let level2 = rng-mod b2 10
    in if level1 >= level2 then b1 else b2

  determine-contract : BridgeState -> BridgeState
  determine-contract (st) =
    let ns-bid = combine-bids (bid-hand (st.north)) (bid-hand (st.south))
    in let ew-bid = combine-bids (bid-hand (st.east)) (bid-hand (st.west))
    in let ns-level = if ns-bid < 0 then 0 else rng-mod ns-bid 10
    in let ew-level = if ew-bid < 0 then 0 else rng-mod ew-bid 10
    in if ns-level >= ew-level & ns-bid >= 0 then
      let trump = ns-bid / 10
      in let level = ns-level
      in __record-set (__record-set (__record-set st "trump" trump) "contract" level) "declarer" 0
    else if ew-bid >= 0 then
      let trump = ew-bid / 10
      in let level = ew-level
      in __record-set (__record-set (__record-set st "trump" trump) "contract" level) "declarer" 1
    else __record-set (__record-set st "contract" 1) "declarer" 0

Section: Trick Taking

  card-beats : Integer, Integer, Integer, Integer -> Boolean
  card-beats (challenger) (current-best) (led-suit) (trump) =
    let cs = br-suit challenger
    in let bs = br-suit current-best
    in let cr = br-rank challenger
    in let br-val = br-rank current-best
    in if cs == trump & bs /= trump then True
    else if cs == trump & bs == trump then cr > br-val
    else if cs == bs then cr > br-val
    else False

  best-card-idx : List Integer, Integer, Integer -> Integer
  best-card-idx (hand) (led-suit) (trump) =
    best-card-loop hand led-suit trump 0 0

  best-card-loop : List Integer, Integer, Integer, Integer, Integer -> Integer
  best-card-loop (hand) (led-suit) (trump) (i) (best-i) =
    if i >= list-length hand then best-i
    else let c = list-at hand i
    in let b = list-at hand best-i
    in if card-beats c b led-suit trump then best-card-loop hand led-suit trump (i + 1) i
    else best-card-loop hand led-suit trump (i + 1) best-i

  remove-at : List Integer, Integer -> List Integer
  remove-at (xs) (idx) =
    remove-at-loop xs idx 0 []

  remove-at-loop : List Integer, Integer, Integer, List Integer -> List Integer
  remove-at-loop (xs) (idx) (i) (acc) =
    if i >= list-length xs then acc
    else if i == idx then remove-at-loop xs idx (i + 1) acc
    else remove-at-loop xs idx (i + 1) (list-push acc (list-at xs i))

  play-trick : List Integer, List Integer, List Integer, List Integer, Integer, Integer -> Integer
  play-trick (north) (south) (east) (west) (trump) (declarer) =
    let lead = if declarer == 0 then list-at south 0 else list-at east 0
    in let led-suit = br-suit lead
    in let ni = best-card-idx north led-suit trump
    in let si = best-card-idx south led-suit trump
    in let ei = best-card-idx east  led-suit trump
    in let wi = best-card-idx west  led-suit trump
    in let nc = list-at north ni
    in let sc = list-at south si
    in let ec = list-at east  ei
    in let wc = list-at west  wi
    in let w01 = if card-beats sc nc led-suit trump then sc else nc
    in let w012 = if card-beats ec w01 led-suit trump then ec else w01
    in let w0123 = if card-beats wc w012 led-suit trump then wc else w012
    in let ns-wins = br-suit w0123 == br-suit nc | br-suit w0123 == br-suit sc
    in if ns-wins then 0 else 1

  play-all-br-tricks : List Integer, List Integer, List Integer, List Integer, Integer, Integer -> Integer
  play-all-br-tricks (north) (south) (east) (west) (trump) (declarer) =
    play-br-tricks-loop north south east west trump declarer 0 0

  play-br-tricks-loop : List Integer, List Integer, List Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  play-br-tricks-loop (north) (south) (east) (west) (trump) (declarer) (trick) (ns-tricks) =
    if list-length north == 0 then ns-tricks
    else let winner-team = play-trick north south east west trump declarer
    in let new-ns = if winner-team == 0 then ns-tricks + 1 else ns-tricks
    in let n2 = remove-at north 0
    in let s2 = remove-at south 0
    in let e2 = remove-at east  0
    in let w2 = remove-at west  0
    in play-br-tricks-loop n2 s2 e2 w2 trump declarer (trick + 1) new-ns

Section: Scoring

  bridge-score : Integer, Integer, Integer -> Integer
  bridge-score (level) (tricks-made) (trump) =
    let needed = level + 6
    in if tricks-made >= needed then
      let overtricks = tricks-made - needed
      in let per-trick = if trump >= 3 then 30 else 20
      in level * per-trick + overtricks * 50 + if level >= 6 then 500 else 0
    else
      let undertricks = needed - tricks-made
      in -(undertricks * 50)

Section: Game Runner

  run-bridge-hand : Integer -> BridgeResult
  run-bridge-hand (seed) =
    let deck = br-shuffle br-deck-new (rng-new seed)
    in let st0 = br-deal deck
    in let st = determine-contract st0
    in let ns-tricks = play-all-br-tricks (st.north) (st.south) (st.east) (st.west) (st.trump) (st.declarer)
    in let tricks-for-decl = if st.declarer == 0 then ns-tricks else 13 - ns-tricks
    in let score = bridge-score (st.contract) tricks-for-decl (st.trump)
    in let winner = if score >= 0 then st.declarer else 1 - st.declarer
    in BridgeResult { declarer-team = st.declarer, contract-level = st.contract,
                      tricks-made = tricks-for-decl, score = score }

Section: Formatting

  format-bridge-result : BridgeResult -> Text
  format-bridge-result (r) =
    let team = if r.declarer-team == 0 then "NS" else "EW"
    in let outcome = if r.score >= 0 then "made" else "down"
    in "Bridge: " & team & " contract=" & show (r.contract-level) &
       " tricks=" & show (r.tricks-made) & " " & outcome &
       " score=" & show (r.score)

Page 1


Chapter: Games--RoyalUr
  cites Games chapter Rng

 The Royal Game of Ur, circa 2600 BCE. Two players race 7 pieces along
 a path of 14 steps. Steps 1-4 are private start, 5-12 are shared
 combat, 13-14 are private exit. Step 15 means scored (off board).
 Landing on an opponent piece in the shared zone (5-12) sends it back
 to step 0 (not entered). Rosette squares (4, 8, 14) grant an extra
 turn and are safe from capture. Roll four binary dice (0-4 total).
 First player to score all 7 pieces wins.

 We say:

Section: Types

  UrBoard = record {
    p1-pieces : List Integer,
    p2-pieces : List Integer,
    current-player : Integer,
    p1-scored : Integer,
    p2-scored : Integer,
    game-over : Boolean,
    winner : Integer,
    last-roll : Integer,
    moves-made : Integer
  }

  UrResult = record {
    winner : Integer,
    moves-made : Integer
  }

Section: Construction

  ur-new : UrBoard
  ur-new =
    let p1 = ur-fill-pieces 0 []
    in let p2 = ur-fill-pieces 0 []
    in UrBoard { p1-pieces = p1, p2-pieces = p2, current-player = 1,
                 p1-scored = 0, p2-scored = 0, game-over = False,
                 winner = 0, last-roll = 0, moves-made = 0 }

  ur-fill-pieces : Integer, List Integer -> List Integer
  ur-fill-pieces (i) (acc) =
    if i >= 7 then acc
    else ur-fill-pieces (i + 1) (list-push acc 0)

Section: Dice

  ur-roll : Rng -> Integer
  ur-roll (r) =
    let r1 = rng-next r
    in let r2 = rng-next r1
    in let r3 = rng-next r2
    in let r4 = rng-next r3
    in let d1 = rng-mod (rng-value r1) 2
    in let d2 = rng-mod (rng-value r2) 2
    in let d3 = rng-mod (rng-value r3) 2
    in let d4 = rng-mod (rng-value r4) 2
    in d1 + d2 + d3 + d4

Section: Board Queries

  ur-is-rosette : Integer -> Boolean
  ur-is-rosette (step) =
    step == 4 | step == 8 | step == 14

  ur-is-shared : Integer -> Boolean
  ur-is-shared (step) =
    step >= 5 & step <= 12

  ur-piece-at-step : List Integer, Integer -> Boolean
  ur-piece-at-step (pieces) (step) =
    ur-find-at pieces step 0

  ur-find-at : List Integer, Integer, Integer -> Boolean
  ur-find-at (pieces) (step) (i) =
    if i >= 7 then False
    else if list-at pieces i == step then True
    else ur-find-at pieces step (i + 1)

  ur-find-piece-idx : List Integer, Integer, Integer -> Integer
  ur-find-piece-idx (pieces) (step) (i) =
    if i >= 7 then (-1)
    else if list-at pieces i == step then i
    else ur-find-piece-idx pieces step (i + 1)

Section: Move Application

  ur-apply-move : UrBoard, Integer, Integer -> UrBoard
  ur-apply-move (b) (piece-idx) (roll) =
    let pieces = if b.current-player == 1 then b.p1-pieces else b.p2-pieces
    in let opp-pieces = if b.current-player == 1 then b.p2-pieces else b.p1-pieces
    in let cur-step = list-at pieces piece-idx
    in let new-step = cur-step + roll
    in if new-step > 15 then b
    else if new-step == 15 then
      let new-pieces = list-set-at pieces piece-idx 15
      in let new-scored = if b.current-player == 1 then b.p1-scored + 1 else b.p2-scored
      in let won = new-scored >= 7
      in let np1 = if b.current-player == 1 then new-pieces else b.p1-pieces
      in let np2 = if b.current-player == 2 then new-pieces else b.p2-pieces
      in let ns1 = if b.current-player == 1 then new-scored else b.p1-scored
      in let ns2 = if b.current-player == 2 then new-scored else b.p2-scored
      in let next-player = if ur-is-rosette new-step then b.current-player else if b.current-player == 1 then 2 else 1
      in UrBoard { p1-pieces = np1, p2-pieces = np2, current-player = next-player,
                   p1-scored = ns1, p2-scored = ns2, game-over = won,
                   winner = if won then b.current-player else 0,
                   last-roll = roll, moves-made = b.moves-made + 1 }
    else if ur-is-shared new-step then
      if ur-piece-at-step pieces new-step then b
      else if ur-piece-at-step opp-pieces new-step & ur-is-rosette new-step then b
      else let new-pieces = list-set-at pieces piece-idx new-step
      in let captured = ur-is-shared new-step & ur-piece-at-step opp-pieces new-step
      in let new-opp = if captured then ur-send-back opp-pieces new-step else opp-pieces
      in let np1 = if b.current-player == 1 then new-pieces else new-opp
      in let np2 = if b.current-player == 2 then new-pieces else new-opp
      in let rosette = ur-is-rosette new-step
      in let next-player = if rosette then b.current-player else if b.current-player == 1 then 2 else 1
      in UrBoard { p1-pieces = np1, p2-pieces = np2, current-player = next-player,
                   p1-scored = b.p1-scored, p2-scored = b.p2-scored, game-over = False,
                   winner = 0, last-roll = roll, moves-made = b.moves-made + 1 }
    else if ur-piece-at-step pieces new-step then b
    else let new-pieces = list-set-at pieces piece-idx new-step
      in let np1 = if b.current-player == 1 then new-pieces else b.p1-pieces
      in let np2 = if b.current-player == 2 then new-pieces else b.p2-pieces
      in let rosette = ur-is-rosette new-step
      in let next-player = if rosette then b.current-player else if b.current-player == 1 then 2 else 1
      in UrBoard { p1-pieces = np1, p2-pieces = np2, current-player = next-player,
                   p1-scored = b.p1-scored, p2-scored = b.p2-scored, game-over = False,
                   winner = 0, last-roll = roll, moves-made = b.moves-made + 1 }

  ur-send-back : List Integer, Integer -> List Integer
  ur-send-back (pieces) (step) =
    let idx = ur-find-piece-idx pieces step 0
    in if idx < 0 then pieces
    else list-set-at pieces idx 0

Section: AI

  ur-ai-pick : UrBoard, Integer -> Integer
  ur-ai-pick (b) (roll) =
    let pieces = if b.current-player == 1 then b.p1-pieces else b.p2-pieces
    in let opp = if b.current-player == 1 then b.p2-pieces else b.p1-pieces
    in ur-best-move pieces opp roll 0 (-1) (-1)

  ur-best-move : List Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  ur-best-move (pieces) (opp) (roll) (i) (best-idx) (best-score) =
    if i >= 7 then best-idx
    else let step = list-at pieces i
    in let target = step + roll
    in if step == 15 then ur-best-move pieces opp roll (i + 1) best-idx best-score
    else if target > 15 then ur-best-move pieces opp roll (i + 1) best-idx best-score
    else if ur-piece-at-step pieces target then ur-best-move pieces opp roll (i + 1) best-idx best-score
    else if ur-is-shared target & ur-piece-at-step opp target & ur-is-rosette target then ur-best-move pieces opp roll (i + 1) best-idx best-score
    else let score = ur-score-move step target opp
    in if score > best-score then ur-best-move pieces opp roll (i + 1) i score
    else ur-best-move pieces opp roll (i + 1) best-idx best-score

  ur-score-move : Integer, Integer, List Integer -> Integer
  ur-score-move (from-step) (to-step) (opp) =
    let base = to-step * 10
    in let capture-bonus = if ur-is-shared to-step & ur-piece-at-step opp to-step then 500 else 0
    in let rosette-bonus = if ur-is-rosette to-step then 300 else 0
    in let score-bonus = if to-step == 15 then 1000 else 0
    in base + capture-bonus + rosette-bonus + score-bonus

Section: Game Runner

  run-ur-game : Integer -> UrResult
  run-ur-game (seed) =
    let b = ur-new
    in let r = rng-new seed
    in ur-loop b r

  ur-loop : UrBoard, Rng -> UrResult
  ur-loop (b) (r) =
    if b.game-over then UrResult { winner = b.winner, moves-made = b.moves-made }
    else if b.moves-made > 500 then UrResult { winner = 0, moves-made = b.moves-made }
    else let r1 = rng-next r
    in let roll = ur-roll r1
    in let r2 = rng-next (rng-next (rng-next (rng-next r1)))
    in if roll == 0 then
      let next-player = if b.current-player == 1 then 2 else 1
      in let b2 = __record-set (__record-set b "current-player" next-player) "moves-made" (b.moves-made + 1)
      in ur-loop (__record-set b2 "last-roll" 0) r2
    else let idx = ur-ai-pick b roll
    in if idx < 0 then
      let next-player = if b.current-player == 1 then 2 else 1
      in let b2 = __record-set (__record-set b "current-player" next-player) "moves-made" (b.moves-made + 1)
      in ur-loop (__record-set b2 "last-roll" roll) r2
    else let next = ur-apply-move b idx roll
    in ur-loop next r2

Section: Formatting

  format-ur-result : UrResult -> Text
  format-ur-result (r) =
    let w = if r.winner == 1 then "Player 1 wins"
            else if r.winner == 2 then "Player 2 wins"
            else "Draw"
    in "Royal Game of Ur: " & w & " in " & show (r.moves-made) & " moves"

Page 1


Chapter: Games--SetGame
  cites Games chapter Rng

 The card game Set. 81 cards, each with four attributes: number
 (1-3), shading (open/striped/solid), color (red/green/purple),
 and shape (oval/squiggle/diamond). Three cards form a valid set
 when, for each attribute, the three values are either all the same
 or all different. Find all sets in a 12-card tableau.

 Cards are encoded as integers 0-80. Attribute i is extracted via
 repeated mod/div by 3: number = card mod 3, shading = (card/3)
 mod 3, color = (card/9) mod 3, shape = card/27.

 We say:

Section: Card Encoding

  SetCard = record {
    id      : Integer,
    number  : Integer,
    shading : Integer,
    color   : Integer,
    shape   : Integer
  }

  set-card-from-id : Integer -> SetCard
  set-card-from-id (id) =
    let number  = rng-mod id 3
    in let shading = rng-mod (id / 3) 3
    in let color   = rng-mod (id / 9) 3
    in let shape   = id / 27
    in SetCard { id = id, number = number, shading = shading, color = color, shape = shape }

Section: Attribute Validation

  attr-valid : Integer, Integer, Integer -> Boolean
  attr-valid (a) (b) (c) =
    let all-same = a == b & b == c
    in let all-diff = a /= b & b /= c & a /= c
    in all-same | all-diff

  is-valid-set : SetCard, SetCard, SetCard -> Boolean
  is-valid-set (a) (b) (c) =
    attr-valid (a.number)  (b.number)  (c.number)  &
    attr-valid (a.shading) (b.shading) (c.shading) &
    attr-valid (a.color)   (b.color)   (c.color)   &
    attr-valid (a.shape)   (b.shape)   (c.shape)

Section: Deck and Shuffle

  set-deck-new : List Integer
  set-deck-new = set-build-deck 0 []

  set-build-deck : Integer, List Integer -> List Integer
  set-build-deck (i) (acc) =
    if i >= 81 then acc
    else set-build-deck (i + 1) (list-push acc i)

  set-shuffle : List Integer, Integer -> List Integer
  set-shuffle (deck) (seed) = set-fy deck (list-length deck - 1) (rng-new seed)

  set-fy : List Integer, Integer, Rng -> List Integer
  set-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in set-fy (set-swap deck i j) (i - 1) r2

  set-swap : List Integer, Integer, Integer -> List Integer
  set-swap (xs) (i) (j) =
    if i == j then xs
    else let vi = list-at xs i
    in list-set-at (list-set-at xs i (list-at xs j)) j vi

Section: Game State

  SetGameState = record {
    deck    : List Integer,
    tableau : List Integer,
    found   : Integer,
    seed    : Integer
  }

  set-game-new : Integer -> SetGameState
  set-game-new (seed) =
    let shuffled = set-shuffle set-deck-new seed
    in let tab = set-take shuffled 0 12 []
    in let rest = set-drop shuffled 12 81 []
    in SetGameState { deck = rest, tableau = tab, found = 0, seed = seed }

  set-take : List Integer, Integer, Integer, List Integer -> List Integer
  set-take (xs) (i) (n) (acc) =
    if i >= n then acc
    else if i >= list-length xs then acc
    else set-take xs (i + 1) n (list-push acc (list-at xs i))

  set-drop : List Integer, Integer, Integer, List Integer -> List Integer
  set-drop (xs) (from) (n) (acc) =
    if from >= n then acc
    else if from >= list-length xs then acc
    else set-drop xs (from + 1) n (list-push acc (list-at xs from))

Section: Set Finding

  find-all-sets : List Integer -> Integer
  find-all-sets (tab) =
    let n = list-length tab
    in find-sets-loop tab n 0 0

  find-sets-loop : List Integer, Integer, Integer, Integer -> Integer
  find-sets-loop (tab) (n) (i) (count) =
    if i >= n then count
    else find-sets-j tab n i (i + 1) count

  find-sets-j : List Integer, Integer, Integer, Integer, Integer -> Integer
  find-sets-j (tab) (n) (i) (j) (count) =
    if j >= n then find-sets-loop tab n (i + 1) count
    else find-sets-k tab n i j (j + 1) count

  find-sets-k : List Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  find-sets-k (tab) (n) (i) (j) (k) (count) =
    if k >= n then find-sets-j tab n i (j + 1) count
    else let a = set-card-from-id (list-at tab i)
    in let b = set-card-from-id (list-at tab j)
    in let c = set-card-from-id (list-at tab k)
    in let valid = is-valid-set a b c
    in find-sets-k tab n i j (k + 1) (if valid then count + 1 else count)

Section: Run

  run-set-game : Integer -> Integer
  run-set-game (seed) =
    let state = set-game-new seed
    in find-all-sets (state.tableau)

Section: Formatting

  format-set-attr-number : Integer -> Text
  format-set-attr-number (n) =
    if n == 0 then "one" else if n == 1 then "two" else "three"

  format-set-attr-shading : Integer -> Text
  format-set-attr-shading (s) =
    if s == 0 then "open" else if s == 1 then "striped" else "solid"

  format-set-attr-color : Integer -> Text
  format-set-attr-color (c) =
    if c == 0 then "red" else if c == 1 then "green" else "purple"

  format-set-attr-shape : Integer -> Text
  format-set-attr-shape (sh) =
    if sh == 0 then "oval" else if sh == 1 then "squiggle" else "diamond"

  format-set-card : SetCard -> Text
  format-set-card (c) =
    format-set-attr-number (c.number) & " " &
    format-set-attr-shading (c.shading) & " " &
    format-set-attr-color (c.color) & " " &
    format-set-attr-shape (c.shape)

  format-set-result : Integer, Integer -> Text
  format-set-result (found) (tab-size) =
    "Set: found " & show found & " sets in " & show tab-size & "-card tableau"

Page 1


Chapter: Games--Sudoku
  cites Games chapter Rng

 Sudoku: 9x9 grid, 81 cells. Values 1-9, 0=empty.
 Generation: fill the three diagonal 3x3 boxes independently (no conflict
 possible among them), then solve the rest with backtracking.
 Then remove cells to create the puzzle. Solver uses backtracking.
 SudokuState holds the working grid and iteration count.

 We say:

Section: Types

  SudokuState = record {
    grid       : List Integer,
    iterations : Integer
  }

  SudokuResult = record {
    solved     : Boolean,
    iterations : Integer,
    givens     : Integer
  }

Section: Construction

  sudoku-new : Rng -> SudokuState
  sudoku-new (rng) =
    let empty = sudoku-fill 0 []
    in let st = SudokuState { grid = empty, iterations = 0 }
    in let st1 = sudoku-fill-box st rng 0 0
    in let r2 = rng-next rng
    in let st2 = sudoku-fill-box st1 r2 3 3
    in let r3 = rng-next r2
    in sudoku-fill-box st2 r3 6 6

  sudoku-fill : Integer, List Integer -> List Integer
  sudoku-fill (i) (acc) =
    if i >= 81 then acc
    else sudoku-fill (i + 1) (list-push acc 0)

  sudoku-fill-box : SudokuState, Rng, Integer, Integer -> SudokuState
  sudoku-fill-box (st) (rng) (box-row) (box-col) =
    let digits = sudoku-shuffle-digits rng
    in sudoku-place-digits st digits box-row box-col 0

  sudoku-place-digits : SudokuState, List Integer, Integer, Integer, Integer -> SudokuState
  sudoku-place-digits (st) (digits) (box-row) (box-col) (i) =
    if i >= 9 then st
    else let dr = i / 3
    in let dc = i - dr * 3
    in let row = box-row + dr
    in let col = box-col + dc
    in let val = list-at digits i
    in let new-grid = list-set-at (st.grid) (row * 9 + col) val
    in sudoku-place-digits (SudokuState { grid = new-grid, iterations = st.iterations }) digits box-row box-col (i + 1)

  sudoku-shuffle-digits : Rng -> List Integer
  sudoku-shuffle-digits (rng) =
    let base = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    in sudoku-shuffle-loop base rng 8

  sudoku-shuffle-loop : List Integer, Rng, Integer -> List Integer
  sudoku-shuffle-loop (arr) (rng) (i) =
    if i <= 0 then arr
    else let r = rng-next rng
    in let j = rng-range r 0 i
    in let ai = list-at arr i
    in let aj = list-at arr j
    in let arr2 = list-set-at arr i aj
    in let arr3 = list-set-at arr2 j ai
    in sudoku-shuffle-loop arr3 r (i - 1)

Section: Validity Checks

  sudoku-cell : List Integer, Integer, Integer -> Integer
  sudoku-cell (grid) (row) (col) = list-at grid (row * 9 + col)

  sudoku-valid-row : List Integer, Integer, Integer -> Boolean
  sudoku-valid-row (grid) (row) (val) =
    sudoku-check-row grid row val 0

  sudoku-check-row : List Integer, Integer, Integer, Integer -> Boolean
  sudoku-check-row (grid) (row) (val) (col) =
    if col >= 9 then True
    else if sudoku-cell grid row col == val then False
    else sudoku-check-row grid row val (col + 1)

  sudoku-valid-col : List Integer, Integer, Integer -> Boolean
  sudoku-valid-col (grid) (col) (val) =
    sudoku-check-col grid col val 0

  sudoku-check-col : List Integer, Integer, Integer, Integer -> Boolean
  sudoku-check-col (grid) (col) (val) (row) =
    if row >= 9 then True
    else if sudoku-cell grid row col == val then False
    else sudoku-check-col grid col val (row + 1)

  sudoku-valid-box : List Integer, Integer, Integer, Integer -> Boolean
  sudoku-valid-box (grid) (row) (col) (val) =
    let br = row - rng-mod row 3
    in let bc = col - rng-mod col 3
    in sudoku-check-box grid br bc val 0

  sudoku-check-box : List Integer, Integer, Integer, Integer, Integer -> Boolean
  sudoku-check-box (grid) (br) (bc) (val) (i) =
    if i >= 9 then True
    else let dr = i / 3
    in let dc = i - dr * 3
    in if sudoku-cell grid (br + dr) (bc + dc) == val then False
    else sudoku-check-box grid br bc val (i + 1)

  sudoku-is-valid : List Integer, Integer, Integer, Integer -> Boolean
  sudoku-is-valid (grid) (row) (col) (val) =
    sudoku-valid-row grid row val &
    sudoku-valid-col grid col val &
    sudoku-valid-box grid row col val

Section: Backtracking Solver

  sudoku-solve : SudokuState -> SudokuState
  sudoku-solve (st) =
    let empty = sudoku-find-empty (st.grid) 0
    in if empty < 0 then st
    else let row = empty / 9
    in let col = empty - row * 9
    in sudoku-try-values st row col 1

  sudoku-find-empty : List Integer, Integer -> Integer
  sudoku-find-empty (grid) (i) =
    if i >= 81 then -1
    else if list-at grid i == 0 then i
    else sudoku-find-empty grid (i + 1)

  sudoku-try-values : SudokuState, Integer, Integer, Integer -> SudokuState
  sudoku-try-values (st) (row) (col) (val) =
    if val > 9 then SudokuState { grid = st.grid, iterations = st.iterations }
    else let new-iter = st.iterations + 1
    in if sudoku-is-valid (st.grid) row col val == False then
      sudoku-try-values (SudokuState { grid = st.grid, iterations = new-iter }) row col (val + 1)
    else let new-grid = list-set-at (st.grid) (row * 9 + col) val
    in let st2 = sudoku-solve (SudokuState { grid = new-grid, iterations = new-iter })
    in let solved = sudoku-find-empty (st2.grid) 0 < 0
    in if solved then st2
    else let cleared = list-set-at (st2.grid) (row * 9 + col) 0
    in sudoku-try-values (SudokuState { grid = cleared, iterations = st2.iterations }) row col (val + 1)

Section: Puzzle Creation (remove cells)

  sudoku-remove-cells : SudokuState, Rng, Integer -> SudokuState
  sudoku-remove-cells (st) (rng) (count) =
    if count <= 0 then st
    else let r = rng-next rng
    in let idx = rng-range r 0 80
    in if list-at (st.grid) idx == 0 then sudoku-remove-cells st r (count - 1)
    else let new-grid = list-set-at (st.grid) idx 0
    in sudoku-remove-cells (SudokuState { grid = new-grid, iterations = st.iterations }) r (count - 1)

  sudoku-count-givens : List Integer -> Integer
  sudoku-count-givens (grid) =
    sudoku-count-given-loop grid 0 0

  sudoku-count-given-loop : List Integer, Integer, Integer -> Integer
  sudoku-count-given-loop (grid) (i) (acc) =
    if i >= 81 then acc
    else if list-at grid i /= 0 then sudoku-count-given-loop grid (i + 1) (acc + 1)
    else sudoku-count-given-loop grid (i + 1) acc

Section: Game Runner

  run-sudoku-solve : SudokuResult
  run-sudoku-solve =
    let rng = rng-new 55
    in let st0 = sudoku-new rng
    in let filled = sudoku-solve st0
    in let r2 = rng-next rng
    in let puzzle = sudoku-remove-cells filled r2 40
    in let givens = sudoku-count-givens (puzzle.grid)
    in let solution = sudoku-solve puzzle
    in let solved = sudoku-find-empty (solution.grid) 0 < 0
    in SudokuResult { solved = solved, iterations = solution.iterations, givens = givens }

Section: Formatting

  format-sudoku-result : SudokuResult -> Text
  format-sudoku-result (r) =
    let outcome = if r.solved then "Solved" else "Unsolved"
    in "Sudoku: " & outcome & " givens=" & show (r.givens) & " iterations=" & show (r.iterations)

Page 1


Chapter: Games--Spider
  cites Games chapter Rng

 Spider Solitaire, 2-suit variant. 104 cards (suits 0 and 1,
 ranks 0-12 each appearing 4 times). 10 tableau columns receive
 the initial deal (cols 0-3 get 6 cards, cols 4-9 get 5 cards).
 Cards represented as integers: rank = card mod 13, suit = card / 13.
 Sequences of same-suit descending cards can be moved as a unit.
 A complete K-through-A run of the same suit is removed.
 The stock holds 50 remaining cards dealt 10 at a time.
 The greedy AI prefers completing suits, then uncovering cards,
 then any legal sequence move.

 We say:

Section: Types

  SpiderState = record {
    col0            : List Integer,
    col1            : List Integer,
    col2            : List Integer,
    col3            : List Integer,
    col4            : List Integer,
    col5            : List Integer,
    col6            : List Integer,
    col7            : List Integer,
    col8            : List Integer,
    col9            : List Integer,
    stock           : List Integer,
    completed-suits : Integer,
    moves           : Integer
  }

  SpiderResult = record {
    completed-suits : Integer,
    moves           : Integer,
    won             : Boolean
  }

  SpiderMove = record {
    from-col  : Integer,
    seq-start : Integer,
    to-col    : Integer
  }

Section: Card Helpers

  sp-rank : Integer -> Integer
  sp-rank (c) = rng-mod c 13

  sp-suit : Integer -> Integer
  sp-suit (c) = c / 13

Section: Deck Building

  spider-deck-new : Integer -> List Integer
  spider-deck-new (seed) =
    let deck = sp-fill-deck 0 []
    in sp-shuffle deck seed 103

  sp-fill-deck : Integer, List Integer -> List Integer
  sp-fill-deck (i) (acc) =
    if i >= 104 then acc
    else sp-fill-deck (i + 1) (list-push acc i)

  sp-shuffle : List Integer, Integer, Integer -> List Integer
  sp-shuffle (deck) (seed) (i) =
    if i <= 0 then deck
    else let rng = rng-new (seed * 7 + i)
    in let j = rng-mod (rng-value (rng-next rng)) (i + 1)
    in let vi = list-at deck i
    in let vj = list-at deck j
    in let d2 = list-set-at deck i vj
    in let d3 = list-set-at d2 j vi
    in sp-shuffle d3 seed (i - 1)

Section: Column Access

  sp-get-col : SpiderState, Integer -> List Integer
  sp-get-col (st) (c) =
    if c == 0 then st.col0
    else if c == 1 then st.col1
    else if c == 2 then st.col2
    else if c == 3 then st.col3
    else if c == 4 then st.col4
    else if c == 5 then st.col5
    else if c == 6 then st.col6
    else if c == 7 then st.col7
    else if c == 8 then st.col8
    else st.col9

  sp-set-col : SpiderState, Integer, List Integer -> SpiderState
  sp-set-col (st) (c) (col) =
    if c == 0 then SpiderState { col0 = col, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                  col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                  col8 = st.col8, col9 = st.col9, stock = st.stock,
                                  completed-suits = st.completed-suits, moves = st.moves }
    else if c == 1 then SpiderState { col0 = st.col0, col1 = col, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 2 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = col, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 3 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = col,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 4 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = col, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 5 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = col, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 6 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = col, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 7 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = col,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 8 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = col, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                       col8 = st.col8, col9 = col, stock = st.stock,
                       completed-suits = st.completed-suits, moves = st.moves }

Section: Construction

  spider-new : Integer -> SpiderState
  spider-new (seed) =
    let deck = spider-deck-new seed
    in sp-deal deck

  sp-deal : List Integer -> SpiderState
  sp-deal (deck) =
    let c0 = sp-take-col deck 0 6
    in let c1 = sp-take-col deck 6 6
    in let c2 = sp-take-col deck 12 6
    in let c3 = sp-take-col deck 18 6
    in let c4 = sp-take-col deck 24 5
    in let c5 = sp-take-col deck 29 5
    in let c6 = sp-take-col deck 34 5
    in let c7 = sp-take-col deck 39 5
    in let c8 = sp-take-col deck 44 5
    in let c9 = sp-take-col deck 49 5
    in let stock = sp-take-col deck 54 50
    in SpiderState { col0 = c0, col1 = c1, col2 = c2, col3 = c3,
                     col4 = c4, col5 = c5, col6 = c6, col7 = c7,
                     col8 = c8, col9 = c9, stock = stock,
                     completed-suits = 0, moves = 0 }

  sp-take-col : List Integer, Integer, Integer -> List Integer
  sp-take-col (deck) (start) (count) =
    sp-take-loop deck start count 0 []

  sp-take-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  sp-take-loop (deck) (start) (count) (i) (acc) =
    if i >= count then acc
    else sp-take-loop deck start count (i + 1) (list-push acc (list-at deck (start + i)))

Section: Sequence Logic

  sp-seq-len : List Integer, Integer -> Integer
  sp-seq-len (col) (from-idx) =
    let n = list-length col
    in if from-idx >= n then 0
    else sp-seq-loop col from-idx (from-idx + 1) 1

  sp-seq-loop : List Integer, Integer, Integer, Integer -> Integer
  sp-seq-loop (col) (prev) (i) (len) =
    let n = list-length col
    in if i >= n then len
    else let c-prev = list-at col prev
    in let c-curr = list-at col i
    in if sp-rank c-curr /= sp-rank c-prev - 1 then len
    else if sp-suit c-curr /= sp-suit c-prev then len
    else sp-seq-loop col i (i + 1) (len + 1)

  sp-can-move : List Integer, List Integer, Integer -> Boolean
  sp-can-move (from-col) (to-col) (seq-start) =
    let to-n = list-length to-col
    in if to-n == 0 then True
    else let top-from = list-at from-col seq-start
    in let top-to = list-at to-col (to-n - 1)
    in sp-rank top-from == sp-rank top-to - 1

Section: Move Execution

  sp-apply-move : SpiderState, SpiderMove -> SpiderState
  sp-apply-move (st) (m) =
    let from-col = sp-get-col st (m.from-col)
    in let to-col = sp-get-col st (m.to-col)
    in let from-n = list-length from-col
    in let seq-count = from-n - m.seq-start
    in let moved = sp-take-from-end from-col m.seq-start seq-count
    in let trimmed = sp-drop-from-end from-col seq-count
    in let new-to = sp-append-cols to-col moved 0 (list-length moved)
    in let st2 = sp-set-col st (m.from-col) trimmed
    in let st3 = sp-set-col st2 (m.to-col) new-to
    in let st4 = SpiderState { col0 = st3.col0, col1 = st3.col1, col2 = st3.col2, col3 = st3.col3,
                                col4 = st3.col4, col5 = st3.col5, col6 = st3.col6, col7 = st3.col7,
                                col8 = st3.col8, col9 = st3.col9, stock = st3.stock,
                                completed-suits = st3.completed-suits, moves = st3.moves + 1 }
    in sp-check-complete st4 (m.to-col)

  sp-take-from-end : List Integer, Integer, Integer -> List Integer
  sp-take-from-end (col) (start) (count) =
    sp-take-loop col start count 0 []

  sp-drop-from-end : List Integer, Integer -> List Integer
  sp-drop-from-end (col) (count) =
    let n = list-length col
    in sp-take-loop col 0 (n - count) 0 []

  sp-append-cols : List Integer, List Integer, Integer, Integer -> List Integer
  sp-append-cols (base) (extra) (i) (n) =
    if i >= n then base
    else sp-append-cols (list-push base (list-at extra i)) extra (i + 1) n

Section: Complete Suite Check

  sp-check-complete : SpiderState, Integer -> SpiderState
  sp-check-complete (st) (col-idx) =
    let col = sp-get-col st col-idx
    in let n = list-length col
    in if n < 13 then st
    else let seq-len = sp-seq-len col (n - 13)
    in if seq-len < 13 then st
    else let top = list-at col (n - 13)
    in if sp-rank top /= 12 then st
    else let trimmed = sp-drop-from-end col 13
    in let st2 = sp-set-col st col-idx trimmed
    in SpiderState { col0 = st2.col0, col1 = st2.col1, col2 = st2.col2, col3 = st2.col3,
                     col4 = st2.col4, col5 = st2.col5, col6 = st2.col6, col7 = st2.col7,
                     col8 = st2.col8, col9 = st2.col9, stock = st2.stock,
                     completed-suits = st2.completed-suits + 1, moves = st2.moves }

Section: Stock Deal

  sp-deal-stock : SpiderState -> SpiderState
  sp-deal-stock (st) =
    let n = list-length (st.stock)
    in if n < 10 then st
    else let st2 = sp-deal-one st 0 0
    in let st3 = sp-deal-one st2 1 1
    in let st4 = sp-deal-one st3 2 2
    in let st5 = sp-deal-one st4 3 3
    in let st6 = sp-deal-one st5 4 4
    in let st7 = sp-deal-one st6 5 5
    in let st8 = sp-deal-one st7 6 6
    in let st9 = sp-deal-one st8 7 7
    in let st10 = sp-deal-one st9 8 8
    in let st11 = sp-deal-one st10 9 9
    in let new-stock = sp-drop-from-end (st11.stock) 10
    in SpiderState { col0 = st11.col0, col1 = st11.col1, col2 = st11.col2, col3 = st11.col3,
                     col4 = st11.col4, col5 = st11.col5, col6 = st11.col6, col7 = st11.col7,
                     col8 = st11.col8, col9 = st11.col9, stock = new-stock,
                     completed-suits = st11.completed-suits, moves = st11.moves }

  sp-deal-one : SpiderState, Integer, Integer -> SpiderState
  sp-deal-one (st) (col-idx) (stock-idx) =
    let sn = list-length (st.stock)
    in if stock-idx >= sn then st
    else let card = list-at (st.stock) (sn - 1 - stock-idx)
    in let col = sp-get-col st col-idx
    in let col2 = list-push col card
    in sp-set-col st col-idx col2

Section: AI — Greedy Solver

  sp-find-best-move : SpiderState -> Integer
  sp-find-best-move (st) =
    let suit-move = sp-find-completing-move st 0
    in if suit-move >= 0 then suit-move
    else sp-find-any-move st 0

  sp-find-completing-move : SpiderState, Integer -> Integer
  sp-find-completing-move (st) (from-c) =
    if from-c >= 10 then (-1)
    else let col = sp-get-col st from-c
    in let n = list-length col
    in if n == 0 then sp-find-completing-move st (from-c + 1)
    else let seq-start = n - sp-seq-len col (n - 1)
    in let m = sp-find-target-completing st from-c seq-start 0
    in if m >= 0 then m
    else sp-find-completing-move st (from-c + 1)

  sp-find-target-completing : SpiderState, Integer, Integer, Integer -> Integer
  sp-find-target-completing (st) (from-c) (seq-start) (to-c) =
    if to-c >= 10 then (-1)
    else if to-c == from-c then sp-find-target-completing st from-c seq-start (to-c + 1)
    else let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in if sp-can-move from-col to-col seq-start == False then
      sp-find-target-completing st from-c seq-start (to-c + 1)
    else let score = sp-move-score st from-c seq-start to-c
    in if score >= 100 then from-c * 1000 + seq-start * 10 + to-c
    else sp-find-target-completing st from-c seq-start (to-c + 1)

  sp-find-any-move : SpiderState, Integer -> Integer
  sp-find-any-move (st) (from-c) =
    if from-c >= 10 then (-1)
    else let col = sp-get-col st from-c
    in let n = list-length col
    in if n == 0 then sp-find-any-move st (from-c + 1)
    else let seq-start = n - sp-seq-len col (n - 1)
    in let m = sp-find-any-target st from-c seq-start 0
    in if m >= 0 then m
    else sp-find-any-move st (from-c + 1)

  sp-find-any-target : SpiderState, Integer, Integer, Integer -> Integer
  sp-find-any-target (st) (from-c) (seq-start) (to-c) =
    if to-c >= 10 then (-1)
    else if to-c == from-c then sp-find-any-target st from-c seq-start (to-c + 1)
    else let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in if sp-can-move from-col to-col seq-start == False then
      sp-find-any-target st from-c seq-start (to-c + 1)
    else from-c * 1000 + seq-start * 10 + to-c

  sp-move-score : SpiderState, Integer, Integer, Integer -> Integer
  sp-move-score (st) (from-c) (seq-start) (to-c) =
    let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in let to-n = list-length to-col
    in if to-n == 0 then 10
    else let top-to = list-at to-col (to-n - 1)
    in let top-from = list-at from-col seq-start
    in let suit-match = sp-suit top-from == sp-suit top-to
    in if suit-match then 100 else 10

  sp-decode-move : Integer -> SpiderMove
  sp-decode-move (code) =
    let from-c = code / 1000
    in let rem = rng-mod code 1000
    in let seq-start = rem / 10
    in let to-c = rng-mod rem 10
    in SpiderMove { from-col = from-c, seq-start = seq-start, to-col = to-c }

Section: Game Runner

  run-spider-game : Integer -> SpiderResult
  run-spider-game (seed) =
    let st = spider-new seed
    in spider-loop st 0

  spider-loop : SpiderState, Integer -> SpiderResult
  spider-loop (st) (deals-used) =
    if st.completed-suits >= 8 then
      SpiderResult { completed-suits = st.completed-suits, moves = st.moves, won = True }
    else if st.moves > 500 then
      SpiderResult { completed-suits = st.completed-suits, moves = st.moves, won = False }
    else let move-code = sp-find-best-move st
    in if move-code >= 0 then
      let m = sp-decode-move move-code
      in let st2 = sp-apply-move st m
      in spider-loop st2 deals-used
    else if deals-used < 5 & list-length (st.stock) >= 10 then
      let st2 = sp-deal-stock st
      in spider-loop st2 (deals-used + 1)
    else SpiderResult { completed-suits = st.completed-suits, moves = st.moves, won = False }

Section: Formatting

  format-spider-result : SpiderResult -> Text
  format-spider-result (r) =
    let status = if r.won then "Won!" else "Incomplete"
    in "Spider Solitaire (2-suit): " & status &
       " suits=" & show (r.completed-suits) & "/8" &
       " moves=" & show (r.moves)

Page 1


Chapter: Games--Risk
  cites Games chapter Rng

 Simplified Risk: 12 territories in 4 continents (3 territories each).
 Territories 0-2: Continent A, 3-5: Continent B, 6-8: Continent C, 9-11: Continent D.
 Each continent bonus = 2 armies. Adjacency is hardcoded.
 Turn: reinforcements (territories/3 + continent bonuses, min 3), attack
 weakest adjacent enemy (attacker up to 3 dice, defender up to 2,
 compare sorted descending — attacker wins ties go to defender), fortify.
 Win when one player owns all territories.

 We say:

Section: Types

  RiskTerritory = record {
    owner  : Integer,
    armies : Integer
  }

  RiskPlayer = record {
    id          : Integer,
    alive       : Boolean,
    total-armies : Integer
  }

  RiskState = record {
    territories    : List RiskTerritory,
    players        : List RiskPlayer,
    current-player : Integer,
    turn-number    : Integer,
    game-over      : Boolean,
    winner         : Integer,
    num-players    : Integer
  }

  RiskResult = record {
    winner      : Integer,
    turns       : Integer,
    territories : List Integer
  }

Section: Adjacency

 12 territories. Adjacency pairs encoded as flat list of pairs:
 (from, to). Adjacency is symmetric.

  risk-adjacent : Integer, Integer -> Boolean
  risk-adjacent (a) (b) =
    risk-adj-check a b | risk-adj-check b a

  risk-adj-check : Integer, Integer -> Boolean
  risk-adj-check (a) (b) =
    if a == 0  then b == 1 | b == 3 | b == 9
    else if a == 1  then b == 2 | b == 4
    else if a == 2  then b == 5 | b == 11
    else if a == 3  then b == 4 | b == 6
    else if a == 4  then b == 5 | b == 7
    else if a == 5  then b == 8
    else if a == 6  then b == 7 | b == 9
    else if a == 7  then b == 8 | b == 10
    else if a == 8  then b == 11
    else if a == 9  then b == 10
    else if a == 10 then b == 11
    else False

Section: Continent Bonus

  risk-continent : Integer -> Integer
  risk-continent (t) = t / 3

  risk-continent-bonus : RiskState, Integer -> Integer
  risk-continent-bonus (s) (player) =
    risk-check-continents s player 0 0

  risk-check-continents : RiskState, Integer, Integer, Integer -> Integer
  risk-check-continents (s) (player) (continent) (bonus) =
    if continent >= 4 then bonus
    else let owned = risk-owns-continent s player continent
    in let b = if owned then 2 else 0
    in risk-check-continents s player (continent + 1) (bonus + b)

  risk-owns-continent : RiskState, Integer, Integer -> Boolean
  risk-owns-continent (s) (player) (continent) =
    risk-owns-cont-loop s player continent 0

  risk-owns-cont-loop : RiskState, Integer, Integer, Integer -> Boolean
  risk-owns-cont-loop (s) (player) (continent) (i) =
    if i >= 12 then True
    else if risk-continent i /= continent then risk-owns-cont-loop s player continent (i + 1)
    else let t = list-at (s.territories) i
    in if t.owner /= player then False
    else risk-owns-cont-loop s player continent (i + 1)

Section: Initialization

  risk-init : Integer, Integer -> RiskState
  risk-init (seed) (num-players) =
    let np = if num-players < 2 then 2 else if num-players > 4 then 4 else num-players
    in let terrs = risk-assign-territories np (rng-new seed)
    in let players = risk-build-players np 0 []
    in let s0 = RiskState {
         territories = terrs,
         players = players,
         current-player = 0,
         turn-number = 0,
         game-over = False,
         winner = (-1),
         num-players = np
       }
    in risk-update-army-counts s0

  risk-assign-territories : Integer, Rng -> List RiskTerritory
  risk-assign-territories (np) (r) =
    risk-assign-loop np r 0 []

  risk-assign-loop : Integer, Rng, Integer, List RiskTerritory -> List RiskTerritory
  risk-assign-loop (np) (r) (i) (acc) =
    if i >= 12 then acc
    else let r2 = rng-next r
    in let owner = rng-mod i np
    in let t = RiskTerritory { owner = owner, armies = 3 }
    in risk-assign-loop np r2 (i + 1) (list-push acc t)

  risk-build-players : Integer, Integer, List RiskPlayer -> List RiskPlayer
  risk-build-players (np) (i) (acc) =
    if i >= np then acc
    else let p = RiskPlayer { id = i, alive = True, total-armies = 0 }
    in risk-build-players np (i + 1) (list-push acc p)

  risk-update-army-counts : RiskState -> RiskState
  risk-update-army-counts (s) =
    let players2 = risk-recount-players s 0 (s.players)
    in RiskState {
         territories = s.territories,
         players = players2,
         current-player = s.current-player,
         turn-number = s.turn-number,
         game-over = s.game-over,
         winner = s.winner,
         num-players = s.num-players
       }

  risk-recount-players : RiskState, Integer, List RiskPlayer -> List RiskPlayer
  risk-recount-players (s) (i) (players) =
    if i >= s.num-players then players
    else let count = risk-count-armies s i
    in let p = list-at players i
    in let new-p = RiskPlayer { id = p.id, alive = count > 0, total-armies = count }
    in risk-recount-players s (i + 1) (list-set-at players i new-p)

  risk-count-armies : RiskState, Integer -> Integer
  risk-count-armies (s) (player) =
    risk-count-loop s player 0 0

  risk-count-loop : RiskState, Integer, Integer, Integer -> Integer
  risk-count-loop (s) (player) (i) (acc) =
    if i >= 12 then acc
    else let t = list-at (s.territories) i
    in let delta = if t.owner == player then t.armies else 0
    in risk-count-loop s player (i + 1) (acc + delta)

Section: Territory Helpers

  risk-get-terr : RiskState, Integer -> RiskTerritory
  risk-get-terr (s) (i) = list-at (s.territories) i

  risk-set-terr : RiskState, Integer, RiskTerritory -> RiskState
  risk-set-terr (s) (i) (t) =
    RiskState {
      territories = list-set-at (s.territories) i t,
      players = s.players,
      current-player = s.current-player,
      turn-number = s.turn-number,
      game-over = s.game-over,
      winner = s.winner,
      num-players = s.num-players
    }

  risk-count-player-territories : RiskState, Integer -> Integer
  risk-count-player-territories (s) (player) =
    risk-terr-count-loop s player 0 0

  risk-terr-count-loop : RiskState, Integer, Integer, Integer -> Integer
  risk-terr-count-loop (s) (player) (i) (acc) =
    if i >= 12 then acc
    else let t = list-at (s.territories) i
    in let delta = if t.owner == player then 1 else 0
    in risk-terr-count-loop s player (i + 1) (acc + delta)

Section: Reinforcements

  risk-calc-reinforcements : RiskState, Integer -> Integer
  risk-calc-reinforcements (s) (player) =
    let terr-count = risk-count-player-territories s player
    in let base = if terr-count / 3 < 3 then 3 else terr-count / 3
    in let bonus = risk-continent-bonus s player
    in base + bonus

  risk-place-reinforcements : RiskState, Integer, Integer -> RiskState
  risk-place-reinforcements (s) (player) (armies) =
    let best-terr = risk-find-border-territory s player
    in if best-terr < 0 then s
    else let t = risk-get-terr s best-terr
    in let new-t = RiskTerritory { owner = t.owner, armies = t.armies + armies }
    in risk-set-terr s best-terr new-t

  risk-find-border-territory : RiskState, Integer -> Integer
  risk-find-border-territory (s) (player) =
    risk-border-loop s player 0 (-1) 999999

  risk-border-loop : RiskState, Integer, Integer, Integer, Integer -> Integer
  risk-border-loop (s) (player) (i) (best) (best-ratio) =
    if i >= 12 then best
    else let t = list-at (s.territories) i
    in if t.owner /= player then risk-border-loop s player (i + 1) best best-ratio
    else if risk-has-enemy-neighbor s player i == False then risk-border-loop s player (i + 1) best best-ratio
    else if t.armies < best-ratio then risk-border-loop s player (i + 1) i t.armies
    else risk-border-loop s player (i + 1) best best-ratio

  risk-has-enemy-neighbor : RiskState, Integer, Integer -> Boolean
  risk-has-enemy-neighbor (s) (player) (terr) =
    risk-enemy-neighbor-loop s player terr 0

  risk-enemy-neighbor-loop : RiskState, Integer, Integer, Integer -> Boolean
  risk-enemy-neighbor-loop (s) (player) (terr) (i) =
    if i >= 12 then False
    else if risk-adjacent terr i == False then risk-enemy-neighbor-loop s player terr (i + 1)
    else let t = list-at (s.territories) i
    in if t.owner /= player then True
    else risk-enemy-neighbor-loop s player terr (i + 1)

Section: Attack Dice

  risk-roll-dice : Rng, Integer -> Integer
  risk-roll-dice (r) (n) =
    rng-range r 1 6

  risk-attack-result : Rng, Integer, Integer -> RiskState -> RiskState
  risk-attack-result (r) (atk-terr) (def-terr) (s) =
    let atk-t = risk-get-terr s atk-terr
    in let def-t = risk-get-terr s def-terr
    in let atk-dice = if atk-t.armies - 1 >= 3 then 3 else atk-t.armies - 1
    in let def-dice = if def-t.armies >= 2 then 2 else def-t.armies
    in if atk-dice <= 0 then s
    else
      let r2 = rng-next r
      in let r3 = rng-next r2
      in let r4 = rng-next r3
      in let r5 = rng-next r4
      in let r6 = rng-next r5
      in let a1 = rng-range r2 1 6
      in let a2 = if atk-dice >= 2 then rng-range r3 1 6 else 0
      in let a3 = if atk-dice >= 3 then rng-range r4 1 6 else 0
      in let d1 = rng-range r5 1 6
      in let d2 = if def-dice >= 2 then rng-range r6 1 6 else 0
      in let atk-best = if a1 >= a2 & a1 >= a3 then a1 else if a2 >= a3 then a2 else a3
      in let atk-second = if a1 >= a2 & a1 >= a3 then
             if a2 >= a3 then a2 else a3
           else if a2 >= a3 then
             if a1 >= a3 then a1 else a3
           else if a1 >= a2 then a1 else a2
      in let def-best = if d1 >= d2 then d1 else d2
      in let def-second = if d1 >= d2 then d2 else d1
      in let atk-loses-best = if atk-best > def-best then 0 else 1
      in let def-loses-best = if atk-best > def-best then 1 else 0
      in let atk-loses-second = if def-dice >= 2 & atk-dice >= 2 then
             if atk-second > def-second then 0 else 1
           else 0
      in let def-loses-second = if def-dice >= 2 & atk-dice >= 2 then
             if atk-second > def-second then 1 else 0
           else 0
      in let atk-losses = atk-loses-best + atk-loses-second
      in let def-losses = def-loses-best + def-loses-second
      in let new-atk-armies = atk-t.armies - atk-losses
      in let new-def-armies = def-t.armies - def-losses
      in let new-atk-t = RiskTerritory { owner = atk-t.owner, armies = new-atk-armies }
      in if new-def-armies <= 0 then
        let conquer-armies = if new-atk-armies - 1 > atk-dice then atk-dice else new-atk-armies - 1
        in let remain-atk = new-atk-armies - conquer-armies
        in let new-atk2 = RiskTerritory { owner = atk-t.owner, armies = remain-atk }
        in let new-def = RiskTerritory { owner = atk-t.owner, armies = conquer-armies }
        in let s2 = risk-set-terr s atk-terr new-atk2
        in risk-set-terr s2 def-terr new-def
      else
        let new-def-t = RiskTerritory { owner = def-t.owner, armies = new-def-armies }
        in let s2 = risk-set-terr s atk-terr new-atk-t
        in risk-set-terr s2 def-terr new-def-t

Section: AI Strategy

  risk-find-attack : RiskState, Integer -> Integer
  risk-find-attack (s) (player) =
    risk-find-attack-loop s player 0 (-1) 0

  risk-find-attack-loop : RiskState, Integer, Integer, Integer, Integer -> Integer
  risk-find-attack-loop (s) (player) (i) (best-def) (best-def-armies) =
    if i >= 12 then best-def
    else let t = list-at (s.territories) i
    in if t.owner /= player then risk-find-attack-loop s player (i + 1) best-def best-def-armies
    else if t.armies < 2 then risk-find-attack-loop s player (i + 1) best-def best-def-armies
    else
      let weak-enemy = risk-weakest-enemy-neighbor s player i
      in if weak-enemy < 0 then risk-find-attack-loop s player (i + 1) best-def best-def-armies
      else let enemy-t = list-at (s.territories) weak-enemy
      in if best-def < 0 | enemy-t.armies < best-def-armies then
        risk-find-attack-loop s player (i + 1) weak-enemy enemy-t.armies
      else risk-find-attack-loop s player (i + 1) best-def best-def-armies

  risk-find-attack-from : RiskState, Integer, Integer -> Integer
  risk-find-attack-from (s) (player) (def-terr) =
    risk-find-from-loop s player def-terr 0 (-1) 0

  risk-find-from-loop : RiskState, Integer, Integer, Integer, Integer, Integer -> Integer
  risk-find-from-loop (s) (player) (def-terr) (i) (best-atk) (best-armies) =
    if i >= 12 then best-atk
    else let t = list-at (s.territories) i
    in if t.owner /= player then risk-find-from-loop s player def-terr (i + 1) best-atk best-armies
    else if t.armies < 2 then risk-find-from-loop s player def-terr (i + 1) best-atk best-armies
    else if risk-adjacent i def-terr == False then risk-find-from-loop s player def-terr (i + 1) best-atk best-armies
    else if t.armies > best-armies then risk-find-from-loop s player def-terr (i + 1) i t.armies
    else risk-find-from-loop s player def-terr (i + 1) best-atk best-armies

  risk-weakest-enemy-neighbor : RiskState, Integer, Integer -> Integer
  risk-weakest-enemy-neighbor (s) (player) (terr) =
    risk-weakest-loop s player terr 0 (-1) 999999

  risk-weakest-loop : RiskState, Integer, Integer, Integer, Integer, Integer -> Integer
  risk-weakest-loop (s) (player) (terr) (i) (best) (best-armies) =
    if i >= 12 then best
    else if risk-adjacent terr i == False then risk-weakest-loop s player terr (i + 1) best best-armies
    else let t = list-at (s.territories) i
    in if t.owner == player then risk-weakest-loop s player terr (i + 1) best best-armies
    else if t.armies < best-armies then risk-weakest-loop s player terr (i + 1) i t.armies
    else risk-weakest-loop s player terr (i + 1) best best-armies

Section: Turn

  risk-do-turn : RiskState, Rng -> RiskState
  risk-do-turn (s) (r) =
    if s.game-over then s
    else let player = s.current-player
    in let p = list-at (s.players) player
    in if p.alive == False then risk-advance-player s
    else
      let reinf = risk-calc-reinforcements s player
      in let s2 = risk-place-reinforcements s player reinf
      in let s3 = risk-do-attacks s2 player r 0
      in let s4 = risk-update-alive s3
      in let s5 = risk-check-winner s4
      in risk-advance-player s5

  risk-do-attacks : RiskState, Integer, Rng, Integer -> RiskState
  risk-do-attacks (s) (player) (r) (attack-count) =
    if s.game-over then s
    else if attack-count >= 3 then s
    else let def-terr = risk-find-attack s player
    in if def-terr < 0 then s
    else let atk-terr = risk-find-attack-from s player def-terr
    in if atk-terr < 0 then s
    else let r2 = rng-next r
    in let s2 = risk-attack-result r2 atk-terr def-terr s
    in risk-do-attacks s2 player r2 (attack-count + 1)

  risk-update-alive : RiskState -> RiskState
  risk-update-alive (s) =
    let players2 = risk-recount-players s 0 (s.players)
    in RiskState {
         territories = s.territories,
         players = players2,
         current-player = s.current-player,
         turn-number = s.turn-number,
         game-over = s.game-over,
         winner = s.winner,
         num-players = s.num-players
       }

  risk-check-winner : RiskState -> RiskState
  risk-check-winner (s) =
    let alive-count = risk-count-alive s
    in if alive-count <= 1 then
      let w = risk-find-alive s
      in RiskState {
           territories = s.territories,
           players = s.players,
           current-player = s.current-player,
           turn-number = s.turn-number,
           game-over = True,
           winner = w,
           num-players = s.num-players
         }
    else s

  risk-count-alive : RiskState -> Integer
  risk-count-alive (s) =
    risk-alive-loop s 0 0

  risk-alive-loop : RiskState, Integer, Integer -> Integer
  risk-alive-loop (s) (i) (acc) =
    if i >= s.num-players then acc
    else let p = list-at (s.players) i
    in let delta = if p.alive then 1 else 0
    in risk-alive-loop s (i + 1) (acc + delta)

  risk-find-alive : RiskState -> Integer
  risk-find-alive (s) =
    risk-find-alive-loop s 0

  risk-find-alive-loop : RiskState, Integer -> Integer
  risk-find-alive-loop (s) (i) =
    if i >= s.num-players then (-1)
    else let p = list-at (s.players) i
    in if p.alive then i
    else risk-find-alive-loop s (i + 1)

  risk-advance-player : RiskState -> RiskState
  risk-advance-player (s) =
    let next = rng-mod (s.current-player + 1) s.num-players
    in RiskState {
         territories = s.territories,
         players = s.players,
         current-player = next,
         turn-number = s.turn-number + 1,
         game-over = s.game-over,
         winner = s.winner,
         num-players = s.num-players
       }

Section: Game Runner

  run-risk-game : Integer, Integer -> RiskResult
  run-risk-game (seed) (num-players) =
    let s = risk-init seed num-players
    in risk-loop s (rng-new seed) 0

  risk-loop : RiskState, Rng, Integer -> RiskResult
  risk-loop (s) (r) (turns) =
    if s.game-over then risk-make-result s turns
    else if turns > 400 then risk-make-result s turns
    else let r2 = rng-next r
    in risk-loop (risk-do-turn s r2) r2 (turns + 1)

  risk-make-result : RiskState, Integer -> RiskResult
  risk-make-result (s) (turns) =
    let w = if s.winner >= 0 then s.winner else risk-find-alive s
    in let terr-list = risk-collect-owners s 0 []
    in RiskResult { winner = w, turns = turns, territories = terr-list }

  risk-collect-owners : RiskState, Integer, List Integer -> List Integer
  risk-collect-owners (s) (i) (acc) =
    if i >= 12 then acc
    else let t = list-at (s.territories) i
    in risk-collect-owners s (i + 1) (list-push acc t.owner)

Section: Formatting

  format-risk-result : RiskResult -> Text
  format-risk-result (r) =
    let w = if r.winner < 0 then "None" else "P" & show (r.winner + 1)
    in "Risk (12 territories, " & show r.turns & " turns): winner=" & w

Page 1


Chapter: Games--Monopoly
  cites Games chapter Rng

 Simplified Monopoly: 40 board spaces, 2-4 players. Properties have
 color groups and rent. No houses or hotels. Players roll 2d6, move,
 and take landing actions: buy unowned property if affordable, pay rent
 if owned by another, go to jail on space 30, collect $200 passing Go.
 Bankruptcy ends the game. AI always buys if affordable.

 Board spaces 0-39. Properties occupy specific slots. Color groups
 0-7 correspond to standard Monopoly color sets (2-3 properties each).
 Rent = base-rent * 2 if owner holds all in group.

 We say:

Section: Types

  MonopolyPlayer = record {
    position         : Integer,
    cash             : Integer,
    owned-properties : List Integer,
    in-jail          : Boolean,
    jail-turns       : Integer
  }

  PropertyState = record {
    owner      : Integer,
    cost       : Integer,
    base-rent  : Integer,
    color      : Integer
  }

  MonopolyState = record {
    players        : List MonopolyPlayer,
    properties     : List PropertyState,
    current-player : Integer,
    turn-number    : Integer,
    game-over      : Boolean,
    winner         : Integer,
    num-players    : Integer
  }

  MonopolyResult = record {
    winner      : Integer,
    turns       : Integer,
    final-cash  : List Integer
  }

Section: Board Data

 40 spaces. Properties at specific indices. Non-property spaces: 0=Go,
 2=CommunityChest, 4=Tax, 5=Railroad, 7=Chance, 10=Jail/Visiting,
 17=CommunityChest, 20=FreeParking, 22=Chance, 25=Railroad, 28=Utility,
 30=GoToJail, 33=CommunityChest, 35=Railroad, 36=Chance, 38=Tax, 40 wraps.

  mono-is-property : Integer -> Boolean
  mono-is-property (space) =
    if space == 1 then True
    else if space == 3 then True
    else if space == 6 then True
    else if space == 8 then True
    else if space == 9 then True
    else if space == 11 then True
    else if space == 13 then True
    else if space == 14 then True
    else if space == 16 then True
    else if space == 18 then True
    else if space == 19 then True
    else if space == 21 then True
    else if space == 23 then True
    else if space == 24 then True
    else if space == 26 then True
    else if space == 27 then True
    else if space == 29 then True
    else if space == 31 then True
    else if space == 32 then True
    else if space == 34 then True
    else if space == 37 then True
    else if space == 39 then True
    else False

  mono-prop-index : Integer -> Integer
  mono-prop-index (space) =
    if space == 1  then 0
    else if space == 3  then 1
    else if space == 6  then 2
    else if space == 8  then 3
    else if space == 9  then 4
    else if space == 11 then 5
    else if space == 13 then 6
    else if space == 14 then 7
    else if space == 16 then 8
    else if space == 18 then 9
    else if space == 19 then 10
    else if space == 21 then 11
    else if space == 23 then 12
    else if space == 24 then 13
    else if space == 26 then 14
    else if space == 27 then 15
    else if space == 29 then 16
    else if space == 31 then 17
    else if space == 32 then 18
    else if space == 34 then 19
    else if space == 37 then 20
    else if space == 39 then 21
    else (-1)

  mono-prop-cost : Integer -> Integer
  mono-prop-cost (pi) =
    if pi == 0  then 60
    else if pi == 1  then 60
    else if pi == 2  then 100
    else if pi == 3  then 100
    else if pi == 4  then 120
    else if pi == 5  then 140
    else if pi == 6  then 140
    else if pi == 7  then 160
    else if pi == 8  then 180
    else if pi == 9  then 180
    else if pi == 10 then 200
    else if pi == 11 then 220
    else if pi == 12 then 220
    else if pi == 13 then 240
    else if pi == 14 then 260
    else if pi == 15 then 260
    else if pi == 16 then 280
    else if pi == 17 then 300
    else if pi == 18 then 300
    else if pi == 19 then 320
    else if pi == 20 then 350
    else 400

  mono-prop-rent : Integer -> Integer
  mono-prop-rent (pi) =
    if pi == 0  then 2
    else if pi == 1  then 4
    else if pi == 2  then 6
    else if pi == 3  then 6
    else if pi == 4  then 8
    else if pi == 5  then 10
    else if pi == 6  then 10
    else if pi == 7  then 12
    else if pi == 8  then 14
    else if pi == 9  then 14
    else if pi == 10 then 16
    else if pi == 11 then 18
    else if pi == 12 then 18
    else if pi == 13 then 20
    else if pi == 14 then 22
    else if pi == 15 then 22
    else if pi == 16 then 24
    else if pi == 17 then 26
    else if pi == 18 then 26
    else if pi == 19 then 28
    else if pi == 20 then 35
    else 50

  mono-prop-color : Integer -> Integer
  mono-prop-color (pi) =
    if pi <= 1  then 0
    else if pi <= 4  then 1
    else if pi <= 7  then 2
    else if pi <= 10 then 3
    else if pi <= 13 then 4
    else if pi <= 16 then 5
    else if pi <= 19 then 6
    else 7

Section: Initialization

  mono-build-properties : Integer, List PropertyState -> List PropertyState
  mono-build-properties (i) (acc) =
    if i >= 22 then acc
    else let ps = PropertyState {
           owner = (-1),
           cost = mono-prop-cost i,
           base-rent = mono-prop-rent i,
           color = mono-prop-color i
         }
    in mono-build-properties (i + 1) (list-push acc ps)

  mono-build-zeroes : Integer, Integer, List Integer -> List Integer
  mono-build-zeroes (i) (n) (acc) =
    if i >= n then acc
    else mono-build-zeroes (i + 1) n (list-push acc 0)

  mono-build-players : Integer, Integer, List MonopolyPlayer -> List MonopolyPlayer
  mono-build-players (i) (np) (acc) =
    if i >= np then acc
    else let p = MonopolyPlayer {
           position = 0,
           cash = 1500,
           owned-properties = [],
           in-jail = False,
           jail-turns = 0
         }
    in mono-build-players (i + 1) np (list-push acc p)

  mono-init : Integer, Integer -> MonopolyState
  mono-init (seed) (num-players) =
    let np = if num-players < 2 then 2 else if num-players > 4 then 4 else num-players
    in let props = mono-build-properties 0 []
    in let players = mono-build-players 0 np []
    in MonopolyState {
         players = players,
         properties = props,
         current-player = 0,
         turn-number = 0,
         game-over = False,
         winner = (-1),
         num-players = np
       }

Section: Player Helpers

  mono-get-player : MonopolyState, Integer -> MonopolyPlayer
  mono-get-player (s) (i) = list-at (s.players) i

  mono-set-player : MonopolyState, Integer, MonopolyPlayer -> MonopolyState
  mono-set-player (s) (i) (p) =
    MonopolyState {
      players = list-set-at (s.players) i p,
      properties = s.properties,
      current-player = s.current-player,
      turn-number = s.turn-number,
      game-over = s.game-over,
      winner = s.winner,
      num-players = s.num-players
    }

  mono-get-prop : MonopolyState, Integer -> PropertyState
  mono-get-prop (s) (i) = list-at (s.properties) i

  mono-set-prop : MonopolyState, Integer, PropertyState -> MonopolyState
  mono-set-prop (s) (i) (ps) =
    MonopolyState {
      players = s.players,
      properties = list-set-at (s.properties) i ps,
      current-player = s.current-player,
      turn-number = s.turn-number,
      game-over = s.game-over,
      winner = s.winner,
      num-players = s.num-players
    }

Section: Color Group Check

  mono-color-group-size : Integer -> Integer
  mono-color-group-size (color) =
    if color == 0 then 2
    else if color == 7 then 2
    else 3

  mono-player-owns-color : MonopolyState, Integer, Integer -> Integer
  mono-player-owns-color (s) (player) (color) =
    mono-count-color-owned s player color 0 0

  mono-count-color-owned : MonopolyState, Integer, Integer, Integer, Integer -> Integer
  mono-count-color-owned (s) (player) (color) (pi) (acc) =
    if pi >= 22 then acc
    else let ps = mono-get-prop s pi
    in let delta = if ps.owner == player & ps.color == color then 1 else 0
    in mono-count-color-owned s player color (pi + 1) (acc + delta)

  mono-has-monopoly : MonopolyState, Integer, Integer -> Boolean
  mono-has-monopoly (s) (player) (color) =
    let owned = mono-player-owns-color s player color
    in let needed = mono-color-group-size color
    in owned >= needed

Section: Landing Actions

  mono-pay : MonopolyState, Integer, Integer, Integer -> MonopolyState
  mono-pay (s) (payer) (receiver) (amount) =
    let p = mono-get-player s payer
    in let actual = if p.cash < amount then p.cash else amount
    in let new-payer = MonopolyPlayer {
           position = p.position,
           cash = p.cash - actual,
           owned-properties = p.owned-properties,
           in-jail = p.in-jail,
           jail-turns = p.jail-turns
         }
    in let s2 = mono-set-player s payer new-payer
    in if receiver >= 0 then
      let r = mono-get-player s2 receiver
      in let new-rec = MonopolyPlayer {
             position = r.position,
             cash = r.cash + actual,
             owned-properties = r.owned-properties,
             in-jail = r.in-jail,
             jail-turns = r.jail-turns
           }
      in mono-set-player s2 receiver new-rec
    else s2

  mono-buy-property : MonopolyState, Integer, Integer -> MonopolyState
  mono-buy-property (s) (player) (pi) =
    let ps = mono-get-prop s pi
    in let p = mono-get-player s player
    in if p.cash < ps.cost then s
    else let new-p = MonopolyPlayer {
           position = p.position,
           cash = p.cash - ps.cost,
           owned-properties = list-push (p.owned-properties) pi,
           in-jail = p.in-jail,
           jail-turns = p.jail-turns
         }
    in let new-ps = PropertyState {
           owner = player,
           cost = ps.cost,
           base-rent = ps.base-rent,
           color = ps.color
         }
    in let s2 = mono-set-player s player new-p
    in mono-set-prop s2 pi new-ps

  mono-land : MonopolyState, Integer, Integer -> MonopolyState
  mono-land (s) (player) (space) =
    if space == 30 then
      let p = mono-get-player s player
      in let new-p = MonopolyPlayer {
             position = 10,
             cash = p.cash,
             owned-properties = p.owned-properties,
             in-jail = True,
             jail-turns = 0
           }
      in mono-set-player s player new-p
    else if mono-is-property space then
      let pi = mono-prop-index space
      in let ps = mono-get-prop s pi
      in if ps.owner < 0 then
        let p = mono-get-player s player
        in if p.cash >= ps.cost then mono-buy-property s player pi
        else s
      else if ps.owner == player then s
      else
        let monopoly = mono-has-monopoly s ps.owner ps.color
        in let rent = if monopoly then ps.base-rent * 2 else ps.base-rent
        in mono-pay s player ps.owner rent
    else s

Section: Bankruptcy Check

  mono-check-bankrupt : MonopolyState -> MonopolyState
  mono-check-bankrupt (s) =
    mono-bankrupt-loop s 0

  mono-bankrupt-loop : MonopolyState, Integer -> MonopolyState
  mono-bankrupt-loop (s) (i) =
    if i >= s.num-players then s
    else let p = mono-get-player s i
    in if p.cash <= 0 then
      MonopolyState {
        players = s.players,
        properties = s.properties,
        current-player = s.current-player,
        turn-number = s.turn-number,
        game-over = True,
        winner = mono-richest s i,
        num-players = s.num-players
      }
    else mono-bankrupt-loop s (i + 1)

  mono-richest : MonopolyState, Integer -> Integer
  mono-richest (s) (bankrupt) =
    mono-richest-loop s bankrupt 0 0 (-1)

  mono-richest-loop : MonopolyState, Integer, Integer, Integer, Integer -> Integer
  mono-richest-loop (s) (bankrupt) (i) (best-cash) (best-player) =
    if i >= s.num-players then best-player
    else if i == bankrupt then mono-richest-loop s bankrupt (i + 1) best-cash best-player
    else let p = mono-get-player s i
    in if p.cash > best-cash then mono-richest-loop s bankrupt (i + 1) p.cash i
    else mono-richest-loop s bankrupt (i + 1) best-cash best-player

Section: Turn

  mono-do-turn : MonopolyState, Rng -> MonopolyState
  mono-do-turn (s) (r) =
    if s.game-over then s
    else let player = s.current-player
    in let p = mono-get-player s player
    in let r2 = rng-next r
    in let r3 = rng-next r2
    in let die1 = rng-range r2 1 6
    in let die2 = rng-range r3 1 6
    in let roll = die1 + die2
    in if p.in-jail then
      let new-p = MonopolyPlayer {
            position = p.position,
            cash = p.cash,
            owned-properties = p.owned-properties,
            in-jail = if p.jail-turns >= 2 then False else True,
            jail-turns = if p.jail-turns >= 2 then 0 else p.jail-turns + 1
          }
      in let s2 = mono-set-player s player new-p
      in mono-advance-turn (mono-check-bankrupt s2)
    else
      let new-pos = rng-mod (p.position + roll) 40
      in let passed-go = p.position + roll >= 40
      in let bonus = if passed-go then 200 else 0
      in let new-p = MonopolyPlayer {
             position = new-pos,
             cash = p.cash + bonus,
             owned-properties = p.owned-properties,
             in-jail = False,
             jail-turns = 0
           }
      in let s2 = mono-set-player s player new-p
      in let s3 = mono-land s2 player new-pos
      in mono-advance-turn (mono-check-bankrupt s3)

  mono-advance-turn : MonopolyState -> MonopolyState
  mono-advance-turn (s) =
    let next = rng-mod (s.current-player + 1) s.num-players
    in MonopolyState {
         players = s.players,
         properties = s.properties,
         current-player = next,
         turn-number = s.turn-number + 1,
         game-over = s.game-over,
         winner = s.winner,
         num-players = s.num-players
       }

Section: Game Runner

  run-monopoly-game : Integer, Integer -> MonopolyResult
  run-monopoly-game (seed) (num-players) =
    let s = mono-init seed num-players
    in mono-loop s (rng-new seed) 0

  mono-loop : MonopolyState, Rng, Integer -> MonopolyResult
  mono-loop (s) (r) (turns) =
    if s.game-over then mono-make-result s turns
    else if turns > 600 then mono-make-result s turns
    else let r2 = rng-next r
    in mono-loop (mono-do-turn s r2) r2 (turns + 1)

  mono-make-result : MonopolyState, Integer -> MonopolyResult
  mono-make-result (s) (turns) =
    let w = if s.winner >= 0 then s.winner else mono-richest s (-1)
    in let cash-list = mono-collect-cash s 0 []
    in MonopolyResult { winner = w, turns = turns, final-cash = cash-list }

  mono-collect-cash : MonopolyState, Integer, List Integer -> List Integer
  mono-collect-cash (s) (i) (acc) =
    if i >= s.num-players then acc
    else let p = mono-get-player s i
    in mono-collect-cash s (i + 1) (list-push acc p.cash)

Section: Formatting

  format-monopoly-result : MonopolyResult -> Text
  format-monopoly-result (r) =
    let w = if r.winner < 0 then "None" else "P" & show (r.winner + 1)
    in "Monopoly (" & show r.turns & " turns): winner=" & w

Page 1


Chapter: Games--Battleship
  cites Games chapter Rng

 Battleship: two players each have a 10x10 grid. Ships placed randomly.
 Five ships with sizes 5, 4, 3, 3, 2. Each player tracks their own ship
 grid and a tracking grid for shots fired at the opponent.
 AI uses hunt mode (random shots) and target mode (adjacent to hits).

 Grids are List Integer of 100 cells (10x10, row-major).
 Ship grid: 0=water, 1=ship. Tracking grid: 0=unknown, 1=miss, 2=hit.

 We say:

Section: Types

  BsGrid = record {
    cells : List Integer
  }

  BsState = record {
    p1-ships    : BsGrid,
    p1-tracking : BsGrid,
    p2-ships    : BsGrid,
    p2-tracking : BsGrid,
    p1-hits     : Integer,
    p2-hits     : Integer,
    p1-shots    : Integer,
    p2-shots    : Integer,
    rng         : Rng,
    game-over   : Boolean,
    winner      : Integer
  }

  HitResult =
    | Miss
    | Hit
    | Sunk

  BattleshipResult = record {
    winner   : Integer,
    p1-shots : Integer,
    p2-shots : Integer
  }

Section: Grid Helpers

  bs-empty-grid : BsGrid
  bs-empty-grid =
    BsGrid { cells = bs-fill 0 [] }

  bs-fill : Integer, List Integer -> List Integer
  bs-fill (i) (acc) =
    if i >= 100 then acc
    else bs-fill (i + 1) (list-push acc 0)

  bs-cell : BsGrid, Integer, Integer -> Integer
  bs-cell (g) (row) (col) =
    if row < 0 then -1
    else if row >= 10 then -1
    else if col < 0 then -1
    else if col >= 10 then -1
    else list-at (g.cells) (row * 10 + col)

  bs-set : BsGrid, Integer, Integer, Integer -> BsGrid
  bs-set (g) (row) (col) (v) =
    BsGrid { cells = list-set-at (g.cells) (row * 10 + col) v }

Section: Ship Placement

  bs-ship-sizes : List Integer
  bs-ship-sizes = [5, 4, 3, 3, 2]

  bs-place-ships : Rng -> BsGrid
  bs-place-ships (rng) =
    let g0 = bs-empty-grid
    in let r1 = rng-next rng
    in let g1 = bs-place-ship g0 r1 5
    in let r2 = rng-next r1
    in let g2 = bs-place-ship g1 r2 4
    in let r3 = rng-next r2
    in let g3 = bs-place-ship g2 r3 3
    in let r4 = rng-next r3
    in let g4 = bs-place-ship g3 r4 3
    in let r5 = rng-next r4
    in bs-place-ship g4 r5 2

  bs-place-ship : BsGrid, Rng, Integer -> BsGrid
  bs-place-ship (g) (rng) (size) =
    bs-try-place g rng size 0

  bs-try-place : BsGrid, Rng, Integer, Integer -> BsGrid
  bs-try-place (g) (rng) (size) (attempts) =
    if attempts >= 200 then g
    else let r1 = rng-next rng
    in let r2 = rng-next r1
    in let r3 = rng-next r2
    in let horiz = rng-mod (rng-value r3) 2 == 0
    in let row = rng-range r1 0 9
    in let col = rng-range r2 0 9
    in if bs-fits g row col size horiz then bs-fill-ship g row col size horiz
    else bs-try-place g r3 size (attempts + 1)

  bs-fits : BsGrid, Integer, Integer, Integer, Boolean -> Boolean
  bs-fits (g) (row) (col) (size) (horiz) =
    if horiz then
      if col + size > 10 then False
      else bs-all-empty g row col size horiz 0
    else
      if row + size > 10 then False
      else bs-all-empty g row col size horiz 0

  bs-all-empty : BsGrid, Integer, Integer, Integer, Boolean, Integer -> Boolean
  bs-all-empty (g) (row) (col) (size) (horiz) (i) =
    if i >= size then True
    else let r = if horiz then row else row + i
    in let c = if horiz then col + i else col
    in if bs-cell g r c /= 0 then False
    else bs-all-empty g row col size horiz (i + 1)

  bs-fill-ship : BsGrid, Integer, Integer, Integer, Boolean -> BsGrid
  bs-fill-ship (g) (row) (col) (size) (horiz) =
    bs-fill-loop g row col size horiz 0

  bs-fill-loop : BsGrid, Integer, Integer, Integer, Boolean, Integer -> BsGrid
  bs-fill-loop (g) (row) (col) (size) (horiz) (i) =
    if i >= size then g
    else let r = if horiz then row else row + i
    in let c = if horiz then col + i else col
    in bs-fill-loop (bs-set g r c 1) row col size horiz (i + 1)

Section: Shooting

  bs-total-ship-cells : Integer
  bs-total-ship-cells = 17

  bs-shoot : BsGrid, BsGrid, Integer, Integer -> BsGrid
  bs-shoot (ships) (tracking) (row) (col) =
    let v = bs-cell ships row col
    in let hit-val = if v == 1 then 2 else 1
    in bs-set tracking row col hit-val

  bs-count-hits : BsGrid, Integer, Integer -> Integer
  bs-count-hits (tracking) (i) (acc) =
    if i >= 100 then acc
    else if list-at (tracking.cells) i == 2 then bs-count-hits tracking (i + 1) (acc + 1)
    else bs-count-hits tracking (i + 1) acc

Section: AI Strategy

  bs-ai-pick-shot : BsGrid, Rng -> Integer
  bs-ai-pick-shot (tracking) (rng) =
    let target = bs-find-adjacent-to-hit tracking 0
    in if target >= 0 then target
    else bs-find-random-unknown tracking rng

  bs-find-adjacent-to-hit : BsGrid, Integer -> Integer
  bs-find-adjacent-to-hit (tracking) (i) =
    if i >= 100 then -1
    else if list-at (tracking.cells) i /= 2 then bs-find-adjacent-to-hit tracking (i + 1)
    else let row = i / 10
    in let col = i - row * 10
    in let adj = bs-first-unknown-adjacent tracking row col
    in if adj >= 0 then adj
    else bs-find-adjacent-to-hit tracking (i + 1)

  bs-first-unknown-adjacent : BsGrid, Integer, Integer -> Integer
  bs-first-unknown-adjacent (tracking) (row) (col) =
    if row > 0 then
      if bs-cell tracking (row - 1) col == 0 then (row - 1) * 10 + col
      else bs-check-south tracking row col
    else bs-check-south tracking row col

  bs-check-south : BsGrid, Integer, Integer -> Integer
  bs-check-south (tracking) (row) (col) =
    if row < 9 then
      if bs-cell tracking (row + 1) col == 0 then (row + 1) * 10 + col
      else bs-check-west tracking row col
    else bs-check-west tracking row col

  bs-check-west : BsGrid, Integer, Integer -> Integer
  bs-check-west (tracking) (row) (col) =
    if col > 0 then
      if bs-cell tracking row (col - 1) == 0 then row * 10 + (col - 1)
      else bs-check-east tracking row col
    else bs-check-east tracking row col

  bs-check-east : BsGrid, Integer, Integer -> Integer
  bs-check-east (tracking) (row) (col) =
    if col < 9 then
      if bs-cell tracking row (col + 1) == 0 then row * 10 + (col + 1)
      else -1
    else -1

  bs-find-random-unknown : BsGrid, Rng -> Integer
  bs-find-random-unknown (tracking) (rng) =
    bs-random-unknown-loop tracking rng 0

  bs-random-unknown-loop : BsGrid, Rng, Integer -> Integer
  bs-random-unknown-loop (tracking) (rng) (attempts) =
    if attempts >= 200 then bs-first-unknown tracking 0
    else let r = rng-next rng
    in let idx = rng-range r 0 99
    in if list-at (tracking.cells) idx == 0 then idx
    else bs-random-unknown-loop tracking r (attempts + 1)

  bs-first-unknown : BsGrid, Integer -> Integer
  bs-first-unknown (tracking) (i) =
    if i >= 100 then -1
    else if list-at (tracking.cells) i == 0 then i
    else bs-first-unknown tracking (i + 1)

Section: Game Runner

  run-battleship-game : BattleshipResult
  run-battleship-game =
    let r0 = rng-new 42
    in let r1 = rng-next r0
    in let r2 = rng-next r1
    in let p1-ships = bs-place-ships r1
    in let p2-ships = bs-place-ships r2
    in let st = BsState { p1-ships = p1-ships, p1-tracking = bs-empty-grid, p2-ships = p2-ships, p2-tracking = bs-empty-grid, p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0, rng = r2, game-over = False, winner = 0 }
    in bs-loop st

  bs-loop : BsState -> BattleshipResult
  bs-loop (st) =
    if st.game-over then BattleshipResult { winner = st.winner, p1-shots = st.p1-shots, p2-shots = st.p2-shots }
    else if st.p1-shots > 100 then BattleshipResult { winner = 0, p1-shots = st.p1-shots, p2-shots = st.p2-shots }
    else let r1 = rng-next (st.rng)
    in let p1-idx = bs-ai-pick-shot (st.p1-tracking) r1
    in let p1-row = p1-idx / 10
    in let p1-col = p1-idx - p1-row * 10
    in let new-p1-track = bs-shoot (st.p2-ships) (st.p1-tracking) p1-row p1-col
    in let new-p1-hits = bs-count-hits new-p1-track 0 0
    in let r2 = rng-next r1
    in let p2-idx = bs-ai-pick-shot (st.p2-tracking) r2
    in let p2-row = p2-idx / 10
    in let p2-col = p2-idx - p2-row * 10
    in let new-p2-track = bs-shoot (st.p1-ships) (st.p2-tracking) p2-row p2-col
    in let new-p2-hits = bs-count-hits new-p2-track 0 0
    in let p1-won = new-p1-hits >= bs-total-ship-cells
    in let p2-won = new-p2-hits >= bs-total-ship-cells
    in let over = p1-won | p2-won
    in let winner = if p1-won then 1 else if p2-won then 2 else 0
    in let next = BsState { p1-ships = st.p1-ships, p1-tracking = new-p1-track, p2-ships = st.p2-ships, p2-tracking = new-p2-track, p1-hits = new-p1-hits, p2-hits = new-p2-hits, p1-shots = st.p1-shots + 1, p2-shots = st.p2-shots + 1, rng = r2, game-over = over, winner = winner }
    in bs-loop next

Section: Formatting

  format-battleship-result : BattleshipResult -> Text
  format-battleship-result (r) =
    let w = if r.winner == 1 then "Player 1 wins"
            else if r.winner == 2 then "Player 2 wins"
            else "Draw"
    in "Battleship: " & w & " P1-shots=" & show (r.p1-shots) & " P2-shots=" & show (r.p2-shots)

