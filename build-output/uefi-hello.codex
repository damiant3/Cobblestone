Chapter: UefiHello
  cites Codex chapter General

Section: Body
  opening : [Console] Nothing = act
    print-line "Hello from UEFI!"
    print-line "Codex VM UEFI emulation works."
    uefi-set-attr 14
    print-line "This line is yellow."
    uefi-set-attr 10
    print-line "This line is green."
    uefi-set-attr 7
    print-line "Press a key..."
    let key = uefi-read-key
    in print-line ("key=" & show key)
  end

