Chapter: UefiMenu
  cites Codex chapter General

 Simple UEFI menu to test console output + keyboard input.

Section: Helpers
  uefi-print-at : Integer, Integer, Integer, Text -> [Console] Nothing
  uefi-print-at (col) (row) (attr) (text) = act
    uefi-set-cursor col row
    uefi-set-attr attr
    print-line text
  end

Section: Menu
  show-menu : Integer -> [Console] Nothing
  show-menu (sel) = act
    uefi-clear-screen
    uefi-set-attr 15
    print-line "=== Codex Dev Console ==="
    print-line ""
    uefi-set-attr (if sel == 0 then 112 else 7)
    print-line "  Browse Source"
    uefi-set-attr (if sel == 1 then 112 else 7)
    print-line "  Compile"
    uefi-set-attr (if sel == 2 then 112 else 7)
    print-line "  Run Tests"
    uefi-set-attr (if sel == 3 then 112 else 7)
    print-line "  System Info"
    uefi-set-attr (if sel == 4 then 112 else 7)
    print-line "  Exit"
    uefi-set-attr 7
    print-line ""
    print-line "Arrow keys to navigate, Enter to select"
  end

  menu-loop : Integer -> [Console] Nothing
  menu-loop (sel) = act
    show-menu sel
    let key = uefi-read-key
    in if key == -1 then menu-loop sel
    else let scan = bit-shr key 16
    in let ch = bit-and key 65535
    in if scan == 1 then menu-loop (if sel > 0 then sel - 1 else 4)
    else if scan == 2 then menu-loop (if sel < 4 then sel + 1 else 0)
    else if ch == 13 then act
      if sel == 4 then print-line "Goodbye!"
      else act
        uefi-clear-screen
        uefi-set-attr 14
        print-line ("Selected: " & show sel)
        uefi-set-attr 7
        print-line "Press any key..."
        let k2 = uefi-read-key
        in menu-loop sel
      end
    end
    else menu-loop sel
  end

Section: Body
  opening : [Console] Nothing = act
    menu-loop 0
  end

