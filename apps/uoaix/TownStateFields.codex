  ts-person-wire-valid : Integer, Integer -> Boolean
  ts-person-wire-valid (buf) (at) = ts-text-valid buf (at + 200) 64

  ts-write-persona : Integer, Integer, TmPersona -> Integer
  ts-write-persona (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.npc
    in let f1 = poke-qword buf (at + 8) p.call-limit
    in let f2 = poke-qword buf (at + 16) p.token-budget
    in let f3 = poke-qword buf (at + 24) p.gift-limit
    in let f4 = poke-qword buf (at + 32) p.call-hour
    in let f5 = poke-qword buf (at + 40) p.calls
    in let f6 = poke-qword buf (at + 48) p.request
    in let f7 = ts-write-text buf (at + 56) 512 p.description
    in let f8 = ts-write-text buf (at + 576) 128 p.fallback
    in 0

  ts-read-persona : Integer, Integer, TmPersona -> Integer
  ts-read-persona (buf) (at) (p) =
    let f0 = __record-set p "npc" (peek-qword buf (at + 0))
    in let f1 = __record-set p "call-limit" (peek-qword buf (at + 8))
    in let f2 = __record-set p "token-budget" (peek-qword buf (at + 16))
    in let f3 = __record-set p "gift-limit" (peek-qword buf (at + 24))
    in let f4 = __record-set p "call-hour" (peek-qword buf (at + 32))
    in let f5 = __record-set p "calls" (peek-qword buf (at + 40))
    in let f6 = __record-set p "request" (peek-qword buf (at + 48))
    in let f7 = __record-set p "description" (ts-read-text buf (at + 56))
    in let f8 = __record-set p "fallback" (ts-read-text buf (at + 576))
    in 0

  ts-persona-wire-valid : Integer, Integer -> Boolean
  ts-persona-wire-valid (buf) (at) = ts-text-valid buf (at + 56) 512 & ts-text-valid buf (at + 576) 128


