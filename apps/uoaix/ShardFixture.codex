  shf-new : Integer -> Result ShardCheckpoint Text
  shf-new (capacity) = when world-new capacity
    is Err (e) -> Err e
    is Ok (world) -> when world-create world (gs-mobile 0 1420 1698 (-5) 400 1002)
      is Err (e) -> Err e
      is Ok (mobile) -> when ep-new (eg-standard 0) (em-new 0)
        is Err (e) -> Err e
        is Ok (economy) ->
          let accounts = ga-new ga-dev
          in let game = GameShard { world = world, characters = ga-working accounts, accounts = accounts, next-key = 305419895, pending-key = 0, active = 0, log = slg-new slg-trace, skills = chs-new 0 }
          in let towns = tf-new 0
          in let town = tf-add-town towns "Britain" 1 2 3
          in let npc = tf-add-person towns "Mara" town 4 5 2 9000
          in let linked = __record-set (tf-person towns npc) "world-serial" mobile
          in let mind = tm-new 0
          in let configured = tm-configure mind towns npc "Baker" "Busy." 8 128 3
          in let admin = admin-world-new towns mind
          in let report = admin-dispatch admin 3 "{\"command\":\"report-add\",\"account\":\"Avatar\",\"happened\":\"fixture\",\"location\":\"Britain\",\"wall_time\":\"fixture\",\"game_hour\":0,\"evidence\":\"quoted é λ\"}"
          in let job = admin-job-submit admin npc 1 1 "fixture job"
          in let panel = panel-new admin "Before boot"
          in let opened = panel-open panel 100
          in let queued = panel-human panel (JsonObject [json-pair "command" (JsonStr "panel-action"), json-pair "action" (JsonStr "inspect"), json-pair "session" (JsonInt 1)]) 101
          in let clock = __record-set panel "clock" (GameClock { day-seconds = 3600, last-tick = 1000, phase = 17, due = 2 })
          in let saved = GameCheckpoint { game = game, state = TownState {
            checkpoint = WorldCheckpoint { world = world, tick = 50, sequence = 5 }, townsfolk = towns, mind = mind } }
          in Ok (ShardCheckpoint { game = saved, economy = EconomyCheckpoint { world = economy, tick = 50, sequence = 5 }, panel = panel })

