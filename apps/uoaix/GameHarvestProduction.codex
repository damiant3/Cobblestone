  gh-invalidate-quotes : GvWorld, Integer -> Integer
  gh-invalidate-quotes (v) (i) = if i == v.player-count then 0
    else let player = list-at v.players i
    in let a = __record-set player "vendor" 0
    in let b = __record-set player "side" 0
    in let c = __record-set player "count" 0
    in let d = __record-set player "expires" 0
    in gh-invalidate-quotes v (i + 1)
  gh-retire-lot : GvWorld, Integer -> Integer
  gh-retire-lot (v) (at) = ep-retire-lot v.currency.world.goods at
 Item 56 is the catalog's timber seed (EconomyCatalog). Every seed draws as ServUO Seed's 0x0DCF, never as
 sprouts (Damian 2026-10-07: a chop "should put a seed"). Grapes (item 78,
 BritainCatalog) draw as TILEDATA's "grape bunch" 0x09D1.
  gh-sapling : Integer = 56
  gh-output-graphic : Integer -> Integer
  gh-output-graphic (item) = if item == 5 | item == 6 | item == 63 | item == 64 | item == 104 then #19B9 else if item == 15 then #1BDD
    else if item == 10 then #0DF9 else if item == 12 then #0DF8 else if item == 50 then #097B else if item == 11 then #1A9C else if item == 13 then #1EBD else if item == 14 then #0C7C
    else if item == 16 then #09D0 else if item == 102 then #0994 else if item == 150 then #09D2 else if item == 17 then #0F85 else if item == 18 then #0F84 else if item == 19 then #0F86 else if item == 20 then #0F88
    else if item == 78 then #09D1 else if item == 80 then #0C77 else if item == 82 then #0C6D else if item == 84 then #0C70
    else if item == 86 then #0D39 else if item == 88 then #0C7F else if item == 90 then #0C6A else if item == 92 then #0C72
    else if item == 94 then #0C74 else if item == 96 then #0C5C else if item == 98 then #0C64 else if item == 100 then #1AA2
    else if item == 9 then #09CC else if item >= gh-gem-first & item < gh-gem-first + 9 then list-at [#0F25, #0F16, #0F15, #0F26, #0F10, #0F13, #0F11, #0F0F, #0F18] (item - gh-gem-first)
    else if item-ingot-art item /= 0 then item-ingot-art item else #0DCF
 ServUO Lumberjacking and Mining EffectSounds: 0x13E per chop, 0x125 or 0x126 per swing; Fishing.cs and
 UOX3 fishing.js splash 0x364. Pre-SA EffectActions: mine 11, chop 13, fish 12.
  gh-sound : Integer, Integer -> Integer
  gh-sound (item) (draw) = if item == 15 then #013E else if item == 9 then #0364
    else if item == 5 | item == 6 | item == 63 | item == 64 then (if int-mod draw 2 == 0 then #0125 else #0126) else 0
  gh-action : Integer -> Integer
  gh-action (item) = if item == 15 then 13 else if item == 9 then 12 else 11
 Harvest quality falls into three grades, and a lot records its grade's floor so that one
 stack holds one grade: low below 400, common below 700, fine from 700.
  gh-grade : Integer -> Integer
  gh-grade (quality) = if quality < 400 then 100 else if quality < 700 then 400 else 700
  gh-grade-name : Integer -> Text
  gh-grade-name (quality) = if quality < 400 then "low" else if quality < 700 then "common" else "fine"
 ServUO Container.DropItem places a new item at a random point of the container gump's
 Data/containers.cfg rectangle (0x3C 44,65 142x94; 0x3D 29,34 108x94; 0x4A 18,105 144x73) less
 the art's extent. Art bounds are not installed; 30 pixels stands in for them.
  gh-drop-x : Integer, Integer -> Integer
  gh-drop-x (gump) (draw) = if gump == #003D then 29 + int-mod draw 78 else if gump == #004A then 18 + int-mod draw 114 else 44 + int-mod draw 112
  gh-drop-y : Integer, Integer -> Integer
  gh-drop-y (gump) (draw) = if gump == #003D then 34 + int-mod draw 64 else if gump == #004A then 105 + int-mod draw 43 else 65 + int-mod draw 64
  gh-stack : GameHarvest, GvPlayer, Integer, Integer, Integer, Integer, Integer -> Integer
  gh-stack (state) (player) (item) (quality) (quantity) (health) (serial) = if serial == 0 then 0
    else let next = world-next-sibling state.items.world serial
    in let at = gv-lot state.vendor serial 0
    in if at < 0 then gh-stack state player item quality quantity health next
    else let l = ep-lot state.vendor.currency.world.goods at
    in if l.actor == player.actor & l.item == item & l.quality == quality & l.wear == 32 & ep-amount state.vendor.currency.world.goods l.serial + quantity <= 60000
      & gh-stack-art state.items.world serial item health then serial
    else gh-stack state player item quality quantity health next
  gh-stack-art : WorldTable, Integer, Integer, Integer -> Boolean
  gh-stack-art (world) (serial) (item) (health) = when world-get world serial is Err (_) -> False is Ok (o) -> o.graphic == gh-output-graphic item & o.health == health
  gh-merge : GameHarvest, GvPlayer, Integer, Integer, Integer, Integer, Integer -> Result (List Integer) Text
  gh-merge (state) (player) (serial) (item) (quantity) (quality) (basis) =
    when ep-relist state.vendor.currency.world (gv-lot state.vendor serial 0) quantity basis
      is Err (_) -> Err "harvest output provenance refused"
      is Ok (_) -> when world-get state.items.world serial
        is Err (e) -> Err e
        is Ok (made) -> Ok (sip-item made)
  gh-output : GameHarvest, GvPlayer, Integer, Integer, Integer, Integer -> Result (List Integer) Text
  gh-output (state) (player) (item) (quantity) (produced) (draw) =
    gh-place state player item quantity (gh-grade produced) (if list-length state.vendor.currency.world.catalog.items >= 68 then quantity else 0) draw
  gh-place : GameHarvest, GvPlayer, Integer, Integer, Integer, Integer, Integer -> Result (List Integer) Text
  gh-place (state) (player) (item) (quantity) (quality) (basis) (draw) = gh-place-as state player item quantity quality basis draw 0
  gh-place-as : GameHarvest, GvPlayer, Integer, Integer, Integer, Integer, Integer, Integer -> Result (List Integer) Text
  gh-place-as (state) (player) (item) (quantity) (quality) (basis) (draw) (health) =
    let stack = gh-stack state player item quality quantity health (world-first-child state.items.world player.pack)
    in if stack > 0 then gh-merge state player stack item quantity quality basis
    else let gump = (gsi-meta state.items player.pack).gump
    in let spot = bit-and (mix-bits draw player.serial) #7FFFFFFF
    in let obj = WorldObject { serial = 0, kind = 2, x = gh-drop-x gump spot, y = gh-drop-y gump (spot / 4096), z = 0,
      graphic = gh-output-graphic item, hue = item-ore-hue item, container = player.pack, amount = quantity, health = health }
    in when world-create state.items.world obj
      is Err (e) -> Err e
      is Ok (serial) ->
        let lot = gv-add-lot state.vendor serial player.actor item quality 32 basis
        in if lot < 0 then Err "harvest output provenance refused"
        else let known = gsi-register state.items serial 0 0 True True
        in when world-get state.items.world serial
          is Err (e) -> Err e
          is Ok (made) -> Ok (sip-item made)
 Root, 2026-10-09 (the jeweler): an ore swing that yields ore turns up a gem 1 time in 20, one of the nine stones, items
 153 (amber) to 161 (tourmaline) in BritainCatalog's order.
  gh-gem-odds : Integer = 20
  gh-gem-first : Integer = 153
  gh-gem-roll : Integer, Integer -> Integer
  gh-gem-roll (serial) (now) = let r = bit-and (mix-bits serial now) #7FFFFFFF
    in if int-mod r gh-gem-odds /= 0 then 0 else gh-gem-first + int-mod (r / gh-gem-odds) 9
  gh-produce : GameHarvest, GvPlayer, Integer, Integer, Integer -> Result GameReply Text
  gh-produce (state) (player) (node-id) (lot-id) (now) =
    let v = state.vendor
    in let w = v.currency.world
    in let p = ep-actor w player.actor
    in let lot = ep-lot v.currency.world.goods lot-id
    in let node = list-at w.nodes (node-id - 1)
    in let resource = list-at w.catalog.resources (node.resource - 1)
    in if ep-amount w.goods lot.serial /= 1 | lot.actor /= player.actor | resource.tool /= lot.item
      | ep-at p.stock lot.item < 1 | ep-at p.quality lot.item < lot.quality
      | ep-at p.cost lot.item < lot.basis | ep-at p.wear lot.item < lot.wear
      | not (gv-owned state.items.world player.pack player.serial 65)
      | world-has-child state.items.world lot.serial 0 then Ok (gsi-denied "Harvest inventory binding refused.")
    else let outputs = if resource.seed == gh-sapling then 2 else 1
    in if not (ep-lot-room w.goods outputs) | world-count state.items.world + outputs > state.items.world.capacity then Ok (gsi-denied "No room for harvested resources.")
    else let bound = gh-row state.vendor player
    in let level = ep-level p resource.skill (ep-classic resource.skill 0 resource.item)
    in let tool-serial = lot.serial
    in let result = eh-harvest-with w player.actor node-id (gh-seam-active state node-id) tool-serial
    in if result == -1 then Ok (gsi-denied (gh-say (gh-tool-type lot.item) 3))
    else let unseeded = if result > 0 & resource.seed > 0 & resource.seed /= gh-sapling then eh-add-yield w p resource.seed (0 - 1) 1000 else 0
    in let broken = when world-get state.items.world tool-serial is Err (_) -> True is Ok (_) -> False
    in let invalidated = gh-invalidate-quotes v 0
        in let packets = if broken then [sip-remove tool-serial] else []
        in let animation = list-push packets (cbp-animation player.serial (gh-action resource.item))
        in let sound = gh-sound resource.item now
        in let swung = if sound == 0 then animation else animation & gsi-sound-at state.items player.serial sound
        in let skill = list-push swung (gh-skills state player (gsi-slot v.game player.serial 0))
        in if result < 0 then Ok (gs-reply (list-push skill (sip-message #FFFFFFFF #FFFF 6 (gh-say (gh-tool-type lot.item) 4))) "harvest failed attempt")
        else if result == 0 then Ok (gs-reply (list-push skill (sip-message #FFFFFFFF #FFFF 6 "The Crown takes all of it as its mining tax.")) "harvest taxed")
        else let produced = 100 + level * 9 / 10
        in when gh-output state player resource.item result produced now
          is Err (e) -> Err e
          is Ok (item) -> let at = gh-site-of state node-id 0
            in let species = if at < 0 then 0 else (list-at state.sites at).species
            in let felled = if at >= 0 & node.planted == 1 & node.resource == 15 then (let f = __record-set (list-at state.sites at) "felled" 1 in 1) else 0
            in when (if resource.seed == gh-sapling then gh-place-as state player gh-sapling 1 (gh-grade 1000) (if list-length w.catalog.items >= 68 then 1 else 0) (now + 1) species else Ok [])
            is Err (e) -> Err e
            is Ok (sapling) -> let gem = if resource.item == 5 | resource.item == 6 then gh-gem-roll player.serial now else 0
              in when (if gem < 1 | list-length w.catalog.items < gh-gem-first + 8 then Ok [] else let added = eh-add-yield w p gem 1 1000 in gh-place state player gem 1 (gh-grade 1000) 1 (now + 2))
              is Err (e) -> Err e
              is Ok (gemmed) -> let made = if list-length sapling == 0 then list-push skill item else list-push (list-push skill item) sapling
              in let drawn = if list-length gemmed == 0 then made else list-push made gemmed
              in let spot = if at < 0 then "" else let site = list-at state.sites at in " at " & show site.x & "," & show site.y & "," & show site.z
              in Ok (gs-reply (list-push drawn (sip-message #FFFFFFFF #FFFF 6 (gh-say (gh-tool-type lot.item) 5))) ("harvest produced item=" & show resource.item & " node=" & show node-id & spot))

