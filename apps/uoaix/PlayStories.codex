Chapter: PlayStories
  cites Uoaix chapter GameSession
  cites Uoaix chapter GameSkillsItems
  cites Uoaix chapter WorldRecords
  cites Foreword chapter CCE
  cites Foreword chapter Result

 Stories (UoaixPlays.md): a set is the world items a decorator or a play placed inside one map rectangle; a story groups
 sets and is on (its members stand) or off (removed, the area as the shard's statics show it). Content caps
 (ServerLimits.md): 64 stories, 256 sets, 4096 members a world.
  sty-max-stories : Integer = 64
  sty-max-sets : Integer = 256
  sty-max-members : Integer = 4096
 Story row: used, on, stay, name length, 30 name bytes. Set row: used, story, x1, y1, x2, y2, name length, 30 name
 bytes. Member row: used, set, art, hue, x, y, z, placing account (0 a play), live serial (0 while off).
  sty-story-size : Integer = 64
  sty-set-size : Integer = 88
  sty-member-size : Integer = 72
  StyStore = record { stories : Integer, sets : Integer, members : Integer }
  sty-zero : Integer, Integer, Integer -> Integer
  sty-zero (b) (i) (n) = if i >= n then 0 else let z = poke-qword b (i * 8) 0 in sty-zero b (i + 1) n
  sty-new : Integer -> StyStore
  sty-new (unused) = let stories = alloc-bytes (sty-max-stories * sty-story-size)
    in let a = sty-zero stories 0 (sty-max-stories * sty-story-size / 8)
    in let sets = alloc-bytes (sty-max-sets * sty-set-size)
    in let b = sty-zero sets 0 (sty-max-sets * sty-set-size / 8)
    in let members = alloc-bytes (sty-max-members * sty-member-size)
    in let c = sty-zero members 0 (sty-max-members * sty-member-size / 8)
    in StyStore { stories = stories, sets = sets, members = members }
  sty-story : StyStore, Integer, Integer -> Integer
  sty-story (st) (i) (f) = peek-qword st.stories (i * sty-story-size + f * 8)
  sty-set : StyStore, Integer, Integer -> Integer
  sty-set (st) (i) (f) = peek-qword st.sets (i * sty-set-size + f * 8)
  sty-member : StyStore, Integer, Integer -> Integer
  sty-member (st) (i) (f) = peek-qword st.members (i * sty-member-size + f * 8)
  sty-put : Integer, Integer, Integer, Integer, Integer -> Integer
  sty-put (base) (size) (i) (f) (v) = poke-qword base (i * size + f * 8) v

 Names: at most 30 bytes, compared byte for byte; the name's bytes sit at qword field `at` of the row.
  sty-same : Integer, Integer, Integer, Integer, Integer -> Boolean
  sty-same (row) (s) (off) (len) (i) = if i >= len then True else if peek-byte row i /= peek-byte s (off + i) then False else sty-same row s off len (i + 1)
  sty-name-is : Integer, Integer, Integer, Integer -> Boolean
  sty-name-is (row) (s) (off) (len) = peek-qword row 0 == len & sty-same (row + 8) s off len 0
  sty-name-put : Integer, Integer, Integer, Integer, Integer -> Integer
  sty-name-put (row) (s) (off) (len) (i) = if i >= 30 then poke-qword row 0 (min len 30)
    else let b = poke-byte (row + 8) i (if i < len then peek-byte s (off + i) else 0) in sty-name-put row s off len (i + 1)
  sty-name-text : Integer -> Text
  sty-name-text (row) = utf8-bytes-to-text (sty-name-bytes row 0 (min 30 (peek-qword row 0)) [])
  sty-name-bytes : Integer, Integer, Integer, List Integer -> List Integer
  sty-name-bytes (row) (i) (n) (out) = if i >= n then out else sty-name-bytes row (i + 1) n (list-push out (peek-byte (row + 8) i))
  sty-story-name : StyStore, Integer -> Text
  sty-story-name (st) (i) = sty-name-text (st.stories + i * sty-story-size + 24)
  sty-set-name : StyStore, Integer -> Text
  sty-set-name (st) (i) = sty-name-text (st.sets + i * sty-set-size + 48)

  sty-find-story : StyStore, Integer, Integer, Integer, Integer -> Integer
  sty-find-story (st) (s) (off) (len) (i) = if i >= sty-max-stories then 0 - 1
    else if sty-story st i 0 == 1 & sty-name-is (st.stories + i * sty-story-size + 24) s off len then i
    else sty-find-story st s off len (i + 1)
  sty-free : Integer, Integer, Integer, Integer -> Integer
  sty-free (base) (size) (i) (cap) = if i >= cap then 0 - 1 else if peek-qword base (i * size) == 0 then i else sty-free base size (i + 1) cap
 The story named by the bytes, made when it is new; -1 when the story table is full or the name is not 1 to 30 bytes.
  sty-story-of : StyStore, Integer, Integer, Integer -> Integer
  sty-story-of (st) (s) (off) (len) = if len < 1 | len > 30 then 0 - 1
    else let found = sty-find-story st s off len 0
    in if found >= 0 then found
    else let i = sty-free st.stories sty-story-size 0 sty-max-stories
    in if i < 0 then 0 - 1
    else let a = sty-put st.stories sty-story-size i 1 0
    in let b = sty-put st.stories sty-story-size i 2 0
    in let named = sty-name-put (st.stories + i * sty-story-size + 24) s off len 0
    in let c = sty-put st.stories sty-story-size i 0 1 in i

 Conflicts are refused when an area is defined (Damian, 2026-10-09): a set's rectangle may overlap sets of its own
 story only. The answer is the first other story's overlapping set, or -1.
  sty-overlap : StyStore, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  sty-overlap (st) (story) (x1) (y1) (x2) (y2) (i) = if i >= sty-max-sets then 0 - 1
    else if sty-set st i 0 == 1 & sty-set st i 1 /= story & x1 <= sty-set st i 4 & sty-set st i 2 <= x2 & y1 <= sty-set st i 5 & sty-set st i 3 <= y2 then i
    else sty-overlap st story x1 y1 x2 y2 (i + 1)
  sty-conflict : StyStore, Integer, Integer -> Text
  sty-conflict (st) (set) (unused) = "the area overlaps set " & sty-set-name st set & " of story " & sty-story-name st (sty-set st set 1)
  sty-find-set : StyStore, Integer, Integer, Integer, Integer, Integer -> Integer
  sty-find-set (st) (story) (s) (off) (len) (i) = if i >= sty-max-sets then 0 - 1
    else if sty-set st i 0 == 1 & sty-set st i 1 == story & sty-name-is (st.sets + i * sty-set-size + 48) s off len then i
    else sty-find-set st story s off len (i + 1)
 Define a set of a story with its rectangle, or move an existing one; refused naming the other set on a conflict.
  sty-define : StyStore, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Result Integer Text
  sty-define (st) (story) (s) (off) (len) (x1) (y1) (x2) (y2) = let other = sty-overlap st story x1 y1 x2 y2 0
    in if other >= 0 then Err (sty-conflict st other 0)
    else let found = sty-find-set st story s off len 0
    in let i = if found >= 0 then found else sty-free st.sets sty-set-size 0 sty-max-sets
    in if i < 0 then Err "more than 256 sets in the world"
    else let a = sty-put st.sets sty-set-size i 1 story
    in let b = sty-put st.sets sty-set-size i 2 x1
    in let c = sty-put st.sets sty-set-size i 3 y1
    in let d = sty-put st.sets sty-set-size i 4 x2
    in let e = sty-put st.sets sty-set-size i 5 y2
    in let named = sty-name-put (st.sets + i * sty-set-size + 48) s off len 0
    in let used = sty-put st.sets sty-set-size i 0 1 in Ok i
 A member of a set: the decorator's placement record (blu) and a play's set pieces (account 0). Refused outside the
 set's area. A member added while its story is on stands at once when the caller passes its live serial.
  sty-add-member : StyStore, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Result Integer Text
  sty-add-member (st) (set) (art) (hue) (x) (y) (z) (account) (serial) = if set < 0 | set >= sty-max-sets | sty-set st set 0 /= 1 then Err "no such set"
    else if x < sty-set st set 2 | x > sty-set st set 4 | y < sty-set st set 3 | y > sty-set st set 5 then Err "the item lies outside its set's area"
    else let i = sty-free st.members sty-member-size 0 sty-max-members
    in if i < 0 then Err "more than 4096 set members in the world"
    else let a = sty-put st.members sty-member-size i 1 set
    in let b = sty-put st.members sty-member-size i 2 art
    in let c = sty-put st.members sty-member-size i 3 hue
    in let d = sty-put st.members sty-member-size i 4 x
    in let e = sty-put st.members sty-member-size i 5 y
    in let f = sty-put st.members sty-member-size i 6 z
    in let g = sty-put st.members sty-member-size i 7 account
    in let h = sty-put st.members sty-member-size i 8 serial
    in let used = sty-put st.members sty-member-size i 0 1 in Ok i
 A play's own sets and pieces are replaced at every compile: its members (account 0) in the story are dropped. The
 caller refuses this while the story is on.
  sty-drop-play : StyStore, Integer, Integer -> Integer
  sty-drop-play (st) (story) (i) = if i >= sty-max-members then 0
    else let mine = sty-member st i 0 == 1 & sty-member st i 7 == 0 & sty-set st (sty-member st i 1) 1 == story
    in let dropped = if mine then sty-put st.members sty-member-size i 0 0 else 0
    in sty-drop-play st story (i + 1)

 Switching: on places every member that is not standing (an ordinary item with the member's art, hue and place),
 off removes every standing member; the answer is the count moved.
  sty-place : GsiState, Integer, Integer, Integer, Integer, Integer -> Integer
  sty-place (items) (art) (hue) (x) (y) (z) = let fresh = gs-item 0 art hue
    in let a = __record-set fresh "x" x
    in let b = __record-set fresh "y" y
    in let c = __record-set fresh "z" z
    in if world-room items.world < 1 then 0
    else when world-create items.world fresh
      is Err (_) -> 0
      is Ok (serial) -> if gsi-register items serial 0 0 False False < 0 then 0 else serial
  sty-switch : StyStore, GsiState, Integer, Boolean -> Integer
  sty-switch (st) (items) (story) (on) = if story < 0 | story >= sty-max-stories then 0
    else let a = sty-put st.stories sty-story-size story 1 (if on then 1 else 0) in sty-switch-members st items story on 0 0
  sty-switch-members : StyStore, GsiState, Integer, Boolean, Integer, Integer -> Integer
  sty-switch-members (st) (items) (story) (on) (i) (n) = if i >= sty-max-members then n
    else if sty-member st i 0 /= 1 | sty-set st (sty-member st i 1) 1 /= story then sty-switch-members st items story on (i + 1) n
    else let serial = sty-member st i 8
    in if on & serial == 0 then
      (let placed = sty-place items (sty-member st i 2) (sty-member st i 3) (sty-member st i 4) (sty-member st i 5) (sty-member st i 6)
      in let kept = sty-put st.members sty-member-size i 8 placed
      in sty-switch-members st items story on (i + 1) (if placed == 0 then n else n + 1))
    else if not on & serial /= 0 then
      (let gone = when world-delete items.world serial is Err (_) -> 0 is Ok (_) -> 1
      in let kept = sty-put st.members sty-member-size i 8 0
      in sty-switch-members st items story on (i + 1) (n + gone))
    else sty-switch-members st items story on (i + 1) n
  sty-on : StyStore, Integer -> Boolean
  sty-on (st) (story) = if story < 0 | story >= sty-max-stories then False else sty-story st story 1 == 1

 One line a story for [story: its name, on or off, its sets and members.
  sty-count-sets : StyStore, Integer, Integer, Integer -> Integer
  sty-count-sets (st) (story) (i) (n) = if i >= sty-max-sets then n else sty-count-sets st story (i + 1) (if sty-set st i 0 == 1 & sty-set st i 1 == story then n + 1 else n)
  sty-count-members : StyStore, Integer, Integer, Integer -> Integer
  sty-count-members (st) (story) (i) (n) = if i >= sty-max-members then n
    else sty-count-members st story (i + 1) (if sty-member st i 0 == 1 & sty-set st (sty-member st i 1) 1 == story then n + 1 else n)
  sty-lines : StyStore, Integer, List Text -> List Text
  sty-lines (st) (i) (out) = if i >= sty-max-stories then out
    else if sty-story st i 0 /= 1 then sty-lines st (i + 1) out
    else let state = if sty-story st i 1 == 1 then "on" else "off"
    in let stays = if sty-story st i 2 == 1 then " (stays)" else ""
    in let counts = show (sty-count-sets st i 0 0) & " sets, " & show (sty-count-members st i 0 0) & " items"
    in sty-lines st (i + 1) (list-push out (sty-story-name st i & ": " & state & stays & ", " & counts))
