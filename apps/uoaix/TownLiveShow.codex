Chapter: TownLiveShow
  cites Uoaix chapter TownLive
  cites Uoaix chapter EconomyActions

 ServUO Services/Craft DefBlacksmithy and DefTailoring PlayCraftEffect: the
 anvil sound 0x2A with the hammer swing (action 9), the tailoring sound
 0x248; DefCooking plays nothing, so the baker calls out instead. Viewer rows
 are volatile: 32 bytes per connection, eight for GameLinks' links (serial,
 connection, last narrated audit sequence, next work show in game seconds).

  tls-rows : Integer = 8
  tls-bytes : Integer = tls-rows * 32
  tls-row : Integer, Integer, Integer, Integer -> Integer
  tls-row (rows) (connection) (i) (best) = if i == tls-rows then best
    else if peek-qword rows (i * 32 + 8) == connection then i
    else tls-row rows connection (i + 1) (if peek-qword rows (i * 32 + 8) < peek-qword rows (best * 32 + 8) then i else best)
  tls-show-seconds : Integer = 60
  tls-lines : Integer = 3
  tls-near : WalkMap, WorldObject, WorldObject -> Boolean
  tls-near (map) (viewer) (npc) = walk-abs (viewer.x - npc.x) <= 18 & walk-abs (viewer.y - npc.y) <= 18 & tl-sight map npc viewer
  tls-npc : TownLive, Integer -> Result WorldObject Text
  tls-npc (t) (i) = world-get t.vendors.game.world (tf-person t.people (list-at t.residents i).person).world-serial
  tls-name : TownLive, Integer -> Text
  tls-name (t) (i) = (tf-person t.people (list-at t.residents i).person).name
  tls-work : TownLive, Integer, WorldObject -> List (List Integer)
  tls-work (t) (i) (npc) = if i == 1 then [cbp-animation npc.serial 9] & gsi-sound-at t.items npc.serial #002A
    else if i == 2 then gsi-sound-at t.items npc.serial #0248
    else [gvp-speech npc (tls-name t i) "Fresh bread, warm from the oven!"]
  tls-working : TownLive, WalkMap, WorldObject, Integer, List (List Integer) -> List (List Integer)
  tls-working (t) (map) (viewer) (i) (packets) = if i == t.count then packets
    else let r = list-at t.residents i
    in when tls-npc t i
      is Err (_) -> tls-working t map viewer (i + 1) packets
      is Ok (npc) -> let shown = if r.goal == 1 & tl-at npc r.work & npc.health > 0 & tls-near map viewer npc then packets & tls-work t i npc else packets
        in tls-working t map viewer (i + 1) shown
  tls-resident : TownLive, Integer, Integer -> Integer
  tls-resident (t) (actor) (i) = if i == t.count then -1 else if (list-at t.residents i).actor == actor then i else tls-resident t actor (i + 1)
  tls-item : EaWorld, Integer -> Text
  tls-item (e) (item) = let items = e.world.catalog.items
    in if item < 1 | item > list-length items then "goods" else (list-at items (item - 1)).name
  tls-told : EaEvent -> Boolean
  tls-told (row) = row.result >= 0 & (row.kind == 2 | row.kind == 3 | row.kind == 4)
  tls-line : EaWorld, EaEvent -> Text
  tls-line (e) (row) = if row.kind == 4 then "*eats some " & tls-item e row.item & "*"
    else (if row.kind == 2 then "Bought " else "Sold ") & show row.quantity & " " & tls-item e row.item & "."
  tls-said : TownLive, EaWorld, WalkMap, WorldObject, EaEvent -> List (List Integer)
  tls-said (t) (e) (map) (viewer) (row) = if not (tls-told row) then []
    else let i = tls-resident t row.actor 0
    in if i < 0 then [] else when tls-npc t i
      is Err (_) -> []
      is Ok (npc) -> if not (tls-near map viewer npc) then [] else [gvp-speech npc (tls-name t i) (tls-line e row)]
 Rows are read newest first by sequence, because cg-rotate moves them.
  tls-goods : TownLive, EaWorld, WalkMap, WorldObject, Integer, Integer, List (List Integer) -> List (List Integer)
  tls-goods (t) (e) (map) (viewer) (seen) (row) (lines) = if row < 0 | list-length lines >= tls-lines then lines
    else let event = list-at e.events row
    in if event.sequence <= seen then lines
    else tls-goods t e map viewer seen (row - 1) (tls-said t e map viewer event & lines)
  tls-show : TownLive, WalkMap, Maybe EaWorld, Integer, Integer, WorldObject, Integer -> List (List Integer)
  tls-show (t) (map) (book) (rows) (slot) (viewer) (connection) = if slot < 0 | slot >= 5 then []
    else let at = rows + tls-row rows connection 0 0 * 32
    in let latest = when book is None -> 0 is Just (e) -> e.sequence
    in let fresh = peek-qword rows at /= viewer.serial | peek-qword rows (at + 8) /= connection
    in let bound = if not fresh then 0 else let a = poke-qword rows at viewer.serial
      in let b = poke-qword rows (at + 8) connection
      in let c = poke-qword rows (at + 16) latest in poke-qword rows (at + 24) 0
    in let goods = when book
      is None -> []
      is Just (e) -> let lines = tls-goods t e map viewer (peek-qword rows (at + 16)) (e.event-count - 1) []
        in let read = poke-qword rows (at + 16) latest in lines
    in if viewer.health <= 0 | t.now < peek-qword rows (at + 24) then goods
    else let next = poke-qword rows (at + 24) (t.now + tls-show-seconds)
    in goods & tls-working t map viewer 0 []
  tls-doing : TownLive, Integer, WorldObject -> Text
  tls-doing (t) (i) (npc) = let r = list-at t.residents i
    in let shop = if i == 0 then "Good Eats" else if i == 1 then "the Hammer And Anvil" else "the Lords Clothiers"
    in if r.goal == 1 then (if tl-at npc r.work then "Busy at " & shop & "." else "On my way to work at " & shop & ".")
    else if r.goal == 2 then (if tl-at npc r.tavern then "Having a pint at the Blue Boar." else "Off to the Blue Boar.")
    else if tl-at npc r.home then "Resting at the Sweet Dreams Inn." else "Heading home to the Sweet Dreams Inn."
  tls-status : TownLive, Integer -> List (List Integer)
  tls-status (t) (serial) = tls-status-at t serial 0
  tls-status-at : TownLive, Integer, Integer -> List (List Integer)
  tls-status-at (t) (serial) (i) = if i == t.count then []
    else when tls-npc t i
      is Err (_) -> tls-status-at t serial (i + 1)
      is Ok (npc) -> if npc.serial /= serial then tls-status-at t serial (i + 1) else [gvp-speech npc (tls-name t i) (tls-doing t i npc)]
