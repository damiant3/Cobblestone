Chapter: BritainCatalog
  cites Uoaix chapter EconomyMetals

 Placement regions and stock graphics are adapted from UOX3 commit
 4560ae841bac898817143d7aa95ce59f47ab98e0, GPL-2.0-or-later:
 data/dfndata/spawn/felucca/spawn_felucca_town_britain.dfn and
 data/dfndata/items/shoplist.dfn. License: ports/UOX3-LICENSE.txt.
 Recipes are the Codex economy's production rules, not vendor restock rules.

  BbShop = record { title : Text, premises : Text, x1 : Integer, y1 : Integer,
    x2 : Integer, y2 : Integer }
  BbGoods = record { item : Integer, graphic : Integer }
  bb-shops : List BbShop = [
    BbShop { title = "Provisioner", premises = "Britains Premier Provisioner", x1 = 1465, y1 = 1672, x2 = 1470, y2 = 1674 },
    BbShop { title = "Blacksmith", premises = "The Hammer And Anvil", x1 = 1417, y1 = 1544, x2 = 1420, y2 = 1550 },
    BbShop { title = "Tailor", premises = "The Lords Clothiers", x1 = 1467, y1 = 1684, x2 = 1471, y2 = 1689 },
    BbShop { title = "Baker", premises = "Good Eats", x1 = 1449, y1 = 1609, x2 = 1454, y2 = 1618 },
    BbShop { title = "Healer", premises = "Healer Of Britain", x1 = 1470, y1 = 1608, x2 = 1477, y2 = 1614 },
    BbShop { title = "Innkeeper", premises = "Sweet Dreams Inn", x1 = 1496, y1 = 1615, x2 = 1498, y2 = 1617 },
    BbShop { title = "Tinker", premises = "The Tinkers Guild", x1 = 1422, y1 = 1648, x2 = 1429, y2 = 1663 },
    BbShop { title = "Carpenter", premises = "The Saw Horse", x1 = 1429, y1 = 1593, x2 = 1432, y2 = 1598 }]
  bb-shop-count : Integer = 8
  bb-goods : Integer -> List BbGoods
  bb-goods (shop) = if shop == 0 then [BbGoods { item = 45, graphic = #0E76 }, BbGoods { item = 69, graphic = #0F51 }, BbGoods { item = 34, graphic = #103C }, BbGoods { item = 25, graphic = #0E86 }, BbGoods { item = 26, graphic = #0F49 }, BbGoods { item = 29, graphic = #0DC0 }, BbGoods { item = 77, graphic = #0E81 }]
    else if shop == 1 then [BbGoods { item = 69, graphic = #0F51 }, BbGoods { item = 70, graphic = #0F60 }, BbGoods { item = 71, graphic = #1413 }, BbGoods { item = 62, graphic = #13E3 }]
    else if shop == 2 then [BbGoods { item = 72, graphic = #1517 }, BbGoods { item = 73, graphic = #152E }, BbGoods { item = 37, graphic = #175D }, BbGoods { item = 42, graphic = #0F9D }]
    else if shop == 3 then [BbGoods { item = 34, graphic = #103C }, BbGoods { item = 76, graphic = #1040 }]
    else if shop == 4 then [BbGoods { item = 75, graphic = #0E21 }, BbGoods { item = 74, graphic = #0F9E }, BbGoods { item = 37, graphic = #175D }]
    else if shop == 5 then [BbGoods { item = 34, graphic = #103C }, BbGoods { item = 76, graphic = #1040 }]
    else if shop == 6 then [BbGoods { item = 42, graphic = #1EB8 }, BbGoods { item = 74, graphic = #0F9E }]
    else [BbGoods { item = 42, graphic = #1034 }, BbGoods { item = 38, graphic = #1BD7 }, BbGoods { item = 28, graphic = #10E7 }]
  bb-catalog : Integer -> EgCatalog
  bb-catalog (unused) = let c = ex-catalog 0
    in let items = c.items & [eg-item "dagger" 1, eg-item "longsword" 1, eg-item "plate gorget" 1,
      eg-item "shirt" 4, eg-item "short pants" 4, eg-item "scissors" 1,
      eg-item "clean bandages" 4, eg-item "pizza" 5, eg-item "shepherd's crook" 6]
    in let recipes = c.recipes & [
      eg-recipe 69 1 31 1 38 1 0 0 9 62 8,
      eg-recipe 70 1 31 2 38 1 0 0 9 62 8,
      eg-recipe 71 1 31 3 0 0 0 0 9 62 8,
      eg-recipe 72 1 37 2 36 1 0 0 11 27 10,
      eg-recipe 73 1 37 2 36 1 0 0 11 27 10,
      eg-recipe 74 1 31 1 0 0 0 0 9 62 8,
      eg-recipe 75 5 37 1 0 0 0 0 11 74 10,
      eg-recipe 76 2 33 1 4 1 14 1 6 0 9,
      eg-recipe 77 1 38 3 0 0 0 0 8 26 6]
    in EgCatalog { items = items, resources = c.resources, recipes = recipes }
