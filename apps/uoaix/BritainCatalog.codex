  bb-shop-count : Integer = 21
  bb-goods : Integer -> List BbGoods
  bb-goods (shop) = if shop == 0 then [BbGoods { item = 69, graphic = #0F51 }, BbGoods { item = 34, graphic = #103C }, BbGoods { item = 25, graphic = #0E86 }, BbGoods { item = 26, graphic = #0F49 }, BbGoods { item = 29, graphic = #0DC0 }, BbGoods { item = 77, graphic = #0E81 }, BbGoods { item = 42, graphic = #0FBF }, BbGoods { item = 42, graphic = #14EC }, BbGoods { item = 149, graphic = #1364 }, BbGoods { item = 62, graphic = #12B3 }]
    else if shop == 1 then [BbGoods { item = 69, graphic = #0F51 }, BbGoods { item = 70, graphic = #0F60 }, BbGoods { item = 71, graphic = #1413 }, BbGoods { item = 62, graphic = #13E3 }, BbGoods { item = 40, graphic = #0F5E }, BbGoods { item = 41, graphic = #1415 }]
    else if shop == 2 then [BbGoods { item = 72, graphic = #1517 }, BbGoods { item = 73, graphic = #152E }, BbGoods { item = 37, graphic = #175D }, BbGoods { item = 42, graphic = #0F9D }]
    else if shop == 3 then [BbGoods { item = 34, graphic = #103C }, BbGoods { item = 76, graphic = #1040 }]
    else if shop == 4 then [BbGoods { item = 75, graphic = #0E21 }, BbGoods { item = 74, graphic = #0F9E }, BbGoods { item = 37, graphic = #175D }, BbGoods { item = 42, graphic = #0E9B }, BbGoods { item = 42, graphic = #0F0E }]
    else if shop == 5 then [BbGoods { item = 34, graphic = #103C }, BbGoods { item = 76, graphic = #1040 }, BbGoods { item = 42, graphic = #0EB2 }, BbGoods { item = 42, graphic = #0EB3 }, BbGoods { item = 42, graphic = #0E9D }, BbGoods { item = 50, graphic = #097B }]
    else if shop == 6 then [BbGoods { item = 42, graphic = #1EB8 }, BbGoods { item = 74, graphic = #0F9E }, BbGoods { item = 42, graphic = #14FC }, BbGoods { item = 39, graphic = #102E }, BbGoods { item = 115, graphic = #0F39 }, BbGoods { item = 118, graphic = #0FBF }, BbGoods { item = 120, graphic = #0E87 }, BbGoods { item = 148, graphic = #1055 }]
    else if shop == 7 then [BbGoods { item = 42, graphic = #1034 }, BbGoods { item = 38, graphic = #1BD7 }, BbGoods { item = 28, graphic = #10E7 }, BbGoods { item = 47, graphic = #0B2C }, BbGoods { item = 119, graphic = #0DE1 }]
    else if shop == 8 then [BbGoods { item = 106, graphic = #0EF3 }, BbGoods { item = 107, graphic = #0FF2 }, BbGoods { item = 117, graphic = #14EC }, BbGoods { item = 126, graphic = #0E34 }]
    else if shop == 9 then [BbGoods { item = 108, graphic = #0EFA }] & bb-scroll-goods bb-scroll-spells 0
    else if shop == 10 then [BbGoods { item = 110, graphic = #0F0E }]
    else if shop == 11 then [BbGoods { item = 111, graphic = #0995 }, BbGoods { item = 112, graphic = #09D7 }, BbGoods { item = 113, graphic = #0B46 }, BbGoods { item = 114, graphic = #0B45 }]
    else if shop == 12 then [BbGoods { item = 17, graphic = #0F85 }, BbGoods { item = 18, graphic = #0F84 }, BbGoods { item = 19, graphic = #0F86 }, BbGoods { item = 20, graphic = #0F88 }, BbGoods { item = 21, graphic = #0F7B }]
    else if shop == 13 then [BbGoods { item = 48, graphic = #13B2 }]
    else if shop == 14 then [BbGoods { item = 35, graphic = #1081 }]
    else if shop == 15 then [BbGoods { item = 44, graphic = #13CC }, BbGoods { item = 45, graphic = #0E76 }, BbGoods { item = 125, graphic = #1067 }]
    else if shop == 16 then [BbGoods { item = 121, graphic = #170D }, BbGoods { item = 122, graphic = #170F }, BbGoods { item = 123, graphic = #170B }, BbGoods { item = 124, graphic = #1711 }]
    else if shop == 17 then [BbGoods { item = 9, graphic = #09CC }, BbGoods { item = 127, graphic = #097A }]
    else if shop == 18 then [BbGoods { item = 152, graphic = #09C7 }, BbGoods { item = 34, graphic = #103C }, BbGoods { item = 50, graphic = #097B }]
    else if shop == bb-jeweler then bb-gem-goods 0 & bb-jewelry-goods
    else []
 Resource 27 is the grapevine (UOAIX-58): grapes (item 78) from a grape cutting (79), a field crop reaped by hand.
 Resources 28-38 are the 1.25 client's other field crops (Damian, 2026-10-07: "expand fully the available crops"), each
 harvest item followed by its seed: carrots 80, onions 82, lettuce 84, turnips 86, corn 88, pumpkins 90, squash 92,
 honeydew melons 94, watermelons 96, gourds 98, hops 100. Resource 39 is the pear tree, an orchard like the apple (16): pears 102
 from a pear cutting 103; resource 41 is the peach tree: peaches 150 from a peach cutting 151 (Castle Britain's peach trees,
 UOAIX-208). Resource 40 is sand (item 104), dug only with the shovel (item 115; a pickaxe digs none) on Mining, the glassblower's raw
 input (CompositeGame.md: every input has an NPC gatherer, here the sand gatherer). The glassblower's furnace is station
 16: glass (109) fires from 2 sand and 1 log, and 1 glass blows 2 empty bottles (110), the alchemists' bottles.
  bb-glassblower : Integer = 10
  bb-potter : Integer = 11
 The herbalist (shop 13, Strength And Steel's walls x 1479-1488, y 1579-1591 in STATICS0.MUL) sells the five plant
 reagents its gatherers pick wild; it makes none (bb-from-bought), so every reagent on its shelf was harvested.
  bb-herbalist : Integer = 12
 The bowyer (shop 14, Quality Fletching's walls x 1467-1478, y 1575-1583 in STATICS0.MUL, door at 1474-1475,1583).
  bb-bowyer : Integer = 13
 The tanner (shop 15, The Best Hides of Britain's walls x 1427-1439, y 1607-1615 in STATICS0.MUL, door at 1439,1612-1613).
  bb-tanner : Integer = 14
 The leatherworker (shop 16, the fish shop: walls x 1479-1487, y 1663-1675 in STATICS0.MUL, open west to the hall whose door is 1475-1476,1669) makes the
 leather goods, the bag among them, so the provisioner lists none.
  bb-leatherworker : Integer = 15
 The cobbler (shop 17, the west two rooms of the South Britain row houses joined by decor.cfg's cut of the wall at x 1453,
 walls x 1447 and 1459, y 1703-1711 in STATICS0.MUL, doors at 1450,1711 and 1456,1711, the west bed the cobbler's) makes footwear from leather: sandals 121, shoes 122, boots 123 and thigh boots 124 from 4, 6, 8 and 10
 leather (ServUO DefTailoring's footwear), at the tailoring station (11) with a knife.
  bb-cobbler : Integer = 16
 The fishmonger (shop 18, the eastern Oaken Oar: walls x 1471-1483, y 1735-1751 in STATICS0.MUL, door 1479,1747 onto the
 pier) buys fish from the fisherman and from players, and sells fish and raw fish steaks (127, 0x097A); its cutter (worker
 place 423) cuts 1 fish it bought there into 4 steaks at the market's table (the cooking station, as GameCarve cuts four).
  bb-fishmonger : Integer = 17
 The tavern keeper (shop 19, the Blue Boar: a hall with walls x 1493 and 1501, y 1675-1697 in STATICS0.MUL, its counter
 down x 1497, door 1501,1687; UOX3 felucca_signs 1502,1689) keeps the hall's north end and serves from game hour 12 to
 midnight (UOAIX-222). It makes wine (152, 0x09C7) from 4 grapes and sells bread and cooked food, all bought.
  bb-tavern-keeper : Integer = 18
 The musician (shop 20, Lord British's Conservatory of Music: a hall at x 1448-1462, y 1554-1558 in STATICS0.MUL behind a
 pillared porch, door gap 1454-1456,1559; UOX3 sign 1454,1561) plays from game hour 18 to midnight, sells nothing and earns
 from tickets (UOAIX-222).
  bb-musician : Integer = 19
 The jeweler (shop 21, Premier Gems: walls x 1449-1457, y 1677-1693 in STATICS0.MUL, door east 1457,1681; UOX3 region 21 is
 its keeper's; Damian, 2026-10-09: "we need a jeweler in the jewelry shops") buys gems and gold ingots and sells gems and
 jewelry. Gems (153-161, the 1.25 TILEDATA's amber, amethyst, citrine, diamond, emerald, ruby, sapphire, star sapphire and
 tourmaline) come from ore swings, 1 in 20 (root, 2026-10-09); each is a pickaxe resource on Mining, as ore is, which no node grows, so that eg-validate finds it gathered; the jewelry (ServUO DefTinkering, station 9) is made at its
 counter from 1 gold ingot and 1 gem it bought: a gold ring from a ruby, a bracelet from a sapphire, a necklace from an
 emerald and earrings from an amethyst.
  bb-jeweler : Integer = 20
  bb-gem-first : Integer = 153
  bb-gem-arts : List Integer = [#0F25, #0F16, #0F15, #0F26, #0F10, #0F13, #0F11, #0F0F, #0F18]
  bb-jewelry-goods : List BbGoods = [BbGoods { item = 162, graphic = #108A }, BbGoods { item = 163, graphic = #1086 }, BbGoods { item = 164, graphic = #1085 }, BbGoods { item = 165, graphic = #1087 }]
  bb-gem-goods : Integer -> List BbGoods
  bb-gem-goods (i) = if i >= list-length bb-gem-arts then [] else [BbGoods { item = bb-gem-first + i, graphic = list-at bb-gem-arts i }] & bb-gem-goods (i + 1)
 The leatherworker cuts 1 leather into 4 leather scraps (125) and the paper mill makes parchment (126) from 2 of them
 (row 26 (e), root 2026-10-09: no by-product).
 The spells the scribe inscribes: every one whose reagents are all the herbalist's plants (BritainShops bb-scroll-spell).
  bb-scroll-spells : List Integer = [1, 2, 3, 8, 9, 10, 11, 16, 17, 20, 21, 22, 24, 25, 35, 43, 44, 59]
  bb-scroll-goods : List Integer, Integer -> List BbGoods
  bb-scroll-goods (spells) (i) = if i >= list-length spells then []
    else [BbGoods { item = 116, graphic = mgd-scroll (list-at spells i) }] & bb-scroll-goods spells (i + 1)
