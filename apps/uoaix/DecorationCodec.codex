Chapter: DecorationCodec
  cites Uoaix chapter WorldDecoration

 WDS1 persists only door bits against the immutable DWD1 identity. View state
 never grants authority and is reset on recovery. The composite owns disk I/O.

  wdc-size : WdState -> Integer
  wdc-size (state) = 24 + state.count
  wdc-bits : WdState, Integer, Integer -> Boolean
  wdc-bits (state) (buffer) (i) = if i == state.count then True else let bit = peek-byte buffer i
    in if bit > 1 | (bit /= 0 & not (wd-is-door state i)) then False else wdc-bits state buffer (i + 1)
  wdc-copy : Integer, Integer, Integer, Integer -> Integer
  wdc-copy (source) (destination) (i) (count) = if i == count then 0
    else let copied = poke-byte destination i (peek-byte source i) in wdc-copy source destination (i + 1) count
  wdc-write : WdState, Integer, Integer -> Result Integer Text
  wdc-write (state) (buffer) (length) = if length /= wdc-size state then Err "WDS1 extent"
    else let a = poke-qword buffer 0 #31534457
    in let b = poke-qword buffer 8 state.identity
    in let c = poke-qword buffer 16 state.count
    in let d = wdc-copy state.opened (buffer + 24) 0 state.count in Ok length
  wdc-read : WdState, Integer, Integer -> Result Integer Text
  wdc-read (state) (buffer) (length) = if not (wd-bound state) then Err "decoration window requires rebind"
    else if length /= wdc-size state then Err "WDS1 extent"
    else if peek-qword buffer 0 /= #31534457 | peek-qword buffer 8 /= state.identity | peek-qword buffer 16 /= state.count then Err "WDS1 decoration identity differs"
    else if not (wdc-bits state (buffer + 24) 0) then Err "WDS1 invalid door bit"
    else let undo = alloc-bytes (max 1 state.count)
    in let saved = wdc-copy state.opened undo 0 state.count
    in let restored = wdc-copy (buffer + 24) state.opened 0 state.count
    in let base = wd-copy state.base state.solids 0 (state.width * state.height * state.stride / 8)
    in when wd-solids state (wd-lower state (state.map.x - 1) 0 state.count)
      is Err (e) -> let rollback = wdc-copy undo state.opened 0 state.count
        in let reset = wd-copy state.base state.solids 0 (state.width * state.height * state.stride / 8)
        in let repaired = wd-solids state 0 in Err e
      is Ok (_) -> let cleared = wd-zero state.visible 0 state.count
        in let connection = __record-set state "connection" -1
        in let cursor = __record-set state "cursor" 0 in Ok state.count
