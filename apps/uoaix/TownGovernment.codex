Chapter: TownGovernment
  cites Uoaix chapter Townsfolk
  cites Uoaix chapter EconomyMoney
  cites Uoaix chapter EconomyProduction
  cites Uoaix chapter EconomyCurrency
  cites Foreword chapter Maybe
  cites Foreword chapter Result

  TgOffice = record { town : Integer, purse : Integer, mayor : Integer,
    dues : Integer, collected : Integer, paid : Integer, unpaid : Integer,
    request : Integer, request-kind : Integer }
  TgGuard = record { town : Integer, npc : Integer, purse : Integer,
    wage : Integer, arrears : Integer, active : Integer }
  TgEvent = record { sequence : Integer, hour : Integer, kind : Integer,
    town : Integer, actor : Integer, subject : Integer, amount : Integer,
    money-action : Integer }
  TgWorld = record { people : TfWorld, economy : EpWorld,
    offices : List TgOffice, guards : List TgGuard, events : List TgEvent,
    town-count : Integer, guard-count : Integer, event-count : Integer,
    sequence : Integer, day : Integer, dues-stamps : Integer,
    currency : Maybe EuCurrency, royal-actor : Integer }

  tg-offices : Integer, List TgOffice -> List TgOffice
  tg-offices (i) (xs) = if i == 4 then xs else tg-offices (i + 1) (list-push xs (TgOffice {
    town = 0, purse = 0, mayor = 0, dues = 0, collected = 0, paid = 0,
    unpaid = 0, request = 0, request-kind = 0 }))
  tg-guards : Integer, List TgGuard -> List TgGuard
  tg-guards (i) (xs) = if i == 64 then xs else tg-guards (i + 1) (list-push xs (TgGuard {
    town = 0, npc = 0, purse = 0, wage = 0, arrears = 0, active = 0 }))
  tg-events : Integer, List TgEvent -> List TgEvent
  tg-events (i) (xs) = if i == 2048 then xs else tg-events (i + 1) (list-push xs (TgEvent {
    sequence = 0, hour = 0, kind = 0, town = 0, actor = 0, subject = 0,
    amount = 0, money-action = 0 }))
  tg-new : TfWorld, EpWorld -> TgWorld
  tg-new (people) (economy) = TgWorld { people = people, economy = economy,
    offices = tg-offices 0 [], guards = tg-guards 0 [], events = tg-events 0 [],
    town-count = 0, guard-count = 0, event-count = 0, sequence = 0,
    day = economy.hour / 24, dues-stamps = ep-buffer 1024,
    currency = None, royal-actor = 0 }
  tg-new-currency : TfWorld, EuCurrency, Integer -> Result TgWorld Text
  tg-new-currency (people) (currency) (royal-actor) =
    if not (eu-ready currency) | not (eu-royal currency True royal-actor) then Err "government currency binding invalid"
    else let g = tg-new people currency.world
    in let a = __record-set g "currency" (Just currency)
    in let b = __record-set g "royal-actor" royal-actor
    in Ok g
  tg-money-ready : TgWorld -> Boolean
  tg-money-ready (g) = when g.currency
    is None -> not (eu-catalog g.economy)
    is Just (x) -> eu-ready x
  tg-pay : TgWorld, Integer, Integer, Integer -> Integer
  tg-pay (g) (payer) (payee) (amount) = when g.currency
    is None -> em-pay g.economy.money payer payee amount
    is Just (x) -> eu-pay x True payer payee 0 0 amount
  tg-grant-money : TgWorld, Integer, Integer -> Integer
  tg-grant-money (g) (payee) (amount) = when g.currency
    is None -> em-town-grant g.economy.money True payee amount
    is Just (x) -> eu-grant x True g.royal-actor payee 0 0 amount
  tg-loan-money : TgWorld, Integer, Integer, Integer, Integer -> Integer
  tg-loan-money (g) (payee) (amount) (interest) (due) = when g.currency
    is None -> em-lend g.economy.money 1 payee amount interest due
    is Just (x) -> if not (eu-royal x True g.royal-actor) then -1 else eu-lend x True 1 payee 3 amount interest due
  tg-valid-town : TgWorld, Integer -> Boolean
  tg-valid-town (g) (town) = town > 0 & town <= g.town-count
  tg-office : TgWorld, Integer -> TgOffice
  tg-office (g) (town) = list-at g.offices (town - 1)
  tg-resident : TgWorld, Integer, Integer -> Boolean
  tg-resident (g) (npc) (town) = if not (tf-valid-person g.people npc) then False
    else let p = tf-person g.people npc
    in p.alive == 1 & p.age >= 6570 & p.town == town
  tg-mayor : TgWorld, Integer, Integer -> Boolean
  tg-mayor (g) (npc) (town) = if not (tg-valid-town g town) then False
    else (tg-office g town).mayor == npc & tg-resident g npc town
  tg-room : TgWorld, Integer -> Boolean
  tg-room (g) (count) = tg-money-ready g & count > 0 & g.event-count <= 2048 - count & g.sequence <= ep-limit - count
  tg-event : TgWorld, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  tg-event (g) (kind) (town) (actor) (subject) (amount) (money-action) =
    let e = list-at g.events g.event-count
    in let seq = g.sequence + 1
    in let a = __record-set e "sequence" seq
    in let b = __record-set e "hour" g.economy.hour
    in let c = __record-set e "kind" kind
    in let d = __record-set e "town" town
    in let f = __record-set e "actor" actor
    in let h = __record-set e "subject" subject
    in let j = __record-set e "amount" amount
    in let k = __record-set e "money-action" money-action
    in let m = __record-set g "sequence" seq
    in let n = __record-set g "event-count" (g.event-count + 1)
    in 0
  tg-register : TgWorld, Boolean, Integer, Integer, Integer -> Integer
  tg-register (g) (authorized) (town) (mayor) (purse) =
    if not authorized | town /= g.town-count + 1 | town > g.people.town-count | town > 4 | not (tg-resident g mayor town) | not (em-valid-purse g.economy.money purse) | not (tg-room g 1) then -1
    else let money = em-purse g.economy.money purse
    in if money.kind /= 4 | money.owner /= town then -1
    else let office = list-at g.offices g.town-count
    in let a = __record-set office "town" town
    in let b = __record-set office "purse" purse
    in let c = __record-set office "mayor" mayor
    in let d = __record-set g "town-count" town
    in tg-event g 1 town 0 mayor 0 0
  tg-appoint : TgWorld, Boolean, Integer, Integer -> Integer
  tg-appoint (g) (authorized) (town) (mayor) =
    if not authorized | not (tg-valid-town g town) | not (tg-resident g mayor town) | not (tg-room g 1) then -1
    else let a = __record-set (tg-office g town) "mayor" mayor
    in tg-event g 2 town 0 mayor 0 0
  tg-set-dues : TgWorld, Integer, Integer, Integer -> Integer
  tg-set-dues (g) (mayor) (town) (amount) =
    if not (tg-mayor g mayor town) | amount < 0 | amount > 1000000 | not (tg-room g 1) then -1
    else let a = __record-set (tg-office g town) "dues" amount
    in tg-event g 3 town mayor 0 amount 0
  tg-collect : TgWorld, Integer, Integer, Integer, Boolean -> Integer
  tg-collect (g) (mayor) (town) (payer) (liable) =
    if not liable | not (tg-mayor g mayor town) | not (em-valid-purse g.economy.money payer) | not (tg-room g 1) then -1
    else let p = em-purse g.economy.money payer
    in let office = tg-office g town
    in let stamp = (town - 1) * 256 + payer - 1
    in let day = g.economy.hour / 24 + 1
    in if p.kind /= 2 & p.kind /= 3 then -1
    else if p.kind == 2 & not (tg-resident g p.owner town) then -1
    else if office.dues <= 0 | ep-at g.dues-stamps stamp >= day | office.collected > ep-limit - office.dues then -1
    else let before = (em-purse g.economy.money office.purse).coin
    in if tg-pay g payer office.purse office.dues /= 0 then -1
    else let net = (em-purse g.economy.money office.purse).coin - before
    in let a = ep-set g.dues-stamps stamp day
    in let b = __record-set office "collected" (office.collected + net)
    in tg-event g 4 town mayor payer office.dues g.economy.money.sequence
  tg-employed : TgWorld, Integer, Integer -> Boolean
  tg-employed (g) (npc) (i) = if i == g.guard-count then False
    else let guard = list-at g.guards i
    in (guard.npc == npc & guard.active == 1) | tg-employed g npc (i + 1)
  tg-hire : TgWorld, Integer, Integer, Integer, Integer, Integer -> Integer
  tg-hire (g) (mayor) (town) (npc) (purse) (wage) =
    if not (tg-mayor g mayor town) | not (tg-resident g npc town) | g.guard-count == 64 | not (em-valid-purse g.economy.money purse) | wage <= 0 | wage > 1000000 | not (tg-room g 1) then -1
    else if (em-purse g.economy.money purse).kind /= 2 | (em-purse g.economy.money purse).owner /= npc | tg-employed g npc 0 then -1
    else let guard = list-at g.guards g.guard-count
    in let id = g.guard-count + 1
    in let a = __record-set guard "town" town
    in let b = __record-set guard "npc" npc
    in let c = __record-set guard "purse" purse
    in let d = __record-set guard "wage" wage
    in let e = __record-set guard "active" 1
    in let f = __record-set g "guard-count" id
    in let logged = tg-event g 5 town mayor npc wage 0
    in id
  tg-retire : TgWorld, Integer, Integer -> Integer
  tg-retire (g) (mayor) (id) = if id <= 0 | id > g.guard-count | not (tg-room g 1) then -1
    else let guard = list-at g.guards (id - 1)
    in if guard.active == 0 | not (tg-mayor g mayor guard.town) then -1
    else let a = __record-set guard "active" 0
    in tg-event g 6 guard.town mayor guard.npc guard.arrears 0
  tg-request : TgWorld, Integer, Integer, Integer, Integer -> Integer
  tg-request (g) (mayor) (town) (kind) (needed) =
    if not (tg-mayor g mayor town) | kind < 1 | kind > 2 | needed <= 0 | needed > ep-limit | not (tg-room g 1) then -1
    else let office = tg-office g town
    in let shortage = needed - (em-purse g.economy.money office.purse).coin
    in if shortage <= 0 then -1
    else let a = __record-set office "request" shortage
    in let b = __record-set office "request-kind" kind
    in tg-event g 12 town mayor kind shortage 0
  tg-settle : TgWorld, Integer, Integer, Integer -> Integer
  tg-settle (g) (mayor) (id) (amount) =
    if id <= 0 | id > g.guard-count | amount <= 0 | not (tg-room g 1) then -1
    else let guard = list-at g.guards (id - 1)
    in if not (tg-mayor g mayor guard.town) | amount > guard.arrears then -1
    else let office = tg-office g guard.town
    in if office.paid > ep-limit - amount | office.unpaid < amount then -1
    else if tg-pay g office.purse guard.purse amount /= 0 then -1
    else let a = __record-set guard "arrears" (guard.arrears - amount)
    in let b = __record-set office "unpaid" (office.unpaid - amount)
    in let c = __record-set office "paid" (office.paid + amount)
    in tg-event g 7 guard.town mayor guard.npc amount g.economy.money.sequence
  tg-funded : TgOffice, Integer -> Integer
  tg-funded (office) (amount) =
    let left = if amount >= office.request then 0 else office.request - amount
    in let a = __record-set office "request" left
    in let b = if left == 0 then __record-set office "request-kind" 0 else office
    in 0
  tg-grant : TgWorld, Boolean, Integer, Integer -> Integer
  tg-grant (g) (authorized) (town) (amount) =
    if not authorized | not (tg-valid-town g town) | not (tg-room g 1) then -1
    else let office = tg-office g town
    in if tg-grant-money g office.purse amount /= 0 then -1
    else let funded = tg-funded office amount
    in tg-event g 9 town 0 office.purse amount g.economy.money.sequence
  tg-loan : TgWorld, Boolean, Integer, Integer, Integer, Integer -> Integer
  tg-loan (g) (authorized) (town) (amount) (interest) (due) =
    if not authorized | not (tg-valid-town g town) | not (tg-room g 1) then -1
    else let office = tg-office g town
    in let id = tg-loan-money g office.purse amount interest due
    in if id < 0 then -1
    else let funded = tg-funded office amount
    in let logged = tg-event g 10 town 0 id amount g.economy.money.sequence
    in id
  tg-guard-sum : TgWorld, Integer, Integer, Boolean -> Integer
  tg-guard-sum (g) (town) (i) (wages) = if i == g.guard-count then 0
    else let guard = list-at g.guards i
    in (if guard.town == town then (if wages then (if guard.active == 1 then guard.wage else 0) else guard.arrears) else 0) + tg-guard-sum g town (i + 1) wages
  tg-payroll-valid : TgWorld, Integer -> Boolean
  tg-payroll-valid (g) (town) = if town > g.town-count then True
    else let office = tg-office g town
    in let wages = tg-guard-sum g town 0 True
    in let arrears = tg-guard-sum g town 0 False
    in office.unpaid == arrears & arrears <= ep-limit - wages & office.paid <= ep-limit - arrears - wages & tg-payroll-valid g (town + 1)
  tg-pay-guards : TgWorld, Integer -> Integer
  tg-pay-guards (g) (i) = if i == g.guard-count then 0
    else let guard = list-at g.guards i
    in let office = tg-office g guard.town
    in let result = if guard.active == 0 then 0
      else if not (tg-resident g guard.npc guard.town) then
        let stopped = __record-set guard "active" 0
        in tg-event g 6 guard.town 0 guard.npc guard.arrears 0
      else let amount = guard.arrears + guard.wage
        in let accrued = __record-set office "unpaid" (office.unpaid + guard.wage)
        in if tg-pay g office.purse guard.purse amount /= 0 then
          let owed = __record-set guard "arrears" amount
          in tg-event g 8 guard.town 0 guard.npc amount 0
        else let paid = __record-set office "paid" (office.paid + amount)
          in let clear = __record-set office "unpaid" (office.unpaid - amount)
          in let settled = __record-set guard "arrears" 0
          in tg-event g 7 guard.town 0 guard.npc amount g.economy.money.sequence
    in tg-pay-guards g (i + 1)
  tg-close-day : TgWorld -> Integer
  tg-close-day (g) = let day = g.economy.hour / 24
    in if day == g.day then 0
    else if day /= g.day + 1 | not (tg-room g (g.guard-count + 1)) | not (tg-payroll-valid g 1) then -1
    else let paid = tg-pay-guards g 0
    in let advanced = __record-set g "day" day
    in tg-event g 11 0 0 day 0 0
