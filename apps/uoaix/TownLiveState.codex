  TlCloth = record { serial : Integer, quality : Integer, wear : Integer, basis : Integer }
  TlControl = record { action : Integer, goal : Integer, place : Integer, vendor : Integer,
    expires : Integer, target : BbSpot }
  TlResident = record { person : Integer, actor : Integer, home : BbSpot, work : BbSpot, tavern : BbSpot,
    next-step : Integer, goal : Integer, via-home : Integer, direction : Integer,
    walk : RteWalk, blocked : Integer,
    clothes : List TlCloth, last-speaker : List Integer, last-speech : List Integer, control : TlControl }
  TlViewer = record { serial : Integer, connection : Integer, inside : Integer }
  TownLive = record { vendors : GvWorld, items : GsiState, people : TfWorld, mind : TmMind,
    residents : List TlResident, viewers : List TlViewer, count : Integer, home-capacity : Integer,
    entrance : BbSpot, nav : TlPath, now : Integer, cursor : Integer, lines : NlLibrary, feel : List Integer,
    warn-hook : (Integer, Integer -> Boolean), seeded-hook : (Integer -> Boolean) }
  tl-warn-none : Integer, Integer -> Boolean
  tl-warn-none (npc) (viewer) = False
  tl-seeded-any : Integer -> Boolean
  tl-seeded-any (unused) = True
  tl-move-seconds : Integer = 12
  tl-retry-seconds : Integer = 60
  tl-speech-seconds : Integer = 600
  tl-max-seconds : Integer = 8760000 * 3600
 Beds stop a row short of the door (y 1617 is the row just inside 1495,1618): a sleeper there plugged the inn's one door
 at night for every walker bound through it (red's smoke run of 39833, ten workers sidestepping 2,900 times).
  tl-home-region : BbShop = BbShop { title = "Shared lodging", premises = "Sweet Dreams Inn", x1 = 1493, y1 = 1610, x2 = 1498, y2 = 1616 }
 Home is the whole Sweet Dreams Inn, every floor (Damian, 2026-10-07: "lets make the whole building "home" for them,
 they can be happy in any room"): ServUO Data/Regions.xml's Britain inn rectangle 1492,1602 8x19. A walker bound home has
 arrived anywhere inside it above the doorway rows (y below 1617, the row inside the door): a walker that stopped on the
 entrance blocked every walker bound through it (live 39829: the farmer parked on 1495,1618 and four miners sidestepped
 2,700 times outside), so one reaching the doorway walks on to its own bed.
  tl-door-x : Integer = 1495
  tl-door-y : Integer = 1618
  tl-inn-building : BbShop = BbShop { title = "Sweet Dreams Inn", premises = "Sweet Dreams Inn", x1 = 1492, y1 = 1602, x2 = 1499, y2 = 1620 }
  tl-in-lodging : WorldObject -> Boolean
  tl-in-lodging (m) = m.x >= tl-inn-building.x1 & m.x <= tl-inn-building.x2 & m.y >= tl-inn-building.y1 & m.y < tl-door-y - 1
  tl-tavern-region : BbShop =BbShop { title = "Tavern", premises = "The Blue Boar", x1 = 1487, y1 = 1687, x2 = 1491, y2 = 1690 }
  tl-clothes : Integer, List TlCloth -> List TlCloth
  tl-clothes (i) (xs) = if i == 3 then xs else tl-clothes (i + 1) (list-push xs (TlCloth { serial = 0, quality = 0, wear = 0, basis = 0 }))
  tl-residents : Integer, Integer, List TlResident -> List TlResident
  tl-residents (i) (now) (xs) = if i == 3 then xs
    else tl-residents (i + 1) now (list-push xs (TlResident { person = 0, actor = 0,
      home = BbSpot { x = 0, y = 0, z = 0 }, work = BbSpot { x = 0, y = 0, z = 0 }, tavern = BbSpot { x = 0, y = 0, z = 0 },
      next-step = now, goal = -1, via-home = 0, direction = 4, walk = rte-walk 0, blocked = 0,
      clothes = tl-clothes 0 (__list-with-capacity 3), last-speaker = [0,0,0,0,0], last-speech = [-600,-600,-600,-600,-600],
      control = TlControl { action = 0, goal = 0, place = 0, vendor = 0, expires = 0, target = BbSpot { x = 0, y = 0, z = 0 } } }))
  tl-viewers : Integer, List TlViewer -> List TlViewer
  tl-viewers (i) (xs) = if i == tl-viewer-limit then xs else tl-viewers (i + 1) (list-push xs (TlViewer { serial = 0, connection = -1, inside = 0 }))
 GameLinks serves at most 32 game links.
  tl-viewer-limit : Integer = 32
  tl-viewer-at : List TlViewer, Integer, Integer, Integer -> Integer
  tl-viewer-at (views) (connection) (i) (best) = if i == list-length views then best
    else if (list-at views i).connection == connection then i
    else tl-viewer-at views connection (i + 1) (if (list-at views i).connection < (list-at views best).connection then i else best)
  tl-bind : GvWorld, GsiState, WalkMap, Integer, Integer, TfWorld, TmMind -> TownLive
  tl-bind (v) (items) (map) (now) (home-capacity) (people) (mind) = TownLive { vendors = v, items = items,
    people = people, mind = mind, residents = tl-residents 0 now (__list-with-capacity 3),
    viewers = tl-viewers 0 (__list-with-capacity tl-viewer-limit), count = 0, home-capacity = home-capacity,
    entrance = BbSpot { x = tl-door-x, y = tl-door-y, z = 0 }, nav = tl-path-new map, now = now, cursor = 0,
    lines = nl-library 0, feel = [0,0,0,0,0,0,0,0,0], warn-hook = tl-warn-none, seeded-hook = tl-seeded-any }
  tl-new : GvWorld, GsiState, WalkMap, Integer, Integer -> TownLive
  tl-new (v) (items) (map) (now) (home-capacity) = tl-bind v items map now home-capacity (tf-new 0) (tm-new 0)
  tl-copy-spot : BbSpot, BbSpot -> Integer
  tl-copy-spot (to) (from) = let a = __record-set to "x" from.x
    in let b = __record-set to "y" from.y
    in let c = __record-set to "z" from.z in 0
  tl-nearest-door : WdState, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  tl-nearest-door (doors) (x) (y) (z) (i) (best) (distance) =
    if i == doors.count then best else let dx = wd-field doors i 0 - x
    in if dx > 12 then best
    else let dy = wd-field doors i 1 - y
    in let range = max (walk-abs dx) (walk-abs dy)
    in let matches = wd-field doors i 7 == 1 & range <= 12 & walk-abs (wd-field doors i 2 - z) <= 2
    in tl-nearest-door doors x y z (i + 1) (if matches & range < distance then i else best) (if matches & range < distance then range else distance)
  tl-entrance-stand : TownLive, WalkMap -> Result Integer Text
  tl-entrance-stand (t) (map) = if (when walk-height map t.entrance.x t.entrance.y t.entrance.z is Err (_) -> False is Ok (z) -> z == t.entrance.z) then Ok 0
    else when walk-ground map t.entrance.x t.entrance.y
      is Err (e) -> Err e
      is Ok (ground) -> when bb-floor map t.entrance.x t.entrance.y ground 0
        is Err (e) -> Err e
        is Ok (z) -> let set = __record-set t.entrance "z" z in Ok 0
  tl-entrance : TownLive, WalkMap, Maybe WdState, BbSpot -> Result Integer Text
  tl-entrance (t) (map) (optional) (home) = when optional
    is None -> tl-entrance-stand t map
    is Just (doors) ->
      let row = tl-nearest-door doors 1495 1614 home.z (wd-lower doors 1483 0 doors.count) -1 100
      in if row < 0 then Err "Shared lodging has no unlocked entrance"
      else let x = __record-set t.entrance "x" (wd-field doors row 0)
      in let y = __record-set t.entrance "y" (wd-field doors row 1)
      in let z = __record-set t.entrance "z" (wd-field doors row 2) in Ok 0
  tl-outfit : TownLive, TlResident, BbProducer, Integer, Integer -> Result Integer Text
  tl-outfit (t) (r) (p) (mobile) (i) = if i == 3 then Ok 0
    else when bb-produce p 46
      is Err (e) -> Err e
      is Ok (_) -> when bb-materialise t.vendors t.items p mobile (if i == 0 then #1517 else if i == 1 then #152E else #170F) (if i == 0 then #035F else 0) (if i == 0 then 5 else if i == 1 then 4 else 3) 0 False
        is Err (e) -> Err e
        is Ok (serial) -> let cloth = list-at r.clothes i
          in let a = __record-set cloth "serial" serial
          in let b = __record-set cloth "quality" p.quality
          in let c = __record-set cloth "wear" p.wear
          in let d = __record-set cloth "basis" p.basis
          in tl-outfit t r p mobile (i + 1)
  tl-shop-of : Integer -> Integer
  tl-shop-of (i) = if i == 0 then 3 else if i == 1 then 1 else 2
 An NPC greets only at its own shop: the NPC and the player both stand inside it or within two tiles, the doorway
 (Damian, 2026-10-08, NpcSpeech.md); never on the road or at home.
  tl-at-work : Integer, WorldObject, WorldObject -> Boolean
  tl-at-work (shop) (npc) (viewer) = shop >= 0 & shop < bb-shop-count
    & tl-by-shop (list-at bb-shops shop) npc & tl-by-shop (list-at bb-shops shop) viewer
  tl-by-shop : BbShop, WorldObject -> Boolean
  tl-by-shop (r) (m) = m.x >= r.x1 - 2 & m.x <= r.x2 + 2 & m.y >= r.y1 - 2 & m.y <= r.y2 + 2
 The greeting's opening for the game hour and the shop's state: 0 keeps no shop hours (the bank), 1 open, 2 closed.
 Shops trade from 8 to 20 (BritainShopHours).
  tl-salute : Integer, Integer -> Text
  tl-salute (seconds) (state) = let hour = int-mod (seconds / 3600) 24
    in let part = if hour >= 5 & hour < 12 then "Good morning" else if hour >= 12 & hour < 18 then "Good afternoon" else "Good evening"
    in if state == 2 then part & ". The shop is closed; we open at eight in the morning."
    else if state == 1 & hour == 19 then part & ". We close at eight, so do not tarry."
    else part & "."
 The state an NPC announces (world-announce): its greeting's opening, which changes with the part of the day and the
 shop's state (0 no shop hours, 1 open, 2 closed).
  tl-state-key : Integer, Integer -> Integer
  tl-state-key (seconds) (state) = hamt-djb2-hash (tl-salute seconds state)
  tl-spot-of : TlResident, Integer -> BbSpot
  tl-spot-of (r) (kind) = if kind == 0 then r.home else if kind == 1 then r.work else r.tavern
  tl-region-of : Integer, Integer -> BbShop
  tl-region-of (i) (kind) = if kind == 0 then tl-home-region else if kind == 1 then list-at bb-shops (tl-shop-of i) else tl-tavern-region
  tl-stands : WalkMap, BbSpot -> Boolean
  tl-stands (map) (s) = when walk-height map s.x s.y s.z is Err (_) -> False is Ok (z) -> z == s.z
  tl-spot-used : TownLive, BbSpot, Integer, Integer -> Boolean
  tl-spot-used (t) (spot) (kind) (i) = if i == t.count then False
    else let old = tl-spot-of (list-at t.residents i) kind
    in (old.x == spot.x & old.y == spot.y & old.z == spot.z) | tl-spot-used t spot kind (i + 1)
  tl-free-spot : TownLive, WalkMap, BbShop, Integer, Integer -> Result BbSpot Text
  tl-free-spot (t) (map) (region) (kind) (offset) = when bb-placement t.vendors.game.world map region offset
    is Err (e) -> Err e
    is Ok (spot) -> if not (tl-spot-used t spot kind 0) then Ok spot
      else tl-free-spot t map region kind ((spot.y - region.y1) * (region.x2 - region.x1 + 1) + spot.x - region.x1 + 1)
  tl-resettle-spot : TownLive, WalkMap, Integer, Integer -> Result Integer Text
  tl-resettle-spot (t) (map) (i) (kind) = if kind == 3 then Ok 0
    else let r = list-at t.residents i
    in let spot = tl-spot-of r kind
    in if tl-stands map spot & (kind /= 1 | wks-at-trade i spot) & (kind /= 0 | spot.y <= tl-home-region.y2) then tl-resettle-spot t map i (kind + 1)
    else when (if kind == 1 then wks-trade-spot t.vendors.game.world map i else tl-free-spot t map (tl-region-of i kind) kind 0)
      is Err (e) -> Err e
      is Ok (free) -> let moved = tl-copy-spot spot free
        in let replan = tl-reset-path-state r
        in tl-resettle-spot t map i (kind + 1)
  tl-reset-path-state : TlResident -> Integer
  tl-reset-path-state (r) = rte-drop r.walk
  tl-resettle : TownLive, WalkMap, Integer -> Result Integer Text
  tl-resettle (t) (map) (i) = if i == t.count then tl-entrance-stand t map
    else when tl-resettle-spot t map i 0
      is Err (e) -> Err e
      is Ok (_) -> tl-resettle t map (i + 1)
  tl-tavern-used : TownLive, BbSpot, Integer -> Boolean
  tl-tavern-used (t) (spot) (i) = if i == t.count then False
    else let old = (list-at t.residents i).tavern
    in (old.x == spot.x & old.y == spot.y & old.z == spot.z) | tl-tavern-used t spot (i + 1)
  tl-tavern-spot : TownLive, WalkMap, Integer -> Result BbSpot Text
  tl-tavern-spot (t) (map) (offset) = when bb-placement t.vendors.game.world map tl-tavern-region offset
    is Err (e) -> Err e
    is Ok (spot) -> if not (tl-tavern-used t spot 0) then Ok spot
      else tl-tavern-spot t map ((spot.y - tl-tavern-region.y1) * (tl-tavern-region.x2 - tl-tavern-region.x1 + 1) + spot.x - tl-tavern-region.x1 + 1)
  tl-populate-people : TownLive, WalkMap, Integer -> Result Integer Text
  tl-populate-people (t) (map) (i) = if i == 3 then Ok 0
    else when bb-placement t.vendors.game.world map tl-home-region 0
      is Err (e) -> Err e
      is Ok (home) -> when wks-trade-spot t.vendors.game.world map i
        is Err (e) -> Err e
        is Ok (work) -> when tl-tavern-spot t map 0
          is Err (e) -> Err e
          is Ok (tavern) ->
            let name = if i == 0 then "Nell" else if i == 1 then "Jorin" else "Mira"
            in let job = if i == 0 then 2 else if i == 1 then 3 else 4
            in let person = tf-add-person t.people name 1 1001 100 job 9000
            in let purse = eu-open t.vendors.currency 2 (2000 + i)
            in let actor = if purse < 1 then -1 else ep-admit t.vendors.currency.world purse 100
            in if person < 1 | actor < 1 then Err "Townsfolk identity budget refused"
            else when world-create t.vendors.game.world (gs-mobile 0 home.x home.y home.z 400 1002)
              is Err (e) -> Err e
              is Ok (serial) ->
                let p = tf-person t.people person
                in let linked = __record-set p "world-serial" serial
                in let r = list-at t.residents i
                in let id = __record-set r "person" person
                in let econ = __record-set r "actor" actor
                in let h = tl-copy-spot r.home home
                in let w = tl-copy-spot r.work work
                in let v = tl-copy-spot r.tavern tavern
                in let fallback = if i == 0 then "Good day. I keep busy at the bakery." else if i == 1 then "Mind the sparks when you visit the forge." else "A sound stitch is worth the time it takes."
                in let configured = tm-configure t.mind t.people person (name & " is a working resident of Britain.") fallback 8 32 0
                in if configured /= 0 then Err "Townsfolk persona refused"
                else when tl-outfit t r (bb-producer t.vendors.currency actor) serial 0
                  is Err (e) -> Err e
                  is Ok (_) -> when cst-apply t.items serial (tl-look i serial)
                    is Err (e) -> Err e
                    is Ok (_) -> when tl-pack t (bb-producer t.vendors.currency actor) serial i
                      is Err (e) -> Err e
                      is Ok (_) -> let count = __record-set t "count" (i + 1)
                        in tl-populate-people t map (i + 1)
 A resident carries a backpack (layer 21) holding produced goods of its trade, as economy lots it owns: Nell
 bread (34), Jorin iron ingots (31), Mira cloth (37). They are what a thief can take.
  tl-pack : TownLive, BbProducer, Integer, Integer -> Result Integer Text
  tl-pack (t) (p) (mobile) (i) = when bb-container t.vendors t.items p mobile 21
    is Err (e) -> Err e
    is Ok (pack) -> let item = if i == 0 then 34 else if i == 1 then 31 else 37
      in when bb-produce p item
        is Err (e) -> Err e
        is Ok (_) -> bb-materialise t.vendors t.items p pack (if i == 0 then #103B else if i == 1 then #1BF2 else #1766) 0 0 0 True
 A resident's pack shows a quarter of its purse as coin piles, copper #0EEA, silver #0EF0 and gold #0EED (root,
 2026-10-07: a resident keeps most of its money banked, so one theft cannot empty it); as-steal-coin steals from them.
  tl-coin-share : Integer = 4
  tl-coin-art : Integer -> Integer
  tl-coin-art (metal) = if metal == 1 then #0EEA else if metal == 2 then #0EF0 else #0EED
  tl-coins : TownLive, Integer, Integer -> Integer
  tl-coins (t) (i) (metal) = if metal > 3 | i < 0 | i >= t.count then 0
    else let r = list-at t.residents i
    in let x = t.vendors.currency
    in let purse = (ep-actor x.world r.actor).purse
    in let shown = (em-purse (if metal == 1 then x.copper else if metal == 2 then x.silver else x.world.money) purse).coin / tl-coin-share
    in let world = t.vendors.game.world
    in let pack = gsi-pack-find world (tf-person t.people r.person).world-serial 0
    in let pile = if pack == 0 then 0 else gsi-child-art world (world-first-child world pack) (tl-coin-art metal) 0
    in let done = if pack == 0 then 0
      else if pile == 0 then (if shown == 0 then 0 else tl-coin-make t pack metal shown)
      else if shown == 0 then (when world-delete world pile is Err (_) -> 0 is Ok (_) -> 0)
      else (when world-get world pile is Err (_) -> 0 is Ok (o) -> when world-update world (__record-set o "amount" shown) is Err (_) -> 0 is Ok (_) -> 0)
    in tl-coins t i (metal + 1)
  tl-coin-make : TownLive, Integer, Integer, Integer -> Integer
  tl-coin-make (t) (pack) (metal) (shown) = let o = __record-set (__record-set (__record-set (gs-item pack (tl-coin-art metal) 0) "amount" shown) "x" 60) "y" 80
    in when world-create t.vendors.game.world o
      is Err (_) -> 0
      is Ok (made) -> gsi-register t.items made 0 0 True True
 Nell (0) and Mira (2) are women, Jorin (1) a man.
  tl-female : Integer -> Boolean
  tl-female (i) = i /= 1
  tl-look : Integer, Integer -> CstLook
  tl-look (i) (serial) = cst-look-sex cst-townsfolk serial (tl-female i)
  tl-start-workers : TownLive, Integer -> Result Integer Text
  tl-start-workers (t) (i) = if i == t.count then Ok 0
    else let r = list-at t.residents i
    in let p = tf-person t.people r.person
    in when world-get t.vendors.game.world p.world-serial
      is Err (e) -> Err e
      is Ok (obj) -> when world-update t.vendors.game.world (gs-mobile obj.serial r.work.x r.work.y r.work.z obj.graphic obj.hue)
        is Err (e) -> Err e
        is Ok (_) -> tl-start-workers t (i + 1)
  tl-populate : GvWorld, GsiState, WalkMap, Maybe WdState, Integer, Integer -> Result TownLive Text
  tl-populate (v) (items) (map) (doors) (now) (home-capacity) =
    if now < 0 | now > tl-max-seconds - 86400 | home-capacity < 3 | home-capacity > 128
      | not (world-indexed v.game.world) | world-room v.game.world < 3 * (1 + cst-most-rows)
      | items.world.buffer /= v.game.world.buffer then Err "Townsfolk population binding or budget"
    else let t = tl-new v items map now home-capacity
    in let town = tf-add-town t.people "Britain" 100 101 1001
    in let hour = __record-set t.people "hour" (now / 3600)
    in when tl-populate-people t map 0
      is Err (e) -> Err e
      is Ok (_) -> when tl-entrance t map doors (list-at t.residents 0).home
        is Err (e) -> Err e
        is Ok (_) -> when tl-start-workers t 0
          is Err (e) -> Err e
          is Ok (_) -> Ok t
