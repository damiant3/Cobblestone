  CompositeGame = record { checkpoint : GameCheckpoint, vendor : GvWorld,
    items : GsiState, combat : GameCombat, banks : GmbState, monsters : GameMonster,
    resurrection : GameResurrection, view : GameClientView, decoration : Maybe WdState, flora : Maybe WfState, planting : CplState, testing : Boolean, test-grants : Integer,
    magic : Maybe Magery, gates : Maybe GameMoongates, clock : Integer, timers : WorldTimers,
    magic-hold : Integer, magic-held : Integer, town : Maybe TownLive, town-map : Maybe WalkMap,
    town-seconds : Integer, town-ms : Integer, town-tick : Integer, day-hook : (Integer -> Integer), day-saved : Integer, network : Maybe TownNetworkLive,
    town-doors : Maybe WdState, shops : Maybe BbTown, staff : Maybe BshStaff, civic : Maybe CivicLive, duels : List CgDuel, rounds : Integer, bbs : BbsState, construction : CnState, decor : DcState, cast-actors : Integer, ships : ShpState, gov : Maybe GovernmentCheckpoint, crew : Maybe CgCrew, raid-seen : Integer, trades : List CgSwap, lineup : Maybe CglLineup, rebinds : Integer, hidden : Integer, moving : Integer,
    active : ActiveSkills, shows : Integer, speech : Maybe NpcSpeech, production : CprState,
    spawns : Maybe GameWorldSpawn, spawn-hold : Integer, spawn-held : Integer,
    speech-hold : Integer, speech-held : Integer, gatherer : Maybe CgGatherer, fighter : Maybe CgFighter, hunter : Maybe CgFighter, british : Maybe CbErrand, british-spare : Maybe CbErrand, miners : List CgGatherer, farmer : Maybe CgGatherer, smith : CsnSmith, baker : CsnSmith, tailor : CsnSmith, tinker : CsnSmith, carpenter : CsnSmith, glassblower : CsnSmith, potter : CsnSmith, bowyer : CsnSmith, tanner : CsnSmith, leatherworker : CsnSmith, cobbler : CsnSmith, camps : Integer, labor : Boolean, pages : HelpPages, known : NnKnown,
    gate-cover : Maybe (Integer, Integer, Integer -> [Device.Block] Result WalkMap Text), stages : Integer, decay : Integer, decay-at : Integer, save-faults : Text, load-faults : Text, faults-said : Integer, alarms : Integer, dead : Integer,
    tick-map : WalkMap, tick-held : Boolean, tick-watcher : Integer, store-due : Integer, lumber-shun : Integer, rot-log : Integer, death-log : Integer, plays : PlrStore,
    overlay : GmOverlay, land : GmLand, alarm-log : Integer, history : Integer, tavern : Integer, fleet : Integer, pins : MpnState, books : WbkState, cards : Integer, cities : List CtCity, city-maps : List WalkMap, city-navs : List TlPath, leisure : Integer,
    worker-cities : List CgCity, city-towns : List TownLive, city-workers : List CgGatherer, city-held : Integer, kind-time : Integer, keeper-said : Integer, teleports : Integer, housing : HsState }
  CgMoved = record { shown : List (List Integer), names : List Text }
  CgSwap = record { a : Integer, b : Integer, box-a : Integer, box-b : Integer, ok-a : Integer, ok-b : Integer }
  CgCrew = record { serial : Integer, actor : Integer, person : Integer, order : Integer, tried : Integer,
    home-x : Integer, home-y : Integer, home-z : Integer, site-x : Integer, site-y : Integer, site-z : Integer, walk : RteWalk }
 cg-pulse stamps HPET ticks at its stage boundaries so a slow WORLD PULSE names its stage (F30). Stamps: 0 start,
 5 vendors, 6 monsters, 7 decoration and flora (1 the base done), 8 labor, 9 town moves, 10 town live, 11 lineup,
 12 NPC speech (2 the town done), 3 magic, 4 active skills.
  cg-stage-count : Integer = 13
  cg-stage : CompositeGame, Integer -> Integer
  cg-stage (owner) (at) = poke-qword owner.stages (at * 8) hpet-ticks
  cg-stage-reset : CompositeGame, Integer, Integer -> Integer
  cg-stage-reset (owner) (now) (i) = if i == cg-stage-count then 0 else let a = poke-qword owner.stages (i * 8) now in cg-stage-reset owner now (i + 1)
  CompositeSetup = record { vendor-z : Integer, shrine-z : Integer, home-z : Integer, decoration : Maybe WdState }
  cg-home-x : Integer = 1440
  cg-home-y : Integer = 1720
  cg-relocate-slot : CompositeGame, WalkMap, MonsterSlot, WorldObject, Integer, Integer -> Result Integer Text
  cg-relocate-slot (owner) (map) (slot) (mobile) (z) (attempt) =
    if attempt == 8 then Err "monster relocation has no free walkable tile"
    else let x = cg-home-x + walk-dx attempt
    in let y = cg-home-y + walk-dy attempt
    in if gm-occupied owner.checkpoint.game x y 0 then cg-relocate-slot owner map slot mobile z (attempt + 1)
    else when walk-step map cg-home-x cg-home-y z attempt
      is Err (_) -> cg-relocate-slot owner map slot mobile z (attempt + 1)
      is Ok (height) -> when world-update owner.checkpoint.game.world (__record-set (__record-set (__record-set mobile "x" x) "y" y) "z" height)
        is Err (e) -> Err e
        is Ok (_) -> let actor = list-at owner.combat.actors (world-slot owner.checkpoint.game.world mobile.serial)
          in let stopped = cb-stop owner.combat actor
          in let peaceful = __record-set actor "war" False
          in let hidden = __record-set slot "seen" 0 in Ok 0
  cg-relocate-slots : CompositeGame, CompositeSetup, Integer -> Result Integer Text
  cg-relocate-slots (owner) (setup) (i) = if i == list-length owner.monsters.slots then
      let x = __record-set owner.monsters "x" cg-home-x
      in let y = __record-set owner.monsters "y" cg-home-y
      in let z = __record-set owner.monsters "z" setup.home-z in Ok 0
    else let slot = list-at owner.monsters.slots i
    in when world-get owner.checkpoint.game.world slot.serial
      is Err (_) -> cg-relocate-slots owner setup (i + 1)
      is Ok (mobile) -> if mobile.health == 0 then cg-relocate-slots owner setup (i + 1)
        else when setup.decoration
          is None -> Err "monster relocation requires installed terrain"
          is Just (decoration) -> when cg-relocate-slot owner decoration.map slot mobile setup.home-z 0
            is Err (e) -> Err e
            is Ok (_) -> cg-relocate-slots owner setup (i + 1)
  cg-british-create : Integer -> List Integer
  cg-british-create (unused) = let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let named = gp-ascii (gp-ascii header "British" 0 30) "" 0 30
    in let stats = named & [0,30,20,15,3,50,11,30,45,20]
    in gp-put32 (gp-put16 (gp-zeros (gp-put16 stats 1002) 12) 0) 0
  cg-british-named : Integer, Integer -> Boolean
  cg-british-named (row) (i) = if i == list-length ga-british-name then peek-byte row (18 + i) == 0
    else peek-byte row (18 + i) == list-at ga-british-name i & cg-british-named row (i + 1)
  cg-british-held : Integer, Integer -> Boolean
  cg-british-held (characters) (slot) = if slot == 5 then False
    else let row = characters + slot * 160
    in (peek-qword row 0 /= 0 & cg-british-named row 0) | cg-british-held characters (slot + 1)
  cg-british-character : CompositeGame, WalkMap -> Result Integer Text
  cg-british-character (owner) (map) = let game = owner.checkpoint.game
    in let table = game.accounts
    in let index = ga-british table
    in if index < 0 | game.active /= 0 then Ok 0
    else let prev = ga-bound table
    in let bound = gs-bind game index
    in let result = if cg-british-held game.characters 0 then Ok 0
      else when gs-create-at game map (cg-british-create 0)
        is Err (e) -> Err e
        is Ok (slot) -> Ok (slot + 1)
    in let restored = if prev /= index & prev >= 0 & prev < ga-count table then gs-bind game prev else False
    in when result
      is Err (e) -> Err e
      is Ok (n) -> when cg-british-dress owner
        is Err (e) -> Err e
        is Ok (_) -> if n == 0 then Ok 0 else when cg-british-seat owner
          is Err (e) -> Err e
          is Ok (_) -> Ok n
  cg-british-seat : CompositeGame -> Result Integer Text
  cg-british-seat (owner) = let world = owner.checkpoint.game.world
    in when world-get world (cg-british-serial owner)
      is Err (e) -> Err e
      is Ok (m) -> let a = __record-set m "x" cpr-seat-x
        in let b = __record-set m "y" cpr-seat-y
        in let c = __record-set m "z" cpr-seat-z
        in world-update world m
  cg-british-dress : CompositeGame -> Result Integer Text
  cg-british-dress (owner) = let serial = cg-british-serial owner
    in if serial == 0 then Ok 0
    else when world-get owner.items.world serial
      is Err (_) -> Ok 0
      is Ok (m) -> if m.kind /= 1 | m.health <= 0 then Ok 0
        else when (if m.graphic == cst-british-body then Ok 0 else world-update owner.items.world (__record-set m "graphic" cst-british-body))
          is Err (e) -> Err e
          is Ok (_) -> when cg-british-unshroud owner serial
            is Err (e) -> Err e
            is Ok (_) -> gmb-clothe owner.items serial cst-british-robe 0 cst-british-layer
  cg-british-unshroud : CompositeGame, Integer -> Result Integer Text
  cg-british-unshroud (owner) (serial) = let worn = gmb-layer owner.items serial cst-british-layer 0
    in if worn == 0 then Ok 0
    else when world-get owner.items.world worn
      is Err (e) -> Err e
      is Ok (robe) -> if robe.graphic /= #204E then Ok 0
        else when world-delete owner.items.world worn
          is Err (e) -> Err e
          is Ok (_) -> when cb-ensure owner.combat owner.checkpoint.game serial
            is Err (e) -> Err e
            is Ok (a) -> cg-british-reclaim owner serial (if a.corpse == 0 then 0 else world-first-child owner.items.world a.corpse)
  cg-british-reclaim : CompositeGame, Integer, Integer -> Result Integer Text
  cg-british-reclaim (owner) (serial) (child) = if child == 0 then Ok 0
    else when world-get owner.items.world child
      is Err (e) -> Err e
      is Ok (item) -> if item.graphic /= cst-british-robe then
          cg-british-reclaim owner serial (world-next-sibling owner.items.world child)
        else when world-update owner.items.world (cb-object item item.health item.graphic item.hue serial)
          is Err (e) -> Err e
          is Ok (_) -> let worn = gsi-register owner.items child cst-british-layer 0 False False in Ok child
  cg-british-redress : CompositeGame, Integer -> Integer
  cg-british-redress (owner) (serial) = if serial == 0 | serial /= cg-british-serial owner then 0
    else when cg-british-dress owner is Err (_) -> 0 - 1 is Ok (n) -> n
 Install runs at boot, before the links set a compaction mark, so the world grows through it as it does when founded.
  cg-install : CompositeGame, CompositeSetup -> Result Integer Text
  cg-install (owner) (setup) = let world = owner.checkpoint.game.world
    in let growing = world-bind-grow world (\u -> cg-grow owner)
    in let done = cg-install-steps owner setup
    in let stopped = world-unbind-grow world in done
  cg-install-steps : CompositeGame, CompositeSetup -> Result Integer Text
  cg-install-steps (owner) (setup) = when cg-install-core owner setup
    is Err (e) -> Err e
    is Ok (n) -> let blocking = world-bind-blocks owner.checkpoint.game.world (cg-player-mobile owner)
      in let wits = __record-set owner.combat "admit-hook" (cg-admit-wits owner)
      in let farm = cpl-farm-install owner.production.harvest
      in let orchard = cpl-orchard-install owner.production.harvest
      in let royal = cpr-royal-install owner.production
      in let mill = cpr-mill-install owner.production.harvest.items 0
      in let minter = cmr-install owner.production.harvest.items
      in let minter-serial = cmr-serial owner.production.harvest.items.world
      in let minter-named = cg-dress-bare owner minter-serial cst-shopkeeper (nn-name cst-guard minter-serial)
      in let stable = rst-install owner.production.harvest.items
      in let stableman = rst-serial owner.production.harvest.items.world
      in let stable-named = cg-dress-bare owner stableman cst-shopkeeper (nn-name cst-guard stableman)
      in let stables = csm-install owner.production.harvest.items
      in let stablemasters = cg-dress-all owner (csm-serials owner.production.harvest.items.world (csm-spots 0) 0 []) 0
      in let tavern = tbd-install owner.production.harvest.items
      in let shipwright = swb-install owner.production.harvest.items
    in let carded = tcd-install owner.production.harvest.items owner.cards
      in let games = tch-install owner.production.harvest.items
      in let board = bbs-install owner.production.harvest.items
      in let tools = cg-lord-tools owner.production.harvest.items (cg-british-serial owner)
      in let keyed = when owner.decoration is None -> 0 is Just (doors) -> glk-shop-keys owner.production.harvest.items doors owner.vendor 0
      in let world = owner.production.harvest.items.world
      in let silas = cg-dress-bare owner (cg-silas owner) cst-townsfolk "Silas"
      in let rotting = cg-arm-corpses owner 0 in Ok n
 Lord British carries a pickaxe (Damian, 2026-10-09: "put a pickaxe in British's backpack next switch"): at boot and at
 his entry (a fresh world has no British at boot) one is made in his backpack when it holds none, as his master key is
 (glk-give-master); his entry makes it an economy lot (cpr-kit-tools), so mining accepts it. 0x0E85 and 0x0E86 are TILEDATA's pickaxe, economy item 25 (cpr-kit-item).
  cg-pickaxe-art : Integer -> Boolean
  cg-pickaxe-art (g) = g == #0E85 | g == #0E86
  cg-has-pickaxe : WorldTable, Integer, Integer -> Boolean
  cg-has-pickaxe (world) (serial) (depth) = if serial == 0 then False
    else when world-get world serial
      is Err (_) -> False
      is Ok (o) -> if o.kind == 2 & cg-pickaxe-art o.graphic then True
        else if depth > 0 & world-child-count world serial > 0 & cg-has-pickaxe world (world-first-child world serial) (depth - 1) then True
        else cg-has-pickaxe world (world-next-sibling world serial) depth
  cg-give-pickaxe : GsiState, Integer -> Integer
  cg-give-pickaxe (items) (owner) = let pack = if owner == 0 then 0 else gsi-pack-find items.world owner 0
    in if pack == 0 | cg-has-pickaxe items.world (world-first-child items.world pack) 3 | world-room items.world <= 0 then 0
    else when world-create items.world (__record-set (__record-set (gs-item pack #0E86 0) "x" 90) "y" 90)
      is Err (_) -> 0
      is Ok (serial) -> let known = gsi-register items serial 0 0 True False in let touched = world-touch items.world in 1
  cg-lord-tools : GsiState, Integer -> Integer
  cg-lord-tools (items) (lord) = glk-give-master items lord + cg-give-pickaxe items lord
  cg-silas : CompositeGame -> Integer
  cg-silas (owner) = let world = owner.production.harvest.items.world in tbd-gambler world (world-tile-first world tbd-patron-x tbd-patron-y)
 A walking NPC is blocked only by a player's character, online or offline (world-blocks).
  cg-player-mobile : CompositeGame, Integer -> Boolean
  cg-player-mobile (owner) (serial) = gv-player owner.vendor serial 0 >= 0 | gsi-slot owner.checkpoint.game serial 0 >= 0
    | gsi-account-character owner.checkpoint.game.accounts serial 0 >= 0
 A creature leaves a polymorphed character alone (Damian, 2026-10-09: "monsters shouldn't attack a polymorphed character
 unless new form is normally auto aggro for that creature, or the creature passes an int battle/test against the
 polymorpher ... about a 50/50 battle of wits for even matched mages / int creatures"). A form the creature hunts
 anyway is attacked (cg-hunted-form); any other form is seen through when the creature wins a contest of INT, its own
 against the caster's, decided once per creature and casting, and a creature the character is fighting fights back.
 A creature hunts what its own rules aim it at: a player in view (a player's body is 0x190 or 0x191, gs-create-at) and
 its prey, the town's people (cg-prey); a form is hunted when it is one of those bodies. No creature hunts animals or
 other creatures, so a deer, pig or orc form is not.
  cg-hunted-form : CompositeGame, Integer -> Boolean
  cg-hunted-form (owner) (body) = body == #190 | body == #191 | cg-prey-body owner body 0 (cg-npc-count owner)
  cg-prey-body : CompositeGame, Integer, Integer, Integer -> Boolean
  cg-prey-body (owner) (body) (k) (n) = if k >= n then False
    else let serial = cg-npc-serial owner k
    in if serial > 0 & (when world-get owner.items.world serial is Err (_) -> False is Ok (o) -> o.kind == 1 & o.graphic == body) then True
    else cg-prey-body owner body (k + 1) n
  cg-fooled : CompositeGame, Integer, Integer -> Boolean
  cg-fooled (owner) (attacker) (target) = when owner.magic
    is None -> False
    is Just (magic) -> let slot = world-slot owner.items.world target
      in if slot < 0 | slot >= list-length magic.actors | cg-player-mobile owner attacker then False
      else let disguise = list-at magic.actors slot
      in if disguise.serial /= target | disguise.poly == 0 then False
      else when world-get owner.items.world target
        is Err (_) -> False
        is Ok (m) -> if cg-hunted-form owner m.graphic then False
          else let fight = list-at owner.combat.actors slot
          in if fight.serial == target & fight.war & fight.target == attacker then False
          else let wits = cg-wits owner magic attacker
          in int-mod (walk-abs (attacker * 31 + target * 17 + disguise.poly)) (wits + mgs-stat disguise 2) >= wits
 A spawned creature's INT is its UOX3 profile's (WorldSpawnIntData); any other creature's is its magery actor's.
  cg-wits : CompositeGame, Magery, Integer -> Integer
  cg-wits (owner) (magic) (serial) = let spawned = when owner.spawns is None -> -1 is Just (g) -> let i = gws-slot-of g serial 0 in if i < 0 then -1 else (list-at g.slots i).profile
    in if spawned >= 0 then max 1 (wsi-int spawned)
    else let slot = world-slot owner.items.world serial
    in if slot < 0 | slot >= list-length magic.actors then 20
    else let a = list-at magic.actors slot in if a.serial == serial then mgs-stat a 2 else 20
  cg-admit-wits : CompositeGame, Integer, Integer -> Boolean
  cg-admit-wits (owner) (attacker) (target) = cg-admit owner.active attacker target & not (cg-fooled owner attacker target)
  cg-install-core : CompositeGame, CompositeSetup -> Result Integer Text
  cg-install-core (owner) (setup) =
    let bound = __record-set owner "decoration" setup.decoration
    in let wheeled = __record-set owner.combat "wheel" (Just owner.timers)
    in let dressing = __record-set owner.resurrection "dress-hook" (cg-british-redress owner)
    in let yew = __record-set owner.production.harvest "swing" (cg-swing owner)
    in let offline = cg-offline owner 0
    in let bound-offline = cg-offline-slots owner owner.checkpoint.game.characters 0
    in let mine = cpr-mine-install owner.production
    in let field = cpr-field-install owner.production
    in let fibre = cpr-fibre-install owner.production
    in when cg-found-miners owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-workers owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-fisher owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-sander owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-clayer owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-quarrier owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-farmers owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-kitchen owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-arm-miners owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-found-farmer owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-arm-workers owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-bind-minds owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-arm-stations owner 0
     is Err (e) -> Err e
     is Ok (_) -> when cg-arm-rounds owner
     is Err (e) -> Err e
     is Ok (_) -> when cg-arm-store owner
     is Err (e) -> Err e
     is Ok (_) -> let beds = cg-own-beds owner in when cg-worker-dress owner 0
     is Err (e) -> Err e
     is Ok (_) -> when (if owner.monsters.x == 1426 & owner.monsters.y == 1700 then cg-relocate-slots owner setup 0 else Ok 0)
      is Err (e) -> Err e
      is Ok (_) -> when cg-vendor-dress owner 0
        is Err (e) -> Err e
        is Ok (_) -> let registered = cg-items owner 0
          in when cg-bank owner setup
            is Err (e) -> Err e
            is Ok (_) -> when cg-bank-rescue owner 0
             is Err (e) -> Err e
             is Ok (_) -> if owner.resurrection.shrine /= 0 then Ok 0
              else let home = __record-set owner.monsters "z" setup.home-z
              in gr-install owner.resurrection 1418 1700 setup.shrine-z
  cg-bank-rescue : CompositeGame, Integer -> Result Integer Text
  cg-bank-rescue (owner) (i) = if i == 5 then Ok 0
    else let game = owner.checkpoint.game
    in let serial = peek-qword game.characters (i * 160)
    in let slot = if serial == 0 then -1 else world-slot game.world serial
    in if slot < 0 | gmb-bank-find owner.items serial 0 > 0 then cg-bank-rescue owner (i + 1)
    else let actor = list-at owner.combat.actors slot
    in let box = if actor.serial /= serial | actor.corpse <= 0 then 0 else gsi-child-art game.world (world-first-child game.world actor.corpse) #09B2 0
    in if box == 0 then cg-bank-rescue owner (i + 1)
    else when world-get game.world box
      is Err (e) -> Err e
      is Ok (item) -> when world-update game.world (cb-object item item.health item.graphic item.hue serial)
        is Err (e) -> Err e
        is Ok (_) -> cg-bank-rescue owner (i + 1)
  cg-bank : CompositeGame, CompositeSetup -> Result Integer Text
  cg-bank (owner) (setup) =
    let z = when setup.decoration
      is None -> 0
      is Just (state) -> when walk-ground state.map gmb-bank-x gmb-bank-y
        is Err (_) -> 0
        is Ok (ground) -> when walk-height state.map gmb-bank-x gmb-bank-y ground is Err (_) -> ground is Ok (top) -> top
    in when gmb-ensure-banker owner.banks z
      is Err (e) -> Err e
      is Ok (serial) -> when cb-ensure owner.combat owner.checkpoint.game serial
        is Err (e) -> Err e
        is Ok (actor) -> let immune = __record-set actor "immune" True in when cst-style owner.items serial cst-banker
          is Err (e) -> Err e
          is Ok (_) -> Ok serial

 Only bankers answer "bank", as in 1998 (root, 2026-10-06); shopkeepers are not registered as bankers.
  cg-context : GameCheckpoint, GvWorld, GsiState, GameCombat -> Result CompositeGame Text
  cg-context (checkpoint) (vendor) (items) (combat) = let banks = gmb-new items #004A
    in when gm-new combat 3 cg-home-x cg-home-y 0 6
      is Err (e) -> Err e
      is Ok (monsters) -> when gcv-new checkpoint.game.world.capacity 18 False 0 0
        is Err (e) -> Err e
        is Ok (view) -> when wtm-new 1024 256 0
          is Err (e) -> Err e
          is Ok (timers) -> when as-new vendor banks combat
           is Err (e) -> Err e
           is Ok (active) -> let grants = alloc-bytes 40
          in let zero = ts-zero grants 40 0
          in let concealed = gcv-conceal view active.concealed
          in let ghosts = __record-set view "unseen-hook" (as-ghost-hook active checkpoint.game)
          in let shows = alloc-bytes tls-bytes
          in let cleared = ts-zero shows tls-bytes 0
          in let admits = __record-set combat "admit-hook" (cg-admit active)
          in let armed = __record-set combat "weapon-hook" (cg-weapon items)
          in let wielded = __record-set combat "arm-hook" (cg-arm items)
          in let guarded = __record-set combat "shield-hook" (cg-shield items)
          in let voiced = __record-set combat "sound-hook" (csd-sound (csd-table 0))
          in let strikes = __record-set combat "struck-hook" (as-reveal-serial active)
          in let made = CompositeGame { checkpoint = checkpoint, vendor = vendor, items = items,
          combat = combat, banks = banks, monsters = monsters, resurrection = gr-new combat items,
          view = view, decoration = None, flora = None, planting = cpl-new 0, testing = False, test-grants = grants,
          magic = None, gates = None, clock = 0, timers = timers, magic-hold = 0, magic-held = 0, town = None, town-map = None,
          town-seconds = 0, town-ms = 0, town-tick = 0, day-hook = cg-day-default, day-saved = 0, network = None, town-doors = None, shops = None, staff = None, civic = None, duels = cg-duel-slots 32 [], rounds = cg-rounds-new 0, bbs = bbs-new 0, construction = cn-new 0, decor = dc-new 0, cast-actors = cb-zeroed (plr-slots * pls-max-cast * 8), ships = shp-new 0, gov = None, crew = None, raid-seen = 0, trades = cg-trade-block cg-trade-grow-by [], lineup = None, rebinds = 0, hidden = 0, moving = 0, active = active, shows = shows, speech = None, production = cpr-new vendor items,
          spawns = None, spawn-hold = 0, spawn-held = 0 , speech-hold = 0, speech-held = 0, gatherer = None, fighter = None, hunter = None, british = None, british-spare = Just (cbe-new 0 (BbSpot { x = 0, y = 0, z = 0 })), miners = [], farmer = None, smith = csn-smith 0, baker = csn-baker 0, tailor = csn-tailor 0, tinker = csn-tinker 0, carpenter = csn-carpenter 0, glassblower = csn-glassblower 0, potter = csn-potter 0, bowyer = csn-bowyer 0, tanner = csn-tanner 0, leatherworker = csn-leatherworker 0, cobbler = csn-cobbler 0, camps = cf-new 0, labor = False, pages = hp-new 0, known = nn-new 0,
          gate-cover = None, stages = alloc-bytes (cg-stage-count * 8), decay = sa-new 16 items.world.capacity, decay-at = cb-zeroed 8, save-faults = "", load-faults = "", faults-said = 0, alarms = cb-zeroed (cg-alarm-rows * 16), dead = cb-zeroed (cg-dead-rows * cg-dead-bytes),
          tick-map = WalkMap { x = 0, y = 0, width = 0, height = 0, land = 0, solids = 0, stride = 0 }, tick-held = False, tick-watcher = 0, store-due = 0, lumber-shun = cb-zeroed (cgl-shun-cells * 8), rot-log = cb-zeroed (8 + cg-rot-rows * 64), death-log = cb-zeroed (16 + cg-death-rows * 64), plays = plr-new 0,
          overlay = gmo-new 0, land = gld-new 0, alarm-log = cb-zeroed (16 + cg-alarm-log-rows * 72), history = 0, tavern = cb-zeroed (tbd-tavern-bytes + tch-tavern-bytes), fleet = cb-zeroed swb-bytes, pins = mpn-new 0, books = wbk-new 0, cards = cb-zeroed tcd-bytes, cities = ct-table 0, city-maps = [], city-navs = [], leisure = kl-new 0,
          worker-cities = [], city-towns = [], city-workers = [], city-held = 0, kind-time = cb-zeroed cg-kind-bytes, keeper-said = cb-zeroed (bb-shop-count * 8), teleports = tp-load 0, housing = hs-new 0 }
          in let traded = __record-set made.plays "trade" (cg-play-trade made)
          in let venomous = __record-set combat "venom-hook" (cg-as-envenom made)
          in let reviving = __record-set combat "revive-hook" (cg-vendor-serial made)
          in let falling = __record-set combat "fall-hook" (cg-vendor-fall made)
          in let noted = __record-set view "noto-hook" (cg-view-notoriety made)
          in let thieving = __record-set active "theft-hook" (cg-theft made)
          in let shunning = __record-set vendor "shun" (cg-shun made)
          in let keeping = __record-set vendor "keeps" (cg-wild-keeps made)
          in let subduing = __record-set combat "subdue-hook" (cg-subdue made) in Ok made
 Equipment layer 1 holds a one-handed weapon; layer 2 holds a two-handed weapon, or a shield beside layer 1.
 The graphic in hand: layer 1, else layer 2 (a two-handed weapon, or a shield, which WeaponData answers 0 for).
  cg-arm : GsiState, Integer -> Integer
  cg-arm (items) (serial) = let one = gmb-layer items serial 1 0
    in let held = if one > 0 then one else gmb-layer items serial 2 0
    in if held == 0 then 0 else when world-get items.world held is Err (_) -> 0 is Ok (o) -> o.graphic
  cg-weapon : GsiState, Integer -> Integer
  cg-weapon (items) (serial) = if gmb-layer items serial 1 0 > 0 then 1 else if cg-shield items serial == 0 & gmb-layer items serial 2 0 > 0 then 2 else 0
 The art of a shield in the left hand (layer 2), else 0.
  cg-shield : GsiState, Integer -> Integer
  cg-shield (items) (serial) = let held = gmb-layer items serial 2 0
    in if held == 0 then 0 else when world-get items.world held is Err (_) -> 0 is Ok (o) -> if shd-ar o.graphic > 0 then o.graphic else 0
  cg-vendor-dress : CompositeGame, Integer -> Result Integer Text
  cg-vendor-dress (owner) (i) = if i == owner.vendor.vendor-count then cbd-dress owner.combat owner.items 0
    else let serial = (list-at owner.vendor.vendors i).serial
    in when cst-style owner.items serial (if bb-role owner.vendor serial == 1 then cst-smith else cst-shopkeeper)
      is Err (e) -> Err e
      is Ok (_) -> cg-vendor-dress owner (i + 1)
  cg-worker-style : CompositeGame, Integer, Integer -> Result Integer Text
  cg-worker-style (owner) (serial) (role) = if serial == 0 then Ok 0
    else when world-get owner.items.world serial
      is Err (_) -> Ok 0
      is Ok (m) -> if m.kind /= 1 | m.health <= 0 then Ok 0
        else let rows = (cst-look role serial).rows
        in let cleared = if cst-names rows 1 0 | cst-names rows 2 0 then cg-hands-clear owner serial rows 1 else 0
        in cst-style owner.items serial role
 A worker whose look carries a tool drops a stale tool from the other hand, unless the item is an economy lot (gv-lot):
 the census refuses a deleted lot.
  cg-hands-clear : CompositeGame, Integer, List CstRow, Integer -> Integer
  cg-hands-clear (owner) (serial) (rows) (layer) = if layer > 2 then 0
    else let worn = gmb-layer owner.items serial layer 0
    in let gone = if worn == 0 | cst-names rows layer 0 | gv-lot owner.vendor worn 0 >= 0 then 0
      else when world-delete owner.items.world worn is Err (_) -> 0 is Ok (_) -> 1
    in gone + cg-hands-clear owner serial rows (layer + 1)
  cg-worker-lead : CompositeGame -> Result Integer Text
  cg-worker-lead (owner) = when cg-worker-style owner (when owner.gatherer is None -> 0 is Just (g) -> g.serial) cst-miner
    is Err (e) -> Err e
    is Ok (_) -> when (when cg-worker-style owner (when owner.hunter is None -> 0 is Just (h) -> h.serial) cst-fighter is Err (e) -> Err e is Ok (_) -> cg-worker-style owner (when owner.fighter is None -> 0 is Just (f) -> f.serial) cst-fighter)
      is Err (e) -> Err e
      is Ok (_) -> when cg-worker-style owner (when owner.farmer is None -> 0 is Just (f) -> f.serial) cst-farmer
      is Err (e) -> Err e
      is Ok (_) -> when owner.town
        is None -> Ok 0
        is Just (t) -> when cg-resident-dress t 0
          is Err (e) -> Err e
          is Ok (_) -> Ok (cg-resident-names owner t 0)
  cg-resident-names : CompositeGame, TownLive, Integer -> Integer
  cg-resident-names (owner) (t) (i) = if i == t.count then 0
    else let p = tf-person t.people (list-at t.residents i).person
    in let named = if p.world-serial == 0 then 0 else cg-npc-name owner p.world-serial p.name
    in cg-resident-names owner t (i + 1)
  cg-resident-dress : TownLive, Integer -> Result Integer Text
  cg-resident-dress (t) (i) = if i == t.count then Ok 0
    else let serial = (tf-person t.people (list-at t.residents i).person).world-serial
    in when world-get t.vendors.game.world serial
      is Err (_) -> cg-resident-dress t (i + 1)
      is Ok (m) -> if m.kind /= 1 then cg-resident-dress t (i + 1)
        else when cst-apply t.items serial (tl-look i serial)
          is Err (e) -> Err e
          is Ok (_) -> cg-resident-dress t (i + 1)
  cg-worker-dress : CompositeGame, Integer -> Result Integer Text
  cg-worker-dress (owner) (i) = if i == list-length owner.miners then cg-worker-lead owner
    else when cg-worker-style owner (list-at owner.miners i).serial (list-at owner.miners i).trade.look
      is Err (e) -> Err e
      is Ok (_) -> cg-worker-dress owner (i + 1)

  cg-spec-add : List GameOpcodeSpec, GameOpcodeSpec, Integer -> Result (List GameOpcodeSpec) Text
  cg-spec-add (specs) (spec) (i) = if i == list-length specs then Ok (list-push specs spec)
    else let old = list-at specs i
    in if old.opcode /= spec.opcode then cg-spec-add specs spec (i + 1)
    else if old.size == spec.size & old.minimum == spec.minimum & old.maximum == spec.maximum then Ok specs
    else Err "composite opcode bounds disagree"
  cg-spec-merge : List GameOpcodeSpec, List GameOpcodeSpec, Integer -> Result (List GameOpcodeSpec) Text
  cg-spec-merge (specs) (more) (i) = if i == list-length more then Ok specs
    else when cg-spec-add specs (list-at more i) 0
      is Err (e) -> Err e
      is Ok (next) -> cg-spec-merge next more (i + 1)
  cg-specs : Integer -> Result (List GameOpcodeSpec) Text
  cg-specs (unused) = when cg-spec-merge gv-specs (gsi-specs 0) 0
    is Err (e) -> Err e
    is Ok (items) -> when cg-spec-merge items (cb-specs 0) 0
      is Err (e) -> Err e
      is Ok (combat) -> when cg-spec-merge combat (as-specs 0) 0
        is Err (e) -> Err e
        is Ok (skills) -> when cg-spec-merge skills (cpr-specs 0) 0
          is Err (e) -> Err e
          is Ok (crafted) -> when cg-spec-merge crafted bbs-specs 0
            is Err (e) -> Err e
            is Ok (boards) -> cg-spec-merge boards [GameOpcodeSpec { opcode = #6F, size = 0, minimum = 8, maximum = 64 },
              GameOpcodeSpec { opcode = #B1, size = 0, minimum = 23, maximum = 256 }] 0

  cg-game : Integer -> Result GameShard Text
  cg-game (capacity) = when world-new capacity
    is Err (e) -> Err e
    is Ok (world) -> let accounts = ga-new ga-public
      in Ok (GameShard { world = world, characters = ga-working accounts, accounts = accounts, next-key = 305419895, pending-key = 0, active = 0, log = slg-new slg-trace, skills = chs-new 0 })
 A new world is founded on one page and grows while founding, then a page at a time at the round's growth point
 (UoaixDynamicTables.md, step 5).
  cg-founding-capacity : Integer = 256
  cg-found-grow : WorldTable, GsiState, EpGoods -> Result Integer Text
  cg-found-grow (world) (items) (goods) = bb-found-grow world items goods
  cg-new : Integer -> Result CompositeGame Text
  cg-new (z) = when cg-game cg-founding-capacity
    is Err (e) -> Err e
    is Ok (game) -> let growing = world-bind-grow game.world (\u -> world-grow game.world) in when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
  cg-founded : GameShard, GvWorld, GsiState -> Result CompositeGame Text
  cg-founded (game) (vendor) (items) =
          let people = tf-new 0
          in let mind = tm-new 0
          in let combat = cb-new game 42
          in let merchant = cb-ensure combat game (list-at vendor.vendors 0).serial
          in let protected = when merchant is Err (_) -> 0 is Ok (actor) -> let immune = __record-set actor "immune" True in 0
          in let checkpoint = GameCheckpoint { game = game,
            state = TownState { checkpoint = WorldCheckpoint { world = game.world, tick = 0, sequence = 0 }, townsfolk = people, mind = mind } }
          in when cg-context checkpoint vendor items combat
            is Err (e) -> let stopped = world-unbind-grow game.world in Err e
            is Ok (owner) -> let growing = if game.world.growing then world-bind-grow game.world (\u -> cg-grow owner) else 0
              in let dressed = cg-vendor-dress owner 0
              in let stopped = world-unbind-grow game.world
              in when dressed
              is Err (e) -> Err e
              is Ok (_) -> Ok owner
  cg-britain : WalkMap -> Result CompositeGame Text
  cg-britain (map) = when cg-game cg-founding-capacity
    is Err (e) -> Err e
    is Ok (game) -> when bb-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when Ok 0
       is Err (e) -> Err e
       is Ok (_) -> let vendor = gv-new game currency
        in let items = gsi-new game.world
        in let growing = world-bind-grow game.world (\u -> cg-found-grow game.world items vendor.currency.world.goods)
        in when bb-populate vendor items map
          is Err (e) -> Err e
          is Ok (shops) -> when tl-populate vendor items map None 0 3
            is Err (e) -> Err e
            is Ok (town) -> when tnv-new town
             is Err (e) -> Err e
             is Ok (network) -> if gla-market network.actions True < 0 then Err "town network market policy"
              else when cgg-new town map
              is Err (e) -> Err e
              is Ok (gatherer) -> when cgf-spawn town map gatherer.home
              is Err (e) -> Err e
              is Ok (fighter) -> let hunter = cg-spawn-hunter town map fighter.home
              in when cg-founded game vendor items
              is Err (e) -> Err e
              is Ok (owner) -> let a = __record-set owner "town" (Just town)
                in let seeding = __record-set town "seeded-hook" (cg-seeded-hook owner)
                in let b = __record-set owner "town-map" (Just map)
                in let c = __record-set owner "network" (Just network)
                in let d = __record-set owner "shops" (Just shops)
                in let e = __record-set shops "known" owner.known
                in let f = __record-set owner "gatherer" (Just gatherer)
                in let g = __record-set owner "fighter" (Just fighter)
                in let h = __record-set owner "hunter" hunter
                in let noted = when hunter is Just (_) -> 0 is None -> let n = __record-set owner "load-faults" (owner.load-faults & "hunter not founded: no bed; ") in 0
                in Ok owner
 A hunter the town cannot place is not founded, and the server starts without it.
  cg-spawn-hunter : TownLive, WalkMap, BbSpot -> Maybe CgFighter
  cg-spawn-hunter (town) (map) (after) = when cgf-spawn-as cgh-profile town map after
    is Ok (h) -> Just h
    is Err (_) -> None

  cg-town-status : CompositeGame, List Integer, GameReply -> GameReply
  cg-town-status (owner) (packet) (reply) = when owner.town
    is None -> reply
    is Just (town) -> if list-length packet /= 5 | list-at packet 0 /= 9 then reply
      else let said = tls-status town (gp-u32 packet 1)
      in if list-length said == 0 then reply else gs-reply (reply.packets & said) reply.note
  cg-town-show : CompositeGame, TownLive, WalkMap, GameShard, GameInput -> Maybe GameReply
  cg-town-show (owner) (town) (britain) (game) (input) = when world-get game.world input.session.serial
    is Err (_) -> None
    is Ok (viewer) -> let book = when owner.network is None -> None is Just (n) -> Just n.actions.book
      in let packets = tls-show town britain book owner.shows (gv-slot game input.session.serial 0) viewer input.connection
      in if list-length packets == 0 then None else Just (gs-reply packets "townsfolk show")
  cg-speech-bind : CompositeGame -> Result Integer Text
  cg-speech-bind (owner) = when owner.town
    is None -> Ok 0
    is Just (town) -> when owner.shops
      is None -> Ok 0
      is Just (shops) -> when ns-bind town shops owner.banks
        is Err (e) -> Err e
        is Ok (speech) -> let dated = __record-set speech "day-hook" (\unused -> owner.day-hook 0) in let bound = __record-set owner "speech" (Just speech)
          in if owner.speech-held == 0 then Ok speech.count
          else when nsc-decode speech owner.speech-hold nsc-bytes
            is Err (e) -> Err e
            is Ok (_) -> if nsc-read-tail speech (owner.speech-hold + nsc-bytes) (owner.speech-held - nsc-bytes) < 0 then Err "NPC speech tail"
              else let released = __record-set owner "speech-held" 0 in Ok speech.count
 128 spawn slots keep wild populations a small fraction of world capacity.
  cg-spawn-slots : Integer = 128
 #50415354 ("PAST") changes the catalog revision, so a spawn save written before the pasture region retires its rows.
  cg-pasture-revision : Integer = #50415354
  cg-pasture : WsCatalog -> WsCatalog
  cg-pasture (c) = let r = cgg-pasture-region
    in WsCatalog { revision = bit-xor c.revision cg-pasture-revision, profiles = c.profiles,
      groups = c.groups & [WsGroup { key = "pasture", choices = [WsChoice { key = "sheep", profile = cg-profile-index c.profiles "sheep" 0, group = -1, weight = 1 }] }],
      regions = c.regions & [WsRegion { id = 9303, name = "Pasture", area = WsRect { x1 = r.x1, y1 = r.y1, x2 = r.x2, y2 = r.y2 },
        maximum = cgw-sheep, batch = cgw-sheep, minimum-minutes = 5, maximum-minutes = 10, group = list-length c.groups,
        preferred-height = 18, fixed-height = -129, outside = False, exclusions = [] }] }
 Two ore elementals (UOX3 earth and dull copper) haunt the rock faces of the Britain mine strip, where they mine
 (cg-spawn-mine, UOAIX-140 f). #4D494E45 ("MINE") changes the catalog revision, so a spawn save written before the
 region retires its rows.
  cg-mine-revision : Integer = #4D494E45
  cg-ore-ground : WsCatalog -> WsCatalog
  cg-ore-ground (c) = WsCatalog { revision = bit-xor c.revision cg-mine-revision, profiles = c.profiles,
    groups = c.groups & [WsGroup { key = "ore elementals", choices = [WsChoice { key = "earthele", profile = cg-profile-index c.profiles "earthele" 0, group = -1, weight = 1 },
      WsChoice { key = "dullcopperele", profile = cg-profile-index c.profiles "dullcopperele" 0, group = -1, weight = 1 }] }],
    regions = c.regions & [WsRegion { id = 9304, name = "Britain mine", area = WsRect { x1 = 1445, y1 = 1526, x2 = 1457, y2 = 1534 },
      maximum = 2, batch = 1, minimum-minutes = 10, maximum-minutes = 20, group = list-length c.groups,
      preferred-height = 18, fixed-height = -129, outside = False, exclusions = [] }] }
 Every spawn slot has an economy actor of its own (UOAIX-140 (a): monsters carry what they take), each on its own purse
 (a purse serves one actor, ep-admit) owned by cg-wild-owner plus the slot, so the binding is found again in the economy
 at load; it is made at load and at the spawn growth point, below the serving mark, and grows the purse and actor
 tables itself because neither runs with the world's growth bound.
  cg-wild-owner : Integer = 5000000
 Two kinds of actor carry lots with no owner row, so the vendor check accepts them (UOAIX-143): a wild spawn's (purse
 owner cg-wild-owner + slot), whose mobile dies and whose corpse keeps them (UOAIX-140 c, d and f), and a townsfolk
 resident's (purse owner 2000 + resident, at most 128 homes), whose pack holds its trade's goods (tl-pack).
  cg-wild-keeps : CompositeGame, Integer -> Boolean
  cg-wild-keeps (owner) (actor) = let w = owner.vendor.currency.world
    in if not (ep-valid-actor w actor) then False
    else let purse = (ep-actor w actor).purse
    in if not (em-valid-purse w.money purse) then False
    else let p = em-purse w.money purse
    in p.kind == 2 & ((p.owner >= cg-wild-owner & p.owner < cg-wild-owner + 1000000) | (p.owner >= 2000 & p.owner < 2128)
      | (p.owner >= cg-cast-owner & p.owner < cg-cast-owner + plr-slots * pls-max-cast))
  cg-play-near : GvWorld, WorldTable, Integer, Integer, Integer -> Integer
  cg-play-near (v) (world) (x) (y) (i) = if i >= v.player-count then 0 - 1
    else let p = list-at v.players i
    in let close = when world-get world p.serial
      is Err (_) -> False
      is Ok (m) -> m.health > 0 & m.x >= x - 3 & m.x <= x + 3 & m.y >= y - 3 & m.y <= y + 3
    in if close & p.actor > 0 & p.pack > 0 then i else cg-play-near v world x y (i + 1)
  cg-play-pack : GsiState, Integer -> Integer
  cg-play-pack (items) (npc) = let held = gsi-pack-find items.world npc 0
    in if held > 0 then held
    else when world-create items.world (__record-set (__record-set (gs-item npc #0E75 0) "x" 0) "y" 0)
      is Err (_) -> 0
      is Ok (made) -> if gsi-register items made 21 #3C False False /= 0 then 0 else made
  cg-play-lot : GvWorld, WorldTable, Integer, Integer, Integer -> Integer
  cg-play-lot (v) (world) (actor) (item) (child) = if child == 0 then 0
    else let at = gv-lot v child 0
    in let ok = at >= 0 & (let lot = ep-lot v.currency.world.goods at in lot.item == item & lot.actor == actor)
    in if ok then child else cg-play-lot v world actor item (world-next-sibling world child)
  cg-play-hand : CompositeGame, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Boolean -> Integer
  cg-play-hand (s) (from) (pack) (to) (into) (item) (n) (player) (receiving) =
    let v = s.vendor
    in let items = s.items
    in let held = if pack == 0 | into == 0 then 0 else cg-play-lot v items.world from item (world-first-child items.world pack)
    in if held == 0 then 0 - 1
    else let at = gv-lot v held 0
    in let lot = ep-lot v.currency.world.goods at
    in let w = v.currency.world
    in when world-get items.world held
      is Err (_) -> 0 - 1
      is Ok (thing) -> let take = min n (min thing.amount (ep-amount w.goods lot.serial))
        in if take < 1 | ep-at (ep-actor w from).stock item < take | not (ep-room (ep-actor w to) item take) then 0 - 1
        else if take == thing.amount then
          (when world-update items.world (__record-set (__record-set (__record-set thing "container" into) "x" 60) "y" 80)
            is Err (_) -> 0 - 1
            is Ok (_) -> let moved = ep-hand w at to take lot.serial (0 - 1) in let q = gh-invalidate-quotes v 0 in let t = world-item-touch items.world
              in let told = (when world-get items.world held is Err (_) -> 0 is Ok (there) -> cg-tell s player [if receiving then gsi-placement items there else sip-remove held] 0) in take)
        else when world-update items.world (__record-set thing "amount" (thing.amount - take))
          is Err (_) -> 0 - 1
          is Ok (_) -> when world-create items.world (__record-set (__record-set (__record-set (gs-item into thing.graphic thing.hue) "amount" take) "x" 60) "y" 80)
            is Err (_) -> 0 - 1
            is Ok (made) -> let known = gsi-register items made 0 0 True True
              in let moved = ep-hand w at to take made (0 - 1) in let q = gh-invalidate-quotes v 0 in let t = world-item-touch items.world
              in let told = (when world-get items.world (if receiving then made else held) is Err (_) -> 0 is Ok (shown) -> cg-tell s player [gsi-placement items shown] 0) in take
 Coin in a play's give or take moves between the cast member's purse and the player's, as the mayor's donation does
 (cg-gift-pay); a short purse gives what it holds. The player is told what changed hands.
  cg-play-coin : CompositeGame, Integer, Integer, Integer, Integer, Integer, Boolean -> Integer
  cg-play-coin (s) (from) (to) (metal) (n) (player) (receiving) =
    let x = s.vendor.currency
    in let w = x.world
    in if not (ep-valid-actor w from) | not (ep-valid-actor w to) then 0 - 1
    else let payer = (ep-actor w from).purse
    in let payee = (ep-actor w to).purse
    in let held = (em-purse (eu-money x metal) payer).coin
    in let amount = min n held
    in if amount < 1 then 0 - 1
    else let moved = cg-gift-pay x payer payee metal amount
    in if moved < 1 then 0 - 1
    else let coin = if metal == 1 then "copper" else if metal == 2 then "silver" else "gold"
    in let told = cg-tell s player [sip-message #FFFFFFFF #FFFF 6 ((if receiving then "You receive " else "You hand over ") & show moved & " " & coin & ".")] 0 in moved
  cg-play-trade : CompositeGame, Integer, Integer, Integer, Integer, Integer -> Integer
  cg-play-trade (s) (slot) (cast) (kind) (item) (n) =
    let npc = plr-cast s.plays slot cast
    in let actor = cg-cast-actor s slot cast
    in if npc == 0 | actor < 1 then 0 - 1
    else when world-get s.checkpoint.game.world npc
      is Err (_) -> 0 - 1
      is Ok (m) -> let i = cg-play-near s.vendor s.checkpoint.game.world m.x m.y 0
        in if i < 0 then 0 - 1
        else let p = list-at s.vendor.players i
        in let bag = cg-play-pack s.items npc
        in if item < 0 then cg-play-coin s (if kind == pls-give then actor else p.actor) (if kind == pls-give then p.actor else actor) (0 - item) n p.serial (kind == pls-give)
        else if kind == pls-give then cg-play-hand s actor bag p.actor p.pack item n p.serial True
        else cg-play-hand s p.actor p.pack actor bag item n p.serial False
  cg-cast-owner : Integer = 6000000
  cg-label-actor : EuCurrency, Integer -> Integer
  cg-label-actor (x) (label) = let found = em-find x.world.money 2 label 1
    in let room = if found /= 0 | x.world.money.purse-count < list-length x.world.money.purses then 0 else eu-grow-purses x
    in let purse = if found /= 0 then found else eu-open x 2 label
    in if purse < 1 then -1
    else let held = cg-actor-of x.world purse 0
    in let seats = if held > 0 | x.world.actor-count < list-length x.world.actors then 0 else ep-grow-actors x.world ep-actor-block
    in if held > 0 then held else ep-admit x.world purse cgg-town-place
  cg-cast-live : PlrStore, Integer -> Integer
  cg-cast-live (st) (slot) = if plr-run st slot 0 == plr-running | plr-run st slot 0 == plr-paused then pls-count (plr-table st slot) 2 else 0
  cg-cast-due-at : CompositeGame, Integer, Integer -> Boolean
  cg-cast-due-at (s) (slot) (i) = if slot >= plr-slots then False
    else if i >= min pls-max-cast (cg-cast-live s.plays slot) then cg-cast-due-at s (slot + 1) 0
    else if peek-qword s.cast-actors ((slot * pls-max-cast + i) * 8) == 0 then True
    else cg-cast-due-at s slot (i + 1)
  cg-cast-due : CompositeGame -> Boolean
  cg-cast-due (s) = cg-cast-due-at s 0 0
  cg-cast-bind : CompositeGame, Integer, Integer, Integer -> Integer
  cg-cast-bind (s) (slot) (i) (n) = if slot >= plr-slots then n
    else if i >= min pls-max-cast (cg-cast-live s.plays slot) then cg-cast-bind s (slot + 1) 0 n
    else let cell = (slot * pls-max-cast + i) * 8
    in if peek-qword s.cast-actors cell /= 0 then cg-cast-bind s slot (i + 1) n
    else let actor = cg-label-actor s.vendor.currency (cg-cast-owner + slot * pls-max-cast + i)
    in let kept = if actor > 0 then poke-qword s.cast-actors cell actor else 0
    in cg-cast-bind s slot (i + 1) (if actor > 0 then n + 1 else n)
  cg-cast-actor : CompositeGame, Integer, Integer -> Integer
  cg-cast-actor (s) (slot) (i) = if slot < 0 | slot >= plr-slots | i < 0 | i >= pls-max-cast then 0 else peek-qword s.cast-actors ((slot * pls-max-cast + i) * 8)
  cg-wild-actor : EuCurrency, Integer -> Integer
  cg-wild-actor (x) (slot) = let found = em-find x.world.money 2 (cg-wild-owner + slot) 1
    in let room = if found /= 0 | x.world.money.purse-count < list-length x.world.money.purses then 0 else eu-grow-purses x
    in let purse = if found /= 0 then found else eu-open x 2 (cg-wild-owner + slot)
    in if purse < 1 then -1
    else let held = cg-actor-of x.world purse 0
    in let seats = if held > 0 | x.world.actor-count < list-length x.world.actors then 0 else ep-grow-actors x.world ep-actor-block
    in if held > 0 then held else ep-admit x.world purse cgg-town-place
  cg-bind-spawns : CompositeGame, GameWorldSpawn, Integer -> Result Integer Text
  cg-bind-spawns (owner) (g) (i) = if i >= list-length g.slots then Ok i
    else if (list-at g.slots i).actor > 0 then cg-bind-spawns owner g (i + 1)
    else let actor = cg-wild-actor owner.vendor.currency i
    in if actor < 1 then Err ("wild actor refused at slot " & show i)
    else let bound = __record-set (list-at g.slots i) "actor" actor in cg-bind-spawns owner g (i + 1)
  cg-profile-index : List WsProfile, Text, Integer -> Integer
  cg-profile-index (profiles) (key) (i) = if i == list-length profiles then -1
    else if (list-at profiles i).key == key then i else cg-profile-index profiles key (i + 1)
  cg-spawn-attach : CompositeGame -> Result Integer Text
  cg-spawn-attach (owner) = when gws-new (cg-ore-ground (cg-pasture (gws-with-summons (wsd-catalog 0)))) owner.combat (max cg-spawn-slots (if owner.spawn-held >= 64 then peek-qword owner.spawn-hold 32 else 0))
    is Err (e) -> Err e
    is Ok (spawns) -> let bound = __record-set owner "spawns" (Just spawns)
      in let hooked = __record-set spawns.combat "death-hook" (cg-deaths owner spawns)
      in let vanishing = __record-set spawns.combat "vanish-hook" (gws-summoned spawns)
      in let reviving = __record-set spawns.combat "revive-hook" (cg-vendor-serial owner)
      in let falling = __record-set spawns.combat "fall-hook" (cg-vendor-fall owner)
      in let practised = __record-set spawns.combat "swing-hook" (cg-swings owner)
      in let venomous = __record-set spawns.combat "poison-hook" (gws-poison spawns)
      in let hunting = __record-set spawns "prey" (cg-prey owner)
      in let sparing = __record-set spawns "spared" (cg-town-worker owner)
      in let wild = when cg-bind-spawns owner spawns 0 is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "spawn actors: " & e & "; ") in 0 is Ok (n) -> n
      in if owner.spawn-held == 0 then Ok 0
      else if owner.spawn-held >= 64 & peek-qword owner.spawn-hold 16 /= spawns.catalog.revision then
        when gwsc-retire spawns owner.checkpoint.game.world owner.spawn-hold owner.spawn-held
          is Err (e) -> Err e
          is Ok (removed) -> let released = __record-set owner "spawn-held" 0 in Ok (2 + removed)
      else when gwsc-decode spawns owner.checkpoint.game.world get-ticks owner.spawn-hold owner.spawn-held
        is Err (e) -> Err e
        is Ok (_) -> let released = __record-set owner "spawn-held" 0 in Ok 1
 UOX3 ONLYOUTSIDE: a tile is outside when no collider starts at or above head
 height (16 units, the walk headroom) over the standing point.
 With no client connected, the world advances around an NPC `watcher` over a
 walk window the caller loaded: one spawn pass, then one round of combat swings;
 the packets have no recipient.
  cg-world-tick : CompositeGame, GameShard, WalkMap, Integer, Integer -> Result Integer Text
  cg-world-tick (owner) (game) (map) (watcher) (tick) = let held = __record-set owner "tick-map" map
    in let holding = __record-set owner "tick-held" True
    in let seen = __record-set owner "tick-watcher" watcher
    in when (if cg-seeded owner then cg-errand-arm owner tick else Ok 0)
    is Err (e) -> Err e
    is Ok (_) -> when cg-british-arm owner tick
    is Err (e) -> Err e
    is Ok (_) -> cg-drain owner game tick
 Spawns (key 0) and the NPC combat round (key 1) step on the wheel once a second around the world tick's watcher, over
 the map cache's walk window the tick last held (allocated at boot, below the compaction mark); an entry that falls due
 before the first world tick waits for the next drain. Their packets have no recipient, as the tick's had.
  cgr-kind : Integer = 14
  cgr-ticks : Integer = gm-ticks 1000
  cg-arm-rounds : CompositeGame -> Result Integer Text
  cg-arm-rounds (owner) = if wtm-set owner.timers (owner.timers.limit + 1) cgr-kind 0 < 0 | wtm-set owner.timers (owner.timers.limit + 1) cgr-kind 1 < 0 then Err "round timer pool full" else Ok 0
  cg-round-fire : CompositeGame, GameShard, Integer, Integer -> Result Integer Text
  cg-round-fire (owner) (game) (key) (tick) = let map = owner.tick-map
    in if not owner.tick-held then (if wtm-add owner.timers (tick + 1) cgr-kind key < 0 then Err "round timer pool full" else Ok 0)
    else if wtm-add owner.timers (tick + cgr-ticks) cgr-kind key < 0 then Err "round timer pool full"
        else if owner.tick-watcher == 0 then Ok 0
        else if key == 0 then cg-spawn-round owner game map tick
        else when cb-swings owner.combat game (gn-input 0) map 0 []
          is Err (e) -> Err e
          is Ok (struck) -> let corpses = gr-corpse-packets owner.items struck 0 in Ok 1
 The save (key 0, every 60 s) and the world-store reports (key 1, every second) fall due on the wheel: the drain sets
 the key's bit in store-due and cs-tick and cs-pulse act on it, because a save writes the disk and the drain cannot.
  cgd-kind : Integer = 15
  cgd-save-ticks : Integer = gm-ticks 60000
  cgd-report-ticks : Integer = gm-ticks 1000
  cg-arm-store : CompositeGame -> Result Integer Text
  cg-arm-store (owner) = if wtm-set owner.timers (owner.timers.limit + cgd-save-ticks) cgd-kind 0 < 0 | wtm-set owner.timers (owner.timers.limit + 1) cgd-kind 1 < 0 then Err "store timer pool full" else Ok 0
  cg-store-fire : CompositeGame, Integer, Integer -> Result Integer Text
  cg-store-fire (owner) (key) (tick) = if wtm-add owner.timers (tick + (if key == 0 then cgd-save-ticks else cgd-report-ticks)) cgd-kind key < 0 then Err "store timer pool full"
    else let due = __record-set owner "store-due" (bit-or owner.store-due (bit-shl 1 key)) in Ok 1
  cg-spawn-wake : CompositeGame, GameShard, Integer, Integer -> Result Integer Text
  cg-spawn-wake (owner) (game) (key) (tick) = when owner.spawns
    is None -> Ok 0
    is Just (s) -> if not owner.tick-held then Ok (gws-arm s key) else gws-wake s game owner.tick-map owner.tick-watcher key tick
  cg-spawn-round : CompositeGame, GameShard, WalkMap, Integer -> Result Integer Text
  cg-spawn-round (owner) (game) (map) (tick) = when owner.spawns
    is None -> Ok 0
    is Just (spawns) -> if is-err (world-get game.world owner.tick-watcher) then Ok 0
      else let dressed = cg-dress-spawns owner spawns 0 in when gws-world cg-spawn-terrain spawns game owner.tick-watcher map tick []
      is Err (e) -> Err e
      is Ok (_) -> Ok 1
  cg-tick-watcher : CompositeGame -> Integer
  cg-tick-watcher (owner) = when owner.gatherer is None -> 0 is Just (c) -> c.serial
  cg-tick : CompositeGame, GameShard, WalkMap, Integer, Integer -> Result Integer Text
  cg-tick (owner) (game) (map) (watcher) (tick) = if watcher /= 0 then cg-world-tick owner game map watcher tick
    else let unseen = __record-set owner "tick-watcher" 0
    in when cg-british-arm owner tick
      is Err (e) -> Err e
      is Ok (_) -> cg-drain owner game tick
 UOAIX-86 (3): no NPC trades, works, earns or buys until Lord British's errand has struck the gold he mined (cbe-bank
 ends the errand, and the errand is saved); founding strikes one gold ingot, so the mint count cannot say this.
 The minter seeds the economy during play, above the serving mark, so a world with no errand yet takes the spare one
 cg-context allocated at load (UOAIX-123, L-BELOWMARK).
  cg-seeded : CompositeGame -> Boolean
  cg-seeded (owner) = when owner.british is None -> False is Just (c) -> cbe-finished c
  cg-seeded-hook : CompositeGame, Integer -> Boolean
  cg-seeded-hook (owner) (unused) = cg-seeded owner
  cg-seed-gold : CompositeGame -> Integer
  cg-seed-gold (owner) = when owner.british
    is Just (c) -> let done = __record-set c "leg" cbe-done in 1
    is None -> when owner.british-spare
      is None -> 0
      is Just (c) -> let done = __record-set c "leg" cbe-done
        in let bound = __record-set owner "british" owner.british-spare in 1
 The TESTING OPEN launch opens the economy with the gold British's strike would bring: the crown strikes one gold ingot
 at the Royal Mint into the treasury (purse 1), and copper and silver beside it so the treasury makes change from
 the first hour (root for Damian, 2026-10-09, UOAIX-148), which the shops' crown loans draw on (bb-borrow-shops). A new world's
 treasury starts empty (Damian 2026-10-07), so without the strike no shop borrows, holds coin or buys (UOAIX-137).
  cg-open-treasury : CompositeGame -> Integer
  cg-open-treasury (owner) = let x = owner.vendor.currency
    in let crown = x.world.mint-owner
    in if crown <= 0 | not (ep-valid-actor x.world crown) | (em-purse x.world.money 1).coin > 0 then 0
    else when bb-require (bb-producer x crown) 62 1
      is Err (_) -> 0
      is Ok (_) -> let station = bb-station x.world crown 12 0
        in if station < 1 | ep-find x.world crown 32 1 < 0 then 0
        else if eu-strike x True crown station 3 1 /= 0 then 0
        else let gold = (em-purse x.world.money 1).coin
        in let copper = cg-open-change x crown station 1 (gold * x.copper-rate)
        in let silver = cg-open-change x crown station 2 (gold * x.silver-rate) in 1
 The opening strikes copper and silver enough to change every gold it struck at the current rates (root for Damian,
 2026-10-09, amending UOAIX-148): gold x copper-rate copper and gold x silver-rate silver, as ingots of each metal's yield.
  cg-open-change : EuCurrency, Integer, Integer, Integer, Integer -> Integer
  cg-open-change (x) (crown) (station) (metal) (coins) = let yield = if metal == 1 then x.copper-yield else x.silver-yield
    in if coins <= 0 | yield <= 0 then 0
    else let ingots = min 1000 ((coins + yield - 1) / yield)
    in if ep-find x.world crown (if metal == 1 then 65 else 66) ingots < 0 then -1
    else if eu-strike x True crown station metal ingots /= 0 then -1
    else cg-open-change x crown station metal (coins - ingots * yield)
  cg-open-economy : CompositeGame -> Integer
  cg-open-economy (owner) = let struck = cg-open-treasury owner in cg-seed-gold owner
 Root, 2026-10-09 (the jeweler): a slain spawned creature carries gems where UOX3's loot lists give its kind them
 (data/dfndata/items/lootlists.dfn randomgems, through each npc's LOOT lists): the expected gems a kill in hundredths, 71
 for most, 14 the earth elemental's, 73 the ice and lava serpents'; a kill gives the whole gems and one more at the
 hundredths' chance, made on the creature so cb-transfer moves them into its corpse. A summoned creature drops none.
  cg-gem-kinds : List Text = ["ancientlich", "ancientwyrm", "arcticogrelord", "bloodele", "bonemage", "cyclops", "daemon", "dullcopperele", "efreet", "eldergazer", "ettin", "evilmagelord", "fireele", "frostooze", "frosttroll", "gargoyle", "graydragon", "graydrake", "lich", "lichlord", "mummy", "nightmare", "ogre", "ogrelord", "ophavenger", "ophenforcer", "ophknight", "ophmatriarch", "ophwarrior", "poisonele", "rottingcorpse", "shadowwyrm", "slime", "spectralarmor", "spectre", "stonegargoyle", "stoneharpy", "swampdragon", "teraavenger", "teramatriarch", "troll", "whitewyrm", "wraith"]
  cg-gem-loot-of : Text -> Integer
  cg-gem-loot-of (key) = if key == "earthele" then 14 else if key == "iceserpent" | key == "lavaserpent" then 73 else if cg-text-in cg-gem-kinds key 0 then 71 else 0
  cg-text-in : List Text, Text, Integer -> Boolean
  cg-text-in (xs) (x) (i) = if i >= list-length xs then False else if list-at xs i == x then True else cg-text-in xs x (i + 1)
  cg-gem-loot : CompositeGame, GameWorldSpawn, Integer -> Integer
  cg-gem-loot (owner) (spawns) (victim) = let i = if victim <= 0 then -1 else gws-slot-of spawns victim 0
    in if i < 0 then 0
    else let slot = list-at spawns.slots i
    in if slot.summoned > 0 then 0
    else let hundredths = cg-gem-loot-of (list-at spawns.catalog.profiles slot.profile).key
    in let roll = int-mod (bit-and (mix-bits victim owner.clock) #7FFFFFFF) 100
    in cg-gem-give owner victim (hundredths / 100 + (if roll < int-mod hundredths 100 then 1 else 0)) roll
  cg-gem-give : CompositeGame, Integer, Integer, Integer -> Integer
  cg-gem-give (owner) (victim) (n) (draw) = if n <= 0 | world-room owner.items.world <= 0 then 0
    else when world-create owner.items.world (gs-item victim (list-at bb-gem-arts (int-mod draw 9)) 0)
      is Err (_) -> 0
      is Ok (serial) -> let known = gsi-register owner.items serial 0 0 False False in 1 + cg-gem-give owner victim (n - 1) (draw + 4)
 Every death passes the composite's NPCs: a dead gatherer or fighter is settled at the blow (cgg-fall, cgf-death), and a kill by
 the fighter loots the victim.
  cg-deaths : CompositeGame, GameWorldSpawn, Integer, Integer -> Integer
  cg-deaths (owner) (spawns) (source) (victim) =
    let unmounted = cg-unmount-dead owner victim
    in let logged = cg-death-note owner source victim (cg-death-role owner victim)
    in let murdered = cg-crime owner source victim 3
    in let mourned = cg-dead-note owner victim
    in let bountied = cg-bounty-kill owner spawns source victim
    in let renowned = cg-renown owner spawns source victim
    in let jewels = cg-gem-loot owner spawns victim
    in let unbound = when owner.town is None -> 0 is Just (t) -> cg-unbind-person t victim 1
    in let unpaired = cg-duel-clear owner.duels victim 0
    in let gathered = when owner.gatherer is None -> 0 is Just (g) -> if g.serial /= 0 & victim == g.serial then cgg-fall g owner.vendor else 0
    in let farmed = when owner.farmer is None -> 0 is Just (g) -> if g.serial /= 0 & victim == g.serial then cgg-fall g owner.vendor else 0
    in let worked = cg-workers-fall owner.miners owner.vendor victim 0
    in let citied = cg-workers-fall owner.city-workers owner.vendor victim 0
    in let resided = when owner.town is None -> 0 is Just (t) -> cg-residents-fall t victim 0
    in let hunted = when owner.hunter is None -> 0 is Just (h) -> cgf-death h spawns owner.vendor source victim
    in let fought = when owner.fighter is None -> 0 is Just (c) -> cgf-death c spawns owner.vendor source victim
    in let settled = cg-owner-fall owner.vendor victim
    in fought
  cg-owner-fall : GvWorld, Integer -> Integer
  cg-owner-fall (v) (victim) = let i = if victim <= 0 then -1 else gv-owner v victim 0
    in if i < 0 then 0
    else let actor = (list-at v.owners i).actor
    in let dropped = cgg-drop-lots v actor 0
    in let gone = cgg-unregister v actor 0 in 1
 The workers past the gatherer (miners, fibre workers, pickers and the rest in owner.miners) settle at the blow too, so no
 save sees an owner row whose mobile the death removed before the worker's own step (UOAIX-151).
 A killed resident settles at the blow the same way (UOAIX-143, trial 42626: owner row 26, serial 2093, outlived its killed mobile):
 its lots leave the ledger and its owner row goes, as crm-retire does for a removed one; its census death stays tl-die's.
  cg-residents-fall : TownLive, Integer, Integer -> Integer
  cg-residents-fall (t) (victim) (i) = if i >= t.count then 0
    else let r = list-at t.residents i
    in let p = tf-person t.people r.person
    in if p.alive == 1 & p.world-serial == victim then (let dropped = cgg-drop-lots t.vendors r.actor 0 in let gone = cgg-unregister t.vendors r.actor 0 in 1)
    else cg-residents-fall t victim (i + 1)
 UOX3 cChar::Die (Karma and Fame for the attacker): a player who kills moves toward the dead's karma and fame (a player's
 own, a spawn's UOX3 values; a townsperson or worker counts 0) and is told by how much; a player who dies loses 1/25
 of its fame. Read before either is written, so a player killed by a player is weighed at its fame before the loss.
  cg-renown : CompositeGame, GameWorldSpawn, Integer, Integer -> Integer
  cg-renown (owner) (spawns) (source) (victim) = let game = owner.checkpoint.game
    in let player = gs-card game victim /= 0
    in let fame = if player then gs-rep game victim chs-fame else gws-renown spawns victim False
    in let karma = if player then gs-rep game victim chs-karma else gws-renown spawns victim True
    in let fell = if player then gs-rep-set game victim chs-fame (chs-fame-dying (gs-rep game victim chs-fame)) else 0
    in if source <= 0 | source == victim | gs-card game source == 0 then 0
    else let k0 = gs-rep game source chs-karma
    in let f0 = gs-rep game source chs-fame
    in let k1 = chs-karma-after k0 karma
    in let f1 = chs-fame-after f0 fame
    in let a = if k1 == k0 then 0 else gs-rep-set game source chs-karma k1
    in let b = if f1 == f0 then 0 else gs-rep-set game source chs-fame f1
    in let said = (if f1 == f0 then [] else [gs-system (chs-rep-said f0 f1 "fame")]) & (if k1 == k0 then [] else [gs-system (chs-rep-said k0 k1 "karma")])
    in cg-tell owner source said 0
  cg-workers-fall : List CgGatherer, GvWorld, Integer, Integer -> Integer
  cg-workers-fall (xs) (v) (victim) (i) = if i >= list-length xs then 0
    else let c = list-at xs i
    in if c.serial /= 0 & victim == c.serial then cgg-fall c v else cg-workers-fall xs v victim (i + 1)
 A wild spawned creature swung at by an NPC (a guard, a townsperson) turns on that NPC, leaving any player it was
 fighting (Damian, live 40204: guards engaged the undead in Britain and the undead kept on him).
  cg-turns-on : Boolean, Boolean, Boolean -> Boolean
  cg-turns-on (wild) (player-striker) (already) = wild & not player-striker & not already
  cg-turn-on : CompositeGame, Integer, Integer -> Integer
  cg-turn-on (owner) (attacker) (defender) = when owner.spawns
    is None -> 0
    is Just (s) -> let i = if defender <= 0 then -1 else gws-slot-of s defender 0
      in let wild = i >= 0 & (list-at s.slots i).owner == 0
      in let at = world-slot owner.checkpoint.game.world defender
      in let already = at >= 0 & (list-at owner.combat.actors at).serial == defender & (list-at owner.combat.actors at).target == attacker
      in if cg-turns-on wild (gv-player owner.vendor attacker 0 >= 0) already then cg-attack owner defender attacker else 0
  cg-swings : CompositeGame, Integer, Integer, Boolean -> Integer
  cg-swings (owner) (attacker) (defender) (hit) = let focused = if hit then cg-focus-blow owner attacker defender else 0
    in let resisted = cg-struck-guard owner attacker defender
    in let turned = cg-turn-on owner attacker defender
    in let assaulted = if hit then cg-crime owner attacker defender 2 else 0
    in let practised = when owner.hunter is None -> 0 is Just (h) -> cgf-swing h owner.combat owner.checkpoint.game attacker defender hit in when owner.fighter
    is None -> 0
    is Just (c) -> cgf-swing c owner.combat owner.checkpoint.game attacker defender hit
  cg-wander-odds : Integer = 4
  cg-keeper-box : Integer, List BbShop -> BbShop
  cg-keeper-box (i) (shops) = if i < bb-shop-count then list-at bb-shops i
    else if i - bb-shop-count < list-length shops then list-at shops (i - bb-shop-count)
    else BbShop { title = "", premises = "", x1 = 0, y1 = 0, x2 = -1, y2 = -1 }
  cg-in-box : BbShop, Integer, Integer -> Boolean
  cg-in-box (b) (x) (y) = x >= b.x1 & x <= b.x2 & y >= b.y1 & y <= b.y2
  cg-station-busy : CompositeGame, Integer -> Boolean
  cg-station-busy (owner) (i) = let s = if i == 1 then owner.smith.leg else if i == 3 then owner.baker.leg else if i == 2 then owner.tailor.leg
      else if i == 6 then owner.tinker.leg else if i == 7 then owner.carpenter.leg else if i == 10 then owner.glassblower.leg
      else if i == 11 then owner.potter.leg else if i == 13 then owner.bowyer.leg else if i == 14 then owner.tanner.leg
      else if i == 15 then owner.leatherworker.leg else if i == 16 then owner.cobbler.leg else 0
    in s > 0
  cg-wander-one : CompositeGame, GvWorld, Integer, BbShop, WalkMap -> Integer
  cg-wander-one (owner) (v) (i) (box) (map) = if i >= v.vendor-count then 0
    else if gv-shut v i | (i < bb-shop-count & cg-station-busy owner i) then 0
    else when world-get v.game.world (list-at v.vendors i).serial
      is Err (_) -> 0
      is Ok (m) -> let dir = cb-random owner.combat 8
        in let x = m.x + walk-dx dir in let y = m.y + walk-dy dir
        in if m.kind /= 1 | m.health <= 0 | not (cg-in-box box m.x m.y) | not (cg-in-box box x y) | world-blocked v.game.world x y then 0
        else when walk-step map m.x m.y m.z dir
          is Err (_) -> 0
          is Ok (z) -> when world-update v.game.world (__record-set (__record-set (__record-set m "x" x) "y" y) "z" z)
            is Err (_) -> 0
            is Ok (_) -> let touched = world-touch v.game.world in 1
  cg-wander-all : CompositeGame, GvWorld, List BbShop, Integer -> Integer
  cg-wander-all (owner) (v) (shops) (i) = if i >= v.vendor-count then 0
    else let box = cg-keeper-box i shops
    in let moved = if cb-random owner.combat cg-wander-odds /= 0 then 0
      else when cg-city-map owner box.x1 box.y1 is None -> 0 is Just (map) -> cg-wander-one owner v i box map
    in moved + cg-wander-all owner v shops (i + 1)
 A station walks the residents' Britain map; a door it opens is synced to the player map.
  cg-station : CompositeGame, CsnSmith, TownLive, WalkMap -> Result (List (List Integer)) Text
  cg-station (owner) (s) (town) (britain) = if (when owner.staff is None -> True is Just (st) -> bsh-at-work st s.vendor) then csn-smith-step s town britain owner.town-doors
    else let unbound = __record-set s "leg" -1 in Ok []
 The shop stations (keys 0 to 6, 9 to 12) and the shop trades (7) step on the wheel once a second, as the world tick stepped them;
 the townsfolk's walk with its labour hours (8) every 100 ms, metered by the game clock (tl-advance). The walk's packets
 reach a player through the pulse's drain.
  cgs-kind : Integer = 13
  cgs-trades : Integer = 7
  cgs-town : Integer = 8
  cgs-bowyer : Integer = 9
  cgs-tanner : Integer = 10
  cgs-leatherworker : Integer = 11
  cgs-cobbler : Integer = 12
  cgs-station-ticks : Integer = gm-ticks 1000
  cgs-town-ticks : Integer = gm-ticks 100
  cg-station-of : CompositeGame, Integer -> CsnSmith
  cg-station-of (owner) (key) = if key == 0 then owner.smith else if key == 1 then owner.baker else if key == 2 then owner.tailor else if key == 3 then owner.tinker else if key == 4 then owner.carpenter else if key == 5 then owner.glassblower else if key == cgs-bowyer then owner.bowyer else if key == cgs-tanner then owner.tanner else if key == cgs-leatherworker then owner.leatherworker else if key == cgs-cobbler then owner.cobbler else owner.potter
  cg-arm-stations : CompositeGame, Integer -> Result Integer Text
  cg-arm-stations (owner) (key) = if key > cgs-cobbler then Ok 0
    else if wtm-set owner.timers (owner.timers.limit + 1) cgs-kind key < 0 then Err "station timer pool full"
    else cg-arm-stations owner (key + 1)
  cg-station-fire : CompositeGame, Integer, Integer -> Result (List (List Integer)) Text
  cg-station-fire (owner) (key) (tick) = if wtm-add owner.timers (tick + (if key == cgs-town then cgs-town-ticks else cgs-station-ticks)) cgs-kind key < 0 then Err "station timer pool full"
    else when owner.town
      is None -> Ok []
      is Just (town) -> when owner.town-map
        is None -> Ok []
        is Just (britain) -> if key == cgs-town then cg-town-fire owner town britain tick
          else if key == cgs-trades then (when cg-shop-trades town is Err (e) -> Err e is Ok (_) -> let wandered = cg-wander-all owner owner.vendor (ct-city-shops 0) 0 in Ok [])
          else when cg-station owner (cg-station-of owner key) town britain
            is Err (e) -> Err e
            is Ok (packets) -> let synced = cg-door-sync owner packets 0 in Ok []
  cg-town-fire : CompositeGame, TownLive, WalkMap, Integer -> Result (List (List Integer)) Text
  cg-town-fire (owner) (town) (britain) (tick) = if not (cg-seeded owner) then Ok []
    else when cg-labor owner tick
      is Err (e) -> Err e
      is Ok (_) -> when cg-town-move owner town britain (cg-town-clock owner tick)
        is Err (e) -> Err e
        is Ok (moved) -> Ok moved.packets
 The paper mill and the scribe have no walking crafter: each world step their keepers restock at the counter from what they
 bought (the mill's logs, the scribe's blank books), so a bought input becomes listed goods; the innkeeper cooks the
 fisherman's fish the same way (bb-cook), the carpenter buys the tinker's nails and the bowyer the carpenter's boards (bb-supply).
  cg-shop-trades : TownLive -> Result Integer Text
  cg-shop-trades (town) = if town.vendors.vendor-count <= bb-scribe then Ok 0
    else when bb-restock-shop town.vendors town.items bb-mill
      is Err (e) -> Err e
      is Ok (_) -> when bb-restock-shop town.vendors town.items bb-scribe
        is Err (e) -> Err e
        is Ok (_) -> when bb-restock-stone town.vendors town.items
          is Err (e) -> Err e
          is Ok (_) -> let nailed = bb-supply town.vendors in when bb-cook town.vendors town.items
            is Err (e) -> Err e
            is Ok (_) -> when bb-brew town.vendors town.items
              is Err (e) -> Err e
              is Ok (_) -> when cg-city-restock town
                is Err (e) -> Err e
                is Ok (_) -> bb-restock-jeweler town.vendors town.items
 UOAIX-217: a city shop restocks at its counter by its role's goods as the mill does, one city shop each game minute in
 turn, while it is open; its keeper does not walk to a workshop.
  cg-city-restock : TownLive -> Result Integer Text
  cg-city-restock (town) = let v = town.vendors
    in let i = cg-city-turn v.vendor-count town.now
    in if i < 0 | gv-shut v i then Ok 0 else bb-restock-shop v town.items i
  cg-city-turn : Integer, Integer -> Integer
  cg-city-turn (vendors) (seconds) = let n = vendors - bb-shop-count
    in if n <= 0 | seconds < 0 then 0 - 1 else bb-shop-count + int-mod (seconds / 60) n
 Stage S (UOAIX.md, the sea): Britain's fisherman is the worker after the fibre workers in owner.miners (the save keeps
 four workers past the miners), home offset 31; a town window with no reachable shore founds none.
  cg-is-fisher : CompositeGame, Integer -> Boolean
  cg-is-fisher (owner) (serial) = serial /= 0 & cg-fisher-at owner.miners serial 0
  cg-fisher-at : List CgGatherer, Integer, Integer -> Boolean
  cg-fisher-at (workers) (serial) (i) = if i >= list-length workers then False
    else let c = list-at workers i in (c.gatherer.place == cgg-fish-place & (serial == 0 | c.serial == serial)) | cg-fisher-at workers serial (i + 1)
  cg-fisher-actor : List CgGatherer, Integer -> Integer
  cg-fisher-actor (workers) (i) = if i >= list-length workers then 0
    else let c = list-at workers i in if c.gatherer.place == cgg-fish-place then c.gatherer.producer.actor else cg-fisher-actor workers (i + 1)
  cg-found-fisher : CompositeGame -> Result Integer Text
  cg-found-fisher (owner) = if cg-fisher-at owner.miners 0 0 | list-length owner.miners < cgm-limit | list-length owner.miners > cgm-limit + list-length cgw-places then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-fisher town britain owner.town-doors 31
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "fisherman not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in Ok 1
 The sand gatherer is founded after the fisherman (owner 3306, home offset 38 of the inn's beds), digging on the shore.
  cg-found-sander : CompositeGame -> Result Integer Text
  cg-found-sander (owner) = if cg-sander-at owner.miners 0 | list-length owner.miners /= cgm-limit + list-length cgw-places + 1 | not (cg-fisher-at owner.miners 0 0) then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-sander town britain owner.town-doors 38
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "sand gatherer not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in Ok 1
  cg-sander-at : List CgGatherer, Integer -> Boolean
  cg-sander-at (workers) (i) = if i >= list-length workers then False
    else (list-at workers i).gatherer.place == cgg-sand-place | cg-sander-at workers (i + 1)
 Home offset 41 is the last of the inn's 42 bed tiles.
  cg-found-clayer : CompositeGame -> Result Integer Text
  cg-found-clayer (owner) = if cg-clayer-at owner.miners 0 | list-length owner.miners /= cgm-limit + list-length cgw-places + 2 | not (cg-sander-at owner.miners 0) then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-clayer town britain owner.town-doors 41
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "clay gatherer not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in Ok 1
  cg-clayer-at : List CgGatherer, Integer -> Boolean
  cg-clayer-at (workers) (i) = if i >= list-length workers then False
    else if (list-at workers i).gatherer.place == cgg-clay-place then True else cg-clayer-at workers (i + 1)
 The quarrier is founded after the clay gatherer (owner 3308, home offset 40 of the inn's 42 bed tiles).
  cg-found-quarrier : CompositeGame -> Result Integer Text
  cg-found-quarrier (owner) = if cg-place-at owner.miners cgg-stone-place 0 | list-length owner.miners /= cgm-limit + list-length cgw-places + 3 | not (cg-clayer-at owner.miners 0) then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-at town britain cgg-stone-owner 40 cgg-stone-place
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "quarrier not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in Ok 1
  cg-place-at : List CgGatherer, Integer, Integer -> Boolean
  cg-place-at (workers) (place) (i) = if i >= list-length workers then False
    else if (list-at workers i).gatherer.place == place then True
    else cg-place-at workers place (i + 1)
 The three farmers follow the quarrier: owners 3309 to 3311, home offsets 1, 5 and 8 of the inn's bed tiles, each
 founded once, by its place, with a node for every crop of its tool.
  cg-farm-homes : List Integer = [1, 5, 8]
  cg-found-farmers : CompositeGame, Integer -> Result Integer Text
  cg-found-farmers (owner) (k) = if k >= list-length cgg-crop-farms then Ok 0
    else if cg-place-at owner.miners (list-at cgg-crop-farms k) 0 | not (cg-place-at owner.miners cgg-stone-place 0) then cg-found-farmers owner (k + 1)
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> let place = list-at cgg-crop-farms k
          in when cgg-new-at town britain (list-at cgg-farm-owners k) (list-at cg-farm-homes k) place
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & cg-place-word place & " not founded: " & e & "; ") in cg-found-farmers owner (k + 1)
          is Ok (c) -> if cgg-farm-nodes c (cgg-farm-crops place) 0 < 0 then (let noted = __record-set owner "load-faults" (owner.load-faults & cg-place-word place & " crop nodes refused; ") in cg-found-farmers owner (k + 1))
            else let kept = __record-set owner "miners" (owner.miners & [c]) in cg-found-farmers owner (k + 1)
 The castle's kitchen staff and the fish market's cutter follow the farmers, each founded once, by its place (cgg-new-kitchen).
  cg-found-kitchen : CompositeGame, Integer -> Result Integer Text
  cg-found-kitchen (owner) (k) = if k >= 3 then Ok 0
    else if cg-place-at owner.miners (cgg-baker-place + k) 0 | not (cg-place-at owner.miners cgg-stone-place 0) then cg-found-kitchen owner (k + 1)
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-kitchen town britain (cgg-baker-place + k) (tf-add-person town.people (cg-kitchen-name (cgg-baker-place + k)) 1 1001 100 0 9000)
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & cg-place-word (cgg-baker-place + k) & " not founded: " & e & "; ") in cg-found-kitchen owner (k + 1)
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in cg-found-kitchen owner (k + 1)
 Home offset 35 keeps the farmer's bed apart from the gatherer's (0) and the miners' (7 .. 28).
  cg-found-farmer : CompositeGame -> Result Integer Text
  cg-found-farmer (owner) = when owner.farmer
    is Just (_) -> Ok 0
    is None -> when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-at town britain cgg-farm-owner 35 cgg-farm-place
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "farmer not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "farmer" (Just c) in Ok 1
 The fighter's and the hunter's errand timers are not persisted: the first tick after a boot schedules each one's next
 step, keyed by its profile.
  cg-errand-arm : CompositeGame, Integer -> Result Integer Text
  cg-errand-arm (owner) (tick) = when cg-errand-arm-one owner owner.fighter tick
    is Err (e) -> Err e
    is Ok (a) -> when cg-errand-arm-one owner owner.hunter tick
      is Err (e) -> Err e
      is Ok (b) -> Ok (a + b)
  cg-errand-arm-one : CompositeGame, Maybe CgFighter, Integer -> Result Integer Text
  cg-errand-arm-one (owner) (worker) (tick) = when worker
    is None -> Ok 0
    is Just (c) -> if c.timed then Ok 0
      else if wtm-add owner.timers (tick + 1) cgf-kind c.profile.key < 0 then Err "fighter timer pool full"
      else let armed = __record-set c "timed" True in Ok 1
 Four gatherer-miners work Britain's veins beside the gatherer, each stepping on its own wheel errand (root
 2026-10-06, UOAIX-30). Owners 3101 to 3104, home offsets 7, 14, 21, 28 and places 201 to 204 (each its own nodes) keep them apart.
  cgm-limit : Integer = 4
  cgm-kind : Integer = 8
  cgm-owner : Integer = 3101
  cg-found-miners : CompositeGame, Integer -> Result Integer Text
  cg-found-miners (owner) (i) = if i >= cgm-limit | list-length owner.miners >= cgm-limit then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> when cgg-new-at town britain (cgm-owner + i) (7 * (i + 1)) (cgg-place + 1 + i)
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "miner " & show (i + 1) & " not founded: " & e & "; ") in Ok 0
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c]) in cg-found-miners owner (i + 1)
 The fibre workers follow the four miners in owner.miners (indexes 4 to 6) and step on the miners' wheel errand: a flax
 picker, a cotton picker, a shepherd and a lumberjack (CompositeGatherer places 301 to 303 and the town's), owners 3301
 to 3303 and 3305 (3304 is the fisherman's), home offsets 3, 10, 17 and 24 of the inn's 42 bed tiles (cgg-home takes the next free one); a worker the town cannot house is not founded, and the server starts without it.
  cgw-places : List Integer = [cgg-flax-place, cgg-cotton-place, cgg-wool-place, cgg-lumber-place]
  cgw-homes : List Integer = [3, 10, 17, 24]
  cgw-owners : List Integer = [3301, 3302, 3303, 3305]
 Every worker founded past the miners, in founding order (the fibre workers and the lumberjack, then the fisherman);
 GVS1 sizes its worker section from this list.
  cg-founders : List Integer = cgw-places & [cgg-fish-place, cgg-sand-place, cgg-clay-place, cgg-stone-place] & cgg-crop-farms
    & [cgg-baker-place, cgg-cook-place, cgg-cutter-place]
  cgw-sheep : Integer = 4
  cg-found-workers : CompositeGame, Integer -> Result Integer Text
  cg-found-workers (owner) (i) = if i >= list-length cgw-places | list-length owner.miners /= cgm-limit + i then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> when owner.town-map
        is None -> Ok 0
        is Just (britain) -> let place = list-at cgw-places i
          in when cgg-new-at town britain (list-at cgw-owners i) (list-at cgw-homes i) place
          is Err (e) -> let noted = __record-set owner "load-faults" (owner.load-faults & "worker " & show place & " not founded: " & e & "; ") in Ok i
          is Ok (c) -> let kept = __record-set owner "miners" (owner.miners & [c])
            in cg-found-workers owner (i + 1)
 96 of GameHarvest's 256 sites leave the rest for players and the farm.
  cgl-trees : Integer = 96
  cg-lumber-searches : Integer -> Boolean
  cg-lumber-searches (sites) = sites < cgl-trees
  cg-lumber-pick : CompositeGame, CgGatherer, TownLive, WalkMap -> Integer
  cg-lumber-pick (owner) (c) (town) (britain) = if c.gatherer.place /= cgg-lumber-place | c.leg /= 0 | c.serial == 0 | c.city.place-base /= cgg-britain.place-base then 0
    else when cg-lumber-map owner
      is None -> 0
      is Just (route) -> when cg-lumber-nav owner
        is None -> 0
        is Just (nav) -> when bb-placement town.vendors.game.world britain cgf-trail (int-mod c.serial 16)
          is Err (_) -> 0
          is Ok (trail) -> let kept = tl-copy-spot c.shop trail in cg-lumber-take owner c route nav trail
  cg-lumber-take : CompositeGame, CgGatherer, WalkMap, TlPath, BbSpot -> Integer
  cg-lumber-take (owner) (c) (route) (nav) (trail) = let h = owner.production.harvest
    in let own = gh-site-of h c.gatherer.node 0
    in if own >= 0 & cgg-ready c & cg-lumber-site h owner.lumber-shun own then 0
    else let ready = cg-lumber-ready h owner.lumber-shun 0
    in let k = if ready >= 0 then ready else if not (cg-lumber-searches (cg-lumber-count h owner.lumber-shun 0)) then -1
      else when owner.flora is None -> -1 is Just (s) -> cg-lumber-plant h s route trail
    in if k < 0 then 0
    else let site = list-at h.sites k
    in when bb-placement h.vendor.game.world route (BbShop { title = "Tree", premises = "Forest", x1 = site.x - 1, y1 = site.y - 1, x2 = site.x + 1, y2 = site.y + 1 }) 0
      is Err (_) -> 0
      is Ok (spot) -> if rte-plan nav h.vendor.game.world route None (WorldObject { serial = 0, kind = 1, x = trail.x, y = trail.y, z = trail.z, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }) spot.x spot.y spot.z < 0 then cg-lumber-shun owner.lumber-shun site.x site.y 0
        else let a = __record-set c.gatherer "node" site.node
        in let b = __record-set c.node "x" spot.x
        in let d = __record-set c.node "y" spot.y
        in let e = __record-set c.node "z" spot.z in 1
 A tree the town entrance cannot route to is shunned until the server restarts: 64 cells of x * 4096 + y (a map x is
 below 6144, a y below 4096); a full buffer overwrites slot (x + y) mod 64.
  cgl-shun-cells : Integer = 64
  cg-lumber-shunned : Integer, Integer, Integer, Integer -> Boolean
  cg-lumber-shunned (shun) (x) (y) (i) = if i >= cgl-shun-cells then False
    else if peek-qword shun (i * 8) == x * 4096 + y then True
    else cg-lumber-shunned shun x y (i + 1)
  cg-lumber-shun : Integer, Integer, Integer, Integer -> Integer
  cg-lumber-shun (shun) (x) (y) (i) = if i >= cgl-shun-cells then (let kept = poke-qword shun (int-mod (x + y) cgl-shun-cells * 8) (x * 4096 + y) in 0)
    else if peek-qword shun (i * 8) == 0 then (let kept = poke-qword shun (i * 8) (x * 4096 + y) in 0)
    else cg-lumber-shun shun x y (i + 1)
  cg-lumber-site : GameHarvest, Integer, Integer -> Boolean
  cg-lumber-site (h) (shun) (k) = let site = list-at h.sites k
    in let w = h.vendor.currency.world
    in site.resource == 15 & eh-valid-node w site.node & (list-at w.nodes (site.node - 1)).place == cgg-lumber-place
      & cg-forest-at site.x site.y
      & not (cg-lumber-shunned shun site.x site.y 0)
  cg-lumber-ready : GameHarvest, Integer, Integer -> Integer
  cg-lumber-ready (h) (shun) (k) = if k >= h.count then -1
    else if cg-lumber-site h shun k & (list-at h.vendor.currency.world.nodes ((list-at h.sites k).node - 1)).stage == 2 then k
    else cg-lumber-ready h shun (k + 1)
  cg-lumber-count : GameHarvest, Integer, Integer -> Integer
  cg-lumber-count (h) (shun) (k) = if k >= h.count then 0 else (if cg-lumber-site h shun k then 1 else 0) + cg-lumber-count h shun (k + 1)
 Leave 16 of GameHarvest's 256 sites for players and the farm.
  cg-lumber-plant : GameHarvest, WfState, WalkMap, BbSpot -> Integer
  cg-lumber-plant (h) (s) (britain) (home) = if h.count >= 240 then -1
    else let r = cgl-forest
    in let found = cg-lumber-row h s britain home (r.x1 / 8) (r.y1 / 8) -1
    in let row = if found < 0 then -1 else found / 1024
    in if row < 0 then -1
    else let w = h.vendor.currency.world
    in let node = eh-source w 15 cgg-lumber-place
    in if node < 1 then -1
    else let k = h.count
    in let site = list-at h.sites k
    in let a = __record-set site "x" (wf-x s row)
    in let b = __record-set site "y" (wf-y s row)
    in let d = __record-set site "z" (wf-z s row)
    in let e = __record-set site "resource" 15
    in let f = __record-set site "node" node
    in let g = __record-set site "base" 0
    in let j = __record-set site "species" 0
    in let l = __record-set site "felled" 0
    in let counted = __record-set h "count" (k + 1) in k
 The best row and its distance from the trailhead travel packed as row * 1024 + distance (a distance in the window is below 300).
  cg-lumber-row : GameHarvest, WfState, WalkMap, BbSpot, Integer, Integer, Integer -> Integer
  cg-lumber-row (h) (s) (britain) (home) (bx) (by) (best) = if bx > cgl-forest.x2 / 8 then best
    else if by > cgl-forest.y2 / 8 then cg-lumber-row h s britain home (bx + 1) (cgl-forest.y1 / 8) best
    else let block = bx * 512 + by
    in cg-lumber-row h s britain home bx (by + 1) (cg-lumber-best h s britain home (wf-first s block) (wf-first s (block + 1)) best)
  cg-lumber-best : GameHarvest, WfState, WalkMap, BbSpot, Integer, Integer, Integer -> Integer
  cg-lumber-best (h) (s) (britain) (home) (i) (last) (best) = if i >= last then best
    else let x = wf-x s i
    in let y = wf-y s i
    in let d = walk-abs (x - home.x) + walk-abs (y - home.y)
    in if peek-byte s.rows (i * 12 + 9) /= 0 | not (cg-forest-at x y) | d >= 1024 | (best >= 0 & d >= int-mod best 1024) | walk-cell britain x y < 0
      | not (cg-open britain x y 0) | gh-site-column h 15 x y 0 >= 0 then cg-lumber-best h s britain home (i + 1) last best
    else cg-lumber-best h s britain home (i + 1) last (i * 1024 + d)
  cgl-forest : BbShop = cgf-window
  cg-forest-at : Integer, Integer -> Boolean
  cg-forest-at (x) (y) = x > cgl-forest.x1 & x < cgl-forest.x2 & y > cgl-forest.y1 & y < cgl-forest.y2
    & not (x >= bwn-x1 & x <= bwn-x2 & y >= bwn-y1 & y <= bwn-y2)
  cg-lumber-map : CompositeGame -> Maybe WalkMap
  cg-lumber-map (owner) = when (when owner.fighter is None -> None is Just (f) -> f.route)
    is Just (m) -> Just m
    is None -> (when owner.hunter is None -> None is Just (h) -> h.route)
  cg-lumber-nav : CompositeGame -> Maybe TlPath
  cg-lumber-nav (owner) = when (when owner.fighter is None -> None is Just (f) -> f.route)
    is Just (_) -> (when owner.fighter is None -> None is Just (f) -> f.nav)
    is None -> (when owner.hunter is None -> None is Just (h) -> h.nav)
  cg-lumber-walk : CompositeGame, CgGatherer, TownLive -> Result (List (List Integer)) Text
  cg-lumber-walk (owner) (c) (town) = when world-get town.vendors.game.world c.serial
    is Err (_) -> let fell = cgg-fall c town.vendors in Ok []
    is Ok (mobile) -> if mobile.health <= 0 then let fell = cgg-fall c town.vendors in Ok []
      else when cg-lumber-map owner
        is None -> cgg-depart c town 3
        is Just (route) -> when cg-lumber-nav owner
          is None -> cgg-depart c town 3
          is Just (nav) -> let target = if c.leg == 12 then c.node else c.shop
            in if tl-at mobile target then (if c.leg == 12 then cgg-arrive c town else cgg-depart c town 3)
            else when rte-toward nav town.vendors.game route None c.walk mobile target.x target.y target.z
              is Err (e) -> Err e
              is Ok (packets) -> if c.walk.route < 0 & c.leg == 12 & c.walk.fails >= cgg-give-up-fails & c.walk.rest == bit-shl 1 cgg-give-up-fails then cgg-afield-back c town else Ok packets
 A trunk has a neighbour cell (of four) on the map that holds no collider.
  cg-open : WalkMap, Integer, Integer, Integer -> Boolean
  cg-open (britain) (x) (y) (d) = if d >= 4 then False
    else let cell = walk-cell britain (x + (if d == 0 then 1 else if d == 1 then -1 else 0)) (y + (if d == 2 then 1 else if d == 3 then -1 else 0))
    in if cell >= 0 & peek-qword britain.solids (cell * britain.stride) == 0 then True else cg-open britain x y (d + 1)
 Each worker's first step comes one step (cgf-step-ticks) after the one before, so the workers founded together leave the
 inn's one door in turn rather than all at once (thirty jammed it, BVT 'a worker leaves the inn through its door').
  cg-arm-miners : CompositeGame, Integer -> Result Integer Text
  cg-arm-miners (owner) (i) = if i >= list-length owner.miners then Ok 0
    else if wtm-set owner.timers (owner.timers.limit + 1 + i * cgf-step-ticks) cgm-kind i < 0 then Err "miner timer pool full"
    else cg-arm-miners owner (i + 1)
  cg-miner : CompositeGame, Integer, Integer -> Result Integer Text
  cg-miner (owner) (key) (tick) = if key < 0 | key >= list-length owner.miners then Ok 0
    else when owner.town
      is None -> Err "miner requires townsfolk"
      is Just (town) -> when owner.town-map
        is None -> Err "miner requires the Britain map"
        is Just (britain) -> let picked = cg-lumber-pick owner (list-at owner.miners key) town britain
          in when cg-worker-step owner (list-at owner.miners key) town britain
          is Err (e) -> Err e
          is Ok (delay) -> if wtm-add owner.timers (tick + delay) cgm-kind key < 0 then Err "miner timer pool full" else Ok 1
 A worker step that changed nothing, or blocked after three plans in a row failed (an unreachable goal), waits twice as
 long for its next step as the last one did, from one step (cgf-step-ticks, 400 ms) up to 32 (12.8 s); any progress
 returns it to one step. A walker jostled at a crowded door has failed fewer plans and keeps the step.
  cgw-backoff-most : Integer = 5
  cgw-plan-fails : Integer = 3
  cg-worker-step : CompositeGame, CgGatherer, TownLive, WalkMap -> Result Integer Text
  cg-worker-step (owner) (c) (town) (britain) = let blocked = c.blocked
    in let serial = c.serial
    in let leg = c.leg
    in let via = c.via
    in let visit = c.visit
    in let trips = c.trips
    in let made = c.made
    in let sold = c.sold
    in let moves = c.walk.moves
    in let stalls = c.walk.blocked
    in let logs = c.gatherer.gathered
    in let role = if serial == 0 then 0 else cg-death-role owner serial
    in if (if serial /= 0 then False else cg-home-threatened owner c.home) then Ok (cg-worker-pace c True)
    else when (if c.leg == 12 | c.leg == 13 then cg-lumber-walk owner c town else cgg-step c town britain owner.town-doors)
      is Err (e) -> Err e
      is Ok (packets) -> let fell = if serial /= 0 & c.serial == 0 then cg-death-note owner -1 serial role else 0
        in let felled = if c.trade.raw == 15 & c.gatherer.gathered > logs then cg-worker-tree owner c.serial else 0
        in let synced = cg-door-sync owner packets 0
        in let still = c.serial == serial & c.leg == leg & c.via == via & c.visit == visit & c.trips == trips & c.made == made & c.sold == sold & c.walk.moves == moves & c.walk.blocked == stalls
        in Ok (cg-worker-pace c (still | (c.blocked > blocked & c.walk.fails >= cgw-plan-fails)))
 A dead worker rises at home only while no hostile creature stands within cg-guard-reach of it (root, 2026-10-09).
  cg-home-threatened : CompositeGame, BbSpot -> Boolean
  cg-home-threatened (owner) (home) = when owner.spawns
    is None -> False
    is Just (s) -> cg-raider s owner.checkpoint.game (WorldObject { serial = 0, kind = 1, x = home.x, y = home.y, z = home.z,
      graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }) 0 0 9999 /= 0
  cg-worker-pace : CgGatherer, Boolean -> Integer
  cg-worker-pace (c) (idle) = let n = if idle then min cgw-backoff-most (c.idle + 1) else 0
    in let kept = __record-set c "idle" n in cgf-step-ticks * bit-shl 1 n
 The economy gatherer (key 0) and the farmer (key 1) step on their own wheel errand, paced as the miners are.
  cgw-kind : Integer = 12
  cg-arm-workers : CompositeGame -> Result Integer Text
  cg-arm-workers (owner) = let g = when owner.gatherer is None -> 0 is Just (_) -> wtm-set owner.timers (owner.timers.limit + 1) cgw-kind 0
    in let f = when owner.farmer is None -> 0 is Just (_) -> wtm-set owner.timers (owner.timers.limit + 1) cgw-kind 1
    in if g < 0 | f < 0 then Err "worker timer pool full" else Ok 0
  cg-mind-of : CgGatherer -> TnvWorker
  cg-mind-of (c) = TnvWorker { actor = c.gatherer.producer.actor, item = c.trade.raw, serial = c.serial, state = tn-new 0, think-at = 0, thoughts = 0 }
  cg-minds : List CgGatherer, Integer, List TnvWorker -> List TnvWorker
  cg-minds (workers) (i) (xs) = if i >= list-length workers then xs else cg-minds workers (i + 1) (xs & [cg-mind-of (list-at workers i)])
  cg-bind-minds : CompositeGame -> Result Integer Text
  cg-bind-minds (owner) = when owner.network
    is None -> Ok 0
    is Just (n) -> let farmer = when owner.farmer is None -> [] is Just (f) -> [cg-mind-of f]
      in let bound = __record-set n "workers" (cg-minds owner.miners 0 [] & farmer)
      in let folk = tnv-bind-people n
      in let sight = __record-set n "raid-sight" (cg-raid-sees owner) in Ok (list-length n.workers)
  cg-sight : Integer = 18
  cg-raid-sees : CompositeGame, Integer -> Boolean
  cg-raid-sees (owner) (serial) = if serial == 0 then False
    else when owner.spawns
      is None -> False
      is Just (g) -> when world-get owner.checkpoint.game.world serial
        is Err (_) -> False
        is Ok (m) -> cg-raider-within g owner.checkpoint.game.world m.x m.y 0
  cg-raider-within : GameWorldSpawn, WorldTable, Integer, Integer, Integer -> Boolean
  cg-raider-within (g) (world) (x) (y) (i) = if i >= list-length g.slots then False
    else let slot = list-at g.slots i
    in let seen = if slot.serial == 0 | slot.owner /= 0 | not (gws-orc (list-at g.catalog.profiles slot.profile)) then False
      else when world-get world slot.serial
        is Err (_) -> False
        is Ok (r) -> r.health > 0 & walk-abs (r.x - x) <= cg-sight & walk-abs (r.y - y) <= cg-sight
    in if seen then True else cg-raider-within g world x y (i + 1)
  cg-worker : CompositeGame, Integer, Integer -> Result Integer Text
  cg-worker (owner) (key) (tick) = when (if key == 0 then owner.gatherer else owner.farmer)
    is None -> Ok 0
    is Just (c) -> when owner.town
      is None -> Err "worker requires townsfolk"
      is Just (town) -> when owner.town-map
        is None -> Err "worker requires the Britain map"
        is Just (britain) -> when cg-worker-step owner c town britain
          is Err (e) -> Err e
          is Ok (delay) -> if wtm-add owner.timers (tick + delay) cgw-kind key < 0 then Err "worker timer pool full" else Ok 1
 UOAIX-217 W2: the workers of the cities past Britain, founded at boot after the city shops (cgs-cities) and stepped on
 their own wheel errand (key: the index in owner.city-workers) on their city's map and planner, with no doors.
  cg-city-kind : Integer = 20
  cg-city-workers : CompositeGame -> Text
  cg-city-workers (owner) = when owner.town
    is None -> "CITY WORKERS off: no townsfolk"
    is Just (britain) -> let built = cw-build owner.cities owner.city-maps owner.city-navs britain (ct-city-shops 0) ct-shop-roles 0 (CwCities { cities = [], towns = [] })
      in let a = __record-set owner "worker-cities" built.cities
      in let b = __record-set owner "city-towns" built.towns
      in let restored = cw-restore built.cities owner.vendor owner.items owner.city-held 0 (CwFound { workers = [], founded = 0, refused = "" })
      in let found = cw-found built.cities built.towns owner.city-maps 0 0 restored
      in let kept = __record-set owner "city-workers" found.workers
      in let held = if list-length built.cities == 0 then 0 else let d = __record-set owner "city-held" 0 in 0
      in let beds = cw-own-beds found.workers built.cities built.towns owner.city-maps 0
      in let spots = cw-grounds found.workers 0
      in let regardened = cw-regarden found.workers built.cities built.towns owner.city-maps 0
      in let armed = cg-arm-city-workers owner 0
      in "CITY WORKERS cities=" & show (list-length built.cities) & " restored=" & show (list-length restored.workers) & " founded=" & show found.founded
        & " housed=" & show beds & " spots=" & show spots & " regardened=" & show regardened & (if armed < 0 then " timer pool full" else "") & (if text-length found.refused == 0 then "" else " refused:" & found.refused)
  cg-arm-city-workers : CompositeGame, Integer -> Integer
  cg-arm-city-workers (owner) (i) = if i >= list-length owner.city-workers then 0
    else if wtm-set owner.timers (owner.timers.limit + 1 + i * cgf-step-ticks) cg-city-kind i < 0 then -1
    else cg-arm-city-workers owner (i + 1)
  cg-city-worker : CompositeGame, Integer, Integer -> Result Integer Text
  cg-city-worker (owner) (key) (tick) = if key < 0 | key >= list-length owner.city-workers then Ok 0
    else let c = list-at owner.city-workers key
    in when cw-town-of owner.worker-cities owner.city-towns c.city.city 0
      is None -> Ok 0
      is Just (town) -> when ct-map-of owner.city-maps c.city.city
        is None -> Ok 0
        is Just (map) -> let synced = when owner.town is None -> 0 is Just (b) -> (let now = __record-set town "now" b.now in 0)
          in let blocked = c.blocked
          in let serial = c.serial
          in let leg = c.leg
          in let via = c.via
          in let visit = c.visit
          in let trips = c.trips
          in let made = c.made
          in let sold = c.sold
          in let moves = c.walk.moves
          in let stalls = c.walk.blocked
          in when cgg-step c town map None
            is Err (e) -> Err e
            is Ok (_) -> let still = c.serial == serial & c.leg == leg & c.via == via & c.visit == visit & c.trips == trips & c.made == made & c.sold == sold & c.walk.moves == moves & c.walk.blocked == stalls
              in let delay = cg-worker-pace c (still | (c.blocked > blocked & c.walk.fails >= cgw-plan-fails))
              in if wtm-add owner.timers (tick + delay) cg-city-kind key < 0 then Err "city worker timer pool full" else Ok 1
 A worker still at its node after a step has worked it: the player in range (18 tiles) sees the pickaxe swing and hears
 it, or sees a picker or the shepherd bend (action 32, the bow GameCarve plays).
  cg-miner-show : CompositeGame, GameShard, Integer -> List (List Integer)
  cg-miner-show (owner) (game) (key) = if key < 0 | key >= list-length owner.miners then []
    else let c = list-at owner.miners key
    in if c.serial == 0 | (c.leg /= 2 & c.say == 0) then []
    else when world-get game.world c.serial
      is Err (_) -> []
      is Ok (m) -> when world-get game.world game.active
        is Err (_) -> []
        is Ok (viewer) -> if walk-abs (viewer.x - m.x) > 18 | walk-abs (viewer.y - m.y) > 18 then []
          else let said = if c.say == 0 then [] else [gvp-speech m "" (cgg-say-text c)]
          in if c.leg /= 2 then said
          else let sound = gh-sound c.trade.raw c.visit
          in let action = if c.trade.tool == 0 | c.trade.tool == 27 then 32 else gh-action c.trade.raw
          in (if sound == 0 then [cbp-animation c.serial action] else [cbp-animation c.serial action, cbp-sound sound m]) & said
 The farmer and the economy gatherer step on their wheel errand, whose packets reach no player, so a player's next pulse
 within 18 tiles speaks a remark either made, once.
  cg-worker-say : Maybe CgGatherer, GameShard -> List (List Integer)
  cg-worker-say (worker) (game) = when worker
    is None -> []
    is Just (c) -> if c.say == 0 | c.serial == 0 then [] else when world-get game.world c.serial
      is Err (_) -> []
      is Ok (m) -> when world-get game.world game.active
        is Err (_) -> []
        is Ok (viewer) -> if walk-abs (viewer.x - m.x) > 18 | walk-abs (viewer.y - m.y) > 18 then []
          else let text = cgg-say-text c
          in let heard = __record-set c "say" 0 in [gvp-speech m "" text]
 The death hook runs before cb-die makes the corpse, so the fighter's step after a kill (hunting, the kill taken) loots
 every corpse within 2 tiles into what it carries, the lots following (cg-rummage, UOAIX-140 e).
  cg-fighter-loot : CompositeGame, CgFighter, GameShard -> Integer
  cg-fighter-loot (owner) (c) (game) = if c.serial == 0 | c.leg /= 4 | c.took /= 1 then 0
    else when world-get game.world c.serial
      is Err (_) -> 0
      is Ok (m) -> if m.health <= 0 then 0
        else let registered = cgf-register owner.vendor c.serial c.fighter.producer.actor 0 in cg-rummage owner c.fighter.producer.actor m 0
 The hunter, after a kill, skins every corpse within 2 tiles that no one has carved, as a player's carve does
 (GameCarve: the corpse's body picks the hides, CreatureCarveData), the hides landing on it as a lot.
  cg-hunter-carve : CompositeGame, CgFighter, GameShard -> Integer
  cg-hunter-carve (owner) (c) (game) = if c.serial == 0 | c.leg /= 4 | c.took /= 1 | not c.profile.tame then 0
    else when world-get game.world c.serial
      is Err (_) -> 0
      is Ok (m) -> if m.health <= 0 then 0
        else let registered = cgf-register owner.vendor c.serial c.fighter.producer.actor 0 in cg-carve-around owner c m 0
  cg-carve-around : CompositeGame, CgFighter, WorldObject, Integer -> Integer
  cg-carve-around (owner) (c) (m) (k) = if k >= 25 then 0
    else cg-carve-on owner c (world-tile-first owner.items.world (m.x + int-mod k 5 - 2) (m.y + k / 5 - 2)) + cg-carve-around owner c m (k + 1)
  cg-carve-on : CompositeGame, CgFighter, Integer -> Integer
  cg-carve-on (owner) (c) (serial) = if serial == 0 then 0
    else let next = world-tile-next owner.items.world serial
    in let carved = when world-get owner.items.world serial
      is Err (_) -> 0
      is Ok (o) -> if o.kind == 2 & o.container == 0 & o.graphic == #2006 & bit-and o.health 1 == 0 then cg-skin owner c o else 0
    in carved + cg-carve-on owner c next
  cg-skin : CompositeGame, CgFighter, WorldObject -> Integer
  cg-skin (owner) (c) (corpse) = let v = owner.vendor
    in let w = v.currency.world
    in let actor = c.fighter.producer.actor
    in let p = ep-actor w actor
    in let hides = owner.production.carve.parts corpse.amount 1
    in if hides <= 0 | not (gca-room w p 7 hides) | not (ep-lot-room w.goods 1) | world-room owner.items.world < 1 then 0
    else when world-update owner.items.world (__record-set corpse "health" (bit-or corpse.health 1))
      is Err (_) -> 0
      is Ok (_) -> let yielded = eh-add-yield w p 7 hides 100
        in when world-create owner.items.world (WorldObject { serial = 0, kind = 2, x = 20, y = 20, z = 0, graphic = #1078, hue = 0, container = c.serial, amount = hides, health = 0 })
          is Err (_) -> 0
          is Ok (serial) -> if gsi-register owner.items serial 0 0 True True /= 0 then 0
            else if gv-add-lot v serial actor 7 (gh-grade 100) 32 hides < 0 then 0 else hides
  cg-errand : CompositeGame, GameShard, Integer -> Result Integer Text
  cg-errand (owner) (game) (tick) = cg-errand-of owner game tick 0
  cg-errand-of : CompositeGame, GameShard, Integer, Integer -> Result Integer Text
  cg-errand-of (owner) (game) (tick) (key) = when (if key == cgh-profile.key then owner.hunter else owner.fighter)
    is None -> Ok 0
    is Just (c) -> when owner.town
      is None -> Err "fighter requires townsfolk"
      is Just (town) -> when owner.town-map
        is None -> Err "fighter requires the Britain map"
        is Just (britain) -> let carved = cg-hunter-carve owner c game
          in let looted = cg-fighter-loot owner c game
          in when cgf-step c town britain owner.town-doors owner.combat owner.spawns game
          is Err (e) -> Err e
          is Ok (packets) -> let synced = cg-door-sync owner packets 0
            in if wtm-add owner.timers (tick + cgf-delay c) cgf-kind c.profile.key < 0 then Err "fighter timer pool full" else Ok 1
  cg-british-in : Integer, Integer -> Integer
  cg-british-in (characters) (slot) = if slot == 5 then 0
    else let row = characters + slot * 160
    in if peek-qword row 0 /= 0 & cg-british-named row 0 then peek-qword row 0 else cg-british-in characters (slot + 1)
  cg-british-serial : CompositeGame -> Integer
  cg-british-serial (owner) = let accounts = owner.checkpoint.game.accounts
    in let index = ga-british accounts
    in if index < 0 then 0
    else cg-british-in (if ga-bound accounts == index then owner.checkpoint.game.characters else ga-slots accounts index) 0
  cg-british-found : CompositeGame -> Result Integer Text
  cg-british-found (owner) = let serial = cg-british-serial owner
    in if serial == 0 then Ok 0
    else when owner.british
      is Just (c) -> if c.serial == serial then Ok 0
        else let rebound = __record-set c "serial" serial
        in let restarted = if cbe-finished c then 0 else let home = __record-set c "leg" 0 in cbe-reset c in Ok 1
      is None -> when world-get owner.checkpoint.game.world serial
        is Err (e) -> Err e
        is Ok (m) -> let bound = __record-set owner "british" (Just (cbe-new serial (BbSpot { x = m.x, y = m.y, z = m.z }))) in Ok 1
  cg-british-arm : CompositeGame, Integer -> Result Integer Text
  cg-british-arm (owner) (tick) = if owner.testing then Ok 0 else when owner.british
    is None -> Ok 0
    is Just (c) -> if c.timed | cbe-finished c | c.serial == 0 then Ok 0
      else if wtm-add owner.timers (tick + 1) cbe-kind 0 < 0 then Err "British errand timer pool full"
      else let armed = __record-set c "timed" True in Ok 1
  cg-british : CompositeGame, GameShard, Integer -> Result Integer Text
  cg-british (owner) (game) (tick) = if owner.testing then Ok 0 else when owner.british
    is None -> Ok 0
    is Just (c) -> when cbe-step c owner.production game.world tick
      is Err (e) -> Err e
      is Ok (_) -> if cbe-finished c | c.serial == 0 then let stopped = __record-set c "timed" False in Ok 0
        else if wtm-add owner.timers (tick + cbe-delay c) cbe-kind 0 < 0 then Err "British errand timer pool full" else Ok 1
 The shift timers are not persisted: the first tick or pulse after a boot schedules each resident's next hour.
  cg-labor : CompositeGame, Integer -> Result Integer Text
  cg-labor (owner) (tick) = if owner.labor then Ok 0
    else when owner.town
      is None -> Ok 0
      is Just (town) -> if clb-attach town owner.timers tick (owner.day-hook 0) 0 < 0 then Err "shift timer pool full"
        else let attached = __record-set owner "labor" True in Ok 1
  cg-drain : CompositeGame, GameShard, Integer -> Result Integer Text
  cg-drain (owner) (game) (tick) = let played = cg-play-rearm owner 0 in when owner.decoration
    is None -> Ok 0
    is Just (state) -> if not (wd-bound state) then Ok 0
      else when cg-timers owner state game tick []
        is Err (e) -> Err e
        is Ok (_) -> Ok 1
  cg-spawn-terrain : WalkMap, WsRegion, WsProfile, Integer, Integer -> Result Integer Text
  cg-spawn-terrain (map) (r) (p) (x) (y) = when walk-ground map x y
    is Err (e) -> Err e
    is Ok (land) ->
      let from = if r.fixed-height >= -128 then r.fixed-height - 2 else land + r.preferred-height - 2
      in when walk-height map x y from
        is Err (e) -> Err e
        is Ok (z) -> if r.fixed-height >= -128 & z /= r.fixed-height then Err "fixed spawn height"
          else if r.outside & cg-covered map (walk-cell map x y) z 0 then Err "covered spawn tile"
          else Ok z
  cg-covered : WalkMap, Integer, Integer, Integer -> Boolean
  cg-covered (map) (cell) (z) (i) = if cell < 0 then True
    else if i >= peek-qword map.solids (cell * map.stride) then False
    else peek-qword map.solids (cell * map.stride + 8 + i * 24) >= z + 16 | cg-covered map cell z (i + 1)
 UOAIX-183 (Damian, 2026-10-09: "the first 4 are horses, then some wild thing from the lost lands, then llama, then the last
 one is the floating rider"; "3ea7 is also a phantom mount"): ServUO's Horse and RidableLlama pair each body with the art the
 1.25 client draws under its rider on layer 25. The ostards and 0x3EA7 are not ridden.
  cg-mount-art : Integer -> Integer
  cg-mount-art (body) = if body == #00C8 then #3E9F else if body == #00E2 then #3EA0 else if body == #00E4 then #3EA1
    else if body == #00CC then #3EA2 else if body == #00DC then #3EA6 else 0
  cg-mount-body : Integer -> Integer
  cg-mount-body (art) = if art == #3E9F then #00C8 else if art == #3EA0 then #00E2 else if art == #3EA1 then #00E4
    else if art == #3EA2 then #00CC else if art == #3EA6 then #00DC else 0
  cg-mount-key : Integer -> Text
  cg-mount-key (body) = if body == #00C8 then "brownhorse" else if body == #00E2 then "grayhorse" else if body == #00E4 then "horse"
    else if body == #00CC then "darkhorse" else if body == #00DC then "llama" else ""
  cg-mount-layer : Integer = 25
  cg-mount-line : Integer, Text, Text -> Maybe GameReply
  cg-mount-line (serial) (text) (note) = Just (gs-reply [sip-message serial #FFFF 6 text] note)
 A double-click by its owner within a tile rides a claimed horse or llama: the creature leaves the world and the rider wears
 its art on layer 25, the item keeping its health and hue; a double-click on oneself while riding sets it down at one's
 feet, claimed again (ServUO BaseMount.OnDoubleClick, Mobile.OnDoubleClick).
 Damian, 2026-10-09: "i want lord british to have that 3ea8 horse though. call it slephnir, so if Lord British says the name
 Slephnir at all, it toggles this phantom horse on. unless already mounted on a regular horse/llama, then ignore the call.
 its really nice to see stuff and not a big horse." Slephnir is the mount item alone, with no creature behind it.
  cg-slephnir-art : Integer = #3EA8
  cg-slephnir : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-slephnir (owner) (game) (input) (packet) = if list-length packet < 10 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 then None
    else if not (ga-is-british game.accounts) | not (cg-slephnir-said (gp-speech-text packet)) then None
    else cg-slephnir-toggle owner game input.session.serial
  cg-slephnir-said : Text -> Boolean
  cg-slephnir-said (said) = text-contains (text-to-lower said) "slephnir"
  cg-slephnir-toggle : CompositeGame, GameShard, Integer -> Maybe GameReply
  cg-slephnir-toggle (owner) (game) (rider) = let worn = gmb-layer owner.items rider cg-mount-layer 0
    in if worn == 0 then (when gmb-clothe owner.items rider cg-slephnir-art 0 cg-mount-layer
        is Err (e) -> cg-mount-line rider ("Slephnir does not come: " & e) "mount:refused"
        is Ok (item) -> when world-get game.world item is Err (_) -> None is Ok (now) -> Just (gs-reply [gp-equip now cg-mount-layer] "mount:slephnir"))
    else when world-get game.world worn
      is Err (_) -> None
      is Ok (w) -> if w.graphic /= cg-slephnir-art then None
        else when world-delete game.world worn is Err (_) -> None is Ok (_) -> Just (gs-reply [sip-remove worn] "mount:slephnir-off")
  cg-mount : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-mount (owner) (game) (input) (packet) = when cg-slephnir owner game input packet
    is Just (r) -> Just r
    is None -> if list-length packet < 5 | list-at packet 0 /= 6 | input.mode /= 2 | input.session.phase /= 2 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let rider = input.session.serial
    in when owner.spawns
      is None -> None
      is Just (g) -> if serial == rider then cg-dismount owner game g rider else cg-ride owner game g rider serial
 A nightmare wears the brown horse's body (0x00C8) but its own mount art, 0x3EA7, draws a phantom in the 1.25 client
 (UOAIX-183), so it is a pet, never ridden.
  cg-unridden : WsCatalog, Integer -> Boolean
  cg-unridden (c) (profile) = profile >= 0 & profile < list-length c.profiles & (list-at c.profiles profile).key == "nightmare"
  cg-ride : CompositeGame, GameShard, GameWorldSpawn, Integer, Integer -> Maybe GameReply
  cg-ride (owner) (game) (g) (rider) (serial) = let i = if serial <= 0 then -1 else gws-slot-of g serial 0
    in if i < 0 then None
    else if (list-at g.slots i).owner /= rider then None
    else when world-get game.world serial
      is Err (_) -> None
      is Ok (m) -> let art = cg-mount-art m.graphic
        in if art == 0 | m.health <= 0 then None
        else if cg-unridden g.catalog (list-at g.slots i).profile then Just (gsi-denied "That creature will not be ridden.")
        else when world-get game.world rider
          is Err (_) -> None
          is Ok (me) -> if gmb-layer owner.items rider cg-mount-layer 0 /= 0 then cg-mount-line rider "Please dismount first." "mount:refused"
            else if walk-abs (me.x - m.x) > 1 | walk-abs (me.y - m.y) > 1 then cg-mount-line rider "That is too far away." "mount:refused"
            else when gmb-clothe owner.items rider art m.hue cg-mount-layer
              is Err (e) -> cg-mount-line rider ("You cannot mount that: " & e) "mount:refused"
              is Ok (item) -> when world-get game.world item
                is Err (_) -> None
                is Ok (worn) -> let kept = world-update game.world (__record-set worn "health" (max 1 (min 65535 m.health)))
                  in let gone = gws-dismiss g game serial
                  in when world-get game.world item
                    is Err (_) -> None
                    is Ok (now) -> Just (gs-reply [cbp-remove serial, gp-equip now cg-mount-layer] "mount:ride")
 Sets the worn mount item's creature down claimed at the rider's feet and removes the item; the item stays on refusal.
  cg-set-down : CompositeGame, GameShard, GameWorldSpawn, Integer, Integer -> Result Integer Text
  cg-set-down (owner) (game) (g) (rider) (item) = when world-get game.world item
    is Err (e) -> Err e
    is Ok (worn) -> let body = cg-mount-body worn.graphic
      in let profile = gws-claim-profile g (cg-mount-key body) 0
      in if body == 0 | profile < 0 then Err "That mount cannot be set down here."
      else when world-get game.world rider
        is Err (e) -> Err e
        is Ok (me) -> when gws-summon g game profile me.x me.y me.z rider (g.combat.tick + gws-forever)
          is Err (e) -> Err ("You cannot dismount: " & e)
          is Ok (beast) -> let drawn = when world-get game.world beast
              is Err (_) -> 0
              is Ok (b) -> when world-update game.world (__record-set (__record-set (__record-set b "graphic" body) "hue" worn.hue) "health" worn.health) is Err (_) -> 0 is Ok (_) -> 1
            in let removed = world-delete game.world item in Ok beast
  cg-dismount : CompositeGame, GameShard, GameWorldSpawn, Integer -> Maybe GameReply
  cg-dismount (owner) (game) (g) (rider) = let item = gmb-layer owner.items rider cg-mount-layer 0
    in if item == 0 then None
    else if (when world-get game.world item is Err (_) -> False is Ok (w) -> w.graphic == cg-slephnir-art) then
      (when world-delete game.world item is Err (_) -> None is Ok (_) -> Just (gs-reply [sip-remove item] "mount:dismount"))
    else when cg-set-down owner game g rider item
      is Err (e) -> cg-mount-line rider e "mount:refused"
      is Ok (_) -> Just (gs-reply [sip-remove item] "mount:dismount")
 A rider who dies is set down at the blow, before the corpse takes his items (ServUO dismounts at death); the mount item
 goes even when its creature cannot stand there.
  cg-unmount-dead : CompositeGame, Integer -> Integer
  cg-unmount-dead (owner) (victim) = when owner.spawns
    is None -> 0
    is Just (g) -> let item = gmb-layer owner.items victim cg-mount-layer 0
      in if item == 0 then 0
      else when cg-set-down owner owner.checkpoint.game g victim item
        is Err (_) -> (when world-delete owner.checkpoint.game.world item is Err (_) -> 0 is Ok (_) -> 0)
        is Ok (_) -> 1
  cg-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-family (owner) (game) (input) (map) (port) (packet) = when cg-mount owner game input packet
    is Just (mounted) -> Ok (Just mounted)
    is None -> when gmo-click owner.overlay owner.civic owner.spawns owner.land input.connection packet
    is Just (marked) -> Ok (Just marked)
    is None -> when cg-family-said owner game input map port packet
      is Err (e) -> Err e
      is Ok (reply) -> Ok (cg-speakers owner input.session.serial reply)
 UOAIX-68: NPC hearing is judged on the Britain map the residents walk, which covers every shop and the bank lineup.
  cg-city-map : CompositeGame, Integer, Integer -> Maybe WalkMap
  cg-city-map (owner) (x) (y) = ct-map-at owner.cities owner.city-maps x y
  cg-city-nav : CompositeGame, Integer -> Maybe TlPath
  cg-city-nav (owner) (i) = if i < 0 | i >= list-length owner.city-navs then None else Just (list-at owner.city-navs i)
  cg-sight-map : CompositeGame, WalkMap -> WalkMap
  cg-sight-map (owner) (map) = when owner.town-map is None -> map is Just (britain) -> britain
  cg-family-said : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-family-said (owner) (game) (input) (map) (port) (packet) = when cn-handler owner.construction owner.production.harvest owner.flora game input map packet get-ticks owner.town-seconds (as-mobile-name owner.active game) (cg-worker-actors (cg-workers owner) 0)
   is Err (e) -> Err e
   is Ok (Just (built)) -> Ok (Just built)
   is Ok (None) -> when (if list-length packet > 0 & list-at packet 0 == #6F then cg-trade-answer owner game input packet else cg-board owner game input packet)
   is Just (posted) -> Ok (Just posted)
   is None -> let ordered = cg-pet-orders owner game input packet in when cmr-treasury owner.production.harvest owner.banks game input packet
   is Err (e) -> Err e
   is Ok (Just (told)) -> Ok (Just told)
   is Ok (None) -> when (when cg-gift-said owner game input packet is Just (gift) -> Ok (Just gift) is None -> when hs-said owner.housing owner.construction owner.vendor game input packet owner.town-seconds is Just (bid) -> Ok (Just bid) is None -> when cg-pet-command owner game input packet is Just (aimed) -> Ok (Just aimed) is None -> when cg-pet-aimed owner game input packet is Just (commanded) -> Ok (Just commanded) is None -> when cg-duel-said owner game input packet is Just (dueled) -> Ok (Just dueled) is None -> when cg-testify-said owner game input packet is Just (testified) -> Ok (Just testified) is None -> when cg-arrest-answer owner game input packet is Just (answered) -> Ok (Just answered) is None -> when cg-monster-call owner game input packet is Just (called) -> Ok (Just called) is None -> when owner.civic is None -> Ok None is Just (c) -> cv-handler c game input (cg-sight-map owner map) port packet)
    is Err (e) -> Err e
    is Ok (Just (civic)) -> Ok (Just civic)
    is Ok (None) -> when owner.speech
    is None -> cg-family-town owner game input map port packet
    is Just (speech) -> when cg-trade-asked owner speech game input (cg-sight-map owner map) packet
      is Just (named) -> Ok (Just named)
      is None -> when cg-role-said owner speech game input (cg-sight-map owner map) packet
       is Just (role) -> Ok (Just role)
       is None -> when (when cg-worker-said owner game input packet is Just (sold) -> Ok (Just sold) is None -> ns-handler speech game input (cg-sight-map owner map) port packet)
        is Err (e) -> Err e
        is Ok (Just (reply)) -> Ok (Just reply)
        is Ok (None) -> cg-family-town owner game input map port packet
  cg-family-town : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-family-town (owner) (game) (input) (map) (port) (packet) = when cg-worker-trade owner game input packet get-ticks
    is Just (sold) -> Ok (Just sold)
    is None -> when cg-trade-click owner game input packet
    is Just (named) -> Ok (Just named)
    is None -> cg-family-folk owner game input map port packet
 Gatherers sell their own goods to players (CompositeGame.md, new trades: "a farmer can sell wheat, a miner can sell
 ingots"): "buy" spoken with no shopkeeper within reach opens the nearest worker's lots as a buy menu, and a buy cart
 (0x3B) naming that worker settles through the shops' checkout (gv-cart). The worker's pack is its sale container,
 drawn at the vendor buy layer (26) for the asking player only.
  cg-worker-vendor : CgGatherer -> GvVendor
  cg-worker-vendor (c) = GvVendor { serial = c.serial, actor = c.gatherer.producer.actor, stock = c.pack, extra = c.pack, buys = c.pack, prices = 0, shut = 0 }
  cg-worker-near : GameShard, WorldObject, List CgGatherer, Integer -> Integer
  cg-worker-near (game) (mobile) (workers) (i) = if i >= list-length workers then 0 - 1
    else let c = list-at workers i
    in if c.serial == 0 | c.pack == 0 then cg-worker-near game mobile workers (i + 1)
    else when world-get game.world c.serial
      is Err (_) -> cg-worker-near game mobile workers (i + 1)
      is Ok (m) -> if gv-near mobile m then i else cg-worker-near game mobile workers (i + 1)
  cg-worker-trade : CompositeGame, GameShard, GameInput, List Integer, Integer -> Maybe GameReply
  cg-worker-trade (owner) (game) (input) (packet) (tick) = let v = owner.vendor
    in if input.mode /= 2 | input.session.phase /= 2 | list-length packet < 8 then None
    else let opcode = list-at packet 0
    in if opcode /= 3 & opcode /= 59 then None
    else if (if opcode == 3 then not (cg-buy-said packet) else False) then None
    else let player = gv-player v input.session.serial 0
    in if player < 0 then None
    else let p = list-at v.players player
    in when world-get game.world p.serial
      is Err (_) -> None
      is Ok (mobile) -> let workers = cg-workers owner
        in let at = if opcode == 3 then (if gv-nearest v mobile (0 - 1) >= 0 then 0 - 1 else cg-worker-near game mobile workers 0) else cg-worker-at workers (gp-u32 packet 3) 0
        in if at < 0 then None
        else let c = list-at workers at
        in let vendor = cg-worker-vendor c
        in when world-get game.world c.serial
          is Err (_) -> None
          is Ok (npc) -> if not (gv-near mobile npc) then None
            else if opcode == 59 then Just (gv-cart v p vendor input packet tick)
            else Just (cg-worker-menu v p vendor npc input.connection tick)
 The NPC speech handler answers every speech packet, so a spoken "buy" reaches a worker's sale here, before it; the
 speaker's line is echoed as that handler echoes it.
  cg-worker-said : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-worker-said (owner) (game) (input) (packet) = if list-length packet < 1 | list-at packet 0 /= 3 then None
    else when cg-worker-trade owner game input packet get-ticks
      is None -> None
      is Just (sold) -> let slot = gv-slot game input.session.serial 0
        in if slot < 0 then Just sold
        else when world-get game.world input.session.serial
          is Err (_) -> Just sold
          is Ok (viewer) -> Just (GameReply { packets = [gp-speech viewer game.characters slot packet] & sold.packets, close = sold.close, note = sold.note })
  cg-buy-said : List Integer -> Boolean
  cg-buy-said (packet) = if not (gp-speech-valid packet) then False
    else let speech = gp-speech-text packet
    in let at = gv-tail speech "buy"
    in if at < 0 then False else gv-speech-role speech at == 0 - 1
  cg-worker-menu : GvWorld, GvPlayer, GvVendor, WorldObject, Integer, Integer -> GameReply
  cg-worker-menu (v) (p) (vendor) (npc) (connection) (tick) = let a = __record-set p "count" 0
    in let b = __record-set p "vendor" vendor.serial
    in let c = __record-set p "side" 1
    in let d = __record-set p "connection" connection
    in let e = __record-set p "expires" (tick + gv-quote-ticks)
    in let cr = __record-set p "copper-rate" v.currency.copper-rate
    in let sr = __record-set p "silver-rate" v.currency.silver-rate
    in let count = gv-fill v p vendor 1 0
    in if p.count == 0 then let closed = __record-set p "side" 0 in gs-reply [gvp-speech npc "" "I have nothing for sale."] "worker sale empty"
    else let stock = gv-subset v p vendor.stock 0 []
    in gs-reply [gv-equip-packet v vendor.stock 26, gvp-contents stock (list-length stock) vendor.stock,
      gvp-buy v.currency.world.catalog stock (list-length stock) vendor.stock v.currency.copper-rate v.currency.silver-rate, gvp-open vendor.serial, gv-status-packet v p,
      gvp-speech npc "" ("Take a look at what I have. " & gv-price-note v)] "worker sale menu"
  cg-family-folk : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-family-folk (owner) (game) (input) (map) (port) (packet) = when (when owner.town is None -> Ok None is Just (town) -> when owner.lineup is None -> tl-handler town game input map port packet is Just (l) -> when cgl-handler l town game input packet is Err (e) -> Err e is Ok (Just (named)) -> Ok (Just named) is Ok (None) -> tl-handler town game input map port packet)
    is Err (e) -> Err e
    is Ok (Just (reply)) -> Ok (Just (cg-town-status owner packet reply))
    is Ok (None) -> when (when owner.shops is None -> Ok None is Just (shops) -> bb-handler shops game input map port packet)
      is Err (e) -> Err e
      is Ok (Just (reply)) -> Ok (Just reply)
      is Ok (None) -> cg-family-base owner game input map port packet
  cg-family-base : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-family-base (owner) (game) (input) (map) (port) (packet) = when (when owner.flora is None -> Ok None is Just (s) -> wf-handler s game.world packet)
    is Err (e) -> Err e
    is Ok (Just (reply)) -> Ok (Just reply)
    is Ok (None) -> when cg-decoration owner game input map port packet
     is Err (e) -> Err e
     is Ok (Just (reply)) -> Ok (Just reply)
     is Ok (None) -> when gr-handler owner.resurrection game input map port packet
      is Err (e) -> Err e
      is Ok (Just (reply)) -> Ok (Just reply)
      is Ok (None) -> cg-bank-family owner game input map port packet
  cg-house-mark : CompositeGame, Integer, Integer, Integer -> Boolean
  cg-house-mark (owner) (caster) (x) (y) = hs-may-mark owner.housing owner.construction caster x y 0
  cg-decoration : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-decoration (owner) (game) (input) (map) (port) (packet) = when owner.decoration
    is None -> Ok None
    is Just (state) -> when cgt-handler (cg-gate-decos owner state) owner.items game input packet
     is Err (e) -> Err e
     is Ok (Just (gated)) -> Ok (Just gated)
     is Ok (None) -> let index = if list-length packet < 5 then -1 else bit-and (gp-u32 packet 1) #7FFFFFFF - wd-serial-base - 1
      in let orchard = if list-length packet /= 5 | list-at packet 0 /= 6 | index < 0 | index >= state.count then -1
        else cpl-orchard-site owner.production.harvest (wd-art state index) (wd-x state index) (wd-y state index)
      in let house = if orchard >= 0 | list-length packet /= 5 | list-at packet 0 /= 6 | index < 0 | index >= state.count | wd-field state index 7 /= 2 then -1
        else hs-house-at-sign owner.housing (wd-field state index 0) (wd-field state index 1) 0
      in if orchard >= 0 then (if input.mode /= 2 | input.session.phase /= 2 then Ok None else cpl-care owner.production.harvest input orchard)
      else if house >= 0 then (if input.mode /= 2 | input.session.phase /= 2 then Ok None else Ok (Just (hs-sign owner.housing owner.construction game input house owner.town-seconds (as-mobile-name owner.active game))))
      else let before = if index < 0 | index >= state.count then -1 else peek-byte state.opened index
      in when wd-handler state game input map port packet
        is Err (e) -> Err e
        is Ok (reply) -> let changed = if before < 0 then 0 else if peek-byte state.opened index == before then 0 else world-item-touch game.world
          in let timed = wd-track state owner.timers index before get-ticks
          in let synced = if before < 0 then 0 else if peek-byte state.opened index == before then 0 else cg-door-cells owner.town-doors index
          in Ok (cg-shop-door owner index before reply)
  cg-shop-door : CompositeGame, Integer, Integer, Maybe GameReply -> Maybe GameReply
  cg-shop-door (owner) (index) (before) (reply) = when reply
    is None -> None
    is Just (r) -> if before < 0 | r.note /= "That door is locked." then reply
      else (when owner.staff
        is None -> reply
        is Just (s) -> let note = bsh-door-note s index before owner.town-seconds (owner.day-hook 0)
          in if text-length note == 0 then reply else Just (gsi-denied note))
 UOAIX-56: in a world with Britain's shops, a banker's click shows "the banker" until the character knows its name.
  cg-named-town : CompositeGame -> Boolean
  cg-named-town (owner) = when owner.shops is None -> False is Just (_) -> True
  cg-banker-label : CompositeGame, Integer, Integer -> Text
  cg-banker-label (owner) (character) (npc) = when owner.shops is None -> "Banker" is Just (s) -> nn-label s.known character cst-banker npc "banker"
  cg-npc-label : CompositeGame, Integer, Integer -> Text
  cg-npc-label (owner) (character) (serial) =
    let role = when owner.shops is None -> -1 is Just (s) -> bb-role s.vendors serial
    in if role >= 0 then (when owner.shops is None -> "" is Just (s) -> bb-label s character role serial)
    else if gmb-is-banker owner.banks serial 0 & cg-named-town owner then cg-banker-label owner character serial
    else cg-trade-label owner character serial
 UOAIX-56: a resident, a miner or the farmer shows its trade until the character asks its name. A resident's copy in the
 bank lineup is the same person, so its name is known under the resident's own serial.
  cg-person : CompositeGame, Integer -> Integer
  cg-person (owner) (serial) = if serial == 0 then 0 else when owner.town
    is None -> 0
    is Just (t) -> let person = tl-person-for t serial 0
      in if person > 0 then person
      else when owner.lineup is None -> 0 is Just (l) -> if l.resident == serial then l.person else 0
 TownLive's jobs: Nell bakes (2), Jorin smiths (3), Mira sells cloth at the market (4); job 1 farms.
  cg-job-word : Integer -> Text
  cg-job-word (job) = if job == 1 then "farmer" else if job == 2 then "baker" else if job == 3 then "blacksmith" else if job == 4 then "tailor" else ""
  cg-is-miner : List CgGatherer, Integer, Integer -> Boolean
  cg-is-miner (miners) (serial) (i) = if i == list-length miners then False else (list-at miners i).serial == serial | cg-is-miner miners serial (i + 1)
  cg-worker-role : CompositeGame, Integer -> Integer
  cg-worker-role (owner) (serial) = if serial == 0 then -1
    else if (when owner.gatherer is None -> False is Just (g) -> g.serial == serial) then cst-miner
    else if (when owner.farmer is None -> False is Just (f) -> f.serial == serial) then cst-farmer
    else let i = cg-worker-at owner.miners serial 0 in if i < 0 then -1 else (list-at owner.miners i).trade.look
  cg-worker-at : List CgGatherer, Integer, Integer -> Integer
  cg-worker-at (miners) (serial) (i) = if i == list-length miners then -1 else if (list-at miners i).serial == serial then i else cg-worker-at miners serial (i + 1)
  cg-place-word : Integer -> Text
  cg-place-word (place) = if place == cgg-farm-place | place == cgg-flax-place then "grain farmer"
    else if place == cgg-cotton-place then "fiber farmer" else if place == cgg-wool-place then "shepherd"
    else if place == cgg-lumber-place then "lumberjack" else if place == cgg-fish-place then "fisherman"
    else if place == cgg-sand-place then "sand gatherer" else if place == cgg-clay-place then "clay gatherer" else if place == cgg-stone-place then "quarrier"
    else if place == cgg-herb-farm then "herb farmer" else if place == cgg-root-farm then "root farmer"
    else if place == cgg-veg-farm then "vegetable farmer"
    else if place == cgg-baker-place then "castle baker" else if place == cgg-cook-place then "castle cook" else if place == cgg-cutter-place then "fish cutter" else "miner"
  cg-trade : CompositeGame, Integer -> Text
  cg-trade (owner) (serial) = let person = cg-person owner serial
    in if person > 0 then (when owner.town is None -> "" is Just (t) -> cg-job-word (tf-person t.people person).job)
    else if cg-is-fisher owner serial then "fisherman"
    else if (when owner.gatherer is None -> False is Just (g) -> g.serial == serial) then "miner"
    else if (when owner.farmer is None -> False is Just (f) -> f.serial == serial) then "grain farmer"
    else let i = cg-worker-at owner.miners serial 0
    in if i >= 0 then cg-place-word (list-at owner.miners i).gatherer.place
    else if serial /= 0 & serial == cmr-serial owner.production.harvest.items.world then "royal minter"
    else ""
  cg-name-key : CompositeGame, Integer -> Integer
  cg-name-key (owner) (serial) = let person = cg-person owner serial
    in if person > 0 then (when owner.town is None -> serial is Just (t) -> (tf-person t.people person).world-serial) else serial
  cg-trade-label : CompositeGame, Integer, Integer -> Text
  cg-trade-label (owner) (character) (serial) = let civic = cg-civic-title owner serial
    in if civic /= "" then nn-called owner.known character serial (if civic == "Mayor of Britain" then cg-mayor-name owner else nn-name cst-guard serial) civic
    else let trade = cg-trade owner serial
    in if trade == "" then ""
    else let person = cg-person owner serial
    in let name = if person > 0 then (when owner.town is None -> "" is Just (t) -> (tf-person t.people person).name)
      else nn-name (cg-worker-role owner serial) serial
    in nn-called owner.known character (cg-name-key owner serial) name trade & (if cg-drink-level owner serial >= 3 then " (drunk)" else if cg-drink-level owner serial >= 1 then " (merry)" else "")
  cg-civic-title : CompositeGame, Integer -> Text
  cg-civic-title (owner) (serial) = if serial == 0 then ""
    else if (when owner.crew is None -> False is Just (k) -> k.serial == serial) then "carpenter"
    else when owner.civic
      is None -> ""
      is Just (c) -> if c.mayor == serial then "Mayor of Britain" else if cg-civic-guard c serial 0 then "guard" else ""
 The mayor's name is the office holder's: the first holder is the person "Mayor of Britain", shown by the stylist's name
 for the mayor's mobile; a holder Lord British appoints from the panel carries a name of its own.
  cg-mayor-name : CompositeGame -> Text
  cg-mayor-name (owner) = let serial = when owner.civic is None -> 0 is Just (c) -> c.mayor
    in let held = when owner.gov is None -> "" is Just (s) -> when owner.town is None -> "" is Just (t) -> (tf-person t.people (tg-office s.government 1).mayor).name
    in if held == "" | held == "Mayor of Britain" then nn-name cst-guard serial else held
  cg-mayor-replace : CompositeGame -> Integer
  cg-mayor-replace (owner) = when owner.gov
    is None -> -1
    is Just (s) -> when owner.town
      is None -> -1
      is Just (t) -> when owner.civic
        is None -> -1
        is Just (c) -> let g = s.government
          in let old = (tg-office g 1).mayor
          in let name = list-at nn-male (int-mod (t.people.used * 7 + old) (list-length nn-male))
          in let person = if not (cg-live-mobile owner c.mayor) then -1 else tf-add-person t.people name 1 1001 100 0 9000
          in if person < 1 | tg-appoint g True 1 person < 0 then -1
          else let unbound = __record-set (tf-person t.people old) "world-serial" 0
          in let bound = __record-set (tf-person t.people person) "world-serial" c.mayor
          in let touched = world-touch owner.checkpoint.game.world in person
  cg-civic-guard : CivicLive, Integer, Integer -> Boolean
  cg-civic-guard (c) (serial) (i) = if i >= list-length c.guards then False else (list-at c.guards i).serial == serial | cg-civic-guard c serial (i + 1)
  cg-trade-serials : CompositeGame -> List Integer
  cg-trade-serials (owner) = let folk = when owner.town is None -> [] is Just (t) -> cg-folk-serials t 0 []
    in let copy = when owner.lineup is None -> [] is Just (l) -> if l.resident == 0 then [] else [l.resident]
    in let lead = when owner.gatherer is None -> [] is Just (g) -> [g.serial]
    in let farm = when owner.farmer is None -> [] is Just (f) -> [f.serial]
    in folk & copy & lead & farm & cg-miner-serials owner.miners 0 []
  cg-folk-serials : TownLive, Integer, List Integer -> List Integer
  cg-folk-serials (t) (i) (out) = if i == t.count then out else cg-folk-serials t (i + 1) (out & [(tf-person t.people (list-at t.residents i).person).world-serial])
  cg-miner-serials : List CgGatherer, Integer, List Integer -> List Integer
  cg-miner-serials (miners) (i) (out) = if i == list-length miners then out else cg-miner-serials miners (i + 1) (out & [(list-at miners i).serial])
  cg-trade-click : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-trade-click (owner) (game) (input) (packet) = if list-length packet /= 5 | list-at packet 0 /= 9 | input.mode /= 2 | input.session.phase /= 2
    | game.active /= input.session.serial then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let label = cg-trade-label owner input.session.serial serial
    in if label == "" then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (viewer) -> when world-get game.world serial
        is Err (_) -> None
        is Ok (npc) -> if walk-abs (viewer.x - npc.x) > 18 | walk-abs (viewer.y - npc.y) > 18 then None
          else Just (cg-town-status owner packet (gs-reply (gvp-hello npc label) "npc trade name"))
  cg-trade-nearest : GameShard, WalkMap, WorldObject, Integer, List Integer, Integer, Integer, Integer -> Integer
  cg-trade-nearest (game) (map) (viewer) (range) (serials) (i) (best) (distance) = if i == list-length serials then best
    else when world-get game.world (list-at serials i)
      is Err (_) -> cg-trade-nearest game map viewer range serials (i + 1) best distance
      is Ok (npc) -> let d = ns-closeness viewer npc
        in let chosen = ns-heard map 0 viewer npc range & (best == 0 | d < distance)
        in cg-trade-nearest game map viewer range serials (i + 1) (if chosen then npc.serial else best) (if chosen then d else distance)
 Asked its name, a resident addressed by name, or else the nearest resident, miner or farmer in earshot, answers,
 unless a shopkeeper or banker is addressed (by name, trade, "banker" or "vendor") or stands nearer (ns-named answers those).
  cg-trade-asked : CompositeGame, NpcSpeech, GameShard, GameInput, WalkMap, List Integer -> Maybe GameReply
  cg-trade-asked (owner) (s) (game) (input) (map) (packet) =
    if list-length packet < 9 | list-length packet > 256 | list-at packet 0 /= 3 | list-at packet 3 == 2 | not (gs-byte-range packet 0)
      | not (gp-speech-valid packet) | input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then None
    else let text = gp-speech-text packet
    in let slot = gv-slot game input.session.serial 0
    in if ns-command text /= 5 | slot < 0 | ns-has text "banker" | ns-has text "vendor" then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (viewer) -> let range = if list-at packet 3 == 8 then 1 else 4
        in let exact = ns-addressed s viewer text True 0 -1 0
        in let named = if exact >= 0 then exact else ns-addressed s viewer text False 0 -1 0
        in if named >= 0 & (list-at s.rows named).kind /= 3 then None
        else let row = if named >= 0 then named else ns-nearest s map viewer 0 range 0 -1 0
        in let serial = if named >= 0 then (list-at s.rows named).serial else cg-trade-nearest game map viewer range (cg-trade-serials owner) 0 0 0
        in if serial == 0 then None
        else when world-get game.world serial
          is Err (_) -> None
          is Ok (npc) -> let rival = if row < 0 | named >= 0 then 9223372036854775807
              else when world-get game.world (list-at s.rows row).serial is Err (_) -> 9223372036854775807 is Ok (other) -> ns-closeness viewer other
            in if not (ns-heard map 0 viewer npc range) | ns-closeness viewer npc > rival then None
            else let learned = nn-learn owner.known viewer.serial (cg-name-key owner serial)
            in let touched = if learned > 0 then world-touch game.world else 0
            in let label = cg-trade-label owner viewer.serial serial
            in Just (gs-reply ([gp-speech viewer game.characters slot packet, gvp-speech npc label ("I am " & label & ".")] & gvp-hello npc label) "NPC trade name")
  cg-role-word : CompositeGame, Integer -> Text
  cg-role-word (owner) (serial) = if serial == 0 | cg-person owner serial > 0 then ""
    else let civic = cg-civic-title owner serial
    in if civic == "guard" | civic == "carpenter" then civic else if civic /= "" then "" else cg-trade owner serial
  cg-role-key : Text -> Text
  cg-role-key (role) = if ns-has role "picker" then "picker" else if ns-has role "farmer" then "farmer" else if role == "royal minter" then "minter" else role
  cg-guard-serials : CivicLive, Integer, List Integer -> List Integer
  cg-guard-serials (c) (i) (out) = if i >= list-length c.guards then out else cg-guard-serials c (i + 1) (out & [(list-at c.guards i).serial])
  cg-role-serials : CompositeGame -> List Integer
  cg-role-serials (owner) = let guards = when owner.civic is None -> [] is Just (c) -> cg-guard-serials c 0 []
    in let crew = when owner.crew is None -> [] is Just (k) -> [k.serial]
    in let minter = cmr-serial owner.production.harvest.items.world
    in cg-trade-serials owner & guards & crew & (if minter == 0 then [] else [minter])
  cg-role-nearest : CompositeGame, GameShard, WalkMap, WorldObject, Text, Integer, List Integer, Integer, Integer, Integer -> Integer
  cg-role-nearest (owner) (game) (map) (viewer) (text) (range) (serials) (i) (best) (distance) = if i == list-length serials then best
    else let serial = list-at serials i
    in let role = cg-role-word owner serial
    in if role == "" | not (ns-has text (cg-role-key role)) then cg-role-nearest owner game map viewer text range serials (i + 1) best distance
    else when world-get game.world serial
      is Err (_) -> cg-role-nearest owner game map viewer text range serials (i + 1) best distance
      is Ok (npc) -> let d = ns-closeness viewer npc
        in let chosen = ns-heard map 0 viewer npc range & (best == 0 | d < distance)
        in cg-role-nearest owner game map viewer text range serials (i + 1) (if chosen then serial else best) (if chosen then d else distance)
 A worker, a guard, the carpenter crew or the royal minter addressed by its trade word answers in that trade (Damian,
 2026-10-08: every NPC's mind fits its role), unless the speech names a shopkeeper, banker or resident row.
  cg-role-said : CompositeGame, NpcSpeech, GameShard, GameInput, WalkMap, List Integer -> Maybe GameReply
  cg-role-said (owner) (s) (game) (input) (map) (packet) =
    if list-length packet < 9 | list-length packet > 256 | list-at packet 0 /= 3 | list-at packet 3 == 2 | not (gs-byte-range packet 0)
      | not (gp-speech-valid packet) | input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then None
    else let text = gp-speech-text packet
    in let slot = gv-slot game input.session.serial 0
    in let command = ns-command text
    in if slot < 0 | command == -1 | command == 1 | command == 2 | command == 3 | command == 5 then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (viewer) -> if ns-addressed s viewer text True 0 -1 0 >= 0 then None
        else let range = if list-at packet 3 == 8 then 1 else 4
        in let serial = cg-role-nearest owner game map viewer text range (cg-role-serials owner) 0 0 0
        in if serial == 0 then None
        else when world-get game.world serial
          is Err (_) -> None
          is Ok (npc) -> let line = nl-pick s.town.lines 3 "" (cg-role-word owner serial) (ns-topic text) nl-any nl-any (viewer.serial + s.town.now)
            in let said = if text-length line == 0 then nl-pick s.town.lines 3 "" "" 0 nl-any nl-any viewer.serial else line
            in Just (gs-reply [gp-speech viewer game.characters slot packet, gvp-speech npc (cg-trade-label owner viewer.serial serial) said] "NPC role line")
 Every NPC line a character hears carries that character's name for the speaker (0x1C name, bytes 14-43).
  cg-speakers : CompositeGame, Integer, Maybe GameReply -> Maybe GameReply
  cg-speakers (owner) (viewer) (reply) = when reply
    is None -> None
    is Just (r) -> Just (GameReply { packets = cg-speakers-at owner viewer r.packets 0 [], close = r.close, note = r.note })
  cg-speakers-at : CompositeGame, Integer, List (List Integer), Integer, List (List Integer) -> List (List Integer)
  cg-speakers-at (owner) (viewer) (packets) (i) (out) = if i == list-length packets then out
    else let p = list-at packets i
    in let name = if list-length p >= 44 & list-at p 0 == #1C & gp-u32 p 3 /= viewer then cg-npc-label owner viewer (gp-u32 p 3) else ""
    in cg-speakers-at owner viewer packets (i + 1) (list-push out (if name == "" then p else bb-name-bytes p name 0))
  cg-bank-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-bank-family (owner) (game) (input) (map) (port) (packet) =
    if list-length packet == 5 & (list-at packet 0 == 6 | list-at packet 0 == 9) & gv-vendor owner.vendor (bit-and (gp-u32 packet 1) #7FFFFFFF) 0 >= 0 then cg-vendor-family owner game input map port packet
    else if list-length packet == 5 & list-at packet 0 == 9 & gmb-is-banker owner.banks (gp-u32 packet 1) 0 & cg-named-town owner then
      when world-get game.world (gp-u32 packet 1)
        is Err (_) -> Ok None
        is Ok (npc) -> Ok (Just (gs-reply (gvp-hello npc (cg-banker-label owner input.session.serial npc.serial)) "bank:name"))
    else when gmb-handle owner.banks game input map port packet
    is Err (e) -> Err e
    is Ok (answer) -> when answer
      is Just (reply) -> Ok (Just reply)
      is None -> cg-vendor-family owner game input map port packet
  cg-vendor-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-vendor-family (owner) (game) (input) (map) (port) (packet) = when cg-eat owner game input packet
    is Err (e) -> Err e
    is Ok (Just (ate)) -> Ok (Just ate)
    is Ok (None) -> cg-vendor-lit owner game input map port packet
  cg-vendor-lit : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-vendor-lit (owner) (game) (input) (map) (port) (packet) = when cg-kindling owner game input map packet
    is Err (e) -> Err e
    is Ok (Just (lit)) -> Ok (Just lit)
    is Ok (None) -> when cg-wbook-open owner game input.session.serial packet
     is Just (opened) -> Ok (Just opened)
     is None -> when (when owner.magic is None -> Ok None is Just (magic) -> cart-handler-at owner.production.harvest owner.active magic game input packet get-ticks)
      is Err (e) -> Err e
      is Ok (Just (drawn)) -> Ok (Just (cg-map-course owner game input.session.serial drawn))
      is Ok (None) -> cg-skills-family owner game input map port packet
 UOAIX-177 (WritableBooks): a double-click on a blank book opens it, writable for the one carrying it in the backpack
 and read-only on the ground within 2 tiles; the writer's 0x93 sets its title and author and its 0x66 its pages.
  cg-wbook-is : GameShard, Integer -> Boolean
  cg-wbook-is (game) (serial) = when world-get game.world serial is Err (_) -> False is Ok (book) -> book.kind == 2 & book.graphic == wbk-graphic
  cg-wbook-near : GameShard, Integer, WorldObject -> Boolean
  cg-wbook-near (game) (viewer) (book) = when world-get game.world viewer
    is Err (_) -> False
    is Ok (me) -> book.container == 0 & walk-abs (me.x - book.x) <= 2 & walk-abs (me.y - book.y) <= 2
  cg-wbook-open : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-wbook-open (owner) (game) (viewer) (packet) = if list-length packet /= 5 | list-at packet 0 /= 6 | viewer <= 0 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in when world-get game.world serial
      is Err (_) -> None
      is Ok (book) -> if book.kind /= 2 | book.graphic /= wbk-graphic then None
        else let mine = gv-owned game.world serial viewer 65
        in if not mine & not (cg-wbook-near game viewer book) then None
        else let i = wbk-ensure owner.books serial
        in let head = wbk-header owner.books serial mine
        in Just (gs-reply (if i < 0 then [head] else [head, wbk-page-packet owner.books serial]) "book opened")
  cg-wbook-write : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-wbook-write (owner) (game) (viewer) (packet) = if list-length packet < 9 | (list-at packet 0 /= #93 & list-at packet 0 /= #66) then None
    else if list-at packet 0 == #93 & list-length packet /= 98 then None
    else let serial = bit-and (gp-u32 packet (if list-at packet 0 == #93 then 1 else 3)) #7FFFFFFF
    in let i = if viewer > 0 & cg-wbook-is game serial & gv-owned game.world serial viewer 65 then wbk-ensure owner.books serial else -1
    in if i < 0 then Just (gs-reply [] "book refused")
    else if list-at packet 0 == #93 then
      let titled = wbk-take (wbk-row owner.books i + 8) packet 8 60 0
      in let signed = wbk-take (wbk-row owner.books i + 72) packet 68 30 0 in Just (gs-reply [] "book titled")
    else Just (gs-reply [] (if wbk-write-pages owner.books i packet < 0 then "book refused" else "book written"))
 UOAIX-176: a drawn map opened (MapDetails) is followed by its course (MapPins mpn-course); it shows editable only to
 an owner who has set it so.
  cg-map-course : CompositeGame, GameShard, Integer, GameReply -> GameReply
  cg-map-course (owner) (game) (viewer) (r) = if r.note /= "cartography map shown" | list-length r.packets == 0 then r
    else let serial = gp-u32 (list-at r.packets 0) 1
    in GameReply { packets = r.packets & mpn-course owner.pins serial (mpn-editable owner.pins serial & gv-owned game.world serial viewer 65),
      close = r.close, note = r.note }
  cg-map-drawn : CompositeGame, GameShard, Integer -> Boolean
  cg-map-drawn (owner) (game) (serial) = when world-get game.world serial
    is Err (_) -> False
    is Ok (item) -> item.kind == 2 & item.graphic == cart-drawn & (when owner.magic is None -> False is Just (magic) -> mgs-known magic serial)
 UOAIX-176, MapCommand 0x56 (MapPins): the owner of a drawn map in the backpack toggles it editable (6, answered with
 7 and the new flag) and, while it is editable, adds, inserts, moves, removes or clears pins. Anyone else's command,
 or one on a map not set editable, changes nothing.
  cg-map-pin : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-map-pin (owner) (game) (viewer) (packet) = if list-length packet /= 11 | list-at packet 0 /= #56 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let command = list-at packet 5
    in if viewer <= 0 | not (cg-map-drawn owner game serial) | not (gv-owned game.world serial viewer 65) then Just (gs-reply [] "map pin refused")
    else if command == 6 then let set = mpn-set-editable owner.pins serial (not (mpn-editable owner.pins serial))
      in Just (gs-reply [mpn-packet serial 7 (if mpn-editable owner.pins serial then 1 else 0) 0 0] "map editable")
    else if not (mpn-editable owner.pins serial) then Just (gs-reply [] "map pin refused")
    else let done = mpn-command owner.pins serial command (list-at packet 6) (gp-u16 packet 7) (gp-u16 packet 9)
    in Just (gs-reply [] (if done < 0 then "map pin refused" else "map pin plotted"))
 A double-click on the backpack another mobile wears (layer 21): Lord British opens it with no roll and no crime anywhere
 in view (18 tiles), as a GM holding the inspect power does through CompositePaging (audited); anyone else snoops by the
 Snooping skill (as-snoop; ServUO Snooping.cs: a player snoops by double-clicking the pack).
  cg-worn-pack : CompositeGame, GameShard, GameInput, List Integer -> Integer
  cg-worn-pack (owner) (game) (input) (packet) =
    if list-length packet /= 5 | list-at packet 0 /= 6 | input.mode /= 2 | input.session.phase /= 2 then 0
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in if not (gsi-known owner.items serial) then 0
    else when world-get game.world serial
      is Err (_) -> 0
      is Ok (pack) -> if pack.kind /= 2 | pack.container == 0 | pack.container == input.session.serial | (gsi-meta owner.items serial).layer /= 21 then 0
        else when world-get game.world pack.container is Err (_) -> 0 is Ok (holder) -> if holder.kind == 1 then serial else 0
  cg-pack-open : CompositeGame, GameShard, GameInput, Integer -> GameReply
  cg-pack-open (owner) (game) (input) (serial) = when world-get game.world serial
    is Err (_) -> gsi-denied "That is gone."
    is Ok (pack) -> when world-get game.world pack.container
      is Err (_) -> gsi-denied "That is gone."
      is Ok (holder) -> when world-get game.world input.session.serial
        is Err (_) -> gsi-denied "That is gone."
        is Ok (me) -> if walk-abs (me.x - holder.x) > 18 | walk-abs (me.y - holder.y) > 18 then gsi-denied "That is too far away."
          else gs-reply [sip-open serial (gsi-meta owner.items serial).gump, gsi-contents owner.items serial 0 [#3C,0,0,0,0] 0] "items:inspect-pack"
  cg-snoop-pack : CompositeGame, GameShard, GameInput, List Integer -> Result (Maybe GameReply) Text
  cg-snoop-pack (owner) (game) (input) (packet) = let serial = cg-worn-pack owner game input packet
    in if serial == 0 then Ok None
    else if ga-is-british game.accounts then Ok (Just (cg-pack-open owner game input serial))
    else when world-get game.world serial
      is Err (_) -> Ok None
      is Ok (pack) -> when world-get game.world pack.container
        is Err (_) -> Ok None
        is Ok (holder) -> when world-get game.world input.session.serial
          is Err (e) -> Err e
          is Ok (me) -> let slot = gsi-slot game input.session.serial 0
            in if slot < 0 then Ok None
            else Ok (Just (as-snoop (cg-as-services owner) owner.active (as-session owner.active game input me slot) me holder))
  cg-skills-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-skills-family (owner) (game) (input) (map) (port) (packet) = when cg-snoop-pack owner game input packet
    is Err (e) -> Err e
    is Ok (Just (peeked)) -> Ok (Just peeked)
    is Ok (None) -> cg-skills-active owner game input map port packet
  cg-skills-active : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-skills-active (owner) (game) (input) (map) (port) (packet) = when as-handler (cg-as-services owner) owner.active game input map port packet
    is Err (e) -> Err e
    is Ok (Just (skilled)) -> Ok (Just skilled)
    is Ok (None) -> when gnv-handler-at owner.items game input packet (owner.clock / mgd-ticks 1000)
     is Err (e) -> Err e
     is Ok (Just (looked)) -> Ok (Just looked)
     is Ok (None) -> when gal-handler-at owner.production.harvest owner.active (cg-as-services owner) game input packet get-ticks
      is Err (e) -> Err e
      is Ok (Just (brewed)) -> Ok (Just brewed)
      is Ok (None) -> cg-scribe-family owner game input map port packet
  cg-scribe-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-scribe-family (owner) (game) (input) (map) (port) (packet) = when (when owner.decoration is None -> Ok None is Just (doors) -> (when glk-key-door-at owner.production.harvest doors game input packet get-ticks is Err (e) -> Err e is Ok (Just (keyed)) -> Ok (Just keyed) is Ok (None) -> glk-door-at owner.production.harvest owner.active doors game input packet get-ticks))
    is Err (e) -> Err e
    is Ok (Just (unlatched)) -> Ok (Just unlatched)
    is Ok (None) -> cg-lock-family owner game input map port packet
  cg-lock-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-lock-family (owner) (game) (input) (map) (port) (packet) = when (when owner.magic is None -> Ok None is Just (magic) -> glk-pick-at owner.production.harvest owner.active magic game input packet get-ticks)
    is Err (e) -> Err e
    is Ok (Just (picked)) -> Ok (Just picked)
    is Ok (None) -> when (when owner.magic is None -> Ok None is Just (magic) -> glk-key-at owner.production.harvest magic game input packet get-ticks)
     is Err (e) -> Err e
     is Ok (Just (keyed)) -> Ok (Just keyed)
     is Ok (None) -> cg-inscribe-family owner game input map port packet
  cg-gold-drop : CompositeGame, List Integer -> Boolean
  cg-gold-drop (owner) (packet) = if list-length packet < 14 | list-at packet 0 /= 8 then False
    else let v = owner.production.harvest.vendor
    in let at = gv-lot v (bit-and (gp-u32 packet 1) #7FFFFFFF) 0
    in at >= 0 & (ep-lot v.currency.world.goods at).item == 32
  cg-minter-or-plant : CompositeGame, GameShard, GameInput, WalkMap, List Integer -> Result (Maybe GameReply) Text
  cg-minter-or-plant (owner) (game) (input) (map) (packet) = when tbd-dice owner.vendor owner.production.harvest.items owner.tavern game input packet get-ticks
    is Just (rolled) -> Ok (Just rolled)
    is None -> when (when cg-play-drop owner game input packet is Just (r) -> Just r is None -> cg-mayor-drop owner game input packet)
    is Just (refused) -> Ok (Just refused)
    is None -> let gold = cg-gold-drop owner packet
    in when cmr-handler owner.production.harvest game input packet
    is Err (e) -> Err e
    is Ok (Just (minted)) -> let opened = if gold & minted.note == "minter struck" & ga-is-british game.accounts then cg-seed-gold owner else 0
      in Ok (Just minted)
    is Ok (None) -> when cpl-handler owner.planting owner.production.harvest owner.flora game input map packet get-ticks
      is Err (e) -> Err e
      is Ok (None) -> Ok None
      is Ok (Just (r)) -> if r.note /= "planting pricked" then Ok (Just r)
        else Ok (Just (GameReply { packets = r.packets & cg-own-health owner game input.session.serial, close = r.close, note = r.note }))
  cg-own-health : CompositeGame, GameShard, Integer -> List (List Integer)
  cg-own-health (owner) (game) (serial) = when world-get game.world serial
    is Err (_) -> []
    is Ok (m) -> when cb-ensure owner.combat game serial
      is Err (_) -> []
      is Ok (a) -> [cbp-health serial m.health (max 1 a.maximum) True]
  cg-inscribe-family : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-inscribe-family (owner) (game) (input) (map) (port) (packet) = when (when owner.magic is None -> Ok None is Just (magic) -> ins-handler-at owner.production.harvest owner.active magic game input packet get-ticks)
    is Err (e) -> Err e
    is Ok (Just (scribed)) -> Ok (Just scribed)
    is Ok (None) -> when cg-minter-or-plant owner game input map packet
     is Err (e) -> Err e
     is Ok (Just (planted)) -> Ok (Just planted)
     is Ok (None) -> when swb-handler-at owner.production.harvest.items owner.fleet game input packet get-ticks
     is Just (battle) -> Ok (Just battle)
     is None -> when ld-handler-at owner.production.harvest owner.decor (ga-bound game.accounts) game input map packet
     is Err (e) -> Err e
     is Ok (Just (loom)) -> Ok (Just loom)
     is Ok (None) -> let anvils = __record-set owner.production "decoration" owner.decoration
       in when cpr-handler owner.production game input map port (cg-flora-target owner packet)
      is Err (e) -> Err e
      is Ok (Just (made)) -> Ok (Just made)
      is Ok (None) -> cg-vendor-base owner game input map port packet
  cg-vendor-base : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-vendor-base (owner) (game) (input) (map) (port) (packet) = when gv-handler owner.vendor game input map port packet
    is Err (e) -> Err e
    is Ok (answer) -> when answer
      is Just (reply) -> Ok (Just (gmb-reply owner.items reply))
      is None -> when cbd-handler owner.combat owner.items game input map port packet
        is Err (e) -> Err e
        is Ok (answer) -> when answer
          is Just (reply) -> Ok (Just (cg-status-names owner game input.session.serial reply))
          is None -> when (when cg-corpse-label owner game packet is Just (r) -> Just r is None -> (when cpl-mint-label game packet is Just (r) -> Just r is None -> tbd-name owner.production.harvest.items packet))
            is Just (named) -> Ok (Just named)
            is None -> when (when cg-stranger-label owner game input.session.serial packet is Just (s) -> Just s is None -> (when rst-label game.world packet is Just (k) -> Just k is None -> (when csm-label game.world packet is Just (m) -> Just m is None -> cg-creature-label owner game input.session.serial packet)))
              is Just (stranger) -> Ok (Just stranger)
              is None -> when cg-npc-paperdoll owner game input.session.serial packet
                is Just (doll) -> Ok (Just doll)
                is None -> when cg-pet-rename owner game input.session.serial packet
                  is Just (renamed) -> Ok (Just renamed)
                  is None -> when cg-map-pin owner game input.session.serial packet
                    is Just (plotted) -> Ok (Just plotted)
                    is None -> when cg-wbook-write owner game input.session.serial packet
                      is Just (written) -> Ok (Just written)
                      is None -> when cg-cards owner game input packet is Just (carded) -> Ok (Just carded) is None -> cg-item-drop owner game input map port packet
 UOAIX-175, ServUO PacketHandlers.RenameRequest: 0x75 carries the creature's serial at 1 and the new name at 5 (30
 bytes). Only the owner of a tamed or summoned creature renames it; the name goes into the creature's combat name,
 which UCB1 saves and the click label and the status bar read. A name keeps 1 to 29 letters, spaces, dashes, periods
 and apostrophes, and does not start with a space.
  cg-pet-rename : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-pet-rename (owner) (game) (viewer) (packet) = if list-length packet /= 35 | list-at packet 0 /= #75 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let slot = world-slot game.world serial
    in if viewer <= 0 | serial == viewer | cg-as-master owner serial /= viewer | slot < 0 | slot >= list-length owner.combat.actors then Just (gsi-denied "You cannot rename this.")
    else let a = list-at owner.combat.actors slot
    in let name = cg-pet-name-bytes packet 5 []
    in if a.serial /= serial | not (cg-pet-name-valid name 0) then Just (gsi-denied "That name is unacceptable.")
    else let written = cg-pet-write a.name name 0
    in when world-get game.world serial
      is Err (_) -> Just (gs-reply [] "pet renamed")
      is Ok (m) -> Just (gs-reply [list-set-at (cbp-status m a.name a.maximum) 41 1] "pet renamed")
  cg-pet-name-bytes : List Integer, Integer, List Integer -> List Integer
  cg-pet-name-bytes (packet) (i) (out) = if i == 35 | list-at packet i == 0 then out else cg-pet-name-bytes packet (i + 1) (list-push out (list-at packet i))
  cg-pet-name-valid : List Integer, Integer -> Boolean
  cg-pet-name-valid (name) (i) = if i == 0 & (list-length name == 0 | list-length name > 29) then False
    else if i == list-length name then True
    else let c = list-at name i
    in if i == 0 & c == 32 then False
    else if (c >= 65 & c <= 90) | (c >= 97 & c <= 122) | c == 32 | c == 45 | c == 46 | c == 39 then cg-pet-name-valid name (i + 1)
    else False
  cg-pet-write : Integer, List Integer, Integer -> Integer
  cg-pet-write (buf) (name) (i) = if i == 30 then 0
    else let a = poke-byte buf i (if i < list-length name then list-at name i else 0) in cg-pet-write buf name (i + 1)
 Source-X send.cpp PacketPaperdoll: a pre-ML client's flags carry only war mode (0x40), so an NPC at peace sends 0.
  cg-npc-paperdoll : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-npc-paperdoll (owner) (game) (viewer) (packet) = if list-length packet /= 5 | list-at packet 0 /= 6 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in if serial == viewer | gsi-slot game serial 0 >= 0 | gsi-account-character game.accounts serial 0 >= 0 then None
    else when world-get game.world serial
      is Err (_) -> None
      is Ok (m) -> if m.kind /= 1 | cb-form m.graphic /= 0 then None
        else Just (gs-reply [list-push (sip-field (gp-put32 (gp-start #88) serial) (text-to-utf8-bytes (cg-npc-label owner viewer serial)) 60 0) 0] "items:npc paperdoll")
  cg-stranger-label : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-stranger-label (owner) (game) (viewer) (packet) = if list-length packet /= 5 | list-at packet 0 /= 9 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let title = cg-stranger-title owner game viewer serial
    in if title == "" then None
    else when world-get game.world serial
      is Err (_) -> None
      is Ok (mobile) -> Just (gs-reply [sip-name-label mobile (text-to-utf8-bytes title)] "items:look stranger")
 The 1.25 client's All Names sends a single click (0x09) for every mobile in view (Damian, 2026-10-09: "all monsters
 should show their names with allnames client function"): a creature no other label answers (a world spawn, a monster,
 a summon) shows its combat name, read from its actor without binding one.
  cg-creature-label : CompositeGame, GameShard, Integer, List Integer -> Maybe GameReply
  cg-creature-label (owner) (game) (viewer) (packet) = if list-length packet /= 5 | list-at packet 0 /= 9 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let slot = world-slot game.world serial
    in if serial == viewer | slot < 0 | slot >= list-length owner.combat.actors | gsi-slot game serial 0 >= 0 | gsi-account-character game.accounts serial 0 >= 0 then None
    else when world-get game.world serial
      is Err (_) -> None
      is Ok (m) -> if m.kind /= 1 then None
        else let a = list-at owner.combat.actors slot
        in let name = if a.serial == serial then cg-name-bytes a.name 0 [] else text-to-utf8-bytes (cb-npc-name m)
        in if list-length name == 0 then None else Just (gs-reply [sip-name-label m name] "items:look creature")
  cg-stranger-title : CompositeGame, GameShard, Integer, Integer -> Text
  cg-stranger-title (owner) (game) (viewer) (serial) = let slot = gsi-slot game serial 0
    in let at = if slot >= 0 then -1 else gsi-account-character game.accounts serial 0
    in let account = if slot >= 0 then ga-bound game.accounts else at / 8
    in let british = if slot >= 0 then ga-is-british game.accounts else account == ga-british game.accounts
    in if serial == viewer | (slot < 0 & at < 0) | british | nn-knows owner.known viewer serial then ""
    else let characters = if slot >= 0 then game.characters else ga-slots game.accounts account
    in nn-profession (cg-best-skill owner characters (if slot >= 0 then slot else int-mod at 8) serial 0 -1 0)
  cg-character-name : GameShard, Integer -> Text
  cg-character-name (game) (serial) = let slot = gsi-slot game serial 0
    in let at = if slot >= 0 then -1 else gsi-account-character game.accounts serial 0
    in if slot >= 0 then utf8-bytes-to-text (sip-slot-name game.characters slot 0 [])
    else if at >= 0 then utf8-bytes-to-text (sip-slot-name (ga-slots game.accounts (at / 8)) (int-mod at 8) 0 []) else ""
  cg-shown-name : CompositeGame, GameShard, Integer, Integer -> Text
  cg-shown-name (owner) (game) (viewer) (serial) = let npc = cg-npc-label owner viewer serial
    in if npc /= "" then npc
    else let title = cg-stranger-title owner game viewer serial
    in if title /= "" then title
    else cg-character-name game serial
  cg-status-names : CompositeGame, GameShard, Integer, GameReply -> GameReply
  cg-status-names (owner) (game) (viewer) (reply) = GameReply { packets = cg-renamed owner game viewer reply.packets 0 [], close = reply.close, note = reply.note }
  cg-renamed : CompositeGame, GameShard, Integer, List (List Integer), Integer, List (List Integer) -> List (List Integer)
  cg-renamed (owner) (game) (viewer) (packets) (i) (out) = if i == list-length packets then out
    else let p = list-at packets i
    in let name = if list-length p == 43 & list-at p 0 == #11 & gp-u32 p 3 /= viewer then cg-shown-name owner game viewer (gp-u32 p 3) else ""
    in cg-renamed owner game viewer packets (i + 1) (list-push out (cg-pet-flag owner viewer (if name == "" then p else cg-put-name p name 0)))
 ProtocolFacts S 11: byte 41 is the rename flag; the 1.25 client lets a player type a new name on the status bar only
 when it is 1, and the server sends it only for the viewer's own pet (UOAIX-175).
  cg-pet-flag : CompositeGame, Integer, List Integer -> List Integer
  cg-pet-flag (owner) (viewer) (p) = if list-length p /= 43 | list-at p 0 /= #11 | viewer <= 0 then p
    else if cg-as-master owner (gp-u32 p 3) /= viewer then p
    else list-set-at p 41 1
  cg-put-name : List Integer, Text, Integer -> List Integer
  cg-put-name (p) (name) (i) = if i == 30 then p
    else let set = list-set-at p (7 + i) (if i < text-length name & i < 29 then to-unicode (char-code (char-at name i)) else 0)
    in cg-put-name p name (i + 1)
  cg-skill-at : CompositeGame, Integer, Integer, Integer, Integer -> Integer
  cg-skill-at (owner) (characters) (row) (serial) (skill) = gs-skill owner.checkpoint.game serial skill
  cg-best-skill : CompositeGame, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cg-best-skill (owner) (characters) (row) (serial) (skill) (best) (value) = if skill == 46 then best
    else let v = cg-skill-at owner characters row serial skill
    in if v > value then cg-best-skill owner characters row serial (skill + 1) skill v
    else cg-best-skill owner characters row serial (skill + 1) best value
 Source-X labels a corpse "corpse of <name>"; the corpse amount holds the body id.
  cg-corpse-label : CompositeGame, GameShard, List Integer -> Maybe GameReply
  cg-corpse-label (owner) (game) (packet) = if list-length packet /= 5 | list-at packet 0 /= 9 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in when world-get game.world serial
      is Err (_) -> None
      is Ok (item) -> if item.kind /= 2 | item.graphic /= #2006 then None
        else let at = cg-corpse-owner owner.combat serial 0
        in let name = if at < 0 then "" else utf8-bytes-to-text (cg-name-bytes (list-at owner.combat.actors at).name 0 [])
        in Just (gs-reply [sip-message serial item.graphic 6 (if name == "" then "a corpse" else "corpse of " & name)] "items:corpse")
  cg-corpse-owner : GameCombat, Integer, Integer -> Integer
  cg-corpse-owner (c) (corpse) (i) = if i == list-length c.actors then -1
    else if (list-at c.actors i).corpse == corpse & (list-at c.actors i).serial /= 0 then i
    else cg-corpse-owner c corpse (i + 1)
  cg-name-bytes : Integer, Integer, List Integer -> List Integer
  cg-name-bytes (buf) (i) (out) = if i == 30 | peek-byte buf i == 0 then out else cg-name-bytes buf (i + 1) (list-push out (peek-byte buf i))

  cg-bind : CompositeGame, GameInput -> Result Integer Text
  cg-bind (owner) (input) = let player = gv-player owner.vendor input.session.serial 0
    in let pack = gsi-pack-find owner.checkpoint.game.world input.session.serial 0
    in if pack == 0 then Err "composite backpack absent"
    else if player >= 0 then let p = list-at owner.vendor.players player
      in let changed = if p.pack == pack then 0 else
        let bound = __record-set p "pack" pack
        in let quote = __record-set p "side" 0
        in let count = __record-set p "count" 0
        in world-item-touch owner.checkpoint.game.world
      in Ok player
    else if not (cg-bind-room owner) then Err "composite player capacity full"
    else let x = owner.vendor.currency
    in let actor = if owner.vendor.player-count == 0 then 1
      else let purse = eu-open x 3 input.session.serial in if purse < 1 then -1 else ep-admit x.world purse 100
    in if actor < 1 then Err "composite player economy admission refused"
    else let added = gv-add-player owner.vendor input.session.serial actor pack
    in if added < 0 then Err "composite vendor player binding failed" else Ok added

 The first player keeps installation actor 1; each later character gets its own kind-3 purse and actor.
  cg-bind-room : CompositeGame -> Boolean
  cg-bind-room (owner) = let x = owner.vendor.currency
    in owner.vendor.player-count == 0 | (owner.vendor.player-count < list-length owner.vendor.players & x.world.actor-count < list-length x.world.actors & eu-room x
      & x.world.money.purse-count < list-length x.world.money.purses & x.copper.purse-count < list-length x.copper.purses
      & x.silver.purse-count < list-length x.silver.purses)

  cg-drop-lots : GvWorld, Integer, Integer -> Integer
  cg-drop-lots (v) (actor) (unused) = cg-drop-from v (ep-lot-first v.currency.world.goods actor)
  cg-drop-from : GvWorld, Integer -> Integer
  cg-drop-from (v) (serial) = if serial == 0 then 0
    else let next = ep-lot-next v.currency.world.goods serial
    in let retired = ep-unlist v.currency.world serial
    in cg-drop-from v next
  cg-lot-remove : GvWorld, Integer -> Integer
  cg-lot-remove (v) (i) = ep-unlist v.currency.world i
  cg-vendor-serial : CompositeGame, Integer -> Boolean
  cg-vendor-serial (owner) (serial) = let at = gv-vendor owner.vendor serial 0
    in let shelved = if at >= 0 then owner.vendor.window at 0 else 0 in at >= 0
 A killed shopkeeper leaves an empty corpse where it fell (its stock is in the shop), waits hidden on its shop's first
 tile and rises there after cg-rise-ms; a boot unhides any still waiting (cg-rise-all), since the wheel is not saved.
  cg-rise-kind : Integer = 11
  cg-rise-ms : Integer = 300000
  cg-vendor-fall : CompositeGame, Integer, Integer, Integer, Integer -> Integer
  cg-vendor-fall (owner) (serial) (x) (y) (z) = let at = gv-vendor owner.vendor serial 0
    in if at < 0 | at >= bb-shop-count then 0
    else when world-get owner.items.world serial
      is Err (_) -> 0
      is Ok (m) -> let shop = list-at bb-shops at
        in let home-z = when owner.town-map is None -> m.z is Just (map) -> (when walk-ground map shop.x1 shop.y1 is Err (_) -> m.z is Ok (g) -> g)
        in let corpse = world-create owner.items.world (WorldObject { serial = 0, kind = 2, x = x, y = y, z = z, graphic = 8198, hue = m.hue, container = 0, amount = m.graphic, health = 0 })
        in let decays = when corpse is Err (_) -> 0 is Ok (made) -> wtm-add owner.timers (owner.timers.limit + 1) cb-corpse-kind made
        in when world-update owner.items.world (__record-set (__record-set (__record-set m "x" shop.x1) "y" shop.y1) "z" home-z)
          is Err (_) -> 0
          is Ok (_) -> let slot = world-slot owner.items.world serial
            in let hidden = if slot < 0 then 0 else poke-byte (sa-at owner.active.concealed slot) 0 3
            in let armed = wtm-add owner.timers (owner.timers.limit + gm-ticks cg-rise-ms) cg-rise-kind serial in 1
  cg-rise : CompositeGame, Integer -> Integer
  cg-rise (owner) (serial) = let slot = world-slot owner.items.world serial
    in if slot < 0 then 0 else if peek-byte (sa-at owner.active.concealed slot) 0 == 3 then poke-byte (sa-at owner.active.concealed slot) 0 0 else 0
  cg-rise-all : CompositeGame, Integer -> Integer
  cg-rise-all (owner) (i) = if i >= min owner.vendor.vendor-count bb-shop-count then 0
    else let risen = cg-rise owner (list-at owner.vendor.vendors i).serial in cg-rise-all owner (i + 1)
 ServUO Corpse.cs (m_DefaultDecayTime) and UOX3 uox.ini NPCCORPSEDECAYTIMER=420: an NPC's corpse decays 7 minutes after
 it is first seen, its contents with it (UOX3 LOOTDECAYSWITHNPCCORPSE=1). A player's corpse (health bit 2, cb-die) decays
 only empty (Damian: "a player's corpse doesn't decay unless it is empty"), on ServUO's 14-minute corpse then bones span.
 Each corpse is a (due, cb-corpse-kind, serial) entry on the wheel: cb-die and a fallen shopkeeper arm it when they
 make it, and a boot arms every corpse in the world (cg-arm-corpses). Its first firing times it from then; a slot's 16
 decay bytes hold the corpse serial it timed and the due tick.
  cg-corpse-ms : Integer = 420000
  cg-player-corpse-ms : Integer = 840000
  cg-corpse-row : Integer, Integer -> Boolean
  cg-corpse-row (at) (serial) = serial > 0 & peek-qword at 0 == serial & peek-qword at 8 == 2 & peek-qword at 40 == 8198 & peek-qword at 56 == 0
  cg-arm-corpses : CompositeGame, Integer -> Integer
  cg-arm-corpses (owner) (s) = let w = owner.items.world
    in if s >= w.capacity then 0
    else let at = wi-object w.buffer s
    in let armed = if cg-corpse-row at (peek-qword at 0) then wtm-add owner.timers (owner.timers.limit + 1) cb-corpse-kind (peek-qword at 0) else 0
    in cg-arm-corpses owner (s + 1)
  cg-decay-again : CompositeGame, Integer, Integer, Integer -> Integer
  cg-decay-again (owner) (s) (serial) (due) = let kept = poke-qword (sa-at owner.decay s) 8 due
    in let armed = wtm-add owner.timers due cb-corpse-kind serial in 0
  cg-decay-fire : CompositeGame, Integer, Integer -> Integer
  cg-decay-fire (owner) (serial) (tick) = let w = owner.items.world
    in let s = if serial <= 0 then -1 else world-slot w serial
    in if s < 0 then 0
    else let at = wi-object w.buffer s
    in if not (cg-corpse-row at serial) then 0
    else if peek-qword (sa-at owner.decay s) 0 /= serial then
      (let a = poke-qword (sa-at owner.decay s) 0 serial
      in cg-decay-again owner s serial (tick + gm-ticks (if bit-and (peek-qword at 72) 2 /= 0 then cg-player-corpse-ms else cg-corpse-ms)))
    else if tick < peek-qword (sa-at owner.decay s) 8 then cg-decay-again owner s serial (peek-qword (sa-at owner.decay s) 8)
    else if bit-and (peek-qword at 72) 2 /= 0 & world-first-child w serial /= 0 then cg-decay-again owner s serial (tick + gm-ticks cg-player-corpse-ms)
    else let cleared = poke-qword (sa-at owner.decay s) 0 0
    in let dead = cg-corpse-owner owner.combat serial 0
    in let n = cg-rot owner serial
    in let noted = cg-rot-note owner serial dead n in n
 UOX3 uox.ini DECAYTIMER=3600 and ServUO Item.DefaultDecayTime: an item a player drops on the ground decays an hour
 after it lands, its contents with it, unless it lies on a granted plot (ServUO keeps what is in a house). British's
 drops do not decay (he decorates). Each ground drop arms a (due, cg-ground-kind, serial) wheel entry and writes the
 serial and that due into the slot's decay bytes, so the entry of an earlier drop fires to nothing. The wheel is not
 saved: an item dropped before a restart stays.
  cg-ground-kind : Integer = 19
  cg-ground-ms : Integer = 3600000
 The tile a drop packet lands on, as x * 65536 + y, for a drop on the ground or onto an item lying there; -1 otherwise.
  cg-ground-spot : CompositeGame, GameShard, Integer, List Integer -> Integer
  cg-ground-spot (owner) (game) (target) (packet) = if ga-is-british game.accounts | list-length packet < 14 then -1
    else if target == #FFFFFFFF | target == 0 then gp-u16 packet 5 * 65536 + gp-u16 packet 7
    else when world-get owner.items.world target
      is Err (_) -> -1
      is Ok (o) -> if o.kind == 2 & o.container == 0 then o.x * 65536 + o.y else -1
  cg-ground-arm : CompositeGame, Integer, Integer -> Integer
  cg-ground-arm (owner) (serial) (spot) = let w = owner.items.world
    in let s = if serial <= 0 then -1 else world-slot w serial
    in if s < 0 then 0
    else let at = wi-object w.buffer s
    in if peek-qword at 0 /= serial | peek-qword at 8 /= 2 | peek-qword at 56 /= 0 | peek-qword at 16 * 65536 + peek-qword at 24 /= spot | cg-corpse-row at serial then 0
    else let due = owner.timers.limit + gm-ticks cg-ground-ms
    in let a = poke-qword (sa-at owner.decay s) 0 serial
    in let b = poke-qword (sa-at owner.decay s) 8 due
    in if wtm-add owner.timers due cg-ground-kind serial < 0 then 0 else 1
  cg-ground-fire : CompositeGame, Integer, Integer -> Integer
  cg-ground-fire (owner) (serial) (tick) = let w = owner.items.world
    in let s = if serial <= 0 then -1 else world-slot w serial
    in if s < 0 then 0
    else if peek-qword (sa-at owner.decay s) 0 /= serial | tick < peek-qword (sa-at owner.decay s) 8 then 0
    else let cleared = poke-qword (sa-at owner.decay s) 0 0
    in let at = wi-object w.buffer s
    in if peek-qword at 0 /= serial | peek-qword at 8 /= 2 | peek-qword at 56 /= 0 | cg-corpse-row at serial then 0
    else if cg-on-plot owner.construction (peek-qword at 16) (peek-qword at 24) 0 then 0
    else cg-rot owner serial
  cg-on-plot : CnState, Integer, Integer, Integer -> Boolean
  cg-on-plot (s) (x) (y) (p) = if p >= cn-plots s then False
    else if cn-plot s p 4 > 0 & cn-in-plot s p x y then True else cg-on-plot s x y (p + 1)
 The admin page's corpse decays, newest 256: cell 0 counts every decay, then 64-byte rows of the economy hour, the corpse,
 the dead's serial, the objects removed and the dead's name (30 bytes at 32). Memory only.
  cg-rot-rows : Integer = 256
  cg-rot-note : CompositeGame, Integer, Integer, Integer -> Integer
  cg-rot-note (owner) (serial) (at) (objects) = let n = peek-qword owner.rot-log 0
    in let row = owner.rot-log + 8 + int-mod n cg-rot-rows * 64
    in let a = poke-qword row 0 owner.vendor.currency.world.hour
    in let b = poke-qword row 8 serial
    in let c = poke-qword row 16 (if at < 0 then 0 else (list-at owner.combat.actors at).serial)
    in let d = poke-qword row 24 objects
    in let e = cg-rot-name row (if at < 0 then 0 else (list-at owner.combat.actors at).name) 0
    in let f = poke-qword owner.rot-log 0 (n + 1) in 0
 The death log, newest cg-death-rows: cell 0 counts every death noted, cell 8 how many cs-reports has printed, then
 64-byte rows of the economy hour, the dead, the killer (-1: a worker found dead or gone at its step, outside combat),
 the dead's body, the killer's body, x, y and the dead's role (cg-death-role). Memory only.
  cg-death-rows : Integer = 64
  cg-death-note : CompositeGame, Integer, Integer, Integer -> Integer
  cg-death-note (owner) (killer) (victim) (role) = let world = owner.checkpoint.game.world
    in let n = peek-qword owner.death-log 0
    in let row = owner.death-log + 16 + int-mod n cg-death-rows * 64
    in let a = poke-qword row 0 owner.vendor.currency.world.hour
    in let b = poke-qword row 8 victim
    in let c = poke-qword row 16 killer
    in let d = when world-get world victim
      is Err (_) -> poke-qword row 24 0 + poke-qword row 40 0 + poke-qword row 48 0
      is Ok (m) -> poke-qword row 24 m.graphic + poke-qword row 40 m.x + poke-qword row 48 m.y
    in let e = poke-qword row 32 (if killer <= 0 then 0 else when world-get world killer is Err (_) -> 0 is Ok (k) -> k.graphic)
    in let f = poke-qword row 56 role
    in let g = poke-qword owner.death-log 0 (n + 1) in 0
 1 the economy gatherer, 2 the farmer, 3 a player, 4 a shopkeeper, 10 + k the k-th miner-list worker, 0 any other.
 A town worker (the economy gatherer, the farmer, a miner-list worker) is no wild creature's target (root for Damian,
 2026-10-09: an earth elemental in the Britain mine killed the workers there 13 times in two hours and none mined).
  cg-town-worker : CompositeGame, Integer -> Boolean
  cg-town-worker (owner) (serial) = if serial == 0 then False else let role = cg-death-role owner serial in role == 1 | role == 2 | role >= 10
  cg-death-role : CompositeGame, Integer -> Integer
  cg-death-role (owner) (serial) = if (when owner.gatherer is None -> False is Just (c) -> c.serial == serial) then 1
    else if (when owner.farmer is None -> False is Just (c) -> c.serial == serial) then 2
    else let k = cg-death-miner owner.miners serial 0
    in if k >= 0 then 10 + k
    else if gv-player owner.vendor serial 0 >= 0 then 3
    else if gv-vendor owner.vendor serial 0 >= 0 then 4 else 0
  cg-death-miner : List CgGatherer, Integer, Integer -> Integer
  cg-death-miner (workers) (serial) (i) = if i >= list-length workers then -1
    else if (list-at workers i).serial == serial then i else cg-death-miner workers serial (i + 1)
  cg-rot-name : Integer, Integer, Integer -> Integer
  cg-rot-name (row) (name) (i) = if i == 30 then 0
    else let a = poke-byte row (32 + i) (if name == 0 then 0 else peek-byte name i) in cg-rot-name row name (i + 1)
 A corpse made before cb-die marked players' carries no bit 2; at boot one with a human body (400, 401) and contents is
 taken for a player's, so no player's gear decays.
 The world and every per-slot table grow together by one world-grow (UoaixDynamicTables.md, stage 2d step 3); the
 caller keeps the heap (the post-compaction growth point). Every holder of the world must share the one table record.
  cg-grow-due : CompositeGame -> Boolean
  cg-grow-due (owner) = cg-world-due owner | cg-actors-due owner | cg-network-due owner | ep-trades-due owner.vendor.currency.world | wtm-tight owner.timers | cg-purses-due owner | cg-stations-due owner | cg-nodes-due owner | cg-loans-due owner | eu-start-short owner.vendor.currency | gv-tables-due owner.vendor | ga-due owner.checkpoint.game.accounts | (when owner.civic is None -> False is Just (c) -> lw-due c.law) | cg-gov-due owner | cg-town-due owner | list-length owner.production.harvest.sites - owner.production.harvest.count < ghc-block / 4 | (when owner.spawns is None -> False is Just (g) -> gws-due g) | cn-due owner.construction | hp-due owner.pages | bbs-due owner.bbs | dc-due owner.decor | mpn-due owner.pins | wbk-due owner.books | hs-due owner.housing | cg-cast-due owner | cg-trades-due owner
 The census grows a block at a time; the government's per-person and per-actor cells and its sites follow their tables.
  cg-town-due : CompositeGame -> Boolean
  cg-town-due (owner) = let w = owner.checkpoint.state.townsfolk
    in list-length w.people - w.used < tf-people-block / 4 | (when owner.gov is None -> False is Just (s) -> tw-fit-due s.works)
  cg-town-grow : CompositeGame -> Integer
  cg-town-grow (owner) = let s = owner.checkpoint.state
    in let a = if list-length s.townsfolk.people - s.townsfolk.used < tf-people-block / 4 then tf-grow-people s.townsfolk tf-people-block else 0
    in let b = tm-grow-personas s.mind (list-length s.townsfolk.people)
    in when owner.gov is None -> 0 is Just (g) -> tw-fit g.works
 Works orders, bounties, dispute cases and dispute events grow a block at a time (UoaixDynamicTables.md stage 6).
  cg-gov-due : CompositeGame -> Boolean
  cg-gov-due (owner) = when owner.gov
    is None -> False
    is Just (s) -> list-length s.works.orders - s.works.order-count < 32 | list-length s.works.bounties - s.works.bounty-count < 32
      | list-length s.disputes.cases - s.disputes.used < 32 | list-length s.disputes.events - s.disputes.count < 64
      | list-length s.disputes.registry.titles - s.disputes.registry.used < 32
      | list-length s.government.events - s.government.event-count < tg-event-limit / 8 | list-length s.government.guards - s.government.guard-count < 16
      | tg-stamps-due s.government
  cg-gov-grow : CompositeGame -> Integer
  cg-gov-grow (owner) = when owner.gov
    is None -> 0
    is Just (s) -> let a = if list-length s.works.orders - s.works.order-count < 32 then __record-set s.works "orders" (tw-orders 0 s.works.orders) else s.works
      in let b = if list-length s.works.bounties - s.works.bounty-count < 32 then __record-set s.works "bounties" (tw-bounties 0 s.works.bounties) else s.works
      in let c = if list-length s.disputes.cases - s.disputes.used < 32 then __record-set s.disputes "cases" (td-cases 0 s.disputes.cases) else s.disputes
      in let d = if list-length s.disputes.events - s.disputes.count < 64 then __record-set s.disputes "events" (td-events 0 s.disputes.events) else s.disputes
      in let e = if list-length s.disputes.registry.titles - s.disputes.registry.used < 32 then __record-set s.disputes.registry "titles" (tr-titles 0 s.disputes.registry.titles) else s.disputes.registry
      in let f = if list-length s.government.events - s.government.event-count < tg-event-limit / 8 then __record-set s.government "events" (tg-events 0 s.government.events) else s.government
      in let g = if list-length s.government.guards - s.government.guard-count < 16 then __record-set s.government "guards" (tg-guards 0 s.government.guards) else s.government
      in let h = tg-fit-stamps s.government (list-length s.government.economy.money.purses)
      in 1
 The account overflow moves when it grows, so the bound account's working slots are pointed at again.
  cg-grow-accounts : CompositeGame -> Integer
  cg-grow-accounts (owner) = let game = owner.checkpoint.game
    in let grown = ga-grow game.accounts ga-capacity
    in let a = __record-set game "characters" (ga-working game.accounts)
    in let b = __record-set owner.vendor.game "characters" (ga-working game.accounts) in grown
  cg-network-due : CompositeGame -> Boolean
  cg-network-due (owner) = when owner.network is None -> False is Just (n) -> tnlc-offers-due n.actions
  cg-network-grow : CompositeGame -> Integer
  cg-network-grow (owner) = when owner.network is None -> 0 is Just (n) -> tnlc-grow-offers n.actions (list-length n.actions.book.offers + 256)
  cg-loans-due : CompositeGame -> Boolean
  cg-loans-due (owner) = let x = owner.vendor.currency in cg-loans-tight x.world.money | cg-loans-tight x.copper | cg-loans-tight x.silver
  cg-loans-tight : EmMoney -> Boolean
  cg-loans-tight (m) = list-length m.loans - m.loan-count < em-loan-block / 4
  cg-stations-due : CompositeGame -> Boolean
  cg-stations-due (owner) = let w = owner.vendor.currency.world in list-length w.stations - w.station-count < ep-station-limit / 4
  cg-nodes-due : CompositeGame -> Boolean
  cg-nodes-due (owner) = let w = owner.vendor.currency.world in list-length w.nodes < ep-node-ceiling & list-length w.nodes - w.node-count < ep-node-limit / 4
  cg-purses-due : CompositeGame -> Boolean
  cg-purses-due (owner) = let m = owner.vendor.currency.world.money in list-length m.purses - m.purse-count < em-purse-block / 4
  cg-world-due : CompositeGame -> Boolean
  cg-world-due (owner) = let w = owner.items.world
    in w.capacity < world-max-objects & (w.capacity - world-count w < 256 | peek-qword w.buffer 8 < 0)
 The economy's actor table grows a block once fewer than a quarter block of rows are free (stage 4).
  cg-actors-due : CompositeGame -> Boolean
  cg-actors-due (owner) = let w = owner.vendor.currency.world in list-length w.actors - w.actor-count < ep-actor-block / 4
  cg-grow : CompositeGame -> Result Integer Text
  cg-grow (owner) = when world-grow owner.items.world
    is Err (e) -> Err e
    is Ok (capacity) -> let a = cb-grow owner.combat capacity
      in let b = gsi-grow owner.items capacity
      in let c = when owner.magic is None -> 0 is Just (m) -> mgs-grow m capacity
      in let d = as-grow owner.active capacity
      in let e = gcv-grow owner.view capacity
      in let f = sa-grow owner.decay capacity
      in let goods = ep-grow-goods owner.vendor.currency.world.goods capacity
      in if owner.checkpoint.game.world.capacity /= capacity | owner.vendor.game.world.capacity /= capacity then Err "world grown under a second table record"
      else Ok capacity
 Every per-link viewer table holds a row for each of the server's n game links, fitted once at boot.
  cg-fit-links : CompositeGame, Integer -> Integer
  cg-fit-links (owner) (n) = let a = when owner.gates is None -> 0 is Just (g) -> (let k = n - list-length g.viewers in if k <= 0 then 0 else let s = __record-set g "viewers" (gmg-viewers (gmg-viewer-limit - k) g.viewers) in k)
    in let b = when owner.town is None -> 0 is Just (t) -> (let k = n - list-length t.viewers in if k <= 0 then 0 else let s = __record-set t "viewers" (tl-viewers (tl-viewer-limit - k) t.viewers) in k)
    in let c = when owner.decoration is None -> 0 is Just (d) -> (let k = n - list-length d.viewers in if k <= 0 then 0 else let s = __record-set d "viewers" (wd-viewers d.count k d.viewers) in k)
    in let e = when owner.flora is None -> 0 is Just (f) -> (let k = n - list-length f.viewers in if k <= 0 then 0 else let s = __record-set f "viewers" (wf-viewers f.count k f.viewers) in k)
    in let g = when owner.shops is None -> 0 is Just (s) -> (let k = n - list-length s.views in if k <= 0 then 0 else let v = __record-set s "views" (bb-views (bb-view-limit - k) s.views) in k)
    in let h = (let r = owner.resurrection in let k = n - list-length r.views in if k <= 0 then 0 else let v = __record-set r "views" (gr-views (gr-view-limit - k) r.views) in k)
    in let i = (let k = n - list-length owner.combat.seen in if k <= 0 then 0 else let v = __record-set owner.combat "seen" (cb-seen-new k owner.combat.seen) in k)
    in let j = when owner.speech is None -> 0 is Just (s) -> (let k = n - list-length s.rooms in if k <= 0 then 0 else let v = __record-set s "rooms" (ns-rooms (ns-room-limit - k) s.rooms) in k)
    in let l = (let k = n - list-length owner.monsters.links in if k <= 0 then 0 else let v = __record-set owner.monsters "links" (gm-links k owner.monsters.links) in k)
    in let m = when owner.spawns is None -> 0 is Just (s) -> gws-fit-links s owner.checkpoint.game.world n
    in n
  cg-mark-corpses : CompositeGame, Integer -> Integer
  cg-mark-corpses (owner) (s) = let w = owner.items.world
    in if s >= w.capacity then 0
    else let at = wi-object w.buffer s
    in let serial = peek-qword at 0
    in let body = peek-qword at 64
    in let marked = if serial <= 0 | peek-qword at 8 /= 2 | peek-qword at 40 /= 8198 | peek-qword at 56 /= 0
      | bit-and (peek-qword at 72) 2 /= 0 | (body /= 400 & body /= 401) | world-first-child w serial == 0 then 0
      else when world-get w serial is Err (_) -> 0 is Ok (o) -> when world-update w (__record-set o "health" (bit-or o.health 2)) is Err (_) -> 0 is Ok (_) -> 1
    in cg-mark-corpses owner (s + 1)
  cg-rot : CompositeGame, Integer -> Integer
  cg-rot (owner) (serial) = when world-get owner.items.world serial
    is Err (_) -> 0
    is Ok (corpse) -> when cg-rot-tree owner.vendor owner.items.world serial 64
      is Err (_) -> 0
      is Ok (n) -> let told = cb-notice owner.combat corpse 0 0 0 [cbp-remove serial] 0
        in let touched = world-item-touch owner.items.world in n
  cg-rot-tree : GvWorld, WorldTable, Integer, Integer -> Result Integer Text
  cg-rot-tree (v) (world) (serial) (depth) = if depth == 0 then Err "corpse depth"
    else let child = world-first-child world serial
    in if child /= 0 then when cg-rot-tree v world child (depth - 1)
      is Err (e) -> Err e
      is Ok (n) -> when cg-rot-tree v world serial depth
        is Err (e) -> Err e
        is Ok (m) -> Ok (n + m)
    else let at = gv-lot v serial 0
    in let retired = if at < 0 then 0 else ep-forget-lot v.currency.world at
    in when world-delete world serial
      is Err (e) -> Err e
      is Ok (_) -> Ok 1
  cg-restack : CompositeGame, Integer, Integer -> Integer
  cg-restack (owner) (unused) (n) = cg-restack-from owner (ep-lots-first owner.vendor.currency.world.goods) n
  cg-restack-from : CompositeGame, Integer, Integer -> Integer
  cg-restack-from (owner) (serial) (n) = if serial == 0 then n
    else let l = ep-lot owner.vendor.currency.world.goods serial
    in let stale = gvb-resource owner.vendor.currency.world.catalog l.item 0 & gsi-known owner.items l.serial
      & not (gsi-meta owner.items l.serial).stackable & (gsi-meta owner.items l.serial).layer == 0 & (gsi-meta owner.items l.serial).gump == 0
    in let fixed = if stale then gsi-register owner.items l.serial 0 0 (gsi-meta owner.items l.serial).movable True else 0
    in cg-restack-from owner (ep-lot-after owner.vendor.currency.world.goods serial) (if stale then n + 1 else n)
 UOAIX-105: ore saved before ore took its metal's hue is hued at load from its lot's item.
  cg-ore-hue : CompositeGame, Integer, Integer -> Integer
  cg-ore-hue (owner) (unused) (n) = cg-ore-hue-from owner (ep-lots-first owner.vendor.currency.world.goods) n
  cg-ore-hue-from : CompositeGame, Integer, Integer -> Integer
  cg-ore-hue-from (owner) (serial) (n) = if serial == 0 then n
    else let l = ep-lot owner.vendor.currency.world.goods serial
    in let hue = item-ore-hue l.item
    in let fixed = if hue == 0 then 0 else when world-get owner.items.world l.serial
      is Err (_) -> 0
      is Ok (o) -> if o.graphic < #19B7 | o.graphic > #19BA | o.hue /= 0 then 0
        else when world-update owner.items.world (__record-set o "hue" hue) is Err (_) -> 0 is Ok (_) -> 1
    in cg-ore-hue-from owner (ep-lot-after owner.vendor.currency.world.goods serial) (n + fixed)
  cg-ingot-art : CompositeGame, Integer, Integer -> Integer
  cg-ingot-art (owner) (unused) (n) = cg-ingot-art-from owner (ep-lots-first owner.vendor.currency.world.goods) n
  cg-ingot-art-from : CompositeGame, Integer, Integer -> Integer
  cg-ingot-art-from (owner) (serial) (n) = if serial == 0 then n
    else let l = ep-lot owner.vendor.currency.world.goods serial
    in let art = item-ingot-art l.item
    in let fixed = if art == 0 | art == #1BF2 then 0 else when world-get owner.items.world l.serial
      is Err (_) -> 0
      is Ok (o) -> if o.graphic /= #1BF2 then 0
        else when world-update owner.items.world (__record-set o "graphic" art) is Err (_) -> 0 is Ok (_) -> 1
    in cg-ingot-art-from owner (ep-lot-after owner.vendor.currency.world.goods serial) (n + fixed)
  cg-lot-alike : EpLot, EpLot -> Boolean
  cg-lot-alike (a) (b) = a.actor == b.actor & a.item == b.item
  cg-lot-stack-ok : CompositeGame, GameShard, Integer, Integer -> Boolean
  cg-lot-stack-ok (owner) (game) (item) (target) = if target == 0 | target == #FFFFFFFF | target == item then True
    else when world-get game.world target
      is Err (_) -> True
      is Ok (obj) -> if obj.kind /= 2 | not (gsi-known owner.items target) then True
        else if (gsi-meta owner.items target).gump > 0 then True
        else let src = gv-lot owner.vendor item 0
        in let tgt = gv-lot owner.vendor target 0
        in if src < 0 & tgt < 0 then True
        else if src < 0 | tgt < 0 then False
        else cg-lot-alike (ep-lot owner.vendor.currency.world.goods src) (ep-lot owner.vendor.currency.world.goods tgt)
  cg-lot-into : GvWorld, Integer, Integer, Integer -> Integer
  cg-lot-into (v) (src) (tgt) (moved) = ep-join v.currency.world src tgt moved
  cg-lot-split : GvWorld, Integer, Integer, WorldObject -> Integer
  cg-lot-split (v) (src) (head) (obj) = ep-split v.currency.world src head obj.graphic
  cg-lot-follow : GvWorld, Integer, Integer, Integer, Integer -> Integer
  cg-lot-follow (v) (src) (head) (target) (before) = if src < 0 then 0
    else let l = ep-lot v.currency.world.goods src
    in let tgt = gv-lot v target 0
    in when world-get v.game.world l.serial
      is Err (_) -> if tgt >= 0 & tgt /= src then cg-lot-into v src tgt before else cg-lot-remove v src
      is Ok (obj) -> if obj.amount >= before then 0
        else if tgt >= 0 & tgt /= src then cg-lot-into v src tgt (before - obj.amount)
        else cg-lot-split v src head obj
 A lot follows possession: a player who lifts a lot's pile off the ground takes the lot (ep-hand), so what a player
 picks up is that player's to eat, use or sell.
  cg-lot-claim : CompositeGame, Integer, Integer -> Integer
  cg-lot-claim (owner) (serial) (player) = let v = owner.vendor
    in let at = gv-lot v serial 0
    in let p = gv-player v player 0
    in if at < 0 | p < 0 then 0
    else let l = ep-lot v.currency.world.goods at
    in let actor = (list-at v.players p).actor
    in if l.actor == actor then 0
    else let handed = ep-hand v.currency.world at actor (ep-amount v.currency.world.goods l.serial) l.serial (0 - 1)
    in let invalidated = gh-invalidate-quotes v 0 in handed
  cg-lift : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-lift (owner) (game) (input) (map) (port) (packet) = let item = gp-u32 packet 1
    in let origin = when world-get game.world item is Err (_) -> -1 is Ok (o) -> o.container
    in when gsi-handle owner.items game input map port packet
      is Err (e) -> Err e
      is Ok (answer) -> let slot = gsi-slot game input.session.serial 0
        in let held = slot >= 0 & (gsi-session owner.items game input slot).holding == item
        in let claimed = if held & origin == 0 then cg-lot-claim owner item input.session.serial else 0
        in let boxed = held & origin /= 0 & (cg-trade-boxed owner origin)
        in if not boxed then Ok answer
        else let told = cg-trade-changed owner game input.session.serial item True
        in Ok (when answer is None -> Just (gs-reply told "trade:lift") is Just (r) -> Just (GameReply { packets = r.packets & told, close = r.close, note = r.note }))
 UO secure trade (0x6F; RunUO SecureTrade, DisplaySecureTrade, UpdateSecureTrade, CloseSecureTrade): an item dropped on a
 player within 2 tiles opens a trade box (art 0x1E5E, container gump 0x3C) in each pack and the trade window on both
 clients; a box's owner fills it, any change clears both checks, and when both check accept the boxes' contents swap
 packs at once, each lot following its item, and the swap is logged on the server (the reply note, CompositeStore).
  cg-trade-box : Integer = #1E5E
  cg-trade-player : CompositeGame, GameShard, Integer, Integer -> Boolean
  cg-trade-player (owner) (game) (me) (target) = target /= me & target /= 0 & gv-player owner.vendor target 0 >= 0
    & (when world-get game.world target is Err (_) -> False is Ok (m) -> m.kind == 1)
  cg-trade-name : Text -> List Integer
  cg-trade-name (name) = let b = bbs-bytes name 0 29 [] in gp-zeros b (30 - list-length b)
  cg-trade-show : Integer, Integer, Integer, Text -> List Integer
  cg-trade-show (them) (mine) (theirs) (name) = (list-push (gp-put32 (gp-put32 (gp-put32 [#6F, 0, 47, 0] them) mine) theirs) 1) & cg-trade-name name
  cg-trade-check : Integer, Integer, Integer -> List Integer
  cg-trade-check (box) (one) (two) = gp-put32 (gp-put32 (gp-put32 [#6F, 0, 17, 2] box) one) two
  cg-trade-close : Integer -> List Integer
  cg-trade-close (box) = gp-put32 [#6F, 0, 8, 1] box
  cg-tell : CompositeGame, Integer, List (List Integer), Integer -> Integer
  cg-tell (owner) (serial) (packets) (i) = if i >= list-length packets then 0
    else let told = owner.combat.notice-hook 0 0 0 0 serial (list-at packets i) in cg-tell owner serial packets (i + 1)
  cg-trade-mine : CgSwap, Integer -> Integer
  cg-trade-mine (t) (me) = if me == t.a then t.box-a else t.box-b
  cg-trade-other : CgSwap, Integer -> Integer
  cg-trade-other (t) (me) = if me == t.a then t.b else t.a
  cg-trade-shown : GameShard, Integer, Integer -> List Integer
  cg-trade-shown (game) (box) (mobile) = when world-get game.world box is Err (_) -> [] is Ok (o) -> sip-item (__record-set o "container" mobile)
 Any change clears both checks; the other party sees the item enter or leave the box.
  cg-trade-changed : CompositeGame, GameShard, Integer, Integer, Boolean -> List (List Integer)
  cg-trade-changed (owner) (game) (me) (item) (removed) = let t = cg-trade-of owner me
    in let mine = cg-trade-mine t me
    in let other = cg-trade-other t me
    in let seen = if removed then [sip-remove item] else when world-get game.world item
      is Err (_) -> []
      is Ok (o) -> if o.container /= mine then [] else [sip-item o]
    in if not removed & list-length seen == 0 then []
    else let a = __record-set t "ok-a" 0 in let b = __record-set t "ok-b" 0
    in let skip = if removed then item else 0
    in let told = cg-tell owner other (seen & [cg-trade-check (cg-trade-mine t other) 0 0, cg-trade-note owner game other skip]) 0
    in [cg-trade-check mine 0 0, cg-trade-note owner game me skip]
 The 1.25 trade window has no coin field: coin travels as copper (0x0EEA), silver (0x0EF0) and gold (0x0EED) piles in a
 box, so after every change each party is told both offers' piles and coin value, and a swap ends in a receipt gump.
 A walk counts the coin in a box four containers deep, as copper, silver and gold, leaving out a lifted pile (skip).
  cg-trade-coin : GameShard, Integer, Integer, Integer, List Integer -> List Integer
  cg-trade-coin (game) (serial) (depth) (skip) (acc) = if serial == 0 | depth == 0 then acc
    else let next = world-next-sibling game.world serial
    in let here = if serial == skip then acc else when world-get game.world serial
      is Err (_) -> acc
      is Ok (o) -> let m = as-coin-metal o.graphic
        in let added = if m == 0 then acc else [list-at acc 0 + (if m == 1 then o.amount else 0), list-at acc 1 + (if m == 2 then o.amount else 0), list-at acc 2 + (if m == 3 then o.amount else 0)]
        in if world-child-count game.world serial > 0 then cg-trade-coin game (world-first-child game.world serial) (depth - 1) skip added else added
    in cg-trade-coin game next depth skip here
  cg-trade-piles : GameShard, Integer, Integer, Integer -> Integer
  cg-trade-piles (game) (serial) (skip) (n) = if serial == 0 then n else cg-trade-piles game (world-next-sibling game.world serial) skip (if serial == skip then n else n + 1)
  cg-coin-value : EuCurrency, List Integer -> Integer
  cg-coin-value (x) (coin) = let cr = x.copper-rate in let sr = x.silver-rate
    in list-at coin 0 + list-at coin 1 * (if sr < 1 | sr > cr then cr else cr / sr) + list-at coin 2 * cr
  cg-trade-offer : CompositeGame, GameShard, Integer, Integer -> Text
  cg-trade-offer (owner) (game) (box) (skip) = let x = owner.vendor.currency
    in let coin = cg-trade-coin game (world-first-child game.world box) 4 skip [0, 0, 0]
    in let n = cg-trade-piles game (world-first-child game.world box) skip 0
    in show n & (if n == 1 then " pile" else " piles") & ", coin " & gv-coin-text (list-at coin 0) (list-at coin 1) (list-at coin 2)
      & " (" & gvp-coins (cg-coin-value x coin) x.copper-rate x.silver-rate & ")"
  cg-trade-note : CompositeGame, GameShard, Integer, Integer -> List Integer
  cg-trade-note (owner) (game) (me) (skip) = let t = cg-trade-of owner me
    in sip-message #FFFFFFFF #FFFF 6 ("Trade: you offer " & cg-trade-offer owner game (cg-trade-mine t me) skip
      & "; you get " & cg-trade-offer owner game (cg-trade-mine t (cg-trade-other t me)) skip & ".")
 The receipt gump after a swap: what each party gave and got, then the coin given, the coin got and the net value.
  cg-trade-receipt : CompositeGame, Integer, Text, List Text, List Text, List Integer, List Integer -> List Integer
  cg-trade-receipt (owner) (me) (them) (gave) (got) (coin-gave) (coin-got) = let x = owner.vendor.currency
    in let cr = x.copper-rate in let sr = x.silver-rate
    in let net = cg-coin-value x coin-got - cg-coin-value x coin-gave
    in let rows = ["Trade with " & them, "You gave:"] & (if list-length gave == 0 then ["  nothing"] else cg-indent gave 0 []) & ["You received:"]
      & (if list-length got == 0 then ["  nothing"] else cg-indent got 0 [])
      & ["--------------------------------------------",
        "Coin given: " & gv-coin-text (list-at coin-gave 0) (list-at coin-gave 1) (list-at coin-gave 2) & " (" & gvp-coins (cg-coin-value x coin-gave) cr sr & ")",
        "Coin received: " & gv-coin-text (list-at coin-got 0) (list-at coin-got 1) (list-at coin-got 2) & " (" & gvp-coins (cg-coin-value x coin-got) cr sr & ")",
        "Net coin: " & (if net < 0 then "-" & gvp-coins (0 - net) cr sr else "+" & gvp-coins net cr sr)]
    in gvp-text-gump me gvp-receipt-id 520 rows
  cg-indent : List Text, Integer, List Text -> List Text
  cg-indent (xs) (i) (out) = if i >= list-length xs | i >= 24 then out else cg-indent xs (i + 1) (list-push out ("  " & list-at xs i))
  cg-trade-open : CompositeGame, GameShard, Integer, Integer -> Integer
  cg-trade-open (owner) (game) (a) (b) = let free = cg-trade-free owner.trades 0
    in let pa = gsi-pack-find game.world a 0
    in let pb = gsi-pack-find game.world b 0
    in if free < 0 | pa == 0 | pb == 0 then 0
    else when world-create game.world (gs-item pa cg-trade-box 0)
      is Err (_) -> 0
      is Ok (ba) -> when world-create game.world (gs-item pb cg-trade-box 0)
        is Err (_) -> let gone = world-delete game.world ba in 0
        is Ok (bb) -> let ra = gsi-register owner.items ba 0 #003C False False
          in let rb = gsi-register owner.items bb 0 #003C False False
          in let t = list-at owner.trades free
          in let f0 = __record-set t "a" a in let f1 = __record-set t "b" b
          in let f2 = __record-set t "box-a" ba in let f3 = __record-set t "box-b" bb
          in let f4 = __record-set t "ok-a" 0 in let f5 = __record-set t "ok-b" 0
          in let touched = world-touch game.world in 1
  cg-trade-near : GameShard, Integer, Integer -> Boolean
  cg-trade-near (game) (a) (b) = when world-get game.world a
    is Err (_) -> False
    is Ok (one) -> when world-get game.world b
      is Err (_) -> False
      is Ok (two) -> walk-abs (one.x - two.x) <= 2 & walk-abs (one.y - two.y) <= 2
 Trades are a table, one row per pair, any number at once, grown a block at a time at the growth point like every
 dynamic table (L-SCALE; a row allocated in play would dangle after a compaction, L-BELOWMARK). Only a pair's own 0x6F
 ended its trade, so a row left open (a player disconnected or walked off without closing it) kept that player from
 trading again (UOAIX-206): a disconnect ends its player's trade (cg-trade-depart, from cs-disconnect), and a trade
 whose players stand out of reach of each other is ended when either of them asks to trade with someone else.
  cg-trade-grow-by : Integer = 16
  cg-trade-empty : Integer -> CgSwap
  cg-trade-empty (unused) = CgSwap { a = 0, b = 0, box-a = 0, box-b = 0, ok-a = 0, ok-b = 0 }
  cg-trade-block : Integer, List CgSwap -> List CgSwap
  cg-trade-block (n) (out) = if n <= 0 then out else cg-trade-block (n - 1) (list-push out (cg-trade-empty 0))
  cg-trade-find : List CgSwap, Integer, Integer -> Integer
  cg-trade-find (ts) (serial) (i) = if serial == 0 | i >= list-length ts then -1
    else let t = list-at ts i in if t.a /= 0 & (t.a == serial | t.b == serial) then i else cg-trade-find ts serial (i + 1)
  cg-trade-free : List CgSwap, Integer -> Integer
  cg-trade-free (ts) (i) = if i >= list-length ts then -1 else if (list-at ts i).a == 0 then i else cg-trade-free ts (i + 1)
  cg-trade-free-count : List CgSwap, Integer, Integer -> Integer
  cg-trade-free-count (ts) (i) (n) = if i >= list-length ts then n else cg-trade-free-count ts (i + 1) (if (list-at ts i).a == 0 then n + 1 else n)
  cg-trade-box-find : List CgSwap, Integer, Integer -> Integer
  cg-trade-box-find (ts) (box) (i) = if box == 0 | i >= list-length ts then -1
    else let t = list-at ts i in if t.a /= 0 & (t.box-a == box | t.box-b == box) then i else cg-trade-box-find ts box (i + 1)
  cg-trade-boxed : CompositeGame, Integer -> Boolean
  cg-trade-boxed (owner) (box) = cg-trade-box-find owner.trades box 0 >= 0
  cg-trade-of : CompositeGame, Integer -> CgSwap
  cg-trade-of (owner) (serial) = let i = cg-trade-find owner.trades serial 0 in if i < 0 then cg-trade-empty 0 else list-at owner.trades i
  cg-trades-due : CompositeGame -> Boolean
  cg-trades-due (owner) = cg-trade-free-count owner.trades 0 0 < cg-trade-grow-by / 4
  cg-trades-grow : CompositeGame -> Integer
  cg-trades-grow (owner) = let grown = __record-set owner "trades" (owner.trades & cg-trade-block cg-trade-grow-by []) in list-length owner.trades
  cg-trade-party : Integer, Integer, Integer -> Boolean
  cg-trade-party (a) (b) (serial) = serial > 0 & a /= 0 & (a == serial | b == serial)
  cg-trade-stale : Integer, Boolean, Boolean -> Boolean
  cg-trade-stale (a) (pair) (near) = a /= 0 & not pair & not near
  cg-trade-depart : CompositeGame, GameShard, Integer -> Integer
  cg-trade-depart (owner) (game) (serial) = let t = cg-trade-of owner serial in if not (cg-trade-party t.a t.b serial) then 0
    else let ended = cg-trade-end owner game t False in 1
  cg-trade-unstick : CompositeGame, GameShard, CgSwap, Boolean -> Integer
  cg-trade-unstick (owner) (game) (t) (pair) = if cg-trade-stale t.a pair (t.a == 0 | cg-trade-near game t.a t.b) then let ended = cg-trade-end owner game t False in 1 else 0
  cg-trade-give : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer, Integer -> Result (Maybe GameReply) Text
  cg-trade-give (owner) (game) (input) (map) (port) (item) (target) = let me = input.session.serial
    in let t = cg-trade-of owner me
    in let u = cg-trade-of owner target
    in let slot = gsi-slot game me 0
    in let pair = t.a /= 0 & ((t.a == me & t.b == target) | (t.a == target & t.b == me))
    in let cleared = cg-trade-unstick owner game t pair + cg-trade-unstick owner game u pair
    in let refuse = \text -> Ok (Just (gs-reply ((if slot < 0 then [] else (gsi-bounce owner.items (gsi-session owner.items game input slot) 5).packets) & [sip-message #FFFFFFFF #FFFF 6 text]) "trade:refused"))
    in if not (cg-trade-near game me target) then refuse "That is too far away."
    else if t.a /= 0 & not pair then refuse "You are already trading."
    else if u.a /= 0 & not pair then refuse "They are already trading."
    else let opened = if pair then 0 else cg-trade-open owner game me target
    in let now = cg-trade-of owner me
    in if now.a == 0 then refuse "You cannot trade right now."
    else let mine = cg-trade-mine now me
    in let theirs = cg-trade-mine now target
    in let moved = gp-put32 ((gp-put16 (gp-put16 (gp-put32 [8] item) 20) 20) & [0]) mine
    in when gsi-handle owner.items game input map port moved
      is Err (e) -> Err e
      is Ok (answer) -> let fresh = if opened == 0 then []
          else let me-name = as-mobile-name owner.active game me
          in let them-name = as-mobile-name owner.active game target
          in let told = cg-tell owner target [cg-trade-shown game theirs target, cg-trade-shown game mine me, cg-trade-show me theirs mine me-name, cg-trade-check theirs 0 0] 0
          in [cg-trade-shown game mine me, cg-trade-shown game theirs target, cg-trade-show target mine theirs them-name, cg-trade-check mine 0 0]
        in let changed = cg-trade-changed owner game me item False
        in let extra = fresh & changed
        in Ok (when answer is None -> Just (gs-reply extra "trade:open") is Just (r) -> Just (GameReply { packets = r.packets & extra, close = r.close, note = r.note }))
  cg-trade-move : CompositeGame, GameShard, Integer, Integer, Integer, List (List Integer), List Text -> CgMoved
  cg-trade-move (owner) (game) (serial) (pack) (to) (shown) (names) = if serial == 0 then CgMoved { shown = shown, names = names }
    else let next = world-next-sibling game.world serial
    in when world-get game.world serial
      is Err (_) -> cg-trade-move owner game next pack to shown names
      is Ok (o) -> let placed = __record-set (__record-set (__record-set o "container" pack) "x" (40 + list-length shown * 6)) "y" 60
        in when world-update game.world placed
          is Err (_) -> cg-trade-move owner game next pack to shown names
          is Ok (_) -> let claimed = cg-lot-claim owner serial to
            in cg-trade-move owner game next pack to (list-push shown (sip-item placed)) (list-push names (show o.amount & " " & gsi-name owner.items o))
  cg-trade-end : CompositeGame, GameShard, CgSwap, Boolean -> Text
  cg-trade-end (owner) (game) (t) (swap) = let pa = gsi-pack-find game.world t.a 0
    in let pb = gsi-pack-find game.world t.b 0
    in let coin-a = cg-trade-coin game (world-first-child game.world t.box-a) 4 0 [0, 0, 0]
    in let coin-b = cg-trade-coin game (world-first-child game.world t.box-b) 4 0 [0, 0, 0]
    in let from-a = cg-trade-move owner game (world-first-child game.world t.box-a) (if swap then pb else pa) (if swap then t.b else t.a) [] []
    in let from-b = cg-trade-move owner game (world-first-child game.world t.box-b) (if swap then pa else pb) (if swap then t.a else t.b) [] []
    in let name-a = as-mobile-name owner.active game t.a
    in let name-b = as-mobile-name owner.active game t.b
    in let receipt-a = if swap then [cg-trade-receipt owner t.a name-b from-a.names from-b.names coin-a coin-b] else []
    in let receipt-b = if swap then [cg-trade-receipt owner t.b name-a from-b.names from-a.names coin-b coin-a] else []
    in let to-a = (if swap then from-b.shown else from-a.shown) & [sip-remove t.box-a, cg-trade-close t.box-a] & receipt-a
    in let to-b = (if swap then from-a.shown else from-b.shown) & [sip-remove t.box-b, cg-trade-close t.box-b] & receipt-b
    in let gone-a = world-delete game.world t.box-a
    in let gone-b = world-delete game.world t.box-b
    in let told-a = cg-tell owner t.a to-a 0
    in let told-b = cg-tell owner t.b to-b 0
    in let text = "trade: " & as-mobile-name owner.active game t.a & " (" & show t.a & ") gave [" & cg-join from-a.names 0 "" & "] to "
      & as-mobile-name owner.active game t.b & " (" & show t.b & ") for [" & cg-join from-b.names 0 "" & "]" & (if swap then "" else ", cancelled")
    in let f0 = __record-set t "a" 0 in let f1 = __record-set t "b" 0 in let f2 = __record-set t "box-a" 0 in let f3 = __record-set t "box-b" 0
    in let f4 = __record-set t "ok-a" 0 in let f5 = __record-set t "ok-b" 0
    in let touched = world-touch game.world in text
  cg-join : List Text, Integer, Text -> Text
  cg-join (xs) (i) (acc) = if i >= list-length xs then acc else cg-join xs (i + 1) (if i == 0 then list-at xs i else acc & ", " & list-at xs i)
  cg-trade-answer : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-trade-answer (owner) (game) (input) (packet) = let me = input.session.serial
    in let t = cg-trade-of owner me
    in if list-length packet < 8 | input.mode /= 2 | input.session.phase /= 2 | t.a == 0 | (me /= t.a & me /= t.b) then None
    else let action = list-at packet 3
    in if action == 1 | not (cg-trade-near game t.a t.b) then
      let text = cg-trade-end owner game t False in Just (gs-reply [] text)
    else if action /= 2 | list-length packet < 12 then None
    else let accept = if gp-u32 packet 8 == 0 then 0 else 1
    in let set = if me == t.a then __record-set t "ok-a" accept else __record-set t "ok-b" accept
    in if t.ok-a == 1 & t.ok-b == 1 then (let text = cg-trade-end owner game t True in Just (gs-reply [] text))
    else let other = cg-trade-other t me
    in let mine-ok = if me == t.a then t.ok-a else t.ok-b
    in let theirs-ok = if me == t.a then t.ok-b else t.ok-a
    in let told = cg-tell owner other [cg-trade-check (cg-trade-mine t other) theirs-ok mine-ok] 0
    in Just (gs-reply [cg-trade-check (cg-trade-mine t me) mine-ok theirs-ok] "trade:check")
 The winch is an item the items family knows, which refuses its use ("That item has no use action", live 41202), so a use
 is offered to the castle gate first.
  cg-gate-use : CompositeGame, GameShard, GameInput, List Integer -> Result (Maybe GameReply) Text
  cg-gate-use (owner) (game) (input) (packet) = when owner.decoration
    is None -> Ok None
    is Just (state) -> cgt-handler (cg-gate-decos owner state) owner.items game input packet
 A card table's double-click or gump answer (TavernCards); the other seat hears through cg-tell.
  cg-cards : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-cards (owner) (game) (input) (packet) = when tcd-handler owner.cards owner.production.harvest.items input packet get-ticks
    is None -> None
    is Just (o) -> let told = if o.other == 0 then 0 else cg-tell owner o.other o.told 0
      in let watched = cg-tell-watchers owner o.table o.watchers 0 in Just o.reply
 Each watcher of the table a seat just played at sees the new state (UOAIX-230).
  cg-tell-watchers : CompositeGame, Integer, List Integer, Integer -> Integer
  cg-tell-watchers (owner) (t) (watchers) (i) = if i >= list-length watchers then 0
    else let w = list-at watchers i
    in let told = cg-tell owner w (tcd-watch-packets owner.cards t w) 0 in cg-tell-watchers owner t watchers (i + 1)
  cg-item-drop : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-item-drop (owner) (game) (input) (map) (port) (raw) =
    let packet = tch-snap owner.items (tbd-snap owner.items raw)
    in let verdict = tbd-referee owner.items owner.tavern raw input.session.serial
    in let played = if verdict /= 0 then 0 else tch-referee owner.items owner.tavern raw input.session.serial get-ticks
    in let bounced = gsi-slot game input.session.serial 0
    in let hits = if verdict <= 0 then tbd-hit owner.items raw else []
    in let onboard = list-length raw == 14 & list-at raw 0 == 8 & (when world-get owner.items.world (gp-u32 raw 10) is Err (_) -> False is Ok (b) -> b.kind == 2 & (b.graphic == tbd-art | b.graphic == tch-board-art))
    in if verdict > 0 then Ok (Just (gs-reply ((if bounced < 0 then [] else (gsi-bounce owner.items (gsi-session owner.items game input bounced) 5).packets)
      & [sip-message #FFFFFFFF #FFFF 6 (if verdict == 2 then "Roll the dice first." else if verdict == 3 then "This game is in play; you are watching." else if verdict == 4 then "It is the other side's turn." else if verdict == 5 then "Those are your opponent's checkers." else "That move does not fit your roll. Double-click a checker to bear it off.")]) "tavern:refused"))
    else if played > 0 then (let back = if bounced < 0 then [] else (gsi-bounce owner.items (gsi-session owner.items game input bounced) 5).packets
      in if played == 8 then Ok (Just (gs-reply (back & tch-reset owner.items owner.tavern (tch-board-set owner.items.world (gp-u32 raw 10) 0)) "tavern:board"))
      else Ok (Just (gs-reply (back & [sip-message #FFFFFFFF #FFFF 6 (tch-refusal played)]) "tavern:refused")))
    else if list-length packet == 7 & list-at packet 0 == 7 then cg-lift owner game input map port packet
    else if list-length packet /= 14 | list-at packet 0 /= 8 then (when cg-gate-use owner game input packet
      is Err (e) -> Err e
      is Ok (Just (gated)) -> Ok (Just gated)
      is Ok (None) -> gsi-handle owner.items game input map port packet)
    else let item = gp-u32 packet 1
    in let target = gp-u32 packet 10
    in if cg-trade-player owner game input.session.serial target then cg-trade-give owner game input map port item target
    else let boxed = target /= 0 & cg-trade-boxed owner target
    in let slot = gsi-slot game input.session.serial 0
    in if slot >= 0 & not (cg-lot-stack-ok owner game item target) then Ok (Just (gsi-bounce owner.items (gsi-session owner.items game input slot) 5))
    else let src = gv-lot owner.vendor item 0
    in let before = if src < 0 then 0 else ep-lot-amount owner.vendor.currency.world.goods src
    in let head = (when ia-next-item game.world is Err (_) -> 0 is Ok (s) -> s)
    in when gsi-handle owner.items game input map port packet
      is Err (e) -> Err e
      is Ok (answer) -> let followed = cg-lot-follow owner.vendor src head target before
        in let spot = cg-ground-spot owner game target packet
        in let grounded = if spot < 0 then 0 else cg-ground-arm owner item spot + cg-ground-arm owner head spot
        in let spent = if verdict < 0 then tbd-spend owner.items owner.tavern raw (0 - verdict) get-ticks else 0
        in let traded = if boxed then cg-trade-changed owner game input.session.serial item False else []
        in let moved = tch-after owner.items owner.tavern raw played input.session.serial get-ticks
        in let extra = hits & traded & (if verdict <= 0 then tbd-settle owner.vendor owner.items owner.tavern (if list-length raw == 14 then gp-u32 raw 10 else 0) else []) & moved
        in if list-length extra == 0 & not onboard then Ok answer
        else let noted = if onboard then "tavern:board" else "tavern:hit"
        in Ok (when answer is None -> Just (gs-reply extra noted) is Just (r) -> Just (GameReply { packets = r.packets & extra, close = r.close, note = if onboard then noted else r.note }))
  cg-shift-players : GvWorld, Integer -> Integer
  cg-shift-players (v) (i) = if i + 1 >= v.player-count then 0
    else let moved = list-set-at v.players i (list-at v.players (i + 1)) in cg-shift-players v (i + 1)
  cg-quiet-quotes : GvWorld, Integer -> Integer
  cg-quiet-quotes (v) (i) = if i == v.player-count then 0
    else let p = list-at v.players i
    in let a = __record-set p "vendor" 0
    in let b = __record-set p "side" 0
    in let c = __record-set p "count" 0 in cg-quiet-quotes v (i + 1)
  cg-release : CompositeGame, GameShard, Integer -> Integer
  cg-release (owner) (game) (serial) = when world-get game.world serial
    is Ok (_) -> 0
    is Err (_) -> let crowned = cn-forfeit owner.construction owner.production.harvest serial (cg-british-serial owner)
      in let v = owner.vendor
      in let at = gv-player v serial 0
      in if at < 0 then 0
      else let p = list-at v.players at
      in let lots = cg-drop-lots v p.actor 0
      in let shifted = cg-shift-players v at
      in let last = list-set-at v.players (v.player-count - 1) p
      in let a = __record-set p "serial" 0
      in let b = __record-set p "actor" 0
      in let c = __record-set p "pack" 0
      in let d = __record-set p "connection" (0 - 1)
      in let e = __record-set p "expires" 0
      in let n = __record-set v "player-count" (v.player-count - 1)
      in let quiet = cg-quiet-quotes v 0
      in world-item-touch game.world

  cg-items : CompositeGame, Integer -> Integer
  cg-items (owner) (unused) = cg-items-from owner (ep-lots-first owner.vendor.currency.world.goods)
  cg-items-from : CompositeGame, Integer -> Integer
  cg-items-from (owner) (serial) = if serial == 0 then 0
    else let registered = if gsi-known owner.items serial then 0 else gsi-register owner.items serial 0 0 True False
    in cg-items-from owner (ep-lot-after owner.vendor.currency.world.goods serial)

 A ghost walks, speaks, clicks, asks its status, toggles war mode, answers the death menu, opens its own paperdoll and uses
 the ankh; it cannot attack, lift, drop, equip, use skills or spells (0x12), answer a target or menu, buy, sell, or
 double-click anything else, doors and NPCs among them (UO classic; Source-X CChar::IsDead checks).
  cg-ghost-may : CompositeGame, GameInput, List Integer -> Boolean
  cg-ghost-may (owner) (input) (packet) = let op = list-at packet 0
    in if op == 5 | op == 7 | op == 8 | op == #12 | op == #13 | op == #6C | op == 59 | op == 159 | op == #7D then False
    else if op /= 6 then True
    else if list-length packet /= 5 then False
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in serial == input.session.serial | (serial /= 0 & (serial == owner.resurrection.shrine | serial == owner.resurrection.other))
  cg-ghost-denied : GameInput -> GameReply
  cg-ghost-denied (input) = GameReply { packets = (gsi-denied "You cannot do that while dead.").packets, close = False, note = "ghost:denied" }
 A ghost's speech reaches no NPC: only the default handler echoes it.
  cg-ghost-family : GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  cg-ghost-family (game) (input) (map) (port) (packet) = Ok None
 The death answer's full re-entry (0x1B, 0x20, 0x55) wipes the 1.25 client's
 objects. A fresh negative connection id, which no accept produces, makes
 every per-connection view forget and resend, as a reconnect does.
  cg-rebind : CompositeGame, GameInput -> Integer
  cg-rebind (owner) (input) = let next = owner.rebinds + 1
    in let counted = __record-set owner "rebinds" next
    in let fresh = __record-set input "connection" (0 - next)
    in 0

  cg-route : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> [Console, Device.Block] Result GameReply Text
  cg-route (owner) (game) (input) (map) (port) (packet) =
    if list-length packet > 0 & input.mode == 2 & input.session.phase == 1 & list-at packet 0 == 0 & not (cg-bind-room owner)
    then act Err "composite player capacity full: creation refused" end
    else let entering = list-length packet > 0 & input.mode == 2 & input.session.phase == 1
      & (list-at packet 0 == 0 | list-at packet 0 == #5D)
    in let was-dead = if input.session.phase /= 2 then False else when world-get game.world input.session.serial is Err (_) -> False is Ok (mobile) -> mobile.health == 0
    in let ghosting = was-dead & list-length packet == 2 & list-at packet 0 == 44 & list-at packet 1 /= 0
    in if was-dead & list-length packet > 0 & not (cg-ghost-may owner input packet) then act Ok (cg-ghost-denied input) end
    else let rebound = if ghosting then cg-rebind owner input else 0
    in let walking = list-length packet > 0 & list-at packet 0 == 2 & input.mode == 2 & input.session.phase == 2
    in let before = if walking then world-get game.world input.session.serial else Err "not walking"
    in let doomed = if list-length packet == 39 & list-at packet 0 == #83 & input.mode == 2 & input.session.phase == 1
      then (let slot = gp-u32 packet 31 in if slot < 0 | slot >= 5 then 0 else peek-qword game.characters (slot * 160)) else 0
    in act
      magical <- if was-dead then act Ok None end else cg-magic owner game input map port packet
      when magical
        is Err (e) -> Err e
        is Ok (Just (reply)) -> let corpses = gr-corpse-packets owner.items reply.packets 0
          in Ok (as-after owner.active game input packet (cg-after-magic owner game input packet reply))
        is Ok (None) -> act
          routed <- gn-route (if was-dead & list-at packet 0 == 3 then cg-ghost-family else cg-family owner) game input map port packet
          when routed
            is Err (e) -> Err e
            is Ok (reply) -> let released = if doomed == 0 then 0 else cg-release owner game doomed in act
              travelled <- cg-travel owner game input map before (cg-after-magic owner game input packet reply)
              when travelled
                is Err (e) -> Err e
                is Ok (moved) -> let after = as-after owner.active game input packet moved
                  in if (not entering & not was-dead) | input.session.phase /= 2 then Ok after
                  else cg-entry owner game input map (if entering then cg-kit owner input packet (cg-peace owner game input after) else after)
            end
          end
    end
 A character created by this packet (0x00) receives its trade's starter kit (StarterKit) and a full belly (hunger 20);
 its tools become economy lots as the testing kit's do (cpr-kit-tools), so harvesting accepts them.
  cg-kit : CompositeGame, GameInput, List Integer, GameReply -> GameReply
  cg-kit (owner) (input) (packet) (reply) = if list-length packet == 0 | list-at packet 0 /= 0 then reply
    else when pk-grant owner.items input.session.serial packet
      is Err (_) -> reply
      is Ok (made) -> let lotted = cpr-kit-tools owner.production input.session.serial (gsi-pack-find owner.items.world input.session.serial 0)
        in let slot = gsi-slot owner.checkpoint.game input.session.serial 0
        in let full = if slot < 0 then 0 else gh-set (owner.checkpoint.game.characters + slot * 160) 20
        in GameReply { packets = reply.packets & made, close = reply.close, note = reply.note & "; starter kit" }
  cg-magic : CompositeGame, GameShard, GameInput, WalkMap, Integer, List Integer -> [Device.Block] Result (Maybe GameReply) Text
  cg-magic (owner) (game) (input) (map) (port) (packet) = when owner.magic
    is None -> act Ok None end
    is Just (magic) -> if input.mode /= 2 | input.session.phase /= 2 then act Ok None end
      else mg-handler magic game input map port packet
  cg-after-magic : CompositeGame, GameShard, GameInput, List Integer, GameReply -> GameReply
  cg-after-magic (owner) (game) (input) (packet) (reply) = when owner.magic
    is None -> reply
    is Just (magic) -> if input.mode /= 2 | input.session.phase /= 2 | reply.close then reply
      else mg-after-command magic game input packet reply
  cg-permit : Integer, Integer -> Boolean
  cg-permit (serial) (destination) = True
 The walk window covers the traveller's surroundings only, so the destination gate's window is paged in
 before the arrival tiles are tested.
  cg-gate-walk : CompositeGame, GameShard, GameInput, Result WorldObject Text, GameReply -> [Device.Block] Result GameReply Text
  cg-gate-walk (owner) (game) (input) (before) (reply) = when owner.magic
    is None -> act Ok reply end
    is Just (magic) -> mg-gate-walk magic game input before reply
  cg-gate-party : CompositeGame, GameMoongates, WorldObject -> Integer
  cg-gate-party (owner) (gates) (start) = when world-get gates.game.world start.serial
    is Err (_) -> 0
    is Ok (now) -> if gmg-at gates now 0 < 0 then 0
      else let released = gmg-release gates start.serial 0
      in when owner.spawns
        is None -> 0
        is Just (spawns) -> cg-gate-summons gates spawns start.serial 0
  cg-gate-summons : GameMoongates, GameWorldSpawn, Integer, Integer -> Integer
  cg-gate-summons (gates) (spawns) (leader) (i) = if i == list-length spawns.slots then 0
    else let slot = list-at spawns.slots i
    in let bound = if slot.serial /= 0 & slot.owner == leader then gmg-bind gates True leader slot.serial True else 0
    in cg-gate-summons gates spawns leader (i + 1)
  cg-travel : CompositeGame, GameShard, GameInput, WalkMap, Result WorldObject Text, GameReply -> [Device.Block] Result GameReply Text
  cg-travel (owner) (game) (input) (map) (before) (reply) = when owner.gates
    is None -> cg-gate-walk owner game input before reply
    is Just (gates) -> when before
      is Err (_) -> act Ok reply end
      is Ok (start) -> let seconds = owner.clock / mgd-ticks 1000
        in let party = cg-gate-party owner gates start
        in when gmg-prepare cg-permit gates input map owner.decoration start seconds
          is Err (e) -> act Err e end
          is Ok (None) -> cg-gate-walk owner game input before reply
          is Ok (Just (plan)) -> let p = list-at gates.gates plan.destination in when owner.gate-cover
            is None -> act gmg-apply cg-permit gates input map plan reply end
            is Just (cover) -> act
              covered <- cover p.x p.y p.z
              when covered
                is Err (e) -> Err e
                is Ok (arrival) -> gmg-apply cg-permit gates input arrival plan reply
            end
  cg-gate-find : GameMoongates, Integer, Integer, Integer -> Integer
  cg-gate-find (gates) (x) (y) (serial) = if serial == 0 then 0
    else when world-get gates.game.world serial
      is Err (_) -> cg-gate-find gates x y (world-tile-next gates.game.world serial)
      is Ok (item) -> if item.kind == 2 & item.graphic == #0F6C & item.container == 0 & item.x == x & item.y == y then serial
        else cg-gate-find gates x y (world-tile-next gates.game.world serial)
  cg-gates-bind : GameMoongates, Integer -> Result Integer Text
  cg-gates-bind (gates) (i) = if i == 8 then Ok 8
    else let p = list-at gates.gates i
    in let found = cg-gate-find gates p.x p.y (world-tile-first gates.game.world p.x p.y)
    in when (if found > 0 then Ok found else world-create gates.game.world (WorldObject { serial = 0, kind = 2, x = p.x, y = p.y, z = p.z,
      graphic = #0F6C, hue = 0, container = 0, amount = 1, health = 0 }))
      is Err (e) -> Err e
      is Ok (serial) -> let registered = if gsi-known gates.items serial then 0 else gsi-register gates.items serial 0 0 False False
        in if registered /= 0 then Err "moongate item registration"
        else let bound = __record-set p "serial" serial in cg-gates-bind gates (i + 1)
 On a testing shard every carried spellbook holds every working spell (Damian, 2026-10-07: "need to add all working
 spells to the spellbook you put in player backpack"), so a spell that lands reaches existing characters at their next
 entry; otherwise a book only loses spells that stopped working.
  cg-books : Magery, GameShard, Boolean, Integer, Integer -> Integer
  cg-books (magic) (game) (full) (serial) (depth) = if serial == 0 | depth == 0 then 0
    else let next = world-next-sibling game.world serial
    in let here = when world-get game.world serial
      is Err (_) -> 0
      is Ok (item) -> if item.graphic == #0EFA & not (mgs-known magic serial) then (when mgs-book magic serial mgs-working is Err (_) -> 0 is Ok (_) -> 0)
        else if item.graphic == #0EFA & full & mgs-spells magic serial /= mgs-working then (when mgs-book magic serial mgs-working is Err (_) -> 0 is Ok (_) -> 0)
        else if item.graphic == #0EFA & bit-and (mgs-spells magic serial) mgs-working /= mgs-spells magic serial then
          (when mgs-book magic serial (bit-and (mgs-spells magic serial) mgs-working) is Err (_) -> 0 is Ok (_) -> 0)
        else cg-books magic game full (world-first-child game.world serial) (depth - 1)
    in cg-books magic game full next depth
 The testing kit rune is marked once, when granted, at the new-character
 entry tile 1420,1698 inside Britain (Damian, 2026-10-04: runes target safe
 zones only). Any other rune stays blank. Outside the loaded map the kit
 rune also stays blank rather than carry a guessed height.
  cg-kit-rune : Magery, WalkMap, Integer -> Result Integer Text
  cg-kit-rune (magic) (map) (rune) = if rune == 0 then Ok 0
    else when walk-ground map 1420 1698
      is Err (_) -> Ok 0
      is Ok (ground) -> when walk-height map 1420 1698 ground
        is Err (_) -> Ok 0
        is Ok (z) -> mgs-rune magic rune 1420 1698 z

 British cannot be damaged or killed (Damian, 2026-10-05); combat and harmful spells refuse an immune target.
 TILEDATA item flag 0x00800000 is LightSource. Animal bodies follow Source-X
 CChar::GetNPCBrainAuto: 0x05, 0x06, 0x1D, 0x34, 0x51, 0x97 and 0xC8-0x18F.
  cg-as-light : CompositeGame, Integer -> Boolean
  cg-as-light (owner) (graphic) = let tiles = owner.items.tiles
    in it-present tiles graphic & bit-and (peek-byte tiles (it-entry tiles graphic + 2)) #80 /= 0
  cg-as-animal : CompositeGame, Integer -> Boolean
  cg-as-animal (owner) (serial) = let game = owner.checkpoint.game in when world-get game.world serial
    is Err (_) -> False
    is Ok (m) -> let b = m.graphic
      in m.kind == 1 & cb-slot game serial 0 < 0
        & (b == #05 | b == #06 | b == #1D | b == #34 | b == #51 | b == #97 | (b >= #C8 & b < #190))
  cg-as-item-name : CompositeGame, Integer -> Text
  cg-as-item-name (owner) (serial) = when world-get owner.items.world serial
    is Err (_) -> "item"
    is Ok (item) -> gsi-name owner.items item
  cg-as-intelligence : CompositeGame, Integer -> Integer
  cg-as-intelligence (owner) (serial) = let game = owner.checkpoint.game
    in let slot = cb-slot game serial 0
    in if slot < 0 then -1 else gp-stat (game.characters + slot * 160) 2
  cg-as-poison : CompositeGame, Integer -> Integer
  cg-as-poison (owner) (serial) = when owner.magic
    is None -> -1
    is Just (magic) -> let slot = world-slot owner.items.world serial
      in if slot < 0 then -1 else let actor = list-at magic.actors slot
      in if actor.serial == serial then actor.poison else -1
  cg-as-cure : CompositeGame, Integer -> Boolean
  cg-as-cure (owner) (serial) = when owner.magic
    is None -> False
    is Just (magic) -> let slot = world-slot owner.items.world serial
      in if slot < 0 then False else let actor = list-at magic.actors slot
      in if actor.serial /= serial | actor.poison < 0 then False
      else let a = __record-set actor "poison" -1
      in let b = __record-set actor "poison-left" 0
      in let touched = mgs-touch magic in True
  cg-as-resurrect : CompositeGame, Integer, Integer -> Boolean
  cg-as-resurrect (owner) (healer) (patient) = let game = owner.checkpoint.game
    in when world-get game.world patient
      is Err (_) -> False
      is Ok (ghost) -> let slot = cb-slot game patient 0
        in if ghost.kind /= 1 | ghost.health > 0 | slot < 0 then False
        else when gr-raise-world owner.resurrection game ghost slot
          is Err (_) -> False
          is Ok (_) -> let marked = gr-mark-raised owner.resurrection.views patient 0 in True
 Magery's summon-hook and followers-hook over the spawn controller's summon slots (UOAIX-81).
  cg-summon : CompositeGame, Integer, Text, Integer, Integer, Integer, Boolean, Integer -> Integer
  cg-summon (owner) (caster) (key) (x) (y) (z) (controlled) (ms) = when owner.spawns
    is None -> 0
    is Just (g) -> when gws-summon g owner.checkpoint.game (gws-profile-key g key 0) x y z (if controlled then caster else 0) (g.combat.tick + gm-ticks ms)
      is Err (_) -> 0
      is Ok (serial) -> serial
 Damian, 2026-10-09: "every swing on a yew tree spawns an orc near the striker that attacks the striker, except grand
 master lumberjacks." The 1.25 client's TILEDATA names 0x12B6..0x12C7 "Yew tree"; grand master is lumberjacking (skill
 44) at 1000 tenths. The orc answers to nobody and leaves after 10 minutes, so swings cannot fill the spawn slots for good.
  cg-yew-tree : Integer -> Boolean
  cg-yew-tree (graphic) = graphic >= #12B6 & graphic <= #12C7
  cg-yew-orc-ms : Integer = 600000
  cg-yew-due : Integer, Integer, Integer -> Boolean
  cg-yew-due (resource) (graphic) (lumberjacking) = resource == 15 & cg-yew-tree graphic & lumberjacking < 1000
 UOAIX-235 (Damian, 2026-10-09: "lets make it a misdemenor to cut city trees down, even for pcs."): a player's
 lumberjacking swing standing inside any city's bounds is a misdemeanor (the law's kind 1) its witnesses can report,
 one open case at a time.
  cg-swing : CompositeGame, Integer, Integer, Integer, Integer, Integer -> Integer
  cg-swing (owner) (striker) (resource) (graphic) (x) (y) = let felled = cg-tree-crime owner striker resource x y
    in cg-yew-swing owner striker resource graphic x y
  cg-tree-in-city : List CtCity, Integer, Integer, Integer -> Boolean
  cg-tree-in-city (cities) (resource) (x) (y) = resource == 15 & ct-city-at cities x y 0 >= 0
  cg-tree-crime : CompositeGame, Integer, Integer, Integer, Integer -> Integer
  cg-tree-crime (owner) (striker) (resource) (x) (y) = if not (cg-tree-in-city owner.cities resource x y) then 0
    else when owner.civic
      is None -> 0
      is Just (c) -> if gv-player owner.vendor striker 0 < 0 then 0 else cg-tree-deed owner c striker x y
 UOAIX-235 for NPCs (root: no exemption, once the town lumberjack fells outside the cities, reek UOAIX-234): a worker
 whose log harvest grew while it stands inside a city is booked the same misdemeanor.
  cg-worker-tree : CompositeGame, Integer -> Integer
  cg-worker-tree (owner) (serial) = when owner.civic
    is None -> 0
    is Just (c) -> when world-get owner.checkpoint.game.world serial
      is Err (_) -> 0
      is Ok (m) -> if not (cg-tree-in-city owner.cities 15 m.x m.y) then 0 else cg-tree-deed owner c serial m.x m.y
  cg-tree-deed : CompositeGame, CivicLive, Integer, Integer, Integer -> Integer
  cg-tree-deed (owner) (c) (striker) (x) (y) = if cg-open-kind c.law striker 1 0 then 0
        else let id = lw-deed c.law True (lw-next-source c.law 0 0) striker 1 (cg-town-at owner x y)
        in if id < 1 then 0
        else let seen = cg-witnesses owner c id striker
        in let touched = world-touch owner.checkpoint.game.world in id
  cg-yew-swing : CompositeGame, Integer, Integer, Integer, Integer, Integer -> Integer
  cg-yew-swing (owner) (striker) (resource) (graphic) (x) (y) = if not (cg-yew-due resource graphic (gs-skill owner.checkpoint.game striker 44)) then 0
    else when world-get owner.checkpoint.game.world striker
      is Err (_) -> 0
      is Ok (m) -> let map = when cg-city-map owner m.x m.y is Just (c) -> Just c is None -> owner.town-map
        in let spot = when map is None -> BbSpot { x = m.x, y = m.y, z = m.z } is Just (w) -> cg-orc-spot owner.checkpoint.game.world w m 0
        in let orc = cg-summon owner 0 "orc" spot.x spot.y spot.z False cg-yew-orc-ms
        in if orc == 0 then 0 else cg-attack owner orc striker
 A free tile beside the striker an orc can stand on, else the striker's own tile.
  cg-orc-spot : WorldTable, WalkMap, WorldObject, Integer -> BbSpot
  cg-orc-spot (world) (map) (m) (d) = if d >= 8 then BbSpot { x = m.x, y = m.y, z = m.z }
    else let x = m.x + walk-dx d
    in let y = m.y + walk-dy d
    in when walk-height map x y m.z
      is Err (_) -> cg-orc-spot world map m (d + 1)
      is Ok (z) -> if tl-occupied world (world-tile-first world x y) m.serial z then cg-orc-spot world map m (d + 1) else BbSpot { x = x, y = y, z = z }
  cg-followers : CompositeGame, Integer -> Integer
  cg-followers (owner) (caster) = when owner.spawns is None -> 0 is Just (g) -> gws-followers g owner.checkpoint.game.world caster 0
  cg-summon-key : CompositeGame, Integer -> Text
  cg-summon-key (owner) (serial) = when owner.spawns is None -> "" is Just (g) -> gws-summon-key g serial
  cg-dismiss : CompositeGame, Integer -> Boolean
  cg-dismiss (owner) (serial) = when owner.spawns
    is None -> False
    is Just (g) -> if not (gws-summoned g serial) then False else is-ok (gws-dismiss g owner.checkpoint.game serial)
  cg-as-snoop : CompositeGame, Integer, Integer, Integer, Boolean -> Boolean
  cg-as-snoop (owner) (snooper) (target) (pack) (success) = False
  cg-admit : ActiveSkills, Integer, Integer -> Boolean
  cg-admit (active) (attacker) (target) = let now = get-ticks
    in as-visible active attacker target & not (as-calmed active target now) & not (as-calmed active attacker now)
 A spawned creature's TOPROV by its spawn profile key; -1 for any other mobile.
  cg-as-provoke : CompositeGame, Integer -> Integer
  cg-as-provoke (owner) (serial) = when owner.spawns
    is None -> -1
    is Just (g) -> let i = if serial <= 0 then -1 else gws-slot-of g serial 0
      in if i < 0 then -1 else pvd-difficulty (list-at g.catalog.profiles (list-at g.slots i).profile).key
  cg-as-taming : CompositeGame, Integer -> Integer
  cg-as-taming (owner) (serial) = when owner.spawns is None -> 0 is Just (g) -> gws-taming g serial
  cg-as-master : CompositeGame, Integer -> Integer
  cg-as-master (owner) (serial) = when owner.spawns is None -> -1 is Just (g) -> gws-owner-of g serial
  cg-as-tame : CompositeGame, Integer, Integer -> Boolean
  cg-as-tame (owner) (serial) (master) = when owner.spawns is None -> False is Just (g) -> gws-tame g owner.checkpoint.game serial master
  cg-as-pet-name : CompositeGame, Integer -> Text
  cg-as-pet-name (owner) (serial) = let slot = if serial <= 0 then -1 else world-slot owner.checkpoint.game.world serial
    in let named = if slot < 0 | slot >= list-length owner.combat.actors then [] else let a = list-at owner.combat.actors slot in if a.serial == serial then cg-name-bytes a.name 0 [] else []
    in if list-length named > 0 then utf8-bytes-to-text named
    else when owner.spawns is None -> "creature" is Just (g) -> gws-name g serial
  cg-as-services : CompositeGame -> AsServices
  cg-as-services (owner) = AsServices { light = cg-as-light owner, animal = cg-as-animal owner, item-name = cg-as-item-name owner,
    intelligence = cg-as-intelligence owner, poison = cg-as-poison owner, cure = cg-as-cure owner,
    resurrect = cg-as-resurrect owner, snoop = cg-as-snoop owner, provoke = cg-as-provoke owner, lure = cg-as-lure owner,
    taming = cg-as-taming owner, master = cg-as-master owner, tame = cg-as-tame owner, pet-name = cg-as-pet-name owner,
    herd = cg-as-herd owner,
    envenom = cg-as-envenom owner }
  cg-as-herd : CompositeGame, Integer, Integer, Integer, Integer -> Boolean
  cg-as-herd (owner) (creature) (x) (y) (leader) = when owner.spawns
    is None -> False
    is Just (g) -> if leader > 0 then gws-lure g creature leader else gws-herd g creature x y
 Poison a character at Magery level 0 to 3 as the Poison spell does (10 ticks from 3.5 s), refusing one already
 poisoned at that level or higher.
  cg-as-envenom : CompositeGame, Integer, Integer, Integer -> Boolean
  cg-as-envenom (owner) (serial) (level) (poisoner) = when owner.magic
    is None -> False
    is Just (magic) -> when mgs-ensure magic owner.checkpoint.game serial
      is Err (_) -> False
      is Ok (actor) -> if actor.poison >= level then False
        else let a = __record-set actor "poison" level
        in let b = __record-set actor "poison-due" (magic.tick + mgd-ticks 3500)
        in let c = __record-set actor "poison-left" 10
        in let d = __record-set actor "poison-last" 0
        in let e = __record-set actor "poisoner" poisoner
        in let tracked = mgs-track magic actor
        in let touched = mgs-touch magic in True
  cg-as-lure : CompositeGame, Integer, Integer -> Boolean
  cg-as-lure (owner) (follower) (leader) = when owner.spawns is None -> False is Just (g) -> gws-lure g follower leader
 UOX3 pet commands: an owner saying "all follow", "all guard" or "all stay" (or "all stop") orders every pet and summon
 it owns, and "<name> follow me" (guard, stay, stop) the one so named (Damian, 2026-10-09: "\"all follow me\" to get all
 followers to follow"). The order replaces an attack or defend command, and an ordered pet leaves its fight.
  cg-pet-order : Text -> Integer
  cg-pet-order (text) = if ns-has text "follow" then gws-order-follow
    else if ns-has text "guard" then gws-order-guard else if ns-has text "stay" | ns-has text "stop" then gws-order-stay else -1
  cg-pet-orders : CompositeGame, GameShard, GameInput, List Integer -> Integer
  cg-pet-orders (owner) (game) (input) (packet) =
    if list-length packet < 9 | list-length packet > 256 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2
      | game.active /= input.session.serial | not (gp-speech-valid packet) then 0
    else let text = gp-speech-text packet
    in let order = cg-pet-order text
    in if order < 0 then 0 else when owner.spawns is None -> 0 is Just (g) -> cg-pet-order-each owner g game input.session.serial text order (ns-has text "all") 0
  cg-pet-order-each : CompositeGame, GameWorldSpawn, GameShard, Integer, Text, Integer, Boolean, Integer -> Integer
  cg-pet-order-each (owner) (g) (game) (master) (text) (order) (all) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in if slot.serial == 0 | slot.owner /= master then cg-pet-order-each owner g game master text order all (i + 1)
    else let name = cg-as-pet-name owner slot.serial
    in let bare = as-tame-bare name
    in if not (all | (text-length name > 0 & ns-has text name) | (text-length bare > 0 & ns-has text bare)) then cg-pet-order-each owner g game master text order all (i + 1)
    else let set = __record-set slot "order" order
    in let due = __record-set slot "due" g.combat.tick
    in let cleared = gws-uncommand slot
    in let at = world-slot game.world slot.serial
    in let calmed = if at < 0 then 0 else let a = list-at g.combat.actors at in if a.serial /= slot.serial then 0
      else let stopped = cb-stop g.combat a in let peace = __record-set a "war" False in 0
    in 1 + cg-pet-order-each owner g game master text order all (i + 1)
 UOAIX-203 (Damian, 2026-10-09: "<name> attack -> target or defend (target self or other friendly)"): an owner naming
 its pets (or "all") with "attack" or "kill" or "defend" gets a target cursor; the answer sends them at the target or
 sets them guarding it.
  cg-pet-tag : Integer = #50450000
  cg-pet-command : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-pet-command (owner) (game) (input) (packet) =
    if list-length packet < 9 | list-length packet > 256 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2
      | game.active /= input.session.serial | not (gp-speech-valid packet) then None
    else let text = gp-speech-text packet
    in let aim = if ns-has text "attack" | ns-has text "kill" then 1 else if ns-has text "defend" then 2 else 0
    in if aim == 0 then None else when owner.spawns
      is None -> None
      is Just (g) -> let marked = cg-pet-mark owner g input.session.serial text aim (ns-has text "all") 0
        in if marked == 0 then None
        else Just (gs-reply [sip-message #FFFFFFFF #FFFF 6 (if aim == 1 then "Whom do you wish your pet to attack?" else "Whom do you wish your pet to defend?"), sip-target (cg-pet-tag + aim)] "pets:aim")
  cg-pet-mark : CompositeGame, GameWorldSpawn, Integer, Text, Integer, Boolean, Integer -> Integer
  cg-pet-mark (owner) (g) (master) (text) (aim) (all) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in if slot.serial == 0 | slot.owner /= master then cg-pet-mark owner g master text aim all (i + 1)
    else let name = cg-as-pet-name owner slot.serial
    in if all | ns-has text name | ns-has text (as-tame-bare name) then (let m = __record-set slot "aim" aim in 1 + cg-pet-mark owner g master text aim all (i + 1))
    else cg-pet-mark owner g master text aim all (i + 1)
  cg-pet-aimed : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-pet-aimed (owner) (game) (input) (packet) = if list-length packet /= 19 | list-at packet 0 /= #6C | input.mode /= 2 | input.session.phase /= 2 then None
    else let context = gp-u32 packet 2
    in if context /= cg-pet-tag + 1 & context /= cg-pet-tag + 2 then None
    else when owner.spawns
      is None -> None
      is Just (g) -> let target = if list-at packet 1 == 0 then bit-and (gp-u32 packet 7) #7FFFFFFF else 0
        in let mobile = if target <= 0 then False else (when world-get game.world target is Err (_) -> False is Ok (m) -> m.kind == 1 & m.health > 0)
        in let sent = gws-command g input.session.serial (context - cg-pet-tag) (if mobile then target else 0) 0
        in Just (gs-reply [sip-message #FFFFFFFF #FFFF 6 (if sent == 0 then "Your pets do nothing." else if context == cg-pet-tag + 1 then "Your pets attack." else "Your pets stand guard.")] "pets:commanded")
  cg-kindling : CompositeGame, GameShard, GameInput, WalkMap, List Integer -> Result (Maybe GameReply) Text
  cg-kindling (owner) (game) (input) (map) (packet) =
    if list-length packet /= 5 | list-at packet 0 /= 6 | input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then Ok None
    else when world-get game.world (bit-and (gp-u32 packet 1) #7FFFFFFF)
      is Err (_) -> Ok None
      is Ok (item) -> if item.kind /= 2 | item.graphic /= cf-kindling then Ok None
        else when world-get game.world input.session.serial
            is Err (e) -> Err e
            is Ok (mobile) -> if mobile.health <= 0 then Ok (Just (gsi-denied "You cannot do that while dead."))
              else cf-light owner.camps owner.active owner.timers game input map mobile item.serial owner.clock
 ServUO Food.OnDoubleClick and Food.Eat: a carried food is eaten one at a time, plays 0x3A to 0x3C and says how full
 the eater is (GameHunger); its economy lot is debited as a spent reagent's is.
  cg-eat : CompositeGame, GameShard, GameInput, List Integer -> Result (Maybe GameReply) Text
  cg-eat (owner) (game) (input) (packet) =
    if list-length packet /= 5 | list-at packet 0 /= 6 | input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then Ok None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in when world-get owner.items.world serial
      is Err (_) -> Ok None
      is Ok (food) -> if food.kind /= 2 | gh-fill food.graphic == 0 then Ok None
        else let me = input.session.serial
        in let slot = gs-char-slot game.characters me 0
        in if slot < 0 then Ok None
        else if not (gv-owned owner.items.world serial me 65) then Ok (Just (gsi-denied "That must be in your backpack to use it."))
        else let row = game.characters + slot * 160
        in let fed = gh-fed row
        in if fed >= 20 then Ok (Just (gsi-denied gh-full))
        else when mgr-vendor-debit (Just owner.vendor) me serial
          is Err (_) -> Ok (Just (gsi-denied "You cannot eat that."))
          is Ok (written) -> when (if written == 1 then Ok [mgr-pile owner.items.world serial] else cg-eat-one owner food)
            is Err (e) -> Err e
            is Ok (spent) -> when world-get game.world me
              is Err (e) -> Err e
              is Ok (eater) -> let now = min 20 (fed + gh-fill food.graphic)
                in let set = gh-set row now
                in let venom = if gh-venom food.health < 0 then False else cg-as-envenom owner me (gh-venom food.health) 0
                in let touched = world-touch game.world
                in Ok (Just (gs-reply (spent & [cbp-sound (#003A + int-mod get-ticks 3) eater, gs-system (gh-eaten now)]) "hunger:eat"))
  cg-eat-one : CompositeGame, WorldObject -> Result (List (List Integer)) Text
  cg-eat-one (owner) (food) = if food.amount <= 1 then when world-delete owner.items.world food.serial
      is Err (e) -> Err e
      is Ok (_) -> Ok [sip-remove food.serial]
    else let reduced = ia-copy food food.serial (food.amount - 1) food.container food.x food.y food.z
    in when world-update owner.items.world reduced
      is Err (e) -> Err e
      is Ok (_) -> Ok [sip-item reduced]
 ServUO FoodDecay: hunger falls by 1 every 5 minutes while the character is in the world, so the timer runs from world
 entry (cg-return) to departure (cg-depart) and re-arms itself.
  cg-hunger-arm : CompositeGame, Integer -> Integer
  cg-hunger-arm (owner) (serial) = wtm-set owner.timers (owner.timers.limit + gm-ticks gh-decay-ms) gh-kind serial
  cg-hunger-fire : CompositeGame, GameShard, Integer -> Integer
  cg-hunger-fire (owner) (game) (serial) = let slot = gs-char-slot game.characters serial 0
    in if slot < 0 then 0
    else let row = game.characters + slot * 160
    in let fed = gh-fed row
    in let fell = if fed > 0 then gh-set row (fed - 1) else 0
    in let touched = if fed > 0 then world-touch game.world else 0
    in wtm-add owner.timers (owner.timers.limit + gm-ticks gh-decay-ms) gh-kind serial
  cg-camp : CompositeGame, GameShard, GameInput, Integer -> Maybe GameReply
  cg-camp (owner) (game) (input) (tick) = if input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (player) -> let said = cf-camp owner.camps game.world player tick
        in if list-length said == 0 then None else Just (gs-reply said "camping:camp")
 A running play fires on the wheel (kind 18, keyed by its slot) at the delay its last fire asked for, over the Britain
 map on the town planner, in town-clock game seconds (UoaixPlays.md).
  cg-play-fire : CompositeGame, GameShard, Integer, Integer -> Integer
  cg-play-fire (owner) (game) (tick) (slot) = when owner.town
    is None -> 0
    is Just (town) -> when owner.town-map
      is None -> 0
      is Just (britain) -> let delay = plr-fire owner.plays slot game owner.items town.nav britain owner.town-doors owner.town-seconds
        in if delay < 0 then 0 else wtm-add owner.timers (tick + max 1 delay) plr-kind slot
  cg-play-rearm : CompositeGame, Integer -> Integer
  cg-play-rearm (owner) (slot) = if slot >= plr-slots then 0
    else let armed = if plr-run owner.plays slot 0 == plr-running & wtm-find owner.timers plr-kind slot < 0 then cg-play-arm owner slot else 0
    in cg-play-rearm owner (slot + 1)
  cg-play-arm : CompositeGame, Integer -> Integer
  cg-play-arm (owner) (slot) = wtm-set owner.timers (owner.timers.limit + 1) plr-kind slot
  cg-play-show : CompositeGame, WalkMap, GameShard, GameInput -> Maybe GameReply
  cg-play-show (owner) (britain) (game) (input) = when world-get game.world input.session.serial
    is Err (_) -> None
    is Ok (viewer) -> let packets = plr-pulse owner.plays game owner.combat britain viewer input.connection
      in if list-length packets == 0 then None else Just (gs-reply packets "play:line")
  cg-immune : CompositeGame, GameShard, Integer -> Integer
  cg-immune (owner) (game) (serial) = when cb-ensure owner.combat game serial
    is Err (_) -> 0
    is Ok (actor) -> let immune = __record-set actor "immune" True in 0
 Source-X ClientLinger: a logged-out character stays in the world 300 s (its shipped sphere.ini), then
 leaves every view. Concealed byte 2 marks a departed body; the hiding skill uses 1.
  cg-linger-ms : Integer = 300000
  cg-linger-kind : Integer = 7
  cg-depart : CompositeGame, Integer -> Integer
  cg-depart (owner) (serial) = if serial <= 0 then 0
    else let hungerless = wtm-clear owner.timers gh-kind serial
    in if cf-secure owner.camps serial then let cleared = wtm-clear owner.timers cg-linger-kind serial in cg-departed owner serial
    else wtm-set owner.timers (owner.timers.limit + gm-ticks cg-linger-ms) cg-linger-kind serial
  cg-departed : CompositeGame, Integer -> Integer
  cg-departed (owner) (serial) = let slot = world-slot owner.items.world serial in if slot < 0 then 0 else poke-byte (sa-at owner.active.concealed slot) 0 2
  cg-return : CompositeGame, Integer -> Integer
  cg-return (owner) (serial) = let cleared = wtm-clear owner.timers cg-linger-kind serial
    in let hungry = if serial <= 0 then 0 else cg-hunger-arm owner serial
    in let slot = world-slot owner.items.world serial
    in if slot < 0 then 0 else if peek-byte (sa-at owner.active.concealed slot) 0 == 2 then poke-byte (sa-at owner.active.concealed slot) 0 0 else 0
  cg-offline-slots : CompositeGame, Integer, Integer -> Integer
  cg-offline-slots (owner) (base) (s) = if s == 5 then 0
    else let serial = peek-qword base (s * 160)
    in let hidden = if serial <= 0 then 0 else cg-departed owner serial in cg-offline-slots owner base (s + 1)
  cg-offline : CompositeGame, Integer -> Integer
  cg-offline (owner) (i) = let table = owner.checkpoint.game.accounts
    in if table == 0 | i >= ga-count table then 0
    else let hidden = cg-offline-slots owner (ga-slots table i) 0 in cg-offline owner (i + 1)
 Source-X addPlayerStart sends the player's war mode (0x72) on every login, and the 1.25 client keeps its own
 war flag across a relogin until told; a login starts in peace.
 The testing kit goes to British and to the soak bots, whose accounts proofs/soak-bots.ps1 names soakbot and a letter
 (the bots use it); every other character starts with its creation clothes and its skills' tools (cts-starter).
  cg-soak-bot : Integer -> Boolean
  cg-soak-bot (table) = let index = ga-bound table in index >= 0 & index < ga-count table & cg-name-starts (ga-at table index) cg-soak-name 0
  cg-soak-name : List Integer = [115, 111, 97, 107, 98, 111, 116]
  cg-name-starts : Integer, List Integer, Integer -> Boolean
  cg-name-starts (at) (prefix) (i) = if i >= list-length prefix then True
    else if ga-fold (peek-byte at i) /= list-at prefix i then False
    else cg-name-starts at prefix (i + 1)
  cg-peace : CompositeGame, GameShard, GameInput, GameReply -> GameReply
  cg-peace (owner) (game) (input) (reply) = let slot = world-slot game.world input.session.serial
    in let cleared = if slot < 0 then 0 else let a = list-at owner.combat.actors slot
      in if a.serial /= input.session.serial then 0 else let stopped = cb-stop owner.combat a in let peace = __record-set a "war" False in 0
    in gs-reply (list-push reply.packets (cbp-war False)) reply.note
  cg-entry : CompositeGame, GameShard, GameInput, WalkMap, GameReply -> Result GameReply Text
  cg-entry (owner) (game) (input) (map) (reply) = when world-get game.world input.session.serial
    is Err (e) -> Err e
    is Ok (mobile) -> let returned = cg-return owner input.session.serial in if mobile.health == 0 then Ok reply
      else when gsi-after-entry owner.items game input reply
        is Err (e) -> Err e
        is Ok (entered) -> when cg-bind owner input
          is Err (e) -> Err e
          is Ok (_) -> let lordly = if ga-is-british game.accounts then cg-immune owner game input.session.serial else 0
          in let tooled = if ga-is-british game.accounts then cg-lord-tools owner.production.harvest.items input.session.serial else 0
          in let kitted = owner.testing & (ga-is-british game.accounts | cg-soak-bot game.accounts)
          in when (if kitted | ga-is-british game.accounts then Ok 0 else cts-starter owner.items game input.session.serial)
           is Err (e) -> Err e
           is Ok (_) -> when cts-stock kitted (not (ga-is-british game.accounts)) owner.test-grants owner.banks game input entered
            is Err (e) -> Err e
            is Ok (stock) -> when cpr-kit-tools owner.production input.session.serial (gsi-pack-find game.world input.session.serial 0)
             is Err (e) -> Err e
             is Ok (_) -> when (if kitted then cpr-kit-tools owner.production input.session.serial (gmb-bank-find owner.banks.items input.session.serial 0) else Ok 0)
             is Err (e) -> Err e
             is Ok (_) -> when (if kitted then cpr-profession-bags owner.production input.session.serial (gmb-bank-find owner.banks.items input.session.serial 0) 1 else Ok 0)
             is Err (e) -> Err e
             is Ok (_) -> when (if kitted then cpr-extra-bags owner.production input.session.serial (gmb-bank-find owner.banks.items input.session.serial 0) 7 else Ok 0)
             is Err (e) -> Err e
             is Ok (_) -> when owner.magic
              is None -> Ok stock.reply
              is Just (magic) -> let books = cg-books magic game kitted (world-first-child game.world input.session.serial) 4
                in let chests = glk-register magic (gsi-pack-find game.world input.session.serial 0) (world-first-child game.world (gsi-pack-find game.world input.session.serial 0)) 3
                in when cg-kit-rune magic map stock.rune
                  is Err (e) -> Err e
                  is Ok (_) -> mg-entry magic game input stock.reply

  cg-pulse : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer -> [Device.Block] Result (Maybe GameReply) Text
  cg-pulse (owner) (game) (input) (map) (port) (tick) =
    let stamped = __record-set owner "clock" tick
    in let driven = (when owner.british is None -> 0 is Just (c) -> if input.mode == 2 & input.session.phase == 2 then cbe-drive c input.session.serial tick else 0)
    in let s0 = cg-stage-reset owner hpet-ticks 0
    in when cg-pulse-base owner game input map port tick
      is Err (e) -> act Err e end
      is Ok (prior) -> let s1 = cg-stage owner 1 in when cg-town owner game input map port tick
       is Err (e) -> act Err e end
       is Ok (town) -> let s2 = cg-stage owner 2 in act
        spelled <- cg-pulse-magic owner game input map port tick (cg-speakers owner input.session.serial (cg-combine prior town))
        when spelled
          is Err (e) -> Err e
          is Ok (base) -> let s3 = cg-stage owner 3 in when as-pulse (cg-as-services owner) owner.active game input
            is Err (e) -> Err e
            is Ok (more) -> let s4 = cg-stage owner 4 in Ok (cg-combine (cg-combine (cg-combine base more) (cg-camp owner game input tick)) (cg-folk-dare owner game input))
       end
  cg-pulse-magic : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer, Maybe GameReply -> [Device.Block] Result (Maybe GameReply) Text
  cg-pulse-magic (owner) (game) (input) (map) (port) (tick) (base) = when owner.magic
    is None -> act Ok base end
    is Just (magic) -> if input.mode /= 2 | input.session.phase /= 2 then act Ok base end else act
      spelled <- mg-pulse magic game input map port tick
      when spelled
        is Err (e) -> Err e
        is Ok (more) -> let corpses = when more is None -> 0 is Just (r) -> gr-corpse-packets owner.items r.packets 0
          in Ok (cg-combine base more)
    end
 The town runs a game day (86400 game seconds) in the admin panel's day length (GameClock day-seconds, panel-day-set);
 a server with no panel keeps GameClock's default 7200-second day, twelve game seconds per real second.
  cg-day-default : Integer -> Integer
  cg-day-default (unused) = 7200
  cg-game-ms : Integer, Integer -> Integer
  cg-game-ms (real-ms) (day-seconds) = real-ms * 86400 / (if day-seconds > 0 then day-seconds else 7200)
  cg-town-clock : CompositeGame, Integer -> Integer
  cg-town-clock (owner) (tick) = let elapsed = if owner.town-tick <= 0 | tick < owner.town-tick then 0 else tick - owner.town-tick
    in let real-ms = elapsed * pit-count * 1000 / pit-input-hz
    in let game-ms = owner.town-ms + cg-game-ms real-ms (owner.day-hook 0)
    in let seconds = __record-set owner "town-seconds" (owner.town-seconds + game-ms / 1000)
    in let carried = __record-set owner "town-ms" (int-mod game-ms 1000)
    in let stamped = __record-set owner "town-tick" tick in owner.town-seconds
  cg-economy-hours : EuCurrency, Integer, Integer -> Boolean
  cg-economy-hours (x) (target) (budget) = if x.world.hour >= target then x.world.hour == target
    else if budget == 0 then False
    else if eu-hour x < 0 then False
    else cg-economy-hours x target (budget - 1)
 The audit book holds 1024 events; past 960 the newest 512 move to the front.
  cg-rotate-rows : EaWorld, Integer, Integer, Integer -> Integer
  cg-rotate-rows (e) (drop) (i) (keep) = if i == keep then 0
    else let older = list-at e.events i
    in let newer = list-at e.events (drop + i)
    in let a = list-set-at e.events i newer
    in let b = list-set-at e.events (drop + i) older in cg-rotate-rows e drop (i + 1) keep
  cg-rotate : EaWorld -> Integer
  cg-rotate (e) = if e.event-count <= 960 then 0
    else let drop = e.event-count - 512
    in let moved = cg-rotate-rows e drop 0 512
    in let kept = __record-set e "event-count" 512 in drop
  cg-town-move : CompositeGame, TownLive, WalkMap, Integer -> Result GameReply Text
  cg-town-move (owner) (town) (britain) (seconds) = let stepping = cg-kind-switch owner.kind-time (cg-kinds + 13) in when cg-town-step owner town britain seconds
    is Err (e) -> Err e
    is Ok (r) -> let staffing = cg-kind-switch owner.kind-time (cg-kinds + 14) in when (when owner.staff is None -> Ok [] is Just (s) -> bsh-advance-marked s town britain owner.town-doors owner.magic seconds (\stage -> cg-kind-switch owner.kind-time (cg-kinds + 16 + stage)))
      is Err (e) -> Err e
      is Ok (kept) -> let governing = cg-kind-switch owner.kind-time (cg-kinds + 15) in let patrolled = when owner.civic
          is None -> []
          is Just (c) -> let retired = (if c.law.count < 96 & c.law.witness-count < 192 then 0 else let n = lw-retire c.law in if n == 0 then 0 else world-touch owner.checkpoint.game.world) in let ruled = cg-law-cases owner c 0 in let guarded = cg-guard-raiders owner c 0 in let raid = cg-raid-open owner in let mustered = (if not raid then 0 else when owner.town is None -> 0 is Just (t) -> cg-militia owner (cg-folk-serials t 0 []) 0) in let s0 = cg-kind-switch owner.kind-time (cg-civic-slot 0) in let alarmed = (if raid then [] else when owner.spawns is None -> [] is Just (s) -> cg-alarm owner c s seconds 0 (cg-npc-count owner) []) in let s1 = cg-kind-switch owner.kind-time (cg-civic-slot 1) in let chased = (when owner.spawns is None -> [] is Just (s) -> cg-guard-chase owner c s britain seconds 0 []) in let s2 = cg-kind-switch owner.kind-time (cg-civic-slot 2) in let raided = (when owner.spawns is None -> 0 is Just (s) -> cg-raid-take owner s 0) in let picked = (when owner.spawns is None -> 0 is Just (s) -> cg-pickup owner s 0) in let mined = (when owner.spawns is None -> 0 is Just (s) -> cg-spawn-mine owner s britain 0) in let wrecked = (when owner.spawns is None -> 0 is Just (s) -> cg-raid-wreck owner s) in let shut = cg-wreck-close owner town in let walled = cg-jail-walls owner c in let s3 = cg-kind-switch owner.kind-time (cg-civic-slot 3) in let buried = cg-dead-step owner c britain seconds 0 [] in let s4 = cg-kind-switch owner.kind-time (cg-civic-slot 4) in let advanced = cv-advance c britain owner.town-doors seconds 8 in let s5 = cg-kind-switch owner.kind-time (cg-civic-slot 5) in let walks = cg-city-patrols owner c 4 in when advanced is Err (_) -> alarmed & chased & buried & walks is Ok (p) -> alarmed & chased & buried & p.packets & walks
        in let s6 = cg-kind-switch owner.kind-time (cg-civic-slot 6)
        in let civil = when owner.civic is None -> [] is Just (c) -> cg-gov-step owner town britain c
        in let s7 = cg-kind-switch owner.kind-time (cg-civic-slot 7)
        in let seasoned = shp-season owner.ships seconds
        in let landed = shp-catch owner.vendor.currency.world (cg-fisher-actor owner.miners 0) seconds owner.ships
        in let wage = shp-pay-navy owner.vendor.currency seconds owner.ships.patrol
        in let moved = __record-set r "packets" (r.packets & kept & patrolled & civil)
        in let s8 = cg-kind-switch owner.kind-time (cg-civic-slot 8)
        in let synced = cg-door-sync owner moved.packets 0 in Ok moved
 The merchants' market (gla-market) posts again as each economy day begins, so stock made since (the baker's bread) is offered.
  cg-town-step : CompositeGame, TownLive, WalkMap, Integer -> Result GameReply Text
  cg-town-step (owner) (town) (britain) (seconds) = let doors = owner.town-doors in when owner.network
    is None -> tl-advance town britain doors seconds 8
    is Just (n) -> let day = town.vendors.currency.world.hour / 24
      in if not (cg-economy-hours town.vendors.currency (seconds / 3600) 24) then
        when tl-advance town britain doors seconds 8
          is Err (e) -> Err e
          is Ok (r) -> Ok (__record-set r "note" "town network paused: economy hour behind")
      else let rotated = cg-rotate n.actions.book
      in let charted = ch-record owner.history town.vendors
      in let marketed = if town.vendors.currency.world.hour / 24 > day then gla-market n.actions True else 0
      in let borrowed = bb-borrow-shops town.vendors 0
      in let repaid = bb-repay-shops town.vendors 0
      in let traded = bb-trade-up-shops town.vendors 0
      in when tnv-advance n britain doors seconds 3 8
        is Ok (r) -> Ok r
        is Err (refused) -> when tl-advance town britain doors seconds 8
          is Err (e) -> Err e
          is Ok (r) -> Ok (__record-set r "note" ("town network refused: " & refused))
  cg-town : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer -> Result (Maybe GameReply) Text
  cg-town (owner) (game) (input) (map) (port) (tick) = when owner.town
    is None -> Ok None
    is Just (town) -> if input.mode /= 2 | input.session.phase /= 2 then Ok None
      else when owner.town-map
        is None -> Err "townsfolk map unbound"
        is Just (britain) -> let s9 = cg-stage owner 9 in when tl-pulse town game input britain port tick
              is Err (e) -> Err e
              is Ok (spoken) -> let s10 = cg-stage owner 10 in when (when owner.lineup is None -> Ok None is Just (l) -> cgl-pulse l town game input)
                is Err (e) -> Err e
                is Ok (greeted) -> let s11 = cg-stage owner 11 in when (when owner.speech is None -> Ok None is Just (speech) -> ns-pulse speech game input britain port tick)
                  is Err (e) -> Err e
                  is Ok (hailed) -> let s12 = cg-stage owner 12 in Ok (cg-combine (cg-combine (cg-combine (cg-combine spoken greeted) hailed) (cg-town-show owner town britain game input)) (cg-play-show owner britain game input))
  cg-pulse-base : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer -> Result (Maybe GameReply) Text
  cg-pulse-base (owner) (game) (input) (map) (port) (tick) =
    let alive = when world-get game.world input.session.serial is Err (_) -> False is Ok (mobile) -> mobile.health > 0
    in when (if alive then gvd-pulse owner.vendor game input map port tick else Ok None)
    is Err (e) -> Err e
    is Ok (vendor) -> let s5 = cg-stage owner 5 in when cg-monsters owner game input map port tick
      is Err (e) -> Err e
      is Ok (combat) -> let s6 = cg-stage owner 6 in let registered = cg-items owner 0
        in let combined = cg-combine (when vendor is None -> None is Just (reply) -> Just (gmb-reply owner.items reply)) combat
        in when owner.decoration
          is None -> Ok (cg-combine combined (cg-flora-view owner game input map))
          is Just (state) -> when wd-pulse state game input map port tick
            is Err (e) -> Err e
            is Ok (decoration) -> let s7 = cg-stage owner 7 in when (if input.mode /= 2 | input.session.phase /= 2 | not (wd-bound state) then Ok [] else cg-timers owner state game tick (cg-worker-say owner.farmer game & cg-worker-say owner.gatherer game))
              is Err (e) -> Err e
              is Ok (closed) -> let both = cg-combine (cg-combine combined decoration) (cg-flora-view owner game input map)
                in Ok (if list-length closed == 0 then both else cg-combine both (Just (gs-reply closed "decoration:autoclose")))
  cg-flora-view : CompositeGame, GameShard, GameInput, WalkMap -> Maybe GameReply
  cg-flora-view (owner) (game) (input) (map) = if input.mode /= 2 | input.session.phase /= 2 then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (mobile) -> let flora = when owner.flora
          is None -> []
          is Just (s) -> let synced = cg-flora-sync owner.production.harvest s owner.items.tiles map owner.town-map 0
            in wf-view s input.connection mobile.x mobile.y
        in let grounded = cpl-collide owner.production.harvest owner.items.tiles map 0 + (when owner.town-map is None -> 0 is Just (britain) -> cpl-collide owner.production.harvest owner.items.tiles britain 0)
        in let housed = cn-collide owner.construction owner.items.tiles map owner.town-seconds 0 + (when owner.town-map is None -> 0 is Just (britain) -> cn-collide owner.construction owner.items.tiles britain owner.town-seconds 0)
        in let packets = flora & cpl-view owner.planting owner.production.harvest input.connection mobile.x mobile.y & cn-view owner.construction map input.connection mobile.x mobile.y owner.town-seconds
          & shp-view owner.ships input.connection mobile.x mobile.y owner.town-seconds
          & gmo-view owner.overlay owner.civic (when owner.spawns is None -> [] is Just (g) -> g.catalog.regions) owner.land map input.connection mobile
        in if list-length packets == 0 then None else Just (gs-reply packets "flora:view")
  cg-flora-sync : GameHarvest, WfState, Integer, WalkMap, Maybe WalkMap, Integer -> Integer
  cg-flora-sync (h) (s) (tiles) (map) (town) (i) = if i >= h.count then 0
    else let site = list-at h.sites i
    in let w = h.vendor.currency.world
    in let synced = if site.resource /= 15 | not (eh-valid-node w site.node) then 0
      else let n = list-at w.nodes (site.node - 1)
      in let stage = if n.stage == 0 & w.hour >= n.ready - eh-span n.resource 0 then 4 else n.stage
      in let changed = wf-site-sync s i site.x site.y stage
      in if stage /= 2 | changed > 0 then
        let here = wf-ground s tiles map site.x site.y (stage == 2)
        in when town is None -> here is Just (britain) -> here + wf-ground s tiles britain site.x site.y (stage == 2)
      else 0
    in cg-flora-sync h s tiles map town (i + 1)
  cg-flora-target : CompositeGame, List Integer -> List Integer
  cg-flora-target (owner) (packet) = let planted = cpl-target-packet owner.production.harvest packet
    in let grown = when owner.flora is None -> planted is Just (s) -> wf-target-packet s planted
    in when owner.decoration is None -> grown is Just (d) -> cpr-heat-target (wd-target-packet d grown) grown
 UOAIX-216: the wheel's drain charges each fired entry's HPET ticks and a count to its kind, so TICK SLOW names the kind
 (cs-tick-slow). The buffer holds the running slot (0 none) at 0, its start at 8, then 16 bytes a slot: kind k at slot k,
 and the station kind's key k (cgs-kind, the most of the wheel in trial 43315) at slot cg-kinds + k, said as 13.k; the townsfolk
 walk (key 8, nearly all of kind 13 in trial 43328) charges its town step to 13.13, its staff to 13.14 and its patrols,
 government and ships to 13.15 (cg-kind-switch in cg-town-move); the staff step's own stages are 13.16 closing flags,
 13.17 open/close turn, 13.18 door bars, 13.19 keepers (bsh-advance-marked), keeper i's step 13.(20 + i). 13.15 keeps the law
 and the militia; the rest of its civic step is said after the keepers (cg-civic-slot j, 13.41 on): 0 alarms, 1 guard chase,
 2 raids, pickup, spawn mining, wrecks and jail walls, 3 the dead, 4 cv-advance, 5 city patrols, 6 government, 7 ships, 8 door sync.
  cg-kinds : Integer = 32
  cg-civic-slots : Integer = 9
  cg-civic-slot : Integer -> Integer
  cg-civic-slot (j) = cg-kinds + 20 + bb-shop-count + j
  cg-kind-slots : Integer = cg-kinds + 20 + bb-shop-count + cg-civic-slots
  cg-kind-bytes : Integer = 16 + cg-kind-slots * 16
  cg-kind-charge : Integer -> Integer
  cg-kind-charge (b) = let k = peek-qword b 0
    in if k <= 0 then 0
    else if k >= cg-kind-slots then poke-qword b 0 0
    else let at = 16 + k * 16
    in let spent = poke-qword b at (peek-qword b at + hpet-ticks - peek-qword b 8)
    in let counted = poke-qword b (at + 8) (peek-qword b (at + 8) + 1)
    in poke-qword b 0 0
  cg-kind-begin : Integer, Integer, Integer -> Integer
  cg-kind-begin (b) (kind) (key) = let slot = if kind == cgs-kind & key >= 0 & key < 16 then cg-kinds + key else if kind >= cg-kinds then cg-kind-slots else kind
    in let a = poke-qword b 0 slot in poke-qword b 8 hpet-ticks
  cg-kind-switch : Integer, Integer -> Integer
  cg-kind-switch (b) (slot) = if peek-qword b 0 <= 0 then 0 else let charged = cg-kind-charge b in let a = poke-qword b 0 slot in poke-qword b 8 hpet-ticks
  cg-kind-reset : Integer, Integer -> Integer
  cg-kind-reset (b) (i) = if i >= cg-kind-bytes / 8 then 0 else let z = poke-qword b (i * 8) 0 in cg-kind-reset b (i + 1)
 Each kind that fired, as kind:microseconds/count (rate: HPET ticks a second).
  cg-kind-said : Integer, Integer, Integer, Text -> Text
  cg-kind-said (b) (rate) (k) (out) = if k >= cg-kind-slots then out
    else let n = peek-qword b (16 + k * 16 + 8)
    in cg-kind-said b rate (k + 1) (if n == 0 then out else out & " " & (if k >= cg-kinds then show cgs-kind & "." & show (k - cg-kinds) else show k) & ":" & show (peek-qword b (16 + k * 16) * 1000000 / max 1 rate) & "/" & show n)
  cg-timers : CompositeGame, WdState, GameShard, Integer, List (List Integer) -> Result (List (List Integer)) Text
  cg-timers (owner) (state) (game) (tick) (packets) = let charged = cg-kind-charge owner.kind-time
    in let e = wtm-next owner.timers tick
    in let begun = if e < 0 then 0 else cg-kind-begin owner.kind-time owner.timers.kind owner.timers.key
    in if e < 0 then Ok packets
    else if owner.timers.kind == cb-regen-timer then when cb-regen-fire owner.combat game owner.timers.key
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets
    else if owner.timers.kind == clb-kind then (when owner.town
      is None -> Err "shift timer without townsfolk"
      is Just (town) -> if (when owner.town-map is None -> -1 is Just (britain) -> clb-fire town owner.timers britain owner.town-doors owner.timers.key tick (owner.day-hook 0)) == -2 then Err "shift timer pool full"
        else cg-timers owner state game tick packets)
    else if owner.timers.kind == cgm-kind then (when cg-miner owner owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick (packets & cg-miner-show owner game owner.timers.key))
    else if owner.timers.kind == cgw-kind then (when cg-worker owner owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cg-city-kind then (when cg-city-worker owner owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cgs-kind then (when cg-station-fire owner owner.timers.key tick
      is Err (e) -> Err e
      is Ok (moved) -> cg-timers owner state game tick (packets & moved))
    else if owner.timers.kind == cgr-kind then (when cg-round-fire owner game owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cgd-kind then (when cg-store-fire owner owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cb-corpse-kind then let rotted = cg-decay-fire owner owner.timers.key tick in cg-timers owner state game tick packets
    else if owner.timers.kind == cg-ground-kind then let rotted = cg-ground-fire owner owner.timers.key tick in cg-timers owner state game tick packets
    else if owner.timers.kind == gws-kind then (when cg-spawn-wake owner game owner.timers.key tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cg-linger-kind then let gone = cg-departed owner owner.timers.key in cg-timers owner state game tick packets
    else if owner.timers.kind == gh-kind then let fell = cg-hunger-fire owner game owner.timers.key in cg-timers owner state game tick packets
    else if owner.timers.kind == cf-kind then (when cf-tick owner.camps owner.timers game.world owner.timers.key tick
      is Err (e) -> Err e
      is Ok (fire) -> cg-timers owner state game tick (packets & fire))
    else if owner.timers.kind == mgs-kind then (when owner.magic
      is None -> Err "magery timer without magery"
      is Just (magic) -> let pushed = mgs-fired magic owner.timers.key in cg-timers owner state game tick packets)
    else if owner.timers.kind == cgf-kind then (when cg-errand-of owner game tick owner.timers.key
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cbe-kind then (when cg-british owner game tick
      is Err (e) -> Err e
      is Ok (_) -> cg-timers owner state game tick packets)
    else if owner.timers.kind == cg-rise-kind then let risen = cg-rise owner owner.timers.key in cg-timers owner state game tick packets
    else if owner.timers.kind == plr-kind then (if cg-play-fire owner game tick owner.timers.key < 0 then Err "play timer pool full" else cg-timers owner state game tick packets)
    else if owner.timers.kind /= wd-door-timer then Err "world timer kind"
    else let row = owner.timers.key
    in let closed = wd-autoclose state owner.timers game row tick
    in let synced = if list-length closed == 0 then 0 else cg-door-cells owner.town-doors row
    in cg-timers owner state game tick (packets & closed)
  cg-town-doors : CompositeGame, Integer, Integer -> Result Integer Text
  cg-town-doors (owner) (data) (size) = when owner.town
    is None -> Ok 0
    is Just (_) -> when owner.town-map
      is None -> Ok 0
      is Just (britain) -> when owner.decoration
        is None -> Ok 0
        is Just (shown) -> when wd-read data size britain britain.stride
          is Err (e) -> Err e
          is Ok (doors) -> let shared = __record-set doors "opened" shown.opened
            in let clean = wd-restore doors
            in when wd-rebind doors britain britain.stride
              is Err (e) -> Err e
              is Ok (_) -> let bound = __record-set owner "town-doors" (Just doors)
                in when owner.town
                  is None -> Ok 1
                  is Just (town) -> when tl-resettle town britain 0
                    is Err (e) -> Err e
                    is Ok (_) -> let beds = cg-own-beds owner
                      in let reached = cg-miner-nodes owner town britain (Just doors) 0
                      in when (when owner.shops is None -> Ok None is Just (_) -> when bsh-new town britain (Just doors) (cg-worker-homes owner) owner.leisure is Err (e) -> Err e is Ok (s) -> Ok (Just s))
                        is Err (e) -> Err e
                        is Ok (staff) -> let kept = __record-set owner "staff" staff in let founded = cg-civic-found owner town britain in Ok 1
 The law (UOAIX.md section 5, R3): a player's theft attempt, landed blow or kill against an innocent (a player or a town NPC
 who is not wanted) is a deed of Britain (town 1). Notoriety is classic and every deed moves it, witnessed or not: five
 murders mark a murderer (6, red), and an open known case marks a criminal (4, grey). A theft or assault opens one case at
 a time per offender. Everyone in sight within 12 tiles witnesses the deed; an NPC witness tells and calls the nearest
 guard in earshot, who comes on foot (CivicLive).
  cg-murders : LawWorld, Integer, Integer -> Integer
  cg-murders (w) (serial) (i) = if i >= w.count then 0
    else (if (list-at w.cases i).offender == serial & (list-at w.cases i).kind == 3 then 1 else 0) + cg-murders w serial (i + 1)
  cg-wanted : LawWorld, Integer, Integer -> Boolean
  cg-wanted (w) (serial) (i) = if i >= w.count then False
    else let c = list-at w.cases i in (c.offender == serial & ((c.known & c.status < 4) | (c.status < 3 & w.hour <= c.due + 1)))
      | cg-wanted w serial (i + 1)
  cg-open-kind : LawWorld, Integer, Integer, Integer -> Boolean
  cg-open-kind (w) (serial) (kind) (i) = if i >= w.count then False
    else let c = list-at w.cases i in (c.offender == serial & c.kind == kind & c.status < 4 & (c.known | w.hour <= c.due + 1))
      | cg-open-kind w serial kind (i + 1)
  cg-notoriety : CompositeGame, Integer -> Integer
  cg-notoriety (owner) (serial) = when owner.civic
    is None -> 0
    is Just (c) -> if cg-murders c.law serial 0 >= 5 then 6 else if cg-wanted c.law serial 0 then 4 else 0
 What the client view draws: the law's mark first, else a spawn's UOX3 notoriety (a brigand is a murderer, 6), so the
 1.25 client asks "This will lower notoriety !" only before an attack on an innocent (1).
  cg-view-notoriety : CompositeGame, Integer -> Integer
  cg-view-notoriety (owner) (serial) = let law = cg-notoriety owner serial
    in if law > 0 then law
    else when owner.spawns
      is None -> 0
      is Just (g) -> let i = gws-slot-of g serial 0 in if i < 0 then 0 else wsi-notoriety (list-at g.slots i).profile
 UOX3 and ServUO aggressor rule: striking a creature that is attacking you is never a crime.
  cg-aggressor : CompositeGame, Integer, Integer -> Boolean
  cg-aggressor (owner) (victim) (offender) = let slot = world-slot owner.items.world victim
    in if slot < 0 | slot >= list-length owner.combat.actors then False
    else let fight = list-at owner.combat.actors slot in fight.serial == victim & fight.war & fight.target == offender
  cg-banker-is : GmbState, Integer, Integer -> Boolean
  cg-banker-is (b) (serial) (i) = if i >= b.count then False else list-at b.bankers i == serial | cg-banker-is b serial (i + 1)
  cg-townsman : CompositeGame, CivicLive, Integer -> Boolean
  cg-townsman (owner) (c) (serial) = gv-player owner.vendor serial 0 >= 0 | gv-vendor owner.vendor serial 0 >= 0
    | cv-role c serial > 0 | cg-banker-is owner.banks serial 0 | tl-person-for c.town serial 0 > 0
 A shop refuses a player whom its keeper, or a resident working there, saw commit a deed (lw-remembers, UOAIX.md section 5:
 NPCs remember criminals they saw and can refuse service).
  cg-shun : CompositeGame, Integer, Integer -> Integer
  cg-shun (owner) (shop) (player) = when owner.civic
    is None -> 0
    is Just (c) -> if shop < 0 | shop >= bb-shop-count | shop >= owner.vendor.vendor-count then 0
      else if lw-remembers c.law (list-at owner.vendor.vendors shop).serial player 0 | cg-shun-folk c shop player 0 then 1 else 0
  cg-shun-folk : CivicLive, Integer, Integer, Integer -> Boolean
  cg-shun-folk (c) (shop) (player) (r) = if r >= c.town.count then False
    else (tl-shop-of r == shop & lw-remembers c.law (tf-person c.town.people (list-at c.town.residents r).person).world-serial player 0)
      | cg-shun-folk c shop player (r + 1)
 Consensual duels (R3, Damian 2026-10-04): a player saying "I challenge thee ... to a duel" challenges the nearest other
 player within 8 tiles, who accepts by saying "I accept". Between duellists no blow or kill is a deed, and a bare-handed
 blow subdues: it stops at 1 hit point, knocks the loser down, ends both fighters' attacks and the duel. Armed blows follow
 the normal rules. Duels are not saved.
  CgDuel = record { a : Integer, b : Integer, accepted : Boolean }
  cg-duel-slots : Integer, List CgDuel -> List CgDuel
  cg-duel-slots (n) (xs) = if n == 0 then xs else cg-duel-slots (n - 1) (list-push xs (CgDuel { a = 0, b = 0, accepted = False }))
  cg-duel-of : List CgDuel, Integer, Integer, Integer -> Integer
  cg-duel-of (ds) (x) (y) (i) = if i >= list-length ds then -1
    else let d = list-at ds i in if d.accepted & ((d.a == x & d.b == y) | (d.a == y & d.b == x)) then i else cg-duel-of ds x y (i + 1)
  cg-duel-free : List CgDuel, Integer -> Integer
  cg-duel-free (ds) (i) = if i >= list-length ds then -1 else if (list-at ds i).a == 0 then i else cg-duel-free ds (i + 1)
  cg-duel-pending : List CgDuel, Integer, Integer -> Integer
  cg-duel-pending (ds) (me) (i) = if i >= list-length ds then -1
    else let d = list-at ds i in if d.a /= 0 & d.b == me & not d.accepted then i else cg-duel-pending ds me (i + 1)
  cg-duel-end : CgDuel -> Integer
  cg-duel-end (d) = let a = __record-set d "a" 0 in let b = __record-set d "b" 0 in let c = __record-set d "accepted" False in 0
  cg-duel-clear : List CgDuel, Integer, Integer -> Integer
  cg-duel-clear (ds) (serial) (i) = if i >= list-length ds then 0
    else let d = list-at ds i in (if d.a == serial | d.b == serial then cg-duel-end d else 0) + cg-duel-clear ds serial (i + 1)
  cg-duel-near : CompositeGame, WorldObject, Integer, Integer, Integer -> Integer
  cg-duel-near (owner) (me) (i) (best) (distance) = if i >= owner.vendor.player-count then best
    else let serial = (list-at owner.vendor.players i).serial
    in when (if serial == me.serial then Err "self" else world-get owner.checkpoint.game.world serial)
      is Err (_) -> cg-duel-near owner me (i + 1) best distance
      is Ok (m) -> let d = max (walk-abs (m.x - me.x)) (walk-abs (m.y - me.y))
        in if m.kind == 1 & m.health > 0 & d <= 8 & (best == 0 | d < distance) then cg-duel-near owner me (i + 1) serial d else cg-duel-near owner me (i + 1) best distance
  cg-duel-said : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-duel-said (owner) (game) (input) (packet) = if list-length packet < 9 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 | not (gp-speech-valid packet) then None
    else let text = gp-speech-text packet
    in let challenge = ns-has text "challenge" & ns-has text "duel"
    in if ns-has text "drink" & (ns-has text "buy" | ns-has text "round") & not challenge then cg-round-said owner game input
    else let accept = ns-has text "accept"
    in if not challenge & not accept then None
    else let slot = gv-slot game input.session.serial 0
    in if slot < 0 then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (me) -> let echo = gp-speech me game.characters slot packet
        in if challenge then (let other = cg-duel-near owner me 0 0 100
          in let free = cg-duel-free owner.duels 0
          in if other == 0 & free >= 0 then cg-duel-folk owner game me echo free
          else if other == 0 | free < 0 then Just (gs-reply [echo, gs-system "No one near can answer thy challenge."] "duel:none")
          else let d = list-at owner.duels free
          in let a = __record-set d "a" me.serial in let b = __record-set d "b" other in let c = __record-set d "accepted" False
          in Just (gs-reply [echo, gs-system "Thy challenge is made. They may say: I accept."] "duel:challenge"))
        else let pending = cg-duel-pending owner.duels me.serial 0
        in if pending < 0 then None
        else let on = __record-set (list-at owner.duels pending) "accepted" True in let dared = if gv-player owner.vendor (list-at owner.duels pending).a 0 < 0 then cg-attack owner (list-at owner.duels pending).a me.serial else 0
        in Just (gs-reply [echo, gs-system "The duel is on. Bare fists strike to subdue."] "duel:accept")
 With no player near, Silas the gambler answers a challenge within 8 tiles: after two rounds he takes it and swings first,
 sober he refuses (UOAIX.md R3: an NPC who has been drinking is more likely to accept).
  cg-duel-silas : CompositeGame, GameShard, WorldObject, List Integer, Integer -> Maybe GameReply
  cg-duel-silas (owner) (game) (me) (echo) (free) = let items = owner.production.harvest.items
    in let silas = tbd-gambler items.world (world-tile-first items.world tbd-patron-x tbd-patron-y)
    in when (if silas == 0 then Err "absent" else world-get game.world silas)
      is Err (_) -> Just (gs-reply [echo, gs-system "No one near can answer thy challenge."] "duel:none")
      is Ok (m) -> if walk-abs (m.x - me.x) > 8 | walk-abs (m.y - me.y) > 8 | m.health <= 0 then Just (gs-reply [echo, gs-system "No one near can answer thy challenge."] "duel:none")
        else let cup = tbd-cup items.world (world-tile-first items.world (tbd-cup-x tbd-home 0) (tbd-cup-y tbd-home 0))
        in let rounds = if cup == 0 then 0 else when world-get items.world cup is Err (_) -> 0 is Ok (o) -> o.health / tbd-drink-unit
        in if rounds < 2 then Just (gs-reply [echo, sip-message silas 0 6 "Silas laughs. 'Fight thee? Not while I am sober, friend.'"] "duel:refused")
        else let d = list-at owner.duels free
        in let a = __record-set d "a" me.serial in let b = __record-set d "b" silas in let c = __record-set d "accepted" True
        in let swung = cg-attack owner silas me.serial
        in Just (gs-reply [echo, sip-message silas 0 6 "Silas rolls up his sleeves. 'Fists only, mind!'"] "duel:silas")
 Townsfolk drink too (UOAIX.md section 5, the law: drunkenness rises with each drink and wears off with time). A player
 who says "buy thee a drink" (or "a round") beside a resident in sight pays the tavern Silas's price for the round and
 the resident drinks: one round more, at most 4, and one wears off each game hour. The rounds live in memory, as the
 duels do: 64 rows of serial, rounds, and the game hour of the last drink.
  cg-rounds-limit : Integer = 64
  cg-rounds-new : Integer -> Integer
  cg-rounds-new (unused) = let buf = alloc-bytes (cg-rounds-limit * 24) in let cleared = ts-zero buf (cg-rounds-limit * 24) 0 in buf
  cg-round-row : Integer, Integer, Integer -> Integer
  cg-round-row (buf) (serial) (i) = if i >= cg-rounds-limit then -1 else if peek-qword buf (i * 24) == serial then i else cg-round-row buf serial (i + 1)
  cg-drink-level : CompositeGame, Integer -> Integer
  cg-drink-level (owner) (serial) = let row = cg-round-row owner.rounds serial 0
    in if row < 0 | serial == 0 then 0
    else max 0 (peek-qword owner.rounds (row * 24 + 8) - (owner.town-seconds / 3600 - peek-qword owner.rounds (row * 24 + 16)))
  cg-drink-add : CompositeGame, Integer -> Integer
  cg-drink-add (owner) (serial) = let level = cg-drink-level owner serial
    in let found = cg-round-row owner.rounds serial 0
    in let row = if found >= 0 then found else let free = cg-round-row owner.rounds 0 0 in if free >= 0 then free else int-mod serial cg-rounds-limit
    in let a = poke-qword owner.rounds (row * 24) serial
    in let b = poke-qword owner.rounds (row * 24 + 8) (min 4 (level + 1))
    in let c = poke-qword owner.rounds (row * 24 + 16) (owner.town-seconds / 3600) in min 4 (level + 1)
 The nearest living resident within range of me whom me can see on Britain's map, or 0.
  cg-folk-near : CompositeGame, WorldObject, Integer -> Integer
  cg-folk-near (owner) (me) (range) = when owner.town
    is None -> 0
    is Just (t) -> cg-folk-pick owner me range (cg-folk-serials t 0 []) 0 0 1000
  cg-folk-pick : CompositeGame, WorldObject, Integer, List Integer, Integer, Integer, Integer -> Integer
  cg-folk-pick (owner) (me) (range) (serials) (i) (best) (distance) = if i >= list-length serials then best
    else let serial = list-at serials i
    in when (if serial == 0 then Err "none" else world-get owner.checkpoint.game.world serial)
      is Err (_) -> cg-folk-pick owner me range serials (i + 1) best distance
      is Ok (m) -> let d = max (walk-abs (m.x - me.x)) (walk-abs (m.y - me.y))
        in if m.kind == 1 & m.health > 0 & d <= range & d < distance & (when owner.town-map is None -> True is Just (britain) -> tl-sight britain m me)
          then cg-folk-pick owner me range serials (i + 1) serial d
        else cg-folk-pick owner me range serials (i + 1) best distance
  cg-round-said : CompositeGame, GameShard, GameInput -> Maybe GameReply
  cg-round-said (owner) (game) (input) = when world-get game.world input.session.serial
    is Err (_) -> None
    is Ok (me) -> let folk = cg-folk-near owner me 2
      in if folk == 0 then None
      else let v = owner.vendor
      in let at = gv-player v input.session.serial 0
      in if at < 0 | tbd-house >= list-length v.vendors then None
      else if cg-drink-level owner folk >= 4 then Just (gs-reply [sip-message folk 0 6 "No more for me, friend."] "drink:full")
      else let w = v.currency.world
      in let paid = eu-pay v.currency True (ep-actor w (list-at v.players at).actor).purse (ep-actor w (list-at v.vendors tbd-house).actor).purse tbd-round-price 0 0
      in if paid /= 0 then Just (gsi-denied ("A round costs " & show tbd-round-price & " copper."))
      else let level = cg-drink-add owner folk
      in Just (gs-reply [sip-message folk 0 6 (if level >= 3 then "*hic* Thy health, friend!" else "Thy health!")] "drink:round")
 A resident three rounds drunk challenges a player within 3 tiles in sight aloud (UOAIX.md section 5: an NPC's mind
 decides whether to issue a challenge; drink matters) and spends a round on the boast; "I accept" starts the fight with
 the resident swinging first (cg-duel-said), and the challenge lapses when the player is more than 8 tiles away.
  cg-drink-spend : CompositeGame, Integer -> Integer
  cg-drink-spend (owner) (serial) = let row = cg-round-row owner.rounds serial 0
    in if row < 0 then 0 else poke-qword owner.rounds (row * 24 + 8) (max 0 (cg-drink-level owner serial - 1))
  cg-duel-with : List CgDuel, Integer, Integer -> Integer
  cg-duel-with (ds) (me) (i) = if i >= list-length ds then -1
    else let d = list-at ds i in if d.a == me | d.b == me then i else cg-duel-with ds me (i + 1)
  cg-folk-dare : CompositeGame, GameShard, GameInput -> Maybe GameReply
  cg-folk-dare (owner) (game) (input) = if input.mode /= 2 | input.session.phase /= 2 then None
    else when world-get game.world input.session.serial
      is Err (_) -> None
      is Ok (me) -> if me.health <= 0 then None
        else let held = cg-duel-with owner.duels me.serial 0
        in if held >= 0 then
          (let d = list-at owner.duels held
          in let lapsed = if d.accepted | d.b /= me.serial | gv-player owner.vendor d.a 0 >= 0 then 0
            else when world-get game.world d.a
              is Err (_) -> cg-duel-end d
              is Ok (npc) -> if max (walk-abs (npc.x - me.x)) (walk-abs (npc.y - me.y)) > 8 then cg-duel-end d else 0
          in None)
        else let folk = cg-folk-near owner me 3
        in let free = cg-duel-free owner.duels 0
        in if folk == 0 | free < 0 | cg-drink-level owner folk < 3 then None
        else let d = list-at owner.duels free
        in let a = __record-set d "a" folk in let b = __record-set d "b" me.serial in let c = __record-set d "accepted" False
        in let spent = cg-drink-spend owner folk
        in Just (gs-reply [sip-message folk 0 6 ("*hic* I challenge thee, " & as-mobile-name owner.active game me.serial & ", to a duel! Fists only!")] "duel:dare")
 With no player near, a resident within 8 tiles in sight answers a challenge: after two rounds the resident takes it and
 swings first, sober the resident refuses; with no resident near, Silas answers as before.
  cg-duel-folk : CompositeGame, GameShard, WorldObject, List Integer, Integer -> Maybe GameReply
  cg-duel-folk (owner) (game) (me) (echo) (free) = let folk = cg-folk-near owner me 8
    in if folk == 0 then cg-duel-silas owner game me echo free
    else if cg-drink-level owner folk < 2 then Just (gs-reply [echo, sip-message folk 0 6 "Fight thee? Buy me a drink first, then we shall see."] "duel:refused")
    else let d = list-at owner.duels free
    in let a = __record-set d "a" me.serial in let b = __record-set d "b" folk in let c = __record-set d "accepted" True
    in let swung = cg-attack owner folk me.serial
    in Just (gs-reply [echo, sip-message folk 0 6 "Ha! Fists only, and no hard feelings!"] "duel:folk")
  cg-subdue : CompositeGame, Integer, Integer, Integer -> Integer
  cg-subdue (owner) (source) (target) (damage) = let i = cg-duel-of owner.duels source target 0
    in if i < 0 | owner.combat.weapon-hook source /= 0 then damage
    else when world-get owner.checkpoint.game.world target
      is Err (_) -> damage
      is Ok (m) -> if damage < m.health then damage
        else let ended = cg-duel-end (list-at owner.duels i)
        in let calm-a = when cb-ensure owner.combat owner.checkpoint.game source is Err (_) -> 0 is Ok (a) -> cb-stop owner.combat a
        in let calm-b = when cb-ensure owner.combat owner.checkpoint.game target is Err (_) -> 0 is Ok (b) -> cb-stop owner.combat b
        in max 0 (m.health - 1)
 Testimony (UOAIX.md section 5: a witnessing NPC can testify later): a player asking a town NPC within 3 tiles what it saw
 ("witness" or "what didst thou see") hears the deeds that NPC witnessed, at most the two latest.
  cg-crime-word : Integer -> Text
  cg-crime-word (kind) = if kind == 1 then "thieving" else if kind == 2 then "assault" else "murder"
  cg-testimony : CompositeGame, GameShard, LawWorld, Integer, Integer, Integer, List Text -> List Text
  cg-testimony (owner) (game) (w) (npc) (i) (left) (out) = if i < 0 | left == 0 then out
    else let r = list-at w.witnesses i
    in if not r.npc | r.serial /= npc then cg-testimony owner game w npc (i - 1) left out
    else let c = lw-case w r.case-id
    in let name = as-mobile-name owner.active game c.offender
    in cg-testimony owner game w npc (i - 1) (left - 1) (list-push out ("I saw " & (if text-length name == 0 then "someone" else name) & " commit " & cg-crime-word c.kind & "."))
  cg-testify-npc : CompositeGame, CivicLive, WorldObject, List Integer, Integer -> Integer
  cg-testify-npc (owner) (c) (me) (serials) (i) = if i >= list-length serials then 0
    else let serial = list-at serials i
    in when (if serial == 0 then Err "none" else world-get owner.checkpoint.game.world serial)
      is Err (_) -> cg-testify-npc owner c me serials (i + 1)
      is Ok (m) -> if m.kind == 1 & m.health > 0 & walk-abs (m.x - me.x) <= 3 & walk-abs (m.y - me.y) <= 3
        & (when owner.town-map is None -> True is Just (britain) -> tl-sight britain m me) then serial else cg-testify-npc owner c me serials (i + 1)
  cg-testify-said : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-testify-said (owner) (game) (input) (packet) = when owner.civic
    is None -> None
    is Just (c) -> if list-length packet < 9 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 | not (gp-speech-valid packet) then None
      else let text = gp-speech-text packet
      in if not (ns-has text "witness") & not (ns-has text "what" & ns-has text "see") then None
      else let slot = gv-slot game input.session.serial 0
      in if slot < 0 then None
      else when world-get game.world input.session.serial
        is Err (_) -> None
        is Ok (me) -> let npc = cg-testify-npc owner c me (cg-vendor-serials owner.vendor 0 [] & cg-folk-serials c.town 0 [] & (cg-civic-serials c 0 [c.mayor])) 0
          in if npc == 0 then None
          else when world-get game.world npc
            is Err (_) -> None
            is Ok (m) -> let lines = cg-testimony owner game c.law npc (c.law.witness-count - 1) 2 []
              in let said = if list-length lines == 0 then ["I have seen no crime."] else lines
              in Just (gs-reply ([gp-speech me game.characters slot packet] & cg-testimony-packets m said 0 []) "law:testimony")
  cg-testimony-packets : WorldObject, List Text, Integer, List (List Integer) -> List (List Integer)
  cg-testimony-packets (m) (lines) (i) (out) = if i >= list-length lines then out
    else cg-testimony-packets m lines (i + 1) (list-push out (gvp-speech m "" (list-at lines i)))
  cg-theft : CompositeGame, Integer, Integer -> Integer
  cg-theft (owner) (thief) (victim) = cg-crime owner thief victim 1
  cg-crime : CompositeGame, Integer, Integer, Integer -> Integer
  cg-crime (owner) (offender) (victim) (kind) = when owner.civic
    is None -> 0
    is Just (c) -> if offender == victim | gv-player owner.vendor offender 0 < 0 | not (cg-townsman owner c victim) | cg-notoriety owner victim > 0
        | cg-duel-of owner.duels offender victim 0 >= 0 | cg-aggressor owner victim offender
        | (kind /= 3 & cg-open-kind c.law offender kind 0) then 0
      else let id = lw-deed c.law True (lw-next-source c.law 0 0) offender kind (cg-crime-town owner offender)
      in if id < 1 then 0
      else let seen = cg-witnesses owner c id offender
      in let touched = world-touch owner.checkpoint.game.world in id
  cg-witnesses : CompositeGame, CivicLive, Integer, Integer -> Integer
  cg-witnesses (owner) (c) (id) (offender) = when owner.town-map
    is None -> 0
    is Just (map) -> when world-get owner.checkpoint.game.world offender
      is Err (_) -> 0
      is Ok (doer) -> let v = owner.vendor
        in let seen = when cg-city-map owner doer.x doer.y is Just (m) -> m is None -> map
        in let shops = cg-witness-list owner c doer seen id (cg-vendor-serials v 0 []) 0
        in let folk = cg-witness-list owner c doer seen id (cg-folk-serials c.town 0 []) 0
        in let civic = cg-witness-list owner c doer seen id (cg-civic-serials c 0 [c.mayor] & cg-city-serials c 0 []) 0
        in let players = cg-witness-list owner c doer seen id (cg-player-serials v 0 []) 0
        in shops + folk + civic + players
  cg-living-count : WorldTable, List Integer, Integer, Integer -> Integer
  cg-living-count (world) (serials) (i) (n) = if i >= list-length serials then n
    else cg-living-count world serials (i + 1) (n + (when world-get world (list-at serials i) is Ok (m) -> (if m.kind == 1 & m.health > 0 then 1 else 0) is Err (_) -> 0))
  cg-first-serials : List Integer, Integer, Integer, List Integer -> List Integer
  cg-first-serials (serials) (n) (i) (out) = if i >= n | i >= list-length serials then out else cg-first-serials serials n (i + 1) (list-push out (list-at serials i))
 Every living Britain person but the shopkeepers, each once: the bank lineup's resident and eight shopkeepers are copies
 of people counted under their own serials, and its banker is a banker of its own.
  cg-town-people : CompositeGame -> List Integer
  cg-town-people (s) = let folk = when s.town is None -> [] is Just (t) -> cg-folk-serials t 0 []
    in let lead = when s.gatherer is None -> [] is Just (g) -> [g.serial]
    in let farm = when s.farmer is None -> [] is Just (f) -> [f.serial]
    in let civic = when s.civic is None -> [] is Just (c) -> cg-civic-serials c 0 [c.mayor]
    in let crew = when s.crew is None -> [] is Just (k) -> [k.serial]
    in folk & lead & farm & cg-miner-serials s.miners 0 [] & cg-first-serials s.banks.bankers s.banks.count 0 [] & civic & crew
      & [cmr-serial s.production.harvest.items.world, cg-silas s]
  cg-vendor-serials : GvWorld, Integer, List Integer -> List Integer
  cg-vendor-serials (v) (i) (out) = if i >= v.vendor-count then out else cg-vendor-serials v (i + 1) (list-push out (list-at v.vendors i).serial)
  cg-player-serials : GvWorld, Integer, List Integer -> List Integer
  cg-player-serials (v) (i) (out) = if i >= v.player-count then out else cg-player-serials v (i + 1) (list-push out (list-at v.players i).serial)
  cg-witness-list : CompositeGame, CivicLive, WorldObject, WalkMap, Integer, List Integer, Integer -> Integer
  cg-witness-list (owner) (c) (doer) (map) (id) (serials) (i) = if i >= list-length serials then 0
    else let serial = list-at serials i
    in let seen = if serial == 0 | serial == doer.serial then 0 else when world-get owner.checkpoint.game.world serial
      is Err (_) -> 0
      is Ok (m) -> if m.kind /= 1 | m.health <= 0 | walk-abs (m.x - doer.x) > 12 | walk-abs (m.y - doer.y) > 12 | not (tl-sight map m doer) then 0
        else let npc = gv-player owner.vendor serial 0 < 0
        in let willing = not npc | cg-drink-level owner serial < 3
        in let w = lw-observe c.law True id serial npc willing
        in if w < 1 then 0 else if not npc | not willing then 1
        else let told = lw-report c.law w True in let called = lw-call c.law w True in 1
    in seen + cg-witness-list owner c doer map id serials (i + 1)
 Britain's jail cell is a standing tile of Guard Post North (cv-north). An offender offered arrest answers by saying
 "submit" (escort to the cell, lw-submit) or "fight", or by striking the arresting guard (lw-fight: every assigned guard
 attacks). A fight ends when the offender or every assigned guard falls (lw-won-fight); the crime stays known. A prisoner
 found more than 3 tiles from the cell has broken out: the case reopens and the offender is wanted again.
  cg-jail : CompositeGame, CivicLive, WalkMap -> Integer
  cg-jail (owner) (c) (map) = let jail = list-at c.law.jails 0
    in if jail.enabled & (cg-indoor map jail.x jail.y | cg-jailed-any c.law 0) then 0
    else when cg-jail-cell c.law.world map 0
      is Err (_) -> -1
      is Ok (cell) -> lw-jail-set c.law True 1 cell.x cell.y
 The cell is indoors: the first standing tile of the post under a roof collider (cg-covered); a world whose cell stood
 outdoors moves it at boot unless someone is jailed there.
  cg-indoor : WalkMap, Integer, Integer -> Boolean
  cg-indoor (map) (x) (y) = when walk-ground map x y
    is Err (_) -> False
    is Ok (ground) -> when bb-floor map x y ground 0 is Err (_) -> False is Ok (z) -> cg-covered map (walk-cell map x y) z 0
  cg-jail-cell : WorldTable, WalkMap, Integer -> Result BbSpot Text
  cg-jail-cell (world) (map) (offset) = if offset >= (cv-north.x2 - cv-north.x1 + 1) * (cv-north.y2 - cv-north.y1 + 1) then bb-placement world map cv-north 0
    else when bb-placement world map cv-north offset
      is Err (_) -> bb-placement world map cv-north 0
      is Ok (spot) -> if cg-covered map (walk-cell map spot.x spot.y) spot.z 0 then Ok spot
        else cg-jail-cell world map ((spot.y - cv-north.y1) * (cv-north.x2 - cv-north.x1 + 1) + spot.x - cv-north.x1 + 1)
  cg-jailed-any : LawWorld, Integer -> Boolean
  cg-jailed-any (w) (i) = if i >= w.count then False else if (list-at w.cases i).status == 4 then True else cg-jailed-any w (i + 1)
  cg-offered : LawWorld, Integer, Integer, Integer -> Integer
  cg-offered (w) (serial) (status) (i) = if i >= w.count then 0
    else let k = list-at w.cases i in if k.offender == serial & k.status == status & k.guard > 0 then i + 1 else cg-offered w serial status (i + 1)
  cg-guard-mobile : CompositeGame, CivicLive, Integer -> Maybe WorldObject
  cg-guard-mobile (owner) (c) (case-id) = let k = lw-case c.law case-id
    in if k.guard < 1 then None else when world-get owner.checkpoint.game.world (list-at c.law.guards (k.guard - 1)).serial is Err (_) -> None is Ok (m) -> Just m
  cg-attack : CompositeGame, Integer, Integer -> Integer
  cg-attack (owner) (guard) (offender) = when cb-ensure owner.combat owner.checkpoint.game guard
    is Err (_) -> 0
    is Ok (a) -> when cb-ensure owner.combat owner.checkpoint.game offender
      is Err (_) -> 0
      is Ok (b) -> if cb-select owner.combat owner.checkpoint.game a b then 1 else 0
  cg-fight-guards : CompositeGame, CivicLive, Integer, Integer, Integer -> Integer
  cg-fight-guards (owner) (c) (case-id) (offender) (i) = if i >= c.law.guard-count then 0
    else let g = list-at c.law.guards i
    in (if g.case-id == case-id & g.state == 3 & lw-live c.law g.serial then cg-attack owner g.serial offender else 0) + cg-fight-guards owner c case-id offender (i + 1)
 Britain's foot guards on patrol (law state 0) fall on the nearest hostile spawned creature within cg-guard-reach tiles,
 hostile as gws-wild reads it (profile ai 2 or 11, no owner), through the same cb-select the arrest fight uses
 (UOAIX.md stage M, the living wilds).
  cg-guard-reach : Integer = 10
  cg-raider : GameWorldSpawn, GameShard, WorldObject, Integer, Integer, Integer -> Integer
  cg-raider (g) (shard) (guard) (i) (best) (dist) = if i >= list-length g.slots then best
    else let slot = list-at g.slots i
    in if slot.serial == 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then cg-raider g shard guard (i + 1) best dist
    else let p = list-at g.catalog.profiles slot.profile
    in let d = if slot.owner /= 0 | (p.ai /= 2 & p.ai /= 11) then 9999
      else when world-get shard.world slot.serial is Err (_) -> 9999 is Ok (m) -> if m.health <= 0 then 9999 else max (walk-abs (m.x - guard.x)) (walk-abs (m.y - guard.y))
    in if d <= cg-guard-reach & d < dist then cg-raider g shard guard (i + 1) slot.serial d else cg-raider g shard guard (i + 1) best dist
  cg-guard-raiders : CompositeGame, CivicLive, Integer -> Integer
  cg-guard-raiders (owner) (c) (i) = if i >= c.law.guard-count then 0
    else let g = list-at c.law.guards i
    in let struck = if g.state /= 0 | not (lw-live c.law g.serial) then 0 else when owner.spawns
      is None -> 0
      is Just (s) -> when world-get owner.checkpoint.game.world g.serial
        is Err (_) -> 0
        is Ok (m) -> if cg-in-fight owner g.serial then 0
          else let r = cg-raider s owner.checkpoint.game m 0 0 9999 in if r == 0 then 0 else let trained = cg-guard-trained owner g.serial in cg-attack owner g.serial r
    in struck + cg-guard-raiders owner c (i + 1)
 A guard fighting a creature fights on until it dies (Law.md): it is not drawn off to a nearer one.
  cg-in-fight : CompositeGame, Integer -> Boolean
  cg-in-fight (owner) (serial) = let world = owner.checkpoint.game.world
    in let at = world-slot world serial
    in if at < 0 | at >= list-length owner.combat.actors then False
    else let a = list-at owner.combat.actors at
    in a.serial == serial & a.war & a.target /= 0 & (when world-get world a.target is Err (_) -> False is Ok (t) -> t.health > 0)
 The townsfolk are Britain's militia (UOAIX.md, the living wilds): a living resident within cg-guard-reach of a hostile
 spawned creature turns on it as the patrol guards do.
  cg-militia : CompositeGame, List Integer, Integer -> Integer
  cg-militia (owner) (folk) (i) = if i >= list-length folk then 0
    else let serial = list-at folk i
    in let struck = when owner.spawns
      is None -> 0
      is Just (s) -> when world-get owner.checkpoint.game.world serial
        is Err (_) -> 0
        is Ok (m) -> if m.health <= 0 then 0 else let r = cg-raider s owner.checkpoint.game m 0 0 9999 in if r == 0 then 0 else cg-attack owner serial r
    in struck + cg-militia owner folk (i + 1)
 Britain's street NPCs in one index space: the residents, the lineup copy, the gatherer, the farmer, the miners, the
 shopkeepers and the five crafters.
  cg-npc-count : CompositeGame -> Integer
  cg-npc-count (owner) = (when owner.town is None -> 0 is Just (t) -> t.count) + 3 + list-length owner.miners + owner.vendor.vendor-count + 5
  cg-npc-serial : CompositeGame, Integer -> Integer
  cg-npc-serial (owner) (k) = let folk = when owner.town is None -> 0 is Just (t) -> t.count
    in if k < folk then (when owner.town is None -> 0 is Just (t) -> (tf-person t.people (list-at t.residents k).person).world-serial)
    else if k == folk then (when owner.lineup is None -> 0 is Just (l) -> l.resident)
    else if k == folk + 1 then (when owner.gatherer is None -> 0 is Just (g) -> g.serial)
    else if k == folk + 2 then (when owner.farmer is None -> 0 is Just (f) -> f.serial)
    else let j = k - folk - 3
    in if j < list-length owner.miners then (list-at owner.miners j).serial
    else let v = j - list-length owner.miners
    in if v < owner.vendor.vendor-count then (list-at owner.vendor.vendors v).serial
    else let s = v - owner.vendor.vendor-count
    in if s == 0 then owner.smith.serial else if s == 1 then owner.baker.serial else if s == 2 then owner.tailor.serial
    else if s == 3 then owner.tinker.serial else if s == 4 then owner.carpenter.serial else 0
  cg-npc-distance : CompositeGame, Integer, Integer, Integer -> Integer
  cg-npc-distance (owner) (x) (y) (serial) = if serial == 0 then 9999 else when world-get owner.checkpoint.game.world serial
    is Err (_) -> 9999
    is Ok (m) -> if m.kind /= 1 | m.health <= 0 then 9999 else max (walk-abs (m.x - x)) (walk-abs (m.y - y))
 A hostile creature with no player to hunt falls on the nearest of Britain's street NPCs within gws-aggro (Damian,
 2026-10-08: monsters led into Britain left the townsfolk alone).
  cg-prey-range : Integer = 400
  cg-in-britain : Integer, Integer -> Boolean
  cg-in-britain (x) (y) = walk-abs (x - gws-britain-x) <= cg-prey-range & walk-abs (y - gws-britain-y) <= cg-prey-range
 The prey is the nearest NPC the creature may attack (cg-admit, the hook cb-select asks): a nearer NPC combat would
 refuse, a concealed one, is passed over, or the creature picks it again on every act and stands idle (Damian, live
 40204: a skeleton idled in the Sweet Dreams after its first kill).
  cg-prey-better : Integer, Integer, Boolean -> Boolean
  cg-prey-better (d) (dist) (admitted) = admitted & d <= gws-aggro & d < dist
  cg-prey : CompositeGame, Integer, Integer, Integer -> Integer
  cg-prey (owner) (attacker) (x) (y) = if not (cg-in-britain x y) then 0
    else cg-prey-scan owner attacker x y 0 (cg-npc-count owner) 0 9999
  cg-prey-scan : CompositeGame, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cg-prey-scan (owner) (attacker) (x) (y) (k) (n) (best) (dist) = if k >= n then best
    else let serial = cg-npc-serial owner k
    in let d = cg-npc-distance owner x y serial
    in if cg-prey-better d dist (d < 9999 & cg-admit owner.active attacker serial) then cg-prey-scan owner attacker x y (k + 1) n serial d
    else cg-prey-scan owner attacker x y (k + 1) n best dist
  cg-raid-open : CompositeGame -> Boolean
  cg-raid-open (owner) = when owner.gov is None -> False is Just (s) -> (list-at s.works.towns 0).active-raid /= 0
 Outside an open raid a street NPC within cg-guard-reach of a hostile creature yells, a resident runs home, and the
 nearest foot guard on patrol in earshot of the yell is called onto it. A yell repeats at most once in
 cg-alarm-quiet game seconds per NPC; the 64 rows are keyed by serial, so a collision costs at most an extra yell.
  cg-alarm-rows : Integer = 64
  cg-alarm-quiet : Integer = 240
  cg-flee-seconds : Integer = 600
  cg-call-reach : Integer = 30
  cg-alarm-line : Integer -> Text
  cg-alarm-line (serial) = let i = int-mod serial 3
    in if i == 0 then "Help! Monsters! Guards, guards!" else if i == 1 then "Run! A beast is upon us!" else "To arms! Call the guards!"
 The alarm log, newest cg-alarm-log-rows (Damian live, 2026-10-09: a monster reported, none found, no guard came): cell 0
 counts every fresh yell, cell 8 how many cs-reports has printed, then 72-byte rows of the economy hour, the yeller, its
 x and y, the hostile, its body, x and y, and the guard call's answer (0: no guard heard it). Memory only.
  cg-alarm-log-rows : Integer = 64
  cg-alarm-note : CompositeGame, CivicLive, WorldObject, Integer, Integer -> Integer
  cg-alarm-note (owner) (c) (m) (raider) (called) = let n = peek-qword owner.alarm-log 0
    in let row = owner.alarm-log + 16 + int-mod n cg-alarm-log-rows * 72
    in let a = poke-qword row 0 owner.vendor.currency.world.hour
    in let b = poke-qword row 8 m.serial + poke-qword row 16 m.x + poke-qword row 24 m.y
    in let d = when world-get owner.checkpoint.game.world raider
      is Err (_) -> poke-qword row 32 raider + poke-qword row 40 0 + poke-qword row 48 0 + poke-qword row 56 0
      is Ok (r) -> poke-qword row 32 raider + poke-qword row 40 r.graphic + poke-qword row 48 r.x + poke-qword row 56 r.y
    in let e = poke-qword row 64 called
    in let f = poke-qword owner.alarm-log 0 (n + 1) in 0
 The Chebyshev distance from x, y to the nearest living civic guard, 9999 with none.
  cg-guard-near : CompositeGame, CivicLive, Integer, Integer, Integer, Integer -> Integer
  cg-guard-near (owner) (c) (x) (y) (i) (best) = if i >= c.law.guard-count then best
    else let g = list-at c.law.guards i
    in let d = if not (lw-live c.law g.serial) then 9999 else when world-get owner.checkpoint.game.world g.serial
      is Err (_) -> 9999
      is Ok (m) -> max (walk-abs (m.x - x)) (walk-abs (m.y - y))
    in cg-guard-near owner c x y (i + 1) (min best d)
  cg-alarm-fresh : Integer, Integer, Integer -> Boolean
  cg-alarm-fresh (alarms) (serial) (seconds) = let row = alarms + int-mod serial cg-alarm-rows * 16
    in if peek-qword row 0 == serial & seconds < peek-qword row 8 then False
    else let kept = poke-qword row 0 serial in let quiet = poke-qword row 8 (seconds + cg-alarm-quiet) in True
  cg-flee : CompositeGame, Integer -> Integer
  cg-flee (owner) (k) = when owner.town
    is None -> 0
    is Just (t) -> if k >= t.count then 0
      else let r = list-at t.residents k
      in let p = tf-person t.people r.person
      in if p.alive == 0 then 0 else tl-control-set t r 0 0 p.home 0 (t.now + cg-flee-seconds) r.home
 A guard answers only a call in earshot (Law.md, Damian 2026-10-08): the nearest foot guard on patrol within cv-call's
 hearing range of the caller is set on the creature and runs there like any NPC (cg-guard-chase), indoors included.
  cg-in-earshot : Integer, Integer, Integer, Integer -> Boolean
  cg-in-earshot (gx) (gy) (cx) (cy) = max (walk-abs (gx - cx)) (walk-abs (gy - cy)) <= cv-earshot
  cg-call-guard : CompositeGame, CivicLive, WorldObject, Integer -> Integer
  cg-call-guard (owner) (c) (caller) (monster) = let g = cg-hear-pick owner c caller 0 0 9999
    in if g == 0 then 0 else let trained = cg-guard-trained owner g in cg-attack owner g monster
  cg-hear-pick : CompositeGame, CivicLive, WorldObject, Integer, Integer, Integer -> Integer
  cg-hear-pick (owner) (c) (caller) (i) (best) (dist) = if i >= c.law.guard-count then best
    else let g = list-at c.law.guards i
    in let d = if g.state /= 0 | not (lw-live c.law g.serial) then 9999 else cg-npc-distance owner caller.x caller.y g.serial
    in let heard = d < 9999 & (when world-get owner.checkpoint.game.world g.serial
      is Err (_) -> False
      is Ok (npc) -> cg-in-earshot npc.x npc.y caller.x caller.y
        & (when owner.town-map is None -> True is Just (map) -> cv-hear map caller.x caller.y caller.z npc cv-earshot))
    in if heard & d < dist then cg-hear-pick owner c caller (i + 1) g.serial d else cg-hear-pick owner c caller (i + 1) best dist
 A guard holds a trained fighter's skill, as a spawned creature holds its profile's (cb-profile): swordsmanship 80.0,
 dexterity 80; it is not immune.
  cg-guard-skill : Integer = 800
  cg-guard-trained : CompositeGame, Integer -> Integer
  cg-guard-trained (owner) (g) = cb-profile owner.combat owner.checkpoint.game g (nn-name cst-guard g) 80 8 16 cg-guard-skill
  cg-monster-call : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-monster-call (owner) (game) (input) (packet) = if list-length packet < 9 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 then None
    else if not (gp-speech-valid packet) | not (ns-has (gp-speech-text packet) "guards") then None
    else when owner.civic
      is None -> None
      is Just (c) -> when owner.spawns
        is None -> None
        is Just (s) -> when world-get game.world input.session.serial
          is Err (_) -> None
          is Ok (me) -> if me.health <= 0 then None
            else let r = cg-raider s game me 0 0 9999
            in if r == 0 then None else if cg-call-guard owner c me r == 0 then Just (gs-reply [sip-message #FFFFFFFF #FFFF 6 "No guard is near enough to hear you."] "civic guard call: monster unheard")
            else Just (gs-reply [sip-message #FFFFFFFF #FFFF 6 "A guard answers the call."] "civic guard call: monster")
  cg-alarm : CompositeGame, CivicLive, GameWorldSpawn, Integer, Integer, Integer, List (List Integer) -> List (List Integer)
  cg-alarm (owner) (c) (s) (seconds) (k) (n) (packets) = if k >= n then packets
    else let serial = cg-npc-serial owner k
    in let heard = if serial == 0 then [] else when world-get owner.checkpoint.game.world serial
      is Err (_) -> []
      is Ok (m) -> if m.kind /= 1 | m.health <= 0 then [] else let r = cg-raider s owner.checkpoint.game m 0 0 9999
        in if r == 0 then [] else let fled = cg-flee owner k
        in let called = cg-call-guard owner c m r
        in let fresh = cg-alarm-fresh owner.alarms serial seconds
        in let noted = if fresh then cg-alarm-note owner c m r called else 0
        in if not fresh then [] else if world-announce-text owner.checkpoint.game.world m.serial (cg-alarm-line serial) then [gvp-speech m "" (cg-alarm-line serial)] else []
    in cg-alarm owner c s seconds (k + 1) n (packets & heard)
 A foot guard on patrol that is fighting a spawned creature runs to a tile beside it, a step every 6 game seconds
 (twice the patrol's walk), while the creature is within cg-chase-reach, and holds there off its patrol route while
 the fight lasts; the route resumes when the fight ends.
  cg-chase-reach : Integer = cv-earshot + cg-guard-reach
  cg-chase-step : CompositeGame, CivicLive, GameWorldSpawn, WalkMap, CvPatrol, Integer -> List (List Integer)
  cg-chase-step (owner) (c) (s) (map) (p) (seconds) = let world = owner.checkpoint.game.world
    in let at = world-slot world p.serial
    in if at < 0 then [] else let a = list-at owner.combat.actors at
    in if a.serial /= p.serial | not a.war | a.target == 0 | gws-slot-of s a.target 0 < 0 then []
    else when world-get world p.serial
      is Err (_) -> []
      is Ok (guard) -> when world-get world a.target
        is Err (_) -> []
        is Ok (prey) -> let d = max (walk-abs (prey.x - guard.x)) (walk-abs (prey.y - guard.y))
          in if prey.health <= 0 | d > cg-chase-reach then []
          else if d <= 1 then let held = __record-set p "next-step" (seconds + 6) in []
          else when cv-approach c map guard prey 0
            is Err (_) -> []
            is Ok (spot) -> when cv-walk c p guard map owner.town-doors spot
              is Err (_) -> []
              is Ok (moved) -> let paced = __record-set p "next-step" (seconds + 6) in moved
  cg-guard-chase : CompositeGame, CivicLive, GameWorldSpawn, WalkMap, Integer, Integer, List (List Integer) -> List (List Integer)
  cg-guard-chase (owner) (c) (s) (map) (seconds) (i) (packets) = if i >= list-length c.guards then packets
    else let p = list-at c.guards i
    in let state = if p.law-id < 1 | p.law-id > c.law.guard-count then -1 else (list-at c.law.guards (p.law-id - 1)).state
    in let joined = if state /= 0 then [] else cg-focus-join owner c s p
    in let shopped = if state /= 0 | p.next-step > seconds | list-length joined > 0 then [] else cg-guard-shop owner c map p seconds
    in let step = if state /= 0 | p.next-step > seconds then [] else cg-chase-step owner c s map p seconds
    in cg-guard-chase owner c s map seconds (i + 1) (packets & joined & shopped & step)
 A guard buys armor with its own wages (Law.md, Damian 2026-10-08): off a fight, a guard without the gorget whose purse
 covers the smith's price walks to the open Hammer And Anvil, buys one from its stock and wears it (layer 10, tiledata),
 its owner row bound first so the gorget is never an ownerless lot.
 The smith's gorget is the only armor Britain stocks, and no weapon it sells betters the guard's longsword.
  cg-armory : Integer = 1
  cg-gorget-item : Integer = 71
  cg-gorget-art : Integer = #1413
  cg-guard-wants : Boolean, Integer, Integer -> Boolean
  cg-guard-wants (worn) (coin) (price) = not worn & price >= 1 & coin >= price
  cg-guard-shop : CompositeGame, CivicLive, WalkMap, CvPatrol, Integer -> List (List Integer)
  cg-guard-shop (owner) (c) (map) (p) (seconds) = when owner.town
    is None -> []
    is Just (t) -> let v = t.vendors
      in if p.serial == 0 | v.vendor-count <= cg-armory | gv-shut v cg-armory | cg-in-fight owner p.serial then []
      else if gmb-layer owner.items p.serial 10 0 > 0 then []
      else let person = cg-gov-person owner t p.serial "Britain Guard"
      in let actor = if person < 1 then 0 else cg-crew-actor owner person
      in if actor < 1 then []
      else let x = v.currency
      in let a = ep-actor x.world actor
      in let merchant = list-at v.vendors cg-armory
      in let price = ep-price x.world merchant.actor cg-gorget-item
      in let at = cgg-tool-offer v merchant cg-gorget-item 0
      in let coin = eu-value x (em-purse x.copper a.purse).coin (em-purse x.silver a.purse).coin (em-purse x.world.money a.purse).coin
      in if at < 0 | not (cg-guard-wants False coin price) then []
      else when world-get v.game.world p.serial
        is Err (_) -> []
        is Ok (guard) -> when world-get v.game.world merchant.serial
          is Err (_) -> []
          is Ok (keeper) -> if gv-near guard keeper then cg-guard-buy owner v merchant actor at price guard
            else when cv-approach c map guard keeper 0
              is Err (_) -> []
              is Ok (spot) -> when cv-walk c p guard map owner.town-doors spot
                is Err (_) -> []
                is Ok (moved) -> let paced = __record-set p "next-step" (seconds + 12) in moved
  cg-guard-buy : CompositeGame, GvWorld, GvVendor, Integer, Integer, Integer, WorldObject -> List (List Integer)
  cg-guard-buy (owner) (v) (merchant) (actor) (at) (price) (guard) = when gmb-clothe owner.items guard.serial #0E75 0 21
    is Err (_) -> []
    is Ok (pack) -> if cgf-register v guard.serial actor 0 < 0 then [] else let line = GvLine { lot = at, quantity = 1, price = price, delivered = 0, basis = 0, copper = 0, silver = 0, gold = 0 }
      in when gv-checkout v [line] actor merchant.actor merchant.serial pack guard.serial
        is Err (_) -> []
        is Ok (_) -> let worn = cg-wear-from owner guard.serial (world-first-child owner.items.world pack)
          in let touched = world-touch v.game.world in []
  cg-wear-from : CompositeGame, Integer, Integer -> Integer
  cg-wear-from (owner) (guard) (serial) = if serial == 0 then 0
    else when world-get owner.items.world serial
      is Err (_) -> 0
      is Ok (o) -> if o.graphic /= cg-gorget-art then cg-wear-from owner guard (world-next-sibling owner.items.world serial)
        else when world-update owner.items.world (__record-set (__record-set (__record-set (__record-set o "container" guard) "x" 0) "y" 0) "z" 0)
          is Err (_) -> 0
          is Ok (_) -> if gsi-register owner.items serial 10 0 False False < 0 then 0 else 1
 Britain's guards fight one creature together where they can (Law.md, Damian 2026-10-08): the first guard to land a blow
 on a hostile spawned creature names it the focus (cg-focus-blow, through the swing hook), held until it dies; a guard on
 patrol within cg-chase-reach of the focus and not already on it says so aloud, naming the first guard and the
 creature (nl-guard-join), and turns on it.
  cg-focus-blow : CompositeGame, Integer, Integer -> Integer
  cg-focus-blow (owner) (attacker) (defender) = when owner.civic
    is None -> 0
    is Just (c) -> when owner.spawns
      is None -> 0
      is Just (s) -> if not (cg-civic-guard c attacker 0) | gws-slot-of s defender 0 < 0 | cg-focus-live owner c then 0
        else let a = __record-set c "focus" defender in let b = __record-set c "focus-by" attacker in 1
  cg-focus-live : CompositeGame, CivicLive -> Boolean
  cg-focus-live (owner) (c) = c.focus /= 0 & (when world-get owner.checkpoint.game.world c.focus is Err (_) -> False is Ok (m) -> m.health > 0)
  cg-focus-join : CompositeGame, CivicLive, GameWorldSpawn, CvPatrol -> List (List Integer)
  cg-focus-join (owner) (c) (s) (p) = if c.focus == 0 then []
    else if not (cg-focus-live owner c) then let a = __record-set c "focus" 0 in let b = __record-set c "focus-by" 0 in []
    else if p.serial == 0 | p.serial == c.focus-by | not (lw-live c.law p.serial) then []
    else let world = owner.checkpoint.game.world
    in let at = world-slot world p.serial
    in if at < 0 | at >= list-length owner.combat.actors then []
    else if (list-at owner.combat.actors at).serial == p.serial & (list-at owner.combat.actors at).target == c.focus then []
    else when world-get world p.serial
      is Err (_) -> []
      is Ok (guard) -> when world-get world c.focus
        is Err (_) -> []
        is Ok (prey) -> if max (walk-abs (prey.x - guard.x)) (walk-abs (prey.y - guard.y)) > cg-chase-reach then []
          else let slot = gws-slot-of s c.focus 0
          in let creature = if slot < 0 then "beast" else (list-at s.catalog.profiles (list-at s.slots slot).profile).name
          in let trained = cg-guard-trained owner p.serial
          in if cg-attack owner p.serial c.focus == 0 then []
          else let line = nl-guard-join p.serial (nn-name cst-guard c.focus-by) creature
          in if world-announce-text world p.serial line then [gvp-speech guard (nn-name cst-guard p.serial) line] else []
 A body in Britain's street (Damian, 2026-10-08: townsfolk walked past a slain miner): every non-player death within
 cg-prey-range of Britain notes the tile and body art in a ring of cg-dead-rows (32 bytes a row: x, y, body, the guard
 that took the report), in memory only. Each town step, until a guard has taken the report (Damian, 2026-10-08: a
 corpse in the Sweet Dreams was reported forever), street NPCs within cg-dead-sight of a noted corpse yell and
 residents run home; the nearest foot guard on patrol and not fighting takes the report, walks to it and removes it
 with its contents (cg-rot).
  cg-dead-rows : Integer = 16
  cg-dead-bytes : Integer = 32
  cg-dead-heard : Integer -> Boolean
  cg-dead-heard (row) = peek-qword row 24 /= 0
  cg-dead-hear : Integer, Integer -> Integer
  cg-dead-hear (row) (guard) = if guard == 0 then 0 else poke-qword row 24 guard
  cg-dead-sight : Integer = 8
  cg-dead-free : Integer, Integer -> Integer
  cg-dead-free (ring) (i) = if i >= cg-dead-rows then -1 else if peek-qword ring (i * cg-dead-bytes) == 0 then i else cg-dead-free ring (i + 1)
  cg-dead-note : CompositeGame, Integer -> Integer
  cg-dead-note (owner) (victim) = if gv-player owner.vendor victim 0 >= 0 then 0
    else when world-get owner.checkpoint.game.world victim
      is Err (_) -> 0
      is Ok (m) -> if m.kind /= 1 | not (cg-in-britain m.x m.y) then 0
        else let free = cg-dead-free owner.dead 0
        in let row = owner.dead + (if free >= 0 then free else int-mod victim cg-dead-rows) * cg-dead-bytes
        in let x = poke-qword row 0 m.x in let y = poke-qword row 8 m.y in let body = poke-qword row 16 m.graphic in let unheard = poke-qword row 24 0 in 1
  cg-corpse-at : WorldTable, Integer, Integer -> Integer
  cg-corpse-at (world) (serial) (body) = if serial == 0 then 0
    else if (when world-get world serial is Err (_) -> False is Ok (o) -> o.kind == 2 & o.graphic == 8198 & o.container == 0 & o.amount == body) then serial
    else cg-corpse-at world (world-tile-next world serial) body
  cg-dead-witness : CompositeGame, WorldObject, Integer, Integer, Integer, List (List Integer) -> List (List Integer)
  cg-dead-witness (owner) (corpse) (seconds) (k) (n) (packets) = if k >= n then packets
    else let serial = cg-npc-serial owner k
    in let heard = if cg-npc-distance owner corpse.x corpse.y serial > cg-dead-sight then [] else when world-get owner.checkpoint.game.world serial
      is Err (_) -> []
      is Ok (m) -> if cg-monster-body owner corpse.amount then cg-dead-cheer owner m k seconds
        else let fled = cg-flee owner k
        in if not (cg-alarm-fresh owner.alarms serial seconds) then [] else if world-announce-text owner.checkpoint.game.world m.serial "A body in the street! Guards! Guards!" then [gvp-speech m "" "A body in the street! Guards! Guards!"] else []
    in cg-dead-witness owner corpse seconds (k + 1) n (packets & heard)
 A dead monster in the street (Damian, 2026-10-09: "when a townsfolk sees a dead monster in the street, they should be
 happy and concerned", UOAIX-171): a witness does not run, says so, and a resident's mood rises cg-cheer-lift (of 100,
 the threat is dead) and its alarm cg-cheer-alarm (of 1000, monsters reach the streets). A monster's body is the body of
 a spawn profile that hunts (ai 2 or 11, as the spawn aggression reads them). The town network re-derives both at the
 resident's next network step.
  cg-cheer-lift : Integer = 10
  cg-cheer-alarm : Integer = 200
  cg-monster-body : CompositeGame, Integer -> Boolean
  cg-monster-body (owner) (body) = when owner.spawns is None -> False is Just (g) -> cg-hunter-body g.catalog.profiles body 0
  cg-hunter-body : List WsProfile, Integer, Integer -> Boolean
  cg-hunter-body (ps) (body) (i) = if i >= list-length ps then False
    else let p = list-at ps i in if p.body == body & (p.ai == 2 | p.ai == 11) then True else cg-hunter-body ps body (i + 1)
  cg-cheer-line : Integer -> Text
  cg-cheer-line (serial) = let i = int-mod serial 3
    in if i == 0 then "Thank the Virtues, the beast is dead! But how did it get into town?"
    else if i == 1 then "Good riddance! Still, monsters in our very streets..."
    else "It's dead, at least. The guards must keep them from the gates."
  cg-cheered-mood : Integer -> Integer
  cg-cheered-mood (mood) = tf-clamp (mood + cg-cheer-lift)
  cg-cheered-alarm : Integer -> Integer
  cg-cheered-alarm (alarm) = min 1000 (alarm + cg-cheer-alarm)
  cg-cheer-feel : CompositeGame, Integer -> Integer
  cg-cheer-feel (owner) (k) = when owner.town
    is None -> 0
    is Just (t) -> if k >= t.count then 0
      else let p = tf-person t.people (list-at t.residents k).person
      in let lifted = __record-set p "mood" (cg-cheered-mood p.mood)
      in let alarmed = list-set-at t.feel (k * 3 + 2) (cg-cheered-alarm (list-at t.feel (k * 3 + 2))) in 1
  cg-dead-cheer : CompositeGame, WorldObject, Integer, Integer -> List (List Integer)
  cg-dead-cheer (owner) (m) (k) (seconds) = if not (cg-alarm-fresh owner.alarms m.serial seconds) then []
    else let felt = cg-cheer-feel owner k
    in let line = cg-cheer-line m.serial
    in if world-announce-text owner.checkpoint.game.world m.serial line then [gvp-speech m "" line] else []
  cg-idle-guard : CompositeGame, CivicLive, WorldObject, Integer, Integer, Integer -> Integer
  cg-idle-guard (owner) (c) (m) (i) (best) (dist) = if i >= c.law.guard-count then best
    else let g = list-at c.law.guards i
    in let at = world-slot owner.checkpoint.game.world g.serial
    in let fighting = at >= 0 & (list-at owner.combat.actors at).serial == g.serial & (list-at owner.combat.actors at).war
    in let d = if g.state /= 0 | fighting | not (lw-live c.law g.serial) then 9999 else cg-npc-distance owner m.x m.y g.serial
    in if d <= cg-call-reach & d < dist then cg-idle-guard owner c m (i + 1) g.serial d else cg-idle-guard owner c m (i + 1) best dist
  cg-dead-bury : CompositeGame, CivicLive, WalkMap, Integer, WorldObject, Integer -> List (List Integer)
  cg-dead-bury (owner) (c) (map) (seconds) (corpse) (row) = let g = cg-idle-guard owner c corpse 0 0 9999
    in let i = if g == 0 then -1 else cv-guard-role c g 0 - 2
    in if i < 0 then [] else let heard = cg-dead-hear row g in let p = list-at c.guards i
    in when world-get owner.checkpoint.game.world g
      is Err (_) -> []
      is Ok (guard) -> if max (walk-abs (corpse.x - guard.x)) (walk-abs (corpse.y - guard.y)) <= 1 then
          (if cg-rot owner corpse.serial == 0 then [] else let cleared = poke-qword row 0 0 in [gvp-speech guard "" "I will see this one buried."])
        else if p.next-step > seconds then []
        else when cv-approach c map guard corpse 0
          is Err (_) -> []
          is Ok (spot) -> when cv-walk c p guard map owner.town-doors spot
            is Err (_) -> []
            is Ok (moved) -> let paced = __record-set p "next-step" (seconds + 12) in moved
  cg-dead-step : CompositeGame, CivicLive, WalkMap, Integer, Integer, List (List Integer) -> List (List Integer)
  cg-dead-step (owner) (c) (map) (seconds) (i) (packets) = if i >= cg-dead-rows then packets
    else let row = owner.dead + i * cg-dead-bytes
    in let x = peek-qword row 0
    in let found = if x == 0 then 0 else cg-corpse-at owner.checkpoint.game.world (world-tile-first owner.checkpoint.game.world x (peek-qword row 8)) (peek-qword row 16)
    in let cleared = if x /= 0 & found == 0 then poke-qword row 0 0 else 0
    in let step = if found == 0 then [] else when world-get owner.checkpoint.game.world found
      is Err (_) -> []
      is Ok (corpse) -> (if cg-dead-heard row then [] else cg-dead-witness owner corpse seconds 0 (cg-npc-count owner) []) & cg-dead-bury owner c map seconds corpse row
    in cg-dead-step owner c map seconds (i + 1) (packets & step)
 A raider (a hostile orc of a spawn home, gws-orc) standing in a Britain shop's premises carries off one unit of that
 shop's goods on one town step in twenty (UOAIX.md, the living wilds: "steal from shops and stores"): the unit moves with
 its lot to the raider's own economy actor (the theft transfer, ep-hand; UOAIX-140 b), so nothing is consumed and made
 again. The raider carries the unit, at most cg-raid-carry of them, and drops them in its corpse when slain.
  cg-raid-carry : Integer = 4
  cg-shop-at : WorldObject, Integer -> Integer
  cg-shop-at (m) (i) = if i >= list-length bb-shops then -1 else if cpr-inside (list-at bb-shops i) m then i else cg-shop-at m (i + 1)
  cg-first-lot : EpGoods, Integer, Integer -> Integer
  cg-first-lot (g) (actor) (unused) = cg-first-from g (ep-lot-first g actor)
  cg-first-from : EpGoods, Integer -> Integer
  cg-first-from (g) (serial) = if serial == 0 then -1 else if ep-amount g serial > 0 then serial else cg-first-from g (ep-lot-next g serial)
  cg-steal-one : CompositeGame, Integer, Integer, Integer -> Integer
  cg-steal-one (owner) (actor) (raider) (thief) = let w = owner.vendor.currency.world
    in let items = owner.items
    in let at = cg-first-lot w.goods actor 0
    in if at < 0 | thief < 1 | world-child-count items.world raider >= cg-raid-carry | world-room items.world <= 0 then 0
    else let l = ep-lot w.goods at
    in let item = l.item
    in let lot = l.serial
    in when world-get items.world lot
      is Err (_) -> 0
      is Ok (obj) -> let known = gsi-known items lot
        in let gump = if known then (gsi-meta items lot).gump else 0
        in let stacks = known & (gsi-meta items lot).stackable & gump == 0
        in let graphic = obj.graphic
        in let hue = obj.hue
        in let health = obj.health
        in if not (ep-room (ep-actor w thief) item 1) then 0
        else when world-create items.world (WorldObject { serial = 0, kind = 2, x = 0, y = 0, z = 0, graphic = graphic, hue = hue, container = raider, amount = 1, health = health })
          is Err (_) -> 0
          is Ok (serial) -> let carried = gsi-register items serial 0 gump True stacks
            in let moved = ep-hand w at thief 1 serial (0 - 1)
            in let invalidated = gh-invalidate-quotes owner.vendor 0 in 1
 A monster or brigand (a wild spawn no one can tame, with its own actor) takes the economy goods lying on its tile
 outside the shops into what it carries, each whole stack's lot moving to its actor (UOAIX-140 c); a fixture or an item
 with no lot stays. NPCs carry with no weight limit (CompositeGame.md).
  cg-pickup : CompositeGame, GameWorldSpawn, Integer -> Integer
  cg-pickup (owner) (g) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in let took = if slot.serial == 0 | slot.actor < 1 | slot.owner /= 0 | slot.summoned > 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then 0
      else if (list-at g.catalog.profiles slot.profile).taming > 0 then 0
      else when world-get owner.checkpoint.game.world slot.serial
        is Err (_) -> 0
        is Ok (m) -> if m.health <= 0 | cg-shop-at m 0 >= 0 then 0 else cg-pick-tile owner slot.actor m (world-tile-first owner.items.world m.x m.y) + cg-rummage owner slot.actor m 0
    in took + cg-pickup owner g (i + 1)
 An ore elemental mines (UOAIX-140 f): standing by mountain land on the Britain map it works the vein under it, one try
 a town step, with the pickaxe it starts with (CompositeGame.md, the starting-kit exemption; one more when that one is
 worn out or taken), and carries the ore as a lot with no weight limit; its corpse holds it. Its veins are one node per
 ore at their own place (cg-ore-place), so the miners' veins are left alone and the harvest is paced by regrowth.
  cg-ore-place : Integer = 600
  cg-pickaxe : Integer = 25
  cg-ore-kin : Text -> Boolean
  cg-ore-kin (key) = key == "earthele" | key == "dullcopperele"
  cg-spawn-mine : CompositeGame, GameWorldSpawn, WalkMap, Integer -> Integer
  cg-spawn-mine (owner) (g) (map) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in let mined = if slot.serial == 0 | slot.actor < 1 | slot.owner /= 0 | slot.summoned > 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then 0
      else if not (cg-ore-kin (list-at g.catalog.profiles slot.profile).key) then 0
      else when world-get owner.checkpoint.game.world slot.serial
        is Err (_) -> 0
        is Ok (m) -> if m.health <= 0 | walk-cell map m.x m.y < 0 then 0 else if not (cgg-rock-near map m.x m.y 0) then 0 else cg-mine-one owner slot.actor m
    in mined + cg-spawn-mine owner g map (i + 1)
  cg-ore-node : EpWorld, Integer, Integer -> Integer
  cg-ore-node (w) (resource) (i) = if i >= w.node-count then eh-source w resource cg-ore-place
    else let n = list-at w.nodes i
    in if n.resource == resource & n.place == cg-ore-place then i + 1 else cg-ore-node w resource (i + 1)
  cg-ore-kit : CompositeGame, Integer, WorldObject -> Integer
  cg-ore-kit (owner) (actor) (m) = let w = owner.vendor.currency.world
    in if ep-tool (ep-actor w actor) cg-pickaxe then 0
    else when world-create owner.items.world (WorldObject { serial = 0, kind = 2, x = 0, y = 0, z = 0, graphic = #0E86, hue = 0, container = m.serial, amount = 1, health = 0 })
      is Err (_) -> -1
      is Ok (serial) -> let carried = gsi-register owner.items serial 0 0 True False
        in if ep-find w actor cg-pickaxe 1 /= 0 then (when world-delete owner.items.world serial is Err (_) -> -1 is Ok (_) -> -1)
        else if gv-add-lot owner.vendor serial actor cg-pickaxe 1000 32 0 < 0 then -1 else 0
  cg-mine-one : CompositeGame, Integer, WorldObject -> Integer
  cg-mine-one (owner) (actor) (m) = let w = owner.vendor.currency.world
    in let resource = cpr-vein 5 m.x m.y
    in let node = cg-ore-node w resource 0
    in if node < 1 then 0
    else if (list-at w.nodes (node - 1)).stage /= 2 then 0
    else if cg-ore-kit owner actor m < 0 then 0
    else let item = (list-at w.catalog.resources (resource - 1)).item
    in let before = ep-at (ep-actor w actor).stock item
    in let there = ep-place w actor cg-ore-place
    in let got = eh-harvest w actor node
    in let back = ep-place w actor cgg-town-place
    in if got < 1 then 0 else cg-ore-lot owner actor m item (ep-at (ep-actor w actor).stock item - before)
  cg-ore-lot : CompositeGame, Integer, WorldObject, Integer, Integer -> Integer
  cg-ore-lot (owner) (actor) (m) (item) (quantity) = if quantity < 1 then 0
    else let p = bb-producer owner.vendor.currency actor
    in let a = ep-actor owner.vendor.currency.world actor
    in let n = ep-at a.stock item
    in let f0 = __record-set p "item" item
    in let f1 = __record-set p "quantity" quantity
    in let f2 = __record-set p "quality" (ep-at a.quality item / n)
    in let f3 = __record-set p "wear" (ep-at a.wear item / n)
    in let f4 = __record-set p "basis" (ep-at a.cost item * quantity / n)
    in when bb-materialise owner.vendor owner.items p m.serial (gh-output-graphic item) (item-ore-hue item) 0 0 True
      is Err (_) -> 0
      is Ok (_) -> let invalidated = gh-invalidate-quotes owner.vendor 0 in 1
  cg-pick-tile : CompositeGame, Integer, WorldObject, Integer -> Integer
  cg-pick-tile (owner) (actor) (m) (serial) = if serial == 0 then 0
    else let next = world-tile-next owner.items.world serial
    in let took = when world-get owner.items.world serial
      is Err (_) -> 0
      is Ok (o) -> if o.kind /= 2 | o.container /= 0 | o.z > m.z + 16 | o.z < m.z - 16 then 0 else cg-pick-one owner actor m o
    in took + cg-pick-tile owner actor m next
 It also rummages every corpse (0x2006) within 2 tiles, taking the lots it holds the same way (UOAIX-140 d).
  cg-rummage : CompositeGame, Integer, WorldObject, Integer -> Integer
  cg-rummage (owner) (actor) (m) (k) = if k >= 25 then 0
    else cg-corpses-on owner actor m (world-tile-first owner.items.world (m.x + int-mod k 5 - 2) (m.y + k / 5 - 2)) + cg-rummage owner actor m (k + 1)
  cg-corpses-on : CompositeGame, Integer, WorldObject, Integer -> Integer
  cg-corpses-on (owner) (actor) (m) (serial) = if serial == 0 then 0
    else let next = world-tile-next owner.items.world serial
    in let took = when world-get owner.items.world serial
      is Err (_) -> 0
      is Ok (o) -> if o.kind == 2 & o.container == 0 & o.graphic == #2006 then cg-take-from owner actor m (world-first-child owner.items.world o.serial) else 0
    in took + cg-corpses-on owner actor m next
  cg-take-from : CompositeGame, Integer, WorldObject, Integer -> Integer
  cg-take-from (owner) (actor) (m) (serial) = if serial == 0 then 0
    else let next = world-next-sibling owner.items.world serial
    in let took = when world-get owner.items.world serial is Err (_) -> 0 is Ok (o) -> cg-pick-one owner actor m o
    in took + cg-take-from owner actor m next
  cg-pick-one : CompositeGame, Integer, WorldObject, WorldObject -> Integer
  cg-pick-one (owner) (actor) (m) (o) = let v = owner.vendor
    in let at = gv-lot v o.serial 0
    in if at < 0 then 0
    else let w = v.currency.world
    in let lot = ep-lot w.goods at
    in let take = ep-amount w.goods lot.serial
    in if lot.actor == actor | take < 1 then 0
    else if not (ep-room (ep-actor w actor) lot.item take) then 0
    else when world-update owner.items.world (__record-set (__record-set (__record-set o "container" m.serial) "x" 0) "y" 0)
      is Err (_) -> 0
      is Ok (_) -> let moved = ep-hand w at actor take lot.serial (0 - 1)
        in let invalidated = gh-invalidate-quotes v 0 in 1
  cg-raid-take : CompositeGame, GameWorldSpawn, Integer -> Integer
  cg-raid-take (owner) (g) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in if slot.serial == 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then cg-raid-take owner g (i + 1)
    else let p = list-at g.catalog.profiles slot.profile
    in let took = if slot.owner /= 0 | slot.summoned > 0 | not (gws-orc p) then 0
      else when world-get owner.checkpoint.game.world slot.serial
        is Err (_) -> 0
        is Ok (m) -> let shop = cg-shop-at m 0
          in if shop < 0 | shop >= list-length owner.vendor.vendors | m.health <= 0 | cb-random owner.combat 20 /= 0 then 0
          else cg-steal-one owner (list-at owner.vendor.vendors shop).actor slot.serial slot.actor
    in took + cg-raid-take owner g (i + 1)
 During Britain's open raid a raider in a shop wrecks the shopkeeper's workplace on one town step in sixty (tw-end-raid:
 the station disabled, a repair order of 2 hours posted, each hour one civic row of 2048). The TownWorks site table
 holds stations 1 to 64, so a workplace past it cannot be wrecked.
  cg-raid-shop : CompositeGame, GameWorldSpawn, Integer -> Integer
  cg-raid-shop (owner) (g) (i) = if i >= list-length g.slots then -1
    else let slot = list-at g.slots i
    in if slot.serial == 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then cg-raid-shop owner g (i + 1)
    else let p = list-at g.catalog.profiles slot.profile
    in let shop = if slot.owner /= 0 | not (gws-orc p) then -1
      else when world-get owner.checkpoint.game.world slot.serial
        is Err (_) -> -1
        is Ok (m) -> if m.health <= 0 then -1 else cg-shop-at m 0
    in if shop >= 0 & shop < list-length owner.vendor.vendors then shop else cg-raid-shop owner g (i + 1)
  cg-shop-station : EpWorld, Integer, Integer, Integer -> Integer
  cg-shop-station (w) (actor) (limit) (i) = if i >= w.station-count | i >= limit then (if w.station-count < limit then ep-station w actor 1 (ep-actor w actor).place else -1)
    else let s = list-at w.stations i in if s.owner == actor & s.enabled == 1 then i + 1 else cg-shop-station w actor limit (i + 1)
  cg-raid-wreck : CompositeGame, GameWorldSpawn -> Integer
  cg-raid-wreck (owner) (g) = when owner.gov
    is None -> 0
    is Just (s) -> let t = s.works
      in let local = list-at t.towns 0
      in let shop = cg-raid-shop owner g 0
      in let opened = local.active-raid
      in if shop < 0 | opened == 0 | cb-random owner.combat 60 /= 0 then 0
      else let station = cg-shop-station owner.vendor.currency.world (list-at owner.vendor.vendors shop).actor (list-length t.sites) 0
      in if station < 1 then 0
      else let sited = if tw-site-valid t 1 station then 0 else tw-admit-site t (tg-office s.government 1).mayor 1 station True
      in if sited < 0 then 0
      else tw-end-raid t True 1 opened (TwDamage { station = station, boards = 10, nails = 20, hours = 2, fee = 50 })
 A shop whose workplace waits on an open repair order (status 1 or 2) stays closed.
  cg-vendor-bit : GvWorld, Integer, Integer -> Integer
  cg-vendor-bit (v) (actor) (i) = if i >= bb-shop-count | i >= v.vendor-count then 0
    else if (list-at v.vendors i).actor == actor then bit-shl 1 i else cg-vendor-bit v actor (i + 1)
  cg-wrecked-mask : GvWorld, TwWorld, Integer, Integer -> Integer
  cg-wrecked-mask (v) (t) (i) (mask) = if i >= t.order-count then mask
    else let o = list-at t.orders i
    in let w = v.currency.world
    in let bit = if o.kind /= 1 | (o.status /= 1 & o.status /= 2) | o.target < 1 | o.target > w.station-count then 0
      else cg-vendor-bit v (list-at w.stations (o.target - 1)).owner 0
    in cg-wrecked-mask v t (i + 1) (bit-or mask bit)
  cg-wreck-close : CompositeGame, TownLive -> Integer
  cg-wreck-close (owner) (town) = when owner.gov
    is None -> 0
    is Just (s) -> let mask = cg-wrecked-mask town.vendors s.works 0 0
      in if mask == 0 then 0 else let flagged = cg-shut-mask town.vendors mask 0 in let shut = __record-set town.vendors "closed" (town.vendors.closed + flagged) in mask
  cg-shut-mask : GvWorld, Integer, Integer -> Integer
  cg-shut-mask (v) (mask) (i) = if i >= bb-shop-count then 0
    else (if bit-and mask (bit-shl 1 i) /= 0 & not (gv-shut v i) then gv-set-shut v i True else 0) + cg-shut-mask v mask (i + 1)
  cg-open-repairs : TwWorld, Integer -> Integer
  cg-open-repairs (t) (i) = if i >= t.order-count then 0
    else let o = list-at t.orders i in (if o.kind == 1 & (o.status == 1 | o.status == 2) then 1 else 0) + cg-open-repairs t (i + 1)
  cg-fighting : LawWorld, Integer, Integer -> Integer
  cg-fighting (w) (case-id) (i) = if i >= w.guard-count then 0
    else let g = list-at w.guards i in (if g.case-id == case-id & g.state == 3 & lw-live w g.serial then 1 else 0) + cg-fighting w case-id (i + 1)
  cg-fight : CompositeGame, CivicLive, Integer -> Integer
  cg-fight (owner) (c) (case-id) = if lw-fight c.law case-id True < 0 then 0
    else cg-fight-guards owner c case-id (lw-case c.law case-id).offender 0
  cg-board : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-board (owner) (game) (input) (packet) = if list-length packet < 5 | (list-at packet 0 /= 6 & list-at packet 0 /= #71) then None
    else let seconds = owner.town-seconds
    in let stamp = "day " & show (seconds / 86400 + 1) & ", hour " & show (int-mod (seconds / 3600) 24)
    in bbs-handler owner.bbs owner.production.harvest.items game input packet (as-mobile-name owner.active game input.session.serial) stamp
  cg-arrest-answer : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-arrest-answer (owner) (game) (input) (packet) = when owner.civic
    is None -> None
    is Just (c) -> if list-length packet < 9 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 | not (gp-speech-valid packet) then None
      else let id = cg-offered c.law input.session.serial 1 0
      in if id == 0 then None
      else let text = gp-speech-text packet
      in let submit = ns-has text "submit"
      in if not submit & not (ns-has text "fight") then None
      else when cg-guard-mobile owner c id
        is None -> None
        is Just (guard) -> if submit then (if lw-submit c.law id True < 0 then None
            else let touched = world-touch game.world in Just (gs-reply [gvp-speech guard "Britain Guard" "Then walk with me to the jail."] "law:submit"))
          else let fought = cg-fight owner c id
          in let touched = world-touch game.world in Just (gs-reply [gvp-speech guard "Britain Guard" "So be it. Guards!"] "law:fight")
  cg-struck-guard : CompositeGame, Integer, Integer -> Integer
  cg-struck-guard (owner) (attacker) (defender) = when owner.civic
    is None -> 0
    is Just (c) -> let id = cg-offered c.law attacker 1 0
      in if id == 0 then 0 else let g = (lw-case c.law id).guard
      in if (list-at c.law.guards (g - 1)).serial /= defender then 0 else cg-fight owner c id
 The cell's walls are Guard Post North's: while anyone is jailed, every closed door within 4 tiles of the post is barred
 (wd-bar, as BritainShopHours bars a shop), and when nobody is the bars lift. A picked bar lets a prisoner out, and the
 break-out rule below makes them wanted.
  cg-jailed : LawWorld, Integer -> Boolean
  cg-jailed (w) (i) = if i >= w.count then False else (list-at w.cases i).status == 4 | cg-jailed w (i + 1)
  cg-jail-doors : WdState, Boolean, Integer -> Integer
  cg-jail-doors (doors) (jailed) (i) = if i >= doors.count then 0
    else let x = wd-field doors i 0
    in if x > cv-north.x2 + 4 then 0
    else let y = wd-field doors i 1
    in let near = y >= cv-north.y1 - 4 & y <= cv-north.y2 + 4 & wd-is-door doors i
    in let raw = peek-byte doors.opened i
    in let moved = if not near then 0
      else if jailed then (if raw == 0 then wd-bar doors i else 0)
      else if bit-and raw 4 /= 0 then let lifted = wd-unbar doors i in 1 else 0
    in moved + cg-jail-doors doors jailed (i + 1)
  cg-jail-walls : CompositeGame, CivicLive -> Integer
  cg-jail-walls (owner) (c) = when owner.town-doors
    is None -> 0
    is Just (doors) -> let changed = cg-jail-doors doors (cg-jailed c.law 0) (wd-lower doors (cv-north.x1 - 4) 0 doors.count)
      in if changed == 0 then 0 else let touched = world-item-touch owner.checkpoint.game.world in changed
  cg-law-cases : CompositeGame, CivicLive, Integer -> Integer
  cg-law-cases (owner) (c) (i) = if i >= c.law.count then 0
    else let k = list-at c.law.cases i
    in let id = i + 1
    in let done = if k.status == 4 then (if lw-release c.law id == 0 then 1
          else let jail = list-at c.law.jails (k.town - 1)
          in when world-get owner.checkpoint.game.world k.offender
            is Err (_) -> 0
            is Ok (m) -> if walk-abs (m.x - jail.x) <= 3 & walk-abs (m.y - jail.y) <= 3 then 0
              else let reopened = __record-set k "status" 0 in let free = __record-set k "guard" 0 in 1)
      else if k.status == 2 then (let pressed = cg-fight-guards owner c id k.offender 0
        in if not (lw-live c.law k.offender) | cg-fighting c.law id 0 == 0 then lw-won-fight c.law id True else 0)
      else 0
    in done + cg-law-cases owner c (i + 1)
  cg-warns : CompositeGame, Integer, Integer -> Boolean
  cg-warns (owner) (npc) (viewer) = when owner.civic is None -> False is Just (c) -> lw-remembers c.law npc viewer 0
  cg-civic-found : CompositeGame, TownLive, WalkMap -> Integer
  cg-civic-found (owner) (town) (britain) = let warns = __record-set town "warn-hook" (cg-warns owner) in when owner.civic
    is Just (c) -> let swept = cg-civic-sweep owner c 0 0 in let more = cg-civic-extra c britain in let named = cg-civic-names owner c 0 in let governed = cg-gov-found owner town c in let staffed = cg-gov-staff owner town britain c in let noted = __record-set c "mayor-note" (cg-mayor-note owner) in cg-jail owner c britain
    is None -> when cv-populate town (lw-new town.vendors.game.world) britain 1
      is Err (_) -> -1
      is Ok (c) -> let bound = __record-set owner "civic" (Just c) in let swept = cg-civic-sweep owner c 0 0 in let more = cg-civic-extra c britain in let named = cg-civic-names owner c 0 in let governed = cg-gov-found owner town c in let staffed = cg-gov-staff owner town britain c in let noted = __record-set c "mayor-note" (cg-mayor-note owner) in let jailed = cg-jail owner c britain in let touched = world-touch town.vendors.game.world in 1
 Town government (UOAIX-117): Britain's office is held by a townsfolk person bound to the civic mayor's mobile, with the
 town purse (kind 4, owner town 1), founded once and saved as TGC1; the mayor's answer reports the purse and the daily due.
  cg-mayor-person : TownLive, Integer, Integer -> Integer
  cg-mayor-person (town) (mayor) (i) = if i > town.people.used then 0
    else if (tf-person town.people i).world-serial == mayor then i else cg-mayor-person town mayor (i + 1)
  cg-gov-bindings : CompositeGame, TownLive, TrRegistry -> GovernmentBindings
  cg-gov-bindings (owner) (town) (registry) = GovernmentBindings { people = town.people, economy = owner.vendor.currency.world,
    currency = Just owner.vendor.currency, royal-actor = 1, registry = registry, admin = admin-world-new town.people town.mind }
  cg-gov-found : CompositeGame, TownLive, CivicLive -> Integer
  cg-gov-found (owner) (town) (c) = when owner.gov
    is Just (_) -> 0
    is None -> let found = cg-mayor-person town c.mayor 1
      in let person = if found > 0 then found else tf-add-person town.people "Mayor of Britain" 1 1001 100 0 9000
      in if person < 1 then -1
      else let bound = __record-set (tf-person town.people person) "world-serial" c.mayor
      in when tg-new-currency town.people owner.vendor.currency 1
        is Err (_) -> -1
        is Ok (g) -> let purse = eu-open owner.vendor.currency 4 1
          in if purse < 1 | tg-register g True 1 person purse < 0 then -1
          else when tr-new 0
            is Err (_) -> -1
            is Ok (registry) -> let b = cg-gov-bindings owner town registry
              in let s = GovernmentCheckpoint { government = g, works = tw-new g, disputes = td-new g registry b.admin b.currency, tick = 0, sequence = 0 }
              in let kept = __record-set owner "gov" (Just s) in let touched = world-touch owner.checkpoint.game.world in 1
  cg-mayor-note : CompositeGame, Integer -> Text
  cg-mayor-note (owner) (unused) = when owner.gov
    is None -> ""
    is Just (s) -> let office = tg-office s.government 1
      in let local = list-at s.works.towns 0
      in " The town purse holds " & show (em-purse owner.vendor.currency.world.money office.purse).coin & " gold. Britain keeps "
        & show (cg-guards-on s.government 0 0) & " guards"
        & (if local.active-raid /= 0 then " and has called out " & show local.militia & " townsfolk against the raiders." else ".")
        & (let n = cg-open-repairs s.works 0 in if n == 0 then "" else " Raiders have wrecked " & show n & " workplace" & (if n == 1 then "" else "s") & " awaiting repair.")
        & (if office.unpaid > 0 then " The guards are owed " & show office.unpaid & " gold in wages." else "")
        & cg-count-note (cg-orders-in s.works 4 4 0 0) " finished repair awaits its fee." " finished repairs await their fees."
        & cg-count-note (cg-bounties-in s.works 1 0 0) " bounty is offered on a raiding orc camp; read the board." " bounties are offered on raiding orc camps; read the board."
  cg-count-note : Integer, Text, Text -> Text
  cg-count-note (n) (one) (many) = if n == 0 then "" else if n == 1 then " One" & one else " " & show n & many
 Gifts to the town (TownGovernment.md, Damian 2026-10-08): any purse, a player's or an NPC's, gives coin to the town purse
 through cg-gift-pay, the currency's own logged payment (eu-pay, event kind 4). A player says "donate N gold", "silver" or
 "copper" (gold when no metal is named) beside the mayor. A coin pile dropped on the mayor bounces with how to give: a
 player's coin is purse coin, and a pile in a player's pack is no share of it.
  cg-gift-metal : List Integer -> Integer
  cg-gift-metal (word) = if bc-same word [99,111,112,112,101,114] then 1 else if bc-same word [115,105,108,118,101,114] then 2
    else if bc-same word [103,111,108,100] then 3 else 0
  cg-gift-pay : EuCurrency, Integer, Integer, Integer, Integer -> Integer
  cg-gift-pay (x) (payer) (town) (metal) (amount) = if amount < 1 | metal < 1 | metal > 3 | payer < 1 | town < 1 | payer == town then -1
    else let before = (em-purse (eu-money x metal) town).coin
    in if eu-pay x True payer town (if metal == 1 then amount else 0) (if metal == 2 then amount else 0) (if metal == 3 then amount else 0) < 0 then -1
    else (em-purse (eu-money x metal) town).coin - before
  cg-town-gift : CompositeGame, Integer, Integer, Integer -> Integer
  cg-town-gift (owner) (payer) (metal) (amount) = when owner.gov
    is None -> -1
    is Just (s) -> cg-gift-pay owner.vendor.currency payer (tg-office s.government 1).purse metal amount
  cg-gift-how : Text = "To give to Britain, say: donate N gold, donate N silver or donate N copper."
  cg-gift-said : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-gift-said (owner) (game) (input) (packet) = if list-length packet <= 9 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 then None
    else let words = bc-words (bc-said packet 8 []) 0 [] []
    in if list-length words < 2 | not (bc-same (list-at words 0) [100,111,110,97,116,101]) then None
    else when owner.civic
      is None -> None
      is Just (c) -> when world-get game.world input.session.serial
        is Err (_) -> None
        is Ok (me) -> when world-get game.world c.mayor
          is Err (_) -> None
          is Ok (mayor) -> if not (ns-near me mayor 4) then None
            else let amount = bc-number (list-at words 1) 0 0
            in let metal = if list-length words < 3 then 3 else cg-gift-metal (list-at words 2)
            in let at = gv-player owner.vendor input.session.serial 0
            in let payer = if at < 0 then 0 else (ep-actor owner.vendor.currency.world (list-at owner.vendor.players at).actor).purse
            in if amount < 1 | metal == 0 then Just (gs-reply [gvp-speech mayor "Mayor of Britain" cg-gift-how] "mayor gift refused")
            else let given = cg-town-gift owner payer metal amount
            in let coin = if metal == 1 then "copper" else if metal == 2 then "silver" else "gold"
            in if given < 0 then Just (gs-reply [gvp-speech mayor "Mayor of Britain" ("Your purse cannot give " & show amount & " " & coin & ".")] "mayor gift refused")
            else Just (gs-reply [gvp-speech mayor "Mayor of Britain" ("Britain thanks you: " & show given & " " & coin & " to the town purse.")] "mayor gift")
  cg-play-drop : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-play-drop (owner) (game) (input) (packet) = if list-length packet < 14 | list-at packet 0 /= 8 | input.mode /= 2 | input.session.phase /= 2 then None
    else let npc = gp-u32 packet 10
    in if not (plr-is-cast owner.plays npc 0 0) then None
    else let slot = gsi-slot game input.session.serial 0
    in if slot < 0 then None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let at = gv-lot owner.vendor serial 0
    in let items = owner.production.harvest.items
    in let actor = gsi-session items game input slot
    in let code = when world-get game.world serial
      is Err (_) -> 0 - 1
      is Ok (thing) -> when world-get game.world input.session.serial
        is Err (_) -> 0 - 1
        is Ok (me) -> let item = if at >= 0 then (ep-lot owner.vendor.currency.world.goods at).item else gvb-item-of thing.graphic
          in plr-given-item owner.plays me npc item (if actor.holding == serial then actor.amount else thing.amount)
    in let taken = if code < 0 then 0 else plr-cue-taken owner.plays code
    in let kept = if code < 0 then None else cg-play-keep owner game input slot actor npc serial at (plr-cue owner.plays (code / 65536) (int-mod code 65536) 3) (code / 65536)
    in when kept
      is Just (reply) -> Just reply
      is None -> let b = gsi-bounce items actor 5
        in Just (gs-reply (list-push b.packets (sip-message #FFFFFFFF #FFFF 6 (if code >= 0 then "It is looked over and handed back." else "That is not wanted, and it is handed back."))) "play drop")
  cg-play-keep : CompositeGame, GameShard, GameInput, Integer, GsiActor, Integer, Integer, Integer, Integer, Integer -> Maybe GameReply
  cg-play-keep (owner) (game) (input) (slot) (actor) (npc) (serial) (at) (cast) (play) =
    let w = owner.vendor.currency.world
    in let keeper = cg-cast-actor owner play cast
    in let pi = gv-player owner.vendor input.session.serial 0
    in let giver = if pi < 0 then 0 else (list-at owner.vendor.players pi).actor
    in if at < 0 | keeper < 1 | giver < 1 | actor.holding /= serial then None
    else let lot = ep-lot w.goods at
    in when world-get game.world serial
      is Err (_) -> None
      is Ok (thing) -> let part = actor.amount
        in if lot.actor /= giver | part < 1 | part > thing.amount | ep-at (ep-actor w giver).stock lot.item < part | not (ep-room (ep-actor w keeper) lot.item part) then None
        else let pack = cg-play-pack owner.items npc
        in if pack == 0 then None
        else let reply = gsi-drop-to owner.production.harvest.items game actor slot (ItemContainer pack 60 80) get-ticks
        in let kept = if part == thing.amount then (when world-get game.world serial is Err (_) -> 0 is Ok (now) -> if now.container == pack then serial else 0)
          else cg-play-split owner game.world (world-first-child game.world pack) thing.graphic part
        in if kept == 0 then Just reply
        else let moved = ep-hand w at keeper part (if kept == serial then lot.serial else kept) (0 - 1)
        in let q = gh-invalidate-quotes owner.vendor 0
        in Just (gs-reply (list-push reply.packets (sip-message #FFFFFFFF #FFFF 6 "It is accepted and kept.")) "play drop kept")
 The part of a stack a drop split off: the unlotted item of that art and amount in the cast member's pack.
  cg-play-split : CompositeGame, WorldTable, Integer, Integer, Integer -> Integer
  cg-play-split (owner) (world) (child) (graphic) (amount) = if child == 0 then 0
    else if (when world-get world child is Err (_) -> False is Ok (o) -> o.kind == 2 & o.graphic == graphic & o.amount == amount) & gv-lot owner.vendor child 0 < 0 then child
    else cg-play-split owner world (world-next-sibling world child) graphic amount
  cg-mayor-drop : CompositeGame, GameShard, GameInput, List Integer -> Maybe GameReply
  cg-mayor-drop (owner) (game) (input) (packet) = if list-length packet < 14 | list-at packet 0 /= 8 | input.mode /= 2 | input.session.phase /= 2 then None
    else when owner.civic
      is None -> None
      is Just (c) -> if c.mayor == 0 | gp-u32 packet 10 /= c.mayor then None
        else let slot = gsi-slot game input.session.serial 0
        in if slot < 0 then None
        else let items = owner.production.harvest.items
        in let b = gsi-bounce items (gsi-session items game input slot) 5
        in Just (gs-reply (list-push b.packets (sip-message #FFFFFFFF #FFFF 6 ("The mayor hands it back. " & cg-gift-how))) "mayor drop refused")
  cg-orders-in : TwWorld, Integer, Integer, Integer, Integer -> Integer
  cg-orders-in (t) (lo) (hi) (i) (n) = if i >= t.order-count then n
    else let o = list-at t.orders i in cg-orders-in t lo hi (i + 1) (if o.kind == 1 & o.town == 1 & o.status >= lo & o.status <= hi then n + 1 else n)
  cg-bounties-in : TwWorld, Integer, Integer, Integer -> Integer
  cg-bounties-in (t) (status) (i) (n) = if i >= t.bounty-count then n
    else let b = list-at t.bounties i in cg-bounties-in t status (i + 1) (if b.town == 1 & b.status == status then n + 1 else n)
  cg-guards-on : TgWorld, Integer, Integer -> Integer
  cg-guards-on (g) (i) (n) = if i >= g.guard-count then n
    else let k = list-at g.guards i in cg-guards-on g (i + 1) (if k.town == 1 & k.active == 1 then n + 1 else n)
 A guard's wage, in gold coins a game day. Each new economy day the town asks the crown for what the purse lacks of the
 day's wages and arrears, then closes the day (tg-close-day pays each guard or records arrears). Closing must follow the
 last closed day, so a government that has never closed one starts its payroll at today; days before it are not paid.
  cg-guard-wage : Integer = 10
  cg-payroll : CompositeGame, GovernmentCheckpoint -> Integer
  cg-payroll (owner) (s) = let g = s.government
    in let day = g.economy.hour / 24
    in if day <= g.day then 0
    else let started = if day > g.day + 1 & tgv-kind-count g 11 0 0 == 0 then let a = __record-set g "day" (day - 1) in 1 else 0
    in if day /= g.day + 1 then 0
    else let funded = cg-fund s (tg-guard-sum g 1 0 True + tg-guard-sum g 1 0 False)
    in let closed = tg-close-day g
    in world-touch owner.checkpoint.game.world
 Essential workplaces (UOAIX.md, town government): on each closed day the mayor admits every enabled mill (2), forge (9)
 and bakery (6) a shop owns as a town site, then tw-essential logs one staffing request for each kind no admitted
 workplace with a qualified operator covers. The answer is the count of new requests.
  cg-admit-essentials : TwWorld, (Integer -> Boolean), Integer, Integer, Integer -> Integer
  cg-admit-essentials (t) (shop) (mayor) (i) (n) = if i >= t.government.economy.station-count | i >= list-length t.sites then n
    else let st = list-at t.government.economy.stations i
    in let admitted = if st.enabled == 1 & (st.kind == 2 | st.kind == 9 | st.kind == 6) & shop st.owner & not (tw-site-valid t 1 (i + 1))
      then (if tw-admit-site t mayor 1 (i + 1) True < 0 then 0 else 1) else 0
    in cg-admit-essentials t shop mayor (i + 1) (n + admitted)
  cg-workplaces-day : TwWorld, (Integer -> Boolean), Integer -> Integer
  cg-workplaces-day (t) (shop) (mayor) = let admitted = cg-admit-essentials t shop mayor 0 0
    in let mill = tw-essential t mayor 1 2
    in let forge = tw-essential t mayor 1 9
    in let bakery = tw-essential t mayor 1 6
    in let staffed = cg-staff-open t mayor 0 0
    in (if mill > 0 then 1 else 0) + (if forge > 0 then 1 else 0) + (if bakery > 0 then 1 else 0)
 The mayor finds the tradesman for each open staffing request: a qualified resident (tw-candidate) works at an enabled
 workplace of that kind of their own, or one the mayor provisions at their place, admitted as a Britain site. A station
 past the sites list waits for the next growth point (tw-fit) and is staffed on a later day. The answer is requests closed.
  cg-staff-open : TwWorld, Integer, Integer, Integer -> Integer
  cg-staff-open (t) (mayor) (i) (n) = if i >= t.order-count then n
    else let o = list-at t.orders i
    in let staffed = if o.kind /= 2 | o.town /= 1 | o.status /= 1 then 0 else cg-staff-one t mayor (i + 1) o.target
    in cg-staff-open t mayor (i + 1) (n + staffed)
  cg-staff-one : TwWorld, Integer, Integer, Integer -> Integer
  cg-staff-one (t) (mayor) (id) (kind) = let actor = tw-candidate t 1 (tw-skill kind) 1
    in if actor < 1 then 0
    else let w = t.government.economy
    in let found = cg-station-kind w actor kind 0
    in let station = if found > 0 then found else ep-station w actor kind (ep-actor w actor).place
    in if station < 1 | station > list-length t.sites then 0
    else let sited = if tw-site-valid t 1 station then 0 else tw-admit-site t mayor 1 station True
    in if sited < 0 | tw-staff t mayor id actor station < 0 then 0 else 1
  cg-station-kind : EpWorld, Integer, Integer, Integer -> Integer
  cg-station-kind (w) (actor) (kind) (i) = if i >= w.station-count then 0
    else let s = list-at w.stations i in if s.owner == actor & s.kind == kind & s.enabled == 1 then i + 1 else cg-station-kind w actor kind (i + 1)
  cg-workplaces-present : TwWorld -> Integer
  cg-workplaces-present (t) = (if tw-present t 1 2 0 then 1 else 0) + (if tw-present t 1 9 0 then 1 else 0) + (if tw-present t 1 6 0 then 1 else 0)
  cg-staffing-open : TwWorld, Integer, Integer -> Integer
  cg-staffing-open (t) (i) (n) = if i >= t.order-count then n
    else let o = list-at t.orders i
    in cg-staffing-open t (i + 1) (if o.kind == 2 & o.town == 1 & (o.status == 1 | o.status == 2) then n + 1 else n)
 An orc of a spawn home within cg-raid-reach tiles of Britain's market square opens a raid, and 3600 game seconds (a
 game hour) with none stands it down. A full orc camp in raiding range carries a bounty of cg-bounty-reward gold coins.
  cg-raid-reach : Integer = 80
  cg-raid-quiet : Integer = 3600
  cg-bounty-reward : Integer = 100
 Carpentry 900 succeeds 91 attempts in 100 (ep-practice), and every attempt writes a civic row. 0x23D is ServUO
 DefCarpentry's craft sound. Items 38 and 39 are boards and nails, 62 the hammer tw-work wears.
  cg-crew-skill : Integer = 900
  cg-crew-sound : Integer = #23D
  cg-live-mobile : CompositeGame, Integer -> Boolean
  cg-live-mobile (owner) (serial) = serial /= 0 & (when world-get owner.checkpoint.game.world serial is Err (_) -> False is Ok (m) -> m.kind == 1 & m.health > 0)
  cg-named-person : TownLive, Text, Boolean, Integer -> Integer
  cg-named-person (town) (name) (unbound) (i) = if i > town.people.used then 0
    else let p = tf-person town.people i
    in if i > town.count & p.alive == 1 & p.name == name & (not unbound | p.world-serial == 0) then i else cg-named-person town name unbound (i + 1)
  cg-gov-person : CompositeGame, TownLive, Integer, Text -> Integer
  cg-gov-person (owner) (town) (serial) (name) = if not (cg-live-mobile owner serial) then 0
    else let found = cg-mayor-person town serial 1
    in if found > 0 then found
    else let free = cg-named-person town name True 1
    in let person = if free > 0 then free else tf-add-person town.people name 1 1001 100 0 9000
    in if person < 1 then 0 else let bound = __record-set (tf-person town.people person) "world-serial" serial in person
  cg-unbind-person : TownLive, Integer, Integer -> Integer
  cg-unbind-person (town) (serial) (i) = if i > town.people.used then 0
    else let p = tf-person town.people i
    in let cleared = if i > town.count & p.world-serial == serial then let z = __record-set p "world-serial" 0 in 1 else 0
    in cleared + cg-unbind-person town serial (i + 1)
  cg-npc-purse : CompositeGame, Integer -> Integer
  cg-npc-purse (owner) (person) = let x = owner.vendor.currency
    in let found = em-find x.world.money 2 person 1 in if found > 0 then found else eu-open x 2 person
  cg-hire-guards : CompositeGame, TownLive, CivicLive, TgWorld, Integer -> Integer
  cg-hire-guards (owner) (town) (c) (g) (i) = if i >= list-length c.guards then 0
    else let person = cg-gov-person owner town (list-at c.guards i).serial "Britain Guard"
    in let purse = if person < 1 | tg-employed g person 0 then 0 else cg-npc-purse owner person
    in let hired = if purse < 1 then 0 else if tg-hire g (tg-office g 1).mayor 1 person purse cg-guard-wage < 0 then 0 else 1
    in hired + cg-hire-guards owner town c g (i + 1)
 The castle's kitchen staff are the royal household, paid a guard's wage into their own economy purse (root, 2026-10-09).
  cg-kitchen-name : Integer -> Text
  cg-kitchen-name (place) = if place == cgg-baker-place then "Castle Baker" else if place == cgg-cook-place then "Castle Cook" else "Fish Cutter"
  cg-hire-kitchen : CompositeGame, TownLive, TgWorld, List CgGatherer, Integer -> Integer
  cg-hire-kitchen (owner) (town) (g) (workers) (i) = if i >= list-length workers then 0
    else let c = list-at workers i
    in if not (cgg-kitchen-place c.gatherer.place) | c.serial == 0 then cg-hire-kitchen owner town g workers (i + 1)
    else let person = cg-gov-person owner town c.serial (cg-kitchen-name c.gatherer.place)
    in let purse = (ep-actor owner.vendor.currency.world c.gatherer.producer.actor).purse
    in let hired = if person < 1 | tg-employed g person 0 then 0 else if tg-hire g (tg-office g 1).mayor 1 person purse cg-guard-wage < 0 then 0 else 1
    in hired + cg-hire-kitchen owner town g workers (i + 1)
 A kitchen worker buys its raw good with its wage, so until the first payroll closes (g.day 0, about a game day into a
 fresh world: trial 42047, hour 32) each kitchen hire not yet paid is advanced one day's wage (root, 2026-10-09). A
 grant the empty treasury refuses (a TESTING world before British strikes gold) is retried the next step.
  cg-advance-wage : TgWorld, Integer, Integer -> Integer
  cg-advance-wage (g) (person) (purse) = let office = tg-office g 1
    in let funded = cg-fund-town g cg-guard-wage
    in if not (tg-room g 1) | tg-pay g office.purse purse cg-guard-wage /= 0 then 0
    else let paid = __record-set office "paid" (office.paid + cg-guard-wage)
    in let logged = tg-event g 7 1 0 person cg-guard-wage g.economy.money.sequence
    in 1
  cg-paid-once : TgWorld, Integer, Integer -> Boolean
  cg-paid-once (g) (person) (i) = if i >= g.event-count then False
    else let e = list-at g.events i in (e.kind == 7 & e.subject == person) | cg-paid-once g person (i + 1)
  cg-advance-kitchen : CompositeGame, TownLive, TgWorld, List CgGatherer, Integer -> Integer
  cg-advance-kitchen (owner) (town) (g) (workers) (i) = if g.day /= 0 | i >= list-length workers then 0
    else let c = list-at workers i
    in let person = if not (cgg-kitchen-place c.gatherer.place) | c.serial == 0 then 0 else cg-mayor-person town c.serial 1
    in let advanced = if person < 1 | not (tg-employed g person 0) | cg-paid-once g person 0 then 0
      else cg-advance-wage g person (ep-actor owner.vendor.currency.world c.gatherer.producer.actor).purse
    in advanced + cg-advance-kitchen owner town g workers (i + 1)
 Each shopkeeper is a townsfolk person bound to its vendor mobile; its shop's purse keeps owner 1000 + index, so the
 works resolve a shop actor's operator through its vendor (UOAIX-117 essential workplaces), any other actor by its purse.
  cg-bind-shopkeepers : CompositeGame, TownLive, Integer -> Integer
  cg-bind-shopkeepers (owner) (town) (i) = if i >= owner.vendor.vendor-count then 0
    else let person = cg-gov-person owner town (list-at owner.vendor.vendors i).serial "Britain Shopkeeper"
    in (if person > 0 then 1 else 0) + cg-bind-shopkeepers owner town (i + 1)
  cg-operator : CompositeGame, TownLive, TgWorld, Integer -> Integer
  cg-operator (owner) (town) (g) (actor) = let k = cg-vendor-of owner.vendor actor 0
    in if k < 0 then tw-purse-person g actor else cg-mayor-person town (list-at owner.vendor.vendors k).serial 1
  cg-gov-staff : CompositeGame, TownLive, WalkMap, CivicLive -> Integer
  cg-gov-staff (owner) (town) (britain) (c) = when owner.gov
    is None -> 0
    is Just (s) -> let g = s.government
      in let mayor = tf-person town.people (tg-office g 1).mayor
      in let rebound = if mayor.world-serial == 0 & cg-live-mobile owner c.mayor & cg-mayor-person town c.mayor 1 == 0 then let b = __record-set mayor "world-serial" c.mayor in 1 else 0
      in let hired = cg-hire-guards owner town c g 0
      in let household = cg-hire-kitchen owner town g owner.miners 0
      in let shopped = cg-bind-shopkeepers owner town 0
      in let resolved = __record-set s.works "operator" (cg-operator owner town g)
      in let crewed = cg-crew-found owner town britain
      in let touched = world-touch owner.checkpoint.game.world in hired
  cg-actor-of : EpWorld, Integer, Integer -> Integer
  cg-actor-of (w) (purse) (i) = if i >= w.actor-count then 0 else if (list-at w.actors i).purse == purse then i + 1 else cg-actor-of w purse (i + 1)
  cg-crew-actor : CompositeGame, Integer -> Integer
  cg-crew-actor (owner) (person) = let w = owner.vendor.currency.world
    in let purse = cg-npc-purse owner person
    in if purse < 1 then 0
    else let found = cg-actor-of w purse 0
    in if found > 0 then found
    else let actor = ep-admit w purse cgg-town-place
    in if actor < 1 then 0 else let skilled = ep-add (ep-actor w actor).skills 6 cg-crew-skill in actor
  cg-crew-mobile : CompositeGame, TownLive, Integer, BbSpot -> Integer
  cg-crew-mobile (owner) (town) (person) (home) = let p = tf-person town.people person
    in if cg-live-mobile owner p.world-serial then p.world-serial
    else let world = town.vendors.game.world
    in if world-room world < 2 + cst-most-rows then 0
    else when world-create world (gs-mobile 0 home.x home.y home.z 400 1002)
      is Err (_) -> 0
      is Ok (serial) -> let dressed = when cst-style owner.items serial cst-smith is Err (_) -> 0 is Ok (_) -> 1
        in let bound = __record-set p "world-serial" serial in serial
  cg-crew-found : CompositeGame, TownLive, WalkMap -> Integer
  cg-crew-found (owner) (town) (britain) = when owner.crew
    is Just (_) -> 0
    is None -> let named = cg-named-person town "Britain Carpenter" False 1
      in let person = if named > 0 then named else tf-add-person town.people "Britain Carpenter" 1 1001 100 0 9000
      in let actor = if person < 1 then 0 else cg-crew-actor owner person
      in if actor < 1 then -1
      else when cgg-home town britain 60
        is Err (_) -> -1
        is Ok (home) -> let serial = cg-crew-mobile owner town person home
          in if serial == 0 then -1
          else let named-npc = cg-npc-name owner serial (nn-name cst-guard serial)
          in let k = CgCrew { serial = serial, actor = actor, person = person, order = 0, tried = 0 - 1,
            home-x = home.x, home-y = home.y, home-z = home.z, site-x = 0, site-y = 0, site-z = 0, walk = rte-walk 0 }
          in let kept = __record-set owner "crew" (Just k) in 1
  cg-gov-step : CompositeGame, TownLive, WalkMap, CivicLive -> List (List Integer)
  cg-gov-step (owner) (town) (britain) (c) = when owner.gov
    is None -> []
    is Just (s) -> let raid = cg-raid-watch owner s c
      in let crew = cg-crew-step owner town britain s
      in let settled = cg-repairs-settle owner s 0
      in let day = s.government.day
      in let advanced = cg-advance-kitchen owner town s.government owner.miners 0
      in let paid = cg-payroll owner s
      in let staffed = if s.government.day == day then 0 else cg-workplaces-day s.works (\a -> cg-vendor-of owner.vendor a 0 >= 0) (tg-office s.government 1).mayor
      in let bounties = when owner.spawns is None -> [] is Just (g) -> cg-bounty-post owner s g 0 & cg-bounty-settle owner s g 0
      in raid & crew & bounties
  cg-raiders-near : GameWorldSpawn, WorldTable, Integer -> Integer
  cg-raiders-near (g) (world) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in let near = if slot.serial == 0 | slot.owner /= 0 | not (gws-orc (list-at g.catalog.profiles slot.profile)) then 0
      else when world-get world slot.serial
        is Err (_) -> 0
        is Ok (m) -> if m.health > 0 & walk-abs (m.x - gws-britain-x) <= cg-raid-reach & walk-abs (m.y - gws-britain-y) <= cg-raid-reach then 1 else 0
    in near + cg-raiders-near g world (i + 1)
  cg-shout : CompositeGame, CivicLive, Text, Integer -> List (List Integer)
  cg-shout (owner) (c) (text) (i) = if i >= list-length c.guards then []
    else when world-get owner.checkpoint.game.world (list-at c.guards i).serial
      is Err (_) -> cg-shout owner c text (i + 1)
      is Ok (m) -> if m.kind == 1 & m.health > 0 then [gvp-speech m "Britain Guard" text] else cg-shout owner c text (i + 1)
  cg-raid-watch : CompositeGame, GovernmentCheckpoint, CivicLive -> List (List Integer)
  cg-raid-watch (owner) (s) (c) = when owner.spawns
    is None -> []
    is Just (g) -> let local = list-at s.works.towns 0
      in if cg-raiders-near g owner.checkpoint.game.world 0 > 0 then
        let seen = __record-set owner "raid-seen" owner.town-seconds
        in if local.active-raid /= 0 | tw-raid s.works True 1 (local.last-raid + 1) < 0 then []
        else let touched = world-touch owner.checkpoint.game.world
        in cg-shout owner c ("To arms! Orcs in Britain! " & show local.militia & " townsfolk muster.") 0
      else if local.active-raid == 0 | owner.town-seconds - owner.raid-seen < cg-raid-quiet then []
      else if tw-stand-down s.works True 1 local.active-raid < 0 then []
      else let touched = world-touch owner.checkpoint.game.world in cg-shout owner c "The raiders are gone. Stand down." 0
  cg-fund : GovernmentCheckpoint, Integer -> Integer
  cg-fund (s) (amount) = cg-fund-town s.government amount
  cg-fund-town : TgWorld, Integer -> Integer
  cg-fund-town (g) (amount) = let short = amount - (em-purse g.economy.money (tg-office g 1).purse).coin
    in if short <= 0 then 0 else tg-grant g True 1 short
  cg-repairs-settle : CompositeGame, GovernmentCheckpoint, Integer -> Integer
  cg-repairs-settle (owner) (s) (i) = if i >= s.works.order-count then 0
    else let o = list-at s.works.orders i
    in let paid = if o.kind /= 1 | o.town /= 1 | o.status /= 4 then 0
      else let funded = cg-fund s o.fee
      in if tw-pay-repair s.works (tg-office s.government 1).mayor (i + 1) < 0 then 0 else world-touch owner.checkpoint.game.world
    in paid + cg-repairs-settle owner s (i + 1)
  cg-open-order : TwWorld, Integer, Integer -> Integer
  cg-open-order (t) (actor) (i) = if i >= t.order-count then 0
    else let o = list-at t.orders i
    in if o.kind == 1 & o.town == 1 & (o.status == 1 | (o.status == 2 & o.worker == actor)) & tw-site-valid t 1 o.target then i + 1
    else cg-open-order t actor (i + 1)
  cg-vendor-of : GvWorld, Integer, Integer -> Integer
  cg-vendor-of (v) (actor) (i) = if i >= v.vendor-count then -1 else if (list-at v.vendors i).actor == actor then i else cg-vendor-of v actor (i + 1)
  cg-site-spot : CompositeGame, TownLive, WalkMap, Integer -> Result BbSpot Text
  cg-site-spot (owner) (town) (britain) (station) = let actor = (list-at owner.vendor.currency.world.stations (station - 1)).owner
    in let at = cg-vendor-of owner.vendor actor 0
    in if at >= 0 & at < list-length bb-shops then bb-placement town.vendors.game.world britain (list-at bb-shops at) 0 else Ok town.entrance
  cg-crew-walk : CompositeGame, TownLive, WalkMap, CgCrew, WorldObject, Integer, Integer, Integer -> List (List Integer)
  cg-crew-walk (owner) (town) (britain) (k) (m) (x) (y) (z) = if m.x == x & m.y == y then let dropped = rte-drop k.walk in []
    else when rte-toward town.nav town.vendors.game britain owner.town-doors k.walk m x y z
      is Err (_) -> []
      is Ok (packets) -> if k.walk.route >= 0 then packets
        else when rte-try town.vendors.game britain owner.town-doors k.walk m (int-mod (k.walk.blocked + m.serial) 8)
          is Err (_) -> packets
          is Ok (more) -> packets & more
  cg-crew-step : CompositeGame, TownLive, WalkMap, GovernmentCheckpoint -> List (List Integer)
  cg-crew-step (owner) (town) (britain) (s) = when owner.crew
    is None -> []
    is Just (k) -> when world-get town.vendors.game.world k.serial
      is Err (_) -> []
      is Ok (m) -> if m.kind /= 1 | m.health <= 0 then []
        else if k.order == 0 then cg-crew-idle owner town britain s k m
        else cg-crew-job owner town britain s k m
  cg-crew-idle : CompositeGame, TownLive, WalkMap, GovernmentCheckpoint, CgCrew, WorldObject -> List (List Integer)
  cg-crew-idle (owner) (town) (britain) (s) (k) (m) = let t = s.works
    in let id = cg-open-order t k.actor 0
    in let taken = if id == 0 then -1 else if (list-at t.orders (id - 1)).status == 2 then 0 else tw-assign-repair t (tg-office s.government 1).mayor id k.actor
    in if taken < 0 then cg-crew-walk owner town britain k m k.home-x k.home-y k.home-z
    else when cg-site-spot owner town britain (list-at t.orders (id - 1)).target
      is Err (_) -> []
      is Ok (spot) -> let a = __record-set k "order" id
        in let b = __record-set k "site-x" spot.x
        in let c = __record-set k "site-y" spot.y
        in let d = __record-set k "site-z" spot.z
        in let e = rte-drop k.walk
        in let touched = world-touch owner.checkpoint.game.world
        in [gvp-speech m "Britain Carpenter" "Off to mend the damage."]
  cg-crew-job : CompositeGame, TownLive, WalkMap, GovernmentCheckpoint, CgCrew, WorldObject -> List (List Integer)
  cg-crew-job (owner) (town) (britain) (s) (k) (m) = let t = s.works
    in let o = list-at t.orders (k.order - 1)
    in if o.status /= 2 | o.worker /= k.actor then
      let done = __record-set k "order" 0 in (if o.status == 3 | o.status == 4 then [gvp-speech m "Britain Carpenter" "There, good as new."] else [])
    else if walk-abs (m.x - k.site-x) > 1 | walk-abs (m.y - k.site-y) > 1 then cg-crew-walk owner town britain k m k.site-x k.site-y k.site-z
    else let x = owner.vendor.currency
    in let boards = o.boards - o.delivered-boards
    in let nails = o.nails - o.delivered-nails
    in if boards + nails > 0 then cg-crew-stock owner s k boards nails
    else if o.last-hour >= x.world.hour then []
    else let hammer = if ep-tool (ep-actor x.world k.actor) 62 | k.tried == x.world.hour then 0
        else let at = __record-set k "tried" x.world.hour in (when bb-require (bb-producer x k.actor) 62 1 is Err (_) -> 0 is Ok (_) -> 1)
    in let funded = if o.progress + 1 >= o.hours & o.fee > 0 then cg-fund s o.fee else 0
    in if tw-work t k.actor k.order == -1 then []
    else let touched = world-touch owner.checkpoint.game.world in [cbp-sound cg-crew-sound m]
  cg-crew-stock : CompositeGame, GovernmentCheckpoint, CgCrew, Integer, Integer -> List (List Integer)
  cg-crew-stock (owner) (s) (k) (boards) (nails) = let x = owner.vendor.currency
    in if k.tried == x.world.hour then []
    else let at = __record-set k "tried" x.world.hour
    in let p = bb-producer x k.actor
    in when bb-require p 38 boards
      is Err (_) -> []
      is Ok (_) -> when bb-require p 39 nails
        is Err (_) -> []
        is Ok (_) -> if tw-deliver s.works k.actor k.order boards nails < 0 then []
          else let touched = world-touch owner.checkpoint.game.world in []
  cg-bounty-for : TwWorld, Integer, Integer -> Integer
  cg-bounty-for (t) (home) (i) = if i >= t.bounty-count then 0
    else let b = list-at t.bounties i in if b.town == 1 & b.home == home & (b.status == 1 | b.status == 2) then i + 1 else cg-bounty-for t home (i + 1)
  cg-camp-raiding : GameWorldSpawn, Integer -> Boolean
  cg-camp-raiding (g) (r) = let rg = list-at g.catalog.regions r
    in let home = rg.area
    in peek-qword g.populations (r * 8) >= rg.maximum
      & walk-abs ((home.x1 + home.x2) / 2 - gws-britain-x) <= 900 & walk-abs ((home.y1 + home.y2) / 2 - gws-britain-y) <= 900
  cg-stamp : CompositeGame -> Text
  cg-stamp (owner) = "day " & show (owner.town-seconds / 86400 + 1) & ", hour " & show (int-mod (owner.town-seconds / 3600) 24)
 A bounty's board post carries the poster 0 - id, which no player serial matches, so only the payment removes it.
  cg-bounty-notice : CompositeGame, Integer, Text -> List (List Integer)
  cg-bounty-notice (owner) (id) (home) = let board = bbs-board owner.items.world
    in if board == 0 | bbs-count owner.bbs >= bbs-limit then []
    else let subject = bbs-string (gp-put32 (gp-put32 [#71, 0, 0, 5] board) 0) (bbs-bytes ("Bounty: " & home) 0 60 [])
    in let one = bbs-string (list-push subject 2) (bbs-bytes ("The Mayor of Britain pays " & show cg-bounty-reward & " gold coins to") 0 90 [])
    in let two = bbs-string one (bbs-bytes "whoever slays the last orc of that camp." 0 90 [])
    in bbs-post owner.bbs owner.items board (0 - id) "Mayor of Britain" (cg-stamp owner) two
  cg-bounty-post : CompositeGame, GovernmentCheckpoint, GameWorldSpawn, Integer -> List (List Integer)
  cg-bounty-post (owner) (s) (g) (i) = if i >= list-length g.slots then []
    else let slot = list-at g.slots i
    in let r = slot.region
    in if slot.serial == 0 | r < 0 | slot.owner /= 0 | not (gws-orc (list-at g.catalog.profiles slot.profile)) | not (cg-camp-raiding g r) | cg-bounty-for s.works (r + 1) 0 > 0 then cg-bounty-post owner s g (i + 1)
    else let id = tw-post s.works (tg-office s.government 1).mayor 1 (r + 1) (s.government.economy.hour + 1) cg-bounty-reward True
    in if id < 0 then cg-bounty-post owner s g (i + 1)
    else let touched = world-touch owner.checkpoint.game.world
    in cg-bounty-notice owner id (list-at g.catalog.regions r).name & cg-bounty-post owner s g (i + 1)
  cg-camp-left : GameWorldSpawn, WorldTable, Integer, Integer, Integer -> Integer
  cg-camp-left (g) (world) (r) (victim) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in let alive = if slot.serial == 0 | slot.serial == victim | slot.region /= r | slot.owner /= 0 then 0
      else when world-get world slot.serial is Err (_) -> 0 is Ok (m) -> if m.health > 0 then 1 else 0
    in alive + cg-camp-left g world r victim (i + 1)
  cg-bounty-pay : CompositeGame, GovernmentCheckpoint, Integer -> Integer
  cg-bounty-pay (owner) (s) (id) = if (list-at s.works.bounties (id - 1)).status /= 2 then 0
    else let funded = cg-fund s (list-at s.works.bounties (id - 1)).reward
    in if tw-pay-bounty s.works (tg-office s.government 1).mayor id < 0 then 0 else world-touch owner.checkpoint.game.world
  cg-bounty-kill : CompositeGame, GameWorldSpawn, Integer, Integer -> Integer
  cg-bounty-kill (owner) (spawns) (source) (victim) = when owner.gov
    is None -> 0
    is Just (s) -> let at = gws-slot-of spawns victim 0
      in if at < 0 then 0
      else let slot = list-at spawns.slots at
      in let id = if slot.region < 0 | slot.owner /= 0 then 0 else cg-bounty-for s.works (slot.region + 1) 0
      in let player = gv-player owner.vendor source 0
      in if id == 0 | player < 0 then 0
      else let b = list-at s.works.bounties (id - 1)
      in if b.status /= 1 | cg-camp-left spawns owner.checkpoint.game.world slot.region victim 0 > 0 then 0
      else let w = owner.vendor.currency.world
      in let purse = (ep-actor w (list-at owner.vendor.players player).actor).purse
      in if tw-claim s.works True id b.home b.threat (w.hour + 1) purse < 0 then 0
      else let touched = world-touch owner.checkpoint.game.world in cg-bounty-pay owner s id
  cg-post-of : BbsState, Integer, Integer -> Integer
  cg-post-of (s) (poster) (i) = if i >= bbs-count s then -1 else if bbs-poster s i == poster then i else cg-post-of s poster (i + 1)
  cg-paid-text : CompositeGame, GameWorldSpawn, TwBounty -> Text
  cg-paid-text (owner) (g) (b) = let named = as-mobile-name owner.active owner.checkpoint.game (em-purse owner.vendor.currency.world.money b.winner).owner
    in "The Mayor of Britain paid " & show b.reward & " gold coins to " & (if text-length named == 0 then "the slayer" else named)
      & " for clearing " & (list-at g.catalog.regions (b.home - 1)).name & "."
  cg-bounty-settle : CompositeGame, GovernmentCheckpoint, GameWorldSpawn, Integer -> List (List Integer)
  cg-bounty-settle (owner) (s) (g) (i) = if i >= s.works.bounty-count then []
    else let paid = cg-bounty-pay owner s (i + 1)
    in let b = list-at s.works.bounties i
    in let post = if b.status == 3 then cg-post-of owner.bbs (0 - (i + 1)) 0 else -1
    in let told = if post < 0 then []
      else let serial = bbs-serial owner.bbs post
      in when world-delete owner.items.world serial
        is Err (_) -> []
        is Ok (_) -> let dropped = bbs-drop owner.bbs post
          in let touched = world-touch owner.items.world
          in [sip-remove serial, gs-system (cg-paid-text owner g b)]
    in told & cg-bounty-settle owner s g (i + 1)
 An NPC's status and paperdoll name is its combat actor's, which defaults to "Opponent"; the civic NPCs, the minter and
 Silas are named at every boot, and the civic NPCs are re-dressed, so a saved mayor takes the current mayor hue.
  cg-npc-name : CompositeGame, Integer, Text -> Integer
  cg-npc-name (owner) (serial) (name) = if serial == 0 then 0 else when cb-ensure owner.combat owner.checkpoint.game serial
    is Err (_) -> 0
    is Ok (a) -> cb-name a.name name 0
  cg-civic-names : CompositeGame, CivicLive, Integer -> Integer
  cg-civic-names (owner) (c) (i) = if i >= list-length c.guards then
      let dressed = when cst-style owner.items c.mayor cst-mayor is Err (_) -> 0 is Ok (_) -> 1 in cg-npc-name owner c.mayor (cg-mayor-name owner)
    else let serial = (list-at c.guards i).serial
    in let named = cg-npc-name owner serial (nn-name cst-guard serial)
    in let trained = if serial == 0 then 0 else cg-guard-trained owner serial
    in let dressed = if serial == 0 then 0 else when cst-style owner.items serial cst-guard is Err (_) -> 0 is Ok (_) -> 1
    in cg-civic-names owner c (i + 1)
 The minter and Silas are found by body hue, so they take the stylist's clothes (cst-wear-all) and keep their body.
  cg-dress-bare : CompositeGame, Integer, Integer, Text -> Integer
  cg-dress-bare (owner) (serial) (role) (name) = if serial == 0 then 0
    else let dressed = when cst-wear-all owner.items serial (cst-civilian role serial False) 0 is Err (_) -> 0 is Ok (_) -> 1
    in let named = cg-npc-name owner serial name in dressed
  cg-dress-all : CompositeGame, List Integer, Integer -> Integer
  cg-dress-all (owner) (serials) (i) = if i == list-length serials then 0
    else let serial = list-at serials i in cg-dress-bare owner serial cst-shopkeeper (nn-name cst-guard serial) + cg-dress-all owner serials (i + 1)
  cg-civic-extra : CivicLive, WalkMap -> Integer
  cg-civic-extra (c) (britain) = when cv-populate-extra c britain 2 is Err (_) -> -1 is Ok (_) -> 1
 UOAIX-217: each patrol of ct-city-patrols gets one foot guard, founded at boot once its city's map has loaded and
 registered with the law under its city's town (city index + 1), so Britain's calls and payroll never draw it.
  cg-city-guards : CompositeGame -> Result Integer Text
  cg-city-guards (owner) = when owner.civic
    is None -> Ok 0
    is Just (c) -> let patrols = ct-city-patrols 0
      in let grown = cv-grow-city c (list-length patrols)
      in let placed = __record-set c "place" (cg-town-at owner)
      in let mapped = __record-set c "place-map" (cg-city-map owner)
      in let room = if list-length c.law.guards - c.law.guard-count < list-length patrols then __record-set c.law "guards" (lw-guards (list-length patrols) c.law.guards) else c.law
      in let founded = cg-city-found owner c patrols 0 0
      in let jailed = cg-city-jails owner c patrols 0 in founded
  cg-city-found : CompositeGame, CivicLive, List CtPatrol, Integer, Integer -> Result Integer Text
  cg-city-found (owner) (c) (patrols) (k) (n) = if k >= list-length patrols then Ok n
    else let p = list-at c.city-guards k
    in let patrol = list-at patrols k
    in if p.serial /= 0 then cg-city-found owner c patrols (k + 1) n
    else when ct-map-of owner.city-maps patrol.city
      is None -> cg-city-found owner c patrols (k + 1) n
      is Just (map) -> when cg-city-route p map patrol 0
        is Err (_) -> cg-city-found owner c patrols (k + 1) n
        is Ok (_) -> let start = list-at p.route 0
          in when world-create c.law.world (gs-mobile 0 start.x start.y start.z 400 1002)
            is Err (e) -> Err e
            is Ok (serial) -> let law-id = lw-add-guard c.law True serial (patrol.city + 1)
              in if law-id < 1 then let gone = cv-discard c.law.world serial in Err "city guard registration refused"
              else let a = __record-set p "serial" serial
              in let b = __record-set p "law-id" law-id
              in let d = __record-set p "next-step" c.now
              in when cv-city-outfit c (bb-producer c.town.vendors.currency c.production-actor) serial k 0
                is Err (e) -> Err e
                is Ok (_) -> let styled = when cst-style owner.items serial cst-guard is Err (_) -> 0 is Ok (_) -> 1
                  in let named = cg-npc-name owner serial (nn-name cst-guard serial)
                  in let touched = world-touch c.law.world
                  in cg-city-found owner c patrols (k + 1) (n + 1)
  cg-city-route : CvPatrol, WalkMap, CtPatrol, Integer -> Result Integer Text
  cg-city-route (p) (map) (patrol) (i) = if i == 4 then Ok 0
    else let x = list-at patrol.xs i
    in let y = list-at patrol.ys i
    in when cv-floor map x y 0
      is Err (e) -> Err ("city guard waypoint " & show x & "," & show y & ": " & e)
      is Ok (z) -> let spot = list-at p.route i
        in let a = __record-set spot "x" x in let b = __record-set spot "y" y in let d = __record-set spot "z" z
        in cg-city-route p map patrol (i + 1)
 A crime's law town is the city it happens in (city index + 1, Britain 1); a deed outside every city is Britain's.
  cg-town-at : CompositeGame, Integer, Integer -> Integer
  cg-town-at (owner) (x) (y) = let i = ct-city-at owner.cities x y 0 in if i < 0 then 1 else i + 1
  cg-crime-town : CompositeGame, Integer -> Integer
  cg-crime-town (owner) (offender) = when world-get owner.checkpoint.game.world offender is Err (_) -> 1 is Ok (m) -> cg-town-at owner m.x m.y
  cg-city-serials : CivicLive, Integer, List Integer -> List Integer
  cg-city-serials (c) (i) (out) = if i >= list-length c.city-guards then out else cg-city-serials c (i + 1) (list-push out (list-at c.city-guards i).serial)
 Root, 2026-10-09: a city keeps a jail cell of its own under Britain's law. The cell is the first roofed standing tile
 within 8 of the city's first patrol waypoint (cg-indoor), else that waypoint; set once at boot.
  cg-city-jails : CompositeGame, CivicLive, List CtPatrol, Integer -> Integer
  cg-city-jails (owner) (c) (patrols) (k) = if k >= list-length patrols then 0
    else let patrol = list-at patrols k
    in let town = patrol.city + 1
    in if town > 16 | (list-at c.law.jails (town - 1)).enabled then cg-city-jails owner c patrols (k + 1)
    else when ct-map-of owner.city-maps patrol.city
      is None -> cg-city-jails owner c patrols (k + 1)
      is Just (map) -> let x0 = list-at patrol.xs 0 in let y0 = list-at patrol.ys 0
        in let at = cg-jail-near map x0 y0 0
        in let cell = if at < 0 then x0 * 8192 + y0 else at
        in let set = lw-jail-set c.law True town (cell / 8192) (int-mod cell 8192)
        in (if set == 0 then 1 else 0) + cg-city-jails owner c patrols (k + 1)
  cg-jail-near : WalkMap, Integer, Integer, Integer -> Integer
  cg-jail-near (map) (x0) (y0) (i) = if i >= 17 * 17 then 0 - 1
    else let x = x0 - 8 + int-mod i 17
    in let y = y0 - 8 + i / 17
    in if cg-indoor map x y then x * 8192 + y else cg-jail-near map x0 y0 (i + 1)
 A city guard walks its four waypoints on its own city's map and route planner, doors aside, and answers its city's
 cases there (cv-step-on).
  cg-city-patrols : CompositeGame, CivicLive, Integer -> List (List Integer)
  cg-city-patrols (owner) (c) (left) = let k = cg-city-earliest c 0 (0 - 1)
    in if left == 0 | k < 0 then []
    else let p = list-at c.city-guards k
    in if p.next-step > c.now | p.next-step >= tl-max-seconds then []
    else let moved = cg-city-step owner c p
    in let touched = world-touch c.law.world
    in moved & cg-city-patrols owner c (left - 1)
  cg-city-earliest : CivicLive, Integer, Integer -> Integer
  cg-city-earliest (c) (i) (best) = if i >= list-length c.city-guards then best
    else let p = list-at c.city-guards i
    in cg-city-earliest c (i + 1) (if p.serial /= 0 & (best < 0 | p.next-step < (list-at c.city-guards best).next-step) then i else best)
  cg-city-step : CompositeGame, CivicLive, CvPatrol -> List (List Integer)
  cg-city-step (owner) (c) (p) = when world-get c.law.world p.serial
    is Err (_) -> let stopped = __record-set p "next-step" tl-max-seconds in []
    is Ok (mobile) -> if mobile.health <= 0 then let stopped = __record-set p "next-step" tl-max-seconds in []
      else let city = ct-city-at owner.cities mobile.x mobile.y 0
      in when ct-map-of owner.city-maps city
        is None -> let stopped = __record-set p "next-step" tl-max-seconds in []
        is Just (map) -> when cg-city-nav owner city
          is None -> let stopped = __record-set p "next-step" tl-max-seconds in []
          is Just (nav) -> when cv-step-on c nav p map None
            is Err (_) -> let retry = __record-set p "next-step" (p.next-step + 60) in []
            is Ok (packets) -> packets
 A civic section dropped on load founds a new mayor and guards beside the saved ones, which then stand undressed by
 cg-civic-names; mayors left from before the mayor hue moved still wear 0x0481, drawn as noise (CharacterStylist.md).
  cg-worn : CompositeGame, Integer, Integer, Integer, Integer -> Boolean
  cg-worn (owner) (serial) (layer) (graphic) (hue) = let held = gmb-layer owner.items serial layer 0
    in held > 0 & (when world-get owner.items.world held is Err (_) -> False is Ok (o) -> o.graphic == graphic & (hue < 0 | o.hue == hue))
  cg-civic-stray : CompositeGame, CivicLive, Integer -> Boolean
  cg-civic-stray (owner) (c) (serial) = serial /= c.mayor & not (cg-civic-guard c serial 0) & gv-slot owner.checkpoint.game serial 0 < 0
    & (cg-worn owner serial 17 #1FFD cst-guard-hue
      | (cg-worn owner serial 6 #171A -1 & (cg-worn owner serial 17 #1F7C cst-mayor-hue | cg-worn owner serial 17 #1F7C #0481)))
  cg-civic-strip : WorldTable, Integer -> Result Integer Text
  cg-civic-strip (world) (serial) = let child = world-first-child world serial
    in if child == 0 then Ok 0
    else when cg-civic-strip world child
      is Err (e) -> Err e
      is Ok (_) -> when world-delete world child
        is Err (e) -> Err e
        is Ok (_) -> cg-civic-strip world serial
  cg-civic-sweep : CompositeGame, CivicLive, Integer, Integer -> Integer
  cg-civic-sweep (owner) (c) (slot) (count) = let world = owner.checkpoint.game.world
    in if slot >= world.capacity then (if count > 0 then let touched = world-touch world in count else count)
    else let serial = peek-qword (wi-object world.buffer slot) 0
    in if serial <= 0 | peek-qword (wi-object world.buffer slot) 8 /= 1 | not (cg-civic-stray owner c serial) then cg-civic-sweep owner c (slot + 1) count
    else let unbound = if slot >= list-length owner.combat.actors then 0
        else let a = list-at owner.combat.actors slot
        in if a.serial /= serial then 0 else let stopped = cb-stop owner.combat a in let zero = __record-set a "serial" 0 in cb-clear-name a.name 0
      in let cleared = cb-clear-target owner.combat serial 0
      in let removed = when cg-civic-strip world serial is Err (_) -> 0 is Ok (_) -> when world-delete world serial is Err (_) -> 0 is Ok (_) -> 1
      in cg-civic-sweep owner c (slot + 1) (count + removed)
  cg-civic-serials : CivicLive, Integer, List Integer -> List Integer
  cg-civic-serials (c) (i) (out) = if i >= list-length c.guards then out else cg-civic-serials c (i + 1) (list-push out (list-at c.guards i).serial)
  cg-worker-homes : CompositeGame -> List BbSpot
  cg-worker-homes (owner) = let lead = when owner.gatherer is None -> [] is Just (g) -> [g.home]
    in let farm = when owner.farmer is None -> [] is Just (f) -> [f.home]
    in cg-miner-homes owner.miners 0 (lead & farm)
 Every worker sleeps in a bed of its own on the lodging's bed rows: one whose bed an earlier worker holds, or whose bed
 lies past the bed rows, takes the next bed no worker holds (cgg-home avoided only the townsfolk's beds, so three
 workers shared one, and a worker whose bed another stands on can never arrive). The founding map holds no decoration,
 so cg-town-doors owns the beds again once its furniture collides (UOAIX-154: miner-1's bed under a chest of drawers).
  cg-worker-actors : List CgGatherer, Integer -> List Integer
  cg-worker-actors (workers) (i) = if i >= list-length workers then [] else [(list-at workers i).gatherer.producer.actor] & cg-worker-actors workers (i + 1)
  cg-workers : CompositeGame -> List CgGatherer
  cg-workers (owner) = (when owner.gatherer is None -> [] is Just (g) -> [g]) & (when owner.farmer is None -> [] is Just (f) -> [f]) & owner.miners
 A creature a GM moves ([move, cp-place) takes up its routine from where it stands: its route drops and its rest ends,
 so its next step plans toward its current goal from there (Damian, 2026-10-09). A resident's and a guard's rest is a
 clock its steps advance from, so it restarts at the town's or the patrol's now. Spawns stay leashed to their region and
 walk back into it. Answers what the creature is, or "" when it keeps no routine here.
  cg-npc-moved : CompositeGame, Integer -> Text
  cg-npc-moved (owner) (serial) = let keeper = cg-moved-keeper owner serial
    in let station = cg-moved-station owner serial 0
    in let resident = when owner.town is None -> 0 is Just (t) -> cg-moved-person t serial 0
    in let guard = when owner.civic is None -> 0 is Just (s) -> cg-moved-patrol s serial 0
    in let worker = cg-moved-worker (cg-workers owner) serial 0
    in let fighter = cg-moved-fighter owner.fighter serial + cg-moved-fighter owner.hunter serial
    in let errand = cg-moved-errand owner.british serial + cg-moved-errand owner.british-spare serial
    in let crew = when owner.crew is None -> 0 is Just (k) -> if k.serial == serial then rte-drop k.walk + 1 else 0
    in if keeper + station > 0 then "shopkeeper" else if resident > 0 then "townsperson" else if guard > 0 then "guard"
      else if worker > 0 then "worker" else if fighter > 0 then "fighter" else if errand > 0 then "errand runner"
      else if crew > 0 then "crew" else ""
  cg-moved-keeper : CompositeGame, Integer -> Integer
  cg-moved-keeper (owner) (serial) = let at = gv-vendor owner.vendor serial 0
    in when owner.staff
      is None -> 0
      is Just (s) -> if at < 0 | at >= list-length s.keepers then 0
        else let k = list-at s.keepers at
        in let a = __record-set k "settled" 0
        in let b = __record-set k "next-step" 0
        in let c = rte-drop k.walk in 1
  cg-moved-station : CompositeGame, Integer, Integer -> Integer
  cg-moved-station (owner) (serial) (key) = if key > cgs-cobbler then 0
    else let s = cg-station-of owner key
    in if s.serial == serial then let cleared = rte-drop s.walker in 1 else cg-moved-station owner serial (key + 1)
  cg-moved-person : TownLive, Integer, Integer -> Integer
  cg-moved-person (t) (serial) (i) = if i >= t.count then 0
    else let r = list-at t.residents i
    in if (tf-person t.people r.person).world-serial /= serial | r.next-step >= tl-max-seconds then cg-moved-person t serial (i + 1)
    else let reset = tl-reset-path r in let ready = __record-set r "next-step" t.now in 1
  cg-moved-patrol : CivicLive, Integer, Integer -> Integer
  cg-moved-patrol (s) (serial) (i) = if i >= list-length s.guards then 0
    else let p = list-at s.guards i
    in if p.serial /= serial | p.next-step >= tl-max-seconds then cg-moved-patrol s serial (i + 1)
    else let reset = cv-reset p in let ready = __record-set p "next-step" s.now in 1
  cg-moved-worker : List CgGatherer, Integer, Integer -> Integer
  cg-moved-worker (xs) (serial) (i) = if i >= list-length xs then 0
    else let c = list-at xs i
    in if c.serial /= serial then cg-moved-worker xs serial (i + 1)
    else let reset = cgg-reset c in let calmed = cgg-calm c in 1
  cg-moved-fighter : Maybe CgFighter, Integer -> Integer
  cg-moved-fighter (f) (serial) = when f is None -> 0 is Just (c) -> if c.serial == serial then (let reset = cgf-reset c in 1) else 0
  cg-moved-errand : Maybe CbErrand, Integer -> Integer
  cg-moved-errand (e) (serial) = when e is None -> 0 is Just (c) -> if c.serial == serial then (let reset = cbe-reset c in 1) else 0
  cg-own-beds : CompositeGame -> Integer
  cg-own-beds (owner) = when owner.town
    is None -> 0
    is Just (town) -> when owner.town-map
      is None -> 0
      is Just (britain) -> let open = cg-house-reach town britain owner.town-doors 0 []
        in let taken = cg-worker-homes owner
        in let reach = \s -> cgg-reaches town britain owner.town-doors s
        in let moved = cg-own-bed owner town britain open taken (cg-workers owner) 0 [] reach
        in moved + (when owner.fighter is None -> 0 is Just (f) -> cg-own-fighter town britain open taken f reach)
          + (when owner.hunter is None -> 0 is Just (h) -> cg-own-fighter town britain open taken h reach)
  cg-bed-ok : BbSpot, List BbSpot -> Boolean
  cg-bed-ok (home) (earlier) = home.y >= tl-home-region.y1 & home.y <= tl-home-region.y2 & not (cgg-in home earlier 0)
 Workers live in the town's houses (cgg-houses), north first, a second in a house only when every house the town entrance
 reaches holds one (Damian 2026-10-08, CompositeGame.md); with no house reachable they keep beds at the inn. A worker whose
 bed breaks that takes the first free floor tile of the first emptiest reachable house, and one resting at home moves there.
  cg-house-reach : TownLive, WalkMap, Maybe WdState, Integer, List Boolean -> List Boolean
  cg-house-reach (t) (map) (doors) (h) (out) = if h >= list-length cgg-houses then out
    else let door = BbSpot { x = 0, y = 0, z = 0 }
    in let stood = cgg-door-stand map (list-at cgg-houses h).door door
    in let ok = if not (tl-stands map door) then False else cgg-reaches t map doors door
      & (when bb-placement t.vendors.game.world map (list-at cgg-houses h).floor 0 is Err (_) -> False is Ok (spot) -> cgg-reaches t map doors spot)
    in cg-house-reach t map doors (h + 1) (out & [ok])
  cg-house-load : List BbSpot, Integer, Integer -> Integer
  cg-house-load (earlier) (h) (i) = if i >= list-length earlier then 0
    else (if cgg-house-of (list-at earlier i) 0 == h then 1 else 0) + cg-house-load earlier h (i + 1)
  cg-least-load : List Boolean, List BbSpot, Integer, Integer -> Integer
  cg-least-load (open) (earlier) (h) (best) = if h >= list-length open then best
    else let load = if list-at open h then cg-house-load earlier h 0 else -1
    in cg-least-load open earlier (h + 1) (if load >= 0 & (best < 0 | load < best) then load else best)
  cg-house-ok : List Boolean, BbSpot, List BbSpot, Integer, (BbSpot -> Boolean) -> Boolean
  cg-house-ok (open) (home) (earlier) (least) (reach) = let h = cgg-house-of home 0
    in if h < 0 then False else list-at open h & not (cgg-in home earlier 0) & cg-house-load earlier h 0 <= least & reach home
  cg-house-free : TownLive, WalkMap, List Boolean, List BbSpot, List BbSpot, Integer, (BbSpot -> Boolean), Integer -> Result BbSpot Text
  cg-house-free (t) (map) (open) (taken) (earlier) (least) (reach) (h) = if h >= list-length open then Err "no free house"
    else if not (list-at open h) | cg-house-load earlier h 0 /= least then cg-house-free t map open taken earlier least reach (h + 1)
    else when cgg-house-tile t map (list-at cgg-houses h).floor taken reach 0
      is Ok (bed) -> Ok bed
      is Err (_) -> cg-house-free t map open taken earlier least reach (h + 1)
  cg-put-home : TownLive, Integer, BbSpot -> Integer
  cg-put-home (t) (serial) (bed) = if serial == 0 then 0
    else when world-get t.vendors.game.world serial
      is Err (_) -> 0
      is Ok (m) -> let a = __record-set m "x" bed.x
        in let b = __record-set m "y" bed.y
        in let d = __record-set m "z" bed.z
        in when world-update t.vendors.game.world m is Err (_) -> 0 is Ok (_) -> 1
  cg-house-bed : TownLive, WalkMap, List Boolean, List BbSpot, BbSpot, Integer, Boolean, List BbSpot, (BbSpot -> Boolean) -> Integer
  cg-house-bed (t) (map) (open) (taken) (home) (serial) (resting) (earlier) (reach) = let least = cg-least-load open earlier 0 -1
    in if (least < 0 & cg-bed-ok home earlier & not (cgg-bed-blocked home map)) | (least >= 0 & cg-house-ok open home earlier least reach) then 0
    else when (if least < 0 then cgg-home-apart t map taken 0 else cg-house-free t map open taken earlier least reach 0)
      is Err (_) -> 0
      is Ok (bed) -> let moved = tl-copy-spot home bed
        in let put = if resting then cg-put-home t serial bed else 0 in 1
  cg-own-bed : CompositeGame, TownLive, WalkMap, List Boolean, List BbSpot, List CgGatherer, Integer, List BbSpot, (BbSpot -> Boolean) -> Integer
  cg-own-bed (owner) (town) (britain) (open) (taken) (xs) (i) (earlier) (reach) = if i >= list-length xs then 0
    else let c = list-at xs i
    in if cgg-kitchen-place c.gatherer.place then cg-own-bed owner town britain open taken xs (i + 1) earlier reach
    else let moved = cg-house-bed town britain open taken c.home c.serial (c.leg == 0 & c.via == 0) earlier reach
    in let replan = if moved == 0 then 0 else cgg-reset c
    in let stood = cgg-fix-door c town britain
    in moved + cg-own-bed owner town britain open taken xs (i + 1) (earlier & [BbSpot { x = c.home.x, y = c.home.y, z = c.home.z }]) reach
  cg-own-fighter : TownLive, WalkMap, List Boolean, List BbSpot, CgFighter, (BbSpot -> Boolean) -> Integer
  cg-own-fighter (town) (britain) (open) (taken) (f) (reach) = let moved = cg-house-bed town britain open taken f.home f.serial (f.leg == 0) taken reach
    in let stood = cgg-door-stand britain (cgg-door-of f.home town) f.door
    in if moved == 0 then 0 else let replan = cgf-reset f in 1
  cg-miner-homes : List CgGatherer, Integer, List BbSpot -> List BbSpot
  cg-miner-homes (miners) (i) (out) = if i >= list-length miners then out else cg-miner-homes miners (i + 1) (out & [(list-at miners i).home])
  cg-miner-nodes : CompositeGame, TownLive, WalkMap, Maybe WdState, Integer -> Integer
  cg-miner-nodes (owner) (t) (map) (doors) (i) = if i >= list-length owner.miners then (when owner.gatherer is None -> 0 is Just (g) -> cg-node-reach owner.miners t map doors g (cg-spot-copy g.node) 0)
    else let fixed = if cgg-kitchen-place (list-at owner.miners i).gatherer.place then 0 else cg-node-reach owner.miners t map doors (list-at owner.miners i) (cg-spot-copy (list-at owner.miners i).node) 0
    in cg-miner-nodes owner t map doors (i + 1)
  cg-node-taken : List CgGatherer, CgGatherer, Integer -> Boolean
  cg-node-taken (miners) (c) (i) = if i >= list-length miners then False
    else let o = list-at miners i in (o.serial /= c.serial & o.node.x == c.node.x & o.node.y == c.node.y) | cg-node-taken miners c (i + 1)
  cg-spot-copy : BbSpot -> BbSpot
  cg-spot-copy (s) = BbSpot { x = s.x, y = s.y, z = s.z }
  cg-node-reach : List CgGatherer, TownLive, WalkMap, Maybe WdState, CgGatherer, BbSpot, Integer -> Integer
  cg-node-reach (miners) (t) (map) (doors) (c) (origin) (tries) = if tries == 8 then -1
    else let from = WorldObject { serial = c.serial, kind = 1, x = t.entrance.x, y = t.entrance.y, z = t.entrance.z,
      graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
    in let r = if c.trade.raw == cgg-ore then cgg-node-region else BbShop { title = "Node", premises = "Britain", x1 = origin.x - 2, y1 = origin.y - 2, x2 = origin.x + 2, y2 = origin.y + 2 }
    in let inside = c.node.x >= r.x1 & c.node.x <= r.x2 & c.node.y >= r.y1 & c.node.y <= r.y2
    in if not (cg-node-taken miners c 0) & (inside | c.trade.raw /= cgg-ore) & rte-plan t.nav t.vendors.game.world map doors from c.node.x c.node.y c.node.z >= 0 then let reset = cgg-reset c in tries
    else when bb-placement t.vendors.game.world map r (if inside then (c.node.y - r.y1) * (r.x2 - r.x1 + 1) + c.node.x - r.x1 + 1 else tries)
      is Err (_) -> -1
      is Ok (spot) -> let moved = tl-copy-spot c.node spot in cg-node-reach miners t map doors c origin (tries + 1)
  cg-gate-decos : CompositeGame, WdState -> List WdState
  cg-gate-decos (owner) (shown) = when owner.town-doors is None -> [shown] is Just (town) -> [shown, town]
  cg-door-cells : Maybe WdState, Integer -> Integer
  cg-door-cells (other) (row) = when other
    is None -> 0
    is Just (s) -> if row < 0 | row >= s.count | not (wd-bound s) then 0
      else let x = wd-field s row 0
      in let y = wd-field s row 1
      in let a = when wd-rebuild-cell s x y is Err (_) -> 0 is Ok (_) -> 0
      in let b = when wd-rebuild-cell s (x + wd-field s row 9) (y + wd-field s row 10) is Err (_) -> 0 is Ok (_) -> 0 in 0
  cg-door-sync : CompositeGame, List (List Integer), Integer -> Integer
  cg-door-sync (owner) (packets) (i) = if i == list-length packets then 0
    else let packet = list-at packets i
    in let row = if list-length packet == 5 & list-at packet 0 == #1D then bit-and (gp-u32 packet 1) #7FFFFFFF - wd-serial-base - 1 else -1
    in let synced = when owner.decoration
      is None -> 0
      is Just (state) -> if row < 0 | row >= state.count | not (wd-is-door state row) then 0
        else let cells = cg-door-cells owner.decoration row
        in let shown = wd-invalidate state row 0
        in if bit-and (peek-byte state.opened row) 1 /= 0 then wtm-set owner.timers (get-ticks + wd-close-ticks) wd-door-timer row
        else wtm-clear owner.timers wd-door-timer row
    in cg-door-sync owner packets (i + 1)
  cg-combine : Maybe GameReply, Maybe GameReply -> Maybe GameReply
  cg-combine (one) (two) = when one
    is None -> two
    is Just (a) -> when two
      is None -> Just a
      is Just (b) -> Just (GameReply { packets = a.packets & b.packets, close = a.close | b.close, note = a.note & "; " & b.note })
  cg-monsters : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer -> Result (Maybe GameReply) Text
  cg-monsters (owner) (game) (input) (map) (port) (tick) = let fought = cg-monsters-base owner game input map port tick
    in when owner.spawns is None -> fought is Just (spawns) -> let dressed = cg-dress-spawns owner spawns 0
      in when fought
        is Err (e) -> Err e
        is Ok (combat) -> when gws-after cg-spawn-terrain spawns game input map tick (Ok None)
          is Err (e) -> Err e
          is Ok (drawn) -> Ok (cg-combine combat (when drawn is None -> None is Just (r) -> Just (gmb-reply owner.items r)))
 A spawned creature with a human body is dressed before anyone can see it (a spawn is first drawn on the pass after it
 is placed), in its UOX3 outfit (WorldSpawnOutfitData) or a plain one, and its clothes ride in the 0x78 that brings it
 into view (gmb-reply). A UOX3 NAMELIST human's profile name is its title ("the Brigand") or empty; it is named here
 with a first name fixed by serial, as the town's people are. Every UOX3 human outfit has hair (layer 11).
  cg-dress-spawns : CompositeGame, GameWorldSpawn, Integer -> Integer
  cg-dress-spawns (owner) (g) (i) = if i >= list-length g.slots then 0
    else let slot = list-at g.slots i
    in let done = if slot.serial == 0 | slot.profile < 0 | slot.profile >= list-length g.catalog.profiles then 0
      else let p = list-at g.catalog.profiles slot.profile
      in if p.body /= 400 & p.body /= 401 then 0
      else if gmb-layer owner.items slot.serial 5 0 > 0 | gmb-layer owner.items slot.serial 22 0 > 0 | gmb-layer owner.items slot.serial 11 0 > 0 then 0
      else let named = if p.name == "" | (text-length p.name > 4 & substring p.name 0 4 == "the ") then cg-npc-name owner slot.serial (cg-spawn-name p slot.serial) else 0
      in let outfit = wso-rows slot.profile slot.serial
      in when cst-wear-all owner.items slot.serial (if list-length outfit > 0 then outfit else cst-spawn-rows p.key slot.serial) 0 is Err (_) -> 0 is Ok (_) -> 1
    in done + cg-dress-spawns owner g (i + 1)
  cg-spawn-name : WsProfile, Integer -> Text
  cg-spawn-name (p) (serial) = let first = if p.body == 401 then list-at nn-female (cst-pick serial 7 (list-length nn-female))
      else list-at nn-male (cst-pick serial 7 (list-length nn-male))
    in if p.name == "" then first else first & " " & p.name
  cg-monsters-base : CompositeGame, GameShard, GameInput, WalkMap, Integer, Integer -> Result (Maybe GameReply) Text
  cg-monsters-base (owner) (game) (input) (map) (port) (tick) = when gm-pulse owner.monsters game input map port tick
    is Err (e) -> Err e
    is Ok (reply) -> when cbd-dress owner.combat owner.items 0
      is Err (e) -> Err e
      is Ok (_) -> when gr-after owner.resurrection game input (cbd-reply owner.items (Ok reply))
        is Err (e) -> Err e
        is Ok (fought) -> when cg-healed owner game input
          is Err (e) -> Err e
          is Ok (healed) -> Ok (cg-combine fought healed)
 ServUO BaseHealer.OnMovement and OfferResurrection, pre-AOS: a town healer raises a ghost that comes within 4 tiles,
 saying "Thou art dead, but 'tis within my power to resurrect thee.  Live!" with sound 0x1F2. Shop 4 of bb-shops is the
 Healer Of Britain; only a world with Britain's shops bound has one. The healer must see the ghost (UOAIX-68: only a
 banker hears through walls).
  cg-healer-shop : Integer = 4
  cg-healer-range : Integer = 4
  cg-healer-near : CompositeGame, GameShard, WorldObject, Integer -> Integer
  cg-healer-near (owner) (game) (ghost) (i) = if i >= owner.vendor.vendor-count then 0
    else let serial = (list-at owner.vendor.vendors i).serial
    in let near = bb-role owner.vendor serial == cg-healer-shop & (when world-get game.world serial
      is Err (_) -> False
      is Ok (h) -> h.kind == 1 & h.health > 0 & max (walk-abs (h.x - ghost.x)) (walk-abs (h.y - ghost.y)) <= cg-healer-range
        & (when owner.town-map is None -> True is Just (britain) -> tl-sight britain h ghost))
    in if near then serial else cg-healer-near owner game ghost (i + 1)
  cg-healed : CompositeGame, GameShard, GameInput -> Result (Maybe GameReply) Text
  cg-healed (owner) (game) (input) = if input.mode /= 2 | input.session.phase /= 2 | game.active /= input.session.serial then Ok None
    else when owner.shops
      is None -> Ok None
      is Just (_) -> when world-get game.world input.session.serial
        is Err (_) -> Ok None
        is Ok (m) -> let healer = if m.health > 0 then 0 else cg-healer-near owner game m 0
          in let slot = cb-slot game m.serial 0
          in if healer == 0 | slot < 0 then Ok None
          else when world-get game.world healer
            is Err (e) -> Err e
            is Ok (h) -> when gr-raise owner.resurrection game input m slot
              is Err (e) -> Err e
              is Ok (raised) -> Ok (cg-combine (Just (gs-reply [gvp-speech h "Healer" "Thou art dead, but 'tis within my power to resurrect thee.  Live!",
                cbp-sound #1F2 m] "healer:resurrect")) raised)
  cg-status : CompositeGame, List Integer -> List Integer
  cg-status (owner) (status) = when owner.magic
    is None -> gar-status owner.items status
    is Just (magic) -> gar-status owner.items (mgp-rewrite magic status)
  cg-view : CompositeGame, GameShard, GameInput, GameReply -> Result GameReply Text
  cg-view (owner) (game) (input) (reply) = if input.mode /= 2 | input.session.phase /= 2 | reply.close then Ok reply
    else let player = gv-player owner.vendor input.session.serial 0
    in if player < 0 then Err "client view vendor binding absent"
    else when gcv-apply owner.view owner.combat owner.items game input (cg-status owner (gv-status-packet owner.vendor (list-at owner.vendor.players player))) reply
      is Err (e) -> Err e
      is Ok (viewed) -> when owner.gates
        is None -> Ok (cg-walk-redrawn input.session (cg-hide owner viewed))
        is Just (gates) -> when gmg-view gates input viewed
          is Err (e) -> Err e
          is Ok (gated) -> Ok (cg-walk-redrawn input.session (cg-hide owner gated))
 The 1998 client restarts its walk sequence at 0 whenever it draws itself (0x20, 19 bytes, serial at 1), so the session
 expects 0 after every 0x20 for its own serial, whatever sent it. Without this a step after a redraw the session did not
 reset for was refused and the character jumped a tile and back (TESTPLAN row 7, proxy 2026-10-09: the first step after
 Polymorph's redraw in a fight, and after three redraws with no command).
  cg-walk-redrawn : GameSession, GameReply -> GameReply
  cg-walk-redrawn (session) (reply) = let reset = if cg-self-drawn session.serial reply.packets 0 then __record-set session "sequence" 0 else session in reply
  cg-self-drawn : Integer, List (List Integer), Integer -> Boolean
  cg-self-drawn (serial) (packets) (i) = if i >= list-length packets then False
    else let p = list-at packets i
    in if list-length p == 19 & list-at p 0 == #20 & gp-u32 p 1 == serial then True else cg-self-drawn serial packets (i + 1)
 0x20 byte 10 is the status flags; 0x80 draws the player hidden (translucent).
  cg-hide : CompositeGame, GameReply -> GameReply
  cg-hide (owner) (reply) = let shown = if owner.hidden == 0 then 0 else cg-hide-packets owner.hidden reply.packets 0 in reply
  cg-hide-packets : Integer, List (List Integer), Integer -> Integer
  cg-hide-packets (serial) (packets) (i) = if i >= list-length packets then 0
    else let p = list-at packets i
    in let marked = if list-length p == 19 & list-at p 0 == #20 & gp-u32 p 1 == serial & bit-and (list-at p 10) #80 == 0
      then list-set-at p 10 (list-at p 10 + #80) else p
    in cg-hide-packets serial packets (i + 1)
  cg-invisible : CompositeGame, Integer -> Boolean
  cg-invisible (owner) (serial) = let on = owner.hidden /= serial
    in let hidden = __record-set owner "hidden" (if on then serial else 0)
    in let unseen = __record-set owner.monsters "unseen" owner.hidden
    in let unspawned = when owner.spawns is None -> 0 is Just (s) -> let blind = __record-set s "unseen" owner.hidden in 0
    in on
