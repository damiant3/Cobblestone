Chapter: GameSkillsItemsServer
  cites Uoaix chapter GameSkillsItems
  cites Uoaix chapter WalkLoad
  cites Uoaix chapter GameHuffman
  cites Net chapter NetDriver
  cites Net chapter NetCompact
  cites Foreword chapter Result

  opening : [Console, Network.Read, Network.Write] Integer = if not (go-valid (gsi-specs 0)) then act
    print-line-uni "REFUSE skills/items registry"
    1
  end else act
    card <- net-driver-bring-up
    arena <- nc-set-acquire (nc-pool-cell process-get-pid)
    released <- nc-set-release arena
    huffman <- gh-new 0
    loaded <- wl-load 1408 1680 64 64
    when loaded
      is Err (e) -> act
        print-line-uni ("REFUSE preload " & e)
        1
      end
      is Ok (map) -> when gs-new 0
        is Err (e) -> act
          print-line-uni ("REFUSE shard " & e)
          1
        end
        is Ok (shard) -> let state = gsi-new shard.world
          in gn-loop-hooks (gsi-specs 0) (gsi-route state) gn-no-pulse shard map huffman 2593 0
  end
