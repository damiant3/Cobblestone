Chapter: TownNetworkLiveCodec
  cites Uoaix chapter TownNetworkLive

 TNL1 stores the frozen model identity, neural/route state, consent and audit.
 Absolute game time survives restart; the encompassing checkpoint owns atomicity.

  tnlc-agent-at : Integer = 192
  tnlc-agent-bytes : Integer = 896
  tnlc-offers-at : Integer = tnlc-agent-at + 3 * tnlc-agent-bytes
  tnlc-event-bytes : Integer = 136
  tnlc-size : TownNetworkLive -> Integer
  tnlc-size (n) = tnlc-offers-at + n.actions.book.offer-count * 72 + n.actions.book.event-count * tnlc-event-bytes
  tnlc-offers-due : GameLiveActions -> Boolean
  tnlc-offers-due (g) = list-length g.book.offers - g.book.offer-count < 64
  tnlc-push-offers : EaWorld, Integer -> Integer
  tnlc-push-offers (book) (count) = if list-length book.offers >= count then 0
    else let grown = __record-set book "offers" (ea-offers 0 book.offers) in tnlc-push-offers book count
  tnlc-grow-offers : GameLiveActions, Integer -> Integer
  tnlc-grow-offers (g) (count) = let old = list-length g.book.offers
    in let pushed = tnlc-push-offers g.book count
    in let n = list-length g.book.offers
    in if n == old then 0
    else let copper = ep-buffer n
    in let silver = ep-buffer n
    in let a = ep-seal-cells g.copper copper old 0
    in let b = ep-seal-cells g.silver silver old 0
    in let c = __record-set g "copper" copper
    in let d = __record-set g "silver" silver in n
 TNL1 stores no copy of a value it can bind or derive (StateUnification C4): person and actor come from the
 resident, total is the sum of the hours, count is the number of positive outputs, the proposal's actor is the
 agent's, prepared is a flag over the proposal kind, and a home, work or tavern control's goal, place and target
 follow from its action and resident. Those slots are written as zero and never read.
  tnlc-agent-fields : TnvAgent, Integer, Boolean -> Integer
  tnlc-agent-fields (r) (buf) (read) =
    let f0 = if read then 0 else poke-qword buf 0 0
    in let f1 = if read then 0 else poke-qword buf 8 0
    in let f2 = if read then let loaded = __record-set r "item" (peek-qword buf 16) in 0 else poke-qword buf 16 r.item
    in let f3 = if read then let loaded = __record-set r "role" (peek-qword buf 24) in 0 else poke-qword buf 24 r.role
    in let f4 = if read then let loaded = __record-set r "goal" (peek-qword buf 32) in 0 else poke-qword buf 32 r.goal
    in let f5 = if read then let loaded = __record-set r "serial" (peek-qword buf 40) in 0 else poke-qword buf 40 r.serial
    in let f6 = if read then let loaded = __record-set r "prepared" (peek-qword buf 48) in 0 else poke-qword buf 48 (if r.prepared == 0 then 0 else 1)
    in let f7 = if read then let loaded = __record-set r "next" (peek-qword buf 56) in 0 else poke-qword buf 56 r.next
    in let f8 = if read then let loaded = __record-set r "think-at" (peek-qword buf 64) in 0 else poke-qword buf 64 r.think-at
    in let f9 = if read then let loaded = __record-set r "travel" (peek-qword buf 72) in 0 else poke-qword buf 72 r.travel
    in let f10 = if read then let loaded = __record-set r "thoughts" (peek-qword buf 80) in 0 else poke-qword buf 80 r.thoughts
    in let f11 = if read then let loaded = __record-set r "result" (peek-qword buf 88) in 0 else poke-qword buf 88 r.result
    in let f12 = if read then let loaded = __record-set r "town" (peek-qword buf 96) in 0 else poke-qword buf 96 r.town
    in let f13 = if read then let loaded = __record-set r "at" (peek-qword buf 104) in 0 else poke-qword buf 104 r.at
    in let f14 = if read then 0 else poke-qword buf 112 0
    in let f15 = if read then let loaded = __record-set r.state "head" (peek-qword buf 120) in 0 else poke-qword buf 120 r.state.head
    in let f16 = if read then 0 else poke-qword buf 128 0
    in 0

  tnlc-proposal-fields : EaProposal, Integer, Boolean -> Integer
  tnlc-proposal-fields (r) (buf) (read) =
    let f0 = if read then 0 else poke-qword buf 0 0
    in let f1 = if read then let loaded = __record-set r "kind" (peek-qword buf 8) in 0 else poke-qword buf 8 r.kind
    in let f2 = if read then let loaded = __record-set r "target" (peek-qword buf 16) in 0 else poke-qword buf 16 r.target
    in let f3 = if read then let loaded = __record-set r "item" (peek-qword buf 24) in 0 else poke-qword buf 24 r.item
    in let f4 = if read then let loaded = __record-set r "quantity" (peek-qword buf 32) in 0 else poke-qword buf 32 r.quantity
    in let f5 = if read then let loaded = __record-set r "offer" (peek-qword buf 40) in 0 else poke-qword buf 40 r.offer
    in let f6 = if read then let loaded = __record-set r "limit" (peek-qword buf 48) in 0 else poke-qword buf 48 r.limit
    in let f7 = if read then let loaded = __record-set r "recipe" (peek-qword buf 56) in 0 else poke-qword buf 56 r.recipe
    in let f8 = if read then let loaded = __record-set r "station" (peek-qword buf 64) in 0 else poke-qword buf 64 r.station
    in let f9 = if read then let loaded = __record-set r "node" (peek-qword buf 72) in 0 else poke-qword buf 72 r.node
    in 0

  tnlc-control-fields : TlControl, Integer, Boolean -> Integer
  tnlc-control-fields (r) (buf) (read) =
    let f0 = if read then let loaded = __record-set r "action" (peek-qword buf 0) in 0 else poke-qword buf 0 r.action
    in let f1 = if read then let loaded = __record-set r "goal" (peek-qword buf 8) in 0 else poke-qword buf 8 r.goal
    in let f2 = if read then let loaded = __record-set r "place" (peek-qword buf 16) in 0 else poke-qword buf 16 r.place
    in let f3 = if read then let loaded = __record-set r "vendor" (peek-qword buf 24) in 0 else poke-qword buf 24 r.vendor
    in let f4 = if read then let loaded = __record-set r "expires" (peek-qword buf 32) in 0 else poke-qword buf 32 r.expires
    in let f5 = if read then let loaded = __record-set r.target "x" (peek-qword buf 40) in 0 else poke-qword buf 40 r.target.x
    in let f6 = if read then let loaded = __record-set r.target "y" (peek-qword buf 48) in 0 else poke-qword buf 48 r.target.y
    in let f7 = if read then let loaded = __record-set r.target "z" (peek-qword buf 56) in 0 else poke-qword buf 56 r.target.z
    in 0

  tnlc-offer-fields : EaOffer, Integer, Boolean -> Integer
  tnlc-offer-fields (r) (buf) (read) =
    let f0 = if read then let loaded = __record-set r "owner" (peek-qword buf 0) in 0 else poke-qword buf 0 r.owner
    in let f1 = if read then let loaded = __record-set r "kind" (peek-qword buf 8) in 0 else poke-qword buf 8 r.kind
    in let f2 = if read then let loaded = __record-set r "target" (peek-qword buf 16) in 0 else poke-qword buf 16 r.target
    in let f3 = if read then let loaded = __record-set r "item" (peek-qword buf 24) in 0 else poke-qword buf 24 r.item
    in let f4 = if read then let loaded = __record-set r "remaining" (peek-qword buf 32) in 0 else poke-qword buf 32 r.remaining
    in let f5 = if read then let loaded = __record-set r "limit" (peek-qword buf 40) in 0 else poke-qword buf 40 r.limit
    in let f6 = if read then let loaded = __record-set r "expires" (peek-qword buf 48) in 0 else poke-qword buf 48 r.expires
    in 0

  tnlc-event-fields : EaEvent, Integer, Boolean -> Integer
  tnlc-event-fields (r) (buf) (read) =
    let f0 = if read then let loaded = __record-set r "sequence" (peek-qword buf 0) in 0 else poke-qword buf 0 r.sequence
    in let f1 = if read then let loaded = __record-set r "hour" (peek-qword buf 8) in 0 else poke-qword buf 8 r.hour
    in let f2 = if read then let loaded = __record-set r "principal" (peek-qword buf 16) in 0 else poke-qword buf 16 r.principal
    in let f3 = if read then let loaded = __record-set r "actor" (peek-qword buf 24) in 0 else poke-qword buf 24 r.actor
    in let f4 = if read then let loaded = __record-set r "kind" (peek-qword buf 32) in 0 else poke-qword buf 32 r.kind
    in let f5 = if read then let loaded = __record-set r "target" (peek-qword buf 40) in 0 else poke-qword buf 40 r.target
    in let f6 = if read then let loaded = __record-set r "item" (peek-qword buf 48) in 0 else poke-qword buf 48 r.item
    in let f7 = if read then let loaded = __record-set r "quantity" (peek-qword buf 56) in 0 else poke-qword buf 56 r.quantity
    in let f8 = if read then let loaded = __record-set r "offer" (peek-qword buf 64) in 0 else poke-qword buf 64 r.offer
    in let f9 = if read then let loaded = __record-set r "result" (peek-qword buf 72) in 0 else poke-qword buf 72 r.result
    in let f10 = if read then let loaded = __record-set r "price" (peek-qword buf 80) in 0 else poke-qword buf 80 r.price
    in let f11 = if read then let loaded = __record-set r "money-sequence" (peek-qword buf 88) in 0 else poke-qword buf 88 r.money-sequence
    in let f12 = if read then let loaded = __record-set r "proposed-kind" (peek-qword buf 96) in 0 else poke-qword buf 96 r.proposed-kind
    in let f13 = if read then let loaded = __record-set r "limit" (peek-qword buf 104) in 0 else poke-qword buf 104 r.limit
    in let f14 = if read then let loaded = __record-set r "recipe" (peek-qword buf 112) in 0 else poke-qword buf 112 r.recipe
    in let f15 = if read then let loaded = __record-set r "station" (peek-qword buf 120) in 0 else poke-qword buf 120 r.station
    in let f16 = if read then let loaded = __record-set r "node" (peek-qword buf 128) in 0 else poke-qword buf 128 r.node
    in 0

  tnlc-list : Integer, Integer, List Integer, Boolean -> Integer
  tnlc-list (buf) (at) (xs) (read) = if read then ts-read-list buf at xs 0 else ts-write-list buf at xs 0
  tnlc-agents : TownNetworkLive, Integer, Boolean, Integer -> Integer
  tnlc-agents (n) (buf) (read) (i) = if i == 3 then 0
    else let r = list-at n.agents i
    in let at = tnlc-agent-at + i * tnlc-agent-bytes
    in let fields = tnlc-agent-fields r (buf + at) read
    in let hours = tnlc-list buf (at + 144) r.hours read
    in let inputs = tnlc-list buf (at + 176) r.state.inputs read
    in let hidden = tnlc-list buf (at + 432) r.state.hidden read
    in let outputs = tnlc-list buf (at + 560) r.state.outputs read
    in let queue = tnlc-list buf (at + 672) r.state.queue read
    in let proposal = tnlc-proposal-fields r.proposal (buf + at + 752) read
    in let control = if read then 0 else tnlc-control-write (list-at n.actions.town.residents i).control (buf + at + 832)
    in tnlc-agents n buf read (i + 1)
  tnlc-derived-control : TlControl -> Boolean
  tnlc-derived-control (c) = c.expires /= 0 & (c.action == 0 | c.action == 1 | c.action == 4)
  tnlc-control-write : TlControl, Integer -> Integer
  tnlc-control-write (c) (buf) = let written = tnlc-control-fields c buf False
    in if not (tnlc-derived-control c) then written
    else let a = poke-qword buf 8 0
    in let b = poke-qword buf 16 0
    in let x = poke-qword buf 40 0
    in let y = poke-qword buf 48 0
    in poke-qword buf 56 0
  tnlc-control-derive : TownLive, TlResident -> Integer
  tnlc-control-derive (t) (r) = let c = r.control
    in if not (tnlc-derived-control c) then 0
    else let p = tf-person t.people r.person
    in let spot = if c.action == 0 then r.home else if c.action == 1 then r.work else r.tavern
    in let goal = __record-set c "goal" (if c.action == 0 then 0 else if c.action == 1 then 1 else 2)
    in let place = __record-set c "place" (tf-place p (tf-town t.people p.town) c.action)
    in tl-copy-spot c.target spot
  tnlc-sum : List Integer, Integer, Integer -> Integer
  tnlc-sum (xs) (i) (sum) = if i == list-length xs then sum else tnlc-sum xs (i + 1) (sum + list-at xs i)
  tnlc-positives : List Integer, Integer, Integer -> Integer
  tnlc-positives (xs) (i) (count) = if i == 10 then count
    else tnlc-positives xs (i + 1) (if list-at xs i > 0 then count + 1 else count)
  tnlc-derive : TownNetworkLive, TownLive, Integer -> Integer
  tnlc-derive (n) (t) (i) = if i == 3 then 0
    else let r = list-at n.agents i
    in let total = __record-set r "total" (tnlc-sum r.hours 0 0)
    in let count = __record-set r.state "count" (tnlc-positives r.state.outputs 0 0)
    in let actor = __record-set r.proposal "actor" r.actor
    in let prepared = __record-set r "prepared" (if r.prepared == 0 then 0 else r.proposal.kind)
    in let control = tnlc-control-derive t (list-at t.residents i)
    in tnlc-derive n t (i + 1)
  tnlc-controls : TownLive, Integer, Integer -> Integer
  tnlc-controls (t) (buf) (i) = if i == 3 then 0
    else let loaded = tnlc-control-fields (list-at t.residents i).control (buf + tnlc-agent-at + i * tnlc-agent-bytes + 832) True
    in tnlc-controls t buf (i + 1)
  tnlc-offers : GameLiveActions, Integer, Boolean, Integer -> Integer
  tnlc-offers (g) (buf) (read) (i) = if i == g.book.offer-count then 0
    else let at = tnlc-offers-at + i * 72
    in let fields = tnlc-offer-fields (list-at g.book.offers i) (buf + at) read
    in let copper = if read then poke-qword g.copper (i * 8) (peek-qword buf (at + 56)) else poke-qword buf (at + 56) (peek-qword g.copper (i * 8))
    in let silver = if read then poke-qword g.silver (i * 8) (peek-qword buf (at + 64)) else poke-qword buf (at + 64) (peek-qword g.silver (i * 8))
    in tnlc-offers g buf read (i + 1)
  tnlc-events : GameLiveActions, Integer, Boolean, Integer -> Integer
  tnlc-events (g) (buf) (read) (i) = if i == g.book.event-count then 0
    else let at = tnlc-offers-at + g.book.offer-count * 72 + i * tnlc-event-bytes
    in let fields = tnlc-event-fields (list-at g.book.events i) (buf + at) read
    in tnlc-events g buf read (i + 1)
  tnlc-range : Integer, Integer, Integer, Integer -> Boolean
  tnlc-range (buf) (at) (low) (high) = let value = peek-qword buf at in value >= low & value <= high
  tnlc-cells : Integer, Integer, Integer, Integer, Integer -> Boolean
  tnlc-cells (buf) (count) (low) (high) (i) = if i == count then True
    else tnlc-range buf (i * 8) low high & tnlc-cells buf count low high (i + 1)
  tnlc-history : TownLive, Integer, Integer, Integer, Integer -> Boolean
  tnlc-history (t) (buf) (row) (i) (sum) = if i == 4 then True
    else let hours = peek-qword row (144 + i * 8)
    in if hours < 0 | hours > ep-limit - sum then False
    else if hours > 0 & (i >= t.people.town-count | peek-qword buf (128 + i * 8) /= 1) then False
    else tnlc-history t buf row (i + 1) (sum + hours)
  tnlc-positive : Integer, Integer -> Integer
  tnlc-positive (row) (i) = if i == 10 then 0
    else (if peek-qword row (560 + i * 8) > 0 then 1 else 0) + tnlc-positive row (i + 1)
  tnlc-queue : Integer, Integer, Integer -> Boolean
  tnlc-queue (row) (count) (i) = if i == count then True
    else let action = peek-qword row (672 + i * 8)
    in let score = peek-qword row (560 + action * 8)
    in let prior = if i == 0 then action else peek-qword row (672 + (i - 1) * 8)
    in let prior-score = peek-qword row (560 + prior * 8)
    in score > 0 & (i == 0 | prior-score > score | (prior-score == score & prior < action)) & tnlc-queue row count (i + 1)
  tnlc-control-valid : TownLive, WalkMap, Integer, Integer -> Boolean
  tnlc-control-valid (t) (map) (row) (i) = let buf = row + 832
    in let action = peek-qword buf 0
    in let vendor = peek-qword buf 24
    in if (action /= 0 & action /= 1 & action /= 3 & action /= 4)
      | not (tnlc-range buf 8 0 2 & tnlc-range buf 16 0 ep-limit & tnlc-range buf 24 0 world-serial-mask
        & tnlc-range buf 32 0 tl-max-seconds & tnlc-range buf 40 0 6143
        & tnlc-range buf 48 0 4095 & tnlc-range buf 56 -128 127) then False
    else if peek-qword buf 32 == 0 then True
    else if action /= 3 then vendor == 0
    else if walk-cell map (peek-qword buf 40) (peek-qword buf 48) < 0 then False
    else gv-vendor t.vendors vendor 0 >= 0 & peek-qword buf 8 == 1 & (when world-get t.vendors.game.world vendor is Err (_) -> False is Ok (_) -> True)
  tnlc-proposal-valid : TownLive, Integer, Integer -> Boolean
  tnlc-proposal-valid (t) (buf) (row) = let p = row + 752
    in tnlc-range p 8 0 10
      & tnlc-range p 16 0 t.vendors.currency.world.actor-count
      & tnlc-range p 24 0 (list-length t.vendors.currency.world.catalog.items)
      & tnlc-range p 32 0 ep-stock-limit & tnlc-range p 40 0 (peek-qword buf 56)
      & tnlc-range p 48 0 1000000 & peek-qword p 56 == 0 & peek-qword p 64 == 0 & peek-qword p 72 == 0
  tnlc-agents-valid : TownLive, WalkMap, Integer, Integer -> Boolean
  tnlc-agents-valid (t) (map) (buf) (i) = if i == 3 then True
    else let row = buf + tnlc-agent-at + i * tnlc-agent-bytes
    in let r = list-at t.residents i
    in let maximum = tn-hidden-count * tn-hidden-bound * tn-weight-bound / tn-scale + tn-weight-bound
    in let count = tnlc-positive row 0
    in if ((tf-person t.people r.person).alive == 1 & not (tl-controlled t r.person r.actor))
      | peek-qword row 16 /= (if i == 0 then 34 else if i == 1 then 69 else 72)
      | peek-qword row 24 /= (if i == 1 then 1 else 0)
      | not (eg-id t.vendors.currency.world.catalog (peek-qword row 32))
      | not (tnlc-range row 40 0 2147483647 & tnlc-range row 48 0 10
        & tnlc-range row 56 0 tl-max-seconds & tnlc-range row 64 0 tl-max-seconds
        & tnlc-range row 72 0 tl-max-seconds & tnlc-range row 80 0 ep-limit
        & tnlc-range row 88 -20 1 & tnlc-range row 96 1 t.people.town-count
        & tnlc-range row 104 0 t.vendors.currency.world.hour & tnlc-range row 120 0 count)
      | peek-qword row 136 /= 0 then False
    else if peek-qword row 96 /= (tf-person t.people r.person).town
      | peek-qword buf (128 + (peek-qword row 96 - 1) * 8) /= 1
      | not (tnlc-history t buf row 0 0)
      | not (tnlc-cells (row + 176) 32 -1000 1000 0 & tnlc-cells (row + 416) 2 0 1000 0
        & tnlc-cells (row + 432) 16 0 4000 0 & tnlc-cells (row + 560) 10 (0 - maximum) maximum 0
        & tnlc-cells (row + 640) 2 0 1000 0 & tnlc-cells (row + 656) 2 -1000 1000 0
        & tnlc-cells (row + 672) 10 0 9 0) then False
    else let head = peek-qword row 120
    in let prepared = if peek-qword row 48 == 0 then 0 else peek-qword row 760
    in if not (tnlc-queue row count 0)
      | (prepared > 0 & (head == count | (if head >= count then True else peek-qword row (672 + head * 8) + 1 /= prepared)))
      | ((tf-person t.people r.person).alive == 1 & not (tnlc-proposal-valid t buf row & tnlc-control-valid t map row i)) then False
    else tnlc-agents-valid t map buf (i + 1)
  tnlc-offers-valid : TownLive, Integer, Integer -> Boolean
  tnlc-offers-valid (t) (buf) (i) = if i == peek-qword buf 56 then True
    else let row = buf + tnlc-offers-at + i * 72
    in let owner = peek-qword row 0
    in let target = peek-qword row 16
    in let copper = peek-qword row 56
    in let silver = peek-qword row 64
    in if gla-vendor-actor t.vendors owner 0 < 0 | not (tnlc-range row 8 2 3)
      | (target /= 0 & not (ep-valid-actor t.vendors.currency.world target)) | owner == target
      | not (eg-id t.vendors.currency.world.catalog (peek-qword row 24))
      | not (tnlc-range row 32 0 ep-stock-limit & tnlc-range row 40 1 1000000 & tnlc-range row 48 0 ep-limit)
      | copper < 1 | copper > 1000000 | silver < 1 | silver > copper then False
    else int-mod copper silver == 0 & tnlc-offers-valid t buf (i + 1)
  tnlc-events-valid : TownLive, Integer, Integer -> Boolean
  tnlc-events-valid (t) (buf) (i) = if i == peek-qword buf 64 then True
    else let row = buf + tnlc-offers-at + peek-qword buf 56 * 72 + i * tnlc-event-bytes
    in peek-qword row 0 == peek-qword buf 72 - peek-qword buf 64 + i + 1
      & tnlc-range row 8 0 t.vendors.currency.world.hour
      & tnlc-range row 88 0 t.vendors.currency.world.money.sequence
      & tnlc-events-valid t buf (i + 1)
  tnlc-body-valid : TownLive, WalkMap, Integer -> Boolean
  tnlc-body-valid (t) (map) (buf) = tnlc-cells (buf + 128) 4 0 1 0
    & tnlc-cells (buf + 160) 4 -1000 1000 0
    & tnlc-agents-valid t map buf 0 & tnlc-offers-valid t buf 0 & tnlc-events-valid t buf 0
  tnlc-agent-why : TownLive, WalkMap, Integer, Integer -> Text
  tnlc-agent-why (t) (map) (buf) (i) = let row = buf + tnlc-agent-at + i * tnlc-agent-bytes
    in let r = list-at t.residents i
    in let p = tf-person t.people r.person
    in let control = row + 832
    in let tag = "agent " & show i & " alive " & show p.alive & " "
    in if p.alive == 1 & not (tl-controlled t r.person r.actor) then tag & "uncontrolled"
    else if p.alive == 1 & not (tnlc-proposal-valid t buf row) then tag & "proposal"
    else if p.alive == 1 & not (tnlc-control-valid t map row i) then tag & "control action " & show (peek-qword control 0)
      & " vendor " & show (peek-qword control 24) & " at " & show (peek-qword control 40) & "," & show (peek-qword control 48)
    else tag & "fields"
  tnlc-agent-fault : TownLive, WalkMap, Integer, Integer -> Text
  tnlc-agent-fault (t) (map) (buf) (i) = if i >= 2 | tnlc-agents-valid t map buf (i + 1) then tnlc-agent-why t map buf i
    else tnlc-agent-fault t map buf (i + 1)
  tnlc-fault : TownLive, WalkMap, Integer -> Text
  tnlc-fault (t) (map) (buf) = if not (tnlc-cells (buf + 128) 4 0 1 0 & tnlc-cells (buf + 160) 4 -1000 1000 0) then "culture"
    else if not (tnlc-agents-valid t map buf 0) then tnlc-agent-fault t map buf 0
    else if not (tnlc-offers-valid t buf 0) then "offers"
    else if not (tnlc-events-valid t buf 0) then "events" else "none"
  tnlc-shapes : TownNetworkLive, Integer -> Boolean
  tnlc-shapes (n) (i) = if i == 3 then True
    else let r = list-at n.agents i
    in list-length r.hours == 4 & list-length r.state.inputs == 32
      & list-length r.state.hidden == 16 & list-length r.state.outputs == 14
      & list-length r.state.queue == 10 & tnlc-shapes n (i + 1)
  tnlc-encode : TownNetworkLive, WalkMap, Integer, Integer -> Result Integer Text
  tnlc-encode (n) (map) (buf) (capacity) =
    if list-length n.agents /= 3 | n.actions.town.count /= 3
      | not (ev-range n.actions.book.offer-count (list-length n.actions.book.offers) & ev-range n.actions.book.event-count 1024
        & ev-range n.actions.book.sequence ep-limit & ev-range n.cursor 2)
      | n.actions.book.sequence < n.actions.book.event-count then Err "live network codec state extent"
    else if list-length n.culture.trade /= 4 | list-length n.culture.known /= 4
      | list-length n.actions.book.offers < 256 | list-length n.actions.book.events /= 1024
      | not (tnlc-shapes n 0) | n.model-id /= tnv-model-id n.model then Err "live network codec model or buffers"
    else let size = tnlc-size n
    in if capacity < size then Err "live network codec destination"
    else let zero = ts-zero buf size 0
    in let a = poke-qword buf 0 #314C4E54
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 size
    in let d = poke-qword buf 24 n.model-id
    in let e = poke-qword buf 32 3
    in let f = poke-qword buf 40 n.cursor
    in let g = poke-qword buf 56 n.actions.book.offer-count
    in let h = poke-qword buf 64 n.actions.book.event-count
    in let j = poke-qword buf 72 n.actions.book.sequence
    in let known = tnlc-list buf 128 n.culture.known False
    in let trade = tnlc-list buf 160 n.culture.trade False
    in let agents = tnlc-agents n buf False 0
    in let offers = tnlc-offers n.actions buf False 0
    in let events = tnlc-events n.actions buf False 0
    in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261) in Ok size
  tnlc-check : TownNetworkLive, WalkMap -> Integer
  tnlc-check (n) (map) = let mark = __heap-save
    in let size = tnlc-size n
    in let buf = alloc-bytes size
    in let bad = when tnlc-encode n map buf size
      is Err (_) -> 1
      is Ok (_) -> if tnlc-body-valid n.actions.town map buf then 0 else 1
    in let restored = __heap-restore mark in bad
  tnlc-check-text : TownNetworkLive, WalkMap -> Text
  tnlc-check-text (n) (map) = let size = tnlc-size n
    in let buf = alloc-bytes size
    in when tnlc-encode n map buf size
      is Err (e) -> e
      is Ok (_) -> "live network codec binding: " & tnlc-fault n.actions.town map buf
  tnlc-decode : Integer, Integer, TownLive, WalkMap -> Result TownNetworkLive Text
  tnlc-decode (buf) (size) (t) (map) =
    if size < tnlc-offers-at
      | t.count /= 3 | list-length t.residents /= 3 then Err "live network codec extent"
    else if peek-qword buf 0 /= #314C4E54 | peek-qword buf 8 /= 1 | peek-qword buf 16 /= size
      | peek-qword buf 32 /= 3 | not (tnlc-range buf 40 0 2 & tnlc-range buf 56 0 (size / 72)
        & tnlc-range buf 64 0 1024 & tnlc-range buf 72 (peek-qword buf 64) ep-limit)
      | not (es-zero-range buf 80 128) then Err "live network codec header"
    else if size /= tnlc-offers-at + peek-qword buf 56 * 72 + peek-qword buf 64 * tnlc-event-bytes
      | peek-qword buf 48 /= ws-hash buf size 0 2166136261 then Err "live network codec checksum or length"
    else if not (tnlc-body-valid t map buf) then Err "live network codec bindings"
    else when tn-trained-model 0
      is Err (e) -> Err e
      is Ok (model) -> if tnv-model-id model /= peek-qword buf 24 then Err "live network model changed"
        else when tnv-bind t model
          is Err (e) -> Err e
          is Ok (n) ->
            let cursor = __record-set n "cursor" (peek-qword buf 40)
            in let fitted = tnlc-grow-offers n.actions (peek-qword buf 56)
            in let oc = __record-set n.actions.book "offer-count" (peek-qword buf 56)
            in let ec = __record-set n.actions.book "event-count" (peek-qword buf 64)
            in let seq = __record-set n.actions.book "sequence" (peek-qword buf 72)
            in let known = tnlc-list buf 128 n.culture.known True
            in let trade = tnlc-list buf 160 n.culture.trade True
            in let agents = tnlc-agents n buf True 0
            in let offers = tnlc-offers n.actions buf True 0
            in let events = tnlc-events n.actions buf True 0
            in let controls = tnlc-controls t buf 0
            in let derived = tnlc-derive n t 0
            in let felt = tnv-feel n 0 in Ok n

