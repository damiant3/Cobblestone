Chapter: EconomyFighter
  cites Uoaix chapter BritainProduction

  EfFighter = record { producer : BbProducer, place : Integer, looted : Integer, taxed : Integer }
  ef-new : EuCurrency, Integer, Integer -> Result EfFighter Text
  ef-new (x) (owner) (place) =
    let purse = eu-open x 2 owner
    in let actor = if purse < 1 then -1 else ep-admit x.world purse place
    in if actor < 1 then Err "fighter actor refused"
    else Ok (EfFighter { producer = bb-producer x actor, place = place, looted = 0, taxed = 0 })
 Loot is found goods, so it carries no cost basis into the tax.
  ef-loot : EfFighter, Integer -> Integer
  ef-loot (f) (gold) = let w = f.producer.currency.world
    in if ep-find w f.producer.actor 6 gold < 0 then -1
    else let share = eh-find-tax-at w f.producer.actor 6 gold 1000 0
    in let kept = __record-set f "looted" (f.looted + gold - share)
    in let paid = __record-set f "taxed" (f.taxed + share)
    in gold - share
