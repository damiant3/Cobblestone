Chapter: MiningTiles

 ServUO Scripts/Services/Harvest/Mining.cs m_MountainAndCaveTiles, the land tile IDs, GPL-2.0;
 ports/ServUO-LICENSE.txt. No land TILEDATA entry sets flag bit 31, so the map loaders mark a
 mountain or cave land tile with it; install-map-cache.ps1 reads the ranges from this chapter.
  mt-mountain-flag : Integer = 2147483648
  mt-mountain : Integer -> Boolean
  mt-mountain (g) = if g < 1741 then mt-mountain-low g else mt-mountain-high g
  mt-mountain-low : Integer -> Boolean
  mt-mountain-low (g) = (g >= 220 & g <= 231) | (g >= 236 & g <= 247) | (g >= 252 & g <= 263) | (g >= 268 & g <= 279)
    | (g >= 286 & g <= 294) | (g >= 296 & g <= 297) | (g >= 321 & g <= 324) | (g >= 467 & g <= 474) | (g >= 476 & g <= 487)
    | (g >= 492 & g <= 495) | (g >= 543 & g <= 579) | (g >= 581 & g <= 601) | (g >= 610 & g <= 613) | g == 1010
  mt-mountain-high : Integer -> Boolean
  mt-mountain-high (g) = (g >= 1741 & g <= 1757) | (g >= 1771 & g <= 1790) | (g >= 1801 & g <= 1809) | (g >= 1811 & g <= 1824)
    | (g >= 1831 & g <= 1854) | (g >= 1861 & g <= 1884) | (g >= 1981 & g <= 2004) | (g >= 2028 & g <= 2033) | (g >= 2100 & g <= 2105)
  mt-mark : Integer, Integer -> Integer
  mt-mark (graphic) (flags) = if mt-mountain graphic then bit-or flags mt-mountain-flag else flags
