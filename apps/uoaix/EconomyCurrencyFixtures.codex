  cites Foreword chapter Result

  EuiScenario = record { state : CurrencyCheckpoint, entries : List CurrencyInput,
    middle : Integer, failed : Integer }
  efi-source : Integer -> Result CurrencyCheckpoint Text
  efi-source (unused) = when ep-new (ex-catalog 0) (em-new 0)
    is Err (e) -> Err e
    is Ok (w) -> when eu-new w
      is Err (e) -> Err e
      is Ok (x) -> Ok (CurrencyCheckpoint { currency = x, tick = 0, sequence = 0 })
  efi-send : EuiScenario, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  efi-send (s) (op) (a) (b) (c) (d) (e) (f) (g) =
    if list-length s.entries == 512 then let failed = __record-set s "failed" 1 in -999
    else let sequence = s.state.sequence + 1
    in let entry = eui-new sequence (sequence * 10) op
    in let a0 = list-set-at entry.args 0 a
    in let a1 = list-set-at entry.args 1 b
    in let a2 = list-set-at entry.args 2 c
    in let a3 = list-set-at entry.args 3 d
    in let a4 = list-set-at entry.args 4 e
    in let a5 = list-set-at entry.args 5 f
    in let a6 = list-set-at entry.args 6 g
    in let result = eui-execute s.state.currency entry
    in let outcome = __record-set entry "expected" result
    in let position = __record-set s.state "sequence" sequence
    in let tick = __record-set s.state "tick" (sequence * 10)
    in let saved = __record-set s "entries" (list-push s.entries entry)
    in result
  efi-mine : EuiScenario, Integer, Integer, Integer, Integer -> Integer
  efi-mine (s) (item) (one) (two) (tries) =
    if ep-at (ep-actor s.state.currency.world 1).stock item >= 2 then 0
    else if tries == 0 then let failed = __record-set s "failed" 1 in -1
    else let node = if (list-at s.state.currency.world.nodes (one - 1)).stage == 2 then one else two
    in let result = efi-send s 15 1 node 0 0 0 0 0
    in if result == -1 | result == -999 then let failed = __record-set s "failed" 1 in -1
    else efi-mine s item one two (tries - 1)
  efi-craft : EuiScenario, Integer, Integer, Integer, Integer -> Integer
  efi-craft (s) (recipe) (station) (item) (tries) =
    if ep-at (ep-actor s.state.currency.world 1).stock item > 0 then 0
    else if tries == 0 then let failed = __record-set s "failed" 1 in -1
    else let result = efi-send s 16 1 recipe station 0 0 0 0
    in if result == -1 | result == -999 then let failed = __record-set s "failed" 1 in -1
    else efi-craft s recipe station item (tries - 1)
  efi-hours : EuiScenario, Integer -> Integer
  efi-hours (s) (count) = if count == 0 then 0
    else if efi-send s 21 0 0 0 0 0 0 0 /= 0 then let failed = __record-set s "failed" 1 in -1
    else efi-hours s (count - 1)
  efi-build : CurrencyCheckpoint -> EuiScenario
  efi-build (state) =
    let s = EuiScenario { state = state, entries = [], middle = 0, failed = 0 }
    in let p1 = efi-send s 1 5 1 0 0 0 0 0
    in let p2 = efi-send s 1 2 7 0 0 0 0 0
    in let p3 = efi-send s 1 3 9 0 0 0 0 0
    in let a1 = efi-send s 2 2 100 0 0 0 0 0
    in let st1 = efi-send s 3 1 1 100 0 0 0 0
    in let st2 = efi-send s 3 1 3 100 0 0 0 0
    in let st3 = efi-send s 3 1 12 100 0 0 0 0
    in let n1 = efi-send s 4 1 100 0 0 0 0 0
    in let n2 = efi-send s 4 1 100 0 0 0 0 0
    in let n3 = efi-send s 4 2 100 0 0 0 0 0
    in let n4 = efi-send s 4 2 100 0 0 0 0 0
    in let n5 = efi-send s 4 2 100 0 0 0 0 0
    in let n6 = efi-send s 4 6 100 0 0 0 0 0
    in let n7 = efi-send s 4 6 100 0 0 0 0 0
    in let n8 = efi-send s 4 25 100 0 0 0 0 0
    in let n9 = efi-send s 4 25 100 0 0 0 0 0
    in let n10 = efi-send s 4 26 100 0 0 0 0 0
    in let n11 = efi-send s 4 26 100 0 0 0 0 0
    in let stone1 = efi-send s 15 1 1 0 0 0 0 0
    in let stone2 = efi-send s 15 1 2 0 0 0 0 0
    in let branch1 = efi-send s 15 1 3 0 0 0 0 0
    in let branch2 = efi-send s 15 1 4 0 0 0 0 0
    in let branch3 = efi-send s 15 1 5 0 0 0 0 0
    in let pick1 = efi-send s 16 1 1 1 0 0 0 0
    in let pick2 = efi-send s 16 1 1 1 0 0 0 0
    in let pick3 = efi-send s 16 1 1 1 0 0 0 0
    in let hammer = efi-send s 16 1 31 1 0 0 0 0
    in let gold = efi-mine s 6 6 7 128
    in let copper = efi-mine s 63 8 9 128
    in let silver = efi-mine s 64 10 11 128
    in let smeltg = efi-craft s 8 2 32 128
    in let smeltc = efi-craft s 32 2 65 128
    in let smelts = efi-craft s 33 2 66 128
    in let policyc = efi-send s 9 1 1 1 1000 0 0 0
    in let policys = efi-send s 9 1 1 2 100 0 0 0
    in let policyg = efi-send s 9 1 1 3 10 0 0 0
    in let denied = efi-send s 10 0 1 3 1 1 0 0
    in let mintc = efi-send s 10 1 1 3 1 1 0 0
    in let mints = efi-send s 10 1 1 3 2 1 0 0
    in let mintg = efi-send s 10 1 1 3 3 1 0 0
    in let middle = __record-set s "middle" s.state.sequence
    in let grant = efi-send s 12 1 1 2 10 1 1 0
    in let loanc = efi-send s 13 1 1 3 1 200 10 2
    in let loans = efi-send s 13 1 1 3 2 20 2 2
    in let loang = efi-send s 13 1 1 3 3 2 1 2
    in let tax = efi-send s 8 1 1 1000 0 0 0 0
    in let refused = efi-send s 11 0 3 4 100 10 1 0
    in let paid = efi-send s 11 1 3 4 100 10 1 0
    in let rates = efi-send s 7 1 1 200 20 0 0 0
    in let away = efi-send s 6 1 101 0 0 0 0 0
    in let back = efi-send s 6 1 100 0 0 0 0 0
    in let time = efi-hours s 24
    in let repay = efi-send s 14 1 3 3 1 1 0 0
    in s
  efi-valid : CurrencyCheckpoint -> Boolean
  efi-valid (state) = let x = state.currency
    in euv-valid x & x.world.hour == 24 & x.copper-rate == 200 & x.silver-rate == 20
      & x.copper.issued == 1000 & x.silver.issued == 100 & x.world.money.issued == 10
      & x.copper.defaults == 1 & x.silver.defaults == 1 & x.world.money.defaults == 1
      & (em-purse x.copper 1).coin == 800 & (em-purse x.silver 1).coin == 80 & (em-purse x.world.money 1).coin == 8
      & (em-purse x.copper 3).coin == 100 & (em-purse x.silver 3).coin == 10 & (em-purse x.world.money 3).coin == 0
      & (em-purse x.copper 4).coin == 90 & (em-purse x.silver 4).coin == 9 & (em-purse x.world.money 4).coin == 1
      & (list-at x.world.money.loans 0).paid == 1 & x.copper-ingots == 1 & x.silver-ingots == 1 & x.world.mint-ingots == 1
