Chapter: WorldFlora
  cites Uoaix chapter GameSkillsItems
  cites Uoaix chapter MulReaders

 FLR1 (transform-flora.ps1): a 64-byte header of qwords (magic, version 1, rows, blocks 393216, directory offset 64,
 row offset, row size 12), a u32 first-row directory over the 393,216 map blocks plus one end entry, then 12-byte
 rows: x u16, y u16, art u16, hue u16, z s8, kind u8 (0 tree, 1 tree vine, 2 other flora), original ordinal u16.

  WfState = record { data : Integer, count : Integer, directory : Integer, rows : Integer, viewers : List WfViewer, clock : Integer, refused : Integer,
    show : Integer, sites : Integer }
  WfViewer = record { connection : Integer, visible : Integer, shown : Integer, shown-count : Integer,
    cursor : Integer, row : Integer, view-x : Integer, view-y : Integer, used : Integer, pending : Integer, pending-count : Integer }
 A row's display code (show): 0 its own art, 1 a stump, 2 a sapling, 3 not drawn (a felled tree's leaves and vines).
 Stump 0x0E56 and sapling 0x0CE9 are the 1.25.32 TILEDATA "stump" and "sapling" art.
  wf-stump-art : Integer = #0E56
  wf-sapling-art : Integer = #0CE9
 GameHarvest holds at most 256 sites; a viewer queues at most 64 redrawn rows between pulses.
  wf-site-limit : Integer = 256
  wf-pending-limit : Integer = 64
  wf-serial-base : Integer = #7C000000
  wf-viewer-limit : Integer = 8
 A 37x37 view holds at most 1369 cells; three flora statics a cell bounds it at 4107.
  wf-shown-limit : Integer = 4096
  wf-blocks : Integer = 393216
  wf-viewers : Integer, Integer, List WfViewer -> List WfViewer
  wf-viewers (count) (left) (xs) = if left == 0 then xs
    else let visible = alloc-bytes (wf-bitmap-bytes count)
    in let cleared = wf-zero visible 0 (wf-bitmap-bytes count)
    in wf-viewers count (left - 1) (list-push xs (WfViewer { connection = -1, visible = visible, shown = alloc-bytes (wf-shown-limit * 4),
      shown-count = 0, cursor = -1, row = -1, view-x = -1, view-y = -1, used = 0, pending = alloc-bytes (wf-pending-limit * 4), pending-count = 0 }))
  wf-bitmap-bytes : Integer -> Integer
  wf-bitmap-bytes (count) = (count / 64 + 1) * 8
  wf-zero : Integer, Integer, Integer -> Integer
  wf-zero (buffer) (i) (count) = if i >= count then 0 else let cleared = poke-qword buffer i 0 in wf-zero buffer (i + 8) count
  wf-first : WfState, Integer -> Integer
  wf-first (s) (block) = peek-32 s.directory (block * 4)
  wf-x : WfState, Integer -> Integer
  wf-x (s) (i) = mul-u16 s.rows (i * 12)
  wf-y : WfState, Integer -> Integer
  wf-y (s) (i) = mul-u16 s.rows (i * 12 + 2)
  wf-art : WfState, Integer -> Integer
  wf-art (s) (i) = mul-u16 s.rows (i * 12 + 4)
  wf-hue : WfState, Integer -> Integer
  wf-hue (s) (i) = mul-u16 s.rows (i * 12 + 6)
  wf-z : WfState, Integer -> Integer
  wf-z (s) (i) = mul-s8 (peek-byte s.rows (i * 12 + 8))
  wf-rows-valid : WfState, Integer, Integer -> Boolean
  wf-rows-valid (s) (block) (i) = if block == wf-blocks then i == s.count
    else let last = wf-first s (block + 1)
    in if last < i | last > s.count then False
    else if not (wf-block-valid s block i last) then False
    else wf-rows-valid s (block + 1) last
  wf-block-valid : WfState, Integer, Integer, Integer -> Boolean
  wf-block-valid (s) (block) (i) (last) = if i == last then True
    else if wf-x s i / 8 /= block / 512 | wf-y s i / 8 /= int-mod block 512 | wf-art s i >= 16384 | peek-byte s.rows (i * 12 + 9) > 2 then False
    else wf-block-valid s block (i + 1) last
  wf-read : Integer, Integer -> Result WfState Text
  wf-read (data) (size) = if size < 64 | peek-qword data 0 /= #31524C46 | peek-qword data 8 /= 1 then Err "flora table is not FLR1"
    else let count = peek-qword data 16
    in if peek-qword data 24 /= wf-blocks | peek-qword data 32 /= 64 | peek-qword data 48 /= 12 | count < 0
      | count > #7E000000 - wf-serial-base - 1 | peek-qword data 40 /= 64 + (wf-blocks + 1) * 4 | size /= peek-qword data 40 + count * 12 then Err "flora table extent invalid"
    else let show = alloc-bytes (wf-bitmap-bytes (count * 8))
    in let shown-clear = wf-zero show 0 (wf-bitmap-bytes (count * 8))
    in let sites = alloc-bytes wf-site-limit
    in let sites-clear = wf-fill sites 0 wf-site-limit 255
    in let s = WfState { data = data, count = count, directory = data + 64, rows = data + peek-qword data 40, viewers = wf-viewers count wf-viewer-limit [], clock = 0, refused = 0,
      show = show, sites = sites }
    in if wf-first s 0 /= 0 | not (wf-rows-valid s 0 0) then Err "flora table rows invalid" else Ok s
  wf-fill : Integer, Integer, Integer, Integer -> Integer
  wf-fill (buffer) (i) (count) (value) = if i == count then 0 else let set = poke-byte buffer i value in wf-fill buffer (i + 1) count value
  wf-code : WfState, Integer -> Integer
  wf-code (s) (i) = peek-byte s.show i
  wf-shown-art : WfState, Integer -> Integer
  wf-shown-art (s) (i) = let code = wf-code s i in if code == 1 then wf-stump-art else if code == 2 then wf-sapling-art else wf-art s i
  wf-seen : WfViewer, Integer -> Boolean
  wf-seen (v) (i) = bit-and (peek-byte v.visible (i / 8)) (bit-shl 1 (int-mod i 8)) /= 0
  wf-mark : WfViewer, Integer, Boolean -> Integer
  wf-mark (v) (i) (on) = let at = i / 8
    in let bit = bit-shl 1 (int-mod i 8)
    in let old = peek-byte v.visible at
    in poke-byte v.visible at (if on then bit-or old bit else bit-and old (255 - bit))
  wf-packet : WfState, Integer -> List Integer
  wf-packet (s) (i) = let hue = wf-hue s i
    in let a = gp-put16 (gp-put32 [#1A,0,0] (wf-serial-base + i + 1)) (wf-shown-art s i)
    in let b = gp-put16 (gp-put16 a (wf-x s i)) (wf-y s i + (if hue == 0 then 0 else #8000))
    in let c = list-push b (bit-and (wf-z s i) 255)
    in sip-length (if hue == 0 then c else gp-put16 c hue)
  wf-viewer-find : List WfViewer, Integer, Integer -> Integer
  wf-viewer-find (viewers) (connection) (i) = if i == list-length viewers then -1
    else if (list-at viewers i).connection == connection then i else wf-viewer-find viewers connection (i + 1)
  wf-viewer-oldest : List WfViewer, Integer, Integer -> Integer
  wf-viewer-oldest (viewers) (i) (best) = if i == list-length viewers then best
    else wf-viewer-oldest viewers (i + 1) (if (list-at viewers i).used < (list-at viewers best).used then i else best)
  wf-viewer : WfState, Integer -> WfViewer
  wf-viewer (s) (connection) = let found = wf-viewer-find s.viewers connection 0
    in let v = list-at s.viewers (if found >= 0 then found else wf-viewer-oldest s.viewers 0 0)
    in let fresh = if found >= 0 then 0 else
      let cleared = wf-zero v.visible 0 (wf-bitmap-bytes s.count)
      in let a = __record-set v "connection" connection
      in let b = __record-set v "shown-count" 0
      in let p = __record-set v "pending-count" 0
      in let c = __record-set v "cursor" -1
      in let d = __record-set v "view-x" -1
      in let e = __record-set v "view-y" -1 in 0
    in let tick = __record-set s "clock" (s.clock + 1)
    in let used = __record-set v "used" s.clock in v
  wf-near : WfState, Integer, Integer, Integer -> Boolean
  wf-near (s) (i) (x) (y) = walk-abs (x - wf-x s i) <= 18 & walk-abs (y - wf-y s i) <= 18
  wf-prune : WfState, WfViewer, Integer, Integer, Integer, Integer -> Integer
  wf-prune (s) (v) (x) (y) (i) (kept) = if i == v.shown-count then let count = __record-set v "shown-count" kept in 0
    else let row = peek-32 v.shown (i * 4)
    in let near = wf-near s row x y
    in let saved = if near then poke-32 v.shown (kept * 4) row else wf-mark v row False
    in wf-prune s v x y (i + 1) (kept + (if near then 1 else 0))
 The view's blocks: bx0..bx1 by by0..by1, at most 6 by 6 for an 18-tile reach.
  wf-bx0 : Integer -> Integer
  wf-bx0 (x) = max 0 (x - 18) / 8
  wf-span : Integer, Integer -> Integer
  wf-span (lo) (hi) = min hi (lo + 18) / 8 - max 0 (lo - 18) / 8 + 1
  wf-scan : WfState, WfViewer, Integer, Integer, Integer, List (List Integer) -> List (List Integer)
  wf-scan (s) (v) (x) (y) (sent) (packets) = let h = wf-span y 4095
    in let total = wf-span x 6143 * h
    in if v.cursor >= total then let done = __record-set v "cursor" -1 in packets
    else if sent == 32 then packets
    else let block = (wf-bx0 x + v.cursor / h) * 512 + wf-bx0 y + int-mod v.cursor h
    in let start = if v.row < 0 then let first = __record-set v "row" (wf-first s block) in v.row else v.row
    in if start >= wf-first s (block + 1) then
      let next = __record-set v "cursor" (v.cursor + 1) in let fresh = __record-set v "row" -1 in wf-scan s v x y sent packets
    else let advanced = __record-set v "row" (start + 1)
    in let emit = wf-code s start /= 3 & wf-near s start x y & not (wf-seen v start) & v.shown-count < wf-shown-limit
    in let refused = if wf-code s start /= 3 & wf-near s start x y & not (wf-seen v start) & v.shown-count >= wf-shown-limit then let counted = __record-set s "refused" (s.refused + 1) in 1 else 0
    in if not emit then wf-scan s v x y sent packets
    else let marked = wf-mark v start True
    in let listed = poke-32 v.shown (v.shown-count * 4) start
    in let counted = __record-set v "shown-count" (v.shown-count + 1)
    in wf-scan s v x y (sent + 1) (list-push packets (wf-packet s start))
  wf-view : WfState, Integer, Integer, Integer -> List (List Integer)
  wf-view (s) (connection) (x) (y) = let v = wf-viewer s connection
    in let moved = if x == v.view-x & y == v.view-y then 0 else
      let trimmed = wf-prune s v x y 0 0
      in let a = __record-set v "cursor" 0
      in let b = __record-set v "row" -1
      in let c = __record-set v "view-x" x
      in let d = __record-set v "view-y" y in 0
    in let drained = wf-drain s v x y 0 []
    in let reset = __record-set v "pending-count" 0
    in if x == v.view-x & y == v.view-y & v.cursor < 0 then drained
    else wf-scan s v x y (min 32 (list-length drained)) drained
  wf-unshow : WfViewer, Integer, Integer -> Integer
  wf-unshow (v) (at) (row) = if at >= v.shown-count then 0
    else if peek-32 v.shown (at * 4) == row then let moved = poke-32 v.shown (at * 4) (peek-32 v.shown ((v.shown-count - 1) * 4))
      in let count = __record-set v "shown-count" (v.shown-count - 1) in 1
    else wf-unshow v (at + 1) row
 A redrawn row reaches the viewer as a fresh 1A item with its new art, or as a removal when it is no longer drawn.
  wf-drain : WfState, WfViewer, Integer, Integer, Integer, List (List Integer) -> List (List Integer)
  wf-drain (s) (v) (x) (y) (i) (packets) = if i >= v.pending-count then packets
    else let row = peek-32 v.pending (i * 4)
    in if wf-code s row == 3 then
      (if not (wf-seen v row) then wf-drain s v x y (i + 1) packets
      else let cleared = wf-mark v row False
      in let gone = wf-unshow v 0 row
      in wf-drain s v x y (i + 1) (list-push packets (sip-remove (wf-serial-base + row + 1))))
    else if not (wf-near s row x y) then wf-drain s v x y (i + 1) packets
    else if not (wf-seen v row) & v.shown-count >= wf-shown-limit then wf-drain s v x y (i + 1) packets
    else let listed = if wf-seen v row then 0 else
      let marked = wf-mark v row True
      in let put = poke-32 v.shown (v.shown-count * 4) row
      in let counted = __record-set v "shown-count" (v.shown-count + 1) in 1
    in wf-drain s v x y (i + 1) (list-push packets (wf-packet s row))
  wf-touch : WfState, Integer, Integer -> Integer
  wf-touch (s) (row) (i) = if i == list-length s.viewers then 0
    else let v = list-at s.viewers i
    in let queued = if v.connection < 0 then 0
      else if v.pending-count >= wf-pending-limit then let dropped = __record-set v "connection" -1 in 0
      else let put = poke-32 v.pending (v.pending-count * 4) row
      in let counted = __record-set v "pending-count" (v.pending-count + 1) in 1
    in wf-touch s row (i + 1)
  wf-cell-lead : WfState, Integer, Integer, Integer, Integer -> Integer
  wf-cell-lead (s) (x) (y) (i) (last) = if i >= last then -1
    else if wf-x s i == x & wf-y s i == y & peek-byte s.rows (i * 12 + 9) == 0 then i
    else wf-cell-lead s x y (i + 1) last
  wf-cell-set : WfState, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  wf-cell-set (s) (x) (y) (code) (lead) (i) (last) = if i >= last then 0
    else if wf-x s i /= x | wf-y s i /= y then wf-cell-set s x y code lead (i + 1) last
    else let want = if code == 0 then 0 else if i == lead then code else 3
    in let changed = if wf-code s i == want then 0 else let set = poke-byte s.show i want in wf-touch s i 0
    in wf-cell-set s x y code lead (i + 1) last
  wf-set-cell : WfState, Integer, Integer, Integer -> Integer
  wf-set-cell (s) (x) (y) (code) = if x < 0 | x >= 6144 | y < 0 | y >= 4096 then 0
    else let block = (x / 8) * 512 + y / 8
    in let first = wf-first s block
    in let last = wf-first s (block + 1)
    in let lead = wf-cell-lead s x y first last
    in if lead < 0 then 0 else wf-cell-set s x y code lead first last
 Timber node stages (EconomyHarvest): 2 mature draws the tree, 1 growing a sapling, 0 felled and 3 failed a stump.
  wf-site-sync : WfState, Integer, Integer, Integer, Integer -> Integer
  wf-site-sync (s) (k) (x) (y) (stage) = if k < 0 | k >= wf-site-limit | peek-byte s.sites k == stage then 0
    else let cached = poke-byte s.sites k stage
    in wf-set-cell s x y (if stage == 2 then 0 else if stage == 1 then 2 else 1)
 The installed item table is TILEDATA's 512 groups of a 4-byte header and 32 entries of 37 bytes: flags at byte 0,
 height at byte 16. The map cache keeps a static as a collider when its flags hold 0x40 or 0x200 (576).
  wf-tile-at : Integer -> Integer
  wf-tile-at (art) = (art / 32) * 1188 + 4 + int-mod art 32 * 37
  wf-solid-find : WalkMap, Integer, Integer, Integer, Integer, Integer -> Integer
  wf-solid-find (map) (cell) (z) (height) (flags) (i) = if i >= peek-qword map.solids (cell * map.stride) then -1
    else let at = cell * map.stride + 8 + i * 24
    in if peek-qword map.solids at == z & peek-qword map.solids (at + 8) == height & peek-qword map.solids (at + 16) == flags then i
    else wf-solid-find map cell z height flags (i + 1)
  wf-solid-drop : WalkMap, Integer, Integer -> Integer
  wf-solid-drop (map) (cell) (i) = let count = peek-qword map.solids (cell * map.stride)
    in let last = cell * map.stride + 8 + (count - 1) * 24
    in let at = cell * map.stride + 8 + i * 24
    in let a = poke-qword map.solids at (peek-qword map.solids last)
    in let b = poke-qword map.solids (at + 8) (peek-qword map.solids (last + 8))
    in let c = poke-qword map.solids (at + 16) (peek-qword map.solids (last + 16))
    in poke-qword map.solids (cell * map.stride) (count - 1)
 A felled cell walks clear: its flora colliders leave the map; a mature one gets them back.
  wf-ground-rows : WfState, Integer, WalkMap, Integer, Integer, Integer, Boolean, Integer, Integer -> Integer
  wf-ground-rows (s) (tiles) (map) (x) (y) (cell) (present) (i) (last) = if i >= last then 0
    else if wf-x s i /= x | wf-y s i /= y then wf-ground-rows s tiles map x y cell present (i + 1) last
    else let at = wf-tile-at (wf-art s i)
    in let flags = mul-u32 tiles at
    in let height = peek-byte tiles (at + 16)
    in let found = if bit-and flags 576 == 0 then -2 else wf-solid-find map cell (wf-z s i) height flags 0
    in let changed = if found == -2 then 0
      else if present & found < 0 then (when walk-add-solid map x y (wf-z s i) height flags is Err (_) -> 0 is Ok (_) -> 1)
      else if not present & found >= 0 then let dropped = wf-solid-drop map cell found in 1
      else 0
    in wf-ground-rows s tiles map x y cell present (i + 1) last
  wf-ground : WfState, Integer, WalkMap, Integer, Integer, Boolean -> Integer
  wf-ground (s) (tiles) (map) (x) (y) (present) = let cell = walk-cell map x y
    in if tiles == 0 | cell < 0 | x < 0 | x >= 6144 | y < 0 | y >= 4096 then 0
    else let block = (x / 8) * 512 + y / 8
    in wf-ground-rows s tiles map x y cell present (wf-first s block) (wf-first s (block + 1))
 A harvest target (6C) aimed at a flora item becomes the static target the client would have sent for that tree.
  wf-target-packet : WfState, List Integer -> List Integer
  wf-target-packet (s) (packet) = if list-length packet /= 19 | list-at packet 0 /= #6C then packet
    else let i = bit-and (gp-u32 packet 7) #7FFFFFFF - wf-serial-base - 1
    in if i < 0 | i >= s.count then packet
    else let head = [list-at packet 0, list-at packet 1, list-at packet 2, list-at packet 3, list-at packet 4, list-at packet 5, list-at packet 6]
    in let placed = gp-put16 (gp-put16 (gp-put32 head 0) (wf-x s i)) (wf-y s i)
    in gp-put16 (list-push (list-push placed (list-at packet 15)) (bit-and (wf-z s i) 255)) (wf-art s i)
  wf-handler : WfState, WorldTable, List Integer -> Result (Maybe GameReply) Text
  wf-handler (s) (world) (packet) = if list-length packet < 5 then Ok None
    else let op = list-at packet 0
    in if op /= 6 & op /= 7 & op /= 9 then Ok None
    else let serial = bit-and (gp-u32 packet 1) #7FFFFFFF
    in let i = serial - wf-serial-base - 1
    in if i < 0 | i >= s.count then Ok None
    else if world-slot world serial >= 0 then Err "flora serial namespace collision"
    else if op == 7 then Ok (Just (gs-reply [sip-bounce 0] "flora:immovable"))
    else Ok (Just (gs-reply [] "flora:click"))
