Chapter: TitleRegistryCodec
  cites Uoaix chapter TitleRegistry
  cites Uoaix chapter WorldSnapshot
  cites Foreword chapter Result

  TitleCheckpoint = record { registry : TrRegistry, tick : Integer, sequence : Integer }
  trc-titles-at : Integer = 96
  trc-history-at : Integer = trc-titles-at + 128 * 128
  trc-bytes : Integer = trc-history-at + 4096 * 112

  trc-write-title : Integer, Integer, TrTitle -> Integer
  trc-write-title (buf) (at) (r) =
    let a0 = poke-qword buf (at + 0) r.serial
    in let a1 = poke-qword buf (at + 8) r.registrar
    in let a2 = poke-qword buf (at + 16) r.owner-kind
    in let a3 = poke-qword buf (at + 24) r.owner-id
    in let a4 = poke-qword buf (at + 32) r.mark-kind
    in let a5 = poke-qword buf (at + 40) r.mark-id
    in let a6 = poke-qword buf (at + 48) r.mark-revision
    in let a7 = poke-qword buf (at + 56) r.revision
    in let a8 = poke-qword buf (at + 64) r.pending-remark
    in let a9 = poke-qword buf (at + 72) r.offer-kind
    in let a10 = poke-qword buf (at + 80) r.offer-id
    in let a11 = poke-qword buf (at + 88) r.offer-nonce
    in let a12 = poke-qword buf (at + 96) r.offer-revision
    in let a13 = poke-qword buf (at + 104) r.status
    in let a14 = poke-qword buf (at + 112) r.last-cause
    in let a15 = poke-qword buf (at + 120) r.parent
    in 0

  trc-title-matches : Integer, Integer, TrTitle -> Boolean
  trc-title-matches (buf) (at) (r) =
    peek-qword buf (at + 0) == r.serial
    & peek-qword buf (at + 8) == r.registrar
    & peek-qword buf (at + 16) == r.owner-kind
    & peek-qword buf (at + 24) == r.owner-id
    & peek-qword buf (at + 32) == r.mark-kind
    & peek-qword buf (at + 40) == r.mark-id
    & peek-qword buf (at + 48) == r.mark-revision
    & peek-qword buf (at + 56) == r.revision
    & peek-qword buf (at + 64) == r.pending-remark
    & peek-qword buf (at + 72) == r.offer-kind
    & peek-qword buf (at + 80) == r.offer-id
    & peek-qword buf (at + 88) == r.offer-nonce
    & peek-qword buf (at + 96) == r.offer-revision
    & peek-qword buf (at + 104) == r.status
    & peek-qword buf (at + 112) == r.last-cause
    & peek-qword buf (at + 120) == r.parent

  trc-write-event : Integer, Integer, TrEvent -> Integer
  trc-write-event (buf) (at) (r) =
    let a0 = poke-qword buf (at + 0) r.sequence
    in let a1 = poke-qword buf (at + 8) r.hour
    in let a2 = poke-qword buf (at + 16) r.serial
    in let a3 = poke-qword buf (at + 24) r.kind
    in let a4 = poke-qword buf (at + 32) r.registrar
    in let a5 = poke-qword buf (at + 40) r.from-kind
    in let a6 = poke-qword buf (at + 48) r.from-id
    in let a7 = poke-qword buf (at + 56) r.to-kind
    in let a8 = poke-qword buf (at + 64) r.to-id
    in let a9 = poke-qword buf (at + 72) r.mark-kind
    in let a10 = poke-qword buf (at + 80) r.mark-id
    in let a11 = poke-qword buf (at + 88) r.mark-revision
    in let a12 = poke-qword buf (at + 96) r.revision
    in let a13 = poke-qword buf (at + 104) r.reference
    in 0

  trc-event-matches : Integer, Integer, TrEvent -> Boolean
  trc-event-matches (buf) (at) (r) =
    peek-qword buf (at + 0) == r.sequence
    & peek-qword buf (at + 8) == r.hour
    & peek-qword buf (at + 16) == r.serial
    & peek-qword buf (at + 24) == r.kind
    & peek-qword buf (at + 32) == r.registrar
    & peek-qword buf (at + 40) == r.from-kind
    & peek-qword buf (at + 48) == r.from-id
    & peek-qword buf (at + 56) == r.to-kind
    & peek-qword buf (at + 64) == r.to-id
    & peek-qword buf (at + 72) == r.mark-kind
    & peek-qword buf (at + 80) == r.mark-id
    & peek-qword buf (at + 88) == r.mark-revision
    & peek-qword buf (at + 96) == r.revision
    & peek-qword buf (at + 104) == r.reference

  trc-read-event : Integer, Integer -> TrEvent
  trc-read-event (buf) (at) = TrEvent {
    sequence = peek-qword buf (at + 0),
    hour = peek-qword buf (at + 8),
    serial = peek-qword buf (at + 16),
    kind = peek-qword buf (at + 24),
    registrar = peek-qword buf (at + 32),
    from-kind = peek-qword buf (at + 40),
    from-id = peek-qword buf (at + 48),
    to-kind = peek-qword buf (at + 56),
    to-id = peek-qword buf (at + 64),
    mark-kind = peek-qword buf (at + 72),
    mark-id = peek-qword buf (at + 80),
    mark-revision = peek-qword buf (at + 88),
    revision = peek-qword buf (at + 96),
    reference = peek-qword buf (at + 104) }

  trc-write-titles : Integer, TrRegistry, Integer -> Integer
  trc-write-titles (buf) (r) (i) = if i == 128 then 0
    else let a = trc-write-title buf (trc-titles-at + i * 128) (list-at r.titles i)
    in trc-write-titles buf r (i + 1)
  trc-write-history : Integer, TrRegistry, Integer -> Integer
  trc-write-history (buf) (r) (i) = if i == 4096 then 0
    else let a = trc-write-event buf (trc-history-at + i * 112) (list-at r.history i)
    in trc-write-history buf r (i + 1)
  trc-zero : Integer, Integer, Integer -> Boolean
  trc-zero (buf) (at) (stop) = if at == stop then True
    else if peek-qword buf at /= 0 then False else trc-zero buf (at + 8) stop
  trc-command : TrEvent -> TrCommand
  trc-command (e) =
    let origin = TrParty { kind = e.from-kind, id = e.from-id }
    in let target = TrParty { kind = e.to-kind, id = e.to-id }
    in let actor = if e.kind == 1 | e.kind == 4 | e.kind == 5 | e.kind == 7 then target else origin
    in let owner = if e.kind == 1 | e.kind == 5 | e.kind == 7 | e.kind == 8 then target else origin
    in let mark = TrParty { kind = e.mark-kind, id = e.mark-id }
    in let evidence = TrEvidence { serial = e.serial, present = True, marked = True,
      owner = owner, mark = mark, mark-revision = e.mark-revision }
    in TrCommand { kind = e.kind, verified = True, registrar = e.registrar,
      actor = actor, recipient = target, evidence = evidence,
      nonce = e.reference, event = e.reference, parent = e.reference, hour = e.hour }
  trc-rebuild : Integer, Integer, TrRegistry, Integer -> Boolean
  trc-rebuild (buf) (count) (r) (i) = if i == count then True
    else let mark = __heap-save
    in let at = trc-history-at + i * 112
    in let event = trc-read-event buf at
    in let command = trc-command event
    in let result = tr-execute r command
    in let valid = result >= 0 & r.count == i + 1 & trc-event-matches buf at (list-at r.history i)
    in let restored = __heap-restore mark
    in if not valid then False else trc-rebuild buf count r (i + 1)
  trc-titles-match : Integer, TrRegistry, Integer -> Boolean
  trc-titles-match (buf) (r) (i) = if i == 128 then True
    else trc-title-matches buf (trc-titles-at + i * 128) (list-at r.titles i) & trc-titles-match buf r (i + 1)
  trc-decode : Integer, Integer -> Result TitleCheckpoint Text
  trc-decode (buf) (size) =
    if size /= trc-bytes then Err "title checkpoint length invalid"
    else if peek-qword buf 0 /= #31435254 | peek-qword buf 8 /= 1 | peek-qword buf 16 /= size | peek-qword buf 56 /= 0 then Err "title checkpoint format invalid"
    else if peek-qword buf 24 < 0 | peek-qword buf 24 > 1024 | peek-qword buf 32 < 0 | peek-qword buf 32 > tr-limit | peek-qword buf 40 < 0 | peek-qword buf 40 > tr-limit then Err "title checkpoint metadata invalid"
    else if peek-qword buf 64 < 0 | peek-qword buf 64 > 128 | peek-qword buf 72 < 0 | peek-qword buf 72 > 4096 | peek-qword buf 80 /= peek-qword buf 72 | peek-qword buf 88 < 0 | peek-qword buf 88 > tr-limit then Err "title checkpoint counters invalid"
    else if peek-qword buf 48 /= ws-hash buf size 0 2166136261 then Err "title checkpoint checksum invalid"
    else if not (trc-zero buf (trc-history-at + peek-qword buf 72 * 112) trc-bytes) then Err "title checkpoint spare history nonzero"
    else when tr-new (peek-qword buf 24)
      is Err (e) -> Err e
      is Ok (r) ->
        if not (trc-rebuild buf (peek-qword buf 72) r 0) then Err "title checkpoint history invalid"
        else if r.used /= peek-qword buf 64 | r.count /= peek-qword buf 72 | r.sequence /= peek-qword buf 80 | r.hour /= peek-qword buf 88 | not (trc-titles-match buf r 0) then Err "title checkpoint body disagrees with history"
        else Ok (TitleCheckpoint { registry = r, tick = peek-qword buf 32, sequence = peek-qword buf 40 })
  trc-encode : TrRegistry, Integer, Integer, Integer, Integer -> Result Integer Text
  trc-encode (r) (tick) (sequence) (buf) (capacity) =
    if r.busy /= 0 then Err "title checkpoint cannot capture prepared transaction"
    else if capacity < trc-bytes | tick < 0 | tick > tr-limit | sequence < 0 | sequence > tr-limit then Err "title checkpoint destination or metadata invalid"
    else if r.towns < 0 | r.towns > 1024 | r.used < 0 | r.used > 128 | r.count < 0 | r.count > 4096 | r.sequence /= r.count | r.hour < 0 | r.hour > tr-limit | list-length r.titles /= 128 | list-length r.history /= 4096 then Err "title registry dimensions invalid"
    else let a = poke-qword buf 0 #31435254
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 trc-bytes
    in let d = poke-qword buf 24 r.towns
    in let e = poke-qword buf 32 tick
    in let f = poke-qword buf 40 sequence
    in let g = poke-qword buf 48 0
    in let h = poke-qword buf 56 0
    in let j = poke-qword buf 64 r.used
    in let k = poke-qword buf 72 r.count
    in let m = poke-qword buf 80 r.sequence
    in let n = poke-qword buf 88 r.hour
    in let titles = trc-write-titles buf r 0
    in let history = trc-write-history buf r 0
    in let hash = poke-qword buf 48 (ws-hash buf trc-bytes 0 2166136261)
    in let mark = __heap-save
    in let valid = is-ok (trc-decode buf trc-bytes)
    in let restored = __heap-restore mark
    in if valid then Ok trc-bytes else Err "title registry state disagrees with history"
  trc-decode-record : Integer, Integer, Integer, Integer -> Result TitleCheckpoint Text
  trc-decode-record (buf) (size) (tick) (sequence) =
    if size /= trc-bytes then Err "title record length invalid"
    else if peek-qword buf 32 /= tick | peek-qword buf 40 /= sequence then Err "title record metadata mismatch"
    else trc-decode buf size
