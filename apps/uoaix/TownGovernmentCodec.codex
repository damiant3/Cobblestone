    in tgc-write-sites buf s (i + 1)

  tgc-read-sites : Integer, GovernmentCheckpoint, Integer -> Integer
  tgc-read-sites (buf) (s) (i) = if i == 64 then 0
    else let a = tgf-read-site buf (tgc-sites-at + i * 16) (list-at s.works.sites i)
    in tgc-read-sites buf s (i + 1)

