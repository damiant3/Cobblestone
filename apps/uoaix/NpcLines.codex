Chapter: NpcLines

  NlLine = record { kind : Integer, town : Text, role : Text, topic : Integer, opinion : Integer, mood : Integer, text : Text }
  NlLibrary = record { lines : List NlLine, hits : Integer, misses : Integer }

 Kinds follow NsRow: 1 shopkeeper, 2 banker, 3 townsfolk.
 Topics: 0 greeting, 1 trade, 2 work, 3 news, 4 chat.
 Opinion: -1 sour, 0 even, 1 glad. Mood: 0 glum, 1 even, 2 cheerful, 3 alarmed.
 Nine in a row field is a wildcard; in a key it means unknown.

  nl-any : Integer = 9
  nl : Integer, Text, Text, Integer, Integer, Integer, Text -> NlLine
  nl (kind) (town) (role) (topic) (opinion) (mood) (text) = NlLine { kind = kind, town = town, role = role,
    topic = topic, opinion = opinion, mood = mood, text = text }

  nl-folk-greet : Integer -> List NlLine
  nl-folk-greet (unused) = [nl 3 "" "" 0 9 9 "Good day to you, traveller.",
    nl 3 "" "" 0 9 2 "A fine day, is it not? Welcome, friend.",
    nl 3 "" "" 0 9 0 "Day to you. Forgive me, I am out of sorts.",
    nl 3 "" "" 0 9 3 "Keep your wits about you, stranger. Something is not right today.",
    nl 3 "Britain" "" 0 9 9 "Welcome to Britain. Lord British keeps a fair city.",
    nl 3 "Britain" "" 0 9 2 "Britain shines today, and so do I. Good day!",
    nl 3 "Trinsic" "" 0 9 9 "Well met. Trinsic greets the honourable.",
    nl 3 "Trinsic" "" 0 9 3 "Stand tall, stranger. The Paladins are watching the gates.",
    nl 3 "Vesper" "" 0 9 9 "Ho there. Mind the canals, they take the careless.",
    nl 3 "Vesper" "" 0 9 0 "Another grey Vesper morning. What do you want?",
    nl 3 "" "farmer" 0 9 9 "The fields wake early, and so do I. Good day.",
    nl 3 "" "baker" 0 9 9 "Good day. The ovens are warm if you are cold.",
    nl 3 "" "smith" 0 9 9 "Mind the sparks, friend. What brings you near the forge?",
    nl 3 "" "merchant" 0 9 9 "Greetings. Good cloth and a fair word, that is my trade."]

  nl-folk-trade : Integer -> List NlLine
  nl-folk-trade (unused) = [nl 3 "" "" 1 9 9 "Prices go up and prices go down. I just try to keep fed.",
    nl 3 "" "" 1 1 9 "Trade has been kind lately. Coin moves, and it moves my way.",
    nl 3 "" "" 1 -1 9 "Trade is a thief this season. Nothing sells for what it should.",
    nl 3 "" "farmer" 1 -1 9 "Grain fetches less than the sweat it costs. Ask the bakers why.",
    nl 3 "" "farmer" 1 1 9 "Grain is selling well. The bakers cannot get enough.",
    nl 3 "" "baker" 1 1 9 "Bread sells before it cools. A good season for the ovens.",
    nl 3 "" "baker" 1 -1 9 "Flour costs dear and bread sells cheap. A baker cannot live on crusts.",
    nl 3 "" "smith" 1 1 9 "Ingots are cheap and blades sell well. I will not complain.",
    nl 3 "" "smith" 1 -1 9 "Ingots cost too much. The miners grow fat while my forge goes cold.",
    nl 3 "" "merchant" 1 1 9 "The stalls are busy. Everyone wants something new to wear.",
    nl 3 "" "merchant" 1 -1 9 "Many sellers and hardly a buyer. The market is a hard place this week.",
    nl 3 "Britain" "" 1 9 9 "Britain's market has everything, if your purse is deep enough.",
    nl 3 "Trinsic" "" 1 9 9 "In Trinsic a fair price is a matter of honour.",
    nl 3 "Vesper" "" 1 9 9 "Vesper ore pays for Vesper ale. That is the whole economy."]

  nl-folk-work : Integer -> List NlLine
  nl-folk-work (unused) = [nl 3 "" "" 2 9 9 "Work is work. It keeps the roof up.",
    nl 3 "" "" 2 1 9 "I like my work. A good day's labour is its own reward.",
    nl 3 "" "" 2 -1 9 "Too much work and too little to show for it.",
    nl 3 "" "" 2 9 0 "I am tired to the bone. Ask me again tomorrow.",
    nl 3 "" "farmer" 2 9 9 "Up before dawn, in the rows till dusk. The crop does not wait.",
    nl 3 "" "baker" 2 9 9 "Knead, prove, bake, sell. Then do it all again before sunrise.",
    nl 3 "" "smith" 2 9 9 "Heat, hammer, quench. The iron tells you when it is right.",
    nl 3 "" "merchant" 2 9 9 "A stitch here, a sale there. A stall keeps itself if you keep at it.",
    nl 3 "" "smith" 2 -1 9 "The forge eats coal faster than I can pay for it.",
    nl 3 "" "baker" 2 1 9 "The ovens have never been busier, and I would not have it otherwise."]

  nl-folk-talk : Integer -> List NlLine
  nl-folk-talk (unused) = [nl 3 "" "" 3 9 9 "Not much news. The guards keep the peace well enough.",
    nl 3 "" "" 3 9 3 "Have you not heard? There is trouble about. Stay near the guards.",
    nl 3 "" "" 3 9 2 "Good news all round, from what I hear. The town is in fine spirits.",
    nl 3 "Britain" "" 3 9 9 "They say Lord British may hold a feast at the castle this season.",
    nl 3 "Britain" "" 3 9 3 "The guards doubled the watch by the bank. Something has them nervous.",
    nl 3 "Trinsic" "" 3 9 9 "The Paladins drill every morning. Trinsic sleeps soundly for it.",
    nl 3 "Vesper" "" 3 9 9 "A barge ran aground on the canal again. The bridgemen are furious.",
    nl 3 "" "" 4 9 9 "I would love to chat, but there is much to do.",
    nl 3 "" "" 4 9 2 "Ha! You have a way with words. I like you.",
    nl 3 "" "" 4 9 0 "Leave me be for now. It has not been a good day.",
    nl 3 "" "" 4 9 3 "Not now. Keep your voice down and your eyes open.",
    nl 3 "Britain" "" 4 9 9 "Have you seen the castle by night? The lanterns are a fine sight.",
    nl 3 "Trinsic" "" 4 9 9 "Honour first, friend. The rest follows.",
    nl 3 "Vesper" "" 4 9 9 "In Vesper we say: a full tankard and a dry boot.",
    nl 3 "" "farmer" 4 9 9 "Rain tomorrow, I think. My knees never lie.",
    nl 3 "" "baker" 4 9 9 "Have you tried the honey bread? My own recipe.",
    nl 3 "" "smith" 4 9 9 "A good blade needs a good arm. Do you have one?",
    nl 3 "" "merchant" 4 9 9 "That colour suits you. Have you thought of a new cloak?"]

  nl-shop : Integer -> List NlLine
  nl-shop (unused) = [nl 1 "" "" 0 9 9 "Welcome. Say vendor buy or vendor sell, and I shall show you my prices.",
    nl 1 "Britain" "" 0 9 9 "Welcome to my shop, the finest in Britain. Say vendor buy or vendor sell.",
    nl 1 "Trinsic" "" 0 9 9 "An honest trade in Trinsic. Say vendor buy or vendor sell.",
    nl 1 "Vesper" "" 0 9 9 "Ho, customer! Say vendor buy or vendor sell.",
    nl 1 "" "provisioner" 0 9 9 "Supplies for the road! Say vendor buy or vendor sell.",
    nl 1 "" "blacksmith" 0 9 9 "Steel and good iron here. Say vendor buy or vendor sell.",
    nl 1 "" "tailor" 0 9 9 "Fine cloth for fine folk. Say vendor buy or vendor sell.",
    nl 1 "" "baker" 0 9 9 "Fresh from the oven. Say vendor buy or vendor sell.",
    nl 1 "" "healer" 0 9 9 "Bandages and remedies. Say vendor buy or vendor sell.",
    nl 1 "" "innkeeper" 0 9 9 "Food, drink and a warm bed. Say vendor buy or vendor sell.",
    nl 1 "" "tinker" 0 9 9 "Tools and clever things. Say vendor buy or vendor sell.",
    nl 1 "" "carpenter" 0 9 9 "Good timber, honest joints. Say vendor buy or vendor sell.",
    nl 1 "" "" 1 9 9 "My prices are fair. Say vendor buy to see my wares.",
    nl 1 "Britain" "" 1 9 9 "Britain's prices, Britain's quality. Say vendor buy to see them.",
    nl 1 "" "blacksmith" 1 9 9 "A blade, a hammer, a pick? Say vendor buy and we shall see.",
    nl 1 "" "healer" 1 9 9 "Healing is not cheap, but it is cheaper than a grave. Say vendor buy.",
    nl 1 "" "provisioner" 1 9 9 "Rope, lanterns, food for the road. Say vendor buy.",
    nl 1 "" "" 2 9 9 "Business keeps me on my feet from dawn to dusk.",
    nl 1 "" "blacksmith" 2 9 9 "The forge never cools in this shop.",
    nl 1 "" "tailor" 2 9 9 "Every stitch by my own hand, I assure you.",
    nl 1 "" "baker" 2 9 9 "Up before the sun, every day, for the bread.",
    nl 1 "" "healer" 2 9 9 "Too many wounds this week. Adventurers never learn.",
    nl 1 "" "" 3 9 9 "Customers bring news. Most of it is gossip.",
    nl 1 "Britain" "" 3 9 9 "They say the castle has ordered new banners. Good for the tailors.",
    nl 1 "" "" 4 9 9 "If you are not buying, friend, I have work to do.",
    nl 1 "" "innkeeper" 4 9 9 "Sit, rest. A traveller with tales is always welcome here.",
    nl 1 "" "tinker" 4 9 9 "Ever seen a clock that runs backwards? I am working on one."]

  nl-bank : Integer -> List NlLine
  nl-bank (unused) = [nl 2 "" "" 0 9 9 "Welcome to the bank. Step close and say bank for your chest.",
    nl 2 "Britain" "" 0 9 9 "The Bank of Britain keeps your gold safe. Step close and say bank.",
    nl 2 "" "" 1 9 9 "Gold is safest in the bank. Step close and say bank for your chest.",
    nl 2 "" "" 2 9 9 "Counting coin all day. It is honest work.",
    nl 2 "" "" 3 9 9 "The vaults are quiet and the gold is safe. That is the only news I need.",
    nl 2 "" "" 4 9 9 "Is there something you need from your chest? Step close and say bank."]

  nl-library : Integer -> NlLibrary
  nl-library (unused) = let folk = nl-folk-greet 0 & nl-folk-trade 0 & nl-folk-work 0 & nl-folk-talk 0
    in NlLibrary { lines = folk & nl-shop 0 & nl-bank 0, hits = 0, misses = 0 }

 Thresholds: opinion axes and alarm are network outputs on a 1000 scale; a
 quarter of the scale either side of zero reads as a held opinion, and an alarm
 of 600 outweighs any mood. Mood is TfPerson's 0..100 in thirds.

  nl-opinion : Integer -> Integer
  nl-opinion (value) = if value >= 250 then 1 else if value <= -250 then -1 else 0
  nl-mood : Integer, Integer -> Integer
  nl-mood (mood) (alarm) = if alarm >= 600 then 3 else if mood < 35 then 0 else if mood < 65 then 1 else 2
  nl-job-role : Integer -> Text
  nl-job-role (job) = if job == 1 then "farmer" else if job == 2 then "baker" else if job == 3 then "smith" else if job == 4 then "merchant" else ""

  nl-field : Integer, Integer -> Integer
  nl-field (row) (key) = if row == nl-any then 0 else if row == key then 1 else -1
  nl-text-field : Text, Text -> Integer
  nl-text-field (row) (key) = if text-length row == 0 then 0 else if row == key then 1 else -1
  nl-score : NlLine, Integer, Text, Text, Integer, Integer, Integer -> Integer
  nl-score (r) (kind) (town) (role) (topic) (opinion) (mood) =
    if r.kind /= kind | r.topic /= topic then -1
    else let a = nl-text-field r.town town
    in let b = nl-text-field r.role role
    in let c = nl-field r.opinion opinion
    in let d = nl-field r.mood mood
    in if a < 0 | b < 0 | c < 0 | d < 0 then -1 else a + b + c + d
  nl-best : List NlLine, Integer, Text, Text, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  nl-best (xs) (kind) (town) (role) (topic) (opinion) (mood) (i) (best) (ties) =
    if i == list-length xs then best * 1000 + ties
    else let s = nl-score (list-at xs i) kind town role topic opinion mood
    in if s > best then nl-best xs kind town role topic opinion mood (i + 1) s 1
    else if s == best & s >= 0 then nl-best xs kind town role topic opinion mood (i + 1) best (ties + 1)
    else nl-best xs kind town role topic opinion mood (i + 1) best ties
  nl-nth : List NlLine, Integer, Text, Text, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  nl-nth (xs) (kind) (town) (role) (topic) (opinion) (mood) (score) (k) (i) =
    if i == list-length xs then ""
    else let r = list-at xs i
    in if nl-score r kind town role topic opinion mood /= score then nl-nth xs kind town role topic opinion mood score k (i + 1)
    else if k == 0 then r.text
    else nl-nth xs kind town role topic opinion mood score (k - 1) (i + 1)
  nl-pick : NlLibrary, Integer, Text, Text, Integer, Integer, Integer, Integer -> Text
  nl-pick (lib) (kind) (town) (role) (topic) (opinion) (mood) (variety) =
    let found = nl-best lib.lines kind town role topic opinion mood 0 -1 0
    in let score = found / 1000
    in let ties = int-mod found 1000
    in let hit = score >= 0 & ties > 0
    in let counted = if hit then __record-set lib "hits" (lib.hits + 1) else __record-set lib "misses" (lib.misses + 1)
    in let spread = if variety < 0 then 0 - variety else variety
    in if hit then nl-nth lib.lines kind town role topic opinion mood score (int-mod spread ties) 0 else ""

  nl-row-valid : NlLine -> Boolean
  nl-row-valid (r) = r.kind >= 1 & r.kind <= 3 & r.topic >= 0 & r.topic <= 4
    & (r.opinion == nl-any | (r.opinion >= -1 & r.opinion <= 1))
    & (r.mood == nl-any | (r.mood >= 0 & r.mood <= 3))
    & text-length r.text > 0 & text-length r.text <= 200
    & (r.kind /= 1 | r.topic /= 0 | (text-contains r.text "vendor buy" & text-contains r.text "vendor sell"))
    & (r.kind /= 2 | r.topic /= 0 | text-contains r.text "say bank")
    & ((r.kind /= 1 & r.kind /= 2) | (r.opinion == nl-any & r.mood == nl-any))
  nl-rows-valid : List NlLine, Integer -> Boolean
  nl-rows-valid (xs) (i) = if i == list-length xs then True
    else if not (nl-row-valid (list-at xs i)) then False
    else nl-rows-valid xs (i + 1)
  nl-covered : List NlLine, Integer, Integer, Integer -> Boolean
  nl-covered (xs) (kind) (topic) (i) = if i == list-length xs then False
    else let r = list-at xs i
    in if r.kind == kind & r.topic == topic & text-length r.town == 0 & text-length r.role == 0
      & r.opinion == nl-any & r.mood == nl-any then True
    else nl-covered xs kind topic (i + 1)
  nl-coverage : List NlLine, Integer -> Boolean
  nl-coverage (xs) (cell) = if cell == 15 then True
    else if not (nl-covered xs (cell / 5 + 1) (int-mod cell 5) 0) then False
    else nl-coverage xs (cell + 1)
  nl-valid : NlLibrary -> Boolean
  nl-valid (lib) = nl-rows-valid lib.lines 0 & nl-coverage lib.lines 0
