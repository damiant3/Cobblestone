  tgf-write-civic : Integer, Integer, TgEvent -> Integer
  tgf-write-civic (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.sequence
    in let f1 = poke-qword buf (at + 8) p.hour
    in let f2 = poke-qword buf (at + 16) p.kind
    in let f3 = poke-qword buf (at + 24) p.town
    in let f4 = poke-qword buf (at + 32) p.actor
    in let f5 = poke-qword buf (at + 40) p.subject
    in let f6 = poke-qword buf (at + 48) p.amount
    in let f7 = poke-qword buf (at + 56) p.money-action
    in 0
  tgf-read-civic : Integer, Integer, TgEvent -> Integer
  tgf-read-civic (buf) (at) (p) =
    let f0 = __record-set p "sequence" (peek-qword buf (at + 0))
    in let f1 = __record-set p "hour" (peek-qword buf (at + 8))
    in let f2 = __record-set p "kind" (peek-qword buf (at + 16))
    in let f3 = __record-set p "town" (peek-qword buf (at + 24))
    in let f4 = __record-set p "actor" (peek-qword buf (at + 32))
    in let f5 = __record-set p "subject" (peek-qword buf (at + 40))
    in let f6 = __record-set p "amount" (peek-qword buf (at + 48))
    in let f7 = __record-set p "money-action" (peek-qword buf (at + 56))
    in 0
  tgf-zero-civic : TgEvent -> Boolean
  tgf-zero-civic (p) =
    p.sequence == 0
    & p.hour == 0
    & p.kind == 0
    & p.town == 0
    & p.actor == 0
    & p.subject == 0
    & p.amount == 0
    & p.money-action == 0

