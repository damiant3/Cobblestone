Chapter: TownGovernmentFields
  cites Uoaix chapter TownGovernment
  cites Uoaix chapter TownWorks
  cites Uoaix chapter TownDisputes

  tgf-write-office : Integer, Integer, TgOffice -> Integer
  tgf-write-office (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.town
    in let f1 = poke-qword buf (at + 8) p.purse
    in let f2 = poke-qword buf (at + 16) p.mayor
    in let f3 = poke-qword buf (at + 24) p.dues
    in let f4 = poke-qword buf (at + 32) p.collected
    in let f5 = poke-qword buf (at + 40) p.paid
    in let f6 = poke-qword buf (at + 48) p.unpaid
    in let f7 = poke-qword buf (at + 56) p.request
    in let f8 = poke-qword buf (at + 64) p.request-kind
    in 0
  tgf-read-office : Integer, Integer, TgOffice -> Integer
  tgf-read-office (buf) (at) (p) =
    let f0 = __record-set p "town" (peek-qword buf (at + 0))
    in let f1 = __record-set p "purse" (peek-qword buf (at + 8))
    in let f2 = __record-set p "mayor" (peek-qword buf (at + 16))
    in let f3 = __record-set p "dues" (peek-qword buf (at + 24))
    in let f4 = __record-set p "collected" (peek-qword buf (at + 32))
    in let f5 = __record-set p "paid" (peek-qword buf (at + 40))
    in let f6 = __record-set p "unpaid" (peek-qword buf (at + 48))
    in let f7 = __record-set p "request" (peek-qword buf (at + 56))
    in let f8 = __record-set p "request-kind" (peek-qword buf (at + 64))
    in 0
  tgf-zero-office : TgOffice -> Boolean
  tgf-zero-office (p) =
    p.town == 0
    & p.purse == 0
    & p.mayor == 0
    & p.dues == 0
    & p.collected == 0
    & p.paid == 0
    & p.unpaid == 0
    & p.request == 0
    & p.request-kind == 0

