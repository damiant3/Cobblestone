Chapter: WorldSpawnTypes

  WsRect = record { x1 : Integer, y1 : Integer, x2 : Integer, y2 : Integer }
  WsProfile = record { key : Text, name : Text, body : Integer, hue : Integer, hue-high : Integer, water : Boolean,
    strength-low : Integer, strength-high : Integer, dex-low : Integer, dex-high : Integer,
    hits-low : Integer, hits-high : Integer, damage-low : Integer, damage-high : Integer,
    skill-low : Integer, skill-high : Integer, tactics-low : Integer, tactics-high : Integer,
    ai : Integer, taming : Integer }
  WsChoice = record { key : Text, profile : Integer, group : Integer, weight : Integer }
  WsGroup = record { key : Text, choices : List WsChoice }
  WsRegion = record { id : Integer, name : Text, area : WsRect,
    maximum : Integer, batch : Integer, minimum-minutes : Integer, maximum-minutes : Integer,
    group : Integer, preferred-height : Integer, fixed-height : Integer,
    outside : Boolean, exclusions : List WsRect }
  WsCatalog = record { revision : Integer, profiles : List WsProfile, groups : List WsGroup, regions : List WsRegion }

