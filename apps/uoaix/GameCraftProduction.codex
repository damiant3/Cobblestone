Chapter: GameCraftProduction
  cites Uoaix chapter GameCraftState

  CraftTake = record { serial : Integer, item : Integer, quantity : Integer,
    quality : Integer, wear : Integer, basis : Integer, whole : Boolean }
  gcr-select : GameHarvest, GvPlayer, Integer, Integer, Integer, List CraftTake -> Result (List CraftTake) Text
  gcr-select (h) (player) (item) (need) (unused) (takes) = gcr-select-from h player item need (ep-lot-first h.vendor.currency.world.goods player.actor) takes
  gcr-select-from : GameHarvest, GvPlayer, Integer, Integer, Integer, List CraftTake -> Result (List CraftTake) Text
  gcr-select-from (h) (player) (item) (need) (serial) (takes) =
    if item == 0 | need == 0 then Ok takes
    else if serial == 0 then
      (let have = gcr-held takes item 0
      in Err ("You need " & show (have + need) & " " & (list-at h.vendor.currency.world.catalog.items (item - 1)).name
        & " in your backpack and have " & show have & "."))
    else let lot = ep-lot h.vendor.currency.world.goods serial
    in let next = ep-lot-next h.vendor.currency.world.goods serial
    in if lot.item /= item | ep-amount h.vendor.currency.world.goods lot.serial < 1
      | not (gv-under h.items.world lot.serial player.pack 65) | gmb-root h.items lot.serial 65 /= 0 then gcr-select-from h player item need next takes
    else when world-get h.items.world lot.serial
      is Err (e) -> Err e
      is Ok (obj) -> if obj.kind /= 2 | world-has-child h.items.world lot.serial 0 then Err "Craft material binding invalid."
        else let quantity = min need obj.amount
        in let take = CraftTake { serial = lot.serial, item = item, quantity = quantity,
          quality = lot.quality, wear = lot.wear, basis = lot.basis * quantity / obj.amount, whole = quantity == obj.amount }
        in gcr-select-from h player item (need - quantity) next (list-push takes take)
  gcr-held : List CraftTake, Integer, Integer -> Integer
  gcr-held (takes) (item) (i) = if i == list-length takes then 0
    else (if (list-at takes i).item == item then (list-at takes i).quantity else 0) + gcr-held takes item (i + 1)
  gcr-tool : GameHarvest, GvPlayer, Integer, Integer -> Integer
  gcr-tool (h) (player) (item) (unused) = gcr-tool-from h player item (ep-lot-first h.vendor.currency.world.goods player.actor)
  gcr-tool-from : GameHarvest, GvPlayer, Integer, Integer -> Integer
  gcr-tool-from (h) (player) (item) (serial) = if serial == 0 then -1
    else let lot = ep-lot h.vendor.currency.world.goods serial
    in let next = ep-lot-next h.vendor.currency.world.goods serial
    in if lot.item /= item | ep-amount h.vendor.currency.world.goods lot.serial /= 1 | lot.wear < 1 then gcr-tool-from h player item next
    else when world-get h.items.world lot.serial
      is Err (_) -> gcr-tool-from h player item next
      is Ok (tool) -> if gh-carried h player tool & tool.amount == 1 then serial else gcr-tool-from h player item next
  gcr-picks : List CraftTake, Integer, List EpPick -> List EpPick
  gcr-picks (takes) (i) (out) = if i == list-length takes then out
    else let t = list-at takes i
    in gcr-picks takes (i + 1) (list-push out (EpPick { serial = t.serial, item = t.item, quantity = t.quantity }))
  gcr-gone : GameHarvest, Integer -> Boolean
  gcr-gone (h) (serial) = when world-get h.items.world serial is Err (_) -> True is Ok (_) -> False
  gcr-shown : GameHarvest, List CraftTake, Integer, List (List Integer) -> List (List Integer)
  gcr-shown (h) (takes) (i) (packets) = if i == list-length takes then packets
    else let serial = (list-at takes i).serial
    in gcr-shown h takes (i + 1) (list-push packets (when world-get h.items.world serial is Err (_) -> sip-remove serial is Ok (obj) -> sip-item obj))
  gcr-output : GameHarvest, GvPlayer, EgRecipe, Integer, Integer, Integer, Integer -> Result WorldObject Text
  gcr-output (h) (player) (recipe) (quality) (basis) (graphic) (into) =
    let item = WorldObject { serial = 0, kind = 2, x = 60, y = 20, z = 0,
      graphic = graphic, hue = 0, container = into, amount = recipe.quantity, health = 0 }
    in when world-create h.items.world item
      is Err (e) -> Err e
      is Ok (serial) ->
        let lot = gv-add-lot h.vendor serial player.actor recipe.item quality 32 basis
        in if lot < 0 then Err "Craft output provenance refused."
        else let known = gsi-register h.items serial (gcr-layer recipe.item) 0 True False
        in world-get h.items.world serial
  gcr-finish : GameCraft, GvPlayer, Integer, Integer, EpLot, List CraftTake, Integer, Integer -> Result GameReply Text
  gcr-finish (state) (player) (recipe-id) (station) (tool) (takes) (graphic) (into) =
    let h = state.harvest
    in let w = h.vendor.currency.world
    in let p = ep-actor w player.actor
    in let r = list-at w.catalog.recipes (recipe-id - 1)
    in if not (ep-lot-room w.goods 1) | world-room h.items.world < 1 then Ok (gsi-denied "No room for the crafted item.")
    else let bound = gh-row h.vendor player
    in let quality-before = ep-at p.quality r.item
    in let cost-before = ep-at p.cost r.item
    in let picks = gcr-picks takes 0 (__list-with-capacity (list-length takes + 1))
    in let result = ep-craft-picks w player.actor recipe-id station picks tool.serial
    in if result == -1 then Ok (gsi-denied "The recipe, tools or workshop are unavailable.")
    else let broken = tool.item > 0 & gcr-gone h tool.serial
    in let quality = if result > 0 then (ep-at p.quality r.item - quality-before) / r.quantity else 0
    in let basis = ep-at p.cost r.item - cost-before
    in let packets = if result > 0 then gcr-shown h takes 0 [] else []
    in let invalidated = gh-invalidate-quotes h.vendor 0
    in let changes = if broken then list-push packets (sip-remove tool.serial) else packets
    in let skills = list-push changes (gh-skills h player (gsi-slot h.vendor.game player.serial 0))
    in if result < 0 then Ok (gs-reply (list-push skills (sip-message #FFFFFFFF #FFFF 6 "You fail to create the item.")) "craft failed attempt")
    else when gcr-output h player r quality basis graphic into
      is Err (e) -> Err e
      is Ok (made) ->
        let displayed = list-push skills (sip-item made)
        in Ok (gs-reply (list-push displayed (sip-message #FFFFFFFF #FFFF 6 "You create the item and place it in your backpack.")) "craft produced")
  gcr-produce : GameCraft, GvPlayer, Integer, Integer, Integer, Integer -> Result GameReply Text
  gcr-produce (state) (player) (recipe-id) (station) (graphic) (into) =
    let h = state.harvest
    in let w = h.vendor.currency.world
    in if recipe-id < 1 | recipe-id > list-length w.catalog.recipes | station < 1 | station > w.station-count then Ok (gsi-denied "Workshop unavailable.")
    else let r = list-at w.catalog.recipes (recipe-id - 1)
    in if r.item == r.one | r.item == r.two | r.item == r.three | r.item == r.tool
      | (r.tool > 0 & (r.tool == r.one | r.tool == r.two | r.tool == r.three))
      | (r.one > 0 & (r.one == r.two | r.one == r.three)) | (r.two > 0 & r.two == r.three)
      | gcr-graphic r.item == 0 | not (gv-owned h.items.world player.pack player.serial 65)
      | (graphic /= gcr-graphic r.item & not (r.item == 42 & (graphic == #0F9D | graphic == #1034)) & not (r.item == 50 & graphic == #09F2)) then Ok (gsi-denied "Craft recipe binding refused.")
    else let tool-at = if r.tool == 0 then -1 else gcr-tool h player r.tool 0
    in if r.tool > 0 & tool-at < 0 then Ok (gsi-denied "Carry or equip the recipe's working tool.")
    else let tool = if r.tool == 0 then EpLot { serial = 0, actor = 0, item = 0, quality = 0, wear = 0, basis = 0 }
      else ep-lot h.vendor.currency.world.goods tool-at
    in when gcr-select h player r.one r.one-count 0 (__list-with-capacity 64)
      is Err (e) -> Ok (gsi-denied e)
      is Ok (one) -> when gcr-select h player r.two r.two-count 0 one
        is Err (e) -> Ok (gsi-denied e)
        is Ok (two) -> when gcr-select h player r.three r.three-count 0 two
          is Err (e) -> Ok (gsi-denied e)
          is Ok (takes) -> gcr-finish state player recipe-id station tool takes graphic into

