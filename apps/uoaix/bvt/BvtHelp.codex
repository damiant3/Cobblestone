Chapter: BvtHelp
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter BvtCheck

  bvt-help-say : Text -> List Integer
  bvt-help-say (text) = sip-length (gp-ascii [3,0,0,0,3,#B2,0,3] text 0 (text-length text + 1))
  bvt-help : Integer -> [Console] Integer
  bvt-help (unused) = act
    a <- bvt-check "[go alone and [where help answer their usage (40097)" (text-starts-with (cp-usage (bvt-help-say "[go")) "[go x y" & cp-usage (bvt-help-say "[where help") == "[where: say where you stand.")
    b <- bvt-check "[go with its words, [where alone and plain speech answer no usage" (cp-usage (bvt-help-say "[go 1 2") == "" & cp-usage (bvt-help-say "[where") == "" & cp-usage (bvt-help-say "hello") == "")
    a + b
  end
