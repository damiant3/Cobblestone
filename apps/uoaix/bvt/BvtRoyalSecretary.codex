Chapter: BvtRoyalSecretary
  cites Uoaix chapter RoyalSecretary
  cites Uoaix chapter BvtCheck
  cites Uoaix chapter BvtLeash
  cites Uoaix chapter CompositeGameRules

  bsec-fill : Integer, Integer, Integer -> Integer
  bsec-fill (book) (n) (day) = if n == 0 then 0 else let row = rsc-appoint book (5000 + n) day in bsec-fill book (n - 1) day
 UOAIX-274: answers a bit per check: 1 an appointment holds for its day and not the next, 2 another character is not booked,
 4 a second appointment for the same character takes no new row, 8 a full day's book refuses the next, 16 a row from an
 earlier day is written over, 32 a name matches its slot in any case, 64 a prefix or a longer name does not; 127 is all.
  bsec-checks : Integer -> Integer
  bsec-checks (unused) = let book = alloc-bytes rsc-bytes
    in let zero = wd-zero book 0 rsc-bytes
    in let first = rsc-appoint book 777 3
    in let held = rsc-booked book 777 3 0 & not (rsc-booked book 777 4 0)
    in let other = not (rsc-booked book 778 3 0)
    in let again = rsc-appoint book 777 3
    in let single = again == first & peek-qword book 0 == 1
    in let filled = bsec-fill book (rsc-rows - 1) 3
    in let full = peek-qword book 0 == rsc-rows & rsc-appoint book 9999 3 < 0 & not (rsc-booked book 9999 3 0)
    in let next = rsc-appoint book 9999 4
    in let reused = next >= 0 & peek-qword book 0 == rsc-rows & rsc-booked book 9999 4 0
    in let slots = alloc-bytes (5 * 160)
    in let cleared = wd-zero slots 0 (5 * 160)
    in let serial = poke-qword slots 160 4242
    in let named = poke-byte slots (160 + 18) 77 + poke-byte slots (160 + 19) 105 + poke-byte slots (160 + 20) 114 + poke-byte slots (160 + 21) 97
    in let cased = rsc-in-slots slots [109, 105, 114, 97] 0 == 4242
    in let strict = rsc-in-slots slots [109, 105, 114] 0 == 0 & rsc-in-slots slots [109, 105, 114, 97, 115] 0 == 0
    in (if held then 1 else 0) + (if other then 2 else 0) + (if single then 4 else 0) + (if full then 8 else 0) + (if reused then 16 else 0) + (if cased then 32 else 0) + (if strict then 64 else 0)
 1 the install seats the secretary at the chair and lays the book beside the pen, 2 a second install adds neither; 3 is
 all.
  bsec-install : Integer -> Integer
  bsec-install (unused) = when blh-owner 0
    is Err (_) -> -1
    is Ok (owner) -> let items = owner.production.harvest.items
      in let first = rsc-install items
      in let seated = rsc-serial items.world /= 0 & rsc-book items.world (world-tile-first items.world rsc-book-x rsc-book-y) /= 0
      in let again = rsc-install items == 0
      in (if seated then 1 else 0) + (if again then 2 else 0)
 The canned reasons: 1 a witness of an open case has one and 2 another character has none, 4 a jailed case (status 4) is
 no reason, 8 an empty dead ring is none and 16 one noted death is one; 31 is all.
  bsec-reasons : Integer -> Integer
  bsec-reasons (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (world) -> let w = lw-new world
      in let c = list-at w.cases 0
      in let a = __record-set w "count" 1
      in let row = list-at w.witnesses 0
      in let b = __record-set row "serial" 777
      in let d = __record-set row "case-id" 1
      in let e = __record-set w "witness-count" 1
      in let open = cg-audience-witness w 777 0
      in let stranger = not (cg-audience-witness w 778 0)
      in let jailed = __record-set c "status" 4
      in let closed = not (cg-audience-witness w 777 0)
      in let ring = sa-new cg-dead-bytes cg-dead-rows
      in let quiet = not (cg-audience-death ring 0)
      in let noted = poke-qword (sa-at ring 3) 0 4242
      in let death = cg-audience-death ring 0
      in (if open then 1 else 0) + (if stranger then 2 else 0) + (if closed then 4 else 0) + (if quiet then 8 else 0) + (if death then 16 else 0)
  bvt-royal-secretary : Integer -> [Console] Integer
  bvt-royal-secretary (unused) = act
    n <- bsec-checks 0
    a <- bvt-check ("the Lord's secretary books a character for one game day, refuses a full book, reuses an old day's row, and finds a name in any case (UOAIX-274, code " & show n & ")") (n == 127)
    s <- bsec-install 0
    b <- bvt-check ("the Lord's secretary sits at her chair with the book beside the pen, installed once (UOAIX-274, code " & show s & ")") (s == 3)
    r <- bsec-reasons 0
    c <- bvt-check ("the secretary books on a live reason only: a witnessed open crime or a death in the town (UOAIX-274, code " & show r & ")") (r == 31)
    a + b + c
  end
