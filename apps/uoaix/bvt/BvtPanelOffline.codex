Chapter: BvtPanelOffline
  cites Uoaix chapter CompositePanelOffline
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtWorkerDay
  cites Uoaix chapter BvtCheck

  bpo-owner : Integer -> Result CompositeGame Text
  bpo-owner (unused) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency 0
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
  bpo-lord : CompositeGame -> Integer
  bpo-lord (g) = let game = g.checkpoint.game
    in when world-create game.world (gs-mobile 0 1420 1700 0 400 1002)
      is Err (_) -> 0
      is Ok (serial) -> let slotted = poke-qword (ga-slots game.accounts (ga-british game.accounts)) 0 serial
        in if glk-own-pack g.items serial == 0 then 0 else serial
  bpo-map : Integer -> Result WalkMap Text
  bpo-map (unused) = when walk-map-new 1380 1660 96 96
    is Err (e) -> Err e
    is Ok (map) -> let filled = bwd-fill map 0 in Ok map
  bpo-at : GameShard, Integer, Integer, Integer -> Boolean
  bpo-at (game) (serial) (x) (y) = when world-get game.world serial
    is Err (_) -> False
    is Ok (o) -> o.x == x & o.y == y
  bpo-claim : Integer -> Integer
  bpo-claim (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let none = cpo-british g.checkpoint.game == 0
      in let serial = bpo-lord g
      in let listed = cpo-offline "teleport" & cpo-offline "summon-creature" & cpo-offline "lord-british-enter" & cpo-offline "ban" & cpo-offline "decor-baked"
      in let unlisted = not (cpo-offline "kick") & not (cpo-offline "") & not (cpo-offline "grant-plot") & not (cpo-offline "house-grant") & not (cpo-offline "house-revoke")
      in (if none then 1 else 0) + (if serial /= 0 & cpo-british g.checkpoint.game == serial then 2 else 0) + (if listed then 4 else 0) + (if unlisted then 8 else 0)
  bpo-teleport : Integer -> Integer
  bpo-teleport (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> when bpo-map 0
      is Err (_) -> -1
      is Ok (map) -> let game = g.checkpoint.game
        in let serial = bpo-lord g
        in let moved = cpo-teleport map game serial 1430 1710
        in let there = is-ok moved & bpo-at game serial 1430 1710
        in let outside = cpo-teleport map game serial 1300 1600
        in let kept = not (is-ok outside) & bpo-at game serial 1430 1710
        in (if there then 1 else 0) + (if kept then 2 else 0)
  bpo-invisible : Integer -> Integer
  bpo-invisible (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let serial = bpo-lord g
      in let hid = cpo-invisible g serial
      in let hidden = is-ok hid & g.hidden == serial
      in let shown = cpo-invisible g serial
      in (if hidden then 1 else 0) + (if is-ok shown & g.hidden == 0 then 2 else 0)
  bpo-add : Integer -> Integer
  bpo-add (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let game = g.checkpoint.game
      in let serial = bpo-lord g
      in let pack = gsi-pack-find game.world serial 0
      in let added = cpo-add g game serial #1BF2 3
      in let child = world-first-child game.world pack
      in let placed = when world-get game.world child
        is Err (_) -> False
        is Ok (o) -> o.graphic == #1BF2 & o.amount == 3
      in let packless = when world-create game.world (gs-mobile 0 1422 1700 0 400 1002)
        is Err (_) -> False
        is Ok (other) -> let before = world-count game.world
          in not (is-ok (cpo-add g game other #1BF2 3)) & world-count game.world == before
      in (if is-ok added & placed then 1 else 0) + (if packless then 2 else 0)
  bpo-summon : Integer -> Integer
  bpo-summon (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> when bpo-map 0
      is Err (_) -> -1
      is Ok (map) -> let game = g.checkpoint.game
        in let before = world-count game.world
        in let summoned = cpo-summon map g game #11 1425 1705
        in let made = is-ok summoned & world-count game.world == before + 1
        in let after = world-count game.world
        in let outside = cpo-summon map g game #11 1300 1600
        in (if made then 1 else 0) + (if not (is-ok outside) & world-count game.world == after then 2 else 0)
  bpo-inspect : Integer -> Integer
  bpo-inspect (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let game = g.checkpoint.game
      in let serial = bpo-lord g
      in let seen = when cpo-inspect game serial
        is Err (_) -> False
        is Ok (t) -> text-starts-with t "mobile " & text-contains t "at 1420 1700 0"
      in (if seen then 1 else 0) + (if is-ok (cpo-inspect game 999999) then 0 else 2)
  bpo-move : Integer -> Integer
  bpo-move (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> when bpo-map 0
      is Err (_) -> -1
      is Ok (map) -> let game = g.checkpoint.game
        in let serial = bpo-lord g
        in when world-create game.world (__record-set (__record-set (gs-item 0 #0EED 0) "x" 1421) "y" 1701)
          is Err (_) -> -1
          is Ok (item) -> let moved = cpo-move map g game item 1440 1720 0
            in let refused = cpo-move map g game serial 1440 1720 0
            in (if is-ok moved & bpo-at game item 1440 1720 then 1 else 0) + (if not (is-ok refused) & bpo-at game serial 1420 1700 then 2 else 0)
  bpo-lord-mode : Integer -> Integer
  bpo-lord-mode (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let game = g.checkpoint.game
      in let serial = bpo-lord g
      in when ga-create game.accounts [66, 111, 98] [112, 119]
        is Err (_) -> -1
        is Ok (other) -> let lent = gs-bind game other
          in let flag = peek-qword game.accounts 56
          in let raised = cpo-lord g game serial
          in let restored = ga-bound game.accounts == other & peek-qword game.accounts 56 == flag
          in let stranger = when world-create game.world (gs-mobile 0 1423 1700 0 400 1002)
            is Err (_) -> False
            is Ok (s) -> not (is-ok (cpo-lord g game s))
          in let back = gs-bind game (ga-british game.accounts)
          in let slot = gsi-slot game serial 0
          in let row = game.characters + slot * 160
          in let skilled = slot >= 0 & gs-skill game serial 0 == 1000 & gs-skill game serial 45 == 1000 & gp-stat row 0 == 100 & gp-stat row 2 == 100
          in (if is-ok raised & skilled then 1 else 0) + (if restored then 2 else 0) + (if stranger then 4 else 0)
  bpo-no-kick : Integer -> Integer
  bpo-no-kick (serial) = 0
  bpo-navy : Integer -> Integer
  bpo-navy (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let before = g.ships.patrol
      in let once = cpo-navy g g.checkpoint.game
      in let flipped = g.ships.patrol == 1 - before
      in let twice = cpo-navy g g.checkpoint.game
      in (if is-ok once & flipped then 1 else 0) + (if is-ok twice & g.ships.patrol == before then 2 else 0)
  bpo-ban : Integer -> Integer
  bpo-ban (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let game = g.checkpoint.game
      in let lord = bpo-lord g
      in when ga-create game.accounts [66, 111, 98] [112, 119]
        is Err (_) -> -1
        is Ok (bob) -> when world-create game.world (gs-mobile 0 1424 1700 0 400 1002)
          is Err (_) -> -1
          is Ok (pc) -> let slotted = poke-qword (ga-slots game.accounts bob) 0 pc
            in let banned = cpo-ban bpo-no-kick game pc
            in let held = ga-banned game.accounts bob
            in let lordless = not (is-ok (cpo-ban bpo-no-kick game lord)) & not (ga-banned game.accounts (ga-british game.accounts))
            in let npc = when world-create game.world (gs-mobile 0 1425 1700 0 400 1002) is Err (_) -> False is Ok (n) -> not (is-ok (cpo-ban bpo-no-kick game n))
            in let unbanned = cpo-unban game "Bob"
            in let freed = is-ok unbanned & not (ga-banned game.accounts bob)
            in let again = not (is-ok (cpo-unban game "Bob")) & not (is-ok (cpo-unban game "Nobody")) & not (is-ok (cpo-unban game "B b"))
            in (if is-ok banned & held then 1 else 0) + (if lordless & npc then 2 else 0) + (if freed then 4 else 0) + (if again then 8 else 0)
  bpo-serials : Integer -> Boolean
  bpo-serials (unused) = cpo-serials "12,345" 0 0 0 [] == [12, 345] & cpo-serials "7" 0 0 0 [] == [7]
    & list-length (cpo-serials "12a" 0 0 0 []) == 0 & list-length (cpo-serials "" 0 0 0 []) == 0 & list-length (cpo-serials "12345678901" 0 0 0 []) == 0
  bpo-refusals : Integer -> Integer
  bpo-refusals (unused) = when bpo-owner 0
    is Err (_) -> -1
    is Ok (g) -> let game = g.checkpoint.game
      in let baked = not (is-ok (cpo-baked g game "x"))
      in if baked then 1 else 0
  bvt-panel-offline-navy : Integer -> [Console] Integer
  bvt-panel-offline-navy (unused) = act
    n <- bpo-navy 0
    bvt-check ("navy toggles the royal navy's daily patrol order with no session, and a second press stands it down (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-ban : Integer -> [Console] Integer
  bvt-panel-offline-ban (unused) = act
    n <- bpo-ban 0
    bvt-check ("ban bans a player's account with no session; Lord British and an NPC refuse; unban by name frees it, and a second unban, an unknown name or a name with a space refuses (UOAIX-251, code " & show n & ")") (n == 15)
  end
  bvt-panel-offline-decor : Integer -> [Console] Integer
  bvt-panel-offline-decor (unused) = act
    a <- bvt-check "decor-baked reads the panel's comma list of serials; a letter, an empty list or an 11-digit serial reads as none (UOAIX-251, cpo-serials)" (bpo-serials 0)
    a
  end
  bvt-panel-offline-refusals : Integer -> [Console] Integer
  bvt-panel-offline-refusals (unused) = act
    n <- bpo-refusals 0
    bvt-check ("decor-baked with no serial refuses with no session (UOAIX-251, code " & show n & ")") (n == 1)
  end
  bvt-panel-offline-claim : Integer -> [Console] Integer
  bvt-panel-offline-claim (unused) = act
    n <- bpo-claim 0
    bvt-check ("a panel action is claimed for the server's round only when it has an offline path, and British's character is found from his account with no session (UOAIX-251, code " & show n & ")") (n == 15)
  end
  bvt-panel-offline-teleport : Integer -> [Console] Integer
  bvt-panel-offline-teleport (unused) = act
    n <- bpo-teleport 0
    bvt-check ("teleport moves British's character with no session; a tile off the map refuses and leaves him (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-invisible : Integer -> [Console] Integer
  bvt-panel-offline-invisible (unused) = act
    n <- bpo-invisible 0
    bvt-check ("invisible toggles British's character with no session (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-add : Integer -> [Console] Integer
  bvt-panel-offline-add (unused) = act
    n <- bpo-add 0
    bvt-check ("summon-item puts the item in British's backpack with no session; a character with no pack refuses and makes nothing (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-summon : Integer -> [Console] Integer
  bvt-panel-offline-summon (unused) = act
    n <- bpo-summon 0
    bvt-check ("summon-creature makes one creature at the given tile with no session; a tile off the map refuses and makes nothing (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-inspect : Integer -> [Console] Integer
  bvt-panel-offline-inspect (unused) = act
    n <- bpo-inspect 0
    bvt-check ("inspect answers the target's line for the panel log; an absent serial refuses (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-move : Integer -> [Console] Integer
  bvt-panel-offline-move (unused) = act
    n <- bpo-move 0
    bvt-check ("move puts a ground item at the tile with no session; a player character refuses and stays (UOAIX-251, code " & show n & ")") (n == 3)
  end
  bvt-panel-offline-lord : Integer -> [Console] Integer
  bvt-panel-offline-lord (unused) = act
    n <- bpo-lord-mode 0
    bvt-check ("lord-british-enter raises British's saved skills and stats to 100 with another account bound, restores that binding and the login flag, and refuses a character not his (UOAIX-251, code " & show n & ")") (n == 7)
  end
