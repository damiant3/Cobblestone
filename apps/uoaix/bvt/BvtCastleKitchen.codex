Chapter: BvtCastleKitchen
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter CastleGate
  cites Uoaix chapter CompositeStation
  cites Uoaix chapter BvtCheck

  bck-has : List Integer, Integer, Integer -> Boolean
  bck-has (xs) (v) (i) = if i >= list-length xs then False else list-at xs i == v | bck-has xs v (i + 1)
  bvt-castle-kitchen : Integer -> [Console] Integer
  bvt-castle-kitchen (unused) = let baker = cgg-trade-of cgg-baker-place
    in let cook = cgg-trade-of cgg-cook-place
    in let home = BbSpot { x = 1324, y = 1607, z = 50 }
    in let h = cgg-house-of home 0
    in let trades = baker.raw == 33 & baker.product == 34 & baker.buyer == 3 & cook.raw == 9 & cook.product == 50 & cook.buyer == 5
      & baker.station.x == wks-castle-oven.x & baker.station.y == wks-castle-oven.y & cook.station.x == wks-castle-oven.x
      & baker.tool == 0 & cook.tool == 0 & cook.input == 9 & baker.input == 0
    in let sellers = cgg-raw-seller cgg-baker-place == 3 & cgg-raw-seller cgg-cook-place == bb-fishmonger & cgg-raw-seller cgg-stone-place == cgg-seller
      & cgg-kitchen-place 421 & cgg-kitchen-place 422 & not (cgg-kitchen-place 420) & not (cgg-kitchen-place cgg-fish-place)
    in let bids = gvb-goods 3 34 & not (gvb-goods 3 50) & not (gvb-material 3 50) & gvb-material 5 50 & gvb-material 3 33 & gvb-material bb-fishmonger 9
    in let lodged = h == list-length cgg-houses & (list-at cgg-lodges h).door.x == 1323 & (list-at cgg-lodges h).door.y == 1608 & (list-at cgg-lodges h).door.z == 50
      & cgg-house-of (BbSpot { x = 1645, y = 1580, z = 0 }) 0 < list-length cgg-houses
    in let founded = bck-has cg-founders cgg-baker-place 0 & bck-has cg-founders cgg-cook-place 0 & cgt-founded-open
    in let reserve = csn-batch-ready (csn-baker 0) == 4 & csn-batch-ready (csn-smith 0) == 2 & csn-batch-ready (csn-tailor 0) == 2
    in let oven = wks-castle-oven.x == 1315 & wks-castle-oven.y == 1604 & wks-castle-oven.z == 50 & wks-on 1315 1604 wks-castle-oven
      & not (wks-on 1315 1602 wks-castle-oven) & wks-beside 1317 1606 wks-castle-oven & not (wks-beside 1317 1601 wks-castle-oven)
    in act
      a <- bvt-check "the castle baker buys flour (33) and sells bread (34) to Good Eats, the cook buys fish (9) and sells fish steaks (50) to the inn, both at the castle oven, toolless, the cook by the cooked-food recipe that takes fish" trades
      b <- bvt-check "kitchen staff buy from Good Eats (3) and, fish being sold at the docks, the fishmonger (17); every other worker's seller stays the provisioner, and no other place is kitchen" sellers
      c <- bvt-check "Good Eats bids on bread and on no cooked food, the inn bids on fish steaks, and each seller holds the raw good as an input" bids
      d <- bvt-check "a kitchen home lies in the castle quarters, past every town house, leaving by the kitchen tile 1323,1608 at z 50 inside the doorway; a town house home stays in its house" lodged
      e <- bvt-check "both kitchen staff are founders and the portcullis is founded raised" founded
      f <- bvt-check "Good Eats bakes only while it holds 4 flour, keeping 2 for the castle baker; the smith still forges from 2 ingots" reserve
      g <- bvt-check "the fishmonger keeps 2 fish for the castle cook: the inn takes a lot of 4 from 6 but not from 5, the cutter needs 4 held, the cook 1 (bb-keeps, cgg-raw-floor)" (bb-keeps 6 4 bb-castle-fish & not (bb-keeps 5 4 bb-castle-fish) & cgg-raw-floor cgg-cutter-place == 4 & cgg-raw-floor cgg-cook-place == 1 & cgg-raw-floor cgg-baker-place == 1)
      h <- bvt-check "the castle oven stands at 1315,1604,50, two tiles south of its first place: its stand is searched around 1604, a cook at 1317,1606 is beside it and one at 1317,1601 is not" oven
      a + b + c + d + e + f + g + h
    end
