Chapter: BvtNujelmPowder
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtVesperWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-nujelm-powder : Integer -> [Console] Integer
  bvt-nujelm-powder (unused) = act
    shops <- ct-city-shops 0
    c <- cw-nujelm (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    t <- cgg-trade-in c cgg-powder-place
    own <- cw-vendor c 1 == s + bvv-k shops "Nujel'm Public Smithing" 0 & bvv-k shops "Nujel'm Public Smithing" 0 >= 0
    a <- bvt-check "Nujel'm's powder digger digs the powder (166) with a shovel on its sands and sells it to Nujel'm Public Smithing (UOAIX-237 F3)" (own & t.raw == 166 & t.product == 166 & t.buyer == 1 & t.tool == 115 & t.region.x1 == 3600 & cw-wants c cgg-powder-place)
    others <- cw-wants c (cgg-place + 1) | cw-wants c cgg-fish-place | cw-wants c cgg-flax-place | cw-wants c cgg-stone-place | cw-wants c cgg-lumber-place
    bucc <- cw-wants (cw-bucc (ct-table 0) shops ct-shop-roles) cgg-powder-place
    b <- bvt-check "Nujel'm founds no miner, fisherman, flax picker, quarrier or lumberjack on its sands, and no other city founds a powder digger" (not others & not bucc)
    door <- cw-door 8
    d <- bvt-check "Nujel'm (city 8) builds a worker city lodging at Restful Slumber, door 3739,1316" (is-just (cw-city (ct-table 0) shops ct-shop-roles 8) & door.x == 3739 & door.y == 1316)
    a + b + d
  end

