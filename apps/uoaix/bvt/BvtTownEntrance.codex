Chapter: BvtTownEntrance
  cites Uoaix chapter TownEntrances
  cites Uoaix chapter BvtCheck

 UOAIX-285: a placement whose rectangle comes within te-reach tiles of a town entrance is refused. Bits: 1 a tile on
 Britain's entrance; 2 a box 3 tiles off it; 4 a box 4 tiles off it is allowed; 8 a box beside Trinsic's door; 16 a box
 far from every entrance is allowed. 31 is all.
  bte-checks : Integer -> Integer
  bte-checks (unused) =
    let on = te-blocks tl-door-x tl-door-y tl-door-x tl-door-y
    in let edge = te-blocks (tl-door-x + 3) tl-door-y (tl-door-x + 6) (tl-door-y + 2)
    in let past = not (te-blocks (tl-door-x + 4) tl-door-y (tl-door-x + 6) (tl-door-y + 2))
    in let city = te-blocks 2020 2812 2025 2815
    in let far = not (te-blocks 1452 1529 1456 1533)
    in (if on then 1 else 0) + (if edge then 2 else 0) + (if past then 4 else 0) + (if city then 8 else 0) + (if far then 16 else 0)
  bvt-town-entrance : Integer -> [Console] Integer
  bvt-town-entrance (unused) = act
    n <- bte-checks 0
    a <- bvt-check ("UOAIX-285 nothing is built within 3 tiles of a town entrance (code " & show n & ")") (n == 31)
    a
  end