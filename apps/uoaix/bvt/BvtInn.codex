Chapter: BvtInn
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvi-holds : Integer, Integer -> Boolean
  bvi-holds (fish) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1005) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 9 fish in bb-from-bought w actor item
  bvi-lists : Integer -> Boolean
  bvi-lists (i) = if i >= list-length (bb-goods bb-inn) then False
    else let g = list-at (bb-goods bb-inn) i in (g.item == 50 & g.graphic == #097B) | bvi-lists (i + 1)
  bvt-inn : Integer -> [Console] Integer
  bvt-inn (unused) = act
    a <- bvt-check "the innkeeper cooks fish steaks with the cooked-food recipe that takes fish" (let c = bb-catalog 0 in let k = bb-recipe-from c 50 9 0 in k > 0 & (list-at c.recipes (k - 1)).one == 9 & (list-at c.recipes (k - 1)).item == 50)
    b <- bvt-check "the first cooked-food recipe takes meat, so the generic path would never cook the fisherman's fish" (let c = bb-catalog 0 in (list-at c.recipes (bb-recipe c 50 0 - 1)).one == 8)
    c <- bvt-check "the inn lists fish steaks (50, 0x097B); fish is sold at the docks, so the fisherman sells to the fishmonger and players' fish no longer go to the inn (UOAIX-167)" (bvi-lists 0 & not (gvb-material (gvb-role bb-inn) 9) & (cgg-trade-of cgg-fish-place).buyer == bb-fishmonger)
    d <- bvt-check "the inn cooks only from bought fish: one fish allows a batch, none allows none" (bvi-holds 1 50 & not (bvi-holds 0 50))
    a + b + c + d
  end