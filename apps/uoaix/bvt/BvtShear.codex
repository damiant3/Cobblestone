Chapter: BvtShear
  cites Uoaix chapter BritainProduction
  cites Uoaix chapter BvtCheck

  bvsh-book : Integer, Integer -> Integer
  bvsh-book (actor-offset) (quantity) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> 0 - 9
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1099) 100
      in if actor < 1 then 0 - 8
      else let r = eh-gather-from w (actor + actor-offset) 12 quantity
      in if r < 0 then r else ep-at w.gathered 12 * 100 + ep-at w.found 12 * 10 + ep-at (ep-actor w actor).stock 12
  bvt-shear : Integer -> [Console] Integer
  bvt-shear (unused) = act
    a <- bvt-check "shorn wool is booked as gathered (2), not found (0), and lands in the shearer's stock (2)" (bvsh-book 0 2 == 202)
    b <- bvt-check "a shear for no actor or of no wool books nothing" (bvsh-book 5 2 == 0 - 1 & bvsh-book 0 0 == 0 - 1)
    a + b
  end