Chapter: BvtActiveLevels
  cites Uoaix chapter ActiveSkillsState
  cites Uoaix chapter Skills
  cites Uoaix chapter BvtCheck

  bal-spare : Integer -> Boolean
  bal-spare (unused) = let a = list-at (as-actors 0 []) 0
    in let worn = sk-set a.spare 3 777
    in let got = as-levels-for a 0 True
    in got == a.spare & a.skills.levels == a.spare & sk-at a.spare 3 == 0
  bal-row : Integer -> Boolean
  bal-row (unused) = let a = list-at (as-actors 0 []) 1
    in let row = sk-buffer 46
    in let got = as-levels-for a row False
    in let kept = as-levels-for a 0 False
    in got == row & a.skills.levels == row & kept == row
  bvt-active-levels : Integer -> [Console] Integer
  bvt-active-levels (unused) = act
    a <- bvt-check "a session with no skill row takes the actor's boot-time spare, cleared, not a buffer made in play (L-BELOWMARK; red, UOAIX audit 2026-10-18)" (bal-spare 0)
    b <- bvt-check "a session with a skill row binds the row, and a returning session with none keeps what it had" (bal-row 0)
    a + b
  end
