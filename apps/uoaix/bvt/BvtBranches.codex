Chapter: BvtBranches
  cites Uoaix chapter GameCarve
  cites Uoaix chapter BvtCheck

  bvt-branch-free : List EgRecipe, Integer -> Boolean
  bvt-branch-free (recipes) (i) = if i >= list-length recipes then True
    else let r = list-at recipes i
    in if r.one == 2 | r.two == 2 | r.three == 2 then False else bvt-branch-free recipes (i + 1)
  bvt-recipe-of : List EgRecipe, Integer, Integer -> Integer
  bvt-recipe-of (recipes) (item) (i) = if i >= list-length recipes then 0 - 1
    else if (list-at recipes i).item == item then i else bvt-recipe-of recipes item (i + 1)
  bvt-branches : Integer -> [Console] Integer
  bvt-branches (unused) = let c = bb-catalog 0
    in let axe = list-at c.recipes (bvt-recipe-of c.recipes 26 0)
    in let pick = list-at c.recipes (bvt-recipe-of c.recipes 25 0)
    in let bread = list-at c.recipes (bvt-recipe-of c.recipes 34 0)
    in let ingot = list-at c.recipes (bvt-recipe-of c.recipes 31 0)
    in act
      a <- bvt-check "no recipe takes fallen branches (row 24)" (bvt-branch-free c.recipes 0)
      b <- bvt-check "the stone axe is 3 stone and needs no wood; the pickaxe takes 2 stone and a board" (axe.one == 1 & axe.one-count == 3 & axe.two == 0 & pick.one == 1 & pick.two == 38 & pick.two-count == 1)
      d <- bvt-check "bread burns a log, and smelting takes no fuel" (bread.three == 15 & bread.three-count == 1 & ingot.two == 0)
      e <- bvt-check "the provisioner buys no branches and a blade makes no kindling from them" (not (gvb-material 0 2) & not (gca-wood 2) & gca-wood 15 & gca-wood 38)
      f <- bvt-check "fallen branches are no item: catalog slot 2 is retired, kept for the ids" ((list-at c.items 1).name == "(retired)")
      g <- bvt-check "founding makes the crown's stone hammer from stone and a board although the axe for the logs eats stone (bb-craft re-ensures)" (is-ok (bb-economy 0))
      h <- bvt-check "the oven burns a board when the cook holds no log" (bvt-fuel 0 == 38 & bvt-fuel 2 == 15)
      a + b + d + e + f + g + h
    end
  bvt-fuel : Integer -> Integer
  bvt-fuel (logs) = when bb-economy 0
    is Err (_) -> 0 - 1
    is Ok (x) -> let w = x.world
      in let actor = ep-admit w (eu-open x 2 2997) 100
      in let boards = ep-find w actor 38 2
      in let wood = if logs > 0 then ep-find w actor 15 logs else 0
      in ep-fuel (ep-actor w actor) (list-at w.catalog.recipes (bvt-recipe-of w.catalog.recipes 34 0)) 15 1
