Chapter: BvtTavernCards
  cites Uoaix chapter TavernCards
  cites Uoaix chapter GameCombat
  cites Uoaix chapter BvtCheck
  cites Games chapter GoFish
  cites Games chapter Poker
  cites Games chapter Blackjack

  btc-table : Integer -> Integer
  btc-table (seed) = let buf = cb-zeroed tcd-bytes
    in let a = tcd-put buf 0 1 11 in let b = tcd-put buf 0 2 22 in let c = tcd-put buf 0 3 2 in let d = tcd-put buf 0 4 0
    in let stored = tcd-store buf 0 (ce-init seed 2) in buf
  btc-unplayable : CrazyEightsState, Integer, Integer -> Integer
  btc-unplayable (s) (seat) (c) = if c >= 52 then -1 else if ce-hand-has s seat c & not (ce-can-play s seat c) then c else btc-unplayable s seat (c + 1)
  btc-note : Maybe TcdOut -> Text
  btc-note (o) = when o is None -> "none" is Just (x) -> x.reply.note
  bvt-tavern-cards : Integer -> [Console] Integer
  bvt-tavern-cards (unused) = act
    buf <- btc-table 5
    s0 <- tcd-state buf 0
    a <- bvt-check "UOAIX-178: a dealt table keeps seven cards a seat and 37 in the stock through its bytes" (list-at s0.hand-sizes 0 == 7 & list-at s0.hand-sizes 1 == 7 & s0.pile-size == 37 & s0.current-player == 0)
    early <- btc-note (tcd-answer buf 22 tcd-draw 1)
    b <- bvt-check "UOAIX-178: the seat not on turn is refused" (early == "cards:wait" & (tcd-state buf 0).current-player == 0)
    drew <- btc-note (tcd-answer buf 11 tcd-draw 2)
    s1 <- tcd-state buf 0
    c <- bvt-check "UOAIX-178: a draw takes one card from the stock and passes the turn" (drew == "cards:play" & list-at s1.hand-sizes 0 == 8 & s1.pile-size == 36 & s1.current-player == 1)
    bad <- btc-unplayable s1 1 0
    refused <- if bad < 0 then "no unplayable card" else btc-note (tcd-answer buf 22 (bad + 1) 3)
    d <- bvt-check "UOAIX-178: a card that does not follow the pile is refused and the hand kept" (bad < 0 | (refused == "cards:refused" & list-at (tcd-state buf 0).hand-sizes 1 == 7))
    stranger <- btc-note (tcd-answer buf 33 tcd-draw 4)
    g <- tcd-gump buf 0 0
    e <- bvt-check "UOAIX-178: a watcher's gump answer changes nothing; a seat's gump is a whole 0xB0" (stranger == "cards:gone" & list-at g 0 == #B0 & list-at g 1 * 256 + list-at g 2 == list-length g)
    a + b + c + d + e
  end
  btc-seat : Integer, Integer, Integer, Integer -> Integer
  btc-seat (buf) (t) (kind) (phase) = let a = tcd-put buf t 1 (11 + t * 100) in let b = tcd-put buf t 2 (if kind == tcd-k-jack then 0 else 22 + t * 100) in let c = tcd-put buf t 3 phase in tcd-put buf t tcd-kind kind
  btc-held-rank : GoFishState, Integer, Integer -> Integer
  btc-held-rank (s) (seat) (r) = if r >= 13 then -1 else if gf-count-rank-in-hand s seat r > 0 then r else btc-held-rank s seat (r + 1)
  btc-missing-rank : GoFishState, Integer, Integer -> Integer
  btc-missing-rank (s) (seat) (r) = if r >= 13 then -1 else if gf-count-rank-in-hand s seat r == 0 then r else btc-missing-rank s seat (r + 1)
  btc-fish-cards : GoFishState -> Integer
  btc-fish-cards (s) = list-at s.hand-sizes 0 + list-at s.hand-sizes 1 + s.pile-size + 4 * s.total-books
  bvt-tavern-card-games : Integer -> [Console] Integer
  bvt-tavern-card-games (unused) = act
    buf <- cb-zeroed tcd-bytes
    waiting <- btc-seat buf 4 0 1
    stranger <- btc-note (tcd-choose buf 4 33 102 1)
    chosen <- btc-note (tcd-choose buf 4 411 102 1)
    a <- bvt-check "UOAIX-189: only the seated player chooses the game, and Go Fish then waits for a second player" (stranger == "cards:button" & chosen == "cards:chosen" & tcd-at buf 4 tcd-kind == tcd-k-fish & tcd-at buf 4 3 == 1)
    fished <- btc-seat buf 1 tcd-k-fish 2
    fdealt <- tcd-fish-deal buf 1 7
    f0 <- tcd-fish-state buf 1
    lacking <- btc-missing-rank f0 0 0
    nope <- if lacking < 0 then "cards:refused" else btc-note (tcd-answer buf 111 (200 + lacking) 1)
    held <- btc-held-rank f0 0 0
    asked <- btc-note (tcd-answer buf 111 (200 + held) 2)
    f1 <- tcd-fish-state buf 1
    b <- bvt-check "UOAIX-189: Go Fish refuses a rank the asker lacks, and an ask keeps all 52 cards in hands, stock and books" (nope == "cards:refused" & (asked == "cards:ask" | asked == "cards:over") & btc-fish-cards f0 == 52 & btc-fish-cards f1 == 52)
    played <- btc-seat buf 2 tcd-k-poker 2
    pdealt <- tcd-pk-deal buf 2 9 pk-start-chips pk-start-chips
    early <- btc-note (tcd-answer buf 222 302 1)
    checked <- btc-note (tcd-answer buf 211 302 2)
    checked2 <- btc-note (tcd-answer buf 222 302 3)
    p1 <- tcd-pk-state buf 2
    drew <- btc-note (tcd-answer buf 211 320 4)
    drew2 <- btc-note (tcd-answer buf 222 320 5)
    p2 <- tcd-pk-state buf 2
    c <- bvt-check "UOAIX-189: poker waits its turn, two checks open the draw, two draws open the second round" (early == "cards:wait" & checked == "cards:bet" & checked2 == "cards:bet" & p1.stage == 1 & drew == "cards:bet" & drew2 == "cards:bet" & p2.stage == 2 & p2.pot == 2 * pk-ante)
    jacked <- btc-seat buf 3 tcd-k-jack 2
    jdealt <- tcd-bj-deal buf 3 11
    j0 <- tcd-bj-state buf 3
    declined <- if j0.phase == 0 then btc-note (tcd-answer buf 311 405 1) else "none"
    j1 <- tcd-bj-state buf 3
    stood <- if j1.phase == 1 then btc-note (tcd-answer buf 311 401 2) else "none"
    j2 <- tcd-bj-state buf 3
    d <- bvt-check "UOAIX-189: blackjack against the house settles after the player stands" (j2.phase == 2)
    a + b + c + d
  end
