Chapter: BvtOpenChange
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtWorkerDay
  cites Uoaix chapter BvtCheck

 The founded town's treasury opened: answers 1 when it holds gold and enough copper and silver to change every gold at
 the current rates, 0 when not, -1 when the scenario cannot be built; again, the number of coins a second opening adds.
  boc-opened : Integer -> Integer
  boc-opened (again) = when bwd-founded 0
    is Err (_) -> -1
    is Ok (owner) -> let x = owner.vendor.currency
      in let first = cg-open-treasury owner
      in let gold = (em-purse x.world.money 1).coin
      in let copper = (em-purse x.copper 1).coin
      in let silver = (em-purse x.silver 1).coin
      in if again == 0 then (if first == 1 & gold > 0 & copper >= gold * x.copper-rate & silver >= gold * x.silver-rate then 1 else 0)
      else let second = cg-open-treasury owner
      in (em-purse x.world.money 1).coin + (em-purse x.copper 1).coin + (em-purse x.silver 1).coin - gold - copper - silver
  boc-ingots : Integer = 40
  boc-founded-nodes : Integer -> Integer
  boc-founded-nodes (unused) = when bwd-founded 0
    is Err (_) -> -1
    is Ok (owner) -> let x = owner.vendor.currency
      in let crown = x.world.mint-owner
      in let before = x.world.node-count
      in if crown <= 0 then -1
      else when bb-require (bb-producer x crown) 65 boc-ingots
        is Err (_) -> -2
        is Ok (_) -> if ep-at (ep-actor x.world crown).stock 65 < boc-ingots then -3
          else if not (ev-valid x.world) then -4
          else x.world.node-count - before
  bvt-open-change : Integer -> [Console] Integer
  bvt-open-change (unused) = act
    n <- boc-opened 0
    m <- boc-opened 1
    k <- boc-founded-nodes 0
    a <- bvt-check ("the opening strikes copper and silver to change every gold it strikes at the current rates (UOAIX-148, code " & show n & ")") (n == 1)
    b <- bvt-check ("a treasury already holding gold strikes nothing more at a second opening (added " & show m & ")") (m == 0)
    c <- bvt-check ("the crown's " & show boc-ingots & " copper ingots harvest their ore and found no lasting nodes in a valid economy (added " & show k & ")") (k >= 0 & k < 8)
    a + b + c
  end
