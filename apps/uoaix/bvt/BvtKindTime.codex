Chapter: BvtKindTime
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 UOAIX-216: the wheel's per-kind charge (cg-kind-charge, cg-kind-begin) and its TICK SLOW text (cg-kind-said).
  bvkt-buffer : Integer -> Integer
  bvkt-buffer (unused) = let b = alloc-bytes cg-kind-bytes in let z = cg-kind-reset b 0 in b
  bvt-kind-time : Integer -> [Console] Integer
  bvt-kind-time (unused) = act
    b <- bvkt-buffer 0
    idle <- cg-kind-charge b
    begun <- cg-kind-begin b 8 3
    charged <- cg-kind-charge b
    again <- cg-kind-charge b
    stray <- cg-kind-begin b 40 0
    station <- cg-kind-begin b cgs-kind 7
    stationed <- cg-kind-charge b
    strayed <- cg-kind-charge b
    said <- cg-kind-said b 1000000 0 ""
    a <- bvt-check ("a fired wheel entry is charged once to its kind, a charge with no running entry or a kind past the table charges nothing, and a station entry is charged to its key (13.7), and TICK SLOW names only the kinds that fired: '" & said & "'") (peek-qword b (16 + 8 * 16 + 8) == 1 & peek-qword b (16 + 8 * 16) >= 0 & peek-qword b 0 == 0 & text-contains said " 8:" & text-length said > 0 & not (text-contains said " 12:") & text-contains said " 13.7:" & peek-qword b (16 + (cg-kinds + 7) * 16 + 8) == 1 & not (text-contains said " 13:"))
    z <- cg-kind-reset b 0
    cleared <- cg-kind-said b 1000000 0 ""
    c <- bvt-check "a reset buffer names no kind" (text-length cleared == 0 & peek-qword b (16 + 8 * 16 + 8) == 0)
    idle-switch <- cg-kind-switch b (cg-kinds + 13)
    walked <- cg-kind-begin b cgs-kind 8
    stepped <- cg-kind-switch b (cg-kinds + 13)
    ended <- cg-kind-charge b
    split <- cg-kind-said b 1000000 0 ""
    d <- bvt-check ("a switch with no entry running charges nothing; inside the townsfolk walk it charges 13.8 and runs the town step as 13.13: '" & split & "'") (text-contains split " 13.8:" & text-contains split " 13.13:" & peek-qword b (16 + (cg-kinds + 13) * 16 + 8) == 1 & peek-qword b 0 == 0)
    y <- cg-kind-reset b 0
    civic <- cg-kind-begin b cgs-kind 8
    alarms <- cg-kind-switch b (cg-civic-slot 0)
    synced <- cg-kind-switch b (cg-civic-slot (cg-civic-slots - 1))
    past <- cg-kind-switch b (cg-civic-slot cg-civic-slots)
    civic-end <- cg-kind-charge b
    civic-said <- cg-kind-said b 1000000 0 ""
    e <- bvt-check ("the civic step's parts follow the 21 keepers (13.41 alarms to 13.49 door sync), and a slot past the table is said nowhere: '" & civic-said & "'") (cg-civic-slot 0 == cg-kinds + 41 & text-contains civic-said " 13.41:" & text-contains civic-said " 13.49:" & not (text-contains civic-said " 13.50:") & not (text-contains civic-said " 13.40:"))
    a + c + d + e
  end
