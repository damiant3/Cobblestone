Chapter: BvtHold
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvt-hold : Integer -> [Console] Integer
  bvt-hold (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("hold fixture economy: " & e) False
    is Ok (x) -> act
      w <- x.world
      smith <- ep-admit w (eu-open x 2 2998) 100
      base <- gvb-bid w 1 cgg-ingot
      found <- ep-find w smith cgg-ingot 11
      stocked <- gvb-bid-for w 1 smith cgg-ingot
      used <- ep-consume w smith cgg-ingot 1
      short <- gvb-bid-for w 1 smith cgg-ingot
      a <- bvt-check "the smith's ingot bid falls below its base while it holds more than ten, and is back at base at ten" (base >= 1 & found >= 0 & stocked < base & short >= base)
      b <- bvt-check "a miner worth a gold holds its ingots while the bid is low (row 22)" (cgg-holds (ep-unit w) (ep-unit w) stocked base)
      c <- bvt-check "it sells once the bid is back at base, or when it is worth less than a gold" (not (cgg-holds (ep-unit w) (ep-unit w) short base) & not (cgg-holds (ep-unit w - 1) (ep-unit w) stocked base))
      a + b + c
    end
