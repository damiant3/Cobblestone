Chapter: BvtRoyalStable
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter RoyalStable
  cites Uoaix chapter BvtCheck

 UOAIX-156: the royal stableman stands in The Stables once however often boot installs him, answers a single click as
 the royal stableman, and hears a speaker within his reach and not one in the street beyond it.
  brs-note : Maybe GameReply -> Text
  brs-note (r) = when r is None -> "" is Just (g) -> g.note
  brs-made : Result Integer Text -> Integer
  brs-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bvt-royal-stable : Integer -> [Console] Integer
  bvt-royal-stable (unused) = when cg-new 0
    is Err (e) -> bvt-check ("royal stable fixture: " & e) False
    is Ok (owner) -> let world = owner.items.world
      in let first = rst-install owner.items
      in let keeper = rst-serial world
      in let again = rst-install owner.items
      in let near = brs-made (world-create world (gs-mobile 0 (rst-x + 2) (rst-y - 3) rst-z 400 1015))
      in let far = brs-made (world-create world (gs-mobile 0 1420 1700 0 400 1015))
      in let named = rst-label world (gp-put32 [9] keeper)
      in let other = rst-label world (gp-put32 [9] near) in act
      print-line-uni ("ROYALSTABLE first=" & show first & " again=" & show again & " keeper=" & show keeper & " note=" & brs-note named)
      a <- bvt-check "boot installs one royal stableman in The Stables and a second install adds none (UOAIX-156)" (first == 1 & again == 0 & keeper > 0)
      b <- bvt-check "a single click on him answers the royal stableman, and on another mobile does not" (brs-note named == "stable:name" & brs-note other == "")
      c <- bvt-check "he hears a speaker within his reach and not one in the street" (near > 0 & far > 0 & rst-near world near & not (rst-near world far))
      a + b + c
    end
