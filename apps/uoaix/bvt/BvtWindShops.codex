Chapter: BvtWindShops
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

 Wind's 9 shops follow the cities appended before it; the first is the provisioner of Mages's Things.
  bwns-first : List BbShop, Integer -> Integer
  bwns-first (shops) (k) = if k >= list-length shops then -1 else if (list-at shops k).premises == "Mages's Things" then k else bwns-first shops (k + 1)
  bwns-inside : List CtCity, List BbShop, Integer, Integer, Integer -> Boolean
  bwns-inside (cities) (shops) (city) (k) (last) = if k > last then True
    else let s = list-at shops k
    in ct-city-at cities s.x1 s.y1 0 == city & ct-city-at cities s.x2 s.y2 0 == city & bwns-inside cities shops city (k + 1) last
  bvt-wind-shops : Integer -> [Console] Integer
  bvt-wind-shops (unused) = let cities = ct-table 0
    in let shops = ct-city-shops 0
    in let wind = ct-city-at cities 5223 150 0
    in let k = bwns-first shops 0
    in act
      a <- bvt-check "Wind's 9 shops (provisioner, tailor, baker, healer, three inns, two herbalists) each keep their keeper inside Wind (UOAIX-217)" (k >= 0 & list-length shops >= k + 9 & (list-at shops (k + 8)).premises == "Wind Alchemy" & bwns-inside cities shops wind k (k + 8))
      b <- bvt-check "a Wind vendor sells as its Britain role: the provisioner as 0, the tailor as 2, the Wind Alchemy herbalist as 12; Wind has no blacksmith role" (k >= 0 & ct-vendor-role (bb-shop-count + k) == 0 & ct-vendor-role (bb-shop-count + k + 1) == 2 & ct-vendor-role (bb-shop-count + k + 8) == 12 & ct-vendor-role (bb-shop-count + k + 1) /= 1 & list-length ct-shop-roles == list-length shops)
      a + b
    end
