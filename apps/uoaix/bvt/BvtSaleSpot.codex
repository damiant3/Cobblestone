Chapter: BvtSaleSpot
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvss-inside : Integer -> Boolean
  bvss-inside (i) = if i >= bb-shop-count then True
    else let s = list-at bb-shops i in let b = cgg-sale-box s.x1 s.y1 i
    in b.x1 >= s.x1 & b.y1 >= s.y1 & b.x2 <= s.x2 & b.y2 <= s.y2 & bvss-inside (i + 1)
  bvt-sale-spot : Integer -> [Console] Integer
  bvt-sale-spot (unused) = act
    a <- bvt-check "the lumberjack's sale tile at the paper mill starts inside the Miner's Guild, not beyond its west wall (gate bug, main 40625)" (let b = cgg-sale-box 1417 1577 cgg-mill in b.x1 == 1417 & b.y1 == 1577 & b.x2 == 1419 & b.y2 == 1579)
    b <- bvt-check "for every shop a keeper on its premises' corner gets a sale box inside those premises" (bvss-inside 0)
    c <- bvt-check "a keeper standing outside its premises (the bank lineup) keeps the plain box around it" (let b = cgg-sale-box 1440 1694 cgg-mill in b.x1 == 1438 & b.y1 == 1692 & b.x2 == 1442 & b.y2 == 1696)
    a + b + c
  end