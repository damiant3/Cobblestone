Chapter: BvtPlayerIndex
  cites Uoaix chapter BritainShops
  cites Uoaix chapter GameVendorState
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

 gv-player runs from every pulse and every player test; a walk of every player there costs sessions times players, so
 a serial's row comes from a table filled by gv-add-player, a release and a decode, and an empty cell answers none.
  bpx-made : Result Integer Text -> Integer
  bpx-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bpx-add : GvWorld, Integer -> Integer
  bpx-add (v) (i) = let actor = ep-admit v.currency.world (eu-open v.currency 2 (2000 + i)) 100
    in let who = bpx-made (world-create v.game.world (gs-mobile 0 1421 1698 0 400 1002))
    in let pack = bpx-made (world-create v.game.world (gs-item who #0E75 0))
    in let row = gv-add-player v who actor pack
    in if row < 0 then 0 else who
  bvt-player-index : Integer -> [Console] Integer
  bvt-player-index (unused) = when gs-new 0
    is Err (e) -> bvt-check ("player index fixture shard: " & e) False
    is Ok (shard) -> when bb-economy 0
      is Err (e) -> bvt-check ("player index fixture economy: " & e) False
      is Ok (x) -> act
        v <- gv-new shard x
        one <- bpx-add v 0
        two <- bpx-add v 1
        found <- one /= 0 & two /= 0 & gv-player v one 0 == 0 & gv-player v two 0 == 1 & gv-player v 424242 0 == -1
        planted <- __record-set (list-at v.players 2) "serial" 777
        counted <- __record-set v "player-count" 3
        unseen <- gv-player v 777 0 == -1
        refilled <- gv-index-rebuild v
        seen <- gv-player v 777 0 == 2 & gv-player v one 0 == 0
        cap <- v.player-cap
        grown <- gv-grow-players v gv-player-limit
        widened <- v.player-cap > cap & gv-player v two 0 == 1 & gv-player v 777 0 == 2
        a <- bvt-check "an added player is found at its row, and a stranger is no player" found
        b <- bvt-check "a lookup walks no player: a row written past gv-add-player is not found until the table is refilled" unseen
        c <- bvt-check "a refill finds every row, and a grown player table widens the table and keeps every row" (seen & widened)
        a + b + c
      end
