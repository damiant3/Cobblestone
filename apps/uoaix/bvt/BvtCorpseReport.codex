Chapter: BvtCorpseReport
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-corpse-report : Integer -> [Console] Integer
  bvt-corpse-report (unused) = let row = cb-zeroed cg-dead-bytes
    in let fresh = not (cg-dead-heard row)
    in let none = cg-dead-hear row 0
    in let still = not (cg-dead-heard row)
    in let told = cg-dead-hear row 4242
    in act
    a <- bvt-check "a noted corpse is reported until a guard takes the report, then no more" (fresh & cg-dead-heard row)
    b <- bvt-check "no guard found leaves the corpse reported" still
    a + b
  end
