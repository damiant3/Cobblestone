Chapter: BvtStylist
  cites Uoaix chapter CharacterStylist
  cites Uoaix chapter BvtCheck

  bvt-stylist : Integer -> [Console] Integer
  bvt-stylist (unused) = act
    a <- bvt-check "a restyle strips a beard, dress or skirt the miner's look lacks (main 40148)" (bvt-st-has 16 0 & bvt-st-has 22 0 & bvt-st-has 23 0 & not (cst-names (cst-look cst-miner 7).rows 22 0))
    b <- bvt-check "a restyle never strips an outfit or stock lot layer (1, 3, 4, 5, 10)" (not (bvt-st-has 1 0) & not (bvt-st-has 3 0) & not (bvt-st-has 4 0) & not (bvt-st-has 5 0) & not (bvt-st-has 10 0))
    a + b
  end
  bvt-st-has : Integer, Integer -> Boolean
  bvt-st-has (layer) (i) = if i == list-length cst-layers then False else list-at cst-layers i == layer | bvt-st-has layer (i + 1)
