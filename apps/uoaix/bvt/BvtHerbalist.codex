Chapter: BvtHerbalist
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvt-herbalist : Integer -> [Console] Integer
  bvt-herbalist (unused) = act
    a <- bvt-check "the herbalist is shop 13, in Strength And Steel, selling the five plant reagents 17-21" (bb-shop-count >= 13 & bb-herbalist == 12 & (list-at bb-shops 12).title == "Herbalist" & (list-at bb-shops 12).premises == "Strength And Steel" & bvh-goods 0 17)
    b <- bvt-check "vendor 12 opens the herbalist's menu and buys the plant reagents, not black pearl (22)" (list-at gvb-role-words 12 == "herbalist" & gvb-material 12 17 & gvb-material 12 21 & not (gvb-material 12 22) & not (gvb-material 12 16))
    c <- bvt-check "the herb farmer (place 404) picks all five reagents with the trowel (28, the catalog's tool for each) in each reagent's plant cluster and sells them to the herbalist" (bvh-trades 0)
    d <- bvt-check "the herb farmer is one founder (GVS1 worker room); places 405-408 found no one" (bvh-in cg-founders 404 0 & not (bvh-in cg-founders 405 0) & not (bvh-in cg-founders 408 0) & cc-worker-room == list-length cg-founders)
    a + b + c + d
  end
  bvh-goods : Integer, Integer -> Boolean
  bvh-goods (i) (item) = if i == 5 then list-length (bb-goods 12) == 5
    else (list-at (bb-goods 12) i).item == item & bvh-goods (i + 1) (item + 1)
  bvh-trades : Integer -> Boolean
  bvh-trades (k) = if k == 5 then True
    else let t = cgg-crop-trade cgg-herb-farm (17 + k)
    in list-at (cgg-farm-crops cgg-herb-farm) k == 17 + k & t.raw == 17 + k & t.product == 17 + k & t.buyer == bb-herbalist & t.tool == 28 & (list-at (bb-catalog 0).resources (16 + k)).tool == 28
      & t.region.x1 == (list-at cgg-herb-regions k).x1 & t.art == (list-at (bb-goods 12) k).graphic & bvh-trades (k + 1)
  bvh-in : List Integer, Integer, Integer -> Boolean
  bvh-in (xs) (v) (i) = if i >= list-length xs then False else list-at xs i == v | bvh-in xs v (i + 1)
