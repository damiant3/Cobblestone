Chapter: BvtGuards
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter NpcLines
  cites Uoaix chapter CivicLive
  cites Uoaix chapter BvtCheck

  bvt-guards : Integer -> [Console] Integer
  bvt-guards (unused) = act
    a <- bvt-check "a guard 36 tiles from the caller hears the guards call" (cg-in-earshot 1400 1600 1436 1600)
    b <- bvt-check "a guard 37 tiles from the caller does not answer" (not (cg-in-earshot 1400 1600 1437 1600))
    c <- bvt-check "a guard holds a trained skill, neither none nor perfect" (cg-guard-skill > 0 & cg-guard-skill < 1000)
    d <- bvt-check "a guard joining the focus names the first guard and the creature" (nl-guard-join 0 "Carl" "a skeleton" == "Nice hit Carl, let me help you kill that skeleton!")
    e <- bvt-check "a creature named without an article keeps its whole name" (nl-bare "Lord Blackthorn" == "Lord Blackthorn")
    f <- bvt-check "a guard chases a creature past the edge of earshot" (cg-chase-reach > cv-earshot)
    g <- bvt-check "a guard without the gorget whose wages cover the price buys one" (cg-guard-wants False 50 40)
    h <- bvt-check "a guard already wearing it, or short of coin, buys none" (not (cg-guard-wants True 50 40) & not (cg-guard-wants False 30 40))
    a + b + c + d + e + f + g + h
  end
