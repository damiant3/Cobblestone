Chapter: BvtCityTrees
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvt-city-trees : Integer -> [Console] Integer
  bvt-city-trees (unused) = let cities = ct-table 0
    in act
      a <- bvt-check "a lumberjacking swing (resource 15) inside Britain's or Trinsic's bounds is a city tree (UOAIX-235, Damian: a misdemeanor to cut city trees)" (cg-tree-in-city cities 15 1450 1600 & cg-tree-in-city cities 15 1900 2750)
      b <- bvt-check "a swing in the wilds, or a mining swing in a city, is not" (not (cg-tree-in-city cities 15 1000 1000) & not (cg-tree-in-city cities 5 1450 1600))
      a + b
    end