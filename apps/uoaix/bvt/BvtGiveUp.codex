Chapter: BvtGiveUp
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BritainProduction
  cites Uoaix chapter EconomyGatherer
  cites Uoaix chapter BvtCheck

 UOAIX-260: a worker whose plan failed cgg-give-up-fails times running gives up and turns home on the way out (leg 1)
 and on a shop, forge or seller walk (legs 4, 6, 8, 10), and nowhere else. Answers a bit per check: 1 a Skara Brae
 lumberjack at 6 failures and the slowest pace gives up on legs 1, 4, 6, 8 and 10; 2 not at its node (leg 2), selling
 (leg 5) or home bound (leg 3); 4 not at 5 failures, while its pace has not reached the slowest, through a door (via 1)
 or with a route; 7 is all, negative when not buildable.
  bgvu-at : CgGatherer, Integer -> Boolean
  bgvu-at (c) (leg) = let a = __record-set c "leg" leg in cgg-gives-up c
  bgvu-checks : Integer -> Integer
  bgvu-checks (unused) = when bb-economy 0
    is Err (_) -> -1
    is Ok (x) -> when egg-new-for x 3703 (cgg-lumber-place + 5000) (cgg-resource-of x.world 15 0) 0
      is Err (_) -> -2
      is Ok (g) -> let spot = BbSpot { x = 546, y = 2136, z = 0 }
        in let c = cgg-make-in (cw-skara (ct-table 0) (ct-city-shops 0) ct-shop-roles) g 0 spot spot 0 0 0 0
        in let a = __record-set c.walk "route" (0 - 1) in let b = __record-set c.walk "fails" cgg-give-up-fails
        in let d = __record-set c.walk "rest" (bit-shl 1 cgg-give-up-fails) in let e = __record-set c "via" 0
        in let legs = if bgvu-at c 1 & bgvu-at c 4 & bgvu-at c 6 & bgvu-at c 8 & bgvu-at c 10 then 1 else 0
        in let others = if not (bgvu-at c 2 | bgvu-at c 5 | bgvu-at c 3 | bgvu-at c 0) then 2 else 0
        in let shop = __record-set c "leg" 4
        in let early = __record-set c.walk "fails" (cgg-give-up-fails - 1) in let short = cgg-gives-up c
        in let full = __record-set c.walk "fails" cgg-give-up-fails in let pace = __record-set c.walk "rest" 32 in let rested = cgg-gives-up c
        in let paced = __record-set c.walk "rest" (bit-shl 1 cgg-give-up-fails) in let door = __record-set c "via" 1 in let through = cgg-gives-up c
        in let walked = __record-set c "via" 0 in let routed = __record-set c.walk "route" 3 in let going = cgg-gives-up c
        in let guards = if not (short | rested | through | going) then 4 else 0
        in legs + others + guards
  bvt-give-up : Integer -> [Console] Integer
  bvt-give-up (unused) = act
    n <- bgvu-checks 0
    bvt-check ("a worker gives up a failing walk out or to a shop, forge or seller, and no other leg (UOAIX-260, code " & show n & ")") (n == 7)
  end
