Chapter: BvtWorkerLeisure
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter KeeperLeisure
  cites Uoaix chapter BvtCheck

  bwl-outs : Integer, Integer, Integer -> Integer
  bwl-outs (actor) (night) (left) = if left == 0 then 0 else (if cgg-out-on actor night > 0 then 1 else 0) + bwl-outs actor (night + 1) (left - 1)
  bvt-worker-leisure : Integer -> [Console] Integer
  bvt-worker-leisure (unused) = act
    a <- bvt-check "a Britain worker goes out on two evenings in three, by its actor and the night (UOAIX-222)" (bwl-outs 7 0 30 == 20 & bwl-outs 8 5 30 == 20 & cgg-out-on 3 0 == 0 & cgg-out-on 4 0 > 0)
    b <- bvt-check "a night out is the Blue Boar (2) or the Conservatory (3), both chosen across nights" (cgg-out-on 1 1 == 2 & cgg-out-on 1 0 == 3 & kl-payee (cgg-out-on 1 1) == bb-tavern-keeper & kl-payee (cgg-out-on 1 0) == bb-musician)
    c <- bvt-check "the evening runs from game hour 20 to 22: before 20 and from 22 a worker out walks home" (not (cgg-past-leisure 20) & not (cgg-past-leisure 21) & cgg-past-leisure 22 & cgg-past-leisure 19 & cgg-past-leisure 3)
    a + b + c
  end
