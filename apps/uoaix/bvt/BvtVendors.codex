Chapter: BvtVendors
  cites Uoaix chapter GameVendorCodec
  cites Uoaix chapter BvtCheck

  bvt-vendors : Integer -> [Console] Integer
  bvt-vendors (unused) = act
    a <- bvt-check "the vendor table holds one row per Britain shop and no bank lineup copies (Damian, 2026-10-08)" (gv-vendor-limit == bb-shop-count & gv-vendor-limit /= 2 * bb-shop-count)
    b <- bvt-check "vendor rows past 16 are appended after the version 6 image" (gvsc-vendor-at 16 == gvsc-v6-bytes & gvsc-bytes == gvsc-v6-bytes + max 0 (gv-vendor-limit - 16) * gvsc-vendor-bytes)
    c <- bvt-check "rows 0 to 15 keep their version 6 offsets, so older saves still decode" (gvsc-vendor-at 0 == gvsc-vendors-at & gvsc-vendor-at 15 + gvsc-vendor-bytes == gvsc-players-at)
    a + b + c
  end