Chapter: BvtCities
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvt-cities : Integer -> [Console] Integer
  bvt-cities (unused) = let cities = ct-table 0
    in let trinsic = list-at cities 1
    in act
      a <- bvt-check "city 0 is Britain on its own window, city 1 Trinsic; Trinsic's window is 272 by 280 tiles from 1808,2640, whole 8-tile blocks holding its spawn regions with a tile beside every edge" ((list-at cities 0).name == "Britain" & (list-at cities 0).x1 == bwn-x1 & trinsic.name == "Trinsic" & ct-x trinsic == 1808 & ct-y trinsic == 2640 & ct-width trinsic == 272 & ct-height trinsic == 280 & ct-x trinsic < trinsic.x1 & ct-x trinsic + ct-width trinsic > trinsic.x2 + 1 & ct-y trinsic + ct-height trinsic > trinsic.y2 + 1)
      b <- bvt-check "a point in Trinsic's bank row is city 1, Britain's bank city 0, open sea none" (ct-city-at cities 1813 2825 0 == 1 & ct-city-at cities 1434 1690 0 == 0 & ct-city-at cities 3000 300 0 == -1)
      c <- bvt-check "a city with no loaded map answers None" ((when ct-map-of [] 1 is None -> True is Just (_) -> False) & (when ct-map-at cities [] 1813 2825 is None -> True is Just (_) -> False))
      a + b + c
    end
