Chapter: BvtBattleship
  cites Uoaix chapter ShipwrightBattleship
  cites Uoaix chapter BvtCheck

 UOAIX-178 battleship at the shipwright's: fleets, shots, the turn, a sinking, the win, the installed plans and the
 gump's buttons.
  bwar-zero : Integer -> Integer
  bwar-zero (unused) = let t = alloc-bytes swb-bytes in let z = swb-clear t 0 in t
  bwar-cells : Integer, Integer, Integer, Integer, Integer -> Integer
  bwar-cells (t) (side) (id) (cell) (n) = if cell >= 100 then n else bwar-cells t side id (cell + 1) (if (id == 0 & swb-ship t side cell > 0) | (id > 0 & swb-ship t side cell == id) then n + 1 else n)
  bwar-sizes : Integer, Integer -> Boolean
  bwar-sizes (t) (side) = bwar-cells t side 0 0 0 == 17 & bwar-cells t side 1 0 0 == 5 & bwar-cells t side 2 0 0 == 4 & bwar-cells t side 3 0 0 == 3 & bwar-cells t side 4 0 0 == 3 & bwar-cells t side 5 0 0 == 2
  bwar-first : Integer, Integer, Integer, Integer -> Integer
  bwar-first (t) (side) (id) (cell) = if cell >= 100 then -1 else if (id == 0 & swb-ship t side cell == 0) | (id > 0 & swb-ship t side cell == id) then cell else bwar-first t side id (cell + 1)
  bwar-sink : Integer, Integer, Integer, Integer -> Integer
  bwar-sink (t) (id) (cell) (last) = if cell >= 100 then last
    else if swb-ship t 1 cell /= id then bwar-sink t id (cell + 1) last
    else let turn = poke-qword t 16 2 in bwar-sink t id (cell + 1) (swb-fire t 0 cell 5)
  bwar-sink-all : Integer, Integer, Integer -> Integer
  bwar-sink-all (t) (id) (last) = if id > 5 then last else bwar-sink-all t (id + 1) (bwar-sink t id 0 last)
  bwar-count : List Integer, Integer, Integer -> Integer
  bwar-count (p) (i) (n) = if i + 8 > list-length p then n
    else bwar-count p (i + 1) (if list-at p i == 98 & list-at p (i + 1) == 117 & list-at p (i + 2) == 116 & list-at p (i + 3) == 116 & list-at p (i + 4) == 111 & list-at p (i + 5) == 110 then n + 1 else n)
  bwar-install : Integer -> Integer
  bwar-install (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (world) -> let items = gsi-new world
      in let first = swb-install items
      in let second = swb-install items
      in let navy = swb-plans world 0
      in let pirates = swb-plans world 1
      in let placed = when world-get world navy is Err (_) -> False is Ok (o) -> o.x == 1415 & o.y == 1750 & o.z == 16 & o.hue == #0059
      in first * 100 + second * 10 + (if placed & pirates /= 0 & swb-side-of world navy == 0 & swb-side-of world pirates == 1 & swb-side-of world 0 == -1 then 1 else 0)
  bvt-battleship : Integer -> [Console] Integer
  bvt-battleship (unused) = let t = bwar-zero 0
    in let r = swb-fleet t 0 (rng-new 12345) 1
    in let r2 = swb-fleet t 1 (rng-next r) 1
    in let fleets = bwar-sizes t 0 & bwar-sizes t 1
    in let opened = swb-set t 2 100 0
    in let water = bwar-first t 1 0 0
    in let miss = swb-fire t 0 water 200
    in let turned = swb-phase t == 3
    in let again = let back = poke-qword t 16 2 in swb-fire t 0 water 300
    in let ship = bwar-first t 1 5 0
    in let hit = swb-fire t 0 ship 400
    in let shots = miss == 0 & turned & again == -1 & hit == 5 & swb-phase t == 3 & swb-last t == 400
    in let sunk = let back = poke-qword t 16 2 in swb-fire t 0 (bwar-first t 1 5 (ship + 1)) 500
    in let won = bwar-sink-all t 1 0
    in let freed = swb-phase t == 0 & swb-seat t 0 == 0 & bwar-cells t 0 0 0 0 == 0
    in let g = bwar-zero 0
    in let laid = swb-fleet g 0 (rng-new 7) 1
    in let laid2 = swb-fleet g 1 (rng-new 8) 1
    in let navy = swb-set g 2 1 0
    in let mine = swb-gump g 4242 0 ""
    in let theirs = swb-gump g 4242 1 ""
    in let watcher = swb-gump g 4242 -1 ""
    in act
      a <- bvt-check "each fleet is a carrier, battleship, cruiser, submarine and destroyer, 17 squares, laid without overlap" fleets
      b <- bvt-check ("a miss answers 0 and passes the shot, a square fired on before is refused, a hit answers the ship and passes the shot: " & show miss & " " & show again & " " & show hit) shots
      c <- bvt-check ("the second hit on the destroyer sinks it (15), and sinking the whole fleet wins (20) and frees the table: " & show sunk & " " & show won) (sunk == 15 & won == 20 & freed)
      d <- bvt-check ("the gump is a 0xB0 of its own length with 100 shot buttons for the side to fire and none for the other side or a watcher: " & show (bwar-count mine 0 0) & " " & show (bwar-count theirs 0 0) & " " & show (bwar-count watcher 0 0)) (list-at mine 0 == #B0 & list-at mine 1 * 256 + list-at mine 2 == list-length mine & bwar-count mine 0 0 == 100 & bwar-count theirs 0 0 == 0 & bwar-count watcher 0 0 == 0)
      e <- bvt-check ("both plans are installed once, the Navy's at 1415,1750,16 in blue, and each double-click maps to its side: " & show (bwar-install 0)) (bwar-install 0 == 201)
      a + b + c + d + e
    end
