Chapter: BvtGift
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-gift : Integer -> [Console] Integer
  bvt-gift (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("gift economy " & e) False
    is Ok (x) -> act
      minted <- bb-founding-stock x
      npc <- eu-open x 2 3001
      town <- eu-open x 4 1
      granted <- eu-grant x True 1 town 200 0 0
      wages <- eu-pay x True town npc 200 0 0
      logged <- x.count
      wallet <- (em-purse x.copper npc).coin
      given <- cg-gift-pay x npc town 1 50
      a <- bvt-check "an NPC's purse gives 50 copper to the town purse, logged as a payment (eu-pay, currency kind 4)" (is-ok minted & npc > 1 & town > 1 & granted == 0 & wages >= 0 & given > 0 & given <= 50 & (em-purse x.copper town).coin == given & wallet >= 50 & (em-purse x.copper npc).coin == wallet - 50 & x.count == logged + 1 & (list-at x.events (x.count - 1)).kind == 4)
      held <- (em-purse x.copper npc).coin
      kept <- (em-purse x.copper town).coin
      refused <- cg-gift-pay x npc town 1 1000
      b <- bvt-check "a gift larger than the purse holds is refused and moves nothing" (refused < 0 & (em-purse x.copper npc).coin == held & (em-purse x.copper town).coin == kept)
      c <- bvt-check "the town purse cannot give to itself; donate names the metal, and an unknown word names none" (cg-gift-pay x town town 1 1 < 0 & cg-gift-metal [103,111,108,100] == 3 & cg-gift-metal [99,111,112,112,101,114] == 1 & cg-gift-metal [105,114,111,110] == 0)
      a + b + c
    end