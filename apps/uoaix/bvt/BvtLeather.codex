Chapter: BvtLeather
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvl-makes : Integer, Integer -> Boolean
  bvl-makes (leather) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1015) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 35 leather in bb-from-bought w actor item
  bvl-lists : List BbGoods, Integer, Integer -> Boolean
  bvl-lists (goods) (item) (i) = if i >= list-length goods then False else (list-at goods i).item == item | bvl-lists goods item (i + 1)
  bvt-leather : Integer -> [Console] Integer
  bvt-leather (unused) = act
    a <- bvt-check "the leatherworker is shop 16, in the fish shop (Damian, 2026-10-09), selling leather armour (44, 0x13CC) and bags (45)" (bb-shop-count >= 16 & bb-leatherworker == 15 & (list-at bb-shops 15).title == "Leatherworker" & (list-at bb-shops 15).premises == "The fish shop" & (list-at bb-shops 15).x1 == 1480 & (list-at bb-shops 15).y1 == 1664 & bvl-lists (bb-goods bb-leatherworker) 44 0 & bvl-lists (bb-goods bb-leatherworker) 45 0)
    b <- bvt-check "the bag left the provisioner's shelf, and the tailor lists no leather goods" (not (bvl-lists (bb-goods 0) 45 0) & not (bvl-lists (bb-goods 2) 44 0) & not (bvl-lists (bb-goods 2) 45 0))
    c <- bvt-check "vendor 15 opens the leatherworker's menu, buys leather and thread, buys back armour and bags" (list-at gvb-role-words 15 == "leatherworker" & gvb-role 15 == 15 & gvb-material 15 35 & gvb-material 15 36 & not (gvb-material 15 7) & gvb-goods 15 44 & gvb-goods 15 45 & gvb-item-of #13CC == 44)
    d <- bvt-check "2 bought leather make armour and 1 a bag; 1 makes no armour and none makes no bag" (bvl-makes 2 44 & bvl-makes 1 45 & not (bvl-makes 1 44) & not (bvl-makes 0 45))
    e <- bvt-check "the leatherworker works at its bench, inside its shop, on wheel key 11" (let w = csn-leatherworker 0 in let s = list-at bb-shops bb-leatherworker in w.station-a.x == wks-leather-bench.x & w.station-a.y == wks-leather-bench.y & w.mode == 1 & wks-leather-bench.x >= s.x1 & wks-leather-bench.x <= s.x2 & wks-leather-bench.y >= s.y1 & wks-leather-bench.y <= s.y2 & cgs-leatherworker == 11)
    a + b + c + d + e
  end