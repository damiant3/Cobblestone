Chapter: BvtCastBind
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter PlayRun
  cites Uoaix chapter PlayScript
  cites Uoaix chapter Decorator
  cites Uoaix chapter MapPins
  cites Uoaix chapter WritableBooks
  cites Uoaix chapter BvtCheck

  bcb-owner : Integer -> Result CompositeGame Text
  bcb-owner (z) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
 A started play's cast member has no economy actor until the growth point binds one, so an unbound cast makes growth
 due; binding clears it.
  bcb-cast : Integer -> Boolean
  bcb-cast (unused) = when bcb-owner 0
    is Err (_) -> False
    is Ok (owner) -> let idle = cg-grow-due owner
      in let running = plr-set owner.plays 1 0 plr-running
      in let cast = pls-set-count (plr-table owner.plays 1) 2 1
      in let due = cg-grow-due owner
      in let bound = cg-cast-bind owner 0 0 0
      in not idle & due & bound == 1 & cg-cast-actor owner 1 0 > 0 & not (cg-grow-due owner)
 A decorator, map-pin or book table three quarters full makes growth due.
  bcb-tables : Integer -> Boolean
  bcb-tables (unused) = when bcb-owner 0
    is Err (_) -> False
    is Ok (owner) -> let idle = cg-grow-due owner
      in let d = __record-set owner.decor "count" owner.decor.room
      in let decor = cg-grow-due owner
      in let d0 = __record-set owner.decor "count" 0
      in let p = __record-set owner.pins "count" owner.pins.room
      in let pins = cg-grow-due owner
      in let p0 = __record-set owner.pins "count" 0
      in let b = __record-set owner.books "count" owner.books.room
      in let books = cg-grow-due owner
      in let b0 = __record-set owner.books "count" 0
      in not idle & decor & pins & books & not (cg-grow-due owner)
  bvt-cast-bind : Integer -> [Console] Integer
  bvt-cast-bind (unused) = act
    a <- bvt-check "a running play's unbound cast makes growth due, and binding gives it an economy actor and clears it (cg-grow-due, cg-cast-bind)" (bcb-cast 0)
    b <- bvt-check "a full decorator, map-pin or book table makes growth due, an idle composite does not (cg-grow-due)" (bcb-tables 0)
    a + b
  end
