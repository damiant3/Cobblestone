Chapter: BvtForestLumber
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter WalkMap
  cites Uoaix chapter BvtWorkerDay
  cites Uoaix chapter BvtCheck

  bfo-land : WalkMap, Integer, Integer -> Integer
  bfo-land (map) (i) (n) = if i >= n then 0
    else let set = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0 in bfo-land map (i + 1) n
  bfo-jack : List CgGatherer, Integer -> Integer
  bfo-jack (xs) (i) = if i >= list-length xs then -1 else if (list-at xs i).gatherer.place == cgg-lumber-place then i else bfo-jack xs (i + 1)
  bfo-place : TownLive, Integer, Integer, Integer -> Integer
  bfo-place (t) (serial) (x) (y) = when world-get t.vendors.game.world serial
    is Err (_) -> -1
    is Ok (m) -> when world-update t.vendors.game.world (__record-set (__record-set (__record-set m "x" x) "y" y) "z" 0) is Err (_) -> -1 is Ok (_) -> 0
  bfo-walk : CompositeGame, CgGatherer, TownLive, Integer, Integer -> Integer
  bfo-walk (owner) (c) (t) (leg) (left) = if left == 0 | c.leg /= leg then c.leg
    else let stepped = cg-lumber-walk owner c t in bfo-walk owner c t leg (left - 1)
 UOAIX-234: answers a bit per check: 1 the forest is the fighter's route window outside every city (no tree there is a
 city tree), 2 a lumberjack bound for a forest node walks the town map to the trailhead (leg 1 targets it) and arrives
 on leg 12, 4 on the route map leg 12 reaches the node and works it (leg 2), 8 leaving the node it walks leg 13 back to
 the trailhead and turns home (leg 3 through its door), 16 a saved leg 13 loads; 31 is all, negative when not buildable.
  bfo-checks : Integer -> Integer
  bfo-checks (unused) = when bwd-founded 0
    is Err (_) -> -1
    is Ok (owner) -> when owner.town
      is None -> -2
      is Just (t) -> when owner.fighter
        is None -> -3
        is Just (f) -> let w = cgf-window
          in when walk-map-new w.x1 w.y1 (w.x2 - w.x1 + 1) (w.y2 - w.y1 + 1)
            is Err (_) -> -4
            is Ok (route) -> let landed = bfo-land route 0 (route.width * route.height)
              in let bound = cgf-route f route
              in let k = bfo-jack (cg-workers owner) 0
              in if k < 0 then -5
              else let c = list-at (cg-workers owner) k
              in let forest = cg-forest-at 1400 1480 & not (cg-forest-at 1400 1490) & not (cg-forest-at 1450 1600) & not (cg-forest-at 1000 1000)
                & not (cg-tree-in-city (ct-table 0) 15 1400 1480) & cg-tree-in-city (ct-table 0) 15 1400 1490
              in let a = tl-copy-spot c.node (BbSpot { x = 1400, y = 1480, z = 0 })
              in let b = tl-copy-spot c.shop (BbSpot { x = 1410, y = 1540, z = 0 })
              in let out = __record-set c "leg" 1
              in let via = __record-set c "via" 0
              in let aimed = (cgg-target c t).y == 1540 & cgg-afield c
              in let reached = cgg-arrive c t
              in let legs = aimed & c.leg == 12
              in let placed = bfo-place t c.serial 1410 1540
              in let worked = bfo-walk owner c t 12 400 == 2
              in let left = cgg-leave-node c t
              in let turned = c.leg == 13 & c.via == 0
              in let home = bfo-walk owner c t 13 400 == 3 & c.via == 1
              in let back = __record-set c "leg" 13
              in let buf = alloc-bytes cgg-bytes
              in let written = cgg-encode c t.vendors.game.world buf
              in let loaded = when cgg-decode c.city t.vendors buf cgg-bytes is Err (_) -> False is Ok (d) -> d.leg == 13
              in (if forest then 1 else 0) + (if legs then 2 else 0) + (if worked then 4 else 0) + (if turned & home then 8 else 0) + (if loaded then 16 else 0)
  bvt-forest-lumber : Integer -> [Console] Integer
  bvt-forest-lumber (unused) = act
    n <- bfo-checks 0
    bvt-check ("the lumberjack works the forest outside the city: trailhead, route map out and back (Damian: 'lets make the lumberjacks work the forests, not the cities'; UOAIX-234, code " & show n & ")") (n == 31)
  end
