Chapter: BvtAddContainer
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter BvtCheck

  bvt-add-container : Integer -> [Console] Integer
  bvt-add-container (unused) = act
    a <- bvt-check "an [add chest (0x0E43, 0x0E41), bag (0x0E76) or backpack (0x0E75) gets its container gump, so it opens and the pack scan can make a chest lockable (UOAIX-215)" (cp-add-gump #0E43 == #0049 & cp-add-gump #0E41 == #0049 & cp-add-gump #0E76 == #003D & cp-add-gump #0E75 == #003C)
    b <- bvt-check "an [add dagger or ingot gets no gump" (cp-add-gump #0F52 == 0 & cp-add-gump #1BF2 == 0)
    a + b
  end