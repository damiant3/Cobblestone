Chapter: BvtCityShow
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BritainProduction
  cites Uoaix chapter EconomyGatherer
  cites Uoaix chapter EconomyHarvest
  cites Uoaix chapter BvtCheck

 UOAIX-217: a city's worker at its node shows its swing as Britain's do (cg-gatherer-show, which cg-city-show runs for
 owner.city-workers). Answers a bit per check: 1 a Skara Brae lumberjack at its node (leg 2) plays its hatchet action to
 a player 4 tiles off, 2 nothing reaches a player 30 tiles off, 4 nothing shows while it walks (leg 1); 7 is all,
 negative when not buildable.
  bcs-checks : Integer -> Integer
  bcs-checks (unused) = when bb-economy 0
    is Err (_) -> -1
    is Ok (x) -> let r = cgg-resource-of x.world 15 0
      in when egg-new-for x 3702 (cgg-lumber-place + 5000) r 0
        is Err (_) -> -2
        is Ok (g) -> let spot = BbSpot { x = 546, y = 2136, z = 0 }
          in let c = cw-skara (ct-table 0) (ct-city-shops 0) ct-shop-roles
          in let w = cgg-make-in c g 0 spot spot 0 0 0 0
          in when gs-new 0
            is Err (_) -> -3
            is Ok (game) -> when world-create game.world (gs-mobile 0 546 2136 0 400 1002)
              is Err (_) -> -4
              is Ok (worker) -> when world-create game.world (gs-mobile 0 550 2140 0 400 1002)
                is Err (_) -> -4
                is Ok (near) -> when world-create game.world (gs-mobile 0 576 2136 0 400 1002)
                  is Err (_) -> -4
                  is Ok (far) -> let a = __record-set w "serial" worker
                    in let b = __record-set w "leg" 2
                    in let watched = __record-set game "active" near
                    in let shown = cg-gatherer-show game w
                    in let swing = if list-length shown >= 1 & list-at shown 0 == cbp-animation worker (gh-action w.trade.raw) then 1 else 0
                    in let away = __record-set game "active" far
                    in let unseen = if list-length (cg-gatherer-show game w) == 0 then 2 else 0
                    in let back = __record-set game "active" near
                    in let walking = __record-set w "leg" 1
                    in let still = if list-length (cg-gatherer-show game w) == 0 then 4 else 0
                    in swing + unseen + still
  bvt-city-show : Integer -> [Console] Integer
  bvt-city-show (unused) = act
    n <- bcs-checks 0
    bvt-check ("a city lumberjack at its node shows its swing to a player in range, and nothing past 18 tiles or while walking (UOAIX-217, code " & show n & ")") (n == 7)
  end
