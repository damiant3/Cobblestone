Chapter: BvtSheep
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter WorldSpawnData
  cites Uoaix chapter BvtCheck

  bvt-sheep : Integer -> [Console] Integer
  bvt-sheep (unused) = let c = wsd-catalog 0
    in let p = cg-pasture c
    in let r = list-at p.regions (list-length p.regions - 1)
    in let choice = list-at (list-at p.groups r.group).choices 0
    in let sheep = list-at p.profiles choice.profile
    in let bare = cg-pasture (WsCatalog { revision = c.revision, profiles = [], groups = c.groups, regions = c.regions })
    in let none = list-at (list-at bare.groups (list-length bare.groups - 1)).choices 0
    in act
      a <- bvt-check "the pasture is a spawn region of four sheep, so the flock is named and wanders inside it (row 28)" (r.name == "Pasture" & r.maximum == 4 & r.batch == 4 & r.area.x1 == 1408 & r.area.y1 == 1640 & r.area.x2 == 1415 & r.area.y2 == 1659)
      b <- bvt-check "the pasture's choice is the catalog's sheep, named a sheep, body 0xCF" (sheep.key == "sheep" & sheep.name == "a sheep" & sheep.body == 207 & gws-supported sheep)
      c2 <- bvt-check "the pasture changes the catalog revision, so an older spawn save retires" (p.revision /= c.revision & list-length p.regions == list-length c.regions + 1)
      d <- bvt-check "a catalog with no sheep profile gives the pasture no creature" (none.profile == 0 - 1)
      a + b + c2 + d
    end
