Chapter: BvtMicrosOverflow
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter BvtCheck

  bvt-micros-overflow : Integer -> [Console] Integer
  bvt-micros-overflow (unused) = act
    a <- bvt-check "the HPET count live 46874 trapped on (9223843169014 ticks at 14317646 Hz, 7.45 days up) converts without passing 2^63: 644229 s and 28222 us (UOAIX-288)" (cs-micros-at 9223843169014 14317646 == 644229028222)
    b <- bvt-check "one second of ticks is exactly 1000000 us and half a second 500000 (UOAIX-288)" (cs-micros-at 14317646 14317646 == 1000000 & cs-micros-at 7158823 14317646 == 500000)
    c <- bvt-check "a 30-day count stays positive and exact to the second (UOAIX-288)" (cs-micros-at (14317646 * 2592000) 14317646 == 2592000000000)
    a + b + c
  end
