Chapter: BvtJailContext
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter CompositeSkillCommand
  cites Uoaix chapter BvtCheck

  bvt-jailctx-answer : Integer -> List Integer
  bvt-jailctx-answer (context) = gp-zeros (list-push (gp-put32 [#6C, 0] (cp-cursor-tag + context)) 0) 12
  bvt-jailctx-jails : Integer -> Boolean
  bvt-jailctx-jails (context) = cp-jail-target (bvt-jailctx-answer context)
  bvt-jailctx : Integer -> [Console] Integer
  bvt-jailctx (unused) =
    let attr = cat-context (CskRequest { skill = 0, value = 60, target = True })
    in let top = cat-base + 6 * 256 + 255
    in let skill = csk-context (CskRequest { skill = 45, value = 1000, target = True })
    in let freed = list-length (bvt-jailctx-answer attr) == 19 & not (bvt-jailctx-jails attr) & not (bvt-jailctx-jails top) & not (bvt-jailctx-jails skill)
    in let jails = bvt-jailctx-jails (cp-jail-context + 1) & bvt-jailctx-jails (cp-jail-context + 8760)
    in let others = not (bvt-jailctx-jails 8) & not (bvt-jailctx-jails (cp-jail-context + 8761))
    in act
      a <- bvt-check "an [attr target answer and a [skill target answer past skill 32 are no jail order" freed
      b <- bvt-check "a [jail answer of 1 and of 8760 hours is a jail order; the kick answer and one past 8760 hours are not" (jails & others)
      a + b
    end
