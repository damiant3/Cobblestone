Chapter: BvtCoinDeposit
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter EconomyCurrencyValid
  cites Uoaix chapter BvtSealLoans
  cites Uoaix chapter BvtCheck

 D-10: carried coin enters a purse as a currency deposit (kind 16: a crown decree, then a payout). On the Britain
 economy with shop 1001's actor: 1 a deposit of 5 copper and 2 gold raises the purse by exactly that, 2 the currency
 validates after it (the replay applies kind 16), 4 a deposit to the treasury and one to another actor's purse are
 refused; -1 a fixture that failed.
  bcd-run : EuCurrency -> Integer
  bcd-run (x) = let opened = bsl-open x
    in let actor = cg-label-actor x 1001
    in let other = cg-label-actor x 1002
    in if actor < 1 | other < 1 then -1
    else let purse = (ep-actor x.world actor).purse
    in let c0 = (em-purse x.copper purse).coin
    in let g0 = (em-purse x.world.money purse).coin
    in let done = eu-deposit x actor purse 5 0 2
    in let raised = if done == 0 & (em-purse x.copper purse).coin == c0 + 5 & (em-purse x.world.money purse).coin == g0 + 2 then 1 else 0
    in let valid = if euv-valid x then 2 else 0
    in let refused = if eu-deposit x actor 1 5 0 0 < 0 & eu-deposit x actor (ep-actor x.world other).purse 5 0 0 < 0 then 4 else 0
    in raised + valid + refused
  bvt-coin-deposit : Integer -> [Console] Integer
  bvt-coin-deposit (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("coin deposit fixture: " & e) False
    is Ok (x) -> act
      n <- bcd-run x
      a <- bvt-check ("D-10: carried coin deposits into the purse as a replayable currency event (code " & show n & ")") (n == 7)
      a
    end
