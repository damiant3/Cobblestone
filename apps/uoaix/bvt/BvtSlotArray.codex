Chapter: BvtSlotArray
  cites Uoaix chapter SlotArray
  cites Uoaix chapter BvtCheck

  bsa-write : Integer, Integer, Integer -> Integer
  bsa-write (block) (i) (stop) = if i >= stop then 0 else let w = poke-qword (sa-at block i) 0 (i * 3 + 1) in bsa-write block (i + 1) stop
  bsa-reads : Integer, Integer, Integer -> Boolean
  bsa-reads (block) (i) (stop) = if i >= stop then True else peek-qword (sa-at block i) 0 == i * 3 + 1 & bsa-reads block (i + 1) stop
  bsa-zero : Integer, Integer, Integer -> Boolean
  bsa-zero (block) (i) (stop) = if i >= stop then True else peek-qword (sa-at block i) 0 == 0 & peek-qword (sa-at block i) 8 == 0 & bsa-zero block (i + 1) stop
 An array of 100 entries of 16 bytes grows to 300: the first 100 keep their values and addresses, the new 200 are zero.
  bsa-grows : Integer -> Boolean
  bsa-grows (unused) = let a = sa-new 16 100
    in let written = bsa-write a 0 100
    in let first = sa-at a 0
    in let grown = sa-grow a 300
    in a /= 0 & grown == 0 & sa-capacity a == 300 & sa-at a 0 == first & bsa-reads a 0 100 & bsa-zero a 100 300
  bsa-ceiling : Integer -> Boolean
  bsa-ceiling (unused) = let a = sa-new 8 16
    in sa-grow a (wi-pages * 256 + 1) == -1 & sa-capacity a == 16 & sa-grow a 8 == 0 & sa-capacity a == 16
  bvt-slot-array : Integer -> [Console] Integer
  bvt-slot-array (unused) = act
    a <- bvt-check "a slot array of 100 entries grows to 300: old entries keep values and addresses, new ones are zero" (bsa-grows 0)
    b <- bvt-check "a slot array refuses to grow past wi-pages * 256 entries and never shrinks" (bsa-ceiling 0)
    a + b
  end
