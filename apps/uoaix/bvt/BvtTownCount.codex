Chapter: BvtTownCount
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-town-made : WorldTable, Integer, Integer -> List Integer
  bvt-town-made (world) (left) (health) = if left == 0 then []
    else let made = when world-create world (__record-set (gs-mobile 0 1430 1690 0 400 1002) "health" health) is Ok (s) -> [s] is Err (_) -> []
    in made & bvt-town-made world (left - 1) health
  bvt-town-count : Integer -> [Console] Integer
  bvt-town-count (unused) = when world-new 64
    is Err (e) -> bvt-check ("town count fixture world: " & e) False
    is Ok (world) -> act
      shops <- bvt-town-made world 16 50
      dead <- bvt-town-made world 1 0
      a <- bvt-check "sixteen shopkeeper rows, eight of them lineup copies, count eight living shopkeepers (admin panel, live 40204)" (cg-living-count world (cg-first-serials shops 8 0 []) 0 0 == 8)
      b <- bvt-check "a dead mobile and a serial nobody holds count as no living person" (cg-living-count world (dead & [999999]) 0 0 == 0)
      a + b
    end
