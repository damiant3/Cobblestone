Chapter: BvtChessTrough
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 UOAIX-230: a captured chess piece moves to its captor's trough of the board gump, off every square, the next one 10
 px lower; a piece on another square stays.
  bcht-piece : WorldTable, Integer, TchSet, Integer, Integer -> Integer
  bcht-piece (world) (board) (s) (art) (sq) = when world-create world (WorldObject { serial = 0, kind = 2, x = tch-at-x s sq, y = tch-at-y s art sq, z = 0, graphic = art, hue = 0, container = board, amount = 1, health = 0 })
    is Err (_) -> 0
    is Ok (serial) -> serial
  bcht-at : WorldTable, Integer -> WorldObject
  bcht-at (world) (serial) = when world-get world serial
    is Err (_) -> WorldObject { serial = 0, kind = 0, x = -1, y = -1, z = 0, graphic = 0, hue = 0, container = 0, amount = 0, health = 0 }
    is Ok (o) -> o
  bvt-chess-trough : Integer -> [Console] Integer
  bvt-chess-trough (unused) = when gs-new 0
    is Err (e) -> bvt-check ("chess trough fixture shard: " & e) False
    is Ok (shard) -> let world = shard.world
      in let s = tch-set 1497 1693 24 True
      in let board = when world-create world (WorldObject { serial = 0, kind = 2, x = 100, y = 100, z = 0, graphic = tch-board-art, hue = 0, container = 0, amount = 1, health = 0 }) is Err (_) -> 0 is Ok (b) -> b
      in let pawn = bcht-piece world board s (tch-art 1 1) 20
      in let rook = bcht-piece world board s (tch-art 4 1) 28
      in let bishop = bcht-piece world board s (tch-art 3 1) 36
      in let first = tch-take world s (world-first-child world board) 20 0 []
      in let second = tch-take world s (world-first-child world board) 28 0 []
      in let p = bcht-at world pawn
      in let r = bcht-at world rook
      in let b = bcht-at world bishop
      in act
        a <- bvt-check ("a captured Black piece moves to the right trough (x 252) off every square, the next 10 px lower: " & show p.x & "," & show p.y & " " & show r.x & "," & show r.y) (board /= 0 & p.x == 252 & p.y == 5 & r.x == 252 & r.y == 15 & tch-square s p.graphic p.x p.y == -1 & tch-square s r.graphic r.x r.y == -1 & list-length first == 1 & list-length second == 1)
        c <- bvt-check "a piece on another square stays, and a White piece's trough is the left (x 10)" (tch-square s b.graphic b.x b.y == 36 & tch-trough-x 0 == 10 & tch-square s (tch-art 1 0) 10 5 == -1)
        a + c
      end
