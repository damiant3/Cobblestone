Chapter: BvtTradeNest
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  btn-made : Result Integer Text -> Integer
  btn-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  btn-bag : WorldTable, Integer, Integer, Integer -> Integer
  btn-bag (w) (x) (y) (container) = btn-made (world-create w (WorldObject { serial = 0, kind = 2, x = x, y = y, z = 0, graphic = #0E75, hue = 0, container = container, amount = 1, health = 1 }))
  btn-checks : Integer -> Integer
  btn-checks (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (w) -> let box = btn-bag w 1500 1600 0
      in let pouch = btn-bag w 0 0 box
      in let inner = btn-bag w 0 0 pouch
      in let deep = btn-bag w 0 0 (btn-bag w 0 0 (btn-bag w 0 0 inner))
      in let apart = btn-bag w 1501 1600 0
      in let is-box = \c -> c == box
      in (if cg-box-ancestor w is-box box cg-trade-depth then 1 else 0) + (if cg-box-ancestor w is-box pouch cg-trade-depth then 2 else 0)
        + (if cg-box-ancestor w is-box inner cg-trade-depth then 4 else 0) + (if cg-box-ancestor w is-box apart cg-trade-depth then 0 else 8)
        + (if cg-box-ancestor w is-box deep cg-trade-depth then 0 else 16)
  bvt-trade-nest : Integer -> [Console] Integer
  bvt-trade-nest (unused) = act
    n <- btn-checks 0
    bvt-check ("a lift from a bag inside a trade box, as deep as the offer counts coin, is a change to the offer; a bag elsewhere or past that depth is not (red, UOAIX audit 2026-10-18; code " & show n & ", 31 is all)") (n == 31)
  end
