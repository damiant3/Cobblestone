Chapter: BvtShopOperator
  cites Uoaix chapter TownWorks
  cites Uoaix chapter TownGovernment
  cites Uoaix chapter Townsfolk
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

 UOAIX-117 essential workplaces: a Britain shop's purse is owned 1000 + index, never a person id. Skill 5 is what
 tw-skill asks of a kind 2 station. The answer is 10 for operable by the default resolver plus 1 for operable by a
 resolver naming the bound shopkeeper; -9 is a fixture that did not build.
  bvso-run : Integer -> Integer
  bvso-run (unused) = when bb-economy 0
    is Err (_) -> -9
    is Ok (x) -> let w = x.world
      in let people = tf-new 0
      in let town = tf-add-town people "Britain" 100 101 102
      in let keeper = tf-add-person people "Britain Shopkeeper" 1 1001 100 0 9000
      in let actor = ep-admit w (eu-open x 2 1001) 100
      in if town /= 1 | keeper < 1 | actor < 1 then -9
      else let skilled = ep-add (ep-actor w actor).skills 5 100
      in let t = tw-new (tg-new people w)
      in let by-purse = if tw-operable t actor 5 then 10 else 0
      in let bound = __record-set t "operator" (\a -> if a == actor then keeper else 0)
      in by-purse + (if tw-operable t actor 5 then 1 else 0)
  bvt-shop-operator : Integer -> [Console] Integer
  bvt-shop-operator (unused) = act
    r <- bvso-run 0
    a <- bvt-check ("a shop purse owner (1000 + index) is not read as a townsfolk operator: " & show r) (r >= 0 & r < 10)
    b <- bvt-check ("a shop actor resolved to its bound live adult shopkeeper is operable: " & show r) (r == 1)
    a + b
  end
