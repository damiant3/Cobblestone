Chapter: BvtReap
  cites Uoaix chapter EconomyHarvest
  cites Uoaix chapter BvtCheck

  bvt-reap-kind : Integer -> Boolean
  bvt-reap-kind (resource) = let c = eg-standard 0 in eh-reaped c (list-at c.resources (resource - 1))
  bvt-reap : Integer -> [Console] Integer
  bvt-reap (unused) = act
    a <- bvt-check "a food or reagent reap at Farming 0 yields 10" (eh-reap-yield 0 == 10)
    b <- bvt-check "a food or reagent reap at Farming 50 yields 25" (eh-reap-yield 500 == 25)
    c <- bvt-check "a food or reagent reap at Farming 100 yields 40, never more" (eh-reap-yield 1000 == 40 & eh-reap-yield 1200 == 40)
    d <- bvt-check "wheat (food) and ginseng (reagent) are reaped by the Farming yield" (bvt-reap-kind 13 & bvt-reap-kind 17)
    e <- bvt-check "cotton (fibre) and stone (ground 0) keep their own yield" (not (bvt-reap-kind 10) & not (bvt-reap-kind 1))
    a + b + c + d + e
  end