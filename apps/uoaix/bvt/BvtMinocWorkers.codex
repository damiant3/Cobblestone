Chapter: BvtMinocWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtVesperWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-minoc-workers : Integer -> [Console] Integer
  bvt-minoc-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-minoc (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-fishmonger == s + bvv-k shops "Minoc river bridge" 0 & cw-vendor c 1 == s + bvv-k shops "The Forgery" 0 & bvv-k shops "The Forgery" 0 >= 0
    a <- bvt-check "Minoc's fisherman sells at the river bridge and its ore goes to The Forgery (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-fish-place & cw-wants c (cgg-place + 1)
    unwanted <- cw-wants c cgg-farm-place | cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place | cw-wants c cgg-herb-farm
    b <- bvt-check "Minoc founds a fisherman and miners on its eastern mountain, and no field farmer, shepherd, lumberjack or herb farmer" (wanted & not unwanted)
    door <- cw-door 13
    d <- bvt-check "Minoc (city 13) builds a worker city whose lodging door is 2496,379" (is-just (cw-city (ct-table 0) shops ct-shop-roles 13) & door.x == 2496 & door.y == 379)
    a + b + d
  end
