Chapter: BvtBowyer
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvb-makes : Integer, Integer -> Boolean
  bvb-makes (boards) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1013) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 38 boards in bb-from-bought w actor item
  bvt-bowyer : Integer -> [Console] Integer
  bvt-bowyer (unused) = act
    a <- bvt-check "the bowyer is shop 14, in Quality Fletching, selling bows (48, 0x13B2)" (bb-shop-count >= 14 & bb-bowyer == 13 & (list-at bb-shops 13).title == "Bowyer" & (list-at bb-shops 13).premises == "Quality Fletching" & (list-at (bb-goods bb-bowyer) 0).item == 48 & (list-at (bb-goods bb-bowyer) 0).graphic == #13B2)
    b <- bvt-check "vendor 13 opens the bowyer's menu, buys boards and thread, and buys back bows by their art" (list-at gvb-role-words 13 == "bowyer" & gvb-role 13 == 13 & gvb-material 13 38 & gvb-material 13 36 & not (gvb-material 13 15) & gvb-goods 13 48 & gvb-item-of #13B2 == 48)
    c <- bvt-check "the bowyer works at its bench, inside its shop" (let w = csn-bowyer 0 in let s = list-at bb-shops bb-bowyer in w.station-a.x == wks-bow-bench.x & w.station-a.y == wks-bow-bench.y & w.mode == 1 & wks-bow-bench.x >= s.x1 & wks-bow-bench.x <= s.x2 & wks-bow-bench.y >= s.y1 & wks-bow-bench.y <= s.y2)
    d <- bvt-check "2 bought boards make a bow; 1 board makes none" (bvb-makes 2 48 & not (bvb-makes 1 48) & not (bvb-makes 0 48))
    e <- bvt-check "the bowyer's station is armed on the wheel as key 9, past the townsfolk walk" (cgs-bowyer == 9 & cgs-bowyer > cgs-town)
    a + b + c + d + e
  end
