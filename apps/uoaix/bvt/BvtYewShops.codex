Chapter: BvtYewShops
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

 Yew's 14 shops follow the cities appended before it; the first is the baker of The Jolly Baker.
  byws-first : List BbShop, Integer -> Integer
  byws-first (shops) (k) = if k >= list-length shops then -1 else if (list-at shops k).premises == "The Jolly Baker" then k else byws-first shops (k + 1)
  byws-inside : List CtCity, List BbShop, Integer, Integer, Integer -> Boolean
  byws-inside (cities) (shops) (city) (k) (last) = if k > last then True
    else let s = list-at shops k
    in ct-city-at cities s.x1 s.y1 0 == city & ct-city-at cities s.x2 s.y2 0 == city & byws-inside cities shops city (k + 1) last
  bvt-yew-shops : Integer -> [Console] Integer
  bvt-yew-shops (unused) = let cities = ct-table 0
    in let shops = ct-city-shops 0
    in let yew = ct-city-at cities 546 992 0
    in let k = byws-first shops 0
    in act
      a <- bvt-check "Yew's 14 shops (two bakers, three healers, the abbey's inn, two scribes and herbalist, carpenter, two bowyers, tanner, leatherworker) each keep their keeper inside Yew; the healer at 329,1243 lies outside the window and is not a shop (UOAIX-217)" (k >= 0 & list-length shops >= k + 14 & (list-at shops (k + 13)).title == "Leatherworker" & byws-inside cities shops yew k (k + 13) & ct-city-at cities 329 1243 0 /= yew)
      b <- bvt-check "a Yew vendor sells as its Britain role: the baker as 3, the abbey innkeeper as 5, the leatherworker as 15" (k >= 0 & ct-vendor-role (bb-shop-count + k) == 3 & ct-vendor-role (bb-shop-count + k + 5) == 5 & ct-vendor-role (bb-shop-count + k + 13) == 15 & list-length ct-shop-roles == list-length shops)
      a + b
    end
