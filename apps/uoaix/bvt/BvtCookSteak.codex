Chapter: BvtCookSteak
  cites Uoaix chapter GameCooking
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvt-cook-steak : Integer -> [Console] Integer
  bvt-cook-steak (unused) = act
    a <- bvt-check "a raw fish steak bought from the fishmonger (art 0x097A, item 127) is a cookable lot, as a fish lot (9) still is, and cooked food (50) is not (UOAIX-87; cooking refused 127 with 'That item has no use action.', soak 43961)" (gvb-item-of #097A == 127 & gco-raw-item 127 & gco-raw-item 9 & not (gco-raw-item 50) & not (gco-raw-item 0))
    a
  end
