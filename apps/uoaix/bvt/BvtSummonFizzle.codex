Chapter: BvtSummonFizzle
  cites Uoaix chapter BvtDispelVortex
  cites Uoaix chapter BvtCheck

  bsz-refuse : Integer, Text, Integer, Integer, Integer, Boolean, Integer -> Integer
  bsz-refuse (caster) (key) (x) (y) (z) (controlled) (ms) = 0
 UOAIX-211: answers 1 when a summon the world refuses on open land says "The spell fizzles.", plus 2 when one aimed
 off the map still says "That location is blocked."; negative when not buildable.
  bsz-checks : Integer -> Integer
  bsz-checks (unused) = when bdv-env 0
    is Err (_) -> -1
    is Ok (env) -> when world-get env.game.world 1
      is Err (_) -> -2
      is Ok (source) -> let hooked = __record-set env.magic "summon-hook" bsz-refuse
        in let fizzle = list-length (sip-message source.serial source.graphic 6 "The spell fizzles.")
        in let blocked = list-length (sip-message source.serial source.graphic 6 "That location is blocked.")
        in let open = when mga-summon env.magic env.game source (mga-point 1425 1698 0) 33 is Err (_) -> 0 is Ok (ps) -> if list-length ps == 1 then list-length (list-at ps 0) else 0
        in let off = when mga-summon env.magic env.game source (mga-point 1000 1000 0) 33 is Err (_) -> 0 is Ok (ps) -> if list-length ps == 1 then list-length (list-at ps 0) else 0
        in (if open == fizzle then 1 else 0) + (if off == blocked then 2 else 0)
  bvt-summon-fizzle : Integer -> [Console] Integer
  bvt-summon-fizzle (unused) = act
    n <- bsz-checks 0
    bvt-check ("a summon the world refuses fizzles; only a blocked spot says the location is blocked (UOAIX-211 L-BAILVALUE, code " & show n & ")") (n == 3)
  end
