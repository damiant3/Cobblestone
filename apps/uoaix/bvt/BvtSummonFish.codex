Chapter: BvtSummonFish
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter GameCarve
  cites Uoaix chapter BvtCheck

  bvt-summon-fish : Integer -> [Console] Integer
  bvt-summon-fish (unused) = act
    a <- bvt-check "every fish art a blade slices (0x09CC to 0x09CF, gca-fish-art) is fish (9), so a summoned fish becomes a lot the carve accepts (UOAIX-35; trial 50056: SUMMON 0x9CC item=0 lot=no, 'You can't use material outside your backpack.')" (cp-add-item #09CC == 9 & cp-add-item #09CF == 9 & cp-add-stacks #09CC & gca-fish-art #09CD)
    b <- bvt-check "the arts beside the fish keep their items: 0x09D0 is no fish, a raw fish steak (0x097A) stays 127 (UOAIX-35)" (cp-add-item #09D0 /= 9 & cp-add-item #09CB /= 9 & cp-add-item #097A == 127)
    a + b
  end
