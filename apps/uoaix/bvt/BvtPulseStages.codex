Chapter: BvtPulseStages
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bps2-inside : List Integer, Integer -> Boolean
  bps2-inside (xs) (i) = if i >= list-length xs then True else list-at xs i >= 0 & list-at xs i < cg-stage-count & bps2-inside xs (i + 1)
  bvt-pulse-stages : Integer -> [Console] Integer
  bvt-pulse-stages (unused) = act
    ok <- list-length cs-stage-order == list-length cs-stage-names & bps2-inside cs-stage-order 0 & list-at cs-stage-names 3 == "timers" & list-at cs-stage-order 3 == 13 & list-at cs-stage-names 4 == "views" & list-at cs-stage-order 4 == 14
    bvt-check "WORLD PULSE names the timer wheel and the views apart from the rest of the base, every stamp inside the stage buffer (red, UOAIX-267)" ok
  end
