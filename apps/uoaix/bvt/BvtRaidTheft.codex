Chapter: BvtRaidTheft
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  brt-owner : Integer -> Result CompositeGame Text
  brt-owner (z) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
  brt-spawns : CompositeGame -> Result GameWorldSpawn Text
  brt-spawns (owner) = when owner.spawns
    is Just (g) -> Ok g
    is None -> when cg-spawn-attach owner
      is Err (e) -> Err e
      is Ok (_) -> when owner.spawns is None -> Err "no spawns" is Just (g) -> Ok g
 One unit moves from the shop to a raider whose actor is thief (0 for none); answers the units taken, or -1 when the
 scenario cannot be built (no shop lot, no mobile), and checks the census for a move rather than a loss.
  brt-raid : Boolean -> Integer
  brt-raid (bound) = when brt-owner 0
    is Err (_) -> -1
    is Ok (owner) -> when brt-spawns owner
      is Err (_) -> -1
      is Ok (g) -> let w = owner.vendor.currency.world
        in let shop = (list-at owner.vendor.vendors 0).actor
        in let thief = if bound then (list-at g.slots 0).actor else 0
        in let at = cg-first-lot w.goods shop 0
        in if at < 0 then -1
        else let item = (ep-lot w.goods at).item
        in let consumed = ep-at w.consumed item
        in let held = ep-at (ep-actor w shop).stock item
        in let had = if thief > 0 then ep-at (ep-actor w thief).stock item else 0
        in when world-create owner.checkpoint.game.world (gs-mobile 0 1000 1000 0 400 1002)
          is Err (_) -> -1
          is Ok (raider) -> let took = cg-steal-one owner shop raider thief
            in if ep-at w.consumed item /= consumed then -2
            else if took == 1 then (if thief < 1 then -3 else if ep-at (ep-actor w shop).stock item /= held - 1 then -3 else if ep-at (ep-actor w thief).stock item /= had + 1 then -3 else 1)
            else if ep-at (ep-actor w shop).stock item /= held then -4
            else took
  bvt-raid-theft : Integer -> [Console] Integer
  bvt-raid-theft (unused) = act
    a <- bvt-check "a raider carries a shop's unit off to its own actor: the shop holds one fewer, the raider one more, nothing consumed (UOAIX-140 b)" (brt-raid True == 1)
    b <- bvt-check "a raider with no economy actor takes nothing and the shop keeps its stock" (brt-raid False == 0)
    a + b
  end
