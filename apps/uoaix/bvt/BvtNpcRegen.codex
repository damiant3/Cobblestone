Chapter: BvtNpcRegen
  cites Uoaix chapter GameCombat
  cites Uoaix chapter WorldTimers
  cites Uoaix chapter BvtCheck

  bvt-npc-regen : Integer -> [Console] Integer
  bvt-npc-regen (unused) = act
    c <- cb-state 4 1
    clock <- (when wtm-new 64 64 0 is Err (_) -> 0 is Ok (w) -> let wheeled = __record-set c "wheel" (Just w) in 1)
    beast <- list-at c.actors 0
    named <- __record-set beast "serial" 77
    wild <- __record-set beast "npc" True
    first <- cb-regen-npc c beast
    again <- cb-regen-npc c beast
    a <- bvt-check "UOAIX-184: a wounded creature is armed to regenerate on the wheel, once" (clock == 1 & first == 1 & beast.armed & beast.regen == c.tick + cb-regen-ticks 0 & again == 0)
    hero <- list-at c.actors 1
    tamed <- __record-set hero "npc" False
    b <- bvt-check "UOAIX-184: a player is not armed by a blow (its own pulse arms it)" (cb-regen-npc c hero == 0 & not hero.armed)
    a + b
  end
