Chapter: BvtTavernKeeper
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BritainShopHours
  cites Uoaix chapter BritainWindow
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter GameNpcSpeech
  cites Uoaix chapter BvtCheck

  btk-makes : Integer, Integer -> Boolean
  btk-makes (grapes) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1018) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 78 grapes in bb-from-bought w actor item
  btk-recipe : Integer -> Boolean
  btk-recipe (unused) = let c = bb-catalog 0 in let k = bb-recipe-from c 152 78 0
    in k > 0 & (list-at c.recipes (k - 1)).quantity == 1 & (list-at c.recipes (k - 1)).one-count == 4 & (list-at c.recipes (k - 1)).station == 6 & (list-at c.recipes (k - 1)).tool == 0
  btk-at : Integer -> Integer
  btk-at (hour) = hour * 3600 + 86400
  bvt-tavern-keeper : Integer -> [Console] Integer
  bvt-tavern-keeper (unused) = let s = list-at bb-shops bb-tavern-keeper in let g = bb-goods bb-tavern-keeper in act
    a <- bvt-check "the tavern keeper is shop 19 at the Blue Boar's north end, selling wine (152, 0x09C7), bread and cooked food (UOAIX-222)" (bb-shop-count >= 19 & bb-tavern-keeper == 18 & s.title == "Tavern keeper" & s.premises == "The Blue Boar" & s.x1 >= 1494 & s.x2 <= 1500 & s.y1 >= 1676 & s.y2 <= 1696 & list-length g == 3 & (list-at g 0).item == 152 & (list-at g 0).graphic == #09C7 & (list-at g 1).item == 34 & (list-at g 2).item == 50 & (list-at (bb-catalog 0).items 151).name == "wine")
    b <- bvt-check "4 grapes make 1 wine at the cooking station, toolless" (btk-recipe 0)
    c <- bvt-check "the tavern makes wine only from 4 grapes it holds, never from 3 or none, and makes no grapes" (btk-makes 4 152 & not (btk-makes 3 152) & not (btk-makes 0 152))
    d <- bvt-check "the tavern founds empty and buys its goods, as the blacksmith does; the fishmonger does not" (bb-participant bb-tavern-keeper & bb-participant 1 & not (bb-participant bb-fishmonger))
    e <- bvt-check "vendor 18 opens the tavern keeper's menu, buys grapes, buys back wine by its art" (list-at gvb-role-words 18 == "tavern keeper" & list-length gvb-role-words == bb-shop-count & gvb-role 18 == 18 & gvb-material 18 78 & not (gvb-material 18 34) & gvb-goods 18 152 & gvb-item-of #09C7 == 152 & ns-role 18 == "tavern keeper")
    f <- bvt-check "the Blue Boar never closes (Damian, 2026-10-10): open at 3, 11, 12 and 21 with its keeper at work; at hour 21 the baker is closed and drinks at the Boar; at 10 only the musician is closed" (bsh-shop-open bb-tavern-keeper (btk-at 12) & bsh-shop-open bb-tavern-keeper (btk-at 21) & bsh-shop-open bb-tavern-keeper (btk-at 3) & bsh-shop-open bb-tavern-keeper (btk-at 11) & bit-and (bsh-mask (btk-at 21)) (bit-shl 1 bb-tavern-keeper) == 0 & bit-and (bsh-mask (btk-at 21)) 8 == 8 & bit-and (bsh-mask (btk-at 3)) (bit-shl 1 bb-tavern-keeper) == 0 & bsh-mask (btk-at 10) == bit-shl 1 bb-musician & bsh-goal bb-tavern-keeper (btk-at 21) == 1 & bsh-goal bb-tavern-keeper (btk-at 3) == 1 & bsh-goal 3 (btk-at 21) == 2)
    g <- bvt-check "the healer (4) and the innkeeper (5) trade at every hour with their keepers at work, and at 3am every other shop is closed, the blacksmith's keeper at home" (bsh-shop-open 4 (btk-at 3) & bsh-shop-open 5 (btk-at 3) & bsh-shop-open 4 (btk-at 21) & bsh-goal 4 (btk-at 3) == 1 & bsh-goal 5 (btk-at 3) == 1 & bsh-goal 4 (btk-at 21) == 1 & bsh-mask (btk-at 3) == bit-shl 1 bb-shop-count - 1 - bit-shl 1 4 - bit-shl 1 5 - bit-shl 1 bb-tavern-keeper & not (bsh-shop-open 1 (btk-at 3)) & bsh-goal 1 (btk-at 3) == 0)
    h <- bvt-check "the Britain walk window holds the Blue Boar, so its keeper is placed and walked" (s.x1 > bwn-x1 & s.x2 < bwn-x2 & s.y1 > bwn-y1 & s.y2 < bwn-y2)
    a + b + c + d + e + f + g + h
  end
