Chapter: BvtMarked
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvt-marked : Integer -> [Console] Integer
  bvt-marked (unused) = act
    a <- bvt-check "weapons and armour are marked: broadsword, platemail, leather armour, bow, dagger, longsword, gorget" (gvb-marked 40 & gvb-marked 41 & gvb-marked 44 & gvb-marked 48 & gvb-marked 69 & gvb-marked 70 & gvb-marked 71)
    b <- bvt-check "commodities are not marked: ore, ingots, logs, apples, cloth, arrows, fish" (not (gvb-marked 5) & not (gvb-marked 31) & not (gvb-marked 15) & not (gvb-marked 16) & not (gvb-marked 37) & not (gvb-marked 49) & not (gvb-marked 9))
    a + b
  end