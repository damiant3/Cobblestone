Chapter: BvtYewOrc
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter GameHarvestState
  cites Uoaix chapter BvtCheck

  bvt-yew-orc : Integer -> [Console] Integer
  bvt-yew-orc (unused) = act
    a <- bvt-check "a swing at a yew tree (0x12B6..0x12C7) by a lumberjack below grand master raises an orc" (cg-yew-due 15 #12B6 0 & cg-yew-due 15 #12C7 999)
    b <- bvt-check "no orc for a grand master, another tree, the arts past the yew range, or a non-timber swing" (not (cg-yew-due 15 #12B6 1000) & not (cg-yew-due 15 #0CCA 0) & not (cg-yew-due 15 #12B5 0) & not (cg-yew-due 15 #12C8 0) & not (cg-yew-due 9 #12B6 0))
    c <- bvt-check "a harvest state swings to no one until the composite binds its hook" (gh-swing-none 1 15 #12B6 0 0 == 0)
    a + b + c
  end
