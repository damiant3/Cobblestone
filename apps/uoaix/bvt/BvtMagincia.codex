Chapter: BvtMagincia
  cites Uoaix chapter GameMagery
  cites Uoaix chapter GameNpcSpeech
  cites Uoaix chapter NpcLines
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

 D-18 (Damian, 2026-10-13): Magincia island suppresses all magic, and its people speak of their town and the mystery.
  bmg-magincian : Text -> Boolean
  bmg-magincian (line) = text-contains line "Magincia" | text-contains line "magic"
  bvt-magincia : Integer -> [Console] Integer
  bvt-magincia (unused) = let lib = nl-library 0
    in act
      a <- bvt-check "no spell begins on Magincia island (the town and its shore); Ocllo to the south, Britain and the island's sea edge beyond the box are outside the field" (mg-suppressed 3700 2200 & mg-suppressed 3600 2050 & not (mg-suppressed 3650 2550) & not (mg-suppressed 1475 1645) & not (mg-suppressed 3831 2200))
      b <- bvt-check "a speaker standing in Magincia speaks Magincia's lines; one in Britain or outside every city keeps the town's name" (ns-city-at (ct-table 0) 3700 2200 1 "Britain" == "Magincia" & ns-city-at (ct-table 0) 1475 1645 1 "Britain" == "Britain" & ns-city-at (ct-table 0) 100 100 1 "Britain" == "Britain")
      c <- bvt-check "Magincia's townsfolk and keepers have their own greeting, and townsfolk their news of the failing magic" (bmg-magincian (nl-pick lib 3 "Magincia" "" 0 nl-any nl-any 0) & bmg-magincian (nl-pick lib 3 "Magincia" "" 0 nl-any nl-any 1) & text-contains (nl-pick lib 3 "Magincia" "" 3 nl-any nl-any 0) "spell" & text-contains (nl-pick lib 1 "Magincia" "" 0 nl-any nl-any 0) "Magincia" & not (text-contains (nl-pick lib 3 "Trinsic" "" 0 nl-any nl-any 0) "Magincia") & nl-valid lib)
      a + b + c
    end
