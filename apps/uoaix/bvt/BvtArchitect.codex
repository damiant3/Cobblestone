Chapter: BvtArchitect
  cites Uoaix chapter Construction
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BvtCheck

  bva-at : Integer, Integer -> WorldObject
  bva-at (x) (y) = WorldObject { serial = 1, kind = 1, x = x, y = y, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 0 }
  bvt-architect : Integer -> [Console] Integer
  bvt-architect (unused) = let shop = list-at bb-shops bb-carpenter
    in act
      a <- bvt-check "the architect is the Saw Horse carpenter: a speaker inside the shop (or on its door line) is served, one 2 tiles out is not" (shop.premises == "The Saw Horse" & cn-in-shop shop (bva-at 1430 1595) & cn-in-shop shop (bva-at 1428 1599) & not (cn-in-shop shop (bva-at 1427 1595)) & not (cn-in-shop shop (bva-at 1430 1601)))
      b <- bvt-check "a spoken deed names its design: stone house 3, cottage 2, otherwise the small wooden house 1" (cn-design-said "buy a stone house deed" == 3 & cn-design-said "buy a cottage deed" == 2 & cn-design-said "buy a deed" == 1 & cn-design-said "draw a stone house deed" == 3)
      c <- bvt-check "a plan costs one silver, 70 copper" (cn-plan-price == 70)
      a + b + c
    end
