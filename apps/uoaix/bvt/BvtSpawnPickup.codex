Chapter: BvtSpawnPickup
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bsp-owner : Integer -> Result CompositeGame Text
  bsp-owner (z) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
  bsp-spawns : CompositeGame -> Result GameWorldSpawn Text
  bsp-spawns (owner) = when owner.spawns
    is Just (g) -> Ok g
    is None -> when cg-spawn-attach owner
      is Err (e) -> Err e
      is Ok (_) -> when owner.spawns is None -> Err "no spawns" is Just (g) -> Ok g
 A creature of the named profile stands at 1000,1000 (no shop) on a shop lot laid on its tile; answers 1 when the lot
 moved to the creature's actor and into the creature, 0 when it stayed on the ground and with its owner, or a negative
 step when the scenario could not be built.
  bsp-pick : Text -> Integer
  bsp-pick (key) = when bsp-owner 0
    is Err (_) -> -1
    is Ok (owner) -> when bsp-spawns owner
      is Err (_) -> -2
      is Ok (g) -> let w = owner.vendor.currency.world
        in let profile = cg-profile-index g.catalog.profiles key 0
        in let shop = (list-at owner.vendor.vendors 0).actor
        in let at = cg-first-lot w.goods shop 0
        in if profile < 0 | at < 0 then -3
        else let lot = ep-lot w.goods at
        in when world-create owner.checkpoint.game.world (gs-mobile 0 1000 1000 0 400 1002)
          is Err (_) -> -4
          is Ok (m) -> let slot = list-at g.slots 0
            in let s = __record-set slot "serial" m
            in let p = __record-set slot "profile" profile
            in when world-get owner.items.world lot.serial
              is Err (_) -> -5
              is Ok (o) -> when world-update owner.items.world (__record-set (__record-set (__record-set (__record-set o "container" 0) "x" 1000) "y" 1000) "z" 0)
                is Err (_) -> -6
                is Ok (_) -> let took = cg-pickup owner g 0
                  in let now = ep-lot w.goods at
                  in when world-get owner.items.world lot.serial
                    is Err (_) -> -7
                    is Ok (after) -> if took == 1 & now.actor == slot.actor & after.container == m then 1
                      else if took == 0 & now.actor == shop & after.container == 0 then 0 else -8
 An orc at 1000,1000 and a corpse dx tiles east holding a shop lot: 1 when the orc rummaged the lot out, 0 when the lot
 stayed in the corpse, or a negative step when the scenario could not be built.
  bsp-rummage : Integer -> Integer
  bsp-rummage (dx) = when bsp-owner 0
    is Err (_) -> -1
    is Ok (owner) -> when bsp-spawns owner
      is Err (_) -> -2
      is Ok (g) -> let w = owner.vendor.currency.world
        in let profile = cg-profile-index g.catalog.profiles "orc" 0
        in let shop = (list-at owner.vendor.vendors 0).actor
        in let at = cg-first-lot w.goods shop 0
        in if profile < 0 | at < 0 then -3
        else let lot = ep-lot w.goods at
        in when world-create owner.checkpoint.game.world (gs-mobile 0 1000 1000 0 400 1002)
          is Err (_) -> -4
          is Ok (m) -> when world-create owner.items.world (WorldObject { serial = 0, kind = 2, x = 1000 + dx, y = 1000, z = 0, graphic = #2006, hue = 0, container = 0, amount = 1, health = 0 })
            is Err (_) -> -5
            is Ok (corpse) -> let slot = list-at g.slots 0
              in let s = __record-set slot "serial" m
              in let p = __record-set slot "profile" profile
              in when world-get owner.items.world lot.serial
                is Err (_) -> -6
                is Ok (o) -> when world-update owner.items.world (__record-set (__record-set (__record-set o "container" corpse) "x" 60) "y" 80)
                  is Err (_) -> -7
                  is Ok (_) -> let took = cg-pickup owner g 0
                    in when world-get owner.items.world lot.serial
                      is Err (_) -> -8
                      is Ok (after) -> if took == 1 & (ep-lot w.goods at).actor == slot.actor & after.container == m then 1
                        else if took == 0 & (ep-lot w.goods at).actor == shop & after.container == corpse then 0 else -9
  bvt-spawn-pickup : Integer -> [Console] Integer
  bvt-spawn-pickup (unused) = act
    a <- bvt-check "an orc standing on a lot takes it: the lot passes to its actor and the object into its keeping (UOAIX-140 c)" (bsp-pick "orc" == 1)
    b <- bvt-check "a sheep (an animal, tameable) standing on a lot leaves it on the ground with its owner" (bsp-pick "sheep" == 0)
    c <- bvt-check "an orc rummages a corpse 2 tiles away: the corpse's lot passes to its actor and into its keeping (UOAIX-140 d)" (bsp-rummage 2 == 1)
    d <- bvt-check "a corpse 3 tiles away is left alone" (bsp-rummage 3 == 0)
    a + b + c + d
  end
