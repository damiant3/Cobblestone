Chapter: BvtWheelTotal
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bwt-put : Integer, Integer, Integer, Integer -> Integer
  bwt-put (b) (k) (ticks) (fires) = let a = poke-qword b (16 + k * 16) ticks in poke-qword b (16 + k * 16 + 8) fires
  bwt-text : Integer -> Text
  bwt-text (unused) = let b = cb-zeroed cg-kind-bytes
    in let total = cb-zeroed cg-kind-bytes
    in let a = bwt-put b 12 5000 2 in let c = bwt-put b 3 40 1
    in let f1 = cg-kind-fold b total 0
    in let r = cg-kind-reset b 0 in let d = bwt-put b 12 4950 3
    in let f2 = cg-kind-fold b total 0
    in cg-wheel-text total 1000000
  bwt-cells : Integer -> Text
  bwt-cells (unused) = let b = cb-zeroed cg-kind-bytes
    in let total = cb-zeroed cg-kind-bytes
    in let before = poke-qword b cg-kind-meter 70
    in let idle = cg-kind-charge b
    in let begun = cg-kind-begin b 12 0
    in let planned = poke-qword b cg-kind-meter 570
    in let charged = cg-kind-charge b
    in let folded = cg-kind-fold b total 0
    in show (peek-qword b (cg-kind-cells + 12 * 8)) & " " & show (peek-qword total (cg-kind-cells + 12 * 8)) & " " & show (peek-qword b (cg-kind-meter + 8))
  bvt-wheel-total : Integer -> [Console] Integer
  bvt-wheel-total (unused) = act
    c <- bwt-cells 0
    cells <- bvt-check ("the planners' cells metered while a kind runs are charged to that kind and folded, cells before it to none (red, UOAIX-267; " & c & ")") (c == "500 500 570")
    t <- bwt-text 0
    folds <- bvt-check ("the wheel total folds each tick's kind times and names only the kinds at 1% or more (red, UOAIX-267; " & t & ")") (t == "total-us=9990 12:9950/5")
    cells + folds
  end
