Chapter: BvtTownSpawns
  cites Uoaix chapter WorldSpawnData
  cites Uoaix chapter BvtWildThemes
  cites Uoaix chapter BvtCheck

  btsp-region : List WsRegion, Integer, Integer -> Boolean
  btsp-region (regions) (id) (i) = if i >= list-length regions then False else (list-at regions i).id == id | btsp-region regions id (i + 1)
  bvt-town-spawns : Integer -> [Console] Integer
  bvt-town-spawns (unused) = let c = wsd-catalog 0
    in act
      a <- bvt-check "Moonglow's thief guildmaster and farmhouses and Yew's sheep pens, fishers, farms and prison spawn from their UOX3 town regions (UOAIX-217)" (bwth-in c "region-616" "m_thief_guildmaster" & bwth-in c "region-1308" "sheep" & bwth-in c "region-1315" "fisher" & bwth-in c "region-1339" "garriot" & btsp-region c.regions 622 0 & btsp-region c.regions 1335 0)
      b <- bvt-check "a town region that is a shop does not spawn its keeper (the city's shop table does): Moonglow's baker, Yew's leatherworker, Wind's inn" (not (btsp-region c.regions 600 0) & not (btsp-region c.regions 1300 0) & not (btsp-region c.regions 1400 0))
      a + b
    end