Chapter: BvtWindCity
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvt-wind-city : Integer -> [Console] Integer
  bvt-wind-city (unused) = let cities = ct-table 0
    in let i = ct-city-at cities 5236 147 0
    in act
      a <- bvt-check "Wind, every shop of it from Seeker's Inn (5163,19) to the seat of knowledge (5247,191), is one city window (UOAIX-217)" (i > 0 & (list-at cities i).name == "Wind" & ct-city-at cities 5170 20 0 == i & ct-city-at cities 5146 56 0 == i & ct-city-at cities 5351 59 0 == i & ct-city-at cities 5245 191 0 == i)
      b <- bvt-check "the dungeon country around Wind is not the city" (ct-city-at cities 5130 10 0 == -1 & ct-city-at cities 5360 200 0 == -1)
      a + b
    end