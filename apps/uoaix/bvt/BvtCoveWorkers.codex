Chapter: BvtCoveWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtVesperWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-cove-workers : Integer -> [Console] Integer
  bvt-cove-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-cove (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-fishmonger == s + bvv-k shops "Docks" 0 & cw-vendor c 1 == s + bvv-k shops "The Warrior's Supplies" 0 + 3 & bvv-k shops "Docks" 0 >= 0
    a <- bvt-check "Cove's fisherman sells at the Docks and its ore goes to The Warrior's Supplies' blacksmith (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-fish-place & cw-wants c (cgg-place + 1)
    unwanted <- cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place | cw-wants c cgg-herb-farm
    b <- bvt-check "Cove founds a fisherman and miners on its west mountain, and no shepherd, lumberjack or herb farmer" (wanted & not unwanted)
    door <- cw-door 14
    d <- bvt-check "Cove (city 14) builds a worker city whose lodging door is 2231,1214" (is-just (cw-city (ct-table 0) shops ct-shop-roles 14) & door.x == 2231 & door.y == 1214)
    a + b + d
  end
