Chapter: BvtLook
  cites Uoaix chapter GameSkillsItems
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-look-made : Result Integer Text -> Integer
  bvt-look-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bvt-look-note : Result (Maybe GameReply) Text -> Text
  bvt-look-note (r) = when r
    is Err (e) -> "ERROR " & e
    is Ok (m) -> when m is None -> "NONE" is Just (reply) -> reply.note
  bvt-look : Integer -> [Console] Integer
  bvt-look (unused) = when gs-new 0
    is Err (e) -> bvt-check ("look fixture shard: " & e) False
    is Ok (shard) -> when walk-map-new 1408 1680 64 64
      is Err (e) -> bvt-check ("look fixture map: " & e) False
      is Ok (map) -> act
        player <- bvt-look-made (world-create shard.world (gs-mobile 0 1421 1698 0 400 1002))
        active <- __record-set shard "active" player
        character <- poke-qword shard.characters 0 player
        input <- gn-input-with (gsi-specs 0) 7
        mode <- __record-set input "mode" 2
        phase <- __record-set input.session "phase" 2
        serial <- __record-set input.session "serial" player
        items <- gsi-new shard.world
        hold <- gs-item 0 #0E75 0
        hx <- __record-set hold "x" 1451
        hy <- __record-set hold "y" 1698
        box <- bvt-look-made (world-create shard.world hold)
        cargo <- gs-item box 7133 0
        many <- __record-set cargo "amount" 4
        logs <- bvt-look-made (world-create shard.world cargo)
        other <- bvt-look-made (world-create shard.world (gs-mobile 0 1461 1698 0 400 1002))
        pack <- bvt-look-made (world-create shard.world (gs-item other #0E75 0))
        carried <- bvt-look-made (world-create shard.world (gs-item pack 7133 0))
        far <- bvt-look-note (gsi-handle-at items shard input map 2593 (gp-put32 [9] logs) 100)
        held <- bvt-look-note (gsi-handle-at items shard input map 2593 (gp-put32 [9] carried) 101)
        a <- bvt-check "a single click names an item in a container 30 tiles away, as a ship's hold" (player > 0 & box > 0 & logs > 0 & far == "items:look")
        b <- bvt-check "a single click names an item in a pack another mobile carries, 40 tiles away" (other > 0 & pack > 0 & carried > 0 & held == "items:look")
        a + b
      end
