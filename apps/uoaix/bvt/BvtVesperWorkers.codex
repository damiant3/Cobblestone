Chapter: BvtVesperWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvv-k : List BbShop, Text, Integer -> Integer
  bvv-k (shops) (premises) (i) = if i >= list-length shops then -1 else if (list-at shops i).premises == premises then i else bvv-k shops premises (i + 1)
  bvt-vesper-workers : Integer -> [Console] Integer
  bvt-vesper-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-vesper (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-fishmonger == s + bvv-k shops "Fisherman's Wharf" 0 & cw-vendor c bb-herbalist == s + bvv-k shops "The Magician's Friend" 0 & bvv-k shops "Fisherman's Wharf" 0 >= 0
    a <- bvt-check "Vesper's fisherman sells at Fisherman's Wharf and its herb farmer at The Magician's Friend (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-fish-place & cw-wants c cgg-herb-farm
    unwanted <- cw-wants c (cgg-place + 1) | cw-wants c cgg-stone-place | cw-wants c cgg-farm-place | cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place
    b <- bvt-check "Vesper founds a fisherman and a herb farmer, and no miner, quarrier, field farmer, shepherd or lumberjack (no mountain, field or pasture in its window; its forest waits for UOAIX-234)" (wanted & not unwanted)
    door <- cw-door 12
    d <- bvt-check "Vesper (city 12) builds a worker city whose inn door is The Ironwood Inn's, 2771,975" (is-just (cw-city (ct-table 0) shops ct-shop-roles 12) & door.x == 2771 & door.y == 975)
    a + b + d
  end
