Chapter: BvtCursorContext
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter CompositeSkillCommand
  cites Uoaix chapter BvtCheck

  bvt-cursor-context : Integer -> [Console] Integer
  bvt-cursor-context (unused) = act
    a <- bvt-check "a [skill or [attr cursor answer is taken in testing mode, at a stat [attr allows (red, UOAIX audit 2026-10-18)" (cp-context-allowed True (16 + 1001 * 3 + 500) & cp-context-allowed True (cat-base + 100))
    b <- bvt-check "a forged [skill or [attr cursor answer is refused outside testing mode" (not (cp-context-allowed False (16 + 1001 * 3 + 500)) & not (cp-context-allowed False (cat-base + 100)))
    c <- bvt-check "a forged [attr cursor answer past the typed command's 100 is refused even in testing mode" (not (cp-context-allowed True (cat-base + 255)))
    d <- bvt-check "the inspect, pick, place, remove and kill cursors are unchanged" (cp-context-allowed False 1 & cp-context-allowed False 5)
    a + b + c + d
  end
