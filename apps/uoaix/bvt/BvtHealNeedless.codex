Chapter: BvtHealNeedless
  cites Uoaix chapter ActiveSkillsHealing
  cites Uoaix chapter BvtCheck

  bvt-healneed : Integer -> [Console] Integer
  bvt-healneed (unused) =
    let refused = as-heal-needless 50 50 -1
    in let allowed = not (as-heal-needless 49 50 -1) & not (as-heal-needless 50 50 0) & not (as-heal-needless 0 50 -1) & not (as-heal-needless 50 0 -1)
    in act
      a <- bvt-check "bandaging a living, unpoisoned patient at full hits is refused (UOAIX-205)" refused
      b <- bvt-check "a patient one hit short, a poisoned one, a dead one and one whose maximum is unknown are bandaged" allowed
      a + b
    end
