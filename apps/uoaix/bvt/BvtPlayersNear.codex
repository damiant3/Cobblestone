Chapter: BvtPlayersNear
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

 A name heard, a duel challenged, a play's gift and a crime's witnesses ask the players within their reach from the
 world's tile index (cg-players-near), not every player row.
  bpz-made : Result Integer Text -> Integer
  bpz-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bpz-player : CompositeGame, Integer, Integer, Integer -> Integer
  bpz-player (owner) (x) (y) (n) = let v = owner.vendor
    in let actor = ep-admit v.currency.world (eu-open v.currency 2 (3000 + n)) 100
    in let who = bpz-made (world-create v.game.world (gs-mobile 0 x y 0 400 1002))
    in let pack = bpz-made (world-create v.game.world (gs-item who #0E75 0))
    in if gv-add-player v who actor pack < 0 then 0 else who
  bvt-players-near : Integer -> [Console] Integer
  bvt-players-near (unused) = when cg-new 0
    is Err (e) -> bvt-check ("players near fixture: " & e) False
    is Ok (owner) -> act
      world <- owner.checkpoint.game.world
      near <- bpz-player owner 1430 1700 0
      far <- bpz-player owner 1460 1700 1
      npc <- bpz-made (world-create world (gs-mobile 0 1431 1700 0 400 1002))
      found <- cg-players-near owner.vendor world 1430 1702 12
      only <- near /= 0 & far /= 0 & npc /= 0 & list-length found == 1 & list-at found 0 == near
      me <- when world-get world npc is Ok (m) -> m is Err (_) -> gs-mobile 0 0 0 0 400 1002
      dueled <- cg-duel-near owner me 0 0 100
      played <- cg-play-near owner.vendor world 1431 1700 0
      row <- gv-player owner.vendor near 0
      a <- bvt-check "the players within reach come from the tiles: the near player, not the NPC beside it nor the player 30 tiles off" only
      b <- bvt-check "a challenge answers the nearest player within 8 tiles, and a play's gift finds the player row within 3" (dueled == near & row >= 0 & played == row)
      a + b
    end
