Chapter: BvtAnvilReach
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 Damian, 2026-10-10: "smith hammer should work near an anvil, not in a workshop". An anvil item on the ground counts
 within 2 tiles and 16 z (cpr-anvil-item), and smithing's refusal names the anvil (gcr-away-text).
  bar-made : Result Integer Text -> Integer
  bar-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bar-recipe : EpWorld, Integer, Integer -> Integer
  bar-recipe (w) (kind) (i) = if i >= list-length w.catalog.recipes then 0
    else if (list-at w.catalog.recipes i).station == kind then i + 1 else bar-recipe w kind (i + 1)
  bar-other : EpWorld, Integer -> Integer
  bar-other (w) (i) = if i >= list-length w.catalog.recipes then 0
    else let kind = (list-at w.catalog.recipes i).station in if kind > 1 & kind /= 3 & kind /= 9 then i + 1 else bar-other w (i + 1)
  bvt-anvil-reach : Integer -> [Console] Integer
  bvt-anvil-reach (unused) = when cg-new 0
    is Err (e) -> bvt-check ("anvil reach fixture: " & e) False
    is Ok (owner) -> let world = owner.items.world
      in let anvil = bar-made (world-create world (__record-set (__record-set (gs-item 0 #0FAF 0) "x" 1421) "y" 1700))
      in let beside = gs-mobile 0 1420 1700 0 400 1015
      in let far = gs-mobile 0 1424 1700 0 400 1015
      in let high = gs-mobile 0 1420 1700 40 400 1015
      in let w = owner.vendor.currency.world
      in let smith = bar-recipe w 3 0
      in let other = bar-other w 0
      in let alone = cpr-smithy None world (gs-mobile 0 1418 1700 0 400 1015)
      in let forge = bar-made (world-create world (__record-set (__record-set (gs-item 0 #0FB1 0) "x" 1415) "y" 1700))
      in let both = gs-mobile 0 1418 1700 0 400 1015
      in let past = gs-mobile 0 1419 1704 0 400 1015 in act
      a <- bvt-check "an anvil item within 2 tiles counts for repair (cpr-anvil-item); 3 tiles off or 40 above it does not" (anvil > 0 & cpr-anvil-item world beside 0 & not (cpr-anvil-item world far 0) & not (cpr-anvil-item world high 0))
      b <- bvt-check "away from the smithy smithing says so, a tinker's tool names the workbench, and another craft still names its workshop" (smith > 0 & other > 0 & gcr-away-text w 1 smith "x" == "You must be within 3 tiles of an anvil and a forge." & gcr-away-text w 4 smith "x" == "You must be near a tinker's workbench." & gcr-away-text w 2 other "x" == "x")
      c <- bvt-check "UOAIX-242 D4: a smith needs an anvil and a forge each within 3 tiles; an anvil alone, or both 4 tiles off, does not do (cpr-smithy)" (forge > 0 & not alone & cpr-smithy None world both & not (cpr-smithy None world past))
      clock <- bar-made (world-create world (__record-set (__record-set (gs-item 0 #104B 0) "x" 1500) "y" 1700))
      by-clock <- cpr-tinker-bench None world (gs-mobile 0 1501 1700 0 400 1015)
      gears <- bar-made (world-create world (__record-set (__record-set (gs-item 0 #1053 0) "x" 1500) "y" 1710))
      d <- bvt-check "D-15: a tinker's workbench is tinker's parts within 3 tiles (gears beside: yes; 4 tiles off: no); the smithy's anvil and forge, or a clock, are not one (cpr-tinker-bench)" (clock > 0 & gears > 0 & not by-clock & cpr-tinker-bench None world (gs-mobile 0 1503 1710 0 400 1015) & not (cpr-tinker-bench None world (gs-mobile 0 1504 1710 0 400 1015)) & not (cpr-tinker-bench None world both))
      a + b + c + d
    end
