Chapter: BvtMoonglowShops
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

 Moonglow's 12 shops follow the cities appended before it; the first is the provisioner of The Scholar's Goods.
  bmgs-first : List BbShop, Integer -> Integer
  bmgs-first (shops) (k) = if k >= list-length shops then -1 else if (list-at shops k).premises == "The Scholar's Goods" then k else bmgs-first shops (k + 1)
  bmgs-inside : List CtCity, List BbShop, Integer, Integer, Integer -> Boolean
  bmgs-inside (cities) (shops) (city) (k) (last) = if k > last then True
    else let s = list-at shops k
    in ct-city-at cities s.x1 s.y1 0 == city & ct-city-at cities s.x2 s.y2 0 == city & bmgs-inside cities shops city (k + 1) last
  bvt-moonglow-shops : Integer -> [Console] Integer
  bvt-moonglow-shops (unused) = let cities = ct-table 0
    in let shops = ct-city-shops 0
    in let moonglow = ct-city-at cities 4440 1100 0
    in let k = bmgs-first shops 0
    in act
      a <- bvt-check "Moonglow's 12 shops (provisioner, two smiths, tailor, baker, healer, two inns, tinker, carpenter, herbalist, cobbler) each keep their keeper inside Moonglow (UOAIX-217)" (k >= 0 & list-length shops >= k + 12 & (list-at shops (k + 11)).title == "Cobbler" & bmgs-inside cities shops moonglow k (k + 11))
      b <- bvt-check "a Moonglow vendor sells as its Britain role: the provisioner as 0, the armory as the blacksmith 1, the cobbler as 16" (k >= 0 & ct-vendor-role (bb-shop-count + k) == 0 & ct-vendor-role (bb-shop-count + k + 2) == 1 & ct-vendor-role (bb-shop-count + k + 11) == 16 & list-length ct-shop-roles == list-length shops)
      a + b
    end