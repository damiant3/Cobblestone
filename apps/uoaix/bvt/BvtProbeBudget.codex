Chapter: BvtProbeBudget
  cites Uoaix chapter TownRoutes
  cites Uoaix chapter TownLivePath
  cites Uoaix chapter BvtCheck

  bpb-land : WalkMap, Integer -> Integer
  bpb-land (map) (i) = if i >= 256 then 0 else let a = walk-set-land map (1400 + int-mod i 16) (1600 + i / 16) 0 0 in bpb-land map (i + 1)
  bpb-checks : Integer -> Text
  bpb-checks (unused) = when walk-map-new 1400 1600 16 16
    is Err (e) -> e
    is Ok (map) -> when world-new 64
      is Err (e) -> e
      is Ok (world) -> let laid = bpb-land map 0
        in let p = tl-path-new map
        in let m = WorldObject { serial = 0, kind = 1, x = 1401, y = 1601, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
        in let short = rte-plan-at-budget 3 p world map None m 1414 1614 0 2
        in let clipped = peek-qword p.why (22 * 8)
        in let again = rte-plan-at-budget 3 p world map None m 1414 1614 0 rte-probe-budget
        in let searched = peek-qword p.why (7 * 8)
        in let refused = peek-qword p.why (6 * 8)
        in let kept = rte-plan-budget p world map None m 1413 1613 0 2
        in let keeper = rte-plan-budget p world map None m 1413 1613 0 (p.width * p.height)
        in let probe = rte-plan-at-budget 3 p world map None m 1412 1612 0 rte-probe-budget
        in show (if short < 0 then 1 else 0) & " " & show clipped & " " & show (if again < 0 then 1 else 0) & " " & show searched & " " & show refused
          & " " & show (if kept < 0 then 1 else 0) & " " & show (if keeper >= 0 then 1 else 0) & " " & show (if probe >= 0 then 1 else 0)
  bvt-probe-budget : Integer -> [Console] Integer
  bvt-probe-budget (unused) = act
    t <- bpb-checks 0
    bvt-check ("a probe clipped at its budget is counted and refused on its next ask; a keeper's clipped plan is not, and reaches at full budget (red, UOAIX-267; " & t & ")") (t == "1 1 1 1 1 1 1 1")
  end
