Chapter: BvtMine
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvt-mine : Integer -> [Console] Integer
  bvt-mine (unused) = act
    r <- cgg-node-region
    a <- bvt-check "the miners' ore strip lies under the mountain north of Britain, inside the old town window x 1408-1503 from y 1520 (no mines in the castle, live 40204)" (r.x1 >= 1446 & r.x2 <= 1457 & r.y1 >= 1530 & r.y2 <= 1534 & r.y1 >= 1520 & r.x2 <= 1503)
    b <- bvt-check "no tile of the ore strip is in Castle Britain's grounds (west of x 1415)" (r.x1 > 1415)
    a + b
  end
