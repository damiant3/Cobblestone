Chapter: BvtSmith
  cites Uoaix chapter BritainShops
  cites Uoaix chapter CompositeStation
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvsm-lists : Integer, Integer, Integer -> Boolean
  bvsm-lists (item) (art) (i) = if i >= list-length (bb-goods 1) then False
    else let g = list-at (bb-goods 1) i in (g.item == item & g.graphic == art) | bvsm-lists item art (i + 1)
  bvsm-rows : Integer -> Integer
  bvsm-rows (k) = if k >= sm98-n then 0 else (if bvsm-lists (sm98-at sm98-items k) (sm98-at sm98-arts k) 0 & gvb-goods 1 (sm98-at sm98-items k) then 1 else 0) + bvsm-rows (k + 1)
  bvsm-costs : EgCatalog, Integer -> Integer
  bvsm-costs (c) (k) = if k >= sm98-n then 0
    else let item = sm98-at sm98-items k
    in (if item == 69 | item == 70 | item == 71 | bb-forge-cost c item == sm98-at sm98-metal k then 1 else 0) + bvsm-costs c (k + 1)
  bvt-smith : Integer -> [Console] Integer
  bvt-smith (unused) = act
    a <- bvt-check "the smith forges the first 1998 menu row from start that its shop holds none of and its ingots cover, wrapping; none when every row is held or too dear" (bb-forge-pick (\i -> False) (\i -> 5) 100 0 0 == 0 & bb-forge-pick (\i -> i == 167) (\i -> 5) 100 0 0 == 1 & bb-forge-pick (\i -> False) (\i -> 5) 100 48 0 == 48 & bb-forge-pick (\i -> False) (\i -> 5) 100 49 0 == 0 & bb-forge-pick (\i -> True) (\i -> 5) 100 0 0 == -1 & bb-forge-pick (\i -> False) (\i -> 5) 4 0 0 == -1)
    b <- bvt-check "every 1998 row the smith forges costs its 1998 iron (the dagger, longsword and gorget keep their own recipes)" (bvsm-costs (bb-catalog 0) 0 == sm98-n & bb-forge-cost (bb-catalog 0) 41 == 25 & bb-forge-cost (bb-catalog 0) 202 == 20)
    c <- bvt-check "the smith's shop lists every 1998 menu row at its art and counts it among its goods, the hammer too" (bvsm-rows 0 == sm98-n & bvsm-lists 62 #13E3 0 & list-length (bb-goods 1) == sm98-n + 1 & gvb-goods 1 202 & not (gvb-goods 1 211))
    d <- bvt-check "the live smith forges through bb-forge (mode 2), and no other station worker does" ((csn-smith 0).mode == 2 & (csn-baker 0).mode == 0 & (csn-tailor 0).mode == 1)
    e <- bvt-check "a forged piece is worn on its 1998 layer: platemail chest, broadsword hand, ringmail leggings legs, gloves hands, a shield the off hand" (bb-layer 41 == 13 & bb-layer 40 == 1 & bb-layer 169 == 4 & bb-layer 167 == 7 & bb-layer 183 == 2 & bb-layer 34 == 0)
    a + b + c + d + e
  end
