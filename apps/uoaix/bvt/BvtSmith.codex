Chapter: BvtSmith
  cites Uoaix chapter BritainShops
  cites Uoaix chapter CompositeStation
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvsm-lists : Integer, Integer, Integer -> Boolean
  bvsm-lists (item) (art) (i) = if i >= list-length (bb-goods 1) then False
    else let g = list-at (bb-goods 1) i in (g.item == item & g.graphic == art) | bvsm-lists item art (i + 1)
  bvt-smith : Integer -> [Console] Integer
  bvt-smith (unused) = act
    a <- bvt-check "the smith forges a gorget first, then a suit, then a weapon, each when its shop holds none, else a longsword" (bb-forge-pick 0 0 0 4 == 71 & bb-forge-pick 1 0 0 4 == 41 & bb-forge-pick 1 1 0 2 == 40 & bb-forge-pick 1 1 1 9 == 70)
    b <- bvt-check "a suit takes 4 ingots and a gorget 3: short of them the smith forges the next good it lacks" (bb-forge-pick 0 0 0 2 == 40 & bb-forge-pick 1 0 1 3 == 70 & bb-forge-ingots 41 == 4 & bb-forge-ingots 71 == 3 & bb-forge-ingots 40 == 2)
    c <- bvt-check "the smith's shop lists the broadsword (40, 0x0F5E) and the platemail suit (41, 0x1415), and buys them back" (bvsm-lists 40 #0F5E 0 & bvsm-lists 41 #1415 0 & gvb-item-of #0F5E == 40 & gvb-item-of #1415 == 41 & gvb-goods 1 40 & gvb-goods 1 41 & bb-forge-art 41 == #1415)
    d <- bvt-check "the live smith forges through bb-forge (mode 2), and no other station worker does" ((csn-smith 0).mode == 2 & (csn-baker 0).mode == 0 & (csn-tailor 0).mode == 1)
    e <- bvt-check "a platemail suit is worn on the chest layer and a broadsword in hand" (bb-layer 41 == 13 & bb-layer 40 == 1)
    a + b + c + d + e
  end
