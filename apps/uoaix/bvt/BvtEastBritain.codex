Chapter: BvtEastBritain
  cites Uoaix chapter Cities
  cites Uoaix chapter BritainShopHours
  cites Uoaix chapter BvtCheck

 UOAIX-241: east Britain's keepers are the last ten rows of the city shop table, each in Britain (city 0) east of the river.
  bveb-roles : List Integer = [2, 18, 9, 12, 5, 0, 16, 18, 1, 20]
  bveb-rows : List CtCity, List BbShop, Integer, Integer -> Boolean
  bveb-rows (cities) (shops) (first) (k) = if k >= list-length bveb-roles then True
    else let s = list-at shops (first + k)
    in let role = list-at bveb-roles k
    in ct-vendor-role (bb-shop-count + first + k) == role & s.title == (list-at bb-shops role).title
      & ct-city-at cities s.x1 s.y1 0 == 0 & ct-city-at cities s.x2 s.y2 0 == 0 & s.x1 > bwn-town-x2
      & bveb-rows cities shops first (k + 1)
  bvt-east-britain : Integer -> [Console] Integer
  bvt-east-britain (unused) = act
    cities <- ct-table 0
    shops <- ct-city-shops 0
    first <- list-length shops - list-length bveb-roles
    a <- bvt-check "east Britain's ten keepers (tailor, two tavern keepers, scribe, herbalist, innkeeper, provisioner, cobbler, armourer as blacksmith, jeweler) stand in Britain's window east of the river and sell as their Britain role (UOAIX-241, Damian: 'populate east brit too with shopkeeps')" (list-length shops == list-length ct-shop-roles & bveb-rows cities shops first 0)
    night <- 3 * 3600
    b <- bvt-check "east Britain keeps west Britain's hours: its taverns and inn trade at 3 in the night, its tailor and jeweler are shut" (bsh-shop-open 18 night & bsh-shop-open 5 night & not (bsh-shop-open 2 night) & not (bsh-shop-open 20 night) & bsh-shop-open 2 (12 * 3600))
    c <- bvt-check "the Unicorn's Horn lies inside the window, the open road south of it does not" (ct-city-at cities 1547 1775 0 == 0 & ct-city-at cities 1547 1790 0 == -1)
    a + b + c
  end
