Chapter: BvtGroundDecay
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bgd-plot : CnState, Integer, Integer, Integer, Integer, Integer -> Integer
  bgd-plot (s) (x0) (y0) (x1) (y1) (holder) = let p = cn-plots s
    in let at = cn-plot-at s p
    in let a = poke-qword at 0 x0 in let b = poke-qword at 8 y0 in let c = poke-qword at 16 x1 in let d = poke-qword at 24 y1
    in let e = poke-qword at 32 holder in poke-qword s.buf 0 (p + 1)
  bvt-ground-decay : Integer -> [Console] Integer
  bvt-ground-decay (unused) = act
    land <- cn-new 0
    held <- bgd-plot land 1500 1600 1508 1608 4242
    crown <- bgd-plot land 1520 1600 1528 1608 0
    a <- bvt-check "UOAIX-180: an item on a held plot is kept (ServUO keeps what is in a house)" (cg-on-plot land 1504 1604 0)
    b <- bvt-check "UOAIX-180: an item on crown land (a forfeited plot) decays" (not (cg-on-plot land 1524 1604 0))
    c <- bvt-check "UOAIX-180: an item off every plot decays" (not (cg-on-plot land 1440 1720 0))
    d <- bvt-check "UOAIX-180: a ground item decays an hour after it lands (UOX3 DECAYTIMER=3600) on its own wheel kind" (cg-ground-ms == 3600000 & cg-ground-kind /= cb-corpse-kind)
    a + b + c + d
  end
