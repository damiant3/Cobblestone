Chapter: BvtWheelGrow
  cites Uoaix chapter WorldTimers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvwg-drain : WorldTimers, Integer, Integer -> Integer
  bvwg-drain (w) (tick) (n) = if wtm-next w tick < 0 then n else bvwg-drain w tick (n * 10 + w.key)
  bvt-wheel-grow : Integer -> [Console] Integer
  bvt-wheel-grow (unused) = when wtm-new 4 256 0
    is Err (e) -> bvt-check ("wheel grow fixture: " & e) False
    is Ok (w) -> act
      a1 <- wtm-add w 30 2 3
      a2 <- wtm-add w 10 2 1
      loose <- wtm-tight w
      a3 <- wtm-add w 20 2 2
      a4 <- wtm-add w 40 2 4
      tight <- wtm-tight w
      refused <- wtm-add w 50 2 5
      grown <- wtm-grow w
      a5 <- wtm-add w 50 2 5
      relaxed <- not (wtm-tight w)
      count <- w.used
      moved <- wtm-set w 60 2 1
      gone <- wtm-clear w 2 3
      a <- bvt-check "a wheel with a quarter or fewer entries free is due to grow, and a full one refuses an add (wtm-tight)" (a1 >= 0 & a2 >= 0 & a3 >= 0 & not loose & a4 >= 0 & tight & refused < 0)
      b <- bvt-check "the grown wheel doubles, admits the refused add and is no longer due" (grown == 8 & w.capacity == 8 & a5 >= 0 & relaxed & count == 5)
      fired <- bvwg-drain w 100 0
      c <- bvt-check "after growth set and clear find entries armed before it by key, and every entry fires in deadline order" (moved >= 0 & gone == 1 & fired == 2451 & w.used == 0)
      a + b + c
    end
