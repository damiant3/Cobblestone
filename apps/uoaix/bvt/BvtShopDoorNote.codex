Chapter: BvtShopDoorNote
  cites Uoaix chapter BritainShopHours
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BvtCheck

  bvsd-staff : Integer -> BshStaff
  bvsd-staff (unused) = BshStaff { keepers = [], door-rows = [3, 9, 5], door-shops = [6, 1, bb-tavern-keeper], door-nights = [0 - 1, 0 - 1, 0 - 1], phase = 1, leisure = 0 }
  bvt-shop-door-note : Integer -> [Console] Integer
  bvt-shop-door-note (unused) = act
    s <- bvsd-staff 0
    tinker <- bsh-door-note s 3 4 79200 7200
    smith <- bsh-door-note s 9 4 72000 0
    soon <- bsh-door-note s 3 4 28790 7200
    slow <- bsh-door-note s 3 4 79200 86400
    jail <- bsh-door-note s 4 4 79200 7200
    unbarred <- bsh-door-note s 3 1 79200 7200
    opened <- bsh-door-note s 3 4 28800 7200
    tavern <- bsh-door-note s 5 4 28800 7200
    serving <- bsh-door-note s 5 4 46800 7200
    print-line-uni ("SHOPDOOR " & tinker & " | " & smith & " | " & soon & " | " & slow & " | " & tavern)
    a <- bvt-check "a night-barred shop door names its shop, the opening hour and the real wait at the panel's day length (UOAIX-224)" (tinker == "Tinker Shop closed, till 8am (50 minutes)" & smith == "Blacksmith Shop closed, till 8am (1 hour)")
    b <- bvt-check "a wait under a minute reads 1 minute, and a real-time day reads hours (UOAIX-224)" (soon == "Tinker Shop closed, till 8am (1 minute)" & slow == "Tinker Shop closed, till 8am (10 hours)")
    c <- bvt-check "a barred door that is no shop's, an unbarred shop door and a shop door at opening hour keep the plain refusal (UOAIX-224)" (text-length jail == 0 & text-length unbarred == 0 & text-length opened == 0)
    d <- bvt-check "the Blue Boar never closes (Damian, 2026-10-10), so even a barred Boar door names no closing, at 8am or 1pm" (text-length tavern == 0 & text-length serving == 0)
    tinker-says <- bsh-closed-note 6 79200 7200
    musician-says <- bsh-closed-note bb-musician 36000 7200
    healer-says <- bsh-closed-note 4 10800 7200
    open-says <- bsh-closed-note 6 36000 7200
    print-line-uni ("SHOPKEEPER " & tinker-says & " | " & musician-says)
    e <- bvt-check "a closed shop's keeper says its closed note: the tinker till 8am, the musician till 6pm; the healer at 3am and the tinker at 10am say none" (tinker-says == "Tinker Shop closed, till 8am (50 minutes)" & musician-says == "Lord British's Conservatory of Music closed, till 6pm (40 minutes)" & text-length healer-says == 0 & text-length open-says == 0 & text-length (bsh-closed-note bb-shop-count 79200 7200) == 0)
    a + b + c + d + e
  end
