Chapter: BvtGateRetire
  cites Uoaix chapter CastleGate
  cites Uoaix chapter CompositeRemoval
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bgr-made : Result Integer Text -> Integer
  bgr-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bgr-put : WorldTable, Integer, Integer, Integer, Integer -> Integer
  bgr-put (world) (x) (y) (z) (graphic) = bgr-made (world-create world (WorldObject { serial = 0, kind = 2, x = x, y = y, z = z, graphic = graphic, hue = 0, container = 0, amount = 1, health = 0 }))
  bgr-old : WorldTable, Integer -> Integer
  bgr-old (world) (i) = if i == cgt-count then 0
    else let made = bgr-put world cgt-old-x (cgt-y + i) (if i == 0 then 44 else 24) cgt-old-art in bgr-old world (i + 1)
  bgr-gone : WorldTable, Integer -> Boolean
  bgr-gone (world) (serial) = when world-get world serial is Err (_) -> True is Ok (_) -> False
  bvt-gate-retire : Integer -> [Console] Integer
  bvt-gate-retire (unused) = when cg-game 256
    is Err (e) -> bvt-check ("gate retire fixture game: " & e) False
    is Ok (game) -> let world = game.world
      in let old = bgr-old world 0
      in let lever = bgr-put world cgt-old-winch-x cgt-old-winch-y 34 cgt-old-winch-art
      in let walled = bgr-put world cgt-wall-winch-x cgt-wall-winch-y 34 cgt-old-winch-art
      in let piece = bgr-put world cgt-x cgt-y cgt-z cgt-art
      in let winch = bgr-put world cgt-winch-x cgt-winch-y cgt-winch-z cgt-winch-art
      in let stray = bgr-put world 1420 1698 0 cgt-old-art
      in let first = cgt-retire world 0
      in let second = cgt-retire world 0
      in act
        a <- bvt-check "a world saved before the moves loses its six town-side 0x06F5 pieces and both old levers, the town-side one and the one inside the gatehouse wall (cgt-retire, CompositeGameServer boot)" (bgr-made first == 8 & bgr-gone world lever & bgr-gone world walled & cgt-at world cgt-old-x cgt-y cgt-old-art == 0)
        b <- bvt-check "the retire keeps the castle-side portcullis, its lever and a portcullis elsewhere, and retires nothing twice" (bgr-made second == 0 & is-ok second & not (bgr-gone world piece) & not (bgr-gone world winch) & not (bgr-gone world stray) & cgt-piece world 0 == piece & cgt-winch world == winch)
        c <- bvt-check "the portcullis stands on the castle side of the bridge (x 1399, boards to 1409) in the art drawn along y, and its winch is the client's static winch on the gatehouse deck (0x1EAC at 1398,1628,52, UOAIX-160)" (cgt-x < cgt-old-x & cgt-art == #06F6
          & cgt-winch-art == #1EAC & cgt-winch-x == 1398 & cgt-winch-y == 1628 & cgt-winch-z == 52 & cgt-winch-art /= cgt-old-winch-art)
        a + b + c
      end
