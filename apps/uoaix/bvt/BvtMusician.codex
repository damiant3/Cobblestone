Chapter: BvtMusician
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BritainShopHours
  cites Uoaix chapter BritainWindow
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter GameNpcSpeech
  cites Uoaix chapter GameCombatPackets
  cites Uoaix chapter BvtCheck

  bmu-at : Integer -> Integer
  bmu-at (hour) = hour * 3600 + 86400
  bvt-musician : Integer -> [Console] Integer
  bvt-musician (unused) = let s = list-at bb-shops bb-musician in let sound = cbp-sound bsh-lute-sound (WorldObject { serial = 1, kind = 1, x = 1450, y = 1556, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }) in act
    a <- bvt-check "the musician is shop 20 in Lord British's Conservatory of Music, inside its hall, and sells nothing (UOAIX-222)" (bb-shop-count >= 20 & bb-musician == 19 & s.title == "Musician" & s.premises == "Lord British's Conservatory of Music" & s.x1 >= 1448 & s.x2 <= 1462 & s.y1 >= 1554 & s.y2 <= 1558 & list-length (bb-goods bb-musician) == 0 & list-length (bb-goods bb-tavern-keeper) == 3)
    b <- bvt-check "the musician plays from hour 18 to midnight: open at 18 and 23, closed at 17 and 3; at 21 its keeper is at its post, at 10 at home" (bsh-shop-open bb-musician (bmu-at 18) & bsh-shop-open bb-musician (bmu-at 23) & not (bsh-shop-open bb-musician (bmu-at 17)) & not (bsh-shop-open bb-musician (bmu-at 3)) & bsh-goal bb-musician (bmu-at 21) == 1 & bsh-goal bb-musician (bmu-at 10) == 0 & bit-and (bsh-mask (bmu-at 21)) (bit-shl 1 bb-musician) == 0 & bit-and (bsh-mask (bmu-at 12)) (bit-shl 1 bb-musician) /= 0)
    c <- bvt-check "only the musician at its post plays, once a game minute, a 0x54 lute sound (0x4C) at where it stands" (bsh-plays bb-musician 1 & not (bsh-plays bb-musician 0) & not (bsh-plays bb-tavern-keeper 1) & bsh-play-seconds == 60 & list-at sound 0 == #54 & list-at sound 3 == #4C & list-length sound == 12)
    d <- bvt-check "vendor 19 is the musician by its role word and speech, and buys and sells nothing" (list-at gvb-role-words 19 == "musician" & list-length gvb-role-words == bb-shop-count & gvb-role 19 == 19 & not (gvb-material 19 78) & not (gvb-goods 19 152) & ns-role 19 == "musician")
    e <- bvt-check "the Britain walk window holds the Conservatory, so the musician is placed and walked" (s.x1 > bwn-x1 & s.x2 < bwn-x2 & s.y1 > bwn-y1 & s.y2 < bwn-y2)
    a + b + c + d + e
  end
