Chapter: BvtBankBoard
  cites Uoaix chapter BulletinBoard
  cites Uoaix chapter BvtCheck

 UOAIX-227: the Britain bank's bulletin board hangs on the street face of the front wall; a world holding it inside the
 wall's corner moves the same board there at boot.
  bvbb-moved : Integer -> Integer
  bvbb-moved (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (world) -> let items = gsi-new world
      in when world-create world (WorldObject { serial = 0, kind = 2, x = bbs-old-x, y = bbs-old-y, z = 0, graphic = bbs-art, hue = 0, container = 0, amount = 1, health = 0 })
        is Err (_) -> -2
        is Ok (old) -> let registered = gsi-register items old 0 0 False False
          in let moved = bbs-install items
          in let again = bbs-install items
          in let left = bbs-find world (world-tile-first world bbs-old-x bbs-old-y)
          in (if moved == 1 & again == 0 & bbs-board world == old & left == 0 then 1 else 0)
  bvbb-new : Integer -> Integer
  bvbb-new (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (world) -> let items = gsi-new world
      in let made = bbs-install items
      in let board = bbs-board world
      in if made == 1 & board /= 0 & bbs-find world (world-tile-first world bbs-old-x bbs-old-y) == 0 then 1 else 0
  bvt-bank-board : Integer -> [Console] Integer
  bvt-bank-board (unused) = act
    a <- bvt-check "the bank board stands on the tile in front of the bank's front wall, 1 south and 10 west of the corner it hid in" (bbs-x == 1431 & bbs-y == 1693 & bbs-old-x == 1441 & bbs-old-y == 1692)
    b <- bvt-check "a world holding the board inside the wall moves that same board to the street face, and the next boot leaves it" (bvbb-moved 0 == 1)
    c <- bvt-check "a world with no board founds one on the street face, none in the wall" (bvbb-new 0 == 1)
    a + b + c
  end
