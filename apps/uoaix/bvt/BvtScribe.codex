Chapter: BvtScribe
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  cites Uoaix chapter GameVendorBuys

  bvt-scribe-made : Integer -> Boolean
  bvt-scribe-made (item) = let c = bb-catalog 0 in let k = bb-recipe c item 0 in k > 0 & (list-at c.recipes (k - 1)).station == 15 & (list-at c.recipes (k - 1)).one == 107
  bvt-scribe : Integer -> [Console] Integer
  bvt-scribe (unused) = act
    a <- bvt-check "the scribe is shop 10, in the Britain Public Library" (bb-shop-count >= 10 & (list-at bb-shops 9).premises == "Britain Public Library")
    b <- bvt-check "the scribe sells spellbooks (0x0EFA), each bound from a blank book at station 15" ((list-at (bb-goods 9) 0).item == 108 & (list-at (bb-goods 9) 0).graphic == #0EFA & bvt-scribe-made 108)
    c <- bvt-check "a scribe holding no blank book buys one the mill offers; one holding a book, or with none offered, buys nothing" (bb-buys 0 3 & not (bb-buys 1 3) & not (bb-buys 0 (0 - 1)) & bb-mill == 8 & bb-scribe == 9)
    d <- bvt-check "every shop has its vendor role word, so vendor 8 opens the paper miller's menu (val, 40427)" (list-length gvb-role-words == bb-shop-count & gvb-role 8 == 8 & gvb-role 9 == 9 & gvb-role bb-shop-count == 0)
    a + b + c + d
  end