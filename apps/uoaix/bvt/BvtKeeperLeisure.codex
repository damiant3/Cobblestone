Chapter: BvtKeeperLeisure
  cites Uoaix chapter KeeperLeisure
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BritainWindow
  cites Uoaix chapter BvtCheck

 From need 0 a keeper stays home, goes out twice, stays home: 48, then 96 (out, 26 left), 74 (out, 4), 52 (home).
  bkl-cadence : Integer -> Boolean
  bkl-cadence (unused) = let rows = kl-new 0
    in let n1 = kl-choose rows 0 1
    in let again = kl-choose rows 0 1
    in let need1 = kl-field rows 0 0
    in let n2 = kl-choose rows 0 2
    in let n3 = kl-choose rows 0 3
    in let n4 = kl-choose rows 0 4
    in n1 == 0 & again == 0 & need1 == 48 & n2 > 0 & n3 > 0 & n4 == 0 & kl-field rows 0 0 == 52 & kl-field rows 0 8 == kl-start-happiness - 4 * kl-gloom
  bkl-workers : Integer -> Boolean
  bkl-workers (unused) = let rows = kl-new 0
    in let a = kl-choose rows bb-tavern-keeper 2 in let b = kl-choose rows bb-musician 2 in let c = kl-choose rows bb-tavern-keeper 3
    in a == 0 & b == 0 & c == 0 & kl-field rows bb-tavern-keeper 0 == 0
  bkl-round-trip : Integer -> Integer
  bkl-round-trip (unused) = let rows = kl-new 0
    in let chose = kl-choose rows 3 1 + kl-choose rows 3 2
    in let buf = alloc-bytes (kl-tail-size 0)
    in let written = kl-write-tail rows buf
    in let back = kl-new 0
    in let read = kl-read-tail back buf (kl-tail-size 0)
    in let same = read == bb-shop-count & kl-field back 3 0 == kl-field rows 3 0 & kl-field back 3 8 == kl-field rows 3 8 & kl-field back 3 24 == kl-field rows 3 24 & written == buf + kl-tail-size 0
    in let bad = poke-qword buf (8 + 3 * kl-row-bytes) 101
    in let refused = kl-read-tail (kl-new 0) buf (kl-tail-size 0) == -1
    in let short = kl-read-tail (kl-new 0) buf 16 == -1
    in (if same then 1 else 0) + (if refused then 2 else 0) + (if short then 4 else 0)
  bvt-keeper-leisure : Integer -> [Console] Integer
  bvt-keeper-leisure (unused) = let r = kl-concert-region in let post = list-at bb-shops bb-musician in act
    a <- bvt-check "a keeper's leisure need sends it out on two evenings in three, chosen once a night; each night costs 5 happiness (UOAIX-222)" (bkl-cadence 0)
    b <- bvt-check "evenings out alternate between the Blue Boar (2) and the Conservatory (3) by keeper and night" (kl-out 0 0 == 2 & kl-out 0 1 == 3 & kl-out 1 0 == 3 & kl-payee 2 == bb-tavern-keeper & kl-payee 3 == bb-musician & kl-payee 0 < 0 & kl-price 2 == 5 & kl-price 3 == 3)
    c <- bvt-check "the tavern keeper and the musician work their evenings and never go out" (bkl-workers 0)
    rt <- act bkl-round-trip 0 end
    d <- bvt-check ("the leisure rows survive the codec tail; a need of 101 and a short tail are refused (code " & show rt & ")") (rt == 7)
    e <- bvt-check "the audience stands in the Conservatory's hall east of the musician's post, inside the Britain walk window" (r.x1 > post.x2 & r.x2 <= 1462 & r.y1 >= 1554 & r.y2 <= 1558 & r.x1 > bwn-x1 & r.x2 < bwn-x2 & r.y1 > bwn-y1 & r.y2 < bwn-y2)
    a + b + c + d + e
  end
