Chapter: BvtParchment
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvp-makes : Integer, Integer, Integer -> Boolean
  bvp-makes (input) (count) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1017) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock input count in bb-from-bought w actor item
  bvp-lists : List BbGoods, Integer, Integer -> Boolean
  bvp-lists (goods) (item) (i) = if i >= list-length goods then False else (list-at goods i).item == item | bvp-lists goods item (i + 1)
  bvp-recipe : Integer -> EgRecipe
  bvp-recipe (item) = let c = bb-catalog 0 in list-at c.recipes (bb-recipe c item 0 - 1)
  bvt-parchment : Integer -> [Console] Integer
  bvt-parchment (unused) = act
    a <- bvt-check "items 125 and 126 are leather scraps and parchment; 1 leather cuts 4 scraps at station 11 and 2 scraps make parchment at the mill's station 14" (let k = bb-catalog 0 in (list-at k.items 124).name == "leather scraps" & (list-at k.items 125).name == "parchment"
      & (bvp-recipe 125).one == 35 & (bvp-recipe 125).one-count == 1 & (bvp-recipe 125).quantity == 4 & (bvp-recipe 125).station == 11
      & (bvp-recipe 126).one == 125 & (bvp-recipe 126).one-count == 2 & (bvp-recipe 126).station == 14 & eg-validate k == 0)
    b <- bvt-check "the leatherworker lists scraps and the paper mill lists parchment" (bvp-lists (bb-goods bb-leatherworker) 125 0 & bvp-lists (bb-goods bb-mill) 126 0)
    c <- bvt-check "1 bought leather cuts scraps, 2 bought scraps make parchment; none and 1 make nothing" (bvp-makes 35 1 125 & bvp-makes 125 2 126 & not (bvp-makes 35 0 125) & not (bvp-makes 125 1 126))
    d <- bvt-check "cut-up leather art (0x1067) is scraps and leather art (0x1081) is still leather" (gvb-item-of #1067 == 125 & gvb-item-of #1081 == 35)
    a + b + c + d
  end
