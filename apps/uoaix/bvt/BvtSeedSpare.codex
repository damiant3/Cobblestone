Chapter: BvtSeedSpare
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bss-owner : Integer -> Result CompositeGame Text
  bss-owner (z) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> cg-founded game vendor (gsi-new game.world)
  bss-quiet : CompositeGame -> Boolean
  bss-quiet (owner) = let before = __heap-save
    in let seeded = cg-seed-gold owner
    in __heap-save - before == 0 & seeded == 1 & cg-seeded owner
  bss-seeds : Integer -> Boolean
  bss-seeds (unused) = when bss-owner 0
    is Err (_) -> False
    is Ok (owner) -> (when owner.british is None -> True is Just (_) -> False) & not (cg-seeded owner) & bss-quiet owner
  bss-spare : Integer -> Boolean
  bss-spare (unused) = when bss-owner 0
    is Err (_) -> False
    is Ok (owner) -> not (cg-seeded owner) & (when owner.british-spare is None -> False is Just (c) -> c.serial == 0 & not (cbe-finished c))
  bvt-seed-spare : Integer -> [Console] Integer
  bvt-seed-spare (unused) = act
    a <- bvt-check "the minter seeds a world with no errand from the spare made at load, allocating nothing during play (UOAIX-123)" (bss-seeds 0)
    b <- bvt-check "an unseeded world is not open and its spare errand is no one's and unfinished" (bss-spare 0)
    a + b
  end
