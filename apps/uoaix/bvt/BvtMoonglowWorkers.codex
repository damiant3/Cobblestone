Chapter: BvtMoonglowWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtVesperWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-moonglow-workers : Integer -> [Console] Integer
  bvt-moonglow-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-moonglow (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-herbalist >= s & cw-vendor c bb-fishmonger == -1
    a <- bvt-check "Moonglow's herb farmer sells to its own herbalist; Moonglow keeps no fishmonger (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-herb-farm
    unwanted <- cw-wants c (cgg-place + 1) | cw-wants c cgg-stone-place | cw-wants c cgg-farm-place | cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place | cw-wants c cgg-fish-place
    b <- bvt-check "Moonglow founds a herb farmer, and no miner, quarrier, field farmer, shepherd, lumberjack or fisherman" (wanted & not unwanted)
    door <- cw-door 2
    d <- bvt-check "Moonglow (city 2) builds a worker city whose inn door is The Scholar's Inn's, 4402,1159" (is-just (cw-city (ct-table 0) shops ct-shop-roles 2) & door.x == 4402 & door.y == 1159)
    a + b + d
  end
