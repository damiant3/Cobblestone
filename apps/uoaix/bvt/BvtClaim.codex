Chapter: BvtClaim
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter BvtCheck

  bvt-claim : Integer -> [Console] Integer
  bvt-claim (unused) = act
    a <- bvt-check "Claim Horse and claim dragon are claims, any case (cp-claim-request)" (cp-claim-request [3, 0, 0, 0, 0, 0, 0, 0, 67, 108, 97, 105, 109, 32, 72, 111, 114, 115, 101, 0] & cp-claim-request [3, 0, 0, 0, 0, 0, 0, 0, 99, 108, 97, 105, 109, 32, 100, 114, 97, 103, 111, 110, 0])
    b <- bvt-check "Clam Horse, a bare Claim and a non-speech packet are not claims (cp-claim-request)" (not (cp-claim-request [3, 0, 0, 0, 0, 0, 0, 0, 67, 108, 97, 109, 32, 72, 111, 114, 115, 101, 0]) & not (cp-claim-request [3, 0, 0, 0, 0, 0, 0, 0, 67, 108, 97, 105, 109, 32, 0]) & not (cp-claim-request [6, 0, 0, 0, 0, 0, 0, 0, 67, 108, 97, 105, 109, 32, 72, 0]))
    c <- bvt-check "the claimed name is lowercased from byte 14 (cp-claim-name)" (let n = cp-claim-name [3, 0, 0, 0, 0, 0, 0, 0, 67, 108, 97, 105, 109, 32, 72, 111, 114, 115, 101, 0] 14 [] in list-length n == 5 & list-at n 0 == 104 & list-at n 4 == 101)
    a + b + c
  end
