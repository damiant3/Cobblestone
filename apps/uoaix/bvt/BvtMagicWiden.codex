Chapter: BvtMagicWiden
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter TownStateFields
  cites Uoaix chapter BvtCheck

  bvmw-hold : Integer -> Integer
  bvmw-hold (unused) = let hold = alloc-bytes (cc-magic-bytes 2)
    in let cleared = ts-zero hold (cc-magic-bytes 2) 0
    in let sized = poke-qword hold 16 2
    in let decor = poke-byte hold 32 #44
    in let actor = poke-byte hold (64 + 304) #11
    in let item = poke-byte hold (64 + 2 * 304 + 64) #22
    in let wall = poke-byte hold (64 + 2 * 368) #33 in hold
  bvt-magic-widen : Integer -> [Console] Integer
  bvt-magic-widen (unused) = act
    hold <- bvmw-hold 0
    wide <- cc-magic-wider hold 2 4
    same <- cc-magic-wider hold 2 2
    a <- bvt-check "a held MGM2 widened from 2 to 4 slots keeps its header, actor row, item row and walls by slot, and sizes the header (boot2 MGM2 extent, 42870)" (wide /= hold & peek-qword wide 16 == 4 & peek-byte wide 32 == #44 & peek-byte wide (64 + 304) == #11 & peek-byte wide (64 + 4 * 304 + 64) == #22 & peek-byte wide (64 + 4 * 368) == #33)
    b <- bvt-check "the widened MGM2's new actor and item rows are zero, so they read as empty" (peek-byte wide (64 + 3 * 304) == 0 & peek-byte wide (64 + 4 * 304 + 3 * 64) == 0)
    c <- bvt-check "a held MGM2 at the world's own capacity is not copied" (same == hold)
    a + b + c
  end
