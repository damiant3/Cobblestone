Chapter: BvtAdminTx
  cites Uoaix chapter ShardTx
  cites Uoaix chapter ShardLinks
  cites Uoaix chapter AdminPage
  cites Encode chapter Json
  cites Uoaix chapter BvtCheck

 The sealed panel-open answer is the hex of the JSON-quoted panel page; 4096 bytes cover its other fields, the GCM tag
 and the HTTP head.
  bvt-admin-tx : Integer -> [Console] Integer
  bvt-admin-tx (unused) = act
    a <- bvt-check "an admin slot holds the sealed panel page that panel-open answers" (2 * text-length (json-quote panel-page-next) + 4096 <= stx-admin-bytes)
    b <- bvt-check "an admin slot holds the login page that / serves" (text-length panel-login-next + 4096 <= stx-admin-bytes)
    c <- bvt-check "a game slot keeps the game transmit budget and an admin slot the admin one" (bvt-admin-tx-slots 0)
    d <- bvt-check "a transmit queue past the admin bound is refused" (when stx-new (stx-admin-bytes + 1) is Err (e) -> True is Ok (q) -> False)
    a + b + c + d
  end
  bvt-admin-tx-slots : Integer -> Boolean
  bvt-admin-tx-slots (unused) = when sl-new [2593, 2594] [2, 0, 0, 0, 0, 1] [10, 0, 2, 15] [10, 0, 2, 2] [255, 255, 255, 0]
    is Err (e) -> False
    is Ok (links) -> (list-at links.slots 0).tx.capacity == stx-max-bytes & (list-at links.slots 1).tx.capacity == stx-admin-bytes
