Chapter: BvtStaleWatcher
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bsw-owner : Integer -> Result CompositeGame Text
  bsw-owner (z) = when cg-game 512
    is Err (e) -> Err e
    is Ok (game) -> when gvd-mixed-economy 0
      is Err (e) -> Err e
      is Ok (currency) -> when gvd-world game currency z
        is Err (e) -> Err e
        is Ok (vendor) -> when cg-founded game vendor (gsi-new game.world)
          is Err (e) -> Err e
          is Ok (owner) -> when cg-spawn-attach owner
            is Err (e) -> Err e
            is Ok (_) -> Ok owner
 The spawn round over a watcher at 1010,1010, deleted first when gone: 1 when the round ran the spawn pass (the combat
 clock reached tick), 0 when it skipped it without an error, -1 when it failed with the stale serial, -2 otherwise.
  bsw-round : Boolean -> Integer
  bsw-round (gone) = when bsw-owner 0
    is Err (_) -> -2
    is Ok (owner) -> when walk-map-new 1000 1000 64 64
      is Err (_) -> -2
      is Ok (map) -> let game = owner.checkpoint.game
        in when world-create game.world (gs-mobile 0 1010 1010 0 400 1002)
          is Err (_) -> -2
          is Ok (watcher) -> let seen = __record-set owner "tick-watcher" watcher
            in let deleted = if gone then (when world-delete game.world watcher is Err (_) -> -1 is Ok (_) -> 0) else 0
            in let tick = 777777
            in if deleted < 0 then -2
            else when cg-spawn-round owner game map tick
              is Err (e) -> if text-contains e "absent or stale" then -1 else -2
              is Ok (_) -> when owner.spawns
                is None -> -2
                is Just (g) -> if g.combat.tick == tick then 1 else 0
  bvt-stale-watcher : Integer -> [Console] Integer
  bvt-stale-watcher (unused) = act
    a <- bvt-check "a live tick watcher runs the spawn round's pass (UOAIX-150)" (bsw-round False == 1)
    b <- bvt-check "a tick watcher that died earlier in the drain skips the spawn round instead of failing the world tick (UOAIX-150)" (bsw-round True == 0)
    a + b
  end
