Chapter: BvtNpcPass
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 UOAIX-164: NPCs walk through each other (Damian, 2026-10-09: "lets just make npcs not block each other like this");
 with the server's rule bound an NPC's tile is free to a walker, and a mobile the rule names still blocks.
  bnp-made : Result Integer Text -> Integer
  bnp-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bnp-only : Integer, Integer -> Boolean
  bnp-only (who) (serial) = serial == who
  bvt-npc-pass : Integer -> [Console] Integer
  bvt-npc-pass (unused) = when cg-new 0
    is Err (e) -> bvt-check ("npc pass fixture: " & e) False
    is Ok (owner) -> let world = owner.checkpoint.game.world
      in let walker = bnp-made (world-create world (gs-mobile 0 1496 1619 0 400 1015))
      in let other = bnp-made (world-create world (gs-mobile 0 1496 1618 0 400 1016))
      in let before = tl-occupied world (world-tile-first world 1496 1618) walker 0
      in let bound = world-bind-blocks world (cg-player-mobile owner)
      in let npc-free = not (tl-occupied world (world-tile-first world 1496 1618) walker 0) & not (world-blocked world 1496 1618)
      in let named = world-bind-blocks world (bnp-only other)
      in let still = tl-occupied world (world-tile-first world 1496 1618) walker 0 & world-blocked world 1496 1618
      in let reset = world-bind-blocks world world-blocks-all in act
      print-line-uni ("NPCPASS walker=" & show walker & " other=" & show other & " before=" & (if before then "1" else "0") & " free=" & (if npc-free then "1" else "0") & " still=" & (if still then "1" else "0"))
      a <- bvt-check "with the server's rule an NPC's tile is free to a walking NPC (UOAIX-164, the inn door at 1496,1618)" (walker > 0 & other > 0 & before & npc-free)
      b <- bvt-check "a mobile the blocking rule names still blocks the step and the plan" still
      a + b
    end
