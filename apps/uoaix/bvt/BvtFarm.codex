Chapter: BvtFarm
  cites Uoaix chapter CompositeProduction
  cites Uoaix chapter BvtCheck

  bvt-farm : Integer -> [Console] Integer
  bvt-farm (unused) = act
    a <- bvt-check "a nine-row field sows three new rows when its last ripe wheat is reaped" (cpr-sow-count 9 == 3)
    b <- bvt-check "each sowing is larger than the last: 12 rows sow 4, 16 sow 5" (cpr-sow-count 12 == 4 & cpr-sow-count 16 == 5)
    c <- bvt-check "the last sowing stops at the plot's 66 rows" (cpr-sow-count 63 == 3 & cpr-sow-count 65 == 1)
    d <- bvt-check "a full plot sows nothing" (cpr-sow-count 66 == 0 & cpr-sow-count 70 == 0)
    a + b + c + d
  end