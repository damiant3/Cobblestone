Chapter: BvtGumpRoute
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter TavernCards
  cites Uoaix chapter ShipwrightBattleship
  cites Uoaix chapter BvtCheck

 0xB1 gump answer, 23 bytes: serial at 3, gump id at 7, button at 11, then no switches and no text entries.
  bvt-gumproute-answer : Integer -> List Integer
  bvt-gumproute-answer (id) = gp-zeros (gp-put32 (gp-put32 (gp-put32 [#B1, 0, 23] 4242) id) 1) 8
  bvt-gumproute : Integer -> [Console] Integer
  bvt-gumproute (unused) =
    let test = cp-gumptest-answer (bvt-gumproute-answer cp-gumptest-id) & list-length (bvt-gumproute-answer cp-gumptest-id) == 23
    in let games = not (cp-gumptest-answer (bvt-gumproute-answer tcd-gump-id)) & not (cp-gumptest-answer (bvt-gumproute-answer (swb-tag + 1)))
    in act
      a <- bvt-check "the [gumptest gump's answer is paging's own" test
      b <- bvt-check "a card table's and a battleship's gump answer pass paging to their game" games
      a + b
    end
