Chapter: BvtFounding
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck

  bvt-founding : Integer -> [Console] Integer
  bvt-founding (unused) = when gs-new 0
    is Err (e) -> bvt-check ("founding fixture shard: " & e) False
    is Ok (shard) -> when bb-economy 0
      is Err (e) -> bvt-check ("founding fixture economy: " & e) False
      is Ok (x) -> act
        v <- gv-new shard x
        items <- gsi-new shard.world
        founded <- bb-populate-at v items 0 0 (BbSpot { x = 1466, y = 1673, z = 0 })
        actor <- (list-at v.vendors 0).actor
        a <- bvt-check "a founded provisioner still lists a pickaxe once its whole list is made (TestingToolsProof)" (is-ok founded & bb-has-good v actor (BbGoods { item = 25, graphic = #0E86 }) 0)
        a
      end
