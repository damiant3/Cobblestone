Chapter: BvtDaySave
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter EconomyCurrencyCodec
  cites Uoaix chapter BvtCheck

  bvt-day-save : Integer -> [Console] Integer
  bvt-day-save (unused) = act
    a <- bvt-check "a 720-second game day set on the panel is still set after a save and restore (row 27)" (bvt-ds-round 720 8 == 720)
    b <- bvt-check "a saved day length the panel would refuse restores as no setting" (bvt-ds-round 5 8 == 0)
    c <- bvt-check "a day section with a wrong length word is refused" (bvt-ds-round 720 9 == 0 - 1)
    a + b + c
  end
  bvt-ds-round : Integer, Integer -> Integer
  bvt-ds-round (seconds) (length) = let buf = alloc-bytes (cc-size 64)
    in let version = poke-qword buf 8 38
    in let currency = poke-qword buf 64 euc-bytes
    in let room = poke-qword buf (cc-v34-size 64 + 8) cc-worker-room
    in let put = cc-put-day buf 64 seconds
    in let framed = poke-qword buf (cc-v35-size 64 cc-worker-room) length
    in cc-day-seconds buf 64
