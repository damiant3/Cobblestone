Chapter: BvtGmGrow
  cites Uoaix chapter GmMemory
  cites Uoaix chapter BvtCheck

  bgg-grow : GmMemory, Integer -> Integer
  bgg-grow (m) (k) = if k == 0 then 0 else let g = gm-grow m in bgg-grow m (k - 1)
  bgg-spent : Integer -> List Integer
  bgg-spent (unused) = let m = gm-memory-new 0
    in let before = __heap-save
    in let grown = bgg-grow m 16
    in let after = __heap-save
    in [after - before, list-length m.names, list-length m.accounts]
  bvt-gm-grow : Integer -> [Console] Integer
  bvt-gm-grow (unused) = let r = bgg-spent 0
    in let names-bytes = list-at r 1 * 8
    in act
      a <- bvt-check ("sixteen GM growths keep every account's name cell: " & show (list-at r 1) & " cells, " & show (list-at r 2) & " accounts") (list-at r 1 == 17 * 8320 & list-at r 2 == 17 * 128)
      b <- bvt-check ("sixteen GM growths allocate under six times the names they end with (doubling spends about four, a copy per growth about ten), not a copy of the list per growth (red, UOAIX audit 2026-10-18): " & show (list-at r 0) & " bytes for " & show names-bytes) (list-at r 0 < 6 * names-bytes)
      a + b
    end
