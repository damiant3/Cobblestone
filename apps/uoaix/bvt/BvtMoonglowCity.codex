Chapter: BvtMoonglowCity
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvt-moonglow-city : Integer -> [Console] Integer
  bvt-moonglow-city (unused) = let cities = ct-table 0
    in let i = ct-city-at cities 4440 1100 0
    in act
      a <- bvt-check "Moonglow's town (its shops and the thief guildmaster's 4374,1041 to 4488,1176) is a city with a window of whole blocks around it (UOAIX-217)" (i > 0 & (list-at cities i).name == "Moonglow" & ct-city-at cities 4385 1058 0 == i & ct-city-at cities 4526 1069 0 == i & ct-city-at cities 4470 1157 0 == i & ct-x (list-at cities i) < 4374 & ct-x (list-at cities i) + ct-width (list-at cities i) > 4530)
      b <- bvt-check "Moonglow's outlying farms and guild houses and the Lycaeum lie outside its window, spawned by the pulse of a player there" (ct-city-at cities 4625 1321 0 == -1 & ct-city-at cities 4543 856 0 == -1 & ct-city-at cities 4308 1012 0 == -1)
      a + b
    end