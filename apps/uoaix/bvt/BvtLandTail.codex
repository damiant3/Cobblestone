Chapter: BvtLandTail
  cites Uoaix chapter GmLand
  cites Uoaix chapter BvtCheck

  bvt-land-tail : Integer -> [Console] Integer
  bvt-land-tail (unused) = act
    s <- gld-new 0
    a1 <- gld-set s 1420 1698 #0003 10 1
    a2 <- gld-set s 1421 1698 gld-keep 12 1
    a3 <- gld-set s 1500 1600 #0009 0 2
    buf <- alloc-bytes 4096
    zero <- gld-zero buf 0 512
    wrote <- gld-write-tail s buf
    back <- gld-new 0
    read <- gld-read-tail back buf (gld-tail-length buf 4096)
    row <- gld-find back 1421 1698
    a <- bvt-check "pending land edits survive the composite tail: three rows written and read back, found by their tile with art and height (UOAIX-250)" (wrote == buf + 8 + 3 * gld-row-bytes & read == 0 & back.count == 3 & row >= 0 & gld-field back row 2 == gld-keep & gld-field back row 3 == 12 & gld-field back (gld-find back 1420 1698) 2 == #0003 & gld-find back 1500 1601 < 0)
    blank <- alloc-bytes 64
    cleared <- gld-zero blank 0 8
    old <- gld-new 0
    none <- gld-read-tail old blank (gld-tail-length blank 64)
    short <- gld-tail-length blank 4
    b <- bvt-check "a tail that ends with the decorator's rows (zero padding or no room, an image saved before) holds no land edits" (none == 0 & old.count == 0 & short == 0 & gld-tail-length blank 64 == 8)
    over <- poke-qword blank 0 2
    c <- bvt-check "a land count that overruns the tail's room is refused" (gld-tail-length blank 64 == 0 - 1)
    a + b + c
  end
