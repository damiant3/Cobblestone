Chapter: BvtLaunch
  cites Uoaix chapter CompositeLaunch
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-launch : Integer -> [Console] Integer
  bvt-launch (unused) = act
    a <- bvt-check "launch record UOAIX TESTING sets testing and dev, and leaves the economy closed" (when cl-parse [85,79,65,73,88,32,84,69,83,84,73,78,71,10] is Ok (m) -> m.testing & m.dev & not m.open is Err (_) -> False)
    b <- bvt-check "launch record with an unknown mode is refused" (when cl-parse [85,79,65,73,88,32,66,79,71,85,83,10] is Ok (_) -> False is Err (_) -> True)
    c <- bvt-check "launch record UOAIX TESTING OPEN sets testing and opens the economy at boot" (when cl-parse [85,79,65,73,88,32,84,69,83,84,73,78,71,32,79,80,69,78,10] is Ok (m) -> m.testing & m.dev & m.open is Err (_) -> False)
    d <- bvt-check "no other launch opens the economy: DEV and an empty record leave it closed" ((when cl-parse [85,79,65,73,88,32,68,69,86,10] is Ok (m) -> not m.open is Err (_) -> False) & (when cl-parse [] is Ok (m) -> not m.open & not m.testing is Err (_) -> False))
    e <- bvt-launch-hours 0
    f <- bvt-check "LINKS 64 before UOAIX TESTING sets 64 game links and keeps the mode; no line means 32" ((when cl-parse ([76,73,78,75,83,32,54,52,10] & [85,79,65,73,88,32,84,69,83,84,73,78,71,10]) is Ok (m) -> m.links == 64 & m.testing is Err (_) -> False) & (when cl-parse [85,79,65,73,88,32,84,69,83,84,73,78,71,10] is Ok (m) -> m.links == 32 is Err (_) -> False))
    g <- bvt-check "LINKS 0 asks for links admitted by box load" (when cl-parse ([76,73,78,75,83,32,48,10] & [85,79,65,73,88,32,68,69,86,10]) is Ok (m) -> m.links == 0 & m.dev is Err (_) -> False)
    h <- bvt-check "LINKS past 256, with no digits or with a letter is refused" ((when cl-parse [76,73,78,75,83,32,51,48,48,10] is Ok (_) -> False is Err (_) -> True) & (when cl-parse [76,73,78,75,83,32,10] is Ok (_) -> False is Err (_) -> True) & (when cl-parse [76,73,78,75,83,32,54,120,10] is Ok (_) -> False is Err (_) -> True))
    i <- bvt-check "NET 192.168.1.20 192.168.1.1 255.255.255.0 before UOAIX DEV sets the NIC's address, gateway and mask; no line means 10.0.2.15 behind 10.0.2.2 (UOAIX stage D2)" ((when cl-parse (text-to-utf8-bytes "NET 192.168.1.20 192.168.1.1 255.255.255.0\nUOAIX DEV\n") is Ok (m) -> m.dev & cl-address m 0 == [192,168,1,20] & cl-address m 4 == [192,168,1,1] & cl-address m 8 == [255,255,255,0] is Err (_) -> False) & (when cl-parse (text-to-utf8-bytes "UOAIX DEV\n") is Ok (m) -> cl-address m 0 == [10,0,2,15] & cl-address m 4 == [10,0,2,2] is Err (_) -> False))
    j <- bvt-check "NET with its gateway outside the subnet, a quad past 255 or a missing quad is refused; LINKS then NET then the mode keeps all three" ((when cl-parse (text-to-utf8-bytes "NET 192.168.1.20 10.0.0.1 255.255.255.0\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "NET 192.168.1.256 192.168.1.1 255.255.255.0\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "NET 192.168.1.20 192.168.1.1\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "LINKS 8\nNET 10.1.1.5 10.1.1.1 255.255.0.0\nUOAIX TESTING\n") is Ok (m) -> m.links == 8 & m.testing & cl-address m 0 == [10,1,1,5] is Err (_) -> False))
    k <- bvt-check "the launch LF a QEMU launcher sends ahead of the record is skipped" (cl-trim [10,10,85] 0 == [85] & cl-trim [85] 0 == [85])
    l <- bvt-check "TICKET 3600 before LINKS 8 and UOAIX TESTING sets a 3600 s relay ticket and keeps both; no line means 120 s (the live bound)" ((when cl-parse (text-to-utf8-bytes "TICKET 3600\nLINKS 8\nUOAIX TESTING\n") is Ok (m) -> m.ticket == 3600 & m.links == 8 & m.testing is Err (_) -> False) & (when cl-parse (text-to-utf8-bytes "UOAIX TESTING\n") is Ok (m) -> m.ticket == 120 is Err (_) -> False))
    n <- bvt-check "TICKET 0, past 12000, with no digits or with a letter is refused" ((when cl-parse (text-to-utf8-bytes "TICKET 0\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "TICKET 12001\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "TICKET \nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True) & (when cl-parse (text-to-utf8-bytes "TICKET 9x\nUOAIX DEV\n") is Ok (_) -> False is Err (_) -> True))
    a + b + c + d + e + f + g + h + i + j + k + l + n
  end
  bvt-launch-hours : Integer -> [Console] Integer
  bvt-launch-hours (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("hours economy: " & e) False
    is Ok (x) -> bvt-check "a founded economy's hour advances to 2 and its state stays valid (cg-economy-hours, the town step's clock)" (x.world.hour == 0 & cg-economy-hours x 2 2 & x.world.hour == 2 & ev-valid x.world)
