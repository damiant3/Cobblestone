Chapter: BvtRenown
  cites Uoaix chapter CharacterSkills
  cites Uoaix chapter WorldSpawnRenown
  cites Uoaix chapter BvtCheck

  bvt-renown : Integer -> [Console] Integer
  bvt-renown (unused) = act
    a <- bvt-check "UOAIX-181: killing a ghoul (karma -4000) raises karma 0 to 53 and fame 0 to 53 (UOX3 1/75 of the gap)" (chs-karma-after 0 (0 - 4000) == 53 & chs-fame-after 0 4000 == 53)
    b <- bvt-check "UOAIX-181: killing a healer (karma 1000) lowers karma 0 to -20 (1/50 of the gap)" (chs-karma-after 0 1000 == 0 - 20)
    c <- bvt-check "UOAIX-181: fame stops at 10000 and does not rise from a weaker kill; a dying character loses 1/25" (chs-fame-after 9990 15000 == 10000 & chs-fame-after 5000 450 == 5000 & chs-fame-dying 1000 == 960 & chs-fame-dying 0 == 0)
    d <- bvt-check "UOAIX-181: a neutral character has no title; a glorious one is The Glorious Lord, or Lady; the darkest is The Outcast" (chs-fame-title 0 0 False == "" & chs-fame-title 10000 10000 False == "The Glorious Lord " & chs-fame-title 10000 10000 True == "The Glorious Lady " & chs-fame-title (0 - 10000) 0 False == "The Outcast ")
    e <- bvt-check "UOAIX-181: the karma line names its size (UOX3 1367-1372)" (chs-rep-said 0 20 "karma" == "You have gained a little karma." & chs-rep-said 0 (0 - 40) "karma" == "You have lost some karma." & chs-rep-said 0 53 "fame" == "You have gained a lot of fame.")
    table <- brn-table 0
    f <- bvt-check "UOAIX-181: the skill table accepts fame 10000 and karma -10000, refuses fame 10001 and a skill past 1000" (brn-valid table 46 10000 & brn-valid table 47 (0 - 10000) & not (brn-valid table 46 10001) & not (brn-valid table 3 1001))
    g <- bvt-check "UOAIX-181: a ghoul carries UOX3 fame 4000 and karma -4000; every spawn key has both values" (list-at wsr-fame (wsr-at "ghoul" 0) == 4000 & list-at wsr-karma (wsr-at "ghoul" 0) == 0 - 4000 & list-length wsr-fame == list-length wsr-keys & list-length wsr-karma == list-length wsr-keys)
    a + b + c + d + e + f + g
  end
  brn-table : Integer -> Integer
  brn-table (unused) = chs-new 0
  brn-valid : Integer, Integer, Integer -> Boolean
  brn-valid (table) (cell) (value) = let set = poke-qword table (8 + cell * 8) value
    in let ok = chs-valid table 0
    in let cleared = poke-qword table (8 + cell * 8) 0 in ok
