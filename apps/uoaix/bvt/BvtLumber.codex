Chapter: BvtLumber
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-lumber : Integer -> [Console] Integer
  bvt-lumber (unused) = act
    a <- bvt-check "a lumberjack whose 16 trees are all felled searches outward for the next unlogged tree" (cg-lumber-searches 16 & cg-lumber-searches 95)
    b <- bvt-check "the search stops at 96 lumber sites, leaving the rest for players and the farm" (not (cg-lumber-searches 96))
    a + b
  end