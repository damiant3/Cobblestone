Chapter: BvtYewWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-yew-workers : Integer -> [Console] Integer
  bvt-yew-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-yew (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-herbalist >= s & cw-vendor c bb-fishmonger == -1 & cw-vendor c 1 == -1
    a <- bvt-check "Yew's workers sell to its own keepers: a herbalist and no fishmonger or blacksmith (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-herb-farm & cw-wants c cgg-farm-place
    unwanted <- cw-wants c (cgg-place + 1) | cw-wants c cgg-lumber-place | cw-wants c cgg-fish-place
    b <- bvt-check "Yew founds a herb farmer and a field farmer on its wheat field, and no miner, lumberjack or fisherman" (wanted & not unwanted)
    door <- cw-door 3
    d <- bvt-check "Yew (city 3) builds a worker city whose lodging door is Empath Abbey's, 607,819" (is-just (cw-city (ct-table 0) shops ct-shop-roles 3) & door.x == 607 & door.y == 819)
    a + b + d
  end
