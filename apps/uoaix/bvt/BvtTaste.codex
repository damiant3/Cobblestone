Chapter: BvtTaste
  cites Uoaix chapter ActiveSkillsPoisoning
  cites Uoaix chapter ActiveSkillsTaste
  cites Uoaix chapter GameHunger
  cites Uoaix chapter BvtCheck

  bvt-taste : Integer -> [Console] Integer
  bvt-taste (unused) = act
    a <- bvt-check "poison on food keeps its strength with no charges; on a weapon it keeps 18 - 2 x strength charges" (as-poison-mark True 3 == 768 & as-poison-mark False 3 == 780 & as-poison-mark True 1 == 256)
    b <- bvt-check "Taste Identification finds poison smeared on poisoned food" (as-taste-said 768 == "It appears to have poison smeared on it." & as-taste-said 256 == "It appears to have poison smeared on it.")
    c <- bvt-check "clean food tastes of nothing unusual" (as-taste-said 0 == "You detect nothing unusual about this substance." & as-taste-said 255 == "You detect nothing unusual about this substance.")
    d <- bvt-check "eating food poisoned at strength 1 to 4 poisons at Lesser to Deadly; clean food poisons nobody" (gh-venom 256 == 0 & gh-venom 1024 == 3 & gh-venom 0 < 0 & gh-venom 200 < 0)
    a + b + c + d
  end
