Chapter: BvtGreeting
  cites Uoaix chapter TownLiveState
  cites Uoaix chapter BvtCheck

  bvt-gr-at : Integer, Integer -> WorldObject
  bvt-gr-at (x) (y) = WorldObject { serial = 1, kind = 1, x = x, y = y, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
  bvt-greeting : Integer -> [Console] Integer
  bvt-greeting (unused) = let shop = list-at bb-shops 3
    in let inside = bvt-gr-at shop.x1 shop.y1
    in let door = bvt-gr-at (shop.x2 + 2) shop.y1
    in let road = bvt-gr-at (shop.x2 + 3) shop.y1
    in let home = bvt-gr-at tl-home-region.x1 tl-home-region.y1
    in act
    a <- bvt-check "an NPC and a player inside or at the door of its own shop may greet (main 40159)" (tl-at-work 3 inside door & tl-at-work 3 door inside)
    b <- bvt-check "no greeting with the NPC on the road or at home, or the player outside its shop" (not (tl-at-work 3 road inside) & not (tl-at-work 3 inside road) & not (tl-at-work 3 home inside) & not (tl-at-work (0 - 1) inside inside))
    c <- bvt-check "the greeting follows the hour and the shop state" (tl-salute (9 * 3600) 1 == "Good morning." & tl-salute (14 * 3600) 1 == "Good afternoon."
      & text-contains (tl-salute (19 * 3600) 1) "close at eight" & text-contains (tl-salute (23 * 3600) 2) "closed")
    d <- bvt-check "the bank warns of no closing, and an open shop says nothing of being closed" (tl-salute (19 * 3600) 0 == "Good evening." & not (text-contains (tl-salute (9 * 3600) 1) "closed"))
    a + b + c + d
  end
