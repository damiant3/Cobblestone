Chapter: BvtBuccWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtVesperWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-bucc-workers : Integer -> [Console] Integer
  bvt-bucc-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-bucc (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c 1 == s + bvv-k shops "Cutlass Smithing" 0 & bvv-k shops "Cutlass Smithing" 0 >= 0 & cw-vendor c bb-fishmonger == -1
    a <- bvt-check "Buccaneer's Den's ore goes to Cutlass Smithing; it keeps no fishmonger (UOAIX-217 W2)" own
    wanted <- cw-wants c (cgg-place + 1)
    unwanted <- cw-wants c cgg-fish-place | cw-wants c cgg-herb-farm | cw-wants c cgg-farm-place | cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place
    b <- bvt-check "Buccaneer's Den founds miners on its mountain spur, and no fisherman, herb farmer, field farmer, shepherd or lumberjack" (wanted & not unwanted)
    door <- cw-door 11
    d <- bvt-check "Buccaneer's Den (city 11) builds a worker city whose inn door is The Peg Leg Inn's, 2717,2090" (is-just (cw-city (ct-table 0) shops ct-shop-roles 11) & door.x == 2717 & door.y == 2090)
    a + b + d
  end
