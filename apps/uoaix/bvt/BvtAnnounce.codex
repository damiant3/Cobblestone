Chapter: BvtAnnounce
  cites Uoaix chapter WorldRecords
  cites Uoaix chapter GameSession
  cites Uoaix chapter BvtCheck

  bvt-announce : Integer -> [Console] Integer
  bvt-announce (unused) = when world-new 64
    is Err (e) -> bvt-check ("announce fixture: " & e) False
    is Ok (w) -> when world-create w (gs-mobile 0 1475 1645 0 400 1002)
      is Err (e) -> bvt-check ("announce guard: " & e) False
      is Ok (guard) -> when world-create w (gs-mobile 0 1476 1645 0 400 1002)
        is Err (e) -> bvt-check ("announce second guard: " & e) False
        is Ok (other) -> let first = world-announce-text w guard "Step into the cell."
          in let again = world-announce-text w guard "Step into the cell."
          in let third = world-announce-text w guard "Step into the cell."
          in let changed = world-announce-text w guard "Thou shalt serve 2 hours in this cell."
          in let back = world-announce-text w guard "Step into the cell."
          in let peer = world-announce-text w other "Step into the cell."
          in let cleared = world-state-clear w guard
          in let fresh = world-announce-text w guard "Step into the cell."
          in let view = (world-view w.buffer w.capacity)
          in let unindexed = world-announce-text view guard "Step into the cell." & world-announce-text view guard "Step into the cell."
          in act
            a <- bvt-check "a guard announces a state once: the same line again and again is not repeated (NpcSpeech ruling)" (first & not again & not third)
            b <- bvt-check "a changed state is announced, and the earlier one again after it" (changed & back)
            c <- bvt-check "the record is one per NPC: another guard still announces the same line" peer
            d <- bvt-check "a cleared NPC (a guard back on patrol, a baker gone home) announces again" fresh
            e <- bvt-check "a world view with no index announces every time" unindexed
            a + b + c + d + e
          end
