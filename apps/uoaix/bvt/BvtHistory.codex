Chapter: BvtHistory
  cites Uoaix chapter CompositeHistory
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BritainProduction
  cites Uoaix chapter GameVendorState
  cites Uoaix chapter EconomyCurrency
  cites Uoaix chapter BvtCheck

 The admin panel's market history (Damian 2026-10-09). Bits: 1 a record in a new hour adds one row; 2 a second record
 in the same hour adds none; 4 the answer carries the treasury series and one item's price and stock series; 8 an
 unbound history answers history-unbound; 15 is all.
  bhy-checks : Integer -> Integer
  bhy-checks (unused) = when cg-game 512
    is Err (_) -> -1
    is Ok (game) -> when bb-economy 0
      is Err (_) -> -2
      is Ok (currency) -> let v = gv-new game currency
        in let items = list-length currency.world.catalog.items
        in let buf = ch-new items
        in let first = ch-record buf v
        in let again = ch-record buf v
        in let one = ch-count buf
        in let advanced = eu-hour currency
        in let next = ch-record buf v
        in let answer = ch-json buf currency.world 13
        in (if first == 1 & one == 1 & ch-count buf == 2 then 1 else 0)
          + (if again == 0 then 2 else 0)
          + (if text-contains answer "\"rows\":2" & text-contains answer "\"gold\":[" & text-contains answer "\"item\":13" & text-contains answer "\"price\":[" & text-contains answer "\"stock\":[" then 4 else 0)
          + (if text-contains (ch-json 0 currency.world 13) "history-unbound" then 8 else 0)
  bvt-history : Integer -> [Console] Integer
  bvt-history (unused) = let code = bhy-checks 0 in act
    a <- bvt-check ("admin history: one row a game hour, none twice in an hour, treasury and one item's price and stock series, unbound refused (code " & show code & ")") (code == 15)
    a
  end
