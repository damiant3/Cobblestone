Chapter: BvtCarpenter
  cites Uoaix chapter BritainShops
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvcp-holds : Integer, Integer -> Boolean
  bvcp-holds (boards) (nails) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1007) 100
      in if actor < 1 then False
      else let a = ep-set (ep-actor w actor).stock 38 boards in let b = ep-set (ep-actor w actor).stock 39 nails in bb-from-bought w actor 47
  bvcp-lists : Integer -> Boolean
  bvcp-lists (i) = if i >= list-length (bb-goods bb-carpenter) then False
    else let g = list-at (bb-goods bb-carpenter) i in (g.item == 47 & g.graphic == #0B2C) | bvcp-lists (i + 1)
  bvt-carpenter : Integer -> [Console] Integer
  bvt-carpenter (unused) = act
    a <- bvt-check "the carpenter lists furniture (47, 0x0B2C), buys nails, and sells furniture back" (bvcp-lists 0 & gvb-material (gvb-role bb-carpenter) 39 & gvb-goods (gvb-role bb-carpenter) 47 & gvb-item-of #0B2C == 47)
    b <- bvt-check "four bought boards and two bought nails make furniture" (bvcp-holds 4 2 & bvcp-holds 9 9)
    c <- bvt-check "one nail short or one board short makes no furniture" (not (bvcp-holds 4 1) & not (bvcp-holds 3 2) & not (bvcp-holds 0 0))
    d <- bvt-check "the carpenter buys nails only when it holds none and the tinker offers a lot" (bb-buys 0 0 & not (bb-buys 2 0) & not (bb-buys 0 (0 - 1)) & bb-tinker == 6 & bb-carpenter == 7)
    a + b + c + d
  end