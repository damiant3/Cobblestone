Chapter: BvtVein
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvt-vein-dig : EgGatherer, Integer -> Integer
  bvt-vein-dig (g) (left) = if left == 0 then 0 else let got = egg-hour g in if got > 0 then got else bvt-vein-dig g (left - 1)
  bvt-vein : Integer -> [Console] Integer
  bvt-vein (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("vein fixture economy: " & e) False
    is Ok (x) -> when egg-new x 3001 200
      is Err (e) -> bvt-check ("vein fixture gatherer: " & e) False
      is Ok (g) -> act
        spot <- BbSpot { x = 1410, y = 1630, z = 0 }
        c <- cgg-make g 0 spot spot 2 0 0 0
        first <- bvt-vein-dig g 200
        spent <- not (cgg-ready c)
        again <- cgg-vein-set c True
        f <- bvt-check "a vein made ready again within its visit is ready now, so the economy still saves (fresh-world SAVE SECTION FAILED, nodes)" (ev-valid x.world)
        second <- bvt-vein-dig g 200
        a <- bvt-check "a miner's vein spent by a swing is made ready again within its visit and yields again (miners, live 40204)" (first > 0 & spent & again == 1 & second > 0)
        closed <- cgg-vein-set c False
        b <- bvt-check "leaving spends the vein: a harvest is refused until it regrows" (closed == 1 & not (cgg-ready c) & eh-harvest x.world g.producer.actor g.node == -1)
        face <- BbSpot { x = 1450, y = 1531, z = 0 }
        fresh <- cgg-fresh-vein c x.world face
        d <- bvt-check "a miner whose vein is spent takes a ready vein at the next spot along the rock instead of idling (find resource, Damian 2026-10-08)" (fresh == 1 & cgg-ready c & c.node.x == 1450 & c.node.y == 1531)
        fisher <- cgg-make g 0 (BbSpot { x = 1410, y = 1630, z = 0 }) (BbSpot { x = 1410, y = 1630, z = 0 }) 0 0 0 0
        retraded <- __record-set fisher "trade" (cgg-trade-of cgg-fish-place)
        e <- bvt-check "a worker of another trade is not sent to the rock" (cgg-fresh-vein fisher x.world face == 0 & fisher.node.x == 1410)
        a + b + d + e + f
      end
