Chapter: BvtMonsterPoison
  cites Uoaix chapter GameWorldSpawn
  cites Uoaix chapter WorldSpawnData
  cites Uoaix chapter GameCombat
  cites Uoaix chapter BvtCheck

  bvt-monster-poison : Integer -> [Console] Integer
  bvt-monster-poison (unused) = act
    a <- bvt-check "UOAIX-182: a dread spider and a poison elemental poison lethally, a giant spider and a snake lesser (UOX3 POISONSTRENGTH)" (gws-poison-of "dreadspider" 0 == 5 & gws-poison-of "poisonele" 0 == 5 & gws-poison-of "giantspider" 0 == 1 & gws-poison-of "snake" 0 == 1)
    b <- bvt-check "UOAIX-182: a drake, a dragon and a zombie, which share bodies with poisoners, do not poison" (gws-poison-of "graydrake" 0 == 0 & gws-poison-of "graydragon" 0 == 0 & gws-poison-of "zombie" 0 == 0)
    c <- bvt-check "UOAIX-182: every poison key is a spawn profile key and every level is 1 to 5" (bmp-keys-known (wsd-catalog 0) 0 & bmp-levels-ok 0)
    d <- bvt-check "UOAIX-182: a combat with no spawns poisons nothing (cb-no-poison)" (cb-no-poison 7 == 0)
    a + b + c + d
  end
  bmp-keys-known : WsCatalog, Integer -> Boolean
  bmp-keys-known (c) (i) = if i == list-length gws-poison-keys then True
    else if bmp-profile c.profiles (list-at gws-poison-keys i) 0 then bmp-keys-known c (i + 1) else False
  bmp-profile : List WsProfile, Text, Integer -> Boolean
  bmp-profile (ps) (key) (i) = if i == list-length ps then False else if (list-at ps i).key == key then True else bmp-profile ps key (i + 1)
  bmp-levels-ok : Integer -> Boolean
  bmp-levels-ok (i) = if i == list-length gws-poison-levels then list-length gws-poison-levels == list-length gws-poison-keys
    else if list-at gws-poison-levels i < 1 | list-at gws-poison-levels i > 5 then False else bmp-levels-ok (i + 1)
