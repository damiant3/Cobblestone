Chapter: BvtRingGump
  cites Uoaix chapter CompositeEvents
  cites Uoaix chapter BvtCheck

 UOAIX-230: a gump told to the other seat goes through the event ring, which kept 512 bytes a row and dropped a card
 table's gump; it now keeps a whole gump for its one listener.
  brg-bytes : Integer, List Integer -> List Integer
  brg-bytes (n) (out) = if n == 0 then out else brg-bytes (n - 1) (list-push out (int-mod n 251))
  bvt-ring-gump : Integer -> [Console] Integer
  bvt-ring-gump (unused) = let ring = ce-new 0
    in let gump = brg-bytes 3000 (__list-with-capacity 3000)
    in let kept = ce-add-to ring 0 0 7 0 0 gump
    in let heard = ce-pending ring 7 (\s -> False) (\s -> False) True 1000 1000 0 0 []
    in let other = ce-pending ring 8 (\s -> False) (\s -> False) True 1000 1000 0 0 []
    in let huge = ce-add-to ring 0 0 7 0 0 (brg-bytes (ce-bytes + 1) (__list-with-capacity (ce-bytes + 1)))
    in act
      a <- bvt-check "a 3000-byte gump told to one seat is kept and heard by that seat alone, whole (UOAIX-230)" (kept == 1 & list-length heard == 1 & list-length (list-at heard 0) == 3000 & list-at (list-at heard 0) 2999 == list-at gump 2999 & list-length other == 0)
      b <- bvt-check "a packet past a row is still refused, not cut" (huge == 0)
      a + b
    end
