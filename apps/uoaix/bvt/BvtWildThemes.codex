Chapter: BvtWildThemes
  cites Uoaix chapter WorldSpawnData
  cites Uoaix chapter BvtCheck

  bwth-group : List WsGroup, Text, Integer -> Integer
  bwth-group (groups) (key) (i) = if i >= list-length groups then -1 else if (list-at groups i).key == key then i else bwth-group groups key (i + 1)
  bwth-has : List WsChoice, Text, Integer -> Boolean
  bwth-has (choices) (key) (i) = if i >= list-length choices then False else (list-at choices i).key == key | bwth-has choices key (i + 1)
  bwth-in : WsCatalog, Text, Text -> Boolean
  bwth-in (c) (region) (key) = let i = bwth-group c.groups region 0 in if i < 0 then False else bwth-has (list-at c.groups i).choices key 0
  bwth-most : List WsRegion, Integer, Integer -> Integer
  bwth-most (regions) (id) (i) = if i >= list-length regions then -1 else if (list-at regions i).id == id then (list-at regions i).maximum else bwth-most regions id (i + 1)
  bvt-wild-themes : Integer -> [Console] Integer
  bvt-wild-themes (unused) = let c = wsd-catalog 0
    in act
      a <- bvt-check "the mainland swamps spawn lizardmen and snakes, Dagger Isle polar bears, walruses and white wolves, and Fire Isle Jungle 6 (the Shrine of Humility) daemons and dragons (UOAIX-218, Damian 2026-10-09)" (bwth-in c "region-5660" "lizardman" & bwth-in c "region-5850" "snake" & bwth-in c "region-5795" "walrus" & bwth-in c "region-5798" "polarbear" & bwth-in c "region-5873" "daemon" & bwth-in c "region-5873" "dragon")
      b <- bvt-check "the themes stay in their regions: the swamp savages' camp and the Britain cemetery gain no daemon, dragon or lizardman" (bwth-group c.groups "region-5852" 0 >= 0 & not (bwth-in c "region-5852" "daemon") & not (bwth-in c "region-5505" "dragon") & not (bwth-in c "region-5505" "lizardman"))
      d <- bvt-check ("a themed region holds 2.4 creatures a thousand tiles, as the densest wild regions do; an unthemed one keeps the source's maximum (Yew Peninsula NE, 43296 tiles, 35): " & show (bwth-most c.regions 5850 0) & " " & show (bwth-most c.regions 5794 0) & " " & show (bwth-most c.regions 5600 0)) (bwth-most c.regions 5850 0 == 145 & bwth-most c.regions 5794 0 == 63 & bwth-most c.regions 5873 0 == 194 & bwth-most c.regions 5600 0 == 35)
      a + b + d
    end