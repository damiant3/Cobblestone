Chapter: BvtBowcraft
  cites Uoaix chapter GameCraft
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bbc-recipe : EpWorld, Integer -> EgRecipe
  bbc-recipe (w) (row) = list-at w.catalog.recipes (list-at (gcr-recipes w 6) row - 1)
  bvt-bowcraft : Integer -> [Console] Integer
  bvt-bowcraft (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("bowcraft fixture economy: " & e) False
    is Ok (currency) -> let w = currency.world
      in let bow = bbc-recipe w 0
      in let arrows = bbc-recipe w 1
      in act
        a <- bvt-check "the fletcher's menu makes a bow (48) from 2 boards and 1 thread, and 4 arrows (49) from a board and a stone, at the carpentry bench with a knife (row 25 slice 7)" (list-length (gcr-recipes w 6) == 2 & bow.item == 48 & bow.one == 38 & bow.one-count == 2 & bow.two == 36 & bow.two-count == 1 & bow.tool == 27 & arrows.item == 49 & arrows.quantity == 4 & arrows.one == 38 & arrows.one-count == 1 & arrows.two == 1 & arrows.two-count == 1 & arrows.tool == 27 & bow.station == arrows.station & bow.station == (list-at w.catalog.recipes (list-at (gcr-recipes w 3) 1 - 1)).station)
        b <- bvt-check "the fletcher's tools open the Bowcraft menu and draw a bow as 0x13B2 and arrows as 0x0F3F" (gcr-category 42 #1022 == 6 & gcr-graphic 48 == #13B2 & gcr-graphic 49 == #0F3F)
        a + b
      end
