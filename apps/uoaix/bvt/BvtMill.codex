Chapter: BvtMill
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter BvtCheck

  bvt-mill : Integer -> [Console] Integer
  bvt-mill (unused) = act
    a <- bvt-check "the paper mill is shop 9, in The Miner's Guild" (bb-shop-count >= 9 & (list-at bb-shops 8).premises == "The Miner's Guild")
    b <- bvt-check "the mill lists blank scrolls (0x0EF3), blank books (0x0FF2), blank maps (0x14EC) and parchment (126)" (list-length (bb-goods 8) == 4 & (list-at (bb-goods 8) 0).item == 106 & (list-at (bb-goods 8) 1).graphic == #0FF2 & (list-at (bb-goods 8) 2).item == 117 & (list-at (bb-goods 8) 3).item == 126)
    c <- bvt-check "a lumberjack selling to the mill sells logs, unsawn" ((cgg-log-trade cgg-mill).buyer == 8 & (cgg-log-trade cgg-mill).raw == 15 & (cgg-log-trade cgg-mill).product == 15)
    d <- bvt-check "otherwise the lumberjack still saws boards for the carpenter" ((cgg-trade-of cgg-lumber-place).buyer == 7 & (cgg-trade-of cgg-lumber-place).product == 38)
    a + b + c + d
  end