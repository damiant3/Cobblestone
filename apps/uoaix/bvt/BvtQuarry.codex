Chapter: BvtQuarry
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-quarry : Integer -> [Console] Integer
  bvt-quarry (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("quarry fixture economy: " & e) False
    is Ok (x) -> act
      t <- cgg-trade-of cgg-stone-place
      a <- bvt-check "the quarrier gathers stone (item 1) by hand at the rock faces and sells it to the provisioner (row 21)" (t.raw == 1 & t.product == 1 & t.tool == 0 & t.buyer == 0 & cgg-rock-worker t & not (cgg-rock-worker (cgg-trade-of cgg-fish-place)))
      b <- bvt-check "the quarrier is founded right after the clay gatherer, before the herbalist's pickers" (list-at cg-founders (list-length cgw-places + 3) == cgg-stone-place & list-at cg-founders (list-length cgw-places + 2) == cgg-clay-place & list-at cg-founders (list-length cgw-places + 4) == 404)
      c <- bvt-check "the provisioner bids for stone" (gvb-material 0 1 & gvb-bid x.world 0 1 >= 1)
      crown <- ep-admit x.world (eu-open x 2 2999) 100
      bare <- not (bb-restock-input x.world crown 38) & not (bb-restock-input x.world crown 25)
      logs <- ep-find x.world crown 15 2
      axe <- ep-find x.world crown 26 1
      stone <- ep-find x.world crown 1 2
      board <- ep-find x.world crown 38 1
      d <- bvt-check "a shop restocks boards only from 2 logs and an axe it holds, and a pickaxe only from 2 stone and a board it holds" (crown > 0 & bare & logs >= 0 & axe >= 0 & stone >= 0 & board >= 0 & bb-restock-input x.world crown 38 & bb-restock-input x.world crown 25)
      e <- bvt-check "a good with no stone, logs or boards in its recipe restocks as before" (bb-restock-input x.world crown 33)
      a + b + c + d + e
    end
