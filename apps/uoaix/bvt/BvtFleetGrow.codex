Chapter: BvtFleetGrow
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bfg-full : EuCurrency -> Boolean
  bfg-full (x) = let n = list-length x.world.money.purses
    in let a = __record-set x "purse-count" n
    in let b = __record-set x.copper "purse-count" n
    in let c = __record-set x.silver "purse-count" n
    in let d = __record-set x.world.money "purse-count" n
    in list-length x.copper.purses == n & list-length x.silver.purses == n & eu-room x
  bfg-checks : EuCurrency -> Integer
  bfg-checks (x) = if not (bfg-full x) then 0 - 1
    else let length = list-length x.world.money.purses
    in let stopped = __record-set x.world.goods.world "growing" False
    in let refused = cg-fleet-actor x 0
    in let kept = list-length x.world.money.purses == length
    in let started = __record-set x.world.goods.world "growing" True
    in let made = cg-fleet-actor x 0
    in let grew = list-length x.world.money.purses > length
    in (if refused < 1 then 1 else 0) + (if kept then 2 else 0) + (if made > 0 then 4 else 0) + (if grew then 8 else 0)
  bvt-fleet-grow : Integer -> [Console] Integer
  bvt-fleet-grow (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("fleet growth fixture economy: " & e) False
    is Ok (x) -> act
      n <- bfg-checks x
      bvt-check ("a ship's actor grows the full purse table only while the world may grow, never in play (L-BELOWMARK; red, UOAIX audit 2026-10-18; code " & show n & ", 15 is all)") (n == 15)
    end
