Chapter: BvtMintGate
  cites Uoaix chapter CompositeMinter
  cites Uoaix chapter BvtCheck

  bmg-furnished : List (List Integer), Integer, Integer, Integer -> Boolean
  bmg-furnished (rows) (x) (y) (i) = if i == list-length rows then False
    else let r = list-at rows i
    in if list-at r 1 == x & list-at r 2 == y then True else bmg-furnished rows x y (i + 1)
  bmg-in-mint : Integer, Integer -> Boolean
  bmg-in-mint (x) (y) = x >= 1329 & x <= 1339 & y >= 1600 & y <= 1608

  bvt-mint-gate : Integer -> [Console] Integer
  bvt-mint-gate (unused) = act
    a <- bvt-check "the Royal Mine's return gate lands on the mint floor beside the Royal Minter, on no furnishing (cp-royal, cbe-walk leg 3)" (bmg-in-mint cpr-mint-stand-x cpr-mint-stand-y & cpr-mint-stand-z == cmr-z & (cpr-mint-stand-x /= cmr-x | cpr-mint-stand-y /= cmr-y) & cpr-mint-stand-x - cmr-x <= 1 & cmr-x - cpr-mint-stand-x <= 1 & cpr-mint-stand-y - cmr-y <= 1 & cmr-y - cpr-mint-stand-y <= 1 & not (bmg-furnished cpl-mint-furniture cpr-mint-stand-x cpr-mint-stand-y 0))
    b <- bvt-check "the throne is not in the mint, and a furnished mint tile is found" (not (bmg-in-mint cpr-throne-x cpr-throne-y) & bmg-furnished cpl-mint-furniture 1329 1600 0)
    a + b
  end
