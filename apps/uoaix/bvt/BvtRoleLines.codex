Chapter: BvtRoleLines
  cites Uoaix chapter NpcLines
  cites Uoaix chapter BvtCheck

  bvt-role-lines : Integer -> [Console] Integer
  bvt-role-lines (unused) = act
    lib <- nl-library 0
    a <- bvt-check "a miner greeted answers a mining line and a guard asked of work a guard's line" (nl-pick lib 3 "" "miner" 0 nl-any nl-any 0 == "Mind the rocks, friend. The vein runs deep today."
      & nl-pick lib 3 "" "guard" 2 nl-any nl-any 0 == "I walk the streets of Britain and keep the peace for Lord British.")
    b <- bvt-check "a role with no lines of its own answers a townsfolk line, never another trade's, and the library stays valid" (nl-valid lib
      & text-length (nl-pick lib 3 "" "bard" 0 nl-any nl-any 0) > 0 & not (text-contains (nl-pick lib 3 "" "bard" 0 nl-any nl-any 0) "vein"))
    a + b
  end
