Chapter: BvtWorkerSale
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 0x03 speech: length at 1-2, mode, hue and font words, then the text and a NUL.
  bvt-ws-say : Text -> List Integer
  bvt-ws-say (text) = let body = gp-ascii [] text 0 (text-length text)
    in let n = 8 + list-length body + 1
    in [3, n / 256, int-mod n 256, 0, 0, 52, 0, 3] & body & [0]
  bvt-worker-sale : Integer -> [Console] Integer
  bvt-worker-sale (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("worker sale fixture economy: " & e) False
    is Ok (x) -> when egg-new x 3001 200
      is Err (e) -> bvt-check ("worker sale fixture gatherer: " & e) False
      is Ok (g) -> act
        spot <- BbSpot { x = 1410, y = 1630, z = 0 }
        c <- cgg-make g 77 spot spot 0 0 0 0
        packed <- __record-set c "pack" 88
        a <- bvt-check "buy and vendor buy ask the nearest worker to sell; a shop role word or other speech does not (row 22)" (cg-buy-said (bvt-ws-say "buy") & cg-buy-said (bvt-ws-say "vendor buy") & not (cg-buy-said (bvt-ws-say "blacksmith buy")) & not (cg-buy-said (bvt-ws-say "hello")))
        v <- cg-worker-vendor c
        b <- bvt-check "a worker sells from its own pack under its own economy actor" (v.serial == 77 & v.stock == 88 & v.actor == g.producer.actor)
        c2 <- bvt-check "a buy cart naming a worker's serial finds that worker, and another serial none" (cg-worker-at [c] 77 0 == 0 & cg-worker-at [c] 78 0 < 0)
        a + b + c2
      end
