Chapter: BvtNames
  cites Uoaix chapter GameCombat
  cites Uoaix chapter NpcNames
  cites Uoaix chapter CharacterStylist
  cites Uoaix chapter BvtCheck

  bvn-mobile : Integer, Integer -> WorldObject
  bvn-mobile (serial) (body) = WorldObject { serial = serial, kind = 1, x = 1430, y = 1690, z = 0, graphic = body, hue = 1002, container = 0, amount = 1, health = 50 }
  bvn-in : List Text, Text, Integer -> Boolean
  bvn-in (names) (name) (i) = if i == list-length names then False else list-at names i == name | bvn-in names name (i + 1)
  bvn-wears : List CstRow, Integer, Integer, Integer -> Boolean
  bvn-wears (rows) (graphic) (layer) (i) = if i == list-length rows then False
    else let r = list-at rows i in (r.graphic == graphic & r.layer == layer) | bvn-wears rows graphic layer (i + 1)
  bvn-layer : List CstRow, Integer, Integer -> Boolean
  bvn-layer (rows) (layer) (i) = if i == list-length rows then False else (list-at rows i).layer == layer | bvn-layer rows layer (i + 1)
  bvn-hued : List CstRow, Integer, Integer, Integer -> Boolean
  bvn-hued (rows) (graphic) (hue) (i) = if i == list-length rows then False
    else let r = list-at rows i in (r.graphic == graphic & r.hue == hue) | bvn-hued rows graphic hue (i + 1)
  bvn-any-hue : List CstRow, Integer, Integer -> Boolean
  bvn-any-hue (rows) (hue) (i) = if i == list-length rows then False else (list-at rows i).hue == hue | bvn-any-hue rows hue (i + 1)
  bvt-names : Integer -> [Console] Integer
  bvt-names (unused) = act
    a <- bvt-check "a man NPC's actor name is a man's name, not Opponent" (bvn-in nn-male (cb-npc-name (bvn-mobile 4242 400)) 0)
    b <- bvt-check "a woman NPC's actor name is a woman's name" (bvn-in nn-female (cb-npc-name (bvn-mobile 4243 401)) 0)
    c <- bvt-check "a creature body takes no human name and never Opponent" (let n = cb-npc-name (bvn-mobile 4244 #00CF) in n /= "Opponent" & not (bvn-in nn-male n 0) & not (bvn-in nn-female n 0))
    d <- bvt-check "a shepherd carries the crook on layer 2" (bvn-wears (cst-look cst-shepherd 4245).rows #0E81 2 0)
    e <- bvt-check "a townsperson carries no tool on layer 2" (not (bvn-layer (cst-look cst-townsfolk 4246).rows 2 0))
    f <- bvt-check "a spawned evil mage wears a robe on layer 22" (bvn-wears (cst-spawn-rows "evilmage" 4247) #1F04 22 0)
    g <- bvt-check "a spawned juka warrior wears no robe" (not (bvn-layer (cst-spawn-rows "jukawarrior" 4248) 22 0))
    h <- bvt-check "the mayor's doublet carries the mayor hue 0x0016" (bvn-hued (cst-look cst-mayor 4249).rows #1F7C #0016 0)
    k <- bvt-check "no mayor row carries the rough hue 0x0481 (drawn as noise)" (not (bvn-any-hue (cst-look cst-mayor 4250).rows #0481 0))
    a + b + c + d + e + f + g + h + k
  end
