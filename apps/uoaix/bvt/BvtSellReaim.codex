Chapter: BvtSellReaim
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtWorkerDay
  cites Uoaix chapter BvtCheck

 The founded gatherer misses its buyer with blocked misses before: answers its leg after the re-aim, and 100 more when
 its sale tile is within 2 of the keeper; -1 when the scenario cannot be built.
  bsr-miss : Integer -> Integer
  bsr-miss (before) = when bwd-founded 0
    is Err (_) -> -1
    is Ok (owner) -> when owner.gatherer
      is None -> -1
      is Just (c) -> when owner.town
        is None -> -1
        is Just (town) -> when owner.town-map
          is None -> -1
          is Just (britain) -> let v = town.vendors
            in let a = __record-set c "blocked" before
            in let b = __record-set c "leg" 3
            in let d = __record-set c "via" 1
            in let e = __record-set c.shop "x" 0
            in let r = cgg-reaim c town britain
            in when world-get v.game.world (list-at v.vendors c.trade.buyer).serial
              is Err (_) -> -1
              is Ok (keeper) -> c.leg + (if walk-abs (c.shop.x - keeper.x) <= 2 & walk-abs (c.shop.y - keeper.y) <= 2 then 100 else 0)
  bvt-sell-reaim : Integer -> [Console] Integer
  bvt-sell-reaim (unused) = act
    n <- bsr-miss 0
    m <- bsr-miss 3
    a <- bvt-check ("a seller who missed its buyer walks back to a tile beside the keeper instead of carrying the lot home (code " & show n & ")") (n == 104)
    b <- bvt-check ("its fourth miss in a row goes home (code " & show m & ")") (m == 3)
    a + b
  end
