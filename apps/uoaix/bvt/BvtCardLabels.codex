Chapter: BvtCardLabels
  cites Uoaix chapter TavernCards
  cites Uoaix chapter BvtCheck

  bvt-card-labels : Integer -> [Console] Integer
  bvt-card-labels (unused) = let a = tcd-arrange ["Crazy Eights", "", "Pile|Queen of hearts"] [400, 401] ["Hit", "Stand"]
    in let long = "Your opponent asks for queens and you hand over two of them, and then it is your turn to ask again"
    in let pieces = tcd-wrap long tcd-wide
    in let word = tcd-wrap "Abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz" tcd-wide
    in act
      x <- bvt-check "a card table's text starts inside gump 2600's 47x44 concave corners, labels and values in two columns (UOAIX-230)" (text-starts-with a.layout "{ text 52 52 0 0 }" & text-contains a.layout "{ text 52 82 0 1 }{ text 150 82 0 2 }" & not (text-contains a.layout "{ text 20 ") & not (text-contains a.layout "{ text 25 "))
      y <- bvt-check "the buttons sit under a Your move line, each label 12 pixels past the 63-pixel button 247" (text-contains a.layout "{ text 52 112 0 3 }{ button 52 132 247 248 1 0 400 }{ text 127 134 0 4 }{ button 52 158 247 248 1 0 401 }{ text 127 160 0 5 }" & list-at a.texts 3 == "Your move:")
      z <- bvt-check "a long line wraps at the last space within 46 characters, and a word longer than the line is cut (tcd-wrap)" (list-length pieces == 3 & text-length (list-at pieces 0) <= 46 & text-length (list-at pieces 1) <= 46 & list-at pieces 0 == "Your opponent asks for queens and you hand" & list-length word == 2 & text-length (list-at word 0) == 46)
      x + y + z
    end
