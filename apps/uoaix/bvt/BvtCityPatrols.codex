Chapter: BvtCityPatrols
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvcp-all : List CtCity, List CtPatrol, Integer -> Boolean
  bvcp-all (cities) (ps) (i) = if i >= list-length ps then True else ct-patrol-ok cities (list-at ps i) 0 & bvcp-all cities ps (i + 1)
  bvt-city-patrols : Integer -> [Console] Integer
  bvt-city-patrols (unused) = let cities = ct-table 0
    in let ps = ct-city-patrols 0
    in act
      a <- bvt-check "every city patrol walks four waypoints inside its own city (Trinsic's two between its UOX3 guard posts)" (list-length ps >= 2 & bvcp-all cities ps 0 & (list-at ps 0).city == 1)
      b <- bvt-check "a waypoint outside its city, a short route or Britain as a city patrol is refused" (not (ct-patrol-ok cities (CtPatrol { city = 1, xs = [1825, 1866, 1866, 1000], ys = [2676, 2644, 2676, 2676] }) 0) & not (ct-patrol-ok cities (CtPatrol { city = 1, xs = [1825], ys = [2676] }) 0) & not (ct-patrol-ok cities (CtPatrol { city = 0, xs = [1434, 1434, 1434, 1434], ys = [1690, 1690, 1690, 1690] }) 0))
      a + b
    end
