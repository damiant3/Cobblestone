Chapter: BvtReagentGatherers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  brg-sells : List BbGoods, Integer, Integer -> Boolean
  brg-sells (goods) (item) (i) = if i >= list-length goods then False
    else ((list-at goods i).item == item & gvb-item-of (list-at goods i).graphic == item) | brg-sells goods item (i + 1)
  bvt-reagent-gatherers : Integer -> [Console] Integer
  bvt-reagent-gatherers (unused) = act
    c <- cw-britain
    pearl <- cgg-trade-in c cgg-pearl-place
    silk <- cgg-trade-in c cgg-silk-place
    ash <- cgg-trade-in c cgg-ash-place
    a <- bvt-check "Britain's pearl diver fishes black pearl (23) off the shore with a fishing rod, the silk gatherer cuts spiders' silk (22) in the woods with a knife, the ash miner digs sulfurous ash (24) in the ore strip with a pickaxe, all sold to the herbalist (UOAIX-248)" (pearl.raw == 23 & pearl.product == 23 & pearl.tool == 29 & pearl.region.y1 == cgg-shore-y1 & silk.raw == 22 & silk.tool == 27 & silk.region.x1 == cgg-lumber-region.x1 & ash.raw == 24 & ash.tool == 25 & ash.region.x1 == cgg-node-region.x1 & pearl.buyer == bb-herbalist & silk.buyer == bb-herbalist & ash.buyer == bb-herbalist & cw-vendor c bb-herbalist == bb-herbalist)
    wanted <- cw-wants c cgg-pearl-place & cw-wants c cgg-silk-place & cw-wants c cgg-ash-place
    others <- cw-wants c cgg-fish-place | cw-wants c cgg-lumber-place | cw-wants c (cgg-place + 1) | cw-wants c cgg-stone-place | cw-wants c cgg-herb-farm | cw-wants c cgg-powder-place
    elsewhere <- cw-wants (cw-nujelm (ct-table 0) (ct-city-shops 0) ct-shop-roles) cgg-pearl-place | cw-wants (cw-vesper (ct-table 0) (ct-city-shops 0) ct-shop-roles) cgg-silk-place | cw-wants (cw-minoc (ct-table 0) (ct-city-shops 0) ct-shop-roles) cgg-ash-place
    b <- bvt-check "Britain founds the three reagent gatherers as city workers and no other city worker, and no other city founds one" (wanted & not others & not elsewhere)
    herb <- list-at bb-shops bb-herbalist
    d <- bvt-check "the reagent gatherers know the town's houses as their lodges (cg-city-beds houses them), and fall back to the herbalist's building, not the inn" (c.inn.x1 == herb.x1 & c.inn.y1 == herb.y1 & list-length c.houses == 0 & list-length c.lodges == list-length cgg-lodges)
    goods <- bb-goods bb-herbalist
    e <- bvt-check "the herbalist buys black pearl, spiders' silk and sulfurous ash and shelves all eight reagents" (gvb-material 12 22 & gvb-material 12 23 & gvb-material 12 24 & not (gvb-material 12 25) & brg-sells goods 22 0 & brg-sells goods 23 0 & brg-sells goods 24 0 & brg-sells goods 17 0 & list-length goods == 8)
    f <- bvt-check "a restored reagent gatherer or powder digger passes the gatherer place check (cgg-reagent-place)" (cgg-reagent-place 425 & cgg-reagent-place 426 & cgg-reagent-place 427 & not (cgg-reagent-place 424) & not (cgg-reagent-place 428))
    a + b + d + e + f
  end
