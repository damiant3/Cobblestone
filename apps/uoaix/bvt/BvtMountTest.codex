Chapter: BvtMountTest
  cites Uoaix chapter CompositePaging
  cites Uoaix chapter BvtCheck

  bvt-mounttest-say : Text -> List Integer
  bvt-mounttest-say (text) = sip-length (gp-ascii [3,0,0,0,3,#B2,0,3] text 0 (text-length text + 1))
  bvt-mounttest : Integer -> [Console] Integer
  bvt-mounttest (unused) =
    let asked = cp-mount-request (bvt-mounttest-say "[mounttest 3EA2") & cp-mount-request (bvt-mounttest-say "[mounttest off") & not (cp-mount-request (bvt-mounttest-say "[move"))
    in let p = cp-mount-equip #3EA2 4242
    in let laid = list-length p == 15 & list-at p 0 == #2E & list-at p 5 == #3E & list-at p 6 == #A2 & list-at p 8 == 25 & gp-u32 p 9 == 4242
    in act
      a <- bvt-check "[mounttest asks for a mount test and [move does not (UOAIX-183)" asked
      b <- bvt-check "the test equips a 15-byte 0x2E of the art on layer 25 of the speaker (UOAIX-183)" laid
      a + b
    end
