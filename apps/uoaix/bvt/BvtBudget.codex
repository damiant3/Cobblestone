Chapter: BvtBudget
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter BvtCheck

  bvt-budget : Integer -> [Console] Integer
  bvt-budget (unused) = act
    a <- bvt-check "the composite vendor room holds exactly one GVS1 image and its departed record (v36)" (cc-vendor-budget == gvsc-bytes + gv-gone-bytes)
    b <- bvt-check "the vendor room grows with the shop list, one row a shop, with no fixed cap" (gvsc-bytes == gvsc-v6-bytes + max 0 (bb-shop-count - 16) * gvsc-vendor-bytes)
    a + b
  end