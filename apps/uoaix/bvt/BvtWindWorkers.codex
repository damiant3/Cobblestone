Chapter: BvtWindWorkers
  cites Uoaix chapter CityWorkers
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Maybe

  bvt-wind-workers : Integer -> [Console] Integer
  bvt-wind-workers (unused) = act
    shops <- ct-city-shops 0
    c <- cw-wind (ct-table 0) shops ct-shop-roles
    s <- bb-shop-count
    own <- cw-vendor c bb-herbalist >= s & cw-vendor c bb-fishmonger == -1 & cw-vendor c 1 == -1 & list-length c.houses == 0
    a <- bvt-check "Wind's herb farmer sells to its own herbalist; Wind keeps no fishmonger or blacksmith and has no houses (UOAIX-217 W2)" own
    wanted <- cw-wants c cgg-herb-farm
    unwanted <- cw-wants c (cgg-place + 1) | cw-wants c cgg-farm-place | cw-wants c cgg-wool-place | cw-wants c cgg-lumber-place | cw-wants c cgg-fish-place
    b <- bvt-check "Wind founds only a herb farmer" (wanted & not unwanted)
    door <- cw-door 4
    d <- bvt-check "Wind (city 4) builds a worker city lodged at the Wind Inn (5311,35)" (is-just (cw-city (ct-table 0) shops ct-shop-roles 4) & door.x == 5311 & door.y == 35)
    g0 <- list-at c.gardens 0
    g1 <- list-at c.gardens 1
    g2 <- list-at c.gardens 2
    reachable <- list-length c.gardens == 3 & g0.x1 >= 5264 & g0.y1 >= 152 & g1.x1 >= 5264 & g1.y1 >= 152 & g2.x1 >= 5264 & g2.y1 >= 152
    grove <- (g0.y2 <= 47 & g0.x1 <= 5271) | (g1.y2 <= 47 & g1.x1 <= 5271) | (g2.y2 <= 47 & g2.x1 <= 5271)
    e <- bvt-check "Wind's gardens are the plant blocks its inn walks to (x 5264..5279, y 152..175), none in the grove at y 32..47 that no route from the inn reaches (trial 43281)" (reachable & not grove)
    a + b + d + e
  end
