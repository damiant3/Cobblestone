Chapter: BvtCityLumber
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter Cities
  cites Uoaix chapter EconomyHarvest
  cites Uoaix chapter BvtWorkerDay
  cites Uoaix chapter BvtCheck

 UOAIX-217: a city lumberjack's tree choice (cg-city-lumber-pick) over a map tree site at 590,2110 in Skara Brae's
 forest (584-599 by 2104-2119) and a woods node with no site, both of Skara Brae's lumber place, the site's node made
 first. Answers a bit per check: 1 the site is the ready tree of that forest and place; 2 not of another city's forest,
 nor of another place; 4 the woods node is the ready node with no site, though the site's node comes first; 8 a shunned
 tree is no longer ready; 15 is all, negative when not buildable.
  bcl-checks : Integer -> Integer
  bcl-checks (unused) = when bwd-founded 0
    is Err (_) -> -1
    is Ok (owner) -> let h = owner.production.harvest
      in let w = h.vendor.currency.world
      in let place = 5000 + cgg-lumber-place
      in let woods = (list-at (ct-table 0) 5).forest
      in let tree = eh-source w 15 place
      in let plain = eh-source w 15 place
      in if tree < 1 | plain < 1 | h.count >= 240 then -2
      else let k = h.count
      in let site = list-at h.sites k
      in let a = __record-set site "x" 590 in let b = __record-set site "y" 2110 in let d = __record-set site "z" 0
      in let e = __record-set site "resource" 15 in let f = __record-set site "node" tree in let g = __record-set site "base" 0
      in let j = __record-set site "species" 0 in let l = __record-set site "felled" 0
      in let counted = __record-set h "count" (k + 1)
      in let found = if cg-lumber-ready h owner.lumber-shun woods place 0 == k & cg-lumber-count h owner.lumber-shun woods place 0 == 1 then 1 else 0
      in let apart = if cg-lumber-ready h owner.lumber-shun (list-at (ct-table 0) 1).forest place 0 < 0 & cg-lumber-ready h owner.lumber-shun woods (place + 1000) 0 < 0 then 2 else 0
      in let plainly = if cg-siteless-node h w place 0 == plain then 4 else 0
      in let shunned = cg-lumber-shun owner.lumber-shun 590 2110 0
      in let avoided = if cg-lumber-ready h owner.lumber-shun woods place 0 < 0 then 8 else 0
      in found + apart + plainly + avoided
  bvt-city-lumber : Integer -> [Console] Integer
  bvt-city-lumber (unused) = act
    n <- bcl-checks 0
    bvt-check ("a city lumberjack's ready tree is a map tree of its own forest and place, its fallback a woods node with no site, and a shunned tree is passed over (UOAIX-217, code " & show n & ")") (n == 15)
  end
