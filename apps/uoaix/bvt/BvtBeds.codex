Chapter: BvtBeds
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-beds : Integer -> [Console] Integer
  bvt-beds (unused) = let bed = BbSpot { x = 1496, y = 1610, z = 0 }
    in let other = BbSpot { x = 1497, y = 1610, z = 0 }
    in let door = BbSpot { x = 1495, y = 1617, z = 0 }
    in act
    a <- bvt-check "a worker keeps a bed of its own on the lodging's bed rows (inn door deadlock)" (cg-bed-ok bed [other] & cg-bed-ok other [])
    b <- bvt-check "a bed an earlier worker holds, or one on the doorway row, is given up" (not (cg-bed-ok bed [other, bed]) & not (cg-bed-ok door []))
    a + b
  end
