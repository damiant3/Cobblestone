Chapter: BvtTeleporters
  cites Uoaix chapter Teleporters
  cites Uoaix chapter BvtCheck

 Damian, 2026-10-10: "then enterance to wrong dungeon does not work", "same with shame"; root: every dungeon entrance,
 all ten. Each entrance tile, from ServUO's teleporters.csv, as x, y, z.
  btp-entrances : Integer -> List Integer
  btp-entrances (unused) = [2498, 916, 0, 4110, 430, 5, 1296, 1080, 0, 1176, 2635, 0, 4721, 3813, 0,
    512, 1559, 0, 2042, 215, 14, 1997, 81, 7, 2923, 3405, 6, 1013, 1433, 0]
  btp-inside : Integer, List Integer, Integer -> Integer
  btp-inside (buf) (tiles) (i) = if i >= list-length tiles then 0
    else let t = tp-find buf (list-at tiles i) (list-at tiles (i + 1)) (list-at tiles (i + 2))
    in (if t >= 0 & list-at (tp-dest buf t) 0 >= 5120 then 1 else 0) + btp-inside buf tiles (i + 3)
  btp-sorted : Integer, Integer -> Boolean
  btp-sorted (buf) (i) = if i + 1 >= tpd-count then True
    else tp-key (tp-at buf i 0) (tp-at buf i 1) < tp-key (tp-at buf (i + 1) 0) (tp-at buf (i + 1) 1) & btp-sorted buf (i + 1)
  btp-back : Integer, Integer, Integer, Integer -> Boolean
  btp-back (buf) (x) (y) (z) = let t = tp-find buf x y z
    in if t < 0 then False
    else let d = tp-dest buf t
    in let r = tp-find buf (list-at d 0) (list-at d 1) (list-at d 2)
    in r >= 0 & list-at (tp-dest buf r) 0 == x & list-at (tp-dest buf r) 1 == y
  bvt-teleporters : Integer -> [Console] Integer
  bvt-teleporters (unused) = let buf = tp-load 0 in act
    inside <- btp-inside buf (btp-entrances 0) 0
    print-line-uni ("TELEPORTERS count=" & show tpd-count & " entrances=" & show inside)
    a <- bvt-check "the teleporter table loads, sorted by tile, with every row on the 1.25 map" (buf /= 0 & tpd-count > 300 & btp-sorted buf 0)
    b <- bvt-check "each of the ten dungeon entrances (Covetous, Deceit, Despise, Destard, Hythloth, Shame, Wrong, Ice, Fire, the orc cave) leads into the dungeon area" (inside == 10)
    c <- bvt-check "Shame's and Wrong's entrances lead in and their landings lead back out" (btp-back buf 512 1559 0 & btp-back buf 2042 215 14)
    d <- bvt-check "a tile beside an entrance, and an entrance's tile 30 above it, take no one" (tp-find buf 2042 216 14 < 0 & tp-find buf 2042 215 44 < 0 & tp-find 0 2042 215 14 < 0)
    a + b + c + d
  end
