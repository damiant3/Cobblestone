Chapter: BvtCobbler
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvco-makes : Integer, Integer -> Boolean
  bvco-makes (leather) (item) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1016) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 35 leather in bb-from-bought w actor item
  bvco-name : Integer -> Text
  bvco-name (item) = (list-at (bb-catalog 0).items (item - 1)).name
  bvt-cobbler : Integer -> [Console] Integer
  bvt-cobbler (unused) = act
    a <- bvt-check "the cobbler is shop 17, in the row house at door 1450,1711, selling sandals, shoes, boots and thigh boots (121-124)" (bb-shop-count >= 17 & bb-cobbler == 16 & (list-at bb-shops 16).title == "Cobbler" & (list-at bb-shops 16).x1 > 1447 & (list-at bb-shops 16).x2 < 1459 & (list-at bb-shops 16).y2 < 1711 & list-length (bb-goods bb-cobbler) == 4 & (list-at (bb-goods bb-cobbler) 0).item == 121 & (list-at (bb-goods bb-cobbler) 3).item == 124)
    b <- bvt-check "items 121-124 are the footwear and the Britain catalog validates" (bvco-name 121 == "sandals" & bvco-name 122 == "shoes" & bvco-name 123 == "boots" & bvco-name 124 == "thigh boots" & eg-validate (bb-catalog 0) == 0)
    c <- bvt-check "4 bought leather make sandals and 10 thigh boots; 3 make no sandals and 9 no thigh boots" (bvco-makes 4 121 & bvco-makes 10 124 & not (bvco-makes 3 121) & not (bvco-makes 9 124))
    d <- bvt-check "a buyer under its cap buys again while one holding the cap, or offered nothing, does not (bb-buys-under)" (bb-buys-under 2 0 10 & not (bb-buys-under 10 0 10) & not (bb-buys-under 0 (0 - 1) 10) & bb-buys 0 0 & not (bb-buys 1 0))
    e <- bvt-check "vendor 16 opens the cobbler's menu, buys leather, buys back footwear by its art; works at its table on wheel key 12" (list-at gvb-role-words 16 == "cobbler" & gvb-material 16 35 & not (gvb-material 16 7) & gvb-goods 16 122 & gvb-item-of #170F == 122 & cgs-cobbler == 12 & (csn-cobbler 0).station-a.x == wks-cobbler-table.x & wks-cobbler-table.x >= (list-at bb-shops 16).x1 & wks-cobbler-table.x <= (list-at bb-shops 16).x2 & wks-cobbler-table.y <= (list-at bb-shops 16).y2)
    a + b + c + d + e
  end
