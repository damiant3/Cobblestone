Chapter: BvtTanner
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvtn-makes : Integer -> Boolean
  bvtn-makes (hides) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1014) 100
      in if actor < 1 then False else let held = ep-set (ep-actor w actor).stock 7 hides in bb-from-bought w actor 35
  bvtn-armed : Integer -> Boolean
  bvtn-armed (shop) = when bb-economy 0
    is Err (_) -> False
    is Ok (x) -> let actor = ep-admit x.world (eu-open x 2 (1000 + shop)) 100
      in if actor < 1 then False
      else let before = ep-tool (ep-actor x.world actor) 27
      in when bb-arm-tools (bb-producer x actor) (bb-goods shop) 0
        is Err (_) -> False
        is Ok (_) -> not before & ep-tool (ep-actor x.world actor) 27
  bvt-tanner : Integer -> [Console] Integer
  bvt-tanner (unused) = act
    a <- bvt-check "the tanner is shop 15, in The Best Hides of Britain, selling leather (35, 0x1081)" (bb-shop-count >= 15 & bb-tanner == 14 & (list-at bb-shops 14).title == "Tanner" & (list-at bb-shops 14).premises == "The Best Hides of Britain" & (list-at (bb-goods bb-tanner) 0).item == 35 & (list-at (bb-goods bb-tanner) 0).graphic == #1081)
    b <- bvt-check "vendor 14 opens the tanner's menu, buys hides and no leather, and buys back leather" (list-at gvb-role-words 14 == "tanner" & gvb-role 14 == 14 & gvb-material 14 7 & not (gvb-material 14 35) & gvb-goods 14 35 & gvb-item-of #1081 == 35 & gvb-item-of #1079 == 7)
    c <- bvt-check "the tanner works at its hide rack, inside its shop, on wheel key 10" (let w = csn-tanner 0 in let s = list-at bb-shops bb-tanner in w.station-a.x == wks-hide-rack.x & w.station-a.y == wks-hide-rack.y & w.mode == 1 & wks-hide-rack.x >= s.x1 & wks-hide-rack.x <= s.x2 & wks-hide-rack.y >= s.y1 & wks-hide-rack.y <= s.y2 & cgs-tanner == 10)
    d <- bvt-check "2 bought hides make leather; 1 makes none" (bvtn-makes 2 & not (bvtn-makes 1) & not (bvtn-makes 0))
    e <- bvt-check "a shop founded with nothing to sell still gets the knife its recipe takes (bowyer and tanner, bb-arm-tools)" (bvtn-armed bb-tanner & bvtn-armed bb-bowyer)
    a + b + c + d + e
  end