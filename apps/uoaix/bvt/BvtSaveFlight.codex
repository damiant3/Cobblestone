Chapter: BvtSaveFlight
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter BvtCheck

  bvt-save-flight : Integer -> [Console] Integer
  bvt-save-flight (unused) = act
    a <- bvt-check "a save key due while a flight is writing waits for the flight to land, so no commit drains a snapshot in one round (UOAIX-261)" (not (cs-save-now 1 1) & not (cs-save-now 5 1) & not (cs-save-now 7 1))
    b <- bvt-check "a save key due with the flight idle commits now, and no key due commits nothing either way" (cs-save-now 1 0 & cs-save-now 5 0 & not (cs-save-now 0 0) & not (cs-save-now 4 0) & not (cs-save-now 0 1))
    c <- bvt-check "a command's commit defers only while the flight writes (cs-commit-play)" (cs-flying 1 & not (cs-flying 0))
    a + b + c
  end
