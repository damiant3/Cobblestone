Chapter: BvtRoundTiming
  cites Uoaix chapter GameLinks
  cites Uoaix chapter BvtCheck

  bvt-round-timing : Integer -> [Console] Integer
  bvt-round-timing (unused) = act
    a <- bvt-check "a server round of 250 ms or more is SLOW, whatever the gap before it; a gap of 250 ms between rounds is LATE (the guest was not running)" (gl-round-kind 250 0 == 1 & gl-round-kind 900 900 == 1 & gl-round-kind 10 250 == 2 & gl-round-kind 10 4000 == 2)
    b <- bvt-check "a round under 250 ms after a gap under 250 ms is quiet, and HPET ticks convert at the counter's rate" (gl-round-kind 249 249 == 0 & gl-round-kind 0 0 == 0 & gl-round-ms 14318180 14318180 == 1000 & gl-round-ms 3579545 14318180 == 250 & gl-round-ms 5 0 == 5000)
    c <- bvt-check "the clock scale is the HPET ms over the timer ms since the first round: 30 under -clock-scale 30, 1 on a live shard and before a second has passed" (gl-clock-scale 300000 10000 == 30 & gl-clock-scale 10010 10000 == 1 & gl-clock-scale 99999 999 == 1 & gl-clock-scale 0 5000 == 1)
    buf <- gl-slow-new 0
    none <- gl-slow-text buf
    p1 <- gl-note-packet buf 5 2 0 100
    p2 <- gl-note-packet buf 30 7 1 200
    p3 <- gl-note-packet buf 30 9 2 300
    p4 <- gl-note-packet buf 10 11 3 400
    k1 <- gl-note-link buf 0 1 2 3 4
    k2 <- gl-note-link buf 1 0 0 25 0
    k3 <- gl-note-link buf 2 1 1 1 1
    named <- gl-slow-text buf
    reset <- gl-slow-clear buf
    again <- gl-slow-text buf
    ok <- none == " slow-packet=none slow-link=none" & named == " slow-packet op=7 ms=30 link=1 serial=200 slow-link=1 ms=25 input=0 pulse=0 send=25 close=0" & again == none
    d <- bvt-check ("a SLOW round names its slowest packet (opcode, link, session) and its slowest link's input, pulse, send and close ms, the first kept on a tie, and a cleared round names none (red, UOAIX-267;" & named & ")") ok
    a + b + c + d
  end
