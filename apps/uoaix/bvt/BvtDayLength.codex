Chapter: BvtDayLength
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CompositeLabor
  cites Uoaix chapter BvtCheck

  bvt-day-length : Integer -> [Console] Integer
  bvt-day-length (unused) = act
    a <- bvt-check "a 720-second day from the admin panel runs the town 10x the default day (row 27)" (cg-game-ms 1000 720 == 120000 & cg-game-ms 1000 7200 == 12000
      & walk-abs (clb-hour-ticks 720 * 10 - clb-hour-ticks 7200) <= 10)
    b <- bvt-check "a missing or zero day length keeps the default 7200-second day" (cg-game-ms 1000 0 == 12000 & cg-day-default 0 == 7200 & clb-hour-ticks 0 == clb-hour-ticks 7200)
    a + b
  end
