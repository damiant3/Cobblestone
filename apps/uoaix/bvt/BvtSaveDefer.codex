Chapter: BvtSaveDefer
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter BvtCheck

  bvt-save-defer : Integer -> [Console] Integer
  bvt-save-defer (unused) = act
    a <- bvt-check "a pending save (store-due 4) forces the next 60 s commit and the reports key keeps it; the commit clears it and the save key, keeping the reports key (UOAIX-216)" (cs-save-forced 4 & cs-save-forced 7 & cs-report-clear 7 == 5 & cs-report-clear 6 == 4 & cs-save-clear 7 == 2 & cs-save-clear 5 == 0)
    b <- bvt-check "with no pending save the commit is not forced and the reports key clears only itself" (not (cs-save-forced 3) & not (cs-save-forced 0) & cs-report-clear 3 == 1 & cs-report-clear 2 == 0)
    a + b
  end
