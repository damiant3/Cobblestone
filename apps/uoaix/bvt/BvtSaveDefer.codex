Chapter: BvtSaveDefer
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter BvtCheck

  bvt-save-defer : Integer -> [Console] Integer
  bvt-save-defer (unused) = act
    a <- bvt-check "a pending save (store-due 4) forces the next 60 s commit and the reports key keeps it; the commit clears it and the save key, keeping the reports key (UOAIX-216)" (cs-save-forced 4 & cs-save-forced 7 & cs-report-clear 7 == 5 & cs-report-clear 6 == 4 & cs-save-clear 7 == 2 & cs-save-clear 5 == 0)
    b <- bvt-check "with no pending save the commit is not forced and the reports key clears only itself" (not (cs-save-forced 3) & not (cs-save-forced 0) & cs-report-clear 3 == 1 & cs-report-clear 2 == 0)
    c <- bvt-check "a link close commits nothing in its round: it marks the save due and forced, which the next timer commits only once no flight is writing, and it keeps the reports key (red, UOAIX-267)" (cs-close-due 0 == 5 & cs-close-due 2 == 7 & cs-save-forced (cs-close-due 0) & cs-save-now (cs-close-due 0) 0 & not (cs-save-now (cs-close-due 0) 1))
    d <- bvt-check "a command's commit during play commits nothing in its round: it marks the save due, forced only when the command asks, and keeps the reports key (red, UOAIX-267)" (cs-play-due 0 True == 5 & cs-play-due 0 False == 1 & cs-play-due 2 False == 3 & not (cs-save-forced (cs-play-due 0 False)) & cs-save-forced (cs-play-due 0 True) & not (cs-save-now (cs-play-due 0 False) 1))
    a + b + c + d
  end
