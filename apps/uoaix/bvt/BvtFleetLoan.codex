Chapter: BvtFleetLoan
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtSealLoans
  cites Uoaix chapter BvtCheck

 UOAIX-237: a ship's purse takes the crown's founding loan on the first leg the economy can lend it, not only on the
 call that opened the purse (trial-46860: fleet-purse=0, every buy refused for funds). Ship 1's purse is opened bare
 first, as a purse the loan refused at boot is; the old cg-fleet-actor found it and never lent.
  bfln-purse : EuCurrency, Integer -> Integer
  bfln-purse (x) (k) = em-find x.world.money 2 (mf-owner + k) 1
  bvt-fleet-loan : Integer -> [Console] Integer
  bvt-fleet-loan (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("fleet loan fixture economy: " & e) False
    is Ok (x) -> act
      opened <- bsl-open x
      fresh <- cg-fleet-actor x 0
      fresh-purse <- bfln-purse x 0
      bare <- eu-open x 2 (mf-owner + 1)
      bare-before <- cgf-value x bare
      later <- cg-fleet-actor x 1
      loans <- x.world.money.loan-count
      again <- cg-fleet-actor x 0
      a <- bvt-check ("a new ship's purse takes the crown loan (actor " & show fresh & ", purse " & show fresh-purse & ", value " & show (cgf-value x fresh-purse) & ")") (fresh > 0 & fresh-purse > 0 & bb-debt x.world.money fresh-purse 0 /= 0 & cgf-value x fresh-purse > 0)
      b <- bvt-check ("a ship's purse opened with no loan takes it on the next leg (value " & show bare-before & " then " & show (cgf-value x bare) & ")") (later > 0 & bare > 0 & bare-before == 0 & bb-debt x.world.money bare 0 /= 0 & cgf-value x bare > 0)
      c <- bvt-check ("a purse holding an open crown loan takes no second one (" & show loans & " then " & show x.world.money.loan-count & ")") (again == fresh & x.world.money.loan-count == loans)
      a + b + c
    end
