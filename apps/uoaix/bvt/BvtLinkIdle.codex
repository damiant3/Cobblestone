Chapter: BvtLinkIdle
  cites Uoaix chapter GameLinks
  cites Uoaix chapter BvtCheck

  bvt-link-idle : Integer -> [Console] Integer
  bvt-link-idle (unused) = act
    a <- bvt-check "an idle link is reaped only after three of the 1.25 client's longest ping gaps (75 s, live 43454) and within ten minutes; it was 30 s, under the client's 62 s median ping (UOAIX-249)" (gl-idle-ms >= 3 * 75000 & gl-idle-ms <= 600000)
    a
  end
