Chapter: BvtCityKeeperLeisure
  cites Uoaix chapter CityKeeperLeisure
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck
  cites Uoaix chapter TownRoutes
  cites Uoaix chapter Teleporters

  bckl-outs : Integer, Integer, Integer -> Integer
  bckl-outs (vendor) (night) (left) = if left == 0 then 0 else (if ck-out-on vendor night then 1 else 0) + bckl-outs vendor (night + 1) (left - 1)
  bckl-roles : Integer, Integer, Integer, Integer, List Integer -> List Integer
  bckl-roles (i) (n) (inn) (tavern) (out) = if i >= n then out
    else bckl-roles (i + 1) n inn tavern (out & [if i == bb-inn then inn else if i == bb-tavern-keeper then tavern else 0 - 1])
  bckl-payee : Integer, Integer -> Integer
  bckl-payee (inn) (tavern) = let c = cw-skara (ct-table 0) (ct-city-shops 0) ct-shop-roles
    in let set = __record-set c "vendors" (bckl-roles 0 (bb-tavern-keeper + 1) inn tavern [])
    in ck-payee c
  bckl-hour : Integer, Integer -> Integer
  bckl-hour (day) (hour) = day * 86400 + hour * 3600
  bvt-city-keeper-leisure : Integer -> [Console] Integer
  bvt-city-keeper-leisure (unused) = act
    a <- bvt-check "a city keeper is out on two nights in three, by its vendor and the night (UOAIX-222)" (bckl-outs 30 0 30 == 20 & bckl-outs 31 7 30 == 20 & not (ck-out-on 30 0) & ck-out-on 31 0)
    b <- bvt-check "a shut city keeper out tonight heads for the inn (2) from 20 to 22 and for its shop (1) at 22, at 19 and while open" (ck-goal 31 True (bckl-hour 3 20) == 2 & ck-goal 31 True (bckl-hour 3 21) == 2
      & ck-goal 31 True (bckl-hour 3 22) == 1 & ck-goal 31 True (bckl-hour 3 19) == 1 & ck-goal 31 False (bckl-hour 3 21) == 1)
    c <- bvt-check "a city keeper not out tonight stays at its shop through the evening" (not (ck-out-on 30 (bsh-night (bckl-hour 2 21))) & ck-goal 30 True (bckl-hour 2 21) == 1)
    d <- bvt-check "a city keeper pays its city's tavern keeper, else the innkeeper; a city with neither has no payee" (bckl-payee 77 88 == 88 & bckl-payee 77 (0 - 1) == 77 & bckl-payee (0 - 1) (0 - 1) < 0)
    e <- bckl-wallet 0
    t <- bckl-zero (alloc-bytes ck-tally-bytes) 0
    r3 <- ck-roll t 3
    p3 <- ck-count t 3 True
    q3 <- ck-count t 3 False
    due3 <- poke-qword t 56 2
    pay3 <- poke-qword t 64 1
    r4 <- ck-roll t 4
    first <- [peek-qword t 24, peek-qword t 32, peek-qword t 40, peek-qword t 72, peek-qword t 80]
    r5 <- ck-roll t 5
    second <- [peek-qword t 24, peek-qword t 32, peek-qword t 40, peek-qword t 72, peek-qword t 80]
    f <- bvt-check "a city keepers' night rolls on the next night's first step: night 3 closes with 2 arrived, 1 paid, 2 due, 1 able to pay; night 4, which no keeper reached, still closes, all zero (ck-roll)" (first == [4, 2, 1, 2, 1] & second == [5, 0, 0, 0, 0])
    g <- bvt-check "a city keeper's town is at its city's index in cw-build's lists, Britain first: Skara Brae 1, Vesper 2, Britain and an unknown city none; without Britain the index moves, so the town lists must keep it (trial 44288, arrived 0)" (bckl-town-index 0)
    u <- bckl-zero (alloc-bytes ck-tally-bytes) 0
    r6 <- ck-roll u 6
    s1 <- ck-missed u 0 5
    s2 <- ck-missed u 1400 (0 - 1)
    s3 <- ck-missed u 1400 3
    s4 <- ck-missed u 1400 3
    r7 <- ck-roll u 7
    h <- bvt-check "an evening that ends unarrived is counted by why: no tile at the inn, no route held, still walking; the night closes with 1, 1, 2 and the next starts at 0 (UOAIX-222, trial 44375: 34 of 55 arrived)" ([peek-qword u 112, peek-qword u 120, peek-qword u 128, peek-qword u 88, peek-qword u 96, peek-qword u 104] == [1, 1, 2, 0, 0, 0])
    small <- BbShop { title = "Inn", premises = "test inn", x1 = 10, y1 = 20, x2 = 11, y2 = 22 }
    large <- BbShop { title = "Inn", premises = "test inn", x1 = 0, y1 = 0, x2 = 16, y2 = 16 }
    i <- bvt-check "a keeper's inn tile starts inside its inn's own area: vendor 17 at a 2 by 3 inn takes tile 5, vendor 40 at a 17 by 17 inn tile 40 (trial 44387: 16 of 19 unarrived had no tile when the index ran past a small inn)" (ck-out-index 17 small == 5 & ck-out-index 3 small == 3 & ck-out-index 40 large == 40)
    w <- bckl-zero (alloc-bytes ck-tally-bytes) 0
    w8 <- ck-roll w 8
    n1 <- ck-missed w 1400 (0 - 1)
    stop1 <- ck-stop-pack 3731 1318 4 tl-ended-sealed
    m1 <- ck-name-missed w 130 3 stop1
    n2 <- ck-missed w 1400 (0 - 1)
    m2 <- ck-name-missed w 131 40 0
    w9 <- ck-roll w 9
    j <- bvt-check "a no-route keeper is named by vendor, plan failures (at most 15) and where its last failed plan stopped, and the names close with the night: 130:3 and 131:15 (UOAIX-222, trial at 44402: no-route 6)" (peek-qword w ck-named-last == 130 * 16 + 3 & peek-qword w (ck-named-last + 8) == stop1 & peek-qword w (ck-named-last + 16) == 131 * 16 + 15 & peek-qword w (ck-named-last + 24) == 0 & peek-qword w (ck-named-last + 32) == 0 & peek-qword w ck-named-at == 0)
    far <- ck-stop-text (ck-stop-pack 1500 1650 2000 tl-ended-budget)
    read <- ck-stop-text stop1 == "@3731.1318.d4.sealed" & far == "@1500.1650.d1023.budget" & ck-stop-text 0 == "@none"
    k <- bvt-check ("a failed plan's stop reads back as tile, distance and why: " & ck-stop-text stop1 & ", " & far & ", " & ck-stop-text 0) read
    l <- bckl-stop 0
    inn <- BbSpot { x = 3731, y = 1320, z = 0 }
    next <- BbSpot { x = 3732, y = 1320, z = 0 }
    shop <- bckl-mob 3764 1270
    there <- bckl-mob 3731 1320
    m <- bvt-check "a keeper's sealed plan refuses that start and target for good; a budget-spent or found plan refuses nothing; another target, or the way back, is a different refusal (UOAIX-222, root 2026-10-16: the search runs in the world tick)" (ck-refusal tl-ended-sealed shop inn == ck-pair shop inn & ck-refusal tl-ended-budget shop inn == 0 & ck-refusal 0 shop inn == 0 & ck-pair shop inn /= ck-pair shop next & ck-pair shop inn /= ck-pair there (BbSpot { x = 3764, y = 1270, z = 0 }) & ck-pair shop inn > 0)
    n <- bckl-via 0
    o <- bckl-job 0
    q <- bckl-mark 0
    a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + q
  end
 A bit per check on the 64 by 64 fixture: 1 a 30-cell plan stops by budget and leaves no refusal (rte-failed), 2 the
 whole-map plan for the same start and target then runs and finds the route, 4 a sealed plan behind the wall is refused,
 8 a budget stop, taken by the job or waiting on it, clears the walker's rest and failures; -9 a fixture that did not
 build.
  bckl-mark-code : Integer -> Integer
  bckl-mark-code (unused) = when world-new 64
    is Err (_) -> -9
    is Ok (w) -> when walk-map-new 1000 1000 64 64
      is Err (_) -> -9
      is Ok (map) -> let opened = bckl-fill map False 0
        in let indexed = world-reindex w
        in let p = tl-path-new map
        in let spent = rte-plan-budget p w map None (bckl-mover 0) 1060 1001 0 30
        in let a = if spent < 0 & p.ended == tl-ended-budget & not (rte-failed p (bckl-mover 0) 1060 1001 0 0) then 1 else 0
        in let again = rte-plan-budget p w map None (bckl-mover 0) 1060 1001 0 (p.width * p.height)
        in let b = if again >= 0 then 2 else 0
        in let walled = bckl-fill map True 0
        in let closed = rte-plan-budget p w map None (bckl-mover 0) 1040 1001 0 (p.width * p.height)
        in let c = if closed < 0 & p.ended == tl-ended-sealed & rte-failed p (bckl-mover 0) 1040 1001 0 0 then 4 else 0
        in let pace = rte-walk 0
        in let f = __record-set pace "fails" 3
        in let r = __record-set pace "rest" 8
        in let queued = rte-queued pace
        in let d = if pace.rest == 0 & pace.fails == 0 then 8 else 0
        in a + b + c + d
  bckl-mark : Integer -> [Console] Integer
  bckl-mark (unused) = act
    n <- bckl-mark-code 0
    bvt-check ("a keeper plan stopped by its slice budget is not refused, so the next plan runs and the job is asked; a sealed plan is refused; a budget stop waiting on the job is not a failure (UOAIX-222 and 259, trial 44979: 13 budget stops on night 3; trial 44997: KEEPER fails 3 per goal change; code " & show n & ")") (n == 15)
  end
 A bit per planner ending, on a 64 by 64 map with a wall (flag 64) down x 1030 or none, from 1001,1001 to 1060,1001:
 1 the walled plan fails sealed, its nearest tile on x 1029, 31 tiles short; 2 a 30-cell budget on the open map fails
 by budget nearer than the start's 59; 4 the whole map's budget finds the route and ends neither way; -9 a
 fixture that did not build.
  bckl-fill : WalkMap, Boolean, Integer -> Integer
  bckl-fill (map) (sealed) (i) = if i == map.width * map.height then 0
    else let x = map.x + int-mod i map.width
    in let y = map.y + i / map.width
    in let mark = __heap-save
    in let set = walk-set-land map x y 0 (if sealed & x == 1030 then 64 else 0)
    in let restored = __heap-restore mark in bckl-fill map sealed (i + 1)
  bckl-mover : Integer -> WorldObject
  bckl-mover (unused) = WorldObject { serial = 0, kind = 1, x = 1001, y = 1001, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
  bckl-stop-code : Integer -> Integer
  bckl-stop-code (unused) = when world-new 64
    is Err (_) -> -9
    is Ok (w) -> when walk-map-new 1000 1000 64 64
      is Err (_) -> -9
      is Ok (map) -> let walled = bckl-fill map True 0
        in let indexed = world-reindex w
        in let p = tl-path-new map
        in let sealed = tl-plan-budget p w map None (bckl-mover 0) 1060 1001 0 (alloc-bytes 4096) 4096 (p.width * p.height)
        in let a = if sealed < 0 & p.ended == tl-ended-sealed & p.near >= 0 & map.x + int-mod p.near p.width == 1029 & p.near-h / tl-step-cost == 31 then 1 else 0
        in let opened = bckl-fill map False 0
        in let small = tl-plan-budget p w map None (bckl-mover 0) 1060 1001 0 (alloc-bytes 4096) 4096 30
        in let b = if small < 0 & p.ended == tl-ended-budget & p.near >= 0 & p.near-h / tl-step-cost < 59 then 2 else 0
        in let whole = tl-plan-budget p w map None (bckl-mover 0) 1060 1001 0 (alloc-bytes 4096) 4096 (p.width * p.height)
        in let c = if whole > 0 & p.ended == 0 then 4 else 0
        in a + b + c
 The slice job on the same fixture with a 16-cell slice: a bit per check, 1 the open map's search is still running after
 one step, 2 it finishes within 40 steps and its route is in the town planner's table (rte-find), 4 a second ask while
 it is busy is refused, 8 the walled map answers sealed and frees the job; -9 a fixture that did not build.
  bckl-job-code : Integer -> Integer
  bckl-job-code (unused) = when world-new 64
    is Err (_) -> -9
    is Ok (w) -> when walk-map-new 1000 1000 64 64
      is Err (_) -> -9
      is Ok (map) -> let opened = bckl-fill map False 0
        in let indexed = world-reindex w
        in let town = tl-path-new map
        in let j = rte-job-new 4096 town map None
        in let asked = rte-job-ask j 7 town map False (bckl-mover 0) 1060 1001 0
        in let first = rte-job-step-by j w 16
        in let a = if asked & rte-job-answer j 7 == 1 then 1 else 0
        in let again = rte-job-ask j 8 town map False (bckl-mover 0) 1030 1001 0
        in let c = if not again then 4 else 0
        in let left = bckl-steps-of j w 7 40
        in let found = rte-job-answer j 7
        in let b = if found == 2 & rte-find town (bckl-mover 0) 1060 1001 0 0 >= 0 then 2 else 0
        in let walled = bckl-fill map True 0
        in let sealed-asked = rte-job-ask j 9 town map False (bckl-mover 0) 1060 1001 0
        in let ran = bckl-steps-of j w 9 400
        in let d = if sealed-asked & rte-job-answer j 9 == 3 & j.busy == 0 then 8 else 0
        in a + b + c + d
  bckl-steps-of : RteJob, WorldTable, Integer, Integer -> Integer
  bckl-steps-of (j) (w) (who) (left) = if left == 0 | j.result /= 1 then left else let s = rte-job-step-by j w 16 in bckl-steps-of j w who (left - 1)
  bckl-job : Integer -> [Console] Integer
  bckl-job (unused) = act
    n <- bckl-job-code 0
    bvt-check ("a long keeper search runs a slice a step on the shared job and its route is adopted into the town's table; a busy job refuses, a sealed one answers so (UOAIX-259, code " & show n & ")") (n == 15)
  end
  bckl-stop : Integer -> [Console] Integer
  bckl-stop (unused) = act
    n <- bckl-stop-code 0
    bvt-check ("a failed plan says where it stopped: sealed by a wall at its nearest tile, or out of budget; a found plan neither (UOAIX-222, code " & show n & ")") (n == 7)
  end
 Jhelom's south island holds the herbalist (1427,3981) and its inn is on the town island (1371,3810), open water between;
 ServUO's teleporters 1406,3996 to 1414,3828 and 1419,3832 to 1466,4015 link them. The window here is the islands'
 strip, so 1409,3824's destination (1124,3623) lies outside it.
  bckl-mob : Integer, Integer -> WorldObject
  bckl-mob (x) (y) = WorldObject { serial = 0, kind = 1, x = x, y = y, z = 5, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
  bckl-via-at : Integer, Integer, Integer, Integer -> Boolean
  bckl-via-at (tp) (i) (x) (y) = i >= 0 & tp-at tp i 0 == x & tp-at tp i 1 == y
  bckl-via : Integer -> [Console] Integer
  bckl-via (unused) = when walk-map-new 1400 3816 72 208
    is Err (e) -> bvt-check ("keeper teleporter fixture: " & e) False
    is Ok (map) -> act
      tp <- tp-load 0
      out <- ck-pick-via tp map (bckl-mob 1427 3981) (BbSpot { x = 1371, y = 3810, z = 0 }) 0 (0 - 1) 0
      back <- ck-pick-via tp map (bckl-mob 1371 3810) (BbSpot { x = 1427, y = 3981, z = 5 }) 0 (0 - 1) 0
      none <- ck-pick-via 0 map (bckl-mob 1427 3981) (BbSpot { x = 1371, y = 3810, z = 0 }) 0 (0 - 1) 0
      near <- ck-pick-via tp map (bckl-mob 1427 3981) (BbSpot { x = 1428, y = 3982, z = 5 }) 0 (0 - 1) 0
      said <- "a keeper refused its inn walks to the teleporter landing nearer it: out by 1406,3996, back by 1419,3832; none with no teleporters or a target beside it (UOAIX-222, Jhelom's herbalist; " & show out & " " & show back & ")"
      held <- bckl-via-at tp out 1406 3996 & bckl-via-at tp back 1419 3832 & none < 0 & near < 0
      bvt-check said held
    end
  bckl-town-index : Integer -> Boolean
  bckl-town-index (unused) = let skara = cw-skara (ct-table 0) (ct-city-shops 0) ct-shop-roles
    in let vesper = cw-vesper (ct-table 0) (ct-city-shops 0) ct-shop-roles
    in let full = [cw-britain, skara, vesper]
    in ck-town-index full 5 0 == 1 & ck-town-index full 12 0 == 2 & ck-town-index full 0 0 < 0 & ck-town-index full 99 0 < 0
      & ck-town-index [skara, vesper] 5 0 == 0
  bckl-zero : Integer, Integer -> Integer
  bckl-zero (t) (i) = if i >= ck-tally-bytes then t else let z = poke-qword t i 0 in bckl-zero t (i + 8)
 A keeper's evening is paid from its wage purse (owner ck-wage-base + vendor): no purse, or one short of a drink (5
 copper, else a silver or a gold rounded up), keeps it at the shop.
  bckl-coin : EuCurrency, Integer, Integer, Integer, Integer -> Boolean
  bckl-coin (x) (purse) (copper) (silver) (gold) = let a = __record-set (em-purse x.copper purse) "coin" copper
    in let b = __record-set (em-purse x.silver purse) "coin" silver in let c = __record-set (em-purse x.world.money purse) "coin" gold in ck-can-pay x purse
  bckl-wallet : Integer -> [Console] Integer
  bckl-wallet (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("keeper wallet fixture: " & e) False
    is Ok (x) -> act
      none <- em-find x.world.money 2 (ck-wage-base + 30) 1
      purse <- eu-open x 2 (ck-wage-base + 30)
      found <- em-find x.world.money 2 (ck-wage-base + 30) 1
      empty <- bckl-coin x purse 0 0 0
      four <- bckl-coin x purse 4 0 0
      five <- bckl-coin x purse 5 0 0
      silver <- bckl-coin x purse 0 1 0
      gold <- bckl-coin x purse 0 0 1
      bvt-check ("a keeper's wage purse is found by its owner and pays a drink from 5 copper, a silver or a gold; none, an empty one or 4 copper cannot: purse " & show purse) (none == 0 & purse > 0 & found == purse & not (ck-can-pay x 0) & not empty & not four & five & silver & gold & not (ck-can-pay x (x.world.money.purse-count + 1)))
    end
