Chapter: BvtCastleTreeArt
  cites Uoaix chapter CompositePlanting
  cites Uoaix chapter WorldDecoration
  cites Uoaix chapter BvtCheck

 UOAIX-208 (Damian, 2026-10-09: the castle trees "don't have the same graphical change to show the tree empty of fruit"):
 the planting view draws a map fruit tree's leaves, bare (7) or fruited (8), and the decoration sends no castle leaves.
  bcta-site : Integer -> GhSite
  bcta-site (trunk) = GhSite { x = 1363, y = 1601, z = 30, resource = 16, node = 1, base = 0, species = trunk, felled = 0 }
  bcta-art : List (List Integer), Integer -> Integer
  bcta-art (packets) (i) = if i >= list-length packets then 0 - 1 else let p = list-at packets i in if list-at p 0 == #1A then gp-u16 p 7 else bcta-art packets (i + 1)
  bcta-removes : List (List Integer) -> Boolean
  bcta-removes (packets) = list-length packets == 1 & list-at (list-at packets 0) 0 == #1D
  bvt-castle-tree-art : Integer -> [Console] Integer
  bvt-castle-tree-art (unused) =
    let main = cpl-serial-base + 1
    in let bare = cpl-draw-map (bcta-site #0D98) main 0 7 []
    in let ripe = cpl-draw-map (bcta-site #0D98) main 7 8 []
    in let pear = cpl-draw-map (bcta-site #0DA4) main 0 8 []
    in let gone = cpl-draw-map (bcta-site #0D98) main 8 0 []
    in act
      a <- bvt-check "a picked castle apple tree (trunk 0x0D98) draws bare leaves 0x0D99, a ripe one fruited 0x0D9A, a ripe pear (0x0DA4) 0x0DA6; leaving view removes them" (bcta-art bare 0 == #0D99 & bcta-art ripe 0 == #0D9A & bcta-art pear 0 == #0DA6 & bcta-removes gone)
      b <- bvt-check "the decoration sends no fruit-tree leaves inside the castle grounds, but its trunks, leaves elsewhere and an oak stay" (wd-orchard-leaf #0D9A 1363 1601 & wd-orchard-leaf #0DA9 1380 1585 & not (wd-orchard-leaf #0D98 1363 1601) & not (wd-orchard-leaf #0D9A 1500 1601) & not (wd-orchard-leaf #0CDB 1363 1601))
      a + b
    end
