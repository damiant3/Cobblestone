Chapter: BvtFixtureGrow
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

 UOAIX-144: a fixture world that Britain outgrows grows a page (bb-fixture-grow) instead of refusing. The answer is the
 count of three creates that succeed, times 1000, plus the world's capacity; -9 is a fixture that did not build.
  bvfg-item : Integer -> WorldObject
  bvfg-item (i) = WorldObject { serial = 0, kind = 2, x = 1000 + i, y = 1000, z = 0, graphic = #0EED, hue = 0, container = 0, amount = 1, health = 0 }
  bvfg-made : Result Integer Text -> Integer
  bvfg-made (r) = when r is Ok (_) -> 1 is Err (_) -> 0
  bvfg-run : Boolean -> Integer
  bvfg-run (grow) = when bb-economy 0
    is Err (_) -> -9
    is Ok (x) -> when world-new 2
      is Err (_) -> -9
      is Ok (world) -> let accounts = ga-new ga-dev
        in let game = GameShard { world = world, characters = ga-working accounts, accounts = accounts, next-key = 305419895, pending-key = 0, active = 0, log = slg-new slg-trace, skills = chs-new 0 }
        in let v = gv-new game x
        in let items = gsi-new world
        in let bound = if grow then bb-fixture-grow v items else 0
        in let made = bvfg-made (world-create world (bvfg-item 0)) + bvfg-made (world-create world (bvfg-item 1)) + bvfg-made (world-create world (bvfg-item 2))
        in if grow & list-length items.items /= world.capacity then -8 else made * 1000 + world.capacity
  bvt-fixture-grow : Integer -> [Console] Integer
  bvt-fixture-grow (unused) = act
    fixed <- bvfg-run False
    grown <- bvfg-run True
    a <- bvt-check ("a 2-slot fixture world with no grower refuses its third object: " & show fixed) (fixed == 2002)
    b <- bvt-check ("bb-fixture-grow grows the world a page, item registry with it, and the third object fits: " & show grown) (grown == 3256)
    a + b
  end
