Chapter: BvtRaiders
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-raiders-at : Integer, Integer -> WorldObject
  bvt-raiders-at (x) (y) = WorldObject { serial = 0, kind = 1, x = x, y = y, z = 0, graphic = 400, hue = 0, container = 0, amount = 1, health = 1 }
  bvt-raiders-foes : Integer -> List (List Integer)
  bvt-raiders-foes (unused) = [[101, 1500, 1600], [102, 1503, 1600], [103, 1495, 1600]]
  bvt-raiders : Integer -> [Console] Integer
  bvt-raiders (unused) = act
    a <- bvt-check "the nearest hostile in reach is the guard's foe (red, UOAIX audit 2026-10-18)" (cg-raider-in (bvt-raiders-foes 0) (bvt-raiders-at 1502 1600) 0 0 9999 == 102)
    b <- bvt-check "of hostiles at one distance, the first in slot order is taken" (cg-raider-in (bvt-raiders-foes 0) (bvt-raiders-at 1500 1605) 0 0 9999 == 101)
    c <- bvt-check "a hostile past cg-guard-reach is no foe" (cg-raider-in (bvt-raiders-foes 0) (bvt-raiders-at 1600 1600) 0 0 9999 == 0)
    d <- bvt-check "with no hostile gathered, nothing is a foe" (cg-raider-in [] (bvt-raiders-at 1500 1600) 0 0 9999 == 0)
    a + b + c + d
  end
