Chapter: BvtEastBanker
  cites Uoaix chapter GameMobileBank
  cites Uoaix chapter GameSession
  cites Uoaix chapter BvtCheck

 UOAIX-241: a banker at the First Bank of Britain (1433,1687) and at East Britain Bank (1650,1608,20). Answers a bit per
 check: 1 both install as two bankers, and a second install at East Britain finds its banker and adds none; 2 a character
 by the East Britain banker is served by it and opens East Britain Bank's box (bank 1); 4 one standing between the banks,
 out of reach of both, finds no banker; 7 is all, negative when not buildable.
  beb-checks : Integer -> Integer
  beb-checks (unused) = when gs-new 0
    is Err (_) -> -1
    is Ok (shard) -> let items = gsi-new shard.world
      in let banks = gmb-new items #004A
      in when gmb-ensure-banker banks gmb-bank-x gmb-bank-y 0
        is Err (_) -> -2
        is Ok (west) -> when gmb-ensure-banker banks gmb-east-x gmb-east-y gmb-east-z
          is Err (_) -> -3
          is Ok (east) -> when gmb-ensure-banker banks gmb-east-x gmb-east-y gmb-east-z
            is Err (_) -> -4
            is Ok (again) -> let installed = if west /= east & again == east & banks.count == 2 & gmb-is-banker banks east 0 then 1 else 0
              in when world-create shard.world (gs-mobile 0 (gmb-east-x + 2) (gmb-east-y + 3) gmb-east-z 400 1002)
                is Err (_) -> -5
                is Ok (near) -> when world-create shard.world (gs-mobile 0 1540 1650 0 400 1002)
                  is Err (_) -> -5
                  is Ok (apart) -> when world-get shard.world near
                    is Err (_) -> -6
                    is Ok (n) -> when world-get shard.world apart
                      is Err (_) -> -6
                      is Ok (b) -> let served = if gmb-banker-at banks n 0 == east & gmb-bank-at gmb-east-x gmb-east-y == 1 then 2 else 0
                        in let alone = if gmb-banker-at banks b 0 == 0 then 4 else 0
                        in installed + served + alone
  bvt-east-banker : Integer -> [Console] Integer
  bvt-east-banker (unused) = act
    n <- beb-checks 0
    bvt-check ("East Britain Bank has its own banker beside the First Bank's, and serves its own box (UOAIX-241, code " & show n & ")") (n == 7)
  end
