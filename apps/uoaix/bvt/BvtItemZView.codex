Chapter: BvtItemZView
  cites Uoaix chapter GameClientView
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bizv-made : Result Integer Text -> Integer
  bizv-made (r) = when r
    is Ok (serial) -> serial
    is Err (_) -> 0
  bizv-piece : WorldTable, Integer, Integer, Integer -> Integer
  bizv-piece (world) (x) (y) (z) = bizv-made (world-create world (WorldObject { serial = 0, kind = 2, x = x, y = y, z = z, graphic = #06F6, hue = 0, container = 0, amount = 1, health = 0 }))
  bizv-sees : GameClientView, GsiState, Integer, Integer -> Boolean
  bizv-sees (view) (items) (viewer) (item) = when world-get items.world viewer
    is Err (_) -> False
    is Ok (v) -> gcv-ground view items v (world-slot items.world item)
  bvt-item-z-view : Integer -> [Console] Integer
  bvt-item-z-view (unused) = when world-new 64
    is Err (e) -> bvt-check ("item z view fixture world: " & e) False
    is Ok (world) -> when gcv-new 64 18 False 0 0
      is Err (e) -> bvt-check ("item z view fixture view: " & e) False
      is Ok (view) -> act
        items <- gsi-new world
        ground <- bizv-made (world-create world (gs-mobile 0 1400 1624 28 400 1002))
        deck <- bizv-made (world-create world (gs-mobile 0 1397 1626 52 400 1002))
        raised <- bizv-piece world 1399 1625 48
        lowered <- bizv-piece world 1399 1626 28
        far <- bizv-piece world 1419 1624 28
        a <- gsi-register items raised 0 0 False False
        b <- gsi-register items lowered 0 0 False False
        c <- gsi-register items far 0 0 False False
        p <- bvt-check "a viewer at ground z 28 is drawn the raised portcullis 20 z above it, and one on the deck at z 52 the lowered one 24 z below (live 42390)" (bizv-sees view items ground raised & bizv-sees view items deck lowered)
        q <- bvt-check "a ground item past the view radius in x stays undrawn" (not (bizv-sees view items ground far))
        p + q
      end