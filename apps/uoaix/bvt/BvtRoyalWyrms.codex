Chapter: BvtRoyalWyrms
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 UOAIX-156 (Damian, 2026-10-09: "royal stablemaster needs wryms, drakes, and ancientwyrms").
  bvrw-key : WsCatalog, Text -> Text
  bvrw-key (c) (name) = let i = gws-royal-in c name 0 in if i < 0 then "" else (list-at c.profiles i).key
  bvt-royal-wyrms : Integer -> [Console] Integer
  bvt-royal-wyrms (unused) = let c = wsd-catalog 0
    in let shadow = gws-royal-in c "shadow wyrm" 0
    in let ancient = gws-royal-in c "ancient wyrm" 0
    in act
      a <- bvt-check "the royal stable gives British gray and red drakes, white and shadow wyrms, an ancient wyrm and a nightmare by name" (bvrw-key c "gray drake" == "graydrake" & bvrw-key c "red drake" == "reddrake" & bvrw-key c "drake" == "graydrake" & bvrw-key c "white wyrm" == "whitewyrm" & bvrw-key c "shadow wyrm" == "shadowwyrm" & bvrw-key c "ancient wyrm" == "ancientwyrm" & bvrw-key c "nightmare" == "nightmare")
      b <- bvt-check "the shadow and ancient wyrms are untameable in the templates, yet royal" (shadow >= 0 & ancient >= 0 & (list-at c.profiles shadow).taming == 0 & (list-at c.profiles ancient).taming == 0)
      d <- bvt-check "a name no template carries is refused" (gws-royal-in c "golden wyrm" 0 == -1)
      e <- bvt-check "a nightmare is never ridden; a brown horse is" (cg-unridden c (gws-royal-in c "nightmare" 0) & not (cg-unridden c (gws-royal-in c "brownhorse" 0)) & not (cg-unridden c -1))
      a + b + d + e
    end
