Chapter: BvtHunter
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter BvtCheck

  bvhu-inside : BbShop, BbShop -> Boolean
  bvhu-inside (a) (b) = a.x1 >= b.x1 & a.x2 <= b.x2 & a.y1 >= b.y1 & a.y2 <= b.y2
  bvt-hunter : Integer -> [Console] Integer
  bvt-hunter (unused) = act
    a <- bvt-check "the hunter takes tameable prey on wheel key 1, with an owner and place of its own" (cgh-profile.tame & not cgf-fighter-profile.tame & cgh-profile.key == 1 & cgf-fighter-profile.key == 0 & cgh-profile.owner /= cgf-owner & cgh-profile.place /= cgf-place)
    b <- bvt-check "its ground lies in UOX3 region 5653 (1395-1450 by 1439-1509) and its route inside the fighter's, the one route map both walk" (bvhu-inside cgh-ground (BbShop { title = "", premises = "", x1 = 1395, y1 = 1439, x2 = 1450, y2 = 1509 }) & bvhu-inside (cgf-window-of cgh-profile) cgf-window)
    c <- bvt-check "the tanner bids for hides, so the hunter's carved lot has a buyer" (gvb-material (gvb-role bb-tanner) 7)
    d <- bvt-check "the composite image carries twenty-three sections: the hunter's tail, the plays' PLY1, the decorator rows, the map pins, the books, the keepers' leisure, the city guards, the city workers, then the housing last (UOAIX-236)" (cc-section-count == 23)
    a + b + c + d
  end
