Chapter: BvtBareSite
  cites Uoaix chapter CompositePlanting
  cites Uoaix chapter CompositeRemoval
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-bare-site : Integer -> [Console] Integer
  bvt-bare-site (unused) = when cg-game 256
    is Err (e) -> bvt-check ("bare site fixture game: " & e) False
    is Ok (game) -> when bb-economy 0
      is Err (e) -> bvt-check ("bare site fixture economy: " & e) False
      is Ok (currency) -> let h = gh-state (gv-new game currency) (gsi-new game.world)
        in let site = list-at h.sites 0
        in act
          a <- bvt-check "a harvest site with node 0 reads as a bare plot, not nodes[-1] (cpl-node; CompositeProductionReplay trapped reading one)" (site.node == 0 & not (cpl-planted h 0) & cpl-label h 0 == "a bare plot" & cpl-want h 0 == 0 & (cpl-node h 0).planted == 0)
          b <- bvt-check "a site past the node table reads as empty too" (let far = __record-set site "node" (list-length h.vendor.currency.world.nodes + 1) in (cpl-node h 0).planted == 0 & not (cpl-planted h 0))
          c <- bvt-check "a site index of -1 reads as a bare plot, not sites[-1] (cpl-site)" (not (cpl-planted h -1) & cpl-label h -1 == "a bare plot" & (cpl-node h -1).planted == 0)
          a + b + c
        end
