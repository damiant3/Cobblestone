Chapter: BvtMapReach
  cites Uoaix chapter Cartography
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

 A drawn map's double-click showed its chart (the place it marks) for any map in view, another player's or one across
 the street; it now shows only within reach, the pack or 2 tiles, as ServUO's MapItem does (val, UOAIX audit 2026-10-18).
  bvmr-made : Result Integer Text -> Integer
  bvmr-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bvmr-at : WorldTable, Integer, Integer, Integer, Integer -> Integer
  bvmr-at (w) (kind) (x) (y) (container) = bvmr-made (world-create w (WorldObject { serial = 0, kind = kind, x = x, y = y, z = 0, graphic = (if kind == 1 then 400 else cart-drawn), hue = 0, container = container, amount = 1, health = 1 }))
  bvmr-sees : WorldTable, Integer, Integer -> Boolean
  bvmr-sees (w) (me) (serial) = when world-get w serial is Err (_) -> False is Ok (o) -> cart-reach w me o
  bvmr-codes : Integer -> List Integer
  bvmr-codes (unused) = when world-new 64
    is Err (_) -> [-1, -1]
    is Ok (w) -> let me = bvmr-at w 1 1500 1600 0
      in let pack = bvmr-at w 2 0 0 me
      in let mine = bvmr-at w 2 0 0 pack
      in let beside = bvmr-at w 2 1502 1600 0
      in let street = bvmr-at w 2 1510 1600 0
      in let other = bvmr-at w 1 1501 1600 0
      in let theirs = bvmr-at w 2 0 0 other
      in [(if bvmr-sees w me mine then 1 else 0) + (if bvmr-sees w me beside then 1 else 0),
        (if bvmr-sees w me street then 1 else 0) + (if bvmr-sees w me theirs then 1 else 0) + (if bvmr-sees w (me + 4096) mine then 1 else 0)]
  bvt-map-reach : Integer -> [Console] Integer
  bvt-map-reach (unused) = let n = bvmr-codes 0 in act
    a <- bvt-check ("a drawn map in the pack or 2 tiles off is within reach (2: " & show (list-at n 0) & ")") (list-at n 0 == 2)
    b <- bvt-check ("one 10 tiles off, one in another player's pack beside, and a viewer the world does not hold are not (0: " & show (list-at n 1) & ")") (list-at n 1 == 0)
    a + b
  end
