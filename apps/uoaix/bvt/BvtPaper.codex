Chapter: BvtPaper
  cites Uoaix chapter BritainProduction
  cites Uoaix chapter BvtCheck

  bvt-paper-name : Integer -> Text
  bvt-paper-name (item) = (list-at (bb-catalog 0).items (item - 1)).name
  bvt-paper-made : Integer -> Boolean
  bvt-paper-made (item) = let c = bb-catalog 0 in let k = bb-recipe c item 0 in k > 0 & (list-at c.recipes (k - 1)).station == 14
  bvt-paper : Integer -> [Console] Integer
  bvt-paper (unused) = act
    a <- bvt-check "the Britain catalog names wood pulp, blank scroll and blank book as items 105 to 107" (bvt-paper-name 105 == "wood pulp" & bvt-paper-name 106 == "blank scroll" & bvt-paper-name 107 == "blank book")
    b <- bvt-check "pulp, scrolls and books are made at the paper mill's station 14" (bvt-paper-made 105 & bvt-paper-made 106 & bvt-paper-made 107)
    c <- bvt-check "the Britain catalog with the new trades' stations validates" (eg-validate (bb-catalog 0) == 0 & eg-station-kinds == 24)
    d <- bvt-check "a station kind past eg-station-kinds is refused" (eg-validate (EgCatalog { items = (bb-catalog 0).items, resources = (bb-catalog 0).resources, recipes = [eg-recipe 105 1 15 1 0 0 0 0 25 0 6] }) /= 0)
    a + b + c + d
  end