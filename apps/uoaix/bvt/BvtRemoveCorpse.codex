Chapter: BvtRemoveCorpse
  cites Uoaix chapter CompositeRemoval
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-rc-made : Result Integer Text -> Integer
  bvt-rc-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  bvt-rc-gone : WorldTable, Integer -> Boolean
  bvt-rc-gone (world) (serial) = when world-get world serial is Err (_) -> True is Ok (_) -> False
  bvt-remove-corpse : Integer -> [Console] Integer
  bvt-remove-corpse (unused) = when cg-game 256
    is Err (e) -> bvt-check ("remove fixture game: " & e) False
    is Ok (game) -> when bb-economy 0
      is Err (e) -> bvt-check ("remove fixture economy: " & e) False
      is Ok (currency) -> let v = gv-new game currency
        in let world = game.world
        in let body = bvt-rc-made (world-create world (WorldObject { serial = 0, kind = 2, x = 1422, y = 1698, z = 0, graphic = #2006, hue = 0, container = 0, amount = 400, health = 0 }))
        in let shirt = bvt-rc-made (world-create world (gs-item body #1517 0))
        in let pack = bvt-rc-made (world-create world (gs-item body #0E75 0))
        in let ore = bvt-rc-made (world-create world (gs-item pack #19B9 0))
        in let other = bvt-rc-made (world-create world (WorldObject { serial = 0, kind = 2, x = 1423, y = 1698, z = 0, graphic = #0E75, hue = 0, container = 0, amount = 1, health = 0 }))
        in let kept = bvt-rc-made (world-create world (gs-item other #19B9 0))
        in let top = crm-top world body 64
        in let removed = crm-delete v world body 64
        in act
          a <- bvt-check "[remove on a corpse with a pack deletes the corpse and everything in it (Damian, row 10)" (body > 0 & top == body
            & (when removed is Ok (n) -> n == 4 is Err (_) -> False)
            & bvt-rc-gone world body & bvt-rc-gone world shirt & bvt-rc-gone world pack & bvt-rc-gone world ore)
          b <- bvt-check "[remove on a corpse leaves every other object and its contents" (other > 0 & not (bvt-rc-gone world other) & not (bvt-rc-gone world kept))
          a + b
        end
