Chapter: BvtKeeperPlans
  cites Uoaix chapter BritainShopHours
  cites Uoaix chapter TownRoutes
  cites Uoaix chapter BvtCheck

 UOAIX-216: which keepers count against a step's bsh-plans budget (bsh-will-plan).
  bvkp-keeper : Integer, Integer, Integer -> BshKeeper
  bvkp-keeper (goal) (next) (route) = let k = BshKeeper { home = BbSpot { x = 0, y = 0, z = 0 }, work = BbSpot { x = 0, y = 0, z = 0 },
      tavern = BbSpot { x = 0, y = 0, z = 0 }, concert = BbSpot { x = 0, y = 0, z = 0 }, walk = rte-walk 0, next-step = next, goal = goal, via-home = 0, settled = 0 }
    in let routed = __record-set k.walk "route" route in k
  bvt-keeper-plans : Integer -> [Console] Integer
  bvt-keeper-plans (unused) = act
    changed <- bvkp-keeper 0 9999 5
    unrouted <- bvkp-keeper 1 0 (0 - 1)
    a <- bvt-check "a keeper whose goal changed, or whose route is gone at its step, starts a plan and counts against the step's budget (bsh-plans 2)" (bsh-will-plan changed 1 100 & bsh-will-plan unrouted 1 100 & bsh-plans == 2)
    resting <- bvkp-keeper 1 9999 (0 - 1)
    walking <- bvkp-keeper 1 0 5
    b <- bvt-check "a keeper resting with its goal unchanged, or walking a route it holds, plans nothing and spends no budget" (not (bsh-will-plan resting 1 100) & not (bsh-will-plan walking 1 100))
    a + b
  end
