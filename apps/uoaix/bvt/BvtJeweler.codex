Chapter: BvtJeweler
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter Cities
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 UOAIX-232: the jeweler (shop 21 and every city's jewelry shop), gems from ore swings, jewelry from a gold ingot and a gem.
  bvj-hits : Integer, Integer, Integer -> Integer
  bvj-hits (i) (n) (acc) = if i >= n then acc else bvj-hits (i + 1) n (acc + (if gh-gem-roll 4242 (i * 7919) > 0 then 1 else 0))
  bvj-range : Integer, Integer -> Boolean
  bvj-range (i) (n) = if i >= n then True else let g = gh-gem-roll 31337 i in (g == 0 | (g >= 153 & g <= 161)) & bvj-range (i + 1) n
  bvj-count : List Integer, Integer, Integer -> Integer
  bvj-count (xs) (i) (acc) = if i >= list-length xs then acc else bvj-count xs (i + 1) (acc + (if list-at xs i == bb-jeweler then 1 else 0))
  bvj-find : List BbShop, Integer -> Integer
  bvj-find (xs) (i) = if i >= list-length xs then -1 else if (list-at xs i).premises == "The Family Jewels" then i else bvj-find xs (i + 1)
  bvj-run : List Integer, Integer, Integer -> Boolean
  bvj-run (xs) (j) (i) = if i >= 6 then True else j - i >= 0 & list-at xs (j - i) == bb-jeweler & bvj-run xs j (i + 1)
  bvt-jeweler : Integer -> [Console] Integer
  bvt-jeweler (unused) = act
    a <- bvt-check "the jeweler is shop 21 in Premier Gems, its role word is jeweler" (bb-jeweler == 20 & bb-shop-count == 21 & (list-at bb-shops bb-jeweler).premises == "Premier Gems" & list-at gvb-role-words bb-jeweler == "jeweler" & gvb-role bb-jeweler == bb-jeweler)
    b <- bvt-check "every 1.25 gem art names its stone and the jewelry arts their piece; other arts no gem" (gvb-item-of #0F25 == 153 & gvb-item-of #0F2E == 154 & gvb-item-of #0F30 == 156 & gvb-item-of #0F2B == 158 & gvb-item-of #0F21 == 160 & gvb-item-of #0F2D == 161 & gvb-item-of #108A == 162 & gvb-item-of #1089 == 164 & gvb-item-of #0F0E /= 153 & gvb-gem-of #0F31 == 0 & gvb-gem-of #0F0E == 0)
    c <- bvt-check "the jeweler buys gems and gold ingots, and sells gems and jewelry; no other role buys a gem" (gvb-material 20 32 & gvb-material 20 157 & not (gvb-material 20 162) & gvb-goods 20 153 & gvb-goods 20 165 & not (gvb-material 1 157) & not (gvb-goods 1 157))
    d <- bvt-check "an ore swing finds a gem about 1 time in 20 (40 to 160 of 2000), always one of the nine stones" (bvj-hits 0 2000 0 >= 40 & bvj-hits 0 2000 0 <= 160 & bvj-range 0 400)
    e <- bvt-check "the jeweler restocks only its four pieces of jewelry, never a gem, and lists all nine gems" (list-length bb-jewelry-goods == 4 & (list-at bb-jewelry-goods 0).item == 162 & list-length (bb-goods bb-jeweler) == 13)
    f <- bvt-check "six city jewelers in one run of the city shop table ending at The Family Jewels; no other city shop is a jeweler; roles match rows" (list-length (ct-city-shops 0) == list-length ct-shop-roles & bvj-count ct-shop-roles 0 0 == 6 & bvj-run ct-shop-roles (bvj-find (ct-city-shops 0) 0) 0)
    g <- bvt-check "a miner selling gems keeps the jeweler as buyer; a gem is not ore" (cgg-gem 153 & cgg-gem 161 & not (cgg-gem 5) & not (cgg-gem 162))
    h <- bvt-check "a slain troll or lich carries gems 71 kills in 100, an earth elemental 14, a serpent 73; an orc and an unknown kind none (UOX3 loot lists)" (cg-gem-loot-of "troll" == 71 & cg-gem-loot-of "lich" == 71 & cg-gem-loot-of "earthele" == 14 & cg-gem-loot-of "lavaserpent" == 73 & cg-gem-loot-of "orc" == 0 & cg-gem-loot-of "nobody" == 0)
    a + b + c + d + e + f + g + h
  end
