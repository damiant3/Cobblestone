Chapter: BvtSand
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter CompositeGatherer
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvs-resource : List EgResource, Integer, Integer, Integer -> Boolean
  bvs-resource (xs) (item) (tool) (i) = if i >= list-length xs then False
    else let r = list-at xs i in (r.item == item & r.tool == tool) | bvs-resource xs item tool (i + 1)
  bvs-at : List Integer, Integer, Integer -> Integer
  bvs-at (xs) (v) (i) = if i >= list-length xs then 0 - 1 else if list-at xs i == v then i else bvs-at xs v (i + 1)
  bvs-sells : List BbGoods, Integer, Integer, Integer -> Boolean
  bvs-sells (goods) (item) (graphic) (i) = if i >= list-length goods then False
    else ((list-at goods i).item == item & (list-at goods i).graphic == graphic) | bvs-sells goods item graphic (i + 1)
  bvt-sand : Integer -> [Console] Integer
  bvt-sand (unused) = act
    a <- bvt-check "item 104 is sand, dug only with the shovel (item 115), and no pickaxe resource yields it" (let c = bb-catalog 0 in (list-at c.items 103).name == "sand" & (list-at c.items 114).name == "shovel" & bvs-resource c.resources 104 115 0 & not (bvs-resource c.resources 104 25 0))
    b <- bvt-check "the sand gatherer's job tool is the shovel" (let t = cgg-trade-of cgg-sand-place in t.raw == 104 & t.tool == 115)
    c <- bvt-check "the tinker makes and sells shovels (0x0F39) on Tinkering from a bought ingot and a board" (let k = bb-recipe (bb-catalog 0) 115 0 in k > 0 & bvs-sells (bb-goods 6) 115 #0F39 0 & ep-classic 8 9 115 == 37 & (list-at (bb-catalog 0).recipes (k - 1)).one == 31 & (list-at (bb-catalog 0).recipes (k - 1)).two == 38)
    d <- bvt-check "the sand gatherer is founded right after the fisherman" (bvs-at cg-founders cgg-sand-place 0 == bvs-at cg-founders cgg-fish-place 0 + 1 & bvs-at cg-founders cgg-fish-place 0 >= 0)
    e <- bvs-dig 0
    f <- bvs-pick 0
    a + b + c + d + e + f
  end
  bvs-digs : EgGatherer, Integer -> Integer
  bvs-digs (g) (left) = if left == 0 then 0 else let got = egg-hour g in if got > 0 then got else bvs-digs g (left - 1)
  bvs-dig : Integer -> [Console] Integer
  bvs-dig (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("sand dig economy: " & e) False
    is Ok (x) -> when egg-new-for x 3002 cgg-sand-place 40 (cgg-trade-of cgg-sand-place).tool
      is Err (e) -> bvt-check ("sand dig gatherer: " & e) False
      is Ok (g) -> let got = bvs-digs g 200
        in bvt-check "a sand gatherer founded with its job tool holds a shovel and digs sand into its stock (egg-hour, the live harvest)" (ep-tool (ep-actor x.world g.producer.actor) 115 & got > 0 & ep-at (ep-actor x.world g.producer.actor).stock 104 >= got)
  bvs-pick : Integer -> [Console] Integer
  bvs-pick (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("sand pick economy: " & e) False
    is Ok (x) -> when egg-new-for x 3003 cgg-sand-place 40 25
      is Err (e) -> bvt-check ("sand pick gatherer: " & e) False
      is Ok (g) -> bvt-check "a digger holding only a pickaxe gets no sand" (ep-tool (ep-actor x.world g.producer.actor) 25 & not (ep-tool (ep-actor x.world g.producer.actor) 115) & bvs-digs g 200 == 0 & ep-at (ep-actor x.world g.producer.actor).stock 104 == 0)