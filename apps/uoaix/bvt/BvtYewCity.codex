Chapter: BvtYewCity
  cites Uoaix chapter Cities
  cites Uoaix chapter BvtCheck

  bvt-yew-city : Integer -> [Console] Integer
  bvt-yew-city (unused) = let cities = ct-table 0
    in let i = ct-city-at cities 550 990 0
    in act
      a <- bvt-check "Yew's town (the docks, the central shops, Empath Abbey, the Great Oak shops and the sheep pens and farms beside them) is one city window (UOAIX-217)" (i > 0 & (list-at cities i).name == "Yew" & ct-city-at cities 497 769 0 == i & ct-city-at cities 639 856 0 == i & ct-city-at cities 620 1145 0 == i & ct-city-at cities 683 1203 0 == i & ct-city-at cities 571 1241 0 == i)
      b <- bvt-check "Yew's prison, the far west healer and the west wheat field lie outside its window, spawned by the pulse of a player there" (ct-city-at cities 266 764 0 == -1 & ct-city-at cities 329 1243 0 == -1 & ct-city-at cities 369 1177 0 == -1)
      a + b
    end