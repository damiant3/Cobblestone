Chapter: BvtLookRange
  cites Uoaix chapter GameSkillsItems
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  blr-made : Result Integer Text -> Integer
  blr-made (r) = when r is Ok (serial) -> serial is Err (_) -> 0
  blr-at : WorldTable, Integer, Integer, Integer, Integer -> Integer
  blr-at (w) (kind) (x) (y) (container) = blr-made (world-create w (WorldObject { serial = 0, kind = kind, x = x, y = y, z = 0, graphic = (if kind == 1 then 400 else #0E75), hue = 0, container = container, amount = 1, health = 1 }))
  blr-seen : WorldTable, Integer, Integer -> Boolean
  blr-seen (w) (me) (serial) = when world-get w me
    is Err (_) -> False
    is Ok (m) -> when world-get w serial
      is Err (_) -> False
      is Ok (o) -> gsi-in-view w m o 8
  blr-checks : Integer -> Integer
  blr-checks (unused) = when world-new 64
    is Err (_) -> -1
    is Ok (w) -> let me = blr-at w 1 1500 1600 0
      in let near = blr-at w 2 1510 1612 0
      in let bag = blr-at w 2 1505 1600 0
      in let inside = blr-at w 2 0 0 bag
      in let far = blr-at w 2 1500 1619 0
      in let other = blr-at w 1 2500 1600 0
      in let pack = blr-at w 2 0 0 other
      in let gold = blr-at w 2 0 0 pack
      in (if blr-seen w me near then 1 else 0) + (if blr-seen w me inside then 2 else 0)
        + (if blr-seen w me far then 0 else 4) + (if blr-seen w me gold then 0 else 8) + (if blr-seen w me other then 0 else 16)
  bvt-look-range : Integer -> [Console] Integer
  bvt-look-range (unused) = act
    n <- blr-checks 0
    bvt-check ("a single click names a ground item or a bag's contents within 18 tiles, and nothing past them: no far item, no far player and no gold in a far player's pack (red, UOAIX audit 2026-10-18; code " & show n & ", 31 is all)") (n == 31)
  end
