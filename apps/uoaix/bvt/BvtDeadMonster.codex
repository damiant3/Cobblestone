Chapter: BvtDeadMonster
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bdm-profile : Integer, Integer -> WsProfile
  bdm-profile (body) (ai) = WsProfile { key = "fixture", name = "a fixture", body = body, hue = 0, hue-high = 0, water = False,
    strength-low = 1, strength-high = 1, dex-low = 1, dex-high = 1, hits-low = 1, hits-high = 1, damage-low = 1, damage-high = 1,
    skill-low = 0, skill-high = 0, tactics-low = 0, tactics-high = 0, ai = ai, taming = 0 }
  bvt-dead-monster : Integer -> [Console] Integer
  bvt-dead-monster (unused) = let profiles = [bdm-profile 17 2, bdm-profile 237 1, bdm-profile 50 11]
    in let monsters = cg-hunter-body profiles 17 0 & cg-hunter-body profiles 50 0
    in let others = not (cg-hunter-body profiles 237 0) & not (cg-hunter-body profiles 400 0) & not (cg-hunter-body [] 17 0)
    in let feelings = cg-cheered-mood 70 == 80 & cg-cheered-mood 95 == 100 & cg-cheered-alarm 300 == 500 & cg-cheered-alarm 900 == 1000
    in let lines = cg-cheer-line 0 /= cg-cheer-line 1 & cg-cheer-line 1 /= cg-cheer-line 2 & cg-cheer-line 3 == cg-cheer-line 0
    in act
      a <- bvt-check "a corpse whose body a hunting profile wears (ai 2 or 11) is a monster's" monsters
      b <- bvt-check "a grazing creature's corpse, a human's (400) and any body with no profile are not" others
      c <- bvt-check "a witness's mood rises 10 of 100 and its alarm 200 of 1000, each held to its ceiling" feelings
      d <- bvt-check "witnesses say three different happy-and-concerned lines" lines
      a + b + c + d
    end
