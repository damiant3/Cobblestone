Chapter: BvtGotoDungeons
  cites Uoaix chapter GotoPlaceData
  cites Uoaix chapter BvtCheck

 Damian, 2026-10-09: "just make sure all the dungeons are in there too". Counts the [goto places of a town, and of a name.
  bgd-town : List CpPlace, Text, Integer -> Integer
  bgd-town (places) (town) (i) = if i >= list-length places then 0
    else (if (list-at places i).town == town then 1 else 0) + bgd-town places town (i + 1)
  bgd-named : List CpPlace, Text, Integer -> Integer
  bgd-named (places) (name) (i) = if i >= list-length places then 0
    else (if (list-at places i).name == name then 1 else 0) + bgd-named places name (i + 1)
  bgd-dungeons : List CpPlace -> Boolean
  bgd-dungeons (places) = bgd-town places "Dungeon" 0 == 10 & bgd-named places "covetous" 0 == 1 & bgd-named places "deceit" 0 == 1
    & bgd-named places "despise" 0 == 1 & bgd-named places "destard" 0 == 1 & bgd-named places "hythloth" 0 == 1
    & bgd-named places "shame" 0 == 1 & bgd-named places "wrong" 0 == 1 & bgd-named places "ice" 0 == 1
    & bgd-named places "fire" 0 == 1 & bgd-named places "orccave" 0 == 1
  bvt-goto-dungeons : Integer -> [Console] Integer
  bvt-goto-dungeons (unused) =
    let places = gpd-places 0
    in act
      a <- bvt-check "[goto lists the ten dungeon entrances of the 1.25 map" (bgd-dungeons places)
      b <- bvt-check "[goto lists no Lost Lands town (Papua, Delucia)" (bgd-town places "Papua" 0 == 0 & bgd-town places "Delucia" 0 == 0 & bgd-named places "papuabank" 0 == 0)
      a + b
    end
