Chapter: BvtFarmPeach
  cites Uoaix chapter CompositePlanting
  cites Uoaix chapter BvtCheck

 Damian, 2026-10-09: "add peach tree to brit farm". The Royal Test Farm's beds hold one peach (resource 41), a planted
 tree (species 0) whose leaves swap between 0x0D9E with fruit and 0x0D9D bare, on a field tile no other bed takes.
  bfp-count : List (List Integer), Integer, Integer -> Integer
  bfp-count (beds) (resource) (i) = if i >= list-length beds then 0
    else (if list-at (list-at beds i) 0 == resource then 1 else 0) + bfp-count beds resource (i + 1)
  bfp-shared : List (List Integer), Integer, Integer, Integer -> Integer
  bfp-shared (beds) (x) (y) (i) = if i >= list-length beds then 0
    else (if list-at (list-at beds i) 1 == x & list-at (list-at beds i) 2 == y then 1 else 0) + bfp-shared beds x y (i + 1)
  bvt-farm-peach : Integer -> [Console] Integer
  bvt-farm-peach (unused) = act
    a <- bvt-check "the Royal Test Farm plants one peach tree (resource 41), a planted orchard tree with fruit 0x0D9E and bare leaves 0x0D9D" (bfp-count cpl-farm-beds 41 0 == 1 & cpl-tree 41 & cpl-orchard 41 & cpl-fruit 41 == #0D9E & cpl-leaves 41 == #0D9D)
    b <- bvt-check "the peach bed at 1215,1610 shares its tile with no other bed" (bfp-shared cpl-farm-beds 1215 1610 0 == 1)
    a + b
  end
