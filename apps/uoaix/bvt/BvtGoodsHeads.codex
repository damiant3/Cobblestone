Chapter: BvtGoodsHeads
  cites Uoaix chapter GameVendorCodec
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvt-goods-heads : Integer -> [Console] Integer
  bvt-goods-heads (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("goods heads fixture economy: " & e) False
    is Ok (x) -> act
      w <- x.world
      grown <- ep-grow-actors w (ep-actor-block + 8)
      far <- list-length w.actors - 1
      plain <- __record-set w "goods" (ep-goods-new 0)
      plain-rows <- ep-grow-goods w.goods 256
      refused <- not (ep-lot-key w.goods 1 far)
      fixed <- gvsc-fresh-goods w
      fixed-rows <- ep-grow-goods w.goods 256
      accepted <- ep-lot-key w.goods 1 far
      near <- ep-lot-key w.goods 1 1
      print-line-uni ("GOODSHEADS actors=" & show (list-length w.actors) & " block=" & show ep-actor-block)
      a <- bvt-check "a vendor restore's fresh goods take lot heads for every restored actor, so a lot of an actor past the first block loads (bvt-42954 boot2: vendor lot record invalid)" (far > ep-actor-block & refused & accepted & near)
      a
    end
