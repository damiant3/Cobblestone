Chapter: BvtPlayGo
  cites Uoaix chapter CompositePlays
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter PlayRun
  cites Uoaix chapter BvtCheck

 A 0x03 speech packet carrying a [play subcommand: the text starts at byte 8 and ends with a zero.
  bpg-packet : Text -> List Integer
  bpg-packet (words) = [3, 0, 0, 0, 0, 0, 0, 0] & text-to-utf8-bytes ("[play " & words) & [0]
 Bits: 1 a loaded sample takes the GM to its first scene's centre (1462,1630), 2 [play show moves no one, 4 the cast
 line names Nell at her door mark before the start; 7 is all.
  bpg-checks : Integer -> Integer
  bpg-checks (unused) = when cg-game 512
    is Err (_) -> -1
    is Ok (game) -> let st = plr-new 0
      in let loaded = cpy-load-sample st 0 game
      in let spot = cpy-scene-spot st (bpg-packet "sample")
      in let still = cpy-scene-spot st (bpg-packet "show")
      in (if list-length spot == 2 & list-at spot 0 == 1462 & list-at spot 1 == 1630 then 1 else 0)
        + (if list-length still == 0 then 2 else 0)
        + (if text-contains loaded "Nell enters at 1452 1618" then 4 else 0)
  bvt-play-go : Integer -> [Console] Integer
  bvt-play-go (unused) = let code = bpg-checks 0 in act
    a <- bvt-check ("plays: [play sample goes to the first scene, [play show does not, and the cast line names each mark (code " & show code & ")") (code == 7)
    a
  end
