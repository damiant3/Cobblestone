Chapter: BvtPowderTrade
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter BritainShops
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter BvtCheck

  bvpt-in : List BbGoods, Integer -> Boolean
  bvpt-in (goods) (i) = if i >= list-length goods then False else (list-at goods i).item == 166 | bvpt-in goods (i + 1)
  bvpt-listed : Integer -> Boolean
  bvpt-listed (role) = if role >= bb-shop-count then False else bvpt-in (bb-goods role) 0 | bvpt-listed (role + 1)
  bvpt-bids : Integer -> Boolean
  bvpt-bids (unused) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> False
    is Ok (w) -> gvb-bid w 1 166 >= 1 & gvb-bid w 0 166 == 0
  bvt-powder-trade : Integer -> [Console] Integer
  bvt-powder-trade (unused) = act
    a <- bvt-check "the blacksmith buys and sells the powder of restoration (item 166, UOAIX-237 F3) and bids for it" ((list-at (bb-catalog 0).items 165).name == "powder of restoration" & gvb-material 1 166 & gvb-goods 1 166 & bvpt-bids 0)
    b <- bvt-check "no shop makes the powder and no other role trades it: a provisioner bids nothing, and no shelf lists it" (not (bvpt-listed 0) & not (gvb-material 0 166) & not (gvb-goods 20 166))
    a + b
  end

