Chapter: BvtCastleOrchard
  cites Uoaix chapter CompositePlanting
  cites Uoaix chapter BritainCatalog
  cites Uoaix chapter GameVendorBuys
  cites Uoaix chapter GameHarvestProduction
  cites Uoaix chapter EconomyProduction
  cites Uoaix chapter GameHarvestCodec
  cites Uoaix chapter BvtCheck

  bco-sites : List (List Integer), Integer -> Integer
  bco-sites (trees) (i) = if i >= list-length trees then 0
    else (if cpl-map-orchard-resource (list-at (list-at trees i) 0) > 0 then 1 else 0) + bco-sites trees (i + 1)
  bco-fruit-art : List (List Integer), Integer -> Boolean
  bco-fruit-art (trees) (i) = if i >= list-length trees then True
    else let art = list-at (list-at trees i) 0
    in art >= #0D94 & art <= #0DAB & bco-fruit-art trees (i + 1)
  bco-peach : EgCatalog -> Boolean
  bco-peach (c) = list-length c.items >= 151 & list-length c.resources >= 41 & (list-at c.items 149).name == "peaches" & (list-at c.items 150).name == "peach cutting"
    & (list-at c.resources 40).item == 150 & (list-at c.resources 40).seed == 151 & (list-at c.resources 40).tool == 0 & (list-at c.resources 40).regrow == 96
  bco-site : Integer, Integer -> GhSite
  bco-site (resource) (species) = GhSite { x = 1363, y = 1601, z = 30, resource = resource, node = 1, base = 0, species = species, felled = 0 }
  bvt-castle-orchard : Integer -> [Console] Integer
  bvt-castle-orchard (unused) = act
    a <- bvt-check "the castle orchard lists 29 fruit trees and every one is a site" (list-length cpl-castle-orchard == 29 & bco-fruit-art cpl-castle-orchard 0 & bco-sites cpl-castle-orchard 0 == 29)
    b <- bvt-check "an apple trunk or its fruit leaves names apples (16), a peach peaches (41), a pear pears (39); an oak or a stump names none" (cpl-map-orchard-resource #0D98 == 16 & cpl-map-orchard-resource #0D9A == 16 & cpl-map-orchard-resource #0D9C == 41 & cpl-map-orchard-resource #0DA3 == 41 & cpl-map-orchard-resource #0DA4 == 39 & cpl-map-orchard-resource #0DAA == 39 & cpl-map-orchard-resource #0CDA == 0 & cpl-map-orchard-resource #0E56 == 0)
    d <- bvt-check "peaches are item 150 and a peach cutting 151, resource 41 an orchard that picks by hand, a food the inn buys, drawn as 0x09D2" (bco-peach (bb-catalog 0) & cpl-orchard 41 & ep-food 150 & gvb-material 5 150 & gh-output-graphic 150 == #09D2 & eg-validate (bb-catalog 0) == 0)
    c <- bvt-check "a fruit site holding its map trunk is a map tree, drawn by the decoration; a planted fruit tree (species 0) and a timber site with a species are not" (cpl-map-tree (bco-site 16 #0D98) & cpl-map-tree (bco-site 39 #0DA8) & not (cpl-map-tree (bco-site 16 0)) & not (cpl-map-tree (bco-site 15 #0CDA)))
    e <- bvt-check "the harvest codec keeps a site of every catalog resource, the peach (41) among them, and refuses 0 and one past the table, so a world with the castle orchard saves (UOAIX-208, candidate 42599)" (let n = list-length (bb-catalog 0).resources in n >= 41 & ghc-kind n 41 & ghc-kind n 16 & ghc-kind n 1 & not (ghc-kind n 0) & not (ghc-kind n (n + 1)))
    a + b + c + d + e
  end
