Chapter: BvtSwing
  cites Uoaix chapter GameHarvestState
  cites Uoaix chapter GameHarvest
  cites Uoaix chapter BvtCheck

  bvt-swing : Integer -> [Console] Integer
  bvt-swing (unused) = act
    a <- bvt-check "a mining swing waits 2400 ms, under a 2500 ms client macro (gh-swing-delay, set by gh-handler-at)" (gh-swing-delay 5 == gh-ticks 2400 & gh-swing-delay 5 < gh-ticks 2500)
    b <- bvt-check "fishing and lumberjacking keep their 3000 ms swing" (gh-swing-delay 9 == gh-ticks 3000 & gh-swing-delay 15 == gh-ticks 3000)
    a + b
  end
