Chapter: BvtCityJail
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter WalkMap
  cites Uoaix chapter BvtCheck
  cites Foreword chapter Result

  bvcj-fill : WalkMap, Integer -> Integer
  bvcj-fill (map) (i) = if i == map.width * map.height then 0
    else let land = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0 in bvcj-fill map (i + 1)
  bvcj-map : Integer -> Result WalkMap Text
  bvcj-map (unused) = when walk-map-sized 1816 2640 64 48 4
    is Err (e) -> Err e
    is Ok (map) -> let filled = bvcj-fill map 0 in Ok map
  bvt-city-jail : Integer -> [Console] Integer
  bvt-city-jail (unused) = when bvcj-map 0
    is Err (e) -> act bvt-check ("city jail map fixture: " & e) False end
    is Ok (map) -> let open = cg-jail-near map 1825 2676 0
      in let roofed = when walk-add-solid map 1829 2678 40 4 0 is Ok (_) -> True is Err (_) -> False
      in let covered = cg-jail-near map 1825 2676 0
      in let far = cg-jail-near map 1850 2660 0
      in act
        print-line-uni ("CITYJAIL open=" & show open & " roofed=" & (if roofed then "1" else "0") & " covered=" & show covered & " far=" & show far)
        a <- bvt-check "a city's jail cell is the roofed standing tile near its first guard post (UOAIX-217, root 2026-10-09)" (roofed & covered == 1829 * 8192 + 2678)
        b <- bvt-check "open land near a post, or a roof more than 8 tiles away, gives no cell" (open < 0 & far < 0)
        a + b
      end
