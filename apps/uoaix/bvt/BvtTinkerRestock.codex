Chapter: BvtTinkerRestock
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck

  bvtk-actor : Integer, Integer, Integer -> Integer
  bvtk-actor (boards) (hammers) (wear) = when ep-new (bb-catalog 0) (em-new 0)
    is Err (_) -> 0
    is Ok (w) -> let actor = ep-admit w (em-open w.money 2 1006) 100
      in if actor < 1 then 0
      else let a = ep-set (ep-actor w actor).stock 38 boards in let b = ep-set (ep-actor w actor).stock 62 hammers
      in let c = ep-set (ep-actor w actor).wear 62 wear in (if bb-restock-input w actor 42 then 1 else 0) + (if bb-retool-due w actor 62 then 2 else 0)
  bvt-tinker-restock : Integer -> [Console] Integer
  bvt-tinker-restock (unused) = act
    a <- bvt-check "the tinker restocks tinker's tools (42) from a held board and a hammer with wear left, and not without the board (UOAIX-229)" (bvtk-actor 1 1 31 == 1 & bvtk-actor 0 1 31 == 0)
    b <- bvt-check "a worn-out or absent hammer is due a re-tool and stops the restock; a hammer with wear left is not (UOAIX-229)" (bvtk-actor 1 1 0 == 2 & bvtk-actor 1 0 0 == 2 & bvtk-actor 1 1 2 == 1)
    c <- bvt-check "the tinker buys boards from the carpenter and its hammer from the blacksmith (UOAIX-229)" (bb-tinker == 6 & bb-carpenter == 7 & bb-blacksmith-shop == 1 & (list-at bb-shops bb-blacksmith-shop).title == "Blacksmith")
    a + b + c
  end
