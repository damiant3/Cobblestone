Chapter: BvtWorkerSave
  cites Uoaix chapter CompositeCodec
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

  bvt-worker-save : Integer -> [Console] Integer
  bvt-worker-save (unused) = act
    a <- bvt-check "GVS1 v35 has room for every worker founded past the miners (main 40050)" (cc-worker-room == list-length cg-founders & cc-worker-room >= 5)
    b <- bvt-check "a v35 frame recording the founders' room is the current save size" (bvt-ws-expected cc-worker-room == cc-size 64 - 16)
    c <- bvt-check "a v35 frame recording an out-of-range room is refused" (bvt-ws-expected 2000 == 0 - 1 & bvt-ws-expected (0 - 1) == 0 - 1)
    a + b + c
  end
  bvt-ws-expected : Integer -> Integer
  bvt-ws-expected (room) = let size = cc-v35-size 64 (max 0 room)
    in let buf = alloc-bytes (size + 16)
    in let put = poke-qword buf (cc-v34-size 64 + 8) room
    in cc-v35-expected buf size 64
