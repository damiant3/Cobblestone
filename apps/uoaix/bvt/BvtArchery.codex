Chapter: BvtArchery
  cites Uoaix chapter GameCombat
  cites Uoaix chapter BvtCheck

  bvt-archery-at : Integer, Integer, Integer -> WorldObject
  bvt-archery-at (serial) (x) (y) = WorldObject { serial = serial, kind = 1, x = x, y = y, z = 5, graphic = 400, hue = 0, container = 0, amount = 1, health = 50 }
  bvt-archery : Integer -> [Console] Integer
  bvt-archery (unused) =
    let ranges = cb-range #13B2 == 10 & cb-range #13B1 == 10 & cb-range #0F50 == 8 & cb-range #13FD == 8 & cb-range #0F52 == 0
    in let ammo = cb-ammo #13B2 == #0F3F & cb-ammo #0F50 == #1BFB & cb-ammo-art #13B2 == #0F42 & cb-ammo-art #13FD == #1BFE & cb-shoot-delay > 0
    in let shot = cb-moving (bvt-archery-at 4242 100 200) (bvt-archery-at 4343 105 200) #0F42
    in let flight = list-length shot == 28 & list-at shot 0 == #70 & list-at shot 1 == 0 & list-at shot 10 == #0F & list-at shot 11 == #42
    in let flash = cb-parry-effect (bvt-archery-at 4242 100 200)
    in let parried = list-at flash 0 == #70 & list-at flash 1 == 3 & list-at flash 10 == #37 & list-at flash 11 == #B9
    in let blocks = cb-parry-blocks 0 1000 & cb-parry-blocks 48 1000 & not (cb-parry-blocks 49 1000) & not (cb-parry-blocks 0 0)
    in let absorbs = cb-parry-absorb False False 20 == 0 & cb-parry-absorb True True 20 == 20 & cb-parry-absorb True False 20 == 10
    in act
      a <- bvt-check "a bow reaches 10 tiles and a crossbow 8, firing arrows and bolts after a half-second stand (cb-range, cb-ammo)" (ranges & ammo)
      b <- bvt-check "a shot flies as a 0x70 bolt of the ammunition's art and a parry flashes 0x37B9 (cb-moving, cb-parry-effect)" (flight & parried)
      c <- bvt-check "a GM parrier blocks 49 rolls in 100 and a novice none; a block absorbs a shield's whole armour against arrows, half against blades" (blocks & absorbs)
      a + b + c
    end
