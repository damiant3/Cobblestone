Chapter: BvtScroll
  cites Uoaix chapter BritainShops
  cites Uoaix chapter BvtCheck

  bvt-scroll : Integer -> [Console] Integer
  bvt-scroll (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("scroll fixture economy: " & e) False
    is Ok (x) -> let scribe = ep-admit x.world (eu-open x 2 2998) 100
      in let bare = ep-admit x.world (eu-open x 2 2997) 100
      in let blank = ep-find x.world scribe 106 1
      in let moss = ep-find x.world scribe 21 1
      in let shade = ep-find x.world scribe 20 1
      in let lone = ep-find x.world bare 106 1
      in let lone-moss = ep-find x.world bare 21 1
      in let ready = bb-scroll-ready x.world scribe (mgd-scroll 1)
      in let unready = bb-scroll-ready x.world bare (mgd-scroll 1)
      in let p = bb-producer x scribe
      in let inscribed = bb-inscribe p (mgd-scroll 1)
      in let stock = (ep-actor x.world scribe).stock
      in let silker = ep-admit x.world (eu-open x 2 2996) 100
      in let s-blank = ep-find x.world silker 106 1
      in let s-garlic = ep-find x.world silker 18 1
      in let s-ginseng = ep-find x.world silker 17 1
      in let s-silk = ep-find x.world silker 22 1
      in let s-ready = bb-scroll-ready x.world silker (mgd-scroll 4)
      in let feeble = bb-inscribe (bb-producer x silker) (mgd-scroll 4)
      in let s-stock = (ep-actor x.world silker).stock
      in act
        a <- bvt-check "every reagent spell is inscribed, the three reagents the plants lack included (Clumsy: plants; Feeblemind: spiders' silk; Magic Arrow: sulfurous ash; Recall: black pearl), and art that is no scroll is not (UOAIX-248)" (bb-scroll-spell (mgd-scroll 1) == 1 & bb-scroll-spell (mgd-scroll 4) == 4 & bb-scroll-spell (mgd-scroll 5) == 5 & bb-scroll-spell (mgd-scroll 32) == 32 & bb-scroll-spell #0EF3 == 0)
        b <- bvt-check "the scribe lists a scroll, catalog item 116, for every supported spell that takes reagents, more than the 18 plant-only ones, Fireball and Flamestrike among them" (bvsc-scrolls (bb-goods 9) 0 == list-length bb-scroll-spells & list-length bb-scroll-spells > 18 & bvsc-has bb-scroll-spells 18 0 & bvsc-has bb-scroll-spells 51 0 & (list-at (bb-catalog 0).items 115).name == "spell scroll")
        c <- bvt-check "a scribe holding a blank scroll and the spell's reagents inscribes one scroll, spending exactly those" (scribe > 0 & ready & is-ok inscribed & ep-at stock 116 == 1 & ep-at stock 106 == 0 & ep-at stock 21 == 0 & ep-at stock 20 == 0 & p.item == 116 & p.quantity == 1)
        d <- bvt-check "a scribe missing one reagent (nightshade) inscribes nothing" (bare > 0 & not unready)
        e <- bvt-check "a scribe holding spiders' silk, garlic, ginseng and a blank inscribes Feeblemind, spending the silk (bit 6, UOAIX-248)" (silker > 0 & s-ready & is-ok feeble & ep-at s-stock 116 == 1 & ep-at s-stock 22 == 0 & ep-at s-stock 18 == 0 & ep-at s-stock 17 == 0)
        a + b + c + d + e
      end
  bvsc-has : List Integer, Integer, Integer -> Boolean
  bvsc-has (xs) (x) (i) = if i >= list-length xs then False else list-at xs i == x | bvsc-has xs x (i + 1)
  bvsc-scrolls : List BbGoods, Integer -> Integer
  bvsc-scrolls (goods) (i) = if i >= list-length goods then 0
    else (if (list-at goods i).item == 116 & bb-scroll-spell (list-at goods i).graphic > 0 then 1 else 0) + bvsc-scrolls goods (i + 1)
