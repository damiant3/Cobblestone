Chapter: BvtLotsSeen
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter BvtCheck

 cg-items runs on every pulse and every handled packet, so a walk of every economy lot there costs sessions times the
 world; a pass walks the chain only when its newest lot changed (serials are never reused).
  bls-lot : CompositeGame -> Integer
  bls-lot (owner) = when world-create owner.checkpoint.game.world (gs-item 0 3701 0)
    is Err (_) -> 0
    is Ok (serial) -> ep-occupy owner.vendor.currency.world.goods serial 1 3 0 0 0
  bls-forget : CompositeGame, Integer -> Integer
  bls-forget (owner) (serial) = let slot = world-slot owner.items.world serial
    in if slot < 0 then 0 else let row = __record-set (list-at owner.items.items slot) "serial" 0 in 1
  bvt-lots-seen : Integer -> [Console] Integer
  bvt-lots-seen (unused) = when cg-new 0
    is Err (e) -> bvt-check ("lots seen fixture: " & e) False
    is Ok (owner) -> let first = bls-lot owner
      in let walked = cg-items owner 0
      in let known = first /= 0 & gsi-known owner.items first
      in let forgot = bls-forget owner first
      in let idle = cg-items owner 0
      in let skipped = not (gsi-known owner.items first)
      in let second = bls-lot owner
      in let again = cg-items owner 0
      in let both = second /= 0 & gsi-known owner.items first & gsi-known owner.items second
      in act
        a <- bvt-check "a new lot is registered by the next pass" known
        b <- bvt-check "a pass with no new lot walks no lot: a forgotten lot stays unknown" (forgot == 1 & skipped)
        c <- bvt-check "the next new lot walks the chain again and registers both" both
        a + b + c
      end
