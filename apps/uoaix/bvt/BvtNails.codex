Chapter: BvtNails
  cites Uoaix chapter GameCraft
  cites Uoaix chapter BvtCheck

  bvt-nails-in : EpWorld, List Integer, Integer -> Boolean
  bvt-nails-in (w) (recipes) (i) = if i >= list-length recipes then False
    else if (list-at w.catalog.recipes (list-at recipes i - 1)).item == 39 then True
    else bvt-nails-in w recipes (i + 1)
  bvt-nails : Integer -> [Console] Integer
  bvt-nails (unused) = when bb-economy 0
    is Err (e) -> bvt-check ("nails fixture economy: " & e) False
    is Ok (x) -> act
      w <- x.world
      tinkering <- gcr-recipes w 4
      a <- bvt-check "a player's Tinkering menu offers nails, 4 from 1 iron ingot (row 23)" (bvt-nails-in w tinkering 0 & (list-at w.catalog.recipes 16).item == 39 & (list-at w.catalog.recipes 16).one == 31 & (list-at w.catalog.recipes 16).quantity == 4)
      b <- bvt-check "nails are made on the Tinkering skill, drawn as nails (0x102E)" (gcr-skill 4 == 37 & gcr-graphic 39 == #102E & gcr-variant 4 5 39 == #102E)
      a + b
    end
