Chapter: GameHunger

 ServUO Food.FillHunger and FoodDecay (pre-AOS): hunger runs 0 to 20, eating adds the food's FillFactor up to 20, a
 character at 20 cannot eat, and every 5 minutes online takes 1 away. Character slot byte 150 holds hunger + 1; 0 is
 a character that has not eaten since the byte was assigned, counted as 10. Damian 2026-10-06: regeneration of hit
 points, stamina and mana scales with hunger and a well-fed character regenerates 50% faster; root's reading, normal
 when merely fed. Below 5 (ServUO "extremely hungry") an interval doubles; from 15 ("quite full") it is two thirds.
 FillFactor by graphic is ServUO Food.cs and Fruits.cs; 0 is not food.

  gh-kind : Integer = 10
  gh-decay-ms : Integer = 300000

  gh-fed : Integer -> Integer
  gh-fed (row) = let s = peek-byte row 150 in if s == 0 then 10 else min 20 (s - 1)
  gh-set : Integer, Integer -> Integer
  gh-set (row) (fed) = poke-byte row 150 (max 0 (min 20 fed) + 1)
  gh-interval : Integer, Integer -> Integer
  gh-interval (row) (base) = let fed = gh-fed row
    in if fed < 5 then base * 2 else if fed >= 15 then base * 2 / 3 else base

  gh-fill : Integer -> Integer
  gh-fill (g) = if g == #097B | g == #0976 | g == #097E | g == #097D | g == #098C | g == #103B | g == #99A0 then 3
    else if g == #0979 | g == #097C | g == #0C74 | g == #0C64 | g == #0C66 | g == #0C81 | g == #0D3A then 1
    else if g == #09B6 | g == #09C0 | g == #160B | g == #09EB | g == #1608 then 4
    else if g == #09B7 | g == #09C9 | g == #09F2 | g == #1041 | g == #160A | g == #999F | g == #0993 | g == #0C5C | g == #0C5D then 5
    else if g == #1040 then 6
    else if g == #09E9 then 10
    else if g == #09BB then 20
    else if g == #A0DA | g == #A0D8 | g == #A0D9 | g == #A0D6 | g == #A0D7 then 2
    else if g == #171F | g == #1721 | g == #1722 | g == #1725 | g == #1728 | g == #1729 | g == #172A | g == #172B | g == #1726 then 1
    else if g == #1723 | g == #1727 | g == #09D1 | g == #09D2 | g == #0994 | g == #09D0 | g == #0C72 | g == #0C79 | g == #9E86 then 1
    else 0

  gh-eaten : Integer -> Text
  gh-eaten (fed) = if fed >= 20 then "You manage to eat the food, but you are stuffed!"
    else if fed < 5 then "You eat the food, but are still extremely hungry."
    else if fed < 10 then "You eat the food, and begin to feel more satiated."
    else if fed < 15 then "After eating the food, you feel much less hungry."
    else "You feel quite full after consuming the food."

  gh-full : Text = "You are simply too full to eat any more!"

