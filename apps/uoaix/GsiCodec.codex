Chapter: GsiCodec
  cites Uoaix chapter GameSkillsItems

 GSI1 uses a 16-byte little-endian header and five qwords per world slot.
 Cursors and connection authority are deliberately absent from this format.

  gic-size : GsiState -> Integer
  gic-size (state) = 16 + state.world.capacity * 40
  gic-write-rows : GsiState, Integer, Integer -> Integer
  gic-write-rows (state) (buffer) (i) = if i == state.world.capacity then 0 else let meta = list-at state.items i
    in let live = meta.serial > 0 & peek-qword (wi-object state.world.buffer i) 0 == meta.serial
    in let at = 16 + i * 40
    in let a = poke-qword buffer at (if live then meta.serial else 0)
    in let b = poke-qword buffer (at + 8) (if live then meta.layer else 0)
    in let c = poke-qword buffer (at + 16) (if live then meta.gump else 0)
    in let d = poke-qword buffer (at + 24) (if live & meta.movable then 1 else 0)
    in let e = poke-qword buffer (at + 32) (if live & meta.stackable then 1 else 0)
    in gic-write-rows state buffer (i + 1)
  gic-write : GsiState, Integer, Integer -> Result Integer Text
  gic-write (state) (buffer) (length) = if length /= gic-size state then Err "GSI1 extent"
    else let a = poke-qword buffer 0 #31495347
    in let b = poke-qword buffer 8 state.world.capacity
    in let c = gic-write-rows state buffer 0 in Ok length
  gic-valid : WorldTable, Integer, Integer -> Boolean
  gic-valid (world) (buffer) (i) = if i == world.capacity then True else let at = 16 + i * 40
    in let serial = peek-qword buffer at
    in let layer = peek-qword buffer (at + 8)
    in let gump = peek-qword buffer (at + 16)
    in let movable = peek-qword buffer (at + 24)
    in let stackable = peek-qword buffer (at + 32)
    in let valid = if serial == 0 then layer == 0 & gump == 0 & movable == 0 & stackable == 0
      else serial > 0 & peek-qword (wi-object world.buffer i) 0 == serial & peek-qword (wi-object world.buffer i) 8 == 2
        & layer >= 0 & layer <= 29 & gump >= 0 & gump <= 65535 & movable >= 0 & movable <= 1 & stackable >= 0 & stackable <= 1
        & (stackable == 0 | (layer == 0 & gump == 0))
    in valid & gic-valid world buffer (i + 1)
  gic-read-rows : GsiState, Integer, Integer -> Integer
  gic-read-rows (state) (buffer) (i) = if i == state.world.capacity then 0 else let at = 16 + i * 40
    in let serial = peek-qword buffer at
    in let registered = if serial == 0 then 0 else gsi-register state serial (peek-qword buffer (at + 8)) (peek-qword buffer (at + 16)) (peek-qword buffer (at + 24) == 1) (peek-qword buffer (at + 32) == 1)
    in if registered < 0 then -1 else gic-read-rows state buffer (i + 1)
  gic-read : WorldTable, Integer, Integer -> Result GsiState Text
  gic-read (world) (buffer) (length) = if not (world-indexed world) then Err "GSI1 requires rebuilt world index"
    else if length /= 16 + world.capacity * 40 then Err "GSI1 extent"
    else if peek-qword buffer 0 /= #31495347 | peek-qword buffer 8 /= world.capacity then Err "GSI1 header"
    else if not (gic-valid world buffer 0) then Err "GSI1 metadata or world binding"
    else let state = gsi-new world
    in let read = gic-read-rows state buffer 0
    in if read < 0 then Err "GSI1 layer registration refused" else Ok state
