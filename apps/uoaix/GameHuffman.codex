  gh-store : Integer, List Integer, Integer -> Integer
  gh-store (buffer) (table) (i) =
    if i >= 514 then buffer
    else let wrote = poke-32 buffer (i * 4) (list-at table i)
    in gh-store buffer table (i + 1)

  gh-new : Integer -> Integer
  gh-new (unused) = gh-store (alloc-bytes 2056) gh-codebook 0

  HuffWrite = record { bytes : List Integer, value : Integer, bits : Integer }

  gh-bits : HuffWrite, Integer, Integer -> HuffWrite
  gh-bits (writer) (code) (left) =
    if left <= 0 then writer
    else let value = writer.value * 2 + bit-and (bit-shr code (left - 1)) 1
    in let bits = writer.bits + 1
    in if bits == 8 then
      let bytes = list-push writer.bytes value
      in let a = __record-set writer "bytes" bytes
      in let b = __record-set a "value" 0
      in let c = __record-set b "bits" 0
      in gh-bits c code (left - 1)
    else let a = __record-set writer "value" value
    in let b = __record-set a "bits" bits
    in gh-bits b code (left - 1)

  gh-encode-loop : Integer, List Integer, Integer, HuffWrite -> Result (List Integer) Text
  gh-encode-loop (table) (input) (i) (writer) =
    if i >= list-length input then
      let ended = gh-bits writer (peek-32 table 2052) (peek-32 table 2048)
      in if ended.bits == 0 then Ok ended.bytes
      else Ok (list-push ended.bytes (bit-shl ended.value (8 - ended.bits)))
    else let byte = list-at input i
    in if byte < 0 | byte > 255 then Err "Huffman input is not a byte"
    else let next = gh-bits writer (peek-32 table (byte * 8 + 4)) (peek-32 table (byte * 8))
    in gh-encode-loop table input (i + 1) next

  gh-encode : Integer, List Integer -> Result (List Integer) Text
  gh-encode (table) (input) =
    if list-length input > 4096 then Err "Huffman packet budget"
    else let writer = HuffWrite { bytes = __list-with-capacity ((list-length input * 11 + 11) / 8), value = 0, bits = 0 }
    in gh-encode-loop table input 0 writer
