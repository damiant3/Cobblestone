 The Britain shop whose goods vendor i sells: itself for a Britain shop, its role for a city shop, -1 past the table.
  ct-vendor-role : Integer -> Integer
  ct-vendor-role (i) = if i < 0 then -1 else if i < bb-shop-count then i
    else if i - bb-shop-count < list-length ct-shop-roles then list-at ct-shop-roles (i - bb-shop-count) else -1

 A city's foot guards walk patrols of four waypoints between its UOX3 guard posts (spawn_felucca_town_<city>.dfn guard
 regions); a guard founded for patrol k starts at its first waypoint. A city appends its patrols to ct-city-patrols.
  CtPatrol = record { city : Integer, xs : List Integer, ys : List Integer }
  ct-patrols-trinsic : Integer -> List CtPatrol
  ct-patrols-trinsic (unused) = [
    CtPatrol { city = 1, xs = [1825, 1866, 1866, 1825], ys = [2676, 2644, 2676, 2676] },
    CtPatrol { city = 1, xs = [1825, 1990, 2046, 1825], ys = [2827, 2910, 2778, 2827] }]
  ct-city-patrols : Integer -> List CtPatrol
  ct-city-patrols (unused) = ct-patrols-trinsic 0 & ct-patrols-nujelm 0 & ct-patrols-red 0 & ct-patrols-vesper-cove 0
