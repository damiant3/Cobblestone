  gh-denied : Text -> Result (Maybe GameReply) Text
  gh-denied (text) = Ok (Just (gsi-denied text))
  gh-refused : Text, Integer, Integer, Integer, Integer -> Result (Maybe GameReply) Text
  gh-refused (text) (x) (y) (z) (graphic) = Ok (Just (gs-reply [sip-message #FFFFFFFF #FFFF 6 text]
    (text & " target=" & show x & "," & show y & "," & show z & " id=" & show graphic)))
  gh-carried : GameHarvest, GvPlayer, WorldObject -> Boolean
  gh-carried (state) (player) (tool) =
    if not (gsi-known state.items tool.serial) then False
    else if gmb-root state.items tool.serial 65 /= 0 then False
    else if tool.container == player.serial then
      let layer = (gsi-meta state.items tool.serial).layer
      in layer >= 1 & layer <= 25
    else gv-under state.items.world tool.serial player.pack 65
  gh-tool : GameHarvest, GvPlayer, Integer -> Integer
  gh-tool (state) (player) (serial) =
    let at = gv-lot state.vendor serial 0
    in if at < 0 then -1
    else let lot = list-at state.vendor.lots at
    in if lot.actor /= player.actor | lot.quantity /= 1 | lot.wear < 1
      | gh-tool-type lot.item == 0 | not (gsi-known state.items serial)
      | not (gv-owned state.items.world serial player.serial 65) then -1
    else when world-get state.items.world serial
      is Err (_) -> -1
      is Ok (tool) -> if tool.kind /= 2 | tool.amount /= 1 | not (gh-tool-graphic lot.item tool.graphic)
        | not (gh-carried state player tool) then -1 else at
  gh-begin : GameHarvest, GvPlayer, GhRequest, Integer, Integer -> Result (Maybe GameReply) Text
  gh-begin (state) (player) (request) (tool) (now) =
    if gh-tool state player tool < 0 then gh-denied "You need your own usable harvesting tool."
    else if now < request.next then gh-denied "Wait before gathering again."
    else if state.nonce > 65535 then gh-denied "Harvest target contexts exhausted."
    else let target = #48410000 + state.nonce
    in let nonce = __record-set state "nonce" (state.nonce + 1)
    in let context = __record-set request "target" target
    in let selected = __record-set request "tool" tool
    in let expires = __record-set request "expires" (now + gh-ticks 10000)
    in let cursor = sip-target target
    in let ground = list-set-at cursor 1 1
    in let resource = gh-tool-type (list-at state.vendor.lots (gh-tool state player tool)).item
    in Ok (Just (gs-reply [cursor,sip-message #FFFFFFFF #FFFF 6 (gh-say resource 0)] "harvest target"))
 A gold vein is marked by an ore pile 0x19B9 in ServUO's gold ore hue 0x08A5 standing on its tile; a harvest aimed at
 the pile mines the land beneath it.
  gh-vein-art : Integer = #19B9
  gh-vein-hue : Integer = #08A5
  gh-vein-marker : WorldTable, Integer -> Boolean
  gh-vein-marker (world) (serial) = if serial == 0 then False else when world-get world serial
    is Err (_) -> False
    is Ok (o) -> o.kind == 2 & o.container == 0 & o.graphic == gh-vein-art & o.hue == gh-vein-hue
  gh-target : (WalkMap, WorldObject, Integer, Integer, Integer, Integer -> Integer),
    (GameHarvest, GvPlayer, Integer, Integer, Integer -> Result GameReply Text),
    GameHarvest, GvPlayer, GhRequest, GameInput, WalkMap, List Integer, Integer -> Result (Maybe GameReply) Text
  gh-target (lookup) (produce) (state) (player) (request) (input) (map) (packet) (now) =
    if request.target == 0 | request.target /= gp-u32 packet 2 then gh-denied "That harvest target is no longer active."
    else let tool = request.tool
    in let clear = __record-set request "target" 0
    in let x = gp-u16 packet 11
    in let y = gp-u16 packet 13
    in let raw-z = list-at packet 16
    in let z = if raw-z >= 128 then raw-z - 256 else raw-z
    in if x == 65535 | y == 65535 then Ok (Just (gs-reply [] "harvest cancelled"))
    else if now > request.expires | now < request.next then gh-denied "That harvest target expired."
    else let lot = gh-tool state player tool
    in if lot < 0 then gh-denied "Your harvesting tool is no longer available."
    else if (list-at state.items.actors (gsi-slot state.vendor.game input.session.serial 0)).holding /= 0 then gh-denied "Finish moving that item first."
    else when world-get state.items.world player.serial
      is Err (e) -> Err e
      is Ok (mobile) ->
        let resource = gh-tool-type (list-at state.vendor.lots lot).item
        in let range = if resource == 9 then 5 else 2
        in let marked = gh-vein-marker state.items.world (bit-and (gp-u32 packet 7) #7FFFFFFF)
        in let graphic = if marked then 0 else gp-u16 packet 17
        in if (gp-u32 packet 7 /= 0 & not marked) | x < mobile.x - range | x > mobile.x + range
          | y < mobile.y - range | y > mobile.y + range | (x == mobile.x & y == mobile.y) then gh-refused (gh-say resource 2) x y z graphic
        else if lookup map mobile x y z graphic /= resource then gh-refused (gh-say resource 1) x y z graphic
        else let node = gh-site state player resource x y (if graphic == 0 then walk-z map x y else z)
        in if node < 1 then gh-refused "The resource-node budget is full." x y z graphic
        else let next = __record-set request "next" (now + gh-ticks 3000)
        in when produce state player node lot now
          is Err (e) -> Err e
          is Ok (reply) -> Ok (Just reply)
  gh-handler-at : (WalkMap, WorldObject, Integer, Integer, Integer, Integer -> Integer),
    (GameHarvest, GvPlayer, Integer, Integer, Integer -> Result GameReply Text),
    GameHarvest, GameShard, GameInput, WalkMap, Integer, List Integer, Integer -> Result (Maybe GameReply) Text
  gh-handler-at (lookup) (produce) (state) (shard) (input) (map) (port) (packet) (now) =
    if list-length packet == 0 then Ok None
    else let op = list-at packet 0
    in if op /= 6 & op /= #6C & op /= #34 then Ok None
    else if list-length packet /= (if op == 6 then 5 else if op == #6C then 19 else 10)
      | not (gs-byte-range packet 0) then Err "harvest packet extent"
    else if op == #6C & bit-and (gp-u32 packet 2) #FFFF0000 /= #48410000 then Ok None
    else if op == #34 & list-at packet 5 /= 5 then Ok None
    else let lot = if op == 6 then gv-lot state.vendor (bit-and (gp-u32 packet 1) #7FFFFFFF) 0 else 0
    in if op == 6 & lot < 0 then Ok None
    else if op == 6 & gh-tool-type (list-at state.vendor.lots lot).item == 0 then Ok None
    else if input.mode /= 2 | input.session.phase /= 2 | shard.active /= input.session.serial
      | state.items.world.buffer /= shard.world.buffer | state.vendor.game.world.buffer /= shard.world.buffer then Err "harvest active world binding"
    else let at = gv-player state.vendor input.session.serial 0
    in let slot = gsi-slot shard input.session.serial 0
    in if at < 0 | slot < 0 | now < 0 | now > 9223372036854775807 - gh-ticks 10000 then Err "harvest player binding"
    else let player = list-at state.vendor.players at
    in if not (ep-valid-actor state.vendor.currency.world player.actor) then Err "harvest economy binding"
    else when world-get shard.world input.session.serial
      is Err (e) -> Err e
      is Ok (mobile) -> if mobile.health <= 0 then gh-denied "You cannot gather while dead."
        else let request = gh-session state input player slot
        in if op == 6 then gh-begin state player request (bit-and (gp-u32 packet 1) #7FFFFFFF) now
        else if op == #6C then gh-target lookup produce state player request input map packet now
        else if gp-u32 packet 6 /= player.serial then gh-denied "You may query only your own skills."
        else Ok (Just (gs-reply [gh-skills state player slot] "harvest skills"))
  gh-handler : (WalkMap, WorldObject, Integer, Integer, Integer, Integer -> Integer),
    (GameHarvest, GvPlayer, Integer, Integer, Integer -> Result GameReply Text),
    GameHarvest, GameShard, GameInput, WalkMap, Integer, List Integer -> Result (Maybe GameReply) Text
  gh-handler (lookup) (produce) (state) (shard) (input) (map) (port) (packet) =
    gh-handler-at lookup produce state shard input map port packet get-ticks

