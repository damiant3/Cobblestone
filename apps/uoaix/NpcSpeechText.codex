Chapter: NpcSpeechText
  cites Uoaix chapter GamePackets

 Source-X NPC_OnHearName and Event_Talk_Common use case-insensitive name/title
 and word matching. Apache-2.0, Sphere-LICENSE.txt. Four-tile pre-AOS vendor
 admission is corroborated by ServUO VendorAI.OnSpeech (Core.AOS ? 1 : 4).

  ns-fold : Integer -> Integer
  ns-fold (c) = if c >= 65 & c <= 90 then c + 32 else c
  ns-char : Text, Integer -> Integer
  ns-char (text) (i) = if i < 0 | i >= text-length text then 0 else ns-fold (to-unicode (char-code (char-at text i)))
  ns-word : Integer -> Boolean
  ns-word (c) = (c >= 97 & c <= 122) | (c >= 48 & c <= 57) | c == 39
  ns-match : Text, Text, Integer, Integer -> Boolean
  ns-match (text) (term) (at) (i) = if i == text-length term then not (ns-word (ns-char text (at + i)))
    else ns-char text (at + i) == ns-char term i & ns-match text term at (i + 1)
  ns-find : Text, Text, Integer -> Boolean
  ns-find (text) (term) (i) = if text-length term == 0 | i + text-length term > text-length text then False
    else if not (ns-word (ns-char text (i - 1))) & ns-match text term i 0 then True
    else ns-find text term (i + 1)
  ns-has : Text, Text -> Boolean
  ns-has (text) (term) = ns-find text term 0
  ns-command : Text -> Integer
  ns-command (text) = let buy = ns-has text "buy"
    in let sell = ns-has text "sell"
    in if buy & sell then -1 else if buy then 1 else if sell then 2 else if ns-has text "bank" then 3
    else if ns-has text "hello" | ns-has text "hi" | ns-has text "hail" | ns-has text "greetings" then 4
    else if ns-has text "name" then 5 else 0
