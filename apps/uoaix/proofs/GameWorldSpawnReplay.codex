Chapter: GameWorldSpawnReplay
  cites Uoaix chapter GameWorldSpawnCodec

  check : Text, Boolean -> [Console] Nothing
  check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  profile : Text, Integer, Integer -> WsProfile
  profile (name) (body) (ai) = WsProfile { key = name, name = name, body = body, hue = 0, hue-high = 0, water = False,
    strength-low = 30, strength-high = 30, dex-low = 40, dex-high = 40,
    hits-low = 30, hits-high = 30, damage-low = 2, damage-high = 5,
    skill-low = 300, skill-high = 300, tactics-low = 300, tactics-high = 300, ai = ai, gold-low = 0, gold-high = 0, taming = 0 }
  catalog : Integer -> WsCatalog
  catalog (unused) = WsCatalog { revision = 1234,
    profiles = [profile "Orc" 17 2, profile "Deer" 237 12],
    groups = [WsGroup { key = "hostile", choices = [WsChoice { key = "orc", profile = 0, group = -1, weight = 1 }] },
      WsGroup { key = "wildlife", choices = [WsChoice { key = "deer", profile = 1, group = -1, weight = 1 }] }],
    regions = [WsRegion { id = 1, name = "wild camp", area = WsRect { x1 = 1421, y1 = 1698, x2 = 1423, y2 = 1701 },
      maximum = 1, batch = 3, minimum-minutes = 1, maximum-minutes = 1, group = 0,
      preferred-height = 18, fixed-height = -129, outside = False,
      exclusions = [WsRect { x1 = 1421, y1 = 1698, x2 = 1421, y2 = 1701 }] },
      WsRegion { id = 2, name = "field", area = WsRect { x1 = 1424, y1 = 1698, x2 = 1427, y2 = 1702 },
      maximum = 1, batch = 3, minimum-minutes = 1, maximum-minutes = 1, group = 1,
      preferred-height = 18, fixed-height = -129, outside = False, exclusions = [] }] }
  fill : WalkMap, Integer -> Integer
  fill (map) (i) = if i == map.width * map.height then 0
    else let done = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in fill map (i + 1)
  login : Integer -> List Integer
  login (key) = gp-zeros ((gp-ascii (gp-put32 (gp-start 145) key) "uoaixtest" 0 30) & [104,98,84,92,107,103,88,102,103]) 21
  create : Integer -> List Integer
  create (unused) =
    let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let name = gp-ascii (gp-ascii header "Spawn proof" 0 30) "" 0 30
    in let stats = name & [0,45,10,10,43,50,27,50,1,0]
    in gp-put32 (gp-zeros (gp-put16 stats 1002) 14) 0
  opcode-in : List (List Integer), Integer, Integer -> Boolean
  opcode-in (packets) (op) (i) = if i == list-length packets then False
    else list-at (list-at packets i) 0 == op | opcode-in packets op (i + 1)
  opcode : Result (Maybe GameReply) Text, Integer -> Boolean
  opcode (reply) (op) = when reply
    is Err (_) -> False
    is Ok (maybe) -> when maybe is None -> False is Just (r) -> opcode-in r.packets op 0
  moved-in : List (List Integer), Integer, Integer -> Boolean
  moved-in (packets) (serial) (i) = if i == list-length packets then False
    else let p = list-at packets i
    in (list-at p 0 == 119 & gp-u32 p 1 == serial) | moved-in packets serial (i + 1)
  moved : Result (Maybe GameReply) Text, Integer -> Boolean
  moved (reply) (serial) = when reply
    is Err (_) -> False
    is Ok (maybe) -> when maybe is None -> False is Just (r) -> moved-in r.packets serial 0
  removed-in : List (List Integer), Integer, Integer -> Boolean
  removed-in (packets) (serial) (i) = if i == list-length packets then False
    else let p = list-at packets i
    in (list-at p 0 == #1D & gp-u32 p 1 == serial) | removed-in packets serial (i + 1)
  removed : Result (Maybe GameReply) Text, Integer -> Boolean
  removed (reply) (serial) = when reply
    is Err (_) -> False
    is Ok (maybe) -> when maybe is None -> False is Just (r) -> removed-in r.packets serial 0
  pulse : GameWorldSpawn, GameShard, GameInput, WalkMap, Integer -> Result (Maybe GameReply) Text
  pulse (g) (shard) (input) (map) (tick) = gws-after gws-ground g shard input map tick (Ok None)
  codec : GameWorldSpawn, GameShard -> [Console] Nothing
  codec (g) (shard) = act
    bytes <- gwsc-size g
    buf <- alloc-bytes bytes
    encoded <- gwsc-encode g shard.world 6000 buf bytes
    when gws-new g.catalog g.combat 3
      is Err (e) -> print-line-uni ("FAIL restored state " & e)
      is Ok (restored) -> act
        stale-link <- list-set-at restored.links 0 5
        stale-seen <- __record-set (list-at restored.slots 0) "seen" 3
        decoded <- gwsc-decode restored shard.world 10000 buf bytes
        check "restart restores slots populations and rebased timers" (is-ok encoded & is-ok decoded
          & (list-at restored.slots 0).serial == (list-at g.slots 0).serial
          & peek-qword restored.populations 0 == 1 & peek-qword restored.populations 8 == 1
          & peek-qword restored.deadlines 0 == 16000 & restored.due == 10100)
        check "restart clears visibility connection and preserves catalog identity" (list-at restored.links 0 == 0 - 1
          & (list-at restored.slots 0).seen == 0 & peek-qword buf 16 == g.catalog.revision)
        row <- gwsc-row g buf 2
        corrupt <- poke-qword row 32 (gm-ticks 5000 + 1)
        refused <- gwsc-decode restored shard.world 20000 buf bytes
        check "malformed final row refuses before mutation" (is-err refused & restored.due == 10100 & g.combat.tick == 10000)
        fixed <- poke-qword row 32 0
        changed <- poke-qword buf 16 1235
        mismatch <- gwsc-decode restored shard.world 20000 buf bytes
        check "changed catalog and truncated bytes refuse" (is-err mismatch & is-err (gwsc-decode restored shard.world 20000 buf (bytes - 1)))
        revision <- poke-qword buf 16 1234
        first <- gwsc-row g buf 0
        second <- gwsc-row g buf 1
        saved <- peek-qword second 0
        duplicate <- poke-qword second 0 (peek-qword first 0)
        invalid <- gwsc-decode restored shard.world 20000 buf bytes
        check "duplicate live binding refuses" (is-err invalid & restored.due == 10100)
        serial <- poke-qword second 0 saved
        stale <- world-delete shard.world saved
        rebound <- gwsc-decode restored shard.world 20000 buf bytes
        check "stale world serial refuses" (is-ok stale & is-err rebound)
        fresh <- alloc-bytes bytes
        dead <- gwsc-encode g shard.world 6000 fresh bytes
        vacant <- gwsc-row g fresh 1
        reread <- gwsc-decode restored shard.world 20000 fresh bytes
        check "a slot whose monster died since the last spawn pass saves as vacant, so the save is not refused (soak5)" (is-ok dead & peek-qword vacant 0 == 0 & peek-qword vacant 8 == 0 - 1 & peek-qword vacant 16 == 0 - 1 & is-ok reread)
      end
  end
  regrow : GameWorldSpawn, GameShard, GameInput, WalkMap, Integer, Integer, Integer -> Integer
  regrow (g) (shard) (input) (map) (serial) (tick) (left) = if left == 0 then -1
    else let reply = pulse g shard input map tick
    in when world-get shard.world serial
      is Err (_) -> -1
      is Ok (m) -> if m.graphic == #00CF then tick else regrow g shard input map serial (tick + 4000) (left - 1)
  shorn : GameWorldSpawn, GameShard, GameInput, WalkMap -> [Console] Nothing
  shorn (g) (shard) (input) (map) = act
    serial <- (list-at g.slots 0).serial
    sheep <- __record-set (list-at g.catalog.profiles 0) "body" #00CF
    clipped <- (when world-get shard.world serial is Err (e) -> Err e is Ok (m) -> world-update shard.world (__record-set m "graphic" #00DF))
    tick <- regrow g shard input map serial 30000 400
    check "a shorn sheep's wool regrows to 0xCF on the spawn tick, as UOX3 sheepshearing.js" (is-ok clipped & tick > 30000)
    sheared <- (when world-get shard.world serial is Err (e) -> Err e is Ok (m) -> world-update shard.world (__record-set m "graphic" #00DF))
    bytes <- gwsc-size g
    buf <- alloc-bytes bytes
    kept <- gwsc-encode g shard.world tick buf bytes
    orc <- __record-set (list-at g.catalog.profiles 0) "body" 17
    refused <- gwsc-encode g shard.world tick buf bytes
    check "the spawn codec keeps a shorn sheep (0xDF under a 0xCF profile) and refuses 0xDF under any other" (is-ok sheared & is-ok kept & is-err refused)
  end
  herd-walk : GameWorldSpawn, GameShard, GameInput, WalkMap, Integer, Integer, Integer, Integer, Integer -> Boolean
  herd-walk (g) (shard) (input) (map) (serial) (x) (y) (tick) (left) = when world-get shard.world serial
    is Err (_) -> False
    is Ok (m) -> if m.x == x & m.y == y then True else if left == 0 then False
      else let reply = pulse g shard input map tick in herd-walk g shard input map serial x y (tick + gm-ticks 1000) (left - 1)
  herd-slot : GameWorldSpawn, Integer -> Integer
  herd-slot (g) (i) = if i == list-length g.slots then -1
    else let s = list-at g.slots i in if s.serial > 0 & s.profile == 1 then i else herd-slot g (i + 1)
 The deer (profile 1) is herded: the orc (profile 0) is hostile and chases its viewer, and has no TOTAME to herd.
  herded : GameWorldSpawn, GameShard, GameInput, WalkMap -> [Console] Nothing
  herded (g) (shard) (input) (map) = act
    i <- herd-slot g 0
    serial <- if i < 0 then 0 else (list-at g.slots i).serial
    at <- when world-get shard.world serial is Err (_) -> [0, 0] is Ok (m) -> [m.x, m.y]
    sent <- gws-herd g serial (list-at at 0 + 3) (list-at at 1)
    arrived <- herd-walk g shard input map serial (list-at at 0 + 3) (list-at at 1) g.due 40
    check "a herded deer walks to the place it was sent (UOX3 herding.js WalkTo)" (i >= 0 & sent & arrived & (list-at g.slots (max 0 i)).goal-steps == 0)
  end
  indexed : GameWorldSpawn, GameShard, GameInput, WalkMap -> [Console] Nothing
  indexed (g) (shard) (input) (map) = act
    slot <- list-at g.slots 1
    serial <- slot.serial
    calm <- serial > 0 & not (gws-at-war g shard serial)
    drawn <- pulse g shard input map (g.due - 1)
    seen <- gws-slot-seen g slot
    away <- (when world-get shard.world serial is Err (e) -> Err e is Ok (m) -> world-update shard.world (__record-set m "x" (m.x + 300)))
    refiled <- gws-refile g shard.world 1
    gone <- pulse g shard input map (g.due - 1)
    unseen <- not (gws-slot-seen g slot)
    quiet <- pulse g shard input map (g.due - 1)
    skipped <- slot.visit /= g.stamp
    swept <- pulse g shard input map g.due
    reached <- slot.visit >= g.stamp - 1
    check "a drawn spawn that leaves the view is removed, then no pulse visits it until the spawn pass (UOAIX-42)" (calm & is-ok drawn & seen & is-ok away & refiled == 1
      & removed gone serial & unseen & is-ok quiet & skipped & is-ok swept & reached)
  end
  apart : GameShard, Integer, Integer -> Integer
  apart (shard) (a) (b) = when world-get shard.world a
    is Err (_) -> -1
    is Ok (m) -> when world-get shard.world b is Err (_) -> -1 is Ok (n) -> max (walk-abs (m.x - n.x)) (walk-abs (m.y - n.y))
  follow-walk : GameWorldSpawn, GameShard, WalkMap, WorldSpawnSlot, Integer, Integer -> Integer
  follow-walk (g) (shard) (map) (slot) (viewer) (left) = if left == 0 then 0
    else let ready = __record-set slot "due" 0
    in let stepped = when world-get shard.world slot.serial
      is Err (_) -> False
      is Ok (m) -> when world-get shard.world viewer is Err (_) -> False is Ok (v) -> gws-act g shard map slot m v
    in follow-walk g shard map slot viewer (left - 1)
  enticed : GameWorldSpawn, GameShard, WalkMap, WorldSpawnSlot, Integer -> [Console] Nothing
  enticed (g) (shard) (map) (slot) (viewer) = act
    moved <- when world-get shard.world slot.serial is Err (_) -> False is Ok (m) -> is-ok (world-update shard.world (__record-set (__record-set m "x" 1431) "y" 1709))
    refiled <- gws-refile g shard.world 1
    before <- apart shard slot.serial viewer
    player <- gws-lure g viewer (0 - 1)
    lured <- gws-lure g slot.serial viewer
    walked <- follow-walk g shard map slot viewer 30
    held <- slot.follow == viewer & apart shard slot.serial viewer == 1
    released <- __record-set slot "follow" 0
    check "an enticed creature walks to its leader and stops beside it; a player is no spawn to lure" (moved & before > 5 & not player & lured & held)
  end
  run : GameShard, WalkMap -> [Console] Nothing
  run (shard) (map) = act
    combat <- cb-new shard 104729
    input <- gn-input-with (cb-specs 0) 1
    when gws-new (catalog 0) combat 3
      is Err (e) -> print-line-uni ("FAIL state " & e)
      is Ok (g) -> act
        denied <- pulse g shard input map 0
        check "unauthenticated pulse leaves world empty" (is-ok denied & world-count shard.world == 0)
        when gs-relay-key shard
          is Err (e) -> print-line-uni ("FAIL relay " & e)
          is Ok (key) -> act
            bound <- __record-set input.session "key" key
            logged <- gs-handle shard input.session map (login key)
            created <- gs-handle shard input.session map (create 0)
            mode <- __record-set input "mode" 2
            intro <- pulse g shard input map 0
            first <- list-at g.slots 0
            second <- list-at g.slots 1
            serial <- first.serial
            check "region caps override larger batch and create actual mobiles" (is-ok logged & is-ok created & is-ok intro
              & serial > 0 & second.serial > 0 & (list-at g.slots 2).serial == 0
              & world-count shard.world == 5 & opcode intro 120)
            check "spawn creates no inventory or gold" (world-child-count shard.world serial == 0
              & world-child-count shard.world second.serial == 0 & peek-qword g.populations 0 == 1 & peek-qword g.populations 8 == 1)
            when world-get shard.world serial
              is Err (e) -> print-line-uni ("FAIL mobile " & e)
              is Ok (m) -> act
                check "spawn honors exclusion and tile index occupancy" (m.x /= 1421 & gws-occupied shard.world m.x m.y)
                excluded <- gws-step g shard map first m 6 False
                check "exclusion prevents west step at border" (if m.x == 1422 then not excluded else True)
              end
            early <- pulse g shard input map 99
            check "wildlife movement waits for PIT deadline" (is-ok early & not (moved early second.serial))
            active <- pulse g shard input map 100
            attacker <- list-at combat.actors (world-slot shard.world serial)
            animal <- list-at combat.actors (world-slot shard.world second.serial)
            check "hostile type targets player while wildlife does not" (is-ok active & attacker.target == input.session.serial & animal.target == 0)
            neutral <- __record-set (list-at g.catalog.profiles 1) "ai" 6
            when cb-ensure combat shard input.session.serial
              is Err (e) -> print-line-uni ("FAIL player binding " & e)
              is Ok (own) -> when world-get shard.world own.serial
                is Err (e) -> print-line-uni ("FAIL player lookup " & e)
                is Ok (viewer) -> when world-get shard.world second.serial
                  is Err (e) -> print-line-uni ("FAIL animal lookup " & e)
                  is Ok (m) -> act
                    retaliated <- cb-select combat shard animal own
                    ready <- __record-set second "due" 100
                    defended <- gws-act g shard map second m viewer
                    check "neutral wildlife retains admitted retaliation" (retaliated & animal.target == own.serial)
                  end
            peaceful <- cb-stop combat animal
            enticed g shard map second input.session.serial
            scared <- __record-set (list-at g.catalog.profiles 1) "ai" 12
            unknown <- __record-set (list-at (list-at g.catalog.groups 0).choices 0) "profile" -1
            check "unresolved source choice yields no replacement type" (gws-pick g 0 0 == -1)
            known <- __record-set (list-at (list-at g.catalog.groups 0).choices 0) "profile" 0
            removed <- world-delete shard.world serial
            noticed <- pulse g shard input map 101
            check "deleted NPC releases regional count" (is-ok removed & is-ok noticed & first.serial == 0 & peek-qword g.populations 0 == 0)
            waiting <- pulse g shard input map 5999
            check "region minute timer prevents immediate replacement" (is-ok waiting & first.serial == 0)
            ready <- __record-set g "due" 6000
            replacement <- pulse g shard input map 6000
            check "region replacement uses fresh serial at timer" (is-ok replacement & first.serial > 0 & first.serial /= serial & world-count shard.world == 5)
            codec g shard
            shorn g shard input map
            herded g shard input map
            indexed g shard input map
          end
      end
  end
  opening : [Console] Nothing = act
    when walk-map-new 1418 1696 16 16
      is Err (e) -> print-line-uni ("FAIL map " & e)
      is Ok (map) -> act
        filled <- fill map 0
        when gs-new 0
          is Err (e) -> print-line-uni ("FAIL shard " & e)
          is Ok (shard) -> run shard map
      end
  end

