Chapter: CompositeVeinTripProof
  cites Uoaix chapter CompositeStore

  ctf-check : Text, Boolean -> [Console] Integer
  ctf-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  ctf-fill : WalkMap, Integer -> Integer
  ctf-fill (map) (i) = if i == map.width * map.height then 0
    else let mark = __heap-save
    in let result = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in ctf-fill map (i + 1)
  ctf-data : Integer -> Integer
  ctf-data (unused) = let data = alloc-bytes 240
    in let clear = wd-zero data 0 240
    in let a = poke-qword data 0 #31445744
    in let b = poke-qword data 8 1
    in let c = poke-qword data 32 6144
    in let d = poke-qword data 40 4096
    in let e = poke-qword data 48 42
    in let x = poke-qword data 64 1419
    in let y = poke-qword data 72 1690
    in let art = poke-qword data 88 #0675
    in let flags = poke-qword data 104 64
    in let height = poke-qword data 112 20
    in let kind = poke-qword data 120 1
    in let opened = poke-qword data 128 #0676
    in let dx = poke-qword data 136 1
    in let light = poke-qword data 152 -1 in data
 The trip whose vein cgg-next-vein picks: trip k mines the tile chosen when trip k-1 ended.
  ctf-vein : Integer -> Integer
  ctf-vein (trips) = let r = cgg-node-region
    in let width = r.x2 - r.x1 + 1
    in cpr-vein 5 (r.x1 + int-mod trips width) (r.y1 + int-mod (trips / width) (r.y2 - r.y1 + 1))
  ctf-first-vein : Integer, Integer -> Integer
  ctf-first-vein (k) (limit) = if k > limit then -1 else if ctf-vein k == 25 | ctf-vein k == 26 then k else ctf-first-vein (k + 1) limit
  ctf-settle : CompositeGame, CgGatherer, WalkMap, Integer, Integer -> Result Integer Text
  ctf-settle (owner) (c) (map) (tick) (left) = if left == 0 then Ok (0 - 1)
    else when cg-world-tick owner owner.checkpoint.game map c.serial tick
      is Err (e) -> Err ("tick " & show tick & ": " & e)
      is Ok (_) -> if c.leg == 0 & c.lot == 0 & cgg-held c 5 < 2 & not (cgg-ready c) then Ok left else ctf-settle owner c map (tick + 1000) (left - 1)
  ctf-where : CompositeGame, CgGatherer -> Text
  ctf-where (owner) (m) = let at = when world-get owner.checkpoint.game.world m.serial
      is Err (_) -> "gone"
      is Ok (o) -> show o.x & "," & show o.y & "," & show o.z
    in " [" & show m.serial & " at " & at & " leg=" & show m.leg & " via=" & show m.via & " blocked=" & show m.blocked & " route=" & show m.walk.route & " step=" & show m.walk.step & "]"
  ctf-all : CompositeGame, Integer -> Text
  ctf-all (owner) (i) = if i >= list-length owner.miners then (when owner.gatherer is None -> "" is Just (g) -> " gatherer" & ctf-where owner g)
    else ctf-where owner (list-at owner.miners i) & ctf-all owner (i + 1)
 Each round grows the nodes for 48 economy hours, then runs the world headless until the miner is idle or 1500 ticks pass,
 committing every 60 one-second ticks as the server's 60 s save check does.
  ctf-segments : CompositeOwner, CgGatherer, WalkMap, Integer, Integer -> [Console, Device.Block] Integer
  ctf-segments (store) (c) (map) (tick) (left) = if left <= 0 then act 0 end
    else when ctf-settle store.state c map tick 60
     is Err (e) -> act
       print-line-uni ("FAIL world tick " & e)
       0 - 2
     end
     is Ok (idle) -> act
       committed <- cs-commit store True
       when committed
         is Err (e) -> act
           print-line-uni ("FAIL commit " & e)
           0 - 3
         end
         is Ok (_) -> if idle >= 0 then act 0 end else ctf-segments store c map (tick + 60000) (left - 60)
     end
  ctf-round : CompositeOwner, CgGatherer, WalkMap, Integer -> [Console, Device.Block] Integer
  ctf-round (store) (c) (map) (tick) = let x = store.state.vendor.currency
    in if not (cg-economy-hours x (x.world.hour + 48) 48) then act
      print-line-uni ("FAIL economy hours: hour=" & show x.world.hour & " currency-events=" & show x.count & " of " & show em-rows & " money-sequence=" & show x.world.money.sequence & " trades=" & show x.world.trade-count)
      0 - 1
    end
    else ctf-segments store c map (max tick (store.state.timers.limit + 1000)) 1500
  ctf-until-trips : CompositeOwner, CgGatherer, WalkMap, Integer, Integer -> [Console, Device.Block] Integer
  ctf-until-trips (store) (c) (map) (trips) (rounds) = if c.trips >= trips | rounds == 0 then rounds
    else act
      r <- ctf-round store c map (9000000 + (80 - rounds) * 2000000)
      if r < 0 then r else ctf-until-trips store c map trips (rounds - 1)
    end
  ctf-until-sales : CompositeOwner, CgGatherer, WalkMap, Integer, Integer, Integer -> [Console, Device.Block] Integer
  ctf-until-sales (store) (c) (map) (sold) (crowned) (rounds) = if c.sold >= sold | c.crowned >= crowned | rounds == 0 then rounds
    else act
      r <- ctf-round store c map (200000000 + (60 - rounds) * 2000000)
      if r < 0 then r else ctf-until-sales store c map sold crowned (rounds - 1)
    end
 One node trip: tick until the miner has been at its node (leg 2) and has come home after it, committing every 60 ticks.
 The list is [ticks left, 1 once at the node, the trip count when it reached the node].
  ctf-node-trip : CompositeGame, CgGatherer, WalkMap, Integer, Integer, Integer, Integer -> Result (List Integer) Text
  ctf-node-trip (owner) (c) (map) (tick) (left) (mined) (trips) =
    if mined == 1 & c.trips > trips then Ok [left, 1, trips]
    else if left == 0 then Ok [0, mined, trips]
    else when cg-world-tick owner owner.checkpoint.game map c.serial tick
      is Err (e) -> Err ("tick " & show tick & ": " & e)
      is Ok (_) -> if mined == 0 & c.leg == 2 then ctf-node-trip owner c map (tick + 1000) (left - 1) 1 c.trips
        else ctf-node-trip owner c map (tick + 1000) (left - 1) mined trips
  ctf-fuel-trip : CompositeOwner, CgGatherer, WalkMap, Integer, Integer, Integer, Integer -> [Console, Device.Block] Integer
  ctf-fuel-trip (store) (c) (map) (tick) (segments) (mined) (trips) = if segments == 0 then act 0 - 1 end
    else when ctf-node-trip store.state c map tick 60 mined trips
     is Err (e) -> act
       print-line-uni ("FAIL world tick " & e)
       0 - 2
     end
     is Ok (s) -> act
       committed <- cs-commit store True
       when committed
         is Err (e) -> act
           print-line-uni ("FAIL commit " & e)
           0 - 3
         end
         is Ok (_) -> if list-at s 1 == 1 & c.trips > list-at s 2 then act segments end
           else ctf-fuel-trip store c map (tick + 60000) (segments - 1) (list-at s 1) (list-at s 2)
     end
  ctf-faults : EuCurrency, Integer, Integer -> Integer
  ctf-faults (x) (i) (n) = if i >= x.count then n
    else let e = list-at x.events i in ctf-faults x (i + 1) (if e.kind == 12 & e.party > 0 then n + 1 else n)
  ctf-exchanges : EuCurrency, Integer, Integer -> Integer
  ctf-exchanges (x) (i) (n) = if i >= x.count then n else ctf-exchanges x (i + 1) (if (list-at x.events i).kind == 12 then n + 1 else n)
  ctf-vein-yield : CompositeOwner, CgGatherer, WalkMap, Integer, Integer -> [Console, Device.Block] Integer
  ctf-vein-yield (store) (c) (map) (k) (left) = if k < 1 | left == 0 then act 0 - 1 end
    else act
      rounds <- ctf-until-trips store c map k 80
      w <- store.state.vendor.currency.world
      held <- cgg-held c (list-at w.catalog.resources (ctf-vein k - 1)).item
      print-line-uni ("VEIN trip=" & show k & " resource=" & show (ctf-vein k) & " trips=" & show c.trips & " held=" & show held & " mining=" & show (ep-at (ep-actor w c.gatherer.producer.actor).skills 1) & " rounds-left=" & show rounds)
      if rounds < 0 then 0 - 1
      else if held > 0 | c.crowned > 0 then k
      else ctf-vein-yield store c map (ctf-first-vein (k + 1) 320) (left - 1)
    end
  ctf-warm : CompositeOwner, CgGatherer, WalkMap -> [Console, Device.Block] Integer
  ctf-warm (store) (c) (map) = if c.trips > 0 then act 0 end
    else act
      warm <- ctf-round store c map 7000000
      ctf-check "a fresh miner takes a regrown or fresh vein each trip instead of waiting at home for its last one: at least 4 trips in its first 48 economy hours (F43; 2 when it waited)" (warm >= 0 & c.trips >= 4)
    end
 The crown's longsword purchases from the smith since an economy hour (the crown as reserve buyer, csn-crown-buy).
  ctf-swords : EpWorld, Integer, Integer, Integer, Integer, Integer -> Integer
  ctf-swords (w) (buyer) (seller) (since) (i) (n) = if i >= w.trade-count then n
    else let t = list-at w.trades i
    in ctf-swords w buyer seller since (i + 1) (if t.buyer == buyer & t.seller == seller & t.item == 70 & t.hour >= since then n + t.quantity else n)
  ctf-run : CompositeOwner, WalkMap -> [Console, Device.Block] Integer
  ctf-run (store) (map) = let owner = store.state in if list-length owner.miners == 0 then ctf-check "the Britain world founds its miners" False
    else let c = list-at owner.miners 0
      in let x = owner.vendor.currency
      in act
        hour0 <- x.world.hour
        w <- ctf-warm store c map
        k <- ctf-vein-yield store c map (ctf-first-vein 2 320) 6
        a <- ctf-check "with no client, within six trips to copper or silver veins a miner carries vein ore home or has it struck into coin" (k > 0 & c.trips >= k)
        exchanges-before <- ctf-exchanges x 0 0
        faults-before <- ctf-faults x 0 0
        sold-before <- c.sold
        crowned-before <- c.crowned
        refused-before <- c.refusals
        rest <- ctf-until-sales store c map (sold-before + 2) (crowned-before + 2) 60
        faults-after <- ctf-faults x 0 0
        exchanges-after <- ctf-exchanges x 0 0
        print-line-uni ("FLOAT trips=" & show c.trips & " sales " & show sold-before & "->" & show c.sold & " struck " & show crowned-before & "->" & show c.crowned & " refusals " & show (c.refusals - refused-before) & " faults before=" & show faults-before & " during=" & show (faults-after - faults-before)
          & " exchanges=" & show (exchanges-after - exchanges-before) & " struck-total=" & show c.crowned & " treasury copper=" & show (em-purse x.copper 1).coin & " silver=" & show (em-purse x.silver 1).coin & " rounds-left=" & show rest)
        crown-purse <- (ep-actor x.world x.world.mint-owner).purse
        f0 <- ctf-faults x 0 0
        e0 <- ctf-exchanges x 0 0
        swapped <- eu-exchange x crown-purse 3 3 2
        print-line-uni ("EXCHANGE result=" & show swapped & " faults+" & show (ctf-faults x 0 0 - f0) & " exchanges+" & show (ctf-exchanges x 0 0 - e0) & " treasury silver=" & show (em-purse x.silver 1).coin)
        b <- ctf-check "after the miners' silver is minted, a 3 gold to 210 silver exchange is paid from treasury silver with no change decree" (swapped >= 0 & ctf-exchanges x 0 0 == e0 + 1 & ctf-faults x 0 0 == f0)
        s <- ctf-check "with no client, miner 1 keeps working: within 60 rounds it sells 2 more ingots or, when the smith cannot pay, 2 more ingots struck from its own vein ore, retrying a refused sale at most once a game day" ((c.sold >= sold-before + 2 | c.crowned >= crowned-before + 2) & rest > 0 & c.refusals - refused-before <= 2 * (60 - rest) + 1)
        print-line-uni (if s > 0 then "WHERE" & ctf-all store.state 0 else "MINERS working")
        smith-purse <- (ep-actor x.world (list-at store.state.vendor.vendors 1).actor).purse
        swords <- ctf-swords x.world crown-purse smith-purse hour0 0 0
        days <- (x.world.hour - hour0) / 24 + 1
        print-line-uni ("CROWN swords=" & show swords & " days=" & show days & " smith copper=" & show (em-purse x.copper smith-purse).coin & " silver=" & show (em-purse x.silver smith-purse).coin & " gold=" & show (em-purse x.world.money smith-purse).coin)
        bought <- ctf-check "the crown buys the smith's longswords, at least one and at most one a game day, so the coin the smith pays for ingots comes back" (swords >= 1 & swords <= days)
        miner <- c.gatherer.producer.actor
        burnt <- ep-consume x.world (ep-actor x.world miner) 2 (cgg-held c 2)
        smelted <- ep-consume x.world (ep-actor x.world miner) 5 (cgg-held c 5)
        found <- ep-find x.world miner 63 4
        struck0 <- c.crowned
        trips0 <- c.trips
        grown <- cg-economy-hours x (x.world.hour + 48) 48
        fuel-left <- ctf-fuel-trip store c map (max 400000000 (store.state.timers.limit + 1000)) 25 0 0
        print-line-uni ("FUEL found=" & show found & " trips " & show trips0 & "->" & show c.trips & " branches=" & show (cgg-held c 2) & " copper ore=" & show (cgg-held c 63) & " struck " & show struck0 & "->" & show c.crowned & " segments-left=" & show fuel-left)
        fueled <- ctf-check "a miner with 4 copper ore, no iron ore and no fallen branches gathers its fuel at its vein and has both ingots struck when it comes home (UOAIX-80)" (found >= 0 & grown & fuel-left > 0 & cgg-held c 63 < 2 & c.crowned >= struck0 + 2)
        w + a + s + b + fueled + bought
      end
  opening : [Console, Device.Block] Integer = when walk-map-new 1408 1680 64 64
    is Err (e) -> ctf-check e False
    is Ok (map) -> when walk-map-new 1408 1536 96 160
     is Err (e) -> ctf-check e False
     is Ok (britain) -> let filled = ctf-fill map 0
      in let town-filled = ctf-fill britain 0
      in let data = ctf-data 0
      in when wd-read data 240 map map.stride
       is Err (e) -> ctf-check e False
       is Ok (decoration) -> act
     opened <- us-open 0 131072
     when opened
      is Err (e) -> ctf-check ("store " & e) False
      is Ok (store) -> act
       loaded <- cs-load-town store (CompositeSetup { vendor-z = 0, shrine-z = 0, home-z = 0, decoration = Just decoration }) (Just britain) None
       when loaded
        is Err (e) -> ctf-check ("recovery " & e) False
        is Ok (owner) -> when cg-town-doors owner.state data 240
         is Err (e) -> ctf-check ("town doors " & e) False
         is Ok (_) -> ctf-run owner map
      end
    end

