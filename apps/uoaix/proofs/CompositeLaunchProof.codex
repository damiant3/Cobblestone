Chapter: CompositeLaunchProof
  cites Uoaix chapter CompositeLaunch
  cites Foreword chapter Result
  cites Foreword chapter CCE

  clp-check : Text, Boolean -> [Console] Nothing
  clp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  clp-bytes : Text -> List Integer
  clp-bytes (text) = text-to-utf8-bytes text
  clp-key : Text -> Text
  clp-key (digit) = digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit
    & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit
    & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit
    & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit & digit
  clp-admin : Text = "ADMIN " & clp-key "1" & " " & clp-key "2" & " " & clp-key "3" & " " & clp-key "a" & " " & clp-key "f" & "\n"
  clp-mode : Result CompositeLaunchMode Text, Boolean, Boolean, Integer, Integer -> Boolean
  clp-mode (r) (testing) (dev) (british) (admin) = when r
    is Err (_) -> False
    is Ok (m) -> m.testing == testing & m.dev == dev & list-length m.british == british & list-length m.admin == admin

  opening : [Console] Nothing = act
    clp-check "an admin line before TESTING yields testing mode and five admin values, the owner key fourth" (clp-mode (cl-parse (clp-bytes (clp-admin & "UOAIX TESTING\n"))) True True 0 5
      & (when cl-parse (clp-bytes (clp-admin & "UOAIX TESTING\n")) is Err (_) -> False is Ok (m) -> list-at m.admin 3 == clp-key "a" & list-at m.admin 4 == clp-key "f"))
    clp-check "an admin line alone is public mode with British unchanged and the panel keys" (clp-mode (cl-parse (clp-bytes clp-admin)) False False 0 5)
    clp-check "an admin line before PUBLIC keeps the password" (clp-mode (cl-parse (clp-bytes (clp-admin & "UOAIX PUBLIC secret\n"))) False False 6 5)
    clp-check "the existing options parse with no admin values" (clp-mode (cl-parse (clp-bytes "UOAIX DEV\n")) False True 0 0 & clp-mode (cl-parse []) False False 0 0)
    clp-check "an uppercase hex digit, a missing separator and a truncated line are refused" (is-err (cl-parse (clp-bytes ("ADMIN " & clp-key "A" & " " & clp-key "2" & " " & clp-key "3" & " " & clp-key "4" & " " & clp-key "5" & "\n")))
      & is-err (cl-parse (clp-bytes ("ADMIN " & clp-key "1" & clp-key "2" & " " & clp-key "3" & " " & clp-key "4" & " " & clp-key "5" & "\n")))
      & is-err (cl-parse (clp-bytes ("ADMIN " & clp-key "1" & " " & clp-key "2"))))
    clp-check "the longest record fits the launch limit" (list-length (clp-bytes (clp-admin & "UOAIX PUBLIC 123456789012345678901234567890\n")) <= cl-limit)
  end

