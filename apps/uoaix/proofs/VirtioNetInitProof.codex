Chapter: VirtioNetInitProof
  cites Kernel chapter VirtioNetX86
  cites Kernel chapter Pci
  cites Foreword chapter Result
  cites Foreword chapter Maybe
  cites Foreword chapter Console
  cites Net chapter NetDriver

  ni-binding : [Console, Network.Read] Nothing = act
    card <- net-driver-bring-up
    print-line-uni ("VNX BIND " & net-driver-card-name card)
  end

  opening : [Console, Network.Read] Nothing = act
    when vnx-find pci-scan-all
      is None -> print-line-uni "VNX REFUSED absent"
      is Just (device) -> when vnx-init device
        is Err (reason) -> act
          print-line-uni ("VNX REFUSED " & reason)
          ni-binding
        end
        is Ok (base) -> act
          print-line-uni ("VNX PCI " & show device.pci-device-id)
          print-line-uni ("VNX READY rx=" & show (peek-qword base (vnx-rx-q + 24)) & " tx=" & show (peek-qword base (vnx-tx-q + 24)))
          print-line-uni ("VNX MAC " & show (list-at (vnx-mac base) 0) & " " & show (list-at (vnx-mac base) 5))
          ni-binding
        end
  end
