Chapter: NpcSpeechReplay
  cites Uoaix chapter NpcSpeechCodec

  nsr-check : Text, Boolean -> [Console] Nothing
  nsr-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  nsr-fill : WalkMap, Integer -> Boolean
  nsr-fill (map) (i) = if i == map.width * map.height then True else let mark = __heap-save
    in let ok = is-ok (walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0)
    in let restored = __heap-restore mark in ok & nsr-fill map (i + 1)
  nsr-packet : Text, Integer -> List Integer
  nsr-packet (text) (mode) = gp-ascii [3,0,text-length text + 9,mode,3,178,0,3] text 0 (text-length text + 1)
  nsr-note : Result (Maybe GameReply) Text, Text -> Boolean
  nsr-note (result) (note) = when result is Err (_) -> False is Ok (None) -> False is Ok (Just (reply)) -> reply.note == note
  nsr-sound-rows : List (List Integer), Integer -> Integer
  nsr-sound-rows (packets) (i) = if i == list-length packets then 0
    else let p = list-at packets i
    in if list-length p == 0 then -1000 else if list-at p 0 /= #54 then nsr-sound-rows packets (i + 1)
    else if list-length p /= 12 then -1000
    else if list-at p 1 /= 1 | gp-u16 p 2 /= #32 | gp-u16 p 4 /= 0 | gp-u16 p 6 /= 1461 | gp-u16 p 8 /= 1672 | gp-u16 p 10 /= 0 then -1000
    else 1 + nsr-sound-rows packets (i + 1)
  nsr-sounds : Result (Maybe GameReply) Text -> Integer
  nsr-sounds (result) = when result is Err (_) -> -1000 is Ok (None) -> 0 is Ok (Just (reply)) -> nsr-sound-rows reply.packets 0
  nsr-move : NpcSpeech, Integer, Integer, Integer -> Boolean
  nsr-move (s) (serial) (x) (y) = is-ok (world-update s.shops.vendors.game.world (gs-mobile serial x y 0 400 1002))
  nsr-trades : NpcSpeech, GameInput, WalkMap -> [Console] Nothing
  nsr-trades (s) (input) (map) = let game = s.shops.vendors.game
    in let player = list-at s.shops.vendors.players 0
    in let moved = nsr-move s input.session.serial 1461 1672
    in let buy = ns-handler-at s game input map 2593 (nsr-packet "BUY" 0) 100
    in let bought = player.side == 1
    in let named = ns-handler-at s game input map 2593 (nsr-packet "Britains Premier Provisioner, sell!" 0) 101
    in let sold = player.side == 2
    in let vendor = ns-handler-at s game input map 2593 (nsr-packet "Please, VENDOR BUY." 0) 102
    in act
      nsr-check "classic four-tile buy sell vendor and named keywords" (moved & bought & not sold & nsr-note buy "vendor buy menu" & nsr-note named "vendor sell menu empty" & nsr-note vendor "vendor buy menu")
      let shop = list-at s.shops.vendors.vendors 0
      in let source = (list-at player.offers 0).serial
      in let request = gp-put16 (gp-put32 (list-push (list-push (gp-put32 [59,0,15] shop.serial) 2) 26) source) 1
      in let sales = s.shops.vendors.sale-count
      in let settled = gv-handle-at s.shops.vendors game input request 103
      in nsr-check "four-tile speech quote settles through vendor cart" (is-ok settled & s.shops.vendors.sale-count == sales + 1 & euv-valid s.shops.vendors.currency)
      let delivered = (list-at s.shops.vendors.sales sales).delivered
      in let menu = ns-handler-at s game input map 2593 (nsr-packet "vendor sell" 0) 104
      in let sell = gp-put16 (gp-put32 (gp-put16 (gp-put32 [159,0,15] shop.serial) 1) delivered) 1
      in let sold = gv-handle-at s.shops.vendors game input sell 105
      in let stale = gv-handle-at s.shops.vendors game input sell 106
      in nsr-check "buy and sell emit one coin sound only after settlement" (s.shops.vendors.sale-count == sales + 2 & nsr-sounds settled == 1 & nsr-sounds sold == 1 & nsr-sounds menu == 0 & nsr-sounds stale == 0)
      let cleared = __record-set player "side" 0
      in let moved = nsr-move s input.session.serial 1460 1672
      in let far = ns-handler-at s game input map 2593 (nsr-packet "vendor buy" 0) 103
      in let outside = player.side == 0
      in let moved = nsr-move s input.session.serial 1461 1672
      in let whisper = ns-handler-at s game input map 2593 (nsr-packet "buy" 8) 104
      in let emote = ns-handler-at s game input map 2593 (nsr-packet "buy" 2) 105
      in let substring = ns-handler-at s game input map 2593 (nsr-packet "buying and seller" 0) 106
      in nsr-check "five-tile whisper emote and substring cannot open trade" (outside & player.side == 0 & is-ok far & is-ok whisper & is-ok emote & is-ok substring)
      let short = ns-handler-at s game input map 2593 [3,0,3] 107
      in nsr-check "malformed speech refuses before quotes" (not (is-ok short) & player.side == 0)
    end
  nsr-greetings : NpcSpeech, GameInput, WalkMap -> [Console] Nothing
  nsr-greetings (s) (input) (map) = let game = s.shops.vendors.game
    in let move = nsr-move s input.session.serial 1462 1672
    in let first = ns-pulse s game input map 2593 0
    in let repeated = ns-pulse s game input map 2593 1
    in let buf = alloc-bytes nsc-bytes
    in let saved = nsc-encode s buf nsc-bytes
    in when ns-bind s.town s.shops s.banks
      is Err (e) -> print-line-uni ("FAIL greeting restore bind " & e)
      is Ok (loaded) -> let restored = nsc-decode loaded buf nsc-bytes
        in let connected = __record-set input "connection" 82
        in let after = ns-pulse loaded game input map 2593 2
        in act
          nsr-check "vendor approach greeting cooldown survives reconnect and NSC1" (move & nsr-note first "bank/vendor approach greeting" & not (nsr-note repeated "bank/vendor approach greeting") & is-ok saved & is-ok restored & not (nsr-note after "bank/vendor approach greeting"))
          let forged = poke-qword buf 104 0
          in let hashed = poke-qword buf 48 (ws-hash buf nsc-bytes 0 2166136261)
          in nsr-check "NSC1 rejects rebound NPC identities" (not (is-ok (nsc-decode loaded buf nsc-bytes)))
          let moved = nsr-move s input.session.serial 1462 1664
          in let greeting = ns-handler-at s game input map 2593 (nsr-packet "Banker, hello" 0) 108
          in let open = ns-handler-at s game input map 2593 (nsr-packet "BANKER BANK" 0) 109
          in nsr-check "banker greeting and keyword retain bank admission" (moved & nsr-note greeting "NPC greeting" & nsr-note open "bank:open")
        end
  nsr-person : NpcSpeech, GameInput, WalkMap -> [Console] Nothing
  nsr-person (s) (input) (map) = let game = s.shops.vendors.game
    in let person = tf-person s.town.people 1
    in when world-get game.world person.world-serial
      is Err (e) -> print-line-uni ("FAIL person " & e)
      is Ok (npc) -> let moved = nsr-move s input.session.serial (npc.x - 4) npc.y
        in let before = s.town.mind.audit-count
        in let lots = s.shops.vendors.lot-count
        in let reply = ns-handler-at s game input map 2593 (nsr-packet "NELL, how fares the tailor?" 0) 110
        in let answered = s.town.mind.audit-count == before + 1
        in let far = nsr-move s input.session.serial (npc.x - 5) npc.y
        in let refused = ns-handler-at s game input map 2593 (nsr-packet "Nell, buy" 0) 111
        in nsr-check "named townsfolk reply logs fallback without moving items" (moved & answered & far & nsr-note reply "townsfolk named fallback" & nsr-note refused "speech out of range" & s.town.mind.audit-count == before + 1 & s.shops.vendors.lot-count == lots & euv-valid s.shops.vendors.currency)
  nsr-player : NpcSpeech, WalkMap -> [Console] Nothing
  nsr-player (s) (map) = let v = s.shops.vendors
    in when world-create v.game.world (gs-mobile 0 1461 1672 0 400 1002)
      is Err (e) -> print-line-uni ("FAIL player " & e)
      is Ok (serial) -> when world-create v.game.world (gs-item serial #0E75 0)
        is Err (e) -> print-line-uni ("FAIL pack " & e)
        is Ok (pack) -> let meta = gsi-register s.shops.items pack 21 #003C False False
          in let bound = gv-add-player v serial 1 pack
          in let slot = poke-qword v.game.characters 0 serial
          in let active = __record-set v.game "active" serial
          in let input = gn-input-with bb-specs 81
          in let mode = __record-set input "mode" 2
          in let phase = __record-set input.session "phase" 2
          in let who = __record-set input.session "serial" serial
          in act
            nsr-check "keyword matcher is case-insensitive and word bounded" (ns-command "VENDOR BUY!" == 1 & ns-command "seller buying" == 0 & ns-command "buy sell" == -1 & ns-has "Nell, hello" "nell" & not (ns-has "Nellie, hello" "nell"))
            nsr-check "vendor greeting names both classic command phrases" ((list-at s.rows 0).greeting == "Welcome. Say vendor buy or vendor sell, and I shall show you my prices.")
            nsr-trades s input map
            nsr-greetings s input map
            nsr-person s input map
          end
  nsr-run : GameShard, WalkMap, EuCurrency -> [Console] Nothing
  nsr-run (game) (map) (currency) = let v = gv-new game currency
    in let items = gsi-new game.world
    in when bb-populate v items map
      is Err (e) -> print-line-uni ("FAIL shops " & e)
      is Ok (shops) -> when tl-populate v items map None 0 3
        is Err (e) -> print-line-uni ("FAIL town " & e)
        is Ok (town) -> let banks = gmb-new items #004A
          in when world-create game.world (gs-mobile 0 1463 1664 0 400 1002)
            is Err (e) -> print-line-uni ("FAIL banker " & e)
            is Ok (banker) -> let added = gmb-add-banker banks banker
              in when ns-bind town shops banks
                is Err (e) -> print-line-uni ("FAIL speech bind " & e)
                is Ok (speech) -> nsr-player speech map
  opening : [Console] Nothing = when bb-economy 0
    is Err (e) -> print-line-uni ("FAIL economy " & e)
    is Ok (currency) -> when world-new 128
      is Err (e) -> print-line-uni ("FAIL world " & e)
      is Ok (world) -> let chars = alloc-bytes 800
        in let cleared = gs-zero chars 0
        in let game = GameShard { world = world, characters = chars, accounts = ga-new ga-dev, next-key = 305419895, pending-key = 0, active = 0 }
        in when walk-map-new 1408 1536 128 192
          is Err (e) -> print-line-uni ("FAIL map " & e)
          is Ok (map) -> let filled = nsr-fill map 0 in if filled then nsr-run game map currency else print-line-uni "FAIL terrain"
