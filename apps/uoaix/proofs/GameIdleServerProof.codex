Chapter: GameIdleServerProof
  cites Uoaix chapter GameNet

  gis-land : WalkMap, Integer -> Integer
  gis-land (map) (i) = if i == map.width * map.height then 0 else let mark = __heap-save
    in let written = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in gis-land map (i + 1)
  opening : [Console, Network.Read, Network.Write] Integer = act
    card <- net-driver-bring-up
    arena <- nc-set-acquire (nc-pool-cell process-get-pid)
    released <- nc-set-release arena
    huffman <- gh-new 0
    when gs-new 0
      is Err (e) -> act
        print-line-uni e
        1
      end
      is Ok (shard) -> when walk-map-new 1408 1680 32 32
        is Err (e) -> act
          print-line-uni e
          1
        end
        is Ok (map) -> let land = gis-land map 0
          in gn-loop-hooks [] gn-default-handler gn-no-pulse shard map huffman 2594 0
  end
