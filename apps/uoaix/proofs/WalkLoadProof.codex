Chapter: WalkLoadProof
  cites Uoaix chapter WalkLoad
  cites Uoaix chapter WalkMap
  cites Net chapter NetDriver
  cites Net chapter NetCompact
  cites Foreword chapter Result

  wlp-samples : WalkMap, Integer -> [Console] Nothing
  wlp-samples (map) (i) =
    if i >= 20 then print-line-uni "map samples complete"
    else let x = 1408 + int-mod i 10
    in let y = 1680 + i / 10
    in let mark = __heap-save
    in act
      when walk-ground map x y
        is Err (e) -> print-line-uni ("FAIL " & e)
        is Ok (z) -> print-line-uni ("LAND " & show x & " " & show y & " " & show z)
      let restored = __heap-restore mark
      in wlp-samples map (i + 1)
    end

  opening : [Console, Network.Read, Network.Write] Nothing = act
    card <- net-driver-bring-up
    let arena = nc-set-acquire (nc-pool-cell process-get-pid)
    in let released = nc-set-release arena
    in act
      loaded <- wl-load 1408 1680 32 32
      when loaded
        is Err (e) -> print-line-uni ("FAIL load " & e)
        is Ok (map) -> wlp-samples map 0
    end
  end
