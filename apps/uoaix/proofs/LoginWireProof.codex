  feed-range : UoLoginWire, List Integer, Integer, Integer -> UoLoginWire
  feed-range (st) (bytes) (i) (stop) =
    if i >= stop then st
    else feed-range (uo-wire-byte st (list-at bytes i)) bytes (i + 1) stop

  split-grade : List Integer, Integer -> Boolean
  split-grade (bytes) (split) =
    if split > list-length bytes then True
    else let mark = __heap-save
    in let first = feed-range (uo-wire-new 0) bytes 0 split
    in let last = feed-range first bytes split (list-length bytes)
    in let ok = last.logins == 1 & last.hardware == 1 & last.selections == 1 & last.failure == 0 & last.remaining == 0
    in let restored = __heap-restore mark
    in if ok then split-grade bytes (split + 1) else False

  opening : [Console] Integer
  opening =
    let bytes = fixture
    in let partial = feed-range (uo-wire-new 0) bytes 0 65
    in let header = feed-range (uo-wire-new 0) bytes 0 66
    in let hardware = feed-range (uo-wire-new 0) bytes 0 215
    in let select-partial = feed-range (uo-wire-new 0) bytes 0 217
    in let bad = uo-wire-byte select-partial (bit-xor (list-at bytes 217) 1)
    in let unknown = uo-wire-byte (feed-range (uo-wire-new 0) bytes 0 66) (bit-xor (list-at bytes 66) 91)
    in let game = uo-wire-feed (uo-wire-new 0) [18, 52, 86, 120, 255, 0] 0
    in act
      print-line-uni ("login waits: " & show (partial.logins == 0 & partial.remaining == 1))
      print-line-uni ("login complete: " & show (header.logins == 1 & header.remaining == 0))
      print-line-uni ("hardware not selection: " & show (hardware.hardware == 1 & hardware.selections == 0))
      print-line-uni ("shard refused: " & show (bad.failure == 257 & bad.selections == 0))
      print-line-uni ("unknown refused: " & show (unknown.failure == 256))
      print-line-uni ("game capture only: " & show (game.game & game.logins == 0 & game.failure == 0))
      print-line-uni ("every split: " & show (split-grade bytes 0))
      0
    end
