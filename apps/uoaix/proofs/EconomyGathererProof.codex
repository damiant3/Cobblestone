Chapter: EconomyGathererProof
  cites Uoaix chapter EconomyGatherer
  cites Uoaix chapter EconomyCurrencyValid

  egp-check : Text, Boolean -> [Console] Integer
  egp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  egp-hours : EuCurrency, EgGatherer, Integer, Integer -> Integer
  egp-hours (x) (g) (left) (tried) = if left == 0 then tried
    else if eu-hour x < 0 then 0 - 1
    else let got = egg-hour g in egp-hours x g (left - 1) (tried + 1)
  egp-coin : EuCurrency, Integer -> Integer
  egp-coin (x) (actor) = let purse = (ep-actor x.world actor).purse
    in (em-purse x.copper purse).coin + (em-purse x.silver purse).coin + (em-purse x.world.money purse).coin

  opening : [Console] Integer = when bb-economy 0
    is Err (e) -> act
      print-line-uni ("FAIL economy " & e)
      1
    end
    is Ok (x) -> when egg-new x 3001 200
      is Err (e) -> act
        print-line-uni ("FAIL gatherer " & e)
        1
      end
      is Ok (g) -> act
        actor <- g.producer.actor
        a <- egp-check "gatherer starts with a pickaxe it made and no coin" (ep-at (ep-actor x.world actor).stock 25 >= 1 & egp-coin x actor == 0)
        hours <- egp-hours x g 96 0
        ore <- ep-at (ep-actor x.world actor).stock 5
        print-line-uni ("GATHERER hours=" & show hours & " gathered=" & show g.gathered & " ore=" & show ore & " mining=" & show (ep-at (ep-actor x.world actor).skills 1))
        b <- egp-check "gatherer mines iron ore over 96 economy hours with no coin" (hours == 96 & g.gathered > 0 & ore == g.gathered & egp-coin x actor == 0)
        c <- egp-check "currency and material census stay valid" (euv-valid x & ep-census x.world 1)
        a + b + c
      end
