Chapter: BritainShopsProof
  cites Uoaix chapter BritainShops
  cites Uoaix chapter EconomyCurrencyCodec
  cites Uoaix chapter GsiCodec

  bsp-check : Text, Boolean -> [Console] Nothing
  bsp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  bsp-fill : WalkMap, Integer -> Boolean
  bsp-fill (map) (i) = if i == map.width * map.height then True
    else let mark = __heap-save
    in let ok = is-ok (walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0)
    in let restored = __heap-restore mark in ok & bsp-fill map (i + 1)
  bsp-shops : BbTown, Integer -> Boolean
  bsp-shops (t) (i) = if i == bb-shop-count then True
    else let v = list-at t.vendors.vendors i
    in let shop = list-at bb-shops i
    in when world-get t.vendors.game.world v.serial
      is Err (_) -> False
      is Ok (npc) -> npc.x >= shop.x1 & npc.x <= shop.x2 & npc.y >= shop.y1 & npc.y <= shop.y2
        & gmb-layer t.items npc.serial 5 0 > 0 & gmb-layer t.items npc.serial 4 0 > 0 & gmb-layer t.items npc.serial 3 0 > 0
        & bsp-shops t (i + 1)
  bsp-funded : BbTown, Integer -> Boolean
  bsp-funded (t) (i) = if i == bb-shop-count then True
    else (em-purse t.vendors.currency.world.money (ep-actor t.vendors.currency.world (list-at t.vendors.vendors i).actor).purse).coin == bb-placeholder-loan-gold & bsp-funded t (i + 1)
  bsp-say : Text -> List Integer
  bsp-say (text) = gp-ascii [3,0,text-length text + 9,0,3,178,0,3] text 0 (text-length text + 1)
  bsp-name : Result (Maybe GameReply) Text, Text -> Boolean
  bsp-name (result) (name) = when result
    is Err (_) -> False
    is Ok (None) -> False
    is Ok (Just (reply)) -> if list-length reply.packets == 0 then False
      else let packet = list-at reply.packets 0
      in list-length packet >= 44 & list-at packet 0 == 28
        & utf8-bytes-to-text (list-take (list-drop packet 14) (text-length name)) == name
  bsp-draw-packets : List (List Integer), Integer -> Boolean
  bsp-draw-packets (packets) (i) = if i == list-length packets then False
    else let packet = list-at packets i
    in (list-at packet 0 == #78 & list-length packet > 23 & gp-u16 packet 1 == list-length packet) | bsp-draw-packets packets (i + 1)
  bsp-drawn : Result (Maybe GameReply) Text -> Boolean
  bsp-drawn (result) = when result
    is Err (_) -> False
    is Ok (None) -> False
    is Ok (Just (reply)) -> bsp-draw-packets reply.packets 0
  bsp-visit : BbTown, GameInput, WalkMap, Integer -> [Console] Nothing
  bsp-visit (t) (input) (map) (i) = if i == bb-shop-count then act
    bsp-check "the seven stocked shops' purchases and resales conserve currency and lots" (t.vendors.sale-count == 2 * (bb-shop-count - 1) & gvsc-valid t.vendors)
  end
    else let v = t.vendors
    in let shop = list-at v.vendors i
    in when world-get v.game.world shop.serial
      is Err (e) -> print-line-uni ("FAIL shop actor " & e)
      is Ok (npc) ->
        let moved = world-update v.game.world (gs-mobile input.session.serial (npc.x - 1) npc.y npc.z 400 1002)
        in let draw = bb-pulse t v.game input map 2593 (1000 + i)
        in let named = bb-handler t v.game input map 2593 (gp-put32 [9] npc.serial)
        in let menu = bb-handler t v.game input map 2593 (bsp-say "buy")
        in let p = list-at v.players 0
        in if bb-participant i then act
          bsp-check ("shop handler " & (list-at bb-shops i).title & " names itself and starts with nothing to sell") (is-ok moved & bsp-drawn draw & bsp-name named ("the " & list-at gvb-role-words i) & p.count == 0)
          bsp-visit t input map (i + 1)
        end
        else if p.count < 1 then print-line-uni ("FAIL empty shop " & show i)
        else let source = (list-at p.offers 0).serial
        in let before = v.sale-count
        in let request = gp-put16 (gp-put32 (list-push (list-push (gp-put32 [59,0,15] npc.serial) 2) 26) source) 1
        in let bought = bb-handler t v.game input map 2593 request
        in if v.sale-count /= before + 1 then print-line-uni ("FAIL shop buy " & show i)
        else let delivered = (list-at v.sales before).delivered
        in let sell-menu = bb-handler t v.game input map 2593 (bsp-say "sell")
        in let sold = bb-handler t v.game input map 2593 (gp-put16 (gp-put32 (gp-put16 (gp-put32 [159,0,15] npc.serial) 1) delivered) 1)
        in act
          bsp-check ("shop handler " & (list-at bb-shops i).title) (is-ok moved & bsp-drawn draw & bsp-name named ("the " & list-at gvb-role-words i) & v.sale-count == before + 2 & gsi-known t.items delivered & euv-valid v.currency)
          bsp-visit t input map (i + 1)
        end
  bsp-note : Result (Maybe GameReply) Text -> Text
  bsp-note (r) = when r is Err (e) -> e is Ok (None) -> "none" is Ok (Just (reply)) -> reply.note
  bsp-hello : Result (Maybe GameReply) Text -> Boolean
  bsp-hello (r) = when r is Err (_) -> False is Ok (None) -> False is Ok (Just (reply)) -> list-length reply.packets == 2 & list-at (list-at reply.packets 0) 9 == 6 & list-at (list-at reply.packets 1) 9 == 0
  bsp-stand : BbTown, GameInput, Integer -> Boolean
  bsp-stand (t) (input) (vendor) = when world-get t.vendors.game.world (list-at t.vendors.vendors vendor).serial
    is Err (_) -> False
    is Ok (npc) -> is-ok (world-update t.vendors.game.world (gs-mobile input.session.serial (npc.x - 1) npc.y npc.z 400 1002))
  bsp-found : BbTown, GameInput, WalkMap -> [Console] Nothing
  bsp-found (t) (input) (map) = let v = t.vendors
    in let p = list-at v.players 0
    in let smith = (list-at v.vendors 1).serial
    in let near-smith = bsp-stand t input 1
    in when world-create v.game.world (__record-set (gs-item p.pack #1BF2 0) "amount" 10)
      is Err (e) -> print-line-uni ("FAIL ingot fixture " & e)
      is Ok (ingots) ->
        let wrong = bb-handler t v.game input map 2593 (bsp-say "tailor sell")
        in let menu = bb-handler t v.game input map 2593 (bsp-say "Blacksmith sell")
        in let offered = p.count
        in let bid = (list-at p.offers 0).price
        in let unbound = (list-at p.offers 0).lot
        in let found-before = ep-at v.currency.world.found 31
        in let sales = v.sale-count
        in let sold = bb-handler t v.game input map 2593 (gp-put16 (gp-put32 (gp-put16 (gp-put32 [159,0,15] smith) 1) ingots) 4)
        in let forged = bb-forge v t.items
        in let sword = ep-price v.currency.world (list-at v.vendors 1).actor 70
        in let near-healer = bsp-stand t input 4
        in let refused = bb-handler t v.game input map 2593 (bsp-say "sell")
        in let clicked = bb-handler t v.game input map 2593 (gp-put32 [9] (list-at v.vendors 4).serial)
        in act
          bsp-check "a role standing out of range does not answer" (near-smith & bsp-note wrong == "none")
          bsp-check "the blacksmith offers a loose ingot stack at its melt value" (bsp-note menu == "vendor sell menu" & offered == 1 & unbound < 0 & bid == gvb-standard v.currency.world 31 16 & bid > 0)
          bsp-check "the sale admits found goods as a lot and the census balances" (v.sale-count == sales + 1 & ep-at v.currency.world.found 31 == found-before + 10 & ep-census v.currency.world 1 & gvsc-valid v & euv-valid v.currency)
          print-line-uni ("Britain forged longsword=" & show sword & " ingots-left=" & show (ep-at (ep-actor v.currency.world (list-at v.vendors 1).actor).stock 31))
          bsp-check "the blacksmith forges a longsword from the bought ingots and it quotes near 1 gold" ((when forged is Err (_) -> False is Ok (n) -> n == 1)
            & sword >= 630 & sword <= 770 & ep-at (ep-actor v.currency.world (list-at v.vendors 1).actor).stock 31 == 2 & gvsc-valid v & euv-valid v.currency)
          bsp-check "a vendor with nothing to buy says so overhead" (near-healer & bsp-note refused == "vendor sell menu empty")
          bsp-check "single-clicking a shopkeeper answers its name and Hello" (bsp-note clicked == "Britain shop name" & bsp-hello clicked)
        end
  bsp-client : BbTown, WalkMap -> [Console] Nothing
  bsp-client (t) (map) = let v = t.vendors
    in when world-create v.game.world (gs-mobile 0 1420 1698 0 400 1002)
      is Err (e) -> print-line-uni ("FAIL player fixture " & e)
      is Ok (serial) -> when world-create v.game.world (gs-item serial #0E75 0)
        is Err (e) -> print-line-uni ("FAIL backpack fixture " & e)
        is Ok (pack) ->
          let registered = gsi-register t.items pack 21 #003C False False
          in let bound = gv-add-player v serial 1 pack
          in let slot = poke-qword v.game.characters 0 serial
          in let active = __record-set v.game "active" serial
          in let input = gn-input-with bb-specs 41
          in let mode = __record-set input "mode" 2
          in let phase = __record-set input.session "phase" 2
          in let who = __record-set input.session "serial" serial
          in act
            bsp-visit t input map 0
            bsp-found t input map
            let coin-buf = alloc-bytes euc-bytes
            in let vendors-buf = alloc-bytes gvsc-bytes
            in let items-buf = alloc-bytes (gic-size t.items)
            in let coin-save = euc-encode (CurrencyCheckpoint { currency = v.currency, tick = 0, sequence = 0 }) coin-buf euc-bytes
            in let vendor-save = gvsc-encode v vendors-buf gvsc-bytes
            in let item-save = gic-write t.items items-buf (gic-size t.items)
            in when euc-decode coin-buf euc-bytes
              is Err (e) -> print-line-uni ("FAIL Britain currency restore " & e)
              is Ok (currency) -> when gvsc-decode vendors-buf gvsc-bytes v.game currency.currency
                is Err (e) -> print-line-uni ("FAIL Britain vendor restore " & e)
                is Ok (vendors) -> when gic-read v.game.world items-buf (gic-size t.items)
                  is Err (e) -> print-line-uni ("FAIL Britain item restore " & e)
                  is Ok (items) -> when bb-bind vendors items
                    is Err (e) -> print-line-uni ("FAIL Britain runtime restore " & e)
                    is Ok (loaded) ->
                      let draw = bb-pulse loaded v.game input map 2593 2000
                      in bsp-check "EUC1 GVS1 GSI1 restore preserves shops and resets visibility" (is-ok coin-save & is-ok vendor-save & is-ok item-save & bsp-shops loaded 0 & loaded.vendors.sale-count == 2 * (bb-shop-count - 1) + 1 & bsp-drawn draw & gvsc-valid loaded.vendors)
          end
  bsp-run : GameShard, WalkMap, EuCurrency -> [Console] Nothing
  bsp-run (game) (map) (currency) =
    let v = gv-new game currency
    in let items = gsi-new game.world
    in when bb-populate v items map
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (town) -> act
        bsp-check "eight reference shop regions and registered outfits" (v.vendor-count == bb-shop-count & bsp-shops town 0)
        bsp-check "all stock and clothing trace to recipes and conserved purses" (eg-validate currency.world.catalog == 0 & euv-valid currency & gvsc-valid v)
        bsp-check "eight funded vendor loans and zero invented coin" (bsp-funded town 0 & currency.world.money.loan-count == bb-shop-count & currency.world.money.issued == bb-placeholder-gold-yield & currency.copper.issued == bb-placeholder-copper-yield & currency.silver.issued == bb-placeholder-silver-yield)
        print-line-uni ("Britain prices bread=" & show (ep-price currency.world (list-at v.vendors 3).actor 34) & " pizza=" & show (ep-price currency.world (list-at v.vendors 3).actor 76))
        bsp-check "a day's bread and meal quote near 8 copper" (ep-price currency.world (list-at v.vendors 3).actor 34 + ep-price currency.world (list-at v.vendors 3).actor 76 <= 8)
        let buf = alloc-bytes gvsc-bytes
        in let encoded = gvsc-encode v buf gvsc-bytes
        in act
          bsp-check "Britain registry uses unchanged GVS1 codec" (is-ok encoded & is-ok (gvsc-decode buf gvsc-bytes game currency))
          print-line-uni ("Britain nodes=" & show currency.world.node-count & " stations=" & show currency.world.station-count & " lots=" & show v.lot-count & " objects=" & show (world-count game.world))
          bsp-client town map
        end
      end
  opening : [Console] Nothing = when bb-economy 0
    is Err (e) -> print-line-uni ("FAIL " & e)
    is Ok (currency) -> when world-new 128
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (world) -> let chars = alloc-bytes 800
        in let cleared = gs-zero chars 0
        in let game = GameShard { world = world, characters = chars, accounts = ga-new ga-dev, next-key = 305419895, pending-key = 0, active = 0, log = slg-new slg-trace, skills = chs-new 0 }
        in when walk-map-new 1408 1536 128 192
          is Err (e) -> print-line-uni ("FAIL " & e)
          is Ok (map) -> let filled = bsp-fill map 0
            in if not filled then print-line-uni "FAIL Britain map fixture" else bsp-run game map currency
