Chapter: MageryWallWheelProof
  cites Uoaix chapter MageryCodec
  cites Uoaix chapter WorldTimers

  mww-check : Text, Boolean -> [Console] Nothing
  mww-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  mww-cover : WalkMap, Integer, Integer, Integer -> [Device.Block] Result WalkMap Text
  mww-cover (map) (x) (y) (z) = act
    if walk-cell map x y < 0 then Err "fixture destination outside map" else Ok map
  end
  mww-land : WalkMap, Integer -> Integer
  mww-land (map) (i) = if i == map.width * map.height then 0 else let mark = __heap-save
    in let written = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in mww-land map (i + 1)
  mww-decoration : WalkMap -> Result WdState Text
  mww-decoration (map) = let data = alloc-bytes 64
    in let zero = mgs-zero data 0 8
    in let a = poke-qword data 0 #31445744
    in let b = poke-qword data 16 map.x
    in let c = poke-qword data 24 map.y
    in let d = poke-qword data 32 map.width
    in let e = poke-qword data 40 map.height
    in wd-read data 64 map 200
  MwwEnv = record { game : GameShard, map : WalkMap, magic : Magery, input : GameInput, wheel : Maybe WorldTimers }
  mww-env : Integer -> Result MwwEnv Text
  mww-env (pool) = when gs-new 0
    is Err (e) -> Err e
    is Ok (game) -> when walk-map-new 1408 1680 64 64
      is Err (e) -> Err e
      is Ok (map) -> let filled = mww-land map 0
        in when mww-decoration map
          is Err (e) -> Err e
          is Ok (decoration) -> let hero-mobile = gs-mobile 0 1421 1698 0 400 1002
            in let hp = __record-set hero-mobile "health" 10
            in let hero = world-create game.world hero-mobile
            in let items = gsi-new game.world
            in let bank = gmb-new items #4A
            in let combat = cb-new game 42
            in let magic = mgs-new items bank combat decoration None (mww-cover map)
            in let input = gn-input-with (gsi-specs 0) 1
            in let mode = __record-set input "mode" 2
            in let phase = __record-set input.session "phase" 2
            in let serial = __record-set input.session "serial" 1
            in let active = __record-set game "active" 1
            in let bound = mge-bind magic
            in if not (is-ok hero) then Err "fixture allocation"
            else if pool == 0 then Ok (MwwEnv { game = game, map = map, magic = magic, input = input, wheel = None })
            else when wtm-new pool 256 0
              is Err (e) -> Err e
              is Ok (w) -> Ok (MwwEnv { game = game, map = map, magic = magic, input = input, wheel = Just w })
 A wall placed as mga-walls places one: a world item in a free slot with its expiry, armed on the wheel.
  mww-place : MwwEnv, Integer, Integer, Integer -> Result Integer Text
  mww-place (env) (i) (x) (until) = when world-create env.game.world (WorldObject { serial = 0, kind = 2, x = x, y = 1690, z = 0,
    graphic = #0082, hue = 0, container = 0, amount = 1, health = 0 })
    is Err (e) -> Err e
    is Ok (serial) -> let wall = list-at env.magic.walls i
      in let a = __record-set wall "serial" serial
      in let b = __record-set wall "until" until
      in let armed = mgs-wall-arm env.magic i in Ok serial
 Four walls exist before the wheel is bound (attach arms them), expiring at 2, 5, 5 and 9 s; four more are cast
 at 10 s, expiring at 13, 20, 20 and 50 s. Between 36 and 44 s one wall stands and none is due.
  mww-first : MwwEnv -> Result Integer Text
  mww-first (env) = when mww-place env 0 1410 (mgd-ticks 2000)
    is Err (e) -> Err e
    is Ok (_) -> when mww-place env 1 1411 (mgd-ticks 5000)
      is Err (e) -> Err e
      is Ok (_) -> when mww-place env 2 1412 (mgd-ticks 5000)
        is Err (e) -> Err e
        is Ok (_) -> mww-place env 3 1413 (mgd-ticks 9000)
  mww-second : MwwEnv, Integer -> Result Integer Text
  mww-second (env) (now) = when mww-place env 4 1414 (now + mgd-ticks 3000)
    is Err (e) -> Err e
    is Ok (_) -> when mww-place env 5 1415 (now + mgd-ticks 10000)
      is Err (e) -> Err e
      is Ok (_) -> when mww-place env 6 1416 (now + mgd-ticks 10000)
        is Err (e) -> Err e
        is Ok (_) -> mww-place env 7 1417 (now + mgd-ticks 40000)
  mww-drain : MwwEnv, Integer -> Integer
  mww-drain (env) (tick) = when env.wheel
    is None -> 0
    is Just (w) -> let e = wtm-next w tick
      in if e < 0 then 0
      else let fired = if w.kind == mgs-kind then mgs-fired env.magic w.key else 0 in mww-drain env tick
  mww-live : MwwEnv, Integer, Integer -> Integer
  mww-live (env) (i) (n) = if i == 8 then n
    else let wall = list-at env.magic.walls i
    in mww-live env (i + 1) (n + (if wall.serial == 0 then 0 else 1) + (if wall.serial /= 0 & world-slot env.game.world wall.serial >= 0 then 16 else 0))
  mww-run : MwwEnv, Integer, Integer, List Integer, List Integer -> [Device.Block] Result (List Integer) Text
  mww-run (env) (k) (limit) (trace) (visits) = if k > limit then act Ok (trace & visits) end
    else let now = k * mgd-ticks 100
    in let cast = if k == 100 then mww-second env now else Ok 0
    in if is-err cast then act Err "second cast" end
    else let drained = mww-drain env now
    in act
      pulsed <- mg-pulse env.magic env.game env.input env.map 2593 now
      when pulsed
        is Err (e) -> Err e
        is Ok (_) -> mww-run env (k + 1) limit (list-push trace (mww-live env 0 0)) (if k == 360 | k == 440 | k == limit then list-push visits env.magic.wall-visits else visits)
    end
  mww-pulse-of : Integer -> Integer
  mww-pulse-of (until) = (until + mgd-ticks 100 - 1) / mgd-ticks 100
  mww-first-difference : List Integer, List Integer, Integer, Integer -> Integer
  mww-first-difference (a) (b) (i) (n) = if i == n then -1
    else if list-at a i /= list-at b i then i else mww-first-difference a b (i + 1) n
  mww-timeline : Integer -> [Device.Block] Result (List Integer) Text
  mww-timeline (pool) = when mww-env pool
    is Err (e) -> act Err e end
    is Ok (env) -> when mww-first env
      is Err (e) -> act Err e end
      is Ok (_) -> let attached = when env.wheel is None -> 0 is Just (w) -> mgs-attach env.magic w in mww-run env 1 600 (__list-with-capacity 604) (__list-with-capacity 3)

  opening : [Console, Device.Block] Nothing = act
    scanned <- mww-timeline 0
    wheeled <- mww-timeline 256
    starved <- mww-timeline 2
    when scanned
      is Err (e) -> print-line-uni ("FAIL scan timeline " & e)
      is Ok (a) -> when wheeled
        is Err (e) -> print-line-uni ("FAIL wheel timeline " & e)
        is Ok (b) -> when starved
          is Err (e) -> print-line-uni ("FAIL starved timeline " & e)
          is Ok (c) -> let n = list-length a - 3
            in let diff = if list-length b /= list-length a then 0 else mww-first-difference a b 0 n
            in let starved-diff = if list-length c /= list-length a then 0 else mww-first-difference a c 0 n
            in let scan-window = list-at a (n + 1) - list-at a n
            in let wheel-window = list-at b (n + 1) - list-at b n
            in act
              print-line-uni ("pulses=" & show n & " first-difference=" & show diff & " starved-first-difference=" & show starved-diff & " window-visits scan=" & show scan-window & " wheel=" & show wheel-window & " total-visits scan=" & show (list-at a (n + 2)) & " wheel=" & show (list-at b (n + 2)) & " starved=" & show (list-at c (n + 2)) & " live at pulses 1, 100, 401, " & show n & ": " & show (list-at a 0) & " " & show (list-at a 99) & " " & show (list-at a 400) & " " & show (list-at a (n - 1)))
              mww-check "the wheel and the per-pulse scan expire the same walls at the same pulses over 600 pulses" (diff < 0 & n == 600)
              mww-check "with a 2-entry pool the walls that could not arm expire at the same pulses as the scan" (starved-diff < 0)
              mww-check "the starved wheel revisited walls it could not arm" (list-at c (n + 2) > list-at b (n + 2))
              mww-check "four walls stand at pulse 1 and at pulse 100, the 2 s wall goes at its pulse, one wall stands at pulse 401, and every wall expired and left the world" (list-at a 0 == 4 * 17 & list-at a (mww-pulse-of (mgd-ticks 2000) - 2) == 4 * 17 & list-at a (mww-pulse-of (mgd-ticks 2000) - 1) == 3 * 17 & list-at a 99 == 4 * 17 & list-at a 400 == 17 & list-at a (n - 1) == 0)
              mww-check "a pulse with no wall due visits no wall on the wheel and all 32 slots in the scan (80 pulses)" (wheel-window == 0 & scan-window == 32 * 80)
            end
  end

