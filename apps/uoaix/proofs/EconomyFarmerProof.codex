Chapter: EconomyFarmerProof
  cites Uoaix chapter EconomyFarmer
  cites Uoaix chapter EconomyCurrencyValid

  efp-check : Text, Boolean -> [Console] Integer
  efp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  efp-hours : EuCurrency, EfFarmer, Integer, Integer -> Integer
  efp-hours (x) (f) (left) (tried) = if left == 0 then tried
    else if eu-hour x < 0 then 0 - 1
    else let got = efm-hour f in efp-hours x f (left - 1) (tried + 1)

  opening : [Console] Integer = when bb-economy 0
    is Err (e) -> act
      print-line-uni ("FAIL economy " & e)
      1
    end
    is Ok (x) -> when efm-new x 3201 300
      is Err (e) -> act
        print-line-uni ("FAIL farmer " & e)
        1
      end
      is Ok (f) -> act
        actor <- f.producer.actor
        mill <- list-at x.world.stations (f.mill - 1)
        a <- efp-check "the farmer owns a mill (the flour recipe's station kind) and works a wheat node at its place 300" (mill.kind == (list-at x.world.catalog.recipes (f.recipe - 1)).station & mill.owner == actor & mill.place == 300
          & (list-at x.world.nodes (f.node - 1)).resource == 13 & (ep-actor x.world actor).place == 300)
        hours <- efp-hours x f 480 0
        p <- ep-actor x.world actor
        print-line-uni ("FARMER hours=" & show hours & " gathered=" & show f.gathered & " milled=" & show f.milled & " wheat=" & show (ep-at p.stock 13)
          & " flour=" & show (ep-at p.stock 33) & " seed=" & show (ep-at p.stock 52) & " farming=" & show (ep-at p.skills 5))
        b <- efp-check "over 480 economy hours the farmer harvests wheat and mills it into flour at its mill, two wheat to two flour" (hours == 480 & f.gathered >= 2 & f.milled >= 2
          & ep-at p.stock 33 == f.milled & ep-at p.stock 13 == f.gathered - f.milled)
        c <- efp-check "currency and material census stay valid" (euv-valid x & ep-census x.world 1)
        a + b + c
      end
