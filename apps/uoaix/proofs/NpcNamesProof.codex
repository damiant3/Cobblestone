Chapter: NpcNamesProof
  cites Uoaix chapter NpcNames
  cites Uoaix chapter CompositeSkillCommand

  nnp-check : Text, Boolean -> [Console] Integer
  nnp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  opening : [Console] Integer = act
    shown <- print-line-uni ("TITLES " & nn-profession 7 & ", " & nn-profession 0 & ", " & nn-profession 33 & ", " & nn-profession 45 & ", " & nn-profession 24 & ", " & nn-profession 46)
    a <- nnp-check "one profession title per skill, in csk-names order" (list-length nn-titles == 46 & list-length nn-titles == list-length csk-names)
    b <- nnp-check "best-skill titles read as a player sees a stranger" (nn-profession 7 == "a blacksmith" & nn-profession 0 == "an alchemist"
      & nn-profession 33 == "a pickpocket" & nn-profession 45 == "a miner" & nn-profession 24 == "an infiltrator" & nn-profession 46 == "a stranger")
    a + b
  end
