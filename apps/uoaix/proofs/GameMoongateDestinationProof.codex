Chapter: GameMoongateDestinationProof
  cites Uoaix chapter GameMoongates

  gmd-check : Text, Boolean -> [Console] Integer
  gmd-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  gmd-sweep : Integer, Integer, Integer -> Integer
  gmd-sweep (source) (seconds) (bad) = if source == 8 then bad
    else if seconds > 840 * 60 then gmd-sweep (source + 1) 0 bad
    else let d = gmg-destination source seconds
    in gmd-sweep source (seconds + 60) (if d == source | d < 0 | d > 7 then bad + 1 else bad)
  opening : [Console] Integer = act
    aligned <- gmg-phase 0 False == gmg-phase 0 True
    a <- gmd-check "with both moon phases equal the gate sends the traveller to the next gate" (aligned & gmg-destination 1 0 == 2 & gmg-destination 7 0 == 0)
    b <- gmd-check "no source and phase sends a traveller to its own gate over a whole Felucca cycle" (gmd-sweep 0 0 0 == 0)
    a + b
  end
