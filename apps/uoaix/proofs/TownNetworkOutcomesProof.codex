Chapter: TownNetworkOutcomesProof
  cites Uoaix chapter TownNetworkOutcomes
  cites Foreword chapter Result

  tnop-check : Text, Boolean -> [Console] Nothing
  tnop-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  tnop-range : List Integer, Integer -> Boolean
  tnop-range (xs) (i) = if i == list-length xs then True
    else if list-at xs i < -1000 | list-at xs i > 1000 then False else tnop-range xs (i + 1)
  tnop-positive : TnoData, Integer, Integer -> Integer
  tnop-positive (d) (i) (count) = if i == d.count * 14 then count
    else tnop-positive d (i + 1) (count + (if int-mod i 14 < 10 & list-at d.outcomes i > 0 then 1 else 0))
  opening : [Console] Nothing = act
    before <- __heap-save
    result <- tno-build 0
    after <- __heap-save
    when result
      is Err (message) -> print-line-uni ("FAIL " & message)
      is Ok (d) -> act
        tnop-check "simulation outcomes have complete shape" (d.count == 16 & list-length d.inputs == 512 & list-length d.outcomes == 224)
        tnop-check "all trials conserve and refusals preserve canonical bytes" (d.trials == d.count * 10 & d.refusals >= d.count * 5)
        tnop-check "reverse-order trials reproduce every outcome" (d.repeats == d.trials)
        tnop-check "normalized corpus includes beneficial actions" (tnop-range d.inputs 0 & tnop-range d.outcomes 0 & tnop-positive d 0 0 > 0)
        tnop-check "simulation clones are reclaimed" (after - before < 10000)
      end
  end
