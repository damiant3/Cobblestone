  gcp-check : Text, Boolean -> [Console] Nothing
  gcp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)

  gcp-clear : Integer, Integer, Integer -> Integer
  gcp-clear (buf) (size) (i) = if i >= size then 0
    else let cleared = poke-byte buf i 0 in gcp-clear buf size (i + 1)

  gcp-packet : Integer -> List Integer
  gcp-packet (slot) =
    let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let name = gp-ascii (gp-ascii header "Avatar" 0 30) "" 0 30
    in let stats = name & [0, 30, 20, 15, 0, 50, 1, 50, 2, 0]
    in let skin = gp-put16 stats 1002
    in let appearance = gp-zeros skin 12
    in gp-put16 (gp-put16 (gp-put32 (gp-put16 appearance slot) 0) 55) 77

  gcp-run : GameShard, Integer, Integer -> [Console] Nothing
  gcp-run (game) (mobile) (item) =
    let a = poke-qword game.characters 0 mobile
    in let b = gs-store-create game.characters 0 (gcp-packet 0) 0
    in let c = gs-store-equipment game.characters 0 [item, 0, 0, 0] 0
    in let d = __record-set game "active" mobile
    in let e = __record-set game "pending-key" 123
    in let state = TownState { checkpoint = WorldCheckpoint { world = game.world, tick = 71, sequence = 19 }, townsfolk = tf-new 0, mind = tm-new 0 }
    in let size = gc-size game.world.capacity
    in let buf = alloc-bytes size
    in when gc-encode state game buf size
      is Err (error) -> print-line-uni ("FAIL encode " & error)
      is Ok (written) -> act
        gcp-check "encoded game envelope length" (written == size)
        when gc-decode-record buf size 71 19
          is Err (error) -> print-line-uni ("FAIL decode " & error)
          is Ok (restored) -> act
            gcp-check "shared restored world identity" (restored.game.world.buffer == restored.state.checkpoint.world.buffer & restored.game.world.buffer /= game.world.buffer & world-count restored.game.world == 2)
            gcp-check "detached character slots" (restored.game.characters /= game.characters & restored.game.characters /= buf + 208 & peek-qword restored.game.characters 0 == mobile & peek-qword restored.game.characters 112 == item & peek-byte restored.game.characters 18 == 65)
            gcp-check "boot drops live relay and connection" (restored.game.active == 0 & restored.game.pending-key == 0 & restored.game.next-key == game.next-key)
            when world-get restored.game.world mobile
              is Err (error) -> print-line-uni ("FAIL mobile " & error)
              is Ok (obj) -> gcp-check "nonempty world fields restored" (obj.x == 1421 & obj.y == 1698 & obj.z == -5 & obj.graphic == 400 & obj.hue == 1002 & obj.health == 50)
            let cleared = gcp-clear buf size 0
            in gcp-check "input reuse preserves decoded state" (peek-qword restored.game.characters 0 == mobile & peek-qword restored.game.characters 112 == item & peek-byte restored.game.characters 18 == 65 & world-count restored.state.checkpoint.world == 2)
          end
        let encoded = gc-encode state game buf size
        in gcp-check "reencode after buffer reuse" (is-ok encoded)
        gcp-check "outer metadata disagreement refused" (is-err (gc-decode-record buf size 72 19))
        gcp-check "truncated envelope refused" (is-err (gc-decode buf (size - 1)))
        let corrupt = poke-byte buf 218 66
        in gcp-check "slot corruption refused" (is-err (gc-decode buf size))
        let encoded = gc-encode state game buf size
        in let missing = poke-qword buf 208 999
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in gcp-check "rehashed missing mobile refused" (is-err (gc-decode buf size))
        let encoded = gc-encode state game buf size
        in let missing = poke-qword buf 320 mobile
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in gcp-check "rehashed equipment kind refused" (is-err (gc-decode buf size))
        let encoded = gc-encode state game buf size
        in let reserved = poke-byte buf 352 1
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in gcp-check "rehashed slot padding refused" (is-err (gc-decode buf size))
        let encoded = gc-encode state game buf size
        in let duplicate = ws-copy (buf + 208) (buf + 368) 160 0
        in let slot = poke-byte buf 471 1
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in gcp-check "rehashed duplicate mobile refused" (is-err (gc-decode buf size))
        let encoded = gc-encode state game buf size
        in let dirty = poke-byte buf 376 1
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in gcp-check "rehashed unused slot refused" (is-err (gc-decode buf size))
        let wrong = GameShard { world = WorldTable { buffer = game.world.buffer, capacity = game.world.capacity - 1, index = 0 }, characters = game.characters, accounts = game.accounts, next-key = game.next-key, pending-key = 0, active = 0 }
        in gcp-check "shared buffer capacity mismatch refused" (is-err (gc-encode state wrong buf size))
        gcp-check "encode overlap refused" (is-err (gc-encode state game game.characters size) & is-err (gc-encode state game game.world.buffer size))
      end

  opening : [Console] Nothing = when gs-new 0
    is Err (error) -> print-line-uni ("FAIL world " & error)
    is Ok (game) -> when world-create game.world (gs-mobile 0 1421 1698 (-5) 400 1002)
      is Err (error) -> print-line-uni ("FAIL mobile " & error)
      is Ok (mobile) -> when world-create game.world (gs-item mobile 5399 55)
        is Err (error) -> print-line-uni ("FAIL item " & error)
        is Ok (item) -> gcp-run game mobile item

