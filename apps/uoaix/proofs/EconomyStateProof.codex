Chapter: EconomyStateProof
  cites Uoaix chapter EconomyClock
  cites Uoaix chapter EconomyStateValid
  cites Uoaix chapter EconomyStateCodec
  cites Uoaix chapter EconomyCatalog
  cites Uoaix chapter EconomyProduction
  cites Uoaix chapter EconomyMoney
  cites Uoaix chapter EconomyMint
  cites Uoaix chapter EconomyHarvest
  cites Uoaix chapter WorldSnapshot
  cites Foreword chapter Result

  esp-check : Text, Boolean -> [Console] Nothing
  esp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  esp-hours : EpWorld, Integer -> Integer
  esp-hours (w) (n) = if n == 0 then 0 else if eh-step w /= 0 then -1 else esp-hours w (n - 1)
  esp-equal : Integer, Integer, Integer -> Boolean
  esp-equal (one) (two) (i) = if i == es-bytes then True
    else if peek-qword one i /= peek-qword two i then False else esp-equal one two (i + 8)
  esp-refused : Integer, Integer, Integer -> Boolean
  esp-refused (buf) (at) (value) =
    let saved = peek-qword buf at
    in let old-hash = peek-qword buf 48
    in let changed = poke-qword buf at value
    in let rehash = poke-qword buf 48 (ws-hash buf es-bytes 0 2166136261)
    in let mark = __heap-save
    in let refused = is-err (es-decode buf es-bytes)
    in let restored = __heap-restore mark
    in let original = poke-qword buf at saved
    in let hash = poke-qword buf 48 old-hash
    in refused
  esp-taxed-kept : Integer -> Boolean
  esp-taxed-kept (buf) =
    let at = es-v5-bytes + 6 * 8
    in let saved = peek-qword buf at
    in let old-hash = peek-qword buf 48
    in let changed = poke-qword buf at 1
    in let rehash = poke-qword buf 48 (ws-hash buf es-bytes 0 2166136261)
    in let mark = __heap-save
    in let kept = when es-decode buf es-bytes
      is Err (_) -> False
      is Ok (state) -> ep-at state.world.taxed 6 == 1 & ep-at state.world.taxed 7 == 0
    in let restored = __heap-restore mark
    in let original = poke-qword buf at saved
    in let hash = poke-qword buf 48 old-hash
    in kept
  esp-items : EgCatalog, Integer, List EgItem -> List EgItem
  esp-items (c) (i) (xs) = if i == 128 then xs
    else let core = i == 3 | i == 13 | i == 15 | i == 31 | i == 33 | i == 49 | i == 50 | i == 61
    in let name = if core then (list-at c.items i).name else "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    in let chain = if i < 62 then (list-at c.items i).chain else 1
    in esp-items c (i + 1) (list-push xs (eg-item name chain))
  esp-resources : Integer, List EgResource -> List EgResource
  esp-resources (i) (xs) = if i == 64 then xs else esp-resources (i + 1) (list-push xs (eg-resource 1 0 0 0 0 1 1))
  esp-recipes : Integer, List EgRecipe -> List EgRecipe
  esp-recipes (i) (xs) = if i == 128 then xs
    else esp-recipes (i + 1) (list-push xs (eg-recipe (if i < 97 then i + 32 else 1) 1 1 1 0 0 0 0 1 0 0))
  esp-maximum : EconomyCheckpoint, Integer -> [Console] Nothing
  esp-maximum (source) (buf) = act
    base <- eg-standard 0
    catalog <- EgCatalog { items = esp-items base 0 [], resources = esp-resources 24 base.resources, recipes = esp-recipes 31 base.recipes }
    changed <- __record-set source.world "catalog" catalog
    written <- es-encode source buf es-bytes
    before <- __heap-save
    decoded <- es-decode buf es-bytes
    after <- __heap-save
    print-line-uni ("ECONOMY-MAX-CATALOG-DECODE-BYTES " & show (after - before))
    esp-check "maximum catalog decoder budget" (is-ok written & is-ok decoded & after - before < 3145728)
  end
  esp-paid-default : EcClock -> [Console] Nothing
  esp-paid-default (clock) = act
    w <- clock.world
    repaid <- em-repay w.money 2 1 100000
    advanced <- esp-hours w 1000
    checkpoint <- EconomyCheckpoint { world = w, tick = 10000, sequence = 1 }
    buf <- alloc-bytes es-bytes
    written <- es-encode checkpoint buf es-bytes
    esp-check "fully repaid loan baseline valid" (repaid == 0 & advanced == 0 & is-ok written & (list-at w.money.loans 0).status == 2)
    count <- w.money.entry-count
    at <- es-ledger-at + count * 56
    a <- poke-qword buf at w.money.sequence
    b <- poke-qword buf (at + 8) w.hour
    c <- poke-qword buf (at + 16) 2
    d <- poke-qword buf (at + 24) 1
    e <- poke-qword buf (at + 32) 0
    f <- poke-qword buf (at + 40) 9
    g <- poke-qword buf (at + 48) 1
    h <- poke-qword buf (es-money-at + 16) (count + 1)
    j <- poke-qword buf (es-money-at + 56) (w.money.defaults + 1)
    hash <- poke-qword buf 48 (ws-hash buf es-bytes 0 2166136261)
    esp-check "rehashed default after full repayment refused" (is-err (es-decode buf es-bytes))
  end
  esp-restored : EconomyCheckpoint, Integer, Integer, EconomyCheckpoint -> [Console] Nothing
  esp-restored (source) (buf) (copy) (loaded) = act
    w <- loaded.world
    encoded <- es-encode loaded copy es-bytes
    esp-check "canonical round trip covers complete body" (is-ok encoded & esp-equal buf copy 0)
    purse-before <- (em-purse w.money 2).coin
    detached-purse <- __record-set (em-purse w.money 2) "coin" (purse-before + 1)
    esp-check "detached catalogs inventories and loans" ((em-purse source.world.money 2).coin == purse-before & (ep-actor w 1).stock /= (ep-actor source.world 1).stock & (list-at w.catalog.items 0).name == "stone\nquarry" & (list-at w.money.loans 55).paid == 20 & (list-at w.money.loans 55).status == 3 & w.money.defaults == 1 & w.mint-rate == 1000000)
    original-purse <- __record-set (em-purse w.money 2) "coin" purse-before
    original-byte <- peek-byte buf 112
    overwritten <- poke-byte buf 112 0
    esp-check "input buffer reuse keeps decoded text" ((list-at w.catalog.items 0).name == "stone\nquarry")
    restored-byte <- poke-byte buf 112 original-byte
    one <- eh-step source.world
    two <- eh-step w
    left <- es-encode source buf es-bytes
    right <- es-encode loaded copy es-bytes
    esp-check "restored state advances identically" (one == 0 & two == 0 & is-ok left & is-ok right & esp-equal buf copy 0)
  end
  esp-upgraded : Integer, Integer, EconomyCheckpoint, Text -> [Console] Nothing
  esp-upgraded (buf) (copy) (state) (label) = act
    encoded <- es-encode state copy es-bytes
    esp-check ("version " & label & " restore re-encodes the version 3 bytes") (is-ok encoded & esp-equal buf copy 0)
  end
  esp-legacy : Integer, Integer, Integer, Integer, Text -> [Console] Nothing
  esp-legacy (buf) (copy) (size) (version) (label) = act
    old-hash <- peek-qword buf 48
    old-version <- peek-qword buf 8
    tail-zero <- es-zero-range buf size es-bytes
    labeled <- poke-qword buf 8 version
    length <- poke-qword buf 16 size
    hash <- poke-qword buf 48 (ws-hash buf size 0 2166136261)
    decoded <- es-decode-record buf size 7310 88
    mislabeled <- poke-qword buf 8 (version + 1)
    rehash <- poke-qword buf 48 (ws-hash buf size 0 2166136261)
    refused <- is-err (es-decode buf size)
    current <- poke-qword buf 8 old-version
    full <- poke-qword buf 16 es-bytes
    restored <- poke-qword buf 48 old-hash
    esp-check ("version " & label & " layout decodes and a later version header over it refuses") (tail-zero & is-ok decoded & refused)
    when decoded
      is Err (e) -> print-line-uni ("FAIL legacy " & e)
      is Ok (state) -> esp-upgraded buf copy state label
  end
  esp-run : EcClock -> [Console] Nothing
  esp-run (clock) = act
    w <- clock.world
    esp-check "bootstrap state valid" (ev-valid w)
    advanced <- ec-run clock 720 False
    mark <- __heap-save
    valid <- ev-valid w
    finish <- __heap-save
    esp-check "30-day state valid and validation scratch reclaimed" (advanced == 0 & valid & finish == mark)
    catalog-name <- __record-set (list-at w.catalog.items 0) "name" "stone\nquarry"
    taxed <- em-set-tax w.money True 1000
    loan <- em-lend w.money 3 4 100 10 730
    repaid <- em-repay w.money 4 loan 20
    defaulted <- esp-hours w 11
    policy <- emi-configure w True 55 1000000
    esp-check "loan tax default and policy state valid" (taxed == 0 & loan == 56 & repaid == 0 & defaulted == 0 & policy == 0 & ev-valid w)
    source <- EconomyCheckpoint { world = w, tick = 7310, sequence = 88 }
    buf <- alloc-bytes es-bytes
    copy <- alloc-bytes es-bytes
    written <- es-encode source buf es-bytes
    esp-check "header and independent section layout" (is-ok written & es-v1-bytes == 1360768 & es-v2-bytes == 1366912 & es-v3-bytes == 1422208 & es-v4-bytes == 1423240 & es-v5-bytes == 1431656 & es-bytes == 1432688 & peek-qword buf 0 == #31434555 & peek-qword buf 8 == 6 & peek-qword buf 16 == es-bytes & peek-qword buf 32 == 7310 & peek-qword buf 40 == 88 & peek-qword buf 64 == 62 & peek-qword buf 72 == 24 & peek-qword buf 80 == 31 & peek-qword buf es-money-at == 56 & peek-qword buf es-world-at == 55)
    before-decode <- __heap-save
    decoded <- es-decode-record buf es-bytes 7310 88
    after-decode <- __heap-save
    print-line-uni ("ECONOMY-DECODE-BYTES " & show (after-decode - before-decode))
    esp-check "decoder retained allocation budget" (is-ok decoded & after-decode - before-decode < 3145728)
    when decoded
      is Err (e) -> print-line-uni ("FAIL decode " & e)
      is Ok (state) -> esp-restored source buf copy state
    esp-check "record metadata and truncation refused" (is-err (es-decode-record buf es-bytes 7310 89) & is-err (es-decode buf (es-bytes - 1)))
    ore-taxed <- ep-at w.taxed 6 + ep-at w.taxed 63 + ep-at w.taxed 64
    print-line-uni ("ECONOMY-ORE-TAXED " & show ore-taxed)
    untaxed-gold <- ep-set w.taxed 6 0
    untaxed-copper <- ep-set w.taxed 63 0
    untaxed-silver <- ep-set w.taxed 64 0
    legacy-source <- es-encode source buf es-bytes
    esp-check "a world with no mining tax re-encodes for the legacy layouts" (ore-taxed > 0 & is-ok legacy-source)
    esp-legacy buf copy es-v1-bytes 1 "1"
    esp-legacy buf copy es-v2-bytes 2 "2"
    esp-legacy buf copy es-v3-bytes 3 "3"
    esp-legacy buf copy es-v4-bytes 4 "4"
    esp-legacy buf copy es-v5-bytes 5 "5"
    esp-check "rehashed spare station slot refused" (esp-refused buf (es-station-at 200) 1)
    esp-check "rehashed spare node slot past 256 refused" (esp-refused buf (es-node-at 900) 1)
    esp-check "rehashed purse mismatch refused" (esp-refused buf (es-purses-at + 24 + 16) ((em-purse w.money 2).coin + 1))
    esp-check "rehashed loan paid mismatch refused" (esp-refused buf (es-loans-at + 40) 1)
    esp-check "rehashed mint source mismatch refused" (esp-refused buf (es-ledger-at + 56 + 32) 6000001)
    esp-check "rehashed trade action mismatch refused" (esp-refused buf es-trades-at 1)
    esp-check "rehashed inventory mismatch refused" (esp-refused buf (es-actors-at + 32 + 40 * 8) 999999)
    esp-check "rehashed inactive actor refused" (esp-refused buf (es-actors-at + 127 * 4248 + 32 + 8) 1)
    esp-check "catalog dimensions text and spare slots refused" (esp-refused buf 64 129 & esp-refused buf 104 65 & esp-refused buf (96 + 127 * 80) 1)
    esp-check "reserved header refused" (esp-refused buf 56 1)
    esp-check "a mining tax within the ore mined decodes and keeps its count" (ep-at w.gathered 6 > 0 & esp-taxed-kept buf)
    esp-check "rehashed tax on an untaxable item refused" (esp-refused buf (es-v5-bytes + 8) 1)
    esp-check "rehashed gold tax past the gold mined refused" (esp-refused buf (es-v5-bytes + 6 * 8) (ep-at w.gathered 6 + ep-at w.found 6 + 1))
    esp-check "encoder refuses inventory overlap" (is-err (es-encode source (ep-actor w 1).stock es-bytes))
    esp-maximum source buf
    bad <- __record-set (em-purse w.money 2) "coin" ((em-purse w.money 2).coin + 1)
    esp-check "ledger purse mismatch refused" (not (ev-valid w))
  end
  opening : [Console] Nothing = act
    when ec-fixture 0
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (clock) -> esp-run clock
    when ec-fixture 0
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (clock) -> esp-paid-default clock
  end
