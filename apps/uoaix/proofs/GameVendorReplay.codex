Chapter: GameVendorReplay
  cites Uoaix chapter GameVendorDemo
  cites Uoaix chapter EconomyCurrencyCodec
  cites Uoaix chapter GameVendorCodec

  gvr-check : Text, Boolean -> [Console] Nothing
  gvr-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  gvr-say : Text -> List Integer
  gvr-say (text) = gp-ascii [3, 0, text-length text + 9, 0, 3, 178, 0, 3] text 0 (text-length text + 1)
  gvr-buy : Integer, Integer, Integer -> List Integer
  gvr-buy (vendor) (serial) (quantity) = gp-put16 (gp-put32 (list-push (list-push (gp-put32 [59, 0, 15] vendor) 2) 26) serial) quantity
  gvr-sell : Integer, Integer, Integer -> List Integer
  gvr-sell (vendor) (serial) (quantity) = gp-put16 (gp-put32 (gp-put16 (gp-put32 [159, 0, 15] vendor) 1) serial) quantity
  gvr-reply : Result (Maybe GameReply) Text -> Boolean
  gvr-reply (r) = when r
    is Err (e) -> False
    is Ok (m) -> when m
      is None -> False
      is Just (reply) -> not reply.close
  gvr-menu-ok : Result (Maybe GameReply) Text -> Boolean
  gvr-menu-ok (r) = when r
    is Err (e) -> False
    is Ok (m) -> when m
      is None -> False
      is Just (reply) -> list-length reply.packets == 11 & list-at (list-at reply.packets 10) 0 == 28
        & list-at (list-at reply.packets 4) 0 == 60
        & gp-u16 (list-at reply.packets 4) 1 == 24
        & list-at (list-at reply.packets 5) 0 == 116
        & list-length (list-at reply.packets 8) == 7
        & gp-u16 (list-at reply.packets 8) 5 == 48
  gvr-bad-speech : GvWorld, GameInput, Integer, Integer -> Boolean
  gvr-bad-speech (v) (s) (at) (byte) =
    let p = list-at v.players 0
    in let side = p.side
    in let count = p.count
    in let vendor = p.vendor
    in let expires = p.expires
    in let packet = gvr-say "buy"
    in let changed = list-set-at packet at byte
    in let refused = gv-handle-at v v.game s packet 90000
    in not (is-ok refused) & p.side == side & p.count == count & p.vendor == vendor & p.expires == expires
  gvr-refusals : GvWorld, GameInput -> [Console] Nothing
  gvr-refusals (v) (s) =
    let p = list-at v.players 0
    in let npc = list-at v.vendors 0
    in let source = (list-at v.lots 0).serial
    in let baseline = v.sale-count
    in let menu = gv-handle-at v v.game s (gvr-say "buy") 80000
    in let undo = gvu-save v 1 2 1
    in let cash = (em-purse v.currency.world.money 2).coin
    in let cash-c = (em-purse v.currency.copper 2).coin
    in let cash-s = (em-purse v.currency.silver 2).coin
    in let drained = eu-pay v.currency True 2 3 cash-c cash-s cash
    in let refused = gv-handle-at v v.game s (gvr-buy npc.serial source 1) 80001
    in let restored = gvu-restore v undo
    in act
      gvr-check "insufficient funds moves zero items" (drained == 0 & gvr-reply refused & v.sale-count == baseline & (list-at v.lots 0).quantity == 2 & (em-purse v.currency.world.money 2).coin == cash & (em-purse v.currency.copper 2).coin == cash-c & euv-valid v.currency)
      when world-get v.game.world p.serial
        is Err (e) -> print-line-uni ("FAIL range fixture " & e)
        is Ok (mobile) ->
          let x = mobile.x
          in let moved = __record-set mobile "x" (x + 10)
          in let stored = world-update v.game.world mobile
          in let far = gv-handle-at v v.game s (gvr-buy npc.serial source 1) 80002
          in let back = __record-set mobile "x" x
          in let reset = world-update v.game.world mobile
          in act
            gvr-check "out of range moves zero items" (gvr-reply far & v.sale-count == baseline)
            gvr-check "malformed packet refused before indexed read" (not (is-ok (gv-handle-at v v.game s [59, 0, 8] 80003)))
            gvr-check "malformed speech cannot open quotes" (gvr-bad-speech v s 11 88 & gvr-bad-speech v s 3 1 & gvr-bad-speech v s 4 4 & gvr-bad-speech v s 7 10)
          end
    end
  gvr-run : GvWorld, Integer -> [Console] Nothing
  gvr-run (v) (serial) =
    let s = gn-input-with gv-specs 41
    in let mode = __record-set s "mode" 2
    in let phase = __record-set s.session "phase" 2
    in let who = __record-set s.session "serial" serial
    in let active = __record-set v.game "active" serial
    in let metadata = poke-qword v.game.characters 0 serial
    in let bound = gvd-bind v serial
    in let p = list-at v.players 0
    in let npc = list-at v.vendors 0
    in let source = (list-at v.lots 0).serial
    in let menu = gv-handle-at v v.game s (gvr-say "buy") 100
    in let price = (list-at p.offers 0).price
    in let buy = gvr-buy npc.serial source 2
    in let before-sequence = v.currency.world.money.sequence
    in act
      gvr-check "vendor opcode profiles" (go-valid gv-specs & go-packet-valid gv-specs buy & go-packet-valid gv-specs (gvr-sell npc.serial source 1))
      gvr-check "classic buy contents prices and gump order" (gvr-menu-ok menu & price >= 1 & price <= 50)
      let forged = gv-handle-at v v.game s (gvr-buy npc.serial 1073741887 1) 101
      in act
        gvr-check "forged serial changes no items or money" (gvr-reply forged & v.sale-count == 0 & v.currency.world.money.sequence == before-sequence & (list-at v.lots 0).quantity == 4)
        let reopen = gv-handle-at v v.game s (gvr-say "buy") 200
        in let too-many = gv-handle-at v v.game s (gvr-buy npc.serial source 5) 201
        in act
          gvr-check "excess quantity refused" (gvr-reply too-many & v.sale-count == 0 & v.lot-count == 1)
          let again = gv-handle-at v v.game s (gvr-say "buy") 300
          in let bought = gv-handle-at v v.game s buy 301
          in let delivered = (list-at v.sales 0).delivered
          in act
            gvr-check "buy splits selected serial" (gvr-reply bought & v.sale-count == 1 & delivered /= source & (list-at v.lots 0).quantity == 2 & (list-at v.lots 1).quantity == 2 & gv-owned v.game.world delivered serial 65)
            gvr-check "buy exact quality wear and conserved taxed coin" ((list-at v.lots 1).quality == 1000 & (list-at v.lots 1).wear == 32 & (em-purse v.currency.copper 2).coin == 100 - 2 * price & (em-purse v.currency.copper 3).coin == 2 * price - 2 * price / 10 & (em-purse v.currency.copper 1).coin == 2 * price / 10 & (em-purse v.currency.world.money 2).coin == 99 & euv-valid v.currency)
            gvr-check "a gold-only buyer breaks coin with the crown, which decrees the silver and copper it lacks" (gvr-decrees v.currency 0 0 == 110 & (em-purse v.currency.silver 1).coin == 10 & (em-purse v.currency.world.money 1).coin == 701)
            let duplicate = gv-handle-at v v.game s buy 302
            in act
              gvr-check "consumed quote cannot replay" (gvr-reply duplicate & v.sale-count == 1)
              let sellmenu = gv-handle-at v v.game s (gvr-say "sell") 400
              in let bid = (list-at p.offers 0).price
              in let sold = gv-handle-at v v.game s (gvr-sell npc.serial delivered 2) 401
              in act
                gvr-check "sell retains serial and stock" (gvr-reply sellmenu & gvr-reply sold & bid == price / 2 & v.sale-count == 2 & gv-owned v.game.world delivered npc.serial 65 & (list-at v.lots 1).quantity == 2)
                gvr-check "sell coordinator and item census" ((em-purse v.currency.copper 2).coin == 100 - 2 * price + 2 * bid & (em-purse v.currency.copper 3).coin == 2 * price - 2 * price / 10 - 2 * bid & ep-at (ep-actor v.currency.world 2).stock 2 == 4 & euv-valid v.currency)
                let expiry-menu = gv-handle-at v v.game s (gvr-say "buy") 500
                in let expired = gv-handle-at v v.game s buy (500 + gv-quote-ticks)
                in act
                  gvr-check "expired quote refused" (gvr-reply expired & v.sale-count == 2)
                  let reconnect-menu = gv-handle-at v v.game s (gvr-say "buy") 70000
                  in let newconn = __record-set s "connection" 42
                  in let reconnect = gv-handle-at v v.game s buy 70001
                  in act
                    gvr-check "connection-bound quote refused" (gvr-reply reconnect & v.sale-count == 2)
                    let undo = gvu-save v 1 2 1
                    in let line = GvLine { lot = 0, quantity = 1, price = 7, delivered = source, basis = 0, copper = 7, silver = 0, gold = 0 }
                    in let paid = gv-pay-line v line 1 2
                    in let restored = gvu-restore v undo
                    in act
                      gvr-check "currency metadata and append rollback" (paid == 0 & v.sale-count == 2 & v.currency.world.trade-count == 2 & (list-at v.lots 0).actor == 2 & (list-at v.lots 0).quantity == 2 & (em-purse v.currency.copper 2).coin == 100 - 2 * price + 2 * (price / 2) & euv-valid v.currency)
                      gvr-check "source and delivery serial audit" ((list-at v.sales 0).source == source & (list-at v.sales 0).delivered == delivered & (list-at v.sales 1).source == delivered & (list-at v.sales 1).delivered == delivered)
                      gvr-refusals v s
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  gvr-gold : Integer -> [Console] Nothing
  gvr-gold (unused) = when gvd-economy 0
    is Err (e) -> print-line-uni ("FAIL " & e)
    is Ok (currency) -> when gs-new 0
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (game) -> when gvd-world game currency 0
        is Err (e) -> print-line-uni ("FAIL " & e)
        is Ok (v) -> when world-create game.world (gs-mobile 0 1420 1698 0 400 1002)
          is Err (e) -> print-line-uni ("FAIL " & e)
          is Ok (serial) -> gvr-run v serial

  gvr-equal : Integer, Integer, Integer, Integer -> Boolean
  gvr-equal (a) (b) (size) (at) = if at == size then True
    else if peek-qword a at /= peek-qword b at then False else gvr-equal a b size (at + 8)
  gvr-mixed-undo : GvWorld -> [Console] Nothing
  gvr-mixed-undo (v) =
    let one = alloc-bytes euc-bytes
    in let two = alloc-bytes euc-bytes
    in let checkpoint = CurrencyCheckpoint { currency = v.currency, tick = 0, sequence = 0 }
    in let before = euc-encode checkpoint one euc-bytes
    in let undo = gvu-save v 1 2 2
    in let grant = eu-grant v.currency True 1 2 200 40 0
    in let line = GvLine { lot = 0, quantity = 1, price = 700, delivered = (list-at v.lots 0).serial,
      basis = 0, copper = 200, silver = 40, gold = 1 }
    in let paid = gv-pay-line v line 1 2
    in let restored = gvu-restore v undo
    in let after = euc-encode checkpoint two euc-bytes
    in act
      gvr-check "mixed rollback restores all three ledgers byte for byte" (grant == 0 & paid == 0 & is-ok before & is-ok after & gvr-equal one two euc-bytes 0 & v.sale-count == 2)
      when euc-decode one euc-bytes
        is Err (e) -> print-line-uni ("FAIL mixed currency checkpoint " & e)
        is Ok (loaded) -> let encoded = euc-encode loaded two euc-bytes
          in gvr-check "mixed sale EUC1 roundtrip retains tender and valuation" (is-ok encoded & gvr-equal one two euc-bytes 0 & euv-valid loaded.currency)
    end
  gvr-vendor-codec : GvWorld, GameInput -> [Console] Nothing
  gvr-vendor-codec (v) (s) =
    let opened = gv-handle-at v v.game s (gvr-say "buy") 1000
    in let buf = alloc-bytes gvsc-bytes
    in let copy = alloc-bytes gvsc-bytes
    in let currency-bytes = alloc-bytes euc-bytes
    in let saved-currency = euc-encode (CurrencyCheckpoint { currency = v.currency, tick = 0, sequence = 0 }) currency-bytes euc-bytes
    in let encoded = gvsc-encode v buf gvsc-bytes
    in act
      gvr-check "vendor codec fits encompassing checkpoint budget" (is-ok encoded & is-ok saved-currency & gvsc-bytes + euc-bytes < 4194304)
      when euc-decode currency-bytes euc-bytes
        is Err (e) -> print-line-uni ("FAIL codec currency anchor " & e)
        is Ok (currency) -> when gvsc-decode buf gvsc-bytes v.game currency.currency
          is Err (e) -> print-line-uni ("FAIL vendor codec " & e)
          is Ok (loaded) ->
            let p = list-at loaded.players 0
            in let price = ep-at (list-at loaded.vendors 0).prices 2
            in let same = gvsc-encode loaded copy gvsc-bytes
            in let changed = poke-qword buf (gvsc-vendors-at + 40 + 2 * 8) (price + 1)
            in let independent = ep-at (list-at loaded.vendors 0).prices 2 == price
            in let original = poke-qword buf (gvsc-vendors-at + 40 + 2 * 8) price
            in act
              gvr-check "vendor codec roundtrip binds supplied world and currency" (is-ok same & loaded.sale-count == v.sale-count & loaded.sequence == v.sequence & gvr-equal buf copy gvsc-bytes 0 & loaded.game.world.buffer == v.game.world.buffer)
              gvr-check "vendor reload clears quotes and copies price buffers" (p.side == 0 & p.count == 0 & p.connection == -1 & p.expires == 0 & independent & (list-at v.players 0).side == 1)
              let serial = peek-qword buf gvsc-lots-at
              in let forged = poke-qword buf gvsc-lots-at (list-at v.vendors 0).stock
              in let checksum = poke-qword buf 48 (ws-hash buf gvsc-bytes 0 2166136261)
              in let rejected = not (is-ok (gvsc-decode buf gvsc-bytes v.game currency.currency))
              in let restored = poke-qword buf gvsc-lots-at serial
              in let event = peek-qword buf (gvsc-sales-at + 72)
              in let bogus = poke-qword buf (gvsc-sales-at + 72) 1
              in let checksum2 = poke-qword buf 48 (ws-hash buf gvsc-bytes 0 2166136261)
              in let history = not (is-ok (gvsc-decode buf gvsc-bytes v.game currency.currency))
              in act
                gvr-check "vendor codec rejects serial and payment rebinding" (rejected & history & (list-at v.lots 0).serial == serial & euv-valid v.currency)
              end
            end
    end
  gvr-decrees : EuCurrency, Integer, Integer -> Integer
  gvr-decrees (x) (i) (sum) = if i == x.count then sum
    else let e = list-at x.events i in gvr-decrees x (i + 1) (if e.kind == 12 then sum + e.party else sum)
  gvr-receipt : Result (Maybe GameReply) Text -> Text
  gvr-receipt (result) = when result
    is Err (e) -> ""
    is Ok (maybe) -> when maybe
      is None -> ""
      is Just (reply) -> let packet = list-at reply.packets (list-length reply.packets - 1)
        in if list-at packet 0 /= 28 then ""
        else utf8-bytes-to-text (list-take (list-drop packet 44) (list-length packet - 45))
  gvr-mixed-run : GvWorld, Integer -> [Console] Nothing
  gvr-mixed-run (v) (serial) =
    let s = gn-input-with gv-specs 77
    in let mode = __record-set s "mode" 2
    in let phase = __record-set s.session "phase" 2
    in let who = __record-set s.session "serial" serial
    in let active = __record-set v.game "active" serial
    in let metadata = poke-qword v.game.characters 0 serial
    in let bound = gvd-bind v serial
    in let p = list-at v.players 0
    in let npc = list-at v.vendors 0
    in let source = (list-at v.lots 0).serial
    in let menu = gv-handle-at v v.game s (gvr-say "buy") 100
    in let status = gv-status-packet v p
    in let bought = gv-handle-at v v.game s (gvr-buy npc.serial source 1) 101
    in let event = list-at v.currency.events ((list-at v.sales 0).currency-event - 1)
    in let delivered = (list-at v.sales 0).delivered
    in act
      gvr-check "mixed purse displayed in gold equivalents" (gvr-reply menu & gp-u32 status 58 == 7)
      gvr-check "wire buy pays a copper price in copper" (gvr-reply bought & v.sale-count == 1 & event.kind == 11 & event.reference == (list-at p.offers 0).price & event.copper == event.reference & event.silver == 0 & event.gold == 0)
      gvr-check "mixed tax and item census conserved" ((em-purse v.currency.copper 1).coin == 800 & (em-purse v.currency.silver 1).coin == 60 & (em-purse v.currency.world.money 1).coin == 799 & euv-valid v.currency)
      let original = event.copper
      in let changed = __record-set event "copper" (original + 1)
      in let invalid = not (euv-valid v.currency)
      in let restored = __record-set event "copper" original
      in act
        gvr-check "forged mixed tender history refused" invalid
        let priced = ep-set npc.prices 2 20
        in let sellmenu = gv-handle-at v v.game s (gvr-say "sell") 200
        in let copper-before = (em-purse v.currency.copper 2).coin
        in let sold = gv-handle-at v v.game s (gvr-sell npc.serial delivered 1) 201
        in act
          gvr-check "wire sell after mixed buy retains item and pays vendor funds" (gvr-reply sellmenu & gvr-reply sold & v.sale-count == 2 & gv-owned v.game.world delivered npc.serial 65 & (em-purse v.currency.silver 2).coin == 40 & (em-purse v.currency.copper 2).coin == copper-before + 1 & euv-valid v.currency)
          gvr-check "taxed sell receipt reports net proceeds and tax" (gvr-receipt sold == "Received 0 gold, 0 silver, 1 copper; tax 0 gold, 0 silver, 0 copper.")
          gvr-mixed-undo v
          let reopen = gv-handle-at v v.game s (gvr-say "buy") 300
          in let rates = eu-rates v.currency True 1 200 20
          in let stale = gv-handle-at v v.game s (gvr-buy npc.serial source 1) 301
          in act
            gvr-check "rate edit invalidates open vendor quote" (rates == 0 & gvr-reply stale & v.sale-count == 2 & p.side == 0 & euv-valid v.currency)
            gvr-vendor-codec v s
          end
        end
      end
    end
  gvr-mixed : Integer -> [Console] Nothing
  gvr-mixed (unused) = when gvd-mixed-economy 0
    is Err (e) -> print-line-uni ("FAIL " & e)
    is Ok (currency) -> when gs-new 0
      is Err (e) -> print-line-uni ("FAIL " & e)
      is Ok (game) -> when gvd-world game currency 0
        is Err (e) -> print-line-uni ("FAIL " & e)
        is Ok (v) -> when world-create game.world (gs-mobile 0 1420 1698 0 400 1002)
          is Err (e) -> print-line-uni ("FAIL " & e)
          is Ok (serial) -> gvr-mixed-run v serial
  opening : [Console] Nothing = act
    gvr-gold 0
    gvr-mixed 0
  end
