Chapter: WorldTimersProof
  cites Uoaix chapter WorldTimers
  cites Foreword chapter Console
  cites Foreword chapter Result

  wtp-check : Text, Boolean -> [Console] Integer
  wtp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  wtp-drain : WorldTimers, Integer, Integer -> Integer
  wtp-drain (w) (tick) (n) = if wtm-next w tick < 0 then n else wtp-drain w tick (n + 1)
  wtp-seed : WorldTimers, Integer -> Integer
  wtp-seed (w) (p) = if p > w.capacity then 0 else let e = wtm-add w p 1 p in wtp-seed w (p + 1)
  wtp-fire : WorldTimers, Integer, Integer -> Integer
  wtp-fire (w) (tick) (n) = if wtm-next w tick < 0 then n
    else let again = wtm-add w (tick + w.key) 1 w.key in wtp-fire w tick (n + 1)
  wtp-run : WorldTimers, Integer, Integer, Integer -> Integer
  wtp-run (w) (tick) (last) (n) = if tick > last then n else wtp-run w (tick + 1) last (wtp-fire w tick n)
  wtp-expected : Integer, Integer, Integer -> Integer
  wtp-expected (p) (top) (last) = if p > top then 0 else last / p + wtp-expected (p + 1) top last

  wtp-cases : WorldTimers -> [Console] Integer
  wtp-cases (w) = act
    a <- wtm-add w 10 1 7
    early <- wtm-next w 9
    due <- wtm-next w 10
    kind <- w.kind
    key <- w.key
    again <- wtm-next w 10
    c1 <- wtp-check "timer fires once at its deadline tick with its kind and key" (a >= 0 & early < 0 & due == a & kind == 1 & key == 7 & again < 0 & w.used == 0)
    s1 <- wtm-set w 20 2 5
    s2 <- wtm-set w 40 2 5
    one <- w.used
    none <- wtm-next w 30
    fired <- wtm-next w 40
    replaced <- w.key
    armed <- wtm-set w 50 3 9
    cleared <- wtm-clear w 3 9
    absent <- wtm-clear w 3 9
    quiet <- wtm-next w 100
    c2 <- wtp-check "set replaces the pending timer for its key and clear removes it" (one == 1 & none < 0 & fired >= 0 & replaced == 5 & armed >= 0 & cleared == 1 & absent == 0 & quiet < 0 & w.used == 0)
    f1 <- wtm-add w 200 1 1
    f2 <- wtm-add w 200 1 2
    f3 <- wtm-add w 200 1 3
    f4 <- wtm-add w 200 1 4
    over <- wtm-add w 200 1 5
    first <- wtm-next w 200
    reused <- wtm-add w 300 1 6
    rest <- wtp-drain w 300 0
    c3 <- wtp-check "a full wheel refuses and a fired entry is reused" (f1 >= 0 & f2 >= 0 & f3 >= 0 & f4 >= 0 & over < 0 & first >= 0 & reused == first & rest == 4 & w.used == 0)
    g1 <- wtm-add w 305 1 1
    g2 <- wtm-add w 600 1 2
    g3 <- wtm-add w 4000 1 3
    g4 <- wtm-add w 6000 1 4
    gap <- wtp-drain w 5000 0
    left <- w.used
    late <- wtp-drain w 6000 0
    c4 <- wtp-check "a drain across many revolutions fires every due entry and keeps later ones" (g1 >= 0 & g2 >= 0 & g3 >= 0 & g4 >= 0 & gap == 3 & left == 1 & late == 1 & w.used == 0)
    past <- wtm-add w 50 1 8
    moved <- wtm-get w past 0
    held <- wtm-next w 6000
    caught <- wtm-next w 6001
    d1 <- wtm-add w 6010 1 1
    d2 <- wtm-add w 6010 1 2
    one-of <- wtm-next w 6010
    inside <- wtm-add w 6005 1 3
    other <- wtm-next w 6010
    after <- wtm-next w 6010
    next-tick <- wtm-next w 6011
    late-key <- w.key
    c5 <- wtp-check "a past deadline and an add during a drain fire on the next tick, never inside the drain" (moved == 6001 & held < 0 & caught == past & d1 >= 0 & d2 >= 0 & one-of >= 0 & inside >= 0 & other >= 0 & after < 0 & next-tick == inside & late-key == 3 & w.used == 0)
    free-kind <- wtm-add w 7000 0 1
    free-clear <- wtm-clear w 0 1
    c6 <- wtp-check "kind 0 is refused because it marks a free entry" (free-kind < 0 & free-clear == 0 & w.used == 0)
    c1 + c2 + c3 + c4 + c5 + c6
  end

  wtp-flat : WorldTimers -> [Console] Integer
  wtp-flat (w) = act
    seeded <- wtp-seed w 1
    warm <- wtp-run w 1 2000 0
    mark <- __heap-save
    fires <- wtp-run w 2001 40000 0
    growth <- __heap-save - mark
    expected <- wtp-expected 1 64 40000 - wtp-expected 1 64 2000
    print-line-uni ("world timers 64 periodic over 38000 ticks fires=" & show fires & " expected=" & show expected & " heap-bytes=" & show growth)
    wtp-check "64 periodic timers over 38000 ticks fire exactly and retain no heap" (warm == wtp-expected 1 64 2000 & fires == expected & growth == 0 & w.used == 64)
  end

  wtp-bounds : Integer -> [Console] Integer
  wtp-bounds (unused) = wtp-check "construction refuses an empty pool, an empty wheel and a negative clock" (is-err (wtm-new 0 16 0) & is-err (wtm-new 4 0 0) & is-err (wtm-new 4 16 -1))

  opening : [Console] Integer = when wtm-new 4 16 0
    is Err (e) -> act
      print-line-uni ("FAIL wheel " & e)
      1
    end
    is Ok (small) -> when wtm-new 64 256 0
      is Err (e) -> act
        print-line-uni ("FAIL wheel " & e)
        1
      end
      is Ok (large) -> act
        cases <- wtp-cases small
        flat <- wtp-flat large
        bounds <- wtp-bounds 0
        print-line-uni ("UOAIX WORLD TIMERS failures=" & show (cases + flat + bounds))
        cases + flat + bounds
      end
