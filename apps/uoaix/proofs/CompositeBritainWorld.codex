Chapter: CompositeBritainWorld
  cites Uoaix chapter CompositeStore
  cites Uoaix chapter CompositeLineup

  cbw-check : Text, Boolean -> [Console] Integer
  cbw-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  cbw-fill : WalkMap, Integer -> Integer
  cbw-fill (map) (i) = if i == map.width * map.height then 0
    else let mark = __heap-save
    in let result = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in cbw-fill map (i + 1)
  cbw-create : Integer -> List Integer
  cbw-create (unused) = let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let name = gp-ascii (gp-ascii header "Citizen" 0 30) "" 0 30
    in let stats = name & [0,30,20,15,3,50,11,30,45,20]
    in gp-put32 (gp-put16 (gp-zeros (gp-put16 stats 1002) 12) 0) 0
  cbw-data : Integer -> Integer
  cbw-data (unused) = let data = alloc-bytes 240
    in let clear = wd-zero data 0 240
    in let a = poke-qword data 0 #31445744
    in let b = poke-qword data 8 1
    in let c = poke-qword data 32 6144
    in let d = poke-qword data 40 4096
    in let e = poke-qword data 48 42
    in let x = poke-qword data 64 1419
    in let y = poke-qword data 72 1690
    in let art = poke-qword data 88 #0675
    in let flags = poke-qword data 104 64
    in let height = poke-qword data 112 20
    in let kind = poke-qword data 120 1
    in let opened = poke-qword data 128 #0676
    in let dx = poke-qword data 136 1
    in let light = poke-qword data 152 -1 in data
  cbw-find : List (List Integer), Integer, Integer -> List Integer
  cbw-find (packets) (op) (i) = if i == list-length packets then []
    else let packet = list-at packets i
    in if list-length packet > 0 & list-at packet 0 == op then packet else cbw-find packets op (i + 1)
  cbw-first-stock : GameShard, GvPlayer, Integer, Integer -> Integer
  cbw-first-stock (game) (p) (stock) (i) = if i == p.count then 0
    else let q = list-at p.offers i
    in when world-get game.world q.serial
      is Err (_) -> cbw-first-stock game p stock (i + 1)
      is Ok (item) -> if item.container == stock then q.serial else cbw-first-stock game p stock (i + 1)
  cbw-label : Result GameReply Text, Text -> Boolean
  cbw-label (reply) (name) = when reply
    is Err (_) -> False
    is Ok (r) -> let packet = cbw-find r.packets #1C 0
      in list-length packet >= 44 & list-at packet 9 == 6
        & utf8-bytes-to-text (list-take (list-drop packet 14) (text-length name)) == name
        & utf8-bytes-to-text (list-take (list-drop packet 44) (text-length name)) == name
  cbw-shop : CompositeOwner, WalkMap, GameInput, Integer, Integer -> [Console, Device.Block] Integer
  cbw-shop (store) (map) (input) (i) (stop) = if i == stop then act 0 end
    else let owner = store.state
    in let v = owner.vendor
    in let game = owner.checkpoint.game
    in let shop = list-at v.vendors i
    in let player = list-at v.players 0
    in when world-get game.world shop.serial
      is Err (e) -> cbw-check ("shop npc " & e) False
      is Ok (npc) -> act
        near <- when world-get game.world player.serial is Err (e) -> Err e is Ok (m) -> world-update game.world (__record-set (__record-set (__record-set m "x" npc.x) "y" (npc.y + 1)) "z" npc.z)
        named <- cs-route store game input map 2593 (gp-put32 [9] npc.serial)
        menu <- cs-route store game input map 2593 (gp-put32 [6] npc.serial)
        packets <- when menu is Err (_) -> [] is Ok (r) -> r.packets
        contents <- cbw-find packets #3C 0
        count <- if list-length contents < 5 then 0 else gp-u16 contents 3
        first <- cbw-first-stock game player shop.stock 0
        ordered <- count > 0 & gp-u16 contents 14 == count & gp-u32 contents (5 + (count - 1) * 19) == first & gp-u16 contents (5 + (count - 1) * 19 + 9) == 1
        before <- v.sale-count
        bought <- cs-route store game input map 2593 (gp-put16 (gp-put32 (list-push (list-push (gp-put32 [59,0,15] npc.serial) 2) 26) first) 1)
        delivered <- if v.sale-count == before + 1 then (list-at v.sales before).delivered else 0
        selling <- cs-route store game input map 2593 (gp-ascii [3,0,13,0,3,178,0,3] "sell" 0 5)
        sold <- cs-route store game input map 2593 (gp-put16 (gp-put32 (gp-put16 (gp-put32 [159,0,15] npc.serial) 1) delivered) 1)
        print-line-uni ("BRITAIN shop " & (list-at bb-shops (int-mod i bb-shop-count)).title & " at " & show npc.x & "," & show npc.y & " rows=" & show count & " sales=" & show v.sale-count)
        ok <- cbw-check ("composite shop " & (list-at bb-shops (int-mod i bb-shop-count)).title & " names, orders its buy menu, buys and sells") (is-ok near & cbw-label named (list-at bb-shops (int-mod i bb-shop-count)).title & ordered & is-ok bought & delivered > 0 & is-ok sold & v.sale-count == before + 2 & euv-valid v.currency)
        rest <- cbw-shop store map input (i + 1) stop
        ok + rest
      end
  cbw-spoke : List (List Integer), Integer, Integer -> Boolean
  cbw-spoke (packets) (serial) (i) = if i == list-length packets then False
    else let p = list-at packets i
    in (list-length p > 7 & list-at p 0 == #1C & gp-u32 p 3 == serial) | cbw-spoke packets serial (i + 1)
  cbw-fixtures : GameCombat, Integer, Integer -> Integer
  cbw-fixtures (c) (i) (n) = if i == list-length c.actors then n
    else cbw-fixtures c (i + 1) (if cgl-fixture (list-at c.actors i) then n + 1 else n)
  cbw-in-row : GvWorld, WorldTable, Integer -> Boolean
  cbw-in-row (v) (world) (k) = if k == bb-shop-count then True
    else when world-get world (list-at v.vendors (bb-shop-count + k)).serial
      is Err (_) -> False
      is Ok (npc) -> npc.x == cgl-x + k & (npc.y == cgl-y | npc.y == cgl-y + 1) & cbw-in-row v world (k + 1)
  cbw-lineup : CompositeOwner, WalkMap, GameInput -> [Console, Device.Block] Integer
  cbw-lineup (store) (map) (input) = let owner = store.state in act
    game <- owner.checkpoint.game
    player <- list-at owner.vendor.players 0
    spar <- __record-set owner.combat "scene" 1
    moved <- when world-get game.world player.serial is Err (e) -> Err e is Ok (m) -> world-update game.world (__record-set (__record-set m "x" 1430) "y" 1700)
    spawned <- cb-fixture owner.combat game input map 0 0
    before <- cbw-fixtures owner.combat 0 0
    lined <- cgl-arrange owner True
    after <- cbw-fixtures owner.combat 0 0
    print-line-uni ("BRITAIN lineup fixtures " & show before & " -> " & show after & " vendors=" & show owner.vendor.vendor-count & " bankers=" & show owner.banks.count & " arrange=" & (when lined is Err (e) -> e is Ok (_) -> "ok") & " stations=" & show owner.vendor.currency.world.station-count & " nodes=" & show owner.vendor.currency.world.node-count & " lots=" & show owner.vendor.lot-count & " actors=" & show owner.vendor.currency.world.actor-count & " treasury=" & show (em-purse owner.vendor.currency.world.money 1).coin)
    removed <- cbw-check "a testing boot removes the sparring partner and veteran opponent and stops their scene" (before == 2 & after == 0 & owner.combat.scene == 2 & is-ok lined)
    placed <- cbw-check "six trading shopkeeper copies stand in the bank row" (owner.vendor.vendor-count == 2 * bb-shop-count & cbw-in-row owner.vendor game.world 0 & gvsc-valid owner.vendor)
    shops <- cbw-shop store map input bb-shop-count (2 * bb-shop-count)
    l <- when owner.lineup is None -> CglLineup { resident = 0, banker = 0, person = 0, inside = 0, speaker = 0, last = 0 } is Just (x) -> x
    teller <- when world-get game.world l.banker
      is Err (e) -> Err e
      is Ok (npc) -> when world-get game.world player.serial
        is Err (e) -> Err e
        is Ok (m) -> world-update game.world (__record-set (__record-set (__record-set m "x" (npc.x - 1)) "y" npc.y) "z" npc.z)
    bank <- cs-route store game input map 2593 (gp-ascii [3,0,13,0,3,178,0,3] "bank" 0 5)
    teller-name <- cs-route store game input map 2593 (gp-put32 [9] l.banker)
    banked <- cbw-check "the banker copy names itself and opens the bank" (l.banker /= 0 & is-ok teller & (when bank is Err (_) -> False is Ok (r) -> r.note == "bank:open")
      & cbw-label teller-name "Banker")
    resident <- when world-get game.world l.resident
      is Err (e) -> Err e
      is Ok (npc) -> when world-get game.world player.serial
        is Err (e) -> Err e
        is Ok (m) -> world-update game.world (__record-set (__record-set (__record-set m "x" npc.x) "y" (npc.y + 1)) "z" npc.z)
    named <- cs-route store game input map 2593 (gp-put32 [9] l.resident)
    greeted <- cs-pulse store game input map 2593 2102000
    greeting <- cbw-check "the resident copy answers its name and greets on approach" (l.resident /= 0 & is-ok resident
      & (when owner.town is None -> False is Just (t) -> cbw-label named (tf-person t.people l.person).name)
      & (when greeted is Err (_) -> False is Ok (None) -> False is Ok (Just (r)) -> cbw-spoke r.packets l.resident 0))
    removed + placed + shops + banked + greeting
  end
  cbw-inn-clear : CompositeGame -> Boolean
  cbw-inn-clear (owner) = when owner.town
    is None -> False
    is Just (t) -> when world-get owner.checkpoint.game.world (list-at owner.vendor.vendors 5).serial
      is Err (_) -> False
      is Ok (inn) -> inn.x >= 1493 & inn.x <= 1498 & inn.y >= 1610 & inn.y <= 1617
        & cbw-homes-clear t inn 0
  cbw-homes-clear : TownLive, WorldObject, Integer -> Boolean
  cbw-homes-clear (t) (inn) (i) = if i == t.count then True
    else let home = (list-at t.residents i).home
    in not (home.x == inn.x & home.y == inn.y) & cbw-homes-clear t inn (i + 1)
  cbw-door-open : WalkMap -> Boolean
  cbw-door-open (map) = is-ok (walk-height map 1419 1690 0)
  cbw-doors : CompositeOwner, WalkMap, GameInput, List GameOpcodeSpec -> [Console, Device.Block] Integer
  cbw-doors (store) (map) (input) (specs) = let owner = store.state in when owner.town-doors
    is None -> cbw-check "townsfolk doors bound" False
    is Just (doors) -> when owner.town-map
      is None -> cbw-check "townsfolk map bound" False
      is Just (britain) -> act
        game <- owner.checkpoint.game
        closed-both <- not (cbw-door-open britain) & not (cbw-door-open map)
        armed-before <- owner.timers.used
        toggled <- wd-toggle doors game 0
        packets <- when toggled is Err (_) -> [] is Ok (r) -> r.packets
        synced <- cg-door-sync owner packets 0
        print-line-uni ("BRITAIN door closed-both=" & (if closed-both then "1" else "0") & " toggled=" & (when toggled is Err (e) -> e is Ok (r) -> r.note) & " packets=" & show (list-length packets) & " britain-open=" & (if cbw-door-open britain then "1" else "0") & " map-open=" & (if cbw-door-open map then "1" else "0") & " timers=" & show armed-before & "->" & show owner.timers.used & " bit=" & show (peek-byte doors.opened 0))
        a <- cbw-check "a resident opening a door updates the player's map and arms autoclose" (closed-both & is-ok toggled & cbw-door-open britain & cbw-door-open map & owner.timers.used == armed-before + 1)
        player <- list-at owner.vendor.players 0
        near <- when world-get game.world player.serial is Err (e) -> Err e is Ok (m) -> world-update game.world (__record-set (__record-set m "x" 1421) "y" 1691)
        shut <- cs-route store game input map 2593 [6,#7E,0,0,1]
        b <- cbw-check "the player closing that door updates the residents' map and clears autoclose" (is-ok near & is-ok shut & not (cbw-door-open britain) & not (cbw-door-open map) & owner.timers.used == armed-before)
        reopened <- wd-toggle doors game 0
        again <- cg-door-sync owner (when reopened is Err (_) -> [] is Ok (r) -> r.packets) 0
        a + b
      end
  cbw-cover : WalkMap, Integer, Integer, Integer -> [Device.Block] Result WalkMap Text
  cbw-cover (map) (x) (y) (z) = act
    if walk-cell map x y < 0 then Err "fixture destination outside map" else Ok map
  end
  cbw-actors : TownLive, Integer, Integer -> Integer
  cbw-actors (town) (i) (sum) = if i == town.count then sum else cbw-actors town (i + 1) (sum * 131 + (list-at town.residents i).actor)
  cbw-town : CompositeGame -> Integer
  cbw-town (owner) = when owner.town is None -> -1 is Just (town) -> town.count
  cbw-signature : CompositeGame -> Integer
  cbw-signature (owner) = when owner.town is None -> -1 is Just (town) -> cbw-actors town 0 7

  cbw-npc : CompositeGame, Integer -> WorldObject
  cbw-npc (owner) (i) = when owner.town
    is None -> gs-item 0 0 0
    is Just (town) -> when world-get owner.checkpoint.game.world (tf-person town.people (list-at town.residents i).person).world-serial
      is Err (_) -> gs-item 0 0 0
      is Ok (m) -> m
  cbw-where : CompositeGame, Integer, Integer -> Integer
  cbw-where (owner) (i) (sum) = if i == 3 then sum else let m = cbw-npc owner i in cbw-where owner (i + 1) (sum * 8191 + m.x * 4096 + m.y)
  cbw-pulses : CompositeOwner, GameInput, WalkMap, Integer, Integer, Integer -> [Console, Device.Block] Integer
  cbw-pulses (store) (input) (map) (tick) (left) (moves) = if left == 0 then act moves end
    else act
      pulsed <- cs-pulse store store.state.checkpoint.game input map 2593 tick
      count <- when pulsed is Err (_) -> -100000 is Ok (None) -> 0 is Ok (Just (r)) -> list-length r.packets
      cbw-pulses store input map (tick + 100) (left - 1) (if count < 0 then -100000 else moves + count)
    end
  cbw-net : CompositeGame -> Text
  cbw-net (owner) = when owner.network
    is None -> "network=none"
    is Just (n) -> "sequence=" & show n.actions.book.sequence & " events=" & show n.actions.book.event-count
      & " thoughts=" & show ((list-at n.agents 0).thoughts + (list-at n.agents 1).thoughts + (list-at n.agents 2).thoughts)
      & " currency-rows=" & show n.actions.town.vendors.currency.count & " economy-hour=" & show n.actions.book.world.hour
  cbw-sequence : CompositeGame -> Integer
  cbw-sequence (owner) = when owner.network is None -> -1 is Just (n) -> n.actions.book.sequence
  cbw-events : CompositeGame -> Integer
  cbw-events (owner) = when owner.network is None -> 2000 is Just (n) -> n.actions.book.event-count
  cbw-stamp : EaWorld, Integer -> Integer
  cbw-stamp (e) (i) = if i == 1000 then 0 else let row = __record-set (list-at e.events i) "sequence" (5000 + i) in cbw-stamp e (i + 1)
  cbw-ordered : EaWorld, Integer -> Integer
  cbw-ordered (e) (i) = if i == 512 then 512 else if (list-at e.events i).sequence /= 5488 + i then i else cbw-ordered e (i + 1)
  cbw-rotation : CompositeGame -> Text
  cbw-rotation (owner) = when owner.network
    is None -> "no network"
    is Just (n) -> let e = n.actions.book
      in let stamped = cbw-stamp e 0
      in let full = __record-set e "event-count" 1000
      in let dropped = cg-rotate e
      in let again = cg-rotate e
      in "dropped=" & show dropped & " again=" & show again & " count=" & show e.event-count & " newest-in-order=" & show (cbw-ordered e 0)
  cbw-has : List (List Integer), Integer, Integer -> Boolean
  cbw-has (packets) (op) (i) = if i == list-length packets then False
    else (list-length (list-at packets i) > 0 & list-at (list-at packets i) 0 == op) | cbw-has packets op (i + 1)
  cbw-first : CompositeOwner, WdState, WalkMap, List GameOpcodeSpec -> [Console, Device.Block] Integer
  cbw-first (store) (decoration) (map) (specs) = let owner = store.state in act
    founded <- cbw-check "fresh Britain world populates six shops and three residents" (owner.vendor.vendor-count == 6 & cbw-town owner == 3)
    magic <- mgs-new owner.items owner.banks owner.combat decoration (Just owner.vendor) (cbw-cover map)
    hooked <- mge-bind magic
    attached <- __record-set owner "magic" (Just magic)
    enabled <- __record-set owner "testing" True
    input <- gn-input-with specs 1
    mode <- __record-set input "mode" 2
    phase <- __record-set input.session "phase" 1
    entry <- cs-route store owner.checkpoint.game input map 2593 (cbw-create 0)
    game <- owner.checkpoint.game
    player <- list-at owner.vendor.players 0
    pack <- gsi-pack-find game.world player.serial 0
    bag <- gsi-child-art game.world (world-first-child game.world pack) #0E76 0
    book <- gsi-child-art game.world (world-first-child game.world bag) #0EFA 0
    stocked <- cbw-check "Britain world entry keeps the testing kit, magery and decoration" (is-ok entry & bag > 0 & book > 0 & mgs-known magic book & is-ok (wd-solid decoration 0))
    placed <- cbw-where owner 0 7
    moves <- cbw-pulses store input map 1000 400 0
    walked <- cbw-where owner 0 7
    print-line-uni ("BRITAIN seconds=" & show owner.town-seconds & " pulse-packets=" & show moves)
    clocked <- cbw-check "pulses advance the town clock at twelve game seconds per real second and residents walk" (moves >= 0 & owner.town-seconds >= 4600 & owner.town-seconds <= 4800 & walked /= placed)
    nell <- cbw-npc owner 0
    near <- when world-get game.world player.serial is Err (e) -> Err e is Ok (m) -> world-update game.world (__record-set (__record-set m "x" nell.x) "y" (nell.y + 1))
    named <- cs-route store game input map 2593 (gp-put32 [9] nell.serial)
    greeted <- cs-pulse store game input map 2593 41000
    talk <- cbw-check "the 09 handler names a resident and approach brings a greeting" (is-ok near & (when named is Err (_) -> False is Ok (r) -> cbw-has r.packets #1C 0)
      & (when greeted is Err (_) -> False is Ok (None) -> False is Ok (Just (r)) -> cbw-has r.packets #1C 0))
    first-hours <- cbw-sequence owner
    print-line-uni ("BRITAIN early " & cbw-net owner)
    long <- cbw-pulses store input map 42000 20000 0
    print-line-uni ("BRITAIN played " & cbw-net owner & " clock=" & show owner.town-seconds)
    driven <- cbw-check "the frozen network drives residents for 66 game hours and the audit book rotates within bounds" (long >= 0 & first-hours >= 0 & cbw-sequence owner > 960 & cbw-events owner <= 960 & cbw-events owner < cbw-sequence owner)
    doored <- cbw-doors store map input specs
    shopped <- cbw-shop store map input 0 bb-shop-count
    inn <- cbw-check "the innkeeper stands in the Sweet Dreams Inn off every resident's bed" (cbw-inn-clear owner)
    lineup <- cbw-lineup store map input
    resident-label <- cbw-check "a resident single-click returns a name label" (when owner.town is None -> False is Just (t) -> cbw-label named (tf-person t.people (list-at t.residents 0).person).name)
    committed <- cs-commit store True
    print-line-uni ("BRITAIN objects=" & show (world-count game.world) & " residents=" & show (cbw-signature owner))
    print-line-uni ("BRITAIN clock=" & show owner.town-seconds & " where=" & show (cbw-where owner 0 7) & " " & cbw-net owner)
    saved <- cbw-check "Britain world commits its townsfolk section" (is-ok committed)
    rotation <- cbw-rotation owner
    print-line-uni ("BRITAIN rotate " & rotation)
    rotated <- cbw-check "a full audit book rotates to its newest 512 events" (rotation == "dropped=488 again=0 count=512 newest-in-order=512")
    founded + stocked + clocked + talk + driven + doored + shopped + inn + lineup + resident-label + saved + rotated
  end
  cbw-later : CompositeOwner, WdState -> [Console, Device.Block] Integer
  cbw-later (store) (decoration) = let owner = store.state in act
    print-line-uni ("BRITAIN objects=" & show (world-count owner.checkpoint.game.world) & " residents=" & show (cbw-signature owner))
    print-line-uni ("BRITAIN clock=" & show owner.town-seconds & " where=" & show (cbw-where owner 0 7) & " " & cbw-net owner)
    restored <- cbw-check "restart restores the residents without populating again" (cbw-town owner == 3 & (owner.vendor.vendor-count == bb-shop-count | owner.vendor.vendor-count == 2 * bb-shop-count))
    door <- cbw-check "restart rebuilds the residents' map with the saved open door" (when owner.town-map is None -> False is Just (britain) -> cbw-door-open britain)
    blind <- cs-load-config store.store (CompositeSetup { vendor-z = 0, shrine-z = 0, home-z = 0, decoration = Just decoration })
    refused <- cbw-check "a townsfolk world loaded without the Britain map refuses" (is-err blind)
    restored + door + refused
  end

  opening : [Console, Device.Block] Integer = when cg-specs 0
    is Err (e) -> cbw-check ("registry " & e) False
    is Ok (specs) -> when walk-map-new 1408 1680 64 64
     is Err (e) -> cbw-check e False
     is Ok (map) -> when walk-map-new 1408 1536 96 160
      is Err (e) -> cbw-check e False
      is Ok (britain) -> let filled = cbw-fill map 0
       in let town-filled = cbw-fill britain 0
       in let data = cbw-data 0
       in when wd-read data 240 map map.stride
        is Err (e) -> cbw-check e False
        is Ok (decoration) -> act
     opened <- us-open 0 131072
     when opened
      is Err (e) -> cbw-check ("store " & e) False
      is Ok (store) -> let fresh = store.head == 0 in act
       loaded <- cs-load-town store (CompositeSetup { vendor-z = 0, shrine-z = 0, home-z = 0, decoration = Just decoration }) (Just britain)
       when loaded
        is Err (e) -> cbw-check ("recovery " & e) False
        is Ok (owner) -> when cg-town-doors owner.state data 240
         is Err (e) -> cbw-check ("town doors " & e) False
         is Ok (_) -> if fresh then cbw-first owner decoration map specs else cbw-later owner decoration
      end
    end
