Chapter: BritishCharacterProof
  cites Uoaix chapter CompositeStore

  bcp-check : Text, Boolean -> [Console] Integer
  bcp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  bcp-fill : WalkMap, Integer -> Integer
  bcp-fill (map) (i) = if i == map.width * map.height then 0
    else let mark = __heap-save
    in let result = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in bcp-fill map (i + 1)
  bcp-named : Integer, List Integer, Integer -> Boolean
  bcp-named (row) (name) (i) = if i == list-length name then peek-byte row (18 + i) == 0
    else peek-byte row (18 + i) == list-at name i & bcp-named row name (i + 1)
  bcp-slot : CompositeGame -> Integer
  bcp-slot (owner) = let table = owner.checkpoint.game.accounts
    in let index = ga-british table
    in if index < 0 then 0 else ga-slots table index
  bcp-british : CompositeGame -> Integer
  bcp-british (owner) = let row = bcp-slot owner in if row == 0 then 0 else peek-qword row 0
  bcp-state : CompositeGame, Text -> [Console] Integer
  bcp-state (owner) (tag) = let serial = bcp-british owner
    in act
      print-line-uni ("BRITISH " & tag & " serial=" & show serial & " objects=" & show (world-count owner.checkpoint.game.world) & " bound=" & show (ga-bound owner.checkpoint.game.accounts))
      0
    end
  bcp-costumed : CompositeGame, Integer -> Boolean
  bcp-costumed (owner) (serial) = let robe = gmb-layer owner.items serial cst-british-layer 0
    in robe > 0 & (when world-get owner.checkpoint.game.world serial is Err (_) -> False is Ok (m) -> m.graphic == 400)
      & (when world-get owner.checkpoint.game.world robe is Err (_) -> False is Ok (o) -> o.graphic == #2042)
  bcp-first : CompositeOwner, WalkMap -> [Console, Device.Block] Integer
  bcp-first (store) (map) = let owner = store.state in act
    before <- world-count owner.checkpoint.game.world
    bound <- ga-bound owner.checkpoint.game.accounts
    made <- cg-british-character owner map
    serial <- bcp-british owner
    a <- bcp-check "a new world's British account gains a character named British in slot 0" ((when made is Err (_) -> False is Ok (n) -> n == 1)
      & serial > 0 & bcp-named (bcp-slot owner) [66,114,105,116,105,115,104] 0
      & (when world-get owner.checkpoint.game.world serial is Err (_) -> False is Ok (m) -> m.kind == 1)
      & ga-bound owner.checkpoint.game.accounts == bound & owner.checkpoint.game.active == 0)
    count <- world-count owner.checkpoint.game.world
    again <- cg-british-character owner map
    b <- bcp-check "a second call finds the character and creates nothing" ((when again is Err (_) -> False is Ok (n) -> n == 0) & world-count owner.checkpoint.game.world == count & count > before)
    e <- bcp-check "British is body 400 wearing his costume 0x2042 on layer 22, and a body from 400 up swings and is hit as a human" (bcp-costumed owner serial
      & cb-swing-action 990 1 == 9 & cb-hurt-action 990 == 20)
    committed <- cs-commit store True
    c <- bcp-check "the world commits" (is-ok committed)
    d <- bcp-state owner "first"
    a + b + e + c + d
  end
  bcp-later : CompositeOwner, WalkMap -> [Console, Device.Block] Integer
  bcp-later (store) (map) = let owner = store.state in act
    serial <- bcp-british owner
    count <- world-count owner.checkpoint.game.world
    again <- cg-british-character owner map
    a <- bcp-check "after a restart British is still in slot 0 and boot creates no second one" (serial > 0
      & (when world-get owner.checkpoint.game.world serial is Err (_) -> False is Ok (m) -> m.kind == 1)
      & (when again is Err (_) -> False is Ok (n) -> n == 0) & world-count owner.checkpoint.game.world == count)
    e <- bcp-check "after a restart British keeps body 400 and his costume, and boot adds no second costume" (bcp-costumed owner serial)
    b <- bcp-state owner "later"
    c <- bcp-elsewhere owner map serial
    a + e + b + c
  end
  bcp-elsewhere : CompositeGame, WalkMap, Integer -> [Console] Integer
  bcp-elsewhere (owner) (map) (other) = let game = owner.checkpoint.game in act
    bound <- ga-bind game.accounts game.characters (ga-british game.accounts)
    renamed <- poke-byte game.characters 18 88
    before <- world-count game.world
    made <- cg-british-character owner map
    row <- bcp-slot owner
    a <- bcp-check "an account whose slots hold no British gains one in the first empty slot, slot 0 left alone" ((when made is Err (_) -> False is Ok (n) -> n == 2)
      & peek-qword row 0 == other & peek-qword row 160 > 0 & bcp-named (row + 160) [66,114,105,116,105,115,104] 0
      & (when world-get game.world (peek-qword row 160) is Err (_) -> False is Ok (m) -> m.kind == 1) & world-count game.world > before)
    count <- world-count game.world
    again <- cg-british-character owner map
    b <- bcp-check "British in slot 1 is found and nothing more is created" ((when again is Err (_) -> False is Ok (n) -> n == 0) & world-count game.world == count)
    a + b
  end

  opening : [Console, Device.Block] Integer = when walk-map-new 1408 1536 96 208
    is Err (e) -> bcp-check e False
    is Ok (map) -> when walk-map-new 1408 1536 96 160
     is Err (e) -> bcp-check e False
     is Ok (britain) -> let filled = bcp-fill map 0 in let town-filled = bcp-fill britain 0 in act
      opened <- us-open 0 131072
      when opened
        is Err (e) -> bcp-check ("store " & e) False
        is Ok (store) -> let fresh = store.head == 0 in act
          loaded <- cs-load-town store (CompositeSetup { vendor-z = 0, shrine-z = 0, home-z = 0, decoration = None }) (Just britain) None
          when loaded
            is Err (e) -> bcp-check ("recovery " & e) False
            is Ok (owner) -> if fresh then bcp-first owner map else bcp-later owner map
        end
    end

