Chapter: CompositeMageryRestart
  cites Uoaix chapter CompositeStore

  cmr-check : Text, Boolean -> [Console] Integer
  cmr-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  cmr-fill : WalkMap, Integer -> Integer
  cmr-fill (map) (i) = if i == map.width * map.height then 0
    else let mark = __heap-save
    in let result = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in cmr-fill map (i + 1)
  cmr-create : Integer -> List Integer
  cmr-create (unused) = let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let name = gp-ascii (gp-ascii header "Mage" 0 30) "" 0 30
    in let stats = name & [0,30,20,15,3,50,11,30,45,20]
    in gp-put32 (gp-put16 (gp-zeros (gp-put16 stats 1002) 12) 0) 0
  cmr-decoration : WalkMap -> Result WdState Text
  cmr-decoration (map) = let data = alloc-bytes 240
    in let clear = wd-zero data 0 240
    in let a = poke-qword data 0 #31445744
    in let b = poke-qword data 8 1
    in let c = poke-qword data 32 6144
    in let d = poke-qword data 40 4096
    in let e = poke-qword data 48 42
    in let x = poke-qword data 64 1419
    in let y = poke-qword data 72 1699
    in let art = poke-qword data 88 #0675
    in let flags = poke-qword data 104 64
    in let height = poke-qword data 112 20
    in let kind = poke-qword data 120 1
    in let opened = poke-qword data 128 #0676
    in let dx = poke-qword data 136 1
    in let light = poke-qword data 152 -1
    in wd-read data 240 map map.stride
  cmr-cover : WalkMap, Integer, Integer, Integer -> [Device.Block] Result WalkMap Text
  cmr-cover (map) (x) (y) (z) = act
    if walk-cell map x y < 0 then Err "fixture destination outside map" else Ok map
  end
  cmr-attach : CompositeOwner, WdState, WalkMap -> Result Magery Text
  cmr-attach (store) (decoration) (map) = let owner = store.state
    in let magic = mgs-new owner.items owner.banks owner.combat decoration (Just owner.vendor) (cmr-cover map)
    in let hooked = mge-bind magic
    in let attached = __record-set owner "magic" (Just magic)
    in when cc-magic-restore owner magic
      is Err (e) -> Err e
      is Ok (_) -> Ok magic
  cmr-find : WorldTable, Integer, Integer -> Integer
  cmr-find (world) (serial) (graphic) = if serial == 0 then 0
    else when world-get world serial
      is Err (_) -> cmr-find world (world-next-sibling world serial) graphic
      is Ok (item) -> if item.graphic == graphic then serial else cmr-find world (world-next-sibling world serial) graphic
  cmr-own-book : Magery, WorldTable, Integer, Integer -> Integer
  cmr-own-book (magic) (world) (serial) (mask) = if serial == 0 then 0
    else let meta = list-at magic.definitions (world-slot world serial)
    in if meta.serial == serial & meta.spells == mask then serial
    else cmr-own-book magic world (world-next-sibling world serial) mask
 The testing entry in boot1 fills every carried spellbook with every working spell (cg-books), so the restored book
 holds mgs-working rather than the #3F it was registered with.
  cmr-state : Magery, CompositeGame, Integer, Integer -> Boolean
  cmr-state (magic) (owner) (mana) (mask) = let player = list-at owner.vendor.players 0
    in let game = owner.checkpoint.game
    in let actor = list-at magic.actors (world-slot game.world player.serial)
    in let book = cmr-own-book magic game.world (world-first-child game.world player.pack) mask
    in let rune = cmr-marked magic game.world (world-first-child game.world player.pack)
    in book > 0 & rune > 0 & actor.serial == player.serial & actor.mana == mana
  cmr-marked : Magery, WorldTable, Integer -> Integer
  cmr-marked (magic) (world) (serial) = if serial == 0 then 0
    else let meta = list-at magic.definitions (world-slot world serial)
    in if meta.serial == serial & meta.rune & meta.x == 1430 & meta.y == 1705 & meta.z == 0 then serial
    else cmr-marked magic world (world-next-sibling world serial)

  cmr-doll : Magery, Integer -> List Integer
  cmr-doll (magic) (serial) = mgp-rewrite magic (list-push (sip-field (gp-put32 (gp-start #88) serial) [77,97,103,101] 60 0) 0)
  cmr-named : List Integer, List Integer, Integer -> Boolean
  cmr-named (packet) (name) (i) = if i == list-length name then list-at packet (5 + i) == 0
    else list-at packet (5 + i) == list-at name i & cmr-named packet name (i + 1)
  cmr-hair : WorldTable, Integer -> WorldObject
  cmr-hair (world) (serial) = let hair = world-layer-serial world serial 11
    in if hair == 0 then gs-item 0 0 0 else when world-get world hair is Err (_) -> gs-item 0 0 0 is Ok (o) -> o
  cmr-disguised : Magery, GameShard, Integer -> Boolean
  cmr-disguised (magic) (game) (serial) = let actor = list-at magic.actors (world-slot game.world serial)
    in let hair = cmr-hair game.world serial
    in actor.serial == serial & actor.incognito > magic.tick & actor.inc-hue == 1002 & actor.inc-hair == #203C & actor.inc-hair-hue == 1110
      & actor.inc-name > 0 & cmr-named (cmr-doll magic serial) (text-to-utf8-bytes (mgi-name actor)) 0
      & (when world-get game.world serial is Err (_) -> False is Ok (m) -> m.hue >= 1002 & m.hue <= 1058)
      & hair.serial > 0 & (hair.graphic /= #203C | hair.hue /= 1110)
  cmr-plain : Magery, GameShard, Integer -> Boolean
  cmr-plain (magic) (game) (serial) = let actor = list-at magic.actors (world-slot game.world serial)
    in let hair = cmr-hair game.world serial
    in actor.incognito == 0 & actor.inc-name == 0 & cmr-named (cmr-doll magic serial) [77,97,103,101] 0
      & (when world-get game.world serial is Err (_) -> False is Ok (m) -> m.hue == 1002)
      & hair.graphic == #203C & hair.hue == 1110
  cmr-marked-at : Magery, WorldTable, Integer, Integer, Integer -> Integer
  cmr-marked-at (magic) (world) (serial) (x) (y) = if serial == 0 then 0
    else let meta = list-at magic.definitions (world-slot world serial)
    in if meta.serial == serial & meta.rune & meta.x == x & meta.y == y then serial
    else cmr-marked-at magic world (world-next-sibling world serial) x y
  cmr-kit : Magery, CompositeGame -> Boolean
  cmr-kit (magic) (owner) = let game = owner.checkpoint.game
    in let player = list-at owner.vendor.players 0
    in let pack = gsi-pack-find game.world player.serial 0
    in let rune = cmr-kit-rune magic game.world (world-first-child game.world pack)
    in if rune <= 0 then False
    else let meta = list-at magic.definitions (world-slot game.world rune)
    in meta.serial == rune & meta.rune & meta.x == 1420 & meta.y == 1698 & meta.z == 0
  cmr-kit-rune : Magery, WorldTable, Integer -> Integer
  cmr-kit-rune (magic) (world) (serial) = if serial == 0 then 0
    else let meta = list-at magic.definitions (world-slot world serial)
    in if meta.serial == serial & meta.rune & meta.x == 1420 & meta.y == 1698 then serial
    else cmr-kit-rune magic world (world-next-sibling world serial)
  cmr-blank : CompositeGame, Integer -> Result Integer Text
  cmr-blank (owner) (pack) = when world-create owner.checkpoint.game.world (gs-item pack #1F14 0)
    is Err (e) -> Err e
    is Ok (serial) -> if gsi-register owner.items serial 0 0 True False /= 0 then Err "blank rune registration" else Ok serial
  cmr-first : CompositeOwner, Magery, WalkMap, List GameOpcodeSpec -> [Console, Device.Block] Integer
  cmr-first (store) (magic) (map) (specs) = let owner = store.state in act
    input <- gn-input-with specs 1
    mode <- __record-set input "mode" 2
    phase <- __record-set input.session "phase" 1
    entry <- cs-route store owner.checkpoint.game input map 2593 (cmr-create 0)
    player <- list-at owner.vendor.players 0
    game <- owner.checkpoint.game
    book <- world-create game.world (gs-item player.pack #0EFA 0)
    rune <- world-create game.world (gs-item player.pack #1F14 0)
    marked <- when book
      is Err (e) -> Err e
      is Ok (b) -> when rune
        is Err (e) -> Err e
        is Ok (r) -> when mgs-book magic b #3F
          is Err (e) -> Err e
          is Ok (_) -> mgs-rune magic r 1430 1705 0
    actor <- mgs-ensure magic game player.serial
    drained <- when actor
      is Err (e) -> Err e
      is Ok (a) -> let spent = __record-set a "mana" 7
        in let touched = mgs-touch magic in Ok a.mana
    committed <- cs-commit store True
    a <- cmr-check "boot1 entry, spellbook, marked rune and spent mana commit" (is-ok entry & is-ok marked & is-ok drained & is-ok committed & cmr-state magic owner 7 #3F)
    unmarked <- not (cmr-kit magic owner)
    away <- when world-get game.world player.serial is Err (e) -> Err e is Ok (m) -> world-update game.world (__record-set (__record-set m "x" 1440) "y" 1712)
    blank <- cmr-blank owner player.pack
    enabled <- __record-set owner "testing" True
    stocked <- cg-entry owner game input map (gs-reply [] "testing entry")
    kit-saved <- cs-commit store True
    b <- cmr-check "boot1 testing kit rune is marked at 1420,1698, not where the character entered" (unmarked & is-ok away & is-ok stocked & is-ok kit-saved & cmr-kit magic owner)
    later <- cmr-blank owner player.pack
    again <- cg-entry owner game input map (gs-reply [] "testing re-entry")
    c <- cmr-check "boot1 a blank rune held at grant and one picked up later both stay unmarked" (is-ok again & cmr-kit magic owner
      & (when blank is Err (_) -> False is Ok (s) -> not (mgs-known magic s))
      & (when later is Err (_) -> False is Ok (s) -> not (mgs-known magic s)))
    haired <- gmb-clothe owner.items player.serial #203C 1110 11
    caster <- mgs-ensure magic game player.serial
    cast <- when caster
      is Err (e) -> Err e
      is Ok (a) -> when world-get game.world player.serial
        is Err (e) -> Err e
        is Ok (m) -> mgi-begin magic game a m 1000
    disguise-saved <- cs-commit store True
    disguised <- (when cast is Err (_) -> False is Ok (n) -> n == 121) & is-ok haired & is-ok disguise-saved & cmr-disguised magic game player.serial
    d <- cmr-check "boot1 Incognito disguises skin, hair and name for 121 seconds and commits" disguised
    to-mark <- cmr-blank owner player.pack
    mark-made <- when to-mark
      is Err (e) -> Err e
      is Ok (r) -> when world-get game.world player.serial
        is Err (e) -> Err e
        is Ok (m) -> when world-get game.world r
          is Err (e) -> Err e
          is Ok (blank) -> mga-mark magic m blank
    mark-saved <- cs-commit store True
    e <- cmr-check "boot1 Mark records the caster's place on a blank pack rune and commits" (is-ok mark-made & is-ok mark-saved & cmr-marked-at magic game.world (world-first-child game.world player.pack) 1440 1712 > 0)
    a + b + c + d + e
  end
  cmr-later : CompositeOwner, WdState, WalkMap -> [Console, Device.Block] Integer
  cmr-later (store) (decoration) (map) = let held = store.state.magic-held in act
    early <- cs-commit store True
    when cmr-attach store decoration map
      is Err (e) -> cmr-check ("restore " & e) False
      is Ok (magic) -> if cmr-state magic store.state 9 mgs-working then
          cmr-check "boot3 a commit before attach kept MGM1 and the later mana" (held == cc-magic-bytes store.state.checkpoint.game.world.capacity & is-ok early & store.state.magic-held == 0 & cmr-kit magic store.state)
        else act
          restored <- cmr-check "boot2 restart restores spellbook mask, rune destination and mana" (held == cc-magic-bytes store.state.checkpoint.game.world.capacity & is-ok early & cmr-state magic store.state 7 mgs-working & cmr-kit magic store.state)
          player <- list-at store.state.vendor.players 0
          actor <- list-at magic.actors (world-slot store.state.checkpoint.game.world player.serial)
          kept <- cmr-check "boot2 restart mid-spell keeps the Incognito look, its timer and its name" (cmr-disguised magic store.state.checkpoint.game player.serial)
          input <- gn-input 1
          caster <- __record-set input.session "serial" player.serial
          late <- __record-set magic "tick" (actor.incognito + 1)
          ended <- mgt-incognito magic store.state.checkpoint.game input actor
          back <- cmr-check "boot2 at expiry the original skin, hair and name return" (is-ok ended & cmr-plain magic store.state.checkpoint.game player.serial)
          world <- store.state.checkpoint.game.world
          rune <- cmr-marked-at magic world (world-first-child world player.pack) 1440 1712
          moved <- when world-get world player.serial is Err (e) -> Err e is Ok (m) -> world-update world (__record-set (__record-set m "x" 1430) "y" 1705)
          recalled <- when world-get world player.serial is Err (e) -> Err e is Ok (m) -> mga-travel magic store.state.checkpoint.game input m (mga-point 1440 1712 0)
          there <- (when world-get world player.serial is Err (_) -> False is Ok (m) -> m.x == 1440 & m.y == 1712)
          home <- cmr-check "boot2 the rune Mark recorded survives the restart and Recall on it returns the caster there" (rune > 0 & is-ok moved & is-ok recalled & there)
          spent <- __record-set actor "mana" 9
          touched <- mgs-touch magic
          committed <- cs-commit store False
          saved <- cmr-check "boot2 a mana-only change is dirty and commits through the live section" (when committed is Err (_) -> False is Ok (n) -> n == 1)
          restored + kept + back + home + saved
        end
  end

  opening : [Console, Device.Block] Integer = when cg-specs 0
    is Err (e) -> act
      print-line-uni ("FAIL registry " & e)
      1
    end
    is Ok (specs) -> when walk-map-new 1408 1680 64 64
     is Err (e) -> cmr-check e False
     is Ok (map) -> let filled = cmr-fill map 0
      in when cmr-decoration map
       is Err (e) -> cmr-check e False
       is Ok (decoration) -> act
     opened <- us-open 0 131072
     when opened
      is Err (e) -> cmr-check ("store " & e) False
      is Ok (store) -> let fresh = store.head == 0 in act
       loaded <- cs-load-config store (CompositeSetup { vendor-z = 0, shrine-z = 0, home-z = 0, decoration = Just decoration })
       when loaded
        is Err (e) -> cmr-check ("recovery " & e) False
        is Ok (owner) -> if fresh then when cmr-attach owner decoration map
            is Err (e) -> cmr-check ("attach " & e) False
            is Ok (magic) -> cmr-first owner magic map specs
          else cmr-later owner decoration map
      end
    end
