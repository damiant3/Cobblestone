Chapter: VirtioQueueProof
  cites Kernel chapter VirtioPciX86
  cites Kernel chapter Pci
  cites Foreword chapter Result

  vqp-device : Integer -> VpxDevice
  vqp-device (size) =
    let common = alloc-bytes 64
    in let cleared = vpx-zero common 64 0
    in let queues = poke-16 common 18 1
    in let status = poke-byte common 20 8
    in let maximum = poke-16 common 24 size
    in VpxDevice { pci = PciDevice { pci-bus = 0, pci-dev = 0, pci-func = 0,
      pci-vendor = 6900, pci-device-id = 4162, pci-class = 1, pci-subclass = 0, pci-header-type = 0 },
      common = common, notify = alloc-bytes 8, notify-size = 2, notify-multiplier = 0,
      isr = alloc-bytes 8, config = alloc-bytes 8, config-size = 8 }

  vqp-check : Text, Boolean -> [Console] Nothing
  vqp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)

  vqp-ring : VpxQueue -> [Console] Nothing
  vqp-ring (q) =
    let out = alloc-bytes 8
    in let before = __heap-save
    in let posted = vpx-publish q 2
    in let empty = vpx-take q out
    in let id = poke-32 q.used 4 2
    in let len = poke-32 q.used 8 123
    in let used = poke-16 q.used 2 1
    in let taken = vpx-take q out
    in let after = __heap-save
    in act
      vqp-check "publish and completion" (posted == 0 & empty == 0 & taken == 1 & peek-32 out 0 == 2 & peek-32 out 4 == 123 & q.last-used == 1)
      vqp-check "queue hot path heap" (after == before)
      let a = __record-set q "avail-index" 65535
      in let b = __record-set q "last-used" 65535
      in let posted = vpx-publish q 3
      in let id = poke-32 q.used (4 + (q.size - 1) * 8) 3
      in let len = poke-32 q.used (8 + (q.size - 1) * 8) 1
      in let used = poke-16 q.used 2 0
      in let taken = vpx-take q out
      in vqp-check "sixteen-bit ring wrap" (posted == 0 & taken == 1 & q.avail-index == 0 & q.last-used == 0 & peek-32 out 0 == 3)
      let used = poke-16 q.used 2 1
      in vqp-check "unposted completion faults queue" (vpx-take q out == -1 & q.fault == 1 & vpx-publish q 0 == -1)
    end

  vqp-fill : VpxQueue, Integer -> Boolean
  vqp-fill (q) (i) =
    if i == q.size then vpx-publish q 0 == -1
    else if vpx-publish q i /= 0 then False else vqp-fill q (i + 1)

  opening : [Console] Nothing = act
    when vpx-queue (vqp-device 8) 0 8
      is Err (e) -> print-line-uni ("FAIL queue " & e)
      is Ok (q) -> vqp-ring q
    when vpx-queue (vqp-device 256) 0 256
      is Err (e) -> print-line-uni ("FAIL large queue " & e)
      is Ok (q) -> vqp-check "large queue regions disjoint" (q.desc + q.size * 16 <= q.avail & q.avail + 6 + q.size * 2 <= q.used & vqp-fill q 0)
    vqp-check "invalid queue size refused" (is-err (vpx-queue (vqp-device 8) 0 3) & is-err (vpx-queue (vqp-device 8) 0 16))
    when vpx-queue (vqp-device 8) 0 8
      is Err (e) -> print-line-uni "FAIL bad-id setup"
      is Ok (q) -> let out = alloc-bytes 8
        in let posted = vpx-publish q 0
        in let id = poke-32 q.used 4 8
        in let used = poke-16 q.used 2 1
        in vqp-check "out-of-range completion refused" (vpx-take q out == -1 & q.fault == 1)
  end

