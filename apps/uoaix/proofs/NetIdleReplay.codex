Chapter: NetIdleReplay
  cites Net chapter NetIdle
  cites Uoaix chapter GameNet

  nir-check : Text, Boolean -> [Console] Integer
  nir-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  nir-queue : Integer, List RexmitSeg -> List RexmitSeg
  nir-queue (left) (out) = if left == 0 then out else nir-queue (left - 1) (list-push out (RexmitSeg { rx-frame = [], rx-ack = 2000, rx-sent = 0, rx-resent = False }))
  nir-retries : TcpTransportState, NetIdleClock, Integer, Integer -> [Network.Write] TcpTransportState
  nir-retries (transport) (clock) (left) (mark) =
    if left <= 0 then transport
    else act
      next <- ni-advance transport clock (clock.epoch + clock.period * (transport.session.now-ticks - clock.base-tick + max 1 transport.session.rexmit-rto)) mark
      nir-retries next clock (left - 1) mark
    end
  nir-events : TcpTransportState, NetIdleClock -> [Console, Network.Read, Network.Write] Integer
  nir-events (transport) (clock) = act
    empty <- transport-set-session transport (set-rexmit (set-conn transport.session (tcp-set-state transport.session.conn TcpEstablished)) [] 0 0)
    delayed-clock <- NetIdleClock { epoch = hpet-ticks - clock.period * 500, base-tick = empty.session.now-ticks, period = clock.period, rx = clock.rx }
    first-send <- gn-send-timed (slg-new slg-trace) delayed-clock empty 0 False [[17]] 0
    sent <- gn-send-timed (slg-new slg-trace) delayed-clock first-send.transport 0 False [[34]] 0
    first <- list-at sent.transport.session.rexmit-queue 0
    ack-number <- first.rx-ack
    sent-at <- sent.transport.session.now-ticks
    a <- nir-check "post-handler send stamps the current clock and starts a full RTO" (not sent.close & list-length sent.transport.session.rexmit-queue == 2 & first.rx-sent >= delayed-clock.base-tick + 500 & (list-at sent.transport.session.rexmit-queue 1).rx-sent == sent-at & sent.transport.session.rexmit-tries == 0 & sent.transport.session.rexmit-rto == net-rto-base sent.transport.session)
    event-now <- delayed-clock.epoch + delayed-clock.period * (sent-at - delayed-clock.base-tick + 100)
    ack <- tcp-build-segment 0 2593 sent.transport.session.conn.recv-next ack-number tcp-flag-ack 8192 []
    peer <- net-session-new [82,84,0,18,52,87] [10,0,2,2] [10,0,2,15] 0 2593 [10,0,2,15] 2000
    frame <- wrap-tcp-in-ip-eth peer ack [82,84,0,18,52,86]
    last-retry <- transport-set-session sent.transport (set-rexmit sent.transport.session sent.transport.session.rexmit-queue 1 net-rto-max-tries)
    pending <- ni-feed-at last-retry delayed-clock event-now [] 0
    g <- nir-check "expiry remains pending until the received batch is applied" (not (net-io-conn-closed pending) & pending.session.rexmit-rto < 0)
    partial <- ni-frame-at pending delayed-clock event-now frame (list-length frame) __heap-save
    rto <- partial.session.rexmit-rto
    now <- partial.session.now-ticks
    same <- ni-advance partial delayed-clock event-now __heap-save
    b <- nir-check "queued partial ACK rescues final retry and starts a full interval" (not (net-io-conn-closed same) & list-length same.session.rexmit-queue == 1 & same.session.rexmit-tries == 0 & same.session.rexmit-rto == rto & rto == net-rto-base same.session)
    before <- ni-advance same delayed-clock (event-now + delayed-clock.period * (rto - 1)) __heap-save
    c <- nir-check "ACK-rearmed interval does not expire early" (before.session.rexmit-tries == 0 & before.session.rexmit-rto == 1)
    due <- ni-advance before delayed-clock (event-now + delayed-clock.period * rto) __heap-save
    d <- nir-check "ACK-rearmed interval expires at its new deadline" (due.session.rexmit-tries == 1 & due.session.now-ticks == now + rto)
    final <- transport-set-session due (set-rexmit due.session due.session.rexmit-queue 1 net-rto-max-tries)
    full-ack <- tcp-build-segment 0 2593 final.session.conn.recv-next final.session.conn.send-next tcp-flag-ack 8192 []
    full-frame <- wrap-tcp-in-ip-eth peer full-ack [82,84,0,18,52,86]
    final-now <- event-now + delayed-clock.period * (rto + 1)
    rescued <- ni-frame-at final delayed-clock final-now full-frame (list-length full-frame) __heap-save
    e <- nir-check "queued full ACK retires final retry before give-up dispatch" (not (net-io-conn-closed rescued) & list-length rescued.session.rexmit-queue == 0 & rescued.session.rexmit-rto == 0)
    unanswered <- net-send rescued.session [51]
    armed <- transport-set-session rescued (set-rexmit unanswered.session unanswered.session.rexmit-queue 1 net-rto-max-tries)
    closed <- ni-frame-at armed delayed-clock (final-now + delayed-clock.period) [] 0 __heap-save
    f <- nir-check "final retry without an ACK still closes" (net-io-conn-closed closed)
    fresh <- transport-set-session closed (set-rexmit (set-conn closed.session (tcp-set-state closed.session.conn TcpEstablished)) [] 0 0)
    batch <- gn-send-timed (slg-new slg-trace) delayed-clock fresh 0 False [[1],[2],[3]] 0
    combined <- (list-at batch.transport.session.rexmit-queue 0).rx-frame
    size <- list-length combined
    h <- nir-check "reply packets share one small TCP payload in original order" (not batch.close & list-length batch.transport.session.rexmit-queue == 1 & list-at combined (size - 3) == 1 & list-at combined (size - 2) == 2 & list-at combined (size - 1) == 3)
    a+b+c+d+e+f+g+h
  end
  nir-run : TcpTransportState, NetIdleClock -> [Console, Network.Read, Network.Write] Integer
  nir-run (transport) (clock) = act
    a <- nir-check "wall ticks use elapsed time rather than poll or wake count" (ni-target clock (clock.epoch + clock.period * 3 + clock.period / 2) == clock.base-tick + 3)
    mark <- __heap-save
    start <- hpet-ticks
    waited <- ni-wait transport clock True (start + clock.period * 4) mark
    stop <- hpet-ticks
    b <- nir-check "parked accept expires while stack timers advance" (stop >= start + clock.period * 4 & waited.session.now-ticks >= clock.base-tick + 4)
    early <- transport-set-session waited (set-now waited.session (waited.session.now-ticks + 20))
    before <- early.session.now-ticks
    advanced <- ni-advance early clock stop mark
    c <- nir-check "legacy timer work is not double-counted" (advanced.session.now-ticks == before)
    q <- set-rexmit (set-conn advanced.session (tcp-set-state advanced.session.conn TcpEstablished)) (nir-queue net-rexmit-capacity []) 1 0
    full <- transport-set-session advanced q
    delayed <- ni-advance full clock (clock.epoch + clock.period * 500) mark
    d <- nir-check "owner stall expires only the current retry; new retry gets response time" (not (net-io-conn-closed delayed) & delayed.session.rexmit-tries == 1 & delayed.session.now-ticks == clock.base-tick + 500 & delayed.session.rexmit-rto == net-rto-backoff delayed.session 1)
    same <- ni-advance delayed clock (clock.epoch + clock.period * 500) mark
    f <- nir-check "no timer debt remains after catch-up" (same.session.rexmit-tries == 1)
    expired <- nir-retries same clock 5 mark
    g <- nir-check "unresponsive peer closes after separately elapsed retry intervals" (net-io-conn-closed expired)
    live <- transport-set-session expired (set-conn expired.session (tcp-set-state expired.session.conn TcpEstablished))
    buffered <- transport-feed-range live live.session [17,34,51] 0 3
    recv <- ni-recv buffered clock mark
    e <- nir-check "buffered raw bytes survive wait without repository framing" (recv.has-data & list-length recv.data == 3 & list-at recv.data 0 == 17 & list-at recv.data 2 == 51 & recv.transport.recv-len == 0)
    finish <- hpet-ticks
    events <- nir-events recv.transport clock
    print-line-uni ("parked accept HPET us=" & show ((stop - start) * 1000000 / (clock.period * 10)))
    a+b+c+d+e+f+g+events
  end
  opening : [Console, Network.Read, Network.Write] Integer = act
    none <- net-driver-bind-none 0
    session <- net-session-new [82,84,0,18,52,86] [10,0,2,15] [10,0,2,2] 2593 0 [10,0,2,2] 1000
    transport <- transport-arenas (net-io-listen (transport-new-with-cap session 4096))
    made <- ni-clock transport (net-driver-frame-buffer net-driver-frame-cap)
    when made
      is Err (e) -> act
        print-line-uni e
        1
      end
      is Ok (clock) -> nir-run transport clock
  end
