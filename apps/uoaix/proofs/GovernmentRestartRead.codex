Chapter: GovernmentRestartRead
  cites Uoaix chapter TownGovernmentInputFixtures
  cites Uoaix chapter TownGovernmentBundle
  cites Uoaix chapter TownGovernmentStore
  cites Uoaix chapter WorldDisk
  cites Foreword chapter Result

  grr-check : Text, Boolean -> [Console] Nothing
  grr-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  grr-run : UoStore, GovernmentAnchors -> [Console, Device.Block] Nothing
  grr-run (store) (anchors) = act
    recovered <- government-store-restore store anchors
    when recovered
      is Err (e) -> print-line-uni ("FAIL civic recovery " & e)
      is Ok (recovery) -> act
        state <- recovery.state
        grr-check "civic checkpoint seven plus forty-input suffix" (recovery.inputs == 40 & state.sequence == 47 & state.tick == 470 & store.sequence == 47 & store.tick == 470)
        grr-check "offices obligations currency and report body restored" (tgif-valid state)
        grr-check "unchanged external people and registry anchors remain bound" (state.government.people.used == 7 & state.disputes.registry.used == 0 & anchors.registry.used == 0)
      end
    sequence <- store.sequence
    changed <- __record-set store "sequence" (sequence + 1)
    mismatch <- government-store-restore store anchors
    grr-check "civic cached head disagreement refuses" (is-err mismatch)
    restored <- __record-set store "sequence" sequence
    torn <- __record-set store "tail" 1
    tail <- government-store-restore store anchors
    grr-check "civic marked torn tail refuses" (is-err tail)
    untorn <- __record-set store "tail" 0
    grr-check "civic store metadata preserved after refusal" (store.sequence == sequence & store.tail == 0)
  end
  opening : [Console, Device.Block] Nothing = act
    when tgif-anchors 0
      is Err (e) -> print-line-uni ("FAIL civic anchors " & e)
      is Ok (anchors) -> act
        opened <- us-open 0 16384
        when opened
          is Err (e) -> print-line-uni ("FAIL civic open " & e)
          is Ok (store) -> grr-run store anchors
      end
  end
