Chapter: GovernmentCurrencyProof
  cites Uoaix chapter TownGovernment
  cites Uoaix chapter TownWorks
  cites Uoaix chapter Townsfolk
  cites Uoaix chapter EconomyCurrency
  cites Uoaix chapter EconomyCurrencyFixtures
  cites Uoaix chapter EconomyCurrencyValid
  cites Uoaix chapter EconomyMoney
  cites Foreword chapter Result

  gcp-check : Text, Boolean -> [Console] Nothing
  gcp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  gcp-people : TfWorld, Integer -> Integer
  gcp-people (people) (i) = if i == 8 then 0
    else let p = tf-add-person people ("Resident " & show i) 1 (1000 + i) 100 0 10000
    in if p /= i then -1 else gcp-people people (i + 1)
  gcp-hours : EuCurrency, Integer -> Integer
  gcp-hours (x) (hours) = if hours == 0 then 0
    else if eu-hour x /= 0 then -1 else gcp-hours x (hours - 1)
  gcp-run : TgWorld, EuCurrency, Integer -> [Console] Nothing
  gcp-run (g) (x) (town-purse) = act
    registered <- tg-register g True 1 1 town-purse
    c-sequence <- x.copper.sequence
    s-sequence <- x.silver.sequence
    before <- x.count
    grant <- tg-grant g True 1 5
    loan <- tg-loan g True 1 2 0 124
    gcp-check "royal funding routes through currency history" (registered == 0 & grant == 0 & loan == 2 & x.count == before + 2 & (em-purse x.world.money town-purse).coin == 7 & euv-valid x)
    dues <- tg-set-dues g 1 1 1
    collected <- tg-collect g 1 1 4 True
    hired <- tg-hire g 1 1 7 3 1
    gcp-check "dues preserve gold units and current authority" (dues == 0 & collected == 0 & hired == 1 & tg-collect g 1 1 4 True == -1 & tg-collect g 2 1 4 True == -1 & (em-purse x.world.money town-purse).coin == 8 & euv-valid x)
    advanced <- gcp-hours x 24
    pay-before <- __heap-save
    payroll <- tg-close-day g
    pay-after <- __heap-save
    gcp-check "daily guard payroll keeps coordinator ready without action heap" (advanced == 0 & payroll == 0 & (em-purse x.world.money 3).coin == 1 & (tg-office g 1).paid == 1 & eu-ready x & euv-valid x & pay-before == pay-after)
    gcp-check "gold civic operations leave copper and silver coin counts intact" (x.copper.issued == 1000 & x.silver.issued == 100 & (em-purse x.copper 1).coin == 800 & (em-purse x.silver 1).coin == 80 & x.copper.sequence == c-sequence + 24 & x.silver.sequence == s-sequence + 24)
    saved-events <- x.count
    saved-civic <- g.event-count
    saved-treasury <- (em-purse x.world.money 1).coin
    full <- __record-set x "count" em-rows
    gcp-check "full currency history refuses royal grant before civic effects" (tg-grant g True 1 1 == -1 & g.event-count == saved-civic & (em-purse x.world.money 1).coin == saved-treasury)
    restored <- __record-set x "count" saved-events
    next-day <- gcp-hours x 24
    before-full-day <- x.count
    gold-before <- x.world.money.sequence
    full-day <- __record-set x "count" em-rows
    unpaid-day <- tg-close-day g
    gcp-check "payroll history exhaustion records debt without bypassing currency" (next-day == 0 & unpaid-day == 0 & (list-at g.guards 0).arrears == 1 & (tg-office g 1).unpaid == 1 & x.world.money.sequence == gold-before)
    reopened <- __record-set x "count" before-full-day
    settled <- tg-settle g 1 1 1
    gcp-check "later arrears settlement is a coordinated payment" (settled == 0 & (list-at g.guards 0).arrears == 0 & (tg-office g 1).unpaid == 0 & euv-valid x)
    works <- tw-new g
    bounty <- tw-post works 1 1 55 1 1 True
    claimed <- tw-claim works True bounty 55 1 9001 4
    bounty-before <- x.count
    paid <- tw-pay-bounty works 1 bounty
    gcp-check "town works bounty uses the same currency payment path" (bounty == 1 & claimed == 0 & paid == 0 & x.count == bounty-before + 1 & tw-pay-bounty works 1 bounty == -1 & euv-valid x)
    money-action <- (list-at works.bounties 0).money-action
    gcp-check "civic and works references retain gold ledger action meaning" (money-action == x.world.money.sequence & (list-at g.events (g.event-count - 1)).money-action == money-action & (list-at x.events (x.count - 1)).gold-seq == money-action)
  end
  gcp-world : EuiScenario -> [Console] Nothing
  gcp-world (scenario) = act
    x <- scenario.state.currency
    people <- tf-new 0
    town <- tf-add-town people "Britain" 100 101 102
    residents <- gcp-people people 1
    town-purse <- eu-open x 4 1
    legacy <- tg-new people x.world
    gcp-check "extended economy cannot use legacy government money path" (scenario.failed == 0 & town == 1 & residents == 0 & tg-register legacy True 1 1 town-purse == -1 & legacy.event-count == 0)
    gcp-check "invalid royal actor refuses currency government binding" (is-err (tg-new-currency people x 0))
    when tg-new-currency people x 1
      is Err (e) -> print-line-uni ("FAIL government binding " & e)
      is Ok (g) -> gcp-run g x town-purse
  end
  opening : [Console] Nothing = act
    when efi-source 0
      is Err (e) -> print-line-uni ("FAIL currency fixture " & e)
      is Ok (state) -> gcp-world (efi-build state)
  end
