Chapter: SkillCurveProof
  cites Uoaix chapter ClassicSkills
  cites Uoaix chapter EconomyProduction

  scp-check : Text, Boolean -> [Console] Nothing
  scp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  scp-ratios : Integer, Boolean -> Boolean
  scp-ratios (level) (ok) = if level >= 1000 then ok
    else let a = skc-uses level
    in let b = skc-uses (level + 100)
    in scp-ratios (level + 100) (ok & b * 100 >= a * 150 & b * 100 <= a * 160)
  scp-row : Integer, Text -> Text
  scp-row (level) (out) = if level > 1000 then out else scp-row (level + 100) (out & " " & show (level / 10) & "=" & show (skc-uses level))
  scp-climb : SkClassic, Integer, Integer, Integer -> Integer
  scp-climb (p) (stop) (uses) (left) = if left == 0 | sk-at p.levels 1 >= stop then uses
    else let used = skc-use p 1 (sk-at p.levels 1) True in scp-climb p stop (uses + 1) (left - 1)
  scp-legs : SkClassic, Integer, Text -> Text
  scp-legs (p) (stop) (out) = if stop > 1000 then out
    else let spent = scp-climb p stop 0 2000000
    in scp-legs p (stop + 100) (out & " " & show (stop / 10) & ":" & show spent)
  scp-fish : EpActor, Integer, Integer, Integer -> Integer
  scp-fish (p) (left) (used) (at50) = if left == 0 then at50
    else let caught = ep-practice p 4
    in let reached = if at50 == 0 & ep-at p.skills 4 >= 500 then used + 1 else at50
    in scp-fish p (left - 1) (used + 1) reached
  opening : [Console] Nothing = act
    print-line-uni ("USES per 0.1 at skill" & scp-row 0 "")
    scp-check "uses per 0.1 are 10 at 0.0 and 800 at 100.0" (skc-uses 0 == 10 & skc-uses 1000 == 800)
    scp-check "every 10.0 multiplies the uses per 0.1 by 1.50 to 1.60 (80^0.1 = 1.55): skill is the log of uses" (scp-ratios 0 True)
    scp-check "the success bonus is 10x below 50.0, 5.5x at 75.0 and 1x at 100.0" (skc-bonus 0 == 100 & skc-bonus 499 == 100 & skc-bonus 750 == 55 & skc-bonus 1000 == 10)
    scp-check "below 50.0 a failure gains a normal gain and a success ten of them" (skc-gain-at 100 300 300 False > 0 & skc-gain-at 100 300 300 True == skc-gain-at 100 300 300 False * 10)
    scp-check "at 0.0 every success gains" (skc-gain-at 100 0 0 True == 1000)
    scp-check "from 50.0 a failure gains a tenth of a normal gain" (skc-gain-at 100 600 600 False == (1000 / skc-uses 600) / 10)
    scp-check "at 100.0 a success gains a normal gain" (skc-gain-at 100 1000 1000 True == 1000 / skc-uses 1000)
    scp-check "from 50.0 a success gains fully within 10.0 below the level and above it" (skc-gain-at 100 600 500 True == skc-gain-at 100 600 600 True & skc-gain-at 100 600 900 True == skc-gain-at 100 600 600 True)
    scp-check "from 50.0 a success 15.0 below the level gains half, and 20.0 below nothing" (skc-gain-at 100 600 450 True == skc-gain-at 100 600 600 True / 2 & skc-gain-at 100 600 399 True == 0)
    p <- skc-new 12345 100
    legs <- scp-legs p 100 ""
    print-line-uni ("USES to climb each 10.0 at difficulty equal to the level:" & legs)
    q <- skc-new 12345 100
    first <- scp-climb q 100 0 2000000
    middle <- scp-climb q 900 0 2000000
    last <- scp-climb q 1000 0 2000000
    scp-check "one character climbs from 0.0 to 100.0, and 90.0 to 100.0 costs more than twenty times the uses of 0.0 to 10.0" (sk-at p.levels 1 == 1000 & sk-at q.levels 1 == 1000 & last > first * 20)
    fisher <- EpActor { purse = 0, place = 0, hunger = 0, attempts = 0, stock = ep-buffer 129, quality = ep-buffer 129, cost = ep-buffer 129, wear = ep-buffer 129, skills = ep-buffer 11, row = 0 }
    at50 <- scp-fish fisher 4800 0 0
    print-line-uni ("FISHING 4800 casts (4 hours at the 3 s harvest cooldown) reach " & show (ep-at fisher.skills 4) & " tenths; 50.0 at cast " & show at50)
    scp-check "one fisher from 0.0 reaches 50.0 within 4 hours of casts at the server's pace" (at50 > 0 & at50 <= 4800)
  end

