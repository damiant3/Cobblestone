Chapter: GameArmorProof
  cites Uoaix chapter GameArmor
  cites Uoaix chapter GameSession
  cites Uoaix chapter GamePackets
  cites Foreword chapter Result

  gap-check : Text, Boolean -> [Console] Nothing
  gap-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)

  gap-wear : GsiState, Integer, Integer, Integer -> Integer
  gap-wear (items) (mobile) (graphic) (layer) = when world-create items.world (gs-item mobile graphic 0)
    is Err (_) -> 0
    is Ok (serial) -> let meta = gsi-register items serial layer 0 True False in serial

  opening : [Console] Nothing = when gs-new 0
    is Err (e) -> print-line-uni ("FAIL world " & e)
    is Ok (game) -> when world-create game.world (gs-mobile 0 1421 1698 0 400 1002)
      is Err (e) -> print-line-uni ("FAIL mobile " & e)
      is Ok (mobile) -> let items = gsi-new game.world
        in let bare = gar-class items mobile
        in let gorget = gap-wear items mobile #1413 10
        in let neck = gar-class items mobile
        in let chest = gap-wear items mobile #1415 13
        in let both = gar-class items mobile
        in let carried = when world-create game.world (gs-item gorget #1411 0) is Err (_) -> 0 is Ok (s) -> s
        in let status = gar-status items (gp-status (gs-mobile mobile 0 0 0 400 1002) game.characters 0)
        in act
          gap-check "an unarmored mobile shows armor 0" (bare == 0)
          gap-check "a plate gorget covers the neck at 7 percent" (neck == 2)
          gap-check "a plate chest adds 35 percent of 40" (both == 16)
          gap-check "an item that is not equipped adds nothing" (carried > 0 & gar-class items mobile == 16)
          gap-check "status carries the armor class at offset 62" (list-length status == 66 & list-at status 62 == 0 & list-at status 63 == 16)
        end

