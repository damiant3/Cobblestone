Chapter: CompositeTamingProof
  cites Uoaix chapter CompositeStore

  ctp-check : Text, Boolean -> [Console] Integer
  ctp-check (name) (ok) = act
    print-line-uni ((if ok then "PASS " else "FAIL ") & name)
    if ok then 0 else 1
  end
  ctp-fill : WalkMap, Integer -> Integer
  ctp-fill (map) (i) = if i == map.width * map.height then 0
    else let mark = __heap-save
    in let result = walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0
    in let restored = __heap-restore mark in ctp-fill map (i + 1)
  ctp-create : Integer -> List Integer
  ctp-create (unused) = let header = list-push (gp-put32 (gp-put32 (gp-start 0) #EDEDEDED) #FFFFFFFF) 0
    in let name = gp-ascii (gp-ascii header "Ranger" 0 30) "" 0 30
    in let stats = name & [0,30,20,15,3,50,11,30,45,20]
    in gp-put32 (gp-put16 (gp-zeros (gp-put16 stats 1002) 12) 0) 0
  ctp-say : Text -> List Integer
  ctp-say (text) = let length = 9 + text-length text in gp-ascii [3,0,length,0,3,178,0,3] text 0 (text-length text + 1)
  ctp-skill : Integer -> List Integer
  ctp-skill (skill) = let body = [#12,0,0,#24,48 + skill / 10,48 + int-mod skill 10,0] in list-set-at body 2 (list-length body)
  ctp-target : Integer, Integer -> List Integer
  ctp-target (context) (serial) = let a = gp-put32 (list-push (gp-put32 [#6C,0] context) 0) serial
    in gp-put16 ((gp-put16 (gp-put16 a 0) 0) & [0,0]) 0
  ctp-profile : WsCatalog, Text, Integer -> Integer
  ctp-profile (c) (key) (i) = if i == list-length c.profiles then -1 else if (list-at c.profiles i).key == key then i else ctp-profile c key (i + 1)
 A slot bound the way gws-place binds one, in region 0, so the horse is placed beside the player rather than drawn.
  ctp-spawn : GameWorldSpawn, GameShard, Integer, Integer, Integer -> Integer
  ctp-spawn (g) (game) (profile) (x) (y) = let free = gws-free g.slots 0
    in if free < 0 | profile < 0 then -1
    else let p = list-at g.catalog.profiles profile
    in when world-create game.world (__record-set (gs-mobile 0 x y 0 p.body p.hue) "health" p.hits-high)
      is Err (_) -> -1
      is Ok (serial) -> if gws-profile g game serial p /= 0 then -1
        else let slot = list-at g.slots free
        in let a = __record-set slot "serial" serial
        in let b = __record-set slot "region" 0
        in let c = __record-set slot "profile" profile
        in let d = __record-set slot "direction" 0
        in let e = __record-set slot "due" g.combat.tick
        in let filed = gws-file g free x y
        in let population = poke-qword g.populations 0 (peek-qword g.populations 0 + 1) in serial
  ctp-at : GameShard, Integer -> WorldObject
  ctp-at (game) (serial) = when world-get game.world serial is Err (_) -> gs-item 0 0 0 is Ok (m) -> m
  ctp-move : GameShard, Integer, Integer, Integer -> Boolean
  ctp-move (game) (serial) (x) (y) = when world-get game.world serial
    is Err (_) -> False
    is Ok (m) -> is-ok (world-update game.world (__record-set (__record-set m "x" x) "y" y))
  ctp-pulses : CompositeOwner, GameShard, GameInput, WalkMap, Integer, Integer -> [Console, Device.Block] Integer
  ctp-pulses (store) (game) (input) (map) (tick) (left) = if left == 0 then tick
    else act
      pulsed <- cs-pulse store game input map 2593 tick
      ctp-pulses store game input map (tick + gm-ticks 300) (left - 1)
    end
  ctp-tamed : CompositeGame, GameShard, GameInput, Integer -> Result (Maybe GameReply) Text
  ctp-tamed (owner) (game) (input) (left) = let a = list-at owner.active.actors (gsi-slot game input.session.serial 0)
    in let r = as-pulse-at (cg-as-services owner) owner.active game input a.tame-due
    in if left == 0 | a.tame-due == 0 then r else ctp-tamed owner game input (left - 1)
  ctp-note : Result (Maybe GameReply) Text -> Text
  ctp-note (r) = when r is Ok (Just (reply)) -> reply.note is otherwise -> "none"
  ctp-gap : WorldObject, WorldObject -> Integer
  ctp-gap (a) (b) = max (walk-abs (a.x - b.x)) (walk-abs (a.y - b.y))
  ctp-actor : CompositeGame, GameShard, Integer -> CombatActor
  ctp-actor (owner) (game) (serial) = list-at owner.combat.actors (world-slot game.world serial)
  ctp-pet : GameWorldSpawn, Integer -> Integer
  ctp-pet (g) (i) = if i == list-length g.slots then -1 else if (list-at g.slots i).owner /= 0 then i else ctp-pet g (i + 1)
  ctp-wild : GameWorldSpawn, Integer, Integer -> Integer
  ctp-wild (g) (region) (i) = if i == list-length g.slots then 0
    else let s = list-at g.slots i in (if s.serial > 0 & s.owner == 0 & s.region == region then 1 else 0) + ctp-wild g region (i + 1)
 The pulses above run the world clock ahead of real time; the commit stamps get-ticks, so the spawn timers are pulled
 back to it before saving (UWS1 bounds a remaining step at 5 s).
  ctp-rebase : GameWorldSpawn, Integer, Integer -> Integer
  ctp-rebase (g) (now) (i) = if i == list-length g.slots then let due = __record-set g "due" now in 0
    else let s = list-at g.slots i in let d = __record-set s "due" (min s.due now) in ctp-rebase g now (i + 1)
  ctp-first : CompositeOwner, List GameOpcodeSpec -> [Console, Device.Block] Integer
  ctp-first (store) (specs) = let owner = store.state in act
    attached <- cg-spawn-attach owner
    when owner.spawns
      is None -> ctp-check "spawn controller absent" False
      is Just (spawns) -> act
        horse-profile <- ctp-profile spawns.catalog "horse" 0
        a <- ctp-check "the catalog carries UOX3 TOTAME: a horse needs 29.1 Animal Taming" (is-ok attached & horse-profile >= 0
          & (list-at spawns.catalog.profiles (max 0 horse-profile)).taming == 291)
        when walk-map-new 1392 1664 96 96
          is Err (e) -> ctp-check e False
          is Ok (map) -> act
            filled <- ctp-fill map 0
            input <- gn-input-with specs 1
            mode <- __record-set input "mode" 2
            phase <- __record-set input.session "phase" 1
            game <- owner.checkpoint.game
            entry <- cs-route store game input map 2593 (ctp-create 0)
            player <- input.session.serial
            placed <- ctp-move game player 1440 1710
            horse <- ctp-spawn spawns game horse-profile 1442 1710
            wild <- peek-qword spawns.populations 0
            skilled <- gs-skill-set game player 35 1000
            asked <- cs-route store game input map 2593 (ctp-skill 35)
            cursor <- (list-at owner.active.actors (gsi-slot game player 0)).cursor
            begun <- cs-route store game input map 2593 (ctp-target cursor horse)
            began <- when begun is Err (_) -> "error" is Ok (r) -> r.note
            tamed <- ctp-tamed owner game input 3
            print-line-uni ("TAME horse=" & show horse & " begun=" & began & " result=" & ctp-note tamed & " owner=" & show (gws-owner-of spawns horse) & " wild " & show wild & " -> " & show (peek-qword spawns.populations 0))
            b <- ctp-check "Animal Taming at 100.0 tames a wild horse within three tries: it accepts its master and leaves its region's count" (is-ok entry & placed & horse > 0 & skilled >= 0
              & began == "skills:tame-begun" & ctp-note tamed == "skills:tamed" & gws-owner-of spawns horse == player & peek-qword spawns.populations 0 == wild - 1)
            walked <- ctp-move game player 1446 1710
            t1 <- ctp-pulses store game input map get-ticks 30
            near <- ctp-gap (ctp-at game horse) (ctp-at game player)
            c <- ctp-check "a new pet follows its master six tiles to within one tile" (walked & near <= 1)
            stay <- cs-route store game input map 2593 (ctp-say "all stay")
            held <- ctp-at game horse
            away <- ctp-move game player 1452 1710
            t2 <- ctp-pulses store game input map (t1 + gm-ticks 1000) 30
            still <- ctp-at game horse
            d <- ctp-check "after \"all stay\" the pet holds its tile while its master walks away" (is-ok stay & away & still.x == held.x & still.y == held.y & ctp-gap still (ctp-at game player) >= 5)
            follow <- cs-route store game input map 2593 (ctp-say "all follow me")
            t3 <- ctp-pulses store game input map (t2 + gm-ticks 1000) 30
            e <- ctp-check "after \"all follow me\" the pet walks back to its master" (is-ok follow & ctp-gap (ctp-at game horse) (ctp-at game player) <= 1)
            p <- ctp-at game player
            when world-create game.world (__record-set (gs-mobile 0 (p.x + 1) (p.y + 1) 0 400 1002) "health" 200)
              is Err (e) -> ctp-check ("attacker " & e) False
              is Ok (attacker) -> act
                aimed <- when cb-ensure owner.combat game attacker is Err (_) -> False is Ok (x) -> (when cb-ensure owner.combat game player is Err (_) -> False is Ok (y) -> cb-select owner.combat game x y)
                t4 <- ctp-pulses store game input map (t3 + gm-ticks 1000) 6
                calm <- ctp-actor owner game horse
                f <- ctp-check "a following pet leaves a fight with its master alone" (aimed & not (calm.war & calm.target == attacker))
                guard <- cs-route store game input map 2593 (ctp-say "all guard me")
                t5 <- ctp-pulses store game input map (t4 + gm-ticks 1000) 6
                fierce <- ctp-actor owner game horse
                print-line-uni ("GUARD attacker=" & show attacker & " pet war=" & (if fierce.war then "yes" else "no") & " target=" & show fierce.target)
                g <- ctp-check "after \"all guard me\" the pet attacks whoever attacks its master" (is-ok guard & fierce.war & fierce.target == attacker)
                rebased <- ctp-rebase spawns get-ticks 0
                committed <- cs-commit store True
                print-line-uni ("COMMIT " & (when committed is Err (e) -> e is Ok (_) -> "ok"))
                h <- ctp-check "the world commits with the tamed pet" (is-ok committed)
                a + b + c + d + e + f + g + h
              end
          end
      end
  end
  ctp-later : CompositeOwner -> [Console] Integer
  ctp-later (store) = let owner = store.state in act
    attached <- cg-spawn-attach owner
    when owner.spawns
      is None -> ctp-check "spawn controller absent after restart" False
      is Just (spawns) -> act
        at <- ctp-pet spawns 0
        slot <- list-at spawns.slots (max 0 at)
        print-line-uni ("RESTORED pet slot " & show at & " serial " & show slot.serial & " owner " & show slot.owner & " order " & show slot.order)
        ctp-check "restart restores the pet's master and its guard order through UWS1, and its region counts only wild spawns" (is-ok attached & at >= 0
          & slot.serial > 0 & slot.owner > 0 & slot.order == gws-order-guard & peek-qword spawns.populations 0 == ctp-wild spawns 0 0
          & (when world-get owner.checkpoint.game.world slot.serial is Err (_) -> False is Ok (m) -> m.kind == 1 & m.health > 0))
      end
  end

  opening : [Console, Device.Block] Integer = when cg-specs 0
    is Err (e) -> ctp-check ("registry " & e) False
    is Ok (specs) -> act
      opened <- us-open 0 131072
      when opened
        is Err (e) -> ctp-check ("store " & e) False
        is Ok (store) -> let fresh = store.head == 0 in act
          loaded <- cs-load store 0
          when loaded
            is Err (e) -> ctp-check ("recovery " & e) False
            is Ok (owner) -> if fresh then ctp-first owner specs else ctp-later owner
          end
    end

