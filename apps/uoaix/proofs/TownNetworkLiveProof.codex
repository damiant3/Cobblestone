Chapter: TownNetworkLiveProof
  cites Uoaix chapter TownNetworkLiveCodec
  cites Uoaix chapter TownLiveCodec

  tnp-check : Text, Boolean -> [Console] Nothing
  tnp-check (name) (ok) = print-line-uni ((if ok then "PASS " else "FAIL ") & name)
  tnp-fill : WalkMap, Integer -> Boolean
  tnp-fill (map) (i) = if i == map.width * map.height then True
    else let mark = __heap-save
    in let ok = is-ok (walk-set-land map (map.x + int-mod i map.width) (map.y + i / map.width) 0 0)
    in let restored = __heap-restore mark in ok & tnp-fill map (i + 1)
  tnp-hours : EuCurrency, Integer -> Boolean
  tnp-hours (x) (left) = if left == 0 then True else eu-hour x == 0 & tnp-hours x (left - 1)
  tnp-rounds : TownNetworkLive, WalkMap, Integer, Integer, Integer -> Integer
  tnp-rounds (n) (map) (i) (count) (peak) = if i == count then peak
    else let mark = __heap-save
    in let result = tnv-advance n map None (32400 + i * 12) 3 8
    in let ok = is-ok result
    in let used = __heap-save - mark
    in let restored = __heap-restore mark
    in if not ok then -1 else tnp-rounds n map (i + 1) count (max peak used)
  tnp-identities : TownNetworkLive, Integer -> Boolean
  tnp-identities (n) (i) = if i == 3 then True
    else let r = list-at n.agents i
    in r.thoughts >= 1 & r.state.head <= r.state.count
      & tn-happiness r.state >= 0 & tn-happiness r.state <= 1000
      & tn-alarm r.state >= 0 & tn-alarm r.state <= 1000
      & (tf-person n.actions.town.people r.person).mood == tn-happiness r.state / 10
      & list-at n.actions.town.feel (i * 3) == tn-opinion r.state 0 & list-at n.actions.town.feel (i * 3 + 1) == tn-opinion r.state 1
      & list-at n.actions.town.feel (i * 3 + 2) == tn-alarm r.state
      & r.proposal.actor == r.actor & tnp-identities n (i + 1)
  tnp-zero-copies : Integer, Integer -> Boolean
  tnp-zero-copies (buf) (i) = if i == 3 then True
    else let row = buf + tnlc-agent-at + i * tnlc-agent-bytes
    in peek-qword row 0 == 0 & peek-qword row 8 == 0 & peek-qword row 112 == 0 & peek-qword row 128 == 0
      & peek-qword row 752 == 0 & peek-qword row 48 >= 0 & peek-qword row 48 <= 1 & tnp-zero-copies buf (i + 1)
  tnp-derived : TownNetworkLive, TownNetworkLive, Integer -> Boolean
  tnp-derived (n) (back) (i) = if i == 3 then True
    else let a = list-at n.agents i
    in let b = list-at back.agents i
    in a.person == b.person & a.actor == b.actor & a.total == b.total & a.state.count == b.state.count
      & a.proposal.actor == b.proposal.actor & a.prepared == b.prepared & tnp-derived n back (i + 1)
  tnp-control-same : TlControl, TlControl -> Boolean
  tnp-control-same (a) (b) = a.action == b.action & a.goal == b.goal & a.place == b.place & a.vendor == b.vendor
    & a.expires == b.expires & a.target.x == b.target.x & a.target.y == b.target.y & a.target.z == b.target.z
  tnp-live-serials : TownLive, Integer, List Integer -> List Integer
  tnp-live-serials (t) (i) (out) = if i == t.count then out
    else let p = tf-person t.people (list-at t.residents i).person
    in tnp-live-serials t (i + 1) (if p.alive == 1 then out & [p.world-serial] else out)
  tnp-owners-bound : GvWorld, TownLive, Integer -> Boolean
  tnp-owners-bound (v) (t) (i) = if i == t.count then True
    else let r = list-at t.residents i
    in let p = tf-person t.people r.person
    in let at = gv-owner v p.world-serial 0
    in (p.alive == 0 | (at >= 0 & (if at < 0 then False else (list-at v.owners at).actor == r.actor))) & tnp-owners-bound v t (i + 1)
  tnp-owner-rows : TownNetworkLive, WalkMap, Integer, Integer, Integer -> [Console] Nothing
  tnp-owner-rows (n) (map) (buf) (size) (town-buf) = act
    t <- n.actions.town
    live <- tnp-live-serials t 0 []
    vbuf <- alloc-bytes gvsc-bytes
    written <- gvsc-write-without t.vendors vbuf gvsc-bytes live (alloc-bytes (gvsc-tail-size-with t.vendors live))
    stored <- peek-qword vbuf 72
    reloaded <- when gvsc-decode-any vbuf gvsc-bytes t.vendors.game t.vendors.currency
      is Err (e) -> Err e
      is Ok (v) -> when tlc-decode town-buf tlc-bytes v t.items map t.now
        is Err (e) -> Err e
        is Ok (town) -> let before = gv-owner v (list-at live 0) 0
          in when tnlc-decode buf size town map
            is Err (e) -> Err e
            is Ok (back) -> Ok (before < 0 & tnp-owners-bound v town 0)
    tnp-check "GVS1 omits the live residents' owner rows and the network load binds them from the residents" (is-ok written
      & list-length live > 0 & stored == t.vendors.owner-count - list-length live
      & (when reloaded is Err (e) -> False is Ok (ok) -> ok))
  end
  tnp-codec : TownNetworkLive, WalkMap -> [Console] Nothing
  tnp-codec (n) (map) = act
    t <- n.actions.town
    worker <- list-at t.residents 1
    directed <- tl-direct t map None worker.person worker.actor 1 0 (t.now + 600)
    size <- tnlc-size n
    buf <- alloc-bytes size
    encoded <- tnlc-encode n map buf size
    town-buf <- alloc-bytes tlc-bytes
    town-encoded <- tlc-encode t map town-buf tlc-bytes
    when tlc-decode town-buf tlc-bytes t.vendors t.items map t.now
      is Err (e) -> print-line-uni ("FAIL base town restore " & e)
      is Ok (town) -> when tnlc-decode buf size town map
        is Err (e) -> print-line-uni ("FAIL neural restore " & e)
        is Ok (restored) -> act
          first <- list-at n.agents 0
          loaded <- list-at restored.agents 0
          tnp-check "TNL1 restores frozen model emotions pending queue consent and audit" (is-ok encoded & is-ok town-encoded & restored.model-id == n.model-id
            & loaded.thoughts == first.thoughts & loaded.state.head == first.state.head & loaded.prepared == first.prepared
            & tn-happiness loaded.state == tn-happiness first.state & tn-alarm loaded.state == tn-alarm first.state
            & restored.actions.book.offer-count == n.actions.book.offer-count & restored.actions.book.event-count == n.actions.book.event-count)
          tnp-check "TNL1 restores each resident's speech outlook and alarm into the town" ((tn-opinion first.state 0 /= 0 | tn-opinion first.state 1 /= 0 | tn-alarm first.state /= 0)
            & list-at town.feel 0 == tn-opinion first.state 0 & list-at town.feel 1 == tn-opinion first.state 1 & list-at town.feel 2 == tn-alarm first.state)
          tnp-check "TNL1 restores controlled route after TLC1 reset" ((list-at town.residents 0).control.expires == (list-at t.residents 0).control.expires
            & (list-at town.residents 0).control.vendor == (list-at t.residents 0).control.vendor)
          tnp-check "TNL1 writes no copy: identity, totals, counts and the proposal actor are zero bytes and prepared is a flag" (tnp-zero-copies buf 0
            & peek-qword buf (tnlc-agent-at + tnlc-agent-bytes + 840) == 0 & peek-qword buf (tnlc-agent-at + tnlc-agent-bytes + 872) == 0)
          tnp-check "TNL1 rebinds identity and derives totals, counts, prepared and the proposal actor" (tnp-derived n restored 0)
          tnp-check "a directed work control's goal, place and target are recomputed on restore" (directed == 0
            & (list-at t.residents 1).control.action == 1 & (list-at t.residents 1).control.target.x /= 0
            & tnp-control-same (list-at t.residents 1).control (list-at town.residents 1).control)
          previous <- list-at first.state.inputs 0
          separate <- tn-input loaded.state 0 (if previous == 1000 then 0 else 1000)
          tnp-check "restored neural buffers are independent" (separate == 0 & list-at first.state.inputs 0 == previous)
          expires <- (list-at town.residents 2).control.expires
          bad-model <- poke-qword buf 24 (bit-xor n.model-id 1)
          hash <- poke-qword buf 48 (ws-hash buf size 0 2166136261)
          refused <- tnlc-decode buf size town map
          tnp-check "changed model refuses before borrowed route mutation" (is-err refused & (list-at town.residents 2).control.expires == expires)
          reset <- poke-qword buf 24 n.model-id
          goal-before <- peek-qword buf (tnlc-agent-at + 2 * tnlc-agent-bytes + 840)
          malformed <- poke-qword buf (tnlc-agent-at + 2 * tnlc-agent-bytes + 840) 99
          hash2 <- poke-qword buf 48 (ws-hash buf size 0 2166136261)
          final-row <- tnlc-decode buf size town map
          tnp-check "late malformed route and short bytes refuse atomically" (is-err final-row & is-err (tnlc-decode 0 0 town map) & (list-at town.residents 2).control.expires == expires)
          count <- restored.actions.book.event-count
          pressure <- __record-set restored.actions.book "event-count" 1024
          thoughts <- loaded.thoughts
          head <- loaded.state.head
          held <- tnv-infer restored loaded
          tnp-check "audit pressure preserves neural queue and recurrent state" (held == -14 & loaded.thoughts == thoughts & loaded.state.head == head)
          available <- __record-set restored.actions.book "event-count" count
          print-line-uni ("live-network-codec-bytes=" & show size)
          fixed <- poke-qword buf (tnlc-agent-at + 2 * tnlc-agent-bytes + 840) goal-before
          rehashed <- poke-qword buf 48 (ws-hash buf size 0 2166136261)
          tnp-owner-rows n map buf size town-buf
        end
  end
  tnp-live : TownLive, WalkMap -> [Console] Nothing
  tnp-live (t) (map) = when tnv-new t
    is Err (e) -> act print-line-uni ("FAIL network " & e) end
    is Ok (n) -> act
      clock <- tnp-hours t.vendors.currency 9
      policy <- gla-market n.actions True
      baseline <- n.actions.book.event-count
      first <- tnv-advance n map None 32400 1 1
      a <- list-at n.agents 0
      b <- list-at n.agents 1
      tnp-check "decision budget runs one resident through the frozen network" (clock & policy == 0 & is-ok first & a.thoughts == 1 & b.thoughts == 0)
      tnp-check "frozen queue proposals pass the live validator" (a.state.count > 0 & n.actions.book.event-count == baseline + 1
        & (list-at n.actions.book.events baseline).kind == list-at a.state.queue 0 + 1)
      peak <- tnp-rounds n map 1 32 0
      tnp-check "bounded rounds retain per-resident emotions, speech outlooks and actor identity" (peak >= 0 & tnp-identities n 0)
      tnp-check "live feature roles and residence hours retain training meanings" (list-at b.state.inputs 11 == 1000
        & list-at a.state.inputs 11 == 0 & a.total == 9 & list-at a.hours 0 == 9)
      tnp-check "live model actions preserve currency and material census" (euv-valid t.vendors.currency & ep-census t.vendors.currency.world 1 & gvsc-valid t.vendors)
      print-line-uni ("neural-round-peak-scratch=" & show peak)
      print-line-uni ("first-action=" & show (list-at a.state.queue 0 + 1) & " happiness=" & show (tn-happiness a.state) & " alarm=" & show (tn-alarm a.state))
      tnp-codec n map
    end
  tnp-run : GameShard, WalkMap, EuCurrency -> [Console] Nothing
  tnp-run (game) (map) (currency) = let v = gv-new game currency
    in let items = gsi-new game.world
    in let growing = bb-fixture-grow v items
    in when bb-populate v items map
      is Err (e) -> act print-line-uni ("FAIL shops " & e) end
      is Ok (_) -> when tl-populate v items map None 0 3
        is Err (e) -> act print-line-uni ("FAIL residents " & e) end
        is Ok (t) -> tnp-live t map
  opening : [Console] Nothing = when bb-economy 0
    is Err (e) -> act print-line-uni ("FAIL economy " & e) end
    is Ok (currency) -> when world-new 128
      is Err (e) -> act print-line-uni ("FAIL world " & e) end
      is Ok (world) -> let shard-accounts = ga-new ga-dev
        in let chars = ga-working shard-accounts
        in let game = GameShard { world = world, characters = chars, accounts = shard-accounts, next-key = 305419895, pending-key = 0, active = 0, log = slg-new slg-trace, skills = chs-new 0 }
        in when walk-map-new 1408 1536 128 224
          is Err (e) -> act print-line-uni ("FAIL map " & e) end
          is Ok (map) -> if tnp-fill map 0 then tnp-run game map currency else act print-line-uni "FAIL terrain" end

