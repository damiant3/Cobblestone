    fruit-bed <- gh-site-find s.harvest 16 1223 1600 0 0
    at-fruit <- world-update shard.world (gs-mobile input.session.serial 1223 1602 0 400 0)
    chop <-cpr-handler-at s shard input map 2593 (gp-put32 [6] axe) 50000
    fruit-chop <- cpl-handler pl s.harvest None shard input map (cpp-aim (list-at s.harvest.requests 0).target (cpl-serial-base + fruit-bed * 2 + 1)) 50001
    cpp-check "a hatchet aimed at an apple tree says to pick it by hand, once (F45)" (fruit-bed >= 0 & cpp-note fruit-chop "Pick its fruit by hand." & (list-at s.harvest.requests 0).target == 0)
    timber-bed <- gh-site-find s.harvest 15 1219 1600 0 0
    at-timber <- world-update shard.world (gs-mobile input.session.serial 1219 1602 0 400 0)
    timber-logs <- ep-at p.stock 15
    roll10 <- __record-set p "attempts" 0
    timber-solid <- (when walk-map-sized 1209 1590 20 20 8 is Err (_) -> 0 - 1 is Ok (farm) -> cpp-chop-bed s shard input farm axe (max 0 timber-bed) 60000)
    cpp-check "a hatchet chops the Royal Test Farm's crown timber bed for logs, as any player may (UOAIX-58)" (timber-bed >= 0 & timber-solid >= 1 & ep-at p.stock 15 > timber-logs & (cpl-node s.harvest timber-bed).stage == 0)
    old-mark <- world-create s.harvest.items.world (WorldObject { serial = 0, kind = 2, x = 5361, y = 74, z = 40, graphic = gh-vein-art, hue = gh-vein-hue, container = 0, amount = 1, health = 0 })
    dropped <- world-create s.harvest.items.world (WorldObject { serial = 0, kind = 2, x = 5362, y = 77, z = 36, graphic = gh-vein-art, hue = gh-vein-hue, container = 0, amount = 1, health = 0 })
    found-gold <- ep-find w w.mint-owner 6 1
    dropped-lot <- when dropped is Err (_) -> -1 is Ok (d) -> gv-add-lot s.harvest.vendor d w.mint-owner 6 1000 32 0
    royal <- cpr-royal-install s
    royal-again <- cpr-royal-install s
    vein <- gh-site-find s.harvest 5 5361 74 40 0
    vein-node <- if vein < 0 then 0 else (list-at s.harvest.sites vein).node
    unmarked <- cpr-vein-mark-at s.harvest.vendor s.harvest.items.world (world-tile-first s.harvest.items.world 5361 74) == 0 & cpr-vein-mark-at s.harvest.vendor s.harvest.items.world (world-tile-first s.harvest.items.world 5362 77) == 0
    cpp-check "no Royal Mine vein carries a marker, an older world's ore pile is removed, and each vein is found by its column from any z (UOAIX-86)" (is-ok old-mark & unmarked & gh-site-column s.harvest 5 5361 74 0 == vein & gh-site-column s.harvest 5 5362 77 0 >= 0)
    cpp-check "a player's gold ore dropped on a Royal Mine vein wears the old marker's art and hue but is a lot, and the marker removal keeps it (UOAIX-105)" (found-gold == 0 & dropped-lot >= 0
      & (when dropped is Err (_) -> False is Ok (d) -> is-ok (world-get s.harvest.items.world d)))
    crown-actor <- ep-actor w w.mint-owner
    crown-pick <- eh-add-yield w crown-actor 25 1 1000
    gold-before <- ep-at crown-actor.stock 6
    royal-gold <- cpp-mine w w.mint-owner vein-node 40
    cpp-check "a Royal Mine vein yields gold and stays minable: perma gold (UOAIX-86)" (royal-gold > 0 & ep-at crown-actor.stock 6 > gold-before & (list-at w.nodes (max 0 (vein-node - 1))).stage == 2)
    cpp-check "the Royal Mine installs four gold veins on Wind's rock and a fixed return gate, once (UOAIX-60)" (royal == 5 & royal-again == 0 & vein >= 0 & vein-node > 0
      & (list-at w.nodes (max 0 (vein-node - 1))).resource == 6 & cpr-gate-at s.harvest.items.world (world-tile-first s.harvest.items.world cpr-royal-gate-x cpr-royal-gate-y))
    royal-place <- crown-actor.place
    warranted <- eh-appoint w True 1 p.place
    veins-twice <- cpp-veins-dug s w 1 cpr-royal-veins 0
    print-line-uni ("ROYAL veins dug twice by a warranted miner: " & show veins-twice & " of 4")
    crown-moved <- ep-place w w.mint-owner (royal-place + 1)
    veins-after <- cpp-veins-dug s w 1 cpr-royal-veins 0
    print-line-uni ("ROYAL veins dug twice after the crown's place moved: " & show veins-after & " of 4")
    crown-home <- ep-place w w.mint-owner royal-place
    stale-at <- gh-site-column s.harvest 5 5362 77 0
    stale-node <- if stale-at < 0 then 0 else (list-at s.harvest.sites stale-at).node
    stale <- list-at w.nodes (max 0 (stale-node - 1))
    staled <- __record-set stale "place" royal-place
    emptied <- __record-set stale "stage" 0
    reinstalled <- cpr-royal-install s
    veins-healed <- cpp-veins-dug s w 1 cpr-royal-veins 0
    print-line-uni ("ROYAL veins dug twice after an older world's depleted vein reinstalls: " & show veins-healed & " of 4")
    cpp-check "each of the four Royal Mine veins yields gold twice to a miner warranted elsewhere and stays minable, after the crown's own place moves, and an older world's depleted vein is restored at install (Damian live at 5362,77, 2026-10-07)" (warranted >= 0 & veins-twice == 4 & veins-after == 4
      & stale-node > 0 & veins-healed == 4 & stale.place == eh-mine-place & stale.stage == 2)
    mill <- cpr-mill-install s.harvest.items 0
    mill-again <- cpr-mill-install s.harvest.items 0
    mw <- s.harvest.items.world
    cpp-check "the bakery mill installs ServUO's three flour-mill pieces in Good Eats, once (UOAIX-55)" (mill == 3 & mill-again == 0
      & cpr-art-at mw (world-tile-first mw 1449 1617) #1920 & cpr-art-at mw (world-tile-first mw 1450 1617) #1922 & cpr-art-at mw (world-tile-first mw 1451 1617) #1924)
    foreign <- cpr-handler-at s shard input map 2593 [#09,0,0,0,9] 3000
    cpp-check "unrelated packets fall through" (when foreign is Ok (None) -> True is otherwise -> False)
    minter-made <- cmr-install s.harvest.items
    minter-again <- cmr-install s.harvest.items
    minter <- cmr-serial s.harvest.items.world
    minter-name <- cmr-handler s.harvest shard input (gp-put32 [9] minter)
    cpp-check "the Royal Minter stands once in the castle's mint room and a click names him" (minter-made == 1 & minter-again == 0 & minter > 0 & cpp-note minter-name "minter:name")
    copper-owner <- __record-set v.currency "copper-owner" crown
    copper-yield <- __record-set v.currency "copper-yield" 1000
    rehoured <- __record-set w "hour" w.money.hour
    ingots <- cpp-stuff v s.harvest.items pack 65 #1BE6 3
    far-drop <- cmr-handler s.harvest shard input (cpp-drop ingots minter)
    cpp-check "copper ingots dropped on the minter from out of reach bounce back with 0x27 reason 5, so the client adds no text of its own (UOAIX-114)" (ingots > 0 & cpp-note far-drop "minter refused" & gv-lot v ingots 0 >= 0 & list-at (list-at (cpp-packets far-drop) 0) 0 == #27 & list-at (list-at (cpp-packets far-drop) 0) 1 == 5)
    walked <- world-update shard.world (gs-mobile input.session.serial (cmr-x - 1) cmr-y cmr-z 400 0)
    home <- p.place
    copper-before <- (em-purse v.currency.copper p.purse).coin
    treasury-before <- (em-purse v.currency.copper 1).coin
    struck <- cmr-handler s.harvest shard input (cpp-drop ingots minter)
    cpp-check "beside the minter the stack is struck: 3 copper ingots pay 2700 copper and the Crown keeps 300 (UOAIX-75)" (cpp-note struck "minter struck" & (em-purse v.currency.copper p.purse).coin == copper-before + 2700 & (em-purse v.currency.copper 1).coin == treasury-before + 300 & gv-lot v ingots 0 < 0 & ep-at p.stock 65 == 0 & p.place == home & ep-census w 1)
    keeper <- (list-at v.players 0).actor
    held <- cpp-stuff v s.harvest.items pack 65 #1BF2 2
    keeping <- __record-set v.currency "copper-owner" keeper
    minting <- __record-set w "mint-owner" keeper
    keeper-coin <- (em-purse v.currency.copper p.purse).coin
    keeper-treasury <- (em-purse v.currency.copper 1).coin
    keeper-drop <- cmr-handler s.harvest shard input (cpp-drop held minter)
    cpp-check "the keeper of the copper coinage strikes into the royal treasury and is told so: 2 ingots, 2000 copper coins in the treasury, none in the purse (UOAIX-114)" (held > 0 & cpp-note keeper-drop "minter struck" & cpp-says keeper-drop "The minter strikes 2 ingots: 2000 copper coins struck into the royal treasury." & (em-purse v.currency.copper 1).coin == keeper-treasury + 2000 & (em-purse v.currency.copper p.purse).coin == keeper-coin & gv-lot v held 0 < 0 & ep-at p.stock 65 == 0)
    crown-again <- __record-set v.currency "copper-owner" crown
    crown-mint <- __record-set w "mint-owner" crown
    held2 <- cpp-stuff v s.harvest.items pack 65 #1BF2 2
    no-rate <- __record-set v.currency "copper-yield" 0
    rateless <- cmr-handler s.harvest shard input (cpp-drop held2 minter)
    rated <- __record-set v.currency "copper-yield" 1000
    cpp-check "at a copper rate of 0 the minter refuses with the true reason and keeps the ingots (UOAIX-114)" (cpp-note rateless "minter refused" & cpp-says rateless "The mint strikes no coin from those ingots at its present rate." & gv-lot v held2 0 >= 0 & ep-at p.stock 65 == 2)
    restruck <- cmr-handler s.harvest shard input (cpp-drop held2 minter)
    cpp-check "a subject's 2 ingots strike for 1800 copper into the purse" (cpp-note restruck "minter struck" & (em-purse v.currency.copper p.purse).coin == keeper-coin + 1800 & gv-lot v held2 0 < 0 & ep-at p.stock 65 == 0)
    banks <- gmb-new s.harvest.items #4A
    banker <- (when world-create shard.world (gs-mobile 0 (cmr-x - 2) cmr-y cmr-z 400 1002) is Err (_) -> 0 is Ok (b) -> b)
    banked <- gmb-add-banker banks banker
    subject-asks <- cmr-treasury s.harvest banks shard input (cpp-say "treasury")
    bound-before <- peek-qword shard.accounts 8
    logged-before <- peek-qword shard.accounts 56
    as-british <- poke-qword shard.accounts 8 (ga-british shard.accounts)
    as-logged <- poke-qword shard.accounts 56 1
    told <- cmr-treasury s.harvest banks shard input (cpp-say "treasury")
    unbound <- poke-qword shard.accounts 8 bound-before
    unlogged <- poke-qword shard.accounts 56 logged-before
    treasury-text <- "The royal treasury holds " & show (em-purse v.currency.copper 1).coin & " copper, " & show (em-purse v.currency.silver 1).coin & " silver and " & show (em-purse w.money 1).coin & " gold coins."
    cpp-check "British saying treasury beside a banker hears the royal treasury per metal; a subject is not answered (UOAIX-114)" (banker > 0 & banked == 0 & ga-british shard.accounts >= 0 & (when subject-asks is Ok (None) -> True is otherwise -> False) & cpp-note told "minter:treasury" & cpp-says told treasury-text)
    old-cells <- eg-cells w.catalog
    britain <- __record-set w "catalog" (bb-catalog 0)
    refit <- cpp-refit v old-cells (eg-cells w.catalog)
    vines <- cpl-farm-install s.harvest
    grape-bed <- gh-site-find s.harvest 27 1215 1600 0 0
    vine-view <- cpl-view pl s.harvest 9 1215 1600
    grapes <- ep-at p.stock 78
    cuttings <- ep-at p.stock 79
    at-grapes <- world-update shard.world (gs-mobile input.session.serial 1215 1602 0 400 0)
    grape-roll <- __record-set p "attempts" 0
    grape-reap <- cpl-handler pl s.harvest None shard input map (gp-put32 [6] (cpl-serial-base + grape-bed * 2 + 1)) 40000
    grape-saved <- ghc-encode s.harvest 70000 (alloc-bytes (ghc-size 256)) (ghc-size 256)
    cpp-check "on the Britain catalog the Royal Test Farm adds a crown grapevine bed (resource 27) at 1215,1600, drawn as grapevines 0D1D with the movable flag, reaped by hand for grapes (09D1) and no cutting, and saved by the harvest codec (UOAIX-58)" (vines >= 1 & grape-bed >= 0
      & cpp-drawn vine-view (cpl-serial-base + grape-bed * 2 + 1) 0 == #0D1D & cpp-flag vine-view (cpl-serial-base + grape-bed * 2 + 1) 0 == #20
      & ep-at p.stock 78 > grapes & ep-at p.stock 79 == cuttings & cpp-art grape-reap #09D1 0 & not (cpp-art grape-reap #0C68 0) & is-ok grape-saved)
    bare-bed <- cpl-view pl s.harvest 9 1215 1600
    reaped-grapes <- ep-at p.stock 78
    grape-roll2 <- __record-set p "attempts" 0
    bare-pick <- cpl-handler pl s.harvest None shard input map (gp-put32 [6] (cpl-serial-base + grape-bed * 2 + 1)) 40001
    vine-regrown <- __record-set (cpl-node s.harvest grape-bed) "ready" 0
    ripe-bed <- cpl-view pl s.harvest 9 1215 1600
    cpp-check "a picked grapevine stays up, draws the same vine unhued (UOAIX-112: text tells it apart), refuses a pick until its grapes regrow, then draws ripe again" ((cpl-node s.harvest grape-bed).stage == 2
      & cpp-drawn bare-bed (cpl-serial-base + grape-bed * 2 + 1) 0 == #0D1D & cpp-hue bare-bed (cpl-serial-base + grape-bed * 2 + 1) 0 == 0 & cpp-note bare-pick "There are no grapes on it yet."
      & ep-at p.stock 78 == reaped-grapes & cpp-drawn ripe-bed (cpl-serial-base + grape-bed * 2 + 1) 0 == #0D1D & cpp-hue ripe-bed (cpl-serial-base + grape-bed * 2 + 1) 0 == 0)
    gw <- s.harvest.vendor.currency.world
    grape-lot <- cpp-lot s.harvest.vendor 78 0
    fed-before <- ev-actors gw 0
    eaten <- cpp-eat s.harvest.vendor input.session.serial grape-lot
    cpp-check "eating one fine grape (cg-eat's lot debit) keeps the eater's grapes within 1000 quality a unit, so the next save is accepted (UOAIX-110)" (grape-lot > 0 & fed-before & eaten & ep-at p.stock 78 > 0 & ep-at p.quality 78 <= ep-at p.stock 78 * 1000 & ev-actors gw 0)
    rest <- cpp-eat-all s.harvest.vendor input.session.serial 78 (ep-at p.stock 78)
    cpp-check "eating the last grape leaves no quality, wear or cost on zero grapes (UOAIX-110)" (rest == 0 & ep-at p.stock 78 == 0 & ep-at p.quality 78 == 0 & ep-at p.wear 78 == 0 & ep-at p.cost 78 == 0 & ev-actors gw 0)
  end
  cpp-copy-cells : Integer, Integer, Integer, Integer -> Integer
  cpp-copy-cells (from) (to) (i) (n) = if i == n then 0 else let a = poke-qword to (i * 8) (peek-qword from (i * 8)) in cpp-copy-cells from to (i + 1) n
  cpp-widen : Integer, Integer, Integer -> Integer
  cpp-widen (old) (from) (to) = let fresh = ep-buffer to in let copied = cpp-copy-cells old fresh 0 from in fresh
  cpp-refit-actors : List EpActor, Integer, Integer, Integer -> Integer
  cpp-refit-actors (xs) (i) (from) (to) = if i == list-length xs then 0
    else let p = list-at xs i
    in let a = __record-set p "stock" (cpp-widen p.stock from to)
    in let b = __record-set p "quality" (cpp-widen p.quality from to)
    in let c = __record-set p "cost" (cpp-widen p.cost from to)
    in let d = __record-set p "wear" (cpp-widen p.wear from to) in cpp-refit-actors xs (i + 1) from to
  cpp-refit-prices : List GvVendor, Integer, Integer, Integer -> Integer
  cpp-refit-prices (xs) (i) (from) (to) = if i == list-length xs then 0
    else let a = __record-set (list-at xs i) "prices" (cpp-widen (list-at xs i).prices from to) in cpp-refit-prices xs (i + 1) from to
 A world's per-item arrays are as wide as the catalog it was founded on; swapping in a wider catalog on a live world must
 widen them, or an item past the old width writes into the next array.
  cpp-refit : GvWorld, Integer, Integer -> Integer
  cpp-refit (v) (from) (to) = let w = v.currency.world
    in let a = cpp-refit-actors w.actors 0 from to
    in let b = __record-set w "gathered" (cpp-widen w.gathered from to)
    in let c = __record-set w "found" (cpp-widen w.found from to)
    in let d = __record-set w "taxed" (cpp-widen w.taxed from to)
    in let e = __record-set w "crafted" (cpp-widen w.crafted from to)
    in let f = __record-set w "consumed" (cpp-widen w.consumed from to)
    in let g = __record-set w "sales" (cpp-widen w.sales from to)
    in let h = __record-set w "opening" (cpp-widen w.opening (ep-open-sales + from) (ep-open-sales + to))
    in cpp-refit-prices v.vendors 0 from to
  cpp-drop : Integer, Integer -> List Integer
  cpp-drop (item) (target) = gp-put32 (list-push (gp-put16 (gp-put16 (gp-put32 [8] item) #FFFF) #FFFF) 0) target
  cpp-run : GameShard, WalkMap, EuCurrency, Integer -> [Console] Nothing
  cpp-run (shard) (map) (currency) (tiles) = act
    tools <- cpp-tools currency.world
    cpp-check "tool bootstrap uses gathering and recipes" tools
    input <- gn-input-with (gsi-specs 0) 1
    when gs-relay-key shard
      is Err (e) -> print-line-uni ("FAIL relay " & e)
      is Ok (key) -> act
        keyed <- __record-set input.session "key" key
        login <- gs-handle shard input.session map (cpp-login key)
        created <- gs-handle shard input.session map (cpp-create 0)
        mode <- __record-set input "mode" 2
        v <- gv-new shard currency
        items <- gsi-new shard.world
        actor <- gsi-session items shard input 0
        when gsi-pack items actor
          is Err (e) -> print-line-uni ("FAIL pack " & e)
          is Ok (pack) -> act
            bound <- gv-add-player v input.session.serial 1 pack.serial
            tiled <- __record-set items "tiles" tiles
            s <- cpr-new v items
            cpp-workshops v map input.session.serial
            cpp-live s shard input map pack.serial
          end
      end
  end
  opening : [Console] Nothing = act
    when walk-map-sized 1412 1690 20 20 8
      is Err (e) -> print-line-uni ("FAIL map " & e)
      is Ok (map) -> act
        fill <- cpp-fill map 0
        mountain <- walk-set-land map 1419 1698 0 (mt-mark 220 64)
        mountainside <- walk-set-land map 1417 1698 0 (mt-mark 243 0)
        impassable <- walk-set-land map 1416 1698 0 (mt-mark 100 64)
        water <- walk-set-land map 1420 1701 0 128
        tree <- walk-add-solid map 1421 1699 0 20 64
        wall <- walk-add-solid map 1422 1699 0 20 80
        rock <- walk-add-solid map 1423 1699 0 10 64
        pool <- walk-add-solid map 1424 1699 0 0 192
        moat <- walk-add-solid map 1426 1699 (0 - 5) 0 193
        oven <- walk-add-solid map 1418 1699 0 20 64
        far-oven <- walk-add-solid map 1430 1699 0 20 64
        tiles <- ep-buffer 76032
        a <- cpp-tile tiles #0CCA 64 20
        b <- cpp-tile tiles #053B 64 10
        c <- cpp-tile tiles #1797 192 0
        d <- cpp-tile tiles #0CDA 64 20
        walnut <- cpp-tile tiles #0CE0 64 20
        apple <- cpp-tile tiles #0D94 64 20
        baking <- cpp-tile tiles #0461 64 20
        stone-oven <- cpp-tile tiles #092C 64 20
        cpp-lookups map tiles
        when gs-new 128
          is Err (e) -> print-line-uni ("FAIL shard " & e)
          is Ok (shard) -> when gvd-economy 0
            is Err (e) -> print-line-uni ("FAIL economy " & e)
            is Ok (currency) -> cpp-run shard map currency tiles
      end
  end
