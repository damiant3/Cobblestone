Chapter: MageryData

 GPL-2.0 port of ServUO Spells/First, Second, Third, Fourth/Recall and
 Base/MagerySpell. Classic, pre-AOS costs and cast delays. Source-X supplies
 spell IDs and legacy spellbook protocol; attribution: Magery.md.

  mgd-supported : Integer -> Boolean
  mgd-supported (spell) = (spell >= 1 & spell <= 24) | spell == 32
  mgd-circle : Integer -> Integer
  mgd-circle (spell) = (spell - 1) / 8
  mgd-mana : Integer -> Integer
  mgd-mana (spell) = if spell <= 8 then 4 else if spell <= 16 then 6 else if spell <= 24 then 9 else 11
  mgd-ticks : Integer -> Integer
  mgd-ticks (milliseconds) = (milliseconds * pit-input-hz + 1000 * pit-count - 1) / (1000 * pit-count)
  mgd-delay : Integer -> Integer
  mgd-delay (spell) = mgd-ticks (500 + 250 * mgd-circle spell)
  mgd-reagent : Integer -> Integer
  mgd-reagent (i) = if i == 0 then #0F7A else if i == 1 then #0F7B else if i == 2 then #0F84
    else if i == 3 then #0F85 else if i == 4 then #0F86 else if i == 5 then #0F88 else if i == 6 then #0F8D else #0F8C
  mgd-two : Integer, Integer -> Integer
  mgd-two (a) (b) = bit-or (bit-shl 1 a) (bit-shl 1 b)
  mgd-three : Integer, Integer, Integer -> Integer
  mgd-three (a) (b) (c) = bit-or (mgd-two a b) (bit-shl 1 c)
  mgd-reagents : Integer -> Integer
  mgd-reagents (spell) = if spell == 1 then mgd-two 1 5
    else if spell == 2 then mgd-three 2 3 4
    else if spell == 3 then mgd-two 3 5
    else if spell == 4 then mgd-three 2 3 6
    else if spell == 5 then bit-shl 1 7
    else if spell == 6 then mgd-two 7 6
    else if spell == 7 then mgd-three 2 6 7
    else if spell == 8 then mgd-two 2 5
    else if spell == 9 then mgd-two 1 4
    else if spell == 10 then mgd-two 4 5
    else if spell == 11 then mgd-two 2 3
    else if spell == 12 then mgd-two 5 6
    else if spell == 13 then mgd-three 2 6 7
    else if spell == 14 then mgd-two 1 7
    else if spell == 15 then mgd-three 2 3 7
    else if spell == 16 then mgd-two 4 5
    else if spell == 17 then mgd-two 2 4
    else if spell == 18 then 1
    else if spell == 19 then mgd-three 2 1 7
    else if spell == 20 then bit-shl 1 5
    else if spell == 21 | spell == 22 then mgd-two 1 4
    else if spell == 23 then mgd-two 1 7
    else if spell == 24 then mgd-two 1 2
    else if spell == 32 then mgd-three 0 1 4 else 0
  mgd-words : Integer -> Text
  mgd-words (spell) = if spell == 1 then "Uus Jux" else if spell == 2 then "In Mani Ylem"
    else if spell == 3 then "Rel Wis" else if spell == 4 then "In Mani"
    else if spell == 5 then "In Por Ylem" else if spell == 6 then "In Lor"
    else if spell == 7 then "Flam Sanct" else if spell == 8 then "Des Mani"
    else if spell == 9 then "Ex Uus" else if spell == 10 then "Uus Wis"
    else if spell == 11 then "An Nox" else if spell == 12 then "An Mani"
    else if spell == 13 then "In Jux" else if spell == 14 then "An Jux"
    else if spell == 15 then "Uus Sanct" else if spell == 16 then "Uus Mani"
    else if spell == 17 then "Rel Sanct" else if spell == 18 then "Vas Flam"
    else if spell == 19 then "An Por" else if spell == 20 then "In Nox"
    else if spell == 21 then "Ort Por Ylem" else if spell == 22 then "Rel Por"
    else if spell == 23 then "Ex Por" else if spell == 24 then "In Sanct Ylem" else "Kal Ort Por"
  mgd-harmful : Integer -> Boolean
  mgd-harmful (spell) = spell == 1 | spell == 3 | spell == 5 | spell == 8 | spell == 12 | spell == 18 | spell == 20
  mgd-beneficial : Integer -> Boolean
  mgd-beneficial (spell) = spell == 4 | spell == 6 | spell == 9 | spell == 10 | spell == 11 | spell == 16 | spell == 17
  mgd-ground : Integer -> Boolean
  mgd-ground (spell) = spell == 22 | spell == 24
  mgd-self : Integer -> Boolean
  mgd-self (spell) = spell == 2 | spell == 7 | spell == 15
  mgd-poison-threshold : Integer, Integer, Integer, Boolean -> Boolean
  mgd-poison-threshold (skill) (distance-squared) (threshold) (inclusive) =
    if distance-squared <= 9 then if inclusive then skill >= threshold else skill > threshold
    else let left = skill + 300 - threshold
    in if left < 0 then False else if inclusive then left * left >= distance-squared * 10000 else left * left > distance-squared * 10000
  mgd-round : Integer, Integer -> Integer
  mgd-round (numerator) (denominator) = if numerator < 0 then 0 - ((0 - numerator + denominator / 2) / denominator)
    else (numerator + denominator / 2) / denominator
  mgd-root : Integer, Integer, Integer -> Integer
  mgd-root (value) (low) (high) = if low > high then high else let mid = low + (high - low) / 2
    in if mid * mid <= value then mgd-root value (mid + 1) high else mgd-root value low (mid - 1)
  mgd-disturb : Integer, Integer -> Integer
  mgd-disturb (elapsed) (duration) = let fraction = min 1000000 (max 0 elapsed * 1000000 / max 1 duration)
    in mgd-ticks (max 200 (1000 - mgd-root fraction 0 1000))
