Chapter: MageryData

 GPL-2.0 port of ServUO Spells/First, Second, Third, Fourth/Recall, Fourth/ArchCure, ArchProtection, Curse, GreaterHeal, Lightning and ManaDrain, Fifth/Incognito, MindBlast and Paralyze, Sixth/EnergyBolt, Explosion, Mark and
 MassCurse, Seventh/ChainLightning, EnergyField, FlameStrike, ManaVampire and MeteorSwarm, Eighth/Earthquake, and
 Base/MagerySpell. Classic, pre-AOS costs and cast delays. Source-X supplies
 spell IDs and legacy spellbook protocol; attribution: Magery.md.

  mgd-supported : Integer -> Boolean
  mgd-supported (spell) = (spell >= 1 & spell <= 32) | spell == 35 | spell == 36 | spell == 37 | spell == 38 | spell == 39 | spell == 47 | spell == 42 | spell == 43 | spell == 45 | spell == 46 | spell == 49 | spell == 50 | spell == 51 | spell == 53 | spell == 55 | spell == 57
  mgd-circle : Integer -> Integer
  mgd-circle (spell) = (spell - 1) / 8
  mgd-mana : Integer -> Integer
  mgd-mana (spell) = let c = mgd-circle spell in if c == 0 then 4 else if c == 1 then 6 else if c == 2 then 9 else if c == 3 then 11 else if c == 4 then 14 else if c == 5 then 20 else if c == 6 then 40 else 50
  mgd-ticks : Integer -> Integer
  mgd-ticks (milliseconds) = (milliseconds * pit-input-hz + 1000 * pit-count - 1) / (1000 * pit-count)
  mgd-delay : Integer -> Integer
  mgd-delay (spell) = mgd-ticks (500 + 250 * mgd-circle spell)
  mgd-reagent : Integer -> Integer
  mgd-reagent (i) = if i == 0 then #0F7A else if i == 1 then #0F7B else if i == 2 then #0F84
    else if i == 3 then #0F85 else if i == 4 then #0F86 else if i == 5 then #0F88 else if i == 6 then #0F8D else #0F8C
  mgd-two : Integer, Integer -> Integer
  mgd-two (a) (b) = bit-or (bit-shl 1 a) (bit-shl 1 b)
  mgd-three : Integer, Integer, Integer -> Integer
  mgd-three (a) (b) (c) = bit-or (mgd-two a b) (bit-shl 1 c)
  mgd-reagents : Integer -> Integer
  mgd-reagents (spell) = if spell == 1 then mgd-two 1 5
    else if spell == 2 then mgd-three 2 3 4
    else if spell == 3 then mgd-two 3 5
    else if spell == 4 then mgd-three 2 3 6
    else if spell == 5 then bit-shl 1 7
    else if spell == 6 then mgd-two 7 6
    else if spell == 7 then mgd-three 2 6 7
    else if spell == 8 then mgd-two 2 5
    else if spell == 9 then mgd-two 1 4
    else if spell == 10 then mgd-two 4 5
    else if spell == 11 then mgd-two 2 3
    else if spell == 12 then mgd-two 5 6
    else if spell == 13 then mgd-three 2 6 7
    else if spell == 14 then mgd-two 1 7
    else if spell == 15 then mgd-three 2 3 7
    else if spell == 16 then mgd-two 4 5
    else if spell == 17 then mgd-two 2 4
    else if spell == 18 then 1
    else if spell == 19 then mgd-three 2 1 7
    else if spell == 20 then bit-shl 1 5
    else if spell == 21 | spell == 22 then mgd-two 1 4
    else if spell == 23 then mgd-two 1 7
    else if spell == 24 then mgd-two 1 2
    else if spell == 25 then mgd-three 2 3 4
    else if spell == 26 then bit-or (mgd-two 2 3) (mgd-two 4 7)
    else if spell == 27 then mgd-three 2 5 7
    else if spell == 28 then mgd-three 0 6 7
    else if spell == 29 then bit-or (mgd-two 2 3) (mgd-two 4 6)
    else if spell == 30 then mgd-two 4 7
    else if spell == 31 then mgd-three 0 4 6
    else if spell == 32 then mgd-three 0 1 4
    else if spell == 35 then mgd-three 1 2 5
    else if spell == 36 then mgd-three 2 4 6
    else if spell == 37 then bit-or (mgd-two 0 4) (mgd-two 5 7)
    else if spell == 38 then mgd-three 2 4 6
    else if spell == 39 then mgd-three 0 5 6
    else if spell == 42 then mgd-two 0 5
    else if spell == 43 then mgd-two 1 4
    else if spell == 46 then bit-or (mgd-two 2 5) (mgd-two 4 7)
    else if spell == 47 then mgd-three 0 3 6
    else if spell == 49 then bit-or (mgd-two 0 1) (mgd-two 4 7)
    else if spell == 50 then bit-or (mgd-two 0 4) (mgd-two 6 7)
    else if spell == 51 then mgd-two 6 7
    else if spell == 55 then bit-or (mgd-two 1 4) (mgd-two 6 7)
    else if spell == 57 then bit-or (mgd-two 1 3) (mgd-two 4 7)
    else if spell == 53 then bit-or (mgd-two 0 1) (mgd-two 4 6)
    else if spell == 45 then mgd-three 0 1 4 else 0
 Scroll art (ServUO Spells/*Scroll.cs): 0x1F2D is Reactive Armor (spell 7); the others run from 0x1F2E in spell order.
  mgd-scroll : Integer -> Integer
  mgd-scroll (spell) = if spell == 7 then #1F2D else if spell < 7 then #1F2E + spell - 1 else #1F2D + spell - 1
  mgd-scroll-spell : Integer -> Integer
  mgd-scroll-spell (graphic) = if graphic < #1F2D | graphic > #1F6C then 0
    else let spell = if graphic == #1F2D then 7 else if graphic <= #1F33 then graphic - #1F2E + 1 else graphic - #1F2D + 1
    in if mgd-supported spell then spell else 0
  mgd-words : Integer -> Text
  mgd-words (spell) = if spell == 1 then "Uus Jux" else if spell == 2 then "In Mani Ylem"
    else if spell == 3 then "Rel Wis" else if spell == 4 then "In Mani"
    else if spell == 5 then "In Por Ylem" else if spell == 6 then "In Lor"
    else if spell == 7 then "Flam Sanct" else if spell == 8 then "Des Mani"
    else if spell == 9 then "Ex Uus" else if spell == 10 then "Uus Wis"
    else if spell == 11 then "An Nox" else if spell == 12 then "An Mani"
    else if spell == 13 then "In Jux" else if spell == 14 then "An Jux"
    else if spell == 15 then "Uus Sanct" else if spell == 16 then "Uus Mani"
    else if spell == 17 then "Rel Sanct" else if spell == 18 then "Vas Flam"
    else if spell == 19 then "An Por" else if spell == 20 then "In Nox"
    else if spell == 21 then "Ort Por Ylem" else if spell == 22 then "Rel Por"
    else if spell == 23 then "Ex Por" else if spell == 24 then "In Sanct Ylem" else if spell == 32 then "Kal Ort Por" else if spell == 35 then "Kal In Ex" else if spell == 38 then "An Ex Por" else if spell == 27 then "Des Sanct" else if spell == 31 then "Ort Rel" else if spell == 30 then "Por Ort Grav" else if spell == 37 then "Por Corp Wis"
    else if spell == 42 then "Corp Por" else if spell == 43 then "Vas Ort Flam" else if spell == 51 then "Kal Vas Flam"
    else if spell == 25 then "Vas An Nox" else if spell == 26 then "Vas Uus Sanct" else if spell == 29 then "In Vas Mani"
    else if spell == 49 then "Vas Ort Grav" else if spell == 50 then "In Sanct Grav" else if spell == 28 then "In Flam Grav" else if spell == 36 then "In Jux Sanct" else if spell == 39 then "In Nox Grav" else if spell == 47 then "In Ex Grav" else if spell == 55 then "Flam Kal Des Ylem" else if spell == 57 then "In Vas Por"
    else if spell == 46 then "Vas Des Sanct" else if spell == 53 then "Ort Sanct" else "Kal Por Ylem"
  mgd-harmful : Integer -> Boolean
  mgd-harmful (spell) = spell == 1 | spell == 3 | spell == 5 | spell == 8 | spell == 12 | spell == 18 | spell == 20 | spell == 27 | spell == 28 | spell == 30 | spell == 31 | spell == 37 | spell == 38 | spell == 39 | spell == 47 | spell == 42 | spell == 43 | spell == 46 | spell == 49 | spell == 50 | spell == 51 | spell == 53 | spell == 55 | spell == 57
  mgd-beneficial : Integer -> Boolean
  mgd-beneficial (spell) = spell == 4 | spell == 6 | spell == 9 | spell == 10 | spell == 11 | spell == 16 | spell == 17 | spell == 25 | spell == 26 | spell == 29
  mgd-ground : Integer -> Boolean
  mgd-ground (spell) = spell == 22 | spell == 24 | spell == 25 | spell == 26 | spell == 28 | spell == 39 | spell == 47 | spell == 46 | spell == 49 | spell == 50 | spell == 55
  mgd-self : Integer -> Boolean
  mgd-self (spell) = spell == 2 | spell == 7 | spell == 15 | spell == 35 | spell == 36 | spell == 57
  mgd-poison-threshold : Integer, Integer, Integer, Boolean -> Boolean
  mgd-poison-threshold (skill) (distance-squared) (threshold) (inclusive) =
    if distance-squared <= 9 then if inclusive then skill >= threshold else skill > threshold
    else let left = skill + 300 - threshold
    in if left < 0 then False else if inclusive then left * left >= distance-squared * 10000 else left * left > distance-squared * 10000
  mgd-round : Integer, Integer -> Integer
  mgd-round (numerator) (denominator) = if numerator < 0 then 0 - ((0 - numerator + denominator / 2) / denominator)
    else (numerator + denominator / 2) / denominator
  mgd-root : Integer, Integer, Integer -> Integer
  mgd-root (value) (low) (high) = if low > high then high else let mid = low + (high - low) / 2
    in if mid * mid <= value then mgd-root value (mid + 1) high else mgd-root value low (mid - 1)
  mgd-disturb : Integer, Integer -> Integer
  mgd-disturb (elapsed) (duration) = let fraction = min 1000000 (max 0 elapsed * 1000000 / max 1 duration)
    in mgd-ticks (max 200 (1000 - mgd-root fraction 0 1000))
