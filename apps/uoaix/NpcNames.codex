Chapter: NpcNames
  cites Uoaix chapter CharacterStylist

 UOAIX-56: an NPC shows its name and profession to everyone; a player's name is learned. Each NPC name is fixed by
 serial with the stylist's seed (cst-pick, salt 7), and follows the gender the stylist draws (cst-female).
 The composite's known-names section holds nn-limit (character, serial) pairs; the rest travel in its known tail.

 A pair is found through an open-addressed index of 2 x room cells, each a pair's index + 1 (0 empty).
  NnKnown = record { pairs : Integer, count : Integer, room : Integer, index : Integer }
  nn-limit : Integer = 1024
  nn-new : Integer -> NnKnown
  nn-new (unused) = let index = alloc-bytes (nn-limit * 16)
    in let cleared = nn-zero index 0 (nn-limit * 16)
    in NnKnown { pairs = alloc-bytes (nn-limit * 16), count = 0, room = nn-limit, index = index }
  nn-cell : NnKnown, Integer, Integer -> Integer
  nn-cell (k) (character) (npc) = int-mod (bit-and (character * 1000003 + npc) 4611686018427387903) (k.room * 2)
  nn-probe : NnKnown, Integer, Integer, Integer -> Integer
  nn-probe (k) (character) (npc) (cell) = let v = peek-qword k.index (cell * 8)
    in if v == 0 then -1
    else if peek-qword k.pairs ((v - 1) * 16) == character & peek-qword k.pairs ((v - 1) * 16 + 8) == npc then v - 1
    else nn-probe k character npc (int-mod (cell + 1) (k.room * 2))
  nn-place : NnKnown, Integer, Integer -> Integer
  nn-place (k) (i) (cell) = if peek-qword k.index (cell * 8) == 0 then poke-qword k.index (cell * 8) (i + 1)
    else nn-place k i (int-mod (cell + 1) (k.room * 2))
  nn-reindex : NnKnown, Integer -> Integer
  nn-reindex (k) (i) = if i >= k.count then 0
    else let placed = nn-place k i (nn-cell k (peek-qword k.pairs (i * 16)) (peek-qword k.pairs (i * 16 + 8))) in nn-reindex k (i + 1)
  nn-due : NnKnown -> Boolean
  nn-due (k) = k.room - k.count < k.room / 4
  nn-grow-to : NnKnown, Integer -> Integer
  nn-grow-to (k) (room) = if room <= k.room then k.room
    else let fresh = alloc-bytes (room * 16)
    in let copied = nn-copy k.pairs fresh (k.count * 16) 0
    in let index = alloc-bytes (room * 16)
    in let cleared = nn-zero index 0 (room * 16)
    in let a = __record-set k "pairs" fresh
    in let b = __record-set k "room" room
    in let c = __record-set k "index" index
    in let d = nn-reindex k 0 in room
  nn-grow : NnKnown -> Integer
  nn-grow (k) = nn-grow-to k (k.room * 2)
  nn-male : List Text = ["Gareth", "Aldric", "Bram", "Cedric", "Duncan", "Edmund", "Fendrel", "Godwin",
    "Hamon", "Ivo", "Jory", "Kendrick", "Leofric", "Merrick", "Osric", "Tobin"]
  nn-female : List Text = ["Alys", "Brenna", "Cerys", "Dulcie", "Elsbeth", "Fenna", "Gwyneth", "Hester",
    "Isolde", "Joan", "Katrin", "Lisbet", "Maud", "Nessa", "Rowena", "Tilda"]
  nn-name : Integer, Integer -> Text
  nn-name (role) (serial) = if cst-female role serial then list-at nn-female (cst-pick serial 7 (list-length nn-female))
    else list-at nn-male (cst-pick serial 7 (list-length nn-male))
  nn-at : NnKnown, Integer, Integer, Integer -> Integer
  nn-at (k) (character) (npc) (unused) = if character <= 0 | npc <= 0 then -1 else nn-probe k character npc (nn-cell k character npc)
  nn-knows : NnKnown, Integer, Integer -> Boolean
  nn-knows (k) (character) (npc) = nn-at k character npc 0 >= 0
  nn-learn : NnKnown, Integer, Integer -> Integer
  nn-learn (k) (character) (npc) = if character <= 0 | npc <= 0 | nn-knows k character npc then 0
    else if k.count >= k.room then -1
    else let a = poke-qword k.pairs (k.count * 16) character
    in let b = poke-qword k.pairs (k.count * 16 + 8) npc
    in let placed = nn-place k k.count (nn-cell k character npc)
    in let c = __record-set k "count" (k.count + 1) in 1
  nn-bytes : Integer = 8 + nn-limit * 16
  nn-copy : Integer, Integer, Integer, Integer -> Integer
  nn-copy (from) (to) (bytes) (i) = if i >= bytes then 0 else let a = poke-qword to i (peek-qword from i) in nn-copy from to bytes (i + 8)
  nn-encode : NnKnown, Integer -> Integer
  nn-encode (k) (buf) = let kept = min k.count nn-limit
    in let n = poke-qword buf 0 kept
    in let zeroed = nn-zero (buf + 8) (kept * 16) (nn-limit * 16)
    in nn-copy k.pairs (buf + 8) (kept * 16) 0
  nn-tail-size : NnKnown -> Integer
  nn-tail-size (k) = 8 + max 0 (k.count - nn-limit) * 16
  nn-write-tail : NnKnown, Integer -> Integer
  nn-write-tail (k) (at) = let n = max 0 (k.count - nn-limit)
    in let a = poke-qword at 0 n in let b = nn-copy (k.pairs + nn-limit * 16) (at + 8) (n * 16) 0 in at + 8 + n * 16
  nn-tail-length : Integer, Integer -> Integer
  nn-tail-length (at) (room) = if room < 8 | peek-qword at 0 < 0 | peek-qword at 0 > room / 16 then -1 else 8 + peek-qword at 0 * 16
  nn-read-tail : NnKnown, Integer, Integer -> Integer
  nn-read-tail (k) (at) (size) = if nn-tail-length at size /= size then -1
    else let n = peek-qword at 0
    in if n == 0 then 0
    else if k.count /= nn-limit | not (nn-valid-n (at + 8) 0 n) then -1
    else let grown = nn-grow-to k (max k.room (nn-limit + n + (nn-limit + n) / 2))
    in let copied = nn-copy (at + 8) (k.pairs + nn-limit * 16) (n * 16) 0
    in let c = __record-set k "count" (nn-limit + n)
    in let cleared = nn-zero k.index 0 (k.room * 16)
    in let indexed = nn-reindex k 0 in 0
  nn-valid-n : Integer, Integer, Integer -> Boolean
  nn-valid-n (buf) (i) (n) = if i >= n then True else peek-qword buf (i * 16) > 0 & peek-qword buf (i * 16 + 8) > 0 & nn-valid-n buf (i + 1) n
  nn-zero : Integer, Integer, Integer -> Integer
  nn-zero (buf) (i) (stop) = if i >= stop then 0 else let a = poke-qword buf i 0 in nn-zero buf (i + 8) stop
  nn-valid : Integer, Integer, Integer -> Boolean
  nn-valid (buf) (i) (count) = if i == nn-limit then True
    else if i < count then peek-qword buf (i * 16) > 0 & peek-qword buf (i * 16 + 8) > 0 & nn-valid buf (i + 1) count
    else peek-qword buf (i * 16) == 0 & peek-qword buf (i * 16 + 8) == 0 & nn-valid buf (i + 1) count
  nn-decode : NnKnown, Integer -> Result Integer Text
  nn-decode (k) (buf) = let count = peek-qword buf 0
    in if count < 0 | count > nn-limit | not (nn-valid (buf + 8) 0 count) then Err "known names extent"
    else let copied = nn-copy (buf + 8) k.pairs (count * 16) 0
    in let n = __record-set k "count" count
    in let cleared = nn-zero k.index 0 (k.room * 16)
    in let indexed = nn-reindex k 0 in Ok count
 A character not yet known shows the title of its best skill (UOAIX-56): ServUO SkillInfo's skill titles, in skill-id
 order 0-45 (the order of csk-names), GPL-2.0; ports/ServUO-LICENSE.txt.
  nn-titles : List Text = ["alchemist", "biologist", "naturalist", "merchant", "weapon master", "duelist", "beggar",
    "blacksmith", "bowyer", "pacifier", "explorer", "carpenter", "cartographer", "chef", "scout", "demoralizer",
    "scholar", "healer", "fisherman", "detective", "shepherd", "shade", "rouser", "scribe", "infiltrator", "mage",
    "warder", "tactician", "spy", "bard", "assassin", "archer", "medium", "pickpocket", "tailor", "tamer",
    "praegustator", "tinker", "ranger", "veterinarian", "swordsman", "armsman", "fencer", "wrestler", "lumberjack", "miner"]
  nn-profession : Integer -> Text
  nn-profession (skill) = if skill < 0 | skill >= list-length nn-titles then "a stranger"
    else let title = list-at nn-titles skill
    in let first = char-at title 0
    in (if nn-vowel first 0 then "an " else "a ") & title
  nn-vowel : Char, Integer -> Boolean
  nn-vowel (c) (i) = if i == 5 then False else c == char-at "aeiou" i | nn-vowel c (i + 1)
  nn-label : NnKnown, Integer, Integer, Integer, Text -> Text
  nn-label (k) (character) (role) (npc) (profession) = nn-called k character npc (nn-name role npc) profession
  nn-called : NnKnown, Integer, Integer, Text, Text -> Text
  nn-called (k) (character) (npc) (name) (profession) = if name == "" then "the " & profession
    else name & " the " & profession

