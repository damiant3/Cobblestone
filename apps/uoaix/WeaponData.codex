  wpn-low : Integer -> Integer
  wpn-low (w) = int-mod w 256
  wpn-high : Integer -> Integer
  wpn-high (w) = int-mod (w / 256) 256
  wpn-speed : Integer -> Integer
  wpn-speed (w) = int-mod (w / 65536) 256
  wpn-strength : Integer -> Integer
  wpn-strength (w) = int-mod (w / 16777216) 256
  wpn-skill : Integer -> Integer
  wpn-skill (w) = w / 4294967296
