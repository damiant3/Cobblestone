Chapter: CompositeLaunch
  cites Foreword chapter Result
  cites Foreword chapter CCE
  grounds Device.Port

 A launch record is one line: `UOAIX TESTING`, `UOAIX TESTING OPEN` (testing, and the economy opens at boot with no
 client, as British's strike would open it), `UOAIX DEV`, or
 `UOAIX PUBLIC <password>`, which sets account British's password before
 public mode opens. No record is public mode with British's password
 unchanged. Testing implies development account creation. An optional first
 line `ADMIN <key1> <key2> <key3> <key4> <epoch>` (each 64 lowercase hex)
 carries the admin panel's four role keys and epoch, after the AdminProtocol
 contract; without it the server opens no admin port. An optional next line
 `NET <ip> <gateway> <mask>`, dotted quads with the gateway inside the subnet,
 is the static address the NIC answers on (UOAIX.md stage D2); without it the
 server takes QEMU user networking's 10.0.2.15 behind 10.0.2.2.

  CompositeLaunchMode = record { testing : Boolean, dev : Boolean, british : List Integer, admin : List Text, open : Boolean, links : Integer, net : List Integer, ticket : Integer }
 A first line `LINKS <n>` sets the game links: 1 to cl-links-ceiling slots, or 0 for cl-links-ceiling slots admitted at
 login by box load (Damian 2026-10-08; root's policy in GameLinks gl-admission). No line means cl-links-default.
  cl-links-default : Integer = 32
  cl-links-ceiling : Integer = 256
  cl-links : List Integer = [76,73,78,75,83,32]
  cl-number : List Integer, Integer, Integer -> Integer
  cl-number (bytes) (i) (acc) = if i >= list-length bytes | i > 10 then -1
    else let b = list-at bytes i
    in if b == 10 then (if i == 6 then -1 else acc)
    else if b < 48 | b > 57 then -1
    else cl-number bytes (i + 1) (acc * 10 + b - 48)
  cl-line-end : List Integer, Integer -> Integer
  cl-line-end (bytes) (i) = if i >= list-length bytes then -1 else if list-at bytes i == 10 then i else cl-line-end bytes (i + 1)

  cl-testing : List Integer = [85,79,65,73,88,32,84,69,83,84,73,78,71,10]
  cl-testing-open : List Integer = [85,79,65,73,88,32,84,69,83,84,73,78,71,32,79,80,69,78,10]
  cl-dev : List Integer = [85,79,65,73,88,32,68,69,86,10]
  cl-public : List Integer = [85,79,65,73,88,32,80,85,66,76,73,67,32]
  cl-limit : Integer = 448
  cl-matches : List Integer, List Integer, Integer -> Boolean
  cl-matches (bytes) (option) (i) = if i == list-length option then True
    else if list-length bytes <= i | list-at bytes i /= list-at option i then False
    else cl-matches bytes option (i + 1)
  cl-password : List Integer, Integer, List Integer -> Result (List Integer) Text
  cl-password (bytes) (i) (out) = if i >= list-length bytes then Err "public launch password unterminated"
    else let b = list-at bytes i
    in if b == 10 then (if i == list-length bytes - 1 & list-length out >= 1 & list-length out <= 30 then Ok out else Err "public launch password length")
    else if b < 32 | b > 126 then Err "public launch password holds a non-printable character"
    else cl-password bytes (i + 1) (list-push out b)
  cl-parse-mode : List Integer, List Text -> Result CompositeLaunchMode Text
  cl-parse-mode (bytes) (admin) = if list-length bytes == 0 then Ok (CompositeLaunchMode { testing = False, dev = False, british = [], admin = admin, open = False, links = cl-links-default, net = [], ticket = cl-ticket-default })
    else if list-length bytes == list-length cl-testing & cl-matches bytes cl-testing 0 then Ok (CompositeLaunchMode { testing = True, dev = True, british = [], admin = admin, open = False, links = cl-links-default, net = [], ticket = cl-ticket-default })
    else if list-length bytes == list-length cl-testing-open & cl-matches bytes cl-testing-open 0 then Ok (CompositeLaunchMode { testing = True, dev = True, british = [], admin = admin, open = True, links = cl-links-default, net = [], ticket = cl-ticket-default })
    else if list-length bytes == list-length cl-dev & cl-matches bytes cl-dev 0 then Ok (CompositeLaunchMode { testing = False, dev = True, british = [], admin = admin, open = False, links = cl-links-default, net = [], ticket = cl-ticket-default })
    else if cl-matches bytes cl-public 0 then when cl-password bytes (list-length cl-public) []
      is Err (e) -> Err e
      is Ok (password) -> Ok (CompositeLaunchMode { testing = False, dev = False, british = password, admin = admin, open = False, links = cl-links-default, net = [], ticket = cl-ticket-default })
    else Err "unrecognized composite launch option"
  cl-admin : List Integer = [65,68,77,73,78,32]
  cl-admin-bytes : Integer = 331
  cl-hex : List Integer, Integer, Integer -> Boolean
  cl-hex (bytes) (at) (i) = if i == 64 then True
    else let b = list-at bytes (at + i) in ((b >= 48 & b <= 57) | (b >= 97 & b <= 102)) & cl-hex bytes at (i + 1)
  cl-slice : List Integer, Integer, Integer, List Integer -> List Integer
  cl-slice (bytes) (at) (stop) (out) = if at == stop then out else cl-slice bytes (at + 1) stop (list-push out (list-at bytes at))
  cl-admin-keys : List Integer, Integer, List Text -> Result (List Text) Text
  cl-admin-keys (bytes) (k) (out) = if k == 5 then Ok out
    else let at = 6 + k * 65
    in if not (cl-hex bytes at 0) | list-at bytes (at + 64) /= (if k == 4 then 10 else 32) then Err "admin launch line malformed"
    else cl-admin-keys bytes (k + 1) (list-push out (utf8-bytes-to-text (cl-slice bytes at (at + 64) (__list-with-capacity 64))))
 A first line `TICKET <seconds>`, before any `LINKS` line, sets how long a relay ticket admits its game login: 1 to
 cl-ticket-ceiling seconds of guest time. No line means cl-ticket-default, the live replay bound (root, 2026-10-19); a
 launch under codex-vm -clock-scale N passes 120 x N, so the ticket lasts 120 s of wall time.
  cl-ticket-default : Integer = 120
  cl-ticket-ceiling : Integer = 12000
  cl-ticket : List Integer = [84,73,67,75,69,84,32]
  cl-digits : List Integer, Integer, Integer, Integer -> Integer
  cl-digits (bytes) (start) (i) (acc) = if i >= list-length bytes | i > start + 5 then -1
    else let b = list-at bytes i
    in if b == 10 then (if i == start then -1 else acc)
    else if b < 48 | b > 57 then -1
    else cl-digits bytes start (i + 1) (acc * 10 + b - 48)
  cl-parse : List Integer -> Result CompositeLaunchMode Text
  cl-parse (bytes) = if not (cl-matches bytes cl-ticket 0) then cl-parse-links bytes
    else let n = cl-digits bytes 7 7 0
    in let stop = cl-line-end bytes 7
    in if n < 1 | n > cl-ticket-ceiling | stop < 0 then Err "ticket launch line malformed"
    else when cl-parse-links (cl-slice bytes (stop + 1) (list-length bytes) [])
      is Err (e) -> Err e
      is Ok (mode) -> let set = __record-set mode "ticket" n in Ok mode
  cl-parse-links : List Integer -> Result CompositeLaunchMode Text
  cl-parse-links (bytes) = if not (cl-matches bytes cl-links 0) then cl-parse-rest bytes
    else let n = cl-number bytes 6 0
    in let stop = cl-line-end bytes 6
    in if n < 0 | n > cl-links-ceiling | stop < 0 then Err "links launch line malformed"
    else when cl-parse-rest (cl-slice bytes (stop + 1) (list-length bytes) [])
      is Err (e) -> Err e
      is Ok (mode) -> let set = __record-set mode "links" n in Ok mode
  cl-parse-rest : List Integer -> Result CompositeLaunchMode Text
  cl-parse-rest (bytes) = if not (cl-matches bytes cl-admin 0) then cl-parse-net bytes []
    else if list-length bytes < cl-admin-bytes then Err "admin launch line malformed"
    else when cl-admin-keys bytes 0 []
      is Err (e) -> Err e
      is Ok (keys) -> cl-parse-net (cl-slice bytes cl-admin-bytes (list-length bytes) []) keys
  cl-net : List Integer = [78,69,84,32]
  cl-net-default : List Integer = [10,0,2,15,10,0,2,2,255,255,255,0]
  cl-net-walk : List Integer, Integer, Integer, Integer, List Integer -> Result (List Integer) Text
  cl-net-walk (bytes) (i) (value) (digits) (out) = if i >= list-length bytes then Err "net launch line unterminated"
    else let b = list-at bytes i
    in if b >= 48 & b <= 57 then (if digits == 3 then Err "net launch line malformed" else cl-net-walk bytes (i + 1) (value * 10 + b - 48) (digits + 1) out)
    else let k = list-length out
    in if digits == 0 | value > 255 | b /= (if k == 11 then 10 else if k == 3 | k == 7 then 32 else 46) then Err "net launch line malformed"
    else if k == 11 then Ok (list-push out value)
    else cl-net-walk bytes (i + 1) 0 0 (list-push out value)
  cl-net-subnet : List Integer, Integer -> Boolean
  cl-net-subnet (q) (i) = if i == 4 then True
    else bit-and (list-at q i) (list-at q (8 + i)) == bit-and (list-at q (4 + i)) (list-at q (8 + i)) & cl-net-subnet q (i + 1)
  cl-parse-net : List Integer, List Text -> Result CompositeLaunchMode Text
  cl-parse-net (bytes) (admin) = if not (cl-matches bytes cl-net 0) then cl-parse-mode bytes admin
    else when cl-net-walk bytes 4 0 0 (__list-with-capacity 12)
      is Err (e) -> Err e
      is Ok (net) -> if not (cl-net-subnet net 0) then Err "net launch gateway outside the subnet"
        else when cl-parse-mode (cl-slice bytes (cl-line-end bytes 4 + 1) (list-length bytes) []) admin
          is Err (e) -> Err e
          is Ok (mode) -> let set = __record-set mode "net" net in Ok mode
  cl-address : CompositeLaunchMode, Integer -> List Integer
  cl-address (launch) (at) = cl-slice (if list-length launch.net == 12 then launch.net else cl-net-default) at (at + 4) []
  cl-dotted : List Integer -> Text
  cl-dotted (q) = integer-to-text (list-at q 0) & "." & integer-to-text (list-at q 1) & "." & integer-to-text (list-at q 2) & "." & integer-to-text (list-at q 3)

 The codex-vm input-file ABI fills the 1MiB serial ring at #F00000 and
 republishes its write/read counters at28704/28712 on the first UART poll.
 Read only a complete bounded launch record; no console wait or network
 packet can enable a mode. Hosted images supply no testing or dev record.
 QEMU delivers serial input through the UART a byte at a time, so a record
 already arriving at the first poll gets at most cl-settle-fuel batches of
 cl-settle-batch UART polls to end in a `UOAIX ` line; an empty ring at the
 first poll waits up to cl-first-ms for a first byte, because under OVMF the
 firmware reads the serial as console input, so the record can only be sent
 after the stub hands over, about when cl-read runs. Before the guest enables the
 16550 FIFO the UART holds one received byte, and the FIFO reset at boot
 discards it, so a QEMU launcher sends one LF ahead of the record and
 leading LFs are skipped.

  cl-copy-ring : Integer, Integer, Integer, List Integer -> List Integer
  cl-copy-ring (read) (count) (i) (out) = if i == count then out
    else cl-copy-ring read count (i + 1) (list-push out (peek-byte #F00000 (bit-and (read + i) #FFFFF)))
  cl-settle-fuel : Integer = 200000
  cl-settle-batch : Integer = 100
  cl-ring-byte : Integer -> Integer
  cl-ring-byte (at) = peek-byte #F00000 (bit-and at #FFFFF)
  cl-line-start : Integer, Integer -> Integer
  cl-line-start (read) (at) = if at <= read | cl-ring-byte (at - 1) == 10 then at else cl-line-start read (at - 1)
  cl-complete : Integer, Integer -> Boolean
  cl-complete (read) (write) = if write - read < 7 | cl-ring-byte (write - 1) /= 10 then False
    else let start = cl-line-start read (write - 1)
    in write - start >= 7 & cl-ring-matches start cl-public 0 6
  cl-ring-matches : Integer, List Integer, Integer, Integer -> Boolean
  cl-ring-matches (at) (option) (i) (n) = if i == n then True
    else cl-ring-byte (at + i) == list-at option i & cl-ring-matches at option (i + 1) n
  cl-spin : Integer -> [Device.Port] Integer
  cl-spin (n) = if n <= 0 then 0 else act
    polled <- port-in-byte #3FD
    cl-spin (n - 1)
  end
  cl-settle : Integer, Integer -> [Device.Port] Integer
  cl-settle (read) (fuel) = let write = peek-qword 28704 0
    in if fuel <= 0 | write - read > cl-limit | cl-complete read write then act write end
    else act
      spun <- cl-spin cl-settle-batch
      cl-settle read (fuel - 1)
    end
  cl-first-ms : Integer = 3000
  cl-first-ticks : Integer = (cl-first-ms * pit-input-hz + pit-count * 1000 - 1) / (pit-count * 1000)
  cl-await : Integer, Integer, Integer -> [Device.Port] Integer
  cl-await (read) (deadline) (fuel) = let write = peek-qword 28704 0
    in if fuel <= 0 | write /= read | peek-qword 28672 0 >= deadline then act write end
    else act
      spun <- cl-spin cl-settle-batch
      cl-await read deadline (fuel - 1)
    end
  cl-first : Integer -> [Device.Port] Integer
  cl-first (read) = act
    arrived <- cl-await read (peek-qword 28672 0 + cl-first-ticks) cl-settle-fuel
    if arrived == read then act arrived end else cl-settle read cl-settle-fuel
  end
  cl-read : Integer -> [Device.Port] Result CompositeLaunchMode Text
  cl-read (unused) = act
    polled <- port-in-byte #3FD
    let read = peek-qword 28712 0
    in let first = peek-qword 28704 0
    in act
      write <- if first == read then cl-first read else cl-settle read cl-settle-fuel
      if write == read then cl-parse []
      else if write < read | read < 0 | write - read > cl-limit then Err "invalid composite launch input"
      else let bytes = cl-trim (cl-copy-ring read (write - read) 0 (__list-with-capacity cl-limit)) 0
      in when cl-parse bytes
        is Err (e) -> Err (e & " (" & integer-to-text (write - read) & " bytes, first " & integer-to-text (if list-length bytes == 0 then -1 else list-at bytes 0) & ")")
        is Ok (mode) -> let wiped = cl-wipe read (write - read) 0
          in let consumed = poke-qword 28712 0 write in Ok mode
    end
  end
  cl-trim : List Integer, Integer -> List Integer
  cl-trim (bytes) (i) = if i < list-length bytes & list-at bytes i == 10 then cl-trim bytes (i + 1)
    else if i == 0 then bytes else cl-slice bytes i (list-length bytes) []
  cl-wipe : Integer, Integer, Integer -> Integer
  cl-wipe (read) (count) (i) = if i == count then 0
    else let cleared = poke-byte #F00000 (bit-and (read + i) #FFFFF) 0 in cl-wipe read count (i + 1)
