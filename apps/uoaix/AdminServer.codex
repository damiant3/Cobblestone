Chapter: AdminServer
  cites Uoaix chapter AdminProtocol
  cites Uoaix chapter AdminWorld
  cites Uoaix chapter AdminPanel
  cites Net chapter WebServer

  admin-serve : AdminAuth, AdminWorld, Integer -> [Console, Network.Read, Network.Write] Integer
  admin-serve (auth) (world) (port) =
    web-serve-concurrent (admin-route auth (admin-dispatch world)) (\message -> 0) port

  panel-serve : AdminAuth, AdminPanel, Integer -> [Console, Network.Read, Network.Write] Integer
  panel-serve (auth) (panel) (port) =
    web-serve-concurrent (panel-route auth panel) (\message -> 0) port
