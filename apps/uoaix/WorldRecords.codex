Chapter: WorldRecords
  cites Foreword chapter Result
  cites Uoaix chapter WorldIndex

 Each slot is ten 64-bit cells (80 bytes); the table header holds count
 and free-list head (16 bytes). Allocate once, reuse slots without reusing
 serials. Results allocate; keep transient results inside a caller mark.

  WorldObject = record {
    serial : Integer, kind : Integer, x : Integer, y : Integer, z : Integer,
    graphic : Integer, hue : Integer, container : Integer, amount : Integer, health : Integer
  }
  WorldTable = record { buffer : Integer, capacity : Integer, index : Integer }

  world-max-objects : Integer = 16384
  world-max-container-depth : Integer = 64
  world-object-bytes : Integer = 80
  world-item-bit : Integer = 1073741824
  world-serial-mask : Integer = 1073741823

  world-zero-slot : Integer, Integer, Integer -> Integer
  world-zero-slot (buffer) (at) (cell) =
    if cell >= 10 then 0
    else let clear = poke-qword buffer (at + cell * 8) 0
    in world-zero-slot buffer at (cell + 1)

  world-init-slots : Integer, Integer, Integer -> Integer
  world-init-slots (buffer) (capacity) (i) =
    if i >= capacity then 0
    else let zero = world-zero-slot buffer (16 + i * 80) 0
    in let link = poke-qword buffer (24 + i * 80) (if i + 1 == capacity then -1 else i + 1)
    in world-init-slots buffer capacity (i + 1)

  world-new : Integer -> Result WorldTable Text
  world-new (capacity) =
    if capacity < 1 | capacity > world-max-objects then Err "world capacity outside 1..16384"
    else let buffer = alloc-bytes (16 + capacity * 80)
    in let count = poke-qword buffer 0 0
    in let head = poke-qword buffer 8 0
    in let slots = world-init-slots buffer capacity 0
    in Ok (WorldTable { buffer = buffer, capacity = capacity, index = wi-new capacity })

  world-indexed : WorldTable -> Boolean
  world-indexed (world) = world.index > 0 & (if world.index <= 0 then False else peek-qword world.index 24 == world.capacity & peek-qword world.index 32 == 1)
  world-revision : WorldTable -> Integer
  world-revision (world) = if world.index <= 0 then 0 else peek-qword world.index 0
  world-touch : WorldTable -> Integer
  world-touch (world) = if world.index <= 0 then 0
    else poke-qword world.index 0 (if world-revision world == 9223372036854775807 then 1 else world-revision world + 1)
  world-item-revision : WorldTable -> Integer
  world-item-revision (world) = if world.index <= 0 then 0 else peek-qword world.index 40
  world-item-touch : WorldTable -> Integer
  world-item-touch (world) = let touched = world-touch world
    in if world.index <= 0 then 0 else poke-qword world.index 40 (if world-item-revision world == 9223372036854775807 then 1 else world-item-revision world + 1)
  world-reindex : WorldTable -> Boolean
  world-reindex (world) = if world.buffer <= 0 | world.capacity < 1 | world.capacity > world-max-objects then False
    else let allocated = if world.index <= 0 then __record-set world "index" (wi-new world.capacity) else world
    in let rebuilt = wi-rebuild world.buffer world.capacity world.index
    in let touched = world-touch world in rebuilt
  world-child-count : WorldTable, Integer -> Integer
  world-child-count (world) (serial) = let slot = world-slot world serial
    in if not (world-indexed world) then 0 else if serial == 0 then peek-qword world.index 48
    else if slot < 0 then 0 else peek-qword (wi-row world.index slot) 0
  world-first-child : WorldTable, Integer -> Integer
  world-first-child (world) (serial) = let slot = world-slot world serial
    in if not (world-indexed world) then 0 else if serial == 0 then wi-serial world.buffer (peek-qword world.index 56)
    else if slot < 0 then 0 else wi-serial world.buffer (peek-qword (wi-row world.index slot) 8)
  world-next-sibling : WorldTable, Integer -> Integer
  world-next-sibling (world) (serial) = let slot = world-slot world serial
    in if slot < 0 | not (world-indexed world) then 0 else wi-serial world.buffer (peek-qword (wi-row world.index slot) 16)
  world-set-layer : WorldTable, Integer, Integer -> Integer
  world-set-layer (world) (serial) (layer) = let slot = world-slot world serial
    in if slot < 0 | not (world-indexed world) | layer < 0 | layer > 29 then -1
    else if peek-qword world.buffer (24 + slot * 80) /= 2 then -1
    else wi-set-layer world.buffer world.capacity world.index slot layer
  world-layer-serial : WorldTable, Integer, Integer -> Integer
  world-layer-serial (world) (serial) (layer) = let slot = world-slot world serial
    in if slot < 0 | not (world-indexed world) | layer < 1 | layer > 29 then 0
    else if layer <= 25 then peek-qword (wi-row world.index slot) (72 + (layer - 1) * 8)
    else wi-serial world.buffer (wi-child-layer world.buffer world.index (peek-qword (wi-row world.index slot) 8) layer 0)
  world-tile-first : WorldTable, Integer, Integer -> Integer
  world-tile-first (world) (x) (y) = if not (world-indexed world) then 0
    else wi-serial world.buffer (wi-tile-head world.index world.capacity x y)
  world-tile-next : WorldTable, Integer -> Integer
  world-tile-next (world) (serial) = let slot = world-slot world serial
    in if slot < 0 | not (world-indexed world) then 0 else wi-serial world.buffer (peek-qword (wi-row world.index slot) 56)
  world-parent-depth : WorldTable, Integer, Integer -> Integer
  world-parent-depth (world) (serial) (depth) = if serial == 0 then depth
    else if depth >= world-max-container-depth then -1
    else let slot = world-slot world serial
    in if slot < 0 then -1 else world-parent-depth world (peek-qword world.buffer (72 + slot * 80)) (depth + 1)

  world-count : WorldTable -> Integer
  world-count (world) = peek-qword world.buffer 0

  world-slot : WorldTable, Integer -> Integer
  world-slot (world) (serial) =
    if serial <= 0 | serial > 2147483647 then -1
    else let low = bit-and serial world-serial-mask
    in if low == 0 then -1
    else let slot = int-mod (low - 1) world.capacity
    in if peek-qword world.buffer (16 + slot * 80) == serial then slot else -1

  world-read-slot : WorldTable, Integer -> WorldObject
  world-read-slot (world) (slot) =
    let at = 16 + slot * 80
    in WorldObject { serial = peek-qword world.buffer at, kind = peek-qword world.buffer (at + 8),
      x = peek-qword world.buffer (at + 16), y = peek-qword world.buffer (at + 24), z = peek-qword world.buffer (at + 32),
      graphic = peek-qword world.buffer (at + 40), hue = peek-qword world.buffer (at + 48),
      container = peek-qword world.buffer (at + 56), amount = peek-qword world.buffer (at + 64), health = peek-qword world.buffer (at + 72) }

  world-get : WorldTable, Integer -> Result WorldObject Text
  world-get (world) (serial) =
    let slot = world-slot world serial
    in if slot < 0 then Err "world serial absent or stale" else Ok (world-read-slot world slot)

  world-at : WorldTable, Integer -> Result WorldObject Text
  world-at (world) (slot) =
    if slot < 0 | slot >= world.capacity then Err "world slot outside capacity"
    else if peek-qword world.buffer (16 + slot * 80) <= 0 then Err "world slot empty"
    else Ok (world-read-slot world slot)

  world-fields-valid : WorldObject -> Boolean
  world-fields-valid (obj) =
    (obj.kind == 1 | obj.kind == 2) & obj.x >= 0 & obj.x < 6144 & obj.y >= 0 & obj.y < 4096
    & obj.z >= -128 & obj.z <= 127 & obj.graphic >= 0 & obj.graphic < 16384
    & obj.hue >= 0 & obj.hue <= 65535 & obj.amount >= 1 & obj.amount <= 65535
    & obj.health >= 0 & obj.health <= 65535 & (obj.kind == 2 | (obj.container == 0 & obj.amount == 1))

  world-parent-valid : WorldTable, Integer, Integer, Integer -> Boolean
  world-parent-valid (world) (serial) (parent) (left) =
    if parent == 0 then True
    else if parent == serial | left <= 0 then False
    else let slot = world-slot world parent
    in if slot < 0 then False
    else world-parent-valid world serial (peek-qword world.buffer (72 + slot * 80)) (left - 1)

  world-write-slot : WorldTable, Integer, Integer, WorldObject -> Integer
  world-write-slot (world) (slot) (serial) (obj) =
    let at = 16 + slot * 80
    in let a = poke-qword world.buffer at serial
    in let b = poke-qword world.buffer (at + 8) obj.kind
    in let c = poke-qword world.buffer (at + 16) obj.x
    in let d = poke-qword world.buffer (at + 24) obj.y
    in let e = poke-qword world.buffer (at + 32) obj.z
    in let f = poke-qword world.buffer (at + 40) obj.graphic
    in let g = poke-qword world.buffer (at + 48) obj.hue
    in let h = poke-qword world.buffer (at + 56) obj.container
    in let j = poke-qword world.buffer (at + 64) obj.amount
    in poke-qword world.buffer (at + 72) obj.health

  world-parent-after : WorldTable, Integer, Integer, Integer, Integer -> Boolean
  world-parent-after (world) (moving) (replacement) (parent) (left) =
    if parent == 0 then True
    else if left <= 0 then False
    else let slot = world-slot world parent
    in if slot < 0 then False
    else let next = if parent == moving then replacement else peek-qword world.buffer (72 + slot * 80)
    in world-parent-after world moving replacement next (left - 1)

  world-subtrees-valid : WorldTable, Integer, Integer, Integer -> Boolean
  world-subtrees-valid (world) (moving) (replacement) (i) =
    if i == 0 & world-indexed world then let slot = world-slot world moving
      in let depth = world-parent-depth world replacement 0
      in slot >= 0 & depth >= 0 & (if slot < 0 then False else depth + peek-qword (wi-row world.index slot) 32 <= world-max-container-depth)
    else if i >= world.capacity then True
    else let serial = peek-qword world.buffer (16 + i * 80)
    in let parent = if serial == moving then replacement else peek-qword world.buffer (72 + i * 80)
    in if serial > 0 & not (world-parent-after world moving replacement parent world-max-container-depth) then False
    else world-subtrees-valid world moving replacement (i + 1)

  world-create : WorldTable, WorldObject -> Result Integer Text
  world-create (world) (obj) =
    if not (world-indexed world) then Err "world index unavailable"
    else if obj.serial /= 0 then Err "world create requires serial zero"
    else if not (world-fields-valid obj) then Err "world object fields invalid"
    else if not (world-parent-valid world 0 obj.container world-max-container-depth) then Err "world container absent, cyclic or too deep"
    else let slot = peek-qword world.buffer 8
    in if slot < 0 then Err "world object budget exhausted"
    else let old = peek-qword world.buffer (16 + slot * 80)
    in let low = if old == 0 then slot + 1 else bit-and (0 - old) world-serial-mask + world.capacity
    in if low > world-serial-mask then Err "world serial generation exhausted"
    else let serial = low + (if obj.kind == 2 then world-item-bit else 0)
    in let next = peek-qword world.buffer (24 + slot * 80)
    in let stored = world-write-slot world slot serial obj
    in let head = poke-qword world.buffer 8 next
    in let count = poke-qword world.buffer 0 (world-count world + 1)
    in let child = wi-child-add world.buffer world.capacity world.index slot True
    in let tile = wi-tile-add world.buffer world.capacity world.index slot
    in let touched = if obj.kind == 2 then world-item-touch world else world-touch world
    in Ok serial

  world-same : WorldTable, Integer, WorldObject -> Boolean
  world-same (world) (slot) (obj) = let at = 16 + slot * 80
    in peek-qword world.buffer (at + 16) == obj.x & peek-qword world.buffer (at + 24) == obj.y
      & peek-qword world.buffer (at + 32) == obj.z & peek-qword world.buffer (at + 40) == obj.graphic
      & peek-qword world.buffer (at + 48) == obj.hue & peek-qword world.buffer (at + 56) == obj.container
      & peek-qword world.buffer (at + 64) == obj.amount & peek-qword world.buffer (at + 72) == obj.health

  world-update : WorldTable, WorldObject -> Result Integer Text
  world-update (world) (obj) =
    let slot = world-slot world obj.serial
    in if not (world-indexed world) then Err "world index unavailable"
    else if slot < 0 then Err "world serial absent or stale"
    else if not (world-fields-valid obj) then Err "world object fields invalid"
    else if peek-qword world.buffer (24 + slot * 80) /= obj.kind then Err "world object kind cannot change"
    else if world-same world slot obj then Ok obj.serial
    else if not (world-parent-valid world obj.serial obj.container world-max-container-depth) then Err "world container absent, cyclic or too deep"
    else if not (world-move-valid world slot obj) then Err "world descendant container depth exceeded"
    else let reparent = peek-qword world.buffer (72 + slot * 80) /= obj.container
    in let relocate = reparent | (obj.container == 0 & (peek-qword world.buffer (32 + slot * 80) /= obj.x | peek-qword world.buffer (40 + slot * 80) /= obj.y))
    in let child = if reparent then wi-child-remove world.buffer world.capacity world.index slot else 0
    in let tile = if relocate then wi-tile-remove world.buffer world.capacity world.index slot else 0
    in let stored = world-write-slot world slot obj.serial obj
    in let attached = if reparent then wi-child-add world.buffer world.capacity world.index slot True else 0
    in let placed = if relocate then wi-tile-add world.buffer world.capacity world.index slot else 0
    in let touched = if obj.kind == 2 then world-item-touch world else world-touch world
    in Ok obj.serial

  world-move-valid : WorldTable, Integer, WorldObject -> Boolean
  world-move-valid (world) (slot) (obj) =
    if peek-qword world.buffer (72 + slot * 80) == obj.container then True
    else if not (world-has-child world obj.serial 0) then True
    else world-subtrees-valid world obj.serial obj.container 0

  world-has-child : WorldTable, Integer, Integer -> Boolean
  world-has-child (world) (serial) (i) =
    if i == 0 & world-indexed world then world-child-count world serial > 0
    else if i >= world.capacity then False
    else if peek-qword world.buffer (16 + i * 80) > 0 & peek-qword world.buffer (72 + i * 80) == serial then True
    else world-has-child world serial (i + 1)

  world-delete : WorldTable, Integer -> Result Integer Text
  world-delete (world) (serial) =
    let slot = world-slot world serial
    in if not (world-indexed world) then Err "world index unavailable"
    else if slot < 0 then Err "world serial absent or stale"
    else if world-has-child world serial 0 then Err "world container is not empty"
    else let kind = peek-qword world.buffer (24 + slot * 80)
    in let child = wi-child-remove world.buffer world.capacity world.index slot
    in let tile = wi-tile-remove world.buffer world.capacity world.index slot
    in let tombstone = poke-qword world.buffer (16 + slot * 80) (0 - serial)
    in let link = poke-qword world.buffer (24 + slot * 80) (peek-qword world.buffer 8)
    in let head = poke-qword world.buffer 8 slot
    in let count = poke-qword world.buffer 0 (world-count world - 1)
    in let touched = if kind == 2 then world-item-touch world else world-touch world
    in Ok serial

