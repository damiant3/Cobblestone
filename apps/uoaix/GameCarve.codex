 Modified port of Source-X CClientTarg::OnTarg_Use_Item (IT_CORPSE) and CChar::Use_CarveCorpse:
 an axe or a knife used on a corpse carves it once, the parts go into the corpse and the carver
 bows (ANIM_BOW 32). Messages follow DEFMSG_CARVE_CORPSE_MEAT, _HIDES and _NOTHING.
 License: apps/uoaix/Sphere-LICENSE.txt.
 A carved corpse holds health 1; cb-die makes every corpse with health 0. Parts drop inside the
 corpse gump 0x09's Data/containers.cfg rectangle (20,85 104x111) less a 30-pixel art extent.
 Knife art is the ServUO skinning knife (0x0EC4) and butcher knife (0x13F6). parts (body, 0 meat or 1 hides)
 Damian 2026-10-06: knives, daggers (0x0F51) and the hatchet (0x0F43) carve; swords, the axe and other
 bladed weapons do not.

  GameCarve = record { harvest : GameHarvest, parts : (Integer, Integer -> Integer) }
  gca-new : GameHarvest, (Integer, Integer -> Integer) -> GameCarve
  gca-new (harvest) (parts) = GameCarve { harvest = harvest, parts = parts }
  gca-tool-graphic : Integer, Integer -> Boolean
  gca-tool-graphic (item) (graphic) = if item == 27 then graphic == #0EC4 | graphic == #0EC5 | graphic == #13F6 | graphic == #13F7
    else if item == 69 then graphic == #0F51 | graphic == #0F52
    else item == 26 & (graphic == #0F43 | graphic == #0F44)
  gca-blade : Integer -> Boolean
  gca-blade (item) = item == 27 | item == 69
  gca-tool : GameHarvest, GvPlayer, Integer -> Integer
  gca-tool (state) (player) (serial) =
    let at = gv-lot state.vendor serial 0
    in if at < 0 then -1
    else let lot = list-at state.vendor.lots at
    in if lot.actor /= player.actor | lot.quantity /= 1 | lot.wear < 1 | (lot.item /= 26 & not (gca-blade lot.item))
      | not (gsi-known state.items serial) | not (gv-owned state.items.world serial player.serial 65) then -1
    else when world-get state.items.world serial
      is Err (_) -> -1
      is Ok (tool) -> if tool.kind /= 2 | tool.amount /= 1 | not (gca-tool-graphic lot.item tool.graphic)
        | not (gh-carried state player tool) then -1 else at
  gca-begin : GameHarvest, GvPlayer, GhRequest, Integer, Integer -> Result (Maybe GameReply) Text
  gca-begin (state) (player) (request) (tool) (now) =
    if gca-tool state player tool < 0 then gh-denied "You need your own usable blade."
    else if now < request.next then gh-denied "Wait before using that again."
    else if state.nonce > 65535 then gh-denied "Harvest target contexts exhausted."
    else let target = #48410000 + state.nonce
    in let nonce = __record-set state "nonce" (state.nonce + 1)
    in let context = __record-set request "target" target
    in let selected = __record-set request "tool" tool
    in let expires = __record-set request "expires" (now + gh-ticks 10000)
    in Ok (Just (gs-reply [sip-target target, sip-message #FFFFFFFF #FFFF 6 "What do you want to use this on?"] "carve target"))
  gca-actor : EpActor, GvLot -> EpActor
  gca-actor (p) (lot) =
    let actor = EpActor { purse = p.purse, place = p.place, hunger = p.hunger,
      attempts = p.attempts, stock = gh-buffer p.stock 129, quality = gh-buffer p.quality 129,
      cost = gh-buffer p.cost 129, wear = gh-buffer p.wear 129, skills = gh-buffer p.skills 11, row = p.row }
    in let a = ep-set actor.stock lot.item 1
    in let b = ep-set actor.quality lot.item lot.quality
    in let c = ep-set actor.cost lot.item lot.basis
    in let d = ep-set actor.wear lot.item lot.wear
    in actor
  gca-publish : EpActor, EpActor, GvLot -> Integer
  gca-publish (candidate) (p) (lot) =
    let a = ep-add candidate.stock lot.item (ep-at p.stock lot.item - 1)
    in let b = ep-add candidate.quality lot.item (ep-at p.quality lot.item - lot.quality)
    in let c = ep-add candidate.cost lot.item (ep-at p.cost lot.item - lot.basis)
    in let d = ep-add candidate.wear lot.item (ep-at p.wear lot.item - lot.wear)
    in let e = gh-copy candidate.stock p.stock 129 0
    in let f = gh-copy candidate.quality p.quality 129 0
    in let g = gh-copy candidate.cost p.cost 129 0
    in let h = gh-copy candidate.wear p.wear 129 0
    in let i = gh-copy candidate.skills p.skills 11 0
    in let j = __record-set p "attempts" candidate.attempts in 0
  gca-room : EpWorld, EpActor, Integer, Integer -> Boolean
  gca-room (w) (p) (item) (quantity) = quantity == 0 | (ep-room p item quantity & ep-at w.gathered item <= ep-limit - quantity)
  gca-part : GameCarve, GvPlayer, Integer, Integer, Integer, Integer, Integer, List (List Integer) -> Result (List (List Integer)) Text
  gca-part (c) (player) (corpse) (item) (quantity) (quality) (draw) (out) = if quantity == 0 then Ok out
    else let state = c.harvest
    in let spot = bit-and (mix-bits draw player.serial) #7FFFFFFF
    in let obj = WorldObject { serial = 0, kind = 2, x = 20 + int-mod spot 74, y = 85 + int-mod (spot / 4096) 81, z = 0,
      graphic = (if item == 8 then #09F1 else #1078), hue = 0, container = corpse, amount = quantity, health = 0 }
    in when world-create state.items.world obj
      is Err (e) -> Err e
      is Ok (serial) ->
        let basis = if list-length state.vendor.currency.world.catalog.items >= 68 then quantity else 0
        in if gv-add-lot state.vendor serial player.actor item (gh-grade quality) 32 basis < 0 then Err "carve output provenance refused"
        else let known = gsi-register state.items serial 0 0 True False
        in when world-get state.items.world serial
          is Err (e) -> Err e
          is Ok (made) -> Ok (list-push out (sip-item made))
  gca-carve : GameCarve, GvPlayer, WorldObject, Integer, Integer -> Result (Maybe GameReply) Text
  gca-carve (c) (player) (corpse) (lot-id) (now) =
    let state = c.harvest
    in let v = state.vendor
    in let w = v.currency.world
    in let p = ep-actor w player.actor
    in let lot = list-at v.lots lot-id
    in let meat = c.parts corpse.amount 0
    in let hides = c.parts corpse.amount 1
    in if ep-at p.stock lot.item < 1 | ep-at p.quality lot.item < lot.quality | ep-at p.cost lot.item < lot.basis
      | ep-at p.wear lot.item < lot.wear | world-has-child state.items.world lot.serial 0 then gh-denied "Carving inventory binding refused."
    else if not (gca-room w p 8 meat & gca-room w p 7 hides) then gh-denied "You cannot hold what this corpse would yield."
    else if v.lot-count + 2 > gv-lot-limit | world-count state.items.world + 2 > state.items.world.capacity then gh-denied "No room for the carved parts."
    else when world-update state.items.world (__record-set corpse "health" 1)
      is Err (e) -> Err e
      is Ok (_) ->
        let bound = gh-row v player
        in let candidate = gca-actor p lot
        in let quality = 100 + ep-level p 3 (ep-classic 3 0 0) * 9 / 10
        in let practiced = ep-practice candidate 3
        in let worn = ep-wear w candidate lot.item
        in let broken = ep-at candidate.stock lot.item == 0
        in let a = if meat > 0 then eh-add-yield w candidate 8 meat quality else 0
        in let b = if hides > 0 then eh-add-yield w candidate 7 hides quality else 0
        in let published = gca-publish candidate p lot
        in let tool-serial = lot.serial
        in let retired = if broken then when world-delete state.items.world tool-serial
          is Err (e) -> Err e
          is Ok (_) -> let removed = gh-retire-lot v lot-id in Ok 0
          else let used = __record-set lot "wear" (lot.wear - 1) in Ok 0
        in when retired
          is Err (e) -> Err e
          is Ok (_) ->
            let invalidated = gh-invalidate-quotes v 0
            in let packets = if broken then [sip-remove tool-serial] else []
            in let bowed = list-push packets (cbp-animation player.serial 32)
            in when gca-part c player corpse.serial 8 meat quality now bowed
              is Err (e) -> Err e
              is Ok (with-meat) -> when gca-part c player corpse.serial 7 hides quality (now + 1) with-meat
                is Err (e) -> Err e
                is Ok (parts) ->
                  let said = if meat > 0 then list-push parts (sip-message #FFFFFFFF #FFFF 6 "You carve away some meat.") else parts
                  in let skinned = if hides > 0 then list-push said (sip-message #FFFFFFFF #FFFF 6 "You skin it, and the hides are now in the corpse.") else said
                  in let empty = if meat == 0 & hides == 0 then list-push skinned (sip-message #FFFFFFFF #FFFF 6 "You see nothing useful to carve from the corpse.") else skinned
                  in Ok (Just (gs-reply empty "carve corpse"))
 UOX3 js/item/sword.js MakeFishSteaks and dictionary.ENG 775, 9338: a blade on fish (0x09CC-0x09CF) in the
 carver's own backpack makes four raw fish steaks (0x097A) per fish, with no skill check. The economy has no steak
 item, so the steaks stay fish (item 9): the lot keeps its per-unit grade and the three new units per fish are crafted.
  gca-fish-art : Integer -> Boolean
  gca-fish-art (graphic) = graphic >= #09CC & graphic <= #09CF
  gca-fish : GameCarve, GvPlayer, WorldObject -> Result (Maybe GameReply) Text
  gca-fish (c) (player) (fish) =
    let state = c.harvest
    in let v = state.vendor
    in let at = gv-lot v fish.serial 0
    in if at < 0 | not (gv-owned state.items.world fish.serial player.serial 65) then gh-denied "You can't use material outside your backpack."
    else let lot = list-at v.lots at
    in if lot.actor /= player.actor then gh-denied "You can't use material outside your backpack."
    else if lot.item /= 9 then gh-denied "You cannot carve that."
    else let w = v.currency.world
    in let p = ep-actor w player.actor
    in let n = lot.quantity
    in let more = n * 3
    in if n < 1 | n * 4 > 60000 | ep-at p.stock 9 < n | not (ep-room p 9 more) | ep-at w.crafted 9 > ep-limit - more then gh-denied "You cannot hold the fish steaks."
    else let a = ep-add p.stock 9 more
    in let b = ep-add p.quality 9 (more * lot.quality)
    in let d = ep-add p.wear 9 (more * lot.wear)
    in let e = ep-add w.crafted 9 more
    in let counted = __record-set lot "quantity" (n * 4)
    in when world-update state.items.world (__record-set (__record-set fish "graphic" #097A) "amount" (n * 4))
      is Err (err) -> Err err
      is Ok (_) -> let invalidated = gh-invalidate-quotes v 0
        in when world-get state.items.world fish.serial
          is Err (err) -> Err err
          is Ok (made) -> Ok (Just (gs-reply [sip-item made, sip-message #FFFFFFFF #FFFF 6 "You slice your fish into raw fish steaks."] "carve fish"))
  gca-target : GameCarve, GvPlayer, GhRequest, GameInput, List Integer, Integer -> Result (Maybe GameReply) Text
  gca-target (c) (player) (request) (input) (packet) (now) =
    let state = c.harvest
    in let serial = bit-and (gp-u32 packet 7) #7FFFFFFF
    in let clear = __record-set request "target" 0
    in if gp-u16 packet 11 == 65535 | gp-u16 packet 13 == 65535 then Ok (Just (gs-reply [] "carve cancelled"))
    else if now > request.expires | now < request.next then gh-denied "That target expired."
    else let lot = gca-tool state player request.tool
    in if lot < 0 then gh-denied "Your blade is no longer available."
    else if (list-at state.items.actors (gsi-slot state.vendor.game input.session.serial 0)).holding /= 0 then gh-denied "Finish moving that item first."
    else when world-get state.items.world player.serial
      is Err (e) -> Err e
      is Ok (mobile) -> when world-get state.items.world serial
        is Err (_) -> gh-denied "You cannot carve that."
        is Ok (corpse) -> if corpse.kind == 2 & gca-fish-art corpse.graphic then gca-fish c player corpse
          else if corpse.kind /= 2 | corpse.graphic /= 8198 then gh-denied "You cannot carve that."
          else if corpse.container /= 0 | corpse.x < mobile.x - 2 | corpse.x > mobile.x + 2 | corpse.y < mobile.y - 2
            | corpse.y > mobile.y + 2 | corpse.z < mobile.z - 16 | corpse.z > mobile.z + 16 then gh-denied "That is too far away."
          else if corpse.health /= 0 then gh-denied "You see nothing useful to carve from the corpse."
          else let next = __record-set request "next" (now + gh-ticks 1000)
          in gca-carve c player corpse lot now
  gca-carves : GameCarve, Integer, Integer -> Boolean
  gca-carves (c) (tool) (serial) = let at = gv-lot c.harvest.vendor tool 0
    in if at < 0 then False
    else let item = (list-at c.harvest.vendor.lots at).item
    in if gca-blade item then True
    else if item /= 26 | serial == 0 then False
    else when world-get c.harvest.items.world tool
      is Err (_) -> False
      is Ok (hatchet) -> if not (gca-tool-graphic 26 hatchet.graphic) then False
        else when world-get c.harvest.items.world serial
          is Err (_) -> False
          is Ok (target) -> target.kind == 2 & (target.graphic == 8198 | gca-fish-art target.graphic)
  gca-handler-at : GameCarve, GameShard, GameInput, List Integer, Integer -> Result (Maybe GameReply) Text
  gca-handler-at (c) (shard) (input) (packet) (now) =
    let state = c.harvest
    in if list-length packet == 0 then Ok None
    else let op = list-at packet 0
    in if (op /= 6 | list-length packet /= 5) & (op /= #6C | list-length packet /= 19) then Ok None
    else if not (gs-byte-range packet 0) then Ok None
    else if op == #6C & bit-and (gp-u32 packet 2) #FFFF0000 /= #48410000 then Ok None
    else let knife = if op == 6 then gv-lot state.vendor (bit-and (gp-u32 packet 1) #7FFFFFFF) 0 else -1
    in if op == 6 & (knife < 0 | (if knife < 0 then True else not (gca-blade (list-at state.vendor.lots knife).item))) then Ok None
    else if input.mode /= 2 | input.session.phase /= 2 | shard.active /= input.session.serial
      | state.items.world.buffer /= shard.world.buffer | state.vendor.game.world.buffer /= shard.world.buffer then Ok None
    else let at = gv-player state.vendor input.session.serial 0
    in let slot = gsi-slot shard input.session.serial 0
    in if at < 0 | slot < 0 | now < 0 | now > 9223372036854775807 - gh-ticks 10000 then Ok None
    else let player = list-at state.vendor.players at
    in if not (ep-valid-actor state.vendor.currency.world player.actor) then Ok None
    else let request = gh-session state input player slot
    in if op == #6C & (request.target == 0 | request.target /= gp-u32 packet 2 | not (gca-carves c request.tool (bit-and (gp-u32 packet 7) #7FFFFFFF))) then Ok None
    else when world-get shard.world input.session.serial
      is Err (e) -> Err e
      is Ok (mobile) -> if mobile.health <= 0 then gh-denied "You cannot carve while dead."
        else if op == 6 then gca-begin state player request (bit-and (gp-u32 packet 1) #7FFFFFFF) now
        else gca-target c player request input packet now
