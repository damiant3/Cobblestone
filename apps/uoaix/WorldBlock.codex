Chapter: WorldBlock
  cites Kernel chapter VirtioBlkX86
  cites Foreword chapter Result

  UoDevice = | UoIde | UoVirtio (VbxState)

  us-device-count : UoDevice -> [Device.Block] Integer
  us-device-count (device) = when device
    is UoIde -> act
      count <- block-sector-count
      count
    end
    is UoVirtio (state) -> act state.capacity end

  us-device-read : UoDevice, Integer -> [Device.Block] Result Integer Text
  us-device-read (device) (sector) = when device
    is UoIde -> act
      buf <- block-read-sector sector
      if buf <= 0 then Err "IDE block read failed" else Ok buf
    end
    is UoVirtio (state) ->
      let buf = alloc-bytes 512
      in act
        when vbx-read state sector buf
          is Err (e) -> Err e
          is Ok (n) -> Ok buf
      end

  us-device-write : UoDevice, Integer, Integer -> [Device.Block] Result Integer Text
  us-device-write (device) (sector) (buf) = when device
    is UoIde -> act
      status <- block-write-sector sector buf
      if status == 0 then Ok 0 else Err "IDE block write failed"
    end
    is UoVirtio (state) -> act vbx-write state sector buf end

 Count sectors (at most vbx-max-sectors) from buf in one transfer on virtio; IDE writes them one at a time.
  us-device-write-many : UoDevice, Integer, Integer, Integer -> [Device.Block] Result Integer Text
  us-device-write-many (device) (sector) (buf) (count) = when device
    is UoIde -> us-ide-write-each sector buf count 0
    is UoVirtio (state) -> act vbx-write-many state sector buf count end
  us-ide-write-each : Integer, Integer, Integer, Integer -> [Device.Block] Result Integer Text
  us-ide-write-each (sector) (buf) (count) (i) = if i >= count then act Ok 0 end
    else act
      status <- block-write-sector (sector + i) (buf + i * 512)
      if status /= 0 then Err "IDE block write failed" else us-ide-write-each sector buf count (i + 1)
    end
  us-device-read-many : UoDevice, Integer, Integer, Integer -> [Device.Block] Result Integer Text
  us-device-read-many (device) (sector) (out) (count) = when device
    is UoIde -> us-ide-read-each sector out count 0
    is UoVirtio (state) -> act vbx-read-many state sector out count end
  us-ide-read-each : Integer, Integer, Integer, Integer -> [Device.Block] Result Integer Text
  us-ide-read-each (sector) (out) (count) (i) = if i >= count then act Ok (count * 512) end
    else act
      buf <- block-read-sector (sector + i)
      if buf <= 0 then Err "IDE block read failed"
      else let copied = vbx-copy-qwords buf (out + i * 512) 512 0 in us-ide-read-each sector out count (i + 1)
    end
