 Serpent's Hold (city 10), by the door-and-roof survey of the 1.25 statics: four houses (the rooms behind 3003,3386 and
 2879,3508 belong to the provisioner's and tailor's shops); no trees, furrowed land, mountain or fishmonger, so it founds
 a herb farmer on its five richest wild plant clusters. Its entrance is the innkeeper's tile 2964,3405 at z 15, where its herb farmer stands and from which the server planned
 its route out (trial 43340); UOX3's door 2965,3405 left the farmer with no route back at z 35 (43315) and at z 15 (43340); the stations
 are the counters of its blacksmith, baker and tailor.
  cw-serpents-houses : List CggHouse = [cw-house 3053 3364 3048 3360 3054 3363, cw-house 2972 3415 2968 3416 2974 3430,
    cw-house 3014 3426 3008 3424 3013 3429, cw-house 2910 3483 2911 3480 2918 3486]
  cw-serpents : List CtCity, List BbShop, List Integer -> CgCity
  cw-serpents (cities) (shops) (roles) = CgCity { city = 10, inn = BbShop { title = "Inn", premises = "Serpent's Hold Inn", x1 = 2962, y1 = 3405, x2 = 2964, y2 = 3410 },
    houses = cw-serpents-houses, lodges = cw-serpents-houses, ore = cw-none, rock = BbSpot { x = 0, y = 0, z = 0 },
    woods = cw-none, field = cw-none, pasture = cw-none,
    gardens = [cw-box "Wild plants" 2888 3520 2895 3527, cw-box "Wild plants" 2860 3472 2863 3479, cw-box "Wild plants" 2920 3520 2927 3527,
      cw-box "Wild plants" 2912 3376 2919 3383, cw-box "Wild plants" 2960 3376 2967 3383],
    shore = cw-none, place-base = 10000, vendors = cw-vendors cities shops roles 10 (list-length gvb-role-words) 0 [],
    stations = [BbSpot { x = 3003, y = 3407, z = 0 }, BbSpot { x = 2974, y = 3353, z = 0 }, BbSpot { x = 2875, y = 3509, z = 0 },
      BbSpot { x = 2875, y = 3509, z = 0 }, BbSpot { x = 3003, y = 3407, z = 0 }] }
  cw-city : List CtCity, List BbShop, List Integer, Integer -> Maybe CgCity
  cw-city (cities) (shops) (roles) (i) = if i == 10 then Just (cw-serpents cities shops roles) else if i == 9 then Just (cw-jhelom cities shops roles) else if i == 1 then Just (cw-trinsic cities shops roles) else if i == 11 then Just (cw-bucc cities shops roles) else if i == 4 then Just (cw-wind cities shops roles) else if i == 3 then Just (cw-yew cities shops roles) else if i == 2 then Just (cw-moonglow cities shops roles) else if i == 5 then Just (cw-skara cities shops roles) else if i == 6 then Just (cw-ocllo cities shops roles) else if i == 7 then Just (cw-magincia cities shops roles) else if i == 12 then Just (cw-vesper cities shops roles) else if i == 13 then Just (cw-minoc cities shops roles) else if i == 14 then Just (cw-cove cities shops roles) else None
  cw-door : Integer -> BbSpot
  cw-door (i) = if i == 10 then BbSpot { x = 2964, y = 3405, z = 15 } else if i == 9 then BbSpot { x = 1375, y = 3817, z = 0 } else if i == 1 then BbSpot { x = 2018, y = 2810, z = 0 } else if i == 11 then BbSpot { x = 2717, y = 2090, z = 0 } else if i == 4 then BbSpot { x = 5311, y = 35, z = 0 } else if i == 3 then BbSpot { x = 607, y = 819, z = 0 } else if i == 2 then BbSpot { x = 4402, y = 1159, z = 0 } else if i == 5 then BbSpot { x = 615, y = 2234, z = 0 } else if i == 6 then BbSpot { x = 3667, y = 2623, z = 0 } else if i == 7 then BbSpot { x = 3695, y = 2250, z = 20 } else if i == 12 then BbSpot { x = 2771, y = 975, z = 0 } else if i == 13 then BbSpot { x = 2496, y = 379, z = 0 } else if i == 14 then BbSpot { x = 2231, y = 1214, z = 0 } else BbSpot { x = 0, y = 0, z = 0 }

  CwCities = record { cities : List CgCity, towns : List TownLive }
  cw-town : TownLive, TlPath, BbSpot -> TownLive
  cw-town (t) (nav) (door) = TownLive { vendors = t.vendors, items = t.items, people = t.people, mind = t.mind, residents = [], viewers = [],
    count = 0, home-capacity = 0, entrance = door, nav = nav, now = t.now, cursor = 0, lines = t.lines, feel = t.feel,
    warn-hook = t.warn-hook, seeded-hook = t.seeded-hook }
  cw-build : List CtCity, List WalkMap, List TlPath, TownLive, List BbShop, List Integer, Integer, CwCities -> CwCities
  cw-build (cities) (maps) (navs) (t) (shops) (roles) (i) (out) = if i >= list-length maps | i >= list-length navs then out
    else when (if i == 0 then None else cw-city cities shops roles i)
      is None -> cw-build cities maps navs t shops roles (i + 1) out
      is Just (c) -> let door = BbSpot { x = 0, y = 0, z = 0 }
        in let stood = cgg-door-stand (list-at maps i) (cw-door i) door
        in cw-build cities maps navs t shops roles (i + 1) (CwCities { cities = out.cities & [c], towns = out.towns & [cw-town t (list-at navs i) door] })
  cw-town-of : List CgCity, List TownLive, Integer, Integer -> Maybe TownLive
  cw-town-of (cities) (towns) (city) (i) = if i >= list-length cities | i >= list-length towns then None
    else if (list-at cities i).city == city then Just (list-at towns i) else cw-town-of cities towns city (i + 1)
  cw-city-in : List CgCity, Integer, Integer -> Maybe CgCity
  cw-city-in (cities) (city) (i) = if i >= list-length cities then None
    else if (list-at cities i).city == city then Just (list-at cities i) else cw-city-in cities city (i + 1)

  cw-places : List Integer = [cgg-fish-place, cgg-lumber-place, cgg-herb-farm, cgg-root-farm, cgg-veg-farm, cgg-farm-place,
    cgg-flax-place, cgg-cotton-place, cgg-wool-place, cgg-place + 1, cgg-stone-place]
  cw-vendor : CgCity, Integer -> Integer
  cw-vendor (c) (role) = if role < 0 | role >= list-length c.vendors then -1 else list-at c.vendors role
  cw-wants : CgCity, Integer -> Boolean
  cw-wants (c) (place) = let trade = cgg-trade-in c place
    in cw-vendor c trade.buyer >= 0 & cw-held (if place == cgg-fish-place then c.shore else trade.region)
  cw-has : List CgGatherer, Integer, Integer, Integer -> Boolean
  cw-has (xs) (city) (place) (i) = if i >= list-length xs then False
    else let c = list-at xs i in (c.city.city == city & cgg-kind c == place) | cw-has xs city place (i + 1)
 Purse owner 3600 + 20 * city + k holds city worker k of cw-places (Britain's workers hold 3001 to 3311).
  cw-owner : Integer, Integer -> Integer
  cw-owner (city) (k) = 3600 + 20 * city + k
  cw-found-one : CgCity, TownLive, WalkMap, Integer, Integer -> Result CgGatherer Text
  cw-found-one (c) (t) (map) (place) (k) = if place == cgg-fish-place then cgg-new-fisher-in c t map None (cw-owner c.city k) k
    else when cgg-new-at-in c t map (cw-owner c.city k) k place
      is Err (e) -> Err e
      is Ok (w) -> if cgg-crop-farm place & cgg-farm-nodes w (cgg-farm-crops place) 0 < 0 then Err "crop nodes refused" else Ok w
 A city's lumberjack and fisherman each work cw-spots nodes of their raw good at their place, topped up at every boot, and
 move to the next ready one (cgg-renode, cgg-retarget): a node regrows in a game day, so the Skara Brae lumberjack's one
 node landed one log a day and it made no boards by hour 71 (trial 43215).
  cw-spots : Integer = 6
  cw-count-nodes : EpWorld, Integer, Integer, Integer, Integer -> Integer
  cw-count-nodes (w) (resource) (place) (i) (n) = if i >= w.node-count then n
    else cw-count-nodes w resource place (i + 1) (if (list-at w.nodes i).resource == resource & (list-at w.nodes i).place == place then n + 1 else n)
  cw-grow-nodes : EpWorld, Integer, Integer, Integer -> Integer
  cw-grow-nodes (w) (resource) (place) (left) = if left <= 0 then 0
    else if eh-source w resource place < 1 then 0
    else 1 + cw-grow-nodes w resource place (left - 1)
  cw-grounds : List CgGatherer, Integer -> Integer
  cw-grounds (xs) (i) = if i >= list-length xs then 0
    else let c = list-at xs i
    in let w = c.gatherer.producer.currency.world
    in let resource = cgg-resource-of w c.trade.raw 0
    in let grown = if cgg-kind c == cgg-lumber-place | cgg-kind c == cgg-fish-place then cw-grow-nodes w resource c.gatherer.place (cw-spots - cw-count-nodes w resource c.gatherer.place 0 0) else 0
    in grown + cw-grounds xs (i + 1)
  CwFound = record { workers : List CgGatherer, founded : Integer, refused : Text }
  cw-refuse : CwFound, Text -> CwFound
  cw-refuse (out) (why) = CwFound { workers = out.workers, founded = out.founded, refused = out.refused & " " & why & ";" }
  cw-found : List CgCity, List TownLive, List WalkMap, Integer, Integer, CwFound -> CwFound
  cw-found (cities) (towns) (maps) (i) (k) (out) = if i >= list-length cities | i >= list-length towns then out
    else if k >= list-length cw-places then cw-found cities towns maps (i + 1) 0 out
    else let c = list-at cities i
    in let place = list-at cw-places k
    in if cw-has out.workers c.city place 0 | not (cw-wants c place) then cw-found cities towns maps i (k + 1) out
    else when ct-map-of maps c.city
      is None -> cw-found cities towns maps (i + 1) 0 out
      is Just (map) -> when cw-found-one c (list-at towns i) map place k
        is Err (e) -> cw-found cities towns maps i (k + 1) (cw-refuse out ("city " & show c.city & " place " & show place & ": " & e))
        is Ok (w) -> cw-found cities towns maps i (k + 1) (CwFound { workers = out.workers & [w], founded = out.founded + 1, refused = out.refused })

 City worker i beds in house i of its city (wrapping), on the first free floor tile its inn door routes to both ways;
 a house whose first free tile does not route is passed over (two failed plans, about 56 ms), and with none it keeps its inn bed.
  cw-own-beds : List CgGatherer, List CgCity, List TownLive, List WalkMap, Integer -> Integer
  cw-own-beds (xs) (cities) (towns) (maps) (i) = if i >= list-length xs then 0
    else let w = list-at xs i
    in let moved = when cw-town-of cities towns w.city.city 0
      is None -> 0
      is Just (t) -> (when ct-map-of maps w.city.city is None -> 0 is Just (map) -> cw-own-bed w t map i)
    in moved + cw-own-beds xs cities towns maps (i + 1)
  cw-own-bed : CgGatherer, TownLive, WalkMap, Integer -> Integer
  cw-own-bed (w) (t) (map) (i) = let n = list-length w.city.houses
    in let moved = if n == 0 | cgg-house-in w.city.lodges w.home 0 >= 0 then 0 else cw-house-bed w t map (int-mod i n) n
    in let stood = cgg-fix-door w t map in moved
  cw-house-bed : CgGatherer, TownLive, WalkMap, Integer, Integer -> Integer
  cw-house-bed (w) (t) (map) (h) (left) = if left <= 0 then 0
    else let next = int-mod (h + 1) (list-length w.city.houses)
    in when bb-placement t.vendors.game.world map (list-at w.city.houses h).floor 0
      is Err (_) -> cw-house-bed w t map next (left - 1)
      is Ok (bed) -> if not (cgg-reaches t map None bed) then cw-house-bed w t map next (left - 1)
        else let moved = tl-copy-spot w.home bed
        in let put = if w.leg == 0 & w.via == 0 & w.serial /= 0 then cw-put w t bed else 0
        in let reset = cgg-reset w in 1
 A city farmer whose node lies in none of its city's gardens (a world founded before its gardens moved) is placed again
 in its crop's garden at boot.
  cw-regarden : List CgGatherer, List CgCity, List TownLive, List WalkMap, Integer -> Integer
  cw-regarden (xs) (cities) (towns) (maps) (i) = if i >= list-length xs then 0
    else let w = list-at xs i
    in let moved = if not (cgg-crop-farm (cgg-kind w)) | cw-in-any w.city.gardens w.node.x w.node.y 0 then 0
      else when cw-town-of cities towns w.city.city 0
        is None -> 0
        is Just (t) -> (when ct-map-of maps w.city.city
          is None -> 0
          is Just (map) -> (when bb-placement t.vendors.game.world map w.trade.region 0
            is Err (_) -> 0
            is Ok (spot) -> let copied = tl-copy-spot w.node spot in let reset = cgg-reset w in 1))
    in moved + cw-regarden xs cities towns maps (i + 1)
  cw-in-any : List BbShop, Integer, Integer, Integer -> Boolean
  cw-in-any (boxes) (x) (y) (i) = if i >= list-length boxes then False
    else cgg-in-box (list-at boxes i) x y | cw-in-any boxes x y (i + 1)
  cw-put : CgGatherer, TownLive, BbSpot -> Integer
  cw-put (w) (t) (bed) = when world-get t.vendors.game.world w.serial
    is Err (_) -> 0
    is Ok (m) -> let a = __record-set m "x" bed.x
      in let b = __record-set m "y" bed.y
      in let d = __record-set m "z" bed.z
      in when world-update t.vendors.game.world m is Err (_) -> 0 is Ok (_) -> 1

 Composite tail 20 (UOAIX-217): a count, then each city worker's city index and its CGG1 record. The image is read before
 the city windows load, so the tail's bytes are held (cw-hold) until cw-restore binds each row to its city.
  cw-row-bytes : Integer = 8 + cgg-bytes
  cw-held-rows : Integer -> Integer
  cw-held-rows (held) = if held == 0 then 0 else peek-qword held 0
  cw-tail-size : List CgGatherer, Integer -> Integer
  cw-tail-size (xs) (held) = 8 + (if list-length xs == 0 then cw-held-rows held else list-length xs) * cw-row-bytes
  cw-write-tail : List CgGatherer, WorldTable, Integer, Integer -> Integer
  cw-write-tail (xs) (world) (held) (at) = if list-length xs == 0 & held /= 0 then cw-copy held at (cw-tail-size xs held / 8) 0
    else let n = poke-qword at 0 (list-length xs) in cw-rows xs world at 0
  cw-rows : List CgGatherer, WorldTable, Integer, Integer -> Integer
  cw-rows (xs) (world) (at) (k) = if k >= list-length xs then 0
    else let row = at + 8 + k * cw-row-bytes
    in let city = poke-qword row 0 (list-at xs k).city.city
    in let written = cgg-encode (list-at xs k) world (row + 8)
    in cw-rows xs world at (k + 1)
  cw-copy : Integer, Integer, Integer, Integer -> Integer
  cw-copy (from) (to) (qwords) (i) = if i >= qwords then 0
    else let put = poke-qword to (i * 8) (peek-qword from (i * 8)) in cw-copy from to qwords (i + 1)
 The held tail, 0 for none, or -1 when its count does not fit room.
  cw-hold : Integer, Integer -> Integer
  cw-hold (at) (room) = if room < 8 then -1
    else let n = peek-qword at 0
    in if n < 0 | n > (room - 8) / cw-row-bytes then -1
    else if n == 0 then 0
    else let held = alloc-bytes (8 + n * cw-row-bytes)
    in let copied = cw-copy at held (1 + n * cw-row-bytes / 8) 0 in held
  cw-restore : List CgCity, GvWorld, GsiState, Integer, Integer, CwFound -> CwFound
  cw-restore (cities) (v) (items) (held) (k) (out) = if k >= cw-held-rows held then out
    else let row = held + 8 + k * cw-row-bytes
    in when cw-city-in cities (peek-qword row 0) 0
      is None -> cw-restore cities v items held (k + 1) (cw-refuse out ("row " & show k & ": city " & show (peek-qword row 0) & " has no workers"))
      is Just (c) -> when cgg-load-in c v items (row + 8) cgg-bytes
        is Err (e) -> cw-restore cities v items held (k + 1) (cw-refuse out ("row " & show k & ": " & e))
        is Ok (w) -> cw-restore cities v items held (k + 1) (CwFound { workers = out.workers & [w], founded = out.founded, refused = out.refused })
