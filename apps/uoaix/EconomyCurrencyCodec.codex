  CurrencyCheckpoint = record { currency : EuCurrency, tick : Integer, sequence : Integer }
  euc-money-bytes : Integer = 64 + em-rows * 56
  euc-gold-at : Integer = 192
  euc-copper-at : Integer = euc-gold-at + es-bytes
  euc-silver-at : Integer = euc-copper-at + euc-money-bytes
  euc-events-at : Integer = euc-silver-at + euc-money-bytes
 Version 5 appends the copper and silver openings, three start tables (counters, purses, loans) and the start cells.
  euc-table-bytes : Integer = 64
  euc-tail-at : Integer = euc-events-at + em-rows * 120
  euc-tail-bytes : Integer = 2 * em-open-cells * 8 + 3 * euc-table-bytes + eu-start-cells * 8
  euc-bytes : Integer = euc-tail-at + euc-tail-bytes
 Version 7 sizes the gold economy by its sparse actors (es-size); the sections after it follow the length the header
 records at cell 24.
 Version 8 keeps no purse or loan rows in the copper, silver and start tables; the record closes with five blocks
 (copper, silver, start copper, start silver, start gold), each the purse count, the purse rows (24 bytes), the opening
 cells past the first blocks (copper and silver), then the table's loan rows (56 bytes).
  euc-fixed : Integer = euc-bytes - es-bytes
 Version 9 keeps the gold economy in a slot (its length at cell 184) so the ledgers and events after it move only
 when the economy outgrows the slot: a kept slot stays while the economy fits and is at most 2n + 64 KiB, else the
 slot is made again at 1.5n + 4 KiB.
  euc-slot : Integer, Integer -> Integer
  euc-slot (kept) (n) = es-slot kept n
  euc-size : EuCurrency -> Integer
  euc-size (x) = euc-size-in x 0
 The size of the record written over prev, the previous version 9 or 10 record (0 for none), whose slots it keeps.
  euc-size-in : EuCurrency, Integer -> Integer
  euc-size-in (x) (prev) = euc-fixed + euc-slot (euc-prev-economy prev) (es-size-in x.world (euc-prev-record prev)) + euc-parts-bytes (euc-part-slots x prev) 0
  euc-prev-economy : Integer -> Integer
  euc-prev-economy (prev) = if prev == 0 then 0 else peek-qword prev 184
 The previous record's gold economy, whose part slots the next one keeps, or 0.
  euc-prev-record : Integer -> Integer
  euc-prev-record (prev) = if prev == 0 then 0 else prev + euc-gold-at
 Version 10 closes the record with fifteen parts, each a slot length then its content padded to the slot's end: for
 each of the five tables (copper, silver, start copper, start silver, start gold) its purse count and purse rows (24
 bytes), its opening cells past the first blocks, and its loan rows (56 bytes). The slots are kept from the previous
 record by euc-slot, so a table that gains a purse or a loan moves nothing after it (UOAIX-138: in version 9 one new
 copper purse moved some 550 KB of loan rows into every commit's delta).
  euc-part-count : Integer = 15
  euc-tables : EuCurrency -> List EmMoney
  euc-tables (x) = [x.copper, x.silver, x.start.copper, x.start.silver, x.start.gold]
  euc-part-lengths : List EmMoney, Integer, List Integer -> List Integer
  euc-part-lengths (tables) (i) (out) = if i == list-length tables then out
    else let m = list-at tables i
    in euc-part-lengths tables (i + 1) (out & [8 + 24 * m.purse-count, (if m.opening == 0 then 0 else em-open-used m * 8), 56 * m.loan-count])
  euc-part-length : Integer, Integer -> Integer
  euc-part-length (at) (stop) = if at < 0 | at + 8 > stop then -1
    else let n = peek-qword at 0 in if n < 0 | int-mod n 8 /= 0 | n > stop - at - 8 then -1 else n
  euc-kept-walk : Integer, Integer, Integer, List Integer -> List Integer
  euc-kept-walk (at) (stop) (i) (out) = if i == euc-part-count then out
    else let n = euc-part-length at stop in if n < 0 then [] else euc-kept-walk (at + 8 + n) stop (i + 1) (out & [n])
  euc-kept-parts : Integer -> List Integer
  euc-kept-parts (prev) = if prev == 0 then [] else if peek-qword prev 8 /= 10 then []
    else euc-kept-walk (prev + euc-purses-from (peek-qword prev 184)) (prev + peek-qword prev 16) 0 []
  euc-pick-parts : List Integer, List Integer, Integer, List Integer -> List Integer
  euc-pick-parts (actual) (kept) (i) (out) = if i == list-length actual then out
    else euc-pick-parts actual kept (i + 1) (out & [euc-slot (if list-length kept == list-length actual then list-at kept i else 0) (list-at actual i)])
  euc-part-slots : EuCurrency, Integer -> List Integer
  euc-part-slots (x) (prev) = euc-pick-parts (euc-part-lengths (euc-tables x) 0 []) (euc-kept-parts prev) 0 []
  euc-parts-bytes : List Integer, Integer -> Integer
  euc-parts-bytes (slots) (i) = if i == list-length slots then 0 else 8 + list-at slots i + euc-parts-bytes slots (i + 1)
 The address of part k's content (k = 3 * table, then 1 for its opening cells and 2 for its loans) in a version 10 record.
  euc-part-at : Integer, Integer -> Integer
  euc-part-at (buf) (k) = euc-part-walk (buf + euc-purses-from (peek-qword buf 184)) k
  euc-part-walk : Integer, Integer -> Integer
  euc-part-walk (at) (k) = if k == 0 then at + 8 else euc-part-walk (at + 8 + peek-qword at 0) (k - 1)
  euc-events-from : Integer -> Integer
  euc-events-from (economy) = euc-gold-at + economy + 2 * euc-money-bytes
  euc-tail-from : Integer -> Integer
  euc-tail-from (economy) = euc-events-from economy + em-rows * 120
  euc-purses-from : Integer -> Integer
  euc-purses-from (economy) = euc-tail-from economy + euc-tail-bytes
 The gold economy's length from the header (cell 24), or 0 when the record cannot hold it and five purse blocks.
  euc-economy : Integer, Integer -> Integer
  euc-economy (buf) (size) = let economy = peek-qword buf 24
    in if size < euc-fixed + es-bytes + 48 | economy < es-bytes + 8 | economy > size - euc-fixed - 40 then 0 else economy
  euc-write-table : Integer, EmMoney -> Integer
  euc-write-table (buf) (m) = es-write-money buf 0 m
  euc-read-table : Integer, EmMoney -> Integer
  euc-read-table (buf) (m) = es-read-money buf 0 m
  euc-tail : Integer, EuCurrency, Boolean, Integer -> Integer
  euc-tail (buf) (x) (read) (economy) =
    let at = buf + euc-tail-from economy
    in let open = em-open-cells * 8
    in let tables = at + 2 * open
    in let cells = tables + 3 * euc-table-bytes
    in if read then
      let a = es-copy-cells at x.copper.opening em-open-cells 0
      in let b = es-copy-cells (at + open) x.silver.opening em-open-cells 0
      in let c = euc-read-table tables x.start.copper
      in let d = euc-read-table (tables + euc-table-bytes) x.start.silver
      in let e = euc-read-table (tables + 2 * euc-table-bytes) x.start.gold
      in es-copy-cells cells x.start.cells eu-start-cells 0
    else let a = es-copy-cells x.copper.opening at em-open-cells 0
      in let b = es-copy-cells x.silver.opening (at + open) em-open-cells 0
      in let c = euc-write-table tables x.start.copper
      in let d = euc-write-table (tables + euc-table-bytes) x.start.silver
      in let e = euc-write-table (tables + 2 * euc-table-bytes) x.start.gold
      in es-copy-cells x.start.cells cells eu-start-cells 0

 The parts from at in table order; each answers the address after the last part, -1 when refused.
  euc-write-parts : Integer, List EmMoney, List Integer, Integer -> Integer
  euc-write-parts (at) (tables) (slots) (i) = if i == list-length tables then at
    else let m = list-at tables i
    in let p = list-at slots (i * 3)
    in let o = list-at slots (i * 3 + 1)
    in let l = list-at slots (i * 3 + 2)
    in let a = poke-qword at 0 p
    in let n = poke-qword at 8 m.purse-count
    in let rows = euc-write-purse-rows (at + 16) m 0
    in let open-at = at + 8 + p
    in let b = poke-qword open-at 0 o
    in let opened = if m.opening == 0 then 0 else es-copy-cells (m.opening + em-open-cells * 8) (open-at + 8) (em-open-used m) 0
    in let loan-at = open-at + 8 + o
    in let c = poke-qword loan-at 0 l
    in let lent = euc-write-loans (loan-at + 8) m 0
    in euc-write-parts (loan-at + 8 + l) tables slots (i + 1)
  euc-read-parts : Integer, Integer, List EmMoney, Integer -> Integer
  euc-read-parts (at) (stop) (tables) (i) = if i == list-length tables then at
    else let m = list-at tables i
    in let p = euc-part-length at stop
    in if p < 8 then -1
    else let count = peek-qword at 8
    in if count /= m.purse-count | count < 1 | count > (p - 8) / 24 then -1
    else let open-at = at + 8 + p
    in let o = euc-part-length open-at stop
    in let more = if m.opening == 0 then 0 else em-open-extra count m.loan-count
    in if o < 0 | more * 8 > o then -1
    else let loan-at = open-at + 8 + o
    in let l = euc-part-length loan-at stop
    in if l < 0 | m.loan-count < 0 | m.loan-count > l / 56 then -1
    else let lent = em-grow-loans m (m.loan-count - list-length m.loans)
    in let room = em-grow-purses m (count - list-length m.purses)
    in let rows = euc-read-purse-rows (at + 16) m count 0
    in let opened = if more == 0 then 0 else es-copy-cells (open-at + 8) (m.opening + em-open-cells * 8) more 0
    in let loaned = euc-read-loans (loan-at + 8) m 0
    in euc-read-parts (loan-at + 8 + l) stop tables (i + 1)
  euc-write-purse-rows : Integer, EmMoney, Integer -> Integer
  euc-write-purse-rows (at) (m) (i) = if i >= m.purse-count then at + i * 24
    else let a = es-write-purse at (i * 24) (list-at m.purses i)
    in euc-write-purse-rows at m (i + 1)
  euc-read-purse-rows : Integer, EmMoney, Integer, Integer -> Integer
  euc-read-purse-rows (at) (m) (count) (i) = if i >= count then at + i * 24
    else let a = es-read-purse at (i * 24) (list-at m.purses i)
    in euc-read-purse-rows at m count (i + 1)
  euc-write-loans : Integer, EmMoney, Integer -> Integer
  euc-write-loans (at) (m) (i) = if i >= m.loan-count then at + i * 56
    else let a = es-write-loan at (i * 56) (list-at m.loans i)
    in euc-write-loans at m (i + 1)
  euc-read-loans : Integer, EmMoney, Integer -> Integer
  euc-read-loans (at) (m) (i) = if i >= m.loan-count then at + i * 56
    else let a = es-read-loan at (i * 56) (list-at m.loans i)
    in euc-read-loans at m (i + 1)
  euc-write-ledger : Integer, EmMoney, Integer -> Integer
  euc-write-ledger (buf) (m) (i) = if i == em-rows | i >= m.entry-count then 0
    else let a = es-write-entry buf (64 + i * 56) (list-at m.ledger i)
    in euc-write-ledger buf m (i + 1)
  euc-read-ledger : Integer, EmMoney, Integer -> Integer
  euc-read-ledger (buf) (m) (i) = if i == em-rows then 0
    else let a = es-read-entry buf (64 + i * 56) (list-at m.ledger i)
    in euc-read-ledger buf m (i + 1)
  euc-write-money : Integer, EmMoney -> Integer
  euc-write-money (buf) (m) = let a = es-write-money buf 0 m
    in euc-write-ledger buf m 0
  euc-read-money : Integer, EmMoney -> Integer
  euc-read-money (buf) (m) = let a = es-read-money buf 0 m
    in euc-read-ledger buf m 0
  euc-write-events : Integer, EuCurrency, Integer, Integer -> Integer
  euc-write-events (buf) (x) (at) (i) = if i == em-rows | i >= x.count then 0
    else let a = euf-write-event buf (at + i * 120) (list-at x.events i)
    in euc-write-events buf x at (i + 1)
  euc-read-events : Integer, EuCurrency, Integer, Integer -> Integer
  euc-read-events (buf) (x) (at) (i) = if i == em-rows then 0
    else let a = euf-read-event buf (at + i * 120) (list-at x.events i)
    in euc-read-events buf x at (i + 1)
  euc-empty : EpWorld -> EuCurrency
  euc-empty (w) = EuCurrency { world = w, copper = em-new 0, silver = em-new 0,
    events = eu-events 0 [], count = 0, copper-rate = 100, silver-rate = 10,
    copper-owner = 0, silver-owner = 0, copper-yield = 0, silver-yield = 0,
    copper-ingots = 0, silver-ingots = 0, copper-seq = 0, silver-seq = 0, gold-seq = 0, purse-count = 1,
    base = 0, start = eu-start-new 0 }
  euc-encode : CurrencyCheckpoint, Integer, Integer -> Result Integer Text
  euc-encode (checkpoint) (buf) (capacity) = euc-write checkpoint buf capacity
  euc-write : CurrencyCheckpoint, Integer, Integer -> Result Integer Text
  euc-write (checkpoint) (buf) (capacity) = euc-write-in checkpoint buf capacity 0
  euc-write-in : CurrencyCheckpoint, Integer, Integer, Integer -> Result Integer Text
  euc-write-in (checkpoint) (buf) (capacity) (prev) = euc-write-timed checkpoint buf capacity prev 0
 The commit's encode timing (UOAIX-196): HPET stamps in the timing buffer at cells 8 to 12, after the clear, the gold
 economy, the copper and silver ledgers, the events and the tails; 0 times nothing.
  euc-stamp : Integer, Integer -> Integer
  euc-stamp (timing) (slot) = if timing == 0 then 0 else poke-qword timing (slot * 8) hpet-ticks
  euc-write-timed : CurrencyCheckpoint, Integer, Integer, Integer, Integer -> Result Integer Text
  euc-write-timed (checkpoint) (buf) (capacity) (prev) (timing) =
    let x = checkpoint.currency
    in let economy = es-size-in x.world (euc-prev-record prev)
    in let slot = euc-slot (euc-prev-economy prev) economy
    in let parts = euc-part-slots x prev
    in let size = euc-fixed + slot + euc-parts-bytes parts 0
    in if capacity < size | not (ev-range checkpoint.tick ep-limit) | not (ev-range checkpoint.sequence ep-limit) then Err "currency destination or metadata invalid"
    else let clear = ts-zero buf size 0
    in let s8 = euc-stamp timing 8
    in let a = poke-qword buf 0 #31435545
    in let b = poke-qword buf 8 10
    in let slotted = poke-qword buf 184 slot
    in let c = poke-qword buf 16 size
    in let d = poke-qword buf 24 economy
    in let e = poke-qword buf 32 checkpoint.tick
    in let f = poke-qword buf 40 checkpoint.sequence
    in let policy = euf-write-policy buf 64 x
    in when es-encode-over (EconomyCheckpoint { world = x.world, tick = checkpoint.tick, sequence = checkpoint.sequence }) (buf + euc-gold-at) economy (euc-prev-record prev)
      is Err (e) -> Err e
      is Ok (_) ->
        let s9 = euc-stamp timing 9
        in let copper = euc-write-money (buf + euc-gold-at + slot) x.copper
        in let silver = euc-write-money (buf + euc-gold-at + slot + euc-money-bytes) x.silver
        in let s10 = euc-stamp timing 10
        in let events = euc-write-events buf x (euc-events-from slot) 0
        in let s11 = euc-stamp timing 11
        in let base = poke-qword buf 168 x.base
        in let sealed = poke-qword buf 176 x.start.sealed
        in let tail = euc-tail buf x False slot
        in let purses = euc-write-parts (buf + euc-purses-from slot) (euc-tables x) parts 0
        in let s12 = euc-stamp timing 12
        in let hash = poke-qword buf 48 (ws-hash buf size 0 2166136261)
        in Ok size
  euc-decode : Integer, Integer -> Result CurrencyCheckpoint Text
  euc-decode (buf) (size) = euc-decode-any buf size
  euc-decode-any : Integer, Integer -> Result CurrencyCheckpoint Text
  euc-decode-any (buf) (size) =
    if peek-qword buf 8 /= 10 then Err "currency checkpoint predates format 10 (each purse table part in a slot); start a fresh world"
    else if euc-economy buf size == 0 then Err "currency checkpoint length invalid"
    else let economy = euc-economy buf size
    in let slot = peek-qword buf 184
    in let current = True
    in let copper-at = euc-gold-at + slot
    in let silver-at = copper-at + euc-money-bytes
    in if peek-qword buf 0 /= #31435545 | peek-qword buf 16 /= size | peek-qword buf 24 /= economy | peek-qword buf 56 /= 0 then Err "currency checkpoint format invalid"
    else if not (ev-range (peek-qword buf 32) ep-limit) | not (ev-range (peek-qword buf 40) ep-limit) | not (ev-range (peek-qword buf 64) em-rows) then Err "currency checkpoint metadata invalid"
    else if slot < economy | int-mod slot 8 /= 0 | slot > size - euc-fixed - 40 then Err "currency economy slot invalid"
    else if not (ev-range (peek-qword buf 168) ep-limit) | not (ev-range (peek-qword buf 176) ep-limit) then Err "currency header reserved bytes nonzero"
    else if peek-qword buf 48 /= ws-hash buf size 0 2166136261 then Err "currency checkpoint checksum invalid"
    else when es-decode-record (buf + euc-gold-at) economy (peek-qword buf 32) (peek-qword buf 40)
      is Err (e) -> Err e
      is Ok (gold) ->
        let x = euc-empty gold.world
        in let policy = euf-read-policy buf 64 x
        in let copper = euc-read-money (buf + copper-at) x.copper
        in let silver = euc-read-money (buf + silver-at) x.silver
        in let events = euc-read-events buf x (silver-at + euc-money-bytes) 0
        in let tail = euc-tail buf x True slot
        in if euc-read-parts (buf + euc-purses-from slot) (buf + size) (euc-tables x) 0 /= buf + size then Err "currency purse rows invalid"
        else let base = if current then __record-set x "base" (peek-qword buf 168) else x
        in let sealed = if current then __record-set x.start "sealed" (peek-qword buf 176) else x.start
        in Ok (CurrencyCheckpoint { currency = x, tick = gold.tick, sequence = gold.sequence })
  euc-decode-record : Integer, Integer, Integer, Integer -> Result CurrencyCheckpoint Text
  euc-decode-record (buf) (size) (tick) (sequence) =
    if euc-economy buf size == 0 then Err "currency record length invalid"
    else if peek-qword buf 32 /= tick | peek-qword buf 40 /= sequence then Err "currency record metadata mismatch"
    else euc-decode buf size
  euc-decode-record-any : Integer, Integer, Integer, Integer -> Result CurrencyCheckpoint Text
  euc-decode-record-any (buf) (size) (tick) (sequence) =
    if euc-economy buf size == 0 then Err "currency record length invalid"
    else if peek-qword buf 32 /= tick | peek-qword buf 40 /= sequence then Err "currency record metadata mismatch"
    else euc-decode-any buf size
