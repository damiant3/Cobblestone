Chapter: GameCraftCodec
  cites Uoaix chapter GameCraftState
  cites Uoaix chapter GameHarvestCodec

 UCC1 is112 bytes: magic/version/next-menu/reserved qwords, followed by
 five player serial/remaining cooldown pairs. Menu authority is transient.

  gcrc-write : GameCraft, Integer, Integer, Integer -> Integer
  gcrc-write (state) (now) (buf) (i) = if i == 5 then 0
    else let r = list-at state.requests i
    in let bound = ghc-bound state.harvest r.serial i
    in let a = poke-qword buf (32 + i * 16) (if bound then r.serial else 0)
    in let b = poke-qword buf (40 + i * 16) (if bound then max 0 (r.next - now) else 0)
    in gcrc-write state now buf (i + 1)
  gcrc-encode : GameCraft, Integer, Integer, Integer -> Result Integer Text
  gcrc-encode (state) (now) (buf) (capacity) =
    if capacity < 112 | now < 0 | now > 9223372036854775807 - gh-ticks 3000
      | state.nonce < 1 | state.nonce > 16384 then Err "craft codec extent or nonce"
    else let a = poke-qword buf 0 #31434355
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 state.nonce
    in let d = poke-qword buf 24 0
    in let requests = gcrc-write state now buf 0
    in if not (ghc-requests-valid state.harvest buf 0) then Err "craft codec player bindings"
    else Ok 112
  gcrc-read : GameCraft, Integer, Integer, Integer -> Integer
  gcrc-read (state) (now) (buf) (i) = if i == 5 then 0
    else let r = list-at state.requests i
    in let a = __record-set r "serial" (peek-qword buf (32 + i * 16))
    in let b = __record-set r "next" (now + peek-qword buf (40 + i * 16))
    in let c = __record-set r "connection" -1
    in let d = __record-set r "tool" 0
    in let e = __record-set r "menu" 0
    in let f = __record-set r "category" 0
    in let g = __record-set r "expires" 0
    in gcrc-read state now buf (i + 1)
  gcrc-decode : GameCraft, Integer, Integer, Integer -> Result Integer Text
  gcrc-decode (state) (now) (buf) (size) =
    if size /= 112 | now < 0 | now > 9223372036854775807 - gh-ticks 3000 then Err "craft codec extent"
    else let nonce = peek-qword buf 16
    in if peek-qword buf 0 /= #31434355 | peek-qword buf 8 /= 1 | peek-qword buf 24 /= 0
      | nonce < 1 | nonce > 16384 then Err "craft codec format"
    else if not (ghc-requests-valid state.harvest buf 0) then Err "craft codec player bindings"
    else let rows = gcrc-read state now buf 0
    in let next = __record-set state "nonce" nonce
    in Ok size

