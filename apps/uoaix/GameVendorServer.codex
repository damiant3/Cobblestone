Chapter: GameVendorServer
  cites Uoaix chapter GameVendorDemo

  opening : [Console, Network.Read, Network.Write] Integer = act
    card <- net-driver-bring-up
    let arena = nc-set-acquire (nc-pool-cell process-get-pid)
    in let released = nc-set-release arena
    in let huffman = gh-new 0
    in act
      loaded <- wl-load 1408 1680 64 64
      when loaded
        is Err (e) -> act
          print-line-uni ("REFUSE vendor preload " & e)
          1
        end
        is Ok (map) -> when gs-new 0
          is Err (e) -> act
            print-line-uni ("REFUSE vendor shard " & e)
            1
          end
          is Ok (shard) -> when gvd-mixed-economy 0
            is Err (e) -> act
              print-line-uni ("REFUSE vendor economy " & e)
              1
            end
            is Ok (currency) -> when walk-ground map 1421 1698
              is Err (e) -> act
                print-line-uni ("REFUSE vendor ground " & e)
                1
              end
              is Ok (z) -> when gvd-world shard currency z
                is Err (e) -> act
                  print-line-uni ("REFUSE vendor setup " & e)
                  1
                end
                is Ok (vendor) -> act
                  print-line-uni "READY vendor demo: say buy or sell near 1421,1698; purse 1 gold, 40 silver, 200 copper; volatile state"
                  gn-loop-hooks gv-specs (gn-route (gv-handler vendor)) (gvd-pulse vendor) shard map huffman 2593 0
                end
    end
  end
