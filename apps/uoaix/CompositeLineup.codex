Chapter: CompositeLineup
  cites Uoaix chapter CompositeGameRules
  cites Uoaix chapter CharacterStylist
  cites Uoaix chapter ShopStock


  cgl-strip : WorldTable, Integer -> Result Integer Text
  cgl-strip (world) (serial) = let child = world-first-child world serial
    in if child == 0 then Ok 0
    else when cgl-strip world child
      is Err (e) -> Err e
      is Ok (_) -> when world-delete world child
        is Err (e) -> Err e
        is Ok (_) -> cgl-strip world serial
  cgl-fixture : CombatActor -> Boolean
  cgl-fixture (a) = a.serial /= 0 & a.npc & (cbd-name a.name "Sparring partner" 0 | cbd-name a.name "Veteran opponent" 0)
  cgl-remove-fixtures : CompositeGame, Integer -> Result Integer Text
  cgl-remove-fixtures (owner) (i) = if i == list-length owner.combat.actors then Ok 0
    else let a = list-at owner.combat.actors i
    in if not (cgl-fixture a) then cgl-remove-fixtures owner (i + 1)
    else let world = owner.checkpoint.game.world
    in let serial = a.serial
    in let stopped = cb-stop owner.combat a
    in let cleared = cb-clear-target owner.combat serial 0
    in let unbound = __record-set a "serial" 0
    in let renamed = cb-clear-name a.name 0
    in when world-get world serial
      is Err (_) -> cgl-remove-fixtures owner (i + 1)
      is Ok (_) -> when cgl-strip world serial
        is Err (e) -> Err e
        is Ok (_) -> when world-delete world serial
          is Err (e) -> Err e
          is Ok (_) -> cgl-remove-fixtures owner (i + 1)


  cgl-mortal : CompositeGame, Integer -> Integer
  cgl-mortal (owner) (serial) = if serial == 0 then 0
    else when cb-ensure owner.combat owner.checkpoint.game serial
      is Err (_) -> -1
      is Ok (actor) -> let mortal = __record-set actor "immune" False in 0

 Shopkeepers are not immune (Damian, 2026-10-07, BritainShops.md); clearing the flag here also clears a saved world's.
  cgl-mortal-vendors : CompositeGame, Integer -> Integer
  cgl-mortal-vendors (owner) (i) = if i >= owner.vendor.vendor-count then 0
    else if cgl-mortal owner (list-at owner.vendor.vendors i).serial < 0 then -1 else cgl-mortal-vendors owner (i + 1)
 A shop's spawn region is its sales floor; 8 tiles around it reach the stations its staff work at (the Hammer And Anvil's
 anvil stands 6 tiles south of its region).
  cgl-counter-reach : Integer = 8
  cgl-at-counter : Integer, WorldObject -> Boolean
  cgl-at-counter (i) (m) = let shop = list-at bb-shops i
    in m.kind == 1 & m.health > 0 & m.x >= shop.x1 - cgl-counter-reach & m.x <= shop.x2 + cgl-counter-reach
    & m.y >= shop.y1 - cgl-counter-reach & m.y <= shop.y2 + cgl-counter-reach
  cgl-resident-of : TownLive, Integer, Integer, Integer -> Boolean
  cgl-resident-of (town) (i) (serial) (r) = if r >= town.count then False
    else if tl-shop-of r == i & (tf-person town.people (list-at town.residents r).person).world-serial == serial then True
    else cgl-resident-of town i serial (r + 1)
  cgl-staff-of : CompositeGame, Integer, Integer -> Boolean
  cgl-staff-of (owner) (i) (serial) = serial /= 0 & i < bb-shop-count & i < owner.vendor.vendor-count
    & ((list-at owner.vendor.vendors i).serial == serial
      | (when owner.town is None -> False is Just (town) -> cgl-resident-of town i serial 0))
  cgl-staff : CompositeGame, Integer, Integer -> Integer
  cgl-staff (owner) (i) (serial) = if not (cgl-staff-of owner i serial) then 0
    else when world-get owner.vendor.game.world serial
      is Err (_) -> 0
      is Ok (m) -> if cgl-at-counter i m then 1 else 0
  cgl-serving : CompositeGame, Integer, WorldObject, Integer -> Boolean
  cgl-serving (owner) (i) (player) (serial) = cgl-staff-of owner i serial & (when world-get owner.vendor.game.world serial
    is Err (_) -> False
    is Ok (m) -> cgl-at-counter i m & gv-near player m)
  cgl-serving-resident : CompositeGame, TownLive, Integer, WorldObject, Integer -> Boolean
  cgl-serving-resident (owner) (town) (i) (player) (r) = if r >= town.count then False
    else (tl-shop-of r == i & cgl-serving owner i player (tf-person town.people (list-at town.residents r).person).world-serial)
      | cgl-serving-resident owner town i player (r + 1)
  cgl-serves : CompositeGame, Integer, Integer -> Integer
  cgl-serves (owner) (i) (player) = if i >= bb-shop-count | i >= owner.vendor.vendor-count then 0
    else when world-get owner.vendor.game.world player
      is Err (_) -> 0
      is Ok (p) -> if cgl-serving owner i p (list-at owner.vendor.vendors i).serial
          | (when owner.town is None -> False is Just (town) -> cgl-serving-resident owner town i p 0) then 1 else 0
  cgl-arrange : CompositeGame, Boolean -> Result Integer Text
  cgl-arrange (owner) (testing) =
    let quiet = if owner.combat.scene == 1 then __record-set owner.combat "scene" 2 else owner.combat
    in when cgl-remove-fixtures owner 0
      is Err (e) -> Err e
      is Ok (_) -> if cgl-mortal-vendors owner 0 < 0 then Err "shopkeeper combat binding refused"
        else let stocked = ss-ensure owner.vendor owner.items owner.town-map 0
        in let bound = __record-set owner.vendor "window" (ss-window owner.vendor)
        in let staffed = __record-set owner.vendor "staff" (cgl-staff owner)
        in let served = __record-set owner.vendor "serves" (cgl-serves owner)
        in let returned = gv-window-all owner.vendor 0
        in let woken = cg-rise-all owner 0
        in let kept = cg-mark-corpses owner 0 in Ok 0
