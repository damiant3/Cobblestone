Chapter: EconomyMetals
  cites Uoaix chapter EconomyCatalog

  ex-catalog : Integer -> EgCatalog
  ex-catalog (unused) =
    let c = eg-standard 0
    in let i1 = list-push c.items (eg-item "copper ore" 2)
    in let i2 = list-push i1 (eg-item "silver ore" 2)
    in let i3 = list-push i2 (eg-item "copper ingots" 2)
    in let i4 = list-push i3 (eg-item "silver ingots" 2)
    in let i5 = list-push i4 (eg-item "copper coin" 2)
    in let i6 = list-push i5 (eg-item "silver coin" 2)
    in let s1 = list-push c.resources (eg-resource 63 0 25 1 0 48 4)
    in let s2 = list-push s1 (eg-resource 64 0 25 1 0 72 2)
    in let r1 = list-push c.recipes (eg-recipe 65 1 63 2 0 0 0 0 3 0 8)
    in let r2 = list-push r1 (eg-recipe 66 1 64 2 0 0 0 0 3 0 8)
    in let r3 = list-push r2 (eg-recipe 67 1 65 1 0 0 0 0 12 62 8)
    in let r4 = list-push r3 (eg-recipe 68 1 66 1 0 0 0 0 12 62 8)
    in EgCatalog { items = i6, resources = s2, recipes = r4 }
