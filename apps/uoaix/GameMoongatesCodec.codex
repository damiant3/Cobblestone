Chapter: GameMoongatesCodec
  cites Uoaix chapter GameMoongates

 UMG1 has a64-byte header, eight gate serials and32 follower rows of24 bytes.
 Locations and moon rules are compiled constants. World/GSI/clock restore first.

  gmgc-size : Integer = 64 + 8 * 8 + 32 * 24
  gmgc-gates-valid : GameMoongates, Integer, Integer -> Boolean
  gmgc-gates-valid (g) (buf) (i) = if i == 8 then True
    else gmg-bound g i (peek-qword buf (64 + i * 8)) & gmgc-gates-valid g buf (i + 1)
  gmgc-distinct : Integer, Integer, Integer, Integer -> Boolean
  gmgc-distinct (buf) (serial) (i) (limit) = if serial == 0 | i == limit then True
    else peek-qword buf (128 + i * 24) /= serial & gmgc-distinct buf serial (i + 1) limit
  gmgc-count : Integer, Integer, Integer -> Integer
  gmgc-count (buf) (leader) (i) = if i == 32 then 0
    else (if peek-qword buf (128 + i * 24) > 0 & peek-qword buf (136 + i * 24) == leader & peek-qword buf (144 + i * 24) == 1 then 1 else 0) + gmgc-count buf leader (i + 1)
  gmgc-followers-valid : GameMoongates, Integer, Integer -> Boolean
  gmgc-followers-valid (g) (buf) (i) = if i == 32 then True
    else let at = 128 + i * 24
    in let serial = peek-qword buf at
    in let leader = peek-qword buf (at + 8)
    in let following = peek-qword buf (at + 16)
    in if serial == 0 then leader == 0 & following == 0 & gmgc-followers-valid g buf (i + 1)
    else (following == 0 | following == 1) & gmg-follower-valid g leader serial
      & gmgc-distinct buf serial 0 i & gmgc-count buf leader 0 <= 8 & gmgc-followers-valid g buf (i + 1)
  gmgc-gates : GameMoongates, Integer, Boolean, Integer -> Integer
  gmgc-gates (g) (buf) (read) (i) = if i == 8 then 0
    else let gate = list-at g.gates i
    in let done = if read then let loaded = __record-set gate "serial" (peek-qword buf (64 + i * 8)) in 0
      else poke-qword buf (64 + i * 8) gate.serial
    in gmgc-gates g buf read (i + 1)
  gmgc-followers : GameMoongates, Integer, Boolean, Integer -> Integer
  gmgc-followers (g) (buf) (read) (i) = if i == 32 then 0
    else let f = list-at g.followers i
    in let at = 128 + i * 24
    in let a = if read then let loaded = __record-set f "serial" (peek-qword buf at) in 0 else poke-qword buf at f.serial
    in let b = if read then let loaded = __record-set f "leader" (peek-qword buf (at + 8)) in 0 else poke-qword buf (at + 8) f.leader
    in let c = if read then let loaded = __record-set f "following" (peek-qword buf (at + 16) == 1) in 0 else poke-qword buf (at + 16) (if f.following then 1 else 0)
    in gmgc-followers g buf read (i + 1)
  gmgc-clear-views : GameMoongates, Integer -> Integer
  gmgc-clear-views (g) (i) = if i == gmg-viewer-limit then 0
    else let v = list-at g.viewers i
    in let a = __record-set v "serial" 0
    in let b = __record-set v "connection" -1
    in let c = __record-set v "visible" 0
    in gmgc-clear-views g (i + 1)
  gmgc-encode : GameMoongates, Integer, Integer -> Result Integer Text
  gmgc-encode (g) (buf) (capacity) = if capacity < gmgc-size then Err "moongate codec destination"
    else if list-length g.gates /= 8 | list-length g.followers /= 32 | list-length g.viewers /= gmg-viewer-limit
      | g.sequence < 0 | g.sequence > gmg-limit then Err "moongate codec state"
    else let a = poke-qword buf 0 #31474D55
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 gmgc-size
    in let d = poke-qword buf 24 g.sequence
    in let e = poke-qword buf 32 8
    in let f = poke-qword buf 40 32
    in let h = poke-qword buf 56 0
    in let gates = gmgc-gates g buf False 0
    in let followers = gmgc-followers g buf False 0
    in if not (gmgc-gates-valid g buf 0 & gmgc-followers-valid g buf 0) then Err "moongate codec bindings"
    else let hash = poke-qword buf 48 (ws-hash buf gmgc-size 0 2166136261) in Ok gmgc-size
  gmgc-decode : GameMoongates, Integer, Integer -> Result Integer Text
  gmgc-decode (g) (buf) (size) = if size /= gmgc-size then Err "moongate codec length"
    else if peek-qword buf 0 /= #31474D55 | peek-qword buf 8 /= 1 | peek-qword buf 16 /= size
      | peek-qword buf 24 < 0 | peek-qword buf 24 > gmg-limit
      | peek-qword buf 32 /= 8 | peek-qword buf 40 /= 32 | peek-qword buf 56 /= 0 then Err "moongate codec header"
    else if peek-qword buf 48 /= ws-hash buf size 0 2166136261 then Err "moongate codec checksum"
    else if not (gmgc-gates-valid g buf 0 & gmgc-followers-valid g buf 0) then Err "moongate codec bindings"
    else let gates = gmgc-gates g buf True 0
    in let followers = gmgc-followers g buf True 0
    in let sequence = __record-set g "sequence" (peek-qword buf 24)
    in let reset = gmgc-clear-views g 0 in Ok size

