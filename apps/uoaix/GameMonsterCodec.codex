Chapter: GameMonsterCodec
  cites Uoaix chapter GameMonster

 UMC1 has eight qwords: magic, version, slot count, home x/y/z/radius,
 reserved zero. Each slot has serial, facing, remaining raw PIT ticks.
 UCB1 owns profiles/RNG; the encompassing checkpoint owns integrity.

  gmc-size : Integer -> Integer
  gmc-size (count) = 64 + count * 24
  gmc-bound : GameMonster, WorldTable, Integer -> Boolean
  gmc-bound (g) (world) (serial) = if serial == 0 then True
    else when world-get world serial
      is Err (_) -> False
      is Ok (m) -> if m.kind /= 1 then False
        else let a = list-at g.combat.actors (world-slot world serial)
        in a.serial == serial & a.npc
  gmc-home : Integer, Integer, Integer, Integer -> Boolean
  gmc-home (x) (y) (z) (radius) =
    x >= 0 & x <= 6143 & y >= 0 & y <= 4095 & z >= -128 & z <= 127 & radius >= 1 & radius <= 16
  gmc-state-valid : GameMonster, WorldTable, Integer, Integer -> Boolean
  gmc-state-valid (g) (world) (now) (i) = if i == list-length g.slots then True
    else let slot = list-at g.slots i
    in slot.direction >= 0 & slot.direction < 8 & slot.due >= 0
      & slot.due <= now + gm-ticks 60000 & (gmc-gone world slot.serial | gmc-bound g world slot.serial)
      & gmc-state-valid g world now (i + 1)
 A killed NPC's mobile is deleted at death and its slot is cleared on the next
 monster pulse; a save between the two writes the slot as an empty respawn.
  gmc-gone : WorldTable, Integer -> Boolean
  gmc-gone (world) (serial) = serial /= 0 & is-err (world-get world serial)
  gmc-write : GameMonster, WorldTable, Integer, Integer, Integer -> Integer
  gmc-write (g) (world) (now) (buf) (i) = if i == list-length g.slots then 0
    else let slot = list-at g.slots i
    in let at = 64 + i * 24
    in let gone = gmc-gone world slot.serial
    in let a = poke-qword buf at (if gone then 0 else slot.serial)
    in let b = poke-qword buf (at + 8) slot.direction
    in let c = poke-qword buf (at + 16) (if gone then gm-ticks 60000 else max 0 (slot.due - now))
    in gmc-write g world now buf (i + 1)
  gmc-encode : GameMonster, WorldTable, Integer, Integer, Integer -> Result Integer Text
  gmc-encode (g) (world) (now) (buf) (capacity) =
    let count = list-length g.slots
    in if count < 1 | count > 8 | list-length g.combat.actors /= world.capacity
      | now < 0 | now > 9223372036854775807 - gm-ticks 60000 then Err "monster codec owner or clock"
    else if capacity < gmc-size count then Err "monster codec destination"
    else if not (gmc-home g.x g.y g.z g.radius) | not (gmc-state-valid g world now 0) then Err "monster codec state"
    else let a = poke-qword buf 0 #31434D55
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 count
    in let d = poke-qword buf 24 g.x
    in let e = poke-qword buf 32 g.y
    in let f = poke-qword buf 40 g.z
    in let h = poke-qword buf 48 g.radius
    in let reserved = poke-qword buf 56 0
    in let rows = gmc-write g world now buf 0
    in Ok (gmc-size count)
  gmc-distinct : Integer, Integer, Integer, Integer -> Boolean
  gmc-distinct (buf) (serial) (i) (limit) = if serial == 0 | i == limit then True
    else peek-qword buf (64 + i * 24) /= serial & gmc-distinct buf serial (i + 1) limit
  gmc-rows-valid : GameMonster, WorldTable, Integer, Integer -> Boolean
  gmc-rows-valid (g) (world) (buf) (i) = if i == list-length g.slots then True
    else let at = 64 + i * 24
    in let serial = peek-qword buf at
    in let direction = peek-qword buf (at + 8)
    in let remaining = peek-qword buf (at + 16)
    in direction >= 0 & direction < 8 & remaining >= 0 & remaining <= gm-ticks 60000
      & gmc-bound g world serial & gmc-distinct buf serial 0 i & gmc-rows-valid g world buf (i + 1)
  gmc-read : GameMonster, Integer, Integer, Integer -> Integer
  gmc-read (g) (now) (buf) (i) = if i == list-length g.slots then 0
    else let slot = list-at g.slots i
    in let at = 64 + i * 24
    in let a = __record-set slot "serial" (peek-qword buf at)
    in let b = __record-set slot "direction" (peek-qword buf (at + 8))
    in let c = __record-set slot "due" (now + peek-qword buf (at + 16))
    in let d = __record-set slot "visible" False
    in gmc-read g now buf (i + 1)
  gmc-decode : GameMonster, WorldTable, Integer, Integer, Integer -> Result Integer Text
  gmc-decode (g) (world) (now) (buf) (size) =
    let count = list-length g.slots
    in if count < 1 | count > 8 | list-length g.combat.actors /= world.capacity
      | now < 0 | now > 9223372036854775807 - gm-ticks 60000 then Err "monster codec owner or clock"
    else if size /= gmc-size count then Err "monster codec length"
    else if peek-qword buf 0 /= #31434D55 | peek-qword buf 8 /= 1
      | peek-qword buf 16 /= count | peek-qword buf 56 /= 0 then Err "monster codec format"
    else if not (gmc-home (peek-qword buf 24) (peek-qword buf 32) (peek-qword buf 40) (peek-qword buf 48))
      | not (gmc-rows-valid g world buf 0) then Err "monster codec bindings"
    else let a = __record-set g "x" (peek-qword buf 24)
    in let b = __record-set g "y" (peek-qword buf 32)
    in let c = __record-set g "z" (peek-qword buf 40)
    in let d = __record-set g "radius" (peek-qword buf 48)
    in let e = gmc-read g now buf 0
    in let f = __record-set g "connection" -1
    in let tick = __record-set g.combat "tick" now
    in Ok size

