Chapter: EconomyCatalog

  EgItem = record { name : Text, chain : Integer }
  EgResource = record { item : Integer, seed : Integer, tool : Integer,
    skill : Integer, ground : Integer, regrow : Integer, quantity : Integer }
  EgRecipe = record { item : Integer, quantity : Integer,
    one : Integer, one-count : Integer, two : Integer, two-count : Integer,
    three : Integer, three-count : Integer, station : Integer, tool : Integer,
    skill : Integer }
  EgCatalog = record { items : List EgItem, resources : List EgResource,
    recipes : List EgRecipe }

  eg-item : Text, Integer -> EgItem
  eg-item (name) (chain) = EgItem { name = name, chain = chain }
  eg-resource : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> EgResource
  eg-resource (item) (seed) (tool) (skill) (ground) (regrow) (quantity) =
    EgResource { item = item, seed = seed, tool = tool, skill = skill,
      ground = ground, regrow = regrow, quantity = quantity }
  eg-recipe : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> EgRecipe
  eg-recipe (item) (quantity) (one) (one-count) (two) (two-count) (three) (three-count) (station) (tool) (skill) =
    EgRecipe { item = item, quantity = quantity, one = one, one-count = one-count,
      two = two, two-count = two-count, three = three, three-count = three-count,
      station = station, tool = tool, skill = skill }

  eg-standard : Integer -> EgCatalog
  eg-standard (unused) = EgCatalog {
    items = [eg-item "stone" 1, eg-item "fallen branches" 6, eg-item "clay" 1,
      eg-item "water" 5, eg-item "iron ore" 1, eg-item "gold ore" 2,
