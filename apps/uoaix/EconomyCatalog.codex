  eg-id : EgCatalog, Integer -> Boolean
  eg-id (c) (id) = id > 0 & id <= list-length c.items
  eg-optional : EgCatalog, Integer -> Boolean
  eg-optional (c) (id) = id == 0 | eg-id c id
  eg-pair : EgCatalog, Integer, Integer -> Boolean
  eg-pair (c) (id) (quantity) = (id == 0 & quantity == 0) | (eg-id c id & quantity > 0 & quantity <= 1000)
  eg-items-valid : EgCatalog, Integer -> Boolean
  eg-items-valid (c) (i) = if i == list-length c.items then True
    else let item = list-at c.items i
    in text-length item.name > 0 & text-length item.name <= 64 & item.chain >= 1 & item.chain <= 7 & eg-items-valid c (i + 1)
  eg-resources-valid : EgCatalog, Integer -> Boolean
  eg-resources-valid (c) (i) = if i == list-length c.resources then True
    else let r = list-at c.resources i
    in eg-id c r.item & eg-optional c r.seed & eg-optional c r.tool
      & r.item /= r.seed & r.skill >= 0 & r.skill <= 10 & r.ground >= 0 & r.ground <= 2
      & ((r.seed == 0 & r.ground == 0) | (r.seed > 0 & r.ground > 0))
      & r.regrow > 0 & r.regrow <= 8760 & r.quantity > 0 & r.quantity <= 1000
      & eg-resources-valid c (i + 1)
  eg-recipes-valid : EgCatalog, Integer -> Boolean
  eg-recipes-valid (c) (i) = if i == list-length c.recipes then True
    else let r = list-at c.recipes i
    in eg-id c r.item & r.quantity > 0 & r.quantity <= 1000
      & eg-id c r.one & eg-pair c r.one r.one-count & eg-pair c r.two r.two-count & eg-pair c r.three r.three-count
      & (r.two == 0 | r.one /= r.two) & (r.three == 0 | (r.three /= r.one & r.three /= r.two))
      & eg-optional c r.tool & r.station >= 1 & r.station <= 12 & r.skill >= 0 & r.skill <= 10
      & eg-recipes-valid c (i + 1)

  eg-ready : Integer, Integer -> Boolean
  eg-ready (flags) (id) = id == 0 | peek-byte flags id == 1
  eg-clear : Integer, Integer -> Integer
  eg-clear (flags) (i) = if i == 129 then 0 else let a = poke-byte flags i 0 in eg-clear flags (i + 1)
  eg-gather-pass : EgCatalog, Integer, Integer -> Integer
  eg-gather-pass (c) (flags) (i) = if i == list-length c.resources then 0
    else let r = list-at c.resources i
    in let a = if eg-ready flags r.tool then
      let b = poke-byte flags r.item 1
      in if r.seed > 0 then poke-byte flags r.seed 1 else 0
      else 0
    in eg-gather-pass c flags (i + 1)
  eg-craft-pass : EgCatalog, Integer, Integer -> Integer
  eg-craft-pass (c) (flags) (i) = if i == list-length c.recipes then 0
    else let r = list-at c.recipes i
    in let a = if eg-ready flags r.one & eg-ready flags r.two & eg-ready flags r.three & eg-ready flags r.tool then poke-byte flags r.item 1 else 0
    in eg-craft-pass c flags (i + 1)
  eg-passes : EgCatalog, Integer, Integer -> Integer
  eg-passes (c) (flags) (i) = if i == list-length c.items then 0
    else let a = eg-gather-pass c flags 0
    in let b = eg-craft-pass c flags 0
    in eg-passes c flags (i + 1)
  eg-missing : EgCatalog, Integer, Integer -> Integer
  eg-missing (c) (flags) (id) = if id > list-length c.items then 0
    else if not (eg-ready flags id) then id else eg-missing c flags (id + 1)
  eg-validate : EgCatalog -> Integer
  eg-validate (c) =
    if list-length c.items < 1 | list-length c.items > 128 | list-length c.resources > 64 | list-length c.recipes > 128 then -1
    else if not (eg-items-valid c 0) | not (eg-resources-valid c 0) | not (eg-recipes-valid c 0) then -1
    else let mark = __heap-save
    in let flags = alloc-bytes 129
    in let a = eg-clear flags 0
    in let b = eg-passes c flags 0
    in let missing = eg-missing c flags 1
    in let restored = __heap-restore mark
    in missing
