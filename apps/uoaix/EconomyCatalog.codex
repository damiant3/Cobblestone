      eg-item "wheat" 5, eg-item "vegetables" 5, eg-item "logs" 6,
      eg-item "fruit" 5, eg-item "ginseng" 7, eg-item "garlic" 7,
      eg-item "mandrake" 7, eg-item "nightshade" 7, eg-item "blood moss" 7,
      eg-item "spiders silk" 7, eg-item "black pearls" 7, eg-item "sulfurous ash" 7,
      eg-item "stone pickaxe" 1, eg-item "stone axe" 6, eg-item "knife" 1,
      eg-item "trowel" 7, eg-item "fishing rod" 5, eg-item "bucket" 5,
      eg-item "iron ingots" 1, eg-item "gold ingots" 2, eg-item "flour" 5,
      eg-item "bread" 5, eg-item "leather" 3, eg-item "thread" 4,
      eg-item "cloth" 4, eg-item "boards" 6, eg-item "nails" 1,
