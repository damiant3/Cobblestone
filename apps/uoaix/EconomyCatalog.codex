      eg-recipe 26 1 1 2 2 1 0 0 1 0 0,
      eg-recipe 27 1 1 1 2 1 0 0 1 0 0,
      eg-recipe 28 1 1 1 2 1 0 0 1 0 0,
      eg-recipe 29 1 2 2 36 1 0 0 1 27 6,
      eg-recipe 30 1 3 2 2 1 0 0 10 0 8,
      eg-recipe 31 1 5 2 2 1 0 0 3 0 8,
      eg-recipe 32 1 6 2 2 1 0 0 3 0 8,
      eg-recipe 33 2 13 2 0 0 0 0 2 0 5,
      eg-recipe 34 4 33 2 4 1 2 1 6 0 9,
      eg-recipe 35 2 7 2 4 1 0 0 7 27 10,
