Chapter: EconomyCurrencyFields
  cites Uoaix chapter EconomyCurrency
  cites Uoaix chapter EconomyMoney

  euf-write-event : Integer, Integer, EuEvent -> Integer
  euf-write-event (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.sequence
    in let f1 = poke-qword buf (at + 8) p.hour
    in let f2 = poke-qword buf (at + 16) p.kind
    in let f3 = poke-qword buf (at + 24) p.actor
    in let f4 = poke-qword buf (at + 32) p.party
    in let f5 = poke-qword buf (at + 40) p.metal
    in let f6 = poke-qword buf (at + 48) p.copper
    in let f7 = poke-qword buf (at + 56) p.silver
    in let f8 = poke-qword buf (at + 64) p.gold
    in let f9 = poke-qword buf (at + 72) p.reference
    in let f10 = poke-qword buf (at + 80) p.copper-rate
    in let f11 = poke-qword buf (at + 88) p.silver-rate
    in let f12 = poke-qword buf (at + 96) p.copper-seq
    in let f13 = poke-qword buf (at + 104) p.silver-seq
    in let f14 = poke-qword buf (at + 112) p.gold-seq
    in 0
  euf-read-event : Integer, Integer, EuEvent -> Integer
  euf-read-event (buf) (at) (p) =
    let f0 = __record-set p "sequence" (peek-qword buf (at + 0))
    in let f1 = __record-set p "hour" (peek-qword buf (at + 8))
    in let f2 = __record-set p "kind" (peek-qword buf (at + 16))
    in let f3 = __record-set p "actor" (peek-qword buf (at + 24))
    in let f4 = __record-set p "party" (peek-qword buf (at + 32))
    in let f5 = __record-set p "metal" (peek-qword buf (at + 40))
    in let f6 = __record-set p "copper" (peek-qword buf (at + 48))
    in let f7 = __record-set p "silver" (peek-qword buf (at + 56))
    in let f8 = __record-set p "gold" (peek-qword buf (at + 64))
    in let f9 = __record-set p "reference" (peek-qword buf (at + 72))
    in let f10 = __record-set p "copper-rate" (peek-qword buf (at + 80))
    in let f11 = __record-set p "silver-rate" (peek-qword buf (at + 88))
    in let f12 = __record-set p "copper-seq" (peek-qword buf (at + 96))
    in let f13 = __record-set p "silver-seq" (peek-qword buf (at + 104))
    in let f14 = __record-set p "gold-seq" (peek-qword buf (at + 112))
    in 0
  euf-equal-event : EuEvent, EuEvent -> Boolean
  euf-equal-event (a) (b) =
    a.sequence == b.sequence
    & a.hour == b.hour
    & a.kind == b.kind
    & a.actor == b.actor
    & a.party == b.party
    & a.metal == b.metal
    & a.copper == b.copper
    & a.silver == b.silver
    & a.gold == b.gold
    & a.reference == b.reference
    & a.copper-rate == b.copper-rate
    & a.silver-rate == b.silver-rate
    & a.copper-seq == b.copper-seq
    & a.silver-seq == b.silver-seq
    & a.gold-seq == b.gold-seq

  euf-write-policy : Integer, Integer, EuCurrency -> Integer
  euf-write-policy (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.count
    in let f1 = poke-qword buf (at + 8) p.copper-rate
    in let f2 = poke-qword buf (at + 16) p.silver-rate
    in let f3 = poke-qword buf (at + 24) p.copper-owner
    in let f4 = poke-qword buf (at + 32) p.silver-owner
    in let f5 = poke-qword buf (at + 40) p.copper-yield
    in let f6 = poke-qword buf (at + 48) p.silver-yield
    in let f7 = poke-qword buf (at + 56) p.copper-ingots
    in let f8 = poke-qword buf (at + 64) p.silver-ingots
    in let f9 = poke-qword buf (at + 72) p.copper-seq
    in let f10 = poke-qword buf (at + 80) p.silver-seq
    in let f11 = poke-qword buf (at + 88) p.gold-seq
    in let f12 = poke-qword buf (at + 96) p.purse-count
    in 0
  euf-read-policy : Integer, Integer, EuCurrency -> Integer
  euf-read-policy (buf) (at) (p) =
    let f0 = __record-set p "count" (peek-qword buf (at + 0))
    in let f1 = __record-set p "copper-rate" (peek-qword buf (at + 8))
    in let f2 = __record-set p "silver-rate" (peek-qword buf (at + 16))
    in let f3 = __record-set p "copper-owner" (peek-qword buf (at + 24))
    in let f4 = __record-set p "silver-owner" (peek-qword buf (at + 32))
    in let f5 = __record-set p "copper-yield" (peek-qword buf (at + 40))
    in let f6 = __record-set p "silver-yield" (peek-qword buf (at + 48))
    in let f7 = __record-set p "copper-ingots" (peek-qword buf (at + 56))
    in let f8 = __record-set p "silver-ingots" (peek-qword buf (at + 64))
    in let f9 = __record-set p "copper-seq" (peek-qword buf (at + 72))
    in let f10 = __record-set p "silver-seq" (peek-qword buf (at + 80))
    in let f11 = __record-set p "gold-seq" (peek-qword buf (at + 88))
    in let f12 = __record-set p "purse-count" (peek-qword buf (at + 96))
    in 0
  euf-equal-policy : EuCurrency, EuCurrency -> Boolean
  euf-equal-policy (a) (b) =
    a.count == b.count
    & a.copper-rate == b.copper-rate
    & a.silver-rate == b.silver-rate
    & a.copper-owner == b.copper-owner
    & a.silver-owner == b.silver-owner
    & a.copper-yield == b.copper-yield
    & a.silver-yield == b.silver-yield
    & a.copper-ingots == b.copper-ingots
    & a.silver-ingots == b.silver-ingots
    & a.copper-seq == b.copper-seq
    & a.silver-seq == b.silver-seq
    & a.gold-seq == b.gold-seq
    & a.purse-count == b.purse-count

  euf-equal-purse : EmPurse, EmPurse -> Boolean
  euf-equal-purse (a) (b) =
    a.kind == b.kind
    & a.owner == b.owner
    & a.coin == b.coin

  euf-equal-loan : EmLoan, EmLoan -> Boolean
  euf-equal-loan (a) (b) =
    a.lender == b.lender
    & a.borrower == b.borrower
    & a.principal == b.principal
    & a.interest == b.interest
    & a.due == b.due
    & a.paid == b.paid
    & a.status == b.status

  euf-equal-entry : EmEntry, EmEntry -> Boolean
  euf-equal-entry (a) (b) =
    a.action == b.action
    & a.hour == b.hour
    & a.payer == b.payer
    & a.payee == b.payee
    & a.amount == b.amount
    & a.kind == b.kind
    & a.reference == b.reference

  euf-equal-money : EmMoney, EmMoney -> Boolean
  euf-equal-money (a) (b) =
    a.purse-count == b.purse-count
    & a.loan-count == b.loan-count
    & a.entry-count == b.entry-count
    & a.sequence == b.sequence
    & a.hour == b.hour
    & a.tax == b.tax
    & a.issued == b.issued
    & a.defaults == b.defaults


