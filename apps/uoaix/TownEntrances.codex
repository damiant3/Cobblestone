Chapter: TownEntrances
  cites Uoaix chapter TownLiveState

 UOAIX-285 (root's ruling, 2026-10-26; Damian may correct): nothing placed by the decorator or a deed may have a collider
 within te-reach tiles of a town entrance, or every walk that goes via that entrance is sealed (trial-48864A: a building
 over Britain's walled in 17 keepers). Britain's entrance is tl-door-x, tl-door-y; a city's is cw-door.
  te-reach : Integer = 3
  te-refusal : Text = "Nothing can be built within 3 tiles of a town entrance; the way into town stays open."
  cw-door : Integer -> BbSpot
  cw-door (i) = if i == 8 then BbSpot { x = 3739, y = 1316, z = 0 } else if i == 10 then BbSpot { x = 2964, y = 3405, z = 15 } else if i == 9 then BbSpot { x = 1375, y = 3817, z = 0 } else if i == 1 then BbSpot { x = 2018, y = 2810, z = 0 } else if i == 11 then BbSpot { x = 2717, y = 2090, z = 0 } else if i == 4 then BbSpot { x = 5311, y = 35, z = 0 } else if i == 3 then BbSpot { x = 607, y = 819, z = 0 } else if i == 2 then BbSpot { x = 4402, y = 1159, z = 0 } else if i == 5 then BbSpot { x = 615, y = 2234, z = 0 } else if i == 6 then BbSpot { x = 3667, y = 2623, z = 0 } else if i == 7 then BbSpot { x = 3695, y = 2250, z = 20 } else if i == 12 then BbSpot { x = 2771, y = 975, z = 0 } else if i == 13 then BbSpot { x = 2496, y = 379, z = 0 } else if i == 14 then BbSpot { x = 2231, y = 1214, z = 0 } else BbSpot { x = 0, y = 0, z = 0 }
  te-blocks : Integer, Integer, Integer, Integer -> Boolean
  te-blocks (x0) (y0) (x1) (y1) = if te-near-door tl-door-x tl-door-y x0 y0 x1 y1 then True else te-cities x0 y0 x1 y1 1
  te-cities : Integer, Integer, Integer, Integer, Integer -> Boolean
  te-cities (x0) (y0) (x1) (y1) (i) = if i > 14 then False
    else let d = cw-door i
    in if te-near-door d.x d.y x0 y0 x1 y1 then True else te-cities x0 y0 x1 y1 (i + 1)
  te-near-door : Integer, Integer, Integer, Integer, Integer, Integer -> Boolean
  te-near-door (dx) (dy) (x0) (y0) (x1) (y1) = dx >= x0 - te-reach & dx <= x1 + te-reach & dy >= y0 - te-reach & dy <= y1 + te-reach

