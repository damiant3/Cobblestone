Chapter: EconomyGatherer
  cites Uoaix chapter BritainProduction

  EgGatherer = record { producer : BbProducer, node : Integer, place : Integer, gathered : Integer }
  egg-new : EuCurrency, Integer, Integer -> Result EgGatherer Text
  egg-new (x) (owner) (place) = egg-new-for x owner place 5 25
  egg-new-for : EuCurrency, Integer, Integer, Integer, Integer -> Result EgGatherer Text
  egg-new-for (x) (owner) (place) (resource) (tool) =
    let purse = eu-open x 2 owner
    in let actor = if purse < 1 then -1 else ep-admit x.world purse place
    in if actor < 1 then Err "gatherer actor refused"
    else let p = bb-producer x actor
    in when (if tool == 0 then Ok 0 else bb-require p tool 1)
      is Err (e) -> Err e
      is Ok (_) -> let node = egg-node x.world resource place 0
        in if node < 1 then Err "gatherer node refused"
        else Ok (EgGatherer { producer = p, node = node, place = place, gathered = 0 })
 An ore gatherer opens its own vein; any other resource reuses a wild node at the place (the wheat field).
  egg-node : EpWorld, Integer, Integer, Integer -> Integer
  egg-node (w) (resource) (place) (i) = if resource == 5 | i == w.node-count then eh-source w resource place
    else let n = list-at w.nodes i
    in if n.resource == resource & n.place == place & n.owner == 0 then i + 1 else egg-node w resource place (i + 1)
  egg-hour : EgGatherer -> Integer
  egg-hour (g) = let result = eh-harvest g.producer.currency.world g.producer.actor g.node
    in if result > 0 then let counted = __record-set g "gathered" (g.gathered + result) in result else 0
