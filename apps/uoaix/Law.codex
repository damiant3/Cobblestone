Chapter: Law
  cites Uoaix chapter WorldRecords
  cites Foreword chapter Result

  LawCase = record { source : Integer, offender : Integer, kind : Integer, town : Integer,
    x : Integer, y : Integer, known : Boolean, status : Integer, guard : Integer, term : Integer, due : Integer }
  LawWitness = record { case-id : Integer, serial : Integer, npc : Boolean, willing : Boolean, reported : Boolean }
  LawGuard = record { serial : Integer, town : Integer, case-id : Integer, state : Integer }
  LawJail = record { x : Integer, y : Integer, enabled : Boolean }
  LawWorld = record { world : WorldTable, cases : List LawCase, witnesses : List LawWitness,
    guards : List LawGuard, jails : List LawJail, sentences : List Integer,
    count : Integer, witness-count : Integer, guard-count : Integer, hour : Integer }

  lw-cases : Integer, List LawCase -> List LawCase
  lw-cases (left) (xs) = if left == 0 then xs else lw-cases (left - 1) (list-push xs (LawCase {
    source = 0, offender = 0, kind = 0, town = 0, x = 0, y = 0, known = False,
    status = 0, guard = 0, term = 0, due = 0 }))
  lw-witnesses : Integer, List LawWitness -> List LawWitness
  lw-witnesses (left) (xs) = if left == 0 then xs else lw-witnesses (left - 1) (list-push xs (LawWitness {
    case-id = 0, serial = 0, npc = False, willing = False, reported = False }))
  lw-guards : Integer, List LawGuard -> List LawGuard
  lw-guards (left) (xs) = if left == 0 then xs else lw-guards (left - 1) (list-push xs (LawGuard {
    serial = 0, town = 0, case-id = 0, state = 0 }))
  lw-jails : Integer, List LawJail -> List LawJail
  lw-jails (left) (xs) = if left == 0 then xs else lw-jails (left - 1) (list-push xs (LawJail { x = 0, y = 0, enabled = False }))
  lw-new : WorldTable -> LawWorld
  lw-new (world) = LawWorld { world = world, cases = lw-cases 128 [], witnesses = lw-witnesses 256 [],
    guards = lw-guards 32 [], jails = lw-jails 16 [], sentences = [1,6,24],
    count = 0, witness-count = 0, guard-count = 0, hour = 0 }
  lw-case-block : Integer = 128
  lw-witness-block : Integer = 256
 Cases and witness rows grow a block at a time at the growth point (UoaixDynamicTables.md stage 6); rows past the first
 blocks save in the law tail.
  lw-guard-block : Integer = 32
  lw-due : LawWorld -> Boolean
  lw-due (w) = list-length w.cases - w.count < lw-case-block / 4 | list-length w.witnesses - w.witness-count < lw-witness-block / 4
    | list-length w.guards - w.guard-count < lw-guard-block / 4
  lw-grow : LawWorld -> Integer
  lw-grow (w) = let a = if list-length w.cases - w.count < lw-case-block / 4 then __record-set w "cases" (lw-cases lw-case-block w.cases) else w
    in let b = if list-length w.witnesses - w.witness-count < lw-witness-block / 4 then __record-set w "witnesses" (lw-witnesses lw-witness-block w.witnesses) else w
    in let c = if list-length w.guards - w.guard-count < lw-guard-block / 4 then __record-set w "guards" (lw-guards lw-guard-block w.guards) else w
    in list-length w.cases
  lw-live : LawWorld, Integer -> Boolean
  lw-live (w) (serial) = when world-get w.world serial
    is Err (e) -> False
    is Ok (p) -> p.kind == 1 & p.health > 0
  lw-distance : LawWorld, Integer, Integer -> Integer
  lw-distance (w) (a) (b) = when world-get w.world a
    is Err (e) -> 100000000
    is Ok (one) -> when world-get w.world b
      is Err (e) -> 100000000
      is Ok (two) -> if one.z /= two.z then 100000000
        else (one.x - two.x) * (one.x - two.x) + (one.y - two.y) * (one.y - two.y)
  lw-valid-case : LawWorld, Integer -> Boolean
  lw-valid-case (w) (id) = id >= 1 & id <= w.count
  lw-case : LawWorld, Integer -> LawCase
  lw-case (w) (id) = list-at w.cases (id - 1)
  lw-source : LawWorld, Integer, Integer -> Boolean
  lw-source (w) (source) (i) = if i == w.count then False
    else (list-at w.cases i).source == source | lw-source w source (i + 1)
  lw-deed : LawWorld, Boolean, Integer, Integer, Integer, Integer -> Integer
  lw-deed (w) (verified) (source) (offender) (kind) (town) =
    if not verified | source <= 0 | source > 1000000000000 | kind < 1 | kind > 3 | town < 1 | town > 16
      | w.count >= list-length w.cases | not (lw-live w offender) then -1
    else if lw-source w source 0 then -1
    else let obj = world-read-slot w.world (world-slot w.world offender)
    in let c = list-at w.cases w.count
    in let a = __record-set c "source" source
    in let b = __record-set c "offender" offender
    in let d = __record-set c "kind" kind
    in let e = __record-set c "town" town
    in let f = __record-set c "x" obj.x
    in let g = __record-set c "y" obj.y
    in let h = __record-set c "term" (list-at w.sentences (kind - 1))
    in let at = __record-set c "due" w.hour
    in let id = w.count + 1
    in let used = __record-set w "count" id in id
  lw-witness-id : LawWorld, Integer, Integer, Integer -> Integer
  lw-witness-id (w) (case-id) (serial) (i) = if i == w.witness-count then 0
    else let witness = list-at w.witnesses i
    in if witness.case-id == case-id & witness.serial == serial then i + 1 else lw-witness-id w case-id serial (i + 1)
  lw-observe : LawWorld, Boolean, Integer, Integer, Boolean, Boolean -> Integer
  lw-observe (w) (saw) (case-id) (serial) (npc) (willing) =
    if not saw | not (lw-valid-case w case-id) | not (lw-live w serial) | w.witness-count >= list-length w.witnesses then -1
    else let c = lw-case w case-id
    in if c.offender == serial | lw-witness-id w case-id serial 0 /= 0 then -1
    else let id = w.witness-count + 1
    in let witness = list-at w.witnesses w.witness-count
    in let a = __record-set witness "case-id" case-id
    in let b = __record-set witness "serial" serial
    in let d = __record-set witness "npc" npc
    in let e = __record-set witness "willing" willing
    in let used = __record-set w "witness-count" id in id
  lw-remembers : LawWorld, Integer, Integer, Integer -> Boolean
  lw-remembers (w) (npc) (offender) (i) = if i == w.witness-count then False
    else let witness = list-at w.witnesses i
    in (witness.npc & witness.serial == npc & (lw-case w witness.case-id).offender == offender)
      | lw-remembers w npc offender (i + 1)
  lw-report : LawWorld, Integer, Boolean -> Integer
  lw-report (w) (id) (verified-tell) = if not verified-tell | id < 1 | id > w.witness-count then -1
    else let witness = list-at w.witnesses (id - 1)
    in if not witness.willing | not (lw-live w witness.serial) then -1
    else let a = __record-set witness "reported" True
    in let b = __record-set (lw-case w witness.case-id) "known" True in 0
  lw-willing : LawWorld, Integer, Boolean, Boolean -> Integer
  lw-willing (w) (id) (willing) (verified-choice) = if not verified-choice | id < 1 | id > w.witness-count then -1
    else let a = __record-set (list-at w.witnesses (id - 1)) "willing" willing in 0
  lw-guard-id : LawWorld, Integer, Integer -> Integer
  lw-guard-id (w) (serial) (i) = if i == w.guard-count then 0
    else if (list-at w.guards i).serial == serial then i + 1 else lw-guard-id w serial (i + 1)
  lw-add-guard : LawWorld, Boolean, Integer, Integer -> Integer
  lw-add-guard (w) (verified) (serial) (town) =
    if not verified | not (lw-live w serial) | town < 1 | town > 16 | w.guard-count >= list-length w.guards then -1
    else if lw-guard-id w serial 0 /= 0 then -1
    else let g = list-at w.guards w.guard-count
    in let a = __record-set g "serial" serial
    in let b = __record-set g "town" town
    in let id = w.guard-count + 1
    in let c = __record-set w "guard-count" id in id
  lw-nearest : LawWorld, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  lw-nearest (w) (town) (target) (excluded) (limit) (i) (best) = if i == w.guard-count then best
    else let g = list-at w.guards i
    in let distance = lw-distance w g.serial target
    in let eligible = g.town == town & g.serial /= excluded & g.state == 0 & lw-live w g.serial & distance <= limit
    in let nearer = if best == 0 then True else distance < lw-distance w (list-at w.guards (best - 1)).serial target
    in lw-nearest w town target excluded limit (i + 1) (if eligible & nearer then i + 1 else best)
  lw-assign : LawWorld, Integer, Integer, Integer -> Integer
  lw-assign (w) (guard) (case-id) (state) = let g = list-at w.guards (guard - 1)
    in let a = __record-set g "case-id" case-id in let b = __record-set g "state" state in 0
  lw-call : LawWorld, Integer, Boolean -> Integer
  lw-call (w) (witness-id) (verified-call) = if not verified-call | witness-id < 1 | witness-id > w.witness-count then -1
    else let witness = list-at w.witnesses (witness-id - 1)
    in let c = lw-case w witness.case-id
    in if not witness.reported | not witness.willing | not (lw-live w witness.serial) | not (lw-live w c.offender) | c.status /= 0 | c.guard /= 0 then -1
    else let guard = lw-nearest w c.town witness.serial c.offender 144 0 0
    in if guard == 0 then 0 else let a = lw-assign w guard witness.case-id 1
    in let b = __record-set c "guard" guard in guard
  lw-offer : LawWorld, Integer -> Boolean
  lw-offer (w) (case-id) = if not (lw-valid-case w case-id) then False
    else let c = lw-case w case-id
    in if c.guard == 0 | not c.known | not (lw-live w c.offender) then False
    else let g = list-at w.guards (c.guard - 1)
    in g.case-id == case-id & lw-live w g.serial & lw-distance w g.serial c.offender <= 9
  lw-capture : LawWorld, Integer -> Integer
  lw-capture (w) (case-id) = if not (lw-offer w case-id) then -1
    else let c = lw-case w case-id
    in if c.status /= 0 then -1 else let a = __record-set c "status" 1
    in lw-assign w c.guard case-id 2
  lw-held : LawWorld, Integer, Integer -> Boolean
  lw-held (w) (serial) (i) = if i == w.count then False else let c = list-at w.cases i
    in (c.offender == serial & c.status == 4) | lw-held w serial (i + 1)
  lw-step : LawWorld, Integer, Integer, Integer, Boolean -> Integer
  lw-step (w) (serial) (x) (y) (path-admitted) = if not path-admitted | not (lw-live w serial) | lw-held w serial 0 then -1
    else let p = world-read-slot w.world (world-slot w.world serial)
    in if x < p.x - 1 | x > p.x + 1 | y < p.y - 1 | y > p.y + 1 | (x == p.x & y == p.y) then -1
    else when world-update w.world (WorldObject { serial = p.serial, kind = p.kind, x = x, y = y, z = p.z,
      graphic = p.graphic, hue = p.hue, container = p.container, amount = p.amount, health = p.health })
      is Err (e) -> -1
      is Ok (updated) -> 0
  lw-jail-set : LawWorld, Boolean, Integer, Integer, Integer -> Integer
  lw-jail-set (w) (keeper) (town) (x) (y) = if not keeper | town < 1 | town > 16 | x < 0 | x >= 6144 | y < 0 | y >= 4096 then -1
    else let jail = list-at w.jails (town - 1)
    in let a = __record-set jail "x" x in let b = __record-set jail "y" y
    in let c = __record-set jail "enabled" True in 0
  lw-sentence-set : LawWorld, Boolean, Integer, Integer -> Integer
  lw-sentence-set (w) (keeper) (kind) (hours) = if not keeper | kind < 1 | kind > 3 | hours < 1 | hours > 8760 then -1
    else let changed = list-set-at w.sentences (kind - 1) hours in 0
  lw-submit : LawWorld, Integer, Boolean -> Integer
  lw-submit (w) (case-id) (verified-choice) = if not verified-choice | not (lw-offer w case-id) then -1
    else let c = lw-case w case-id
    in if c.status /= 1 | not (list-at w.jails (c.town - 1)).enabled then -1
    else let a = __record-set c "status" 3 in lw-assign w c.guard case-id 4
  lw-arrive : LawWorld, Integer -> Integer
  lw-arrive (w) (case-id) = if not (lw-offer w case-id) then -1
    else let c = lw-case w case-id
    in let jail = list-at w.jails (c.town - 1)
    in let p = world-read-slot w.world (world-slot w.world c.offender)
    in if c.status /= 3 | not jail.enabled | p.x /= jail.x | p.y /= jail.y | w.hour > 1000000000000 - c.term then -1
    else let a = __record-set c "due" (w.hour + c.term)
    in let b = __record-set c "status" 4 in lw-assign w c.guard 0 0
  lw-assist : LawWorld, Integer, Integer -> Integer
  lw-assist (w) (case-id) (left) = if left == 0 then 0 else let c = lw-case w case-id
    in let guard = lw-nearest w c.town c.offender c.offender 99999999 0 0
    in if guard == 0 then 0 else let assigned = lw-assign w guard case-id 3 in 1 + lw-assist w case-id (left - 1)
  lw-fight : LawWorld, Integer, Boolean -> Integer
  lw-fight (w) (case-id) (verified-choice) = if not verified-choice | not (lw-offer w case-id) then -1
    else let c = lw-case w case-id
    in if c.status /= 1 then -1 else let a = __record-set c "status" 2
    in let b = lw-assign w c.guard case-id 3 in lw-assist w case-id 3
  lw-clear-guards : LawWorld, Integer, Integer -> Integer
  lw-clear-guards (w) (case-id) (i) = if i == w.guard-count then 0 else let g = list-at w.guards i
    in let a = if g.case-id == case-id then lw-assign w (i + 1) 0 0 else 0
    in lw-clear-guards w case-id (i + 1)
  lw-won-fight : LawWorld, Integer, Boolean -> Integer
  lw-won-fight (w) (case-id) (verified-result) = if not verified-result | not (lw-valid-case w case-id) then -1
    else let c = lw-case w case-id
    in if c.status /= 2 then -1 else let a = lw-clear-guards w case-id 0
    in let b = __record-set c "guard" 0 in let d = __record-set c "status" 0 in 0
  lw-release : LawWorld, Integer -> Integer
  lw-release (w) (case-id) = if not (lw-valid-case w case-id) then -1 else let c = lw-case w case-id
    in if c.status /= 4 | w.hour < c.due then -1 else let a = __record-set c "status" 5 in 0
 A GM's jail order is case kind 4: jailed at once at the town's cell for the given hours, with no deed, witness or guard.
  lw-confine : LawWorld, Boolean, Integer, Integer, Integer -> Integer
  lw-confine (w) (verified) (offender) (town) (hours) =
    if not verified | town < 1 | town > 16 | hours < 1 | hours > 8760 | w.count >= list-length w.cases | w.hour > 1000000000000 - hours
      | not (lw-live w offender) | lw-held w offender 0 | not (list-at w.jails (town - 1)).enabled then -1
    else let jail = list-at w.jails (town - 1)
    in let c = list-at w.cases w.count
    in let a = __record-set c "source" (lw-next-source w 0 0)
    in let b = __record-set c "offender" offender
    in let d = __record-set c "kind" 4
    in let e = __record-set c "town" town
    in let f = __record-set c "x" jail.x
    in let g = __record-set c "y" jail.y
    in let h = __record-set c "known" False
    in let j = __record-set c "status" 4
    in let k = __record-set c "guard" 0
    in let m = __record-set c "term" hours
    in let p = __record-set c "due" (w.hour + hours)
    in let id = w.count + 1
    in let used = __record-set w "count" id in id
  lw-free : LawWorld, Integer, Integer -> Integer
  lw-free (w) (offender) (i) = if i >= w.count then 0
    else let c = list-at w.cases i
    in if c.offender /= offender | c.status /= 4 then lw-free w offender (i + 1)
    else let a = __record-set c "status" 5 in let b = __record-set c "due" w.hour in 1 + lw-free w offender (i + 1)
 A served case, and a deed nobody reported, retire lw-retire-hours game hours after their due hour with their witness
 rows; 40 game hours is classic UO's long-term murder count decay. Retirement compacts the tables in place and renumbers
 every surviving case id in the witness and guard rows, so 128 cases and 256 witness rows never fill for life.
  lw-retire-hours : Integer = 40
  lw-gone : LawWorld, Integer -> Boolean
  lw-gone (w) (id) = let c = lw-case w id
    in w.hour >= c.due + lw-retire-hours & (c.status == 5 | (c.status == 0 & not c.known & c.guard == 0))
  lw-gone-before : LawWorld, Integer, Integer -> Integer
  lw-gone-before (w) (id) (k) = if k >= id then 0 else (if lw-gone w k then 1 else 0) + lw-gone-before w id (k + 1)
  lw-next-source : LawWorld, Integer, Integer -> Integer
  lw-next-source (w) (i) (most) = if i == w.count then most + 1 else lw-next-source w (i + 1) (max most (list-at w.cases i).source)
  lw-swap : List a, Integer, Integer -> Integer
  lw-swap (xs) (i) (j) = let a = list-at xs i in let b = list-at xs j in let c = list-set-at xs i b in let d = list-set-at xs j a in 0
  lw-keep-witnesses : LawWorld, Integer, Integer -> Integer
  lw-keep-witnesses (w) (i) (kept) = if i == w.witness-count then kept
    else let r = list-at w.witnesses i
    in if lw-gone w r.case-id then lw-keep-witnesses w (i + 1) kept
    else let renumbered = __record-set r "case-id" (r.case-id - lw-gone-before w r.case-id 1)
    in let moved = if i == kept then 0 else lw-swap w.witnesses i kept
    in lw-keep-witnesses w (i + 1) (kept + 1)
  lw-renumber-guards : LawWorld, Integer -> Integer
  lw-renumber-guards (w) (i) = if i == w.guard-count then 0
    else let g = list-at w.guards i
    in let a = if g.case-id > 0 then __record-set g "case-id" (g.case-id - lw-gone-before w g.case-id 1) else g
    in lw-renumber-guards w (i + 1)
  lw-keep-cases : LawWorld, Integer, Integer -> Integer
  lw-keep-cases (w) (i) (kept) = if i == w.count then kept
    else if lw-gone w (i + 1) then lw-keep-cases w (i + 1) kept
    else let moved = if i == kept then 0 else lw-swap w.cases i kept
    in lw-keep-cases w (i + 1) (kept + 1)
  lw-zero-witnesses : LawWorld, Integer, Integer -> Integer
  lw-zero-witnesses (w) (i) (n) = if i >= n then 0
    else let r = list-at w.witnesses i
    in let a = __record-set r "case-id" 0 in let b = __record-set r "serial" 0 in let c = __record-set r "npc" False
    in let d = __record-set r "willing" False in let e = __record-set r "reported" False in lw-zero-witnesses w (i + 1) n
  lw-zero-cases : LawWorld, Integer, Integer -> Integer
  lw-zero-cases (w) (i) (n) = if i >= n then 0
    else let c = list-at w.cases i
    in let a = __record-set c "source" 0 in let b = __record-set c "offender" 0 in let d = __record-set c "kind" 0
    in let e = __record-set c "town" 0 in let f = __record-set c "x" 0 in let g = __record-set c "y" 0
    in let h = __record-set c "known" False in let j = __record-set c "status" 0 in let k = __record-set c "guard" 0
    in let m = __record-set c "term" 0 in let p = __record-set c "due" 0 in lw-zero-cases w (i + 1) n
  lw-retire : LawWorld -> Integer
  lw-retire (w) = let gone = lw-gone-before w (w.count + 1) 1
    in if gone == 0 then 0
    else let witnesses = lw-keep-witnesses w 0 0
    in let guards = lw-renumber-guards w 0
    in let cases = lw-keep-cases w 0 0
    in let a = lw-zero-witnesses w witnesses w.witness-count
    in let b = lw-zero-cases w cases w.count
    in let c = __record-set w "witness-count" witnesses
    in let d = __record-set w "count" cases in gone
  lw-hour : LawWorld, Integer -> Integer
  lw-hour (w) (hour) = if hour < w.hour | hour > 1000000000000 then -1 else let a = __record-set w "hour" hour in 0
