Chapter: EconomyMint
  cites Uoaix chapter EconomyProduction
  cites Uoaix chapter EconomyMoney

 The Crown keeps 10% of the coin struck from an owner's ingots, in basis points (Damian 2026-10-06: "another 10% to coin it").
  emi-fee : Integer = 1000
  emi-paid : Integer, Boolean -> Integer
  emi-paid (coin) (operator) = if operator then 0 else coin - coin * emi-fee / 10000

  emi-configure : EpWorld, Boolean, Integer, Integer -> Integer
  emi-configure (w) (authorized) (owner) (rate) =
    if not authorized | not (ep-valid-actor w owner) | rate < 0 | rate > 1000000000 | not (em-room w.money 1) then -1
    else if (em-purse w.money (ep-actor w owner).purse).kind /= 5 then -1
    else let a = em-begin w.money
    in let b = em-row w.money 0 (ep-actor w owner).purse 0 11 rate
    in let c = __record-set w "mint-owner" owner
    in let d = __record-set w "mint-rate" rate
    in 0

  emi-strike : EpWorld, Boolean, Integer, Integer, Integer -> Integer
  emi-strike (w) (authorized) (actor) (station) (ingots) = emi-strike-from w authorized actor station ingots 0
  emi-strike-from : EpWorld, Boolean, Integer, Integer, Integer, Integer -> Integer
  emi-strike-from (w) (authorized) (actor) (station) (ingots) (serial) =
    if not authorized | not (ep-valid-actor w actor) | w.mint-owner <= 0 | w.mint-rate == 0 | ingots <= 0 | ingots > 1000 | station <= 0 | station > w.station-count then -1
    else let p = ep-actor w actor
    in let s = list-at w.stations (station - 1)
    in let coin = ingots * w.mint-rate
    in let operator = actor == w.mint-owner
    in let paid = emi-paid coin operator
    in if s.kind /= 12 | s.owner /= w.mint-owner | s.place /= p.place | s.enabled == 0 | not (ep-has p 32 ingots) | (operator & not (ep-tool p 62)) | w.mint-ingots > ep-limit - ingots then -1
    else if not (em-room w.money (if paid > 0 then 3 else 2)) | w.money.issued > em-limit - coin | (em-purse w.money 1).coin > em-limit - coin
      | (paid > 0 & (em-purse w.money p.purse).coin > em-limit - paid) then -1
    else let issued = em-issue w.money True coin 2
    in if issued /= 0 then -1
    else let a = ep-consume-serial w actor 32 ingots serial
    in let b = if operator then ep-wear w actor 62 else 0
    in let c = __record-set w "mint-ingots" (w.mint-ingots + ingots)
    in let d = em-row w.money p.purse 1 0 12 ingots
    in if paid > 0 then em-payout w.money p.purse paid else 0
