Chapter: TownNetworkActions
  cites Uoaix chapter TownNetwork
  cites Uoaix chapter EconomyActions

  tna-drain : EaWorld, Integer, TnState, List EaProposal -> Integer
  tna-drain (e) (actor) (s) (resolved) =
    let action = tn-pop s
    in if action == 0 then 0
    else let result = ea-submit e actor action (list-at resolved (action - 1))
    in if result == -14 then -14 else tna-drain e actor s resolved
  tna-valid-queue : TnState, Integer -> Boolean
  tna-valid-queue (s) (i) = if i == s.count then True
    else let action = list-at s.queue i
    in action >= 0 & action < 10 & tna-valid-queue s (i + 1)
  tna-run : EaWorld, Integer, TnState, List EaProposal -> Integer
  tna-run (e) (actor) (s) (resolved) =
    if list-length resolved /= 10 | list-length s.queue /= 10
      | s.head < 0 | s.count < s.head | s.count > 10
      | not (tna-valid-queue s s.head) then -16
    else if not (ea-room e (s.count - s.head)) then -14
    else tna-drain e actor s resolved
