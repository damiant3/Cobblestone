Chapter: TownNetworkHillSeed
  cites Uoaix chapter TownNetwork
  cites Foreword chapter Result

  tnh-seed-next : Integer -> Integer
  tnh-seed-next (state) = bit-and (state * 1664525 + 1013904223) #FFFFFFFF
  tnh-seed-fill : List Integer, Integer, Integer -> Integer
  tnh-seed-fill (weights) (i) (state) = if i == 766 then state
    else let next = tnh-seed-next state
    in let value = if i >= 512 & i < 528 then 100
      else if i >= 752 then (if i == 762 then 500 else 0)
      else int-mod (next / 65536) 201 - 100
    in let a = list-set-at weights i value
    in tnh-seed-fill weights (i + 1) next
  tnh-seed-slice : List Integer, List Integer, Integer, Integer -> Integer
  tnh-seed-slice (source) (target) (base) (i) = if i == list-length target then 0
    else let a = list-set-at target i (list-at source (base + i))
    in tnh-seed-slice source target base (i + 1)
  tnh-seed-model : Integer -> Result TnModel Text
  tnh-seed-model (seed) =
    let weights = tn-zeros 766
    in let generated = tnh-seed-fill weights 0 seed
    in let hw = tn-zeros 512
    in let hb = tn-zeros 16
    in let ow = tn-zeros 224
    in let ob = tn-zeros 14
    in let a = tnh-seed-slice weights hw 0 0
    in let b = tnh-seed-slice weights hb 512 0
    in let c = tnh-seed-slice weights ow 528 0
    in let d = tnh-seed-slice weights ob 752 0
    in tn-model hw hb ow ob
