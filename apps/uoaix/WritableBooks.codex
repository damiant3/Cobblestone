Chapter: WritableBooks
  cites Uoaix chapter WorldSnapshot
  cites Uoaix chapter GamePackets

 ServUO Scripts/Items/Books/BaseBook.cs and BlankBook.cs, GPL-2.0; ports/ServUO-LICENSE.txt. A blank book (0x0FF2)
 holds a title, an author and 20 pages of 8 lines. The 1.25.32 client's opcode table gives BookHeader 0x93 98 bytes:
 serial, the writable flag, the page count (16 bits), a 60-byte title and a 30-byte author, which is the later 99-byte
 form without its second flag. BookPage 0x66 is dynamic: length, serial, a page count, then per page its number, its
 line count and that many zero-terminated lines; the server sends every page when a book opens and the client sends
 the pages a writer changed. A line keeps at most 39 printable ASCII bytes and is cut at the first other byte.
  WbkState = record { rows : Integer, room : Integer, count : Integer }
  wbk-graphic : Integer = #0FF2
  wbk-pages : Integer = 20
  wbk-lines : Integer = 8
  wbk-line-bytes : Integer = 40
  wbk-row-bytes : Integer = 104 + 20 * 8 * 40
  wbk-block : Integer = 16
  wbk-ceiling : Integer = 65536
  wbk-new : Integer -> WbkState
  wbk-new (unused) = WbkState { rows = alloc-bytes (wbk-block * wbk-row-bytes), room = wbk-block, count = 0 }
  wbk-row : WbkState, Integer -> Integer
  wbk-row (s) (i) = s.rows + i * wbk-row-bytes
  wbk-find : WbkState, Integer, Integer -> Integer
  wbk-find (s) (serial) (i) = if i >= s.count then -1 else if peek-qword (wbk-row s i) 0 == serial then i else wbk-find s serial (i + 1)
  wbk-due : WbkState -> Boolean
  wbk-due (s) = s.room - s.count < s.room / 4 & s.room < wbk-ceiling
  wbk-grow-to : WbkState, Integer -> Integer
  wbk-grow-to (s) (room) = if room <= s.room then 0
    else let fresh = alloc-bytes (room * wbk-row-bytes)
    in let copied = ws-copy s.rows fresh (s.count * wbk-row-bytes) 0
    in let a = __record-set s "rows" fresh
    in let b = __record-set s "room" room in 0
  wbk-grow : WbkState -> Integer
  wbk-grow (s) = wbk-grow-to s (min wbk-ceiling (s.room * 2))
  wbk-zero : Integer, Integer, Integer -> Integer
  wbk-zero (at) (i) (n) = if i >= n then 0 else let z = poke-byte at i 0 in wbk-zero at (i + 1) n
 The row of a book, made empty when it has none, or -1 when the table is full until the next growth point.
  wbk-ensure : WbkState, Integer -> Integer
  wbk-ensure (s) (serial) = let i = wbk-find s serial 0
    in if i >= 0 then i else if s.count >= s.room then -1
    else let n = s.count
    in let at = wbk-row s n
    in let cleared = wbk-zero at 0 wbk-row-bytes
    in let a = poke-qword at 0 serial
    in let b = __record-set s "count" (n + 1) in n
  wbk-drop-row : WbkState, Integer -> Integer
  wbk-drop-row (s) (i) = if i < 0 | i >= s.count then -1
    else let last = s.count - 1
    in let moved = if i == last then 0 else ws-copy (wbk-row s last) (wbk-row s i) wbk-row-bytes 0
    in let a = __record-set s "count" last in 0
  wbk-take : Integer, List Integer, Integer, Integer, Integer -> Integer
  wbk-take (at) (packet) (from) (limit) (i) = if i >= limit then 0
    else let c = if from + i < list-length packet then list-at packet (from + i) else 0
    in if c < 32 | c > 126 then wbk-zero at i limit
    else let put = poke-byte at i c in wbk-take at packet from limit (i + 1)
  wbk-put-from : List Integer, Integer, Integer, Integer -> List Integer
  wbk-put-from (out) (at) (i) (n) = if i >= n then out else wbk-put-from (list-push out (peek-byte at i)) at (i + 1) n
  wbk-pad : List Integer, Integer -> List Integer
  wbk-pad (p) (n) = if list-length p >= n then p else wbk-pad (list-push p 0) n
  wbk-header : WbkState, Integer, Boolean -> List Integer
  wbk-header (s) (serial) (writable) = let i = wbk-find s serial 0
    in let flag = if writable then 1 else 0
    in let head = gp-put16 (gp-put32 [#93] serial & [flag]) wbk-pages
    in if i < 0 then wbk-pad head 98
    else let titled = wbk-put-from head (wbk-row s i + 8) 0 60
    in wbk-put-from titled (wbk-row s i + 72) 0 30
  wbk-line-out : List Integer, Integer, Integer -> List Integer
  wbk-line-out (out) (at) (i) = if i >= wbk-line-bytes | peek-byte at i == 0 then list-push out 0
    else wbk-line-out (list-push out (peek-byte at i)) at (i + 1)
  wbk-lines-out : Integer, Integer, List Integer -> List Integer
  wbk-lines-out (base) (line) (out) = if line >= wbk-lines then out
    else wbk-lines-out base (line + 1) (wbk-line-out out (base + line * wbk-line-bytes) 0)
  wbk-page-base : WbkState, Integer, Integer -> Integer
  wbk-page-base (s) (i) (page) = wbk-row s i + 104 + (page - 1) * wbk-lines * wbk-line-bytes
  wbk-pages-out : WbkState, Integer, Integer, List Integer -> List Integer
  wbk-pages-out (s) (i) (page) (out) = if page > wbk-pages then out
    else let head = gp-put16 (gp-put16 out page) wbk-lines
    in wbk-pages-out s i (page + 1) (wbk-lines-out (wbk-page-base s i page) 0 head)
  wbk-page-packet : WbkState, Integer -> List Integer
  wbk-page-packet (s) (serial) = let i = wbk-find s serial 0
    in if i < 0 then []
    else let body = wbk-pages-out s i 1 (gp-put16 (gp-put32 [#66, 0, 0] serial) wbk-pages)
    in let a = list-set-at body 1 (list-length body / 256)
    in let b = list-set-at body 2 (int-mod (list-length body) 256) in body
  wbk-nul : List Integer, Integer -> Integer
  wbk-nul (packet) (at) = if at >= list-length packet then -1 else if list-at packet at == 0 then at else wbk-nul packet (at + 1)
  wbk-clear-lines : Integer, Integer -> Integer
  wbk-clear-lines (base) (line) = if line >= wbk-lines then 0
    else let z = wbk-zero (base + line * wbk-line-bytes) 0 wbk-line-bytes in wbk-clear-lines base (line + 1)
  wbk-read-lines : Integer, List Integer, Integer, Integer, Integer -> Integer
  wbk-read-lines (base) (packet) (at) (line) (lines) = if line >= lines then (let cleared = wbk-clear-lines base line in at)
    else let stop = wbk-nul packet at
    in if stop < 0 then -1
    else let stored = if line < wbk-lines then wbk-take (base + line * wbk-line-bytes) packet at (wbk-line-bytes - 1) 0 else 0
    in wbk-read-lines base packet (stop + 1) (line + 1) lines
  wbk-write-page : WbkState, Integer, List Integer, Integer, Integer -> Integer
  wbk-write-page (s) (i) (packet) (at) (left) = if left <= 0 then 0
    else if at + 4 > list-length packet then -1
    else let page = gp-u16 packet at
    in let lines = gp-u16 packet (at + 2)
    in if page < 1 | page > wbk-pages | lines > 64 then -1
    else let next = wbk-read-lines (wbk-page-base s i page) packet (at + 4) 0 lines
    in if next < 0 then -1 else wbk-write-page s i packet next (left - 1)
 A client 0x66 into row i: 0 when every page it carries is stored, -1 when one is malformed (the pages before it stay).
  wbk-write-pages : WbkState, Integer, List Integer -> Integer
  wbk-write-pages (s) (i) (packet) = if list-length packet < 9 then -1 else wbk-write-page s i packet 9 (gp-u16 packet 7)
 Rows whose book no longer stands are dropped before a save, so a serial the world reuses starts blank.
  wbk-prune : WbkState, (Integer -> Boolean), Integer -> Integer
  wbk-prune (s) (stands) (i) = if i >= s.count then 0
    else if stands (peek-qword (wbk-row s i) 0) then wbk-prune s stands (i + 1)
    else let dropped = wbk-drop-row s i in wbk-prune s stands i

  wbk-tail-size : WbkState -> Integer
  wbk-tail-size (s) = 8 + s.count * wbk-row-bytes
  wbk-write-tail : WbkState, Integer -> Integer
  wbk-write-tail (s) (at) = let a = poke-qword at 0 s.count
    in let b = ws-copy s.rows (at + 8) (s.count * wbk-row-bytes) 0 in at + wbk-tail-size s
  wbk-tail-length : Integer, Integer -> Integer
  wbk-tail-length (at) (room) = if room < 8 | peek-qword at 0 < 0 | peek-qword at 0 > (room - 8) / wbk-row-bytes | peek-qword at 0 > wbk-ceiling then -1
    else 8 + peek-qword at 0 * wbk-row-bytes
  wbk-read-tail : WbkState, Integer, Integer -> Integer
  wbk-read-tail (s) (at) (size) = if size == 0 then 0
    else if wbk-tail-length at size /= size then -1
    else let n = peek-qword at 0
    in let grown = wbk-grow-to s (max s.room (n + n / 2 + wbk-block))
    in let a = ws-copy (at + 8) s.rows (n * wbk-row-bytes) 0
    in let b = __record-set s "count" n in 0

