  es-write-purse : Integer, Integer, EmPurse -> Integer
  es-write-purse (buf) (at) (p) =
    let f0 = poke-qword buf (at + 0) p.kind
    in let f1 = poke-qword buf (at + 8) p.owner
    in let f2 = poke-qword buf (at + 16) p.coin
    in 0

  es-read-purse : Integer, Integer, EmPurse -> Integer
  es-read-purse (buf) (at) (p) =
    let f0 = __record-set p "kind" (peek-qword buf (at + 0))
    in let f1 = __record-set p "owner" (peek-qword buf (at + 8))
    in let f2 = __record-set p "coin" (peek-qword buf (at + 16))
    in 0

