  es-copy-cells : Integer, Integer, Integer, Integer -> Integer
  es-copy-cells (source) (target) (count) (i) = if i == count then 0
    else let a = poke-qword target (i * 8) (peek-qword source (i * 8))
    in es-copy-cells source target count (i + 1)

  es-write-actor-buffers : Integer, Integer, EpActor -> Integer
  es-write-actor-buffers (buf) (at) (p) =
    let a = es-copy-cells p.stock (buf + at) 129 0
    in let b = es-copy-cells p.quality (buf + at + 1032) 129 0
    in let c = es-copy-cells p.cost (buf + at + 2064) 129 0
    in let d = es-copy-cells p.wear (buf + at + 3096) 129 0
    in es-copy-cells p.skills (buf + at + 4128) 11 0
  es-read-actor-buffers : Integer, Integer, EpActor -> Integer
  es-read-actor-buffers (buf) (at) (p) =
    let a = es-copy-cells (buf + at) p.stock 129 0
    in let b = es-copy-cells (buf + at + 1032) p.quality 129 0
    in let c = es-copy-cells (buf + at + 2064) p.cost 129 0
    in let d = es-copy-cells (buf + at + 3096) p.wear 129 0
    in es-copy-cells (buf + at + 4128) p.skills 11 0

