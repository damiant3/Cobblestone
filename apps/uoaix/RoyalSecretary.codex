Chapter: RoyalSecretary
  cites Uoaix chapter CompositeMinter
  cites Uoaix chapter WorldDecoration
  cites Foreword chapter StringUtils
  cites Foreword chapter TextSearch

 UOAIX-274 (Damian, 2026-10-20: "i want an npc secretary of the Lord, with a book and the pen and they let people in who
 have appointments. the door should be locked to anyone but brit, a royal guard, the secretary, or someone with an
 appointment."). The secretary sits at the wooden chair of the office north of the ante-room inside Castle British's gate
 (ServUO britain.cfg: the chair at 1368,1615,50, pen and ink 0x0FC0 at 1368,1616,54 on the table), a saved world mobile
 told apart by skin 1007, with a book (0x0FBE) beside the pen. The keep's front doors are the metal double door west of
 the ante-room (1.25 statics, 1359,1624 and 1359,1625, z 50). A player
 saying "appointment" within rsc-reach of the secretary is booked for the rest of the game day when a canned reason holds
 (CompositeGameRules cg-audience-asked); Lord British saying "appoint <name>" there books that character. From outside,
 the front doors open only to British and to a character holding today's appointment; from inside they open to anyone,
 and NPCs open them as before.
  rsc-x : Integer = 1368
  rsc-y : Integer = 1615
  rsc-z : Integer = 50
  rsc-book-art : Integer = #0FBE
  rsc-book-x : Integer = 1367
  rsc-book-y : Integer = 1616
  rsc-book-z : Integer = 54
  rsc-hue : Integer = 1007
  rsc-reach : Integer = 8
  rsc-door-x : Integer = 1359
  rsc-door-y : Integer = 1624
  rsc-door-z : Integer = 50
 A day's book holds rsc-rows appointments: a content cap, refused aloud when full.
  rsc-rows : Integer = 64
  rsc-bytes : Integer = 8 + rsc-rows * 16
  rsc-find : WorldTable, Integer -> Integer
  rsc-find (world) (serial) = if serial == 0 then 0
    else if (when world-get world serial is Err (_) -> False is Ok (o) -> o.kind == 1 & o.hue == rsc-hue & o.container == 0) then serial
    else rsc-find world (world-tile-next world serial)
  rsc-serial : WorldTable -> Integer
  rsc-serial (world) = rsc-find world (world-tile-first world rsc-x rsc-y)
  rsc-install : GsiState -> Integer
  rsc-install (items) = let book = rsc-install-book items
    in if rsc-serial items.world /= 0 | world-room items.world <= 0 then book
    else when world-create items.world (gs-mobile 0 rsc-x rsc-y rsc-z 400 rsc-hue)
      is Err (_) -> book
      is Ok (serial) -> let touched = world-touch items.world in book + 1
  rsc-book : WorldTable, Integer -> Integer
  rsc-book (world) (serial) = if serial == 0 then 0
    else if (when world-get world serial is Err (_) -> False is Ok (o) -> o.kind == 2 & o.graphic == rsc-book-art & o.container == 0) then serial
    else rsc-book world (world-tile-next world serial)
  rsc-install-book : GsiState -> Integer
  rsc-install-book (items) = if rsc-book items.world (world-tile-first items.world rsc-book-x rsc-book-y) /= 0 | world-room items.world <= 0 then 0
    else when world-create items.world (WorldObject { serial = 0, kind = 2, x = rsc-book-x, y = rsc-book-y, z = rsc-book-z, graphic = rsc-book-art, hue = 0, container = 0, amount = 1, health = 0 })
      is Err (_) -> 0
      is Ok (book) -> if gsi-register items book 0 0 False False /= 0 then 0 else let touched = world-touch items.world in 1
  rsc-near : WorldTable, Integer -> Boolean
  rsc-near (world) (speaker) = if rsc-serial world == 0 then False
    else when world-get world speaker
      is Err (_) -> False
      is Ok (m) -> walk-abs (m.x - rsc-x) <= rsc-reach & walk-abs (m.y - rsc-y) <= rsc-reach
  rsc-label : WorldTable, List Integer -> Maybe GameReply
  rsc-label (world) (packet) = if list-length packet /= 5 | list-at packet 0 /= 9 then None
    else let keeper = rsc-serial world
    in if keeper == 0 | bit-and (gp-u32 packet 1) #7FFFFFFF /= keeper then None
    else Just (gs-reply [sip-message keeper 0 6 "the Lord's secretary"] "secretary:name")
  rsc-say : WorldTable, Text, Text -> GameReply
  rsc-say (world) (text) (note) = let keeper = rsc-serial world in gs-reply [sip-message keeper 400 0 text] note
  rsc-booked : Integer, Integer, Integer, Integer -> Boolean
  rsc-booked (book) (serial) (day) (i) = if i >= peek-qword book 0 then False
    else if peek-qword book (8 + i * 16) == serial & peek-qword book (16 + i * 16) == day then True
    else rsc-booked book serial day (i + 1)
 A row for the same character or from an earlier day is written over; -1 when the day's book is full.
  rsc-free : Integer, Integer, Integer, Integer -> Integer
  rsc-free (book) (serial) (day) (i) = if i >= peek-qword book 0 then (if i < rsc-rows then i else 0 - 1)
    else if peek-qword book (8 + i * 16) == serial | peek-qword book (16 + i * 16) /= day then i
    else rsc-free book serial day (i + 1)
  rsc-appoint : Integer, Integer, Integer -> Integer
  rsc-appoint (book) (serial) (day) = let row = rsc-free book serial day 0
    in if row < 0 then 0 - 1
    else let a = poke-qword book (8 + row * 16) serial
    in let b = poke-qword book (16 + row * 16) day
    in let c = if row == peek-qword book 0 then poke-qword book 0 (row + 1) else 0 in row
  rsc-lower : Integer -> Integer
  rsc-lower (b) = if b >= 65 & b <= 90 then b + 32 else b
  rsc-name-is : Integer, Integer, List Integer, Integer -> Boolean
  rsc-name-is (characters) (slot) (name) (i) = if i >= 30 then i == list-length name
    else let b = peek-byte characters (slot * 160 + 18 + i)
    in if b == 0 then i == list-length name
    else i < list-length name & rsc-lower b == list-at name i & rsc-name-is characters slot name (i + 1)
  rsc-in-slots : Integer, List Integer, Integer -> Integer
  rsc-in-slots (characters) (name) (s) = if s == 5 then 0
    else if peek-qword characters (s * 160) /= 0 & rsc-name-is characters s name 0 then peek-qword characters (s * 160)
    else rsc-in-slots characters name (s + 1)
  rsc-in-accounts : Integer, List Integer, Integer -> Integer
  rsc-in-accounts (table) (name) (i) = if table == 0 | i >= ga-count table then 0
    else let found = rsc-in-slots (ga-slots table i) name 0
    in if found /= 0 then found else rsc-in-accounts table name (i + 1)
 The character a name calls, online or logged out: the bound account's slots, then every account's record (UOAIX-31).
  rsc-character : GameShard, List Integer -> Integer
  rsc-character (shard) (name) = if list-length name == 0 then 0
    else let bound = rsc-in-slots shard.characters name 0
    in if bound /= 0 then bound else rsc-in-accounts shard.accounts name 0
  rsc-lowered : List Integer, Integer, List Integer -> List Integer
  rsc-lowered (bytes) (i) (out) = if i >= list-length bytes then out else rsc-lowered bytes (i + 1) (list-push out (rsc-lower (list-at bytes i)))
 British's "appoint <name>" near the secretary; None for any other speech.
  rsc-heard : Integer, GameShard, GameInput, List Integer, Integer -> Maybe GameReply
  rsc-heard (book) (shard) (input) (packet) (day) = if list-length packet < 10 | list-at packet 0 /= 3 | input.mode /= 2 | input.session.phase /= 2 then None
    else let said = text-trim (gp-speech-text packet)
    in if text-length said < 8 | text-to-lower (substring said 0 8) /= "appoint " | not (ga-is-british shard.accounts) | not (rsc-near shard.world input.session.serial) then None
    else let typed = text-trim (substring said 8 (text-length said - 8))
    in let who = rsc-character shard (rsc-lowered (text-to-utf8-bytes typed) 0 [])
    in if who == 0 then Just (rsc-say shard.world ("I find no one named " & typed & " in the rolls, my lord.") "secretary:unknown")
    else if rsc-appoint book who day < 0 then Just (rsc-say shard.world "The book is full for today, my lord." "secretary:full")
    else Just (rsc-say shard.world (typed & " is written in for today, my lord.") "secretary:appointed")
  rsc-front : WdState, Integer -> Boolean
  rsc-front (state) (i) = wd-is-door state i & wd-field state i 0 == rsc-door-x & wd-field state i 2 == rsc-door-z
    & (wd-field state i 1 == rsc-door-y | wd-field state i 1 == rsc-door-y + 1)
 True when the double-click must be refused: a shut front door, used from outside by a character neither British nor
 booked today.
  rsc-shut : Integer, WdState, GameShard, GameInput, List Integer, Integer, Integer -> Boolean
  rsc-shut (book) (state) (shard) (input) (packet) (index) (day) = if list-length packet /= 5 | list-at packet 0 /= 6 | index < 0 | index >= state.count then False
    else if not (rsc-front state index) | bit-and (peek-byte state.opened index) 1 /= 0 | ga-is-british shard.accounts then False
    else when world-get shard.world input.session.serial
      is Err (_) -> False
      is Ok (me) -> me.x > rsc-door-x & not (rsc-booked book input.session.serial day 0)
