Chapter: LawStateCodec
  cites Uoaix chapter Law
  cites Uoaix chapter WorldSnapshot

  lsc-jails-at : Integer = 88
  lsc-guards-at : Integer = lsc-jails-at + 16 * 24
  lsc-cases-at : Integer = lsc-guards-at + 32 * 32
  lsc-witnesses-at : Integer = lsc-cases-at + 128 * 88
  lsc-bytes : Integer = lsc-witnesses-at + 256 * 40
  lsc-case-fields : Integer, Integer, LawCase, Boolean -> Integer
  lsc-case-fields (buf) (at) (p) (read) =
    let f0 = if read then let loaded = __record-set p "source" (peek-qword buf (at + 0)) in 0
      else poke-qword buf (at + 0) p.source
    in let f1 = if read then let loaded = __record-set p "offender" (peek-qword buf (at + 8)) in 0
      else poke-qword buf (at + 8) p.offender
    in let f2 = if read then let loaded = __record-set p "kind" (peek-qword buf (at + 16)) in 0
      else poke-qword buf (at + 16) p.kind
    in let f3 = if read then let loaded = __record-set p "town" (peek-qword buf (at + 24)) in 0
      else poke-qword buf (at + 24) p.town
    in let f4 = if read then let loaded = __record-set p "x" (peek-qword buf (at + 32)) in 0
      else poke-qword buf (at + 32) p.x
    in let f5 = if read then let loaded = __record-set p "y" (peek-qword buf (at + 40)) in 0
      else poke-qword buf (at + 40) p.y
    in let f6 = if read then let loaded = __record-set p "known" (peek-qword buf (at + 48) == 1) in 0
      else poke-qword buf (at + 48) (if p.known then 1 else 0)
    in let f7 = if read then let loaded = __record-set p "status" (peek-qword buf (at + 56)) in 0
      else poke-qword buf (at + 56) p.status
    in let f8 = if read then let loaded = __record-set p "guard" (peek-qword buf (at + 64)) in 0
      else poke-qword buf (at + 64) p.guard
    in let f9 = if read then let loaded = __record-set p "term" (peek-qword buf (at + 72)) in 0
      else poke-qword buf (at + 72) p.term
    in let f10 = if read then let loaded = __record-set p "due" (peek-qword buf (at + 80)) in 0
      else poke-qword buf (at + 80) p.due
    in 0
  lsc-cases : LawWorld, Integer, Boolean, Integer -> Integer
  lsc-cases (w) (buf) (read) (i) = if i == 128 then 0
    else let fields = lsc-case-fields buf (lsc-cases-at + i * 88) (list-at w.cases i) read
    in lsc-cases w buf read (i + 1)
  lsc-witness-fields : Integer, Integer, LawWitness, Boolean -> Integer
  lsc-witness-fields (buf) (at) (p) (read) =
    let f0 = if read then let loaded = __record-set p "case-id" (peek-qword buf (at + 0)) in 0
      else poke-qword buf (at + 0) p.case-id
    in let f1 = if read then let loaded = __record-set p "serial" (peek-qword buf (at + 8)) in 0
      else poke-qword buf (at + 8) p.serial
    in let f2 = if read then let loaded = __record-set p "npc" (peek-qword buf (at + 16) == 1) in 0
      else poke-qword buf (at + 16) (if p.npc then 1 else 0)
    in let f3 = if read then let loaded = __record-set p "willing" (peek-qword buf (at + 24) == 1) in 0
      else poke-qword buf (at + 24) (if p.willing then 1 else 0)
    in let f4 = if read then let loaded = __record-set p "reported" (peek-qword buf (at + 32) == 1) in 0
      else poke-qword buf (at + 32) (if p.reported then 1 else 0)
    in 0
  lsc-witnesses : LawWorld, Integer, Boolean, Integer -> Integer
  lsc-witnesses (w) (buf) (read) (i) = if i == 256 then 0
    else let fields = lsc-witness-fields buf (lsc-witnesses-at + i * 40) (list-at w.witnesses i) read
    in lsc-witnesses w buf read (i + 1)
  lsc-guard-fields : Integer, Integer, LawGuard, Boolean -> Integer
  lsc-guard-fields (buf) (at) (p) (read) =
    let f0 = if read then let loaded = __record-set p "serial" (peek-qword buf (at + 0)) in 0
      else poke-qword buf (at + 0) p.serial
    in let f1 = if read then let loaded = __record-set p "town" (peek-qword buf (at + 8)) in 0
      else poke-qword buf (at + 8) p.town
    in let f2 = if read then let loaded = __record-set p "case-id" (peek-qword buf (at + 16)) in 0
      else poke-qword buf (at + 16) p.case-id
    in let f3 = if read then let loaded = __record-set p "state" (peek-qword buf (at + 24)) in 0
      else poke-qword buf (at + 24) p.state
    in 0
  lsc-guards : LawWorld, Integer, Boolean, Integer -> Integer
  lsc-guards (w) (buf) (read) (i) = if i == 32 then 0
    else let fields = lsc-guard-fields buf (lsc-guards-at + i * 32) (list-at w.guards i) read
    in lsc-guards w buf read (i + 1)
  lsc-jail-fields : Integer, Integer, LawJail, Boolean -> Integer
  lsc-jail-fields (buf) (at) (p) (read) =
    let f0 = if read then let loaded = __record-set p "x" (peek-qword buf (at + 0)) in 0
      else poke-qword buf (at + 0) p.x
    in let f1 = if read then let loaded = __record-set p "y" (peek-qword buf (at + 8)) in 0
      else poke-qword buf (at + 8) p.y
    in let f2 = if read then let loaded = __record-set p "enabled" (peek-qword buf (at + 16) == 1) in 0
      else poke-qword buf (at + 16) (if p.enabled then 1 else 0)
    in 0
  lsc-jails : LawWorld, Integer, Boolean, Integer -> Integer
  lsc-jails (w) (buf) (read) (i) = if i == 16 then 0
    else let fields = lsc-jail-fields buf (lsc-jails-at + i * 24) (list-at w.jails i) read
    in lsc-jails w buf read (i + 1)

  lsc-range : Integer, Integer -> Boolean
  lsc-range (n) (maximum) = n >= 0 & n <= maximum
  lsc-mobile : Integer -> Boolean
  lsc-mobile (serial) = serial > 0 & serial < world-item-bit
  lsc-case-unique : LawWorld, Integer, Integer -> Boolean
  lsc-case-unique (w) (i) (j) = if j == i then True
    else (list-at w.cases i).source /= (list-at w.cases j).source & lsc-case-unique w i (j + 1)
  lsc-known : LawWorld, Integer, Integer -> Boolean
  lsc-known (w) (id) (i) = if i == w.witness-count then False
    else let r = list-at w.witnesses i
    in (r.case-id == id & r.reported) | lsc-known w id (i + 1)
  lsc-case-valid : LawWorld, Integer -> Boolean
  lsc-case-valid (w) (i) = if i == w.count then True else let c = list-at w.cases i
    in c.source > 0 & c.source <= 1000000000000 & lsc-mobile c.offender
      & c.kind >= 1 & c.kind <= 3 & c.town >= 1 & c.town <= 16
      & lsc-range c.x 6143 & lsc-range c.y 4095 & lsc-range c.status 5 & lsc-range c.guard w.guard-count
      & c.term >= 1 & c.term <= 8760 & lsc-range c.due 1000000000000
      & (c.status == 0 | (c.known & c.guard > 0))
      & (c.guard == 0 | c.known) & c.known == lsc-known w (i + 1) 0
      & lsc-case-unique w i 0 & lsc-case-valid w (i + 1)
  lsc-witness-unique : LawWorld, Integer, Integer -> Boolean
  lsc-witness-unique (w) (i) (j) = if j == i then True
    else let a = list-at w.witnesses i in let b = list-at w.witnesses j
    in (a.serial /= b.serial | a.case-id /= b.case-id) & lsc-witness-unique w i (j + 1)
  lsc-witness-valid : LawWorld, Integer -> Boolean
  lsc-witness-valid (w) (i) = if i == w.witness-count then True else let r = list-at w.witnesses i
    in if r.case-id < 1 | r.case-id > w.count then False
    else lsc-mobile r.serial & r.serial /= (lw-case w r.case-id).offender
      & lsc-witness-unique w i 0 & lsc-witness-valid w (i + 1)
  lsc-guard-unique : LawWorld, Integer, Integer -> Boolean
  lsc-guard-unique (w) (i) (j) = if j == i then True
    else (list-at w.guards i).serial /= (list-at w.guards j).serial & lsc-guard-unique w i (j + 1)
  lsc-guard-valid : LawWorld, Integer -> Boolean
  lsc-guard-valid (w) (i) = if i == w.guard-count then True else let g = list-at w.guards i
    in if not (lsc-mobile g.serial) | g.town < 1 | g.town > 16 | not (lsc-range g.state 4) | not (lsc-range g.case-id w.count) then False
    else let assignment = if g.state == 0 then g.case-id == 0 else if g.case-id == 0 then False else
      (lw-case w g.case-id).known & (lw-case w g.case-id).town == g.town & (lw-case w g.case-id).offender /= g.serial
    in assignment & lsc-guard-unique w i 0 & lsc-guard-valid w (i + 1)
  lsc-jail-valid : LawWorld, Integer -> Boolean
  lsc-jail-valid (w) (i) = if i == 16 then True else let j = list-at w.jails i
    in lsc-range j.x 6143 & lsc-range j.y 4095 & lsc-jail-valid w (i + 1)
  lsc-valid : LawWorld -> Boolean
  lsc-valid (w) = if not (world-indexed w.world) | not (lsc-range w.count 128)
    | not (lsc-range w.witness-count 256) | not (lsc-range w.guard-count 32) | not (lsc-range w.hour 1000000000000)
    | list-length w.cases /= 128 | list-length w.witnesses /= 256 | list-length w.guards /= 32
    | list-length w.jails /= 16 | list-length w.sentences /= 3 then False
    else list-at w.sentences 0 >= 1 & list-at w.sentences 0 <= 8760
      & list-at w.sentences 1 >= 1 & list-at w.sentences 1 <= 8760
      & list-at w.sentences 2 >= 1 & list-at w.sentences 2 <= 8760
      & lsc-case-valid w 0 & lsc-witness-valid w 0 & lsc-guard-valid w 0 & lsc-jail-valid w 0
  lsc-bool : Integer, Integer -> Boolean
  lsc-bool (buf) (at) = peek-qword buf at == 0 | peek-qword buf at == 1
  lsc-bools : Integer, Integer -> Boolean
  lsc-bools (buf) (i) = if i == 256 then True
    else (if i < 16 then lsc-bool buf (lsc-jails-at + i * 24 + 16) else True)
      & (if i < 128 then lsc-bool buf (lsc-cases-at + i * 88 + 48) else True)
      & lsc-bool buf (lsc-witnesses-at + i * 40 + 16)
      & lsc-bool buf (lsc-witnesses-at + i * 40 + 24)
      & lsc-bool buf (lsc-witnesses-at + i * 40 + 32) & lsc-bools buf (i + 1)
  lsc-encode : LawWorld, Integer, Integer -> Result Integer Text
  lsc-encode (w) (buf) (capacity) = if capacity < lsc-bytes | not (lsc-valid w) then Err "Law checkpoint state or capacity"
    else let a = poke-qword buf 0 #3143534C
    in let b = poke-qword buf 8 1
    in let c = poke-qword buf 16 lsc-bytes
    in let d = poke-qword buf 24 w.count
    in let e = poke-qword buf 32 w.witness-count
    in let f = poke-qword buf 40 w.guard-count
    in let g = poke-qword buf 56 w.hour
    in let s0 = poke-qword buf 64 (list-at w.sentences 0)
    in let s1 = poke-qword buf 72 (list-at w.sentences 1)
    in let s2 = poke-qword buf 80 (list-at w.sentences 2)
    in let j = lsc-jails w buf False 0
    in let guards = lsc-guards w buf False 0
    in let cases = lsc-cases w buf False 0
    in let witnesses = lsc-witnesses w buf False 0
    in if not (lsc-unused buf w.count w.witness-count w.guard-count) then Err "Law checkpoint unused rows"
    else let hash = poke-qword buf 48 (ws-hash buf lsc-bytes 0 2166136261) in Ok lsc-bytes
  lsc-zero-range : Integer, Integer, Integer -> Boolean
  lsc-zero-range (buf) (at) (limit) = if at == limit then True else peek-qword buf at == 0 & lsc-zero-range buf (at + 8) limit
  lsc-unused : Integer, Integer, Integer, Integer -> Boolean
  lsc-unused (buf) (cases) (witnesses) (guards) =
    lsc-zero-range buf (lsc-cases-at + cases * 88) lsc-witnesses-at
      & lsc-zero-range buf (lsc-witnesses-at + witnesses * 40) lsc-bytes
      & lsc-zero-range buf (lsc-guards-at + guards * 32) lsc-cases-at
  lsc-decode : Integer, Integer, WorldTable -> Result LawWorld Text
  lsc-decode (buf) (size) (world) = if size /= lsc-bytes then Err "Law checkpoint extent"
    else if peek-qword buf 0 /= #3143534C | peek-qword buf 8 /= 1 | peek-qword buf 16 /= size
      | not (lsc-range (peek-qword buf 24) 128) | not (lsc-range (peek-qword buf 32) 256)
      | not (lsc-range (peek-qword buf 40) 32) | not (lsc-range (peek-qword buf 56) 1000000000000) then Err "Law checkpoint header"
    else if peek-qword buf 48 /= ws-hash buf size 0 2166136261 | not (lsc-bools buf 0)
      | not (lsc-unused buf (peek-qword buf 24) (peek-qword buf 32) (peek-qword buf 40)) then Err "Law checkpoint checksum or spare rows"
    else let w = lw-new world
    in let a = __record-set w "count" (peek-qword buf 24)
    in let b = __record-set w "witness-count" (peek-qword buf 32)
    in let c = __record-set w "guard-count" (peek-qword buf 40)
    in let d = __record-set w "hour" (peek-qword buf 56)
    in let s0 = list-set-at w.sentences 0 (peek-qword buf 64)
    in let s1 = list-set-at w.sentences 1 (peek-qword buf 72)
    in let s2 = list-set-at w.sentences 2 (peek-qword buf 80)
    in let j = lsc-jails w buf True 0
    in let guards = lsc-guards w buf True 0
    in let cases = lsc-cases w buf True 0
    in let witnesses = lsc-witnesses w buf True 0
    in if lsc-valid w then Ok w else Err "Law checkpoint invariants"
