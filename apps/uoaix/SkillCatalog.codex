Chapter: SkillCatalog

  SkInstrument = record { name : Text, parent : Integer, tier : Integer, job : Integer }
  sk-instrument : Text, Integer, Integer, Integer -> SkInstrument
  sk-instrument (name) (parent) (tier) (job) = SkInstrument { name = name, parent = parent, tier = tier, job = job }
  sk-catalog : Integer -> List SkInstrument
  sk-catalog (unused) = [
    sk-instrument "shovel" 1 1 1, sk-instrument "pickaxe" 1 2 2,
    sk-instrument "saw" 2 1 3, sk-instrument "chair joinery" 2 2 4,
    sk-instrument "table joinery" 2 2 5, sk-instrument "lathe" 2 3 6,
    sk-instrument "plane" 2 2 7, sk-instrument "stone hammer" 3 1 8,
    sk-instrument "smith hammer" 3 2 9, sk-instrument "leather knife" 4 1 10,
    sk-instrument "awl" 4 2 11, sk-instrument "needle" 5 1 12,
    sk-instrument "shears" 5 2 13, sk-instrument "hoe" 6 1 14,
    sk-instrument "plow" 6 2 15, sk-instrument "fishing rod" 7 1 16,
    sk-instrument "fishing net" 7 2 17, sk-instrument "hand axe" 8 1 18,
    sk-instrument "felling axe" 8 2 19, sk-instrument "cooking knife" 9 1 20,
    sk-instrument "pan" 9 2 21, sk-instrument "trowel" 10 1 22,
    sk-instrument "pruning knife" 10 2 23, sk-instrument "longsword" 11 1 24,
    sk-instrument "katana" 11 2 25, sk-instrument "viking sword" 11 2 26,
    sk-instrument "bow" 12 1 27, sk-instrument "crossbow" 12 2 28,
    sk-instrument "mortar" 13 1 29, sk-instrument "alembic" 13 2 30,
    sk-instrument "wand" 14 1 31, sk-instrument "staff" 14 2 32]
  sk-starter : Integer -> Integer
  sk-starter (profession) = if profession == 1 then 1 else if profession == 2 then 3
    else if profession == 3 then 8 else if profession == 4 then 10 else if profession == 5 then 12
    else if profession == 6 then 14 else if profession == 7 then 16 else if profession == 8 then 18
    else if profession == 9 then 20 else if profession == 10 then 22 else if profession == 11 then 24
    else if profession == 12 then 27 else if profession == 13 then 29 else if profession == 14 then 31 else 0

