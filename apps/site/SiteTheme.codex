 We say:

Section: Theme

  site-palette : Palette
  site-palette = Palette { pal-bg = #0A0A12, pal-fg = #E0E0E8, pal-primary = #D4A017, pal-secondary = #141420, pal-accent = #D4A017, pal-muted = #666680, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }

  site-theme : Theme
  site-theme =
    let p = site-palette
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-primary) (p.pal-fg) (bdr 0 0 (CornerRound 8)) (exy 24 12) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "site-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  css-base : Text
  css-base =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0a0a12;color:#e0e0e8;font-family:system-ui,-apple-system,sans-serif;min-height:100vh;overflow-x:hidden;overflow-y:scroll;scroll-behavior:smooth}#app{display:contents}"
    & "a{color:#d4a017;text-decoration:none}a:hover{text-decoration:underline}"
    & ".wk-label{display:block}"

  css-nav : Text
  css-nav =
    ".nav{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(5,5,16,.85);backdrop-filter:blur(12px);border-bottom:1px solid rgba(30,30,46,.5)}"
    & ".nav>.wk-label{font-size:20px;font-weight:800;letter-spacing:3px;color:#d4a017}"
    & ".nav-links{display:flex;gap:24px;font-size:14px}"
    & ".nav-links>.wk-label{color:#8b949e;cursor:pointer;transition:color .15s;display:inline}"
    & ".nav-links>.wk-label:hover{color:#d4a017}"

  css-hero : Text
  css-hero =
    ".hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden;background:linear-gradient(180deg,#050510 0%,#0a0a1a 15%,#1a2040 40%,#2a3055 65%,#3a2a20 85%,#2a1a10 100%)}"
    & ".hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 120%,rgba(212,160,23,.12) 0%,transparent 55%),radial-gradient(circle at 30% 20%,rgba(100,140,200,.06) 0%,transparent 40%),radial-gradient(circle at 70% 30%,rgba(180,120,60,.05) 0%,transparent 35%);pointer-events:none}"
    & ".hero::after{content:'';position:absolute;top:0;left:0;right:0;height:300px;background:radial-gradient(1px 1px at 10% 20%,rgba(255,255,255,.5),transparent),radial-gradient(1px 1px at 25% 60%,rgba(255,255,255,.3),transparent),radial-gradient(1px 1px at 40% 35%,rgba(255,255,255,.4),transparent),radial-gradient(1px 1px at 55% 80%,rgba(255,255,255,.25),transparent),radial-gradient(1px 1px at 70% 15%,rgba(255,255,255,.45),transparent),radial-gradient(1px 1px at 85% 45%,rgba(255,255,255,.3),transparent),radial-gradient(1px 1px at 15% 75%,rgba(255,255,255,.35),transparent),radial-gradient(1px 1px at 60% 10%,rgba(255,255,255,.5),transparent),radial-gradient(1px 1px at 90% 70%,rgba(255,255,255,.2),transparent),radial-gradient(1px 1px at 35% 50%,rgba(255,255,255,.3),transparent),radial-gradient(1px 1px at 5% 40%,rgba(255,255,255,.4),transparent),radial-gradient(1px 1px at 48% 28%,rgba(255,255,255,.35),transparent);background-size:300px 300px;pointer-events:none;opacity:.7}"
    & "#badge{display:inline-block;background:rgba(212,160,23,.15);color:#d4a017;font-size:12px;font-weight:600;padding:6px 16px;border-radius:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:24px;position:relative;z-index:1}"
    & "#h-title{font-size:clamp(40px,8vw,64px);font-weight:800;line-height:1.1;margin-bottom:20px;color:#d4a017;text-shadow:0 0 80px rgba(212,160,23,.4),0 0 160px rgba(212,160,23,.15),0 4px 16px rgba(0,0,0,.9);letter-spacing:6px;position:relative;z-index:1}"
    & "#h-sub{font-size:clamp(15px,2.2vw,20px);color:#9ba7b4;line-height:1.7;max-width:700px;margin:0 auto 32px;text-shadow:0 2px 10px rgba(0,0,0,.9);position:relative;z-index:1}"
    & "#h-sub em{font-style:italic;color:#d4a017}"
    & ".hero-stats{display:flex;justify-content:center;gap:48px;margin-top:40px;position:relative;z-index:1}"
    & ".stat{text-align:center}"
    & ".stat>.wk-label:first-child{font-size:36px;font-weight:800;color:#fff;text-shadow:0 0 20px rgba(212,160,23,.3)}"
    & ".stat>.wk-label:last-child{font-size:13px;color:#8b949e;margin-top:4px;text-transform:uppercase;letter-spacing:1px}"

  css-section : Text
  css-section =
    ".section{padding:80px 0}"
    & ".section-hdr{text-align:center;margin-bottom:40px}"
    & ".section-hdr>.wk-label:first-child{color:#d4a017;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px}"
    & ".section-hdr>.wk-label:nth-child(2){font-size:32px;font-weight:700;color:#fff;margin-bottom:12px}"
    & ".section-hdr>.wk-label:nth-child(3){font-size:16px;color:#8b949e;max-width:600px;margin:0 auto}"

  css-card : Text
  css-card =
    ".card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}"
    & ".card-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}"
    & ".card-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}"
    & ".card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:28px;transition:border-color .2s,transform .2s}"
    & ".card:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".card>.wk-label:first-child{font-size:28px;margin-bottom:12px}"
    & ".card>.wk-label:nth-child(2){font-size:16px;font-weight:700;color:#fff;margin-bottom:8px}"
    & ".card>.wk-label:nth-child(3){font-size:14px;color:#8b949e;line-height:1.6}"
    & ".card>.wk-label:nth-child(4){font-size:13px;color:#8b949e;line-height:1.5;margin-top:8px}"

  css-showcase : Text
  css-showcase =
    ".showcase{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}"
    & ".showcase-visual{background:#12121e;border:1px solid #1e1e2e;border-radius:16px;overflow:hidden;position:relative}"
    & ".showcase-info>.wk-label:first-child{font-size:24px;font-weight:700;color:#fff;margin-bottom:12px}"
    & ".showcase-info>.wk-label:nth-child(2){font-size:15px;color:#8b949e;line-height:1.7;margin-bottom:16px}"
    & ".tag-row{display:flex;flex-wrap:wrap;gap:8px}"
    & ".tag-row>.wk-label{display:inline-block;background:rgba(212,160,23,.1);color:#d4a017;font-size:12px;padding:4px 12px;border-radius:12px;border:1px solid rgba(212,160,23,.2)}"

  css-code : Text
  css-code =
    ".code-block{background:#12121e;border:1px solid #1e1e2e;border-radius:12px;overflow:hidden}"
    & ".code-hdr{display:flex;align-items:center;gap:8px;padding:12px 16px;background:#0e0e1a;border-bottom:1px solid #1e1e2e;font-size:13px;color:#666}"
    & ".code-hdr>.wk-label:nth-child(-n+3){width:10px;height:10px;border-radius:50%;background:#333;font-size:0;overflow:hidden;flex-shrink:0}"
    & ".code-hdr>.wk-label:last-child{font-size:13px;color:#666}"
    & ".code-body{padding:20px;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.8;color:#c8c8d8;white-space:pre;overflow-x:auto}"
    & ".code-body .kw{color:#d4a017}.code-body .ty{color:#f1c40f}.code-body .fn{color:#58a6ff}.code-body .cm{color:#555;font-style:italic}.code-body .st{color:#3fb950}.code-body .nu{color:#f0883e}"

  css-timeline : Text
  css-timeline =
    ".timeline{position:relative;padding-left:32px}"
    & ".timeline::before{content:'';position:absolute;left:11px;top:0;bottom:0;width:2px;background:#1e1e2e}"
    & ".tl-event{position:relative;margin-bottom:24px;padding-left:24px}"
    & ".tl-event::before{content:'';position:absolute;left:-25px;top:6px;width:12px;height:12px;border-radius:50%;background:#d4a017;border:2px solid #0a0a12;box-shadow:0 0 8px rgba(212,160,23,.3)}"
    & ".tl-event>.wk-label:first-child{font-size:12px;color:#d4a017;font-weight:600;margin-bottom:4px}"
    & ".tl-event>.wk-label:nth-child(2){font-size:16px;font-weight:600;color:#fff;margin-bottom:4px}"
    & ".tl-event>.wk-label:last-child{font-size:14px;color:#8b949e;line-height:1.5}"

  css-bullet : Text
  css-bullet =
    ".bullet-list>.wk-label{padding:6px 0 6px 14px;font-size:14px;color:#aaa;position:relative;line-height:1.5}"
    & ".bullet-list>.wk-label::before{content:'';display:inline-block;width:6px;height:6px;background:#d4a017;border-radius:50%;position:absolute;left:0;top:12px}"

  css-footer : Text
  css-footer =
    ".footer{background:linear-gradient(180deg,#060a10,#040608);border-top:1px solid #1e1e2e;padding:60px 24px;text-align:center}"
    & ".footer>.wk-label:first-child{font-size:22px;font-weight:bold;color:#d4a017;margin-bottom:8px;letter-spacing:3px}"
    & ".footer>.wk-label:nth-child(2){font-size:14px;color:#8b949e;margin-bottom:12px}"
    & ".footer-links{display:flex;justify-content:center;gap:24px;margin-top:12px;font-size:13px}"
    & ".footer-links>.wk-label{display:inline;color:#8b949e;cursor:pointer;transition:color .15s}"
    & ".footer-links>.wk-label:hover{color:#d4a017}"

  css-responsive : Text
  css-responsive =
    "@media(max-width:768px){#h-title{font-size:36px;letter-spacing:2px}.card-grid-3,.card-grid-4{grid-template-columns:1fr}.showcase{grid-template-columns:1fr}.hero-stats{flex-wrap:wrap;gap:24px}.nav-links{display:none}}"

  site-css : Text
  site-css = css-base & css-nav & css-hero & css-section & css-card & css-showcase & css-code & css-timeline & css-bullet & css-footer & css-responsive

Section: Widget Constructors

  site-nav : List WidgetNode -> WidgetNode
  site-nav (links) =
    widget-box "nav" "nav" [
      widget-label "logo" "&#x2588; CODEX",
      widget-box "links" "nav-links" links
    ]

  site-hero : Text, Text, Text, List WidgetNode -> WidgetNode
  site-hero (badge-text) (title) (subtitle) (stats) =
    widget-box "hero" "hero" [
      widget-label "badge" badge-text,
      widget-label "h-title" title,
      widget-label "h-sub" subtitle,
      widget-box "stats" "hero-stats" stats
    ]

  site-stat : Text, Text, Text -> WidgetNode
  site-stat (id) (num) (label) =
    widget-box id "stat" [
      widget-label (id & "n") num,
      widget-label (id & "l") label
    ]

  site-section : Text, Text, Text, Text, List WidgetNode -> WidgetNode
  site-section (id) (tag) (title) (desc) (content) =
    widget-box id "section" [
      widget-box (id & "-hdr") "section-hdr" [
        widget-label (id & "-tag") tag,
        widget-label (id & "-t") title,
        widget-label (id & "-d") desc
      ],
      wk-attach (widget-custom (id & "-body") ("box:") 0 0) content 0 (list-length content)
    ]

  site-card : Text, Text, Text, Text -> WidgetNode
  site-card (id) (icon) (title) (desc) =
    widget-box id "card" [
      widget-label (id & "i") icon,
      widget-label (id & "t") title,
      widget-label (id & "d") desc
    ]

  site-card-4 : Text, Text, Text, Text, Text -> WidgetNode
  site-card-4 (id) (icon) (title) (desc) (extra) =
    widget-box id "card" [
      widget-label (id & "i") icon,
      widget-label (id & "t") title,
      widget-label (id & "d") desc,
      widget-label (id & "x") extra
    ]

  site-card-grid : Text, List WidgetNode -> WidgetNode
  site-card-grid (id) (cards) =
    wk-attach (widget-custom id "box:card-grid" 0 0) cards 0 (list-length cards)

  site-card-grid-3 : Text, List WidgetNode -> WidgetNode
  site-card-grid-3 (id) (cards) =
    wk-attach (widget-custom id "box:card-grid-3" 0 0) cards 0 (list-length cards)

  site-card-grid-4 : Text, List WidgetNode -> WidgetNode
  site-card-grid-4 (id) (cards) =
    wk-attach (widget-custom id "box:card-grid-4" 0 0) cards 0 (list-length cards)

  site-showcase : Text, WidgetNode, WidgetNode -> WidgetNode
  site-showcase (id) (visual) (info) =
    widget-box id "showcase" [ visual, info ]

  site-showcase-info : Text, Text, Text, List WidgetNode -> WidgetNode
  site-showcase-info (id) (title) (desc) (tags) =
    widget-box id "showcase-info" [
      widget-label (id & "t") title,
      widget-label (id & "d") desc,
      wk-attach (widget-custom (id & "tags") "box:tag-row" 0 0) tags 0 (list-length tags)
    ]

  site-tag : Text, Text -> WidgetNode
  site-tag (id) (label) = widget-label id label

  site-code-block : Text, Text, Text -> WidgetNode
  site-code-block (id) (filename) (code) =
    widget-box id "code-block" [
      widget-box (id & "h") "code-hdr" [
        widget-label (id & "d0") "&shy;",
        widget-label (id & "d1") "&shy;",
        widget-label (id & "d2") "&shy;",
        widget-label (id & "f") filename
      ],
      widget-box (id & "b") "code-body" [
        widget-label (id & "c") code
      ]
    ]

  site-timeline : Text, List WidgetNode -> WidgetNode
  site-timeline (id) (events) =
    wk-attach (widget-custom id "box:timeline" 0 0) events 0 (list-length events)

  site-tl-event : Text, Text, Text, Text -> WidgetNode
  site-tl-event (id) (date) (title) (desc) =
    widget-box id "tl-event" [
      widget-label (id & "d") date,
      widget-label (id & "t") title,
      widget-label (id & "p") desc
    ]

  site-bullet-list : Text, List WidgetNode -> WidgetNode
  site-bullet-list (id) (items) =
    wk-attach (widget-custom id "box:bullet-list" 0 0) items 0 (list-length items)

  site-footer : List WidgetNode -> WidgetNode
  site-footer (links) =
    widget-box "foot" "footer" [
      widget-label "f-brand" "CODEX",
      widget-label "f-text" "Built with Codex. The compiler compiled this page.",
      widget-box "f-links" "footer-links" links
    ]

Section: Page Init

  site-init : Text -> Integer
  site-init (extra-css) =
    let t = inject-app-style site-theme (site-css & extra-css)
    in 0

