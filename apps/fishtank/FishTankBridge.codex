    &     "  spriteBindGroup = device.createBindGroup({layout:spritePipeline.getBindGroupLayout(0),entries:[{binding:0,resource:{buffer:spriteUniformBuf}},{binding:1,resource:atlasTexture.createView()},{binding:2,resource:sampler}]});\n"
    &     "\n"
