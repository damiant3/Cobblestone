Chapter: FishTankPage
  cites FishTank chapter FishTankCss
  cites FishTank chapter FishTankBridge

Section: Page Fragments

  html-doctype : Text = "<!DOCTYPE html>\n<html lang=\"en\">\n"

  html-head : Text =
    "<head>\n" &
    "<meta charset=\"utf-8\">\n" &
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" &
    "<title>Codex Aquarium</title>\n" &
    "<style>\n" & fishtank-css & "\n</style>\n" &
    "</head>\n"

  html-hud : Text =
    "<div class=\"hud\">\n" &
    "  <div class=\"hud-left\">\n" &
    "    <span class=\"hud-brand\">CODEX AQUARIUM</span>\n" &
    "    <span class=\"hud-stat\"><span id=\"fish-count\">0</span></span>\n" &
    "    <span class=\"hud-stat\">Temp <span id=\"temp\">76.5&#xB0;F</span></span>\n" &
    "    <span class=\"hud-stat\"><span id=\"tod\">Day</span></span>\n" &
    "  </div>\n" &
    "  <div class=\"hud-right\">\n" &
    "    <span class=\"hud-stat\"><span id=\"fps\">--</span></span>\n" &
    "  </div>\n" &
    "</div>\n"

  html-controls : Text =
    "<div class=\"species-bar\" id=\"species\"></div>\n" &
    "<div class=\"controls\">\n" &
    "  <button class=\"ctrl-btn\" data-action=\"feed\"><span class=\"icon\">&#x1F35E;</span>Feed</button>\n" &
    "  <button class=\"ctrl-btn\" data-action=\"tap\"><span class=\"icon\">&#x1F446;</span>Tap Glass</button>\n" &
    "  <div class=\"ctrl-sep\"></div>\n" &
    "  <button class=\"ctrl-btn\" data-action=\"light\"><span class=\"icon\">&#x1F4A1;</span>Light</button>\n" &
    "  <div class=\"ctrl-sep\"></div>\n" &
    "  <button class=\"ctrl-btn\" data-action=\"add\"><span class=\"icon\">&#x1F420;</span>Add Fish</button>\n" &
    "</div>\n" &
    "<div class=\"add-menu\" id=\"add-menu\">\n" &
    "  <div class=\"add-option\" data-species=\"Clownfish\">Clownfish</div>\n" &
    "  <div class=\"add-option\" data-species=\"Angelfish\">Angelfish</div>\n" &
    "  <div class=\"add-option\" data-species=\"Neon Tetra\">Neon Tetra</div>\n" &
    "  <div class=\"add-option\" data-species=\"Blue Tang\">Blue Tang</div>\n" &
    "  <div class=\"add-option\" data-species=\"Discus\">Discus</div>\n" &
    "  <div class=\"add-option\" data-species=\"Guppy\">Guppy</div>\n" &
    "  <div class=\"add-option\" data-species=\"Seahorse\">Seahorse</div>\n" &
    "  <div class=\"add-option\" data-species=\"Shrimp\">Shrimp</div>\n" &
    "</div>\n"

  html-body-start : Text =
    "<body>\n" &
    "<canvas id=\"c\"></canvas>\n" &
    "<div id=\"status\">Initializing WebGPU...</div>\n" &
    html-hud & html-controls &
    "<script>\n"

Section: Emit

  opening : [Console] Nothing
  opening = act
    print-line-raw (html-doctype & html-head & html-body-start)
    print-line-raw js-c1
    print-line-raw js-c2
    print-line-raw js-c3
    print-line-raw js-c4
    print-line-raw js-c5
    print-line-raw js-c6
    print-line-raw js-c7
    print-line-raw js-c8
    print-line-raw js-c9
    print-line-raw js-c10
    print-line-raw js-c11
    print-line-raw js-c12
    print-line-raw js-c13
    print-line-raw js-c14
    print-line-raw js-c15
    print-line-raw js-c16
    print-line-raw js-c17
    print-line-raw js-c18
    print-line-raw js-c19
    print-line-raw js-c20
    print-line-raw js-c21
    print-line-raw js-c22
    print-line-raw js-c23
    print-line-raw "</script>\n</body>\n</html>"
  end

Page 1
