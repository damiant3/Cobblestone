Chapter: FishTankWasmPage
  cites FishTank chapter FishTankCss
  cites FishTank chapter FishTankWasmBridge

Section: HTML Head

  emit-head : Text
  emit-head =
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    & "<meta charset=\"utf-8\">\n"
    & "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    & "<title>Codex Aquarium -- WASM</title>\n"
    & "<style>\n" & fishtank-css & "\n"
    & ".cb-nav{display:flex;align-items:center;gap:22px;padding:12px 24px;background:rgba(5,5,16,.88);backdrop-filter:blur(12px);border-bottom:1px solid #1e1e2e;position:fixed;left:0;right:0;top:0;z-index:100;font:14px system-ui,\"Segoe UI\",sans-serif;line-height:1.4}"
    & ".cb-nav .cb-logo{color:#d4a017;font-size:18px;font-weight:800;letter-spacing:3px;text-decoration:none}"
    & ".cb-nav .cb-here{color:#8b949e}.cb-nav .cb-links{margin-left:auto;display:flex;gap:22px}"
    & ".cb-nav .cb-links a{color:#8b949e;text-decoration:none}.cb-nav .cb-links a:hover{color:#d4a017}"
    & ".hud{top:46px}\n</style>\n"
    & "</head>\n"

Section: HTML Body

  emit-body : Text
  emit-body =
    "<body>\n"
    & "<canvas id=\"c\"></canvas>\n"
    & "<div id=\"status\">Initializing WebGPU + WASM...</div>\n"
    & "<nav class=\"cb-nav\"><a class=\"cb-logo\" href=\"../landing.html\">&#x2588; COBBLESTONE</a><span class=\"cb-here\">The Aquarium</span><span class=\"cb-links\"><a href=\"https://github.com/damiant3/Cobblestone/blob/master/apps/fishtank/FishTankWasm.codex\">{ } Source</a><a href=\"../graphics/index.html\">&#8592; Codex Graphics</a><a href=\"../landing.html#today\">&#8592; Back to the site</a></span></nav>\n"
    & "<div class=\"hud\"><div class=\"hud-left\">"
    & "<span class=\"hud-brand\">CODEX AQUARIUM</span>"
    & "<span class=\"hud-stat\"><span id=\"fish-count\">0</span></span>"
    & "<span class=\"hud-stat\">Temp <span id=\"temp\">76.5&#xB0;F</span></span>"
    & "<span class=\"hud-stat\"><span id=\"tod\">Day</span></span>"
    & "</div><div class=\"hud-right\">"
    & "<span class=\"hud-stat\"><span id=\"fps\">--</span></span>"
    & "</div></div>\n"
    & "<div class=\"species-bar\" id=\"species\"></div>\n"
    & "<div class=\"controls\">"
    & "<button class=\"ctrl-btn\" data-action=\"feed\">Feed</button>"
    & "<button class=\"ctrl-btn\" data-action=\"tap\">Tap Glass</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" data-action=\"light\">Light</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" data-action=\"add\">Add Fish</button>"
    & "</div>\n"
    & "<div class=\"add-menu\" id=\"add-menu\">\n"
    & "<div class=\"add-option\" data-species=\"Clownfish\">Clownfish</div>\n"
    & "<div class=\"add-option\" data-species=\"Angelfish\">Angelfish</div>\n"
    & "<div class=\"add-option\" data-species=\"Neon Tetra\">Neon Tetra</div>\n"
    & "<div class=\"add-option\" data-species=\"Blue Tang\">Blue Tang</div>\n"
    & "<div class=\"add-option\" data-species=\"Discus\">Discus</div>\n"
    & "<div class=\"add-option\" data-species=\"Guppy\">Guppy</div>\n"
    & "<div class=\"add-option\" data-species=\"Seahorse\">Seahorse</div>\n"
    & "<div class=\"add-option\" data-species=\"Shrimp\">Shrimp</div>\n"
    & "</div>\n"

Section: Opening

  opening : [Console] Nothing
  opening = act
    print-text emit-head
    print-text emit-body
    print-text "<script>\n"
    print-text (wb-c1 & "\n")
    print-text (wb-c2 & "\n")
    print-text (wb-c3 & "\n")
    print-text (wb-c4 & "\n")
    print-text (wb-c5 & "\n")
    print-text (wb-c6 & "\n")
    print-text (wb-c7 & "\n")
    print-text (wb-c8 & "\n")
    print-text (wb-c9 & "\n")
    print-text (wb-c10 & "\n")
    print-text (wb-c11 & "\n")
    print-text (wb-c12 & "\n")
    print-text (wb-c13 & "\n")
    print-text "</script>\n</body>\n</html>\n"
  end

