Chapter: FishTankWasmPage
  cites FishTank chapter FishTankCss
  cites FishTank chapter FishTankWasmBridge

 Page assembler for the WASM-driven fish tank. Emits a complete
 HTML page to stdout: CSS in a style tag, canvas and HUD markup,
 then the JS bridge segments that load fishtank.wasm and render
 with WebGPU. All fish logic runs in the WASM module.

Section: HTML Head

  emit-head : Text
  emit-head =
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    & "<meta charset=\"utf-8\">\n"
    & "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    & "<title>Codex Aquarium — WASM</title>\n"
    & "<style>\n" & fishtank-css & "\n</style>\n"
    & "</head>\n"

Section: HTML Body

  emit-body : Text
  emit-body =
    "<body>\n"
    & "<canvas id=\"c\"></canvas>\n"
    & "<div id=\"status\">Initializing WebGPU + WASM...</div>\n"
    & "<div class=\"hud\"><div class=\"hud-left\">"
    & "<span class=\"hud-brand\">CODEX AQUARIUM</span>"
    & "<span class=\"hud-stat\"><span id=\"fish-count\">0</span></span>"
    & "<span class=\"hud-stat\">Temp <span id=\"temp\">76.5&#xB0;F</span></span>"
    & "<span class=\"hud-stat\"><span id=\"tod\">Day</span></span>"
    & "</div><div class=\"hud-right\">"
    & "<span class=\"hud-stat\"><span id=\"fps\">--</span></span>"
    & "</div></div>\n"
    & "<div class=\"species-bar\" id=\"species\"></div>\n"
    & "<div class=\"controls\">"
    & "<button class=\"ctrl-btn\" onclick=\"feedFish()\">Feed</button>"
    & "<button class=\"ctrl-btn\" onclick=\"tapGlass()\">Tap Glass</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" onclick=\"toggleLight()\">Light</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" onclick=\"toggleAddMenu()\">Add Fish</button>"
    & "</div>\n"
    & "<div class=\"add-menu\" id=\"add-menu\">\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Clownfish');hideAddMenu()\">Clownfish</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Angelfish');hideAddMenu()\">Angelfish</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Neon Tetra');hideAddMenu()\">Neon Tetra</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Blue Tang');hideAddMenu()\">Blue Tang</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Discus');hideAddMenu()\">Discus</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Guppy');hideAddMenu()\">Guppy</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Seahorse');hideAddMenu()\">Seahorse</div>\n"
    & "<div class=\"add-option\" onclick=\"addFishByName('Shrimp');hideAddMenu()\">Shrimp</div>\n"
    & "</div>\n"
    & "<script>\n"
    & "function toggleAddMenu(){document.getElementById('add-menu').classList.toggle('open');}\n"
    & "function hideAddMenu(){document.getElementById('add-menu').classList.remove('open');}\n"
    & "document.addEventListener('click',function(e){if(!e.target.closest('.add-menu')&&!e.target.closest('[onclick*=\"toggleAddMenu\"]'))hideAddMenu();});\n"
    & "</script>\n"

Section: Opening

  opening : [Console] Nothing
  opening = act
    print-line emit-head
    print-line emit-body
    print-line "<script>"
    print-line wb-c1
    print-line wb-c2
    print-line wb-c3
    print-line wb-c4
    print-line wb-c5
    print-line wb-c6
    print-line wb-c7
    print-line wb-c8
    print-line wb-c9
    print-line wb-c10
    print-line wb-c11
    print-line wb-c12
    print-line "</script>\n</body>\n</html>"
  end

