Chapter: FishTankEmit
  cites FishTank chapter FishTankTypes
  cites FishTank chapter FishTankScene
  cites FishTank chapter FishTankCss
  cites FishTank chapter FishTankShaders

 Emitter: walks the AquariumScene model tree and outputs a complete
 HTML page with embedded JavaScript. Each record type has an emit
 function that serializes it to JS. The opening function prints the
 full page to stdout.

Section: Number Emit

  emit-int-100 : Integer -> Text
  emit-int-100 (n) =
    let whole = n / 100
    in let frac = n - whole * 100
    in if frac == 0 then show whole
    else if frac < 10 then show whole & ".0" & show frac
    else show whole & "." & show frac

  emit-bool : Boolean -> Text
  emit-bool (b) = if b then "true" else "false"

Section: Species Emit

  emit-species : FishSpecies -> Text
  emit-species (sp) =
    "{name:'" & sp.sp-name & "',tex:'" & sp.sp-tex
    & "',w:" & emit-int-100 sp.sp-w
    & ",h:" & emit-int-100 sp.sp-h
    & ",speed:" & emit-int-100 sp.sp-speed
    & ",turn:" & emit-int-100 sp.sp-turn
    & ",school:" & show sp.sp-school
    & ",sep:" & emit-int-100 sp.sp-sep
    & ",align:" & emit-int-100 sp.sp-align
    & ",coh:" & emit-int-100 sp.sp-coh
    & ",solo:" & emit-bool sp.sp-solo & "}"

  emit-species-list : List FishSpecies, Integer -> Text
  emit-species-list (xs) (i) =
    if i >= list-length xs then ""
    else let sep = if i > 0 then ",\n  " else "\n  "
    in sep & emit-species (list-at xs i) & emit-species-list xs (i + 1)

  emit-all-species : List FishSpecies -> Text
  emit-all-species (xs) =
    "const SPECIES=[" & emit-species-list xs 0 & "\n];\n"

Section: Body Profile Emit

  emit-station : BodyStation -> Text
  emit-station (s) =
    "{t:" & emit-int-100 s.st-t
    & ",ry:" & emit-int-100 s.st-ry
    & ",rz:" & emit-int-100 s.st-rz & "}"

  emit-station-list : List BodyStation, Integer -> Text
  emit-station-list (xs) (i) =
    if i >= list-length xs then ""
    else let sep = if i > 0 then "," else ""
    in sep & emit-station (list-at xs i) & emit-station-list xs (i + 1)

  emit-fin : Maybe FinDef -> Text
  emit-fin (mf) =
    when mf
      is Just (f) -> "{s:" & emit-int-100 f.fin-start & ",e:" & emit-int-100 f.fin-end & ",h:" & emit-int-100 f.fin-height & "}"
      is None -> "null"

  emit-tail : Maybe TailDef -> Text
  emit-tail (mt) =
    when mt
      is Just (t) -> "{h:" & emit-int-100 t.tail-h & ",fork:" & emit-int-100 t.tail-fork & "}"
      is None -> "null"

  emit-body-profile : FishProfile -> Text
  emit-body-profile (fp) =
    "'" & fp.fp-species.sp-name & "':{stations:["
    & emit-station-list fp.fp-body.fb-stations 0
    & "],dorsal:" & emit-fin fp.fp-body.fb-dorsal
    & ",anal:" & emit-fin fp.fp-body.fb-anal
    & ",tail:" & emit-tail fp.fp-body.fb-tail & "}"

  emit-profile-list : List FishProfile, Integer -> Text
  emit-profile-list (xs) (i) =
    if i >= list-length xs then ""
    else let sep = if i > 0 then ",\n  " else "\n  "
    in sep & emit-body-profile (list-at xs i) & emit-profile-list xs (i + 1)

  emit-all-profiles : List FishProfile -> Text
  emit-all-profiles (xs) =
    "const FISH_BODY_PROFILES={" & emit-profile-list xs 0 & "\n};\n"

Section: Decor Emit

  emit-decor : DecorSprite -> Text
  emit-decor (d) =
    "{tex:'" & d.ds-tex & "',x:" & emit-int-100 d.ds-x
    & ",y:" & emit-int-100 d.ds-y
    & ",z:" & emit-int-100 d.ds-z
    & ",w:" & emit-int-100 d.ds-w
    & ",h:" & emit-int-100 d.ds-h & "}"

  emit-decor-list : List DecorSprite, Integer -> Text
  emit-decor-list (xs) (i) =
    if i >= list-length xs then ""
    else let sep = if i > 0 then ",\n  " else "\n  "
    in sep & emit-decor (list-at xs i) & emit-decor-list xs (i + 1)

  emit-all-decor : List DecorSprite -> Text
  emit-all-decor (xs) =
    "const FG_SPRITES=[" & emit-decor-list xs 0 & "\n];\n"

Section: Spawn Emit

  emit-spawn : SpawnOrder -> Text
  emit-spawn (s) =
    "{si:" & show s.so-species-idx & ",n:" & show s.so-count & "}"

  emit-spawn-list : List SpawnOrder, Integer -> Text
  emit-spawn-list (xs) (i) =
    if i >= list-length xs then ""
    else let sep = if i > 0 then "," else ""
    in sep & emit-spawn (list-at xs i) & emit-spawn-list xs (i + 1)

  emit-all-spawns : List SpawnOrder -> Text
  emit-all-spawns (xs) =
    "const SPAWNS=[" & emit-spawn-list xs 0 & "];\n"

Section: Tank Emit

  emit-tank : TankBounds -> Text
  emit-tank (t) =
    "const TANK={xMin:" & emit-int-100 t.tb-xmin
    & ",xMax:" & emit-int-100 t.tb-xmax
    & ",yMin:" & emit-int-100 t.tb-ymin
    & ",yMax:" & emit-int-100 t.tb-ymax
    & ",zMin:" & emit-int-100 t.tb-zmin
    & ",zMax:" & emit-int-100 t.tb-zmax & "};\n"

Section: Scene Emit

  emit-scene-constants : AquariumScene -> Text
  emit-scene-constants (aq) =
    "'use strict';\n"
    & emit-tank aq.aq-tank
    & "const MAX_FISH=" & show aq.aq-max-fish & ";\n"
    & "const MAX_PARTICLES=" & show aq.aq-max-particles & ";\n"
    & emit-all-species (let profiles = aq.aq-profiles in build-species-list profiles 0)
    & emit-all-profiles aq.aq-profiles
    & emit-all-decor aq.aq-decor
    & emit-all-spawns aq.aq-spawns

  build-species-list : List FishProfile, Integer -> List FishSpecies
  build-species-list (ps) (i) =
    if i >= list-length ps then []
    else (list-at ps i).fp-species :: build-species-list ps (i + 1)

Section: Full Page Emit

  emit-html-head : Text
  emit-html-head =
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    & "<meta charset=\"utf-8\">\n"
    & "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    & "<title>Codex Aquarium</title>\n"
    & "<style>" & fishtank-css & "</style>\n"
    & "</head>\n"

  emit-html-body-start : Text
  emit-html-body-start =
    "<body>\n"
    & "<canvas id=\"c\"></canvas>\n"
    & "<div id=\"status\">Initializing WebGPU...</div>\n"
    & "<div class=\"hud\"><div class=\"hud-left\">"
    & "<span class=\"hud-brand\">CODEX AQUARIUM</span>"
    & "<span class=\"hud-stat\"><span id=\"fish-count\">0</span></span>"
    & "<span class=\"hud-stat\">Temp <span id=\"temp\">76.5&#xB0;F</span></span>"
    & "<span class=\"hud-stat\"><span id=\"tod\">Day</span></span>"
    & "</div><div class=\"hud-right\">"
    & "<span class=\"hud-stat\"><span id=\"fps\">--</span></span>"
    & "</div></div>\n"
    & "<div class=\"species-bar\" id=\"species\"></div>\n"
    & "<div class=\"controls\">"
    & "<button class=\"ctrl-btn\" onclick=\"feedFish()\">Feed</button>"
    & "<button class=\"ctrl-btn\" onclick=\"tapGlass()\">Tap Glass</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" onclick=\"toggleLight()\">Light</button>"
    & "<div class=\"ctrl-sep\"></div>"
    & "<button class=\"ctrl-btn\" onclick=\"toggleAddMenu()\">Add Fish</button>"
    & "</div>\n"

  emit-add-menu : List FishSpecies, Integer -> Text
  emit-add-menu (xs) (i) =
    if i >= list-length xs then ""
    else let sp = list-at xs i
    in "<div class=\"add-option\" onclick=\"addFishByName('" & sp.sp-name & "');hideAddMenu()\">" & sp.sp-name & "</div>\n"
    & emit-add-menu xs (i + 1)

  emit-html-menu : List FishSpecies -> Text
  emit-html-menu (xs) =
    "<div class=\"add-menu\" id=\"add-menu\">\n"
    & emit-add-menu xs 0
    & "</div>\n"
    & "<script>function toggleAddMenu(){document.getElementById('add-menu').classList.toggle('open');}function hideAddMenu(){document.getElementById('add-menu').classList.remove('open');}document.addEventListener('click',function(e){if(!e.target.closest('.add-menu')&&!e.target.closest('[onclick*=\"toggleAddMenu\"]'))hideAddMenu();});</script>\n"

Section: Opening

  opening : [Console] None
  opening =
   let scene = aquarium-scene
   in let species = build-species-list scene.aq-profiles 0
   in act
    print-line-uni emit-html-head
    print-line-uni emit-html-body-start
    print-line-uni (emit-html-menu species)
    print-line-uni "<script src=\"fishtank.js\"></script>"
    print-line-uni "</body>\n</html>"
   end

