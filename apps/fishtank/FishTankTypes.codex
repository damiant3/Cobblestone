Chapter: FishTankTypes
  cites Foreword chapter Maybe

 Domain types for the Codex Aquarium. These records define the
 scene model -- species, body profiles, fins, decorations, tank
 geometry. The emitter walks these to produce JavaScript.

Section: Species

  FishSpecies = record {
    sp-name : Text,
    sp-tex : Text,
    sp-w : Integer,
    sp-h : Integer,
    sp-speed : Integer,
    sp-turn : Integer,
    sp-school : Integer,
    sp-sep : Integer,
    sp-align : Integer,
    sp-coh : Integer,
    sp-solo : Boolean
  }

Section: Body Geometry

  BodyStation = record {
    st-t : Integer,
    st-ry : Integer,
    st-rz : Integer
  }

  FinDef = record {
    fin-start : Integer,
    fin-end : Integer,
    fin-height : Integer
  }

  TailDef = record {
    tail-h : Integer,
    tail-fork : Integer
  }

  FishBody = record {
    fb-stations : List BodyStation,
    fb-dorsal : Maybe FinDef,
    fb-anal : Maybe FinDef,
    fb-tail : Maybe TailDef
  }

  FishProfile = record {
    fp-species : FishSpecies,
    fp-body : FishBody
  }

Section: Scene Layout

  DecorSprite = record {
    ds-tex : Text,
    ds-x : Integer,
    ds-y : Integer,
    ds-z : Integer,
    ds-w : Integer,
    ds-h : Integer
  }

  TankBounds = record {
    tb-xmin : Integer,
    tb-xmax : Integer,
    tb-ymin : Integer,
    tb-ymax : Integer,
    tb-zmin : Integer,
    tb-zmax : Integer
  }

  SpawnOrder = record {
    so-species-idx : Integer,
    so-count : Integer
  }

  AquariumScene = record {
    aq-tank : TankBounds,
    aq-profiles : List FishProfile,
    aq-decor : List DecorSprite,
    aq-spawns : List SpawnOrder,
    aq-max-fish : Integer,
    aq-max-particles : Integer
  }

Section: Creature Database

 Schema for the creature asset pipeline. A CreatureRecord is the
 complete specification for generating, texturing, rigging, and
 rendering one aquatic creature. It carries enough information to
 drive the full pipeline: reference image generation (prompt +
 body plan), mesh generation (TripoSR params), per-part texture
 baking (diffuse + normal + specular per sub-unit), rig definition
 (bone chain + fin attachment), and runtime behavior (boids params
 + animation curves). Keyed by common name for full-text lookup;
 indexed by taxonomy for browsing.

  CreatureKind =
    | CkFish
    | CkInvertebrate
    | CkCoral
    | CkPlant
    | CkRock

  SubUnitKind =
    | SuBody
    | SuDorsalFin
    | SuAnalFin
    | SuTailFin
    | SuPectoralFin
    | SuEye
    | SuMouth
    | SuGill
    | SuTentacle
    | SuBase

  TextureSlot =
    | TsDiffuse
    | TsNormal
    | TsSpecular
    | TsAlpha
    | TsEmissive

  TextureSpec = record {
    ts-slot : TextureSlot,
    ts-prompt : Text,
    ts-width : Integer,
    ts-height : Integer,
    ts-model : Text,
    ts-path : Text
  }

  SubUnit = record {
    su-kind : SubUnitKind,
    su-label : Text,
    su-textures : List TextureSpec,
    su-transparent : Boolean,
    su-double-sided : Boolean,
    su-bone-name : Text,
    su-anim-type : Text
  }

  RigBone = record {
    rb-name : Text,
    rb-parent : Text,
    rb-offset-x : Integer,
    rb-offset-y : Integer,
    rb-offset-z : Integer
  }

  BoidParams = record {
    bp-speed : Integer,
    bp-turn-rate : Integer,
    bp-school-size : Integer,
    bp-separation : Integer,
    bp-alignment : Integer,
    bp-cohesion : Integer,
    bp-solo : Boolean
  }

  AnimCurve = record {
    ac-name : Text,
    ac-bone : Text,
    ac-axis : Text,
    ac-amplitude : Integer,
    ac-frequency : Integer,
    ac-phase : Integer
  }

  CreatureRecord = record {
    cr-name : Text,
    cr-scientific : Text,
    cr-kind : CreatureKind,
    cr-family : Text,
    cr-description : Text,
    cr-ref-prompt : Text,
    cr-ref-negative : Text,
    cr-ref-model : Text,
    cr-body-stations : List BodyStation,
    cr-sub-units : List SubUnit,
    cr-rig : List RigBone,
    cr-boids : BoidParams,
    cr-animations : List AnimCurve,
    cr-mesh-path : Text,
    cr-texture-atlas : Text,
    cr-glb-path : Text,
    cr-width : Integer,
    cr-height : Integer,
    cr-status : Text
  }

Section: Database Schema

 Table definitions for the Data quire. The creature table is the
 primary store; full-text index on name + description + family for
 the search box. Texture and sub-unit tables are normalized out so
 the pipeline can query "all textures not yet baked" or "all
 sub-units needing rigs" without scanning creature records.

  creature-table-name : Text = "creatures"

  creature-columns : List Text =
    ["name", "scientific", "kind", "family", "description",
     "ref_prompt", "ref_negative", "ref_model",
     "mesh_path", "texture_atlas", "glb_path",
     "width", "height", "status"]

  texture-table-name : Text = "creature_textures"

  texture-columns : List Text =
    ["creature_name", "sub_unit", "slot", "prompt",
     "width", "height", "model", "path", "status"]

  pipeline-stage-names : List Text =
    ["reference", "mesh", "segment", "texture", "rig", "bake", "export"]

