Chapter: FishTankCss

Section: Styles

  fishtank-css : Text =
    "*{margin:0;padding:0;box-sizing:border-box}"
    & "body{background:#000;color:#e0e0e0;font-family:system-ui,-apple-system,sans-serif;overflow:hidden;height:100vh}"
    & "canvas{position:fixed;top:0;left:0;width:100%;height:100%;display:block}"
    & ".hud{position:fixed;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:8px 16px;background:linear-gradient(180deg,rgba(0,0,0,0.6),transparent);pointer-events:none;z-index:10;font-size:12px}"
    & ".hud-left{display:flex;align-items:center;gap:16px}"
    & ".hud-brand{font-size:16px;font-weight:700;color:#5ac8fa;letter-spacing:2px}"
    & ".hud-stat{color:rgba(255,255,255,0.5)}.hud-stat span{color:rgba(255,255,255,0.8);font-weight:600}"
    & ".hud-right{display:flex;gap:12px}"
    & ".controls{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;background:linear-gradient(0deg,rgba(0,0,0,0.6),transparent);z-index:10}"
    & ".ctrl-btn{background:rgba(255,255,255,0.08);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.12);color:#e0e0e0;padding:8px 20px;border-radius:20px;cursor:pointer;font-size:13px;font-weight:500;transition:all 0.2s;display:flex;align-items:center;gap:6px;user-select:none}"
    & ".ctrl-btn:hover{background:rgba(255,255,255,0.15);border-color:rgba(255,255,255,0.25);transform:translateY(-1px)}"
    & ".ctrl-btn:active{transform:scale(0.97)}"
    & ".ctrl-btn .icon{font-size:16px}"
    & ".ctrl-sep{width:1px;height:24px;background:rgba(255,255,255,0.1)}"
    & ".species-bar{position:fixed;bottom:56px;left:0;right:0;text-align:center;padding:6px;z-index:10;font-size:11px;color:rgba(255,255,255,0.35);pointer-events:none}"
    & ".add-menu{position:fixed;bottom:60px;left:50%;transform:translateX(-50%);background:rgba(10,15,25,0.9);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:8px;z-index:20;display:none;min-width:180px}"
    & ".add-menu.open{display:block}"
    & ".add-option{padding:8px 14px;border-radius:6px;cursor:pointer;font-size:13px;color:#ccc;transition:background 0.1s}"
    & ".add-option:hover{background:rgba(255,255,255,0.1);color:#fff}"
    & "#status{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);font-size:12px;color:rgba(255,255,255,0.3);z-index:5;pointer-events:none}"

