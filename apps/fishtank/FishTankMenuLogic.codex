Chapter: FishTankMenuLogic

Section: Menu State

  toggle-add-menu : Integer -> Integer
  toggle-add-menu (x) =
    let el = dom-get-by-id "add-menu"
    in let t = dom-toggle-class el "open"
    in 0

  hide-add-menu : Integer -> Integer
  hide-add-menu (x) =
    let el = dom-get-by-id "add-menu"
    in let r = dom-remove-class el "open"
    in 0

Section: Action Dispatch

  dispatch-action : Text -> Integer
  dispatch-action (action) =
    if action == "feed" then feed-fish 0
    else if action == "tap" then tap-glass 0
    else if action == "light" then toggle-light 0
    else if action == "add" then toggle-add-menu 0
    else 0

  dispatch-species : Text -> Integer
  dispatch-species (name) =
    let a = add-fish-by-name name
    in hide-add-menu 0

Section: Event Handlers

  on-control-click : Integer -> Integer
  on-control-click (evt) =
    let target = dom-event-target evt
    in let btn = dom-closest target "[data-action]"
    in if dom-not-null btn then dispatch-action (dom-dataset-get btn "action")
    else 0

  on-species-click : Integer -> Integer
  on-species-click (evt) =
    let target = dom-event-target evt
    in let item = dom-closest target "[data-species]"
    in if dom-not-null item then dispatch-species (dom-dataset-get item "species")
    else 0

  on-outside-click : Integer -> Integer
  on-outside-click (evt) =
    let target = dom-event-target evt
    in let in-menu = dom-closest target ".add-menu"
    in let in-btn = dom-closest target "[data-action=\"add\"]"
    in if dom-not-null in-menu then 0
    else if dom-not-null in-btn then 0
    else hide-add-menu 0

Section: Setup

  setup-menu-events : Integer -> Integer
  setup-menu-events (x) =
    let controls = dom-query ".controls"
    in let menu = dom-query ".add-menu"
    in let doc = dom-document
    in let a = dom-on-click controls on-control-click
    in let b = dom-on-click menu on-species-click
    in let c = dom-on-click doc on-outside-click
    in 0

