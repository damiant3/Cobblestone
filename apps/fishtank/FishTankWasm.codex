Section: Body Profile Data

  station-count : Integer -> Integer
  station-count (species) = 9

  station-t : Integer, Integer -> Integer
  station-t (sp) (si) =
    if sp == 0 then list-at [0, 8, 20, 35, 50, 65, 80, 90, 100] si
    else if sp == 1 then list-at [0, 10, 25, 40, 55, 70, 85, 92, 100] si
    else if sp == 2 then list-at [0, 10, 25, 40, 55, 70, 85, 93, 100] si
    else if sp == 3 then list-at [0, 8, 22, 38, 55, 70, 85, 93, 100] si
    else if sp == 4 then list-at [0, 8, 20, 40, 60, 75, 88, 94, 100] si
    else if sp == 5 then list-at [0, 10, 25, 40, 55, 70, 82, 90, 100] si
    else if sp == 6 then list-at [0, 10, 25, 40, 55, 70, 85, 93, 100] si
    else list-at [0, 10, 25, 40, 55, 70, 85, 93, 100] si

  station-ry : Integer, Integer -> Integer
  station-ry (sp) (si) =
    if sp == 0 then list-at [1, 10, 18, 22, 20, 15, 6, 2, 12] si
    else if sp == 1 then list-at [1, 15, 35, 40, 35, 20, 4, 2, 18] si
    else if sp == 2 then list-at [1, 6, 10, 12, 10, 6, 2, 1, 6] si
    else if sp == 3 then list-at [1, 12, 28, 32, 28, 15, 3, 1, 14] si
    else if sp == 4 then list-at [1, 12, 35, 42, 35, 15, 3, 1, 10] si
    else if sp == 5 then list-at [1, 5, 8, 9, 7, 4, 2, 1, 10] si
    else if sp == 6 then list-at [1, 8, 12, 10, 8, 5, 3, 2, 1] si
    else list-at [1, 4, 6, 7, 6, 4, 3, 1, 5] si

  station-rz : Integer, Integer -> Integer
  station-rz (sp) (si) =
    if sp == 0 then list-at [1, 8, 12, 14, 12, 9, 3, 1, 0] si
    else if sp == 1 then list-at [1, 5, 7, 8, 7, 5, 2, 1, 0] si
    else if sp == 2 then list-at [1, 5, 8, 9, 7, 4, 1, 0, 0] si
    else if sp == 3 then list-at [1, 6, 9, 10, 8, 5, 1, 0, 0] si
    else if sp == 4 then list-at [1, 4, 6, 6, 5, 3, 1, 0, 0] si
    else if sp == 5 then list-at [1, 4, 6, 7, 5, 3, 1, 0, 0] si
    else if sp == 6 then list-at [1, 6, 8, 7, 6, 4, 2, 1, 1] si
    else list-at [1, 4, 6, 7, 6, 4, 3, 1, 0] si

