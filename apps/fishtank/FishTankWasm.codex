Section: Memory Access Helpers

  w32 : Integer, Integer -> Integer
  w32 (addr) (val) = poke-32 0 addr val

  rd : Integer -> Integer
  rd (addr) = peek-32 0 addr

  scratch-base : Integer = 270336

  scratch-write : Integer, Integer -> Integer
  scratch-write (slot) (val) = w32 (scratch-base + slot * 4) val

  scratch-read : Integer -> Integer
  scratch-read (slot) = rd (scratch-base + slot * 4)

  fish-count-get : Integer
  fish-count-get = rd 131072

  fish-count-set : Integer -> Integer
  fish-count-set (v) = w32 131072 v

  fish-get-x : Integer -> Integer
  fish-get-x (i) = rd (131076 + i * 4)

