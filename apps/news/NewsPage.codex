 We say:

Section: Theme

  news-theme : Theme
  news-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 16744448, pal-secondary = 1447446, pal-accent = 16744448, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "news-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  news-css : Text
  news-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0f0f0f;color:#e1e1e1;font-family:Georgia,'Times New Roman',serif;min-height:100vh}#app{display:contents}"
    & ".news{display:grid;grid-template-columns:240px 1fr;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;font-family:system-ui,sans-serif;color:#ff8c00}"
    & ".feed-group{margin-bottom:8px}"
    & ".feed-group-title{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px;font-family:system-ui,sans-serif}"
    & ".feed-item{padding:8px 20px;cursor:pointer;font-size:13px;color:#999;transition:background .1s;font-family:system-ui,sans-serif;display:flex;align-items:center;gap:8px}"
    & ".feed-item:hover{background:#1a1a1a;color:#ddd}"
    & ".feed-item.active{background:#1f1a10;color:#ff8c00;border-right:2px solid #ff8c00}"
    & ".feed-badge{background:#ff8c00;color:#000;font-size:10px;font-weight:700;border-radius:10px;padding:1px 6px;margin-left:auto}"
    & ".main{overflow-y:auto}"
    & ".main-hdr{padding:20px 24px;border-bottom:1px solid #222;display:flex;align-items:center;justify-content:space-between;font-family:system-ui,sans-serif}"
    & ".main-title{font-size:18px;font-weight:600}"
    & ".view-btns{display:flex;gap:4px}"
    & ".view-btns .wk-btn{background:none;border:1px solid #333;color:#888;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".refresh-btn{background:none;border:1px solid #333;color:#888;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:14px;margin-left:8px}"
    & ".refresh-btn:hover{border-color:#ff8c00;color:#ff8c00}"
    & ".article-list{padding:8px 0}"
    & ".article{padding:16px 24px;border-bottom:1px solid #1a1a1a;cursor:pointer;transition:background .1s;display:grid;grid-template-columns:1fr auto 120px;gap:16px;align-items:start}"
    & ".article:hover{background:#161616}"
    & ".article.unread .article-title{color:#fff;font-weight:700}"
    & ".article-meta{font-size:11px;color:#666;margin-bottom:6px;font-family:system-ui,sans-serif;display:flex;gap:8px;align-items:center}"
    & ".article-source{color:#ff8c00}"
    & ".article-title{font-size:17px;font-weight:600;color:#eee;line-height:1.4;margin-bottom:6px}"
    & ".article-excerpt{font-size:14px;color:#888;line-height:1.6}"
    & ".article-thumb{width:120px;height:80px;border-radius:8px;background:#222;display:flex;align-items:center;justify-content:center;font-size:32px;flex-shrink:0}"
    & ".bm-icon{font-size:18px;cursor:pointer;color:#555;padding:8px;align-self:center;transition:color .15s}"
    & ".bm-icon:hover{color:#ff8c00}"
    & ".bm-icon.bookmarked{color:#ff8c00}"
    & ".reading{padding:32px 24px;max-width:680px;margin:0 auto}"
    & ".reading-bar{display:flex;align-items:center;gap:12px;margin-bottom:20px;font-family:system-ui,sans-serif}"
    & ".reading-back{font-size:13px;color:#ff8c00;cursor:pointer}"
    & ".reading-spacer{flex:1}"
    & ".reading-bm{font-size:18px;cursor:pointer;color:#555;transition:color .15s}"
    & ".reading-bm.bookmarked{color:#ff8c00}"
    & ".reading-share{font-size:13px;color:#888;cursor:pointer;border:1px solid #333;border-radius:6px;padding:4px 10px}"
    & ".reading-share:hover{color:#ff8c00;border-color:#ff8c00}"
    & ".font-btn{font-size:13px;color:#888;cursor:pointer;border:1px solid #333;border-radius:6px;padding:4px 10px}"
    & ".font-btn:hover{color:#ff8c00;border-color:#ff8c00}"
    & ".reading-source{font-size:12px;color:#ff8c00;margin-bottom:8px;font-family:system-ui,sans-serif}"
    & ".reading-title{font-size:28px;font-weight:700;line-height:1.3;margin-bottom:12px;color:#fff}"
    & ".reading-date{font-size:13px;color:#666;margin-bottom:24px;font-family:system-ui,sans-serif}"
    & ".reading-body{font-size:17px;line-height:1.8;color:#ccc}"
    & ".reading-body p{margin-bottom:16px}"
    & ".font-small .reading-body{font-size:14px;line-height:1.7}"
    & ".font-large .reading-body{font-size:20px;line-height:1.9}"
    & ".font-small .reading-title{font-size:24px}"
    & ".font-large .reading-title{font-size:34px}"
    & ".related{margin-top:32px;padding-top:24px;border-top:1px solid #222}"
    & ".related-hdr{font-size:14px;font-weight:600;color:#999;margin-bottom:12px;font-family:system-ui,sans-serif;text-transform:uppercase;letter-spacing:1px}"
    & ".related-item{padding:10px 0;border-bottom:1px solid #1a1a1a;cursor:pointer}"
    & ".related-item:hover .related-title{color:#ff8c00}"
    & ".related-title{font-size:15px;color:#ddd;line-height:1.4}"
    & ".related-src{font-size:11px;color:#666;margin-top:4px;font-family:system-ui,sans-serif}"
    & ".cat-entertainment .feed-badge{background:#e040fb}"
    & ".cat-local .feed-badge{background:#26c6da}"
    & ".unread-dot{width:6px;height:6px;border-radius:50%;background:#ff8c00;flex-shrink:0}"

Section: Article Data

  art-count : Integer
  art-count = 16

  art-source : Integer -> Text
  art-source (n) =
    if n == 0 then "Reuters" else if n == 1 then "Ars Technica" else if n == 2 then "Nature"
    else if n == 3 then "AP News" else if n == 4 then "Reuters" else if n == 5 then "Ars Technica"
    else if n == 6 then "Nature" else if n == 7 then "AP News"
    else if n == 8 then "ESPN" else if n == 9 then "WebMD"
    else if n == 10 then "Variety" else if n == 11 then "Local Tribune"
    else if n == 12 then "Reuters" else if n == 13 then "Nature"
    else if n == 14 then "Variety" else "Local Tribune"

  art-time : Integer -> Text
  art-time (n) =
    if n == 0 then "2h ago" else if n == 1 then "3h ago" else if n == 2 then "5h ago"
    else if n == 3 then "6h ago" else if n == 4 then "8h ago" else if n == 5 then "10h ago"
    else if n == 6 then "12h ago" else if n == 7 then "14h ago"
    else if n == 8 then "1h ago" else if n == 9 then "4h ago"
    else if n == 10 then "2h ago" else if n == 11 then "7h ago"
    else if n == 12 then "9h ago" else if n == 13 then "11h ago"
    else if n == 14 then "5h ago" else "3h ago"

  art-icon : Integer -> Text
  art-icon (n) =
    if n == 0 then "&#x1F30D;" else if n == 1 then "&#x1F4BB;" else if n == 2 then "&#x1F52C;"
    else if n == 3 then "&#x1F4C8;" else if n == 4 then "&#x1F30A;" else if n == 5 then "&#x1F4E6;"
    else if n == 6 then "&#x269B;" else if n == 7 then "&#x1F680;"
    else if n == 8 then "&#x26BD;" else if n == 9 then "&#x1F3E5;"
    else if n == 10 then "&#x1F3AC;" else if n == 11 then "&#x1F3D8;"
    else if n == 12 then "&#x1F30D;" else if n == 13 then "&#x1F52C;"
    else if n == 14 then "&#x1F3B5;" else "&#x1F3D8;"

  art-title : Integer -> Text
  art-title (n) =
    if n == 0 then "Global Summit Reaches Historic Climate Agreement"
    else if n == 1 then "New Processor Architecture Breaks Performance Records"
    else if n == 2 then "CRISPR Breakthrough Enables Single-Cell Genome Editing"
    else if n == 3 then "Central Banks Signal Coordinated Rate Adjustments"
    else if n == 4 then "Deep Ocean Expedition Discovers New Hydrothermal Ecosystem"
    else if n == 5 then "Open Source Foundation Launches Universal Package Standard"
    else if n == 6 then "Quantum Error Correction Reaches Practical Threshold"
    else if n == 7 then "International Space Station Successor Module Completes Testing"
    else if n == 8 then "World Cup Qualifying Upsets Shake Group Standings"
    else if n == 9 then "New Study Links Gut Microbiome to Cognitive Health"
    else if n == 10 then "Streaming Wars Heat Up With Three Major Platform Launches"
    else if n == 11 then "City Council Approves Downtown Transit Expansion Plan"
    else if n == 12 then "Trade Negotiations Resume Between Pacific Rim Nations"
    else if n == 13 then "Fusion Reactor Sustains Plasma for Record Duration"
    else if n == 14 then "Award Season Predictions Shift After Festival Premieres"
    else "Local Schools Pilot AI Tutoring Program in Fall Semester"

  art-excerpt : Integer -> Text
  art-excerpt (n) =
    if n == 0 then "World leaders finalized a binding commitment to reduce carbon emissions by 60% before 2035, marking the most ambitious climate accord in history."
    else if n == 1 then "The novel chip design uses photonic interconnects to achieve 4x throughput improvement over current generation silicon, with half the power draw."
    else if n == 2 then "Researchers demonstrate precise editing of individual cells in living tissue without affecting neighboring cells, opening new therapeutic possibilities."
    else if n == 3 then "Major economies prepare synchronized monetary policy shifts as inflation metrics converge toward target ranges across developed markets."
    else if n == 4 then "A previously unknown community of organisms found thriving at extreme depths challenges current understanding of life in extreme environments."
    else if n == 5 then "The new specification aims to unify package management across all programming languages with cryptographic provenance verification."
    else if n == 6 then "A team achieves logical qubit error rates below the threshold needed for useful quantum computation, a milestone decades in the making."
    else if n == 7 then "The first module of the next-generation orbital platform passes all structural and environmental qualification tests ahead of launch."
    else if n == 8 then "Underdogs topple group favorites in a dramatic round of qualifying matches, reshuffling predictions for the tournament bracket."
    else if n == 9 then "A large-scale longitudinal study finds strong correlations between gut flora diversity and long-term memory retention in adults over fifty."
    else if n == 10 then "Three major studios unveil competing streaming services within weeks of each other, intensifying the battle for subscriber attention."
    else if n == 11 then "The approved plan adds twelve miles of light rail and three new bus rapid transit corridors to serve the growing metropolitan area."
    else if n == 12 then "Diplomats return to the table after a six-month pause, with tariff reductions and intellectual property protections as key agenda items."
    else if n == 13 then "Engineers sustain a fusion plasma at 150 million degrees for over eight minutes, doubling the previous endurance record."
    else if n == 14 then "Critics and industry insiders recalibrate their Oscar forecasts following surprise hits at Venice and Toronto film festivals."
    else "The district launches a pilot program bringing AI-powered personalized tutoring to five elementary schools starting this autumn."

  art-category : Integer -> Integer
  art-category (n) =
    if n == 0 then 3 else if n == 1 then 1 else if n == 2 then 2
    else if n == 3 then 4 else if n == 4 then 3 else if n == 5 then 1
    else if n == 6 then 2 else if n == 7 then 1
    else if n == 8 then 5 else if n == 9 then 6
    else if n == 10 then 7 else if n == 11 then 8
    else if n == 12 then 3 else if n == 13 then 2
    else if n == 14 then 7 else 8

  art-body : Integer -> Text
  art-body (n) =
    if n == 0 then "<p>The agreement, signed by 194 nations at the Global Climate Summit in Geneva, establishes legally binding targets that exceed all prior commitments. Independent monitoring bodies will track compliance on a quarterly basis.</p><p>Environmental groups have praised the accord as a turning point, though some economists warn that the aggressive timeline could strain emerging economies without sufficient financial support mechanisms in place.</p><p>Implementation begins in January, with each nation required to submit detailed decarbonization roadmaps within ninety days of ratification.</p>"
    else if n == 1 then "<p>The architecture, developed over four years at a research lab in Zurich, replaces traditional copper interconnects with on-chip photonic waveguides. Early benchmarks show a fourfold improvement in throughput per watt.</p><p>Industry analysts predict the design could reach mass production within three years, pending resolution of manufacturing yield challenges at the 3nm process node.</p><p>Several major cloud providers have already expressed interest in adopting the technology for next-generation data center hardware.</p>"
    else if n == 2 then "<p>The technique uses a modified CRISPR-Cas9 complex with an engineered guide RNA that activates only upon binding to a specific cell-surface marker. This selectivity allows editing of target cells without disturbing their neighbors.</p><p>In preclinical trials, the approach corrected a genetic defect in liver cells of mice with 94% efficiency and zero detectable off-target edits in adjacent tissue.</p><p>Researchers plan to begin Phase I human safety trials within eighteen months, focusing initially on rare monogenic liver disorders.</p>"
    else "<p>" & art-excerpt n & "</p><p>Further details are still emerging as reporters on the ground continue to gather information from officials and experts involved in the story.</p><p>This is a developing story. Check back for updates as more information becomes available throughout the day.</p>"

  cat-name : Integer -> Text
  cat-name (n) =
    if n == 0 then "All Articles" else if n == 1 then "Technology" else if n == 2 then "Science"
    else if n == 3 then "World" else if n == 4 then "Business" else if n == 5 then "Sports"
    else if n == 6 then "Health" else if n == 7 then "Entertainment" else "Local"

  cat-count : Integer -> Integer
  cat-count (cat) = count-cat-loop 0 art-count cat 0

  count-cat-loop : Integer, Integer, Integer, Integer -> Integer
  count-cat-loop (i) (n) (cat) (acc) =
    if i >= n then acc
    else if art-category i == cat then count-cat-loop (i + 1) n cat (acc + 1)
    else count-cat-loop (i + 1) n cat acc

  total-unread : Integer -> Integer
  total-unread (x) = count-unread-loop 0 art-count 0

  count-unread-loop : Integer, Integer, Integer -> Integer
  count-unread-loop (i) (n) (acc) =
    if i >= n then acc
    else if state-get ("read-" & show i) == 0 then count-unread-loop (i + 1) n (acc + 1)
    else count-unread-loop (i + 1) n acc

  total-bookmarks : Integer -> Integer
  total-bookmarks (x) = count-bm-loop 0 art-count 0

  count-bm-loop : Integer, Integer, Integer -> Integer
  count-bm-loop (i) (n) (acc) =
    if i >= n then acc
    else if state-get ("bm-" & show i) == 1 then count-bm-loop (i + 1) n (acc + 1)
    else count-bm-loop (i + 1) n acc

  font-class : Integer -> Text
  font-class (n) =
    if n == 0 then "font-small" else if n == 2 then "font-large" else ""

  est-word-count : Integer -> Integer
  est-word-count (n) =
    let ex = text-length (art-excerpt n)
    in let body-len = text-length (art-body n)
    in (ex + body-len) / 6

  est-reading-time : Integer -> Integer
  est-reading-time (n) =
    let wc = est-word-count n
    in let mins = wc / 200
    in if mins < 1 then 1 else mins

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let view = state-get "reading"
    in widget-box "news" "news" [
      sidebar-tree 0,
      if view == 1 then reading-view 0 else feed-view 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    let cat = state-get "category"
    in let ur = total-unread 0
    in let bms = total-bookmarks 0
    in let saved-view = state-get "saved-view"
    in widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexNews",
      feed-group "fav" "Favorites" [
        feed-item-active "f-all" ("&#x1F4F0; All Articles") (show ur) (if cat == 0 then 1 else 0) (if saved-view == 0 then 1 else 0),
        feed-item-active "f-saved" ("&#x2B50; Saved") (if bms > 0 then show bms else "") 0 (if saved-view == 1 then 1 else 0),
        feed-item "f-recent" "&#x1F552; Recent" ""
      ],
      feed-group "cat" "Categories" [
        feed-item-active "f-tech" "&#x1F4BB; Technology" (show (cat-count 1)) (if cat == 1 then 1 else 0) 0,
        feed-item-active "f-sci" "&#x1F52C; Science" (show (cat-count 2)) (if cat == 2 then 1 else 0) 0,
        feed-item-active "f-world" "&#x1F30D; World" (show (cat-count 3)) (if cat == 3 then 1 else 0) 0,
        feed-item-active "f-biz" "&#x1F4C8; Business" (show (cat-count 4)) (if cat == 4 then 1 else 0) 0,
        feed-item-active "f-sports" "&#x26BD; Sports" (show (cat-count 5)) (if cat == 5 then 1 else 0) 0,
        feed-item-active "f-health" "&#x1F3E5; Health" (show (cat-count 6)) (if cat == 6 then 1 else 0) 0,
        feed-item-active "f-ent" "&#x1F3AC; Entertainment" (show (cat-count 7)) (if cat == 7 then 1 else 0) 0,
        feed-item-active "f-local" "&#x1F3D8; Local" (show (cat-count 8)) (if cat == 8 then 1 else 0) 0
      ],
      feed-group "src" "Sources" [
        feed-item "f-reuters" "Reuters" "",
        feed-item "f-ap" "AP News" "",
        feed-item "f-ars" "Ars Technica" "",
        feed-item "f-nature" "Nature" ""
      ]
    ]

  feed-group : Text, Text, List WidgetNode -> WidgetNode
  feed-group (id) (title) (items) =
    widget-box id "feed-group" (widget-label (id & "t") title :: items)

  feed-item : Text, Text, Text -> WidgetNode
  feed-item (id) (label) (badge) =
    if text-length badge > 0
    then widget-box-click id "feed-item" [
      widget-label (id & "l") label,
      widget-label (id & "b") badge
    ]
    else widget-box-click id "feed-item" [
      widget-label (id & "l") label
    ]

  feed-item-active : Text, Text, Text, Integer, Integer -> WidgetNode
  feed-item-active (id) (label) (badge) (is-active) (is-active2) =
    let cls = if is-active == 1 then "feed-item active"
              else if is-active2 == 1 then "feed-item active"
              else "feed-item"
    in if text-length badge > 0
    then widget-box-click id cls [
      widget-label (id & "l") label,
      widget-label (id & "b") badge
    ]
    else widget-box-click id cls [
      widget-label (id & "l") label
    ]

  feed-view : Integer -> WidgetNode
  feed-view (x) =
    let cat = state-get "category"
    in let saved = state-get "saved-view"
    in let ur = total-unread 0
    in let hdr-text = if saved == 1 then "Saved Articles" else cat-name cat & " (" & show ur & " unread)"
    in widget-box "main" "main" [
      widget-box "main-hdr" "main-hdr" [
        widget-label "main-title" hdr-text,
        widget-box "hdr-actions" "view-btns" [
          widget-button "btn-refresh" "&#x21BB; Refresh",
          widget-button "btn-list" "List",
          widget-button "btn-cards" "Cards"
        ]
      ],
      if saved == 1 then bookmarked-list 0 else article-list 0
    ]

  article-list : Integer -> WidgetNode
  article-list (x) =
    let cat = state-get "category"
    in widget-box "articles" "article-list" (build-filtered-articles 0 art-count cat [])

  build-filtered-articles : Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  build-filtered-articles (i) (n) (cat) (acc) =
    if i >= n then acc
    else if cat == 0 then build-filtered-articles (i + 1) n cat (list-push acc (article-row i))
    else if art-category i == cat then build-filtered-articles (i + 1) n cat (list-push acc (article-row i))
    else build-filtered-articles (i + 1) n cat acc

  bookmarked-list : Integer -> WidgetNode
  bookmarked-list (x) =
    widget-box "articles" "article-list" (build-bookmarked 0 art-count [])

  build-bookmarked : Integer, Integer, List WidgetNode -> List WidgetNode
  build-bookmarked (i) (n) (acc) =
    if i >= n then acc
    else if state-get ("bm-" & show i) == 1 then build-bookmarked (i + 1) n (list-push acc (article-row i))
    else build-bookmarked (i + 1) n acc

  article-row : Integer -> WidgetNode
  article-row (n) =
    let id = "a" & show n
    in let is-read = state-get ("read-" & show n)
    in let is-bm = state-get ("bm-" & show n)
    in let row-cls = if is-read == 0 then "article unread" else "article"
    in let bm-cls = if is-bm == 1 then "bm-icon bookmarked" else "bm-icon"
    in widget-box-click id row-cls [
      widget-box (id & "b") "" [
        widget-box (id & "m") "article-meta" [
          widget-label (id & "src") (art-source n),
          widget-label (id & "tm") ("&#x2022; " & art-time n & " &#x2022; " & show (est-reading-time n) & " min"),
          if is-read == 0 then widget-box (id & "dot") "unread-dot" [] else widget-label (id & "dot") ""
        ],
        widget-label (id & "t") (art-title n),
        widget-label (id & "ex") (art-excerpt n)
      ],
      widget-box-click ("bm" & show n) bm-cls [
        widget-label ("bmi" & show n) (if is-bm == 1 then "&#x2605;" else "&#x2606;")
      ],
      widget-label (id & "th") (art-icon n)
    ]

  reading-view : Integer -> WidgetNode
  reading-view (x) =
    let sel = state-get "selected-article"
    in let fs = state-get "font-size"
    in let fc = font-class fs
    in let is-bm = state-get ("bm-" & show sel)
    in let bm-cls = if is-bm == 1 then "reading-bm bookmarked" else "reading-bm"
    in let fs-label = if fs == 0 then "Aa+" else if fs == 2 then "Aa-" else "Aa"
    in widget-box "reading-wrap" ("reading " & fc) [
      widget-box "reading-bar" "reading-bar" [
        widget-button "back" "&#x2190; Back",
        widget-box "rspacer" "reading-spacer" [],
        widget-button "btn-font" fs-label,
        widget-box-click ("rbm" & show sel) bm-cls [
          widget-label "rbmi" (if is-bm == 1 then "&#x2605;" else "&#x2606;")
        ],
        widget-button "btn-share" (if state-get "share-feedback" == 1 then "&#x2713; Copied!" else "&#x2197; Share")
      ],
      widget-label "r-src" (art-source sel),
      widget-label "r-title" (art-title sel),
      widget-label "r-date" (art-time sel & " &#x2022; " & show (est-reading-time sel) & " min read &#x2022; " & show (est-word-count sel) & " words"),
      widget-box "r-body" "reading-body" [
        widget-label "r-p1" (art-body sel)
      ],
      related-section sel
    ]

  related-section : Integer -> WidgetNode
  related-section (sel) =
    let cat = art-category sel
    in widget-box "related" "related" [
      widget-label "rel-hdr" "Related Articles",
      widget-box "rel-list" "" (build-related 0 art-count sel cat 0 [])
    ]

  build-related : Integer, Integer, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  build-related (i) (n) (sel) (cat) (found) (acc) =
    if i >= n then acc
    else if found >= 3 then acc
    else if i == sel then build-related (i + 1) n sel cat found acc
    else if art-category i == cat then
      let item = widget-box-click ("rel" & show i) "related-item" [
        widget-label ("relt" & show i) (art-title i),
        widget-label ("rels" & show i) (art-source i & " &#x2022; " & art-time i)
      ]
      in build-related (i + 1) n sel cat (found + 1) (list-push acc item)
    else build-related (i + 1) n sel cat found acc

Section: Helpers

  id-num : Text -> Integer
  id-num (id) =
    let len = text-length id
    in let c1 = if is-digit (char-at id (len - 1)) then digit-value (char-at id (len - 1)) else 0
    in if len >= 2 then
      if is-digit (char-at id (len - 2)) then digit-value (char-at id (len - 2)) * 10 + c1
      else c1
    else c1

Section: Handlers

  news-click : Text -> Integer
  news-click (id) =
    if id == "back" then
      let s = state-set "share-feedback" 0
      in let s2 = state-set-render "reading" 0
      in 0
    else if id == "btn-refresh" then
      let s = state-set-render "category" (state-get "category")
      in 0
    else if id == "btn-font" then
      let fs = state-get "font-size"
      in let nxt = if fs == 0 then 1 else if fs == 1 then 2 else 0
      in let s = state-set-render "font-size" nxt
      in 0
    else if id == "btn-share" then let s = state-set-render "share-feedback" 1 in 0
    else if id == "btn-list" then let s = state-set-render "view-mode" 0 in 0
    else if id == "btn-cards" then let s = state-set-render "view-mode" 1 in 0
    else if id == "f-all" then
      let s = state-set "saved-view" 0
      in let s2 = state-set-render "category" 0
      in 0
    else if id == "f-saved" then
      let s = state-set "category" 0
      in let s2 = state-set-render "saved-view" 1
      in 0
    else if id == "f-tech" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 1 in 0
    else if id == "f-sci" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 2 in 0
    else if id == "f-world" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 3 in 0
    else if id == "f-biz" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 4 in 0
    else if id == "f-sports" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 5 in 0
    else if id == "f-health" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 6 in 0
    else if id == "f-ent" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 7 in 0
    else if id == "f-recent" then
      let s = state-set "saved-view" 0
      in let s2 = state-set-render "recent-filter" 1
      in 0
    else if id == "f-local" then
      let s = state-set "saved-view" 0 in let s2 = state-set-render "category" 8 in 0
    else if text-starts-with id "rbm" then
      let idx = id-num id
      in let cur = state-get ("bm-" & show idx)
      in let nv = if cur == 1 then 0 else 1
      in let s = state-set-render ("bm-" & show idx) nv
      in 0
    else if text-starts-with id "bm" then
      let idx = id-num id
      in let cur = state-get ("bm-" & show idx)
      in let nv = if cur == 1 then 0 else 1
      in let s = state-set-render ("bm-" & show idx) nv
      in 0
    else if text-starts-with id "rel" then
      let idx = id-num id
      in let s = state-set ("read-" & show idx) 1
      in let s2 = state-set-render "selected-article" idx
      in 0
    else if text-starts-with id "a" then
      let idx = id-num id
      in let s = state-set ("read-" & show idx) 1
      in let s2 = state-set "selected-article" idx
      in let s3 = state-set "share-feedback" 0
      in let s4 = state-set-render "reading" 1
      in 0
    else 0

Section: Entry

  render-news : Integer -> Integer
  render-news (x) = mount-widget-themed news-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style news-theme news-css
    in let s01 = state-set "category" 0
    in let s02 = state-set "reading" 0
    in let s03 = state-set "selected-article" 0
    in let s04 = state-set "font-size" 0
    in let s05 = state-set "saved-view" 0
    in let s06 = state-set "share-feedback" 0
    in let s = set-render render-news
    in let h = register-handlers no-pick news-click
    in render-news 0
  end

