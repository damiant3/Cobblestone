Chapter: NewsPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 RSS and news feed reader with categories, article list, and reading
 view. Runtime stubs, theme builders, and widget constructors come
 from the WebApp quire; only the palette, the CSS, the tree, the
 article data, and the handlers live here.

 We say:

Section: Theme

  news-theme : Theme
  news-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 16744448, pal-secondary = 1447446, pal-accent = 16744448, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "news-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  news-css : Text
  news-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0f0f0f;color:#e1e1e1;font-family:Georgia,'Times New Roman',serif;min-height:100vh}#app{display:contents}"
    & ".news{display:grid;grid-template-columns:240px 1fr;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;font-family:system-ui,sans-serif;color:#ff8c00}"
    & ".feed-group{margin-bottom:8px}"
    & ".feed-group-title{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px;font-family:system-ui,sans-serif}"
    & ".feed-item{padding:8px 20px;cursor:pointer;font-size:13px;color:#999;transition:background .1s;font-family:system-ui,sans-serif;display:flex;align-items:center;gap:8px}"
    & ".feed-item:hover{background:#1a1a1a;color:#ddd}"
    & ".feed-item.active{background:#1f1a10;color:#ff8c00;border-right:2px solid #ff8c00}"
    & ".feed-badge{background:#ff8c00;color:#000;font-size:10px;font-weight:700;border-radius:10px;padding:1px 6px;margin-left:auto}"
    & ".main{overflow-y:auto}"
    & ".main-hdr{padding:20px 24px;border-bottom:1px solid #222;display:flex;align-items:center;justify-content:space-between;font-family:system-ui,sans-serif}"
    & ".main-title{font-size:18px;font-weight:600}"
    & ".view-btns{display:flex;gap:4px}"
    & ".view-btns .wk-btn{background:none;border:1px solid #333;color:#888;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".article-list{padding:8px 0}"
    & ".article{padding:16px 24px;border-bottom:1px solid #1a1a1a;cursor:pointer;transition:background .1s;display:grid;grid-template-columns:1fr 120px;gap:16px;align-items:start}"
    & ".article:hover{background:#161616}"
    & ".article-meta{font-size:11px;color:#666;margin-bottom:6px;font-family:system-ui,sans-serif;display:flex;gap:8px;align-items:center}"
    & ".article-source{color:#ff8c00}"
    & ".article-title{font-size:17px;font-weight:600;color:#eee;line-height:1.4;margin-bottom:6px}"
    & ".article-excerpt{font-size:14px;color:#888;line-height:1.6}"
    & ".article-thumb{width:120px;height:80px;border-radius:8px;background:#222;display:flex;align-items:center;justify-content:center;font-size:32px;flex-shrink:0}"
    & ".reading{padding:32px 24px;max-width:680px;margin:0 auto}"
    & ".reading-back{font-size:13px;color:#ff8c00;cursor:pointer;margin-bottom:20px;font-family:system-ui,sans-serif}"
    & ".reading-source{font-size:12px;color:#ff8c00;margin-bottom:8px;font-family:system-ui,sans-serif}"
    & ".reading-title{font-size:28px;font-weight:700;line-height:1.3;margin-bottom:12px;color:#fff}"
    & ".reading-date{font-size:13px;color:#666;margin-bottom:24px;font-family:system-ui,sans-serif}"
    & ".reading-body{font-size:17px;line-height:1.8;color:#ccc}"
    & ".reading-body p{margin-bottom:16px}"

Section: Article Data

  art-source : Integer -> Text
  art-source (n) =
    if n == 0 then "Reuters" else if n == 1 then "Ars Technica" else if n == 2 then "Nature"
    else if n == 3 then "AP News" else if n == 4 then "Reuters" else if n == 5 then "Ars Technica"
    else if n == 6 then "Nature" else "AP News"

  art-time : Integer -> Text
  art-time (n) =
    if n == 0 then "2h ago" else if n == 1 then "3h ago" else if n == 2 then "5h ago"
    else if n == 3 then "6h ago" else if n == 4 then "8h ago" else if n == 5 then "10h ago"
    else if n == 6 then "12h ago" else "14h ago"

  art-icon : Integer -> Text
  art-icon (n) =
    if n == 0 then "&#x1F30D;" else if n == 1 then "&#x1F4BB;" else if n == 2 then "&#x1F52C;"
    else if n == 3 then "&#x1F4C8;" else if n == 4 then "&#x1F30A;" else if n == 5 then "&#x1F4E6;"
    else if n == 6 then "&#x269B;" else "&#x1F680;"

  art-title : Integer -> Text
  art-title (n) =
    if n == 0 then "Global Summit Reaches Historic Climate Agreement"
    else if n == 1 then "New Processor Architecture Breaks Performance Records"
    else if n == 2 then "CRISPR Breakthrough Enables Single-Cell Genome Editing"
    else if n == 3 then "Central Banks Signal Coordinated Rate Adjustments"
    else if n == 4 then "Deep Ocean Expedition Discovers New Hydrothermal Ecosystem"
    else if n == 5 then "Open Source Foundation Launches Universal Package Standard"
    else if n == 6 then "Quantum Error Correction Reaches Practical Threshold"
    else "International Space Station Successor Module Completes Testing"

  art-excerpt : Integer -> Text
  art-excerpt (n) =
    if n == 0 then "World leaders finalized a binding commitment to reduce carbon emissions by 60% before 2035, marking the most ambitious climate accord in history."
    else if n == 1 then "The novel chip design uses photonic interconnects to achieve 4x throughput improvement over current generation silicon, with half the power draw."
    else if n == 2 then "Researchers demonstrate precise editing of individual cells in living tissue without affecting neighboring cells, opening new therapeutic possibilities."
    else if n == 3 then "Major economies prepare synchronized monetary policy shifts as inflation metrics converge toward target ranges across developed markets."
    else if n == 4 then "A previously unknown community of organisms found thriving at extreme depths challenges current understanding of life in extreme environments."
    else if n == 5 then "The new specification aims to unify package management across all programming languages with cryptographic provenance verification."
    else if n == 6 then "A team achieves logical qubit error rates below the threshold needed for useful quantum computation, a milestone decades in the making."
    else "The first module of the next-generation orbital platform passes all structural and environmental qualification tests ahead of launch."

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let view = state-get "reading"
    in widget-box "news" "news" [
      sidebar-tree 0,
      if view == 1 then reading-view 0 else feed-view 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexNews",
      feed-group "fav" "Favorites" [
        feed-item "f-all" "&#x1F4F0; All Articles" "12",
        feed-item "f-saved" "&#x2B50; Saved" "3",
        feed-item "f-recent" "&#x1F552; Recent" ""
      ],
      feed-group "cat" "Categories" [
        feed-item "f-tech" "&#x1F4BB; Technology" "5",
        feed-item "f-sci" "&#x1F52C; Science" "3",
        feed-item "f-world" "&#x1F30D; World" "4",
        feed-item "f-biz" "&#x1F4C8; Business" "2",
        feed-item "f-health" "&#x1F3E5; Health" "",
        feed-item "f-sports" "&#x26BD; Sports" ""
      ],
      feed-group "src" "Sources" [
        feed-item "f-reuters" "Reuters" "",
        feed-item "f-ap" "AP News" "",
        feed-item "f-ars" "Ars Technica" "",
        feed-item "f-nature" "Nature" ""
      ]
    ]

  feed-group : Text, Text, List WidgetNode -> WidgetNode
  feed-group (id) (title) (items) =
    widget-box id "feed-group" (widget-label (id & "t") title :: items)

  feed-item : Text, Text, Text -> WidgetNode
  feed-item (id) (label) (badge) =
    if text-length badge > 0
    then widget-box id "feed-item" [
      widget-label (id & "l") label,
      widget-label (id & "b") badge
    ]
    else widget-box id "feed-item" [
      widget-label (id & "l") label
    ]

  feed-view : Integer -> WidgetNode
  feed-view (x) =
    widget-box "main" "main" [
      widget-box "main-hdr" "main-hdr" [
        widget-label "main-title" "All Articles",
        widget-box "view-btns" "view-btns" [
          widget-button "btn-list" "List",
          widget-button "btn-cards" "Cards"
        ]
      ],
      article-list 0
    ]

  article-list : Integer -> WidgetNode
  article-list (x) =
    widget-box "articles" "article-list" (build-articles 0 8 [])

  build-articles : Integer, Integer, List WidgetNode -> List WidgetNode
  build-articles (i) (n) (acc) =
    if i >= n then acc
    else build-articles (i + 1) n (list-push acc (article-row i))

  article-row : Integer -> WidgetNode
  article-row (n) =
    let id = "a" & show n
    in widget-box-click id "article" [
      widget-box (id & "b") "" [
        widget-box (id & "m") "article-meta" [
          widget-label (id & "src") (art-source n),
          widget-label (id & "tm") ("&#x2022; " & art-time n)
        ],
        widget-label (id & "t") (art-title n),
        widget-label (id & "ex") (art-excerpt n)
      ],
      widget-label (id & "th") (art-icon n)
    ]

  reading-view : Integer -> WidgetNode
  reading-view (x) =
    let sel = state-get "selected-article"
    in widget-box "reading" "reading" [
      widget-button "back" "&#x2190; Back to feed",
      widget-label "r-src" (art-source sel),
      widget-label "r-title" (art-title sel),
      widget-label "r-date" (art-time sel & " &#x2022; 4 min read"),
      widget-box "r-body" "reading-body" [
        widget-label "r-p1" (art-excerpt sel)
      ]
    ]

Section: Handlers

  news-click : Text -> Integer
  news-click (id) =
    if id == "back" then let s = state-set-render "reading" 0 in 0
    else if text-starts-with id "a" then
      let s = state-set-render "selected-article" (id-num id)
      in let s2 = state-set-render "reading" 1 in 0
    else 0

Section: Entry

  render-news : Integer -> Integer
  render-news (x) = mount-widget-themed news-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style news-theme news-css
    in let s = set-render render-news
    in let h = register-handlers no-pick news-click
    in render-news 0
  end

