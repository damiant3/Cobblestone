{
  "name": "mathbook",
  "description": "CodexMath: symbolic math notebook with CAS, plotting, and statistics",
  "quire": "codex.apps.mathbook",
  "entry": "Notebook.codex",
  "target": "CDX",
  "modules": [
    "Expr",
    "Printer",
    "Simplify",
    "Calculus",
    "NumberTheory",
    "Solver",
    "Plotting",
    "Statistics",
    "Distributions",
    "MatrixAlgebra",
    "Circuits",
    "Proof",
    "Parser",
    "Notebook",
    "MathbookPersist"
  ],
  "tests": [
    "tests/TestExpr",
    "tests/TestParser"
  ],
  "dependencies": [
    "codex.foreword.ui",
    "codex.foreword.math",
    "codex.foreword",
    "codex.foreword.encode",
    "codex.os.kernel"
  ]
}
