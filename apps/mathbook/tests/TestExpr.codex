 Unit tests for the symbolic math system.

Section: Harness

  assert-eq : Text, Text, Text -> Text
  assert-eq (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected \"" & expected & "\" got \"" & actual & "\""

  assert-int : Text, Integer, Integer -> Text
  assert-int (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected " & show expected & " got " & show actual

  assert-true : Text, Boolean -> Text
  assert-true (label) (val) = if val then "PASS " & label else "FAIL " & label

Section: Expression Building

  test-expr-build : Text
  test-expr-build =
    let t1 = assert-eq "int-print" "42" (ex-print (ExInt 42))
    in let t2 = assert-eq "var-print" "x" (ex-print (ExVar "x"))
    in let t3 = assert-eq "add-print" "x + 1" (ex-print (ExAdd (ExVar "x") (ExInt 1)))
    in let t4 = assert-eq "pi-print" "pi" (ex-print ExPi)
    in let t5 = assert-eq "ratio-print" "1/3" (ex-print (ex-ratio 1 3))
    in let t6 = assert-eq "sin-print" "sin(x)" (ex-print (ex-sin (ExVar "x")))
    in let t7 = assert-eq "neg-print" "-x" (ex-print (ExNeg (ExVar "x")))
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7

Section: Smart Constructors

  test-smart : Text
  test-smart =
    let t1 = assert-eq "add-zero-left" "x" (ex-print (ex-add (ExInt 0) (ExVar "x")))
    in let t2 = assert-eq "add-zero-right" "x" (ex-print (ex-add (ExVar "x") (ExInt 0)))
    in let t3 = assert-eq "mul-zero" "0" (ex-print (ex-mul (ExInt 0) (ExVar "x")))
    in let t4 = assert-eq "mul-one" "x" (ex-print (ex-mul (ExInt 1) (ExVar "x")))
    in let t5 = assert-eq "pow-zero" "1" (ex-print (ex-pow (ExVar "x") (ExInt 0)))
    in let t6 = assert-eq "pow-one" "x" (ex-print (ex-pow (ExVar "x") (ExInt 1)))
    in let t7 = assert-eq "neg-neg" "x" (ex-print (ex-neg (ExNeg (ExVar "x"))))
    in let t8 = assert-eq "ratio-reduce" "1/2" (ex-print (ex-ratio 2 4))
    in let t9 = assert-eq "ratio-whole" "3" (ex-print (ex-ratio 6 2))
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8 & "\n" & t9

Section: Simplification

  test-simplify : Text
  test-simplify =
    let t1 = assert-eq "const-fold" "7" (ex-print (simplify (ExAdd (ExInt 3) (ExInt 4))))
    in let t2 = assert-eq "x-minus-x" "0" (ex-print (simplify (ExSub (ExVar "x") (ExVar "x"))))
    in let t3 = assert-eq "x-div-x" "1" (ex-print (simplify (ExDiv (ExVar "x") (ExVar "x"))))
    in let t4 = assert-eq "double-neg" "x" (ex-print (simplify (ExNeg (ExNeg (ExVar "x")))))
    in let t5 = assert-eq "ln-e" "1" (ex-print (simplify (ExFn "ln" [ExE])))
    in let t6 = assert-eq "sin-0" "0" (ex-print (simplify (ExFn "sin" [ExInt 0])))
    in let t7 = assert-eq "cos-0" "1" (ex-print (simplify (ExFn "cos" [ExInt 0])))
    in let t8 = assert-eq "fact-5" "120" (ex-print (simplify (ExFn "factorial" [ExInt 5])))
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8

Section: Differentiation

  test-diff : Text
  test-diff =
    let t1 = assert-eq "d-const" "0" (ex-print (differentiate (ExInt 5) "x"))
    in let t2 = assert-eq "d-x" "1" (ex-print (differentiate (ExVar "x") "x"))
    in let t3 = assert-eq "d-x2" "2 * x" (ex-print (simplify (differentiate (ExPow (ExVar "x") (ExInt 2)) "x")))
    in let t4 = assert-eq "d-sin" "cos(x)" (ex-print (simplify (differentiate (ExFn "sin" [ExVar "x"]) "x")))
    in let t5 = assert-eq "d-exp" "e^x" (ex-print (simplify (differentiate (ExPow ExE (ExVar "x")) "x")))
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5

Section: Number Theory

  test-nt : Text
  test-nt =
    let t1 = assert-int "gcd-12-8" 4 (nt-gcd 12 8)
    in let t2 = assert-int "lcm-4-6" 12 (nt-lcm 4 6)
    in let t3 = assert-true "7-prime" (nt-is-prime 7)
    in let t4 = assert-true "10-not-prime" (if nt-is-prime 10 then False else True)
    in let t5 = assert-int "fib-10" 55 (nt-fibonacci 10)
    in let t6 = assert-int "binom-5-2" 10 (nt-binomial 5 2)
    in let t7 = assert-int "factorial-6" 720 (nt-factorial 6)
    in let t8 = assert-int "euler-12" 4 (nt-euler-totient 12)
    in let t9 = assert-int "catalan-4" 14 (nt-catalan 4)
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8 & "\n" & t9

Section: Solver

  test-solver : Text
  test-solver =
    let linear = solve-linear (ExEq (ExAdd (ExMul (ExInt 2) (ExVar "x")) (ExInt 6)) (ExInt 0)) "x"
    in let t1 = when linear
      is Just (sol) -> assert-eq "linear-2x+6=0" "-3" (ex-print sol)
      is None -> "FAIL linear: no solution"
    in let quad = solve-quadratic 1 (-5) 6
    in let t2 = assert-eq "quad-discriminant" "x = 3 or x = 2" (quad-solution-text quad)
    in t1 & "\n" & t2

Section: Statistics

  test-stats : Text
  test-stats =
    let data = [10, 20, 30, 40, 50]
    in let t1 = assert-int "mean" 30 (stat-mean data)
    in let t2 = assert-int "median" 30 (stat-median data)
    in let t3 = assert-int "min" 10 (stat-min data)
    in let t4 = assert-int "max" 50 (stat-max data)
    in let t5 = assert-int "range" 40 (stat-range data)
    in let t6 = assert-int "sum" 150 (stat-sum data 0 5 0)
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6

Section: LaTeX

  test-latex : Text
  test-latex =
    let t1 = assert-eq "latex-frac" "\\frac{1}{3}" (ex-latex (ExRatio 1 3))
    in let t2 = assert-eq "latex-sqrt" "\\sqrt{x}" (ex-latex (ExSqrt (ExVar "x")))
    in let t3 = assert-eq "latex-pi" "\\pi" (ex-latex ExPi)
    in let t4 = assert-eq "latex-inf" "\\infty" (ex-latex ExInfinity)
    in let t5 = assert-eq "latex-sum" "\\sum_{i=1}^{n} i" (ex-latex (ExSum (ExVar "i") "i" (ExInt 1) (ExVar "n")))
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5

Section: Substitution

  test-subst : Text
  test-subst =
    let e = ExAdd (ExMul (ExInt 2) (ExVar "x")) (ExInt 3)
    in let s = ex-subst e "x" (ExInt 5)
    in let t1 = assert-eq "subst-eval" "13" (ex-print (simplify s))
    in let t2 = assert-true "contains-x" (ex-contains-var e "x")
    in let t3 = assert-true "not-contains-y" (if ex-contains-var e "y" then False else True)
    in let vars = ex-free-vars e
    in let t4 = assert-int "free-vars" 1 (list-length vars)
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4

Section: Entry

  opening : [Console] None = act
    print-line-uni "=== MathBook Tests ==="
    print-line-uni test-expr-build
    print-line-uni test-smart
    print-line-uni test-simplify
    print-line-uni test-diff
    print-line-uni test-nt
    print-line-uni test-solver
    print-line-uni test-stats
    print-line-uni test-latex
    print-line-uni test-subst
    print-line-uni "=== Done ==="
  end

