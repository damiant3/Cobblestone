 Unit tests for the expression parser.

Section: Harness

  assert-parse : Text, Text, Text -> Text
  assert-parse (label) (input) (expected) =
    let result = parse-expr input
    in if result.po-ok then
      let actual = ex-print (result.po-expr)
      in if actual == expected then "PASS " & label
      else "FAIL " & label & ": expected \"" & expected & "\" got \"" & actual & "\""
    else "FAIL " & label & ": parse error: " & result.po-error

  assert-parse-fail : Text, Text -> Text
  assert-parse-fail (label) (input) =
    let result = parse-expr input
    in if result.po-ok then "FAIL " & label & ": expected error but got \"" & ex-print (result.po-expr) & "\""
    else "PASS " & label

  assert-assign : Text, Text, Text, Text -> Text
  assert-assign (label) (input) (exp-name) (exp-expr) =
    let result = parse-input input
    in if result.ar-ok & result.ar-is-assign then
      if result.ar-name == exp-name then
        let actual = ex-print (result.ar-expr)
        in if actual == exp-expr then "PASS " & label
        else "FAIL " & label & ": expected \"" & exp-expr & "\" got \"" & actual & "\""
      else "FAIL " & label & ": expected name \"" & exp-name & "\" got \"" & result.ar-name & "\""
    else "FAIL " & label & ": not recognized as assignment"

Section: Atoms

  test-atoms : Text
  test-atoms =
    let t1 = assert-parse "int" "42" "42"
    in let t2 = assert-parse "var" "x" "x"
    in let t3 = assert-parse "pi" "pi" "pi"
    in let t4 = assert-parse "e-const" "e" "e"
    in let t5 = assert-parse "infinity" "oo" "oo"
    in let t6 = assert-parse "true" "true" "true"
    in let t7 = assert-parse "false" "false" "false"
    in let t8 = assert-parse "undefined" "undefined" "undefined"
    in let t9 = assert-parse "parens" "(42)" "42"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8 & "\n" & t9

Section: Floating Point

  test-float : Text
  test-float =
    let t1 = assert-parse "float-3.14" "3.14" "3.140"
    in let t2 = assert-parse "float-0.5" "0.5" "0.500"
    in let t3 = assert-parse "float-add" "1.5 + 2.5" "1.500 + 2.500"
    in let t4 = assert-parse "int-dot-nonfrac" "42" "42"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4

Section: Arithmetic

  test-arith : Text
  test-arith =
    let t1 = assert-parse "add" "1 + 2" "1 + 2"
    in let t2 = assert-parse "sub" "5 - 3" "5 - 3"
    in let t3 = assert-parse "mul" "2 * x" "2 * x"
    in let t4 = assert-parse "div" "x / 2" "x / 2"
    in let t5 = assert-parse "pow" "x^2" "x^2"
    in let t6 = assert-parse "neg" "-x" "-x"
    in let t7 = assert-parse "complex" "2 * x + 3" "2 * x + 3"
    in let t8 = assert-parse "prec-mul-add" "1 + 2 * 3" "1 + 2 * 3"
    in let t9 = assert-parse "parens-override" "(1 + 2) * 3" "(1 + 2) * 3"
    in let t10 = assert-parse "chain-add" "a + b + c" "a + b + c"
    in let t11 = assert-parse "neg-int" "-5" "-5"
    in let t12 = assert-parse "pow-neg" "x^-1" "x^-1"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8 & "\n" & t9 & "\n" & t10 & "\n" & t11 & "\n" & t12

Section: Functions

  test-functions : Text
  test-functions =
    let t1 = assert-parse "sin" "sin(x)" "sin(x)"
    in let t2 = assert-parse "cos" "cos(x)" "cos(x)"
    in let t3 = assert-parse "tan" "tan(x)" "tan(x)"
    in let t4 = assert-parse "ln" "ln(x)" "ln(x)"
    in let t5 = assert-parse "sqrt" "sqrt(x)" "sqrt(x)"
    in let t6 = assert-parse "abs" "abs(x)" "|x|"
    in let t7 = assert-parse "fn-two-args" "log(2, x)" "log(2, x)"
    in let t8 = assert-parse "fn-nested" "sin(cos(x))" "sin(cos(x))"
    in let t9 = assert-parse "factorial" "5!" "factorial(5)"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8 & "\n" & t9

Section: Special Forms

  test-special : Text
  test-special =
    let t1 = assert-parse "diff" "diff(x^2, x)" "d/dx[x^2]"
    in let t2 = assert-parse "integrate-indef" "integrate(x^2, x)" "integrate(x^2, x)"
    in let t3 = assert-parse "integrate-def" "integrate(x^2, x, 0, 1)" "integrate(x^2, x, 0, 1)"
    in let t4 = assert-parse "sum" "sum(i^2, i=1..10)" "sum(i^2, i=1..10)"
    in let t5 = assert-parse "prod" "prod(i, i=1..5)" "prod(i, i=1..5)"
    in let t6 = assert-parse "lim" "lim(1/x, x -> oo)" "lim(1 / x, x -> oo)"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6

Section: Matrix

  test-matrix : Text
  test-matrix =
    let t1 = assert-parse "matrix-2x2" "matrix(2, 2, 1, 2, 3, 4)" "matrix(2x2)"
    in let t2 = assert-parse "matrix-1x3" "matrix(1, 3, 5, 6, 7)" "matrix(1x3)"
    in let t3 = assert-parse "matrix-empty" "matrix(0, 0)" "matrix(0x0)"
    in t1 & "\n" & t2 & "\n" & t3

Section: Relational and Logical

  test-relational : Text
  test-relational =
    let t1 = assert-parse "eq" "x = 5" "x = 5"
    in let t2 = assert-parse "lt" "x < 3" "x < 3"
    in let t3 = assert-parse "gt" "x > 3" "x > 3"
    in let t4 = assert-parse "leq" "x <= 10" "x <= 10"
    in let t5 = assert-parse "geq" "x >= 0" "x >= 0"
    in let t6 = assert-parse "and" "x > 0 and x < 10" "x > 0 and x < 10"
    in let t7 = assert-parse "or" "x < 0 or x > 10" "x < 0 or x > 10"
    in let t8 = assert-parse "not" "not x" "not x"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6 & "\n" & t7 & "\n" & t8

Section: Collections

  test-collections : Text
  test-collections =
    let t1 = assert-parse "list" "[1, 2, 3]" "[1, 2, 3]"
    in let t2 = assert-parse "set" "{1, 2, 3}" "{1, 2, 3}"
    in let t3 = assert-parse "abs-bar" "|x|" "|x|"
    in t1 & "\n" & t2 & "\n" & t3

Section: Assignment

  test-assign : Text
  test-assign =
    let t1 = assert-assign "simple-assign" "x := 42" "x" "42"
    in let t2 = assert-assign "expr-assign" "f := x^2 + 1" "f" "x^2 + 1"
    in t1 & "\n" & t2

Section: Whitespace Handling

  test-whitespace : Text
  test-whitespace =
    let t1 = assert-parse "leading-ws" "  42" "42"
    in let t2 = assert-parse "trailing-ws" "42  " "42"
    in let t3 = assert-parse "around-ops" " 1  +  2 " "1 + 2"
    in t1 & "\n" & t2 & "\n" & t3

Section: Error Cases

  test-errors : Text
  test-errors =
    let t1 = assert-parse-fail "empty" ""
    in let t2 = assert-parse-fail "unmatched-paren" "(1 + 2"
    in t1 & "\n" & t2

Section: Implicit Multiplication

  test-implicit-mul : Text
  test-implicit-mul =
    let t1 = assert-parse "coeff-var" "2x" "2 * x"
    in let t2 = assert-parse "coeff-paren" "3(x + 1)" "3 * (x + 1)"
    in let t3 = assert-parse "var-var" "x y" "x * y"
    in let t4 = assert-parse "paren-paren" "(a)(b)" "a * b"
    in let t5 = assert-parse "coeff-fn" "2sin(x)" "2 * sin(x)"
    in let t6 = assert-parse "pi-coeff" "2pi" "2 * pi"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6

Section: Eval Pipeline (parse + dispatch + simplify)

  assert-eval : Text, Text, Text -> Text
  assert-eval (label) (input) (expected) =
    let parsed = parse-expr input
    in if parsed.po-ok then
      let dispatched = eval-dispatch (parsed.po-expr)
      in let result = simplify dispatched
      in let actual = ex-print result
      in if actual == expected then "PASS " & label
      else "FAIL " & label & ": expected \"" & expected & "\" got \"" & actual & "\""
    else "FAIL " & label & ": parse error: " & parsed.po-error

  test-eval-pipeline : Text
  test-eval-pipeline =
    let t1 = assert-eval "diff-x2" "diff(x^2, x)" "2 * x"
    in let t2 = assert-eval "diff-poly" "diff(x^3 + 2 * x, x)" "3 * x^2 + 2"
    in let t3 = assert-eval "sum-const" "sum(1, i=1..5)" "5"
    in let t4 = assert-eval "sum-linear" "sum(i, i=1..4)" "10"
    in let t5 = assert-eval "prod-fact" "prod(i, i=1..5)" "120"
    in let t6 = assert-eval "integrate-x" "integrate(x, x)" "x^2 / 2"
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4 & "\n" & t5 & "\n" & t6

Section: Round-Trip (print then parse)

  test-roundtrip : Text
  test-roundtrip =
    let e1 = ExAdd (ExVar "x") (ExInt 1)
    in let s1 = ex-print e1
    in let r1 = parse-expr s1
    in let t1 = if r1.po-ok then
      if ex-equal (r1.po-expr) e1 then "PASS roundtrip-add"
      else "FAIL roundtrip-add: got \"" & ex-print (r1.po-expr) & "\""
    else "FAIL roundtrip-add: parse error"
    in let e2 = ExMul (ExAdd (ExVar "x") (ExInt 1)) (ExVar "y")
    in let s2 = ex-print e2
    in let r2 = parse-expr s2
    in let t2 = if r2.po-ok then "PASS roundtrip-mul-add: \"" & s2 & "\" -> \"" & ex-print (r2.po-expr) & "\""
    else "FAIL roundtrip-mul-add: parse error"
    in t1 & "\n" & t2

