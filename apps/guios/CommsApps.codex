  cites UI chapter Layout
  cites UI chapter Theme

 Communication app views: Mail, Chat, Collab, Helm.

Section: Mail View (view 21)
  draw-view-mail : GopBuf, ShellUiState -> Integer
  draw-view-mail (gb) (st) =
    let wh = st.su-wheel
    in let folders = widget-panel "mail-folders" DirColumn 2 [
      widget-label "mail-fh" "Folders",
      widget-separator "mail-fs",
      widget-label "mail-f1" "Inbox (3)",
      widget-label "mail-f2" "Sent",
      widget-label "mail-f3" "Drafts (1)",
      widget-label "mail-f4" "Archive",
      widget-label "mail-f5" "Spam"
    ]
    in let messages = widget-panel "mail-msgs" DirColumn 2 [
      widget-label "mail-m1" "Alice - Build passed",
      widget-label "mail-m2" "Bob - Review ready",
      widget-label "mail-m3" "Carol - Meeting notes",
      widget-label "mail-m4" "Dave - Deploy plan",
      widget-label "mail-m5" "Eve - Bug report"
    ]
    in let preview = widget-panel "mail-prev" DirColumn 2 [
      widget-label "mail-from" "From: Alice",
      widget-label "mail-subj" "Subject: Build passed",
      widget-label "mail-date" "Date: 2026-06-21 09:15",
      widget-separator "mail-ps",
      widget-label "mail-b1" "Hi team,",
      widget-label "mail-b2" "The build passed all gates.",
      widget-label "mail-b3" "Fixed point verified.",
      widget-label "mail-b4" "Ready for copy-up."
    ]
    in let tree = widget-panel "mail-root" DirRow 4 [
      widget-set-min folders 90 0,
      widget-set-min messages 160 0,
      preview
    ]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Chat View (view 22)
  draw-view-chat : GopBuf, ShellUiState -> Integer
  draw-view-chat (gb) (st) =
    let wh = st.su-wheel
    in let header = widget-label "chat-hdr" "#general"
    in let msgs = widget-panel "chat-msgs" DirColumn 4 [
      widget-label "chat-m1" "alice  09:00  Hey team, build is green!",
      widget-label "chat-m2" "bob    09:02  Nice! Deploying now.",
      widget-label "chat-m3" "carol  09:05  ETA on the new feature?",
      widget-label "chat-m4" "dave   09:07  Should be ready by EOD.",
      widget-label "chat-m5" "alice  09:08  Great, I will review tonight.",
      widget-label "chat-m6" "bob    09:10  Thanks everyone!"
    ]
    in let input = widget-input "chat-in" "Type a message..." 0
    in let tree = widget-panel "chat-root" DirColumn 6 [header, widget-separator "chat-sep1", msgs, widget-separator "chat-sep2", input]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Collab View (view 23)
  draw-view-collab : GopBuf, ShellUiState -> Integer
  draw-view-collab (gb) (st) =
    let wh = st.su-wheel
    in let header = widget-label "collab-hdr" "Meeting: Sprint Review"
    in let grid-top = widget-panel "collab-row1" DirRow 8 [
      widget-set-min (widget-label "collab-alice" "Alice") 0 140,
      widget-set-min (widget-label "collab-bob" "Bob") 0 140
    ]
    in let grid-bot = widget-panel "collab-row2" DirRow 8 [
      widget-set-min (widget-label "collab-carol" "Carol") 0 140,
      widget-set-min (widget-label "collab-dave" "Dave") 0 140
    ]
    in let grid = widget-panel "collab-grid" DirColumn 8 [grid-top, grid-bot]
    in let controls = widget-panel "collab-ctrl" DirRow 16 [
      widget-button "collab-mute" "Mute",
      widget-button "collab-cam" "Camera",
      widget-button "collab-share" "Share",
      widget-button "collab-leave" "Leave"
    ]
    in let footer = widget-label "collab-dur" "Duration: 00:23:45"
    in let tree = widget-panel "collab-root" DirColumn 6 [header, widget-separator "collab-sep1", grid, widget-separator "collab-sep2", controls, footer]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Helm View (view 24)
  draw-view-helm : GopBuf, ShellUiState -> Integer
  draw-view-helm (gb) (st) =
    let wh = st.su-wheel
    in let servers = widget-panel "helm-srv" DirColumn 2 [
      widget-label "helm-s1" "Codex HQ",
      widget-label "helm-ch1" "# general",
      widget-label "helm-ch2" "# engineering",
      widget-label "helm-ch3" "# design",
      widget-separator "helm-ss",
      widget-label "helm-s2" "Open Source",
      widget-label "helm-ch4" "# announcements",
      widget-label "helm-ch5" "# help"
    ]
    in let chat = widget-panel "helm-chat" DirColumn 4 [
      widget-label "helm-cm1" "alice  10:30  Morning everyone",
      widget-label "helm-cm2" "bob    10:32  Hey! Build just finished.",
      widget-label "helm-cm3" "carol  10:35  Ready for review."
    ]
    in let members = widget-panel "helm-mem" DirColumn 2 [
      widget-label "helm-memh" "Members (8)",
      widget-separator "helm-ms",
      widget-label "helm-u1" "Alice",
      widget-label "helm-u2" "Bob",
      widget-label "helm-u3" "Carol",
      widget-label "helm-u4" "Dave",
      widget-label "helm-u5" "Eve",
      widget-label "helm-u6" "Frank",
      widget-label "helm-u7" "Grace",
      widget-label "helm-u8" "Hank"
    ]
    in let right = widget-panel "helm-right" DirColumn 4 [chat, widget-separator "helm-rs", members]
    in let tree = widget-panel "helm-root" DirRow 4 [
      widget-set-min servers (work-w * 2 / 5 - 2) 0,
      right
    ]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

