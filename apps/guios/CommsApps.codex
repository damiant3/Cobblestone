Chapter: CommsApps
  cites Guios chapter GuiDisplay
  cites Guios chapter GuiTimer

 Communication app views: Mail, Chat, Collab, Helm.

Section: Mail View (view 21)
  draw-view-mail : GopBuf, ShellUiState -> Integer
  draw-view-mail (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Mail"
    in let fw = 90
    in let mw2 = 160
    in let cx = x + 6
    in let dummy2 = gop-buf-rect gb cx 28 fw 400 col-win-title
    in let dummy3 = draw-text-f gb wh (cx + 4) 32 "Folders" col-accent font-role-sans
    in let dummy4 = gop-buf-hline gb (cx + 4) (cx + fw - 4) 48 col-sep
    in let dummy5 = gop-buf-rect gb (cx + 2) 52 (fw - 4) 16 col-sidebar-sel
    in let dummy6 = draw-text-f gb wh (cx + 4) 54 "Inbox (3)" col-fg font-role-serif
    in let dummy7 = draw-text-f gb wh (cx + 4) 72 "Sent" col-fg2 font-role-serif
    in let dummy8 = draw-text-f gb wh (cx + 4) 90 "Drafts (1)" col-fg2 font-role-serif
    in let dummy9 = draw-text-f gb wh (cx + 4) 108 "Archive" col-dim font-role-serif
    in let dummy10 = draw-text-f gb wh (cx + 4) 126 "Spam" col-dim font-role-serif
    in let mx = cx + fw + 4
    in let dummy11 = gop-buf-vline gb mx 28 428 col-sep
    in let dummy12 = gop-buf-rect gb (mx + 2) 28 mw2 16 col-sidebar-sel
    in let dummy13 = draw-text-f gb wh (mx + 4) 30 "Alice - Build passed" col-fg font-role-serif
    in let dummy14 = draw-text-f gb wh (mx + 4) 48 "Bob - Review ready" col-fg2 font-role-serif
    in let dummy15 = draw-text-f gb wh (mx + 4) 66 "Carol - Meeting notes" col-fg2 font-role-serif
    in let dummy16 = draw-text-f gb wh (mx + 4) 84 "Dave - Deploy plan" col-dim font-role-serif
    in let dummy17 = draw-text-f gb wh (mx + 4) 102 "Eve - Bug report" col-dim font-role-serif
    in let px = mx + mw2 + 4
    in let dummy18 = gop-buf-vline gb px 28 428 col-sep
    in let dummy19 = draw-kv gb wh (px + 4) 30 "From" "Alice" col-dim col-fg
    in let dummy20 = draw-kv gb wh (px + 4) 48 "Subject" "Build passed" col-dim col-fg
    in let dummy21 = draw-kv gb wh (px + 4) 66 "Date" "2026-06-21 09:15" col-dim col-fg2
    in let dummy22 = gop-buf-hline gb (px + 4) (x + work-w - 10) 84 col-sep
    in let dummy23 = draw-text-f gb wh (px + 4) 92 "Hi team," col-fg2 font-role-serif
    in let dummy24 = draw-text-f gb wh (px + 4) 110 "The build passed all gates." col-fg2 font-role-serif
    in let dummy25 = draw-text-f gb wh (px + 4) 128 "Fixed point verified." col-fg2 font-role-serif
    in draw-text-f gb wh (px + 4) 146 "Ready for copy-up." col-fg2 font-role-serif

Section: Chat View (view 22)
  draw-view-chat : GopBuf, ShellUiState -> Integer
  draw-view-chat (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Chat"
    in let cx = x + 10
    in let dummy2 = draw-text-f gb wh cx 28 "#general" col-accent font-role-sans
    in let dummy3 = gop-buf-hline gb cx (x + work-w - 10) 44 col-sep
    in let dummy4 = draw-chat-msg gb wh cx 52 "alice" "09:00" "Hey team, build is green!"
    in let dummy5 = draw-chat-msg gb wh cx 90 "bob" "09:02" "Nice! Deploying now."
    in let dummy6 = draw-chat-msg gb wh cx 128 "carol" "09:05" "ETA on the new feature?"
    in let dummy7 = draw-chat-msg gb wh cx 166 "dave" "09:07" "Should be ready by EOD."
    in let dummy8 = draw-chat-msg gb wh cx 204 "alice" "09:08" "Great, I will review tonight."
    in let dummy9 = draw-chat-msg gb wh cx 242 "bob" "09:10" "Thanks everyone!"
    in let dummy10 = gop-buf-hline gb cx (x + work-w - 10) 290 col-sep
    in let dummy11 = gop-buf-rect gb cx 300 (work-w - 20) 24 col-win-title
    in draw-text-f gb wh (cx + 8) 306 "Type a message..." col-dim font-role-serif

  draw-chat-msg : GopBuf, MutWheel, Integer, Integer, Text, Text, Text -> Integer
  draw-chat-msg (gb) (wh) (x) (y) (who) (time) (msg) =
    let dummy = draw-text-f gb wh x y (who & "  " & time) col-dim font-role-mono
    in draw-text-f gb wh x (y + 16) msg col-fg font-role-serif

Section: Collab View (view 23)
  draw-view-collab : GopBuf, ShellUiState -> Integer
  draw-view-collab (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Collab"
    in let dummy2 = draw-text-f gb wh (x + 10) 28 "Meeting: Sprint Review" col-accent font-role-sans
    in let dummy3 = gop-buf-hline gb (x + 10) (x + work-w - 10) 44 col-sep
    in let cw = work-w / 2 - 16
    in let ch = 140
    in let dummy4 = collab-cell gb wh (x + 8) 52 cw ch "Alice" col-green
    in let dummy5 = collab-cell gb wh (x + cw + 16) 52 cw ch "Bob" col-green
    in let dummy6 = collab-cell gb wh (x + 8) (52 + ch + 8) cw ch "Carol" col-green
    in let dummy7 = collab-cell gb wh (x + cw + 16) (52 + ch + 8) cw ch "Dave" col-dim
    in let dummy8 = gop-buf-hline gb (x + 10) (x + work-w - 10) 358 col-sep
    in let dummy9 = draw-text-f gb wh (x + 30) 370 "Mute" col-fg2 font-role-sans
    in let dummy10 = draw-text-f gb wh (x + 120) 370 "Camera" col-fg2 font-role-sans
    in let dummy11 = draw-text-f gb wh (x + 220) 370 "Share" col-fg2 font-role-sans
    in let dummy12 = draw-text-f gb wh (x + 320) 370 "Leave" col-red font-role-sans
    in draw-kv gb wh (x + 10) 396 "Duration" "00:23:45" col-dim col-dim

  collab-cell : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Text, Integer -> Integer
  collab-cell (gb) (wh) (x) (y) (w) (h) (name) (status) =
    let dummy = gop-buf-rect gb x y w h col-win-title
    in let dummy2 = gop-buf-outline gb x y w h col-win-border
    in let nx = x + w / 2 - 20
    in let ny = y + h / 2 - 8
    in let dummy3 = draw-text-f gb wh nx ny name col-fg font-role-sans
    in gop-buf-rect gb (x + w - 14) (y + 6) 8 8 status

Section: Helm View (view 24)
  draw-view-helm : GopBuf, ShellUiState -> Integer
  draw-view-helm (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let sw = work-w * 2 / 5 - 2
    in let rw = work-w * 3 / 5 - 2
    in let dummy = draw-win gb wh x 4 sw 436 "Servers"
    in let cx = x + 10
    in let dummy2 = draw-text-f gb wh cx 28 "Codex HQ" col-accent font-role-sans
    in let dummy3 = gop-buf-rect gb (cx - 2) 44 (sw - 16) 16 col-sidebar-sel
    in let dummy4 = draw-text-f gb wh cx 46 "# general" col-fg font-role-serif
    in let dummy5 = draw-text-f gb wh cx 64 "# engineering" col-fg2 font-role-serif
    in let dummy6 = draw-text-f gb wh cx 82 "# design" col-fg2 font-role-serif
    in let dummy7 = gop-buf-hline gb cx (x + sw - 10) 100 col-sep
    in let dummy8 = draw-text-f gb wh cx 108 "Open Source" col-accent font-role-sans
    in let dummy9 = draw-text-f gb wh cx 126 "# announcements" col-fg2 font-role-serif
    in let dummy10 = draw-text-f gb wh cx 144 "# help" col-fg2 font-role-serif
    in let x2 = x + sw + 4
    in let dummy11 = draw-win gb wh x2 4 rw 220 "Messages"
    in let cx2 = x2 + 10
    in let dummy12 = draw-chat-msg gb wh cx2 28 "alice" "10:30" "Morning everyone"
    in let dummy13 = draw-chat-msg gb wh cx2 66 "bob" "10:32" "Hey! Build just finished."
    in let dummy14 = draw-chat-msg gb wh cx2 104 "carol" "10:35" "Ready for review."
    in let dummy15 = draw-win gb wh x2 228 rw 212 "Members (8)"
    in let dummy16 = draw-helm-member gb wh cx2 252 "Alice" col-green
    in let dummy17 = draw-helm-member gb wh cx2 270 "Bob" col-green
    in let dummy18 = draw-helm-member gb wh cx2 288 "Carol" col-green
    in let dummy19 = draw-helm-member gb wh cx2 306 "Dave" col-yellow
    in let dummy20 = draw-helm-member gb wh cx2 324 "Eve" col-dim
    in let dummy21 = draw-helm-member gb wh cx2 342 "Frank" col-dim
    in let dummy22 = draw-helm-member gb wh cx2 360 "Grace" col-dim
    in draw-helm-member gb wh cx2 378 "Hank" col-dim

  draw-helm-member : GopBuf, MutWheel, Integer, Integer, Text, Integer -> Integer
  draw-helm-member (gb) (wh) (x) (y) (name) (status) =
    let dummy = gop-buf-rect gb x (y + 4) 6 6 status
    in draw-text-f gb wh (x + 12) y name col-fg font-role-serif

