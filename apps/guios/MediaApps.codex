 Media app views: Boombox, Piano, Photos, Podcasts.

Section: Boombox View (view 13)
  draw-view-boombox : GopBuf, ShellUiState -> Integer
  draw-view-boombox (gb) (st) =
    let wh = st.su-wheel
    in let header = widget-label "bb-hdr" "#  Title                   Duration"
    in let tracks = widget-panel "bb-tracks" DirColumn 0 [
      widget-label "bb-t1" "1  Morning Light           3:42",
      widget-label "bb-t2" "2  Neon Drive              4:15",
      widget-label "bb-t3" "3  Sunset Loop             3:58",
      widget-label "bb-t4" "4  Binary Rain             5:01",
      widget-label "bb-t5" "5  Kernel Panic            2:33",
      widget-label "bb-t6" "6  Stack Overflow          4:47",
      widget-label "bb-t7" "7  Heap of Dreams          3:21",
      widget-label "bb-t8" "8  Final Commit            6:12"
    ]
    in let now-playing = widget-panel "bb-np" DirColumn 2 [
      widget-label "bb-nph" "Now Playing",
      widget-label "bb-npt" "Morning Light - Codex Band",
      widget-gauge "bb-prog" 127 222,
      widget-label "bb-time" "2:07 / 3:42"
    ]
    in let tree = widget-panel "bb-root" DirColumn 6 [header, widget-separator "bb-sep1", tracks, widget-separator "bb-sep2", now-playing]
    in let bounds = layout-rect work-x 4 work-w 360
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Piano View (view 14)
  draw-view-piano : GopBuf, ShellUiState -> Integer
  draw-view-piano (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let active = mw-get-app-s0 wh
    in let cx = x + 10
    in let kw = (work-w - 20) / 14
    in let ky = 60
    in let kh = 140
    in let header = widget-panel "piano-hdr" DirRow 8 [
      widget-label "piano-nl" "Note:",
      widget-label "piano-nv" (piano-note-name active)
    ]
    in let tree = widget-panel "piano-top" DirColumn 4 [header]
    in let bounds = layout-rect x 4 work-w 50
    in let laid-out = widget-layout tree theme-terminal bounds
    in let dummy = gop-render-tree laid-out theme-terminal gb wh
    in let dummy2 = piano-draw-whites gb wh cx ky kw kh active 0
    in let dummy3 = piano-draw-blacks gb cx ky kw 0
    in let foot = widget-panel "piano-foot" DirColumn 2 [
      widget-label "piano-keys" "Keys: A S D F G H J K L ;",
      widget-label "piano-range" "Two octaves C3-B4"
    ]
    in let fbounds = layout-rect x (ky + kh + 10) work-w 60
    in let flaid = widget-layout foot theme-terminal fbounds
    in gop-render-tree flaid theme-terminal gb wh

  piano-note-name : Integer -> Text
  piano-note-name (n) =
    if n == 0 then "C3"
    else if n == 1 then "D3"
    else if n == 2 then "E3"
    else if n == 3 then "F3"
    else if n == 4 then "G3"
    else if n == 5 then "A3"
    else if n == 6 then "B3"
    else if n == 7 then "C4"
    else if n == 8 then "D4"
    else if n == 9 then "E4"
    else "--"

  piano-draw-whites : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  piano-draw-whites (gb) (wh) (x) (y) (kw) (kh) (active) (i) =
    if i >= 14 then 0
    else let kx = x + i * kw
    in let bg = if i == active then col-accent else #E2E8F0
    in let dummy = gop-buf-rect gb kx y kw kh bg
    in let dummy2 = gop-buf-outline gb kx y kw kh col-sep
    in piano-draw-whites gb wh x y kw kh active (i + 1)

  piano-draw-blacks : GopBuf, Integer, Integer, Integer, Integer -> Integer
  piano-draw-blacks (gb) (x) (y) (kw) (i) =
    if i >= 14 then 0
    else let skip = piano-is-black-gap i
    in if skip == 1 then piano-draw-blacks gb x y kw (i + 1)
    else let bx = x + i * kw + kw * 2 / 3
    in let bw = kw * 2 / 3
    in let dummy = gop-buf-rect gb bx y bw 80 #1E293B
    in piano-draw-blacks gb x y kw (i + 1)

  piano-is-black-gap : Integer -> Integer
  piano-is-black-gap (i) =
    if i == 2 then 1
    else if i == 6 then 1
    else if i == 9 then 1
    else if i == 13 then 1
    else 0

Section: Photos View (view 15)
  draw-view-photos : GopBuf, ShellUiState -> Integer
  draw-view-photos (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let header = widget-label "pho-hdr" "Gallery"
    in let row1 = widget-panel "pho-r1" DirRow 10 [
      widget-set-min (widget-label "pho-1" "IMG_001") 0 120,
      widget-set-min (widget-label "pho-2" "IMG_002") 0 120,
      widget-set-min (widget-label "pho-3" "IMG_003") 0 120
    ]
    in let row2 = widget-panel "pho-r2" DirRow 10 [
      widget-set-min (widget-label "pho-4" "IMG_004") 0 120,
      widget-set-min (widget-label "pho-5" "IMG_005") 0 120,
      widget-set-min (widget-label "pho-6" "IMG_006") 0 120
    ]
    in let footer = widget-label "pho-foot" "6 photos  2.4 MB"
    in let tree = widget-panel "pho-root" DirColumn 6 [header, row1, row2, widget-separator "pho-sep", footer]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Podcasts View (view 16)
  draw-view-podcasts : GopBuf, ShellUiState -> Integer
  draw-view-podcasts (gb) (st) =
    let wh = st.su-wheel
    in let shows = widget-panel "pod-shows" DirColumn 2 [
      widget-label "pod-s1" "Tech Today",
      widget-label "pod-s1d" "Weekly tech news",
      widget-separator "pod-ss1",
      widget-label "pod-s2" "CodeCast",
      widget-label "pod-s2d" "Programming deep dives",
      widget-separator "pod-ss2",
      widget-label "pod-s3" "Deep Dive",
      widget-label "pod-s3d" "Long-form interviews",
      widget-separator "pod-ss3",
      widget-label "pod-s4" "The Stack",
      widget-label "pod-s4d" "Architecture reviews"
    ]
    in let episodes = widget-panel "pod-eps" DirColumn 2 [
      widget-label "pod-e1" "Ep 12: Future of Rust",
      widget-gauge "pod-g1" 45 45,
      widget-label "pod-e1t" "45:00  Completed",
      widget-separator "pod-es1",
      widget-label "pod-e2" "Ep 11: WASM Deep Dive",
      widget-gauge "pod-g2" 28 38,
      widget-label "pod-e2t" "28:00 / 38:20",
      widget-separator "pod-es2",
      widget-label "pod-e3" "Ep 10: Type Theory",
      widget-gauge "pod-g3" 0 52,
      widget-label "pod-e3t" "0:00 / 52:10  New"
    ]
    in let tree = widget-panel "pod-root" DirRow 4 [shows, episodes]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

