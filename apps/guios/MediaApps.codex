    in let dummy5 = draw-text-f gb wh cx 68 "CodeCast" col-fg font-role-sans
    in let dummy6 = draw-text-f gb wh cx 84 "Programming deep dives" col-dim font-role-serif
    in let dummy7 = gop-buf-hline gb cx (x + hw - 10) 102 col-sep
