 Media app views: Boombox, Piano, Photos, Podcasts.

Section: Boombox View (view 13)
  draw-view-boombox : GopBuf, ShellUiState -> Integer
  draw-view-boombox (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 360 "Boombox"
    in let cx = x + 10
    in let dummy2 = draw-text-f gb wh cx 28 "#  Title                   Duration" col-dim font-role-mono
    in let dummy3 = gop-buf-hline gb cx (x + work-w - 10) 44 col-sep
    in let dummy4 = gop-buf-rect gb cx 48 (work-w - 20) 18 col-sidebar-sel
    in let dummy5 = draw-text-f gb wh cx 50 "1  Morning Light           3:42" col-accent font-role-mono
    in let dummy6 = draw-text-f gb wh cx 68 "2  Neon Drive              4:15" col-fg font-role-mono
    in let dummy7 = draw-text-f gb wh cx 86 "3  Sunset Loop             3:58" col-fg font-role-mono
    in let dummy8 = draw-text-f gb wh cx 104 "4  Binary Rain             5:01" col-fg font-role-mono
    in let dummy9 = draw-text-f gb wh cx 122 "5  Kernel Panic            2:33" col-fg font-role-mono
    in let dummy10 = draw-text-f gb wh cx 140 "6  Stack Overflow          4:47" col-fg font-role-mono
    in let dummy11 = draw-text-f gb wh cx 158 "7  Heap of Dreams          3:21" col-fg font-role-mono
    in let dummy12 = draw-text-f gb wh cx 176 "8  Final Commit            6:12" col-fg font-role-mono
    in let dummy13 = gop-buf-hline gb cx (x + work-w - 10) 200 col-sep
    in let dummy14 = gop-buf-rect gb cx 210 (work-w - 20) 50 col-win-title
    in let dummy15 = draw-text-f gb wh (cx + 8) 216 "Now Playing" col-dim font-role-sans
    in let dummy16 = draw-text-f gb wh (cx + 8) 234 "Morning Light - Codex Band" col-fg font-role-serif
    in let dummy17 = draw-gauge-bar gb (cx + 8) 252 (work-w - 36) 4 127 222 col-accent
    in draw-kv gb wh (cx + 8) 258 "2:07" "3:42" col-dim col-dim

Section: Piano View (view 14)
  draw-view-piano : GopBuf, ShellUiState -> Integer
  draw-view-piano (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Piano"
    in let active = mw-get-app-s0 wh
    in let cx = x + 10
    in let dummy2 = draw-kv gb wh cx 28 "Note" (piano-note-name active) col-fg col-accent
    in let kw = (work-w - 20) / 14
    in let ky = 60
    in let kh = 140
    in let dummy3 = piano-draw-whites gb wh cx ky kw kh active 0
    in let dummy4 = piano-draw-blacks gb cx ky kw 0
    in let dummy5 = gop-buf-hline gb cx (x + work-w - 10) (ky + kh + 10) col-sep
    in let dummy6 = draw-text-f gb wh cx (ky + kh + 18) "Keys: A S D F G H J K L ;" col-dim font-role-mono
    in draw-text-f gb wh cx (ky + kh + 36) "Two octaves C3-B4" col-dim font-role-serif

  piano-note-name : Integer -> Text
  piano-note-name (n) =
    if n == 0 then "C3"
    else if n == 1 then "D3"
    else if n == 2 then "E3"
    else if n == 3 then "F3"
    else if n == 4 then "G3"
    else if n == 5 then "A3"
    else if n == 6 then "B3"
    else if n == 7 then "C4"
    else if n == 8 then "D4"
    else if n == 9 then "E4"
    else "--"

  piano-draw-whites : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  piano-draw-whites (gb) (wh) (x) (y) (kw) (kh) (active) (i) =
    if i >= 14 then 0
    else let kx = x + i * kw
    in let bg = if i == active then col-accent else #E2E8F0
    in let dummy = gop-buf-rect gb kx y kw kh bg
    in let dummy2 = gop-buf-outline gb kx y kw kh col-sep
    in piano-draw-whites gb wh x y kw kh active (i + 1)

  piano-draw-blacks : GopBuf, Integer, Integer, Integer, Integer -> Integer
  piano-draw-blacks (gb) (x) (y) (kw) (i) =
    if i >= 14 then 0
    else let skip = piano-is-black-gap i
    in if skip == 1 then piano-draw-blacks gb x y kw (i + 1)
    else let bx = x + i * kw + kw * 2 / 3
    in let bw = kw * 2 / 3
    in let dummy = gop-buf-rect gb bx y bw 80 #1E293B
    in piano-draw-blacks gb x y kw (i + 1)

  piano-is-black-gap : Integer -> Integer
  piano-is-black-gap (i) =
    if i == 2 then 1
    else if i == 6 then 1
    else if i == 9 then 1
    else if i == 13 then 1
    else 0

Section: Photos View (view 15)
  draw-view-photos : GopBuf, ShellUiState -> Integer
  draw-view-photos (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Photos"
    in let dummy2 = draw-text-f gb wh (x + 10) 28 "Gallery" col-accent font-role-sans
    in let tw = (work-w - 40) / 3
    in let th = 120
    in let tx = x + 10
    in let dummy3 = gop-buf-rect gb tx 50 tw th col-accent
    in let dummy4 = gop-buf-rect gb (tx + tw + 10) 50 tw th col-teal
    in let dummy5 = gop-buf-rect gb (tx + 2 * tw + 20) 50 tw th col-purple
    in let dummy6 = gop-buf-rect gb tx (50 + th + 10) tw th col-orange
    in let dummy7 = gop-buf-rect gb (tx + tw + 10) (50 + th + 10) tw th col-pink
    in let dummy8 = gop-buf-rect gb (tx + 2 * tw + 20) (50 + th + 10) tw th col-green
    in let dummy9 = draw-text-f gb wh tx 174 "IMG_001" col-dim font-role-mono
    in let dummy10 = draw-text-f gb wh (tx + tw + 10) 174 "IMG_002" col-dim font-role-mono
    in let dummy11 = draw-text-f gb wh (tx + 2 * tw + 20) 174 "IMG_003" col-dim font-role-mono
    in let dummy12 = draw-text-f gb wh tx 304 "IMG_004" col-dim font-role-mono
    in let dummy13 = draw-text-f gb wh (tx + tw + 10) 304 "IMG_005" col-dim font-role-mono
    in let dummy14 = draw-text-f gb wh (tx + 2 * tw + 20) 304 "IMG_006" col-dim font-role-mono
    in let dummy15 = gop-buf-hline gb (x + 10) (x + work-w - 10) 326 col-sep
    in draw-kv gb wh (x + 10) 336 "6 photos" "2.4 MB" col-dim col-dim

Section: Podcasts View (view 16)
