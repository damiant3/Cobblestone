    in let dummy16 = draw-text-f gb wh cx2 54 "45:00  Completed" col-dim font-role-mono
    in let dummy17 = gop-buf-hline gb cx2 (x2 + hw - 10) 72 col-sep
    in let dummy18 = draw-text-f gb wh cx2 78 "Ep 11: WASM Deep Dive" col-fg font-role-sans
    in let dummy19 = draw-gauge-bar gb cx2 94 (hw - 20) 6 28 38 col-accent
    in let dummy20 = draw-text-f gb wh cx2 104 "28:00 / 38:20" col-dim font-role-mono
    in let dummy21 = gop-buf-hline gb cx2 (x2 + hw - 10) 122 col-sep
    in let dummy22 = draw-text-f gb wh cx2 128 "Ep 10: Type Theory" col-fg font-role-sans
    in let dummy23 = draw-gauge-bar gb cx2 144 (hw - 20) 6 0 52 col-dim
    in draw-text-f gb wh cx2 154 "0:00 / 52:10  New" col-dim font-role-mono

