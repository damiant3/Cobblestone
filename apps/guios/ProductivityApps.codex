Chapter: ProductivityApps
  cites Guios chapter GuiDisplay
  cites Guios chapter GuiTimer

 Productivity app views: Pomodoro, Publisher. Tasks replaced by TrackerApp.

Section: Pomodoro View (view 11)
  draw-view-pomodoro : GopBuf, ShellUiState -> Integer
  draw-view-pomodoro (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Pomodoro"
    in let cx = x + work-w / 2 - 40
    in let dummy2 = draw-text-f gb wh cx 50 "25:00" col-accent font-role-mono
    in let dummy3 = draw-text-f gb wh (x + work-w / 2 - 20) 80 "WORK" col-red font-role-sans
    in let dummy4 = draw-gauge-bar gb (x + 40) 110 (work-w - 80) 10 0 1500 col-accent
    in let dummy5 = gop-buf-hline gb (x + 10) (x + work-w - 10) 140 col-sep
    in let dummy6 = draw-kv gb wh (x + 20) 156 "Cycle" "1 / 4" col-fg col-fg2
    in let dummy7 = draw-kv gb wh (x + 20) 174 "Total focus" "0 min" col-fg col-fg2
    in let dummy8 = draw-kv gb wh (x + 20) 192 "Work duration" "25 min" col-fg col-accent
    in let dummy9 = draw-kv gb wh (x + 20) 210 "Break duration" "5 min" col-fg col-teal
    in let dummy10 = gop-buf-hline gb (x + 10) (x + work-w - 10) 236 col-sep
    in let dummy11 = draw-text-f gb wh (x + 20) 252 "Space to start/pause" col-dim font-role-serif
    in draw-text-f gb wh (x + 20) 270 "R to reset timer" col-dim font-role-serif

Section: Publisher View (view 12)
  draw-view-publisher : GopBuf, ShellUiState -> Integer
  draw-view-publisher (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Publisher"
    in let ow = 130
    in let dummy2 = gop-buf-rect gb (x + 4) 28 ow (436 - 32) col-win-title
    in let dummy3 = draw-text-f gb wh (x + 10) 32 "Outline" col-accent font-role-sans
    in let dummy4 = gop-buf-hline gb (x + 8) (x + ow) 48 col-sep
    in let dummy5 = draw-text-f gb wh (x + 10) 56 "1. Introduction" col-fg font-role-serif
    in let dummy6 = draw-text-f gb wh (x + 10) 74 "2. Background" col-fg font-role-serif
    in let dummy7 = draw-text-f gb wh (x + 10) 92 "3. Methods" col-fg2 font-role-serif
    in let dummy8 = draw-text-f gb wh (x + 10) 110 "4. Results" col-fg2 font-role-serif
    in let dummy9 = draw-text-f gb wh (x + 10) 128 "5. Discussion" col-fg2 font-role-serif
    in let dummy10 = draw-text-f gb wh (x + 10) 146 "6. References" col-dim font-role-serif
    in let dummy11 = gop-buf-vline gb (x + ow + 4) 28 (28 + 436 - 32) col-sep
    in let dx = x + ow + 12
    in let dummy12 = draw-text-f gb wh dx 32 "Chapter 1: Introduction" col-accent font-role-sans
    in let dummy13 = gop-buf-hline gb dx (x + work-w - 10) 48 col-sep
    in let dummy14 = draw-text-f gb wh dx 56 "The Codex programming language was" col-fg2 font-role-serif
    in let dummy15 = draw-text-f gb wh dx 74 "designed from first principles to" col-fg2 font-role-serif
    in let dummy16 = draw-text-f gb wh dx 92 "combine dependent types, linear" col-fg2 font-role-serif
    in let dummy17 = draw-text-f gb wh dx 110 "resources, and effect tracking" col-fg2 font-role-serif
    in let dummy18 = draw-text-f gb wh dx 128 "into a single coherent system." col-fg2 font-role-serif
    in let dummy19 = gop-buf-hline gb dx (x + work-w - 10) 160 col-sep
    in draw-kv gb wh dx 170 "Words" "1,247  Pages: 4" col-dim col-dim

