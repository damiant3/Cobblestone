 Productivity app views: Pomodoro, Publisher. Tasks replaced by TrackerApp.

Section: Pomodoro View (view 11)
  draw-view-pomodoro : GopBuf, ShellUiState -> Integer
  draw-view-pomodoro (gb) (st) =
    let wh = st.su-wheel
    in let timer = widget-panel "pom-timer" DirColumn 4 [
      widget-label "pom-time" "25:00",
      widget-label "pom-phase" "WORK"
    ]
    in let bar = widget-gauge "pom-bar" 0 1500
    in let stats = widget-panel "pom-stats" DirColumn 2 [
      widget-label "pom-s1" "Cycle: 1 / 4",
      widget-label "pom-s2" "Total focus: 0 min",
      widget-label "pom-s3" "Work duration: 25 min",
      widget-label "pom-s4" "Break duration: 5 min"
    ]
    in let help = widget-panel "pom-help" DirColumn 2 [
      widget-label "pom-h1" "Space to start/pause",
      widget-label "pom-h2" "R to reset timer"
    ]
    in let tree = widget-panel "pom-root" DirColumn 8 [timer, bar, widget-separator "pom-sep1", stats, widget-separator "pom-sep2", help]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Publisher View (view 12)
  draw-view-publisher : GopBuf, ShellUiState -> Integer
  draw-view-publisher (gb) (st) =
    let wh = st.su-wheel
    in let outline = widget-panel "pub-outline" DirColumn 2 [
      widget-label "pub-oh" "Outline",
      widget-separator "pub-os",
      widget-label "pub-o1" "1. Introduction",
      widget-label "pub-o2" "2. Background",
      widget-label "pub-o3" "3. Methods",
      widget-label "pub-o4" "4. Results",
      widget-label "pub-o5" "5. Discussion",
      widget-label "pub-o6" "6. References"
    ]
    in let content = widget-panel "pub-content" DirColumn 2 [
      widget-label "pub-ch" "Chapter 1: Introduction",
      widget-separator "pub-cs",
      widget-label "pub-c1" "The Codex programming language was",
      widget-label "pub-c2" "designed from first principles to",
      widget-label "pub-c3" "combine dependent types, linear",
      widget-label "pub-c4" "resources, and effect tracking",
      widget-label "pub-c5" "into a single coherent system.",
      widget-separator "pub-cs2",
      widget-label "pub-wc" "Words: 1,247  Pages: 4"
    ]
    in let tree = widget-panel "pub-root" DirRow 4 [
      widget-set-min outline 130 0,
      content
    ]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

