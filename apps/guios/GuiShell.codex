Section: App Name Lookup
  app-name : Integer -> Text
  app-name (id) =
    if id == 1 then "Notes"
    else if id == 2 then "Calendar"
    else if id == 3 then "Tasks"
    else if id == 4 then "Pomodoro"
    else if id == 5 then "Books"
    else if id == 6 then "Publisher"
    else if id == 7 then "Music"
    else if id == 8 then "Piano"
    else if id == 9 then "Radio"
    else if id == 10 then "Recorder"
    else if id == 11 then "Photos"
    else if id == 12 then "Podcasts"
    else if id == 13 then "Spark 3D"
    else if id == 14 then "Capture"
    else if id == 15 then "ImgTools"
    else if id == 16 then "Diagram"
    else if id == 17 then "Designer"
    else if id == 18 then "Mail"
    else if id == 19 then "Chat"
    else if id == 20 then "Collab"
    else if id == 21 then "Helm"
    else if id == 22 then "Calculator"
    else if id == 23 then "Settings"
    else if id == 24 then "Monitor"
    else "Unknown"

  app-desc : Integer -> Text
  app-desc (id) =
    if id == 1 then "Two-pane note editor with formatting toolbar"
    else if id == 2 then "Month, week, and day views with event creation"
    else if id == 3 then "Five-column Kanban board with priorities"
    else if id == 4 then "Focus timer with daily goals and break reminders"
    else if id == 5 then "E-book reader with progress and bookmarks"
    else if id == 6 then "Long-form authoring with version history"
    else if id == 7 then "Music player with shuffle and liked filter"
    else if id == 8 then "Two-octave piano with keyboard input"
    else if id == 9 then "Two-deck radio station with mixer"
    else if id == 10 then "Voice recorder with waveform display"
    else if id == 11 then "Photo gallery with slideshow"
    else if id == 12 then "Podcast client with episode progress"
    else if id == 13 then "3D modeling, image editing, audio, video"
    else if id == 14 then "Screenshot tool with annotations"
    else if id == 15 then "Image editor with presets and sliders"
    else if id == 16 then "Flowcharts, ERDs, UML, state machines"
    else if id == 17 then "WYSIWYG UI widget tree builder"
    else if id == 18 then "Three-pane email client with compose"
    else if id == 19 then "End-to-end encrypted messaging"
    else if id == 20 then "Video calls, screen share, whiteboard"
    else if id == 21 then "Scalable comms: chat + voice channels"
    else if id == 22 then "Calculator with display and keypad"
    else if id == 23 then "Font, display, and language settings"
    else if id == 24 then "System resource monitor"
    else "Application"

