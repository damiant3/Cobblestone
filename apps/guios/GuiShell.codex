Section: Notepad View (F6)
  draw-view-notepad : GopBuf, ShellUiState -> Integer
  draw-view-notepad (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let nb = wh.mw-notepad
    in let len = mw-get-note-len wh
    in let dummy = draw-win gb wh x 4 work-w 436 "Notepad"
    in let cx = x + 10
    in let cy = 28
    in let dummy2 = notepad-draw-chars gb nb cx cy 0 len
    in let cursor-x = cx + notepad-cursor-x len 0 0
    in let cursor-y = cy + notepad-cursor-y len 0 0
    in let dummy3 = gop-buf-rect gb cursor-x cursor-y 2 14 col-accent
    in let dummy4 = gop-buf-hline gb cx (x + work-w - 10) (gui-h - taskbar-h - 30) col-sep
    in let dummy5 = draw-kv gb wh cx (gui-h - taskbar-h - 22) "Chars" (show len) col-dim col-dim
    in draw-kv gb wh (cx + 120) (gui-h - taskbar-h - 22) "F6 Notepad" "Type to edit, Backspace to delete" col-dim col-dim

  notepad-draw-chars : GopBuf, NotepadBuf, Integer, Integer, Integer, Integer -> Integer
  notepad-draw-chars (gb) (nb) (x) (y) (i) (len) =
    if i >= len then 0
    else let ch = notepad-get-char nb i
    in if ch == 1 then notepad-draw-chars gb nb x (y + 16) (i + 1) len
    else let px = x + notepad-line-x i nb 0 0
    in let dummy = gop-buf-put-char gb px y ch col-fg
    in notepad-draw-chars gb nb x y (i + 1) len

  notepad-line-x : Integer, NotepadBuf, Integer, Integer -> Integer
  notepad-line-x (target) (nb) (i) (col) =
    if i >= target then col * 9
    else let ch = notepad-get-char nb i
    in if ch == 1 then notepad-line-x target nb (i + 1) 0
    else notepad-line-x target nb (i + 1) (col + 1)

  notepad-cursor-x : Integer, Integer, Integer -> Integer
  notepad-cursor-x (target) (i) (col) =
    if i >= target then col * 9
    else notepad-cursor-x target (i + 1) (col + 1)

  notepad-cursor-y : Integer, Integer, Integer -> Integer
  notepad-cursor-y (target) (i) (lines) =
    if i >= target then lines * 16
    else notepad-cursor-y target (i + 1) lines

Section: Settings Key Handler
  gui-settings-key : ShellUiState, Integer, Integer -> Integer
  gui-settings-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let w = st.su-wheel
    in let role = mw-get-font-picker-role w
    in if sc == 72 then gui-settings-role-change w st (-1)
    else if sc == 80 then gui-settings-role-change w st 1
    else if sc == 75 then gui-settings-font-change w st role (-1)
    else if sc == 77 then gui-settings-font-change w st role 1
    else if sc == 73 then gui-settings-repeat-change w st 1
    else if sc == 81 then gui-settings-repeat-change w st (-1)
    else gui-idle (gui-render st) 0

  gui-settings-role-change : MutWheel, ShellUiState, Integer -> Integer
  gui-settings-role-change (w) (st) (delta) =
    let r = mw-get-font-picker-role w
    in let nr = r + delta
    in let clamped = if nr < 0 then 0 else if nr > 2 then 2 else nr
    in let d = mw-set-font-picker-role w clamped
    in gui-idle (gui-render st) 0

  gui-settings-font-change : MutWheel, ShellUiState, Integer, Integer -> Integer
  gui-settings-font-change (w) (st) (role) (delta) =
    let idx = gui-get-role-idx w role
    in let new-idx = idx + delta
    in let wrapped = if new-idx < 0 then 13 else if new-idx > 13 then 0 else new-idx
    in let codex-role = role + 1
    in let d1 = block-select 0
    in let vol = fat32-init 0
    in let d2 = fl-load-into-role vol w wrapped codex-role
    in gui-idle (gui-render st) 0

  gui-settings-repeat-change : MutWheel, ShellUiState, Integer -> Integer
  gui-settings-repeat-change (w) (st) (delta) =
    let cur = mw-get-key-repeat-delay w
    in let nv = cur + delta
    in let clamped = if nv < 1 then 1 else if nv > 36 then 36 else nv
    in let d = mw-set-key-repeat-delay w clamped
    in gui-idle (gui-render st) 0

  gui-get-role-idx : MutWheel, Integer -> Integer
  gui-get-role-idx (w) (role) =
    if role == 0 then mw-get-font-role-serif w
    else if role == 1 then mw-get-font-role-sans w
    else mw-get-font-role-mono w

Section: Settings View
  draw-view-settings : GopBuf, ShellUiState -> Integer
  draw-view-settings (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let loaded = mw-get-fonts-loaded wh
    in let dummy = draw-win gb wh x 4 work-w 436 "Settings"
    in let cx = x + 14
    in let cy = 30
    in let dummy2 = gop-buf-put-text-role gb wh cx cy "Display" col-accent font-role-sans
    in let dummy3 = gop-buf-hline gb cx (x + work-w - 14) (cy + 18) col-sep
    in let font-status = if loaded == 1 then "TrueType (loaded)" else "CBF (fallback)"
    in let picker = mw-get-font-picker-role wh
    in let dummy4 = draw-kv gb wh cx (cy + 26) "Font" font-status col-fg col-accent
    in let dummy5 = draw-kv gb wh cx (cy + 44) "Key repeat" (show (mw-get-key-repeat-delay wh) & " ticks (PgUp/PgDn)") col-fg col-dim
    in let dummy6 = gop-buf-hline gb cx (x + work-w - 14) (cy + 62) col-sep
    in let dummy7 = gop-buf-put-text-role gb wh cx (cy + 70) "Font Roles (Up/Down, Left/Right)" col-fg font-role-sans
    in let lx = cx + 60
    in let dummy8 = gop-buf-rect gb (cx - 4) (cy + 90) 3 18 (if picker == 0 then col-accent else col-bg)
    in let dummy8b = gop-buf-put-text-role gb wh cx (cy + 92) "Serif:" (if picker == 0 then col-accent else col-dim) font-role-sans
    in let dummy9 = gop-buf-put-text-role gb wh lx (cy + 92) (font-cat-name (mw-get-font-role-serif wh) & "  The quick brown fox") (if picker == 0 then col-fg else col-fg2) font-role-serif
    in let dummy10 = gop-buf-rect gb (cx - 4) (cy + 114) 3 18 (if picker == 1 then col-accent else col-bg)
    in let dummy10b = gop-buf-put-text-role gb wh cx (cy + 116) "Sans:" (if picker == 1 then col-accent else col-dim) font-role-sans
    in let dummy11 = gop-buf-put-text-role gb wh lx (cy + 116) (font-cat-name (mw-get-font-role-sans wh) & "  The quick brown fox") (if picker == 1 then col-fg else col-fg2) font-role-sans
    in let dummy12 = gop-buf-rect gb (cx - 4) (cy + 138) 3 18 (if picker == 2 then col-accent else col-bg)
    in let dummy12b = gop-buf-put-text-role gb wh cx (cy + 140) "Mono:" (if picker == 2 then col-accent else col-dim) font-role-sans
    in let dummy13 = gop-buf-put-text-role gb wh lx (cy + 140) (font-cat-name (mw-get-font-role-mono wh) & "  The quick brown fox") (if picker == 2 then col-fg else col-fg2) font-role-mono
    in let dummy14 = gop-buf-hline gb cx (x + work-w - 14) (cy + 164) col-sep
    in let dummy15 = gop-buf-put-text-role gb wh cx (cy + 172) "Encoding" col-accent font-role-sans
    in let dummy16 = draw-kv gb wh cx (cy + 192) "Tier 0" "128 (ASCII)" col-fg col-green
    in let dummy17 = draw-kv gb wh cx (cy + 210) "Tier 1" "2048 (EU)" col-fg col-green
    in draw-kv gb wh cx (cy + 228) "Tier 2" "CJK/Kana/Emoji" col-fg col-green

Section: Calendar View
  draw-view-calendar : GopBuf, ShellUiState -> Integer
  draw-view-calendar (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Calendar"
    in cal-draw gb wh (x + 4) 28 (work-w - 8)

Section: Calculator View
  draw-view-calc : GopBuf, ShellUiState -> Integer
  draw-view-calc (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Calculator"
    in calc-draw gb wh (x + 10) 28 (work-w - 20)

Section: Taskbar
  draw-taskbar : GopBuf, ShellUiState -> Integer
  draw-taskbar (gb) (st) =
    let ty = gui-h - taskbar-h
    in let wh = st.su-wheel
    in let dummy = gop-buf-rect gb 0 ty gui-w taskbar-h col-taskbar
    in let dummy2 = gop-buf-hline gb 0 (gui-w - 1) ty col-taskbar-top
    in let dummy3 = gop-buf-rect gb 2 (ty + 3) 50 24 col-start-bg
    in let dummy4 = gop-buf-put-text-role gb wh 8 (ty + 9) "Codex" col-fg font-role-sans
    in let dummy5 = gop-buf-vline gb 58 (ty + 4) (ty + 26) col-sep
    in let cv = mw-get-view wh
    in let dummy6 = draw-hotbar-item gb wh 64 ty "Sys" 0 cv
    in let dummy7 = draw-hotbar-item gb wh 114 ty "Mon" 1 cv
    in let dummy8 = draw-hotbar-item gb wh 164 ty "HW" 2 cv
    in let dummy9 = draw-hotbar-item gb wh 214 ty "Info" 3 cv
    in let dummy10b = draw-hotbar-item gb wh 264 ty "Apps" 4 cv
    in let dummy10 = gop-buf-vline gb (gui-w - 160) (ty + 4) (ty + 26) col-sep
    in let dummy11 = gop-buf-put-text-role gb wh (gui-w - 150) (ty + 4) (rtc-date) col-fg2 font-role-mono
    in gop-buf-put-text-role gb wh (gui-w - 150) (ty + 16) (rtc-time) col-fg font-role-mono

  draw-hotbar-item : GopBuf, MutWheel, Integer, Integer, Text, Integer, Integer -> Integer
  draw-hotbar-item (gb) (wh) (x) (ty) (label) (view-id) (active) =
    let bg = if view-id == active then col-hotbar-sel else col-taskbar
    in let fg = if view-id == active then col-accent else col-fg2
    in let dummy = gop-buf-rect gb x (ty + 3) 44 24 bg
    in let dummy2 = if view-id == active then gop-buf-hline gb x (x + 43) (ty + 1) col-accent else 0
    in gop-buf-put-text-role gb wh (x + 6) (ty + 9) label fg font-role-sans

Section: Drawing Helpers
  draw-win : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Text -> Integer
  draw-win (gb) (wh) (x) (y) (w) (h) (title) =
    let dummy = gop-buf-rect gb x y w h col-win-border
    in let dummy2 = gop-buf-rect gb (x + 1) (y + 1) (w - 2) (h - 2) col-win-body
    in let dummy3 = gop-buf-rect gb (x + 1) (y + 1) (w - 2) 20 col-win-title
    in gop-buf-put-text-role gb wh (x + 6) (y + 4) title col-fg font-role-sans

  draw-label : GopBuf, MutWheel, Integer, Integer, Text, Integer -> Integer
  draw-label (gb) (wh) (x) (y) (txt) (color) =
    gop-buf-put-text-role gb wh x y txt color font-role-sans

  draw-value : GopBuf, MutWheel, Integer, Integer, Text, Integer -> Integer
  draw-value (gb) (wh) (x) (y) (txt) (color) =
    gop-buf-put-text-role gb wh x y txt color font-role-mono

  draw-kv : GopBuf, MutWheel, Integer, Integer, Text, Text, Integer, Integer -> Integer
  draw-kv (gb) (wh) (x) (y) (key) (val) (kc) (vc) =
    let kw = gop-role-text-width wh font-role-sans key
    in let dummy = gop-buf-put-text-role gb wh x y key kc font-role-sans
    in gop-buf-put-text-role gb wh (x + kw + 9) y val vc font-role-mono

  draw-text-f : GopBuf, MutWheel, Integer, Integer, Text, Integer, Integer -> Integer
  draw-text-f (gb) (wh) (x) (y) (txt) (color) (role) =
    gop-buf-put-text-role gb wh x y txt color role

  draw-gauge-bar : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-gauge-bar (gb) (x) (y) (w) (h) (val) (max-val) (color) =
    let dummy = gop-buf-rect gb x y w h col-sep
    in let fill = if max-val > 0 then w * val / max-val else 0
    in gop-buf-rect gb x y fill h color

  draw-proc-row : GopBuf, MutWheel, Integer, Integer, Text, Text, Integer -> Integer
  draw-proc-row (gb) (wh) (x) (y) (name) (status) (color) =
    let dummy = gop-buf-put-text-role gb wh x y name col-fg2 font-role-mono
    in gop-buf-put-text-role gb wh (x + 100) y status color font-role-mono

