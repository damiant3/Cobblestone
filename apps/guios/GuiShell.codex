Section: Stub View
  view-stub : Text, Text -> WidgetNode
  view-stub (name) (desc) =
    widget-panel ("stub-" & name) DirColumn 4 [
      widget-label ("s-title-" & name) name,
      widget-separator ("s-sep-" & name),
      widget-label ("s-desc-" & name) desc,
      widget-label ("s-hint-" & name) "Use sidebar or F-keys to navigate"
    ]

Section: Notepad
  view-notepad : WidgetNode
  view-notepad =
    widget-panel "notepad" DirColumn 2 [
      widget-label "np-title" "Notepad",
      widget-separator "np-sep",
      widget-set-flex (widget-panel "np-edit" DirColumn 0 [
        widget-label "np-line1" "Type here to edit...",
        widget-label "np-line2" "",
        widget-label "np-line3" ""
      ]) 1,
      widget-separator "np-sep2",
      widget-label "np-status" "Ln 1, Col 0  |  UTF-8  |  LF"
    ]

Section: Calendar
  view-calendar : Text -> WidgetNode
  view-calendar (dt) =
    let hdr = widget-panel "cal-hdr" DirRow 4 [
      widget-label "cal-prev" "<",
      widget-set-flex (widget-label "cal-month" dt) 1,
      widget-label "cal-next" ">"
    ]
    in let days = widget-label "cal-days" "Su Mo Tu We Th Fr Sa"
    in widget-panel "calendar" DirColumn 2 [
      widget-label "cal-title" "Calendar",
      widget-separator "cal-sep",
      hdr, days,
      widget-label "cal-w1" " 1  2  3  4  5  6  7",
      widget-label "cal-w2" " 8  9 10 11 12 13 14",
      widget-label "cal-w3" "15 16 17 18 19 20 21",
      widget-label "cal-w4" "22 23 24 25 26 27 28",
      widget-label "cal-w5" "29 30"
    ]

Section: Calculator
  view-calc : WidgetNode
  view-calc =
    let display = widget-panel "calc-disp" DirColumn 0 [
      widget-label "calc-val" "0",
      widget-separator "calc-dsep"
    ]
    in let row1 = widget-panel "calc-r1" DirRow 4 [
      widget-label "c-7" "7", widget-label "c-8" "8",
      widget-label "c-9" "9", widget-label "c-div" "/"
    ]
    in let row2 = widget-panel "calc-r2" DirRow 4 [
      widget-label "c-4" "4", widget-label "c-5" "5",
      widget-label "c-6" "6", widget-label "c-mul" "*"
    ]
    in let row3 = widget-panel "calc-r3" DirRow 4 [
      widget-label "c-1" "1", widget-label "c-2" "2",
      widget-label "c-3" "3", widget-label "c-sub" "-"
    ]
    in let row4 = widget-panel "calc-r4" DirRow 4 [
      widget-label "c-0" "0", widget-label "c-dot" ".",
      widget-label "c-eq" "=", widget-label "c-add" "+"
    ]
    in widget-panel "calc" DirColumn 2 [
      widget-label "calc-title" "Calculator",
      widget-separator "calc-sep",
      display, row1, row2, row3, row4
    ]

Section: Productivity Apps
  view-tasks : WidgetNode
  view-tasks =
    widget-panel "tasks" DirColumn 2 [
      widget-label "tk-title" "Tasks (Kanban)",
      widget-separator "tk-sep",
      widget-label "tk-h1" "Backlog:  Item 1, Item 2",
      widget-label "tk-h2" "To Do:    Item 3",
      widget-label "tk-h3" "Doing:    Item 4",
      widget-label "tk-h4" "Done:     Item 5"
    ]

  view-pomodoro : WidgetNode
  view-pomodoro =
    widget-panel "pomo" DirColumn 4 [
      widget-label "pm-title" "Pomodoro Timer",
      widget-separator "pm-sep",
      widget-label "pm-time" "25:00",
      widget-gauge "pm-bar" 25 25,
      widget-separator "pm-sep2",
      widget-label "pm-status" "Ready  |  Sessions: 0  |  Goal: 4"
    ]

  view-publisher : WidgetNode
  view-publisher =
