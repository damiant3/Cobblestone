Section: App Name Lookup
  app-name : Integer -> Text
  app-name (id) =
    if id == 1 then "Notes"
    else if id == 2 then "Calendar"
    else if id == 3 then "Tasks"
    else if id == 4 then "Pomodoro"
    else if id == 5 then "Books"
    else if id == 6 then "Publisher"
    else if id == 7 then "Music"
    else if id == 8 then "Piano"
    else if id == 9 then "Radio"
    else if id == 10 then "Recorder"
    else if id == 11 then "Photos"
    else if id == 12 then "Podcasts"
    else if id == 13 then "Spark 3D"
    else if id == 14 then "Capture"
    else if id == 15 then "ImgTools"
    else if id == 16 then "Diagram"
    else if id == 17 then "Designer"
    else if id == 18 then "Mail"
    else if id == 19 then "Chat"
    else if id == 20 then "Collab"
    else if id == 21 then "Helm"
    else if id == 22 then "Calculator"
    else if id == 23 then "Settings"
    else if id == 24 then "Monitor"
    else "Unknown"

  app-desc : Integer -> Text
  app-desc (id) =
    if id == 1 then "Two-pane note editor with formatting toolbar"
    else if id == 2 then "Month, week, and day views with event creation"
    else if id == 3 then "Five-column Kanban board with priorities"
    else if id == 4 then "Focus timer with daily goals and break reminders"
    else if id == 5 then "E-book reader with progress and bookmarks"
    else if id == 6 then "Long-form authoring with version history"
    else if id == 7 then "Music player with shuffle and liked filter"
    else if id == 8 then "Two-octave piano with keyboard input"
    else if id == 9 then "Two-deck radio station with mixer"
    else if id == 10 then "Voice recorder with waveform display"
    else if id == 11 then "Photo gallery with slideshow"
    else if id == 12 then "Podcast client with episode progress"
    else if id == 13 then "3D modeling, image editing, audio, video"
    else if id == 14 then "Screenshot tool with annotations"
    else if id == 15 then "Image editor with presets and sliders"
    else if id == 16 then "Flowcharts, ERDs, UML, state machines"
    else if id == 17 then "WYSIWYG UI widget tree builder"
    else if id == 18 then "Three-pane email client with compose"
    else if id == 19 then "End-to-end encrypted messaging"
    else if id == 20 then "Video calls, screen share, whiteboard"
    else if id == 21 then "Scalable comms: chat + voice channels"
    else if id == 22 then "Calculator with display and keypad"
    else if id == 23 then "Font, display, and language settings"
    else if id == 24 then "System resource monitor"
    else "Application"

Section: Font Creator View
  draw-view-fonts : GopBuf, ShellUiState -> Integer
  draw-view-fonts (gb) (st) =
    let wh = st.su-wheel
    in let dummy = draw-win gb wh work-x 4 work-w (desk-h - 8) "Font Creator"
    in let sel = mw-get-app-s0 wh
    in let y0 = 26
    in let x0 = work-x + 8
    in let list-w = 180
    in let preview-x = x0 + list-w + 8
    in let preview-w = work-w - list-w - 24
    in let d1 = draw-font-list gb wh x0 y0 list-w sel
    in let d2 = draw-font-preview gb wh preview-x y0 preview-w sel
    in let help-y = desk-h - 30
    in gop-buf-put-text gb x0 help-y "Up/Down  browse generated font catalog" col-dim

  draw-font-list : GopBuf, MutWheel, Integer, Integer, Integer, Integer -> Integer
  draw-font-list (gb) (wh) (x) (y) (w) (sel) =
    let d1 = gop-buf-rect gb x y w 20 col-win-title
    in let d2 = gop-buf-put-text gb (x + 4) (y + 4) "Generated Fonts" col-accent
    in let d3 = draw-font-list-items gb wh x (y + 24) w sel 0 fg-font-count
    in gop-buf-vline gb (x + w + 3) y (y + fg-font-count * 40 + 24) col-sep

  draw-font-list-items : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-font-list-items (gb) (wh) (x) (y) (w) (sel) (i) (n) =
    if i >= n then 0
    else let row-y = y + i * 40
    in let bg = if i == sel then col-sidebar-sel else col-win-body
    in let d1 = gop-buf-rect gb x row-y w 38 bg
    in let name = fg-font-name i
    in let desc = font-trunc-desc (fg-font-desc i) (w / 9 - 2)
    in let d2 = gop-buf-put-text-role gb wh (x + 6) (row-y + 4) name col-fg font-role-sans
    in let d3 = gop-buf-put-text gb (x + 6) (row-y + 22) desc col-dim
    in draw-font-list-items gb wh x y w sel (i + 1) n

  font-trunc-desc : Text, Integer -> Text
  font-trunc-desc (s) (max-len) =
    if text-length s <= max-len then s
    else text-take s (max-len - 2) & ".."

  draw-font-preview : GopBuf, MutWheel, Integer, Integer, Integer, Integer -> Integer
  draw-font-preview (gb) (wh) (x) (y) (w) (sel) =
    let name = fg-font-name sel
    in let d1 = gop-buf-rect gb x y w 24 col-win-title
    in let d2 = gop-buf-put-text-role gb wh (x + 8) (y + 5) name col-accent font-role-sans
    in let py = y + 32
    in let d3 = gop-buf-put-text-role gb wh (x + 8) py "Active font preview:" col-dim font-role-sans
    in let d4 = gop-buf-put-text-role gb wh (x + 8) (py + 20) "The quick brown fox jumps" col-fg font-role-sans
    in let d5 = gop-buf-put-text-role gb wh (x + 8) (py + 36) "over the lazy dog." col-fg font-role-sans
    in let d6 = gop-buf-put-text-role gb wh (x + 8) (py + 60) "ABCDEFGHIJKLMNOPQRSTUVWXYZ" col-fg2 font-role-sans
    in let d7 = gop-buf-put-text-role gb wh (x + 8) (py + 76) "abcdefghijklmnopqrstuvwxyz" col-fg2 font-role-sans
    in let d8 = gop-buf-put-text-role gb wh (x + 8) (py + 96) "0123456789 !@#$%^&*()_+-=" col-fg2 font-role-sans
    in let d9 = gop-buf-put-text-role gb wh (x + 8) (py + 120) "Serif role:" col-dim font-role-serif
    in let d10 = gop-buf-put-text-role gb wh (x + 8) (py + 136) "The quick brown fox 0123456789" col-fg font-role-serif
    in let d11 = gop-buf-put-text-role gb wh (x + 8) (py + 160) "Sans role:" col-dim font-role-sans
    in let d12 = gop-buf-put-text-role gb wh (x + 8) (py + 176) "The quick brown fox 0123456789" col-fg font-role-sans
    in let d13 = gop-buf-put-text-role gb wh (x + 8) (py + 200) "Mono role:" col-dim font-role-mono
    in let d14 = gop-buf-put-text-role gb wh (x + 8) (py + 216) "The quick brown fox 0123456789" col-fg font-role-mono
    in let base-s = mw-get-font-serif-base wh
    in let base-a = mw-get-font-sans-base wh
    in let base-m = mw-get-font-mono-base wh
    in let gw-s = mw-get-font-serif-w wh
    in let gw-a = mw-get-font-sans-w wh
    in let gw-m = mw-get-font-mono-w wh
    in let d15 = gop-buf-put-text gb (x + 8) (py + 250) ("Serif: base=" & show base-s & " gw=" & show gw-s) (if base-s > 0 then col-green else col-red)
    in let d16 = gop-buf-put-text gb (x + 8) (py + 264) ("Sans:  base=" & show base-a & " gw=" & show gw-a) (if base-a > 0 then col-green else col-red)
    in gop-buf-put-text gb (x + 8) (py + 278) ("Mono:  base=" & show base-m & " gw=" & show gw-m) (if base-m > 0 then col-green else col-red)

  draw-glyph-dump : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-glyph-dump (gb) (base) (gw) (gh) (x) (y) (idx) =
    let d1 = gop-buf-put-text gb x y ("glyph " & show idx & " (" & show gw & "x" & show gh & ")") col-dim
    in draw-glyph-dump-rows gb base gw gh x (y + 12) idx 0

  draw-glyph-dump-rows : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-glyph-dump-rows (gb) (base) (gw) (gh) (x) (y) (idx) (row) =
    if row >= gh then 0
    else let d = draw-glyph-dump-cols gb base gw gh x y idx row 0
    in draw-glyph-dump-rows gb base gw gh x y idx (row + 1)

  draw-glyph-dump-cols : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-glyph-dump-cols (gb) (base) (gw) (gh) (x) (y) (idx) (row) (col) =
    if col >= gw then 0
    else let alpha = peek-byte base (idx * gw * gh + row * gw + col)
    in let color = if alpha > 200 then #FFFFFF else if alpha > 100 then #808080 else if alpha > 0 then #404040 else #0B0B1A
    in let d = gop-buf-rect gb (x + col * 4) (y + row * 4) 3 3 color
    in draw-glyph-dump-cols gb base gw gh x y idx row (col + 1)

  gui-fonts-key : ShellUiState, Integer, Integer -> Integer
  gui-fonts-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let wh = st.su-wheel
    in let sel = mw-get-app-s0 wh
    in let new-sel = if sc == 72 then (if sel <= 0 then 0 else sel - 1)
      else if sc == 80 then (if sel >= fg-font-count - 1 then fg-font-count - 1 else sel + 1)
      else sel
    in let changed = if new-sel /= sel then 1 else 0
    in let d1 = mw-set-app-s0 wh new-sel
    in let d2 = if changed == 1 then gui-fonts-load-all wh new-sel else 0
    in gui-idle (gui-render st) 0

  gui-fonts-load-all : MutWheel, Integer -> Integer
  gui-fonts-load-all (wh) (sel) =
    if sel == 0 then gui-restore-disk-fonts wh
    else let spec = if sel >= 5 then fai-gen-font fai-build-net (fg-font-name sel) (if sel == 5 then 0 else if sel == 6 then 500 else 1000)
      else fg-font-spec (sel - 1)
    in let d1 = fl-load-direct wh spec font-role-sans
    in let base = mw-get-font-sans-base wh
    in let gw = mw-get-font-sans-w wh
    in let d2 = mw-set-font-serif-base wh base
    in let d3 = mw-set-font-serif-w wh gw
    in let d4 = mw-set-font-mono-base wh base
    in let d5 = mw-set-font-mono-w wh gw
    in mw-set-fonts-loaded wh 1

  gui-restore-disk-fonts : MutWheel -> Integer
  gui-restore-disk-fonts (wh) =
    let vol = fat32-try-init 0
    in if vol.f32-bytes-per-sector == 0 then 0
    else if vol.f32-sectors-per-cluster == 0 then 0
    else fl-load-defaults vol wh

Section: App Stub View
  draw-view-app-stub : GopBuf, ShellUiState -> Integer
  draw-view-app-stub (gb) (st) =
    let wh = st.su-wheel
    in let app-id = mw-get-app wh
    in let name = app-name app-id
    in let desc = app-desc app-id
    in let tree = win-panel name [
      widget-label "stub-name" name,
      widget-label "stub-desc" desc,
      widget-separator "stub-sep1",
      widget-label "stub-t1" "This app is defined in the Codex source tree",
      widget-label "stub-t2" "and compiles to a standalone CDX binary.",
      widget-separator "stub-sep2",
      widget-label "stub-status" "Status: Available for integration",
      widget-label "stub-hint" "Click another app in the sidebar to switch"
    ]
    in let bounds = layout-rect work-x 4 work-w (desk-h - 8)
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Notepad View (F6)
  draw-view-notepad : GopBuf, ShellUiState -> Integer
  draw-view-notepad (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let nb = wh.mw-notepad
    in let len = mw-get-note-len wh
    in let dummy = draw-win gb wh x 4 work-w 436 "Notepad"
    in let cx = x + 10
    in let cy = 28
    in let dummy2 = notepad-draw-chars gb nb cx cy 0 len
    in let cursor-x = cx + notepad-cursor-x len 0 0
    in let cursor-y = cy + notepad-cursor-y len 0 0
    in let dummy3 = gop-buf-rect gb cursor-x cursor-y 2 14 col-accent
    in let dummy4 = gop-buf-hline gb cx (x + work-w - 10) (gui-h - taskbar-h - 30) col-sep
    in let dummy5 = draw-kv gb wh cx (gui-h - taskbar-h - 22) "Chars" (show len) col-dim col-dim
    in draw-kv gb wh (cx + 120) (gui-h - taskbar-h - 22) "F6 Notepad" "Type to edit, Backspace to delete" col-dim col-dim

  notepad-draw-chars : GopBuf, NotepadBuf, Integer, Integer, Integer, Integer -> Integer
  notepad-draw-chars (gb) (nb) (x) (y) (i) (len) =
    if i >= len then 0
    else let ch = notepad-get-char nb i
    in if ch == 1 then notepad-draw-chars gb nb x (y + 16) (i + 1) len
    else let px = x + notepad-line-x i nb 0 0
    in let dummy = gop-buf-put-char gb px y ch col-fg
    in notepad-draw-chars gb nb x y (i + 1) len

  notepad-line-x : Integer, NotepadBuf, Integer, Integer -> Integer
  notepad-line-x (target) (nb) (i) (col) =
    if i >= target then col * 9
    else let ch = notepad-get-char nb i
    in if ch == 1 then notepad-line-x target nb (i + 1) 0
    else notepad-line-x target nb (i + 1) (col + 1)

  notepad-cursor-x : Integer, Integer, Integer -> Integer
  notepad-cursor-x (target) (i) (col) =
    if i >= target then col * 9
    else notepad-cursor-x target (i + 1) (col + 1)

  notepad-cursor-y : Integer, Integer, Integer -> Integer
  notepad-cursor-y (target) (i) (lines) =
    if i >= target then lines * 16
    else notepad-cursor-y target (i + 1) lines

Section: Settings Key Handler
  gui-settings-key : ShellUiState, Integer, Integer -> Integer
  gui-settings-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let w = st.su-wheel
    in let role = mw-get-font-picker-role w
    in if sc == 72 then gui-settings-role-change w st (-1)
    else if sc == 80 then gui-settings-role-change w st 1
    else if sc == 75 then gui-settings-font-change w st role (-1)
    else if sc == 77 then gui-settings-font-change w st role 1
    else if sc == 73 then gui-settings-repeat-change w st 1
    else if sc == 81 then gui-settings-repeat-change w st (-1)
    else gui-idle (gui-render st) 0

  gui-settings-role-change : MutWheel, ShellUiState, Integer -> Integer
  gui-settings-role-change (w) (st) (delta) =
    let r = mw-get-font-picker-role w
    in let nr = r + delta
    in let clamped = if nr < 0 then 0 else if nr > 2 then 2 else nr
    in let d = mw-set-font-picker-role w clamped
    in gui-idle (gui-render st) 0

  gui-settings-font-change : MutWheel, ShellUiState, Integer, Integer -> Integer
  gui-settings-font-change (w) (st) (role) (delta) =
    let idx = gui-get-role-idx w role
    in let new-idx = idx + delta
    in let wrapped = if new-idx < 0 then 13 else if new-idx > 13 then 0 else new-idx
    in let codex-role = role + 1
    in let d1 = block-select 0
    in let vol = fat32-init 0
    in let d2 = fl-load-into-role vol w wrapped codex-role
    in gui-idle (gui-render st) 0

  gui-settings-repeat-change : MutWheel, ShellUiState, Integer -> Integer
  gui-settings-repeat-change (w) (st) (delta) =
    let cur = mw-get-key-repeat-delay w
    in let nv = cur + delta
    in let clamped = if nv < 1 then 1 else if nv > 36 then 36 else nv
    in let d = mw-set-key-repeat-delay w clamped
    in gui-idle (gui-render st) 0

  gui-get-role-idx : MutWheel, Integer -> Integer
  gui-get-role-idx (w) (role) =
    if role == 0 then mw-get-font-role-serif w
    else if role == 1 then mw-get-font-role-sans w
    else mw-get-font-role-mono w

Section: Settings View
  draw-view-settings : GopBuf, ShellUiState -> Integer
  draw-view-settings (gb) (st) =
    let wh = st.su-wheel
    in let loaded = mw-get-fonts-loaded wh
    in let font-status = if loaded == 1 then "TrueType (loaded)" else "CBF (fallback)"
    in let picker = mw-get-font-picker-role wh
    in let display-section = widget-panel "set-disp" DirColumn 2 [
      widget-label "set-dh" "Display",
      widget-separator "set-ds",
      widget-label "set-font" ("Font  " & font-status),
      widget-label "set-repeat" ("Key repeat  " & show (mw-get-key-repeat-delay wh) & " ticks (PgUp/PgDn)")
    ]
    in let serif-label = "Serif:  " & font-cat-name (mw-get-font-role-serif wh) & "  The quick brown fox"
    in let sans-label = "Sans:  " & font-cat-name (mw-get-font-role-sans wh) & "  The quick brown fox"
    in let mono-label = "Mono:  " & font-cat-name (mw-get-font-role-mono wh) & "  The quick brown fox"
    in let roles-section = widget-panel "set-roles" DirColumn 2 [
      widget-label "set-rh" "Font Roles (Up/Down, Left/Right)",
      widget-separator "set-rs",
      widget-label "set-serif" serif-label,
      widget-label "set-sans" sans-label,
      widget-label "set-mono" mono-label
    ]
    in let enc-section = widget-panel "set-enc" DirColumn 2 [
      widget-label "set-eh" "Encoding",
      widget-separator "set-es",
      widget-label "set-e0" "Tier 0  128 (ASCII)",
      widget-label "set-e1" "Tier 1  2048 (EU)",
      widget-label "set-e2" "Tier 2  CJK/Kana/Emoji"
    ]
    in let tree = win-panel "Settings" [display-section, widget-separator "set-sep1", roles-section, widget-separator "set-sep2", enc-section]
    in let bounds = layout-rect work-x 4 work-w (desk-h - 8)
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

Section: Calendar View
  draw-view-calendar : GopBuf, ShellUiState -> Integer
  draw-view-calendar (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Calendar"
    in cal-draw gb wh (x + 4) 28 (work-w - 8)

Section: Calculator View
  draw-view-calc : GopBuf, ShellUiState -> Integer
  draw-view-calc (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Calculator"
    in calc-draw gb wh (x + 10) 28 (work-w - 20)

Section: Taskbar
  draw-taskbar : GopBuf, ShellUiState -> Integer
  draw-taskbar (gb) (st) =
    let ty = gui-h - taskbar-h
    in let wh = st.su-wheel
    in let dummy = gop-buf-rect gb 0 ty gui-w taskbar-h col-taskbar
    in let dummy2 = gop-buf-hline gb 0 (gui-w - 1) ty col-taskbar-top
    in let dummy3 = gop-buf-rect gb 2 (ty + 3) 50 24 col-start-bg
    in let dummy4 = gop-buf-put-text-role gb wh 8 (ty + 9) "Codex" col-fg font-role-sans
    in let dummy5 = gop-buf-vline gb 58 (ty + 4) (ty + 26) col-sep
    in let cv = mw-get-view wh
    in let dummy6 = draw-hotbar-item gb wh 64 ty "Sys" 0 cv
    in let dummy7 = draw-hotbar-item gb wh 114 ty "Mon" 1 cv
    in let dummy8 = draw-hotbar-item gb wh 164 ty "HW" 2 cv
    in let dummy9 = draw-hotbar-item gb wh 214 ty "Info" 3 cv
    in let dummy10b = draw-hotbar-item gb wh 264 ty "Apps" 4 cv
    in let dummy10 = gop-buf-vline gb (gui-w - 160) (ty + 4) (ty + 26) col-sep
    in let dummy11 = gop-buf-put-text-role gb wh (gui-w - 150) (ty + 4) (rtc-date) col-fg2 font-role-mono
    in gop-buf-put-text-role gb wh (gui-w - 150) (ty + 16) (rtc-time) col-fg font-role-mono

  draw-hotbar-item : GopBuf, MutWheel, Integer, Integer, Text, Integer, Integer -> Integer
  draw-hotbar-item (gb) (wh) (x) (ty) (label) (view-id) (active) =
    let bg = if view-id == active then col-hotbar-sel else col-taskbar
    in let fg = if view-id == active then col-accent else col-fg2
    in let dummy = gop-buf-rect gb x (ty + 3) 44 24 bg
    in let dummy2 = if view-id == active then gop-buf-hline gb x (x + 43) (ty + 1) col-accent else 0
    in gop-buf-put-text-role gb wh (x + 6) (ty + 9) label fg font-role-sans

Section: Drawing Helpers
  draw-win : GopBuf, MutWheel, Integer, Integer, Integer, Integer, Text -> Integer
  draw-win (gb) (wh) (x) (y) (w) (h) (title) =
    let dummy = gop-buf-rect gb x y w h col-win-border
    in let dummy2 = gop-buf-rect gb (x + 1) (y + 1) (w - 2) (h - 2) col-win-body
    in let dummy3 = gop-buf-rect gb (x + 1) (y + 1) (w - 2) 20 col-win-title
    in gop-buf-put-text-role gb wh (x + 6) (y + 4) title col-fg font-role-sans

  draw-label : GopBuf, MutWheel, Integer, Integer, Text, Integer -> Integer
  draw-label (gb) (wh) (x) (y) (txt) (color) =
    gop-buf-put-text-role gb wh x y txt color font-role-sans

  draw-value : GopBuf, MutWheel, Integer, Integer, Text, Integer -> Integer
  draw-value (gb) (wh) (x) (y) (txt) (color) =
    gop-buf-put-text-role gb wh x y txt color font-role-mono

  draw-kv : GopBuf, MutWheel, Integer, Integer, Text, Text, Integer, Integer -> Integer
  draw-kv (gb) (wh) (x) (y) (key) (val) (kc) (vc) =
    let kw = gop-role-text-width wh font-role-sans key
    in let dummy = gop-buf-put-text-role gb wh x y key kc font-role-sans
    in gop-buf-put-text-role gb wh (x + kw + 9) y val vc font-role-mono

  draw-text-f : GopBuf, MutWheel, Integer, Integer, Text, Integer, Integer -> Integer
  draw-text-f (gb) (wh) (x) (y) (txt) (color) (role) =
    gop-buf-put-text-role gb wh x y txt color role

  draw-gauge-bar : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-gauge-bar (gb) (x) (y) (w) (h) (val) (max-val) (color) =
    let dummy = gop-buf-rect gb x y w h col-sep
    in let fill = if max-val > 0 then w * val / max-val else 0
    in gop-buf-rect gb x y fill h color

  draw-proc-row : GopBuf, MutWheel, Integer, Integer, Text, Text, Integer -> Integer
  draw-proc-row (gb) (wh) (x) (y) (name) (status) (color) =
    let dummy = gop-buf-put-text-role gb wh x y name col-fg2 font-role-mono
    in gop-buf-put-text-role gb wh (x + 100) y status color font-role-mono

