    ]

Section: Media Apps
  view-boombox : WidgetNode
  view-boombox =
    widget-panel "boom" DirColumn 2 [
      widget-label "bm-title" "Boombox",
      widget-separator "bm-sep",
      widget-label "bm-np" "Now Playing: --",
      widget-gauge "bm-prog" 0 100,
      widget-separator "bm-sep2",
      widget-label "bm-t1" "1. Track One         3:42",
      widget-label "bm-t2" "2. Track Two         4:15",
      widget-label "bm-t3" "3. Track Three       2:58",
      widget-label "bm-t4" "4. Track Four        5:21",
      widget-separator "bm-sep3",
      widget-label "bm-ctrl" "[Prev]  [Play]  [Next]  [Shuffle]"
    ]

  view-piano : WidgetNode
  view-piano =
    let keys = widget-panel "pn-keys" DirRow 1 [
      widget-label "k-c" " C ", widget-label "k-d" " D ",
      widget-label "k-e" " E ", widget-label "k-f" " F ",
      widget-label "k-g" " G ", widget-label "k-a" " A ",
      widget-label "k-b" " B ", widget-label "k-c2" " C2"
    ]
    in widget-panel "piano" DirColumn 4 [
      widget-label "pn-title" "Piano",
      widget-separator "pn-sep",
      widget-label "pn-oct" "Octave 4  |  Keys: A S D F G H J K",
      keys,
      widget-separator "pn-sep2",
      widget-label "pn-hint" "Press A-K to play notes"
    ]

