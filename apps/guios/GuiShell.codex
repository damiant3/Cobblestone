 Bare-metal GUI desktop for Codex.OS. Uses the BareApp framework for
 input polling, event dispatch, and GPU triangle rendering. App sidebar
 on the left, taskbar at the bottom, workspace in the center.

Section: Screen
  gui-w : Integer = 1024
  gui-h : Integer = 768
  gui-max-tris : Integer = 24000
  sidebar-w : Integer = 160
  taskbar-h : Integer = 24

Section: State
  ShellState = record {
    ss-app : BareApp,
    ss-wheel : MutWheel,
    ss-active : Integer,
    ss-view : Integer,
    ss-fb : GopBuf,
    ss-date : Text,
    ss-time : Text
  }

Section: RTC Clock

 Port I/O is effectful, so the loop samples the clock once per frame
 and the pure widget builders receive the text through ShellState.

  rtc-read : Integer -> [Device.Port] Integer
  rtc-read (reg) = act
    w <- port-out-byte 112 reg
    port-in-byte 113
  end

  bcd-dec : Integer -> Integer
  bcd-dec (v) = (bit-shru v 4) * 10 + bit-and v 15

  rtc-pad2 : Integer -> Text
  rtc-pad2 (n) = let d = bcd-dec n in if d < 10 then "0" & show d else show d

  rtc-time : [Device.Port] Text
  rtc-time = act
    hh <- rtc-read 4
    mm <- rtc-read 2
    sec <- rtc-read 0
    let t = rtc-pad2 hh & ":" & rtc-pad2 mm & ":" & rtc-pad2 sec
    in t
  end

  rtc-date : [Device.Port] Text
  rtc-date = act
    yy <- rtc-read 9
    mo <- rtc-read 8
    dd <- rtc-read 7
    let t = "20" & rtc-pad2 yy & "-" & rtc-pad2 mo & "-" & rtc-pad2 dd
    in t
  end

Section: Font Loading
  gui-try-load-fonts : MutWheel -> [Device.Block] Integer
  gui-try-load-fonts (w) = act
    d0 <- block-select 0
    d1 <- fl-init-cache w
    vol <- fat32-try-init 0
    if vol.f32-bytes-per-sector == 0 then gui-load-fallback w
    else if vol.f32-sectors-per-cluster == 0 then gui-load-fallback w
    else fl-load-defaults vol w
  end

  gui-load-fallback : MutWheel -> Integer
  gui-load-fallback (w) =
    let d1 = fl-load-block-font w 1
    in let d2 = fl-load-block-font w 2
    in let d3 = fl-load-block-font w 3
    in mw-set-fonts-loaded w 1

  fat32-try-init : Integer -> [Device.Block] Fat32Volume
  fat32-try-init (part-start) = act
    buf <- block-read-sector part-start
    let bps = fat16-read-u16 buf 11
    in let spc = peek-byte buf 13
    in if spc == 0 then Fat32Volume {
      f32-part-start = 0, f32-bytes-per-sector = 0,
      f32-sectors-per-cluster = 0, f32-reserved-sectors = 0,
      f32-num-fats = 0, f32-fat-sectors = 0,
      f32-root-cluster = 0, f32-fat-start = 0,
      f32-data-start = 0, f32-total-clusters = 0,
      f32-next-free = 0
    }
    else fat32-init part-start
  end

Section: Framebuffer Text Overlay
  gop-fb-base-addr : Integer = 3204448256

  fb-overlay-new : Integer, Integer -> GopBuf
  fb-overlay-new (w) (h) =
    GopBuf { gb-base = gop-fb-base-addr, gb-width = w, gb-height = h }

Section: Entry Point
  opening : [Console, Device.Port, Device.Block, Gpu.Compute, Gpu.Memory] Nothing = act
    let w0 = mw-new
    in let w1 = mw-schedule w0 18 mtw-tag-clock
    in let w2 = mw-schedule w1 90 mtw-tag-heartbeat
    in act
      d-fonts <- gui-try-load-fonts w2
      dt <- rtc-date
      tm <- rtc-time
      let fb = fb-overlay-new gui-w gui-h
      in let root = shell-build-root 0 0 dt tm
      in let ba = bare-app-new root theme-terminal gui-w gui-h gui-max-tris
      in let ss = ShellState { ss-app = ba, ss-wheel = w2, ss-active = 0, ss-view = 0, ss-fb = fb, ss-date = dt, ss-time = tm }
      in act
        frames <- shell-loop ss
        print-line ("Codex.OS | " & show frames & " frames")
      end
    end
  end

Section: Main Loop
  shell-loop : ShellState -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  shell-loop (ss) = act
    ba2 <- bare-app-tick (ss.ss-app)
    dt <- rtc-date
    tm <- rtc-time
    let ss1 = shell-set-clock ss dt tm
    in let ss2 = shell-process-input ss1 ba2
    in act
      rendered <- shell-composite-render ss2
      pace <- shell-frame-pace 0
      if (ss2.ss-app).ba-quit then ss2.ss-view
      else shell-loop ss2
    end
  end

  shell-set-clock : ShellState, Text, Text -> ShellState
  shell-set-clock (ss) (dt) (tm) =
    ShellState { ss-app = ss.ss-app, ss-wheel = ss.ss-wheel, ss-active = ss.ss-active, ss-view = ss.ss-view, ss-fb = ss.ss-fb, ss-date = dt, ss-time = tm }

  shell-frame-pace : Integer -> [Device.Port] Integer
  shell-frame-pace (i) = act
    if i >= 30 then 0
    else act
      y <- port-out-byte 224 0
      shell-frame-pace (i + 1)
    end
  end

Section: Composite Render
  shell-composite-render : ShellState -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  shell-composite-render (ss) = act
    let root = ((ss.ss-app).ba-state).app-root
    in let th = ((ss.ss-app).ba-state).app-theme
    in act
      d1 <- gr-clear ((th.th-palette).pal-bg)
      d2 <- gr-clear-depth
      d3 <- gr-flush ((composite-walk-gpu (gf-new gui-max-tris) root th 10000).gf-idx)
      composite-walk-text (ss.ss-fb) (ss.ss-wheel) root #E2E8F0
    end
  end

  composite-walk-gpu : GpuFrame, WidgetNode, Theme, Integer -> [Gpu.Memory] GpuFrame
  composite-walk-gpu (gf) (node) (th) (depth) =
    composite-gpu-children (composite-gpu-node gf node th depth) (node.wn-children) th depth 0 (node.wn-child-count)

  composite-gpu-children : GpuFrame, List WidgetNode, Theme, Integer, Integer, Integer -> [Gpu.Memory] GpuFrame
  composite-gpu-children (gf) (children) (th) (depth) (i) (n) =
    if i >= n then gf
    else composite-gpu-children (composite-walk-gpu gf (list-at children i) th depth) children th depth (i + 1) n

  composite-gpu-node : GpuFrame, WidgetNode, Theme, Integer -> [Gpu.Memory] GpuFrame
  composite-gpu-node (gf) (node) (th) (depth) =
    when node.wn-kind
      is WkPanel -> gr-render-panel gf node th depth
      is WkSeparator -> gr-render-separator gf node th depth
      is WkGauge (v) (m) -> gr-render-gauge gf node th v m depth
      is WkButton (txt) -> gr-render-panel gf node th depth
      is otherwise -> gf

  composite-walk-text : GopBuf, MutWheel, WidgetNode, Integer -> Integer
  composite-walk-text (fb) (w) (node) (fg) =
    let d1 = composite-text-node fb w node fg
    in let d2 = composite-text-children fb w (node.wn-children) fg 0 (node.wn-child-count)
    in d1 + d2

  composite-text-children : GopBuf, MutWheel, List WidgetNode, Integer, Integer, Integer -> Integer
  composite-text-children (fb) (w) (children) (fg) (i) (n) =
    if i >= n then 0
    else let d = composite-walk-text fb w (list-at children i) fg
    in composite-text-children fb w children fg (i + 1) n

  composite-text-node : GopBuf, MutWheel, WidgetNode, Integer -> Integer
  composite-text-node (fb) (w) (node) (fg) =
    let bounds = node.wn-bounds
    in let x = bounds.lr-x + 4
    in let y = bounds.lr-y + 3
    in when node.wn-kind
      is WkLabel (txt) -> gop-buf-put-text-role fb w x y txt fg font-role-sans
      is WkButton (txt) -> gop-buf-put-text-role fb w (x + 4) (y + 2) txt fg font-role-sans
      is otherwise -> 0

  shell-process-input : ShellState, BareApp -> ShellState
  shell-process-input (ss) (ba) =
    let ri = bare-app-input ba
    in let key = ri-key-pressed ri
    in let clicked = ri-left-down ri
    in let mx = ri.ri-mx
    in let my = ri.ri-my
    in let w = ss.ss-wheel
    in let d1 = mw-tick w
    in let tag = mw-check-and-fire w
    in let d2 = if tag == mtw-tag-clock then let rr = mw-schedule w 18 mtw-tag-clock in 0
      else if tag == mtw-tag-heartbeat then let rr = mw-schedule w 90 mtw-tag-heartbeat in 0
      else 0
    in let ss2 = shell-handle-key ss ba key
    in let ss3 = if clicked then shell-handle-click ss2 mx my else ss2
    in if tag > 0 then shell-rebuild ss3
    else ss3

  shell-handle-key : ShellState, BareApp, Integer -> ShellState
  shell-handle-key (ss) (ba) (key) =
    if key == 1 then ShellState { ss-app = bare-app-set-quit ba, ss-wheel = ss.ss-wheel, ss-active = ss.ss-active, ss-view = ss.ss-view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }
    else if key == 59 then shell-set-view ss ba 0
    else if key == 60 then shell-set-view ss ba 1
    else if key == 61 then shell-set-view ss ba 2
    else if key == 62 then shell-set-view ss ba 3
    else if key == 63 then shell-set-view ss ba 4
    else if key == 72 then shell-nav-up ss ba
    else if key == 80 then shell-nav-down ss ba
    else if key == 28 then shell-nav-activate ss ba
    else ShellState { ss-app = ba, ss-wheel = ss.ss-wheel, ss-active = ss.ss-active, ss-view = ss.ss-view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-handle-click : ShellState, Integer, Integer -> ShellState
  shell-handle-click (ss) (mx) (my) =
    if mx < sidebar-w then shell-sidebar-click ss my
    else if my >= gui-h - taskbar-h then shell-hotbar-click ss mx
    else ss

  shell-sidebar-click : ShellState, Integer -> ShellState
  shell-sidebar-click (ss) (my) =
    let top = 38
    in let row-h = 17
    in let slot = (my - top) / row-h
    in if my < top then ss
    else if slot >= 21 then ss
    else let view = slot + 5
    in let root = shell-build-root view slot (ss.ss-date) (ss.ss-time)
    in ShellState { ss-app = bare-app-set-root (ss.ss-app) root, ss-wheel = ss.ss-wheel, ss-active = slot, ss-view = view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-hotbar-click : ShellState, Integer -> ShellState
  shell-hotbar-click (ss) (mx) =
    let x0 = sidebar-w + 50
    in let btn = (mx - x0) / 40
    in if mx < x0 then ss
    else if btn > 4 then ss
    else shell-set-view ss (ss.ss-app) btn

  shell-set-view : ShellState, BareApp, Integer -> ShellState
  shell-set-view (ss) (ba) (v) =
    let root = shell-build-root v (ss.ss-active) (ss.ss-date) (ss.ss-time)
    in ShellState { ss-app = bare-app-set-root ba root, ss-wheel = ss.ss-wheel, ss-active = ss.ss-active, ss-view = v, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-rebuild : ShellState -> ShellState
  shell-rebuild (ss) =
    let root = shell-build-root (ss.ss-view) (ss.ss-active) (ss.ss-date) (ss.ss-time)
    in ShellState { ss-app = bare-app-set-root (ss.ss-app) root, ss-wheel = ss.ss-wheel, ss-active = ss.ss-active, ss-view = ss.ss-view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-nav-up : ShellState, BareApp -> ShellState
  shell-nav-up (ss) (ba) =
    let cur = ss.ss-active
    in let next = if cur <= 0 then 20 else cur - 1
    in let view = next + 5
    in let root = shell-build-root view next (ss.ss-date) (ss.ss-time)
    in ShellState { ss-app = bare-app-set-root ba root, ss-wheel = ss.ss-wheel, ss-active = next, ss-view = view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-nav-down : ShellState, BareApp -> ShellState
  shell-nav-down (ss) (ba) =
    let cur = ss.ss-active
    in let next = if cur >= 20 then 0 else cur + 1
    in let view = next + 5
    in let root = shell-build-root view next (ss.ss-date) (ss.ss-time)
    in ShellState { ss-app = bare-app-set-root ba root, ss-wheel = ss.ss-wheel, ss-active = next, ss-view = view, ss-fb = ss.ss-fb, ss-date = ss.ss-date, ss-time = ss.ss-time }

  shell-nav-activate : ShellState, BareApp -> ShellState
  shell-nav-activate (ss) (ba) =
    let view = ss.ss-active + 5
    in shell-set-view ss ba view

Section: Widget Tree

 The builders are pure: the clock text arrives as data, sampled once
 per frame by the loop.

  shell-build-root : Integer, Integer, Text, Text -> WidgetNode
  shell-build-root (view) (active) (dt) (tm) =
    let sidebar = shell-build-sidebar view active
    in let content = shell-build-content view dt tm
    in let taskbar = shell-build-taskbar view dt tm
    in let right = widget-panel "right" DirColumn 0 [content, taskbar]
    in widget-panel "root" DirRow 0 [sidebar, right]

Section: Sidebar
  shell-build-sidebar : Integer, Integer -> WidgetNode
  shell-build-sidebar (view) (active) =
    let logo = widget-set-min (widget-label "logo" "CODEX OS") sidebar-w 20
    in let sep = widget-separator "nav-sep"
    in widget-set-min (widget-panel "sidebar" DirColumn 1 [
      logo, sep,
      shell-nav-btn "Notes" 0 active view,
      shell-nav-btn "Calendar" 1 active view,
      shell-nav-btn "Calc" 2 active view,
      shell-nav-btn "Settings" 3 active view,
      shell-nav-btn "Tasks" 4 active view,
      shell-nav-btn "Pomodoro" 5 active view,
      shell-nav-btn "Publisher" 6 active view,
      shell-nav-btn "Boombox" 7 active view,
      shell-nav-btn "Piano" 8 active view,
      shell-nav-btn "Photos" 9 active view,
      shell-nav-btn "Podcasts" 10 active view,
      shell-nav-btn "Capture" 11 active view,
      shell-nav-btn "ImgTools" 12 active view,
      shell-nav-btn "Diagram" 13 active view,
      shell-nav-btn "Designer" 14 active view,
      shell-nav-btn "Mail" 15 active view,
      shell-nav-btn "Chat" 16 active view,
      shell-nav-btn "Collab" 17 active view,
      shell-nav-btn "Helm" 18 active view,
      shell-nav-btn "Diffusion" 19 active view,
      shell-nav-btn "Fonts" 20 active view
    ]) sidebar-w 0

  shell-nav-btn : Text, Integer, Integer, Integer -> WidgetNode
  shell-nav-btn (label) (idx) (active) (view) =
    if idx == active then widget-label ("nav-" & show idx) ("> " & label & " <")
    else widget-label ("nav-" & show idx) ("  " & label)

Section: Taskbar
  shell-build-taskbar : Integer, Text, Text -> WidgetNode
  shell-build-taskbar (view) (dt) (tm) =
    let codex-lbl = widget-label "tb-codex" "Codex"
    in let sys = widget-label "tb-sys" (if view == 0 then "[Sys]" else " Sys ")
    in let mon = widget-label "tb-mon" (if view == 1 then "[Mon]" else " Mon ")
    in let hw = widget-label "tb-hw" (if view == 2 then "[HW]" else " HW ")
    in let info = widget-label "tb-info" (if view == 3 then "[Info]" else " Info ")
    in let apps = widget-label "tb-apps" (if view == 4 then "[Apps]" else " Apps ")
    in let spacer = widget-set-flex (widget-label "tb-space" "") 1
    in let clock = widget-label "tb-clock" (dt & " " & tm)
    in widget-set-min (widget-panel "taskbar" DirRow 4 [codex-lbl, sys, mon, hw, info, apps, spacer, clock]) 0 taskbar-h

Section: Content Dispatch
  shell-build-content : Integer, Text, Text -> WidgetNode
  shell-build-content (view) (dt) (tm) =
    let body = if view == 0 then view-dashboard dt tm
      else if view == 1 then view-monitor tm
      else if view == 2 then view-hardware
      else if view == 3 then view-about
      else if view == 4 then view-apps
      else if view == 5 then view-notepad
      else if view == 6 then view-calendar dt
      else if view == 7 then view-calc
      else if view == 8 then view-settings
      else if view == 9 then view-tasks
      else if view == 10 then view-pomodoro
      else if view == 11 then view-publisher
      else if view == 12 then view-boombox
      else if view == 13 then view-piano
      else if view == 14 then view-photos
      else if view == 15 then view-podcasts
      else if view == 16 then view-capture
      else if view == 17 then view-imgtools
      else if view == 18 then view-diagram
      else if view == 19 then view-designer
      else if view == 20 then view-mail
      else if view == 21 then view-chat
      else if view == 22 then view-collab
      else if view == 23 then view-helm
      else if view == 24 then view-diffusion
      else if view == 25 then view-fonts
      else view-stub "Unknown" "No view for this ID"
    in widget-set-flex body 1

Section: Dashboard (F1)
  view-dashboard : Text, Text -> WidgetNode
  view-dashboard (dt) (tm) =
    let ticks = get-ticks
    in let heap = __heap-save
    in let heap-mb = heap / 1048576
    in widget-panel "dashboard" DirColumn 2 [
      widget-label "d-welcome" "Welcome to Codex OS",
      widget-separator "d-sep0",
      widget-label "d-clock" (dt & "  " & tm),
      widget-label "d-uptime" ("Uptime: " & show (ticks / 18) & "s"),
      widget-label "d-heap" ("Memory: " & show heap-mb & " MB used / 3072 MB"),
      widget-gauge "d-hbar" heap-mb 3072,
      widget-separator "d-sep1",
      widget-label "d-ktitle" "Keyboard Shortcuts",
      widget-label "d-k1" "F1 Dashboard  F2 Monitor  F3 Hardware",
      widget-label "d-k2" "F4 About      F5 Apps catalog",
      widget-label "d-k3" "Up/Down  Navigate sidebar",
      widget-label "d-k4" "Enter    Open selected app",
      widget-label "d-k5" "Esc      Exit Codex OS",
      widget-separator "d-sep2",
      widget-label "d-info" "21 apps | GPU triangle render | 5x7 bitmap font"
    ]

Section: Monitor (F2)
  view-monitor : Text -> WidgetNode
  view-monitor (tm) =
    let ticks = get-ticks
    in let heap = __heap-save
    in let heap-mb = heap / 1048576
    in widget-panel "monitor" DirColumn 2 [
      widget-label "m-title" "Performance Monitor",
      widget-separator "m-sep1",
      widget-label "m-clock" ("Clock: " & tm),
      widget-label "m-timer" ("Ticks: " & show ticks),
      widget-label "m-uptime" ("Uptime: " & show (ticks / 18) & "s"),
      widget-separator "m-sep1b",
      widget-label "m-heap" ("Heap: " & show heap-mb & " MB / 3072 MB"),
      widget-gauge "m-hbar" heap-mb 3072,
      widget-separator "m-sep2",
      widget-label "m-proc" "Processes:",
      widget-label "m-p1" "  kernel     running    PID 0",
      widget-label "m-p2" "  gui-shell  running    PID 1",
      widget-label "m-p3" "  keyboard   listening  IRQ 1",
      widget-label "m-p4" "  mouse      polling    port E1-E4",
      widget-label "m-p5" "  timer      irq-0      PIT 18Hz",
      widget-label "m-p6" "  ide        ready      port 1F0",
      widget-label "m-p7" "  nic        standby    NE2K 300",
      widget-label "m-p8" "  hda        idle       port FE000000"
    ]

