Section: Monitor View (F2)
  draw-view-monitor : GopBuf, ShellUiState -> Integer
  draw-view-monitor (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let ticks = get-ticks
    in let heap = __heap-save
    in let heap-mb = heap / 1048576
    in let dummy = draw-win gb wh x 4 work-w 120 "Performance"
    in let cx = x + 10
    in let cy = 28
    in let dummy2 = draw-kv gb wh cx cy "Timer" (show ticks & " ticks") col-fg col-accent
    in let dummy3 = draw-kv gb wh cx (cy + 18) "Uptime" (show (ticks / 18) & "s") col-fg col-fg2
    in let dummy4 = draw-kv gb wh cx (cy + 36) "Heap" (show heap-mb & " MB") col-fg col-accent
    in let dummy5 = draw-gauge-bar gb (cx + 160) (cy + 38) (work-w - 180) 8 heap-mb 3072 col-accent
    in let dummy6 = draw-kv gb wh cx (cy + 54) "Frames" (show (mw-get-frame wh)) col-fg col-fg2
    in let dummy7 = draw-kv gb wh cx (cy + 72) "SMP" (show smp-cores & " cores (" & show (smp-ready + 1) & " up)") col-fg (if smp-cores > 1 then col-green else col-dim)
    in let dummy8 = draw-win gb wh x 130 (work-w / 2 - 2) 310 "Processes"
    in let cy2 = 154
    in let dummy9 = draw-proc-row gb wh (x + 10) cy2 "kernel" "running" col-green
