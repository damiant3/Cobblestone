Chapter: GuiShell
  cites Foreword chapter Console
  cites Foreword chapter Fat32
  cites Guios chapter GuiTimer
  cites Guios chapter GuiDisplay
  cites Guios chapter FontLoad
  cites Guios chapter CalcApp
  cites Guios chapter CalendarApp
  cites Guios chapter ProductivityApps
  cites Guios chapter MediaApps
  cites Guios chapter CreativeApps
  cites Guios chapter DiffusionApp
  cites Guios chapter TrackerApp
  cites Data chapter Server
  cites Guios chapter CommsApps
  cites Kernel chapter Keyboard
  cites Kernel chapter Mouse

 Bare-metal GUI desktop for Codex.OS. App launcher sidebar on the
 left with categorized app buttons. TimingWheel drives periodic
 clock refresh and heartbeat events.

Section: Screen
  gui-w : Integer = 640
  gui-h : Integer = 480
  taskbar-h : Integer = 30
  sidebar-w : Integer = 140
  desk-h : Integer = 450
  sidebar-row-h : Integer = desk-h / 21
  work-x : Integer = 144
  work-w : Integer = 492

Section: Palette
  col-bg : Integer = #0B0B1A
  col-sidebar : Integer = #111827
  col-sidebar-cat : Integer = #1E293B
  col-sidebar-app : Integer = #0F172A
  col-sidebar-sel : Integer = #1D4ED8
  col-taskbar : Integer = #111827
  col-taskbar-top : Integer = #1F2937
  col-start-bg : Integer = #1D4ED8
  col-hotbar-sel : Integer = #374151
  col-win-title : Integer = #0F172A
  col-win-body : Integer = #1E293B
  col-win-border : Integer = #334155
  col-fg : Integer = #F1F5F9
  col-fg2 : Integer = #CBD5E1
  col-dim : Integer = #64748B
  col-accent : Integer = #3B82F6
  col-red : Integer = #EF4444
  col-green : Integer = #22C55E
  col-yellow : Integer = #F59E0B
  col-teal : Integer = #14B8A6
  col-purple : Integer = #8B5CF6
  col-orange : Integer = #F97316
  col-pink : Integer = #EC4899
  col-cursor : Integer = #FFFFFF
  col-sep : Integer = #374151

Section: Timer Config
  tag-clock : Text = "clock"
  tag-heartbeat : Text = "heartbeat"
  clock-interval : Integer = 18
  heartbeat-interval : Integer = 90

Section: SMP Addresses
  smp-core-count-addr : Integer = 4088
  smp-ready-count-addr : Integer = 4080

  smp-cores : Integer
  smp-cores = let n = peek-32 smp-core-count-addr 0 in if n <= 0 then 1 else n

  smp-ready : Integer
  smp-ready = peek-32 smp-ready-count-addr 0

Section: State
  ShellUiState = record {
    su-display : GopDisplay,
    su-backbuf : GopBuf,
    su-cursor-save : CursorSave,
    su-kb-layout : KbLayout,
    su-wheel : MutWheel,
    su-tracker-db : DbServer
  }

Section: Font Loading
  gui-try-load-fonts : MutWheel -> Integer
  gui-try-load-fonts (w) =
    let vol = fat32-init 0
    in if vol.f32-bytes-per-sector == 0 then 0
    else if vol.f32-sectors-per-cluster == 0 then 0
    else fl-load-defaults vol w

Section: Entry Point
  opening : [Console] Nothing = act
    let gop-w = let v = peek-32 1988 0 in if v < gui-w then gui-w else v
    in let gd = gop-display-new gop-w gui-h
    in let gb = gop-buf-new gui-w gui-h col-bg
    in let cs = gop-cursor-save-new 80
    in let kb = kb-state-new
    in let w0 = mw-new
    in let w1 = mw-schedule w0 clock-interval mtw-tag-clock
    in let w2 = mw-schedule w1 heartbeat-interval mtw-tag-heartbeat
    in let d1 = mw-set-mouse-x w2 (gui-w / 2)
    in let d2 = mw-set-mouse-y w2 (gui-h / 2)
    in let d3 = gop-buf-put-text gb 10 10 "Loading fonts..." col-fg
    in let d4 = gop-buf-present gd gb
    in let d5 = block-select 0
    in let d5b = fl-init-cache w2
    in let d6 = gui-try-load-fonts w2
    in let tracker-db = tk-init-tracker-db
    in let st = ShellUiState {
      su-display = gd, su-backbuf = gb, su-cursor-save = cs,
      su-kb-layout = kb.layout, su-wheel = w2,
      su-tracker-db = tracker-db
    }
    in let st2 = gui-render st
    in let dummy = gui-loop st2
    in print-line "Codex.OS exited"
  end

Section: Main Loop
  gui-loop : ShellUiState -> Integer
  gui-loop (st) = gui-idle st 0

  mouse-port-avail : Integer
  mouse-port-avail = port-in-byte 228

  gui-idle : ShellUiState, Integer -> Integer
  gui-idle (st) (count) =
    if kb-has-key then gui-on-key st
    else if mouse-port-avail > 0 then gui-on-mouse-port st
    else if count >= 5000 then
      let yield = port-out-byte 224 0
      in let w = mw-tick (st.su-wheel)
      in let tag = mw-check-and-fire w
      in if tag > 0 then
        let w2 = if tag == mtw-tag-clock then mw-schedule w clock-interval mtw-tag-clock
          else if tag == mtw-tag-heartbeat then mw-schedule w heartbeat-interval mtw-tag-heartbeat
          else w
        in gui-idle (gui-render st) 0
      else gui-idle st 0
    else gui-idle st (count + 1)

  gui-on-key : ShellUiState -> Integer
  gui-on-key (st) =
    let h = __heap-save
    in let w = st.su-wheel
    in let kb = KbState { shift = mw-get-kb-shift w == 1, ctrl = mw-get-kb-ctrl w == 1, caps = mw-get-kb-caps w == 1, num = mw-get-kb-num w == 1, layout = st.su-kb-layout, dead = dead-none }
    in let ev = kb-poll kb
    in let d1 = mw-set-kb-shift w (if (ev.state).shift then 1 else 0)
    in let d2 = mw-set-kb-ctrl w (if (ev.state).ctrl then 1 else 0)
    in let d3 = mw-set-kb-caps w (if (ev.state).caps then 1 else 0)
    in let d4 = mw-set-kb-num w (if (ev.state).num then 1 else 0)
    in let pressed = ev.pressed
    in let ascii = ev.ascii
    in let sc = ev.scancode
    in let restored = __heap-restore h
    in if pressed == False then let du = mw-set-last-sc (st.su-wheel) 0 in gui-idle st 0
    else if sc == 1 then 0
    else let prev-sc = mw-get-last-sc (st.su-wheel)
    in let d5 = mw-set-last-key (st.su-wheel) ascii
    in let d6 = mw-set-last-sc (st.su-wheel) sc
    in let w = st.su-wheel
    in let d7 = if sc == 59 then mw-set-view w 0
      else if sc == 60 then mw-set-view w 1
      else if sc == 61 then mw-set-view w 2
      else if sc == 62 then mw-set-view w 3
      else if sc == 63 then mw-set-view w 4
      else if sc == 64 then mw-set-view w 5
      else if sc == 65 then mw-set-view w 9
      else if sc == 15 then if sc == prev-sc then 0 else if mw-get-kb-shift w == 1 then gui-tab-prev w else gui-tab-next w
      else if sc == 28 then if sc == prev-sc then 0 else gui-tab-activate w
      else 0
    in let cur-view = mw-get-view w
    in if cur-view == 9 then gui-settings-key st sc prev-sc
    else if cur-view == 5 then gui-notepad-key st ascii sc
    else if cur-view == 8 then gui-tab-calc-key st sc prev-sc
    else if cur-view == 14 then gui-piano-key st sc prev-sc
    else if cur-view == 10 then gui-tracker-key st sc prev-sc
    else gui-idle (gui-render st) 0

  gui-tab-next : MutWheel -> Integer
  gui-tab-next (w) =
    let cur = mw-get-tab-cursor w
    in let next = gui-tab-skip-forward (cur + 1)
    in mw-set-tab-cursor w next

  gui-tab-activate : MutWheel -> Integer
  gui-tab-activate (w) =
    let cur = mw-get-tab-cursor w
    in let d = mw-set-app w cur
    in gui-app-to-view w cur

  gui-tab-prev : MutWheel -> Integer
  gui-tab-prev (w) =
    let cur = mw-get-tab-cursor w
    in let prev = gui-tab-skip-backward (cur - 1)
    in mw-set-tab-cursor w prev

  gui-tab-skip-forward : Integer -> Integer
  gui-tab-skip-forward (n) =
    if n == 5 then 6
    else if n == 9 then 11
    else if n == 10 then 11
    else if n == 13 then 14
    else if n > 24 then 1
    else n

  gui-tab-skip-backward : Integer -> Integer
  gui-tab-skip-backward (n) =
    if n == 5 then 4
    else if n == 10 then 8
    else if n == 9 then 8
    else if n == 13 then 12
    else if n < 1 then 24
    else n

  gui-tab-calc-key : ShellUiState, Integer, Integer -> Integer
  gui-tab-calc-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let d = calc-key (st.su-wheel) sc in gui-idle (gui-render st) 0

  gui-tracker-key : ShellUiState, Integer, Integer -> Integer
  gui-tracker-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let d = tracker-key st sc in gui-idle (gui-render st) 0

  gui-notepad-key : ShellUiState, Integer, Integer -> Integer
  gui-notepad-key (st) (ascii) (sc) =
    let w = st.su-wheel
    in let nb = w.mw-notepad
    in if sc == 14 then let d = notepad-backspace nb w in gui-idle (gui-render st) 0
    else if ascii == 1 then let d = notepad-append nb w 1 in gui-idle (gui-render st) 0
    else if ascii >= 2 then let d = notepad-append nb w ascii in gui-idle (gui-render st) 0
    else gui-idle (gui-render st) 0

  gui-piano-key : ShellUiState, Integer, Integer -> Integer
  gui-piano-key (st) (sc) (prev) =
    if sc == prev then gui-idle st 0
    else let w = st.su-wheel
    in let note = if sc == 30 then 0
      else if sc == 31 then 1
      else if sc == 32 then 2
      else if sc == 33 then 3
      else if sc == 34 then 4
      else if sc == 35 then 5
      else if sc == 36 then 6
      else if sc == 37 then 7
      else if sc == 38 then 8
      else if sc == 39 then 9
      else (-1)
    in let d = if note >= 0 then mw-set-app-s0 w note else 0
    in gui-idle (gui-render st) 0

  gui-on-mouse-port : ShellUiState -> Integer
  gui-on-mouse-port (st) =
    let w = st.su-wheel
    in let btn = port-in-byte 225
    in let mx = port-in-16 226
    in let my = port-in-16 227
    in let left = bit-and btn 1
    in let was-btn = mw-get-mouse-btn w
    in let click = if left == 1 then if was-btn == 0 then 1 else 0 else 0
    in let d1 = mw-set-mouse-x w mx
    in let d2 = mw-set-mouse-y w my
    in let d3 = mw-set-mouse-btn w left
    in let d4 = if click == 1 then gui-handle-click st mx my else 0
    in gui-idle (gui-render st) 0

  gui-handle-click : ShellUiState, Integer, Integer -> Integer
  gui-handle-click (st) (mx) (my) =
    let ty = gui-h - taskbar-h
    in if my >= ty then gui-handle-hotbar-click st mx
    else if mx < sidebar-w then gui-handle-sidebar-click st my
    else 0

  gui-handle-sidebar-click : ShellUiState, Integer -> Integer
  gui-handle-sidebar-click (st) (my) =
    let w = st.su-wheel
    in let rh = sidebar-row-h
    in let slot = my / rh
    in if slot >= 1 then if slot <= 19 then
      let app-id = gui-slot-to-app slot
      in if app-id > 0 then let d = mw-set-app w app-id in gui-app-to-view w app-id
      else 0
    else 0 else 0

  gui-slot-to-app : Integer -> Integer
  gui-slot-to-app (slot) =
    if slot == 1 then 1
    else if slot == 2 then 2
    else if slot == 3 then 22
    else if slot == 4 then 23
    else if slot == 5 then 3
    else if slot == 6 then 4
    else if slot == 7 then 6
    else if slot == 8 then 7
    else if slot == 9 then 8
    else if slot == 10 then 11
    else if slot == 11 then 12
    else if slot == 12 then 14
    else if slot == 13 then 15
    else if slot == 14 then 16
    else if slot == 15 then 17
    else if slot == 16 then 18
    else if slot == 17 then 19
    else if slot == 18 then 20
    else if slot == 19 then 21
    else if slot == 20 then 24
    else 0

  gui-app-to-view : MutWheel, Integer -> Integer
  gui-app-to-view (w) (app-id) =
    if app-id == 1 then mw-set-view w 5
    else if app-id == 2 then mw-set-view w 7
    else if app-id == 22 then mw-set-view w 8
    else if app-id == 23 then mw-set-view w 9
    else if app-id == 3 then mw-set-view w 10
    else if app-id == 4 then mw-set-view w 11
    else if app-id == 6 then mw-set-view w 12
    else if app-id == 7 then mw-set-view w 13
    else if app-id == 8 then mw-set-view w 14
    else if app-id == 11 then mw-set-view w 15
    else if app-id == 12 then mw-set-view w 16
    else if app-id == 14 then mw-set-view w 17
    else if app-id == 15 then mw-set-view w 18
    else if app-id == 16 then mw-set-view w 19
    else if app-id == 17 then mw-set-view w 20
    else if app-id == 18 then mw-set-view w 21
    else if app-id == 19 then mw-set-view w 22
    else if app-id == 20 then mw-set-view w 23
    else if app-id == 21 then mw-set-view w 24
    else if app-id == 24 then mw-set-view w 25
    else mw-set-view w 6

  gui-handle-hotbar-click : ShellUiState, Integer -> Integer
  gui-handle-hotbar-click (st) (mx) =
    if mx >= 64 then if mx < 108 then mw-set-view (st.su-wheel) 0
    else if mx < 158 then mw-set-view (st.su-wheel) 1
    else if mx < 208 then mw-set-view (st.su-wheel) 2
    else if mx < 258 then mw-set-view (st.su-wheel) 3
    else if mx < 308 then mw-set-view (st.su-wheel) 4
    else 0 else 0

Section: RTC Clock
  rtc-read : Integer -> Integer
  rtc-read (reg) = let w = port-out-byte 112 reg in port-in-byte 113

  bcd-dec : Integer -> Integer
  bcd-dec (v) = (bit-shru v 4) * 10 + bit-and v 15

  rtc-pad2 : Integer -> Text
  rtc-pad2 (n) = let d = bcd-dec n in if d < 10 then "0" & show d else show d

  rtc-time : Text
  rtc-time = rtc-pad2 (rtc-read 4) & ":" & rtc-pad2 (rtc-read 2) & ":" & rtc-pad2 (rtc-read 0)

  rtc-date : Text
  rtc-date = "20" & rtc-pad2 (rtc-read 9) & "-" & rtc-pad2 (rtc-read 8) & "-" & rtc-pad2 (rtc-read 7)

Section: Render
  gui-render : ShellUiState -> ShellUiState
  gui-render (st) =
    let h = __heap-save
    in let gb = st.su-backbuf
    in let dummy = gop-buf-clear gb col-bg
    in let dummy2 = draw-sidebar gb st
    in let dummy3 = draw-workspace gb st
    in let dummy4 = draw-taskbar gb st
    in let dummy5 = gop-cursor-save gb (st.su-cursor-save) (mw-get-mouse-x (st.su-wheel)) (mw-get-mouse-y (st.su-wheel)) 8 10
    in let dummy6 = gop-draw-arrow-cursor gb (mw-get-mouse-x (st.su-wheel)) (mw-get-mouse-y (st.su-wheel)) col-cursor
    in let dummy7 = gop-buf-present (st.su-display) gb
    in let dummy8 = port-out-byte 224 0
    in let dummy9 = mw-inc-frame (st.su-wheel)
    in let restored = __heap-restore h
    in st

Section: App Launcher Sidebar
  draw-sidebar : GopBuf, ShellUiState -> Integer
  draw-sidebar (gb) (st) =
    let dummy = gop-buf-rect gb 0 0 sidebar-w desk-h col-sidebar
    in let dummy2 = gop-buf-hline gb 0 (sidebar-w - 1) 0 col-sep
    in let dummy3 = gop-buf-vline gb (sidebar-w - 1) 0 desk-h col-sep
    in let wh = st.su-wheel
    in let sel = mw-get-app wh
    in let tab = mw-get-tab-cursor wh
    in let rh = sidebar-row-h
    in let y = 0
    in let dummy4 = draw-cat gb wh y "Apps" col-accent
    in let dummy5 = draw-app-sel gb wh (rh) "Notes" col-fg2 1 sel tab
    in let dummy6 = draw-app-sel gb wh (rh * 2) "Calendar" col-fg2 2 sel tab
    in let dummy7 = draw-app-sel gb wh (rh * 3) "Calc" col-fg2 22 sel tab
    in let dummy8 = draw-app-sel gb wh (rh * 4) "Settings" col-fg2 23 sel tab
    in let dummy11 = draw-app-sel gb wh (rh * 5) "Tracker" col-fg2 3 sel tab
    in let dummy12 = draw-app-sel gb wh (rh * 6) "Pomodoro" col-fg2 4 sel tab
    in let dummy13 = draw-app-sel gb wh (rh * 7) "Publisher" col-fg2 6 sel tab
    in let dummy15 = draw-app-sel gb wh (rh * 8) "Boombox" col-fg2 7 sel tab
    in let dummy16 = draw-app-sel gb wh (rh * 9) "Piano" col-fg2 8 sel tab
    in let dummy18 = draw-app-sel gb wh (rh * 10) "Photos" col-fg2 11 sel tab
    in let dummy19 = draw-app-sel gb wh (rh * 11) "Podcasts" col-fg2 12 sel tab
    in let dummy22 = draw-app-sel gb wh (rh * 12) "Capture" col-fg2 14 sel tab
    in let dummy23 = draw-app-sel gb wh (rh * 13) "ImgTools" col-fg2 15 sel tab
    in let dummy24 = draw-app-sel gb wh (rh * 14) "Diagram" col-fg2 16 sel tab
    in let dummy25 = draw-app-sel gb wh (rh * 15) "Designer" col-fg2 17 sel tab
    in let dummy27 = draw-app-sel gb wh (rh * 16) "Mail" col-fg2 18 sel tab
    in let dummy28 = draw-app-sel gb wh (rh * 17) "Chat" col-fg2 19 sel tab
    in let dummy29 = draw-app-sel gb wh (rh * 18) "Collab" col-fg2 20 sel tab
    in let dummy30 = draw-app-sel gb wh (rh * 19) "Helm" col-fg2 21 sel tab
    in draw-app-sel gb wh (rh * 20) "Diffusion" col-purple 24 sel tab

  draw-cat : GopBuf, MutWheel, Integer, Text, Integer -> Integer
  draw-cat (gb) (wh) (y) (label) (color) =
    let rh = sidebar-row-h
    in let pad = (rh - 16) / 2
    in let dummy = gop-buf-rect gb 0 y sidebar-w rh col-sidebar-cat
    in gop-buf-put-text-role gb wh 6 (y + pad) label color font-role-sans

  draw-app : GopBuf, MutWheel, Integer, Text, Integer -> Integer
  draw-app (gb) (wh) (y) (label) (color) =
    let dummy = gop-buf-rect gb 2 y (sidebar-w - 4) 13 col-sidebar-app
    in gop-buf-put-text-role gb wh 10 (y + 1) label color font-role-sans

  draw-app-sel : GopBuf, MutWheel, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  draw-app-sel (gb) (wh) (y) (label) (color) (app-id) (sel) (tab) =
    let rh = sidebar-row-h
    in let is-active = app-id == sel
    in let is-tab = app-id == tab
    in let bg = if is-active then col-sidebar-sel else if is-tab then #1E3A5F else col-sidebar-app
    in let fg = if is-active then col-accent else if is-tab then col-fg else color
    in let pad = (rh - 16) / 2
    in let dummy = gop-buf-rect gb 2 y (sidebar-w - 4) rh bg
    in let dummy2 = if is-active then gop-buf-rect gb 0 y 3 rh col-accent
      else if is-tab then gop-buf-rect gb 0 y 3 rh col-teal
      else 0
    in gop-buf-put-text-role gb wh 10 (y + pad) label fg font-role-sans

Section: Workspace
  draw-workspace : GopBuf, ShellUiState -> Integer
  draw-workspace (gb) (st) =
    let v = mw-get-view (st.su-wheel)
    in if v == 0 then draw-view-dashboard gb st
    else if v == 1 then draw-view-monitor gb st
    else if v == 2 then draw-view-hardware gb st
    else if v == 3 then draw-view-about gb st
    else if v == 4 then draw-view-apps gb st
    else if v == 5 then draw-view-notepad gb st
    else if v == 7 then draw-view-calendar gb st
    else if v == 8 then draw-view-calc gb st
    else if v == 9 then draw-view-settings gb st
    else if v == 10 then draw-view-tracker gb st
    else if v == 11 then draw-view-pomodoro gb st
    else if v == 12 then draw-view-publisher gb st
    else if v == 13 then draw-view-boombox gb st
    else if v == 14 then draw-view-piano gb st
    else if v == 15 then draw-view-photos gb st
    else if v == 16 then draw-view-podcasts gb st
    else if v == 17 then draw-view-capture gb st
    else if v == 18 then draw-view-imgtools gb st
    else if v == 19 then draw-view-diagram gb st
    else if v == 20 then draw-view-designer gb st
    else if v == 21 then draw-view-mail gb st
    else if v == 22 then draw-view-chat gb st
    else if v == 23 then draw-view-collab gb st
    else if v == 24 then draw-view-helm gb st
    else if v == 25 then draw-view-diffusion gb st
    else draw-view-app-stub gb st

Section: Dashboard View (F1)
  draw-view-dashboard : GopBuf, ShellUiState -> Integer
  draw-view-dashboard (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 (work-w / 2 - 2) 180 "System"
    in let cx = x + 10
    in let cy = 28
    in let ticks = get-ticks
    in let dummy2 = draw-kv gb wh cx cy "Status" "Running" col-fg col-green
    in let dummy3 = draw-kv gb wh cx (cy + 18) "Uptime" (show (ticks / 18) & "s") col-fg col-accent
    in let dummy4 = gop-buf-hline gb cx (x + work-w / 2 - 12) (cy + 36) col-sep
    in let dummy5 = draw-kv gb wh cx (cy + 44) "Key" (show (mw-get-last-key wh) & " (sc:" & show (mw-get-last-sc wh) & ")") col-fg col-fg2
    in let dummy6 = draw-kv gb wh cx (cy + 62) "Mouse" (show (mw-get-mouse-x wh) & "," & show (mw-get-mouse-y wh)) col-fg col-fg2
    in let dummy7 = gop-buf-hline gb cx (x + work-w / 2 - 12) (cy + 80) col-sep
    in let dummy8 = draw-kv gb wh cx (cy + 88) "Frame" (show (mw-get-frame wh)) col-fg col-dim
    in let dummy9 = draw-kv gb wh cx (cy + 106) "Wheel" (show (mw-get-tick wh) & "t") col-fg col-teal
    in let dummy10 = draw-kv gb wh cx (cy + 124) "Mouse" (show (mw-get-mouse-x wh) & "," & show (mw-get-mouse-y wh)) col-fg col-teal
    in let x2 = x + work-w / 2 + 2
    in let dummy11 = draw-win gb wh x2 4 (work-w / 2 - 2) 180 "Memory"
    in let cx2 = x2 + 10
    in let heap = __heap-save
    in let heap-mb = heap / 1048576
    in let dummy12 = draw-kv gb wh cx2 28 "Heap" (show heap-mb & " MB") col-fg col-accent
    in let dummy13 = draw-gauge-bar gb cx2 48 (work-w / 2 - 22) 8 heap-mb 3072 col-accent
    in let dummy14 = draw-kv gb wh cx2 62 "Stack" "3 GB down" col-fg col-fg2
    in let dummy15 = draw-kv gb wh cx2 80 "Alloc" "Bump (R10)" col-fg col-dim
    in let dummy16 = draw-kv gb wh cx2 98 "GC" "None" col-fg col-dim
    in let dummy17 = draw-kv gb wh cx2 116 "Arena" "6M-3G" col-fg col-dim
    in let dummy18 = draw-win gb wh x 190 work-w 250 "Keys"
    in let cx3 = x + 10
    in let cy3 = 214
    in let dummy19 = draw-kv gb wh cx3 cy3 "F1-F5" "Views" col-yellow col-fg2
