Section: Notepad Buffer (alloc-bytes, zero-alloc typed text)
  NotepadBuf = record { nb-base : Integer }

  notepad-new : NotepadBuf
  notepad-new =
    let base = alloc-bytes mw-notepad-size
    in let d = notepad-zero-loop base 0
    in NotepadBuf { nb-base = base }

  notepad-zero-loop : Integer, Integer -> Integer
  notepad-zero-loop (base) (i) =
    if i >= mw-notepad-size then 0
    else let d = poke-byte base i 0
    in notepad-zero-loop base (i + 1)

  mw-get-note-len : MutWheel -> Integer
  mw-get-note-len (w) = peek-32 (w.mw-meta) 104

  mw-set-note-len : MutWheel, Integer -> Integer
  mw-set-note-len (w) (v) = poke-32 (w.mw-meta) 104 v

  notepad-append : NotepadBuf, MutWheel, Integer -> Integer
  notepad-append (nb) (w) (cce) =
    let pos = mw-get-note-len w
    in if pos >= mw-notepad-size - 1 then 0
    else let d = poke-byte (nb.nb-base) pos cce
    in mw-set-note-len w (pos + 1)

  notepad-backspace : NotepadBuf, MutWheel -> Integer
  notepad-backspace (nb) (w) =
    let pos = mw-get-note-len w
    in if pos <= 0 then 0
    else let d = poke-byte (nb.nb-base) (pos - 1) 0
    in mw-set-note-len w (pos - 1)

  notepad-get-char : NotepadBuf, Integer -> Integer
  notepad-get-char (nb) (i) = peek-byte (nb.nb-base) i

Section: Construction
  mw-new : MutWheel
  mw-new =
    let base = alloc-bytes mtw-fine-bytes
    in let meta = alloc-bytes mw-meta-size
    in let dummy = mw-zero-slots base 0
    in let d2 = poke-32 meta 0 0
    in let d3 = poke-32 meta 4 0
    in let d4 = poke-32 meta 8 1
    in let d5 = poke-32 meta 12 0
    in let np = notepad-new
    in MutWheel { mw-base = base, mw-meta = meta, mw-notepad = np }

  mw-zero-slots : Integer, Integer -> Integer
  mw-zero-slots (base) (i) =
    if i >= mtw-fine-count then 0
    else let off = i * mtw-slot-size
    in let d1 = poke-32 base off 0
    in let d2 = poke-32 base (off + 4) 0
    in let d3 = poke-32 base (off + 8) 0
    in let d4 = poke-32 base (off + 12) 0
    in let d5 = poke-32 base (off + 16) 0
    in let d6 = poke-32 base (off + 20) 0
    in let d7 = poke-32 base (off + 24) 0
    in let d8 = poke-32 base (off + 28) 0
    in mw-zero-slots base (i + 1)

Section: Schedule (O(1), in-place)
  mw-schedule : MutWheel, Integer, Integer -> MutWheel
  mw-schedule (w) (delay) (tag-id) =
    let tick = mw-get-tick w
    in let nid = mw-get-next-id w
    in let deadline = tick + delay
    in let slot-idx = mw-mod deadline mtw-fine-count
    in let off = slot-idx * mtw-slot-size
    in let d1 = poke-32 (w.mw-base) off nid
    in let d2 = poke-32 (w.mw-base) (off + 4) 0
    in let d3 = poke-32 (w.mw-base) (off + 8) deadline
    in let d4 = poke-32 (w.mw-base) (off + 12) 0
    in let d5 = poke-32 (w.mw-base) (off + 16) tag-id
    in let d6 = poke-32 (w.mw-base) (off + 20) 0
    in let d7 = poke-32 (w.mw-base) (off + 24) 1
    in let d8 = poke-32 (w.mw-base) (off + 28) 0
    in let d9 = mw-set-next-id w (nid + 1)
    in w

Section: Tick (O(1), in-place)
  mw-tick : MutWheel -> MutWheel
  mw-tick (w) =
    let tick = mw-get-tick w
    in let d = mw-set-tick w (tick + 1)
    in w

  mw-check-and-fire : MutWheel -> Integer
  mw-check-and-fire (w) =
    let slot-idx = mw-mod (mw-get-tick w) mtw-fine-count
    in let off = slot-idx * mtw-slot-size
    in let active = peek-32 (w.mw-base) (off + 24)
    in if active == 0 then 0
    else let deadline = peek-32 (w.mw-base) (off + 8)
    in if deadline > mw-get-tick w then 0
    else let tag = peek-32 (w.mw-base) (off + 16)
    in let d = poke-32 (w.mw-base) (off + 24) 0
    in tag

Section: Reschedule (in-place)
  mw-reschedule : MutWheel, Integer, Integer -> MutWheel
  mw-reschedule (w) (tag-id) (interval) =
    mw-schedule w interval tag-id

Section: Compact (clear all expired/inactive slots)
  mw-compact : MutWheel -> MutWheel
  mw-compact (w) = let dummy = mw-compact-loop (w.mw-base) (mw-get-tick w) 0
    in w

  mw-compact-loop : Integer, Integer, Integer -> Integer
  mw-compact-loop (base) (now) (i) =
    if i >= mtw-fine-count then 0
    else let off = i * mtw-slot-size
    in let active = peek-32 base (off + 24)
    in if active == 0 then mw-compact-loop base now (i + 1)
    else let deadline = peek-32 base (off + 8)
    in if deadline <= now then
      let d1 = poke-32 base (off + 24) 0
      in mw-compact-loop base now (i + 1)
    else mw-compact-loop base now (i + 1)

Section: Active Count
  mw-active-count : MutWheel -> Integer
  mw-active-count (w) = mw-count-loop (w.mw-base) 0 0

  mw-count-loop : Integer, Integer, Integer -> Integer
  mw-count-loop (base) (i) (acc) =
    if i >= mtw-fine-count then acc
    else let off = i * mtw-slot-size
    in let active = peek-32 base (off + 24)
    in mw-count-loop base (i + 1) (if active == 1 then acc + 1 else acc)

