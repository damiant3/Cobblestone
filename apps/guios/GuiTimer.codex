Chapter: GuiTimer

 Mutable timing wheel using alloc-bytes. Zero allocation after init.
 Each slot is 32 bytes: [id:8, deadline:8, tag-id:8, active:8].
 The fine wheel has 256 slots = 8 KB. Tick, schedule, and fire are
 all in-place poke-32/peek-32 operations.

Section: Constants
  mtw-slot-size : Integer = 32
  mtw-fine-count : Integer = 256
  mtw-fine-bytes : Integer = 8192
  mtw-max-timers : Integer = 16

Section: Tag IDs
  mtw-tag-none : Integer = 0
  mtw-tag-clock : Integer = 1
  mtw-tag-heartbeat : Integer = 2

Section: Mutable Wheel
  MutWheel = record {
    mw-base : Integer,
    mw-meta : Integer,
    mw-notepad : NotepadBuf
  }

  mw-meta-size : Integer = 256
  mw-notepad-size : Integer = 2048

Section: Meta Accessors (stored at end of alloc-bytes buffer)
  mw-get-tick : MutWheel -> Integer
  mw-get-tick (w) = peek-32 (w.mw-meta) 0

  mw-set-tick : MutWheel, Integer -> Integer
  mw-set-tick (w) (v) = poke-32 (w.mw-meta) 0 v

  mw-get-next-id : MutWheel -> Integer
  mw-get-next-id (w) = peek-32 (w.mw-meta) 8

  mw-set-next-id : MutWheel, Integer -> Integer
  mw-set-next-id (w) (v) = poke-32 (w.mw-meta) 8 v

  mw-get-frame : MutWheel -> Integer
  mw-get-frame (w) = peek-32 (w.mw-meta) 16

  mw-inc-frame : MutWheel -> Integer
  mw-inc-frame (w) =
    let f = peek-32 (w.mw-meta) 16
    in poke-32 (w.mw-meta) 16 (f + 1)

