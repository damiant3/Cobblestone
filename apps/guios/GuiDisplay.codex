Section: Constants
  gop-fb-base : Integer
  gop-fb-base = 3204448256

Section: Display Record
  GopDisplay = record {
    gd-width : Integer,
    gd-height : Integer,
    gd-stride : Integer,
    gd-fb-addr : Integer
  }

Section: Display Construction
  gop-display-new : Integer, Integer -> GopDisplay
  gop-display-new (w) (h) =
    GopDisplay {
      gd-width = w,
      gd-height = h,
      gd-stride = w,
      gd-fb-addr = gop-fb-base
    }

Section: Text Rendering on GopBuf
  gop-buf-font : CbfFont
  gop-buf-font = cbf-init

  gop-buf-put-char : GopBuf, Integer, Integer, Integer, Integer -> Integer
  gop-buf-put-char (gb) (x) (y) (cce-code) (fg) =
    gop-buf-cbf-rows gb x y cce-code fg 0

  gop-buf-cbf-rows : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-cbf-rows (gb) (x) (y) (cce-code) (fg) (row) =
    if row >= 16 then 0
    else let byte = cbf-row gop-buf-font cce-code row
    in let dummy = gop-buf-cbf-bits gb x (y + row) byte fg 0
    in gop-buf-cbf-rows gb x y cce-code fg (row + 1)

  gop-buf-cbf-bits : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-cbf-bits (gb) (x) (y) (byte) (fg) (bit) =
    if bit >= 8 then 0
    else if bit-and (bit-shru byte (7 - bit)) 1 == 1 then
      let dummy = gop-buf-set gb (x + bit) y fg
      in gop-buf-cbf-bits gb x y byte fg (bit + 1)
    else gop-buf-cbf-bits gb x y byte fg (bit + 1)

  gop-buf-put-text : GopBuf, Integer, Integer, Text, Integer -> Integer
  gop-buf-put-text (gb) (x) (y) (s) (fg) =
    gop-buf-put-text-clip gb x y (gb.gb-width) s fg

  gop-buf-advance : Integer = 9
  gop-buf-glyph-w : Integer = 8

  gop-buf-put-text-clip : GopBuf, Integer, Integer, Integer, Text, Integer -> Integer
  gop-buf-put-text-clip (gb) (x) (y) (max-x) (s) (fg) =
    gop-buf-put-text-fit gb x y max-x s fg text-overflow-default

  gop-buf-put-text-fit : GopBuf, Integer, Integer, Integer, Text, Integer, TextOverflow -> Integer
  gop-buf-put-text-fit (gb) (x) (y) (max-x) (s) (fg) (mode) =
    let len = text-length s
    in let avail = max-x - x
    in let start = text-overflow-start mode len avail gop-buf-advance gop-buf-glyph-w
    in let count = text-overflow-count mode len avail gop-buf-advance gop-buf-glyph-w
    in let dots = text-overflow-dots mode len avail gop-buf-advance gop-buf-glyph-w
    in gop-buf-text-loop gb x y s fg start (start + count) start + gop-buf-dots-loop gb (x + count * gop-buf-advance) y fg 0 dots

  gop-buf-text-loop : GopBuf, Integer, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  gop-buf-text-loop (gb) (x) (y) (s) (fg) (i) (stop) (start) =
    if i >= stop then 0
    else let code = char-code-at s i
    in let dummy = gop-buf-put-char gb (x + (i - start) * gop-buf-advance) y code fg
    in gop-buf-text-loop gb x y s fg (i + 1) stop start

  gop-buf-dots-loop : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-dots-loop (gb) (x) (y) (fg) (k) (n) =
    if k >= n then 0
    else let dummy = gop-buf-put-char gb (x + k * gop-buf-advance) y (char-code-at "." 0) fg
    in gop-buf-dots-loop gb x y fg (k + 1) n

Section: SystemFont Text Rendering
  gop-sys-font : SysFont
  gop-sys-font = sysfont-init

  gop-buf-sys-advance : Integer = 10

  gop-buf-put-text-sys : GopBuf, Integer, Integer, Text, Integer -> Integer
  gop-buf-put-text-sys (gb) (x) (y) (s) (fg) =
    gop-buf-put-text-sys-fit gb x y (gb.gb-width) s fg text-overflow-default

  gop-buf-put-text-sys-fit : GopBuf, Integer, Integer, Integer, Text, Integer, TextOverflow -> Integer
  gop-buf-put-text-sys-fit (gb) (x) (y) (max-x) (s) (fg) (mode) =
    let len = text-length s
    in let avail = max-x - x
    in let start = text-overflow-start mode len avail gop-buf-sys-advance gop-buf-glyph-w
    in let count = text-overflow-count mode len avail gop-buf-sys-advance gop-buf-glyph-w
    in let dots = text-overflow-dots mode len avail gop-buf-sys-advance gop-buf-glyph-w
    in gop-buf-sys-loop gb x y s fg start (start + count) start + gop-buf-sys-dots gb (x + count * gop-buf-sys-advance) y fg 0 dots

  gop-buf-sys-loop : GopBuf, Integer, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  gop-buf-sys-loop (gb) (x) (y) (s) (fg) (i) (stop) (start) =
    if i >= stop then 0
    else let cce = char-code-at s i
    in let unicode = to-unicode cce
    in let dummy = gop-buf-sys-char gb (x + (i - start) * gop-buf-sys-advance) y unicode fg
    in gop-buf-sys-loop gb x y s fg (i + 1) stop start

  gop-buf-sys-dots : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-sys-dots (gb) (x) (y) (fg) (k) (n) =
    if k >= n then 0
    else let dummy = gop-buf-sys-char gb (x + k * gop-buf-sys-advance) y (to-unicode (char-code-at "." 0)) fg
    in gop-buf-sys-dots gb x y fg (k + 1) n

  gop-buf-sys-char : GopBuf, Integer, Integer, Integer, Integer -> Integer
  gop-buf-sys-char (gb) (x) (y) (unicode) (fg) =
    gop-buf-sys-rows gb x y unicode fg 0

  gop-buf-sys-rows : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-sys-rows (gb) (x) (y) (unicode) (fg) (row) =
    if row >= sysfont-glyph-h then 0
    else let byte = sysfont-row gop-sys-font unicode row
    in let dummy = gop-buf-cbf-bits gb x (y + row) byte fg 0
    in gop-buf-sys-rows gb x y unicode fg (row + 1)

Section: Font Mode Dispatch
  gop-buf-put-text-mode : GopBuf, Integer, Integer, Text, Integer, Integer -> Integer
  gop-buf-put-text-mode (gb) (x) (y) (s) (fg) (mode) =
    if mode == 2 then gop-buf-put-text-sys gb x y s fg
    else if mode == 3 then gop-buf-put-text-scaled gb x y s fg 2
    else gop-buf-put-text gb x y s fg

Section: Scaled Text Rendering
  gop-buf-put-text-scaled : GopBuf, Integer, Integer, Text, Integer, Integer -> Integer
  gop-buf-put-text-scaled (gb) (x) (y) (s) (fg) (scale) =
    if scale <= 1 then gop-buf-put-text gb x y s fg
    else gop-buf-put-text-scaled-fit gb x y (gb.gb-width) s fg scale text-overflow-default

  gop-buf-put-text-scaled-fit : GopBuf, Integer, Integer, Integer, Text, Integer, Integer, TextOverflow -> Integer
  gop-buf-put-text-scaled-fit (gb) (x) (y) (max-x) (s) (fg) (scale) (mode) =
    let len = text-length s
    in let avail = max-x - x
    in let start = text-overflow-start mode len avail (gop-buf-advance * scale) (gop-buf-glyph-w * scale)
    in let count = text-overflow-count mode len avail (gop-buf-advance * scale) (gop-buf-glyph-w * scale)
    in gop-buf-text-scaled-loop gb x y s fg scale start (start + count) start

  gop-buf-text-scaled-loop : GopBuf, Integer, Integer, Text, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-text-scaled-loop (gb) (x) (y) (s) (fg) (scale) (i) (stop) (start) =
    if i >= stop then 0
    else let code = char-code-at s i
    in let dummy = gop-buf-put-char-scaled gb (x + (i - start) * gop-buf-advance * scale) y code fg scale
    in gop-buf-text-scaled-loop gb x y s fg scale (i + 1) stop start

  gop-buf-put-char-scaled : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-put-char-scaled (gb) (x) (y) (cce-code) (fg) (scale) =
    gop-buf-cbf-rows-scaled gb x y cce-code fg scale 0

  gop-buf-cbf-rows-scaled : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-cbf-rows-scaled (gb) (x) (y) (cce-code) (fg) (scale) (row) =
    if row >= 16 then 0
    else let byte = cbf-row gop-buf-font cce-code row
    in let dummy = gop-buf-cbf-bits-scaled gb x (y + row * scale) byte fg scale 0
    in gop-buf-cbf-rows-scaled gb x y cce-code fg scale (row + 1)

  gop-buf-cbf-bits-scaled : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-buf-cbf-bits-scaled (gb) (x) (y) (byte) (fg) (scale) (bit) =
    if bit >= 8 then 0
    else if bit-and (bit-shru byte (7 - bit)) 1 == 1 then
      let dummy = gop-buf-rect gb (x + bit * scale) y scale scale fg
      in gop-buf-cbf-bits-scaled gb x y byte fg scale (bit + 1)
    else gop-buf-cbf-bits-scaled gb x y byte fg scale (bit + 1)

Section: GopBitmapFont Rendering (alloc-bytes backed TrueType fonts)
  gbf-put-char : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gbf-put-char (gb) (base) (gw) (gh) (x) (y) (cce) (fg) =
    let unicode = to-unicode cce
    in let idx = unicode - 32
    in if idx < 0 then 0
    else if idx >= 95 then 0
    else gbf-put-char-rows gb base gw gh x y idx fg 0

  gbf-put-char-rows : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gbf-put-char-rows (gb) (base) (gw) (gh) (x) (y) (idx) (fg) (row) =
    if row >= gh then 0
    else let dummy = gbf-put-char-cols gb base gw gh x y idx fg row 0
    in gbf-put-char-rows gb base gw gh x y idx fg (row + 1)

  gbf-put-char-cols : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gbf-put-char-cols (gb) (base) (gw) (gh) (x) (y) (idx) (fg) (row) (col) =
    if col >= gw then 0
    else let alpha = peek-byte base (idx * gw * gh + row * gw + col)
    in let dummy = if alpha > 0 then gbf-blend-pixel gb (x + col) (y + row) fg alpha else 0
    in gbf-put-char-cols gb base gw gh x y idx fg row (col + 1)

  gbf-put-text : GopBuf, Integer, Integer, Integer, Integer, Integer, Text, Integer -> Integer
  gbf-put-text (gb) (base) (gw) (gh) (x) (y) (s) (fg) =
    gbf-put-text-clip gb base gw gh x y (gb.gb-width) s fg

  gbf-put-text-clip : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Text, Integer -> Integer
  gbf-put-text-clip (gb) (base) (gw) (gh) (x) (y) (max-x) (s) (fg) =
    let adv-table = base + 95 * gw * gh
    in let yoff-table = adv-table + 95
    in gbf-put-text-loop gb base gw gh adv-table yoff-table x y max-x s fg 0 (text-length s) 0

  gbf-put-text-loop : GopBuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  gbf-put-text-loop (gb) (base) (gw) (gh) (adv-table) (yoff-table) (x) (y) (max-x) (s) (fg) (i) (n) (cx) =
    if i >= n then 0
    else if x + cx + gw > max-x then 0
    else let code = char-code-at s i
    in let unicode = to-unicode code
    in let idx = unicode - 32
    in let adv = if idx >= 0 then if idx < 95 then peek-byte adv-table idx else gw else gw
    in let yoff = if idx >= 0 then if idx < 95 then peek-byte yoff-table idx else 0 else 0
    in let dummy = gbf-put-char gb base gw gh (x + cx) (y + yoff) code fg
    in gbf-put-text-loop gb base gw gh adv-table yoff-table x y max-x s fg (i + 1) n (cx + adv)

Section: Font Role Dispatch
  font-role-serif : Integer = 1
  font-role-sans : Integer = 2
  font-role-mono : Integer = 3

  gop-buf-put-text-role : GopBuf, MutWheel, Integer, Integer, Text, Integer, Integer -> Integer
  gop-buf-put-text-role (gb) (w) (x) (y) (s) (fg) (role) =
    gop-buf-put-text-role-clip gb w x y (gb.gb-width) s fg role

  gop-buf-put-text-role-clip : GopBuf, MutWheel, Integer, Integer, Integer, Text, Integer, Integer -> Integer
  gop-buf-put-text-role-clip (gb) (w) (x) (y) (max-x) (s) (fg) (role) =
    if mw-get-fonts-loaded w == 0 then gop-buf-put-text-clip gb x y max-x s fg
    else gop-buf-put-text-role-loaded gb w x y max-x s fg role

  gop-buf-put-text-role-loaded : GopBuf, MutWheel, Integer, Integer, Integer, Text, Integer, Integer -> Integer
  gop-buf-put-text-role-loaded (gb) (w) (x) (y) (max-x) (s) (fg) (role) =
    let base = if role == 1 then mw-get-font-serif-base w
               else if role == 2 then mw-get-font-sans-base w
               else mw-get-font-mono-base w
    in let gw = if role == 1 then mw-get-font-serif-w w
                else if role == 2 then mw-get-font-sans-w w
                else mw-get-font-mono-w w
    in let gh = mw-get-font-glyph-h w
    in if base == 0 then gop-buf-put-text-clip gb x y max-x s fg
    else gbf-put-text-clip gb base gw gh x y max-x s fg

  gop-role-text-width : MutWheel, Integer, Text -> Integer
  gop-role-text-width (w) (role) (s) =
    if mw-get-fonts-loaded w == 0 then text-length s * 9
    else let base = if role == 1 then mw-get-font-serif-base w
                    else if role == 2 then mw-get-font-sans-base w
                    else mw-get-font-mono-base w
    in let gw = if role == 1 then mw-get-font-serif-w w
                else if role == 2 then mw-get-font-sans-w w
                else mw-get-font-mono-w w
    in let gh = mw-get-font-glyph-h w
    in if base == 0 then text-length s * 9
    else gbf-measure-text base gw gh s

  gbf-measure-text : Integer, Integer, Integer, Text -> Integer
  gbf-measure-text (base) (gw) (gh) (s) =
    let adv-table = base + 95 * gw * gh
    in gbf-measure-loop adv-table gw s 0 (text-length s) 0

  gbf-measure-loop : Integer, Integer, Text, Integer, Integer, Integer -> Integer
  gbf-measure-loop (adv-table) (gw) (s) (i) (n) (cx) =
    if i >= n then cx
    else let unicode = to-unicode (char-code-at s i)
    in let idx = unicode - 32
    in let adv = if idx >= 0 then if idx < 95 then peek-byte adv-table idx else gw else gw
    in gbf-measure-loop adv-table gw s (i + 1) n (cx + adv)

Section: Blit GopBuf to GOP Hardware
  gop-buf-present : GopDisplay, GopBuf -> Integer
  gop-buf-present (gd) (gb) =
    gop-buf-present-rows gd gb 0

  gop-buf-present-rows : GopDisplay, GopBuf, Integer -> Integer
  gop-buf-present-rows (gd) (gb) (y) =
    if y >= gb.gb-height then 0
    else let dummy = gop-buf-present-row gd gb y 0
    in gop-buf-present-rows gd gb (y + 1)

  gop-buf-present-row : GopDisplay, GopBuf, Integer, Integer -> Integer
  gop-buf-present-row (gd) (gb) (y) (x) =
    if x >= gb.gb-width then 0
    else let color = peek-32 (gb.gb-base) ((y * gb.gb-width + x) * 4)
    in let offset = (y * gd.gd-stride + x) * 4
    in let dummy = poke-32 (gd.gd-fb-addr) offset color
    in gop-buf-present-row gd gb y (x + 1)

Section: Mouse Cursor with Save/Restore
  CursorSave = record {
    cs-base : Integer,
    cs-size : Integer
  }

  gop-cursor-save-new : Integer -> CursorSave
  gop-cursor-save-new (pixels) =
    CursorSave { cs-base = alloc-bytes (pixels * 4), cs-size = pixels }

  gop-cursor-save : GopBuf, CursorSave, Integer, Integer, Integer, Integer -> Integer
  gop-cursor-save (gb) (cs) (x) (y) (w) (h) =
    gop-cursor-save-loop gb cs x y w h 0

  gop-cursor-save-loop : GopBuf, CursorSave, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-cursor-save-loop (gb) (cs) (x) (y) (w) (h) (i) =
    if i >= w * h then 0
    else let cx = x + int-mod i w
    in let cy = y + i / w
    in let pixel = gop-buf-get gb cx cy
    in let dummy = poke-32 (cs.cs-base) (i * 4) pixel
    in gop-cursor-save-loop gb cs x y w h (i + 1)

  gop-cursor-restore : GopBuf, CursorSave, Integer, Integer, Integer, Integer -> Integer
  gop-cursor-restore (gb) (cs) (x) (y) (w) (h) =
    gop-cursor-restore-loop gb cs x y w h 0

  gop-cursor-restore-loop : GopBuf, CursorSave, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-cursor-restore-loop (gb) (cs) (x) (y) (w) (h) (i) =
    if i >= w * h then 0
    else let cx = x + int-mod i w
    in let cy = y + i / w
    in let pixel = peek-32 (cs.cs-base) (i * 4)
    in let dummy = gop-buf-set gb cx cy pixel
    in gop-cursor-restore-loop gb cs x y w h (i + 1)

  gop-draw-arrow-cursor : GopBuf, Integer, Integer, Integer -> Integer
  gop-draw-arrow-cursor (gb) (mx) (my) (color) =
    let dummy = gop-buf-set gb mx my color
    in let dummy2 = gop-buf-set gb mx (my + 1) color
    in let dummy3 = gop-buf-set gb mx (my + 2) color
    in let dummy4 = gop-buf-set gb mx (my + 3) color
    in let dummy5 = gop-buf-set gb mx (my + 4) color
    in let dummy6 = gop-buf-set gb mx (my + 5) color
    in let dummy7 = gop-buf-set gb mx (my + 6) color
    in let dummy8 = gop-buf-set gb mx (my + 7) color
    in let dummy9 = gop-buf-set gb (mx + 1) my color
    in let dummy10 = gop-buf-set gb (mx + 1) (my + 1) color
    in let dummy11 = gop-buf-set gb (mx + 1) (my + 2) color
    in let dummy12 = gop-buf-set gb (mx + 1) (my + 3) color
    in let dummy13 = gop-buf-set gb (mx + 1) (my + 4) color
    in let dummy14 = gop-buf-set gb (mx + 2) my color
    in let dummy15 = gop-buf-set gb (mx + 2) (my + 1) color
    in let dummy16 = gop-buf-set gb (mx + 2) (my + 2) color
    in let dummy17 = gop-buf-set gb (mx + 2) (my + 3) color
    in let dummy18 = gop-buf-set gb (mx + 3) my color
    in let dummy19 = gop-buf-set gb (mx + 3) (my + 1) color
    in let dummy20 = gop-buf-set gb (mx + 3) (my + 2) color
    in let dummy21 = gop-buf-set gb (mx + 4) my color
    in let dummy22 = gop-buf-set gb (mx + 4) (my + 1) color
    in let dummy23 = gop-buf-set gb (mx + 5) (my + 4) color
    in let dummy24 = gop-buf-set gb (mx + 4) (my + 5) color
    in gop-buf-set gb (mx + 3) (my + 6) color

