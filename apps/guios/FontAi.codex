Chapter: FontAi
  cites AI chapter Tensor
  cites AI chapter NeuralNet
  cites Encode chapter TrueType
  cites Encode chapter TrueTypeWriter
  cites Encode chapter FontGen

 AI-generated font using a trained MLP. The network predicts glyph
 shapes as advance width + up to 6 contour bounding rectangles from
 a one-hot glyph ID and a style parameter. Trained on 16 CC0 fonts
 (4716 contours). Each rectangle becomes a filled contour in the
 pixel-grid font (UPM=16).

Section: Network Construction
  fai-max-rects : Integer = 6

  fai-build-net : NeuralNetwork
  fai-build-net =
    let w1 = tensor-from 32 96 fai-w1-data
    in let b1 = tensor-from 32 1 fai-b1-data
    in let w2 = tensor-from 25 32 fai-w2-data
    in let b2 = tensor-from 25 1 fai-b2-data
    in nn-add-layer (nn-add-layer nn-new w1 b1 nn-act-relu) w2 b2 nn-act-none

Section: Inference
  fai-predict : NeuralNetwork, Integer, Integer -> List Integer
  fai-predict (net) (glyph-idx) (style) =
    let input = fai-encode-input glyph-idx style
    in let result = nn-forward net input
    in result.data

  fai-encode-input : Integer, Integer -> Tensor
  fai-encode-input (glyph-idx) (style) =
    let data = fai-one-hot glyph-idx 95 0 []
    in tensor-vector (list-push data style)

  fai-one-hot : Integer, Integer, Integer, List Integer -> List Integer
  fai-one-hot (idx) (size) (i) (acc) =
    if i >= size then acc
    else fai-one-hot idx size (i + 1) (list-push acc (if i == idx then 1000 else 0))

Section: Font Generation
  fai-gen-font : NeuralNetwork, Text, Integer -> TtfBuildSpec
  fai-gen-font (net) (name) (style) =
    let glyphs = fai-gen-glyphs net style 32 []
    in TtfBuildSpec {
      bs-name = name,
      bs-units-per-em = 16,
      bs-ascent = 13,
      bs-descent = -3,
      bs-line-gap = 2,
      bs-glyphs = glyphs
    }

  fai-gen-glyphs : NeuralNetwork, Integer, Integer, List TtfBuildGlyph -> List TtfBuildGlyph
  fai-gen-glyphs (net) (style) (cp) (acc) =
    if cp > 126 then acc
    else let g = fai-gen-one net style cp
    in fai-gen-glyphs net style (cp + 1) (list-push acc g)

  fai-gen-one : NeuralNetwork, Integer, Integer -> TtfBuildGlyph
  fai-gen-one (net) (style) (cp) =
    let idx = cp - 32
    in if idx < 0 then fg-empty-glyph cp 5
    else if idx >= 95 then fg-empty-glyph cp 5
    else let pred = fai-predict net idx style
    in let adv-raw = list-at pred 0
    in let adv = fai-clamp (adv-raw * 16 / 1000) 2 14
    in let contours = fai-pred-to-contours pred 1 0 fai-max-rects []
    in if list-length contours == 0 then fg-empty-glyph cp adv
    else px-glyph cp adv contours

  fai-pred-to-contours : List Integer, Integer, Integer, Integer, List TtfContour -> List TtfContour
  fai-pred-to-contours (pred) (off) (i) (max) (acc) =
    if i >= max then acc
    else let x0r = list-at pred (off + i * 4)
    in let y0r = list-at pred (off + i * 4 + 1)
    in let x1r = list-at pred (off + i * 4 + 2)
    in let y1r = list-at pred (off + i * 4 + 3)
    in let x0 = fai-clamp (x0r * 16 / 1000) 0 14
    in let y0 = fai-clamp (y0r * 16 / 1000) (-3) 13
    in let x1 = fai-clamp (x1r * 16 / 1000) 0 15
    in let y1 = fai-clamp (y1r * 16 / 1000) (-3) 14
    in let w = x1 - x0
    in let h = y1 - y0
    in if w < 1 then fai-pred-to-contours pred off (i + 1) max acc
    else if h < 1 then fai-pred-to-contours pred off (i + 1) max acc
    else fai-pred-to-contours pred off (i + 1) max (list-push acc (fg-rect-contour x0 y0 w h))

  fai-clamp : Integer, Integer, Integer -> Integer
  fai-clamp (v) (lo) (hi) = if v < lo then lo else if v > hi then hi else v
