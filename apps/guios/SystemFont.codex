Section: Lookup
  sysfont-row : SysFont, Integer, Integer -> Integer
  sysfont-row (sf) (unicode) (row) =
    let idx = unicode - sysfont-first
    in if idx < 0 then 0
    else if idx >= sysfont-count then 0
    else if row < 0 then 0
    else if row >= sysfont-glyph-h then 0
    else peek-byte (sf.sf-base) (idx * sysfont-glyph-h + row)

