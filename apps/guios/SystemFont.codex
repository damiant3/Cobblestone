Chapter: SystemFont

 CMU Typewriter (CC0) pre-rasterized at 16px.
 95 glyphs, 9x16 per glyph, 1-byte row bitmask.

Section: Constants
  sysfont-glyph-w : Integer = 9
  sysfont-glyph-h : Integer = 16
  sysfont-count : Integer = 95
  sysfont-first : Integer = 32
  sysfont-data-size : Integer = 1520

Section: Font Record
  SysFont = record { sf-base : Integer }

  sysfont-init : SysFont
  sysfont-init =
    let base = alloc-bytes sysfont-data-size
    in let d = sf-write base
    in SysFont { sf-base = base + d - d }

Section: Write All
