 Creative app views: Capture, ImgTools, Diagram, Designer.

Section: Capture View (view 17)
  draw-view-capture : GopBuf, ShellUiState -> Integer
  draw-view-capture (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let tabs = widget-panel "cap-tabs" DirRow 8 [
      widget-button "cap-full" "Full",
      widget-button "cap-win" "Window",
      widget-button "cap-reg" "Region",
      widget-button "cap-tmr" "Timer"
    ]
    in let header = widget-panel "cap-hdr" DirColumn 4 [tabs, widget-separator "cap-sep1"]
    in let tree = widget-panel "cap-top" DirColumn 4 [header]
    in let bounds = layout-rect x 4 work-w 52
    in let laid-out = widget-layout tree theme-terminal bounds
    in let dummy = gop-render-tree laid-out theme-terminal gb wh
    in let cx = x + 10
    in let dummy2 = gop-buf-rect gb cx 60 (work-w - 20) 320 col-sep
    in let dummy3 = gop-buf-outline gb (cx + 60) 100 260 160 col-accent
    in let dummy4 = gop-buf-rect gb (cx + 58) 98 6 6 col-accent
    in let dummy5 = gop-buf-rect gb (cx + 316) 98 6 6 col-accent
    in let dummy6 = gop-buf-rect gb (cx + 58) 256 6 6 col-accent
    in let dummy7 = gop-buf-rect gb (cx + 316) 256 6 6 col-accent
    in let foot = widget-label "cap-info" "Region: 260 x 160  Ready"
    in let fbounds = layout-rect x 388 work-w 48
    in let flaid = widget-layout foot theme-terminal fbounds
    in gop-render-tree flaid theme-terminal gb wh

Section: ImgTools View (view 18)
  draw-view-imgtools : GopBuf, ShellUiState -> Integer
  draw-view-imgtools (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let tw = 70
    in let tools = widget-panel "img-tools" DirColumn 2 [
      widget-label "img-th" "Tools",
      widget-separator "img-ts",
      widget-label "img-t1" "Select",
      widget-label "img-t2" "Crop",
      widget-label "img-t3" "Pen",
      widget-label "img-t4" "Brush",
      widget-label "img-t5" "Eraser",
      widget-label "img-t6" "Fill",
      widget-label "img-t7" "Text",
      widget-label "img-t8" "Eyedrop",
      widget-separator "img-cs",
      widget-label "img-ch" "Color"
    ]
    in let sidebar = widget-set-min tools tw 0
    in let tree = widget-panel "img-side" DirColumn 0 [sidebar]
    in let bounds = layout-rect x 4 tw 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in let dummy = gop-render-tree laid-out theme-terminal gb wh
    in let cx = x + tw + 8
    in let cw = work-w - tw - 12
    in let dummy2 = gop-buf-outline gb cx 28 cw 360 #475569
    in let dummy3 = gop-buf-rect gb (cx + 1) 29 (cw - 2) 358 #1E2836
    in let dummy4 = gop-buf-outline gb (cx + 30) 70 100 70 col-fg2
    in let dummy5 = gop-buf-rect gb (cx + 170) 100 50 50 col-accent
    in let dummy6 = gop-buf-rect gb (cx + 80) 180 120 40 col-teal
    in let dummy7 = gop-buf-outline gb (cx + 250) 60 80 80 col-purple
    in let foot = widget-panel "img-foot" DirRow 16 [
      widget-label "img-info1" "Tool: Pen  Color: #3B82F6",
      widget-label "img-info2" ("Canvas: " & show cw & "x358")
    ]
    in let fbounds = layout-rect x 396 work-w 40
    in let flaid = widget-layout foot theme-terminal fbounds
    in gop-render-tree flaid theme-terminal gb wh

Section: Diagram View (view 19)
  draw-view-diagram : GopBuf, ShellUiState -> Integer
  draw-view-diagram (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = gop-buf-rect gb (x + 4) 28 (work-w - 8) 370 col-sep
    in let bx1 = x + 40
    in let by1 = 80
    in let bx2 = x + 220
    in let by2 = 80
    in let bx3 = x + 220
    in let by3 = 200
    in let dummy2 = gop-buf-rect gb bx1 by1 90 40 col-win-body
    in let dummy3 = gop-buf-outline gb bx1 by1 90 40 col-accent
    in let dummy4 = draw-text-f gb wh (bx1 + 16) (by1 + 12) "Start" col-fg font-role-sans
    in let dummy5 = gop-buf-rect gb bx2 by2 110 40 col-win-body
    in let dummy6 = gop-buf-outline gb bx2 by2 110 40 col-accent
    in let dummy7 = draw-text-f gb wh (bx2 + 16) (by2 + 12) "Process" col-fg font-role-sans
    in let dummy8 = gop-buf-rect gb bx3 by3 90 40 col-win-body
    in let dummy9 = gop-buf-outline gb bx3 by3 90 40 col-green
    in let dummy10 = draw-text-f gb wh (bx3 + 22) (by3 + 12) "End" col-fg font-role-sans
    in let dummy11 = gop-buf-hline gb (bx1 + 90) bx2 100 col-accent
    in let dummy12 = gop-buf-vline gb (bx2 + 55) (by2 + 40) by3 col-accent
    in let foot = widget-label "diag-info" "3 shapes  2 connections"
    in let fbounds = layout-rect x 406 work-w 30
    in let flaid = widget-layout foot theme-terminal fbounds
    in gop-render-tree flaid theme-terminal gb wh

Section: Designer View (view 20)
  draw-view-designer : GopBuf, ShellUiState -> Integer
  draw-view-designer (gb) (st) =
    let wh = st.su-wheel
    in let hw = work-w / 2 - 2
    in let widget-tree-pane = widget-panel "des-tree" DirColumn 2 [
      widget-label "des-w0" "Window",
      widget-label "des-w1" "  Header",
      widget-label "des-w2" "    Logo",
      widget-label "des-w3" "    Title",
      widget-label "des-w4" "  Body",
      widget-label "des-w5" "    Button",
      widget-label "des-w6" "    Input",
      widget-label "des-w7" "  Footer"
    ]
    in let props = widget-panel "des-props" DirColumn 2 [
      widget-label "des-p1" "Type: Button",
      widget-label "des-p2" "Text: Submit",
      widget-label "des-p3" "Width: 120",
      widget-label "des-p4" "Height: 36",
      widget-separator "des-ps",
      widget-label "des-p5" "Color: #3B82F6",
      widget-label "des-p6" "Font: Sans 14",
      widget-label "des-p7" "Padding: 8 16",
      widget-label "des-p8" "Border: 1px solid"
    ]
    in let tree = widget-panel "des-root" DirRow 4 [widget-tree-pane, props]
    in let bounds = layout-rect work-x 4 work-w 436
    in let laid-out = widget-layout tree theme-terminal bounds
    in gop-render-tree laid-out theme-terminal gb wh

