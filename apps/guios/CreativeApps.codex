Chapter: CreativeApps
  cites Guios chapter GuiDisplay
  cites Guios chapter GuiTimer

 Creative app views: Capture, ImgTools, Diagram, Designer.

Section: Capture View (view 17)
  draw-view-capture : GopBuf, ShellUiState -> Integer
  draw-view-capture (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Capture"
    in let cx = x + 10
    in let dummy2 = draw-text-f gb wh cx 28 "Full" col-dim font-role-sans
    in let dummy3 = draw-text-f gb wh (cx + 50) 28 "Window" col-dim font-role-sans
    in let dummy4 = draw-text-f gb wh (cx + 120) 28 "Region" col-accent font-role-sans
    in let dummy5 = gop-buf-rect gb (cx + 120) 44 50 2 col-accent
    in let dummy6 = draw-text-f gb wh (cx + 190) 28 "Timer" col-dim font-role-sans
    in let dummy7 = gop-buf-hline gb cx (x + work-w - 10) 52 col-sep
    in let dummy8 = gop-buf-rect gb cx 60 (work-w - 20) 320 col-sep
    in let dummy9 = gop-buf-outline gb (cx + 60) 100 260 160 col-accent
    in let dummy10 = gop-buf-rect gb (cx + 58) 98 6 6 col-accent
    in let dummy11 = gop-buf-rect gb (cx + 316) 98 6 6 col-accent
    in let dummy12 = gop-buf-rect gb (cx + 58) 256 6 6 col-accent
    in let dummy13 = gop-buf-rect gb (cx + 316) 256 6 6 col-accent
    in let dummy14 = gop-buf-hline gb cx (x + work-w - 10) 388 col-sep
    in draw-kv gb wh cx 396 "Region" "260 x 160  Ready" col-dim col-dim

Section: ImgTools View (view 18)
  draw-view-imgtools : GopBuf, ShellUiState -> Integer
  draw-view-imgtools (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "ImgTools"
    in let tw = 70
    in let dummy2 = gop-buf-rect gb (x + 4) 28 tw 380 col-win-title
    in let dummy3 = draw-text-f gb wh (x + 8) 34 "Tools" col-accent font-role-sans
    in let dummy4 = gop-buf-hline gb (x + 8) (x + tw) 50 col-sep
    in let dummy5 = draw-text-f gb wh (x + 8) 58 "Select" col-fg2 font-role-serif
    in let dummy6 = draw-text-f gb wh (x + 8) 76 "Crop" col-fg2 font-role-serif
    in let dummy7 = gop-buf-rect gb (x + 6) 92 (tw - 4) 18 col-sidebar-sel
    in let dummy8 = draw-text-f gb wh (x + 8) 94 "Pen" col-accent font-role-serif
    in let dummy9 = draw-text-f gb wh (x + 8) 112 "Brush" col-fg2 font-role-serif
    in let dummy10 = draw-text-f gb wh (x + 8) 130 "Eraser" col-fg2 font-role-serif
    in let dummy11 = draw-text-f gb wh (x + 8) 148 "Fill" col-fg2 font-role-serif
    in let dummy12 = draw-text-f gb wh (x + 8) 166 "Text" col-fg2 font-role-serif
    in let dummy13 = draw-text-f gb wh (x + 8) 184 "Eyedrop" col-fg2 font-role-serif
    in let dummy14 = gop-buf-hline gb (x + 8) (x + tw) 204 col-sep
    in let dummy15 = draw-text-f gb wh (x + 8) 212 "Color" col-dim font-role-sans
    in let dummy16 = gop-buf-rect gb (x + 8) 230 24 24 col-accent
    in let dummy17 = gop-buf-outline gb (x + 8) 230 24 24 col-fg
    in let dummy18 = gop-buf-rect gb (x + 36) 230 24 24 col-red
    in let dummy19 = gop-buf-rect gb (x + 8) 258 24 24 col-green
    in let dummy20 = gop-buf-rect gb (x + 36) 258 24 24 col-yellow
    in let cx = x + tw + 8
    in let cw = work-w - tw - 12
    in let dummy21 = gop-buf-outline gb cx 28 cw 360 #475569
    in let dummy22 = gop-buf-rect gb (cx + 1) 29 (cw - 2) 358 #1E2836
    in let dummy23 = gop-buf-outline gb (cx + 30) 70 100 70 col-fg2
    in let dummy24 = gop-buf-rect gb (cx + 170) 100 50 50 col-accent
    in let dummy25 = gop-buf-rect gb (cx + 80) 180 120 40 col-teal
    in let dummy26 = gop-buf-outline gb (cx + 250) 60 80 80 col-purple
    in let dummy27 = gop-buf-hline gb (x + 4) (x + work-w - 4) 396 col-sep
    in let dummy28 = draw-kv gb wh (x + 8) 404 "Tool: Pen" "Color: #3B82F6" col-dim col-accent
    in draw-kv gb wh (cx) 404 "Canvas" (show cw & "x358") col-dim col-dim

Section: Diagram View (view 19)
  draw-view-diagram : GopBuf, ShellUiState -> Integer
  draw-view-diagram (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let dummy = draw-win gb wh x 4 work-w 436 "Diagram"
    in let dummy2 = gop-buf-rect gb (x + 4) 28 (work-w - 8) 370 col-sep
    in let bx1 = x + 40
    in let by1 = 80
    in let bx2 = x + 220
    in let by2 = 80
    in let bx3 = x + 220
    in let by3 = 200
    in let dummy3 = gop-buf-rect gb bx1 by1 90 40 col-win-body
    in let dummy4 = gop-buf-outline gb bx1 by1 90 40 col-accent
    in let dummy5 = draw-text-f gb wh (bx1 + 16) (by1 + 12) "Start" col-fg font-role-sans
    in let dummy6 = gop-buf-rect gb bx2 by2 110 40 col-win-body
    in let dummy7 = gop-buf-outline gb bx2 by2 110 40 col-accent
    in let dummy8 = draw-text-f gb wh (bx2 + 16) (by2 + 12) "Process" col-fg font-role-sans
    in let dummy9 = gop-buf-rect gb bx3 by3 90 40 col-win-body
    in let dummy10 = gop-buf-outline gb bx3 by3 90 40 col-green
    in let dummy11 = draw-text-f gb wh (bx3 + 22) (by3 + 12) "End" col-fg font-role-sans
    in let dummy12 = gop-buf-hline gb (bx1 + 90) bx2 100 col-accent
    in let dummy13 = gop-buf-vline gb (bx2 + 55) (by2 + 40) by3 col-accent
    in let dummy14 = gop-buf-hline gb (x + 4) (x + work-w - 4) 406 col-sep
    in draw-kv gb wh (x + 10) 414 "3 shapes" "2 connections" col-dim col-dim

Section: Designer View (view 20)
  draw-view-designer : GopBuf, ShellUiState -> Integer
  draw-view-designer (gb) (st) =
    let x = work-x
    in let wh = st.su-wheel
    in let hw = work-w / 2 - 2
    in let dummy = draw-win gb wh x 4 hw 436 "Widget Tree"
    in let cx = x + 10
    in let dummy2 = draw-text-f gb wh cx 28 "Window" col-fg font-role-sans
    in let dummy3 = draw-text-f gb wh (cx + 16) 46 "Header" col-fg font-role-sans
    in let dummy4 = draw-text-f gb wh (cx + 32) 64 "Logo" col-dim font-role-sans
    in let dummy5 = draw-text-f gb wh (cx + 32) 82 "Title" col-dim font-role-sans
    in let dummy6 = draw-text-f gb wh (cx + 16) 100 "Body" col-fg font-role-sans
    in let dummy7 = gop-buf-rect gb (cx + 28) 116 (hw - 44) 18 col-sidebar-sel
    in let dummy8 = draw-text-f gb wh (cx + 32) 118 "Button" col-accent font-role-sans
    in let dummy9 = draw-text-f gb wh (cx + 32) 136 "Input" col-dim font-role-sans
    in let dummy10 = draw-text-f gb wh (cx + 16) 154 "Footer" col-fg font-role-sans
    in let x2 = x + hw + 4
    in let dummy11 = draw-win gb wh x2 4 hw 436 "Properties"
    in let cx2 = x2 + 10
    in let dummy12 = draw-kv gb wh cx2 28 "Type" "Button" col-fg col-accent
    in let dummy13 = draw-kv gb wh cx2 46 "Text" "Submit" col-fg col-fg2
    in let dummy14 = draw-kv gb wh cx2 64 "Width" "120" col-fg col-fg2
    in let dummy15 = draw-kv gb wh cx2 82 "Height" "36" col-fg col-fg2
    in let dummy16 = gop-buf-hline gb cx2 (x2 + hw - 10) 100 col-sep
    in let dummy17 = draw-kv gb wh cx2 108 "Color" "#3B82F6" col-fg col-accent
    in let dummy18 = draw-kv gb wh cx2 126 "Font" "Sans 14" col-fg col-fg2
    in let dummy19 = draw-kv gb wh cx2 144 "Padding" "8 16" col-fg col-fg2
    in draw-kv gb wh cx2 162 "Border" "1px solid" col-fg col-dim

