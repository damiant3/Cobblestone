Section: Issue Insert
  tk-db-insert-issue : DbServer, Integer, Text, Text, Integer, Integer, Text, Text, Text, Text, Integer, Text, Text -> DbServer
  tk-db-insert-issue (srv) (id) (key) (title) (status) (priority) (label) (assignee) (project) (cycle) (estimate) (description) (created) =
    let row = [ValInteger id, ValText key, ValText title, ValInteger status, ValInteger priority, ValText label, ValText assignee, ValText project, ValText cycle, ValInteger estimate, ValText description, ValText created]
    in tk-db-insert srv "issues" row

  tk-db-insert : DbServer, Text, List ColumnValue -> DbServer
  tk-db-insert (srv) (table) (values) =
    let cat = srv.db-catalog
    in let tbl = catalog-get-table cat table
    in when tbl
      is Just (ct) ->
        let schema = table-schema (ct.cat-table-def)
        in let row = row-new schema values
        in let result = catalog-insert-row cat table row
        in __record-set srv "db-catalog" (result.cir-cat)
      is None -> srv

Section: Issue Queries
  tk-db-query : DbServer, RelOp -> QueryResult
  tk-db-query (srv) (op) = query (srv.db-catalog) op

  tk-db-all-issues : DbServer -> QueryResult
  tk-db-all-issues (srv) =
    tk-db-query srv (RelSort (RelScan "issues") [SortSpec { sort-col = "id", sort-dir = SortAsc }])

  tk-db-issues-by-status : DbServer, Integer -> QueryResult
  tk-db-issues-by-status (srv) (status) =
    tk-db-query srv (RelFilter (RelScan "issues") (PredColCmp "status" CmpEq (ValInteger status)))

  tk-db-issues-by-project : DbServer, Text -> QueryResult
  tk-db-issues-by-project (srv) (project) =
    tk-db-query srv (RelFilter (RelScan "issues") (PredColCmp "project" CmpEq (ValText project)))

  tk-db-issues-by-cycle : DbServer, Text -> QueryResult
  tk-db-issues-by-cycle (srv) (cycle) =
    tk-db-query srv (RelFilter (RelScan "issues") (PredColCmp "cycle" CmpEq (ValText cycle)))

  tk-db-count-by-status : DbServer, Integer -> Integer
  tk-db-count-by-status (srv) (status) =
    let result = tk-db-issues-by-status srv status
    in result.qr-count

  tk-db-count-open : DbServer -> Integer
  tk-db-count-open (srv) =
    let result = tk-db-query srv (RelFilter (RelScan "issues") (PredAnd (PredColCmp "status" CmpGe (ValInteger 0)) (PredColCmp "status" CmpLt (ValInteger 4))))
    in result.qr-count

  tk-db-issue-count : DbServer -> Integer
  tk-db-issue-count (srv) = catalog-table-row-count (srv.db-catalog) "issues"

Section: Row Helpers

 These were two local wrappers, row-get-value and row-set-value, over
 the Data quire. The get was a pure rename of row-get-by-name and the
 set was the by-name setter the Row chapter did not have. Row has both
 now, so the wrappers are gone rather than shadowing under a second
 name: IssueStore called row-set-value without defining it, which is a
 name that resolves nowhere and a chapter that does not compile, and
 two chapters keeping private copies of the same helper is what makes
 that possible.

Section: Issue Update

 This queried for the row, set the field, and then INSERTED the result,
 leaving the original in place: an update added a second row with the
 same id rather than replacing the first. It compiled and it ran, which
 is why it survived. A QueryResult carries no RowId, so there was
 nothing to update in place with; catalog-scan carries one and
 catalog-update-row takes it.

  tk-db-update-field : DbServer, Integer, Text, ColumnValue -> DbServer
  tk-db-update-field (srv) (id) (field) (val) =
    let sr = catalog-scan (srv.db-catalog) "issues"
    in let idx = tk-find-row-index sr id 0 (sr.scan-count)
    in if idx < 0 then srv
    else let updated = row-set-by-name (list-at (sr.rows) idx) field val
    in let res = catalog-update-row (srv.db-catalog) "issues" (list-at (sr.row-ids) idx) updated
    in if res.cir-ok == False then srv
    else __record-set srv "db-catalog" (res.cir-cat)

  tk-find-row-index : ScanResult, Integer, Integer, Integer -> Integer
  tk-find-row-index (sr) (id) (i) (len) =
    if i >= len then -1
    else if tk-row-int (list-at (sr.rows) i) "id" == id then i
    else tk-find-row-index sr id (i + 1) len

  tk-db-update-status : DbServer, Integer, Integer -> DbServer
  tk-db-update-status (srv) (id) (new-status) =
    tk-db-update-field srv id "status" (ValInteger new-status)

  tk-db-update-priority : DbServer, Integer, Integer -> DbServer
  tk-db-update-priority (srv) (id) (new-priority) =
    tk-db-update-field srv id "priority" (ValInteger new-priority)

Section: Row Field Access
  tk-row-int : RowData, Text -> Integer
  tk-row-int (row) (col) =
    let v = row-get-by-name row col
    in when v
      is ValInteger (n) -> n
      is otherwise -> 0

  tk-row-text : RowData, Text -> Text
  tk-row-text (row) (col) =
    let v = row-get-by-name row col
    in when v
      is ValText (s) -> s
      is otherwise -> ""

Section: Project/Cycle/Label Insert
  tk-db-insert-project : DbServer, Integer, Text, Text, Integer -> DbServer
  tk-db-insert-project (srv) (id) (name) (lead) (color) =
    tk-db-insert srv "projects" [ValInteger id, ValText name, ValText lead, ValInteger color]

  tk-db-insert-cycle : DbServer, Integer, Text, Text, Text, Boolean -> DbServer
  tk-db-insert-cycle (srv) (id) (name) (start-date) (end-date) (active) =
    tk-db-insert srv "cycles" [ValInteger id, ValText name, ValText start-date, ValText end-date, ValBoolean active]

  tk-db-insert-label : DbServer, Integer, Text, Integer -> DbServer
  tk-db-insert-label (srv) (id) (name) (color) =
    tk-db-insert srv "labels" [ValInteger id, ValText name, ValInteger color]

Section: Convenience
  tk-db-next-id : DbServer -> Integer
  tk-db-next-id (srv) = tk-db-issue-count srv + 1

  tk-db-next-key : DbServer -> Text
  tk-db-next-key (srv) = "CDX-" & show (tk-db-issue-count srv + 129)

