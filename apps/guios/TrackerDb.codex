    let s1 = tk-db-insert-issue srv 1 "CDX-142" "Fix emit-prologue crash" 2 0 "bug" "Damian" "Compiler" "Sprint 14" 3 "Emit-prologue generates incorrect stack frame size with >4 locals." "2026-06-21"
    in let s2 = tk-db-insert-issue s1 2 "CDX-141" "UNet multi-head attention" 2 1 "feature" "Val" "AssetForge" "Sprint 14" 5 "Split Q/K/V into per-head chunks for proper multi-head attention." "2026-06-22"
