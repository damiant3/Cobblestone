 Database schema and operations for the issue tracker. Uses the
 workflow engine pattern: DbServer carries the catalog, state
 flows through via __record-set. Tables: issues, projects, cycles,
 labels. Full relational queries via Executor.

 We say:

Section: Table Creation
  tk-create-table : DbServer, Text, List ColumnDef -> DbServer
  tk-create-table (srv) (name) (cols) =
    let tdef = table-def name cols
    in let result = catalog-create-table (srv.db-catalog) tdef
    in if result.cat-ok then __record-set srv "db-catalog" (result.cat)
    else srv

Section: Schema
  tk-init-tracker-db : DbServer
  tk-init-tracker-db =
    let srv = db-server-new "tracker"
    in let s1 = tk-create-table srv "issues" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "key" ColText,
      col-def-not-null "title" ColText,
      col-def-not-null "status" ColInteger,
      col-def-not-null "priority" ColInteger,
      col-def "label" ColText,
      col-def "assignee" ColText,
      col-def "project" ColText,
      col-def "cycle" ColText,
      col-def "estimate" ColInteger,
      col-def "description" ColText,
      col-def "created" ColText
    ]
    in let s2 = tk-create-table s1 "projects" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "name" ColText,
      col-def "lead" ColText,
      col-def "color" ColInteger
    ]
    in let s3 = tk-create-table s2 "cycles" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "name" ColText,
      col-def-not-null "start_date" ColText,
      col-def-not-null "end_date" ColText,
      col-def-not-null "active" ColBoolean
    ]
    in let s4 = tk-create-table s3 "labels" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "name" ColText,
      col-def-not-null "color" ColInteger
    ]
    in tk-seed-tracker s4

