Chapter: RadioStationMain
  cites Radio chapter RadioStation
  cites Foreword chapter Console

Section: Entry Point

  opening : [Console] Integer
  opening = act
    let app = radio-app-full "Codex FM" "DJ Codex"
    in let tree = radio-console-widget app
    in act
      print-line "=== Codex Radio Station ==="
      print-line ("Station: " & (app.ra-station).stn-name)
      print-line ("DJ: " & (app.ra-station).stn-dj-name)
      print-line ("Library: " & show (app.ra-library-count) & " tracks")
      print-line ("Playlist A: " & show (app.ra-playlist-count) & " queued")
      print-line ("Playlist B: " & show (app.ra-playlist-b-count) & " queued")
      print-line ("Presets: " & show (app.ra-preset-count) & " stations")
      print-line ("Now playing: " & ra-now-playing app)
      print-line "Console widget tree built."
      let status = 0
      in status
    end
  end
