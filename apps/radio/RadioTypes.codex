Chapter: RadioTypes

 Type system for the internet radio station. A station has two decks
 (A and B), a crossfader, per-deck EQ, a playlist queue, and a
 broadcast state. The DJ loads tracks from their local library,
 mixes between decks, and broadcasts the output via WebRTC.
 Listeners connect and hear the mixed output in real time.

Section: Track

  TrackState =
    | TsEmpty
    | TsLoading
    | TsReady
    | TsPlaying
    | TsPaused
    | TsStopped

  ts-label : TrackState -> Text
  ts-label (s) = when s
    is TsEmpty -> "empty"
    is TsLoading -> "loading"
    is TsReady -> "ready"
    is TsPlaying -> "playing"
    is TsPaused -> "paused"
    is TsStopped -> "stopped"

  Track = record {
    trk-title : Text,
    trk-artist : Text,
    trk-album : Text,
    trk-duration : Integer,
    trk-bpm : Integer,
    trk-genre : Text,
    trk-state : TrackState,
    trk-position : Integer,
    trk-waveform : List Integer
  }

  track-empty : Track
  track-empty = Track {
    trk-title = "", trk-artist = "", trk-album = "",
    trk-duration = 0, trk-bpm = 0, trk-genre = "",
    trk-state = TsEmpty, trk-position = 0, trk-waveform = []
  }

Section: Deck

  DeckId = | DeckA | DeckB

  deck-label : DeckId -> Text
  deck-label (d) = when d is DeckA -> "A" is DeckB -> "B"

  EqBand = record {
    eq-low : Integer,
    eq-mid : Integer,
    eq-high : Integer
  }

  eq-flat : EqBand
  eq-flat = EqBand { eq-low = 0, eq-mid = 0, eq-high = 0 }

  DeckState = record {
    dk-id : DeckId,
    dk-track : Track,
    dk-volume : Integer,
    dk-eq : EqBand,
    dk-pitch : Integer,
    dk-loop-start : Integer,
    dk-loop-end : Integer,
    dk-loop-active : Boolean,
    dk-cue-point : Integer,
    dk-filter : Integer,
    dk-muted : Boolean
  }

  deck-new : DeckId -> DeckState
  deck-new (id) = DeckState {
    dk-id = id, dk-track = track-empty,
    dk-volume = 800, dk-eq = eq-flat,
    dk-pitch = 0, dk-loop-start = 0, dk-loop-end = 0,
    dk-loop-active = False, dk-cue-point = 0,
    dk-filter = 0, dk-muted = False
  }

Section: Mixer

  MixerState = record {
    mx-crossfader : Integer,
    mx-master-vol : Integer,
    mx-monitor-vol : Integer,
    mx-monitor-deck : DeckId,
    mx-auto-crossfade : Boolean,
    mx-crossfade-time : Integer
  }

  mixer-new : MixerState
  mixer-new = MixerState {
    mx-crossfader = 500,
    mx-master-vol = 800,
    mx-monitor-vol = 500,
    mx-monitor-deck = DeckA,
    mx-auto-crossfade = False,
    mx-crossfade-time = 8000
  }

Section: Station

  StationState = record {
    stn-name : Text,
    stn-genre : Text,
    stn-description : Text,
    stn-dj-name : Text,
    stn-listener-count : Integer,
    stn-broadcasting : Boolean,
    stn-uptime : Integer,
    stn-total-tracks : Integer
  }

  station-new : Text, Text -> StationState
  station-new (name) (dj) = StationState {
    stn-name = name, stn-genre = "",
    stn-description = "", stn-dj-name = dj,
    stn-listener-count = 0, stn-broadcasting = False,
    stn-uptime = 0, stn-total-tracks = 0
  }

Section: Playlist Entry

  PlaylistEntry = record {
    pe-title : Text,
    pe-artist : Text,
    pe-duration : Integer,
    pe-file-idx : Integer,
    pe-played : Boolean
  }

Section: Chat Message

  ChatMessage = record {
    cm-user : Text,
    cm-text : Text,
    cm-time : Integer
  }

Section: Time Formatting

  format-time : Integer -> Text
  format-time (ms) =
    let total-sec = ms / 1000
    in let mins = total-sec / 60
    in let secs = total-sec - mins * 60
    in show mins & ":" & (if secs < 10 then "0" else "") & show secs

