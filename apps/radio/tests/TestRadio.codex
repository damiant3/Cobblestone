Chapter: TestRadio
  cites Radio chapter RadioTypes
  cites Radio chapter RadioStation
  cites Foreword chapter Maybe

 Tests for the radio station app.

Section: Harness

  assert-eq : Text, Text, Text -> Text
  assert-eq (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected \"" & expected & "\" got \"" & actual & "\""

  assert-int : Text, Integer, Integer -> Text
  assert-int (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected " & show expected & " got " & show actual

  assert-true : Text, Boolean -> Text
  assert-true (label) (val) = if val then "PASS " & label else "FAIL " & label

Section: Track Types

  test-track : Text
  test-track =
    let t = track-empty
    in let t1 = assert-eq "empty-title" "" (t.trk-title)
    in let t2 = assert-eq "empty-state" "empty" (ts-label (t.trk-state))
    in t1 & "\n" & t2

Section: Deck

  test-deck : Text
  test-deck =
    let d = deck-new DeckA
    in let t1 = assert-eq "deck-id" "A" (deck-label (d.dk-id))
    in let t2 = assert-int "deck-vol" 800 (d.dk-volume)
    in let t3 = assert-int "eq-flat" 0 ((d.dk-eq).eq-low)
    in t1 & "\n" & t2 & "\n" & t3

Section: Mixer

  test-mixer : Text
  test-mixer =
    let m = mixer-new
    in let t1 = assert-int "crossfader" 500 (m.mx-crossfader)
    in let t2 = assert-int "master" 800 (m.mx-master-vol)
    in t1 & "\n" & t2

Section: App State

  test-app : Text
  test-app =
    let app = radio-app-new "Test FM" "DJ Test"
    in let t1 = assert-eq "station-name" "Test FM" ((app.ra-station).stn-name)
    in let t2 = assert-eq "dj-name" "DJ Test" ((app.ra-station).stn-dj-name)
    in let t3 = assert-true "not-broadcasting" (if (app.ra-station).stn-broadcasting then False else True)
    in let app2 = ra-toggle-broadcast app
    in let t4 = assert-true "broadcasting" ((app2.ra-station).stn-broadcasting)
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4

Section: Time Format

  test-time : Text
  test-time =
    let t1 = assert-eq "zero" "0:00" (format-time 0)
    in let t2 = assert-eq "one-min" "1:00" (format-time 60000)
    in let t3 = assert-eq "3:45" "3:45" (format-time 225000)
    in t1 & "\n" & t2 & "\n" & t3

