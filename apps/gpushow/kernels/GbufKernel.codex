Chapter: GbufKernel
  cites Gpu chapter DeviceEffect
  cites Gpu chapter DeviceMath

 We say:

Section: Parameters

  gb-width : Integer = 1024
  gb-half-w : Integer = 512
  gb-half-h : Integer = 384
  gb-count : Integer = 8
  gb-miss : Integer = 8000000

Section: Sphere Cluster

  gb-cx : Integer -> Real
  gb-cx (i) = if i == 0 then 0.0 else if i == 1 then 0.95 else if i == 2 then 0.0 - 0.85 else if i == 3 then 0.35 else if i == 4 then 0.0 - 0.45 else if i == 5 then 0.55 else if i == 6 then 0.0 - 0.6 else 0.15

  gb-cy : Integer -> Real
  gb-cy (i) = if i == 0 then 0.0 else if i == 1 then 0.35 else if i == 2 then 0.25 else if i == 3 then 0.0 - 0.8 else if i == 4 then 0.0 - 0.6 else if i == 5 then 0.75 else if i == 6 then 0.7 else 0.1

  gb-cz : Integer -> Real
  gb-cz (i) = if i == 0 then 0.0 else if i == 1 then 0.0 - 0.2 else if i == 2 then 0.1 else if i == 3 then 0.2 else if i == 4 then 0.0 - 0.3 else if i == 5 then 0.3 else if i == 6 then 0.0 - 0.1 else 0.8

  gb-rad : Integer -> Real
  gb-rad (i) = if i == 0 then 0.9 else if i == 1 then 0.62 else if i == 2 then 0.6 else if i == 3 then 0.55 else if i == 4 then 0.5 else if i == 5 then 0.5 else if i == 6 then 0.46 else 0.5

  gb-cr : Integer -> Real
  gb-cr (i) = if i == 0 then 0.85 else if i == 1 then 0.90 else if i == 2 then 0.25 else if i == 3 then 0.70 else if i == 4 then 0.35 else if i == 5 then 0.30 else if i == 6 then 0.95 else 0.90

  gb-cg : Integer -> Real
  gb-cg (i) = if i == 0 then 0.75 else if i == 1 then 0.30 else if i == 2 then 0.80 else if i == 3 then 0.35 else if i == 4 then 0.80 else if i == 5 then 0.45 else if i == 6 then 0.55 else 0.45

  gb-cb : Integer -> Real
  gb-cb (i) = if i == 0 then 0.45 else if i == 1 then 0.28 else if i == 2 then 0.75 else if i == 3 then 0.90 else if i == 4 then 0.40 else if i == 5 then 0.90 else if i == 6 then 0.30 else 0.65

Section: Intersection

  gb-hit : Real, Real, Real, Real, Real, Real, Integer -> Real
  gb-hit (ox) (oy) (oz) (dx) (dy) (dz) (i) =
    let lx = ox - gb-cx i
    in let ly = oy - gb-cy i
    in let lz = oz - gb-cz i
    in let b = dx * lx + dy * ly + dz * lz
    in let r = gb-rad i
    in let c = lx * lx + ly * ly + lz * lz - r * r
    in let disc = b * b - c
    in if disc < 0.0 then 0.0 - 1.0
    else let t = 0.0 - b - real-sqrt disc
    in if t > 0.001 then t else 0.0 - 1.0

  gb-nearest : Real, Real, Real, Real, Real, Real, Integer, Integer, Real -> Integer
  gb-nearest (ox) (oy) (oz) (dx) (dy) (dz) (i) (best-id) (best-t) =
    if i >= gb-count then best-id
    else let t = gb-hit ox oy oz dx dy dz i
    in let take = if t > 0.001 then (if best-t < 0.0 then 1 else if t < best-t then 1 else 0) else 0
    in if take == 1 then gb-nearest ox oy oz dx dy dz (i + 1) i t
    else gb-nearest ox oy oz dx dy dz (i + 1) best-id best-t

Section: Pack

  gb-nbyte : Real -> Integer
  gb-nbyte (n) = real-to-int ((n + 1.0) * 127.0)

Section: G-buffer Kernel

  gbuf-step : Integer, Integer, Integer, Integer -> [Device] Integer
  gbuf-step (galb) (gnrm) (gdep) (gid) =
    let px = gid - (gid / gb-width) * gb-width
    in let py = gid / gb-width
    in let fx = real-from-int (px - gb-half-w) / 384.0
    in let fy = real-from-int (gb-half-h - py) / 384.0
    in let rl = real-sqrt (fx * fx + fy * fy + 3.24)
    in let dx = fx / rl
    in let dy = fy / rl
    in let dz = 1.8 / rl
    in let ox = 0.0
    in let oy = 0.0
    in let oz = 0.0 - 5.0
    in let id = gb-nearest ox oy oz dx dy dz 0 (0 - 1) (0.0 - 1.0)
    in let t = if id < 0 then 0.0 else gb-hit ox oy oz dx dy dz id
    in let hx = ox + dx * t
    in let hy = oy + dy * t
    in let hz = oz + dz * t
    in let nx = if id < 0 then 0.0 else (hx - gb-cx id) / gb-rad id
    in let ny = if id < 0 then 1.0 else (hy - gb-cy id) / gb-rad id
    in let nz = if id < 0 then 0.0 else (hz - gb-cz id) / gb-rad id
    in let albv = if id < 0 then 0 else real-to-int (gb-cr id * 255.0) * 65536 + real-to-int (gb-cg id * 255.0) * 256 + real-to-int (gb-cb id * 255.0)
    in let nrmv = gb-nbyte nx * 65536 + gb-nbyte ny * 256 + gb-nbyte nz
    in let depv = if id < 0 then gb-miss else real-to-int (t * 256.0)
    in act
    s0 <- device-store galb gid albv
    s1 <- device-store gnrm gid nrmv
    device-store gdep gid depv
    end
