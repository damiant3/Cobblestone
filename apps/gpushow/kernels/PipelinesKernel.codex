Chapter: PipelinesKernel
  cites Gpu chapter DeviceEffect
  cites Gpu chapter DeviceMath

 We say:

Section: Parameters

  pl-width : Integer = 1024
  pl-half-w : Integer = 512
  pl-half-h : Integer = 384
  pl-count : Integer = 6

Section: Scene

  pl-cx : Integer -> Real
  pl-cx (i) = real-from-int i * 1.2 - 3.0

  pl-hit : Real, Real, Real, Real, Real, Real, Integer -> Real
  pl-hit (ox) (oy) (oz) (dx) (dy) (dz) (i) =
    let lx = ox - pl-cx i
    in let b = dx * lx + dy * oy + dz * oz
    in let c = lx * lx + oy * oy + oz * oz - 0.3025
    in let disc = b * b - c
    in if disc < 0.0 then 0.0 - 1.0 else let t = 0.0 - b - real-sqrt disc in if t > 0.001 then t else 0.0 - 1.0

  pl-nearest : Real, Real, Real, Real, Real, Real, Integer, Integer, Real -> Integer
  pl-nearest (ox) (oy) (oz) (dx) (dy) (dz) (i) (bid) (bt) =
    if i >= pl-count then bid
    else let t = pl-hit ox oy oz dx dy dz i
    in let take = if t > 0.001 then (if bt < 0.0 then 1 else if t < bt then 1 else 0) else 0
    in if take == 1 then pl-nearest ox oy oz dx dy dz (i + 1) i t else pl-nearest ox oy oz dx dy dz (i + 1) bid bt

Section: Shading

  pl-clamp01 : Real -> Real
  pl-clamp01 (x) = real-max 0.0 (real-min 1.0 x)

  pl-pack : Real, Real, Real -> Integer
  pl-pack (r) (g) (b) =
    real-to-int (pl-clamp01 r * 255.0) * 65536 + real-to-int (pl-clamp01 g * 255.0) * 256 + real-to-int (pl-clamp01 b * 255.0)

  pl-render : Integer, Integer -> Integer
  pl-render (gid) (frame) =
    let px = gid - (gid / pl-width) * pl-width
    in let py = gid / pl-width
    in let fx = real-from-int (px - pl-half-w) / 384.0
    in let fy = real-from-int (pl-half-h - py) / 384.0
    in let rl = real-sqrt (fx * fx + fy * fy + 4.0)
    in let dx = fx / rl
    in let dy = fy / rl
    in let dz = 2.0 / rl
    in let oz = 0.0 - 5.0
    in let id = pl-nearest 0.0 0.0 oz dx dy dz 0 (0 - 1) (0.0 - 1.0)
    in if id < 0 then let h = pl-clamp01 (dy * 0.5 + 0.5) in pl-pack (0.05 + h * 0.05) (0.06 + h * 0.08) (0.10 + h * 0.14)
    else let t = pl-hit 0.0 0.0 oz dx dy dz id
    in let hx = dx * t
    in let hy = dy * t
    in let hz = oz + dz * t
    in let nx = (hx - pl-cx id) / 0.55
    in let ny = hy / 0.55
    in let nz = hz / 0.55
    in let la = real-from-int frame / 30.0
    in let lx = real-cos la * 0.5
    in let ly = 0.7
    in let lz = real-sin la * 0.5 - 0.4
    in let ll = real-sqrt (lx * lx + ly * ly + lz * lz)
    in let ndl = real-max 0.0 (nx * lx / ll + ny * ly / ll + nz * lz / ll)
    in let vdn = 0.0 - (dx * nx + dy * ny + dz * nz)
    in let hlx = lx / ll - dx
    in let hly = ly / ll - dy
    in let hlz = lz / ll - dz
    in let hl = real-sqrt (hlx * hlx + hly * hly + hlz * hlz) + 0.001
    in let spec = real-max 0.0 (nx * hlx / hl + ny * hly / hl + nz * hlz / hl)
    in let s2 = spec * spec in let s8 = s2 * s2 * s2 * s2
    in if id == 0 then pl-pack 0.55 0.35 0.75
    else if id == 1 then pl-pack (0.3 * (0.2 + ndl)) (0.6 * (0.2 + ndl)) (0.9 * (0.2 + ndl))
    else if id == 2 then pl-pack (0.85 * ndl + s8) (0.5 * ndl + s8) (0.3 * ndl + s8)
    else if id == 3 then (let band = if ndl > 0.75 then 1.0 else if ndl > 0.4 then 0.65 else if ndl > 0.15 then 0.38 else 0.18 in pl-pack (0.9 * band) (0.55 * band) (0.35 * band))
    else if id == 4 then pl-pack (nx * 0.5 + 0.5) (ny * 0.5 + 0.5) (nz * 0.5 + 0.5)
    else (let fres = pl-clamp01 (1.0 - vdn) in let f5 = fres * fres * fres * fres * fres in pl-pack (0.1 + f5 * 0.9) (0.15 + f5 * 0.85) (0.25 + f5 * 0.75))

Section: Pipelines Kernel

  pipelines-step : Integer, Integer, Integer -> [Device] Integer
  pipelines-step (outb) (frame) (gid) = act
    device-store outb gid (pl-render gid frame)
  end
