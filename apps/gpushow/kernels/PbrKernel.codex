Chapter: PbrKernel
  cites Gpu chapter DeviceEffect
  cites Gpu chapter DeviceMath

 We say:

Section: Parameters

  pb-width : Integer = 1024
  pb-half-w : Integer = 512
  pb-half-h : Integer = 384
  pb-count : Integer = 7

Section: Sphere Row

  pb-cx : Integer -> Real
  pb-cx (i) = real-from-int (i) * 1.15 - 3.45

  pb-rough : Integer -> Real
  pb-rough (i) = 0.06 + real-from-int (i) * 0.145

  pb-rad : Real
  pb-rad = 0.52

  pb-sphere-hit : Real, Real, Real, Real, Real, Real, Integer -> Real
  pb-sphere-hit (ox) (oy) (oz) (dx) (dy) (dz) (i) =
    let lx = ox - pb-cx i
    in let ly = oy
    in let lz = oz
    in let b = dx * lx + dy * ly + dz * lz
    in let c = lx * lx + ly * ly + lz * lz - pb-rad * pb-rad
    in let disc = b * b - c
    in if disc < 0.0 then 0.0 - 1.0
    else let t = 0.0 - b - real-sqrt disc
    in if t > 0.001 then t else 0.0 - 1.0

  pb-nearest : Real, Real, Real, Real, Real, Real, Integer, Integer, Real -> Integer
  pb-nearest (ox) (oy) (oz) (dx) (dy) (dz) (i) (best-id) (best-t) =
    if i >= pb-count then best-id
    else let t = pb-sphere-hit ox oy oz dx dy dz i
    in let take = if t > 0.001 then (if best-t < 0.0 then 1 else if t < best-t then 1 else 0) else 0
    in if take == 1 then pb-nearest ox oy oz dx dy dz (i + 1) i t
    else pb-nearest ox oy oz dx dy dz (i + 1) best-id best-t

Section: Cook-Torrance BRDF

  pb-clamp01 : Real -> Real
  pb-clamp01 (x) = real-max 0.0 (real-min 1.0 x)

  pb-pow5 : Real -> Real
  pb-pow5 (x) = let x2 = x * x in x2 * x2 * x

 GGX / Trowbridge-Reitz normal distribution (the pi factor is folded into the
 final scale). a is roughness squared.

  pb-ggx : Real, Real -> Real
  pb-ggx (ndh) (a) =
    let a2 = a * a
    in let d = ndh * ndh * (a2 - 1.0) + 1.0
    in a2 / (d * d + 0.0001)

 Smith geometry with the Schlick-GGX k for direct lighting.

  pb-g1 : Real, Real -> Real
  pb-g1 (nx) (k) = nx / (nx * (1.0 - k) + k + 0.0001)

Section: Shading

  pb-pack : Real, Real, Real -> Integer
  pb-pack (r) (g) (b) =
    let ri = real-to-int (pb-clamp01 r * 255.0)
    in let gi = real-to-int (pb-clamp01 g * 255.0)
    in let bi = real-to-int (pb-clamp01 b * 255.0)
    in ri * 65536 + gi * 256 + bi

  pb-bg : Integer -> Integer
  pb-bg (py) =
    let h = real-from-int py / 768.0
    in pb-pack (0.03 + h * 0.05) (0.04 + h * 0.06) (0.06 + h * 0.10)

  pb-render : Integer, Integer -> Integer
  pb-render (gid) (frame) =
    let px = gid - (gid / pb-width) * pb-width
    in let py = gid / pb-width
    in let fx = real-from-int (px - pb-half-w) / 384.0
    in let fy = real-from-int (pb-half-h - py) / 384.0
    in let rl = real-sqrt (fx * fx + fy * fy + 4.0)
    in let dx = fx / rl
    in let dy = fy / rl
    in let dz = 2.0 / rl
    in let ox = 0.0
    in let oy = 0.0
    in let oz = 0.0 - 5.0
    in let id = pb-nearest ox oy oz dx dy dz 0 (0 - 1) (0.0 - 1.0)
    in if id < 0 then pb-bg py
    else let t = pb-sphere-hit ox oy oz dx dy dz id
    in let hx = ox + dx * t
    in let hy = oy + dy * t
    in let hz = oz + dz * t
    in let nx = (hx - pb-cx id) / pb-rad
    in let ny = hy / pb-rad
    in let nz = hz / pb-rad
    in let ang = real-from-int frame / 40.0
    in let lx0 = real-cos ang * 0.5 + 0.3
    in let ly0 = 0.7
    in let lz0 = real-sin ang * 0.5 - 0.5
    in let ll = real-sqrt (lx0 * lx0 + ly0 * ly0 + lz0 * lz0)
    in let lx = lx0 / ll
    in let ly = ly0 / ll
    in let lz = lz0 / ll
    in let vx = 0.0 - dx
    in let vy = 0.0 - dy
    in let vz = 0.0 - dz
    in let hlx = lx + vx
    in let hly = ly + vy
    in let hlz = lz + vz
    in let hl = real-sqrt (hlx * hlx + hly * hly + hlz * hlz) + 0.0001
    in let hnx = hlx / hl
    in let hny = hly / hl
    in let hnz = hlz / hl
    in let ndl = real-max 0.0 (nx * lx + ny * ly + nz * lz)
    in let ndv = real-max 0.0 (nx * vx + ny * vy + nz * vz)
    in let ndh = real-max 0.0 (nx * hnx + ny * hny + nz * hnz)
    in let vdh = real-max 0.0 (vx * hnx + vy * hny + vz * hnz)
    in let rough = pb-rough id
    in let a = rough * rough
    in let k = a * 0.5
    in let dggx = pb-ggx ndh a
    in let gsm = pb-g1 ndv k * pb-g1 ndl k
    in let fres = 0.04 + 0.96 * pb-pow5 (1.0 - vdh)
    in let spec = dggx * gsm * fres / (4.0 * ndv * ndl + 0.01)
    in let kd = 1.0 - fres
    in let dr = 0.90 * kd
    in let dg = 0.72 * kd
    in let db = 0.30 * kd
    in let sr = (dr + spec) * ndl + 0.05
    in let sg = (dg + spec) * ndl + 0.06
    in let sb = (db + spec) * ndl + 0.08
    in pb-pack sr sg sb

Section: PBR Kernel

  pbr-step : Integer, Integer, Integer -> [Device] Integer
  pbr-step (outb) (frame) (gid) = act
    device-store outb gid (pb-render gid frame)
  end
