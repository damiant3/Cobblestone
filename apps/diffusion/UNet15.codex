Section: Native Graph

  unet15-embedding : UNetFile, Real -> Integer
  unet15-embedding (u) (t) = unet15-embedding-with unet-native-ops u t

  u15-stage : UNetFile, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Text, Boolean -> Integer
  u15-stage (u) (x) (embs) (ctx) (cin) (cout) (h) (w) (p) (attn) = u15-stage-with unet-native-ops u x embs ctx cin cout h w p attn

  unet15-forward : UNetFile, Integer, Integer, Integer, Integer, Integer -> List Integer
  unet15-forward (u) (x) (embs) (ctx) (h) (w) = unet15-forward-with unet-native-ops u x embs ctx h w

