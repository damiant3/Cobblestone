Chapter: ImageGenBrowser
  cites WebApp chapter WebRuntime
  cites Diffusion chapter BrowserSdxlLoad

 We say:

  IpModel = record {
    im-family : Text,
    im-width : Integer,
    im-height : Integer,
    im-close : (Integer -> Integer),
    im-run : (Text, Text, Text, Text, Text, Integer, Integer, (Text -> Integer), (Integer, Text -> Integer) -> Integer)
  }

  ip-empty : IpModel
  ip-empty = IpModel { im-family = "", im-width = 512, im-height = 512, im-close = \z -> 0, im-run = \p n s t c w h log done -> done (0 - 3) "Load a checkpoint first." }

  ip-el : Text, Text, Text -> DomElement
  ip-el (tag) (id) (text) =
    let e = dom-create tag
    in let a = dom-set-attr e "id" id
    in let b = dom-set-text e text
    in let c = dom-append (dom-query "#ip") e
    in e

  ip-field : Text, Text, Text -> DomElement
  ip-field (label) (id) (value) =
    let l = ip-el "label" (id & "-label") label
    in let a = dom-set-style l "display" "block"
    in let i = dom-create "input"
    in let b = dom-set-attr i "id" id
    in let c = dom-set-value i value
    in let d = dom-set-style i "width" "100%"
    in let e = dom-append l i
    in i

  ip-status : Text -> Integer
  ip-status (text) = let e = dom-set-text (dom-query "#status") text in 0

  ip-log : Text -> Integer
  ip-log (text) =
    let ms = clock-ms 0
    in let line = dom-set-text (dom-create "div") ("[" & show (ms / 1000) & "." & show (ms / 100 - ms / 1000 * 10) & "s] " & text)
    in let a = dom-append (dom-query "#console") line
    in 0

  ip-button : Text, Text -> DomElement
  ip-button (id) (label) = let b = dom-create "button" in let a = dom-set-attr b "id" id in dom-set-text b label

  ip-picker : IpModel -> Integer
  ip-picker (m) =
    let box = dom-set-html (dom-query "#pick-box") ""
    in let button = ip-button "pick" "Choose models folder"
    in let added = dom-append box button
    in let click = dom-on-click button (\id -> ip-pick m)
    in 0

  ip-go : IpModel -> Integer
  ip-go (m) =
    let box = dom-set-html (dom-query "#go-box") ""
    in let button = ip-button "go" (if m.im-family == "" then "Generate (load a checkpoint first)" else "Generate")
    in let added = dom-append box button
    in let enabled = if m.im-family == "" then dom-set-attr button "disabled" "disabled" else dom-on-click button (\id -> ip-generate m)
    in 0

  ip-bind : IpModel, List (List Text) -> Integer
  ip-bind (m) (rows) =
    let picker = ip-picker m
    in let go = ip-go m
    in let box = dom-set-html (dom-query "#unload-box") ""
    in let button = ip-button "unload" "Unload checkpoint"
    in let unload = if m.im-family == "" then box else (let added = dom-append box button in dom-on-click button (\id -> ip-unload m rows))
    in let clear = dom-set-html (dom-query "#models") ""
    in ip-rows m rows 0

  ip-pick : IpModel -> Integer
  ip-pick (m) = if state-get "busy" /= 0 then 0 else pick-dir-then "" (\r -> ip-listed m r)

  ip-ending : List (List Text), Integer, Text, List (List Text) -> List (List Text)
  ip-ending (rows) (i) (suffix) (acc) =
    if i >= list-length rows then acc
    else ip-ending rows (i + 1) suffix (if text-ends-with (json-obj-field (list-at rows i) "path") suffix then list-push acc (list-at rows i) else acc)

  ip-tokenizer-file : List (List Text), Text -> Text
  ip-tokenizer-file (all) (file) =
    let hits = ip-ending all 0 ("/" & file) []
    in let clip = ip-ending hits 0 ("tokenizers/clip/" & file) []
    in if list-length clip > 0 then json-obj-field (list-at clip 0) "name"
    else if list-length hits > 0 then json-obj-field (list-at hits 0) "name" else ""

  ip-listed : IpModel, Text -> Integer
  ip-listed (m) (data) =
    if state-get "busy" /= 0 then 0
    else if json-obj-field (json-parse-obj data) "error" /= "" then ip-status ("Model selection unchanged: " & json-obj-field (json-parse-obj data) "error")
    else let busy = state-set "busy" 1
    in let all = json-parse-rows data
    in let rows = ip-ending all 0 ".safetensors" []
    in let v = state-set-text "vocab-file" (ip-tokenizer-file all "vocab.json")
    in let mg = state-set-text "merges-file" (ip-tokenizer-file all "merges.txt")
    in let clear = dom-set-html (dom-query "#models") ""
    in let s = ip-status ("Checking " & show (list-length rows) & " checkpoint files...")
    in ip-check m rows 0 0

  ip-check : IpModel, List (List Text), Integer, Integer -> Integer
  ip-check (m) (rows) (i) (good) =
    if i >= list-length rows then
      let idle = state-set "busy" 0
      in let bind = ip-bind m rows
      in ip-status ("Checked " & show (list-length rows) & " files: " & show good & " supported SD1.5 or SDXL checkpoints. Click one to load it.")
    else bl-family-then (json-obj-field (list-at rows i) "name") (\family -> (let saved = state-set-text ("family" & show i) family in ip-check m rows (i + 1) (if family == "" then good else good + 1)))

  ip-rows : IpModel, List (List Text), Integer -> Integer
  ip-rows (m) (rows) (i) =
    if i >= list-length rows then 0
    else let row = list-at rows i
    in let family = state-get-text ("family" & show i)
    in let e = dom-create "div"
    in let id = dom-set-attr e "id" ("m" & show i)
    in let text = dom-set-text e (json-obj-field row "path" & "  (" & (if family == "" then "unsupported checkpoint" else family) & ")")
    in let color = dom-set-style e "color" (if family == "" then "#b00" else "#000")
    in let added = dom-append (dom-query "#models") e
    in let click = if family == "" then e else dom-on-click (dom-set-style e "cursor" "pointer") (\id -> ip-load m rows row family)
    in ip-rows m rows (i + 1)

  ip-unload : IpModel, List (List Text) -> Integer
  ip-unload (m) (rows) =
    if state-get "busy" /= 0 then 0
    else let busy = state-set "busy" 1
    in let closed = m.im-close 0
    in let disabled = ip-go ip-empty
    in gpu-trim-then (\r -> (let idle = state-set "busy" 0 in let loaded = state-set "loaded" 0 in let bind = ip-bind ip-empty rows in ip-status (if r == "" then "Checkpoint unloaded." else "GPU release failed: " & r)))

  ip-failed : List (List Text), Text -> Integer
  ip-failed (rows) (why) =
    let weights = bl-free-weights (bl-list ("[" & state-get-text "bl-weights" & "]")) 0
    in gpu-trim-then (\r -> (let idle = state-set "busy" 0 in let loaded = state-set "loaded" 0 in let bind = ip-bind ip-empty rows in ip-status ("Load failed: " & why & (if r == "" then "" else "; " & r))))

  ip-load : IpModel, List (List Text), List Text, Text -> Integer
  ip-load (old) (rows) (row) (family) =
    if state-get "busy" /= 0 then 0
    else let busy = state-set "busy" 1
    in let closed = old.im-close 0
    in let loaded = state-set "loaded" 0
    in let disabled = ip-go ip-empty
    in let path = state-set-text "path" (json-obj-field row "path")
    in let time = state-set "load-t0" (clock-ms 0)
    in let s = ip-status ("Loading " & family & ": " & state-get-text "path" & "...")
    in gpu-trim-then (\r -> if r /= "" then ip-failed rows r else gpu-open-then (\opened -> ip-opened rows row family opened))

  ip-opened : List (List Text), List Text, Text, Text -> Integer
  ip-opened (rows) (row) (family) (result) =
    if text-contains result "\"ok\":true" == False then ip-failed rows result
    else let adapter = state-set-text "bl-adapter" (json-obj-field (json-parse-obj result) "adapter")
    in let opened = state-set "bl-gpu" 1
    in bl-bpe-then (state-get-text "vocab-file") (state-get-text "merges-file") (\why -> ip-failed rows why) (\bpe ->
      if clip-bpe-status bpe /= 0 then ip-failed rows "The CLIP tokenizer did not load."
      else if family == "SDXL" then browser-sdxl-open (json-obj-field row "name") (text-to-integer (json-obj-field row "size")) (page-data "bk") (page-data "clip") (\m -> ip-xl-ready rows bpe m) (\why -> ip-failed rows why)
      else bl-load-then (json-obj-field row "name") ip-progress (\why -> ip-failed rows why) (\m -> ip-sd-ready rows bpe m))

  ip-progress : Integer, Integer -> Integer
  ip-progress (done) (total) = ip-status ("Loading weights: " & show done & " of " & show total)

  ip-sd-ready : List (List Text), ClipBpe, BrowserModel -> Integer
  ip-sd-ready (rows) (bpe) (m) =
    let handles = bl-list ("[" & state-get-text "bl-weights" & "]")
    in ip-ready rows (IpModel { im-family = "SD1.5", im-width = 512, im-height = 512, im-close = \z -> bl-free-weights handles 0, im-run = \p n seed steps cfg w h log made -> bl-run m bpe p n seed steps cfg log made })

  ip-xl-run : BrowserSdxlModel, ClipBpe, Text, Text, Text, Text, Text, Integer, Integer, (Text -> Integer), (Integer, Text -> Integer) -> Integer
  ip-xl-run (m) (bpe) (prompt) (negative) (seed) (steps) (cfg) (width) (height) (log) (made) =
    let start = clock-ms 0
    in let settings = BrowserSdxlSettings { bs-width = width, bs-height = height, bs-seed = bl-digits seed, bs-steps = bl-digits steps, bs-cfg = bl-real cfg }
    in browser-sdxl-euler-then m bpe prompt negative settings (\phase current total -> log (phase & ": " & show current & "/" & show total)) (\img -> made img ("total " & show (clock-ms 0 - start) & " ms")) (\why -> made (0 - 3) why)

  ip-xl-ready : List (List Text), ClipBpe, BrowserSdxlModel -> Integer
  ip-xl-ready (rows) (bpe) (m) =
    ip-ready rows (IpModel { im-family = "SDXL", im-width = 1024, im-height = 1024, im-close = \z -> if browser-sdxl-close m then 0 else 0 - 1, im-run = \p n seed steps cfg w h log made -> ip-xl-run m bpe p n seed steps cfg w h log made })

  ip-ready : List (List Text), IpModel -> Integer
  ip-ready (rows) (m) =
    let family = state-set-text "family" (m.im-family)
    in let steps = dom-set-value (dom-query "#steps") (if m.im-family == "SDXL" then "6" else "20")
    in let cfg = dom-set-value (dom-query "#cfg") (if m.im-family == "SDXL" then "2" else "7")
    in let settings = dom-set-text (dom-query "#settings") (show (m.im-width) & " x " & show (m.im-height) & ", Euler, " & (if m.im-family == "SDXL" then "Karras" else "Automatic (uniform)"))
    in let loaded = state-set "loaded" 1
    in let idle = state-set "busy" 0
    in let bind = ip-bind m rows
    in let log = ip-log ("checkpoint loaded: " & show (clock-ms 0 - state-get "load-t0") & " ms")
    in ip-status ("Ready: " & state-get-text "path" & " (" & m.im-family & ").")

  ip-digits : Text, Integer -> Boolean
  ip-digits (t) (i) = if i >= text-length t then True else let c = char-code-at t i in c >= char-code-at "0" 0 & c <= char-code-at "9" 0 & ip-digits t (i + 1)

  ip-integer : Text -> Boolean
  ip-integer (t) = let start = if text-starts-with t "-" then 1 else 0 in text-length t > start & ip-digits t start

  ip-decimal : Text -> Boolean
  ip-decimal (t) =
    let parts = text-split t "."
    in if text-length t == 0 | t == "." | list-length parts > 2 then False
    else ip-digits (list-at parts 0) 0 & (if list-length parts == 2 then ip-digits (list-at parts 1) 0 else True)

  ip-generate : IpModel -> Integer
  ip-generate (m) =
    if state-get "busy" /= 0 | m.im-family == "" then 0
    else let seed = dom-get-value (dom-query "#seed")
    in let steps = dom-get-value (dom-query "#steps")
    in let cfg = dom-get-value (dom-query "#cfg")
    in if ip-integer seed == False | ip-integer steps == False | ip-decimal cfg == False then ip-status "Enter an integer seed and step count, and a decimal CFG scale."
    else if bl-digits steps < 2 | bl-digits steps > 50 | bl-real cfg > 30.0 then ip-status "Steps must be 2-50 and CFG scale 0-30."
    else let busy = state-set "busy" 2
    in let disabled = dom-set-attr (dom-query "#go") "disabled" "disabled"
    in let s = ip-status "Generating..."
    in set-timeout (\z -> ip-run m seed steps cfg) 50

  ip-run : IpModel, Text, Text, Text -> Integer
  ip-run (m) (seed) (steps) (cfg) =
    let job = state-get "generated" + 1
    in let settings = show (m.im-width) & " x " & show (m.im-height) & ", Euler, " & (if m.im-family == "SDXL" then "Karras" else "Automatic (uniform)") & ", " & steps & " steps, CFG " & cfg & ", seed " & seed & ", " & state-get-text "path"
    in let log = ip-log ("job " & show job & ": start, " & settings)
    in m.im-run (dom-get-value (dom-query "#prompt")) (dom-get-value (dom-query "#negative")) seed steps cfg (m.im-width) (m.im-height) ip-log (\img summary -> ip-made m img job summary settings)

  ip-made : IpModel, Integer, Integer, Text, Text -> Integer
  ip-made (m) (img) (job) (summary) (settings) =
    if img <= 0 then (let idle = state-set "busy" 0 in let go = ip-go m in ip-status ("Generation failed: " & summary & " " & gpu-error 0))
    else gpu-buf-show-then img (m.im-width) (m.im-height) "#out" (\r -> ip-shown m img job summary settings r)

  ip-shown : IpModel, Integer, Integer, Text, Text, Text -> Integer
  ip-shown (m) (img) (job) (summary) (settings) (result) =
    let f = gpu-buf-free img
    in let idle = state-set "busy" 0
    in let go = ip-go m
    in if text-contains result "\"ok\":true" == False then ip-status ("The image could not be drawn: " & result)
    else let done = state-set "generated" job
    in let log = ip-log ("job " & show job & ": done, " & summary)
    in let stats = dom-set-text (dom-query "#stats") (summary & "\n" & settings & "\nGPU: " & bl-adapter)
    in let history = dom-append (dom-query "#history") (dom-set-text (dom-create "div") ("job " & show job & ": " & summary & "; " & settings))
    in ip-status "Done."

  opening : [Console] Integer
  opening =
    let root = dom-create "div"
    in let id = dom-set-attr root "id" "ip"
    in let width = dom-set-style root "max-width" "640px"
    in let body = dom-append (dom-query "body") root
    in let home = dom-set-attr (ip-el "a" "home" "Home") "href" "landing.html"
    in let title = ip-el "h1" "title" "Stable Diffusion in this tab"
    in let about = ip-el "p" "about" "Choose an SD1.5 or SDXL checkpoint from your models folder. Images are generated locally on your GPU."
    in let pick = ip-el "div" "pick-box" ""
    in let status = ip-el "p" "status" "No checkpoint loaded."
    in let models = ip-el "div" "models" ""
    in let prompt = ip-field "Prompt" "prompt" "a photo of a cat"
    in let negative = ip-field "Negative prompt" "negative" ""
    in let seed = ip-field "Seed" "seed" "0"
    in let steps = ip-field "Steps (2-50)" "steps" "20"
    in let cfg = ip-field "CFG scale (0-30)" "cfg" "7"
    in let settings = ip-el "p" "settings" ""
    in let go = ip-el "div" "go-box" ""
    in let unload = ip-el "div" "unload-box" ""
    in let canvas = dom-set-style (ip-el "canvas" "out" "") "max-width" "100%"
    in let stats = ip-el "pre" "stats" ""
    in let ch = ip-el "h3" "console-h" "Console"
    in let console = dom-set-style (dom-set-style (ip-el "div" "console" "") "font-family" "monospace") "font-size" "12px"
    in let hh = ip-el "h3" "history-h" "Finished jobs"
    in let history = ip-el "div" "history" ""
    in let bind = ip-bind ip-empty []
    in state-set "ready" 1
