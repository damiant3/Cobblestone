Chapter: StatusBar
  cites Spark chapter Project

 We say:

Section: Types

  StatusInfo = record {
    si-fps : Integer,
    si-vert-count : Integer,
    si-face-count : Integer,
    si-object-count : Integer,
    si-mode : Text,
    si-tool : Text,
    si-dirty : Boolean
  }

Section: Construction

  status-from-project : SparkProject, Integer -> StatusInfo
  status-from-project (proj) (fps) =
    let vc = status-total-verts proj 0 0
    in let fc = status-total-faces proj 0 0
    in StatusInfo {
      si-fps = fps,
      si-vert-count = vc,
      si-face-count = fc,
      si-object-count = proj.sp-object-count,
      si-mode = project-mode-name (proj.sp-mode),
      si-tool = "Select",
      si-dirty = proj.sp-dirty
    }

Section: Counting

  status-total-verts : SparkProject, Integer, Integer -> Integer
  status-total-verts (proj) (i) (acc) =
    if i >= proj.sp-object-count then acc
    else let obj = project-get-object proj i
    in status-total-verts proj (i + 1) (acc + obj.so-mesh.tm-vert-count)

  status-total-faces : SparkProject, Integer, Integer -> Integer
  status-total-faces (proj) (i) (acc) =
    if i >= proj.sp-object-count then acc
    else let obj = project-get-object proj i
    in status-total-faces proj (i + 1) (acc + obj.so-mesh.tm-face-count)

Section: Formatting

  status-format : StatusInfo -> Text
  status-format (info) =
    let dirty-mark = if info.si-dirty then "*" else ""
    in dirty-mark & info.si-mode & " | " & info.si-tool & " | " & show (info.si-fps) & " FPS | " & show (info.si-vert-count) & " verts | " & show (info.si-face-count) & " faces | " & show (info.si-object-count) & " objects"

