Chapter: Clipboard
  cites Math chapter Quaternion
  cites Game chapter Rasterizer
  cites Spark chapter Mesh

 We say:

Section: Types

  ClipKind =
    | ClipEmpty
    | ClipMesh (TriMesh)
    | ClipPixels (Framebuf)
    | ClipAudio (List Integer) (Integer)
    | ClipText (Text)
    | ClipTransform (Vec3) (Vec3)

  ClipboardState = record {
    clip-content : ClipKind,
    clip-source : Text,
    clip-count : Integer
  }

Section: Construction

  clipboard-new : ClipboardState
  clipboard-new = ClipboardState {
    clip-content = ClipEmpty,
    clip-source = "",
    clip-count = 0
  }

Section: Copy

  clip-copy-mesh : ClipboardState, TriMesh, Text -> ClipboardState
  clip-copy-mesh (clip) (mesh) (source) = ClipboardState {
    clip-content = ClipMesh mesh,
    clip-source = source,
    clip-count = clip.clip-count + 1
  }

  clip-copy-pixels : ClipboardState, Framebuf, Text -> ClipboardState
  clip-copy-pixels (clip) (fb) (source) = ClipboardState {
    clip-content = ClipPixels fb,
    clip-source = source,
    clip-count = clip.clip-count + 1
  }

  clip-copy-audio : ClipboardState, List Integer, Integer, Text -> ClipboardState
  clip-copy-audio (clip) (samples) (count) (source) = ClipboardState {
    clip-content = ClipAudio samples count,
    clip-source = source,
    clip-count = clip.clip-count + 1
  }

  clip-copy-text : ClipboardState, Text -> ClipboardState
  clip-copy-text (clip) (text) = ClipboardState {
    clip-content = ClipText text,
    clip-source = "text",
    clip-count = clip.clip-count + 1
  }

  clip-copy-transform : ClipboardState, Vec3, Vec3 -> ClipboardState
  clip-copy-transform (clip) (pos) (scale) = ClipboardState {
    clip-content = ClipTransform pos scale,
    clip-source = "transform",
    clip-count = clip.clip-count + 1
  }

Section: Paste Query

  clip-has-mesh : ClipboardState -> Boolean
  clip-has-mesh (clip) =
    when clip.clip-content
      is ClipMesh (m) -> True
      is otherwise -> False

  clip-has-pixels : ClipboardState -> Boolean
  clip-has-pixels (clip) =
    when clip.clip-content
      is ClipPixels (fb) -> True
      is otherwise -> False

  clip-has-audio : ClipboardState -> Boolean
  clip-has-audio (clip) =
    when clip.clip-content
      is ClipAudio (s) (c) -> True
      is otherwise -> False

  clip-is-empty : ClipboardState -> Boolean
  clip-is-empty (clip) =
    when clip.clip-content
      is ClipEmpty -> True
      is otherwise -> False

Section: Clear

  clip-clear : ClipboardState -> ClipboardState
  clip-clear (clip) = ClipboardState {
    clip-content = ClipEmpty,
    clip-source = "",
    clip-count = clip.clip-count
  }

Section: Info

  clipboard-info : ClipboardState -> Text
  clipboard-info (clip) =
    let kind = when clip.clip-content
      is ClipEmpty -> "empty"
      is ClipMesh (m) -> "mesh (" & show (m.tm-face-count) & "f)"
      is ClipPixels (fb) -> "pixels " & show (fb.fb-width) & "x" & show (fb.fb-height)
      is ClipAudio (s) (c) -> "audio " & show c & " samples"
      is ClipText (t) -> "text (" & show (text-length t) & " chars)"
      is ClipTransform (p) (s) -> "transform"
    in kind & " from " & clip.clip-source

