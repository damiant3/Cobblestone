Chapter: SparkHtmlGen
  cites Spark chapter SparkCss
  cites Spark chapter SparkBridge

Section: Page Structure

  html-doctype : Text = "<!DOCTYPE html>\n<html lang=\"en\">\n"

  html-head : Text =
    "<head>\n" &
    "<meta charset=\"utf-8\">\n" &
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" &
    "<title>Codex Spark Studio</title>\n" &
    "<style>\n" & spark-stylesheet & "\n</style>\n" &
    "</head>\n"

  html-app-header : Text =
    "  <div class=\"header\">\n" &
    "    <span class=\"logo clickable\" data-action=\"show-about\" title=\"About Codex Spark\">CODEX SPARK</span>\n" &
    "    <div class=\"hdr-sep\"></div>\n" &
    "    <div class=\"mode-tabs\" id=\"mode-tabs\"></div>\n" &
    "    <div class=\"hdr-right\">\n" &
    "      <span id=\"project-name\" class=\"clickable\" style=\"opacity:0.6\" data-action=\"prompt-project-name\" title=\"Click to rename project\">Untitled</span>\n" &
    "      <span class=\"hdr-sep\" style=\"margin:0 6px\"></span>\n" &
    "      <span id=\"stats\">--</span>\n" &
    "    </div>\n" &
    "  </div>\n"

  html-app-body : Text =
    "  <div class=\"panels\" id=\"panels\"></div>\n"

  html-status-bar : Text =
    "  <div class=\"status\">\n" &
    "    <div style=\"display:flex;gap:14px\">\n" &
    "      <span class=\"mode\" id=\"st-mode\">MODEL</span>\n" &
    "      <span id=\"st-tool\">Select</span>\n" &
    "      <span id=\"st-objects\">0 objects</span>\n" &
    "      <span id=\"st-verts\">0 verts</span>\n" &
    "    </div>\n" &
    "    <span id=\"st-msg\">Ready</span>\n" &
    "  </div>\n"

  html-body : Text =
    "<body>\n" &
    "<div class=\"app\">\n" &
    html-app-header &
    html-app-body &
    html-status-bar &
    "</div>\n" &
    "<script>\n" &
    spark-bridge-js &
    "</script>\n" &
    "</body>\n"

Section: Full Page

  spark-html-page : Text
  spark-html-page =
    html-doctype & html-head & html-body & "</html>\n"

Section: Emit to Buffer

  emit-spark-html : Integer
  emit-spark-html =
    let page = spark-html-page
    in let len = text-length page
    in let pos = write-spark-html-bytes page 0 len
    in w32 project-buf-addr pos

  write-spark-html-bytes : Text, Integer, Integer -> Integer
  write-spark-html-bytes (txt) (i) (len) =
    if i >= len then i
    else let ch = char-code (char-at txt i)
    in let a = w32 (project-buf-addr + 4 + i) ch
    in write-spark-html-bytes txt (i + 1) len

  project-buf-addr : Integer = 7340032

  w32 : Integer, Integer -> Integer
  w32 (addr) (val) = poke-32 0 addr val

Section: Entry

  opening : [Console] Nothing = act
    let a = emit-spark-html
    in print-line-uni ("spark-html: " & show a & " bytes")
  end

