Chapter: SparkCatalogue

 The models and LoRAs the page points a newcomer at: links to each file's
 page on Hugging Face, never a copy. The family is the one the file's header
 reads as (SparkModelFile.codex); the size is the file's own in MB and the
 licence is the one its page declares, as Hugging Face's API reported both on
 2026-09-30. apps/spark/catalogue-check.mjs grades every entry.

Section: Entries

  CatalogueEntry = record {
    ce-name : Text,
    ce-family : Text,
    ce-page : Text,
    ce-file-url : Text,
    ce-file : Text,
    ce-mb : Integer,
    ce-licence : Text
  }

  ce-hf : Text, Text, Text, Text, Integer, Text -> CatalogueEntry
  ce-hf (name) (family) (repo) (file) (mb) (licence) = CatalogueEntry { ce-name = name, ce-family = family, ce-page = "https://huggingface.co/" & repo, ce-file-url = "https://huggingface.co/" & repo & "/resolve/main/" & file, ce-file = file, ce-mb = mb, ce-licence = licence }

  spark-catalogue : List CatalogueEntry
  spark-catalogue = [
    ce-hf "Stable Diffusion 1.5" "sd15 checkpoint" "stable-diffusion-v1-5/stable-diffusion-v1-5" "v1-5-pruned-emaonly.safetensors" 4068 "creativeml-openrail-m",
    ce-hf "DreamShaper 8" "sd15 checkpoint" "Lykon/DreamShaper" "DreamShaper_8_pruned.safetensors" 2034 "other (see the page)",
    ce-hf "Stable Diffusion XL base 1.0" "sdxl checkpoint" "stabilityai/stable-diffusion-xl-base-1.0" "sd_xl_base_1.0.safetensors" 6617 "openrail++",
    ce-hf "DreamShaper XL Lightning" "sdxl checkpoint" "Lykon/dreamshaper-xl-lightning" "DreamShaperXL_Lightning.safetensors" 6618 "openrail++",
    ce-hf "FLUX.1 schnell (fp8)" "flux checkpoint" "Kijai/flux-fp8" "flux1-schnell-fp8-e4m3fn.safetensors" 11340 "other (FLUX.1 schnell is apache-2.0)",
    ce-hf "LCM LoRA for SD 1.5" "sd15 LoRA" "latent-consistency/lcm-lora-sdv1-5" "pytorch_lora_weights.safetensors" 128 "openrail++",
    ce-hf "Papercut" "sdxl LoRA" "TheLastBen/Papercut_SDXL" "papercut.safetensors" 325 "creativeml-openrail-m",
    ce-hf "Pixel Art XL" "sdxl LoRA" "nerijs/pixel-art-xl" "pixel-art-xl.safetensors" 163 "creativeml-openrail-m",
    ce-hf "LCM LoRA for SDXL" "sdxl LoRA" "latent-consistency/lcm-lora-sdxl" "pytorch_lora_weights.safetensors" 376 "openrail++",
    ce-hf "SDXL offset noise" "sdxl LoRA" "stabilityai/stable-diffusion-xl-base-1.0" "sd_xl_offset_example-lora_1.0.safetensors" 47 "openrail++",
    ce-hf "Dark Fantasy" "flux LoRA" "Shakker-Labs/FLUX.1-dev-LoRA-Dark-Fantasy" "FLUX.1-dev-lora-Dark-Fantasy.safetensors" 38 "flux-1-dev-non-commercial-license"
  ]
