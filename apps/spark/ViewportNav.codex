Chapter: ViewportNav
  cites Math chapter Quaternion
  cites Math chapter Matrix4

 Viewport navigation: orbit, pan, zoom, and focus. Translates
 mouse input into camera transforms. Orbit rotates around a
 pivot point, pan slides the camera laterally, zoom moves
 along the view axis.

 We say:

Section: Types

  NavMode =
    | NavOrbit
    | NavPan
    | NavZoom
    | NavFly

  NavState = record {
    ns-mode : NavMode,
    ns-pivot : Vec3,
    ns-yaw : Real,
    ns-pitch : Real,
    ns-distance : Real,
    ns-pan-x : Real,
    ns-pan-y : Real,
    ns-dragging : Boolean,
    ns-last-mx : Integer,
    ns-last-my : Integer,
    ns-orbit-speed : Real,
    ns-pan-speed : Real,
    ns-zoom-speed : Real
  }

Section: Construction

  nav-new : Vec3, Real -> NavState
  nav-new (pivot) (distance) = NavState {
    ns-mode = NavOrbit,
    ns-pivot = pivot,
    ns-yaw = 0.0,
    ns-pitch = 0.3,
    ns-distance = distance,
    ns-pan-x = 0.0,
    ns-pan-y = 0.0,
    ns-dragging = False,
    ns-last-mx = 0,
    ns-last-my = 0,
    ns-orbit-speed = 0.003,
    ns-pan-speed = 0.005,
    ns-zoom-speed = 0.1
  }

  nav-default : NavState
  nav-default = nav-new vec3-zero 5.0

Section: Input

  nav-begin-drag : NavState, NavMode, Integer, Integer -> NavState
  nav-begin-drag (ns) (mode) (mx) (my) = NavState {
    ns-mode = mode,
    ns-pivot = ns.ns-pivot,
    ns-yaw = ns.ns-yaw,
    ns-pitch = ns.ns-pitch,
    ns-distance = ns.ns-distance,
    ns-pan-x = ns.ns-pan-x,
    ns-pan-y = ns.ns-pan-y,
    ns-dragging = True,
    ns-last-mx = mx,
    ns-last-my = my,
    ns-orbit-speed = ns.ns-orbit-speed,
    ns-pan-speed = ns.ns-pan-speed,
    ns-zoom-speed = ns.ns-zoom-speed
  }

  nav-drag : NavState, Integer, Integer -> NavState
  nav-drag (ns) (mx) (my) =
    if ns.ns-dragging then
      let dx = mx - ns.ns-last-mx
      in let dy = my - ns.ns-last-my
      in let updated = when ns.ns-mode
        is NavOrbit -> nav-apply-orbit ns dx dy
        is NavPan -> nav-apply-pan ns dx dy
        is NavZoom -> nav-apply-zoom ns dy
        is NavFly -> nav-apply-orbit ns dx dy
      in NavState {
        ns-mode = updated.ns-mode,
        ns-pivot = updated.ns-pivot,
        ns-yaw = updated.ns-yaw,
        ns-pitch = updated.ns-pitch,
        ns-distance = updated.ns-distance,
        ns-pan-x = updated.ns-pan-x,
        ns-pan-y = updated.ns-pan-y,
        ns-dragging = True,
        ns-last-mx = mx,
        ns-last-my = my,
        ns-orbit-speed = ns.ns-orbit-speed,
        ns-pan-speed = ns.ns-pan-speed,
        ns-zoom-speed = ns.ns-zoom-speed
      }
    else ns

  nav-end-drag : NavState -> NavState
  nav-end-drag (ns) = __record-set ns "ns-dragging" False

  nav-scroll-zoom : NavState, Integer -> NavState
  nav-scroll-zoom (ns) (delta) =
    let new-dist = ns.ns-distance - real-from-int delta * ns.ns-zoom-speed
    in __record-set ns "ns-distance" (if new-dist < 0.1 then 0.1 else if new-dist > 100.0 then 100.0 else new-dist)

Section: Orbit

  nav-apply-orbit : NavState, Integer, Integer -> NavState
  nav-apply-orbit (ns) (dx) (dy) =
    let new-yaw = ns.ns-yaw + real-from-int dx * ns.ns-orbit-speed
    in let new-pitch = ns.ns-pitch - real-from-int dy * ns.ns-orbit-speed
    in let clamped-pitch = if new-pitch < (-1.5) then (-1.5) else if new-pitch > 1.5 then 1.5 else new-pitch
    in __record-set (__record-set ns "ns-yaw" new-yaw) "ns-pitch" clamped-pitch

Section: Pan

  nav-apply-pan : NavState, Integer, Integer -> NavState
  nav-apply-pan (ns) (dx) (dy) =
    let scale = ns.ns-distance * ns.ns-pan-speed
    in let new-px = ns.ns-pan-x - real-from-int dx * scale
    in let new-py = ns.ns-pan-y + real-from-int dy * scale
    in __record-set (__record-set ns "ns-pan-x" new-px) "ns-pan-y" new-py

Section: Zoom

  nav-apply-zoom : NavState, Integer -> NavState
  nav-apply-zoom (ns) (dy) =
    let new-dist = ns.ns-distance + real-from-int dy * ns.ns-zoom-speed
    in __record-set ns "ns-distance" (if new-dist < 0.1 then 0.1 else if new-dist > 100.0 then 100.0 else new-dist)

Section: Camera Matrix

  nav-camera-position : NavState -> Vec3
  nav-camera-position (ns) =
    let cos-p = real-cos (ns.ns-pitch)
    in let sin-p = real-sin (ns.ns-pitch)
    in let cos-y = real-cos (ns.ns-yaw)
    in let sin-y = real-sin (ns.ns-yaw)
    in let x = ns.ns-pivot.vx + ns.ns-distance * cos-p * sin-y + ns.ns-pan-x
    in let y = ns.ns-pivot.vy + ns.ns-distance * sin-p + ns.ns-pan-y
    in let z = ns.ns-pivot.vz + ns.ns-distance * cos-p * cos-y
    in vec3-new x y z

  nav-view-matrix : NavState -> Mat4
  nav-view-matrix (ns) =
    let eye = nav-camera-position ns
    in let target = vec3-new (ns.ns-pivot.vx + ns.ns-pan-x) (ns.ns-pivot.vy + ns.ns-pan-y) (ns.ns-pivot.vz)
    in mat4-look-at eye target (vec3-new 0.0 1.0 0.0)

Section: Focus

  nav-focus-on : NavState, Vec3, Real -> NavState
  nav-focus-on (ns) (target) (dist) =
    __record-set (__record-set (__record-set ns "ns-pivot" target) "ns-distance" dist) "ns-pan-x" 0.0

Section: Presets

  nav-front : NavState -> NavState
  nav-front (ns) = __record-set (__record-set ns "ns-yaw" 0.0) "ns-pitch" 0.0

  nav-top : NavState -> NavState
  nav-top (ns) = __record-set (__record-set ns "ns-yaw" 0.0) "ns-pitch" 1.570

  nav-right : NavState -> NavState
  nav-right (ns) = __record-set (__record-set ns "ns-yaw" 1.570) "ns-pitch" 0.0

Section: Info

  nav-info : NavState -> Text
  nav-info (ns) =
    let mode = when ns.ns-mode is NavOrbit -> "orbit" is NavPan -> "pan" is NavZoom -> "zoom" is NavFly -> "fly"
    in mode & " yaw=" & show (ns.ns-yaw) & " pitch=" & show (ns.ns-pitch) & " dist=" & show (ns.ns-distance)

