 Spark project state. Holds the scene, camera, selection, undo
 history, and editor mode. All editors operate on this shared state.

 We say:

Section: Types

  EditorMode =
    | ModeModel
    | ModeAnimate
    | ModeRender
    | ModeImage
    | ModeAudio
    | ModeStage

  SceneObject = record {
    so-name : Text,
    so-mesh : TriMesh,
    so-position : Vec3,
    so-rotation : Quat,
    so-scale : Vec3,
    so-color : Integer,
    so-visible : Boolean
  }

  SparkProject = record {
    sp-objects : List SceneObject,
    sp-object-count : Integer,
    sp-camera : SparkCamera,
    sp-lights : List SparkLight,
    sp-selection : SelectionState,
    sp-history : UndoStack,
    sp-mode : EditorMode,
    sp-dirty : Boolean,
    sp-name : Text
  }

Section: Construction

  project-new : Integer, Integer -> SparkProject
  project-new (vp-w) (vp-h) = SparkProject {
    sp-objects = [],
    sp-object-count = 0,
    sp-camera = spark-camera-new vp-w vp-h,
    sp-lights = [light-directional (vec3-new 577 577 577) 16777215 800, light-ambient 16777215 200],
    sp-selection = selection-empty,
    sp-history = undo-stack-new 256,
    sp-mode = ModeModel,
    sp-dirty = False,
    sp-name = "Untitled"
  }

Section: Object Management

  project-add-object : SparkProject, Text, TriMesh, Integer -> SparkProject
  project-add-object (proj) (name) (mesh) (color) =
    let obj = SceneObject {
      so-name = name,
      so-mesh = mesh,
      so-position = vec3-zero,
      so-rotation = quat-identity,
      so-scale = vec3-new 1000 1000 1000,
      so-color = color,
      so-visible = True
    }
    in SparkProject {
      sp-objects = list-push (proj.sp-objects) obj,
      sp-object-count = proj.sp-object-count + 1,
      sp-camera = proj.sp-camera,
      sp-lights = proj.sp-lights,
      sp-selection = proj.sp-selection,
      sp-history = proj.sp-history,
      sp-mode = proj.sp-mode,
      sp-dirty = True,
      sp-name = proj.sp-name
    }

  project-get-object : SparkProject, Integer -> SceneObject
  project-get-object (proj) (i) = list-at (proj.sp-objects) i

Section: Mode

  project-set-mode : SparkProject, EditorMode -> SparkProject
  project-set-mode (proj) (mode) = __record-set proj "sp-mode" mode

  project-mode-name : EditorMode -> Text
  project-mode-name (mode) =
    when mode
      is ModeModel -> "Model"
      is ModeAnimate -> "Animate"
      is ModeRender -> "Render"
      is ModeImage -> "Image"
      is ModeAudio -> "Audio"
      is ModeStage -> "Stage"

