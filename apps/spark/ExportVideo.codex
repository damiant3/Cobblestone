Chapter: ExportVideo
  cites Spark chapter ExportImage
  cites Spark chapter RenderQueue

 We say:

Section: Types

  VideoExport = record {
    ve-frames : List ImageExport,
    ve-frame-count : Integer,
    ve-width : Integer,
    ve-height : Integer,
    ve-fps : Integer,
    ve-duration-ms : Integer
  }

Section: Construction

  video-from-render : RenderResult -> VideoExport
  video-from-render (rr) =
    let dur = if rr.rr-fps == 0 then 0 else rr.rr-frame-count * 1000 / rr.rr-fps
    in VideoExport {
      ve-frames = rr.rr-frames,
      ve-frame-count = rr.rr-frame-count,
      ve-width = rr.rr-width,
      ve-height = rr.rr-height,
      ve-fps = rr.rr-fps,
      ve-duration-ms = dur
    }

Section: Statistics

  video-total-bytes : VideoExport -> Integer
  video-total-bytes (ve) = ve.ve-frame-count * ve.ve-width * ve.ve-height * 3

  video-info : VideoExport -> Text
  video-info (ve) =
    show (ve.ve-width) & "x" & show (ve.ve-height) & " " & show (ve.ve-fps) & "fps, " & show (ve.ve-frame-count) & " frames (" & show (ve.ve-duration-ms) & "ms)"

