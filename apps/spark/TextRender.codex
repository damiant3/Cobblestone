    else if code == 106 then GlyphData { gd-rows = [2, 0, 6, 2, 2, 18, 12], gd-width = 5, gd-height = 7 }
    else if code == 107 then GlyphData { gd-rows = [16, 16, 18, 20, 24, 20, 18], gd-width = 5, gd-height = 7 }
