    else if code == 73 then GlyphData { gd-rows = [14, 4, 4, 4, 4, 4, 14], gd-width = 5, gd-height = 7 }
    else if code == 74 then GlyphData { gd-rows = [7, 2, 2, 2, 2, 18, 12], gd-width = 5, gd-height = 7 }
    else if code == 75 then GlyphData { gd-rows = [17, 18, 20, 24, 20, 18, 17], gd-width = 5, gd-height = 7 }
    else if code == 76 then GlyphData { gd-rows = [16, 16, 16, 16, 16, 16, 31], gd-width = 5, gd-height = 7 }
    else if code == 77 then GlyphData { gd-rows = [17, 27, 21, 17, 17, 17, 17], gd-width = 5, gd-height = 7 }
