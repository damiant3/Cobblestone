Section: Measurement

  text-measure-width : Text, TextStyle -> Integer
  text-measure-width (txt) (style) =
    text-length txt * (5 + style.ts-spacing) * style.ts-scale

  text-measure-height : TextStyle -> Integer
  text-measure-height (style) = style.ts-line-height

Section: Info

  text-render-info : TextStyle -> Text
  text-render-info (style) =
    "scale=" & show (style.ts-scale) & " color=" & show (style.ts-color)

