Chapter: Workspace
  cites Spark chapter Project
  cites Spark chapter Viewport
  cites Spark chapter Toolbar
  cites Spark chapter StatusBar

 Panel layout and workspace management. Manages the arrangement
 of viewport, toolbar, and status bar panels.

 We say:

Section: Types

  WorkspaceLayout = record {
    wl-viewport : ViewportState,
    wl-toolbar : ToolbarState,
    wl-status : StatusInfo,
    wl-panel-width : Integer,
    wl-panel-height : Integer
  }

Section: Construction

  workspace-new : Integer, Integer -> WorkspaceLayout
  workspace-new (w) (h) =
    let vp-w = w
    in let vp-h = h - 40
    in WorkspaceLayout {
      wl-viewport = viewport-new vp-w vp-h,
      wl-toolbar = toolbar-new ModeModel,
      wl-status = StatusInfo { si-fps = 0, si-vert-count = 0, si-face-count = 0, si-object-count = 0, si-mode = "Model", si-tool = "Select", si-dirty = False },
      wl-panel-width = w,
      wl-panel-height = h
    }

Section: Update

  workspace-update-status : WorkspaceLayout, SparkProject, Integer -> WorkspaceLayout
  workspace-update-status (ws) (proj) (fps) =
    __record-set ws "wl-status" (status-from-project proj fps)

  workspace-set-mode : WorkspaceLayout, EditorMode -> WorkspaceLayout
  workspace-set-mode (ws) (mode) =
    __record-set ws "wl-toolbar" (toolbar-set-mode (ws.wl-toolbar) mode)

