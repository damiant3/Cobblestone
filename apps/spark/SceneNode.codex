 We say:

Section: Mesh Nodes

  sg-add-mesh : SceneGraph3D, Text, Integer, Integer -> SceneGraph3D
  sg-add-mesh (sg) (name) (mesh-idx) (parent-id) =
    sg-add-node sg name (SnkMesh mesh-idx) parent-id

  sg-add-mesh-at : SceneGraph3D, Text, Integer, Vec3, Integer -> SceneGraph3D
  sg-add-mesh-at (sg) (name) (mesh-idx) (pos) (parent-id) =
    let sg2 = sg-add-mesh sg name mesh-idx parent-id
    in sg-set-position sg2 (sg2.sg-count - 1) pos

Section: Camera Nodes

  sg-add-camera : SceneGraph3D, Text, Integer -> SceneGraph3D
  sg-add-camera (sg) (name) (parent-id) =
    sg-add-node sg name SnkCamera parent-id

  sg-add-camera-at : SceneGraph3D, Text, Vec3, Vec3, Integer -> SceneGraph3D
  sg-add-camera-at (sg) (name) (pos) (target) (parent-id) =
    let sg2 = sg-add-camera sg name parent-id
    in sg-set-position sg2 (sg2.sg-count - 1) pos

Section: Light Nodes

  sg-add-light : SceneGraph3D, Text, Integer, Integer -> SceneGraph3D
  sg-add-light (sg) (name) (light-idx) (parent-id) =
    sg-add-node sg name (SnkLight light-idx) parent-id

  sg-add-light-at : SceneGraph3D, Text, Integer, Vec3, Integer -> SceneGraph3D
  sg-add-light-at (sg) (name) (light-idx) (pos) (parent-id) =
    let sg2 = sg-add-light sg name light-idx parent-id
    in sg-set-position sg2 (sg2.sg-count - 1) pos

Section: Group and Empty

  sg-add-group : SceneGraph3D, Text, Integer -> SceneGraph3D
  sg-add-group (sg) (name) (parent-id) =
    sg-add-node sg name SnkGroup parent-id

  sg-add-empty : SceneGraph3D, Text, Integer -> SceneGraph3D
  sg-add-empty (sg) (name) (parent-id) =
    sg-add-node sg name SnkEmpty parent-id

Section: Node Info

  sgn-is-mesh : SceneGraphNode -> Boolean
  sgn-is-mesh (node) =
    when node.sgn-kind
      is SnkMesh (mid) -> True
      is otherwise -> False

  sgn-mesh-index : SceneGraphNode -> Integer
  sgn-mesh-index (node) =
    when node.sgn-kind
      is SnkMesh (mid) -> mid
      is otherwise -> -1

  sgn-is-light : SceneGraphNode -> Boolean
  sgn-is-light (node) =
    when node.sgn-kind
      is SnkLight (lid) -> True
      is otherwise -> False

  sgn-light-index : SceneGraphNode -> Integer
  sgn-light-index (node) =
    when node.sgn-kind
      is SnkLight (lid) -> lid
      is otherwise -> -1

