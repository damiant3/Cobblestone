Chapter: Toolbar
  cites Spark chapter Project

 Mode-specific tool palettes for the Spark editor. Each editor mode
 has a distinct set of tools. The toolbar tracks the active tool.

 We say:

Section: Types

  ToolKind =
    | ToolSelect
    | ToolMove
    | ToolRotate
    | ToolScale
    | ToolExtrude
    | ToolBrush
    | ToolEraser
    | ToolFill
    | ToolEyedropper

  ToolbarState = record {
    tb-active : ToolKind,
    tb-mode : EditorMode
  }

Section: Construction

  toolbar-new : EditorMode -> ToolbarState
  toolbar-new (mode) = ToolbarState {
    tb-active = ToolSelect,
    tb-mode = mode
  }

Section: Operations

  toolbar-set-tool : ToolbarState, ToolKind -> ToolbarState
  toolbar-set-tool (tb) (tool) = __record-set tb "tb-active" tool

  toolbar-set-mode : ToolbarState, EditorMode -> ToolbarState
  toolbar-set-mode (tb) (mode) = ToolbarState {
    tb-active = ToolSelect,
    tb-mode = mode
  }

Section: Display

  tool-name : ToolKind -> Text
  tool-name (t) =
    when t
      is ToolSelect -> "Select"
      is ToolMove -> "Move"
      is ToolRotate -> "Rotate"
      is ToolScale -> "Scale"
      is ToolExtrude -> "Extrude"
      is ToolBrush -> "Brush"
      is ToolEraser -> "Eraser"
      is ToolFill -> "Fill"
      is ToolEyedropper -> "Eyedropper"

