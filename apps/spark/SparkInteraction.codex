Chapter: SparkInteraction

 Event delegation for Spark Studio UI. Replaces inline onclick
 handlers with data-action attributes dispatched from a single
 document-level click listener.

Section: Action Dispatch

  dispatch-action : Text -> Integer
  dispatch-action (action) =
    if text-eq action "show-about" then dispatch-show-about 0
    else if text-eq action "prompt-project-name" then dispatch-prompt-project-name 0
    else 0

  dispatch-show-about : Integer -> Integer
  dispatch-show-about (unused) =
    let el = dom-get-by-id "about-dialog"
    in dom-not-null el

  dispatch-prompt-project-name : Integer -> Integer
  dispatch-prompt-project-name (unused) =
    let el = dom-get-by-id "project-name"
    in dom-not-null el

Section: Click Handler

  on-click-handler : Integer -> Integer
  on-click-handler (event) =
    let target = dom-event-target event
    in let el = dom-closest target "[data-action]"
    in if dom-not-null el == 0 then 0
    else let action = dom-dataset-get el "action"
    in dispatch-action action

Section: Setup

  setup-spark-events : Integer -> Integer
  setup-spark-events (doc) =
    dom-on-click doc on-click-handler

