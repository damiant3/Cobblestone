Chapter: MaterialEditor

 We say:

Section: Types

  PbrMaterial = record {
    pbr-name : Text,
    pbr-albedo : Integer,
    pbr-metallic : Real,
    pbr-roughness : Real,
    pbr-emission : Integer,
    pbr-emission-strength : Real,
    pbr-opacity : Real,
    pbr-albedo-tex : Integer,
    pbr-normal-tex : Integer
  }

  MaterialSlot =
    | SlotAlbedo
    | SlotMetallic
    | SlotRoughness
    | SlotEmission

  MaterialLibState = record {
    mls-materials : List PbrMaterial,
    mls-count : Integer,
    mls-selected : Integer
  }

