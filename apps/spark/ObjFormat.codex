Chapter: ObjFormat
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Spark chapter Mesh

 Wavefront OBJ format export. Writes vertex positions, texture
 coordinates, normals, and face indices as text. Fixed-point
 values are converted to decimal strings with 3 decimal places.

 We say:

Section: Export

  obj-export : TriMesh, Text -> Text
  obj-export (mesh) (name) =
    let header = "# Codex.Spark OBJ export\no " & name & "\n"
    in let verts = obj-export-verts mesh 0 ""
    in let uvs = obj-export-uvs mesh 0 ""
    in let normals = obj-export-normals mesh 0 ""
    in let faces = obj-export-faces mesh 0 ""
    in header & verts & uvs & normals & faces

Section: Vertices

  obj-export-verts : TriMesh, Integer, Text -> Text
  obj-export-verts (m) (i) (acc) =
    if i >= m.tm-vert-count then acc
    else let v = tri-mesh-vert m i
    in let line = "v " & obj-fixed-to-dec (v.vx) & " " & obj-fixed-to-dec (v.vy) & " " & obj-fixed-to-dec (v.vz) & "\n"
    in obj-export-verts m (i + 1) (acc & line)

Section: UVs

  obj-export-uvs : TriMesh, Integer, Text -> Text
  obj-export-uvs (m) (i) (acc) =
    if i >= m.tm-vert-count then acc
    else let uv = tri-mesh-uv m i
    in let line = "vt " & obj-fixed-to-dec (uv.v2x) & " " & obj-fixed-to-dec (uv.v2y) & "\n"
    in obj-export-uvs m (i + 1) (acc & line)

Section: Normals

  obj-export-normals : TriMesh, Integer, Text -> Text
  obj-export-normals (m) (i) (acc) =
    if i >= m.tm-vert-count then acc
    else let n = tri-mesh-normal m i
    in let line = "vn " & obj-fixed-to-dec (n.vx) & " " & obj-fixed-to-dec (n.vy) & " " & obj-fixed-to-dec (n.vz) & "\n"
    in obj-export-normals m (i + 1) (acc & line)

Section: Faces

  obj-export-faces : TriMesh, Integer, Text -> Text
  obj-export-faces (m) (i) (acc) =
    if i >= m.tm-face-count then acc
    else let f = tri-mesh-face m i
    in let i0 = f.tf-v0 + 1
    in let i1 = f.tf-v1 + 1
    in let i2 = f.tf-v2 + 1
    in let line = "f " & show i0 & "/" & show i0 & "/" & show i0 & " " & show i1 & "/" & show i1 & "/" & show i1 & " " & show i2 & "/" & show i2 & "/" & show i2 & "\n"
    in obj-export-faces m (i + 1) (acc & line)

Section: Number Formatting

  obj-fixed-to-dec : Integer -> Text
  obj-fixed-to-dec (val) =
    let sign = if val < 0 then "-" else ""
    in let abs-val = if val < 0 then -val else val
    in let whole = abs-val / 1000
    in let frac = abs-val - whole * 1000
    in let f-str = if frac < 10 then "00" & show frac
      else if frac < 100 then "0" & show frac
      else show frac
    in sign & show whole & "." & f-str

