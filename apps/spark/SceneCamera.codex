Chapter: SceneCamera
  cites Math chapter Quaternion
  cites Math chapter Matrix4

 3D camera with perspective and orthographic projection, orbit
 controls, and frustum queries. All values fixed-point scale 1000.

 We say:

Section: Types

  CamProjection =
    | CamPersp (Integer)
    | CamOrthoProj (Integer)

  SparkCamera = record {
    sc-eye : Vec3,
    sc-target : Vec3,
    sc-up : Vec3,
    sc-projection : CamProjection,
    sc-near : Integer,
    sc-far : Integer,
    sc-vp-width : Integer,
    sc-vp-height : Integer
  }

Section: Construction

  spark-camera-new : Integer, Integer -> SparkCamera
  spark-camera-new (vp-w) (vp-h) = SparkCamera {
    sc-eye = vec3-new 0 2000 5000,
    sc-target = vec3-zero,
    sc-up = vec3-new 0 1000 0,
    sc-projection = CamPersp 1047,
    sc-near = 100,
    sc-far = 100000,
    sc-vp-width = vp-w,
    sc-vp-height = vp-h
  }

  spark-camera-ortho : Integer, Integer, Integer -> SparkCamera
  spark-camera-ortho (vp-w) (vp-h) (extent) = SparkCamera {
    sc-eye = vec3-new 0 5000 5000,
    sc-target = vec3-zero,
    sc-up = vec3-new 0 1000 0,
    sc-projection = CamOrthoProj extent,
    sc-near = 100,
    sc-far = 100000,
    sc-vp-width = vp-w,
    sc-vp-height = vp-h
  }

Section: Matrices

  spark-camera-view : SparkCamera -> Mat4
  spark-camera-view (c) = mat4-look-at (c.sc-eye) (c.sc-target) (c.sc-up)

  spark-camera-proj : SparkCamera -> Mat4
  spark-camera-proj (c) =
    let aspect = c.sc-vp-width * 1000 / c.sc-vp-height
    in when c.sc-projection
      is CamPersp (fov) -> mat4-perspective fov aspect (c.sc-near) (c.sc-far)
      is CamOrthoProj (extent) ->
        let half-w = extent * aspect / 1000
        in let half-h = extent
        in mat4-ortho (-half-w) half-w (-half-h) half-h (c.sc-near) (c.sc-far)

  spark-camera-vp : SparkCamera -> Mat4
  spark-camera-vp (c) = mat4-mul (spark-camera-proj c) (spark-camera-view c)

Section: Orbit Controls

  spark-camera-orbit : SparkCamera, Integer, Integer -> SparkCamera
  spark-camera-orbit (c) (yaw-delta) (pitch-delta) =
    let dir = vec3-subtract (c.sc-eye) (c.sc-target)
    in let dist = mat4-v3-length dir
    in let q-yaw = quat-rotate-y yaw-delta
    in let right = mat4-v3-normalize (vec3-cross dir (c.sc-up))
    in let q-pitch = quat-from-axis-angle right pitch-delta
    in let q = quat-multiply q-yaw q-pitch
    in let new-dir = quat-rotate-vec q dir
    in let new-eye = vec3-add (c.sc-target) new-dir
    in __record-set c "sc-eye" new-eye

  spark-camera-pan : SparkCamera, Integer, Integer -> SparkCamera
  spark-camera-pan (c) (dx) (dy) =
    let fwd = mat4-v3-normalize (vec3-subtract (c.sc-target) (c.sc-eye))
    in let right = mat4-v3-normalize (vec3-cross fwd (c.sc-up))
    in let up = vec3-cross right fwd
    in let offset = vec3-add (vec3-scale right dx) (vec3-scale up dy)
    in let new-eye = vec3-add (c.sc-eye) offset
    in let new-target = vec3-add (c.sc-target) offset
    in __record-set (__record-set c "sc-eye" new-eye) "sc-target" new-target

  spark-camera-zoom : SparkCamera, Integer -> SparkCamera
  spark-camera-zoom (c) (delta) =
    let dir = vec3-subtract (c.sc-eye) (c.sc-target)
    in let dist = mat4-v3-length dir
    in let new-dist = sc-max 500 (dist + delta)
    in let norm = mat4-v3-normalize dir
    in let new-eye = vec3-add (c.sc-target) (vec3-scale norm new-dist)
    in __record-set c "sc-eye" new-eye

Section: Helpers

  sc-max : Integer, Integer -> Integer
  sc-max (a) (b) = if a > b then a else b

