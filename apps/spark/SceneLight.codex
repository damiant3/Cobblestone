Chapter: SceneLight
  cites Math chapter Quaternion

 Scene lighting for the 3D pipeline. Point, directional, and ambient
 lights with Phong shading computation.

 We say:

Section: Types

  LightKind =
    | LightDirectional (Vec3)
    | LightPoint (Vec3) (Real)
    | LightAmbient

  SparkLight = record {
    sl-kind : LightKind,
    sl-color : Integer,
    sl-intensity : Real
  }

Section: Construction

  light-directional : Vec3, Integer, Real -> SparkLight
  light-directional (dir) (color) (intensity) = SparkLight {
    sl-kind = LightDirectional dir,
    sl-color = color,
    sl-intensity = intensity
  }

  light-point : Vec3, Real, Integer, Real -> SparkLight
  light-point (pos) (radius) (color) (intensity) = SparkLight {
    sl-kind = LightPoint pos radius,
    sl-color = color,
    sl-intensity = intensity
  }

  light-ambient : Integer, Real -> SparkLight
  light-ambient (color) (intensity) = SparkLight {
    sl-kind = LightAmbient,
    sl-color = color,
    sl-intensity = intensity
  }

Section: Shading

  light-shade : SparkLight, Vec3, Vec3 -> Real
  light-shade (light) (pos) (normal) =
    when light.sl-kind
      is LightAmbient -> light.sl-intensity
      is LightDirectional (dir) ->
        let ndl = vec3-dot normal dir
        in let clamped = if ndl < 0.0 then 0.0 else ndl
        in clamped * light.sl-intensity
      is LightPoint (lpos) (radius) ->
        let to-light = vec3-subtract lpos pos
        in let dist = geo-sqrt (vec3-length-squared to-light)
        in let ndl = if dist ~ 0.0 then 0.0 else vec3-dot normal (light-v3-normalize to-light)
        in let clamped = if ndl < 0.0 then 0.0 else ndl
        in let atten = if dist > radius then 0.0 else (radius - dist) / radius
        in clamped * atten * light.sl-intensity

  light-shade-all : List SparkLight, Vec3, Vec3, Integer, Real -> Real
  light-shade-all (lights) (pos) (normal) (i) (total) =
    if i >= list-length lights then total
    else let contrib = light-shade (list-at lights i) pos normal
    in let new-total = total + contrib
    in light-shade-all lights pos normal (i + 1) new-total

Section: Color Application

  light-apply-color : Integer, Real -> Integer
  light-apply-color (base-color) (shade) =
    let r = real-to-int (real-from-int (base-color / 65536) * shade)
    in let g = real-to-int (real-from-int (base-color / 256 - base-color / 65536 * 256) * shade)
    in let b = real-to-int (real-from-int (base-color - base-color / 256 * 256) * shade)
    in let cr = if r > 255 then 255 else r
    in let cg = if g > 255 then 255 else g
    in let cb = if b > 255 then 255 else b
    in cr * 65536 + cg * 256 + cb

Section: Helpers

  light-v3-normalize : Vec3 -> Vec3
  light-v3-normalize (v) =
    let len = geo-sqrt (v.vx * v.vx + v.vy * v.vy + v.vz * v.vz)
    in if len ~ 0.0 then vec3-zero
    else Vec3 { vx = v.vx / len, vy = v.vy / len, vz = v.vz / len }

