<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Codex Spark Studio</title>
<style>
{{CSS}}
</style>
</head>
<body>
<div class="app">
  <div class="header">
    <span class="logo" onclick="showAbout()" style="cursor:pointer" title="About Codex Spark">CODEX SPARK</span>
    <div class="hdr-sep"></div>
    <div class="mode-tabs" id="mode-tabs"></div>
    <div class="hdr-right">
      <span id="project-name" style="cursor:pointer;opacity:0.6" onclick="promptProjectName()" title="Click to rename project">Untitled</span>
      <span class="hdr-sep" style="margin:0 6px"></span>
      <span id="stats">--</span>
    </div>
  </div>
  <div class="panels" id="panels"></div>
  <div class="status">
    <div style="display:flex;gap:14px">
      <span class="mode" id="st-mode">MODEL</span>
      <span id="st-tool">Select</span>
      <span id="st-objects">0 objects</span>
      <span id="st-verts">0 verts</span>
    </div>
    <span id="st-msg">Ready</span>
  </div>
</div>
<script>
{{JS}}
</script>
</body>
</html>
