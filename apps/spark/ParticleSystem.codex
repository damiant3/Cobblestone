Chapter: ParticleSystem
  cites Math chapter Quaternion
  cites Game chapter Rasterizer

 GPU-style particle system for visual effects. Particles have
 position, velocity, life, color, and size. The emitter spawns
 particles each frame; the updater advances physics and kills
 expired ones. All values fixed-point scale 1000.

 We say:

Section: Types

  Particle = record {
    ptl-x : Integer,
    ptl-y : Integer,
    ptl-z : Integer,
    ptl-vx : Integer,
    ptl-vy : Integer,
    ptl-vz : Integer,
    ptl-life : Integer,
    ptl-max-life : Integer,
    ptl-color : Integer,
    ptl-size : Integer,
    ptl-alive : Boolean
  }

  EmitterShape =
    | EmitPoint
    | EmitSphere (Integer)
    | EmitCone (Integer) (Integer)
    | EmitBox (Integer) (Integer) (Integer)

  EmitterConfig = record {
    ec-shape : EmitterShape,
    ec-rate : Integer,
    ec-speed-min : Integer,
    ec-speed-max : Integer,
    ec-life-min : Integer,
    ec-life-max : Integer,
    ec-size-start : Integer,
    ec-size-end : Integer,
    ec-color-start : Integer,
    ec-color-end : Integer,
    ec-gravity : Integer
  }

  ParticlePool = record {
    pp-particles : List Particle,
    pp-count : Integer,
    pp-max : Integer,
    pp-spawn-accum : Integer,
    pp-config : EmitterConfig,
    pp-origin : Vec3,
    pp-frame : Integer
  }

