Chapter: Sequencer
  cites Spark chapter Track
  cites Spark chapter MidiTrack

 We say:

Section: Types

  TransportState =
    | TransStopped
    | TransPlaying
    | TransRecording

  SequencerState = record {
    seq-midi-tracks : List MidiTrack2,
    seq-audio-tracks : List AudioTrack,
    seq-midi-count : Integer,
    seq-audio-count : Integer,
    seq-bpm : Integer,
    seq-position : Integer,
    seq-transport : TransportState,
    seq-loop-start : Integer,
    seq-loop-length : Integer,
    seq-looping : Boolean
  }

Section: Construction

  sequencer-new : Integer -> SequencerState
  sequencer-new (bpm) = SequencerState {
    seq-midi-tracks = [],
    seq-audio-tracks = [],
    seq-midi-count = 0,
    seq-audio-count = 0,
    seq-bpm = bpm,
    seq-position = 0,
    seq-transport = TransStopped,
    seq-loop-start = 0,
    seq-loop-length = 0,
    seq-looping = False
  }

Section: Track Management

  seq-add-midi : SequencerState, MidiTrack2 -> SequencerState
  seq-add-midi (seq) (track) = SequencerState {
    seq-midi-tracks = list-push (seq.seq-midi-tracks) track,
    seq-audio-tracks = seq.seq-audio-tracks,
    seq-midi-count = seq.seq-midi-count + 1,
    seq-audio-count = seq.seq-audio-count,
    seq-bpm = seq.seq-bpm,
    seq-position = seq.seq-position,
    seq-transport = seq.seq-transport,
    seq-loop-start = seq.seq-loop-start,
    seq-loop-length = seq.seq-loop-length,
    seq-looping = seq.seq-looping
  }

  seq-add-audio : SequencerState, AudioTrack -> SequencerState
  seq-add-audio (seq) (track) = SequencerState {
    seq-midi-tracks = seq.seq-midi-tracks,
    seq-audio-tracks = list-push (seq.seq-audio-tracks) track,
    seq-midi-count = seq.seq-midi-count,
    seq-audio-count = seq.seq-audio-count + 1,
    seq-bpm = seq.seq-bpm,
    seq-position = seq.seq-position,
    seq-transport = seq.seq-transport,
    seq-loop-start = seq.seq-loop-start,
    seq-loop-length = seq.seq-loop-length,
    seq-looping = seq.seq-looping
  }

Section: Transport

  seq-play : SequencerState -> SequencerState
  seq-play (seq) = __record-set seq "seq-transport" TransPlaying

  seq-stop : SequencerState -> SequencerState
  seq-stop (seq) = __record-set (__record-set seq "seq-transport" TransStopped) "seq-position" 0

  seq-set-bpm : SequencerState, Integer -> SequencerState
  seq-set-bpm (seq) (bpm) = __record-set seq "seq-bpm" bpm

Section: Info

  seq-info : SequencerState -> Text
  seq-info (seq) =
    let state-str = when seq.seq-transport
        is TransStopped -> "stopped"
        is TransPlaying -> "playing"
        is TransRecording -> "recording"
    in show (seq.seq-midi-count) & " MIDI + " & show (seq.seq-audio-count) & " audio tracks, " & show (seq.seq-bpm) & " BPM (" & state-str & ")"

