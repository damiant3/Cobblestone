 Graphical demo for Spark. Renders a 3D scene with cube, sphere,
 and ground plane, then blits to the GOP framebuffer at #40000000.
 Run with: codex-vm -kernel SparkGfxDemo.cdx -gop -mem 2048

 We say:

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni "Spark GFX: rendering scene..."
    let vp-w = 640
    in let vp-h = 480
    in let gd = gop-display-new vp-w vp-h
    in let bg = gop-clear gd 2631720
    in let cam = spark-camera-new vp-w vp-h
    in let lights = [light-directional (vec3-new 577 577 577) #FFFFFF 900, light-ambient #FFFFFF 250]
    in let cube = mesh-cube 1000
    in let sphere = mesh-sphere 700 10 16
    in let plane = mesh-plane 8000 8000
    in let ctx = render-ctx-new cam lights
    in let ctx2 = render-ctx-add-mesh ctx cube
    in let ctx3 = render-ctx-add-mesh ctx2 sphere
    in let ctx4 = render-ctx-add-mesh ctx3 plane
    in let sg = scene-graph-new
    in let sg2 = sg-add-mesh sg "Cube" 0 0
    in let sg3 = sg-set-position sg2 0 (vec3-new 0 600 0)
    in let sg4 = sg-add-mesh sg3 "Sphere" 1 0
    in let sg5 = sg-set-position sg4 1 (vec3-new 2500 700 (-500))
    in let sg6 = sg-add-mesh sg5 "Ground" 2 0
    in let scene-fb = scene-render sg6 ctx4 vp-w vp-h 2631720
    in let w1 = gop-blit gd scene-fb
    in let face-count = cube.tm-face-count + sphere.tm-face-count + plane.tm-face-count
    in act
      print-line-uni ("Spark GFX: " & show (sg6.sg-count) & " nodes, " & show face-count & " faces")
      print-line-uni ("Spark GFX: " & gop-display-info gd)
      print-line-uni "Spark GFX: displaying. Close the VM window to exit."
      let halt = spin-wait 0
      in print-line-uni "exit"
    end
  end

Section: Helpers

  spin-wait : Integer -> Integer
  spin-wait (n) = spin-wait (n + 1)

