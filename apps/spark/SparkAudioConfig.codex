\", \"bpmHint\": 70 },\n    { \"label\": \"Andante (76–108 BPM)\", \"bpmHint\": 92 },\n    { \"label\": \"Moderato (108–120 BPM)\", \"bpmHint\": 114 },\n    { \"label\": \"Allegro (120–156 BPM)\", \"bpmHint\": 138 },\n    { \"label\": \"Vivace (156–176 BPM)\", \"bpmHint\": 166 },\n    { \"label\": \"Presto (168–200 BPM)\", \"bpmHint\": 184 },\n    { \"label\": \"Prestissimo (200+ BPM)\", \"bpmHint\": 210 }\n  ],\n  \"keys\": [\n    \"C major\", \"C minor\",\n    \"C♯ major\", \"C♯ minor\",\n    \"D major\", \"D minor\",\n    \"E♭ major\", \"E♭ minor\",\n    \"E major\", \"E minor\",\n    \"F major\", \"F minor\",\n    \"F♯ major\", \"F♯ minor\",\n    \"G major\", \"G minor\",\n    \"A♭ major\", \"A♭ minor\",\n    \"A major\", \"A minor\",\n    \"B♭ major\", \"B♭ minor\",\n    \"B major\", \"B minor\"\n  ],\n  \"scales\": [\n    \"Major (Ionian)\",\n    \"Natural Minor (Aeolian)\",\n    \"Harmonic Minor\",\n    \"Melodic Minor\",\n    \"Dorian\",\n    \"Phrygian\",\n    \"Lydian\",\n    \"Mixolydian\",\n    \"Locrian\",\n    \"Pentatonic Major\",\n    \"Pentatonic Minor\",\n    \"Blues Scale\",\n    \"Whole Tone\",\n    \"Chromatic\",\n    \"Hungarian Minor\",\n    \"Arabian\",\n    \"Japanese (Hirajoshi)\",\n    \"Phrygian Dominant\",\n    \"Bebop Dominant\",\n    \"Enigmatic\"\n  ],\n  \"moodPresets\": [\n    \"epic orchestral battle music, intense and heroic\",\n    \"calm ambient exploration, mysterious and serene\",\n    \"dark foreboding atmosphere, low brass and strings\",\n    \"upbeat adventure theme, cheerful and energetic\",\n    \"sad emotional piano, melancholic and reflective\",\n    \"tense stealth music, minimal and suspenseful\",\n    \"triumphant victory fanfare, brass and percussion\",\n    \"eerie horror ambient, unsettling and atmospheric\",\n    \"celtic folk tavern music, lively fiddle and flute\",\n    \"electronic cyberpunk, pulsing synths and beats\",\n    \"romantic waltz, sweeping strings and piano\",\n    \"mystical ancient temple, ethereal and reverent\",\n    \"western showdown, twangy guitar and tension\",\n    \"jungle exploration, tribal percussion and wildlife\",\n    \"underwater deep sea, sonar pings and whale song\",\n    \"space epic, vast synthesizer pads and wonder\",\n    \"medieval court, regal fanfare and harpsichord\",\n    \"noir detective jazz, smoky saxophone and piano\",\n    \"industrial factory, mechanical rhythm and grit\",\n    \"lullaby, gentle and soothing, music box quality\"\n  ]\n}\n"

  spark-sfx-config-json : Text
  spark-sfx-config-json = "{\n  \"minDuration\": 1.0,\n  \"maxDuration\": 10.0,\n  \"categories\": [\n    \"All\", \"UI\", \"Combat\", \"Firearms\", \"Nature\", \"Movement\", \"Magic\",\n    \"Mechanical\", \"Ambient\", \"Creature\", \"Impact\", \"Voice\", \"Horror\",\n    \"Sci-Fi\", \"Vehicle\", \"Household\", \"Musical\", \"Weather\", \"Liquid\",\n    \"Destruction\", \"Communication\", \"Sports\", \"Food\", \"Textile\", \"Alarm\"\n  ],\n  \"categoryDefaults\": {\n    \"UI\":            { \"duration\": 1.0, \"temperature\": 0.8, \"cfg\": 4.0 },\n    \"Combat\":        { \"duration\": 2.0, \"temperature\": 1.0, \"cfg\": 3.5 },\n    \"Firearms\":      { \"duration\": 1.5, \"temperature\": 1.0, \"cfg\": 4.0 },\n    \"Nature\":        { \"duration\": 4.0, \"temperature\": 1.2, \"cfg\": 3.0 },\n    \"Movement\":      { \"duration\": 1.0, \"temperature\": 0.9, \"cfg\": 3.5 },\n    \"Magic\":         { \"duration\": 2.0, \"temperature\": 1.1, \"cfg\": 3.5 },\n    \"Mechanical\":    { \"duration\": 2.0, \"temperature\": 0.9, \"cfg\": 3.5 },\n    \"Ambient\":       { \"duration\": 5.0, \"temperature\": 1.2, \"cfg\": 2.5 },\n    \"Creature\":      { \"duration\": 2.0, \"temperature\": 1.1, \"cfg\": 3.5 },\n    \"Impact\":        { \"duration\": 1.0, \"temperature\": 0.9, \"cfg\": 4.0 },\n    \"Voice\":         { \"duration\": 1.5, \"temperature\": 1.0, \"cfg\": 3.5 },\n    \"Horror\":        { \"duration\": 3.0, \"temperature\": 1.3, \"cfg\": 3.0 },\n    \"Sci-Fi\":        { \"duration\": 2.0, \"temperature\": 1.2, \"cfg\": 3.5 },\n    \"Vehicle\":       { \"duration\": 3.0, \"temperature\": 1.0, \"cfg\": 3.5 },\n    \"Household\":     { \"duration\": 1.5, \"temperature\": 0.8, \"cfg\": 3.5 },\n    \"Musical\":       { \"duration\": 2.0, \"temperature\": 1.0, \"cfg\": 3.0 },\n    \"Weather\":       { \"duration\": 4.0, \"temperature\": 1.2, \"cfg\": 3.0 },\n    \"Liquid\":        { \"duration\": 2.0, \"temperature\": 1.0, \"cfg\": 3.5 },\n    \"Destruction\":   { \"duration\": 2.5, \"temperature\": 1.1, \"cfg\": 3.5 },\n    \"Communication\": { \"duration\": 1.5, \"temperature\": 0.9, \"cfg\": 3.5 },\n    \"Sports\":        { \"duration\": 1.5, \"temperature\": 1.0, \"cfg\": 3.5 },\n    \"Food\":          { \"duration\": 1.0, \"temperature\": 0.8, \"cfg\": 3.5 },\n    \"Textile\":       { \"duration\": 1.0, \"temperature\": 0.8, \"cfg\": 3.5 },\n    \"Alarm\":         { \"duration\": 2.0, \"temperature\": 0.8, \"cfg\": 4.0 }\n  },\n  \"presets\": [\n    { \"label\": \"🖱 Button Click\",        \"category\": \"UI\",       \"prompt\": \"short UI button click, clean digital interface beep, crisp and satisfying\" },\n    { \"label\": \"🖱 Menu Open\",           \"category\": \"UI\",       \"prompt\": \"UI menu sliding open, soft whoosh with digital chime, polished interface\" },\n    { \"label\": \"🖱 Menu Close\",          \"category\": \"UI\",       \"prompt\": \"UI menu sliding closed, soft reverse whoosh, polished interface\" },\n    { \"label\": \"🖱 Error Buzz\",          \"category\": \"UI\",       \"prompt\": \"UI error buzzer, short harsh digital rejection sound, wrong action\" },\n    { \"label\": \"🖱 Notification\",        \"category\": \"UI\",       \"prompt\": \"gentle notification chime, pleasant digital ping, soft and clear\" },\n    { \"label\": \"🖱 Coin Collect\",        \"category\": \"UI\",       \"prompt\": \"coin pickup sound, bright metallic clink, rewarding collect jingle\" },\n    { \"label\": \"🖱 Level Up\",            \"category\": \"UI\",       \"prompt\": \"level up fanfare, ascending digital chime, triumphant achievement sound\" },\n    { \"label\": \"🖱 Health Pickup\",       \"category\": \"UI\",       \"prompt\": \"health pickup sound, soft warm healing chime, restorative glow\" },\n    { \"label\": \"🖱 Countdown Tick\",      \"category\": \"UI\",       \"prompt\": \"countdown timer tick, sharp digital clock beep, urgent\" },\n    { \"label\": \"🖱 Inventory Open\",      \"category\": \"UI\",       \"prompt\": \"inventory bag opening, leather and cloth rustling, items shifting\" },\n    { \"label\": \"🖱 Purchase Success\",    \"category\": \"UI\",       \"prompt\": \"purchase confirmation sound, cash register ding, satisfying transaction\" },\n    { \"label\": \"🖱 Quest Complete\",      \"category\": \"UI\",       \"prompt\": \"quest complete jingle, triumphant short fanfare, reward earned\" },\n    { \"label\": \"🖱 Tab Switch\",          \"category\": \"UI\",       \"prompt\": \"soft tab switch click, subtle interface navigation, clean\" },\n    { \"label\": \"🖱 Hover\",              \"category\": \"UI\",       \"prompt\": \"subtle hover highlight sound, very soft digital shimmer, UI feedback\" },\n    { \"label\": \"🖱 Checkbox Toggle\",     \"category\": \"UI\",       \"prompt\": \"checkbox toggle click, short satisfying switch sound, digital\" },\n\n    { \"label\": \"⚔ Sword Swing\",         \"category\": \"Combat\",   \"prompt\": \"sword swing whoosh, fast sharp blade cutting through air, metallic\" },\n    { \"label\": \"⚔ Sword Clash\",         \"category\": \"Combat\",   \"prompt\": \"metal sword clash impact, ringing steel on steel, sparks\" },\n    { \"label\": \"⚔ Arrow Fire\",          \"category\": \"Combat\",   \"prompt\": \"bow arrow release, taut string snap followed by arrow whistle\" },\n    { \"label\": \"⚔ Arrow Impact\",        \"category\": \"Combat\",   \"prompt\": \"arrow thudding into wood or flesh, sharp piercing impact\" },\n    { \"label\": \"⚔ Explosion Large\",     \"category\": \"Combat\",   \"prompt\": \"large fiery explosion, deep boom with debris scatter, powerful blast\" },\n    { \"label\": \"⚔ Explosion Small\",     \"category\": \"Combat\",   \"prompt\": \"small grenade explosion, sharp crack, moderate blast radius\" },\n    { \"label\": \"⚔ Shield Block\",        \"category\": \"Combat\",   \"prompt\": \"shield block impact, heavy metallic thud with reverb, defensive\" },\n    { \"label\": \"⚔ Axe Chop\",           \"category\": \"Combat\",   \"prompt\": \"battle axe heavy chop, deep thud with metallic ring, brutal\" },\n    { \"label\": \"⚔ Mace Strike\",        \"category\": \"Combat\",   \"prompt\": \"heavy mace striking armor, crushing impact with metallic crunch\" },\n    { \"label\": \"⚔ Whip Crack\",         \"category\": \"Combat\",   \"prompt\": \"whip cracking sharply through the air, fast snapping sound\" },\n    { \"label\": \"⚔ Knife Slash\",        \"category\": \"Combat\",   \"prompt\": \"knife slashing quickly, short sharp cutting sound, close combat\" },\n    { \"label\": \"⚔ Fist Combo\",         \"category\": \"Combat\",   \"prompt\": \"rapid fist combo punches, multiple quick body impacts, fighting\" },\n    { \"label\": \"⚔ Parry\",              \"category\": \"Combat\",   \"prompt\": \"blade parry, quick metallic ring deflection, skillful defense\" },\n    { \"label\": \"⚔ Battle Cry\",         \"category\": \"Combat\",   \"prompt\": \"warrior battle cry before charge, fierce and aggressive yell\" },\n    { \"label\": \"⚔ Armor Clatter\",      \"category\": \"Combat\",   \"prompt\": \"heavy armor clattering, metal plates shifting and jingling, movement\" },\n\n    { \"label\": \"🔫 Pistol Single\",      \"category\": \"Firearms\", \"prompt\": \"single pistol gunshot, sharp crack with echo, handgun fire\" },\n    { \"label\": \"🔫 Pistol Silenced\",    \"category\": \"Firearms\", \"prompt\": \"silenced pistol shot, suppressed muffled thud, stealth weapon\" },\n    { \"label\": \"🔫 Rifle Single\",       \"category\": \"Firearms\", \"prompt\": \"single rifle shot, loud sharp crack, high caliber, distant echo\" },\n    { \"label\": \"🔫 Rifle Burst\",        \"category\": \"Firearms\", \"prompt\": \"three round burst rifle fire, rapid automatic shots, military\" },\n    { \"label\": \"🔫 Shotgun Blast\",      \"category\": \"Firearms\", \"prompt\": \"shotgun blast, deep booming shot with pump rack, powerful\" },\n    { \"label\": \"🔫 Shotgun Pump\",       \"category\": \"Firearms\", \"prompt\": \"shotgun pump action, metallic slide and click, loading\" },\n    { \"label\": \"🔫 Machine Gun\",        \"category\": \"Firearms\", \"prompt\": \"machine gun sustained fire, rapid automatic rounds, battlefield\" },\n    { \"label\": \"🔫 Reload Magazine\",    \"category\": \"Firearms\", \"prompt\": \"gun magazine reload, eject and insert click, military weapon\" },\n    { \"label\": \"🔫 Bullet Ricochet\",    \"category\": \"Firearms\", \"prompt\": \"bullet ricochet off metal, sharp whizzing ping, near miss\" },\n    { \"label\": \"🔫 Bullet Whizz\",       \"category\": \"Firearms\", \"prompt\": \"bullet whizzing past, close flyby, dangerous near miss\" },\n    { \"label\": \"🔫 Dry Fire Click\",     \"category\": \"Firearms\", \"prompt\": \"gun dry fire click, empty chamber, out of ammo\" },\n    { \"label\": \"🔫 Sniper Shot\",        \"category\": \"Firearms\", \"prompt\": \"sniper rifle shot, powerful single crack with long distance echo\" },\n    { \"label\": \"🔫 Laser Blaster\",      \"category\": \"Firearms\", \"prompt\": \"sci-fi laser blaster shot, pew pew energy weapon, futuristic\" },\n    { \"label\": \"🔫 Plasma Cannon\",      \"category\": \"Firearms\", \"prompt\": \"heavy plasma cannon blast, deep energy discharge, sci-fi weapon\" },\n\n    { \"label\": \"🌿 Wind Gust\",          \"category\": \"Nature\",   \"prompt\": \"wind gust blowing through trees, rustling leaves, natural breeze\" },\n    { \"label\": \"🌿 Wind Howling\",       \"category\": \"Nature\",   \"prompt\": \"wind howling through canyon, eerie sustained gust, desolate\" },\n    { \"label\": \"🌿 Rain Drops\",         \"category\": \"Nature\",   \"prompt\": \"gentle rain drops on stone, natural rainfall, calming patter\" },\n    { \"label\": \"🌿 Rain Heavy\",         \"category\": \"Nature\",   \"prompt\": \"heavy downpour, intense rainfall with puddle splashes\" },\n    { \"label\": \"🌿 Thunder Distant\",    \"category\": \"Nature\",   \"prompt\": \"distant thunder rumble, deep 