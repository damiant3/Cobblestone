  spark-music-config-json = "{\n  \"instruments\": {\n    \"Strings\": [\n      \"violin\", \"viola\", \"cello\", \"double bass\", \"harp\",\n      \"acoustic guitar\", \"classical guitar\", \"electric guitar\", \"bass guitar\",\n      \"banjo\", \"mandolin\", \"ukulele\", \"sitar\", \"erhu\", \"koto\",\n      \"fiddle\", \"lute\", \"oud\", \"balalaika\", \"pedal steel guitar\"\n    ],\n    \"Woodwinds\": [\n      \"flute\", \"piccolo\", \"clarinet\", \"bass clarinet\", \"oboe\",\n      \"English horn\", \"bassoon\", \"contrabassoon\", \"recorder\",\n      \"saxophone soprano\", \"saxophone alto\", \"saxophone tenor\", \"saxophone baritone\",\n      \"pan flute\", \"shakuhachi\", \"bansuri\", \"didgeridoo\", \"tin whistle\", \"ocarina\"\n    ],\n    \"Brass\": [\n      \"trumpet\", \"cornet\", \"flugelhorn\", \"French horn\",\n      \"trombone\", \"bass trombone\", \"tuba\", \"euphonium\",\n      \"sousaphone\", \"bugle\", \"mellophone\"\n    ],\n    \"Percussion\": [\n      \"snare drum\", \"bass drum\", \"timpani\", \"cymbals\", \"hi-hat\",\n      \"tom-toms\", \"bongos\", \"congas\", \"djembe\", \"cajon\",\n      \"tambourine\", \"triangle\", \"cowbell\", \"wood block\",\n      \"maracas\", \"claves\", \"guiro\", \"shaker\", \"castanets\",\n      \"glockenspiel\", \"xylophone\", \"marimba\", \"vibraphone\",\n      \"steel drums\", \"tabla\", \"taiko drum\", \"frame drum\", \"bodhrán\"\n    ],\n    \"Keyboards\": [\n      \"piano\", \"grand piano\", \"upright piano\", \"electric piano\",\n      \"harpsichord\", \"organ\", \"pipe organ\", \"Hammond organ\",\n      \"synthesizer\", \"Moog synth\", \"Rhodes piano\", \"Wurlitzer\",\n      \"clavinet\", \"celesta\", \"accordion\", \"harmonium\", \"melodica\"\n    ],\n    \"Electronic\": [\n      \"analog synthesizer\", \"digital synthesizer\", \"modular synth\",\n      \"drum machine\", \"sampler\", \"vocoder\", \"theremin\",\n      \"808 bass\", \"303 acid bass\", \"pad synth\", \"lead synth\",\n      \"arpeggiator sy