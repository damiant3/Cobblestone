 Codex.Spark entry point. Exercises all 70 modules across 3D modeling,
 image editing, animation, audio/DAW, video compositing, procedural
 generation, and the full creative pipeline.

 We say:

Section: Entry

  opening : [Console] Nothing = act
    let vp-w = 320
    in let vp-h = 240
    in let cam = spark-camera-new vp-w vp-h
    in let lights = [light-directional (vec3-new 0.577 0.577 0.577) #FFFFFF 0.8, light-ambient #FFFFFF 0.2]
    in let cube = mesh-cube 1.0
    in let sphere = mesh-sphere 0.6 8 12
    in let plane = mesh-plane 6.0 6.0
    in let ctx = render-ctx-new cam lights
    in let ctx2 = render-ctx-add-mesh ctx cube
    in let ctx3 = render-ctx-add-mesh ctx2 sphere
    in let ctx4 = render-ctx-add-mesh ctx3 plane
    in let sg = scene-graph-new
    in let sg2 = sg-add-mesh sg "Cube" 0 0
    in let sg3 = sg-set-position sg2 0 (vec3-new 0.0 0.5 0.0)
    in let sg4 = sg-add-mesh sg3 "Sphere" 1 0
    in let sg5 = sg-set-position sg4 1 (vec3-new 2.0 0.6 0.0)
    in let sg6 = sg-add-mesh sg5 "Ground" 2 0
    in let fb = scene-render sg6 ctx4 vp-w vp-h 2631720
    in let csg-result = mesh-union cube sphere
    in let stl-text = stl-export cube "Cube"
    in let tex = texture-checkerboard 16 16 4 #FFFFFF 0
    in let noise-cfg = noise-config-default
    in let noise-tex = noise-to-texture noise-cfg 32 32
    in let pk = picker-new 16711680
    in let pk2 = picker-set-hsv pk 120.0 0.8 0.9
    in let grd = gradient-linear 0 0 64 0
    in let grd2 = gradient-add-stop grd 0 16711680
    in let grd3 = gradient-add-stop grd2 500 16776960
    in let grd4 = gradient-add-stop grd3 1000 255
    in let cv = canvas-new 64 64 #FFFFFF
    in let br = brush-new 6 16711680 1.0
    in let cv2 = brush-stroke cv br 10 10 50 50
    in let cv3 = canvas-add-layer cv2 "Blue"
    in let cv4 = brush-stamp cv3 (brush-new 8 255 0.8) 32 32
    in let cv5 = filter-grayscale cv4
    in let cv6 = layer-duplicate cv5
    in let flat = canvas-flatten cv6
    in let ie = export-framebuf flat
    in let hist = histogram-compute flat
    in let lvl = levels-auto hist
    in let adjusted = levels-apply flat lvl
    in let sel = sel-rect 64 64 10 10 50 50
    in let sel-count = sel-pixel-count sel
    in let fx-stack = effect-stack-add (effect-stack-add effect-stack-new (fx-drop-shadow 0 3 2 2 0.5)) (fx-outer-glow 16776960 4 0.3)
    in let ab = advanced-brush-new 12 16711680 TipRound
    in let text-fb = fb-new 200 20 0
    in let text-fb2 = text-render text-fb "Spark" 2 2 text-style-default
    in let bz = bezier-track-new "bounce"
    in let bz2 = bezier-track-add-preset bz 0 0 CurveEaseIn
    in let bz3 = bezier-track-add-preset bz2 30 5000 CurveEaseOut
    in let bz4 = bezier-track-add-preset bz3 60 0 CurveBounce
    in let bz-val = bezier-track-eval bz4 15
    in let channels = anim-channel-set-new
    in let channels2 = anim-add-channel channels 0 PropPosX (keytrack-add-linear (keytrack-add-linear (keytrack-new "x") 0 0.0) 30 5.0)
    in let player = anim-player-new channels2 30
    in let player2 = anim-tick (anim-tick (anim-tick (anim-play player)))
    in let tl = timeline-new player2 40
    in let th = transform-hierarchy-new
    in let th2 = th-add th (transform-new (vec3-new 0.0 0.5 0.0) quat-identity (vec3-new 1.0 1.0 1.0))
    in let th3 = th-add-child th2 (transform-new (vec3-new 2.0 0.0 0.0) quat-identity (vec3-new 0.5 0.5 0.5)) 0
    in let world-pos = th-world-position th3 1
    in let gc = grid-default
    in let gz = gizmo-new GizmoTranslate
    in let ue = uv-auto-island cube
    in let rp = render-pipeline-default vp-w vp-h 2631720
    in let particles = particle-pool-tick (particle-pool-tick (particle-pool-new emitter-fire 200 vec3-zero))
    in let cp = cam-path-new CamDolly
    in let cp2 = cam-path-add (cam-path-add cp (cam-waypoint (vec3-new 0.0 1.0 5.0) vec3-zero 0.785 0)) (cam-waypoint (vec3-new 5.0 2.0 0.0) vec3-zero 0.785 60)
    in let cam-wp = cam-path-eval cp2 30
    in let mat-lib = mat-lib-add (mat-lib-add mat-lib-state-new pbr-metal) pbr-emissive
    in let arm = armature-humanoid
    in let arm2 = armature-set-pose arm 3 (vec3-new 0.0 0.2 0.0) (quat-rotate-x 0.2)
    in let head-tip = armature-bone-tip arm2 3
    in let ik-chain = ik-chain-new [4, 5] 2 (vec3-new (-0.5) 0.5 0.0)
    in let ik-result = ik-solve arm2 ik-chain
    in let wmap = weight-map-new (cube.tm-vert-count) 2
    in let wmap2 = wp-assign-uniform wmap 0 0
    in let rect-path = path-rect 0 0 1000 500
    in let extruded = shape-extrude rect-path extrude-default
    in let vase-path = path-add (path-add (path-add (path-add path-new 200 0) 300 500) 150 800) 200 1000
    in let vase = shape-lathe vase-path lathe-default
    in let vc = compositor-new 64 48 24 120
    in let vc2 = compositor-add-layer vc (video-layer-new "BG" 0 120)
    in let nav = nav-default
    in let nav2 = nav-apply-orbit nav 100 50
    in let nav-pos = nav-camera-position nav2
    in let um = undo-manager-new 100
    in let um2 = um-push (um-push um (ActMoveObject 0 vec3-zero (vec3-new 0.1 0.2 0.0)) "Move") (ActSetColor 0 16711680 255) "Color"
    in let tone = inst-generate-tone inst-piano 440 4410 44100
    in let filtered = dsp-lowpass-buffer tone (list-length tone) 200
    in let spectrum = spectrum-analyze tone (list-length tone) 44100
    in let dl = delay-new 4410 500 300
    in let comp = compressor-new 20000 4000 100 200
    in let clip = audio-clip-new tone 0 1000
    in let audio-t = track-add-clip (audio-track-new "Piano") clip
    in let midi-t = midi-add-note (midi-add-note (midi-add-note (midi-track-new "Lead" 0) 0 60 100 480) 480 64 90 480) 960 67 80 480
    in let seq = seq-add-audio (seq-add-midi (sequencer-new 120) midi-t) audio-t
    in let mx = mixer-add-track (mixer-new 44100 120) audio-t
    in let ae = export-mix mx 100
    in let peak = export-audio-peak ae
    in let fx = fx-chain-add (fx-chain-add fx-chain-new fx-preset-reverb) fx-preset-delay
    in let proj = project-add-object (project-add-object (project-new vp-w vp-h) "Cube" cube 16711680) "Sphere" sphere 65280
    in act
      print-line-uni "Codex.Spark -- 70 modules"
      print-line-uni ("Scene: " & show (sg6.sg-count) & " nodes, " & show (cube.tm-face-count + sphere.tm-face-count + plane.tm-face-count) & " faces")
      print-line-uni ("CSG: union " & show (csg-result.tm-face-count) & " faces")
      print-line-uni ("STL: " & stl-info cube "Cube")
      print-line-uni ("Texture: " & texture-info tex & " noise=" & noise-config-info noise-cfg)
      print-line-uni ("Color: " & picker-info pk2)
      print-line-uni ("Gradient: " & gradient-info grd4)
      print-line-uni ("Canvas: " & layer-info cv6 & ", export: " & export-summary ie)
      print-line-uni ("Histogram: " & histogram-info hist)
      print-line-uni ("Levels: " & levels-info lvl)
      print-line-uni ("Selection: " & selection-info sel & " (" & show sel-count & " px)")
      print-line-uni ("Effects: " & effect-stack-info fx-stack)
      print-line-uni ("Brush: " & advanced-brush-info ab)
      print-line-uni ("Text: rendered 'Spark' at 2,2")
      print-line-uni ("Bezier: " & bezier-track-info bz4 & " val@15=" & show bz-val)
      print-line-uni ("Animation: " & show (anim-channel-count channels2) & " ch, " & timeline-info tl)
      print-line-uni ("Transforms: " & th-info th3 & " child=(" & show (world-pos.vx) & "," & show (world-pos.vy) & "," & show (world-pos.vz) & ")")
      print-line-uni ("Grid: " & grid-info gc)
      print-line-uni ("Gizmo: " & gizmo-info gz)
      print-line-uni ("UV: " & uv-editor-info ue)
      print-line-uni ("RenderPipeline: " & rp-info rp)
      print-line-uni ("Particles: " & particle-pool-info particles)
      print-line-uni ("CameraPath: " & cam-path-info cp2)
      print-line-uni ("Materials: " & mat-lib-info mat-lib)
      print-line-uni ("Armature: " & armature-info arm2 & " head=(" & show (head-tip.vx) & "," & show (head-tip.vy) & "," & show (head-tip.vz) & ")")
      print-line-uni ("IK: " & ik-result-info ik-result)
      print-line-uni ("Weights: " & weight-map-info wmap2)
      print-line-uni ("Shapes: rect=" & path-info rect-path & " extrude=" & show (extruded.tm-face-count) & "f vase=" & show (vase.tm-face-count) & "f")
      print-line-uni ("Compositor: " & compositor-info vc2)
      print-line-uni ("Viewport: " & nav-info nav2 & " pos=(" & show (nav-pos.vx) & "," & show (nav-pos.vy) & "," & show (nav-pos.vz) & ")")
      print-line-uni ("Undo: " & undo-info um2 & " top=" & undo-peek-desc um2)
      print-line-uni ("Project: " & project-summary proj)
      print-line-uni ("Audio: " & show (list-length tone) & " samples (" & inst-info inst-piano & " 440Hz)")
      print-line-uni ("DSP: lp " & show (list-length filtered) & " samples, " & delay-info dl & ", " & compressor-info comp)
      print-line-uni ("Spectrum: " & spectrum-info spectrum)
      print-line-uni ("MIDI: " & midi-track-info midi-t)
      print-line-uni ("Mixer: " & mixer-info mx & ", peak=" & show peak)
      print-line-uni ("Sequencer: " & seq-info seq)
      print-line-uni ("FX: " & fx-chain-info fx)
      print-line-uni ("Export: " & export-audio-info ae)
      print-line-uni "Ready."
    end
  end

Section: Helpers

  app-count-lines : Text, Integer, Integer, Integer -> Integer
  app-count-lines (t) (i) (count) (len) =
    if i >= len then count + 1
    else let ch = char-code (char-at t i)
    in let new-count = if ch == 10 then count + 1 else count
    in app-count-lines t (i + 1) new-count len

