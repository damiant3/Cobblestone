Chapter: SparkCss

 CSS generation for Spark Studio. Each function returns a CSS rule
 as Text. The full stylesheet is assembled by spark-stylesheet.

Section: Variables

  css-vars : Text =
    ":root{--bg:#08081a;--surface:#0c0c22;--panel:#0e0e28;--border:#1a1a3e;--text:#d0d0e8;--dim:#4848a0;--accent:#00d4ff;--accent2:#7b61ff;--warn:#ff5f57;--green:#28c840;--yellow:#febc2e;--font:'Cascadia Code','JetBrains Mono','Fira Code',monospace}"

Section: Reset

  css-reset : Text =
    "*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}" &
    "body{font-family:var(--font);background:var(--bg);color:var(--text);height:100vh;overflow:hidden}" &
    ".app{display:flex;flex-direction:column;height:100vh}"

Section: Header

  css-header : Text =
    ".header{height:36px;display:flex;align-items:center;padding:0 12px;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;gap:0}" &
    ".logo{font-size:0.82em;font-weight:300;letter-spacing:0.2em;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;white-space:nowrap}" &
    ".hdr-sep{width:1px;height:18px;background:var(--border);margin:0 10px}" &
    ".mode-tabs{display:flex;gap:1px;flex:1}" &
    ".mode-tab{padding:4px 9px;border:none;background:transparent;color:var(--dim);font-family:var(--font);font-size:0.58em;cursor:pointer;border-radius:3px;letter-spacing:0.06em;transition:all 0.1s}" &
    ".mode-tab:hover{color:var(--text);background:rgba(255,255,255,0.03)}" &
    ".mode-tab.active{color:var(--accent);background:rgba(0,212,255,0.06)}" &
    ".hdr-right{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:0.6em;color:var(--dim)}"

Section: Panels

  css-panels : Text =
    ".panels{flex:1;position:relative;overflow:hidden}" &
    ".panel{position:absolute;background:var(--panel);border:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden}" &
    ".panel-head{height:22px;display:flex;align-items:center;padding:0 8px;font-size:0.54em;letter-spacing:0.12em;color:var(--dim);border-bottom:1px solid var(--border);background:rgba(255,255,255,0.01);user-select:none;flex-shrink:0}" &
    ".panel-body{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column}" &
    ".panel-body.vp-body{overflow:hidden}"

Section: Search

  css-search : Text =
    ".search-box{padding:3px 6px;border-bottom:1px solid var(--border)}" &
    ".search-input{width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:0.58em;padding:3px 6px;border-radius:3px;outline:none}" &
    ".search-input:focus{border-color:var(--accent)}" &
    ".search-input::placeholder{color:var(--dim);opacity:0.5}"

Section: Outliner

  css-outliner : Text =
    ".ol-list{flex:1;overflow-y:auto}" &
    ".ol-item{display:flex;align-items:center;gap:5px;padding:3px 8px;font-size:0.64em;cursor:pointer;border-left:2px solid transparent;transition:all 0.08s}" &
    ".ol-item:hover{background:rgba(255,255,255,0.03)}" &
    ".ol-item.sel{background:rgba(0,212,255,0.08);border-left-color:var(--accent);color:var(--accent)}" &
    ".ol-item.hid{opacity:0.4}" &
    ".ol-item .icon{width:12px;text-align:center;opacity:0.5;font-size:0.9em}" &
    ".ol-item .nm{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" &
    ".ol-item .vis{opacity:0.4;cursor:pointer;font-size:0.9em}" &
    ".ol-item .vis:hover{opacity:1}" &
    ".ol-item .del{opacity:0.15;cursor:pointer;font-size:0.85em}" &
    ".ol-item .del:hover{opacity:0.8;color:var(--warn)}"

Section: Properties

  css-props : Text =
    ".prop-row{display:flex;justify-content:space-between;align-items:center;padding:2px 8px;font-size:0.58em}" &
    ".prop-label{color:var(--dim);min-width:48px}" &
    ".prop-value{color:var(--text)}" &
    ".prop-input{background:rgba(255,255,255,0.05);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:1em;padding:1px 3px;border-radius:3px;width:54px}" &
    ".prop-input:focus{border-color:var(--accent);outline:none}" &
    ".prop-color{width:24px;height:14px;border:1px solid var(--border);border-radius:3px;cursor:pointer;padding:0}" &
    ".prop-section{font-size:0.5em;letter-spacing:0.1em;color:var(--dim);padding:5px 8px 1px;opacity:0.6}" &
    ".prop-slider{-webkit-appearance:none;width:64px;height:3px;border-radius:2px;background:var(--border);outline:none}" &
    ".prop-slider::-webkit-slider-thumb{-webkit-appearance:none;width:10px;height:10px;border-radius:50%;background:var(--accent);cursor:pointer}" &
    ".prop-toggle{cursor:pointer}.prop-toggle:hover{color:var(--accent)}" &
    ".prop-empty{padding:12px 8px;font-size:0.55em;color:var(--dim);opacity:0.5;text-align:center}"

Section: Scene Panel

  css-scene : Text =
    ".scene-section{padding:6px 8px 2px;font-size:0.5em;letter-spacing:0.1em;color:var(--dim);border-bottom:1px solid var(--border)}" &
    ".scene-group{padding:4px 8px}" &
    ".scene-btn{display:block;width:100%;padding:3px 0;margin-bottom:2px;border:1px solid var(--border);background:rgba(255,255,255,0.02);color:var(--text);font-family:var(--font);font-size:0.56em;border-radius:3px;cursor:pointer;text-align:left;padding-left:8px}" &
    ".scene-btn:hover{background:rgba(0,212,255,0.06);border-color:var(--accent);color:var(--accent)}" &
    ".scene-toggle{display:flex;align-items:center;justify-content:space-between;padding:3px 8px;font-size:0.56em;cursor:pointer;color:var(--dim)}" &
    ".scene-toggle:hover{color:var(--text)}" &
    ".scene-toggle .dot{width:8px;height:8px;border-radius:50%;border:1px solid var(--dim)}" &
    ".scene-toggle .dot.on{background:var(--accent);border-color:var(--accent)}"

Section: Viewport

  css-viewport : Text =
    "canvas{flex:1;display:block;width:100%;cursor:crosshair}" &
    "#error{color:var(--warn);padding:2em;text-align:center;display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}" &
    ".vp-hints{position:absolute;bottom:6px;right:8px;font-size:0.48em;color:var(--dim);opacity:0.3;line-height:1.5;text-align:right;pointer-events:none}"

Section: Toolbar

  css-toolbar : Text =
    ".toolbar{display:flex;gap:2px;padding:2px 4px;border-bottom:1px solid var(--border);flex-shrink:0}" &
    ".tool-btn{padding:2px 6px;border:1px solid transparent;background:transparent;color:var(--dim);font-family:var(--font);font-size:0.52em;cursor:pointer;border-radius:3px}" &
    ".tool-btn:hover{color:var(--text);background:rgba(255,255,255,0.04)}" &
    ".tool-btn.active{color:var(--accent);border-color:var(--accent);background:rgba(0,212,255,0.08)}"

Section: Timeline

  css-timeline : Text =
    ".timeline-ruler{height:100%;display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:0.55em;opacity:0.4}"

Section: Status Bar

  css-status : Text =
    ".status{height:28px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;background:var(--surface);border-top:1px solid var(--border);font-size:0.56em;color:var(--dim);flex-shrink:0}" &
    ".status .mode{color:var(--accent);font-weight:600;letter-spacing:0.08em}"

Section: Utility

  css-utility : Text =
    ".clickable{cursor:pointer}"

Section: Full Stylesheet

  spark-stylesheet : Text
  spark-stylesheet =
    css-vars & css-reset & css-header & css-panels & css-search & css-outliner & css-props & css-scene & css-viewport & css-toolbar & css-timeline & css-status & css-utility

