Chapter: Timeline
  cites Spark chapter AnimPlayer

 Timeline UI state: visible frame range, zoom level, playhead
 position, and selected keyframe. Manages the visual representation
 of the animation timeline.

 We say:

Section: Types

  TimelineState = record {
    tl-player : AnimPlayerState,
    tl-view-start : Integer,
    tl-view-end : Integer,
    tl-zoom : Real,
    tl-selected-key : Integer,
    tl-selected-channel : Integer,
    tl-height : Integer
  }

Section: Construction

  timeline-new : AnimPlayerState, Integer -> TimelineState
  timeline-new (player) (height) = TimelineState {
    tl-player = player,
    tl-view-start = 0,
    tl-view-end = player.ap-end-frame + 10,
    tl-zoom = 1.0,
    tl-selected-key = -1,
    tl-selected-channel = -1,
    tl-height = height
  }

Section: Navigation

  timeline-scroll : TimelineState, Integer -> TimelineState
  timeline-scroll (tl) (delta) =
    let new-start = tl-max 0 (tl.tl-view-start + delta)
    in let range = tl.tl-view-end - tl.tl-view-start
    in __record-set (__record-set tl "tl-view-start" new-start) "tl-view-end" (new-start + range)

  timeline-zoom-in : TimelineState -> TimelineState
  timeline-zoom-in (tl) =
    let new-zoom = real-min 4.0 (tl.tl-zoom + 0.2)
    in __record-set tl "tl-zoom" new-zoom

  timeline-zoom-out : TimelineState -> TimelineState
  timeline-zoom-out (tl) =
    let new-zoom = real-max 0.2 (tl.tl-zoom - 0.2)
    in __record-set tl "tl-zoom" new-zoom

  timeline-goto-start : TimelineState -> TimelineState
  timeline-goto-start (tl) =
    __record-set tl "tl-player" (anim-set-frame (tl.tl-player) (tl.tl-player.ap-start-frame))

  timeline-goto-end : TimelineState -> TimelineState
  timeline-goto-end (tl) =
    __record-set tl "tl-player" (anim-set-frame (tl.tl-player) (tl.tl-player.ap-end-frame))

Section: Playback

  timeline-play : TimelineState -> TimelineState
  timeline-play (tl) = __record-set tl "tl-player" (anim-play (tl.tl-player))

  timeline-pause : TimelineState -> TimelineState
  timeline-pause (tl) = __record-set tl "tl-player" (anim-pause (tl.tl-player))

  timeline-stop : TimelineState -> TimelineState
  timeline-stop (tl) = __record-set tl "tl-player" (anim-stop (tl.tl-player))

  timeline-tick : TimelineState -> TimelineState
  timeline-tick (tl) = __record-set tl "tl-player" (anim-tick (tl.tl-player))

Section: Info

  timeline-info : TimelineState -> Text
  timeline-info (tl) = anim-info (tl.tl-player)

Section: Helpers

  tl-min : Integer, Integer -> Integer
  tl-min (a) (b) = if a < b then a else b

  tl-max : Integer, Integer -> Integer
  tl-max (a) (b) = if a > b then a else b

