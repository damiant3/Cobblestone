Chapter: RenderQueue
  cites Game chapter Rasterizer
  cites Spark chapter ExportImage

 Batch render: produces a sequence of framebuffers by advancing
 the animation player one frame at a time and rendering each.
 Used for offline video export.

 We say:

Section: Types

  RenderJob = record {
    rj-start : Integer,
    rj-last : Integer,
    rj-fps : Integer,
    rj-width : Integer,
    rj-height : Integer
  }

  RenderResult = record {
    rr-frames : List ImageExport,
    rr-frame-count : Integer,
    rr-width : Integer,
    rr-height : Integer,
    rr-fps : Integer
  }

Section: Construction

  render-job-new : Integer, Integer, Integer, Integer, Integer -> RenderJob
  render-job-new (start) (last-frame) (fps) (w) (h) = RenderJob {
    rj-start = start,
    rj-last = last-frame,
    rj-fps = fps,
    rj-width = w,
    rj-height = h
  }

Section: Execution

  render-queue-run : RenderJob, (Integer -> Framebuf) -> RenderResult
  render-queue-run (job) (render-fn) =
    let frames = rq-render-loop render-fn (job.rj-start) (job.rj-last) []
    in RenderResult {
      rr-frames = frames,
      rr-frame-count = job.rj-last - job.rj-start + 1,
      rr-width = job.rj-width,
      rr-height = job.rj-height,
      rr-fps = job.rj-fps
    }

  rq-render-loop : (Integer -> Framebuf), Integer, Integer, List ImageExport -> List ImageExport
  rq-render-loop (render-fn) (frame) (last-frame) (acc) =
    if frame > last-frame then acc
    else let fb = render-fn frame
    in let ie = export-framebuf fb
    in rq-render-loop render-fn (frame + 1) last-frame (list-push acc ie)

Section: Info

  render-result-info : RenderResult -> Text
  render-result-info (rr) =
    show (rr.rr-frame-count) & " frames at " & show (rr.rr-width) & "x" & show (rr.rr-height) & " (" & show (rr.rr-fps) & " fps)"

