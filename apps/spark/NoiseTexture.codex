Chapter: NoiseTexture
  cites Spark chapter TextureMap

 We say:

Section: Types

  NoiseKind =
    | NoiseValue
    | NoiseGradient
    | NoiseCellular

  NoiseConfig = record {
    nc-kind : NoiseKind,
    nc-seed : Integer,
    nc-scale : Real,
    nc-octaves : Integer,
    nc-persistence : Real,
    nc-lacunarity : Real
  }

Section: Construction

  noise-config-default : NoiseConfig
  noise-config-default = NoiseConfig {
    nc-kind = NoiseGradient,
    nc-seed = 42,
    nc-scale = 0.1,
    nc-octaves = 4,
    nc-persistence = 0.5,
    nc-lacunarity = 2.0
  }

  noise-config-new : NoiseKind, Integer, Real -> NoiseConfig
  noise-config-new (kind) (seed) (scale) = NoiseConfig {
    nc-kind = kind,
    nc-seed = seed,
    nc-scale = scale,
    nc-octaves = 4,
    nc-persistence = 0.5,
    nc-lacunarity = 2.0
  }

Section: Hash Function

  noise-hash : Integer, Integer, Integer -> Real
  noise-hash (x) (y) (seed) =
    let h = x * 374761393 + y * 668265263 + seed * 1274126177
    in let h2 = h * h * h
    in let abs-h = if h2 < 0 then 0 - h2 else h2
    in let m = abs-h - abs-h / 1000 * 1000
    in real-from-int m / 1000.0

  noise-hash2 : Integer, Integer, Integer -> Real
  noise-hash2 (x) (y) (seed) =
    let h = noise-hash x y seed
    in h * 2.0 - 1.0

Section: Value Noise

  noise-value : Integer, Integer, NoiseConfig -> Real
  noise-value (x) (y) (cfg) =
    let gx = real-from-int x / cfg.nc-scale
    in let gy = real-from-int y / cfg.nc-scale
    in let ix = real-to-int gx
    in let iy = real-to-int gy
    in let fx = gx - real-from-int ix
    in let fy = gy - real-from-int iy
    in let c00 = noise-hash ix iy (cfg.nc-seed)
    in let c10 = noise-hash (ix + 1) iy (cfg.nc-seed)
    in let c01 = noise-hash ix (iy + 1) (cfg.nc-seed)
    in let c11 = noise-hash (ix + 1) (iy + 1) (cfg.nc-seed)
    in let sx = noise-smoothstep fx
    in let sy = noise-smoothstep fy
    in let top = c00 + (c10 - c00) * sx
    in let bot = c01 + (c11 - c01) * sx
    in top + (bot - top) * sy

Section: Gradient Noise

  noise-gradient : Integer, Integer, NoiseConfig -> Real
  noise-gradient (x) (y) (cfg) =
    let gx = real-from-int x / cfg.nc-scale
    in let gy = real-from-int y / cfg.nc-scale
    in let ix = real-to-int gx
    in let iy = real-to-int gy
    in let fx = gx - real-from-int ix
    in let fy = gy - real-from-int iy
    in let d00 = noise-dot-grad ix iy fx fy (cfg.nc-seed)
    in let d10 = noise-dot-grad (ix + 1) iy (fx - 1.0) fy (cfg.nc-seed)
    in let d01 = noise-dot-grad ix (iy + 1) fx (fy - 1.0) (cfg.nc-seed)
    in let d11 = noise-dot-grad (ix + 1) (iy + 1) (fx - 1.0) (fy - 1.0) (cfg.nc-seed)
    in let sx = noise-smoothstep fx
    in let sy = noise-smoothstep fy
    in let top = d00 + (d10 - d00) * sx
    in let bot = d01 + (d11 - d01) * sx
    in let result = top + (bot - top) * sy
    in result / 2.0 + 0.5

  noise-dot-grad : Integer, Integer, Real, Real, Integer -> Real
  noise-dot-grad (ix) (iy) (fx) (fy) (seed) =
    let gx = noise-hash2 ix iy seed
    in let gy = noise-hash2 ix iy (seed + 1)
    in gx * fx + gy * fy

Section: Cellular Noise

  noise-cellular : Integer, Integer, NoiseConfig -> Real
  noise-cellular (x) (y) (cfg) =
    let gx = real-from-int x / cfg.nc-scale
    in let gy = real-from-int y / cfg.nc-scale
    in let ix = real-to-int gx
    in let iy = real-to-int gy
    in let fx = gx - real-from-int ix
    in let fy = gy - real-from-int iy
    in noise-cell-search ix iy fx fy (cfg.nc-seed) 2000.0

  noise-cell-search : Integer, Integer, Real, Real, Integer, Real -> Real
  noise-cell-search (ix) (iy) (fx) (fy) (seed) (min-dist) =
    noise-cell-row ix iy fx fy seed min-dist (-1) 2

  noise-cell-row : Integer, Integer, Real, Real, Integer, Real, Integer, Integer -> Real
  noise-cell-row (ix) (iy) (fx) (fy) (seed) (min-dist) (dy) (max-dy) =
    if dy > max-dy then min-dist
    else let md2 = noise-cell-col ix iy fx fy seed min-dist dy (-1) 2
    in noise-cell-row ix iy fx fy seed md2 (dy + 1) max-dy

  noise-cell-col : Integer, Integer, Real, Real, Integer, Real, Integer, Integer, Integer -> Real
  noise-cell-col (ix) (iy) (fx) (fy) (seed) (min-dist) (dy) (dx) (max-dx) =
    if dx > max-dx then min-dist
    else let cell-x = noise-hash (ix + dx) (iy + dy) seed
    in let cell-y = noise-hash (ix + dx) (iy + dy) (seed + 7)
    in let diff-x = real-from-int dx + cell-x - fx
    in let diff-y = real-from-int dy + cell-y - fy
    in let dist = diff-x * diff-x + diff-y * diff-y
    in let new-min = if dist < min-dist then dist else min-dist
    in noise-cell-col ix iy fx fy seed new-min dy (dx + 1) max-dx

Section: Fractal Brownian Motion

  noise-fbm : Integer, Integer, NoiseConfig -> Real
  noise-fbm (x) (y) (cfg) =
    noise-fbm-loop x y cfg 0 0.0 1.0 (cfg.nc-scale)

  noise-fbm-loop : Integer, Integer, NoiseConfig, Integer, Real, Real, Real -> Real
  noise-fbm-loop (x) (y) (cfg) (octave) (acc) (amp) (freq) =
    if octave >= cfg.nc-octaves then acc
    else let sample-cfg = __record-set cfg "nc-scale" freq
    in let val = when cfg.nc-kind
      is NoiseValue -> noise-value x y sample-cfg
      is NoiseGradient -> noise-gradient x y sample-cfg
      is NoiseCellular -> noise-cellular x y sample-cfg
    in let contribution = val * amp
    in let new-amp = amp * cfg.nc-persistence
    in let new-freq = freq / cfg.nc-lacunarity
    in noise-fbm-loop x y cfg (octave + 1) (acc + contribution) new-amp new-freq

Section: Texture Generation

  noise-to-texture : NoiseConfig, Integer, Integer -> Texture2D
  noise-to-texture (cfg) (w) (h) =
    let pixels = noise-gen-pixels cfg w h 0 []
    in Texture2D {
      tex-width = w,
      tex-height = h,
      tex-pixels = pixels,
      tex-wrap = WrapRepeat,
      tex-filter = FilterBilinear
    }

  noise-gen-pixels : NoiseConfig, Integer, Integer, Integer, List Integer -> List Integer
  noise-gen-pixels (cfg) (w) (h) (i) (acc) =
    if i >= w * h then acc
    else let x = i - i / w * w
    in let y = i / w
    in let val = noise-fbm x y cfg
    in let clamped = noise-clamp-real val 0.0 1.0
    in let gray = real-to-int (clamped * 255.0)
    in let color = gray * 65536 + gray * 256 + gray
    in noise-gen-pixels cfg w h (i + 1) (list-push acc color)

Section: Helpers

  noise-smoothstep : Real -> Real
  noise-smoothstep (t) =
    t * t * (3.0 - 2.0 * t)

  noise-clamp-real : Real, Real, Real -> Real
  noise-clamp-real (v) (lo) (hi) = if v < lo then lo else if v > hi then hi else v

Section: Info

  noise-config-info : NoiseConfig -> Text
  noise-config-info (cfg) =
    let kind = when cfg.nc-kind is NoiseValue -> "value" is NoiseGradient -> "gradient" is NoiseCellular -> "cellular"
    in kind & " scale=" & show (cfg.nc-scale) & " oct=" & show (cfg.nc-octaves) & " seed=" & show (cfg.nc-seed)

