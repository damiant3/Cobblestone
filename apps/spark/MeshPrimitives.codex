Chapter: MeshPrimitives
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Spark chapter Mesh

 Primitive mesh generators: cube, plane, sphere, cylinder, cone,
 torus. All geometry uses fixed-point scale 1000.

 We say:

Section: Cube

  mesh-cube : Integer -> TriMesh
  mesh-cube (size) =
    let h = size / 2
    in let m = tri-mesh-empty
    in let m1 = tri-mesh-add-vert m (vec3-new (-h) (-h) h) (vec2-new 0 0) (vec3-new 0 0 1000)
    in let m2 = tri-mesh-add-vert m1 (vec3-new h (-h) h) (vec2-new 1000 0) (vec3-new 0 0 1000)
    in let m3 = tri-mesh-add-vert m2 (vec3-new h h h) (vec2-new 1000 1000) (vec3-new 0 0 1000)
    in let m4 = tri-mesh-add-vert m3 (vec3-new (-h) h h) (vec2-new 0 1000) (vec3-new 0 0 1000)
    in let m5 = tri-mesh-add-vert m4 (vec3-new h (-h) (-h)) (vec2-new 0 0) (vec3-new 0 0 (-1000))
    in let m6 = tri-mesh-add-vert m5 (vec3-new (-h) (-h) (-h)) (vec2-new 1000 0) (vec3-new 0 0 (-1000))
    in let m7 = tri-mesh-add-vert m6 (vec3-new (-h) h (-h)) (vec2-new 1000 1000) (vec3-new 0 0 (-1000))
    in let m8 = tri-mesh-add-vert m7 (vec3-new h h (-h)) (vec2-new 0 1000) (vec3-new 0 0 (-1000))
    in let m9 = tri-mesh-add-vert m8 (vec3-new (-h) h (-h)) (vec2-new 0 0) (vec3-new 0 1000 0)
    in let m10 = tri-mesh-add-vert m9 (vec3-new (-h) h h) (vec2-new 0 1000) (vec3-new 0 1000 0)
    in let m11 = tri-mesh-add-vert m10 (vec3-new h h h) (vec2-new 1000 1000) (vec3-new 0 1000 0)
    in let m12 = tri-mesh-add-vert m11 (vec3-new h h (-h)) (vec2-new 1000 0) (vec3-new 0 1000 0)
    in let m13 = tri-mesh-add-vert m12 (vec3-new (-h) (-h) h) (vec2-new 0 0) (vec3-new 0 (-1000) 0)
    in let m14 = tri-mesh-add-vert m13 (vec3-new (-h) (-h) (-h)) (vec2-new 0 1000) (vec3-new 0 (-1000) 0)
    in let m15 = tri-mesh-add-vert m14 (vec3-new h (-h) (-h)) (vec2-new 1000 1000) (vec3-new 0 (-1000) 0)
    in let m16 = tri-mesh-add-vert m15 (vec3-new h (-h) h) (vec2-new 1000 0) (vec3-new 0 (-1000) 0)
    in let m17 = tri-mesh-add-vert m16 (vec3-new h (-h) h) (vec2-new 0 0) (vec3-new 1000 0 0)
    in let m18 = tri-mesh-add-vert m17 (vec3-new h (-h) (-h)) (vec2-new 1000 0) (vec3-new 1000 0 0)
    in let m19 = tri-mesh-add-vert m18 (vec3-new h h (-h)) (vec2-new 1000 1000) (vec3-new 1000 0 0)
    in let m20 = tri-mesh-add-vert m19 (vec3-new h h h) (vec2-new 0 1000) (vec3-new 1000 0 0)
    in let m21 = tri-mesh-add-vert m20 (vec3-new (-h) (-h) (-h)) (vec2-new 0 0) (vec3-new (-1000) 0 0)
    in let m22 = tri-mesh-add-vert m21 (vec3-new (-h) (-h) h) (vec2-new 1000 0) (vec3-new (-1000) 0 0)
    in let m23 = tri-mesh-add-vert m22 (vec3-new (-h) h h) (vec2-new 1000 1000) (vec3-new (-1000) 0 0)
    in let m24 = tri-mesh-add-vert m23 (vec3-new (-h) h (-h)) (vec2-new 0 1000) (vec3-new (-1000) 0 0)
    in let f1 = tri-mesh-add-face m24 0 1 2
    in let f2 = tri-mesh-add-face f1 0 2 3
    in let f3 = tri-mesh-add-face f2 4 5 6
    in let f4 = tri-mesh-add-face f3 4 6 7
    in let f5 = tri-mesh-add-face f4 8 9 10
    in let f6 = tri-mesh-add-face f5 8 10 11
    in let f7 = tri-mesh-add-face f6 12 13 14
    in let f8 = tri-mesh-add-face f7 12 14 15
    in let f9 = tri-mesh-add-face f8 16 17 18
    in let f10 = tri-mesh-add-face f9 16 18 19
    in let f11 = tri-mesh-add-face f10 20 21 22
    in tri-mesh-add-face f11 20 22 23

Section: Plane

  mesh-plane : Integer, Integer -> TriMesh
  mesh-plane (width) (depth) =
    let hw = width / 2
    in let hd = depth / 2
    in let up = vec3-new 0 1000 0
    in let m = tri-mesh-empty
    in let m1 = tri-mesh-add-vert m (vec3-new (-hw) 0 (-hd)) (vec2-new 0 0) up
    in let m2 = tri-mesh-add-vert m1 (vec3-new hw 0 (-hd)) (vec2-new 1000 0) up
    in let m3 = tri-mesh-add-vert m2 (vec3-new hw 0 hd) (vec2-new 1000 1000) up
    in let m4 = tri-mesh-add-vert m3 (vec3-new (-hw) 0 hd) (vec2-new 0 1000) up
    in let f1 = tri-mesh-add-face m4 0 1 2
    in tri-mesh-add-face f1 0 2 3

Section: Sphere

  mesh-sphere : Integer, Integer, Integer -> TriMesh
  mesh-sphere (radius) (rings) (sectors) =
    mesh-sphere-verts tri-mesh-empty radius rings sectors 0 0

  mesh-sphere-verts : TriMesh, Integer, Integer, Integer, Integer, Integer -> TriMesh
  mesh-sphere-verts (m) (r) (rings) (sectors) (ring) (sec) =
    if ring > rings then mesh-sphere-faces m rings sectors 0 0
    else if sec > sectors then mesh-sphere-verts m r rings sectors (ring + 1) 0
    else let phi = 3141 * ring / rings
    in let theta = 6283 * sec / sectors
    in let sp = sph-sin-approx phi
    in let cp = sph-cos-approx phi
    in let st = sph-sin-approx theta
    in let ct = sph-cos-approx theta
    in let nx = sp * ct / 1000
    in let ny = cp
    in let nz = sp * st / 1000
    in let pos = vec3-new (r * nx / 1000) (r * ny / 1000) (r * nz / 1000)
    in let uv = vec2-new (sec * 1000 / sectors) (ring * 1000 / rings)
    in let normal = vec3-new nx ny nz
    in mesh-sphere-verts (tri-mesh-add-vert m pos uv normal) r rings sectors ring (sec + 1)

  mesh-sphere-faces : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  mesh-sphere-faces (m) (rings) (sectors) (ring) (sec) =
    if ring >= rings then m
    else if sec >= sectors then mesh-sphere-faces m rings sectors (ring + 1) 0
    else let cols = sectors + 1
    in let cur = ring * cols + sec
    in let next-row = (ring + 1) * cols + sec
    in let m2 = tri-mesh-add-face m cur next-row (cur + 1)
    in let m3 = tri-mesh-add-face m2 (cur + 1) next-row (next-row + 1)
    in mesh-sphere-faces m3 rings sectors ring (sec + 1)

Section: Pyramid

  mesh-pyramid : Integer -> TriMesh
  mesh-pyramid (size) =
    let h = size / 2
    in let m = tri-mesh-empty
    in let m1 = tri-mesh-add-vert m (vec3-new (0 - h) (0 - h) (0 - h)) (vec2-new 0 0) (vec3-new 0 (0 - 1000) 0)
    in let m2 = tri-mesh-add-vert m1 (vec3-new h (0 - h) (0 - h)) (vec2-new 1000 0) (vec3-new 0 (0 - 1000) 0)
    in let m3 = tri-mesh-add-vert m2 (vec3-new h (0 - h) h) (vec2-new 1000 1000) (vec3-new 0 (0 - 1000) 0)
    in let m4 = tri-mesh-add-vert m3 (vec3-new (0 - h) (0 - h) h) (vec2-new 0 1000) (vec3-new 0 (0 - 1000) 0)
    in let m5 = tri-mesh-add-vert m4 (vec3-new 0 h 0) (vec2-new 500 500) (vec3-new 0 707 707)
    in let m6 = tri-mesh-add-vert m5 (vec3-new 0 h 0) (vec2-new 500 500) (vec3-new 707 707 0)
    in let m7 = tri-mesh-add-vert m6 (vec3-new 0 h 0) (vec2-new 500 500) (vec3-new 0 707 (0 - 707))
    in let m8 = tri-mesh-add-vert m7 (vec3-new 0 h 0) (vec2-new 500 500) (vec3-new (0 - 707) 707 0)
    in let f1 = tri-mesh-add-face m8 0 1 2
    in let f2 = tri-mesh-add-face f1 0 2 3
    in let f3 = tri-mesh-add-face f2 3 2 4
    in let f4 = tri-mesh-add-face f3 2 1 5
    in let f5 = tri-mesh-add-face f4 1 0 6
    in tri-mesh-add-face f5 0 3 7

Section: Cylinder

  mesh-cylinder : Integer, Integer, Integer -> TriMesh
  mesh-cylinder (radius) (height) (segments) =
    let hh = height / 2
    in cyl-build-segments tri-mesh-empty radius hh segments 0

  cyl-build-segments : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  cyl-build-segments (m) (r) (hh) (segs) (i) =
    if i >= segs then cyl-build-caps m r hh segs 0
    else let a0 = i * 6283 / segs
    in let a1 = (i + 1) * 6283 / segs
    in let c0 = sph-cos-approx a0 in let s0 = sph-sin-approx a0
    in let c1 = sph-cos-approx a1 in let s1 = sph-sin-approx a1
    in let x0 = r * c0 / 1000 in let z0 = r * s0 / 1000
    in let x1 = r * c1 / 1000 in let z1 = r * s1 / 1000
    in let nx0 = c0 in let nz0 = s0
    in let nx1 = c1 in let nz1 = s1
    in let base = m.tm-vert-count
    in let uv0 = vec2-new (i * 1000 / segs) 0
    in let uv1 = vec2-new ((i + 1) * 1000 / segs) 0
    in let uv2 = vec2-new ((i + 1) * 1000 / segs) 1000
    in let uv3 = vec2-new (i * 1000 / segs) 1000
    in let m1 = tri-mesh-add-vert m (vec3-new x0 (0 - hh) z0) uv0 (vec3-new nx0 0 nz0)
    in let m2 = tri-mesh-add-vert m1 (vec3-new x1 (0 - hh) z1) uv1 (vec3-new nx1 0 nz1)
    in let m3 = tri-mesh-add-vert m2 (vec3-new x1 hh z1) uv2 (vec3-new nx1 0 nz1)
    in let m4 = tri-mesh-add-vert m3 (vec3-new x0 hh z0) uv3 (vec3-new nx0 0 nz0)
    in let m5 = tri-mesh-add-face m4 base (base + 1) (base + 2)
    in let m6 = tri-mesh-add-face m5 base (base + 2) (base + 3)
    in cyl-build-segments m6 r hh segs (i + 1)

  cyl-build-caps : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  cyl-build-caps (m) (r) (hh) (segs) (i) =
    if i >= segs then m
    else let a0 = i * 6283 / segs
    in let a1 = (i + 1) * 6283 / segs
    in let c0 = sph-cos-approx a0 in let s0 = sph-sin-approx a0
    in let c1 = sph-cos-approx a1 in let s1 = sph-sin-approx a1
    in let x0 = r * c0 / 1000 in let z0 = r * s0 / 1000
    in let x1 = r * c1 / 1000 in let z1 = r * s1 / 1000
    in let base = m.tm-vert-count
    in let up = vec3-new 0 1000 0
    in let dn = vec3-new 0 (0 - 1000) 0
    in let uv0 = vec2-new 500 500
    in let m1 = tri-mesh-add-vert m (vec3-new 0 hh 0) uv0 up
    in let m2 = tri-mesh-add-vert m1 (vec3-new x0 hh z0) uv0 up
    in let m3 = tri-mesh-add-vert m2 (vec3-new x1 hh z1) uv0 up
    in let m4 = tri-mesh-add-face m3 base (base + 1) (base + 2)
    in let m5 = tri-mesh-add-vert m4 (vec3-new 0 (0 - hh) 0) uv0 dn
    in let m6 = tri-mesh-add-vert m5 (vec3-new x1 (0 - hh) z1) uv0 dn
    in let m7 = tri-mesh-add-vert m6 (vec3-new x0 (0 - hh) z0) uv0 dn
    in let m8 = tri-mesh-add-face m7 (base + 3) (base + 4) (base + 5)
    in cyl-build-caps m8 r hh segs (i + 1)

Section: Cone

  mesh-cone : Integer, Integer, Integer -> TriMesh
  mesh-cone (radius) (height) (segments) =
    let hh = height / 2
    in cone-build-segments tri-mesh-empty radius hh segments 0

  cone-build-segments : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  cone-build-segments (m) (r) (hh) (segs) (i) =
    if i >= segs then cone-build-base m r hh segs 0
    else let a0 = i * 6283 / segs
    in let a1 = (i + 1) * 6283 / segs
    in let c0 = sph-cos-approx a0 in let s0 = sph-sin-approx a0
    in let c1 = sph-cos-approx a1 in let s1 = sph-sin-approx a1
    in let x0 = r * c0 / 1000 in let z0 = r * s0 / 1000
    in let x1 = r * c1 / 1000 in let z1 = r * s1 / 1000
    in let base = m.tm-vert-count
    in let slope = 707
    in let uv0 = vec2-new 500 0
    in let m1 = tri-mesh-add-vert m (vec3-new 0 hh 0) uv0 (vec3-new 0 slope 0)
    in let m2 = tri-mesh-add-vert m1 (vec3-new x0 (0 - hh) z0) uv0 (vec3-new c0 slope s0)
    in let m3 = tri-mesh-add-vert m2 (vec3-new x1 (0 - hh) z1) uv0 (vec3-new c1 slope s1)
    in let m4 = tri-mesh-add-face m3 base (base + 1) (base + 2)
    in cone-build-segments m4 r hh segs (i + 1)

  cone-build-base : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  cone-build-base (m) (r) (hh) (segs) (i) =
    if i >= segs then m
    else let a0 = i * 6283 / segs
    in let a1 = (i + 1) * 6283 / segs
    in let c0 = sph-cos-approx a0 in let s0 = sph-sin-approx a0
    in let c1 = sph-cos-approx a1 in let s1 = sph-sin-approx a1
    in let x0 = r * c0 / 1000 in let z0 = r * s0 / 1000
    in let x1 = r * c1 / 1000 in let z1 = r * s1 / 1000
    in let base = m.tm-vert-count
    in let dn = vec3-new 0 (0 - 1000) 0
    in let uv0 = vec2-new 500 500
    in let m1 = tri-mesh-add-vert m (vec3-new 0 (0 - hh) 0) uv0 dn
    in let m2 = tri-mesh-add-vert m1 (vec3-new x1 (0 - hh) z1) uv0 dn
    in let m3 = tri-mesh-add-vert m2 (vec3-new x0 (0 - hh) z0) uv0 dn
    in let m4 = tri-mesh-add-face m3 base (base + 1) (base + 2)
    in cone-build-base m4 r hh segs (i + 1)

Section: Torus

  mesh-torus : Integer, Integer, Integer, Integer -> TriMesh
  mesh-torus (major-r) (minor-r) (major-segs) (minor-segs) =
    let m = torus-build-verts tri-mesh-empty major-r minor-r major-segs minor-segs 0 0
    in torus-build-faces m major-segs minor-segs 0 0

  torus-build-verts : TriMesh, Integer, Integer, Integer, Integer, Integer, Integer -> TriMesh
  torus-build-verts (m) (mr) (mnr) (ms) (mns) (i) (j) =
    if i >= ms then m
    else if j >= mns then torus-build-verts m mr mnr ms mns (i + 1) 0
    else let theta = i * 6283 / ms
    in let phi = j * 6283 / mns
    in let ct = sph-cos-approx theta in let st = sph-sin-approx theta
    in let cp = sph-cos-approx phi in let sp = sph-sin-approx phi
    in let cx = (mr + mnr * cp / 1000) * ct / 1000
    in let cy = mnr * sp / 1000
    in let cz = (mr + mnr * cp / 1000) * st / 1000
    in let nx = cp * ct / 1000
    in let ny = sp
    in let nz = cp * st / 1000
    in let uv = vec2-new (i * 1000 / ms) (j * 1000 / mns)
    in torus-build-verts (tri-mesh-add-vert m (vec3-new cx cy cz) uv (vec3-new nx ny nz)) mr mnr ms mns i (j + 1)

  torus-build-faces : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  torus-build-faces (m) (ms) (mns) (i) (j) =
    if i >= ms then m
    else if j >= mns then torus-build-faces m ms mns (i + 1) 0
    else let ni = if i + 1 >= ms then 0 else i + 1
    in let nj = if j + 1 >= mns then 0 else j + 1
    in let a2 = i * mns + j
    in let b2 = ni * mns + j
    in let c = ni * mns + nj
    in let d = i * mns + nj
    in let m2 = tri-mesh-add-face m a2 b2 c
    in let m3 = tri-mesh-add-face m2 a2 c d
    in torus-build-faces m3 ms mns i (j + 1)

Section: Trig Helpers

  sph-sin-approx : Integer -> Integer
  sph-sin-approx (milli-rad) =
    let x = milli-rad
    in let x3 = x * x / 1000 * x / 1000
    in let x5 = x3 * x / 1000 * x / 1000
    in x - x3 / 6 + x5 / 120

  sph-cos-approx : Integer -> Integer
  sph-cos-approx (milli-rad) =
    let x2 = milli-rad * milli-rad / 1000
    in let x4 = x2 * x2 / 1000
    in 1000 - x2 / 2 + x4 / 24

