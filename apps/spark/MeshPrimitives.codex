Chapter: MeshPrimitives
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Spark chapter Mesh

 Primitive mesh generators: cube, plane, sphere, cylinder, cone,
 torus. All geometry uses fixed-point scale 1000.

 We say:

Section: Cube

  mesh-cube : Integer -> TriMesh
  mesh-cube (size) =
    let h = size / 2
    in let m = tri-mesh-empty
    in let m1 = tri-mesh-add-vert m (vec3-new (-h) (-h) h) (vec2-new 0 0) (vec3-new 0 0 1000)
    in let m2 = tri-mesh-add-vert m1 (vec3-new h (-h) h) (vec2-new 1000 0) (vec3-new 0 0 1000)
    in let m3 = tri-mesh-add-vert m2 (vec3-new h h h) (vec2-new 1000 1000) (vec3-new 0 0 1000)
    in let m4 = tri-mesh-add-vert m3 (vec3-new (-h) h h) (vec2-new 0 1000) (vec3-new 0 0 1000)
    in let m5 = tri-mesh-add-vert m4 (vec3-new h (-h) (-h)) (vec2-new 0 0) (vec3-new 0 0 (-1000))
    in let m6 = tri-mesh-add-vert m5 (vec3-new (-h) (-h) (-h)) (vec2-new 1000 0) (vec3-new 0 0 (-1000))
    in let m7 = tri-mesh-add-vert m6 (vec3-new (-h) h (-h)) (vec2-new 1000 1000) (vec3-new 0 0 (-1000))
    in let m8 = tri-mesh-add-vert m7 (vec3-new h h (-h)) (vec2-new 0 1000) (vec3-new 0 0 (-1000))
    in let m9 = tri-mesh-add-vert m8 (vec3-new (-h) h (-h)) (vec2-new 0 0) (vec3-new 0 1000 0)
    in let m10 = tri-mesh-add-vert m9 (vec3-new (-h) h h) (vec2-new 0 1000) (vec3-new 0 1000 0)
    in let m11 = tri-mesh-add-vert m10 (vec3-new h h h) (vec2-new 1000 1000) (vec3-new 0 1000 0)
    in let m12 = tri-mesh-add-vert m11 (vec3-new h h (-h)) (vec2-new 1000 0) (vec3-new 0 1000 0)
    in let m13 = tri-mesh-add-vert m12 (vec3-new (-h) (-h) h) (vec2-new 0 0) (vec3-new 0 (-1000) 0)
    in let m14 = tri-mesh-add-vert m13 (vec3-new (-h) (-h) (-h)) (vec2-new 0 1000) (vec3-new 0 (-1000) 0)
    in let m15 = tri-mesh-add-vert m14 (vec3-new h (-h) (-h)) (vec2-new 1000 1000) (vec3-new 0 (-1000) 0)
    in let m16 = tri-mesh-add-vert m15 (vec3-new h (-h) h) (vec2-new 1000 0) (vec3-new 0 (-1000) 0)
    in let m17 = tri-mesh-add-vert m16 (vec3-new h (-h) h) (vec2-new 0 0) (vec3-new 1000 0 0)
    in let m18 = tri-mesh-add-vert m17 (vec3-new h (-h) (-h)) (vec2-new 1000 0) (vec3-new 1000 0 0)
    in let m19 = tri-mesh-add-vert m18 (vec3-new h h (-h)) (vec2-new 1000 1000) (vec3-new 1000 0 0)
    in let m20 = tri-mesh-add-vert m19 (vec3-new h h h) (vec2-new 0 1000) (vec3-new 1000 0 0)
    in let m21 = tri-mesh-add-vert m20 (vec3-new (-h) (-h) (-h)) (vec2-new 0 0) (vec3-new (-1000) 0 0)
    in let m22 = tri-mesh-add-vert m21 (vec3-new (-h) (-h) h) (vec2-new 1000 0) (vec3-new (-1000) 0 0)
    in let m23 = tri-mesh-add-vert m22 (vec3-new (-h) h h) (vec2-new 1000 1000) (vec3-new (-1000) 0 0)
    in let m24 = tri-mesh-add-vert m23 (vec3-new (-h) h (-h)) (vec2-new 0 1000) (vec3-new (-1000) 0 0)
    in let f1 = tri-mesh-add-face m24 0 1 2
    in let f2 = tri-mesh-add-face f1 0 2 3
    in let f3 = tri-mesh-add-face f2 4 5 6
    in let f4 = tri-mesh-add-face f3 4 6 7
    in let f5 = tri-mesh-add-face f4 8 9 10
    in let f6 = tri-mesh-add-face f5 8 10 11
    in let f7 = tri-mesh-add-face f6 12 13 14
    in let f8 = tri-mesh-add-face f7 12 14 15
    in let f9 = tri-mesh-add-face f8 16 17 18
    in let f10 = tri-mesh-add-face f9 16 18 19
    in let f11 = tri-mesh-add-face f10 20 21 22
    in tri-mesh-add-face f11 20 22 23

Section: Plane

  mesh-plane : Integer, Integer -> TriMesh
  mesh-plane (width) (depth) =
    let hw = width / 2
    in let hd = depth / 2
    in let up = vec3-new 0 1000 0
    in let m = tri-mesh-empty
    in let m1 = tri-mesh-add-vert m (vec3-new (-hw) 0 (-hd)) (vec2-new 0 0) up
    in let m2 = tri-mesh-add-vert m1 (vec3-new hw 0 (-hd)) (vec2-new 1000 0) up
    in let m3 = tri-mesh-add-vert m2 (vec3-new hw 0 hd) (vec2-new 1000 1000) up
    in let m4 = tri-mesh-add-vert m3 (vec3-new (-hw) 0 hd) (vec2-new 0 1000) up
    in let f1 = tri-mesh-add-face m4 0 1 2
    in tri-mesh-add-face f1 0 2 3

Section: Sphere

  mesh-sphere : Integer, Integer, Integer -> TriMesh
  mesh-sphere (radius) (rings) (sectors) =
    mesh-sphere-verts tri-mesh-empty radius rings sectors 0 0

  mesh-sphere-verts : TriMesh, Integer, Integer, Integer, Integer, Integer -> TriMesh
  mesh-sphere-verts (m) (r) (rings) (sectors) (ring) (sec) =
    if ring > rings then mesh-sphere-faces m rings sectors 0 0
    else if sec > sectors then mesh-sphere-verts m r rings sectors (ring + 1) 0
    else let phi = 3141 * ring / rings
    in let theta = 6283 * sec / sectors
    in let sp = sph-sin-approx phi
    in let cp = sph-cos-approx phi
    in let st = sph-sin-approx theta
    in let ct = sph-cos-approx theta
    in let nx = sp * ct / 1000
    in let ny = cp
    in let nz = sp * st / 1000
    in let pos = vec3-new (r * nx / 1000) (r * ny / 1000) (r * nz / 1000)
    in let uv = vec2-new (sec * 1000 / sectors) (ring * 1000 / rings)
    in let normal = vec3-new nx ny nz
    in mesh-sphere-verts (tri-mesh-add-vert m pos uv normal) r rings sectors ring (sec + 1)

  mesh-sphere-faces : TriMesh, Integer, Integer, Integer, Integer -> TriMesh
  mesh-sphere-faces (m) (rings) (sectors) (ring) (sec) =
    if ring >= rings then m
    else if sec >= sectors then mesh-sphere-faces m rings sectors (ring + 1) 0
    else let cols = sectors + 1
    in let cur = ring * cols + sec
    in let next-row = (ring + 1) * cols + sec
    in let m2 = tri-mesh-add-face m cur next-row (cur + 1)
    in let m3 = tri-mesh-add-face m2 (cur + 1) next-row (next-row + 1)
    in mesh-sphere-faces m3 rings sectors ring (sec + 1)

Section: Trig Helpers

  sph-sin-approx : Integer -> Integer
  sph-sin-approx (milli-rad) =
    let x = milli-rad
    in let x3 = x * x / 1000 * x / 1000
    in let x5 = x3 * x / 1000 * x / 1000
    in x - x3 / 6 + x5 / 120

  sph-cos-approx : Integer -> Integer
  sph-cos-approx (milli-rad) =
    let x2 = milli-rad * milli-rad / 1000
    in let x4 = x2 * x2 / 1000
    in 1000 - x2 / 2 + x4 / 24

