Chapter: FxChain

 Per-track effects chain. Wraps effect types (delay, reverb,
 distortion, compressor, EQ, chorus) in a chain that processes
 audio samples sequentially.

 We say:

Section: Types

  FxType =
    | FxDelay (Integer) (Integer)
    | FxReverb (Integer)
    | FxDistortion (Integer)
    | FxCompressor (Integer) (Integer)
    | FxEq3 (Integer) (Integer) (Integer)
    | FxChorus (Integer)
    | FxBypass

  FxSlot = record {
    fxs-name : Text,
    fxs-type : FxType,
    fxs-wet : Integer,
    fxs-enabled : Boolean
  }

  FxChainState = record {
    fc-slots : List FxSlot,
    fc-count : Integer
  }

Section: Construction

  fx-chain-new : FxChainState
  fx-chain-new = FxChainState { fc-slots = [], fc-count = 0 }

  fx-slot-new : Text, FxType, Integer -> FxSlot
  fx-slot-new (name) (fx-type) (wet) = FxSlot {
    fxs-name = name,
    fxs-type = fx-type,
    fxs-wet = wet,
    fxs-enabled = True
  }

  fx-chain-add : FxChainState, FxSlot -> FxChainState
  fx-chain-add (chain) (slot) = FxChainState {
    fc-slots = list-push (chain.fc-slots) slot,
    fc-count = chain.fc-count + 1
  }

Section: Presets

  fx-preset-delay : FxSlot
  fx-preset-delay = fx-slot-new "Delay" (FxDelay 11025 500) 400

  fx-preset-reverb : FxSlot
  fx-preset-reverb = fx-slot-new "Reverb" (FxReverb 800) 300

  fx-preset-distortion : FxSlot
  fx-preset-distortion = fx-slot-new "Distortion" (FxDistortion 700) 500

  fx-preset-compressor : FxSlot
  fx-preset-compressor = fx-slot-new "Compressor" (FxCompressor 500 4000) 1000

Section: Info

  fx-chain-info : FxChainState -> Text
  fx-chain-info (chain) = show (chain.fc-count) & " effects"

  fx-slot-info : FxSlot -> Text
  fx-slot-info (slot) =
    let enabled-str = if slot.fxs-enabled then "on" else "off"
    in slot.fxs-name & " (" & enabled-str & ", wet=" & show (slot.fxs-wet) & ")"

