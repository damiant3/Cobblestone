Chapter: FxChain

 We say:

Section: Types

  FxType =
    | FxDelay (Integer) (Real)
    | FxReverb (Real)
    | FxDistortion (Real)
    | FxCompressor (Real) (Real)
    | FxEq3 (Real) (Real) (Real)
    | FxChorus (Real)
    | FxBypass

  FxSlot = record {
    fxs-name : Text,
    fxs-type : FxType,
    fxs-wet : Real,
    fxs-enabled : Boolean
  }

  FxChainState = record {
    fc-slots : List FxSlot,
    fc-count : Integer
  }

Section: Construction

  fx-chain-new : FxChainState
  fx-chain-new = FxChainState { fc-slots = [], fc-count = 0 }

  fx-slot-new : Text, FxType, Real -> FxSlot
  fx-slot-new (name) (fx-type) (wet) = FxSlot {
    fxs-name = name,
    fxs-type = fx-type,
    fxs-wet = wet,
    fxs-enabled = True
  }

  fx-chain-add : FxChainState, FxSlot -> FxChainState
  fx-chain-add (chain) (slot) = FxChainState {
    fc-slots = list-push (chain.fc-slots) slot,
    fc-count = chain.fc-count + 1
  }

Section: Presets

  fx-preset-delay : FxSlot
  fx-preset-delay = fx-slot-new "Delay" (FxDelay 11025 0.5) 0.4

  fx-preset-reverb : FxSlot
  fx-preset-reverb = fx-slot-new "Reverb" (FxReverb 0.8) 0.3

  fx-preset-distortion : FxSlot
  fx-preset-distortion = fx-slot-new "Distortion" (FxDistortion 0.7) 0.5

  fx-preset-compressor : FxSlot
  fx-preset-compressor = fx-slot-new "Compressor" (FxCompressor 0.5 4.0) 1.0

Section: Info

  fx-chain-info : FxChainState -> Text
  fx-chain-info (chain) = show (chain.fc-count) & " effects"

  fx-slot-info : FxSlot -> Text
  fx-slot-info (slot) =
    let enabled-str = if slot.fxs-enabled then "on" else "off"
    in slot.fxs-name & " (" & enabled-str & ", wet=" & show (slot.fxs-wet) & ")"

