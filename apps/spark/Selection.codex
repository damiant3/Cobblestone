Chapter: Selection

 Unified selection model for Spark. Supports selecting objects,
 vertices, faces, edges, screen regions, and time ranges across
 all editor modes.

 We say:

Section: Types

  SelectionKind =
    | SelNone
    | SelObject (Integer)
    | SelVertex (Integer) (Integer)
    | SelFace (Integer) (Integer)
    | SelRegion (Integer) (Integer) (Integer) (Integer)

  SelectionState = record {
    sel-items : List SelectionKind,
    sel-count : Integer
  }

Section: Construction

  selection-empty : SelectionState
  selection-empty = SelectionState { sel-items = [], sel-count = 0 }

  selection-single : SelectionKind -> SelectionState
  selection-single (kind) = SelectionState { sel-items = [kind], sel-count = 1 }

Section: Operations

  selection-add : SelectionState, SelectionKind -> SelectionState
  selection-add (s) (kind) = SelectionState {
    sel-items = list-push (s.sel-items) kind,
    sel-count = s.sel-count + 1
  }

  selection-clear : SelectionState -> SelectionState
  selection-clear (s) = selection-empty

  selection-has-any : SelectionState -> Boolean
  selection-has-any (s) = s.sel-count > 0

  selection-first : SelectionState -> SelectionKind
  selection-first (s) = if s.sel-count == 0 then SelNone else list-at (s.sel-items) 0

