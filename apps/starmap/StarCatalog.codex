Section: Full Catalog Assembly

  catalog-count-stars : Integer = 50
  catalog-count-messier : Integer = 22
  catalog-count-galaxies : Integer = 8

  catalog-all : List CelestialObj
  catalog-all = catalog-stars

  catalog-total : Integer
  catalog-total = catalog-count-stars + catalog-count-messier + catalog-count-galaxies

  catalog-get : List CelestialObj, Integer -> CelestialObj
  catalog-get (catalog) (idx) = list-at catalog idx

  catalog-search : List CelestialObj, Text, Integer, Integer, List CelestialObj -> List CelestialObj
  catalog-search (catalog) (query) (i) (n) (acc) =
    if i >= n then acc
    else let obj = list-at catalog i
    in if text-contains (obj.co-name) query then catalog-search catalog query (i + 1) n (list-push acc obj)
    else if text-contains (obj.co-constellation) query then catalog-search catalog query (i + 1) n (list-push acc obj)
    else catalog-search catalog query (i + 1) n acc

