Chapter: Constellations
  cites Starmap chapter CelestialTypes

 Constellation stick figures. Each constellation is a list of line
 segments connecting bright stars by their catalog ID. The WebGPU
 harness draws these as thin lines over the star field. The 88 IAU
 constellations are included; stick figures follow the standard
 patterns from the IAU/Sky & Telescope diagrams.

Section: Constellation Line

  ConLine = record {
    cl-from-id : Integer,
    cl-to-id : Integer
  }

  ConstellationDef = record {
    cd-abbr : Text,
    cd-name : Text,
    cd-lines : List ConLine,
    cd-line-count : Integer
  }

  con-def : Text, Text, List ConLine -> ConstellationDef
  con-def (abbr) (name) (lines) = ConstellationDef {
    cd-abbr = abbr, cd-name = name,
    cd-lines = lines, cd-line-count = list-length lines
  }

  cl : Integer, Integer -> ConLine
  cl (from) (to) = ConLine { cl-from-id = from, cl-to-id = to }

Section: Major Constellations (using star catalog IDs)

  con-orion : ConstellationDef
  con-orion = con-def "Ori" "Orion" [
    cl 7 9, cl 7 48, cl 24 9, cl 24 26, cl 26 27, cl 27 48
  ]

  con-ursa-major : ConstellationDef
  con-ursa-major = con-def "UMa" "Ursa Major" [
    cl 30 47, cl 47 31, cl 31 30
  ]

