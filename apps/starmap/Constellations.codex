  ]

  con-crux : ConstellationDef
  con-crux = con-def "Cru" "Crux" [
    cl 13 20
  ]

Section: All Constellations

  all-constellations : List ConstellationDef
  all-constellations = [
    con-orion, con-ursa-major, con-canis-major,
    con-lyra, con-aquila, con-cygnus,
    con-gemini, con-taurus, con-scorpius,
    con-leo, con-virgo, con-centaurus, con-crux
  ]

  constellation-count : Integer = 13

