Chapter: CelestialTypes

 Type system for celestial objects. Every object in the star map has
 a type, position in 3D space (parsecs from Sol), visual magnitude,
 absolute magnitude, spectral classification, and optional name.
 Coordinates use the galactic frame: x toward galactic center,
 y toward galactic rotation, z toward galactic north pole.

 Positions are fixed-point scaled by 1000 (1 unit = 1 parsec).
 Colors derive from B-V color index (also scaled 1000).

Section: Object Types

  CelestialKind =
    | CkStar
    | CkBinaryStar
    | CkGlobularCluster
    | CkOpenCluster
    | CkPlanetaryNebula
    | CkDiffuseNebula
    | CkGalaxy
    | CkQuasar
    | CkPulsar
    | CkBlackHole
    | CkPlanet
    | CkMoon
    | CkAsteroid
    | CkComet

  ck-label : CelestialKind -> Text
  ck-label (k) = when k
    is CkStar -> "Star"
    is CkBinaryStar -> "Binary Star"
    is CkGlobularCluster -> "Globular Cluster"
    is CkOpenCluster -> "Open Cluster"
    is CkPlanetaryNebula -> "Planetary Nebula"
    is CkDiffuseNebula -> "Diffuse Nebula"
    is CkGalaxy -> "Galaxy"
    is CkQuasar -> "Quasar"
    is CkPulsar -> "Pulsar"
    is CkBlackHole -> "Black Hole"
    is CkPlanet -> "Planet"
    is CkMoon -> "Moon"
    is CkAsteroid -> "Asteroid"
    is CkComet -> "Comet"

  ck-icon : CelestialKind -> Text
  ck-icon (k) = when k
    is CkStar -> "*"
    is CkBinaryStar -> "**"
    is CkGlobularCluster -> "(+)"
    is CkOpenCluster -> "(*)"
    is CkPlanetaryNebula -> "(o)"
    is CkDiffuseNebula -> "~"
    is CkGalaxy -> "@"
    is CkQuasar -> "!"
    is CkPulsar -> "^"
    is CkBlackHole -> "O"
    is CkPlanet -> "o"
    is CkMoon -> "."
    is CkAsteroid -> ","
    is CkComet -> ">"

Section: Spectral Classification

  SpectralClass =
    | SpO
    | SpB
    | SpA
    | SpF
    | SpG
    | SpK
    | SpM
    | SpL
    | SpT
    | SpY
    | SpW
    | SpUnknown

  sp-label : SpectralClass -> Text
  sp-label (s) = when s
    is SpO -> "O"
    is SpB -> "B"
    is SpA -> "A"
    is SpF -> "F"
    is SpG -> "G"
    is SpK -> "K"
    is SpM -> "M"
    is SpL -> "L"
    is SpT -> "T"
    is SpY -> "Y"
    is SpW -> "W"
    is SpUnknown -> "?"

Section: Color from B-V Index

  bv-to-rgb : Integer -> Integer
  bv-to-rgb (bv) =
    if bv < -200 then 10092543
    else if bv < -50 then 11206655
    else if bv < 100 then 13421823
    else if bv < 300 then 16316671
    else if bv < 500 then 16777139
    else if bv < 800 then 16764057
    else if bv < 1200 then 16746496
    else if bv < 1600 then 16727040
    else 16711680

  bv-to-r : Integer -> Integer
  bv-to-r (bv) = bv-to-rgb bv / 65536

  bv-to-g : Integer -> Integer
  bv-to-g (bv) = bv-to-rgb bv / 256 - bv-to-r bv * 256

  bv-to-b : Integer -> Integer
  bv-to-b (bv) = bv-to-rgb bv - (bv-to-rgb bv / 256) * 256

Section: Celestial Object

  CelestialObj = record {
    co-id : Integer,
    co-name : Text,
    co-kind : CelestialKind,
    co-spectral : SpectralClass,
    co-x : Integer,
    co-y : Integer,
    co-z : Integer,
    co-mag : Integer,
    co-abs-mag : Integer,
    co-bv : Integer,
    co-dist : Integer,
    co-ra : Integer,
    co-dec : Integer,
    co-radius : Integer,
    co-luminosity : Integer,
    co-constellation : Text,
    co-catalog-id : Text,
    co-description : Text
  }

  co-new : Integer, Text, CelestialKind -> CelestialObj
  co-new (id) (name) (kind) = CelestialObj {
    co-id = id, co-name = name, co-kind = kind,
    co-spectral = SpUnknown,
    co-x = 0, co-y = 0, co-z = 0,
    co-mag = 0, co-abs-mag = 0, co-bv = 0,
    co-dist = 0, co-ra = 0, co-dec = 0,
    co-radius = 1000, co-luminosity = 1000,
    co-constellation = "", co-catalog-id = "",
    co-description = ""
  }

  co-set-pos : CelestialObj, Integer, Integer, Integer -> CelestialObj
  co-set-pos (o) (x) (y) (z) =
    __record-set (__record-set (__record-set o "co-x" x) "co-y" y) "co-z" z

  co-set-mag : CelestialObj, Integer, Integer -> CelestialObj
  co-set-mag (o) (mag) (abs-mag) =
    __record-set (__record-set o "co-mag" mag) "co-abs-mag" abs-mag

  co-set-color : CelestialObj, Integer, SpectralClass -> CelestialObj
  co-set-color (o) (bv) (sp) =
    __record-set (__record-set o "co-bv" bv) "co-spectral" sp

  co-set-dist : CelestialObj, Integer -> CelestialObj
  co-set-dist (o) (d) = __record-set o "co-dist" d

  co-set-constellation : CelestialObj, Text -> CelestialObj
  co-set-constellation (o) (c) = __record-set o "co-constellation" c

  co-set-catalog : CelestialObj, Text -> CelestialObj
  co-set-catalog (o) (c) = __record-set o "co-catalog-id" c

  co-set-desc : CelestialObj, Text -> CelestialObj
  co-set-desc (o) (d) = __record-set o "co-description" d

  co-screen-size : CelestialObj, Integer -> Integer
  co-screen-size (o) (cam-dist) =
    let raw-mag = o.co-mag
    in if raw-mag < -1000 then 8
    else if raw-mag < 0 then 6
    else if raw-mag < 1000 then 5
    else if raw-mag < 2000 then 4
    else if raw-mag < 3000 then 3
    else if raw-mag < 4000 then 2
    else 1

Section: Distance Formatting

  format-dist-ly : Integer -> Text
  format-dist-ly (parsecs-x1000) =
    let ly = parsecs-x1000 * 3262 / 1000
    in if ly > 1000000000 then show (ly / 1000000000) & " Gly"
    else if ly > 1000000 then show (ly / 1000000) & " Mly"
    else if ly > 1000 then show (ly / 1000) & " kly"
    else show ly & " ly"

  format-dist-pc : Integer -> Text
  format-dist-pc (parsecs-x1000) =
    if parsecs-x1000 > 1000000000 then show (parsecs-x1000 / 1000000000) & " Gpc"
    else if parsecs-x1000 > 1000000 then show (parsecs-x1000 / 1000000) & " Mpc"
    else if parsecs-x1000 > 1000 then show (parsecs-x1000 / 1000) & " kpc"
    else show parsecs-x1000 & " pc"

