Chapter: CompliancePage
  cites Site chapter SiteTheme

 EU CRA compliance as a build artifact. Every build emits signed,
 content-addressed evidence mapping regulatory requirements to
 compiler-enforced guarantees. Not a consultancy deliverable &mdash;
 a build output.

 We say:

Section: CSS

  compliance-extra-css : Text
  compliance-extra-css =
    ".compliance{max-width:1100px;margin:0 auto;padding:0 24px}"
    & ".hero-sub>.wk-label{display:inline}"
    & ".hero-sub>.em-text{display:inline;font-style:italic;color:#d4a017}"
    & ".hero-sub>.em-text>.wk-label{display:inline}"
    & ".problem-list{max-width:700px;margin:0 auto}"
    & ".problem-list>.wk-label,.problem-list>.problem-item{padding:12px 0;font-size:15px;color:#c8c8d8;line-height:1.6;border-bottom:1px solid #1e1e2e;padding-left:20px;position:relative}"
    & ".problem-list>.wk-label::before,.problem-list>.problem-item::before{content:'';display:inline-block;width:6px;height:6px;background:#EC4D30;border-radius:50%;position:absolute;left:0;top:18px}"
    & ".problem-list>:last-child{border-bottom:none}"
    & ".problem-list>.problem-item>.wk-label{display:inline}"
    & ".problem-list .hl-text{display:inline;color:#EC4D30;font-weight:600}"
    & ".problem-list .hl-text>.wk-label{display:inline}"
    & ".problem-list .dt-text{display:inline;color:#d4a017;font-weight:600}"
    & ".problem-list .dt-text>.wk-label{display:inline}"
    & ".problem-list .strong-text{display:inline;font-weight:bold}"
    & ".problem-list .strong-text>.wk-label{display:inline}"
    & ".problem-list .em-text{display:inline;font-style:italic}"
    & ".problem-list .em-text>.wk-label{display:inline}"
    & ".pipeline{max-width:800px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;padding:32px 0}"
    & ".pipe-step{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:10px;padding:16px 20px;text-align:center;min-width:120px}"
    & ".pipe-step>.wk-label:first-child{font-size:24px;margin-bottom:6px}"
    & ".pipe-step>.wk-label:last-child{font-size:12px;color:#8b949e}"
    & ".pipe-arrow>.wk-label{font-size:20px;color:#d4a017}"
    & ".pipe-signed{border-color:rgba(65,175,78,.3)}"
    & ".pipe-signed>.wk-label:last-child{color:#41AF4E}"
    & ".claims-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:900px;margin:0 auto}"
    & ".claim-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:28px;transition:border-color .2s,transform .2s}"
    & ".claim-card:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".claim-card>.wk-label:first-child{font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}"
    & ".claim-card>.wk-label:nth-child(2){font-size:16px;font-weight:700;color:#fff;margin-bottom:8px}"
    & ".claim-card>.wk-label:nth-child(3){font-size:14px;color:#8b949e;line-height:1.6}"
    & ".cc-construction>.wk-label:first-child{color:#41AF4E}"
    & ".cc-mechanism>.wk-label:first-child{color:#58a6ff}"
    & ".cc-deployment>.wk-label:first-child{color:#FF9900}"
    & ".cc-organizational>.wk-label:first-child{color:#8b949e}"
    & ".annex-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;max-width:900px;margin:0 auto}"
    & ".annex-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;transition:border-color .2s,transform .2s}"
    & ".annex-card:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".annex-card>.wk-label:first-child{font-size:12px;color:#d4a017;font-weight:700;margin-bottom:6px}"
    & ".annex-card>.wk-label:nth-child(2){font-size:15px;font-weight:700;color:#fff;margin-bottom:8px}"
    & ".annex-card>:nth-child(3){font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px}"
    & ".annex-card>.wk-label:nth-child(4){font-size:13px;color:#8b949e;line-height:1.6}"
    & ".annex-card .tag-con{color:#41AF4E}.annex-card .tag-con>.wk-label{color:#41AF4E}.annex-card .tag-mech{color:#58a6ff}.annex-card .tag-mech>.wk-label{color:#58a6ff}.annex-card .tag-dep{color:#FF9900}.annex-card .tag-dep>.wk-label{color:#FF9900}"
    & ".honesty{max-width:700px;margin:0 auto;text-align:center}"
    & ".honesty>.wk-label{font-size:15px;color:#c8c8d8;line-height:1.8;margin-bottom:12px}"
    & ".honesty>.honesty-item{font-size:15px;color:#c8c8d8;line-height:1.8;margin-bottom:12px}"
    & ".honesty>.honesty-item>.wk-label{display:inline}"
    & ".honesty .em-text{display:inline;font-style:italic;color:#d4a017}"
    & ".honesty .em-text>.wk-label{display:inline;color:#d4a017}"
    & ".honesty-quote{background:rgba(212,160,23,.06);border-left:3px solid #d4a017;padding:20px 24px;border-radius:0 8px 8px 0;margin:24px 0;text-align:left}"
    & ".honesty-quote>.wk-label{font-size:15px;color:#c8c8d8;line-height:1.7;font-style:italic}"
    & ".standards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:900px;margin:0 auto}"
    & ".std-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:28px;text-align:center;transition:border-color .2s,transform .2s}"
    & ".std-card:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".std-card>.wk-label:first-child{font-size:28px;margin-bottom:12px}"
    & ".std-card>.wk-label:nth-child(2){font-size:15px;font-weight:700;color:#fff;margin-bottom:4px}"
    & ".std-card>.wk-label:nth-child(3){font-size:13px;color:#d4a017;margin-bottom:8px}"
    & ".std-card>.wk-label:nth-child(4){font-size:13px;color:#8b949e;line-height:1.5}"
    & "@media(max-width:768px){.claims-grid{grid-template-columns:1fr}.annex-grid{grid-template-columns:1fr}.standards-grid{grid-template-columns:1fr}.pipeline{flex-direction:column}}"

Section: Tree

  cra-hero : WidgetNode
  cra-hero =
    widget-box "hero" "hero" [
      widget-label "badge" "EU CRA &#x2022; Regulation 2024/2847 &#x2022; Build Artifact",
      widget-label "h-title" "COMPLIANCE IS A BUILD ARTIFACT",
      widget-box "h-sub" "hero-sub" [widget-label "h-sub-t" "Every build emits signed, content-addressed evidence mapping regulatory requirements to compiler-enforced guarantees. ", widget-box "h-sub-e" "em-text" [widget-label "h-sub-et" "Not a consultancy deliverable. A build output."]],
      widget-box "stats" "hero-stats" []
    ]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      site-nav [
        widget-label "nl0" "The Problem",
        widget-label "nl1" "Evidence Pipeline",
        widget-label "nl2" "Claim Classes",
        widget-label "nl3" "CRA Annex I",
        widget-label "nl4" "Standards"
      ],
      cra-hero,
      widget-box "body" "compliance" [
        problem-section 0,
        solution-section 0,
        claims-section 0,
        annex-section 0,
        honesty-section 0,
        standards-section 0,
        site-footer [
          widget-label "fl0" "GitHub",
          widget-label "fl1" "Documentation",
          widget-label "fl2" "CRA Full Text",
          widget-label "fl3" "Landing Page"
        ]
      ]
    ]

Section: The Problem

  problem-section : Integer -> WidgetNode
  problem-section (x) =
    site-section "prob" "THE PROBLEM" "Compliance Is Broken" "Regulation is coming. The industry is not ready." [
      widget-box "prob-list" "problem-list" [
        widget-box "p0" "problem-item" [widget-box "p0-s" "strong-text" [widget-label "p0-st" "EU Cyber Resilience Act"], widget-label "p0-t" " (Regulation 2024/2847) &mdash; mandatory by ", widget-box "p0-d" "dt-text" [widget-label "p0-dt" "2027-12-11"]],
        widget-box "p1" "problem-item" [widget-label "p1-t" "Vulnerability reporting obligations begin ", widget-box "p1-d" "dt-text" [widget-label "p1-dt" "2026-09-11"]],
        widget-label "p2" "Any product with digital elements sold in the EU must demonstrate compliance&shy;",
        widget-box "p3" "problem-item" [widget-label "p3-t" "Traditional compliance: ", widget-box "p3-h" "hl-text" [widget-label "p3-ht" "hand-written, per-product, stale after each firmware change"]],
        widget-box "p4" "problem-item" [widget-label "p4-t" "Penalties: up to ", widget-box "p4-h1" "hl-text" [widget-label "p4-h1t" "15M EUR"], widget-label "p4-t2" " or ", widget-box "p4-h2" "hl-text" [widget-label "p4-h2t" "2.5% of global turnover"]]
      ]
    ]

Section: The Solution

  solution-section : Integer -> WidgetNode
  solution-section (x) =
    site-section "sol" "THE SOLUTION" "Evidence Pipeline" "Every build produces machine-verifiable compliance evidence." [
      widget-box "pipeline" "pipeline" [
        pipe-step "ps0" "&#x2699;" "Build Runs" 0,
        pipe-arrow "pa0",
        pipe-step "ps1" "&#x1F4E6;" "CDX Binary (signed)" 1,
        pipe-arrow "pa1",
        pipe-step "ps2" "&#x1F50D;" "Evidence Plug" 0,
        pipe-arrow "pa2",
        pipe-step "ps3" "&#x1F4DC;" "Evidence.cdxe" 1,
        pipe-arrow "pa3",
        pipe-step "ps4" "&#x1F310;" "Evidence.html" 1,
        pipe-arrow "pa4",
        pipe-step "ps5" "&#x1F4CB;" "SBOM" 1
      ]
    ]

  pipe-step : Text, Text, Text, Integer -> WidgetNode
  pipe-step (id) (icon) (label) (signed) =
    if signed == 1
    then widget-box id "pipe-step pipe-signed" [
      widget-label (id & "i") icon,
      widget-label (id & "l") label
    ]
    else widget-box id "pipe-step" [
      widget-label (id & "i") icon,
      widget-label (id & "l") label
    ]

  pipe-arrow : Text -> WidgetNode
  pipe-arrow (id) =
    widget-box id "pipe-arrow" [
      widget-label (id & "a") "&#x2192;"
    ]

Section: Claim Classes

  claims-section : Integer -> WidgetNode
  claims-section (x) =
    site-section "claims" "CLAIM CLASSES" "Four Levels of Evidence" "Each requirement is discharged at the strongest level the toolchain can prove." [
      widget-box "claims-grid" "claims-grid" [
        claim-card "cc0" "cc-construction" "BY-CONSTRUCTION" "Language Makes It Inexpressible" "The compiler rejects programs that violate the requirement. Evidence: compiler diagnostics proving no valid program can exhibit the flaw.",
        claim-card "cc1" "cc-mechanism" "MECHANISM" "Runtime Enforces It" "A runtime mechanism prevents violation. Evidence: capability manifest, signed configuration, enforcement code.",
        claim-card "cc2" "cc-deployment" "DEPLOYMENT" "Provisioning Satisfies It" "The deployment configuration meets the requirement. Evidence: manufacturer template, provisioning checklist.",
        claim-card "cc3" "cc-organizational" "ORGANIZATIONAL" "Process Obligation" "A human process must satisfy this requirement. Evidence: out-of-scope pointer to the manufacturer's compliance program."
      ]
    ]

  claim-card : Text, Text, Text, Text, Text -> WidgetNode
  claim-card (id) (cls) (tag) (title) (desc) =
    widget-box id ("claim-card " & cls) [
      widget-label (id & "t") tag,
      widget-label (id & "n") title,
      widget-label (id & "d") desc
    ]

Section: CRA Annex I

  annex-section : Integer -> WidgetNode
  annex-section (x) =
    site-section "annex" "CRA ANNEX I" "Essential Requirements" "The eight requirements of Annex I, and how Codex discharges each one." [
      widget-box "annex-grid" "annex-grid" [
        annex-card "ax0" "(1)(a)" "No Exploitable Vulnerabilities" "tag-con" "BY-CONSTRUCTION" "Linear types prevent use-after-free. Bounded integers prevent overflow. Effect types confine side effects. The compiler rejects programs with these flaws.",
        annex-card "ax1" "(1)(b)" "Secure Defaults" "tag-mech" "MECHANISM" "Capability table defaults empty. No ambient authority. Every permission is explicit, signed, and auditable.",
        annex-card "ax2" "(1)(c)" "Data Protection" "tag-con" "BY-CONSTRUCTION" "AES-GCM-256 for data at rest, TLS 1.3 for data in transit. Linear key types ensure keys cannot be copied or leaked.",
        annex-card "ax3" "(1)(d)" "Availability" "tag-con" "BY-CONSTRUCTION" "Punctual types carry WCET proofs. The compiler rejects unbounded computation. No infinite loops, no runaway allocation.",
        annex-card "ax4" "(1)(e)" "Attack Surface" "tag-mech" "MECHANISM" "No OS, no libc, no dynamic linking. The capability table enumerates the exact attack surface. Nothing else is reachable.",
        annex-card "ax5" "(1)(f)" "Logging" "tag-mech" "MECHANISM" "Effect-typed Audit channel. Append-only FactStore. Every security-relevant event is recorded with cryptographic integrity.",
        annex-card "ax6" "(2)(a)" "Component Identification" "tag-con" "BY-CONSTRUCTION" "Every component is SHA-256 hashed, Ed25519 signed, and content-addressed. Provenance is a build artifact, not a spreadsheet.",
        annex-card "ax7" "(2)(b)" "Vulnerability Handling" "tag-mech" "MECHANISM" "OTA dual-gate update with trust lattice verification. Updates are signed, staged, and rollback-safe."
      ]
    ]

  annex-card : Text, Text, Text, Text, Text, Text -> WidgetNode
  annex-card (id) (ref) (title) (tagcls) (tag) (desc) =
    widget-box id "annex-card" [
      widget-label (id & "r") ref,
      widget-label (id & "t") title,
      widget-box (id & "c") tagcls [widget-label (id & "ct") tag],
      widget-label (id & "d") desc
    ]

Section: The Honesty Principle

  honesty-section : Integer -> WidgetNode
  honesty-section (x) =
    site-section "honesty" "THE HONESTY PRINCIPLE" "We Never Claim Compliant" "The evidence speaks. The manufacturer decides." [
      widget-box "honesty-body" "honesty" [
        widget-box "h0" "honesty-item" [widget-label "h0-t" "The build output never stamps a product ", widget-box "h0-e" "em-text" [widget-label "h0-et" "compliant"], widget-label "h0-t2" ". That is a legal determination only a manufacturer can make."],
        widget-box "h-quote" "honesty-quote" [
          widget-label "hq0" "Of N requirements, K discharged by construction, M by mechanism. Residual checklist: the manufacturer's to own.&shy;"
        ],
        widget-box "h1" "honesty-item" [widget-label "h1-t" "This transforms compliance from ", widget-box "h1-e1" "em-text" [widget-label "h1-e1t" "did we follow the checklist?"], widget-label "h1-t2" " to ", widget-box "h1-e2" "em-text" [widget-label "h1-e2t" "what did the compiler prove?"]],
        widget-label "h2" "The evidence file is signed, reproducible, and content-addressed. Run the same build, get the same evidence. Every time.&shy;"
      ]
    ]

Section: Standards Coverage

  standards-section : Integer -> WidgetNode
  standards-section (x) =
    site-section "stds" "STANDARDS COVERAGE" "Beyond the CRA" "The same evidence pipeline covers additional standards." [
      widget-box "stds-grid" "standards-grid" [
        std-card "sd0" "&#x1F3E0;" "ETSI EN 303 645" "33 provisions, 19 satisfied" "Consumer IoT cybersecurity baseline. Codex discharges the majority through language-level guarantees and capability enforcement.",
        std-card "sd1" "&#x1F3ED;" "IEC 62443-4-2" "7 FRs, all satisfied" "Industrial automation security. All seven foundational requirements met through compiler enforcement and cryptographic primitives.",
        std-card "sd2" "&#x1F4CB;" "NISTIR 8259A" "6 capabilities mapped" "IoT device cybersecurity capability core baseline. All six capabilities mapped to Codex mechanisms and build evidence."
      ]
    ]

  std-card : Text, Text, Text, Text, Text -> WidgetNode
  std-card (id) (icon) (name) (coverage) (desc) =
    widget-box id "std-card" [
      widget-label (id & "i") icon,
      widget-label (id & "n") name,
      widget-label (id & "c") coverage,
      widget-label (id & "d") desc
    ]

Section: Handlers

  compliance-click : Text -> Integer
  compliance-click (id) = 0

Section: Entry

  render-compliance : Integer -> Integer
  render-compliance (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init compliance-extra-css
    in let s = set-render render-compliance
    in let h = register-handlers no-pick compliance-click
    in render-compliance 0
  end

Page 1
