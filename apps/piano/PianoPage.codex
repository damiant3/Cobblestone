Chapter: PianoPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Piano keyboard playable from the computer keyboard. Two octaves mapped
 to the home rows: lower row (Z-M) plays C3-B3, upper row (Q-U) plays
 C4-B4. Sharps on the row above each. Visual feedback on keypress.

 We say:

Section: Theme

  piano-theme : Theme
  piano-theme =
    let p = Palette { pal-bg = #0A0A0A, pal-fg = #E1E1E1, pal-primary = #FFFFFF, pal-secondary = #121212, pal-accent = #4490FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "piano-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  piano-css : Text
  piano-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0a0a0a;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center}#app{display:contents}"
    & ".piano-app{display:flex;flex-direction:column;align-items:center;padding:32px}"
    & ".piano-brand{font-size:24px;font-weight:700;color:#fff;letter-spacing:4px;margin-bottom:8px}"
    & ".piano-sub{font-size:13px;color:#555;margin-bottom:32px}"
    & ".keyboard{display:flex;position:relative;user-select:none}"
    & ".octave{display:flex;position:relative}"
    & ".white-key{width:56px;height:200px;background:linear-gradient(180deg,#f0f0f0,#fff);border:1px solid #999;border-radius:0 0 6px 6px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:12px;transition:background .05s;position:relative;z-index:1}"
    & ".white-key:hover{background:linear-gradient(180deg,#e8e8e8,#f0f0f0)}"
    & ".white-key:active,.white-key.pressed{background:linear-gradient(180deg,#d0d0d0,#ddd)}"
    & ".white-key .note{font-size:11px;color:#999;font-weight:600}"
    & ".white-key .key-hint{font-size:10px;color:#bbb;margin-top:4px;background:#eee;padding:2px 6px;border-radius:3px}"
    & ".black-key{width:34px;height:125px;background:linear-gradient(180deg,#222,#111);border:1px solid #000;border-radius:0 0 4px 4px;cursor:pointer;position:absolute;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:10px;transition:background .05s;box-shadow:0 4px 8px rgba(0,0,0,.5)}"
    & ".black-key:hover{background:linear-gradient(180deg,#333,#1a1a1a)}"
    & ".black-key:active,.black-key.pressed{background:linear-gradient(180deg,#444,#2a2a2a)}"
    & ".black-key .note{font-size:9px;color:#666;font-weight:600}"
    & ".black-key .key-hint{font-size:9px;color:#555;margin-top:4px;background:#222;padding:1px 4px;border-radius:2px}"
    & ".controls{display:flex;gap:16px;align-items:center;margin-bottom:24px}"
    & ".ctrl-group{display:flex;align-items:center;gap:8px}"
    & ".ctrl-label{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:.5px}"
    & ".ctrl-btn{background:#1a1a1a;border:1px solid #333;color:#ccc;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".ctrl-btn:hover{background:#222;border-color:#555}"
    & ".ctrl-btn.active{background:#449dff;border-color:#449dff;color:#fff}"
    & ".display{margin-top:24px;text-align:center}"
    & ".note-display{font-size:48px;font-weight:200;color:#449dff;min-height:60px;font-variant-numeric:tabular-nums}"
    & ".freq-display{font-size:13px;color:#444;margin-top:4px}"
    & ".key-map{margin-top:32px;display:flex;flex-direction:column;gap:6px;align-items:center}"
    & ".key-row{display:flex;gap:4px}"
    & ".key-cap{width:32px;height:32px;background:#1a1a1a;border:1px solid #333;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#666}"
    & ".key-cap.mapped{border-color:#449dff;color:#449dff}"
    & ".key-cap.black-mapped{border-color:#888;color:#888}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "piano-app" "piano-app" [
      widget-label "brand" "CODEXPIANO",
      widget-label "sub" "Play with your keyboard. Lower row = octave 3, upper row = octave 4.",
      controls-bar 0,
      keyboard-widget 0,
      note-display 0,
      key-map-guide 0
    ]

  controls-bar : Integer -> WidgetNode
  controls-bar (x) =
    widget-box "controls" "controls" [
      widget-box "cg-oct" "ctrl-group" [
        widget-label "oct-lbl" "Octave",
        widget-button "oct-down" "-",
        widget-label "oct-val" "3-4",
        widget-button "oct-up" "+"
      ],
      widget-box "cg-vol" "ctrl-group" [
        widget-label "vol-lbl" "Volume",
        widget-button "vol-down" "-",
        widget-label "vol-val" "80%",
        widget-button "vol-up" "+"
      ],
      widget-box "cg-wave" "ctrl-group" [
        widget-label "wave-lbl" "Waveform",
        widget-button "wave-sine" "Sine",
        widget-button "wave-tri" "Triangle",
        widget-button "wave-sq" "Square"
      ],
      widget-box "cg-sus" "ctrl-group" [
        widget-label "sus-lbl" "Sustain",
        widget-button "sus-toggle" "Off"
      ]
    ]

  keyboard-widget : Integer -> WidgetNode
  keyboard-widget (x) =
    widget-box "keyboard" "keyboard" [
      octave-keys "o3" "3",
      octave-keys "o4" "4"
    ]

  octave-keys : Text, Text -> WidgetNode
  octave-keys (id) (oct) =
    let keys = if oct == "3"
    then [
      white-key (id & "-c") "C" "Z",
      white-key (id & "-d") "D" "X",
      white-key (id & "-e") "E" "C",
      white-key (id & "-f") "F" "V",
      white-key (id & "-g") "G" "B",
      white-key (id & "-a") "A" "N",
      white-key (id & "-b") "B" "M"
    ]
    else [
      white-key (id & "-c") "C" "Q",
      white-key (id & "-d") "D" "W",
      white-key (id & "-e") "E" "E",
      white-key (id & "-f") "F" "R",
      white-key (id & "-g") "G" "T",
      white-key (id & "-a") "A" "Y",
      white-key (id & "-b") "B" "U"
    ]
    in widget-box id "octave" keys

  key-note : Text -> Text
  key-note (id) =
    let oct = if text-starts-with id "o3" then "3" else "4"
    in let last = char-code-at id (text-length id - 1)
    in let letter = if last == 99 then "C" else if last == 100 then "D" else if last == 101 then "E"
      else if last == 102 then "F" else if last == 103 then "G" else if last == 97 then "A" else "B"
    in letter & oct

  key-freq : Text -> Integer
  key-freq (id) =
    let o4 = text-starts-with id "o4"
    in let last = char-code-at id (text-length id - 1)
    in if last == 99 then (if o4 then 262 else 131)
    else if last == 100 then (if o4 then 294 else 147)
    else if last == 101 then (if o4 then 330 else 165)
    else if last == 102 then (if o4 then 349 else 175)
    else if last == 103 then (if o4 then 392 else 196)
    else if last == 97 then (if o4 then 440 else 220)
    else (if o4 then 494 else 247)

  white-key : Text, Text, Text -> WidgetNode
  white-key (id) (note) (hint) =
    let cls = if state-get-text "current-note" == key-note id then "white-key pressed" else "white-key"
    in widget-box-click id cls [
      widget-label (id & "n") note,
      widget-label (id & "h") hint
    ]

  note-display : Integer -> WidgetNode
  note-display (x) =
    let n = state-get-text "current-note"
    in widget-box "display" "display" [
      widget-label "note-show" n,
      widget-label "freq-show" (if text-length n > 0 then "&#x266A; playing" else "Press a key to play")
    ]

  key-map-guide : Integer -> WidgetNode
  key-map-guide (x) =
    widget-box "keymap" "key-map" [
      widget-label "km-title" "Keyboard Map",
      widget-box "kr-sharps-hi" "key-row" [
        widget-label "kh-2" "2",
        widget-label "kh-3" "3",
        widget-label "kh-gap1" "",
        widget-label "kh-5" "5",
        widget-label "kh-6" "6",
        widget-label "kh-7" "7"
      ],
      widget-box "kr-naturals-hi" "key-row" [
        widget-label "kn-q" "Q",
        widget-label "kn-w" "W",
        widget-label "kn-e" "E",
        widget-label "kn-r" "R",
        widget-label "kn-t" "T",
        widget-label "kn-y" "Y",
        widget-label "kn-u" "U"
      ],
      widget-box "kr-sharps-lo" "key-row" [
        widget-label "kl-s" "S",
        widget-label "kl-d" "D",
        widget-label "kl-gap1" "",
        widget-label "kl-g" "G",
        widget-label "kl-h" "H",
        widget-label "kl-j" "J"
      ],
      widget-box "kr-naturals-lo" "key-row" [
        widget-label "kn-z" "Z",
        widget-label "kn-x" "X",
        widget-label "kn-c" "C",
        widget-label "kn-v" "V",
        widget-label "kn-b" "B",
        widget-label "kn-n" "N",
        widget-label "kn-m" "M"
      ]
    ]

Section: Handlers

  piano-click : Text -> Integer
  piano-click (id) =
    if text-starts-with id "o3" then play-key id
    else if text-starts-with id "o4" then play-key id
    else if id == "wave-sine" then let s = state-set-render "waveform" 0 in 0
    else if id == "wave-tri" then let s = state-set-render "waveform" 1 in 0
    else if id == "wave-sq" then let s = state-set-render "waveform" 2 in 0
    else 0

  play-key : Text -> Integer
  play-key (id) =
    let s = state-set-text "current-note" (key-note id)
    in let a = play-tone (key-freq id) 450 (state-get "waveform")
    in let s2 = state-set-render "tick" (state-get "tick" + 1)
    in 0

Section: Entry

  render-piano : Integer -> Integer
  render-piano (x) = mount-widget-themed piano-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style piano-theme piano-css
    in let s = set-render render-piano
    in let h = register-handlers no-pick piano-click
    in render-piano 0
  end

