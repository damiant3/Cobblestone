Chapter: HelmTheme
  cites Helm chapter HelmTypes

 Theme for the Helm app. Rank colors, attention heat, sentiment
 indicators, and voice activity colors.

Section: Rank Colors

  ht-admiral-color : Integer = #FFD700
  ht-captain-color : Integer = 15763518
  ht-lieutenant-color : Integer = 5809919
  ht-crew-color : Integer = 9147550

Section: Attention Heat

  ht-heat-high : Integer = 16273737
  ht-heat-medium : Integer = 15763518
  ht-heat-low : Integer = 5809919
  ht-heat-none : Integer = 3159613

  ht-attention-color : Integer -> Integer
  ht-attention-color (score) =
    if score > 500 then ht-heat-high
    else if score > 200 then ht-heat-medium
    else if score > 50 then ht-heat-low
    else ht-heat-none

Section: Sentiment Colors

  ht-positive-color : Integer = 4176208
  ht-negative-color : Integer = 16273737
  ht-neutral-color : Integer = 9147550
  ht-split-color : Integer = #FFD700

  ht-sentiment-color : Sentiment -> Integer
  ht-sentiment-color (s) = when s
    is SentPositive (n) -> ht-positive-color
    is SentNegative (n) -> ht-negative-color
    is SentNeutral -> ht-neutral-color
    is SentSplit (a) (b) -> ht-split-color
    is SentMixed -> ht-neutral-color

Section: Voice Activity Colors

  ht-silent-color : Integer = 4738904
  ht-speaking-color : Integer = 4176208
  ht-priority-color : Integer = #FFD700
  ht-emergency-color : Integer = 16273737

Section: Layout Constants

  ht-bg : Integer = 856343
  ht-surface : Integer = 1448738
  ht-border : Integer = 3159613
  ht-text-primary : Integer = 15791868
  ht-text-secondary : Integer = 9147550
  ht-current-height : Integer = 60
  ht-voice-node-size : Integer = 48
  ht-tab-height : Integer = 36
