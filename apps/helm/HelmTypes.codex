    rs-band-minutes = 5,
    rs-mode-switch-msg-rate = 10,
    rs-mode-switch-min-senders = 10,
    rs-decay-fast-sec = 30,
    rs-decay-slow-sec = 300,
    rs-max-currents = 100,
    rs-max-messages-per-current = 500
  }

  rs-live-event : RoomSettings
  rs-live-event = RoomSettings {
    rs-cluster-threshold = 20,
    rs-band-minutes = 1,
    rs-mode-switch-msg-rate = 5,
    rs-mode-switch-min-senders = 5,
    rs-decay-fast-sec = 15,
    rs-decay-slow-sec = 120,
    rs-max-currents = 50,
    rs-max-messages-per-current = 1000
  }

  rs-meeting : RoomSettings
  rs-meeting = RoomSettings {
    rs-cluster-threshold = 50,
    rs-band-minutes = 15,
    rs-mode-switch-msg-rate = 20,
    rs-mode-switch-min-senders = 15,
    rs-decay-fast-sec = 60,
    rs-decay-slow-sec = 600,
    rs-max-currents = 200,
    rs-max-messages-per-current = 200
  }

Section: Voice Settings

  VoiceSettings = record {
    vs-template : RankTemplate,
    vs-vol-commander : Integer,
    vs-vol-peer : Integer,
    vs-vol-squad : Integer,
    vs-vol-joint : Integer,
    vs-vol-emergency : Integer,
    vs-vol-listen-up : Integer,
    vs-emergency-duration-sec : Integer,
    vs-require-request-above : Rank
  }

  vs-default : VoiceSettings
  vs-default = VoiceSettings {
    vs-template = TplNaval,
    vs-vol-commander = 100,
    vs-vol-peer = 80,
    vs-vol-squad = 90,
    vs-vol-joint = 70,
    vs-vol-emergency = 100,
    vs-vol-listen-up = 60,
    vs-emergency-duration-sec = 10,
    vs-require-request-above = Captain
  }

Section: Compose State

  ComposeState = record {
    cmp-text : Text,
    cmp-cursor : Integer,
    cmp-active : Boolean
  }

  compose-new : ComposeState
  compose-new = ComposeState { cmp-text = "", cmp-cursor = 0, cmp-active = False }

  compose-insert : ComposeState, Text -> ComposeState
  compose-insert (c) (ch) =
    let new-text = text-take c.cmp-text c.cmp-cursor & ch & text-drop c.cmp-text c.cmp-cursor
    in ComposeState { cmp-text = new-text, cmp-cursor = c.cmp-cursor + 1, cmp-active = True }

  compose-backspace : ComposeState -> ComposeState
  compose-backspace (c) =
    if c.cmp-cursor == 0 then c
    else let new-text = text-take c.cmp-text (c.cmp-cursor - 1) & text-drop c.cmp-text c.cmp-cursor
    in ComposeState { cmp-text = new-text, cmp-cursor = c.cmp-cursor - 1, cmp-active = True }

  compose-submit : ComposeState -> ComposeState
  compose-submit (c) = ComposeState { cmp-text = "", cmp-cursor = 0, cmp-active = False }

  compose-content : ComposeState -> Text
  compose-content (c) = c.cmp-text
