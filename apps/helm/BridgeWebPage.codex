Section: Theme

  bsn : BorderSide = BorderSide { brd-width = 0, brd-color = 0 }
  bn : Border = Border { bdr-top = bsn, bdr-right = bsn, bdr-bottom = bsn, bdr-left = bsn, bdr-corner = CornerSharp }
  ez : Edges = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }
  bdr : Integer, Integer, CornerStyle -> Border
  bdr (w) (c) (corner) = let s = BorderSide { brd-width = w, brd-color = c } in Border { bdr-top = s, bdr-right = s, bdr-bottom = s, bdr-left = s, bdr-corner = corner }
  eu : Integer -> Edges
  eu (v) = Edges { edge-top = v, edge-right = v, edge-bottom = v, edge-left = v }
  exy : Integer, Integer -> Edges
  exy (x) (y) = Edges { edge-top = y, edge-right = x, edge-bottom = y, edge-left = x }
  ws : Integer, Integer, Border, Edges, Edges -> WidgetStyle
  ws (bg) (fg) (b) (pad) (mar) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0 }
  ss-flat : WidgetStyle -> StateStyles
  ss-flat (s) = StateStyles { ss-normal = s, ss-hover = s, ss-pressed = s, ss-disabled = s, ss-focused = s }

  bridge-theme : Theme
  bridge-theme =
    let p = Palette { pal-bg = #0A0A0A, pal-fg = #E1E1E1, pal-primary = 4177823, pal-secondary = 1973790, pal-accent = 4177823, pal-muted = 7368816, pal-error = #CC0000, pal-success = 4181842, pal-warning = #FF9900, pal-border = 2697513 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let panel = ws 1973790 (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 8)) (eu 10) (eu 0)
    in let btn = ws (p.pal-primary) #FFFFFF (bdr 0 0 (CornerRound 6)) (exy 12 6) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "bridge-dark", th-palette = p, th-panel = ss-flat panel, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  bridge-css : Text
  bridge-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0a0a14;color:#e1e1e1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;min-height:100vh}"
    & "#app{display:block;max-width:900px;margin:0 auto;padding:24px}"
    & "#br-title,.wk-label{letter-spacing:.5px}"
    & ".wk-btn{cursor:pointer;font-size:12px;letter-spacing:.5px;transition:filter .12s}.wk-btn:hover{filter:brightness(1.25)}"
    & ".wk-panel{margin-bottom:8px}"

  init-bridge : Integer -> Integer
  init-bridge (x) =
    let t = inject-theme-css bridge-theme
    in let style = dom-create "style"
    in let s2 = dom-set-text style bridge-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in 0

Section: Sample Hierarchy

  sample-hierarchy : VoiceHierarchy
  sample-hierarchy =
    let h = hierarchy-new TplNaval
    in let h1 = vh-add-node h "admiral" "Admiral" Admiral ""
    in let h2 = vh-add-node h1 "capt-a" "Captain Alpha" Captain "admiral"
    in let h3 = vh-add-node h2 "capt-b" "Captain Beta" Captain "admiral"
    in let h4 = vh-add-node h3 "capt-c" "Captain Charlie" Captain "admiral"
    in let h5 = vh-add-node h4 "p1" "Pilot Nova" Crew "capt-a"
    in let h6 = vh-add-node h5 "p2" "Pilot Orion" Crew "capt-a"
    in let h7 = vh-add-node h6 "p3" "Pilot Vega" Crew "capt-a"
    in let h8 = vh-add-node h7 "p4" "Pilot Luna" Crew "capt-b"
    in let h9 = vh-add-node h8 "p5" "Pilot Mars" Crew "capt-b"
    in let h10 = vh-add-node h9 "p6" "Pilot Sol" Crew "capt-c"
    in vh-add-node h10 "p7" "Pilot Echo" Crew "capt-c"

Section: State-Driven Hierarchy

  bridge-hierarchy : Integer -> VoiceHierarchy
  bridge-hierarchy (x) =
    let base = sample-hierarchy
    in apply-flat-toggles base (base.vh-nodes) 0 (base.vh-node-count)

  apply-flat-toggles : VoiceHierarchy, List VoiceNode, Integer, Integer -> VoiceHierarchy
  apply-flat-toggles (h) (nodes) (i) (n) =
    if i >= n then h
    else let node = list-at nodes i
    in let id = node.vn-id
    in let h1 = vh-set-speaking h id (state-get ("spk-" & id) == 1)
    in let h2 = vh-set-muted h1 id (state-get ("mute-" & id) == 1)
    in apply-flat-toggles h2 nodes (i + 1) n

Section: Helpers

  toggle-spk : Text -> Integer
  toggle-spk (id) = state-set-render ("spk-" & id) (1 - state-get ("spk-" & id))

  toggle-mute : Text -> Integer
  toggle-mute (id) = state-set-render ("mute-" & id) (1 - state-get ("mute-" & id))

Section: Tree

  bridge-tree : Integer -> WidgetNode
  bridge-tree (x) = bridge-widget (bridge-hierarchy 0)

Section: Handlers

  bridge-click : Text -> Integer
  bridge-click (id) =
    if text-starts-with id "adm-broadcast-" then toggle-spk (text-drop id 14)
    else if text-starts-with id "adm-mute-" then toggle-mute (text-drop id 9)
    else if text-starts-with id "cap-listen-" then toggle-spk (text-drop id 11)
    else if text-starts-with id "cap-hail-" then toggle-spk (text-drop id 9)
    else 0

  no-pick : Text, Integer -> Integer
  no-pick (g) (i) = 0

Section: Entry

  render-bridge : Integer -> Integer
  render-bridge (x) = mount-widget-themed bridge-theme (bridge-tree 0)

  opening : [Console] Integer
  opening = act
    let t = init-bridge 0
    in let s = set-render render-bridge
    in let h = register-handlers no-pick bridge-click
    in render-bridge 0
  end

