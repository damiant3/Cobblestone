  net-server-style = NodeStyle { ns-fill-color = 0xD5F5E3, ns-stroke-color = 0x27AE60, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 11, ns-corner-radius = 4, ns-opacity = 255 }

  net-router-style : NodeStyle
  net-router-style = NodeStyle { ns-fill-color = 0xFADBD8, ns-stroke-color = 0xE74C3C, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 11, ns-corner-radius = 30, ns-opacity = 255 }

  net-switch-style : NodeStyle
  net-switch-style = NodeStyle { ns-fill-color = 0xD6EAF8, ns-stroke-color = 0x2980B9, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 11, ns-corner-radius = 0, ns-opacity = 255 }

  net-firewall-style : NodeStyle
  net-firewall-style = NodeStyle { ns-fill-color = 0xFDEDBD, ns-stroke-color = 0xE67E22, ns-stroke-width = 3, ns-text-color = 0x1E1E2E, ns-font-size = 11, ns-corner-radius = 0, ns-opacity = 255 }

  net-cloud-style : NodeStyle
  net-cloud-style = NodeStyle { ns-fill-color = 0xEBF5FB, ns-stroke-color = 0x85C1E9, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 12, ns-corner-radius = 20, ns-opacity = 255 }

Section: State Machine Shapes

  state-machine-shapes : List ShapeDef
  state-machine-shapes = [
    ShapeDef { sd-shape = ShapeRoundRect, sd-name = "State", sd-width = 140, sd-height = 60, sd-style = sm-state-style },
    ShapeDef { sd-shape = ShapeCircle, sd-name = "Initial", sd-width = 30, sd-height = 30, sd-style = sm-initial-style },
    ShapeDef { sd-shape = ShapeCircle, sd-name = "Final", sd-width = 30, sd-height = 30, sd-style = sm-final-style }
  ]

  sm-state-style : NodeStyle
  sm-state-style = NodeStyle { ns-fill-color = 0xE8F8F5, ns-stroke-color = 0x16A085, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 14, ns-corner-radius = 12, ns-opacity = 255 }

  sm-initial-style : NodeStyle
  sm-initial-style = NodeStyle { ns-fill-color = 0x333333, ns-stroke-color = 0x333333, ns-stroke-width = 2, ns-text-color = 0xFFFFFF, ns-font-size = 0, ns-corner-radius = 15, ns-opacity = 255 }

  sm-final-style : NodeStyle
  sm-final-style = NodeStyle { ns-fill-color = 0xFFFFFF, ns-stroke-color = 0x333333, ns-stroke-width = 3, ns-text-color = 0x333333, ns-font-size = 0, ns-corner-radius = 15, ns-opacity = 255 }

Section: Shape Lookup

  shapes-for-type : DiagramType -> List ShapeDef
  shapes-for-type (dt) =
    when dt
      is Flowchart -> flowchart-shapes
      is EntityRelationship -> erd-shapes
      is UmlClass -> uml-class-shapes
      is NetworkTopology -> network-shapes
      is StateMachine -> state-machine-shapes
      is otherwise -> flowchart-shapes
