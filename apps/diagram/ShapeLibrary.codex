Section: Network Shapes

  network-shapes : List ShapeDef
  network-shapes = [
    ShapeDef { sd-shape = ShapeRect, sd-name = "Server", sd-width = 80, sd-height = 100, sd-style = net-server-style },
    ShapeDef { sd-shape = ShapeCircle, sd-name = "Router", sd-width = 60, sd-height = 60, sd-style = net-router-style },
    ShapeDef { sd-shape = ShapeHexagon, sd-name = "Switch", sd-width = 80, sd-height = 50, sd-style = net-switch-style },
    ShapeDef { sd-shape = ShapeRect, sd-name = "Firewall", sd-width = 60, sd-height = 80, sd-style = net-firewall-style },
    ShapeDef { sd-shape = ShapeCloud, sd-name = "Cloud", sd-width = 120, sd-height = 80, sd-style = net-cloud-style },
    ShapeDef { sd-shape = ShapeRect, sd-name = "Client", sd-width = 80, sd-height = 60, sd-style = default-node-style }
  ]

