Chapter: ShapeLibrary
  cites Diagram chapter DiagramModel

 Shape definitions for each diagram type. Maps diagram types
 to available shapes with default sizes and styles.

Section: Shape Catalog

  ShapeDef = record {
    sd-shape  : ShapeType,
    sd-name   : Text,
    sd-width  : Integer,
    sd-height : Integer,
    sd-style  : NodeStyle
  }

Section: Flowchart Shapes

  flowchart-shapes : List ShapeDef
  flowchart-shapes = [
    ShapeDef { sd-shape = ShapeOval, sd-name = "Start/End", sd-width = 120, sd-height = 50, sd-style = flow-start-style },
    ShapeDef { sd-shape = ShapeRect, sd-name = "Process", sd-width = 140, sd-height = 60, sd-style = default-node-style },
    ShapeDef { sd-shape = ShapeDiamond, sd-name = "Decision", sd-width = 120, sd-height = 80, sd-style = flow-decision-style },
    ShapeDef { sd-shape = ShapeParallelogram, sd-name = "I/O", sd-width = 140, sd-height = 60, sd-style = flow-io-style },
    ShapeDef { sd-shape = ShapeDocument, sd-name = "Document", sd-width = 120, sd-height = 60, sd-style = default-node-style },
    ShapeDef { sd-shape = ShapeCylinder, sd-name = "Database", sd-width = 100, sd-height = 80, sd-style = flow-db-style }
  ]

  flow-start-style : NodeStyle
  flow-start-style = NodeStyle { ns-fill-color = 0xD5F5E3, ns-stroke-color = 0x27AE60, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 14, ns-corner-radius = 25, ns-opacity = 255 }

  flow-decision-style : NodeStyle
  flow-decision-style = NodeStyle { ns-fill-color = 0xFEF9E7, ns-stroke-color = 0xF1C40F, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 14, ns-corner-radius = 0, ns-opacity = 255 }

  flow-io-style : NodeStyle
  flow-io-style = NodeStyle { ns-fill-color = 0xEBF5FB, ns-stroke-color = 0x3498DB, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 14, ns-corner-radius = 0, ns-opacity = 255 }

  flow-db-style : NodeStyle
  flow-db-style = NodeStyle { ns-fill-color = 0xF4ECF7, ns-stroke-color = 0x8E44AD, ns-stroke-width = 2, ns-text-color = 0x1E1E2E, ns-font-size = 14, ns-corner-radius = 0, ns-opacity = 255 }

