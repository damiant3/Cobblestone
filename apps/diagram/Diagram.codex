Section: State

  DiagramAppState = record {
    da-diagram    : Diagram,
    da-canvas     : CanvasState,
    da-toolbar    : ToolbarState,
    da-selection  : SelectionState,
    da-history    : CommandStack,
    da-width      : Integer,
    da-height     : Integer,
    da-dirty      : Boolean,
    da-connecting : Maybe ConnectState,
    da-editing    : Maybe EditState,
    da-status     : Text
  }

  ConnectState = record {
    cn-source-id : Integer,
    cn-mouse-x   : Integer,
    cn-mouse-y   : Integer
  }

  EditState = record {
    ed-node-id   : Integer,
    ed-text      : Text,
    ed-cursor    : Integer
  }

Section: Initialization

  diagram-app-init : Integer, Integer, Integer -> DiagramAppState
  diagram-app-init (w) (h) (theme) =
    let canvas-w = w - palette-width
    in let canvas-h = h - toolbar-height - status-height
    in DiagramAppState {
      da-diagram = diagram-new "Untitled" Flowchart,
      da-canvas = canvas-new canvas-w canvas-h,
      da-toolbar = toolbar-new Flowchart,
      da-selection = dsel-empty,
      da-history = command-stack-new 50,
      da-width = w,
      da-height = h,
      da-dirty = True,
      da-connecting = None,
      da-editing = None,
      da-status = "Ready"
    }

Section: Event Handling

  diagram-handle-event : DiagramAppState, Event -> DiagramAppState
  diagram-handle-event (state) (ev) =
    when ev.ev-kind
      is EvKeyDown (k) (mods) -> diagram-handle-key state k mods
      is EvMouseDown (x) (y) (btn) -> diagram-handle-mouse-down state x y btn
      is EvMouseUp (x) (y) (btn) -> diagram-handle-mouse-up state x y
      is EvMouseMove (x) (y) -> diagram-handle-mouse-move state x y
      is EvScroll (dx) (dy) (mods) -> diagram-handle-scroll state dy
      is otherwise -> state

Section: Key Handling

  diagram-handle-key : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-handle-key (state) (k) (mods) =
    when state.da-editing
      is Just (ed) -> diagram-handle-edit-key state ed k
      is None -> diagram-handle-normal-key state k mods

  diagram-handle-normal-key : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-handle-normal-key (state) (k) (mods) =
    let ctrl = bit-and mods mod-ctrl > 0
    in if ctrl
      then diagram-handle-ctrl-key state k
      else diagram-handle-plain-key state k

  diagram-handle-ctrl-key : DiagramAppState, Integer -> DiagramAppState
  diagram-handle-ctrl-key (state) (k0) =
    let k = key-upper k0
    in if k == char-code 'Z' then diagram-undo state
    else if k == char-code 'Y' then diagram-redo state
    else if k == char-code 'A' then diagram-select-all state
    else if k == char-code 'S' then diagram-save state
    else if k == char-code 'N' then diagram-new-diagram state
    else state

  diagram-handle-plain-key : DiagramAppState, Integer -> DiagramAppState
  diagram-handle-plain-key (state) (k0) =
    let k = key-upper k0
    in if k == key-delete then diagram-delete-selected state
    else if k == key-backspace then diagram-delete-selected state
    else if k == key-escape then diagram-escape state
    else if k == char-code 'G' then diagram-toggle-grid state
    else if k == char-code 'S' then diagram-toggle-snap state
    else if k == char-code '=' then __record-set (__record-set state "da-canvas" (canvas-zoom-in state.da-canvas)) "da-dirty" True
    else if k == char-code '-' then __record-set (__record-set state "da-canvas" (canvas-zoom-out state.da-canvas)) "da-dirty" True
    else if k == key-left then diagram-nudge state (-1) 0
    else if k == key-up then diagram-nudge state 0 (-1)
    else if k == key-right then diagram-nudge state 1 0
    else if k == key-down then diagram-nudge state 0 1
    else state

Section: Mouse Handling

  diagram-handle-mouse-down : DiagramAppState, Integer, Integer, Integer -> DiagramAppState
  diagram-handle-mouse-down (state) (mx) (my) (mods) =
    if my < toolbar-height
    then diagram-handle-toolbar-click state mx
    else if mx < palette-width
    then diagram-handle-palette-click state my
    else let cx = mx - palette-width
    in let cy = my - toolbar-height
    in let dx = screen-to-diagram-x state.da-canvas cx
    in let dy = screen-to-diagram-y state.da-canvas cy
    in let shift = int-mod (mods / 4) 2 == 1
    in diagram-handle-canvas-click state dx dy shift

  diagram-handle-canvas-click : DiagramAppState, Integer, Integer, Boolean -> DiagramAppState
  diagram-handle-canvas-click (state) (dx) (dy) (shift) =
    when state.da-toolbar.tb-active-tool
      is ToolSelect -> diagram-select-at state dx dy shift
      is ToolConnect -> diagram-start-connect state dx dy
      is ToolAddNode (shape-def) -> diagram-place-node state shape-def dx dy
      is ToolPan -> __record-set state "da-canvas" (canvas-start-pan state.da-canvas dx dy)
      is ToolText -> diagram-start-edit-at state dx dy

  diagram-handle-mouse-up : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-handle-mouse-up (state) (mx) (my) =
    let state2 = if state.da-selection.sel-dragging
          then diagram-end-drag state
          else state
    in let state3 = when state2.da-connecting
          is Just (cn) -> diagram-finish-connect state2 mx my
          is None -> state2
    in if state3.da-canvas.cv-panning
      then __record-set state3 "da-canvas" (canvas-end-pan state3.da-canvas)
      else if state3.da-selection.sel-marquee
      then let r1 = __record-set state3 "da-selection" (selection-end-marquee state3.da-selection state3.da-diagram)
      in __record-set r1 "da-dirty" True
      else state3

  diagram-handle-mouse-move : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-handle-mouse-move (state) (mx) (my) =
    if state.da-selection.sel-dragging
    then let dx = screen-to-diagram-x state.da-canvas (mx - palette-width)
      in let dy = screen-to-diagram-y state.da-canvas (my - toolbar-height)
      in let r1 = __record-set state "da-selection" (selection-update-drag state.da-selection dx dy)
      in __record-set r1 "da-dirty" True
    else if state.da-canvas.cv-panning
    then let r1 = __record-set state "da-canvas" (canvas-update-pan state.da-canvas mx my)
    in __record-set r1 "da-dirty" True
    else if state.da-selection.sel-marquee
    then let dx = screen-to-diagram-x state.da-canvas (mx - palette-width)
      in let dy = screen-to-diagram-y state.da-canvas (my - toolbar-height)
      in let r1 = __record-set state "da-selection" (selection-update-marquee state.da-selection dx dy)
      in __record-set r1 "da-dirty" True
    else when state.da-connecting
      is Just (cn) -> (__record-set state "da-connecting"
            (Just (__record-set (__record-set cn "cn-mouse-x" mx) "cn-mouse-y" my)))
      is None -> state

Section: Selection

  diagram-select-at : DiagramAppState, Integer, Integer, Boolean -> DiagramAppState
  diagram-select-at (state) (dx) (dy) (shift) =
    let hit = node-at-point state.da-diagram dx dy
    in when hit
      is None ->
        if shift then state
        else let r1 = __record-set state "da-selection" (selection-start-marquee (selection-clear state.da-selection) dx dy)
        in let r2 = __record-set r1 "da-status" "Marquee select"
        in __record-set r2 "da-dirty" True
      is Just (n) ->
        let sel = if shift
              then selection-toggle state.da-selection n.dn-id
              else selection-select state.da-selection n.dn-id
        in let dragging = selection-start-drag sel dx dy
        in let r1 = __record-set state "da-selection" dragging
        in let r2 = __record-set r1 "da-status" ("Selected: " & n.dn-label)
        in __record-set r2 "da-dirty" True

  diagram-select-all : DiagramAppState -> DiagramAppState
  diagram-select-all (state) =
    let r1 = __record-set state "da-selection" (dsel-select-all state.da-selection state.da-diagram)
    in __record-set r1 "da-dirty" True

  diagram-escape : DiagramAppState -> DiagramAppState
  diagram-escape (state) =
    let r1 = __record-set state "da-selection" (selection-clear state.da-selection)
    in let r2 = __record-set r1 "da-connecting" None
    in let r3 = __record-set r2 "da-editing" None
    in __record-set r3 "da-dirty" True

Section: Drag

  diagram-end-drag : DiagramAppState -> DiagramAppState
  diagram-end-drag (state) =
    let delta = selection-drag-delta state.da-selection
    in let dx = real-to-int delta.v2x
    in let dy = real-to-int delta.v2y
    in if dx == 0 & dy == 0 then __record-set state "da-selection" (__record-set state.da-selection "sel-dragging" False)
    else let saved = command-push state.da-history state.da-diagram
    in let moved = move-selected-nodes state.da-diagram state.da-selection.sel-ids dx dy
    in let r1 = __record-set state "da-diagram" moved
    in let r2 = __record-set r1 "da-selection" (__record-set state.da-selection "sel-dragging" False)
    in let r3 = __record-set r2 "da-history" saved
    in __record-set r3 "da-dirty" True

  move-selected-nodes : Diagram, List Integer, Integer, Integer -> Diagram
  move-selected-nodes (dg) (ids) (dx) (dy) =
    move-selected-loop dg ids dx dy 0

  move-selected-loop : Diagram, List Integer, Integer, Integer, Integer -> Diagram
  move-selected-loop (dg) (ids) (dx) (dy) (i) =
    if i >= list-length ids then dg
    else let id = list-at ids i
    in let node = diagram-find-node dg id
    in let moved = when node
          is None -> dg
          is Just (n) -> diagram-move-node dg id (n.dn-x + dx) (n.dn-y + dy)
    in move-selected-loop moved ids dx dy (i + 1)

Section: Node Placement

  diagram-place-node : DiagramAppState, ShapeDef, Integer, Integer -> DiagramAppState
  diagram-place-node (state) (sd) (x) (y) =
    let saved = command-push state.da-history state.da-diagram
    in let dg = diagram-add-node state.da-diagram sd.sd-shape x y sd.sd-width sd.sd-height sd.sd-name
    in let new-id = dg.dg-next-id - 1
    in let r1 = __record-set state "da-diagram" dg
    in let r2 = __record-set r1 "da-selection" (selection-select state.da-selection new-id)
    in let r3 = __record-set r2 "da-history" saved
    in let r4 = __record-set r3 "da-toolbar" (toolbar-set-tool state.da-toolbar ToolSelect)
    in __record-set r4 "da-dirty" True

Section: Connections

  diagram-start-connect : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-start-connect (state) (dx) (dy) =
    let hit = node-at-point state.da-diagram dx dy
    in when hit
      is None -> state
      is Just (n) ->
        let r1 = __record-set state "da-connecting" (Just (ConnectState { cn-source-id = n.dn-id, cn-mouse-x = dx, cn-mouse-y = dy }))
        in __record-set r1 "da-status" ("Connecting from: " & n.dn-label)

  diagram-finish-connect : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-finish-connect (state) (mx) (my) =
    when state.da-connecting
      is None -> state
      is Just (cn) ->
        let dx = screen-to-diagram-x state.da-canvas (mx - palette-width)
        in let dy = screen-to-diagram-y state.da-canvas (my - toolbar-height)
        in let hit = node-at-point state.da-diagram dx dy
        in when hit
          is None ->
            __record-set (__record-set state "da-connecting" None) "da-dirty" True
          is Just (tgt) ->
            if tgt.dn-id == cn.cn-source-id
            then __record-set (__record-set state "da-connecting" None) "da-dirty" True
            else let saved = command-push state.da-history state.da-diagram
              in let dg = diagram-add-edge state.da-diagram cn.cn-source-id tgt.dn-id ""
              in let r1 = __record-set state "da-diagram" dg
              in let r2 = __record-set r1 "da-history" saved
              in let r3 = __record-set r2 "da-connecting" None
              in let r4 = __record-set r3 "da-status" "Edge added"
              in __record-set r4 "da-dirty" True

Section: Text Editing

  diagram-start-edit-at : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-start-edit-at (state) (dx) (dy) =
    let hit = node-at-point state.da-diagram dx dy
    in when hit
      is None -> state
      is Just (n) ->
        __record-set state "da-editing" (Just (EditState {
          ed-node-id = n.dn-id,
          ed-text = n.dn-label,
          ed-cursor = text-length n.dn-label
        }))

  diagram-handle-edit-key : DiagramAppState, EditState, Integer -> DiagramAppState
  diagram-handle-edit-key (state) (ed) (k) =
    if k == 13
      then let saved = command-push state.da-history state.da-diagram
        in let dg = diagram-set-label state.da-diagram ed.ed-node-id ed.ed-text
        in let r1 = __record-set state "da-diagram" dg
        in let r2 = __record-set r1 "da-editing" None
        in __record-set r2 "da-history" saved
      else if k == 27
      then __record-set state "da-editing" None
      else if k == 8
      then if ed.ed-cursor > 0
        then let new-text = text-take ed.ed-text (ed.ed-cursor - 1)
                & text-drop ed.ed-text ed.ed-cursor
          in let inner = __record-set state "da-editing" (Just (__record-set (__record-set ed "ed-text" new-text) "ed-cursor" (ed.ed-cursor - 1)))
          in __record-set inner "da-dirty" True
        else state
      else if k >= 32
      then let ch = char-encode (code-to-char (from-unicode k))
        in let new-text = text-take ed.ed-text ed.ed-cursor & ch & text-drop ed.ed-text ed.ed-cursor
        in let inner = __record-set state "da-editing" (Just (__record-set (__record-set ed "ed-text" new-text) "ed-cursor" (ed.ed-cursor + 1)))
        in __record-set inner "da-dirty" True
      else state

Section: Delete

  diagram-delete-selected : DiagramAppState -> DiagramAppState
  diagram-delete-selected (state) =
    if dsel-is-empty state.da-selection then state
    else let saved = command-push state.da-history state.da-diagram
    in let dg = delete-ids state.da-diagram state.da-selection.sel-ids
    in let r1 = __record-set state "da-diagram" dg
    in let r2 = __record-set r1 "da-selection" (selection-clear state.da-selection)
    in let r3 = __record-set r2 "da-history" saved
    in __record-set r3 "da-dirty" True

  delete-ids : Diagram, List Integer -> Diagram
  delete-ids (dg) (ids) =
    if list-length ids == 0 then dg
    else let id = list-at ids 0
        in delete-ids (diagram-delete-node dg id) (list-drop ids 1)

Section: Undo/Redo

  diagram-undo : DiagramAppState -> DiagramAppState
  diagram-undo (state) =
    if command-can-undo state.da-history == False then state
    else let result = command-undo state.da-history state.da-diagram
    in when result
      is (new-hist, prev-dg) ->
        let r1 = __record-set state "da-diagram" prev-dg
        in let r2 = __record-set r1 "da-history" new-hist
        in __record-set r2 "da-dirty" True

  diagram-redo : DiagramAppState -> DiagramAppState
  diagram-redo (state) =
    if command-can-redo state.da-history == False then state
    else let result = command-redo state.da-history state.da-diagram
    in when result
      is (new-hist, next-dg) ->
        let r1 = __record-set state "da-diagram" next-dg
        in let r2 = __record-set r1 "da-history" new-hist
        in __record-set r2 "da-dirty" True

Section: Nudge

  diagram-nudge : DiagramAppState, Integer, Integer -> DiagramAppState
  diagram-nudge (state) (dx) (dy) =
    if dsel-is-empty state.da-selection then state
    else let grid = state.da-diagram.dg-grid
    in let step-x = if state.da-diagram.dg-snap then dx * grid else dx
    in let step-y = if state.da-diagram.dg-snap then dy * grid else dy
    in let saved = command-push state.da-history state.da-diagram
    in let moved = move-selected-nodes state.da-diagram state.da-selection.sel-ids step-x step-y
    in let r1 = __record-set state "da-diagram" moved
    in let r2 = __record-set r1 "da-history" saved
    in __record-set r2 "da-dirty" True

Section: Toggle Operations

  diagram-toggle-grid : DiagramAppState -> DiagramAppState
  diagram-toggle-grid (state) =
    let new-grid = if state.da-diagram.dg-grid > 0 then 0 else 20
    in let r1 = __record-set state "da-diagram" (__record-set state.da-diagram "dg-grid" new-grid)
    in __record-set r1 "da-dirty" True

  diagram-toggle-snap : DiagramAppState -> DiagramAppState
  diagram-toggle-snap (state) =
    let r1 = __record-set state "da-diagram" (__record-set state.da-diagram "dg-snap" (if state.da-diagram.dg-snap then False else True))
    in __record-set r1 "da-dirty" True

Section: New/Save

  diagram-new-diagram : DiagramAppState -> DiagramAppState
  diagram-new-diagram (state) =
    let r1 = __record-set state "da-diagram" (diagram-new "Untitled" state.da-toolbar.tb-diagram-type)
    in let r2 = __record-set r1 "da-selection" (selection-clear state.da-selection)
    in __record-set r2 "da-dirty" True

  diagram-save : DiagramAppState -> DiagramAppState
  diagram-save (state) =
    __record-set state "da-status" "Saving..."

Section: Toolbar Clicks

  diagram-handle-toolbar-click : DiagramAppState, Integer -> DiagramAppState
  diagram-handle-toolbar-click (state) (mx) =
    let btn-width = 60
    in let btn-index = mx / btn-width
    in if btn-index == 0 then __record-set state "da-toolbar" (toolbar-set-tool state.da-toolbar ToolSelect)
    else if btn-index == 1 then __record-set state "da-toolbar" (toolbar-set-tool state.da-toolbar ToolConnect)
    else if btn-index == 2 then __record-set state "da-toolbar" (toolbar-set-tool state.da-toolbar ToolText)
    else if btn-index == 3 then __record-set state "da-toolbar" (toolbar-set-tool state.da-toolbar ToolPan)
    else state

  diagram-handle-palette-click : DiagramAppState, Integer -> DiagramAppState
  diagram-handle-palette-click (state) (my) =
    let shapes = shapes-for-type state.da-toolbar.tb-diagram-type
    in let btn-height = 32
    in let idx = (my - toolbar-height) / btn-height
    in if idx >= 0 then if idx < list-length shapes
      then let sd = list-at shapes idx
        in let r1 = __record-set state "da-toolbar" (toolbar-set-tool state.da-toolbar (ToolAddNode sd))
        in __record-set r1 "da-status" ("Place: " & sd.sd-name)
      else state
    else state

Section: Scroll

  diagram-handle-scroll : DiagramAppState, Integer -> DiagramAppState
  diagram-handle-scroll (state) (dy) =
    let r1 = __record-set state "da-canvas" (canvas-scroll-by state.da-canvas 0 (dy * 30))
    in __record-set r1 "da-dirty" True

Section: Rendering

  diagram-render-frame : DiagramAppState -> Framebuf
  diagram-render-frame (state) =
    canvas-render state.da-canvas state.da-diagram state.da-selection.sel-ids

Section: Main Loop

  diagram-app-run : DiagramAppState -> [Console] Nothing
  diagram-app-run (state) = act
    print-line ("  Type: " & diagram-type-name state.da-diagram.dg-type)
    print-line ("  Canvas: " & format-canvas state.da-canvas)
    print-line "  Ready."
    diagram-event-loop state
  end

  diagram-event-loop : DiagramAppState -> [Console] Nothing
  diagram-event-loop (state) = act
    ev <- diagram-poll-event
    let handled = diagram-handle-event state ev
    in diagram-event-loop handled
  end

  diagram-poll-event : [Console] Event
  diagram-poll-event = act
    let scan = poll-key
    in if scan == 0
      then event-timer "tick" 0
      else event-key-down scan poll-mods 0
  end
