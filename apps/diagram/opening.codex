Section: Entry Point

  opening : [Console] Nothing
  opening = act
    let ds = disk-load
    in let theme = diagram-theme-default
    in let state = diagram-app-init 1024 768 theme
    in let restored = diagram-persist-load ds
    in let with-saved = when restored
          is Just (dg) ->
            let s1 = __record-set state "da-diagram" dg
            in __record-set s1 "da-status" "Loaded from disk"
          is None -> state
    in let ds2 = app-log-info ds "diagram" "Diagram started" 0
    in act
      print-line "Codex Diagram v0.1"
      print-line ("  Disk: " & show (disk-fact-count ds2) & " facts")
      diagram-run-loop with-saved ds2
    end
  end

Section: Persistent Event Loop

  PersistState = record {
    ps-app : DiagramAppState,
    ps-disk : DiskFactStore
  }

  diagram-run-loop : DiagramAppState, DiskFactStore -> [Console] Nothing
  diagram-run-loop (state) (ds) = act
    let scan = poll-key
    in let ev = if scan == 0
          then event-timer "tick" 0
          else event-key-down scan poll-mods 0
    in let handled = diagram-handle-event state ev
    in let after-save = diagram-check-save handled ds ev
    in diagram-run-loop (after-save.ps-app) (after-save.ps-disk)
  end

  diagram-check-save : DiagramAppState, DiskFactStore, Event -> PersistState
  diagram-check-save (state) (ds) (ev) =
    if is-ctrl-s ev
    then let ds2 = diagram-persist-save ds state.da-diagram 0
      in let ds3 = app-log-info ds2 "diagram" "Diagram saved" 0
      in PersistState {
        ps-app = __record-set state "da-status" "Saved to disk",
        ps-disk = ds3
      }
    else PersistState { ps-app = state, ps-disk = ds }

  is-ctrl-s : Event -> Boolean
  is-ctrl-s (ev) =
    when ev.ev-kind
      is EvKeyDown (k) (mods) ->
        let ctrl = bit-and mods mod-ctrl > 0
        in if ctrl then key-upper k == char-code 'S' else False
      is otherwise -> False
