Chapter: LandingPage
  cites Site chapter SiteTheme

 We say:

Section: Page CSS

  landing-extra-css : Text
  landing-extra-css =
    ".landing{max-width:1100px;margin:0 auto;padding:0 24px}"
    & ".ground{position:relative;z-index:1;width:100%;background:linear-gradient(180deg,rgba(9,11,20,.58) 0%,rgba(9,11,20,.74) 12%,rgba(9,11,20,.74) 88%,rgba(9,11,20,.62) 100%)}"
    & ".cta-row{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:28px}"
    & ".cta{display:inline-block;padding:12px 22px;border-radius:10px;font-size:14px;font-weight:600;letter-spacing:.4px;border:1px solid rgba(212,160,23,.35);color:#d4a017;background:rgba(212,160,23,.08);transition:background .15s,transform .15s}"
    & ".cta:hover{background:rgba(212,160,23,.18);transform:translateY(-2px);text-decoration:none}"
    & ".cta-primary{background:#d4a017;color:#0a0a12;border-color:#d4a017}"
    & ".cta-primary:hover{background:#e8b52a;color:#0a0a12}"
    & ".hero-sub>.wk-label{display:inline}"
    & ".hero-sub>.em-text{display:block;margin-top:18px;font-size:1.15em;font-style:italic;color:#d4a017}"
    & ".hero-sub>.em-text>.wk-label{display:inline}"
    & ".code-body .code-line>.wk-label{display:inline}"
    & ".code-body .kw{display:inline;color:#d4a017}.code-body .kw>.wk-label{display:inline;color:#d4a017}"
    & ".code-body .ty{display:inline;color:#f1c40f}.code-body .ty>.wk-label{display:inline;color:#f1c40f}"
    & ".code-body .fn{display:inline;color:#58a6ff}.code-body .fn>.wk-label{display:inline;color:#58a6ff}"
    & ".code-body .cm{display:inline;color:#555;font-style:italic}.code-body .cm>.wk-label{display:inline;color:#555;font-style:italic}"
    & ".code-body .nu{display:inline;color:#e67e22}.code-body .nu>.wk-label{display:inline;color:#e67e22}"
    & ".code-body .st{display:inline;color:#2ecc71}.code-body .st>.wk-label{display:inline;color:#2ecc71}"

    & ".code-showcase{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}"

    & ".prism-mock{padding:0;display:grid;grid-template-columns:160px 1fr;grid-template-rows:36px 1fr;height:320px;font-family:'JetBrains Mono',monospace;font-size:11px}"
    & ".prism-toolbar{grid-column:1/-1;background:#1e1e2e;display:flex;align-items:center;padding:0 12px;gap:8px;border-bottom:1px solid #2a2a3a}"
    & ".prism-toolbar>.wk-label:first-child{color:#d4a017;font-weight:bold;font-size:12px;letter-spacing:1px}"
    & ".prism-toolbar>.wk-label:last-child{width:8px;height:8px;border-radius:50%;background:#3fb950;margin-left:auto;font-size:0;overflow:hidden}"
    & ".prism-nav{background:#161620;border-right:1px solid #1e1e2e;padding:8px;overflow:hidden}"
    & ".prism-nav>.wk-label{padding:4px 8px;color:#8b949e;border-radius:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px}"
    & ".prism-nav>.wk-label:first-child{background:#1e1e2e;color:#58a6ff}"
    & ".prism-src{padding:12px;overflow:hidden;color:#c8c8d8;line-height:1.6;font-size:11px}"
    & ".prism-src .ln{display:inline;color:#444;margin-right:8px}"
    & ".prism-src .ln>.wk-label{display:inline;color:#444}"
    & ".prism-src .kw{display:inline;color:#d4a017}.prism-src .kw>.wk-label{display:inline;color:#d4a017}"
    & ".prism-src .ty{display:inline;color:#f1c40f}.prism-src .ty>.wk-label{display:inline;color:#f1c40f}"
    & ".prism-src .fn{display:inline;color:#58a6ff}.prism-src .fn>.wk-label{display:inline;color:#58a6ff}"
    & ".prism-src .cm{display:inline;color:#555;font-style:italic}.prism-src .cm>.wk-label{display:inline;color:#555;font-style:italic}"
    & ".prism-src .code-line>.wk-label{display:inline}"

    & "#af0,#af1,#af2,#af3,#af4{position:absolute;font-size:24px;animation:swim 8s ease-in-out infinite}"
    & "#af0{top:20%;left:15%;animation-duration:7s}"
    & "#af1{top:40%;left:55%;animation-delay:-2s;animation-duration:9s}"
    & "#af2{top:60%;left:30%;animation-delay:-4s;animation-duration:6s}"
    & "#af3{top:35%;left:75%;animation-delay:-1s;animation-duration:8s}"
    & "#af4{top:70%;left:60%;animation-delay:-3s;animation-duration:10s}"
    & "#ac0,#ac1,#ac2,#ac3{position:absolute;bottom:0;font-size:32px}"
    & "#ac0{left:10%}#ac1{left:35%}#ac2{left:60%}#ac3{left:85%}"
    & "#ab0,#ab1,#ab2,#ab3{position:absolute;width:4px;height:4px;background:rgba(150,200,255,.3);border-radius:50%;animation:rise 6s linear infinite;font-size:0;overflow:hidden}"
    & "#ab0{left:20%;bottom:-10px}#ab1{left:45%;bottom:-10px;animation-delay:-2s}#ab2{left:70%;bottom:-10px;animation-delay:-4s}#ab3{left:55%;bottom:-10px;animation-delay:-1s}"
    & "#ray1,#ray2,#ray3{position:absolute;top:0;width:60px;height:100%;background:linear-gradient(180deg,rgba(100,180,255,.06),transparent);transform:skewX(-15deg);pointer-events:none;font-size:0;overflow:hidden}"
    & "#ray1{left:20%}#ray2{left:50%;opacity:.5}#ray3{left:75%;opacity:.3}"
    & "@keyframes swim{0%,100%{transform:translateX(0)}50%{transform:translateX(30px)}}"
    & "@keyframes rise{0%{transform:translateY(0);opacity:.3}100%{transform:translateY(-320px);opacity:0}}"

    & ".apps-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}"
    & ".app-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:10px;padding:16px;cursor:pointer;transition:all .2s}"
    & ".app-card:hover{border-color:#d4a017;transform:translateY(-2px)}"
    & ".app-card>.wk-label:first-child{font-size:24px;margin-bottom:8px}"
    & ".app-card>.wk-label:nth-child(2){font-size:14px;font-weight:600;color:#fff;margin-bottom:4px}"
    & ".app-card>.wk-label:nth-child(3){font-size:12px;color:#666;line-height:1.4}"

    & ".games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}"
    & ".game-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:8px;padding:12px;text-align:center;cursor:pointer;transition:all .2s}"
    & ".game-card:hover{border-color:#d4a017;background:#1a1a10}"
    & ".game-card>.wk-label:first-child{font-size:20px;margin-bottom:4px}"
    & ".game-card>.wk-label:last-child{font-size:13px;font-weight:500;color:#ccc}"


    & ".tab-bar{display:flex;justify-content:center;gap:8px;margin-bottom:24px}"
    & ".tab-btn{background:none;border:1px solid #1e1e2e;color:#8b949e;padding:8px 20px;border-radius:20px;cursor:pointer;font-size:13px;transition:all .15s}"
    & ".tab-btn:hover{border-color:#d4a017;color:#d4a017}"
    & ".tab-btn.active{background:linear-gradient(135deg,#d4a017,#c49010);border-color:#d4a017;color:#0a0a12}"

    & "@media(max-width:768px){.code-showcase{grid-template-columns:1fr}.prism-mock{grid-template-columns:1fr;height:280px}.prism-nav{display:none}}"

    & ".hero{background:linear-gradient(180deg,#16233a 0%,#33475f 60%,#607285 100%)}"
    & ".scene{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}"
    & ".scene-layer{position:absolute;left:-6%;width:112%;bottom:0;background-repeat:no-repeat;background-size:100% 100%;will-change:transform}"
    & ".layer-sky{aspect-ratio:1536/640;background-image:url(hero-sky.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 130px);mask-image:linear-gradient(180deg,transparent 0,#000 130px)}"
    & ".layer-ridge{aspect-ratio:1536/295;background-image:url(hero-ridge.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 30px);mask-image:linear-gradient(180deg,transparent 0,#000 30px)}"
    & ".layer-hills{aspect-ratio:1536/220;background-image:url(hero-hills.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 26px);mask-image:linear-gradient(180deg,transparent 0,#000 26px)}"
    & ".layer-road{aspect-ratio:1536/120;background-image:url(hero-road.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 22px);mask-image:linear-gradient(180deg,transparent 0,#000 22px)}"
    & ".layer-scrim{top:0;aspect-ratio:auto;background:radial-gradient(ellipse 52% 44% at 50% 42%,rgba(6,10,18,.60) 0%,rgba(6,10,18,.34) 58%,rgba(6,10,18,0) 82%),linear-gradient(180deg,rgba(6,10,18,0) 60%,rgba(6,10,18,.50) 82%,rgba(6,10,18,.30) 100%)}"
    & ".layer-vignette{top:0;aspect-ratio:auto;background:radial-gradient(ellipse at 50% 42%,transparent 46%,rgba(8,12,22,.58) 100%)}"

    & ".story-layer{position:absolute;inset:0;background-size:cover;background-position:center center;background-repeat:no-repeat;opacity:0;will-change:opacity,transform}"
    & ".story-fields{opacity:1;background:none}"
    & ".story-town{background-image:url(story-town.jpg)}"
    & ".story-bridge{background-image:url(story-bridge.jpg)}"
    & ".story-lake{background-image:url(story-lake.jpg)}"

    & "@keyframes cbdrift{to{transform:translateY(var(--cbd))}}"
    & "@keyframes cbreveal{from{opacity:0;transform:translateY(38px)}to{opacity:1;transform:none}}"
    & "@keyframes stFields{0%,18%{opacity:1;transform:none}30%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stTown{0%,18%{opacity:0;transform:translateY(50px)}30%,48%{opacity:1;transform:none}60%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stBridge{0%,48%{opacity:0;transform:translateY(50px)}60%,74%{opacity:1;transform:none}86%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stLake{0%,74%{opacity:0;transform:translateY(50px)}86%,100%{opacity:1;transform:none}}"
    & "@supports (animation-timeline:scroll()){"
    & ".scene-layer{animation:cbdrift linear both;animation-timeline:scroll(root block);animation-range:0 100vh}"
    & ".layer-sky{--cbd:40px}.layer-ridge{--cbd:130px}.layer-hills{--cbd:250px}.layer-road{--cbd:430px}.layer-scrim{--cbd:0px}.layer-vignette{--cbd:0px}"
    & ".story-layer{animation:none linear both;animation-timeline:scroll(root block)}"
    & ".story-fields{animation-name:stFields}.story-town{animation-name:stTown}.story-bridge{animation-name:stBridge}.story-lake{animation-name:stLake}"
    & ".landing>.section{animation:cbreveal linear both;animation-timeline:view();animation-range:entry 0% entry 55%}"
    & "}"
    & "@media(prefers-reduced-motion:reduce){.scene-layer,.story-layer,.landing>.section{animation:none}}"

Section: Tree

  landing-nav : WidgetNode
  landing-nav = site-nav [widget-label "nl0" "Language", widget-label "nl1" "Apps", widget-label "nl2" "Games", widget-label "nl3" "Prism", widget-label "nl4" "Compile in your browser"]

  landing-hero : WidgetNode
  landing-hero =
    widget-box "hero" "hero" [
      widget-box "scene" "scene" [
        widget-box "sc-fields" "story-layer story-fields" [
          widget-box "l-sky" "scene-layer layer-sky" [],
          widget-box "l-ridge" "scene-layer layer-ridge" [],
          widget-box "l-hills" "scene-layer layer-hills" [],
          widget-box "l-road" "scene-layer layer-road" []
        ],
        widget-box "sc-town" "story-layer story-town" [],
        widget-box "sc-bridge" "story-layer story-bridge" [],
        widget-box "sc-lake" "story-layer story-lake" [],
        widget-box "l-scrim" "scene-layer layer-scrim" [],
        widget-box "l-vig" "scene-layer layer-vignette" []
      ],
      widget-label "badge" "Self-Hosting &#x2022; Bare Metal &#x2022; From Scratch",
      widget-label "h-title" "COBBLESTONE",
      widget-box "h-sub" "hero-sub" [widget-label "h-sub-t" "A literate language and operating system, built from first principles for safety in the AI age. Comments in plain English become contracts the compiler enforces; every effect must be declared, every binary signed. You decide what to trust. Always.", widget-box "h-sub-e" "em-text" [widget-label "h-sub-et" "Welcome to Cobblestone."]],
      widget-box "stats" "hero-stats" [site-stat "s0" "56,000+" "Lines of Codex", site-stat "s1" "64" "Compiler Files", site-stat "s2" "69" "Apps", site-stat "s3" "41" "Days to Self-Host"]
    ]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      landing-nav,
      landing-hero,
      widget-box "ground" "ground" [ widget-box "body" "landing" [
        features-section 0,
        code-section 0,
        prism-section 0,
        repl-section 0,
        selfcompile-section 0,
        apps-section 0,
        games-section 0,
        site-footer [
          widget-label "fl0" "GitHub",
          widget-label "fl1" "Documentation",
          widget-label "fl2" "Prism",
          widget-label "fl3" "Online REPL"
        ]
      ] ]
    ]

Section: Features

  features-section : Integer -> WidgetNode
  features-section (x) =
    site-section "feat" "WHY COBBLESTONE" "Built Different" "Every piece designed together. No bolted-on toolchains, no inherited debt." [
      site-card-grid-3 "feat-grid" [
        site-card "f0" "&#x1F512;" "Safe by Construction" "Linear types, effect types, and dependent types. Memory safety with no garbage collector, and every allocation accounted for.",
        site-card "f1" "&#x2713;" "Proven, Not Asserted" "The build is the test. The compiler rebuilds itself byte for byte on every change, and nothing ships on a red gate.",
        site-card "f2" "&#x26A1;" "Straight to the Metal" "Boots on real hardware with no OS, no libc, and no runtime underneath. The compiler is the first program that runs.",
        site-card "f3" "&#x1F6E1;" "Trust You Can Check" "Signed artifacts, content hashes, and reproducible builds. Two builds of the same source agree byte for byte, so you can verify ours.",
        site-card "f4" "&#x1F527;" "Yours to Shape" "The compiler, the operating system and the toolchain are one source tree you can change. Fork a plug, retarget a backend, or rebuild the whole thing from a single seed.",
        site-card "f5" "&#x1F513;" "Nothing Hidden" "Every layer is source you can read, from the compiler up to the operating system. No black boxes and no vendor to take on faith.",
        site-card "f6" "&#x25A1;" "One Thing, Not Thirty" "No frameworks, no bundlers, no package manager, no build system to configure. One compiler and one source tree.",
        site-card "f7" "&#x1F916;" "Built for AI, by AI" "A fleet of agents writes this compiler and this operating system every day. The language is built for that: prose that carries meaning, effects that must be declared, and a build that proves itself instead of asking to be trusted.",
        site-card "f8" "&#x1F50C;" "Extensible" "New backends and new environments plug in. x86-64, RISC-V, ARM64 and WebAssembly are well featured today. Your phone and your tablet are coming soon."
      ]
    ]

