Section: CodexMagic

  magic-card-preview : Text, Text, Text, Text -> WidgetNode
  magic-card-preview (id) (gem) (name) (ty) =
    widget-box id "magic-card" [
      widget-label (id & "g") gem,
      widget-label (id & "n") name,
      widget-label (id & "t") ty
    ]

  magic-section : Integer -> WidgetNode
  magic-section (x) =
    site-section "magic" "COLLECTIBLE CARD GAME" "CodexMagic" "A collectible card game built entirely in Codex." [
      widget-box "magic-b" "magic-banner" [
        widget-box "magic-info" "magic-info" [
          widget-label "m-title" "CodexMagic",
          widget-label "m-desc" "A collectible card game built entirely in Codex. Original mechanics, subtractive color theory mana system, deterministic game engine. 69 cards, full economy, clan system, matchmaking &mdash; running on bare metal.",
          widget-box "m-tags" "magic-features" [
            widget-label "mt0" "Collectible Cards",
            widget-label "mt1" "Deck Building",
            widget-label "mt2" "Clan System",
            widget-label "mt3" "Marketplace",
            widget-label "mt4" "AI Opponents",
            widget-label "mt5" "Match History"
          ]
        ],
        widget-box "magic-demo" "magic-cards" [
          magic-card-preview "mc0" "&#x1F48E;" "Sapphire Golem" "Creature",
          magic-card-preview "mc1" "&#x2728;" "Prism Bolt" "Spell",
          magic-card-preview "mc2" "&#x1F6E1;" "Crystal Ward" "Equipment",
          magic-card-preview "mc3" "&#x1F525;" "Ruby Drake" "Creature",
          magic-card-preview "mc4" "&#x1F31F;" "Topaz Beacon" "Spell",
          magic-card-preview "mc5" "&#x1F300;" "Void Shard" "Artifact"
        ]
      ]
    ]

Section: Stack Timeline

  stack-section : Integer -> WidgetNode
  stack-section (x) =
    site-section "stack" "THE JOURNEY" "From Zero to Self-Hosting in 41 Days" "The bootstrap timeline of a compiler that compiles itself on bare metal." [
      site-timeline "timeline" [
        site-tl-event "t0" "March 14, 2026" "Project Started" "First commit. The vision: a new language, a new compiler, a new OS. Start from first principles, find the best implementation.",
        site-tl-event "t1" "March 28" "C# Reference Compiler" "Bootstrap stage 1 &mdash; a C# compiler that can parse Codex and emit x86-64 machine code. The training wheels.",
        site-tl-event "t2" "April 10" "Self-Host Begins" "The Codex compiler, written in Codex, starts compiling real programs. The C# compiler compiles the Codex compiler.",
        site-tl-event "t3" "April 18" "Pingpong" "Stage 2: the Codex compiler compiles itself. Output compiles itself again. Both outputs match &mdash; text-mode fixed point achieved.",
        site-tl-event "t4" "April 24" "The Cord is Cut" "Hard fixed point. The CDX binary compiled by itself is byte-identical to itself. No C# anywhere in the chain. 41 days from first commit.",
        site-tl-event "t5" "May &mdash; June" "The Ecosystem" "28 web apps, 44 games, 5 bare-metal apps, ARM64 and RISC-V backends, WASM output, AES-GCM crypto, CCE encoding for 27 languages."
      ]
    ]

Section: Handlers

  landing-click : Text -> Integer
  landing-click (id) =
    if text-starts-with id "a" then 0
    else if text-starts-with id "g" then 0
    else 0

Section: Entry

  render-landing : Integer -> Integer
  render-landing (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init landing-extra-css
    in let s = set-render render-landing
    in let h = register-handlers no-pick landing-click
    in render-landing 0
  end

