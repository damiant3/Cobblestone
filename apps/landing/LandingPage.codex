        widget-box "cb2-l2" "code-line" [widget-label "cb2-l2s" "  ", widget-box "cb2-l2k" "kw" [widget-label "cb2-l2kt" "let"], widget-label "cb2-l2s2" " tokens = ", widget-box "cb2-l2fn" "fn" [widget-label "cb2-l2fnt" "lex"], widget-label "cb2-l2s3" " src"],
        widget-box "cb2-l3" "code-line" [widget-label "cb2-l3s" "  ", widget-box "cb2-l3k" "kw" [widget-label "cb2-l3kt" "in let"], widget-label "cb2-l3s2" " ast = ", widget-box "cb2-l3fn" "fn" [widget-label "cb2-l3fnt" "parse"], widget-label "cb2-l3s3" " tokens"],
        widget-box "cb2-l4" "code-line" [widget-label "cb2-l4s" "  ", widget-box "cb2-l4k" "kw" [widget-label "cb2-l4kt" "in let"], widget-label "cb2-l4s2" " typed = ", widget-box "cb2-l4fn" "fn" [widget-label "cb2-l4fnt" "check"], widget-label "cb2-l4s3" " ast"],
        widget-box "cb2-l5" "code-line" [widget-label "cb2-l5s" "  ", widget-box "cb2-l5k" "kw" [widget-label "cb2-l5kt" "in let"], widget-label "cb2-l5s2" " ir = ", widget-box "cb2-l5fn" "fn" [widget-label "cb2-l5fnt" "lower"], widget-label "cb2-l5s3" " typed"],
        widget-box "cb2-l6" "code-line" [widget-label "cb2-l6s" "  ", widget-box "cb2-l6k" "kw" [widget-label "cb2-l6kt" "in let"], widget-label "cb2-l6s2" " code = ", widget-box "cb2-l6fn" "fn" [widget-label "cb2-l6fnt" "emit-x86"], widget-label "cb2-l6s3" " ir"],
        widget-box "cb2-l7" "code-line" [widget-label "cb2-l7s" "  ", widget-box "cb2-l7k" "kw" [widget-label "cb2-l7kt" "in"], widget-label "cb2-l7s2" " ", widget-box "cb2-l7fn" "fn" [widget-label "cb2-l7fnt" "link"], widget-label "cb2-l7s3" " code"],
        widget-box "cb2-l8" "code-line" [widget-box "cb2-l8k" "kw" [widget-label "cb2-l8kt" "end"]],
        widget-box "cb2-l9" "code-line" [widget-label "cb2-l9s" " "],
        widget-box "cb2-la" "code-line" [widget-box "cb2-lacm" "cm" [widget-label "cb2-lacmt" "The compiler compiles itself."]],
        widget-box "cb2-lb" "code-line" [widget-box "cb2-lbcm" "cm" [widget-label "cb2-lbcmt" "The output is byte-identical"]],
        widget-box "cb2-lc" "code-line" [widget-box "cb2-lccm" "cm" [widget-label "cb2-lccmt" "to the input."]]
      ]
    ]

  code-section : Integer -> WidgetNode
  code-section (x) =
    site-section "code" "THE LANGUAGE" "Code That Reads Like Prose" "Codex source is organized into quires, chapters, and sections, like a book." [
      widget-box "code-show" "code-showcase" [code-block-1, code-info-1],
      widget-box "code-show2" "code-showcase" [code-info-2, code-block-2]
    ]

Section: Prism Showcase

  prism-visual : WidgetNode
  prism-visual = widget-box "prism-vis" "showcase-visual" [widget-box "prism-scr" "prism-mock" [widget-box "prism-tb" "prism-toolbar" [widget-label "pt-logo" "PRISM", widget-label "pt-dot" "&shy;"], widget-box "prism-nv" "prism-nav" [widget-label "pn0" "Compiler.codex", widget-label "pn1" "Lexer.codex", widget-label "pn2" "Parser.codex", widget-label "pn3" "TypeCheck.codex", widget-label "pn4" "Emitter.codex", widget-label "pn5" "Linker.codex"], widget-box "prism-code" "prism-src" [widget-box "pc0" "code-line" [widget-box "pc0-l" "ln" [widget-label "pc0-lt" " 1"], widget-box "pc0-k" "kw" [widget-label "pc0-kt" "Chapter:"], widget-label "pc0-s" " ", widget-box "pc0-ty" "ty" [widget-label "pc0-tyt" "Compiler"]], widget-box "pc1" "code-line" [widget-box "pc1-l" "ln" [widget-label "pc1-lt" " 2"], widget-label "pc1-s" "  ", widget-box "pc1-k1" "kw" [widget-label "pc1-k1t" "cites"], widget-label "pc1-s2" " Core ", widget-box "pc1-k2" "kw" [widget-label "pc1-k2t" "chapter"], widget-label "pc1-s3" " ", widget-box "pc1-ty" "ty" [widget-label "pc1-tyt" "Lex"]], widget-box "pc2" "code-line" [widget-box "pc2-l" "ln" [widget-label "pc2-lt" " 3"], widget-label "pc2-s" "  ", widget-box "pc2-k1" "kw" [widget-label "pc2-k1t" "cites"], widget-label "pc2-s2" " Core ", widget-box "pc2-k2" "kw" [widget-label "pc2-k2t" "chapter"], widget-label "pc2-s3" " ", widget-box "pc2-ty" "ty" [widget-label "pc2-tyt" "Parse"]], widget-box "pc3" "code-line" [widget-box "pc3-l" "ln" [widget-label "pc3-lt" " 4"]], widget-box "pc4" "code-line" [widget-box "pc4-l" "ln" [widget-label "pc4-lt" " 5"], widget-label "pc4-s" " ", widget-box "pc4-cm" "cm" [widget-label "pc4-cmt" "The self-hosting compiler."]], widget-box "pc5" "code-line" [widget-box "pc5-l" "ln" [widget-label "pc5-lt" " 6"]], widget-box "pc6" "code-line" [widget-box "pc6-l" "ln" [widget-label "pc6-lt" " 7"], widget-label "pc6-s" " ", widget-box "pc6-k" "kw" [widget-label "pc6-kt" "We say:"]], widget-box "pc7" "code-line" [widget-box "pc7-l" "ln" [widget-label "pc7-lt" " 8"]], widget-box "pc8" "code-line" [widget-box "pc8-l" "ln" [widget-label "pc8-lt" " 9"], widget-label "pc8-s" "  ", widget-box "pc8-fn" "fn" [widget-label "pc8-fnt" "compile"], widget-label "pc8-s2" " : ", widget-box "pc8-ty1" "ty" [widget-label "pc8-ty1t" "Source"], widget-label "pc8-s3" " -&gt; ", widget-box "pc8-ty2" "ty" [widget-label "pc8-ty2t" "Binary"]]]]]

  prism-info : WidgetNode
  prism-info = site-showcase-info "prism-info" "One Source, Every Backend" "Write your program in Codex once. Prism compiles it to every target in real time and displays the output side by side. See exactly what x86-64 instructions your function generates, compare ARM64 output, inspect the WASM module, or read the JavaScript transpilation." [site-tag "prt0" "x86-64", site-tag "prt1" "ARM64", site-tag "prt2" "RISC-V", site-tag "prt3" "WASM", site-tag "prt4" "JavaScript", site-tag "prt5" "Python", site-tag "prt6" "Rust", site-tag "prt7" "Go", site-tag "prt8" "Haskell"]

  site-link : Text, Text, Text, Text -> WidgetNode
  site-link (id) (cls) (href) (label) =
    wk-attach (widget-custom id ("link:" & cls & "|" & href) 0 0) [widget-label (id & "t") label] 0 1

  prism-cta : WidgetNode
  prism-cta =
    widget-box "prism-cta" "cta-row" [
      site-link "prism-open" "cta cta-primary" "compile/prism.html" "Open Prism",
      site-link "prism-src" "cta" "https://github.com/damiant3/Cobblestone/tree/master/apps/prism" "Get Prism source"
    ]

  prism-section : Integer -> WidgetNode
  prism-section (x) =
    site-section "prism" "COMPILER EXPLORER" "See What the Compiler Sees" "Write Codex at the top of Prism and the compiler answers underneath, compiled in your own browser tab with no server asked anything. The intermediate representation, JavaScript and C# all run there today, and you can run the emitted JavaScript on the page; each remaining target lights up as its plug is compiled to WebAssembly." [site-showcase "prism-show" prism-visual prism-info, prism-cta]

Section: Online REPL

  repl-section : Integer -> WidgetNode
  repl-section (x) =
    site-section "repl" "THE ONLINE REPL" "Watch It Compile, Then Watch It Run" "Pick one of the prepared subjects and the server walks the whole pipeline in front of you: Codex source to IR, IR to Zig, Zig to a native binary, and then the binary's own output. Written by Steve Howell against the public repository." [
      site-card-grid-3 "repl-grid" [
        site-card "r0" "&#x1F50E;" "Four Stages, No Black Box" "Most online REPLs hand you an answer and hide the machine. This one shows every stage: the IR, the generated Zig, the executable, and only then the program's output.",
        site-card "r1" "&#x1F6E1;" "Every Press Is Sandboxed" "Each stage runs in its own scope with a memory cap and a clock. The run stage executes generated code, so the whole scope is killed on time rather than trusting one process to stop politely.",
        site-card "r2" "&#x1F4C1;" "No Stale Artifacts" "Every press mints a fresh run directory and each stage reads and writes only inside it, so no stage can ever answer from an earlier run's output.",
        site-card "r3" "&#x1F91D;" "Built From Outside" "Steve Howell built it against the public repository. His first pull request also found two real defects that nothing we had could see.",
        site-card "r4" "&#x26A1;" "A Second Backend, in Zig" "The Zig backend the REPL compiles through is his too. So the binary you watch run was emitted by an independently written backend rather than our own x86 one, and two implementations that have to agree is how you catch a compiler lying to you.",
        site-card "r5" "&#x1F30E;" "Built in Public" "The Cobblestone way. The repository is public, outside pull requests are absorbed with credit, and the defects they turn up are written into the open register rather than quietly fixed."
      ],
      widget-box "repl-cta" "cta-row" [
        site-link "repl-go" "cta cta-primary" "http://143.244.172.148:9100/repl" "Open the REPL",
        site-link "repl-src" "cta" "https://github.com/showell/essay-repl-server" "Get the online REPL source"
      ]
    ]

Section: Self Compile

  selfcompile-section : Integer -> WidgetNode
  selfcompile-section (x) =
    site-section "selfcompile" "IN YOUR BROWSER" "The Compiler Builds Itself" "The Codex compiler, compiled to WebAssembly by its own plug, compiles its complete source in a browser tab and proves the output byte-identical to the same compiler on bare metal." [
      site-card-grid-3 "sc-cards" [
        site-card "sc0" "&#x1F5A5;" "No server" "The module and the source are fetched once. Every phase after that runs in the tab.",
        site-card "sc1" "&#x1F4C4;" "2,458,206 characters" "Emitted by the compiler compiling itself, in about eleven seconds.",
        site-card "sc2" "&#x2713;" "Byte-identical" "SHA-256 of the output equals the bare-metal reference, computed fresh at page build."
      ],
      widget-box "sc-cta" "cta-row" [
        site-link "sc-open" "cta cta-primary" "compile/index.html" "Compile the compiler"
      ]
    ]


