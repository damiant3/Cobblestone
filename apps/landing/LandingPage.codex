Chapter: LandingPage
  cites Site chapter SiteTheme

 We say:

Section: Page CSS

  landing-extra-css : Text
  landing-extra-css =
    ".landing{max-width:1100px;margin:0 auto;padding:0 24px}"
    & ".ground{position:relative;z-index:1;width:100%;background:linear-gradient(180deg,rgba(9,11,20,.58) 0%,rgba(9,11,20,.74) 12%,rgba(9,11,20,.74) 88%,rgba(9,11,20,.62) 100%)}"
    & ".cta-row{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:28px}"
    & ".cta{display:inline-block;padding:12px 22px;border-radius:10px;font-size:14px;font-weight:600;letter-spacing:.4px;border:1px solid rgba(212,160,23,.35);color:#d4a017;background:rgba(212,160,23,.08);transition:background .15s,transform .15s}"
    & ".cta:hover{background:rgba(212,160,23,.18);transform:translateY(-2px);text-decoration:none}"
    & ".cta-primary{background:#d4a017;color:#0a0a12;border-color:#d4a017}"
    & ".cta-primary:hover{background:#e8b52a;color:#0a0a12}"
    & ".hero-sub>.wk-label{display:inline}"
    & ".hero-sub>.em-text{display:block;margin-top:18px;font-size:1.15em;font-style:italic;color:#fff}"
    & ".hero-sub>.em-text>.wk-label{display:inline}"

    & ".nav>.wk-label{color:#fff}"
    & ".nav-links .nav-a{color:#8b949e;font-size:14px;transition:color .15s}"
    & ".nav-links .nav-a:hover{color:#e0e0e8;text-decoration:none}"
    & "#badge{background:rgba(255,255,255,.10);color:#fff;border:1px solid rgba(255,255,255,.35)}"
    & "#h-title{color:#fff}"
    & "#h-sub{color:#b8c2cc}"
    & ".stat{max-width:240px}"
    & ".stat>.wk-label:last-child{color:#b8c2cc;text-shadow:0 1px 8px rgba(0,0,0,.8)}"

    & ".prose{max-width:680px;margin:0 auto;font-size:15.5px;color:#c8ccd4;text-align:left}"
    & ".prose>.wk-label{display:block;margin-bottom:1em;line-height:1.65}"
    & ".prose-quote{border-left:3px solid #d4a017;padding-left:1.2em;color:#e0e0e8;font-style:italic;margin:1.4em 0}"
    & ".prose-quote>.wk-label{display:block;line-height:1.65}"
    & ".prose-fine{color:#8b949e;font-size:.9em}"
    & ".prose-fine>.wk-label{display:block;line-height:1.6}"

    & ".rq{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:26px 32px;margin:32px auto 0;max-width:720px;text-align:left}"
    & ".rq>.wk-label:first-child{display:block;font-style:italic;color:#e0e0e8;line-height:1.65}"
    & ".rq>.wk-label:last-child{display:block;color:#8b949e;font-size:13px;margin-top:10px;line-height:1.5}"

    & ".card{text-align:left}"
    & ".tagrow{margin-top:2px}"
    & ".tag{display:inline-block;border:1px solid #1e1e2e;border-radius:999px;padding:2px 12px;font-size:12px;color:#8b949e;margin:10px 4px 0 0}"
    & ".tag>.wk-label{display:inline}"
    & ".tag-ok{border-color:#2e5e2e;color:#7fc97f}.tag-ok>.wk-label{color:#7fc97f}"
    & ".tag-soon{border-color:#5e4e1e;color:#e8c04a}.tag-soon>.wk-label{color:#e8c04a}"
    & ".card-a{display:inline-block;margin-top:12px;color:#d4a017;font-size:14px}"
    & ".card-a:hover{color:#e8c04a}"

    & ".foot2{border-top:1px solid #1e1e2e;padding:48px 24px;text-align:center}"
    & ".foot2>.wk-label:first-child{display:block;color:#e8c04a;font-style:italic;max-width:38em;margin:0 auto 22px}"
    & ".foot2>.wk-label:last-child{display:block;color:#8b949e;font-size:13.5px;margin-top:22px}"
    & ".foot-links{display:flex;flex-wrap:wrap;gap:26px;justify-content:center}"
    & ".foot-links .fla{color:#8b949e;font-size:14px}"
    & ".foot-links .fla:hover{color:#e0e0e8;text-decoration:none}"

    & ".scene{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}"
    & ".scene-layer{position:absolute;left:-6%;width:112%;bottom:0;background-repeat:no-repeat;background-size:100% 100%;will-change:transform}"
    & ".layer-sky{aspect-ratio:1536/640;background-image:url(hero-sky.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 130px);mask-image:linear-gradient(180deg,transparent 0,#000 130px)}"
    & ".layer-ridge{aspect-ratio:1536/295;background-image:url(hero-ridge.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 30px);mask-image:linear-gradient(180deg,transparent 0,#000 30px)}"
    & ".layer-hills{aspect-ratio:1536/220;background-image:url(hero-hills.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 26px);mask-image:linear-gradient(180deg,transparent 0,#000 26px)}"
    & ".layer-road{aspect-ratio:1536/120;background-image:url(hero-road.jpg);-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 22px);mask-image:linear-gradient(180deg,transparent 0,#000 22px)}"
    & ".layer-scrim{top:0;aspect-ratio:auto;background:radial-gradient(ellipse 52% 44% at 50% 42%,rgba(6,10,18,.60) 0%,rgba(6,10,18,.34) 58%,rgba(6,10,18,0) 82%),linear-gradient(180deg,rgba(6,10,18,0) 60%,rgba(6,10,18,.50) 82%,rgba(6,10,18,.30) 100%)}"
    & ".layer-vignette{top:0;aspect-ratio:auto;background:radial-gradient(ellipse at 50% 42%,transparent 46%,rgba(8,12,22,.58) 100%)}"

    & ".story-layer{position:absolute;inset:0;background-size:cover;background-position:center center;background-repeat:no-repeat;opacity:0;will-change:opacity,transform}"
    & ".story-fields{opacity:1;background:none}"
    & ".story-town{background-image:url(story-town.jpg)}"
    & ".story-bridge{background-image:url(story-bridge.jpg)}"
    & ".story-lake{background-image:url(story-lake.jpg)}"

    & "@keyframes cbdrift{to{transform:translateY(var(--cbd))}}"
    & "@keyframes cbreveal{from{opacity:0;transform:translateY(38px)}to{opacity:1;transform:none}}"
    & "@keyframes stFields{0%,18%{opacity:1;transform:none}30%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stTown{0%,18%{opacity:0;transform:translateY(50px)}30%,48%{opacity:1;transform:none}60%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stBridge{0%,48%{opacity:0;transform:translateY(50px)}60%,74%{opacity:1;transform:none}86%,100%{opacity:0;transform:translateY(-40px)}}"
    & "@keyframes stLake{0%,74%{opacity:0;transform:translateY(50px)}86%,100%{opacity:1;transform:none}}"
    & "@supports (animation-timeline:scroll()){"
    & ".scene-layer{animation:cbdrift linear both;animation-timeline:scroll(root block);animation-range:0 100vh}"
    & ".layer-sky{--cbd:40px}.layer-ridge{--cbd:130px}.layer-hills{--cbd:250px}.layer-road{--cbd:430px}.layer-scrim{--cbd:0px}.layer-vignette{--cbd:0px}"
    & ".story-layer{animation:none linear both;animation-timeline:scroll(root block)}"
    & ".story-fields{animation-name:stFields}.story-town{animation-name:stTown}.story-bridge{animation-name:stBridge}.story-lake{animation-name:stLake}"
    & ".landing>.section{animation:cbreveal linear both;animation-timeline:view();animation-range:entry 0% entry 55%}"
    & "}"
    & "@media(prefers-reduced-motion:reduce){.scene-layer,.story-layer,.landing>.section{animation:none}}"

Section: Builders

  site-link : Text, Text, Text, Text -> WidgetNode
  site-link (id) (cls) (href) (label) =
    wk-attach (widget-custom id ("link:" & cls & "|" & href) 0 0) [widget-label (id & "t") label] 0 1

  land-card : Text, Text, Text, Text -> WidgetNode
  land-card (id) (icon) (title) (desc) =
    widget-box id "card" [
      widget-label (id & "i") icon,
      widget-label (id & "n") title,
      widget-label (id & "d") desc
    ]

  land-card-fine : Text, Text, Text, Text, Text -> WidgetNode
  land-card-fine (id) (icon) (title) (desc) (fine) =
    widget-box id "card" [
      widget-label (id & "i") icon,
      widget-label (id & "n") title,
      widget-label (id & "d") desc,
      widget-label (id & "f") fine
    ]

  land-tag : Text, Text, Text -> WidgetNode
  land-tag (id) (cls) (label) =
    widget-box id ("tag " & cls) [widget-label (id & "t") label]

Section: Tree

  landing-nav : WidgetNode
  landing-nav = site-nav [
    site-link "nl0" "nav-a" "#promise" "The Promise",
    site-link "nl1" "nav-a" "#family" "For Families",
    site-link "nl2" "nav-a" "#business" "For Business",
    site-link "nl3" "nav-a" "#today" "Try It",
    site-link "nl4" "nav-a" "#join" "Join the Build"
  ]

  landing-hero : WidgetNode
  landing-hero =
    widget-box "hero" "hero" [
      widget-box "scene" "scene" [
        widget-box "sc-fields" "story-layer story-fields" [
          widget-box "l-sky" "scene-layer layer-sky" [],
          widget-box "l-ridge" "scene-layer layer-ridge" [],
          widget-box "l-hills" "scene-layer layer-hills" [],
          widget-box "l-road" "scene-layer layer-road" []
        ],
        widget-box "sc-town" "story-layer story-town" [],
        widget-box "sc-bridge" "story-layer story-bridge" [],
        widget-box "sc-lake" "story-layer story-lake" [],
        widget-box "l-scrim" "scene-layer layer-scrim" [],
        widget-box "l-vig" "scene-layer layer-vignette" []
      ],
      widget-label "badge" "Software that has to prove it",
      widget-label "h-title" "COBBLESTONE",
      widget-box "h-sub" "hero-sub" [widget-label "h-sub-t" "Every app on your phone asks you to trust it. On your PC, the app doesn&#39;t even ask. Cobblestone is a new software ecosystem, built from the ground up in public, where trust is not a request: a program must declare what it touches, prove what it promises, and cannot do anything else. You decide what to trust. Always.", widget-box "h-sub-e" "em-text" [widget-label "h-sub-et" "Welcome to Cobblestone."]],
      widget-box "hero-cta" "cta-row" [
        site-link "hc0" "cta cta-primary" "compile/prism.html" "Compile code in your browser, right now",
        site-link "hc1" "cta" "compile/index.html" "Watch the compiler build itself"
      ],
      widget-box "stats" "hero-stats" [
        site-stat "s0" "0" "ways a program can touch your camera, files, or network without saying so",
        site-stat "s1" "0" "dependencies on legacy code: no 1970s-vintage, unsafe-by-design toolchains underneath",
        site-stat "s2" "52" "languages and chip architectures one program can become, from x86 to JavaScript to COBOL",
        site-stat "s3" "2027" "the EU security deadline our evidence engine is built for"
      ]
    ]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      landing-nav,
      landing-hero,
      widget-box "ground" "ground" [ widget-box "body" "landing" [
        promise-section 0,
        family-section 0,
        honesty-section 0,
        business-section 0,
        today-section 0,
        join-section 0,
        landing-footer
      ] ]
    ]

Section: The Promise

  promise-section : Integer -> WidgetNode
  promise-section (x) =
    site-section "promise" "THE PROMISE" "Code That Does What It Says. Nothing Else." "In today&#39;s software, safety is a policy: an app-store rule, a privacy checkbox, a company&#39;s word. Policies are promises, and promises get broken. Cobblestone makes the promise physics: the machine refuses to build a program that violates it, so the violation never exists to be caught." [
      site-card-grid-3 "promise-grid" [
        land-card-fine "pr0" "&#x1F50F;" "The label is the law" "Every program carries its abilities in its own signature: this one reads files, that one uses the network. A recipe app that reads your contacts is not against the rules here. It is unwritable. There is no way to even express it without declaring it, and no way to run it without being granted it." "Working today, enforced on every build.",
        land-card-fine "pr1" "&#x1F9FE;" "It cannot lose what you hand it" "Files, connections, and money-like things must be accounted for exactly once. Forgetting to close, spending twice, losing track: these are not bugs to find later. The program will not build until the accounting is exact." "Working today, enforced on every build.",
        land-card-fine "pr2" "&#x23F1;" "On time, every time" "A piece of code can carry a proven worst case: it finishes on schedule and cannot eat all the memory. That is what a pacemaker, a car, or a flight controller actually needs, and here it is a property of the program, not a hope of the programmer." "Working today. We believe this is the only shipping language with it."
      ]
    ]

Section: For Families

  family-section : Integer -> WidgetNode
  family-section (x) =
    site-section "family" "FOR FAMILIES" "Rules Your Family Can Set, in Plain English" "" [
      widget-box "fam-prose" "prose" [
        widget-label "fam-p1" "Picture it: your kid asks the flight simulator for one more hour. The simulator checks a rule you wrote yourself, in your own words: \"weekends only, two hours a day.\" Your sentence was read back to you, confirmed, and compiled into the machine, signed with your name.",
        widget-box "fam-q" "prose-quote" [widget-label "fam-qt" "When the network drops, permission expires into safety, never into yes. Silence restricts. And when the machine says no, your kid can ask \"why not?\" and see the rule, and who made it."],
        widget-label "fam-p2" "No app store settings page buried five menus deep. No workaround a clever teenager can talk their way past: you cannot sweet-talk a math proof, and identities here are cryptographic, signed to the person, not a password a sibling can lend.",
        widget-box "fam-fine" "prose-fine" [widget-label "fam-ft" "Honestly labeled: the family accounts, screens, and time controls exist today; the full enforcement loop is the road we are on, and it is the next big destination on the map."]
      ]
    ]

Section: Governed In Public

  honesty-section : Integer -> WidgetNode
  honesty-section (x) =
    site-section "honesty" "BUILT BY AI, GOVERNED IN PUBLIC" "An AI Workforce Whose Failures Are Public Record, and Whose Successes Are Open Source" "Cobblestone is written every day by a fleet of AI agents under human command. That is not the surprising part. The surprising part is the constitution they work under, and what happens when one of them gets something wrong." [
      site-card-grid-3 "hon-grid" [
        land-card "ho0" "&#x2696;" "Truth outranks everything" "The fleet&#39;s first written rule: a failure is reported every time, in full. Nothing outranks it. Not deadlines, not politeness, not looking good. Nothing ships with a single failing test, and \"it was already broken\" is not an excuse.",
        land-card "ho1" "&#x1F4DC;" "Failures are published, by name" "Two agents once ended their day by writing public resignation letters into the project&#39;s own record: \"Five diagnoses in one session. Each stated like fact. Each wrong.\" The lesson became a standing rule. The letters are still there. Nothing is quietly rewritten here; corrections go at the top of the page.",
        land-card "ho2" "&#x1F50E;" "Even the checker is checked" "The machinery that verifies the safety claims is itself cross-examined by an independently written verifier, which had to prove it could catch planted lies (27 out of 27) before its agreement counted for anything. An instrument that cannot fail is not evidence."
      ],
      widget-box "hon-rq" "rq" [
        widget-label "hon-rq1" "\"Ten hours and a week of computing for zero typed characters is the score, and it is a fair score. The keyboard was never the hard part. Seeing was.\"",
        widget-label "hon-rq2" "From the project&#39;s own published account of a two-month hardware mystery: written up like an aviation accident report, because that is the standard the work is held to."
      ],
      widget-box "hon-prose" "prose" [
        widget-label "hon-p1" "Why should you care how the sausage is made? Because the same machinery that keeps this fleet honest is being built into the product: permissions AI agents cannot talk their way past, actions that land in a signed, permanent record, and claims that are measurements, not marketing."
      ]
    ]

Section: For Business

  business-section : Integer -> WidgetNode
  business-section (x) =
    site-section "business" "FOR BUSINESS" "Compliance Evidence That Rebuilds Itself" "If you ship a connected product into the EU, the Cyber Resilience Act&#39;s clock is already running: reporting duties begin in 2026 and full compliance is the price of staying on the market by the end of 2027. Today that means consultants, spreadsheets, and evidence that goes stale on the next firmware change." [
      site-card-grid-3 "biz-grid" [
        land-card-fine "bz0" "&#x1F4CB;" "The compiler is the auditor" "For a whole class of security requirements, the violation is a build error: if the firmware compiles, that evidence is valid by definition. Every build emits a signed evidence package mapping each requirement of the EU CRA, ETSI EN 303 645, IEC 62443, and the NIST IoT baseline to the mechanism that satisfies it." "The package never says \"compliant.\" It says which requirements the language makes impossible to violate, which are enforced by checks while the device runs, and which remain on your desk, printed as an explicit checklist. Before this page was written, every claim of protection was fired at the compiler itself; the ones that failed were withdrawn in public, and everything still claimed is pinned by a test that would fail the build if it ever stopped being true. That honesty is the feature.",
        land-card-fine "bz1" "&#x1F504;" "Devices that keep their footing" "Firmware updates arrive signed, verified twice, and switch over so that losing power at any instant leaves the device on the old version or the fully verified new one, never in between. Old firmware cannot be pushed back on. A driver cannot touch hardware it was not granted; a device cannot go to sleep holding a bus open. Those are build errors, not code reviews." "Proven in the test bed across nine real board families, from the chips in smart thermostats to Raspberry Pi to cellular and Bluetooth modules.",
        land-card-fine "bz2" "&#x1F9F1;" "One binary, no basement" "There is no operating system underneath, no decades-old code inherited from anywhere. The attack surface is your code plus what the compiler generated, and the compiler can prove what it generated: rebuild the same source anywhere and you get the identical binary, byte for byte. Roughly 70% of critical vulnerabilities industry-wide are memory-safety bugs; that entire class is unwritable here." "The 70% figure is industry research; the rest is measured in this tree, and we say which is which. Always."
      ]
    ]

Section: Try It

  today-section : Integer -> WidgetNode
  today-section (x) =
    site-section "today" "TRY IT" "Things You Can Touch Today" "This is not a whitepaper. A complete desktop boots on a bare PC: windows, taskbar, start menu, an editor, a live 3D scene with real shadows, an aquarium. None of it borrowed from Microsoft, Apple, or Linux. And some of it is one click away, right in this browser." [
      site-card-grid-3 "today-grid" [
        widget-box "td0" "card" [
          widget-label "td0i" "&#x1F52E;",
          widget-label "td0n" "Watch the compiler think",
          widget-label "td0d" "Prism is a page where you type code and watch it become the machine&#39;s own languages, side by side, live in your browser tab. Nothing is sent anywhere: your browser does the compiling.",
          site-link "td0a" "card-a" "compile/prism.html" "Open Prism &#8594;",
          widget-box "td0tr" "tagrow" [land-tag "td0t" "tag-ok" "working now"]
        ],
        widget-box "td1" "card" [
          widget-label "td1i" "&#x267B;",
          widget-label "td1n" "The compiler builds itself, in the page",
          widget-label "td1d" "The tool that builds everything else proves it hasn&#39;t been tampered with: handed its own blueprint, it produces itself, exactly, and the page checks the result against the real machine&#39;s answer. If the foundation were compromised, this is where it would show.",
          site-link "td1a" "card-a" "compile/index.html" "Compile the compiler &#8594;",
          widget-box "td1tr" "tagrow" [land-tag "td1t" "tag-ok" "working now"]
        ],
        widget-box "td2" "card" [
          widget-label "td2i" "&#x1F5A5;",
          widget-label "td2n" "A desktop from another timeline",
          widget-label "td2d" "The Cobblestone desktop: windows you can drag, minimize to the taskbar, and cycle with Tab; a start menu; fifteen built-in apps from a text editor to a system monitor to a live-shadowed 3D view. It boots from a USB stick on a plain PC.",
          widget-box "td2tr" "tagrow" [land-tag "td2t" "tag-ok" "demoable now", land-tag "td2u" "tag-soon" "consumer polish underway"]
        ],
        widget-box "td3" "card" [
          widget-label "td3i" "&#x1F41F;",
          widget-label "td3n" "Eye candy, no install",
          widget-label "td3d" "A flocking aquarium, forty GPU rendering demos, and a 3D star map, all running in your browser, all produced by the project&#39;s own compiler.",
          widget-box "td3tr" "tagrow" [land-tag "td3t" "tag-ok" "in your browser"]
        ],
        widget-box "td5" "card" [
          widget-label "td5i" "&#x1F52C;",
          widget-label "td5n" "Watch it compile, then watch it run",
          widget-label "td5d" "The online REPL walks the whole pipeline in front of you: your program becomes the compiler&#39;s inner language, then Zig, then a real executable, then its own output. Four stages, no black box, every press sandboxed. It compiles through an independently written backend, and two implementations that have to agree is how you catch a compiler lying.",
          site-link "td5a" "card-a" "http://143.244.172.148:9100/repl" "Open the REPL &#8594;",
          widget-box "td5tr" "tagrow" [land-tag "td5t" "tag-ok" "live now"]
        ],
        widget-box "td4" "card" [
          widget-label "td4i" "&#x1F3B2;",
          widget-label "td4n" "And yes, games",
          widget-label "td4d" "34 classics play today with opponents built in, Poker to Go to Monopoly. A fun proof that this is a real computer, not the point of it.",
          widget-box "td4tr" "tagrow" [land-tag "td4t" "tag-ok" "playable now"]
        ]
      ]
    ]

Section: Join the Build

  join-section : Integer -> WidgetNode
  join-section (x) =
    site-section "join" "JOIN THE BUILD" "This Road Gets Laid One Stone at a Time" "Cobblestone is built in public, and the build has room for more hands than ours. Three ways in, none of them requiring permission:" [
      site-card-grid-3 "join-grid" [
        widget-box "jn0" "card" [
          widget-label "jn0i" "&#x1F6E0;",
          widget-label "jn0n" "Developers",
          widget-label "jn0d" "The whole tree is public and every outside contribution lands with credit, in the open. An outside contributor&#39;s first pull request found two real defects our own instruments could not see; his independent Zig backend, its public test ladder, and the online REPL that compiles through it are part of the same open build. Come find the third defect.",
          site-link "jn0a" "card-a" "https://github.com/damiant3/Cobblestone" "github.com/damiant3/Cobblestone &#8594;",
          site-link "jn0b" "card-a" "https://github.com/showell/codex-zig-ladder" "Steve Howell&#39;s codex-zig-ladder &#8594;",
          site-link "jn0c" "card-a" "http://143.244.172.148:9100/repl" "The online REPL &#8594;"
        ],
        land-card "jn1" "&#x1F50C;" "Gadget people" "Nine board families have drivers today; the world has a thousand more. If you know your way around a dev board, a datasheet, or a soldering iron, there are drivers waiting to be born with your name on them.",
        land-card "jn2" "&#x1F4BE;" "Sitting volunteers" "A \"sitting\" is volunteer testing, and we won&#39;t dress that up: boot a fresh build on a real PC and tell us what the glass actually shows. But it is also the one step no simulator can replace, every machine answers a question nothing else can, and what you find goes into the permanent record with your name on it. A spare PC and a USB stick make you a laboratory."
      ],
      widget-box "join-rq" "rq" [
        widget-label "join-rq1" "\"The repository remembers everything. The language says what you mean. The machine checks that you meant it.\"",
        widget-label "join-rq2" "Where this goes next: a new home for the world&#39;s code, where nothing can be deleted or forged, every change carries its justification and its signatures, and trust is measured by proof instead of popularity. The foundations are built and tested; wiring the world to them is the road ahead."
      ]
    ]

Section: Footer

  landing-footer : WidgetNode
  landing-footer =
    widget-box "foot2" "foot2" [
      widget-label "foot-creed" "\"They call it crazy, right up until it boots.\"",
      widget-box "foot-links" "foot-links" [
        site-link "fl0" "fla" "https://github.com/damiant3/Cobblestone" "GitHub",
        site-link "fl1" "fla" "compile/prism.html" "Prism",
        site-link "fl2" "fla" "compile/index.html" "Self-compile"
      ],
      widget-label "foot-fine" "The Cobblestone Project &#xB7; Built with Codex, the language underneath &#xB7; Every claim on this page traces to a measured, public record, and the ones still on the road say so."
    ]

Section: Handlers

  landing-click : Text -> Integer
  landing-click (id) = 0

Section: Entry

  render-landing : Integer -> Integer
  render-landing (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init landing-extra-css
    in let s = set-render render-landing
    in let h = register-handlers no-pick landing-click
    in render-landing 0
  end

