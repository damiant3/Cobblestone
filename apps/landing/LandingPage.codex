Chapter: LandingPage
  cites Site chapter SiteTheme

 Welcome to codexmagic.org &mdash; the public face of the Codex project.
 A self-hosting compiler, a new programming language, a bare-metal
 operating system, and an ecosystem of apps &mdash; all built from first
 principles.

 We say:

Section: Page CSS

  landing-extra-css : Text
  landing-extra-css =
    ".landing{max-width:1100px;margin:0 auto;padding:0 24px}"

    & ".code-showcase{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}"

    & ".prism-mock{padding:0;display:grid;grid-template-columns:160px 1fr;grid-template-rows:36px 1fr;height:320px;font-family:'JetBrains Mono',Consolas,monospace;font-size:11px}"
    & ".prism-toolbar{grid-column:1/-1;background:#1e1e2e;display:flex;align-items:center;padding:0 12px;gap:8px;border-bottom:1px solid #2a2a3a}"
    & ".prism-toolbar>.wk-label:first-child{color:#d4a017;font-weight:bold;font-size:12px;letter-spacing:1px}"
    & ".prism-toolbar>.wk-label:last-child{width:8px;height:8px;border-radius:50%;background:#3fb950;margin-left:auto;font-size:0;overflow:hidden}"
    & ".prism-nav{background:#161620;border-right:1px solid #1e1e2e;padding:8px;overflow:hidden}"
    & ".prism-nav>.wk-label{padding:4px 8px;color:#8b949e;border-radius:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px}"
    & ".prism-nav>.wk-label:first-child{background:#1e1e2e;color:#58a6ff}"
    & ".prism-src{padding:12px;overflow:hidden;color:#c8c8d8;line-height:1.6;font-size:11px}"
    & ".prism-src .ln{color:#444;margin-right:8px}"
    & ".prism-src .kw{color:#d4a017}.prism-src .ty{color:#f1c40f}.prism-src .fn{color:#58a6ff}.prism-src .cm{color:#555;font-style:italic}"

    & ".aquarium-mock{height:320px;background:linear-gradient(180deg,#041830 0%,#082848 30%,#0a3060 60%,#0c2040 100%);position:relative;overflow:hidden}"
    & ".aquarium-mock::before{content:'';position:absolute;top:0;left:0;right:0;height:100%;background:linear-gradient(180deg,rgba(100,180,255,.03) 0%,rgba(20,80,140,.08) 100%);pointer-events:none}"
    & ".aquarium-mock::after{content:'';position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(180deg,transparent,rgba(30,60,40,.4));pointer-events:none}"
    & "#af0,#af1,#af2,#af3,#af4{position:absolute;font-size:24px;animation:swim 8s ease-in-out infinite}"
    & "#af0{top:20%;left:15%;animation-duration:7s}"
    & "#af1{top:40%;left:55%;animation-delay:-2s;animation-duration:9s}"
    & "#af2{top:60%;left:30%;animation-delay:-4s;animation-duration:6s}"
    & "#af3{top:35%;left:75%;animation-delay:-1s;animation-duration:8s}"
    & "#af4{top:70%;left:60%;animation-delay:-3s;animation-duration:10s}"
    & "#ac0,#ac1,#ac2,#ac3{position:absolute;bottom:0;font-size:32px}"
    & "#ac0{left:10%}#ac1{left:35%}#ac2{left:60%}#ac3{left:85%}"
    & "#ab0,#ab1,#ab2,#ab3{position:absolute;width:4px;height:4px;background:rgba(150,200,255,.3);border-radius:50%;animation:rise 6s linear infinite;font-size:0;overflow:hidden}"
    & "#ab0{left:20%;bottom:-10px}#ab1{left:45%;bottom:-10px;animation-delay:-2s}#ab2{left:70%;bottom:-10px;animation-delay:-4s}#ab3{left:55%;bottom:-10px;animation-delay:-1s}"
    & "#ray1,#ray2,#ray3{position:absolute;top:0;width:60px;height:100%;background:linear-gradient(180deg,rgba(100,180,255,.06),transparent);transform:skewX(-15deg);pointer-events:none;font-size:0;overflow:hidden}"
    & "#ray1{left:20%}#ray2{left:50%;opacity:.5}#ray3{left:75%;opacity:.3}"
    & ".aqua-hud{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;font-size:11px;color:rgba(150,200,255,.6);font-family:'JetBrains Mono',Consolas,monospace;z-index:1}"
    & ".aqua-hud>.wk-label{display:inline}"
    & "@keyframes swim{0%,100%{transform:translateX(0)}50%{transform:translateX(30px)}}"
    & "@keyframes rise{0%{transform:translateY(0);opacity:.3}100%{transform:translateY(-320px);opacity:0}}"

    & ".apps-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}"
    & ".app-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:10px;padding:16px;cursor:pointer;transition:all .2s}"
    & ".app-card:hover{border-color:#d4a017;transform:translateY(-2px)}"
    & ".app-card>.wk-label:first-child{font-size:24px;margin-bottom:8px}"
    & ".app-card>.wk-label:nth-child(2){font-size:14px;font-weight:600;color:#fff;margin-bottom:4px}"
    & ".app-card>.wk-label:nth-child(3){font-size:12px;color:#666;line-height:1.4}"

    & ".games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}"
    & ".game-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:8px;padding:12px;text-align:center;cursor:pointer;transition:all .2s}"
    & ".game-card:hover{border-color:#d4a017;background:#1a1a10}"
    & ".game-card>.wk-label:first-child{font-size:20px;margin-bottom:4px}"
    & ".game-card>.wk-label:last-child{font-size:13px;font-weight:500;color:#ccc}"

    & ".magic-banner{background:linear-gradient(135deg,#12121e 0%,#1a1810 50%,#12121e 100%);border:1px solid rgba(212,160,23,.2);border-radius:16px;padding:48px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}"
    & ".magic-info>.wk-label:first-child{font-size:28px;font-weight:800;color:#d4a017;margin-bottom:12px}"
    & ".magic-info>.wk-label:nth-child(2){font-size:15px;color:#aaa;line-height:1.7;margin-bottom:20px}"
    & ".magic-features{display:flex;flex-wrap:wrap;gap:8px}"
    & ".magic-features>.wk-label{display:inline-block;background:rgba(212,160,23,.1);color:#d4a017;font-size:12px;padding:4px 12px;border-radius:12px;border:1px solid rgba(212,160,23,.2)}"
    & ".magic-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}"
    & ".magic-card{background:rgba(255,255,255,.05);border:1px solid rgba(212,160,23,.15);border-radius:12px;padding:16px;text-align:center;transition:transform .2s,border-color .2s}"
    & ".magic-card:hover{transform:translateY(-3px);border-color:#d4a017}"
    & ".magic-card>.wk-label:first-child{font-size:28px;margin-bottom:8px}"
    & ".magic-card>.wk-label:nth-child(2){font-size:13px;font-weight:600;color:#fff;margin-bottom:4px}"
    & ".magic-card>.wk-label:last-child{font-size:11px;color:#666}"

    & ".tab-bar{display:flex;justify-content:center;gap:8px;margin-bottom:24px}"
    & ".tab-btn{background:none;border:1px solid #1e1e2e;color:#8b949e;padding:8px 20px;border-radius:20px;cursor:pointer;font-size:13px;transition:all .15s}"
    & ".tab-btn:hover{border-color:#d4a017;color:#d4a017}"
    & ".tab-btn.active{background:linear-gradient(135deg,#d4a017,#c49010);border-color:#d4a017;color:#0a0a12}"

    & "@media(max-width:768px){.code-showcase{grid-template-columns:1fr}.magic-banner{grid-template-columns:1fr;padding:24px}.prism-mock{grid-template-columns:1fr;height:280px}.prism-nav{display:none}}"

Section: Tree

  landing-nav : WidgetNode
  landing-nav = site-nav [widget-label "nl0" "Language", widget-label "nl1" "Apps", widget-label "nl2" "Games", widget-label "nl3" "CodexMagic", widget-label "nl4" "Timeline"]

  landing-hero : WidgetNode
  landing-hero = site-hero "Self-Hosting &#x2022; Bare Metal &#x2022; From Scratch" "CODEX" "A new programming language, self-sustaining compiler, and bare-metal operating system. Written from first principles. No C, no LLVM, no OS. <em>Just Codex, all the way down.</em>&shy;" [site-stat "s0" "28,000" "Lines of Codex", site-stat "s1" "54" "Source Files", site-stat "s2" "70+" "Web Apps", site-stat "s3" "41" "Days to Self-Host"]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      landing-nav,
      landing-hero,
      widget-box "body" "landing" [
        features-section 0,
        code-section 0,
        prism-section 0,
        aquarium-section 0,
        apps-section 0,
        games-section 0,
        magic-section 0,
        stack-section 0,
        site-footer [
          widget-label "fl0" "GitHub",
          widget-label "fl1" "Documentation",
          widget-label "fl2" "CodexMagic",
          widget-label "fl3" "Prism"
        ]
      ]
    ]

Section: Features

  features-section : Integer -> WidgetNode
  features-section (x) =
    site-section "feat" "WHY CODEX" "Built Different" "Every piece designed together. No bolted-on toolchains, no inherited debt." [
      site-card-grid-3 "feat-grid" [
        site-card "f0" "&#x1F4D6;" "Reads Like a Book" "Literate programming where prose is load-bearing. Chapters, sections, and citations replace files and imports.",
        site-card "f1" "&#x1F512;" "Secure by Design" "Linear types, effect types, dependent types. Memory safety without a garbage collector. Every allocation is accounted for.",
        site-card "f2" "&#x26A1;" "Bare Metal" "Boots on real hardware. No OS, no libc, no runtime. The compiler is the first program that runs.",
        site-card "f3" "&#x1F504;" "Self-Sustaining" "The compiler compiles itself. The output is byte-identical to the input. A hard fixed point &mdash; no external tools needed.",
        site-card "f4" "&#x1F310;" "Transpiles Everywhere" "One language, every target. x86-64 bare metal, WASM, JavaScript, ARM64, RISC-V. Write once, run anywhere &mdash; for real.",
        site-card "f5" "&#x1F3A8;" "Beautiful Code" "Codex Character Encoding. 27 European languages. Quire-based source organization. Code that humans and machines both love."
      ]
    ]

Section: Code Samples

  code-block-1 : WidgetNode
  code-block-1 = site-code-block "cb1" "WeatherPage.codex" "<span class='kw'>Chapter:</span> <span class='ty'>WeatherPage</span>\n  <span class='kw'>cites</span> UI <span class='kw'>chapter</span> <span class='ty'>Theme</span>\n  <span class='kw'>cites</span> WebApp <span class='kw'>chapter</span> <span class='ty'>WebRuntime</span>\n\n <span class='cm'>Weather dashboard with forecasts.</span>\n\n <span class='kw'>We say:</span>\n\n<span class='kw'>Section:</span> <span class='ty'>Theme</span>\n\n  <span class='fn'>weather-theme</span> : <span class='ty'>Theme</span>\n  <span class='fn'>weather-theme</span> =\n    <span class='kw'>let</span> p = <span class='ty'>Palette</span> {\n      pal-bg = <span class='nu'>#0E1126</span>,\n      pal-fg = <span class='nu'>#E1E1E1</span>\n    }\n    <span class='kw'>in</span> <span class='ty'>Theme</span> { th-name = <span class='st'>\"weather\"</span> }&shy;"

  code-info-1 : WidgetNode
  code-info-1 = site-showcase-info "ci1" "Literate Source" "Every Codex source file is a chapter in a book. Citations replace imports. Prose explains the code. The compiler reads the prose, not just the code." [site-tag "ci1a" "Chapters cite other chapters &mdash; dependency is explicit", site-tag "ci1b" "Sections organize definitions within a chapter", site-tag "ci1c" "Types, palettes, and widgets compose declaratively", site-tag "ci1d2" "Same source compiles to bare metal and to the browser"]

  code-info-2 : WidgetNode
  code-info-2 = site-showcase-info "ci2" "Type-Safe Everything" "Dependent types, linear types, and effect tracking. The type system catches bugs that tests miss. No null, no exceptions, no undefined behavior." [site-tag "ci2a" "Linear types enforce single-use resources", site-tag "ci2b" "Effect types track I/O, state, and allocation", site-tag "ci2c" "Pattern matching is exhaustive by default", site-tag "ci2d2" "No garbage collector &mdash; memory is deterministic"]

  code-block-2 : WidgetNode
  code-block-2 = site-code-block "cb2" "Compiler.codex" "<span class='fn'>compile</span> : <span class='ty'>Source</span> -&gt; [<span class='ty'>Emit</span>] <span class='ty'>Binary</span>\n<span class='fn'>compile</span> (src) = <span class='kw'>act</span>\n  <span class='kw'>let</span> tokens = <span class='fn'>lex</span> src\n  <span class='kw'>in let</span> ast = <span class='fn'>parse</span> tokens\n  <span class='kw'>in let</span> typed = <span class='fn'>check</span> ast\n  <span class='kw'>in let</span> ir = <span class='fn'>lower</span> typed\n  <span class='kw'>in let</span> code = <span class='fn'>emit-x86</span> ir\n  <span class='kw'>in</span> <span class='fn'>link</span> code\n<span class='kw'>end</span>\n\n<span class='cm'>The compiler compiles itself.</span>\n<span class='cm'>The output is byte-identical</span>\n<span class='cm'>to the input.</span>&shy;"

  code-section : Integer -> WidgetNode
  code-section (x) =
    site-section "code" "THE LANGUAGE" "Code That Reads Like Prose" "Codex source is organized into quires, chapters, and sections &mdash; like a book." [
      widget-box "code-show" "code-showcase" [code-block-1, code-info-1],
      widget-box "code-show2" "code-showcase" [code-info-2, code-block-2]
    ]

Section: Prism Showcase

  prism-visual : WidgetNode
  prism-visual = widget-box "prism-vis" "showcase-visual" [widget-box "prism-scr" "prism-mock" [widget-box "prism-tb" "prism-toolbar" [widget-label "pt-logo" "PRISM", widget-label "pt-dot" "&shy;"], widget-box "prism-nv" "prism-nav" [widget-label "pn0" "Compiler.codex", widget-label "pn1" "Lexer.codex", widget-label "pn2" "Parser.codex", widget-label "pn3" "TypeCheck.codex", widget-label "pn4" "Emitter.codex", widget-label "pn5" "Linker.codex"], widget-box "prism-code" "prism-src" [widget-label "pc0" "<span class='ln'> 1</span><span class='kw'>Chapter:</span> <span class='ty'>Compiler</span>&shy;", widget-label "pc1" "<span class='ln'> 2</span>  <span class='kw'>cites</span> Core <span class='kw'>chapter</span> <span class='ty'>Lex</span>&shy;", widget-label "pc2" "<span class='ln'> 3</span>  <span class='kw'>cites</span> Core <span class='kw'>chapter</span> <span class='ty'>Parse</span>&shy;", widget-label "pc3" "<span class='ln'> 4</span>&shy;", widget-label "pc4" "<span class='ln'> 5</span> <span class='cm'>The self-hosting compiler.</span>&shy;", widget-label "pc5" "<span class='ln'> 6</span>&shy;", widget-label "pc6" "<span class='ln'> 7</span> <span class='kw'>We say:</span>&shy;", widget-label "pc7" "<span class='ln'> 8</span>&shy;", widget-label "pc8" "<span class='ln'> 9</span>  <span class='fn'>compile</span> : <span class='ty'>Source</span> -&gt; <span class='ty'>Binary</span>&shy;"]]]

  prism-info : WidgetNode
  prism-info = site-showcase-info "prism-info" "One Source, Every Backend" "Write your program in Codex once. Prism compiles it to every target in real time and displays the output side by side. See exactly what x86-64 instructions your function generates, compare ARM64 output, inspect the WASM module, or read the JavaScript transpilation." [site-tag "prt0" "x86-64", site-tag "prt1" "ARM64", site-tag "prt2" "RISC-V", site-tag "prt3" "WASM", site-tag "prt4" "JavaScript", site-tag "prt5" "Python", site-tag "prt6" "Rust", site-tag "prt7" "Go", site-tag "prt8" "Haskell"]

  prism-section : Integer -> WidgetNode
  prism-section (x) =
    site-section "prism" "COMPILER EXPLORER" "See Every Target at Once" "Prism shows your Codex source alongside compilation output for every backend." [site-showcase "prism-show" prism-visual prism-info]

Section: Aquarium Showcase

  aqua-info : WidgetNode
  aqua-info = site-showcase-info "aqua-info" "GPU-Accelerated, Bare Metal Origin" "The aquarium runs custom WebGPU shaders compiled from Codex source through the WASM plug. Boids AI drives fish schooling. God rays, day/night cycles, and parallax coral layers create depth. Every pixel is computed &mdash; no sprite sheets, no game engine." [site-tag "aqt0" "WebGPU Shaders", site-tag "aqt1" "Boids AI", site-tag "aqt2" "God Rays", site-tag "aqt3" "Parallax Layers", site-tag "aqt4" "Phong Lighting"]

  aqua-visual : WidgetNode
  aqua-visual = widget-box "aqua-vis" "showcase-visual" [widget-box "aqua-scr" "aquarium-mock" [widget-box "aqua-hd" "aqua-hud" [widget-label "ah0" "&#x1F41F; 12 fish", widget-label "ah1" "72&#xB0;F", widget-label "ah2" "14:32"], widget-label "ray1" "&shy;", widget-label "ray2" "&shy;", widget-label "ray3" "&shy;", widget-label "af0" "&#x1F420;", widget-label "af1" "&#x1F41F;", widget-label "af2" "&#x1F421;", widget-label "af3" "&#x1F420;", widget-label "af4" "&#x1F41F;", widget-label "ac0" "&#x1FAB8;", widget-label "ac1" "&#x1F33F;", widget-label "ac2" "&#x1FAB8;", widget-label "ac3" "&#x1F33F;", widget-label "ab0" "&shy;", widget-label "ab1" "&shy;", widget-label "ab2" "&shy;", widget-label "ab3" "&shy;"]]

  aquarium-section : Integer -> WidgetNode
  aquarium-section (x) =
    site-section "aqua" "WEBGPU RENDERING" "Codex Aquarium" "A photorealistic reef simulation &mdash; Codex to WASM, rendered with WebGPU." [site-showcase "aqua-show" aqua-info aqua-visual]

Section: Apps

  app-card : Text, Text, Text, Text -> WidgetNode
  app-card (id) (icon) (name) (desc) =
    widget-box-click id "app-card" [
      widget-label (id & "i") icon,
      widget-label (id & "n") name,
      widget-label (id & "d") desc
    ]

  apps-section : Integer -> WidgetNode
  apps-section (x) =
