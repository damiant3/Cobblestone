Chapter: UOAIX
  cites Site chapter SiteTheme

Section: Styles

  ux-css : Text
  ux-css =
    "body{background:#0b1116}.ux{max-width:1120px;margin:auto;padding:0 28px;line-height:1.65}.ux .wk-label{min-width:0!important;overflow-wrap:anywhere;line-height:inherit;color:inherit!important}"
    & ".ux-nav{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:25px 0;border-bottom:1px solid #2b3437}.ux-navlinks{display:flex;gap:24px;flex-wrap:wrap}.ux-a{color:#d9bf7d;font-size:14px}.ux-a .wk-label{color:inherit!important}.ux-brand{font-weight:750;letter-spacing:2px}.ux a:focus-visible{outline:2px solid #e8c777;outline-offset:5px}"
    & ".ux-hero{display:grid;grid-template-columns:1.08fr 1fr;gap:56px;align-items:center;padding:84px 0 68px}.ux-kicker{font-size:11px;letter-spacing:2.4px;color:#d9bf7d!important;text-transform:uppercase}.ux-title{font-family:Georgia,serif;font-size:clamp(64px,8vw,108px);letter-spacing:-4px;line-height:1.05!important;color:#f2ead8!important;margin:16px 0 8px}.ux-name{font-size:13px;letter-spacing:1.2px;color:#bcc7c6!important}.ux-headline{font-family:Georgia,serif;font-size:clamp(30px,4vw,42px);line-height:1.2!important;color:#f2ead8!important;margin:30px 0 20px}.ux-copy{color:#bdc8cc!important;font-size:16px;line-height:1.8!important}.ux-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:28px}.ux-primary{padding:12px 18px;background:#d9bf7d;border:1px solid #d9bf7d;color:#101617}.ux-primary:hover{background:#ecd79d;text-decoration:none}"
    & ".ux-art{height:510px;border:1px solid #586357;position:relative;background:linear-gradient(180deg,transparent 35%,#0b1116eb 100%),url(uoaix-art/uoaix-hero-castle-town.jpg) 58% center/cover;box-shadow:20px 20px 0 #142126}.ux-art-caption{position:absolute;bottom:24px;left:24px;right:24px;color:#e7eddb!important;font:italic 24px Georgia,serif;line-height:1.5!important}.ux-caption{font:11px system-ui,sans-serif!important;color:#aebdb8!important;letter-spacing:1px;position:absolute;top:20px;left:20px;padding:5px 8px;background:#0b1116c9}"
    & ".ux-layer::before{content:'';display:block;aspect-ratio:16/9;background-position:center;background-size:cover;margin-bottom:20px;border:1px solid #364640}#ux-sim::before{background-image:url(uoaix-art/uoaix-forge.jpg)}#ux-minds::before{background-image:url(uoaix-art/uoaix-isometric-village.jpg)}#ux-keeper::before{background-image:url(uoaix-art/uoaix-keeper.jpg)}"
    & ".ux-status{display:flex;gap:20px;align-items:center;padding:20px 24px;background:#152225;border-left:3px solid #d9bf7d;margin-bottom:76px}.ux-status-title{white-space:nowrap;color:#d9bf7d!important;font-size:11px;letter-spacing:1.5px}.ux-status-copy{color:#b9c7c8!important;font-size:14px}.ux-section{padding:0 0 76px;scroll-margin-top:24px}.ux-section-title{font-family:Georgia,serif;font-size:36px;color:#f2ead8!important;line-height:1.25!important;margin:10px 0 22px}.ux-intro{max-width:740px;margin-bottom:30px}.ux-three{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.ux-layer{border-top:1px solid #4b594f;padding-top:20px}.ux-number{font:italic 30px Georgia,serif;color:#d9bf7d!important}.ux-layer-title{font-size:19px;font-weight:650;margin:12px 0;color:#ecede2!important}.ux-layer-copy{font-size:14px;color:#b4c1c4!important}.ux-stage{margin-top:20px;font-size:11px;color:#8ec0a1!important;letter-spacing:1px;text-transform:uppercase}.ux-planned{color:#d9bf7d!important}"
    & ".ux-split{display:grid;grid-template-columns:1fr 1fr;gap:64px}.ux-rule{border-top:1px solid #2b3437;padding:20px 0}.ux-rule-title{font-size:17px;font-weight:650;color:#e7eadf!important;margin-bottom:7px}.ux-rule-copy{font-size:14px;color:#b4c1c4!important}.ux-proof{background:#152225;padding:28px;border:1px solid #2b3e3d}.ux-proof-title{font-size:22px;color:#edf0dd!important;margin-bottom:16px}.ux-proof-row{padding:10px 0;border-bottom:1px solid #2d3b3c;font-size:14px;color:#becac8!important}.ux-proof-note{font-size:13px;color:#a2b4b5!important;margin-top:20px}"
    & ".ux-lineage{border-top:1px solid #364640;padding-top:50px}.ux-history{margin-top:30px}.ux-history-row{display:grid;grid-template-columns:140px 1fr;gap:26px;padding:26px 0;border-top:1px solid #2b3437}.ux-year{font:24px Georgia,serif;color:#d9bf7d!important}.ux-history-title{font-size:20px;color:#eff0e2!important;margin-bottom:7px}.ux-history-copy{font-size:15px;color:#b4c1c4!important;max-width:740px}.ux-quote{border-left:2px solid #d9bf7d;padding:4px 0 4px 24px;margin:30px 0}.ux-quote-text{font:italic 22px/1.55 Georgia,serif!important;color:#dedfcf!important;max-width:780px}.ux-quote-source{margin-top:14px;font-size:13px;color:#a8b8b8!important}.ux-sources{display:flex;gap:22px;flex-wrap:wrap}.ux-note{font-size:12px;color:#93a6aa!important;margin-top:16px;max-width:800px}.ux-footer{border-top:1px solid #364640;padding:30px 0 44px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.ux-footer .wk-label{font-size:12px;color:#a6b4b6!important}"
    & ".ux-detail-links{display:flex;flex-direction:column;gap:4px;margin-top:12px}.ux-detail-links .ux-a{font-size:13px}"
    & ".ux-four{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.ux-role{background:#152225;border:1px solid #2b3e3d;padding:22px}.ux-role-title{font:22px Georgia,serif;color:#f2ead8!important;margin-bottom:10px}.ux-role-copy{font-size:14px;color:#b4c1c4!important}.ux-join-cta{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:28px}"
    & "@media(max-width:800px){.ux-hero{grid-template-columns:1fr;gap:32px;padding-top:44px}.ux-art{height:310px;box-shadow:10px 10px 0 #142126}.ux-three,.ux-split{grid-template-columns:1fr;gap:30px}.ux-four{grid-template-columns:1fr 1fr}.ux-status{align-items:flex-start;flex-direction:column;gap:7px}.ux-history-row{grid-template-columns:1fr;gap:8px}.ux-title{font-size:80px}.ux-section-title{font-size:30px}}"
    & "@media(max-width:460px){.ux{padding:0 20px}.ux-nav{align-items:flex-start;flex-direction:column;gap:12px}.ux-navlinks{gap:18px}.ux-title{font-size:68px}.ux-art{height:260px}.ux-status{padding:18px}.ux-proof{padding:22px}.ux-four{grid-template-columns:1fr}}"

Section: Builders

  ux-link : Text, Text, Text, Text -> WidgetNode
  ux-link (id) (cls) (href) (label) = wk-attach (widget-custom id ("link:ux-a " & cls & "|" & href) 0 0) [widget-label (id & "t") label] 0 1

  ux-text : Text, Text, Text -> WidgetNode
  ux-text (id) (cls) (text) = widget-box (id & "box") cls [widget-label id text]

  ux-layer : Text, Text, Text, Text, Text -> WidgetNode
  ux-layer (id) (number) (title) (copy) (stage) = widget-box id "ux-layer" [
    ux-text (id & "n") "ux-number" number,
    ux-text (id & "h") "ux-layer-title" title,
    ux-text (id & "p") "ux-layer-copy" copy,
    ux-text (id & "s") "ux-stage" stage
  ]

  ux-layer-links : Text, Text, Text, Text, Text, List WidgetNode -> WidgetNode
  ux-layer-links (id) (number) (title) (copy) (stage) (links) = widget-box id "ux-layer" [
    ux-text (id & "n") "ux-number" number,
    ux-text (id & "h") "ux-layer-title" title,
    ux-text (id & "p") "ux-layer-copy" copy,
    widget-box (id & "l") "ux-detail-links" links,
    ux-text (id & "s") "ux-stage" stage
  ]

  ux-rule : Text, Text, Text -> WidgetNode
  ux-rule (id) (title) (copy) = widget-box id "ux-rule" [ux-text (id & "h") "ux-rule-title" title, ux-text (id & "p") "ux-rule-copy" copy]

  ux-role : Text, Text, Text -> WidgetNode
  ux-role (id) (title) (copy) = widget-box id "ux-role" [ux-text (id & "h") "ux-role-title" title, ux-text (id & "p") "ux-role-copy" copy]

  ux-history-row : Text, Text, Text, Text -> WidgetNode
  ux-history-row (id) (year) (title) (copy) = widget-box id "ux-history-row" [
    ux-text (id & "y") "ux-year" year,
    widget-box (id & "body") "ux-history-body" [ux-text (id & "h") "ux-history-title" title, ux-text (id & "p") "ux-history-copy" copy]
  ]

Section: Page

  page-tree : Integer -> WidgetNode
  page-tree (unused) = widget-box "root" "ux" [
    widget-box "ux-nav" "ux-nav" [
      ux-link "ux-home" "ux-brand" "landing.html" "COBBLESTONE",
      widget-box "ux-navlinks" "ux-navlinks" [ux-link "ux-nav-goals" "" "#goals" "The mission", ux-link "ux-nav-features" "" "#features" "Features", ux-link "ux-nav-join" "" "#join" "Join", ux-link "ux-nav-status" "" "#status" "Progress", ux-link "ux-nav-start" "" "#start" "Get started", ux-link "ux-nav-history" "" "#lineage" "Lineage"]
    ],
    widget-box "ux-hero" "ux-hero" [
      widget-box "ux-hero-copy" "ux-hero-copy" [
        ux-text "ux-kicker" "ux-kicker" "A COBBLESTONE PROJECT",
        ux-text "ux-title" "ux-title" "UOAIX",
        ux-text "ux-name" "ux-name" "ULTIMA OFFLINE AI EXPERIMENT",
        ux-text "ux-headline" "ux-headline" "A new kind of UO.",
        ux-text "ux-lead" "ux-copy" "A new Ultima Online server for the original 1998 client, written in Cobblestone&#39;s Codex language. The mission: a closed world with dynamic markets and NPCs, administrative tooling for the people who run it, and AI integration for customer support and worldbuilding.",
        widget-box "ux-actions" "ux-actions" [ux-link "ux-explore" "ux-primary" "#join" "Join the project", ux-link "ux-mission" "" "#goals" "The mission &#8595;", ux-link "ux-origin" "" "#lineage" "A story beginning in 1997 &#8595;"]
      ],
      widget-box "ux-art" "ux-art" [ux-text "ux-art-label" "ux-caption" "CONCEPT ILLUSTRATION", ux-text "ux-art-caption" "ux-art-caption" "The bakery opens. The market fills. A town carries on."]
    ],
    widget-box "ux-status-banner" "ux-status" [ux-text "ux-status-title" "ux-status-title" "IN DEVELOPMENT", ux-text "ux-status-copy" "ux-status-copy" "A local test shard for the 1.25.32 client. Public play is not available yet."],
    widget-box "goals" "ux-section" [
      ux-text "ux-goals-tag" "ux-kicker" "THE MISSION",
      ux-text "ux-goals-title" "ux-section-title" "A closed world that runs itself, and the tools to tend it",
      ux-text "ux-goals-copy" "ux-copy ux-intro" "In a closed world nothing appears from nothing. Every coin is minted from mined ore, every good is made from gathered materials by someone whose trade it is, and every sale moves goods that exist. On that ground the markets and the townsfolk can be real, and the people who run the shard need tools equal to it.",
      widget-box "ux-layers" "ux-three" [
        ux-layer-links "ux-sim" "I" "Dynamic markets" "Miners, lumberjacks, fishers, hunters and farmers gather; smiths, bakers, tanners, cobblers and the rest make goods from what they bought; shops price from their stock. Gold, silver and copper change hands at royal rates, and every payment is taxed." "RUNNING ON THE TEST SHARD" [
          ux-link "ux-sim-1" "" "#d-harvest" "Harvesting and regrowth &#8595;",
          ux-link "ux-sim-2" "" "#d-production" "Production from bought goods &#8595;",
          ux-link "ux-sim-3" "" "#d-free" "No free inventories &#8595;",
          ux-link "ux-sim-4" "" "#d-hours" "Shops closed at night &#8595;",
          ux-link "ux-sim-5" "" "#d-mint" "The mint and the tax &#8595;"],
        ux-layer-links "ux-minds" "II" "NPCs with lives" "Townsfolk keep homes, work stations and daily schedules; a mayor governs, guards patrol and answer alarms. A trained town network chooses where three townsfolk go and what they buy and sell, and the same validator that checks a player&#39;s trade checks every choice." "RUNNING; MORE MINDS PLANNED" [
          ux-link "ux-minds-1" "" "#d-days" "A townsperson&#39;s day &#8595;",
          ux-link "ux-minds-2" "" "#d-law" "Crime, witnesses and guards &#8595;"],
        ux-layer-links "ux-keeper" "III" "Tools and an AI keeper" "Game masters work inside the classic client: a decorator whose placed items bake into the map, land and building tools, guard-zone and spawn overlays, scripted plays and an admin panel. An AI keeper is planned to answer help pages and assist the worldbuilders, with a human in charge." "TOOLS BUILT; AI KEEPER PLANNED" [
          ux-link "ux-keeper-1" "" "#d-gm" "Tools in the client &#8595;",
          ux-link "ux-keeper-2" "" "#d-desk" "The keeper&#39;s desk &#8595;"]
      ]
    ],
    widget-box "details" "ux-section ux-lineage" [
      ux-text "ux-details-tag" "ux-kicker" "IN DETAIL &#183; 10 OCT 2026",
      ux-text "ux-details-title" "ux-section-title" "How the built parts work",
      widget-box "ux-details" "ux-history" [
        widget-box "d-harvest" "" [ux-history-row "ux-d1" "I" "Harvesting and regrowth" "Ore, logs, fish and reagents come from nodes in the world, worked by players and by gathering townsfolk alike. A worked node regrows a game day later, so the harvest is paced by the land rather than by a timer that conjures goods. The map&#39;s own trees fall to the axe, leave a stump and grow back from a sapling."],
        widget-box "d-production" "" [ux-history-row "ux-d2" "I" "Production from bought goods" "Smiths, bakers, tanners, cobblers and the other trades make goods only from inputs they bought from the gatherers and from each other, at their own workstations. A shop prices from the stock it holds, so a scarce input shows up as a dearer good."],
        widget-box "d-free" "" [ux-history-row "ux-d3" "I" "No free inventories" "After a new world&#39;s founding stock, a shelf restocks only with goods its own trade made or bought; a shop cannot spawn wares. Monsters and brigands carry what they took or picked up, and a thief moves the real item out of the shop rather than creating a copy."],
        widget-box "d-hours" "" [ux-history-row "ux-d4" "I" "Shops closed at night" "Shops trade from game hour 8 to 20; a game day is two real hours. After closing, a keeper spends two hours at the tavern and then goes home. Healers, innkeepers and tavern keepers trade at every hour."],
        widget-box "d-mint" "" [ux-history-row "ux-d5" "I" "The mint and the tax" "The crown strikes gold, silver and copper from mined ore at royal rates, 700 copper or 70 silver to the gold, and taxes ore at the mine and every ordinary payment, both at 10%. Change is made coin by coin from what a purse actually holds."],
        widget-box "d-days" "" [ux-history-row "ux-d6" "II" "A townsperson&#39;s day" "Townsfolk sleep at home, walk to their work, take their trade to the shops and keep their own hours. In every city the workers lodge in its empty houses. A mayor governs Britain, and its guards walk their beats."],
        widget-box "d-law" "" [ux-history-row "ux-d7" "II" "Crime, witnesses and guards" "A theft, assault or murder against an innocent is a deed, witnessed by everyone in sight within 12 tiles. An NPC witness tells the nearest guard in earshot, who comes on foot to make the arrest and take the offender to jail. An open case marks a criminal grey, five murders mark a murderer red, and striking back at an attacker is never a crime."],
        widget-box "d-gm" "" [ux-history-row "ux-d8" "III" "Tools in the client" "Game masters work inside the unmodified 1998 client: decorate and mark items for the bake into the map, edit land and buildings, show guard-zone and spawn overlays, and stage plays that cast real townsfolk."],
        widget-box "d-desk" "" [ux-history-row "ux-d9" "III" "The keeper&#39;s desk" "The shard serves its own admin desk behind the owner&#39;s key: a support queue for help pages, world health, the treasury and market over time, the treasury&#39;s rates, tax and grants, the crown&#39;s share of each production chain, accounts, GM grants, plays, live connections and an action log.", ux-link "ux-desk-shots" "" "uoaix-desk.html" "See the desk, captured from the test shard &#8594;"]
      ]
    ],
    widget-box "features" "ux-section ux-split" [
      widget-box "ux-built" "ux-rules" [
        ux-text "ux-built-tag" "ux-kicker" "WHAT THE WORLD HOLDS &#183; 10 OCT 2026",
        ux-text "ux-built-title" "ux-section-title" "Built and on the test shard",
        ux-rule "ux-f-econ" "A closed economy" "Nothing appears from nothing: every good is gathered or made by someone whose trade it is, and every coin is struck from mined ore.",
        ux-rule "ux-f-reagents" "Reagents you harvest, and that grow back" "The herbalist&#39;s reagents grow on plants that are picked and regrow a game day later.",
        ux-rule "ux-f-trees" "Trees that chop" "The map&#39;s own trees fall to the axe, leave a stump and grow back from a sapling.",
        ux-rule "ux-f-mint" "Copper and silver mintage" "The crown strikes copper and silver beside gold, and change is made coin by coin.",
        ux-rule "ux-f-lives" "Bots that have lives" "Townsfolk keep homes, trades and daily schedules; workers gather, craft and sell to the shops.",
        ux-rule "ux-f-gm" "GM features and plays" "Game masters work inside the 1998 client, and scripted plays cast real townsfolk.",
        ux-rule "ux-f-british" "Lord British at server open" "A new public shard refuses to open until Lord British&#39;s account has its own password; his role runs the world from there.",
        ux-rule "ux-f-housing" "Housing changes" "Houses are placed from a deed and built in the world.",
        ux-rule "ux-f-games" "Games that actually work" "Chess, backgammon and cards at the tavern tables, played between players.",
        ux-rule "ux-f-squat" "Bots in the unused housing" "Each city&#39;s workers lodge in its empty houses.",
        ux-rule "ux-f-law" "A realistic criminal justice system" "Witnesses report thefts, assaults and murders, guards answer and jail the offender, and notoriety marks criminals and murderers. More is to come.",
        ux-rule "ux-f-sea" "Navy battles and pirates" "Shipwrights build battleships, pirates keep a haven, and the navy patrols.",
        ux-rule "ux-f-quake" "Earthquakes worth 50 mana" "The eighth-circle Earthquake strikes everything around the caster hard enough to earn its cost.",
        ux-rule "ux-f-nujelm" "An economic role for Nujel&#39;m" "Only the sands of Nujel&#39;m yield the powder of restoration, which brings a worn weapon or armour piece back to the best its kind can be."
      ],
      widget-box "ux-coming" "ux-proof" [
        ux-text "ux-coming-tag" "ux-kicker ux-planned" "COMING",
        ux-text "ux-coming-title" "ux-proof-title" "Not built yet",
        ux-text "ux-coming-1" "ux-proof-row" "Decorator roles: the decorator tools are built for game masters; a decorator&#39;s own role is coming.",
        ux-text "ux-coming-2" "ux-proof-row" "Static housing rentals.",
        ux-text "ux-coming-note" "ux-proof-note" "Built means built in the server at head and running on the developers&#39; test shard; public play is not open yet."
      ]
    ],
    widget-box "join" "ux-section" [
      ux-text "ux-join-tag" "ux-kicker" "A CALL TO BUILDERS",
      ux-text "ux-join-title" "ux-section-title" "Game masters, artists, playwrights and players wanted",
      ux-text "ux-join-copy" "ux-copy ux-intro" "A world this size needs more hands than code. Four ways in:",
      widget-box "ux-roles" "ux-four" [
        ux-role "ux-role-gm" "Game masters" "Run a living shard. Decorate it, police it, answer the pages players send, and shape its events, with tools made for the 1998 client.",
        ux-role "ux-role-art" "Artists" "Give Britannia its look: shop interiors, buildings, signs and concept art. What a decorator places, the bake writes into the map every player sees.",
        ux-role "ux-role-play" "Playwrights" "Write the scenes the world performs. A play casts real townsfolk, sets its props and can trade goods and coin with the player who walks in.",
        ux-role "ux-role-player" "Players" "Play the original client in a world whose economy is real: bring ore to the smith and fish to the docks, and watch the prices answer. Testers find what breaks."
      ],
      widget-box "ux-join-cta" "ux-join-cta" [ux-link "ux-join-link" "ux-primary" "https://github.com/damiant3/Cobblestone/issues" "Volunteer on GitHub &#8599;", ux-link "ux-join-repo" "" "https://github.com/damiant3/Cobblestone/tree/master/apps/uoaix" "Read the server source &#8599;"]
    ],
    widget-box "status" "ux-section ux-split" [
      widget-box "ux-rules" "ux-rules" [
        ux-text "ux-rules-tag" "ux-kicker" "THE BOUNDARIES",
        ux-text "ux-rules-title" "ux-section-title" "A world with rules",
        ux-rule "ux-client" "The original client" "The initial target is the unmodified 1998 client, version 1.25.32. Client assets are not distributed with the public project.",
        ux-rule "ux-deploy" "A shard with its own kernel" "The deployment goal is one bootable image on a rented VM, exposing the game ports and an authenticated admin/health port. Model hosts remain outside the shard.",
        ux-rule "ux-browser" "A browser client, later" "After the deployable shard works well, the plan is a Codex browser client using WebGPU, joining the same world as the classic client. Browser play is a future stage.",
        ux-rule "ux-real-stock" "Every gift has an owner" "A proposed gift must come from an NPC&#39;s actual inventory. Player text remains data; a line of chat cannot grant authority or create goods.",
        ux-rule "ux-human" "A human stays in charge" "The keeper reports misconduct. Bans, kicks, mutes and other disciplinary actions require a human ruling. World rules and account discipline remain separate."
      ],
      widget-box "ux-proof" "ux-proof" [
        ux-text "ux-proof-tag" "ux-kicker" "ON THE TEST SHARD &#183; 9 OCT 2026",
        ux-text "ux-proof-title" "ux-proof-title" "Britain is open for testing",
        ux-text "ux-proof-1" "ux-proof-row" "18 shops in Britain, each selling what its own trade made or bought, with the price in gold, silver and copper.",
        ux-text "ux-proof-2" "ux-proof-row" "Gatherers and crafters are founded at boot and trade with the shops; their full working day is in testing.",
        ux-text "ux-proof-3" "ux-proof-row" "The crown mints gold, silver and copper from mined ore, and every payment is taxed.",
        ux-text "ux-proof-4" "ux-proof-row" "Decorator, land, building, overlay and play tools are built for the 1998 client and in testing; the bake into the map awaits its first run.",
        ux-text "ux-proof-note" "ux-proof-note" "The shard runs locally with its developers playing it. Model-driven dialogue, the AI keeper and public hosting are continuing work."
      ]
    ],
    widget-box "numbers" "ux-section" [
      ux-text "ux-num-tag" "ux-kicker" "BY THE NUMBERS &#183; 10 OCT 2026",
      ux-text "ux-num-title" "ux-section-title" "One server, every line of it Codex",
      ux-text "ux-num-copy" "ux-copy ux-intro" "Lines of source in apps/uoaix, measured 10 October 2026. Nothing underneath is borrowed: the compiler, the virtual machine and the server are all built here.",
      widget-box "ux-counts" "ux-three" [
        ux-role "ux-n-server" "56,971 lines" "The game server: 274 chapters of world, economy, towns, combat, magic, law, ships and the client protocol.",
        ux-role "ux-n-admin" "8,604 lines" "The admin tool: 9 chapters, the keeper&#39;s desk served by the shard itself behind an authenticated login.",
        ux-role "ux-n-map" "3,271 lines" "Map editing: 10 chapters of decoration, flora, construction, land, pins and overlays that change the world players see.",
        ux-role "ux-n-bvt" "8,901 lines" "Tests: 259 build-verification cases, one or more for every bug fixed and feature added.",
        ux-role "ux-n-proofs" "29,577 lines" "Proofs: 227 replays and proofs that drive whole subsystems end to end.",
        ux-role "ux-n-tools" "3,505 lines" "Tools: 30 scripts that import the 1998 client&#39;s map, spawns, decoration and teleporters, and run the shard."
      ]
    ],
    widget-box "start" "ux-section ux-lineage" [
      ux-text "ux-start-tag" "ux-kicker" "GET STARTED",
      ux-text "ux-start-title" "ux-section-title" "Run your own shard, step by step",
      ux-text "ux-start-copy" "ux-copy ux-intro" "UOAIX runs on Windows today, booted on Cobblestone&#39;s own virtual machine. These are the steps its developers follow.",
      widget-box "ux-steps" "ux-history" [
        ux-history-row "ux-s1" "Step 1" "Get the code" "git clone https://github.com/damiant3/Cobblestone, then git checkout preview for the newest work. The compiler ships as seed/Codex.cdx, a self-hosted binary; nothing else needs installing to build.",
        ux-history-row "ux-s2" "Step 2" "Get the virtual machine" "tools/build-vm.ps1 builds tools/codex-vm.exe, the Windows Hypervisor Platform machine the shard boots on (turn on Windows Hypervisor Platform in Windows Features first). QEMU boots the same image through multiboot; docs/OperatorsManual.md covers both.",
        ux-history-row "ux-s3" "Step 3" "Bring the 1998 client" "Install your own copy of the Ultima Online client, version 1.25.32. Its assets are not distributed with the project; the shard reads its map, statics and tile data from your install.",
        ux-history-row "ux-s4" "Step 4" "Build and boot" "build/compile.ps1 -Src apps/uoaix/CompositeGameServer.codex compiles the server with -Kernel seed/Codex.cdx; apps/uoaix/install-map-cache.ps1 prepares the map from your client; apps/uoaix/supervise-composite-game.ps1 boots and watches the shard. apps/uoaix/CompositeGame.md is the operator&#39;s guide.",
        ux-history-row "ux-s5" "Step 5" "Log in" "Point the client&#39;s LOGIN.CFG at 127.0.0.1 and the game port the supervisor reports, and log in. A new public shard first asks for Lord British&#39;s password (apps/uoaix/GameServer.md, Accounts). The admin tool answers on its own port, behind the shard&#39;s owner key.",
        ux-history-row "ux-s6" "Or" "Ask an agent" "Give a coding agent this: &#8220;Clone github.com/damiant3/Cobblestone and check out the preview branch. Read apps/uoaix/uoaix-init.md and apps/uoaix/CompositeGame.md. My Ultima Online 1.25.32 client is at [path]. Build tools/codex-vm.exe, compile apps/uoaix/CompositeGameServer.codex with build/compile.ps1 and seed/Codex.cdx, install the map cache from my client, boot the shard with supervise-composite-game.ps1, set my client&#39;s LOGIN.CFG to the shard&#39;s game port, and tell me when I can log in.&#8221;"
      ]
    ],
    widget-box "lineage" "ux-section ux-lineage" [
      ux-text "ux-history-tag" "ux-kicker" "THE LINEAGE",
      ux-text "ux-history-title" "ux-section-title" "A new chapter in an old experiment",
      ux-text "ux-history-intro" "ux-copy ux-intro" "UOAIX takes its name from UOX, the Ultima Offline eXperiment. Damian&#39;s connection to that world began with the packets that made an independent server possible.",
      widget-box "ux-history" "ux-history" [
        ux-history-row "ux-1997" "1997" "UOX and the protocol" "Damian decoded packets for Jaegermeister&#39;s UOX and wrote UOPackets.doc, titled UOX Protocol. Jerrith&#39;s later packet guide explicitly credits that document.",
        ux-history-row "ux-1998" "Early 1998" "GreyWorld" "Damian worked with Menace, Dennis of Menasoft, on GreyWorld, the C++ line of UOX. GreyWorld later became TUS and then SphereServer.",
        ux-history-row "ux-2001" "Around 2001" "Wolfpack" "Later work brought Damian to Wolfpack and a team including Thiago A Correa. Wolfpack grew from Ripper&#39;s customized UOX3.",
        ux-history-row "ux-2026" "2026" "UOAIX" "A new server, written in Codex, returns to the experiment with a different ambition: townsfolk with daily lives, event-driven minds and a keeper to tend their stories."
      ],
      widget-box "ux-quote" "ux-quote" [
        ux-text "ux-quote-text" "ux-quote-text" "&#8220;This guide is based on the UOPackets.doc document \"UOX Protocol\" prepared by Damian.&#8221;",
        ux-text "ux-quote-source" "ux-quote-source" "Jerrith&#39;s UO Packets Guide, original introduction"
      ],
      widget-box "ux-sources" "ux-sources" [ux-link "ux-jerrith" "" "https://uo.torfo.org/packetguide/" "Read Jerrith&#39;s packet guide &#8599;", ux-link "ux-timeline" "" "https://www.uox3.org/history/timeline.shtml" "UOX3 emulator history &#8599;"],
      ux-text "ux-history-note" "ux-note" "Collaboration details follow Damian&#39;s account; the packet guide preserves the attribution. The original 1997 UOPackets.doc has not yet been located."
    ],
    widget-box "ux-footer" "ux-footer" [ux-text "ux-foot-text" "" "UOAIX &#183; Part of the Cobblestone project", ux-link "ux-repo" "" "https://github.com/damiant3/Cobblestone" "Project repository &#8599;", ux-link "ux-back" "" "landing.html#today" "Explore Cobblestone &#8594;"]
  ]

Section: Entry

  ux-render : Integer -> Integer
  ux-render (unused) = mount-widget-themed site-theme (page-tree 0)

  ux-click : Text -> Integer
  ux-click (id) = 0

  opening : [Console] Integer = act
    let style = site-init ux-css
    in let renderer = set-render ux-render
    in let handlers = register-handlers no-pick ux-click
    in ux-render 0
  end
