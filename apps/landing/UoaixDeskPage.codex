Chapter: UOAIXDesk
  cites Site chapter SiteTheme

Section: Styles

  kd-css : Text
  kd-css =
    "body{background:#0b1116}.kd{max-width:1120px;margin:auto;padding:0 28px;line-height:1.65}.kd .wk-label{min-width:0!important;overflow-wrap:anywhere;line-height:inherit;color:inherit!important}"
    & ".kd-nav{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:25px 0;border-bottom:1px solid #2b3437}.kd-navlinks{display:flex;gap:24px;flex-wrap:wrap}.kd-a{color:#d9bf7d;font-size:14px}.kd-a .wk-label{color:inherit!important}.kd-brand{font-weight:750;letter-spacing:2px}.kd a:focus-visible{outline:2px solid #e8c777;outline-offset:5px}"
    & ".kd-head{padding:64px 0 40px}.kd-kicker{font-size:11px;letter-spacing:2.4px;color:#d9bf7d!important;text-transform:uppercase}.kd-title{font-family:Georgia,serif;font-size:clamp(34px,5vw,52px);line-height:1.15!important;color:#f2ead8!important;margin:14px 0 18px}.kd-copy{color:#bdc8cc!important;font-size:16px;line-height:1.8!important;max-width:780px}"
    & ".kd-shot{border-top:1px solid #364640;padding:34px 0 60px}.kd-shot-title{font:28px Georgia,serif;color:#f2ead8!important;margin-bottom:8px}.kd-shot-copy{font-size:15px;color:#b4c1c4!important;max-width:780px;margin-bottom:22px}.kd-img{width:100%;border:1px solid #586357;background-size:100% auto;background-repeat:no-repeat;background-position:top center;box-shadow:14px 14px 0 #142126}"
    & "#kd-s1i{aspect-ratio:1440/1871;background-image:url(uoaix-art/uoaix-desk-overview.jpg)}#kd-s2i{aspect-ratio:1440/1345;background-image:url(uoaix-art/uoaix-desk-treasury.jpg)}#kd-s3i{aspect-ratio:1440/497;background-image:url(uoaix-art/uoaix-desk-actions.jpg)}#kd-s4i{aspect-ratio:1440/421;background-image:url(uoaix-art/uoaix-desk-world.jpg)}#kd-s5i{aspect-ratio:1440/1120;background-image:url(uoaix-art/uoaix-desk-plays.jpg)}#kd-s6i{aspect-ratio:1440/318;background-image:url(uoaix-art/uoaix-desk-activity.jpg)}"
    & ".kd-footer{border-top:1px solid #364640;padding:30px 0 44px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.kd-footer .wk-label{font-size:12px;color:#a6b4b6!important}"
    & "@media(max-width:800px){.kd-head{padding-top:40px}.kd-img{box-shadow:8px 8px 0 #142126}.kd-shot-title{font-size:24px}}"
    & "@media(max-width:460px){.kd{padding:0 20px}.kd-nav{align-items:flex-start;flex-direction:column;gap:12px}.kd-navlinks{gap:18px}}"

Section: Builders

  kd-link : Text, Text, Text, Text -> WidgetNode
  kd-link (id) (cls) (href) (label) = wk-attach (widget-custom id ("link:kd-a " & cls & "|" & href) 0 0) [widget-label (id & "t") label] 0 1

  kd-text : Text, Text, Text -> WidgetNode
  kd-text (id) (cls) (text) = widget-box (id & "box") cls [widget-label id text]

  kd-shot : Text, Text, Text -> WidgetNode
  kd-shot (id) (title) (copy) = widget-box id "kd-shot" [
    kd-text (id & "h") "kd-shot-title" title,
    kd-text (id & "p") "kd-shot-copy" copy,
    widget-box (id & "i") "kd-img" []
  ]

Section: Page

  page-tree : Integer -> WidgetNode
  page-tree (unused) = widget-box "root" "kd" [
    widget-box "kd-nav" "kd-nav" [
      kd-link "kd-home" "kd-brand" "landing.html" "COBBLESTONE",
      widget-box "kd-navlinks" "kd-navlinks" [kd-link "kd-nav-uo" "" "uoaix.html" "UOAIX", kd-link "kd-nav-desk" "" "uoaix.html#d-desk" "The keeper&#39;s desk, in brief"]
    ],
    widget-box "kd-head" "kd-head" [
      kd-text "kd-kicker" "kd-kicker" "UOAIX &#183; THE KEEPER&#39;S DESK &#183; 16 OCT 2026",
      kd-text "kd-title" "kd-title" "The admin panel, as the shard serves it",
      kd-text "kd-intro" "kd-copy" "Captured from the developers&#39; test shard at game hour 335 on 16 October 2026, signed in as the shard owner. The shard serves this desk itself, on its own admin port and behind the owner&#39;s key. The accounts and game-master tabs are left out of these captures."
    ],
    kd-shot "kd-s1" "Overview: the support queue, world health and the treasury over time" "The support queue holds the help pages players send and the reports the keeper files; no player was online for this capture, and the queue was empty. World health sums the day&#39;s trade, law, sea, Britain&#39;s government and the wild spawns. Below them, the treasury&#39;s gold, silver and copper across the 156 game hours the shard keeps.",
    kd-shot "kd-s2" "Treasury" "The royal treasury&#39;s balance in all three coins, the royal rates of 700 copper or 70 silver to the gold, the tax on ordinary payments, grants to royal businesses, and the crown&#39;s share of each production chain&#39;s turnover.",
    kd-shot "kd-s3" "Actions" "Lord British&#39;s powers, bound to the signed-in session: each action is logged before the game server applies it, and the game server validates every command. Bans sit on the neighbouring tab.",
    kd-shot "kd-s4" "World" "The length of a game day in real seconds, two real hours by default; changes are logged and apply without a restart. Log levels and houses sit on the neighbouring tabs.",
    kd-shot "kd-s5" "Plays" "Scripts of scenes, cast, lines and cues. Saving a script compiles it, and a refused script names its line. In this capture the shard refused the play list (unsupported-command).",
    kd-shot "kd-s6" "Activity" "The live connections, with the action log on the neighbouring tab.",
    widget-box "kd-footer" "kd-footer" [kd-text "kd-foot-text" "" "UOAIX &#183; Part of the Cobblestone project", kd-link "kd-back" "" "uoaix.html" "Back to UOAIX &#8594;"]
  ]

Section: Entry

  kd-render : Integer -> Integer
  kd-render (unused) = mount-widget-themed site-theme (page-tree 0)

  kd-click : Text -> Integer
  kd-click (id) = 0

  opening : [Console] Integer = act
    let style = site-init kd-css
    in let renderer = set-render kd-render
    in let handlers = register-handlers no-pick kd-click
    in kd-render 0
  end
