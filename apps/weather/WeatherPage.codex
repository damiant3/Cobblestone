Chapter: WeatherPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets
  cites Foreword chapter CCE (is-digit, digit-value)

 We say:

Section: Theme

  weather-theme : Theme
  weather-theme =
    let p = Palette { pal-bg = 921134, pal-fg = #E1E1E1, pal-primary = 4560127, pal-secondary = #181818, pal-accent = #FF9900, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 8)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "weather-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  weather-css : Text
  weather-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:linear-gradient(180deg,#0e1126 0%,#1a2040 50%,#0e1126 100%);color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".weather{max-width:900px;margin:0 auto;padding:24px}"
    & ".location{font-size:14px;color:#8899aa;margin-bottom:4px;display:flex;align-items:center;gap:8px}"
    & ".loc-selector{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 16px}"
    & ".loc-btn{background:rgba(255,255,255,.08);border:none;color:#aab;border-radius:16px;padding:6px 14px;font-size:12px;cursor:pointer;transition:all .15s}"
    & ".loc-btn:hover{background:rgba(255,255,255,.15)}"
    & ".loc-btn.active{background:#4560ff;color:#fff}"
    & ".toolbar{display:flex;align-items:center;gap:12px;margin-bottom:8px}"
    & ".tool-btn{background:rgba(255,255,255,.08);border:none;color:#aab;border-radius:8px;padding:6px 12px;font-size:12px;cursor:pointer}"
    & ".tool-btn:hover{background:rgba(255,255,255,.15)}"
    & ".refresh-time{font-size:11px;color:#556;margin-left:auto}"
    & ".current{display:flex;align-items:center;gap:32px;padding:40px 0}"
    & ".current-icon{font-size:80px}"
    & ".current-temp{font-size:72px;font-weight:200;color:#fff}"
    & ".current-info{flex:1}"
    & ".current-desc{font-size:20px;color:#aab;margin-bottom:8px;text-transform:capitalize}"
    & ".current-detail{font-size:13px;color:#778;line-height:1.8}"
    & ".forecast{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin:24px 0}"
    & ".day-card{background:rgba(255,255,255,.05);border-radius:12px;padding:16px 8px;text-align:center;transition:background .15s}"
    & ".day-card:hover{background:rgba(255,255,255,.1)}"
    & ".day-name{font-size:12px;color:#778;margin-bottom:8px;text-transform:uppercase}"
    & ".day-icon{font-size:28px;margin-bottom:8px}"
    & ".day-hi{font-size:16px;font-weight:600;color:#fff}"
    & ".day-lo{font-size:14px;color:#556}"
    & ".details{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:24px 0}"
    & ".detail-card{background:rgba(255,255,255,.05);border-radius:12px;padding:20px}"
    & ".detail-title{font-size:12px;color:#778;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}"
    & ".detail-val{font-size:24px;font-weight:600;color:#fff}"
    & ".detail-sub{font-size:12px;color:#778;margin-top:4px}"
    & ".hourly{display:flex;gap:12px;overflow-x:auto;padding:16px 0;margin:8px 0}"
    & ".hour-card{flex-shrink:0;background:rgba(255,255,255,.05);border-radius:12px;padding:12px 16px;text-align:center;min-width:80px}"
    & ".hour-time{font-size:12px;color:#778;margin-bottom:6px}"
    & ".hour-icon{font-size:20px;margin-bottom:4px}"
    & ".hour-temp{font-size:14px;font-weight:600}"
    & ".hour-rain{font-size:11px;color:#5599ff;margin-top:4px}"
    & ".section-title{font-size:14px;color:#778;text-transform:uppercase;letter-spacing:1px;margin:24px 0 12px}"
    & ".alerts{margin:24px 0}"
    & ".alert-card{border-radius:12px;padding:16px 20px;margin-bottom:8px;display:flex;align-items:center;gap:12px}"
    & ".alert-heat{background:rgba(236,77,48,.15);border-left:3px solid #ec4d30}"
    & ".alert-wind{background:rgba(69,96,255,.15);border-left:3px solid #4560ff}"
    & ".alert-humid{background:rgba(255,153,0,.15);border-left:3px solid #ff9900}"
    & ".alert-icon{font-size:24px}"
    & ".alert-text{flex:1}"
    & ".alert-title{font-size:14px;font-weight:600;color:#fff}"
    & ".alert-desc{font-size:12px;color:#778;margin-top:2px}"
    & ".aqi-card{border-radius:12px;padding:16px;margin:12px 0}"
    & ".aqi-good{background:rgba(65,175,78,.15);border-left:3px solid #41af4e}"
    & ".aqi-mod{background:rgba(255,153,0,.15);border-left:3px solid #ff9900}"
    & ".aqi-bad{background:rgba(236,77,48,.15);border-left:3px solid #ec4d30}"
    & ".expand-day{background:rgba(255,255,255,.03);border-radius:12px;padding:16px;margin:8px 0}"
    & ".expand-hours{display:flex;gap:12px;margin-top:12px}"
    & ".expand-hour{text-align:center;flex:1}"
    & ".expand-time{font-size:11px;color:#778}"
    & ".expand-temp{font-size:16px;font-weight:600;color:#fff;margin-top:4px}"
    & ".moon-card{display:flex;align-items:center;gap:12px}"
    & ".moon-icon{font-size:32px}"
    & ".suggest-card{background:rgba(69,96,255,.08);border-radius:12px;padding:16px;margin:12px 0;font-size:14px;color:#aab}"
    & ".compass-rose{display:inline-flex;align-items:center;gap:6px;font-size:20px}"
    & ".history-compare{font-size:13px;color:#889;margin:8px 0}"

Section: Data

  city-name : Integer -> Text
  city-name (c) =
    if c == 0 then "Portland, Oregon"
    else if c == 1 then "Seattle, Washington"
    else if c == 2 then "San Francisco, California"
    else if c == 3 then "Denver, Colorado"
    else if c == 4 then "Chicago, Illinois"
    else "New York, New York"

  city-temp : Integer -> Integer
  city-temp (c) =
    if c == 0 then 68
    else if c == 1 then 63
    else if c == 2 then 61
    else if c == 3 then 88
    else if c == 4 then 79
    else 84

  city-feels : Integer -> Integer
  city-feels (c) =
    if c == 0 then 65
    else if c == 1 then 60
    else if c == 2 then 59
    else if c == 3 then 91
    else if c == 4 then 82
    else 88

  city-hi : Integer -> Integer
  city-hi (c) =
    if c == 0 then 72
    else if c == 1 then 67
    else if c == 2 then 65
    else if c == 3 then 94
    else if c == 4 then 83
    else 89

  city-lo : Integer -> Integer
  city-lo (c) =
    if c == 0 then 54
    else if c == 1 then 52
    else if c == 2 then 53
    else if c == 3 then 64
    else if c == 4 then 68
    else 72

  city-cond : Integer -> Text
  city-cond (c) =
    if c == 0 then "Partly Cloudy"
    else if c == 1 then "Overcast"
    else if c == 2 then "Foggy"
    else if c == 3 then "Sunny"
    else if c == 4 then "Humid"
    else "Partly Cloudy"

  city-icon : Integer -> Text
  city-icon (c) =
    if c == 0 then "&#x26C5;"
    else if c == 1 then "&#x2601;"
    else if c == 2 then "&#x1F32B;"
    else if c == 3 then "&#x2600;"
    else if c == 4 then "&#x1F325;"
    else "&#x26C5;"

  city-humidity : Integer -> Integer
  city-humidity (c) =
    if c == 0 then 62
    else if c == 1 then 74
    else if c == 2 then 82
    else if c == 3 then 22
    else if c == 4 then 91
    else 58

  city-wind : Integer -> Integer
  city-wind (c) =
    if c == 0 then 8
    else if c == 1 then 12
    else if c == 2 then 15
    else if c == 3 then 6
    else if c == 4 then 18
    else 10

  city-wind-dir : Integer -> Text
  city-wind-dir (c) =
    if c == 0 then "NW"
    else if c == 1 then "S"
    else if c == 2 then "W"
    else if c == 3 then "SW"
    else if c == 4 then "NE"
    else "SE"

  city-uv : Integer -> Integer
  city-uv (c) =
    if c == 0 then 5
    else if c == 1 then 3
    else if c == 2 then 4
    else if c == 3 then 9
    else if c == 4 then 6
    else 7

  city-vis : Integer -> Integer
  city-vis (c) =
    if c == 0 then 10
    else if c == 1 then 8
    else if c == 2 then 3
    else if c == 3 then 10
    else if c == 4 then 7
    else 9

  city-pressure : Integer -> Text
  city-pressure (c) =
    if c == 0 then "30.12"
    else if c == 1 then "29.98"
    else if c == 2 then "30.05"
    else if c == 3 then "30.22"
    else if c == 4 then "29.85"
    else "30.10"

  city-sunrise : Integer -> Text
  city-sunrise (c) =
    if c == 0 then "5:24 AM"
    else if c == 1 then "5:18 AM"
    else if c == 2 then "5:48 AM"
    else if c == 3 then "5:32 AM"
    else if c == 4 then "5:15 AM"
    else "5:25 AM"

  city-sunset : Integer -> Text
  city-sunset (c) =
    if c == 0 then "8:58 PM"
    else if c == 1 then "9:08 PM"
    else if c == 2 then "8:35 PM"
    else if c == 3 then "8:31 PM"
    else if c == 4 then "8:29 PM"
    else "8:31 PM"

  city-aqi : Integer -> Integer
  city-aqi (c) =
    if c == 0 then 42
    else if c == 1 then 35
    else if c == 2 then 68
    else if c == 3 then 55
    else if c == 4 then 89
    else 72

  aqi-label : Integer -> Text
  aqi-label (a) =
    if a <= 50 then "Good"
    else if a <= 100 then "Moderate"
    else if a <= 150 then "Unhealthy (Sensitive)"
    else "Unhealthy"

  aqi-color-cls : Integer -> Text
  aqi-color-cls (a) =
    if a <= 50 then "aqi-good"
    else if a <= 100 then "aqi-mod"
    else "aqi-bad"

  city-yesterday-temp : Integer -> Integer
  city-yesterday-temp (c) =
    if c == 0 then 65
    else if c == 1 then 60
    else if c == 2 then 63
    else if c == 3 then 85
    else if c == 4 then 76
    else 81

  city-moon-phase : Integer -> Text
  city-moon-phase (c) =
    if c == 0 then "Waxing Crescent"
    else if c == 1 then "Waxing Crescent"
    else if c == 2 then "First Quarter"
    else if c == 3 then "Waxing Gibbous"
    else if c == 4 then "Full Moon"
    else "Waning Gibbous"

  city-moon-icon : Integer -> Text
  city-moon-icon (c) =
    if c == 0 then "&#x1F312;"
    else if c == 1 then "&#x1F312;"
    else if c == 2 then "&#x1F313;"
    else if c == 3 then "&#x1F314;"
    else if c == 4 then "&#x1F315;"
    else "&#x1F316;"

  city-pollen : Integer -> Integer
  city-pollen (c) =
    if c == 0 then 3
    else if c == 1 then 5
    else if c == 2 then 2
    else if c == 3 then 7
    else if c == 4 then 6
    else 4

  pollen-label : Integer -> Text
  pollen-label (p) =
    if p <= 2 then "Low"
    else if p <= 4 then "Medium"
    else if p <= 6 then "High"
    else "Very High"

  clothing-suggest : Integer -> Text
  clothing-suggest (t) =
    if t <= 32 then "&#x1F9E5; Heavy coat, gloves, hat"
    else if t <= 50 then "&#x1F9E5; Warm jacket recommended"
    else if t <= 65 then "&#x1F9E3; Light jacket or sweater"
    else if t <= 80 then "&#x1F455; T-shirt and shorts"
    else "&#x1F455; Light clothing, stay hydrated"

  rain-suggest : Integer -> Text
  rain-suggest (c) =
    let rain = hour-rain-pct c 4
    in if rain >= 40 then " &#x2602; Bring an umbrella!"
    else ""

  wind-arrow : Text -> Text
  wind-arrow (dir) =
    if dir == "N" then "&#x2191;"
    else if dir == "NE" then "&#x2197;"
    else if dir == "E" then "&#x2192;"
    else if dir == "SE" then "&#x2198;"
    else if dir == "S" then "&#x2193;"
    else if dir == "SW" then "&#x2199;"
    else if dir == "W" then "&#x2190;"
    else if dir == "NW" then "&#x2196;"
    else "&#x2022;"

  day-hour-temp : Integer, Integer -> Integer
  day-hour-temp (d) (h) =
    let base-hi = day-hi-val d
    in let base-lo = day-lo-val d
    in let range = base-hi - base-lo
    in if h == 0 then base-lo + range / 4
    else if h == 1 then base-lo + range / 2
    else if h == 2 then base-lo + range * 3 / 4
    else if h == 3 then base-hi
    else if h == 4 then base-hi - range / 4
    else base-lo + range / 3

  day-hour-label : Integer -> Text
  day-hour-label (h) =
    if h == 0 then "6AM"
    else if h == 1 then "9AM"
    else if h == 2 then "12PM"
    else if h == 3 then "3PM"
    else if h == 4 then "6PM"
    else "9PM"

  temp-diff-text : Integer, Integer -> Text
  temp-diff-text (today) (yesterday) =
    let diff = today - yesterday
    in if diff > 0 then "&#x2191;" & show diff & "&#xB0; warmer than yesterday"
    else if diff < 0 then "&#x2193;" & show (0 - diff) & "&#xB0; cooler than yesterday"
    else "Same as yesterday"

  id-num : Text -> Integer
  id-num (id) =
    let n = text-length id
    in if is-digit (char-at id (n - 1)) then digit-value (char-at id (n - 1)) else 0

  wind-chill : Integer, Integer -> Integer
  wind-chill (temp) (wind) =
    if temp <= 50
    then if wind > 3 then 35 + (temp - 35) * wind / 10 else temp
    else temp

  heat-index : Integer, Integer -> Integer
  heat-index (temp) (hum) =
    if temp >= 80
    then if hum >= 40 then temp + (hum - 40) / 4 else temp
    else temp

  refresh-temp-offset : Integer -> Integer
  refresh-temp-offset (rc) =
    let m = rc - rc / 5 * 5
    in if m == 0 then 0
    else if m == 1 then 2
    else if m == 2 then -1
    else if m == 3 then 1
    else -2

Section: Conversions

  f-to-c : Integer -> Integer
  f-to-c (f) = (f - 32) * 5 / 9

  format-temp : Integer -> Text
  format-temp (t) =
    let tu = state-get "temp-unit"
    in if tu == 1 then show (f-to-c t) & "&#xB0;C"
    else show t & "&#xB0;F"

  format-temp-bare : Integer -> Text
  format-temp-bare (t) =
    let tu = state-get "temp-unit"
    in if tu == 1 then show (f-to-c t)
    else show t

  unit-label : Integer -> Text
  unit-label (x) =
    let tu = state-get "temp-unit"
    in if tu == 1 then "&#xB0;C" else "&#xB0;F"

Section: HourlyData

  hour-time-label : Integer -> Text
  hour-time-label (h) =
    if h == 0 then "Now"
    else if h == 1 then "1PM"
    else if h == 2 then "2PM"
    else if h == 3 then "3PM"
    else if h == 4 then "4PM"
    else if h == 5 then "5PM"
    else if h == 6 then "6PM"
    else if h == 7 then "7PM"
    else if h == 8 then "8PM"
    else if h == 9 then "9PM"
    else if h == 10 then "10PM"
    else "11PM"

  hour-icon-data : Integer, Integer -> Text
  hour-icon-data (c) (h) =
    if c == 0
    then if h <= 2 then "&#x26C5;" else if h <= 5 then "&#x2600;" else if h <= 7 then "&#x26C5;" else if h <= 9 then "&#x1F324;" else "&#x1F319;"
    else if c == 1
    then if h <= 3 then "&#x2601;" else if h <= 6 then "&#x1F326;" else if h <= 9 then "&#x2601;" else "&#x1F319;"
    else if c == 2
    then if h <= 4 then "&#x1F32B;" else if h <= 8 then "&#x26C5;" else "&#x1F319;"
    else if c == 3
    then if h <= 7 then "&#x2600;" else if h <= 9 then "&#x1F324;" else "&#x1F319;"
    else if c == 4
    then if h <= 2 then "&#x1F325;" else if h <= 5 then "&#x26C5;" else if h <= 8 then "&#x1F327;" else "&#x1F319;"
    else if h <= 3 then "&#x26C5;" else if h <= 6 then "&#x2600;" else if h <= 9 then "&#x26C5;" else "&#x1F319;"

  hour-temp-data : Integer, Integer -> Integer
  hour-temp-data (c) (h) =
    let base = city-temp c
    in if h == 0 then base
    else if h == 1 then base + 2
    else if h == 2 then base + 4
    else if h == 3 then base + 3
    else if h == 4 then base + 1
    else if h == 5 then base - 1
    else if h == 6 then base - 3
    else if h == 7 then base - 6
    else if h == 8 then base - 8
    else if h == 9 then base - 10
    else if h == 10 then base - 11
    else base - 12

  hour-rain-pct : Integer, Integer -> Integer
  hour-rain-pct (c) (h) =
    if c == 0
    then if h <= 3 then 10 else if h <= 6 then 20 else 5
    else if c == 1
    then if h <= 2 then 40 else if h <= 5 then 60 else if h <= 8 then 45 else 30
    else if c == 2
    then if h <= 5 then 15 else 10
    else if c == 3
    then 5
    else if c == 4
    then if h <= 4 then 25 else if h <= 8 then 70 else 50
    else if h <= 3 then 15 else 10

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let c = state-get "current-city"
    in widget-box "weather" "weather" [
      widget-label "loc" ("&#x1F4CD; " & city-name c),
      location-selector 0,
      toolbar-bar 0,
      current-weather 0,
      clothing-card 0,
      history-compare-card 0,
      widget-label "hourly-title" "HOURLY FORECAST",
      hourly-forecast 0,
      widget-label "weekly-title" "7-DAY FORECAST",
      weekly-forecast 0,
      day-detail 0,
      expanded-day-view 0,
      widget-label "detail-title" "DETAILS",
      detail-grid 0,
      aqi-card 0,
      moon-pollen-section 0,
      alerts-section 0
    ]

  location-selector : Integer -> WidgetNode
  location-selector (x) =
    let c = state-get "current-city"
    in widget-box "loc-sel" "loc-selector" [
      widget-button "city0" "Portland",
      widget-button "city1" "Seattle",
      widget-button "city2" "San Francisco",
      widget-button "city3" "Denver",
      widget-button "city4" "Chicago",
      widget-button "city5" "New York"
    ]

  toolbar-bar : Integer -> WidgetNode
  toolbar-bar (x) =
    let tu = state-get "temp-unit"
    in let toggle-text = if tu == 1 then "&#xB0;F" else "&#xB0;C"
    in let refresh-ts = state-get "refresh-count"
    in let ts-text = if refresh-ts == 0 then "Just now" else "Updated " & show refresh-ts & " refresh(es) ago"
    in widget-box "toolbar" "toolbar" [
      widget-button "toggle-unit" toggle-text,
      widget-button "refresh" "&#x21BB; Refresh",
      widget-label "refresh-ts" ts-text
    ]

  current-weather : Integer -> WidgetNode
  current-weather (x) =
    let c = state-get "current-city"
    in let rc = state-get "refresh-count"
    in let t = city-temp c + refresh-temp-offset rc
    in let fl = city-feels c
    in let hi = city-hi c
    in let lo = city-lo c
    in let hum = city-humidity c
    in let w = city-wind c
    in let wd = city-wind-dir c
    in let uv = city-uv c
    in let vis = city-vis c
    in let wc = wind-chill t w
    in let hi-idx = heat-index t hum
    in let feels-extra = if wc < t then " &#x2022; Wind Chill " & format-temp wc
      else if hi-idx > t then " &#x2022; Heat Index " & format-temp hi-idx
      else ""
    in widget-box "current" "current" [
      widget-label "cur-icon" (city-icon c),
      widget-label "cur-temp" (format-temp t),
      widget-box "cur-info" "current-info" [
        widget-label "cur-desc" (city-cond c),
        widget-label "cur-detail" ("Feels like " & format-temp fl & feels-extra & " &#x2022; High " & format-temp hi & " &#x2022; Low " & format-temp lo & "\nHumidity " & show hum & "% &#x2022; Wind " & show w & " mph " & wd & "\nUV Index " & show uv & " &#x2022; Visibility " & show vis & " mi")
      ]
    ]

  hourly-forecast : Integer -> WidgetNode
  hourly-forecast (x) =
    let c = state-get "current-city"
    in widget-box "hourly" "hourly" [
      hour-card-full "h0" c 0,
      hour-card-full "h1" c 1,
      hour-card-full "h2" c 2,
      hour-card-full "h3" c 3,
      hour-card-full "h4" c 4,
      hour-card-full "h5" c 5,
      hour-card-full "h6" c 6,
      hour-card-full "h7" c 7,
      hour-card-full "h8" c 8,
      hour-card-full "h9" c 9,
      hour-card-full "h10" c 10,
      hour-card-full "h11" c 11
    ]

  hour-card-full : Text, Integer, Integer -> WidgetNode
  hour-card-full (id) (c) (h) =
    let rain = hour-rain-pct c h
    in let rain-text = if rain >= 10 then "&#x1F4A7; " & show rain & "%" else ""
    in widget-box id "hour-card" [
      widget-label (id & "t") (hour-time-label h),
      widget-label (id & "i") (hour-icon-data c h),
      widget-label (id & "v") (format-temp (hour-temp-data c h)),
      widget-label (id & "r") rain-text
    ]

  weekly-forecast : Integer -> WidgetNode
  weekly-forecast (x) =
    widget-box "forecast" "forecast" [
      day-card "d0" 0,
      day-card "d1" 1,
      day-card "d2" 2,
      day-card "d3" 3,
      day-card "d4" 4,
      day-card "d5" 5,
      day-card "d6" 6
    ]

  day-card : Text, Integer -> WidgetNode
  day-card (id) (d) =
    widget-box-click id (day-cls d) [
      widget-label (id & "n") (day-name d),
      widget-label (id & "i") (day-icon d),
      widget-label (id & "h") (format-temp-bare (day-hi-val d) & unit-label 0),
      widget-label (id & "l") (format-temp-bare (day-lo-val d) & unit-label 0)
    ]

  day-cls : Integer -> Text
  day-cls (d) =
    if state-get "selected-day" == d then "day-card active" else "day-card"
  day-name : Integer -> Text
  day-name (d) =
    if d == 0 then "Today"
    else if d == 1 then "Mon"
    else if d == 2 then "Tue"
    else if d == 3 then "Wed"
    else if d == 4 then "Thu"
    else if d == 5 then "Fri"
    else "Sat"
  day-icon : Integer -> Text
  day-icon (d) =
    if d == 0 then "&#x26C5;"
    else if d == 1 then "&#x2600;"
    else if d == 2 then "&#x2600;"
    else if d == 3 then "&#x1F327;"
    else if d == 4 then "&#x1F327;"
    else if d == 5 then "&#x26C5;"
    else "&#x2600;"
  day-hi-val : Integer -> Integer
  day-hi-val (d) =
    if d == 0 then 72
    else if d == 1 then 76
    else if d == 2 then 78
    else if d == 3 then 64
    else if d == 4 then 60
    else if d == 5 then 68
    else 74
  day-lo-val : Integer -> Integer
  day-lo-val (d) =
    if d == 0 then 54
    else if d == 1 then 56
    else if d == 2 then 58
    else if d == 3 then 52
    else if d == 4 then 50
    else if d == 5 then 53
    else 55
  day-cond : Integer -> Text
  day-cond (d) =
    if d == 0 then "Partly Cloudy"
    else if d == 1 then "Sunny"
    else if d == 2 then "Sunny"
    else if d == 3 then "Rain"
    else if d == 4 then "Rain"
    else if d == 5 then "Partly Cloudy"
    else "Sunny"

  day-detail : Integer -> WidgetNode
  day-detail (x) =
    let d = state-get "selected-day"
    in widget-box-click "day-detail" "detail-card" [
      widget-label "dd-title" (day-name d & " Forecast"),
      widget-label "dd-val" (day-icon d & " " & format-temp-bare (day-hi-val d) & unit-label 0 & " / " & format-temp-bare (day-lo-val d) & unit-label 0),
      widget-label "dd-sub" (day-cond d & " &#x2022; Click to expand")
    ]

  expanded-day-view : Integer -> WidgetNode
  expanded-day-view (x) =
    let d = state-get "selected-day"
    in let expanded = state-get "day-expanded"
    in if expanded == 0 then widget-label "no-expand" ""
    else widget-box "expand" "expand-day" [
      widget-label "exp-title" (day-name d & " Hourly Breakdown"),
      widget-box "exp-hours" "expand-hours" [
        expand-hour-slot d 0,
        expand-hour-slot d 1,
        expand-hour-slot d 2,
        expand-hour-slot d 3,
        expand-hour-slot d 4,
        expand-hour-slot d 5
      ]
    ]

  expand-hour-slot : Integer, Integer -> WidgetNode
  expand-hour-slot (d) (h) =
    widget-box ("eh" & show d & show h) "expand-hour" [
      widget-label ("eht" & show d & show h) (day-hour-label h),
      widget-label ("ehv" & show d & show h) (format-temp (day-hour-temp d h))
    ]

  aqi-card : Integer -> WidgetNode
  aqi-card (x) =
    let c = state-get "current-city"
    in let a = city-aqi c
    in widget-box "aqi" ("aqi-card " & aqi-color-cls a) [
      widget-label "aqi-title" "AIR QUALITY INDEX",
      widget-label "aqi-val" (show a & " - " & aqi-label a),
      widget-label "aqi-sub" "EPA Standard"
    ]

  moon-pollen-section : Integer -> WidgetNode
  moon-pollen-section (x) =
    let c = state-get "current-city"
    in widget-box "moon-pollen" "details" [
      widget-box "moon" "detail-card" [
        widget-label "moon-t" "MOON PHASE",
        widget-box "moon-row" "moon-card" [
          widget-label "moon-i" (city-moon-icon c),
          widget-label "moon-v" (city-moon-phase c)
        ]
      ],
      widget-box "pollen" "detail-card" [
        widget-label "pollen-t" "POLLEN COUNT",
        widget-label "pollen-v" (show (city-pollen c) & "/10"),
        widget-label "pollen-s" (pollen-label (city-pollen c))
      ]
    ]

  clothing-card : Integer -> WidgetNode
  clothing-card (x) =
    let c = state-get "current-city"
    in let t = city-temp c
    in widget-box "suggest" "suggest-card" [
      widget-label "suggest-text" (clothing-suggest t & rain-suggest c)
    ]

  history-compare-card : Integer -> WidgetNode
  history-compare-card (x) =
    let c = state-get "current-city"
    in let today = city-temp c
    in let yesterday = city-yesterday-temp c
    in widget-box "history-cmp" "history-compare" [
      widget-label "hist-text" (temp-diff-text today yesterday)
    ]

  detail-grid : Integer -> WidgetNode
  detail-grid (x) =
    let c = state-get "current-city"
    in let wd = city-wind-dir c
    in widget-box "details" "details" [
      detail-card "uv" "UV INDEX" (show (city-uv c)) (uv-desc (city-uv c)),
      detail-card "wind" "WIND" (wind-arrow wd & " " & show (city-wind c) & " mph " & wd) ("Compass: " & wd & " direction"),
      detail-card "hum" "HUMIDITY" (show (city-humidity c) & "%") ("Dew point " & format-temp (city-lo c)),
      detail-card "vis" "VISIBILITY" (show (city-vis c) & " mi") (vis-desc (city-vis c)),
      detail-card "pres" "PRESSURE" (city-pressure c & " in") "Steady",
      detail-card "sun" "SUN" ("&#x1F305; " & city-sunrise c) ("&#x1F307; Sunset " & city-sunset c)
    ]

  uv-desc : Integer -> Text
  uv-desc (uv) =
    if uv <= 2 then "Low"
    else if uv <= 5 then "Moderate"
    else if uv <= 7 then "High"
    else "Very High"

  vis-desc : Integer -> Text
  vis-desc (v) =
    if v >= 8 then "Clear"
    else if v >= 5 then "Moderate"
    else "Low visibility"

  detail-card : Text, Text, Text, Text -> WidgetNode
  detail-card (id) (title) (value) (sub) =
    widget-box id "detail-card" [
      widget-label (id & "t") title,
      widget-label (id & "v") value,
      widget-label (id & "s") sub
    ]

  alerts-section : Integer -> WidgetNode
  alerts-section (x) =
    let c = state-get "current-city"
    in let t = city-temp c
    in let w = city-wind c
    in let hum = city-humidity c
    in let has-heat = if t > 95 then 1 else 0
    in let has-wind = if w > 30 then 1 else 0
    in let has-humid = if hum > 90 then 1 else 0
    in let has-any = has-heat + has-wind + has-humid
    in if has-any == 0 then widget-label "no-alerts" ""
    else widget-box "alerts" "alerts" (alert-items has-heat has-wind has-humid)

  alert-items : Integer, Integer, Integer -> List WidgetNode
  alert-items (heat) (wind) (humid) =
    if heat == 1
    then if wind == 1
      then if humid == 1
        then [heat-alert 0, wind-alert 0, humid-alert 0]
        else [heat-alert 0, wind-alert 0]
      else if humid == 1
        then [heat-alert 0, humid-alert 0]
        else [heat-alert 0]
    else if wind == 1
      then if humid == 1
        then [wind-alert 0, humid-alert 0]
        else [wind-alert 0]
      else [humid-alert 0]

  heat-alert : Integer -> WidgetNode
  heat-alert (x) =
    widget-box "alert-heat" "alert-card alert-heat" [
      widget-label "ah-icon" "&#x1F525;",
      widget-box "ah-text" "alert-text" [
        widget-label "ah-title" "Heat Advisory",
        widget-label "ah-desc" "Temperature exceeds 95&#xB0;F. Stay hydrated and avoid prolonged sun exposure."
      ]
    ]

  wind-alert : Integer -> WidgetNode
  wind-alert (x) =
    widget-box "alert-wind" "alert-card alert-wind" [
      widget-label "aw-icon" "&#x1F4A8;",
      widget-box "aw-text" "alert-text" [
        widget-label "aw-title" "Wind Advisory",
        widget-label "aw-desc" "Wind speeds exceed 30 mph. Secure loose outdoor items."
      ]
    ]

  humid-alert : Integer -> WidgetNode
  humid-alert (x) =
    widget-box "alert-humid" "alert-card alert-humid" [
      widget-label "ahm-icon" "&#x1F4A7;",
      widget-box "ahm-text" "alert-text" [
        widget-label "ahm-title" "High Humidity Alert",
        widget-label "ahm-desc" "Humidity exceeds 90%. Heat index may be significantly higher than actual temperature."
      ]
    ]

Section: Handlers

  weather-click : Text -> Integer
  weather-click (id) =
    if text-starts-with id "d"
    then let day-num = id-num id
    in let s1 = state-set "selected-day" day-num
    in let s2 = state-set-render "day-expanded" 0 in 0
    else if text-starts-with id "city"
    then let s = state-set-render "current-city" (id-num id) in 0
    else if id == "toggle-unit"
    then let cur = state-get "temp-unit"
    in let next = if cur == 0 then 1 else 0
    in let s = state-set-render "temp-unit" next in 0
    else if id == "refresh"
    then let cur = state-get "refresh-count"
    in let s = state-set-render "refresh-count" (cur + 1) in 0
    else if id == "day-detail"
    then let cur = state-get "day-expanded"
    in let next = if cur == 0 then 1 else 0
    in let s = state-set-render "day-expanded" next in 0
    else 0

Section: Entry

  render-weather : Integer -> Integer
  render-weather (x) = mount-widget-themed weather-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style weather-theme weather-css
    in let sd = state-set "selected-day" 0
    in let i0 = state-set "current-city" 0
    in let i1 = state-set "temp-unit" 0
    in let i2 = state-set "refresh-count" 0
    in let i3 = state-set "day-expanded" 0
    in let s = set-render render-weather
    in let h = register-handlers no-pick weather-click
    in render-weather 0
  end

