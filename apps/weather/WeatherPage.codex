Chapter: WeatherPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Weather dashboard with forecasts and atmospheric data.

 We say:

Section: Theme

  weather-theme : Theme
  weather-theme =
    let p = Palette { pal-bg = 921134, pal-fg = #E1E1E1, pal-primary = 4560127, pal-secondary = #181818, pal-accent = #FF9900, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 8)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "weather-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  weather-css : Text
  weather-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:linear-gradient(180deg,#0e1126 0%,#1a2040 50%,#0e1126 100%);color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".weather{max-width:900px;margin:0 auto;padding:24px}"
    & ".location{font-size:14px;color:#8899aa;margin-bottom:4px;display:flex;align-items:center;gap:8px}"
    & ".current{display:flex;align-items:center;gap:32px;padding:40px 0}"
    & ".current-icon{font-size:80px}"
    & ".current-temp{font-size:72px;font-weight:200;color:#fff}"
    & ".current-info{flex:1}"
    & ".current-desc{font-size:20px;color:#aab;margin-bottom:8px;text-transform:capitalize}"
    & ".current-detail{font-size:13px;color:#778;line-height:1.8}"
    & ".forecast{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin:24px 0}"
    & ".day-card{background:rgba(255,255,255,.05);border-radius:12px;padding:16px 8px;text-align:center;transition:background .15s}"
    & ".day-card:hover{background:rgba(255,255,255,.1)}"
    & ".day-name{font-size:12px;color:#778;margin-bottom:8px;text-transform:uppercase}"
    & ".day-icon{font-size:28px;margin-bottom:8px}"
    & ".day-hi{font-size:16px;font-weight:600;color:#fff}"
    & ".day-lo{font-size:14px;color:#556}"
    & ".details{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:24px 0}"
    & ".detail-card{background:rgba(255,255,255,.05);border-radius:12px;padding:20px}"
    & ".detail-title{font-size:12px;color:#778;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}"
    & ".detail-val{font-size:24px;font-weight:600;color:#fff}"
    & ".detail-sub{font-size:12px;color:#778;margin-top:4px}"
    & ".hourly{display:flex;gap:12px;overflow-x:auto;padding:16px 0;margin:8px 0}"
    & ".hour-card{flex-shrink:0;background:rgba(255,255,255,.05);border-radius:12px;padding:12px 16px;text-align:center;min-width:70px}"
    & ".hour-time{font-size:12px;color:#778;margin-bottom:6px}"
    & ".hour-icon{font-size:20px;margin-bottom:4px}"
    & ".hour-temp{font-size:14px;font-weight:600}"
    & ".section-title{font-size:14px;color:#778;text-transform:uppercase;letter-spacing:1px;margin:24px 0 12px}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "weather" "weather" [
      widget-label "loc" "&#x1F4CD; Portland, Oregon",
      current-weather 0,
      widget-label "hourly-title" "HOURLY FORECAST",
      hourly-forecast 0,
      widget-label "weekly-title" "7-DAY FORECAST",
      weekly-forecast 0,
      day-detail 0,
      widget-label "detail-title" "DETAILS",
      detail-grid 0
    ]

  current-weather : Integer -> WidgetNode
  current-weather (x) =
    widget-box "current" "current" [
      widget-label "cur-icon" "&#x26C5;",
      widget-label "cur-temp" "68&#xB0;",
      widget-box "cur-info" "current-info" [
        widget-label "cur-desc" "Partly Cloudy",
        widget-label "cur-detail" "Feels like 65&#xB0; &#x2022; High 72&#xB0; &#x2022; Low 54&#xB0;\nHumidity 62% &#x2022; Wind 8 mph NW\nUV Index 5 &#x2022; Visibility 10 mi"
      ]
    ]

  hourly-forecast : Integer -> WidgetNode
  hourly-forecast (x) =
    widget-box "hourly" "hourly" [
      hour-card "h0" "Now" "&#x26C5;" "68&#xB0;",
      hour-card "h1" "1PM" "&#x2600;" "70&#xB0;",
      hour-card "h2" "2PM" "&#x2600;" "72&#xB0;",
      hour-card "h3" "3PM" "&#x2600;" "71&#xB0;",
      hour-card "h4" "4PM" "&#x26C5;" "69&#xB0;",
      hour-card "h5" "5PM" "&#x26C5;" "67&#xB0;",
      hour-card "h6" "6PM" "&#x1F324;" "65&#xB0;",
      hour-card "h7" "7PM" "&#x1F319;" "62&#xB0;",
      hour-card "h8" "8PM" "&#x1F319;" "60&#xB0;",
      hour-card "h9" "9PM" "&#x1F319;" "58&#xB0;"
    ]

  hour-card : Text, Text, Text, Text -> WidgetNode
  hour-card (id) (time) (icon) (temp) =
    widget-box id "hour-card" [
      widget-label (id & "t") time,
      widget-label (id & "i") icon,
      widget-label (id & "v") temp
    ]

  weekly-forecast : Integer -> WidgetNode
  weekly-forecast (x) =
    widget-box "forecast" "forecast" [
      day-card "d0" 0,
      day-card "d1" 1,
      day-card "d2" 2,
      day-card "d3" 3,
      day-card "d4" 4,
      day-card "d5" 5,
      day-card "d6" 6
    ]

  day-card : Text, Integer -> WidgetNode
  day-card (id) (d) =
    widget-box-click id (day-cls d) [
      widget-label (id & "n") (day-name d),
      widget-label (id & "i") (day-icon d),
      widget-label (id & "h") (day-hi d & "&#xB0;"),
      widget-label (id & "l") (day-lo d & "&#xB0;")
    ]

  day-cls : Integer -> Text
  day-cls (d) =
    if state-get "selected-day" == d then "day-card active" else "day-card"
  day-name : Integer -> Text
  day-name (d) =
    if d == 0 then "Today"
    else if d == 1 then "Mon"
    else if d == 2 then "Tue"
    else if d == 3 then "Wed"
    else if d == 4 then "Thu"
    else if d == 5 then "Fri"
    else "Sat"
  day-icon : Integer -> Text
  day-icon (d) =
    if d == 0 then "&#x26C5;"
    else if d == 1 then "&#x2600;"
    else if d == 2 then "&#x2600;"
    else if d == 3 then "&#x1F327;"
    else if d == 4 then "&#x1F327;"
    else if d == 5 then "&#x26C5;"
    else "&#x2600;"
  day-hi : Integer -> Text
  day-hi (d) =
    if d == 0 then "72"
    else if d == 1 then "76"
    else if d == 2 then "78"
    else if d == 3 then "64"
    else if d == 4 then "60"
    else if d == 5 then "68"
    else "74"
  day-lo : Integer -> Text
  day-lo (d) =
    if d == 0 then "54"
    else if d == 1 then "56"
    else if d == 2 then "58"
    else if d == 3 then "52"
    else if d == 4 then "50"
    else if d == 5 then "53"
    else "55"
  day-cond : Integer -> Text
  day-cond (d) =
    if d == 0 then "Partly Cloudy"
    else if d == 1 then "Sunny"
    else if d == 2 then "Sunny"
    else if d == 3 then "Rain"
    else if d == 4 then "Rain"
    else if d == 5 then "Partly Cloudy"
    else "Sunny"

  day-detail : Integer -> WidgetNode
  day-detail (x) =
    let d = state-get "selected-day"
    in widget-box "day-detail" "detail-card" [
      widget-label "dd-title" (day-name d & " Forecast"),
      widget-label "dd-val" (day-icon d & " " & day-hi d & "&#xB0; / " & day-lo d & "&#xB0;"),
      widget-label "dd-sub" (day-cond d)
    ]

  detail-grid : Integer -> WidgetNode
  detail-grid (x) =
    widget-box "details" "details" [
      detail-card "uv" "UV INDEX" "5" "Moderate",
      detail-card "wind" "WIND" "8 mph" "NW direction",
      detail-card "hum" "HUMIDITY" "62%" "Dew point 54&#xB0;",
      detail-card "vis" "VISIBILITY" "10 mi" "Clear",
      detail-card "pres" "PRESSURE" "30.12 in" "Steady",
      detail-card "sun" "SUNRISE" "5:24 AM" "Sunset 8:58 PM"
    ]

  detail-card : Text, Text, Text, Text -> WidgetNode
  detail-card (id) (title) (value) (sub) =
    widget-box id "detail-card" [
      widget-label (id & "t") title,
      widget-label (id & "v") value,
      widget-label (id & "s") sub
    ]

Section: Handlers

  weather-click : Text -> Integer
  weather-click (id) =
    if text-starts-with id "d"
    then let s = state-set-render "selected-day" (id-num id) in 0
    else 0

Section: Entry

  render-weather : Integer -> Integer
  render-weather (x) = mount-widget-themed weather-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style weather-theme weather-css
    in let s = set-render render-weather
    in let h = register-handlers no-pick weather-click
    in render-weather 0
  end

