Chapter: Turn
  cites CodexMagic chapter GameState

 We say:

Section: Phase Constants

  phase-beginning : Integer
  phase-beginning = 0

  phase-main-1 : Integer
  phase-main-1 = 1

  phase-combat : Integer
  phase-combat = 2

  phase-main-2 : Integer
  phase-main-2 = 3

  phase-ending : Integer
  phase-ending = 4

Section: Step Constants

  step-untap : Integer
  step-untap = 0

  step-upkeep : Integer
  step-upkeep = 1

  step-draw : Integer
  step-draw = 2

  step-begin-combat : Integer
  step-begin-combat = 3

  step-attackers : Integer
  step-attackers = 4

  step-blockers : Integer
  step-blockers = 5

  step-damage : Integer
  step-damage = 6

  step-end-combat : Integer
  step-end-combat = 7

  step-end : Integer
  step-end = 8

  step-cleanup : Integer
  step-cleanup = 9

Section: Phase Names

  phase-name : Integer -> Text
  phase-name (p) =
    if p == 0 then "Beginning"
    else if p == 1 then "Pre-combat Main"
    else if p == 2 then "Combat"
    else if p == 3 then "Post-combat Main"
    else if p == 4 then "Ending"
    else "Unknown"

  step-name : Integer -> Text
  step-name (s) =
    if s == 0 then "Untap"
    else if s == 1 then "Upkeep"
    else if s == 2 then "Draw"
    else if s == 3 then "Begin Combat"
    else if s == 4 then "Declare Attackers"
    else if s == 5 then "Declare Blockers"
    else if s == 6 then "Combat Damage"
    else if s == 7 then "End Combat"
    else if s == 8 then "End Step"
    else if s == 9 then "Cleanup"
    else "Unknown"

Section: Phase Transitions

  next-step : Integer -> Integer
  next-step (current) =
    if current == 0 then 1
    else if current == 1 then 2
    else if current == 2 then 3
    else if current == 3 then 4
    else if current == 4 then 5
    else if current == 5 then 6
    else if current == 6 then 7
    else if current == 7 then 8
    else if current == 8 then 9
    else 0

  step-to-phase : Integer -> Integer
  step-to-phase (s) =
    if s <= 2 then phase-beginning
    else if s == 3 then phase-main-1
    else if s <= 7 then phase-combat
    else if s == 8 then phase-main-2
    else phase-ending

  is-main-phase : Integer -> Boolean
  is-main-phase (step) = step == 3 | step == 8

  advance-step : GameState -> GameState
  advance-step (gs) =
    let new-step = next-step (gs.step)
    in let new-phase = step-to-phase new-step
    in GameState {
      players = gs.players,
      generals = gs.generals,
      battlefield = gs.battlefield,
      active-player = gs.active-player,
      priority-player = gs.active-player,
      turn-number = gs.turn-number,
      phase = new-phase,
      step = new-step,
      next-permanent-id = gs.next-permanent-id,
      next-instance-id = gs.next-instance-id,
      game-over = gs.game-over,
      winner = gs.winner,
      templates = gs.templates
    }

  advance-turn : GameState -> GameState
  advance-turn (gs) =
    let new-active = non-active-player gs
    in GameState {
      players = gs.players,
      generals = gs.generals,
      battlefield = gs.battlefield,
      active-player = new-active,
      priority-player = new-active,
      turn-number = gs.turn-number + 1,
      phase = phase-beginning,
      step = step-untap,
      next-permanent-id = gs.next-permanent-id,
      next-instance-id = gs.next-instance-id,
      game-over = gs.game-over,
      winner = gs.winner,
      templates = gs.templates
    }

