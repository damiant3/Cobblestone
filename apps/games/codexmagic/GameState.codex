Section: Zone Identifiers

  Zone =
   | ZoneLibrary
   | ZoneHand
   | ZoneBattlefield
   | ZoneGraveyard
   | ZoneExile

  zone-name : Zone -> Text
  zone-name (z) =
    when z
      is ZoneLibrary -> "Library"
      is ZoneHand -> "Hand"
      is ZoneBattlefield -> "Battlefield"
      is ZoneGraveyard -> "Graveyard"
      is ZoneExile -> "Exile"

Section: General State

  GeneralState = record {
    template-id : Integer,
    life : Integer,
    damage-marked : Integer,
    counters : Integer,
    is-tapped : Boolean,
    power-mod : Integer,
    toughness-mod : Integer,
    defense-mod : Integer,
    loyalty-turn : Integer
  }

  general-state-new : Integer, Integer -> GeneralState
  general-state-new (template-id) (starting-life) = GeneralState {
    template-id = template-id,
    life = starting-life,
    damage-marked = 0,
    counters = 0,
    is-tapped = False,
    power-mod = 0,
    toughness-mod = 0,
    defense-mod = 0,
    loyalty-turn = 0 - 1
  }

  general-deal-damage : GeneralState, Integer -> GeneralState
  general-deal-damage (gs) (amount) = GeneralState {
    template-id = gs.template-id,
    life = gs.life - amount,
    damage-marked = gs.damage-marked + amount,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = gs.loyalty-turn
  }

  general-gain-life : GeneralState, Integer -> GeneralState
  general-gain-life (gs) (amount) = GeneralState {
    template-id = gs.template-id,
    life = gs.life + amount,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = gs.loyalty-turn
  }

  general-clear-damage : GeneralState -> GeneralState
  general-clear-damage (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = 0,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = gs.loyalty-turn
  }

  general-tap : GeneralState -> GeneralState
  general-tap (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = True,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = gs.loyalty-turn
  }

  general-untap : GeneralState -> GeneralState
  general-untap (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = False,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = gs.loyalty-turn
  }

  general-use-loyalty : GeneralState, Integer -> GeneralState
  general-use-loyalty (gs) (turn) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod,
    loyalty-turn = turn
  }

Section: Player State

  PlayerState = record {
    general : GeneralState,
    prismatic : PrismaticState,
    library : List Integer,
    hand : List Integer,
    graveyard : List Integer,
    exile : List Integer,
    gem-drop-used : Boolean
  }

  player-new : Integer, Integer -> PlayerState
  player-new (general-template-id) (general-life) = PlayerState {
    general = general-state-new general-template-id general-life,
    prismatic = prismatic-new,
    library = [],
    hand = [],
    graveyard = [],
    exile = [],
    gem-drop-used = False
  }

  player-draw : PlayerState -> PlayerState
  player-draw (p) =
    if list-length (p.library) == 0 then p
    else let card = list-at (p.library) 0
    in PlayerState {
      general = p.general,
      prismatic = p.prismatic,
      library = list-drop-front (p.library),
      hand = list-push (p.hand) card,
      graveyard = p.graveyard,
      exile = p.exile,
      gem-drop-used = p.gem-drop-used
    }

  player-add-to-hand : PlayerState, Integer -> PlayerState
  player-add-to-hand (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = list-push (p.hand) card-id,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-remove-from-hand : PlayerState, Integer -> PlayerState
  player-remove-from-hand (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = gs-list-remove (p.hand) card-id,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-add-to-graveyard : PlayerState, Integer -> PlayerState
  player-add-to-graveyard (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = p.hand,
    graveyard = list-push (p.graveyard) card-id,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-reset-gem-drop : PlayerState -> PlayerState
  player-reset-gem-drop (p) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = False
  }

  player-gain-ray : PlayerState -> PlayerState
  player-gain-ray (p) = PlayerState {
    general = p.general,
    prismatic = prismatic-gain-ray (p.prismatic),
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-refresh-prismatic : PlayerState -> PlayerState
  player-refresh-prismatic (p) = PlayerState {
    general = p.general,
    prismatic = prismatic-refresh (p.prismatic),
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-spend-rays : PlayerState, Integer -> PlayerState
  player-spend-rays (p) (n) = PlayerState {
    general = p.general,
    prismatic = prismatic-spend-rays (p.prismatic) n,
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

Section: Permanent

  TemporaryModifiers = record { power : Integer, toughness : Integer, defense : Integer, keywords : KeywordSet }

  temporary-none : TemporaryModifiers
  temporary-none = TemporaryModifiers { power = 0, toughness = 0, defense = 0, keywords = keywords-none }

  Permanent = record {
    id : Integer,
    card-id : Integer,
    template-id : Integer,
    controller : Integer,
    owner : Integer,
    tapped : Boolean,
    summoning-sick : Boolean,
    damage-marked : Integer,
    counters : Integer,
    keywords : KeywordSet,
    attached-to : Integer,
    power-mod : Integer,
    toughness-mod : Integer,
    defense-mod : Integer,
    equipped-to : Integer,
    socketed-gem : Integer,
    temporary : TemporaryModifiers
  }

  permanent-new : Integer, Integer, Integer, Integer -> Permanent
  permanent-new (id) (card-id) (template-id) (controller) = Permanent {
    id = id, card-id = card-id, template-id = template-id,
    controller = controller, owner = controller,
    tapped = False, summoning-sick = True, damage-marked = 0,
    counters = 0, keywords = keywords-none, attached-to = -1,
    power-mod = 0, toughness-mod = 0, defense-mod = 0,
    equipped-to = -1, socketed-gem = -1, temporary = temporary-none
  }

  permanent-tap : Permanent -> Permanent
  permanent-tap (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = True, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = perm.temporary
  }

  permanent-untap : Permanent -> Permanent
  permanent-untap (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = False, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = perm.temporary
  }

  permanent-clear-sickness : Permanent -> Permanent
  permanent-clear-sickness (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = False,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = perm.temporary
  }

  permanent-deal-damage : Permanent, Integer -> Permanent
  permanent-deal-damage (perm) (amount) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked + amount, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = perm.temporary
  }

  permanent-clear-damage : Permanent -> Permanent
  permanent-clear-damage (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = perm.summoning-sick,
    damage-marked = 0, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = perm.temporary
  }

Section: Game State

  permanent-boost : Permanent, Integer, Integer, Integer, Boolean -> Permanent
  permanent-boost (perm) (pw) (to) (de) (temporary) =
    let mods = perm.temporary
    in let duration = if temporary then TemporaryModifiers { power = mods.power + pw, toughness = mods.toughness + to, defense = mods.defense + de, keywords = mods.keywords } else mods
    in Permanent { id = perm.id, card-id = perm.card-id, template-id = perm.template-id, controller = perm.controller, owner = perm.owner, tapped = perm.tapped, summoning-sick = perm.summoning-sick, damage-marked = perm.damage-marked, counters = perm.counters, keywords = perm.keywords, attached-to = perm.attached-to, power-mod = perm.power-mod + pw, toughness-mod = perm.toughness-mod + to, defense-mod = perm.defense-mod + de, equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem, temporary = duration }

  permanent-grant : Permanent, Keyword, Boolean -> Permanent
  permanent-grant (perm) (kw) (temporary) =
    let mods = perm.temporary
    in let expires = if temporary then (if has-keyword (perm.keywords) kw then mods.keywords else grant-keyword (mods.keywords) kw)
      else keywords-without (mods.keywords) (grant-keyword keywords-none kw)
    in let copy = permanent-boost perm 0 0 0 False
    in __record-set (__record-set copy "keywords" (grant-keyword (perm.keywords) kw)) "temporary" (TemporaryModifiers { power = mods.power, toughness = mods.toughness, defense = mods.defense, keywords = expires })

  permanent-expire : Permanent -> Permanent
  permanent-expire (perm) =
    let mods = perm.temporary
    in let stats = permanent-boost perm (0 - mods.power) (0 - mods.toughness) (0 - mods.defense) False
    in __record-set (__record-set stats "keywords" (keywords-without (perm.keywords) (mods.keywords))) "temporary" temporary-none

 These wire values keep card-order lookups allocation-free inside AI scans.

  card-order-auto : Integer = 0
  card-order-hold : Integer = 1
  card-order-next : Integer = 2

  GameState = record {
    queued-loyalty : List QueuedAbility,
    loyalty-state : LoyaltyState,
    queued-cards : List QueuedCard,
    automatic-work : AutomaticWork,
    players : List PlayerState,
    generals : List GeneralTemplate,
    battlefield : List Permanent,
    active-player : Integer,
    priority-player : Integer,
    turn-number : Integer,
    phase : Integer,
    step : Integer,
    next-permanent-id : Integer,
    next-instance-id : Integer,
    game-over : Boolean,
    winner : Integer,
    templates : List CardTemplate,
    card-templates : List Integer,
    card-orders : List Integer,
    disruption : DisruptionState,
    queued-abilities : List QueuedAbility
  }

  game-new : List CardTemplate, GeneralTemplate, GeneralTemplate -> GameState
  game-new (templates) (gen-a) (gen-b) = GameState { queued-loyalty = [queued-ability-none, queued-ability-none], loyalty-state = loyalty-state-new, queued-cards = [queued-card-none, queued-card-none], automatic-work = automatic-work-new,
    players = [player-new (gen-a.id) (gen-a.life), player-new (gen-b.id) (gen-b.life)],
    generals = [gen-a, gen-b],
    battlefield = [],
    active-player = 0,
    priority-player = 0,
    turn-number = 1,
    phase = 0,
    step = 0,
    next-permanent-id = 0,
    next-instance-id = 0,
    game-over = False,
    winner = -1,
    templates = templates,
    card-templates = [],
    card-orders = [], disruption = disruption-state-new 0, queued-abilities = [queued-ability-none, queued-ability-none]
  }

Section: Game State Accessors

  QueuedCard = record { card : Integer, target : Integer, after-turn : Integer, after-stage : Integer, attempt-turn : Integer, attempt-stage : Integer, label : Text, reason : Text }

  queued-card-none : QueuedCard
  queued-card-none = QueuedCard { card = 0 - 1, target = 0 - 3, after-turn = 0, after-stage = 0, attempt-turn = 0 - 1, attempt-stage = 0 - 1, label = "", reason = "" }

  card-queues-after-hand : GameState, Integer, List Integer -> List QueuedCard
  card-queues-after-hand (gs) (player) (hand) =
    let q = list-at (gs.queued-cards) player
    in if q.card < 0 then gs.queued-cards
    else if int-list-has hand (q.card) then gs.queued-cards
    else list-set-at (for item in gs.queued-cards -> item) player queued-card-none

  game-set-queued-card : GameState, Integer, QueuedCard -> GameState
  game-set-queued-card (gs) (player) (q) =
    let copy = game-with-work gs (gs.automatic-work)
    in __record-set copy "queued-cards" (list-set-at (for item in gs.queued-cards -> item) player q)

  queued-card-reserved : GameState, Integer -> Boolean
  queued-card-reserved (gs) (card) = ((list-at (gs.queued-cards) 0).card == card | (list-at (gs.queued-cards) 1).card == card) & card >= 0

  AutomaticWork = record { count : Integer, last : Text, stop : Integer, stop-count : Integer }

  automatic-action-limit : Integer = 500

  automatic-work-new : AutomaticWork
  automatic-work-new = AutomaticWork { count = 0, last = "", stop = 0, stop-count = 0 }

  game-budget-stopped : GameState -> Boolean
  game-budget-stopped (gs) = gs.game-over == False & (gs.automatic-work).stop > 0

  game-with-work : GameState, AutomaticWork -> GameState
  game-with-work (gs) (work) = GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = gs.queued-cards, automatic-work = work, players = gs.players, generals = gs.generals, battlefield = gs.battlefield, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates, card-templates = gs.card-templates, card-orders = gs.card-orders, disruption = gs.disruption, queued-abilities = gs.queued-abilities }

  game-work-reset : GameState -> GameState
  game-work-reset (gs) = game-with-work gs automatic-work-new

  game-work-action : GameState, Text -> GameState
  game-work-action (gs) (label) = game-with-work gs (AutomaticWork { count = (gs.automatic-work).count + 1, last = label, stop = 0, stop-count = 0 })

  game-work-stop : GameState, Integer, Integer, Text -> GameState
  game-work-stop (gs) (kind) (count) (last) = game-with-work gs (AutomaticWork { count = (gs.automatic-work).count, last = last, stop = kind, stop-count = count })

  budget-stop-reason : GameState -> Text
  budget-stop-reason (gs) =
    let work = gs.automatic-work
    in if game-budget-stopped gs == False then ""
    else (if work.stop == 1 then "Automatic action budget" else "State-based action budget") & " stopped at " & show (work.stop-count) & "; last action: " & work.last

  QueuedAbility = record { source : Integer, ability : Integer, target : Integer, after-turn : Integer, after-stage : Integer, attempt-turn : Integer, attempt-stage : Integer, label : Text, reason : Text }

  queued-ability-none : QueuedAbility
  queued-ability-none = QueuedAbility { source = 0 - 1, ability = 0 - 1, target = 0 - 3, after-turn = 0, after-stage = 0, attempt-turn = 0 - 1, attempt-stage = 0 - 1, label = "", reason = "" }

  game-set-queued-loyalty : GameState, Integer, QueuedAbility -> GameState
  game-set-queued-loyalty (gs) (player) (order) =
    let orders = list-set-at (for q in gs.queued-loyalty -> q) player order
    in __record-set (game-with-disruption gs (gs.disruption)) "queued-loyalty" orders

  game-set-queued-ability : GameState, Integer, QueuedAbility -> GameState
  game-set-queued-ability (gs) (player) (order) =
    let orders = list-set-at (for q in gs.queued-abilities -> q) player order
    in GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = gs.queued-cards, automatic-work = gs.automatic-work, players = gs.players, generals = gs.generals, battlefield = gs.battlefield, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates, card-templates = gs.card-templates, card-orders = gs.card-orders, disruption = gs.disruption, queued-abilities = orders }

  LoyaltyEvent = record { player : Integer, index : Integer, effect : Effect }

  LoyaltyState = record { seen-a : Integer, seen-b : Integer, pending : List LoyaltyEvent, cursor : Integer }

  loyalty-state-new : LoyaltyState
  loyalty-state-new = LoyaltyState { seen-a = 0, seen-b = 0, pending = [], cursor = 0 }

  loyalty-pending : GameState -> Boolean
  loyalty-pending (gs) = (gs.loyalty-state).cursor < list-length ((gs.loyalty-state).pending)

  game-with-loyalty : GameState, LoyaltyState -> GameState
  game-with-loyalty (gs) (state) = __record-set (game-with-disruption gs (gs.disruption)) "loyalty-state" state

  has-loyalty-gain : GeneralTemplate -> Boolean
  has-loyalty-gain (g) = has-loyalty-gain-at (g.abilities) 0

  has-loyalty-gain-at : List Ability, Integer -> Boolean
  has-loyalty-gain-at (abs) (i) =
    if i >= list-length abs then False
    else let found = when list-at abs i is LoyaltyGainAbility (threshold) (eff) -> threshold > 0 is otherwise -> False
    in if found then True else has-loyalty-gain-at abs (i + 1)

  observe-loyalty : GameState -> GameState
  observe-loyalty (gs) =
    if gs.game-over | disruption-pending gs then gs
    else if has-loyalty-gain (get-general gs 0) == False & has-loyalty-gain (get-general gs 1) == False then gs
    else let prior = gs.loyalty-state
    in let a = army-loyalty gs 0
    in let b = army-loyalty gs 1
    in if a == prior.seen-a & b == prior.seen-b then gs
    else let first = gs.active-player
    in let second = if first == 0 then 1 else 0
    in let one = collect-loyalty-crossing ((get-general gs first).abilities) first (if first == 0 then prior.seen-a else prior.seen-b) (if first == 0 then a else b) 0 (prior.pending)
    in let both = collect-loyalty-crossing ((get-general gs second).abilities) second (if second == 0 then prior.seen-a else prior.seen-b) (if second == 0 then a else b) 0 one
    in game-with-loyalty gs (LoyaltyState { seen-a = a, seen-b = b, pending = both, cursor = prior.cursor })

  collect-loyalty-crossing : List Ability, Integer, Integer, Integer, Integer, List LoyaltyEvent -> List LoyaltyEvent
  collect-loyalty-crossing (abs) (player) (before) (after) (i) (pending) =
    if i >= list-length abs | after <= before then pending
    else let next = when list-at abs i
      is LoyaltyGainAbility (threshold) (eff) -> if threshold > 0 & before < threshold & after >= threshold then list-push pending (LoyaltyEvent { player = player, index = i, effect = eff }) else pending
      is otherwise -> pending
    in collect-loyalty-crossing abs player before after (i + 1) next

  DisruptionOption = record { source : Integer, ability : Integer, card : Integer, rays : Integer, hardness : Integer, chance : Integer }

  PendingActivation = record { loyalty : Boolean, source : Integer, index : Integer, effect : Effect, label : Text }

  pending-activation-none : PendingActivation
  pending-activation-none = PendingActivation { loyalty = False, source = 0 - 1, index = 0 - 1, effect = NoEffect, label = "" }

  SpellWindow = record { activation : PendingActivation, card : Integer, caster : Integer, targets : List Integer, hardness : Integer, manual : Boolean, nonce : Integer, deadline : Integer, choices : List DisruptionOption }

  spell-window-none : SpellWindow
  spell-window-none = SpellWindow { activation = pending-activation-none, card = 0 - 1, caster = 0, targets = [], hardness = 0, manual = False, nonce = 0, deadline = 0, choices = [] }

  ContestResult = record { activation : PendingActivation, reply-source : Integer, reply-ability : Integer, card : Integer, reply : Integer, chance : Integer, roll : Integer, disrupted : Boolean, fizzled : Boolean, reply-fizzled : Boolean, abandoned : Boolean }

  contest-result-none : ContestResult
  contest-result-none = ContestResult { activation = pending-activation-none, reply-source = 0 - 1, reply-ability = 0 - 1, card = 0 - 1, reply = 0 - 1, chance = 0, roll = 0, disrupted = False, fizzled = False, reply-fizzled = False, abandoned = False }

  DisruptionState = record { seed : Integer, index : Integer, window : SpellWindow, result : ContestResult }

  disruption-state-new : Integer -> DisruptionState
  disruption-state-new (seed) = DisruptionState { seed = seed, index = 0, window = spell-window-none, result = contest-result-none }

  disruption-pending : GameState -> Boolean
  disruption-pending (gs) = response-window-pending ((gs.disruption).window)

  response-window-pending : SpellWindow -> Boolean
  response-window-pending (window) = window.card >= 0 | (window.activation).source >= 0

  game-with-disruption : GameState, DisruptionState -> GameState
  game-with-disruption (gs) (state) = GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = gs.queued-cards, automatic-work = gs.automatic-work, players = gs.players, generals = gs.generals, battlefield = gs.battlefield, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates, card-templates = gs.card-templates, card-orders = gs.card-orders, disruption = state, queued-abilities = gs.queued-abilities }

  game-contest-seed : GameState, Integer -> GameState
  game-contest-seed (gs) (seed) = game-with-disruption gs (disruption-state-new seed)

  get-player : GameState, Integer -> PlayerState
  get-player (gs) (idx) = list-at (gs.players) idx

  set-player : GameState, Integer, PlayerState -> GameState
  set-player (gs) (idx) (p) = GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = card-queues-after-hand gs idx (p.hand), automatic-work = gs.automatic-work,
    players = list-set-at (gs.players) idx p,
    generals = gs.generals,
    battlefield = gs.battlefield,
    active-player = gs.active-player,
    priority-player = gs.priority-player,
    turn-number = gs.turn-number,
    phase = gs.phase,
    step = gs.step,
    next-permanent-id = gs.next-permanent-id,
    next-instance-id = gs.next-instance-id,
    game-over = gs.game-over,
    winner = gs.winner,
    templates = gs.templates, card-templates = gs.card-templates, card-orders = gs.card-orders, disruption = gs.disruption, queued-abilities = gs.queued-abilities
  }

  get-template : GameState, Integer -> CardTemplate
  get-template (gs) (id) = list-at (gs.templates) id

  card-template-id : GameState, Integer -> Integer
  card-template-id (gs) (card) = if card < 0 | card >= list-length (gs.card-templates) then 0 - 1 else list-at (gs.card-templates) card

  game-card-valid : GameState, Integer -> Boolean
  game-card-valid (gs) (card) =
    let template = card-template-id gs card
    in template >= 0 & template < list-length (gs.templates)

  get-card-template : GameState, Integer -> CardTemplate
  get-card-template (gs) (card) = get-template gs (card-template-id gs card)

  card-play-order : GameState, Integer -> Integer
  card-play-order (gs) (card) = if card < 0 | card >= list-length (gs.card-orders) then card-order-auto else list-at (gs.card-orders) card

  card-order-copy : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  card-order-copy (orders) (card) (order) (i) (len) (acc) =
    if i >= len then acc
    else let value = if i == card then order else if i < list-length orders then list-at orders i else card-order-auto
    in card-order-copy orders card order (i + 1) len (list-push acc value)

  set-card-play-order : GameState, Integer, Integer -> GameState
  set-card-play-order (gs) (card) (order) =
    if order < card-order-auto | order > card-order-next | game-card-valid gs card == False | card-play-order gs card == order then gs
    else let len = if card >= list-length (gs.card-orders) then card + 1 else list-length (gs.card-orders)
    in let orders = card-order-copy (gs.card-orders) card order 0 len []
    in GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = gs.queued-cards, automatic-work = gs.automatic-work, players = gs.players, generals = gs.generals, battlefield = gs.battlefield, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates, card-templates = gs.card-templates, card-orders = orders, disruption = gs.disruption, queued-abilities = gs.queued-abilities }

  consume-play-next : GameState, Integer -> GameState
  consume-play-next (gs) (card) = if card-play-order gs card == card-order-next then set-card-play-order gs card card-order-auto else gs

  CardBatch = record { registry : List Integer, cards : List Integer }

  valid-template-cards : List CardTemplate, List Integer, Integer -> Boolean
  valid-template-cards (templates) (cards) (i) =
    if i >= list-length cards then True
    else let id = list-at cards i
    in if id < 0 | id >= list-length templates then False else valid-template-cards templates cards (i + 1)

  register-card-copies : List Integer, Integer, List Integer, List Integer -> CardBatch
  register-card-copies (templates) (i) (registry) (cards) =
    if i >= list-length templates then CardBatch { registry = registry, cards = cards }
    else let id = list-length registry
    in register-card-copies templates (i + 1) (list-push registry (list-at templates i)) (list-push cards id)

  game-load-library : GameState, Integer, List Integer, Integer -> GameState
  game-load-library (gs) (player) (templates) (start) =
    if player < 0 | player >= list-length (gs.players) | start < 0 | start >= list-length templates then gs
    else if valid-template-cards (gs.templates) templates start == False then gs
    else let p = get-player gs player
    in let batch = register-card-copies templates start (for t in gs.card-templates -> t) (for card in p.library -> card)
    in let prepared = GameState { queued-loyalty = gs.queued-loyalty, loyalty-state = gs.loyalty-state, queued-cards = gs.queued-cards, automatic-work = gs.automatic-work, players = (for p in gs.players -> p), generals = gs.generals, battlefield = gs.battlefield, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = list-length (batch.registry), game-over = gs.game-over, winner = gs.winner, templates = gs.templates, card-templates = batch.registry, card-orders = gs.card-orders, disruption = gs.disruption, queued-abilities = gs.queued-abilities }
    in set-player prepared player (PlayerState { general = p.general, prismatic = p.prismatic, library = batch.cards, hand = p.hand, graveyard = p.graveyard, exile = p.exile, gem-drop-used = p.gem-drop-used })

  get-general : GameState, Integer -> GeneralTemplate
  get-general (gs) (player-idx) = list-at (gs.generals) player-idx

  active-player-state : GameState -> PlayerState
  active-player-state (gs) = get-player gs (gs.active-player)

  non-active-player : GameState -> Integer
  non-active-player (gs) = if gs.active-player == 0 then 1 else 0

Section: Army Loyalty

  army-loyalty : GameState, Integer -> Integer
  army-loyalty (gs) (player-idx) =
    army-loyalty-loop (gs.battlefield) (gs.templates) player-idx 0 (list-length (gs.battlefield)) 0

  army-loyalty-loop : List Permanent, List CardTemplate, Integer, Integer, Integer, Integer -> Integer
  army-loyalty-loop (perms) (templates) (player-idx) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in if perm.controller /= player-idx then army-loyalty-loop perms templates player-idx (i + 1) len acc
    else let template = list-at templates (perm.template-id)
    in when template.card-type
      is Creature ->
        if template.is-token then army-loyalty-loop perms templates player-idx (i + 1) len acc
        else army-loyalty-loop perms templates player-idx (i + 1) len (acc + total-rays (template.light-cost))
      is otherwise -> army-loyalty-loop perms templates player-idx (i + 1) len acc

Section: Utility

  ScaleBonuses =
   | NoScaleBonuses
   | CachedScaleBonuses (Integer) (Integer) (Integer) (Integer) (Integer) (Integer)

  scale-bonuses-none : ScaleBonuses
  scale-bonuses-none = NoScaleBonuses

  has-loyalty-scale : List Ability, Integer -> Boolean
  has-loyalty-scale (abs) (i) =
    if i >= list-length abs then False
    else let valid = when list-at abs i is LoyaltyScaleAbility (divisor) (pw) (to) (de) -> divisor > 0 is otherwise -> False
    in if valid then True else has-loyalty-scale abs (i + 1)

  loyalty-scale-value : List Ability, Integer, Integer, Integer, Integer -> Integer
  loyalty-scale-value (abs) (loyalty) (axis) (i) (total) =
    if i >= list-length abs then total
    else let amount = when list-at abs i
      is LoyaltyScaleAbility (divisor) (pw) (to) (de) -> if divisor <= 0 then 0 else (loyalty / divisor) * (if axis == 0 then pw else if axis == 1 then to else de)
      is otherwise -> 0
    in loyalty-scale-value abs loyalty axis (i + 1) (total + amount)

  scale-bonuses : GameState -> ScaleBonuses
  scale-bonuses (gs) =
    let a = (get-general gs 0).abilities
    in let b = (get-general gs 1).abilities
    in let ha = has-loyalty-scale a 0
    in let hb = has-loyalty-scale b 0
    in if ha == False & hb == False then NoScaleBonuses
    else let la = if ha then army-loyalty gs 0 else 0
    in let lb = if hb then army-loyalty gs 1 else 0
    in CachedScaleBonuses (loyalty-scale-value a la 0 0 0) (loyalty-scale-value a la 1 0 0) (loyalty-scale-value a la 2 0 0) (loyalty-scale-value b lb 0 0 0) (loyalty-scale-value b lb 1 0 0) (loyalty-scale-value b lb 2 0 0)

  scale-power : ScaleBonuses, CardTemplate, Permanent -> Integer
  scale-power (bonuses) (t) (p) = when bonuses is NoScaleBonuses -> 0 is CachedScaleBonuses (pa) (ta) (da) (pb) (tb) (db) -> (when t.card-type is Creature -> if p.controller == 0 then pa else if p.controller == 1 then pb else 0 is otherwise -> 0)

  scale-toughness : ScaleBonuses, CardTemplate, Permanent -> Integer
  scale-toughness (bonuses) (t) (p) = when bonuses is NoScaleBonuses -> 0 is CachedScaleBonuses (pa) (ta) (da) (pb) (tb) (db) -> (when t.card-type is Creature -> if p.controller == 0 then ta else if p.controller == 1 then tb else 0 is otherwise -> 0)

  scale-defense : ScaleBonuses, CardTemplate, Permanent -> Integer
  scale-defense (bonuses) (t) (p) = when bonuses is NoScaleBonuses -> 0 is CachedScaleBonuses (pa) (ta) (da) (pb) (tb) (db) -> (when t.card-type is Creature -> if p.controller == 0 then da else if p.controller == 1 then db else 0 is otherwise -> 0)

  effective-power : ScaleBonuses, CardTemplate, Permanent -> Integer
  effective-power (bonuses) (t) (p) = t.power + p.power-mod + scale-power bonuses t p

  effective-toughness : ScaleBonuses, CardTemplate, Permanent -> Integer
  effective-toughness (bonuses) (t) (p) = t.toughness + p.toughness-mod + scale-toughness bonuses t p

  effective-defense : ScaleBonuses, CardTemplate, Permanent -> Integer
  effective-defense (bonuses) (t) (p) = t.defense + p.defense-mod + scale-defense bonuses t p

  list-drop-front : List Integer -> List Integer
  list-drop-front (xs) = list-drop-front-loop xs 1 (list-length xs) []

  list-drop-front-loop : List Integer, Integer, Integer, List Integer -> List Integer
  list-drop-front-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else list-drop-front-loop xs (i + 1) len (list-push acc (list-at xs i))

  gs-list-remove : List Integer, Integer -> List Integer
  gs-list-remove (xs) (val) = gs-list-remove-loop xs val 0 (list-length xs) []

  gs-list-remove-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  gs-list-remove-loop (xs) (val) (i) (len) (acc) =
    if i >= len then acc
    else let item = list-at xs i
    in if item == val then gs-list-remove-loop xs (-1) (i + 1) len acc
    else gs-list-remove-loop xs val (i + 1) len (list-push acc item)

  int-list-has : List Integer, Integer -> Boolean
  int-list-has (xs) (val) = int-list-has-loop xs val 0 (list-length xs)

  int-list-has-loop : List Integer, Integer, Integer, Integer -> Boolean
  int-list-has-loop (xs) (val) (i) (len) =
    if i >= len then False
    else if list-at xs i == val then True
    else int-list-has-loop xs val (i + 1) len

  find-permanent : List Permanent, Integer, Integer, Integer -> Permanent
  find-permanent (perms) (target) (i) (len) =
    if i >= len then list-at perms 0
    else let perm = list-at perms i
    in if perm.id == target then perm
    else find-permanent perms target (i + 1) len

