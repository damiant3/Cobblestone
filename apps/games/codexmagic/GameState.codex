Section: Zone Identifiers

  Zone =
   | ZoneLibrary
   | ZoneHand
   | ZoneBattlefield
   | ZoneGraveyard
   | ZoneExile

  zone-name : Zone -> Text
  zone-name (z) =
    when z
      is ZoneLibrary -> "Library"
      is ZoneHand -> "Hand"
      is ZoneBattlefield -> "Battlefield"
      is ZoneGraveyard -> "Graveyard"
      is ZoneExile -> "Exile"

Section: General State

  GeneralState = record {
    template-id : Integer,
    life : Integer,
    damage-marked : Integer,
    counters : Integer,
    is-tapped : Boolean,
    power-mod : Integer,
    toughness-mod : Integer,
    defense-mod : Integer
  }

  general-state-new : Integer, Integer -> GeneralState
  general-state-new (template-id) (starting-life) = GeneralState {
    template-id = template-id,
    life = starting-life,
    damage-marked = 0,
    counters = 0,
    is-tapped = False,
    power-mod = 0,
    toughness-mod = 0,
    defense-mod = 0
  }

  general-deal-damage : GeneralState, Integer -> GeneralState
  general-deal-damage (gs) (amount) = GeneralState {
    template-id = gs.template-id,
    life = gs.life - amount,
    damage-marked = gs.damage-marked + amount,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod
  }

  general-gain-life : GeneralState, Integer -> GeneralState
  general-gain-life (gs) (amount) = GeneralState {
    template-id = gs.template-id,
    life = gs.life + amount,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod
  }

  general-clear-damage : GeneralState -> GeneralState
  general-clear-damage (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = 0,
    counters = gs.counters,
    is-tapped = gs.is-tapped,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod
  }

  general-tap : GeneralState -> GeneralState
  general-tap (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = True,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod
  }

  general-untap : GeneralState -> GeneralState
  general-untap (gs) = GeneralState {
    template-id = gs.template-id,
    life = gs.life,
    damage-marked = gs.damage-marked,
    counters = gs.counters,
    is-tapped = False,
    power-mod = gs.power-mod,
    toughness-mod = gs.toughness-mod,
    defense-mod = gs.defense-mod
  }

Section: Player State

  PlayerState = record {
    general : GeneralState,
    prismatic : PrismaticState,
    library : List Integer,
    hand : List Integer,
    graveyard : List Integer,
    exile : List Integer,
    gem-drop-used : Boolean
  }

  player-new : Integer, Integer -> PlayerState
  player-new (general-template-id) (general-life) = PlayerState {
    general = general-state-new general-template-id general-life,
    prismatic = prismatic-new,
    library = [],
    hand = [],
    graveyard = [],
    exile = [],
    gem-drop-used = False
  }

  player-draw : PlayerState -> PlayerState
  player-draw (p) =
    if list-length (p.library) == 0 then p
    else let card = list-at (p.library) 0
    in PlayerState {
      general = p.general,
      prismatic = p.prismatic,
      library = list-drop-front (p.library),
      hand = list-push (p.hand) card,
      graveyard = p.graveyard,
      exile = p.exile,
      gem-drop-used = p.gem-drop-used
    }

  player-add-to-hand : PlayerState, Integer -> PlayerState
  player-add-to-hand (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = list-push (p.hand) card-id,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-remove-from-hand : PlayerState, Integer -> PlayerState
  player-remove-from-hand (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = gs-list-remove (p.hand) card-id,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-add-to-graveyard : PlayerState, Integer -> PlayerState
  player-add-to-graveyard (p) (card-id) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = p.hand,
    graveyard = list-push (p.graveyard) card-id,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-reset-gem-drop : PlayerState -> PlayerState
  player-reset-gem-drop (p) = PlayerState {
    general = p.general,
    prismatic = p.prismatic,
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = False
  }

  player-gain-ray : PlayerState -> PlayerState
  player-gain-ray (p) = PlayerState {
    general = p.general,
    prismatic = prismatic-gain-ray (p.prismatic),
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-refresh-prismatic : PlayerState -> PlayerState
  player-refresh-prismatic (p) = PlayerState {
    general = p.general,
    prismatic = prismatic-refresh (p.prismatic),
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

  player-spend-rays : PlayerState, Integer -> PlayerState
  player-spend-rays (p) (n) = PlayerState {
    general = p.general,
    prismatic = prismatic-spend-rays (p.prismatic) n,
    library = p.library,
    hand = p.hand,
    graveyard = p.graveyard,
    exile = p.exile,
    gem-drop-used = p.gem-drop-used
  }

Section: Permanent

  Permanent = record {
    id : Integer,
    card-id : Integer,
    template-id : Integer,
    controller : Integer,
    owner : Integer,
    tapped : Boolean,
    summoning-sick : Boolean,
    damage-marked : Integer,
    counters : Integer,
    keywords : KeywordSet,
    attached-to : Integer,
    power-mod : Integer,
    toughness-mod : Integer,
    defense-mod : Integer,
    equipped-to : Integer,
    socketed-gem : Integer
  }

  permanent-new : Integer, Integer, Integer, Integer -> Permanent
  permanent-new (id) (card-id) (template-id) (controller) = Permanent {
    id = id, card-id = card-id, template-id = template-id,
    controller = controller, owner = controller,
    tapped = False, summoning-sick = True, damage-marked = 0,
    counters = 0, keywords = keywords-none, attached-to = -1,
    power-mod = 0, toughness-mod = 0, defense-mod = 0,
    equipped-to = -1, socketed-gem = -1
  }

  permanent-tap : Permanent -> Permanent
  permanent-tap (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = True, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem
  }

  permanent-untap : Permanent -> Permanent
  permanent-untap (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = False, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem
  }

  permanent-clear-sickness : Permanent -> Permanent
  permanent-clear-sickness (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = False,
    damage-marked = perm.damage-marked, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem
  }

  permanent-deal-damage : Permanent, Integer -> Permanent
  permanent-deal-damage (perm) (amount) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = perm.summoning-sick,
    damage-marked = perm.damage-marked + amount, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem
  }

  permanent-clear-damage : Permanent -> Permanent
  permanent-clear-damage (perm) = Permanent {
    id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
    controller = perm.controller, owner = perm.owner,
    tapped = perm.tapped, summoning-sick = perm.summoning-sick,
    damage-marked = 0, counters = perm.counters,
    keywords = perm.keywords, attached-to = perm.attached-to,
    power-mod = perm.power-mod, toughness-mod = perm.toughness-mod,
    defense-mod = perm.defense-mod,
    equipped-to = perm.equipped-to, socketed-gem = perm.socketed-gem
  }

Section: Game State

  GameState = record {
    players : List PlayerState,
    generals : List GeneralTemplate,
    battlefield : List Permanent,
    active-player : Integer,
    priority-player : Integer,
    turn-number : Integer,
    phase : Integer,
    step : Integer,
    next-permanent-id : Integer,
    next-instance-id : Integer,
    game-over : Boolean,
    winner : Integer,
    templates : List CardTemplate
  }

  game-new : List CardTemplate, GeneralTemplate, GeneralTemplate -> GameState
  game-new (templates) (gen-a) (gen-b) = GameState {
    players = [player-new (gen-a.id) (gen-a.life), player-new (gen-b.id) (gen-b.life)],
    generals = [gen-a, gen-b],
    battlefield = [],
    active-player = 0,
    priority-player = 0,
    turn-number = 1,
    phase = 0,
    step = 0,
    next-permanent-id = 0,
    next-instance-id = 0,
    game-over = False,
    winner = -1,
    templates = templates
  }

Section: Game State Accessors

  get-player : GameState, Integer -> PlayerState
  get-player (gs) (idx) = list-at (gs.players) idx

  set-player : GameState, Integer, PlayerState -> GameState
  set-player (gs) (idx) (p) = GameState {
    players = list-set-at (gs.players) idx p,
    generals = gs.generals,
    battlefield = gs.battlefield,
    active-player = gs.active-player,
    priority-player = gs.priority-player,
    turn-number = gs.turn-number,
    phase = gs.phase,
    step = gs.step,
    next-permanent-id = gs.next-permanent-id,
    next-instance-id = gs.next-instance-id,
    game-over = gs.game-over,
    winner = gs.winner,
    templates = gs.templates
  }

  get-template : GameState, Integer -> CardTemplate
  get-template (gs) (id) = list-at (gs.templates) id

  get-general : GameState, Integer -> GeneralTemplate
  get-general (gs) (player-idx) = list-at (gs.generals) player-idx

  active-player-state : GameState -> PlayerState
  active-player-state (gs) = get-player gs (gs.active-player)

  non-active-player : GameState -> Integer
  non-active-player (gs) = if gs.active-player == 0 then 1 else 0

Section: Army Loyalty

  army-loyalty : GameState, Integer -> Integer
  army-loyalty (gs) (player-idx) =
    army-loyalty-loop (gs.battlefield) (gs.templates) player-idx 0 (list-length (gs.battlefield)) 0

  army-loyalty-loop : List Permanent, List CardTemplate, Integer, Integer, Integer, Integer -> Integer
  army-loyalty-loop (perms) (templates) (player-idx) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in if perm.controller /= player-idx then army-loyalty-loop perms templates player-idx (i + 1) len acc
    else let template = list-at templates (perm.template-id)
    in when template.card-type
      is Creature ->
        if template.is-token then army-loyalty-loop perms templates player-idx (i + 1) len acc
        else army-loyalty-loop perms templates player-idx (i + 1) len (acc + total-rays (template.light-cost))
      is otherwise -> army-loyalty-loop perms templates player-idx (i + 1) len acc

Section: Utility

  list-drop-front : List Integer -> List Integer
  list-drop-front (xs) = list-drop-front-loop xs 1 (list-length xs) []

  list-drop-front-loop : List Integer, Integer, Integer, List Integer -> List Integer
  list-drop-front-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else list-drop-front-loop xs (i + 1) len (list-push acc (list-at xs i))

  gs-list-remove : List Integer, Integer -> List Integer
  gs-list-remove (xs) (val) = gs-list-remove-loop xs val 0 (list-length xs) []

  gs-list-remove-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  gs-list-remove-loop (xs) (val) (i) (len) (acc) =
    if i >= len then acc
    else let item = list-at xs i
    in if item == val then gs-list-remove-loop xs (-1) (i + 1) len acc
    else gs-list-remove-loop xs val (i + 1) len (list-push acc item)

  int-list-has : List Integer, Integer -> Boolean
  int-list-has (xs) (val) = int-list-has-loop xs val 0 (list-length xs)

  int-list-has-loop : List Integer, Integer, Integer, Integer -> Boolean
  int-list-has-loop (xs) (val) (i) (len) =
    if i >= len then False
    else if list-at xs i == val then True
    else int-list-has-loop xs val (i + 1) len

  find-permanent : List Permanent, Integer, Integer, Integer -> Permanent
  find-permanent (perms) (target) (i) (len) =
    if i >= len then list-at perms 0
    else let perm = list-at perms i
    in if perm.id == target then perm
    else find-permanent perms target (i + 1) len

