Section: Instance Updaters

  set-instance-clan : ClanInstance, Clan -> ClanInstance
  set-instance-clan (inst) (new-clan) =
    ClanInstance { clan = new-clan, economy = inst.economy, library = inst.library, formats = inst.formats, tournaments = inst.tournaments, challenges = inst.challenges, packs = inst.packs, members = inst.members, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  set-instance-economy : ClanInstance, ClanEconomy -> ClanInstance
  set-instance-economy (inst) (new-econ) =
    ClanInstance { clan = inst.clan, economy = new-econ, library = inst.library, formats = inst.formats, tournaments = inst.tournaments, challenges = inst.challenges, packs = inst.packs, members = inst.members, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  set-instance-library : ClanInstance, ClanLibrary -> ClanInstance
  set-instance-library (inst) (new-lib) =
    ClanInstance { clan = inst.clan, economy = inst.economy, library = new-lib, formats = inst.formats, tournaments = inst.tournaments, challenges = inst.challenges, packs = inst.packs, members = inst.members, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  set-instance-ledger : ClanInstance, ManaCoinLedger -> ClanInstance
  set-instance-ledger (inst) (new-ledger) =
    ClanInstance { clan = inst.clan, economy = inst.economy, library = inst.library, formats = inst.formats, tournaments = inst.tournaments, challenges = inst.challenges, packs = inst.packs, members = inst.members, global-ledger = new-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  add-instance-member : ClanInstance, ClanMember -> ClanInstance
  add-instance-member (inst) (member) =
    ClanInstance { clan = inst.clan, economy = inst.economy, library = inst.library, formats = inst.formats, tournaments = inst.tournaments, challenges = inst.challenges, packs = inst.packs, members = list-push (inst.members) member, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  update-instance-tournament : ClanInstance, ClanTournament -> ClanInstance
  update-instance-tournament (inst) (tourn) =
    let new-tourns = replace-tournament (inst.tournaments) tourn 0 (list-length (inst.tournaments)) []
    in ClanInstance { clan = inst.clan, economy = inst.economy, library = inst.library, formats = inst.formats, tournaments = new-tourns, challenges = inst.challenges, packs = inst.packs, members = inst.members, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  replace-tournament : List ClanTournament, ClanTournament, Integer, Integer, List ClanTournament -> List ClanTournament
  replace-tournament (tourns) (new-tourn) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at tourns i
    in if t.tournament-id == new-tourn.tournament-id then replace-tournament tourns new-tourn (i + 1) len (list-push acc new-tourn)
    else replace-tournament tourns new-tourn (i + 1) len (list-push acc t)

  update-instance-challenge : ClanInstance, ClanChallenge -> ClanInstance
  update-instance-challenge (inst) (chal) =
    let new-chals = replace-challenge (inst.challenges) chal 0 (list-length (inst.challenges)) []
    in ClanInstance { clan = inst.clan, economy = inst.economy, library = inst.library, formats = inst.formats, tournaments = inst.tournaments, challenges = new-chals, packs = inst.packs, members = inst.members, global-ledger = inst.global-ledger, next-format-id = inst.next-format-id, next-tournament-id = inst.next-tournament-id, next-challenge-id = inst.next-challenge-id, next-pack-id = inst.next-pack-id, platform-authorized = inst.platform-authorized, last-sync = inst.last-sync }

  replace-challenge : List ClanChallenge, ClanChallenge, Integer, Integer, List ClanChallenge -> List ClanChallenge
  replace-challenge (chals) (new-chal) (i) (len) (acc) =
    if i >= len then acc
    else let c = list-at chals i
    in if c.challenge-id == new-chal.challenge-id then replace-challenge chals new-chal (i + 1) len (list-push acc new-chal)
    else replace-challenge chals new-chal (i + 1) len (list-push acc c)

Section: Lookup Helpers

  find-tournament : List ClanTournament, Integer, Integer, Integer -> ClanTournament
  find-tournament (tourns) (id) (i) (len) =
    if i >= len then ClanTournament { tournament-id = -1, clan-id = 0, name = "", format-id = 0, structure = SingleElim, entry-fee = 0, prize-pool = 0, participants = [], max-players = 0, status = TournCancelled, results = [], current-round = 0, pairings = [], created-by = 0, created-at = 0 }
    else let t = list-at tourns i
    in if t.tournament-id == id then t
    else find-tournament tourns id (i + 1) len

  find-challenge : List ClanChallenge, Integer, Integer, Integer -> ClanChallenge
  find-challenge (chals) (id) (i) (len) =
    if i >= len then ClanChallenge { challenge-id = -1, challenger-clan = 0, defending-clan = 0, format-id = 0, players-per-side = 0, stake = StakeHonor, status = ChalDeclined, challenger-roster = [], defender-roster = [], matches = [], winner-clan = -1, proposed-at = 0, started-at = 0, completed-at = 0 }
    else let c = list-at chals i
    in if c.challenge-id == id then c
    else find-challenge chals id (i + 1) len

Section: Server Loop

  opening : [Console] Nothing = act
    print-line-uni "CLAN-SERVER READY"
    let inst = clan-instance-new 1 "DefaultClan" "DFLT" 0 "Clan Coins" 200 (PublicKey { key-high = 0, key-low = 0 })
    in clan-server-loop inst
  end

  clan-server-loop : ClanInstance -> [Console] Nothing
  clan-server-loop (inst) = act
    line-result <- read-line
    when line-result
      is Just (line) -> act
        new-inst <- dispatch-clan-request inst line
        clan-server-loop new-inst
      end
      is None -> print-line-uni "CLAN-SERVER-EXIT"
    end

