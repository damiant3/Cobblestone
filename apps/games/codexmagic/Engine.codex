 Top-level game loop. Drives the turn state machine, dispatches
 phase actions through the AI Supervisor, calls SBA checks, and
 resolves the stack. Each turn: untap, upkeep, draw, main, combat,
 main, end, cleanup. Both players are AI-driven via their Generals.

 We say:

Section: Game Loop

  run-game : GameState, Integer -> GameState
  run-game (gs) (max-turns) =
    if gs.game-over then gs
    else if gs.turn-number > max-turns then gs
    else let gs2 = run-turn gs
    in let gs3 = check-state-based-actions gs2
    in if gs3.game-over then gs3
    else let gs4 = advance-turn gs3
    in run-game gs4 max-turns

  run-turn : GameState -> GameState
  run-turn (gs) =
    let player = gs.active-player
    in let gen-template = get-general gs player
    in let p = get-player gs player
    in let stance = effective-stance posture-default gen-template (p.general)
    in let gs1 = do-untap gs
    in let gs2 = do-draw gs1
    in let gs3 = ai-play-land gs2 player
    in let gs4 = ai-tap-lands gs3 player
    in let gs5 = ai-cast-spells gs4 player stance
    in let gs6 = ai-combat-phase gs5 player stance gen-template
    in let gs7 = ai-tap-lands gs6 player
    in let gs8 = ai-cast-spells gs7 player stance
    in do-cleanup gs8

Section: Untap

  do-untap : GameState -> GameState
  do-untap (gs) =
    let p = get-player gs (gs.active-player)
    in let p2 = player-reset-land-drop p
    in let p3 = PlayerState { general = general-untap (p2.general), mana-pool = p2.mana-pool, library = p2.library, hand = p2.hand, graveyard = p2.graveyard, exile = p2.exile, land-drop-used = p2.land-drop-used, land-drops-per-turn = p2.land-drops-per-turn }
    in let gs2 = set-player gs (gs.active-player) p3
    in untap-all-permanents gs2 (gs.active-player)

  untap-all-permanents : GameState, Integer -> GameState
  untap-all-permanents (gs) (player-idx) = GameState { players = gs.players, generals = gs.generals, battlefield = untap-player-perms (gs.battlefield) player-idx 0 (list-length (gs.battlefield)) [], stack = gs.stack, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates }

  untap-player-perms : List Permanent, Integer, Integer, Integer, List Permanent -> List Permanent
  untap-player-perms (perms) (player-idx) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in let updated = if perm.controller == player-idx then permanent-clear-sickness (permanent-untap perm) else perm
    in untap-player-perms perms player-idx (i + 1) len (list-push acc updated)

Section: Draw

  do-draw : GameState -> GameState
  do-draw (gs) =
    if gs.turn-number == 1 then gs
    else let p = get-player gs (gs.active-player)
    in let p2 = player-draw p
    in set-player gs (gs.active-player) p2

Section: Cleanup

  do-cleanup : GameState -> GameState
  do-cleanup (gs) =
    let gs2 = clear-all-damage gs
    in let p0 = get-player gs2 0
    in let p1 = get-player gs2 1
    in let p0b = player-empty-pool p0
    in let p1b = player-empty-pool p1
    in let gs3 = set-player gs2 0 p0b
    in set-player gs3 1 p1b

  clear-all-damage : GameState -> GameState
  clear-all-damage (gs) = GameState { players = clear-general-damage (gs.players) 0 (list-length (gs.players)) [], generals = gs.generals, battlefield = clear-perm-damage (gs.battlefield) 0 (list-length (gs.battlefield)) [], stack = gs.stack, active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates }

  clear-perm-damage : List Permanent, Integer, Integer, List Permanent -> List Permanent
  clear-perm-damage (perms) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in clear-perm-damage perms (i + 1) len (list-push acc (permanent-clear-damage perm))

  clear-general-damage : List PlayerState, Integer, Integer, List PlayerState -> List PlayerState
  clear-general-damage (players) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at players i
    in let p2 = PlayerState { general = general-clear-damage (p.general), mana-pool = p.mana-pool, library = p.library, hand = p.hand, graveyard = p.graveyard, exile = p.exile, land-drop-used = p.land-drop-used, land-drops-per-turn = p.land-drops-per-turn }
    in clear-general-damage players (i + 1) len (list-push acc p2)

