Section: Game Loop

  run-game : GameState, Integer -> GameState
  run-game (gs) (max-turns) =
    if gs.game-over then gs
    else if gs.turn-number > max-turns then gs
    else let gs2 = run-turn gs
    in let gs3 = check-state-based-actions gs2
    in if gs3.game-over then gs3
    else let gs4 = advance-turn gs3
    in run-game gs4 max-turns

  run-turn : GameState -> GameState
  run-turn (gs) =
    let player = gs.active-player
    in let gen-template = get-general gs player
    in let p = get-player gs player
    in let stance = effective-stance posture-default gen-template (p.general)
    in let gs1 = do-upkeep gs
    in let gs2 = do-draw gs1
    in let gs3 = ai-play-gem gs2 player
    in let gs4 = ai-cast-spells gs3 player stance
    in let gs5 = ai-combat-phase gs4 player stance gen-template
    in let gs6 = ai-cast-spells gs5 player stance
    in do-cleanup gs6

Section: Upkeep

  do-upkeep : GameState -> GameState
  do-upkeep (gs) =
    let p = get-player gs (gs.active-player)
    in let p2 = player-reset-gem-drop p
    in let p3 = player-gain-ray p2
    in let p4 = player-refresh-prismatic p3
    in let p5 = PlayerState { general = general-untap (p4.general), prismatic = p4.prismatic, library = p4.library, hand = p4.hand, graveyard = p4.graveyard, exile = p4.exile, gem-drop-used = p4.gem-drop-used }
    in let gs2 = set-player gs (gs.active-player) p5
    in untap-all-permanents gs2 (gs.active-player)

  untap-all-permanents : GameState, Integer -> GameState
  untap-all-permanents (gs) (player-idx) = GameState { players = gs.players, generals = gs.generals, battlefield = untap-player-perms (gs.battlefield) player-idx 0 (list-length (gs.battlefield)) [], active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates }

  untap-player-perms : List Permanent, Integer, Integer, Integer, List Permanent -> List Permanent
  untap-player-perms (perms) (player-idx) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in let updated = if perm.controller == player-idx then permanent-clear-sickness (permanent-untap perm) else perm
    in untap-player-perms perms player-idx (i + 1) len (list-push acc updated)

Section: Draw

  do-draw : GameState -> GameState
  do-draw (gs) =
    if gs.turn-number == 1 then gs
    else let p = get-player gs (gs.active-player)
    in let p2 = player-draw p
    in set-player gs (gs.active-player) p2

Section: Cleanup

  do-cleanup : GameState -> GameState
  do-cleanup (gs) =
    clear-all-damage gs

  clear-all-damage : GameState -> GameState
  clear-all-damage (gs) = GameState { players = clear-general-damage (gs.players) 0 (list-length (gs.players)) [], generals = gs.generals, battlefield = clear-perm-damage (gs.battlefield) 0 (list-length (gs.battlefield)) [], active-player = gs.active-player, priority-player = gs.priority-player, turn-number = gs.turn-number, phase = gs.phase, step = gs.step, next-permanent-id = gs.next-permanent-id, next-instance-id = gs.next-instance-id, game-over = gs.game-over, winner = gs.winner, templates = gs.templates }

  clear-perm-damage : List Permanent, Integer, Integer, List Permanent -> List Permanent
  clear-perm-damage (perms) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in clear-perm-damage perms (i + 1) len (list-push acc (permanent-clear-damage perm))

  clear-general-damage : List PlayerState, Integer, Integer, List PlayerState -> List PlayerState
  clear-general-damage (players) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at players i
    in let p2 = PlayerState { general = general-clear-damage (p.general), prismatic = p.prismatic, library = p.library, hand = p.hand, graveyard = p.graveyard, exile = p.exile, gem-drop-used = p.gem-drop-used }
    in clear-general-damage players (i + 1) len (list-push acc p2)

