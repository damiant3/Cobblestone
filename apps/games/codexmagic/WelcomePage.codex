Chapter: WelcomePage
  cites CodexMagic chapter MagicTheme
  cites UI chapter Layout

 Welcome page using semantic widget abstractions:
 HeroSection, FeatureGrid, LoreSection, ColorStrip,
 StepSequence, Footer.

 We say:

Section: Tree

  welcome-tree : Integer -> WidgetNode
  welcome-tree (x) =
    widget-panel "w-root" DirColumn 0 [
      magic-nav-widget "Welcome",
      widget-hero "CODEXMAGIC" "Deep in the Ashen Range, miners crack open the earth and light pours out. Collect gemstones, forge decks, and duel with prismatic fire." [
        widget-button "w-play" "ENTER THE MINES",
        widget-button "w-story" "THE STORY"
      ],
      features-section 0,
      lore-section 0,
      spectrum-section 0,
      howto-section 0,
      widget-footer "CODEXMAGIC" "Built on Codex. No borrowed runtime." [
        widget-button "fl-play" "Play",
        widget-button "fl-store" "Store",
        widget-button "fl-coll" "Collection",
        widget-button "fl-test" "Tester",
        widget-button "fl-market" "Market",
        widget-button "fl-clan" "Clans"
      ]
    ]

  features-section : Integer -> WidgetNode
  features-section (x) =
    widget-box "w-features" "s-features" [
      widget-h2 "feat-title" "The World Awaits",
      widget-feature-grid "feat-grid" [
        widget-feature-card "f1" "&#x2694;" "Battle" "Command generals, cast incantations, and summon creatures.",
        widget-feature-card "f2" "&#x1F48E;" "Gemstones" "70 cards across 6 colors. Each gem channels a different light.",
        widget-feature-card "f3" "&#x1F6E1;" "Equipment" "9 gear slots per creature. Socket gems into rings and amulets.",
        widget-feature-card "f4" "&#x1F3F0;" "Clans" "Form guilds. Trade cards with clan coins. Rise to Overlord.",
        widget-feature-card "f5" "&#x1F4B0;" "Economy" "Mana Coin marketplace with auctions, buyouts, and live economy.",
        widget-feature-card "f6" "&#x1F3AF;" "Deck Testing" "Test draws, play gems, cast spells with rays. Full simulator."
      ]
    ]

  lore-section : Integer -> WidgetNode
  lore-section (x) =
    widget-lore-section "w-lore" "The Ashenvale Chronicle" [
      widget-label "lore-p1" "In the age before memory, the Prismatic Wellsprings erupted from the bones of the world - ruby veins of crimson fire, topaz seams of golden light, sapphire fissures of deep blue, carnelian strata of blazing orange, and emerald deposits of living green.",
      widget-label "lore-p2" "Where the veins converged, the mining town of Ashenvale grew - a thousand souls chipping at the mountain face. Here, at the Codex Hall, mages learned to channel light through gemstones.",
      widget-label "lore-cta" "The mines await. Will you answer the call?"
    ]

  spectrum-section : Integer -> WidgetNode
  spectrum-section (x) =
    widget-box "w-spectrum" "s-colors" [
      widget-h2 "spec-title" "The Prismatic Spectrum",
      widget-label "spec-desc" "Light passes through gemstones to produce color.",
      widget-color-strip "spec-strip" [
        widget-color-swatch "sw-r" "#d32f2f" "RED",
        widget-color-swatch "sw-o" "#e65100" "ORANGE",
        widget-color-swatch "sw-y" "#e6a817" "YELLOW",
        widget-color-swatch "sw-g" "#2e7d32" "GREEN",
        widget-color-swatch "sw-b" "#0e68ab" "BLUE"
      ],
      widget-special-pair "spec-special" (widget-special-swatch "sw-white" "swatch-white" "WHITE LIGHT (Diamond)") (widget-special-swatch "sw-black" "swatch-black" "BLACK LIGHT (Obsidian)"),
      widget-purple-badge "spec-purple" "PURPLE" "Non-spectral. Must mix Ruby + Sapphire."
    ]

  howto-section : Integer -> WidgetNode
  howto-section (x) =
    widget-box "w-howto" "section" [
      widget-h2 "howto-title" "Begin Your Journey",
      widget-step-sequence "howto-steps" [
        widget-step-card "s1" "1" "Create Account" "Register. Get 500 MC and a starter pack.",
        widget-step-card "s2" "2" "Open Packs" "Buy packs in the Store.",
        widget-step-card "s3" "3" "Build a Deck" "60 cards. Balance gems and spells.",
        widget-step-card "s4" "4" "Descend" "Queue for a match. Rise to Diamond."
      ],
      widget-button "w-play2" "PLAY NOW"
    ]

Section: Handlers

  w-click : Text -> Integer
  w-click (id) = 0

Section: Entry

  render-w : Integer -> Integer
  render-w (x) = mount-widget-themed magic-theme (welcome-tree 0)

  opening : [Console] Integer
  opening = act
    let t = init-magic-theme 0
    in let s = set-render render-w
    in let h = register-handlers no-pick w-click
    in render-w 0
  end

