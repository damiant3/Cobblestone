Chapter: QueuePage
  cites CodexMagic chapter MagicTheme
  cites UI chapter Layout

 We say:

Section: State

  sk-q-state : Text = "q-state"
  sk-q-timer : Text = "q-timer"
  sk-q-format : Text = "q-format"
  sk-q-info : Text = "q-info"

Section: Tree

  queue-tree : Integer -> WidgetNode
  queue-tree (x) =
    let qs = state-get sk-q-state
    in let timer = state-get sk-q-timer
    in let info = state-get-text sk-q-info
    in let content = if qs == 0 then queue-form 0 else if qs == 1 then queue-searching timer else queue-found info
    in magic-nav-page "q-page" "Queue" "q-content" [content]

  queue-form : Integer -> WidgetNode
  queue-form (x) =
    widget-panel "q-form" DirColumn 12 [
      widget-label "q-title" "Find a Match",
      widget-separator "q-s1",
      widget-label "q-fl" "Format",
      widget-button "q-std" "Standard",
      widget-button "q-draft" "Draft",
      widget-separator "q-s2",
      widget-label "q-tl" "Tier",
      widget-button "q-fair" "Fair",
      widget-button "q-open" "Open",
      widget-separator "q-s3",
      widget-button "q-find" "Find Match"
    ]

  queue-searching : Integer -> WidgetNode
  queue-searching (t) =
    widget-panel "q-search" DirColumn 16 [
      widget-label "q-spin" "Searching...",
      widget-label "q-time" (show t & "s"),
      widget-button "q-cancel" "Cancel"
    ]

  queue-found : Text -> WidgetNode
  queue-found (info) =
    widget-panel "q-found" DirColumn 12 [
      widget-label "q-ft" "Match Found!",
      widget-label "q-fi" info,
      widget-button "q-accept" "Accept",
      widget-button "q-decline" "Decline"
    ]

Section: Handlers

  q-click : Text -> Integer
  q-click (id) =
    if id == "q-find" then let s1 = state-set sk-q-state 1 in let s2 = state-set sk-q-timer 0 in let s3 = set-timeout q-tick 1000 in request-render 0
    else if id == "q-cancel" then let s = state-set sk-q-state 0 in request-render 0
    else if id == "q-accept" then 0
    else if id == "q-decline" then let s = state-set sk-q-state 0 in request-render 0
    else 0

  q-tick : Integer -> Integer
  q-tick (x) =
    let t = state-get sk-q-timer
    in let s = state-set sk-q-timer (t + 1)
    in if t >= 4 then let s2 = state-set sk-q-state 2 in let s3 = state-set-text sk-q-info "Standard | Ranked" in request-render 0
    else let s2 = set-timeout q-tick 1000 in request-render 0

Section: Entry

  render-q : Integer -> Integer
  render-q (x) = mount-widget-themed magic-theme (queue-tree 0)

  opening : [Console] Integer
  opening = act
    let t = init-magic-theme 0
    in let s = state-set sk-q-state 0
    in let s2 = set-render render-q
    in let h = register-handlers no-pick q-click
    in render-q 0
  end

