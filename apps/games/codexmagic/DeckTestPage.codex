Chapter: DeckTestPage
  cites CodexMagic chapter MagicTheme
  cites UI chapter Layout

 Deck tester. Pure widget tree.

 We say:

Section: State

  sk-dt-turn : Text = "dt-turn"
  sk-dt-rays : Text = "dt-rays"
  sk-dt-lib : Text = "dt-lib"
  sk-dt-hand : Text = "dt-hand"
  sk-dt-gems : Text = "dt-gems"
  sk-dt-creatures : Text = "dt-creatures"
  sk-dt-gy : Text = "dt-gy"
  sk-dt-loaded : Text = "dt-loaded"

Section: Tree

  decktest-tree : Integer -> WidgetNode
  decktest-tree (x) =
    let turn = state-get sk-dt-turn
    in let rays = state-get sk-dt-rays
    in let lib = state-get sk-dt-lib
    in let hand-n = state-get sk-dt-hand
    in let gems = state-get sk-dt-gems
    in let creatures = state-get sk-dt-creatures
    in let gy = state-get sk-dt-gy
    in widget-panel "dt-page" DirColumn 0 [
      magic-nav-widget "Test",
      widget-box "dt-root" "page" [
      widget-panel "dt-controls" DirRow 8 [
        widget-button "dt-new" "New Hand",
        widget-button "dt-draw" "Draw",
        widget-button "dt-turn" "Next Turn",
        widget-label "dt-stats" ("Turn:" & show turn & " | Lib:" & show lib & " | Hand:" & show hand-n & " | Rays:" & show rays)
      ],
      widget-separator "dt-s1",
      widget-label "dt-gems-lbl" ("Gemstones (" & show gems & ")"),
      widget-separator "dt-s2",
      widget-label "dt-cr-lbl" ("Creatures (" & show creatures & ")"),
      widget-separator "dt-s3",
      widget-label "dt-gy-lbl" ("Graveyard: " & show gy),
      widget-separator "dt-s4",
      widget-label "dt-hand-lbl" ("Hand (" & show hand-n & ")")
    ]]

Section: Handlers

  dt-click : Text -> Integer
  dt-click (id) =
    if id == "dt-new" then dt-reset 0
    else if id == "dt-draw" then dt-draw 0
    else if id == "dt-turn" then dt-next-turn 0
    else 0

  dt-reset : Integer -> Integer
  dt-reset (x) =
    let s1 = state-set sk-dt-turn 1
    in let s2 = state-set sk-dt-rays 1
    in let s3 = state-set sk-dt-lib 53
    in let s4 = state-set sk-dt-hand 7
    in let s5 = state-set sk-dt-gems 0
    in let s6 = state-set sk-dt-creatures 0
    in let s7 = state-set sk-dt-gy 0
    in request-render 0

  dt-draw : Integer -> Integer
  dt-draw (x) =
    let lib = state-get sk-dt-lib
    in if lib <= 0 then 0
    else let s1 = state-set sk-dt-lib (lib - 1)
    in let h = state-get sk-dt-hand
    in let s2 = state-set sk-dt-hand (h + 1)
    in request-render 0

  dt-next-turn : Integer -> Integer
  dt-next-turn (x) =
    let t = state-get sk-dt-turn
    in let r = state-get sk-dt-rays
    in let s1 = state-set sk-dt-turn (t + 1)
    in let s2 = state-set sk-dt-rays (r + 1)
    in dt-draw 0

Section: Entry

  render-dt : Integer -> Integer
  render-dt (x) = mount-widget-themed magic-theme (decktest-tree 0)

  opening : [Console] Integer
  opening = act
    let t = init-magic-theme 0
    in let s = set-render render-dt
    in let h = register-handlers no-pick dt-click
    in dt-reset 0
  end

