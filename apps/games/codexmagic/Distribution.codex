Chapter: Distribution
  cites CodexMagic chapter Card

 Pack distribution rules, subscription tier bonuses, and cracking
 logic. Single source of truth for how packs are composed and how
 subscription tiers modify rarity outcomes.

 We say:

Section: Pack Composition

  PackSpec = record {
    commons : Integer,
    uncommons : Integer,
    rare-or-mythic : Integer,
    wildcards : Integer,
    mythic-chance-denominator : Integer
  }

  pack-standard : PackSpec
  pack-standard = PackSpec { commons = 10, uncommons = 3, rare-or-mythic = 1, wildcards = 1, mythic-chance-denominator = 8 }

  packs-per-type : Text -> Integer
  packs-per-type (pack-type) =
    if pack-type == "draft" then 3
    else 1

Section: Wildcard Pool Weights

  WildcardWeights = record {
    uncommon-pct : Integer,
    rare-pct : Integer,
    common-pct : Integer,
    mythic-pct : Integer
  }

  wildcard-standard : WildcardWeights
  wildcard-standard = WildcardWeights { uncommon-pct = 60, rare-pct = 25, common-pct = 10, mythic-pct = 5 }

  wildcard-premium : WildcardWeights
  wildcard-premium = WildcardWeights { uncommon-pct = 0, rare-pct = 70, common-pct = 0, mythic-pct = 30 }

Section: Subscription Tiers

  SubscriptionTier =
   | TierFree
   | TierBronze
   | TierSilver
   | TierGold
   | TierPlatinum

  tier-name : SubscriptionTier -> Text
  tier-name (t) =
    when t
      is TierFree -> "Free"
      is TierBronze -> "Bronze"
      is TierSilver -> "Silver"
      is TierGold -> "Gold"
      is TierPlatinum -> "Platinum"

  tier-bonus-upgrades : SubscriptionTier -> Integer
  tier-bonus-upgrades (t) =
    when t
      is TierFree -> 0
      is TierBronze -> 1
      is TierSilver -> 2
      is TierGold -> 3
      is TierPlatinum -> 5

Section: Pack Costs

  pack-cost : Text -> Integer
  pack-cost (pack-type) =
    if pack-type == "premium" then 300
    else if pack-type == "draft" then 250
    else 100

Section: Deck Rules

  DeckRules = record {
    min-size : Integer,
    max-copies : Integer,
    min-gems-recommended : Integer,
    gem-ratio-target : Integer,
    spell-ratio-target : Integer
  }

  deck-rules-standard : DeckRules
  deck-rules-standard = DeckRules { min-size = 60, max-copies = 4, min-gems-recommended = 15, gem-ratio-target = 24, spell-ratio-target = 36 }

  deck-rules-draft : DeckRules
  deck-rules-draft = DeckRules { min-size = 40, max-copies = 100, min-gems-recommended = 12, gem-ratio-target = 17, spell-ratio-target = 23 }

Section: Starter Grant

  starter-balance : Integer
  starter-balance = 500

  starter-pack-type : Text
  starter-pack-type = "standard"

