Chapter: Mana
  cites Foreword chapter Maybe

 Mana colors, pools, costs, and payment logic. Five colors plus
 colorless. Pools empty at phase boundaries. Payment subtracts
 colored requirements first, then generic from surplus.

 We say:

Section: Colors

  ManaColor =
   | White
   | Blue
   | Black
   | Red
   | Green
   | Colorless

  color-name : ManaColor -> Text
  color-name (c) =
    when c
      is White -> "White"
      is Blue -> "Blue"
      is Black -> "Black"
      is Red -> "Red"
      is Green -> "Green"
      is Colorless -> "Colorless"

  color-symbol : ManaColor -> Text
  color-symbol (c) =
    when c
      is White -> "W"
      is Blue -> "U"
      is Black -> "B"
      is Red -> "R"
      is Green -> "G"
      is Colorless -> "C"

Section: Color Set

  ColorSet = record {
    white : Boolean,
    blue : Boolean,
    black : Boolean,
    red : Boolean,
    green : Boolean
  }

  color-set-empty : ColorSet
  color-set-empty = ColorSet { white = False, blue = False, black = False, red = False, green = False }

  color-set-mono : ManaColor -> ColorSet
  color-set-mono (c) =
    when c
      is White -> ColorSet { white = True, blue = False, black = False, red = False, green = False }
      is Blue -> ColorSet { white = False, blue = True, black = False, red = False, green = False }
      is Black -> ColorSet { white = False, blue = False, black = True, red = False, green = False }
      is Red -> ColorSet { white = False, blue = False, black = False, red = True, green = False }
      is Green -> ColorSet { white = False, blue = False, black = False, red = False, green = True }
      is Colorless -> color-set-empty

  color-set-has : ColorSet, ManaColor -> Boolean
  color-set-has (cs) (c) =
    when c
      is White -> cs.white
      is Blue -> cs.blue
      is Black -> cs.black
      is Red -> cs.red
      is Green -> cs.green
      is Colorless -> False

  color-count : ColorSet -> Integer
  color-count (cs) =
    let w = if cs.white then 1 else 0
    in let u = if cs.blue then 1 else 0
    in let b = if cs.black then 1 else 0
    in let r = if cs.red then 1 else 0
    in let g = if cs.green then 1 else 0
    in w + u + b + r + g

Section: Mana Cost

  ManaCost = record {
    white : Integer,
    blue : Integer,
    black : Integer,
    red : Integer,
    green : Integer,
    generic : Integer
  }

  mana-cost-zero : ManaCost
  mana-cost-zero = ManaCost { white = 0, blue = 0, black = 0, red = 0, green = 0, generic = 0 }

  mana-cost-w : Integer -> ManaCost
  mana-cost-w (n) = ManaCost { white = n, blue = 0, black = 0, red = 0, green = 0, generic = 0 }

  mana-cost-u : Integer -> ManaCost
  mana-cost-u (n) = ManaCost { white = 0, blue = n, black = 0, red = 0, green = 0, generic = 0 }

  mana-cost-b : Integer -> ManaCost
  mana-cost-b (n) = ManaCost { white = 0, blue = 0, black = n, red = 0, green = 0, generic = 0 }

  mana-cost-r : Integer -> ManaCost
  mana-cost-r (n) = ManaCost { white = 0, blue = 0, black = 0, red = n, green = 0, generic = 0 }

  mana-cost-g : Integer -> ManaCost
  mana-cost-g (n) = ManaCost { white = 0, blue = 0, black = 0, red = 0, green = n, generic = 0 }

  mana-cost-generic : Integer -> ManaCost
  mana-cost-generic (n) = ManaCost { white = 0, blue = 0, black = 0, red = 0, green = 0, generic = n }

  mana-cost-add : ManaCost, ManaCost -> ManaCost
  mana-cost-add (a) (b) = ManaCost {
    white = a.white + b.white,
    blue = a.blue + b.blue,
    black = a.black + b.black,
    red = a.red + b.red,
    green = a.green + b.green,
    generic = a.generic + b.generic
  }

  cmc : ManaCost -> Integer
  cmc (cost) = cost.white + cost.blue + cost.black + cost.red + cost.green + cost.generic

  cost-colors : ManaCost -> ColorSet
  cost-colors (cost) = ColorSet {
    white = cost.white > 0,
    blue = cost.blue > 0,
    black = cost.black > 0,
    red = cost.red > 0,
    green = cost.green > 0
  }

Section: Mana Pool

  ManaPool = record {
    white : Integer,
    blue : Integer,
    black : Integer,
    red : Integer,
    green : Integer,
    colorless : Integer
  }

  mana-pool-empty : ManaPool
  mana-pool-empty = ManaPool { white = 0, blue = 0, black = 0, red = 0, green = 0, colorless = 0 }

  mana-pool-add : ManaPool, ManaColor, Integer -> ManaPool
  mana-pool-add (pool) (color) (amount) =
    when color
      is White -> ManaPool { white = pool.white + amount, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless }
      is Blue -> ManaPool { white = pool.white, blue = pool.blue + amount, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless }
      is Black -> ManaPool { white = pool.white, blue = pool.blue, black = pool.black + amount, red = pool.red, green = pool.green, colorless = pool.colorless }
      is Red -> ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red + amount, green = pool.green, colorless = pool.colorless }
      is Green -> ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green + amount, colorless = pool.colorless }
      is Colorless -> ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless + amount }

  mana-pool-total : ManaPool -> Integer
  mana-pool-total (pool) = pool.white + pool.blue + pool.black + pool.red + pool.green + pool.colorless

Section: Payment

  can-pay : ManaPool, ManaCost -> Boolean
  can-pay (pool) (cost) =
    if pool.white < cost.white then False
    else if pool.blue < cost.blue then False
    else if pool.black < cost.black then False
    else if pool.red < cost.red then False
    else if pool.green < cost.green then False
    else let remaining = mana-pool-total pool - cost.white - cost.blue - cost.black - cost.red - cost.green
    in remaining >= cost.generic

  pay-cost : ManaPool, ManaCost -> ManaPool
  pay-cost (pool) (cost) =
    let after-colored = ManaPool {
      white = pool.white - cost.white,
      blue = pool.blue - cost.blue,
      black = pool.black - cost.black,
      red = pool.red - cost.red,
      green = pool.green - cost.green,
      colorless = pool.colorless
    }
    in pay-generic after-colored (cost.generic)

  pay-generic : ManaPool, Integer -> ManaPool
  pay-generic (pool) (amount) =
    if amount <= 0 then pool
    else if pool.colorless > 0 then pay-generic (ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless - 1 }) (amount - 1)
    else if pool.white > 0 then pay-generic (ManaPool { white = pool.white - 1, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless }) (amount - 1)
    else if pool.blue > 0 then pay-generic (ManaPool { white = pool.white, blue = pool.blue - 1, black = pool.black, red = pool.red, green = pool.green, colorless = pool.colorless }) (amount - 1)
    else if pool.black > 0 then pay-generic (ManaPool { white = pool.white, blue = pool.blue, black = pool.black - 1, red = pool.red, green = pool.green, colorless = pool.colorless }) (amount - 1)
    else if pool.red > 0 then pay-generic (ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red - 1, green = pool.green, colorless = pool.colorless }) (amount - 1)
    else pay-generic (ManaPool { white = pool.white, blue = pool.blue, black = pool.black, red = pool.red, green = pool.green - 1, colorless = pool.colorless }) (amount - 1)

Section: Formatting

  format-mana-cost : ManaCost -> Text
  format-mana-cost (cost) =
    let g-part = if cost.generic > 0 then "{" & show (cost.generic) & "}" else ""
    in let w-part = repeat-symbol "W" (cost.white)
    in let u-part = repeat-symbol "U" (cost.blue)
    in let b-part = repeat-symbol "B" (cost.black)
    in let r-part = repeat-symbol "R" (cost.red)
    in let g2-part = repeat-symbol "G" (cost.green)
    in g-part & w-part & u-part & b-part & r-part & g2-part

  repeat-symbol : Text, Integer -> Text
  repeat-symbol (sym) (n) =
    if n <= 0 then ""
    else "{" & sym & "}" & repeat-symbol sym (n - 1)

  format-mana-pool : ManaPool -> Text
  format-mana-pool (pool) =
    "W:" & show (pool.white) & " U:" & show (pool.blue) & " B:" & show (pool.black) & " R:" & show (pool.red) & " G:" & show (pool.green) & " C:" & show (pool.colorless)

