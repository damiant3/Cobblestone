Section: Colors

  GemColor =
   | Red
   | Yellow
   | Blue
   | Orange
   | Green
   | Purple
   | Colorless

  gem-color-name : GemColor -> Text
  gem-color-name (c) =
    when c
      is Red -> "Red"
      is Yellow -> "Yellow"
      is Blue -> "Blue"
      is Orange -> "Orange"
      is Green -> "Green"
      is Purple -> "Purple"
      is Colorless -> "Colorless"

  gem-color-symbol : GemColor -> Text
  gem-color-symbol (c) =
    when c
      is Red -> "R"
      is Yellow -> "Y"
      is Blue -> "B"
      is Orange -> "O"
      is Green -> "G"
      is Purple -> "P"
      is Colorless -> "W"

Section: Color Set

  ColorSet = record {
    red : Boolean,
    yellow : Boolean,
    blue : Boolean,
    orange : Boolean,
    green : Boolean,
    purple : Boolean
  }

  color-set-empty : ColorSet
  color-set-empty = ColorSet { red = False, yellow = False, blue = False, orange = False, green = False, purple = False }

  color-set-mono : GemColor -> ColorSet
  color-set-mono (c) =
    when c
      is Red -> ColorSet { red = True, yellow = False, blue = False, orange = False, green = False, purple = False }
      is Yellow -> ColorSet { red = False, yellow = True, blue = False, orange = False, green = False, purple = False }
      is Blue -> ColorSet { red = False, yellow = False, blue = True, orange = False, green = False, purple = False }
      is Orange -> ColorSet { red = False, yellow = False, blue = False, orange = True, green = False, purple = False }
      is Green -> ColorSet { red = False, yellow = False, blue = False, orange = False, green = True, purple = False }
      is Purple -> ColorSet { red = False, yellow = False, blue = False, orange = False, green = False, purple = True }
      is Colorless -> color-set-empty

  color-set-has : ColorSet, GemColor -> Boolean
  color-set-has (cs) (c) =
    when c
      is Red -> cs.red
      is Yellow -> cs.yellow
      is Blue -> cs.blue
      is Orange -> cs.orange
      is Green -> cs.green
      is Purple -> cs.purple
      is Colorless -> False

  color-count : ColorSet -> Integer
  color-count (cs) =
    let r = if cs.red then 1 else 0
    in let y = if cs.yellow then 1 else 0
    in let b = if cs.blue then 1 else 0
    in let o = if cs.orange then 1 else 0
    in let g = if cs.green then 1 else 0
    in let p = if cs.purple then 1 else 0
    in r + y + b + o + g + p

Section: Light Cost

  LightCost = record {
    red : Integer,
    yellow : Integer,
    blue : Integer,
    orange : Integer,
    green : Integer,
    purple : Integer,
    white : Integer
  }

  light-cost-zero : LightCost
  light-cost-zero = LightCost { red = 0, yellow = 0, blue = 0, orange = 0, green = 0, purple = 0, white = 0 }

  light-cost-r : Integer -> LightCost
  light-cost-r (n) = LightCost { red = n, yellow = 0, blue = 0, orange = 0, green = 0, purple = 0, white = 0 }

  light-cost-y : Integer -> LightCost
  light-cost-y (n) = LightCost { red = 0, yellow = n, blue = 0, orange = 0, green = 0, purple = 0, white = 0 }

  light-cost-b : Integer -> LightCost
  light-cost-b (n) = LightCost { red = 0, yellow = 0, blue = n, orange = 0, green = 0, purple = 0, white = 0 }

  light-cost-o : Integer -> LightCost
  light-cost-o (n) = LightCost { red = 0, yellow = 0, blue = 0, orange = n, green = 0, purple = 0, white = 0 }

  light-cost-g : Integer -> LightCost
  light-cost-g (n) = LightCost { red = 0, yellow = 0, blue = 0, orange = 0, green = n, purple = 0, white = 0 }

  light-cost-p : Integer -> LightCost
  light-cost-p (n) = LightCost { red = 0, yellow = 0, blue = 0, orange = 0, green = 0, purple = n, white = 0 }

  light-cost-w : Integer -> LightCost
  light-cost-w (n) = LightCost { red = 0, yellow = 0, blue = 0, orange = 0, green = 0, purple = 0, white = n }

  light-cost-add : LightCost, LightCost -> LightCost
  light-cost-add (a) (b) = LightCost {
    red = a.red + b.red,
    yellow = a.yellow + b.yellow,
    blue = a.blue + b.blue,
    orange = a.orange + b.orange,
    green = a.green + b.green,
    purple = a.purple + b.purple,
    white = a.white + b.white
  }

  total-rays : LightCost -> Integer
  total-rays (cost) = cost.red + cost.yellow + cost.blue + cost.orange + cost.green + cost.purple + cost.white

  colored-rays : LightCost -> Integer
  colored-rays (cost) = cost.red + cost.yellow + cost.blue + cost.orange + cost.green + cost.purple

  cost-colors : LightCost -> ColorSet
  cost-colors (cost) = ColorSet {
    red = cost.red > 0,
    yellow = cost.yellow > 0,
    blue = cost.blue > 0,
    orange = cost.orange > 0,
    green = cost.green > 0,
    purple = cost.purple > 0
  }

Section: Gem Stone Types

  GemStoneType =
   | GemRuby
   | GemTopaz
   | GemSapphire
   | GemCarnelian
   | GemEmerald
   | GemDiamond
   | GemObsidian

  gem-stone-color : GemStoneType -> GemColor
  gem-stone-color (g) =
    when g
      is GemRuby -> Red
      is GemTopaz -> Yellow
      is GemSapphire -> Blue
      is GemCarnelian -> Orange
      is GemEmerald -> Green
      is GemDiamond -> Colorless
      is GemObsidian -> Colorless

  gem-stone-hardness : GemStoneType -> Integer
  gem-stone-hardness (g) =
    when g
      is GemRuby -> 9
      is GemTopaz -> 8
      is GemSapphire -> 9
      is GemCarnelian -> 7
      is GemEmerald -> 7
      is GemDiamond -> 10
      is GemObsidian -> 5

Section: Prismatic State

  PrismaticState = record {
    rays-total : Integer,
    rays-used : Integer,
    fluorescence-active : Boolean,
    committed-rays : Integer
  }

  prismatic-new : PrismaticState
  prismatic-new = PrismaticState { rays-total = 0, rays-used = 0, fluorescence-active = False, committed-rays = 0 }

  prismatic-available-rays : PrismaticState -> Integer
  prismatic-available-rays (ps) = ps.rays-total - ps.rays-used - ps.committed-rays

  prismatic-gain-ray : PrismaticState -> PrismaticState
  prismatic-gain-ray (ps) = PrismaticState { rays-total = ps.rays-total + 1, rays-used = 0, fluorescence-active = False, committed-rays = ps.committed-rays }

  prismatic-spend-rays : PrismaticState, Integer -> PrismaticState
  prismatic-spend-rays (ps) (n) = PrismaticState { rays-total = ps.rays-total, rays-used = ps.rays-used + n, fluorescence-active = ps.fluorescence-active, committed-rays = ps.committed-rays }

  prismatic-activate-fluorescence : PrismaticState -> PrismaticState
  prismatic-activate-fluorescence (ps) = PrismaticState { rays-total = ps.rays-total, rays-used = ps.rays-used + 1, fluorescence-active = True, committed-rays = ps.committed-rays }

  prismatic-commit-rays : PrismaticState, Integer -> PrismaticState
  prismatic-commit-rays (ps) (n) = PrismaticState { rays-total = ps.rays-total, rays-used = ps.rays-used, fluorescence-active = ps.fluorescence-active, committed-rays = ps.committed-rays + n }

  prismatic-uncommit-rays : PrismaticState, Integer -> PrismaticState
  prismatic-uncommit-rays (ps) (n) = PrismaticState { rays-total = ps.rays-total, rays-used = ps.rays-used, fluorescence-active = ps.fluorescence-active, committed-rays = if ps.committed-rays > n then ps.committed-rays - n else 0 }

  prismatic-refresh : PrismaticState -> PrismaticState
  prismatic-refresh (ps) = PrismaticState { rays-total = ps.rays-total, rays-used = 0, fluorescence-active = False, committed-rays = ps.committed-rays }

Section: Payment

  can-afford : PrismaticState, LightCost, Integer, Integer -> Boolean
  can-afford (ps) (cost) (gems-available) (gems-for-color) =
    let rays-needed = total-rays cost
    in let avail = prismatic-available-rays ps
    in if rays-needed > avail then False
    else gems-for-color >= colored-rays cost

  stone-cost : LightCost -> Integer
  stone-cost (cost) =
    let base = cost.red + cost.yellow + cost.blue + cost.orange + cost.green
    in base + cost.purple * 2

Section: Disruption Contest

  disruption-chance : Integer, Integer -> Integer
  disruption-chance (focus) (disruption) =
    let raw = 90 + (disruption - focus) * 4
    in if raw < 5 then 5
    else if raw > 100 then 100
    else raw

Section: Formatting

  format-light-cost : LightCost -> Text
  format-light-cost (cost) =
    let w-part = if cost.white > 0 then "{" & show (cost.white) & "}" else ""
    in let r-part = repeat-symbol "R" (cost.red)
    in let y-part = repeat-symbol "Y" (cost.yellow)
    in let b-part = repeat-symbol "B" (cost.blue)
    in let o-part = repeat-symbol "O" (cost.orange)
    in let g-part = repeat-symbol "G" (cost.green)
    in let p-part = repeat-symbol "P" (cost.purple)
    in w-part & r-part & y-part & b-part & o-part & g-part & p-part

  repeat-symbol : Text, Integer -> Text
  repeat-symbol (sym) (n) =
    if n <= 0 then ""
    else "{" & sym & "}" & repeat-symbol sym (n - 1)

  format-prismatic : PrismaticState -> Text
  format-prismatic (ps) =
    "Rays:" & show (prismatic-available-rays ps) & "/" & show (ps.rays-total) &
    if ps.fluorescence-active then " [FLUOR]" else ""

