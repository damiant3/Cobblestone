  queued-loyalty-panels : List (List Text), Integer, List WidgetNode -> List WidgetNode
  queued-loyalty-panels (orders) (i) (acc) =
    if i >= list-length orders then acc
    else let q = list-at orders i
    in if json-obj-field q "pending" /= "true" then queued-loyalty-panels orders (i + 1) acc
    else let player = json-obj-field q "player"
    in let name = state-get-text ("g-p" & player & "-name")
    in let panel = widget-panel ("gloyaltyq-" & player) DirColumn 4 [widget-label ("gloyaltyq-label-" & player) (name & ": queued " & json-obj-field q "label"), widget-label ("gloyaltyq-reason-" & player) (json-obj-field q "reason"), widget-button ("gqlc-" & player) "Cancel queued General ability"]
    in queued-loyalty-panels orders (i + 1) (list-push acc panel)

  queue-loyalty-buttons : List (List Text), Integer, List WidgetNode -> List WidgetNode
  queue-loyalty-buttons (rows) (i) (acc) =
    if i >= list-length rows then acc
    else let row = list-at rows i
    in let player = json-obj-field row "player"
