  queue-card-controls : Integer -> List WidgetNode
  queue-card-controls (unused) =
    if state-get sk-g-over == 1 then []
    else let queued = json-parse-rows (state-get-text "g-queued-cards")
    in let rows = json-parse-rows (state-get-text "g-queue-card-options")
    in let pending = for q in queued -> if json-obj-field q "pending" == "true" then widget-panel ("gqf-pending-" & json-obj-field q "player") DirColumn 4 [widget-label ("gqf-label-" & json-obj-field q "player") (json-obj-field q "label" & ": " & json-obj-field q "reason"), widget-button ("gqfc-" & json-obj-field q "player") "Cancel queued card"] else widget-label ("gqf-empty-" & json-obj-field q "player") ""
    in queue-card-buttons rows 0 pending

  queue-card-buttons : List (List Text), Integer, List WidgetNode -> List WidgetNode
  queue-card-buttons (rows) (i) (acc) =
    if i >= list-length rows then acc
    else queue-card-buttons rows (i + 1) (list-push acc (widget-button ("gqf-" & show i) ("Queue card: " & json-obj-field (list-at rows i) "label")))

  choose-queued-card : Text -> Integer
  choose-queued-card (id) =
    let rows = json-parse-rows (state-get-text "g-queue-card-options")
    in let index = text-to-integer (g-suffix id 4 "")
    in if index < 0 | index >= list-length rows then 0
    else let row = list-at rows index
    in let cleared = clear-payment-draft 0
    in let player = state-set-text "g-pick-queue-player" (json-obj-field row "player")
    in let card = state-set-text "g-pick-card" (json-obj-field row "card")
    in let name = state-set-text "g-pick-name" (json-obj-field row "label")
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-card-targets?player=" & player & "&card=" & card) manual-targets-cb

  submit-queued-card : Text -> Integer
  submit-queued-card (target) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-card?choice=queue&player=" & state-get-text "g-pick-queue-player" & "&card=" & state-get-text "g-pick-card" & target-query target) paid-card-cb

  cancel-queued-card : Text -> Integer
  cancel-queued-card (id) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-card?choice=cancel&player=" & g-suffix id 5 "") step-cb

  submit-queued-loyalty : Text -> Integer
  submit-queued-loyalty (target) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-loyalty?choice=queue&player=" & state-get-text "g-pick-queue-player" & "&index=" & state-get-text "g-pick-ability" & target-query target) paid-card-cb

  cancel-queued-loyalty : Text -> Integer
  cancel-queued-loyalty (id) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-loyalty?choice=cancel&player=" & g-suffix id 5 "") step-cb

  submit-queued-ability : Text -> Integer
  submit-queued-ability (target) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-ability?choice=queue&player=" & state-get-text "g-pick-queue-player" & "&permanent=" & state-get-text "g-pick-permanent" & "&index=" & state-get-text "g-pick-ability" & target-query target) paid-card-cb

  cancel-queued-ability : Text -> Integer
  cancel-queued-ability (id) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/queue-ability?choice=cancel&player=" & g-suffix id 4 "") step-cb

  change-payment-mode : Text -> Integer
  change-payment-mode (id) =
    let player = if g-prefix id "gp0" then 0 else 1
    in let manual = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/payment-mode?player=" & show player & "&manual=" & show manual) step-cb

  clear-payment-chains : Integer -> Integer
  clear-payment-chains (unused) =
    let a = state-set-text "g-pay-current" ""
    in let b = state-set-text "g-pay-current-label" ""
    in let c = state-set-text "g-pay-chains" ""
    in let d = state-set-text "g-pay-labels" ""
    in state-set "g-pay-rays" 0

  clear-payment-draft : Integer -> Integer
  clear-payment-draft (unused) =
    let a = state-set-text "g-pay-card" ""
    in let b = state-set-text "g-pay-name" ""
    in let c = state-set-text "g-pay-target" ""
    in let d = state-set-text "g-pick-card" ""
    in let e = state-set-text "g-pick-targets" ""
    in let f = state-set-text "g-pick-permanent" ""
    in let g = state-set-text "g-pick-ability" ""
    in let h = state-set-text "g-pick-queue-player" ""
    in let loyalty = state-set "g-pick-loyalty" 0
    in let response = state-set-text "g-pick-response-nonce" ""
    in clear-payment-chains 0

  add-payment-stone : Text -> Integer
  add-payment-stone (id) =
    let rows = json-parse-rows (state-get-text "g-battlefield")
    in let index = text-to-integer (g-suffix id 7 "")
    in if index < 0 | index >= list-length rows then 0
    else let row = list-at rows index
    in let raw = state-get-text "g-pay-current"
    in let label = state-get-text "g-pay-current-label"
    in let a = state-set-text "g-pay-current" (raw & (if raw == "" then "" else ",") & json-obj-field row "id")
    in let b = state-set-text "g-pay-current-label" (label & (if label == "" then "" else " + ") & json-obj-field row "name")
    in request-render 0

  finish-payment-ray : Integer -> Integer
  finish-payment-ray (unused) =
    let raw = state-get-text "g-pay-current"
    in let chains = state-get-text "g-pay-chains"
    in let label = state-get-text "g-pay-current-label"
    in let labels = state-get-text "g-pay-labels"
    in let count = state-get "g-pay-rays" + 1
    in let a = state-set-text "g-pay-chains" (chains & (if chains == "" then "" else ";") & (if raw == "" then "w" else raw))
    in let b = state-set-text "g-pay-labels" (labels & (if labels == "" then "" else "; ") & "Ray " & show count & ": " & (if label == "" then "White" else label))
    in let c = state-set "g-pay-rays" count
    in let d = state-set-text "g-pay-current" ""
    in let e = state-set-text "g-pay-current-label" ""
    in request-render 0

  submit-payment : Integer -> Integer
  submit-payment (unused) =
    let card = state-get-text "g-pay-card"
    in if card == "" then 0
    else let current = state-get-text "g-pay-current"
    in let chains = state-get-text "g-pay-chains"
    in let encoded = chains & (if current == "" then "" else (if chains == "" then "" else ";") & current)
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/play?card=" & card & "&chains=" & encoded & target-query (state-get-text "g-pay-target") & manual-player-query 0) paid-card-cb

  paid-card-cb : Text -> Integer
  paid-card-cb (resp) =
    let updated = step-cb resp
    in if text-length (json-obj-field (json-parse-obj resp) "error") > 0 then updated
    else let cleared = clear-payment-draft 0
    in request-render 0

  submit-block : Text -> Integer
  submit-block (attacker) =
    if state-get-text "g-blocker" == "" then 0
    else let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/block?blocker=" & state-get-text "g-blocker" & "&attacker=" & attacker) block-cb

  block-cb : Text -> Integer
  block-cb (resp) =
    let updated = step-cb resp
    in if text-length (json-obj-field (json-parse-obj resp) "error") > 0 then updated
    else let clear = state-set-text "g-blocker" ""
    in let msg = state-set-text "g-message" "Block assigned. Choose another blocker or Continue."
    in request-render 0

  g-prefix : Text, Text -> Boolean
  g-prefix (s) (prefix) = g-prefix-at s prefix 0

  g-prefix-at : Text, Text, Integer -> Boolean
  g-prefix-at (s) (prefix) (i) = if i >= text-length prefix then True else if i >= text-length s then False else char-at s i == char-at prefix i & g-prefix-at s prefix (i + 1)

  g-suffix : Text, Integer, Text -> Text
  g-suffix (s) (i) (acc) = if i >= text-length s then acc else g-suffix s (i + 1) (acc & char-to-text (char-at s i))

  auto-game : Integer -> Integer
  auto-game (x) =
    if state-get "g-paused" == 1 | state-get sk-g-over == 1 then 0
    else let mode = state-set "g-auto-mode" 1
    in auto-tick 0

  auto-tick : Integer -> Integer
  auto-tick (x) =
    if state-get "g-auto-mode" == 0 | state-get "g-busy" == 1 | state-get "g-paused" == 1 | state-get sk-g-over == 1 then 0
    else let busy = state-set "g-busy" 1
    in fetch-get-then "/api/magic/game/step" step-cb

Section: Entry

  page-card-order : Integer -> Text
  page-card-order (mode) = if mode == 1 then "Do not play" else if mode == 2 then "Play next" else "Auto"

  card-order-controls : Text, Integer, Text, Integer, Text -> WidgetNode
  card-order-controls (group) (player) (card) (mode) (caption) =
    let key = "gco-" & group & "-" & show player & "-"
    in widget-panel ("gflags-" & group & "-" & card) DirColumn 3 [widget-label ("gflag-label-" & group & "-" & card) (caption & " | AI: " & page-card-order mode), widget-panel ("gflag-buttons-" & group & "-" & card) DirRow 4 [widget-button (key & "0-" & card) "Auto", widget-button (key & "1-" & card) "Do not play", widget-button (key & "2-" & card) "Play next"]]

  hand-order-tree : Integer -> List WidgetNode
  hand-order-tree (x) =
    let raw = state-get-text "g-hand-orders"
    in if state-get sk-g-over == 1 | raw == "" then []
    else hand-order-rows (json-parse-rows raw) (text-to-integer (state-get-text "g-active-player")) 0 []

  hand-order-rows : List (List Text), Integer, Integer, List WidgetNode -> List WidgetNode
  hand-order-rows (rows) (player) (i) (acc) =
    if i >= list-length rows then acc
    else let row = list-at rows i
    in let controls = card-order-controls "h" player (json-obj-field row "id") (text-to-integer (json-obj-field row "play-order")) (show (i + 1) & ". " & json-obj-field row "name" & " " & json-obj-field row "cost")
    in hand-order-rows rows player (i + 1) (list-push acc controls)

  change-card-order : Text -> Integer
  change-card-order (id) =
    let parts = text-split (g-suffix id 4 "") "-"
    in if list-length parts /= 4 then 0
    else let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/card-order?player=" & list-at parts 1 & "&card=" & list-at parts 3 & "&order=" & list-at parts 2) step-cb

  commitment-controls : Integer -> List WidgetNode
  commitment-controls (x) =
    if state-get "g-commitment-nonce" <= 0 | state-get sk-g-over == 1 then []
    else let all = state-get "g-commitment-all" == 1
    in let raw = state-get-text "g-commitment-targets"
    in let rows = if raw == "" then [] else json-parse-rows raw
    in let options = target-choice-buttons "gct-" rows (state-get-text "g-commitment-recommended") 0 []
    in [widget-label "g-commit-title" (if state-get "g-commitment-ability" == 1 then "Activate " & state-get-text "g-commitment-name" & ": " & state-get-text "g-commitment-description" & " (" & state-get-text "g-commitment-cost" & ")?" else if all then "Cast " & state-get-text "g-commitment-name" & " using all " & show (state-get "g-commitment-rays") & " unreserved rays?" else "Choose a target for " & state-get-text "g-commitment-name"), widget-label "g-commit-timeout" (if state-get "g-commitment-ability" == 1 then "After 15 seconds: Hold. Skip this ability for this main phase." else if all then "After 15 seconds: Hold. Skip this card for this main phase; the AI can choose cheaper spells." else "After 15 seconds: cast at the shown recommendation if still allowed. An all-rays spend means Hold."), widget-panel "g-commit-targets" DirRow 4 options, widget-panel "g-commit-buttons" DirRow 8 [widget-button "g-commit-cast" (if state-get "g-commitment-ability" == 1 then "Activate" else if list-length rows > 0 then "Cast recommended" else "Cast"), widget-button "g-commit-hold" "Hold", widget-button "g-commit-override" "Override"]]

  read-commitment : Text -> Integer
  read-commitment (raw) =
    if raw == "" | raw == "null" then state-set "g-commitment-nonce" 0
    else let row = json-parse-obj raw
    in let nonce = text-to-integer (json-obj-field row "nonce")
    in let saved = state-set "g-commitment-nonce" nonce
    in let name = state-set-text "g-commitment-name" (json-obj-field row "name")
    in let ability = state-set "g-commitment-ability" (if json-obj-field row "ability" == "true" then 1 else 0)
    in let description = state-set-text "g-commitment-description" (json-obj-field row "description")
    in let cost = state-set-text "g-commitment-cost" (json-obj-field row "cost")
    in let rays = state-set "g-commitment-rays" (text-to-integer (json-obj-field row "rays"))
    in let all = state-set "g-commitment-all" (if json-obj-field row "all-rays" == "false" then 0 else 1)
    in let targets = state-set-text "g-commitment-targets" (json-obj-field row "targets")
    in let recommended = state-set-text "g-commitment-recommended" (json-obj-field row "recommended")
    in let deadline = state-set "g-commitment-until" (clock-ms 0 + text-to-integer (json-obj-field row "remaining-ms"))
    in if state-get "g-pause-active" == 0 & state-get "g-pause-requested" == 0 & nonce > 0 & state-get "g-commitment-timer" == 0 then (let started = state-set "g-commitment-timer" 1 in set-timeout commitment-tick 250) else 0

  commitment-tick : Integer -> Integer
  commitment-tick (x) =
    if state-get "g-pause-active" == 1 | state-get "g-pause-requested" == 1 | state-get "g-commitment-nonce" <= 0 | state-get sk-g-over == 1 then state-set "g-commitment-timer" 0
    else let held = if state-get "g-busy" == 0 & clock-ms 0 >= state-get "g-commitment-until" then (if state-get "g-commitment-all" == 1 | state-get "g-commitment-ability" == 1 then submit-commitment False else submit-decision "timeout" "") else 0
    in set-timeout commitment-tick 250

  submit-commitment : Boolean -> Integer
  submit-commitment (cast) = submit-decision (if cast then "cast" else "hold") ""

  submit-override : Integer -> Integer
  submit-override (unused) =
    if state-get "g-busy" == 1 | state-get "g-pause-active" == 1 | state-get "g-commitment-nonce" <= 0 then 0
    else let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/override?nonce=" & show (state-get "g-commitment-nonce")) step-cb

  choose-commitment-target : Text -> Integer
  choose-commitment-target (id) =
    let rows = json-parse-rows (state-get-text "g-commitment-targets")
    in let index = text-to-integer (g-suffix id 4 "")
    in if index < 0 | index >= list-length rows then 0 else submit-decision "cast" (json-obj-field (list-at rows index) "id")

  submit-decision : Text, Text -> Integer
  submit-decision (choice) (target) =
    if state-get "g-busy" == 1 | state-get "g-commitment-nonce" <= 0 then 0
    else let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/commitment?nonce=" & show (state-get "g-commitment-nonce") & "&choice=" & choice & target-query target) step-cb

  change-target-policy : Text -> Integer
  change-target-policy (id) =
    let player = if id == "gp0-target-pause" then 0 else 1
    in let enabled = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/target-policy?player=" & show player & "&enabled=" & show enabled) step-cb

  change-commitment-policy : Text -> Integer
  change-commitment-policy (id) =
    let player = if id == "gp0-commitment" then 0 else 1
    in let enabled = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/commitment-policy?player=" & show player & "&enabled=" & show enabled) step-cb

  combat-choice-controls : Integer -> List WidgetNode
  combat-choice-controls (unused) =
    if state-get "g-combat-nonce" <= 0 | state-get sk-g-over == 1 then []
    else [widget-label "g-combat-title" "Combat risk: the opponent has an untapped creature and available rays.", widget-label "g-combat-timeout" "Continue accepts the shown AI attack plan. Untouched, it proceeds after 15 seconds. Editing attackers cancels the timer; then use Continue."]

  read-combat-choice : Text -> Integer
  read-combat-choice (raw) =
    if raw == "" | raw == "null" then state-set "g-combat-nonce" 0
    else let row = json-parse-obj raw
    in let nonce = state-set "g-combat-nonce" (text-to-integer (json-obj-field row "nonce"))
    in let deadline = state-set "g-combat-until" (clock-ms 0 + text-to-integer (json-obj-field row "remaining-ms"))
    in if state-get "g-pause-active" == 0 & state-get "g-pause-requested" == 0 & state-get "g-combat-nonce" > 0 & state-get "g-combat-timer" == 0 then (let started = state-set "g-combat-timer" 1 in set-timeout combat-choice-tick 250) else 0

  combat-choice-tick : Integer -> Integer
  combat-choice-tick (unused) =
    if state-get "g-pause-active" == 1 | state-get "g-pause-requested" == 1 | state-get "g-combat-nonce" <= 0 | state-get sk-g-over == 1 then state-set "g-combat-timer" 0
    else let continued = if state-get "g-busy" == 0 & clock-ms 0 >= state-get "g-combat-until" then submit-combat-choice True else 0
    in set-timeout combat-choice-tick 250

  submit-combat-choice : Boolean -> Integer
  submit-combat-choice (timeout) =
    if state-get "g-busy" == 1 | state-get "g-combat-nonce" <= 0 then 0
    else let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/combat-choice?nonce=" & show (state-get "g-combat-nonce") & "&choice=" & (if timeout then "timeout" else "continue")) step-cb

  change-combat-policy : Text -> Integer
  change-combat-policy (id) =
    let player = if id == "gp0-combat-pause" then 0 else 1
    in let enabled = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/combat-policy?player=" & show player & "&enabled=" & show enabled) step-cb

  change-sacrifice-policy : Text -> Integer
  change-sacrifice-policy (id) =
    let player = if id == "gp0-sacrifice-pause" then 0 else 1
    in let enabled = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/sacrifice-policy?player=" & show player & "&enabled=" & show enabled) step-cb

  disruption-controls : Integer -> List WidgetNode
  disruption-controls (unused) =
    if state-get "g-disruption-nonce" <= 0 | state-get sk-g-over == 1 then []
    else let choices = json-parse-rows (state-get-text "g-disruption-choices")
    in [widget-label "g-disruption-title" ((if state-get "g-disruption-player" == 0 then state-get-text sk-g-p0-name else state-get-text sk-g-p1-name) & ": respond to " & state-get-text "g-disruption-name" & "?"), widget-label "g-disruption-help" (if state-get-text "g-disruption-kind" == "loyalty" then "General activation is committed for this turn. Choose one Cantrip, ordinary ability or Pass. Disruption cannot target loyalty abilities. After 15 seconds: Pass." else if state-get-text "g-disruption-kind" == "ability" then "Activation costs are paid. Choose one Cantrip, ordinary ability or Pass. Disruption cannot target abilities. After 15 seconds: Pass." else "The spell is paid. Choose one Disruption, Cantrip, ordinary ability or Pass. After 15 seconds: Pass."), widget-panel "g-disruption-options" DirRow 4 (disruption-buttons choices 0 []), widget-button "g-disruption-pass" "Pass"]

  disruption-buttons : List (List Text), Integer, List WidgetNode -> List WidgetNode
  disruption-buttons (choices) (i) (acc) =
    if i >= list-length choices then acc
    else let option = list-at choices i
    in let label = if json-obj-field option "kind" == "ability" then "Activate " & json-obj-field option "name" & " #" & json-obj-field option "index" & " (" & json-obj-field option "cost" & ")" else if json-obj-field option "kind" == "cantrip" then "Cast " & json-obj-field option "name" & " (" & json-obj-field option "rays" & " rays)" else "Disrupt with " & json-obj-field option "name" & " (" & json-obj-field option "rays" & (if json-obj-field option "rays" == "1" then " ray, " else " rays, ") & json-obj-field option "chance" & "% chance)"
    in disruption-buttons choices (i + 1) (list-push acc (widget-button ("gdr-" & show i) label))

  read-disruption : Text -> Integer
  read-disruption (raw) =
    if raw == "" | raw == "null" then (let cleared = if state-get-text "g-pick-response-nonce" /= "" then clear-payment-draft 0 else 0 in state-set "g-disruption-nonce" 0)
    else let row = json-parse-obj raw
    in let cleared = if state-get-text "g-pick-response-nonce" /= "" & state-get-text "g-pick-response-nonce" /= json-obj-field row "nonce" then clear-payment-draft 0 else 0
    in let nonce = state-set "g-disruption-nonce" (text-to-integer (json-obj-field row "nonce"))
    in let name = state-set-text "g-disruption-name" (json-obj-field row "name")
    in let player = state-set "g-disruption-player" (text-to-integer (json-obj-field row "player"))
    in let kind = state-set-text "g-disruption-kind" (json-obj-field row "pending-kind")
    in let choices = state-set-text "g-disruption-choices" (json-obj-field row "choices")
    in let deadline = state-set "g-disruption-until" (clock-ms 0 + text-to-integer (json-obj-field row "remaining-ms"))
    in if state-get "g-pause-active" == 0 & state-get "g-pause-requested" == 0 & state-get "g-disruption-timer" == 0 then (let started = state-set "g-disruption-timer" 1 in set-timeout disruption-tick 250) else 0

  read-disruption-result : Text -> Text
  read-disruption-result (raw) =
    if raw == "" | raw == "null" then state-set-text "g-disruption-result" ""
    else let row = json-parse-obj raw
    in let outcome = if json-obj-field row "abandoned" == "true" then " was abandoned at game end" else if json-obj-field row "disrupted" == "true" then " was disrupted" else if json-obj-field row "fizzled" == "true" then " had no legal target" else " resolved"
    in state-set-text "g-disruption-result" (json-obj-field row "name" & outcome & (if json-obj-field row "response-kind" == "ability" then (if json-obj-field row "reply-fizzled" == "true" then " after the ability response fizzled." else " after the ability response.") else if json-obj-field row "response-kind" == "cantrip" then (if json-obj-field row "reply-fizzled" == "true" then " after the Cantrip response fizzled." else " after the Cantrip response.") else if text-to-integer (json-obj-field row "reply") < 0 then " after Pass." else " (" & json-obj-field row "chance" & "% chance, roll " & json-obj-field row "roll" & ")."))

  disruption-tick : Integer -> Integer
  disruption-tick (unused) =
    if state-get "g-pause-active" == 1 | state-get "g-pause-requested" == 1 | state-get "g-disruption-nonce" <= 0 | state-get sk-g-over == 1 then state-set "g-disruption-timer" 0
    else let passed = if state-get "g-busy" == 0 & clock-ms 0 >= state-get "g-disruption-until" then submit-disruption "timeout" (0 - 1) else 0
    in set-timeout disruption-tick 250

  choose-disruption : Text -> Integer
  choose-disruption (id) =
    let choices = json-parse-rows (state-get-text "g-disruption-choices")
    in let i = text-to-integer (g-suffix id 4 "")
    in if i < 0 | i >= list-length choices then 0
    else let row = list-at choices i
    in if json-obj-field row "kind" == "ability" then choose-ability-response row
    else if json-obj-field row "kind" /= "cantrip" then submit-disruption "disrupt" (text-to-integer (json-obj-field row "card"))
    else let cleared = clear-payment-draft 0
    in let nonce = state-set-text "g-pick-response-nonce" (show (state-get "g-disruption-nonce"))
    in let card = state-set-text "g-pick-card" (json-obj-field row "card")
    in let name = state-set-text "g-pick-name" (json-obj-field row "name")
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/response-targets?nonce=" & nonce & "&card=" & card) manual-targets-cb

  choose-ability-response : List Text -> Integer
  choose-ability-response (row) =
    let cleared = clear-payment-draft 0
    in let nonce = state-set-text "g-pick-response-nonce" (show (state-get "g-disruption-nonce"))
    in let source = state-set-text "g-pick-permanent" (json-obj-field row "permanent")
    in let index = state-set-text "g-pick-ability" (json-obj-field row "index")
    in let name = state-set-text "g-pick-name" (json-obj-field row "name")
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/response-ability-targets?nonce=" & nonce & "&permanent=" & source & "&index=" & index) manual-targets-cb

  submit-ability-response : Text -> Integer
  submit-ability-response (target) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/response-ability?nonce=" & state-get-text "g-pick-response-nonce" & "&permanent=" & state-get-text "g-pick-permanent" & "&index=" & state-get-text "g-pick-ability" & target-query target) paid-card-cb

  submit-cantrip-response : Text -> Integer
  submit-cantrip-response (target) =
    let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/disruption?choice=cantrip&nonce=" & state-get-text "g-pick-response-nonce" & "&card=" & state-get-text "g-pick-card" & target-query target) paid-card-cb

  submit-disruption : Text, Integer -> Integer
  submit-disruption (choice) (card) =
    if state-get "g-busy" == 1 | state-get "g-disruption-nonce" <= 0 then 0
    else let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/disruption?nonce=" & show (state-get "g-disruption-nonce") & "&choice=" & choice & (if card >= 0 then "&card=" & show card else "")) step-cb

  change-disruption-policy : Text -> Integer
  change-disruption-policy (id) =
    let player = if id == "gp0-disruption-pause" then 0 else 1
    in let enabled = if state-get id == 1 then 0 else 1
    in let stopped = state-set "g-auto-mode" 0
    in let busy = state-set "g-busy" 1
    in fetch-get-then ("/api/magic/game/disruption-policy?player=" & show player & "&enabled=" & show enabled) step-cb

  render-g : Integer -> Integer
  render-g (x) = mount-widget-themed magic-theme (game-tree 0)

  opening : [Console] Integer
  opening = act
    let t = magic-page-init "#g-wrap{display:flex;flex-direction:column;gap:18px;width:100%;min-width:0}#g-wrap .wk-panel{flex:0 0 auto!important;min-width:0;max-width:100%}#g-wrap .wk-row{flex-wrap:wrap}#g-wrap .wk-label{display:block;min-width:0!important;max-width:100%;overflow-wrap:anywhere}#g-commitment .wk-btn,#gp0-skill,#gp1-skill,#g-queued-cards .wk-btn,#g-cleanup .wk-btn,#g-disruption .wk-btn,#g-queue-abilities .wk-btn,#g-queue-loyalty .wk-btn{min-width:0!important;max-width:100%;box-sizing:border-box;white-space:normal;overflow-wrap:anywhere;height:auto!important}"
    in let s1 = state-set sk-g-active 0
    in let ga = state-set "g-general-a" 0
    in let gb = state-set "g-general-b" 4
    in let b0 = state-set "gp0-blocks" 0
    in let b1 = state-set "gp1-blocks" 0
    in let skill0 = state-set "gp0-skill" 2
    in let skill1 = state-set "gp1-skill" 2
    in let l0 = state-set "gp0-life" 10
    in let l1 = state-set "gp1-life" 10
    in let s2 = set-render render-g
    in let h = register-handlers no-pick g-click
    in let busy = state-set "g-busy" 1
    in let rendered = render-g 0
    in fetch-get-then "/api/magic/game/state" load-game-cb
  end

Page 1
