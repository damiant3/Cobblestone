    in queue-loyalty-buttons rows (i + 1) (list-push acc (widget-button ("gql-" & show i) label))

  choose-queued-loyalty : Text -> Integer
  choose-queued-loyalty (id) =
    let rows = json-parse-rows (state-get-text "g-queue-loyalty-options")
    in let index = text-to-integer (g-suffix id 4 "")
    in if index < 0 | index >= list-length rows then 0
    else let row = list-at rows index
    in let cleared = clear-payment-draft 0
    in let player = state-set-text "g-pick-queue-player" (json-obj-field row "player")
    in let loyalty = state-set "g-pick-loyalty" 1
    in let ability = state-set-text "g-pick-ability" (json-obj-field row "index")
