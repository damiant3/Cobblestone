 Entry point for simulation runs. Compares baseline (no fixes) vs
 proposed mechanics across multiple configurations.

 We say:

Section: Entry Point

  opening : [Console] None
  opening =
    let gen-a = general-warlord
    in let gen-b = general-dawn-commander
    in let n = 100
    in let seed = 12345
    in let baseline = run-batch rules-baseline gen-a gen-b n seed
    in let proposed = run-batch rules-prismatic-proposed gen-a gen-b n (seed + 20000)
    in act
      print-line-uni "=== CodexMagic Prismatic Balance Simulation ==="
      print-line-uni ""
      print-line-uni ("Generals: " & gen-a.name & " vs " & gen-b.name)
      print-line-uni ("Games per config: " & show n)
      print-line-uni ""
      print-line-uni "--- Baseline (no fixes) ---"
      print-line-uni (format-aggregate baseline rules-baseline)
      print-line-uni ""
      print-line-uni "--- Prismatic Proposed (discard+pitch+life+cap) ---"
      print-line-uni (format-aggregate proposed rules-prismatic-proposed)
      print-line-uni ""
      print-line-uni "=== Done ==="
    end

