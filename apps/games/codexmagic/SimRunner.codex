 Entry point for simulation runs. Compares baseline (no fixes) vs
 proposed mechanics across multiple configurations.

 We say:

Section: Entry Point

  opening : [Console] Nothing
  opening =
    let gen-a = general-warlord
    in let gen-b = general-dawn-commander
    in let n = 100
    in let seed = 12345
    in let baseline = run-batch rules-baseline gen-a gen-b n seed
    in let mtg-style = run-batch rules-mtg-classic gen-a gen-b n (seed + 10000)
    in let proposed = run-batch rules-codexmagic-proposed gen-a gen-b n (seed + 20000)
    in let minimal = run-batch rules-minimal-fix gen-a gen-b n (seed + 30000)
    in let aggressive = run-batch rules-aggressive-fix gen-a gen-b n (seed + 40000)
    in act
      print-line-uni "=== CodexMagic Balance Simulation ==="
      print-line-uni ""
      print-line-uni ("Generals: " & gen-a.name & " vs " & gen-b.name)
      print-line-uni ("Games per config: " & show n)
      print-line-uni ""
      print-line-uni "--- Baseline (no fixes) ---"
      print-line-uni (format-aggregate baseline rules-baseline)
      print-line-uni ""
      print-line-uni "--- MTG Classic (London mulligan only) ---"
      print-line-uni (format-aggregate mtg-style rules-mtg-classic)
      print-line-uni ""
      print-line-uni "--- Proposed (discard+pitch+life+cap) ---"
      print-line-uni (format-aggregate proposed rules-codexmagic-proposed)
      print-line-uni ""
      print-line-uni "--- Minimal (discard+life only) ---"
      print-line-uni (format-aggregate minimal rules-minimal-fix)
      print-line-uni ""
      print-line-uni "--- Aggressive (colored+pitch1+life7+cap10) ---"
      print-line-uni (format-aggregate aggressive rules-aggressive-fix)
      print-line-uni ""
      print-line-uni "=== Done ==="
    end

