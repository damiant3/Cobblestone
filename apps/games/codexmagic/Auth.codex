Chapter: Auth
  cites CodexMagic chapter Mana

 Key format: 256-bit integers for simplicity (real deployment would
 use Ed25519 or similar). This module defines the data structures
 and verification logic. Key generation happens client-side.

 We say:

Section: Key Types

  PublicKey = record {
    key-high : Integer,
    key-low : Integer
  }

  AuthToken = record {
    account-id : Integer,
    nonce : Integer,
    signature-high : Integer,
    signature-low : Integer
  }

  AuthChallenge = record {
    nonce : Integer,
    timestamp : Integer
  }

Section: Key Derivation

  derive-public-key : Integer, Integer -> PublicKey
  derive-public-key (seed-high) (seed-low) =
    let h = hash-mix seed-high 2654435761
    in let l = hash-mix seed-low 2246822519
    in PublicKey { key-high = h, key-low = l }

  hash-mix : Integer, Integer -> Integer
  hash-mix (val) (prime) =
    let v1 = val * prime
    in let v2 = xor-int v1 (v1 / 65536)
    in let v3 = v2 * 2246822519
    in xor-int v3 (v3 / 8192)

  xor-int : Integer, Integer -> Integer
  xor-int (a) (b) = bit-xor a b

Section: Challenge-Response

  generate-challenge : Integer -> AuthChallenge
  generate-challenge (seed) =
    let nonce = hash-mix seed 1103515245
    in AuthChallenge { nonce = nonce, timestamp = seed }

  sign-challenge : Integer, Integer, Integer -> AuthToken
  sign-challenge (account-id) (nonce) (private-key-low) =
    let sig-high = hash-mix (nonce * 31 + account-id) 2654435761
    in let sig-low = hash-mix (nonce * 37 + private-key-low) 2246822519
    in AuthToken { account-id = account-id, nonce = nonce, signature-high = sig-high, signature-low = sig-low }

  verify-signature : AuthToken, PublicKey -> Boolean
  verify-signature (token) (pubkey) =
    let expected-high = hash-mix (token.nonce * 31 + token.account-id) 2654435761
    in token.signature-high == expected-high

Section: Account Key Storage

  AccountKey = record {
    account-id : Integer,
    public-key : PublicKey,
    created-at : Integer
  }

  account-key-new : Integer, PublicKey, Integer -> AccountKey
  account-key-new (id) (pk) (time) = AccountKey { account-id = id, public-key = pk, created-at = time }

  find-account-key : List AccountKey, Integer, Integer, Integer -> PublicKey
  find-account-key (keys) (account-id) (i) (len) =
    if i >= len then PublicKey { key-high = 0, key-low = 0 }
    else let k = list-at keys i
    in if k.account-id == account-id then k.public-key
    else find-account-key keys account-id (i + 1) len

Section: Session Token

  SessionToken = record {
    account-id : Integer,
    session-id : Integer,
    expires-at : Integer
  }

  create-session : Integer, Integer, Integer -> SessionToken
  create-session (account-id) (seed) (duration) =
    let session-id = hash-mix (seed + account-id * 7) 1103515245
    in SessionToken { account-id = account-id, session-id = session-id, expires-at = seed + duration }

  session-valid : SessionToken, Integer -> Boolean
  session-valid (session) (current-time) = current-time < session.expires-at

Section: Formatting

  format-public-key : PublicKey -> Text
  format-public-key (pk) = show (pk.key-high) & ":" & show (pk.key-low)

  format-auth-token : AuthToken -> Text
  format-auth-token (t) = "acct:" & show (t.account-id) & " nonce:" & show (t.nonce) & " sig:" & show (t.signature-high) & ":" & show (t.signature-low)

