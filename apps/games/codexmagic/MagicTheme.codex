Chapter: MagicTheme
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Shared theme for all CodexMagic web pages. Provides the dark-gold
 theme, CSS component strings, AJAX helpers, and reusable widget
 constructors for header, tabs, tables, forms, stat cards, badges,
 and page scaffolding. Pattern follows ExplorerTheme.

 We say:

Section: Magic Dark Theme

  magic-palette : Palette
  magic-palette = Palette {
    pal-bg = 855319, pal-fg = 13226441,
    pal-primary = 13801762, pal-secondary = 1843496,
    pal-accent = 5809919, pal-muted = 9145758,
    pal-error = 16339273, pal-success = 4175184,
    pal-warning = 15763518, pal-border = 3160125
  }

  magic-theme : Theme
  magic-theme =
    let p = magic-palette
    in let b1 = bdr 1 (p.pal-border) CornerSharp
    in let pad = exy 16 8
    in let mar = eu 2
    in let base = ws (p.pal-bg) (p.pal-fg) b1 pad mar
    in let btn-n = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-primary) (CornerRound 4)) pad mar
    in let btn-h = ws (p.pal-primary) (p.pal-bg) (bdr 1 (p.pal-primary) (CornerRound 4)) pad mar
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 4)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 4)) pad mar
    in let sep = ws (p.pal-border) (p.pal-border) bn ez (exy 0 8)
    in Theme {
      th-name = "magic-dark",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = inp-f },
      th-gauge = ss-flat (ws (p.pal-bg) (p.pal-primary) b1 (eu 2) mar),
      th-separator = ss-flat sep
    }

Section: Extra DOM Stubs

 Stubs unique to MagicTheme that are not in WebRuntime.

  dom-get-value : DomElement -> Text
  dom-get-value (el) = ""
  dom-set-value : DomElement, Text -> DomElement
  dom-set-value (el) (v) = el
  dom-prepend : DomElement, DomElement -> DomElement
  dom-prepend (parent) (child) = parent
  dom-add-class : DomElement, Text -> DomElement
  dom-add-class (el) (c) = el
  dom-remove-class : DomElement, Text -> DomElement
  dom-remove-class (el) (c) = el
  dom-set-style : DomElement, Text, Text -> DomElement
  dom-set-style (el) (k) (v) = el
  dom-set-attr : DomElement, Text, Text -> DomElement
  dom-set-attr (el) (k) (v) = el
  dom-body : DomElement
  dom-body = dom-null
  dom-remove : DomElement -> DomElement
  dom-remove (el) = el
  dom-set-aria : DomElement, Text, Text -> DomElement
  dom-set-aria (el) (k) (v) = el
  dom-set-role : DomElement, Text -> DomElement
  dom-set-role (el) (r) = el
  fetch-then : Text, Text, Text, (Text -> Integer) -> Integer
  fetch-then (url) (method) (body) (cb) = 0
  fetch-get-then : Text, (Text -> Integer) -> Integer
  fetch-get-then (url) (cb) = 0
  url-encode : Text -> Text
  url-encode (s) = s
  json-parse : Text -> List (List Text)
  json-parse (s) = []
  json-parse-obj : Text -> List Text
  json-parse-obj (s) = []
  json-obj-field : List Text, Text -> Text
  json-obj-field (obj) (key) = ""
  json-stringify : Text -> Text
  json-stringify (v) = v
  mount-widget : WidgetNode -> Integer
  mount-widget (n) = 0
  mount-widget-into : Text, WidgetNode -> Integer
  mount-widget-into (id) (n) = 0
  show-alert : Text, Text, (Text -> Integer) -> Integer
  show-alert (title) (msg) (cb) = 0
  show-confirm : Text, Text, (Text -> Integer) -> Integer
  show-confirm (title) (msg) (cb) = 0

Section: CSS Components

  css-reset : Text
  css-reset = "*{margin:0;padding:0;box-sizing:border-box}body{background:var(--bg);color:var(--fg);font-family:-apple-system,'Segoe UI',monospace;min-height:100vh}"

  css-topbar : Text
  css-topbar =
    ".topbar{display:flex;align-items:center;gap:16px;padding:8px 24px;background:var(--secondary);border-bottom:1px solid var(--border)}"
    & ".hdr-brand{font-size:18px;font-weight:bold;color:var(--accent);white-space:nowrap}"
    & ".hdr-right{margin-left:auto;display:flex;align-items:center;gap:4px;white-space:nowrap;font-size:13px}"
    & ".hdr-right a{color:var(--muted);text-decoration:none;font-size:14px;padding:4px 8px;border-radius:4px}"
    & ".hdr-right a:hover,.hdr-right a.active{color:var(--fg);background:var(--border)}"
    & ".acct-profile{display:flex;align-items:center;gap:6px;text-decoration:none;padding:3px 8px;border-radius:4px;margin-left:8px}"
    & ".acct-profile:hover,.acct-profile.active{background:var(--border)}"
    & ".acct-avatar{width:24px;height:24px;border-radius:50%;background:var(--border);color:var(--fg);display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:bold}"
    & ".acct-name{color:var(--fg);font-weight:bold}"
    & ".acct-rank{color:var(--muted);margin-left:8px}.acct-balance{color:var(--primary);font-weight:bold;margin-left:8px}"

  css-page : Text
  css-page = ".page{padding:24px;max-width:1100px;margin:0 auto}"

  css-tabs : Text
  css-tabs =
    ".tab-bar{display:flex;gap:4px;margin-bottom:20px;border-bottom:1px solid var(--border);padding-bottom:8px;flex-wrap:wrap}"
    & ".tab-btn{background:none;border:1px solid var(--border);color:var(--muted);padding:8px 16px;border-radius:4px 4px 0 0;cursor:pointer;font-size:13px}"
    & ".tab-btn:hover{color:var(--fg);background:var(--secondary)}"
    & ".tab-btn.active{background:var(--secondary);color:var(--primary);border-bottom-color:var(--secondary)}"
    & ".tab-panel{display:none}.tab-panel.active{display:block}"

  css-table : Text
  css-table =
    ".adm-table{width:100%;border-collapse:collapse;font-size:13px}"
    & ".adm-table th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--border);color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px}"
    & ".adm-table td{padding:8px 10px;border-bottom:1px solid var(--border)}"
    & ".adm-table tr:hover{background:var(--secondary)}"

  css-form : Text
  css-form =
    ".adm-form{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:16px}"
    & ".adm-form label{font-size:12px;color:var(--muted);display:flex;flex-direction:column;gap:4px}"
    & ".adm-form input,.adm-form select,.adm-form textarea{background:var(--bg);color:var(--fg);border:1px solid var(--border);padding:6px 10px;border-radius:4px;font-size:13px;min-width:120px}"

  css-stat-grid : Text
  css-stat-grid =
    ".stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:24px}"
    & ".stat-card{background:var(--secondary);border:1px solid var(--border);border-radius:8px;padding:16px}"
    & ".stat-val{font-size:28px;font-weight:bold;color:var(--primary)}"
    & ".stat-lbl{font-size:12px;color:var(--muted);margin-top:4px}"

  css-badge : Text
  css-badge =
    ".badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:bold}"
    & ".badge-admin{background:var(--error);color:#fff}"
    & ".badge-ok{background:var(--success);color:#000}"
    & ".badge-warn{background:var(--warning);color:#000}"
    & ".badge-ban{background:#6e4040;color:var(--error)}"
    & ".badge-sale{background:var(--primary);color:#000}"
    & ".badge-auction{background:var(--accent);color:#000}"

  css-msg : Text
  css-msg =
    ".msg{padding:8px 12px;border-radius:4px;margin-bottom:12px;font-size:13px;display:none}"
    & ".msg-ok{background:#1a3a1a;border:1px solid var(--success);color:var(--success)}"
    & ".msg-err{background:#3a1a1a;border:1px solid var(--error);color:var(--error)}"

  css-btn : Text
  css-btn =
    ".btn{background:var(--border);color:var(--fg);border:1px solid var(--border);padding:8px 16px;border-radius:4px;cursor:pointer;font-size:13px}"
    & ".btn:hover{background:#3d444d}"
    & ".btn-primary{background:var(--accent);color:#000;border-color:var(--accent)}"
    & ".btn-gold{background:var(--primary);color:#000;border-color:var(--primary)}"
    & ".btn-green{background:var(--success);color:#000;border-color:var(--success)}"
    & ".btn-danger{background:var(--error);color:#fff;border-color:var(--error)}"

  css-section : Text
  css-section = ".section{margin-bottom:24px}.section-title{font-size:16px;font-weight:bold;margin-bottom:12px;color:var(--fg)}"

  css-log : Text
  css-log =
    ".log-box{background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:12px;max-height:300px;overflow-y:auto;font-size:12px;font-family:monospace;color:var(--muted)}"
    & ".log-entry{padding:2px 0;border-bottom:1px solid var(--secondary)}"
    & ".log-time{color:var(--muted);margin-right:8px}.log-mint{color:var(--primary)}.log-burn{color:var(--error)}"

  css-listing-grid : Text
  css-listing-grid =
    ".listing-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}"
    & ".listing-card{background:var(--secondary);border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:border-color .2s,transform .2s}"
    & ".listing-card:hover{border-color:var(--primary);transform:translateY(-2px)}"
    & ".listing-card.auction{border-left:3px solid var(--accent)}"
    & ".listing-card.sale{border-left:3px solid var(--success)}"
    & ".listing-hdr{padding:12px 16px;display:flex;justify-content:space-between;align-items:center}"
    & ".listing-name{font-weight:bold;font-size:14px}"
    & ".listing-body{padding:0 16px 12px}"
    & ".listing-price{font-size:20px;font-weight:bold;color:var(--primary);margin-bottom:4px}"
    & ".listing-info{font-size:12px;color:var(--muted);margin-bottom:4px}"
    & ".listing-timer{font-size:12px;color:var(--warning)}"
    & ".listing-actions{padding:8px 16px 12px;display:flex;gap:8px}"
    & ".bid-input{width:80px;background:var(--bg);color:var(--fg);border:1px solid var(--border);padding:4px 8px;border-radius:4px;font-size:13px}"

  css-balance-bar : Text
  css-balance-bar =
    ".balance-bar{display:flex;justify-content:flex-end;align-items:center;gap:12px;margin-bottom:16px;padding:8px 16px;background:var(--secondary);border:1px solid var(--border);border-radius:8px}"
    & ".balance{font-size:18px;color:var(--primary);font-weight:bold}"

  css-filter-bar : Text
  css-filter-bar =
    ".filter-bar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:center}"
    & ".filter-bar select,.filter-bar input{background:var(--bg);color:var(--fg);border:1px solid var(--border);padding:6px 10px;border-radius:4px;font-size:13px}"

  css-empty : Text
  css-empty = ".empty-state{text-align:center;padding:48px;color:var(--muted)}"

  css-discount : Text
  css-discount = ".disc-tag{color:var(--success);font-weight:bold}.disc-strike{color:var(--muted);text-decoration:line-through}"

  css-feat : Text
  css-feat =
    ".feat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;max-width:900px;width:100%;margin-top:32px}"
    & ".feat-card{background:rgba(20,20,30,.7);border:1px solid var(--border);border-radius:12px;padding:28px 20px;text-align:center;transition:transform .2s,border-color .2s}"
    & ".feat-card:hover{transform:translateY(-4px);border-color:var(--primary)}"
    & ".feat-icon{font-size:36px;margin-bottom:12px;display:flex;align-items:center;justify-content:center}"
    & ".feat-name{font-size:16px;font-weight:bold;color:var(--fg);margin-bottom:8px;text-align:center}"
    & ".feat-desc{font-size:13px;color:var(--muted);line-height:1.5}"
    & ".s-features{min-height:100vh;background:linear-gradient(180deg,rgba(10,10,18,.97) 0%,#0d1117 30%,#101820 70%,#0a1628 100%),radial-gradient(ellipse at 20% 80%,rgba(14,104,171,.08) 0%,transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(211,47,47,.06) 0%,transparent 60%);padding:80px 24px;display:flex;flex-direction:column;align-items:center;justify-content:center}"

  css-landing-scroll : Text
  css-landing-scroll =
    "html{scroll-behavior:smooth;scroll-snap-type:y proximity}"
    & "body{overflow-y:scroll}"
    & ".hero-section,.s-features,.s-lore,.s-colors,.section{scroll-snap-align:start}"
    & ".section-title{font-size:clamp(22px,4vw,32px);font-weight:bold;color:#d4a017;text-align:center;margin-bottom:24px;letter-spacing:2px}"

  css-landing-hero : Text
  css-landing-hero =
    ".hero-section{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden;background:linear-gradient(180deg,#050510 0%,#0a0a1a 15%,#1a2040 40%,#2a3055 65%,#3a2a20 85%,#2a1a10 100%)}"
    & ".hero-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 120%,rgba(212,160,23,.12) 0%,transparent 55%),radial-gradient(circle at 30% 20%,rgba(100,140,200,.06) 0%,transparent 40%),radial-gradient(circle at 70% 30%,rgba(180,120,60,.05) 0%,transparent 35%);pointer-events:none}"
    & ".hero-section::after{content:'';position:absolute;top:0;left:0;right:0;height:200px;background:radial-gradient(1px 1px at 20% 30%,rgba(255,255,255,.4),transparent),radial-gradient(1px 1px at 40% 70%,rgba(255,255,255,.3),transparent),radial-gradient(1px 1px at 60% 40%,rgba(255,255,255,.35),transparent),radial-gradient(1px 1px at 80% 60%,rgba(255,255,255,.25),transparent),radial-gradient(1px 1px at 15% 80%,rgba(255,255,255,.3),transparent),radial-gradient(1px 1px at 50% 15%,rgba(255,255,255,.5),transparent),radial-gradient(1px 1px at 90% 25%,rgba(255,255,255,.2),transparent),radial-gradient(1px 1px at 35% 50%,rgba(255,255,255,.3),transparent);background-size:250px 200px;pointer-events:none;opacity:.7}"
    & ".hero-title{font-size:clamp(40px,9vw,80px);font-weight:bold;color:#d4a017;text-shadow:0 0 80px rgba(212,160,23,.4),0 0 160px rgba(212,160,23,.15),0 4px 16px rgba(0,0,0,.9);letter-spacing:8px;margin-bottom:16px;position:relative;z-index:1}"
    & ".hero-sub{font-size:clamp(14px,2.2vw,18px);color:#9ba7b4;max-width:560px;line-height:1.8;margin-bottom:40px;text-shadow:0 2px 10px rgba(0,0,0,.9);position:relative;z-index:1}"
    & ".hero-actions{display:flex;gap:16px;justify-content:center;position:relative;z-index:1}"
    & ".hero-actions .wk-btn,.hero-actions button{padding:16px 48px;background:linear-gradient(135deg,#d4a017,#c49010);color:#0a0a12;border:none;border-radius:6px;font-size:16px;font-weight:bold;letter-spacing:1px;cursor:pointer;transition:transform .2s,box-shadow .2s}"
    & ".hero-actions .wk-btn:hover,.hero-actions button:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(212,160,23,.4)}"

  css-landing-lore : Text
  css-landing-lore =
    ".s-lore{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 24px;position:relative;background:linear-gradient(180deg,#0a0e14 0%,#0d1117 20%,#111820 50%,#0f1a28 80%,#0a1220 100%)}"
    & ".s-lore::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(212,160,23,.04) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(46,125,50,.04) 0%,transparent 40%),radial-gradient(ellipse at 80% 20%,rgba(14,104,171,.04) 0%,transparent 40%);pointer-events:none}"
    & ".lore-text{max-width:680px;font-size:15px;line-height:2.2;color:#8b949e;text-align:center;position:relative;z-index:1}"
    & ".lore-text em,.lore-text .wk-lbl{color:#d4a017}"

  css-landing-colors : Text
  css-landing-colors =
    ".s-colors{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 24px;position:relative;background:linear-gradient(180deg,#0a0e16 0%,#0e1420 30%,#0c1018 70%,#080c14 100%)}"
    & ".s-colors::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 10% 50%,rgba(211,47,47,.06) 0%,transparent 30%),radial-gradient(ellipse at 30% 50%,rgba(230,168,23,.06) 0%,transparent 30%),radial-gradient(ellipse at 50% 50%,rgba(46,125,50,.06) 0%,transparent 30%),radial-gradient(ellipse at 70% 50%,rgba(14,104,171,.06) 0%,transparent 30%),radial-gradient(ellipse at 90% 50%,rgba(90,16,128,.06) 0%,transparent 30%);pointer-events:none}"
    & ".color-strip{display:flex;gap:0;max-width:800px;width:100%;border-radius:12px;overflow:hidden;height:120px;position:relative;z-index:1;box-shadow:0 8px 40px rgba(0,0,0,.4)}"
    & ".color-swatch{flex:1;display:flex;align-items:flex-end;justify-content:center;padding:12px 4px;transition:flex .4s ease;cursor:default}"
    & ".color-swatch:hover{flex:1.8}"
    & ".color-swatch .wk-lbl{font-size:11px;font-weight:bold;text-shadow:0 1px 4px rgba(0,0,0,.7);letter-spacing:1px}"
    & ".special-row{display:flex;gap:16px;max-width:800px;width:100%;margin-top:24px;position:relative;z-index:1}"
    & ".special-swatch{flex:1;height:60px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:bold;transition:transform .2s}"
    & ".special-swatch:hover{transform:scale(1.03)}"
    & ".swatch-white{background:linear-gradient(135deg,#f8f0e0,#fff,#f0e8d0);color:#333}"
    & ".swatch-black{background:linear-gradient(135deg,#1a0a2a,#2a1040);color:#bb86fc;border:1px solid #3a1a5a}"
    & ".purple-row{text-align:center;margin-top:24px;position:relative;z-index:1}"
    & ".purple-swatch{display:inline-block;width:180px;height:60px;border-radius:8px;background:linear-gradient(135deg,#5a1080,#9020d0);border:2px dashed rgba(187,134,252,.4);line-height:60px;font-size:12px;font-weight:bold;color:rgba(255,255,255,.9);transition:transform .2s}"
    & ".purple-swatch:hover{transform:scale(1.05)}"
    & ".purple-note{font-size:11px;color:#bb86fc;margin-top:8px;font-style:italic}"

  css-landing-howto : Text
  css-landing-howto =
    ".section{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 24px;position:relative;background:linear-gradient(180deg,#08101a 0%,#0c1420 25%,#101c28 50%,#0e1822 75%,#0a1018 100%)}"
    & ".section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 80%,rgba(212,160,23,.06) 0%,transparent 50%),radial-gradient(circle at 25% 30%,rgba(88,166,255,.04) 0%,transparent 35%);pointer-events:none}"
    & ".steps{display:flex;gap:40px;max-width:900px;flex-wrap:wrap;justify-content:center;margin:0 auto;position:relative;z-index:1}"
    & ".step{flex:1;min-width:180px;max-width:250px;text-align:center}"
    & ".step-num{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#d4a017,#c49010);color:#0a0a12;font-size:20px;font-weight:bold;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;box-shadow:0 4px 20px rgba(212,160,23,.3)}"
    & ".step-title{font-size:15px;font-weight:bold;color:#e6edf3;margin-bottom:8px}"
    & ".step-desc{font-size:13px;color:#8b949e;line-height:1.6}"

  css-landing-footer : Text
  css-landing-footer =
    ".footer{background:linear-gradient(180deg,#060a10,#040608);border-top:1px solid #1c2128;padding:60px 24px;text-align:center}"
    & ".footer-brand{font-size:22px;font-weight:bold;color:#d4a017;margin-bottom:8px;letter-spacing:3px}"
    & ".footer-sub{font-size:13px;color:#8b949e;margin-bottom:20px}"
    & ".footer-links{display:flex;gap:20px;justify-content:center;flex-wrap:wrap}"
    & ".footer-links a,.footer-links .wk-btn,.footer-links button{color:#58a6ff;text-decoration:none;font-size:13px;background:none;border:none;cursor:pointer;transition:color .2s}"
    & ".footer-links a:hover,.footer-links .wk-btn:hover,.footer-links button:hover{color:#79b8ff}"

  css-landing : Text
  css-landing =
    css-landing-scroll & css-landing-hero & css-landing-lore
    & css-landing-colors & css-landing-howto & css-landing-footer

  magic-layout-css : Text
  magic-layout-css =
    css-reset & css-topbar & css-page & css-tabs & css-table & css-form
    & css-stat-grid & css-badge & css-msg & css-btn & css-section & css-log
    & css-listing-grid & css-balance-bar & css-filter-bar & css-empty & css-discount
    & css-feat & css-landing

  init-magic-theme : Integer -> Integer
  init-magic-theme (x) =
    let t = inject-theme-css magic-theme
    in let style = dom-create "style"
    in let s2 = dom-set-text style magic-layout-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in 0

Section: Shared Nav Builder

  widget-nav-placeholder : WidgetNode
  widget-nav-placeholder = widget-custom "cx-header" "box:topbar" 0 0

Section: Reusable Widget Constructors

  widget-h1 : Text -> WidgetNode
  widget-h1 (txt) =
    widget-add-child (widget-custom "h1" "h1" 0 0) (widget-label "h1t" txt)

  widget-h2 : Text, Text -> WidgetNode
  widget-h2 (id) (txt) =
    widget-add-child (widget-custom id "section-title" 0 0) (widget-label (id & "t") txt)

  widget-nav : Text, Boolean -> WidgetNode
  widget-nav (active) (is-admin) = widget-nav-placeholder

  widget-tab-bar : Text, List WidgetNode -> WidgetNode
  widget-tab-bar (id) (tabs) =
    wk-attach (widget-custom id "tab-bar" 0 0) tabs 0 (list-length tabs)

  widget-tab-btn : Text, Text, Boolean -> WidgetNode
  widget-tab-btn (id) (label) (active) =
    widget-set-state (widget-add-child (widget-custom id "tab-btn" 0 0) (widget-label (id & "l") label)) (if active then 1 else 0)

  widget-tab-panel : Text, Boolean, List WidgetNode -> WidgetNode
  widget-tab-panel (id) (active) (children) =
    let base = widget-set-state (widget-custom id "tab-panel" 0 0) (if active then 1 else 0)
    in wk-attach base children 0 (list-length children)

  widget-stat-card : Text, Text, Text -> WidgetNode
  widget-stat-card (id) (value) (label) =
    widget-box id "stat-card" [
      widget-add-child (widget-custom (id & "v") "stat-val" 0 0) (widget-label (id & "vt") value),
      widget-add-child (widget-custom (id & "l") "stat-lbl" 0 0) (widget-label (id & "lt") label)
    ]

  widget-stat-grid : Text, List WidgetNode -> WidgetNode
  widget-stat-grid (id) (cards) =
    wk-attach (widget-custom id "stat-grid" 0 0) cards 0 (list-length cards)

  widget-form-field : Text, Text, Text -> WidgetNode
  widget-form-field (id) (label) (placeholder) =
    widget-box id "form-field" [
      widget-label (id & "l") label,
      widget-add-child (widget-custom (id & "i") "input" 0 0) (widget-label (id & "p") placeholder)
    ]

  widget-form-select : Text, Text, List WidgetNode -> WidgetNode
  widget-form-select (id) (label) (options) =
    let base = widget-box id "form-field" [ widget-label (id & "l") label ]
    in let sel = wk-attach (widget-custom (id & "s") "select" 0 0) options 0 (list-length options)
    in widget-add-child base sel

  widget-option : Text, Text -> WidgetNode
  widget-option (value) (label) =
    widget-add-child (widget-custom value "option" 0 0) (widget-label (value & "l") label)

  widget-table : Text, List WidgetNode, List WidgetNode -> WidgetNode
  widget-table (id) (headers) (rows) =
    let hd = wk-attach (widget-custom (id & "h") "thead" 0 0) headers 0 (list-length headers)
    in let bd = wk-attach (widget-custom (id & "b") "tbody" 0 0) rows 0 (list-length rows)
    in widget-box id "adm-table" [ hd, bd ]

  widget-th : Text, Text -> WidgetNode
  widget-th (id) (text) =
    widget-add-child (widget-custom id "th" 0 0) (widget-label (id & "t") text)

  widget-badge : Text, Text, Text -> WidgetNode
  widget-badge (id) (text) (cls) =
    widget-add-child (widget-custom id ("badge badge-" & cls) 0 0) (widget-label (id & "t") text)

  widget-msg : Text -> WidgetNode
  widget-msg (id) = widget-custom id "msg" 0 0

  widget-log-box : Text -> WidgetNode
  widget-log-box (id) = widget-custom id "log-box" 0 0

  widget-primary-button : Text, Text -> WidgetNode
  widget-primary-button (id) (txt) =
    widget-set-state (widget-button id txt) 2

  widget-listing-card : Text, Text, Text, Text, Text, Boolean -> WidgetNode
  widget-listing-card (id) (name) (card-info) (price) (seller) (is-auction) =
    widget-box id (if is-auction then "listing-card auction" else "listing-card sale") [
      widget-box (id & "h") "listing-hdr" [
        widget-label (id & "n") name,
        widget-badge (id & "b") (if is-auction then "Auction" else "Sale") (if is-auction then "auction" else "sale")
      ],
      widget-box (id & "d") "listing-body" [
        widget-add-child (widget-custom (id & "ci") "listing-info" 0 0) (widget-label (id & "cit") card-info),
        widget-add-child (widget-custom (id & "p") "listing-price" 0 0) (widget-label (id & "pt") price),
        widget-add-child (widget-custom (id & "s") "listing-info" 0 0) (widget-label (id & "st") ("Seller: " & seller))
      ]
    ]

  widget-balance-bar : Text, Text -> WidgetNode
  widget-balance-bar (id) (balance) =
    widget-box id "balance-bar" [
      widget-add-child (widget-custom (id & "b") "balance" 0 0) (widget-label (id & "bt") balance)
    ]

  widget-filter-bar : Text, List WidgetNode -> WidgetNode
  widget-filter-bar (id) (filters) =
    wk-attach (widget-custom id "filter-bar" 0 0) filters 0 (list-length filters)

Section: Page Scaffold

  magic-page : List WidgetNode -> WidgetNode
  magic-page (content) =
    widget-box "approot" "" [
      widget-nav-placeholder,
      widget-box "page" "page" content
    ]

  magic-tabbed-page : List WidgetNode, List WidgetNode -> WidgetNode
  magic-tabbed-page (tabs) (panels) =
    magic-page [
      widget-tab-bar "tabs" tabs,
      widget-box "panels" "" panels
    ]

Section: Shared Handlers

  magic-nav-widget : Text -> WidgetNode
  magic-nav-widget (active) = widget-nav-placeholder

Section: Landing Page Widgets

  widget-hero : Text, Text, List WidgetNode -> WidgetNode
  widget-hero (title) (subtitle) (actions) =
    let hero = widget-custom "hero-section" "box:hero-section" 0 0
    in let t = widget-add-child hero (widget-add-child (widget-custom "hero-title" "box:hero-title" 0 0) (widget-label "hero-title-text" title))
    in let s = widget-add-child t (widget-add-child (widget-custom "hero-sub" "box:hero-sub" 0 0) (widget-label "hero-sub-text" subtitle))
    in let btns = wk-attach (widget-custom "hero-actions" "box:hero-actions" 0 0) actions 0 (list-length actions)
    in widget-add-child s btns

  widget-feature-grid : Text, List WidgetNode -> WidgetNode
  widget-feature-grid (id) (cards) =
    wk-attach (widget-custom id "box:feat-grid" 0 0) cards 0 (list-length cards)

  widget-feature-card : Text, Text, Text, Text -> WidgetNode
  widget-feature-card (id) (icon) (title) (desc) =
    widget-box id "feat-card" [
      widget-add-child (widget-custom (id & "i") "box:feat-icon" 0 0) (widget-label (id & "it") icon),
      widget-add-child (widget-custom (id & "n") "box:feat-name" 0 0) (widget-label (id & "nt") title),
      widget-add-child (widget-custom (id & "d") "box:feat-desc" 0 0) (widget-label (id & "dt") desc)
    ]

  widget-lore-section : Text, Text, List WidgetNode -> WidgetNode
  widget-lore-section (id) (title) (paragraphs) =
    let sec = widget-custom id "box:s-lore" 0 0
    in let hdr = widget-add-child sec (widget-add-child (widget-custom (id & "t") "box:section-title" 0 0) (widget-label (id & "tt") title))
    in let body = wk-attach (widget-custom (id & "b") "box:lore-text" 0 0) paragraphs 0 (list-length paragraphs)
    in widget-add-child hdr body

  widget-color-strip : Text, List WidgetNode -> WidgetNode
  widget-color-strip (id) (swatches) =
    wk-attach (widget-custom id "box:color-strip" 0 0) swatches 0 (list-length swatches)

  widget-color-swatch : Text, Text, Text -> WidgetNode
  widget-color-swatch (id) (color-hex) (label) =
    let base = widget-custom id "color-swatch" 0 0
    in let b2 = widget-add-child base (widget-label (id & "l") label)
    in widget-add-child b2 (widget-label (id & "c") color-hex)

  widget-special-pair : Text, WidgetNode, WidgetNode -> WidgetNode
  widget-special-pair (id) (left) (right) =
    widget-box id "special-row" [left, right]

  widget-special-swatch : Text, Text, Text -> WidgetNode
  widget-special-swatch (id) (style-cls) (label) =
    widget-add-child (widget-custom id ("box:special-swatch " & style-cls) 0 0) (widget-label (id & "l") label)

  widget-purple-badge : Text, Text, Text -> WidgetNode
  widget-purple-badge (id) (label) (note) =
    widget-box id "purple-row" [
      widget-add-child (widget-custom (id & "b") "box:purple-swatch" 0 0) (widget-label (id & "bl") label),
      widget-add-child (widget-custom (id & "n") "box:purple-note" 0 0) (widget-label (id & "nt") note)
    ]

  widget-step-sequence : Text, List WidgetNode -> WidgetNode
  widget-step-sequence (id) (steps) =
    wk-attach (widget-custom id "box:steps" 0 0) steps 0 (list-length steps)

  widget-step-card : Text, Text, Text, Text -> WidgetNode
  widget-step-card (id) (num) (title) (desc) =
    widget-box id "step" [
      widget-add-child (widget-custom (id & "n") "box:step-num" 0 0) (widget-label (id & "nt") num),
      widget-add-child (widget-custom (id & "t") "box:step-title" 0 0) (widget-label (id & "tt") title),
      widget-add-child (widget-custom (id & "d") "box:step-desc" 0 0) (widget-label (id & "dt") desc)
    ]

  widget-footer : Text, Text, List WidgetNode -> WidgetNode
  widget-footer (brand) (tagline) (links) =
    let foot = widget-custom "footer" "box:footer" 0 0
    in let b = widget-add-child foot (widget-add-child (widget-custom "footer-brand" "box:footer-brand" 0 0) (widget-label "fb-text" brand))
    in let t = widget-add-child b (widget-add-child (widget-custom "footer-sub" "box:footer-sub" 0 0) (widget-label "fs-text" tagline))
    in let lnks = wk-attach (widget-custom "footer-links" "box:footer-links" 0 0) links 0 (list-length links)
    in widget-add-child t lnks

Section: Page Init Helper

  magic-page-init : Text -> Integer
  magic-page-init (page-css) =
    let t = init-magic-theme 0
    in if text-length page-css > 0
    then let style = dom-create "style"
    in let s2 = dom-set-text style page-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in 0
    else 0

