Chapter: General
  cites CodexMagic chapter Mana
  cites CodexMagic chapter Card
  cites CodexMagic chapter GameState

 General card logic: behavioral modifier evaluation, army loyalty
 queries, loyalty-cost ability checks. The General embodies the AI
 supervisor - its modifiers shape how the AI plays.

 We say:

Section: Behavioral Modifier Queries

  has-stance-override : List BehavioralModifier -> Boolean
  has-stance-override (mods) = has-stance-override-loop mods 0 (list-length mods)

  has-stance-override-loop : List BehavioralModifier, Integer, Integer -> Boolean
  has-stance-override-loop (mods) (i) (len) =
    if i >= len then False
    else when list-at mods i
      is StanceOverride (s) -> True
      is otherwise -> has-stance-override-loop mods (i + 1) len

  get-stance-override : List BehavioralModifier -> Stance
  get-stance-override (mods) = get-stance-override-loop mods 0 (list-length mods)

  get-stance-override-loop : List BehavioralModifier, Integer, Integer -> Stance
  get-stance-override-loop (mods) (i) (len) =
    if i >= len then Balanced
    else when list-at mods i
      is StanceOverride (s) -> s
      is otherwise -> get-stance-override-loop mods (i + 1) len

  has-combat-bias : List BehavioralModifier -> Boolean
  has-combat-bias (mods) = has-combat-bias-loop mods 0 (list-length mods)

  has-combat-bias-loop : List BehavioralModifier, Integer, Integer -> Boolean
  has-combat-bias-loop (mods) (i) (len) =
    if i >= len then False
    else when list-at mods i
      is CombatBiasModifier (cb) -> True
      is otherwise -> has-combat-bias-loop mods (i + 1) len

  get-combat-bias : List BehavioralModifier -> CombatBias
  get-combat-bias (mods) = get-combat-bias-loop mods 0 (list-length mods)

  get-combat-bias-loop : List BehavioralModifier, Integer, Integer -> CombatBias
  get-combat-bias-loop (mods) (i) (len) =
    if i >= len then Cautious
    else when list-at mods i
      is CombatBiasModifier (cb) -> cb
      is otherwise -> get-combat-bias-loop mods (i + 1) len

  get-aggression-threshold : List BehavioralModifier -> Integer
  get-aggression-threshold (mods) = get-aggression-threshold-loop mods 0 (list-length mods)

  get-aggression-threshold-loop : List BehavioralModifier, Integer, Integer -> Integer
  get-aggression-threshold-loop (mods) (i) (len) =
    if i >= len then 0
    else when list-at mods i
      is TriggerAggression (threshold) -> threshold
      is otherwise -> get-aggression-threshold-loop mods (i + 1) len

Section: Loyalty Checks

  can-pay-loyalty : GameState, Integer, Integer -> Boolean
  can-pay-loyalty (gs) (player-idx) (cost) =
    army-loyalty gs player-idx >= cost

  loyalty-scaled-value : GameState, Integer, Integer -> Integer
  loyalty-scaled-value (gs) (player-idx) (divisor) =
    if divisor <= 0 then 0
    else army-loyalty gs player-idx / divisor

Section: General Combat

  general-effective-power : GeneralTemplate, GeneralState -> Integer
  general-effective-power (template) (state) =
    template.power + state.power-mod

  general-effective-toughness : GeneralTemplate, GeneralState -> Integer
  general-effective-toughness (template) (state) =
    template.toughness + state.toughness-mod

  general-effective-defense : GeneralTemplate, GeneralState -> Integer
  general-effective-defense (template) (state) =
    template.defense + state.defense-mod

Section: Preset Generals

  general-warlord : GeneralTemplate
  general-warlord = make-general 0 "Warlord of the Iron Banner" (light-cost-add (light-cost-r 2) (light-cost-w 2)) 4 5 1 30 (grant-keyword keywords-none Alacrity) [] [StanceOverride Aggressive, CombatBiasModifier AlwaysAttack, TriggerAggression 15]

  general-high-sage : GeneralTemplate
  general-high-sage = make-general 1 "High Sage of the Azure Spire" (light-cost-add (light-cost-b 2) (light-cost-w 2)) 2 4 3 30 keywords-none [LoyaltyCostAbility 5 (DrawCards 2)] [StanceOverride Control, CombatBiasModifier NeverOverextend]

  general-verdant-keeper : GeneralTemplate
  general-verdant-keeper = make-general 2 "Verdant Keeper of the Old Growth" (light-cost-add (light-cost-g 2) (light-cost-w 1)) 3 6 2 35 keywords-none [LoyaltyCostAbility 3 (GainLife 4)] [StanceOverride Defensive, ResourceHoarding 5]

  general-shadow-prince : GeneralTemplate
  general-shadow-prince = make-general 3 "Shadow Prince of the Hollow Court" (light-cost-add (light-cost-p 2) (light-cost-w 2)) 3 3 0 25 (grant-keyword keywords-none Exsanguinate) [LoyaltyCostAbility 4 (DealDamage 3)] [StanceOverride Tempo, CombatBiasModifier Cautious, TriggerAggression 10]

  general-dawn-commander : GeneralTemplate
  general-dawn-commander = make-general 4 "Dawn Commander of the Radiant Host" (light-cost-add (light-cost-y 2) (light-cost-w 2)) 3 5 2 30 (grant-keyword keywords-none Vigilance) [LoyaltyCostAbility 6 (GainLife 6)] [StanceOverride Balanced, CombatBiasModifier NeverOverextend]

Section: Formatting

  format-general-state : GeneralTemplate, GeneralState, GameState, Integer -> Text
  format-general-state (template) (state) (gs) (player-idx) =
    template.name & " " &
    show (general-effective-power template state) & "/" &
    show (general-effective-toughness template state) & "/" &
    show (general-effective-defense template state) &
    " [Life: " & show (state.life) &
    " | Loyalty: " & show (army-loyalty gs player-idx) & "]"

