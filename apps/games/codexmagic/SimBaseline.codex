  rules-screw = RuleSet { mulligan-style = MulliganNone, screw-fix = ScrewFixDiscard, flood-fix = FloodFixNone, fairness = FairnessNone, turn-cap = 30, sudden-death = False, sudden-death-base = 0, sudden-death-escalation = 0, starting-hand-size = 7, starting-life = 20 }

