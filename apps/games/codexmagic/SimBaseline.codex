  rules-flood = RuleSet { mulligan-style = MulliganNone, screw-fix = ScrewFixNone, flood-fix = FloodFixPitch2Draw1, fairness = FairnessNone, turn-cap = 30, sudden-death = False, sudden-death-base = 0, sudden-death-escalation = 0, starting-hand-size = 7, starting-life = 20 }

  rules-screw-flood : RuleSet
  rules-screw-flood = RuleSet { mulligan-style = MulliganNone, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessNone, turn-cap = 30, sudden-death = False, sudden-death-base = 0, sudden-death-escalation = 0, starting-hand-size = 7, starting-life = 20 }

