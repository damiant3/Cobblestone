  rules-full-proposed = RuleSet { mulligan-style = MulliganLondon, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessLifeBonus 5, turn-cap = 12, sudden-death = True, sudden-death-base = 3, sudden-death-escalation = 1, starting-hand-size = 7, starting-life = 20 }

  rules-life3-fixes : RuleSet
  rules-life3-fixes = RuleSet { mulligan-style = MulliganLondon, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessLifeBonus 3, turn-cap = 12, sudden-death = True, sudden-death-base = 3, sudden-death-escalation = 1, starting-hand-size = 7, starting-life = 20 }

  rules-life2-fixes : RuleSet
  rules-life2-fixes = RuleSet { mulligan-style = MulliganLondon, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessLifeBonus 2, turn-cap = 12, sudden-death = True, sudden-death-base = 3, sudden-death-escalation = 1, starting-hand-size = 7, starting-life = 20 }

  rules-life4-fixes : RuleSet
  rules-life4-fixes = RuleSet { mulligan-style = MulliganLondon, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessLifeBonus 4, turn-cap = 12, sudden-death = True, sudden-death-base = 3, sudden-death-escalation = 1, starting-hand-size = 7, starting-life = 20 }

  rules-fixes-no-life : RuleSet
  rules-fixes-no-life = RuleSet { mulligan-style = MulliganLondon, screw-fix = ScrewFixDiscard, flood-fix = FloodFixPitch2Draw1, fairness = FairnessNone, turn-cap = 12, sudden-death = True, sudden-death-base = 3, sudden-death-escalation = 1, starting-hand-size = 7, starting-life = 20 }

  load-deck-to-lib : GameState, Integer, List Integer -> GameState
  load-deck-to-lib (gs) (player) (cards) = load-lib-loop gs player cards 0

  load-lib-loop : GameState, Integer, List Integer, Integer -> GameState
  load-lib-loop (gs) (player) (cards) (i) =
    if i >= list-length cards then gs
    else let p = get-player gs player
    in let p2 = PlayerState { general = p.general, prismatic = p.prismatic, library = list-push (p.library) (list-at cards i), hand = p.hand, graveyard = p.graveyard, exile = p.exile, gem-drop-used = p.gem-drop-used }
    in let gs2 = set-player gs player p2
    in load-lib-loop gs2 player cards (i + 1)

  shuffle-list : List Integer, Integer -> List Integer
  shuffle-list (cards) (seed) = fy-shuffle cards seed (list-length cards - 1)

  fy-shuffle : List Integer, Integer, Integer -> List Integer
  fy-shuffle (cards) (seed) (i) =
    if i <= 0 then cards
    else let r = rng-new (seed + i * 37)
    in let j = rng-mod (rng-value r) (i + 1)
    in let vi = list-at cards i
    in let vj = list-at cards j
    in let c2 = list-set-at cards i vj
    in let c3 = list-set-at c2 j vi
    in fy-shuffle c3 (seed + i * 13) (i - 1)

Section: Tournament Infrastructure

  MatchResult = record {
    winner-idx : Integer,
    wins-a : Integer,
    wins-b : Integer,
    total-games : Integer
  }

  play-match : List CardTemplate, List Integer, List Integer, Integer, Integer -> MatchResult
  play-match (pool) (deck-a) (deck-b) (first-to) (seed) =
    play-match-loop pool deck-a deck-b first-to seed 0 0 0

  play-match-loop : List CardTemplate, List Integer, List Integer, Integer, Integer, Integer, Integer, Integer -> MatchResult
  play-match-loop (pool) (deck-a) (deck-b) (first-to) (seed) (wa) (wb) (game-num) =
    if wa >= first-to then MatchResult { winner-idx = 0, wins-a = wa, wins-b = wb, total-games = game-num }
    else if wb >= first-to then MatchResult { winner-idx = 1, wins-a = wa, wins-b = wb, total-games = game-num }
    else let gs-seed = seed + game-num * 131
    in let gs = game-new pool vanilla-general vanilla-general
    in let gs2 = load-deck-to-lib gs 0 (shuffle-list deck-a (gs-seed + 1))
    in let gs3 = load-deck-to-lib gs2 1 (shuffle-list deck-b (gs-seed + 2))
    in let gs4 = draw-n-sim gs3 0 7
    in let gs5 = draw-n-sim gs4 1 7
    in let result = run-game gs5 30
    in if result.game-over then
      if result.winner == 0 then play-match-loop pool deck-a deck-b first-to seed (wa + 1) wb (game-num + 1)
      else play-match-loop pool deck-a deck-b first-to seed wa (wb + 1) (game-num + 1)
    else play-match-loop pool deck-a deck-b first-to seed wa wb (game-num + 1)

  keyword-name-by-idx : Integer -> Text
  keyword-name-by-idx (i) =
    if i == 0 then "Alacrity"
    else if i == 1 then "FStrike"
    else if i == 2 then "DTouch"
    else if i == 3 then "Flying"
    else if i == 4 then "DrainLife"
    else if i == 5 then "Splash"
    else if i == 6 then "Vigilance"
    else "???"

  get-deck-for-keyword : Integer -> List Integer
  get-deck-for-keyword (kw-idx) =
    let card-id = kw-idx + 5
    in make-mono-deck card-id

  make-mono-deck : Integer -> List Integer
  make-mono-deck (card-id) = build-mono card-id 0 []

  build-mono : Integer, Integer, List Integer -> List Integer
  build-mono (card-id) (i) (acc) =
    if i < 20 then build-mono card-id (i + 1) (list-push acc 0)
    else if i < 40 then build-mono card-id (i + 1) (list-push acc card-id)
    else acc

Section: Bracket Seeding

  shuffle-seeds : Integer -> List Integer
  shuffle-seeds (seed) =
    let base = [0, 1, 2, 3, 4, 5, 6]
    in fy-shuffle base seed 6

Section: Single Elimination Tournament

  TourneyResult = record {
    champion : Integer,
    finalist : Integer,
    log : Text
  }

  run-tournament : List CardTemplate, Integer -> TourneyResult
  run-tournament (pool) (seed) =
    let seeds = shuffle-seeds seed
    in let s0 = list-at seeds 0
    in let s1 = list-at seeds 1
    in let s2 = list-at seeds 2
    in let s3 = list-at seeds 3
    in let s4 = list-at seeds 4
    in let s5 = list-at seeds 5
    in let s6 = list-at seeds 6
    in let q1 = play-match pool (get-deck-for-keyword s0) (get-deck-for-keyword s1) 3 (seed + 1000)
    in let q2 = play-match pool (get-deck-for-keyword s2) (get-deck-for-keyword s3) 3 (seed + 2000)
    in let q3 = play-match pool (get-deck-for-keyword s4) (get-deck-for-keyword s5) 3 (seed + 3000)
    in let w1 = if q1.winner-idx == 0 then s0 else s1
    in let w2 = if q2.winner-idx == 0 then s2 else s3
    in let w3 = if q3.winner-idx == 0 then s4 else s5
    in let sf1 = play-match pool (get-deck-for-keyword w1) (get-deck-for-keyword w2) 3 (seed + 4000)
    in let sf2 = play-match pool (get-deck-for-keyword w3) (get-deck-for-keyword s6) 3 (seed + 5000)
    in let f1 = if sf1.winner-idx == 0 then w1 else w2
    in let f2 = if sf2.winner-idx == 0 then w3 else s6
    in let final = play-match pool (get-deck-for-keyword f1) (get-deck-for-keyword f2) 3 (seed + 6000)
    in let champ = if final.winner-idx == 0 then f1 else f2
    in let runner = if final.winner-idx == 0 then f2 else f1
    in let log = "Q: " & keyword-name-by-idx s0 & " vs " & keyword-name-by-idx s1 & " " & show (q1.wins-a) & "-" & show (q1.wins-b) & " | " & keyword-name-by-idx s2 & " vs " & keyword-name-by-idx s3 & " " & show (q2.wins-a) & "-" & show (q2.wins-b) & " | " & keyword-name-by-idx s4 & " vs " & keyword-name-by-idx s5 & " " & show (q3.wins-a) & "-" & show (q3.wins-b) & " SF: " & keyword-name-by-idx w1 & " vs " & keyword-name-by-idx w2 & " " & show (sf1.wins-a) & "-" & show (sf1.wins-b) & " | " & keyword-name-by-idx w3 & " vs " & keyword-name-by-idx s6 & " " & show (sf2.wins-a) & "-" & show (sf2.wins-b) & " F: " & keyword-name-by-idx f1 & " vs " & keyword-name-by-idx f2 & " " & show (final.wins-a) & "-" & show (final.wins-b)
    in TourneyResult { champion = champ, finalist = runner, log = log }

Section: Double Elimination

  DoubleElimResult = record {
    champion : Integer,
    finalist : Integer,
    third : Integer,
    wb-champ-from-winners : Boolean,
    log : Text
  }

  match-kw : List CardTemplate, Integer, Integer, Integer, Integer -> MatchResult
  match-kw (pool) (a) (b) (ft) (seed) = play-match pool (get-deck-for-keyword a) (get-deck-for-keyword b) ft seed

  kw : Integer -> Text
  kw (i) = keyword-name-by-idx i

  ml : Integer, Integer, MatchResult -> Text
  ml (a) (b) (r) = kw a & "v" & kw b & " " & show (r.wins-a) & "-" & show (r.wins-b)

  run-double-elim : List CardTemplate, Integer -> DoubleElimResult
  run-double-elim (pool) (seed) =
    let seeds = shuffle-seeds seed
    in let s0 = list-at seeds 0
    in let s1 = list-at seeds 1
    in let s2 = list-at seeds 2
    in let s3 = list-at seeds 3
    in let s4 = list-at seeds 4
    in let s5 = list-at seeds 5
    in let s6 = list-at seeds 6
    in let wq1 = match-kw pool s0 s1 2 (seed + 1000)
    in let wq2 = match-kw pool s2 s3 2 (seed + 2000)
    in let wq3 = match-kw pool s4 s5 2 (seed + 3000)
    in let ww1 = if wq1.winner-idx == 0 then s0 else s1
    in let wl1 = if wq1.winner-idx == 0 then s1 else s0
    in let ww2 = if wq2.winner-idx == 0 then s2 else s3
    in let wl2 = if wq2.winner-idx == 0 then s3 else s2
    in let ww3 = if wq3.winner-idx == 0 then s4 else s5
    in let wl3 = if wq3.winner-idx == 0 then s5 else s4
    in let wsf1 = match-kw pool ww1 ww2 2 (seed + 4000)
    in let wsf2 = match-kw pool ww3 s6 2 (seed + 5000)
    in let wsfw1 = if wsf1.winner-idx == 0 then ww1 else ww2
    in let wsfl1 = if wsf1.winner-idx == 0 then ww2 else ww1
    in let wsfw2 = if wsf2.winner-idx == 0 then ww3 else s6
    in let wsfl2 = if wsf2.winner-idx == 0 then s6 else ww3
    in let wbf = match-kw pool wsfw1 wsfw2 2 (seed + 6000)
    in let wb-champ = if wbf.winner-idx == 0 then wsfw1 else wsfw2
    in let wb-loser = if wbf.winner-idx == 0 then wsfw2 else wsfw1
    in let lr1 = match-kw pool wl1 wl2 2 (seed + 7000)
    in let lr1w = if lr1.winner-idx == 0 then wl1 else wl2
    in let lr2 = match-kw pool wl3 lr1w 2 (seed + 8000)
    in let lr2w = if lr2.winner-idx == 0 then wl3 else lr1w
    in let lsf1 = match-kw pool wsfl1 lr2w 2 (seed + 9000)
    in let lsf1w = if lsf1.winner-idx == 0 then wsfl1 else lr2w
    in let lsf2 = match-kw pool wsfl2 lsf1w 2 (seed + 10000)
    in let lsf2w = if lsf2.winner-idx == 0 then wsfl2 else lsf1w
    in let lbf = match-kw pool wb-loser lsf2w 2 (seed + 11000)
    in let lb-champ = if lbf.winner-idx == 0 then wb-loser else lsf2w
    in let gf1 = match-kw pool wb-champ lb-champ 2 (seed + 12000)
    in if gf1.winner-idx == 0 then
      let log = "WB: " & ml s0 s1 wq1 & " " & ml s2 s3 wq2 & " " & ml s4 s5 wq3 & " WSF:" & ml ww1 ww2 wsf1 & " " & ml ww3 s6 wsf2 & " WBF:" & ml wsfw1 wsfw2 wbf & " LB:" & ml wl1 wl2 lr1 & " " & ml wl3 lr1w lr2 & " " & ml wsfl1 lr2w lsf1 & " " & ml wsfl2 lsf1w lsf2 & " LBF:" & ml wb-loser lsf2w lbf & " GF:" & ml wb-champ lb-champ gf1
      in DoubleElimResult { champion = wb-champ, finalist = lb-champ, third = wb-loser, wb-champ-from-winners = True, log = log }
    else let gf2 = match-kw pool wb-champ lb-champ 2 (seed + 13000)
    in if gf2.winner-idx == 0 then
      let log = "WB: " & ml s0 s1 wq1 & " " & ml s2 s3 wq2 & " " & ml s4 s5 wq3 & " WSF:" & ml ww1 ww2 wsf1 & " " & ml ww3 s6 wsf2 & " WBF:" & ml wsfw1 wsfw2 wbf & " LB:" & ml wl1 wl2 lr1 & " " & ml wl3 lr1w lr2 & " " & ml wsfl1 lr2w lsf1 & " " & ml wsfl2 lsf1w lsf2 & " LBF:" & ml wb-loser lsf2w lbf & " GF:" & ml wb-champ lb-champ gf1 & " GF2:" & ml wb-champ lb-champ gf2
      in DoubleElimResult { champion = wb-champ, finalist = lb-champ, third = wb-loser, wb-champ-from-winners = True, log = log }
    else let log = "WB: " & ml s0 s1 wq1 & " " & ml s2 s3 wq2 & " " & ml s4 s5 wq3 & " WSF:" & ml ww1 ww2 wsf1 & " " & ml ww3 s6 wsf2 & " WBF:" & ml wsfw1 wsfw2 wbf & " LB:" & ml wl1 wl2 lr1 & " " & ml wl3 lr1w lr2 & " " & ml wsfl1 lr2w lsf1 & " " & ml wsfl2 lsf1w lsf2 & " LBF:" & ml wb-loser lsf2w lbf & " GF:" & ml wb-champ lb-champ gf1 & " GF2:" & ml wb-champ lb-champ gf2
    in DoubleElimResult { champion = lb-champ, finalist = wb-champ, third = wb-loser, wb-champ-from-winners = False, log = log }

Section: Entry Point

  opening : [Console] None
  opening =
    let pool = [base-gem, creature-1-1, creature-1-2, creature-2-1, creature-2-2, creature-1-1-haste, creature-2-1-firststrike, creature-1-1-deathtouch, creature-2-2-flying, creature-2-2-lifelink, creature-3-3-trample, creature-2-2-vigilance]
    in let t = run-double-elim pool 4000
    in let from-wb = if t.wb-champ-from-winners then "WB" else "LB"
    in act
      print-line-uni "=== Double Elim Tournament ==="
      print-line-uni ("1st: " & kw (t.champion) & " (" & from-wb & ") 2nd: " & kw (t.finalist) & " 3rd: " & kw (t.third))
      print-line-uni (t.log)
      print-line-uni "=== Done ==="
    end

Page 1
