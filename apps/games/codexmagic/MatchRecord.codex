Chapter: MatchRecord
  cites CodexMagic chapter Mana
  cites CodexMagic chapter Card
  cites CodexMagic chapter GameState

 Match recording for audit, replay, and blockchain posting. Every
 game action is logged. Match records are hashed and posted on-chain.

 We say:

Section: Action Log

  GameAction =
   | ActPlayGem (Integer) (Integer)
   | ActCastSpell (Integer) (Integer)
   | ActAttack (Integer)
   | ActBlock (Integer) (Integer)
   | ActDamageResolved
   | ActDrawCard (Integer)
   | ActTurnStart (Integer)
   | ActGameOver (Integer)

  action-name : GameAction -> Text
  action-name (a) =
    when a
      is ActPlayGem (player) (card) -> "PlayGem"
      is ActCastSpell (player) (card) -> "CastSpell"
      is ActAttack (perm) -> "Attack"
      is ActBlock (blocker) (attacker) -> "Block"
      is ActDamageResolved -> "Damage"
      is ActDrawCard (player) -> "Draw"
      is ActTurnStart (turn) -> "TurnStart"
      is ActGameOver (winner) -> "GameOver"

Section: Match Record

  MatchRecord = record {
    match-id : Integer,
    player-a : Integer,
    player-b : Integer,
    general-a-id : Integer,
    general-b-id : Integer,
    action-count : Integer,
    winner : Integer,
    turns-played : Integer,
    final-life-a : Integer,
    final-life-b : Integer,
    final-loyalty-a : Integer,
    final-loyalty-b : Integer
  }

  match-record-new : Integer, Integer, Integer, Integer, Integer -> MatchRecord
  match-record-new (match-id) (player-a) (player-b) (gen-a) (gen-b) = MatchRecord { match-id = match-id, player-a = player-a, player-b = player-b, general-a-id = gen-a, general-b-id = gen-b, action-count = 0, winner = -1, turns-played = 0, final-life-a = 0, final-life-b = 0, final-loyalty-a = 0, final-loyalty-b = 0 }

  record-action-count : MatchRecord -> MatchRecord
  record-action-count (mr) = MatchRecord { match-id = mr.match-id, player-a = mr.player-a, player-b = mr.player-b, general-a-id = mr.general-a-id, general-b-id = mr.general-b-id, action-count = mr.action-count + 1, winner = mr.winner, turns-played = mr.turns-played, final-life-a = mr.final-life-a, final-life-b = mr.final-life-b, final-loyalty-a = mr.final-loyalty-a, final-loyalty-b = mr.final-loyalty-b }

  finalize-record : MatchRecord, GameState -> MatchRecord
  finalize-record (mr) (gs) =
    let p0 = get-player gs 0
    in let p1 = get-player gs 1
    in MatchRecord { match-id = mr.match-id, player-a = mr.player-a, player-b = mr.player-b, general-a-id = mr.general-a-id, general-b-id = mr.general-b-id, action-count = mr.action-count, winner = gs.winner, turns-played = gs.turn-number, final-life-a = p0.general.life, final-life-b = p1.general.life, final-loyalty-a = army-loyalty gs 0, final-loyalty-b = army-loyalty gs 1 }

Section: Formatting

  format-match-record : MatchRecord -> Text
  format-match-record (mr) =
    "Match #" & show (mr.match-id) & " | Turns: " & show (mr.turns-played) & " | Winner: P" & show (mr.winner) & " | Life: " & show (mr.final-life-a) & "/" & show (mr.final-life-b) & " | Actions: " & show (mr.action-count)

