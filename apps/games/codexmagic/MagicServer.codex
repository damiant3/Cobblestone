 We say:

Section: Server State

  MagicStore = record {
    game : GameState,
    turn : SupervisedTurn,
    orders : List Posture,
    game-active : Boolean,
    pause-active : Boolean,
    pause-remaining : Integer,
    templates : List CardTemplate,
    generals : List GeneralTemplate,
    accounts : List PlayerAccount,
    num-accounts : Integer,
    tokens : List CardToken,
    ledger : ManaCoinLedger,
    current-season : Season,
    match-record : MatchRecord,
    account-keys : List AccountKey,
    next-nonce : Integer,
    platform : PlatformAuthority,
    next-token-id : Integer,
    total-minted : Integer,
    total-burned : Integer,
    coin-for-sale : Integer,
    coin-price : Integer
  }

  MagicStep = record {
    store : MagicStore,
    resp : Text
  }

  magic-store-new : MagicStore
  magic-store-new =
    let s1 = season-new 2026 3 "Age of Embers"
    in let s1b = season-activate s1
    in let game = game-new full-card-pool general-warlord general-dawn-commander
    in MagicStore { pause-active = False, pause-remaining = 0, game = game, turn = supervised-start game, orders = [posture-default, posture-default], game-active = False, templates = full-card-pool, generals = [general-warlord, general-high-sage, general-verdant-keeper, general-shadow-prince, general-dawn-commander], accounts = [], num-accounts = 0, tokens = [], ledger = ledger-new 100, current-season = s1b, match-record = match-record-new 0 0 0 0 0, account-keys = [], next-nonce = 1000, platform = platform-new, next-token-id = 1000, total-minted = 0, total-burned = 0, coin-for-sale = 0, coin-price = 1 }

  store-set : MagicStore, GameState, Boolean, List PlayerAccount, Integer, List CardToken, ManaCoinLedger, PlatformAuthority, Integer -> MagicStore
  store-set (s) (g) (ga) (accts) (na) (toks) (led) (plat) (ntid) = MagicStore { pause-active = s.pause-active, pause-remaining = s.pause-remaining, game = g, turn = s.turn, orders = s.orders, game-active = ga, templates = s.templates, generals = s.generals, accounts = accts, num-accounts = na, tokens = toks, ledger = led, current-season = s.current-season, match-record = s.match-record, account-keys = s.account-keys, next-nonce = s.next-nonce, platform = plat, next-token-id = ntid, total-minted = s.total-minted, total-burned = s.total-burned, coin-for-sale = s.coin-for-sale, coin-price = s.coin-price }

  update-store-game : MagicStore, GameState, Boolean -> MagicStore
  update-store-game (store) (gs) (active) = store-set store gs active (store.accounts) (store.num-accounts) (store.tokens) (store.ledger) (store.platform) (store.next-token-id)

  update-store-ledger : MagicStore, ManaCoinLedger -> MagicStore
  update-store-ledger (store) (new-ledger) = store-set store (store.game) (store.game-active) (store.accounts) (store.num-accounts) (store.tokens) new-ledger (store.platform) (store.next-token-id)

  update-store-tokens : MagicStore, List CardToken, ManaCoinLedger -> MagicStore
  update-store-tokens (store) (new-tokens) (new-ledger) = store-set store (store.game) (store.game-active) (store.accounts) (store.num-accounts) new-tokens new-ledger (store.platform) (store.next-token-id)

  update-store-accounts : MagicStore, List PlayerAccount, Integer -> MagicStore
  update-store-accounts (store) (new-accts) (new-count) = store-set store (store.game) (store.game-active) new-accts new-count (store.tokens) (store.ledger) (store.platform) (store.next-token-id)

  update-store-platform : MagicStore, PlatformAuthority -> MagicStore
  update-store-platform (store) (new-platform) = store-set store (store.game) (store.game-active) (store.accounts) (store.num-accounts) (store.tokens) (store.ledger) new-platform (store.next-token-id)

Section: Response Helpers

  magic-respond-json : MagicStore, Text -> MagicStep
  magic-respond-json (store) (body) = MagicStep { store = store, resp = body }

  magic-respond-error : MagicStore, Text -> MagicStep
  magic-respond-error (store) (msg) = MagicStep { store = store, resp = "{\"error\":" & jstr msg & "}" }

  magic-respond-not-found : MagicStore -> MagicStep
  magic-respond-not-found (store) = MagicStep { store = store, resp = "{\"error\":\"not found\"}" }

Section: Request Dispatch

  dispatch-request : MagicStore, Text -> MagicStep
  dispatch-request (store) (line) =
    let path = extract-path line
    in if text-starts-with path "/api/magic/game/" then handle-game store line path
    else if text-starts-with path "/api/magic/pool" then handle-pool store
    else if text-starts-with path "/api/magic/deck/" then handle-deck store line path
    else if text-starts-with path "/api/magic/store/" then handle-store store line path
    else if text-starts-with path "/api/magic/auth/" then handle-auth store line path
    else if text-starts-with path "/api/magic/account/" then handle-account store line path
    else if text-starts-with path "/api/magic/queue/" then handle-queue store line path
    else if text-starts-with path "/api/magic/match/" then handle-match store line path
    else if text-starts-with path "/api/magic/season" then handle-season store
    else if text-starts-with path "/api/magic/clan/" then handle-clan store line path
    else if text-starts-with path "/api/magic/admin/" then handle-admin store line path
    else if text-starts-with path "/api/magic/market/" then handle-market store line path
    else if text-starts-with path "/api/magic/state-dump" then handle-state-dump store
    else if text-starts-with path "/api/magic/rules" then handle-rules store
    else if text-starts-with path "/api/magic/status" then handle-magic-status store
    else magic-respond-not-found store

Section: Game Handlers

  pause-store : MagicStore, Boolean, Integer -> MagicStore
  pause-store (store) (active) (remaining) =
    let fresh = update-store-game store (store.game) (store.game-active)
    in __record-set (__record-set fresh "pause-active" active) "pause-remaining" remaining

  choice-remaining : MagicStore, Integer, Integer -> Integer
  choice-remaining (store) (deadline) (now) =
    if store.pause-active then store.pause-remaining
    else if now < 0 | deadline <= now then 0 else deadline - now

  handle-game-pause-at : MagicStore, Integer -> MagicStep
  handle-game-pause-at (store) (now) =
    if store.game-active == False | (store.game).game-over then magic-respond-error store "no active game"
    else if store.pause-active then handle-game-state store
    else let turn = store.turn
    in let window = ((store.game).disruption).window
    in let deadline = if response-window-pending window then window.deadline else if commitment-pending (turn.commitment) then (turn.commitment).deadline else if (turn.combat-choice).pending then (turn.combat-choice).deadline else 0
    in handle-game-state (pause-store store True (choice-remaining store deadline now))

  handle-game-resume-at : MagicStore, Integer -> MagicStep
  handle-game-resume-at (store) (now) =
    if store.pause-active == False then handle-game-state store
    else let turn = store.turn
    in let pending = turn.commitment
    in let combat = turn.combat-choice
    in let state = (store.game).disruption
    in let window = state.window
    in let deadline = if now < 0 then 0 else now + store.pause-remaining
    in let choice = Commitment { card = pending.card, rays = pending.rays, nonce = pending.nonce, deadline = (if commitment-pending pending then deadline else pending.deadline), choices = pending.choices, recommended = pending.recommended, all-rays = pending.all-rays, source = pending.source, ability = pending.ability }
    in let cc = CombatChoice { pending = combat.pending, nonce = combat.nonce, deadline = (if combat.pending then deadline else combat.deadline) }
    in let wc = SpellWindow { activation = window.activation, card = window.card, caster = window.caster, targets = window.targets, hardness = window.hardness, manual = window.manual, nonce = window.nonce, deadline = deadline, choices = window.choices }
    in let gs = if response-window-pending window then game-with-disruption (store.game) (DisruptionState { seed = state.seed, index = state.index, window = wc, result = state.result }) else store.game
    in let restored = SupervisedTurn { combat-cantrip-stage = turn.combat-cantrip-stage, manual-override = turn.manual-override, game = gs, combat = turn.combat, stage = turn.stage, paused = turn.paused, commitment = choice, held-cards = turn.held-cards, combat-choice = cc, used-abilities = turn.used-abilities }
    in let resumed = store-turn (pause-store store False 0) restored (store.game-active)
    in if turn.paused | commitment-pending pending | combat.pending | response-window-pending window then handle-game-state resumed
    else handle-game-step resumed False

  handle-game : MagicStore, Text, Text -> MagicStep
  handle-game (store) (line) (path) =
    let pending = (store.turn).commitment
    in let combat = (store.turn).combat-choice
    in let window = ((store.game).disruption).window
    in if text-starts-with path "/api/magic/game/new" | text-starts-with path "/api/magic/game/cancel" then handle-game-current store line path
    else if path == "/api/magic/game/pause" | path == "/api/magic/game/resume" | path == "/api/magic/game/override" | store.pause-active then handle-game-current store line path
    else let now = if commitment-pending pending | combat.pending | response-window-pending window then game-clock-ms else 0
    in if response-window-pending window & (now < 0 | window.deadline <= 0 | now >= window.deadline) then handle-game-disruption-at store (window.nonce) (0 - 1) now
    else if commitment-pending pending & (now < 0 | pending.deadline <= 0 | now >= pending.deadline) then handle-game-commitment-at store (pending.nonce) False now
    else if combat.pending & (now < 0 | combat.deadline <= 0 | now >= combat.deadline) then handle-game-combat-choice-at store (combat.nonce) True now
    else handle-game-current store line path

  handle-game-current : MagicStore, Text, Text -> MagicStep
  handle-game-current (store) (line) (path) =
    if path == "/api/magic/game/pause" then handle-game-pause-at store game-clock-ms
    else if path == "/api/magic/game/resume" then handle-game-resume-at store game-clock-ms
    else if path == "/api/magic/game/override" then handle-game-override-at store (game-query-id (extract-query-param line "nonce")) game-clock-ms
    else if text-starts-with path "/api/magic/game/new" then handle-game-new store line
    else if text-starts-with path "/api/magic/game/cancel" then handle-game-cancel store
    else if path == "/api/magic/game/discard" then handle-game-discard store line
    else if text-starts-with path "/api/magic/game/combat-policy" then handle-game-combat-policy store line
    else if text-starts-with path "/api/magic/game/sacrifice-policy" then handle-game-sacrifice-policy store line
    else if text-starts-with path "/api/magic/game/disruption-policy" then handle-game-disruption-policy store line
    else if path == "/api/magic/game/response-targets" then handle-game-response-targets store line
    else if path == "/api/magic/game/response-ability-targets" then handle-game-response-ability-targets store line
    else if path == "/api/magic/game/response-ability" then handle-game-response-ability store line
    else if text-starts-with path "/api/magic/game/disruption" then handle-game-disruption store line
    else if path == "/api/magic/game/queue-card-targets" then handle-game-queue-card-targets store line
    else if path == "/api/magic/game/queue-card" then handle-game-queue-card store line
    else if path == "/api/magic/game/queue-loyalty-targets" then handle-game-queue-loyalty-targets store line
    else if path == "/api/magic/game/queue-loyalty" then handle-game-queue-loyalty store line
    else if text-starts-with path "/api/magic/game/queue-targets" then handle-game-queue-targets store line
    else if text-starts-with path "/api/magic/game/queue-ability" then handle-game-queue-ability store line
    else if text-starts-with path "/api/magic/game/combat-choice" then handle-game-combat-choice store line
    else if text-starts-with path "/api/magic/game/card-order" then handle-game-card-order store line
    else if text-starts-with path "/api/magic/game/commitment-policy" then handle-game-commitment-policy store line
    else if text-starts-with path "/api/magic/game/commitment" then handle-game-commitment store line
    else if text-starts-with path "/api/magic/game/step" then handle-game-step store (extract-query-param line "resume" == "1")
    else if text-starts-with path "/api/magic/game/posture" then handle-game-posture store line
    else if path == "/api/magic/game/skill" then handle-game-skill store line
    else if text-starts-with path "/api/magic/game/freeze" then handle-game-freeze store line
    else if text-starts-with path "/api/magic/game/spells" then handle-game-spells store line
    else if text-starts-with path "/api/magic/game/mana" then handle-game-mana store line
    else if text-starts-with path "/api/magic/game/payment-mode" then handle-game-payment-mode store line
    else if text-starts-with path "/api/magic/game/fluorescence" then handle-game-fluorescence store line
    else if text-starts-with path "/api/magic/game/loyalty" then handle-game-loyalty store line
    else if text-starts-with path "/api/magic/game/ability-targets" then handle-game-ability-targets store line
    else if text-starts-with path "/api/magic/game/activate" then handle-game-activate store line
    else if text-starts-with path "/api/magic/game/blocks" then handle-game-block-policy store line
    else if text-starts-with path "/api/magic/game/play" then handle-game-play store line
    else if text-starts-with path "/api/magic/game/target-policy" then handle-game-target-policy store line
    else if text-starts-with path "/api/magic/game/targets" then handle-game-targets store line
    else if text-starts-with path "/api/magic/game/target" then handle-game-target store line
    else if text-starts-with path "/api/magic/game/attack" then handle-game-attack store line
    else if text-starts-with path "/api/magic/game/block" then handle-game-block store line
    else if text-starts-with path "/api/magic/game/state" then handle-game-state store
    else magic-respond-not-found store

  handle-game-cancel : MagicStore -> MagicStep
  handle-game-cancel (store) =
    let idle = game-new (store.templates) (get-general (store.game) 0) (get-general (store.game) 1)
    in handle-game-state (store-fresh-game store idle False)

  handle-game-discard : MagicStore, Text -> MagicStep
  handle-game-discard (store) (line) =
    let card = game-query-id (extract-query-param line "card")
    in if store.pause-active then magic-respond-error store "game is paused"
    else if store.game-active == False | card < 0 | supervised-discard-ready (store.turn) card == False then magic-respond-error store "card cannot be discarded at this pause"
    else handle-game-state (store-turn store (supervised-discard (store.turn) card) True)

  cleanup-json : MagicStore -> Text
  cleanup-json (store) =
    let turn = store.turn
    in let gs = store.game
    in if store.game-active == False | gs.game-over | turn.stage /= ai-stage-end | turn.paused == False | cleanup-excess gs == 0 then "null"
    else "{\"count\":" & show (cleanup-excess gs) & ",\"manual\":" & jbool ((list-at (store.orders) (gs.active-player)).spell-policy == ManualSpells) & ",\"cards\":[" & text-concat-list (cleanup-cards-json gs ((get-player gs (gs.active-player)).hand) 0 []) & "]}"

  cleanup-cards-json : GameState, List Integer, Integer, List Text -> List Text
  cleanup-cards-json (gs) (hand) (i) (chunks) =
    if i >= list-length hand then chunks
    else let card = list-at hand i
    in let row = (if i == 0 then "" else ",") & "{\"id\":" & show card & ",\"name\":" & jstr ((get-card-template gs card).name) & "}"
    in cleanup-cards-json gs hand (i + 1) (list-push chunks row)

  standing-target-orders : List TargetOrder, Integer, List TargetOrder -> List TargetOrder
  standing-target-orders (orders) (i) (acc) =
    if i >= list-length orders then acc
    else let order = list-at orders i
    in let keep = when order is PriorityPermanent (id) -> False is otherwise -> True
    in standing-target-orders orders (i + 1) (if keep then list-push acc order else acc)

  fresh-game-posture : Posture -> Posture
  fresh-game-posture (p) = Posture { skill = p.skill, stance = p.stance, primary-targets = standing-target-orders (p.primary-targets) 0 [], phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause }

  store-fresh-game : MagicStore, GameState, Boolean -> MagicStore
  store-fresh-game (store) (gs) (active) =
    let next = store-turn (pause-store store False 0) (supervised-start gs) active
    in __record-set next "orders" (for p in store.orders -> fresh-game-posture p)

  handle-game-new : MagicStore, Text -> MagicStep
  handle-game-new (store) (line) =
    let ar = extract-query-param line "general-a"
    in let br = extract-query-param line "general-b"
    in let aid = if ar == "" then 0 else game-query-id ar
    in let bid = if br == "" then 4 else game-query-id br
    in let sr = extract-query-param line "seed"
    in let seed = if sr == "" then 0 else game-query-id sr
    in if seed < 0 then magic-respond-error store "invalid contest seed"
    else if list-contains (store.generals) (\g -> g.id == aid) == False | list-contains (store.generals) (\g -> g.id == bid) == False then magic-respond-error store "unknown General"
    else let gen-a = get-general-by-id (store.generals) aid
    in let gen-b = get-general-by-id (store.generals) bid
    in when gen-starter-deck gen-a (store.templates) 42
      is StarterRefused (why) -> magic-respond-error store why
      is StarterDeck (deck-a) -> (when gen-starter-deck gen-b (store.templates) 99
        is StarterRefused (why) -> magic-respond-error store why
        is StarterDeck (deck-b) ->
          let gs = game-contest-seed (game-new (store.templates) gen-a gen-b) seed
          in let gs2 = load-deck-cards gs 0 (shuffle-deck (deck-a.cards) 777) 0
          in let gs3 = load-deck-cards gs2 1 (shuffle-deck (deck-b.cards) 888) 0
          in let gs4 = draw-cards gs3 0 7
          in let gs5 = draw-cards gs4 1 7
          in let ns = store-fresh-game store gs5 True
          in handle-game-state ns)

  handle-game-skill : MagicStore, Text -> MagicStep
  handle-game-skill (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let skill = game-query-id (extract-query-param line "level")
    in if player < 0 | player > 1 | skill < 0 | skill > 3 then magic-respond-error store "invalid skill level"
    else let orders = for p in store.orders -> p
    in let changed = list-set-at orders player (posture-at-skill (list-at orders player) skill)
    in handle-game-state (__record-set (update-store-game store (store.game) (store.game-active)) "orders" changed)

  handle-game-step : MagicStore, Boolean -> MagicStep
  handle-game-step (store) (resume) =
    if store.pause-active then (if resume then handle-game-resume-at store game-clock-ms else handle-game-state store)
    else if store.game-active == False then magic-respond-error store "no active game"
    else if store.game.game-over then magic-respond-error store "game is over"
    else let progress = advance-supervised (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) resume
    in finish-game-progress store progress

  finish-game-progress : MagicStore, SupervisedTurn -> MagicStep
  finish-game-progress (store) (given) =
    let progress = settle-supervised-disruption given (list-at (store.orders) 0) (list-at (store.orders) 1)
    in let gs2 = progress.game
    in let gs3 = check-state-based-actions gs2
    in let gs4 = if gs3.game-over | game-budget-stopped gs3 | progress.stage < ai-stage-done then gs3 else advance-turn gs3
    in let next = if gs4.game-over then SupervisedTurn { combat-cantrip-stage = progress.combat-cantrip-stage, manual-override = False, game = gs4, combat = progress.combat, stage = ai-stage-done, paused = False, commitment = commitment-none, held-cards = [], combat-choice = combat-choice-none, used-abilities = [] } else if game-budget-stopped gs4 then SupervisedTurn { combat-cantrip-stage = progress.combat-cantrip-stage, manual-override = progress.manual-override, game = gs4, combat = progress.combat, stage = (if progress.stage >= ai-stage-done then ai-stage-end else progress.stage), paused = True, commitment = progress.commitment, held-cards = progress.held-cards, combat-choice = progress.combat-choice, used-abilities = progress.used-abilities } else if progress.stage >= ai-stage-done then supervised-start gs4 else SupervisedTurn { combat-cantrip-stage = progress.combat-cantrip-stage, manual-override = progress.manual-override, game = gs4, combat = progress.combat, stage = progress.stage, paused = progress.paused, commitment = progress.commitment, held-cards = progress.held-cards, combat-choice = progress.combat-choice, used-abilities = progress.used-abilities }
    in let ns = store-turn store next (if gs4.game-over then False else True)
    in let ns2 = if gs4.game-over then finalize-match ns gs4 else ns
    in handle-game-state ns2

  finalize-match : MagicStore, GameState -> MagicStore
  finalize-match (store) (gs) =
    let mr = finalize-record (store.match-record) gs
    in let acct-0 = get-account (store.accounts) 0
    in let acct-1 = get-account (store.accounts) (if store.num-accounts > 1 then 1 else 0)
    in let winner-acct = if gs.winner == 0 then acct-0 else acct-1
    in let loser-acct = if gs.winner == 0 then acct-1 else acct-0
    in let ratings = update-ratings winner-acct loser-acct 0
    in let acct-0-new = apply-rating-update acct-0 (if gs.winner == 0 then ratings.winner-new-rating else ratings.loser-new-rating) (gs.winner == 0)
    in let new-accts = set-account (store.accounts) 0 acct-0-new
    in let reward = if gs.winner == 0 then 50 else 10
    in let ledger2 = ledger-mint (store.ledger) 0 reward
    in let ns = update-store-accounts store new-accts (store.num-accounts)
    in update-store-ledger ns ledger2

  handle-game-state : MagicStore -> MagicStep
  handle-game-state (store) =
    if store.pause-active | store.game-active == False | loyalty-pending (store.game) == False then handle-game-state-view store
    else let gs = settle-loyalty (store.game) (list-at (store.orders) 0) (list-at (store.orders) 1)
    in let prior = store.turn
    in let turn = ability-turn prior gs (if gs.game-over then False else prior.paused | game-budget-stopped gs) (if gs.game-over then commitment-none else prior.commitment) (prior.used-abilities)
    in let ended = if gs.game-over then __record-set (__record-set turn "stage" ai-stage-done) "manual-override" False else turn
    in let next = store-turn store ended (gs.game-over == False)
    in handle-game-state-view (if gs.game-over then finalize-match next gs else next)

  handle-game-state-view : MagicStore -> MagicStep
  handle-game-state-view (store) =
    let gen-a = get-general (store.game) 0
    in let gen-b = get-general (store.game) 1
    in let body = game-state-to-json (store.game) gen-a gen-b (store.templates)
    in magic-respond-json store (text-take body (text-length body - 1) & ",\"game-active\":" & jbool (store.game-active) & ",\"paused\":" & jbool (store.pause-active | (store.turn).paused) & ",\"manual-override\":" & jbool ((store.turn).manual-override) & ",\"pause-active\":" & jbool (store.pause-active) & ",\"turn-stage\":" & show ((store.turn).stage) & ",\"phase-label\":" & jstr (if (store.game).game-over then "Game over" else ai-stage-name ((store.turn).stage)) & ",\"budget-stop\":" & jstr (budget-stop-reason (store.game)) & ",\"cleanup\":" & cleanup-json store & ",\"disruption\":" & disruption-json store & ",\"disruption-result\":" & disruption-result-json (store.game) & ",\"combat-choice\":" & combat-choice-json store & ",\"commitment\":" & commitment-json store & ",\"loyalty-used\":" & jbool (((get-player (store.game) ((store.game).active-player)).general).loyalty-turn == (store.game).turn-number) & ",\"loyalty-abilities\":[" & loyalty-abilities-json store 0 "" & "],\"permanent-abilities\":[" & permanent-abilities-json store & "],\"queued-cards\":[" & queued-card-json store ((store.game).active-player) & "],\"queue-card-options\":[" & queue-card-options-json store & "],\"queued-loyalty\":[" & queued-loyalty-json (store.game) 0 & "," & queued-loyalty-json (store.game) 1 & "],\"queue-loyalty-options\":[" & queue-loyalty-options-json store & "],\"queued-abilities\":[" & queued-orders-json (store.game) & "],\"queue-options\":[" & queue-options-json store & "],\"hand-orders\":[" & hand-orders-json store ((store.game).active-player) & "],\"manual-player\":" & show (manual-card-player (store.turn)) & ",\"combat-cantrip\":" & jbool (combat-card-stage ((store.turn).stage) & posture-freezes (list-at (store.orders) (manual-card-player (store.turn))) ((store.turn).stage)) & ",\"combat-cantrip-used\":" & jbool ((store.turn).combat-cantrip-stage == (store.turn).stage) & ",\"manual-hand\":[" & manual-hand-json store 0 "" & "],\"attackers\":[" & attacking-json ((store.turn).combat) 0 "" & "],\"orders\":[" & posture-json (store.game) (list-at (store.orders) 0) & "," & posture-json (store.game) (list-at (store.orders) 1) & "]}")

  card-order-editable : GameState, Integer, Integer -> Boolean
  card-order-editable (gs) (player) (card) =
    if player < 0 | player >= list-length (gs.players) | game-card-valid gs card == False then False
    else if int-list-has ((get-player gs player).hand) card then True
    else if (get-card-template gs card).is-token then False
    else list-contains (gs.battlefield) (\p -> p.card-id == card & p.owner == player)

  handle-game-card-order : MagicStore, Text -> MagicStep
  handle-game-card-order (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let card = game-query-id (extract-query-param line "card")
    in let mode = game-query-id (extract-query-param line "order")
    in if store.game-active == False | (store.game).game-over | mode < 0 | mode > 2 | card-order-editable (store.game) player card == False then magic-respond-error store "invalid card order"
    else let game = set-card-play-order (store.game) card mode
    in let old = store.turn
    in let turn = SupervisedTurn { combat-cantrip-stage = old.combat-cantrip-stage, manual-override = old.manual-override, game = game, combat = old.combat, stage = old.stage, paused = old.paused, commitment = old.commitment, held-cards = old.held-cards, combat-choice = old.combat-choice, used-abilities = old.used-abilities }
    in handle-game-state (store-turn store turn True)

  hand-orders-json : MagicStore, Integer -> Text
  hand-orders-json (store) (player) =
    if store.game-active == False then ""
    else text-concat-list (hand-order-chunks (store.game) ((get-player (store.game) player).hand) 0 [])

  hand-order-chunks : GameState, List Integer, Integer, List Text -> List Text
  hand-order-chunks (gs) (hand) (i) (acc) =
    if i >= list-length hand then acc
    else let card = list-at hand i
    in if game-card-valid gs card == False then hand-order-chunks gs hand (i + 1) acc
    else let template = get-card-template gs card
    in let row = "{\"id\":" & show card & ",\"template-id\":" & show (card-template-id gs card) & ",\"name\":" & jstr (template.name) & ",\"cost\":" & jstr (format-light-cost (template.light-cost)) & ",\"play-order\":" & show (card-play-order gs card) & "}"
    in hand-order-chunks gs hand (i + 1) (list-push acc ((if list-length acc == 0 then "" else ",") & row))

  manual-hand-json : MagicStore, Integer, Text -> Text
  manual-hand-json (store) (i) (acc) =
    let turn = store.turn
    in let player = manual-card-player turn
    in let orders = list-at (store.orders) player
    in let hand = (get-player (turn.game) player).hand
    in if store.game-active == False | manual-card-pause turn orders == False | i >= list-length hand then acc
    else let card = list-at hand i
    in if game-card-valid (turn.game) card == False then manual-hand-json store (i + 1) acc
    else let t = get-card-template (turn.game) card
    in if combat-card-stage (turn.stage) & t.card-type /= Cantrip then manual-hand-json store (i + 1) acc
    else let rays = if t.card-type == Gemstone then 0 else light-payment-rays (turn.game) player (t.light-cost) (prismatic-available-rays ((get-player (turn.game) player).prismatic))
    in manual-hand-json store (i + 1) (acc & (if text-length acc == 0 then "" else ",") & "{\"id\":" & show card & ",\"template-id\":" & show (card-template-id (turn.game) card) & ",\"name\":" & jstr (t.name) & ",\"cost\":" & jstr (format-light-cost (t.light-cost)) & ",\"rays\":" & show rays & ",\"gem\":" & jbool (t.card-type == Gemstone) & ",\"play-order\":" & show (card-play-order (turn.game) card) & ",\"ready\":" & jbool (supervised-card-ready turn orders card) & "}")

  handle-game-play : MagicStore, Text -> MagicStep
  handle-game-play (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else if combat-card-stage ((store.turn).stage) & game-query-id (extract-query-param line "player") /= manual-card-player (store.turn) then magic-respond-error store "wrong player for this combat freeze"
    else let card = game-query-id (extract-query-param line "card")
    in let player = manual-card-player (store.turn)
    in let prior = list-at (store.orders) player
    in let raw-target = extract-query-param line "target"
    in let target = game-target-id raw-target
    in if store.game-active == False | supervised-card-ready (store.turn) prior card == False then magic-respond-error store "card cannot be played at this pause"
    else if raw-target /= "" & (target == (0 - 3) | spell-target-legal (store.game) (get-card-template (store.game) card) player (((get-player (store.game) player).prismatic).fluorescence-active) target == False) then magic-respond-error store "invalid spell target"
    else let orders = if raw-target == "" then prior else target-choice-posture prior target
    in let chains = if orders.manual-payment then parse-payment-chains (extract-query-param line "chains") else []
    in let t = get-card-template (store.game) card
    in let valid = if orders.manual-payment == False then True else if t.card-type == Gemstone then list-length chains == 0 else manual-payment-possible (store.game) player (t.light-cost) chains
    in if valid == False then magic-respond-error store "invalid gemstone payment"
    else let played = if orders.manual-payment then supervised-play-manual (store.turn) orders card chains else supervised-play-card (store.turn) orders card
    in let turn = settle-supervised-disruption played (list-at (store.orders) 0) (list-at (store.orders) 1)
    in let next = store-turn store turn ((turn.game).game-over == False)
    in handle-game-state (if (turn.game).game-over then finalize-match next (turn.game) else next)

  game-target-id : Text -> Integer
  game-target-id (raw) = if raw == "-1" then 0 - 1 else if raw == "-2" then 0 - 2 else let id = game-query-id raw in if id < 0 then 0 - 3 else id

  handle-game-targets : MagicStore, Text -> MagicStep
  handle-game-targets (store) (line) =
    let card = game-query-id (extract-query-param line "card")
    in let gs = store.game
    in let player = manual-card-player (store.turn)
    in let orders = list-at (store.orders) player
    in if combat-card-stage ((store.turn).stage) & game-query-id (extract-query-param line "player") /= player then magic-respond-error store "wrong player for this combat freeze"
    else if store.pause-active then magic-respond-error store "game is paused"
    else if store.game-active == False | supervised-card-ready (store.turn) orders card == False then magic-respond-error store "card cannot be played at this pause"
    else let cs = spell-target-candidates-active gs (get-card-template gs card) player (((get-player gs player).prismatic).fluorescence-active)
    in let recommended = ordered-target cs (orders.primary-targets) 0
    in magic-respond-json store ("{\"card\":" & show card & ",\"recommended\":" & show recommended & ",\"targets\":[" & target-choices-json gs cs & "]}")

  target-choices-json : GameState, List TargetCandidate -> Text
  target-choices-json (gs) (cs) = text-concat-list (target-choice-chunks gs cs 0 [])

  target-choice-chunks : GameState, List TargetCandidate, Integer, List Text -> List Text
  target-choice-chunks (gs) (cs) (i) (acc) =
    if i >= list-length cs then acc
    else let id = (list-at cs i).target
    in let label = if id < 0 then "General: " & (get-general gs (0 - 1 - id)).name else target-order-label gs (PriorityPermanent id) & " #" & show id
    in let row = (if i == 0 then "" else ",") & "{\"id\":" & show id & ",\"label\":" & jstr label & "}"
    in target-choice-chunks gs cs (i + 1) (list-push acc row)

  parse-payment-chains : Text -> List (List Integer)
  parse-payment-chains (raw) = if raw == "" then [] else parse-payment-rows (text-split raw ";") 0 []

  handle-game-fluorescence : MagicStore, Text -> MagicStep
  handle-game-fluorescence (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let stone = game-query-id (extract-query-param line "stone")
    in if store.game-active == False | stone < 0 | supervised-fluorescence-ready (store.turn) stone == False then magic-respond-error store "cannot activate Fluorescence"
    else handle-game-state (store-turn store (supervised-fluorescence (store.turn) stone) True)

  handle-game-queue-targets : MagicStore, Text -> MagicStep
  handle-game-queue-targets (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let gs = store.game
    in if store.game-active == False | gs.game-over | queued-definition-valid gs player source index == False then magic-respond-error store "ability cannot be queued"
    else let eff = activation-effect gs source index
    in let cs = effect-target-candidates gs player eff
    in if effect-needs-target eff & list-length cs == 0 then magic-respond-error store "no legal target for queued ability"
    else let target = ordered-target cs ((list-at (store.orders) player).primary-targets) 0
    in magic-respond-json store ("{\"player\":" & show player & ",\"permanent\":" & show source & ",\"index\":" & show index & ",\"recommended\":" & show target & ",\"targets\":[" & target-choices-json gs cs & "]}")

  handle-game-queue-card-targets : MagicStore, Text -> MagicStep
  handle-game-queue-card-targets (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let card = game-query-id (extract-query-param line "card")
    in let gs = store.game
    in if store.game-active == False | gs.game-over | queued-card-valid gs player card == False then magic-respond-error store "card cannot be queued"
    else let cs = spell-target-candidates-active gs (get-card-template gs card) player (((get-player gs player).prismatic).fluorescence-active)
    in let target = if list-length cs == 0 then 0 - 3 else ordered-target cs ((list-at (store.orders) player).primary-targets) 0
    in if queued-card-target-valid gs player card target == False then magic-respond-error store "no legal target for queued card"
    else magic-respond-json store ("{\"player\":" & show player & ",\"card\":" & show card & ",\"recommended\":" & show target & ",\"targets\":[" & target-choices-json gs cs & "]}")

  handle-game-queue-card : MagicStore, Text -> MagicStep
  handle-game-queue-card (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let choice = extract-query-param line "choice"
    in if player < 0 | player > 1 | (choice /= "queue" & choice /= "cancel") then magic-respond-error store "invalid queued card order"
    else if choice == "cancel" then handle-game-state (store-queued-game store (game-set-queued-card (store.game) player queued-card-none))
    else let card = game-query-id (extract-query-param line "card")
    in let gs = store.game
    in if store.game-active == False | gs.game-over | queued-card-valid gs player card == False then magic-respond-error store "card cannot be queued"
    else let raw = extract-query-param line "target"
    in let cs = if raw == "" then spell-target-candidates-active gs (get-card-template gs card) player (((get-player gs player).prismatic).fluorescence-active) else []
    in let target = if raw /= "" then game-target-id raw else if list-length cs > 0 then ordered-target cs ((list-at (store.orders) player).primary-targets) 0 else 0 - 3
    in if queued-card-target-valid gs player card target == False then magic-respond-error store "invalid queued card target"
    else let label = (get-card-template gs card).name & " #" & show card & (if target == (0 - 3) then "" else " targeting " & queue-target-label gs target)
    in handle-game-state (store-queued-game store (queue-card-order gs player card target ((store.turn).stage) label))

  queued-card-json : MagicStore, Integer -> Text
  queued-card-json (store) (player) =
    let q = list-at ((store.game).queued-cards) player
    in if q.card < 0 then "{\"player\":" & show player & ",\"pending\":false}"
    else "{\"player\":" & show player & ",\"pending\":true,\"card\":" & show (q.card) & ",\"target\":" & show (q.target) & ",\"label\":" & jstr (q.label) & ",\"reason\":" & jstr (queued-card-display-reason (store.game) player q (list-at (store.orders) player)) & "}"

  queue-card-options-json : MagicStore -> Text
  queue-card-options-json (store) =
    if store.game-active == False | (store.game).game-over then ""
    else let player = (store.game).active-player
    in text-concat-list (queue-card-option-chunks (store.game) player ((get-player (store.game) player).hand) 0 [])

  queue-card-option-chunks : GameState, Integer, List Integer, Integer, List Text -> List Text
  queue-card-option-chunks (gs) (player) (hand) (i) (chunks) =
    if i >= list-length hand then chunks
    else let card = list-at hand i
    in if game-card-valid gs card == False | (get-card-template gs card).card-type == General | (get-card-template gs card).card-type == Disruption then queue-card-option-chunks gs player hand (i + 1) chunks
    else let label = (get-card-template gs card).name & " #" & show card & " | " & format-light-cost ((get-card-template gs card).light-cost)
    in let row = (if list-length chunks == 0 then "" else ",") & "{\"player\":" & show player & ",\"card\":" & show card & ",\"label\":" & jstr label & "}"
    in queue-card-option-chunks gs player hand (i + 1) (list-push chunks row)

  queue-target-label : GameState, Integer -> Text
  queue-target-label (gs) (target) = if target < 0 then "General: " & (get-general gs (0 - 1 - target)).name else target-order-label gs (PriorityPermanent target) & " #" & show target

  queue-ability-label : GameState, Integer, Integer -> Text
  queue-ability-label (gs) (source) (index) =
    let p = find-permanent (gs.battlefield) source 0 (list-length (gs.battlefield))
    in let t = get-template gs (p.template-id)
    in when list-at (t.abilities) index is ActivatedAbility (cost) (eff) -> t.name & " #" & show source & ": " & loyalty-effect-label eff & " | " & activation-cost-label cost is otherwise -> "Unavailable ability"

  store-queued-game : MagicStore, GameState -> MagicStore
  store-queued-game (store) (gs) =
    let old = store.turn
    in store-turn store (ability-turn old gs (old.paused) (old.commitment) (old.used-abilities)) (store.game-active)

  handle-game-queue-ability : MagicStore, Text -> MagicStep
  handle-game-queue-ability (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let choice = extract-query-param line "choice"
    in if player < 0 | player > 1 | (choice /= "queue" & choice /= "cancel") then magic-respond-error store "invalid queued order"
    else if choice == "cancel" then handle-game-state (store-queued-game store (game-set-queued-ability (store.game) player queued-ability-none))
    else let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let gs = store.game
    in if store.game-active == False | gs.game-over | queued-definition-valid gs player source index == False then magic-respond-error store "ability cannot be queued"
    else let eff = activation-effect gs source index
    in let raw = extract-query-param line "target"
    in let picked = if raw == "" then loyalty-effect-targets gs player eff ((list-at (store.orders) player).primary-targets) else []
    in let target = if raw /= "" then game-target-id raw else if list-length picked > 0 then list-at picked 0 else 0 - 3
    in if queued-target-valid gs player source index target == False then magic-respond-error store "invalid queued target"
    else let label = queue-ability-label gs source index & (if target == (0 - 3) then "" else " targeting " & queue-target-label gs target)
    in let next = queue-ability-order gs player source index target ((store.turn).stage) label
    in handle-game-state (store-queued-game store next)

  queue-loyalty-label : GameState, Integer, Integer -> Text
  queue-loyalty-label (gs) (player) (index) =
    when list-at ((get-general gs player).abilities) index
      is LoyaltyCostAbility (cost) (eff) -> (get-general gs player).name & ": " & loyalty-effect-label eff & " | loyalty " & show cost
      is otherwise -> "Unavailable General ability"

  handle-game-queue-loyalty-targets : MagicStore, Text -> MagicStep
  handle-game-queue-loyalty-targets (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let index = game-query-id (extract-query-param line "index")
    in let gs = store.game
    in if store.game-active == False | queued-loyalty-definition-valid gs player index == False then magic-respond-error store "General ability cannot be queued"
    else let eff = queued-loyalty-effect gs player index
    in let cs = effect-target-candidates gs player eff
    in if effect-needs-target eff & list-length cs == 0 then magic-respond-error store "no legal target for queued General ability"
    else let target = if list-length cs == 0 then 0 - 3 else ordered-target cs ((list-at (store.orders) player).primary-targets) 0
    in magic-respond-json store ("{\"player\":" & show player & ",\"index\":" & show index & ",\"recommended\":" & show target & ",\"targets\":[" & target-choices-json gs cs & "]}")

  handle-game-queue-loyalty : MagicStore, Text -> MagicStep
  handle-game-queue-loyalty (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let choice = extract-query-param line "choice"
    in if player < 0 | player > 1 | (choice /= "queue" & choice /= "cancel") then magic-respond-error store "invalid queued General order"
    else if choice == "cancel" then handle-game-state (store-queued-game store (game-set-queued-loyalty (store.game) player queued-ability-none))
    else let index = game-query-id (extract-query-param line "index")
    in let gs = store.game
    in if store.game-active == False | queued-loyalty-definition-valid gs player index == False then magic-respond-error store "General ability cannot be queued"
    else let raw = extract-query-param line "target"
    in let picked = if raw == "" then loyalty-effect-targets gs player (queued-loyalty-effect gs player index) ((list-at (store.orders) player).primary-targets) else []
    in let target = if raw /= "" then game-target-id raw else if list-length picked > 0 then list-at picked 0 else 0 - 3
    in if queued-loyalty-target-valid gs player index target == False then magic-respond-error store "invalid queued General target"
    else let label = queue-loyalty-label gs player index & (if target == (0 - 3) then "" else " targeting " & queue-target-label gs target)
    in handle-game-state (store-queued-game store (queue-loyalty-order gs player index target ((store.turn).stage) label))

  queued-loyalty-json : GameState, Integer -> Text
  queued-loyalty-json (gs) (player) =
    let q = list-at (gs.queued-loyalty) player
    in if q.source < 0 then "{\"player\":" & show player & ",\"pending\":false}"
    else "{\"player\":" & show player & ",\"pending\":true,\"index\":" & show (q.ability) & ",\"target\":" & show (q.target) & ",\"label\":" & jstr (q.label) & ",\"reason\":" & jstr (queued-loyalty-display-reason gs player q) & "}"

  queue-loyalty-options-json : MagicStore -> Text
  queue-loyalty-options-json (store) = if store.game-active == False | (store.game).game-over then "" else text-concat-list (queue-loyalty-option-chunks (store.game) 0 0 [])

  queue-loyalty-option-chunks : GameState, Integer, Integer, List Text -> List Text
  queue-loyalty-option-chunks (gs) (player) (index) (chunks) =
    if player >= 2 then chunks
    else if index >= list-length ((get-general gs player).abilities) then queue-loyalty-option-chunks gs (player + 1) 0 chunks
    else if queued-loyalty-definition-valid gs player index == False then queue-loyalty-option-chunks gs player (index + 1) chunks
    else let row = (if list-length chunks == 0 then "" else ",") & "{\"player\":" & show player & ",\"index\":" & show index & ",\"label\":" & jstr (queue-loyalty-label gs player index) & "}"
    in queue-loyalty-option-chunks gs player (index + 1) (list-push chunks row)

  queued-orders-json : GameState -> Text
  queued-orders-json (gs) = queued-order-json gs 0 & "," & queued-order-json gs 1

  queued-order-json : GameState, Integer -> Text
  queued-order-json (gs) (player) =
    let q = list-at (gs.queued-abilities) player
    in if q.source < 0 then "{\"player\":" & show player & ",\"pending\":false}"
    else "{\"player\":" & show player & ",\"pending\":true,\"permanent\":" & show (q.source) & ",\"index\":" & show (q.ability) & ",\"target\":" & show (q.target) & ",\"label\":" & jstr (q.label) & ",\"reason\":" & jstr (queued-display-reason gs player q) & "}"

  queue-options-json : MagicStore -> Text
  queue-options-json (store) = if store.game-active == False | (store.game).game-over then "" else text-concat-list (queue-option-chunks (store.game) 0 0 [])

  queue-option-chunks : GameState, Integer, Integer, List Text -> List Text
  queue-option-chunks (gs) (i) (j) (chunks) =
    if i >= list-length (gs.battlefield) then chunks
    else let p = list-at (gs.battlefield) i
    in let t = get-template gs (p.template-id)
    in if j >= list-length (t.abilities) | t.card-type == General | p.controller < 0 | p.controller > 1 then queue-option-chunks gs (i + 1) 0 chunks
    else when list-at (t.abilities) j
      is ActivatedAbility (cost) (eff) ->
        (if cost.rays < 0 | cost.pay-life < 0 | loyalty-effect-supported eff == False then queue-option-chunks gs i (j + 1) chunks
         else let label = t.name & " #" & show (p.id) & ": " & loyalty-effect-label eff & " | " & activation-cost-label cost
         in let row = (if list-length chunks == 0 then "" else ",") & "{\"player\":" & show (p.controller) & ",\"permanent\":" & show (p.id) & ",\"index\":" & show j & ",\"label\":" & jstr label & "}"
         in queue-option-chunks gs i (j + 1) (list-push chunks row))
      is otherwise -> queue-option-chunks gs i (j + 1) chunks

  handle-game-activate : MagicStore, Text -> MagicStep
  handle-game-activate (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let player = (store.game).active-player
    in let prior = list-at (store.orders) player
    in if store.game-active == False | supervised-permanent-ready (store.turn) prior source index == False then magic-respond-error store "permanent ability unavailable"
    else let raw = extract-query-param line "target"
    in let target = game-target-id raw
    in let eff = activation-effect (store.game) source index
    in if raw /= "" & (target == (0 - 3) | effect-target-legal (store.game) player eff target == False) then magic-respond-error store "invalid ability target"
    else let orders = if raw == "" then prior else target-choice-posture prior target
    in let announced = supervised-activate-permanent (store.turn) orders source index
    in let turn = settle-supervised-disruption announced (list-at (store.orders) 0) (list-at (store.orders) 1)
    in let next = store-turn store turn ((turn.game).game-over == False)
    in handle-game-state (if (turn.game).game-over then finalize-match next (turn.game) else next)

  handle-game-ability-targets : MagicStore, Text -> MagicStep
  handle-game-ability-targets (store) (line) =
    let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let player = (store.game).active-player
    in let orders = list-at (store.orders) player
    in if store.game-active == False | supervised-permanent-ready (store.turn) orders source index == False then magic-respond-error store "permanent ability unavailable"
    else let cs = effect-target-candidates (store.game) player (activation-effect (store.game) source index)
    in magic-respond-json store ("{\"permanent\":" & show source & ",\"index\":" & show index & ",\"recommended\":" & show (ordered-target cs (orders.primary-targets) 0) & ",\"targets\":[" & target-choices-json (store.game) cs & "]}")

  permanent-abilities-json : MagicStore -> Text
  permanent-abilities-json (store) =
    if store.game-active == False | (store.turn).paused == False | manual-main-stage ((store.turn).stage) == False | commitment-pending ((store.turn).commitment) then ""
    else text-concat-list (permanent-ability-chunks store 0 0 [])

  permanent-ability-chunks : MagicStore, Integer, Integer, List Text -> List Text
  permanent-ability-chunks (store) (i) (j) (acc) =
    let gs = store.game
    in if i >= list-length (gs.battlefield) then acc
    else let p = list-at (gs.battlefield) i
    in let t = get-template gs (p.template-id)
    in if p.controller /= gs.active-player | t.card-type == General | j >= list-length (t.abilities) then permanent-ability-chunks store (i + 1) 0 acc
    else when list-at (t.abilities) j
      is ActivatedAbility (cost) (eff) ->
        (let ready = supervised-permanent-ready (store.turn) (list-at (store.orders) (gs.active-player)) (p.id) j
         in let row = (if list-length acc == 0 then "" else ",") & "{\"permanent\":" & show (p.id) & ",\"index\":" & show j & ",\"label\":" & jstr (t.name & " #" & show (p.id) & ": " & loyalty-effect-label eff) & ",\"cost\":" & jstr (activation-cost-label cost) & ",\"ready\":" & jbool ready & "}"
         in permanent-ability-chunks store i (j + 1) (list-push acc row))
      is otherwise -> permanent-ability-chunks store i (j + 1) acc

  handle-game-loyalty : MagicStore, Text -> MagicStep
  handle-game-loyalty (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let index = game-query-id (extract-query-param line "index")
    in let orders = list-at (store.orders) ((store.game).active-player)
    in if store.game-active == False | supervised-loyalty-ready (store.turn) orders index == False then magic-respond-error store "General ability unavailable"
    else let announced = supervised-use-loyalty (store.turn) orders index
    in let turn = settle-supervised-disruption announced (list-at (store.orders) 0) (list-at (store.orders) 1)
    in let next = store-turn store turn ((turn.game).game-over == False)
    in handle-game-state (if (turn.game).game-over then finalize-match next (turn.game) else next)

  loyalty-abilities-json : MagicStore, Integer, Text -> Text
  loyalty-abilities-json (store) (i) (acc) =
    let gs = store.game
    in let abs = (get-general gs (gs.active-player)).abilities
    in if i >= list-length abs then acc
    else let entry = when list-at abs i
      is LoyaltyCostAbility (cost) (eff) -> "{\"index\":" & show i & ",\"label\":" & jstr (loyalty-effect-label eff) & ",\"cost\":" & show cost & ",\"ready\":" & jbool (store.game-active & supervised-loyalty-ready (store.turn) (list-at (store.orders) (gs.active-player)) i) & "}"
      is otherwise -> ""
    in loyalty-abilities-json store (i + 1) (if entry == "" then acc else acc & (if acc == "" then "" else ",") & entry)

  parse-payment-rows : List Text, Integer, List (List Integer) -> List (List Integer)
  parse-payment-rows (rows) (i) (acc) =
    if i >= list-length rows then acc
    else let raw = list-at rows i
    in let chain = if raw == "w" then [] else for token in text-split raw "," -> game-query-id token
    in parse-payment-rows rows (i + 1) (list-push acc chain)

  attacking-json : CombatState, Integer, Text -> Text
  attacking-json (cs) (i) (acc) =
    if i >= cs.num-attackers then acc
    else attacking-json cs (i + 1) (acc & (if i == 0 then "" else ",") & "{\"id\":" & show ((list-at (cs.attackers) i).permanent-id) & "}")

  game-query-id : Text -> Integer
  game-query-id (s) =
    if text-length s == 0 | text-length s > 9 then 0 - 1
    else let n = parse-int s (0 - 1)
    in if s == show n then n else 0 - 1

  store-turn : MagicStore, SupervisedTurn, Boolean -> MagicStore
  store-turn (store) (given) (active) =
    let turn = ability-turn given (refresh-queued-loyalty (refresh-queued-cards (given.game) 0) 0) (given.paused) (given.commitment) (given.used-abilities)
    in store-clean-turn store turn active

  store-clean-turn : MagicStore, SupervisedTurn, Boolean -> MagicStore
  store-clean-turn (store) (turn) (active) =
    let next = update-store-game store (turn.game) active
    in if disruption-pending (turn.game) then store-disruption-turn next turn
    else if commitment-pending (turn.commitment) == False | (turn.commitment).nonce > 0 then store-combat-turn next turn
    else let now = game-clock-ms
    in let pending = turn.commitment
    in let stamped = Commitment { card = pending.card, rays = pending.rays, nonce = store.next-nonce, deadline = (if now < 0 then 0 else now + 15000), choices = pending.choices, recommended = pending.recommended, all-rays = pending.all-rays, source = pending.source, ability = pending.ability }
    in let saved = SupervisedTurn { combat-cantrip-stage = turn.combat-cantrip-stage, manual-override = turn.manual-override, game = turn.game, combat = turn.combat, stage = turn.stage, paused = turn.paused, commitment = stamped, held-cards = turn.held-cards, combat-choice = turn.combat-choice, used-abilities = turn.used-abilities }
    in __record-set (__record-set next "turn" saved) "next-nonce" (store.next-nonce + 1)

  store-disruption-turn : MagicStore, SupervisedTurn -> MagicStore
  store-disruption-turn (store) (turn) =
    let state = (turn.game).disruption
    in let window = state.window
    in if window.nonce > 0 then __record-set store "turn" turn
    else let now = game-clock-ms
    in let stamped = SpellWindow { activation = window.activation, card = window.card, caster = window.caster, targets = window.targets, hardness = window.hardness, manual = window.manual, nonce = store.next-nonce, deadline = (if now < 0 then 0 else now + 15000), choices = window.choices }
    in let gs = game-with-disruption (turn.game) (DisruptionState { seed = state.seed, index = state.index, window = stamped, result = state.result })
    in let next = update-store-game store gs (store.game-active)
    in __record-set (__record-set next "turn" (ability-turn turn gs True (turn.commitment) (turn.used-abilities))) "next-nonce" (store.next-nonce + 1)

  handle-game-disruption-at : MagicStore, Integer, Integer, Integer -> MagicStep
  handle-game-disruption-at (store) (nonce) (card) (now) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let window = ((store.game).disruption).window
    in if store.game-active == False | (store.game).game-over | response-window-pending window == False | nonce /= window.nonce then magic-respond-error store "disruption decision is no longer pending"
    else let expired = now < 0 | window.deadline <= 0 | now >= window.deadline
    in if expired == False & card >= 0 & (window.activation).source >= 0 then magic-respond-error store (if (window.activation).loyalty then "Disruption cannot respond to a General loyalty ability; choose Cantrip, ordinary ability or Pass" else "Disruption cannot respond to an activated ability; choose Cantrip, ordinary ability or Pass")
    else let next = supervised-disruption-choice (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) (if expired then 0 - 1 else card)
    in if (((next.game).disruption).window).nonce == nonce then magic-respond-error store "disruption is no longer payable; choose Pass"
    else finish-game-progress store next

  handle-game-disruption : MagicStore, Text -> MagicStep
  handle-game-disruption (store) (line) =
    let nonce = game-query-id (extract-query-param line "nonce")
    in let choice = extract-query-param line "choice"
    in let card = if choice == "disrupt" | choice == "cantrip" then game-query-id (extract-query-param line "card") else 0 - 1
    in let window = ((store.game).disruption).window
    in let now = game-clock-ms
    in if nonce < 0 | (choice /= "disrupt" & choice /= "cantrip" & choice /= "pass" & choice /= "timeout") | ((choice == "disrupt" | choice == "cantrip") & card < 0) then magic-respond-error store "invalid disruption choice"
    else if choice == "cantrip" then
      (let raw = extract-query-param line "target"
       in let target = if raw == "" then response-recommended store card else game-target-id raw
       in if raw /= "" & target == (0 - 3) then magic-respond-error store "invalid response target"
       else handle-game-cantrip-at store nonce card target now)
    else if choice == "timeout" & nonce == window.nonce & now >= 0 & now < window.deadline then handle-game-state store
    else handle-game-disruption-at store nonce card now

  response-recommended : MagicStore, Integer -> Integer
  response-recommended (store) (card) =
    if game-card-valid (store.game) card == False then 0 - 3
    else let gs = store.game
    in let player = if ((gs.disruption).window).caster == 0 then 1 else 0
    in let cs = spell-target-candidates-active gs (get-card-template gs card) player (((get-player gs player).prismatic).fluorescence-active)
    in if list-length cs == 0 then 0 - 3 else ordered-target cs ((list-at (store.orders) player).primary-targets) 0

  response-ability-target : MagicStore, Integer, Integer -> Integer
  response-ability-target (store) (source) (index) =
    let gs = store.game
    in if response-ability-ready gs source index == False then 0 - 3
    else let player = if ((gs.disruption).window).caster == 0 then 1 else 0
    in let cs = effect-target-candidates gs player (activation-effect gs source index)
    in if list-length cs == 0 then 0 - 3 else ordered-target cs ((list-at (store.orders) player).primary-targets) 0

  handle-game-response-ability-targets : MagicStore, Text -> MagicStep
  handle-game-response-ability-targets (store) (line) =
    let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let nonce = game-query-id (extract-query-param line "nonce")
    in let gs = store.game
    in let window = (gs.disruption).window
    in if store.pause-active then magic-respond-error store "game is paused"
    else if store.game-active == False | response-window-pending window == False | nonce /= window.nonce | list-contains (window.choices) (\o -> o.source == source & o.ability == index & source >= 0) == False | response-ability-ready gs source index == False then magic-respond-error store "ability response is no longer available"
    else let player = if window.caster == 0 then 1 else 0
    in let cs = effect-target-candidates gs player (activation-effect gs source index)
    in magic-respond-json store ("{\"permanent\":" & show source & ",\"index\":" & show index & ",\"recommended\":" & show (response-ability-target store source index) & ",\"targets\":[" & target-choices-json gs cs & "]}")

  handle-game-response-ability-at : MagicStore, Integer, Integer, Integer, Integer, Integer -> MagicStep
  handle-game-response-ability-at (store) (nonce) (source) (index) (target) (now) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let window = ((store.game).disruption).window
    in if store.game-active == False | (store.game).game-over | response-window-pending window == False | nonce /= window.nonce then magic-respond-error store "response is no longer pending"
    else if now < 0 | window.deadline <= 0 | now >= window.deadline then handle-game-disruption-at store nonce (0 - 1) now
    else let next = supervised-ability-response (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) source index target
    in if (((next.game).disruption).window).nonce == nonce then magic-respond-error store "ability response is no longer payable; choose Pass"
    else finish-game-progress store next

  handle-game-response-ability : MagicStore, Text -> MagicStep
  handle-game-response-ability (store) (line) =
    let source = game-query-id (extract-query-param line "permanent")
    in let index = game-query-id (extract-query-param line "index")
    in let nonce = game-query-id (extract-query-param line "nonce")
    in let raw = extract-query-param line "target"
    in let target = if raw == "" then response-ability-target store source index else game-target-id raw
    in if source < 0 | index < 0 | nonce < 0 | (raw /= "" & target == (0 - 3)) then magic-respond-error store "invalid ability response"
    else handle-game-response-ability-at store nonce source index target game-clock-ms

  handle-game-response-targets : MagicStore, Text -> MagicStep
  handle-game-response-targets (store) (line) =
    let card = game-query-id (extract-query-param line "card")
    in let nonce = game-query-id (extract-query-param line "nonce")
    in let gs = store.game
    in let window = (gs.disruption).window
    in if store.pause-active then magic-respond-error store "game is paused"
    else if store.game-active == False | gs.game-over | response-window-pending window == False | nonce /= window.nonce | game-card-valid gs card == False | list-contains (window.choices) (\o -> o.card == card) == False then magic-respond-error store "response is no longer pending"
    else if (get-card-template gs card).card-type /= Cantrip then magic-respond-error store "response is not a Cantrip"
    else if response-target-available gs card == False then magic-respond-error store "no legal Cantrip target"
    else let player = if window.caster == 0 then 1 else 0
    in let cs = spell-target-candidates-active gs (get-card-template gs card) player (((get-player gs player).prismatic).fluorescence-active)
    in let target = if list-length cs == 0 then 0 - 3 else ordered-target cs ((list-at (store.orders) player).primary-targets) 0
    in magic-respond-json store ("{\"card\":" & show card & ",\"recommended\":" & show target & ",\"targets\":[" & target-choices-json gs cs & "]}")

  handle-game-cantrip-at : MagicStore, Integer, Integer, Integer, Integer -> MagicStep
  handle-game-cantrip-at (store) (nonce) (card) (target) (now) =
    let window = ((store.game).disruption).window
    in if store.pause-active then magic-respond-error store "game is paused"
    else if store.game-active == False | (store.game).game-over | response-window-pending window == False | nonce /= window.nonce then magic-respond-error store "response is no longer pending"
    else if now < 0 | window.deadline <= 0 | now >= window.deadline then handle-game-disruption-at store nonce (0 - 1) now
    else let next = supervised-cantrip-response (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) card target
    in if (((next.game).disruption).window).nonce == nonce then magic-respond-error store "Cantrip is no longer payable; choose Pass"
    else finish-game-progress store next

  handle-game-disruption-policy : MagicStore, Text -> MagicStep
  handle-game-disruption-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | enabled < 0 | enabled > 1 then magic-respond-error store "invalid disruption policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = enabled == 1 })
    in handle-game-state (__record-set (update-store-game store (store.game) (store.game-active)) "orders" changed)

  disruption-json : MagicStore -> Text
  disruption-json (store) =
    let window = ((store.game).disruption).window
    in if response-window-pending window == False then "null"
    else let remaining = choice-remaining store (window.deadline) game-clock-ms
    in "{\"nonce\":" & show (window.nonce) & ",\"card\":" & show (window.card) & ",\"pending-kind\":" & jstr (if (window.activation).source >= 0 then (if (window.activation).loyalty then "loyalty" else "ability") else "spell") & ",\"source\":" & show ((window.activation).source) & ",\"index\":" & show ((window.activation).index) & ",\"name\":" & jstr (if (window.activation).source >= 0 then (window.activation).label else (get-card-template (store.game) (window.card)).name) & ",\"player\":" & show (if window.caster == 0 then 1 else 0) & ",\"remaining-ms\":" & show (if remaining > 0 then remaining else 0) & ",\"choices\":[" & text-concat-list (disruption-options-json (store.game) (window.choices) 0 []) & "]}"

  disruption-options-json : GameState, List DisruptionOption, Integer, List Text -> List Text
  disruption-options-json (gs) (options) (i) (chunks) =
    if i >= list-length options then chunks
    else let option = list-at options i
    in let row = (if i == 0 then "" else ",") & "{\"card\":" & show (option.card) & ",\"name\":" & jstr (if option.source >= 0 then (get-template gs ((find-permanent (gs.battlefield) (option.source) 0 (list-length (gs.battlefield))).template-id)).name else (get-card-template gs (option.card)).name) & ",\"kind\":" & jstr (if option.source >= 0 then "ability" else if (get-card-template gs (option.card)).card-type == Cantrip then "cantrip" else "disruption") & ",\"rays\":" & show (option.rays) & ",\"chance\":" & show (option.chance) & ",\"permanent\":" & show (option.source) & ",\"index\":" & show (option.ability) & ",\"cost\":" & jstr (if option.source < 0 then "" else ability-response-cost-label gs (option.source) (option.ability)) & "}"
    in disruption-options-json gs options (i + 1) (list-push chunks row)

  disruption-result-json : GameState -> Text
  disruption-result-json (gs) =
    let result = (gs.disruption).result
    in if result.card < 0 & (result.activation).source < 0 then "null" else "{\"name\":" & jstr (if (result.activation).source >= 0 then (result.activation).label else (get-card-template gs (result.card)).name) & ",\"pending-kind\":" & jstr (if (result.activation).source >= 0 then (if (result.activation).loyalty then "loyalty" else "ability") else "spell") & ",\"source\":" & show ((result.activation).source) & ",\"index\":" & show ((result.activation).index) & ",\"reply-fizzled\":" & jbool (result.reply-fizzled) & ",\"abandoned\":" & jbool (result.abandoned) & ",\"response-kind\":" & jstr (if result.reply-source >= 0 then "ability" else if result.reply < 0 then "pass" else if (get-card-template gs (result.reply)).card-type == Cantrip then "cantrip" else "disruption") & ",\"reply-source\":" & show (result.reply-source) & ",\"reply-ability\":" & show (result.reply-ability) & ",\"reply\":" & show (result.reply) & ",\"chance\":" & show (result.chance) & ",\"roll\":" & show (result.roll) & ",\"fizzled\":" & jbool (result.fizzled) & ",\"disrupted\":" & jbool (result.disrupted) & "}"

  store-combat-turn : MagicStore, SupervisedTurn -> MagicStore
  store-combat-turn (store) (turn) =
    let choice = turn.combat-choice
    in if choice.pending == False | choice.nonce > 0 then __record-set store "turn" turn
    else let now = game-clock-ms
    in let stamped = CombatChoice { pending = True, nonce = store.next-nonce, deadline = (if now < 0 then 0 else now + 15000) }
    in let saved = SupervisedTurn { combat-cantrip-stage = turn.combat-cantrip-stage, manual-override = turn.manual-override, game = turn.game, combat = turn.combat, stage = turn.stage, paused = turn.paused, commitment = turn.commitment, held-cards = turn.held-cards, combat-choice = stamped, used-abilities = turn.used-abilities }
    in __record-set (__record-set store "turn" saved) "next-nonce" (store.next-nonce + 1)

  handle-game-combat-choice-at : MagicStore, Integer, Boolean, Integer -> MagicStep
  handle-game-combat-choice-at (store) (nonce) (timeout) (now) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let choice = (store.turn).combat-choice
    in if store.game-active == False | (store.game).game-over | choice.pending == False | nonce /= choice.nonce then magic-respond-error store "combat decision is no longer pending"
    else if timeout & now >= 0 & choice.deadline > 0 & now < choice.deadline then handle-game-state store
    else finish-game-progress store (supervised-combat-continue (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1))

  handle-game-combat-choice : MagicStore, Text -> MagicStep
  handle-game-combat-choice (store) (line) =
    let nonce = game-query-id (extract-query-param line "nonce")
    in let choice = extract-query-param line "choice"
    in if nonce < 0 | (choice /= "continue" & choice /= "timeout") then magic-respond-error store "invalid combat choice"
    else handle-game-combat-choice-at store nonce (choice == "timeout") game-clock-ms

  handle-game-combat-policy : MagicStore, Text -> MagicStep
  handle-game-combat-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | enabled < 0 | enabled > 1 then magic-respond-error store "invalid combat policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = enabled == 1, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  combat-choice-json : MagicStore -> Text
  combat-choice-json (store) =
    let choice = (store.turn).combat-choice
    in if choice.pending == False then "null"
    else let remaining = choice-remaining store (choice.deadline) game-clock-ms
    in "{\"nonce\":" & show (choice.nonce) & ",\"remaining-ms\":" & show (if remaining > 0 then remaining else 0) & "}"

  game-clock-ms : Integer
  game-clock-ms =
    let started = hpet-start
    in let rate = hpet-ticks-per-second
    in if rate <= 0 then 0 - 1
    else let ticks = hpet-ticks
    in (ticks / rate) * 1000 + int-mod ticks rate * 1000 / rate

  handle-game-commitment-at : MagicStore, Integer, Boolean, Integer -> MagicStep
  handle-game-commitment-at (store) (nonce) (cast) (now) = handle-game-commitment-target-at store nonce cast (((store.turn).commitment).recommended) now

  handle-game-override-at : MagicStore, Integer, Integer -> MagicStep
  handle-game-override-at (store) (nonce) (now) =
    if store.pause-active then magic-respond-error store "game is paused"
    else if disruption-pending (store.game) then magic-respond-error store (if ((((store.game).disruption).window).activation).loyalty then "cannot override a committed General response window" else "cannot override a paid response window")
    else let pending = (store.turn).commitment
    in if store.game-active == False | commitment-pending pending == False | nonce < 0 | nonce /= pending.nonce then magic-respond-error store "decision is no longer pending"
    else if now < 0 | pending.deadline <= 0 | now >= pending.deadline then handle-game-commitment-at store nonce False now
    else let turn = supervised-override (store.turn)
    in if commitment-pending (turn.commitment) then magic-respond-error store "action cannot be overridden at this phase"
    else handle-game-state (store-turn store turn True)

  handle-game-commitment-target-at : MagicStore, Integer, Boolean, Integer, Integer -> MagicStep
  handle-game-commitment-target-at (store) (nonce) (cast) (target) (now) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let pending = (store.turn).commitment
    in if store.game-active == False | commitment-pending pending == False | nonce /= pending.nonce then magic-respond-error store "decision is no longer pending"
    else let expired = now < 0 | pending.deadline <= 0 | now >= pending.deadline
    in let current = list-at (store.orders) ((store.game).active-player)
    in let permitted = if expired then pending.source < 0 & now >= 0 & pending.deadline > 0 & pending.all-rays == False & manual-main-orders current == False & card-play-order (store.game) (pending.card) /= card-order-hold & pending-spends-all (store.turn) current == False else cast
    in let attempted = supervised-commitment-target (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) permitted (if expired then pending.recommended else target)
    in let next = if expired & (attempted.commitment).nonce == nonce then supervised-commitment (store.turn) (list-at (store.orders) 0) (list-at (store.orders) 1) False else attempted
    in if (next.commitment).nonce == nonce then magic-respond-error store "pending action is no longer available; choose Hold"
    else finish-game-progress store next

  handle-game-commitment : MagicStore, Text -> MagicStep
  handle-game-commitment (store) (line) =
    let choice = extract-query-param line "choice"
    in let nonce = game-query-id (extract-query-param line "nonce")
    in let pending = (store.turn).commitment
    in let raw = extract-query-param line "target"
    in let target = if raw == "" then pending.recommended else game-target-id raw
    in let now = game-clock-ms
    in if nonce < 0 | (choice /= "cast" & choice /= "hold" & choice /= "timeout") | (raw /= "" & (target == (0 - 3) | list-length (pending.choices) == 0)) then magic-respond-error store "invalid commitment choice"
    else if choice == "timeout" & nonce == pending.nonce & now >= 0 & now < pending.deadline then handle-game-state store
    else handle-game-commitment-target-at store nonce (choice == "cast") target now

  handle-game-target-policy : MagicStore, Text -> MagicStep
  handle-game-target-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | enabled < 0 | enabled > 1 then magic-respond-error store "invalid target policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = enabled == 1, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  handle-game-commitment-policy : MagicStore, Text -> MagicStep
  handle-game-commitment-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | enabled < 0 | enabled > 1 then magic-respond-error store "invalid commitment policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = enabled == 1, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  commitment-json : MagicStore -> Text
  commitment-json (store) =
    let pending = (store.turn).commitment
    in if pending.source >= 0 then ability-commitment-json store
    else if pending.card < 0 | game-card-valid (store.game) (pending.card) == False then "null"
    else let remaining = choice-remaining store (pending.deadline) game-clock-ms
    in "{\"nonce\":" & show (pending.nonce) & ",\"card\":" & show (pending.card) & ",\"name\":" & jstr ((get-card-template (store.game) (pending.card)).name) & ",\"rays\":" & show (pending.rays) & ",\"all-rays\":" & jbool (pending.all-rays) & ",\"recommended\":" & show (pending.recommended) & ",\"targets\":[" & target-choices-json (store.game) (pending.choices) & "],\"remaining-ms\":" & show (if remaining > 0 then remaining else 0) & "}"

  ability-commitment-json : MagicStore -> Text
  ability-commitment-json (store) =
    let pending = (store.turn).commitment
    in if list-contains ((store.game).battlefield) (\p -> p.id == pending.source) == False then ability-commitment-labels store "Unavailable permanent" "Choose Hold" ""
    else let p = find-permanent ((store.game).battlefield) (pending.source) 0 (list-length ((store.game).battlefield))
    in let t = get-template (store.game) (p.template-id)
    in if pending.ability < 0 | pending.ability >= list-length (t.abilities) then ability-commitment-labels store (t.name) "Choose Hold" ""
    else when list-at (t.abilities) (pending.ability)
      is ActivatedAbility (cost) (eff) -> ability-commitment-labels store (t.name) (loyalty-effect-label eff) (activation-cost-label cost)
      is otherwise -> ability-commitment-labels store (t.name) "Choose Hold" ""

  ability-commitment-labels : MagicStore, Text, Text, Text -> Text
  ability-commitment-labels (store) (name) (description) (cost) =
    let pending = (store.turn).commitment
    in let remaining = choice-remaining store (pending.deadline) game-clock-ms
    in "{\"nonce\":" & show (pending.nonce) & ",\"ability\":true,\"source\":" & show (pending.source) & ",\"index\":" & show (pending.ability) & ",\"name\":" & jstr name & ",\"description\":" & jstr description & ",\"cost\":" & jstr cost & ",\"rays\":" & show (pending.rays) & ",\"all-rays\":" & jbool (pending.all-rays) & ",\"recommended\":" & show (pending.recommended) & ",\"targets\":[" & target-choices-json (store.game) (pending.choices) & "],\"remaining-ms\":" & show (if remaining > 0 then remaining else 0) & "}"

  handle-game-sacrifice-policy : MagicStore, Text -> MagicStep
  handle-game-sacrifice-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | enabled < 0 | enabled > 1 then magic-respond-error store "invalid sacrifice policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = enabled == 1, disruption-pause = p.disruption-pause })
    in handle-game-state (__record-set (update-store-game store (store.game) (store.game-active)) "orders" changed)

  stance-index : Stance -> Integer
  stance-index (s) = when s is Balanced -> 0 is Aggressive -> 1 is Defensive -> 2 is Tempo -> 3 is Control -> 4

  stance-at : Integer -> Stance
  stance-at (n) = if n == 1 then Aggressive else if n == 2 then Defensive else if n == 3 then Tempo else if n == 4 then Control else Balanced

  posture-json : GameState, Posture -> Text
  posture-json (gs) (p) = "{\"stance\":" & show (stance-index (p.stance)) & ",\"skill\":" & show (p.skill) & ",\"freeze\":" & jbool (posture-freezes p ai-stage-attackers) & ",\"freezes\":[" & freezes-json p 0 "" & "],\"auto-block\":" & jbool (p.block-policy /= ManualBlock) & ",\"block-policy\":" & show (block-policy-index (p.block-policy)) & ",\"block-threshold\":" & show (block-policy-threshold (p.block-policy)) & ",\"spell-policy\":" & show (spell-policy-index (p.spell-policy)) & ",\"ray-reserve\":" & show (spell-policy-reserve (p.spell-policy)) & ",\"preserved-stones\":" & show (p.preserved-stones) & ",\"manual-payment\":" & jbool (p.manual-payment) & ",\"commitment-pause\":" & jbool (p.commitment-pause) & ",\"combat-pause\":" & jbool (p.combat-pause) & ",\"target-pause\":" & jbool (p.target-pause) & ",\"disruption-pause\":" & jbool (p.disruption-pause) & ",\"sacrifice-pause\":" & jbool (p.sacrifice-pause) & ",\"targets\":[" & target-orders-json gs (p.primary-targets) 0 "" & "]}"

  handle-game-mana : MagicStore, Text -> MagicStep
  handle-game-mana (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let stone = game-query-id (extract-query-param line "stone")
    in let keep = game-query-id (extract-query-param line "keep")
    in if player < 0 | player > 1 | stone < 0 | stone > 6 | keep < 0 | keep > 1 then magic-respond-error store "invalid mana order"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let old = stone-preserved (p.preserved-stones) stone
    in let mask = if old == (keep == 1) then p.preserved-stones else if keep == 1 then p.preserved-stones + stone-mask-bit stone else p.preserved-stones - stone-mask-bit stone
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = mask, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  block-policy-index : BlockPolicy -> Integer
  block-policy-index (policy) = when policy is AutoBlock -> 0 is ManualBlock -> 1 is NoBlock -> 2 is ProtectLife (limit) -> 3

  block-policy-threshold : BlockPolicy -> Integer
  block-policy-threshold (policy) = when policy is ProtectLife (limit) -> limit is otherwise -> 10

  handle-game-block-policy : MagicStore, Text -> MagicStep
  handle-game-block-policy (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let mode = game-query-id (extract-query-param line "policy")
    in let limit = game-query-id (extract-query-param line "threshold")
    in if player < 0 | player > 1 | mode < 0 | mode > 3 | limit < 1 | limit > 999 then magic-respond-error store "invalid block policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let chosen = if mode == 1 then ManualBlock else if mode == 2 then NoBlock else if mode == 3 then ProtectLife limit else AutoBlock
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = chosen, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  handle-game-payment-mode : MagicStore, Text -> MagicStep
  handle-game-payment-mode (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let manual = game-query-id (extract-query-param line "manual")
    in if player < 0 | player > 1 | manual < 0 | manual > 1 then magic-respond-error store "invalid payment mode"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = manual == 1, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  spell-policy-index : SpellPolicy -> Integer
  spell-policy-index (policy) = when policy is PlayOnCurve -> 0 is HoldCounters -> 1 is ConserveMana (amount) -> 2 is ManualSpells -> 3

  spell-policy-reserve : SpellPolicy -> Integer
  spell-policy-reserve (policy) = when policy is ConserveMana (amount) -> amount is otherwise -> 0

  handle-game-spells : MagicStore, Text -> MagicStep
  handle-game-spells (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let policy = game-query-id (extract-query-param line "policy")
    in let reserve = game-query-id (extract-query-param line "reserve")
    in if player < 0 | player > 1 | policy < 0 | policy > 3 | reserve < 0 | reserve > 999 then magic-respond-error store "invalid spell policy"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let chosen = if policy == 1 then HoldCounters else if policy == 2 then ConserveMana reserve else if policy == 3 then ManualSpells else PlayOnCurve
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = chosen, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  freezes-json : Posture, Integer, Text -> Text
  freezes-json (p) (i) (acc) =
    if i >= ai-stage-done then acc
    else freezes-json p (i + 1) (acc & (if i == 0 then "" else ",") & "{\"phase\":" & show i & ",\"label\":" & jstr (ai-stage-name i) & ",\"enabled\":" & jbool (posture-freezes p i) & "}")

  handle-game-freeze : MagicStore, Text -> MagicStep
  handle-game-freeze (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let phase = game-query-id (extract-query-param line "phase")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if player < 0 | player > 1 | phase < 0 | phase >= ai-stage-done | enabled < 0 | enabled > 1 then magic-respond-error store "invalid phase freeze"
    else let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = p.primary-targets, phase-freezes = set-phase-freeze (p.phase-freezes) phase (enabled == 1), block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  target-orders-json : GameState, List TargetOrder, Integer, Text -> Text
  target-orders-json (gs) (orders) (i) (acc) =
    if i >= list-length orders then acc
    else target-orders-json gs orders (i + 1) (acc & (if i == 0 then "" else ",") & "{\"label\":" & jstr (target-order-label gs (list-at orders i)) & "}")

  target-order-label : GameState, TargetOrder -> Text
  target-order-label (gs) (order) = when order
    is PriorityGeneral -> "Enemy General"
    is PriorityPermanent (id) -> (if list-contains (gs.battlefield) (\p -> p.id == id) then (get-template gs ((find-permanent (gs.battlefield) id 0 (list-length (gs.battlefield))).template-id)).name else "Departed permanent")
    is PriorityType (kind) -> card-type-name kind
    is PriorityThreat (level) -> (if level == 0 then "High threat" else if level == 1 then "Medium threat" else "Low threat")

  same-target-order : TargetOrder, TargetOrder -> Boolean
  same-target-order (a) (b) = when a
    is PriorityGeneral -> (when b is PriorityGeneral -> True is otherwise -> False)
    is PriorityPermanent (id) -> (when b is PriorityPermanent (other) -> id == other is otherwise -> False)
    is PriorityType (kind) -> (when b is PriorityType (other) -> kind == other is otherwise -> False)
    is PriorityThreat (level) -> (when b is PriorityThreat (other) -> level == other is otherwise -> False)

  live-target-orders : GameState, Integer, List TargetOrder, Integer, List TargetOrder -> List TargetOrder
  live-target-orders (gs) (player) (orders) (i) (acc) =
    if i >= list-length orders then acc
    else let order = list-at orders i
    in let live = when order is PriorityPermanent (id) -> list-contains (gs.battlefield) (\p -> p.id == id & p.controller /= player) is otherwise -> True
    in live-target-orders gs player orders (i + 1) (if live then list-push acc order else acc)

  set-target-orders : MagicStore, Integer, List TargetOrder -> MagicStep
  set-target-orders (store) (player) (targets) =
    let orders = for p in store.orders -> p
    in let p = list-at orders player
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = p.stance, primary-targets = targets, phase-freezes = p.phase-freezes, block-policy = p.block-policy, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  append-target-order : MagicStore, Integer, TargetOrder -> MagicStep
  append-target-order (store) (player) (order) =
    let targets = live-target-orders (store.game) player ((list-at (store.orders) player).primary-targets) 0 []
    in set-target-orders store player (if list-contains targets (\t -> same-target-order t order) then targets else list-push targets order)

  target-types : List CardType
  target-types = [Gemstone, Creature, Equipment, Cantrip, Incantation, Disruption, Enchantment, General]

  target-type-index : Text, Integer -> Integer
  target-type-index (name) (i) = if i >= list-length target-types then 0 - 1 else if card-type-name (list-at target-types i) == name then i else target-type-index name (i + 1)

  remove-target-order : List TargetOrder, Integer, Integer, List TargetOrder -> List TargetOrder
  remove-target-order (orders) (index) (i) (acc) =
    if i >= list-length orders then acc
    else remove-target-order orders index (i + 1) (if i == index then acc else list-push acc (list-at orders i))

  handle-game-target : MagicStore, Text -> MagicStep
  handle-game-target (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let kind = extract-query-param line "kind"
    in if player < 0 | player > 1 then magic-respond-error store "invalid target player"
    else if kind == "clear" then set-target-orders store player []
    else if kind == "general" then append-target-order store player PriorityGeneral
    else if kind == "permanent" then
      (let id = game-query-id (extract-query-param line "id")
       in if id < 0 | list-contains ((store.game).battlefield) (\p -> p.id == id & p.controller /= player) == False then magic-respond-error store "target is not an opposing permanent"
       else append-target-order store player (PriorityPermanent id))
    else if kind == "type" then
      (let index = target-type-index (extract-query-param line "type") 0
       in if index < 0 then magic-respond-error store "invalid target type" else append-target-order store player (PriorityType (list-at target-types index)))
    else if kind == "threat" then
      (let level = game-query-id (extract-query-param line "level")
       in if level < 0 | level > 2 then magic-respond-error store "invalid threat level" else append-target-order store player (PriorityThreat level))
    else if kind == "remove" then
      (let index = game-query-id (extract-query-param line "index")
       in let targets = (list-at (store.orders) player).primary-targets
       in if index < 0 | index >= list-length targets then magic-respond-error store "invalid target index" else set-target-orders store player (remove-target-order targets index 0 []))
    else magic-respond-error store "invalid target order"

  handle-game-posture : MagicStore, Text -> MagicStep
  handle-game-posture (store) (line) =
    let player = game-query-id (extract-query-param line "player")
    in let stance = game-query-id (extract-query-param line "stance")
    in let freeze = game-query-id (extract-query-param line "freeze")
    in let raw-blocks = extract-query-param line "blocks"
    in let blocks = game-query-id raw-blocks
    in if player < 0 | player > 1 | stance < 0 | stance > 4 | freeze < 0 | freeze > 1 | (raw-blocks /= "" & (blocks < 0 | blocks > 1)) then magic-respond-error store "invalid posture"
    else let orders = for p in store.orders -> p
    in let p = list-at (store.orders) player
    in let chosen = if raw-blocks == "" then p.block-policy else if blocks == 1 then AutoBlock else ManualBlock
    in let changed = list-set-at orders player (Posture { skill = p.skill, stance = stance-at stance, primary-targets = p.primary-targets, phase-freezes = set-phase-freeze (p.phase-freezes) ai-stage-attackers (freeze == 1), block-policy = chosen, spell-policy = p.spell-policy, preserved-stones = p.preserved-stones, manual-payment = p.manual-payment, commitment-pause = p.commitment-pause, target-pause = p.target-pause, combat-pause = p.combat-pause, sacrifice-pause = p.sacrifice-pause, disruption-pause = p.disruption-pause })
    in let next = update-store-game store (store.game) (store.game-active)
    in handle-game-state (__record-set next "orders" changed)

  handle-game-attack : MagicStore, Text -> MagicStep
  handle-game-attack (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let id = game-query-id (extract-query-param line "attacker")
    in let enabled = game-query-id (extract-query-param line "enabled")
    in if store.game-active == False | enabled < 0 | enabled > 1 | supervised-attack-ready (store.turn) id == False then magic-respond-error store "illegal attacker choice"
    else handle-game-state (store-turn store (supervised-attack (store.turn) id (enabled == 1)) True)

  handle-game-block : MagicStore, Text -> MagicStep
  handle-game-block (store) (line) =
    if store.pause-active then magic-respond-error store "game is paused"
    else let raw = extract-query-param line "blocker"
    in let blocker = if raw == "general" then general-block-id (if (store.game).active-player == 0 then 1 else 0) else game-query-id raw
    in let attacker = game-query-id (extract-query-param line "attacker")
    in if (raw /= "general" & blocker < 0) | attacker < 0 then magic-respond-error store "illegal block"
    else let old = (store.turn).combat
    in let count = old.num-blockers
    in let turn = supervised-block (store.turn) blocker attacker
    in if (turn.combat).num-blockers == count then magic-respond-error store "illegal block"
    else handle-game-state (store-turn store turn (store.game-active))

Section: Pool Handler

  handle-pool : MagicStore -> MagicStep
  handle-pool (store) =
    let cards-json = templates-to-json-str (store.templates) 0 (list-length (store.templates)) ""
    in magic-respond-json store ("{\"cards\":[" & cards-json & "],\"count\":" & show (list-length (store.templates)) & "}")

Section: Rules Handler

  handle-rules : MagicStore -> MagicStep
  handle-rules (store) =
    magic-respond-json store ("{\"deck\":{\"minSize\":60,\"maxCopies\":4,\"minGemsRecommended\":15,\"gemTarget\":24,\"spellTarget\":36},\"pack\":{\"commons\":10,\"uncommons\":3,\"rareOrMythic\":1,\"wildcards\":1,\"mythicChance\":\"1/8\"},\"packCost\":{\"standard\":100,\"premium\":300,\"draft\":250},\"tierBonus\":{\"Free\":0,\"Bronze\":1,\"Silver\":2,\"Gold\":3,\"Platinum\":5},\"starterBalance\":500,\"colors\":[\"Red\",\"Yellow\",\"Blue\",\"Orange\",\"Green\",\"Purple\"],\"gemstones\":[\"Ruby\",\"Topaz\",\"Sapphire\",\"Carnelian\",\"Emerald\",\"Diamond\",\"Obsidian\"],\"spellSpeeds\":[\"cantrip\",\"incantation\",\"summoning\",\"disruption\"],\"cardTypes\":[\"Gemstone\",\"Creature\",\"Equipment\",\"Cantrip\",\"Incantation\",\"Disruption\",\"Enchantment\"],\"equipSlots\":[\"Weapon\",\"Shield\",\"Helmet\",\"Armor\",\"Gloves\",\"Boots\",\"Ring\",\"Amulet\"],\"phases\":[{\"step\":0,\"name\":\"Untap\"},{\"step\":1,\"name\":\"Upkeep\"},{\"step\":2,\"name\":\"Draw\"},{\"step\":3,\"name\":\"Pre-combat Main\"},{\"step\":4,\"name\":\"Declare Attackers\"},{\"step\":5,\"name\":\"Declare Blockers\"},{\"step\":6,\"name\":\"Combat Damage\"},{\"step\":7,\"name\":\"End Combat\"},{\"step\":8,\"name\":\"Post-combat Main\"},{\"step\":9,\"name\":\"Cleanup\"}]}")

Section: Deck Handler

  handle-deck : MagicStore, Text, Text -> MagicStep
  handle-deck (store) (line) (path) =
    if text-starts-with path "/api/magic/deck/generate" then
      let gen-id = parse-int (extract-query-param line "general") 0
      in let seed = parse-int (extract-query-param line "seed") 42
      in let gen = get-general-by-id (store.generals) gen-id
      in (when gen-starter-deck gen (store.templates) seed
        is StarterRefused (why) -> magic-respond-error store why
        is StarterDeck (deck) ->
          let cards-json = int-list-to-str (deck.cards) 0 (deck.num-cards) ""
          in magic-respond-json store ("{\"cards\":[" & cards-json & "],\"count\":" & show (deck.num-cards) & ",\"general\":" & show gen-id & "}"))
    else if text-starts-with path "/api/magic/deck/validate" then
      let result = deck-query-validation store line
      in magic-respond-json store ("{\"valid\":" & jbool result.valid & ",\"reason\":" & jstr result.reason & "}")
    else magic-respond-not-found store

  deck-query-validation : MagicStore, Text -> ValidationResult
  deck-query-validation (store) (line) =
    let general = extract-query-param line "general"
    in let id = if general == "" then 0 else game-query-id general
    in if list-contains (store.generals) (\g -> g.id == id) == False then validate-fail ("Unknown General: " & (if general == "" then "0" else general))
    else let format = extract-query-param line "format"
    in if format /= "" & format /= "standard" & format /= "Standard" then validate-fail ("Unsupported deck format: " & format & "; expected Standard")
    else let raw = extract-query-param line "cards"
    in let decoded = text-replace (text-replace raw "%2C" ",") "%2c" ","
    in let parts = if decoded == "" then [] else text-split decoded ","
    in let cards = for part in parts -> game-query-id part
    in let ids = deck-query-ids parts cards (store.templates) 0
    in if ids.valid == False then ids
    else validate-deck (make-deck id cards FormatStandard) (store.templates) (get-general-by-id (store.generals) id)

  deck-query-ids : List Text, List Integer, List CardTemplate, Integer -> ValidationResult
  deck-query-ids (parts) (cards) (templates) (i) =
    if i >= list-length cards then validate-ok
    else let id = list-at cards i
    in if id < 0 then validate-fail ("Invalid card template ID at position " & show (i + 1) & ": " & list-at parts i)
    else if id >= list-length templates then validate-fail ("Unknown card template ID: " & show id)
    else let t = list-at templates id
    in if t.is-token then validate-fail (t.name & " is a token and cannot appear in the deck")
    else when t.card-type
      is General -> validate-fail (t.name & " is a General and cannot appear in the deck")
      is otherwise -> deck-query-ids parts cards templates (i + 1)

Section: Store Handler

  handle-store : MagicStore, Text, Text -> MagicStep
  handle-store (store) (line) (path) =
    if text-starts-with path "/api/magic/store/crack" then handle-crack-pack store line
    else if text-starts-with path "/api/magic/store/balance" then handle-balance store line
    else if text-starts-with path "/api/magic/store/buy-coin" then handle-buy-coin store line
    else if text-starts-with path "/api/magic/store/generals" then handle-generals-list store
    else magic-respond-not-found store

  handle-crack-pack : MagicStore, Text -> MagicStep
  handle-crack-pack (store) (line) =
    let acct-id = parse-int (extract-query-param line "account") 0
    in let seed = parse-int (extract-query-param line "seed") 42
    in let cost = 100
    in let bal = ledger-balance (store.ledger) acct-id
    in if bal < cost then magic-respond-error store "insufficient mana coin"
    else let acct = get-account (store.accounts) acct-id
    in let sub-bonus = sub-upgrade-bonus (acct.subscription)
    in let ledger2 = ledger-burn (store.ledger) acct-id cost
    in let pack = crack-pack (store.templates) seed sub-bonus
    in let tokens2 = mint-pack-cards (store.tokens) (pack.cards) acct-id seed 0 (pack.num-cards)
    in let cards-json = int-list-to-str (pack.cards) 0 (pack.num-cards) ""
    in let ns = update-store-tokens store tokens2 ledger2
    in magic-respond-json ns ("{\"cards\":[" & cards-json & "],\"count\":" & show (pack.num-cards) & ",\"balance\":" & show (ledger-balance ledger2 acct-id) & ",\"tokens-minted\":" & show (list-length tokens2) & "}")

  mint-pack-cards : List CardToken, List Integer, Integer, Integer, Integer, Integer -> List CardToken
  mint-pack-cards (tokens) (cards) (owner) (time) (i) (len) =
    if i >= len then tokens
    else let tokens2 = mint-token tokens (list-at cards i) owner time MintPack
    in mint-pack-cards tokens2 cards owner time (i + 1) len

  handle-balance : MagicStore, Text -> MagicStep
  handle-balance (store) (line) =
    let acct-id = parse-int (extract-query-param line "account") 0
    in let bal = ledger-balance (store.ledger) acct-id
    in let acct = get-account (store.accounts) acct-id
    in magic-respond-json store ("{\"balance\":" & show bal & ",\"sub-tier\":" & jstr (sub-tier-name (acct.subscription)) & ",\"tokens-owned\":" & show (count-tokens-owned (store.tokens) acct-id 0 (list-length (store.tokens)) 0) & "}")

  count-tokens-owned : List CardToken, Integer, Integer, Integer, Integer -> Integer
  count-tokens-owned (tokens) (owner) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at tokens i
    in if t.owner == owner then count-tokens-owned tokens owner (i + 1) len (acc + 1)
    else count-tokens-owned tokens owner (i + 1) len acc

  handle-buy-coin : MagicStore, Text -> MagicStep
  handle-buy-coin (store) (line) =
    let acct-id = parse-int (extract-query-param line "account") 0
    in let amount = parse-int (extract-query-param line "amount") 100
    in let ledger2 = ledger-mint (store.ledger) acct-id amount
    in let ns = update-store-ledger store ledger2
    in magic-respond-json ns ("{\"balance\":" & show (ledger-balance ledger2 acct-id) & ",\"minted\":" & show amount & "}")

  handle-generals-list : MagicStore -> MagicStep
  handle-generals-list (store) =
    let json = generals-list-to-json (store.generals) 0 (list-length (store.generals)) ""
    in magic-respond-json store ("{\"generals\":[" & json & "]}")

  generals-list-to-json : List GeneralTemplate, Integer, Integer, Text -> Text
  generals-list-to-json (generals) (i) (len) (acc) =
    if i >= len then acc
    else let g = list-at generals i
    in let sep = if i > 0 then "," else ""
    in let gj = sep & "{\"id\":" & show (g.id) & ",\"name\":" & jstr (g.name) & ",\"power\":" & show (g.power) & ",\"toughness\":" & show (g.toughness) & ",\"defense\":" & show (g.defense) & ",\"life\":" & show (g.life) & "}"
    in generals-list-to-json generals (i + 1) len (acc & gj)

Section: Queue Handler

  handle-queue : MagicStore, Text, Text -> MagicStep
  handle-queue (store) (line) (path) =
    if text-starts-with path "/api/magic/queue/join" then handle-queue-join store line
    else if text-starts-with path "/api/magic/queue/status" then handle-queue-status store line
    else magic-respond-not-found store

  handle-queue-join : MagicStore, Text -> MagicStep
  handle-queue-join (store) (line) =
    let acct-id = parse-int (extract-query-param line "account") 0
    in let format-str = extract-query-param line "format"
    in let tier-str = extract-query-param line "tier"
    in let acct = get-account (store.accounts) acct-id
    in magic-respond-json store ("{\"queued\":true,\"account\":" & show acct-id & ",\"format\":" & jstr format-str & ",\"tier\":" & jstr tier-str & ",\"rating\":" & show (acct.rating) & ",\"rank\":" & jstr (rank-name (acct.rank)) & ",\"match-id\":1,\"status\":\"matched\"}")

  handle-queue-status : MagicStore, Text -> MagicStep
  handle-queue-status (store) (line) =
    magic-respond-json store "{\"status\":\"matched\",\"match-id\":1,\"wait-time\":0}"

Section: Match Handler

  handle-match : MagicStore, Text, Text -> MagicStep
  handle-match (store) (line) (path) =
    if text-starts-with path "/api/magic/match/result" then handle-match-result store
    else if text-starts-with path "/api/magic/match/history" then handle-match-history store line
    else magic-respond-not-found store

  handle-match-result : MagicStore -> MagicStep
  handle-match-result (store) =
    let mr = store.match-record
    in magic-respond-json store ("{\"match-id\":" & show (mr.match-id) & ",\"winner\":" & show (mr.winner) & ",\"turns\":" & show (mr.turns-played) & ",\"life-a\":" & show (mr.final-life-a) & ",\"life-b\":" & show (mr.final-life-b) & ",\"loyalty-a\":" & show (mr.final-loyalty-a) & ",\"loyalty-b\":" & show (mr.final-loyalty-b) & ",\"actions\":" & show (mr.action-count) & "}")

  handle-match-history : MagicStore, Text -> MagicStep
  handle-match-history (store) (line) =
    let acct-id = parse-int (extract-query-param line "account") 0
    in let acct = get-account (store.accounts) acct-id
    in magic-respond-json store ("{\"account\":" & show acct-id & ",\"wins\":" & show (acct.wins) & ",\"losses\":" & show (acct.losses) & ",\"rating\":" & show (acct.rating) & ",\"rank\":" & jstr (rank-name (acct.rank)) & "}")

Section: Auth Handler

  handle-auth : MagicStore, Text, Text -> MagicStep
  handle-auth (store) (line) (path) =
    if text-starts-with path "/api/magic/auth/register" then handle-register store line
    else if text-starts-with path "/api/magic/auth/login" then handle-login store line
    else if text-starts-with path "/api/magic/auth/me" then handle-me store line
    else if text-starts-with path "/api/magic/auth/logout" then handle-logout store line
    else if text-starts-with path "/api/magic/auth/profile" then handle-web-profile store line
    else if text-starts-with path "/api/magic/auth/collection" then handle-collection store line
    else if text-starts-with path "/api/magic/auth/wipe-collection" then handle-wipe-collection store line
    else if text-starts-with path "/api/magic/auth/challenge" then handle-auth-challenge store line
    else if text-starts-with path "/api/magic/auth/verify" then handle-auth-verify store line
    else magic-respond-not-found store

  handle-register : MagicStore, Text -> MagicStep
  handle-register (store) (line) =
    let handle = extract-query-param line "u"
    in let display = extract-query-param line "d"
    in let pw = extract-query-param line "p"
    in let pw-sc = score-pw pw
    in let is-first = store.num-accounts == 0
    in if text-length handle < 2 then magic-respond-error store "handle too short"
    else if text-length pw < 5 then magic-respond-error store "password too short"
    else if find-account-by-handle (store.accounts) handle 0 (store.num-accounts) >= 0 then magic-respond-error store "handle already taken"
    else let disp = if text-length display > 0 then display else handle
    in let acct = account-new (store.num-accounts) handle disp pw pw-sc SubFree
    in let acct2 = if is-first then set-account-admin acct True else acct
    in let session = "s" & show (store.next-nonce)
    in let acct3 = set-account-session acct2 session
    in let new-accts = list-push (store.accounts) acct3
    in let ledger2 = ledger-mint (store.ledger) (store.num-accounts) 500
    in let ns = update-store-accounts store new-accts (store.num-accounts + 1)
    in let ns2 = update-store-ledger ns ledger2
    in magic-respond-json ns2 ("{\"token\":" & jstr session & ",\"handle\":" & jstr handle & ",\"display\":" & jstr disp & ",\"id\":" & show (acct3.account-id) & ",\"admin\":" & jbool (acct3.admin) & ",\"starterGrant\":true,\"starterBalance\":500}")

  handle-login : MagicStore, Text -> MagicStep
  handle-login (store) (line) =
    let handle = extract-query-param line "u"
    in let pw = extract-query-param line "p"
    in let idx = find-account-by-handle (store.accounts) handle 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "unknown handle"
    else let acct = list-at (store.accounts) idx
    in if acct.banned then magic-respond-error store "account banned"
    else if acct.password /= pw then magic-respond-error store "wrong password"
    else let session = "s" & show (store.next-nonce)
    in let acct2 = set-account-session acct session
    in let new-accts = list-set-at (store.accounts) idx acct2
    in let ns = update-store-accounts store new-accts (store.num-accounts)
    in magic-respond-json ns ("{\"token\":" & jstr session & ",\"handle\":" & jstr handle & ",\"display\":" & jstr (acct2.display-name) & ",\"id\":" & show (acct2.account-id) & ",\"admin\":" & jbool (acct2.admin) & "}")

  handle-me : MagicStore, Text -> MagicStep
  handle-me (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "not authenticated"
    else let acct = list-at (store.accounts) idx
    in magic-respond-json store ("{\"handle\":" & jstr (acct.handle) & ",\"display\":" & jstr (acct.display-name) & ",\"id\":" & show (acct.account-id) & ",\"admin\":" & jbool (acct.admin) & "}")

  handle-logout : MagicStore, Text -> MagicStep
  handle-logout (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-json store "{\"ok\":true}"
    else let acct = list-at (store.accounts) idx
    in let acct2 = set-account-session acct ""
    in let new-accts = list-set-at (store.accounts) idx acct2
    in let ns = update-store-accounts store new-accts (store.num-accounts)
    in magic-respond-json ns "{\"ok\":true}"

  handle-web-profile : MagicStore, Text -> MagicStep
  handle-web-profile (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "not authenticated"
    else let acct = list-at (store.accounts) idx
    in let bal = ledger-balance (store.ledger) (acct.account-id)
    in let token-count = count-tokens-owned (store.tokens) (acct.account-id) 0 (list-length (store.tokens)) 0
    in magic-respond-json store ("{\"handle\":" & jstr (acct.handle) & ",\"display\":" & jstr (acct.display-name) & ",\"id\":" & show (acct.account-id) & ",\"admin\":" & jbool (acct.admin) & ",\"balance\":" & show bal & ",\"tokens\":" & show token-count & ",\"wins\":" & show (acct.wins) & ",\"losses\":" & show (acct.losses) & ",\"rating\":" & show (acct.rating) & ",\"subscription\":" & jstr (sub-tier-name (acct.subscription)) & ",\"clanId\":" & show (acct.clan-id) & "}")

  handle-collection : MagicStore, Text -> MagicStep
  handle-collection (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-json store "{\"cards\":[],\"total\":0}"
    else let acct = list-at (store.accounts) idx
    in let owned = collect-tokens-for-account (store.tokens) (acct.account-id) 0 (list-length (store.tokens)) ""
    in let total = count-tokens-owned (store.tokens) (acct.account-id) 0 (list-length (store.tokens)) 0
    in magic-respond-json store ("{\"cards\":[" & owned & "],\"total\":" & show total & "}")

  handle-wipe-collection : MagicStore, Text -> MagicStep
  handle-wipe-collection (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "not authenticated"
    else let acct = list-at (store.accounts) idx
    in if acct.admin == False then magic-respond-error store "admin only"
    else let count = count-tokens-owned (store.tokens) (acct.account-id) 0 (list-length (store.tokens)) 0
    in let new-tokens = remove-tokens-for-account (store.tokens) (acct.account-id) 0 (list-length (store.tokens)) []
    in let ns = update-store-tokens store new-tokens (store.ledger)
    in magic-respond-json ns ("{\"ok\":true,\"wiped\":" & show count & "}")

  find-account-by-handle : List PlayerAccount, Text, Integer, Integer -> Integer
  find-account-by-handle (accts) (handle) (i) (len) =
    if i >= len then -1
    else let a = list-at accts i
    in if a.handle == handle then i
    else find-account-by-handle accts handle (i + 1) len

  find-account-by-session : List PlayerAccount, Text, Integer, Integer -> Integer
  find-account-by-session (accts) (tok) (i) (len) =
    if i >= len then -1
    else if text-length tok == 0 then -1
    else let a = list-at accts i
    in if a.session-token == tok then i
    else find-account-by-session accts tok (i + 1) len

  set-account-session : PlayerAccount, Text -> PlayerAccount
  set-account-session (a) (tok) = PlayerAccount { account-id = a.account-id, name = a.name, handle = a.handle, display-name = a.display-name, password = a.password, pw-score = a.pw-score, balance = a.balance, admin = a.admin, banned = a.banned, clan-id = a.clan-id, roles = a.roles, session-token = tok, rating = a.rating, rank = a.rank, wins = a.wins, losses = a.losses, general-id = a.general-id, subscription = a.subscription }

  set-account-admin : PlayerAccount, Boolean -> PlayerAccount
  set-account-admin (a) (is-admin) = PlayerAccount { account-id = a.account-id, name = a.name, handle = a.handle, display-name = a.display-name, password = a.password, pw-score = a.pw-score, balance = a.balance, admin = is-admin, banned = a.banned, clan-id = a.clan-id, roles = a.roles, session-token = a.session-token, rating = a.rating, rank = a.rank, wins = a.wins, losses = a.losses, general-id = a.general-id, subscription = a.subscription }

  score-pw : Text -> Integer
  score-pw (p) =
    if text-length p < 5 then 0
    else 1 + (if text-length p >= 8 then 1 else 0) + (if text-length p >= 12 then 1 else 0)

  collect-tokens-for-account : List CardToken, Integer, Integer, Integer, Text -> Text
  collect-tokens-for-account (tokens) (owner) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at tokens i
    in if t.owner == owner then
      let sep = if text-length acc > 0 then "," else ""
      in let entry = sep & "{\"cardId\":" & show (t.card-template-id) & ",\"rarity\":\"Common\",\"count\":1}"
      in collect-tokens-for-account tokens owner (i + 1) len (acc & entry)
    else collect-tokens-for-account tokens owner (i + 1) len acc

  remove-tokens-for-account : List CardToken, Integer, Integer, Integer, List CardToken -> List CardToken
  remove-tokens-for-account (tokens) (owner) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at tokens i
    in if t.owner == owner then remove-tokens-for-account tokens owner (i + 1) len acc
    else remove-tokens-for-account tokens owner (i + 1) len (list-push acc t)

  handle-auth-challenge : MagicStore, Text -> MagicStep
  handle-auth-challenge (store) (line) =
    let challenge = generate-challenge (store.next-nonce)
    in let ns = store-set store (store.game) (store.game-active) (store.accounts) (store.num-accounts) (store.tokens) (store.ledger) (store.platform) (store.next-token-id)
    in magic-respond-json ns ("{\"nonce\":" & show (challenge.nonce) & ",\"timestamp\":" & show (challenge.timestamp) & "}")

  handle-auth-verify : MagicStore, Text -> MagicStep
  handle-auth-verify (store) (line) =
    let acct-id = parse-int (extract-query-param line "id") 0
    in let nonce = parse-int (extract-query-param line "nonce") 0
    in let sig-high = parse-int (extract-query-param line "sig-high") 0
    in let sig-low = parse-int (extract-query-param line "sig-low") 0
    in let token = AuthToken { account-id = acct-id, nonce = nonce, signature-high = sig-high, signature-low = sig-low }
    in let pubkey = find-account-key (store.account-keys) acct-id 0 (list-length (store.account-keys))
    in let valid = verify-signature token pubkey
    in if valid then
      let session = create-session acct-id (store.next-nonce) 3600
      in let ns = store-set store (store.game) (store.game-active) (store.accounts) (store.num-accounts) (store.tokens) (store.ledger) (store.platform) (store.next-token-id)
      in magic-respond-json ns ("{\"verified\":true,\"session-id\":" & show (session.session-id) & ",\"expires\":" & show (session.expires-at) & "}")
    else magic-respond-error store "signature verification failed"

Section: Account Handler

  handle-account : MagicStore, Text, Text -> MagicStep
  handle-account (store) (line) (path) =
    if text-starts-with path "/api/magic/account/new" then handle-account-new store line
    else if text-starts-with path "/api/magic/account/profile" then handle-account-profile store line
    else if text-starts-with path "/api/magic/account/subscribe" then handle-subscribe store line
    else magic-respond-not-found store

  handle-account-new : MagicStore, Text -> MagicStep
  handle-account-new (store) (line) =
    let name = extract-query-param line "name"
    in let gen-id = parse-int (extract-query-param line "general") 0
    in let pk-high = parse-int (extract-query-param line "pk-high") 0
    in let pk-low = parse-int (extract-query-param line "pk-low") 0
    in let display-name = if text-length name == 0 then "Player-" & show (store.num-accounts + 1) else name
    in let acct = account-new (store.num-accounts) display-name display-name "" 0 SubFree
    in let new-accts = list-push (store.accounts) acct
    in let ledger2 = ledger-mint (store.ledger) (store.num-accounts) 500
    in let pubkey = PublicKey { key-high = pk-high, key-low = pk-low }
    in let ak = account-key-new (store.num-accounts) pubkey (store.next-nonce)
    in let new-keys = list-push (store.account-keys) ak
    in let ns = update-store-accounts store new-accts (store.num-accounts + 1)
    in let ns2 = update-store-ledger ns ledger2
    in magic-respond-json ns2 ("{\"account-id\":" & show (acct.account-id) & ",\"name\":" & jstr display-name & ",\"rating\":" & show (acct.rating) & ",\"rank\":" & jstr (rank-name (acct.rank)) & ",\"balance\":500,\"public-key\":" & jstr (format-public-key pubkey) & "}")

  handle-account-profile : MagicStore, Text -> MagicStep
  handle-account-profile (store) (line) =
    let acct-id = parse-int (extract-query-param line "id") 0
    in let acct = get-account (store.accounts) acct-id
    in let bal = ledger-balance (store.ledger) acct-id
    in let token-count = count-tokens-owned (store.tokens) acct-id 0 (list-length (store.tokens)) 0
    in magic-respond-json store ("{\"account-id\":" & show (acct.account-id) & ",\"name\":" & jstr (acct.name) & ",\"rating\":" & show (acct.rating) & ",\"rank\":" & jstr (rank-name (acct.rank)) & ",\"wins\":" & show (acct.wins) & ",\"losses\":" & show (acct.losses) & ",\"balance\":" & show bal & ",\"tokens\":" & show token-count & ",\"subscription\":" & jstr (sub-tier-name (acct.subscription)) & "}")

  handle-subscribe : MagicStore, Text -> MagicStep
  handle-subscribe (store) (line) =
    let acct-id = parse-int (extract-query-param line "id") 0
    in let tier-str = extract-query-param line "tier"
    in let tier = parse-sub-tier tier-str
    in let acct = get-account (store.accounts) acct-id
    in let updated = PlayerAccount { account-id = acct.account-id, name = acct.name, handle = acct.handle, display-name = acct.display-name, password = acct.password, pw-score = acct.pw-score, balance = acct.balance, admin = acct.admin, banned = acct.banned, clan-id = acct.clan-id, roles = acct.roles, session-token = acct.session-token, rating = acct.rating, rank = acct.rank, wins = acct.wins, losses = acct.losses, general-id = acct.general-id, subscription = tier }
    in let new-accts = set-account (store.accounts) acct-id updated
    in let ns = update-store-accounts store new-accts (store.num-accounts)
    in magic-respond-json ns ("{\"account-id\":" & show acct-id & ",\"subscription\":" & jstr (sub-tier-name tier) & ",\"upgrade-bonus\":" & show (sub-upgrade-bonus tier) & "}")

  parse-sub-tier : Text -> SubscriptionTier
  parse-sub-tier (s) =
    if s == "bronze" then SubBronze
    else if s == "silver" then SubSilver
    else if s == "gold" then SubGold
    else if s == "platinum" then SubPlatinum
    else SubFree

  get-account : List PlayerAccount, Integer -> PlayerAccount
  get-account (accounts) (id) =
    if id >= list-length accounts then account-new 0 "unknown" "Unknown" "" 0 SubFree
    else list-at accounts id

  set-account : List PlayerAccount, Integer, PlayerAccount -> List PlayerAccount
  set-account (accounts) (id) (acct) =
    if id >= list-length accounts then accounts
    else list-set-at accounts id acct

Section: Season Handler

  handle-season : MagicStore -> MagicStep
  handle-season (store) =
    let s = store.current-season
    in magic-respond-json store ("{\"name\":" & jstr (s.name) & ",\"year\":" & show (s.id.year) & ",\"quarter\":" & show (s.id.quarter) & ",\"pool-size\":" & show (s.pool-size) & ",\"bans\":" & show (list-length (s.banned)) & ",\"active\":" & jbool (s.active) & "}")

Section: Status Handler

  handle-magic-status : MagicStore -> MagicStep
  handle-magic-status (store) =
    magic-respond-json store ("{\"server\":\"CodexMagic\",\"version\":3,\"cards\":" & show (list-length (store.templates)) & ",\"generals\":" & show (list-length (store.generals)) & ",\"accounts\":" & show (store.num-accounts) & ",\"tokens\":" & show (list-length (store.tokens)) & ",\"coin-supply\":" & show (store.ledger.total-supply) & ",\"game-active\":" & jbool (store.game-active) & ",\"clans\":" & show (platform-clan-count (store.platform)) & ",\"platform-revenue\":" & show (platform-total-revenue (store.platform)) & "}")

Section: State Persistence

  handle-state-dump : MagicStore -> MagicStep
  handle-state-dump (store) =
    let accts-json = dump-accounts (store.accounts) (store.ledger) (store.tokens) 0 (store.num-accounts) ""
    in magic-respond-json store ("{\"PoolVersion\":2,\"AuthNextId\":" & show (store.num-accounts) & ",\"NextTokenId\":" & show (store.next-token-id) & ",\"TotalMinted\":" & show (store.total-minted) & ",\"TotalBurned\":" & show (store.total-burned) & ",\"CoinForSale\":" & show (store.coin-for-sale) & ",\"CoinPrice\":" & show (store.coin-price) & ",\"accounts\":[" & accts-json & "]}")

  dump-accounts : List PlayerAccount, ManaCoinLedger, List CardToken, Integer, Integer, Text -> Text
  dump-accounts (accts) (led) (tokens) (i) (len) (acc) =
    if i >= len then acc
    else let a = list-at accts i
    in let sep = if i > 0 then "," else ""
    in let bal = ledger-balance led i
    in let owned-json = dump-owned-tokens tokens i 0 (list-length tokens) ""
    in let entry = sep & "{\"Id\":" & show (a.account-id) & ",\"Handle\":" & jstr (a.handle) & ",\"Display\":" & jstr (a.display-name) & ",\"Password\":" & jstr (a.password) & ",\"PwScore\":" & show (a.pw-score) & ",\"Admin\":" & jbool (a.admin) & ",\"Banned\":" & jbool (a.banned) & ",\"Balance\":" & show bal & ",\"Rating\":" & show (a.rating) & ",\"Wins\":" & show (a.wins) & ",\"Losses\":" & show (a.losses) & ",\"Subscription\":" & jstr (sub-tier-name (a.subscription)) & ",\"ClanId\":" & show (a.clan-id) & ",\"OwnedCards\":[" & owned-json & "]}"
    in dump-accounts accts led tokens (i + 1) len (acc & entry)

  dump-owned-tokens : List CardToken, Integer, Integer, Integer, Text -> Text
  dump-owned-tokens (tokens) (owner) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at tokens i
    in if t.owner == owner then
      let sep = if text-length acc > 0 then "," else ""
      in let entry = sep & "{\"cardId\":" & show (t.card-template-id) & ",\"rarity\":\"Common\",\"mintSource\":" & jstr (mint-source-name (t.mint-source)) & ",\"tokenId\":" & show (t.token-id) & "}"
      in dump-owned-tokens tokens owner (i + 1) len (acc & entry)
    else dump-owned-tokens tokens owner (i + 1) len acc

Section: Admin Handlers

  handle-admin : MagicStore, Text, Text -> MagicStep
  handle-admin (store) (line) (path) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "not authenticated"
    else let adm = list-at (store.accounts) idx
    in if adm.admin == False then magic-respond-error store "admin only"
    else if text-starts-with path "/api/magic/admin/check" then magic-respond-json store "{\"admin\":true}"
    else if text-starts-with path "/api/magic/admin/stats" then handle-admin-stats store
    else if text-starts-with path "/api/magic/admin/mint" then handle-admin-mint store line
    else if text-starts-with path "/api/magic/admin/grant" then handle-admin-grant store line
    else if text-starts-with path "/api/magic/admin/burn" then handle-admin-burn store line
    else if text-starts-with path "/api/magic/admin/users" then handle-admin-users store
    else magic-respond-not-found store

  handle-admin-stats : MagicStore -> MagicStep
  handle-admin-stats (store) =
    let circulating = ledger-total-circulating (store.ledger)
    in let supply = store.total-minted - store.total-burned
    in magic-respond-json store ("{\"supply\":" & show supply & ",\"minted\":" & show (store.total-minted) & ",\"burned\":" & show (store.total-burned) & ",\"circulating\":" & show circulating & ",\"forSale\":" & show (store.coin-for-sale) & ",\"coinPrice\":" & show (store.coin-price) & ",\"accounts\":" & show (store.num-accounts) & "}")

  ledger-total-circulating : ManaCoinLedger -> Integer
  ledger-total-circulating (led) = ledger-circ-loop (led.balances) 0 (list-length (led.balances)) 0

  ledger-circ-loop : List Integer, Integer, Integer, Integer -> Integer
  ledger-circ-loop (bals) (i) (len) (acc) =
    if i >= len then acc
    else ledger-circ-loop bals (i + 1) len (acc + list-at bals i)

  handle-admin-mint : MagicStore, Text -> MagicStep
  handle-admin-mint (store) (line) =
    let amt = parse-int (extract-query-param line "amount") 0
    in if amt <= 0 then magic-respond-error store "amount must be positive"
    else let ns = MagicStore { pause-active = store.pause-active, pause-remaining = store.pause-remaining, game = store.game, turn = store.turn, orders = store.orders, game-active = store.game-active, templates = store.templates, generals = store.generals, accounts = store.accounts, num-accounts = store.num-accounts, tokens = store.tokens, ledger = store.ledger, current-season = store.current-season, match-record = store.match-record, account-keys = store.account-keys, next-nonce = store.next-nonce, platform = store.platform, next-token-id = store.next-token-id, total-minted = store.total-minted + amt, total-burned = store.total-burned, coin-for-sale = store.coin-for-sale, coin-price = store.coin-price }
    in magic-respond-json ns ("{\"ok\":true,\"supply\":" & show (ns.total-minted - ns.total-burned) & ",\"minted\":" & show (ns.total-minted) & "}")

  handle-admin-grant : MagicStore, Text -> MagicStep
  handle-admin-grant (store) (line) =
    let handle = extract-query-param line "handle"
    in let amt = parse-int (extract-query-param line "amount") 0
    in let idx = find-account-by-handle (store.accounts) handle 0 (store.num-accounts)
    in if idx < 0 then magic-respond-error store "unknown handle"
    else if amt <= 0 then magic-respond-error store "amount must be positive"
    else let ledger2 = ledger-mint (store.ledger) idx amt
    in let ns = update-store-ledger store ledger2
    in magic-respond-json ns ("{\"ok\":true,\"balance\":" & show (ledger-balance ledger2 idx) & "}")

  handle-admin-burn : MagicStore, Text -> MagicStep
  handle-admin-burn (store) (line) =
    let amt = parse-int (extract-query-param line "amount") 0
    in if amt <= 0 then magic-respond-error store "amount must be positive"
    else let ns = MagicStore { pause-active = store.pause-active, pause-remaining = store.pause-remaining, game = store.game, turn = store.turn, orders = store.orders, game-active = store.game-active, templates = store.templates, generals = store.generals, accounts = store.accounts, num-accounts = store.num-accounts, tokens = store.tokens, ledger = store.ledger, current-season = store.current-season, match-record = store.match-record, account-keys = store.account-keys, next-nonce = store.next-nonce, platform = store.platform, next-token-id = store.next-token-id, total-minted = store.total-minted, total-burned = store.total-burned + amt, coin-for-sale = store.coin-for-sale, coin-price = store.coin-price }
    in magic-respond-json ns ("{\"ok\":true,\"supply\":" & show (ns.total-minted - ns.total-burned) & ",\"burned\":" & show (ns.total-burned) & "}")

  handle-admin-users : MagicStore -> MagicStep
  handle-admin-users (store) =
    let json = admin-users-json (store.accounts) (store.ledger) 0 (store.num-accounts) ""
    in magic-respond-json store ("{\"users\":[" & json & "]}")

  admin-users-json : List PlayerAccount, ManaCoinLedger, Integer, Integer, Text -> Text
  admin-users-json (accts) (led) (i) (len) (acc) =
    if i >= len then acc
    else let a = list-at accts i
    in let sep = if i > 0 then "," else ""
    in let bal = ledger-balance led i
    in let entry = sep & "{\"id\":" & show (a.account-id) & ",\"handle\":" & jstr (a.handle) & ",\"display\":" & jstr (a.display-name) & ",\"admin\":" & jbool (a.admin) & ",\"banned\":" & jbool (a.banned) & ",\"balance\":" & show bal & ",\"rating\":" & show (a.rating) & ",\"wins\":" & show (a.wins) & ",\"losses\":" & show (a.losses) & "}"
    in admin-users-json accts led (i + 1) len (acc & entry)

Section: Market Handlers

  handle-market : MagicStore, Text, Text -> MagicStep
  handle-market (store) (line) (path) =
    if text-starts-with path "/api/magic/market/balance" then handle-market-balance store line
    else magic-respond-not-found store

  handle-market-balance : MagicStore, Text -> MagicStep
  handle-market-balance (store) (line) =
    let tok = extract-query-param line "t"
    in let idx = find-account-by-session (store.accounts) tok 0 (store.num-accounts)
    in if idx < 0 then magic-respond-json store "{\"balance\":0}"
    else let bal = ledger-balance (store.ledger) idx
    in magic-respond-json store ("{\"balance\":" & show bal & "}")

Section: Clan Authority Handlers

  handle-clan : MagicStore, Text, Text -> MagicStep
  handle-clan (store) (line) (path) =
    if text-starts-with path "/api/magic/clan/register" then handle-clan-register store line
    else if text-starts-with path "/api/magic/clan/authorize" then handle-clan-authorize store line
    else if text-starts-with path "/api/magic/clan/buy-tokens" then handle-clan-buy-tokens store line
    else if text-starts-with path "/api/magic/clan/submit-pack" then handle-clan-submit-pack store line
    else if text-starts-with path "/api/magic/clan/review-pack" then handle-clan-review-pack store line
    else if text-starts-with path "/api/magic/clan/revenue" then handle-clan-revenue store line
    else if text-starts-with path "/api/magic/clan/sync" then handle-clan-sync store line
    else if text-starts-with path "/api/magic/clan/challenge-register" then handle-clan-challenge-reg store line
    else if text-starts-with path "/api/magic/clan/list" then handle-clan-list store
    else if text-starts-with path "/api/magic/clan/treasury" then handle-clan-treasury store line
    else magic-respond-not-found store

  handle-clan-register : MagicStore, Text -> MagicStep
  handle-clan-register (store) (line) =
    let name = extract-query-param line "name"
    in let tag = extract-query-param line "tag"
    in let founder = parse-int (extract-query-param line "founder") 0
    in let pk-high = parse-int (extract-query-param line "pk-high") 0
    in let pk-low = parse-int (extract-query-param line "pk-low") 0
    in let instance-key = PublicKey { key-high = pk-high, key-low = pk-low }
    in let result = register-clan (store.platform) name tag founder instance-key (store.next-nonce)
    in if result.success == False then magic-respond-error store "registration failed: tag already taken"
    else let ns = update-store-platform store (result.platform)
    in let ns2 = MagicStore { pause-active = ns.pause-active, pause-remaining = ns.pause-remaining, game = ns.game, turn = ns.turn, orders = ns.orders, game-active = ns.game-active, templates = ns.templates, generals = ns.generals, accounts = ns.accounts, num-accounts = ns.num-accounts, tokens = ns.tokens, ledger = ns.ledger, current-season = ns.current-season, match-record = ns.match-record, account-keys = ns.account-keys, next-nonce = ns.next-nonce + 1, platform = ns.platform, next-token-id = ns.next-token-id, total-minted = ns.total-minted, total-burned = ns.total-burned, coin-for-sale = ns.coin-for-sale, coin-price = ns.coin-price }
    in magic-respond-json ns2 ("{\"registered\":true,\"clan-id\":" & show (result.clan-id) & ",\"name\":" & jstr name & ",\"tag\":" & jstr tag & ",\"auth-token\":" & show (result.auth-token) & "}")

  handle-clan-authorize : MagicStore, Text -> MagicStep
  handle-clan-authorize (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let auth-token = parse-int (extract-query-param line "token") 0
    in let platform2 = authorize-clan (store.platform) clan-id auth-token
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"authorized\":true,\"clan\":" & show clan-id & "}")

  handle-clan-buy-tokens : MagicStore, Text -> MagicStep
  handle-clan-buy-tokens (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let amount = parse-int (extract-query-param line "amount") 0
    in let result = purchase-global-tokens (store.platform) clan-id amount (store.next-nonce)
    in if result.success == False then magic-respond-error store "purchase failed: clan not authorized or not found"
    else let ns = update-store-platform store (result.platform)
    in magic-respond-json ns ("{\"purchased\":true,\"clan\":" & show clan-id & ",\"amount\":" & show amount & ",\"treasury-balance\":" & show (get-clan-treasury-balance (result.platform) clan-id) & "}")

  handle-clan-submit-pack : MagicStore, Text -> MagicStep
  handle-clan-submit-pack (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let pack-name = extract-query-param line "name"
    in let price = parse-int (extract-query-param line "price") 100
    in let card-count = parse-int (extract-query-param line "cards") 15
    in if is-clan-authorized (store.platform) clan-id == False then magic-respond-error store "clan not authorized"
    else let platform2 = submit-pack-for-approval (store.platform) clan-id pack-name price card-count (store.next-nonce)
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"submitted\":true,\"clan\":" & show clan-id & ",\"pack\":" & jstr pack-name & ",\"status\":\"Pending\"}")

  handle-clan-review-pack : MagicStore, Text -> MagicStep
  handle-clan-review-pack (store) (line) =
    let approval-id = parse-int (extract-query-param line "approval") 0
    in let approved = extract-query-param line "approved" == "true"
    in let platform2 = review-pack-approval (store.platform) approval-id approved (store.next-nonce)
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"reviewed\":true,\"approval\":" & show approval-id & ",\"approved\":" & jbool approved & "}")

  handle-clan-revenue : MagicStore, Text -> MagicStep
  handle-clan-revenue (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let amount = parse-int (extract-query-param line "amount") 0
    in let platform2 = collect-pack-revenue (store.platform) clan-id amount
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"collected\":true,\"clan\":" & show clan-id & ",\"amount\":" & show amount & ",\"total-revenue\":" & show (platform-total-revenue platform2) & "}")

  handle-clan-sync : MagicStore, Text -> MagicStep
  handle-clan-sync (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let members = parse-int (extract-query-param line "members") 0
    in let reputation = parse-int (extract-query-param line "reputation") 0
    in let platform2 = sync-clan-state (store.platform) clan-id members reputation (store.next-nonce)
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"synced\":true,\"clan\":" & show clan-id & ",\"members\":" & show members & ",\"reputation\":" & show reputation & "}")

  handle-clan-challenge-reg : MagicStore, Text -> MagicStep
  handle-clan-challenge-reg (store) (line) =
    let challenger = parse-int (extract-query-param line "challenger") 0
    in let defender = parse-int (extract-query-param line "defender") 0
    in let stake = parse-int (extract-query-param line "stake") 0
    in let challenge-id = parse-int (extract-query-param line "id") 0
    in if is-clan-authorized (store.platform) challenger == False then magic-respond-error store "challenger clan not authorized"
    else if is-clan-authorized (store.platform) defender == False then magic-respond-error store "defender clan not authorized"
    else let platform2 = register-challenge (store.platform) challenger defender stake challenge-id
    in let ns = update-store-platform store platform2
    in magic-respond-json ns ("{\"registered\":true,\"challenge\":" & show challenge-id & ",\"challenger\":" & show challenger & ",\"defender\":" & show defender & ",\"stake\":" & show stake & "}")

  handle-clan-list : MagicStore -> MagicStep
  handle-clan-list (store) =
    let clans = store.platform.registered-clans
    in let json = clan-reg-list-to-json clans 0 (list-length clans) ""
    in magic-respond-json store ("{\"clans\":[" & json & "],\"count\":" & show (list-length clans) & "}")

  clan-reg-list-to-json : List ClanRegistration, Integer, Integer, Text -> Text
  clan-reg-list-to-json (clans) (i) (len) (acc) =
    if i >= len then acc
    else let c = list-at clans i
    in let sep = if i > 0 then "," else ""
    in let cj = sep & "{\"id\":" & show (c.clan-id) & ",\"name\":" & jstr (c.name) & ",\"tag\":" & jstr (c.tag) & ",\"authorized\":" & jbool (c.authorized) & ",\"members\":" & show (c.member-count) & ",\"rank\":" & jstr (clan-rank-name (c.rank)) & "}"
    in clan-reg-list-to-json clans (i + 1) len (acc & cj)

  handle-clan-treasury : MagicStore, Text -> MagicStep
  handle-clan-treasury (store) (line) =
    let clan-id = parse-int (extract-query-param line "clan") 0
    in let bal = get-clan-treasury-balance (store.platform) clan-id
    in magic-respond-json store ("{\"clan\":" & show clan-id & ",\"treasury-balance\":" & show bal & "}")

Section: JSON Serializers

  game-state-to-json : GameState, GeneralTemplate, GeneralTemplate, List CardTemplate -> Text
  game-state-to-json (gs) (gen-a) (gen-b) (templates) =
    let p0 = get-player gs 0
    in let p1 = get-player gs 1
    in "{\"turn\":" & show (gs.turn-number) & ",\"step\":" & show (gs.step) & ",\"active-player\":" & show (gs.active-player) & ",\"game-over\":" & jbool (gs.game-over) & ",\"winner\":" & show (gs.winner) & ",\"generals\":[" & general-to-json gen-a (p0.general) (army-loyalty gs 0) & "," & general-to-json gen-b (p1.general) (army-loyalty gs 1) & "],\"battlefield\":[" & battlefield-to-json (gs.battlefield) gs 0 (list-length (gs.battlefield)) "" & "],\"hands\":[{\"size\":" & show (list-length (p0.hand)) & ",\"cards\":[" & int-list-to-str (p0.hand) 0 (list-length (p0.hand)) "" & "]},{\"size\":" & show (list-length (p1.hand)) & "}],\"libraries\":[" & show (list-length (p0.library)) & "," & show (list-length (p1.library)) & "],\"prismatic-state\":[" & prismatic-to-json (p0.prismatic) & "," & prismatic-to-json (p1.prismatic) & "]}"

  general-to-json : GeneralTemplate, GeneralState, Integer -> Text
  general-to-json (template) (state) (loyalty) =
    "{\"name\":" & jstr (template.name) & ",\"power\":" & show (template.power + state.power-mod) & ",\"toughness\":" & show (template.toughness + state.toughness-mod) & ",\"defense\":" & show (template.defense + state.defense-mod) & ",\"life\":" & show (state.life) & ",\"starting-life\":" & show (template.life) & ",\"loyalty\":" & show loyalty & ",\"tapped\":" & jbool (state.is-tapped) & "}"

  battlefield-to-json : List Permanent, GameState, Integer, Integer, Text -> Text
  battlefield-to-json (perms) (gs) (i) (len) (acc) = battlefield-to-json-scaled (scale-bonuses gs) perms gs i len acc

  battlefield-to-json-scaled : ScaleBonuses, List Permanent, GameState, Integer, Integer, Text -> Text
  battlefield-to-json-scaled (bonuses) (perms) (gs) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in let t = get-template gs (perm.template-id)
    in let sep = if i > 0 then "," else ""
    in let pj = sep & "{\"attack-ready\":" & jbool (perm.controller == gs.active-player & t.card-type == Creature & can-attack perm (perm.keywords)) & ",\"id\":" & show (perm.id) & ",\"card-id\":" & show (perm.card-id) & ",\"name\":" & jstr (t.name) & ",\"template-id\":" & show (perm.template-id) & ",\"owner\":" & show (perm.owner) & ",\"play-order\":" & show (card-play-order gs (perm.card-id)) & ",\"orderable\":" & jbool (game-card-valid gs (perm.card-id) & t.is-token == False) & ",\"controller\":" & show (perm.controller) & ",\"type\":" & jstr (card-type-name (t.card-type)) & ",\"gem-stone\":" & show (t.gem-stone) & ",\"attached-to\":" & show (perm.attached-to) & ",\"power\":" & show ((effective-power bonuses t perm)) & ",\"toughness\":" & show ((effective-toughness bonuses t perm)) & ",\"defense\":" & show ((effective-defense bonuses t perm)) & ",\"tapped\":" & jbool (perm.tapped) & ",\"summoning-sick\":" & jbool (perm.summoning-sick) & ",\"damage-marked\":" & show (perm.damage-marked) & "}"
    in battlefield-to-json-scaled bonuses perms gs (i + 1) len (acc & pj)

  prismatic-to-json : PrismaticState -> Text
  prismatic-to-json (ps) =
    "{\"raysTotal\":" & show (ps.rays-total) & ",\"raysUsed\":" & show (ps.rays-used) & ",\"fluorescenceActive\":" & jbool (ps.fluorescence-active) & ",\"committedRays\":" & show (ps.committed-rays) & "}"

  templates-to-json-str : List CardTemplate, Integer, Integer, Text -> Text
  templates-to-json-str (templates) (i) (len) (acc) =
    if i >= len then acc
    else let t = list-at templates i
    in let sep = if i > 0 then "," else ""
    in let tj = sep & "{\"id\":" & show (t.id) & ",\"name\":" & jstr (t.name) & ",\"type\":" & jstr (card-type-name (t.card-type)) & ",\"power\":" & show (t.power) & ",\"toughness\":" & show (t.toughness) & ",\"defense\":" & show (t.defense) & ",\"rarity\":" & jstr (rarity-name (t.rarity)) & ",\"cost\":{\"red\":" & show (t.light-cost.red) & ",\"yellow\":" & show (t.light-cost.yellow) & ",\"blue\":" & show (t.light-cost.blue) & ",\"orange\":" & show (t.light-cost.orange) & ",\"green\":" & show (t.light-cost.green) & ",\"purple\":" & show (t.light-cost.purple) & ",\"white\":" & show (t.light-cost.white) & "},\"baseFocus\":" & show (t.base-focus) & ",\"isBasic\":" & if t.is-basic then "true" else "false" & "}"
    in templates-to-json-str templates (i + 1) len (acc & tj)

  int-list-to-str : List Integer, Integer, Integer, Text -> Text
  int-list-to-str (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i > 0 then "," else ""
    in int-list-to-str xs (i + 1) len (acc & sep & show (list-at xs i))

Section: Helpers

  get-general-by-id : List GeneralTemplate, Integer -> GeneralTemplate
  get-general-by-id (generals) (id) = find-general-loop generals id 0 (list-length generals)

  find-general-loop : List GeneralTemplate, Integer, Integer, Integer -> GeneralTemplate
  find-general-loop (generals) (id) (i) (len) =
    if i >= len then list-at generals 0
    else let g = list-at generals i
    in if g.id == id then g
    else find-general-loop generals id (i + 1) len

  load-deck-cards : GameState, Integer, List Integer, Integer -> GameState
  load-deck-cards (gs) (player-idx) (cards) (i) =
    game-load-library gs player-idx cards i

  draw-cards : GameState, Integer, Integer -> GameState
  draw-cards (gs) (player-idx) (n) =
    if n <= 0 then gs
    else let p = get-player gs player-idx
    in let p2 = player-draw p
    in let gs2 = set-player gs player-idx p2
    in draw-cards gs2 player-idx (n - 1)

Section: Server Loop

  MagicLoop = record { mstate : MagicStore, transport : TcpTransportState }

 A short write closes the connection: a partly sent response cannot be
 repaired, and the next request would otherwise be read from the middle of the
 body.

  magic-send : TcpTransportState, List Integer -> [Network.Read, Network.Write] TcpTransportState
  magic-send (ts) (bytes) = act
    r <- net-io-send-raw-checked ts bytes
    if r.ns-complete then r.ns-transport
    else net-io-close (r.ns-transport)
  end

  magic-handle-http : MagicLoop, List Integer -> [Network.Read, Network.Write] MagicLoop
  magic-handle-http (ls) (raw-bytes) =
    let req = http-parse-request raw-bytes
    in let line = req.method & " " & req.path & " HTTP/1.0"
    in if req.valid == False then
      let err-bytes = http-encode (http-error "Bad request")
      in act
        ts2 <- magic-send (ls.transport) err-bytes
        MagicLoop { mstate = ls.mstate, transport = ts2 }
      end
    else let step = dispatch-request (ls.mstate) line
    in let resp = http-json (step.resp)
    in let resp-bytes = http-encode resp
    in act
      ts2 <- magic-send (ls.transport) resp-bytes
      MagicLoop { mstate = step.store, transport = ts2 }
    end

  magic-loop : MagicLoop -> [Console, Network.Read, Network.Write] Nothing
  magic-loop (ls) = act
    recv <- net-io-recv-raw (ls.transport) 0
    if recv.has-data then act
      next <- magic-handle-http ls (recv.data)
      magic-loop next
    end
    else print-line-uni "SERVER-EXIT"
  end

  opening : [Console, Network.Read, Network.Write] Nothing = act
    let sess = net-session-new local-mac local-ip gateway-ip 49152 9200 host-ip 1000
    in let ts = transport-new sess
    in act
      ts1 <- net-io-connect ts
      magic-loop (MagicLoop { mstate = magic-store-new, transport = ts1 })
    end
  end

