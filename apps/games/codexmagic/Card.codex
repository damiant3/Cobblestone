Chapter: Card
  cites CodexMagic chapter Mana

 We say:

Section: Card Types

  CardType =
   | Gemstone
   | Creature
   | Equipment
   | Cantrip
   | Incantation
   | Disruption
   | Enchantment
   | General

  card-type-name : CardType -> Text
  card-type-name (ct) =
    when ct
      is Gemstone -> "Gemstone"
      is Creature -> "Creature"
      is Equipment -> "Equipment"
      is Cantrip -> "Cantrip"
      is Incantation -> "Incantation"
      is Disruption -> "Disruption"
      is Enchantment -> "Enchantment"
      is General -> "General"

  is-permanent-type : CardType -> Boolean
  is-permanent-type (ct) =
    when ct
      is Cantrip -> False
      is Incantation -> False
      is Disruption -> False
      is otherwise -> True

  is-disruptable : CardType -> Boolean
  is-disruptable (ct) =
    when ct
      is Incantation -> True
      is Enchantment -> True
      is Creature -> True
      is otherwise -> False

Section: Equipment Slots

  EquipSlot =
   | SlotWeapon
   | SlotShield
   | SlotHelmet
   | SlotArmor
   | SlotGloves
   | SlotBoots
   | SlotRing
   | SlotAmulet

  equip-slot-name : EquipSlot -> Text
  equip-slot-name (s) =
    when s
      is SlotWeapon -> "Weapon"
      is SlotShield -> "Shield"
      is SlotHelmet -> "Helmet"
      is SlotArmor -> "Armor"
      is SlotGloves -> "Gloves"
      is SlotBoots -> "Boots"
      is SlotRing -> "Ring"
      is SlotAmulet -> "Amulet"

Section: Rarity

  Rarity =
   | Common
   | Uncommon
   | Rare
   | Mythic
   | LegendaryMythic

  rarity-name : Rarity -> Text
  rarity-name (r) =
    when r
      is Common -> "Common"
      is Uncommon -> "Uncommon"
      is Rare -> "Rare"
      is Mythic -> "Mythic"
      is LegendaryMythic -> "Legendary Mythic"

Section: Keywords

  Keyword =
   | Flying
   | Ranged
   | Initiative
   | DoubleStrike
   | Splash
   | Alacrity
   | Vigilance
   | DrainLife
   | Exsanguinate
   | Stalwart
   | Intimidate
   | Flash
   | Shroud
   | Hexproof
   | Indestructible

  keyword-name : Keyword -> Text
  keyword-name (kw) =
    when kw
      is Flying -> "Flying"
      is Ranged -> "Ranged"
      is Initiative -> "Initiative"
      is DoubleStrike -> "Double strike"
      is Splash -> "Splash"
      is Alacrity -> "Alacrity"
      is Vigilance -> "Vigilance"
      is DrainLife -> "Drain Life"
      is Exsanguinate -> "Exsanguinate"
      is Stalwart -> "Stalwart"
      is Intimidate -> "Intimidate"
      is Flash -> "Flash"
      is Shroud -> "Shroud"
      is Hexproof -> "Hexproof"
      is Indestructible -> "Indestructible"

Section: Keyword Set

  KeywordSet = record {
    flying : Boolean,
    reach : Boolean,
    first-strike : Boolean,
    double-strike : Boolean,
    trample : Boolean,
    haste : Boolean,
    vigilance : Boolean,
    lifelink : Boolean,
    deathtouch : Boolean,
    defender : Boolean,
    intimidate : Boolean,
    flash : Boolean,
    shroud : Boolean,
    hexproof : Boolean,
    indestructible : Boolean
  }

  keywords-none : KeywordSet
  keywords-none = KeywordSet {
    flying = False, reach = False, first-strike = False,
    double-strike = False, trample = False, haste = False,
    vigilance = False, lifelink = False, deathtouch = False,
    defender = False, intimidate = False, flash = False,
    shroud = False, hexproof = False, indestructible = False
  }

  has-keyword : KeywordSet, Keyword -> Boolean
  has-keyword (ks) (kw) =
    when kw
      is Flying -> ks.flying
      is Ranged -> ks.reach
      is Initiative -> ks.first-strike
      is DoubleStrike -> ks.double-strike
      is Splash -> ks.trample
      is Alacrity -> ks.haste
      is Vigilance -> ks.vigilance
      is DrainLife -> ks.lifelink
      is Exsanguinate -> ks.deathtouch
      is Stalwart -> ks.defender
      is Intimidate -> ks.intimidate
      is Flash -> ks.flash
      is Shroud -> ks.shroud
      is Hexproof -> ks.hexproof
      is Indestructible -> ks.indestructible

  grant-keyword : KeywordSet, Keyword -> KeywordSet
  grant-keyword (ks) (kw) =
    when kw
      is Flying -> KeywordSet { flying = True, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Ranged -> KeywordSet { flying = ks.flying, reach = True, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Initiative -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = True, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is DoubleStrike -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = True, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Splash -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = True, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Alacrity -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = True, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Vigilance -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = True, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is DrainLife -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = True, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Exsanguinate -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = True, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Stalwart -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = True, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Intimidate -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = True, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Flash -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = True, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Shroud -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = True, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Hexproof -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = True, indestructible = ks.indestructible }
      is Indestructible -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = True }

Section: Effects

  Effect =
   | DealDamage (Integer)
   | GainLife (Integer)
   | DrawCards (Integer)
   | DestroyTarget
   | BoostPTD (Integer) (Integer) (Integer)
   | ReturnToHand
   | ExileTarget
   | GainKeyword (Keyword)
   | LoseLife (Integer)
   | DiscardCards (Integer)
   | DestroyEquipment
   | NoEffect

Section: Trigger Conditions

  TriggerCondition =
   | OnEnterBattlefield
   | OnLeaveBattlefield
   | OnDealCombatDamage
   | OnAttack
   | OnBlock
   | OnDeath
   | OnCast
   | OnUpkeep
   | OnDrawStep

Section: Activation Costs

  ActivationCost = record {
    rays : Integer,
    tap-self : Boolean,
    sacrifice-self : Boolean,
    pay-life : Integer
  }

  activation-cost-tap : ActivationCost
  activation-cost-tap = ActivationCost { rays = 0, tap-self = True, sacrifice-self = False, pay-life = 0 }

Section: Abilities

  Ability =
   | StaticAbility (Effect)
   | TriggeredAbility (TriggerCondition) (Effect)
   | ActivatedAbility (ActivationCost) (Effect)
   | FluorescenceAbility (Effect)
   | LoyaltyCostAbility (Integer) (Effect)

Section: Behavioral Modifiers

  Stance =
   | Aggressive
   | Defensive
   | Balanced
   | Tempo
   | Control

  CombatBias =
   | AlwaysAttack
   | NeverOverextend
   | SuicidalCharge
   | Cautious

  BehavioralModifier =
   | StanceOverride (Stance)
   | CombatBiasModifier (CombatBias)
   | SpellTypePriority (CardType) (Integer)
   | TriggerAggression (Integer)
   | ResourceHoarding (Integer)

Section: Card Template

  CardTemplate = record {
    id : Integer,
    name : Text,
    light-cost : LightCost,
    card-type : CardType,
    rarity : Rarity,
    subtypes : List Text,
    is-legendary : Boolean,
    is-basic : Boolean,
    power : Integer,
    toughness : Integer,
    defense : Integer,
    keywords : KeywordSet,
    abilities : List Ability,
    color : ColorSet,
    is-token : Boolean,
    base-focus : Integer,
    equip-slot : Integer,
    gem-stone : Integer,
    hardness : Integer
  }

Section: General Template

  GeneralTemplate = record {
    id : Integer,
    name : Text,
    light-cost : LightCost,
    subtypes : List Text,
    power : Integer,
    toughness : Integer,
    defense : Integer,
    life : Integer,
    keywords : KeywordSet,
    abilities : List Ability,
    modifiers : List BehavioralModifier,
    color : ColorSet
  }

Section: Template Constructors

  make-creature : Integer, Text, LightCost, Integer, Integer, Integer, KeywordSet -> CardTemplate
  make-creature (id) (name) (cost) (pow) (tou) (def) (kws) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Creature, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = pow, toughness = tou, defense = def, keywords = kws,
    abilities = [], color = cost-colors cost, is-token = False,
    base-focus = 5, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-cantrip : Integer, Text, LightCost, List Ability -> CardTemplate
  make-cantrip (id) (name) (cost) (abs) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Cantrip, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False,
    base-focus = 0, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-incantation : Integer, Text, LightCost, Integer, List Ability -> CardTemplate
  make-incantation (id) (name) (cost) (focus) (abs) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Incantation, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False,
    base-focus = focus, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-disruption : Integer, Text, LightCost, Integer -> CardTemplate
  make-disruption (id) (name) (cost) (power) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Disruption, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = [], color = cost-colors cost, is-token = False,
    base-focus = power, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-basic-gem : Integer, Text, Integer, Integer -> CardTemplate
  make-basic-gem (id) (name) (stone-type) (hardness-val) = CardTemplate {
    id = id, name = name, light-cost = light-cost-zero, card-type = Gemstone, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = True,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = [], color = color-set-empty, is-token = False,
    base-focus = 0, equip-slot = -1, gem-stone = stone-type, hardness = hardness-val
  }

  make-equipment : Integer, Text, LightCost, Integer, Integer, Integer, Integer, KeywordSet -> CardTemplate
  make-equipment (id) (name) (cost) (slot) (pow) (tou) (def) (kws) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Equipment, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = pow, toughness = tou, defense = def, keywords = kws,
    abilities = [], color = cost-colors cost, is-token = False,
    base-focus = 0, equip-slot = slot, gem-stone = -1, hardness = 0
  }

  make-enchantment : Integer, Text, LightCost, Integer, List Ability -> CardTemplate
  make-enchantment (id) (name) (cost) (focus) (abs) = CardTemplate {
    id = id, name = name, light-cost = cost, card-type = Enchantment, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False,
    base-focus = focus, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-token-creature : Integer, Text, Integer, Integer, Integer, KeywordSet -> CardTemplate
  make-token-creature (id) (name) (pow) (tou) (def) (kws) = CardTemplate {
    id = id, name = name, light-cost = light-cost-zero, card-type = Creature, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = pow, toughness = tou, defense = def, keywords = kws,
    abilities = [], color = color-set-empty, is-token = True,
    base-focus = 0, equip-slot = -1, gem-stone = -1, hardness = 0
  }

  make-general : Integer, Text, LightCost, Integer, Integer, Integer, Integer, KeywordSet, List Ability, List BehavioralModifier -> GeneralTemplate
  make-general (id) (name) (cost) (pow) (tou) (def) (life) (kws) (abs) (mods) = GeneralTemplate {
    id = id, name = name, light-cost = cost, subtypes = [],
    power = pow, toughness = tou, defense = def, life = life,
    keywords = kws, abilities = abs, modifiers = mods,
    color = cost-colors cost
  }

Section: Formatting

  format-card-template : CardTemplate -> Text
  format-card-template (t) =
    t.name & " " & format-light-cost (t.light-cost) & " - " & card-type-name (t.card-type) &
    if t.power > 0 then " " & show (t.power) & "/" & show (t.toughness) & "/" & show (t.defense)
    else ""

  format-general : GeneralTemplate -> Text
  format-general (g) =
    g.name & " " & format-light-cost (g.light-cost) & " - General " &
    show (g.power) & "/" & show (g.toughness) & "/" & show (g.defense) &
    " [Life: " & show (g.life) & "]"

