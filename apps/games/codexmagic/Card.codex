Chapter: Card
  cites CodexMagic chapter Mana

 Card data model. Seven card types including General. Creatures and
 Generals use P/T/D stats (power, toughness, defense). Defense is a
 per-source damage threshold — attacks at or below defense deal zero.
 Generals carry behavioral modifiers that shape AI play decisions.

 We say:

Section: Card Types

  CardType =
   | Land
   | Creature
   | Instant
   | Sorcery
   | Enchantment
   | Artifact
   | General

  card-type-name : CardType -> Text
  card-type-name (ct) =
    when ct
      is Land -> "Land"
      is Creature -> "Creature"
      is Instant -> "Instant"
      is Sorcery -> "Sorcery"
      is Enchantment -> "Enchantment"
      is Artifact -> "Artifact"
      is General -> "General"

  is-permanent-type : CardType -> Boolean
  is-permanent-type (ct) =
    when ct
      is Instant -> False
      is Sorcery -> False
      is otherwise -> True

  can-cast-at-instant-speed : CardType -> Boolean
  can-cast-at-instant-speed (ct) =
    when ct
      is Instant -> True
      is otherwise -> False

Section: Rarity

  Rarity =
   | Common
   | Uncommon
   | Rare
   | Mythic
   | LegendaryMythic

  rarity-name : Rarity -> Text
  rarity-name (r) =
    when r
      is Common -> "Common"
      is Uncommon -> "Uncommon"
      is Rare -> "Rare"
      is Mythic -> "Mythic"
      is LegendaryMythic -> "Legendary Mythic"

Section: Keywords

  Keyword =
   | Flying
   | Reach
   | FirstStrike
   | DoubleStrike
   | Trample
   | Haste
   | Vigilance
   | Lifelink
   | Deathtouch
   | Defender
   | Intimidate
   | Flash
   | Shroud
   | Hexproof
   | Indestructible

  keyword-name : Keyword -> Text
  keyword-name (kw) =
    when kw
      is Flying -> "Flying"
      is Reach -> "Reach"
      is FirstStrike -> "First strike"
      is DoubleStrike -> "Double strike"
      is Trample -> "Trample"
      is Haste -> "Haste"
      is Vigilance -> "Vigilance"
      is Lifelink -> "Lifelink"
      is Deathtouch -> "Deathtouch"
      is Defender -> "Defender"
      is Intimidate -> "Intimidate"
      is Flash -> "Flash"
      is Shroud -> "Shroud"
      is Hexproof -> "Hexproof"
      is Indestructible -> "Indestructible"

Section: Keyword Set

  KeywordSet = record {
    flying : Boolean,
    reach : Boolean,
    first-strike : Boolean,
    double-strike : Boolean,
    trample : Boolean,
    haste : Boolean,
    vigilance : Boolean,
    lifelink : Boolean,
    deathtouch : Boolean,
    defender : Boolean,
    intimidate : Boolean,
    flash : Boolean,
    shroud : Boolean,
    hexproof : Boolean,
    indestructible : Boolean
  }

  keywords-none : KeywordSet
  keywords-none = KeywordSet {
    flying = False, reach = False, first-strike = False,
    double-strike = False, trample = False, haste = False,
    vigilance = False, lifelink = False, deathtouch = False,
    defender = False, intimidate = False, flash = False,
    shroud = False, hexproof = False, indestructible = False
  }

  has-keyword : KeywordSet, Keyword -> Boolean
  has-keyword (ks) (kw) =
    when kw
      is Flying -> ks.flying
      is Reach -> ks.reach
      is FirstStrike -> ks.first-strike
      is DoubleStrike -> ks.double-strike
      is Trample -> ks.trample
      is Haste -> ks.haste
      is Vigilance -> ks.vigilance
      is Lifelink -> ks.lifelink
      is Deathtouch -> ks.deathtouch
      is Defender -> ks.defender
      is Intimidate -> ks.intimidate
      is Flash -> ks.flash
      is Shroud -> ks.shroud
      is Hexproof -> ks.hexproof
      is Indestructible -> ks.indestructible

  grant-keyword : KeywordSet, Keyword -> KeywordSet
  grant-keyword (ks) (kw) =
    when kw
      is Flying -> KeywordSet { flying = True, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Reach -> KeywordSet { flying = ks.flying, reach = True, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is FirstStrike -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = True, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is DoubleStrike -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = True, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Trample -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = True, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Haste -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = True, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Vigilance -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = True, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Lifelink -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = True, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Deathtouch -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = True, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Defender -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = True, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Intimidate -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = True, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Flash -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = True, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Shroud -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = True, hexproof = ks.hexproof, indestructible = ks.indestructible }
      is Hexproof -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = True, indestructible = ks.indestructible }
      is Indestructible -> KeywordSet { flying = ks.flying, reach = ks.reach, first-strike = ks.first-strike, double-strike = ks.double-strike, trample = ks.trample, haste = ks.haste, vigilance = ks.vigilance, lifelink = ks.lifelink, deathtouch = ks.deathtouch, defender = ks.defender, intimidate = ks.intimidate, flash = ks.flash, shroud = ks.shroud, hexproof = ks.hexproof, indestructible = True }

Section: Effects

  Effect =
   | DealDamage (Integer)
   | GainLife (Integer)
   | DrawCards (Integer)
   | DestroyTarget
   | CounterSpell
   | BoostPTD (Integer) (Integer) (Integer)
   | AddMana (ManaColor) (Integer)
   | ReturnToHand
   | ExileTarget
   | GainKeyword (Keyword)
   | LoseLife (Integer)
   | DiscardCards (Integer)
   | NoEffect

Section: Trigger Conditions

  TriggerCondition =
   | OnEnterBattlefield
   | OnLeaveBattlefield
   | OnDealCombatDamage
   | OnAttack
   | OnBlock
   | OnDeath
   | OnCast
   | OnUpkeep
   | OnDrawStep

Section: Activation Costs

  ActivationCost = record {
    mana : ManaCost,
    tap-self : Boolean,
    sacrifice-self : Boolean,
    pay-life : Integer
  }

  activation-cost-tap : ActivationCost
  activation-cost-tap = ActivationCost { mana = mana-cost-zero, tap-self = True, sacrifice-self = False, pay-life = 0 }

  activation-cost-mana : ManaCost -> ActivationCost
  activation-cost-mana (cost) = ActivationCost { mana = cost, tap-self = False, sacrifice-self = False, pay-life = 0 }

Section: Abilities

  Ability =
   | StaticAbility (Effect)
   | TriggeredAbility (TriggerCondition) (Effect)
   | ActivatedAbility (ActivationCost) (Effect)
   | ManaAbility (ActivationCost) (ManaColor) (Integer)
   | LoyaltyCostAbility (Integer) (Effect)

Section: Behavioral Modifiers

  Stance =
   | Aggressive
   | Defensive
   | Balanced
   | Tempo
   | Control

  CombatBias =
   | AlwaysAttack
   | NeverOverextend
   | SuicidalCharge
   | Cautious

  BehavioralModifier =
   | StanceOverride (Stance)
   | CombatBiasModifier (CombatBias)
   | SpellTypePriority (CardType) (Integer)
   | TriggerAggression (Integer)
   | ResourceHoarding (Integer)

Section: Card Template

  CardTemplate = record {
    id : Integer,
    name : Text,
    mana-cost : ManaCost,
    card-type : CardType,
    rarity : Rarity,
    subtypes : List Text,
    is-legendary : Boolean,
    is-basic : Boolean,
    power : Integer,
    toughness : Integer,
    defense : Integer,
    keywords : KeywordSet,
    abilities : List Ability,
    color : ColorSet,
    is-token : Boolean
  }

Section: General Template

  GeneralTemplate = record {
    id : Integer,
    name : Text,
    mana-cost : ManaCost,
    subtypes : List Text,
    power : Integer,
    toughness : Integer,
    defense : Integer,
    life : Integer,
    keywords : KeywordSet,
    abilities : List Ability,
    modifiers : List BehavioralModifier,
    color : ColorSet
  }

Section: Template Constructors

  make-creature : Integer, Text, ManaCost, Integer, Integer, Integer, KeywordSet -> CardTemplate
  make-creature (id) (name) (cost) (pow) (tou) (def) (kws) = CardTemplate {
    id = id, name = name, mana-cost = cost, card-type = Creature, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = pow, toughness = tou, defense = def, keywords = kws,
    abilities = [], color = cost-colors cost, is-token = False
  }

  make-token-creature : Integer, Text, Integer, Integer, Integer, KeywordSet -> CardTemplate
  make-token-creature (id) (name) (pow) (tou) (def) (kws) = CardTemplate {
    id = id, name = name, mana-cost = mana-cost-zero, card-type = Creature, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = pow, toughness = tou, defense = def, keywords = kws,
    abilities = [], color = color-set-empty, is-token = True
  }

  make-instant : Integer, Text, ManaCost, List Ability -> CardTemplate
  make-instant (id) (name) (cost) (abs) = CardTemplate {
    id = id, name = name, mana-cost = cost, card-type = Instant, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False
  }

  make-sorcery : Integer, Text, ManaCost, List Ability -> CardTemplate
  make-sorcery (id) (name) (cost) (abs) = CardTemplate {
    id = id, name = name, mana-cost = cost, card-type = Sorcery, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False
  }

  make-basic-land : Integer, Text, ManaColor -> CardTemplate
  make-basic-land (id) (name) (color) = CardTemplate {
    id = id, name = name, mana-cost = mana-cost-zero, card-type = Land, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = True,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = [ManaAbility activation-cost-tap color 1],
    color = color-set-empty, is-token = False
  }

  make-enchantment : Integer, Text, ManaCost, List Ability -> CardTemplate
  make-enchantment (id) (name) (cost) (abs) = CardTemplate {
    id = id, name = name, mana-cost = cost, card-type = Enchantment, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = cost-colors cost, is-token = False
  }

  make-artifact : Integer, Text, ManaCost, List Ability -> CardTemplate
  make-artifact (id) (name) (cost) (abs) = CardTemplate {
    id = id, name = name, mana-cost = cost, card-type = Artifact, rarity = Common,
    subtypes = [], is-legendary = False, is-basic = False,
    power = 0, toughness = 0, defense = 0, keywords = keywords-none,
    abilities = abs, color = color-set-empty, is-token = False
  }

  make-general : Integer, Text, ManaCost, Integer, Integer, Integer, Integer, KeywordSet, List Ability, List BehavioralModifier -> GeneralTemplate
  make-general (id) (name) (cost) (pow) (tou) (def) (life) (kws) (abs) (mods) = GeneralTemplate {
    id = id, name = name, mana-cost = cost, subtypes = [],
    power = pow, toughness = tou, defense = def, life = life,
    keywords = kws, abilities = abs, modifiers = mods,
    color = cost-colors cost
  }

Section: Formatting

  format-card-template : CardTemplate -> Text
  format-card-template (t) =
    t.name & " " & format-mana-cost (t.mana-cost) & " - " & card-type-name (t.card-type) &
    if t.power > 0 then " " & show (t.power) & "/" & show (t.toughness) & "/" & show (t.defense)
    else ""

  format-general : GeneralTemplate -> Text
  format-general (g) =
    g.name & " " & format-mana-cost (g.mana-cost) & " - General " &
    show (g.power) & "/" & show (g.toughness) & "/" & show (g.defense) &
    " [Life: " & show (g.life) & "]"

