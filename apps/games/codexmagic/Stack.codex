Section: Disruption Contest

  disruption-roll : Integer, Integer -> Integer
  disruption-roll (seed) (index) = 1 + int-mod (bit-and (mix-bits seed index) 9223372036854775807) 100

  contest-disruption-roll : Integer, Integer, Integer, Integer, Integer -> Boolean
  contest-disruption-roll (caster-focus) (caster-hardness) (disrupt-power) (disrupt-hardness) (roll) =
    let focus = caster-focus + caster-hardness
    in let disrupt = disrupt-power + disrupt-hardness
    in let chance = disruption-chance focus disrupt
    in roll >= 1 & roll <= 100 & roll <= chance

  contest-disruption : Integer, Integer, Integer, Integer, Integer, Integer -> Boolean
  contest-disruption (caster-focus) (caster-hardness) (disrupt-power) (disrupt-hardness) (seed) (index) =
    contest-disruption-roll caster-focus caster-hardness disrupt-power disrupt-hardness (disruption-roll seed index)

