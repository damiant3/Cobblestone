Section: Disruption Contest

  contest-disruption : Integer, Integer, Integer, Integer -> Boolean
  contest-disruption (caster-focus) (caster-hardness) (disrupt-power) (disrupt-hardness) =
    let focus = caster-focus + caster-hardness
    in let disrupt = disrupt-power + disrupt-hardness
    in let chance = disruption-chance focus disrupt
    in chance >= 50

