Chapter: MagicTheme
  cites UI chapter Theme
  cites UI chapter Widget

 Shared theme for all CodexMagic web pages. Provides the dark-gold
 theme, CSS component strings, DOM stubs, AJAX helpers, and reusable
 widget constructors for header, tabs, tables, forms, stat cards,
 badges, and page scaffolding. Pattern follows ExplorerTheme.

 We say:

Section: Helpers

  bsn : BorderSide = BorderSide { brd-width = 0, brd-color = 0 }
  bn : Border = Border { bdr-top = bsn, bdr-right = bsn, bdr-bottom = bsn, bdr-left = bsn, bdr-corner = CornerSharp }
  ez : Edges = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  bdr : Integer, Integer, CornerStyle -> Border
  bdr (w) (c) (corner) =
    let s = BorderSide { brd-width = w, brd-color = c }
    in Border { bdr-top = s, bdr-right = s, bdr-bottom = s, bdr-left = s, bdr-corner = corner }

  exy : Integer, Integer -> Edges
  exy (x) (y) = Edges { edge-top = y, edge-right = x, edge-bottom = y, edge-left = x }

  eu : Integer -> Edges
  eu (v) = Edges { edge-top = v, edge-right = v, edge-bottom = v, edge-left = v }

  ws : Integer, Integer, Border, Edges, Edges -> WidgetStyle
  ws (bg) (fg) (b) (pad) (mar) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0 }

  ss-flat : WidgetStyle -> StateStyles
  ss-flat (s) = StateStyles { ss-normal = s, ss-hover = s, ss-pressed = s, ss-disabled = s, ss-focused = s }

Section: Magic Dark Theme

  magic-palette : Palette
  magic-palette = Palette {
    pal-bg = 855319, pal-fg = 13226441,
    pal-primary = 13801762, pal-secondary = 1843496,
    pal-accent = 5809919, pal-muted = 9145758,
    pal-error = 16339273, pal-success = 4175184,
    pal-warning = 15763518, pal-border = 3160125
  }

  magic-theme : Theme
  magic-theme =
    let p = magic-palette
    in let b1 = bdr 1 (p.pal-border) CornerSharp
    in let pad = exy 16 8
    in let mar = eu 2
    in let base = ws (p.pal-bg) (p.pal-fg) b1 pad mar
    in let btn-n = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-primary) (CornerRound 4)) pad mar
    in let btn-h = ws (p.pal-primary) (p.pal-bg) (bdr 1 (p.pal-primary) (CornerRound 4)) pad mar
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 4)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 4)) pad mar
    in let sep = ws (p.pal-border) (p.pal-border) bn ez (exy 0 8)
    in Theme {
      th-name = "magic-dark",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = inp-f },
      th-gauge = ss-flat (ws (p.pal-bg) (p.pal-primary) b1 (eu 2) mar),
      th-separator = ss-flat sep
    }

Section: DOM Stubs

  DomElement = record { dom-id : Integer }
  dom-null : DomElement = DomElement { dom-id = 0 }
  dom-get : Text -> DomElement
  dom-get (id) = dom-null
  dom-create : Text -> DomElement
  dom-create (tag) = dom-null
  dom-set-text : DomElement, Text -> DomElement
  dom-set-text (el) (s) = el
  dom-set-html : DomElement, Text -> DomElement
  dom-set-html (el) (s) = el
  dom-get-value : DomElement -> Text
  dom-get-value (el) = ""
  dom-set-value : DomElement, Text -> DomElement
  dom-set-value (el) (v) = el
  dom-append : DomElement, DomElement -> DomElement
  dom-append (parent) (child) = parent
  dom-prepend : DomElement, DomElement -> DomElement
  dom-prepend (parent) (child) = parent
  dom-add-class : DomElement, Text -> DomElement
  dom-add-class (el) (c) = el
  dom-remove-class : DomElement, Text -> DomElement
  dom-remove-class (el) (c) = el
  dom-set-style : DomElement, Text, Text -> DomElement
  dom-set-style (el) (k) (v) = el
  dom-set-attr : DomElement, Text, Text -> DomElement
  dom-set-attr (el) (k) (v) = el
  dom-query : Text -> DomElement
  dom-query (sel) = dom-null
  dom-body : DomElement
  dom-body = dom-null
  dom-remove : DomElement -> DomElement
  dom-remove (el) = el
  dom-on-click : DomElement, (Text -> Integer) -> DomElement
  dom-on-click (el) (cb) = el
  dom-on-input : DomElement, (Text -> Integer) -> DomElement
  dom-on-input (el) (cb) = el
  dom-on-key : DomElement, (Text -> Integer) -> DomElement
  dom-on-key (el) (cb) = el
  state-get : Text -> Integer
  state-get (k) = 0
  state-set : Text, Integer -> Integer
  state-set (k) (v) = v
  state-get-text : Text -> Text
  state-get-text (k) = ""
  state-set-text : Text, Text -> Text
  state-set-text (k) (v) = v
  state-set-render : Text, Integer -> Integer
  state-set-render (k) (v) = v
  state-set-text-render : Text, Text -> Text
  state-set-text-render (k) (v) = v
  set-render : (Integer -> Integer) -> Integer
  set-render (fn) = 0
  request-render : Integer -> Integer
  request-render (x) = 0
  fetch-then : Text, Text, Text, (Text -> Integer) -> Integer
  fetch-then (url) (method) (body) (cb) = 0
  fetch-get-then : Text, (Text -> Integer) -> Integer
  fetch-get-then (url) (cb) = 0
  url-encode : Text -> Text
  url-encode (s) = s
  json-parse : Text -> List (List Text)
  json-parse (s) = []
  json-parse-obj : Text -> List Text
  json-parse-obj (s) = []
  json-obj-field : List Text, Text -> Text
  json-obj-field (obj) (key) = ""
  json-stringify : Text -> Text
  json-stringify (v) = v
  inject-theme-css : Theme -> Integer
  inject-theme-css (th) = 0
  mount-widget : WidgetNode -> Integer
  mount-widget (n) = 0
  mount-widget-themed : Theme, WidgetNode -> Integer
  mount-widget-themed (th) (n) = 0
  mount-widget-into : Text, WidgetNode -> Integer
  mount-widget-into (id) (n) = 0
  show-alert : Text, Text, (Text -> Integer) -> Integer
  show-alert (title) (msg) (cb) = 0
  show-confirm : Text, Text, (Text -> Integer) -> Integer
  show-confirm (title) (msg) (cb) = 0
  dom-set-aria : DomElement, Text, Text -> DomElement
  dom-set-aria (el) (k) (v) = el
  dom-set-role : DomElement, Text -> DomElement
  dom-set-role (el) (r) = el
  set-timeout : (Integer -> Integer), Integer -> Integer
  set-timeout (fn) (ms) = 0
  local-storage-get : Text -> Text
  local-storage-get (k) = ""
