Section: Subgame Nesting Control

  MaxSubgameDepth = 3

  SubgameContext = record {
    depth : Integer,
    parent-sessions : List Integer,
    max-depth : Integer
  }

  subgame-context-new : SubgameContext
  subgame-context-new = SubgameContext { depth = 0, parent-sessions = [], max-depth = 3 }

  can-create-subgame : SubgameContext -> Boolean
  can-create-subgame (ctx) = ctx.depth < ctx.max-depth

  push-subgame : SubgameContext, Integer -> SubgameContext
  push-subgame (ctx) (session-id) =
    SubgameContext { depth = ctx.depth + 1, parent-sessions = list-push (ctx.parent-sessions) session-id, max-depth = ctx.max-depth }

  pop-subgame : SubgameContext -> SubgameContext
  pop-subgame (ctx) =
    if ctx.depth <= 0 then ctx
    else SubgameContext { depth = ctx.depth - 1, parent-sessions = list-drop-last (ctx.parent-sessions), max-depth = ctx.max-depth }

  list-drop-last : List Integer -> List Integer
  list-drop-last (xs) =
    if list-length xs <= 1 then []
    else drop-last-loop xs 0 (list-length xs - 1) []

  drop-last-loop : List Integer, Integer, Integer, List Integer -> List Integer
  drop-last-loop (xs) (i) (limit) (acc) =
    if i >= limit then acc
    else drop-last-loop xs (i + 1) limit (list-push acc (list-at xs i))

Section: Session Helpers

  update-session-status : List SubgameSession, Integer, SubgameStatus, Integer, Integer, List SubgameSession -> List SubgameSession
  update-session-status (sessions) (id) (new-status) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at sessions i
    in if s.session-id == id then
      update-session-status sessions id new-status (i + 1) len (list-push acc (SubgameSession { session-id = s.session-id, parent-game-id = s.parent-game-id, parent-match-id = s.parent-match-id, subgame-id = s.subgame-id, player-a = s.player-a, player-b = s.player-b, status = new-status, result = s.result, effect = s.effect, created-at = s.created-at, resolved-at = s.resolved-at }))
    else update-session-status sessions id new-status (i + 1) len (list-push acc s)

  resolve-session : List SubgameSession, Integer, SubgameResult, Integer, Integer, Integer, List SubgameSession -> List SubgameSession
  resolve-session (sessions) (id) (result) (time) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at sessions i
    in if s.session-id == id then
      resolve-session sessions id result time (i + 1) len (list-push acc (SubgameSession { session-id = s.session-id, parent-game-id = s.parent-game-id, parent-match-id = s.parent-match-id, subgame-id = s.subgame-id, player-a = s.player-a, player-b = s.player-b, status = SubgameResolved, result = result, effect = s.effect, created-at = s.created-at, resolved-at = time }))
    else resolve-session sessions id result time (i + 1) len (list-push acc s)

  update-session-resolved : List SubgameSession, Integer, SubgameStatus, SubgameResult, Integer, Integer, Integer, List SubgameSession -> List SubgameSession
  update-session-resolved (sessions) (id) (status) (result) (time) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at sessions i
    in if s.session-id == id then
      update-session-resolved sessions id status result time (i + 1) len (list-push acc (SubgameSession { session-id = s.session-id, parent-game-id = s.parent-game-id, parent-match-id = s.parent-match-id, subgame-id = s.subgame-id, player-a = s.player-a, player-b = s.player-b, status = status, result = result, effect = s.effect, created-at = s.created-at, resolved-at = time }))
    else update-session-resolved sessions id status result time (i + 1) len (list-push acc s)

  get-session : GameRegistryState, Integer -> SubgameSession
  get-session (registry) (session-id) =
    find-session-loop (registry.subgame-sessions) session-id 0 (list-length (registry.subgame-sessions))

  find-session-loop : List SubgameSession, Integer, Integer, Integer -> SubgameSession
  find-session-loop (sessions) (id) (i) (len) =
    if i >= len then SubgameSession { session-id = -1, parent-game-id = 0, parent-match-id = 0, subgame-id = 0, player-a = 0, player-b = 0, status = SubgameAbandoned, result = SubgameNoResult, effect = EffectCustom "Not found", created-at = 0, resolved-at = 0 }
    else let s = list-at sessions i
    in if s.session-id == id then s
    else find-session-loop sessions id (i + 1) len

Section: Queries

  active-subgames-for-match : GameRegistryState, Integer -> List SubgameSession
  active-subgames-for-match (registry) (match-id) =
    filter-by-match (registry.subgame-sessions) match-id 0 (list-length (registry.subgame-sessions)) []

  filter-by-match : List SubgameSession, Integer, Integer, Integer, List SubgameSession -> List SubgameSession
  filter-by-match (sessions) (match-id) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at sessions i
    in if s.parent-match-id == match-id then
      if s.status == SubgamePending then filter-by-match sessions match-id (i + 1) len (list-push acc s)
      else if s.status == SubgameInProgress then filter-by-match sessions match-id (i + 1) len (list-push acc s)
      else filter-by-match sessions match-id (i + 1) len acc
    else filter-by-match sessions match-id (i + 1) len acc

  game-count : GameRegistryState -> Integer
  game-count (registry) = list-length (registry.games)

  active-session-count : GameRegistryState -> Integer
  active-session-count (registry) =
    count-active-sessions (registry.subgame-sessions) 0 (list-length (registry.subgame-sessions)) 0

  count-active-sessions : List SubgameSession, Integer, Integer, Integer -> Integer
  count-active-sessions (sessions) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at sessions i
    in if s.status == SubgamePending then count-active-sessions sessions (i + 1) len (acc + 1)
    else if s.status == SubgameInProgress then count-active-sessions sessions (i + 1) len (acc + 1)
    else count-active-sessions sessions (i + 1) len acc

