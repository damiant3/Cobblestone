Chapter: GameRegistry
  cites CodexMagic chapter Clan
  cites CodexMagic chapter ClanFormat
  cites CodexMagic chapter Auth

 Universal game registry. Any game — CodexMagic, chess, checkers,
 a clan's custom format, a third-party card game — can be registered
 with the platform. A registered game has an identity, a result type,
 and a protocol for resolving outcomes.

 This enables Shahrazad-as-abstraction: "pause this game, play a
 subgame of [registered game], winner gets [effect]." The subgame
 can be anything. Richard Garfield as he intended it, but over the
 entire space of games, not just one.

 We say:

Section: Game Identity

  RegisteredGame = record {
    game-id : Integer,
    name : Text,
    game-type : GameType,
    result-type : ResultType,
    registered-by : Integer,
    registered-at : Integer,
    active : Boolean,
    player-count : PlayerCount,
    avg-duration : Integer,
    description : Text
  }

  GameType =
    | GameCardBattle
    | GameBoardClassic
    | GamePuzzle
    | GameDexterity
    | GameTrivial
    | GameCustom (Text)

  game-type-name : GameType -> Text
  game-type-name (gt) =
    when gt
      is GameCardBattle -> "Card Battle"
      is GameBoardClassic -> "Board (Classic)"
      is GamePuzzle -> "Puzzle"
      is GameDexterity -> "Dexterity"
      is GameTrivial -> "Trivia"
      is GameCustom (name) -> name

  ResultType =
    | ResultWinLose
    | ResultScore (Integer)
    | ResultRanked
    | ResultPass

  result-type-name : ResultType -> Text
  result-type-name (rt) =
    when rt
      is ResultWinLose -> "Win/Lose"
      is ResultScore (max) -> "Score (max " & show max & ")"
      is ResultRanked -> "Ranked Placement"
      is ResultPass -> "Pass/Fail"

  PlayerCount =
    | Exactly (Integer)
    | Range (Integer, Integer)

Section: Game Registry State

  GameRegistryState = record {
    games : List RegisteredGame,
    next-game-id : Integer,
    subgame-sessions : List SubgameSession,
    next-session-id : Integer
  }

  registry-new : GameRegistryState
  registry-new =
    let chess = RegisteredGame { game-id = 1, name = "Chess", game-type = GameBoardClassic, result-type = ResultWinLose, registered-by = 0, registered-at = 0, active = True, player-count = Exactly 2, avg-duration = 30, description = "Classical chess" }
    in let checkers = RegisteredGame { game-id = 2, name = "Checkers", game-type = GameBoardClassic, result-type = ResultWinLose, registered-by = 0, registered-at = 0, active = True, player-count = Exactly 2, avg-duration = 15, description = "English draughts" }
    in let codexmagic = RegisteredGame { game-id = 3, name = "CodexMagic", game-type = GameCardBattle, result-type = ResultWinLose, registered-by = 0, registered-at = 0, active = True, player-count = Exactly 2, avg-duration = 8, description = "Standard CodexMagic format" }
    in GameRegistryState {
      games = [chess, checkers, codexmagic],
      next-game-id = 4,
      subgame-sessions = [],
      next-session-id = 1
    }

Section: Game Registration

  register-game : GameRegistryState, Text, GameType, ResultType, PlayerCount, Integer, Integer, Text -> GameRegistryState
  register-game (registry) (name) (gtype) (rtype) (players) (registrar) (time) (desc) =
    let game = RegisteredGame {
      game-id = registry.next-game-id,
      name = name,
      game-type = gtype,
      result-type = rtype,
      registered-by = registrar,
      registered-at = time,
      active = True,
      player-count = players,
      avg-duration = 0,
      description = desc
    }
    in GameRegistryState {
      games = list-push (registry.games) game,
      next-game-id = registry.next-game-id + 1,
      subgame-sessions = registry.subgame-sessions,
      next-session-id = registry.next-session-id
    }

  register-clan-format-as-game : GameRegistryState, ClanFormat, Text, Integer, Integer -> GameRegistryState
  register-clan-format-as-game (registry) (fmt) (clan-name) (registrar) (time) =
    let name = clan-name & ": " & fmt.name
    in let desc = "Custom format — Life:" & show (fmt.base-life) & " Turns:" & show (fmt.base-turn-cap) & " Deck:" & show (fmt.deck-min) & "-" & show (fmt.deck-max)
    in register-game registry name GameCardBattle ResultWinLose (Exactly 2) registrar time desc

  find-game : GameRegistryState, Integer -> RegisteredGame
  find-game (registry) (game-id) =
    find-game-loop (registry.games) game-id 0 (list-length (registry.games))

  find-game-loop : List RegisteredGame, Integer, Integer, Integer -> RegisteredGame
  find-game-loop (games) (id) (i) (len) =
    if i >= len then RegisteredGame { game-id = -1, name = "Unknown", game-type = GameCustom "None", result-type = ResultWinLose, registered-by = 0, registered-at = 0, active = False, player-count = Exactly 2, avg-duration = 0, description = "" }
    else let g = list-at games i
    in if g.game-id == id then g
    else find-game-loop games id (i + 1) len

  find-game-by-name : GameRegistryState, Text -> RegisteredGame
  find-game-by-name (registry) (name) =
    find-game-name-loop (registry.games) name 0 (list-length (registry.games))

  find-game-name-loop : List RegisteredGame, Text, Integer, Integer -> RegisteredGame
  find-game-name-loop (games) (name) (i) (len) =
    if i >= len then RegisteredGame { game-id = -1, name = "Unknown", game-type = GameCustom "None", result-type = ResultWinLose, registered-by = 0, registered-at = 0, active = False, player-count = Exactly 2, avg-duration = 0, description = "" }
    else let g = list-at games i
    in if g.name == name then g
    else find-game-name-loop games name (i + 1) len

Section: Subgame Sessions — Shahrazad Abstracted

  SubgameSession = record {
    session-id : Integer,
    parent-game-id : Integer,
    parent-match-id : Integer,
    subgame-id : Integer,
    player-a : Integer,
    player-b : Integer,
    status : SubgameStatus,
    result : SubgameResult,
    effect : SubgameEffect,
    created-at : Integer,
    resolved-at : Integer
  }

  SubgameStatus =
    | SubgamePending
    | SubgameInProgress
    | SubgameResolved
    | SubgameAbandoned

  subgame-status-name : SubgameStatus -> Text
  subgame-status-name (s) =
    when s
      is SubgamePending -> "Pending"
      is SubgameInProgress -> "In Progress"
      is SubgameResolved -> "Resolved"
      is SubgameAbandoned -> "Abandoned"

  SubgameResult =
    | SubgameNoResult
    | SubgameWinner (Integer)
    | SubgameScore (Integer, Integer)
    | SubgameDraw

  SubgameEffect =
    | EffectLoseLife (Integer)
    | EffectGainLife (Integer)
    | EffectDrawCards (Integer)
    | EffectDiscardCards (Integer)
    | EffectDestroyPermanent
    | EffectExtraTurn
    | EffectCoinReward (Integer)
    | EffectCustom (Text)

  effect-name : SubgameEffect -> Text
  effect-name (e) =
    when e
      is EffectLoseLife (n) -> "Lose " & show n & " life"
      is EffectGainLife (n) -> "Gain " & show n & " life"
      is EffectDrawCards (n) -> "Draw " & show n & " cards"
      is EffectDiscardCards (n) -> "Discard " & show n & " cards"
      is EffectDestroyPermanent -> "Destroy a permanent"
      is EffectExtraTurn -> "Extra turn"
      is EffectCoinReward (n) -> "Earn " & show n & " coin"
      is EffectCustom (desc) -> desc

Section: Subgame Lifecycle

  create-subgame : GameRegistryState, Integer, Integer, Integer, Integer, Integer, SubgameEffect, Integer -> GameRegistryState
  create-subgame (registry) (parent-game) (parent-match) (subgame-id) (player-a) (player-b) (effect) (time) =
    let session = SubgameSession {
      session-id = registry.next-session-id,
      parent-game-id = parent-game,
      parent-match-id = parent-match,
      subgame-id = subgame-id,
      player-a = player-a,
      player-b = player-b,
      status = SubgamePending,
      result = SubgameNoResult,
      effect = effect,
      created-at = time,
      resolved-at = 0
    }
    in GameRegistryState {
      games = registry.games,
      next-game-id = registry.next-game-id,
      subgame-sessions = list-push (registry.subgame-sessions) session,
      next-session-id = registry.next-session-id + 1
    }

  start-subgame : GameRegistryState, Integer -> GameRegistryState
  start-subgame (registry) (session-id) =
    let new-sessions = update-session-status (registry.subgame-sessions) session-id SubgameInProgress 0 (list-length (registry.subgame-sessions)) []
    in GameRegistryState {
      games = registry.games,
      next-game-id = registry.next-game-id,
      subgame-sessions = new-sessions,
      next-session-id = registry.next-session-id
    }

  resolve-subgame : GameRegistryState, Integer, SubgameResult, Integer -> GameRegistryState
  resolve-subgame (registry) (session-id) (result) (time) =
    let new-sessions = resolve-session (registry.subgame-sessions) session-id result time 0 (list-length (registry.subgame-sessions)) []
    in GameRegistryState {
      games = registry.games,
      next-game-id = registry.next-game-id,
      subgame-sessions = new-sessions,
      next-session-id = registry.next-session-id
    }

  abandon-subgame : GameRegistryState, Integer, Integer -> GameRegistryState
  abandon-subgame (registry) (session-id) (time) =
    let new-sessions = update-session-resolved (registry.subgame-sessions) session-id SubgameAbandoned SubgameNoResult time 0 (list-length (registry.subgame-sessions)) []
    in GameRegistryState {
      games = registry.games,
      next-game-id = registry.next-game-id,
      subgame-sessions = new-sessions,
      next-session-id = registry.next-session-id
    }

Section: Effect Resolution

  SubgameEffectResult = record {
    winner : Integer,
    loser : Integer,
    winner-effect : SubgameEffect,
    loser-effect : SubgameEffect,
    applied : Boolean
  }

  compute-effect : SubgameSession -> SubgameEffectResult
  compute-effect (session) =
    when session.result
      is SubgameWinner (winner-id) ->
        let loser-id = if winner-id == session.player-a then session.player-b else session.player-a
        in SubgameEffectResult {
          winner = winner-id,
          loser = loser-id,
          winner-effect = session.effect,
          loser-effect = invert-effect (session.effect),
          applied = True
        }
      is SubgameDraw ->
        SubgameEffectResult {
          winner = -1,
          loser = -1,
          winner-effect = EffectCustom "Draw: no effect",
          loser-effect = EffectCustom "Draw: no effect",
          applied = False
        }
      is SubgameNoResult ->
        SubgameEffectResult {
          winner = -1,
          loser = -1,
          winner-effect = EffectCustom "Unresolved",
          loser-effect = EffectCustom "Unresolved",
          applied = False
        }
      is SubgameScore (a-score, b-score) ->
        let winner-id = if a-score > b-score then session.player-a else session.player-b
        in let loser-id = if a-score > b-score then session.player-b else session.player-a
        in SubgameEffectResult {
          winner = winner-id,
          loser = loser-id,
          winner-effect = session.effect,
          loser-effect = invert-effect (session.effect),
          applied = True
        }

  invert-effect : SubgameEffect -> SubgameEffect
  invert-effect (e) =
    when e
      is EffectLoseLife (n) -> EffectLoseLife n
      is EffectGainLife (n) -> EffectLoseLife n
      is EffectDrawCards (n) -> EffectDiscardCards n
      is EffectDiscardCards (n) -> EffectDrawCards n
      is EffectDestroyPermanent -> EffectDestroyPermanent
      is EffectExtraTurn -> EffectCustom "Opponent gets extra turn"
      is EffectCoinReward (n) -> EffectCustom "No reward"
      is EffectCustom (desc) -> EffectCustom ("Inverse: " & desc)

