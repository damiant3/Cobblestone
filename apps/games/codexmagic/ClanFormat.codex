 We say:

Section: House Rules

  HouseRule =
    | BanCard (Integer)
    | RestrictCard (Integer) (Integer)
    | SetLifeTotal (Integer)
    | SetTurnCap (Integer)
    | SetDeckMin (Integer)
    | SetDeckMax (Integer)
    | SetCopyLimit (Integer)
    | RequireKeyword (Integer)
    | BanKeyword (Integer)
    | SetGeneralLife (Integer)
    | SetStartingLoyalty (Integer)
    | CustomSuddenDeath (Integer) (Integer)

  house-rule-name : HouseRule -> Text
  house-rule-name (rule) =
    when rule
      is BanCard (id) -> "Ban Card #" & show id
      is RestrictCard (id) (max) -> "Restrict Card #" & show id & " to " & show max
      is SetLifeTotal (n) -> "Life Total: " & show n
      is SetTurnCap (n) -> "Turn Cap: " & show n
      is SetDeckMin (n) -> "Deck Min: " & show n
      is SetDeckMax (n) -> "Deck Max: " & show n
      is SetCopyLimit (n) -> "Copy Limit: " & show n
      is RequireKeyword (kw) -> "Require Keyword #" & show kw
      is BanKeyword (kw) -> "Ban Keyword #" & show kw
      is SetGeneralLife (n) -> "General Life: " & show n
      is SetStartingLoyalty (n) -> "Starting Loyalty: " & show n
      is CustomSuddenDeath (base) (esc) -> "Sudden Death: " & show base & "+" & show esc & "/turn"

Section: Custom Formats

  ClanFormat = record {
    format-id : Integer,
    clan-id : Integer,
    name : Text,
    description : Text,
    base-life : Integer,
    base-turn-cap : Integer,
    deck-min : Integer,
    deck-max : Integer,
    copy-limit : Integer,
    banned-cards : List Integer,
    restricted-cards : List RestrictedEntry,
    banned-keywords : List Integer,
    required-keywords : List Integer,
    general-life : Integer,
    starting-loyalty : Integer,
    sudden-death-base : Integer,
    sudden-death-escalation : Integer,
    created-by : Integer,
    created-at : Integer
  }

  RestrictedEntry = record {
    card-id : Integer,
    max-copies : Integer
  }

Section: Format Creation

  clan-format-new : Integer, Integer, Text, Text, Integer, Integer -> ClanFormat
  clan-format-new (format-id) (clan-id) (name) (description) (creator) (time) =
    ClanFormat {
      format-id = format-id,
      clan-id = clan-id,
      name = name,
      description = description,
      base-life = 20,
      base-turn-cap = 12,
      deck-min = 40,
      deck-max = 60,
      copy-limit = 4,
      banned-cards = [],
      restricted-cards = [],
      banned-keywords = [],
      required-keywords = [],
      general-life = 20,
      starting-loyalty = 0,
      sudden-death-base = 3,
      sudden-death-escalation = 1,
      created-by = creator,
      created-at = time
    }

Section: Rule Application

  apply-house-rule : ClanFormat, HouseRule -> ClanFormat
  apply-house-rule (fmt) (rule) =
    when rule
      is BanCard (id) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = list-push (fmt.banned-cards) id, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is RestrictCard (id) (max) ->
        let entry = RestrictedEntry { card-id = id, max-copies = max }
        in ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = list-push (fmt.restricted-cards) entry, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetLifeTotal (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = n, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetTurnCap (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = n, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetDeckMin (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = n, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetDeckMax (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = n, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetCopyLimit (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = n, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is RequireKeyword (kw) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = list-push (fmt.required-keywords) kw, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
