      is SetGeneralLife (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = n, starting-loyalty = fmt.starting-loyalty, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is SetStartingLoyalty (n) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = n, sudden-death-base = fmt.sudden-death-base, sudden-death-escalation = fmt.sudden-death-escalation, created-by = fmt.created-by, created-at = fmt.created-at }
      is CustomSuddenDeath (base) (esc) ->
        ClanFormat { format-id = fmt.format-id, clan-id = fmt.clan-id, name = fmt.name, description = fmt.description, base-life = fmt.base-life, base-turn-cap = fmt.base-turn-cap, deck-min = fmt.deck-min, deck-max = fmt.deck-max, copy-limit = fmt.copy-limit, banned-cards = fmt.banned-cards, restricted-cards = fmt.restricted-cards, banned-keywords = fmt.banned-keywords, required-keywords = fmt.required-keywords, general-life = fmt.general-life, starting-loyalty = fmt.starting-loyalty, sudden-death-base = base, sudden-death-escalation = esc, created-by = fmt.created-by, created-at = fmt.created-at }

Section: Deck Validation

  DeckValidation = record {
    valid : Boolean,
    reason : Text
  }

  validate-deck-for-format : ClanFormat, List Integer, Integer -> DeckValidation
  validate-deck-for-format (fmt) (card-ids) (deck-size) =
    if deck-size < fmt.deck-min then DeckValidation { valid = False, reason = "Deck too small" }
    else if deck-size > fmt.deck-max then DeckValidation { valid = False, reason = "Deck too large" }
    else if has-banned-card (fmt.banned-cards) card-ids 0 (list-length card-ids) then DeckValidation { valid = False, reason = "Contains banned card" }
    else DeckValidation { valid = True, reason = "" }

  has-banned-card : List Integer, List Integer, Integer, Integer -> Boolean
  has-banned-card (banned) (cards) (i) (len) =
    if i >= len then False
    else let card = list-at cards i
    in if int-list-has banned card then True
    else has-banned-card banned cards (i + 1) len

Section: Format Queries

  format-allows-card : ClanFormat, Integer -> Boolean
  format-allows-card (fmt) (card-id) =
    int-list-has (fmt.banned-cards) card-id == False

  get-card-copy-limit : ClanFormat, Integer -> Integer
  get-card-copy-limit (fmt) (card-id) =
    let restricted = find-restricted (fmt.restricted-cards) card-id 0 (list-length (fmt.restricted-cards))
    in if restricted >= 0 then restricted
    else fmt.copy-limit

  find-restricted : List RestrictedEntry, Integer, Integer, Integer -> Integer
  find-restricted (entries) (card-id) (i) (len) =
    if i >= len then -1
    else let e = list-at entries i
    in if e.card-id == card-id then e.max-copies
    else find-restricted entries card-id (i + 1) len

