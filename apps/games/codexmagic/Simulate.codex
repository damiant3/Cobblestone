Section: Per-Game Metrics

  GameMetrics = record {
    stop-reason : Text,
    winner : Integer,
    turns : Integer,
    first-player-won : Boolean,
    life-a : Integer,
    life-b : Integer,
    loyalty-a : Integer,
    loyalty-b : Integer,
    screw-events-a : Integer,
    screw-events-b : Integer,
    flood-events-a : Integer,
    flood-events-b : Integer,
    discards-for-ray : Integer,
    gems-pitched : Integer,
    creatures-played : Integer,
    spells-cast : Integer
  }

Section: Aggregate Results

  SimAggregate = record {
    stop-reason : Text,
    total-games : Integer,
    p0-wins : Integer,
    p1-wins : Integer,
    draws : Integer,
    first-player-wins : Integer,
    total-turns : Integer,
    total-screw : Integer,
    total-flood : Integer,
    total-discards : Integer,
    total-pitches : Integer,
    total-creatures : Integer,
    total-spells : Integer,
    sudden-death-games : Integer
  }

  aggregate-empty : SimAggregate
  aggregate-empty = SimAggregate { stop-reason = "", total-games = 0, p0-wins = 0, p1-wins = 0, draws = 0, first-player-wins = 0, total-turns = 0, total-screw = 0, total-flood = 0, total-discards = 0, total-pitches = 0, total-creatures = 0, total-spells = 0, sudden-death-games = 0 }

  aggregate-add : SimAggregate, GameMetrics, Integer -> SimAggregate
  aggregate-add (agg) (m) (turn-cap) =
    if m.stop-reason /= "" then __record-set (aggregate-copy agg) "stop-reason" (m.stop-reason)
    else SimAggregate { stop-reason = agg.stop-reason, total-games = agg.total-games + 1, p0-wins = agg.p0-wins + (if m.winner == 0 then 1 else 0), p1-wins = agg.p1-wins + (if m.winner == 1 then 1 else 0), draws = agg.draws + (if m.winner < 0 then 1 else 0), first-player-wins = agg.first-player-wins + (if m.first-player-won then 1 else 0), total-turns = agg.total-turns + m.turns, total-screw = agg.total-screw + m.screw-events-a + m.screw-events-b, total-flood = agg.total-flood + m.flood-events-a + m.flood-events-b, total-discards = agg.total-discards + m.discards-for-ray, total-pitches = agg.total-pitches + m.gems-pitched, total-creatures = agg.total-creatures + m.creatures-played, total-spells = agg.total-spells + m.spells-cast, sudden-death-games = agg.sudden-death-games + (if m.turns > turn-cap then 1 else 0) }

Section: The Screw And Flood Fixes

  aggregate-copy : SimAggregate -> SimAggregate
  aggregate-copy (a) = SimAggregate { stop-reason = a.stop-reason, total-games = a.total-games, p0-wins = a.p0-wins, p1-wins = a.p1-wins, draws = a.draws, first-player-wins = a.first-player-wins, total-turns = a.total-turns, total-screw = a.total-screw, total-flood = a.total-flood, total-discards = a.total-discards, total-pitches = a.total-pitches, total-creatures = a.total-creatures, total-spells = a.total-spells, sudden-death-games = a.sudden-death-games }

  hand-gems : GameState, Integer -> Integer
  hand-gems (gs) (player) =
    let p = get-player gs player
    in count-gems-in-hand (p.hand) gs 0 (list-length (p.hand)) 0

  hand-size-of : GameState, Integer -> Integer
  hand-size-of (gs) (player) = list-length ((get-player gs player).hand)

  drop-first-card : GameState, Integer -> GameState
  drop-first-card (gs) (player) =
    let p = get-player gs player
    in if list-length (p.hand) == 0 then gs
    else let card = list-at (p.hand) 0
    in let p2 = player-remove-from-hand p card
    in set-player gs player (player-add-to-graveyard p2 card)

  screw-fix-fires : GameState, RuleSet, Integer -> Boolean
  screw-fix-fires (gs) (rules) (player) =
    when rules.screw-fix
      is ScrewFixNone -> False
      is ScrewFixDiscard -> hand-gems gs player == 0 & hand-size-of gs player > 0

  apply-screw-fix : GameState, RuleSet, Integer -> GameState
  apply-screw-fix (gs) (rules) (player) =
    if screw-fix-fires gs rules player == False then gs
    else let gs2 = drop-first-card gs player
    in set-player gs2 player (player-gain-ray (get-player gs2 player))

  flood-pitch-cards : FloodFix -> Integer
  flood-pitch-cards (ff) =
    when ff
      is FloodFixNone -> 0
      is FloodFixPitch2Draw1 -> 2
      is FloodFixPitch1Draw1 -> 1

  flood-fix-fires : GameState, RuleSet, Integer -> Boolean
  flood-fix-fires (gs) (rules) (player) =
    let n = flood-pitch-cards (rules.flood-fix)
    in if n == 0 then False
    else hand-gems gs player >= 3 & hand-size-of gs player >= n

  apply-flood-fix : GameState, RuleSet, Integer -> GameState
  apply-flood-fix (gs) (rules) (player) =
    if flood-fix-fires gs rules player == False then gs
    else let gs2 = pitch-cards gs player (flood-pitch-cards (rules.flood-fix)) 0
    in set-player gs2 player (player-draw (get-player gs2 player))

  pitch-cards : GameState, Integer, Integer, Integer -> GameState
  pitch-cards (gs) (player) (n) (i) =
    if i >= n then gs
    else pitch-cards (drop-first-card gs player) player n (i + 1)

Section: Single Game Simulation

  run-sim-game : GameState, RuleSet, GeneralTemplate, GeneralTemplate, Integer -> GameMetrics
  run-sim-game (gs) (rules) (gen-a) (gen-b) (seed) =
    run-sim-game-orders gs rules gen-a gen-b seed posture-unattended posture-unattended

  run-sim-game-orders : GameState, RuleSet, GeneralTemplate, GeneralTemplate, Integer, Posture, Posture -> GameMetrics
  run-sim-game-orders (gs) (rules) (gen-a) (gen-b) (seed) (pa) (pb) =
    if game-budget-stopped gs then make-metrics gs 0 0 0 0 0 0 0
    else let gs2 = apply-fairness (game-contest-seed gs seed) rules
    in let gs3 = run-mulligan-phase gs2 rules seed
    in sim-game-loop-orders gs3 rules gen-a gen-b 0 0 0 0 0 0 0 pa pb

  run-mulligan-phase : GameState, RuleSet, Integer -> GameState
  run-mulligan-phase (gs) (rules) (seed) =
    let gs2 = maybe-mulligan gs rules 0 seed 0
    in maybe-mulligan gs2 rules 1 (seed + 100) 0

  maybe-mulligan : GameState, RuleSet, Integer, Integer, Integer -> GameState
  maybe-mulligan (gs) (rules) (player) (seed) (attempt) =
    if attempt >= 3 then gs
    else if should-mulligan gs player then
      let gs2 = apply-mulligan gs rules player (attempt + 1) (seed + attempt * 17)
      in maybe-mulligan gs2 rules player seed (attempt + 1)
    else gs

  sim-game-loop : GameState, RuleSet, GeneralTemplate, GeneralTemplate, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> GameMetrics
  sim-game-loop (gs) (rules) (gen-a) (gen-b) (screw-a) (screw-b) (flood-a) (flood-b) (discards) (pitches) (creatures) =
    sim-game-loop-orders gs rules gen-a gen-b screw-a screw-b flood-a flood-b discards pitches creatures posture-unattended posture-unattended

  sim-game-loop-orders : GameState, RuleSet, GeneralTemplate, GeneralTemplate, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Posture, Posture -> GameMetrics
  sim-game-loop-orders (gs) (rules) (gen-a) (gen-b) (screw-a) (screw-b) (flood-a) (flood-b) (discards) (pitches) (creatures) (pa) (pb) =
    if gs.game-over | game-budget-stopped gs then make-metrics gs screw-a screw-b flood-a flood-b discards pitches creatures
    else if gs.turn-number > rules.turn-cap + 5 then make-metrics gs screw-a screw-b flood-a flood-b discards pitches creatures
    else let player = gs.active-player
    in let p = get-player gs player
    in let stance = effective-stance posture-default (if player == 0 then gen-a else gen-b) (p.general)
    in let gems-in-hand = count-gems-in-hand (p.hand) gs 0 (list-length (p.hand)) 0
    in let hand-size = list-length (p.hand)
    in let new-screw-a = screw-a + (if player == 0 then (if gems-in-hand == 0 then 1 else 0) else 0)
    in let new-screw-b = screw-b + (if player == 1 then (if gems-in-hand == 0 then 1 else 0) else 0)
    in let new-flood-a = flood-a + (if player == 0 then (if gems-in-hand >= 3 then 1 else 0) else 0)
    in let new-flood-b = flood-b + (if player == 1 then (if gems-in-hand >= 3 then 1 else 0) else 0)
    in let gs2 = apply-sudden-death gs rules
    in let gs3 = check-state-based-actions gs2
    in if gs3.game-over | game-budget-stopped gs3 then make-metrics gs3 new-screw-a new-screw-b new-flood-a new-flood-b discards pitches creatures
    else let screw-fires = screw-fix-fires gs3 rules player
    in let gs4 = apply-screw-fix gs3 rules player
    in let flood-fires = flood-fix-fires gs4 rules player
    in let gs5 = apply-flood-fix gs4 rules player
    in let new-discards = discards + (if screw-fires then 1 else 0)
    in let new-pitches = pitches + (if flood-fires then flood-pitch-cards (rules.flood-fix) else 0)
    in let bf-before = list-length (gs5.battlefield)
    in let gs6 = run-turn-orders gs5 pa pb
    in let gs7 = check-state-based-actions gs6
    in let bf-after = list-length (gs7.battlefield)
    in let new-creatures = creatures + (if bf-after > bf-before then bf-after - bf-before else 0)
    in let gs8 = if gs7.game-over | game-budget-stopped gs7 then gs7 else advance-turn gs7
    in sim-game-loop-orders gs8 rules gen-a gen-b new-screw-a new-screw-b new-flood-a new-flood-b new-discards new-pitches new-creatures pa pb

  make-metrics : GameState, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> GameMetrics
  make-metrics (gs) (sa) (sb) (fa) (fb) (disc) (pitch) (creatures) =
    let p0 = get-player gs 0
    in let p1 = get-player gs 1
    in GameMetrics { stop-reason = budget-stop-reason gs, winner = gs.winner, turns = gs.turn-number, first-player-won = gs.winner == 0, life-a = p0.general.life, life-b = p1.general.life, loyalty-a = army-loyalty gs 0, loyalty-b = army-loyalty gs 1, screw-events-a = sa, screw-events-b = sb, flood-events-a = fa, flood-events-b = fb, discards-for-ray = disc, gems-pitched = pitch, creatures-played = creatures, spells-cast = 0 }

Section: Batch Simulation

  SimBatchResult =
    | BatchComplete (SimAggregate)
    | BatchRefused (Text)

  run-batch : RuleSet, GeneralTemplate, GeneralTemplate, Integer, Integer -> SimBatchResult
  run-batch (rules) (gen-a) (gen-b) (num-games) (base-seed) =
    run-batch-loop rules gen-a gen-b num-games base-seed 0 aggregate-empty

  run-batch-loop : RuleSet, GeneralTemplate, GeneralTemplate, Integer, Integer, Integer, SimAggregate -> SimBatchResult
  run-batch-loop (rules) (gen-a) (gen-b) (total) (base-seed) (i) (agg) =
    if agg.stop-reason /= "" then BatchRefused (agg.stop-reason)
    else if i >= total then BatchComplete agg
    else let seed = base-seed + i * 97
    in let templates = full-card-pool
    in when gen-starter-deck gen-a templates (seed + 1)
      is StarterRefused (why) -> BatchRefused why
      is StarterDeck (deck-a) -> (when gen-starter-deck gen-b templates (seed + 2)
        is StarterRefused (why) -> BatchRefused why
        is StarterDeck (deck-b) ->
          let gs = game-new templates gen-a gen-b
          in let gs2 = load-deck-for-sim gs 0 (deck-a.cards) 0
          in let gs3 = load-deck-for-sim gs2 1 (deck-b.cards) 0
          in let gs4 = draw-n-sim gs3 0 7
          in let gs5 = draw-n-sim gs4 1 7
          in let metrics = run-sim-game gs5 rules gen-a gen-b seed
          in let agg2 = aggregate-add agg metrics (rules.turn-cap)
          in run-batch-loop rules gen-a gen-b total base-seed (i + 1) agg2)

  load-deck-for-sim : GameState, Integer, List Integer, Integer -> GameState
  load-deck-for-sim (gs) (player) (cards) (i) =
    game-load-library gs player cards i

  draw-n-sim : GameState, Integer, Integer -> GameState
  draw-n-sim (gs) (player) (n) =
    if n <= 0 then gs
    else let p = get-player gs player
    in let p2 = player-draw p
    in let gs2 = set-player gs player p2
    in draw-n-sim gs2 player (n - 1)

Section: Reporting

  format-batch : SimBatchResult, RuleSet -> Text
  format-batch (result) (rules) = when result
    is BatchRefused (why) -> "Simulation refused: " & why
    is BatchComplete (agg) -> format-aggregate agg rules

  format-aggregate : SimAggregate, RuleSet -> Text
  format-aggregate (agg) (rules) =
    if agg.stop-reason /= "" then "Simulation stopped: " & agg.stop-reason
    else let n = if agg.total-games == 0 then 1 else agg.total-games
    in let fp-pct = agg.first-player-wins * 100 / n
    in let avg-turns = agg.total-turns / n
    in let screw-per = agg.total-screw * 100 / n
    in let flood-per = agg.total-flood * 100 / n
    in "Games:" & show (agg.total-games) & " P0:" & show (agg.p0-wins) & " P1:" & show (agg.p1-wins) & " Draw:" & show (agg.draws) & " | FP%:" & show fp-pct & " AvgT:" & show avg-turns & " Screw:" & show screw-per & "% Flood:" & show flood-per & "% Disc:" & show (agg.total-discards) & " Pitch:" & show (agg.total-pitches) & " SD:" & show (agg.sudden-death-games) & " | " & format-rules rules

Section: Comparison Runner

  SimComparison = record {
    label-a : Text,
    label-b : Text,
    result-a : SimBatchResult,
    result-b : SimBatchResult
  }

  run-comparison : RuleSet, RuleSet, Text, Text, GeneralTemplate, GeneralTemplate, Integer, Integer -> SimComparison
  run-comparison (rules-a) (rules-b) (label-a) (label-b) (gen-a) (gen-b) (num-games) (seed) =
    let result-a = run-batch rules-a gen-a gen-b num-games seed
    in let result-b = run-batch rules-b gen-a gen-b num-games (seed + 50000)
    in SimComparison { label-a = label-a, label-b = label-b, result-a = result-a, result-b = result-b }

  format-comparison : SimComparison, RuleSet, RuleSet -> Text
  format-comparison (cmp) (rules-a) (rules-b) =
    "=== " & cmp.label-a & " ===\n" & format-batch (cmp.result-a) rules-a & "\n=== " & cmp.label-b & " ===\n" & format-batch (cmp.result-b) rules-b

