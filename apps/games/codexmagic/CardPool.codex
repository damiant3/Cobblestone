  pool-green = [pool-emerald-wurm, pool-jade-bear, pool-verdant-spider, pool-ancient-treant, pool-thornbow-ranger]

  pool-purple : List CardTemplate
  pool-purple = [pool-prismatic-assassin, pool-twilight-specter, pool-void-colossus, pool-spectral-shade]

  pool-colorless : List CardTemplate
  pool-colorless = [pool-quartz-bastion, pool-iron-golem]

  pool-spells : List CardTemplate
  pool-spells = [pool-spark-bolt, pool-conflagration, pool-inferno-wave, pool-mending-light, pool-radiant-shield, pool-judgement-ray, pool-insight, pool-deep-scrying, pool-nullify, pool-searing-touch, pool-sunrise-blast, pool-stonehide, pool-shatter, pool-reclaim, pool-void-bolt, pool-prismatic-doom]

  pool-disruptions : List CardTemplate
  pool-disruptions = [pool-mosquito-plague, pool-blinding-flash, pool-thunder-clap]

  pool-equipment : List CardTemplate
  pool-equipment = [pool-iron-sword, pool-oak-shield, pool-leather-helm, pool-chain-hauberk, pool-signet-ring, pool-amber-amulet, pool-runed-greatsword]

  pool-triggered : List CardTemplate
  pool-triggered = [pool-war-drummer, pool-cleric-of-light, pool-thought-wisp, pool-carnelian-stalker, pool-vine-caller, pool-prism-dragon]

  full-card-pool : List CardTemplate
  full-card-pool = append-pools (append-pools (append-pools (append-pools pool-gems pool-red) (append-pools pool-yellow pool-blue)) (append-pools (append-pools pool-orange pool-green) (append-pools pool-purple pool-colorless))) (append-pools (append-pools pool-spells pool-disruptions) (append-pools pool-equipment pool-triggered))

  append-pools : List CardTemplate, List CardTemplate -> List CardTemplate
  append-pools (a) (b) = append-pool-loop a b 0 (list-length b)

  append-pool-loop : List CardTemplate, List CardTemplate, Integer, Integer -> List CardTemplate
  append-pool-loop (acc) (src) (i) (len) =
    if i >= len then acc
    else append-pool-loop (list-push acc (list-at src i)) src (i + 1) len

  pool-size : Integer
  pool-size = 70

