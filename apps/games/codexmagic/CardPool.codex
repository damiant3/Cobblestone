  pool-gems : List CardTemplate
  pool-gems = [pool-ruby, pool-topaz, pool-sapphire, pool-carnelian, pool-emerald, pool-diamond, pool-obsidian]

  pool-red : List CardTemplate
  pool-red = [pool-ruby-golem, pool-flame-sentinel, pool-molten-wurm, pool-cinder-sprite, pool-pyroclasm-giant]

