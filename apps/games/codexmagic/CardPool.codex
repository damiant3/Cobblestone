Section: Full Pool

  pool-lands : List CardTemplate
  pool-lands = [pool-mountain, pool-plains, pool-island, pool-swamp, pool-forest]

  pool-red : List CardTemplate
  pool-red = [pool-goblin-raider, pool-ember-knight, pool-lava-wurm, pool-fire-imp, pool-magma-giant]

  pool-white : List CardTemplate
  pool-white = [pool-ironclad-sentinel, pool-dawn-soldier, pool-guardian-angel, pool-wall-of-light, pool-holy-champion]

  pool-blue : List CardTemplate
  pool-blue = [pool-azure-scholar, pool-wind-drake, pool-sea-serpent, pool-frost-sentinel, pool-illusion-weaver]

  pool-black : List CardTemplate
  pool-black = [pool-shadow-assassin, pool-vampire-knight, pool-dread-specter, pool-bone-colossus, pool-plague-rat]

  pool-green : List CardTemplate
  pool-green = [pool-verdant-wurm, pool-forest-bear, pool-giant-spider, pool-ancient-oak, pool-elven-archer]

  pool-colorless : List CardTemplate
  pool-colorless = [pool-wall-of-stone, pool-iron-golem]

  pool-spells : List CardTemplate
  pool-spells = [pool-lightning-strike, pool-fireball, pool-flame-wave, pool-healing-touch, pool-divine-shield, pool-holy-wrath, pool-divination, pool-counterspell, pool-brainstorm, pool-dark-ritual, pool-doom-blade, pool-drain-life, pool-giant-growth, pool-naturalize, pool-regrowth]

  pool-artifacts : List CardTemplate
  pool-artifacts = [pool-mana-crystal, pool-battle-axe, pool-shield-ward]

  pool-triggered : List CardTemplate
  pool-triggered = [pool-war-drummer, pool-healer-cleric, pool-thought-wisp, pool-blood-seeker, pool-vine-caller, pool-armored-rhino, pool-phoenix-hatchling, pool-shield-bearer, pool-mind-flayer, pool-grave-titan]

  full-card-pool : List CardTemplate
  full-card-pool = append-pools (append-pools (append-pools (append-pools pool-lands pool-red) (append-pools pool-white pool-blue)) (append-pools (append-pools pool-black pool-green) pool-colorless)) (append-pools (append-pools pool-spells pool-artifacts) pool-triggered)

  append-pools : List CardTemplate, List CardTemplate -> List CardTemplate
  append-pools (a) (b) = append-pool-loop a b 0 (list-length b)

  append-pool-loop : List CardTemplate, List CardTemplate, Integer, Integer -> List CardTemplate
  append-pool-loop (acc) (src) (i) (len) =
    if i >= len then acc
    else append-pool-loop (list-push acc (list-at src i)) src (i + 1) len

  pool-size : Integer
  pool-size = 60

