Chapter: CampaignWorld
  cites CodexMagic chapter RPGEngine
  cites CodexMagic chapter Clan
  cites CodexMagic chapter GameRegistry

 Campaign world building, maps, dungeons, and modules. A clan leader
 (Game Master) designs worlds, populates them with encounters, loot,
 NPCs, and storylines. Modules are publishable units - a dungeon, a
 quest chain, an adventure - that others can pay to play. Think Diablo
 meets D&D module publishing meets a token economy.

 We say:

Section: World Structure

  CampaignWorld = record {
    world-id : Integer,
    clan-id : Integer,
    name : Text,
    description : Text,
    regions : List Region,
    dungeons : List Dungeon,
    npcs : List NPC,
    quests : List Quest,
    game-system : GameSystemDef,
    created-by : Integer,
    created-at : Integer,
    published : Boolean,
    play-count : Integer,
    rating : Integer
  }

  Region = record {
    region-id : Integer,
    name : Text,
    description : Text,
    region-type : RegionType,
    connections : List Integer,
    dungeons-here : List Integer,
    npcs-here : List Integer,
    level-range-min : Integer,
    level-range-max : Integer,
    ambient-danger : Integer
  }

  RegionType =
    | Town
    | Wilderness
    | Mountains
    | Forest
    | Desert
    | Swamp
    | Underdark
    | Plane
    | Ocean
    | CustomRegion (Text)

  region-type-name : RegionType -> Text
  region-type-name (rt) =
    when rt
      is Town -> "Town"
      is Wilderness -> "Wilderness"
      is Mountains -> "Mountains"
      is Forest -> "Forest"
      is Desert -> "Desert"
      is Swamp -> "Swamp"
      is Underdark -> "Underdark"
      is Plane -> "Plane"
      is Ocean -> "Ocean"
      is CustomRegion (name) -> name

Section: Dungeons - The Diablo Layer

  Dungeon = record {
    dungeon-id : Integer,
    name : Text,
    description : Text,
    floors : List DungeonFloor,
    num-floors : Integer,
    min-level : Integer,
    max-level : Integer,
    entry-fee : Integer,
    loot-table : LootTable,
    boss : Combatant,
    completion-reward-xp : Integer,
    completion-reward-gold : Integer,
    completion-reward-item : Integer,
    times-completed : Integer,
    deaths : Integer,
    avg-clear-time : Integer,
    published : Boolean
  }

  DungeonFloor = record {
    floor-number : Integer,
    name : Text,
    encounters : List Encounter,
    traps : List DungeonTrap,
    treasure : List Integer,
    map-width : Integer,
    map-height : Integer,
    tiles : List Tile,
    exit-condition : ExitCondition
  }

  Encounter = record {
    encounter-id : Integer,
    enemies : List Combatant,
    difficulty : Integer,
    xp-reward : Integer,
    gold-reward : Integer,
    loot-chance : Integer,
    trigger : EncounterTrigger
  }

  EncounterTrigger =
    | TriggerEnterRoom
    | TriggerOpenChest
    | TriggerStepOnTile (Integer, Integer)
    | TriggerRandom (Integer)
    | TriggerQuestFlag (Integer)

  DungeonTrap = record {
    trap-id : Integer,
    trap-name : Text,
    trap-damage : Integer,
    detect-dc : Integer,
    disarm-dc : Integer,
    trap-x : Integer,
    trap-y : Integer
  }

  Tile = record {
    tile-type : TileType,
    passable : Boolean,
    has-encounter : Boolean,
    encounter-id : Integer
  }

  TileType =
    | Floor
    | Wall
    | Door
    | Stairs
    | Chest
    | TrapTile
    | Water
    | Lava

  ExitCondition =
    | KillAllEnemies
    | ReachExit
    | DefeatBoss
    | SurviveRounds (Integer)
    | CollectItems (Integer)

Section: NPCs

  NPC = record {
    npc-id : Integer,
    name : Text,
    role : NPCRole,
    region-id : Integer,
    dialogue : List DialogueLine,
    shop-inventory : List ItemToken,
    quest-giver : Boolean,
    quest-ids : List Integer
  }

  NPCRole =
    | Merchant
    | QuestGiver
    | Innkeeper
    | Blacksmith
    | Sage
    | Guard
    | Villain
    | Companion

  DialogueLine = record {
    line-id : Integer,
    text : Text,
    condition : Integer,
    next-line : Integer
  }

Section: Quests

  Quest = record {
    quest-id : Integer,
    name : Text,
    description : Text,
    quest-type : QuestType,
    objectives : List Objective,
    reward-xp : Integer,
    reward-gold : Integer,
    reward-item : Integer,
    prerequisite : Integer,
    repeatable : Boolean
  }

  QuestType =
    | FetchQuest
    | KillQuest
    | EscortQuest
    | ExploreQuest
    | PuzzleQuest
    | BossQuest
    | ChainQuest

  Objective = record {
    obj-id : Integer,
    description : Text,
    target-type : ObjectiveTarget,
    target-id : Integer,
    target-count : Integer,
    current-count : Integer,
    complete : Boolean
  }

  ObjectiveTarget =
    | KillEnemy
    | CollectItem
    | ReachRegion
    | TalkToNPC
    | ClearDungeon
    | WinSubgame

Section: Game System Definition - GM customizes the rules

  GameSystemDef = record {
    system-id : Integer,
    name : Text,
    classes : List HeroClass,
    races : List CharRace,
    level-cap : Integer,
    stat-method : StatMethod,
    death-rule : DeathRule,
    rest-rule : RestRule,
    custom-skills : List Skill,
    xp-multiplier : Integer,
    gold-multiplier : Integer
  }

  StatMethod =
    | StandardArray
    | PointBuy (Integer)
    | RollDice

  DeathRule =
    | Permadeath
    | RespawnAtTown
    | RespawnAtCheckpoint
    | DeathSaves (Integer)

  RestRule =
    | FullHealOnRest
    | PartialHeal (Integer)
    | NoFreeHealing

  default-game-system : GameSystemDef
  default-game-system =
    GameSystemDef {
      system-id = 1,
      name = "Standard Fantasy",
      classes = [class-warrior, class-mage, class-rogue, class-cleric],
      races = [race-human, race-elf, race-dwarf, race-halfling],
      level-cap = 20,
      stat-method = StandardArray,
      death-rule = RespawnAtTown,
      rest-rule = FullHealOnRest,
      custom-skills = [],
      xp-multiplier = 100,
      gold-multiplier = 100
    }

Section: World Creation

  world-new : Integer, Integer, Text, Text, Integer, Integer -> CampaignWorld
  world-new (world-id) (clan-id) (name) (description) (creator) (time) =
    CampaignWorld {
      world-id = world-id,
      clan-id = clan-id,
      name = name,
      description = description,
      regions = [],
      dungeons = [],
      npcs = [],
      quests = [],
      game-system = default-game-system,
      created-by = creator,
      created-at = time,
      published = False,
      play-count = 0,
      rating = 0
    }

  add-region : CampaignWorld, Region -> CampaignWorld
  add-region (world) (region) =
    CampaignWorld { world-id = world.world-id, clan-id = world.clan-id, name = world.name, description = world.description, regions = list-push (world.regions) region, dungeons = world.dungeons, npcs = world.npcs, quests = world.quests, game-system = world.game-system, created-by = world.created-by, created-at = world.created-at, published = world.published, play-count = world.play-count, rating = world.rating }

  add-dungeon : CampaignWorld, Dungeon -> CampaignWorld
  add-dungeon (world) (dungeon) =
    CampaignWorld { world-id = world.world-id, clan-id = world.clan-id, name = world.name, description = world.description, regions = world.regions, dungeons = list-push (world.dungeons) dungeon, npcs = world.npcs, quests = world.quests, game-system = world.game-system, created-by = world.created-by, created-at = world.created-at, published = world.published, play-count = world.play-count, rating = world.rating }

  add-quest : CampaignWorld, Quest -> CampaignWorld
  add-quest (world) (quest) =
    CampaignWorld { world-id = world.world-id, clan-id = world.clan-id, name = world.name, description = world.description, regions = world.regions, dungeons = world.dungeons, npcs = world.npcs, quests = list-push (world.quests) quest, game-system = world.game-system, created-by = world.created-by, created-at = world.created-at, published = world.published, play-count = world.play-count, rating = world.rating }

  publish-world : CampaignWorld -> CampaignWorld
  publish-world (world) =
    CampaignWorld { world-id = world.world-id, clan-id = world.clan-id, name = world.name, description = world.description, regions = world.regions, dungeons = world.dungeons, npcs = world.npcs, quests = world.quests, game-system = world.game-system, created-by = world.created-by, created-at = world.created-at, published = True, play-count = world.play-count, rating = world.rating }

Section: Module - A Publishable Unit of Content

  Module = record {
    module-id : Integer,
    world-id : Integer,
    clan-id : Integer,
    name : Text,
    description : Text,
    module-type : ModuleType,
    dungeon-ids : List Integer,
    quest-ids : List Integer,
    min-level : Integer,
    max-level : Integer,
    party-size : Integer,
    entry-fee : Integer,
    completion-rewards : ModuleRewards,
    published : Boolean,
    times-run : Integer,
    total-revenue : Integer,
    avg-rating : Integer,
    creator : Integer,
    created-at : Integer
  }

  ModuleType =
    | OneShot
    | Campaign
    | MegaDungeon
    | Arena
    | Raid
    | Tutorial

  module-type-name : ModuleType -> Text
  module-type-name (mt) =
    when mt
      is OneShot -> "One Shot"
      is Campaign -> "Campaign"
      is MegaDungeon -> "Mega Dungeon"
      is Arena -> "Arena"
      is Raid -> "Raid"
      is Tutorial -> "Tutorial"

  ModuleRewards = record {
    xp-total : Integer,
    gold-total : Integer,
    guaranteed-items : List Integer,
    loot-table-id : Integer,
    mana-coin-reward : Integer,
    clan-coin-reward : Integer
  }

Section: Dungeon Run - The Diablo Session

  DungeonRun = record {
    run-id : Integer,
    dungeon-id : Integer,
    module-id : Integer,
    player : Integer,
    char-id : Integer,
    current-floor : Integer,
    status : RunStatus,
    loot-collected : List ItemToken,
    gold-collected : Integer,
    xp-earned : Integer,
    enemies-killed : Integer,
    started-at : Integer,
    completed-at : Integer,
    death-count : Integer
  }

  RunStatus =
    | RunActive
    | RunCompleted
    | RunFailed
    | RunAbandoned

  run-status-name : RunStatus -> Text
  run-status-name (s) =
    when s
      is RunActive -> "Active"
      is RunCompleted -> "Completed"
      is RunFailed -> "Failed"
      is RunAbandoned -> "Abandoned"

  dungeon-run-new : Integer, Integer, Integer, Integer, Integer, Integer -> DungeonRun
  dungeon-run-new (run-id) (dungeon-id) (module-id) (player) (char-id) (time) =
    DungeonRun {
      run-id = run-id,
      dungeon-id = dungeon-id,
      module-id = module-id,
      player = player,
      char-id = char-id,
      current-floor = 1,
      status = RunActive,
      loot-collected = [],
      gold-collected = 0,
      xp-earned = 0,
      enemies-killed = 0,
      started-at = time,
      completed-at = 0,
      death-count = 0
    }

  complete-run : DungeonRun, Integer -> DungeonRun
  complete-run (run) (time) =
    DungeonRun { run-id = run.run-id, dungeon-id = run.dungeon-id, module-id = run.module-id, player = run.player, char-id = run.char-id, current-floor = run.current-floor, status = RunCompleted, loot-collected = run.loot-collected, gold-collected = run.gold-collected, xp-earned = run.xp-earned, enemies-killed = run.enemies-killed, started-at = run.started-at, completed-at = time, death-count = run.death-count }

