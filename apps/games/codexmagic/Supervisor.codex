 AI Supervisor: reads the General's behavioral modifiers and the
 player's posture to make play decisions. Handles gem drops, spell
 casting with ray-based costs, attacker/blocker selection. Rays
 grow automatically; gems are played from hand as permanents.

 We say:

Section: Posture

  Posture = record {
    stance : Stance,
    phase-freeze-combat : Boolean,
    block-policy-auto : Boolean
  }

  posture-default : Posture
  posture-default = Posture { stance = Balanced, phase-freeze-combat = False, block-policy-auto = True }

Section: Effective Stance

  effective-stance : Posture, GeneralTemplate, GeneralState -> Stance
  effective-stance (posture) (gen-template) (gen-state) =
    let threshold = get-aggression-threshold (gen-template.modifiers)
    in if threshold > 0 then
      if gen-state.life <= threshold then Aggressive
      else resolve-stance (posture.stance) (gen-template.modifiers)
    else resolve-stance (posture.stance) (gen-template.modifiers)

  resolve-stance : Stance, List BehavioralModifier -> Stance
  resolve-stance (player-stance) (mods) =
    if has-stance-override mods then get-stance-override mods
    else player-stance

Section: AI Gem Play

  ai-play-gem : GameState, Integer -> GameState
  ai-play-gem (gs) (player) =
    let p = get-player gs player
    in if p.gem-drop-used then gs
    else let gem-id = find-gem-in-hand (p.hand) (gs.templates) 0 (list-length (p.hand))
    in if gem-id >= 0 then play-gem-from-hand gs player gem-id
    else gs

  find-gem-in-hand : List Integer, List CardTemplate, Integer, Integer -> Integer
  find-gem-in-hand (hand) (templates) (i) (len) =
    if i >= len then -1
    else let card-id = list-at hand i
    in if card-id < list-length templates then
      let t = list-at templates card-id
      in when t.card-type
        is Gemstone -> card-id
        is otherwise -> find-gem-in-hand hand templates (i + 1) len
    else find-gem-in-hand hand templates (i + 1) len

  play-gem-from-hand : GameState, Integer, Integer -> GameState
  play-gem-from-hand (gs) (player) (card-id) =
    let p = get-player gs player
    in let p2 = PlayerState { general = p.general, prismatic = p.prismatic, library = p.library, hand = gs-list-remove (p.hand) card-id, graveyard = p.graveyard, exile = p.exile, gem-drop-used = True }
    in let gs2 = set-player gs player p2
    in let perm = permanent-new (gs2.next-permanent-id) card-id card-id player
    in let template = get-template gs2 card-id
    in let perm2 = Permanent { id = perm.id, card-id = perm.card-id, template-id = perm.template-id, controller = perm.controller, owner = perm.owner, tapped = False, summoning-sick = False, damage-marked = 0, counters = 0, keywords = template.keywords, attached-to = -1, power-mod = 0, toughness-mod = 0, defense-mod = 0, equipped-to = -1, socketed-gem = -1 }
    in GameState { players = gs2.players, generals = gs2.generals, battlefield = list-push (gs2.battlefield) perm2, active-player = gs2.active-player, priority-player = gs2.priority-player, turn-number = gs2.turn-number, phase = gs2.phase, step = gs2.step, next-permanent-id = gs2.next-permanent-id + 1, next-instance-id = gs2.next-instance-id, game-over = gs2.game-over, winner = gs2.winner, templates = gs2.templates }

Section: AI Spell Casting

  ai-cast-spells : GameState, Integer, Stance -> GameState
  ai-cast-spells (gs) (player) (stance) =
    let p = get-player gs player
    in let avail-rays = prismatic-available-rays (p.prismatic)
    in let best = find-best-castable (p.hand) (gs.templates) avail-rays stance 0 (list-length (p.hand)) (-1) (-1)
    in if best >= 0 then
      let template = get-template gs best
      in let ray-cost = total-rays (template.light-cost)
      in if ray-cost <= avail-rays then
        let p2 = player-spend-rays (player-remove-from-hand p best) ray-cost
        in let gs2 = set-player gs player p2
        in let gs3 = resolve-spell-direct gs2 best best player
        in let gs4 = check-state-based-actions gs3
        in ai-cast-spells gs4 player stance
      else gs
    else gs

  find-best-castable : List Integer, List CardTemplate, Integer, Stance, Integer, Integer, Integer, Integer -> Integer
  find-best-castable (hand) (templates) (avail-rays) (stance) (i) (len) (best) (best-score) =
    if i >= len then best
    else let card-id = list-at hand i
    in if card-id < list-length templates then
      let t = list-at templates card-id
      in when t.card-type
        is Gemstone -> find-best-castable hand templates avail-rays stance (i + 1) len best best-score
        is otherwise ->
          let ray-cost = total-rays (t.light-cost)
          in if ray-cost <= avail-rays then
            let score = score-card t stance
            in if score > best-score then find-best-castable hand templates avail-rays stance (i + 1) len card-id score
            else find-best-castable hand templates avail-rays stance (i + 1) len best best-score
          else find-best-castable hand templates avail-rays stance (i + 1) len best best-score
    else find-best-castable hand templates avail-rays stance (i + 1) len best best-score

  score-card : CardTemplate, Stance -> Integer
  score-card (t) (stance) =
    let base = t.power * 10 + t.toughness * 5 + t.defense * 8 + total-rays (t.light-cost) * 3
    in when stance
      is Aggressive -> base + t.power * 15
      is Defensive -> base + t.toughness * 10 + t.defense * 12
      is Tempo -> base + (if total-rays (t.light-cost) <= 3 then 20 else 0)
      is Control -> base + (if has-destroy-in-abilities (t.abilities) then 30 else 0)
      is Balanced -> base

  has-destroy-in-abilities : List Ability -> Boolean
  has-destroy-in-abilities (abs) = has-destroy-loop abs 0 (list-length abs)

  has-destroy-loop : List Ability, Integer, Integer -> Boolean
  has-destroy-loop (abs) (i) (len) =
    if i >= len then False
    else when list-at abs i
      is StaticAbility (eff) -> when eff
        is DestroyTarget -> True
        is DealDamage (n) -> True
        is otherwise -> has-destroy-loop abs (i + 1) len
      is otherwise -> has-destroy-loop abs (i + 1) len

Section: Spell Resolution

  resolve-spell-direct : GameState, Integer, Integer, Integer -> GameState
  resolve-spell-direct (gs) (card-id) (template-id) (controller) =
    let template = get-template gs template-id
    in if is-permanent-type (template.card-type)
      then enter-battlefield-direct gs card-id template-id controller
      else apply-spell-effects-direct gs template controller

  enter-battlefield-direct : GameState, Integer, Integer, Integer -> GameState
  enter-battlefield-direct (gs) (card-id) (template-id) (controller) =
    let perm = permanent-new (gs.next-permanent-id) card-id template-id controller
    in let template = get-template gs template-id
    in let perm-with-kws = Permanent {
      id = perm.id, card-id = perm.card-id, template-id = perm.template-id,
      controller = perm.controller, owner = perm.owner,
      tapped = perm.tapped,
      summoning-sick = if has-keyword (template.keywords) Alacrity then False else True,
      damage-marked = 0, counters = 0,
      keywords = template.keywords, attached-to = -1,
      power-mod = 0, toughness-mod = 0, defense-mod = 0,
      equipped-to = -1, socketed-gem = -1
    }
    in GameState {
      players = gs.players,
      generals = gs.generals,
      battlefield = list-push (gs.battlefield) perm-with-kws,
      active-player = gs.active-player,
      priority-player = gs.priority-player,
      turn-number = gs.turn-number,
      phase = gs.phase,
      step = gs.step,
      next-permanent-id = gs.next-permanent-id + 1,
      next-instance-id = gs.next-instance-id + 1,
      game-over = gs.game-over,
      winner = gs.winner,
      templates = gs.templates
    }

  apply-spell-effects-direct : GameState, CardTemplate, Integer -> GameState
  apply-spell-effects-direct (gs) (template) (controller) =
    apply-abilities-direct gs (template.abilities) controller []

  apply-abilities-direct : GameState, List Ability, Integer, List Integer -> GameState
  apply-abilities-direct (gs) (abs) (controller) (targets) =
    apply-abilities-loop-direct gs abs controller targets 0 (list-length abs)

  apply-abilities-loop-direct : GameState, List Ability, Integer, List Integer, Integer, Integer -> GameState
  apply-abilities-loop-direct (gs) (abs) (controller) (targets) (i) (len) =
    if i >= len then gs
    else let ab = list-at abs i
    in let gs2 = apply-single-ability-direct gs ab controller targets
    in apply-abilities-loop-direct gs2 abs controller targets (i + 1) len

  apply-single-ability-direct : GameState, Ability, Integer, List Integer -> GameState
  apply-single-ability-direct (gs) (ab) (controller) (targets) =
    when ab
      is StaticAbility (eff) -> apply-effect-direct gs eff controller targets
      is TriggeredAbility (cond) (eff) -> gs
      is ActivatedAbility (cost) (eff) -> apply-effect-direct gs eff controller targets
      is FluorescenceAbility (eff) ->
        let p = get-player gs controller
        in if p.prismatic.fluorescence-active then apply-effect-direct gs eff controller targets
        else gs
      is LoyaltyCostAbility (loyalty-cost) (eff) ->
        let current-loyalty = army-loyalty gs controller
        in if current-loyalty >= loyalty-cost
          then apply-effect-direct gs eff controller targets
          else gs

  apply-effect-direct : GameState, Effect, Integer, List Integer -> GameState
  apply-effect-direct (gs) (eff) (controller) (targets) =
    when eff
      is DealDamage (amount) ->
        if list-length targets > 0
          then deal-damage-to-permanent gs (list-at targets 0) amount
          else gs
      is GainLife (amount) ->
        let p = get-player gs controller
        in let new-general = general-gain-life (p.general) amount
        in let new-player = PlayerState {
          general = new-general,
          prismatic = p.prismatic,
          library = p.library,
          hand = p.hand,
          graveyard = p.graveyard,
          exile = p.exile,
          gem-drop-used = p.gem-drop-used
        }
        in set-player gs controller new-player
      is DrawCards (count) -> draw-n gs controller count
      is LoseLife (amount) ->
        let opp = if controller == 0 then 1 else 0
        in let p = get-player gs opp
        in let new-general = general-deal-damage (p.general) amount
        in let new-player = PlayerState {
          general = new-general,
          prismatic = p.prismatic,
          library = p.library,
          hand = p.hand,
          graveyard = p.graveyard,
          exile = p.exile,
          gem-drop-used = p.gem-drop-used
        }
        in set-player gs opp new-player
      is otherwise -> gs

  draw-n : GameState, Integer, Integer -> GameState
  draw-n (gs) (player-idx) (count) =
    if count <= 0 then gs
    else let p = get-player gs player-idx
    in let p2 = player-draw p
    in let gs2 = set-player gs player-idx p2
    in draw-n gs2 player-idx (count - 1)

  ai-pick-targets : GameState, CardTemplate, Integer -> List Integer
  ai-pick-targets (gs) (template) (player) =
    if has-destroy-in-abilities (template.abilities) then
      let opp = if player == 0 then 1 else 0
      in let biggest = find-biggest-threat (gs.battlefield) (gs.templates) opp 0 (list-length (gs.battlefield)) (-1) 0
      in if biggest >= 0 then [biggest] else []
    else []

  find-biggest-threat : List Permanent, List CardTemplate, Integer, Integer, Integer, Integer, Integer -> Integer
  find-biggest-threat (perms) (templates) (opp) (i) (len) (best-id) (best-power) =
    if i >= len then best-id
    else let perm = list-at perms i
    in if perm.controller == opp then
      let t = list-at templates (perm.template-id)
      in when t.card-type
        is Creature ->
          let power = t.power + perm.power-mod
          in if power > best-power then find-biggest-threat perms templates opp (i + 1) len (perm.id) power
          else find-biggest-threat perms templates opp (i + 1) len best-id best-power
        is otherwise -> find-biggest-threat perms templates opp (i + 1) len best-id best-power
    else find-biggest-threat perms templates opp (i + 1) len best-id best-power

Section: AI Combat

  ai-combat-phase : GameState, Integer, Stance, GeneralTemplate -> GameState
  ai-combat-phase (gs) (player) (stance) (gen-template) =
    let defender = if player == 0 then 1 else 0
    in let my-creatures = count-creatures (gs.battlefield) (gs.templates) player 0 (list-length (gs.battlefield)) 0
    in if my-creatures == 0 then gs
    else let should-atk = should-attack-check stance gen-template
    in if should-atk then
      let combat = ai-select-attackers (gs.battlefield) (gs.templates) player stance gen-template 0 (list-length (gs.battlefield)) combat-empty
      in if combat.num-attackers == 0 then gs
      else let gs2 = tap-attackers gs combat
      in let combat2 = ai-assign-blockers gs2 combat defender stance
      in let result = resolve-combat-damage gs2 combat2
      in let gs3 = check-state-based-actions (result.game)
      in gs3
    else gs

  should-attack-check : Stance, GeneralTemplate -> Boolean
  should-attack-check (stance) (gen-template) =
    if has-combat-bias (gen-template.modifiers) then
      when get-combat-bias (gen-template.modifiers)
        is AlwaysAttack -> True
        is SuicidalCharge -> True
        is NeverOverextend -> when stance
          is Aggressive -> True
          is Balanced -> True
          is otherwise -> False
        is Cautious -> when stance
          is Aggressive -> True
          is otherwise -> False
    else when stance
      is Aggressive -> True
      is Balanced -> True
      is Tempo -> True
      is otherwise -> False

  ai-select-attackers : List Permanent, List CardTemplate, Integer, Stance, GeneralTemplate, Integer, Integer, CombatState -> CombatState
  ai-select-attackers (perms) (templates) (player) (stance) (gen-template) (i) (len) (cs) =
    if i >= len then cs
    else let perm = list-at perms i
    in if perm.controller == player then
      let t = list-at templates (perm.template-id)
      in when t.card-type
        is Creature ->
          if can-attack perm (perm.keywords) then
            let dominated = t.power + perm.power-mod <= 0
            in if dominated then
              when stance
                is Aggressive -> ai-select-attackers perms templates player stance gen-template (i + 1) len (declare-attacker cs (perm.id))
                is otherwise -> ai-select-attackers perms templates player stance gen-template (i + 1) len cs
            else ai-select-attackers perms templates player stance gen-template (i + 1) len (declare-attacker cs (perm.id))
          else ai-select-attackers perms templates player stance gen-template (i + 1) len cs
        is otherwise -> ai-select-attackers perms templates player stance gen-template (i + 1) len cs
    else ai-select-attackers perms templates player stance gen-template (i + 1) len cs

  ai-assign-blockers : GameState, CombatState, Integer, Stance -> CombatState
  ai-assign-blockers (gs) (combat) (defender) (stance) =
    let available = get-untapped-creatures (gs.battlefield) (gs.templates) defender 0 (list-length (gs.battlefield)) []
    in assign-blockers-loop gs combat defender stance available 0 (combat.num-attackers)

  assign-blockers-loop : GameState, CombatState, Integer, Stance, List Integer, Integer, Integer -> CombatState
  assign-blockers-loop (gs) (combat) (defender) (stance) (available) (i) (num-atk) =
    if i >= num-atk then combat
    else if list-length available == 0 then combat
    else let attacker = list-at (combat.attackers) i
    in let atk-perm = find-permanent (gs.battlefield) (attacker.permanent-id) 0 (list-length (gs.battlefield))
    in let atk-template = get-template gs (atk-perm.template-id)
    in let atk-power = atk-template.power + atk-perm.power-mod
    in let gen-state = (get-player gs defender).general
    in let blocker-id = pick-best-blocker gs atk-power (gen-state.life) stance available 0 (list-length available) (-1) 0
    in if blocker-id >= 0 then
      let combat2 = declare-blocker combat blocker-id (attacker.permanent-id)
      in let available2 = gs-list-remove available blocker-id
      in assign-blockers-loop gs combat2 defender stance available2 (i + 1) num-atk
    else assign-blockers-loop gs combat defender stance available (i + 1) num-atk

  pick-best-blocker : GameState, Integer, Integer, Stance, List Integer, Integer, Integer, Integer, Integer -> Integer
  pick-best-blocker (gs) (atk-power) (my-life) (stance) (available) (i) (len) (best) (best-score) =
    if i >= len then best
    else let perm-id = list-at available i
    in let perm = find-permanent (gs.battlefield) perm-id 0 (list-length (gs.battlefield))
    in let t = get-template gs (perm.template-id)
    in let my-toughness = t.toughness + perm.toughness-mod
    in let my-defense = t.defense + perm.defense-mod
    in let survives = my-toughness > atk-power
    in let absorbs = my-defense >= atk-power
    in let score = if absorbs then 100 else if survives then 50 else if atk-power >= my-life / 3 then 30 else 0
    in let stance-bonus = when stance
      is Defensive -> 20
      is Control -> 15
      is otherwise -> 0
    in let total = score + stance-bonus
    in if total > best-score then pick-best-blocker gs atk-power my-life stance available (i + 1) len perm-id total
    else pick-best-blocker gs atk-power my-life stance available (i + 1) len best best-score

Section: Utility

  count-creatures : List Permanent, List CardTemplate, Integer, Integer, Integer, Integer -> Integer
  count-creatures (perms) (templates) (player) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in if perm.controller == player then
      let t = list-at templates (perm.template-id)
      in when t.card-type
        is Creature -> count-creatures perms templates player (i + 1) len (acc + 1)
        is otherwise -> count-creatures perms templates player (i + 1) len acc
    else count-creatures perms templates player (i + 1) len acc

  get-untapped-creatures : List Permanent, List CardTemplate, Integer, Integer, Integer, List Integer -> List Integer
  get-untapped-creatures (perms) (templates) (player) (i) (len) (acc) =
    if i >= len then acc
    else let perm = list-at perms i
    in if perm.controller == player then
      if perm.tapped == False then
        let t = list-at templates (perm.template-id)
        in when t.card-type
          is Creature -> get-untapped-creatures perms templates player (i + 1) len (list-push acc (perm.id))
          is otherwise -> get-untapped-creatures perms templates player (i + 1) len acc
      else get-untapped-creatures perms templates player (i + 1) len acc
    else get-untapped-creatures perms templates player (i + 1) len acc

