 We say:

Section: Server Loop

  opening : [Console] Nothing = act
    print-line-uni "PLANE-SERVER READY"
    plane-server-loop plane-server-new
  end

  plane-server-loop : PlaneServerState -> [Console] Nothing
  plane-server-loop (state) = act
    line-result <- read-line
    when line-result
      is Just (line) -> act
        new-state <- dispatch-plane-request state line
        plane-server-loop new-state
      end
      is None -> print-line-uni "PLANE-SERVER-EXIT"
    end

