Chapter: LiarsDiceWasm
  cites Games chapter LiarsDice
  cites Foreword chapter List

 The browser interface for Liar's Dice, on the handle contract in
 games-backlog.md GAME-11. The dice pools, the per-player counts and the
 alive flags are several lists, so the page holds the state's address.

 `ld-lose-die` and the roll write through `list-set-at`, which mutates in
 place, so `ld-wasm-step` copies the three lists before taking a turn.

 A bid is one integer carrying both halves, quantity and face, which is why
 the interface exposes `ld-wasm-bid-qty` and `ld-wasm-bid-face` rather than
 asking the page to know how they are packed.

 We say:

Section: Copying

  ld-copy-list : List Integer, Integer, Integer, List Integer -> List Integer
  ld-copy-list (src) (i) (n) (acc) =
    if i >= n then acc
    else ld-copy-list src (i + 1) n (list-push acc (list-at src i))

  ld-copy-state : LDState -> LDState
  ld-copy-state (s) =
    LDState {
      dice-counts = ld-copy-list (s.dice-counts) 0 (s.num-players) [],
      dice-pools = ld-copy-list (s.dice-pools) 0 (s.num-players * 5) [],
      num-players = s.num-players,
      current-bid = s.current-bid,
      last-bidder = s.last-bidder,
      current-turn = s.current-turn,
      alive = ld-copy-list (s.alive) 0 (s.num-players) [],
      alive-count = s.alive-count,
      rng = s.rng
    }

Section: The Browser Interface

  ld-wasm-new : Integer, Integer -> LDState
  ld-wasm-new (seed) (players) = ld-init seed players

  ld-wasm-step : LDState -> LDState
  ld-wasm-step (s) =
    if s.alive-count <= 1 then s
    else ld-do-turn (ld-copy-state s)

Section: Playing By Hand

 `ld-do-turn` decides for itself whether to raise or to call, and what to
 raise to, so a person cannot take a turn. A turn here is exactly one of two
 things: bid higher, or call the last bid a lie.

 WHAT COUNTS AS A RAISE IS STATED HERE BECAUSE THE ENGINE NEVER SAYS IT.
 `ld-ai-bid` only ever CONSTRUCTS raises, so the rule lives in that
 function's arithmetic and nowhere as a test: more dice than the standing
 bid, or the same number of a higher face. Reached from a browser that is
 not enough, because a page can offer any pair of numbers it likes, so the
 rule is written out. A bid is `qty * 10 + face` and 0 means no bid yet,
 which is why the first bid of a round is any legal pair rather than a
 raise over nothing.

  ld-wasm-can-bid : LDState, Integer, Integer -> Integer
  ld-wasm-can-bid (s) (qty) (face) =
    if s.alive-count <= 1 then 0
    else if face < 1 then 0
    else if face > 6 then 0
    else if qty < 1 then 0
    else if qty > ld-total-dice s then 0
    else if s.current-bid == 0 then 1
    else let cq = ld-bid-qty (s.current-bid)
    in let cf = ld-bid-face (s.current-bid)
    in if qty > cq then 1
    else if qty == cq then (if face > cf then 1 else 0)
    else 0

 Named `make-bid` rather than `bid`: `ld-wasm-bid` is already taken by the
 READER of the standing bid, and the two would be a duplicate definition.

  ld-wasm-make-bid : LDState, Integer, Integer -> LDState
  ld-wasm-make-bid (s) (qty) (face) =
    if ld-wasm-can-bid s qty face == 0 then s
    else let c = ld-copy-state s
    in let p = c.current-turn
    in LDState {
         dice-counts  = c.dice-counts,
         dice-pools   = c.dice-pools,
         num-players  = c.num-players,
         current-bid  = qty * 10 + face,
         last-bidder  = p,
         current-turn = ld-next-alive c p,
         alive        = c.alive,
         alive-count  = c.alive-count,
         rng          = c.rng
       }

 Calling the bid a lie. The loser is whoever was wrong: if the dice really
 are there the CHALLENGER loses one, otherwise the last bidder does. Every
 die is then rerolled and the bidding starts again from nothing, which is
 what `ld-do-turn` does on the same branch.

  ld-wasm-can-challenge : LDState -> Integer
  ld-wasm-can-challenge (s) =
    if s.alive-count <= 1 then 0
    else if s.current-bid == 0 then 0
    else 1

  ld-wasm-challenge : LDState -> LDState
  ld-wasm-challenge (s) =
    if ld-wasm-can-challenge s == 0 then s
    else let c = ld-copy-state s
    in let p = c.current-turn
    in let qty = ld-bid-qty (c.current-bid)
    in let face = ld-bid-face (c.current-bid)
    in let actual = ld-count-face c face
    in if actual >= qty then ld-settle c p
    else ld-settle c (c.last-bidder)

  ld-settle : LDState, Integer -> LDState
  ld-settle (s) (loser) =
    let s2 = ld-lose-die s loser
    in let s3 = ld-roll-all s2
    in LDState {
         dice-counts  = s3.dice-counts,
         dice-pools   = s3.dice-pools,
         num-players  = s3.num-players,
         current-bid  = 0,
         last-bidder  = s3.last-bidder,
         current-turn = ld-next-alive s3 loser,
         alive        = s3.alive,
         alive-count  = s3.alive-count,
         rng          = s3.rng
       }

 How many of a face are REALLY on the table. This is the answer a challenge
 turns on, and the page shows it only after the call has been made, because
 before that it is exactly the thing nobody is allowed to know.

  ld-wasm-actual : LDState -> Integer
  ld-wasm-actual (s) =
    if s.current-bid == 0 then (-1)
    else ld-count-face s (ld-bid-face (s.current-bid))

  ld-wasm-players : LDState -> Integer
  ld-wasm-players (s) = s.num-players

  ld-wasm-dice : LDState, Integer -> Integer
  ld-wasm-dice (s) (player) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else list-at (s.dice-counts) player

  ld-wasm-die : LDState, Integer, Integer -> Integer
  ld-wasm-die (s) (player) (k) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else if k < 0 then (-1)
    else if k >= 5 then (-1)
    else list-at (s.dice-pools) (player * 5 + k)

  ld-wasm-alive : LDState, Integer -> Integer
  ld-wasm-alive (s) (player) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else list-at (s.alive) player

  ld-wasm-alive-count : LDState -> Integer
  ld-wasm-alive-count (s) = s.alive-count

  ld-wasm-total : LDState -> Integer
  ld-wasm-total (s) = ld-total-dice s

  ld-wasm-bid : LDState -> Integer
  ld-wasm-bid (s) = s.current-bid

  ld-wasm-bid-qty : LDState -> Integer
  ld-wasm-bid-qty (s) = if s.current-bid < 0 then (-1) else ld-bid-qty (s.current-bid)

  ld-wasm-bid-face : LDState -> Integer
  ld-wasm-bid-face (s) = if s.current-bid < 0 then (-1) else ld-bid-face (s.current-bid)

  ld-wasm-turn : LDState -> Integer
  ld-wasm-turn (s) = s.current-turn

  ld-wasm-last-bidder : LDState -> Integer
  ld-wasm-last-bidder (s) = s.last-bidder

  ld-wasm-done : LDState -> Integer
  ld-wasm-done (s) = if s.alive-count <= 1 then 1 else 0

  ld-wasm-winner : LDState -> Integer
  ld-wasm-winner (s) =
    if s.alive-count > 1 then (-1)
    else ld-find-winner s 0

  ld-wasm-count-face : LDState, Integer -> Integer
  ld-wasm-count-face (s) (face) =
    if face < 1 then 0
    else if face > 6 then 0
    else ld-count-face s face

