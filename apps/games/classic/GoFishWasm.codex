Chapter: GoFishWasm
  cites Games chapter GoFish
  cites Foreword chapter List

 `gf-hand-set` writes the flag and the player's size counter through
 `list-set-at`, in place, so a turn copies all four lists first.

 Every card is in a hand, in the draw pile, or in a book of four, so the
 three counts add to fifty-two at every moment.

 We say:

Section: Copying

  wasm-exports : Text = ""

  gf-copy-list : List Integer, Integer, Integer, List Integer -> List Integer
  gf-copy-list (src) (i) (n) (acc) =
    if i >= n then acc
    else gf-copy-list src (i + 1) n (list-push acc (list-at src i))

  gf-copy-state : GoFishState -> GoFishState
  gf-copy-state (s) =
    GoFishState {
      hands = gf-copy-list (s.hands) 0 (s.num-players * 52) [],
      hand-sizes = gf-copy-list (s.hand-sizes) 0 (s.num-players) [],
      draw-pile = gf-copy-list (s.draw-pile) 0 52 [],
      pile-size = s.pile-size,
      books = gf-copy-list (s.books) 0 (s.num-players) [],
      current-player = s.current-player,
      num-players = s.num-players,
      game-over = s.game-over,
      total-books = s.total-books
    }

Section: The Browser Interface

  gf-wasm-new : Integer, Integer -> GoFishState
  gf-wasm-new (seed) (players) = gf-init seed players

  gf-wasm-step : GoFishState -> GoFishState
  gf-wasm-step (s) =
    if s.game-over then s
    else gf-do-turn (gf-copy-state s)

  gf-wasm-has : GoFishState, Integer, Integer -> Integer
  gf-wasm-has (s) (player) (card) =
    if player < 0 then 0
    else if player >= s.num-players then 0
    else if card < 0 then 0
    else if card >= 52 then 0
    else if gf-hand-has s player card then 1 else 0

  gf-wasm-size : GoFishState, Integer -> Integer
  gf-wasm-size (s) (player) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else list-at (s.hand-sizes) player

  gf-wasm-books : GoFishState, Integer -> Integer
  gf-wasm-books (s) (player) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else list-at (s.books) player

  gf-wasm-total-books : GoFishState -> Integer
  gf-wasm-total-books (s) = s.total-books

  gf-wasm-pile : GoFishState -> Integer
  gf-wasm-pile (s) = s.pile-size

  gf-wasm-players : GoFishState -> Integer
  gf-wasm-players (s) = s.num-players

  gf-wasm-cur : GoFishState -> Integer
  gf-wasm-cur (s) = s.current-player

  gf-wasm-done : GoFishState -> Integer
  gf-wasm-done (s) = if s.game-over then 1 else 0

Section: Playing By Hand

 A player may only ask for a rank the player holds, of another player at the
 table; gf-resolve-ask plays the rest.

  gf-wasm-can-ask : GoFishState, Integer -> Integer
  gf-wasm-can-ask (s) (rank) =
    if s.game-over then 0
    else if rank < 0 then 0
    else if rank > 12 then 0
    else if gf-count-rank-in-hand s (s.current-player) rank > 0 then 1
    else 0

  gf-wasm-ask : GoFishState, Integer, Integer -> GoFishState
  gf-wasm-ask (s) (rank) (target) =
    if gf-wasm-can-ask s rank == 0 then s
    else if target < 0 then s
    else if target >= s.num-players then s
    else if target == s.current-player then s
    else gf-ask-turn (gf-copy-state s) rank target

  gf-ask-turn : GoFishState, Integer, Integer -> GoFishState
  gf-ask-turn (s) (rank) (target) = gf-resolve-ask s (s.current-player) target rank

  gf-wasm-winner : GoFishState -> Integer
  gf-wasm-winner (s) = gf-find-winner s 0 0 (0 - 1)

Section: Setting Up a Position

 A grader seats np players with empty hands and an empty stock, then deals
 each card where it wants it, on copies.

  gf-wasm-empty : Integer -> GoFishState
  gf-wasm-empty (np) =
    let n = if np < 2 then 2 else if np > 4 then 4 else np
    in GoFishState { hands = gf-build-zeroes 0 (n * 52) [], hand-sizes = gf-build-zeroes 0 n [], draw-pile = gf-build-zeroes 0 52 [], pile-size = 0, books = gf-build-zeroes 0 n [], current-player = 0, num-players = n, game-over = False, total-books = 0 }

  gf-wasm-give : GoFishState, Integer, Integer -> GoFishState
  gf-wasm-give (s) (player) (card) =
    if player < 0 | player >= s.num-players | card < 0 | card >= 52 then s
    else gf-hand-set (gf-copy-state s) player card 1

  gf-wasm-stock : GoFishState, Integer -> GoFishState
  gf-wasm-stock (s) (card) =
    if card < 0 | card >= 52 | s.pile-size >= 52 then s
    else let c = gf-copy-state s
    in let w = list-set-at (c.draw-pile) (c.pile-size) card
    in GoFishState { hands = c.hands, hand-sizes = c.hand-sizes, draw-pile = c.draw-pile, pile-size = c.pile-size + 1, books = c.books, current-player = c.current-player, num-players = c.num-players, game-over = c.game-over, total-books = c.total-books }

  gf-wasm-rank : Integer -> Integer
  gf-wasm-rank (c) = if c < 0 then (-1) else if c >= 52 then (-1) else gf-rank c

  gf-wasm-rank-count : GoFishState, Integer, Integer -> Integer
  gf-wasm-rank-count (s) (player) (rank) =
    if player < 0 then 0
    else if player >= s.num-players then 0
    else if rank < 0 then 0
    else if rank >= 13 then 0
    else gf-count-rank-in-hand s player rank

