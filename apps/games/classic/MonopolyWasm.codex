Chapter: MonopolyWasm
  cites Games chapter Monopoly
  cites Games chapter Rng

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

 The page's person is seat 0.

  mo-wasm-new : Integer, Integer -> MonopolyState
  mo-wasm-new (seed) (players) = mono-set-human (mono-init seed players) 0

  mo-wasm-step : MonopolyState, Integer -> MonopolyState
  mo-wasm-step (s) (seed) = mono-step s seed

  mo-wasm-act : MonopolyState, Integer, Integer, Integer -> MonopolyState
  mo-wasm-act (s) (p) (kind) (arg) = mono-act s p kind arg

  mo-wasm-legal : MonopolyState, Integer, Integer, Integer -> Integer
  mo-wasm-legal (s) (p) (kind) (arg) = if mono-legal s p kind arg then 1 else 0

  mo-wasm-ai : MonopolyState -> Integer
  mo-wasm-ai (s) = mono-ai s

  mo-wasm-actor : MonopolyState -> Integer
  mo-wasm-actor (s) = mono-actor s

  mo-wasm-slot : MonopolyState, Integer -> Integer
  mo-wasm-slot (s) (i) =
    if i < 0 then (-9)
    else if i >= mono-size then (-9)
    else mono-get s i

 A grader's set-up: a copy with one slot of the state layout set.

  mo-wasm-poke : MonopolyState, Integer, Integer -> MonopolyState
  mo-wasm-poke (s) (i) (v) =
    if i < 0 then s
    else if i >= mono-size then s
    else mono-put (mono-copy s) i v

Section: Reading The Board

  mo-wasm-players : MonopolyState -> Integer
  mo-wasm-players (s) = mono-players s

  mo-wasm-seat-ok : MonopolyState, Integer -> Boolean
  mo-wasm-seat-ok (s) (p) = if p < 0 then False else p < mono-players s

  mo-wasm-cash : MonopolyState, Integer -> Integer
  mo-wasm-cash (s) (p) = if mo-wasm-seat-ok s p then mono-cash s p else (-1)

  mo-wasm-position : MonopolyState, Integer -> Integer
  mo-wasm-position (s) (p) = if mo-wasm-seat-ok s p then mono-pos s p else (-1)

  mo-wasm-in-jail : MonopolyState, Integer -> Integer
  mo-wasm-in-jail (s) (p) = if mo-wasm-seat-ok s p then (if mono-jailed s p then 1 else 0) else (-1)

  mo-wasm-jail-turns : MonopolyState, Integer -> Integer
  mo-wasm-jail-turns (s) (p) = if mo-wasm-seat-ok s p then mono-jail-turns s p else (-1)

  mo-wasm-cards : MonopolyState, Integer, Integer -> Integer
  mo-wasm-cards (s) (p) (d) =
    if mo-wasm-seat-ok s p == False then (-1)
    else if d < 0 then (-1)
    else if d > 1 then (-1)
    else mono-cards s p d

  mo-wasm-out : MonopolyState, Integer -> Integer
  mo-wasm-out (s) (p) = if mo-wasm-seat-ok s p then (if mono-out s p then 1 else 0) else (-1)

  mo-wasm-worth : MonopolyState, Integer -> Integer
  mo-wasm-worth (s) (p) = if mo-wasm-seat-ok s p then mono-worth s p else (-1)

  mo-wasm-props : MonopolyState -> Integer
  mo-wasm-props (s) = mono-deeds

  mo-wasm-owner : MonopolyState, Integer -> Integer
  mo-wasm-owner (s) (pi) = if mono-deed-ok pi then mono-owner s pi else (-2)

  mo-wasm-houses : MonopolyState, Integer -> Integer
  mo-wasm-houses (s) (pi) = if mono-deed-ok pi then mono-houses s pi else (-1)

  mo-wasm-mortgaged : MonopolyState, Integer -> Integer
  mo-wasm-mortgaged (s) (pi) = if mono-deed-ok pi then (if mono-mortgaged s pi then 1 else 0) else (-1)

  mo-wasm-cost : MonopolyState, Integer -> Integer
  mo-wasm-cost (s) (pi) = if mono-deed-ok pi then mono-price pi else (-1)

  mo-wasm-group : MonopolyState, Integer -> Integer
  mo-wasm-group (s) (pi) = if mono-deed-ok pi then mono-group pi else (-1)

  mo-wasm-space : Integer -> Integer
  mo-wasm-space (pi) = if mono-deed-ok pi then mono-space pi else (-1)

  mo-wasm-house-cost : Integer -> Integer
  mo-wasm-house-cost (pi) = if mono-deed-ok pi then mono-house-cost pi else (-1)

  mo-wasm-rent-at : MonopolyState, Integer -> Integer
  mo-wasm-rent-at (s) (pi) =
    if mono-deed-ok pi == False then (-1)
    else if mono-owner s pi < 0 then (-1)
    else mono-rent s pi 0

 A board square (0 to 39) and a deed (0 to 27) are different numbers, and
 both differ from a player.

  mo-wasm-prop-at : Integer -> Integer
  mo-wasm-prop-at (sq) =
    if sq < 0 then (-1)
    else if sq >= 40 then (-1)
    else mono-prop-at sq

Section: The Turn

  mo-wasm-cur : MonopolyState -> Integer
  mo-wasm-cur (s) = mono-cur s

  mo-wasm-phase : MonopolyState -> Integer
  mo-wasm-phase (s) = mono-phase s

  mo-wasm-turn : MonopolyState -> Integer
  mo-wasm-turn (s) = mono-get s mono-f-turn

  mo-wasm-done : MonopolyState -> Integer
  mo-wasm-done (s) = if mono-over s then 1 else 0

  mo-wasm-winner : MonopolyState -> Integer
  mo-wasm-winner (s) = mono-get s mono-f-winner

  mo-wasm-richest : MonopolyState -> Integer
  mo-wasm-richest (s) = mono-richest s

  mo-wasm-turn-cap : Integer
  mo-wasm-turn-cap = mono-turn-cap

  mo-wasm-die : MonopolyState, Integer -> Integer
  mo-wasm-die (s) (k) = if k == 0 then mono-get s mono-f-d1 else mono-get s mono-f-d2

  mo-wasm-last-roll : MonopolyState -> Integer
  mo-wasm-last-roll (s) = mono-get s mono-f-roll

  mo-wasm-offered : MonopolyState -> Integer
  mo-wasm-offered (s) = if mono-phase s == 1 then mono-get s mono-f-pending else (-1)

  mo-wasm-offer-space : MonopolyState -> Integer
  mo-wasm-offer-space (s) =
    let pi = mo-wasm-offered s
    in if pi < 0 then (-1) else mono-space pi

  mo-wasm-last-card : MonopolyState -> Integer
  mo-wasm-last-card (s) = mono-get s mono-f-card

  mo-wasm-card-throw : MonopolyState -> Integer
  mo-wasm-card-throw (s) = mono-get s mono-f-cthrow

  mo-wasm-bank-houses : MonopolyState -> Integer
  mo-wasm-bank-houses (s) = mono-get s mono-f-houses

  mo-wasm-bank-hotels : MonopolyState -> Integer
  mo-wasm-bank-hotels (s) = mono-get s mono-f-hotels

Section: Auctions, Debts And Offers

  mo-wasm-auction-deed : MonopolyState -> Integer
  mo-wasm-auction-deed (s) = if mono-phase s == 3 then mono-get s mono-f-aprop else (-1)

  mo-wasm-auction-high : MonopolyState -> Integer
  mo-wasm-auction-high (s) = mono-get s mono-f-ahigh

  mo-wasm-auction-lead : MonopolyState -> Integer
  mo-wasm-auction-lead (s) = mono-get s mono-f-alead

  mo-wasm-debts : MonopolyState -> Integer
  mo-wasm-debts (s) = mono-debts s

  mo-wasm-debt : MonopolyState, Integer, Integer -> Integer
  mo-wasm-debt (s) (k) (f) =
    if k < 0 then (-9)
    else if k >= mono-debts s then (-9)
    else mono-debt s k f

  mo-wasm-trade-want : MonopolyState -> Integer
  mo-wasm-trade-want (s) = if mono-phase s == 2 then mono-get s mono-f-twant else (-1)

  mo-wasm-trade-give : MonopolyState -> Integer
  mo-wasm-trade-give (s) = if mono-phase s == 2 then mono-get s mono-f-tgive else (-1)

  mo-wasm-trade-price : MonopolyState -> Integer
  mo-wasm-trade-price (s) = if mono-phase s == 2 then mono-get s mono-f-tprice else (-1)

 The engine's quote for a trade seat p proposes for a deed, which the page
 and the grader read before the trade is made.

  mo-wasm-quote-give : MonopolyState, Integer, Integer -> Integer
  mo-wasm-quote-give (s) (p) (want) = if mono-deed-ok want then mono-trade-give s p want else (-1)

  mo-wasm-quote-price : MonopolyState, Integer, Integer -> Integer
  mo-wasm-quote-price (s) (p) (want) = if mono-deed-ok want then mono-trade-price s p want else (-1)

  mo-wasm-deck : MonopolyState, Integer, Integer -> Integer
  mo-wasm-deck (s) (d) (k) =
    if d < 0 then (-1)
    else if d > 1 then (-1)
    else if k < 0 then (-1)
    else if k >= mono-deck-len s d then (-1)
    else mono-deck-card s d k

  mo-wasm-deck-len : MonopolyState, Integer -> Integer
  mo-wasm-deck-len (s) (d) = if d < 0 then (-1) else if d > 1 then (-1) else mono-deck-len s d

