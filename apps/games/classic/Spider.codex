Chapter: Spider
  cites Games chapter Rng
  cites Foreword chapter Random

 Two-suit Spider: 104 cards; columns 0-3 get 6, columns 4-9 get 5, and the
 stock holds 50, dealt 10 at a time.

 We say:

Section: Types

  SpiderState = record {
    col0            : List Integer,
    col1            : List Integer,
    col2            : List Integer,
    col3            : List Integer,
    col4            : List Integer,
    col5            : List Integer,
    col6            : List Integer,
    col7            : List Integer,
    col8            : List Integer,
    col9            : List Integer,
    stock           : List Integer,
    completed-suits : Integer,
    moves           : Integer
  }

  SpiderResult = record {
    completed-suits : Integer,
    moves           : Integer,
    won             : Boolean
  }

  SpiderMove = record {
    from-col  : Integer,
    seq-start : Integer,
    to-col    : Integer
  }

Section: Card Helpers

 Card ids are ace-high for every arcade game (index 12 is the ace). Spider's
 ace is the lowest card, so 12 folds to 0 and every other rank shifts up one.

  sp-rank : Integer -> Integer
  sp-rank (c) =
    let r = rng-mod c 13
    in if r == 12 then 0 else r + 1

  sp-suit : Integer -> Integer
  sp-suit (c) = c / 13

Section: Deck Building

  spider-deck-new : Integer, Integer -> List Integer
  spider-deck-new (seed) (suits) =
    let n = if suits < 1 then 1 else if suits > 8 then 8 else suits
    in let deck = sp-fill-deck n 0 []
    in sp-shuffle deck seed 103

 A Spider deck holds repeated cards: one suit is eight copies of each rank,
 two suits four.

  sp-fill-deck : Integer, Integer, List Integer -> List Integer
  sp-fill-deck (suits) (i) (acc) =
    if i >= 104 then acc
    else let suit = rng-mod (i / 13) suits
    in let rank = rng-mod i 13
    in sp-fill-deck suits (i + 1) (list-push acc (suit * 13 + rank))

  sp-draw : Integer, Integer -> Integer
  sp-draw (seed) (i) = rand-in-range seed i 0 i

  sp-shuffle : List Integer, Integer, Integer -> List Integer
  sp-shuffle (deck) (seed) (i) =
    if i <= 0 then deck
    else let j = sp-draw seed i
    in let vi = list-at deck i
    in let vj = list-at deck j
    in let d2 = list-set-at deck i vj
    in let d3 = list-set-at d2 j vi
    in sp-shuffle d3 seed (i - 1)

Section: Column Access

  sp-get-col : SpiderState, Integer -> List Integer
  sp-get-col (st) (c) =
    if c == 0 then st.col0
    else if c == 1 then st.col1
    else if c == 2 then st.col2
    else if c == 3 then st.col3
    else if c == 4 then st.col4
    else if c == 5 then st.col5
    else if c == 6 then st.col6
    else if c == 7 then st.col7
    else if c == 8 then st.col8
    else st.col9

  sp-set-col : SpiderState, Integer, List Integer -> SpiderState
  sp-set-col (st) (c) (col) =
    if c == 0 then SpiderState { col0 = col, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                  col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                  col8 = st.col8, col9 = st.col9, stock = st.stock,
                                  completed-suits = st.completed-suits, moves = st.moves }
    else if c == 1 then SpiderState { col0 = st.col0, col1 = col, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 2 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = col, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 3 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = col,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 4 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = col, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 5 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = col, col6 = st.col6, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 6 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = col, col7 = st.col7,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 7 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = col,
                                       col8 = st.col8, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else if c == 8 then SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                                       col8 = col, col9 = st.col9, stock = st.stock,
                                       completed-suits = st.completed-suits, moves = st.moves }
    else SpiderState { col0 = st.col0, col1 = st.col1, col2 = st.col2, col3 = st.col3,
                       col4 = st.col4, col5 = st.col5, col6 = st.col6, col7 = st.col7,
                       col8 = st.col8, col9 = col, stock = st.stock,
                       completed-suits = st.completed-suits, moves = st.moves }

Section: Construction

  spider-new : Integer, Integer -> SpiderState
  spider-new (seed) (suits) =
    let deck = spider-deck-new seed suits
    in sp-deal deck

  sp-deal : List Integer -> SpiderState
  sp-deal (deck) =
    let c0 = sp-take-col deck 0 6
    in let c1 = sp-take-col deck 6 6
    in let c2 = sp-take-col deck 12 6
    in let c3 = sp-take-col deck 18 6
    in let c4 = sp-take-col deck 24 5
    in let c5 = sp-take-col deck 29 5
    in let c6 = sp-take-col deck 34 5
    in let c7 = sp-take-col deck 39 5
    in let c8 = sp-take-col deck 44 5
    in let c9 = sp-take-col deck 49 5
    in let stock = sp-take-col deck 54 50
    in SpiderState { col0 = c0, col1 = c1, col2 = c2, col3 = c3,
                     col4 = c4, col5 = c5, col6 = c6, col7 = c7,
                     col8 = c8, col9 = c9, stock = stock,
                     completed-suits = 0, moves = 0 }

  sp-take-col : List Integer, Integer, Integer -> List Integer
  sp-take-col (deck) (start) (count) =
    sp-take-loop deck start count 0 []

  sp-take-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  sp-take-loop (deck) (start) (count) (i) (acc) =
    if i >= count then acc
    else sp-take-loop deck start count (i + 1) (list-push acc (list-at deck (start + i)))

Section: Sequence Logic

  sp-seq-len : List Integer, Integer -> Integer
  sp-seq-len (col) (from-idx) =
    let n = list-length col
    in if from-idx >= n then 0
    else sp-seq-loop col from-idx (from-idx + 1) 1

  sp-seq-loop : List Integer, Integer, Integer, Integer -> Integer
  sp-seq-loop (col) (prev) (i) (len) =
    let n = list-length col
    in if i >= n then len
    else let c-prev = list-at col prev
    in let c-curr = list-at col i
    in if sp-rank c-curr /= sp-rank c-prev - 1 then len
    else if sp-suit c-curr /= sp-suit c-prev then len
    else sp-seq-loop col i (i + 1) (len + 1)

  sp-seq-start : List Integer, Integer -> Integer
  sp-seq-start (col) (i) =
    if i <= 0 then 0
    else let c-prev = list-at col (i - 1)
    in let c-curr = list-at col i
    in if sp-rank c-curr /= sp-rank c-prev - 1 then i
    else if sp-suit c-curr /= sp-suit c-prev then i
    else sp-seq-start col (i - 1)

  sp-can-move : List Integer, List Integer, Integer -> Boolean
  sp-can-move (from-col) (to-col) (seq-start) =
    let to-n = list-length to-col
    in if to-n == 0 then True
    else let top-from = list-at from-col seq-start
    in let top-to = list-at to-col (to-n - 1)
    in sp-rank top-from == sp-rank top-to - 1

Section: Move Execution

  sp-apply-move : SpiderState, SpiderMove -> SpiderState
  sp-apply-move (st) (m) =
    let from-col = sp-get-col st (m.from-col)
    in let to-col = sp-get-col st (m.to-col)
    in let from-n = list-length from-col
    in let seq-count = from-n - m.seq-start
    in let moved = sp-take-from-end from-col m.seq-start seq-count
    in let trimmed = sp-drop-from-end from-col seq-count
    in let new-to = sp-append-cols (sp-take-loop to-col 0 (list-length to-col) 0 []) moved 0 (list-length moved)
    in let st2 = sp-set-col st (m.from-col) trimmed
    in let st3 = sp-set-col st2 (m.to-col) new-to
    in let st4 = SpiderState { col0 = st3.col0, col1 = st3.col1, col2 = st3.col2, col3 = st3.col3,
                                col4 = st3.col4, col5 = st3.col5, col6 = st3.col6, col7 = st3.col7,
                                col8 = st3.col8, col9 = st3.col9, stock = st3.stock,
                                completed-suits = st3.completed-suits, moves = st3.moves + 1 }
    in sp-check-complete st4 (m.to-col)

  sp-take-from-end : List Integer, Integer, Integer -> List Integer
  sp-take-from-end (col) (start) (count) =
    sp-take-loop col start count 0 []

  sp-drop-from-end : List Integer, Integer -> List Integer
  sp-drop-from-end (col) (count) =
    let n = list-length col
    in sp-take-loop col 0 (n - count) 0 []

 `list-push` extends its argument in place (L-ALIAS), so the column a move
 or a deal grows is copied first: the search returns to the parent state.

  sp-append-cols : List Integer, List Integer, Integer, Integer -> List Integer
  sp-append-cols (base) (extra) (i) (n) =
    if i >= n then base
    else sp-append-cols (list-push base (list-at extra i)) extra (i + 1) n

Section: Complete Suite Check

  sp-check-complete : SpiderState, Integer -> SpiderState
  sp-check-complete (st) (col-idx) =
    let col = sp-get-col st col-idx
    in let n = list-length col
    in if n < 13 then st
    else let seq-len = sp-seq-len col (n - 13)
    in if seq-len < 13 then st
    else let top = list-at col (n - 13)
    in if sp-rank top /= 12 then st
    else let trimmed = sp-drop-from-end col 13
    in let st2 = sp-set-col st col-idx trimmed
    in SpiderState { col0 = st2.col0, col1 = st2.col1, col2 = st2.col2, col3 = st2.col3,
                     col4 = st2.col4, col5 = st2.col5, col6 = st2.col6, col7 = st2.col7,
                     col8 = st2.col8, col9 = st2.col9, stock = st2.stock,
                     completed-suits = st2.completed-suits + 1, moves = st2.moves }

Section: Stock Deal

 Spider forbids a deal while any column stands empty.

  sp-any-empty : SpiderState, Integer -> Boolean
  sp-any-empty (st) (i) =
    if i >= 10 then False
    else if list-length (sp-get-col st i) == 0 then True
    else sp-any-empty st (i + 1)

  sp-deal-stock : SpiderState -> SpiderState
  sp-deal-stock (st) =
    let n = list-length (st.stock)
    in if sp-any-empty st 0 then st
    else if n < 10 then st
    else let st2 = sp-deal-one st 0 0
    in let st3 = sp-deal-one st2 1 1
    in let st4 = sp-deal-one st3 2 2
    in let st5 = sp-deal-one st4 3 3
    in let st6 = sp-deal-one st5 4 4
    in let st7 = sp-deal-one st6 5 5
    in let st8 = sp-deal-one st7 6 6
    in let st9 = sp-deal-one st8 7 7
    in let st10 = sp-deal-one st9 8 8
    in let st11 = sp-deal-one st10 9 9
    in let new-stock = sp-drop-from-end (st11.stock) 10
    in SpiderState { col0 = st11.col0, col1 = st11.col1, col2 = st11.col2, col3 = st11.col3,
                     col4 = st11.col4, col5 = st11.col5, col6 = st11.col6, col7 = st11.col7,
                     col8 = st11.col8, col9 = st11.col9, stock = new-stock,
                     completed-suits = st11.completed-suits, moves = st11.moves }

  sp-deal-one : SpiderState, Integer, Integer -> SpiderState
  sp-deal-one (st) (col-idx) (stock-idx) =
    let sn = list-length (st.stock)
    in if stock-idx >= sn then st
    else let card = list-at (st.stock) (sn - 1 - stock-idx)
    in let col = sp-get-col st col-idx
    in let col2 = list-push (sp-take-loop col 0 (list-length col) 0 []) card
    in sp-set-col st col-idx col2

Section: Position Hashing

 The ten column hashes are combined with bit-xor, so a candidate move's
 position hash is computed without building its state, which would
 allocate ten columns per candidate.

  sp-col-hash : Integer, List Integer, Integer, Integer, Integer -> Integer
  sp-col-hash (c) (col) (i) (n) (h) =
    if i >= n then h
    else sp-col-hash c col (i + 1) n (mix-bits h (list-at col i + 1))

  sp-col-hash-of : Integer, List Integer, Integer -> Integer
  sp-col-hash-of (c) (col) (n) =
    sp-col-hash c col 0 n (mix-bits 2654435761 (c + 1))

  sp-hash : SpiderState -> Integer
  sp-hash (st) = sp-hash-loop st 0 0

  sp-hash-loop : SpiderState, Integer, Integer -> Integer
  sp-hash-loop (st) (c) (acc) =
    if c >= 10 then acc
    else let col = sp-get-col st c
    in sp-hash-loop st (c + 1) (bit-xor acc (sp-col-hash-of c col (list-length col)))

  sp-hash-after : SpiderState, Integer, Integer, Integer, Integer -> Integer
  sp-hash-after (st) (h) (from-c) (seq-start) (to-c) =
    let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in let fn = list-length from-col
    in let tn = list-length to-col
    in let old-f = sp-col-hash-of from-c from-col fn
    in let old-t = sp-col-hash-of to-c to-col tn
    in let new-f = sp-col-hash-of from-c from-col seq-start
    in let new-t = sp-col-hash to-c from-col seq-start fn old-t
    in let a = bit-xor h old-f
    in let b = bit-xor a old-t
    in let c = bit-xor b new-f
    in bit-xor c new-t

Section: AI -- Greedy Solver

  sp-find-best-move : SpiderState, Integer, List Integer -> Integer
  sp-find-best-move (st) (h) (seen) =
    let suit-move = sp-find-completing-move st 0
    in if suit-move >= 0 then suit-move
    else sp-find-fresh-move st h seen 0

  sp-suggest-move : SpiderState -> Integer
  sp-suggest-move (st) = sp-find-best-move st (sp-hash st) []

  sp-find-fresh-move : SpiderState, Integer, List Integer, Integer -> Integer
  sp-find-fresh-move (st) (h) (seen) (from-c) =
    let best = sp-best-fresh st h seen 0 0
    in if best == 0 then (-1)
    else rng-mod best 1000000 - 1

 The move code is offset by one so that zero means no candidate.

  sp-best-fresh : SpiderState, Integer, List Integer, Integer, Integer -> Integer
  sp-best-fresh (st) (h) (seen) (from-c) (best) =
    if from-c >= 10 then best
    else let col = sp-get-col st from-c
    in let n = list-length col
    in if n == 0 then sp-best-fresh st h seen (from-c + 1) best
    else let seq-start = sp-seq-start col (n - 1)
    in sp-best-fresh st h seen (from-c + 1) (sp-best-start st h seen from-c seq-start n best)

  sp-best-start : SpiderState, Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  sp-best-start (st) (h) (seen) (from-c) (s) (n) (best) =
    if s >= n then best
    else sp-best-start st h seen from-c (s + 1) n (sp-best-target st h seen from-c s 0 best)

  sp-best-target : SpiderState, Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  sp-best-target (st) (h) (seen) (from-c) (seq-start) (to-c) (best) =
    if to-c >= 10 then best
    else if to-c == from-c then sp-best-target st h seen from-c seq-start (to-c + 1) best
    else let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in if list-length to-col == 0 & seq-start <= 0 then
      sp-best-target st h seen from-c seq-start (to-c + 1) best
    else if sp-can-move from-col to-col seq-start == False then
      sp-best-target st h seen from-c seq-start (to-c + 1) best
    else if sp-seen-has seen (sp-hash-after st h from-c seq-start to-c) 0 then
      sp-best-target st h seen from-c seq-start (to-c + 1) best
    else let pack = sp-rank-move st from-c seq-start to-c * 1000000 + from-c * 10000 + seq-start * 10 + to-c + 1
    in if pack > best then sp-best-target st h seen from-c seq-start (to-c + 1) pack
    else sp-best-target st h seen from-c seq-start (to-c + 1) best

  sp-rank-move : SpiderState, Integer, Integer, Integer -> Integer
  sp-rank-move (st) (from-c) (seq-start) (to-c) =
    let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in let fn = list-length from-col
    in let tn = list-length to-col
    in let suited = if tn == 0 then False
                    else sp-suit (list-at from-col seq-start) == sp-suit (list-at to-col (tn - 1))
    in let run-start = sp-seq-start from-col (fn - 1)
    in let suit-bonus = if suited then 1000 else 0
    in let split-cost = if seq-start > run-start then 300 else 0
    in let empty-source = if seq-start == 0 then 500 else 0
    in let uncovers = if seq-start > 0 then 200 else 0
    in let empty-target = if tn == 0 then 5 else 0
    in suit-bonus + empty-source + uncovers + (fn - seq-start) * 10 + empty-target - split-cost

  sp-seen-has : List Integer, Integer, Integer -> Boolean
  sp-seen-has (seen) (h) (i) =
    if i >= list-length seen then False
    else if list-at seen i == h then True
    else sp-seen-has seen h (i + 1)

  sp-find-completing-move : SpiderState, Integer -> Integer
  sp-find-completing-move (st) (from-c) =
    if from-c >= 10 then (-1)
    else let col = sp-get-col st from-c
    in let n = list-length col
    in if n == 0 then sp-find-completing-move st (from-c + 1)
    else let seq-start = sp-seq-start col (n - 1)
    in let m = sp-find-target-completing st from-c seq-start 0
    in if m >= 0 then m
    else sp-find-completing-move st (from-c + 1)

  sp-find-target-completing : SpiderState, Integer, Integer, Integer -> Integer
  sp-find-target-completing (st) (from-c) (seq-start) (to-c) =
    if to-c >= 10 then (-1)
    else if to-c == from-c then sp-find-target-completing st from-c seq-start (to-c + 1)
    else let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in if sp-can-move from-col to-col seq-start == False then
      sp-find-target-completing st from-c seq-start (to-c + 1)
    else let score = sp-move-score st from-c seq-start to-c
    in if score >= 100 then from-c * 10000 + seq-start * 10 + to-c
    else sp-find-target-completing st from-c seq-start (to-c + 1)

  sp-move-score : SpiderState, Integer, Integer, Integer -> Integer
  sp-move-score (st) (from-c) (seq-start) (to-c) =
    let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in let to-n = list-length to-col
    in if to-n == 0 then 10
    else let top-to = list-at to-col (to-n - 1)
    in let top-from = list-at from-col seq-start
    in let suit-match = sp-suit top-from == sp-suit top-to
    in if suit-match then 100 else 10

  sp-decode-move : Integer -> SpiderMove
  sp-decode-move (code) =
    let from-c = code / 10000
    in let rem = rng-mod code 10000
    in let seq-start = rem / 10
    in let to-c = rng-mod rem 10
    in SpiderMove { from-col = from-c, seq-start = seq-start, to-col = to-c }

Section: Search

 A branch is undone with a heap restore, so a result passes up as one
 packed Integer (nodes * 65536 + moves * 16 + best suits), which survives
 the restore where a record would not. The visited table is built before the
 search and written with `list-set-at`, which allocates nothing.

 262144 slots at 8 bytes is 2 MB, and a budget of 100000 nodes keeps the
 table under half full. A depth of 1000 bounds the stack.

  sp-table-size : Integer
  sp-table-size = 262144

  sp-node-budget : Integer
  sp-node-budget = 100000

  sp-max-depth : Integer
  sp-max-depth = 1000

  sp-table-new : Integer, List Integer -> List Integer
  sp-table-new (n) (acc) =
    if n <= 0 then acc
    else sp-table-new (n - 1) (list-push acc 0)

  sp-table-add : List Integer, Integer -> Boolean
  sp-table-add (table) (h) =
    let key = if h == 0 then 1 else h
    in sp-table-probe table key (rng-mod (bit-shru key 1) sp-table-size) 0

  sp-table-probe : List Integer, Integer, Integer, Integer -> Boolean
  sp-table-probe (table) (key) (i) (tries) =
    if tries >= sp-table-size then False
    else let e = list-at table i
    in if e == key then False
    else if e == 0 then (let t2 = list-set-at table i key in True)
    else sp-table-probe table key (rng-mod (i + 1) sp-table-size) (tries + 1)

  sp-pack : Integer, Integer, Integer -> Integer
  sp-pack (nodes) (moves) (best) =
    nodes * 65536 + (if moves > 4095 then 4095 else moves) * 16 + best

  sp-pack-nodes : Integer -> Integer
  sp-pack-nodes (p) = p / 65536

  sp-pack-moves : Integer -> Integer
  sp-pack-moves (p) = rng-mod p 65536 / 16

  sp-pack-best : Integer -> Integer
  sp-pack-best (p) = rng-mod p 16

 The score is offset by 10000 so that every candidate packs positive and 0
 can mark one already tried.

  sp-candidates : SpiderState, Integer, List Integer -> List Integer
  sp-candidates (st) (from-c) (acc) =
    if from-c >= 10 then acc
    else let col = sp-get-col st from-c
    in let n = list-length col
    in if n == 0 then sp-candidates st (from-c + 1) acc
    else let seq-start = sp-seq-start col (n - 1)
    in sp-candidates st (from-c + 1) (sp-cand-start st from-c seq-start n acc)

  sp-cand-start : SpiderState, Integer, Integer, Integer, List Integer -> List Integer
  sp-cand-start (st) (from-c) (s) (n) (acc) =
    if s >= n then acc
    else sp-cand-start st from-c (s + 1) n (sp-cand-target st from-c s 0 acc)

  sp-cand-target : SpiderState, Integer, Integer, Integer, List Integer -> List Integer
  sp-cand-target (st) (from-c) (seq-start) (to-c) (acc) =
    if to-c >= 10 then acc
    else if to-c == from-c then sp-cand-target st from-c seq-start (to-c + 1) acc
    else let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in if list-length to-col == 0 & seq-start <= 0 then sp-cand-target st from-c seq-start (to-c + 1) acc
    else if sp-can-move from-col to-col seq-start == False then sp-cand-target st from-c seq-start (to-c + 1) acc
    else if sp-off-suit-split st from-c seq-start to-c then sp-cand-target st from-c seq-start (to-c + 1) acc
    else let pack = (sp-rank-move st from-c seq-start to-c + 10000) * 1000000 + from-c * 10000 + seq-start * 10 + to-c + 1
    in sp-cand-target st from-c seq-start (to-c + 1) (list-push acc pack)

 Splitting a run onto a card of another suit uncovers nothing and joins
 nothing, and the search spends its budget reordering such moves.

  sp-off-suit-split : SpiderState, Integer, Integer, Integer -> Boolean
  sp-off-suit-split (st) (from-c) (seq-start) (to-c) =
    let from-col = sp-get-col st from-c
    in let to-col = sp-get-col st to-c
    in let tn = list-length to-col
    in if seq-start <= sp-seq-start from-col (list-length from-col - 1) then False
    else if tn == 0 then True
    else sp-suit (list-at from-col seq-start) /= sp-suit (list-at to-col (tn - 1))

  sp-max-index : List Integer, Integer, Integer, Integer -> Integer
  sp-max-index (xs) (i) (best-i) (best) =
    if i >= list-length xs then best-i
    else let x = list-at xs i
    in if x > best then sp-max-index xs (i + 1) i x
    else sp-max-index xs (i + 1) best-i best

  sp-dfs : SpiderState, List Integer, Integer, Integer -> Integer
  sp-dfs (st) (table) (budget) (depth) =
    if st.completed-suits >= 8 then sp-pack 1 (st.moves) 8
    else if budget <= 1 then sp-pack 1 (st.moves) (st.completed-suits)
    else if depth >= sp-max-depth then sp-pack 1 (st.moves) (st.completed-suits)
    else let cands = sp-candidates st 0 []
    in sp-children st table cands False budget depth 1 (st.moves) (st.completed-suits)

  sp-children : SpiderState, List Integer, List Integer, Boolean, Integer, Integer, Integer, Integer, Integer -> Integer
  sp-children (st) (table) (cands) (dealt) (budget) (depth) (used) (best-moves) (best) =
    if used >= budget then sp-pack used best-moves best
    else let i = sp-max-index cands 0 (-1) 0
    in if i < 0 then
      (if dealt then sp-pack used best-moves best
       else if sp-any-empty st 0 then sp-pack used best-moves best
       else if list-length (st.stock) < 10 then sp-pack used best-moves best
       else let mark = __heap-save
       in let r = sp-child st table (sp-deal-stock st) (budget - used) depth
       in let back = __heap-restore mark
       in sp-after-child st table cands True budget depth used best-moves best r)
    else let code = rng-mod (list-at cands i) 1000000 - 1
    in let t = list-set-at cands i 0
    in let mark = __heap-save
    in let r = sp-child-of-move st table code (budget - used) depth
    in let back = __heap-restore mark
    in sp-after-child st table cands dealt budget depth used best-moves best r

  sp-child-of-move : SpiderState, List Integer, Integer, Integer, Integer -> Integer
  sp-child-of-move (st) (table) (code) (left) (depth) =
    sp-child st table (sp-apply-move st (sp-decode-move code)) left depth

  sp-child : SpiderState, List Integer, SpiderState, Integer, Integer -> Integer
  sp-child (st) (table) (st2) (left) (depth) =
    if sp-table-add table (sp-hash st2) then sp-dfs st2 table left (depth + 1)
    else 0

  sp-after-child : SpiderState, List Integer, List Integer, Boolean, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  sp-after-child (st) (table) (cands) (dealt) (budget) (depth) (used) (best-moves) (best) (r) =
    let used2 = used + sp-pack-nodes r
    in let rb = sp-pack-best r
    in if rb >= 8 then sp-pack used2 (sp-pack-moves r) 8
    else if rb > best then sp-children st table cands dealt budget depth used2 (sp-pack-moves r) rb
    else sp-children st table cands dealt budget depth used2 best-moves best

Section: Game Runner

  run-spider-game : Integer -> SpiderResult
  run-spider-game (seed) =
    let mark = __heap-save
    in let st = spider-new seed 2
    in let table = sp-table-new sp-table-size []
    in let added = sp-table-add table (sp-hash st)
    in let p = sp-dfs st table sp-node-budget 0
    in let back = __heap-restore mark
    in let best = sp-pack-best p
    in SpiderResult { completed-suits = best, moves = sp-pack-moves p, won = best >= 8 }

Section: Formatting

  format-spider-result : SpiderResult -> Text
  format-spider-result (r) =
    let status = if r.won then "Won!" else "Incomplete"
    in "Spider Solitaire (2-suit): " & status &
       " suits=" & show (r.completed-suits) & "/8" &
       " moves=" & show (r.moves)

