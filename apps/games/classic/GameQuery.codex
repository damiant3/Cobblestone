Chapter: GameQuery
  cites Foreword chapter CCE

 9223372036854775759 is 2^63 - 1 less 48: `parse-int-loop` adds the digit's code
 point before subtracting 48, so `acc * 10 + c` traps above it (measured on
 `GameServer`, seed 9D87E951, 2026-10-20). It has 19 digits.

Section: Numeric Parameters

  parse-max-text : Text = "9223372036854775759"

  query-digit : Text, Integer -> Integer
  query-digit (s) (i) = to-unicode (char-code (char-at s i)) - 48

  leading-digit-end : Text, Integer -> Integer
  leading-digit-end (s) (i) =
    if i >= text-length s then i
    else let d = query-digit s i
    in if d < 0 then i
    else if d > 9 then i
    else leading-digit-end s (i + 1)

  leading-zero-end : Text, Integer, Integer -> Integer
  leading-zero-end (s) (i) (stop) =
    if i >= stop then i
    else if query-digit s i == 0 then leading-zero-end s (i + 1) stop
    else i

  digits-above-max : Text, Integer, Integer -> Boolean
  digits-above-max (s) (start) (i) =
    if i >= 19 then False
    else let a = query-digit s (start + i)
    in let m = query-digit parse-max-text i
    in if a > m then True
    else if a < m then False
    else digits-above-max s start (i + 1)

  value-overflows : Text -> Boolean
  value-overflows (s) =
    let stop = leading-digit-end s 0
    in let start = leading-zero-end s 0 stop
    in let n = stop - start
    in if n < 19 then False
    else if n > 19 then True
    else digits-above-max s start 0

  query-overflows : Text -> Boolean
  query-overflows (line) =
    let parts = text-split line " "
    in if list-length parts < 2 then False
    else let full = list-at parts 1
    in let qpos = query-find-char full 63 0
    in if qpos < 0 then False
    else pairs-overflow (text-split (substring full (qpos + 1) (text-length full - qpos - 1)) "&") 0

  pairs-overflow : List Text, Integer -> Boolean
  pairs-overflow (pairs) (i) =
    if i >= list-length pairs then False
    else let pair = list-at pairs i
    in let eqpos = query-find-char pair 61 0
    in if eqpos < 0 then pairs-overflow pairs (i + 1)
    else if value-overflows (substring pair (eqpos + 1) (text-length pair - eqpos - 1)) then True
    else pairs-overflow pairs (i + 1)

  query-find-char : Text, Integer, Integer -> Integer
  query-find-char (s) (target) (i) =
    if i >= text-length s then (-1)
    else if to-unicode (char-code (char-at s i)) == target then i
    else query-find-char s target (i + 1)
