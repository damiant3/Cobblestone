Chapter: CrazyEightsWasm
  cites Games chapter CrazyEights
  cites Foreword chapter List

 A hand is a bitmap of fifty-two flags per player, with a size counter kept
 beside the bitmap rather than derived from it. `ce-hand-set` writes both
 through `list-set-at`, in place, so a turn copies all three lists first.

 We say:

Section: Copying

  wasm-exports : Text = ""

  ce-copy-list : List Integer, Integer, Integer, List Integer -> List Integer
  ce-copy-list (src) (i) (n) (acc) =
    if i >= n then acc
    else ce-copy-list src (i + 1) n (list-push acc (list-at src i))

  ce-copy-state : CrazyEightsState -> CrazyEightsState
  ce-copy-state (s) =
    CrazyEightsState {
      hands = ce-copy-list (s.hands) 0 (s.num-players * 52) [],
      hand-sizes = ce-copy-list (s.hand-sizes) 0 (s.num-players) [],
      draw-pile = ce-copy-list (s.draw-pile) 0 52 [],
      pile-size = s.pile-size,
      discard-rank = s.discard-rank,
      discard-suit = s.discard-suit,
      current-player = s.current-player,
      num-players = s.num-players,
      direction = s.direction,
      game-over = s.game-over,
      winner = s.winner,
      declared-suit = s.declared-suit
    }

Section: The Browser Interface

  ce-wasm-new : Integer, Integer -> CrazyEightsState
  ce-wasm-new (seed) (players) = ce-init seed players

  ce-wasm-step : CrazyEightsState -> CrazyEightsState
  ce-wasm-step (s) =
    if s.game-over then s
    else ce-do-turn (ce-copy-state s)

Section: Playing By Hand

 The player names the suit an eight declares. `ce-play-card` picks a suit
 itself, so the declared suit is set afterwards; `ce-advance` and the
 winning branch both carry `declared-suit` through untouched.

 Rank 6 is an eight. A turn plays one legal card or draws one card, and the
 draw is open whenever a card can be drawn, a card to play or not.

  ce-wasm-can-play : CrazyEightsState, Integer -> Integer
  ce-wasm-can-play (s) (card) =
    if s.game-over then 0
    else if card < 0 then 0
    else if card >= 52 then 0
    else if ce-can-play s (s.current-player) card then 1
    else 0

  ce-wasm-play : CrazyEightsState, Integer, Integer -> CrazyEightsState
  ce-wasm-play (s) (card) (suit) =
    if ce-wasm-can-play s card == 0 then s
    else let played = ce-play-card (ce-copy-state s) (s.current-player) card
    in if ce-rank card /= 6 then played
    else if suit < 0 then played
    else if suit > 3 then played
    else ce-declare played suit

  ce-declare : CrazyEightsState, Integer -> CrazyEightsState
  ce-declare (s) (suit) =
    CrazyEightsState {
      hands = s.hands, hand-sizes = s.hand-sizes,
      draw-pile = s.draw-pile, pile-size = s.pile-size,
      discard-rank = s.discard-rank, discard-suit = s.discard-suit,
      current-player = s.current-player, num-players = s.num-players,
      direction = s.direction,
      game-over = s.game-over, winner = s.winner,
      declared-suit = suit
    }

  ce-wasm-stuck : CrazyEightsState -> Integer
  ce-wasm-stuck (s) =
    if s.game-over then 0
    else if ce-find-play s (s.current-player) >= 0 then 0
    else 1

  ce-wasm-can-draw : CrazyEightsState -> Integer
  ce-wasm-can-draw (s) = if s.game-over == False & ce-can-draw s then 1 else 0

  ce-wasm-draw : CrazyEightsState -> CrazyEightsState
  ce-wasm-draw (s) =
    if ce-wasm-can-draw s == 0 then s
    else ce-advance (ce-draw-one (ce-copy-state s) (s.current-player))

  ce-wasm-points : CrazyEightsState, Integer -> Integer
  ce-wasm-points (s) (player) = if player < 0 | player >= s.num-players then (-1) else ce-hand-points s player 0 0

  ce-wasm-top : CrazyEightsState -> Integer
  ce-wasm-top (s) = ce-top s

Section: Setting Up a Position

 A grader seats np players with empty hands and stock, a top card, then deals
 each card where it wants it, on copies.

  ce-wasm-empty : Integer, Integer -> CrazyEightsState
  ce-wasm-empty (np) (top) =
    let n = if np < 2 then 2 else if np > 4 then 4 else np
    in CrazyEightsState { hands = ce-build-zeroes 0 (n * 52) [], hand-sizes = ce-build-zeroes 0 n [], draw-pile = ce-build-zeroes 0 52 [], pile-size = 0, discard-rank = ce-rank top, discard-suit = ce-suit top, current-player = 0, num-players = n, direction = 1, game-over = False, winner = 0, declared-suit = ce-suit top }

  ce-wasm-give : CrazyEightsState, Integer, Integer -> CrazyEightsState
  ce-wasm-give (s) (player) (card) =
    if player < 0 | player >= s.num-players | card < 0 | card >= 52 then s
    else ce-hand-set (ce-copy-state s) player card 1

  ce-wasm-stock : CrazyEightsState, Integer -> CrazyEightsState
  ce-wasm-stock (s) (card) =
    if card < 0 | card >= 52 | s.pile-size >= 52 then s
    else let c = ce-copy-state s
    in let w = list-set-at (c.draw-pile) (c.pile-size) card
    in CrazyEightsState { hands = c.hands, hand-sizes = c.hand-sizes, draw-pile = c.draw-pile, pile-size = c.pile-size + 1, discard-rank = c.discard-rank, discard-suit = c.discard-suit, current-player = c.current-player, num-players = c.num-players, direction = c.direction, game-over = c.game-over, winner = c.winner, declared-suit = c.declared-suit }

  ce-wasm-call : CrazyEightsState, Integer -> CrazyEightsState
  ce-wasm-call (s) (suit) = ce-declare (ce-copy-state s) suit
  ce-wasm-has : CrazyEightsState, Integer, Integer -> Integer
  ce-wasm-has (s) (player) (card) =
    if player < 0 then 0
    else if player >= s.num-players then 0
    else if card < 0 then 0
    else if card >= 52 then 0
    else if ce-hand-has s player card then 1 else 0

  ce-wasm-size : CrazyEightsState, Integer -> Integer
  ce-wasm-size (s) (player) =
    if player < 0 then (-1)
    else if player >= s.num-players then (-1)
    else list-at (s.hand-sizes) player

  ce-wasm-can : CrazyEightsState, Integer, Integer -> Integer
  ce-wasm-can (s) (player) (card) =
    if player < 0 then 0
    else if player >= s.num-players then 0
    else if card < 0 then 0
    else if card >= 52 then 0
    else if ce-can-play s player card then 1 else 0

  ce-wasm-players : CrazyEightsState -> Integer
  ce-wasm-players (s) = s.num-players

  ce-wasm-cur : CrazyEightsState -> Integer
  ce-wasm-cur (s) = s.current-player

  ce-wasm-pile : CrazyEightsState -> Integer
  ce-wasm-pile (s) = s.pile-size

  ce-wasm-drank : CrazyEightsState -> Integer
  ce-wasm-drank (s) = s.discard-rank

  ce-wasm-dsuit : CrazyEightsState -> Integer
  ce-wasm-dsuit (s) = s.discard-suit

  ce-wasm-declared : CrazyEightsState -> Integer
  ce-wasm-declared (s) = s.declared-suit

  ce-wasm-done : CrazyEightsState -> Integer
  ce-wasm-done (s) = if s.game-over then 1 else 0

  ce-wasm-winner : CrazyEightsState -> Integer
  ce-wasm-winner (s) = s.winner

  ce-wasm-card-rank : Integer -> Integer
  ce-wasm-card-rank (c) = if c < 0 then (-1) else if c >= 52 then (-1) else ce-rank c

  ce-wasm-card-suit : Integer -> Integer
  ce-wasm-card-suit (c) = if c < 0 then (-1) else if c >= 52 then (-1) else ce-suit c

