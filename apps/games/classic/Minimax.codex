Chapter: Minimax
  cites Games chapter Rng
  cites Games chapter TicTacToe

 Scores are integers: positive favors player 1, negative player 2.
 TicTacToe searches to full depth: at most nine plies at two frames per ply,
 about twenty frames, safe on the bare-metal stack.

 We say:

Section: TicTacToe Full-Depth Search

  ttt-empty-count : TttBoard, Integer, Integer -> Integer
  ttt-empty-count (b) (i) (acc) =
    if i >= 9 then acc
    else if ttt-empty b i then ttt-empty-count b (i + 1) (acc + 1)
    else ttt-empty-count b (i + 1) acc

 Score a position by searching every line of play to the end of the game.
 Scores are taken from player 1's perspective and discounted by depth so
 the search prefers the fastest win and the slowest loss: a win at depth d
 scores 100 - d, a loss scores d - 100, a draw scores 0.

  ttt-mm-score : TttBoard, Integer -> Integer
  ttt-mm-score (b) (depth) =
    if b.game-over then
      if b.winner == 1 then 100 - depth
      else if b.winner == 2 then depth - 100
      else 0
    else if b.current-player == 1 then ttt-mm-fold b 0 (-1000) depth
    else ttt-mm-fold b 0 1000 depth

  ttt-mm-fold : TttBoard, Integer, Integer, Integer -> Integer
  ttt-mm-fold (b) (col) (acc) (depth) =
    if col >= 9 then acc
    else if ttt-empty b col == False then ttt-mm-fold b (col + 1) acc depth
    else let s = ttt-mm-score (ttt-move b col) (depth + 1)
    in let keep = ttt-mm-keep (b.current-player) s acc
    in ttt-mm-fold b (col + 1) keep depth

  ttt-mm-keep : Integer, Integer, Integer -> Integer
  ttt-mm-keep (p) (s) (acc) =
    if p == 1 then if s > acc then s else acc
    else if s < acc then s else acc

  ttt-mm-pick : TttBoard, Integer, Integer, Integer -> Integer
  ttt-mm-pick (b) (col) (best-col) (best-score) =
    if col >= 9 then best-col
    else if ttt-empty b col == False then ttt-mm-pick b (col + 1) best-col best-score
    else let s = ttt-mm-score (ttt-move b col) 1
    in let better = if b.current-player == 1 then s > best-score else s < best-score
    in if better then ttt-mm-pick b (col + 1) col s
    else ttt-mm-pick b (col + 1) best-col best-score

  ttt-perfect-ai : TttBoard -> Integer
  ttt-perfect-ai (b) =
    if b.game-over then -1
    else if ttt-empty-count b 0 0 == 9 then 4
    else let init = if b.current-player == 1 then -1000 else 1000
    in ttt-mm-pick b 0 (-1) init

Section: Zero-Player Game

  run-ttt-perfect : TttResult
  run-ttt-perfect =
    ttt-perfect-loop ttt-new 0

  ttt-perfect-loop : TttBoard, Integer -> TttResult
  ttt-perfect-loop (b) (moves) =
    if b.game-over then TttResult { winner = b.winner, moves-made = moves }
    else if moves > 9 then TttResult { winner = b.winner, moves-made = moves }
    else let pos = ttt-perfect-ai b
    in if pos < 0 then TttResult { winner = b.winner, moves-made = moves }
    else ttt-perfect-loop (ttt-move b pos) (moves + 1)

  format-ttt-perfect : TttResult -> Text
  format-ttt-perfect (r) =
    let w = if r.winner == 1 then "X wins"
            else if r.winner == 2 then "O wins"
            else "Draw"
    in "TicTacToe (zero players, perfect play): " & w & " in " & show (r.moves-made) & " moves"

