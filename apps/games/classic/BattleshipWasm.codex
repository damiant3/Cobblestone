Chapter: BattleshipWasm
  cites Games chapter Battleship
  cites Games chapter Rng
  cites Foreword chapter List

 `bs-shoot` writes into the tracking grid through `list-set-at`, in place,
 so every shot copies the tracking grid first. The ships grids are only read,
 so a state shares them with its successor; copying them would allocate two
 hundred cells a round.

 `bs-empty-grid` is a nullary definition, a recipe rather than a cell, so the
 two fresh tracking grids are distinct.

 We say:

Section: Copying

  wasm-exports : Text = ""

  bs-copy-cells : List Integer, Integer, List Integer -> List Integer
  bs-copy-cells (src) (i) (acc) =
    if i >= 100 then acc
    else bs-copy-cells src (i + 1) (list-push acc (list-at src i))

  bs-copy-grid : BsGrid -> BsGrid
  bs-copy-grid (g) = BsGrid { cells = bs-copy-cells (g.cells) 0 [] }

Section: The Browser Interface

  bs-wasm-new : Integer -> BsState
  bs-wasm-new (seed) =
    let r0 = rng-new seed
    in let r1 = rng-next r0
    in let r2 = rng-next r1
    in BsState {
      p1-ships = bs-place-ships r1, p1-tracking = bs-empty-grid,
      p2-ships = bs-place-ships r2, p2-tracking = bs-empty-grid,
      p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0,
      rng = r2, game-over = False, winner = 0
    }

  bs-copy-state : BsState -> BsState
  bs-copy-state (st) =
    BsState { p1-ships = st.p1-ships, p1-tracking = bs-copy-grid (st.p1-tracking), p2-ships = st.p2-ships, p2-tracking = bs-copy-grid (st.p2-tracking), p1-hits = st.p1-hits, p2-hits = st.p2-hits, p1-shots = st.p1-shots, p2-shots = st.p2-shots, rng = st.rng, game-over = st.game-over, winner = st.winner }

 One shot, by the player to move (Battleship's Rule 2).

  bs-wasm-step : BsState -> BsState
  bs-wasm-step (st) = if st.game-over then st else bs-step-shot (bs-copy-state st)

Section: Playing By Hand

 A tracking cell is 0 unknown, 1 miss, 2 hit. The page's player is player 1
 and fires only on player 1's turn, at an unknown cell; the computer then
 answers with its shot unless that shot ended the game.

  bs-wasm-can-fire : BsState, Integer, Integer -> Integer
  bs-wasm-can-fire (st) (row) (col) =
    if st.game-over then 0
    else if bs-to-move st /= 1 then 0
    else if row < 0 | row >= 10 | col < 0 | col >= 10 then 0
    else if bs-cell (st.p1-tracking) row col /= 0 then 0
    else 1

  bs-wasm-fire : BsState, Integer, Integer -> BsState
  bs-wasm-fire (st) (row) (col) =
    if bs-wasm-can-fire st row col == 0 then st
    else let s1 = bs-shot-by (bs-copy-state st) 1 row col
    in if s1.game-over then s1 else bs-step-shot s1

  bs-wasm-to-move : BsState -> Integer
  bs-wasm-to-move (st) = if st.game-over then 0 else bs-to-move st

  bs-wasm-sunk : BsState, Integer, Integer -> Integer
  bs-wasm-sunk (st) (player) (id) = if id < 1 | id > 5 then (-1) else if bs-sunk st player id then 1 else 0
  bs-wasm-ship : BsState, Integer, Integer, Integer -> Integer
  bs-wasm-ship (st) (player) (row) (col) =
    if player == 1 then bs-cell (st.p1-ships) row col
    else bs-cell (st.p2-ships) row col

  bs-wasm-track : BsState, Integer, Integer, Integer -> Integer
  bs-wasm-track (st) (player) (row) (col) =
    if player == 1 then bs-cell (st.p1-tracking) row col
    else bs-cell (st.p2-tracking) row col

  bs-wasm-hits : BsState, Integer -> Integer
  bs-wasm-hits (st) (player) =
    if player == 1 then st.p1-hits else st.p2-hits

  bs-wasm-shots : BsState, Integer -> Integer
  bs-wasm-shots (st) (player) =
    if player == 1 then st.p1-shots else st.p2-shots

  bs-wasm-done : BsState -> Integer
  bs-wasm-done (st) = if st.game-over then 1 else 0

  bs-wasm-winner : BsState -> Integer
  bs-wasm-winner (st) = st.winner

