 Entry point: runs all 20 games and prints results.

 We say:

Section: Entry Point

  opening : [Console] Nothing
  opening =
    let ttt = run-ttt-game
    in let connect4 = run-connect4-game
    in let checkers = run-checkers-game 99 4
    in let go-result = run-go-game
    in let mancala = run-mancala-game 42 4
    in let backgammon = run-backgammon-game 21
    in let set-count = run-set-game 137
    in let poker = run-poker-session 7 10
    in let stud7 = run-poker-variant SevenCardStud 123 4
    in let pinochle = run-pinochle-hand 55
    in let bridge = run-bridge-hand 77
    in let eights = run-crazy-eights 99 3
    in let gofish = run-go-fish 42 3
    in let mahjong = run-mahjong-game 101
    in let spider = run-spider-game 42
    in let monopoly = run-monopoly-game 77 4
    in let risk = run-risk-game 33 3
    in let stalingrad = run-hexwar-game scenario-stalingrad 42
    in let normandy = run-hexwar-game scenario-normandy 99
    in let bulge = run-hexwar-game scenario-bulge 77
    in act
      print-line "=== Codex Games Suite ==="
      print-line "========================="
      print-line ""
      print-line (format-ttt-result ttt)
      print-line (format-connect4-result connect4)
      print-line (format-checker-result checkers)
      print-line (format-go-result go-result)
      print-line ("Mancala: " & (if mancala.winner == 0 then "South" else if mancala.winner == 1 then "North" else "Draw") & " wins " & show (mancala.south-score) & "-" & show (mancala.north-score))
      print-line (format-backgammon-result backgammon)
      print-line (format-set-result set-count 12)
      print-line (format-poker-result poker)
      print-line (format-poker-variant stud7)
      print-line (format-pinochle-result pinochle)
      print-line (format-bridge-result bridge)
      print-line (format-crazy-eights eights)
      print-line (format-go-fish gofish 3)
      print-line (format-mahjong-result mahjong)
      print-line (format-spider-result spider)
      print-line (format-monopoly-result monopoly)
      print-line (format-risk-result risk)
      print-line ""
      print-line "--- HEX WARGAMES ---"
      print-line (format-hexwar-result stalingrad)
      print-line (format-hexwar-result normandy)
      print-line (format-hexwar-result bulge)
      print-line ""
      print-line "20 games complete."
    end

