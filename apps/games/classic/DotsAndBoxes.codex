Chapter: DotsAndBoxes
  cites Games chapter Rng

 Dots and Boxes on a 4x4 grid of dots (giving a 3x3 grid of boxes).
 Horizontal edges are the 4 rows of 3, at indices 0..11 with stride 3.
 Vertical edges are the 3 rows of 4, at indices 12..23 with stride 4.

 We say:

Section: Types

  DotsBoard = record {
    edges          : List Integer,
    boxes          : List Integer,
    current-player : Integer,
    p1-score       : Integer,
    p2-score       : Integer,
    moves-made     : Integer,
    rng            : Rng
  }

  DotsResult = record {
    winner     : Integer,
    p1-score   : Integer,
    p2-score   : Integer,
    moves-made : Integer
  }

Section: Construction

  dots-new : Rng -> DotsBoard
  dots-new (rng) =
    let edges = dots-fill 0 []
    in let boxes = dots-fill-nine 0 []
    in DotsBoard { edges = edges, boxes = boxes, current-player = 1, p1-score = 0, p2-score = 0, moves-made = 0, rng = rng }

  dots-fill : Integer, List Integer -> List Integer
  dots-fill (i) (acc) =
    if i >= 24 then acc
    else dots-fill (i + 1) (list-push acc 0)

  dots-fill-nine : Integer, List Integer -> List Integer
  dots-fill-nine (i) (acc) =
    if i >= 9 then acc
    else dots-fill-nine (i + 1) (list-push acc 0)

Section: Edge Layout

  dots-box-top : Integer, Integer -> Integer
  dots-box-top (row) (col) = row * 3 + col

  dots-box-bottom : Integer, Integer -> Integer
  dots-box-bottom (row) (col) = (row + 1) * 3 + col

  dots-box-left : Integer, Integer -> Integer
  dots-box-left (row) (col) = 12 + row * 4 + col

  dots-box-right : Integer, Integer -> Integer
  dots-box-right (row) (col) = 12 + row * 4 + col + 1

  dots-box-complete : List Integer, Integer, Integer -> Boolean
  dots-box-complete (edges) (row) (col) =
    let t = list-at edges (dots-box-top row col)
    in let b = list-at edges (dots-box-bottom row col)
    in let l = list-at edges (dots-box-left row col)
    in let r = list-at edges (dots-box-right row col)
    in t == 1 & b == 1 & l == 1 & r == 1

Section: Scoring

  dots-check-boxes : List Integer, List Integer, Integer, Integer, Integer -> Integer
  dots-check-boxes (edges) (boxes) (player) (i) (scored) =
    if i >= 9 then scored
    else let row = i / 3
    in let col = i - row * 3
    in if list-at boxes i /= 0 then dots-check-boxes edges boxes player (i + 1) scored
    else if dots-box-complete edges row col then dots-check-boxes edges boxes player (i + 1) (scored + 1)
    else dots-check-boxes edges boxes player (i + 1) scored

  dots-mark-boxes : List Integer, List Integer, Integer, Integer -> List Integer
  dots-mark-boxes (edges) (boxes) (player) (i) =
    if i >= 9 then boxes
    else let row = i / 3
    in let col = i - row * 3
    in if list-at boxes i /= 0 then dots-mark-boxes edges boxes player (i + 1)
    else if dots-box-complete edges row col then
      let new-boxes = list-set-at boxes i player
      in dots-mark-boxes edges new-boxes player (i + 1)
    else dots-mark-boxes edges boxes player (i + 1)

Section: Place Edge

  dots-place : DotsBoard, Integer -> DotsBoard
  dots-place (b) (edge-idx) =
    if edge-idx < 0 then b
    else if edge-idx >= 24 then b
    else if list-at (b.edges) edge-idx /= 0 then b
    else let new-edges = list-set-at (b.edges) edge-idx 1
    in let scored = dots-check-boxes new-edges (b.boxes) (b.current-player) 0 0
    in let new-boxes = dots-mark-boxes new-edges (b.boxes) (b.current-player) 0
    in let p1 = if b.current-player == 1 then b.p1-score + scored else b.p1-score
    in let p2 = if b.current-player == 2 then b.p2-score + scored else b.p2-score
    in let next = if scored > 0 then b.current-player else if b.current-player == 1 then 2 else 1
    in DotsBoard { edges = new-edges, boxes = new-boxes, current-player = next, p1-score = p1, p2-score = p2, moves-made = b.moves-made + 1, rng = b.rng }

Section: AI

  dots-ai-move : DotsBoard -> Integer
  dots-ai-move (b) =
    let box-move = dots-find-completing-move (b.edges) 0
    in if box-move >= 0 then box-move
    else dots-random-edge (b.edges) (b.rng)

  dots-find-completing-move : List Integer, Integer -> Integer
  dots-find-completing-move (edges) (edge-idx) =
    if edge-idx >= 24 then -1
    else if list-at edges edge-idx /= 0 then dots-find-completing-move edges (edge-idx + 1)
    else let trial = list-set-at edges edge-idx 1
    in let completes = dots-completes-any trial 0
    in let restored = list-set-at trial edge-idx 0
    in if completes then edge-idx
    else dots-find-completing-move restored (edge-idx + 1)

  dots-completes-any : List Integer, Integer -> Boolean
  dots-completes-any (edges) (i) =
    if i >= 9 then False
    else let row = i / 3
    in let col = i - row * 3
    in if dots-box-complete edges row col then True
    else dots-completes-any edges (i + 1)

  dots-random-edge : List Integer, Rng -> Integer
  dots-random-edge (edges) (rng) =
    dots-random-loop edges rng 0

  dots-random-loop : List Integer, Rng, Integer -> Integer
  dots-random-loop (edges) (rng) (attempts) =
    if attempts >= 200 then dots-first-free edges 0
    else let r = rng-next rng
    in let idx = rng-range r 0 23
    in if list-at edges idx == 0 then idx
    else dots-random-loop edges r (attempts + 1)

  dots-first-free : List Integer, Integer -> Integer
  dots-first-free (edges) (i) =
    if i >= 24 then -1
    else if list-at edges i == 0 then i
    else dots-first-free edges (i + 1)

  dots-all-placed : List Integer -> Boolean
  dots-all-placed (edges) = dots-check-all edges 0

  dots-check-all : List Integer, Integer -> Boolean
  dots-check-all (edges) (i) =
    if i >= 24 then True
    else if list-at edges i == 0 then False
    else dots-check-all edges (i + 1)

Section: Game Runner

  run-dots-game : DotsResult
  run-dots-game =
    let rng = rng-new 77
    in let b = dots-new rng
    in dots-loop b

  dots-loop : DotsBoard -> DotsResult
  dots-loop (b) =
    if dots-all-placed (b.edges) then
      let w = if b.p1-score > b.p2-score then 1 else if b.p2-score > b.p1-score then 2 else 0
      in DotsResult { winner = w, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else if b.moves-made > 30 then DotsResult { winner = 0, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else let edge = dots-ai-move b
    in if edge < 0 then DotsResult { winner = 0, p1-score = b.p1-score, p2-score = b.p2-score, moves-made = b.moves-made }
    else let next = dots-place b edge
    in dots-loop next

Section: Formatting

  format-dots-result : DotsResult -> Text
  format-dots-result (r) =
    let w = if r.winner == 1 then "Player 1 wins"
            else if r.winner == 2 then "Player 2 wins"
            else "Draw"
    in "DotsAndBoxes: " & w & " P1=" & show (r.p1-score) & " P2=" & show (r.p2-score) & " in " & show (r.moves-made) & " moves"

