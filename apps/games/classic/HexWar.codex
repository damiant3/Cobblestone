  scenario-panzerblitz : WargameConfig
  scenario-panzerblitz =
    let w = 16
    in let h = 12
    in let td0 = flat-terrain w h
    in let td1 = set-terrain-at td0 w 2 2 1 0 False False
    in let td2 = set-terrain-at td1 w 3 3 1 0 False False
    in let td3 = set-terrain-at td2 w 4 2 1 0 False False
    in let td4 = set-terrain-at td3 w 5 4 2 1 False False
    in let td5 = set-terrain-at td4 w 6 3 2 1 False False
    in let td6 = set-terrain-at td5 w 7 5 1 0 False False
    in let td7 = set-terrain-at td6 w 8 4 6 1 True True
    in let td8 = set-terrain-at td7 w 10 6 6 1 True True
    in let td9 = set-terrain-at td8 w 12 3 2 1 False False
