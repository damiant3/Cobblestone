Section: AI

  ai-find-target : List Unit, Integer, List TerrainHex, Integer -> Integer
  ai-find-target (units) (owner) (terrain-data) (width) =
    ai-target-loop units owner terrain-data width 0 (-1) 999

  ai-target-loop : List Unit, Integer, List TerrainHex, Integer, Integer, Integer, Integer -> Integer
  ai-target-loop (units) (owner) (td) (width) (i) (best) (best-str) =
    if i >= list-length units then best
    else let u = list-at units i
    in if u.owner == owner then ai-target-loop units owner td width (i + 1) best best-str
    else if u.eliminated then ai-target-loop units owner td width (i + 1) best best-str
    else let adj = ai-any-adjacent-friendly units owner u.q u.r
    in if adj == False then ai-target-loop units owner td width (i + 1) best best-str
    else if u.strength < best-str then ai-target-loop units owner td width (i + 1) i u.strength
    else ai-target-loop units owner td width (i + 1) best best-str

  ai-any-adjacent-friendly : List Unit, Integer, Integer, Integer -> Boolean
  ai-any-adjacent-friendly (units) (owner) (eq) (er) =
    ai-adj-loop units owner eq er 0

  ai-adj-loop : List Unit, Integer, Integer, Integer, Integer -> Boolean
  ai-adj-loop (units) (owner) (eq) (er) (i) =
    if i >= list-length units then False
    else let u = list-at units i
    in if u.owner /= owner then ai-adj-loop units owner eq er (i + 1)
    else if u.eliminated then ai-adj-loop units owner eq er (i + 1)
    else let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = eq, r = er })
    in if dist <= 1 then True
    else ai-adj-loop units owner eq er (i + 1)

  ai-find-advance-target : List TerrainHex, Integer, Integer -> Integer
  ai-find-advance-target (terrain-data) (width) (height) =
    ai-advance-loop terrain-data width height 0 (-1)

  ai-advance-loop : List TerrainHex, Integer, Integer, Integer, Integer -> Integer
  ai-advance-loop (td) (width) (height) (i) (best) =
    if i >= list-length td then best
    else let th = list-at td i
    in if th.victory-point == False then ai-advance-loop td width height (i + 1) best
    else ai-advance-loop td width height (i + 1) i

  ai-count-vp : List TerrainHex, List Unit, Integer -> Integer
  ai-count-vp (terrain-data) (units) (owner) =
    ai-vp-loop terrain-data units owner 0 0

  ai-vp-loop : List TerrainHex, List Unit, Integer, Integer, Integer -> Integer
  ai-vp-loop (td) (units) (owner) (i) (acc) =
    if i >= list-length td then acc
    else let th = list-at td i
    in if th.victory-point == False then ai-vp-loop td units owner (i + 1) acc
    else let held = ai-hex-held-by units owner i
    in let delta = if held then 1 else 0
    in ai-vp-loop td units owner (i + 1) (acc + delta)

  ai-hex-held-by : List Unit, Integer, Integer -> Boolean
  ai-hex-held-by (units) (owner) (idx) =
    ai-hex-held-loop units owner idx 0

  ai-hex-held-loop : List Unit, Integer, Integer, Integer -> Boolean
  ai-hex-held-loop (units) (owner) (idx) (i) =
    if i >= list-length units then False
    else let u = list-at units i
    in if u.eliminated then ai-hex-held-loop units owner idx (i + 1)
    else if u.owner /= owner then ai-hex-held-loop units owner idx (i + 1)
    else let uid = u.r * 1000 + u.q
    in if uid == idx then True
    else ai-hex-held-loop units owner idx (i + 1)

Section: Game Runner

  HexwarResult = record {
    winner      : Integer,
    turns       : Integer,
    units-lost-a : Integer,
    units-lost-b : Integer,
    vp-a        : Integer,
    vp-b        : Integer
  }

  count-eliminated : List Unit, Integer -> Integer
  count-eliminated (units) (owner) =
    count-elim-loop units owner 0 0

  count-elim-loop : List Unit, Integer, Integer, Integer -> Integer
  count-elim-loop (units) (owner) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let delta = if u.owner == owner & u.eliminated then 1 else 0
    in count-elim-loop units owner (i + 1) (acc + delta)

  count-alive : List Unit, Integer -> Integer
  count-alive (units) (owner) =
    count-alive-loop units owner 0 0

  count-alive-loop : List Unit, Integer, Integer, Integer -> Integer
  count-alive-loop (units) (owner) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in let delta = if u.owner == owner & u.eliminated == False then 1 else 0
    in count-alive-loop units owner (i + 1) (acc + delta)

  determine-winner : List Unit, List TerrainHex, Integer, Integer -> Integer
  determine-winner (units) (terrain-data) (turn) (turn-limit) =
    let alive-a = count-alive units 0
    in let alive-b = count-alive units 1
    in if alive-a == 0 then 1
    else if alive-b == 0 then 0
    else let vp-a = ai-count-vp terrain-data units 0
    in let vp-b = ai-count-vp terrain-data units 1
    in if vp-a > vp-b then 0
    else if vp-b > vp-a then 1
    else (-1)

  run-hexwar-turn : List Unit, List TerrainHex, Integer, Integer, Rng -> List Unit
  run-hexwar-turn (units) (terrain-data) (active-player) (width) (r) =
    let units2 = reset-units-for-turn units
    in let r2 = rng-next r
    in let target = ai-find-target units2 active-player terrain-data width
    in if target < 0 then units2
    else let tu = list-at units2 target
    in let def-str = tu.strength
    in let def-hex = list-at terrain-data (tu.r * width + tu.q)
    in let def-bonus = get-defense-bonus def-hex.terrain
    in let atk-str = ai-count-attack-strength units2 active-player tu.q tu.r
    in let arty = artillery-support units2 tu.q tu.r active-player
    in let total-atk = atk-str + arty
    in let die = rng-range r2 1 6
    in let result = combat-result total-atk def-str def-bonus die
    in apply-combat-result units2 target result active-player r2

  ai-count-attack-strength : List Unit, Integer, Integer, Integer -> Integer
  ai-count-attack-strength (units) (owner) (tq) (tr) =
    ai-atk-str-loop units owner tq tr 0 0

  ai-atk-str-loop : List Unit, Integer, Integer, Integer, Integer, Integer -> Integer
  ai-atk-str-loop (units) (owner) (tq) (tr) (i) (acc) =
    if i >= list-length units then acc
    else let u = list-at units i
    in if u.owner /= owner then ai-atk-str-loop units owner tq tr (i + 1) acc
    else if u.eliminated then ai-atk-str-loop units owner tq tr (i + 1) acc
    else let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = tq, r = tr })
    in let adj = if dist <= 1 & u.type-id /= 2 then u.attack else 0
    in ai-atk-str-loop units owner tq tr (i + 1) (acc + adj)

  apply-combat-result : List Unit, Integer, Integer, Integer, Rng -> List Unit
  apply-combat-result (units) (def-idx) (result) (atk-owner) (r) =
    if result == 0 then eliminate-attackers units atk-owner def-idx
    else if result == 1 then retreat-attackers units atk-owner def-idx r
    else if result == 2 then
      let u2 = eliminate-one units def-idx
      in eliminate-attackers u2 atk-owner def-idx
    else if result == 3 then retreat-defender units def-idx r
    else eliminate-defender units def-idx

  eliminate-defender : List Unit, Integer -> List Unit
  eliminate-defender (units) (def-idx) =
    let u = list-at units def-idx
    in let u2 = __record-set u "eliminated" True
    in list-set-at units def-idx u2

  eliminate-one : List Unit, Integer -> List Unit
  eliminate-one (units) (def-idx) =
    eliminate-defender units def-idx

  eliminate-attackers : List Unit, Integer, Integer -> List Unit
  eliminate-attackers (units) (owner) (def-idx) =
    elim-atk-loop units owner def-idx 0

  elim-atk-loop : List Unit, Integer, Integer, Integer -> List Unit
  elim-atk-loop (units) (owner) (def-idx) (i) =
    if i >= list-length units then units
    else let u = list-at units i
    in if u.owner /= owner then elim-atk-loop units owner def-idx (i + 1)
    else if u.eliminated then elim-atk-loop units owner def-idx (i + 1)
    else let du = list-at units def-idx
    in let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = du.q, r = du.r })
    in if dist > 1 then elim-atk-loop units owner def-idx (i + 1)
    else let u2 = __record-set u "eliminated" True
    in elim-atk-loop (list-set-at units i u2) owner def-idx (i + 1)

  retreat-defender : List Unit, Integer, Rng -> List Unit
  retreat-defender (units) (def-idx) (r) =
    let u = list-at units def-idx
    in let dir = rng-mod (rng-value r) 6
    in let nq = hex-neighbor-q dir u.q
    in let nr = hex-neighbor-r dir u.r
    in let u2 = __record-set (__record-set u "q" nq) "r" nr
    in list-set-at units def-idx u2

  retreat-attackers : List Unit, Integer, Integer, Rng -> List Unit
  retreat-attackers (units) (owner) (def-idx) (r) =
    retreat-atk-loop units owner def-idx r 0

  retreat-atk-loop : List Unit, Integer, Integer, Rng, Integer -> List Unit
  retreat-atk-loop (units) (owner) (def-idx) (r) (i) =
    if i >= list-length units then units
    else let u = list-at units i
    in if u.owner /= owner then retreat-atk-loop units owner def-idx r (i + 1)
    else if u.eliminated then retreat-atk-loop units owner def-idx r (i + 1)
    else let du = list-at units def-idx
    in let dist = hex-distance (HexCoord { q = u.q, r = u.r }) (HexCoord { q = du.q, r = du.r })
    in if dist > 1 then retreat-atk-loop units owner def-idx r (i + 1)
    else let dir = rng-mod (rng-value r) 6
    in let opp = rng-mod (dir + 3) 6
    in let nq = hex-neighbor-q opp u.q
    in let nr = hex-neighbor-r opp u.r
    in let u2 = __record-set (__record-set u "q" nq) "r" nr
    in retreat-atk-loop (list-set-at units i u2) owner def-idx r (i + 1)

  run-hexwar-game : WargameConfig, Integer -> HexwarResult
  run-hexwar-game (cfg) (seed) =
    hexwar-loop cfg (rng-new seed) cfg.unit-roster 0 0

  hexwar-loop : WargameConfig, Rng, List Unit, Integer, Integer -> HexwarResult
  hexwar-loop (cfg) (r) (units) (turn) (active-player) =
    if turn >= cfg.turn-limit then hexwar-finish cfg units turn
    else if count-alive units 0 == 0 then hexwar-finish cfg units turn
    else if count-alive units 1 == 0 then hexwar-finish cfg units turn
    else let r2 = rng-next r
    in let units2 = run-hexwar-turn units cfg.terrain-data active-player cfg.map-width r2
    in let next-player = rng-mod (active-player + 1) cfg.num-players
    in let next-turn = if next-player == 0 then turn + 1 else turn
    in hexwar-loop cfg r2 units2 next-turn next-player

  hexwar-finish : WargameConfig, List Unit, Integer -> HexwarResult
  hexwar-finish (cfg) (units) (turn) =
    let winner = determine-winner units cfg.terrain-data turn cfg.turn-limit
    in let la = count-eliminated units 0
    in let lb = count-eliminated units 1
    in let va = ai-count-vp cfg.terrain-data units 0
    in let vb = ai-count-vp cfg.terrain-data units 1
    in HexwarResult {
         winner = winner,
         turns = turn,
         units-lost-a = la,
         units-lost-b = lb,
         vp-a = va,
         vp-b = vb
       }

Section: Formatting

  format-hexwar-result : HexwarResult -> Text
  format-hexwar-result (res) =
    let w = if res.winner == 0 then "Player A"
            else if res.winner == 1 then "Player B"
            else "Draw"
    in "HexWar: winner=" & w
       & " turns=" & show res.turns
       & " A-lost=" & show res.units-lost-a
       & " B-lost=" & show res.units-lost-b
       & " VP A=" & show res.vp-a
       & " VP B=" & show res.vp-b

