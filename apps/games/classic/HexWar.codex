  scenario-gettysburg : WargameConfig
  scenario-gettysburg =
    let w = 20
    in let h = 16
    in let td0 = flat-terrain w h
    in let td1 = set-terrain-at td0 w 12 8 2 2 False True
    in let td2 = set-terrain-at td1 w 13 9 2 2 False True
    in let td3 = set-terrain-at td2 w 14 10 2 2 False False
    in let td4 = set-terrain-at td3 w 11 12 2 2 False True
    in let td5 = set-terrain-at td4 w 12 13 2 2 False False
    in let td6 = set-terrain-at td5 w 10 7 5 0 False False
    in let td7 = set-terrain-at td6 w 10 8 5 0 False False
    in let td8 = set-terrain-at td7 w 10 9 5 0 False False
    in let td9 = set-terrain-at td8 w 10 5 6 1 False True
    in let td10 = set-terrain-at td9 w 8 8 1 0 False False
    in let td11 = set-terrain-at td10 w 9 9 1 0 False False
    in let un1 = make-unit 0 0 0 12 7
    in let un2 = make-unit 1 0 0 13 8
    in let un3 = make-unit 2 0 0 12 9
    in let un4 = make-unit 3 0 0 11 11
    in let un5 = make-unit 4 2 0 13 7
    in let un6 = make-unit 5 2 0 12 11
    in let un7 = make-unit 6 5 0 14 8
    in let co1 = make-unit 7 0 1 1 8
    in let co2 = make-unit 8 0 1 2 8
    in let co3 = make-unit 9 0 1 1 9
    in let co4 = make-unit 10 0 1 2 9
    in let co5 = make-unit 11 0 1 1 7
