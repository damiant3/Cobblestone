Chapter: PokerVariants
  cites Games chapter Rng
  cites Games chapter Poker

 Variants:
   FiveCardDraw   -- deal 5, draw up to 3 (4 if holding ace), showdown
   FiveCardStud   -- 1 down + 4 up, betting each street
   SevenCardStud  -- 2 down + 4 up + 1 down, best 5 of 7
   Baseball       -- 3s and 9s wild, 4 dealt face-up gets extra card
   HiChicago      -- highest spade in hole wins half pot
   LowChicago     -- lowest spade in hole wins half pot
   FollowTheQueen -- card after each queen dealt face-up is wild
   JacksOrBetter  -- need a pair of jacks or better to open; no minimum to win

 We say:

Section: Variant Type

  PokerVariant =
   | FiveCardDraw
   | FiveCardStud
   | SevenCardStud
   | Baseball
   | HiChicago
   | LowChicago
   | FollowTheQueen
   | JacksOrBetter

Section: Session Types

  PokerSession = record {
    variant        : PokerVariant,
    seed           : Integer,
    num-players    : Integer,
    winner         : Integer,
    p1-hand-rank   : Integer,
    p2-hand-rank   : Integer,
    hands-played   : Integer,
    special-winner : Integer
  }

  PvHand = record {
    cards    : List Integer,
    size     : Integer,
    folded   : Boolean,
    player   : Integer
  }

Section: Deck Utilities

  pv-build-deck : Integer, List Integer -> List Integer
  pv-build-deck (i) (acc) =
    if i >= 52 then acc
    else pv-build-deck (i + 1) (list-push acc i)

  pv-shuffle : List Integer, Rng -> List Integer
  pv-shuffle (deck) (r) = pv-fy deck 51 r

  pv-fy : List Integer, Integer, Rng -> List Integer
  pv-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in pv-fy d3 (i - 1) r2

Section: Hand Building Helpers

  pv-empty-hand : Integer -> PvHand
  pv-empty-hand (player) =
    PvHand { cards = [], size = 0, folded = False, player = player }

  pv-add-card : PvHand, Integer -> PvHand
  pv-add-card (h) (card) =
    PvHand { cards = list-push (h.cards) card, size = h.size + 1, folded = h.folded, player = h.player }

  pv-take-5-from : List Integer, Integer, Integer -> PokerHand
  pv-take-5-from (deck) (start) (stride) =
    let c0 = list-at deck start
    in let c1 = list-at deck (start + stride)
    in let c2 = list-at deck (start + stride * 2)
    in let c3 = list-at deck (start + stride * 3)
    in let c4 = list-at deck (start + stride * 4)
    in let cards = list-push (list-push (list-push (list-push (list-push [] c0) c1) c2) c3) c4
    in PokerHand { cards = cards }

  pv-hand-from-pvhand : PvHand -> PokerHand
  pv-hand-from-pvhand (h) =
    let cards = pv-first-5 (h.cards) 0 []
    in PokerHand { cards = cards }

  pv-first-5 : List Integer, Integer, List Integer -> List Integer
  pv-first-5 (cards) (i) (acc) =
    if i >= 5 then acc
    else if i >= list-length cards then list-push acc 0
    else pv-first-5 cards (i + 1) (list-push acc (list-at cards i))

Section: Best 5 of 7 (SevenCardStud, Baseball)

  pv-best-5-of-7 : List Integer -> PokerHand
  pv-best-5-of-7 (cards) =
    pv-best-combo cards 0 1 2 3 4 (HandRank { rank = (-1), primary = 0, secondary = 0, kickers = 0 }) []

  pv-best-combo : List Integer, Integer, Integer, Integer, Integer, Integer, HandRank, List Integer -> PokerHand
  pv-best-combo (cards) (a) (b) (c) (d) (e) (best-rank) (best-cards) =
    if a >= 3 then PokerHand { cards = best-cards }
    else
      let trial = pv-pick-5 cards a b c d e
      in let hr = evaluate-hand (PokerHand { cards = trial })
      in let better = compare-hands hr best-rank == 1
      in let new-best-rank = if better then hr else best-rank
      in let new-best-cards = if better then trial else best-cards
      in let next = pv-next-combo a b c d e
      in pv-best-combo cards (list-at next 0) (list-at next 1) (list-at next 2) (list-at next 3) (list-at next 4) new-best-rank new-best-cards

  pv-pick-5 : List Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pv-pick-5 (cards) (a) (b) (c) (d) (e) =
    let h0 = list-push [] (list-at cards a)
    in let h1 = list-push h0 (list-at cards b)
    in let h2 = list-push h1 (list-at cards c)
    in let h3 = list-push h2 (list-at cards d)
    in list-push h3 (list-at cards e)

  pv-next-combo : Integer, Integer, Integer, Integer, Integer -> List Integer
  pv-next-combo (a) (b) (c) (d) (e) =
    if e < 6 then [a, b, c, d, e + 1]
    else if d < 5 then [a, b, c, d + 1, d + 2]
    else if c < 4 then [a, b, c + 1, c + 2, c + 3]
    else if b < 3 then [a, b + 1, b + 2, b + 3, b + 4]
    else [a + 1, a + 2, a + 3, a + 4, a + 5]

Section: Wild Card Substitution

  pv-count-wilds-in-hand : List Integer, List Boolean -> Integer
  pv-count-wilds-in-hand (cards) (wilds) =
    pv-wild-count-loop cards wilds 0 0

  pv-wild-count-loop : List Integer, List Boolean, Integer, Integer -> Integer
  pv-wild-count-loop (cards) (wilds) (i) (acc) =
    if i >= list-length cards then acc
    else let card = list-at cards i
    in let is-wild = if card < list-length wilds then list-at wilds card else False
    in let delta = if is-wild then 1 else 0
    in pv-wild-count-loop cards wilds (i + 1) (acc + delta)

  pv-build-rank-wilds : List Integer -> List Boolean
  pv-build-rank-wilds (wild-ranks) =
    pv-build-wild-table wild-ranks 0 (pv-build-false-list 52)

  pv-build-false-list : Integer -> List Boolean
  pv-build-false-list (n) =
    pv-false-loop n 0 []

  pv-false-loop : Integer, Integer, List Boolean -> List Boolean
  pv-false-loop (n) (i) (acc) =
    if i >= n then acc
    else pv-false-loop n (i + 1) (list-push acc False)

  pv-build-wild-table : List Integer, Integer, List Boolean -> List Boolean
  pv-build-wild-table (wild-ranks) (i) (table) =
    if i >= list-length wild-ranks then table
    else let rank = list-at wild-ranks i
    in let t2 = pv-mark-rank-wild table rank 0
    in pv-build-wild-table wild-ranks (i + 1) t2

  pv-mark-rank-wild : List Boolean, Integer, Integer -> List Boolean
  pv-mark-rank-wild (table) (rank) (suit) =
    if suit >= 4 then table
    else let card-idx = suit * 13 + rank
    in let t2 = list-set-at table card-idx True
    in pv-mark-rank-wild t2 rank (suit + 1)

  pv-naturals : List Integer, List Boolean, Integer, List Integer -> List Integer
  pv-naturals (cards) (wilds) (i) (acc) =
    if i >= list-length cards then acc
    else let c = list-at cards i
    in let w = if c < list-length wilds then list-at wilds c else False
    in pv-naturals cards wilds (i + 1) (if w then acc else list-push acc c)

  pv-rank-in : List Integer, Integer, Integer, Integer -> Integer
  pv-rank-in (cards) (r) (i) (acc) =
    if i >= list-length cards then acc
    else pv-rank-in cards r (i + 1) (if card-rank (list-at cards i) == r then acc + 1 else acc)

  pv-fill : List Integer, Integer, Integer -> List Integer
  pv-fill (acc) (card) (n) =
    if n <= 0 then acc
    else pv-fill (list-push acc card) card (n - 1)

  pv-copy : List Integer, Integer, List Integer -> List Integer
  pv-copy (src) (i) (acc) =
    if i >= list-length src then acc
    else pv-copy src (i + 1) (list-push acc (list-at src i))

  pv-better : HandRank, HandRank -> HandRank
  pv-better (a) (b) = if compare-hands b a == 1 then b else a

 pagat's hand ranking: with wild cards five of a kind is the highest hand,
 above a royal flush, the higher rank beating the lower.

  pv-wild-on-rank : List Integer, Integer, Integer -> HandRank
  pv-wild-on-rank (nat) (k) (r) =
    if pv-rank-in nat r 0 0 + k >= 5 then HandRank { rank = 9, primary = r, secondary = 0, kickers = 0 }
    else pv-wild-rank-fill nat k r

  pv-wild-rank-fill : List Integer, Integer, Integer -> HandRank
  pv-wild-rank-fill (nat) (k) (r) =
    let c = pv-rank-in nat r 0 0
    in let room = 4 - c
    in let put = if room < k then room else k
    in let kick = if r == 12 then 11 else 12
    in let h0 = pv-fill (pv-copy nat 0 []) r put
    in evaluate-hand (PokerHand { cards = pv-fill h0 (13 + kick) (k - put) })

  pv-all-ranks : List Integer, Integer, Integer, HandRank -> HandRank
  pv-all-ranks (nat) (k) (r) (best) =
    if r >= 13 then best
    else pv-all-ranks nat k (r + 1) (pv-better best (pv-wild-on-rank nat k r))

  pv-same-suit : List Integer, Integer -> Boolean
  pv-same-suit (nat) (i) =
    if i >= list-length nat then True
    else if card-suit (list-at nat i) /= card-suit (list-at nat 0) then False
    else pv-same-suit nat (i + 1)

  pv-suit-of : List Integer -> Integer
  pv-suit-of (nat) = if list-length nat == 0 then 0 else card-suit (list-at nat 0)

  pv-window-rank : Integer, Integer -> Integer
  pv-window-rank (high) (j) =
    if high == 3 then (if j == 0 then 12 else j - 1)
    else high - 4 + j

  pv-in-window : Integer, Integer, Integer -> Boolean
  pv-in-window (high) (r) (j) =
    if j >= 5 then False
    else if pv-window-rank high j == r then True
    else pv-in-window high r (j + 1)

  pv-fits-window : List Integer, Integer, Integer -> Boolean
  pv-fits-window (nat) (high) (i) =
    if i >= list-length nat then True
    else let r = card-rank (list-at nat i)
    in if pv-in-window high r 0 == False then False
    else if pv-rank-in nat r 0 0 > 1 then False
    else pv-fits-window nat high (i + 1)

  pv-window-fill : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  pv-window-fill (nat) (high) (suit) (j) (acc) =
    if j >= 5 then acc
    else let r = pv-window-rank high j
    in pv-window-fill nat high suit (j + 1) (if pv-rank-in nat r 0 0 > 0 then acc else list-push acc (suit * 13 + r))

  pv-straight-high : List Integer, Integer -> Integer
  pv-straight-high (nat) (high) =
    if high < 3 then 0 - 1
    else if pv-fits-window nat high 0 then high
    else pv-straight-high nat (high - 1)

  pv-straight-try : List Integer, HandRank -> HandRank
  pv-straight-try (nat) (best) =
    let high = pv-straight-high nat 12
    in if high < 0 then best
    else pv-better best (evaluate-hand (PokerHand { cards = pv-window-fill nat high (pv-suit-of nat) 0 (pv-copy nat 0 []) }))

  pv-flush-fill : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  pv-flush-fill (nat) (suit) (r) (k) (acc) =
    if k <= 0 | r < 0 then acc
    else if pv-rank-in nat r 0 0 > 0 then pv-flush-fill nat suit (r - 1) k acc
    else pv-flush-fill nat suit (r - 1) (k - 1) (list-push acc (suit * 13 + r))

  pv-flush-try : List Integer, Integer, HandRank -> HandRank
  pv-flush-try (nat) (k) (best) =
    if pv-same-suit nat 0 == False then best
    else pv-better best (evaluate-hand (PokerHand { cards = pv-flush-fill nat (pv-suit-of nat) 12 k (pv-copy nat 0 []) }))

  pv-no-hand : HandRank
  pv-no-hand = HandRank { rank = (0 - 1), primary = 0, secondary = 0, kickers = 0 }

  pv-evaluate-with-wilds : PokerHand, List Boolean -> HandRank
  pv-evaluate-with-wilds (h) (wilds) =
    let nat = pv-naturals (h.cards) wilds 0 []
    in let k = list-length (h.cards) - list-length nat
    in if k == 0 then evaluate-hand h
    else pv-flush-try nat k (pv-straight-try nat (pv-all-ranks nat k 0 pv-no-hand))

  pv-best-wild-combo : List Integer, List Boolean, Integer, Integer, Integer, Integer, Integer, HandRank -> HandRank
  pv-best-wild-combo (cards) (wilds) (a) (b) (c) (d) (e) (best) =
    if a >= 3 then best
    else let hr = pv-evaluate-with-wilds (PokerHand { cards = pv-pick-5 cards a b c d e }) wilds
    in let next = pv-next-combo a b c d e
    in pv-best-wild-combo cards wilds (list-at next 0) (list-at next 1) (list-at next 2) (list-at next 3) (list-at next 4) (pv-better best hr)

  pv-best-wild-of : List Integer, List Boolean -> HandRank
  pv-best-wild-of (cards) (wilds) =
    if list-length cards <= 5 then pv-evaluate-with-wilds (PokerHand { cards = cards }) wilds
    else pv-best-wild-combo cards wilds 0 1 2 3 4 pv-no-hand

Section: Spade Queries (Chicago variants)

 Suit 0 is spades, as the arcade draws the cards.

  pv-card-is-spade : Integer -> Boolean
  pv-card-is-spade (card) = card-suit card == 0

  pv-highest-spade-in-hole : List Integer -> Integer
  pv-highest-spade-in-hole (hole-cards) =
    pv-highest-spade-loop hole-cards 0 (-1)

  pv-highest-spade-loop : List Integer, Integer, Integer -> Integer
  pv-highest-spade-loop (cards) (i) (best) =
    if i >= list-length cards then best
    else let card = list-at cards i
    in if pv-card-is-spade card then
      let r = card-rank card
      in if r > best then pv-highest-spade-loop cards (i + 1) r
      else pv-highest-spade-loop cards (i + 1) best
    else pv-highest-spade-loop cards (i + 1) best

  pv-lowest-spade-in-hole : List Integer -> Integer
  pv-lowest-spade-in-hole (hole-cards) =
    pv-lowest-spade-loop hole-cards 0 999

  pv-lowest-spade-loop : List Integer, Integer, Integer -> Integer
  pv-lowest-spade-loop (cards) (i) (best) =
    if i >= list-length cards then if best == 999 then (-1) else best
    else let card = list-at cards i
    in if pv-card-is-spade card then
      let r = card-rank card
      in if r < best then pv-lowest-spade-loop cards (i + 1) r
      else pv-lowest-spade-loop cards (i + 1) best
    else pv-lowest-spade-loop cards (i + 1) best

Section: Follow The Queen's Wild

 pagat: a later face-up queen cancels the wild before it, and if the last
 face-up card dealt is a queen there are no wild cards. So the wild rank is
 the card after the LAST queen among the first `deal-count`, or none.

  pv-find-follow-queen : List Integer, Integer -> Integer
  pv-find-follow-queen (deck) (deal-count) =
    let q = pv-last-queen deck deal-count 0 (-1)
    in if q < 0 then (-1)
    else if q + 1 >= deal-count then (-1)
    else card-rank (list-at deck (q + 1))

  pv-last-queen : List Integer, Integer, Integer, Integer -> Integer
  pv-last-queen (deck) (deal-count) (i) (found) =
    if i >= deal-count then found
    else pv-last-queen deck deal-count (i + 1) (if card-rank (list-at deck i) == 10 then i else found)

Section: Jacks Or Better

 A pair of jacks (rank 9) or better is needed to open.

  pv-can-open : PokerHand -> Boolean
  pv-can-open (h) =
    let rank1 = evaluate-hand h
    in if rank1.rank > 1 then True
    else if rank1.rank == 1 then rank1.primary >= 9
    else False

Section: A Table You Can Sit At, Per Variant

 A variant arrives as an integer in the order `pvw-variant` maps: 0 draw,
 1 five stud, 2 seven stud, 3 baseball, 4 hi chicago, 5 low chicago,
 6 follow the queen, 7 jacks or better.

  PvTable = record {
    table   : PokerTable,
    variant : Integer,
    wilds   : List Boolean,
    spade   : Integer,
    street  : Integer,
    bet-unit    : Integer,
    bets    : Integer,
    bring   : Integer,
    up0     : Integer,
    up1     : Integer
  }

  pvt-cards-per-hand : Integer -> Integer
  pvt-cards-per-hand (v) =
    if v == 0 then 5
    else if v == 1 then 5
    else if v == 7 then 5
    else 7

  pvt-has-wilds : Integer -> Boolean
  pvt-has-wilds (v) = v == 3 | v == 6

  pvt-is-draw : Integer -> Boolean
  pvt-is-draw (v) = v == 0 | v == 7

  pvt-is-stud : Integer -> Boolean
  pvt-is-stud (v) = v >= 1 & v <= 6

 The studs, by pagat.com (https://www.pagat.com/poker/variants/7stud.html
 and 5stud.html). Seven card stud deals two down and one up, then one up on
 each of fourth to sixth street and one down on seventh; five card stud
 deals one down and one up, then three more up. A betting round follows
 every street. The lowest up card brings in on the first round (clubs,
 diamonds, hearts, spades from low to high breaking a tie) for less than a
 small bet and more than the ante, and may complete to a small bet instead;
 every later round is begun by the best hand showing. Fixed limit: small
 bets on the first two rounds and big bets after, except that on the second
 round a pair or better showing allows a big bet or raise. At most one bet
 and three raises a round.

  pvt-first-deal : Integer -> Integer
  pvt-first-deal (v) =
    if v == 1 then 2
    else if pvt-is-stud v then 3
    else pvt-cards-per-hand v

  pvt-last-street : Integer -> Integer
  pvt-last-street (v) = pvt-cards-per-hand v - pvt-first-deal v


  pvt-stud-ante : Integer
  pvt-stud-ante = 2

  pvt-bring-in : Integer
  pvt-bring-in = 5

  pvt-big-bet : Integer
  pvt-big-bet = 2 * pk-bet-size

  pvt-ante : Integer -> Integer
  pvt-ante (v) = if pvt-is-stud v then pvt-stud-ante else pk-ante

  pvt-street-unit : Integer -> Integer
  pvt-street-unit (street) = if street >= 2 then pvt-big-bet else pk-bet-size

Section: What The Board Shows

 A card's worth for the bring-in and for a tie between boards: rank first,
 then suit.

  pvt-card-value : Integer -> Integer
  pvt-card-value (c) = card-rank c * 4 + card-suit c

 Which of a seat's cards are face up is a bit set over its hand, because
 Baseball's extra card moves every later card along.

  pvt-up-at : Integer, Integer -> Boolean
  pvt-up-at (mask) (i) = pk-bit mask i == 1

  pvt-mask-of : PvTable, Integer -> Integer
  pvt-mask-of (p) (who) = if who == 0 then p.up0 else p.up1

  pvt-up-cards : List Integer, Integer, Integer, List Integer -> List Integer
  pvt-up-cards (cards) (mask) (i) (acc) =
    if i >= list-length cards then acc
    else pvt-up-cards cards mask (i + 1) (if pvt-up-at mask i then list-push acc (list-at cards i) else acc)

  pvt-max-count : List Integer, Integer, Integer -> Integer
  pvt-max-count (cards) (r) (best) =
    if r >= 13 then best
    else let n = pv-rank-in cards r 0 0
    in pvt-max-count cards (r + 1) (if n > best then n else best)

  pvt-pair-count : List Integer, Integer, Integer -> Integer
  pvt-pair-count (cards) (r) (acc) =
    if r >= 13 then acc
    else pvt-pair-count cards (r + 1) (if pv-rank-in cards r 0 0 == 2 then acc + 1 else acc)

 A board ranks on the hand-rank scale. Under five cards it makes no
 straight or flush and ranks by its groups alone; five or more (Baseball's
 extras) rank as their best five-card hand, wild cards counting as what they
 are. Ties go by the ranks, most numerous first, padded to five with the
 lowest, then by the best card's worth.

  pvt-show-cat : List Integer -> Integer
  pvt-show-cat (cards) =
    let m = pvt-max-count cards 0 0
    in if m >= 4 then 7
    else if m == 3 then 3
    else if pvt-pair-count cards 0 0 >= 2 then 2
    else if m == 2 then 1
    else 0

  pvt-plain-best : List Integer, Integer, List Integer, HandRank -> HandRank
  pvt-plain-best (cards) (i) (chosen) (best) =
    if list-length chosen == 5 then pv-better best (evaluate-hand (PokerHand { cards = chosen }))
    else if list-length cards - i < 5 - list-length chosen then best
    else let taken = pvt-plain-best cards (i + 1) (list-push (pv-copy chosen 0 []) (list-at cards i)) best
    in pvt-plain-best cards (i + 1) chosen taken

  pvt-pad-kick : Integer, Integer -> Integer
  pvt-pad-kick (kick) (n) = if n >= 5 then kick else pvt-pad-kick (kick * 13) (n + 1)

  pvt-show-kick : List Integer, Integer, Integer, Integer -> Integer
  pvt-show-kick (cards) (cnt) (r) (acc) =
    if cnt < 1 then acc
    else if r < 0 then pvt-show-kick cards (cnt - 1) 12 acc
    else if pv-rank-in cards r 0 0 == cnt then pvt-show-kick cards cnt (r - 1) (pk-push-n acc r cnt)
    else pvt-show-kick cards cnt (r - 1) acc

  pvt-top-value : List Integer, Integer, Integer -> Integer
  pvt-top-value (cards) (i) (best) =
    if i >= list-length cards then best
    else let c = pvt-card-value (list-at cards i)
    in pvt-top-value cards (i + 1) (if c > best then c else best)

 Five ranks fit in 13^5 = 371293 and the top card's worth in 52.

  pvt-show-score : List Integer -> Integer
  pvt-show-score (cards) =
    let n = list-length cards
    in let top = pvt-top-value cards 0 0
    in if n >= 5 then
      let hr = pvt-plain-best cards 0 [] pv-no-hand
      in (hr.rank * 371293 + hr.kickers) * 52 + top
    else (pvt-show-cat cards * 371293 + pvt-pad-kick (pvt-show-kick cards 4 12 0) n) * 52 + top

  pvt-best-showing : PvDeal, PvDeal -> Integer
  pvt-best-showing (d0) (d1) =
    if pvt-show-score (pvt-up-cards (d1.cards) (d1.up) 0 []) > pvt-show-score (pvt-up-cards (d0.cards) (d0.up) 0 []) then 1 else 0

 The lowest card showing brings in; with Baseball's extra card a seat can
 show two, and its lower one counts.

  pvt-low-value : List Integer, Integer, Integer -> Integer
  pvt-low-value (cards) (i) (best) =
    if i >= list-length cards then best
    else let c = pvt-card-value (list-at cards i)
    in pvt-low-value cards (i + 1) (if c < best then c else best)

  pvt-bring-seat : PvDeal, PvDeal -> Integer
  pvt-bring-seat (d0) (d1) =
    let a = pvt-low-value (pvt-up-cards (d0.cards) (d0.up) 0 []) 0 99
    in let b = pvt-low-value (pvt-up-cards (d1.cards) (d1.up) 0 []) 0 99
    in if b < a then 1 else 0

  pvt-pair-showing : PvTable -> Boolean
  pvt-pair-showing (p) =
    if pvt-max-count (pvt-up-cards ((p.table).h0) (p.up0) 0 []) 0 0 >= 2 then True
    else pvt-max-count (pvt-up-cards ((p.table).h1) (p.up1) 0 []) 0 0 >= 2

 Follow the queen's wild is the rank of the card dealt face up after the
 last face-up queen, read from the up cards in the order they were dealt.

  pvt-up-seq : PvDeal, PvDeal, Integer, List Integer -> List Integer
  pvt-up-seq (d0) (d1) (i) (acc) =
    if i >= list-length (d0.cards) then acc
    else let a = if pvt-up-at (d0.up) i then list-push acc (list-at (d0.cards) i) else acc
    in let b = if i < list-length (d1.cards) & pvt-up-at (d1.up) i then list-push a (list-at (d1.cards) i) else a
    in pvt-up-seq d0 d1 (i + 1) b

  pvt-wild-table : Integer, PvDeal, PvDeal -> List Boolean
  pvt-wild-table (v) (d0) (d1) =
    if v == 3 then pv-build-rank-wilds [1, 7]
    else if v == 6 then pvt-queen-wilds (pvt-ftq-rank (pvt-up-seq d0 d1 0 []))
    else pv-build-false-list 52

  pvt-ftq-rank : List Integer -> Integer
  pvt-ftq-rank (seq) = pv-find-follow-queen seq (list-length seq)

  pvt-queen-wilds : Integer -> List Boolean
  pvt-queen-wilds (wild-rank) =
    if wild-rank < 0 then pv-build-false-list 52
    else pv-build-rank-wilds [wild-rank]

Section: Dealing The Table

  pvt-street-table : PokerTable, List Integer, List Integer, Integer, Integer -> PokerTable
  pvt-street-table (t) (h0) (h1) (pos) (turn) =
    PokerTable {
      deck = t.deck, pos = pos, h0 = h0, h1 = h1,
      chips0 = t.chips0, chips1 = t.chips1,
      bet0 = 0, bet1 = 0, pot = t.pot,
      stage = 0, turn = turn, acted = 0, marked = 0,
      folded = t.folded, winner = t.winner, last = (-1), done = False,
      opener = t.opener
    }

 Baseball (https://www.pagat.com/poker/variants/baseball.html): threes and
 nines are wild, and a player dealt a four face up is at once dealt an extra
 face-up card, before the next player's card.

 A seat's cards so far, which of them are face up, and the next deck
 position. A card is dealt onto a fresh list: `list-push` extends the list
 it is given in place, and the table this one came from still holds it.

  PvDeal = record {
    cards : List Integer,
    up    : Integer,
    pos   : Integer
  }

  pvt-deal-one : Integer, PvDeal, List Integer, Boolean -> PvDeal
  pvt-deal-one (v) (d) (deck) (face-up) =
    let c = list-at deck (d.pos)
    in let i = list-length (d.cards)
    in let d2 = PvDeal { cards = list-push (pv-copy (d.cards) 0 []) c,
                         up = (if face-up then d.up + pk-pow2 i else d.up),
                         pos = d.pos + 1 }
    in if face-up & v == 3 & card-rank c == 2 then pvt-deal-one v d2 deck True else d2

  pvt-deal-down : Integer, PvDeal, List Integer, Integer -> PvDeal
  pvt-deal-down (v) (d) (deck) (k) =
    if k <= 0 then d else pvt-deal-down v (pvt-deal-one v d deck False) deck (k - 1)

 The first street: the draw games deal five down; a stud deals its down
 cards and then one up.

  pvt-deal-first : Integer, List Integer, Integer -> PvDeal
  pvt-deal-first (v) (deck) (pos) =
    let d = PvDeal { cards = [], up = 0, pos = pos }
    in if pvt-is-stud v then pvt-deal-one v (pvt-deal-down v d deck (pvt-first-deal v - 1)) deck True
    else pvt-deal-down v d deck (pvt-first-deal v)

  pvt-street-up : Integer, Integer -> Boolean
  pvt-street-up (v) (street) = if v == 1 then True else street <= 3

  pvt-new : Integer, Integer -> PvTable
  pvt-new (variant) (seed) =
    let v = if variant < 0 then 0 else if variant > 7 then 7 else variant
    in let deck = poker-shuffle poker-deck-new (rng-new seed)
    in let a = pvt-ante v
    in let d0 = pvt-deal-first v deck 0
    in let d1 = pvt-deal-first v deck (d0.pos)
    in let bring = if pvt-is-stud v then pvt-bring-seat d0 d1 else (-1)
    in PvTable {
         table = PokerTable {
           deck = deck, pos = d1.pos,
           h0 = d0.cards, h1 = d1.cards,
           chips0 = pk-start-chips - a, chips1 = pk-start-chips - a,
           bet0 = 0, bet1 = 0, pot = a * 2,
           stage = 0, turn = (if bring < 0 then 0 else bring), acted = 0, marked = 0,
           folded = (-1), winner = (-1), last = (-1), done = False, opener = (-1)
         },
         variant = v,
         wilds = pvt-wild-table v d0 d1,
         spade = (-1),
         street = 0,
         bet-unit = pk-bet-size,
         bets = 0,
         bring = bring,
         up0 = d0.up,
         up1 = d1.up
       }

  pvt-next-street : PvTable -> PvTable
  pvt-next-street (p) =
    let t = p.table
    in let v = p.variant
    in let street = p.street + 1
    in let face-up = pvt-street-up v street
    in let d0 = pvt-deal-one v (PvDeal { cards = t.h0, up = p.up0, pos = t.pos }) (t.deck) face-up
    in let d1 = pvt-deal-one v (PvDeal { cards = t.h1, up = p.up1, pos = d0.pos }) (t.deck) face-up
    in PvTable {
         table = pvt-street-table t (d0.cards) (d1.cards) (d1.pos) (pvt-best-showing d0 d1),
         variant = v,
         wilds = pvt-wild-table v d0 d1,
         spade = p.spade,
         street = street,
         bet-unit = pvt-street-unit street,
         bets = 0,
         bring = (-1),
         up0 = d0.up,
         up1 = d1.up
       }

  pvt-with : PvTable, PokerTable -> PvTable
  pvt-with (p) (t) =
    PvTable { table = t, variant = p.variant, wilds = p.wilds, spade = p.spade,
              street = p.street, bet-unit = p.bet-unit, bets = p.bets, bring = p.bring,
              up0 = p.up0, up1 = p.up1 }

  pvt-with-bet : PvTable, PokerTable, Integer, Integer -> PvTable
  pvt-with-bet (p) (t) (bets) (bet-unit) =
    PvTable { table = t, variant = p.variant, wilds = p.wilds, spade = p.spade,
              street = p.street, bet-unit = bet-unit, bets = bets, bring = (-1),
              up0 = p.up0, up1 = p.up1 }

  pvt-best-hand : PvTable, Integer -> PokerHand
  pvt-best-hand (p) (who) =
    let cards = pk-hand-of (p.table) who
    in if pvt-cards-per-hand (p.variant) == 5 then PokerHand { cards = cards }
    else pv-best-5-of-7 cards

Section: Ranking A Hand Of Any Size

 A stud hand is ranked as it stands: under five cards by its groups, with
 each wild joining the largest; five as they are; more as the best five of
 them, which with Baseball's extra cards can be eleven.

  pvt-partial-rank : List Integer, List Boolean -> HandRank
  pvt-partial-rank (cards) (wilds) =
    let nat = pv-naturals cards wilds 0 []
    in let k = list-length cards - list-length nat
    in let m0 = pvt-max-count nat 0 0 + k
    in let m = if m0 > 4 then 4 else m0
    in let r = if m >= 4 then 7
       else if m == 3 then 3
       else if m == 2 then (if k == 0 & pvt-pair-count nat 0 0 >= 2 then 2 else 1)
       else 0
    in HandRank { rank = r, primary = 0, secondary = 0, kickers = 0 }

  pvt-eval-5 : PvTable, List Integer -> HandRank
  pvt-eval-5 (p) (cards) =
    if pvt-has-wilds (p.variant) then pv-evaluate-with-wilds (PokerHand { cards = cards }) (p.wilds)
    else evaluate-hand (PokerHand { cards = cards })

 Every five of the hand, choosing each card in or out; a branch that can no
 longer reach five stops. `chosen` is copied before a card is added, so the
 branch that leaves the card out never sees it.

  pvt-best-five : PvTable, List Integer, Integer, List Integer, HandRank -> HandRank
  pvt-best-five (p) (cards) (i) (chosen) (best) =
    if list-length chosen == 5 then pv-better best (pvt-eval-5 p chosen)
    else if list-length cards - i < 5 - list-length chosen then best
    else let taken = pvt-best-five p cards (i + 1) (list-push (pv-copy chosen 0 []) (list-at cards i)) best
    in pvt-best-five p cards (i + 1) chosen taken

  pvt-eval : PvTable, Integer -> HandRank
  pvt-eval (p) (who) =
    let cards = pk-hand-of (p.table) who
    in let n = list-length cards
    in if n < 5 then pvt-partial-rank cards (p.wilds)
    else if n == 5 then pvt-eval-5 p cards
    else pvt-best-five p cards 0 [] pv-no-hand

  pvt-compare : PvTable, HandRank, HandRank -> Integer
  pvt-compare (p) (a) (b) =
    if pvt-has-wilds (p.variant) then pvt-compare-wild a b
    else compare-hands a b

  pvt-compare-wild : HandRank, HandRank -> Integer
  pvt-compare-wild (a) (b) =
    if a.rank > b.rank then 1
    else if b.rank > a.rank then 2
    else if a.primary > b.primary then 1
    else if b.primary > a.primary then 2
    else 0

 pagat's Chicagos (https://www.pagat.com/poker/variants/chicago.html): the
 pot is split between the highest hand and the highest spade in the hole
 (the lowest, ace high, in Low Chicago). The hole is every card dealt face
 down, seventh street's included; face-up spades do not count. With no spade
 in either hole the highest hand takes it all.

  pvt-hole : PvTable, Integer -> List Integer
  pvt-hole (p) (who) = pvt-down-cards (pk-hand-of (p.table) who) (pvt-mask-of p who) 0 []

  pvt-down-cards : List Integer, Integer, Integer, List Integer -> List Integer
  pvt-down-cards (cards) (mask) (i) (acc) =
    if i >= list-length cards then acc
    else pvt-down-cards cards mask (i + 1) (if pvt-up-at mask i then acc else list-push acc (list-at cards i))

  pvt-spade-winner : PvTable -> Integer
  pvt-spade-winner (p) =
    if p.variant == 4 then pvt-hi-spade p
    else if p.variant == 5 then pvt-low-spade p
    else 0

  pvt-hi-spade : PvTable -> Integer
  pvt-hi-spade (p) =
    let s0 = pv-highest-spade-in-hole (pvt-hole p 0)
    in let s1 = pv-highest-spade-in-hole (pvt-hole p 1)
    in if s0 > s1 then 1 else if s1 > s0 then 2 else 0

  pvt-low-spade : PvTable -> Integer
  pvt-low-spade (p) =
    let s0 = pv-lowest-spade-in-hole (pvt-hole p 0)
    in let s1 = pv-lowest-spade-in-hole (pvt-hole p 1)
    in pvt-low-pick s0 s1

  pvt-low-pick : Integer, Integer -> Integer
  pvt-low-pick (s0) (s1) =
    if s0 < 0 & s1 < 0 then 0
    else if s0 < 0 then 2
    else if s1 < 0 then 1
    else if s0 < s1 then 1
    else if s1 < s0 then 2
    else 0

  pvt-seat-of : Integer -> Integer
  pvt-seat-of (w) = if w == 1 then 0 else if w == 2 then 1 else (-1)

 The hand's half is the larger when the pot is odd; a tied hand splits its
 half the same way, the odd chip to seat 0.

  pvt-showdown : PvTable -> PvTable
  pvt-showdown (p) =
    let sw = pvt-spade-winner p
    in let hw = pvt-seat-of (pvt-compare p (pvt-eval p 0) (pvt-eval p 1))
    in let t = if sw == 0 then pk-award (p.table) hw else pvt-split-pot (p.table) hw (pvt-seat-of sw)
    in PvTable { table = t, variant = p.variant,
                 wilds = p.wilds, spade = sw,
                 street = p.street, bet-unit = p.bet-unit, bets = p.bets, bring = (-1),
                 up0 = p.up0, up1 = p.up1 }

  pvt-half-to : Integer, Integer, Integer -> Integer
  pvt-half-to (amount) (w) (who) =
    if w == who then amount
    else if w >= 0 then 0
    else if who == 0 then amount - amount / 2
    else amount / 2

  pvt-split-pot : PokerTable, Integer, Integer -> PokerTable
  pvt-split-pot (t) (hw) (sw) =
    let spade-half = t.pot / 2
    in let hand-half = t.pot - spade-half
    in PokerTable {
      deck = t.deck, pos = t.pos, h0 = t.h0, h1 = t.h1,
      chips0 = t.chips0 + pvt-half-to hand-half hw 0 + pvt-half-to spade-half sw 0,
      chips1 = t.chips1 + pvt-half-to hand-half hw 1 + pvt-half-to spade-half sw 1,
      bet0 = t.bet0, bet1 = t.bet1, pot = 0,
      stage = 3, turn = t.turn, acted = t.acted,
      marked = 0, folded = t.folded, winner = hw,
      last = t.last, done = True, opener = t.opener
    }

 Jacks or better: a seat may not open the betting without a pair of jacks or
 better.

  pvt-can-open : PvTable, Integer -> Boolean
  pvt-can-open (p) (who) =
    if p.variant /= 7 then True
    else pv-can-open (pvt-best-hand p who)

  pvt-can-raise : PvTable, Integer -> Boolean
  pvt-can-raise (p) (who) =
    if pvt-is-stud (p.variant) then pvt-can-raise-to p who (pvt-target p (p.bet-unit))
    else if pk-can-raise (p.table) who == False then False
    else if pk-to-call (p.table) who > 0 then True
    else pvt-can-open p who

 A stud bet or raise brings the seat's stake to a target: the unit when
 nothing has been bet (which is how a bring-in is completed), else one unit
 over the larger stake.

  pvt-target : PvTable, Integer -> Integer
  pvt-target (p) (bet-unit) =
    let t = p.table
    in if p.bets == 0 then bet-unit
    else (if t.bet0 > t.bet1 then t.bet0 else t.bet1) + bet-unit

  pvt-can-raise-to : PvTable, Integer, Integer -> Boolean
  pvt-can-raise-to (p) (who) (target) =
    let t = p.table
    in let amount = target - pk-bet-of t who
    in if pk-can-fold t who == False then False
    else if p.bets >= pk-max-raises then False
    else if amount <= pk-to-call t who then False
    else amount <= pk-chips-of t who

  pvt-can-big : PvTable, Integer -> Boolean
  pvt-can-big (p) (who) =
    if pvt-is-stud (p.variant) == False then False
    else if p.street /= 1 then False
    else if p.bet-unit /= pk-bet-size then False
    else if pvt-pair-showing p == False then False
    else pvt-can-raise-to p who (pvt-target p pvt-big-bet)

 The seat bringing in may not fold or check: its call is the bring-in.

  pvt-can-fold : PvTable, Integer -> Boolean
  pvt-can-fold (p) (who) =
    if p.bring == who then False
    else pk-can-fold (p.table) who

Section: The Moves, Over The Same Table

 A seven-card or wild variant ranked by `evaluate-hand` pays the wrong seat,
 so the end of a betting round goes through this chapter's ranking.

  pvt-advance : PvTable -> PvTable
  pvt-advance (p) =
    if pk-round-over (p.table) then pvt-advance-now p else p

  pvt-advance-now : PvTable -> PvTable
  pvt-advance-now (p) =
    if (p.table).stage == 0 & pvt-is-draw (p.variant)
      then pvt-with p (pk-open-stage (p.table) 1)
    else if p.street < pvt-last-street (p.variant) then pvt-next-street p
    else pvt-showdown p

 A refusal answers the state it was given: `pvt-with` builds a new record,
 so every move checks legality before it wraps anything.

 A fold loses whatever the seat held.

  pvt-fold : PvTable, Integer -> PvTable
  pvt-fold (p) (who) =
    if pvt-can-fold p who == False then p
    else pvt-with p (pk-fold (p.table) who)

 A bring-in is noted as 5.

  pvt-call : PvTable, Integer -> PvTable
  pvt-call (p) (who) =
    if pk-can-call (p.table) who == False then p
    else if p.bring == who then pvt-bring p who
    else let owed = pk-to-call (p.table) who
    in let paid = pk-put-in (p.table) who owed
    in pvt-advance (pvt-with p (pk-note paid (if owed == 0 then 1 else 2)))

  pvt-bring : PvTable, Integer -> PvTable
  pvt-bring (p) (who) =
    let chips = pk-chips-of (p.table) who
    in let amount = if chips < pvt-bring-in then chips else pvt-bring-in
    in let paid = pk-put-in (p.table) who amount
    in pvt-advance (pvt-with-bet p (pk-note paid 5) (p.bets) (p.bet-unit))

 The draw games raise by the round's bet, ten before the draw and twenty
 after it.

  pvt-raise : PvTable, Integer -> PvTable
  pvt-raise (p) (who) =
    if pvt-can-raise p who == False then p
    else if pvt-is-stud (p.variant) then pvt-raise-to p who (pvt-target p (p.bet-unit)) (p.bet-unit)
    else let owed = pk-to-call (p.table) who
    in let paid = pk-put-in (p.table) who (owed + pk-round-bet (p.table))
    in pvt-advance (pvt-with p (pk-note paid 3))

  pvt-raise-to : PvTable, Integer, Integer, Integer -> PvTable
  pvt-raise-to (p) (who) (target) (bet-unit) =
    let paid = pk-put-in (p.table) who (target - pk-bet-of (p.table) who)
    in pvt-advance (pvt-with-bet p (pk-note paid 3) (p.bets + 1) bet-unit)

  pvt-big : PvTable, Integer -> PvTable
  pvt-big (p) (who) =
    if pvt-can-big p who == False then p
    else pvt-raise-to p who (pvt-target p pvt-big-bet) pvt-big-bet

 The draw belongs to five card draw alone.

  pvt-can-draw : PvTable, Integer -> Boolean
  pvt-can-draw (p) (who) =
    if pvt-is-draw (p.variant) == False then False
    else pk-can-draw (p.table) who

 A click only ever adds a mark; clearing is its own move, so a page scanning
 positions cannot mark and unmark a card forever.

  pvt-can-mark : PvTable, Integer -> Boolean
  pvt-can-mark (p) (i) =
    if pvt-can-draw p 0 == False then False
    else if i < 0 then False
    else if i >= 5 then False
    else pk-bit ((p.table).marked) i == 0

  pvt-mark : PvTable, Integer -> PvTable
  pvt-mark (p) (i) =
    if pvt-can-mark p i == False then p
    else pvt-with p (pk-mark (p.table) i)

  pvt-clear-marks : PvTable -> PvTable
  pvt-clear-marks (p) =
    if pvt-is-draw (p.variant) == False then p
    else if (p.table).marked == 0 then p
    else pvt-with p (pk-clear-marks (p.table))

  pvt-draw : PvTable -> PvTable
  pvt-draw (p) =
    if pvt-can-draw p 0 == False then p
    else pvt-with p (pk-draw (p.table))

 `pk-ai-bet` reads `evaluate-hand` over whatever the seat holds, which for
 seven cards is not that seat's hand.

  pvt-ai-move : PvTable -> PvTable
  pvt-ai-move (p) =
    if (p.table).done then p
    else if (p.table).stage >= 3 then p
    else let who = (p.table).turn
    in if (p.table).stage == 1 then pvt-ai-draw p who
    else pvt-ai-bet p who

  pvt-ai-draw : PvTable, Integer -> PvTable
  pvt-ai-draw (p) (who) =
    let mask = pk-discard-mask (pk-hand-of (p.table) who)
    in pvt-with p (pk-after-draw (pk-draw-for (p.table) who mask))

  pvt-ai-bet : PvTable, Integer -> PvTable
  pvt-ai-bet (p) (who) =
    let strength = (pvt-eval p who).rank
    in let owed = pk-to-call (p.table) who
    in if strength >= 2 & pvt-can-raise p who then pvt-raise p who
    else if owed == 0 then pvt-call p who
    else if strength >= 1 then pvt-call p who
    else pvt-fold p who

Section: Game Runner

 One hand of the table, both seats played by the other seats' rules. The
 winner is 1 or 2 for the seat the pot went to, 0 for a split; a hand that
 ended in a fold was won by the seat still in. `special-winner` is the spade
 in the hole's seat in the Chicagos, the wild rank (or -1) in Follow the
 Queen, the first seat that could open in Jacks or Better, and 0 elsewhere.

  pv-variant-index : PokerVariant -> Integer
  pv-variant-index (v) =
    when v
      is FiveCardDraw    -> 0
      is FiveCardStud    -> 1
      is SevenCardStud   -> 2
      is Baseball        -> 3
      is HiChicago       -> 4
      is LowChicago      -> 5
      is FollowTheQueen  -> 6
      is JacksOrBetter   -> 7

  pvt-play-out : PvTable, Integer -> PvTable
  pvt-play-out (p) (fuel) =
    if fuel <= 0 then p
    else if (p.table).done then p
    else pvt-play-out (pvt-ai-move p) (fuel - 1)

  pvt-wild-rank : List Boolean, Integer -> Integer
  pvt-wild-rank (wilds) (card) =
    if card >= 52 then (-1)
    else if list-at wilds card then card-rank card
    else pvt-wild-rank wilds (card + 1)

  pvt-special : PvTable -> Integer
  pvt-special (p) =
    if p.variant == 4 | p.variant == 5 then p.spade
    else if p.variant == 6 then pvt-wild-rank (p.wilds) 0
    else if p.variant == 7 then (if pvt-can-open p 0 then 1 else if pvt-can-open p 1 then 2 else 0)
    else 0

  run-poker-variant : PokerVariant, Integer, Integer -> PokerSession
  run-poker-variant (variant) (seed) (num-players) =
    let fin = pvt-play-out (pvt-new (pv-variant-index variant) seed) 400
    in let t = fin.table
    in let w = if t.folded == 0 then 2
       else if t.folded == 1 then 1
       else if t.winner == 0 then 1
       else if t.winner == 1 then 2
       else 0
    in PokerSession {
         variant = variant,
         seed = seed,
         num-players = 2,
         winner = w,
         p1-hand-rank = (pvt-eval fin 0).rank,
         p2-hand-rank = (pvt-eval fin 1).rank,
         hands-played = 1,
         special-winner = pvt-special fin
       }

  pv-variant-name : PokerVariant -> Text
  pv-variant-name (v) =
    when v
      is FiveCardDraw    -> "FiveCardDraw"
      is FiveCardStud    -> "FiveCardStud"
      is SevenCardStud   -> "SevenCardStud"
      is Baseball        -> "Baseball"
      is HiChicago       -> "HiChicago"
      is LowChicago      -> "LowChicago"
      is FollowTheQueen  -> "FollowTheQueen"
      is JacksOrBetter   -> "JacksOrBetter"

Section: Formatting

  format-poker-variant : PokerSession -> Text
  format-poker-variant (s) =
    let vname = pv-variant-name (s.variant)
    in let w = if s.winner == 1 then "P1"
       else if s.winner == 2 then "P2"
       else "Tie"
    in vname & " (seed=" & show (s.seed) & "): P1=" & rank-name (s.p1-hand-rank) &
       " P2=" & rank-name (s.p2-hand-rank) & " winner=" & w

Page 1
