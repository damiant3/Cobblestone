Chapter: RiskWasm
  cites Games chapter Risk
  cites Games chapter Rng

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

 The page's person is seat 0.

  rk-wasm-new : Integer, Integer -> RiskState
  rk-wasm-new (seed) (players) = rk-set-human (risk-init seed players) 0

  rk-wasm-step : RiskState, Integer -> RiskState
  rk-wasm-step (s) (seed) = risk-step s seed

  rk-wasm-act : RiskState, Integer, Integer, Integer, Integer -> RiskState
  rk-wasm-act (s) (p) (kind) (arg) (seed) = rk-act s p kind arg seed

  rk-wasm-legal : RiskState, Integer, Integer, Integer -> Integer
  rk-wasm-legal (s) (p) (kind) (arg) = if rk-legal s p kind arg then 1 else 0

  rk-wasm-ai : RiskState -> Integer
  rk-wasm-ai (s) = rk-ai s

  rk-wasm-slot : RiskState, Integer -> Integer
  rk-wasm-slot (s) (i) =
    if i < 0 then (-9)
    else if i >= rk-size then (-9)
    else rk-get s i

 A grader's set-up: a copy with one slot of the state layout set.

  rk-wasm-poke : RiskState, Integer, Integer -> RiskState
  rk-wasm-poke (s) (i) (v) =
    if i < 0 then s
    else if i >= rk-size then s
    else rk-put (rk-copy s) i v

Section: Reading The Board

  rk-wasm-players : RiskState -> Integer
  rk-wasm-players (s) = rk-players s

  rk-wasm-owner : RiskState, Integer -> Integer
  rk-wasm-owner (s) (t) = if rk-terr-ok t then rk-owner s t else (-1)

  rk-wasm-armies : RiskState, Integer -> Integer
  rk-wasm-armies (s) (t) = if rk-terr-ok t then rk-armies s t else (-1)

  rk-wasm-adjacent : Integer, Integer -> Integer
  rk-wasm-adjacent (a) (b) = if rk-adjacent a b then 1 else 0

  rk-wasm-continent : Integer -> Integer
  rk-wasm-continent (t) = if rk-terr-ok t then rk-continent t else (-1)

  rk-wasm-cont-bonus : Integer -> Integer
  rk-wasm-cont-bonus (c) = if c < 0 then (-1) else if c > 5 then (-1) else rk-continent-bonus c

  rk-wasm-seat-ok : RiskState, Integer -> Boolean
  rk-wasm-seat-ok (s) (p) = if p < 0 then False else p < rk-players s

  rk-wasm-alive : RiskState, Integer -> Integer
  rk-wasm-alive (s) (p) = if rk-wasm-seat-ok s p then (if rk-alive s p then 1 else 0) else (-1)

  rk-wasm-total : RiskState, Integer -> Integer
  rk-wasm-total (s) (p) = if rk-wasm-seat-ok s p then rk-total-armies s p else (-1)

  rk-wasm-held : RiskState, Integer -> Integer
  rk-wasm-held (s) (p) = if rk-wasm-seat-ok s p then rk-held s p else (-1)

  rk-wasm-reinf : RiskState, Integer -> Integer
  rk-wasm-reinf (s) (p) = if rk-wasm-seat-ok s p then rk-reinforcements s p else (-1)

  rk-wasm-hand : RiskState, Integer -> Integer
  rk-wasm-hand (s) (p) = if rk-wasm-seat-ok s p then rk-hand s p else (-1)

  rk-wasm-setup-left : RiskState, Integer -> Integer
  rk-wasm-setup-left (s) (p) = if rk-wasm-seat-ok s p then rk-get s (rk-f-setup + p) else (-1)

  rk-wasm-holder : RiskState, Integer -> Integer
  rk-wasm-holder (s) (c) = if c < 0 then (-9) else if c >= 44 then (-9) else rk-holder s c

  rk-wasm-symbol : Integer -> Integer
  rk-wasm-symbol (c) = if c < 0 then (-1) else if c >= 44 then (-1) else rk-symbol c

  rk-wasm-first-set : RiskState, Integer -> Integer
  rk-wasm-first-set (s) (p) = if rk-wasm-seat-ok s p then rk-first-set s p 0 1 2 else (-1)

  rk-wasm-connected : RiskState, Integer, Integer, Integer -> Integer
  rk-wasm-connected (s) (p) (a) (b) =
    if rk-terr-ok a == False then 0
    else if rk-terr-ok b == False then 0
    else if rk-connected s p a b then 1 else 0

Section: The Turn

  rk-wasm-cur : RiskState -> Integer
  rk-wasm-cur (s) = rk-cur s

  rk-wasm-phase : RiskState -> Integer
  rk-wasm-phase (s) = rk-phase s

  rk-wasm-turn : RiskState -> Integer
  rk-wasm-turn (s) = rk-get s rk-f-turn

  rk-wasm-done : RiskState -> Integer
  rk-wasm-done (s) = if rk-over s then 1 else 0

  rk-wasm-winner : RiskState -> Integer
  rk-wasm-winner (s) = rk-get s rk-f-winner

  rk-wasm-to-place : RiskState -> Integer
  rk-wasm-to-place (s) = rk-get s rk-f-place

  rk-wasm-trades : RiskState -> Integer
  rk-wasm-trades (s) = rk-get s rk-f-trades

  rk-wasm-die : RiskState, Integer -> Integer
  rk-wasm-die (s) (k) = if k < 0 then (-1) else if k > 4 then (-1) else rk-get s (rk-f-dice + k)

  rk-wasm-lost : RiskState, Integer -> Integer
  rk-wasm-lost (s) (side) = if side == 0 then rk-get s rk-f-alost else rk-get s rk-f-dlost

  rk-wasm-move-from : RiskState -> Integer
  rk-wasm-move-from (s) = if rk-phase s == 3 then rk-get s rk-f-mfrom else (-1)

  rk-wasm-move-to : RiskState -> Integer
  rk-wasm-move-to (s) = if rk-phase s == 3 then rk-get s rk-f-mto else (-1)

  rk-wasm-move-min : RiskState -> Integer
  rk-wasm-move-min (s) = if rk-phase s == 3 then rk-get s rk-f-mmin else (-1)

  rk-wasm-conquered : RiskState -> Integer
  rk-wasm-conquered (s) = rk-get s rk-f-conquered

  rk-wasm-deck-len : RiskState -> Integer
  rk-wasm-deck-len (s) = rk-get s rk-f-decklen

  rk-wasm-deck : RiskState, Integer -> Integer
  rk-wasm-deck (s) (k) = if k < 0 then (-1) else if k >= rk-get s rk-f-decklen then (-1) else rk-get s (180 + k)

  rk-wasm-discard-len : RiskState -> Integer
  rk-wasm-discard-len (s) = rk-get s rk-f-discardlen

  rk-wasm-discard : RiskState, Integer -> Integer
  rk-wasm-discard (s) (k) = if k < 0 then (-1) else if k >= rk-get s rk-f-discardlen then (-1) else rk-get s (230 + k)

  rk-wasm-turn-cap : Integer
  rk-wasm-turn-cap = risk-turn-cap

Section: The Whole Game

  rk-wasm-run : Integer, Integer -> RiskResult
  rk-wasm-run (seed) (players) = run-risk-game seed players

  rk-wasm-res-winner : RiskResult -> Integer
  rk-wasm-res-winner (r) = r.winner

  rk-wasm-res-turns : RiskResult -> Integer
  rk-wasm-res-turns (r) = r.turns

  rk-wasm-res-owner : RiskResult, Integer -> Integer
  rk-wasm-res-owner (r) (i) =
    if i < 0 then (-1)
    else if i >= list-length (r.territories) then (-1)
    else list-at (r.territories) i

