Chapter: WarWasm
  cites Games chapter War
  cites Games chapter Rng
  cites Foreword chapter List

 `war-shift-hand`, `war-add-card` and `war-deal-half` all write with
 `list-set-at`, in place, so `wr-wasm-round` copies first.

 We say:

Section: Copying

  wasm-exports : Text = ""

  wr-copy-hand : List Integer, Integer, List Integer -> List Integer
  wr-copy-hand (src) (i) (acc) =
    if i >= 52 then acc
    else wr-copy-hand src (i + 1) (list-push acc (list-at src i))

  wr-copy-state : WarState -> WarState
  wr-copy-state (s) =
    WarState {
      p1-hand = wr-copy-hand (s.p1-hand) 0 [],
      p1-size = s.p1-size,
      p2-hand = wr-copy-hand (s.p2-hand) 0 [],
      p2-size = s.p2-size,
      rng     = s.rng
    }

Section: The Browser Interface

  wr-wasm-new : Integer -> WarState
  wr-wasm-new (seed) = war-init seed

  wr-wasm-p1-size : WarState -> Integer
  wr-wasm-p1-size (s) = s.p1-size

  wr-wasm-p2-size : WarState -> Integer
  wr-wasm-p2-size (s) = s.p2-size

  wr-wasm-p1-card : WarState, Integer -> Integer
  wr-wasm-p1-card (s) (i) =
    if i < 0 then (-1)
    else if i >= 52 then (-1)
    else list-at (s.p1-hand) i

  wr-wasm-p2-card : WarState, Integer -> Integer
  wr-wasm-p2-card (s) (i) =
    if i < 0 then (-1)
    else if i >= 52 then (-1)
    else list-at (s.p2-hand) i

  wr-wasm-rank : Integer -> Integer
  wr-wasm-rank (c) =
    if c < 0 then (-1)
    else if c >= 52 then (-1)
    else war-card-rank c

  wr-wasm-round : WarState -> WarState
  wr-wasm-round (s) =
    if s.p1-size <= 0 then s
    else if s.p2-size <= 0 then s
    else war-do-round (wr-copy-state s)

Section: Setting Up a Position

 A grader builds a position card by card: an empty table, then each card
 pushed to the bottom of one player's packet, on a copy.

  wr-wasm-empty : Integer -> WarState
  wr-wasm-empty (seed) =
    let s = war-init seed
    in WarState { p1-hand = s.p1-hand, p1-size = 0, p2-hand = s.p2-hand, p2-size = 0, rng = s.rng }

  wr-wasm-push1 : WarState, Integer -> WarState
  wr-wasm-push1 (s) (card) =
    let c = wr-copy-state s
    in if c.p1-size + c.p2-size >= 52 then c
    else WarState { p1-hand = war-add-card (c.p1-hand) (c.p1-size) card, p1-size = c.p1-size + 1, p2-hand = c.p2-hand, p2-size = c.p2-size, rng = c.rng }

  wr-wasm-push2 : WarState, Integer -> WarState
  wr-wasm-push2 (s) (card) =
    let c = wr-copy-state s
    in if c.p1-size + c.p2-size >= 52 then c
    else WarState { p1-hand = c.p1-hand, p1-size = c.p1-size, p2-hand = war-add-card (c.p2-hand) (c.p2-size) card, p2-size = c.p2-size + 1, rng = c.rng }

Section: The Whole Game

  wr-wasm-run : Integer -> WarResult
  wr-wasm-run (seed) = run-war-game seed

  wr-wasm-res-winner : WarResult -> Integer
  wr-wasm-res-winner (r) = r.winner

  wr-wasm-res-rounds : WarResult -> Integer
  wr-wasm-res-rounds (r) = r.rounds-played

