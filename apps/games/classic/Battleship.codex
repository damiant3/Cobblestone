Chapter: Battleship
  cites Games chapter Rng

 Battleship: two players, each with a 10x10 ship grid and a tracking grid of
 the shots fired at the other. A ship cell holds its ship's number, 1 to 5.

 We say:

Section: The Rules

 The rules as Hasbro publishes them (Battleship, the classic game's rules
 leaflet).

 Rule 1. Each fleet is a carrier (5 squares), a battleship (4), a cruiser
 (3), a submarine (3) and a destroyer (2), placed horizontally or
 vertically, never diagonally, inside the grid and not overlapping; ships
 may touch.

 Rule 2. Players take turns firing one shot at a square of the other's
 grid, the first player first. The other calls hit or miss; a square is
 fired at once.

 Rule 3. When every square of a ship has been hit, its owner announces
 which ship was sunk.

 Rule 4. The first player to sink the whole of the other fleet wins. A shot
 that sinks the last ship ends the game at once.

Section: Types

  BsGrid = record {
    cells : List Integer
  }

  BsState = record {
    p1-ships    : BsGrid,
    p1-tracking : BsGrid,
    p2-ships    : BsGrid,
    p2-tracking : BsGrid,
    p1-hits     : Integer,
    p2-hits     : Integer,
    p1-shots    : Integer,
    p2-shots    : Integer,
    rng         : Rng,
    game-over   : Boolean,
    winner      : Integer
  }

  HitResult =
    | Miss
    | Hit
    | Sunk

  BattleshipResult = record {
    winner   : Integer,
    p1-shots : Integer,
    p2-shots : Integer
  }

Section: Grid Helpers

  bs-empty-grid : BsGrid
  bs-empty-grid =
    BsGrid { cells = bs-fill 0 [] }

  bs-fill : Integer, List Integer -> List Integer
  bs-fill (i) (acc) =
    if i >= 100 then acc
    else bs-fill (i + 1) (list-push acc 0)

  bs-cell : BsGrid, Integer, Integer -> Integer
  bs-cell (g) (row) (col) =
    if row < 0 then -1
    else if row >= 10 then -1
    else if col < 0 then -1
    else if col >= 10 then -1
    else list-at (g.cells) (row * 10 + col)

  bs-set : BsGrid, Integer, Integer, Integer -> BsGrid
  bs-set (g) (row) (col) (v) =
    BsGrid { cells = list-set-at (g.cells) (row * 10 + col) v }

Section: Ship Placement

  bs-ship-sizes : List Integer
  bs-ship-sizes = [5, 4, 3, 3, 2]

  bs-place-ships : Rng -> BsGrid
  bs-place-ships (rng) =
    let g0 = bs-empty-grid
    in let r1 = rng-next rng
    in let g1 = bs-place-ship g0 r1 5 1
    in let r2 = rng-next r1
    in let g2 = bs-place-ship g1 r2 4 2
    in let r3 = rng-next r2
    in let g3 = bs-place-ship g2 r3 3 3
    in let r4 = rng-next r3
    in let g4 = bs-place-ship g3 r4 3 4
    in let r5 = rng-next r4
    in bs-place-ship g4 r5 2 5

  bs-place-ship : BsGrid, Rng, Integer, Integer -> BsGrid
  bs-place-ship (g) (rng) (size) (id) =
    bs-try-place g rng size id 0

 Random places first; after 200 misses, the first place that fits in a scan
 of rows, columns and both directions, so the fleet is always whole.

  bs-scan-place : BsGrid, Integer, Integer, Integer -> BsGrid
  bs-scan-place (g) (size) (id) (k) =
    if k >= 200 then g
    else let horiz = k >= 100
    in let row = (k - (if horiz then 100 else 0)) / 10
    in let col = k - (if horiz then 100 else 0) - row * 10
    in if bs-fits g row col size horiz then bs-fill-ship g row col size horiz id
    else bs-scan-place g size id (k + 1)

  bs-try-place : BsGrid, Rng, Integer, Integer, Integer -> BsGrid
  bs-try-place (g) (rng) (size) (id) (attempts) =
    if attempts >= 200 then bs-scan-place g size id 0
    else let r1 = rng-next rng
    in let r2 = rng-next r1
    in let r3 = rng-next r2
    in let horiz = rng-bit r3 == 0
    in let row = rng-range r1 0 9
    in let col = rng-range r2 0 9
    in if bs-fits g row col size horiz then bs-fill-ship g row col size horiz id
    else bs-try-place g r3 size id (attempts + 1)

  bs-fits : BsGrid, Integer, Integer, Integer, Boolean -> Boolean
  bs-fits (g) (row) (col) (size) (horiz) =
    if horiz then
      if col + size > 10 then False
      else bs-all-empty g row col size horiz 0
    else
      if row + size > 10 then False
      else bs-all-empty g row col size horiz 0

  bs-all-empty : BsGrid, Integer, Integer, Integer, Boolean, Integer -> Boolean
  bs-all-empty (g) (row) (col) (size) (horiz) (i) =
    if i >= size then True
    else let r = if horiz then row else row + i
    in let c = if horiz then col + i else col
    in if bs-cell g r c /= 0 then False
    else bs-all-empty g row col size horiz (i + 1)

  bs-fill-ship : BsGrid, Integer, Integer, Integer, Boolean, Integer -> BsGrid
  bs-fill-ship (g) (row) (col) (size) (horiz) (id) =
    bs-fill-loop g row col size horiz id 0

  bs-fill-loop : BsGrid, Integer, Integer, Integer, Boolean, Integer, Integer -> BsGrid
  bs-fill-loop (g) (row) (col) (size) (horiz) (id) (i) =
    if i >= size then g
    else let r = if horiz then row else row + i
    in let c = if horiz then col + i else col
    in bs-fill-loop (bs-set g r c id) row col size horiz id (i + 1)

Section: Shooting

  bs-total-ship-cells : Integer
  bs-total-ship-cells = 17

  bs-shoot : BsGrid, BsGrid, Integer, Integer -> BsGrid
  bs-shoot (ships) (tracking) (row) (col) =
    let v = bs-cell ships row col
    in let hit-val = if v >= 1 then 2 else 1
    in bs-set tracking row col hit-val

  bs-count-hits : BsGrid, Integer, Integer -> Integer
  bs-count-hits (tracking) (i) (acc) =
    if i >= 100 then acc
    else if list-at (tracking.cells) i == 2 then bs-count-hits tracking (i + 1) (acc + 1)
    else bs-count-hits tracking (i + 1) acc

Section: AI Strategy

  bs-ai-pick-shot : BsGrid, Rng -> Integer
  bs-ai-pick-shot (tracking) (rng) =
    let target = bs-find-adjacent-to-hit tracking 0
    in if target >= 0 then target
    else bs-find-random-unknown tracking rng

  bs-find-adjacent-to-hit : BsGrid, Integer -> Integer
  bs-find-adjacent-to-hit (tracking) (i) =
    if i >= 100 then -1
    else if list-at (tracking.cells) i /= 2 then bs-find-adjacent-to-hit tracking (i + 1)
    else let row = i / 10
    in let col = i - row * 10
    in let adj = bs-first-unknown-adjacent tracking row col
    in if adj >= 0 then adj
    else bs-find-adjacent-to-hit tracking (i + 1)

  bs-first-unknown-adjacent : BsGrid, Integer, Integer -> Integer
  bs-first-unknown-adjacent (tracking) (row) (col) =
    if row > 0 then
      if bs-cell tracking (row - 1) col == 0 then (row - 1) * 10 + col
      else bs-check-south tracking row col
    else bs-check-south tracking row col

  bs-check-south : BsGrid, Integer, Integer -> Integer
  bs-check-south (tracking) (row) (col) =
    if row < 9 then
      if bs-cell tracking (row + 1) col == 0 then (row + 1) * 10 + col
      else bs-check-west tracking row col
    else bs-check-west tracking row col

  bs-check-west : BsGrid, Integer, Integer -> Integer
  bs-check-west (tracking) (row) (col) =
    if col > 0 then
      if bs-cell tracking row (col - 1) == 0 then row * 10 + (col - 1)
      else bs-check-east tracking row col
    else bs-check-east tracking row col

  bs-check-east : BsGrid, Integer, Integer -> Integer
  bs-check-east (tracking) (row) (col) =
    if col < 9 then
      if bs-cell tracking row (col + 1) == 0 then row * 10 + (col + 1)
      else -1
    else -1

  bs-find-random-unknown : BsGrid, Rng -> Integer
  bs-find-random-unknown (tracking) (rng) =
    bs-random-unknown-loop tracking rng 0

  bs-random-unknown-loop : BsGrid, Rng, Integer -> Integer
  bs-random-unknown-loop (tracking) (rng) (attempts) =
    if attempts >= 200 then bs-first-unknown tracking 0
    else let r = rng-next rng
    in let idx = rng-range r 0 99
    in if list-at (tracking.cells) idx == 0 then idx
    else bs-random-unknown-loop tracking r (attempts + 1)

  bs-first-unknown : BsGrid, Integer -> Integer
  bs-first-unknown (tracking) (i) =
    if i >= 100 then -1
    else if list-at (tracking.cells) i == 0 then i
    else bs-first-unknown tracking (i + 1)

Section: Game Runner

  run-battleship-game : BattleshipResult
  run-battleship-game =
    let r0 = rng-new 42
    in let r1 = rng-next r0
    in let r2 = rng-next r1
    in let p1-ships = bs-place-ships r1
    in let p2-ships = bs-place-ships r2
    in let st = BsState { p1-ships = p1-ships, p1-tracking = bs-empty-grid, p2-ships = p2-ships, p2-tracking = bs-empty-grid, p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0, rng = r2, game-over = False, winner = 0 }
    in bs-loop st

  bs-loop : BsState -> BattleshipResult
  bs-loop (st) =
    if st.game-over then BattleshipResult { winner = st.winner, p1-shots = st.p1-shots, p2-shots = st.p2-shots }
    else bs-loop (bs-step-shot st)

Section: Turns

 Rule 2: player 1 fires when both have fired as often, else player 2.

  bs-to-move : BsState -> Integer
  bs-to-move (st) = if st.p1-shots == st.p2-shots then 1 else 2

 Player p fires at (row, col): the tracking grid is written in place, and a
 shot that brings p's hits to 17 ends the game with p the winner (Rule 4).

  bs-shot-by : BsState, Integer, Integer, Integer -> BsState
  bs-shot-by (st) (p) (row) (col) =
    let track = if p == 1 then bs-shoot (st.p2-ships) (st.p1-tracking) row col else bs-shoot (st.p1-ships) (st.p2-tracking) row col
    in let hits = bs-count-hits track 0 0
    in let won = hits >= bs-total-ship-cells
    in BsState {
         p1-ships = st.p1-ships, p1-tracking = (if p == 1 then track else st.p1-tracking),
         p2-ships = st.p2-ships, p2-tracking = (if p == 1 then st.p2-tracking else track),
         p1-hits = (if p == 1 then hits else st.p1-hits), p2-hits = (if p == 1 then st.p2-hits else hits),
         p1-shots = st.p1-shots + (if p == 1 then 1 else 0), p2-shots = st.p2-shots + (if p == 1 then 0 else 1),
         rng = st.rng, game-over = won, winner = (if won then p else 0) }

 The computer's shot for the player to move.

  bs-step-shot : BsState -> BsState
  bs-step-shot (st) =
    if st.game-over then st
    else let p = bs-to-move st
    in let r = rng-next (st.rng)
    in let idx = bs-ai-pick-shot (if p == 1 then st.p1-tracking else st.p2-tracking) r
    in let s2 = bs-shot-by st p (idx / 10) (idx - idx / 10 * 10)
    in BsState { p1-ships = s2.p1-ships, p1-tracking = s2.p1-tracking, p2-ships = s2.p2-ships, p2-tracking = s2.p2-tracking, p1-hits = s2.p1-hits, p2-hits = s2.p2-hits, p1-shots = s2.p1-shots, p2-shots = s2.p2-shots, rng = r, game-over = s2.game-over, winner = s2.winner }

 Rule 3: ship id of player p's fleet is sunk when every one of its squares
 has been hit.

  bs-sunk : BsState, Integer, Integer -> Boolean
  bs-sunk (st) (p) (id) =
    let ships = if p == 1 then st.p1-ships else st.p2-ships
    in let track = if p == 1 then st.p2-tracking else st.p1-tracking
    in bs-sunk-at ships track id 0

  bs-sunk-at : BsGrid, BsGrid, Integer, Integer -> Boolean
  bs-sunk-at (ships) (track) (id) (i) =
    if i >= 100 then True
    else if list-at (ships.cells) i == id & list-at (track.cells) i /= 2 then False
    else bs-sunk-at ships track id (i + 1)
Section: Formatting

  format-battleship-result : BattleshipResult -> Text
  format-battleship-result (r) =
    let w = if r.winner == 1 then "Player 1 wins"
            else if r.winner == 2 then "Player 2 wins"
            else "nobody"
    in "Battleship: " & w & " P1-shots=" & show (r.p1-shots) & " P2-shots=" & show (r.p2-shots)

