 `go-place-stone` writes the stone with `list-set-at` before it knows
 whether the move is legal, so every placement copies the board first. A
 pass is point -1.

 We say:

Section: Copying

  wasm-exports : Text = ""

  go-copy-board : GoBoard -> GoBoard
  go-copy-board (b) =
    GoBoard {
      stones = go-copy-stones (b.stones) 0 [],
      current-player = b.current-player,
      black-captures = b.black-captures,
      white-captures = b.white-captures,
      passes = b.passes,
      game-over = b.game-over,
      black-score = b.black-score,
      white-score = b.white-score,
      ko-point = b.ko-point,
      seen = b.seen
    }

Section: The Browser Interface

  go-wasm-new : GoBoard
  go-wasm-new = go-new

  go-wasm-cell : GoBoard, Integer -> Integer
  go-wasm-cell (b) (i) =
    if i < 0 then (-1)
    else if i >= 81 then (-1)
    else list-at (b.stones) i

  go-wasm-cur : GoBoard -> Integer
  go-wasm-cur (b) = b.current-player

  go-wasm-captures : GoBoard, Integer -> Integer
  go-wasm-captures (b) (player) =
    if player == 1 then b.black-captures else b.white-captures

  go-wasm-score : GoBoard, Integer -> Integer
  go-wasm-score (b) (player) =
    if player == 1 then b.black-score else b.white-score

  go-wasm-passes : GoBoard -> Integer
  go-wasm-passes (b) = b.passes

  go-wasm-ko : GoBoard -> Integer
  go-wasm-ko (b) = b.ko-point

  go-wasm-done : GoBoard -> Integer
  go-wasm-done (b) = if b.game-over then 1 else 0

  go-wasm-place : GoBoard, Integer -> GoBoard
  go-wasm-place (b) (i) =
    if b.game-over then b
    else if i < 0 then b
    else if i >= 81 then b
    else go-place-stone (go-copy-board b) i

  go-wasm-pass : GoBoard -> GoBoard
  go-wasm-pass (b) =
    if b.game-over then b
    else go-place-stone (go-copy-board b) (-1)

  go-wasm-ai : GoBoard, Integer -> Integer
  go-wasm-ai (b) (seed) =
    if b.game-over then (-1)
    else go-ai-move b (rng-new seed)

  go-wasm-legal : GoBoard, Integer -> Integer
  go-wasm-legal (b) (i) = if go-legal b i then 1 else 0

  go-wasm-area : GoBoard, Integer -> Integer
  go-wasm-area (b) (player) = go-area (b.stones) player

  go-wasm-winner : GoBoard -> Integer
  go-wasm-winner (b) = if b.game-over then go-winner-of (b.stones) else 0

 A position for a grader: points set one at a time (0 empty, 1 black,
 2 white), the side to move, and a seal that makes the position so far the
 whole of the game's record.

  go-wasm-put : GoBoard, Integer, Integer -> GoBoard
  go-wasm-put (b) (i) (v) =
    if i < 0 | i >= 81 | v < 0 | v > 2 then b
    else let c = go-copy-board b
    in __record-set c "stones" (list-set-at (c.stones) i v)

  go-wasm-side : GoBoard, Integer -> GoBoard
  go-wasm-side (b) (p) = __record-set (go-copy-board b) "current-player" p

  go-wasm-seal : GoBoard -> GoBoard
  go-wasm-seal (b) = __record-set (go-copy-board b) "seen" (go-key (b.stones))

  go-wasm-liberties : GoBoard, Integer -> Integer
  go-wasm-liberties (b) (i) =
    if i < 0 then (-1)
    else if i >= 81 then (-1)
    else if list-at (b.stones) i == 0 then (-1)
    else count-liberties (b.stones) i (list-at (b.stones) i)

