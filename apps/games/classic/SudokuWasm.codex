Chapter: SudokuWasm
  cites Games chapter Sudoku
  cites Games chapter Rng
  cites Foreword chapter List

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

  sd-wasm-new : Integer -> SudokuState
  sd-wasm-new (seed) = sudoku-new (rng-new seed)

  sd-wasm-cell : SudokuState, Integer -> Integer
  sd-wasm-cell (st) (i) =
    if i < 0 then (-1)
    else if i >= 81 then (-1)
    else list-at (st.grid) i

  sd-wasm-iterations : SudokuState -> Integer
  sd-wasm-iterations (st) = st.iterations

  sd-wasm-givens : SudokuState -> Integer
  sd-wasm-givens (st) = sudoku-count-givens (st.grid)

  sd-wasm-first-empty : SudokuState -> Integer
  sd-wasm-first-empty (st) = sudoku-find-empty (st.grid) 0

  sd-wasm-valid : SudokuState, Integer, Integer, Integer -> Integer
  sd-wasm-valid (st) (row) (col) (val) =
    if row < 0 then (-1)
    else if row >= 9 then (-1)
    else if col < 0 then (-1)
    else if col >= 9 then (-1)
    else if val < 1 then (-1)
    else if val > 9 then (-1)
    else if sudoku-is-valid (st.grid) row col val then 1
    else 0

  sd-wasm-solve : SudokuState -> SudokuState
  sd-wasm-solve (st) = sudoku-solve st

  sd-wasm-remove : SudokuState, Integer, Integer -> SudokuState
  sd-wasm-remove (st) (seed) (count) =
    if count < 0 then st
    else sudoku-remove-cells st (rng-new seed) count

  sd-wasm-count : SudokuState, Integer -> Integer
  sd-wasm-count (st) (limit) =
    if limit < 1 then 0
    else sudoku-count st limit

Section: Playing By Hand

  sd-set-cell : SudokuState, Integer, Integer -> SudokuState
  sd-set-cell (st) (i) (val) =
    let c = sudoku-copy st
    in SudokuState { grid = list-set-at (c.grid) i val, fixed = c.fixed, iterations = c.iterations }

  sd-on-board : Integer -> Boolean
  sd-on-board (i) =
    if i < 0 then False
    else i < 81

  sd-wasm-place : SudokuState, Integer, Integer -> SudokuState
  sd-wasm-place (st) (i) (val) =
    if sd-on-board i == False then st
    else if sudoku-is-fixed st i then st
    else if val == 0 then sd-set-cell st i 0
    else if sudoku-fits (st.grid) i val then sd-set-cell st i val
    else st

  sd-wasm-fits : SudokuState, Integer, Integer -> Integer
  sd-wasm-fits (st) (i) (val) =
    if sd-on-board i == False then 0
    else if sudoku-is-fixed st i then 0
    else if sudoku-fits (st.grid) i val then 1
    else 0

  sd-wasm-fixed : SudokuState, Integer -> Integer
  sd-wasm-fixed (st) (i) =
    if sd-on-board i == False then (-1)
    else if sudoku-is-fixed st i then 1
    else 0

  sd-wasm-won : SudokuState -> Integer
  sd-wasm-won (st) = if sudoku-won (st.grid) then 1 else 0

Section: Set-up

  sd-wasm-blank : SudokuState
  sd-wasm-blank = SudokuState { grid = sudoku-fill 0 [], fixed = sudoku-fill 0 [], iterations = 0 }

  sd-wasm-put : SudokuState, Integer, Integer -> SudokuState
  sd-wasm-put (st) (i) (val) =
    if sd-on-board i == False then st
    else if val < 0 then st
    else if val > 9 then st
    else sd-set-cell st i val

  sd-wasm-fix : SudokuState, Integer, Integer -> SudokuState
  sd-wasm-fix (st) (i) (val) =
    if sd-on-board i == False then st
    else if val < 1 then st
    else if val > 9 then st
    else let c = sd-set-cell st i val
    in SudokuState { grid = c.grid, fixed = list-set-at (c.fixed) i 1, iterations = c.iterations }

  sd-wasm-empty-count : SudokuState -> Integer
  sd-wasm-empty-count (st) = sd-count-empty (st.grid) 0 0

  sd-count-empty : List Integer, Integer, Integer -> Integer
  sd-count-empty (grid) (i) (acc) =
    if i >= 81 then acc
    else if list-at grid i == 0 then sd-count-empty grid (i + 1) (acc + 1)
    else sd-count-empty grid (i + 1) acc

Section: The Pinned Run

  sd-wasm-run : SudokuResult
  sd-wasm-run = run-sudoku-solve

  sd-wasm-res-solved : SudokuResult -> Integer
  sd-wasm-res-solved (r) = if r.solved then 1 else 0

  sd-wasm-res-iterations : SudokuResult -> Integer
  sd-wasm-res-iterations (r) = r.iterations

  sd-wasm-res-givens : SudokuResult -> Integer
  sd-wasm-res-givens (r) = r.givens

