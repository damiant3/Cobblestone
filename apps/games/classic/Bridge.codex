Chapter: Bridge
  cites Games chapter Rng

 Contract Bridge, 4 players (N/S team 0 vs E/W team 1).
 Standard 52-card deck: suit = card / 13, rank = card mod 13
 (0=2 up to 12=Ace). HCP: A=4, K=3, Q=2, J=1.
 Simplified bidding: count HCP and longest suit, bid accordingly.
 Declarer plays both own hand and dummy. Score for making/defeating.

 We say:

Section: Types

  BridgeHand = record {
    cards : List Integer
  }

  BridgeState = record {
    north   : List Integer,
    south   : List Integer,
    east    : List Integer,
    west    : List Integer,
    trump   : Integer,
    contract : Integer,
    declarer : Integer,
    leader  : Integer,
    turn    : Integer,
    p0      : Integer,
    p1      : Integer,
    p2      : Integer,
    p3      : Integer,
    ns-tricks : Integer,
    ew-tricks : Integer,
    tricks  : Integer,
    done    : Boolean
  }

  BridgeResult = record {
    declarer-team  : Integer,
    contract-level : Integer,
    tricks-made    : Integer,
    score          : Integer
  }

Section: Card Helpers

  br-suit : Integer -> Integer
  br-suit (c) = c / 13

  br-rank : Integer -> Integer
  br-rank (c) = rng-mod c 13

  br-hcp : Integer -> Integer
  br-hcp (c) =
    let r = br-rank c
    in if r == 12 then 4
    else if r == 11 then 3
    else if r == 10 then 2
    else if r == 9  then 1
    else 0

Section: Deck and Shuffle

  br-deck-new : List Integer
  br-deck-new = br-build-deck 0 []

  br-build-deck : Integer, List Integer -> List Integer
  br-build-deck (i) (acc) =
    if i >= 52 then acc
    else br-build-deck (i + 1) (list-push acc i)

  br-shuffle : List Integer, Rng -> List Integer
  br-shuffle (deck) (r) = br-fy deck 51 r

  br-fy : List Integer, Integer, Rng -> List Integer
  br-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in br-fy d3 (i - 1) r2

  br-collect : List Integer, Integer, Integer -> List Integer
  br-collect (deck) (lo) (hi) =
    br-collect-loop deck lo hi []

  br-collect-loop : List Integer, Integer, Integer, List Integer -> List Integer
  br-collect-loop (deck) (lo) (hi) (acc) =
    if lo >= hi then acc
    else br-collect-loop deck (lo + 1) hi (list-push acc (list-at deck lo))

  br-deal : List Integer -> BridgeState
  br-deal (deck) =
    let north = br-collect deck 0 13
    in let east  = br-collect deck 13 26
    in let south = br-collect deck 26 39
    in let west  = br-collect deck 39 52
    in BridgeState { north = north, south = south, east = east, west = west,
                     trump = 4, contract = 1, declarer = 0,
                     leader = 1, turn = 1,
                     p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
                     ns-tricks = 0, ew-tricks = 0, tricks = 0, done = False }

Section: Point Counting

  hand-hcp : List Integer -> Integer
  hand-hcp (cards) =
    hand-hcp-loop cards 0 0

  hand-hcp-loop : List Integer, Integer, Integer -> Integer
  hand-hcp-loop (cards) (i) (acc) =
    if i >= list-length cards then acc
    else hand-hcp-loop cards (i + 1) (acc + br-hcp (list-at cards i))

  count-suit-in-hand : List Integer, Integer -> Integer
  count-suit-in-hand (cards) (s) =
    br-count-suit-loop cards s 0 0

  br-count-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  br-count-suit-loop (cards) (s) (i) (acc) =
    if i >= list-length cards then acc
    else let delta = if br-suit (list-at cards i) == s then 1 else 0
    in br-count-suit-loop cards s (i + 1) (acc + delta)

  longest-suit : List Integer -> Integer
  longest-suit (cards) =
    longest-suit-loop cards 0 0 0

  longest-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  longest-suit-loop (cards) (s) (best-count) (best-suit) =
    if s >= 4 then best-suit
    else let n = count-suit-in-hand cards s
    in if n > best-count then longest-suit-loop cards (s + 1) n s
    else longest-suit-loop cards (s + 1) best-count best-suit

Section: Bidding

  bid-hand : List Integer -> Integer
  bid-hand (cards) =
    let pts = hand-hcp cards
    in let suit = longest-suit cards
    in if pts >= 25 then suit * 10 + 6
    else if pts >= 22 then suit * 10 + 5
    else if pts >= 19 then suit * 10 + 4
    else if pts >= 16 then suit * 10 + 3
    else if pts >= 13 then suit * 10 + 2
    else if pts >= 10 then suit * 10 + 1
    else (-1)

  combine-bids : Integer, Integer -> Integer
  combine-bids (b1) (b2) =
    if b1 < 0 & b2 < 0 then (-1)
    else if b1 < 0 then b2
    else if b2 < 0 then b1
    else let level1 = rng-mod b1 10
    in let level2 = rng-mod b2 10
    in if level1 >= level2 then b1 else b2

  determine-contract : BridgeState -> BridgeState
  determine-contract (st) =
    let ns-bid = combine-bids (bid-hand (st.north)) (bid-hand (st.south))
    in let ew-bid = combine-bids (bid-hand (st.east)) (bid-hand (st.west))
    in let ns-level = if ns-bid < 0 then 0 else rng-mod ns-bid 10
    in let ew-level = if ew-bid < 0 then 0 else rng-mod ew-bid 10
    in if ns-level >= ew-level & ns-bid >= 0 then
      let trump = ns-bid / 10
      in let level = ns-level
      in __record-set (__record-set (__record-set st "trump" trump) "contract" level) "declarer" 0
    else if ew-bid >= 0 then
      let trump = ew-bid / 10
      in let level = ew-level
      in __record-set (__record-set (__record-set st "trump" trump) "contract" level) "declarer" 1
    else __record-set (__record-set st "contract" 1) "declarer" 0

Section: Trick Taking

  card-beats : Integer, Integer, Integer, Integer -> Boolean
  card-beats (challenger) (current-best) (led-suit) (trump) =
    let cs = br-suit challenger
    in let bs = br-suit current-best
    in let cr = br-rank challenger
    in let br-val = br-rank current-best
    in if cs == trump & bs /= trump then True
    else if cs == trump & bs == trump then cr > br-val
    else if cs == bs then cr > br-val
    else False

  remove-at : List Integer, Integer -> List Integer
  remove-at (xs) (idx) =
    remove-at-loop xs idx 0 []

  remove-at-loop : List Integer, Integer, Integer, List Integer -> List Integer
  remove-at-loop (xs) (idx) (i) (acc) =
    if i >= list-length xs then acc
    else if i == idx then remove-at-loop xs idx (i + 1) acc
    else remove-at-loop xs idx (i + 1) (list-push acc (list-at xs i))

 Seats are north 0, south 1, east 2, west 3, which is the order the engine's
 own arguments take and NOT the order round a table. Play passes N to E to S
 to W, so the next seat is a lookup rather than an increment; the teams are
 north with south against east with west.

  br-next-seat : Integer -> Integer
  br-next-seat (s) =
    if s == 0 then 2
    else if s == 2 then 1
    else if s == 1 then 3
    else 0

  br-team : Integer -> Integer
  br-team (s) = if s <= 1 then 0 else 1

  br-hand : BridgeState, Integer -> List Integer
  br-hand (st) (seat) =
    if seat == 0 then st.north
    else if seat == 1 then st.south
    else if seat == 2 then st.east
    else st.west

  br-played : BridgeState, Integer -> Integer
  br-played (st) (seat) =
    if seat == 0 then st.p0
    else if seat == 1 then st.p1
    else if seat == 2 then st.p2
    else st.p3

  br-trick-full : BridgeState -> Boolean
  br-trick-full (st) =
    st.p0 >= 0 & st.p1 >= 0 & st.p2 >= 0 & st.p3 >= 0

  br-led-suit : BridgeState -> Integer
  br-led-suit (st) =
    let c = br-played st (st.leader)
    in if c < 0 then (-1) else br-suit c

  br-best-seat : BridgeState -> Integer
  br-best-seat (st) =
    br-seat-loop st (br-led-suit st) (st.trump) 0 (st.leader)

  br-seat-loop : BridgeState, Integer, Integer, Integer, Integer -> Integer
  br-seat-loop (st) (led) (trump) (seat) (best-seat) =
    if seat >= 4 then best-seat
    else let c = br-played st seat
    in let b = br-played st best-seat
    in if c < 0 then br-seat-loop st led trump (seat + 1) best-seat
    else if card-beats c b led trump then br-seat-loop st led trump (seat + 1) seat
    else br-seat-loop st led trump (seat + 1) best-seat

  br-best-card : BridgeState -> Integer
  br-best-card (st) = br-played st (br-best-seat st)

 Bridge asks one thing of a card and no more: follow the suit that was led
 if you hold it. There is no obligation to trump when void and none to head
 the trick, which is where this differs from the pinochle in the next
 chapter over.

  br-has-suit : List Integer, Integer -> Boolean
  br-has-suit (hand) (s) = br-has-suit-loop hand s 0

  br-has-suit-loop : List Integer, Integer, Integer -> Boolean
  br-has-suit-loop (hand) (s) (i) =
    if i >= list-length hand then False
    else if br-suit (list-at hand i) == s then True
    else br-has-suit-loop hand s (i + 1)

  br-legal : BridgeState, Integer -> Boolean
  br-legal (st) (idx) =
    if st.done then False
    else let hand = br-hand st (st.turn)
    in if idx < 0 then False
    else if idx >= list-length hand then False
    else let led = br-led-suit st
    in if led < 0 then True
    else if br-has-suit hand led then br-suit (list-at hand idx) == led
    else True

  br-key-high : BridgeState, List Integer, Integer -> Integer
  br-key-high (st) (hand) (i) =
    if br-legal st i then br-rank (list-at hand i) else (-1)

  br-key-low : BridgeState, List Integer, Integer -> Integer
  br-key-low (st) (hand) (i) =
    if br-legal st i then 20 - br-rank (list-at hand i) else (-1)

  br-key-win : BridgeState, List Integer, Integer -> Integer
  br-key-win (st) (hand) (i) =
    if br-legal st i then br-key-win-legal st hand i else (-1)

  br-key-win-legal : BridgeState, List Integer, Integer -> Integer
  br-key-win-legal (st) (hand) (i) =
    let c = list-at hand i
    in if card-beats c (br-best-card st) (br-led-suit st) (st.trump) then 20 - br-rank c
    else (-1)

  br-key : BridgeState, List Integer, Integer, Integer -> Integer
  br-key (st) (hand) (kind) (i) =
    if kind == 0 then br-key-high st hand i
    else if kind == 1 then br-key-low st hand i
    else br-key-win st hand i

  br-pick : BridgeState, List Integer, Integer, Integer, Integer, Integer -> Integer
  br-pick (st) (hand) (kind) (i) (best) (best-key) =
    if i >= list-length hand then best
    else let k = br-key st hand kind i
    in if k > best-key then br-pick st hand kind (i + 1) i k
    else br-pick st hand kind (i + 1) best best-key

  br-ai-pick : BridgeState -> Integer
  br-ai-pick (st) =
    let hand = br-hand st (st.turn)
    in if br-led-suit st < 0 then br-pick st hand 0 0 (-1) (-1)
    else let w = br-pick st hand 2 0 (-1) (-1)
    in if w >= 0 then w else br-pick st hand 1 0 (-1) (-1)

 The card that leaves the hand is the card that was played. That it has to
 be said at all is the point: the loop this replaces chose a card per seat
 and then discarded index 0 from all four hands, so the counts stayed right
 for thirteen tricks while the cards leaving were not the cards played.

  br-place : BridgeState, Integer -> BridgeState
  br-place (st) (idx) =
    let seat = st.turn
    in let hand = br-hand st seat
    in let c = list-at hand idx
    in let nh = remove-at hand idx
    in let s2 = BridgeState {
      north = if seat == 0 then nh else st.north,
      south = if seat == 1 then nh else st.south,
      east = if seat == 2 then nh else st.east,
      west = if seat == 3 then nh else st.west,
      trump = st.trump,
      contract = st.contract,
      declarer = st.declarer,
      leader = st.leader,
      turn = br-next-seat seat,
      p0 = if seat == 0 then c else st.p0,
      p1 = if seat == 1 then c else st.p1,
      p2 = if seat == 2 then c else st.p2,
      p3 = if seat == 3 then c else st.p3,
      ns-tricks = st.ns-tricks,
      ew-tricks = st.ew-tricks,
      tricks = st.tricks,
      done = False
    }
    in if br-trick-full s2 then br-resolve s2 else s2

  br-resolve : BridgeState -> BridgeState
  br-resolve (st) =
    let w = br-best-seat st
    in let team = br-team w
    in let over = list-length (st.north) == 0
    in BridgeState {
      north = st.north, south = st.south, east = st.east, west = st.west,
      trump = st.trump,
      contract = st.contract,
      declarer = st.declarer,
      leader = w,
      turn = w,
      p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
      ns-tricks = if team == 0 then st.ns-tricks + 1 else st.ns-tricks,
      ew-tricks = if team == 1 then st.ew-tricks + 1 else st.ew-tricks,
      tricks = st.tricks + 1,
      done = over
    }

  br-play-at : BridgeState, Integer -> BridgeState
  br-play-at (st) (idx) =
    if br-legal st idx then br-place st idx else st

  br-step : BridgeState -> BridgeState
  br-step (st) =
    if st.done then st
    else let idx = br-ai-pick st
    in if idx < 0 then st else br-place st idx

 The opening lead belongs to the side that did not take the contract, and
 the contract is not known until the bidding is over, so the leader is set
 here rather than in `br-deal`.

  br-lead-seat : Integer -> Integer
  br-lead-seat (declarer) = if declarer == 0 then 3 else 1

  br-begin : BridgeState -> BridgeState
  br-begin (st) =
    let ld = br-lead-seat (st.declarer)
    in BridgeState {
      north = st.north, south = st.south, east = st.east, west = st.west,
      trump = st.trump,
      contract = st.contract,
      declarer = st.declarer,
      leader = ld,
      turn = ld,
      p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
      ns-tricks = 0, ew-tricks = 0, tricks = 0, done = False
    }

  br-play-out : BridgeState, Integer -> BridgeState
  br-play-out (st) (fuel) =
    if fuel <= 0 then st
    else if st.done then st
    else br-play-out (br-step st) (fuel - 1)

Section: Scoring

  bridge-score : Integer, Integer, Integer -> Integer
  bridge-score (level) (tricks-made) (trump) =
    let needed = level + 6
    in if tricks-made >= needed then
      let overtricks = tricks-made - needed
      in let per-trick = if trump >= 3 then 30 else 20
      in level * per-trick + overtricks * 50 + if level >= 6 then 500 else 0
    else
      let undertricks = needed - tricks-made
      in -(undertricks * 50)

Section: Game Runner

  run-bridge-hand : Integer -> BridgeResult
  run-bridge-hand (seed) =
    let deck = br-shuffle br-deck-new (rng-new seed)
    in let st0 = br-deal deck
    in let st = br-begin (determine-contract st0)
    in let fin = br-play-out st 60
    in let ns-tricks = fin.ns-tricks
    in let tricks-for-decl = if st.declarer == 0 then ns-tricks else 13 - ns-tricks
    in let score = bridge-score (st.contract) tricks-for-decl (st.trump)
    in let winner = if score >= 0 then st.declarer else 1 - st.declarer
    in BridgeResult { declarer-team = st.declarer, contract-level = st.contract,
                      tricks-made = tricks-for-decl, score = score }

Section: Formatting

  format-bridge-result : BridgeResult -> Text
  format-bridge-result (r) =
    let team = if r.declarer-team == 0 then "NS" else "EW"
    in let outcome = if r.score >= 0 then "made" else "down"
    in "Bridge: " & team & " contract=" & show (r.contract-level) &
       " tricks=" & show (r.tricks-made) & " " & outcome &
       " score=" & show (r.score)

