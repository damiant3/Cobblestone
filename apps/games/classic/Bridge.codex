Chapter: Bridge
  cites Games chapter Rng

 Contract bridge by pagat.com (https://www.pagat.com/auctionwhist/bridge.html),
 one duplicate board: N/S team 0 against E/W team 1. Standard 52-card deck:
 suit = card / 13 (0 spades, 1 hearts, 2 diamonds, 3 clubs), rank = card
 mod 13 (0=2 up to 12=Ace). HCP: A=4, K=3, Q=2, J=1.

 The dealer calls first and the call passes clockwise. A bid names a level
 and a denomination, clubs lowest, then diamonds, hearts, spades, no trumps,
 and must beat the last bid. A seat may double the opponents' last bid if it
 is undoubled, and redouble its own side's bid if the opponents doubled it.
 Three passes after a bid end the auction; four passes at the start pass the
 board out. The declarer is the first of the winning side to have named the
 denomination. The declarer's left leads, the dummy is then exposed, and the
 declarer plays the dummy's cards. Duplicate scoring, with the dealer and
 vulnerability of the board number.

 We say:

Section: Types

  BridgeHand = record {
    cards : List Integer
  }

  BridgeState = record {
    north   : List Integer,
    south   : List Integer,
    east    : List Integer,
    west    : List Integer,
    trump   : Integer,
    contract : Integer,
    declarer : Integer,
    leader  : Integer,
    turn    : Integer,
    p0      : Integer,
    p1      : Integer,
    p2      : Integer,
    p3      : Integer,
    ns-tricks : Integer,
    ew-tricks : Integer,
    tricks  : Integer,
    done    : Boolean
  }

  BridgeResult = record {
    declarer-team  : Integer,
    contract-level : Integer,
    tricks-made    : Integer,
    score          : Integer
  }

Section: Card Helpers

  br-suit : Integer -> Integer
  br-suit (c) = c / 13

  br-rank : Integer -> Integer
  br-rank (c) = rng-mod c 13

  br-hcp : Integer -> Integer
  br-hcp (c) =
    let r = br-rank c
    in if r == 12 then 4
    else if r == 11 then 3
    else if r == 10 then 2
    else if r == 9  then 1
    else 0

Section: Deck and Shuffle

  br-deck-new : List Integer
  br-deck-new = br-build-deck 0 []

  br-build-deck : Integer, List Integer -> List Integer
  br-build-deck (i) (acc) =
    if i >= 52 then acc
    else br-build-deck (i + 1) (list-push acc i)

  br-shuffle : List Integer, Rng -> List Integer
  br-shuffle (deck) (r) = br-fy deck 51 r

  br-fy : List Integer, Integer, Rng -> List Integer
  br-fy (deck) (i) (r) =
    if i <= 0 then deck
    else let r2 = rng-next r
    in let j = rng-mod (rng-value r2) (i + 1)
    in let a = list-at deck i
    in let b = list-at deck j
    in let d2 = list-set-at deck i b
    in let d3 = list-set-at d2 j a
    in br-fy d3 (i - 1) r2

  br-collect : List Integer, Integer, Integer -> List Integer
  br-collect (deck) (lo) (hi) =
    br-collect-loop deck lo hi []

  br-collect-loop : List Integer, Integer, Integer, List Integer -> List Integer
  br-collect-loop (deck) (lo) (hi) (acc) =
    if lo >= hi then acc
    else br-collect-loop deck (lo + 1) hi (list-push acc (list-at deck lo))

  br-deal : List Integer -> BridgeState
  br-deal (deck) =
    let north = br-collect deck 0 13
    in let east  = br-collect deck 13 26
    in let south = br-collect deck 26 39
    in let west  = br-collect deck 39 52
    in BridgeState { north = north, south = south, east = east, west = west,
                     trump = 4, contract = 1, declarer = 0,
                     leader = 1, turn = 1,
                     p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
                     ns-tricks = 0, ew-tricks = 0, tricks = 0, done = False }

Section: Point Counting

  hand-hcp : List Integer -> Integer
  hand-hcp (cards) =
    hand-hcp-loop cards 0 0

  hand-hcp-loop : List Integer, Integer, Integer -> Integer
  hand-hcp-loop (cards) (i) (acc) =
    if i >= list-length cards then acc
    else hand-hcp-loop cards (i + 1) (acc + br-hcp (list-at cards i))

  count-suit-in-hand : List Integer, Integer -> Integer
  count-suit-in-hand (cards) (s) =
    br-count-suit-loop cards s 0 0

  br-count-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  br-count-suit-loop (cards) (s) (i) (acc) =
    if i >= list-length cards then acc
    else let delta = if br-suit (list-at cards i) == s then 1 else 0
    in br-count-suit-loop cards s (i + 1) (acc + delta)

  longest-suit : List Integer -> Integer
  longest-suit (cards) =
    longest-suit-loop cards 0 0 0

  longest-suit-loop : List Integer, Integer, Integer, Integer -> Integer
  longest-suit-loop (cards) (s) (best-count) (best-suit) =
    if s >= 4 then best-suit
    else let n = count-suit-in-hand cards s
    in if n > best-count then longest-suit-loop cards (s + 1) n s
    else longest-suit-loop cards (s + 1) best-count best-suit


Section: Trick Taking

  card-beats : Integer, Integer, Integer, Integer -> Boolean
  card-beats (challenger) (current-best) (led-suit) (trump) =
    let cs = br-suit challenger
    in let bs = br-suit current-best
    in let cr = br-rank challenger
    in let br-val = br-rank current-best
    in if cs == trump & bs /= trump then True
    else if cs == trump & bs == trump then cr > br-val
    else if cs == bs then cr > br-val
    else False

  remove-at : List Integer, Integer -> List Integer
  remove-at (xs) (idx) =
    remove-at-loop xs idx 0 []

  remove-at-loop : List Integer, Integer, Integer, List Integer -> List Integer
  remove-at-loop (xs) (idx) (i) (acc) =
    if i >= list-length xs then acc
    else if i == idx then remove-at-loop xs idx (i + 1) acc
    else remove-at-loop xs idx (i + 1) (list-push acc (list-at xs i))

 Seats are north 0, south 1, east 2, west 3, the engine's argument order and
 not the order round a table. Play passes N to E to S to W, so the next seat
 is a lookup; the teams are north with south against east with west.

  br-next-seat : Integer -> Integer
  br-next-seat (s) =
    if s == 0 then 2
    else if s == 2 then 1
    else if s == 1 then 3
    else 0

  br-team : Integer -> Integer
  br-team (s) = if s <= 1 then 0 else 1

  br-hand : BridgeState, Integer -> List Integer
  br-hand (st) (seat) =
    if seat == 0 then st.north
    else if seat == 1 then st.south
    else if seat == 2 then st.east
    else st.west

  br-played : BridgeState, Integer -> Integer
  br-played (st) (seat) =
    if seat == 0 then st.p0
    else if seat == 1 then st.p1
    else if seat == 2 then st.p2
    else st.p3

  br-trick-full : BridgeState -> Boolean
  br-trick-full (st) =
    st.p0 >= 0 & st.p1 >= 0 & st.p2 >= 0 & st.p3 >= 0

  br-led-suit : BridgeState -> Integer
  br-led-suit (st) =
    let c = br-played st (st.leader)
    in if c < 0 then (-1) else br-suit c

  br-best-seat : BridgeState -> Integer
  br-best-seat (st) =
    br-seat-loop st (br-led-suit st) (st.trump) 0 (st.leader)

  br-seat-loop : BridgeState, Integer, Integer, Integer, Integer -> Integer
  br-seat-loop (st) (led) (trump) (seat) (best-seat) =
    if seat >= 4 then best-seat
    else let c = br-played st seat
    in let b = br-played st best-seat
    in if c < 0 then br-seat-loop st led trump (seat + 1) best-seat
    else if card-beats c b led trump then br-seat-loop st led trump (seat + 1) seat
    else br-seat-loop st led trump (seat + 1) best-seat

  br-best-card : BridgeState -> Integer
  br-best-card (st) = br-played st (br-best-seat st)

 A card must follow the suit led if the hand holds it. There is no
 obligation to trump when void and none to head the trick.

  br-has-suit : List Integer, Integer -> Boolean
  br-has-suit (hand) (s) = br-has-suit-loop hand s 0

  br-has-suit-loop : List Integer, Integer, Integer -> Boolean
  br-has-suit-loop (hand) (s) (i) =
    if i >= list-length hand then False
    else if br-suit (list-at hand i) == s then True
    else br-has-suit-loop hand s (i + 1)

  br-legal : BridgeState, Integer -> Boolean
  br-legal (st) (idx) =
    if st.done then False
    else let hand = br-hand st (st.turn)
    in if idx < 0 then False
    else if idx >= list-length hand then False
    else let led = br-led-suit st
    in if led < 0 then True
    else if br-has-suit hand led then br-suit (list-at hand idx) == led
    else True

  br-key-high : BridgeState, List Integer, Integer -> Integer
  br-key-high (st) (hand) (i) =
    if br-legal st i then br-rank (list-at hand i) else (-1)

  br-key-low : BridgeState, List Integer, Integer -> Integer
  br-key-low (st) (hand) (i) =
    if br-legal st i then 20 - br-rank (list-at hand i) else (-1)

  br-key-win : BridgeState, List Integer, Integer -> Integer
  br-key-win (st) (hand) (i) =
    if br-legal st i then br-key-win-legal st hand i else (-1)

  br-key-win-legal : BridgeState, List Integer, Integer -> Integer
  br-key-win-legal (st) (hand) (i) =
    let c = list-at hand i
    in if card-beats c (br-best-card st) (br-led-suit st) (st.trump) then 20 - br-rank c
    else (-1)

  br-key : BridgeState, List Integer, Integer, Integer -> Integer
  br-key (st) (hand) (kind) (i) =
    if kind == 0 then br-key-high st hand i
    else if kind == 1 then br-key-low st hand i
    else br-key-win st hand i

  br-pick : BridgeState, List Integer, Integer, Integer, Integer, Integer -> Integer
  br-pick (st) (hand) (kind) (i) (best) (best-key) =
    if i >= list-length hand then best
    else let k = br-key st hand kind i
    in if k > best-key then br-pick st hand kind (i + 1) i k
    else br-pick st hand kind (i + 1) best best-key

  br-ai-pick : BridgeState -> Integer
  br-ai-pick (st) =
    let hand = br-hand st (st.turn)
    in if br-led-suit st < 0 then br-pick st hand 0 0 (-1) (-1)
    else let w = br-pick st hand 2 0 (-1) (-1)
    in if w >= 0 then w else br-pick st hand 1 0 (-1) (-1)


  br-place : BridgeState, Integer -> BridgeState
  br-place (st) (idx) =
    let seat = st.turn
    in let hand = br-hand st seat
    in let c = list-at hand idx
    in let nh = remove-at hand idx
    in let s2 = BridgeState {
      north = if seat == 0 then nh else st.north,
      south = if seat == 1 then nh else st.south,
      east = if seat == 2 then nh else st.east,
      west = if seat == 3 then nh else st.west,
      trump = st.trump,
      contract = st.contract,
      declarer = st.declarer,
      leader = st.leader,
      turn = br-next-seat seat,
      p0 = if seat == 0 then c else st.p0,
      p1 = if seat == 1 then c else st.p1,
      p2 = if seat == 2 then c else st.p2,
      p3 = if seat == 3 then c else st.p3,
      ns-tricks = st.ns-tricks,
      ew-tricks = st.ew-tricks,
      tricks = st.tricks,
      done = False
    }
    in if br-trick-full s2 then br-resolve s2 else s2

  br-resolve : BridgeState -> BridgeState
  br-resolve (st) =
    let w = br-best-seat st
    in let team = br-team w
    in let over = list-length (st.north) == 0
    in BridgeState {
      north = st.north, south = st.south, east = st.east, west = st.west,
      trump = st.trump,
      contract = st.contract,
      declarer = st.declarer,
      leader = w,
      turn = w,
      p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
      ns-tricks = if team == 0 then st.ns-tricks + 1 else st.ns-tricks,
      ew-tricks = if team == 1 then st.ew-tricks + 1 else st.ew-tricks,
      tricks = st.tricks + 1,
      done = over
    }

  br-partner : Integer -> Integer
  br-partner (s) =
    if s == 0 then 1
    else if s == 1 then 0
    else if s == 2 then 3
    else 2

  br-with-turn : BridgeState, Integer -> BridgeState
  br-with-turn (st) (seat) =
    BridgeState {
      north = st.north, south = st.south, east = st.east, west = st.west,
      trump = st.trump, contract = st.contract, declarer = st.declarer,
      leader = seat, turn = seat,
      p0 = st.p0, p1 = st.p1, p2 = st.p2, p3 = st.p3,
      ns-tricks = st.ns-tricks, ew-tricks = st.ew-tricks, tricks = st.tricks, done = st.done
    }

Section: The Board

 A duplicate board fixes its dealer and vulnerability by its number: the
 dealer goes North, East, South, West, and the vulnerability runs through
 pagat's sixteen-board table (0 neither, 1 north-south, 2 east-west, 3 both).

  br-board-of : Integer -> Integer
  br-board-of (seed) = 1 + rng-mod ((if seed < 1 then 1 else seed) - 1) 16

  br-board-dealer : Integer -> Integer
  br-board-dealer (board) =
    let k = rng-mod (board - 1) 4
    in if k == 0 then 0 else if k == 1 then 2 else if k == 2 then 1 else 3

  br-board-vul : Integer -> Integer
  br-board-vul (board) = list-at [0, 1, 2, 3, 1, 2, 3, 0, 2, 3, 0, 1, 3, 0, 1, 2] (board - 1)

  br-vulnerable : Integer, Integer -> Boolean
  br-vulnerable (vul) (team) =
    if vul == 3 then True
    else if team == 0 then vul == 1
    else vul == 2

 `phase` is 0 for the auction, 1 for the play and 2 once the board is
 scored or passed out. A call is 0 pass, 1 double, 2 redouble, or a bid
 5 * level + denomination with the denomination 0 clubs to 4 no trumps, so
 a later bid is always a larger number. `calls` holds seat * 100 + call in
 the order made. `score` is north-south's.

  BrTable = record {
    st       : BridgeState,
    phase    : Integer,
    board    : Integer,
    dealer   : Integer,
    vul      : Integer,
    calls    : List Integer,
    last-bid : Integer,
    bidder   : Integer,
    dbl      : Integer,
    passes   : Integer,
    decl     : Integer,
    score    : Integer
  }

  br-new-board : Integer -> BrTable
  br-new-board (seed) =
    let board = br-board-of seed
    in let dealer = br-board-dealer board
    in BrTable { st = br-with-turn (br-deal (br-shuffle br-deck-new (rng-new seed))) dealer,
                 phase = 0, board = board, dealer = dealer, vul = br-board-vul board,
                 calls = [], last-bid = 0, bidder = (-1), dbl = 0, passes = 0,
                 decl = (-1), score = 0 }

  br-strain-suit : Integer -> Integer
  br-strain-suit (strain) = if strain >= 4 then 4 else 3 - strain

Section: The Auction

  br-can-call : BrTable, Integer -> Boolean
  br-can-call (g) (code) =
    let seat = (g.st).turn
    in if g.phase /= 0 then False
    else if code == 0 then True
    else if code == 1 then g.last-bid > 0 & g.dbl == 0 & br-team (g.bidder) /= br-team seat
    else if code == 2 then g.last-bid > 0 & g.dbl == 1 & br-team (g.bidder) == br-team seat
    else if code < 5 then False
    else if code > 39 then False
    else code > g.last-bid

  br-copy : List Integer, Integer, List Integer -> List Integer
  br-copy (xs) (i) (acc) =
    if i >= list-length xs then acc
    else br-copy xs (i + 1) (list-push acc (list-at xs i))

  br-call : BrTable, Integer -> BrTable
  br-call (g) (code) =
    if br-can-call g code == False then g
    else let seat = (g.st).turn
    in let calls = list-push (br-copy (g.calls) 0 []) (seat * 100 + code)
    in let passes = if code == 0 then g.passes + 1 else 0
    in let bid = if code >= 5 then code else g.last-bid
    in let bidder = if code >= 5 then seat else g.bidder
    in let dbl = if code >= 5 then 0 else if code == 0 then g.dbl else code
    in let g2 = BrTable { st = br-with-turn (g.st) (br-next-seat seat), phase = 0,
                          board = g.board, dealer = g.dealer, vul = g.vul, calls = calls,
                          last-bid = bid, bidder = bidder, dbl = dbl, passes = passes,
                          decl = (-1), score = 0 }
    in if bid == 0 & passes >= 4 then br-passed-out g2
    else if bid > 0 & passes >= 3 then br-win-auction g2
    else g2

  br-passed-out : BrTable -> BrTable
  br-passed-out (g) =
    BrTable { st = g.st, phase = 2, board = g.board, dealer = g.dealer, vul = g.vul,
              calls = g.calls, last-bid = 0, bidder = (-1), dbl = 0, passes = g.passes,
              decl = (-1), score = 0 }

  br-first-namer : List Integer, Integer, Integer, Integer, Integer -> Integer
  br-first-namer (calls) (team) (strain) (i) (fallback) =
    if i >= list-length calls then fallback
    else let c = list-at calls i
    in let seat = c / 100
    in let code = rng-mod c 100
    in if code >= 5 & rng-mod code 5 == strain & br-team seat == team then seat
    else br-first-namer calls team strain (i + 1) fallback

  br-win-auction : BrTable -> BrTable
  br-win-auction (g) =
    let strain = rng-mod (g.last-bid) 5
    in let level = g.last-bid / 5
    in let decl = br-first-namer (g.calls) (br-team (g.bidder)) strain 0 (g.bidder)
    in let st = g.st
    in let lead = br-next-seat decl
    in BrTable { st = BridgeState {
                        north = st.north, south = st.south, east = st.east, west = st.west,
                        trump = br-strain-suit strain, contract = level, declarer = br-team decl,
                        leader = lead, turn = lead,
                        p0 = (-1), p1 = (-1), p2 = (-1), p3 = (-1),
                        ns-tricks = 0, ew-tricks = 0, tricks = 0, done = False },
                 phase = 1, board = g.board, dealer = g.dealer, vul = g.vul, calls = g.calls,
                 last-bid = g.last-bid, bidder = g.bidder, dbl = g.dbl, passes = g.passes,
                 decl = decl, score = 0 }

Section: The Other Seats' Calls

 A seat with nothing bid on its side opens 1NT on 15 to 17 balanced and one
 of its longest suit on 12 or more, overcalls a five-card suit at the one or
 two level on 10 or more, and doubles an opposing game on 13. Once partner
 has bid it counts partner at 13 for a suit opening, 16 for no trumps and
 8 for a response, and bids the level their combined points reach in
 partner's suit with three cards of it, else its own five-card suit, else no
 trumps. It never bids over a partner already at that level.

  br-suit-strain : Integer -> Integer
  br-suit-strain (suit) = 3 - suit

  br-balanced : List Integer -> Boolean
  br-balanced (hand) =
    let a = count-suit-in-hand hand 0
    in let b = count-suit-in-hand hand 1
    in let c = count-suit-in-hand hand 2
    in let d = count-suit-in-hand hand 3
    in let twos = (if a == 2 then 1 else 0) + (if b == 2 then 1 else 0) + (if c == 2 then 1 else 0) + (if d == 2 then 1 else 0)
    in if a < 2 | b < 2 | c < 2 | d < 2 then False
    else if a > 5 | b > 5 | c > 5 | d > 5 then False
    else twos <= 1

  br-bid-by : List Integer, Integer, Integer, Integer, Boolean -> Integer
  br-bid-by (calls) (seat) (i) (found) (first) =
    if i >= list-length calls then found
    else let c = list-at calls i
    in let code = rng-mod c 100
    in if c / 100 == seat & code >= 5 & (first == False | found == 0)
      then br-bid-by calls seat (i + 1) code first
    else br-bid-by calls seat (i + 1) found first

  br-ai-call : BrTable -> Integer
  br-ai-call (g) =
    let seat = (g.st).turn
    in let hand = br-hand (g.st) seat
    in let pts = hand-hcp hand
    in let pb = br-bid-by (g.calls) (br-partner seat) 0 0 False
    in let mb = br-bid-by (g.calls) seat 0 0 False
    in let code = if pb > 0 then br-ai-support g hand pts
       else if mb > 0 then 0
       else br-ai-first g hand pts
    in if br-can-call g code then code else 0

  br-ai-first : BrTable, List Integer, Integer -> Integer
  br-ai-first (g) (hand) (pts) =
    let ls = longest-suit hand
    in let s = br-suit-strain ls
    in if g.last-bid == 0 then br-ai-open hand pts s
    else if g.last-bid / 5 >= 4 & pts >= 13 & br-can-call g 1 then 1
    else if pts >= 10 & count-suit-in-hand hand ls >= 5 then br-overcall g s
    else 0

  br-ai-open : List Integer, Integer, Integer -> Integer
  br-ai-open (hand) (pts) (s) =
    if pts >= 15 & pts <= 17 & br-balanced hand then 9
    else if pts >= 12 then 5 + s
    else 0

  br-overcall : BrTable, Integer -> Integer
  br-overcall (g) (s) =
    let lvl = g.last-bid / 5 + (if s > rng-mod (g.last-bid) 5 then 0 else 1)
    in if lvl <= 2 then lvl * 5 + s else 0

  br-ai-support : BrTable, List Integer, Integer -> Integer
  br-ai-support (g) (hand) (pts) =
    let seat = (g.st).turn
    in let first = br-bid-by (g.calls) (br-partner seat) 0 0 True
    in let pb = br-bid-by (g.calls) (br-partner seat) 0 0 False
    in let mine = br-bid-by (g.calls) seat 0 0 True
    in let opened = mine == 0 | first < mine
    in let pe = if opened == False then 8 else if rng-mod first 5 == 4 then 16 else 13
    in let comb = pts + pe
    in let ps = rng-mod pb 5
    in let ls = longest-suit hand
    in let strain = if ps < 4 & count-suit-in-hand hand (br-strain-suit ps) >= 3 then ps
       else if count-suit-in-hand hand ls >= 5 then br-suit-strain ls
       else 4
    in let game = if strain == 4 then 3 else if strain >= 2 then 4 else 5
    in let lvl = if comb >= 37 then 7
       else if comb >= 33 then 6
       else if comb >= 26 then game
       else if comb >= 23 then (if game < 3 then game else 3)
       else if comb >= 20 then 2
       else 0
    in if lvl == 0 then 0
    else if g.bidder == br-partner seat & g.last-bid / 5 >= lvl then 0
    else lvl * 5 + strain

Section: The Play

 The declarer decides for the dummy.

  br-dummy : BrTable -> Integer
  br-dummy (g) = if g.decl < 0 then (-1) else br-partner (g.decl)

  br-who : BrTable -> Integer
  br-who (g) =
    if g.phase == 2 then (-1)
    else if g.phase == 1 & (g.st).turn == br-dummy g then g.decl
    else (g.st).turn

  br-with-st : BrTable, BridgeState -> BrTable
  br-with-st (g) (st) =
    BrTable { st = st, phase = g.phase, board = g.board, dealer = g.dealer, vul = g.vul,
              calls = g.calls, last-bid = g.last-bid, bidder = g.bidder, dbl = g.dbl,
              passes = g.passes, decl = g.decl, score = g.score }

  br-legal-now : BrTable, Integer -> Boolean
  br-legal-now (g) (idx) = if g.phase /= 1 then False else br-legal (g.st) idx

  br-play-card : BrTable, Integer -> BrTable
  br-play-card (g) (idx) =
    if br-legal-now g idx then br-after-play g (br-place (g.st) idx) else g

  br-after-play : BrTable, BridgeState -> BrTable
  br-after-play (g) (st) =
    if st.done then br-score-board (br-with-st g st) else br-with-st g st

  br-step : BrTable -> BrTable
  br-step (g) =
    if g.phase == 0 then br-call g (br-ai-call g)
    else if g.phase == 1 then br-step-play g
    else g

  br-step-play : BrTable -> BrTable
  br-step-play (g) =
    let idx = br-ai-pick (g.st)
    in if idx < 0 then g else br-after-play g (br-place (g.st) idx)

  br-decl-tricks : BrTable -> Integer
  br-decl-tricks (g) =
    if br-team (g.decl) == 0 then (g.st).ns-tricks else (g.st).ew-tricks

  br-score-board : BrTable -> BrTable
  br-score-board (g) =
    let team = br-team (g.decl)
    in let s = br-dup-score (g.last-bid / 5) (rng-mod (g.last-bid) 5) (g.dbl) (br-vulnerable (g.vul) team) (br-decl-tricks g)
    in BrTable { st = g.st, phase = 2, board = g.board, dealer = g.dealer, vul = g.vul,
                 calls = g.calls, last-bid = g.last-bid, bidder = g.bidder, dbl = g.dbl,
                 passes = g.passes, decl = g.decl,
                 score = (if team == 0 then s else 0 - s) }

Section: Duplicate Scoring

 pagat's duplicate table, from the declaring side. Trick values are 20 in
 the minors, 30 in the majors, and 40 then 30 in no trumps, times 2 doubled
 and 4 redoubled. Overtricks are worth a trick undoubled and 100 or 200 a
 trick doubled, not vulnerable or vulnerable, twice that redoubled. Game
 (contract points of 100 or more) is 300 or 500, a part score 50, a small
 slam 500 or 750 and a grand slam 1000 or 1500, and making a doubled or
 redoubled contract earns 50 or 100. Undertricks are 50 or 100 each
 undoubled; doubled, 100, 200, 200, then 300 each not vulnerable, and 200
 then 300 each vulnerable; twice that redoubled.

  br-dup-score : Integer, Integer, Integer, Boolean, Integer -> Integer
  br-dup-score (level) (strain) (dbl) (vul) (tricks) =
    let need = level + 6
    in let mult = if dbl == 2 then 4 else if dbl == 1 then 2 else 1
    in let per = if strain <= 1 then 20 else 30
    in let base = if strain == 4 then 40 + 30 * (level - 1) else per * level
    in let cp = base * mult
    in if tricks >= need then br-made-score level dbl vul cp per (tricks - need)
    else 0 - br-down-score dbl vul (need - tricks)

  br-made-score : Integer, Integer, Boolean, Integer, Integer, Integer -> Integer
  br-made-score (level) (dbl) (vul) (cp) (per) (over) =
    let over-pts = if dbl == 0 then over * per
       else over * (if vul then 200 else 100) * (if dbl == 2 then 2 else 1)
    in let game = if cp >= 100 then (if vul then 500 else 300) else 50
    in let slam = if level == 6 then (if vul then 750 else 500)
       else if level == 7 then (if vul then 1500 else 1000)
       else 0
    in let insult = if dbl == 2 then 100 else if dbl == 1 then 50 else 0
    in cp + over-pts + game + slam + insult

  br-down-score : Integer, Boolean, Integer -> Integer
  br-down-score (dbl) (vul) (u) =
    if dbl == 0 then u * (if vul then 100 else 50)
    else (if dbl == 2 then 2 else 1) * br-doubled-down vul u

  br-doubled-down : Boolean, Integer -> Integer
  br-doubled-down (vul) (u) =
    if vul then 200 + 300 * (u - 1)
    else let second = if u - 1 < 2 then u - 1 else 2
    in let rest = if u - 3 > 0 then u - 3 else 0
    in 100 + 200 * second + 300 * rest

Section: Game Runner

 One board, every seat played by the other seats' rules. The score is the
 declaring side's; a passed-out board has no declarer and scores 0.

  br-run-to-end : BrTable, Integer -> BrTable
  br-run-to-end (g) (fuel) =
    if fuel <= 0 then g
    else if g.phase == 2 then g
    else br-run-to-end (br-step g) (fuel - 1)

  run-bridge-hand : Integer -> BridgeResult
  run-bridge-hand (seed) =
    let fin = br-run-to-end (br-new-board seed) 400
    in if fin.decl < 0 then
      BridgeResult { declarer-team = (-1), contract-level = 0, tricks-made = 0, score = 0 }
    else let team = br-team (fin.decl)
    in BridgeResult { declarer-team = team, contract-level = fin.last-bid / 5,
                      tricks-made = br-decl-tricks fin,
                      score = (if team == 0 then fin.score else 0 - fin.score) }

Section: Formatting

  format-bridge-result : BridgeResult -> Text
  format-bridge-result (r) =
    if r.declarer-team < 0 then "Bridge: passed out"
    else let team = if r.declarer-team == 0 then "NS" else "EW"
    in let outcome = if r.score >= 0 then "made" else "down"
    in "Bridge: " & team & " contract=" & show (r.contract-level) &
       " tricks=" & show (r.tricks-made) & " " & outcome &
       " score=" & show (r.score)

