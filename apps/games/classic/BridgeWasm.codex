Chapter: BridgeWasm
  cites Games chapter Bridge
  cites Games chapter Rng
  cites Foreword chapter List

 Seats are north 0, south 1, east 2, west 3, the engine's argument order
 rather than the order round a table. The person is South. `br-wasm-who` is
 the seat that decides the next call or card: the declarer decides for the
 dummy, so it is South on North's turn when South declares, and North on
 South's turn when North declares.

 We say:

Section: The Board

  wasm-exports : Text = ""

  br-wasm-new : Integer -> BrTable
  br-wasm-new (seed) = br-new-board seed

  br-wasm-board : BrTable -> Integer
  br-wasm-board (g) = g.board

  br-wasm-dealer : BrTable -> Integer
  br-wasm-dealer (g) = g.dealer

  br-wasm-vul : BrTable -> Integer
  br-wasm-vul (g) = g.vul

  br-wasm-phase : BrTable -> Integer
  br-wasm-phase (g) = g.phase

  br-wasm-done : BrTable -> Integer
  br-wasm-done (g) = if g.phase == 2 then 1 else 0

  br-wasm-cur : BrTable -> Integer
  br-wasm-cur (g) = (g.st).turn

  br-wasm-who : BrTable -> Integer
  br-wasm-who (g) = br-who g

  br-wasm-step : BrTable -> BrTable
  br-wasm-step (g) = br-step g

Section: The Auction

  br-wasm-ncalls : BrTable -> Integer
  br-wasm-ncalls (g) = list-length (g.calls)

  br-wasm-call-at : BrTable, Integer -> Integer
  br-wasm-call-at (g) (i) =
    if i < 0 then (-1)
    else if i >= list-length (g.calls) then (-1)
    else list-at (g.calls) i

  br-wasm-last-bid : BrTable -> Integer
  br-wasm-last-bid (g) = g.last-bid

  br-wasm-bidder : BrTable -> Integer
  br-wasm-bidder (g) = g.bidder

  br-wasm-dbl : BrTable -> Integer
  br-wasm-dbl (g) = g.dbl

  br-wasm-can-call : BrTable, Integer -> Integer
  br-wasm-can-call (g) (code) = if br-can-call g code then 1 else 0

  br-wasm-call : BrTable, Integer -> BrTable
  br-wasm-call (g) (code) = br-call g code

  br-wasm-decl : BrTable -> Integer
  br-wasm-decl (g) = g.decl

  br-wasm-level : BrTable -> Integer
  br-wasm-level (g) = if g.decl < 0 then 0 else g.last-bid / 5

  br-wasm-strain : BrTable -> Integer
  br-wasm-strain (g) = if g.decl < 0 then (-1) else rng-mod (g.last-bid) 5

  br-wasm-trump : BrTable -> Integer
  br-wasm-trump (g) = (g.st).trump

Section: The Hands

  br-wasm-count : BrTable, Integer -> Integer
  br-wasm-count (g) (seat) =
    if seat < 0 then 0
    else if seat > 3 then 0
    else list-length (br-hand (g.st) seat)

  br-wasm-card : BrTable, Integer, Integer -> Integer
  br-wasm-card (g) (seat) (i) =
    if seat < 0 then (-1)
    else if seat > 3 then (-1)
    else if i < 0 then (-1)
    else if i >= br-wasm-count g seat then (-1)
    else list-at (br-hand (g.st) seat) i

 What South may see: its own hand, and the dummy once the opening lead is
 on the table.

  br-wasm-shown : BrTable, Integer, Integer -> Integer
  br-wasm-shown (g) (seat) (i) =
    if seat == 1 then br-wasm-card g seat i
    else if g.phase /= 1 then (-1)
    else if seat /= br-dummy g then (-1)
    else if (g.st).tricks == 0 & br-played (g.st) ((g.st).leader) < 0 then (-1)
    else br-wasm-card g seat i

  br-wasm-hcp : BrTable, Integer -> Integer
  br-wasm-hcp (g) (seat) =
    if seat < 0 then 0
    else if seat > 3 then 0
    else hand-hcp (br-hand (g.st) seat)

Section: The Play

  br-wasm-leader : BrTable -> Integer
  br-wasm-leader (g) = (g.st).leader

  br-wasm-trick : BrTable, Integer -> Integer
  br-wasm-trick (g) (seat) =
    if seat < 0 then (-1)
    else if seat > 3 then (-1)
    else br-played (g.st) seat

  br-wasm-legal : BrTable, Integer -> Integer
  br-wasm-legal (g) (idx) = if br-legal-now g idx then 1 else 0

  br-wasm-play : BrTable, Integer -> BrTable
  br-wasm-play (g) (idx) = br-play-card g idx

  br-wasm-tricks : BrTable -> Integer
  br-wasm-tricks (g) = (g.st).tricks

  br-wasm-nstricks : BrTable -> Integer
  br-wasm-nstricks (g) = (g.st).ns-tricks

  br-wasm-ewtricks : BrTable -> Integer
  br-wasm-ewtricks (g) = (g.st).ew-tricks

  br-wasm-tricks-made : BrTable -> Integer
  br-wasm-tricks-made (g) = if g.decl < 0 then 0 else br-decl-tricks g

  br-wasm-score : BrTable -> Integer
  br-wasm-score (g) = g.score

Section: Cards And The Score Table

  br-wasm-card-suit : Integer -> Integer
  br-wasm-card-suit (c) = if c < 0 then (-1) else br-suit c

  br-wasm-card-rank : Integer -> Integer
  br-wasm-card-rank (c) = if c < 0 then (-1) else br-rank c

  br-wasm-card-hcp : Integer -> Integer
  br-wasm-card-hcp (c) = if c < 0 then (-1) else br-hcp c

  br-wasm-beats : Integer, Integer, Integer, Integer -> Integer
  br-wasm-beats (challenger) (best) (led-suit) (trump) =
    if card-beats challenger best led-suit trump then 1 else 0

  br-wasm-dup-score : Integer, Integer, Integer, Integer, Integer -> Integer
  br-wasm-dup-score (level) (strain) (dbl) (vul) (tricks) =
    br-dup-score level strain dbl (vul == 1) tricks

Section: The Session

  br-wasm-run : Integer -> BridgeResult
  br-wasm-run (seed) = run-bridge-hand seed

  br-wasm-run-team : BridgeResult -> Integer
  br-wasm-run-team (r) = r.declarer-team

  br-wasm-run-level : BridgeResult -> Integer
  br-wasm-run-level (r) = r.contract-level

  br-wasm-run-tricks : BridgeResult -> Integer
  br-wasm-run-tricks (r) = r.tricks-made

  br-wasm-run-score : BridgeResult -> Integer
  br-wasm-run-score (r) = r.score

