Chapter: BridgeWasm
  cites Games chapter Bridge
  cites Games chapter Rng
  cites Foreword chapter List

 A play builds a fresh hand through `remove-at` and a fresh record, so no
 copy is needed. `determine-contract` writes in place through
 `__record-set`, so it runs only on the state `br-wasm-new` has just built.

 Seats are north 0, south 1, east 2, west 3, the engine's argument order
 rather than the order round a table.

 The person is South. The opening lead belongs to the declarer's left, so
 `br-wasm-new` plays the seats ahead of South before it answers. The engine
 plays North, and no dummy is modelled.

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

  br-wasm-new : Integer -> BridgeState
  br-wasm-new (seed) =
    let deck = br-shuffle br-deck-new (rng-new seed)
    in br-to-human (br-begin (determine-contract (br-deal deck))) 4

  br-to-human : BridgeState, Integer -> BridgeState
  br-to-human (st) (fuel) =
    if fuel <= 0 then st
    else if st.done then st
    else if st.turn == 1 then st
    else br-to-human (br-step st) (fuel - 1)

  br-wasm-hand : BridgeState, Integer -> List Integer
  br-wasm-hand (st) (seat) =
    if seat == 0 then st.north
    else if seat == 1 then st.south
    else if seat == 2 then st.east
    else st.west

  br-wasm-count : BridgeState, Integer -> Integer
  br-wasm-count (st) (seat) =
    if seat < 0 then 0
    else if seat > 3 then 0
    else list-length (br-wasm-hand st seat)

  br-wasm-card : BridgeState, Integer, Integer -> Integer
  br-wasm-card (st) (seat) (i) =
    if seat < 0 then (-1)
    else if seat > 3 then (-1)
    else if i < 0 then (-1)
    else if i >= br-wasm-count st seat then (-1)
    else list-at (br-wasm-hand st seat) i

  br-wasm-hcp : BridgeState, Integer -> Integer
  br-wasm-hcp (st) (seat) =
    if seat < 0 then 0
    else if seat > 3 then 0
    else hand-hcp (br-wasm-hand st seat)

  br-wasm-trump : BridgeState -> Integer
  br-wasm-trump (st) = st.trump

  br-wasm-contract : BridgeState -> Integer
  br-wasm-contract (st) = st.contract

  br-wasm-declarer : BridgeState -> Integer
  br-wasm-declarer (st) = st.declarer

  br-wasm-nstricks : BridgeState -> Integer
  br-wasm-nstricks (st) = st.ns-tricks

  br-wasm-ewtricks : BridgeState -> Integer
  br-wasm-ewtricks (st) = st.ew-tricks

 The tricks the declarer has taken so far, not a projection over the whole
 hand.

  br-wasm-tricks-made : BridgeState -> Integer
  br-wasm-tricks-made (st) =
    if st.declarer == 0 then st.ns-tricks else st.ew-tricks

  br-wasm-cur : BridgeState -> Integer
  br-wasm-cur (st) = st.turn

  br-wasm-leader : BridgeState -> Integer
  br-wasm-leader (st) = st.leader

  br-wasm-trick : BridgeState, Integer -> Integer
  br-wasm-trick (st) (seat) =
    if seat < 0 then (-1)
    else if seat > 3 then (-1)
    else br-played st seat

  br-wasm-legal : BridgeState, Integer -> Integer
  br-wasm-legal (st) (idx) = if br-legal st idx then 1 else 0

  br-wasm-play : BridgeState, Integer -> BridgeState
  br-wasm-play (st) (idx) = br-play-at st idx

  br-wasm-step : BridgeState -> BridgeState
  br-wasm-step (st) = br-step st

  br-wasm-done : BridgeState -> Integer
  br-wasm-done (st) = if st.done then 1 else 0

  br-wasm-tricks : BridgeState -> Integer
  br-wasm-tricks (st) = st.tricks

  br-wasm-score : BridgeState -> Integer
  br-wasm-score (st) =
    bridge-score (st.contract) (br-wasm-tricks-made st) (st.trump)

  br-wasm-card-suit : Integer -> Integer
  br-wasm-card-suit (c) = if c < 0 then (-1) else br-suit c

  br-wasm-card-rank : Integer -> Integer
  br-wasm-card-rank (c) = if c < 0 then (-1) else br-rank c

  br-wasm-card-hcp : Integer -> Integer
  br-wasm-card-hcp (c) = if c < 0 then (-1) else br-hcp c

  br-wasm-beats : Integer, Integer, Integer, Integer -> Integer
  br-wasm-beats (challenger) (best) (led-suit) (trump) =
    if card-beats challenger best led-suit trump then 1 else 0

