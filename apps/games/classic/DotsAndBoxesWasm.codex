Chapter: DotsAndBoxesWasm
  cites Games chapter DotsAndBoxes
  cites Foreword chapter List

 `dots-place` writes the edge through `list-set-at`, so `dt-wasm-place`
 copies first. `dots-find-completing-move` sets a candidate edge on the
 caller's own list and sets it back, which is safe only while the restore
 always happens.

 We say:

Section: Copying

  wasm-exports : Text = ""

  dt-copy-list : List Integer, Integer, Integer, List Integer -> List Integer
  dt-copy-list (src) (i) (n) (acc) =
    if i >= n then acc
    else dt-copy-list src (i + 1) n (list-push acc (list-at src i))

  dt-copy-board : DotsBoard -> DotsBoard
  dt-copy-board (b) =
    DotsBoard {
      edges = dt-copy-list (b.edges) 0 24 [],
      boxes = dt-copy-list (b.boxes) 0 9 [],
      current-player = b.current-player,
      p1-score = b.p1-score,
      p2-score = b.p2-score,
      moves-made = b.moves-made,
      rng = b.rng
    }

Section: The Browser Interface

  dt-wasm-new : Integer -> DotsBoard
  dt-wasm-new (seed) = dots-new (rng-new seed)

  dt-wasm-edge : DotsBoard, Integer -> Integer
  dt-wasm-edge (b) (i) =
    if i < 0 then (-1)
    else if i >= 24 then (-1)
    else list-at (b.edges) i

  dt-wasm-box : DotsBoard, Integer -> Integer
  dt-wasm-box (b) (i) =
    if i < 0 then (-1)
    else if i >= 9 then (-1)
    else list-at (b.boxes) i

  dt-wasm-cur : DotsBoard -> Integer
  dt-wasm-cur (b) = b.current-player

  dt-wasm-score : DotsBoard, Integer -> Integer
  dt-wasm-score (b) (player) =
    if player == 1 then b.p1-score else b.p2-score

  dt-wasm-moves : DotsBoard -> Integer
  dt-wasm-moves (b) = b.moves-made

  dt-wasm-done : DotsBoard -> Integer
  dt-wasm-done (b) = if dots-all-placed (b.edges) then 1 else 0

  dt-wasm-can : DotsBoard, Integer -> Integer
  dt-wasm-can (b) (i) =
    if i < 0 then 0
    else if i >= 24 then 0
    else if list-at (b.edges) i /= 0 then 0
    else 1

  dt-wasm-place : DotsBoard, Integer -> DotsBoard
  dt-wasm-place (b) (i) =
    if dt-wasm-can b i == 0 then b
    else dots-place (dt-copy-board b) i

  dt-wasm-ai : DotsBoard -> Integer
  dt-wasm-ai (b) =
    if dots-all-placed (b.edges) then (-1)
    else dots-ai-move b

