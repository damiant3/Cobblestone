 We say:

Section: The Card

  wasm-exports : Text = ""

  sg-wasm-number : Integer -> Integer
  sg-wasm-number (id) =
    if id < 0 then (-1)
    else if id >= 81 then (-1)
    else let c = set-card-from-id id
    in c.number

  sg-wasm-shading : Integer -> Integer
  sg-wasm-shading (id) =
    if id < 0 then (-1)
    else if id >= 81 then (-1)
    else let c = set-card-from-id id
    in c.shading

  sg-wasm-color : Integer -> Integer
  sg-wasm-color (id) =
    if id < 0 then (-1)
    else if id >= 81 then (-1)
    else let c = set-card-from-id id
    in c.color

  sg-wasm-shape : Integer -> Integer
  sg-wasm-shape (id) =
    if id < 0 then (-1)
    else if id >= 81 then (-1)
    else let c = set-card-from-id id
    in c.shape

  sg-wasm-valid : Integer, Integer, Integer -> Integer
  sg-wasm-valid (a) (b) (c) =
    if a < 0 then (-1)
    else if a >= 81 then (-1)
    else if b < 0 then (-1)
    else if b >= 81 then (-1)
    else if c < 0 then (-1)
    else if c >= 81 then (-1)
    else if is-valid-set (set-card-from-id a) (set-card-from-id b) (set-card-from-id c) then 1
    else 0

Section: The Browser Interface

  sg-wasm-new : Integer -> SetGameState
  sg-wasm-new (seed) = set-game-new seed

  sg-wasm-tableau : SetGameState, Integer -> Integer
  sg-wasm-tableau (s) (i) =
    if i < 0 then (-1)
    else if i >= list-length (s.tableau) then (-1)
    else list-at (s.tableau) i

  sg-wasm-tableau-size : SetGameState -> Integer
  sg-wasm-tableau-size (s) = list-length (s.tableau)

  sg-wasm-deck : SetGameState, Integer -> Integer
  sg-wasm-deck (s) (i) =
    if i < 0 then (-1)
    else if i >= list-length (s.deck) then (-1)
    else list-at (s.deck) i

  sg-wasm-deck-size : SetGameState -> Integer
  sg-wasm-deck-size (s) = list-length (s.deck)

  sg-wasm-found : SetGameState -> Integer
  sg-wasm-found (s) = s.found

  sg-wasm-sets-here : SetGameState -> Integer
  sg-wasm-sets-here (s) = find-all-sets (s.tableau)

Section: Playing By Hand

 `sg-wasm-valid` takes card ids; everything below takes tableau indices. An
 index passed as an id is silently a different card, not an error.

  sg-wasm-can-take : SetGameState, Integer, Integer, Integer -> Integer
  sg-wasm-can-take (s) (i) (j) (k) =
    let n = list-length (s.tableau)
    in if i < 0 then 0
    else if j < 0 then 0
    else if k < 0 then 0
    else if i >= n then 0
    else if j >= n then 0
    else if k >= n then 0
    else if i == j then 0
    else if i == k then 0
    else if j == k then 0
    else let a = set-card-from-id (list-at (s.tableau) i)
    in let b = set-card-from-id (list-at (s.tableau) j)
    in let c = set-card-from-id (list-at (s.tableau) k)
    in if is-valid-set a b c then 1 else 0

 A taken set is refilled from the deck up to twelve cards; a short deck
 leaves a smaller table.

  sg-keep-rest : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  sg-keep-rest (tab) (i) (j) (k) (n) (acc) =
    if n >= list-length tab then acc
    else if n == i then sg-keep-rest tab i j k (n + 1) acc
    else if n == j then sg-keep-rest tab i j k (n + 1) acc
    else if n == k then sg-keep-rest tab i j k (n + 1) acc
    else sg-keep-rest tab i j k (n + 1) (list-push acc (list-at tab n))

  sg-refill : List Integer, List Integer, Integer, Integer -> List Integer
  sg-refill (tab) (deck) (i) (n) =
    if i >= n then tab
    else sg-refill (list-push tab (list-at deck i)) deck (i + 1) n

  sg-wasm-take : SetGameState, Integer, Integer, Integer -> SetGameState
  sg-wasm-take (s) (i) (j) (k) =
    if sg-wasm-can-take s i j k == 0 then s
    else let kept = sg-keep-rest (s.tableau) i j k 0 []
    in let want = 12 - list-length kept
    in let have = list-length (s.deck)
    in let take-n = if have < want then have else want
    in let filled = sg-refill kept (s.deck) 0 take-n
    in let rest = set-drop (s.deck) take-n have []
    in SetGameState { deck = rest, tableau = filled, found = s.found + 1, seed = s.seed }

 A found set is `i * 10000 + j * 100 + k`, and -1 when the table holds none.
 The game ends with no set on the table and nothing left to deal.

  sg-wasm-find : SetGameState -> Integer
  sg-wasm-find (s) = sg-find-i s 0

  sg-find-i : SetGameState, Integer -> Integer
  sg-find-i (s) (i) =
    if i >= list-length (s.tableau) then (-1)
    else let m = sg-find-j s i (i + 1)
    in if m >= 0 then m
    else sg-find-i s (i + 1)

  sg-find-j : SetGameState, Integer, Integer -> Integer
  sg-find-j (s) (i) (j) =
    if j >= list-length (s.tableau) then (-1)
    else let m = sg-find-k s i j (j + 1)
    in if m >= 0 then m
    else sg-find-j s i (j + 1)

  sg-find-k : SetGameState, Integer, Integer, Integer -> Integer
  sg-find-k (s) (i) (j) (k) =
    if k >= list-length (s.tableau) then (-1)
    else if sg-wasm-can-take s i j k == 1 then i * 10000 + j * 100 + k
    else sg-find-k s i j (k + 1)

  sg-wasm-find-i : Integer -> Integer
  sg-wasm-find-i (code) = if code < 0 then (-1) else code / 10000

  sg-wasm-find-j : Integer -> Integer
  sg-wasm-find-j (code) = if code < 0 then (-1) else rng-mod (code / 100) 100

  sg-wasm-find-k : Integer -> Integer
  sg-wasm-find-k (code) = if code < 0 then (-1) else rng-mod code 100

 When no set is on the table, three more cards are dealt. A set taken from a
 table of fifteen leaves twelve, and the table stays at twelve.

  sg-wasm-can-deal : SetGameState -> Integer
  sg-wasm-can-deal (s) =
    if list-length (s.deck) == 0 then 0
    else if sg-wasm-find s >= 0 then 0
    else 1

  sg-wasm-deal : SetGameState -> SetGameState
  sg-wasm-deal (s) =
    if sg-wasm-can-deal s == 0 then s
    else let have = list-length (s.deck)
    in let take-n = if have < 3 then have else 3
    in let copy = set-take (s.tableau) 0 (list-length (s.tableau)) []
    in let grown = sg-refill copy (s.deck) 0 take-n
    in let rest = set-drop (s.deck) take-n have []
    in SetGameState { deck = rest, tableau = grown, found = s.found, seed = s.seed }

  sg-wasm-step : SetGameState -> SetGameState
  sg-wasm-step (s) =
    let m = sg-wasm-find s
    in if m >= 0 then sg-wasm-take s (m / 10000) (rng-mod (m / 100) 100) (rng-mod m 100)
    else sg-wasm-deal s

  sg-wasm-run : Integer -> Integer
  sg-wasm-run (seed) = run-set-game seed

