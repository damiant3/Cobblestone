  cites Games chapter Rng
  cites Foreword chapter List

 The browser interface for the poker variants, on the handle contract in
 games-backlog.md GAME-11.

 A variant arrives as an index rather than as a constructor, because the
 page and the grader both speak integers. The order is the one
 `run-poker-variant` matches in.

 We say:

Section: Variant Selection

  pvw-variant : Integer -> PokerVariant
  pvw-variant (i) =
    if i == 0 then FiveCardDraw
    else if i == 1 then FiveCardStud
    else if i == 2 then SevenCardStud
    else if i == 3 then Baseball
    else if i == 4 then HiChicago
    else if i == 5 then LowChicago
    else if i == 6 then FollowTheQueen
    else JacksOrBetter

Section: The Browser Interface

  pvw-wasm-run : Integer, Integer, Integer -> PokerSession
  pvw-wasm-run (variant) (seed) (players) =
    run-poker-variant (pvw-variant variant) seed players

  pvw-wasm-winner : PokerSession -> Integer
  pvw-wasm-winner (s) = s.winner

  pvw-wasm-p1 : PokerSession -> Integer
  pvw-wasm-p1 (s) = s.p1-hand-rank

  pvw-wasm-p2 : PokerSession -> Integer
  pvw-wasm-p2 (s) = s.p2-hand-rank

  pvw-wasm-played : PokerSession -> Integer
  pvw-wasm-played (s) = s.hands-played

  pvw-wasm-special : PokerSession -> Integer
  pvw-wasm-special (s) = s.special-winner

  pvw-wasm-players : PokerSession -> Integer
  pvw-wasm-players (s) = s.num-players

Section: A Table You Can Sit At

 `pvw-wasm-run` above is the watch-only session and stays what it was: it
 deals both hands and compares them, which is not a game anybody can sit
 down to. This is the same eight variants with chips in front of them.

 You are seat 0. A click index is a position in YOUR hand, and it marks a
 card for the draw rather than playing it, which only five card draw ever
 offers.

  pvt-wasm-new : Integer, Integer -> PvTable
  pvt-wasm-new (variant) (seed) = pvt-new variant seed

  pvt-wasm-variant : PvTable -> Integer
  pvt-wasm-variant (p) = p.variant

  pvt-wasm-hand-size : PvTable -> Integer
  pvt-wasm-hand-size (p) = pvt-cards-per-hand (p.variant)

  pvt-wasm-card : PvTable, Integer, Integer -> Integer
  pvt-wasm-card (p) (who) (i) =
    if who < 0 then (-1)
    else if who > 1 then (-1)
    else if i < 0 then (-1)
    else if i >= list-length (pk-hand-of (p.table) who) then (-1)
    else list-at (pk-hand-of (p.table) who) i

 The opponent's cards are theirs until the hand is over. A page that could
 read them all along would be a page you could not lose at.

  pvt-wasm-shown : PvTable, Integer, Integer -> Integer
  pvt-wasm-shown (p) (who) (i) =
    if who == 0 then pvt-wasm-card p 0 i
    else if (p.table).done then pvt-wasm-card p 1 i
    else (-1)

  pvt-wasm-rank : PvTable, Integer -> Integer
  pvt-wasm-rank (p) (who) =
    if who == 0 then (pvt-eval p 0).rank
    else if (p.table).done then (pvt-eval p 1).rank
    else (-1)

  pvt-wasm-chips : PvTable, Integer -> Integer
  pvt-wasm-chips (p) (who) = pk-chips-of (p.table) who

  pvt-wasm-bet : PvTable, Integer -> Integer
  pvt-wasm-bet (p) (who) = pk-bet-of (p.table) who

  pvt-wasm-pot : PvTable -> Integer
  pvt-wasm-pot (p) = (p.table).pot

  pvt-wasm-tocall : PvTable, Integer -> Integer
  pvt-wasm-tocall (p) (who) = pk-to-call (p.table) who

  pvt-wasm-stage : PvTable -> Integer
  pvt-wasm-stage (p) = (p.table).stage

  pvt-wasm-cur : PvTable -> Integer
  pvt-wasm-cur (p) = (p.table).turn

  pvt-wasm-done : PvTable -> Integer
  pvt-wasm-done (p) = if (p.table).done then 1 else 0

  pvt-wasm-winner : PvTable -> Integer
  pvt-wasm-winner (p) = (p.table).winner

  pvt-wasm-folded : PvTable -> Integer
  pvt-wasm-folded (p) = (p.table).folded

  pvt-wasm-last : PvTable -> Integer
  pvt-wasm-last (p) = (p.table).last

 The spade in the hole, which decides a side pot in the Chicagos and is
 nought everywhere else. It is not settled until the showdown.

  pvt-wasm-spade : PvTable -> Integer
  pvt-wasm-spade (p) = p.spade

 Which rank is wild, so a page can say so rather than leaving a visitor to
 work out why three of a kind beat a flush. -1 when nothing is wild.

  pvt-wasm-wild-at : PvTable, Integer -> Integer
  pvt-wasm-wild-at (p) (card) =
    if pvt-has-wilds (p.variant) == False then 0
    else if card < 0 then 0
    else if card >= 52 then 0
    else if list-at (p.wilds) card then 1 else 0

  pvt-wasm-can-fold : PvTable -> Integer
  pvt-wasm-can-fold (p) = if pk-can-fold (p.table) 0 then 1 else 0

  pvt-wasm-can-call : PvTable -> Integer
  pvt-wasm-can-call (p) = if pk-can-call (p.table) 0 then 1 else 0

  pvt-wasm-can-raise : PvTable -> Integer
  pvt-wasm-can-raise (p) = if pvt-can-raise p 0 then 1 else 0

  pvt-wasm-can-open : PvTable -> Integer
  pvt-wasm-can-open (p) = if pvt-can-open p 0 then 1 else 0

  pvt-wasm-can-draw : PvTable -> Integer
  pvt-wasm-can-draw (p) = if pvt-can-draw p 0 then 1 else 0

  pvt-wasm-fold : PvTable -> PvTable
  pvt-wasm-fold (p) = pvt-fold p 0

  pvt-wasm-call : PvTable -> PvTable
  pvt-wasm-call (p) = pvt-call p 0

  pvt-wasm-raise : PvTable -> PvTable
  pvt-wasm-raise (p) = pvt-raise p 0

  pvt-wasm-mark : PvTable, Integer -> PvTable
  pvt-wasm-mark (p) (i) = pvt-mark p i

  pvt-wasm-clear : PvTable -> PvTable
  pvt-wasm-clear (p) = pvt-clear-marks p

  pvt-wasm-draw : PvTable -> PvTable
  pvt-wasm-draw (p) = pvt-draw p

  pvt-wasm-marked : PvTable, Integer -> Integer
  pvt-wasm-marked (p) (i) =
    if i < 0 then 0 else if i >= 5 then 0 else pk-bit ((p.table).marked) i

  pvt-wasm-can-mark : PvTable, Integer -> Integer
  pvt-wasm-can-mark (p) (i) = if pvt-can-mark p i then 1 else 0

  pvt-wasm-step : PvTable -> PvTable
  pvt-wasm-step (p) = pvt-ai-move p

Section: Best Five of Seven

  pvw-seven : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pvw-seven (a) (b) (c) (d) (e) (f) (g) =
    list-push (list-push (list-push (list-push (list-push (list-push (list-push [] a) b) c) d) e) f) g

  pvw-wasm-best5 : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> HandRank
  pvw-wasm-best5 (a) (b) (c) (d) (e) (f) (g) =
    evaluate-hand (pv-best-5-of-7 (pvw-seven a b c d e f g))

  pvw-wasm-best5-card : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pvw-wasm-best5-card (a) (b) (c) (d) (e) (f) (g) =
    let h = pv-best-5-of-7 (pvw-seven a b c d e f g)
    in h.cards

  pvw-wasm-card-at : List Integer, Integer -> Integer
  pvw-wasm-card-at (cards) (i) =
    if i < 0 then (-1)
    else if i >= list-length cards then (-1)
    else list-at cards i

Section: Judging a Choice by the Engine's Own Comparator

 Whether the best five of seven is the BEST five is decidable without a
 second evaluator: the chosen hand must beat or tie all twenty-one
 subsets under the same comparison the game itself uses. These two
 exports are what let a grader ask that question.

  pvw-wasm-eval5 : Integer, Integer, Integer, Integer, Integer -> HandRank
  pvw-wasm-eval5 (a) (b) (c) (d) (e) =
    evaluate-hand (PokerHand { cards = pvw-five a b c d e })

  pvw-wasm-cmp : HandRank, HandRank -> Integer
  pvw-wasm-cmp (a) (b) = compare-hands a b

  pvw-wasm-rank : HandRank -> Integer
  pvw-wasm-rank (h) = h.rank

Section: Wild Cards

  pvw-five : Integer, Integer, Integer, Integer, Integer -> List Integer
  pvw-five (a) (b) (c) (d) (e) =
    list-push (list-push (list-push (list-push (list-push [] a) b) c) d) e

  pvw-wasm-wild-rank : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  pvw-wasm-wild-rank (a) (b) (c) (d) (e) (wild-rank) =
    let hand = PokerHand { cards = pvw-five a b c d e }
    in let wilds = pv-build-rank-wilds (list-push [] wild-rank)
    in let hr = pv-evaluate-with-wilds hand wilds
    in hr.rank

  pvw-wasm-wild-count : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  pvw-wasm-wild-count (a) (b) (c) (d) (e) (wild-rank) =
    pv-count-wilds-in-hand (pvw-five a b c d e) (pv-build-rank-wilds (list-push [] wild-rank))

