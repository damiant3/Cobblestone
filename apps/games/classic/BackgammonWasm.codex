Chapter: BackgammonWasm
  cites Games chapter Backgammon
  cites Games chapter Rng
  cites Foreword chapter List

 The engine applies one die at a time and does not change hands: a turn is
 one move per die, four on a double, then the end of the turn.

 The dice still in hand cross the boundary packed as base-8 digits, the
 first die lowest: [3, 5] is 3 + 5 * 8, and 0 is no dice. A move names its
 start as a point index, or 24 for the bar.

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

  bg-wasm-new : BackgammonBoard
  bg-wasm-new = backgammon-new

  bg-wasm-die : Integer -> Integer
  bg-wasm-die (seed) = rng-range (rng-new seed) 1 6

  bg-wasm-endturn : BackgammonBoard -> BackgammonBoard
  bg-wasm-endturn (b) =
    if bg-check-win b then b
    else __record-set (bg-clone b) "current-player" (1 - b.current-player)

  bg-wasm-dice : Integer, List Integer -> List Integer
  bg-wasm-dice (packed) (acc) =
    if packed <= 0 then acc
    else bg-wasm-dice (bit-shru packed 3) (list-push acc (bit-and packed 7))

Section: The Rules At The Boundary

  bg-wasm-legal : BackgammonBoard, Integer, Integer, Integer -> Integer
  bg-wasm-legal (b) (packed) (from) (die) =
    if bg-check-win b then 0
    else if bg-legal b (bg-wasm-dice packed []) from die then 1
    else 0

  bg-wasm-mask : BackgammonBoard, Integer, Integer -> Integer
  bg-wasm-mask (b) (packed) (die) =
    if bg-check-win b then 0
    else bg-legal-mask b (bg-wasm-dice packed []) die

  bg-wasm-play : BackgammonBoard, Integer, Integer, Integer -> BackgammonBoard
  bg-wasm-play (b) (packed) (from) (die) =
    if bg-check-win b then b
    else bg-play b (bg-wasm-dice packed []) from die

  bg-wasm-most : BackgammonBoard, Integer -> Integer
  bg-wasm-most (b) (packed) = bg-max-use b (bg-wasm-dice packed []) 24

  bg-wasm-ai : BackgammonBoard, Integer -> Integer
  bg-wasm-ai (b) (packed) =
    if bg-check-win b then (-1)
    else bg-ai-pick b (bg-wasm-dice packed [])

Section: Setting Up A Position

 A position for a grader: an empty board with `player` on roll, then one
 slot at a time. Slots 0 to 23 are the points, 24 and 25 White's and
 Black's bar, 26 and 27 White's and Black's borne-off count, 28 the cube's
 value, 29 its owner (-1 in the middle) and 30 a pending offer.

  bg-wasm-empty : Integer -> BackgammonBoard
  bg-wasm-empty (player) =
    BackgammonBoard { points = bg-initial-zero 0 [], bar-white = 0, bar-black = 0,
                      off-white = 0, off-black = 0, current-player = player,
                      cube = 1, cube-owner = (-1), offered = 0, dropped = (-1) }

  bg-initial-zero : Integer, List Integer -> List Integer
  bg-initial-zero (i) (acc) =
    if i >= 24 then acc
    else bg-initial-zero (i + 1) (list-push acc 0)

  bg-wasm-put : BackgammonBoard, Integer, Integer -> BackgammonBoard
  bg-wasm-put (b) (slot) (v) =
    let c = bg-clone b
    in if slot < 0 then b
    else if slot < 24 then __record-set c "points" (list-set-at (c.points) slot v)
    else if slot == 24 then __record-set c "bar-white" v
    else if slot == 25 then __record-set c "bar-black" v
    else if slot == 26 then __record-set c "off-white" v
    else if slot == 27 then __record-set c "off-black" v
    else if slot == 28 then __record-set c "cube" v
    else if slot == 29 then __record-set c "cube-owner" v
    else if slot == 30 then __record-set c "offered" v
    else b

Section: Reading The Board

  bg-wasm-point : BackgammonBoard, Integer -> Integer
  bg-wasm-point (b) (i) =
    if i < 0 then 0
    else if i >= 24 then 0
    else list-at (b.points) i

  bg-wasm-bar : BackgammonBoard, Integer -> Integer
  bg-wasm-bar (b) (player) =
    if player == 0 then b.bar-white else b.bar-black

  bg-wasm-off : BackgammonBoard, Integer -> Integer
  bg-wasm-off (b) (player) =
    if player == 0 then b.off-white else b.off-black

  bg-wasm-cur : BackgammonBoard -> Integer
  bg-wasm-cur (b) = b.current-player

  bg-wasm-done : BackgammonBoard -> Integer
  bg-wasm-done (b) = if bg-check-win b then 1 else 0

  bg-wasm-winner : BackgammonBoard -> Integer
  bg-wasm-winner (b) = bg-winner b

  bg-wasm-kind : BackgammonBoard -> Integer
  bg-wasm-kind (b) = bg-result-kind b

  bg-wasm-points : BackgammonBoard -> Integer
  bg-wasm-points (b) = bg-points b

Section: The Cube

  bg-wasm-cube : BackgammonBoard -> Integer
  bg-wasm-cube (b) = b.cube

  bg-wasm-owner : BackgammonBoard -> Integer
  bg-wasm-owner (b) = b.cube-owner

  bg-wasm-offered : BackgammonBoard -> Integer
  bg-wasm-offered (b) = b.offered

  bg-wasm-can-double : BackgammonBoard -> Integer
  bg-wasm-can-double (b) = if bg-can-double b then 1 else 0

  bg-wasm-double : BackgammonBoard -> BackgammonBoard
  bg-wasm-double (b) = bg-double b

  bg-wasm-take : BackgammonBoard -> BackgammonBoard
  bg-wasm-take (b) = bg-take b

  bg-wasm-drop : BackgammonBoard -> BackgammonBoard
  bg-wasm-drop (b) = bg-drop b

  bg-wasm-ai-double : BackgammonBoard -> Integer
  bg-wasm-ai-double (b) = if bg-ai-double b then 1 else 0

  bg-wasm-ai-take : BackgammonBoard -> Integer
  bg-wasm-ai-take (b) = if bg-ai-take b then 1 else 0

