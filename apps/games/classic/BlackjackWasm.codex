 The page holds a BjTable handle; every action answers a new table, copied
 inside bt-act, so a handle already read stays as it was.

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

  bj-wasm-new : Integer -> BjTable
  bj-wasm-new (seed) = bt-new seed

  bj-wasm-phase : BjTable -> Integer
  bj-wasm-phase (t) = t.phase

  bj-wasm-nhands : BjTable -> Integer
  bj-wasm-nhands (t) = t.nhands

  bj-wasm-cur : BjTable -> Integer
  bj-wasm-cur (t) = t.cur

  bj-wasm-hand-ok : BjTable, Integer -> Boolean
  bj-wasm-hand-ok (t) (k) = k >= 0 & k < t.nhands

  bj-wasm-hcount : BjTable, Integer -> Integer
  bj-wasm-hcount (t) (k) = if bj-wasm-hand-ok t k then bt-count t k else (-1)

  bj-wasm-hcard : BjTable, Integer, Integer -> Integer
  bj-wasm-hcard (t) (k) (i) =
    if bj-wasm-hand-ok t k == False then (-1)
    else if i < 0 | i >= bt-count t k then (-1)
    else bt-card t k i

  bj-wasm-hvalue : BjTable, Integer -> Integer
  bj-wasm-hvalue (t) (k) = if bj-wasm-hand-ok t k then bt-value t k else (-1)

  bj-wasm-hsoft : BjTable, Integer -> Integer
  bj-wasm-hsoft (t) (k) = if bj-wasm-hand-ok t k == False then (-1) else if bj-soft-at (t.cards) (k * bt-slot) (bt-count t k) then 1 else 0

  bj-wasm-hbet : BjTable, Integer -> Integer
  bj-wasm-hbet (t) (k) = if bj-wasm-hand-ok t k then list-at (t.bets) k else (-1)

  bj-wasm-hstate : BjTable, Integer -> Integer
  bj-wasm-hstate (t) (k) = if bj-wasm-hand-ok t k then list-at (t.states) k else (-1)

  bj-wasm-dcount : BjTable -> Integer
  bj-wasm-dcount (t) = t.dcount

  bj-wasm-dcard : BjTable, Integer -> Integer
  bj-wasm-dcard (t) (i) = if i < 0 | i >= t.dcount then (-1) else list-at (t.dealer) i

  bj-wasm-dvalue : BjTable -> Integer
  bj-wasm-dvalue (t) = bt-dvalue t

  bj-wasm-can : BjTable, Integer -> Integer
  bj-wasm-can (t) (a) = if a >= 0 & bt-can t a then 1 else 0

  bj-wasm-act : BjTable, Integer -> BjTable
  bj-wasm-act (t) (a) = if a < 0 then t else bt-act t a

  bj-wasm-auto : BjTable -> BjTable
  bj-wasm-auto (t) = bt-auto t

  bj-wasm-net : BjTable -> Integer
  bj-wasm-net (t) = bt-net t

  bj-wasm-insured : BjTable -> Integer
  bj-wasm-insured (t) = t.insurance

  bj-wasm-deckpos : BjTable -> Integer
  bj-wasm-deckpos (t) = t.deck-pos

  bj-wasm-card-rank : Integer -> Integer
  bj-wasm-card-rank (card) =
    if card < 0 then (-1) else bj-rank card

  bj-wasm-card-value : Integer -> Integer
  bj-wasm-card-value (card) =
    if card < 0 then (-1) else bj-card-value card

Section: Setting Up a Position

 A grader stacks a deck card by card, in dealing order, and deals from it.

  bj-wasm-stack : Integer -> BjTable
  bj-wasm-stack (z) = bt-make [] 0 0 [] 0 [] [] [] [] [] 0 0 0 (0 - 1)

  bj-wasm-stack-push : BjTable, Integer -> BjTable
  bj-wasm-stack-push (t) (card) =
    let d = list-push (bj-copy-list (t.deck) 0 (t.deck-len) []) card
    in bt-make d (t.deck-len + 1) 0 [] 0 [] [] [] [] [] 0 0 0 (0 - 1)

  bj-wasm-stack-deal : BjTable -> BjTable
  bj-wasm-stack-deal (t) = if t.deck-len < 4 then t else bt-deal-round (t.deck) (t.deck-len)

Section: The Runner as a Reference

 The self-playing runner's result for the seed's deck (1, 0, -1), which the
 table under the same policy must reproduce.

  bj-wasm-ref : Integer -> Integer
  bj-wasm-ref (seed) =
    let s0 = bj-fresh-state (rng-new seed)
    in let s4 = bj-deal-card (bj-deal-card (bj-deal-card (bj-deal-card s0 [] 0) [] 1) [] 0) [] 1
    in let s5 = bj-player-turn s4
    in if bj-best-value (s5.player-cards) (s5.player-count) > 21 then (-1)
    else bj-hand-result (bj-dealer-turn s5)

