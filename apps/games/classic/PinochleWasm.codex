Chapter: PinochleWasm
  cites Games chapter Pinochle
  cites Games chapter Rng
  cites Foreword chapter List

 The person is seat 0 and opens the first auction. `pn-wasm-play` and
 `pn-wasm-mark` take an index into the hand, not a card id: a pinochle deck
 holds two of every card, so a card id does not name one card.

 We say:

Section: The Browser Interface

  wasm-exports : Text = ""

  pn-wasm-new : Integer -> PinGame
  pn-wasm-new (seed) = pin-new-game seed

  pn-wasm-phase : PinGame -> Integer
  pn-wasm-phase (g) = g.phase

  pn-wasm-dealer : PinGame -> Integer
  pn-wasm-dealer (g) = g.dealer

  pn-wasm-bid : PinGame -> Integer
  pn-wasm-bid (g) = g.bid

  pn-wasm-bidder : PinGame -> Integer
  pn-wasm-bidder (g) = g.bidder

  pn-wasm-min-bid : PinGame -> Integer
  pn-wasm-min-bid (g) = pin-min-bid g

  pn-wasm-out : PinGame, Integer -> Integer
  pn-wasm-out (g) (seat) =
    if seat < 0 then 0 else if seat > 3 then 0 else pin-bit (g.out) seat

  pn-wasm-trump : PinGame -> Integer
  pn-wasm-trump (g) = (g.st).trump

  pn-wasm-card : PinGame, Integer, Integer -> Integer
  pn-wasm-card (g) (player) (i) =
    if player < 0 then (-1)
    else if player >= 4 then (-1)
    else if i < 0 then (-1)
    else let hand = pin-hand (g.st) player
    in if i >= list-length hand then (-1)
    else list-at hand i

  pn-wasm-count : PinGame, Integer -> Integer
  pn-wasm-count (g) (player) =
    if player < 0 then 0
    else if player >= 4 then 0
    else list-length (pin-hand (g.st) player)

  pn-wasm-meld : PinGame, Integer -> Integer
  pn-wasm-meld (g) (player) =
    if player < 0 then (-1)
    else if player >= 4 then (-1)
    else score-meld (pin-hand (g.st) player) ((g.st).trump)

  pn-wasm-meld-in : PinGame, Integer, Integer -> Integer
  pn-wasm-meld-in (g) (player) (trump) =
    if player < 0 then (-1)
    else if player >= 4 then (-1)
    else score-meld (pin-hand (g.st) player) trump

  pn-wasm-hand-meld : PinGame, Integer -> Integer
  pn-wasm-hand-meld (g) (team) = if team == 0 then g.m0 else g.m1

  pn-wasm-cur : PinGame -> Integer
  pn-wasm-cur (g) = (g.st).turn

  pn-wasm-leader : PinGame -> Integer
  pn-wasm-leader (g) = (g.st).leader

  pn-wasm-trick : PinGame, Integer -> Integer
  pn-wasm-trick (g) (seat) =
    if seat < 0 then (-1)
    else if seat >= 4 then (-1)
    else pin-played (g.st) seat

  pn-wasm-legal : PinGame, Integer -> Integer
  pn-wasm-legal (g) (idx) = if pin-legal-now g idx then 1 else 0

  pn-wasm-play : PinGame, Integer -> PinGame
  pn-wasm-play (g) (idx) = pin-play g idx

  pn-wasm-step : PinGame -> PinGame
  pn-wasm-step (g) = pin-step g

  pn-wasm-done : PinGame -> Integer
  pn-wasm-done (g) = if g.phase == 6 then 1 else 0

  pn-wasm-tricks : PinGame -> Integer
  pn-wasm-tricks (g) = (g.st).tricks

  pn-wasm-pts : PinGame, Integer -> Integer
  pn-wasm-pts (g) (team) = if team == 0 then (g.st).t0 else (g.st).t1

  pn-wasm-can-bid : PinGame, Integer -> Integer
  pn-wasm-can-bid (g) (amount) = if pin-can-bid g amount then 1 else 0

  pn-wasm-call-bid : PinGame, Integer -> PinGame
  pn-wasm-call-bid (g) (amount) = pin-call-bid g amount

  pn-wasm-pass : PinGame -> PinGame
  pn-wasm-pass (g) = pin-call-pass g

  pn-wasm-name : PinGame, Integer -> PinGame
  pn-wasm-name (g) (suit) = pin-name-trump g suit

  pn-wasm-can-mark : PinGame, Integer -> Integer
  pn-wasm-can-mark (g) (i) = if pin-can-mark g i then 1 else 0

  pn-wasm-mark : PinGame, Integer -> PinGame
  pn-wasm-mark (g) (i) = pin-mark g i

  pn-wasm-marked : PinGame, Integer -> Integer
  pn-wasm-marked (g) (i) = if i < 0 then 0 else if i >= 16 then 0 else pin-bit (g.marked) i

  pn-wasm-clear : PinGame -> PinGame
  pn-wasm-clear (g) = pin-clear-marks g

  pn-wasm-can-give : PinGame -> Integer
  pn-wasm-can-give (g) = if pin-can-give g then 1 else 0

  pn-wasm-give : PinGame -> PinGame
  pn-wasm-give (g) = pin-give g

  pn-wasm-next : PinGame -> PinGame
  pn-wasm-next (g) = pin-next-hand g

  pn-wasm-score : PinGame, Integer -> Integer
  pn-wasm-score (g) (team) = if team == 0 then g.s0 else g.s1

  pn-wasm-made : PinGame -> Integer
  pn-wasm-made (g) = g.made

  pn-wasm-game-winner : PinGame -> Integer
  pn-wasm-game-winner (g) = g.winner

  pn-wasm-hands : PinGame -> Integer
  pn-wasm-hands (g) = g.hands

Section: The Session

  pn-wasm-run : Integer -> PinochleResult
  pn-wasm-run (seed) = run-pinochle-hand seed

  pn-wasm-t0 : PinochleResult -> Integer
  pn-wasm-t0 (r) = r.team0-score

  pn-wasm-t1 : PinochleResult -> Integer
  pn-wasm-t1 (r) = r.team1-score

  pn-wasm-winner : PinochleResult -> Integer
  pn-wasm-winner (r) = r.winner

Section: Melding A Hand Built By The Caller

  pn-wasm-cards0 : Integer -> List Integer
  pn-wasm-cards0 (n) = []

  pn-wasm-cards-add : List Integer, Integer -> List Integer
  pn-wasm-cards-add (cards) (c) = list-push cards c

  pn-wasm-meld-of : List Integer, Integer -> Integer
  pn-wasm-meld-of (cards) (trump) = score-meld cards trump

