Chapter: Rng
  cites Foreword chapter Random

 We say:

Section: Core

  Rng = record {
    state : Integer
  }

  rng-new : Integer -> Rng
  rng-new (seed) = Rng { state = seed }

  rng-next : Rng -> Rng
  rng-next (r) =
    let h = r.state * 1103515245 + 12345
    in let positive = if h < 0 then -h else h
    in Rng { state = positive }

  rng-value : Rng -> Integer
  rng-value (r) = r.state

  rng-range : Rng, Integer, Integer -> Integer
  rng-range (r) (lo) (hi) =
    let span = hi - lo + 1
    in lo + rng-mod (rng-value r) span

  rng-mod : Integer, Integer -> Integer
  rng-mod (val) (modulus) =
    if modulus <= 0 then 0
    else val - (val / modulus) * modulus

 rng-next carries entropy upward only, so its low bit strictly alternates and
 rng-mod (rng-value r) 2 is the comb 0101. Coin flips go through mix-bits,
 which folds the high bits back down.

  rng-bit : Rng -> Integer
  rng-bit (r) =
    let h = mix-bits (rng-value r) 1
    in let positive = if h < 0 then -h else h
    in positive - (positive / 2) * 2

