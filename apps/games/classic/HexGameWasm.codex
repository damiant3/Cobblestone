Chapter: HexGameWasm
  cites Games chapter HexGame
  cites Foreword chapter List

 `hex-place` writes the stone with `list-set-at`, in place, so
 `hx-wasm-place` copies first. The winning-move search sets a cell on the
 caller's board and sets it back, which is safe only while the restore
 always happens.

 Hex cannot be drawn: on a full board one side has a connecting path.

 We say:

Section: Copying

  wasm-exports : Text = ""

  hx-copy-cells : List Integer, Integer, List Integer -> List Integer
  hx-copy-cells (src) (i) (acc) =
    if i >= 121 then acc
    else hx-copy-cells src (i + 1) (list-push acc (list-at src i))

  hx-copy-board : HexBoard -> HexBoard
  hx-copy-board (b) =
    HexBoard {
      cells = hx-copy-cells (b.cells) 0 [],
      current-player = b.current-player,
      game-over = b.game-over,
      winner = b.winner,
      moves-made = b.moves-made
    }

Section: The Browser Interface

  hx-wasm-new : HexBoard
  hx-wasm-new = hex-new

  hx-wasm-cell : HexBoard, Integer -> Integer
  hx-wasm-cell (b) (i) =
    if i < 0 then (-1)
    else if i >= 121 then (-1)
    else list-at (b.cells) i

  hx-wasm-cur : HexBoard -> Integer
  hx-wasm-cur (b) = b.current-player

  hx-wasm-done : HexBoard -> Integer
  hx-wasm-done (b) = if b.game-over then 1 else 0

  hx-wasm-winner : HexBoard -> Integer
  hx-wasm-winner (b) = b.winner

  hx-wasm-moves : HexBoard -> Integer
  hx-wasm-moves (b) = b.moves-made

  hx-wasm-can : HexBoard, Integer -> Integer
  hx-wasm-can (b) (i) =
    if b.game-over then 0
    else if i < 0 then 0
    else if i >= 121 then 0
    else if list-at (b.cells) i /= 0 then 0
    else 1

  hx-wasm-place : HexBoard, Integer -> HexBoard
  hx-wasm-place (b) (i) =
    if hx-wasm-can b i == 0 then b
    else hex-place (hx-copy-board b) (i / 11) (i - (i / 11) * 11)

  hx-wasm-ai : HexBoard -> Integer
  hx-wasm-ai (b) =
    if b.game-over then (-1)
    else hex-ai-move b

  hx-wasm-connected : HexBoard, Integer -> Integer
  hx-wasm-connected (b) (player) =
    if player < 1 then 0
    else if player > 2 then 0
    else if hex-check-win (b.cells) player then 1 else 0

