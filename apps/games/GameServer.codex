  handle-ur : GameStore, Text, Text -> [Console] GameStore
  handle-ur (store) (line) (path) =
    if text-starts-with path "/api/royalur/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let board = ur-new
      in let ns = set-ur store board (rng-new seed) True
      in act
        pm0 <- respond-json (ur-to-json board)
        ns
      end
    else if text-starts-with path "/api/royalur/step" then
      if store.ur-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let roll = parse-int (extract-query-param line "roll") 2
      in let r2 = store.ur-rng
      in let b1 = __record-set (store.ur-board) "last-roll" roll
      in let next = if roll == 0 then
        let np = if b1.current-player == 1 then 2 else 1
        in let b2 = __record-set b1 "current-player" np
        in __record-set b2 "moves-made" (b1.moves-made + 1)
      else let pick = ur-ai-pick b1 roll
      in if pick < 0 then
        let np = if b1.current-player == 1 then 2 else 1
        in let b2 = __record-set b1 "current-player" np
        in __record-set b2 "moves-made" (b1.moves-made + 1)
      else ur-apply-move b1 pick roll
      in let ns = set-ur store next r2 (if next.game-over then False else True)
      in act
        pm0 <- respond-json (ur-to-json next)
        ns
      end
    else act pm0 <- respond-json (ur-to-json (store.ur-board))
        store
      end

  handle-gf : GameStore, Text, Text -> [Console] GameStore
  handle-gf (store) (line) (path) =
    if text-starts-with path "/api/gofish/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = gf-init seed 2
      in let ns = set-gf store st True
      in act
        pm0 <- respond-json (gf-to-json st)
        ns
      end
    else if text-starts-with path "/api/gofish/step" then
      if store.gf-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let next = gf-do-turn (store.gf-state)
      in let ns = set-gf store next (if next.game-over then False else True)
      in act
        pm0 <- respond-json (gf-to-json next)
        ns
      end
    else act pm0 <- respond-json (gf-to-json (store.gf-state))
        store
      end

