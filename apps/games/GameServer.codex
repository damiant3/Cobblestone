  handle-mm : GameStore, Text, Text -> [Console] GameStore
  handle-mm (store) (line) (path) =
    if text-starts-with path "/api/mastermind/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let r = rng-new seed
      in let secret = mm-make-secret r
      in let pool = mm-all-codes
      in let ns = set-mm store secret 0 0 0 pool r True
      in act
        pm0 <- respond-json (mm-to-json 0 0 0 (list-length pool) 0 False)
        ns
      end
    else if text-starts-with path "/api/mastermind/step" then
      if store.mm-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let pool = store.mm-pool
      in let guess = if list-length pool > 0 then list-at pool 0 else mm-encode 0 0 1 1
      in let fb = mm-score (store.mm-secret) guess
      in let blacks = fb / 10
      in let solved = blacks >= 4
      in let ng = store.mm-guesses + 1
      in let new-pool = if solved then [] else mm-filter-pool pool guess fb (list-length pool)
      in let ns = set-mm store (store.mm-secret) ng fb guess new-pool (store.mm-rng) (if solved | ng >= 10 then False else True)
      in act
        pm0 <- respond-json (mm-to-json ng fb guess (list-length new-pool) (if solved | ng >= 10 then store.mm-secret else 0) solved)
        ns
      end
    else act pm0 <- respond-json (mm-to-json (store.mm-guesses) (store.mm-feedback) (store.mm-guess) (list-length (store.mm-pool)) 0 False)
        store
      end

  handle-mono : GameStore, Text, Text -> [Console] GameStore
  handle-mono (store) (line) (path) =
    if text-starts-with path "/api/monopoly/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = mono-init seed 4
      in let ns = set-mo store st True
      in act
        pm0 <- respond-json (mo-to-json st)
        ns
      end
    else if text-starts-with path "/api/monopoly/step" then
      if store.mo-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let r = rng-new ((store.mo-state).turn-number * 7919 + 104729)
      in let next = mono-do-turn (store.mo-state) r
      in let checked = mono-check-bankrupt next
      in let ns = set-mo store checked (if checked.game-over then False else if checked.turn-number >= 200 then False else True)
      in act
        pm0 <- respond-json (mo-to-json checked)
        ns
      end
    else act pm0 <- respond-json (mo-to-json (store.mo-state))
        store
      end

  handle-risk : GameStore, Text, Text -> [Console] GameStore
  handle-risk (store) (line) (path) =
