  handle-sudoku-solve : GameStore, Text -> [Console] GameStore
  handle-sudoku-solve (store) (line) =
    let seed = parse-int (extract-query-param line "seed") 42
    in let rng = rng-new seed
    in let base = sudoku-new rng
    in let filled = sudoku-solve base
    in let r2 = rng-next rng
    in let puzzle = sudoku-remove-cells filled r2 40
    in let solution = sudoku-solve puzzle
    in let pg = int-list-to-json (puzzle.grid) 0 81 []
    in let sg = int-list-to-json (solution.grid) 0 81 []
    in let body = json-emit (json-object [
      json-pair "puzzle" (json-array pg),
      json-pair "solution" (json-array sg),
      json-pair "solved" (json-bool (solution.iterations > 0)),
      json-pair "iterations" (json-int (solution.iterations))
    ])
    in act
      pm0 <- respond-json body
      store
    end

  handle-bs : GameStore, Text, Text -> [Console] GameStore
  handle-bs (store) (line) (path) =
    if text-starts-with path "/api/battleship/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let r0 = rng-new seed
      in let r1 = rng-next r0
      in let r2 = rng-next r1
      in let p1s = bs-place-ships r1
      in let p2s = bs-place-ships r2
      in let st = BsState { p1-ships = p1s, p1-tracking = bs-empty-grid, p2-ships = p2s, p2-tracking = bs-empty-grid, p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0, rng = r2, game-over = False, winner = 0 }
      in let ns = set-bs store st True
      in act
        pm0 <- respond-json (bs-to-json st)
        ns
      end
    else if text-starts-with path "/api/battleship/step" then
      if store.bs-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let next = bs-step (store.bs-state)
      in let ns = set-bs store next (if next.game-over then False else True)
      in act
        pm0 <- respond-json (bs-to-json next)
        ns
      end
    else act
      pm0 <- respond-json (bs-to-json (store.bs-state))
      store
    end

  handle-yh : GameStore, Text, Text -> [Console] GameStore
  handle-yh (store) (line) (path) =
    if text-starts-with path "/api/yahtzee/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = yh-init seed
      in let ns = set-yh store st 0 True
      in act
        pm0 <- respond-json (yh-to-json st 0)
        ns
      end
    else if text-starts-with path "/api/yahtzee/step" then
      if store.yh-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else if store.yh-turn >= 13 then
        let ns = set-yh store (store.yh-state) 13 False
        in act
          pm0 <- respond-json (yh-to-json (store.yh-state) 13)
          ns
        end
      else let next = yh-do-turn (store.yh-state)
      in let nt = store.yh-turn + 1
      in let ns = set-yh store next nt (if nt >= 13 then False else True)
      in act
        pm0 <- respond-json (yh-to-json next nt)
        ns
      end
    else act pm0 <- respond-json (yh-to-json (store.yh-state) (store.yh-turn))
        store
      end

  handle-mj : GameStore, Text, Text -> [Console] GameStore
  handle-mj (store) (line) (path) =
    if text-starts-with path "/api/mahjong/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = mahjong-new seed
      in let ns = set-mj store st True
      in act
        pm0 <- respond-json (mj-to-json st)
        ns
      end
    else if text-starts-with path "/api/mahjong/step" then
      if store.mj-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let pair = find-matching-free-pairs (store.mj-state)
      in if pair < 0 then
        let ns = set-mj store (store.mj-state) False
        in act
          pm0 <- respond-json (mj-to-json (store.mj-state))
          ns
        end
      else let i = pair / 144
      in let j = pair - (i * 144)
      in let next = remove-pair (store.mj-state) i j
      in let done = next.remaining <= 0
      in let ns = set-mj store next (if done then False else True)
      in act
        pm0 <- respond-json (mj-to-json next)
        ns
      end
    else act pm0 <- respond-json (mj-to-json (store.mj-state))
        store
      end

  handle-wr : GameStore, Text, Text -> [Console] GameStore
  handle-wr (store) (line) (path) =
    if text-starts-with path "/api/war/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = war-init seed
      in let ns = set-wr store st 0 (-1) (-1) True
      in act
        pm0 <- respond-json (wr-to-json st 0 (-1) (-1))
        ns
      end
    else if text-starts-with path "/api/war/step" then
      if store.wr-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let cur = store.wr-state
      in let c1 = if cur.p1-size > 0 then list-at (cur.p1-hand) 0 else (-1)
      in let c2 = if cur.p2-size > 0 then list-at (cur.p2-hand) 0 else (-1)
      in let next = war-do-round cur
      in let nr = store.wr-round + 1
      in let done = next.p1-size <= 0 | next.p2-size <= 0 | nr >= 1000
      in let ns = set-wr store next nr c1 c2 (if done then False else True)
      in act
        pm0 <- respond-json (wr-to-json next nr c1 c2)
        ns
      end
    else act pm0 <- respond-json (wr-to-json (store.wr-state) (store.wr-round) (store.wr-p1card) (store.wr-p2card))
        store
      end

