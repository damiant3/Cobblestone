  bs-to-json : BsState -> Text
  bs-to-json (st) =
    let p1t = int-list-to-json ((st.p1-tracking).cells) 0 100 []
    in let p2t = int-list-to-json ((st.p2-tracking).cells) 0 100 []
    in let p1s = if st.game-over then int-list-to-json ((st.p1-ships).cells) 0 100 [] else []
    in let p2s = if st.game-over then int-list-to-json ((st.p2-ships).cells) 0 100 [] else []
    in json-emit (json-object [
      json-pair "p1track" (json-array p1t),
      json-pair "p2track" (json-array p2t),
      json-pair "p1ships" (json-array p1s),
      json-pair "p2ships" (json-array p2s),
      json-pair "p1hits" (json-int (st.p1-hits)),
      json-pair "p2hits" (json-int (st.p2-hits)),
      json-pair "p1shots" (json-int (st.p1-shots)),
      json-pair "p2shots" (json-int (st.p2-shots)),
      json-pair "done" (json-bool (st.game-over)),
      json-pair "winner" (json-int (st.winner))
    ])

  yh-to-json : YahtzeeState, Integer -> Text
  yh-to-json (st) (turn) =
    let dice = int-list-to-json (st.dice) 0 5 []
    in let scorecard = int-list-to-json (st.scorecard) 0 13 []
    in let scored = int-list-to-json (st.scored) 0 13 []
    in let total = yh-total-score (st.scorecard) 0 0
    in json-emit (json-object [
      json-pair "dice" (json-array dice),
      json-pair "scorecard" (json-array scorecard),
      json-pair "scored" (json-array scored),
      json-pair "turn" (json-int turn),
      json-pair "total" (json-int total),
      json-pair "done" (json-bool (turn >= 13))
    ])

  wr-to-json : WarState, Integer, Integer, Integer -> Text
  wr-to-json (st) (round) (c1) (c2) =
    json-emit (json-object [
      json-pair "p1size" (json-int (st.p1-size)),
      json-pair "p2size" (json-int (st.p2-size)),
      json-pair "p1card" (json-int c1),
      json-pair "p2card" (json-int c2),
      json-pair "round" (json-int round),
      json-pair "done" (json-bool (st.p1-size <= 0 | st.p2-size <= 0))
    ])

  rp-to-json : RPSState, Integer -> Text
  rp-to-json (st) (round) =
    json-emit (json-object [
      json-pair "p1wins" (json-int (st.p1-wins)),
      json-pair "p2wins" (json-int (st.p2-wins)),
      json-pair "ties" (json-int (st.ties)),
      json-pair "round" (json-int round),
      json-pair "done" (json-bool (round >= 20))
    ])

  ur-to-json : UrBoard -> Text
  ur-to-json (b) =
    let p1 = int-list-to-json (b.p1-pieces) 0 7 []
    in let p2 = int-list-to-json (b.p2-pieces) 0 7 []
    in json-emit (json-object [
      json-pair "p1" (json-array p1),
      json-pair "p2" (json-array p2),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "p1scored" (json-int (b.p1-scored)),
      json-pair "p2scored" (json-int (b.p2-scored)),
      json-pair "roll" (json-int (b.last-roll)),
      json-pair "moves" (json-int (b.moves-made)),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "winner" (json-int (b.winner))
    ])

  gf-player-cards : List Integer, Integer, Integer, List JsonValue -> List JsonValue
  gf-player-cards (hands) (base) (card) (acc) =
    if card >= 52 then acc
    else if list-at hands (base + card) == 1
      then gf-player-cards hands base (card + 1) (list-push acc (json-int card))
      else gf-player-cards hands base (card + 1) acc

  gf-all-hands : List Integer, Integer, Integer, List JsonValue -> List JsonValue
  gf-all-hands (hands) (player) (num) (acc) =
    if player >= num then acc
    else let cards = gf-player-cards hands (player * 52) 0 []
    in gf-all-hands hands (player + 1) num (list-push acc (json-array cards))

  gf-to-json : GoFishState -> Text
  gf-to-json (st) =
    let books = int-list-to-json (st.books) 0 (st.num-players) []
    in let sizes = int-list-to-json (st.hand-sizes) 0 (st.num-players) []
    in let player-hands = gf-all-hands (st.hands) 0 (st.num-players) []
    in json-emit (json-object [
      json-pair "books" (json-array books),
      json-pair "handSizes" (json-array sizes),
      json-pair "hands" (json-array player-hands),
      json-pair "cur" (json-int (st.current-player)),
      json-pair "pileSize" (json-int (st.pile-size)),
      json-pair "totalBooks" (json-int (st.total-books)),
      json-pair "numPlayers" (json-int (st.num-players)),
      json-pair "done" (json-bool (st.game-over))
    ])

  ce-to-json : CrazyEightsState -> Text
  ce-to-json (st) =
    let sizes = int-list-to-json (st.hand-sizes) 0 (st.num-players) []
    in json-emit (json-object [
      json-pair "handSizes" (json-array sizes),
      json-pair "discardRank" (json-int (st.discard-rank)),
      json-pair "discardSuit" (json-int (st.discard-suit)),
      json-pair "cur" (json-int (st.current-player)),
      json-pair "pileSize" (json-int (st.pile-size)),
      json-pair "numPlayers" (json-int (st.num-players)),
      json-pair "done" (json-bool (st.game-over)),
      json-pair "winner" (json-int (st.winner))
    ])

  ld-to-json : LDState -> Text
  ld-to-json (st) =
    let counts = int-list-to-json (st.dice-counts) 0 (st.num-players) []
    in let pools = int-list-to-json (st.dice-pools) 0 (st.num-players * 5) []
    in let alive-flags = int-list-to-json (st.alive) 0 (st.num-players) []
    in json-emit (json-object [
      json-pair "diceCounts" (json-array counts),
      json-pair "dicePools" (json-array pools),
      json-pair "alive" (json-array alive-flags),
      json-pair "aliveCount" (json-int (st.alive-count)),
      json-pair "cur" (json-int (st.current-turn)),
      json-pair "lastBidder" (json-int (st.last-bidder)),
      json-pair "bid" (json-int (st.current-bid)),
      json-pair "numPlayers" (json-int (st.num-players)),
      json-pair "done" (json-bool (st.alive-count <= 1))
    ])

  mj-to-json : MahjongState -> Text
  mj-to-json (st) =
    let tiles = int-list-to-json (st.tiles) 0 144 []
    in json-emit (json-object [
      json-pair "tiles" (json-array tiles),
      json-pair "matched" (json-int (st.matched)),
      json-pair "remaining" (json-int (st.remaining)),
      json-pair "done" (json-bool (st.remaining <= 0))
    ])

  bj-to-json : BjState, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  bj-to-json (st) (phase) (wins) (losses) (pushes) (hands) (result) =
    let pc = int-list-to-json (st.player-cards) 0 (st.player-count) []
    in let dc-count = if phase == 1 then 1 else st.dealer-count
    in let dc = int-list-to-json (st.dealer-cards) 0 dc-count []
    in let pv = bj-best-value (st.player-cards) (st.player-count)
    in let dv = if phase == 1 then 0 else bj-best-value (st.dealer-cards) (st.dealer-count)
    in json-emit (json-object [
      json-pair "playerCards" (json-array pc),
      json-pair "dealerCards" (json-array dc),
      json-pair "playerVal" (json-int pv),
      json-pair "dealerVal" (json-int dv),
      json-pair "phase" (json-int phase),
      json-pair "result" (json-int result),
      json-pair "wins" (json-int wins),
      json-pair "losses" (json-int losses),
      json-pair "pushes" (json-int pushes),
      json-pair "hands" (json-int hands),
      json-pair "done" (json-bool (hands >= 10))
    ])

  pk-to-json : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, List Integer, List Integer -> Text
  pk-to-json (wins) (losses) (hands) (p1-rank) (p2-rank) (p1-primary) (p2-primary) (winner) (p1-cards) (p2-cards) =
    let c1 = int-list-to-json p1-cards 0 (list-length p1-cards) []
    in let c2 = int-list-to-json p2-cards 0 (list-length p2-cards) []
    in json-emit (json-object [
      json-pair "wins" (json-int wins),
      json-pair "losses" (json-int losses),
      json-pair "hands" (json-int hands),
      json-pair "p1rank" (json-int p1-rank),
      json-pair "p2rank" (json-int p2-rank),
      json-pair "p1primary" (json-int p1-primary),
      json-pair "p2primary" (json-int p2-primary),
      json-pair "winner" (json-int winner),
      json-pair "p1cards" (json-array c1),
      json-pair "p2cards" (json-array c2),
      json-pair "done" (json-bool (hands >= 10))
    ])

  sp-to-json : SpiderState -> Text
  sp-to-json (st) =
    let cols = [list-length (st.col0), list-length (st.col1), list-length (st.col2),
                list-length (st.col3), list-length (st.col4), list-length (st.col5),
                list-length (st.col6), list-length (st.col7), list-length (st.col8),
                list-length (st.col9)]
    in let col-json = int-list-to-json cols 0 10 []
    in json-emit (json-object [
      json-pair "completed" (json-int (st.completed-suits)),
      json-pair "moves" (json-int (st.moves)),
      json-pair "stockSize" (json-int (list-length (st.stock))),
      json-pair "columns" (json-array col-json),
      json-pair "done" (json-bool (st.completed-suits >= 8))
    ])

  br-to-json : Integer, Integer, Integer, Integer, Integer, Integer -> Text
  br-to-json (ns-score) (ew) (hands) (last-tricks) (contract) (trump) =
    json-emit (json-object [
      json-pair "nsScore" (json-int ns-score),
      json-pair "ewScore" (json-int ew),
      json-pair "hands" (json-int hands),
      json-pair "lastTricks" (json-int last-tricks),
      json-pair "contract" (json-int contract),
      json-pair "trump" (json-int trump),
      json-pair "done" (json-bool (hands >= 8))
