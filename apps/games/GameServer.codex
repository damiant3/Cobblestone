  handle-sudoku-solve : GameStore, Text -> [Console] GameStore
  handle-sudoku-solve (store) (line) =
    let seed = parse-int (extract-query-param line "seed") 42
    in let puzzle = sudoku-new (rng-new seed)
    in let solved = sudoku-solve puzzle
    in let pg = int-list-to-json (puzzle.grid) 0 81 []
    in let sg = int-list-to-json (solved.grid) 0 81 []
    in let body = json-emit (json-object [
      json-pair "puzzle" (json-array pg),
      json-pair "solution" (json-array sg),
      json-pair "solved" (json-bool (solved.iterations > 0)),
      json-pair "iterations" (json-int (solved.iterations))
    ])
    in act
      pm0 <- respond-json body
      store
    end

  handle-bs : GameStore, Text, Text -> [Console] GameStore
  handle-bs (store) (line) (path) =
    if text-starts-with path "/api/battleship/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let r0 = rng-new seed
      in let r1 = rng-next r0
      in let r2 = rng-next r1
      in let p1s = bs-place-ships r1
      in let p2s = bs-place-ships r2
      in let st = BsState { p1-ships = p1s, p1-tracking = bs-empty-grid, p2-ships = p2s, p2-tracking = bs-empty-grid, p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0, rng = r2, game-over = False, winner = 0 }
      in let ns = set-bs store st True
      in act
        pm0 <- respond-json (bs-to-json st)
        ns
      end
    else if text-starts-with path "/api/battleship/step" then
      if store.bs-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let next = bs-step (store.bs-state)
      in let ns = set-bs store next (if next.game-over then False else True)
      in act
        pm0 <- respond-json (bs-to-json next)
        ns
      end
    else act
      pm0 <- respond-json (bs-to-json (store.bs-state))
      store
    end

  handle-run : GameStore, Text, Text -> [Console] GameStore
  handle-run (store) (line) (path) =
    let seed = parse-int (extract-query-param line "seed") 42
    in let game = text-drop path 9
    in let result = run-game-by-name game seed
    in if text-length result > 0 then act
      pm0 <- respond-json result
      store
    end
    else act pm0 <- respond-not-found
        store
      end

  run-game-by-name : Text, Integer -> Text
  run-game-by-name (name) (seed) =
    if text-starts-with name "blackjack" then run-result-json "blackjack" (format-blackjack-result (run-blackjack-session seed 10)) seed
    else if text-starts-with name "bridge" then run-result-json "bridge" (format-bridge-result (run-bridge-hand seed)) seed
    else if text-starts-with name "crazyeights" then run-result-json "crazyeights" (format-crazy-eights (run-crazy-eights seed 4)) seed
    else if text-starts-with name "gofish" then run-result-json "gofish" (format-go-fish (run-go-fish seed 4) 4) seed
    else if text-starts-with name "pinochle" then run-result-json "pinochle" (format-pinochle-result (run-pinochle-hand seed)) seed
    else if text-starts-with name "pokervariants" then run-result-json "pokervariants" (format-poker-variant (run-poker-variant FiveCardDraw seed 4)) seed
    else if text-starts-with name "poker" then run-result-json "poker" (format-poker-result (run-poker-session seed 10)) seed
    else if text-starts-with name "war" then run-result-json "war" (format-war-result (run-war-game seed)) seed
    else if text-starts-with name "rps" then run-result-json "rps" (format-rps-result (run-rps-series seed 20)) seed
    else if text-starts-with name "yahtzee" then run-result-json "yahtzee" (format-yahtzee-result (run-yahtzee-game seed)) seed
    else if text-starts-with name "liarsdice" then run-result-json "liarsdice" (format-liars-result (run-liars-dice seed 4)) seed
    else if text-starts-with name "mastermind" then run-result-json "mastermind" (format-mastermind-result (run-mastermind-game seed)) seed
    else if text-starts-with name "mahjong" then run-result-json "mahjong" (format-mahjong-result (run-mahjong-game seed)) seed
    else if text-starts-with name "hexwar" then run-result-json "hexwar" (format-hexwar-result (run-hexwar-game scenario-stalingrad seed)) seed
    else if text-starts-with name "battleship" then run-result-json "battleship" (format-battleship-result run-battleship-game) seed
    else if text-starts-with name "monopoly" then run-result-json "monopoly" (format-monopoly-result (run-monopoly-game seed 4)) seed
    else if text-starts-with name "risk" then run-result-json "risk" (format-risk-result (run-risk-game seed 4)) seed
    else if text-starts-with name "spider" then run-result-json "spider" (format-spider-result (run-spider-game seed)) seed
    else if text-starts-with name "sudoku" then run-result-json "sudoku" (format-sudoku-result run-sudoku-solve) seed
    else if text-starts-with name "setgame" then run-result-json "setgame" ("Sets found: " & show (run-set-game seed)) seed
    else if text-starts-with name "royalur" then run-result-json "royalur" (format-ur-result (run-ur-game seed)) seed
    else ""

  handle-status : GameStore -> [Console] GameStore
  handle-status (store) =
    let obj = json-object [
      json-pair "server" (json-str "Codex GameServer"),
      json-pair "version" (json-int 2),
      json-pair "games" (json-int 27)
    ]
    in act
      pm0 <- respond-json (json-emit obj)
      store
    end

Section: Server Loop

  opening : [Console] Nothing = act
    print-line-uni "READY"
    server-loop game-store-new
  end

  server-loop : GameStore -> [Console] Nothing
  server-loop (store) = act
    line-result <- read-line
    when line-result
      is Just (line) -> act
        new-store <- dispatch-request store line
        server-loop new-store
      end
      is None -> print-line-uni "SERVER-EXIT"
    end

Page 1
