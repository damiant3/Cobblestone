  mm-to-json : Integer, Integer, Integer, Integer, Integer, Boolean -> Text
  mm-to-json (guesses) (feedback) (guess) (pool-size) (secret) (solved) =
    json-emit (json-object [
      json-pair "guesses" (json-int guesses),
      json-pair "feedback" (json-int feedback),
      json-pair "guess" (json-int guess),
      json-pair "poolSize" (json-int pool-size),
      json-pair "secret" (json-int secret),
