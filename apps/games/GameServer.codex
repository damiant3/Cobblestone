  handle-ck : GameStore, Text, Text -> [Console] GameStore
  handle-ck (store) (line) (path) =
    if text-starts-with path "/api/checkers/new" then
      let seed = parse-int (extract-query-param line "seed") 99
      in let board = checkers-new seed
      in let ns = set-ck store board 0 (rng-new seed) True
      in act
        pm0 <- respond-json (ck-to-json board 0)
        ns
      end
    else if text-starts-with path "/api/checkers/step" then
      if store.ck-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let moves = generate-moves (store.ck-board)
      in if list-length moves == 0 then
        let db = __record-set (store.ck-board) "over" True
        in let ns = set-ck store db (store.ck-moves) (store.ck-rng) False
        in act
        pm0 <- respond-json (ck-to-json db (store.ck-moves))
        ns
      end
      else let idx = checkers-ai-move (store.ck-board) 3
      in let next = apply-move (store.ck-board) (list-at moves idx)
      in let nm = store.ck-moves + 1
      in let ns = set-ck store next nm (store.ck-rng) (if next.over then False else True)
      in act
        pm0 <- respond-json (ck-to-json next nm)
        ns
      end
    else act pm0 <- respond-json (ck-to-json (store.ck-board) (store.ck-moves))
        store
      end

