  handle-bj : GameStore, Text, Text -> [Console] GameStore
  handle-bj (store) (line) (path) =
    if text-starts-with path "/api/blackjack/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let r = rng-new seed
      in let st = bj-fresh-state r
      in let ns = set-bj store st 0 0 0 0 0 r True
      in act
        pm0 <- respond-json (bj-to-json st 0 0 0 0 0 0)
        ns
      end
    else if text-starts-with path "/api/blackjack/step" then
      if store.bj-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let r2 = rng-next (store.bj-rng)
      in let st = bj-fresh-state r2
      in let st2 = bj-player-turn st
      in let st3 = bj-dealer-turn st2
      in let result = bj-hand-result st3
      in let nw = if result == 1 then store.bj-wins + 1 else store.bj-wins
      in let nl = if result == (-1) then store.bj-losses + 1 else store.bj-losses
      in let np = if result == 0 then store.bj-pushes + 1 else store.bj-pushes
      in let nh = store.bj-hands + 1
      in let ns = set-bj store st3 0 nw nl np nh r2 (if nh >= 10 then False else True)
      in act
        pm0 <- respond-json (bj-to-json st3 3 nw nl np nh result)
        ns
      end
    else act pm0 <- respond-json (bj-to-json (store.bj-state) 0 (store.bj-wins) (store.bj-losses) (store.bj-pushes) (store.bj-hands) 0)
        store
      end

  handle-pk : GameStore, Text, Text -> [Console] GameStore
  handle-pk (store) (line) (path) =
    if text-starts-with path "/api/poker/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let ns = set-pk store 0 0 0 (rng-new seed) True
      in act
        pm0 <- respond-json (pk-to-json 0 0 0 0 0 0 0 0 [] [])
        ns
      end
    else if text-starts-with path "/api/poker/step" then
      if store.pk-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let r2 = rng-next (store.pk-rng)
      in let deck = poker-shuffle poker-deck-new r2
      in let h1 = deal-hand deck 0
      in let h2 = deal-hand deck 5
      in let rank1 = evaluate-hand h1
      in let rank2 = evaluate-hand h2
      in let winner = compare-hands rank1 rank2
      in let nw = if winner == 1 then store.pk-wins + 1 else store.pk-wins
      in let nl = if winner == 2 then store.pk-losses + 1 else store.pk-losses
      in let nh = store.pk-hands + 1
      in let ns = set-pk store nw nl nh r2 (if nh >= 10 then False else True)
      in act
        pm0 <- respond-json (pk-to-json nw nl nh (rank1.rank) (rank2.rank) (rank1.primary) (rank2.primary) winner (h1.cards) (h2.cards))
        ns
      end
    else act pm0 <- respond-json (pk-to-json (store.pk-wins) (store.pk-losses) (store.pk-hands) 0 0 0 0 0 [] [])
        store
      end

  handle-sp : GameStore, Text, Text -> [Console] GameStore
  handle-sp (store) (line) (path) =
    if text-starts-with path "/api/spider/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let st = spider-new seed
      in let ns = set-sp store st True
      in act
        pm0 <- respond-json (sp-to-json st)
        ns
      end
    else if text-starts-with path "/api/spider/step" then
      if store.sp-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let mv = sp-find-best-move (store.sp-state)
      in if mv < 0 then
        let st2 = if list-length ((store.sp-state).stock) > 0 then sp-deal-stock (store.sp-state) else store.sp-state
        in let done = list-length (st2.stock) <= 0
        in if mv < 0 then
          if done then
            let ns = set-sp store st2 False
            in act
              pm0 <- respond-json (sp-to-json st2)
              ns
            end
          else let ns = set-sp store st2 True
          in act
            pm0 <- respond-json (sp-to-json st2)
            ns
          end
        else let ns = set-sp store st2 True
        in act
          pm0 <- respond-json (sp-to-json st2)
          ns
        end
      else let from-col = mv / 100
      in let rem = mv - from-col * 100
      in let seq-start = rem / 10
      in let to-col = rem - seq-start * 10
      in let move = SpiderMove { from-col = from-col, seq-start = seq-start, to-col = to-col }
      in let next = sp-apply-move (store.sp-state) move
      in let checked = sp-check-complete next (to-col)
      in let ns = set-sp store checked (if checked.completed-suits >= 8 then False else True)
      in act
        pm0 <- respond-json (sp-to-json checked)
        ns
      end
    else act pm0 <- respond-json (sp-to-json (store.sp-state))
        store
      end

  handle-br-game : GameStore, Text, Text -> [Console] GameStore
  handle-br-game (store) (line) (path) =
    if text-starts-with path "/api/bridge/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let ns = set-br store 0 0 0 (rng-new seed) True
      in act
        pm0 <- respond-json (br-to-json 0 0 0 0 0 (-1))
        ns
      end
    else if text-starts-with path "/api/bridge/step" then
      if store.br-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let seed-val = rng-range (store.br-rng) 1 99999
      in let result = run-bridge-hand seed-val
      in let r2 = rng-next (store.br-rng)
      in let new-ns = store.br-ns + result.score
      in let nh = store.br-hands + 1
      in let ns = set-br store new-ns (store.br-ew) nh r2 (if nh >= 8 then False else True)
      in act
        pm0 <- respond-json (br-to-json new-ns (store.br-ew) nh (result.tricks-made) (result.contract-level) (-1))
        ns
      end
    else act pm0 <- respond-json (br-to-json (store.br-ns) (store.br-ew) (store.br-hands) 0 0 (-1))
        store
      end

  handle-pn : GameStore, Text, Text -> [Console] GameStore
  handle-pn (store) (line) (path) =
