  BgStepResult = record {
    board  : BackgammonBoard,
    rng    : Rng,
    d1     : Integer,
    d2     : Integer,
    done   : Boolean,
    winner : Integer
  }

  game-store-new : GameStore
  game-store-new =
    let r = rng-new 1
    in GameStore {
      bg-board = backgammon-new, bg-rng = r, bg-ply = 0, bg-active = False,
      ttt-board = ttt-new, ttt-moves = 0, ttt-active = False,
      ms-state = ms-new r, ms-active = False,
      ck-board = checkers-new 1, ck-moves = 0, ck-active = False, ck-rng = r,
      c4-board = connect4-new, c4-moves = 0, c4-active = False,
      go-board = go-new, go-moves = 0, go-active = False, go-rng = r,
      ot-board = othello-new, ot-active = False,
      mn-board = mancala-new 4, mn-active = False, mn-rng = r,
      hx-board = hex-new, hx-active = False,
      g2-state = g2048-new r, g2-active = False,
      lf-state = life-seed-grid 1, lf-gen = 0, lf-active = False,
      db-board = dots-new r, db-active = False,
      bs-state = BsState { p1-ships = bs-empty-grid, p1-tracking = bs-empty-grid, p2-ships = bs-empty-grid, p2-tracking = bs-empty-grid, p1-hits = 0, p2-hits = 0, p1-shots = 0, p2-shots = 0, rng = r, game-over = False, winner = 0 }, bs-active = False,
      mj-state = mahjong-new 1, mj-active = False,
      yh-state = yh-init 1, yh-turn = 0, yh-active = False,
      wr-state = war-init 1, wr-round = 0, wr-active = False,
      rp-state = rps-init 1, rp-round = 0, rp-active = False,
      ur-board = ur-new, ur-rng = r, ur-active = False,
      gf-state = gf-init 1 2, gf-active = False,
      ce-state = ce-init 1 2, ce-active = False,
      ld-state = ld-init 1 4, ld-active = False,
      bj-state = bj-fresh-state r, bj-phase = 0, bj-wins = 0, bj-losses = 0, bj-pushes = 0, bj-hands = 0, bj-rng = r, bj-active = False,
      wr-p1card = (-1), wr-p2card = (-1),
      pk-wins = 0, pk-losses = 0, pk-hands = 0, pk-rng = r, pk-active = False,
      sp-state = spider-new 1, sp-active = False,
      br-ns = 0, br-ew = 0, br-hands = 0, br-rng = r, br-active = False,
      pn-t0 = 0, pn-t1 = 0, pn-hands = 0, pn-rng = r, pn-active = False,
      pv-wins = 0, pv-losses = 0, pv-hands = 0, pv-rng = r, pv-active = False,
      mm-secret = 0, mm-guesses = 0, mm-feedback = 0, mm-guess = 0, mm-pool = [], mm-active = False, mm-rng = r,
      mo-state = mono-init 1 4, mo-active = False,
      ri-state = risk-init 1 4, ri-rng = r, ri-active = False,
      hw-units = [], hw-config = scenario-stalingrad, hw-turn = 0, hw-rng = r, hw-active = False,
      sg-state = set-game-new 1, sg-active = False,
      store-rng = r
    }

Section: Store Updaters

  set-bg : GameStore, BackgammonBoard, Rng, Integer, Boolean -> GameStore
  set-bg (s) (b) (r) (p) (a) =
    let s1 = __record-set s "bg-board" b
    in let s2 = __record-set s1 "bg-rng" r
    in let s3 = __record-set s2 "bg-ply" p
    in __record-set s3 "bg-active" a

