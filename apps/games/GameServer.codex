      in let r2 = rng-next (store.ri-rng)
      in let checked = risk-check-winner next
      in let ns = set-ri store checked r2 (if checked.game-over then False else if checked.turn-number >= 100 then False else True)
      in act
        pm0 <- respond-json (ri-to-json checked)
        ns
      end
    else act pm0 <- respond-json (ri-to-json (store.ri-state))
