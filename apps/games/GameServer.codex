  handle-pv : GameStore, Text, Text -> [Console] GameStore
  handle-pv (store) (line) (path) =
    if text-starts-with path "/api/pokervariants/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let ns = set-pv store 0 0 0 (rng-new seed) True
      in act
        pm0 <- respond-json (pv-to-json 0 0 0)
        ns
      end
    else if text-starts-with path "/api/pokervariants/step" then
      if store.pv-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else let seed-val = rng-range (store.pv-rng) 1 99999
      in let result = run-poker-variant FiveCardDraw seed-val 4
      in let r2 = rng-next (store.pv-rng)
      in let nw = if result.winner == 1 then store.pv-wins + 1 else store.pv-wins
      in let nl = if result.winner /= 1 then store.pv-losses + 1 else store.pv-losses
      in let nh = store.pv-hands + 1
      in let ns = set-pv store nw nl nh r2 (if nh >= 8 then False else True)
      in act
        pm0 <- respond-json (pv-to-json nw nl nh)
        ns
      end
    else act pm0 <- respond-json (pv-to-json (store.pv-wins) (store.pv-losses) (store.pv-hands))
        store
