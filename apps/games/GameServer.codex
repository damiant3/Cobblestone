  handle-go : GameStore, Text, Text -> [Console] GameStore
  handle-go (store) (line) (path) =
    if text-starts-with path "/api/go/new" then
      let seed = parse-int (extract-query-param line "seed") 42
      in let board = go-new
      in let ns = set-go store board 0 (rng-new seed) True
      in act
        pm0 <- respond-json (go-to-json board 0 (-1))
        ns
      end
    else if text-starts-with path "/api/go/step" then
      if store.go-active == False then act pm0 <- respond-error "no active game"
        store
      end
      else if text-starts-with path "/api/go/step-diag" then
        act
          pm0 <- respond-json (go-to-json (store.go-board) (store.go-moves) (-99))
          store
        end
      else let ob = store.go-board
      in let rng2 = rng-next (store.go-rng)
      in let center-idx = rng-mod (rng-value rng2) 81
      in let mv = if list-at (ob.stones) center-idx == 0 then center-idx else go-find-empty ob 0
      in let next = go-place-stone ob mv
      in let nm = store.go-moves + 1
      in let over = if next.game-over then True else if nm > 200 then True else False
      in let ns = set-go store next nm rng2 (if over then False else True)
      in act
        pm0 <- respond-json (go-to-json next nm mv)
        ns
      end
    else act pm0 <- respond-json (go-to-json (store.go-board) (store.go-moves) (-1))
        store
      end

