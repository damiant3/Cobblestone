      else let next = ttt-step (store.ttt-board)
      in let nm = store.ttt-moves + 1
      in let ns = set-ttt store next nm (if next.game-over then False else True)
      in act
        pm0 <- respond-json (ttt-to-json next nm)
        ns
      end
    else act pm0 <- respond-json (ttt-to-json (store.ttt-board) (store.ttt-moves))
        store
      end

