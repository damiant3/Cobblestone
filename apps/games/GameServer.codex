Section: Backgammon

  bg-step : BackgammonBoard, Rng -> BgStepResult
  bg-step (b) (r) =
    let r1 = rng-next r
    in let r2 = rng-next r1
    in let d1 = rng-range r1 1 6
    in let d2 = rng-range r2 1 6
    in let b1 = bg-apply-die b d1
    in let b2 = bg-apply-die b1 d2
    in let b3 = if d1 == d2 then bg-apply-die b2 d1 else b2
    in let b4 = if d1 == d2 then bg-apply-die b3 d2 else b3
    in let next-player = 1 - b.current-player
    in let b5 = __record-set b4 "current-player" next-player
    in let done = bg-check-win b5
    in let w = if done then bg-winner b5 else (-1)
    in BgStepResult { board = b5, rng = r2, d1 = d1, d2 = d2, done = done, winner = w }

Section: JSON Helpers

  int-list-to-json : List Integer, Integer, Integer, List JsonValue -> List JsonValue
  int-list-to-json (xs) (i) (len) (acc) =
    if i >= len then acc
    else int-list-to-json xs (i + 1) len (list-push acc (json-int (list-at xs i)))

  respond-json : Text -> [Console] Integer
  respond-json (body) = act
    print-line-uni ("200 application/json " & body)
    0
  end

  respond-error : Text -> [Console] Integer
  respond-error (msg) = act
    print-line-uni ("400 application/json {\"error\":\"" & msg & "\"}")
    0
  end

  respond-not-found : [Console] Integer
  respond-not-found = act
    print-line-uni "404 text/plain Not Found"
    0
  end

Section: Board JSON Serializers

  bg-to-json : BackgammonBoard, Integer, Integer, Integer, Boolean, Integer -> Text
  bg-to-json (b) (ply) (d1) (d2) (done) (winner) =
    let pts = int-list-to-json (b.points) 0 24 []
    in json-emit (json-object [
      json-pair "points" (json-array pts),
      json-pair "barW" (json-int (b.bar-white)),
      json-pair "barB" (json-int (b.bar-black)),
      json-pair "offW" (json-int (b.off-white)),
      json-pair "offB" (json-int (b.off-black)),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "ply" (json-int ply),
      json-pair "d1" (json-int d1), json-pair "d2" (json-int d2),
      json-pair "done" (json-bool done),
      json-pair "winner" (json-int winner)
    ])

  ttt-to-json : TttBoard, Integer -> Text
  ttt-to-json (b) (moves) =
    let sq = int-list-to-json (b.squares) 0 9 []
    in json-emit (json-object [
      json-pair "squares" (json-array sq),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "moves" (json-int moves),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "winner" (json-int (b.winner))
    ])

  ms-to-json : MinesweeperState -> Text
  ms-to-json (st) =
    let rev = int-list-to-json (st.revealed) 0 81 []
    in let adj = int-list-to-json (st.adjacent) 0 81 []
    in let mines = int-list-to-json (st.mine-grid) 0 81 []
    in json-emit (json-object [
      json-pair "revealed" (json-array rev),
      json-pair "adjacent" (json-array adj),
      json-pair "mines" (if st.game-over then json-array mines else json-array []),
      json-pair "cellsRevealed" (json-int (st.cells-revealed)),
      json-pair "minesHit" (json-int (st.mines-hit)),
      json-pair "moves" (json-int (st.moves)),
      json-pair "done" (json-bool (st.game-over)),
      json-pair "won" (json-bool (st.won))
    ])

  ck-to-json : CheckerBoard, Integer -> Text
  ck-to-json (b) (moves) =
    let cells = int-list-to-json (b.cells) 0 64 []
    in json-emit (json-object [
      json-pair "cells" (json-array cells),
      json-pair "cur" (json-int (b.turn)),
      json-pair "moves" (json-int moves),
      json-pair "done" (json-bool (b.over)),
      json-pair "winner" (json-int (b.winner))
    ])

  c4-to-json : Connect4Board, Integer -> Text
  c4-to-json (b) (moves) =
    let sq = int-list-to-json (b.squares) 0 42 []
    in json-emit (json-object [
      json-pair "squares" (json-array sq),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "moves" (json-int moves),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "winner" (json-int (b.winner))
    ])

  go-to-json : GoBoard, Integer, Integer -> Text
  go-to-json (b) (moves) (last-mv) =
    let stones = int-list-to-json (b.stones) 0 81 []
    in json-emit (json-object [
      json-pair "stones" (json-array stones),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "moves" (json-int moves),
      json-pair "blackCap" (json-int (b.black-captures)),
      json-pair "whiteCap" (json-int (b.white-captures)),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "blackScore" (json-int (b.black-score)),
      json-pair "whiteScore" (json-int (b.white-score)),
      json-pair "passes" (json-int (b.passes)),
      json-pair "ko" (json-int (b.ko-point)),
      json-pair "lastMv" (json-int last-mv)
    ])

  ot-to-json : OthelloBoard -> Text
  ot-to-json (b) =
    let cells = int-list-to-json (b.cells) 0 64 []
    in json-emit (json-object [
      json-pair "cells" (json-array cells),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "moves" (json-int (b.moves-made)),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "black" (json-int (b.black-count)),
      json-pair "white" (json-int (b.white-count))
    ])

  mn-to-json : MancalaBoard -> Text
  mn-to-json (b) =
    let pits = int-list-to-json (b.pits) 0 14 []
    in json-emit (json-object [
      json-pair "pits" (json-array pits),
      json-pair "cur" (json-int (b.turn)),
      json-pair "done" (json-bool (b.over))
    ])


  hx-to-json : HexBoard -> Text
  hx-to-json (b) =
    let cells = int-list-to-json (b.cells) 0 121 []
    in json-emit (json-object [
      json-pair "cells" (json-array cells),
      json-pair "cur" (json-int (b.current-player)),
      json-pair "moves" (json-int (b.moves-made)),
      json-pair "done" (json-bool (b.game-over)),
      json-pair "winner" (json-int (b.winner))
    ])

  g2-to-json : G2048State -> Text
  g2-to-json (st) =
    let grid = int-list-to-json (st.grid) 0 16 []
    in json-emit (json-object [
      json-pair "grid" (json-array grid),
      json-pair "score" (json-int (st.score)),
      json-pair "moves" (json-int (st.moves)),
      json-pair "done" (json-bool (st.game-over))
    ])

  lf-to-json : LifeState, Integer -> Text
  lf-to-json (st) (gen) =
    let cells = int-list-to-json (st.cells) 0 400 []
