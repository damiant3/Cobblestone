 GPU-accelerated 3D demo. The guest does matrix transforms and
 Phong lighting in Codex, writes a triangle command buffer to RAM,
 then fires port 0x400 to trigger native-speed C rasterization on
 the host. Full 640x480 at interactive frame rates.

 We say:

Section: Constants

  sw : Integer = 640
  sh : Integer = 480
  kb-addr : Integer = 28680

Section: Entry

  opening : [Console, Device.Port, Gpu.Compute, Gpu.Memory] Nothing = act
    result <- demo-main 0
    print-line-uni result
  end

  demo-main : Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Text
  demo-main (dummy) =
    let scene = demo-build-scene
    in demo-loop scene 0 300 6000 0

Section: Scene

  demo-build-scene : Scene3DState
  demo-build-scene =
    let cam = camera3d-new (vec3-new 0.0 3000.0 6000.0) (vec3-new 0.0 500.0 0.0) 0.785
    in let scene = scene3d-new cam
    in let cube-node = sn3-set-pos (sn3-with-mesh "cube" (mesh-cube 600) (emat-shiny (rgb 100 140 220) 32)) 0.0 600.0 0.0
    in let ground-node = sn3-with-mesh "ground" (mesh-plane 4000 4000) (emat-flat (rgb 100 85 65))
    in let pyr-node = sn3-set-pos (sn3-with-mesh "pyr" (mesh-pyramid 500 900) emat-red) 1800.0 0.0 (-600.0)
    in let cube2-node = sn3-set-pos (sn3-with-mesh "cube2" (mesh-cube 400) emat-gold) (-1500.0) 400.0 500.0
    in let pyr2-node = sn3-set-pos (sn3-with-mesh "pyr2" (mesh-pyramid 350 600) (emat-shiny (rgb 80 200 120) 16)) (-800.0) 0.0 (-1200.0)
    in let s2 = scene3d-add (scene3d-add (scene3d-add (scene3d-add (scene3d-add scene cube-node) ground-node) pyr-node) cube2-node) pyr2-node
    in let light1 = dir-light (vec3-new (-400.0) 800.0 400.0) (rgb 255 250 235) 850
    in let light2 = dir-light (vec3-new 300.0 500.0 (-600.0)) (rgb 160 180 220) 350
    in scene3d-set-ambient (scene3d-add-light (scene3d-add-light s2 light1) light2) 250

Section: GPU Render (build cmd buffer + fire)

  demo-view : GpuView = gv-new 0 0 sw sh

  demo-sky : Integer = #101028

  demo-gpu-render : Scene3DState, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  demo-gpu-render (scene) (yaw) (pitch) (dist) =
    gs-render-full (scene3d-set-camera scene (demo-orbit yaw pitch dist)) demo-view demo-sky

Section: Animation Loop

 The keyboard poll is a port read, so it is an act-bind. The frame's
 scratch heap is saved before the render and reclaimed after it, which
 is why the frame is two functions: __heap-restore has to run on the far
 side of an effectful call, and a let cannot bind one.

  demo-loop : Scene3DState, Integer, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Text
  demo-loop (scene) (yaw) (pitch) (dist) (frame) = act
    dummy <- port-in-byte 96
    let sc = peek-byte kb-addr 0
    in let ack = poke-byte kb-addr 0 0
    in let yaw2 = yaw + 8
    in if sc == 16 then "quit"
    else let y3 = if sc == 75 then yaw2 - 200 else if sc == 77 then yaw2 + 200 else yaw2
    in let p2 = if sc == 72 then gs-clamp (pitch + 100) (-700) 700 else if sc == 80 then gs-clamp (pitch - 100) (-700) 700 else pitch
    in let d2 = if sc == 78 then gs-clamp (dist - 500) 2000 20000 else if sc == 74 then gs-clamp (dist + 500) 2000 20000 else dist
    in demo-frame scene y3 p2 d2 frame
  end

  demo-frame : Scene3DState, Integer, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Text
  demo-frame (scene) (yaw) (pitch) (dist) (frame) =
    let hp = __heap-save
    in demo-frame-done scene yaw pitch dist frame hp

  demo-frame-done : Scene3DState, Integer, Integer, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Text
  demo-frame-done (scene) (yaw) (pitch) (dist) (frame) (hp) = act
    w <- demo-gpu-render scene yaw pitch dist
    let restored = __heap-restore hp
    in demo-loop scene yaw pitch dist (frame + 1)
  end

Section: Orbit Camera

  demo-orbit : Integer, Integer, Integer -> Camera3D
  demo-orbit (yaw) (pitch) (dist) =
    let sy = gpu-sin yaw
    in let cy = gpu-cos yaw
    in let sp = gpu-sin pitch
    in let cp = gpu-cos pitch
    in camera3d-new (vec3-new (real-from-int (sy * cp * dist / 1000000)) (real-from-int (sp * dist / 1000)) (real-from-int (cy * cp * dist / 1000000))) (vec3-new 0.0 500.0 0.0) 0.785

Section: Helpers

  gpu-sin : Integer -> Integer
  gpu-sin (raw) =
    let a = gpu-wrap raw
    in if a <= 1570 then gpu-sin-core a
    else if a <= 3141 then gpu-sin-core (3141 - a)
    else if a <= 4712 then 0 - gpu-sin-core (a - 3141)
    else 0 - gpu-sin-core (6283 - a)

  gpu-cos : Integer -> Integer
  gpu-cos (raw) = gpu-sin (raw + 1570)

  gpu-sin-core : Integer -> Integer
  gpu-sin-core (x) =
    let x2 = x * x / 1000
    in let x3 = x2 * x / 1000
    in let x5 = x3 * x2 / 1000
    in x - x3 / 6 + x5 / 120

  gpu-wrap : Integer -> Integer
  gpu-wrap (a) = let m = a - (a / 6283) * 6283 in if m < 0 then m + 6283 else m

