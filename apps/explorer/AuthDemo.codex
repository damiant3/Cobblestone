Chapter: AuthDemo
  cites Net chapter WebServer
  cites Net chapter Accounts

 We say:

  app-route : Maybe Account, Text -> Text
  app-route (who) (path) =
    when who
      is None -> "{\"message\":\"hello, stranger\"}"
      is Just (a) -> "{\"message\":\"welcome back\",\"handle\":" & jstr (a.handle) & ",\"id\":" & show (a.acc-id) & "}"

  opening : [Console, Device.Block, Network.Read, Network.Write] Nothing = act
    r <- auth-serve (app-route)
    print-line-uni "SHUTDOWN"
  end

