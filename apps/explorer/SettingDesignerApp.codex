Chapter: SettingDesignerApp
  cites Explorer chapter ExplorerTheme

 Setting/landscape designer. Compiled through the HTML plug.
 DOM stubs, theme types, and dark-gold theme from ExplorerTheme.

 We say:

Section: Data

  BiomeDef = record { name : Text, traits : Text }
  TimeDef = record { name : Text, lighting : Text }
  WeatherDef = record { name : Text, effects : Text }
  MoodDef = record { name : Text, tone : Text }
  ScaleDef = record { name : Text, framing : Text }

  biome-defs : List BiomeDef
  biome-defs = [
    BiomeDef { name = "Forest", traits = "dense ancient forest, massive trees, dappled sunlight, ferns and moss" },
    BiomeDef { name = "Desert", traits = "vast desert dunes, golden sand, heat shimmer, distant oasis" },
    BiomeDef { name = "Cavern", traits = "underground cavern, stalactites, crystal formations, underground river" },
    BiomeDef { name = "Ruins", traits = "ancient stone ruins, crumbling pillars, overgrown with vines" },
    BiomeDef { name = "Volcanic", traits = "volcanic landscape, molten lava flows, obsidian rock, ash clouds" },
    BiomeDef { name = "Tundra", traits = "frozen tundra, ice sheets, northern lights aurora, snow mountains" },
    BiomeDef { name = "Ocean", traits = "open ocean, towering waves, sea spray, distant island" },
    BiomeDef { name = "Mountain", traits = "alpine mountain peaks, snow-capped summits, rocky cliffs" },
    BiomeDef { name = "Swamp", traits = "murky swamp, twisted dead trees, fog, glowing mushrooms" },
    BiomeDef { name = "City", traits = "medieval fantasy city, cobblestone streets, timber buildings" },
    BiomeDef { name = "Castle", traits = "massive stone fortress, battlements and towers, drawbridge" },
    BiomeDef { name = "Elven City", traits = "ethereal elven city in giant trees, bioluminescent flowers" }
  ]

  time-defs : List TimeDef
  time-defs = [
    TimeDef { name = "Dawn", lighting = "golden hour dawn, warm pink and orange sky, long shadows" },
    TimeDef { name = "Day", lighting = "bright midday sun, clear blue sky, sharp shadows, vibrant" },
    TimeDef { name = "Dusk", lighting = "dramatic sunset, purple and red sky, warm golden light" },
    TimeDef { name = "Night", lighting = "moonlit night, blue shadows, stars visible, torchlight" },
    TimeDef { name = "Overcast", lighting = "overcast grey sky, diffused soft light, muted colors" }
  ]

  weather-defs : List WeatherDef
  weather-defs = [
    WeatherDef { name = "Clear", effects = "clear weather, crisp air" },
    WeatherDef { name = "Rain", effects = "heavy rain, puddles, dark clouds, wet surfaces" },
    WeatherDef { name = "Fog", effects = "thick fog, limited visibility, mysterious atmosphere" },
    WeatherDef { name = "Storm", effects = "thunderstorm, lightning bolts, dramatic clouds" },
    WeatherDef { name = "Snow", effects = "falling snow, frost on surfaces, white blanket" }
  ]

  mood-defs : List MoodDef
  mood-defs = [
    MoodDef { name = "Peaceful", tone = "serene peaceful atmosphere, safe haven, gentle beauty" },
    MoodDef { name = "Tense", tone = "ominous tension, danger lurking, uneasy stillness" },
    MoodDef { name = "Battle", tone = "active battle scene, destruction, fire and smoke, chaos" },
    MoodDef { name = "Mysterious", tone = "mysterious and enigmatic, hidden secrets, arcane energy" },
    MoodDef { name = "Epic", tone = "grand epic scale, awe-inspiring, monumental, heroic" },
    MoodDef { name = "Desolate", tone = "abandoned desolate wasteland, emptiness, decay" }
  ]

  scale-defs : List ScaleDef
  scale-defs = [
    ScaleDef { name = "Vista 16:9", framing = "epic wide establishing shot, vast landscape, cinematic" },
    ScaleDef { name = "Scene 3:2", framing = "medium shot, environmental scene, adventure setting" },
    ScaleDef { name = "Token 1:1", framing = "top-down map token, battle grid square, tabletop RPG" },
    ScaleDef { name = "Map 2:3", framing = "vertical dungeon map, corridor and rooms, top-down" },
    ScaleDef { name = "Banner 3:1", framing = "panoramic banner, ultra-wide landscape" }
  ]

Section: Prompt

  build-setting-prompt : BiomeDef, TimeDef, WeatherDef, MoodDef, ScaleDef, Text -> Text
  build-setting-prompt (biome) (time) (weather) (mood) (scale) (extra) =
    biome.traits & ", " & time.lighting & ", " & weather.effects & ", " & mood.tone & ", " & scale.framing & ", fantasy game environment concept art, matte painting, highly detailed landscape, masterpiece, best quality, 4k, sharp focus" & (if text-length extra > 0 then ", " & extra else "")

  setting-negative : Text
  setting-negative = "blurry, low quality, deformed, text, watermark, person, character, nsfw, UI elements"

Section: Name Extraction

  biome-names : List Text
  biome-names = xn-b biome-defs 0 []
  xn-b : List BiomeDef, Integer, List Text -> List Text
  xn-b (xs) (i) (acc) = if i >= list-length xs then acc else xn-b xs (i + 1) (list-push acc (list-at xs i).name)

  time-names : List Text
  time-names = xn-t time-defs 0 []
  xn-t : List TimeDef, Integer, List Text -> List Text
  xn-t (xs) (i) (acc) = if i >= list-length xs then acc else xn-t xs (i + 1) (list-push acc (list-at xs i).name)

  weather-names : List Text
  weather-names = xn-w weather-defs 0 []
  xn-w : List WeatherDef, Integer, List Text -> List Text
  xn-w (xs) (i) (acc) = if i >= list-length xs then acc else xn-w xs (i + 1) (list-push acc (list-at xs i).name)

  mood-names : List Text
  mood-names = xn-mo mood-defs 0 []
  xn-mo : List MoodDef, Integer, List Text -> List Text
  xn-mo (xs) (i) (acc) = if i >= list-length xs then acc else xn-mo xs (i + 1) (list-push acc (list-at xs i).name)

  scale-names : List Text
  scale-names = xn-s scale-defs 0 []
  xn-s : List ScaleDef, Integer, List Text -> List Text
  xn-s (xs) (i) (acc) = if i >= list-length xs then acc else xn-s xs (i + 1) (list-push acc (list-at xs i).name)

Section: Controls

  render-controls : Integer, Integer, Integer, Integer, Integer -> Text
  render-controls (sb) (st) (sw) (sm) (ss) =
    "<div class=\"dimbar\">"
    & dim-pill "Biome" (selected-name biome-names sb) (build-dropdown-items biome-names sb "biome" 0 "")
    & dim-pill "Time" (selected-name time-names st) (build-dropdown-items time-names st "time" 0 "")
    & dim-pill "Weather" (selected-name weather-names sw) (build-dropdown-items weather-names sw "weather" 0 "")
    & dim-pill "Mood" (selected-name mood-names sm) (build-dropdown-items mood-names sm "mood" 0 "")
    & dim-pill "Scale" (selected-name scale-names ss) (build-dropdown-items scale-names ss "scale" 0 "")
    & "</div>"
    & "<div class=\"prow\"><textarea id=\"prompt\" placeholder=\"Landmarks, creatures, architectural style...\"></textarea><div class=\"pc\"><label>Seed</label><input id=\"seed\" type=\"number\" value=\"424242\"></div></div>"
    & "<div class=\"tb\"><button class=\"btn primary\" onclick=\"do_generate(0)\">Generate</button><button class=\"btn\" onclick=\"random_seed(0)\">Random Seed</button></div>"

Section: Page

  build-page : Integer, Integer, Integer, Integer, Integer -> Text
  build-page (sb) (st) (sw) (sm) (ss) =
    explorer-nav "setting"
    & "<div class=\"page\"><div class=\"left\"><div class=\"hd\"><h1>Setting Designer</h1><div id=\"controls\" class=\"ctrl\">" & render-controls sb st sw sm ss & "</div></div>"
    & "<div class=\"hero\" id=\"hero\"><img id=\"hero-img\" style=\"display:none\" onclick=\"document.getElementById('lb').classList.add('on');document.getElementById('lb-img').src=this.src\"><div class=\"he\" id=\"hero-empty\">Generate a setting to see it here</div><div id=\"hero-meta\" class=\"hm\"></div></div></div>"
    & "<div class=\"hist\"><h3>History</h3><div id=\"history\"></div></div></div>"
    & "<div class=\"lb\" id=\"lb\" onclick=\"close_lb(0)\"><span class=\"x\">&times;</span><img id=\"lb-img\"></div>"

Section: Callbacks

  pick : Text, Integer -> Integer
  pick (group) (idx) =
    let s1 = if group == "biome" then state-set "sb" idx else state-get "sb"
    in let s2 = if group == "time" then state-set "st" idx else state-get "st"
    in let s3 = if group == "weather" then state-set "sw" idx else state-get "sw"
    in let s4 = if group == "mood" then state-set "sm" idx else state-get "sm"
    in let s5 = if group == "scale" then state-set "ss" idx else state-get "ss"
    in let ctrl = dom-get "controls"
    in let c2 = dom-set-html ctrl (render-controls s1 s2 s3 s4 s5)
    in 0

  meta-html : Text, Text, Text, Text, Text, Integer -> Text
  meta-html (bname) (tname) (wname) (mname) (sname) (seed) =
    "<div class=\"rm\"><span class=\"mt\">" & bname & "</span><span class=\"mt\">" & tname & "</span><span class=\"mt\">" & wname & "</span><span class=\"mt\">" & mname & "</span><span class=\"mt\">" & sname & "</span><span class=\"mt md\">seed:" & show seed & "</span></div>"

  add-run : Text, Text, Text, Text, Text, Integer -> Text
  add-run (bname) (tname) (wname) (mname) (sname) (seed) =
    let cid = next-card-id 0
    in let hist = dom-get "history"
    in let card = dom-create "div"
    in let c2 = dom-add-class card "rc"
    in let c3 = dom-set-attr card "id" cid
    in let ch = "<div class=\"ri\"><div class=\"sp\"></div><img src=\"\" onclick=\"if(this.src&&this.src.indexOf('data:')<0){document.getElementById('hero-img').src=this.src;document.getElementById('hero-img').style.display='';document.getElementById('hero-empty').style.display='none'}\"></div>" & meta-html bname tname wname mname sname seed
    in let c4 = dom-set-html card ch
    in let c5 = dom-prepend hist card
    in cid

  do-generate : Integer -> Integer
  do-generate (x) =
    let sb = state-get "sb"
    in let st = state-get "st"
    in let sw = state-get "sw"
    in let sm = state-get "sm"
    in let ss = state-get "ss"
    in let biome = list-at biome-defs sb
    in let time = list-at time-defs st
    in let weather = list-at weather-defs sw
    in let mood = list-at mood-defs sm
    in let scale = list-at scale-defs ss
    in let extra = dom-get-value (dom-get "prompt")
    in let seed = 424242
    in let prompt = build-setting-prompt biome time weather mood scale extra
    in let body = "{\"prompt\":\"" & prompt & "\",\"negative_prompt\":\"" & setting-negative & "\",\"model_title\":\"\",\"model_short\":\"default\",\"sampler\":\"DPM++ SDE\",\"steps\":12,\"cfg\":2,\"lora\":\"\",\"lora_short\":\"none\",\"seed\":" & show seed & ",\"width\":1280,\"height\":720}"
    in let hm = dom-get "hero-meta"
    in let h2 = dom-set-html hm ("<b>" & biome.name & "</b> - " & time.name & ", " & weather.name & ", " & mood.name)
    in let cid = add-run (biome.name) (time.name) (weather.name) (mood.name) (scale.name) seed
    in generate-image "/api/generate" body cid

  random-seed : Integer -> Integer
  random-seed (x) = random-seed-cb x

  close-lb : Integer -> Integer
  close-lb (x) = close-lb-cb x

Section: Entry

  init-state : Integer -> Integer
  init-state (x) =
    let s1 = state-set "sb" 0
    in let s2 = state-set "st" 1
    in let s3 = state-set "sw" 0
    in let s4 = state-set "sm" 0
    in let s5 = state-set "ss" 0
    in 0

  opening : Integer -> [Console] Nothing
  opening (x) = act
    let st = init-state 0
    in let ex = init-explorer 0
    in let app = dom-get "app"
    in let a2 = dom-set-html app (build-page 0 1 0 0 0)
    in print-line-uni ""
  end

