Chapter: SettingDesignerApp
  cites Explorer chapter ExplorerTheme

 Setting/landscape designer, fully DB-backed. The page ships no content:
 at load it fetches each dimension's rows from the bare-metal DB server
 over AJAX (/api/d/<table>) and builds the pip tree from the fetched rows.
 Each row is [name, prompt-fragment]; selections index into the parsed rows
 (tbl-field) for both the visible name and the prompt fragment. The fetch
 helpers (parse-table / tbl-names / tbl-field) live in ExplorerTheme.

 We say:

Section: Prompt

  setting-negative : Text
  setting-negative = "blurry, low quality, deformed, text, watermark, person, character, nsfw, UI elements"

  setting-suffix : Text
  setting-suffix = ", fantasy game environment concept art, matte painting, highly detailed landscape, masterpiece, best quality, 4k, sharp focus"

  build-setting-prompt : Integer, Integer, Integer, Integer, Integer, Text -> Text
  build-setting-prompt (sb) (st) (sw) (sm) (ss) (extra) =
    tbl-field "dBiome" sb 1 & ", " & tbl-field "dTime" st 1 & ", " & tbl-field "dWeather" sw 1 & ", " & tbl-field "dMood" sm 1 & ", " & tbl-field "dScale" ss 1 & setting-suffix & (if text-length extra > 0 then ", " & extra else "")

Section: UI Tree

  biome-cats : List (List Text), List Text, Integer, Integer, List WidgetNode -> List WidgetNode
  biome-cats (groups) (bnames) (i) (n) (acc) =
    if i >= n then acc
    else let g = list-at groups i
    in let from = text-to-int (list-at g 1)
    in let to = text-to-int (list-at g 2)
    in biome-cats groups bnames (i + 1) n (list-push acc (widget-cat-range ("bg" & show i) (list-at g 0) bnames from to))

  biome-dimsel : Integer -> WidgetNode
  biome-dimsel (sb) =
    let bnames = tbl-names "dBiome"
    in let head = if sb < list-length bnames then list-at bnames sb else "?"
    in let groups = parse-table "dGenres"
    in widget-dimsel "biome" head sb (biome-cats groups bnames 0 (list-length groups) [])

  dims : Integer, Integer, Integer, Integer, Integer -> List WidgetNode
  dims (sb) (st) (sw) (sm) (ss) = [
    biome-dimsel sb,
    widget-dim-flat "time" (tbl-names "dTime") st,
    widget-dim-flat "weather" (tbl-names "dWeather") sw,
    widget-dim-flat "mood" (tbl-names "dMood") sm,
    widget-dim-flat "scale" (tbl-names "dScale") ss
  ]

  dimrow-holder : Integer, Integer, Integer, Integer, Integer -> WidgetNode
  dimrow-holder (sb) (st) (sw) (sm) (ss) =
    widget-panel "dimrow-h" DirRow 0 (dims sb st sw sm ss)

  page-tree : Integer -> WidgetNode
  page-tree (x) = designer-page-tree "setting" "Setting Designer" "Landmarks, creatures, architectural style..."

Section: Fetch Coordination

  rebuild-dims : Integer -> Integer
  rebuild-dims (x) =
    let sb = state-get "sb"
    in let st = state-get "st"
    in let sw = state-get "sw"
    in let sm = state-get "sm"
    in let ss = state-get "ss"
    in mount-widget-into "dimrow" (dimrow-holder sb st sw sm ss)

  bump-and-build : Integer -> Integer
  bump-and-build (x) =
    let c = state-get "loaded" + 1
    in let s = state-set "loaded" c
    in if c >= 6 then rebuild-dims 0 else 0

  cb-biome : Text -> Integer
  cb-biome (s) = let a = state-set-text "dBiome" s in bump-and-build 0
  cb-genres : Text -> Integer
  cb-genres (s) = let a = state-set-text "dGenres" s in bump-and-build 0
  cb-time : Text -> Integer
  cb-time (s) = let a = state-set-text "dTime" s in bump-and-build 0
  cb-weather : Text -> Integer
  cb-weather (s) = let a = state-set-text "dWeather" s in bump-and-build 0
  cb-mood : Text -> Integer
  cb-mood (s) = let a = state-set-text "dMood" s in bump-and-build 0
  cb-scale : Text -> Integer
  cb-scale (s) = let a = state-set-text "dScale" s in bump-and-build 0

Section: Callbacks

  group-key : Text -> Text
  group-key (g) =
    if g == "biome" then "sb"
    else if g == "time" then "st"
    else if g == "weather" then "sw"
    else if g == "mood" then "sm"
    else "ss"

  on-pick : Text, Integer -> Integer
  on-pick (group) (idx) =
    let s = state-set (group-key group) idx
    in rebuild-dims 0

  on-click : Text -> Integer
  on-click (id) =
    if id == "gen" then do-generate 0
    else if id == "rnd" then random-seed 0
    else 0

  meta-html : Text, Text, Text, Text, Text, Text -> Text
  meta-html (bname) (tname) (wname) (mname) (sname) (seed) =
    "<div class=\"rm\"><span class=\"mt\">" & bname & "</span><span class=\"mt\">" & tname & "</span><span class=\"mt\">" & wname & "</span><span class=\"mt\">" & mname & "</span><span class=\"mt\">" & sname & "</span><span class=\"mt md\">seed:" & seed & "</span></div>"

  add-run : Text, Text, Text, Text, Text, Text -> Text
  add-run (bname) (tname) (wname) (mname) (sname) (seed) =
    add-history-card "" (meta-html bname tname wname mname sname seed) hero-click-handler

  do-generate : Integer -> Integer
  do-generate (x) =
    let sb = state-get "sb"
    in let st = state-get "st"
    in let sw = state-get "sw"
    in let sm = state-get "sm"
    in let ss = state-get "ss"
    in let extra = dom-get-value (dom-get "prompt")
    in let seed = dom-get-value (dom-get "seed")
    in let prompt = build-setting-prompt sb st sw sm ss extra
    in let body = gen-body prompt setting-negative seed 1280 720
    in let hm = dom-get "hero-meta"
    in let h2 = dom-set-html hm ("<b>" & tbl-field "dBiome" sb 0 & "</b> - " & tbl-field "dTime" st 0 & ", " & tbl-field "dWeather" sw 0 & ", " & tbl-field "dMood" sm 0)
    in let cid = add-run (tbl-field "dBiome" sb 0) (tbl-field "dTime" st 0) (tbl-field "dWeather" sw 0) (tbl-field "dMood" sm 0) (tbl-field "dScale" ss 0) seed
    in generate-image "/api/generate" body cid

  random-seed : Integer -> Integer
  random-seed (x) = random-seed-cb x

Section: Entry

  init-state : Integer -> Integer
  init-state (x) =
    let s1 = state-set "sb" 0
    in let s2 = state-set "st" 1
    in let s3 = state-set "sw" 0
    in let s4 = state-set "sm" 0
    in let s5 = state-set "ss" 0
    in let s6 = state-set "loaded" 0
    in 0

  opening : Integer -> [Console] None
  opening (x) = act
    let ex = init-explorer 0
    in let st = init-state 0
    in let h = register-handlers (on-pick) (on-click)
    in let m = mount-widget-themed dark-gold (page-tree 0)
    in let f1 = fetch-get-then "/api/d/biomes" (cb-biome)
    in let fg = fetch-get-then "/api/d/genres" (cb-genres)
    in let f2 = fetch-get-then "/api/d/times" (cb-time)
    in let f3 = fetch-get-then "/api/d/weathers" (cb-weather)
    in let f4 = fetch-get-then "/api/d/moods" (cb-mood)
    in let f5 = fetch-get-then "/api/d/scales" (cb-scale)
    in print-line-uni ""
  end

