Chapter: WorldForge
  cites Explorer chapter ExplorerTheme
  cites Explorer chapter NameForge
  cites Explorer chapter StoryGraph

 The World Forge, written entirely in Codex and compiled to JavaScript by the
 html plug. NameForge and StoryGraph run CLIENT-SIDE in the browser: pick a
 seed, an archetype, and a motif, and the page generates a whole named setting
 and a branching story graph -- no server round-trip, no hand-written JS.
 Deterministic: the same seed+archetype+motif is the same world and saga.

 We say:

Section: Select Options

  arc-opt : Text -> Text
  arc-opt (k) = "<option value=\"" & k & "\">" & arc-name (parse-arc k) & "</option>"

  arc-opts-loop : List Text, Integer, Integer, Text -> Text
  arc-opts-loop (xs) (i) (n) (acc) =
    if i >= n then acc else arc-opts-loop xs (i + 1) n (acc & arc-opt (list-at xs i))

  arc-opts : Text
  arc-opts = arc-opts-loop all-arcs 0 (list-length all-arcs) ""

  motif-opt : Text -> Text
  motif-opt (k) = "<option value=\"" & k & "\">" & motif-name (parse-motif k) & "</option>"

  motif-opts-loop : List Text, Integer, Integer, Text -> Text
  motif-opts-loop (xs) (i) (n) (acc) =
    if i >= n then acc else motif-opts-loop xs (i + 1) n (acc & motif-opt (list-at xs i))

  motif-opts : Text
  motif-opts = motif-opts-loop all-motifs 0 (list-length all-motifs) ""

Section: Shell

  wf-css : Text
  wf-css =
    "<style>"
    & ".wf{max-width:1100px;margin:0 auto;padding:28px;font:15px/1.55 system-ui,sans-serif;color:#e8e0c8}"
    & ".wf h1{color:#e9c46a;font-size:26px;margin-bottom:4px}"
    & ".wf .sub{color:#9a8c66;font-size:13px;margin-bottom:22px}"
    & ".wf .ctl{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;background:#16161b;border:1px solid #2a2a33;border-radius:12px;padding:16px;margin-bottom:20px}"
    & ".wf label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#8a8780;margin-bottom:4px}"
    & ".wf input,.wf select{padding:9px 11px;background:#0d0d10;border:1px solid #33333d;border-radius:7px;color:#e8e0c8;font:inherit;min-width:170px}"
    & ".wf button{padding:10px 22px;background:#e9c46a;color:#1a1a1a;border:0;border-radius:7px;font:inherit;font-weight:600;cursor:pointer}"
    & ".wf .out{white-space:pre-wrap;font-family:ui-monospace,monospace;font-size:13px;background:#13130f;border:1px solid #2a2a22;border-radius:10px;padding:16px;margin-bottom:16px;color:#cfc8b0;overflow-x:auto}"
    & "</style>"

  shell : Text
  shell =
    wf-css
    & "<div class=\"wf\">"
    & "<h1>World Forge</h1>"
    & "<div class=\"sub\">Procedural settings and branching story graphs, generated in your browser from one seed. The whole forge is Codex compiled to JavaScript.</div>"
    & "<div class=\"ctl\">"
    & "<div><label>Seed</label><input id=\"wf-seed\" type=\"number\" value=\"42\"></div>"
    & "<div><label>Archetype</label><select id=\"wf-arc\">" & arc-opts & "</select></div>"
    & "<div><label>Motif</label><select id=\"wf-motif\">" & motif-opts & "</select></div>"
    & "<button id=\"wf-go\">Forge</button>"
    & "</div>"
    & "<pre id=\"wf-world\" class=\"out\"></pre>"
    & "<pre id=\"wf-story\" class=\"out\"></pre>"
    & "</div>"

Section: Behaviour

  on-forge : Text -> Integer
  on-forge (id) =
    let seed = text-to-int (dom-get-value (dom-get "wf-seed"))
    in let arc = parse-arc (dom-get-value (dom-get "wf-arc"))
    in let m = parse-motif (dom-get-value (dom-get "wf-motif"))
    in let a = dom-set-text (dom-get "wf-world") (format-setting (forge-setting seed))
    in let b = dom-set-text (dom-get "wf-story") (format-story (forge-story-as seed arc m))
    in 0

Section: Entry

  opening : Integer -> [Console] Nothing
  opening (x) = act
    let app = dom-get "app"
    in let m = dom-set-html app shell
    in let btn = dom-get "wf-go"
    in let w = dom-on-click btn (on-forge)
    in let f = on-forge ""
    in print-line-uni ""
  end
