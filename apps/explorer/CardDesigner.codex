Chapter: CardDesigner

 Card art parameter explorer. Emits through the HTML plug as a
 single-page web app. Renders a prompt input, dimension rows
 (model, sampler, steps, CFG, LoRA), and a cascading pin
 selection system. Images generated on-demand via /api/generate.

 We say:

Section: Styles

  explorer-css : Text
  explorer-css =
    ":root{--gold:#ffd700;--bg:#0a0a0a;--card:#141414;--border:#2a2a2a;--text:#ccc;--dim:#666}"
    & "*{margin:0;padding:0;box-sizing:border-box}"
    & "body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif}"
    & ".header{padding:16px 24px;border-bottom:1px solid var(--border)}"
    & ".header h1{color:var(--gold);font-size:1.4em;margin-bottom:12px}"
    & ".prompt-row{display:flex;gap:10px;align-items:flex-start}"
    & ".prompt-row textarea{flex:1;background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:10px;border-radius:6px;font-size:.9em;resize:none;min-height:5.6em;overflow:hidden;font-family:inherit;field-sizing:content}"
    & ".prompt-row textarea:focus{border-color:var(--gold);outline:none}"
    & ".prompt-col{display:flex;flex-direction:column;gap:6px}"
    & ".prompt-col label{font-size:.75em;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}"
    & ".prompt-col input{background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:8px;border-radius:6px;width:100px;font-size:.9em}"
    & ".neg-row{margin-top:8px}"
    & ".neg-row textarea{width:100%;background:#1a1a1a;border:1px solid var(--border);color:#999;padding:8px;border-radius:6px;font-size:.8em;resize:vertical;min-height:36px;font-family:inherit}"
    & ".dim-row{border-bottom:1px solid var(--border);padding:12px 24px}"
    & ".dim-header{display:flex;align-items:center;gap:12px;margin-bottom:10px}"
    & ".dim-header h2{color:var(--gold);font-size:1em;min-width:80px}"
    & ".dim-header .pinned{background:#2a2a1a;border:1px solid var(--gold);color:var(--gold);padding:3px 10px;border-radius:12px;font-size:.8em}"
    & ".dim-header .hint{color:var(--dim);font-size:.8em;flex:1}"
    & ".dim-grid{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px}"
    & ".img-card{flex:0 0 200px;background:var(--card);border:2px solid var(--border);border-radius:8px;overflow:hidden;cursor:pointer;transition:border-color .15s,transform .15s;position:relative}"
    & ".img-card:hover{border-color:#555;transform:translateY(-2px)}"
    & ".img-card.selected{border-color:var(--gold)}"
    & ".img-card.generating{opacity:.6}"
    & ".img-card img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;background:#1a1a1a}"
    & ".img-card .lbl{padding:6px 8px;font-size:.78em;line-height:1.3}"
    & ".img-card .lbl b{color:var(--gold)}"
    & ".img-card .spinner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:30px;height:30px;border:3px solid #333;border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite}"
    & "@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}"
    & ".nav{display:flex;gap:4px;padding:8px 24px;border-bottom:1px solid var(--border);background:#0f0f0f}"
    & ".nav a{color:var(--dim);text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85em;transition:all .15s}"
    & ".nav a:hover{color:var(--text);background:#1a1a1a}"
    & ".nav a.active{color:var(--gold);background:#1a1a1a}"
    & ".lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:1000;justify-content:center;align-items:center}"
    & ".lb.on{display:flex}.lb img{max-width:95%;max-height:95%;object-fit:contain}"
    & ".lb .x{position:absolute;top:15px;right:25px;color:#fff;font-size:2em;cursor:pointer}"
    & ".toast{position:fixed;bottom:20px;right:20px;background:#1a1a2a;border:1px solid var(--gold);color:var(--text);padding:10px 16px;border-radius:8px;font-size:.85em;z-index:500;opacity:0;transition:opacity .3s;pointer-events:none}"
    & ".toast.show{opacity:1}"

Section: Navigation

  nav-html : Text -> Text
  nav-html (active) =
    "<nav class=\"nav\">"
    & "<a href=\"/card\" class=\"" & if active == "card" then "active" else "" & "\">Cards</a>"
    & "<a href=\"/item\" class=\"" & if active == "item" then "active" else "" & "\">Items</a>"
    & "<a href=\"/character\" class=\"" & if active == "character" then "active" else "" & "\">Characters</a>"
    & "<a href=\"/setting\" class=\"" & if active == "setting" then "active" else "" & "\">Settings</a>"
    & "<a href=\"/voice\" class=\"" & if active == "voice" then "active" else "" & "\">Voice</a>"
    & "</nav>"

Section: Default Prompts

  card-default-prompt : Text
  card-default-prompt =
    "fantasy trading card game card, ornate golden card frame border, "
    & "fierce dragon general creature in center art panel, glowing red mana "
    & "symbol top right, power toughness defense stats 5/4/2 in bottom banner, "
    & "card name plate at top, ability text area, dark parchment card texture, "
    & "professional TCG card art, intricate filigree details, dramatic lighting, "
    & "masterpiece, best quality, 4k, sharp focus"

  card-default-negative : Text
  card-default-negative =
    "blurry, low quality, deformed, ugly, text errors, watermark, signature, "
    & "photograph, 3d render, nsfw, plain background, cropped, out of frame"

Section: Page Structure

  card-page-html : Text
  card-page-html =
    nav-html "card"
    & "<div class=\"header\">"
    & "<h1>Card Designer</h1>"
    & "<div class=\"prompt-row\">"
    & "<div style=\"flex:1;position:relative\">"
    & "<textarea id=\"prompt\">" & card-default-prompt & "</textarea>"
    & "<select id=\"prompt-history\" style=\"position:absolute;top:4px;right:4px;background:#2a2a2a;color:var(--gold);border:1px solid var(--border);border-radius:4px;padding:2px 4px;font-size:.75em;cursor:pointer;max-width:180px\">"
    & "<option value=\"\">History</option></select>"
    & "</div>"
    & "<div class=\"prompt-col\"><label>Seed</label><input id=\"seed\" type=\"number\" value=\"424242\"></div>"
    & "<div class=\"prompt-col\"><label>Width</label><input id=\"width\" type=\"number\" value=\"768\"></div>"
    & "<div class=\"prompt-col\"><label>Height</label><input id=\"height\" type=\"number\" value=\"1024\"></div>"
    & "</div>"
    & "<div class=\"neg-row\"><textarea id=\"neg\">" & card-default-negative & "</textarea></div>"
    & "</div>"
    & "<div id=\"dimensions\"></div>"
    & "<div class=\"lb\" id=\"lb\" onclick=\"closeLb()\"><span class=\"x\">&times;</span><img id=\"lb-img\"></div>"
    & "<div class=\"toast\" id=\"toast\"></div>"

Section: Entry Point

  opening : [Console] Nothing = act
    print-line-uni "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    print-line-uni "<title>CodexMagic — Card Designer</title>"
    print-line-uni "<style>"
    print-line-uni explorer-css
    print-line-uni "</style></head><body>"
    print-line-uni card-page-html
    print-line-uni "<script src=\"/explorer.js\"></script>"
    print-line-uni "</body></html>"
  end

