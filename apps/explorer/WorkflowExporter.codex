Chapter: WorkflowExporter

 ComfyUI workflow JSON exporter. Builds multi-node pipelines
 for layered card, item, character, and setting generation.
 Outputs workflow JSON that ComfyUI loads directly.

 The workflow architecture for a card:
   Node 1: Load checkpoint
   Node 2: Positive prompt (creature/art)
   Node 3: Negative prompt
   Node 4: Empty latent (base resolution)
   Node 5: KSampler (base art generation)
   Node 6: VAE decode (base art to pixels)
   Node 7: Positive prompt (card frame)
   Node 8: KSampler (frame generation)
   Node 9: VAE decode (frame to pixels)
   Node 10: Image composite (blend art into frame)
   Node 11: Upscale (final quality pass)
   Node 12: Save image

 We say:

Section: Node Builder

  node-json : Text, Text, Text -> Text
  node-json (id) (class-type) (inputs) =
    "\"" & id & "\":{\"class_type\":\"" & class-type & "\",\"inputs\":{" & inputs & "}}"

  input-str : Text, Text -> Text
  input-str (key) (val) = "\"" & key & "\":\"" & val & "\""

  input-int : Text, Integer -> Text
  input-int (key) (val) = "\"" & key & "\":" & show val

  input-num : Text, Integer, Integer -> Text
  input-num (key) (whole) (frac) = "\"" & key & "\":" & show whole & "." & show frac

  input-ref : Text, Text, Integer -> Text
  input-ref (key) (node-id) (output-idx) =
    "\"" & key & "\":[\"" & node-id & "\"," & show output-idx & "]"

  join-inputs : List Text, Integer, Integer, Text -> Text
  join-inputs (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in join-inputs xs (i + 1) len (acc & sep & list-at xs i)

Section: Workflow Parameters

  WorkflowParams = record {
    model-name : Text,
    positive-prompt : Text,
    negative-prompt : Text,
    frame-prompt : Text,
    width : Integer,
    height : Integer,
    steps : Integer,
    cfg-whole : Integer,
    cfg-frac : Integer,
    sampler : Text,
    scheduler : Text,
    seed : Integer,
    upscale-by : Integer,
    upscaler-model : Text
  }

Section: Card Workflow

  build-card-workflow : WorkflowParams -> Text
  build-card-workflow (p) =
    let n1 = node-json "1" "CheckpointLoaderSimple" (input-str "ckpt_name" (p.model-name))
    in let n2 = node-json "2" "CLIPTextEncode" (join-inputs [input-str "text" (p.positive-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n3 = node-json "3" "CLIPTextEncode" (join-inputs [input-str "text" (p.negative-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n4 = node-json "4" "EmptyLatentImage" (join-inputs [input-int "width" (p.width), input-int "height" (p.height), input-int "batch_size" 1] 0 3 "")
    in let n5 = node-json "5" "KSampler" (join-inputs [input-int "seed" (p.seed), input-int "steps" (p.steps), input-num "cfg" (p.cfg-whole) (p.cfg-frac), input-str "sampler_name" (p.sampler), input-str "scheduler" (p.scheduler), input-num "denoise" 1 0, input-ref "model" "1" 0, input-ref "positive" "2" 0, input-ref "negative" "3" 0, input-ref "latent_image" "4" 0] 0 10 "")
    in let n6 = node-json "6" "VAEDecode" (join-inputs [input-ref "samples" "5" 0, input-ref "vae" "1" 2] 0 2 "")
    in let n7 = node-json "7" "CLIPTextEncode" (join-inputs [input-str "text" (p.frame-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n8-latent = node-json "8" "EmptyLatentImage" (join-inputs [input-int "width" (p.width), input-int "height" (p.height), input-int "batch_size" 1] 0 3 "")
    in let n9 = node-json "9" "KSampler" (join-inputs [input-int "seed" (p.seed + 1), input-int "steps" (p.steps), input-num "cfg" (p.cfg-whole) (p.cfg-frac), input-str "sampler_name" (p.sampler), input-str "scheduler" (p.scheduler), input-num "denoise" 1 0, input-ref "model" "1" 0, input-ref "positive" "7" 0, input-ref "negative" "3" 0, input-ref "latent_image" "8" 0] 0 10 "")
    in let n10 = node-json "10" "VAEDecode" (join-inputs [input-ref "samples" "9" 0, input-ref "vae" "1" 2] 0 2 "")
    in let n11 = node-json "11" "ImageBlend" (join-inputs [input-ref "image1" "10" 0, input-ref "image2" "6" 0, input-num "blend_factor" 0 6, input-str "blend_mode" "overlay"] 0 4 "")
    in let n12 = node-json "12" "ImageUpscaleWithModel" (join-inputs [input-str "upscale_model" (p.upscaler-model), input-ref "image" "11" 0] 0 2 "")
    in let n13 = node-json "13" "SaveImage" (join-inputs [input-ref "images" "12" 0, input-str "filename_prefix" "codexmagic_card"] 0 2 "")
    in "{" & n1 & "," & n2 & "," & n3 & "," & n4 & "," & n5 & "," & n6
    & "," & n7 & "," & n8-latent & "," & n9 & "," & n10 & "," & n11
    & "," & n12 & "," & n13 & "}"

Section: Simple Workflow (single KSampler, no layers)

  build-simple-workflow : WorkflowParams -> Text
  build-simple-workflow (p) =
    let n1 = node-json "1" "CheckpointLoaderSimple" (input-str "ckpt_name" (p.model-name))
    in let n2 = node-json "2" "CLIPTextEncode" (join-inputs [input-str "text" (p.positive-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n3 = node-json "3" "CLIPTextEncode" (join-inputs [input-str "text" (p.negative-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n4 = node-json "4" "EmptyLatentImage" (join-inputs [input-int "width" (p.width), input-int "height" (p.height), input-int "batch_size" 1] 0 3 "")
    in let n5 = node-json "5" "KSampler" (join-inputs [input-int "seed" (p.seed), input-int "steps" (p.steps), input-num "cfg" (p.cfg-whole) (p.cfg-frac), input-str "sampler_name" (p.sampler), input-str "scheduler" (p.scheduler), input-num "denoise" 1 0, input-ref "model" "1" 0, input-ref "positive" "2" 0, input-ref "negative" "3" 0, input-ref "latent_image" "4" 0] 0 10 "")
    in let n6 = node-json "6" "VAEDecode" (join-inputs [input-ref "samples" "5" 0, input-ref "vae" "1" 2] 0 2 "")
    in let n7 = node-json "7" "SaveImage" (join-inputs [input-ref "images" "6" 0, input-str "filename_prefix" "codexmagic"] 0 2 "")
    in "{" & n1 & "," & n2 & "," & n3 & "," & n4 & "," & n5 & "," & n6 & "," & n7 & "}"

Section: Item Workflow (with rarity glow post-process)

  build-item-workflow : WorkflowParams, Text -> Text
  build-item-workflow (p) (glow-color) =
    let n1 = node-json "1" "CheckpointLoaderSimple" (input-str "ckpt_name" (p.model-name))
    in let n2 = node-json "2" "CLIPTextEncode" (join-inputs [input-str "text" (p.positive-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n3 = node-json "3" "CLIPTextEncode" (join-inputs [input-str "text" (p.negative-prompt), input-ref "clip" "1" 1] 0 2 "")
    in let n4 = node-json "4" "EmptyLatentImage" (join-inputs [input-int "width" (p.width), input-int "height" (p.height), input-int "batch_size" 1] 0 3 "")
    in let n5 = node-json "5" "KSampler" (join-inputs [input-int "seed" (p.seed), input-int "steps" (p.steps), input-num "cfg" (p.cfg-whole) (p.cfg-frac), input-str "sampler_name" (p.sampler), input-str "scheduler" (p.scheduler), input-num "denoise" 1 0, input-ref "model" "1" 0, input-ref "positive" "2" 0, input-ref "negative" "3" 0, input-ref "latent_image" "4" 0] 0 10 "")
    in let n6 = node-json "6" "VAEDecode" (join-inputs [input-ref "samples" "5" 0, input-ref "vae" "1" 2] 0 2 "")
    in let n7 = node-json "7" "ImageUpscaleWithModel" (join-inputs [input-str "upscale_model" (p.upscaler-model), input-ref "image" "6" 0] 0 2 "")
    in let n8 = node-json "8" "SaveImage" (join-inputs [input-ref "images" "7" 0, input-str "filename_prefix" ("codexmagic_item_" & glow-color)] 0 2 "")
    in "{" & n1 & "," & n2 & "," & n3 & "," & n4 & "," & n5 & "," & n6 & "," & n7 & "," & n8 & "}"

Section: Workflow Page HTML

  workflow-page-html : Text
  workflow-page-html =
    "<nav class=\"nav\">"
    & "<a href=\"/card\">Cards</a>"
    & "<a href=\"/item\">Items</a>"
    & "<a href=\"/character\">Characters</a>"
    & "<a href=\"/setting\">Settings</a>"
    & "<a href=\"/voice\">Voice</a>"
    & "<a href=\"/workflow\" class=\"active\">Workflows</a>"
    & "</nav>"
    & "<div class=\"header\">"
    & "<h1>ComfyUI Workflow Exporter</h1>"
    & "<div class=\"controls\">"
    & "<div class=\"control-group\"><label>Pipeline</label><div class=\"pill-row\" id=\"pipeline\"></div></div>"
    & "<div class=\"prompt-row\">"
    & "<textarea id=\"prompt\" placeholder=\"Main subject prompt...\">fierce dragon general creature, glowing red eyes, scales and fire, dark fantasy art</textarea>"
    & "<div class=\"prompt-col\"><label>Seed</label><input id=\"seed\" type=\"number\" value=\"424242\"></div>"
    & "<div class=\"prompt-col\"><label>Steps</label><input id=\"steps\" type=\"number\" value=\"20\"></div>"
    & "<div class=\"prompt-col\"><label>CFG</label><input id=\"cfg\" type=\"number\" value=\"7\"></div>"
    & "</div>"
    & "<div class=\"prompt-row\">"
    & "<textarea id=\"neg\" placeholder=\"Negative prompt...\">blurry, low quality, deformed, ugly, nsfw</textarea>"
    & "<textarea id=\"frame-prompt\" placeholder=\"Frame/overlay prompt (for layered pipelines)...\">ornate golden card frame border, filigree details, dark parchment texture, empty center window</textarea>"
    & "</div>"
    & "<div class=\"prompt-row\">"
    & "<div class=\"prompt-col\"><label>Model</label><input id=\"model\" type=\"text\" value=\"dreamshaperXL_lightningDPMSDE.safetensors\" style=\"width:300px\"></div>"
    & "<div class=\"prompt-col\"><label>Width</label><input id=\"width\" type=\"number\" value=\"768\"></div>"
    & "<div class=\"prompt-col\"><label>Height</label><input id=\"height\" type=\"number\" value=\"1024\"></div>"
    & "</div>"
    & "<button class=\"gen-button\" onclick=\"exportWorkflow()\">Export Workflow JSON</button>"
    & "<button class=\"gen-button\" style=\"margin-left:8px\" onclick=\"sendToComfy()\">Send to ComfyUI</button>"
    & "</div>"
    & "</div>"
    & "<div id=\"output\" class=\"workflow-output\"></div>"
    & "<div class=\"toast\" id=\"toast\"></div>"

Section: Workflow CSS

  workflow-css : Text
  workflow-css =
    ".workflow-output{padding:16px 24px}"
    & ".workflow-output pre{background:#1a1a1a;border:1px solid var(--border);border-radius:8px;padding:16px;font-size:.8em;overflow-x:auto;color:#0f0;max-height:500px;overflow-y:auto;white-space:pre-wrap;word-break:break-all}"
    & ".workflow-output .actions{margin-top:10px;display:flex;gap:8px}"
    & ".copy-btn{background:#2a2a1a;border:1px solid var(--gold);color:var(--gold);padding:6px 16px;border-radius:6px;font-size:.85em;cursor:pointer}"
    & ".copy-btn:hover{background:#3a3a2a}"
    & ".gen-button{background:#2a2a1a;border:1px solid var(--gold);color:var(--gold);padding:8px 20px;border-radius:6px;font-size:.9em;cursor:pointer;margin-top:12px;transition:all .15s}"
    & ".gen-button:hover{background:#3a3a2a}"
    & ".status-msg{margin-top:10px;padding:8px 12px;border-radius:6px;font-size:.85em}"
    & ".status-msg.ok{background:#0a1a0a;border:1px solid #0f03;color:#0f0}"
    & ".status-msg.err{background:#1a0a0a;border:1px solid #f003;color:#f88}"

Section: Workflow JavaScript

  workflow-js : Text
  workflow-js =
    "const PIPELINES = [\n"
    & "  {name:'Simple (txt2img)',desc:'Single KSampler, direct output',type:'simple'},\n"
    & "  {name:'Layered Card',desc:'Base art + frame overlay + composite',type:'card'},\n"
    & "  {name:'Item + Upscale',desc:'Item generation with upscale pass',type:'item'},\n"
    & "];\n"
    & "let selPipeline = 0;\n"
    & "function renderPipelines() {\n"
    & "  const el = document.getElementById('pipeline');\n"
    & "  el.innerHTML = PIPELINES.map((p,i) =>\n"
    & "    '<span class=\"pill' + (i===selPipeline?' active':'') + '\" onclick=\"selPipeline=' + i + ';renderPipelines()\">' + p.name + '</span>'\n"
    & "  ).join('');\n"
    & "  document.getElementById('frame-prompt').style.display = selPipeline === 1 ? '' : 'none';\n"
    & "}\n"
    & "function getParams() {\n"
    & "  const cfg = parseFloat(document.getElementById('cfg').value) || 7;\n"
    & "  return {\n"
    & "    model: document.getElementById('model').value,\n"
    & "    prompt: document.getElementById('prompt').value,\n"
    & "    neg: document.getElementById('neg').value,\n"
    & "    frame: document.getElementById('frame-prompt').value,\n"
    & "    seed: parseInt(document.getElementById('seed').value) || 424242,\n"
    & "    steps: parseInt(document.getElementById('steps').value) || 20,\n"
    & "    cfg_whole: Math.floor(cfg),\n"
    & "    cfg_frac: Math.round((cfg % 1) * 10),\n"
    & "    width: parseInt(document.getElementById('width').value) || 768,\n"
    & "    height: parseInt(document.getElementById('height').value) || 1024,\n"
    & "    sampler: 'dpmpp_sde',\n"
    & "    scheduler: 'karras',\n"
    & "    upscaler: 'RealESRGAN_x4plus'\n"
    & "  };\n"
    & "}\n"
    & "function buildWorkflow(p) {\n"
    & "  const mk = (id,cls,inputs) => ({[id]:{class_type:cls,inputs}});\n"
    & "  const ref = (id,out) => [String(id),out];\n"
    & "  let nodes = {};\n"
    & "  Object.assign(nodes, mk('1','CheckpointLoaderSimple',{ckpt_name:p.model}));\n"
    & "  Object.assign(nodes, mk('2','CLIPTextEncode',{text:p.prompt,clip:ref(1,1)}));\n"
    & "  Object.assign(nodes, mk('3','CLIPTextEncode',{text:p.neg,clip:ref(1,1)}));\n"
    & "  Object.assign(nodes, mk('4','EmptyLatentImage',{width:p.width,height:p.height,batch_size:1}));\n"
    & "  Object.assign(nodes, mk('5','KSampler',{seed:p.seed,steps:p.steps,cfg:p.cfg_whole+p.cfg_frac/10,\n"
    & "    sampler_name:p.sampler,scheduler:p.scheduler,denoise:1.0,\n"
    & "    model:ref(1,0),positive:ref(2,0),negative:ref(3,0),latent_image:ref(4,0)}));\n"
    & "  Object.assign(nodes, mk('6','VAEDecode',{samples:ref(5,0),vae:ref(1,2)}));\n"
    & "  if (PIPELINES[selPipeline].type === 'card') {\n"
    & "    Object.assign(nodes, mk('7','CLIPTextEncode',{text:p.frame,clip:ref(1,1)}));\n"
    & "    Object.assign(nodes, mk('8','EmptyLatentImage',{width:p.width,height:p.height,batch_size:1}));\n"
    & "    Object.assign(nodes, mk('9','KSampler',{seed:p.seed+1,steps:p.steps,cfg:p.cfg_whole+p.cfg_frac/10,\n"
    & "      sampler_name:p.sampler,scheduler:p.scheduler,denoise:1.0,\n"
    & "      model:ref(1,0),positive:ref(7,0),negative:ref(3,0),latent_image:ref(8,0)}));\n"
    & "    Object.assign(nodes, mk('10','VAEDecode',{samples:ref(9,0),vae:ref(1,2)}));\n"
    & "    Object.assign(nodes, mk('11','ImageBlend',{image1:ref(10,0),image2:ref(6,0),blend_factor:0.6,blend_mode:'overlay'}));\n"
    & "    Object.assign(nodes, mk('12','SaveImage',{images:ref(11,0),filename_prefix:'codexmagic_card'}));\n"
    & "  } else if (PIPELINES[selPipeline].type === 'item') {\n"
    & "    Object.assign(nodes, mk('7','UpscaleModelLoader',{model_name:p.upscaler}));\n"
    & "    Object.assign(nodes, mk('8','ImageUpscaleWithModel',{upscale_model:ref(7,0),image:ref(6,0)}));\n"
    & "    Object.assign(nodes, mk('9','SaveImage',{images:ref(8,0),filename_prefix:'codexmagic_item'}));\n"
    & "  } else {\n"
    & "    Object.assign(nodes, mk('7','SaveImage',{images:ref(6,0),filename_prefix:'codexmagic'}));\n"
    & "  }\n"
    & "  return nodes;\n"
    & "}\n"
    & "function exportWorkflow() {\n"
    & "  const p = getParams();\n"
    & "  const wf = buildWorkflow(p);\n"
    & "  const json = JSON.stringify(wf, null, 2);\n"
    & "  const out = document.getElementById('output');\n"
    & "  out.innerHTML = '<pre>' + json.replace(/</g,'&lt;') + '</pre>'\n"
    & "    + '<div class=\"actions\">'\n"
    & "    + '<button class=\"copy-btn\" onclick=\"copyWf()\">Copy to Clipboard</button>'\n"
    & "    + '<button class=\"copy-btn\" onclick=\"downloadWf()\">Download .json</button>'\n"
    & "    + '</div>';\n"
    & "  window._lastWf = wf;\n"
    & "}\n"
    & "function copyWf() {\n"
    & "  navigator.clipboard.writeText(JSON.stringify(window._lastWf, null, 2));\n"
    & "  toast('Copied to clipboard');\n"
    & "}\n"
    & "function downloadWf() {\n"
    & "  const blob = new Blob([JSON.stringify(window._lastWf, null, 2)], {type:'application/json'});\n"
    & "  const a = document.createElement('a');\n"
    & "  a.href = URL.createObjectURL(blob);\n"
    & "  a.download = 'codexmagic_workflow.json';\n"
    & "  a.click();\n"
    & "}\n"
    & "async function sendToComfy() {\n"
    & "  const p = getParams();\n"
    & "  const wf = buildWorkflow(p);\n"
    & "  try {\n"
    & "    const resp = await fetch('http://localhost:8188/prompt', {\n"
    & "      method: 'POST', headers: {'Content-Type':'application/json'},\n"
    & "      body: JSON.stringify({prompt: wf})\n"
    & "    });\n"
    & "    if (resp.ok) {\n"
    & "      const data = await resp.json();\n"
    & "      document.getElementById('output').innerHTML += '<div class=\"status-msg ok\">Sent to ComfyUI! Prompt ID: ' + (data.prompt_id || 'queued') + '</div>';\n"
    & "    } else {\n"
    & "      document.getElementById('output').innerHTML += '<div class=\"status-msg err\">ComfyUI error: ' + resp.status + '</div>';\n"
    & "    }\n"
    & "  } catch(e) {\n"
    & "    document.getElementById('output').innerHTML += '<div class=\"status-msg err\">ComfyUI not reachable at localhost:8188</div>';\n"
    & "  }\n"
    & "}\n"
    & "function toast(msg) {\n"
    & "  const el = document.getElementById('toast');\n"
    & "  el.textContent = msg; el.classList.add('show');\n"
    & "  setTimeout(() => el.classList.remove('show'), 2000);\n"
    & "}\n"
    & "renderPipelines();\n"

Section: Shared CSS

  explorer-css : Text
  explorer-css =
    ":root{--gold:#ffd700;--bg:#0a0a0a;--card:#141414;--border:#2a2a2a;--text:#ccc;--dim:#666}"
    & "*{margin:0;padding:0;box-sizing:border-box}"
    & "body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif}"
    & ".header{padding:16px 24px;border-bottom:1px solid var(--border)}"
    & ".header h1{color:var(--gold);font-size:1.4em;margin-bottom:12px}"
    & ".prompt-row{display:flex;gap:10px;align-items:flex-start;margin-top:8px}"
    & ".prompt-row textarea{flex:1;background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:10px;border-radius:6px;font-size:.9em;min-height:40px;font-family:inherit}"
    & ".prompt-col{display:flex;flex-direction:column;gap:6px}"
    & ".prompt-col label{font-size:.75em;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}"
    & ".prompt-col input{background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:8px;border-radius:6px;width:100px;font-size:.9em}"
    & ".nav{display:flex;gap:4px;padding:8px 24px;border-bottom:1px solid var(--border);background:#0f0f0f}"
    & ".nav a{color:var(--dim);text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85em;transition:all .15s}"
    & ".nav a:hover{color:var(--text);background:#1a1a1a}"
    & ".nav a.active{color:var(--gold);background:#1a1a1a}"
    & ".controls{display:flex;flex-direction:column;gap:8px;margin-top:12px}"
    & ".control-group{display:flex;align-items:center;gap:10px}"
    & ".control-group label{font-size:.8em;color:var(--gold);min-width:80px;text-transform:uppercase;letter-spacing:.5px}"
    & ".pill-row{display:flex;gap:6px;flex-wrap:wrap}"
    & ".pill{padding:5px 14px;border-radius:16px;border:1px solid var(--border);background:#1a1a1a;color:var(--text);font-size:.8em;cursor:pointer;transition:all .15s}"
    & ".pill:hover{border-color:#555}"
    & ".pill.active{border-color:var(--gold);color:var(--gold);background:#2a2a1a}"
    & ".toast{position:fixed;bottom:20px;right:20px;background:#1a1a2a;border:1px solid var(--gold);color:var(--text);padding:10px 16px;border-radius:8px;font-size:.85em;z-index:500;opacity:0;transition:opacity .3s;pointer-events:none}"
    & ".toast.show{opacity:1}"

Section: Entry Point

  opening : [Console] None = act
    print-line-uni "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    print-line-uni "<title>CodexMagic — Workflow Exporter</title>"
    print-line-uni "<style>"
    print-line-uni explorer-css
    print-line-uni workflow-css
    print-line-uni "</style></head><body>"
    print-line-uni workflow-page-html
    print-line-uni "<script>"
    print-line-uni workflow-js
    print-line-uni "</script>"
    print-line-uni "</body></html>"
  end

Page 1
