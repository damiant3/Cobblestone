Chapter: VoiceStudioInteraction

 Event delegation for the voice studio page. Replaces inline onclick
 handlers with data-action dispatch. Handles generate-voice, pill
 selection (pick), template fill, and play button.

 We say:

Section: Action Dispatch

  dispatch-action : Text -> Integer
  dispatch-action (action) =
    if action == "generate-voice" then js-call-global "generateVoice" 0
    else 0

Section: Event Handlers

  on-action-click : Integer -> Integer
  on-action-click (evt) =
    let tgt = dom-event-target evt
    in let el = dom-closest tgt "[data-action]"
    in if dom-not-null el then
      let action = dom-dataset-get el "action"
      in if action == "pick" then
        let key = dom-dataset-get el "key"
        in let idx = dom-dataset-get el "index"
        in js-call-global-2 "pick" key (parse-int idx)
      else if action == "fill-template" then
        let idx = dom-dataset-get el "index"
        in js-call-global "fillTemplate" (parse-int idx)
      else if action == "play-audio" then
        let audio = dom-query-from el "~ audio"
        in if dom-not-null audio then js-call-method audio "play" 0 else 0
      else dispatch-action action
    else 0

Section: Setup

  setup-voice-events : Integer -> Integer
  setup-voice-events (x) =
    let doc = dom-document 0
    in let d2 = dom-on-click doc (on-action-click)
    in 0

