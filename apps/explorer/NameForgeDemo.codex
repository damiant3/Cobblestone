Chapter: NameForgeDemo
  cites Explorer chapter NameForge

 Proof: generate whole named settings from seeds, deterministically.

 We say:

  demo-text : Integer -> Text
  demo-text (x) =
    "=== Seed 42 ===\n" & format-setting (forge-setting 42) & "\n\n"
    & "=== Seed 1337 ===\n" & format-setting (forge-setting 1337) & "\n\n"
    & "=== Seed 7 ===\n" & format-setting (forge-setting 7) & "\n\n"
    & "Determinism: forge-kingdom 42 -> " & forge-kingdom 42 & " / " & forge-kingdom 42 & "\n"
    & "Sampler: tavern=" & forge-tavern 3 & "  castle=" & forge-castle 9 & "  river=" & forge-river 5

  opening : [Console] None = act
    print-line-uni (demo-text 0)
  end
