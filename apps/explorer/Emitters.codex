Chapter: Emitters
  cites Explorer chapter WorldModel

 We say:

Section: Shared Tier Mappings

  tier-bonus : Text -> Text
  tier-bonus (t) =
    if t == "artifact" then "+3" else if t == "legendary" then "+2" else if t == "exceptional" then "+1" else "+0"

  tier-rarity-dnd : Text -> Text
  tier-rarity-dnd (t) =
    if t == "artifact" then "artifact" else if t == "legendary" then "legendary" else if t == "exceptional" then "rare" else "uncommon"

  tier-rarity-mtg : Text -> Text
  tier-rarity-mtg (t) =
    if t == "artifact" then "Mythic Rare" else if t == "legendary" then "Rare" else if t == "exceptional" then "Uncommon" else "Common"

  tier-pt : Text -> Text
  tier-pt (t) =
    if t == "artifact" then "+3/+3" else if t == "legendary" then "+2/+2" else if t == "exceptional" then "+1/+1" else "+0/+0"

Section: Weapon Mappings

  damage-die : Text -> Text
  damage-die (w) =
    if w == "blade" then "1d8 slashing" else if w == "haft" then "1d10" else if w == "ranged" then "1d8 piercing" else "1d6"

  affinity-dnd : Text -> Text
  affinity-dnd (a) =
    if a == "radiant" then " It deals an extra 2d8 radiant damage to fiends and undead."
    else if a == "fire" then " It deals an extra 2d6 fire damage on a hit."
    else if a == "" then ""
    else " It carries a " & a & " affinity."

  attune-dnd : Text -> Text
  attune-dnd (c) =
    if c == "royalty" then "requires attunement by a creature of royal blood"
    else if c == "worthiness" then "requires attunement by a creature deemed worthy"
    else if c == "alignment" then "requires attunement by a creature of good alignment"
    else "requires attunement"

  equip-mtg : Text -> Text
  equip-mtg (c) =
    if c == "royalty" then "Equip only to a legendary creature."
    else if c == "worthiness" then "Equip only to a creature with power 3 or greater."
    else ""

  eff-dnd-weapon : Text -> Text
  eff-dnd-weapon (e) =
    if e == "leadership-aura" then "<br>&bull; <b>Crown's Authority.</b> Allies within 30 feet that can see you gain a +1 bonus to attack rolls."
    else if e == "blinding-light" then "<br>&bull; <b>Blinding Light.</b> As an action, the blade flares; each creature within 30 feet that can see it must succeed on a DC 17 Constitution saving throw or be blinded for 1 minute."
    else if e == "ward-wounds" then "<br>&bull; <b>Warding Scabbard.</b> While its scabbard is on your person, you regain an extra 1d10 hit points whenever you regain hit points."
    else ""

  eff-mtg-weapon : Text -> Text
  eff-mtg-weapon (e) =
    if e == "leadership-aura" then "vigilance"
    else if e == "blinding-light" then "first strike"
    else if e == "ward-wounds" then "ward {2}"
    else ""

Section: Character Mappings

  char-cr : Text -> Text
  char-cr (t) =
    if t == "artifact" then "20" else if t == "legendary" then "12" else if t == "exceptional" then "6" else "3"

  char-ac : Text -> Text
  char-ac (t) =
    if t == "artifact" then "18" else if t == "legendary" then "16" else if t == "exceptional" then "15" else "13"

  char-hp : Text -> Text
  char-hp (t) =
    if t == "artifact" then "210" else if t == "legendary" then "120" else if t == "exceptional" then "66" else "30"

  char-dc : Text -> Text
  char-dc (t) =
    if t == "artifact" then "19" else if t == "legendary" then "16" else if t == "exceptional" then "14" else "12"

  char-pt-mtg : Text -> Text
  char-pt-mtg (t) =
    if t == "artifact" then "4/6" else if t == "legendary" then "3/4" else if t == "exceptional" then "2/3" else "1/2"

  char-cost-mtg : Text -> Text
  char-cost-mtg (v) =
    if v == "arcane caster" then "{3}{U}{U}" else if v == "divine" then "{2}{W}{B}" else if v == "martial" then "{2}{W}{W}" else "{2}{C}"

  char-ctype : Text -> Text
  char-ctype (v) =
    if v == "arcane caster" then "Human Wizard" else if v == "divine" then "Human Cleric" else if v == "martial" then "Human Knight" else "Human"

  eff-dnd-char : Text -> Text
  eff-dnd-char (e) =
    if e == "spellcasting" then "<br>&bull; <b>Spellcasting.</b> An 18th-level spellcaster (Intelligence-based); knows spells up to 9th level."
    else if e == "counterspell" then "<br>&bull; <b>Counterspell (Reaction).</b> Interrupt a spell of 7th level or lower as it is cast."
    else if e == "foresight" then "<br>&bull; <b>Foresight.</b> Advantage on attack rolls, saving throws, and ability checks."
    else ""

  eff-mtg-char : Text -> Text
  eff-mtg-char (e) =
    if e == "spellcasting" then "prowess"
    else if e == "counterspell" then "flash"
    else if e == "foresight" then "hexproof"
    else ""

Section: Effect Folds

  effs-dnd-weapon : List Text, Integer, Integer, Text -> Text
  effs-dnd-weapon (es) (i) (n) (acc) =
    if i >= n then acc else effs-dnd-weapon es (i + 1) n (acc & eff-dnd-weapon (list-at es i))

  effs-dnd-char : List Text, Integer, Integer, Text -> Text
  effs-dnd-char (es) (i) (n) (acc) =
    if i >= n then acc else effs-dnd-char es (i + 1) n (acc & eff-dnd-char (list-at es i))

  join-kw : Text, Text -> Text
  join-kw (acc) (k) =
    if text-length acc == 0 then k else if text-length k == 0 then acc else acc & ", " & k

  effs-mtg-weapon : List Text, Integer, Integer, Text -> Text
  effs-mtg-weapon (es) (i) (n) (acc) =
    if i >= n then acc else effs-mtg-weapon es (i + 1) n (join-kw acc (eff-mtg-weapon (list-at es i)))

  effs-mtg-char : List Text, Integer, Integer, Text -> Text
  effs-mtg-char (es) (i) (n) (acc) =
    if i >= n then acc else effs-mtg-char es (i + 1) n (join-kw acc (eff-mtg-char (list-at es i)))

Section: Emitters (dispatch on abstraction)

  emit-visual : Entity -> Text
  emit-visual (e) =
    let base = "<h3>Stable Diffusion &middot; visual</h3><div class=\"prompt\">" & e.appearance & ", "
    in when e.abstraction
      is WeaponAbs (w) ->
        base & "legendary " & w.power-tier & " weapon, "
        & (if w.affinity == "" then "" else w.affinity & " glow, ")
        & "fantasy item concept art, single item centered on pure black background, game inventory icon, intricate detail, masterpiece, best quality, 4k, sharp focus</div>"
      is CharAbs (c) ->
        base & c.disposition & ", " & c.role & ", "
        & "fantasy RPG character portrait, head and shoulders, dramatic lighting, professional concept art, detailed face, masterpiece, best quality, 4k, sharp focus</div>"

  emit-dnd5e : Entity -> Text
  emit-dnd5e (e) =
    when e.abstraction
      is WeaponAbs (w) ->
        "<h3>D&amp;D 5e &middot; magic item</h3><div class=\"statblock\"><b>" & e.name
        & "</b><br><i>Weapon (" & e.taxonomy & "), " & tier-rarity-dnd (w.power-tier)
        & " (" & attune-dnd (w.wielder-constraint) & ")</i><hr>You have a <b>" & tier-bonus (w.power-tier)
        & "</b> bonus to attack and damage rolls made with this magic weapon, which deals "
        & damage-die (w.weapon-class) & " damage." & affinity-dnd (w.affinity)
        & effs-dnd-weapon (w.granted-effects) 0 (list-length (w.granted-effects)) "" & "</div>"
      is CharAbs (c) ->
        "<h3>D&amp;D 5e &middot; NPC</h3><div class=\"statblock\"><b>" & e.name
        & "</b><br><i>" & c.role & " (" & c.vocation & "), challenge rating " & char-cr (c.power-tier)
        & "</i><hr>AC " & char-ac (c.power-tier) & " &middot; HP " & char-hp (c.power-tier)
        & " &middot; spell save DC " & char-dc (c.power-tier)
        & effs-dnd-char (c.granted-effects) 0 (list-length (c.granted-effects)) "" & "</div>"

  emit-mtg : Entity -> Text
  emit-mtg (e) =
    when e.abstraction
      is WeaponAbs (w) ->
        let kw = effs-mtg-weapon (w.granted-effects) 0 (list-length (w.granted-effects)) ""
        in "<h3>Magic: the Gathering &middot; card</h3><div class=\"mtgcard\"><div class=\"cardtop\"><span class=\"cardname\">"
           & e.name & "</span><span class=\"cost\">{3}</span></div><div class=\"cardtype\">Legendary Artifact &mdash; Equipment</div><div class=\"cardtext\">Equipped creature gets "
           & tier-pt (w.power-tier) & (if text-length kw == 0 then "" else " and has " & kw)
           & ".<br>" & equip-mtg (w.wielder-constraint) & " Equip {2}.</div><div class=\"cardft\"><span>"
           & tier-rarity-mtg (w.power-tier) & "</span><span class=\"flavor\">&ldquo;Whoso pulleth out this sword is rightwise king.&rdquo;</span></div></div>"
      is CharAbs (c) ->
        let kw = effs-mtg-char (c.granted-effects) 0 (list-length (c.granted-effects)) ""
        in "<h3>Magic: the Gathering &middot; card</h3><div class=\"mtgcard\"><div class=\"cardtop\"><span class=\"cardname\">"
           & e.name & ", the " & c.role & "</span><span class=\"cost\">" & char-cost-mtg (c.vocation) & "</span></div><div class=\"cardtype\">Legendary Creature &mdash; "
           & char-ctype (c.vocation) & "</div><div class=\"cardtext\">" & (if text-length kw == 0 then "" else kw & ".<br>")
           & "{T}: " & c.signature & ".</div><div class=\"cardft\"><span>" & tier-rarity-mtg (c.power-tier)
           & "</span><span class=\"flavor\">&ldquo;I have seen how this ends.&rdquo;</span><span class=\"pt\">" & char-pt-mtg (c.power-tier) & "</span></div></div>"

