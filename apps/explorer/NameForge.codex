Chapter: NameForge
  cites Foreword chapter Wrap64

 We say:

Section: Seeded Pick

  pmod : Integer, Integer -> Integer
  pmod (a) (b) =
    if b == 0 then 0
    else let r = a - (a / b) * b in if r < 0 then r + b else r

  hsh : Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  hsh (seed) (salt) =
    let z0 = seed * 1000003 + salt * 19349663 + 2654435761
    in let z1 = bit-xor z0 (bit-shru z0 30)
    in let z2 = w64-mul z1 2246822519
    in let z3 = bit-xor z2 (bit-shru z2 27)
    in let z4 = w64-mul z3 3266489917
    in bit-xor z4 (bit-shru z4 31)

  pick : List Text, Integer, Integer -> Text
  pick (xs) (seed) (salt) =
    let n = list-length xs
    in if n == 0 then "" else list-at xs (pmod (hsh seed salt) n)

  one-in : Integer, Integer, Integer -> Boolean
  one-in (seed) (salt) (k) = pmod (hsh seed salt) k == 0

