Section: Forge by Kind

  forge-person : Integer -> Text
  forge-person (s) = pick given-names s 1 & " " & pick sur-roots s 2 & pick sur-suffix s 3

  forge-ruler : Integer -> Text
  forge-ruler (s) =
    pick ruler-title s 1 & " " & pick given-names s 2 & " " & pick ruler-epithet s 3

  forge-village : Integer -> Text
  forge-village (s) = pick settle-pre s 1 & pick settle-suf s 2

  forge-city : Integer -> Text
  forge-city (s) = pick settle-pre s 4 & pick settle-suf s 5 & (if one-in s 6 2 then "" else " " & pick region-noun s 7)

  forge-kingdom : Integer -> Text
  forge-kingdom (s) = pick kingdom-root s 1 & pick kingdom-suf s 2

  forge-region : Integer -> Text
  forge-region (s) = "the " & pick region-adj s 1 & " " & pick region-noun s 2

  forge-forest : Integer -> Text
  forge-forest (s) = "the " & pick forest-adj s 1 & " " & pick forest-noun s 2

  forge-sea : Integer -> Text
  forge-sea (s) = "the " & pick sea-adj s 1 & " " & pick sea-noun s 2

  forge-desert : Integer -> Text
  forge-desert (s) = "the " & pick desert-adj s 1 & " " & pick desert-noun s 2

  forge-mountain : Integer -> Text
  forge-mountain (s) = "the " & pick mountain-adj s 1 & " " & pick mountain-noun s 2

  forge-river : Integer -> Text
  forge-river (s) = "the " & pick river-pre s 1 & pick river-suf s 2

  forge-castle : Integer -> Text
  forge-castle (s) = pick castle-pre s 1 & pick castle-suf s 2

  forge-item : Integer -> Text
  forge-item (s) = "the " & pick item-adj s 1 & " " & pick item-noun s 2 & " of " & pick item-of s 3

  forge-quest : Integer -> Text
  forge-quest (s) = pick quest-verb s 1 & " " & pick quest-noun s 2

  forge-tavern : Integer -> Text
  forge-tavern (s) = pick tavern-pre s 1 & " " & pick tavern-noun s 2

Section: Setting

  Setting = record {
    kingdom : Text,
    capital : Text,
    ruler : Text,
    regions : List Text,
    villages : List Text,
    forests : List Text,
    seas : List Text,
    items : List Text,
    quests : List Text
  }

  forge-setting : Integer -> Setting
  forge-setting (s) = Setting {
    kingdom = forge-kingdom s,
    capital = forge-city (s + 17),
    ruler = forge-ruler (s + 29),
    regions = [forge-region (s + 100), forge-region (s + 211), forge-region (s + 322)],
    villages = [forge-village (s + 400), forge-village (s + 517), forge-village (s + 631), forge-village (s + 743)],
    forests = [forge-forest (s + 800), forge-forest (s + 919)],
    seas = [forge-sea (s + 1000), forge-desert (s + 1117), forge-mountain (s + 1231)],
    items = [forge-item (s + 1300), forge-item (s + 1409)],
    quests = [forge-quest (s + 1500), forge-quest (s + 1613)]
  }

Section: Format

  join-comma : List Text, Integer, Integer, Text -> Text
  join-comma (xs) (i) (n) (acc) =
    if i >= n then acc
    else join-comma xs (i + 1) n (if i == 0 then list-at xs i else acc & ", " & list-at xs i)

  jc : List Text -> Text
  jc (xs) = join-comma xs 0 (list-length xs) ""

  format-setting : Setting -> Text
  format-setting (w) =
    "Kingdom of " & w.kingdom & "\n"
    & "  Ruler:    " & w.ruler & "\n"
    & "  Capital:  " & w.capital & "\n"
    & "  Regions:  " & jc (w.regions) & "\n"
    & "  Villages: " & jc (w.villages) & "\n"
    & "  Wilds:    " & jc (w.forests) & ", " & jc (w.seas) & "\n"
    & "  Relics:   " & jc (w.items) & "\n"
    & "  Quests:   " & jc (w.quests)
