Chapter: WorkflowExporterInteraction

 We say:

Section: Action Dispatch

  dispatch-action : Text -> Integer
  dispatch-action (action) =
    if action == "export-workflow" then exportWorkflow 0
    else if action == "send-to-comfy" then sendToComfy 0
    else if action == "copy-wf" then copyWf 0
    else if action == "download-wf" then downloadWf 0
    else 0

  dispatch-pipeline : Text -> Integer
  dispatch-pipeline (idx-str) =
    let idx = parse-int idx-str
    in let s = js-set-global "selPipeline" idx
    in js-call-global "renderPipelines" 0

Section: Event Handlers

  on-action-click : Integer -> Integer
  on-action-click (evt) =
    let tgt = dom-event-target evt
    in let el = dom-closest tgt "[data-action]"
    in if dom-not-null el then
      let action = dom-dataset-get el "action"
      in if action == "select-pipeline" then
        let idx = dom-dataset-get el "index"
        in dispatch-pipeline idx
      else dispatch-action action
    else 0

  exportWorkflow : Integer -> Integer
  exportWorkflow (x) = js-call-global "exportWorkflow" 0

  sendToComfy : Integer -> Integer
  sendToComfy (x) = js-call-global "sendToComfy" 0

  copyWf : Integer -> Integer
  copyWf (x) = js-call-global "copyWf" 0

  downloadWf : Integer -> Integer
  downloadWf (x) = js-call-global "downloadWf" 0

Section: Setup

  setup-workflow-events : Integer -> Integer
  setup-workflow-events (x) =
    let doc = dom-document 0
    in let d2 = dom-on-click doc (on-action-click)
    in 0

