Chapter: SettingDesigner

 Landscape and environment generator. Biome, time of day, weather,
 mood, and scale controls. Outputs backgrounds, dungeon maps, and
 battle arena art.

 We say:

Section: Biomes

  BiomeDef = record { name : Text, traits : Text }

  biome-defs : List BiomeDef
  biome-defs = [
    BiomeDef { name = "Forest", traits = "dense ancient forest, massive trees, dappled sunlight, ferns and moss, forest floor" },
    BiomeDef { name = "Desert", traits = "vast desert dunes, golden sand, heat shimmer, distant oasis, cracked earth" },
    BiomeDef { name = "Cavern", traits = "underground cavern, stalactites and stalagmites, crystal formations, underground river" },
    BiomeDef { name = "Ruins", traits = "ancient stone ruins, crumbling pillars, overgrown with vines, forgotten civilization" },
    BiomeDef { name = "Volcanic", traits = "volcanic landscape, molten lava flows, obsidian rock, ash clouds, ember particles" },
    BiomeDef { name = "Tundra", traits = "frozen tundra, ice sheets, northern lights aurora, snow-covered mountains" },
    BiomeDef { name = "Ocean", traits = "open ocean, towering waves, sea spray, distant island, deep blue water" },
    BiomeDef { name = "Mountain", traits = "alpine mountain peaks, snow-capped summits, rocky cliffs, eagles soaring" },
    BiomeDef { name = "Swamp", traits = "murky swamp, twisted dead trees, fog and mist, glowing mushrooms, still water" },
    BiomeDef { name = "City", traits = "medieval fantasy city, cobblestone streets, timber frame buildings, market square" },
    BiomeDef { name = "Castle", traits = "massive stone fortress, battlements and towers, drawbridge, siege-ready walls" },
