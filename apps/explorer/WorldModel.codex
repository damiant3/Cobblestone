Chapter: WorldModel

 Canonical, system-independent game entities, plus the system-neutral
 abstraction the rule-system emitters lower from. An entity's identity,
 appearance, and lore are invariant; only its stats render per system.

 The abstraction is a tagged union over entity kinds (weapon, character, ...),
 so one Entity type carries any kind and the emitters dispatch on the tag.
 Entities are authored in-source for the slice; DB-backing (entity /
 relationship / event tables, keyed to identity) is the generalization.
 See docs/Designs/Apps/Explorer/Active/GameWorldDesigner.md + CampaignStudio.md.

 We say:

Section: Types

 granted-effects is a List Text (the html runtime has no text-split, so
 effects are a list, not a comma string).

  WeaponAbstraction = record {
    weapon-class : Text,
    power-tier : Text,
    damage-concept : Text,
    affinity : Text,
    wielder-constraint : Text,
    granted-effects : List Text,
    narrative-weight : Integer
  }

  CharacterAbstraction = record {
    role : Text,
    power-tier : Text,
    vocation : Text,
    disposition : Text,
    signature : Text,
    granted-effects : List Text,
    narrative-weight : Integer
  }

  Abstraction =
    | WeaponAbs (WeaponAbstraction)
    | CharAbs (CharacterAbstraction)

  Entity = record {
    name : Text,
    kind : Text,
    taxonomy : Text,
    appearance : Text,
    lore : Text,
    abstraction : Abstraction
  }

Section: Excalibur

  excalibur : Entity
  excalibur = Entity {
    name = "Excalibur",
    kind = "weapon",
    taxonomy = "longsword",
    appearance = "ornate fantasy longsword, straight double-edged mirror-bright blade, golden cruciform crossguard set with sapphires, leather-wrapped grip, faint radiant glow",
    lore = "The sword of King Arthur, given to him by the Lady of the Lake. Its blade blazes with light against the wicked, and its scabbard wards its bearer from mortal wounds. It answers only to the rightful sovereign of Britain.",
    abstraction = WeaponAbs (WeaponAbstraction {
      weapon-class = "blade",
      power-tier = "artifact",
      damage-concept = "slashing",
      affinity = "radiant",
      wielder-constraint = "royalty",
      granted-effects = ["leadership-aura", "blinding-light", "ward-wounds"],
      narrative-weight = 100
    })
  }

Section: Merlin

  merlin : Entity
  merlin = Entity {
    name = "Merlin",
    kind = "character",
    taxonomy = "archmage",
    appearance = "elderly archmage, long white beard, deep midnight-blue robes flecked with silver stars, gnarled oaken staff topped with a glowing crystal, piercing knowing eyes",
    lore = "Cambion seer and counselor to kings, keeper of prophecy. He bends elements and fate alike, yet is bound by his own foretellings. Mentor to Arthur and architect of Camelot's rise.",
    abstraction = CharAbs (CharacterAbstraction {
      role = "Archmage",
      power-tier = "artifact",
      vocation = "arcane caster",
      disposition = "ancient, wise, and inscrutable",
      signature = "Command the Elements",
      granted-effects = ["spellcasting", "counterspell", "foresight"],
      narrative-weight = 100
    })
  }

Section: Camelot Set

  carnwennan : Entity
  carnwennan = Entity {
    name = "Carnwennan",
    kind = "weapon",
    taxonomy = "dagger",
    appearance = "slim fantasy dagger, blackened blade that drinks light, shadow curling along its edge, plain silver hilt",
    lore = "Arthur's hidden dagger, the Little White-Hilt. It cloaks its wielder in shadow, and struck down the Very Black Witch in her own hall.",
    abstraction = WeaponAbs (WeaponAbstraction {
      weapon-class = "blade",
      power-tier = "legendary",
      damage-concept = "slashing",
      affinity = "shadow",
      wielder-constraint = "worthiness",
      granted-effects = ["blinding-light"],
      narrative-weight = 70
    })
  }

  galahad : Entity
  galahad = Entity {
    name = "Galahad",
    kind = "character",
    taxonomy = "knight",
    appearance = "young knight in spotless silver plate, white surcoat with a red cross, serene and resolute face, faint halo of light",
    lore = "The purest knight of the Round Table, the only one to achieve the Holy Grail. His virtue is his armour and his resolve never breaks.",
    abstraction = CharAbs (CharacterAbstraction {
      role = "Grail Knight",
      power-tier = "legendary",
      vocation = "martial",
      disposition = "pure, devout, and unshakeable",
      signature = "Strike with the Light of the Grail",
      granted-effects = ["foresight"],
      narrative-weight = 80
    })
  }

  morgan : Entity
  morgan = Entity {
    name = "Morgan le Fay",
    kind = "character",
    taxonomy = "sorceress",
    appearance = "raven-haired enchantress in flowing dark-green and black robes, glowing runes circling her hands, cold beautiful face, crow at her shoulder",
    lore = "Half-sister to Arthur, healer and schemer, mistress of shapeshifting and illusion. Her loyalties shift like the tide, but her power never wanes.",
    abstraction = CharAbs (CharacterAbstraction {
      role = "Enchantress",
      power-tier = "legendary",
      vocation = "arcane caster",
      disposition = "proud, cunning, and mercurial",
      signature = "Weave Fate and Illusion",
      granted-effects = ["counterspell", "spellcasting"],
      narrative-weight = 85
    })
  }

  camelot-entities : List Entity
  camelot-entities = [excalibur, carnwennan, merlin, galahad, morgan]

