Chapter: WidgetDemo
  cites Explorer chapter ExplorerTheme

 We say:

Section: State Keys

  sk-count : Text = "count"
  sk-name : Text = "name"
  sk-theme-idx : Text = "theme-idx"

Section: Render

  render : Integer -> Integer
  render (x) =
   let count = state-get sk-count
   in let name = state-get-text sk-name
   in let greeting = if text-length name > 0 then "Hello, " & name & "!" else "Type your name below"
   in let tree = widget-panel "root" DirColumn 12 [
     widget-label "title" "Codex Widget Demo",
     widget-separator "sep1",
     widget-panel "greeting-row" DirRow 8 [
       widget-label "greet" greeting,
       widget-gauge "counter" count 20
     ],
     widget-panel "btn-row" DirRow 8 [
       widget-button "inc" "+1",
       widget-button "dec" "-1",
       widget-button "reset" "Reset",
       widget-button "alert-btn" "Alert",
       widget-button "confirm-btn" "Confirm"
     ],
     widget-input "name-input" "Enter your name" 0,
     widget-separator "sep2",
     widget-label "status" ("Count: " & show count)
   ]
   in let m = mount-widget-themed dark-gold tree
   in let inc-el = dom-get "inc"
   in let i2 = dom-on-click inc-el (do-inc)
   in let dec-el = dom-get "dec"
   in let d2 = dom-on-click dec-el (do-dec)
   in let rst-el = dom-get "reset"
   in let r2 = dom-on-click rst-el (do-reset)
   in let name-el = dom-get "name-input"
   in let n2 = dom-on-input name-el (do-name)
   in let alert-el = dom-get "alert-btn"
   in let a2 = dom-on-click alert-el (do-alert)
   in let conf-el = dom-get "confirm-btn"
   in let c2 = dom-on-click conf-el (do-confirm)
   in let title-el = dom-get "title"
   in let t2 = dom-set-role title-el "heading"
   in let t3 = dom-set-aria title-el "level" "1"
   in let status-el = dom-get "status"
   in let s2 = dom-set-aria status-el "live" "polite"
   in let s3 = dom-set-role status-el "status"
   in 0

Section: Callbacks

  do-inc : Text -> Integer
  do-inc (id) = state-set-render sk-count (state-get sk-count + 1)

  do-dec : Text -> Integer
  do-dec (id) =
   let v = state-get sk-count
   in state-set-render sk-count (if v > 0 then v - 1 else 0)

  do-reset : Text -> Integer
  do-reset (id) = state-set-render sk-count 0

  do-name : Text -> Integer
  do-name (val) =
   let s = state-set-text sk-name val
   in let r = request-render 0
   in 0

  do-alert : Text -> Integer
  do-alert (id) = show-alert "Hello" "This is a Codex alert dialog." (alert-done)

  alert-done : Text -> Integer
  alert-done (result) = 0

  do-confirm : Text -> Integer
  do-confirm (id) = show-confirm "Confirm" "Reset the counter to zero?" (confirm-done)

  confirm-done : Text -> Integer
  confirm-done (result) =
   if result == "ok" then state-set-render sk-count 0
   else 0

Section: Entry

  opening : [Console] Nothing = act
   let s1 = state-set sk-count 0
   in let s2 = state-set-text sk-name ""
   in let s3 = set-render (render)
   in let theme = inject-theme-css dark-gold
   in let r = render 0
   in print-line ""
  end

