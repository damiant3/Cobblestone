Chapter: CharMini

 Minimal character designer test. Just enough to prove the pipeline.

 We say:

Section: Data

  SubRace = record { name : Text, traits : Text }

  races : List SubRace
  races = [
    SubRace { name = "High Elf", traits = "high elf, pale luminous skin, silver hair" },
    SubRace { name = "Wood Elf", traits = "wood elf, tanned skin, green hair, wild" },
    SubRace { name = "Dark Elf", traits = "dark elf, obsidian skin, white hair, red eyes" }
  ]

  Gender = record { name : Text, traits : Text }

  genders : List Gender
  genders = [
    Gender { name = "Male", traits = "male, masculine features" },
    Gender { name = "Female", traits = "female, feminine features" }
  ]

Section: Prompt Builder

  build-prompt : SubRace, Gender, Text -> Text
  build-prompt (race) (gender) (extra) =
    race.traits & ", " & gender.traits
    & ", fantasy RPG character, professional concept art, 4k"
    & (if text-length extra > 0 then ", " & extra else "")

Section: Entry

  opening : [Console] Nothing = act
    print-line ("Races: " & show (list-length races))
    print-line ("Genders: " & show (list-length genders))
    let p = build-prompt (list-at races 0) (list-at genders 1) "silver crown"
    in print-line ("Prompt: " & p)
  end

