Chapter: ExplorerTheme

 Shared theme for all explorer pages. Defines the UI type system
 (inline to avoid IR size blocker with foreword cites) and the
 dark-gold theme used across Items, Characters, Settings, Cards.

 All CSS is generated from this Theme record at runtime via
 inject-theme-css. No page defines CSS strings.

 We say:

Section: Type System

  Palette = record {
    pal-bg : Integer, pal-fg : Integer, pal-primary : Integer,
    pal-secondary : Integer, pal-accent : Integer, pal-muted : Integer,
    pal-error : Integer, pal-success : Integer, pal-warning : Integer,
    pal-border : Integer
  }

  CornerStyle = | CornerSharp | CornerRound (Integer) | CornerBevel (Integer)
  BorderSide = record { brd-width : Integer, brd-color : Integer }
  Border = record { bdr-top : BorderSide, bdr-right : BorderSide, bdr-bottom : BorderSide, bdr-left : BorderSide, bdr-corner : CornerStyle }
  Edges = record { edge-top : Integer, edge-right : Integer, edge-bottom : Integer, edge-left : Integer }
  WidgetStyle = record { ws-bg : Integer, ws-fg : Integer, ws-border : Border, ws-padding : Edges, ws-margin : Edges, ws-min-width : Integer, ws-min-height : Integer }
  StateStyles = record { ss-normal : WidgetStyle, ss-hover : WidgetStyle, ss-pressed : WidgetStyle, ss-disabled : WidgetStyle, ss-focused : WidgetStyle }

  Theme = record {
    th-name : Text, th-palette : Palette,
    th-panel : StateStyles, th-button : StateStyles,
    th-label : StateStyles, th-input : StateStyles,
    th-gauge : StateStyles, th-separator : StateStyles
  }

Section: Helpers

  bsn : BorderSide = BorderSide { brd-width = 0, brd-color = 0 }
  bn : Border = Border { bdr-top = bsn, bdr-right = bsn, bdr-bottom = bsn, bdr-left = bsn, bdr-corner = CornerSharp }
  ez : Edges = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  bdr : Integer, Integer, CornerStyle -> Border
  bdr (w) (c) (corner) =
    let s = BorderSide { brd-width = w, brd-color = c }
    in Border { bdr-top = s, bdr-right = s, bdr-bottom = s, bdr-left = s, bdr-corner = corner }

  exy : Integer, Integer -> Edges
  exy (x) (y) = Edges { edge-top = y, edge-right = x, edge-bottom = y, edge-left = x }

  eu : Integer -> Edges
  eu (v) = Edges { edge-top = v, edge-right = v, edge-bottom = v, edge-left = v }

  ws : Integer, Integer, Border, Edges, Edges -> WidgetStyle
  ws (bg) (fg) (b) (pad) (mar) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0 }

  ws-sized : Integer, Integer, Border, Edges, Edges, Integer, Integer -> WidgetStyle
  ws-sized (bg) (fg) (b) (pad) (mar) (mw) (mh) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = mw, ws-min-height = mh }

  ss-flat : WidgetStyle -> StateStyles
  ss-flat (s) = StateStyles { ss-normal = s, ss-hover = s, ss-pressed = s, ss-disabled = s, ss-focused = s }

Section: Dark Gold Theme

  dark-gold-palette : Palette
  dark-gold-palette = Palette {
    pal-bg = 657930, pal-fg = 13421772,
    pal-primary = 16763904, pal-secondary = 1315860,
    pal-accent = 16763904, pal-muted = 6710886,
    pal-error = 16007990, pal-success = 5025616,
    pal-warning = 16750848, pal-border = 2763306
  }

  dark-gold : Theme
  dark-gold =
    let p = dark-gold-palette
    in let b1 = bdr 1 (p.pal-border) CornerSharp
    in let pad = exy 16 8
    in let mar = eu 2
    in let base = ws (p.pal-bg) (p.pal-fg) b1 pad mar
    in let btn-n = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-primary) (CornerRound 6)) pad mar
    in let btn-h = ws (p.pal-primary) (p.pal-bg) (bdr 1 (p.pal-primary) (CornerRound 6)) pad mar
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 4)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 4)) pad mar
    in let sep = ws-sized (p.pal-border) (p.pal-border) bn ez (exy 0 8) 0 2
    in Theme {
      th-name = "dark-gold",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = inp-f },
      th-gauge = ss-flat (ws (p.pal-bg) (p.pal-primary) b1 (eu 2) mar),
      th-separator = ss-flat sep
    }

Section: DOM Stubs

  DomElement = record { dom-id : Integer }
  dom-null : DomElement = DomElement { dom-id = 0 }
  dom-get : Text -> DomElement
  dom-get (id) = dom-null
  dom-create : Text -> DomElement
  dom-create (tag) = dom-null
  dom-set-text : DomElement, Text -> DomElement
  dom-set-text (el) (s) = el
  dom-set-html : DomElement, Text -> DomElement
  dom-set-html (el) (s) = el
  dom-get-value : DomElement -> Text
  dom-get-value (el) = ""
  dom-set-value : DomElement, Text -> DomElement
  dom-set-value (el) (v) = el
  dom-append : DomElement, DomElement -> DomElement
  dom-append (parent) (child) = parent
  dom-prepend : DomElement, DomElement -> DomElement
  dom-prepend (parent) (child) = parent
  dom-add-class : DomElement, Text -> DomElement
  dom-add-class (el) (c) = el
  dom-remove-class : DomElement, Text -> DomElement
  dom-remove-class (el) (c) = el
  dom-set-style : DomElement, Text, Text -> DomElement
  dom-set-style (el) (k) (v) = el
  dom-set-attr : DomElement, Text, Text -> DomElement
  dom-set-attr (el) (k) (v) = el
  dom-query : Text -> DomElement
  dom-query (sel) = dom-null
  dom-body : DomElement
  dom-body = dom-null
  random-int : Integer, Integer -> Integer
  random-int (lo) (hi) = lo
  generate-image : Text, Text, Text -> Integer
  generate-image (api-url) (body-json) (card-el-id) = 0
  check-sd-status : Integer -> Integer
  check-sd-status (x) = 0
  state-get : Text -> Integer
  state-get (k) = 0
  state-set : Text, Integer -> Integer
  state-set (k) (v) = v
  state-get-text : Text -> Text
  state-get-text (k) = ""
  state-set-text : Text, Text -> Text
  state-set-text (k) (v) = v
  next-card-id : Integer -> Text
  next-card-id (x) = "c0"
  fetch-json : Text, Text, Text -> DomElement
  fetch-json (url) (method) (body) = dom-null
  json-stringify : Text -> Text
  json-stringify (v) = v
  set-timeout : (Integer -> Integer), Integer -> Integer
  set-timeout (fn) (ms) = 0
  local-storage-get : Text -> Text
  local-storage-get (k) = ""
  local-storage-set : Text, Text -> Integer
  local-storage-set (k) (v) = 0
  inject-theme-css : Theme -> Integer
  inject-theme-css (th) = 0
  theme-to-css : Theme -> Text
  theme-to-css (th) = ""

Section: Shared Explorer Layout

  explorer-layout-css : Text
  explorer-layout-css =
    "body{height:100vh;overflow:hidden}"
    & ".nv{display:flex;gap:2px;padding:6px 24px;border-bottom:1px solid var(--border);background:var(--bg);position:sticky;top:0;z-index:100;flex-shrink:0}"
    & ".nv a{color:var(--muted);text-decoration:none;padding:8px 16px;border-radius:6px;font-size:.85em;font-weight:500}.nv a:hover{color:var(--fg);background:var(--secondary)}.nv a.active{color:var(--primary);background:var(--secondary)}"
    & ".sd{color:var(--muted);font-size:.75em;padding:8px 12px;display:flex;align-items:center;gap:6px}.dot{width:6px;height:6px;border-radius:50%;background:var(--muted);display:inline-block}"
    & ".page{display:grid;grid-template-columns:1fr 340px;height:calc(100vh - 41px);overflow:hidden}"
    & ".left{overflow-y:auto}"
    & ".hd{padding:20px 24px;border-bottom:1px solid var(--border)}.hd h1{color:var(--primary);font-size:1.3em;margin-bottom:16px;font-weight:600}"
    & ".ctrl{display:flex;flex-direction:column;gap:10px}"
    & ".dimbar{display:flex;gap:4px;flex-wrap:wrap}"
    & ".dim{position:relative}.dim-pill{padding:6px 16px;border-radius:16px;border:1px solid var(--primary);color:var(--primary);background:var(--secondary);font-size:.8em;cursor:pointer;user-select:none;white-space:nowrap}"
    & ".dim:hover .dim-pill{background:var(--primary);color:var(--bg)}"
    & ".dd{display:none;position:absolute;top:100%;left:0;margin-top:4px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 0;min-width:160px;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.6);max-height:400px;overflow-y:auto}"
    & ".dim:hover .dd{display:block}"
    & ".dd-item{padding:6px 16px;font-size:.8em;cursor:pointer;white-space:nowrap;transition:background .1s}.dd-item:hover{background:var(--secondary)}.dd-item.active{color:var(--primary);background:var(--secondary)}"
    & ".dd-sec{padding:4px 0;border-bottom:1px solid var(--border)}.dd-cat{display:block;padding:2px 16px;font-size:.65em;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}"
    & ".dd-horiz{display:flex;flex-wrap:wrap;gap:2px;padding:2px 8px}"
    & ".dd-horiz .dd-item{padding:4px 10px;border-radius:12px;border:1px solid var(--border);font-size:.75em}.dd-horiz .dd-item:hover{border-color:var(--muted)}.dd-horiz .dd-item.active{border-color:var(--primary);color:var(--primary)}"
    & ".modbar{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px;padding:8px 0;border-top:1px solid var(--border)}"
    & ".modbar .dim-pill{font-size:.75em;padding:4px 12px;border-color:var(--border);color:var(--fg)}.modbar .dim-pill:hover{border-color:var(--primary)}"
    & ".modbar .dim:hover .dim-pill{background:var(--secondary);color:var(--primary);border-color:var(--primary)}"
    & ".prow{display:flex;gap:10px;align-items:flex-start;margin-top:10px}.prow textarea{flex:1;background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:12px;border-radius:6px;font-size:.9em;min-height:48px;font-family:inherit;resize:vertical}.prow textarea:focus{border-color:var(--primary);outline:none}"
    & ".pc{display:flex;flex-direction:column;gap:4px}.pc label{font-size:.7em;color:var(--muted);text-transform:uppercase}.pc input{background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:8px;border-radius:6px;width:100px;font-size:.9em}"
    & ".tb{display:flex;gap:8px;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}"
    & ".btn{background:var(--secondary);border:1px solid var(--primary);color:var(--primary);padding:8px 20px;border-radius:6px;font-size:.85em;cursor:pointer;font-weight:500}.btn:hover{background:var(--secondary)}.btn.primary{background:var(--primary);color:var(--bg)}"
    & ".hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;background:var(--bg);min-height:300px}"
    & ".hero img{max-width:100%;max-height:50vh;object-fit:contain;border-radius:8px;cursor:pointer;background:var(--secondary)}"
    & ".he{color:var(--muted);font-size:.9em}.hm{margin-top:12px;font-size:.85em;text-align:center}"
    & ".hist{border-left:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}"
    & ".hist h3{padding:12px 16px;color:var(--primary);font-size:.85em;font-weight:600;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg);z-index:1;flex-shrink:0}"
    & "#history{flex:1;overflow-y:auto}"
    & ".rc{display:flex;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border)}.rc:hover{background:var(--secondary)}"
    & ".ri{flex:0 0 64px;height:64px;border-radius:6px;overflow:hidden;background:var(--secondary);position:relative}.ri img{width:100%;height:100%;object-fit:cover;cursor:pointer}"
    & ".rm{display:flex;flex-wrap:wrap;gap:4px;align-items:center;flex:1}.mt{padding:2px 8px;border-radius:8px;font-size:.72em;background:var(--secondary);border:1px solid var(--border);color:var(--fg)}.md{color:var(--muted);border-color:transparent;background:transparent}"
    & ".rb{display:inline-block;padding:2px 8px;border-radius:10px;font-size:.7em;font-weight:600}"
    & ".sp{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}"
    & ".lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:1000;justify-content:center;align-items:center}.lb.on{display:flex}.lb img{max-width:92%;max-height:90%;object-fit:contain;border-radius:8px}.lb .x{position:absolute;top:16px;right:24px;color:#fff;font-size:2em;cursor:pointer;opacity:.6}"
    & "@media(max-width:800px){.page{grid-template-columns:1fr;height:auto}.hist{border-left:none;border-top:1px solid var(--border);max-height:300px}}"

  init-explorer : Integer -> Integer
  init-explorer (x) =
    let t = inject-theme-css dark-gold
    in let style = dom-create "style"
    in let s2 = dom-set-text style explorer-layout-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in let sd = check-sd-status 0
    in 0

Section: Shared Nav Builder

  explorer-nav : Text -> Text
  explorer-nav (active) =
    "<nav class=\"nv\"><a href=\"/item\"" & (if active == "item" then " class=\"active\"" else "") & ">Items</a><a href=\"/character\"" & (if active == "character" then " class=\"active\"" else "") & ">Characters</a><a href=\"/setting\"" & (if active == "setting" then " class=\"active\"" else "") & ">Settings</a><a href=\"/card\"" & (if active == "card" then " class=\"active\"" else "") & ">Cards</a><span style=\"flex:1\"></span><span class=\"sd\"><span id=\"sd-dot\" class=\"dot\"></span> <span id=\"sd-label\">checking...</span></span></nav>"

Section: Shared Dropdown Builder

  selected-name : List Text, Integer -> Text
  selected-name (names) (idx) = if idx < list-length names then list-at names idx else "?"

  build-dropdown-items : List Text, Integer, Text, Integer, Text -> Text
  build-dropdown-items (names) (sel) (group) (i) (acc) =
    if i >= list-length names then acc
    else let n = list-at names i
    in let c = if i == sel then "dd-item active" else "dd-item"
    in build-dropdown-items names sel group (i + 1) (acc & "<div class=\"" & c & "\" onclick=\"pick('" & group & "'," & show i & ")\">" & n & "</div>")

  dim-pill : Text, Text, Text -> Text
  dim-pill (label) (current) (dropdown-html) =
    "<div class=\"dim\"><div class=\"dim-pill\">" & current & "</div><div class=\"dd\">" & dropdown-html & "</div></div>"

Section: Shared Callbacks

  random-seed-cb : Integer -> Integer
  random-seed-cb (x) = let el = dom-get "seed" in let e2 = dom-set-value el (show (random-int 1 999999)) in 0

  close-lb-cb : Integer -> Integer
  close-lb-cb (x) = let lb = dom-get "lb" in let l2 = dom-remove-class lb "on" in 0

  add-history-card : Text, Text, Text -> Text
  add-history-card (card-html) (meta-html) (img-onclick) =
    let cid = next-card-id 0
    in let hist = dom-get "history"
    in let card = dom-create "div"
    in let c2 = dom-add-class card "rc"
    in let c3 = dom-set-attr card "id" cid
    in let ch = "<div class=\"ri\"><div class=\"sp\"></div><img src=\"\" onclick=\"" & img-onclick & "\"></div>" & meta-html
    in let c4 = dom-set-html card ch
    in let c5 = dom-prepend hist card
    in cid

  hero-click-handler : Text
  hero-click-handler = "if(this.src&&this.src.indexOf('data:')<0){document.getElementById('hero-img').src=this.src;document.getElementById('hero-img').style.display='';document.getElementById('hero-empty').style.display='none'}"

