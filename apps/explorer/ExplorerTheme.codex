Chapter: ExplorerTheme
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Shared theme for all explorer pages. Types come from the foreword
 UI modules. The dark-gold theme is defined here. Extra DOM stubs
 beyond WebRuntime are declared below.

 All CSS is generated from this Theme record at runtime via
 inject-theme-css. No page defines CSS strings.

 We say:

Section: Helpers

  ws-sized : Integer, Integer, Border, Edges, Edges, Integer, Integer -> WidgetStyle
  ws-sized (bg) (fg) (b) (pad) (mar) (mw) (mh) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = mw, ws-min-height = mh, ws-shadow = shadow-none, ws-gradient = gradient-none, ws-accent-border = accent-border-none }

Section: Dark Gold Theme

  dark-gold-palette : Palette
  dark-gold-palette = Palette {
    pal-bg = #0A0A0A, pal-fg = #CCCCCC,
    pal-primary = 16763904, pal-secondary = 1315860,
    pal-accent = 16763904, pal-muted = #666666,
    pal-error = 16007990, pal-success = 5025616,
    pal-warning = #FF9900, pal-border = #2A2A2A
  }

  dark-gold : Theme
  dark-gold =
    let p = dark-gold-palette
    in let b1 = bdr 1 (p.pal-border) CornerSharp
    in let pad = exy 16 8
    in let mar = eu 2
    in let base = ws (p.pal-bg) (p.pal-fg) b1 pad mar
    in let btn-n = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-primary) (CornerRound 6)) pad mar
    in let btn-h = ws (p.pal-primary) (p.pal-bg) (bdr 1 (p.pal-primary) (CornerRound 6)) pad mar
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 4)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 4)) pad mar
    in let sep = ws-sized (p.pal-border) (p.pal-border) bn ez (exy 0 8) 0 2
    in Theme {
      th-name = "dark-gold",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = inp-f },
      th-gauge = ss-flat (ws (p.pal-bg) (p.pal-primary) b1 (eu 2) mar),
      th-separator = ss-flat sep
    }

