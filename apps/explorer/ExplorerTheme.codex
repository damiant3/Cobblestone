Section: Component CSS

  css-base : Text
  css-base = "body{height:100vh;overflow:hidden}"

  css-nav : Text
  css-nav =
    ".nv{display:flex;gap:2px;padding:6px 24px;border-bottom:1px solid var(--border);background:var(--bg);position:sticky;top:0;z-index:100;flex-shrink:0}"
    & ".nv a{color:var(--muted);text-decoration:none;padding:8px 16px;border-radius:6px;font-size:.85em;font-weight:500}"
    & ".nv a:hover{color:var(--fg);background:var(--secondary)}.nv a.active{color:var(--primary);background:var(--secondary)}"
    & ".sd{color:var(--muted);font-size:.75em;padding:8px 12px;display:flex;align-items:center;gap:6px}"
    & ".dot{width:6px;height:6px;border-radius:50%;background:var(--muted);display:inline-block}"

  css-page-grid : Text
  css-page-grid =
    ".page{display:grid;grid-template-columns:1fr 340px;height:calc(100vh - 41px);overflow:hidden}"
    & ".left{overflow-y:auto}"
    & "@media(max-width:800px){.page{grid-template-columns:1fr;height:auto}.hist{border-left:none;border-top:1px solid var(--border);max-height:300px}}"

  css-header : Text
  css-header =
    ".hd{padding:20px 24px;border-bottom:1px solid var(--border)}"
    & ".hd h1{color:var(--primary);font-size:1.3em;margin-bottom:16px;font-weight:600}"
    & ".ctrl{display:flex;flex-direction:column;gap:10px}"

  css-dim-picker : Text
  css-dim-picker =
    ".dimbar{display:flex;gap:4px;flex-wrap:wrap}"
    & ".dim{position:relative}"
    & ".dim-pill{padding:6px 16px;border-radius:16px;border:1px solid var(--primary);color:var(--primary);background:var(--secondary);font-size:.8em;cursor:pointer;user-select:none;white-space:nowrap}"
    & ".dim:hover .dim-pill{background:var(--primary);color:var(--bg)}"
    & ".dd{display:none;position:absolute;top:100%;left:0;margin-top:4px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 0;min-width:160px;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.6);max-height:400px;overflow-y:auto}"
    & ".dim:hover .dd{display:block}"
    & ".dd-item{padding:6px 16px;font-size:.8em;cursor:pointer;white-space:nowrap;transition:background .1s}"
    & ".dd-item:hover{background:var(--secondary)}.dd-item.active{color:var(--primary);background:var(--secondary)}"
    & ".dd-sec{padding:4px 0;border-bottom:1px solid var(--border)}"
    & ".dd-cat{display:block;padding:2px 16px;font-size:.65em;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}"
    & ".dd-horiz{display:flex;flex-wrap:wrap;gap:2px;padding:2px 8px}"
    & ".dd-horiz .dd-item{padding:4px 10px;border-radius:12px;border:1px solid var(--border);font-size:.75em}"
    & ".dd-horiz .dd-item:hover{border-color:var(--muted)}.dd-horiz .dd-item.active{border-color:var(--primary);color:var(--primary)}"
    & ".exp-spacer{flex:1}"
    & ".modbar{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px;padding:8px 0;border-top:1px solid var(--border)}"
    & ".modbar .dim-pill{font-size:.75em;padding:4px 12px;border-color:var(--border);color:var(--fg)}"
    & ".modbar .dim-pill:hover{border-color:var(--primary)}"
    & ".modbar .dim:hover .dim-pill{background:var(--secondary);color:var(--primary);border-color:var(--primary)}"

  css-prompt : Text
  css-prompt =
    ".prow{display:flex;gap:10px;align-items:flex-start;margin-top:10px}"
    & ".prow textarea{flex:1;background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:12px;border-radius:6px;font-size:.9em;min-height:48px;font-family:inherit;resize:vertical}"
    & ".prow textarea:focus{border-color:var(--primary);outline:none}"
    & ".pc{display:flex;flex-direction:column;gap:4px}"
    & ".pc label{font-size:.7em;color:var(--muted);text-transform:uppercase}"
    & ".pc input{background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:8px;border-radius:6px;width:100px;font-size:.9em}"

  css-toolbar : Text
  css-toolbar =
    ".tb{display:flex;gap:8px;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}"
    & ".btn{background:var(--secondary);border:1px solid var(--primary);color:var(--primary);padding:8px 20px;border-radius:6px;font-size:.85em;cursor:pointer;font-weight:500}"
    & ".btn:hover{background:var(--secondary)}.btn.primary{background:var(--primary);color:var(--bg)}"

  css-hero : Text
  css-hero =
    ".hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;background:var(--bg);min-height:300px}"
    & ".hero img{max-width:100%;max-height:50vh;object-fit:contain;border-radius:8px;cursor:pointer;background:var(--secondary)}"
    & ".he{color:var(--muted);font-size:.9em}.hm{margin-top:12px;font-size:.85em;text-align:center}"

  css-history : Text
  css-history =
    ".hist{border-left:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}"
    & ".hist h3{padding:12px 16px;color:var(--primary);font-size:.85em;font-weight:600;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg);z-index:1;flex-shrink:0}"
    & "#history{flex:1;overflow-y:auto}"
    & ".rc{display:flex;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border)}.rc:hover{background:var(--secondary)}"
    & ".ri{flex:0 0 64px;height:64px;border-radius:6px;overflow:hidden;background:var(--secondary);position:relative}"
    & ".ri img{width:100%;height:100%;object-fit:cover;cursor:pointer}"
    & ".rm{display:flex;flex-wrap:wrap;gap:4px;align-items:center;flex:1}"
    & ".mt{padding:2px 8px;border-radius:8px;font-size:.72em;background:var(--secondary);border:1px solid var(--border);color:var(--fg)}"
    & ".md{color:var(--muted);border-color:transparent;background:transparent}"
    & ".rb{display:inline-block;padding:2px 8px;border-radius:10px;font-size:.7em;font-weight:600}"

  css-spinner : Text
  css-spinner =
    ".sp{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite}"
    & "@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}"

  css-lightbox : Text
  css-lightbox =
    ".lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:1000;justify-content:center;align-items:center}"
    & ".lb.on{display:flex}.lb img{max-width:92%;max-height:90%;object-fit:contain;border-radius:8px}"
    & ".lb .x{position:absolute;top:16px;right:24px;color:#fff;font-size:2em;cursor:pointer;opacity:.6}"

  css-pips : Text
  css-pips =
    ".sd-app{display:flex;flex-direction:column;height:calc(100vh - 41px);overflow:hidden}"
    & ".sd-hd{padding:14px 24px 0}.sd-hd h1{color:var(--primary);font-size:1.3em;font-weight:600}"
    & ".sd-prompt{padding:10px 24px}"
    & ".sd-prompt textarea{width:100%;background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:12px;border-radius:8px;min-height:60px;font-family:inherit;font-size:.9em;resize:vertical}"
    & ".sd-prompt textarea:focus{border-color:var(--primary);outline:none}"
    & ".dimrow{display:flex;align-items:flex-start;flex-wrap:wrap;gap:8px;padding:8px 24px 0;flex-shrink:0;overflow:visible;position:relative}"
    & ".pip{display:inline-block;padding:6px 16px;border-radius:16px;border:1px solid var(--primary);color:var(--primary);background:var(--secondary);font-size:.82em;cursor:pointer;white-space:nowrap;user-select:none}"
    & ".pip:hover{background:var(--primary);color:var(--bg)}"
    & ".pip.active{background:var(--primary);color:var(--bg);font-weight:600}"
    & ".dimw{position:static}"
    & ".dimw .pop{display:none;position:absolute;top:100%;z-index:60}"
    & ".dimw:hover .pop.pop-wrap{display:flex;flex-wrap:wrap;gap:6px;left:0;right:0;padding:8px 24px 0;box-sizing:border-box}"
    & ".dimw:hover .pop.pop-col{display:flex;flex-direction:column;gap:5px;align-items:stretch;width:max-content;left:24px;padding-top:8px}"
    & ".cat{display:block;position:relative}"
    & ".pop-col .pip.catpip{display:block;text-align:center}"
    & ".pip.catpip{border-color:var(--border);color:var(--fg)}"
    & ".pip.catpip:hover{border-color:var(--primary);color:var(--primary);background:var(--secondary)}"
    & ".cat .catpop{display:none}"
    & ".cat:hover .catpop{display:flex;flex-wrap:wrap;gap:5px;position:absolute;left:100%;top:0;padding-left:12px;width:540px;align-content:flex-start}"
    & ".btnbar{display:flex;gap:10px;align-items:center;padding:12px 24px;border-top:1px solid var(--border);flex-shrink:0}"
    & ".btnbar .btn{background:var(--secondary);border:1px solid var(--primary);color:var(--primary);padding:9px 22px;border-radius:6px;font-size:.9em;cursor:pointer;font-weight:500}"
    & ".btnbar .btn.primary{background:var(--primary);color:var(--bg)}"
    & ".btnbar input{background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:9px;border-radius:6px;width:120px;font-size:.9em}"
    & ".sd-app .hero{flex:1;min-height:120px;border:none}"
    & ".sd-app .hist{border-left:none;border-top:1px solid var(--border);max-height:150px}"
    & ".sd-app .hist h3{position:sticky;top:0}"

  explorer-layout-css : Text
  explorer-layout-css =
    css-base & css-nav & css-page-grid & css-header & css-dim-picker & css-prompt & css-toolbar & css-hero & css-history & css-spinner & css-lightbox & css-pips

  init-explorer : Integer -> Integer
  init-explorer (x) =
    let t = inject-theme-css dark-gold
    in let style = dom-create "style"
    in let s2 = dom-set-text style explorer-layout-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in let sd = check-sd-status 0
    in 0

Section: Shared Nav Builder

  explorer-nav : Text -> Text
  explorer-nav (active) =
    "<nav class=\"nv\"><a href=\"/item\"" & (if active == "item" then " class=\"active\"" else "") & ">Items</a><a href=\"/character\"" & (if active == "character" then " class=\"active\"" else "") & ">Characters</a><a href=\"/setting\"" & (if active == "setting" then " class=\"active\"" else "") & ">Settings</a><a href=\"/card\"" & (if active == "card" then " class=\"active\"" else "") & ">Cards</a><a href=\"/mine\"" & (if active == "mine" then " class=\"active\"" else "") & ">My Creations</a><span class=\"exp-spacer\"></span><span class=\"sd\"><span id=\"sd-dot\" class=\"dot\"></span> <span id=\"sd-label\">checking...</span></span></nav>"

Section: Shared Dropdown Builder

  selected-name : List Text, Integer -> Text
  selected-name (names) (idx) = if idx < list-length names then list-at names idx else "?"

  build-dropdown-items : List Text, Integer, Text, Integer, Text -> Text
  build-dropdown-items (names) (sel) (group) (i) (acc) =
    if i >= list-length names then acc
    else let n = list-at names i
    in let c = if i == sel then "dd-item active" else "dd-item"
    in build-dropdown-items names sel group (i + 1) (acc & "<div class=\"" & c & "\" data-action=\"pick\" data-value=\"" & group & "," & show i & "\">" & n & "</div>")

  dim-pill : Text, Text, Text -> Text
  dim-pill (label) (current) (dropdown-html) =
    "<div class=\"dim\"><div class=\"dim-pill\">" & current & "</div><div class=\"dd\">" & dropdown-html & "</div></div>"

Section: Custom Widgets

 Declarative widget constructors built on widget-custom. Data is encoded
 in children (one label per option / button) and wn-state (selected index,
 seed default, primary flag). The HTML plug's _wkCustom renders each tag
 using the shared component CSS classes (.dim, .hero, .hist, .prow, .tb,
 .nv). No page emits HTML strings.

  widget-h1 : Text -> WidgetNode
  widget-h1 (txt) =
    widget-add-child (widget-custom "h1" "h1" 0 0) (widget-label "h1t" txt)

  widget-nav : Text -> WidgetNode
  widget-nav (active) = widget-custom active "nav" 0 0

  names-to-options : Text, List Text, Integer, Integer, List WidgetNode -> List WidgetNode
  names-to-options (g) (ns) (i) (n) (acc) =
    if i >= n then acc
    else names-to-options g ns (i + 1) n (list-push acc (widget-label (g & "-o-" & show i) (list-at ns i)))

  widget-dim-picker : Text, List Text, Integer -> WidgetNode
  widget-dim-picker (group) (names) (sel) =
    let base = widget-custom group "dim-picker" 0 0
    in let opts = names-to-options group names 0 (list-length names) []
    in let filled = wk-attach base opts 0 (list-length opts)
    in widget-set-state filled sel

  widget-prompt-field : Text, Integer -> WidgetNode
  widget-prompt-field (placeholder) (seed) =
    let w = widget-add-child (widget-custom "prompt" "prompt-field" 0 0) (widget-label "ph" placeholder)
    in widget-set-state w seed

  widget-primary-button : Text, Text -> WidgetNode
  widget-primary-button (id) (txt) = widget-set-state (widget-button id txt) 2

  widget-toolbar-strip : Text, List WidgetNode -> WidgetNode
  widget-toolbar-strip (id) (btns) =
    wk-attach (widget-custom id "toolbar" 0 0) btns 0 (list-length btns)

  widget-hero : Text -> WidgetNode
  widget-hero (empty-msg) =
    widget-add-child (widget-custom "hero" "hero" 0 0) (widget-label "hm" empty-msg)

  widget-history : Integer -> WidgetNode
  widget-history (x) = widget-custom "history" "history" 0 0

  widget-lightbox : Integer -> WidgetNode
  widget-lightbox (x) = widget-custom "lb" "lightbox" 0 0

 Pip-tree dimension selector: a head pip (current value) that on hover
 reveals option pips (flat) or category pips that themselves reveal their
 members (grouped). Leaves carry the global option index in wn-state.

  widget-opt : Text, Text, Integer -> WidgetNode
  widget-opt (idp) (name) (idx) =
    widget-set-state (widget-add-child (widget-custom idp "opt" 0 0) (widget-label (idp & "l") name)) idx

  opts-range : Text, List Text, Integer, Integer, List WidgetNode -> List WidgetNode
  opts-range (idp) (ns) (i) (to) (acc) =
    if i >= to then acc
    else opts-range idp ns (i + 1) to (list-push acc (widget-opt (idp & "-" & show i) (list-at ns i) i))

  widget-cat-range : Text, Text, List Text, Integer, Integer -> WidgetNode
  widget-cat-range (id) (name) (names) (from) (to) =
    let base = widget-add-child (widget-custom id "cat" 0 0) (widget-label (id & "h") name)
    in let kids = opts-range id names from to []
    in wk-attach base kids 0 (list-length kids)

  widget-dimsel : Text, Text, Integer, List WidgetNode -> WidgetNode
  widget-dimsel (group) (head) (sel) (kids) =
    let base = widget-add-child (widget-custom group "dimsel" 0 0) (widget-label (group & "h") head)
    in widget-set-state (wk-attach base kids 0 (list-length kids)) sel

  widget-dim-flat : Text, List Text, Integer -> WidgetNode
  widget-dim-flat (group) (names) (sel) =
    let head = if sel < list-length names then list-at names sel else "?"
    in widget-dimsel group head sel (opts-range group names 0 (list-length names) [])

  widget-prompt-only : Text -> WidgetNode
  widget-prompt-only (placeholder) =
    widget-add-child (widget-custom "prompt" "prompt-only" 0 0) (widget-label "ph" placeholder)

  widget-btnbar : Integer -> WidgetNode
  widget-btnbar (seed) = widget-set-state (widget-custom "btnbar" "btnbar" 0 0) seed

  widget-btnbar-batch : Integer -> WidgetNode
  widget-btnbar-batch (seed) = widget-set-state (widget-custom "btnbar" "btnbar-batch" 0 0) seed

 Colored leaf pip (rarity): name in child 0, hex colour in child 1, global
 index in wn-state. Category by explicit index list (for the Type tree,
 whose members are not a contiguous range of item-categories).

  widget-opt-color : Text, Text, Integer, Text -> WidgetNode
  widget-opt-color (idp) (name) (idx) (color) =
    let base = widget-add-child (widget-custom idp "optc" 0 0) (widget-label (idp & "l") name)
    in widget-set-state (widget-add-child base (widget-label (idp & "c") color)) idx

  opts-idx : Text, List Text, List Integer, Integer, List WidgetNode -> List WidgetNode
  opts-idx (idp) (ns) (idxs) (i) (acc) =
    if i >= list-length idxs then acc
    else let k = list-at idxs i
    in opts-idx idp ns idxs (i + 1) (list-push acc (widget-opt (idp & "-" & show k) (list-at ns k) k))

  widget-cat-idx : Text, Text, List Text, List Integer -> WidgetNode
  widget-cat-idx (id) (name) (names) (idxs) =
    let base = widget-add-child (widget-custom id "cat" 0 0) (widget-label (id & "h") name)
    in let kids = opts-idx id names idxs 0 []
    in wk-attach base kids 0 (list-length kids)

Section: Shared Callbacks

  random-seed-cb : Integer -> Integer
  random-seed-cb (x) = let el = dom-get "seed" in let e2 = dom-set-value el (show (random-int 1 999999)) in 0

  close-lb-cb : Integer -> Integer
  close-lb-cb (x) = let lb = dom-get "lb" in let l2 = dom-remove-class lb "on" in 0

  add-history-card : Text, Text, Text -> Text
  add-history-card (card-html) (meta-html) (img-onclick) =
    let cid = next-card-id 0
    in let hist = dom-get "history"
    in let card = dom-create "div"
    in let c2 = dom-add-class card "rc"
    in let c3 = dom-set-attr card "id" cid
    in let ch = "<div class=\"ri\"><div class=\"sp\"></div><img src=\"\" onclick=\"" & img-onclick & "\"></div>" & meta-html
    in let c4 = dom-set-html card ch
    in let c5 = dom-prepend hist card
    in cid

  hero-click-handler : Text
  hero-click-handler = "if(this.src&&this.src.indexOf('data:')<0){document.getElementById('hero-img').src=this.src;document.getElementById('hero-img').style.display='';document.getElementById('hero-empty').style.display='none'}"

Section: DB Fetch Helpers

 Shared by the DB-backed designer pages. A dimension's rows are fetched
 once over AJAX (/api/d/<table>), stashed as JSON text under a state key,
 and parsed on demand into a list of rows (each row a list of text fields).
 json-parse is the HTML runtime's JSON.parse (its stub body is never
 emitted). text-to-int is pure Codex so it needs no runtime builtin; it is
 used to read the integer group bounds (from/to) of grouped dimensions.

  json-parse : Text -> List (List Text)
  json-parse (s) = []

  parse-table : Text -> List (List Text)
  parse-table (key) =
    let s = state-get-text key
    in if text-length s == 0 then [] else json-parse s

  tbl-col0 : List (List Text), Integer, Integer, List Text -> List Text
  tbl-col0 (rows) (i) (n) (acc) =
    if i >= n then acc
    else tbl-col0 rows (i + 1) n (list-push acc (list-at (list-at rows i) 0))

  tbl-names : Text -> List Text
  tbl-names (key) = let r = parse-table key in tbl-col0 r 0 (list-length r) []

  tbl-field : Text, Integer, Integer -> Text
  tbl-field (key) (row) (col) =
    let rs = parse-table key
    in if row < list-length rs
       then let r = list-at rs row in (if col < list-length r then list-at r col else "")
       else ""

  tti-loop : Text, Integer, Integer, Integer -> Integer
  tti-loop (s) (i) (n) (acc) =
    if i >= n then acc
    else let c = char-code (char-at s i)
    in if c < 48 then tti-loop s (i + 1) n acc
       else if c > 57 then tti-loop s (i + 1) n acc
       else tti-loop s (i + 1) n (acc * 10 + (c - 48))

  text-to-int : Text -> Integer
  text-to-int (s) = tti-loop s 0 (text-length s) 0

Section: Designer Helpers

 Shared page scaffold and generation body builder for the DB-backed designer
 apps. Each designer calls designer-page-tree with its nav id, title, and
 prompt placeholder; the scaffold provides the standard layout (nav, header,
 prompt field, dimension row placeholder, hero, button bar, history panel,
 lightbox). gen-body builds the /api/generate JSON payload.

  designer-page-tree : Text, Text, Text -> WidgetNode
  designer-page-tree (nav-id) (title) (prompt-hint) =
    widget-box "approot" "" [
      widget-nav nav-id,
      widget-box "sdapp" "sd-app" [
        widget-box "hd" "sd-hd" [ widget-h1 title ],
        widget-box "pr" "sd-prompt" [ widget-prompt-only prompt-hint ],
        widget-box "dimrow" "dimrow" [ widget-label "ld" "loading dimensions..." ],
        widget-hero ("Generate to see " & nav-id & " here"),
        widget-btnbar 424242,
        widget-history 0
      ],
      widget-lightbox 0
    ]

  designer-page-tree-batch : Text, Text, Text -> WidgetNode
  designer-page-tree-batch (nav-id) (title) (prompt-hint) =
    widget-box "approot" "" [
      widget-nav nav-id,
      widget-box "sdapp" "sd-app" [
        widget-box "hd" "sd-hd" [ widget-h1 title ],
        widget-box "pr" "sd-prompt" [ widget-prompt-only prompt-hint ],
        widget-box "dimrow" "dimrow" [ widget-label "ld" "loading dimensions..." ],
        widget-hero ("Generate to see " & nav-id & " here"),
        widget-btnbar-batch 424242,
        widget-history 0
      ],
      widget-lightbox 0
    ]

  gen-body : Text, Text, Text, Integer, Integer -> Text
  gen-body (prompt) (neg) (seed) (w) (h) =
    "{\"prompt\":\"" & prompt & "\",\"negative_prompt\":\"" & neg & "\",\"model_title\":\"\",\"model_short\":\"default\",\"sampler\":\"DPM++ SDE\",\"steps\":12,\"cfg\":2,\"lora\":\"\",\"lora_short\":\"none\",\"seed\":" & seed & ",\"width\":" & show w & ",\"height\":" & show h & "}"

