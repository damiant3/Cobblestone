Chapter: CharDesignerApp
  cites Explorer chapter ExplorerTheme

 Character designer. Compiled through the HTML plug.
 DOM stubs, theme types, and dark-gold theme from ExplorerTheme.

 We say:

Section: Data

  SubRace = record { name : Text, traits : Text }
  ClassDef = record { name : Text, gear : Text }
  GenderDef = record { name : Text, traits : Text }
  PersonalityDef = record { name : Text, expression : Text }
  PortraitMode = record { name : Text, framing : Text }

  all-races : List SubRace
  all-races = [
    SubRace { name = "European", traits = "fair skin, European features" },
    SubRace { name = "African", traits = "dark skin, African features, strong jawline" },
    SubRace { name = "East Asian", traits = "East Asian features, almond eyes" },
    SubRace { name = "High Elf", traits = "high elf, pale luminous skin, silver or gold hair, regal" },
    SubRace { name = "Wood Elf", traits = "wood elf, tanned skin, green hair, wild and feral" },
    SubRace { name = "Dark Elf", traits = "dark elf, obsidian black skin, white hair, red eyes" },
    SubRace { name = "Mountain Dwarf", traits = "mountain dwarf, grey stone-dust in beard, heavy plate" },
    SubRace { name = "Green Orc", traits = "green skin orc, tusks, tribal war paint" },
    SubRace { name = "Half-Orc", traits = "half-orc, mixed human and orc features" },
    SubRace { name = "Halfling", traits = "halfling, small cheerful face, curly hair, bright eyes" },
    SubRace { name = "Tiefling", traits = "tiefling, horns, reddish skin, glowing eyes, tail" }
  ]

  class-defs : List ClassDef
  class-defs = [
    ClassDef { name = "Warrior", gear = "heavy plate armor, longsword, shield, battle-scarred" },
    ClassDef { name = "Mage", gear = "flowing robes, arcane staff, glowing runes, spellbook" },
    ClassDef { name = "Rogue", gear = "dark leather armor, hooded cloak, twin daggers, shadows" },
    ClassDef { name = "Cleric", gear = "white and gold vestments, holy symbol, mace, radiant light" },
    ClassDef { name = "Ranger", gear = "forest green cloak, longbow, quiver, animal companion" },
    ClassDef { name = "Paladin", gear = "gleaming plate armor, holy greatsword, cape, divine aura" },
    ClassDef { name = "Warlock", gear = "dark tattered robes, eldritch focus, shadowy tendrils" },
    ClassDef { name = "Barbarian", gear = "fur and leather, greataxe, tribal markings, berserker rage" }
  ]

  gender-defs : List GenderDef
  gender-defs = [
    GenderDef { name = "Male", traits = "male, masculine features" },
    GenderDef { name = "Female", traits = "female, feminine features" },
    GenderDef { name = "Androgynous", traits = "androgynous, ambiguous gender, graceful" }
  ]

  personality-defs : List PersonalityDef
  personality-defs = [
    PersonalityDef { name = "Noble", expression = "proud dignified expression, confident gaze" },
    PersonalityDef { name = "Fierce", expression = "intense fierce expression, battle-ready" },
    PersonalityDef { name = "Wise", expression = "calm knowing expression, gentle eyes" },
    PersonalityDef { name = "Cunning", expression = "sly smirk, clever eyes, scheming" },
    PersonalityDef { name = "Jovial", expression = "warm smile, laughing eyes, approachable" },
    PersonalityDef { name = "Haunted", expression = "distant gaze, world-weary, melancholy" },
    PersonalityDef { name = "Stoic", expression = "stone-faced, emotionless, disciplined" }
  ]

  portrait-modes : List PortraitMode
  portrait-modes = [
    PortraitMode { name = "Card Portrait", framing = "head and shoulders portrait, card art style" },
    PortraitMode { name = "Full Body", framing = "full body standing pose, concept art" },
    PortraitMode { name = "Bust", framing = "chest-up portrait, detailed face, dramatic lighting" },
    PortraitMode { name = "Action Pose", framing = "dynamic action pose, mid-combat, motion blur" }
  ]

Section: Prompt

  build-char-prompt : SubRace, ClassDef, GenderDef, PersonalityDef, PortraitMode, Text -> Text
  build-char-prompt (race) (cls) (gender) (pers) (port) (extra) =
    race.traits & ", " & gender.traits & ", " & cls.gear & ", " & pers.expression & ", " & port.framing & ", fantasy RPG character art, professional concept art, detailed face, masterpiece, best quality, 4k, sharp focus" & (if text-length extra > 0 then ", " & extra else "")

  char-negative : Text
  char-negative = "blurry, low quality, deformed, extra limbs, extra fingers, ugly, text, watermark, nsfw"

Section: Name Extraction

  race-names : List Text
  race-names = xn-r all-races 0 []
  xn-r : List SubRace, Integer, List Text -> List Text
  xn-r (xs) (i) (acc) = if i >= list-length xs then acc else xn-r xs (i + 1) (list-push acc (list-at xs i).name)

  class-names : List Text
  class-names = xn-c class-defs 0 []
  xn-c : List ClassDef, Integer, List Text -> List Text
  xn-c (xs) (i) (acc) = if i >= list-length xs then acc else xn-c xs (i + 1) (list-push acc (list-at xs i).name)

  gender-names : List Text
  gender-names = xn-g gender-defs 0 []
  xn-g : List GenderDef, Integer, List Text -> List Text
  xn-g (xs) (i) (acc) = if i >= list-length xs then acc else xn-g xs (i + 1) (list-push acc (list-at xs i).name)

  pers-names : List Text
  pers-names = xn-p personality-defs 0 []
  xn-p : List PersonalityDef, Integer, List Text -> List Text
  xn-p (xs) (i) (acc) = if i >= list-length xs then acc else xn-p xs (i + 1) (list-push acc (list-at xs i).name)

  port-names : List Text
  port-names = xn-pm portrait-modes 0 []
  xn-pm : List PortraitMode, Integer, List Text -> List Text
  xn-pm (xs) (i) (acc) = if i >= list-length xs then acc else xn-pm xs (i + 1) (list-push acc (list-at xs i).name)

Section: Race Menu

  build-race-dd : Integer -> Text
  build-race-dd (sel) =
    let humans = build-race-range race-names sel "race" 0 3 ""
    in let elves = build-race-range race-names sel "race" 3 6 ""
    in let dwarves = build-race-range race-names sel "race" 6 8 ""
    in let others = build-race-range race-names sel "race" 8 11 ""
    in "<div class=\"dd-sec\"><span class=\"dd-cat\">Human</span><div class=\"dd-horiz\">" & humans & "</div></div>"
    & "<div class=\"dd-sec\"><span class=\"dd-cat\">Elf</span><div class=\"dd-horiz\">" & elves & "</div></div>"
    & "<div class=\"dd-sec\"><span class=\"dd-cat\">Dwarf</span><div class=\"dd-horiz\">" & dwarves & "</div></div>"
    & build-dropdown-items-from race-names sel "race" 8 ""

  build-race-range : List Text, Integer, Text, Integer, Integer, Text -> Text
  build-race-range (names) (sel) (group) (from) (to) (acc) =
    if from >= to then acc
    else if from >= list-length names then acc
    else let n = list-at names from
    in let c = if from == sel then "dd-item active" else "dd-item"
    in build-race-range names sel group (from + 1) to (acc & "<div class=\"" & c & "\" onclick=\"pick('" & group & "'," & show from & ")\">" & n & "</div>")

  build-dropdown-items-from : List Text, Integer, Text, Integer, Text -> Text
  build-dropdown-items-from (names) (sel) (group) (i) (acc) =
    if i >= list-length names then acc
    else let n = list-at names i
    in let c = if i == sel then "dd-item active" else "dd-item"
    in build-dropdown-items-from names sel group (i + 1) (acc & "<div class=\"" & c & "\" onclick=\"pick('" & group & "'," & show i & ")\">" & n & "</div>")

Section: Controls

  render-controls : Integer, Integer, Integer, Integer, Integer -> Text
  render-controls (sr) (sc) (sg) (sp) (spm) =
    "<div class=\"dimbar\">"
    & dim-pill "Race" (selected-name race-names sr) (build-race-dd sr)
    & dim-pill "Class" (selected-name class-names sc) (build-dropdown-items class-names sc "class" 0 "")
    & dim-pill "Gender" (selected-name gender-names sg) (build-dropdown-items gender-names sg "gender" 0 "")
    & dim-pill "Personality" (selected-name pers-names sp) (build-dropdown-items pers-names sp "pers" 0 "")
    & dim-pill "Portrait" (selected-name port-names spm) (build-dropdown-items port-names spm "port" 0 "")
    & "</div>"
    & "<div class=\"prow\"><textarea id=\"prompt\" placeholder=\"Backstory, appearance, distinguishing features...\"></textarea><div class=\"pc\"><label>Seed</label><input id=\"seed\" type=\"number\" value=\"424242\"></div></div>"
    & "<div class=\"tb\"><button class=\"btn primary\" onclick=\"do_generate(0)\">Generate</button><button class=\"btn\" onclick=\"random_seed(0)\">Random Seed</button></div>"

Section: Page

  build-page : Integer, Integer, Integer, Integer, Integer -> Text
  build-page (sr) (sc) (sg) (sp) (spm) =
    explorer-nav "character"
    & "<div class=\"page\"><div class=\"left\"><div class=\"hd\"><h1>Character Designer</h1><div id=\"controls\" class=\"ctrl\">" & render-controls sr sc sg sp spm & "</div></div>"
    & "<div class=\"hero\" id=\"hero\"><img id=\"hero-img\" style=\"display:none\" onclick=\"document.getElementById('lb').classList.add('on');document.getElementById('lb-img').src=this.src\"><div class=\"he\" id=\"hero-empty\">Generate a character to see it here</div><div id=\"hero-meta\" class=\"hm\"></div></div></div>"
    & "<div class=\"hist\"><h3>History</h3><div id=\"history\"></div></div></div>"
    & "<div class=\"lb\" id=\"lb\" onclick=\"close_lb(0)\"><span class=\"x\">&times;</span><img id=\"lb-img\"></div>"

Section: Callbacks

  pick : Text, Integer -> Integer
  pick (group) (idx) =
    let s1 = if group == "race" then state-set "sr" idx else state-get "sr"
    in let s2 = if group == "class" then state-set "sc" idx else state-get "sc"
    in let s3 = if group == "gender" then state-set "sg" idx else state-get "sg"
    in let s4 = if group == "pers" then state-set "sp" idx else state-get "sp"
    in let s5 = if group == "port" then state-set "spm" idx else state-get "spm"
    in let ctrl = dom-get "controls"
    in let c2 = dom-set-html ctrl (render-controls s1 s2 s3 s4 s5)
    in 0

  meta-html : Text, Text, Text, Text, Integer -> Text
  meta-html (rname) (cname) (gname) (pname) (seed) =
    "<div class=\"rm\"><span class=\"mt\">" & rname & "</span><span class=\"mt\">" & cname & "</span><span class=\"mt\">" & gname & "</span><span class=\"mt\">" & pname & "</span><span class=\"mt md\">seed:" & show seed & "</span></div>"

  add-run : Text, Text, Text, Text, Integer -> Text
  add-run (rname) (cname) (gname) (pname) (seed) =
    let cid = next-card-id 0
    in let hist = dom-get "history"
    in let card = dom-create "div"
    in let c2 = dom-add-class card "rc"
    in let c3 = dom-set-attr card "id" cid
    in let ch = "<div class=\"ri\"><div class=\"sp\"></div><img src=\"\" onclick=\"if(this.src&&this.src.indexOf('data:')<0){document.getElementById('hero-img').src=this.src;document.getElementById('hero-img').style.display='';document.getElementById('hero-empty').style.display='none'}\"></div>" & meta-html rname cname gname pname seed
    in let c4 = dom-set-html card ch
    in let c5 = dom-prepend hist card
    in cid

  do-generate : Integer -> Integer
  do-generate (x) =
    let sr = state-get "sr"
    in let sc = state-get "sc"
    in let sg = state-get "sg"
    in let sp = state-get "sp"
    in let spm = state-get "spm"
    in let race = list-at all-races sr
    in let cls = list-at class-defs sc
    in let gender = list-at gender-defs sg
    in let pers = list-at personality-defs sp
    in let port = list-at portrait-modes spm
    in let extra = dom-get-value (dom-get "prompt")
    in let seed = 424242
    in let prompt = build-char-prompt race cls gender pers port extra
    in let body = "{\"prompt\":\"" & prompt & "\",\"negative_prompt\":\"" & char-negative & "\",\"model_title\":\"\",\"model_short\":\"default\",\"sampler\":\"DPM++ SDE\",\"steps\":12,\"cfg\":2,\"lora\":\"\",\"lora_short\":\"none\",\"seed\":" & show seed & ",\"width\":768,\"height\":1024}"
    in let hm = dom-get "hero-meta"
    in let h2 = dom-set-html hm ("<b>" & race.name & " " & cls.name & "</b> - " & gender.name & ", " & pers.name)
    in let cid = add-run (race.name) (cls.name) (gender.name) (pers.name) seed
    in generate-image "/api/generate" body cid

  random-seed : Integer -> Integer
  random-seed (x) = random-seed-cb x

  close-lb : Integer -> Integer
  close-lb (x) = close-lb-cb x

Section: Layout CSS

  layout-css : Text
  layout-css =
    "body{height:100vh;overflow:hidden}"
    & ".nv{display:flex;gap:2px;padding:6px 24px;border-bottom:1px solid var(--border);background:var(--bg);position:sticky;top:0;z-index:100;flex-shrink:0}"
    & ".nv a{color:var(--muted);text-decoration:none;padding:8px 16px;border-radius:6px;font-size:.85em;font-weight:500}.nv a:hover{color:var(--fg);background:var(--secondary)}.nv a.active{color:var(--primary);background:var(--secondary)}"
    & ".sd{color:var(--muted);font-size:.75em;padding:8px 12px;display:flex;align-items:center;gap:6px}.dot{width:6px;height:6px;border-radius:50%;background:var(--muted);display:inline-block}"
    & ".page{display:grid;grid-template-columns:1fr 340px;height:calc(100vh - 41px);overflow:hidden}"
    & ".left{overflow-y:auto}"
    & ".hd{padding:20px 24px;border-bottom:1px solid var(--border)}.hd h1{color:var(--primary);font-size:1.3em;margin-bottom:16px;font-weight:600}"
    & ".ctrl{display:flex;flex-direction:column;gap:10px}"
    & ".dimbar{display:flex;gap:4px;flex-wrap:wrap}"
    & ".dim{position:relative}.dim-pill{padding:6px 16px;border-radius:16px;border:1px solid var(--primary);color:var(--primary);background:var(--secondary);font-size:.8em;cursor:pointer;user-select:none;white-space:nowrap}"
    & ".dim:hover .dim-pill{background:var(--primary);color:var(--bg)}"
    & ".dd{display:none;position:absolute;top:100%;left:0;margin-top:4px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:6px 0;min-width:160px;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.6);max-height:400px;overflow-y:auto}"
    & ".dim:hover .dd{display:block}"
    & ".dd-item{padding:6px 16px;font-size:.8em;cursor:pointer;white-space:nowrap;transition:background .1s}.dd-item:hover{background:var(--secondary)}.dd-item.active{color:var(--primary);background:var(--secondary)}"
    & ".dd-sec{padding:4px 0;border-bottom:1px solid var(--border)}.dd-cat{display:block;padding:2px 16px;font-size:.65em;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}"
    & ".dd-horiz{display:flex;flex-wrap:wrap;gap:2px;padding:2px 8px}"
    & ".dd-horiz .dd-item{padding:4px 10px;border-radius:12px;border:1px solid var(--border);font-size:.75em}.dd-horiz .dd-item:hover{border-color:var(--muted)}.dd-horiz .dd-item.active{border-color:var(--primary);color:var(--primary)}"
    & ".prow{display:flex;gap:10px;align-items:flex-start;margin-top:10px}.prow textarea{flex:1;background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:12px;border-radius:6px;font-size:.9em;min-height:48px;font-family:inherit;resize:vertical}.prow textarea:focus{border-color:var(--primary);outline:none}"
    & ".pc{display:flex;flex-direction:column;gap:4px}.pc label{font-size:.7em;color:var(--muted);text-transform:uppercase}.pc input{background:var(--secondary);border:1px solid var(--border);color:var(--fg);padding:8px;border-radius:6px;width:100px;font-size:.9em}"
    & ".tb{display:flex;gap:8px;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}"
    & ".btn{background:var(--secondary);border:1px solid var(--primary);color:var(--primary);padding:8px 20px;border-radius:6px;font-size:.85em;cursor:pointer;font-weight:500}.btn:hover{background:var(--secondary)}.btn.primary{background:var(--primary);color:var(--bg)}"
    & ".hero{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;background:var(--bg);min-height:300px}"
    & ".hero img{max-width:100%;max-height:50vh;object-fit:contain;border-radius:8px;cursor:pointer;background:var(--secondary)}"
    & ".he{color:var(--muted);font-size:.9em}.hm{margin-top:12px;font-size:.85em;text-align:center}"
    & ".hist{border-left:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}"
    & ".hist h3{padding:12px 16px;color:var(--primary);font-size:.85em;font-weight:600;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg);z-index:1;flex-shrink:0}"
    & "#history{flex:1;overflow-y:auto}"
    & ".rc{display:flex;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border)}.rc:hover{background:var(--secondary)}"
    & ".ri{flex:0 0 64px;height:64px;border-radius:6px;overflow:hidden;background:var(--secondary);position:relative}.ri img{width:100%;height:100%;object-fit:cover;cursor:pointer}"
    & ".rm{display:flex;flex-wrap:wrap;gap:4px;align-items:center;flex:1}.mt{padding:2px 8px;border-radius:8px;font-size:.72em;background:var(--secondary);border:1px solid var(--border);color:var(--fg)}.md{color:var(--muted);border-color:transparent;background:transparent}"
    & ".sp{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}"
    & ".lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:1000;justify-content:center;align-items:center}.lb.on{display:flex}.lb img{max-width:92%;max-height:90%;object-fit:contain;border-radius:8px}.lb .x{position:absolute;top:16px;right:24px;color:#fff;font-size:2em;cursor:pointer;opacity:.6}"
    & "@media(max-width:800px){.page{grid-template-columns:1fr;height:auto}.hist{border-left:none;border-top:1px solid var(--border);max-height:300px}}"

Section: Entry

  init-state : Integer -> Integer
  init-state (x) =
    let s1 = state-set "sr" 3
    in let s2 = state-set "sc" 0
    in let s3 = state-set "sg" 0
    in let s4 = state-set "sp" 0
    in let s5 = state-set "spm" 0
    in 0

  opening : Integer -> [Console] Nothing
  opening (x) = act
    let st = init-state 0
    in let ex = init-explorer 0
    in let app = dom-get "app"
    in let a2 = dom-set-html app (build-page 3 0 0 0 0)
    in print-line-uni ""
  end

