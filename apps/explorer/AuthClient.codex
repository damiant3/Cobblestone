Chapter: AuthClient
  cites Explorer chapter ExplorerTheme

 Reusable authentication client for Codex web apps compiled by the html plug.
 Provides login, register, and logout UI backed by the Accounts std-include
 endpoints. Any app that needs auth: cite this chapter, include auth-css in
 the page, render auth-card-html and auth-who-html, then call auth-wire
 with your on-change callback.

 State keys: al (logged-in flag 0/1), ah (handle text).
 Token persists in localStorage under cx_tok.

 We say:

Section: CSS

  auth-css : Text
  auth-css =
    ".auth{background:#16161b;border:1px solid #26262e;border-radius:10px;padding:18px;margin-bottom:18px}"
    & ".auth h2{font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:#9a8c66;margin-bottom:12px}"
    & ".auth label{display:block;font-size:12px;color:#8a8780;margin:8px 0 3px}"
    & ".auth input{width:100%;padding:8px 10px;background:#0d0d10;border:1px solid #33333d;border-radius:6px;color:#e8e6df;font:inherit}"
    & ".arow{display:flex;gap:12px}.arow>*{flex:1}"
    & ".abtn{padding:8px 16px;background:#e9c46a;color:#1a1a1a;border:0;border-radius:6px;font:inherit;font-weight:600;cursor:pointer;margin-top:10px}"
    & ".abtn.ghost{background:transparent;color:#9a8c66;border:1px solid #33333d}"
    & ".awho{float:right;font-size:13px;color:#8a8780}"
    & ".awho a{color:#9a8c66;text-decoration:none;cursor:pointer}"
    & ".amsg{font-size:13px;color:#c4756b;min-height:18px;margin-top:6px}"
    & ".amsg.ok{color:#7aa874}"

Section: HTML Builders

  auth-card-html : Text
  auth-card-html =
    "<div id=\"authCard\" class=\"auth\">"
    & "<h2>Sign in</h2>"
    & "<div class=\"arow\">"
    & "<div><label>Handle</label><input id=\"au\"></div>"
    & "<div><label>Password</label><input id=\"ap\" type=\"password\"></div>"
    & "</div>"
    & "<div class=\"arow\">"
    & "<button id=\"aLogin\" class=\"abtn\">Log in</button>"
    & "<button id=\"aReg\" class=\"abtn ghost\">Register</button>"
    & "</div>"
    & "<div id=\"authMsg\" class=\"amsg\"></div>"
    & "</div>"

  auth-who-html : Text
  auth-who-html = "<span id=\"awho\" class=\"awho\"></span>"

Section: Token Helpers

  get-auth-token : Integer -> Text
  get-auth-token (x) = local-storage-get "cx_tok"

  set-auth-token : Text -> Integer
  set-auth-token (t) = local-storage-set "cx_tok" t

  clear-auth-token : Integer -> Integer
  clear-auth-token (x) = local-storage-set "cx_tok" ""

  get-auth-handle : Integer -> Text
  get-auth-handle (x) = state-get-text "ah"

  is-auth-logged-in : Integer -> Integer
  is-auth-logged-in (x) = state-get "al"

Section: UI Updates

  auth-show-logged-in : Text -> Integer
  auth-show-logged-in (handle) =
    let w = dom-get "awho"
    in let w2 = dom-set-html w (handle & " &middot; <a id=\"aOut\">log out</a>")
    in let ac = dom-get "authCard"
    in let a2 = dom-set-style ac "display" "none"
    in let s1 = state-set-text "ah" handle
    in let s2 = state-set "al" 1
    in 0

  auth-show-logged-out : Integer -> Integer
  auth-show-logged-out (x) =
    let w = dom-get "awho"
    in let w2 = dom-set-text w ""
    in let ac = dom-get "authCard"
    in let a2 = dom-set-style ac "display" ""
    in let s1 = state-set-text "ah" ""
    in let s2 = state-set "al" 0
    in let s3 = clear-auth-token 0
    in 0

  auth-set-msg : Text, Integer -> Integer
  auth-set-msg (msg) (ok) =
    let el = dom-get "authMsg"
    in let c = if ok == 1 then "amsg ok" else "amsg"
    in let e2 = dom-set-attr el "class" c
    in let e3 = dom-set-text el msg
    in 0

  auth-clear-msg : Integer -> Integer
  auth-clear-msg (x) = auth-set-msg "" 0

