  extract-port-names : List PortraitMode, Integer, List Text -> List Text
  extract-port-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-port-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-biome-names : List BiomeDef, Integer, List Text -> List Text
  extract-biome-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-biome-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-time-names : List TimeDef, Integer, List Text -> List Text
  extract-time-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-time-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-weather-names : List WeatherDef, Integer, List Text -> List Text
  extract-weather-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-weather-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-mood-names : List MoodDef, Integer, List Text -> List Text
  extract-mood-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-mood-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-scale-names : List ScaleDef, Integer, List Text -> List Text
  extract-scale-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-scale-names xs (i + 1) (list-push acc (list-at xs i).name)

Section: Shared Prompt Helpers

  default-item-negative : Text
  default-item-negative = "blurry, low quality, deformed, hands, fingers, person, character, multiple items, white background, text, watermark, nsfw"

  default-char-negative : Text
  default-char-negative = "blurry, low quality, deformed, extra limbs, extra fingers, ugly, text, watermark, nsfw"

  default-setting-negative : Text
  default-setting-negative = "blurry, low quality, deformed, text, watermark, person, character, nsfw, UI elements"

  get-mod-prompt : List ModOption, Integer -> Text
  get-mod-prompt (opts) (idx) = if idx < list-length opts then (list-at opts idx).prompt else ""

