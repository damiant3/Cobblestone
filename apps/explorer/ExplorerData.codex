Section: Name Extraction Helpers

  extract-np-names : List ItemCategory, Integer, List Text -> List Text
  extract-np-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-np-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-ct-names : List RarityTier, Integer, List Text -> List Text
  extract-ct-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-ct-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-mod-names : List ModOption, Integer, List Text -> List Text
  extract-mod-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-mod-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-sub-names : List SubRace, Integer, List Text -> List Text
  extract-sub-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-sub-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-class-names : List ClassDef, Integer, List Text -> List Text
  extract-class-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-class-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-gender-names : List GenderDef, Integer, List Text -> List Text
  extract-gender-names (xs) (i) (acc) = if i >= list-length xs then acc else extract-gender-names xs (i + 1) (list-push acc (list-at xs i).name)

  extract-pers-names : List PersonalityDef, Integer, List Text -> List Text
