Chapter: ExplorerDropdownInteraction
  cites UI chapter Dropdown

 Event delegation for explorer dropdown items. Replaces inline
 onclick="pick(...)" handlers with data-action="pick" dispatch.
 Reads the group and index from data-value, then calls the
 existing pick callback registered via register-handlers.

 Migration note: new designer pages should use the widget-based
 Dropdown from codex.foreword.ui instead of this DOM-event system.
 The Dropdown widget handles filtering, keyboard navigation, and
 open/close state internally.

 We say:

Section: Event Handler

  on-dropdown-click : Integer -> Integer
  on-dropdown-click (evt) =
    let tgt = dom-event-target evt
    in let el = dom-closest tgt "[data-action]"
    in if dom-not-null el then
      let action = dom-dataset-get el "action"
      in if action == "pick" then
        let val = dom-dataset-get el "value"
        in dispatch-pick val
      else 0
    else 0

Section: Pick Dispatch

  dispatch-pick : Text -> Integer
  dispatch-pick (val) =
    let comma = text-index-of val ","
    in if comma < 0 then 0
    else let group = text-take val comma
    in let idx-str = text-drop val (comma + 1)
    in let idx = text-to-int idx-str
    in js-call-pick group idx

  js-call-pick : Text, Integer -> Integer
  js-call-pick (group) (idx) = 0

Section: Setup

  setup-dropdown-events : Integer -> Integer
  setup-dropdown-events (x) =
    let doc = dom-document 0
    in let d2 = dom-on-click doc (on-dropdown-click)
    in 0

