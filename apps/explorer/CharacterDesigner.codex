Section: Portrait Mode

  PortraitMode = record { name : Text, framing : Text, w : Integer, h : Integer }

  portrait-modes : List PortraitMode
  portrait-modes = [
    PortraitMode { name = "Card Portrait", framing = "head and shoulders portrait in ornate frame, card art style", w = 768, h = 1024 },
    PortraitMode { name = "Full Body", framing = "full body standing pose, feet visible, character concept art", w = 680, h = 1024 },
    PortraitMode { name = "Bust", framing = "chest-up portrait, detailed face, dramatic lighting", w = 768, h = 768 },
    PortraitMode { name = "Action Pose", framing = "dynamic action pose, mid-combat, motion blur background", w = 768, h = 1024 }
  ]

Section: Prompt Builder

  build-character-prompt : SubRace, Gender, ClassDef, PersonalityDef, HairStyle, HairStyle, Characteristic, AttireDef, EnvironmentDef, PortraitMode, Text -> Text
  build-character-prompt (race) (gender) (cls) (pers) (hcolor) (hstyle) (face) (attire) (env) (port) (extra) =
    race.traits
    & ", " & gender.traits
    & ", " & cls.gear
    & ", " & pers.expression
    & ", " & hcolor.traits
    & ", " & hstyle.traits
    & (if text-length (face.traits) > 0 then ", " & face.traits else "")
    & ", " & attire.traits
    & ", " & env.background
    & ", " & port.framing
    & ", fantasy RPG character art, professional concept art"
    & ", detailed face, masterpiece, best quality, 4k, sharp focus"
    & (if text-length extra > 0 then ", " & extra else "")

Section: Entry Point

  opening : [Console] Nothing = act
    print-line "Character Designer data loaded"
    print-line ("Sub-races: " & show (list-length all-subraces))
    print-line ("Classes: " & show (list-length class-defs))
    print-line ("Hair colors: " & show (list-length hair-colors))
    print-line ("Environments: " & show (list-length environment-defs))
    let test-prompt = build-character-prompt
      (list-at elf-subraces 0)
      (list-at genders 1)
      (list-at class-defs 4)
      (list-at personality-defs 2)
      (list-at hair-colors 4)
      (list-at hair-styles 0)
      (list-at facial-features 0)
      (list-at attire-defs 3)
      (list-at environment-defs 2)
      (list-at portrait-modes 0)
      ""
    in print-line ("Test prompt: " & test-prompt)
  end

