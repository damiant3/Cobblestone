Chapter: CharacterDesigner

 Character designer data model and prompt builder. Compiled through
 the JavaScript plug to produce browser-side logic. The HTML shell
 loads this as a script module.

 We say:

Section: Sub-Races

  SubRace = record { name : Text, parent : Text, traits : Text }

  human-subraces : List SubRace
  human-subraces = [
    SubRace { name = "European", parent = "Human", traits = "fair skin, European features" },
    SubRace { name = "African", parent = "Human", traits = "dark skin, African features, strong jawline" },
    SubRace { name = "East Asian", parent = "Human", traits = "East Asian features, almond eyes" },
    SubRace { name = "Polynesian", parent = "Human", traits = "Polynesian features, broad build, tattooed" },
    SubRace { name = "Middle Eastern", parent = "Human", traits = "olive skin, Middle Eastern features, aquiline nose" },
    SubRace { name = "South Asian", parent = "Human", traits = "South Asian features, warm brown skin" },
    SubRace { name = "Indigenous", parent = "Human", traits = "Indigenous features, high cheekbones, long dark hair" }
  ]

  elf-subraces : List SubRace
  elf-subraces = [
    SubRace { name = "High Elf", parent = "Elf", traits = "high elf, pale luminous skin, silver or gold hair, regal bearing" },
    SubRace { name = "Wood Elf", parent = "Elf", traits = "wood elf, tanned skin, green or brown hair, wild and feral" },
    SubRace { name = "Dark Elf", parent = "Elf", traits = "dark elf, obsidian black skin, white hair, red or violet eyes" },
    SubRace { name = "Sea Elf", parent = "Elf", traits = "sea elf, blue-tinted skin, aquatic features, pearl-like eyes" },
    SubRace { name = "Tree Elf", parent = "Elf", traits = "tree elf, bark-like skin patches, moss in hair, living wood ornaments" }
  ]

  dwarf-subraces : List SubRace
  dwarf-subraces = [
    SubRace { name = "Mountain Dwarf", parent = "Dwarf", traits = "mountain dwarf, grey stone-dust in beard, heavy plate, fortress-born" },
    SubRace { name = "Hill Dwarf", parent = "Dwarf", traits = "hill dwarf, ruddy cheeks, rounded build, warm and cheerful" },
    SubRace { name = "Duergar", parent = "Dwarf", traits = "duergar, ashen grey skin, bald, sunken eyes, deep underground" }
  ]

  orc-subraces : List SubRace
  orc-subraces = [
    SubRace { name = "Green Orc", parent = "Orc", traits = "green skin orc, tusks, tribal war paint" },
    SubRace { name = "Grey Orc", parent = "Orc", traits = "grey skin orc, leaner build, cunning expression" },
    SubRace { name = "Half-Orc", parent = "Orc", traits = "half-orc, mixed human and orc features, prominent but smaller tusks" }
  ]

  all-subraces : List SubRace
  all-subraces = human-subraces & elf-subraces & dwarf-subraces & orc-subraces
    & [SubRace { name = "Halfling", parent = "Halfling", traits = "halfling, small cheerful face, curly hair, bright eyes" },
       SubRace { name = "Tiefling", parent = "Tiefling", traits = "tiefling, horns, reddish skin, glowing eyes, tail" }]

