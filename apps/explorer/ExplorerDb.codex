Chapter: ExplorerDb
  cites Data chapter Schema
  cites Data chapter Row
  cites Data chapter Catalog

 We say:

Section: Table Definitions

  items-cols : List ColumnDef
  items-cols = [col-def-not-null "name" ColText, col-def-not-null "prompt" ColText, col-def "parent-id" ColInteger, col-def-not-null "sort-order" ColInteger]
  explorer-items-table : TableDef
  explorer-items-table = table-def-with-pk "explorer_items" items-cols ["name"]

  materials-cols : List ColumnDef
  materials-cols = [col-def-not-null "name" ColText, col-def-not-null "prompt" ColText, col-def-not-null "sort-order" ColInteger]
  explorer-materials-table : TableDef
  explorer-materials-table = table-def-with-pk "explorer_materials" materials-cols ["name"]

  rarities-cols : List ColumnDef
  rarities-cols = [col-def-not-null "name" ColText, col-def-not-null "color" ColText, col-def-not-null "prompt" ColText, col-def-not-null "sort-order" ColInteger]
  explorer-rarities-table : TableDef
  explorer-rarities-table = table-def-with-pk "explorer_rarities" rarities-cols ["name"]

  prefs-cols : List ColumnDef
  prefs-cols = [col-def-not-null "user-agent" ColText, col-def-not-null "pref-key" ColText, col-def-not-null "pref-value" ColText, col-def "updated-at" ColInteger]
  explorer-prefs-table : TableDef
  explorer-prefs-table = table-def "explorer_prefs" prefs-cols

  history-cols : List ColumnDef
  history-cols = [col-def-not-null "page" ColText, col-def-not-null "prompt" ColText, col-def "negative" ColText, col-def-not-null "params-json" ColText, col-def-not-null "seed" ColInteger, col-def "image-url" ColText, col-def-not-null "created-at" ColInteger]
  explorer-history-table : TableDef
  explorer-history-table = table-def "explorer_history" history-cols

  sd-config-cols : List ColumnDef
  sd-config-cols = [col-def-not-null "key" ColText, col-def-not-null "value" ColText]
  explorer-sd-config-table : TableDef
  explorer-sd-config-table = table-def-with-pk "explorer_sd_config" sd-config-cols ["key"]

  theme-cols : List ColumnDef
  theme-cols = [col-def-not-null "name" ColText, col-def-not-null "palette-json" ColText, col-def-not-null "styles-json" ColText]
  explorer-theme-table : TableDef
  explorer-theme-table = table-def-with-pk "explorer_themes" theme-cols ["name"]

Section: Bootstrap

  crt : Catalog, TableDef -> Catalog
  crt (cat) (tdef) = (catalog-create-table cat tdef).cat

  explorer-bootstrap : Catalog -> Catalog
  explorer-bootstrap (cat) =
    let c1 = crt cat explorer-items-table
    in let c2 = crt c1 explorer-materials-table
    in let c3 = crt c2 explorer-rarities-table
    in let c4 = crt c3 explorer-prefs-table
    in let c5 = crt c4 explorer-history-table
    in let c6 = crt c5 explorer-sd-config-table
    in crt c6 explorer-theme-table

Section: Seed Row Builders

  item-row : Text, Text, Integer -> List ColumnValue
  item-row (name) (prompt) (sort) = [ValText name, ValText prompt, ValNull, ValInteger sort]

  material-row : Text, Text, Integer -> List ColumnValue
  material-row (name) (prompt) (sort) = [ValText name, ValText prompt, ValInteger sort]

  rarity-row : Text, Text, Text, Integer -> List ColumnValue
  rarity-row (name) (color) (prompt) (sort) = [ValText name, ValText color, ValText prompt, ValInteger sort]

  pref-row : Text, Text, Text -> List ColumnValue
  pref-row (agent) (key) (value) = [ValText agent, ValText key, ValText value, ValInteger 0]

Section: Default Preferences

  default-prefs : List (List ColumnValue)
  default-prefs = [
    pref-row "*" "theme" "dark-gold",
    pref-row "*" "sidebar-width" "340",
    pref-row "*" "history-position" "right",
    pref-row "*" "sd-sampler" "DPM++ SDE",
    pref-row "*" "sd-steps" "12",
    pref-row "*" "sd-cfg" "2"
  ]

