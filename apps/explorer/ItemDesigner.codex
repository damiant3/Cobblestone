Section: Page HTML

  item-page-html : Text
  item-page-html =
    "<nav class=\"nav\">"
    & "<a href=\"/card\">Cards</a>"
    & "<a href=\"/item\" class=\"active\">Items</a>"
    & "<a href=\"/character\">Characters</a>"
    & "<a href=\"/setting\">Settings</a>"
    & "<a href=\"/voice\">Voice</a>"
    & "</nav>"
    & "<div class=\"header\">"
    & "<h1>Item Designer</h1>"
    & "<div class=\"controls\">"
    & "<div class=\"control-group\">"
    & "<label>Item Type</label>"
    & "<div class=\"pill-row\" id=\"item-type\"></div>"
    & "</div>"
    & "<div class=\"control-group\">"
    & "<label>Rarity</label>"
    & "<div class=\"pill-row\" id=\"rarity\"></div>"
    & "</div>"
    & "<div class=\"control-group\">"
    & "<label>Material</label>"
    & "<div class=\"pill-row\" id=\"material\"></div>"
    & "</div>"
    & "<div class=\"prompt-row\">"
    & "<textarea id=\"prompt\" placeholder=\"Additional prompt details...\"></textarea>"
    & "<div class=\"prompt-col\"><label>Seed</label><input id=\"seed\" type=\"number\" value=\"424242\"></div>"
    & "</div>"
    & "</div>"
    & "</div>"
    & "<div id=\"results\" class=\"results-grid\"></div>"
    & "<div class=\"lb\" id=\"lb\" onclick=\"closeLb()\"><span class=\"x\">&times;</span><img id=\"lb-img\"></div>"
    & "<div class=\"toast\" id=\"toast\"></div>"

Section: Item-Specific CSS

  item-css : Text
  item-css =
    ".controls{display:flex;flex-direction:column;gap:12px;margin-top:12px}"
    & ".control-group{display:flex;align-items:center;gap:10px}"
    & ".control-group label{font-size:.8em;color:var(--gold);min-width:80px;text-transform:uppercase;letter-spacing:.5px}"
    & ".pill-row{display:flex;gap:6px;flex-wrap:wrap}"
    & ".pill{padding:5px 14px;border-radius:16px;border:1px solid var(--border);background:#1a1a1a;color:var(--text);font-size:.8em;cursor:pointer;transition:all .15s}"
    & ".pill:hover{border-color:#555}"
    & ".pill.active{border-color:var(--gold);color:var(--gold);background:#2a2a1a}"
    & ".results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;padding:16px 24px}"
    & ".result-card{background:var(--card);border:2px solid var(--border);border-radius:8px;overflow:hidden;cursor:pointer;transition:all .15s;position:relative}"
    & ".result-card:hover{border-color:#555;transform:translateY(-2px)}"
    & ".result-card img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#1a1a1a}"
    & ".result-card .info{padding:8px 10px;font-size:.8em}"
    & ".result-card .info .rarity-badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:.75em;font-weight:bold}"

Section: Item JavaScript

  item-js : Text
  item-js =
    "const ITEMS = " & item-categories-json & ";\n"
    & "const RARITIES = " & rarity-tiers-json & ";\n"
    & "const MATERIALS = " & material-types-json & ";\n"
    & "let sel = { item: 0, rarity: 2, material: 0 };\n"
    & "function renderPills(id, items, key, labelFn, colorFn) {\n"
    & "  const el = document.getElementById(id);\n"
    & "  el.innerHTML = items.map((it, i) => {\n"
    & "    const active = i === sel[key] ? ' active' : '';\n"
    & "    const style = colorFn ? ' style=\"border-color:' + colorFn(it) + (i === sel[key] ? ';color:' + colorFn(it) : '') + '\"' : '';\n"
    & "    return '<span class=\"pill' + active + '\"' + style + ' onclick=\"pick(\\'' + key + '\\',' + i + ')\">' + labelFn(it) + '</span>';\n"
    & "  }).join('');\n"
    & "}\n"
    & "function pick(key, idx) { sel[key] = idx; renderControls(); generate(); }\n"
    & "function renderControls() {\n"
    & "  renderPills('item-type', ITEMS, 'item', it => it.name, null);\n"
    & "  renderPills('rarity', RARITIES, 'rarity', r => r.name, r => r.color);\n"
    & "  renderPills('material', MATERIALS, 'material', m => m.name, null);\n"
    & "}\n"
    & "function buildPrompt() {\n"
    & "  const item = ITEMS[sel.item];\n"
    & "  const rarity = RARITIES[sel.rarity];\n"
    & "  const mat = MATERIALS[sel.material];\n"
    & "  const extra = document.getElementById('prompt').value;\n"
    & "  return item.prompt + ', ' + mat.prompt + ', ' + rarity.glow + ', '\n"
    & "    + 'single item centered on pure black background, game inventory icon, '\n"
    & "    + 'fantasy RPG item art, no hands, no character, isolated object, '\n"
    & "    + 'professional game asset, 4k, sharp focus'\n"
    & "    + (extra ? ', ' + extra : '');\n"
    & "}\n"
    & "async function generate() {\n"
    & "  const grid = document.getElementById('results');\n"
    & "  const seed = parseInt(document.getElementById('seed').value) || 424242;\n"
    & "  const prompt = buildPrompt();\n"
    & "  const neg = 'blurry, low quality, deformed, hands, fingers, person, character, multiple items, white background, text, watermark, nsfw';\n"
    & "  const params = { prompt, negative_prompt: neg, model_title: '', model_short: 'default',\n"
    & "    sampler: 'DPM++ SDE', steps: 12, cfg: 2, lora: '', lora_short: 'none',\n"
    & "    seed, width: 768, height: 768 };\n"
    & "  const card = document.createElement('div');\n"
    & "  card.className = 'result-card';\n"
    & "  const r = RARITIES[sel.rarity];\n"
    & "  card.innerHTML = '<div class=\"spinner\" style=\"position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:30px;height:30px;border:3px solid #333;border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite\"></div>'\n"
    & "    + '<img src=\"\" style=\"aspect-ratio:1/1\">'\n"
    & "    + '<div class=\"info\"><b>' + ITEMS[sel.item].name + '</b> — ' + MATERIALS[sel.material].name\n"
    & "    + ' <span class=\"rarity-badge\" style=\"background:' + r.color + '22;color:' + r.color + '\">' + r.name + '</span></div>';\n"
    & "  grid.prepend(card);\n"
    & "  card.addEventListener('click', () => { const img = card.querySelector('img'); if (img.src) openLb(img.src); });\n"
    & "  try {\n"
    & "    const resp = await fetch('/api/generate', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(params) });\n"
    & "    const data = await resp.json();\n"
    & "    if (data.url) { card.querySelector('img').src = data.url; }\n"
    & "    card.querySelector('.spinner').style.display = 'none';\n"
    & "  } catch(e) { card.querySelector('.spinner').style.display = 'none'; }\n"
    & "}\n"
    & "function openLb(src) { document.getElementById('lb-img').src = src; document.getElementById('lb').classList.add('on'); }\n"
    & "function closeLb() { document.getElementById('lb').classList.remove('on'); }\n"
    & "document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLb(); });\n"
    & "renderControls();\n"

Section: JSON Serializers

  item-categories-json : Text
  item-categories-json = "[" & item-cat-json-loop item-categories 0 (list-length item-categories) "" & "]"

  item-cat-json-loop : List ItemCategory, Integer, Integer, Text -> Text
  item-cat-json-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let c = list-at xs i
    in item-cat-json-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & c.name & "\",\"prompt\":\"" & c.prompt-fragment & "\"}")

  rarity-tiers-json : Text
  rarity-tiers-json = "[" & rarity-json-loop rarity-tiers 0 (list-length rarity-tiers) "" & "]"

  rarity-json-loop : List RarityTier, Integer, Integer, Text -> Text
  rarity-json-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let r = list-at xs i
    in rarity-json-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & r.name & "\",\"color\":\"" & r.color & "\",\"glow\":\"" & r.glow & "\"}")

  material-types-json : Text
  material-types-json = "[" & material-json-loop material-types 0 (list-length material-types) "" & "]"

  material-json-loop : List MaterialType, Integer, Integer, Text -> Text
  material-json-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let m = list-at xs i
    in material-json-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & m.name & "\",\"prompt\":\"" & m.prompt-fragment & "\"}")

Section: Entry Point

  opening : [Console] Nothing = act
    print-line-uni "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    print-line-uni "<title>CodexMagic — Item Designer</title>"
    print-line-uni "<style>"
    print-line-uni explorer-css
    print-line-uni item-css
    print-line-uni "</style></head><body>"
    print-line-uni item-page-html
    print-line-uni "<script>"
    print-line-uni item-js
    print-line-uni "</script>"
    print-line-uni "</body></html>"
  end

Section: Shared CSS Import

  explorer-css : Text
  explorer-css =
    ":root{--gold:#ffd700;--bg:#0a0a0a;--card:#141414;--border:#2a2a2a;--text:#ccc;--dim:#666}"
    & "*{margin:0;padding:0;box-sizing:border-box}"
    & "body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif}"
    & ".header{padding:16px 24px;border-bottom:1px solid var(--border)}"
    & ".header h1{color:var(--gold);font-size:1.4em;margin-bottom:12px}"
    & ".prompt-row{display:flex;gap:10px;align-items:flex-start;margin-top:12px}"
    & ".prompt-row textarea{flex:1;background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:10px;border-radius:6px;font-size:.9em;min-height:40px;font-family:inherit}"
    & ".prompt-col{display:flex;flex-direction:column;gap:6px}"
    & ".prompt-col label{font-size:.75em;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}"
    & ".prompt-col input{background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:8px;border-radius:6px;width:100px;font-size:.9em}"
    & ".nav{display:flex;gap:4px;padding:8px 24px;border-bottom:1px solid var(--border);background:#0f0f0f}"
    & ".nav a{color:var(--dim);text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85em;transition:all .15s}"
    & ".nav a:hover{color:var(--text);background:#1a1a1a}"
    & ".nav a.active{color:var(--gold);background:#1a1a1a}"
    & ".lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:1000;justify-content:center;align-items:center}"
    & ".lb.on{display:flex}.lb img{max-width:95%;max-height:95%;object-fit:contain}"
    & ".lb .x{position:absolute;top:15px;right:25px;color:#fff;font-size:2em;cursor:pointer}"
    & ".toast{position:fixed;bottom:20px;right:20px;background:#1a1a2a;border:1px solid var(--gold);color:var(--text);padding:10px 16px;border-radius:8px;font-size:.85em;z-index:500;opacity:0;transition:opacity .3s;pointer-events:none}"
    & ".toast.show{opacity:1}"
    & "@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}"

