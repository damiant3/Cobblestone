Chapter: CardDesignerApp

 We say:

Section: Default Prompts

  default-prompt : Text
  default-prompt =
    "fantasy trading card game card, ornate golden card frame border, "
    & "fierce dragon general creature in center art panel, glowing red mana "
    & "symbol top right, power toughness defense stats 5/4/2 in bottom banner, "
    & "card name plate at top, ability text area, dark parchment card texture, "
    & "professional TCG card art, intricate filigree details, dramatic lighting, "
    & "masterpiece, best quality, 4k, sharp focus"

  default-negative : Text
  default-negative =
    "blurry, low quality, deformed, ugly, text errors, watermark, signature, "
    & "photograph, 3d render, nsfw, plain background, cropped, out of frame"

Section: Dimension Definitions

  Dimension = record {
    name : Text,
    key : Text
  }

  dimensions : List Dimension
  dimensions = [
    Dimension { name = "Model", key = "model" },
    Dimension { name = "Sampler", key = "sampler" },
    Dimension { name = "Steps", key = "steps" },
    Dimension { name = "CFG", key = "cfg" },
    Dimension { name = "LoRA", key = "lora" }
  ]

Section: Steps and CFG Options

  steps-options : List Integer
  steps-options = [4, 8, 12, 15, 20, 25, 30, 40]

  cfg-options : List Integer
  cfg-options = [1, 2, 3, 4, 5, 7, 9, 12]

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni "card-designer-app loaded"
  end

