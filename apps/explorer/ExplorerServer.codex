 Explorer webapp server. Reads a multi-table .db off the attached disk
 (ExplorerStore format, raw sectors via block-read-sector) and serves any
 table by name as JSON over framed TCP via the WebServer std-include. A
 request /api/<name> (or /api/d/<name>) returns that table's rows as a JSON
 array of field-arrays: [["Forest","dense ..."], ...]. No serial.

 We say:

Section: Table -> JSON

  db-buf : Integer -> [Device.Block] Integer
  db-buf (x) = es-disk-load 160

  fields-json : List Text, Integer, Integer, Text -> Text
  fields-json (fs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else ","
    in fields-json fs (i + 1) n (acc & sep & jstr (list-at fs i))

  rows-json : List (List Text), Integer, Integer, Text -> Text
  rows-json (rows) (i) (n) (acc) =
    if i >= n then acc
    else let r = list-at rows i
    in let sep = if i == 0 then "" else ","
    in rows-json rows (i + 1) n (acc & sep & "[" & fields-json r 0 (list-length r) "" & "]")

  table-json : Text -> [Device.Block] Text
  table-json (name) = act
    buf <- db-buf 0
    let rows = es-read-table buf name
    in "[" & rows-json rows 0 (list-length rows) "" & "]"
  end

Section: URL decoding

 Query-param values arrive percent-encoded (the browser encodes spaces and
 punctuation). Decode in Unicode space via to-unicode/from-unicode so the
 frequency-ordered CCE table is never assumed to be ASCII-contiguous.

  url-hex : Integer -> Integer
  url-hex (u) =
    if (u >= 48) & (u <= 57) then u - 48
    else if (u >= 97) & (u <= 102) then u - 87
    else if (u >= 65) & (u <= 70) then u - 55
    else 0

  url-decode-loop : Text, Integer, Integer, Text -> Text
  url-decode-loop (s) (i) (len) (acc) =
    if i >= len then acc
    else let u = to-unicode (char-code (char-at s i))
    in if u == 43 then url-decode-loop s (i + 1) len (acc & " ")
    else if (u == 37) & ((i + 2) < len)
      then let h = url-hex (to-unicode (char-code (char-at s (i + 1))))
           in let l = url-hex (to-unicode (char-code (char-at s (i + 2))))
           in url-decode-loop s (i + 3) len (acc & char-to-text (code-to-char (from-unicode (h * 16 + l))))
    else url-decode-loop s (i + 1) len (acc & char-to-text (char-at s i))

  url-decode : Text -> Text
  url-decode (s) = url-decode-loop s 0 (text-length s) ""

Section: Per-user creations

 A user's saved creations (generated settings/characters/items) persist on
 disk as one ExplorerStore page in a fixed region (sectors cr-start..). Each
 row is [owner-id, kind, name, data]; owner-id is the account id as text so a
 plain text compare selects "mine". Stateless per request: save re-reads the
 region, appends, and rewrites it; the route holds no in-memory content.

  cr-start : Integer = 220
  cr-sectors : Integer = 32
  cr-max : Integer = 50

  cr-cap : Text, Integer -> Text
  cr-cap (s) (n) = if text-length s <= n then s else substring s 0 n

  creations-read : Integer -> [Device.Block] List (List Text)
  creations-read (x) = act
    buf <- es-disk-load-at cr-start cr-sectors
    let n = es-r-u16 buf 0
    in if n > cr-max then [] else es-page-rows buf 2 0 n []
  end

  creation-save : Integer, Text, Text, Text -> [Device.Block] Integer
  creation-save (owner) (kind) (name) (data) = act
    rows <- creations-read 0
    if list-length rows >= cr-max then 0 - 1
    else let all = list-push rows [show owner, cr-cap kind 20, cr-cap name 60, cr-cap data 200]
    in let buf = es-build-page-sized all (cr-sectors * 512)
    in es-disk-save buf cr-start cr-sectors
  end

  cr-row-json : List Text -> Text
  cr-row-json (r) =
    "{\"kind\":" & jstr (list-at r 1) & ",\"name\":" & jstr (list-at r 2) & ",\"data\":" & jstr (list-at r 3) & "}"

  mine-loop : List (List Text), Text, Integer, Integer, Integer, Text -> Text
  mine-loop (rows) (owner) (i) (n) (cnt) (acc) =
    if i >= n then acc
    else let r = list-at rows i
    in if list-at r 0 == owner
       then let sep = if cnt == 0 then "" else ","
            in mine-loop rows owner (i + 1) n (cnt + 1) (acc & sep & cr-row-json r)
       else mine-loop rows owner (i + 1) n cnt acc

  mine-json : Integer -> [Device.Block] Text
  mine-json (owner) = act
    rows <- creations-read 0
    let body = "[" & mine-loop rows (show owner) 0 (list-length rows) 0 "" & "]"
    in body
  end

  handle-for : List Account, Integer, Integer, Text -> Text
  handle-for (accts) (i) (n) (oid) =
    if i >= n then "?"
    else let a = list-at accts i
    in if show (a.acc-id) == oid then a.handle else handle-for accts (i + 1) n oid

  gallery-loop : List (List Text), List Account, Integer, Integer, Text -> Text
  gallery-loop (rows) (accts) (i) (n) (acc) =
    if i >= n then acc
    else let r = list-at rows i
    in let sep = if i == 0 then "" else ","
    in let h = handle-for accts 0 (list-length accts) (list-at r 0)
    in gallery-loop rows accts (i + 1) n (acc & sep & "{\"by\":" & jstr h & ",\"kind\":" & jstr (list-at r 1) & ",\"name\":" & jstr (list-at r 2) & ",\"data\":" & jstr (list-at r 3) & "}")

  gallery-json : Integer -> [Device.Block] Text
  gallery-json (x) = act
    rows <- creations-read 0
    loaded <- accounts-load 0
    let accts = loaded.accounts
    in "[" & gallery-loop rows accts 0 (list-length rows) "" & "]"
  end

  remix-find : List (List Text), List Account, Text, Text, Integer, Integer -> List Text
  remix-find (rows) (accts) (by) (nm) (i) (n) =
    if i >= n then []
    else let r = list-at rows i
    in if (handle-for accts 0 (list-length accts) (list-at r 0) == by) & (list-at r 2 == nm)
       then r else remix-find rows accts by nm (i + 1) n

  creation-remix : Integer, Text, Text -> [Device.Block] Integer
  creation-remix (owner) (by) (nm) = act
    rows <- creations-read 0
    loaded <- accounts-load 0
    let accts = loaded.accounts
    in let src = remix-find rows accts by nm 0 (list-length rows)
    in if list-length src < 4 then 0 - 1
    else creation-save owner (list-at src 1) (list-at src 2 & " (remix)") (list-at src 3)
  end

  md-rows : List (List Text), Text, Text, Integer, Integer, Text -> Text
  md-rows (rows) (owner) (kind) (i) (n) (acc) =
    if i >= n then acc
    else let r = list-at rows i
    in if (list-at r 0 == owner) & (list-at r 1 == kind)
       then md-rows rows owner kind (i + 1) n (acc & "### " & list-at r 2 & "\n" & list-at r 3 & "\n\n")
       else md-rows rows owner kind (i + 1) n acc

  export-md : Integer, Text -> [Device.Block] Text
  export-md (owner) (handle) = act
    rows <- creations-read 0
    let o = show owner
    in "# " & handle & "'s World Codex\n\n## Settings\n\n" & md-rows rows o "setting" 0 (list-length rows) ""
       & "## Characters\n\n" & md-rows rows o "character" 0 (list-length rows) ""
       & "## Items\n\n" & md-rows rows o "item" 0 (list-length rows) ""
  end

  del-loop : List (List Text), Text, Text, Integer, Integer, List (List Text) -> List (List Text)
  del-loop (rows) (owner) (name) (i) (n) (acc) =
    if i >= n then acc
    else let r = list-at rows i
    in if (list-at r 0 == owner) & (list-at r 2 == name)
       then del-loop rows owner name (i + 1) n acc
       else del-loop rows owner name (i + 1) n (list-push acc r)

  creation-delete : Integer, Text -> [Device.Block] Integer
  creation-delete (owner) (name) = act
    rows <- creations-read 0
    let kept = del-loop rows (show owner) name 0 (list-length rows) []
    in let buf = es-build-page-sized kept (cr-sectors * 512)
    in es-disk-save buf cr-start cr-sectors
  end

Section: Integer Parse Helper

  parse-int-or : Text, Integer -> Integer
  parse-int-or (s) (fallback) =
    if text-length s == 0 then fallback
    else parse-decimal-full s

Section: Routes

  last-seg : Text -> Text
  last-seg (path) =
    let parts = text-split path "/"
    in list-at parts (list-length parts - 1)

  my-route : Maybe Account, Text -> [Device.Block] Text
  my-route (acct) (path) =
    let base = path-base path
    in if base == "/api/gallery" then gallery-json 0
       else if base == "/api/save"
       then when acct
         is None -> err-json "login required"
         is Just (a) -> act
           rc <- creation-save (a.acc-id) (url-decode (qp path "kind")) (url-decode (qp path "name")) (url-decode (qp path "data"))
           if rc < 0 then err-json "store full" else "{\"ok\":true}"
         end
       else if base == "/api/mine"
       then when acct
         is None -> err-json "login required"
         is Just (a) -> mine-json (a.acc-id)
       else if base == "/api/delete"
       then when acct
         is None -> err-json "login required"
         is Just (a) -> act
           rc <- creation-delete (a.acc-id) (url-decode (qp path "name"))
           let ok = "{\"ok\":true}"
           in ok
         end
       else if base == "/api/remix"
       then when acct
         is None -> err-json "login required"
         is Just (a) -> act
           rc <- creation-remix (a.acc-id) (url-decode (qp path "by")) (url-decode (qp path "name"))
           if rc < 0 then err-json "not found or store full" else "{\"ok\":true}"
         end
       else if base == "/api/export"
       then when acct
         is None -> err-json "login required"
         is Just (a) -> export-md (a.acc-id) (a.handle)
       else if base == "/api/export-workflow"
       then let params = WorkflowParams {
              model-name = url-decode (qp path "model"),
              positive-prompt = url-decode (qp path "prompt"),
              negative-prompt = url-decode (qp path "neg"),
              frame-prompt = url-decode (qp path "frame"),
              width = parse-int-or (qp path "width") 768,
              height = parse-int-or (qp path "height") 1024,
              steps = parse-int-or (qp path "steps") 20,
              cfg-whole = parse-int-or (qp path "cfg_whole") 7,
              cfg-frac = parse-int-or (qp path "cfg_frac") 0,
              sampler = url-decode (qp path "sampler"),
              scheduler = url-decode (qp path "scheduler"),
              seed = parse-int-or (qp path "seed") 424242,
              upscale-by = 2,
              upscaler-model = url-decode (qp path "upscaler")
            }
            in let pipeline = qp path "pipeline"
            in if pipeline == "card" then build-card-workflow params
            else if pipeline == "item" then build-item-workflow params "default"
            else build-simple-workflow params
       else table-json (last-seg base)

Section: Entry

  opening : [Console, Device.Block, Network.Read, Network.Write] Nothing = act
    r <- auth-serve (my-route)
    print-line-uni "SHUTDOWN"
  end

