Section: Page HTML

  voice-page-html : Text
  voice-page-html =
    "<nav class=\"nav\">"
    & "<a href=\"/card\">Cards</a>"
    & "<a href=\"/item\">Items</a>"
    & "<a href=\"/character\">Characters</a>"
    & "<a href=\"/setting\">Settings</a>"
    & "<a href=\"/voice\" class=\"active\">Voice</a>"
    & "</nav>"
    & "<div class=\"header\">"
    & "<h1>Voice Studio</h1>"
    & "<div class=\"controls\">"
    & "<div class=\"control-group\"><label>Profile</label><div class=\"pill-row\" id=\"profile\"></div></div>"
    & "<div class=\"control-group\"><label>Emotion</label><div class=\"pill-row\" id=\"emotion\"></div></div>"
    & "<div class=\"control-group\"><label>Template</label><div class=\"pill-row\" id=\"usecase\"></div></div>"
    & "<div class=\"voice-input\">"
    & "<textarea id=\"voice-text\" placeholder=\"Enter text to speak...\" rows=\"3\"></textarea>"
    & "<button id=\"gen-btn\" class=\"gen-button\" data-action=\"generate-voice\">Generate Voice</button>"
    & "</div>"
    & "</div>"
    & "</div>"
    & "<div class=\"status-banner\" id=\"status\">TTS backend not connected. Install Coqui XTTS or Bark and configure the endpoint.</div>"
    & "<div id=\"results\" class=\"voice-results\"></div>"
    & "<div class=\"toast\" id=\"toast\"></div>"

Section: Voice CSS

  voice-css : Text
  voice-css =
    ".voice-input{display:flex;gap:10px;margin-top:12px;align-items:flex-start}"
    & ".voice-input textarea{flex:1;background:#1a1a1a;border:1px solid var(--border);color:var(--text);padding:10px;border-radius:6px;font-size:.9em;font-family:inherit;resize:vertical}"
    & ".gen-button{background:#2a2a1a;border:1px solid var(--gold);color:var(--gold);padding:10px 20px;border-radius:6px;font-size:.9em;cursor:pointer;transition:all .15s;white-space:nowrap}"
    & ".gen-button:hover{background:#3a3a2a}"
    & ".gen-button:disabled{opacity:.5;cursor:not-allowed}"
    & ".status-banner{padding:10px 24px;background:#1a1a2a;border-bottom:1px solid #333;font-size:.85em;color:#f8d76088}"
    & ".status-banner.connected{color:#0f0;background:#0a1a0a;border-color:#0f03}"
    & ".voice-results{padding:16px 24px;display:flex;flex-direction:column;gap:10px}"
    & ".voice-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px 16px;display:flex;align-items:center;gap:14px}"
    & ".voice-card .play-btn{width:40px;height:40px;border-radius:50%;background:#2a2a1a;border:1px solid var(--gold);color:var(--gold);font-size:1.2em;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}"
    & ".voice-card .play-btn:hover{background:#3a3a2a}"
    & ".voice-card .voice-info{flex:1;font-size:.85em}"
    & ".voice-card .voice-info .voice-label{color:var(--gold);font-weight:bold}"
    & ".voice-card .voice-info .voice-text{color:var(--dim);margin-top:4px}"
    & ".voice-card audio{flex-shrink:0}"

Section: Voice JavaScript

  voice-js : Text
  voice-js =
    "const PROFILES = " & profiles-json & ";\n"
    & "const EMOTIONS = " & emotions-json & ";\n"
    & "const USECASES = " & usecases-json & ";\n"
    & "let sel = { profile: 0, emotion: 0 };\n"
    & "let ttsAvailable = false;\n"
    & "function renderPills(id, items, key, labelFn) {\n"
    & "  const el = document.getElementById(id);\n"
    & "  el.innerHTML = items.map((it, i) => {\n"
    & "    const active = i === sel[key] ? ' active' : '';\n"
    & "    return '<span class=\"pill' + active + '\" data-action=\"pick\" data-key=\"' + key + '\" data-index=\"' + i + '\">' + labelFn(it) + '</span>';\n"
    & "  }).join('');\n"
    & "}\n"
    & "function pick(key, idx) { sel[key] = idx; renderControls(); }\n"
    & "function renderUseCases() {\n"
    & "  const el = document.getElementById('usecase');\n"
    & "  el.innerHTML = USECASES.map((u, i) =>\n"
    & "    '<span class=\"pill\" data-action=\"fill-template\" data-index=\"' + i + '\">' + u.name + '</span>'\n"
    & "  ).join('');\n"
    & "}\n"
    & "function fillTemplate(idx) { document.getElementById('voice-text').value = USECASES[idx].example; }\n"
    & "function renderControls() {\n"
    & "  renderPills('profile', PROFILES, 'profile', p => p.name);\n"
    & "  renderPills('emotion', EMOTIONS, 'emotion', e => e.name);\n"
    & "  renderUseCases();\n"
    & "}\n"
    & "async function checkTts() {\n"
    & "  try {\n"
    & "    const resp = await fetch('/api/tts/status');\n"
    & "    const data = await resp.json();\n"
    & "    ttsAvailable = data.available === true;\n"
    & "    const banner = document.getElementById('status');\n"
    & "    if (ttsAvailable) { banner.textContent = 'TTS backend connected: ' + (data.model || 'unknown'); banner.className = 'status-banner connected'; }\n"
    & "  } catch(e) {}\n"
    & "}\n"
    & "async function generateVoice() {\n"
    & "  const text = document.getElementById('voice-text').value.trim();\n"
    & "  if (!text) return;\n"
    & "  const p = PROFILES[sel.profile], e = EMOTIONS[sel.emotion];\n"
    & "  if (!ttsAvailable) {\n"
    & "    const card = document.createElement('div');\n"
    & "    card.className = 'voice-card';\n"
    & "    card.innerHTML = '<div class=\"play-btn\" data-action=\"play-audio\">-</div>'\n"
    & "      + '<div class=\"voice-info\"><div class=\"voice-label\">' + p.name + ' (' + e.name + ')</div>'\n"
    & "      + '<div class=\"voice-text\">\"' + text + '\"</div>'\n"
    & "      + '<div style=\"color:#f8d760;margin-top:4px;font-size:.8em\">TTS not available -- connect a backend to hear audio</div></div>';\n"
    & "    document.getElementById('results').prepend(card);\n"
    & "    return;\n"
    & "  }\n"
    & "  const btn = document.getElementById('gen-btn');\n"
    & "  btn.disabled = true; btn.textContent = 'Generating...';\n"
    & "  try {\n"
    & "    const resp = await fetch('/api/tts/generate', { method: 'POST',\n"
    & "      headers: {'Content-Type':'application/json'},\n"
    & "      body: JSON.stringify({ text, profile: p.name, pitch: p.pitch, speed: p.speed, tone: p.tone, emotion: e.modifier }) });\n"
    & "    const data = await resp.json();\n"
    & "    const card = document.createElement('div');\n"
    & "    card.className = 'voice-card';\n"
    & "    card.innerHTML = '<div class=\"play-btn\" data-action=\"play-audio\">&#9654;</div>'\n"
    & "      + '<div class=\"voice-info\"><div class=\"voice-label\">' + p.name + ' (' + e.name + ')</div>'\n"
    & "      + '<div class=\"voice-text\">\"' + text + '\"</div></div>'\n"
    & "      + '<audio controls src=\"' + (data.url || '') + '\"></audio>';\n"
    & "    document.getElementById('results').prepend(card);\n"
    & "  } catch(e) { console.error(e); }\n"
    & "  btn.disabled = false; btn.textContent = 'Generate Voice';\n"
    & "}\n"
    & "renderControls();\n"
    & "checkTts();\n"

Section: JSON Serializers

  profiles-json : Text
  profiles-json = "[" & jp-loop voice-profiles 0 (list-length voice-profiles) "" & "]"

  jp-loop : List VoiceProfile, Integer, Integer, Text -> Text
  jp-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let p = list-at xs i
    in jp-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & p.name & "\",\"desc\":\"" & p.desc & "\",\"pitch\":\"" & p.pitch & "\",\"speed\":\"" & p.speed & "\",\"tone\":\"" & p.tone & "\"}")

  emotions-json : Text
  emotions-json = "[" & je-loop emotion-defs 0 (list-length emotion-defs) "" & "]"

  je-loop : List EmotionDef, Integer, Integer, Text -> Text
  je-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let e = list-at xs i
    in je-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & e.name & "\",\"modifier\":\"" & e.modifier & "\"}")

  usecases-json : Text
  usecases-json = "[" & ju-loop use-cases 0 (list-length use-cases) "" & "]"

  ju-loop : List UseCaseDef, Integer, Integer, Text -> Text
  ju-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let u = list-at xs i
    in ju-loop xs (i + 1) len (acc & sep & "{\"name\":\"" & u.name & "\",\"example\":\"" & u.example & "\"}")

Section: Shared CSS

  explorer-css : Text
  explorer-css =
    ":root{--gold:#ffd700;--bg:#0a0a0a;--card:#141414;--border:#2a2a2a;--text:#ccc;--dim:#666}"
    & "*{margin:0;padding:0;box-sizing:border-box}"
    & "body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif}"
    & ".header{padding:16px 24px;border-bottom:1px solid var(--border)}"
    & ".header h1{color:var(--gold);font-size:1.4em;margin-bottom:12px}"
    & ".nav{display:flex;gap:4px;padding:8px 24px;border-bottom:1px solid var(--border);background:#0f0f0f}"
    & ".nav a{color:var(--dim);text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85em;transition:all .15s}"
    & ".nav a:hover{color:var(--text);background:#1a1a1a}"
    & ".nav a.active{color:var(--gold);background:#1a1a1a}"
    & ".controls{display:flex;flex-direction:column;gap:12px;margin-top:12px}"
    & ".control-group{display:flex;align-items:center;gap:10px}"
    & ".control-group label{font-size:.8em;color:var(--gold);min-width:80px;text-transform:uppercase;letter-spacing:.5px}"
    & ".pill-row{display:flex;gap:6px;flex-wrap:wrap}"
    & ".pill{padding:5px 14px;border-radius:16px;border:1px solid var(--border);background:#1a1a1a;color:var(--text);font-size:.8em;cursor:pointer;transition:all .15s}"
    & ".pill:hover{border-color:#555}"
    & ".pill.active{border-color:var(--gold);color:var(--gold);background:#2a2a1a}"
    & ".toast{position:fixed;bottom:20px;right:20px;background:#1a1a2a;border:1px solid var(--gold);color:var(--text);padding:10px 16px;border-radius:8px;font-size:.85em;z-index:500;opacity:0;transition:opacity .3s;pointer-events:none}"
    & ".toast.show{opacity:1}"

Section: Entry Point

  opening : [Console] Nothing = act
    print-line-uni "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    print-line-uni "<title>CodexMagic -- Voice Studio</title>"
    print-line-uni "<style>"
    print-line-uni explorer-css
    print-line-uni voice-css
    print-line-uni "</style></head><body>"
    print-line-uni voice-page-html
    print-line-uni "<script>"
    print-line-uni voice-js
    print-line-uni "</script>"
    print-line-uni "</body></html>"
  end

