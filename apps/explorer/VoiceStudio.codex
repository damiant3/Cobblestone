  voice-profiles : List VoiceProfile
  voice-profiles = [
    VoiceProfile { name = "Warlord", desc = "Deep commanding battlefield voice", pitch = "low", speed = "slow", tone = "aggressive" },
    VoiceProfile { name = "Sage", desc = "Calm measured scholarly voice", pitch = "mid", speed = "measured", tone = "wise" },
    VoiceProfile { name = "Rogue", desc = "Quick sly whispering voice", pitch = "mid-high", speed = "fast", tone = "cunning" },
    VoiceProfile { name = "Druid", desc = "Warm earthy grounded voice", pitch = "mid-low", speed = "slow", tone = "gentle" },
    VoiceProfile { name = "Paladin", desc = "Clear noble resonant voice", pitch = "mid", speed = "steady", tone = "noble" },
    VoiceProfile { name = "Narrator", desc = "Rich dramatic storytelling voice", pitch = "low-mid", speed = "measured", tone = "dramatic" },
    VoiceProfile { name = "Child", desc = "Bright innocent young voice", pitch = "high", speed = "quick", tone = "cheerful" },
    VoiceProfile { name = "Elder", desc = "Aged raspy weathered voice", pitch = "low", speed = "deliberate", tone = "weary" }
