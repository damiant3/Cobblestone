 We say:

Section: Theme

  forge-theme : Theme
  forge-theme =
    let p = Palette { pal-bg = #0B0E14, pal-fg = #E8E3D3, pal-primary = #F5C542, pal-secondary = #161B26, pal-accent = #F5C542, pal-muted = #6B7280, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #262D3D }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-primary) (p.pal-bg) (bdr 0 0 (CornerRound 8)) (exy 16 10) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "forge-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  forge-css : Text
  forge-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:radial-gradient(ellipse at top,#141a29 0%,#0b0e14 60%);color:#e8e3d3;font-family:Georgia,serif;min-height:100vh}#app{display:contents}"
    & ".forge{max-width:1080px;margin:0 auto;padding:40px 24px}"
    & ".hdr{text-align:center;margin-bottom:28px}"
    & "#title{display:block;font-size:44px;letter-spacing:10px;color:#f5c542;text-shadow:0 0 24px rgba(245,197,66,.35)}"
    & "#tag{display:block;font-size:14px;color:#6b7280;margin-top:10px;font-style:italic}"
    & ".forge .ask{display:flex;flex-direction:column;gap:10px;margin-bottom:26px;max-width:720px;margin-left:auto;margin-right:auto}"
    & ".forge .ask .hint{font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:2px}"
    & ".forge .ask input,.forge .ask input:focus,.forge .ask input:hover,.forge .ask input:active{background:#161b26;border:1px solid #262d3d;color:#e8e3d3;border-radius:8px;padding:13px;font-size:15px;font-family:inherit;width:100%;margin:0}"
    & ".forge .ask input:focus{outline:none;border-color:#f5c542}"
    & ".forge .ask button,.forge .ask button:focus,.forge .ask button:hover,.forge .ask button:active{background:linear-gradient(180deg,#f5c542,#d9a520);border:none;color:#0b0e14;border-radius:8px;padding:14px 20px;font-size:15px;font-weight:700;letter-spacing:2px;cursor:pointer;margin:0}"
    & ".forge .ask button:hover{filter:brightness(1.1)}"
    & ".forge .ask button:disabled{filter:grayscale(.6) brightness(.8);cursor:wait}"
    & ".forge .offer-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:26px}"
    & ".forge .card{background:#11151f;border:1px solid #262d3d;border-radius:12px;padding:22px;display:flex;flex-direction:column;gap:10px}"
    & ".forge .card.empty{text-align:center;color:#6b7280;font-style:italic;display:block}"
    & ".forge .card.error{border-color:#ec4d30;color:#ec4d30;text-align:center;display:block;margin-bottom:14px}"
    & ".forge .card .cname{display:block;font-size:20px;color:#f5c542}"
    & ".forge .card .cvert{display:inline-block;font-size:10px;color:#0b0e14;background:#f5c542;border-radius:12px;padding:3px 10px;text-transform:uppercase;letter-spacing:1px;align-self:flex-start}"
    & ".forge .card .cpitch{display:block;font-size:13px;line-height:1.6;color:#c9c2ae;flex:1}"
    & ".forge .card button,.forge .card button:focus,.forge .card button:hover,.forge .card button:active{background:transparent;border:1px solid #f5c542;color:#f5c542;border-radius:8px;padding:10px;font-size:12px;letter-spacing:2px;cursor:pointer;margin-top:auto}"
    & ".forge .card button:hover{background:#f5c542;color:#0b0e14}"
    & ".forge .cert{background:linear-gradient(160deg,#1a1408,#11151f 55%);border:1px solid #f5c542;border-radius:12px;padding:30px;margin-bottom:26px;text-align:center}"
    & "#cert-name{display:block;font-size:30px;color:#f5c542;margin-bottom:8px}"
    & "#cert-vert{display:inline-block;font-size:11px;color:#0b0e14;background:#f5c542;border-radius:12px;padding:3px 12px;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px}"
    & "#cert-pitch{display:block;font-size:15px;line-height:1.7;margin-bottom:14px}"
    & "#cert-text{display:block;font-size:12px;color:#41af4e;font-style:italic;margin-bottom:16px}"
    & ".forge .cert button,.forge .cert button:focus,.forge .cert button:hover,.forge .cert button:active{background:transparent;border:1px solid #6b7280;color:#6b7280;border-radius:8px;padding:8px 16px;font-size:11px;letter-spacing:2px;cursor:pointer}"
    & ".forge .board{background:#0d111a;border:1px solid #262d3d;border-radius:12px;padding:22px}"
    & "#board-title{display:block;font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:3px;margin-bottom:14px;text-align:center}"
    & ".forge .ledger-row{display:grid;grid-template-columns:56px 1fr 180px 120px;gap:10px;align-items:center;padding:9px 12px;border-bottom:1px solid #1a2030}"
    & ".forge .ledger-row .lserial{font-size:11px;color:#6b7280;font-family:monospace}"
    & ".forge .ledger-row .lname{font-size:15px;color:#e8e3d3}"
    & ".forge .ledger-row .lvert{font-size:10px;color:#f5c542;text-transform:uppercase;letter-spacing:1px}"
    & ".forge .ledger-row .lholder{font-size:12px;color:#41af4e;font-family:monospace;text-align:right}"
    & ".forge .board .empty-note{display:block;text-align:center;color:#4b5563;font-style:italic;font-size:13px;padding:10px}"

Section: Response Field Scan

  json-field : Text, Text -> Text
  json-field (body) (key) = json-field-nth body key 0

  json-field-nth : Text, Text, Integer -> Text
  json-field-nth (body) (key) (n) =
    let marker = "\"" & key & "\":\""
    in nth-scan body marker 0 n

  nth-scan : Text, Text, Integer, Integer -> Text
  nth-scan (body) (marker) (from) (n) =
    let rel = text-index-of (text-drop body from) marker
    in if rel < 0 then ""
    else let vstart = from + rel + text-length marker
    in if n == 0 then read-to-quote body vstart ""
    else nth-scan body marker vstart (n - 1)

  read-to-quote : Text, Integer, Text -> Text
  read-to-quote (s) (i) (acc) =
    if i >= text-length s then acc
    else let c = char-to-text (char-at s i)
    in if c == "\"" then acc
    else read-to-quote s (i + 1) (acc & c)

  json-int-field : Text, Text -> Integer
  json-int-field (body) (key) =
    let marker = "\"" & key & "\":"
    in let i = text-index-of body marker
    in if i < 0 then (-1)
    else read-digits body (i + text-length marker) 0

  read-digits : Text, Integer, Integer -> Integer
  read-digits (s) (i) (acc) =
    if i >= text-length s then acc
    else let u = char-code-at s i
    in let z = char-code-at "0" 0
    in if u >= z & u <= z + 9 then read-digits s (i + 1) (acc * 10 + (u - z))
    else acc

  count-field : Text, Text -> Integer
  count-field (body) (key) = text-count body ("\"" & key & "\":\"")

Section: Prompt Encoding

  encode-prompt : Text -> Text
  encode-prompt (s) =
    let s1 = text-replace s "%" "%25"
    in let s2 = text-replace s1 "&" "%26"
    in let s3 = text-replace s2 "#" "%23"
    in let s4 = text-replace s3 "+" "%2B"
    in let s5 = text-replace s4 "?" "%3F"
    in text-replace s5 " " "%20"

Section: Tree

  default-demand : Text
  default-demand = "build me a website that makes me a million dollars. ask no questions, make no mistakes."

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "forge" [
     widget-box "hdr" "hdr" [
      widget-label "title" "IDEA FORGE",
      widget-label "tag" "Three fortunes dealt. You keep one. The house keeps its word."
     ],
     ask-panel 0,
     widget-box "dynamic" "dyn" (dynamic-children 0)
    ]

  ask-panel : Integer -> WidgetNode
  ask-panel (x) =
    widget-box "ask" "ask" [
     widget-label "who-hint" "State your name for the ledger",
     widget-input "who-input" (state-get-text "who") 0,
     widget-label "prompt-hint" "State your demand",
     widget-input "prompt-input" (state-get-text "prompt") 0,
     widget-button "summon" "DEAL ME THREE FORTUNES"
    ]

  dynamic-children : Integer -> List WidgetNode
  dynamic-children (x) =
    let notice = state-get-text "notice"
    in let head = if text-length notice > 0 then [notice-card notice] else []
    in head & [
     table-view (state-get-text "claim-body") (state-get-text "offer-body"),
     board-view (state-get-text "board-body")
    ]

  notice-card : Text -> WidgetNode
  notice-card (msg) =
    widget-box "notice" "card error" [
     widget-label "notice-msg" ("The house says: " & msg)
    ]

Section: The Table

  table-view : Text, Text -> WidgetNode
  table-view (cbody) (offer) =
    if text-length cbody > 0 then
      if text-length (json-field cbody "error") > 0 then error-card (json-field cbody "error")
      else certificate cbody
    else if text-length offer > 0 then
      if text-length (json-field offer "error") > 0 then error-card (json-field offer "error")
      else offer-cards offer
    else
      widget-box "table" "card empty" [
       widget-label "table-hint" "The dealer is ready. State your demand, or just press the button."
      ]

  error-card : Text -> WidgetNode
  error-card (msg) =
    widget-box "table" "card error" [
     widget-label "err-msg" ("The house says: " & msg)
    ]

  offer-cards : Text -> WidgetNode
  offer-cards (offer) =
    widget-box "table" "offer-row" [
     candidate-card offer 0,
     candidate-card offer 1,
     candidate-card offer 2
    ]

  candidate-card : Text, Integer -> WidgetNode
  candidate-card (offer) (k) =
    widget-box ("cand" & show k) "card" [
     widget-label ("cn" & show k) (json-field-nth offer "name" k),
     widget-label ("cv" & show k) (json-field-nth offer "vertical" k),
     widget-label ("cp" & show k) (json-field-nth offer "pitch" k),
     widget-button ("pick" & show k) "RESERVE THIS ONE"
    ]

  certificate : Text -> WidgetNode
  certificate (cbody) =
    widget-box "table" "cert" [
     widget-label "cert-name" (json-field cbody "name"),
     widget-label "cert-vert" (json-field cbody "vertical"),
     widget-label "cert-pitch" (json-field cbody "pitch"),
     widget-label "cert-text" (json-field cbody "certificate"),
     widget-button "again" "RETURN TOMORROW FOR ANOTHER"
    ]

Section: The Ledger

  board-view : Text -> WidgetNode
  board-view (board) =
    let n = count-field board "name"
    in let title = widget-label "board-title" ("THE LEDGER OF RESERVED FORTUNES (" & show n & ")")
    in let rows = if n == 0 then [widget-label "board-empty" "No fortunes reserved yet. The deck is full."] else ledger-rows board n 0 []
    in widget-box "board" "board" ([title] & rows)

  ledger-rows : Text, Integer, Integer, List WidgetNode -> List WidgetNode
  ledger-rows (board) (n) (i) (acc) =
    if i >= n then acc
    else ledger-rows board n (i + 1) (list-push acc (ledger-row board i))

  ledger-row : Text, Integer -> WidgetNode
  ledger-row (board) (i) =
    widget-box ("lr" & show i) "ledger-row" [
     widget-label ("ls" & show i) ("#" & show (i + 1)),
     widget-label ("ln" & show i) (json-field-nth board "name" i),
     widget-label ("lv" & show i) (json-field-nth board "vertical" i),
     widget-label ("lh" & show i) (json-field-nth board "holder" i)
    ]

Section: Handlers

  visitor : Integer -> Text
  visitor (x) =
    let w = state-get-text "who"
    in if text-length w == 0 then "anonymous-high-roller" else w

  is-error-body : Text -> Boolean
  is-error-body (raw) = text-length (json-field raw "error") > 0

  refresh-board : Integer -> Integer
  refresh-board (x) = fetch-get-then "/claims" on-board

  on-board : Text -> Integer
  on-board (raw) =
    let s = state-set-text "board-body" raw
    in render-dynamic 0

  on-offer : Text -> Integer
  on-offer (raw) =
    let d = state-set "dealing" 0
    in let b = dom-set-text (dom-get "summon") "DEAL ME THREE FORTUNES"
    in if is-error-body raw then
      let n = state-set-text "notice" (json-field raw "error")
      in render-dynamic 0
    else
      let n = state-set-text "notice" ""
      in let c = state-set-text "claim-body" ""
      in let o = state-set-text "offer-body" raw
      in render-dynamic 0

  on-claim : Text -> Integer
  on-claim (raw) =
    let d = state-set "claiming" 0
    in if is-error-body raw then
      let n = state-set-text "notice" (json-field raw "error")
      in render-dynamic 0
    else
      let n = state-set-text "notice" ""
      in let c = state-set-text "claim-body" raw
      in let r = render-dynamic 0
      in refresh-board 0

  forge-click : Text -> Integer
  forge-click (id) =
    if id == "summon" then
      if state-get "dealing" == 1 then 0
      else
        let g = state-set "dealing" 1
        in let n = state-set-text "notice" ""
        in let b = dom-set-text (dom-get "summon") "THE HOUSE IS DEALING..."
        in let p = state-get-text "prompt"
        in let effective = if text-length p == 0 then default-demand else p
        in fetch-get-then ("/offer?prompt=" & encode-prompt effective & "&who=" & encode-prompt (visitor 0)) on-offer
    else if text-starts-with id "pick" then
      if state-get "claiming" == 1 then 0
      else
        let g = state-set "claiming" 1
        in let n = state-set-text "notice" ""
        in let oid = json-int-field (state-get-text "offer-body") "offer"
        in fetch-get-then ("/claim?offer=" & show oid & "&pick=" & show (id-num id) & "&who=" & encode-prompt (visitor 0)) on-claim
    else if id == "again" then
      let c = state-set-text "claim-body" ""
      in let o = state-set-text "offer-body" ""
      in let n = state-set-text "notice" ""
      in render-dynamic 0
    else 0

  forge-input : Text, Text -> Integer
  forge-input (id) (val) =
    if id == "prompt-input" then
      let s = state-set-text "prompt" val
      in 0
    else if id == "who-input" then
      let s = state-set-text "who" val
      in 0
    else 0

Section: Entry

  render-forge : Integer -> Integer
  render-forge (x) = mount-widget-themed forge-theme (page-tree 0)

  render-dynamic : Integer -> Integer
  render-dynamic (x) = mount-widget-into "dynamic" (widget-box "dynwrap" "" (dynamic-children 0))

  opening : [Console] Integer
  opening = act
    let t = inject-app-style forge-theme forge-css
    in let s0 = state-set-text "prompt" ""
    in let s1 = state-set-text "who" ""
    in let s2 = state-set-text "offer-body" ""
    in let s3 = state-set-text "claim-body" ""
    in let s4 = state-set-text "board-body" ""
    in let s5 = state-set-text "notice" ""
    in let g0 = state-set "dealing" 0
    in let g1 = state-set "claiming" 0
    in let s = set-render render-forge
    in let h = register-handlers no-pick forge-click
    in let hi = register-input-handler forge-input
    in let b = refresh-board 0
    in render-forge 0
  end
