 We say:

Section: State

  ChatAccount = record {
   ca-name : Text,
   ca-token : Text,
   ca-contacts : List Text,
   ca-convs : List Text
  }

  ChatMessage = record {
   cm-id : Integer,
   cm-sender : Text,
   cm-body : Text,
   cm-time : Text
  }

  ChatConv = record {
   cv-id : Text,
   cv-kind : Text,
   cv-members : List Text,
   cv-messages : List ChatMessage,
   cv-name : Text
  }

  ChatState = record {
   cs-accounts : List ChatAccount,
   cs-convs : List ChatConv,
   cs-next-conv : Integer,
   cs-next-msg : Integer
  }

  chat-state-new : ChatState
  chat-state-new = ChatState {
    cs-accounts = [],
    cs-convs = [],
    cs-next-conv = 1,
    cs-next-msg = 1
  }

  ChatHost = record {
   ch-time : Text,
   ch-token : Text
  }

Section: State Updates

  chat-with-accounts : ChatState, List ChatAccount -> ChatState
  chat-with-accounts (st) (accts) = ChatState {
    cs-accounts = accts,
    cs-convs = st.cs-convs,
    cs-next-conv = st.cs-next-conv,
    cs-next-msg = st.cs-next-msg
  }

  chat-add-conv-id : ChatAccount, Text -> ChatAccount
  chat-add-conv-id (a) (cid) = ChatAccount {
    ca-name = a.ca-name,
    ca-token = a.ca-token,
    ca-contacts = a.ca-contacts,
    ca-convs = list-push (a.ca-convs) cid
  }

  chat-put-account : List ChatAccount, ChatAccount -> List ChatAccount
  chat-put-account (accts) (a) = chat-put-account-loop accts a 0 [] False

  chat-put-account-loop : List ChatAccount, ChatAccount, Integer, List ChatAccount, Boolean -> List ChatAccount
  chat-put-account-loop (accts) (a) (i) (acc) (placed) =
    if i >= list-length accts then (if placed then acc else list-push acc a)
    else let b = list-at accts i
    in if b.ca-name == a.ca-name then chat-put-account-loop accts a (i + 1) (list-push acc a) True
    else chat-put-account-loop accts a (i + 1) (list-push acc b) placed

  chat-put-conv : List ChatConv, ChatConv -> List ChatConv
  chat-put-conv (convs) (c) = chat-put-conv-loop convs c 0 []

  chat-put-conv-loop : List ChatConv, ChatConv, Integer, List ChatConv -> List ChatConv
  chat-put-conv-loop (convs) (c) (i) (acc) =
    if i >= list-length convs then acc
    else let d = list-at convs i
    in if d.cv-id == c.cv-id then chat-put-conv-loop convs c (i + 1) (list-push acc c)
    else chat-put-conv-loop convs c (i + 1) (list-push acc d)

  chat-new-account : List ChatAccount, Text, Text -> List ChatAccount
  chat-new-account (accts) (name) (tok) =
    list-push accts (ChatAccount { ca-name = name, ca-token = tok, ca-contacts = [], ca-convs = [] })

  chat-join-all : List ChatAccount, List Text, Text, Integer -> List ChatAccount
  chat-join-all (accts) (names) (cid) (i) =
    if i >= list-length names then accts
    else when chat-account-named accts (list-at names i)
      is None -> chat-join-all accts names cid (i + 1)
      is Just (a) -> chat-join-all (chat-put-account accts (chat-add-conv-id a cid)) names cid (i + 1)

Section: Lookups

  chat-account-named : List ChatAccount, Text -> Maybe ChatAccount
  chat-account-named (accts) (name) = chat-named-loop accts name 0

  chat-named-loop : List ChatAccount, Text, Integer -> Maybe ChatAccount
  chat-named-loop (accts) (name) (i) =
    if i >= list-length accts then None
    else let a = list-at accts i
    in if a.ca-name == name then Just a
    else chat-named-loop accts name (i + 1)

  chat-account-of-token : List ChatAccount, Text -> Maybe ChatAccount
  chat-account-of-token (accts) (tok) =
    if text-length tok == 0 then None
    else chat-token-loop accts tok 0

  chat-token-loop : List ChatAccount, Text, Integer -> Maybe ChatAccount
  chat-token-loop (accts) (tok) (i) =
    if i >= list-length accts then None
    else let a = list-at accts i
    in if a.ca-token == tok then Just a
    else chat-token-loop accts tok (i + 1)

  chat-conv-of : List ChatConv, Text -> Maybe ChatConv
  chat-conv-of (convs) (cid) = chat-conv-loop convs cid 0

  chat-conv-loop : List ChatConv, Text, Integer -> Maybe ChatConv
  chat-conv-loop (convs) (cid) (i) =
    if i >= list-length convs then None
    else let c = list-at convs i
    in if c.cv-id == cid then Just c
    else chat-conv-loop convs cid (i + 1)

  chat-has-text : List Text, Text, Integer -> Boolean
  chat-has-text (xs) (x) (i) =
    if i >= list-length xs then False
    else if list-at xs i == x then True
    else chat-has-text xs x (i + 1)

  chat-find-dm : List ChatConv, List Text, Text, Integer -> Text
  chat-find-dm (convs) (ids) (name) (i) =
    if i >= list-length ids then ""
    else when chat-conv-of convs (list-at ids i)
      is None -> chat-find-dm convs ids name (i + 1)
      is Just (c) -> if c.cv-kind == "dm" & chat-has-text (c.cv-members) name 0 then c.cv-id
        else chat-find-dm convs ids name (i + 1)

Section: Requests

  chat-hex-val : Integer -> Integer
  chat-hex-val (u) =
    if u >= 48 & u <= 57 then u - 48
    else if u >= 97 & u <= 102 then u - 87
    else if u >= 65 & u <= 70 then u - 55
    else 0

  chat-hex-pair : Text, Integer -> Integer
  chat-hex-pair (s) (i) =
    chat-hex-val (to-unicode (char-code (char-at s i))) * 16 + chat-hex-val (to-unicode (char-code (char-at s (i + 1))))

  chat-url-decode : Text -> Text
  chat-url-decode (s) = chat-url-decode-loop s 0 (text-length s) ""

  chat-url-decode-loop : Text, Integer, Integer, Text -> Text
  chat-url-decode-loop (s) (i) (len) (acc) =
    if i >= len then acc
    else let u = to-unicode (char-code (char-at s i))
    in if u == 43 then chat-url-decode-loop s (i + 1) len (acc & " ")
    else if u == 37 & i + 2 < len then
      chat-url-decode-loop s (i + 3) len (acc & cce-foreign-byte-text (chat-hex-pair s (i + 1)))
    else chat-url-decode-loop s (i + 1) len (acc & char-to-text (char-at s i))

  chat-path-only : Text -> Text
  chat-path-only (path) =
    let q = text-index-of path "?"
    in if q < 0 then path else text-take path q

  chat-param : Text, Text -> Text
  chat-param (path) (key) =
    let q = text-index-of path "?"
    in if q < 0 then ""
    else chat-find-param (text-split (text-drop path (q + 1)) "&") key 0

  chat-find-param : List Text, Text, Integer -> Text
  chat-find-param (pairs) (key) (i) =
    if i >= list-length pairs then ""
    else let pair = list-at pairs i
    in let eqpos = text-index-of pair "="
    in if eqpos < 0 then chat-find-param pairs key (i + 1)
    else if text-take pair eqpos == key then chat-url-decode (text-drop pair (eqpos + 1))
    else chat-find-param pairs key (i + 1)

Section: Responses


  chat-json : JsonValue -> HttpResponse
  chat-json (v) = HttpResponse { status = http-200, content-type = "application/json", body = json-emit v }

  chat-error : Text -> HttpResponse
  chat-error (msg) = chat-json (json-object [json-pair "error" (json-str msg)])

  chat-count : Integer -> JsonPair
  chat-count (n) = json-pair "count" (json-str (show n))

  chat-conv-id-json : Text -> HttpResponse
  chat-conv-id-json (cid) = chat-json (json-object [json-pair "convId" (json-str cid)])

  chat-token-json : Text, Text -> HttpResponse
  chat-token-json (tok) (name) = chat-json (json-object [json-pair "token" (json-str tok), json-pair "name" (json-str name)])

Section: Routing

  chat-route : ChatState, ChatHost, HttpRequest -> (ChatState, HttpResponse)
  chat-route (st) (host) (req) =
    let p = chat-path-only (req.path)
    in let q = req.path
    in if p == "/api/chat/register" then chat-register st host q
    else if p == "/api/chat/me" then chat-me st q
    else if p == "/api/chat/conversations" then chat-conversations st q
    else if p == "/api/chat/messages" then chat-messages st q
    else if p == "/api/chat/send" then chat-send st host q
    else if p == "/api/chat/start" then chat-start st host q
    else if p == "/api/chat/contacts" then chat-contacts st q
    else if p == "/api/chat/group" then chat-group st host q
    else (st, chat-error "not found")

Section: Accounts

  chat-register : ChatState, ChatHost, Text -> (ChatState, HttpResponse)
  chat-register (st) (host) (q) =
    let name = chat-param q "name"
    in if text-length name < 1 then (st, chat-error "name required")
    else when chat-account-named (st.cs-accounts) name
      is Just (a) -> (st, chat-error "name taken")
      is None -> (chat-with-accounts st (chat-new-account (st.cs-accounts) name (host.ch-token)), chat-token-json (host.ch-token) name)

  chat-me : ChatState, Text -> (ChatState, HttpResponse)
  chat-me (st) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> (st, chat-json (json-object [json-pair "name" (json-str (u.ca-name))]))

  chat-contacts : ChatState, Text -> (ChatState, HttpResponse)
  chat-contacts (st) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> (st, chat-json (json-object (chat-contact-rows (u.ca-contacts) 0 [chat-count (list-length (u.ca-contacts))])))

  chat-contact-rows : List Text, Integer, List JsonPair -> List JsonPair
  chat-contact-rows (names) (i) (acc) =
    if i >= list-length names then acc
    else chat-contact-rows names (i + 1) (list-push acc (json-pair ("name-" & show i) (json-str (list-at names i))))

Section: Conversations

  chat-conversations : ChatState, Text -> (ChatState, HttpResponse)
  chat-conversations (st) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> (st, chat-json (json-object (chat-conv-rows st u 0 [chat-count (list-length (u.ca-convs))])))

  chat-conv-rows : ChatState, ChatAccount, Integer, List JsonPair -> List JsonPair
  chat-conv-rows (st) (u) (i) (acc) =
    if i >= list-length (u.ca-convs) then acc
    else when chat-conv-of (st.cs-convs) (list-at (u.ca-convs) i)
      is None -> chat-conv-rows st u (i + 1) acc
      is Just (c) -> chat-conv-rows st u (i + 1) (acc & chat-conv-pairs u c i)

  chat-conv-pairs : ChatAccount, ChatConv, Integer -> List JsonPair
  chat-conv-pairs (u) (c) (i) =
    let n = show i
    in [json-pair ("name-" & n) (json-str (chat-conv-title u c)),
        json-pair ("preview-" & n) (json-str (chat-preview c)),
        json-pair ("time-" & n) (json-str (chat-last-time c)),
        json-pair ("id-" & n) (json-str (c.cv-id))]

  chat-conv-title : ChatAccount, ChatConv -> Text
  chat-conv-title (u) (c) =
    if c.cv-kind == "group" then c.cv-name
    else let other = chat-other-member (c.cv-members) (u.ca-name) 0
    in if text-length other == 0 then c.cv-name else other

  chat-other-member : List Text, Text, Integer -> Text
  chat-other-member (members) (me) (i) =
    if i >= list-length members then ""
    else if list-at members i == me then chat-other-member members me (i + 1)
    else list-at members i

  chat-preview : ChatConv -> Text
  chat-preview (c) =
    let n = list-length (c.cv-messages)
    in if n == 0 then "No messages yet"
    else let b = (list-at (c.cv-messages) (n - 1)).cm-body
    in if text-length b > 40 then text-take b 40 else b

  chat-last-time : ChatConv -> Text
  chat-last-time (c) =
    let n = list-length (c.cv-messages)
    in if n == 0 then "" else (list-at (c.cv-messages) (n - 1)).cm-time

  chat-start : ChatState, ChatHost, Text -> (ChatState, HttpResponse)
  chat-start (st) (host) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> chat-start-with st host u (chat-param q "with")

  chat-start-with : ChatState, ChatHost, ChatAccount, Text -> (ChatState, HttpResponse)
  chat-start-with (st) (host) (u) (with-name) =
    if text-length with-name == 0 then (st, chat-error "with required")
    else when chat-account-named (st.cs-accounts) with-name
      is None -> (st, chat-error "no such user")
      is Just (other) -> chat-start-dm st u with-name

  chat-start-dm : ChatState, ChatAccount, Text -> (ChatState, HttpResponse)
  chat-start-dm (st) (u) (with-name) =
    let found = chat-find-dm (st.cs-convs) (u.ca-convs) with-name 0
    in if text-length found > 0 then (st, chat-conv-id-json found)
    else let cid = "c" & show (st.cs-next-conv)
    in let conv = ChatConv { cv-id = cid, cv-kind = "dm", cv-members = [(u.ca-name), with-name], cv-messages = [], cv-name = "" }
    in let joined = chat-join-all (st.cs-accounts) [(u.ca-name), with-name] cid 0
    in (ChatState { cs-accounts = joined, cs-convs = list-push (st.cs-convs) conv, cs-next-conv = st.cs-next-conv + 1, cs-next-msg = st.cs-next-msg }, chat-conv-id-json cid)

  chat-group : ChatState, ChatHost, Text -> (ChatState, HttpResponse)
  chat-group (st) (host) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> chat-group-named st u (chat-param q "name") (chat-param q "members")

  chat-group-named : ChatState, ChatAccount, Text, Text -> (ChatState, HttpResponse)
  chat-group-named (st) (u) (gname) (members) =
    if text-length gname == 0 then (st, chat-error "name required")
    else let names = chat-group-members (st.cs-accounts) (text-split members ",") (u.ca-name) 0 [(u.ca-name)]
    in let cid = "c" & show (st.cs-next-conv)
    in let conv = ChatConv { cv-id = cid, cv-kind = "group", cv-members = names, cv-messages = [], cv-name = gname }
    in (ChatState { cs-accounts = chat-join-all (st.cs-accounts) names cid 0, cs-convs = list-push (st.cs-convs) conv, cs-next-conv = st.cs-next-conv + 1, cs-next-msg = st.cs-next-msg }, chat-conv-id-json cid)

  chat-group-members : List ChatAccount, List Text, Text, Integer, List Text -> List Text
  chat-group-members (accts) (parts) (me) (i) (acc) =
    if i >= list-length parts then acc
    else let m = text-trim (list-at parts i)
    in if text-length m == 0 | m == me | chat-has-text acc m 0 then chat-group-members accts parts me (i + 1) acc
    else when chat-account-named accts m
      is None -> chat-group-members accts parts me (i + 1) acc
      is Just (a) -> chat-group-members accts parts me (i + 1) (list-push acc m)

Section: Messages

  chat-messages : ChatState, Text -> (ChatState, HttpResponse)
  chat-messages (st) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> (st, chat-json (json-object (chat-messages-of st u (chat-param q "conv"))))

  chat-messages-of : ChatState, ChatAccount, Text -> List JsonPair
  chat-messages-of (st) (u) (cid) =
    when chat-conv-of (st.cs-convs) cid
      is None -> [chat-count 0]
      is Just (c) -> chat-message-rows u (c.cv-messages) 0 [chat-count (list-length (c.cv-messages))]

  chat-message-rows : ChatAccount, List ChatMessage, Integer, List JsonPair -> List JsonPair
  chat-message-rows (u) (ms) (i) (acc) =
    if i >= list-length ms then acc
    else let m = list-at ms i
    in let n = show i
    in chat-message-rows u ms (i + 1) (acc & [
      json-pair ("body-" & n) (json-str (m.cm-body)),
      json-pair ("sender-" & n) (json-str (m.cm-sender)),
      json-pair ("time-" & n) (json-str (m.cm-time)),
      json-pair ("mine-" & n) (json-str (if m.cm-sender == u.ca-name then "1" else "0"))])

  chat-send : ChatState, ChatHost, Text -> (ChatState, HttpResponse)
  chat-send (st) (host) (q) =
    when chat-account-of-token (st.cs-accounts) (chat-param q "t")
      is None -> (st, chat-error "auth")
      is Just (u) -> chat-send-as st host u (chat-param q "to") (chat-param q "body")

  chat-send-as : ChatState, ChatHost, ChatAccount, Text, Text -> (ChatState, HttpResponse)
  chat-send-as (st) (host) (u) (to) (body) =
    if text-length body == 0 then (st, chat-error "empty")
    else when chat-conv-of (st.cs-convs) to
      is None -> (st, chat-error "no conv")
      is Just (c) -> (chat-append-message st c (ChatMessage { cm-id = st.cs-next-msg, cm-sender = u.ca-name, cm-body = body, cm-time = host.ch-time }), chat-json (json-object [json-pair "ok" (json-bool True)]))

  chat-append-message : ChatState, ChatConv, ChatMessage -> ChatState
  chat-append-message (st) (c) (m) = ChatState {
    cs-accounts = st.cs-accounts,
    cs-convs = chat-put-conv (st.cs-convs) (ChatConv { cv-id = c.cv-id, cv-kind = c.cv-kind, cv-members = c.cv-members, cv-messages = list-push (c.cv-messages) m, cv-name = c.cv-name }),
    cs-next-conv = st.cs-next-conv,
    cs-next-msg = st.cs-next-msg + 1
  }
