Chapter: ChatServer
  cites Chat chapter ChatTheme

 We say:

Section: Data Model

  next-token-counter : Integer = 1000

  sample-token : Text = "tok-a7f3e9b1c2d4056831"

  sample-user-name : Text = "Damian"

Section: Route Dispatcher

  handle-request : Text, Text, Text -> Text
  handle-request (method) (path) (body) =
    if text-starts-with path "/api/chat/register" then handle-register path
    else if text-starts-with path "/api/chat/me" then handle-me path
    else if text-starts-with path "/api/chat/conversations" then handle-conversations path
    else if text-starts-with path "/api/chat/messages" then handle-messages path
    else if text-starts-with path "/api/chat/contacts" then handle-contacts path
    else if text-starts-with path "/api/chat/send" then handle-send path
    else if text-starts-with path "/api/chat/start" then handle-start-conv path
    else json-error "Unknown endpoint"

  text-starts-with : Text, Text -> Boolean
  text-starts-with (s) (p) =
    if text-length p > text-length s then False
    else text-sub s 0 (text-length p) == p

  text-sub : Text, Integer, Integer -> Text
  text-sub (s) (start) (len) = text-sub-loop s start (start + len) ""

  text-sub-loop : Text, Integer, Integer, Text -> Text
  text-sub-loop (s) (i) (stop) (acc) =
    if i >= stop then acc
    else if i >= text-length s then acc
    else text-sub-loop s (i + 1) stop (acc & char-to-text (char-at s i))

Section: Auth Endpoints

  handle-register : Text -> Text
  handle-register (path) =
    let c = next-token-counter
    in "{\"token\":\"tok-" & show c & "\"}"

  handle-me : Text -> Text
  handle-me (path) =
    "{\"name\":\"" & sample-user-name & "\",\"error\":\"\"}"

Section: Conversations

  handle-conversations : Text -> Text
  handle-conversations (path) =
    "{\"count\":\"3\","
    & "\"id-0\":\"conv-alpha\","
    & "\"name-0\":\"Alice\","
    & "\"preview-0\":\"See you tomorrow!\","
    & "\"time-0\":\"2:45 PM\","
    & "\"id-1\":\"conv-beta\","
    & "\"name-1\":\"Bob\","
    & "\"preview-1\":\"The build is green.\","
    & "\"time-1\":\"1:12 PM\","
    & "\"id-2\":\"conv-gamma\","
    & "\"name-2\":\"Carol\","
    & "\"preview-2\":\"Got it, thanks!\","
    & "\"time-2\":\"Yesterday\"}"

Section: Messages

  handle-messages : Text -> Text
  handle-messages (path) =
    "{\"count\":\"4\","
    & "\"body-0\":\"Hey, how's the project going?\","
    & "\"sender-0\":\"Alice\","
    & "\"time-0\":\"2:30 PM\","
    & "\"mine-0\":\"0\","
    & "\"body-1\":\"Going well! Just passed all the gates.\","
    & "\"sender-1\":\"" & sample-user-name & "\","
    & "\"time-1\":\"2:32 PM\","
    & "\"mine-1\":\"1\","
    & "\"body-2\":\"Nice work. Want to review together?\","
    & "\"sender-2\":\"Alice\","
    & "\"time-2\":\"2:40 PM\","
    & "\"mine-2\":\"0\","
    & "\"body-3\":\"See you tomorrow!\","
    & "\"sender-3\":\"Alice\","
    & "\"time-3\":\"2:45 PM\","
    & "\"mine-3\":\"0\"}"

Section: Contacts

  handle-contacts : Text -> Text
  handle-contacts (path) =
    "{\"count\":\"4\","
    & "\"name-0\":\"Alice\","
    & "\"name-1\":\"Bob\","
    & "\"name-2\":\"Carol\","
    & "\"name-3\":\"Dave\"}"

Section: Send and Start

  handle-send : Text -> Text
  handle-send (path) =
    "{\"ok\":\"1\"}"

  handle-start-conv : Text -> Text
  handle-start-conv (path) =
    "{\"ok\":\"1\",\"conv-id\":\"conv-new\"}"

Section: Helpers

  json-error : Text -> Text
  json-error (msg) = "{\"error\":\"" & msg & "\"}"

Section: Entry

  opening : [Console] Integer
  opening = act
    print-line "ChatServer starting..."
    print-line "Listening on /api/chat/*"
    print-line ("Sample user: " & sample-user-name)
    print-line "Routes: register, me, conversations, messages, contacts, send, start"
    print-line "ChatServer ready."
    let status = 0
    in status
  end

