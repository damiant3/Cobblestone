 We say:

Section: Chat Dark Theme

  chat-palette : Palette
  chat-palette = Palette {
    pal-bg = #111111, pal-fg = #D8D8D8,
    pal-primary = #3CB371, pal-secondary = #1B1B1B,
    pal-accent = #3CB371, pal-muted = #777777,
    pal-error = #EC4D30, pal-success = #41AF4E,
    pal-warning = #EF9B01, pal-border = #262626
  }

  chat-theme : Theme
  chat-theme =
    let p = chat-palette
    in let b1 = bdr 1 (p.pal-border) CornerSharp
    in let pad = exy 12 8
    in let mar = eu 0
    in let base = ws (p.pal-bg) (p.pal-fg) bn pad ez
    in let btn-n = ws (p.pal-primary) #FFFFFF (bdr 0 0 (CornerRound 20)) (exy 20 10) mar
    in let btn-h = ws #35BB33 #FFFFFF (bdr 0 0 (CornerRound 20)) (exy 20 10) mar
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws #202020 (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 20)) (exy 16 10) mar
    in let inp-f = ws #202020 (p.pal-fg) (bdr 2 (p.pal-primary) (CornerRound 20)) (exy 16 10) mar
    in let sep = ws (p.pal-border) (p.pal-border) bn ez (exy 0 4)
    in Theme {
      th-name = "chat-dark",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = ws (p.pal-muted) (p.pal-muted) bn pad mar, ss-focused = inp-f },
      th-gauge = ss-flat (ws (p.pal-bg) (p.pal-primary) b1 (eu 2) mar),
      th-separator = ss-flat sep
    }

Section: Extra DOM Stubs

  dom-set-value : DomElement, Text -> DomElement
  dom-set-value (el) (v) = el
  dom-remove : DomElement -> DomElement
  dom-remove (el) = el
  dom-add-class : DomElement, Text -> DomElement
  dom-add-class (el) (c) = el
  dom-remove-class : DomElement, Text -> DomElement
  dom-remove-class (el) (c) = el
  dom-set-style : DomElement, Text, Text -> DomElement
  dom-set-style (el) (k) (v) = el
  dom-set-attr : DomElement, Text, Text -> DomElement
  dom-set-attr (el) (k) (v) = el
  dom-body : DomElement
  dom-body = dom-null
Section: CSS

  css-app : Text
  css-app =
    "*{margin:0;padding:0;box-sizing:border-box}"
    & "html,body{height:100%;overflow:hidden}"
    & "body{background:#111111;color:#d8d8d8;font-family:-apple-system,'Segoe UI',system-ui,sans-serif}"
    & "#app{display:flex;height:100vh}"

  css-sidebar : Text
  css-sidebar =
    ".sidebar{width:340px;background:#1b1b1b;border-right:1px solid #262626;display:flex;flex-direction:column;flex-shrink:0}"
    & ".sidebar-hdr{padding:16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #262626}"
    & ".sidebar-hdr h1{font-size:18px;font-weight:600;color:#d8d8d8}"
    & ".sidebar-search{padding:8px 12px}"
    & ".sidebar-search input{width:100%;background:#262626;border:none;border-radius:20px;padding:8px 16px;color:#d8d8d8;font-size:14px;outline:none}"
    & ".sidebar-search input:focus{background:#303030}"
    & ".conv-list{flex:1;overflow-y:auto}"
    & ".conv-item{display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #1f1f1f;transition:background .15s}"
    & ".conv-item:hover,.conv-item.active{background:#262626}"
    & ".conv-avatar{width:48px;height:48px;border-radius:50%;background:#3c8c5f;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:bold;color:#fff;flex-shrink:0}"
    & ".conv-info{flex:1;min-width:0}"
    & ".conv-name{font-size:14px;font-weight:600;color:#d8d8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".conv-preview{font-size:12px;color:#777;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}"
    & ".conv-meta{text-align:right;flex-shrink:0}"
    & ".conv-time{font-size:11px;color:#666}"
    & ".conv-badge{background:#3c8c5f;color:#fff;font-size:10px;font-weight:bold;border-radius:10px;padding:1px 6px;margin-top:4px;display:inline-block}"

  css-chat : Text
  css-chat =
    ".chat-area{flex:1;display:flex;flex-direction:column;background:#111111}"
    & ".chat-hdr{padding:12px 20px;display:flex;align-items:center;gap:12px;background:#1b1b1b;border-bottom:1px solid #262626}"
    & ".chat-hdr-avatar{width:40px;height:40px;border-radius:50%;background:#3c8c5f;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:bold;color:#fff}"
    & ".chat-hdr-info{flex:1}"
    & ".chat-hdr-name{font-size:15px;font-weight:600}"
    & ".chat-hdr-status{font-size:12px;color:#777}"
    & ".chat-hdr-actions{display:flex;gap:8px}"
    & ".chat-hdr-actions button{background:none;border:none;color:#777;font-size:20px;cursor:pointer;padding:6px 10px;border-radius:50%;transition:background .15s}"
    & ".chat-hdr-actions button:hover{background:#262626;color:#d8d8d8}"
    & ".messages{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:4px}"
    & ".msg-row{display:flex;align-items:flex-end;gap:8px;max-width:75%}"
    & ".msg-row.sent{align-self:flex-end;flex-direction:row-reverse}"
    & ".msg-row.recv{align-self:flex-start}"
    & ".msg-bubble{padding:8px 14px;border-radius:16px;font-size:14px;line-height:1.45;word-wrap:break-word;max-width:100%}"
    & ".msg-row.sent .msg-bubble{background:#3c8c5f;color:#fff;border-bottom-right-radius:4px}"
    & ".msg-row.recv .msg-bubble{background:#262626;color:#d8d8d8;border-bottom-left-radius:4px}"
    & ".msg-time{font-size:10px;color:#555;margin-top:2px;padding:0 4px}"
    & ".msg-row.sent .msg-time{text-align:right}"
    & ".msg-date-sep{text-align:center;color:#555;font-size:11px;padding:16px 0 8px;font-weight:600}"
    & ".msg-group-name{font-size:11px;color:#3c8c5f;padding:0 14px 2px;font-weight:600}"
    & ".msg-encrypt{text-align:center;color:#555;font-size:11px;padding:8px;background:#1a1a1a;border-radius:8px;margin:8px auto;max-width:350px}"
    & ".msg-encrypt::before{content:'\\1F512 '}"

  css-compose : Text
  css-compose =
    ".compose{padding:12px 20px;background:#1b1b1b;border-top:1px solid #262626;display:flex;align-items:center;gap:10px}"
    & ".compose input{flex:1;background:#262626;border:none;border-radius:20px;padding:10px 18px;color:#d8d8d8;font-size:14px;outline:none}"
    & ".compose input:focus{background:#303030}"
    & ".compose button{background:#3c8c5f;border:none;color:#fff;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:background .15s}"
    & ".compose button:hover{background:#4da870}"
    & ".attach-btn{background:none !important;color:#777 !important;font-size:22px !important}"
    & ".attach-btn:hover{color:#aaa !important}"

  css-empty-state : Text
  css-empty-state =
    ".empty-chat{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#555}"
    & ".empty-chat .icon{font-size:64px;margin-bottom:16px;opacity:.5}"
    & ".empty-chat h2{font-size:20px;color:#888;margin-bottom:8px}"
    & ".empty-chat p{font-size:14px;color:#555;max-width:300px;text-align:center;line-height:1.6}"

  css-nav : Text
  css-nav =
    ".nav-tabs{display:flex;border-top:1px solid #262626;background:#1b1b1b}"
    & ".nav-tab{flex:1;padding:10px 0;text-align:center;color:#666;font-size:20px;cursor:pointer;transition:color .15s;border:none;background:none}"
    & ".nav-tab:hover{color:#aaa}"
    & ".nav-tab.active{color:#3c8c5f}"

  css-contacts : Text
  css-contacts =
    ".contact-item{display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;transition:background .15s}"
    & ".contact-item:hover{background:#262626}"
    & ".contact-status{width:10px;height:10px;border-radius:50%;flex-shrink:0}"
    & ".contact-status.online{background:#3c8c5f}"
    & ".contact-status.offline{background:#555}"

  css-call : Text
  css-call =
    ".call-screen{position:fixed;inset:0;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:100}"
    & ".call-avatar{width:120px;height:120px;border-radius:50%;background:#3c8c5f;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:bold;color:#fff;margin-bottom:24px}"
    & ".call-name{font-size:24px;font-weight:600;color:#d8d8d8;margin-bottom:8px}"
    & ".call-status{font-size:14px;color:#777;margin-bottom:40px}"
    & ".call-actions{display:flex;gap:24px}"
    & ".call-btn{width:56px;height:56px;border-radius:50%;border:none;color:#fff;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .15s}"
    & ".call-btn:hover{transform:scale(1.1)}"
    & ".call-btn.end{background:#e74c3c}"
    & ".call-btn.mute{background:#555}"
    & ".call-btn.video{background:#555}"
    & ".call-btn.accept{background:#3c8c5f}"
    & ".call-video{position:fixed;inset:0;background:#000;z-index:99}"
    & ".call-video video{width:100%;height:100%;object-fit:cover}"
    & ".call-video .self-view{position:absolute;bottom:20px;right:20px;width:160px;height:120px;border-radius:12px;overflow:hidden;border:2px solid #3c8c5f}"

  css-settings : Text
  css-settings =
    ".settings-section{padding:16px;border-bottom:1px solid #262626}"
    & ".settings-title{font-size:13px;color:#777;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px}"
    & ".settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0}"
    & ".settings-row label{font-size:14px;color:#d8d8d8}"
    & ".settings-fingerprint{font-family:monospace;font-size:12px;color:#3c8c5f;word-break:break-all;padding:8px;background:#1a1a1a;border-radius:8px;margin-top:8px}"

  css-modal : Text
  css-modal =
    ".modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:200}"
    & ".modal{background:#1b1b1b;border-radius:12px;padding:24px;max-width:400px;width:90%;border:1px solid #262626}"
    & ".modal h2{font-size:18px;font-weight:600;margin-bottom:16px;color:#d8d8d8}"
    & ".modal input{width:100%;background:#262626;border:1px solid #333;border-radius:8px;padding:10px 14px;color:#d8d8d8;font-size:14px;margin-bottom:12px;outline:none}"
    & ".modal input:focus{border-color:#3c8c5f}"
    & ".modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}"
    & ".modal-actions button{padding:8px 20px;border-radius:20px;border:none;cursor:pointer;font-size:14px}"
    & ".modal-actions .primary{background:#3c8c5f;color:#fff}"
    & ".modal-actions .secondary{background:#333;color:#d8d8d8}"

  css-dialog : Text
  css-dialog =
    "dialog.wk-dialog{background:#1b1b1b;color:#d8d8d8;border:1px solid #333;border-radius:12px;padding:24px;max-width:400px;width:90%}"
    & "dialog.wk-dialog::backdrop{background:rgba(0,0,0,.7)}"
    & "dialog.wk-dialog h3{font-size:18px;margin-bottom:8px}"
    & "dialog.wk-dialog p{font-size:14px;color:#999;margin-bottom:16px}"
    & "dialog.wk-dialog input{width:100%;background:#262626;border:1px solid #333;border-radius:8px;padding:10px 14px;color:#d8d8d8;font-size:14px;outline:none;margin-bottom:8px}"
    & "dialog.wk-dialog input:focus{border-color:#3c8c5f}"
    & "dialog.wk-dialog .wk-row{display:flex}"
    & "dialog.wk-dialog .wk-btn{padding:8px 20px;border-radius:20px;border:none;cursor:pointer;font-size:14px;background:#3c8c5f;color:#fff;margin-left:8px}"
    & "dialog.wk-dialog .wk-btn:first-child{background:#333;color:#d8d8d8}"

  css-extra : Text
  css-extra =
    ".brand{font-size:18px;font-weight:600;color:#d8d8d8}"
    & ".brand .wk-lbl{font-size:18px;font-weight:600}"
    & ".sidebar-hdr .wk-btn{background:#262626;color:#d8d8d8;border:none;width:36px;height:36px;border-radius:50%;font-size:20px;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center}"
    & ".sidebar-hdr .wk-btn:hover{background:#333}"
    & ".nav-tabs .wk-btn{flex:1;background:none;border:none;color:#666;font-size:20px;padding:10px 0;cursor:pointer;border-radius:0}"
    & ".nav-tabs .wk-btn:hover{color:#aaa}"
    & ".nav-tabs .wk-btn[data-state='2']{color:#3c8c5f}"
    & ".chat-hdr-actions .wk-btn{background:none;border:none;color:#777;font-size:18px;cursor:pointer;padding:6px 10px;border-radius:50%}"
    & ".chat-hdr-actions .wk-btn:hover{background:#262626;color:#d8d8d8}"
    & ".compose .wk-btn{background:#3c8c5f;border:none;color:#fff;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0}"
    & ".compose .wk-btn:hover{background:#4da870}"
    & ".empty-chat .icon .wk-lbl{font-size:64px}"
    & ".msg-encrypt .wk-lbl{color:#555;font-size:11px}"
    & ".call-actions .wk-btn{width:56px;height:56px;border-radius:50%;border:none;color:#fff;font-size:22px;cursor:pointer}"
    & "#call-mute{background:#555}#call-end{background:#e74c3c}#call-vid{background:#555}"
    & ".conv-preview .wk-lbl{color:#777;font-size:12px}"
    & ".conv-name .wk-lbl{font-size:14px;font-weight:600}"
    & ".conv-time .wk-lbl{font-size:11px;color:#666}"
    & ".settings-section .wk-lbl{display:block;margin-bottom:4px}"
    & "input#msg-input{flex:1;background:#262626;border:none;border-radius:20px;padding:10px 18px;color:#d8d8d8;font-size:14px;outline:none}"
    & "input#msg-input:focus{background:#303030}"

  chat-layout-css : Text
  chat-layout-css =
    css-app & css-sidebar & css-chat & css-compose
    & css-empty-state & css-nav & css-contacts & css-call
    & css-settings & css-modal & css-dialog & css-extra

  init-chat-theme : Integer -> Integer
  init-chat-theme (x) =
    let t = inject-theme-css chat-theme
    in let style = dom-create "style"
    in let s2 = dom-set-text style chat-layout-css
    in let head = dom-query "head"
    in let h2 = dom-append head style
    in 0

