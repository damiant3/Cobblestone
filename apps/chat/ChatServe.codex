Section: The Host's Facts

  chat-tick-count-addr : Integer = 28672

  chat-uptime-seconds : Integer -> Integer
  chat-uptime-seconds (x) =
    let a = chat-tick-count-addr
    in let ticks = peek-byte a 0 + bit-shl (peek-byte a 1) 8 + bit-shl (peek-byte a 2) 16 + bit-shl (peek-byte a 3) 24
    in (ticks * pit-count) / pit-input-hz

  chat-two-digits : Integer -> Text
  chat-two-digits (n) = if n < 10 then "0" & show n else show n

  chat-clock : Integer -> Text
  chat-clock (x) =
    let s = chat-uptime-seconds 0
    in let h = s / 3600
    in let m = s / 60
    in chat-two-digits (h - (h / 24) * 24) & ":" & chat-two-digits (m - (m / 60) * 60)

  chat-hex-word : Integer, Integer, Text -> Text
  chat-hex-word (w) (k) (acc) =
    if k < 0 then acc
    else chat-hex-word w (k - 1) (acc & char-to-text (char-at "0123456789abcdef" (bit-and (bit-shr w (k * 4)) 15)))

  chat-fresh-token : Integer -> Text
  chat-fresh-token (x) =
    when hardware-random-words 1
      is Just (ws) -> if list-length ws > 0 then chat-hex-word (list-at ws 0) 15 "" else ""
      is None -> ""

Section: Answering

  ChatAnswer = record {
   an-state : ChatState,
   an-resp : HttpResponse
  }

  chat-page-path : Text = "CHAT.HTM"

  chat-page-bytes : [Device.Block] List Integer
  chat-page-bytes = act
    vol <- fat16-boot-volume
    when fat16-read-bytes vol chat-page-path
      is Just (bs) -> http-encode-binary (HttpBinaryResponse { status = http-200, content-type = "text/html; charset=utf-8", body-bytes = bs, body-length = list-length bs })
      is None -> http-encode (HttpResponse { status = http-404, content-type = "text/plain", body = "no page on this disk: CHAT.HTM" })
  end

  chat-is-page : Text -> Boolean
  chat-is-page (p) = p == "/" | p == "/chat.html"

  chat-changes : Text -> Boolean
  chat-changes (p) =
    p == "/api/chat/register" | p == "/api/chat/send" | p == "/api/chat/start" | p == "/api/chat/group"

  chat-answer : ChatState, HttpRequest -> [FileSystem.Read, FileSystem.Write] ChatAnswer
  chat-answer (st) (req) =
    let p = chat-path-only (req.path)
    in let tok = chat-fresh-token 0
    in if p == "/api/chat/register" & text-length tok == 0 then
      ChatAnswer { an-state = st, an-resp = chat-error "no random number generator to make a token" }
    else let mark = chat-store-mark st
    in let (st2, resp) = chat-route st (ChatHost { ch-time = chat-clock 0, ch-token = tok }) req
    in if chat-changes p then act
      saved <- chat-store-save mark st2
      if saved then ChatAnswer { an-state = st2, an-resp = resp }
      else act
        back <- chat-store-load
        ChatAnswer { an-state = back.sl-state, an-resp = chat-error "the disk refused the write" }
      end
    end
    else ChatAnswer { an-state = st2, an-resp = resp }

Section: Event Streams

  chat-events-path : Text = "/api/chat/events"

  chat-stream-head : List Integer
  chat-stream-head =
    http-text-to-ascii "HTTP/1.0 200 OK" & [13, 10]
    & http-text-to-ascii "Content-Type: text/event-stream" & [13, 10]
    & http-text-to-ascii "Cache-Control: no-cache" & [13, 10]
    & [13, 10]
    & http-text-to-ascii ": open" & [10, 10]

  chat-changed-frame : List Integer
  chat-changed-frame = http-text-to-ascii "data: changed" & [10, 10]

  chat-ping-frame : List Integer
  chat-ping-frame = http-text-to-ascii ": ping" & [10, 10]

  chat-ip-int : List Integer -> Integer
  chat-ip-int (ip) =
    bit-shl (list-at ip 0) 24 + bit-shl (list-at ip 1) 16 + bit-shl (list-at ip 2) 8 + list-at ip 3

  chat-conn-key : TcpTransportState -> Integer
  chat-conn-key (ts) =
    let c = (ts.session).conn
    in chat-ip-int (c.remote-ip) * 65536 + c.remote-port

  chat-has-key : List Integer, Integer, Integer -> Boolean
  chat-has-key (keys) (k) (i) =
    if i >= list-length keys then False
    else if list-at keys i == k then True
    else chat-has-key keys k (i + 1)

  chat-conns-have-key : List WebConn, Integer, Integer -> Boolean
  chat-conns-have-key (conns) (k) (i) =
    if i >= list-length conns then False
    else if chat-conn-key ((list-at conns i).transport) == k then True
    else chat-conns-have-key conns k (i + 1)

  chat-live-keys : List Integer, List WebConn, Integer, List Integer -> List Integer
  chat-live-keys (keys) (conns) (i) (acc) =
    if i >= list-length keys then acc
    else let k = list-at keys i
    in chat-live-keys keys conns (i + 1) (if chat-conns-have-key conns k 0 then list-push acc k else acc)

Section: The Chat Mux

  ChatMux = record {
    cm-mux : WebMux,
    cm-state : ChatState,
    cm-streams : List Integer,
    cm-page : List Integer,
    cm-changed : Boolean
  }

  chat-with-mux : ChatMux, WebMux -> ChatMux
  chat-with-mux (cm) (m) = ChatMux { cm-mux = m, cm-state = cm.cm-state, cm-streams = cm.cm-streams, cm-page = cm.cm-page, cm-changed = cm.cm-changed }

  chat-mux-set-conn : WebMux, Integer, TcpTransportState, WebState, List Integer, Integer -> WebMux
  chat-mux-set-conn (m) (idx) (ts) (srv) (pending) (served) =
    WebMux { listen = m.listen, conns = list-set-at (m.conns) idx (WebConn { transport = ts, server = srv, pending = pending, idle = 0 }), served = served }

  chat-mux-drop : ChatMux, Integer -> ChatMux
  chat-mux-drop (cm) (idx) =
    let m = cm.cm-mux
    in let m2 = WebMux { listen = m.listen, conns = web-mux-remove (m.conns) idx 0 [], served = m.served }
    in ChatMux { cm-mux = m2, cm-state = cm.cm-state, cm-streams = chat-live-keys (cm.cm-streams) (m2.conns) 0 [], cm-page = cm.cm-page, cm-changed = cm.cm-changed }

  chat-push : ChatMux, List Integer, Integer -> [Network.Read, Network.Write] ChatMux
  chat-push (cm) (bytes) (i) =
    let m = cm.cm-mux
    in if i >= list-length (m.conns) then cm
    else let c = list-at (m.conns) i
    in if chat-has-key (cm.cm-streams) (chat-conn-key (c.transport)) 0 == False then chat-push cm bytes (i + 1)
    else act
      sent <- net-io-send-raw-checked (c.transport) bytes
      if sent.ns-complete then
        chat-push (chat-with-mux cm (chat-mux-set-conn m i (web-mux-settle (sent.ns-transport)) (c.server) [] (m.served))) bytes (i + 1)
      else act
        closed <- flush-transport-outbox (transport-close (web-mux-settle (sent.ns-transport)))
        chat-push (chat-mux-drop cm i) bytes i
      end
    end

  chat-mux-announce : ChatMux -> [Network.Read, Network.Write] ChatMux
  chat-mux-announce (cm) =
    if cm.cm-changed then act
      pushed <- chat-push cm chat-changed-frame 0
      ChatMux { cm-mux = pushed.cm-mux, cm-state = pushed.cm-state, cm-streams = pushed.cm-streams, cm-page = pushed.cm-page, cm-changed = False }
    end
    else cm

  chat-open-stream : ChatMux, Integer, TcpTransportState, WebState -> [Network.Read, Network.Write] ChatMux
  chat-open-stream (cm) (idx) (ts) (srv) =
    let m = cm.cm-mux
    in act
      sent <- net-io-send-raw-checked ts chat-stream-head
      if sent.ns-complete then
        let settled = web-mux-settle (sent.ns-transport)
        in ChatMux { cm-mux = chat-mux-set-conn m idx settled srv [] (m.served + 1), cm-state = cm.cm-state, cm-streams = list-push (cm.cm-streams) (chat-conn-key settled), cm-page = cm.cm-page, cm-changed = cm.cm-changed }
      else act
        closed <- flush-transport-outbox (transport-close (web-mux-settle (sent.ns-transport)))
        chat-mux-drop cm idx
      end
    end

  chat-mux-drain : ChatMux, Integer, TcpTransportState, WebState, List Integer -> [Console, Network.Read, Network.Write, FileSystem.Read, FileSystem.Write] ChatMux
  chat-mux-drain (cm) (idx) (ts) (srv) (pending) =
    let m = cm.cm-mux
    in let plen = list-length pending
    in let total = wb-request-total pending plen
    in if total < 0 then
      if web-mux-pending-held m idx 0 plen > web-mux-pending-budget then act
        refused <- web-mux-refuse m idx ts
        chat-with-mux cm refused
      end
      else chat-with-mux cm (chat-mux-set-conn m idx ts srv pending (m.served))
    else let req = http-parse-request (wb-slice pending 0 total [])
    in let rest = wb-slice pending total plen []
    in let p = chat-path-only (req.path)
    in if p == chat-events-path then act
      print-line-uni ("stream opened, " & show (list-length (cm.cm-streams) + 1) & " open")
      chat-open-stream cm idx ts srv
    end
    else if chat-is-page p then chat-mux-reply cm idx ts srv rest (cm.cm-page) (cm.cm-state) False p
    else act
      answer <- chat-answer (cm.cm-state) req
      chat-mux-reply cm idx ts srv rest (http-encode (answer.an-resp)) (answer.an-state) (chat-changes p) p
    end

  chat-mux-reply : ChatMux, Integer, TcpTransportState, WebState, List Integer, List Integer, ChatState, Boolean, Text -> [Console, Network.Read, Network.Write, FileSystem.Read, FileSystem.Write] ChatMux
  chat-mux-reply (cm) (idx) (ts) (srv) (rest) (bytes) (st) (changed) (p) =
    let m = cm.cm-mux
    in act
      sent <- net-io-send-raw-checked ts bytes
      print-line-uni (p & " " & show (sent.ns-sent) & " bytes" & (if sent.ns-complete then "" else " (incomplete)"))
      ts2 <- if sent.ns-complete then sent.ns-transport else net-io-close (sent.ns-transport)
      let cm2 = ChatMux { cm-mux = WebMux { listen = m.listen, conns = m.conns, served = m.served + 1 }, cm-state = st, cm-streams = cm.cm-streams, cm-page = cm.cm-page, cm-changed = cm.cm-changed | changed }
      in chat-mux-drain cm2 idx (web-mux-settle ts2) srv (rest & web-mux-fed ts2)
    end

  chat-mux-serve : ChatMux, Integer, List Integer, Integer -> [Console, Network.Read, Network.Write, FileSystem.Read, FileSystem.Write] ChatMux
  chat-mux-serve (cm) (idx) (frame) (stop) =
    let m = cm.cm-mux
    in let c = list-at (m.conns) idx
    in let r = net-process-frame-within ((c.transport).session) frame stop
    in let ts1 = transport-set-session (c.transport) (r.session)
    in act
      ts2 <- flush-transport-outbox ts1
      if web-conn-closing ts2 then act
        ts3 <- flush-transport-outbox (transport-close ts2)
        chat-mux-drop cm idx
      end
      else
        chat-mux-drain cm idx ts2 (c.server) ((c.pending) & (transport-slice (r.data) (r.data-off) (r.data-stop)))
    end

  chat-mux-accept : ChatMux, List Integer, Integer, Integer -> [Network.Read, Network.Write] ChatMux
  chat-mux-accept (cm) (frame) (stop) (port) =
    let m = cm.cm-mux
    in if list-length (m.conns) >= web-mux-max-conns then cm
    else act
      m1 <- web-mux-accept-configured m frame stop port [0, 0, 0, 0]
      chat-with-mux cm m1
    end

  chat-mux-feed : ChatMux, List Integer, Integer, Integer -> [Console, Network.Read, Network.Write, FileSystem.Read, FileSystem.Write] ChatMux
  chat-mux-feed (cm) (frame) (stop) (port) =
    let m = cm.cm-mux
    in if eth-ethertype-within frame stop == eth-type-arp then
      let r = net-process-frame-within ((m.listen).session) frame stop
      in act
        ts <- flush-transport-outbox (transport-set-session (m.listen) (r.session))
        chat-with-mux cm (WebMux { listen = ts, conns = m.conns, served = m.served })
      end
    else if web-frame-valid frame stop == False then cm
    else if ip-equal (ip-dst-at frame eth-header-size) (((m.listen).session).local-ip) == False then cm
    else let seg = frame-seg-within frame stop
    in let owner = web-mux-owner-from (m.conns) seg (ip-src-at frame eth-header-size) 0
    in if owner >= 0 then chat-mux-serve cm owner frame stop
    else if seg.dst-port == port then
      if tcp-has-flag seg tcp-flag-syn then chat-mux-accept cm frame stop port
      else cm
    else cm

  chat-mux-sweep : ChatMux -> [Network.Read, Network.Write] ChatMux
  chat-mux-sweep (cm) = act
    pinged <- chat-push cm chat-ping-frame 0
    m1 <- web-mux-sweep (pinged.cm-mux) 0
    ChatMux { cm-mux = m1, cm-state = pinged.cm-state, cm-streams = chat-live-keys (pinged.cm-streams) (m1.conns) 0 [], cm-page = pinged.cm-page, cm-changed = pinged.cm-changed }
  end

  chat-mux-compact : ChatMux, Integer, Integer -> [FileSystem.Read, FileSystem.Write] ChatMux
  chat-mux-compact (cm) (set) (mark) =
    if __heap-save - mark <= net-compact-bytes then cm
    else let h0 = __heap-save
    in let probe = nc-webmux (cm.cm-mux)
    in let probe-keys = nc-ints (cm.cm-streams)
    in let size = __heap-save - h0
    in if size > net-arena-bytes then let dropped = __heap-restore h0 in cm
    else let target = nc-set-target set
    in let into = __heap-restore (nc-arena-at set target)
    in let copy = nc-webmux (cm.cm-mux)
    in let keys = nc-ints (cm.cm-streams)
    in let back = __heap-restore mark
    in let committed = nc-set-commit set target
    in act
      loaded <- chat-store-load
      ChatMux { cm-mux = copy, cm-state = loaded.sl-state, cm-streams = keys, cm-page = cm.cm-page, cm-changed = False }
    end

  chat-mux-run : ChatMux, Integer, Integer, Integer, List Integer, Integer, Integer -> [Console, Network.Read, Network.Write, FileSystem.Read, FileSystem.Write] Integer
  chat-mux-run (cm) (port) (tries) (since) (rx) (set) (mark) =
    if list-length rx == 0 then let s = nc-set-acquire (nc-pool-cell process-get-pid)
    in let send-set = nc-set-release (nc-set-acquire (nc-pool-cell process-get-pid))
    in let rx1 = net-io-rx rx
    in let mk = __heap-save
    in chat-mux-run cm port tries since rx1 s mk
    else if since >= web-sweep-interval then act
      cm1 <- chat-mux-sweep cm
      cm2 <- chat-mux-compact cm1 set mark
      chat-mux-run cm2 port (tries + 1) 0 rx set mark
    end
    else let hp = __heap-save
    in act
      n <- net-driver-recv-into rx
      if n == 0 then let restored = __heap-restore hp
      in let y = process-yield
      in let w = web-idle-wait tries
      in chat-mux-run cm port (tries + 1 + w) (since + 1 + w) rx set mark
      else act
        cm1 <- chat-mux-feed cm rx n port
        cm2 <- chat-mux-announce cm1
        cm3 <- chat-mux-compact cm2 set mark
        chat-mux-run cm3 port 0 (since + 1) rx set mark
      end
    end

Section: Entry

  chat-port : Integer = 9200

  opening : [Console, Network.Read, Network.Write, Device.Block, FileSystem.Read, FileSystem.Write] Nothing
  opening = act
    loaded <- chat-store-load
    if text-length (loaded.sl-problem) > 0 then print-line-uni ("codex-chat: not serving: " & loaded.sl-problem)
    else chat-serve-from (loaded.sl-state)
  end

  chat-serve-from : ChatState -> [Console, Network.Read, Network.Write, Device.Block, FileSystem.Read, FileSystem.Write] Nothing
  chat-serve-from (st) = act
    page <- chat-page-bytes
    print-line-uni ("codex-chat: " & show (list-length (st.cs-accounts)) & " names claimed, " & show (list-length (st.cs-convs)) & " conversations; page " & show (list-length page) & " bytes; listening on guest port " & show chat-port)
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport chat-port), conns = [], served = 0 }
    in act
      served <- chat-mux-run (ChatMux { cm-mux = m0, cm-state = st, cm-streams = [], cm-page = page, cm-changed = False }) chat-port 0 0 [] 0 0
      print-line-uni ("codex-chat closed after " & show served)
    end
  end
