Chapter: PublisherPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Content creator toolkit for writing, formatting, and publishing articles and posts.

 We say:

Section: Theme

  publisher-theme : Theme
  publisher-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 5285823, pal-secondary = 1447446, pal-accent = 5285823, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "publisher-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  publisher-css : Text
  publisher-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0f0f0f;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".publisher{display:grid;grid-template-columns:240px 1fr 280px;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;color:#50a0ff}"
    & ".nav-item{padding:10px 20px;cursor:pointer;font-size:13px;color:#999;transition:background .1s;display:flex;align-items:center;gap:10px}"
    & ".nav-item:hover{background:#1a1a1a;color:#ddd}"
    & ".nav-item.active{color:#50a0ff;background:#0a1a2a}"
    & ".nav-sep{height:1px;background:#222;margin:8px 20px}"
    & ".post-list-title{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px}"
    & ".post-item{padding:10px 20px;cursor:pointer;font-size:13px;color:#888;transition:background .1s}"
    & ".post-item:hover{background:#1a1a1a;color:#ccc}"
    & ".post-item.active{color:#fff;background:#1a1a2a}"
    & ".post-status{font-size:10px;display:inline-block;padding:1px 6px;border-radius:4px;margin-left:6px}"
    & ".status-draft{background:#333;color:#888}"
    & ".status-published{background:#0a2a0a;color:#4a8}"
    & ".status-scheduled{background:#2a2a0a;color:#aa8}"
    & ".editor{display:flex;flex-direction:column;overflow-y:auto}"
    & ".editor-toolbar{display:flex;align-items:center;gap:4px;padding:8px 16px;border-bottom:1px solid #222;background:#141414;flex-wrap:wrap}"
    & ".editor-toolbar .wk-btn{background:none;border:none;color:#888;padding:6px 10px;cursor:pointer;border-radius:4px;font-size:13px}"
    & ".editor-toolbar .wk-btn:hover{background:#222;color:#ddd}"
    & ".editor-sep{width:1px;height:20px;background:#333}"
    & ".editor-body{flex:1;padding:32px;max-width:720px;margin:0 auto;width:100%}"
    & ".editor-title{font-size:32px;font-weight:700;color:#fff;border:none;background:none;width:100%;margin-bottom:8px;outline:none;font-family:system-ui,sans-serif}"
    & ".editor-subtitle{font-size:18px;color:#666;border:none;background:none;width:100%;margin-bottom:24px;outline:none}"
    & ".editor-content{font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.9;color:#ccc;min-height:400px}"
    & ".editor-content p{margin-bottom:16px}"
    & ".editor-content h2{font-size:22px;font-weight:700;color:#fff;margin:32px 0 16px;font-family:system-ui,sans-serif}"
    & ".editor-content blockquote{border-left:3px solid #50a0ff;padding-left:16px;color:#999;font-style:italic;margin:16px 0}"
    & ".editor-content code{background:#1a1a2a;padding:2px 6px;border-radius:4px;font-family:'Fira Code',monospace;font-size:15px;color:#a0c0ff}"
    & ".panel{background:#141414;border-left:1px solid #222;padding:16px;overflow-y:auto}"
    & ".panel-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".panel-group{margin-bottom:20px}"
    & ".panel-label{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}"
    & ".panel-value{font-size:13px;color:#ccc;margin-bottom:8px}"
    & ".panel-input{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 10px;color:#ccc;font-size:12px;width:100%;margin-bottom:8px}"
    & ".tag{display:inline-block;background:#1a1a2a;color:#7799cc;padding:2px 8px;border-radius:4px;font-size:11px;margin-right:4px;margin-bottom:4px}"
    & ".publish-btn{width:100%;background:#50a0ff;color:#fff;border:none;padding:10px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-top:12px}"
    & ".publish-btn:hover{background:#4090ee}"
    & ".stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}"
    & ".stat-card{background:#1a1a1a;border-radius:8px;padding:10px;text-align:center}"
    & ".stat-val{font-size:18px;font-weight:700;color:#fff}"
    & ".stat-lbl{font-size:10px;color:#555;text-transform:uppercase;margin-top:2px}"
    & ".preview-body{padding:32px;max-width:720px;margin:0 auto;width:100%;font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.9;color:#ccc}"
    & ".preview-title{font-size:32px;font-weight:700;color:#fff;margin-bottom:8px;font-family:system-ui,sans-serif}"
    & ".preview-sub{font-size:18px;color:#666;margin-bottom:24px}"
    & ".preview-text{white-space:pre-wrap}"
    & ".auto-save{font-size:11px;color:#4a8;padding:4px 0}"
    & ".rev-item{font-size:12px;color:#888;padding:6px 0;border-bottom:1px solid #1a1a1a}"
    & ".rev-ver{color:#50a0ff;font-weight:600;margin-right:8px}"
    & ".rev-date{color:#555;margin-left:8px}"
    & ".export-btns{display:flex;gap:6px;margin-top:6px}"
    & ".export-btns .wk-btn{flex:1;text-align:center;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 0;font-size:12px;color:#999;cursor:pointer}"
    & ".export-btns .wk-btn:hover{background:#222;color:#ddd}"
    & ".save-draft-btn{width:100%;background:#1a1a1a;border:1px solid #333;color:#ccc;padding:8px;border-radius:8px;font-size:13px;cursor:pointer;margin-top:8px}"
    & ".schedule-btn{width:100%;background:#2a2a0a;border:1px solid #444;color:#cc9;padding:8px;border-radius:8px;font-size:13px;cursor:pointer;margin-top:6px}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "publisher" "publisher" [
      sidebar-tree 0,
      editor-view 0,
      panel-view 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    let nav = state-get "nav"
    in let count = state-get "doc-count"
    in widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexPublisher",
      widget-box-click "nav-write" (if nav == 0 then "nav-item active" else "nav-item") [widget-label "nav-write-l" "&#x270F; Write"],
      widget-box-click "nav-posts" (if nav == 1 then "nav-item active" else "nav-item") [widget-label "nav-posts-l" "&#x1F4C4; All Posts"],
      widget-box-click "nav-media" (if nav == 2 then "nav-item active" else "nav-item") [widget-label "nav-media-l" "&#x1F5BC; Media"],
      widget-box-click "nav-analytics" (if nav == 3 then "nav-item active" else "nav-item") [widget-label "nav-analytics-l" "&#x1F4CA; Analytics"],
      widget-box-click "nav-settings" (if nav == 4 then "nav-item active" else "nav-item") [widget-label "nav-settings-l" "&#x2699; Settings"],
      widget-label "sep" "",
      widget-label "post-hdr" "Documents",
      widget-box "doc-items" "" (build-doc-list 0 count [])
    ]

  build-doc-list : Integer, Integer, List WidgetNode -> List WidgetNode
  build-doc-list (i) (count) (acc) =
    if i >= count then acc
    else let title = state-get-text ("doc-title-" & show i)
    in let status = state-get ("doc-status-" & show i)
    in let cur = state-get "current-doc"
    in let badge = if status == 1 then " &#x2022; Published" else if status == 2 then " &#x2022; Scheduled" else " &#x2022; Draft"
    in let cls = if status == 1 then "status-published" else if status == 2 then "status-scheduled" else "status-draft"
    in let item = widget-box-click ("doc-" & show i) (if cur == i then "post-item active" else "post-item") [
      widget-label ("doc-t-" & show i) title,
      widget-label ("doc-s-" & show i) badge
    ]
    in build-doc-list (i + 1) count (list-push acc item)

  tag-name : Integer -> Text
  tag-name (n) =
    if n == 0 then "codex" else if n == 1 then "compilers" else if n == 2 then "bare-metal"
    else if n == 3 then "self-hosting" else if n == 4 then "programming" else if n == 5 then "types"
    else if n == 6 then "bootstrap" else if n == 7 then "vm" else "systems"

  tag-list : Integer -> WidgetNode
  tag-list (x) =
    let tc = state-get "tag-count"
    in widget-box "tags" "" (build-tags 0 tc [])

  build-tags : Integer, Integer, List WidgetNode -> List WidgetNode
  build-tags (i) (count) (acc) =
    if i >= count then acc
    else let t = widget-label ("tag" & show i) (tag-name i)
    in build-tags (i + 1) count (list-push acc t)

  word-count-from-body : Integer -> Integer
  word-count-from-body (x) =
    let body = state-get-text "post-body"
    in let len = text-length body
    in if len == 0 then 0 else len / 5

  outline-from-body : Integer -> WidgetNode
  outline-from-body (x) =
    let title = state-get-text "post-title"
    in widget-box "outline" "" [
      widget-label "outline-hdr" "DOCUMENT OUTLINE",
      widget-label "outline-1" ("&#x2022; " & title),
      widget-label "outline-2" "&#x2022; Why Self-Hosting Matters",
      widget-label "outline-3" "&#x2022; (end)"
    ]

  editor-view : Integer -> WidgetNode
  editor-view (x) =
    let mode = state-get "edit-mode"
    in let wc = word-count-from-body 0
    in let ver = state-get "version-counter"
    in let autosave = state-get "auto-saved"
    in widget-box "editor" "editor" [
      widget-box "ed-toolbar" "editor-toolbar" [
        widget-button "ed-h1" "H1",
        widget-button "ed-h2" "H2",
        widget-button "ed-h3" "H3",
        widget-label "esep1" "",
        widget-button "ed-bold" "B",
        widget-button "ed-italic" "I",
        widget-button "ed-strike" "S",
        widget-button "ed-code" "&lt;/&gt;",
        widget-label "esep2" "",
        widget-button "ed-link" "&#x1F517;",
        widget-button "ed-img" "&#x1F5BC;",
        widget-button "ed-quote" "&#x201C;",
        widget-button "ed-list" "&#x2022;",
        widget-button "ed-olist" "1.",
        widget-label "esep3" "",
        widget-button "ed-preview" (if mode == 1 then "&#x270F; Edit" else "&#x1F441; Preview"),
        widget-button "ed-split" "Split",
        widget-label "wc-display" (show wc & " words"),
        widget-label "ver-display" ("v" & show ver),
        widget-label "autosave-ind" (if autosave == 1 then "&#x2713; Saved" else "&#x25CF; Unsaved")
      ],
      if mode == 1 then editor-preview 0 else editor-edit 0
    ]

  editor-edit : Integer -> WidgetNode
  editor-edit (x) =
    widget-box "ed-body" "editor-body" [
      wk-attach (widget-custom "ed-title" "input" 0 0) [widget-label "ed-tv" (state-get-text "post-title"), widget-label "ed-tp" "Title"] 0 2,
      wk-attach (widget-custom "ed-sub" "input" 0 0) [widget-label "ed-sv" (state-get-text "post-sub"), widget-label "ed-sp" "Subtitle"] 0 2,
      wk-attach (widget-custom "ed-content" "textarea" 0 0) [widget-label "ed-cv" (state-get-text "post-body")] 0 1
    ]

  editor-preview : Integer -> WidgetNode
  editor-preview (x) =
    widget-box "ed-body" "preview-body" [
      widget-label "prev-title" (state-get-text "post-title"),
      widget-label "prev-sub" (state-get-text "post-sub"),
      widget-label "prev-text" (state-get-text "post-body")
    ]

  panel-view : Integer -> WidgetNode
  panel-view (x) =
    let cur = state-get "current-doc"
    in let words = state-get-text ("doc-words-" & show cur)
    in let docdate = state-get-text ("doc-date-" & show cur)
    in let saved = state-get "auto-saved"
    in widget-box "panel" "panel" [
      widget-label "panel-hdr" "Post Settings",
      widget-box "save-ind" "auto-save" [
        widget-label "save-txt" (if saved == 1 then "&#x2713; Auto-saved" else "Not saved")
      ],
      widget-box "meta-group" "panel-group" [
        widget-label "slug-lbl" "SLUG",
        widget-label "slug-val" "building-with-codex",
        widget-label "date-lbl" "PUBLISH DATE",
        widget-label "date-val" docdate,
        widget-label "author-lbl" "AUTHOR",
        widget-label "author-val" "Damian Tedrow"
      ],
      outline-from-body 0,
      widget-box "tag-group" "panel-group" [
        widget-label "tag-lbl" "TAGS",
        tag-list 0,
        widget-button "btn-add-tag" "+ Add Tag",
        widget-button "btn-remove-tag" "- Remove Tag"
      ],
      widget-box "cover-group" "panel-group" [
        widget-label "cover-lbl" "COVER IMAGE",
        widget-button "btn-cover" "&#x1F5BC; Upload Cover"
      ],
      widget-box "seo-group" "panel-group" [
        widget-label "seo-lbl" "SEO DESCRIPTION",
        widget-label "seo-val" "A practical guide to the Codex self-sustaining compiler and bare-metal development."
      ],
      widget-box "stats" "stats" [
        widget-box "stat-words" "stat-card" [
          widget-label "stat-words-v" words,
          widget-label "stat-words-l" "words"
        ],
        widget-box "stat-time" "stat-card" [
          widget-label "stat-time-v" "4 min",
          widget-label "stat-time-l" "read time"
        ],
        widget-box "stat-chars" "stat-card" [
          widget-label "stat-chars-v" "4,892",
          widget-label "stat-chars-l" "characters"
        ],
        widget-box "stat-links" "stat-card" [
          widget-label "stat-links-v" "0",
          widget-label "stat-links-l" "links"
        ]
      ],
      widget-box "rev-group" "panel-group" [
        widget-label "rev-lbl" "REVISION HISTORY",
        widget-box "rev-0" "rev-item" [
          widget-label "rv0" "v3 &#x2022; Jun 18 &#x2022; Updated conclusion"
        ],
        widget-box "rev-1" "rev-item" [
          widget-label "rv1" "v2 &#x2022; Jun 17 &#x2022; Added code examples"
        ],
        widget-box "rev-2" "rev-item" [
          widget-label "rv2" "v1 &#x2022; Jun 15 &#x2022; Initial draft"
        ]
      ],
      widget-box "export-group" "panel-group" [
        widget-label "export-lbl" "EXPORT",
        widget-box "export-btns" "export-btns" [
          widget-button "btn-export-html" "HTML",
          widget-button "btn-export-pdf" "PDF",
          widget-button "btn-export-md" "Markdown"
        ]
      ],
      widget-button "btn-publish" "&#x1F680; Publish",
      widget-button "btn-save" "&#x1F4BE; Save Draft",
      widget-button "btn-schedule" "&#x1F4C5; Schedule"
    ]

Section: Sample Data

  load-sample-docs : Integer -> Integer
  load-sample-docs (x) =
    let s0 = state-set "doc-count" 6
    in let s1 = state-set "current-doc" 0
    in let s2 = state-set "edit-mode" 0
    in let s3 = state-set "auto-saved" 1
    in let s4 = state-set "nav" 0
    in let d0t = state-set-text "doc-title-0" "Building with Codex"
    in let d0s = state-set "doc-status-0" 0
    in let d0w = state-set-text "doc-words-0" "847"
    in let d0d = state-set-text "doc-date-0" "June 18, 2026"
    in let d1t = state-set-text "doc-title-1" "The Future of Compilers"
    in let d1s = state-set "doc-status-1" 0
    in let d1w = state-set-text "doc-words-1" "1,203"
    in let d1d = state-set-text "doc-date-1" "June 16, 2026"
    in let d2t = state-set-text "doc-title-2" "Bare-Metal Programming"
    in let d2s = state-set "doc-status-2" 0
    in let d2w = state-set-text "doc-words-2" "632"
    in let d2d = state-set-text "doc-date-2" "June 14, 2026"
    in let d3t = state-set-text "doc-title-3" "Why Self-Hosting Matters"
    in let d3s = state-set "doc-status-3" 1
    in let d3w = state-set-text "doc-words-3" "1,450"
    in let d3d = state-set-text "doc-date-3" "June 10, 2026"
    in let d4t = state-set-text "doc-title-4" "Dependent Types in Practice"
    in let d4s = state-set "doc-status-4" 1
    in let d4w = state-set-text "doc-words-4" "2,100"
    in let d4d = state-set-text "doc-date-4" "June 5, 2026"
    in let d5t = state-set-text "doc-title-5" "Linear Types for Safety"
    in let d5s = state-set "doc-status-5" 2
    in let d5w = state-set-text "doc-words-5" "980"
    in let d5d = state-set-text "doc-date-5" "June 20, 2026"
    in 0

Section: Handlers

  publisher-click : Text -> Integer
  publisher-click (id) =
    if id == "nav-write" then let s = state-set-render "nav" 0 in 0
    else if id == "nav-posts" then let s = state-set-render "nav" 1 in 0
    else if id == "nav-media" then let s = state-set-render "nav" 2 in 0
    else if id == "nav-analytics" then let s = state-set-render "nav" 3 in 0
    else if id == "nav-settings" then let s = state-set-render "nav" 4 in 0
    else if id == "ed-bold" then let s = state-set "last-format" 1 in 0
    else if id == "ed-italic" then let s = state-set "last-format" 2 in 0
    else if id == "ed-h1" then let s = state-set "last-format" 3 in 0
    else if id == "ed-h2" then let s = state-set "last-format" 4 in 0
    else if id == "ed-h3" then let s = state-set "last-format" 5 in 0
    else if id == "ed-link" then let s = state-set "last-format" 6 in 0
    else if id == "ed-img" then let s = state-set "last-format" 7 in 0
    else if id == "ed-quote" then let s = state-set "last-format" 8 in 0
    else if id == "ed-list" then let s = state-set "last-format" 9 in 0
    else if id == "ed-olist" then let s = state-set "last-format" 10 in 0
    else if id == "ed-strike" then let s = state-set "last-format" 11 in 0
    else if id == "ed-code" then let s = state-set "last-format" 12 in 0
    else if id == "ed-preview" then let mode = state-get "edit-mode" in let s = state-set-render "edit-mode" (if mode == 0 then 1 else 0) in 0
    else if id == "btn-save" then
      let cur = state-get "current-doc"
      in let ver = state-get "version-counter"
      in let s1 = state-set "version-counter" (ver + 1)
      in let s2 = state-set "auto-saved" 1
      in let s3 = state-set-render ("doc-status-" & show cur) 0 in 0
    else if id == "btn-publish" then
      let cur = state-get "current-doc"
      in let ver = state-get "version-counter"
      in let s1 = state-set "version-counter" (ver + 1)
      in let s2 = state-set-render ("doc-status-" & show cur) 1 in 0
    else if id == "btn-schedule" then let cur = state-get "current-doc" in let s = state-set-render ("doc-status-" & show cur) 2 in 0
    else if id == "btn-export-html" then let s = state-set "export-format" 0 in 0
    else if id == "btn-export-pdf" then let s = state-set "export-format" 1 in 0
    else if id == "btn-export-md" then let s = state-set "export-format" 2 in 0
    else if id == "btn-add-tag" then let tc = state-get "tag-count" in let s = state-set-render "tag-count" (tc + 1) in 0
    else if id == "btn-remove-tag" then let tc = state-get "tag-count" in let nt = if tc > 0 then tc - 1 else 0 in let s = state-set-render "tag-count" nt in 0
    else if id == "btn-cover" then let cur = state-get "cover-set" in let s = state-set-render "cover-set" (if cur == 1 then 0 else 1) in 0
    else if id == "ed-split" then let cur = state-get "split-mode" in let s = state-set-render "split-mode" (if cur == 1 then 0 else 1) in 0
    else if text-starts-with id "doc-" then let s = state-set-render "current-doc" (id-num id) in 0
    else 0

  publisher-input : Text, Text -> Integer
  publisher-input (id) (value) =
    if id == "ed-title" then let s = state-set-text "post-title" value in let s2 = state-set-render "auto-saved" 0 in 0
    else if id == "ed-sub" then let s = state-set-text "post-sub" value in let s2 = state-set-render "auto-saved" 0 in 0
    else if id == "ed-content" then let s = state-set-text "post-body" value in let s2 = state-set-render "auto-saved" 0 in 0
    else 0

Section: Entry

  render-publisher : Integer -> Integer
  render-publisher (x) = mount-widget-themed publisher-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style publisher-theme publisher-css
    in let d = load-sample-docs 0
    in let vc = state-set "version-counter" 3
    in let tc = state-set "tag-count" 4
    in let i1 = state-set-text "post-title" "Building with Codex"
    in let i2 = state-set-text "post-sub" "A practical guide to the self-sustaining compiler"
    in let i3 = state-set-text "post-body" "The Codex programming language represents a fundamental rethinking of how we build software. It compiles itself on bare metal with no operating system, no runtime, and no C library.\n\nWhy Self-Hosting Matters\n\nA self-hosting compiler is its own specification. When it compiles itself to a byte-identical binary, you have a fixed point: the output is the proof of correctness.\n\nThis eliminates entire categories of trust questions. The compiler stands on its own feet, and the whole environment fits in a 2 MB binary."
    in let s = set-render render-publisher
    in let h = register-handlers no-pick publisher-click
    in let hi = register-input-handler publisher-input
    in render-publisher 0
  end

Page 1
