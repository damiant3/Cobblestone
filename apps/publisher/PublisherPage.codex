 Content creator toolkit for writing, formatting, and publishing articles and posts.

 We say:

Section: Theme

  publisher-theme : Theme
  publisher-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 5285823, pal-secondary = 1447446, pal-accent = 5285823, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "publisher-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  publisher-css : Text
  publisher-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0f0f0f;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".publisher{display:grid;grid-template-columns:240px 1fr 280px;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;color:#50a0ff}"
    & ".nav-item{padding:10px 20px;cursor:pointer;font-size:13px;color:#999;transition:background .1s;display:flex;align-items:center;gap:10px}"
    & ".nav-item:hover{background:#1a1a1a;color:#ddd}"
    & ".nav-item.active{color:#50a0ff;background:#0a1a2a}"
    & ".nav-sep{height:1px;background:#222;margin:8px 20px}"
    & ".post-list-title{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px}"
    & ".post-item{padding:10px 20px;cursor:pointer;font-size:13px;color:#888;transition:background .1s}"
    & ".post-item:hover{background:#1a1a1a;color:#ccc}"
    & ".post-item.active{color:#fff;background:#1a1a2a}"
    & ".post-status{font-size:10px;display:inline-block;padding:1px 6px;border-radius:4px;margin-left:6px}"
    & ".status-draft{background:#333;color:#888}"
    & ".status-published{background:#0a2a0a;color:#4a8}"
    & ".status-scheduled{background:#2a2a0a;color:#aa8}"
    & ".editor{display:flex;flex-direction:column;overflow-y:auto}"
    & ".editor-toolbar{display:flex;align-items:center;gap:4px;padding:8px 16px;border-bottom:1px solid #222;background:#141414;flex-wrap:wrap}"
    & ".editor-toolbar .wk-btn{background:none;border:none;color:#888;padding:6px 10px;cursor:pointer;border-radius:4px;font-size:13px}"
    & ".editor-toolbar .wk-btn:hover{background:#222;color:#ddd}"
    & ".editor-sep{width:1px;height:20px;background:#333}"
    & ".editor-body{flex:1;padding:32px;max-width:720px;margin:0 auto;width:100%}"
    & ".editor-title{font-size:32px;font-weight:700;color:#fff;border:none;background:none;width:100%;margin-bottom:8px;outline:none;font-family:system-ui,sans-serif}"
    & ".editor-subtitle{font-size:18px;color:#666;border:none;background:none;width:100%;margin-bottom:24px;outline:none}"
    & ".editor-content{font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.9;color:#ccc;min-height:400px}"
    & ".editor-content p{margin-bottom:16px}"
    & ".editor-content h2{font-size:22px;font-weight:700;color:#fff;margin:32px 0 16px;font-family:system-ui,sans-serif}"
    & ".editor-content blockquote{border-left:3px solid #50a0ff;padding-left:16px;color:#999;font-style:italic;margin:16px 0}"
    & ".editor-content code{background:#1a1a2a;padding:2px 6px;border-radius:4px;font-family:'Fira Code',monospace;font-size:15px;color:#a0c0ff}"
    & ".panel{background:#141414;border-left:1px solid #222;padding:16px;overflow-y:auto}"
    & ".panel-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".panel-group{margin-bottom:20px}"
    & ".panel-label{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}"
    & ".panel-value{font-size:13px;color:#ccc;margin-bottom:8px}"
    & ".panel-input{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 10px;color:#ccc;font-size:12px;width:100%;margin-bottom:8px}"
    & ".tag{display:inline-block;background:#1a1a2a;color:#7799cc;padding:2px 8px;border-radius:4px;font-size:11px;margin-right:4px;margin-bottom:4px}"
    & ".publish-btn{width:100%;background:#50a0ff;color:#fff;border:none;padding:10px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-top:12px}"
    & ".publish-btn:hover{background:#4090ee}"
    & ".stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}"
    & ".stat-card{background:#1a1a1a;border-radius:8px;padding:10px;text-align:center}"
    & ".stat-val{font-size:18px;font-weight:700;color:#fff}"
    & ".stat-lbl{font-size:10px;color:#555;text-transform:uppercase;margin-top:2px}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "publisher" "publisher" [
      sidebar-tree 0,
      editor-view 0,
      panel-view 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexPublisher",
      widget-box "nav-write" "nav-item active" [widget-label "nav-write-l" "&#x270F; Write"],
      widget-box "nav-posts" "nav-item" [widget-label "nav-posts-l" "&#x1F4C4; All Posts"],
      widget-box "nav-media" "nav-item" [widget-label "nav-media-l" "&#x1F5BC; Media"],
      widget-box "nav-analytics" "nav-item" [widget-label "nav-analytics-l" "&#x1F4CA; Analytics"],
      widget-box "nav-settings" "nav-item" [widget-label "nav-settings-l" "&#x2699; Settings"],
      widget-label "sep" "",
      widget-label "post-hdr" "Recent Drafts",
      widget-box "p-draft1" "post-item active" [widget-label "p-d1" "Building with Codex"],
      widget-box "p-draft2" "post-item" [widget-label "p-d2" "The Future of Compilers"],
      widget-box "p-draft3" "post-item" [widget-label "p-d3" "Bare-Metal Programming"],
      widget-label "sep2" "",
      widget-label "pub-hdr" "Published",
      widget-box "p-pub1" "post-item" [widget-label "p-p1" "Why Self-Hosting Matters"],
      widget-box "p-pub2" "post-item" [widget-label "p-p2" "Dependent Types in Practice"]
    ]

  editor-view : Integer -> WidgetNode
  editor-view (x) =
    widget-box "editor" "editor" [
      widget-box "ed-toolbar" "editor-toolbar" [
        widget-button "ed-h1" "H1",
        widget-button "ed-h2" "H2",
        widget-button "ed-h3" "H3",
        widget-label "esep1" "",
        widget-button "ed-bold" "B",
        widget-button "ed-italic" "I",
        widget-button "ed-strike" "S",
        widget-button "ed-code" "&lt;/&gt;",
        widget-label "esep2" "",
        widget-button "ed-link" "&#x1F517;",
        widget-button "ed-img" "&#x1F5BC;",
        widget-button "ed-quote" "&#x201C;",
        widget-button "ed-list" "&#x2022;",
        widget-button "ed-olist" "1.",
        widget-label "esep3" "",
        widget-button "ed-preview" "&#x1F441; Preview",
        widget-button "ed-split" "Split"
      ],
      widget-box "ed-body" "editor-body" [
        wk-attach (widget-custom "ed-title" "input" 0 0) [widget-label "ed-tv" (state-get-text "post-title"), widget-label "ed-tp" "Title"] 0 2,
        wk-attach (widget-custom "ed-sub" "input" 0 0) [widget-label "ed-sv" (state-get-text "post-sub"), widget-label "ed-sp" "Subtitle"] 0 2,
        wk-attach (widget-custom "ed-content" "textarea" 0 0) [widget-label "ed-cv" (state-get-text "post-body")] 0 1
      ]
    ]

  panel-view : Integer -> WidgetNode
  panel-view (x) =
    widget-box "panel" "panel" [
      widget-label "panel-hdr" "Post Settings",
      widget-box "meta-group" "panel-group" [
        widget-label "slug-lbl" "SLUG",
        widget-label "slug-val" "building-with-codex",
        widget-label "date-lbl" "PUBLISH DATE",
        widget-label "date-val" "June 8, 2026",
        widget-label "author-lbl" "AUTHOR",
        widget-label "author-val" "Damian Tedrow"
      ],
      widget-box "tag-group" "panel-group" [
        widget-label "tag-lbl" "TAGS",
        widget-box "tags" "" [
          widget-label "tag0" "codex",
          widget-label "tag1" "compilers",
          widget-label "tag2" "bare-metal",
          widget-label "tag3" "self-hosting"
        ]
      ],
      widget-box "cover-group" "panel-group" [
        widget-label "cover-lbl" "COVER IMAGE",
        widget-button "btn-cover" "&#x1F5BC; Upload Cover"
      ],
      widget-box "seo-group" "panel-group" [
        widget-label "seo-lbl" "SEO DESCRIPTION",
        widget-label "seo-val" "A practical guide to the Codex self-sustaining compiler and bare-metal development."
      ],
      widget-box "stats" "stats" [
        widget-box "stat-words" "stat-card" [
          widget-label "stat-words-v" "847",
          widget-label "stat-words-l" "words"
        ],
        widget-box "stat-time" "stat-card" [
          widget-label "stat-time-v" "4 min",
          widget-label "stat-time-l" "read time"
        ],
        widget-box "stat-chars" "stat-card" [
          widget-label "stat-chars-v" "4,892",
          widget-label "stat-chars-l" "characters"
        ],
        widget-box "stat-links" "stat-card" [
          widget-label "stat-links-v" "0",
          widget-label "stat-links-l" "links"
        ]
      ],
      widget-button "btn-publish" "&#x1F680; Publish"
    ]

Section: Handlers

  publisher-click : Text -> Integer
  publisher-click (id) = 0

  publisher-input : Text, Text -> Integer
  publisher-input (id) (value) =
    if id == "ed-title" then let s = state-set-text "post-title" value in 0
    else if id == "ed-sub" then let s = state-set-text "post-sub" value in 0
    else if id == "ed-content" then let s = state-set-text "post-body" value in 0
    else 0

Section: Entry

  render-publisher : Integer -> Integer
  render-publisher (x) = mount-widget-themed publisher-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style publisher-theme publisher-css
    in let i1 = state-set-text "post-title" "Building with Codex"
    in let i2 = state-set-text "post-sub" "A practical guide to the self-sustaining compiler"
    in let i3 = state-set-text "post-body" "The Codex programming language represents a fundamental rethinking of how we build software. It compiles itself on bare metal with no operating system, no runtime, and no C library.\n\nWhy Self-Hosting Matters\n\nA self-hosting compiler is its own specification. When it compiles itself to a byte-identical binary, you have a fixed point: the output is the proof of correctness.\n\nThis eliminates entire categories of trust questions. The compiler stands on its own feet, and the whole environment fits in a 2 MB binary."
    in let s = set-render render-publisher
    in let h = register-handlers no-pick publisher-click
    in let hi = register-input-handler publisher-input
    in render-publisher 0
  end

