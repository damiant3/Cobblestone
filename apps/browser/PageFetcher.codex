Section: Types

  FetchResult =
    | FetchOk (FetchedPage)
    | FetchNetworkError (Text)
    | FetchHashMismatch (Text) (Text)
    | FetchNotFound
    | FetchTimeout

  FetchedPage = record {
    fp-bytes        : List Integer,
    fp-content-hash : ContentHash,
    fp-publisher    : Maybe (List Integer),
    fp-signature    : Maybe (List Integer),
    fp-capabilities : List Text,
    fp-is-source    : Boolean,
    fp-version      : Integer,
    fp-content-type : Text,
    fp-size         : Integer
  }

  FetchOptions = record {
    fo-timeout-ticks : Integer,
    fo-max-size      : Integer,
    fo-accept-cdx    : Boolean,
    fo-require-hash  : Boolean
  }

Section: Default Options

  fetch-defaults : FetchOptions
  fetch-defaults =
    FetchOptions {
      fo-timeout-ticks = 30000,
      fo-max-size = 1048576,
      fo-accept-cdx = True,
      fo-require-hash = False
    }

Section: Fetching

  fetch-page : Text, Text, FetchOptions -> [Console, Network.Read, Network.Write] FetchResult
  fetch-page (host) (path) (opts) = act
    print-line-uni ("FETCH codex://" & host & "/" & path)
    fetch-page-tcp host path opts
  end

  fetch-page-default : Text, Text -> [Console, Network.Read, Network.Write] FetchResult
  fetch-page-default (host) (path) =
    fetch-page host path fetch-defaults

Section: Network Configuration

  fetch-local-mac : List Integer = net-driver-mac
  fetch-local-ip : List Integer = [10, 0, 2, 15]
  fetch-gateway-ip : List Integer = [10, 0, 2, 2]
  fetch-host-ip : List Integer = [10, 0, 2, 2]
  fetch-local-port : Integer = 49200
  fetch-remote-port : Integer = 80

Section: TCP Fetch

  fetch-page-tcp : Text, Text, FetchOptions -> [Network.Read, Network.Write] FetchResult
  fetch-page-tcp (host) (path) (opts) =
    let accept = if opts.fo-accept-cdx
          then "application/cdx, application/codex"
    else "application/codex"
    in let base-req = http-get-request host ("/" & path)
    in let req = http-add-header base-req ("Accept: " & accept)
    in let req-bytes = http-serialize-request req
    in let sess = net-session-new fetch-local-mac fetch-local-ip fetch-gateway-ip fetch-local-port fetch-remote-port fetch-host-ip 2000
    in let ts = transport-new sess
    in act
      ts1 <- net-io-connect ts
      fetch-after-connect ts1 req-bytes host path opts
    end

 A truncated request says so and stops: a server that received half a request
 cannot answer it, and "No response from" would blame the site.

  fetch-after-connect : TcpTransportState, List Integer, Text, Text, FetchOptions -> [Network.Read, Network.Write] FetchResult
  fetch-after-connect (ts) (req-bytes) (host) (path) (opts) =
    when (ts.session).conn.state
      is TcpEstablished -> act
        s <- net-io-send-raw-checked ts req-bytes
        if s.ns-complete == False then act
          tsx <- net-io-close (s.ns-transport)
          FetchNetworkError ("Request truncated to: " & host)
        end
        else act
          recv <- fetch-recv-response (s.ns-transport)
          ts3 <- net-io-close (recv.transport)
          if recv.has-data
            then let resp = http-parse-response (recv.data)
            in process-response resp (recv.data) host path opts
          else FetchNetworkError ("No response from: " & host)
        end
      end
      is otherwise ->
        FetchNetworkError ("TCP connect failed: " & host)

  fetch-recv-response : TcpTransportState -> [Network.Read, Network.Write] RawRecvResult
  fetch-recv-response (ts) = act
    first <- net-io-recv-raw ts 0
    if first.has-data
      then fetch-recv-more (first.transport) (first.data)
    else first
  end

  fetch-recv-more : TcpTransportState, List Integer -> [Network.Read, Network.Write] RawRecvResult
  fetch-recv-more (ts) (acc) = act
    r <- net-io-recv-raw ts 49990000
    if r.has-data
      then fetch-recv-more (r.transport) (acc & r.data)
    else RawRecvResult { transport = r.transport, data = acc, has-data = True }
  end

Section: Response Processing

  process-response : HttpClientResponse, List Integer, Text, Text, FetchOptions -> FetchResult
  process-response (resp) (raw) (host) (path) (opts) =
    if resp.valid == False
    then FetchNetworkError ("Connection failed: " & host)
    else if resp.status-code == 404
    then FetchNotFound
    else if resp.status-code >= 400
    then FetchNetworkError ("HTTP " & show resp.status-code & ": " & resp.status-text)
    else if resp.status-code /= 200
    then FetchNetworkError ("Unexpected status: " & show resp.status-code)
    else process-success raw host path opts

  process-success : List Integer, Text, Text, FetchOptions -> FetchResult
  process-success (raw) (host) (path) (opts) =
    let len = list-length raw
    in let head = fetch-head-lines raw 0 len (__list-with-capacity 16)
    in let body = list-drop raw (find-body-start raw 0 len)
    in let size = list-length body
    in if size > opts.fo-max-size
      then FetchNetworkError ("Response too large: " & show size & " bytes")
    else let is-source = is-codex-source head
    in let hash = if is-source
          then content-hash-source body
    else content-hash-cdx body
    in verify-and-build body hash head is-source size opts

  is-codex-source : List Text -> Boolean
  is-codex-source (head) =
    text-contains (header-value head "Content-Type") "application/codex"

  verify-and-build : List Integer, ContentHash, List Text, Boolean, Integer, FetchOptions -> FetchResult
  verify-and-build (body) (hash) (head) (is-source) (size) (opts) =
    let expected-hex = header-value head "Content-Hash"
    in if text-length expected-hex > 0
      then let actual-hex = content-hash-to-hex hash
      in if actual-hex == expected-hex
        then FetchOk (build-page body hash head is-source size)
      else FetchHashMismatch (actual-hex) (expected-hex)
    else if opts.fo-require-hash
    then FetchNetworkError "Server did not provide Content-Hash header"
    else FetchOk (build-page body hash head is-source size)

Section: Page Construction

  build-page : List Integer, ContentHash, List Text, Boolean, Integer -> FetchedPage
  build-page (body) (hash) (head) (is-source) (size) =
    FetchedPage {
      fp-bytes = body,
      fp-content-hash = hash,
      fp-publisher = parse-pub-key head,
      fp-signature = parse-sig head,
      fp-capabilities = parse-caps head,
      fp-is-source = is-source,
      fp-version = parse-ver head,
      fp-content-type = if is-source then "application/codex" else "application/cdx",
      fp-size = size
    }

Section: Header Extraction

  fetch-head-lines : List Integer, Integer, Integer, List Text -> List Text
  fetch-head-lines (bs) (i) (len) (acc) =
    if i >= len then acc
    else let e = fetch-line-end bs i len
    in if e == i then acc
    else let line = text-concat-list (read-line-from-bytes bs i len (__list-with-capacity 64))
    in fetch-head-lines bs (fetch-next-line bs e len) len (list-push acc line)

  fetch-line-end : List Integer, Integer, Integer -> Integer
  fetch-line-end (bs) (i) (len) =
    if i >= len then len
    else if list-at bs i == 13 then i
    else if list-at bs i == 10 then i
    else fetch-line-end bs (i + 1) len

  fetch-next-line : List Integer, Integer, Integer -> Integer
  fetch-next-line (bs) (e) (len) =
    if e + 1 >= len then len
    else if list-at bs e == 13 then (if list-at bs (e + 1) == 10 then e + 2 else e + 1)
    else e + 1

  header-value : List Text, Text -> Text
  header-value (head) (name) = header-value-at head (name & ": ") 1 (list-length head)

  header-value-at : List Text, Text, Integer, Integer -> Text
  header-value-at (head) (prefix) (i) (len) =
    if i >= len then ""
    else let line = list-at head i
    in if text-starts-with line prefix
      then text-drop line (text-length prefix)
    else header-value-at head prefix (i + 1) len

  parse-pub-key : List Text -> Maybe (List Integer)
  parse-pub-key (head) =
    let val = header-value head "X-Codex-Publisher"
    in if text-length val > 0
      then if text-starts-with val "ed25519:"
        then hex-decode-checked (text-drop val 8)
      else hex-decode-checked val
    else None

  parse-sig : List Text -> Maybe (List Integer)
  parse-sig (head) =
    let val = header-value head "X-Codex-Signature"
    in if text-length val > 0
      then hex-decode-checked val
    else None

  parse-caps : List Text -> List Text
  parse-caps (head) =
    let val = header-value head "X-Codex-Capabilities"
    in if text-length val > 0
      then text-split val ","
    else ["Display"]

  parse-ver : List Text -> Integer
  parse-ver (head) =
    let val = header-value head "X-Codex-Version"
    in if text-length val > 0
      then parse-decimal-full val
    else 0

Section: Signature Verification

  verify-fetched-signature : FetchedPage -> Boolean
  verify-fetched-signature (page) =
    when page.fp-publisher
      is None -> False
      is Just (pub-key) ->
        when page.fp-signature
          is None -> False
          is Just (sig) ->
            let hash-bytes = content-hash-to-bytes page.fp-content-hash
            in ed25519-verify pub-key hash-bytes sig

Section: Fetch Result Formatting

  format-fetch-result : FetchResult -> Text
  format-fetch-result (result) =
    when result
      is FetchOk (page) ->
        "OK: " & show page.fp-size & " bytes, " & page.fp-content-type
        & ", hash=" & content-hash-short page.fp-content-hash
      is FetchNetworkError (msg) -> "NETWORK ERROR: " & msg
      is FetchHashMismatch (actual) (expected) ->
        "HASH MISMATCH: got " & actual & ", expected " & expected
      is FetchNotFound -> "NOT FOUND"
      is FetchTimeout -> "TIMEOUT"
