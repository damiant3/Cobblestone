Section: Entry Point

  opening : [Console] Nothing
  opening = act
    let disk = disk-load
    in let width = 1024
    in let height = 768
    in let ds = display-init width height
    in let theme = browser-theme-default
    in act
      state <- browser-init width height theme ds
      let hist = browser-persist-load-history disk 500
      in let trust = browser-persist-load-trust disk []
      in let state1 = __record-set state "bs-history" hist
      in let restored = __record-set state1 "bs-trust-store" trust
      in let disk2 = app-log-info disk "browser" ("Browser started, " & show (history-count hist) & " history entries") 0
      in act
        print-line-uni "Codex Browser v0.1"
        print-line-uni ("  Disk: " & show (disk-fact-count disk2) & " facts")
        print-line-uni ("  History: " & show (history-count hist) & " entries")
        print-line-uni ("  Display: " & format-display ds)
        browser-run-persistent restored disk2
      end
    end
  end

Section: Persistent Event Loop

  BrowserPersistState = record {
    bps-browser : BrowserState,
    bps-disk : DiskFactStore
  }

  browser-run-persistent : BrowserState, DiskFactStore -> [Console] Nothing
  browser-run-persistent (state) (disk) =
    let loop-mark = __heap-save
    in act
      let ticked = browser-tick-media state 16
      in let presented = if ticked.bs-dirty
            then let frame-mark = __heap-save
              in let fb = browser-render-frame ticked
              in let w = browser-present ticked fb
              in let reclaimed = __heap-restore frame-mark
              in __record-set ticked "bs-dirty" False
            else ticked
      in act
        let k = poll-key
        in if k == 0 & browser-idle-reclaimable state
          then let reclaimed = __heap-restore loop-mark
            in browser-run-persistent state disk
          else act
            handled <- browser-dispatch-event presented (event-key-down k poll-mods 0)
            let persisted = browser-check-persist handled disk state
            in browser-run-persistent (persisted.bps-browser) (persisted.bps-disk)
          end
      end
    end

  browser-idle-reclaimable : BrowserState -> Boolean
  browser-idle-reclaimable (state) =
    when browser-active-tab state
      is None -> True
      is Just (t) -> if tab-has-player t then False else True

  browser-check-persist : BrowserState, DiskFactStore, BrowserState -> BrowserPersistState
  browser-check-persist (after) (disk) (before) =
    let nav-changed = history-count after.bs-history /= history-count before.bs-history
    in let trust-changed = list-length after.bs-trust-store.ts-decisions /= list-length before.bs-trust-store.ts-decisions
    in if nav-changed | trust-changed
      then let new-disk = browser-persist-save disk after.bs-history after.bs-trust-store 0
        in let logged = if nav-changed
              then app-log-info new-disk "browser" "Navigation recorded" 0
              else app-log-info new-disk "browser" "Trust decision saved" 0
        in BrowserPersistState { bps-browser = after, bps-disk = logged }
      else BrowserPersistState { bps-browser = after, bps-disk = disk }
