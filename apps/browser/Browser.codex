Section: State

  BrowserState = record {
    bs-tabs          : List Tab,
    bs-active-tab    : Integer,
    bs-address-bar   : AddressBarState,
    bs-window-width  : Integer,
    bs-window-height : Integer,
    bs-theme         : Theme,
    bs-compositor    : Compositor,
    bs-next-tab-id   : Integer,
    bs-trust-store   : TrustStore,
    bs-sandbox       : SandboxConfig,
    bs-cache         : ContentCacheState,
    bs-focus         : BrowserFocus,
    bs-dirty         : Boolean,
    bs-show-trust-prompt : Boolean,
    bs-pending-trust : Maybe PendingTrust,
    bs-display       : DisplayState,
    bs-history       : BrowsingHistory,
    bs-laid          : Maybe WidgetNode,
    bs-laid-mark     : Integer
  }

  BrowserFocus =
    | FocusAddressBar
    | FocusPageContent
    | FocusTrustPrompt
    | FocusTabBar

  PendingTrust = record {
    pt-address   : Text,
    pt-publisher : Maybe (List Integer),
    pt-tier      : CapabilityTier,
    pt-effects   : List Text
  }

Section: Initialization

 The state is built around the UNLOADED tab and the page is loaded into it
 afterwards, because the page has to be built for a height only a layout can
 answer and a layout needs a state to lay out (BROWSER-5). `__record-set`
 stores in place and hands back the same record, which is what makes the
 second step a store rather than a second state.

  browser-init : Integer, Integer, Theme, DisplayState -> BrowserState
  browser-init (w) (h) (theme) (ds) =
    let comp = compositor-new w h browser-bg
    in let first-tab = tab-new 1 "New Tab" "codex://local/newtab"
    in let addr-bar = address-bar-set-text (address-bar-new w) "codex://local/newtab"
    in let trust = trust-store-new []
    in let sandbox = sandbox-default-config
    in let cache = cache-new 64
    in let blank = BrowserState {
      bs-tabs = [first-tab],
      bs-active-tab = 1,
      bs-address-bar = addr-bar,
      bs-window-width = w,
      bs-window-height = h,
      bs-theme = theme,
      bs-compositor = comp,
      bs-next-tab-id = 2,
      bs-trust-store = trust,
      bs-sandbox = sandbox,
      bs-cache = cache,
      bs-focus = FocusPageContent,
      bs-dirty = True,
      bs-show-trust-prompt = False,
      bs-pending-trust = None,
      bs-display = ds,
      bs-history = history-new 500,
      bs-laid = None,
      bs-laid-mark = 0
    }
    in act
      loaded <- load-new-tab-content first-tab sandbox trust cache w (browser-viewport-h blank)
      __record-set blank "bs-tabs" [loaded]
    end

 The last argument is the viewport's MEASURED height, not the window's.
 `browser-viewport-h` lays the chrome out with an empty viewport and reads
 what the layout gives it (BROWSER-5); subtracting `chrome-height` here
 instead was 26 short at 1024x768, and the page painted the difference over
 whatever was below the pane.

  load-new-tab-content : Tab, SandboxConfig, TrustStore, ContentCacheState, Integer, Integer -> Tab
  load-new-tab-content (t) (sandbox) (trust) (cache) (vw) (vp-h) =
    act
      result <- resolve-and-load t.tab-address sandbox trust cache vw vp-h
      when result
      is PageLoaded (tree) (title) (caps) ->
        tab-set-content t tree title
      is PageCompileError (msg) ->
        tab-set-error t ("Compile error: " & msg)
      is PageFetchError (msg) ->
        tab-set-error t msg
      is PageTrustDenied (tier) ->
        tab-set-error t ("Trust denied for tier: " & tier-name tier)
      is PageSizeDenied (size) ->
        tab-set-error t ("Page too large: " & show size & " bytes")
    end

Section: Chrome Layout

 Both bars hold widgets that declare 24, and since WORKS-45 a panel is at
 least as tall as what it contains, so the laid-out bars come out 42 each
 whatever these numbers say. `browser-apply-click` routes by y against them,
 so a number smaller than the bar it names sends clicks in the difference to
 the wrong handler: at 28 the bottom 14 rows of the address bar reached the
 page. `codex/test/apps/browser-chrome-layout` prints the laid-out heights.

  chrome-tab-bar-height : Integer
  chrome-tab-bar-height = 42

  chrome-address-bar-height : Integer
  chrome-address-bar-height = 42

  chrome-height : Integer
  chrome-height = chrome-tab-bar-height + chrome-address-bar-height

 This is the box the layout actually gives the page, not `chrome-height`
 subtracted from the window. The media player is sized by it, so the old
 arithmetic sized a video 26 rows taller than the space it had.

  page-viewport-rect : BrowserState -> LayoutRect
  page-viewport-rect (state) = browser-viewport-box state

  tab-bar-rect : BrowserState -> LayoutRect
  tab-bar-rect (state) =
    layout-rect 0 0 state.bs-window-width chrome-tab-bar-height

  address-bar-rect : BrowserState -> LayoutRect
  address-bar-rect (state) =
    layout-rect 0 chrome-tab-bar-height state.bs-window-width chrome-address-bar-height

Section: Rendering

  browser-render : BrowserState -> WidgetNode
  browser-render (state) = browser-render-with state (browser-render-viewport state)

  browser-active-scroll : BrowserState -> ScrollState
  browser-active-scroll (state) =
    when browser-active-tab state
      is None -> scroll-new 0 0 0 0
      is Just (t) -> t.tab-scroll

  browser-render-with : BrowserState, WidgetNode -> WidgetNode
  browser-render-with (state) (viewport) =
    let tab-bar = browser-render-tab-bar state
    in let addr-bar = browser-render-address-bar state
    in let vp-clip = widget-scroll-view "viewport-clip" DirColumn 0 [ viewport ]
    in let vp-row = widget-scroll-view "viewport-row" DirRow 0 [
          widget-set-flex vp-clip 1,
          scroll-bar-or-gap "page-scroll" (browser-active-scroll state)
        ]
    in let chrome = widget-panel "chrome" DirColumn 0 [
          widget-set-flex (widget-set-min tab-bar state.bs-window-width chrome-tab-bar-height) 0,
          widget-set-flex (widget-set-min addr-bar state.bs-window-width chrome-address-bar-height) 0,
          widget-set-flex vp-row 1
        ]
    in if state.bs-show-trust-prompt
      then let overlay = browser-render-trust-prompt state
        in widget-panel "root" DirColumn 0 [chrome, overlay]
      else chrome

 BROWSER-5. The page has to be built for a height, and `vh - chrome-height`
 is not that height. `chrome-height` is the sum of the two bars, where what
 stands above the viewport is the root panel's own inset and the margins
 between the bars as well: measured at 1024x768, the page was built for 684
 and the layout gave it 658. Nothing clips a widget panel to its box, so the
 surplus painted over whatever sat below the pane, which on the desk is the
 taskbar.

 So the height is MEASURED, from a layout of this same chrome with an EMPTY
 viewport. Empty is not an optimisation, it is the whole point: since
 WORKS-45 a panel is at least as tall as what it holds, so a chrome measured
 with the real page reports the height that page DEMANDS rather than the
 height it is going to be given. That is the same circularity the tracker hit
 on the width axis in WORKS-47, and it is avoided the same way.

  browser-viewport-probe : Text = "viewport-probe"

 The rect is rebuilt before the bracket closes. `widget-layout` returns a
 fresh tree and the restore frees exactly it, so handing back a rect that
 still lives in it would hand back reclaimed memory.

  browser-viewport-box : BrowserState -> LayoutRect
  browser-viewport-box (state) =
    let mark = __heap-save
    in let empty = widget-panel browser-viewport-probe DirColumn 0 []
    in let laid = widget-layout (browser-render-with state empty) (state.bs-theme) (layout-rect 0 0 (state.bs-window-width) (state.bs-window-height))
    in let found = browser-probe-box laid
    in let kept = layout-rect (found.lr-x) (found.lr-y) (found.lr-w) (found.lr-h)
    in let dropped = __heap-restore mark
    in kept

  browser-viewport-h : BrowserState -> Integer
  browser-viewport-h (state) = (browser-viewport-box state).lr-h

  browser-probe-box : WidgetNode -> LayoutRect
  browser-probe-box (w) =
    if w.wn-id == browser-viewport-probe then w.wn-bounds
    else browser-probe-box-kids (w.wn-children) 0 (w.wn-child-count)

  browser-probe-box-kids : List WidgetNode, Integer, Integer -> LayoutRect
  browser-probe-box-kids (kids) (i) (n) =
    if i >= n then layout-rect-zero
    else let found = browser-probe-box (list-at kids i)
    in if found.lr-h > 0 then found
    else browser-probe-box-kids kids (i + 1) n

  browser-render-tab-bar : BrowserState -> WidgetNode
  browser-render-tab-bar (state) =
    let tab-widgets = render-tab-buttons state.bs-active-tab state.bs-tabs
    in let new-tab-btn = widget-button "new-tab" "+"
    in let close-btn = widget-button "close-tab" "x"
    in let all-tab-widgets = list-push (list-push tab-widgets new-tab-btn) close-btn
    in widget-panel "tab-bar" DirRow 2 all-tab-widgets

  render-tab-button : Integer, Tab -> WidgetNode
  render-tab-button (active-id) (t) =
    let label = if text-length t.tab-title > 18
          then text-take t.tab-title 15 & "..."
          else t.tab-title
    in let btn = widget-button ("tab-" & show t.tab-id) label
    in if t.tab-id == active-id
      then widget-set-state btn 1
      else btn

  render-tab-buttons : Integer, List Tab -> List WidgetNode
  render-tab-buttons (active-id) (tabs) =
    list-map (render-tab-button active-id) tabs

  browser-render-address-bar : BrowserState -> WidgetNode
  browser-render-address-bar (state) =
    let active = browser-active-tab state
    in let trust-color = when active
          is Just (t) -> tab-trust-color t
          is None -> #808080
    in let focused = when state.bs-focus
          is FocusAddressBar -> True
          is otherwise -> False
    in let ab = if focused
          then address-bar-focus state.bs-address-bar
          else address-bar-blur state.bs-address-bar
    in address-bar-render ab trust-color

  browser-render-viewport : BrowserState -> WidgetNode
  browser-render-viewport (state) =
    let active = browser-active-tab state
    in when active
      is Just (t) ->
        when t.tab-player
          is Just (ps) ->
            let vp = page-viewport-rect state
            in player-render-widget ps vp.lr-w vp.lr-h
          is None -> tab-render-content t
      is None -> widget-label "viewport" "No tab selected"

Section: Trust Prompt Rendering

  browser-render-trust-prompt : BrowserState -> WidgetNode
  browser-render-trust-prompt (state) =
    when state.bs-pending-trust
      is None ->
        widget-label "trust-prompt" "No pending trust decision"
      is Just (pt) ->
        let title-text = "Page requests " & tier-name pt.pt-tier & " capabilities"
        in let title = widget-label "trust-title" title-text
        in let addr-label = widget-label "trust-addr" ("Address: " & pt.pt-address)
        in let pub-label = widget-label "trust-pub" (
              when pt.pt-publisher
                is Just (pk) -> "Publisher: " & bytes-to-hex pk
                is None -> "Publisher: Unknown")
        in let effects-text = "Effects: " & join-effects pt.pt-effects
        in let effects-label = widget-label "trust-effects" effects-text
        in let tier-text = "Tier: " & tier-name pt.pt-tier
        in let tier-label = widget-label "trust-tier" tier-text
        in let allow-btn = widget-button "trust-allow" "Allow Once"
        in let trust-btn = widget-button "trust-always" "Trust Publisher"
        in let deny-btn = widget-button "trust-deny" "Deny"
        in let buttons = widget-panel "trust-buttons" DirRow 8 [allow-btn, trust-btn, deny-btn]
        in widget-panel "trust-prompt" DirColumn 6 [
          title, addr-label, pub-label, effects-label, tier-label,
          widget-separator "trust-sep",
          buttons
        ]

  join-effects : List Text -> Text
  join-effects (effects) =
    if list-length effects == 0 then "none"
    else join-with-comma effects

  join-with-comma : List Text -> Text
  join-with-comma (xs) =
    if list-length xs == 0 then ""
    else let head = list-at xs 0
        in let tail = list-drop xs 1
        in if list-length tail == 0 then head
          else head & ", " & join-with-comma tail

Section: Tab Management

  browser-active-tab : BrowserState -> Maybe Tab
  browser-active-tab (state) =
    tab-find-by-id state.bs-tabs state.bs-active-tab

  browser-new-tab : BrowserState -> BrowserState
  browser-new-tab (state) =
    let id = state.bs-next-tab-id
    in let t = tab-new id "New Tab" "codex://local/newtab"
    in act
      loaded <- load-new-tab-content t state.bs-sandbox state.bs-trust-store state.bs-cache state.bs-window-width (browser-viewport-h state)
      let s1 = __record-set state "bs-tabs" (list-push state.bs-tabs loaded)
      in let s2 = __record-set s1 "bs-active-tab" id
      in let s3 = __record-set s2 "bs-next-tab-id" (id + 1)
      in let s4 = __record-set s3 "bs-address-bar" (address-bar-set-text state.bs-address-bar "codex://local/newtab")
      in __record-set s4 "bs-dirty" True
    end

  browser-close-tab : BrowserState, Integer -> BrowserState
  browser-close-tab (state) (id) =
    let remaining = tab-remove state.bs-tabs id
    in if list-length remaining == 0
      then browser-new-tab (__record-set state "bs-tabs" [])
      else let new-active = if state.bs-active-tab == id
            then (list-at remaining 0).tab-id
            else state.bs-active-tab
        in let active-tab = tab-find-by-id remaining new-active
        in let addr = when active-tab
              is Just (t) -> t.tab-address
              is None -> ""
        in let s1 = __record-set state "bs-tabs" remaining
        in let s2 = __record-set s1 "bs-active-tab" new-active
        in __record-set s2 "bs-address-bar" (address-bar-set-text state.bs-address-bar addr)

 Switching to the tab already active is a no-op and answers the state it was
 given, for the reason `browser-focus-page` below is written the same way:
 clicking the tab you are on is an ordinary thing to do, `tab-find-by-id`
 and three `__record-set` calls are not free, and on a bump allocator in a
 loop that never returns they are permanent. Measured through
 `browser-click-heap`: 16 bytes a click before the guard, none after.

  browser-switch-tab : BrowserState, Integer -> BrowserState
  browser-switch-tab (state) (id) =
    if id == state.bs-active-tab then state
    else let tab = tab-find-by-id state.bs-tabs id
    in let addr = when tab
          is Just (t) -> t.tab-address
          is None -> ""
    in let s1 = __record-set state "bs-active-tab" id
    in let s2 = __record-set s1 "bs-address-bar" (address-bar-set-text state.bs-address-bar addr)
    in __record-set s2 "bs-dirty" True

  browser-next-tab : BrowserState -> BrowserState
  browser-next-tab (state) =
    let idx = find-tab-index state.bs-tabs state.bs-active-tab
    in let next-idx = int-mod (idx + 1) (list-length state.bs-tabs)
    in let next-id = (list-at state.bs-tabs next-idx).tab-id
    in browser-switch-tab state next-id

  browser-prev-tab : BrowserState -> BrowserState
  browser-prev-tab (state) =
    let idx = find-tab-index state.bs-tabs state.bs-active-tab
    in let count = list-length state.bs-tabs
    in let prev-idx = int-mod (idx - 1 + count) count
    in let prev-id = (list-at state.bs-tabs prev-idx).tab-id
    in browser-switch-tab state prev-id

  find-tab-index : List Tab, Integer -> Integer
  find-tab-index (tabs) (id) =
    find-tab-index-at tabs id 0

  find-tab-index-at : List Tab, Integer, Integer -> Integer
  find-tab-index-at (tabs) (id) (idx) =
    if idx >= list-length tabs then 0
    else if (list-at tabs idx).tab-id == id then idx
    else find-tab-index-at tabs id (idx + 1)

Section: Navigation

  browser-navigate : BrowserState, Text -> BrowserState
  browser-navigate (state) (address) =
    let active = browser-active-tab state
    in when active
      is Just (t) -> act
        loaded <- load-new-tab-content (tab-navigate t address) state.bs-sandbox state.bs-trust-store state.bs-cache state.bs-window-width (browser-viewport-h state)
        let title = loaded.tab-title
        in let hist = history-visit state.bs-history address title 0
        in let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs loaded)
        in let s2 = __record-set s1 "bs-address-bar" (address-bar-set-text state.bs-address-bar address)
        in let s3 = __record-set s2 "bs-history" hist
        in __record-set s3 "bs-dirty" True
      end
      is None -> state

  browser-go-back : BrowserState -> BrowserState
  browser-go-back (state) =
    let active = browser-active-tab state
    in when active
      is Just (t) ->
        let backed = tab-go-back t
        in if backed.tab-address /= t.tab-address
          then act
            loaded <- load-new-tab-content backed state.bs-sandbox state.bs-trust-store state.bs-cache state.bs-window-width (browser-viewport-h state)
            let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs loaded)
            in let s2 = __record-set s1 "bs-address-bar" (address-bar-set-text state.bs-address-bar backed.tab-address)
            in __record-set s2 "bs-dirty" True
          end
          else state
      is None -> state

  browser-go-forward : BrowserState -> BrowserState
  browser-go-forward (state) =
    let active = browser-active-tab state
    in when active
      is Just (t) ->
        let forwarded = tab-go-forward t
        in if forwarded.tab-address /= t.tab-address
          then act
            loaded <- load-new-tab-content forwarded state.bs-sandbox state.bs-trust-store state.bs-cache state.bs-window-width (browser-viewport-h state)
            let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs loaded)
            in let s2 = __record-set s1 "bs-address-bar" (address-bar-set-text state.bs-address-bar forwarded.tab-address)
            in __record-set s2 "bs-dirty" True
          end
          else state
      is None -> state

  browser-reload : BrowserState -> BrowserState
  browser-reload (state) =
    let active = browser-active-tab state
    in when active
      is Just (t) -> act
        loaded <- load-new-tab-content (__record-set t "tab-status" TabLoading) state.bs-sandbox state.bs-trust-store state.bs-cache state.bs-window-width (browser-viewport-h state)
        let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs loaded)
        in __record-set s1 "bs-dirty" True
      end
      is None -> state

Section: Trust Prompt Flow

  browser-show-trust-prompt : BrowserState, Text, Maybe (List Integer), CapabilityTier, List Text -> BrowserState
  browser-show-trust-prompt (state) (address) (publisher) (tier) (effects) =
    let pending = PendingTrust {
      pt-address = address,
      pt-publisher = publisher,
      pt-tier = tier,
      pt-effects = effects
    }
    in let s1 = __record-set state "bs-show-trust-prompt" True
    in let s2 = __record-set s1 "bs-pending-trust" (Just pending)
    in let s3 = __record-set s2 "bs-focus" FocusTrustPrompt
    in __record-set s3 "bs-dirty" True

  browser-trust-allow-once : BrowserState -> BrowserState
  browser-trust-allow-once (state) =
    when state.bs-pending-trust
      is None -> browser-dismiss-trust state
      is Just (pt) ->
        let dismissed = browser-dismiss-trust state
        in browser-navigate dismissed pt.pt-address

  browser-trust-always : BrowserState -> BrowserState
  browser-trust-always (state) =
    when state.bs-pending-trust
      is None -> browser-dismiss-trust state
      is Just (pt) ->
        when pt.pt-publisher
          is None -> browser-trust-allow-once state
          is Just (pub-key) ->
            let updated-store = trust-store-grant state.bs-trust-store pub-key pt.pt-tier 0
            in let base-state = browser-dismiss-trust state
            in let dismissed = __record-set base-state "bs-trust-store" updated-store
            in browser-navigate dismissed pt.pt-address

  browser-trust-deny : BrowserState -> BrowserState
  browser-trust-deny (state) =
    let dismissed = browser-dismiss-trust state
    in let active = browser-active-tab dismissed
    in when active
      is Just (t) ->
        let denied = tab-set-error t "Trust denied by user"
        in __record-set dismissed "bs-tabs" (tab-replace dismissed.bs-tabs denied)
      is None -> dismissed

  browser-dismiss-trust : BrowserState -> BrowserState
  browser-dismiss-trust (state) =
    let s1 = __record-set state "bs-show-trust-prompt" False
    in let s2 = __record-set s1 "bs-pending-trust" None
    in __record-set s2 "bs-focus" FocusPageContent

Section: Mouse Hit Testing

  browser-handle-mouse-click : BrowserState, Integer, Integer -> BrowserState
  browser-handle-mouse-click (state) (mx) (my) =
    browser-apply-click state mx my (browser-click-code state mx my)

  browser-band-page : Integer = 0
  browser-band-tab-bar : Integer = 1
  browser-band-address-bar : Integer = 2

 The band is read off the tree the browser painted, not derived from the
 chrome's heights. Those are heights and the question is POSITION: the root
 panel is inset by its own margin, border and padding before anything is
 placed, so the tab bar starts at y 9 and every boundary derived from a
 height alone sat 9 rows above the bar it named. Ten rows of a 108-row
 column reached the wrong handler, and no pair of constants closes that,
 because the inset is the theme's and the widths are the caller's
 (`codex/test/apps/browser-chrome-click`).

 The heights are still the answer before the first paint, when there is no
 tree to ask and no pixels on the glass either.

  browser-click-band : BrowserState, Integer, Integer -> Integer
  browser-click-band (state) (mx) (my) =
    when state.bs-laid
      is None ->
        if my < chrome-tab-bar-height then browser-band-tab-bar
        else if my < chrome-height then browser-band-address-bar
        else browser-band-page
      is Just (tree) ->
        if browser-point-in tree "tab-bar" mx my then browser-band-tab-bar
        else if browser-point-in tree "address-bar" mx my then browser-band-address-bar
        else browser-band-page

 This walks the tree itself rather than calling `widget-find`, and the reason
 is the same one the focus guard below is written for. `widget-find` answers
 a `Maybe WidgetNode`, so it ALLOCATES a `Just` on every hit, and this runs
 on every click: measured through `browser-click-heap`, routing through it
 cost 96 bytes a cycle where the loop had been costing nothing, and on a bump
 allocator inside a loop that never returns those are permanent. Answering a
 Boolean allocates nothing.

  browser-point-in : WidgetNode, Text, Integer, Integer -> Boolean
  browser-point-in (w) (id) (mx) (my) =
    if w.wn-id == id then rect-contains (w.wn-bounds) mx my
    else browser-point-in-children (w.wn-children) id mx my 0 (w.wn-child-count)

  browser-point-in-children : List WidgetNode, Text, Integer, Integer, Integer, Integer -> Boolean
  browser-point-in-children (children) (id) (mx) (my) (i) (n) =
    if i >= n then False
    else if browser-point-in (list-at children i) id mx my then True
    else browser-point-in-children children id mx my (i + 1) n

  browser-apply-click : BrowserState, Integer, Integer, Integer -> BrowserState
  browser-apply-click (state) (mx) (my) (code) =
    let band = browser-click-band state mx my
    in if band == browser-band-tab-bar
    then browser-handle-tab-bar-click state mx my
    else if band == browser-band-address-bar
    then browser-handle-address-bar-click state mx my
    else if state.bs-show-trust-prompt
    then browser-handle-trust-click state mx my
    else browser-apply-page-code state code

 BROWSER-7, and it is BROWSER-6's defect one axis over. Dividing x by 120
 assumes the tabs start at x 0 and are all 120 wide. They start at x 9, for
 the root panel's inset, and `render-tab-button` sizes each one to its own
 TITLE, so no two are the same width and none of them is 120. It read
 correct only because one tab plus the "+" column means almost any x answers
 the intended index.

 The tree is asked instead, by the id each button already carries. The width
 arithmetic is kept for the `bs-laid = None` case, which is before the first
 paint and so before there is a tab on the glass to aim at.

  browser-handle-tab-bar-click : BrowserState, Integer, Integer -> BrowserState
  browser-handle-tab-bar-click (state) (mx) (my) =
    when state.bs-laid
      is None -> browser-tab-click-by-width state mx my
      is Just (tree) ->
        if browser-point-in tree "new-tab" mx my then browser-new-tab state
        else if browser-point-in tree "close-tab" mx my then browser-close-tab state (state.bs-active-tab)
        else let id = browser-tab-under state tree mx my 0 (list-length state.bs-tabs)
        in if id < 0 then state else browser-switch-tab state id

 A tab is found by its POSITION among the bar's children rather than by
 building its id. `"tab-" & show id` per tab per click measured 48 bytes a
 cycle through `browser-click-heap`, and on a bump allocator in a loop that
 never returns those are permanent. `browser-render-tab-bar` pushes the tabs
 first and then `new-tab` and `close-tab`, so child i is tab i, and both
 buttons are tested by literal id before this runs and cannot reach it.

  browser-tab-index : WidgetNode, Integer, Integer -> Integer
  browser-tab-index (w) (mx) (my) =
    if w.wn-id == "tab-bar" then browser-child-index w mx my 0 (w.wn-child-count)
    else browser-tab-index-kids (w.wn-children) mx my 0 (w.wn-child-count)

  browser-tab-index-kids : List WidgetNode, Integer, Integer, Integer, Integer -> Integer
  browser-tab-index-kids (kids) (mx) (my) (i) (n) =
    if i >= n then 0 - 1
    else let found = browser-tab-index (list-at kids i) mx my
    in if found >= 0 then found
    else browser-tab-index-kids kids mx my (i + 1) n

  browser-child-index : WidgetNode, Integer, Integer, Integer, Integer -> Integer
  browser-child-index (bar) (mx) (my) (i) (n) =
    if i >= n then 0 - 1
    else if rect-contains ((list-at (bar.wn-children) i).wn-bounds) mx my then i
    else browser-child-index bar mx my (i + 1) n

  browser-tab-under : BrowserState, WidgetNode, Integer, Integer, Integer, Integer -> Integer
  browser-tab-under (state) (tree) (mx) (my) (i) (n) =
    let idx = browser-tab-index tree mx my
    in if idx < 0 then 0 - 1
    else if idx >= n then 0 - 1
    else (list-at (state.bs-tabs) idx).tab-id

  browser-tab-click-by-width : BrowserState, Integer, Integer -> BrowserState
  browser-tab-click-by-width (state) (mx) (my) =
    let tab-count = list-length state.bs-tabs
    in let tab-width = 120
    in let click-index = mx / tab-width
    in if click-index < tab-count
      then let clicked-tab = list-at state.bs-tabs click-index
        in browser-switch-tab state clicked-tab.tab-id
      else if click-index == tab-count
      then browser-new-tab state
      else state

 The same defect as the tab bar and fixed the same way, because leaving it
 would be the identical bug next door: three 28-wide slots from x 0, where
 the buttons start at x 9 and a `<` button is `text-length * 8 + 16` wide,
 which is 24. `address-bar-render` already names all three.

  browser-handle-address-bar-click : BrowserState, Integer, Integer -> BrowserState
  browser-handle-address-bar-click (state) (mx) (my) =
    when state.bs-laid
      is None -> browser-addr-click-by-width state mx my
      is Just (tree) ->
        if browser-point-in tree "nav-back" mx my then browser-go-back state
        else if browser-point-in tree "nav-forward" mx my then browser-go-forward state
        else if browser-point-in tree "nav-reload" mx my then browser-reload state
        else browser-focus-address state

  browser-focus-address : BrowserState -> BrowserState
  browser-focus-address (state) =
    let s1 = __record-set state "bs-focus" FocusAddressBar
    in __record-set s1 "bs-dirty" True

  browser-addr-click-by-width : BrowserState, Integer, Integer -> BrowserState
  browser-addr-click-by-width (state) (mx) (my) =
    let nav-btn-width = 28
    in if mx < nav-btn-width
      then browser-go-back state
      else if mx < nav-btn-width * 2
      then browser-go-forward state
      else if mx < nav-btn-width * 3
      then browser-reload state
      else browser-focus-address state

  browser-handle-trust-click : BrowserState, Integer, Integer -> BrowserState
  browser-handle-trust-click (state) (mx) (my) =
    let vp = page-viewport-rect state
    in let prompt-y = vp.lr-y + vp.lr-h / 4
    in let prompt-h = vp.lr-h / 2
    in let button-y = prompt-y + prompt-h - 40
    in if my >= button-y
      then let btn-width = state.bs-window-width / 3
        in if mx < btn-width
          then browser-trust-allow-once state
          else if mx < btn-width * 2
          then browser-trust-always state
          else browser-trust-deny state
      else state

 A click is answered in two steps, because the tree that has to be hit-tested
 and the state that has to survive the click cannot both be held on a bump
 allocator at once. The laid-out tree is the tip of the heap, so releasing it
 has to happen BEFORE the new state is allocated, and the hit therefore has
 to leave the tree as a value that owns no heap. `browser-click-code` answers
 an Integer. A `Maybe Text` would not do: the id points into the tree and the
 `Just` cell sits above it, so both die at the release.

 It reads `bs-laid`, which is the tree that was actually DRAWN. The tree in
 `tab-content` is the raw one the page builder returned and every node in it
 carries `layout-rect-zero`, because `widget-layout` builds a fresh node
 rather than writing bounds into the one it is given.

  browser-click-code : BrowserState, Integer, Integer -> Integer
  browser-click-code (state) (mx) (my) =
    when state.bs-laid
      is None -> 0
      is Just (tree) ->
        when widget-find-at-point tree mx my
          is None -> 0
          is Just (widget-id) -> widget-id-code widget-id

 A click that lands on nothing is the common case -- it is every click on
 page background -- so it is the one that must not allocate. Writing the
 focus unconditionally costs 8 bytes each time, measured, and on a bump
 allocator inside a loop that never returns those become permanent. The
 guard makes the miss free.

  browser-focus-page : BrowserState -> BrowserState
  browser-focus-page (state) =
    when state.bs-focus
      is FocusPageContent -> state
      is FocusAddressBar -> __record-set state "bs-focus" FocusPageContent
      is FocusTrustPrompt -> __record-set state "bs-focus" FocusPageContent
      is FocusTabBar -> __record-set state "bs-focus" FocusPageContent

  browser-apply-page-code : BrowserState, Integer -> BrowserState
  browser-apply-page-code (state) (code) =
    if code == 0 then browser-focus-page state
    else if code < 10 then browser-navigate state (code-link-address code)
    else when browser-active-tab state
      is None -> state
      is Just (t) -> browser-apply-media-code state t code

  browser-apply-media-code : BrowserState, Tab, Integer -> BrowserState
  browser-apply-media-code (state) (t) (code) =
    when code-media-event code
      is None -> state
      is Just (mev) ->
        let updated = tab-media-event t mev
        in let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs updated)
        in __record-set s1 "bs-dirty" True

 The mark is stored beside the tree because only the holder of both can free
 it: the caller releases to `bs-laid-mark`, allocates the new state above it,
 and memoizes again. Whoever memoizes must take the mark BEFORE building the
 tree it stores.

  browser-memo-laid : BrowserState, WidgetNode, Integer -> BrowserState
  browser-memo-laid (state) (tree) (mark) =
    let s1 = __record-set state "bs-laid" (Just tree)
    in __record-set s1 "bs-laid-mark" mark

  widget-id-code : Text -> Integer
  widget-id-code (widget-id) =
    if widget-id == "link-hello" then 1
    else if widget-id == "link-about" then 2
    else if widget-id == "link-dash" then 3
    else if widget-id == "link-trust" then 4
    else if widget-id == "link-settings" then 5
    else if widget-id == "link-media" then 6
    else if widget-id == "media-play" then 11
    else if widget-id == "media-pause" then 12
    else if widget-id == "media-stop" then 13
    else if widget-id == "media-back" then 14
    else if widget-id == "media-fwd" then 15
    else if widget-id == "media-mute" then 16
    else if widget-id == "media-vol-up" then 17
    else if widget-id == "media-vol-down" then 18
    else if widget-id == "media-fs" then 19
    else 0

  code-link-address : Integer -> Text
  code-link-address (code) =
    if code == 1 then "codex://local/hello"
    else if code == 2 then "codex://local/about"
    else if code == 3 then "codex://local/dashboard"
    else if code == 4 then "codex://local/trust"
    else if code == 5 then "codex://local/settings"
    else if code == 6 then "codex://local/media"
    else ""

  code-media-event : Integer -> Maybe MediaEvent
  code-media-event (code) =
    if code == 11 then Just MediaPlay
    else if code == 12 then Just MediaPause
    else if code == 13 then Just MediaStop
    else if code == 14 then Just MediaSkipBack
    else if code == 15 then Just MediaSkipForward
    else if code == 16 then Just MediaToggleMute
    else if code == 17 then Just MediaVolumeUp
    else if code == 18 then Just MediaVolumeDown
    else if code == 19 then Just MediaToggleFullscreen
    else None

  widget-find-at-point : WidgetNode, Integer, Integer -> Maybe Text
  widget-find-at-point (node) (x) (y) =
    if rect-contains node.wn-bounds x y
    then if widget-is-leaf node
      then Just node.wn-id
      else find-child-at-point node.wn-children x y node.wn-id
    else None

  find-child-at-point : List WidgetNode, Integer, Integer, Text -> Maybe Text
  find-child-at-point (children) (x) (y) (parent-id) =
    if list-length children == 0 then Just parent-id
    else let head = list-at children 0
        in let hit = widget-find-at-point head x y
        in when hit
          is Just (id) -> Just id
          is None -> find-child-at-point (list-drop children 1) x y parent-id

Section: Address Bar Key Handling

  browser-handle-address-key : BrowserState, Integer -> BrowserState
  browser-handle-address-key (state) (k) =
    if k == 13
      then let address = address-bar-submit state.bs-address-bar
        in __record-set (browser-navigate state address) "bs-focus" FocusPageContent
      else if k == 27
      then __record-set state "bs-focus" FocusPageContent
      else if k == 8
      then let s1 = __record-set state "bs-address-bar" (address-bar-backspace state.bs-address-bar)
        in __record-set s1 "bs-dirty" True
      else if k >= 32
      then let ch = char-from-code k
        in let s1 = __record-set state "bs-address-bar" (address-bar-insert-char state.bs-address-bar ch)
        in __record-set s1 "bs-dirty" True
      else state

  char-from-code : Integer -> Text
  char-from-code (k) =
    char-to-text (code-to-char (from-unicode k))

Section: Page Key Handling

  browser-handle-page-key : BrowserState, Event, Integer -> BrowserState
  browser-handle-page-key (state) (ev) (k) =
    let active = browser-active-tab state
    in when active
      is None ->
        let action = map-key-event ev
        in browser-apply-action state action
      is Just (t) ->
        if tab-has-player t
        then let media-ev = map-media-key k
          in when media-ev
            is Just (mev) ->
              let updated = tab-media-event t mev
              in let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs updated)
              in __record-set s1 "bs-dirty" True
            is None ->
              let action = map-key-event ev
              in browser-apply-action state action
        else let action = map-key-event ev
          in browser-apply-action state action

Section: Media Tick

  browser-tick-media : BrowserState, Integer -> BrowserState
  browser-tick-media (state) (elapsed-ms) =
    let active = browser-active-tab state
    in when active
      is None -> state
      is Just (t) ->
        if tab-has-player t
        then let ticked = tab-media-tick t elapsed-ms
          in let needs-repaint = when ticked.tab-player
                is Just (ps) -> player-is-playing ps
                is None -> False
          in if needs-repaint
            then let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs ticked)
              in __record-set s1 "bs-dirty" True
            else __record-set state "bs-tabs" (tab-replace state.bs-tabs ticked)
        else state

Section: Page Scroll Handling

 The viewport is the chrome's third child and is found by position rather than
 by id, because the id is the PAGE's -- `tab-render-content` hands back whatever
 the page builder named its root, so there is no fixed name to look for.

  browser-laid-viewport : WidgetNode -> Maybe WidgetNode
  browser-laid-viewport (laid) =
    when widget-find laid "chrome"
      is None -> None
      is Just (ch) ->
        if ch.wn-child-count < 3 then None
        else let row = list-at (ch.wn-children) 2
        in if row.wn-child-count < 1 then Just row
        else let clip = list-at (row.wn-children) 0
        in if clip.wn-child-count < 1 then Just clip
        else Just (list-at (clip.wn-children) 0)

  browser-subtree-bottom : WidgetNode -> Integer
  browser-subtree-bottom (n) =
    let b = n.wn-bounds
    in browser-bottom-kids (n.wn-children) 0 (n.wn-child-count) (b.lr-y + b.lr-h)

  browser-bottom-kids : List WidgetNode, Integer, Integer, Integer -> Integer
  browser-bottom-kids (ks) (i) (n) (acc) =
    if i >= n then acc
    else let d = browser-subtree-bottom (list-at ks i)
    in browser-bottom-kids ks (i + 1) n (if d > acc then d else acc)

  browser-viewport-top : WidgetNode -> Integer
  browser-viewport-top (laid) =
    when browser-laid-viewport laid
      is None -> 0
      is Just (vp) -> let b = vp.wn-bounds in b.lr-y

  browser-viewport-extent : WidgetNode -> Integer
  browser-viewport-extent (laid) =
    when browser-laid-viewport laid
      is None -> 0
      is Just (vp) -> browser-subtree-bottom vp

 A tab is built by `tab-new` with a viewport of 0 by 0 and a content of 800 by
 600, which are placeholders: the tab exists before any layout has said how big
 either is. Until this ran, `scroll-by` clamped against those placeholders, so
 the offset it produced had nothing to do with the page on the glass.

 The height that matters is the VISIBLE one, `lh - vy`, not the viewport node's
 own `lr-h`. Those differ here and the difference is BROWSER-5's other half: a
 flex child is not shrunk below the minimum its content declares, so the node
 laid into the pane is taller than the pane and its own bounds cannot say how
 much of it a reader can see.

  browser-laid-clip : WidgetNode -> Maybe WidgetNode
  browser-laid-clip (laid) =
    when widget-find laid "chrome"
      is None -> None
      is Just (ch) ->
        if ch.wn-child-count < 3 then None
        else let row = list-at (ch.wn-children) 2
        in if row.wn-child-count < 1 then None
        else Just (list-at (row.wn-children) 0)

  browser-viewport-width : WidgetNode -> Integer
  browser-viewport-width (laid) =
    when browser-laid-clip laid
      is None -> 0
      is Just (vp) -> let b = vp.wn-bounds in b.lr-w

  browser-scroll-fit : BrowserState, Integer, Integer -> BrowserState
  browser-scroll-fit (state) (lw) (lh) =
    let mark = __heap-save
    in let laid = widget-layout (browser-render state) (state.bs-theme) (layout-rect 0 0 lw lh)
    in let vy = browser-viewport-top laid
    in let ext = browser-viewport-extent laid
    in let vw0 = browser-viewport-width laid
    in let dropped = __heap-restore mark
    in let vh = if lh - vy > 0 then lh - vy else 0
    in let ch = if ext - vy > 0 then ext - vy else 0
    in let vw = if vw0 > 0 then vw0 else lw
    in browser-set-scroll state vw vh ch

  browser-set-scroll : BrowserState, Integer, Integer, Integer -> BrowserState
  browser-set-scroll (state) (vw) (vh) (ch) =
    when browser-active-tab state
      is None -> state
      is Just (t) ->
        let old = t.tab-scroll
        in let sized = scroll-new vw vh vw ch
        in let fresh = scroll-to sized 0 (old.scr-offset-y)
        in let t1 = __record-set t "tab-scroll" fresh
        in __record-set state "bs-tabs" (tab-replace state.bs-tabs t1)

  browser-scroll-offset : BrowserState -> Integer
  browser-scroll-offset (state) =
    when browser-active-tab state
      is None -> 0
      is Just (t) -> let sc = t.tab-scroll in sc.scr-offset-y

  browser-scroll-page : BrowserState, Integer -> BrowserState
  browser-scroll-page (state) (delta) =
    let active = browser-active-tab state
    in when active
      is Just (t) ->
        let scrolled = tab-scroll-by t 0 (delta * 24)
        in let s1 = __record-set state "bs-tabs" (tab-replace state.bs-tabs scrolled)
        in __record-set s1 "bs-dirty" True
      is None -> state

Section: Render Pipeline

  browser-render-frame : BrowserState -> Framebuf
  browser-render-frame (state) =
    let tree = browser-render state
    in let full-rect = layout-rect 0 0 state.bs-window-width state.bs-window-height
    in let laid-out = widget-layout tree state.bs-theme full-rect
    in let fb = fb-new state.bs-window-width state.bs-window-height browser-bg
    in render-tree laid-out state.bs-theme fb

  browser-present : BrowserState, Framebuf -> Integer
  browser-present (state) (fb) =
    display-present state.bs-display fb

Section: Main Loop

  browser-run : BrowserState -> [Console] Nothing
  browser-run (state) = act
    print-line-uni "Codex Browser v0.1"
    print-line-uni ("  Window: " & show state.bs-window-width & "x" & show state.bs-window-height)
    print-line-uni ("  Tabs: " & show (list-length state.bs-tabs))
    print-line-uni ("  Cache: " & show (cache-size state.bs-cache) & " entries")
    print-line-uni "  Ready."
    browser-event-loop state
  end

  browser-event-loop : BrowserState -> [Console] Nothing
  browser-event-loop (state) = act
    let ticked = browser-tick-media state 16
    in let presented = if ticked.bs-dirty
          then let fb = browser-render-frame ticked
            in let w = browser-present ticked fb
            in __record-set ticked "bs-dirty" False
          else ticked
    in act
      ev <- browser-poll-event
      handled <- browser-dispatch-event presented ev
      browser-event-loop handled
    end
  end

  browser-dispatch-event : BrowserState, Event -> BrowserState
  browser-dispatch-event (state) (ev) =
    when ev.ev-kind
      is EvKeyDown (k) (mods) ->
        when state.bs-focus
          is FocusAddressBar -> browser-handle-address-key state k
          is FocusTrustPrompt -> browser-handle-trust-key state k
          is FocusPageContent -> browser-handle-page-key state ev k
          is otherwise ->
            let action = map-key-event ev
            in browser-apply-action state action
      is EvMouseDown (mx) (my) (btn) ->
        browser-handle-mouse-click state mx my
      is EvScroll (sx) (sy) (delta) ->
        browser-scroll-page state delta
      is EvResize (w) (h) ->
        let s1 = __record-set state "bs-window-width" w
        in let s2 = __record-set s1 "bs-window-height" h
        in __record-set s2 "bs-dirty" True
      is otherwise -> state

  browser-handle-trust-key : BrowserState, Integer -> BrowserState
  browser-handle-trust-key (state) (k) =
    if k == 27 then browser-trust-deny state
      else if k == 13 then browser-trust-allow-once state
      else state

  browser-apply-action : BrowserState, BrowserAction -> BrowserState
  browser-apply-action (state) (action) =
    when action
      is ActionNone -> state
      is ActionNewTab -> browser-new-tab state
      is ActionCloseTab -> browser-close-tab state state.bs-active-tab
      is ActionFocusAddress ->
        __record-set (__record-set state "bs-focus" FocusAddressBar) "bs-dirty" True
      is ActionReload -> browser-reload state
      is ActionBack -> browser-go-back state
      is ActionForward -> browser-go-forward state
      is ActionNextTab -> browser-next-tab state
      is ActionPrevTab -> browser-prev-tab state
      is ActionStop -> state
      is ActionNavigate (addr) -> browser-navigate state addr
      is ActionSwitchTab (id) -> browser-switch-tab state id
      is ActionAddressKey (ev) ->
        when ev.ev-kind
          is EvKeyDown (k) (mods) -> browser-handle-address-key state k
          is otherwise -> state
      is ActionPageEvent (ev) -> state
      is ActionScrollUp -> browser-scroll-page state (-3)
      is ActionScrollDown -> browser-scroll-page state 3
      is ActionPageUp ->
        let active = browser-active-tab state
        in when active
          is Just (t) -> __record-set state "bs-tabs" (tab-replace state.bs-tabs (tab-scroll-page-up t))
          is None -> state
      is ActionPageDown ->
        let active = browser-active-tab state
        in when active
          is Just (t) -> __record-set state "bs-tabs" (tab-replace state.bs-tabs (tab-scroll-page-down t))
          is None -> state
      is ActionHome ->
        let active = browser-active-tab state
        in when active
          is Just (t) -> __record-set state "bs-tabs" (tab-replace state.bs-tabs (tab-scroll-to-top t))
          is None -> state
      is ActionEnd -> state
