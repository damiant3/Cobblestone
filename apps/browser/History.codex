Chapter: History
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Browser chapter ContentAddress

 Global browsing history. Stores visited addresses with
 timestamps and titles for the history view and address bar
 autocomplete.

Section: Types

  HistoryEntry = record {
    he-address  : Text,
    he-title    : Text,
    he-visit-tick : Integer,
    he-visit-count : Integer
  }

  BrowsingHistory = record {
    bh-entries     : List HistoryEntry,
    bh-max-entries : Integer
  }

Section: Construction

  history-new : Integer -> BrowsingHistory
  history-new (max-entries) =
    BrowsingHistory {
      bh-entries = [],
      bh-max-entries = max-entries
    }

Section: Recording

  history-visit : BrowsingHistory, Text, Text, Integer -> BrowsingHistory
  history-visit (hist) (address) (title) (tick) =
    let existing = history-find hist.bh-entries address
    in when existing
      is Just (entry) ->
        let updated = __record-set (__record-set entry
          "he-visit-tick" tick)
          "he-visit-count" (entry.he-visit-count + 1)
        in __record-set hist
          "bh-entries" (history-replace hist.bh-entries updated)
      is None ->
        let entry = HistoryEntry {
          he-address = address,
          he-title = title,
          he-visit-tick = tick,
          he-visit-count = 1
        }
        in let entries = list-push hist.bh-entries entry
        in let trimmed = if list-length entries > hist.bh-max-entries
              then list-take entries hist.bh-max-entries
              else entries
        in __record-set hist "bh-entries" trimmed

Section: Lookup

  history-find : List HistoryEntry, Text -> Maybe HistoryEntry
  history-find (entries) (address) =
    if list-length entries == 0 then None
    else let head = list-at entries 0
        in if head.he-address == address
          then Just head
          else history-find (list-drop entries 1) address

  history-replace : List HistoryEntry, HistoryEntry -> List HistoryEntry
  history-replace (entries) (updated) =
    list-map (history-replace-one updated) entries

  history-replace-one : HistoryEntry -> HistoryEntry -> HistoryEntry
  history-replace-one (updated) (entry) =
    if entry.he-address == updated.he-address then updated else entry

Section: Search and Suggest

  history-suggest : BrowsingHistory, Text -> List HistoryEntry
  history-suggest (hist) (prefix) =
    if text-length prefix == 0 then history-recent hist 8
    else history-filter-prefix hist.bh-entries prefix [] 8

  history-filter-prefix : List HistoryEntry, Text, List HistoryEntry, Integer -> List HistoryEntry
  history-filter-prefix (entries) (prefix) (acc) (max-results) =
    if list-length acc >= max-results then acc
    else if list-length entries == 0 then acc
    else let head = list-at entries 0
        in let tail = list-drop entries 1
        in if text-contains head.he-address prefix
          then history-filter-prefix tail prefix (list-push acc head) max-results
          else if text-contains head.he-title prefix
          then history-filter-prefix tail prefix (list-push acc head) max-results
          else history-filter-prefix tail prefix acc max-results

  history-recent : BrowsingHistory, Integer -> List HistoryEntry
  history-recent (hist) (count) =
    list-take hist.bh-entries count

Section: Statistics

  history-count : BrowsingHistory -> Integer
  history-count (hist) = list-length hist.bh-entries

Section: Rendering

  history-render-suggestions : List HistoryEntry -> List Text
  history-render-suggestions (entries) =
    list-map format-history-entry entries

  format-history-entry : HistoryEntry -> Text
  format-history-entry (entry) =
    entry.he-title & " — " & entry.he-address
