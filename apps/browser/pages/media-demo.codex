Chapter: MediaDemoPage
  cites UI chapter Widget
  cites UI chapter Layout

 A sample page demonstrating the media player widget. In the
 full frame model, this page would declare [Display, Network, Audio]
 effects and bind to video/audio data channels from a server.
 For the MVP, it renders the player controls with static data.

Section: Page

  page-title : Text
  page-title = "Media Player Demo"

  page : Integer, Integer -> WidgetNode
  page (viewport-w) (viewport-h) =
    let heading = widget-label "title" "Codex Media Player"
    in let description = widget-label "desc"
          "A media player built from first principles. No HTML5 video element, no Flash, no codec plugins."
    in let sep = widget-separator "sep1"
    in let player-mock = render-mock-player viewport-w
    in let sep2 = widget-separator "sep2"
    in let info-heading = widget-label "info-title" "How Codex Media Works"
    in let info = widget-panel "info" DirColumn 4 [
          widget-label "i1" "1. A media page declares [Display, Network, Audio] effects.",
          widget-label "i2" "2. The server sends the compiled frame (CDX) — the player UI.",
          widget-label "i3" "3. Two typed data channels stream media: 'video' and 'audio'.",
          widget-label "i4" "4. Video packets: keyframes + delta frames, decoded locally.",
          widget-label "i5" "5. Audio packets: PCM or compressed, decoded to 48kHz 16-bit stereo.",
          widget-label "i6" "6. Decoded video frames blit to the VBE framebuffer.",
          widget-label "i7" "7. Decoded PCM writes to the Intel HDA controller via DMA.",
          widget-label "i8" "8. The capability gate ensures the page cannot exceed its declared effects."
        ]
    in let sep3 = widget-separator "sep3"
    in let codec-heading = widget-label "codec-title" "Supported Codecs"
    in let codecs = widget-panel "codecs" DirColumn 4 [
          widget-label "c1" "Audio: PCM (raw), WAV, MP3, Ogg Vorbis, FLAC",
          widget-label "c2" "Video: Raw RGB, MJPEG, Codex Native (keyframe + delta)",
          widget-label "c3" "Container: MP4, AVI, or raw stream (no container)"
        ]
    in widget-panel "media-demo" DirColumn 8 [
      heading, description, sep, player-mock, sep2,
      info-heading, info, sep3, codec-heading, codecs
    ]

  render-mock-player : Integer -> WidgetNode
  render-mock-player (w) =
    let video-area = widget-custom "mock-video" "" w 300
    in let play-btn = widget-button "media-play" ">"
    in let stop-btn = widget-button "media-stop" "[]"
    in let progress = widget-progress "media-progress" 42 100
    in let time = widget-label "media-time" "01:42 / 04:00"
    in let vol = widget-label "media-vol" "VOL:80"
    in let fs-btn = widget-button "media-fs" "[ ]"
    in let controls = widget-panel "controls" DirRow 8 [
          play-btn, stop-btn,
          widget-set-flex progress 1,
          time, vol, fs-btn
        ]
    in widget-panel "mock-player" DirColumn 0 [
      video-area,
      widget-set-min controls w 48
    ]
