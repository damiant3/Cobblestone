Chapter: AboutPage
  cites UI chapter Widget
  cites UI chapter RichText
  cites UI chapter Layout

 The browser's about page. Displays version, build info, and
 the capability model summary.

Section: Page

  page-title : Text
  page-title = "About Codex Browser"

  page : Integer, Integer -> WidgetNode
  page (viewport-w) (viewport-h) =
    let heading = widget-label "title" "Codex Browser v0.1"
    in let version-info = widget-label "version" "Built on the Codex self-sustaining compiler"
    in let cap-heading = widget-label "cap-title" "Capability Tiers"
    in let tier-static = widget-label "t-static" "Static [Display] — no consent needed"
    in let tier-connected = widget-label "t-conn" "Connected [Display, Network] — implicit for trusted"
    in let tier-interactive = widget-label "t-inter" "Interactive [Display, Network, Storage] — prompted"
    in let tier-sensor = widget-label "t-sensor" "Sensor [Display, ..., Camera] — explicit per-device"
    in let tier-system = widget-label "t-system" "System [Display, ..., FileSystem] — explicit + high trust"
    in let addr-heading = widget-label "addr-title" "Addressing"
    in let addr-info = widget-label "addr-info" "Content-addressed (SHA-256). No DNS. No certificate authorities."
    in widget-panel "about" DirColumn 6 [
      heading, version-info,
      widget-separator "sep1",
      cap-heading, tier-static, tier-connected,
      tier-interactive, tier-sensor, tier-system,
      widget-separator "sep2",
      addr-heading, addr-info
    ]
