Chapter: DashboardPage
  cites UI chapter Widget
  cites UI chapter RichText
  cites UI chapter Layout
  cites Foreword chapter ListUtils

 A sample data-bound page demonstrating the frame model. This
 page declares a data binding for a list of status items. In
 the real frame model the data would stream from a server; here
 it uses inline data for testing.

Section: Types

  StatusItem = record {
    si-name   : Text,
    si-value  : Text,
    si-status : Integer
  }

Section: Sample Data

  sample-items : List StatusItem
  sample-items = [
    StatusItem { si-name = "Compiler", si-value = "Fixed point", si-status = 1 },
    StatusItem { si-name = "Test Battery", si-value = "105/105", si-status = 1 },
    StatusItem { si-name = "Seed Hash", si-value = "3a7b9c4d...", si-status = 1 },
    StatusItem { si-name = "Network", si-value = "Connected", si-status = 1 },
    StatusItem { si-name = "Trust Store", si-value = "3 publishers", si-status = 0 }
  ]

Section: Page

  page-title : Text
  page-title = "System Dashboard"

  page : Integer, Integer -> WidgetNode
  page (viewport-w) (viewport-h) =
    let heading = widget-label "title" "System Dashboard"
    in let items = list-map render-status-item sample-items
    in widget-panel "dashboard" DirColumn 4 (heading :: items)

  render-status-item : StatusItem -> WidgetNode
  render-status-item (item) =
    let indicator = if item.si-status == 1
          then widget-label "ok" "[OK]"
          else widget-label "warn" "[!!]"
    in let name = widget-label "name" item.si-name
    in let value = widget-label "value" item.si-value
    in widget-panel item.si-name DirRow 8 [indicator, name, value]
