Chapter: HelloPage
  cites UI chapter Widget
  cites UI chapter RichText
  cites UI chapter Layout

 The simplest possible Codex page. Produces a widget tree with
 a heading and a paragraph. No effects beyond Display.

Section: Page

  page-title : Text
  page-title = "Hello, Codex"

  page : Integer, Integer -> WidgetNode
  page (viewport-w) (viewport-h) =
    let heading = widget-label "title" "Hello, Codex"
    in let body = widget-label "body" "This is the first page rendered by the Codex Browser."
    in let footer = widget-label "footer" "Built from first principles. No HTML. No CSS. No JavaScript."
    in widget-panel "page" DirColumn 8 [
      widget-set-min heading viewport-w 32,
      widget-set-min body viewport-w 24,
      widget-set-min footer viewport-w 24
    ]
