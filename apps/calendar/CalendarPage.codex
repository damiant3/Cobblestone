Chapter: CalendarPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Calendar app with month, week, day, and agenda views.

 We say:

Section: Theme

  calendar-theme : Theme
  calendar-theme =
    let p = Palette { pal-bg = #111111, pal-fg = #D8D8D8, pal-primary = #4490FF, pal-secondary = #1B1B1B, pal-accent = #FF9900, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #262626 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "calendar-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  calendar-css : Text
  calendar-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#111;color:#d8d8d8;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".calendar{display:grid;grid-template-columns:240px 1fr;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;color:#449dff}"
    & ".new-event-btn{margin:0 16px 16px;padding:10px;background:#449dff;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;width:calc(100% - 32px);text-align:center}"
    & ".new-event-btn:hover{background:#3388ee}"
    & ".mini-cal{padding:8px 16px;margin-bottom:16px}"
    & ".mini-month{font-size:13px;font-weight:600;text-align:center;margin-bottom:8px;color:#ccc}"
    & ".mini-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center;font-size:11px}"
    & ".mini-dow{color:#666;padding:4px 0;font-weight:600}"
    & ".mini-day{padding:4px 0;border-radius:4px;cursor:pointer;color:#999}"
    & ".mini-day:hover{background:#1a1a1a;color:#ddd}"
    & ".mini-day.today{background:#449dff;color:#fff;font-weight:700}"
    & ".mini-day.selected{border:1px solid #449dff;color:#449dff}"
    & ".mini-day.other-month{color:#444}"
    & ".cal-list{padding:0 16px}"
    & ".cal-list-title{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}"
    & ".cal-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:13px;color:#999}"
    & ".cal-item:hover{background:#1a1a1a;color:#ddd}"
    & ".cal-item.off{opacity:.35}"
    & ".cal-item.off .cal-dot{filter:grayscale(1)}"
    & ".cal-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}"
    & ".main{display:flex;flex-direction:column;overflow:hidden}"
    & ".cal-toolbar{display:flex;align-items:center;gap:12px;padding:12px 24px;border-bottom:1px solid #222;background:#141414}"
    & ".cal-toolbar .wk-btn{background:#222;border:1px solid #333;color:#ccc;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".cal-toolbar .wk-btn:hover{background:#2a2a2a}"
    & ".cal-toolbar-title{font-size:18px;font-weight:600;color:#fff;flex:1}"
    & ".view-btns{display:flex;gap:2px;background:#1a1a1a;border-radius:6px;padding:2px}"
    & ".view-btn{padding:6px 14px;border-radius:4px;font-size:12px;color:#888;cursor:pointer;border:none;background:none}"
    & ".view-btn:hover{color:#ddd}"
    & ".view-btn.active{background:#449dff;color:#fff}"
    & ".month-grid{display:grid;grid-template-columns:repeat(7,1fr);flex:1;overflow-y:auto}"
    & ".dow-hdr{padding:8px;text-align:center;font-size:11px;color:#666;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid #1a1a1a;font-weight:600}"
    & ".day-cell{border:1px solid #1a1a1a;padding:6px 8px;min-height:100px;cursor:pointer;transition:background .1s}"
    & ".day-cell:hover{background:#161616}"
    & ".day-cell.today{background:#0a1a2a}"
    & ".day-cell.selected-day{background:#0d2240;border-color:#449dff}"
    & ".day-cell.other{opacity:.4}"
    & ".day-num{font-size:12px;font-weight:600;margin-bottom:4px;color:#888}"
    & ".day-cell.today .day-num{color:#449dff;font-weight:700}"
    & ".day-event{font-size:11px;padding:2px 6px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer}"
    & ".day-event:hover{filter:brightness(1.2)}"
    & ".day-more{font-size:10px;color:#666;padding:2px 6px}"
    & ".event-badge{font-size:10px;color:#888;padding:2px 6px;font-style:italic}"
    & ".week-grid{display:grid;grid-template-columns:60px repeat(7,1fr);flex:1;overflow-y:auto}"
    & ".time-label{padding:4px 8px;font-size:10px;color:#555;text-align:right;border-right:1px solid #1a1a1a;height:48px}"
    & ".week-col{border-left:1px solid #1a1a1a}"
    & ".week-slot{height:48px;border-bottom:1px solid #111;padding:1px 4px}"
    & ".week-slot:hover{background:#161616}"
    & ".working-hour{background:#0a1520}"
    & ".working-hour:hover{background:#0e1d2e}"
    & ".day-view{flex:1;overflow-y:auto;display:grid;grid-template-columns:60px 1fr}"
    & ".day-hour{height:60px;border-bottom:1px solid #111;padding:1px 4px}"
    & ".day-hour:hover{background:#161616}"
    & ".day-hour.working-hour{background:#0a1520}"
    & ".day-hour.working-hour:hover{background:#0e1d2e}"
    & ".agenda{flex:1;overflow-y:auto;padding:24px}"
    & ".agenda-date{font-size:14px;font-weight:600;color:#449dff;padding:16px 0 8px;border-bottom:1px solid #1a1a1a;margin-bottom:8px}"
    & ".agenda-event{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #111;align-items:center}"
    & ".agenda-time{font-size:12px;color:#666;min-width:80px}"
    & ".agenda-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}"
    & ".agenda-info{flex:1}"
    & ".agenda-title{font-size:14px;font-weight:500;margin-bottom:2px}"
    & ".agenda-loc{font-size:12px;color:#666}"
    & ".event-form{background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:16px;margin:0 16px 16px}"
    & ".event-form-title{font-size:14px;font-weight:600;color:#fff;margin-bottom:12px}"
    & ".event-form-field{margin-bottom:10px}"
    & ".event-form-label{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}"
    & ".event-form-input{width:100%;padding:8px 10px;background:#222;border:1px solid #333;border-radius:6px;color:#ddd;font-size:13px}"
    & ".event-form-btns{display:flex;gap:8px;margin-top:12px}"
    & ".event-form .save-btn{flex:1;padding:8px;background:#449dff;color:#fff;border:none;border-radius:6px;font-size:13px;cursor:pointer}"
    & ".event-form .save-btn:hover{background:#3388ee}"
    & ".event-form .cancel-btn{flex:1;padding:8px;background:#333;color:#ccc;border:none;border-radius:6px;font-size:13px;cursor:pointer}"
    & ".event-form .cancel-btn:hover{background:#444}"
    & ".event-detail{background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:16px;margin:0 16px 16px}"
    & ".event-detail-title{font-size:15px;font-weight:600;color:#449dff;margin-bottom:8px}"
    & ".event-detail-row{font-size:13px;color:#aaa;margin-bottom:6px}"
    & ".event-detail-close{font-size:12px;color:#888;cursor:pointer;text-align:right;margin-top:8px}"
    & ".event-detail-close:hover{color:#fff}"
    & ".toggle-all-btn{margin:8px 0;padding:6px 8px;background:#222;border:1px solid #333;color:#999;border-radius:6px;cursor:pointer;font-size:11px;width:100%;text-align:center}"
    & ".toggle-all-btn:hover{background:#2a2a2a;color:#ddd}"
    & ".recurring-icon{font-size:10px;margin-left:2px}"

Section: Date Helpers

  month-name : Integer -> Text
  month-name (m) =
    if m == 1 then "January"
    else if m == 2 then "February"
    else if m == 3 then "March"
    else if m == 4 then "April"
    else if m == 5 then "May"
    else if m == 6 then "June"
    else if m == 7 then "July"
    else if m == 8 then "August"
    else if m == 9 then "September"
    else if m == 10 then "October"
    else if m == 11 then "November"
    else "December"

  days-in-month : Integer, Integer -> Integer
  days-in-month (m) (y) =
    if m == 2 then if (y / 4) * 4 == y then 29 else 28
    else if m == 4 then 30
    else if m == 6 then 30
    else if m == 9 then 30
    else if m == 11 then 30
    else 31

  current-title : Integer -> Text
  current-title (x) =
    let m = state-get "cur-month"
    in let y = state-get "cur-year"
    in month-name m & " " & show y

Section: Mini Calendar Builder

  build-mini-dow : Integer -> List WidgetNode
  build-mini-dow (x) =
    [widget-label "md-su" "Su", widget-label "md-mo" "Mo", widget-label "md-tu" "Tu", widget-label "md-we" "We", widget-label "md-th" "Th", widget-label "md-fr" "Fr", widget-label "md-sa" "Sa"]

  build-mini-days : Integer, Integer, Integer, Integer -> List WidgetNode
  build-mini-days (day) (max) (today) (i) =
    if day > max then []
    else let base = if day == today then "mini-day today" else "mini-day"
    in let cls = if state-get "mini-selected" == i + 1 then base & " selected" else base
    in let id = "md-" & show i
    in widget-add-child (widget-custom id ("boxc:" & cls) 0 0) (widget-label (id & "l") (show day)) :: build-mini-days (day + 1) max today (i + 1)

Section: Month Grid Builder

  build-dow-headers : Integer -> List WidgetNode
  build-dow-headers (x) =
    [widget-label "dh-su" "SUN", widget-label "dh-mo" "MON", widget-label "dh-tu" "TUE", widget-label "dh-we" "WED", widget-label "dh-th" "THU", widget-label "dh-fr" "FRI", widget-label "dh-sa" "SAT"]

  build-day-cell : Text, Text, Text, List WidgetNode -> WidgetNode
  build-day-cell (id) (cls) (num) (events) =
    widget-box id ("day-cell" & (if text-length cls > 0 then " " & cls else "")) (widget-add-child (widget-custom (id & "n") "box:day-num" 0 0) (widget-label (id & "nl") num) :: events)

  day-event : Text, Text, Text -> WidgetNode
  day-event (id) (title) (color) =
    widget-add-child (widget-custom id "box:day-event" 0 0) (widget-label (id & "t") title)

  day-event-recurring : Text, Text, Text -> WidgetNode
  day-event-recurring (id) (title) (color) =
    widget-add-child (widget-custom id "box:day-event" 0 0) (widget-label (id & "t") (title & " &#x1F501;"))

  event-count-badge : Text, Integer -> List WidgetNode
  event-count-badge (id) (count) =
    if count >= 2 then [widget-label (id & "badge") (show count & " events")]
    else []

  build-month-days : Integer, Integer, Integer -> List WidgetNode
  build-month-days (day) (max) (i) =
    if day > max then []
    else let id = "dc-" & show i
    in let sel = state-get "selected-day"
    in let cls = if day == 8 then (if sel == day then "today selected-day" else "today") else (if sel == day then "selected-day" else "")
    in let evts = if day == 3 then [day-event (id & "e1") "Doctor Appt" "#e6a817"]
    else if day == 5 then [day-event (id & "e1") "Team Offsite" "#9c27b0"]
    else if day == 8 then [day-event-recurring (id & "e1") "Team Standup" "#449dff", day-event (id & "e2") "Design Review" "#e65100"] & event-count-badge id 2
    else if day == 10 then [day-event-recurring (id & "e1") "Sprint Planning" "#2e7d32"]
    else if day == 12 then [day-event (id & "e1") "Lunch with Sarah" "#e6a817"]
    else if day == 15 then [day-event (id & "e1") "Product Demo" "#449dff", day-event (id & "e2") "Team Retro" "#9c27b0"] & event-count-badge id 2
    else if day == 18 then [day-event (id & "e1") "Board Meeting" "#d32f2f"]
    else if day == 20 then [day-event (id & "e1") "All Hands" "#d32f2f"]
    else if day == 22 then [day-event (id & "e1") "Dentist" "#e6a817"]
    else if day == 25 then [day-event (id & "e1") "Project Deadline" "#d32f2f", day-event (id & "e2") "Celebration" "#2e7d32"] & event-count-badge id 2
    else if day == 28 then [day-event (id & "e1") "Code Review Day" "#449dff"]
    else []
    in let user-evts = user-events-for-day day 0 (state-get "evt-count") id []
    in build-day-cell id cls (show day) (evts & user-evts) :: build-month-days (day + 1) max (i + 1)

Section: Agenda Builder

  agenda-entry : Text, Text, Text, Text, Text, Text -> WidgetNode
  agenda-entry (id) (time) (color) (title) (loc) (cal) =
    widget-box id "agenda-event" [
      widget-label (id & "t") time,
      widget-label (id & "d") "",
      widget-box (id & "i") "agenda-info" [
        widget-label (id & "n") title,
        widget-label (id & "l") (loc & " &#x2022; " & cal)
      ]
    ]

  agenda-entry-recurring : Text, Text, Text, Text, Text, Text -> WidgetNode
  agenda-entry-recurring (id) (time) (color) (title) (loc) (cal) =
    widget-box id "agenda-event" [
      widget-label (id & "t") time,
      widget-label (id & "d") "",
      widget-box (id & "i") "agenda-info" [
        widget-label (id & "n") (title & " &#x1F501;"),
        widget-label (id & "l") (loc & " &#x2022; " & cal)
      ]
    ]

Section: Event Form

  event-form-widget : Integer -> WidgetNode
  event-form-widget (x) =
    let sel = state-get "selected-day"
    in widget-box "evt-form" "event-form" [
      widget-label "ef-title" "New Event",
      widget-box "ef-f1" "event-form-field" [
        widget-label "ef-l1" "TITLE",
        wk-attach (widget-custom "ef-title-input" "input" 0 0) [widget-label "ef-tv" (state-get-text "new-evt-title"), widget-label "ef-tp" "Event title..."] 0 2
      ],
      widget-box "ef-f2" "event-form-field" [
        widget-label "ef-l2" "TIME",
        wk-attach (widget-custom "ef-time-input" "input" 0 0) [widget-label "ef-tmv" (state-get-text "new-evt-time"), widget-label "ef-tmp" "e.g. 10:00 AM"] 0 2
      ],
      widget-box "ef-f3" "event-form-field" [
        widget-label "ef-l3" "DATE",
        widget-label "ef-i3" (if sel > 0 then (current-title 0 & " " & show sel) else current-title 0)
      ],
      widget-box "ef-btns" "event-form-btns" [
        widget-button "save-event" "Save",
        widget-button "cancel-event" "Cancel"
      ]
    ]

Section: Event Detail

  user-event-titles-for-day : Integer, Integer, Integer, Text -> Text
  user-event-titles-for-day (day) (i) (count) (acc) =
    if i >= count then acc
    else let d = state-get ("evt-day-" & show i)
    in if d == day then let title = state-get-text ("evt-title-" & show i)
      in let sep = if text-length acc > 0 then ", " else ""
      in user-event-titles-for-day day (i + 1) count (acc & sep & title)
    else user-event-titles-for-day day (i + 1) count acc

  event-detail-for-day : Integer -> WidgetNode
  event-detail-for-day (day) =
    let builtin-title = if day == 3 then "Doctor Appt"
      else if day == 5 then "Team Offsite"
      else if day == 8 then "Team Standup, Design Review"
      else if day == 10 then "Sprint Planning"
      else if day == 12 then "Lunch with Sarah"
      else if day == 15 then "Product Demo, Team Retro"
      else if day == 18 then "Board Meeting"
      else if day == 20 then "All Hands"
      else if day == 22 then "Dentist"
      else if day == 25 then "Project Deadline, Celebration"
      else if day == 28 then "Code Review Day"
      else ""
    in let user-titles = user-event-titles-for-day day 0 (state-get "evt-count") ""
    in let all-titles = if text-length builtin-title > 0 then (if text-length user-titles > 0 then builtin-title & ", " & user-titles else builtin-title) else (if text-length user-titles > 0 then user-titles else "No events")
    in let cal = if day == 3 then "Personal"
      else if day == 5 then "Work"
      else if day == 12 then "Personal"
      else if day == 22 then "Personal"
      else "Work"
    in widget-box "evt-detail" "event-detail" [
      widget-label "ed-title" all-titles,
      widget-label "ed-day" ("Day: " & show day),
      widget-label "ed-cal" ("Calendar: " & cal),
      widget-button "close-detail" "&#x2716; Close"
    ]

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let view = state-get "view"
    in widget-box "calendar" "calendar" [
      sidebar-tree 0,
      main-view view
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    let show-form = state-get "event-form"
    in let sel = state-get "selected-day"
    in widget-box "sidebar" "sidebar" ([
      widget-label "brand" "CodexCalendar",
      widget-button "new-event" "&#x2795; New Event"]
      & (if show-form == 1 then [event-form-widget 0] else [])
      & (if sel > 0 then [event-detail-for-day sel] else [])
      & [widget-box "mini" "mini-cal" [
        widget-label "mini-month" (current-title 0),
        widget-box "mini-grid" "mini-grid" (build-mini-dow 0 & build-mini-days 1 (days-in-month (state-get "cur-month") (state-get "cur-year")) 8 0)
      ],
      widget-box "cals" "cal-list" [
        widget-label "cal-hdr" "Calendars",
        widget-button "toggle-all-cals" "Show All",
        cal-item "ci-personal" "#449dff" "Personal",
        cal-item "ci-work" "#2e7d32" "Work",
        cal-item "ci-family" "#e6a817" "Family",
        cal-item "ci-holidays" "#d32f2f" "Holidays"
      ]]
    )

  cal-item : Text, Text, Text -> WidgetNode
  cal-item (id) (color) (name) =
    widget-box-click id (if state-get id == 1 then "cal-item off" else "cal-item") [
      widget-label (id & "d") "&#x25CF;",
      widget-label (id & "n") name
    ]

  main-view : Integer -> WidgetNode
  main-view (view) =
    widget-box "main" "main" [
      cal-toolbar view,
      if view == 1 then week-view 0
      else if view == 2 then day-view 0
      else if view == 3 then agenda-view 0
      else month-view 0
    ]

  cal-toolbar : Integer -> WidgetNode
  cal-toolbar (view) =
    widget-box "toolbar" "cal-toolbar" [
      widget-button "prev" "&#x276E;",
      widget-button "today" "Today",
      widget-button "next" "&#x276F;",
      widget-label "cal-title" (current-title 0),
      widget-box "views" "view-btns" [
        widget-box-click "v-month" (if view == 0 then "view-btn active" else "view-btn") [ widget-label "vm-l" "Month" ],
        widget-box-click "v-week" (if view == 1 then "view-btn active" else "view-btn") [ widget-label "vw-l" "Week" ],
        widget-box-click "v-day" (if view == 2 then "view-btn active" else "view-btn") [ widget-label "vd-l" "Day" ],
        widget-box-click "v-agenda" (if view == 3 then "view-btn active" else "view-btn") [ widget-label "va-l" "Agenda" ]
      ]
    ]

  month-view : Integer -> WidgetNode
  month-view (x) =
    widget-box "month" "month-grid" (build-dow-headers 0 & build-month-days 1 (days-in-month (state-get "cur-month") (state-get "cur-year")) 0)

  week-view : Integer -> WidgetNode
  week-view (x) =
    widget-box "week" "week-grid" [
      widget-label "wk-corner" "",
      widget-label "wk-sun" "SUN 7",
      widget-label "wk-mon" "MON 8",
      widget-label "wk-tue" "TUE 9",
      widget-label "wk-wed" "WED 10",
      widget-label "wk-thu" "THU 11",
      widget-label "wk-fri" "FRI 12",
      widget-label "wk-sat" "SAT 13",
      widget-label "t-8" "8 AM",
      widget-label "ws-8-0" "", widget-label "ws-8-1" "", widget-label "ws-8-2" "", widget-label "ws-8-3" "", widget-label "ws-8-4" "", widget-label "ws-8-5" "", widget-label "ws-8-6" "",
      widget-label "t-9" "9 AM",
      widget-label "ws-9-0" "", widget-label "ws-9-1" "Team Standup &#x1F501;", widget-label "ws-9-2" "", widget-label "ws-9-3" "", widget-label "ws-9-4" "", widget-label "ws-9-5" "", widget-label "ws-9-6" "",
      widget-label "t-10" "10 AM",
      widget-label "ws-10-0" "", widget-label "ws-10-1" "Design Review", widget-label "ws-10-2" "", widget-label "ws-10-3" "", widget-label "ws-10-4" "", widget-label "ws-10-5" "", widget-label "ws-10-6" "",
      widget-label "t-11" "11 AM",
      widget-label "ws-11-0" "", widget-label "ws-11-1" "", widget-label "ws-11-2" "", widget-label "ws-11-3" "", widget-label "ws-11-4" "", widget-label "ws-11-5" "", widget-label "ws-11-6" "",
      widget-label "t-12" "12 PM",
      widget-label "ws-12-0" "", widget-label "ws-12-1" "", widget-label "ws-12-2" "Lunch with Sarah", widget-label "ws-12-3" "", widget-label "ws-12-4" "", widget-label "ws-12-5" "", widget-label "ws-12-6" "",
      widget-label "t-1" "1 PM",
      widget-label "ws-1-0" "", widget-label "ws-1-1" "", widget-label "ws-1-2" "", widget-label "ws-1-3" "", widget-label "ws-1-4" "", widget-label "ws-1-5" "", widget-label "ws-1-6" "",
      widget-label "t-2" "2 PM",
      widget-label "ws-2-0" "", widget-label "ws-2-1" "", widget-label "ws-2-2" "", widget-label "ws-2-3" "", widget-label "ws-2-4" "Sprint Planning &#x1F501;", widget-label "ws-2-5" "", widget-label "ws-2-6" "",
      widget-label "t-3" "3 PM",
