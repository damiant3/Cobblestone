Section: User Events

  user-events-for-day : Integer, Integer, Integer, Text, List WidgetNode -> List WidgetNode
  user-events-for-day (day) (i) (count) (prefix) (acc) =
    if i >= count then acc
    else let d = state-get ("evt-day-" & show i)
    in if d == day then let title = state-get-text ("evt-title-" & show i)
      in let evt = day-event (prefix & "u" & show i) title "#41af4e"
      in user-events-for-day day (i + 1) count prefix (list-push acc evt)
    else user-events-for-day day (i + 1) count prefix acc

  save-event : Integer -> Integer
  save-event (x) =
    let title = state-get-text "new-evt-title"
    in if text-length title == 0 then 0
    else let count = state-get "evt-count"
    in let sel = state-get "selected-day"
    in let day = if sel > 0 then sel else 1
    in let s1 = state-set-text ("evt-title-" & show count) title
    in let s2 = state-set ("evt-day-" & show count) day
    in let s3 = state-set-text ("evt-time-" & show count) (state-get-text "new-evt-time")
    in let s4 = state-set-text ("evt-cal-" & show count) "personal"
    in let s5 = state-set "evt-count" (count + 1)
    in let s6 = state-set-text "new-evt-title" ""
    in let s7 = state-set-text "new-evt-time" ""
    in let s8 = state-set-render "event-form" 0
    in 0

  calendar-input : Text, Text -> Integer
  calendar-input (id) (value) =
    if id == "ef-title-input" then let s = state-set-text "new-evt-title" value in 0
    else if id == "ef-time-input" then let s = state-set-text "new-evt-time" value in 0
    else 0

Section: Handlers

  navigate-month : Integer -> Integer
  navigate-month (dir) =
    let m = state-get "cur-month"
    in let y = state-get "cur-year"
    in let nm = m + dir
    in if nm < 1 then let s1 = state-set "cur-month" 12 in let s2 = state-set-render "cur-year" (y - 1) in 0
    else if nm > 12 then let s1 = state-set "cur-month" 1 in let s2 = state-set-render "cur-year" (y + 1) in 0
    else let s1 = state-set-render "cur-month" nm in 0

  toggle-all-cals : Integer -> Integer
  toggle-all-cals (x) =
    let all-off = state-get "all-cals-off"
    in let val = if all-off == 1 then 0 else 1
    in let s1 = state-set "ci-personal" val
    in let s2 = state-set "ci-work" val
    in let s3 = state-set "ci-family" val
    in let s4 = state-set "ci-holidays" val
    in let s5 = state-set-render "all-cals-off" (1 - all-off)
    in 0

  calendar-click : Text -> Integer
  calendar-click (id) =
    if id == "v-month" then let s = state-set-render "view" 0 in 0
    else if id == "v-week" then let s = state-set-render "view" 1 in 0
    else if id == "v-day" then let s = state-set-render "view" 2 in 0
    else if id == "v-agenda" then let s = state-set-render "view" 3 in 0
    else if id == "new-event" then let s = state-set-render "event-form" (1 - state-get "event-form") in 0
    else if id == "save-event" then save-event 0
    else if id == "cancel-event" then let s = state-set-render "event-form" 0 in 0
    else if id == "close-detail" then let s = state-set-render "selected-day" 0 in 0
    else if id == "today" then let s1 = state-set "selected-day" 8 in let s2 = state-set "cur-month" 6 in let s3 = state-set-render "cur-year" 2026 in 0
    else if id == "prev" then navigate-month (-1)
    else if id == "next" then navigate-month 1
    else if id == "toggle-all-cals" then toggle-all-cals 0
    else if id == "ci-personal" then let s = state-set-render "ci-personal" (1 - state-get "ci-personal") in 0
    else if id == "ci-work" then let s = state-set-render "ci-work" (1 - state-get "ci-work") in 0
    else if id == "ci-family" then let s = state-set-render "ci-family" (1 - state-get "ci-family") in 0
    else if id == "ci-holidays" then let s = state-set-render "ci-holidays" (1 - state-get "ci-holidays") in 0
    else if text-starts-with id "md-" then let d = id-num id + 1 in let s1 = state-set "mini-selected" d in let s2 = state-set-render "selected-day" d in 0
    else if text-starts-with id "dc-" then let d = id-num id + 1 in let s = state-set-render "selected-day" d in 0
    else 0

Section: Entry

  render-calendar : Integer -> Integer
  render-calendar (x) = mount-widget-themed calendar-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style calendar-theme calendar-css
    in let s1 = state-set "cur-month" 6
    in let s2 = state-set "cur-year" 2026
    in let s3 = state-set "selected-day" 0
    in let s4 = state-set "event-form" 0
    in let s5 = state-set "all-cals-off" 0
    in let s6 = state-set "evt-count" 0
    in let s7 = state-set-text "new-evt-title" ""
    in let s8 = state-set-text "new-evt-time" ""
    in let s = set-render render-calendar
    in let h = register-handlers no-pick calendar-click
    in let hi = register-input-handler calendar-input
    in render-calendar 0
  end

