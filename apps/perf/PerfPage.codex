Chapter: PerfPage
  cites Site chapter SiteTheme

 Performance benchmarks &mdash; Codex vs production C compilers on three
 architectures. Instruction counts, not wall-clock. No optimization
 flags needed &mdash; the compiler is the optimizer.

 We say:

Section: CSS

  perf-extra-css : Text
  perf-extra-css =
    ".perf{max-width:1100px;margin:0 auto;padding:0 24px}"
    & ".hero-sub>.wk-label{display:inline}"
    & ".hero-sub>.em-text{display:inline;font-style:italic;color:#d4a017}"
    & ".hero-sub>.em-text>.wk-label{display:inline}"
    & ".em-text{display:inline;font-style:italic;color:#d4a017}"
    & ".em-text>.wk-label{display:inline}"
    & ".bench-summary-item>.wk-label{display:inline}"
    & ".bench-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}"
    & ".bench-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;text-align:center;transition:border-color .2s,transform .2s}"
    & ".bench-card:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".bench-card>.wk-label:first-child{font-size:14px;font-weight:700;color:#d4a017;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".bench-card>.wk-label:nth-child(2){font-size:13px;color:#8b949e;margin-bottom:4px}"
    & ".bench-card>.wk-label:nth-child(3){font-size:13px;color:#8b949e;margin-bottom:12px}"
    & ".bench-card>.wk-label:nth-child(4){font-size:28px;font-weight:800;margin-bottom:4px}"
    & ".bench-card>.wk-label:last-child{font-size:12px;color:#8b949e}"
    & ".bench-win>.wk-label:nth-child(4){color:#41AF4E}"
    & ".bench-tie>.wk-label:nth-child(4){color:#9ba7b4}"
    & ".bench-loss>.wk-label:nth-child(4){color:#EC4D30}"
    & ".bench-summary{text-align:center;margin-top:24px;padding:16px;background:rgba(20,20,30,.5);border-radius:8px;border:1px solid #1e1e2e}"
    & ".bench-summary>.wk-label{font-size:15px;color:#9ba7b4;line-height:1.6}"
    & ".story-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}"
    & ".story-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;transition:border-color .2s}"
    & ".story-card:hover{border-color:#d4a017}"
    & ".story-card>.wk-label:first-child{font-size:24px;margin-bottom:12px}"
    & ".story-card>.wk-label:nth-child(2){font-size:16px;font-weight:700;color:#fff;margin-bottom:8px}"
    & ".story-card>.wk-label:nth-child(3){font-size:14px;color:#8b949e;line-height:1.6}"
    & ".method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}"
    & ".method-card{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px}"
    & ".method-card>.wk-label:first-child{font-size:14px;font-weight:700;color:#d4a017;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}"
    & ".method-card>.wk-label:last-child{font-size:14px;color:#8b949e;line-height:1.6}"
    & "@media(max-width:768px){.bench-grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:1fr}.method-grid{grid-template-columns:1fr}}"

Section: Tree

  perf-hero : WidgetNode
  perf-hero =
    widget-box "hero" "hero" [
      widget-label "badge" "Instruction Counts &#x2022; Three Architectures &#x2022; No Flags",
      widget-label "h-title" "BENCHMARK",
      widget-box "h-sub" "hero-sub" [widget-label "h-sub-t" "Codex vs production C compilers on three architectures. Instruction counts, not wall-clock. ", widget-box "h-sub-e" "em-text" [widget-label "h-sub-et" "No optimization flags needed &mdash; the compiler is the optimizer."]],
      widget-box "stats" "hero-stats" [site-stat "s0" "3" "Architectures", site-stat "s1" "4" "Benchmarks", site-stat "s2" "-91.7%" "Best Win (fib)", site-stat "s3" "3 mo" "Compiler Age"]
    ]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      site-nav [
        widget-label "nl0" "x86-64",
        widget-label "nl1" "ARM64",
        widget-label "nl2" "RISC-V",
        widget-label "nl3" "The Story",
        widget-label "nl4" "Methodology"
      ],
      perf-hero,
      widget-box "body" "perf" [
        x86-section 0,
        arm-section 0,
        riscv-section 0,
        story-section 0,
        method-section 0,
        site-footer [
          widget-label "fl0" "GitHub",
          widget-label "fl1" "Documentation",
          widget-label "fl2" "Benchmarks",
          widget-label "fl3" "Home"
        ]
      ]
    ]

Section: Bench Card

  bench-card : Text, Text, Text, Text, Text, Text, Text -> WidgetNode
  bench-card (id) (cls) (name) (baseline) (codex) (delta) (note) =
    widget-box id cls [
      widget-label (id & "n") name,
      widget-label (id & "b") baseline,
      widget-label (id & "c") codex,
      widget-label (id & "d") delta,
      widget-label (id & "t") note
    ]

Section: x86-64

  x86-section : Integer -> WidgetNode
  x86-section (x) =
    site-section "x86" "x86-64" "Codex vs MSVC /O2" "Production Windows compiler with full optimizations enabled." [
      widget-box "x86-grid" "bench-grid" [
        bench-card "x0" "bench-card bench-loss" "fib" "C /O2 = 20 instr" "Codex = 21 instr" "+5%" "Codex within 1 instruction",
        bench-card "x1" "bench-card bench-tie" "fact" "C /O2 = 15 instr" "Codex = 15 instr" "0%" "Exact parity",
        bench-card "x2" "bench-card bench-loss" "gcd" "C /O2 = 14 instr" "Codex = 17 instr" "+21%" "No strength reduction yet",
        bench-card "x3" "bench-card bench-win" "sum" "C /O2 = 23 instr" "Codex = 14 instr" "-39%" "Codex wins &mdash; tighter loop"
      ],
      widget-box "x86-sum" "bench-summary" [
        widget-box "x86-s" "bench-summary-item" [widget-label "x86-s-t" "Competitive with MSVC /O2 across the board. Sum loop is ", widget-box "x86-s-e" "em-text" [widget-label "x86-s-et" "39% tighter"], widget-label "x86-s-t2" " than the production C compiler."]
      ]
    ]

Section: ARM64

  arm-section : Integer -> WidgetNode
  arm-section (x) =
    site-section "arm" "ARM64" "Codex vs GCC -O2 Cross" "GCC cross-compiler targeting AArch64 with full optimizations." [
      widget-box "arm-grid" "bench-grid" [
        bench-card "a0" "bench-card bench-win" "fib" "GCC -O2 = 237 instr" "Codex = 22 instr" "-90.7%" "Codex wins dramatically",
        bench-card "a1" "bench-card bench-win" "fact" "GCC -O2 = 15 instr" "Codex = 13 instr" "-13%" "Codex wins",
        bench-card "a2" "bench-card bench-loss" "gcd" "GCC -O2 = 8 instr" "Codex = 22 instr" "+175%" "Known opportunity",
        bench-card "a3" "bench-card bench-tie" "sum" "GCC -O2 = 13 instr" "Codex = 13 instr" "0%" "Exact parity"
      ],
      widget-box "arm-sum" "bench-summary" [
        widget-box "arm-s" "bench-summary-item" [widget-label "arm-s-t" "fib is ", widget-box "arm-s-e" "em-text" [widget-label "arm-s-et" "90% fewer instructions"], widget-label "arm-s-t2" " than GCC -O2. The GCC fib bloat is likely loop unrolling overhead that hurts more than it helps."]
      ]
    ]

Section: RISC-V

  riscv-section : Integer -> WidgetNode
  riscv-section (x) =
    site-section "rv" "RISC-V" "Codex vs GCC -O2 Cross" "GCC cross-compiler targeting RV64GC with full optimizations." [
      widget-box "rv-grid" "bench-grid" [
        bench-card "r0" "bench-card bench-win" "fib" "GCC -O2 = 241 instr" "Codex = 20 instr" "-91.7%" "Codex wins &mdash; dominant",
        bench-card "r1" "bench-card bench-tie" "fact" "GCC -O2 = 14 instr" "Codex = 14 instr" "0%" "Exact parity",
        bench-card "r2" "bench-card bench-loss" "gcd" "GCC -O2 = 8 instr" "Codex = 22 instr" "+175%" "Known opportunity",
        bench-card "r3" "bench-card bench-win" "sum" "GCC -O2 = 11 instr" "Codex = 8 instr" "-27%" "Codex wins"
      ],
      widget-box "rv-sum" "bench-summary" [
        widget-box "rv-s" "bench-summary-item" [widget-label "rv-s-t" "fib dominates at ", widget-box "rv-s-e" "em-text" [widget-label "rv-s-et" "91.7% fewer instructions"], widget-label "rv-s-t2" ". Sum wins by 27%. GCD is a known gap &mdash; no strength reduction yet."]
      ]
    ]

Section: The Story

  story-section : Integer -> WidgetNode
  story-section (x) =
    site-section "story" "THE STORY" "Why These Numbers Matter" "A compiler that is 3 months old, competing with decades of optimization work." [
      widget-box "story-grid" "story-grid" [
        site-card "st0" "&#x1F6AB;" "No Optimization Passes" "The compiler is ~28,000 lines of Codex compiling itself. There are no optimization passes. What you see is what the compiler naturally produces.",
        site-card "st1" "&#x1F4C5;" "Three Months Old" "These numbers are from a compiler started on March 14, 2026. It reached self-hosting in 41 days. These benchmarks were taken 3 months in.",
        site-card "st2" "&#x23F3;" "37+ Years of GCC" "GCC has had 37 years of optimization work. MSVC has had 40+. Codex is already competitive on most benchmarks and dominant on some.",
        site-card "st3" "&#x1F4C8;" "Already Competitive" "Codex matches or beats production C compilers on 7 of 12 benchmark-architecture pairs. The GCD gap is a known opportunity &mdash; no strength reduction yet.",
        site-card "st4" "&#x1F527;" "Known Opportunities" "The GCD gap (+175% on ARM64 and RISC-V) is a single missing optimization: strength reduction. Once added, all three platforms benefit.",
        site-card "st5" "&#x1F680;" "The Floor, Not the Ceiling" "Every number on this page is the floor. The compiler has no peephole optimizer, no instruction scheduler, no register coalescing. Every improvement is ahead."
      ]
    ]

Section: Methodology

  method-section : Integer -> WidgetNode
  method-section (x) =
    site-section "method" "METHODOLOGY" "How We Measured" "Deterministic, reproducible, architecture-portable." [
      widget-box "method-grid" "method-grid" [
        method-card "m0" "METRIC" "Static instruction count. Not wall-clock time, not cycle counts. Deterministic and reproducible across runs.",
        method-card "m1" "WHY INSTRUCTION COUNT" "Architecture-portable, no benchmark harness noise, no variance from cache state or branch prediction. The number is the number.",
        method-card "m2" "C BASELINES" "MSVC /O2 for x86-64 (production Windows compiler). GCC -O2 cross-compilation for ARM64 (aarch64-linux-gnu) and RISC-V (riscv64-linux-gnu).",
        method-card "m3" "CODEX COMPILATION" "Single-pass compilation. No optimization flags. No special modes. The same compiler that compiles itself compiles the benchmarks."
      ]
    ]

  method-card : Text, Text, Text -> WidgetNode
  method-card (id) (title) (desc) =
    widget-box id "method-card" [
      widget-label (id & "t") title,
      widget-label (id & "d") desc
    ]

Section: Handlers

  perf-click : Text -> Integer
  perf-click (id) = 0

Section: Entry

  render-perf : Integer -> Integer
  render-perf (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init perf-extra-css
    in let s = set-render render-perf
    in let h = register-handlers no-pick perf-click
    in render-perf 0
  end

