Chapter: NotesPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Note-taking app with folders, rich text, and local persistence.

 We say:

Section: Theme

  notes-theme : Theme
  notes-theme =
    let p = Palette { pal-bg = 1710618, pal-fg = #D8D8D8, pal-primary = 16436287, pal-secondary = #222222, pal-accent = 16436287, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = 16436287, pal-border = #2A2A2A }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws #222222 (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 6) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "notes-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  notes-css : Text
  notes-css =
    "*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}body{background:#1a1a1a;color:#d8d8d8;font-family:'Georgia',serif}#app{display:flex;height:100vh}"
    & ".sidebar{width:260px;background:#1e1e1e;border-right:1px solid #2a2a2a;display:flex;flex-direction:column}"
    & ".sidebar-hdr{padding:16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #2a2a2a}"
    & ".sidebar-hdr h2{font-size:16px;color:#fac53f}"
    & ".note-list{flex:1;overflow-y:auto}"
    & ".note-item{padding:12px 16px;cursor:pointer;border-bottom:1px solid #222;transition:background .15s}"
    & ".note-item:hover,.note-item.active{background:#262626}"
    & ".note-title{font-size:14px;font-weight:600;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".note-date{font-size:11px;color:#666}"
    & ".note-snip{font-size:12px;color:#777;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".editor{flex:1;display:flex;flex-direction:column}"
    & ".editor-toolbar{padding:8px 16px;border-bottom:1px solid #2a2a2a;display:flex;gap:4px;background:#1e1e1e}"
    & ".editor-toolbar .wk-btn,.editor-toolbar button{background:none;border:none;color:#888;padding:6px 10px;cursor:pointer;border-radius:4px;font-size:14px}"
    & ".editor-toolbar .wk-btn:hover,.editor-toolbar button:hover{background:#333;color:#ddd}"
    & ".editor-body{flex:1;padding:32px 48px;font-size:16px;line-height:1.8;color:#ccc;overflow-y:auto;max-width:800px;margin:0 auto;width:100%}"
    & ".editor-body h1{font-size:28px;color:#fac53f;margin-bottom:16px;font-weight:600;border:none;outline:none}"
    & ".editor-body p{margin-bottom:12px}"
    & ".empty-editor{flex:1;display:flex;align-items:center;justify-content:center;color:#555}"
    & ".folder-item{padding:8px 16px;cursor:pointer;font-size:13px;color:#999;display:flex;align-items:center;gap:8px;transition:background .15s}"
    & ".folder-item:hover{background:#262626;color:#ddd}"
    & ".folder-item.active{color:#fac53f}"
    & ".folders{padding:12px 0;border-bottom:1px solid #2a2a2a}"
    & ".search-box{padding:8px 16px;border-bottom:1px solid #2a2a2a}"
    & ".search-box input{width:100%;background:#252525;border:1px solid #333;color:#ccc;padding:6px 10px;border-radius:6px;font-size:12px;outline:none}"
    & ".search-box input:focus{border-color:#fac53f}"
    & ".tag-badge{display:inline-block;background:#2c2c2c;color:#aaa;font-size:10px;padding:2px 8px;border-radius:10px;margin-right:4px;margin-top:4px}"
    & ".tag-badge.tag-work{color:#5b9bd5}"
    & ".tag-badge.tag-personal{color:#c678dd}"
    & ".tag-badge.tag-idea{color:#e5c07b}"
    & ".tag-badge.tag-recipe{color:#98c379}"
    & ".tag-badge.tag-fitness{color:#e06c75}"
    & ".tag-badge.tag-reading{color:#61afef}"
    & ".pinned-indicator{color:#fac53f;font-size:12px;margin-left:auto;flex-shrink:0}"
    & ".note-item{display:flex;flex-wrap:wrap;align-items:flex-start}"
    & ".note-meta{display:flex;width:100%;align-items:center;gap:4px}"
    & ".word-count-bar{padding:4px 16px;font-size:11px;color:#555;text-align:right;border-top:1px solid #2a2a2a;background:#1e1e1e}"
    & ".sort-controls{padding:6px 16px;border-bottom:1px solid #2a2a2a;display:flex;gap:4px}"
    & ".sort-btn{background:none;border:none;color:#666;font-size:11px;cursor:pointer;padding:2px 6px;border-radius:4px}"
    & ".sort-btn:hover,.sort-btn.active{color:#fac53f}"
    & ".folder-item.trash{color:#e06c75}"
    & ".folder-item.trash:hover{color:#ec6050}"
    & ".auto-save{font-size:11px;color:#41af4e;margin-left:auto;padding-right:8px;opacity:0.8}"
    & ".export-btn{background:none;border:none;color:#888;padding:6px 10px;cursor:pointer;border-radius:4px;font-size:12px}"
    & ".export-btn:hover{background:#333;color:#ddd}"
    & ".editor-hdr{padding:8px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #2a2a2a;background:#1e1e1e;font-size:12px;color:#666}"
    & ".editor-tags{padding:4px 16px;display:flex;flex-wrap:wrap;gap:4px;background:#1e1e1e}"
    & ".pin-active{color:#fac53f !important}"
    & ".tag-edit-btn{display:inline-block;cursor:pointer;transition:opacity .15s}"
    & ".tag-edit-btn:hover{opacity:.7}"
    & ".char-count{color:#444;margin-left:12px}"
    & ".note-actions{display:flex;gap:4px;margin-left:auto}"
    & ".format-hint{font-size:10px;color:#444;padding:2px 8px;font-style:italic}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-panel "root" DirRow 0 [
      sidebar-tree 0,
      editor-tree 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    let count = state-get "note-count"
    in let folder = state-get "folder"
    in let sm = state-get "sort-mode"
    in widget-box "sidebar" "sidebar" [
      widget-box "sidebar-hdr" "sidebar-hdr" [
        widget-label "brand" "CodexNotes",
        widget-button "new-note" "+"
      ],
      widget-box "search-box" "search-box" [
        wk-attach (widget-custom "search-input" "input" 0 0) [widget-label "si-v" (state-get-text "search-text"), widget-label "si-p" "Search notes..."] 0 2
      ],
      widget-box "folders" "folders" [
        widget-box-click "f-all" (if folder == 0 then "folder-item active" else "folder-item") [ widget-label "fa-i" "&#x1F4C4;", widget-label "fa-l" "All Notes" ],
        widget-box-click "f-fav" (if folder == 1 then "folder-item active" else "folder-item") [ widget-label "ff-i" "&#x2B50;", widget-label "ff-l" "Favorites" ],
        widget-box-click "f-arc" (if folder == 2 then "folder-item active" else "folder-item") [ widget-label "fc-i" "&#x1F4E6;", widget-label "fc-l" "Archive" ],
        widget-box-click "f-per" (if folder == 3 then "folder-item active" else "folder-item") [ widget-label "fp-i" "&#x1F464;", widget-label "fp-l" "Personal" ],
        widget-box-click "f-wrk" (if folder == 4 then "folder-item active" else "folder-item") [ widget-label "fw-i" "&#x1F4BC;", widget-label "fw-l" "Work" ],
        widget-box-click "f-trash" (if folder == 5 then "folder-item active trash" else "folder-item trash") [ widget-label "ft-i" "&#x1F5D1;", widget-label "ft-l" "Trash" ]
      ],
      widget-box "sort-controls" "sort-controls" [
        widget-label "sort-lbl" "Sort:",
        widget-button "sort-date" (if sm == 0 then "&#x25BC; Date" else "Date"),
        widget-button "sort-title" (if sm == 1 then "&#x25BC; Title" else "Title"),
        widget-button "sort-size" (if sm == 2 then "&#x25BC; Size" else "Size")
      ],
      widget-box "note-list" "note-list" (build-note-items 0 count [])
    ]

  note-matches-folder : Integer, Integer -> Integer
  note-matches-folder (i) (folder) =
    if folder == 0 then 1
    else if folder == 1 then state-get ("n-pinned-" & show i)
    else if folder == 5 then state-get ("n-trashed-" & show i)
    else let nf = state-get ("n-folder-" & show i)
    in if nf == folder then 1 else 0

  note-matches-search : Integer, Text -> Integer
  note-matches-search (i) (query) =
    if text-length query == 0 then 1
    else let title = state-get-text ("n-title-" & show i)
    in let snip = state-get-text ("n-snip-" & show i)
    in if text-contains title query then 1
    else if text-contains snip query then 1
    else 0

  build-note-items : Integer, Integer, List WidgetNode -> List WidgetNode
  build-note-items (i) (count) (acc) =
    if i >= count then acc
    else let folder = state-get "folder"
    in let trashed = state-get ("n-trashed-" & show i)
    in let show-trash = if folder == 5 then 1 else 0
    in let hidden-by-trash = if show-trash == 1 then (if trashed == 1 then 0 else 1) else trashed
    in if hidden-by-trash == 1 then build-note-items (i + 1) count acc
    else let fm = note-matches-folder i folder
    in if fm == 0 then build-note-items (i + 1) count acc
    else let query = state-get-text "search-text"
    in let sm = note-matches-search i query
    in if sm == 0 then build-note-items (i + 1) count acc
    else let title = state-get-text ("n-title-" & show i)
    in let date = state-get-text ("n-date-" & show i)
    in let snip = state-get-text ("n-snip-" & show i)
    in let active = state-get "active-note"
    in let pinned = state-get ("n-pinned-" & show i)
    in let tag1 = state-get-text ("n-tag1-" & show i)
    in let pin-node = if pinned == 1 then widget-label ("np-" & show i) "&#x2B50;" else widget-label ("np-" & show i) ""
    in let tag-node = if text-length tag1 > 0 then widget-label ("ntg-" & show i) tag1 else widget-label ("ntg-" & show i) ""
    in let item = widget-box-click ("note-" & show i) (if active == i then "note-item active" else "note-item") [
      widget-box ("nm-" & show i) "note-meta" [
        widget-label ("nt-" & show i) title,
        widget-label ("pin-" & show i) (if pinned == 1 then "&#x1F4CC;" else "")
      ],
      widget-label ("nd-" & show i) date,
      widget-label ("ns-" & show i) snip,
      if text-length tag1 > 0 then widget-box ("ntg-" & show i) "tag-badge" [widget-label ("ntgt-" & show i) tag1] else widget-label ("ntg-" & show i) ""
    ]
    in build-note-items (i + 1) count (list-push acc item)

  word-count : Text -> Integer
  word-count (txt) =
    if text-length txt == 0 then 0
    else count-words txt 0 0 0

  count-words : Text, Integer, Integer, Integer -> Integer
  count-words (txt) (pos) (wc) (in-word) =
    if pos >= text-length txt then (if in-word == 1 then wc + 1 else wc)
    else let ch = substring txt pos (pos + 1)
    in if ch == " " then count-words txt (pos + 1) (if in-word == 1 then wc + 1 else wc) 0
    else if ch == "\n" then count-words txt (pos + 1) (if in-word == 1 then wc + 1 else wc) 0
    else count-words txt (pos + 1) wc 1

  editor-tree : Integer -> WidgetNode
  editor-tree (x) =
    let active = state-get "active-note"
    in if active < 0 then widget-box "editor" "empty-editor" [ widget-label "emp" "Select a note or create a new one" ]
    else let title = state-get-text ("n-title-" & show active)
    in let body = state-get-text ("n-body-" & show active)
    in let pinned = state-get ("n-pinned-" & show active)
    in let wc = word-count body
    in let edited = state-get-text ("n-edited-" & show active)
    in let saved = state-get "auto-saved"
    in let tag1 = state-get-text ("n-tag1-" & show active)
    in let tag2 = state-get-text ("n-tag2-" & show active)
    in let tag3 = state-get-text ("n-tag3-" & show active)
    in let trashed = state-get ("n-trashed-" & show active)
    in widget-box "editor" "editor" [
      widget-box "editor-hdr" "editor-hdr" [
        widget-label "ed-edited" (if text-length edited > 0 then ("Last edited: " & edited) else ""),
        widget-label "auto-save-ind" (if saved == 1 then "Saved &#x2713;" else ""),
        widget-button "tb-pin" (if pinned == 1 then "&#x1F4CC; Unpin" else "&#x1F4CC; Pin"),
        widget-button "tb-archive" "&#x1F4E6; Archive",
        widget-button "tb-dup" "&#x1F4CB; Duplicate",
        widget-button "tb-export" "&#x1F4E4; Export",
        widget-button "tb-restore" (if trashed == 1 then "&#x267B; Restore" else "")
      ],
      widget-box "editor-tags" "editor-tags" [
        widget-box-click "tag-cycle-1" "tag-edit-btn" [ if text-length tag1 > 0 then widget-box "etag1" ("tag-badge tag-" & tag1) [widget-label "et1-t" tag1] else widget-box "etag1" "tag-badge" [widget-label "et1-t" "+ tag"] ],
        widget-box-click "tag-cycle-2" "tag-edit-btn" [ if text-length tag2 > 0 then widget-box "etag2" ("tag-badge tag-" & tag2) [widget-label "et2-t" tag2] else widget-box "etag2" "tag-badge" [widget-label "et2-t" "+ tag"] ],
        widget-box-click "tag-cycle-3" "tag-edit-btn" [ if text-length tag3 > 0 then widget-box "etag3" ("tag-badge tag-" & tag3) [widget-label "et3-t" tag3] else widget-box "etag3" "tag-badge" [widget-label "et3-t" "+ tag"] ]
      ],
      widget-box "toolbar" "editor-toolbar" [
        widget-button "tb-bold" "B",
        widget-button "tb-italic" "I",
        widget-button "tb-underline" "U",
        widget-button "tb-h1" "H1",
        widget-button "tb-h2" "H2",
        widget-button "tb-list" "&#x2022;",
        widget-button "tb-code" "&lt;/&gt;",
        widget-button "tb-hr" "---",
        widget-separator "tb-sep",
        widget-button "tb-del" "&#x1F5D1;"
      ],
      widget-box "editor-body" "editor-body" [
        wk-attach (widget-custom "ed-title" "input" 0 0) [widget-label "ed-tv" title, widget-label "ed-tp" "Untitled"] 0 2,
        wk-attach (widget-custom "ed-body" "textarea" 0 0) [widget-label "ed-bv" body] 0 1
      ],
      widget-box "wc-bar" "word-count-bar" [
        widget-label "wc-label" (show wc & " words"),
        widget-box "cc-wrap" "char-count" [widget-label "cc-label" (show (text-length body) & " characters")]
      ]
    ]

