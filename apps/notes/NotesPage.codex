Section: Note Actions

  insert-format-wrap : Text, Text -> Integer
  insert-format-wrap (marker) (placeholder) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let body = state-get-text ("n-body-" & show active)
    in let appended = body & "\n" & marker & placeholder & marker
    in let s1 = state-set-text ("n-body-" & show active) appended
    in let s2 = state-set-text ("n-snip-" & show active) (substring appended 0 40)
    in let s3 = state-set-text ("n-edited-" & show active) "Just now"
    in let s4 = state-set-render "auto-saved" 1
    in 0

  insert-format-line : Text -> Integer
  insert-format-line (prefix) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let body = state-get-text ("n-body-" & show active)
    in let appended = body & "\n" & prefix
    in let s1 = state-set-text ("n-body-" & show active) appended
    in let s2 = state-set-text ("n-snip-" & show active) (substring appended 0 40)
    in let s3 = state-set-text ("n-edited-" & show active) "Just now"
    in let s4 = state-set-render "auto-saved" 1
    in 0

  archive-active-note : Integer -> Integer
  archive-active-note (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let s1 = state-set ("n-folder-" & show active) 2
    in let s2 = state-set-render "active-note" (-1)
    in 0

  duplicate-note : Integer -> Integer
  duplicate-note (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let count = state-get "note-count"
    in let s1 = state-set-text ("n-title-" & show count) (state-get-text ("n-title-" & show active) & " (copy)")
    in let s2 = state-set-text ("n-date-" & show count) "Now"
    in let s3 = state-set-text ("n-snip-" & show count) (state-get-text ("n-snip-" & show active))
    in let s4 = state-set-text ("n-body-" & show count) (state-get-text ("n-body-" & show active))
    in let s5 = state-set ("n-folder-" & show count) (state-get ("n-folder-" & show active))
    in let s6 = state-set ("n-pinned-" & show count) 0
    in let s7 = state-set ("n-trashed-" & show count) 0
    in let s8 = state-set-text ("n-tag1-" & show count) (state-get-text ("n-tag1-" & show active))
    in let s9 = state-set-text ("n-tag2-" & show count) (state-get-text ("n-tag2-" & show active))
    in let s10 = state-set-text ("n-tag3-" & show count) (state-get-text ("n-tag3-" & show active))
    in let s11 = state-set-text ("n-edited-" & show count) "Just now"
    in let s12 = state-set "note-count" (count + 1)
    in let s13 = state-set-render "active-note" count
    in 0

  cycle-tag : Integer -> Integer
  cycle-tag (slot) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let key = "n-tag" & show slot & "-" & show active
    in let current = state-get-text key
    in let next-tag = if current == "" then "work"
      else if current == "work" then "personal"
      else if current == "personal" then "idea"
      else if current == "idea" then "recipe"
      else if current == "recipe" then "fitness"
      else if current == "fitness" then "reading"
      else if current == "reading" then "garden"
      else if current == "garden" then "travel"
      else if current == "travel" then "meeting"
      else if current == "meeting" then "design"
      else if current == "design" then "hobby"
      else if current == "hobby" then ""
      else ""
    in let s = state-set-text key next-tag
    in let s2 = state-set-render "tag-dirty" 1
    in 0

Section: Handlers

  notes-click : Text -> Integer
  notes-click (id) =
    if id == "new-note" then new-note 0
    else if id == "f-all" then let s = state-set-render "folder" 0 in 0
    else if id == "f-fav" then let s = state-set-render "folder" 1 in 0
    else if id == "f-arc" then let s = state-set-render "folder" 2 in 0
    else if id == "f-per" then let s = state-set-render "folder" 3 in 0
    else if id == "f-wrk" then let s = state-set-render "folder" 4 in 0
    else if id == "f-trash" then let s = state-set-render "folder" 5 in 0
    else if id == "tb-del" then trash-active-note 0
    else if id == "tb-restore" then restore-active-note 0
    else if id == "tb-pin" then toggle-pin 0
    else if id == "tb-export" then export-note 0
    else if id == "tb-archive" then archive-active-note 0
    else if id == "tb-dup" then duplicate-note 0
    else if id == "tb-bold" then insert-format-wrap "**" "bold"
    else if id == "tb-italic" then insert-format-wrap "*" "italic"
    else if id == "tb-underline" then insert-format-wrap "__" "underline"
    else if id == "tb-h1" then insert-format-line "# Heading"
    else if id == "tb-h2" then insert-format-line "## Subheading"
    else if id == "tb-list" then insert-format-line "- Item"
    else if id == "tb-code" then insert-format-wrap "`" "code"
    else if id == "tb-hr" then insert-format-line "\n---\n"
    else if id == "tag-cycle-1" then cycle-tag 1
    else if id == "tag-cycle-2" then cycle-tag 2
    else if id == "tag-cycle-3" then cycle-tag 3
    else if id == "sort-date" then let s = state-set-render "sort-mode" 0 in 0
    else if id == "sort-title" then let s = state-set-render "sort-mode" 1 in 0
    else if id == "sort-size" then let s = state-set-render "sort-mode" 2 in 0
    else if text-starts-with id "note-" then let s = state-set-render "active-note" (id-num id) in 0
    else 0

  new-note : Integer -> Integer
  new-note (x) =
    let count = state-get "note-count"
    in let folder = state-get "folder"
    in let assigned = if folder > 0 then (if folder < 5 then folder else 0) else 0
    in let s1 = state-set-text ("n-title-" & show count) "Untitled"
    in let s2 = state-set-text ("n-date-" & show count) "Now"
    in let s3 = state-set-text ("n-snip-" & show count) ""
    in let s4 = state-set-text ("n-body-" & show count) ""
    in let s5a = state-set ("n-folder-" & show count) assigned
    in let s5b = state-set ("n-pinned-" & show count) 0
    in let s5c = state-set ("n-trashed-" & show count) 0
    in let s5d = state-set-text ("n-tag1-" & show count) ""
    in let s5e = state-set-text ("n-tag2-" & show count) ""
    in let s5f = state-set-text ("n-tag3-" & show count) ""
    in let s5g = state-set-text ("n-edited-" & show count) "Just now"
    in let s6 = state-set "note-count" (count + 1)
    in let s7 = state-set-render "active-note" count
    in 0

  trash-active-note : Integer -> Integer
  trash-active-note (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let s1 = state-set ("n-trashed-" & show active) 1
    in let s2 = state-set-render "active-note" (-1)
    in 0

  restore-active-note : Integer -> Integer
  restore-active-note (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let s1 = state-set ("n-trashed-" & show active) 0
    in let s2 = state-set-render "active-note" (-1)
    in 0

  toggle-pin : Integer -> Integer
  toggle-pin (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let current = state-get ("n-pinned-" & show active)
    in let s = state-set-render ("n-pinned-" & show active) (if current == 1 then 0 else 1)
    in 0

  export-note : Integer -> Integer
  export-note (x) =
    let active = state-get "active-note"
    in if active < 0 then 0
    else let title = state-get-text ("n-title-" & show active)
    in let body = state-get-text ("n-body-" & show active)
    in let content = title & "\n\n" & body
    in let s = clipboard-write content
    in 0

  notes-input : Text, Text -> Integer
  notes-input (id) (value) =
    let active = state-get "active-note"
    in if id == "search-input" then let s = state-set-text "search-text" value in let r = state-set-render "search-dirty" 1 in 0
    else if active < 0 then 0
    else if id == "ed-title" then let s = state-set-text ("n-title-" & show active) value in let s2 = state-set-text ("n-edited-" & show active) "Just now" in let s3 = state-set-render "auto-saved" 1 in 0
    else if id == "ed-body" then let s = state-set-text ("n-body-" & show active) value in let s2 = state-set-text ("n-snip-" & show active) (substring value 0 40) in let s3 = state-set-text ("n-edited-" & show active) "Just now" in let s4 = state-set-render "auto-saved" 1 in 0
    else 0

Section: Entry

  render-notes : Integer -> Integer
  render-notes (x) = mount-widget-themed notes-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style notes-theme notes-css
    in let s = state-set "active-note" (-1)
    in let sf = state-set "folder" 0
    in let sm = state-set "sort-mode" 0
    in let ss = state-set-text "search-text" ""
    in let sa = state-set "auto-saved" 0
    in let sd = state-set "search-dirty" 0
    in let s2 = set-render render-notes
    in let h = register-handlers no-pick notes-click
    in let hi = register-input-handler notes-input
    in let d = load-sample-notes 0
    in render-notes 0
  end

Page 1
