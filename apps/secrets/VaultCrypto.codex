 Cryptographic operations for the secrets manager.

 Key hierarchy:
   1. User enters master password
   2. PBKDF2(password, salt, 100000 iterations) -> master key (32 bytes)
   3. HKDF(master key, "vault-encryption") -> vault key (32 bytes)
   4. HKDF(vault key, secret-id) -> per-secret key (32 bytes)
   5. AES-GCM(per-secret key, nonce, plaintext) -> ciphertext + tag

 Team sharing:
   1. Team creator generates team keypair (Ed25519)
   2. Each member's vault key is encrypted to their public key
      via DiffieHellman shared secret
   3. Trust lattice verifies membership

Section: Types

  MasterKey = record {
    mk-key  : List Integer,
    mk-salt : List Integer,
    mk-hash : List Integer
  }

  VaultKey = record {
    vk-key     : List Integer,
    vk-vault-id : Text
  }

  EncryptionResult = record {
    er-ciphertext : List Integer,
    er-nonce      : List Integer,
    er-tag        : List Integer
  }

  TeamKeyShare = record {
    tks-member-pub  : List Integer,
    tks-encrypted   : List Integer,
    tks-nonce       : List Integer,
    tks-tag         : List Integer
  }

Section: Constants

  pbkdf-iterations : Integer
  pbkdf-iterations = 100000

  salt-length : Integer
  salt-length = 32

  key-length : Integer
  key-length = 32

  nonce-length : Integer
  nonce-length = 12

  tag-length : Integer
  tag-length = 16

Section: Master Key Derivation

  derive-master-key : Text, List Integer -> MasterKey
  derive-master-key (password) (salt) =
    let pw-bytes = text-to-bytes password
    in let params = PbkdfParams { pb-time-cost = pbkdf-iterations, pb-block-count = 4096, pb-hash-length = key-length }
    in let result = pbkdf-hash pw-bytes salt params
    in let key = result.pbr-hash
    in let key-hash = sha256 key
    in MasterKey {
      mk-key = key,
      mk-salt = salt,
      mk-hash = key-hash
    }

  generate-salt : Integer -> List Integer
  generate-salt (seed) =
    let r1 = hkdf-words-to-bytes (sha256 (text-to-bytes (show seed)))
    in list-take r1 salt-length

  verify-master-password : Text, MasterKey -> Boolean
  verify-master-password (password) (mk) =
    let derived = derive-master-key password mk.mk-salt
    in bytes-equal derived.mk-hash mk.mk-hash

Section: Vault Key Derivation

  derive-vault-key : MasterKey, Text -> VaultKey
  derive-vault-key (mk) (vault-id) =
    let info = text-to-bytes ("vault-encryption:" & vault-id)
    in let key = hkdf mk.mk-salt mk.mk-key info key-length
    in VaultKey { vk-key = key, vk-vault-id = vault-id }

Section: Per-Secret Key Derivation

  derive-secret-key : VaultKey, Integer -> List Integer
  derive-secret-key (vk) (secret-id) =
    let info = text-to-bytes ("secret:" & show secret-id)
    in hkdf hkdf-zero-salt vk.vk-key info key-length

Section: Encryption

  encrypt-payload : VaultKey, Integer, SecretPayload, Integer -> EncryptionResult
  encrypt-payload (vk) (secret-id) (payload) (seed) =
    let key = derive-secret-key vk secret-id
    in let nonce = generate-nonce seed secret-id
    in let plaintext = serialize-payload payload
    in let result = aesgcm-encrypt key nonce plaintext []
    in EncryptionResult {
      er-ciphertext = result.ciphertext,
      er-nonce = nonce,
      er-tag = result.tag
    }

  decrypt-payload : VaultKey, Integer, EncryptedSecret -> Maybe SecretPayload
  decrypt-payload (vk) (secret-id) (es) =
    let key = derive-secret-key vk secret-id
    in let plaintext = aesgcm-decrypt key es.es-nonce es.es-cipher [] es.es-tag
    in when plaintext
      is None -> None
      is Just (bytes) -> Just (deserialize-payload bytes)

  generate-nonce : Integer, Integer -> List Integer
  generate-nonce (seed) (secret-id) =
    let combined = hkdf-words-to-bytes (sha256 (text-to-bytes (show seed & ":" & show secret-id)))
    in list-take combined nonce-length

Section: Payload Serialization

 Serialize a SecretPayload to bytes for encryption.
 Format: password-len (4 LE) + password-bytes + field-count (4 LE)
         + [field-name-len + name + field-value-len + value + hidden-byte] ...

  serialize-payload : SecretPayload -> List Integer
  serialize-payload (sp) =
    let pw-bytes = text-to-bytes sp.sp-password
    in let pw-header = write-len (list-length pw-bytes)
    in let fields-data = serialize-fields sp.sp-fields
    in let totp-bytes = text-to-bytes sp.sp-totp-secret
    in let totp-header = write-len (list-length totp-bytes)
    in pw-header & pw-bytes & write-len (list-length sp.sp-fields) & fields-data & totp-header & totp-bytes

  serialize-fields : List SecretField -> List Integer
  serialize-fields (fields) =
    if list-length fields == 0 then []
    else let head = list-at fields 0
      in serialize-one-field head & serialize-fields (list-drop fields 1)

  serialize-one-field : SecretField -> List Integer
  serialize-one-field (f) =
    let name-bytes = text-to-bytes f.sf-name
    in let val-bytes = text-to-bytes f.sf-value
    in write-len (list-length name-bytes) & name-bytes
     & write-len (list-length val-bytes) & val-bytes
     & [if f.sf-hidden then 1 else 0]

  deserialize-payload : List Integer -> SecretPayload
  deserialize-payload (bytes) =
    if list-length bytes < 4 then payload-new ""
    else let pw-len = read-deser-u32 bytes 0
    in let pw-bytes = list-take (list-drop bytes 4) pw-len
    in let pw-text = deser-bytes-to-text pw-bytes 0 ""
    in let field-offset = 4 + pw-len
    in if field-offset + 4 > list-length bytes then payload-new pw-text
    else let field-count = read-deser-u32 bytes field-offset
    in let fields = deser-fields bytes (field-offset + 4) field-count []
    in payload-with-fields pw-text fields

  read-deser-u32 : List Integer, Integer -> Integer
  read-deser-u32 (bs) (off) =
    list-at bs off + (list-at bs (off + 1)) * 256 + (list-at bs (off + 2)) * 65536 + (list-at bs (off + 3)) * 16777216

  deser-bytes-to-text : List Integer, Integer, Text -> Text
  deser-bytes-to-text (bs) (i) (acc) =
    if i >= list-length bs then acc
    else deser-bytes-to-text bs (i + 1) (acc & char-to-text (code-to-char (list-at bs i)))

  deser-fields : List Integer, Integer, Integer, List SecretField -> List SecretField
  deser-fields (bs) (off) (remaining) (acc) =
    if remaining <= 0 then acc
    else if off + 4 > list-length bs then acc
    else let name-len = read-deser-u32 bs off
    in let name = deser-bytes-to-text (list-take (list-drop bs (off + 4)) name-len) 0 ""
    in let val-off = off + 4 + name-len
    in if val-off + 4 > list-length bs then acc
    else let val-len = read-deser-u32 bs val-off
    in let value = deser-bytes-to-text (list-take (list-drop bs (val-off + 4)) val-len) 0 ""
    in let hidden-off = val-off + 4 + val-len
    in let hidden = if hidden-off < list-length bs then list-at bs hidden-off == 1 else False
    in let field = SecretField { sf-name = name, sf-value = value, sf-hidden = hidden }
    in deser-fields bs (hidden-off + 1) (remaining - 1) (list-push acc field)

  write-len : Integer -> List Integer
  write-len (n) =
    [bit-and n 255,
     bit-and (n / 256) 255,
     bit-and (n / 65536) 255,
     bit-and (n / 16777216) 255]

Section: Team Key Sharing

  create-team-share : List Integer, List Integer, VaultKey -> TeamKeyShare
  create-team-share (team-private) (member-public) (vk) =
    let shared = dh-shared-secret team-private member-public
    in let enc-key = hkdf hkdf-zero-salt shared (text-to-bytes "team-vault-key") key-length
    in let nonce = list-take (hkdf-words-to-bytes (sha256 member-public)) nonce-length
    in let encrypted = aesgcm-encrypt enc-key nonce vk.vk-key []
    in TeamKeyShare {
      tks-member-pub = member-public,
      tks-encrypted = encrypted.ciphertext,
      tks-nonce = nonce,
      tks-tag = encrypted.tag
    }

  decrypt-team-share : List Integer, List Integer, TeamKeyShare -> Maybe VaultKey
  decrypt-team-share (member-private) (team-public) (share) =
    let shared = dh-shared-secret member-private team-public
    in let dec-key = hkdf hkdf-zero-salt shared (text-to-bytes "team-vault-key") key-length
    in let vault-key-bytes = aesgcm-decrypt dec-key share.tks-nonce share.tks-encrypted [] share.tks-tag
    in when vault-key-bytes
      is None -> None
      is Just (key) -> Just (VaultKey { vk-key = key, vk-vault-id = "team" })

Section: Password Verification Hash

  hash-for-storage : MasterKey -> List Integer
  hash-for-storage (mk) =
    sha256 (mk.mk-hash & mk.mk-salt)

Section: Helpers

  bytes-equal : List Integer, List Integer -> Boolean
  bytes-equal (a) (b) =
    if list-length a /= list-length b then False
    else bytes-equal-loop a b 0

  bytes-equal-loop : List Integer, List Integer, Integer -> Boolean
  bytes-equal-loop (a) (b) (i) =
    if i >= list-length a then True
    else if list-at a i /= list-at b i then False
    else bytes-equal-loop a b (i + 1)

  dh-shared-secret : List Integer, List Integer -> List Integer
  dh-shared-secret (private) (public) =
    sha256 (private & public)
