Chapter: SecretEntry
  cites Foreword chapter Maybe
  cites Foreword chapter ListUtils

 Secret entry types. A secret is a typed record with metadata,
 encrypted payload, and audit history.

Section: Entry Types

  SecretType =
    | SecretPassword
    | SecretApiKey
    | SecretToken
    | SecretCertificate
    | SecretNote
    | SecretSshKey
    | SecretDatabase
    | SecretWifi
    | SecretCreditCard
    | SecretIdentity

Section: Core Record

  SecretEntry = record {
    se-id          : Integer,
    se-type        : SecretType,
    se-name        : Text,
    se-username    : Text,
    se-url         : Text,
    se-tags        : List Text,
    se-folder      : Text,
    se-notes       : Text,
    se-created     : Integer,
    se-modified    : Integer,
    se-accessed    : Integer,
    se-access-count : Integer,
    se-favorite    : Boolean,
    se-archived    : Boolean
  }

  SecretPayload = record {
    sp-password     : Text,
    sp-fields       : List SecretField,
    sp-totp-secret  : Text,
    sp-attachments  : List AttachmentRef
  }

  SecretField = record {
    sf-name    : Text,
    sf-value   : Text,
    sf-hidden  : Boolean
  }

  AttachmentRef = record {
    ar-name : Text,
    ar-size : Integer,
    ar-hash : List Integer
  }

Section: Encrypted Form

  EncryptedSecret = record {
    es-id       : Integer,
    es-metadata : SecretEntry,
    es-nonce    : List Integer,
    es-cipher   : List Integer,
    es-tag      : List Integer
  }

Section: Construction

  secret-new : Integer, SecretType, Text, Text, Text, Integer -> SecretEntry
  secret-new (id) (stype) (name) (username) (url) (now) =
    SecretEntry {
      se-id = id,
      se-type = stype,
      se-name = name,
      se-username = username,
      se-url = url,
      se-tags = [],
      se-folder = "Default",
      se-notes = "",
      se-created = now,
      se-modified = now,
      se-accessed = now,
      se-access-count = 0,
      se-favorite = False,
      se-archived = False
    }

  payload-new : Text -> SecretPayload
  payload-new (password) =
    SecretPayload {
      sp-password = password,
      sp-fields = [],
      sp-totp-secret = "",
      sp-attachments = []
    }

  payload-with-fields : Text, List SecretField -> SecretPayload
  payload-with-fields (password) (fields) =
    SecretPayload {
      sp-password = password,
      sp-fields = fields,
      sp-totp-secret = "",
      sp-attachments = []
    }

Section: Field Helpers

  field-new : Text, Text, Boolean -> SecretField
  field-new (name) (value) (hidden) =
    SecretField { sf-name = name, sf-value = value, sf-hidden = hidden }

  field-visible : Text, Text -> SecretField
  field-visible (name) (value) =
    field-new name value False

  field-hidden : Text, Text -> SecretField
  field-hidden (name) (value) =
    field-new name value True

Section: Entry Updates

  secret-touch : SecretEntry, Integer -> SecretEntry
  secret-touch (se) (now) =
    __record-set (__record-set se
      "se-accessed" now)
      "se-access-count" (se.se-access-count + 1)

  secret-modify : SecretEntry, Integer -> SecretEntry
  secret-modify (se) (now) =
    __record-set (secret-touch se now) "se-modified" now

  secret-set-folder : SecretEntry, Text -> SecretEntry
  secret-set-folder (se) (folder) =
    __record-set se "se-folder" folder

  secret-set-tags : SecretEntry, List Text -> SecretEntry
  secret-set-tags (se) (tags) =
    __record-set se "se-tags" tags

  secret-add-tag : SecretEntry, Text -> SecretEntry
  secret-add-tag (se) (tag) =
    __record-set se "se-tags" (list-push se.se-tags tag)

  secret-toggle-favorite : SecretEntry -> SecretEntry
  secret-toggle-favorite (se) =
    __record-set se "se-favorite" (if se.se-favorite then False else True)

  secret-archive : SecretEntry -> SecretEntry
  secret-archive (se) =
    __record-set se "se-archived" True

  secret-unarchive : SecretEntry -> SecretEntry
  secret-unarchive (se) =
    __record-set se "se-archived" False

Section: Type Names

  secret-type-name : SecretType -> Text
  secret-type-name (st) =
    when st
      is SecretPassword -> "Password"
      is SecretApiKey -> "API Key"
      is SecretToken -> "Token"
      is SecretCertificate -> "Certificate"
      is SecretNote -> "Secure Note"
      is SecretSshKey -> "SSH Key"
      is SecretDatabase -> "Database"
      is SecretWifi -> "Wi-Fi"
      is SecretCreditCard -> "Credit Card"
      is SecretIdentity -> "Identity"

  secret-type-icon : SecretType -> Text
  secret-type-icon (st) =
    when st
      is SecretPassword -> "[P]"
      is SecretApiKey -> "[K]"
      is SecretToken -> "[T]"
      is SecretCertificate -> "[C]"
      is SecretNote -> "[N]"
      is SecretSshKey -> "[S]"
      is SecretDatabase -> "[D]"
      is SecretWifi -> "[W]"
      is SecretCreditCard -> "[$]"
      is SecretIdentity -> "[I]"

Section: Search

  secret-matches : SecretEntry, Text -> Boolean
  secret-matches (se) (query) =
    if text-length query == 0 then True
    else text-contains se.se-name query
      | text-contains se.se-username query
      | text-contains se.se-url query
      | tags-match se.se-tags query

  tags-match : List Text, Text -> Boolean
  tags-match (tags) (query) =
    if list-length tags == 0 then False
    else if text-contains (list-at tags 0) query then True
      else tags-match (list-drop tags 1) query

Section: Sorting

  secret-sort-name : SecretEntry, SecretEntry -> Boolean
  secret-sort-name (a) (b) = a.se-name < b.se-name

  secret-sort-modified : SecretEntry, SecretEntry -> Boolean
  secret-sort-modified (a) (b) = a.se-modified > b.se-modified

  secret-sort-accessed : SecretEntry, SecretEntry -> Boolean
  secret-sort-accessed (a) (b) = a.se-accessed > b.se-accessed
