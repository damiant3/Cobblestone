 Entry point for the Codex Secrets Manager with disk persistence.
 Vault data and audit log are loaded from DiskFacts on startup
 and persisted after vault modifications.

Section: Entry Point

  opening : [Console] Nothing
  opening = act
    let disk = disk-load
    in let vi = secrets-persist-load-vault disk
    in let audit = secrets-persist-load-audit disk
    in let state = secrets-app-init 1024 768
    in let r1 = __record-set state "sa-vault-index" vi
    in let restored = __record-set r1 "sa-audit" audit
    in let disk2 = app-log-info disk "secrets" ("Secrets started, " & show (list-length vi.vi-vaults) & " vaults") 0
    in act
      print-line "Codex Secrets v0.1"
      print-line ("  Disk: " & show (disk-fact-count disk2) & " facts")
      print-line ("  Vaults: " & show (list-length vi.vi-vaults))
      print-line "  Enter master password to unlock."
      secrets-run-persistent restored disk2
    end
  end

Section: Persistent Event Loop

  SecretsPersistState = record {
    sps-app : SecretsAppState,
    sps-disk : DiskFactStore
  }

  secrets-run-persistent : SecretsAppState, DiskFactStore -> [Console] Nothing
  secrets-run-persistent (state) (disk) = act
    let scan = poll-key
    in let ev = if scan == 0
          then event-timer "tick" 0
          else event-key-down scan poll-mods 0
    in let handled = secrets-handle-event state ev
    in let persisted = secrets-check-persist handled disk state
    in secrets-run-persistent (persisted.sps-app) (persisted.sps-disk)
  end

  secrets-check-persist : SecretsAppState, DiskFactStore, SecretsAppState -> SecretsPersistState
  secrets-check-persist (after) (disk) (before) =
    let vault-changed = vault-count-changed after.sa-vault-index before.sa-vault-index
    in let audit-changed = after.sa-audit.al-count /= before.sa-audit.al-count
    in if vault-changed | audit-changed
      then let new-disk = secrets-persist-save disk after.sa-vault-index after.sa-audit 0
        in let logged = app-log-info new-disk "secrets" "Vault updated" 0
        in SecretsPersistState { sps-app = after, sps-disk = logged }
      else SecretsPersistState { sps-app = after, sps-disk = disk }

  vault-count-changed : VaultIndex, VaultIndex -> Boolean
  vault-count-changed (a) (b) =
    let a-count = vault-total-entries a.vi-vaults 0 (list-length a.vi-vaults) 0
    in let b-count = vault-total-entries b.vi-vaults 0 (list-length b.vi-vaults) 0
    in a-count /= b-count

  vault-total-entries : List Vault, Integer, Integer, Integer -> Integer
  vault-total-entries (vaults) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vaults i
    in vault-total-entries vaults (i + 1) len (acc + list-length v.v-entries)
