Chapter: SecretGenerator
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe
  cites Foreword chapter CCE

 Generates secure passwords and passphrases.

Section: Types

  PasswordPolicy = record {
    pp-length     : Integer,
    pp-uppercase  : Boolean,
    pp-lowercase  : Boolean,
    pp-digits     : Boolean,
    pp-symbols    : Boolean,
    pp-ambiguous  : Boolean,
    pp-min-entropy : Integer
  }

Section: Default Policies

  policy-strong : PasswordPolicy
  policy-strong =
    PasswordPolicy {
      pp-length = 24,
      pp-uppercase = True,
      pp-lowercase = True,
      pp-digits = True,
      pp-symbols = True,
      pp-ambiguous = False,
      pp-min-entropy = 80
    }

  policy-medium : PasswordPolicy
  policy-medium =
    PasswordPolicy {
      pp-length = 16,
      pp-uppercase = True,
      pp-lowercase = True,
      pp-digits = True,
      pp-symbols = False,
      pp-ambiguous = False,
      pp-min-entropy = 60
    }

  policy-pin : PasswordPolicy
  policy-pin =
    PasswordPolicy {
      pp-length = 6,
      pp-uppercase = False,
      pp-lowercase = False,
      pp-digits = True,
      pp-symbols = False,
      pp-ambiguous = True,
      pp-min-entropy = 20
    }

Section: Character Sets

  lowercase-chars : Text
  lowercase-chars = "abcdefghijkmnopqrstuvwxyz"

  uppercase-chars : Text
  uppercase-chars = "ABCDEFGHJKLMNPQRSTUVWXYZ"

  digit-chars : Text
  digit-chars = "23456789"

  symbol-chars : Text
  symbol-chars = "!@#%^&*-_=+?"

  ambiguous-lowercase : Text
  ambiguous-lowercase = "abcdefghijklmnopqrstuvwxyz"

  ambiguous-uppercase : Text
  ambiguous-uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

  ambiguous-digits : Text
  ambiguous-digits = "0123456789"

Section: Password Generation

  generate-password : PasswordPolicy, Integer -> Text
  generate-password (policy) (seed) =
    let charset = build-charset policy
    in let charset-len = text-length charset
    in if charset-len == 0 then ""
    else gen-chars charset charset-len policy.pp-length seed ""

  build-charset : PasswordPolicy -> Text
  build-charset (p) =
    let lc = if p.pp-lowercase then (if p.pp-ambiguous then ambiguous-lowercase else lowercase-chars) else ""
    in let uc = if p.pp-uppercase then (if p.pp-ambiguous then ambiguous-uppercase else uppercase-chars) else ""
    in let dg = if p.pp-digits then (if p.pp-ambiguous then ambiguous-digits else digit-chars) else ""
    in let sy = if p.pp-symbols then symbol-chars else ""
    in lc & uc & dg & sy

  gen-chars : Text, Integer, Integer, Integer, Text -> Text
  gen-chars (charset) (charset-len) (remaining) (seed) (acc) =
    if remaining <= 0 then acc
    else let hash = sha256 (text-to-bytes (show seed & ":" & show remaining))
    in let idx = int-mod (list-at hash 0 * 256 + list-at hash 1) charset-len
    in let ch = char-to-text (char-at charset idx)
    in gen-chars charset charset-len (remaining - 1) (seed + 1) (acc & ch)

Section: Passphrase Generation

  wordlist : List Text
  wordlist = [
    "correct", "horse", "battery", "staple",
    "quantum", "cipher", "lattice", "vector",
    "kernel", "signal", "beacon", "forge",
    "prism", "orbit", "nexus", "delta",
    "vertex", "echo", "pulse", "ridge",
    "anchor", "bridge", "crown", "drift",
    "ember", "frost", "grove", "haven",
    "ivory", "jade", "knoll", "lunar"
  ]

  generate-passphrase : Integer, Integer, Text -> Text
  generate-passphrase (word-count) (seed) (separator) =
    gen-words wordlist (list-length wordlist) word-count seed "" separator

  gen-words : List Text, Integer, Integer, Integer, Text, Text -> Text
  gen-words (words) (word-list-len) (remaining) (seed) (acc) (sep) =
    if remaining <= 0 then acc
    else let hash = sha256 (text-to-bytes (show seed & ":w:" & show remaining))
    in let idx = int-mod (list-at hash 0 * 256 + list-at hash 1) word-list-len
    in let word = list-at words idx
    in let next-acc = if text-length acc == 0 then word else acc & sep & word
    in gen-words words word-list-len (remaining - 1) (seed + 1) next-acc sep

Section: Strength Assessment

  PasswordStrength =
    | StrengthWeak
    | StrengthFair
    | StrengthGood
    | StrengthStrong
    | StrengthExcellent

  assess-strength : Text -> PasswordStrength
  assess-strength (password) =
    let len = text-length password
    in let entropy = estimate-entropy password
    in if entropy < 30 then StrengthWeak
    else if entropy < 50 then StrengthFair
    else if entropy < 70 then StrengthGood
    else if entropy < 90 then StrengthStrong
    else StrengthExcellent

  estimate-entropy : Text -> Integer
  estimate-entropy (password) =
    let len = text-length password
    in let charset-size = count-charset password
    in if charset-size == 0 then 0
    else len * log2-approx charset-size

  count-charset : Text -> Integer
  count-charset (p) =
    let has-lower = text-has-class p 97 122
    in let has-upper = text-has-class p 65 90
    in let has-digit = text-has-class p 48 57
    in let has-symbol = text-length p > 0
    in (if has-lower then 26 else 0)
     + (if has-upper then 26 else 0)
     + (if has-digit then 10 else 0)
     + (if has-symbol then 12 else 0)

  text-has-class : Text, Integer, Integer -> Boolean
  text-has-class (t) (lo) (hi) =
    text-has-class-loop t lo hi 0

  text-has-class-loop : Text, Integer, Integer, Integer -> Boolean
  text-has-class-loop (t) (lo) (hi) (i) =
    if i >= text-length t then False
    else let c = to-unicode (char-code (char-at t i))
    in if c >= lo then if c <= hi then True
      else text-has-class-loop t lo hi (i + 1)
      else text-has-class-loop t lo hi (i + 1)

  log2-approx : Integer -> Integer
  log2-approx (n) =
    if n <= 1 then 0
    else 1 + log2-approx (n / 2)

  strength-name : PasswordStrength -> Text
  strength-name (s) =
    when s
      is StrengthWeak -> "Weak"
      is StrengthFair -> "Fair"
      is StrengthGood -> "Good"
      is StrengthStrong -> "Strong"
      is StrengthExcellent -> "Excellent"

  strength-color : PasswordStrength -> Integer
  strength-color (s) =
    when s
      is StrengthWeak -> #FF5555
      is StrengthFair -> #FFB86C
      is StrengthGood -> #F1FA8C
      is StrengthStrong -> #50FA7B
      is StrengthExcellent -> #8BE9FD
