Chapter: Vault
  cites Foreword chapter Maybe
  cites Secrets chapter SecretEntry
  cites Secrets chapter VaultCrypto
  cites Foreword chapter ListUtils

 A vault is a collection of encrypted secrets owned by a user
 or team. Personal vaults are encrypted with the user's master
 key. Team vaults use DiffieHellman key shares.

Section: Types

  VaultType =
    | PersonalVault
    | TeamVault

  Vault = record {
    v-id       : Text,
    v-name     : Text,
    v-type     : VaultType,
    v-entries  : List SecretEntry,
    v-folders  : List Text,
    v-next-id  : Integer,
    v-locked   : Boolean,
    v-modified : Integer
  }

  VaultIndex = record {
    vi-vaults     : List Vault,
    vi-active     : Text,
    vi-master-key : Maybe MasterKey
  }

Section: Construction

  vault-new : Text, Text, VaultType -> Vault
  vault-new (id) (name) (vtype) =
    Vault {
      v-id = id,
      v-name = name,
      v-type = vtype,
      v-entries = [],
      v-folders = ["Default", "Work", "Personal", "Finance", "Development"],
      v-next-id = 1,
      v-locked = True,
      v-modified = 0
    }

  vault-index-new : VaultIndex
  vault-index-new =
    VaultIndex {
      vi-vaults = [vault-new "personal" "My Vault" PersonalVault],
      vi-active = "personal",
      vi-master-key = None
    }

Section: Vault Operations

  vault-unlock : VaultIndex, Text -> VaultIndex
  vault-unlock (vi) (password) =
    let salt = generate-salt 42
    in let mk = derive-master-key password salt
    in __record-set vi "vi-master-key" (Just mk)

  vault-lock : VaultIndex -> VaultIndex
  vault-lock (vi) =
    __record-set vi "vi-master-key" None

  vault-is-unlocked : VaultIndex -> Boolean
  vault-is-unlocked (vi) =
    when vi.vi-master-key
      is Just (_) -> True
      is None -> False

  vault-active : VaultIndex -> Maybe Vault
  vault-active (vi) =
    find-vault vi.vi-vaults vi.vi-active

  find-vault : List Vault, Text -> Maybe Vault
  find-vault (vaults) (id) =
    if list-length vaults == 0 then None
    else let head = list-at vaults 0
      in if head.v-id == id then Just head
      else find-vault (list-drop vaults 1) id

Section: Secret CRUD

  vault-add-secret : Vault, SecretType, Text, Text, Text, Text, Integer -> Vault
  vault-add-secret (v) (stype) (name) (username) (url) (password) (now) =
    let id = v.v-next-id
    in let entry = secret-new id stype name username url now
    in __record-set (__record-set (__record-set v
      "v-entries" (list-push v.v-entries entry))
      "v-next-id" (id + 1))
      "v-modified" now

  vault-encrypt-secret : VaultKey, Vault, Integer, Text, Integer -> EncryptedSecret
  vault-encrypt-secret (vk) (v) (secret-id) (password) (now) =
    let payload = payload-new password
    in let entry = when vault-find-secret v secret-id
         is Just (e) -> e
         is None -> secret-new secret-id SecretPassword "unknown" "" "" now
    in let enc = encrypt-payload vk secret-id payload now
    in EncryptedSecret {
         es-id = secret-id,
         es-metadata = entry,
         es-nonce = enc.er-nonce,
         es-cipher = enc.er-ciphertext,
         es-tag = enc.er-tag
       }

  vault-get-secret : VaultKey, Integer, EncryptedSecret -> Maybe SecretPayload
  vault-get-secret (vk) (secret-id) (es) =
    decrypt-payload vk secret-id es

  vault-remove-secret : Vault, Integer -> Vault
  vault-remove-secret (v) (id) =
    __record-set v "v-entries" (list-filter v.v-entries (entry-id-neq id))

  entry-id-neq : Integer -> SecretEntry -> Boolean
  entry-id-neq (id) (e) = e.se-id /= id

  vault-update-secret : Vault, SecretEntry -> Vault
  vault-update-secret (v) (updated) =
    __record-set v "v-entries" (list-map (replace-entry updated) v.v-entries)

  replace-entry : SecretEntry -> SecretEntry -> SecretEntry
  replace-entry (updated) (e) =
    if e.se-id == updated.se-id then updated else e

  vault-find-secret : Vault, Integer -> Maybe SecretEntry
  vault-find-secret (v) (id) =
    find-entry v.v-entries id

  find-entry : List SecretEntry, Integer -> Maybe SecretEntry
  find-entry (entries) (id) =
    if list-length entries == 0 then None
    else let head = list-at entries 0
      in if head.se-id == id then Just head
      else find-entry (list-drop entries 1) id

Section: Search and Filter

  vault-search : Vault, Text -> List SecretEntry
  vault-search (v) (query) =
    vault-search-loop v.v-entries query []

  vault-search-loop : List SecretEntry, Text, List SecretEntry -> List SecretEntry
  vault-search-loop (entries) (query) (acc) =
    if list-length entries == 0 then acc
    else let head = list-at entries 0
      in if head.se-archived == False
        then if secret-matches head query
          then vault-search-loop (list-drop entries 1) query (list-push acc head)
          else vault-search-loop (list-drop entries 1) query acc
        else vault-search-loop (list-drop entries 1) query acc

  vault-by-folder : Vault, Text -> List SecretEntry
  vault-by-folder (v) (folder) =
    vault-folder-loop v.v-entries folder []

  vault-folder-loop : List SecretEntry, Text, List SecretEntry -> List SecretEntry
  vault-folder-loop (entries) (folder) (acc) =
    if list-length entries == 0 then acc
    else let head = list-at entries 0
      in if head.se-folder == folder
        then if head.se-archived == False
          then vault-folder-loop (list-drop entries 1) folder (list-push acc head)
          else vault-folder-loop (list-drop entries 1) folder acc
        else vault-folder-loop (list-drop entries 1) folder acc

  vault-by-type : Vault, SecretType -> List SecretEntry
  vault-by-type (v) (stype) =
    vault-type-loop v.v-entries stype []

  vault-type-loop : List SecretEntry, SecretType, List SecretEntry -> List SecretEntry
  vault-type-loop (entries) (stype) (acc) =
    if list-length entries == 0 then acc
    else let head = list-at entries 0
      in if secret-type-matches head.se-type stype
        then vault-type-loop (list-drop entries 1) stype (list-push acc head)
        else vault-type-loop (list-drop entries 1) stype acc

  secret-type-matches : SecretType, SecretType -> Boolean
  secret-type-matches (a) (b) =
    secret-type-name a == secret-type-name b

  vault-favorites : Vault -> List SecretEntry
  vault-favorites (v) =
    vault-fav-loop v.v-entries []

  vault-fav-loop : List SecretEntry, List SecretEntry -> List SecretEntry
  vault-fav-loop (entries) (acc) =
    if list-length entries == 0 then acc
    else let head = list-at entries 0
      in if head.se-favorite
        then vault-fav-loop (list-drop entries 1) (list-push acc head)
        else vault-fav-loop (list-drop entries 1) acc

  vault-recent : Vault, Integer -> List SecretEntry
  vault-recent (v) (count) =
    list-take v.v-entries count

Section: Folder Management

  vault-add-folder : Vault, Text -> Vault
  vault-add-folder (v) (name) =
    if folder-exists v.v-folders name then v
    else __record-set v "v-folders" (list-push v.v-folders name)

  vault-remove-folder : Vault, Text -> Vault
  vault-remove-folder (v) (name) =
    if name == "Default" then v
    else __record-set v "v-folders" (list-filter v.v-folders (text-neq name))

  folder-exists : List Text, Text -> Boolean
  folder-exists (folders) (name) =
    if list-length folders == 0 then False
    else if list-at folders 0 == name then True
      else folder-exists (list-drop folders 1) name

  text-neq : Text -> Text -> Boolean
  text-neq (a) (b) = a /= b

Section: Statistics

  vault-count : Vault -> Integer
  vault-count (v) = list-length v.v-entries

  vault-count-by-type : Vault, SecretType -> Integer
  vault-count-by-type (v) (stype) =
    list-length (vault-by-type v stype)

  vault-count-by-folder : Vault, Text -> Integer
  vault-count-by-folder (v) (folder) =
    list-length (vault-by-folder v folder)
