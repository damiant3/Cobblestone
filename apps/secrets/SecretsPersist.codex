  cites Kernel chapter AppPersist
  cites Secrets chapter SecretEntry
  cites Secrets chapter Vault
  cites Secrets chapter AuditLog

 Persistent storage for the secrets vault. The vault index
 (metadata + entries) is serialized as kind 23 and the audit
 log as kind 24. Secret payloads remain encrypted in memory
 and are stored as opaque text fields.

Section: Kind Constants

  persist-kind-vault : Integer = 23
  persist-kind-audit : Integer = 24

Section: Secret Type Encoding

  secret-type-to-int : SecretType -> Integer
  secret-type-to-int (st) =
    when st
      is SecretPassword -> 0
      is SecretApiKey -> 1
      is SecretToken -> 2
      is SecretCertificate -> 3
      is SecretNote -> 4
      is SecretSshKey -> 5
      is SecretDatabase -> 6
      is SecretWifi -> 7
      is SecretCreditCard -> 8
      is SecretIdentity -> 9

  int-to-secret-type : Integer -> SecretType
  int-to-secret-type (n) =
    if n == 0 then SecretPassword
    else if n == 1 then SecretApiKey
    else if n == 2 then SecretToken
    else if n == 3 then SecretCertificate
    else if n == 4 then SecretNote
    else if n == 5 then SecretSshKey
    else if n == 6 then SecretDatabase
    else if n == 7 then SecretWifi
    else if n == 8 then SecretCreditCard
    else SecretIdentity

Section: Entry Serialization

  entry-to-line : SecretEntry -> Text
  entry-to-line (e) =
    show e.se-id & "|"
    & show (secret-type-to-int e.se-type) & "|"
    & e.se-name & "|"
    & e.se-username & "|"
    & e.se-url & "|"
    & e.se-folder & "|"
    & show e.se-created & "|"
    & show e.se-modified & "|"
    & show e.se-accessed & "|"
    & show e.se-access-count & "|"
    & (if e.se-favorite then "1" else "0") & "|"
    & (if e.se-archived then "1" else "0")

  entry-from-line : Text -> Maybe SecretEntry
  entry-from-line (line) =
    let parts = text-split line "|"
    in if list-length parts < 12 then None
    else Just (SecretEntry {
      se-id = parse-decimal-full (list-at parts 0),
      se-type = int-to-secret-type (parse-decimal-full (list-at parts 1)),
      se-name = list-at parts 2,
      se-username = list-at parts 3,
      se-url = list-at parts 4,
      se-folder = list-at parts 5,
      se-notes = "",
      se-tags = [],
      se-created = parse-decimal-full (list-at parts 6),
      se-modified = parse-decimal-full (list-at parts 7),
      se-accessed = parse-decimal-full (list-at parts 8),
      se-access-count = parse-decimal-full (list-at parts 9),
      se-favorite = list-at parts 10 == "1",
      se-archived = list-at parts 11 == "1"
    })

Section: Vault Serialization

  vault-to-text : Vault -> Text
  vault-to-text (v) =
    let header = v.v-id & "|" & v.v-name & "|"
          & (when v.v-type is PersonalVault -> "0" is TeamVault -> "1")
          & "|" & show v.v-next-id & "|" & show v.v-modified
          & "|" & folders-to-text v.v-folders
    in let entries = entries-to-lines v.v-entries 0 (list-length v.v-entries) ""
    in header & "\n" & entries

  folders-to-text : List Text -> Text
  folders-to-text (folders) =
    folders-join folders 0 (list-length folders) ""

  folders-join : List Text, Integer, Integer, Text -> Text
  folders-join (folders) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in folders-join folders (i + 1) len (acc & sep & list-at folders i)

  entries-to-lines : List SecretEntry, Integer, Integer, Text -> Text
  entries-to-lines (entries) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else "\n"
    in entries-to-lines entries (i + 1) len (acc & sep & entry-to-line (list-at entries i))

Section: Vault Index Serialization

  vault-index-to-text : VaultIndex -> Text
  vault-index-to-text (vi) =
    let header = "VAULTS:" & vi.vi-active & "|" & show (list-length vi.vi-vaults)
    in vaults-to-text vi.vi-vaults 0 (list-length vi.vi-vaults) header

  vaults-to-text : List Vault, Integer, Integer, Text -> Text
  vaults-to-text (vaults) (i) (len) (acc) =
    if i >= len then acc
    else let sep = "\n---\n"
    in vaults-to-text vaults (i + 1) len (acc & sep & vault-to-text (list-at vaults i))

Section: Vault Index Deserialization

  vault-index-from-text : Text -> VaultIndex
  vault-index-from-text (txt) =
    let blocks = text-split txt "\n---\n"
    in if list-length blocks < 2 then vault-index-new
    else let header-block = list-at blocks 0
    in let active = parse-vault-header-active header-block
    in let vaults = parse-vault-blocks blocks 1 (list-length blocks) []
    in VaultIndex {
      vi-vaults = vaults,
      vi-active = active,
      vi-master-key = None
    }

  parse-vault-header-active : Text -> Text
  parse-vault-header-active (header) =
    if starts-with header "VAULTS:" == False then "personal"
    else let rest = substring header 7 (text-length header - 7)
    in let parts = text-split rest "|"
    in if list-length parts > 0 then list-at parts 0 else "personal"

  parse-vault-blocks : List Text, Integer, Integer, List Vault -> List Vault
  parse-vault-blocks (blocks) (i) (len) (acc) =
    if i >= len then acc
    else let v = parse-vault-block (list-at blocks i)
    in when v
      is Just (vault) -> parse-vault-blocks blocks (i + 1) len (list-push acc vault)
      is None -> parse-vault-blocks blocks (i + 1) len acc

  parse-vault-block : Text -> Maybe Vault
  parse-vault-block (block) =
    let lines = text-split block "\n"
    in if list-length lines < 1 then None
    else let header = list-at lines 0
    in let parts = text-split header "|"
    in if list-length parts < 6 then None
    else let vid = list-at parts 0
    in let vname = list-at parts 1
    in let vtype = if list-at parts 2 == "0" then PersonalVault else TeamVault
    in let next-id = parse-decimal-full (list-at parts 3)
    in let modified = parse-decimal-full (list-at parts 4)
    in let folders = text-split (list-at parts 5) ","
    in let entries = parse-entry-lines lines 1 (list-length lines) []
    in Just (Vault {
      v-id = vid,
      v-name = vname,
      v-type = vtype,
      v-entries = entries,
      v-folders = folders,
      v-next-id = next-id,
      v-locked = True,
      v-modified = modified
    })

  parse-entry-lines : List Text, Integer, Integer, List SecretEntry -> List SecretEntry
  parse-entry-lines (lines) (i) (len) (acc) =
    if i >= len then acc
    else let line = list-at lines i
    in if text-length line == 0 then parse-entry-lines lines (i + 1) len acc
    else let parsed = entry-from-line line
    in when parsed
      is Just (e) -> parse-entry-lines lines (i + 1) len (list-push acc e)
      is None -> parse-entry-lines lines (i + 1) len acc

Section: Audit Log Serialization

  audit-to-text : AuditLog -> Text
  audit-to-text (log) =
    show (log.al-count)

  audit-from-text : Text -> AuditLog
  audit-from-text (txt) =
    let count = parse-decimal-full txt
    in AuditLog {
      al-entries = [],
      al-last-hash = [],
      al-count = count
    }

Section: Save and Load

  secrets-persist-save : DiskFactStore, VaultIndex, AuditLog, Integer -> DiskFactStore
  secrets-persist-save (store) (vi) (audit) (timestamp) =
    let s1 = app-write-fact store persist-kind-vault (vault-index-to-text vi) timestamp
    in let s2 = app-write-fact s1 persist-kind-audit (audit-to-text audit) timestamp
    in disk-checkpoint s2

  secrets-persist-load-vault : DiskFactStore -> VaultIndex
  secrets-persist-load-vault (store) =
    let found = app-scan-last store persist-kind-vault
    in when found
      is None -> vault-index-new
      is Just (txt) -> vault-index-from-text txt

  secrets-persist-load-audit : DiskFactStore -> AuditLog
  secrets-persist-load-audit (store) =
    let found = app-scan-last store persist-kind-audit
    in when found
      is None -> audit-log-new
      is Just (txt) -> audit-from-text txt
