 The main secrets manager application. Handles the lock screen,
 vault browsing, secret viewing/editing, and generation.

Section: Types

  AppView =
    | ViewLockScreen
    | ViewVaultList
    | ViewSecretList
    | ViewSecretDetail (Integer)
    | ViewSecretEdit (Integer)
    | ViewSecretNew
    | ViewGenerator
    | ViewAuditLog
    | ViewSettings

  SecretsAppState = record {
    sa-vault-index : VaultIndex,
    sa-view        : AppView,
    sa-search      : Text,
    sa-active-folder : Text,
    sa-audit       : AuditLog,
    sa-width       : Integer,
    sa-height      : Integer,
    sa-dirty       : Boolean,
    sa-password-input : Text,
    sa-password-cursor : Integer,
    sa-gen-policy  : PasswordPolicy,
    sa-gen-result  : Text,
    sa-status      : Text,
    sa-clipboard   : Text,
    sa-clipboard-clear-at : Integer,
    sa-tick        : Integer
  }

Section: Initialization

  secrets-app-init : Integer, Integer -> SecretsAppState
  secrets-app-init (w) (h) =
    SecretsAppState {
      sa-vault-index = vault-index-new,
      sa-view = ViewLockScreen,
      sa-search = "",
      sa-active-folder = "Default",
      sa-audit = audit-log-new,
      sa-width = w,
      sa-height = h,
      sa-dirty = True,
      sa-password-input = "",
      sa-password-cursor = 0,
      sa-gen-policy = policy-strong,
      sa-gen-result = "",
      sa-status = "Locked",
      sa-clipboard = "",
      sa-clipboard-clear-at = 0,
      sa-tick = 0
    }

Section: Lock Screen

  secrets-handle-lock-key : SecretsAppState, Event -> SecretsAppState
  secrets-handle-lock-key (state) (ev) =
    let k = ev.ev-key
    in if k == 13
      then secrets-try-unlock state
      else if k == 8
      then if state.sa-password-cursor > 0
        then let new-pw = text-take state.sa-password-input (state.sa-password-cursor - 1)
              & text-drop state.sa-password-input state.sa-password-cursor
          in let s1 = __record-set state "sa-password-input" new-pw
          in let s2 = __record-set s1 "sa-password-cursor" (state.sa-password-cursor - 1)
          in __record-set s2 "sa-dirty" True
        else state
      else if k >= 32
      then let ch = char-to-text (code-to-char (from-unicode k))
        in let new-pw = text-take state.sa-password-input state.sa-password-cursor
              & ch & text-drop state.sa-password-input state.sa-password-cursor
        in let s1 = __record-set state "sa-password-input" new-pw
        in let s2 = __record-set s1 "sa-password-cursor" (state.sa-password-cursor + 1)
        in __record-set s2 "sa-dirty" True
      else state

  secrets-try-unlock : SecretsAppState -> SecretsAppState
  secrets-try-unlock (state) =
    let vi = vault-unlock state.sa-vault-index state.sa-password-input
    in let audit = audit-record state.sa-audit AuditLogin 0 "" "" "user" "" state.sa-tick
    in let s1 = __record-set state "sa-vault-index" vi
    in let s2 = __record-set s1 "sa-view" ViewSecretList
    in let s3 = __record-set s2 "sa-password-input" ""
    in let s4 = __record-set s3 "sa-audit" audit
    in __record-set s4 "sa-status" "Unlocked"

Section: Event Handling

  secrets-handle-event : SecretsAppState, Event -> SecretsAppState
  secrets-handle-event (state) (ev) =
    let ticked = __record-set state "sa-tick" (state.sa-tick + 1)
    in let cleared = if ticked.sa-clipboard-clear-at > 0
          then if ticked.sa-tick >= ticked.sa-clipboard-clear-at
            then __record-set (__record-set ticked "sa-clipboard" "") "sa-clipboard-clear-at" 0
            else ticked
          else ticked
    in when ev.ev-kind
      is EvKeyDown ->
        when cleared.sa-view
          is ViewLockScreen -> secrets-handle-lock-key cleared ev
          is otherwise -> secrets-handle-main-key cleared ev
      is otherwise -> cleared

  secrets-handle-main-key : SecretsAppState, Event -> SecretsAppState
  secrets-handle-main-key (state) (ev) =
    let k = ev.ev-key
    in let mods = ev.ev-modifiers
    in let ctrl = int-mod (mods / 1) 2 == 1
    in if ctrl
      then secrets-handle-ctrl-key state k
      else secrets-handle-plain-key state k

  secrets-handle-ctrl-key : SecretsAppState, Integer -> SecretsAppState
  secrets-handle-ctrl-key (state) (k) =
    if k == 78 then __record-set (__record-set state "sa-view" ViewSecretNew) "sa-dirty" True
    else if k == 70 then __record-set state "sa-dirty" True
    else if k == 71 then __record-set (__record-set state "sa-view" ViewGenerator) "sa-dirty" True
    else if k == 76 then secrets-lock state
    else state

  secrets-handle-plain-key : SecretsAppState, Integer -> SecretsAppState
  secrets-handle-plain-key (state) (k) =
    if k == 27 then __record-set (__record-set state "sa-view" ViewSecretList) "sa-dirty" True
    else state

  secrets-lock : SecretsAppState -> SecretsAppState
  secrets-lock (state) =
    let vi = vault-lock state.sa-vault-index
    in let audit = audit-record state.sa-audit AuditLogout 0 "" "" "user" "" state.sa-tick
    in let s1 = __record-set state "sa-vault-index" vi
    in let s2 = __record-set s1 "sa-view" ViewLockScreen
    in let s3 = __record-set s2 "sa-audit" audit
    in __record-set s3 "sa-status" "Locked"

Section: Secret Operations

  secrets-copy-password : SecretsAppState, Integer -> SecretsAppState
  secrets-copy-password (state) (secret-id) =
    let vault = vault-active state.sa-vault-index
    in when vault
      is None -> state
      is Just (v) ->
        let entry = vault-find-secret v secret-id
        in when entry
          is None -> state
          is Just (e) ->
            let audit = audit-record state.sa-audit AuditRead secret-id e.se-name v.v-id "user" "copy password" state.sa-tick
            in let touched = secret-touch e state.sa-tick
            in let s1 = __record-set state "sa-clipboard" "***copied***"
            in let s2 = __record-set s1 "sa-clipboard-clear-at" (state.sa-tick + 1800)
            in let s3 = __record-set s2 "sa-audit" audit
            in __record-set s3 "sa-status" ("Copied: " & e.se-name & " (clears in 30s)")

  secrets-add-entry : SecretsAppState, SecretType, Text, Text, Text, Text -> SecretsAppState
  secrets-add-entry (state) (stype) (name) (username) (url) (password) =
    let vault = vault-active state.sa-vault-index
    in when vault
      is None -> state
      is Just (v) ->
        let updated = vault-add-secret v stype name username url password state.sa-tick
        in let audit = audit-record state.sa-audit AuditCreate updated.v-next-id name v.v-id "user" (secret-type-name stype) state.sa-tick
        in let s1 = __record-set state "sa-vault-index" (update-vault-in state.sa-vault-index updated)
        in let s2 = __record-set s1 "sa-view" ViewSecretList
        in let s3 = __record-set s2 "sa-audit" audit
        in __record-set s3 "sa-status" ("Created: " & name)

  secrets-delete-entry : SecretsAppState, Integer -> SecretsAppState
  secrets-delete-entry (state) (secret-id) =
    let vault = vault-active state.sa-vault-index
    in when vault
      is None -> state
      is Just (v) ->
        let entry = vault-find-secret v secret-id
        in let name = when entry is Just (e) -> e.se-name is None -> "unknown"
        in let updated = vault-remove-secret v secret-id
        in let audit = audit-record state.sa-audit AuditDelete secret-id name v.v-id "user" "" state.sa-tick
        in let s1 = __record-set state "sa-vault-index" (update-vault-in state.sa-vault-index updated)
        in let s2 = __record-set s1 "sa-view" ViewSecretList
        in let s3 = __record-set s2 "sa-audit" audit
        in __record-set s3 "sa-status" ("Deleted: " & name)

  update-vault-in : VaultIndex, Vault -> VaultIndex
  update-vault-in (vi) (updated) =
    __record-set vi "vi-vaults" (list-map (replace-vault updated) vi.vi-vaults)

  replace-vault : Vault, Vault -> Vault
  replace-vault (updated) (v) =
    if v.v-id == updated.v-id then updated else v

Section: Password Generation

  secrets-generate : SecretsAppState -> SecretsAppState
  secrets-generate (state) =
    let password = generate-password state.sa-gen-policy state.sa-tick
    in let strength = assess-strength password
    in let s1 = __record-set state "sa-gen-result" password
    in let s2 = __record-set s1 "sa-status" ("Generated: " & strength-name strength)
    in __record-set s2 "sa-dirty" True

  secrets-generate-passphrase : SecretsAppState -> SecretsAppState
  secrets-generate-passphrase (state) =
    let passphrase = generate-passphrase 5 state.sa-tick "-"
    in let s1 = __record-set state "sa-gen-result" passphrase
    in __record-set s1 "sa-status" "Generated passphrase"

Section: Rendering

  secrets-render : SecretsAppState -> WidgetNode
  secrets-render (state) =
    when state.sa-view
      is ViewLockScreen -> render-lock-screen state
      is ViewSecretList -> render-secret-list state
      is ViewSecretDetail (id) -> render-secret-detail state id
      is ViewGenerator -> render-generator state
      is ViewAuditLog -> render-audit-view state
      is otherwise -> render-secret-list state

  render-lock-screen : SecretsAppState -> WidgetNode
  render-lock-screen (state) =
    let title = widget-label "lock-title" "Codex Secrets"
    in let subtitle = widget-label "lock-subtitle" "Enter master password to unlock"
    in let pw-mask = text-repeat "*" (text-length state.sa-password-input)
    in let pw-input = widget-input "master-pw" pw-mask state.sa-password-cursor
    in let unlock-btn = widget-button "unlock" "Unlock"
    in widget-panel "lock-screen" DirColumn 16 [
      title, subtitle, pw-input, unlock-btn
    ]

  text-repeat : Text, Integer -> Text
  text-repeat (ch) (n) =
    if n <= 0 then ""
    else ch & text-repeat ch (n - 1)

  render-secret-list : SecretsAppState -> WidgetNode
  render-secret-list (state) =
    let vault = vault-active state.sa-vault-index
    in when vault
      is None -> widget-label "no-vault" "No vault available"
      is Just (v) ->
        let header = render-list-header state v
        in let entries = if text-length state.sa-search > 0
              then vault-search v state.sa-search
              else vault-by-folder v state.sa-active-folder
        in let items = list-map render-secret-row entries
        in let sidebar = render-folder-sidebar v state.sa-active-folder
        in let list-panel = widget-panel "secret-list" DirColumn 2 items
        in let main-area = widget-panel "main" DirRow 0 [
              widget-set-min sidebar 180 0,
              widget-set-flex list-panel 1
            ]
        in let status = widget-label "status" state.sa-status
        in widget-panel "app" DirColumn 0 [
          header, widget-set-flex main-area 1, status
        ]

  render-list-header : SecretsAppState, Vault -> WidgetNode
  render-list-header (state) (v) =
    let vault-name = widget-label "vault-name" v.v-name
    in let search = widget-input "search" state.sa-search 0
    in let new-btn = widget-button "new-secret" "+ New"
    in let gen-btn = widget-button "generator" "Generate"
    in let lock-btn = widget-button "lock" "Lock"
    in let count = widget-label "count" (show (vault-count v) & " secrets")
    in widget-panel "header" DirRow 8 [
      vault-name, widget-set-flex search 1, count, new-btn, gen-btn, lock-btn
    ]

  render-folder-sidebar : Vault, Text -> WidgetNode
  render-folder-sidebar (v) (active) =
    let all-btn = widget-button "folder-All" ("All (" & show (vault-count v) & ")")
    in let fav-btn = widget-button "folder-Favorites" ("Favorites (" & show (list-length (vault-favorites v)) & ")")
    in let folder-btns = list-map (render-folder-btn v active) v.v-folders
    in widget-panel "sidebar" DirColumn 2 (all-btn :: fav-btn :: folder-btns)

  render-folder-btn : Vault, Text, Text -> WidgetNode
  render-folder-btn (v) (active) (folder) =
    let count = vault-count-by-folder v folder
    in let label = folder & " (" & show count & ")"
    in let btn = widget-button ("folder-" & folder) label
    in if folder == active then widget-set-state btn 1 else btn

  render-secret-row : SecretEntry -> WidgetNode
  render-secret-row (e) =
    let icon = widget-label ("icon-" & show e.se-id) (secret-type-icon e.se-type)
    in let name = widget-label ("name-" & show e.se-id) e.se-name
    in let user = widget-label ("user-" & show e.se-id) e.se-username
    in let url = widget-label ("url-" & show e.se-id) e.se-url
    in let fav = if e.se-favorite then widget-label ("fav-" & show e.se-id) "*" else widget-label ("fav-" & show e.se-id) ""
    in let copy-btn = widget-button ("copy-" & show e.se-id) "Copy"
    in widget-panel ("row-" & show e.se-id) DirRow 8 [
      icon, widget-set-flex name 1, user, url, fav, copy-btn
    ]

  render-secret-detail : SecretsAppState, Integer -> WidgetNode
  render-secret-detail (state) (id) =
    let vault = vault-active state.sa-vault-index
    in when vault
      is None -> widget-label "no-vault" "No vault"
      is Just (v) ->
        let entry = vault-find-secret v id
        in when entry
          is None -> widget-label "not-found" "Secret not found"
          is Just (e) ->
            let header = widget-label "detail-title" e.se-name
            in let type-label = widget-label "detail-type" (secret-type-name e.se-type)
            in let user-label = widget-label "detail-user" ("Username: " & e.se-username)
            in let url-label = widget-label "detail-url" ("URL: " & e.se-url)
            in let pw-label = widget-label "detail-pw" "Password: ********"
            in let folder-label = widget-label "detail-folder" ("Folder: " & e.se-folder)
            in let created = widget-label "detail-created" ("Created: " & show e.se-created)
            in let modified = widget-label "detail-modified" ("Modified: " & show e.se-modified)
            in let accesses = widget-label "detail-accesses" ("Accesses: " & show e.se-access-count)
            in let copy-btn = widget-button "copy-pw" "Copy Password"
            in let edit-btn = widget-button "edit-secret" "Edit"
            in let del-btn = widget-button "delete-secret" "Delete"
            in let back-btn = widget-button "back" "Back"
            in let buttons = widget-panel "buttons" DirRow 8 [copy-btn, edit-btn, del-btn, back-btn]
            in widget-panel "detail" DirColumn 8 [
              header, widget-separator "sep1",
              type-label, user-label, url-label, pw-label,
              widget-separator "sep2",
              folder-label, created, modified, accesses,
              widget-separator "sep3",
              buttons
            ]

  render-generator : SecretsAppState -> WidgetNode
  render-generator (state) =
    let title = widget-label "gen-title" "Password Generator"
    in let result = widget-label "gen-result" (if text-length state.sa-gen-result > 0 then state.sa-gen-result else "(click Generate)")
    in let strength = if text-length state.sa-gen-result > 0
          then widget-label "gen-strength" ("Strength: " & strength-name (assess-strength state.sa-gen-result))
          else widget-label "gen-strength" ""
    in let gen-btn = widget-button "do-generate" "Generate Password"
    in let phrase-btn = widget-button "do-passphrase" "Generate Passphrase"
    in let copy-btn = widget-button "copy-generated" "Copy"
    in let back-btn = widget-button "gen-back" "Back"
    in let policy-label = widget-label "policy" ("Length: " & show state.sa-gen-policy.pp-length & " | Uppercase | Lowercase | Digits | Symbols")
    in widget-panel "generator" DirColumn 12 [
      title, widget-separator "sep",
      result, strength, policy-label,
      widget-panel "gen-buttons" DirRow 8 [gen-btn, phrase-btn, copy-btn, back-btn]
    ]

  render-audit-view : SecretsAppState -> WidgetNode
  render-audit-view (state) =
    let title = widget-label "audit-title" "Audit Log"
    in let count = widget-label "audit-count" (show state.sa-audit.al-count & " entries")
    in let verified = widget-label "audit-verified" (if audit-verify-chain state.sa-audit then "Chain: verified" else "Chain: BROKEN")
    in let recent = audit-recent state.sa-audit 20
    in let items = list-map render-audit-row recent
    in let back-btn = widget-button "audit-back" "Back"
    in widget-panel "audit" DirColumn 4 [
      title, count, verified,
      widget-separator "sep",
      widget-panel "audit-list" DirColumn 2 items,
      back-btn
    ]

  render-audit-row : AuditEntry -> WidgetNode
  render-audit-row (e) =
    widget-label ("audit-" & show e.ae-timestamp) (format-audit-entry e)

Section: Main Loop

  secrets-app-run : SecretsAppState -> [Console] Nothing
  secrets-app-run (state) = act
    print-line "  Vault: My Vault"
    print-line "  Status: Locked"
    print-line "  Enter master password to unlock."
    secrets-event-loop state
  end

  secrets-event-loop : SecretsAppState -> [Console] Nothing
  secrets-event-loop (state) = act
    ev <- secrets-poll-event
    let handled = secrets-handle-event state ev
    in secrets-event-loop handled
  end

  secrets-poll-event : [Console] Event
  secrets-poll-event = act
    let scan = poll-key
    in if scan == 0
      then event-timer "tick" 0
      else event-key-down scan 0 0
  end
