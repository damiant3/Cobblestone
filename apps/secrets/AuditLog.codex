Chapter: AuditLog
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256

 Audit log for secret access. Records every read, create,
 update, and delete with timestamp and actor identity.
 The log is append-only and hash-chained for tamper detection.

Section: Types

  AuditAction =
    | AuditRead
    | AuditCreate
    | AuditUpdate
    | AuditDelete
    | AuditShare
    | AuditUnshare
    | AuditExport
    | AuditLogin
    | AuditLogout
    | AuditLockout

  AuditEntry = record {
    ae-timestamp  : Integer,
    ae-action     : AuditAction,
    ae-secret-id  : Integer,
    ae-secret-name : Text,
    ae-vault-id   : Text,
    ae-actor      : Text,
    ae-detail     : Text,
    ae-prev-hash  : List Integer
  }

  AuditLog = record {
    al-entries  : List AuditEntry,
    al-last-hash : List Integer,
    al-count    : Integer
  }

Section: Construction

  audit-log-new : AuditLog
  audit-log-new =
    AuditLog {
      al-entries = [],
      al-last-hash = sha256 (text-to-bytes "codex-audit-genesis"),
      al-count = 0
    }

Section: Logging

  audit-record : AuditLog, AuditAction, Integer, Text, Text, Text, Text, Integer -> AuditLog
  audit-record (log) (action) (secret-id) (secret-name) (vault-id) (actor) (detail) (timestamp) =
    let entry = AuditEntry {
      ae-timestamp = timestamp,
      ae-action = action,
      ae-secret-id = secret-id,
      ae-secret-name = secret-name,
      ae-vault-id = vault-id,
      ae-actor = actor,
      ae-detail = detail,
      ae-prev-hash = log.al-last-hash
    }
    in let entry-hash = hash-audit-entry entry
    in __record-set (__record-set (__record-set log
      "al-entries" (list-push log.al-entries entry))
      "al-last-hash" entry-hash)
      "al-count" (log.al-count + 1)

  hash-audit-entry : AuditEntry -> List Integer
  hash-audit-entry (e) =
    sha256 (text-to-bytes (
      show e.ae-timestamp & ":"
      & audit-action-name e.ae-action & ":"
      & show e.ae-secret-id & ":"
      & e.ae-vault-id & ":"
      & e.ae-actor)
      & e.ae-prev-hash)

Section: Verification

  audit-verify-chain : AuditLog -> Boolean
  audit-verify-chain (log) =
    verify-chain-loop log.al-entries (sha256 (text-to-bytes "codex-audit-genesis")) 0

  verify-chain-loop : List AuditEntry, List Integer, Integer -> Boolean
  verify-chain-loop (entries) (expected-prev) (i) =
    if i >= list-length entries then True
    else let entry = list-at entries i
    in let prev-matches = bytes-eq-audit entry.ae-prev-hash expected-prev
    in if prev-matches == False then False
    else let entry-hash = hash-audit-entry entry
    in verify-chain-loop entries entry-hash (i + 1)

  bytes-eq-audit : List Integer, List Integer -> Boolean
  bytes-eq-audit (a) (b) =
    if list-length a /= list-length b then False
    else bytes-eq-loop-audit a b 0

  bytes-eq-loop-audit : List Integer, List Integer, Integer -> Boolean
  bytes-eq-loop-audit (a) (b) (i) =
    if i >= list-length a then True
    else if list-at a i /= list-at b i then False
    else bytes-eq-loop-audit a b (i + 1)

Section: Queries

  audit-for-secret : AuditLog, Integer -> List AuditEntry
  audit-for-secret (log) (secret-id) =
    audit-filter-loop log.al-entries secret-id []

  audit-filter-loop : List AuditEntry, Integer, List AuditEntry -> List AuditEntry
  audit-filter-loop (entries) (sid) (acc) =
    when entries
      is [] -> acc
      is otherwise ->
        let head = list-at entries 0
        in if head.ae-secret-id == sid
          then audit-filter-loop (list-drop entries 1) sid (list-push acc head)
          else audit-filter-loop (list-drop entries 1) sid acc

  audit-recent : AuditLog, Integer -> List AuditEntry
  audit-recent (log) (count) =
    let total = list-length log.al-entries
    in if count >= total then log.al-entries
    else list-drop log.al-entries (total - count)

Section: Action Names

  audit-action-name : AuditAction -> Text
  audit-action-name (a) =
    when a
      is AuditRead -> "read"
      is AuditCreate -> "create"
      is AuditUpdate -> "update"
      is AuditDelete -> "delete"
      is AuditShare -> "share"
      is AuditUnshare -> "unshare"
      is AuditExport -> "export"
      is AuditLogin -> "login"
      is AuditLogout -> "logout"
      is AuditLockout -> "lockout"

  format-audit-entry : AuditEntry -> Text
  format-audit-entry (e) =
    show e.ae-timestamp & " " & audit-action-name e.ae-action
    & " " & e.ae-secret-name & " by " & e.ae-actor
    & (if text-length e.ae-detail > 0 then " (" & e.ae-detail & ")" else "")
