Chapter: CollabTheme
  cites Collab chapter CollabTypes

 Theme for the collaboration app. Presence colors, call
 indicators, meeting status, and layout constants.

Section: Call Colors

  ct-ringing-color : Integer = 0x58a6ff
  ct-connected-color : Integer = 0x3fb950
  ct-hold-color : Integer = 0xffd700
  ct-ended-color : Integer = 0x484f58
  ct-recording-color : Integer = 0xf85149

  ct-call-state-color : CallState -> Integer
  ct-call-state-color (s) = when s
    is CsRinging -> ct-ringing-color
    is CsConnecting -> ct-ringing-color
    is CsConnected -> ct-connected-color
    is CsOnHold -> ct-hold-color
    is CsEnded -> ct-ended-color
    is CsDeclined -> ct-ended-color
    is CsMissed -> ct-ended-color

Section: Role Colors

  ct-host-color : Integer = 0xffd700
  ct-cohost-color : Integer = 0xf0883e
  ct-presenter-color : Integer = 0xa371f7
  ct-participant-color : Integer = 0x58a6ff
  ct-viewer-color : Integer = 0x8b949e

  ct-role-color : ParticipantRole -> Integer
  ct-role-color (r) = when r
    is PrHost -> ct-host-color
    is PrCoHost -> ct-cohost-color
    is PrPresenter -> ct-presenter-color
    is PrParticipant -> ct-participant-color
    is PrViewer -> ct-viewer-color

Section: Layout

  ct-bg : Integer = 0x0d1117
  ct-surface : Integer = 0x161b22
  ct-border : Integer = 0x30363d
  ct-text-primary : Integer = 0xf0f6fc
  ct-text-secondary : Integer = 0x8b949e
  ct-sidebar-width : Integer = 260
  ct-toolbar-height : Integer = 52
  ct-video-tile-min : Integer = 160
  ct-chat-width : Integer = 300
