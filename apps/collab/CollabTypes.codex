Chapter: CollabTypes
  cites Foreword chapter Maybe

 Core types for the Codex collaboration platform. Video calls,
 screen sharing, meeting rooms, presence, recording, and
 integration with Vision/Helm/Browser/Diagram.

Section: User Presence

  PresenceStatus =
    | PsOnline
    | PsAway
    | PsBusy
    | PsDnd
    | PsInCall
    | PsPresenting
    | PsOffline

  ps-label : PresenceStatus -> Text
  ps-label (s) = when s
    is PsOnline -> "Online"
    is PsAway -> "Away"
    is PsBusy -> "Busy"
    is PsDnd -> "Do Not Disturb"
    is PsInCall -> "In Call"
    is PsPresenting -> "Presenting"
    is PsOffline -> "Offline"

  ps-color : PresenceStatus -> Integer
  ps-color (s) = when s
    is PsOnline -> #3fb950
    is PsAway -> #ffd700
    is PsBusy -> #f0883e
    is PsDnd -> #f85149
    is PsInCall -> #58a6ff
    is PsPresenting -> #a371f7
    is PsOffline -> #484f58

  ps-available : PresenceStatus -> Boolean
  ps-available (s) = when s
    is PsOnline -> True
    is PsAway -> True
    is otherwise -> False

  CollabUser = record {
    cu-id : Text,
    cu-name : Text,
    cu-email : Text,
    cu-avatar : Text,
    cu-status : PresenceStatus,
    cu-status-text : Text,
    cu-last-active : Integer,
    cu-timezone : Integer,
    cu-favorites : List Text,
    cu-favorite-count : Integer
  }

Section: Call Types

  CallType =
    | CtAudio
    | CtVideo
    | CtScreen

  CallState =
    | CsRinging
    | CsConnecting
    | CsConnected
    | CsOnHold
    | CsEnded
    | CsDeclined
    | CsMissed

  cs-label : CallState -> Text
  cs-label (s) = when s
    is CsRinging -> "Ringing"
    is CsConnecting -> "Connecting"
    is CsConnected -> "Connected"
    is CsOnHold -> "On Hold"
    is CsEnded -> "Ended"
    is CsDeclined -> "Declined"
    is CsMissed -> "Missed"

  CallParticipant = record {
    cp-user-id : Text,
    cp-name : Text,
    cp-muted : Boolean,
    cp-video-on : Boolean,
    cp-screen-sharing : Boolean,
    cp-hand-raised : Boolean,
    cp-speaking : Boolean,
    cp-joined-at : Integer,
    cp-role : ParticipantRole
  }

  ParticipantRole =
    | PrHost
    | PrCoHost
    | PrPresenter
    | PrParticipant
    | PrViewer

  pr-label : ParticipantRole -> Text
  pr-label (r) = when r
    is PrHost -> "Host"
    is PrCoHost -> "Co-Host"
    is PrPresenter -> "Presenter"
    is PrParticipant -> "Participant"
    is PrViewer -> "Viewer"

  pr-can-mute-others : ParticipantRole -> Boolean
  pr-can-mute-others (r) = when r
    is PrHost -> True
    is PrCoHost -> True
    is otherwise -> False

  pr-can-share-screen : ParticipantRole -> Boolean
  pr-can-share-screen (r) = when r
    is PrViewer -> False
    is otherwise -> True

  Call = record {
    call-id : Text,
    call-type : CallType,
    call-state : CallState,
    call-participants : List CallParticipant,
    call-participant-count : Integer,
    call-started : Integer,
    call-ended : Integer,
    call-recording : Boolean,
    call-max-participants : Integer,
    call-title : Text,
    call-host : Text
  }

Section: Meeting Room

  MeetingType =
    | MtInstant
    | MtScheduled
    | MtRecurring
    | MtWebinar

  mt-label : MeetingType -> Text
  mt-label (t) = when t
    is MtInstant -> "Instant"
    is MtScheduled -> "Scheduled"
    is MtRecurring -> "Recurring"
    is MtWebinar -> "Webinar"

  MeetingRoom = record {
    mr-id : Text,
    mr-title : Text,
    mr-type : MeetingType,
    mr-host : Text,
    mr-scheduled-start : Integer,
    mr-scheduled-end : Integer,
    mr-actual-start : Integer,
    mr-actual-end : Integer,
    mr-call : Maybe Call,
    mr-agenda : List AgendaItem,
    mr-agenda-count : Integer,
    mr-notes : Text,
    mr-recording-url : Text,
    mr-recurrence : Text,
    mr-password : Text,
    mr-waiting-room : Boolean,
    mr-allow-screen-share : Boolean,
    mr-auto-record : Boolean,
    mr-max-participants : Integer
  }

  AgendaItem = record {
    ai-title : Text,
    ai-duration-min : Integer,
    ai-presenter : Text,
    ai-completed : Boolean,
    ai-notes : Text
  }

Section: Screen Sharing

  ShareSource =
    | SsFullScreen
    | SsWindow (Text)
    | SsRegion (Integer, Integer, Integer, Integer)
    | SsWhiteboard
    | SsDocument (Text)
    | SsApp (Text)

  ss-label : ShareSource -> Text
  ss-label (s) = when s
    is SsFullScreen -> "Entire Screen"
    is SsWindow (name) -> "Window: " & name
    is SsRegion (x, y, w, h) -> "Region"
    is SsWhiteboard -> "Whiteboard"
    is SsDocument (name) -> "Document: " & name
    is SsApp (name) -> "App: " & name

  ScreenShare = record {
    shr-presenter : Text,
    shr-source : ShareSource,
    shr-active : Boolean,
    shr-started : Integer,
    shr-annotations-on : Boolean,
    shr-remote-control : Maybe Text,
    shr-fps : Integer,
    shr-quality : ShareQuality
  }

  ShareQuality =
    | SqAuto
    | SqHigh
    | SqMedium
    | SqLow
    | SqTextOptimized

Section: Whiteboard

  WhiteboardTool =
    | WbPen
    | WbHighlighter
    | WbEraser
    | WbText
    | WbShape
    | WbArrow
    | WbLaser

  WhiteboardStroke = record {
    ws-id : Integer,
    ws-tool : WhiteboardTool,
    ws-color : Integer,
    ws-width : Integer,
    ws-points : List Integer,
    ws-point-count : Integer,
    ws-author : Text
  }

  Whiteboard = record {
    wb-strokes : List WhiteboardStroke,
    wb-stroke-count : Integer,
    wb-next-id : Integer,
    wb-bg-color : Integer,
    wb-width : Integer,
    wb-height : Integer
  }

Section: Recording

  RecordingState =
    | RecIdle
    | RecRecording
    | RecPaused
    | RecStopped

  Recording = record {
    rec-id : Text,
    rec-meeting-id : Text,
    rec-state : RecordingState,
    rec-started : Integer,
    rec-duration-sec : Integer,
    rec-size-bytes : Integer,
    rec-has-video : Boolean,
    rec-has-screen : Boolean,
    rec-has-transcript : Boolean
  }

Section: Chat Within Call

  CallMessage = record {
    cm-id : Integer,
    cm-author : Text,
    cm-content : Text,
    cm-timestamp : Integer,
    cm-is-system : Boolean,
    cm-mentions : List Text
  }

  CallChat = record {
    cc-messages : List CallMessage,
    cc-count : Integer,
    cc-next-id : Integer,
    cc-unread : Integer
  }

  cc-new : CallChat
  cc-new = CallChat { cc-messages = [], cc-count = 0, cc-next-id = 1, cc-unread = 0 }

  cc-send : CallChat, Text, Text, Integer -> CallChat
  cc-send (chat) (author) (content) (now) =
    let msg = CallMessage {
      cm-id = chat.cc-next-id,
      cm-author = author,
      cm-content = content,
      cm-timestamp = now,
      cm-is-system = False,
      cm-mentions = []
    }
    in CallChat {
      cc-messages = list-push chat.cc-messages msg,
      cc-count = chat.cc-count + 1,
      cc-next-id = chat.cc-next-id + 1,
      cc-unread = chat.cc-unread + 1
    }

Section: Reactions

  Reaction =
    | RxThumbsUp
    | RxClap
    | RxHeart
    | RxLaugh
    | RxSurprised
    | RxThinking
    | RxSlowDown
    | RxSpeedUp

  rx-label : Reaction -> Text
  rx-label (r) = when r
    is RxThumbsUp -> "[+1]"
    is RxClap -> "[clap]"
    is RxHeart -> "[heart]"
    is RxLaugh -> "[laugh]"
    is RxSurprised -> "[!]"
    is RxThinking -> "[?]"
    is RxSlowDown -> "[<<]"
    is RxSpeedUp -> "[>>]"

Section: Call History

  CallRecord = record {
    cr-id : Text,
    cr-title : Text,
    cr-type : CallType,
    cr-participants : List Text,
    cr-participant-count : Integer,
    cr-started : Integer,
    cr-duration-sec : Integer,
    cr-has-recording : Boolean
  }

Section: Integration Hooks

  IntegrationSource =
    | IsVision (Integer)
    | IsHelm (Text)
    | IsDiagram (Text)
    | IsBrowser (Text)
    | IsCalendar (Integer)
    | IsDirect

  is-label : IntegrationSource -> Text
  is-label (s) = when s
    is IsVision (sig-id) -> "Vision Signal #" & show sig-id
    is IsHelm (room-id) -> "Helm Room: " & room-id
    is IsDiagram (name) -> "Diagram: " & name
    is IsBrowser (url) -> "Browser: " & url
    is IsCalendar (event-id) -> "Calendar Event #" & show event-id
    is IsDirect -> "Direct"
