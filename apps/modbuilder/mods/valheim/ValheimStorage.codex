Section: Engine Entry

  effect Process where
    unity-storage-start : (List StorageSlot, Integer -> StoragePlan), (List StorageSlot, Integer -> StoragePlan) -> [Process] Nothing
    unity-meadows-spawns-start : (Integer, Integer -> Integer) -> [Process] Nothing
    unity-circumhorizontal-arc-start : ArcPreviewSettings -> [Process] Nothing

Section: Entry

  opening : [Process] Nothing = act
    unity-storage-start storage-plan-deposit storage-plan-withdraw
    unity-meadows-spawns-start meadows-neck-clearance-delay
    unity-circumhorizontal-arc-start arc-preview-settings
  end
