Chapter: Meadows Spawns

Section: Policy

  meadows-neck-clearance-delay : Integer, Integer -> Integer
  meadows-neck-clearance-delay (day-seconds) (draw) =
    if day-seconds <= 0 then 0
    else let extra-days = if draw < 0 then 0 else if draw > 7 then 7 else draw
    in day-seconds * (7 + extra-days)
