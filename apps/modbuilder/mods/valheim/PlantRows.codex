Chapter: Plant Rows

Section: Policy

  plant-row-length : Integer -> Integer
  plant-row-length (farming) =
    if farming <= 0 then 1
    else let n = 1 + farming / 10
    in if n > 10 then 10 else n

  plant-row-spacing : Integer -> Integer
  plant-row-spacing (grow-radius-cm) =
    if grow-radius-cm <= 0 then 50 else grow-radius-cm * 2
