Chapter: Loadout

 Native slot kinds: 1 head, 2 torso, 3 legs, 4 back, 5 food, 6 mead, 7 ammo.

  loadout-slot-kind : Integer -> Integer
  loadout-slot-kind (slot) =
    if slot < 0 then 0
    else if slot < 4 then slot + 1
    else if slot < 7 then 5
    else if slot < 10 then 6
    else if slot < 14 then 7
    else 0
