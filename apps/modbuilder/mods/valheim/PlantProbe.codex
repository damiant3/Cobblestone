        ],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "seeds",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess
                          (CstMemberAccess
