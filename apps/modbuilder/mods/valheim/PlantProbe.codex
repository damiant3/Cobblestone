  unity-plant-probe-emit : [Console] Nothing
  unity-plant-probe-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstInternal, CstSealed], ch-name = "PrismPlantProbe", ch-bases = [(CstNamedType "UnityEngine.MonoBehaviour" [])] }) unity-plant-probe-members 0

  opening : [Console] Nothing = act
    print-uni (cst-namespace-open "PrismGenerated")
    unity-plant-probe-emit
    print-uni cst-close-scope
  end
