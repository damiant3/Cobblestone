                          [
                            CstParameter {
                              cp-modifiers = [],
                              cp-type = CstInferredType,
                              cp-name = "p",
                              cp-default = None
                            }
                          ]
                          (CstBinary
                            CstAnd
                            (CstCall
                              (CstMemberAccess (CstName "p" []) "GetComponent" [(CstNamedType "ZNetView" [])])
                              []
                            )
                            (CstBinary
                              CstNotEqual
                              (CstCall
                                (CstMemberAccess
                                  (CstCall
                                    (CstMemberAccess (CstName "p" []) "GetComponent" [(CstNamedType "ZNetView" [])])
                                    []
                                  )
                                  "GetZDO"
                                  []
                                )
                                []
                              )
                              CstNull
                            )
                          )
                        )
                      }
                    ]
                  )
                )
              )
            ]
          )
        )
      }
    )

  unity-plant-probe-seeds : Integer -> CstMember
