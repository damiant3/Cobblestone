Section: Hoe Planting

  pp-n : Text -> CstExpr
  pp-n (name) = CstName name []

  pp-d : CstExpr, Text -> CstExpr
  pp-d (target) (member) = CstMemberAccess target member []

  pp-call : CstExpr, List CstExpr -> CstExpr
  pp-call (f) (args) = CstCall f (list-map (\v -> CstArgument { ca-mode = [], ca-name = "", ca-value = v }) args)

  pp-var : Text, CstExpr -> CstStmt
  pp-var (name) (value) = CstVariables [] CstInferredType [CstVariable { cv-name = name, cv-value = Just value }]

  pp-check : CstExpr, Text -> CstStmt
  pp-check (cond) (message) = CstExpression (pp-call (pp-n "Check") [cond, CstString message])

  pp-item : Text -> CstExpr
  pp-item (name) = pp-d (CstCall (CstMemberAccess (pp-call (pp-d (pp-d (pp-n "ObjectDB") "instance") "GetItemPrefab") [CstString name]) "GetComponent" [CstNamedType "ItemDrop" []]) []) "m_itemData"

  pp-rows : CstExpr
  pp-rows = CstCast (CstNamedType "int" []) (pp-call (pp-d (pp-n "count") "Invoke") [pp-n "rows", CstArrayNew (CstNamedType "object" []) [] [pp-n "player"] True])

  pp-wield : CstExpr -> CstStmt
  pp-wield (item) = CstExpression (pp-call (pp-d (pp-call (pp-d (CstTypeOf (CstNamedType "Humanoid" [])) "GetField") [CstString "m_rightItem", pp-n "Flags"]) "SetValue") [pp-n "player", item])

  unity-plant-probe-hoe-checks : Integer -> CstMember
  unity-plant-probe-hoe-checks (unused) =
    let inventory = pp-call (pp-d (pp-n "player") "GetInventory") []
    in let hoe-pieces = pp-d (pp-d (pp-d (pp-n "hoeItem") "m_shared") "m_buildPieces") "m_pieces"
    in CstMethod CstMethodSpec {
      cm-attributes = [],
      cm-modifiers = [CstPrivate],
      cm-result = CstNamedType "void" [],
      cm-name = "HoeChecks",
      cm-type-params = [],
      cm-params = [],
      cm-body = Just (CstBlock [
        pp-var "hoeItem" (pp-item "Hoe"),
        pp-var "cultivatorItem" (pp-item "Cultivator"),
        pp-check (pp-call (pp-d (pp-d (pp-d (pp-d (pp-n "cultivatorItem") "m_shared") "m_buildPieces") "m_pieces") "All") [CstLambda [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "p", cp-default = None }] (pp-call (pp-d hoe-pieces "Contains") [pp-n "p"])]) "the hoe carries every cultivator piece, Cultivate and the seeds included",
        pp-var "count" (pp-call (pp-d (pp-n "RowsType") "GetMethod") [CstString "Count", pp-n "Flags"]),
        pp-var "cultivator" (pp-call (pp-d (pp-call (pp-d inventory "GetAllItems") []) "First") [CstLambda [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "i", cp-default = None }] (CstBinary CstEqual (pp-d (pp-d (pp-n "i") "m_shared") "m_buildPieces") (pp-d (pp-d (pp-n "cultivatorItem") "m_shared") "m_buildPieces"))]),
        pp-check (CstBinary CstEqual pp-rows (CstNumber "10" CstInt)) "control: the cultivator at Farming 100 plants ten",
        pp-var "hoe" (pp-call (pp-d (pp-n "hoeItem") "Clone") []),
        CstExpression (CstAssignment CstAssign (pp-d (pp-n "hoe") "m_stack") (CstNumber "1" CstInt)),
        pp-check (pp-call (pp-d inventory "AddItem") [pp-n "hoe"]) "hoe added",
        pp-wield (pp-n "hoe"),
        pp-check (CstBinary CstEqual pp-rows (CstNumber "1" CstInt)) "the hoe plants one at a time at Farming 100",
        pp-wield (pp-n "cultivator"),
        CstExpression (pp-call (pp-d inventory "RemoveItem") [pp-n "hoe"]),
        pp-check (CstBinary CstEqual pp-rows (CstNumber "10" CstInt)) "the cultivator plants rows again after the hoe"
      ])
    }
Section: Tool Kit

 With the tool kit the cultivator is the shovel and carries no seeds, so the
 probe grades the kit's tables, a planted bush and a clear instead of the
 cultivator's rows.

  pp-field : CstType, Text, Integer -> CstMember
  pp-field (ty) (name) (unused) = CstField [] [CstPrivate] ty [CstVariable { cv-name = name, cv-value = None }]

  unity-plant-probe-tool-fields : Integer -> CstMember
  unity-plant-probe-tool-fields (unused) = CstField [] [CstPrivate] (CstNamedType "UnityEngine.Vector3" []) [CstVariable { cv-name = "toolAt1", cv-value = None }, CstVariable { cv-name = "toolAt2", cv-value = None }, CstVariable { cv-name = "toolAt3", cv-value = None }, CstVariable { cv-name = "toolAt4", cv-value = None }]

  unity-plant-probe-tool-wait : Integer -> CstMember
  unity-plant-probe-tool-wait (unused) = pp-field (CstNamedType "int" []) "toolWait" 0

  unity-plant-probe-tool-chest : Integer -> CstMember
  unity-plant-probe-tool-chest (unused) = pp-field (CstNamedType "UnityEngine.GameObject" []) "toolChest" 0

  pp-lam : Text, CstExpr -> CstExpr
  pp-lam (name) (body) = CstLambda [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = name, cp-default = None }] body

  pp-named : Text -> CstExpr
  pp-named (name) = pp-lam "p" (CstBinary CstAnd (pp-n "p") (CstBinary CstEqual (pp-d (pp-n "p") "name") (CstString name)))

  pp-has : Text, Text -> CstExpr
  pp-has (list) (name) = pp-call (pp-d (pp-n list) "Exists") [pp-named name]

  pp-find : Text, Text -> CstExpr
  pp-find (list) (name) = pp-call (pp-d (pp-n list) "Find") [pp-named name]

  pp-and : CstExpr, CstExpr -> CstExpr
  pp-and (a) (b) = CstBinary CstAnd a b

  pp-str : CstExpr, CstExpr -> CstExpr
  pp-str (a) (b) = CstBinary CstAdd a b

  pp-at : Text, CstExpr -> CstExpr
  pp-at (prefab) (at) = pp-call (pp-d (pp-d (pp-n "UnityEngine") "Object") "Instantiate") [pp-call (pp-d (pp-d (pp-n "ZNetScene") "instance") "GetPrefab") [CstString prefab], at, pp-d (pp-d (pp-n "UnityEngine") "Quaternion") "identity"]

  pp-ground : Text -> CstStmt
  pp-ground (v) = CstExpression (CstAssignment CstAssign (pp-d (pp-n v) "y") (pp-call (pp-d (pp-d (pp-n "ZoneSystem") "instance") "GetGroundHeight") [pp-n v]))

  pp-census : Text, Text, List CstStmt -> CstStmt
  pp-census (at) (radius) (body) =
    CstForEach CstInferredType "c" (pp-call (pp-d (pp-n "UnityEngine.Physics") "OverlapSphere") [pp-n at, CstNumber radius CstFloat]) (CstBlock ([
      pp-var "nv" (CstCall (CstMemberAccess (pp-n "c") "GetComponentInParent" [CstNamedType "ZNetView" []]) []),
      CstIf (CstUnary CstNot (pp-n "nv")) CstContinue None,
      pp-var "name" (pp-call (pp-d (pp-n "Utils") "GetPrefabName") [pp-d (pp-n "nv") "gameObject"])
    ] & body))

  pp-bump : Text, CstExpr -> CstStmt
  pp-bump (counter) (cond) = CstIf cond (CstExpression (CstUnary CstPostIncrement (pp-n counter))) None

  unity-plant-probe-tool-stage : Integer -> CstMember
  unity-plant-probe-tool-stage (unused) =
    let shared = \item -> pp-d (pp-d (CstCall (CstMemberAccess (pp-call (pp-d (pp-d (pp-n "ObjectDB") "instance") "GetItemPrefab") [CstString item]) "GetComponent" [CstNamedType "ItemDrop" []]) []) "m_itemData") "m_shared"
    in let piece = \e -> CstCall (CstMemberAccess e "GetComponent" [CstNamedType "Piece" []]) []
    in let settings = \e -> pp-d (CstCall (CstMemberAccess e "GetComponent" [CstNamedType "TerrainOp" []]) []) "m_settings"
    in let inventory = pp-call (pp-d (pp-n "player") "GetInventory") []
    in let forward = pp-d (pp-d (pp-n "player") "transform") "forward"
    in let right = pp-d (pp-d (pp-n "player") "transform") "right"
    in let plants = pp-call (pp-d (pp-n "hoe") "FindAll") [pp-lam "p" (pp-and (pp-n "p") (CstCall (CstMemberAccess (pp-n "p") "GetComponent" [CstNamedType "Plant" []]) []))]
    in let first = pp-d (CstIndex (pp-d (piece (pp-n "berry")) "m_resources") [CstArgument { ca-mode = [], ca-name = "", ca-value = CstNumber "0" CstInt }])
    in CstMethod CstMethodSpec {
      cm-attributes = [],
      cm-modifiers = [CstPrivate],
      cm-result = CstNamedType "void" [],
      cm-name = "ToolStage",
      cm-type-params = [],
      cm-params = [],
      cm-body = Just (CstBlock [
        CstIf (CstBinary CstEqual (pp-n "stage") (CstNumber "30" CstInt)) (CstBlock [
          pp-var "shovelShared" (shared "Cultivator"),
          pp-var "shovel" (pp-d (pp-d (pp-n "shovelShared") "m_buildPieces") "m_pieces"),
          pp-var "hoe" (pp-d (pp-d (shared "Hoe") "m_buildPieces") "m_pieces"),
          pp-check (CstBinary CstEqual (pp-d (pp-n "shovelShared") "m_name") (CstString "Shovel")) "the cultivator is named Shovel",
          pp-check (pp-and (pp-and (pp-has "shovel" "mud_road_v2") (pp-has "shovel" "raise_v2")) (pp-and (pp-has "shovel" "path_v2") (pp-has "shovel" "paved_road_v2"))) "the shovel levels, raises and lays paths and stone",
          pp-check (pp-and (pp-has "shovel" "PrismShovelDig") (pp-has "shovel" "PrismShovelSmooth")) "the shovel digs and smooths",
          pp-check (pp-and (CstUnary CstNot (pp-has "shovel" "cultivate_v2")) (CstUnary CstNot (pp-call (pp-d (pp-n "shovel") "Exists") [pp-lam "p" (pp-and (pp-n "p") (CstCall (CstMemberAccess (pp-n "p") "GetComponent" [CstNamedType "Plant" []]) []))]))) "the shovel neither cultivates nor plants",
          pp-var "dig" (settings (pp-d (CstCall (CstMemberAccess (pp-find "shovel" "PrismShovelDig") "GetComponent" [CstNamedType "PrismShovelDigger" []]) []) "op")),
          CstExpression (pp-call (pp-n "Check") [pp-and (pp-d (pp-n "dig") "m_raise") (CstBinary CstLess (pp-call (pp-d (pp-n "UnityEngine.Mathf") "Abs") [CstBinary CstAdd (pp-d (pp-n "dig") "m_raiseDelta") (CstNumber "0.5" CstFloat)]) (CstNumber "0.001" CstFloat)), pp-str (CstString "dig lowers half of raise ground's 1 m step: ") (pp-d (pp-n "dig") "m_raiseDelta")]),
          pp-check (pp-and (pp-and (pp-has "hoe" "cultivate_v2") (pp-has "hoe" "replant_v2")) (pp-and (pp-has "hoe" "PrismHoeClear") (pp-has "hoe" "PrismHoeSmooth"))) "the hoe cultivates, replants, clears and smooths gently",
          pp-check (pp-and (CstUnary CstNot (pp-has "hoe" "raise_v2")) (CstUnary CstNot (pp-has "hoe" "mud_road_v2"))) "the hoe no longer raises or levels",
          CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-d plants "Count") (CstNumber "22" CstInt), pp-str (CstString "the hoe plants the 22 crops and saplings of the cultivator: ") (pp-d plants "Count")]),
          pp-var "gentle" (settings (pp-find "hoe" "PrismHoeSmooth")),
          CstExpression (pp-call (pp-n "Check") [pp-and (CstBinary CstLess (pp-d (pp-n "gentle") "m_smoothRadius") (CstNumber "3" CstFloat)) (CstUnary CstNot (pp-d (pp-n "gentle") "m_paintCleared")), pp-str (CstString "the hoe smooths a smaller patch than level ground and lays no dirt: radius ") (pp-d (pp-n "gentle") "m_smoothRadius")]),
          pp-var "bush" (pp-find "hoe" "PrismHoe_Bush01"),
          pp-var "berry" (pp-find "hoe" "PrismHoe_RaspberryBush"),
          pp-check (pp-and (pp-n "bush") (CstBinary CstEqual (pp-d (pp-d (piece (pp-n "bush")) "m_resources") "Length") (CstNumber "0" CstInt))) "a wild bush plants free",
          pp-check (pp-and (pp-and (pp-n "berry") (CstBinary CstEqual (pp-d (pp-d (piece (pp-n "berry")) "m_resources") "Length") (CstNumber "1" CstInt))) (pp-and (CstBinary CstEqual (pp-d (first "m_resItem") "name") (CstString "Raspberry")) (CstBinary CstEqual (first "m_amount") (CstNumber "1" CstInt)))) "a raspberry bush costs one raspberry",
          pp-var "ornaments" (pp-call (pp-d (pp-n "hoe") "FindAll") [pp-lam "p" (pp-and (pp-n "p") (pp-call (pp-d (pp-d (pp-n "p") "name") "StartsWith") [CstString "PrismHoe_"]))]),
          CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-d (pp-n "ornaments") "Count") (CstNumber "22" CstInt), pp-str (CstString "the hoe carries 22 ornamentals: ") (pp-d (pp-n "ornaments") "Count")]),
          CstIf (CstBinary CstNotEqual (pp-d (pp-n "UnityEngine.SystemInfo") "graphicsDeviceType") (pp-d (pp-n "UnityEngine.Rendering.GraphicsDeviceType") "Null")) (CstBlock [
            pp-var "iconDir" (pp-call (pp-d (pp-n "System.IO.Path") "GetDirectoryName") [pp-d (pp-n "UnityEngine.Application") "consoleLogPath"]),
            pp-var "replanted" (pp-call (pp-d (pp-n "ornaments") "FindAll") [pp-lam "p" (CstBinary CstEqual (pp-d (pp-d (piece (pp-n "p")) "m_icon") "name") (CstString "replant"))]),
            pp-var "blank" (pp-call (pp-d (pp-n "ornaments") "FindAll") [pp-lam "p" (CstBinary CstAnd (pp-d (pp-d (pp-d (piece (pp-n "p")) "m_icon") "texture") "isReadable") (CstUnary CstNot (pp-call (pp-d (pp-n "System.Linq.Enumerable") "Any") [pp-call (pp-d (pp-d (pp-d (piece (pp-n "p")) "m_icon") "texture") "GetPixels32") [], pp-lam "q" (CstBinary CstGreater (pp-d (pp-n "q") "a") (CstNumber "0" CstInt))])))]),
            CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-d (pp-n "blank") "Count") (CstNumber "0" CstInt), pp-str (CstString "every drawn hoe icon has opaque pixels; blank: ") (pp-d (pp-n "blank") "Count")]),
            CstForEach CstInferredType "o" (pp-n "ornaments") (CstBlock [
              pp-var "icon" (pp-d (piece (pp-n "o")) "m_icon"),
              CstIf (CstBinary CstAnd (pp-n "icon") (pp-d (pp-d (pp-n "icon") "texture") "isReadable")) (CstExpression (pp-call (pp-d (pp-n "System.IO.File") "WriteAllBytes") [pp-call (pp-d (pp-n "System.IO.Path") "Combine") [pp-n "iconDir", pp-str (pp-str (CstString "icon-") (pp-d (pp-n "o") "name")) (CstString ".png")], pp-call (pp-d (pp-n "UnityEngine.ImageConversion") "EncodeToPNG") [pp-d (pp-n "icon") "texture"]])) None
            ]),
            CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-d (pp-n "replanted") "Count") (CstNumber "0" CstInt), pp-str (CstString "every hoe planting has its own icon; still Replant: ") (pp-d (pp-n "replanted") "Count")])
          ]) None,
          pp-var "unfit" (pp-call (pp-d (pp-n "ornaments") "FindAll") [pp-lam "p" (CstBinary CstOr (CstUnary CstNot (pp-call (pp-d (CstCall (CstMemberAccess (pp-n "p") "GetComponents" [CstNamedType "UnityEngine.SphereCollider" []]) []) "Any") [pp-lam "c" (CstUnary CstNot (pp-d (pp-n "c") "isTrigger"))])) (CstBinary CstEqual (pp-d (pp-d (pp-d (CstCall (CstMemberAccess (pp-n "p") "GetComponent" [CstNamedType "Piece" []]) []) "m_placeEffect") "m_effectPrefabs") "Length") (CstNumber "0" CstInt)))]),
          CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-d (pp-n "unfit") "Count") (CstNumber "0" CstInt), pp-str (CstString "every ornamental carries a solid collider on its root and a placement effect; unfit: ") (pp-call (pp-d (pp-n "string") "Join") [CstString ",", pp-call (pp-d (pp-n "unfit") "Select") [pp-lam "p" (pp-d (pp-n "p") "name")]])]),
          pp-var "recipe" (pp-call (pp-d (pp-d (pp-d (pp-n "ObjectDB") "instance") "m_recipes") "Find") [pp-lam "r" (pp-and (pp-and (pp-n "r") (pp-d (pp-n "r") "m_item")) (CstBinary CstEqual (pp-d (pp-d (pp-n "r") "m_item") "name") (CstString "Cultivator")))]),
          pp-check (pp-and (pp-call (pp-d (pp-d (pp-n "recipe") "m_resources") "Any") [pp-lam "q" (CstBinary CstEqual (pp-d (pp-d (pp-n "q") "m_resItem") "name") (CstString "Copper"))]) (CstUnary CstNot (pp-call (pp-d (pp-d (pp-n "recipe") "m_resources") "Any") [pp-lam "q" (CstBinary CstEqual (pp-d (pp-d (pp-n "q") "m_resItem") "name") (CstString "Bronze"))]))) "the shovel takes copper, not bronze",          pp-var "count" (pp-call (pp-d (pp-n "RowsType") "GetMethod") [CstString "Count", pp-n "Flags"]),
          CstExpression (pp-call (pp-n "Farming") [CstNumber "100" CstFloat]),
          pp-var "hoeItem" (pp-call (pp-d (pp-item "Hoe") "Clone") []),
          CstExpression (CstAssignment CstAssign (pp-d (pp-n "hoeItem") "m_stack") (CstNumber "1" CstInt)),
          pp-var "shovelItem" (pp-call (pp-d (pp-item "Cultivator") "Clone") []),
          CstExpression (CstAssignment CstAssign (pp-d (pp-n "shovelItem") "m_stack") (CstNumber "1" CstInt)),
          pp-check (pp-and (pp-call (pp-d inventory "AddItem") [pp-n "hoeItem"]) (pp-call (pp-d inventory "AddItem") [pp-n "shovelItem"])) "hoe and shovel added",
          pp-wield (pp-n "shovelItem"),
          pp-check (CstBinary CstEqual pp-rows (CstNumber "1" CstInt)) "the shovel plants no rows",
          pp-wield (pp-n "hoeItem"),
          pp-check (CstBinary CstEqual pp-rows (CstNumber "10" CstInt)) "the hoe plants a row of ten at Farming 100",
          CstExpression (CstAssignment CstAssign (pp-n "toolAt1") (CstBinary CstAdd (pp-d (pp-d (pp-n "player") "transform") "position") (CstBinary CstMultiply forward (CstNumber "5" CstFloat)))),
          CstExpression (CstAssignment CstAssign (pp-n "toolAt2") (CstBinary CstAdd (pp-n "toolAt1") (CstBinary CstMultiply right (CstNumber "4" CstFloat)))),
          pp-ground "toolAt1",
          pp-ground "toolAt2",
          CstExpression (CstAssignment CstAssign (pp-n "toolAt3") (CstBinary CstSubtract (pp-n "toolAt1") (CstBinary CstMultiply right (CstNumber "4" CstFloat)))),
          CstExpression (CstAssignment CstAssign (pp-n "toolAt4") (CstBinary CstAdd (pp-n "toolAt1") (CstBinary CstMultiply forward (CstNumber "4" CstFloat)))),
          pp-ground "toolAt3",
          pp-ground "toolAt4",
          CstExpression (pp-call (pp-d (pp-d (pp-n "UnityEngine") "Object") "Instantiate") [pp-n "berry", pp-n "toolAt3", pp-d (pp-d (pp-n "UnityEngine") "Quaternion") "identity"]),
          CstExpression (pp-call (pp-d (pp-d (pp-n "UnityEngine") "Object") "Instantiate") [pp-find "hoe" "PrismHoe_vines_45", pp-n "toolAt4", pp-d (pp-d (pp-n "UnityEngine") "Quaternion") "identity"]),
          CstExpression (pp-call (pp-d (pp-d (pp-n "UnityEngine") "Object") "Instantiate") [pp-n "bush", pp-n "toolAt1", pp-d (pp-d (pp-n "UnityEngine") "Quaternion") "identity"]),
          CstExpression (pp-at "Bush01" (CstBinary CstAdd (pp-n "toolAt2") (CstBinary CstMultiply right (CstNumber "0.5" CstFloat)))),
          CstExpression (pp-at "Pickable_Dandelion" (CstBinary CstSubtract (pp-n "toolAt2") (CstBinary CstMultiply right (CstNumber "0.5" CstFloat)))),
          CstExpression (CstAssignment CstAssign (pp-n "toolChest") (pp-at "piece_chest_wood" (CstBinary CstAdd (pp-n "toolAt2") (CstBinary CstMultiply forward (CstNumber "0.8" CstFloat))))),
          CstExpression (CstAssignment CstAssign (pp-n "toolWait") (CstNumber "0" CstInt)),
          CstExpression (CstAssignment CstAssign (pp-n "stage") (CstNumber "31" CstInt)),
          CstReturn None
        ]) None,
        CstIf (CstBinary CstEqual (pp-n "stage") (CstNumber "31" CstInt)) (CstBlock [
          CstIf (CstBinary CstLess (CstUnary CstPreIncrement (pp-n "toolWait")) (CstNumber "5" CstInt)) (CstReturn None) None,
          CstExpression (pp-call (pp-d (pp-d (pp-n "UnityEngine") "Object") "Instantiate") [pp-call (pp-d (pp-d (pp-d (shared "Hoe") "m_buildPieces") "m_pieces") "Find") [pp-named "PrismHoeClear"], pp-n "toolAt2", pp-d (pp-d (pp-n "UnityEngine") "Quaternion") "identity"]),
          CstExpression (CstAssignment CstAssign (pp-n "toolWait") (CstNumber "0" CstInt)),
          CstExpression (CstAssignment CstAssign (pp-n "stage") (CstNumber "32" CstInt)),
          CstReturn None
        ]) None,        CstIf (CstBinary CstLess (CstUnary CstPreIncrement (pp-n "toolWait")) (CstNumber "10" CstInt)) (CstReturn None) None,
        pp-var "grown" (CstNumber "0" CstInt),
        pp-var "carrier" (CstNumber "0" CstInt),
        pp-census "toolAt1" "1" [
          pp-bump "grown" (CstBinary CstEqual (pp-n "name") (CstString "Bush01")),
          pp-bump "carrier" (CstBinary CstEqual (pp-n "name") (CstString "PrismHoe_Bush01"))
        ],
        CstExpression (pp-call (pp-n "Check") [pp-and (CstBinary CstGreaterEqual (pp-n "grown") (CstNumber "1" CstInt)) (CstBinary CstEqual (pp-n "carrier") (CstNumber "0" CstInt)), pp-str (pp-str (pp-str (CstString "a planted bush becomes the game's own bush: bush=") (pp-n "grown")) (CstString " carrier=")) (pp-n "carrier")]),
        pp-var "wild" (CstNumber "0" CstInt),
        pp-var "chest" (CstNumber "0" CstInt),
        pp-census "toolAt2" "1.4" [
          pp-bump "wild" (CstBinary CstOr (CstBinary CstEqual (pp-n "name") (CstString "Bush01")) (CstBinary CstEqual (pp-n "name") (CstString "Pickable_Dandelion"))),
          pp-bump "chest" (CstBinary CstEqual (pp-d (pp-n "nv") "gameObject") (pp-n "toolChest"))
        ],
        CstExpression (pp-call (pp-n "Check") [CstBinary CstEqual (pp-n "wild") (CstNumber "0" CstInt), pp-str (CstString "clear removes the wild bush and the dandelion: left=") (pp-n "wild")]),
        pp-check (pp-and (pp-n "toolChest") (CstBinary CstGreater (pp-n "chest") (CstNumber "0" CstInt))) "control: clear leaves a chest standing",
        pp-var "emptyBerry" (CstNumber "0" CstInt),
        pp-census "toolAt3" "1" [
          pp-bump "emptyBerry" (pp-and (CstBinary CstEqual (pp-n "name") (CstString "RaspberryBush")) (pp-call (pp-d (CstCall (CstMemberAccess (pp-d (pp-n "nv") "gameObject") "GetComponent" [CstNamedType "Pickable" []]) []) "GetPicked") []))
        ],
        pp-check (CstBinary CstGreater (pp-n "emptyBerry") (CstNumber "0" CstInt)) "a planted raspberry bush starts picked and regrows",
        pp-var "lean" (CstNumber "-1" CstFloat),
        pp-census "toolAt4" "1.5" [
          CstIf (CstBinary CstEqual (pp-n "name") (CstString "vines")) (CstExpression (CstAssignment CstAssign (pp-n "lean") (pp-call (pp-d (pp-n "UnityEngine.Vector3") "Angle") [pp-d (pp-d (pp-n "nv") "transform") "up", pp-d (pp-n "UnityEngine.Vector3") "up"]))) None
        ],
        CstExpression (pp-call (pp-n "Check") [CstBinary CstLess (pp-call (pp-d (pp-n "UnityEngine.Mathf") "Abs") [CstBinary CstSubtract (pp-n "lean") (CstNumber "45" CstFloat)]) (CstNumber "1" CstFloat), pp-str (CstString "a vine for a 45 degree roof leans 45 degrees: ") (pp-n "lean")]),        CstExpression (pp-call (pp-n "Pass") [])
      ])
    }

Section: Members

  unity-plant-probe-members : List (Integer -> CstMember)
  unity-plant-probe-members = [
    unity-plant-probe-flags,
    unity-plant-probe-stage,
    unity-plant-probe-deadline,
    unity-plant-probe-player,
    unity-plant-probe-saves,
    unity-plant-probe-carrot,
    unity-plant-probe-origin,
    unity-plant-probe-rows,
    unity-plant-probe-rows-type,
    unity-plant-probe-second,
    unity-plant-probe-row-before,
