  unity-plant-probe-plants : Integer -> CstMember
  unity-plant-probe-plants (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate, CstStatic],
        cm-result = (CstNamedType "int" []),
        cm-name = "Plants",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstReturn
                (Just
                  (CstCall
                    (CstMemberAccess
                      (CstCall
                        (CstMemberAccess
                          (CstMemberAccess (CstName "UnityEngine" []) "Object" [])
                          "FindObjectsByType"
                          [(CstNamedType "Plant" [])]
                        )
                        [
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstMemberAccess
                              (CstMemberAccess (CstName "UnityEngine" []) "FindObjectsSortMode" [])
                              "None"
                              []
                            )
                          }
                        ]
                      )
                      "Count"
                      []
