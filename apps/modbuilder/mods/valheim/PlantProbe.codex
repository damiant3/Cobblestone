                        )
                        []
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstAssignment CstAssign (CstMemberAccess (CstName "seeds" []) "m_stack" []) (CstName "n" []))
              ),
              (CstExpression
                (CstCall
                  (CstName "Check" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstCall
                        (CstMemberAccess
                          (CstCall (CstMemberAccess (CstName "player" []) "GetInventory" []) [])
                          "AddItem"
                          []
                        )
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "seeds" []) }]
