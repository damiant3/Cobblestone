Chapter: Storage Plan Test
  cites Valheim chapter LinkedStorage

Section: Cases

  storage-test-slot : Integer, Integer, Integer, Boolean -> StorageSlot
  storage-test-slot (i) (q) (cap) (same) = StorageSlot { ss-index = i, ss-quantity = q, ss-capacity = cap, ss-compatible = same }

  storage-test-total : List StorageMove, Integer, Integer -> Integer
  storage-test-total (moves) (i) (acc) =
   if i >= list-length moves then acc
   else storage-test-total moves (i + 1) (acc + (list-at moves i).sm-amount)

  storage-tests : Boolean =
   let slots = [storage-test-slot 0 0 50 True, storage-test-slot 1 48 50 True, storage-test-slot 2 8 50 False, storage-test-slot 3 49 50 True]
   in let a = storage-plan-deposit slots 60
   in let b = storage-plan-deposit slots 1
   in let c = storage-plan-withdraw slots 98
   in let d = storage-plan-withdraw slots 70
   in let stale = [storage-test-slot 0 0 50 True, storage-test-slot 1 47 50 True, storage-test-slot 2 8 50 False, storage-test-slot 3 49 50 True]
   in let invalid = storage-plan-deposit [storage-test-slot 0 51 50 True] 1
   in a.sp-valid & a.sp-remainder == 7
    & storage-test-total (a.sp-moves) 0 0 + a.sp-remainder == 60
    & (list-at (a.sp-moves) 0).sm-index == 1
    & (list-at (a.sp-moves) 1).sm-index == 3
    & (list-at (a.sp-moves) 2).sm-index == 0
    & list-length (a.sp-moves) == 3
    & b.sp-valid & b.sp-remainder == 0 & list-length (b.sp-moves) == 1
    & c.sp-valid == False & list-length (c.sp-moves) == 0
    & d.sp-valid & storage-test-total (d.sp-moves) 0 0 == 70
    & storage-plan-current d slots 0
    & storage-plan-current d stale 0 == False
    & (list-at slots 1).ss-quantity == 48
    & invalid.sp-valid == False

  opening : [Console] Nothing =
   if storage-tests then print-line-uni "linked storage plans PASS"
   else print-line-uni "linked storage plans FAIL"
