Chapter: Station Hover

Section: Clock

  hover-two : Integer -> Text
  hover-two (n) = if n < 10 then "0" & integer-to-text n else integer-to-text n

  hover-clock : Integer -> Text
  hover-clock (seconds) =
    let s = if seconds < 0 then 0 else seconds
    in let h = s / 3600
    in let m = (s - h * 3600) / 60
    in let r = s - h * 3600 - m * 60
    in if h > 0 then integer-to-text h & ":" & hover-two m & ":" & hover-two r
    else integer-to-text m & ":" & hover-two r

Section: Smelters

  smelter-runs : Integer, Integer, Integer, Integer -> Integer
  smelter-runs (queued) (fuel) (fuel-per) (max-fuel) =
    if max-fuel <= 0 then queued
    else if fuel-per <= 0 then queued
    else let fueled = (fuel + fuel-per - 1) / fuel-per
    in if fueled < queued then fueled else queued

  smelter-hover-line : Integer, Integer, Integer, Integer, Integer, Integer -> Text
  smelter-hover-line (queued) (sec-per) (elapsed) (fuel) (fuel-per) (max-fuel) =
    if queued <= 0 then ""
    else if sec-per <= 0 then ""
    else let runs = smelter-runs queued fuel fuel-per max-fuel
    in if runs <= 0 then "waiting for fuel"
    else let next = if elapsed >= sec-per then 0 else sec-per - elapsed
    in let total = next + (runs - 1) * sec-per
    in let line = "next in " & hover-clock next & ", " & integer-to-text runs & " done in " & hover-clock total
    in if runs < queued then line & ", then out of fuel" else line

Section: Fermenters

  fermenter-hover-line : Integer, Integer -> Text
  fermenter-hover-line (duration) (elapsed) =
    if duration <= 0 then ""
    else if elapsed >= duration then ""
    else "ready in " & hover-clock (duration - elapsed)

Section: Taming

  tame-hover-line : Integer, Integer -> Text
  tame-hover-line (remaining) (fed-left) =
    if remaining <= 0 then ""
    else if fed-left <= 0 then "hungry: feed it to keep taming, about " & hover-clock remaining & " left"
    else if fed-left >= remaining then "tame in about " & hover-clock remaining
    else "tame in about " & hover-clock remaining & ", feed again within " & hover-clock fed-left
