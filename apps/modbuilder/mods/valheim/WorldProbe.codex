  unity-world-probe-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstInternal, CstSealed], ch-name = "PrismWorldProbe", ch-bases = [(CstNamedType "UnityEngine.MonoBehaviour" [])] }) valheim-world-probe-members 0
