Chapter: ModBuilder
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 We say:

Section: Theme

  mba-palette : Palette
  mba-palette = Palette { pal-bg = #0C0B10, pal-fg = #EEE6D6, pal-primary = #D4A017, pal-secondary = #16141D, pal-accent = #E27B34, pal-muted = #A39CAE, pal-error = #FF7A5C, pal-success = #7FB77E, pal-warning = #E27B34, pal-border = #2E2A38 }

  mba-theme : Theme
  mba-theme =
    let bare = ss-flat (ws 0 0 bn ez (eu 0))
    in Theme { th-name = "modbuilder-app", th-palette = mba-palette, th-panel = bare, th-button = bare, th-label = bare, th-input = bare, th-gauge = bare, th-separator = bare }

Section: CSS

  mba-css-base : Text
  mba-css-base =
    "@import url('https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap');"
    & ":root{--ink:#0C0B10;--stone:#16141D;--stone2:#1D1A26;--line:#2E2A38;--gold:#D4A017;--gold-hi:#F2C94C;--ember:#E27B34;--parch:#EEE6D6;--ash:#A39CAE;--ok:#7FB77E;--err:#FF7A5C;--display:'IM Fell English SC','Palatino Linotype',Georgia,serif;--body:'Alegreya Sans','Segoe UI',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,Consolas,monospace;color-scheme:dark}"
    & "*{box-sizing:border-box;margin:0;padding:0}html,body{background:var(--ink);color:var(--parch);font:18px/1.55 var(--body)}body{overflow-x:hidden}#app{display:contents}.wk-label{display:contents}"
    & "h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1.05}.wrap{max-width:1120px;margin:0 auto;padding:0 16px}"
    & ".eyebrow{font-size:13px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}"

  mba-css-hero : Text
  mba-css-hero =
    ".hero{position:relative;min-height:440px;display:flex;align-items:flex-end;background:var(--stone) center/cover no-repeat;border-bottom:1px solid var(--line)}"
    & ".hero::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,11,16,.1) 0%,rgba(12,11,16,.35) 50%,rgba(12,11,16,.96) 100%)}"
    & ".hero .wrap{position:relative;z-index:1;padding-bottom:36px;width:100%}"
    & ".hero h1{font-size:clamp(48px,9vw,104px);text-shadow:0 3px 30px rgba(0,0,0,.85)}"
    & ".hero h1 em{font-style:normal;color:var(--gold-hi);text-shadow:0 0 28px rgba(242,201,76,.55),0 3px 30px rgba(0,0,0,.85)}"
    & ".hero p{font-size:clamp(17px,2vw,21px);color:#e2dacb;max-width:60ch;margin-top:12px;text-shadow:0 1px 12px rgba(0,0,0,.95)}"
    & ".steps{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px}.steps span{font-weight:700;text-shadow:0 1px 10px #000}"
    & ".steps b{font-family:var(--display);font-weight:400;color:var(--ember);font-size:26px;margin-right:8px}"

  mba-css-cards : Text
  mba-css-cards =
    ".game{padding:48px 0 12px}.game-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px}"
    & ".game-head h2{font-size:clamp(34px,5vw,52px)}.game-head .target{color:var(--ash);font-size:15px}"
    & ".count{font-family:var(--display);font-size:24px;color:var(--gold)}"
    & ".quick{display:flex;gap:10px}.quick button{background:transparent;border:1px solid var(--line);color:var(--ash);font:700 14px var(--body);padding:6px 12px;border-radius:999px;cursor:pointer}"
    & ".quick button:hover{color:var(--parch);border-color:var(--gold)}"
    & ".cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px}"
    & ".card{position:relative;border-radius:10px;overflow:hidden;cursor:pointer;background:var(--stone);border:2px solid var(--line);transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease,filter .18s ease;filter:saturate(.35) brightness(.72)}"
    & ".card:hover{transform:translateY(-4px) rotate(-.4deg);filter:saturate(.8) brightness(.9)}"
    & ".card.on{filter:none;border-color:var(--gold);box-shadow:0 0 0 1px rgba(242,201,76,.35),0 10px 40px -8px rgba(212,160,23,.55)}"
    & ".card.on:hover{transform:translateY(-6px) rotate(.4deg) scale(1.01)}"
    & ".card .art{aspect-ratio:16/11;background:var(--stone2) center/cover no-repeat}.card .txt{padding:14px 16px 18px}"
    & ".ftitle{font-family:var(--display);font-size:25px;display:block}.card.on .ftitle{color:var(--gold-hi)}"
    & ".fblurb{color:var(--ash);font-size:16px;display:block;margin-top:4px}"
    & ".rune{position:absolute;top:12px;right:12px;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font:800 20px var(--body);background:rgba(12,11,16,.75);border:2px solid var(--ash);color:transparent;transition:all .18s ease}"
    & ".card.on .rune{background:var(--gold);border-color:var(--gold-hi);color:#1a1405;box-shadow:0 0 18px rgba(242,201,76,.9)}"

  mba-css-forge : Text
  mba-css-forge =
    ".forge{position:relative;margin:44px 0 24px;border-radius:14px;overflow:hidden;border:1px solid var(--line);background:var(--stone) center/cover no-repeat}"
    & ".forge::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,11,16,.94) 0%,rgba(12,11,16,.78) 55%,rgba(12,11,16,.35) 100%)}"
    & ".forge .in{position:relative;padding:clamp(22px,4vw,40px)}.forge h2{font-size:clamp(34px,5vw,50px)}.chosen{color:var(--ash);margin-top:6px}"
    & ".big{position:relative;margin-top:22px;display:inline-flex;align-items:center;gap:12px;font:800 22px var(--body);letter-spacing:.02em;color:#1a1405;cursor:pointer;background:linear-gradient(180deg,var(--gold-hi),var(--gold) 60%,#a97d0c);border:0;border-radius:10px;padding:16px 30px;box-shadow:0 0 0 2px rgba(242,201,76,.35),0 12px 34px -6px rgba(226,123,52,.75);transition:transform .12s ease,box-shadow .12s ease}"
    & ".big:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 0 0 2px rgba(242,201,76,.6),0 16px 44px -6px rgba(226,123,52,.95)}.big:active{transform:translateY(1px) scale(.99)}"
    & ".big.busy{filter:saturate(.8);cursor:progress}.big .ham{font-size:28px;display:inline-block}.big.busy .ham{animation:hammer .5s ease-in-out infinite}"
    & "@keyframes hammer{0%,100%{transform:rotate(0deg)}50%{transform:rotate(-35deg)}}"
    & ".track{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}"
    & ".pip{display:flex;align-items:center;gap:10px;padding:8px 14px 8px 8px;border-radius:999px;background:rgba(12,11,16,.7);border:1px solid var(--line);color:var(--ash);font-weight:700}"
    & ".pip i{width:26px;height:26px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-style:normal;font-size:14px}"
    & ".pip.run{color:var(--parch);border-color:var(--ember)}.pip.run i{border-color:var(--ember);animation:pulse 1s ease-in-out infinite}"
    & ".pip.done{color:var(--parch);border-color:var(--ok)}.pip.done i{background:var(--ok);border-color:var(--ok);color:#0c1a0c}"
    & ".pip.fail{color:var(--err);border-color:var(--err)}.pip.fail i{border-color:var(--err);color:var(--err)}"
    & "@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(226,123,52,.8)}50%{box-shadow:0 0 0 8px rgba(226,123,52,0)}}"
    & ".status{display:block;margin-top:16px;font-size:18px;min-height:1.5em;color:var(--ash)}.status.ok{color:var(--ok)}.status.err{color:var(--err)}"
    & ".victory{display:none;margin-top:18px;padding:18px 20px;border-radius:10px;background:linear-gradient(90deg,rgba(127,183,126,.16),rgba(212,160,23,.12));border:1px solid rgba(127,183,126,.5)}"
    & ".victory.show{display:block;animation:rise .5s ease-out}.victory h3{font-size:30px;color:var(--gold-hi)}.victory p{margin-top:4px}"
    & "@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}"

  mba-css-sparks : Text
  mba-css-sparks =
    ".sparks{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none}"
    & ".sparks i{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--gold-hi);box-shadow:0 0 10px var(--ember);opacity:0}"
    & ".sparks i.f1{animation:f1 1.1s ease-out forwards}.sparks i.f2{animation:f2 1.1s ease-out forwards}.sparks i.f3{animation:f3 1.1s ease-out forwards}"
    & ".sparks i.f4{animation:f4 1.1s ease-out forwards}.sparks i.f5{animation:f5 1.1s ease-out forwards}.sparks i.f6{animation:f6 1.1s ease-out forwards}"
    & "@keyframes f1{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(-160px,-120px)}}"
    & "@keyframes f2{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(170px,-110px)}}"
    & "@keyframes f3{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(-40px,-190px)}}"
    & "@keyframes f4{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(60px,-170px)}}"
    & "@keyframes f5{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(-210px,-40px)}}"
    & "@keyframes f6{0%{opacity:1;transform:translate(0,0)}100%{opacity:0;transform:translate(220px,-50px)}}"

  mba-css-details : Text
  mba-css-details =
    "details.more{margin:8px 0 40px;border:1px solid var(--line);border-radius:10px;background:var(--stone)}"
    & "details.more summary{cursor:pointer;padding:14px 18px;font-weight:700;color:var(--ash);list-style:none}"
    & "details.more summary::before{content:'+ ';color:var(--gold)}details.more[open] summary::before{content:'- '}"
    & "details.more .body{padding:0 18px 18px}details.more h3{font-size:22px;color:var(--gold);margin:18px 0 8px}"
    & ".row{display:grid;grid-template-columns:240px 1fr;gap:10px;align-items:center;margin:5px 0;font-size:16px;color:var(--ash)}"
    & ".row input,.row select{width:100%;padding:7px 10px;background:var(--ink);color:var(--parch);border:1px solid var(--line);border-radius:6px;font:15px var(--mono)}"
    & ".acts{display:flex;gap:10px;align-items:center;margin-top:12px;flex-wrap:wrap}"
    & ".acts button,.toggle{background:transparent;color:var(--gold);border:1px solid var(--gold);padding:8px 14px;border-radius:6px;font:700 15px var(--body);cursor:pointer}"
    & ".acts button:hover,.toggle:hover{background:rgba(212,160,23,.12)}.acts button.off{opacity:.35;pointer-events:none}"
    & ".hint{color:var(--ash);font-size:15px;margin-top:6px}.hint b{color:var(--parch)}"
    & "pre.out{background:#0F0E14;border:1px solid var(--line);border-radius:6px;padding:12px;margin-top:12px;font:12px/1.6 var(--mono);color:#cfc7b8;max-height:320px;overflow:auto;white-space:pre-wrap;display:none}"
    & "footer{color:var(--ash);font-size:14px;padding:0 0 40px}"
    & "@media (max-width:640px){.row{grid-template-columns:1fr}.hero{min-height:360px}}"
    & "@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"

  mba-css : Text
  mba-css = mba-css-base & mba-css-hero & mba-css-cards & mba-css-forge & mba-css-sparks & mba-css-details

Section: Text Helpers

 The Unity target profile this page builds for, and the compiler's deck budget
 for the Unity IR mode.

  mba-profile-id : Text
  mba-profile-id = "windows-x64-mono-6000.0.75f1"

  mba-decks : Text
  mba-decks = "125"

  mba-bridge-default : Text
  mba-bridge-default = "http://127.0.0.1:8787"

  mba-esc : Text -> Text
  mba-esc (s) =
    let a = text-replace s "&" "&amp;"
    in let b = text-replace a "<" "&lt;"
    in let c = text-replace b ">" "&gt;"
    in let d = text-replace c "'" "&#39;"
    in text-replace d "\"" "&quot;"

  mba-tag : Text, Text, Text -> Text
  mba-tag (tag) (cls) (body) = "<" & tag & " class='" & cls & "'>" & body & "</" & tag & ">"

  mba-lower : Text -> Text
  mba-lower (s) = mba-lower-loop s 0 ""

  mba-lower-loop : Text, Integer, Text -> Text
  mba-lower-loop (s) (i) (acc) =
    if i >= text-length s then acc
    else let c = char-code-at s i
    in let ch = if c >= 65 & c <= 90 then substring "abcdefghijklmnopqrstuvwxyz" (c - 65) 1 else substring s i 1
    in mba-lower-loop s (i + 1) (acc & ch)

  mba-trim-slash : Text -> Text
  mba-trim-slash (s) =
    if text-length s == 0 then s
    else let c = char-code-at s (text-length s - 1)
    in if c == 47 | c == 92 then mba-trim-slash (substring s 0 (text-length s - 1)) else s

  mba-same-path : Text, Text -> Boolean
  mba-same-path (a) (b) = mba-lower (mba-trim-slash a) == mba-lower (mba-trim-slash b)

  mba-id-char : Integer -> Boolean
  mba-id-char (c) = (c >= 48 & c <= 57) | (c >= 65 & c <= 90) | (c >= 97 & c <= 122) | c == 46 | c == 95 | c == 45

  mba-id-ok-loop : Text, Integer -> Boolean
  mba-id-ok-loop (s) (i) =
    if i >= text-length s then True
    else if mba-id-char (char-code-at s i) then mba-id-ok-loop s (i + 1)
    else False

  mba-id-ok : Text -> Boolean
  mba-id-ok (s) =
    if text-length s < 1 | text-length s > 64 then False
    else let c = char-code-at s 0
    in if c == 46 | c == 95 | c == 45 then False else mba-id-ok-loop s 0

  mba-plain-loop : Text, Integer -> Boolean
  mba-plain-loop (s) (i) =
    if i >= text-length s then True
    else if char-code-at s i < 32 then False
    else mba-plain-loop s (i + 1)

  mba-plain : Text -> Boolean
  mba-plain (s) = text-length s <= 1024 & mba-plain-loop s 0

  mba-join-loop : List Text, Integer, Text, Text -> Text
  mba-join-loop (xs) (i) (sep) (acc) =
    if i >= list-length xs then acc
    else mba-join-loop xs (i + 1) sep (if i == 0 then list-at xs i else acc & sep & list-at xs i)

  mba-join : List Text, Text -> Text
  mba-join (xs) (sep) = mba-join-loop xs 0 sep ""

Section: The Catalogue

 `page-data "mods"` is the array build-page.ps1 writes from each game's
 features.json; `art-<id>` is a data URL per illustration.

  mba-game : Integer -> List Text
  mba-game (x) = json-parse-obj (json-obj-field (json-parse-obj (page-data "mods")) "0")

  mba-has-game : Integer -> Boolean
  mba-has-game (x) = json-valid (page-data "mods") & text-to-integer (json-obj-field (json-parse-obj (page-data "mods")) "length") > 0

  mba-field : Text -> Text
  mba-field (k) = json-obj-field (mba-game 0) k

  mba-features : Integer -> List Text
  mba-features (x) = json-parse-obj (mba-field "features")

  mba-feature-count : Integer -> Integer
  mba-feature-count (x) = text-to-integer (json-obj-field (mba-features 0) "length")

  mba-feature : Integer -> List Text
  mba-feature (i) = json-parse-obj (json-obj-field (mba-features 0) (show i))

  mba-ff : Integer, Text -> Text
  mba-ff (i) (k) = json-obj-field (mba-feature i) k

  mba-feature-index-loop : Text, Integer, Integer -> Integer
  mba-feature-index-loop (id) (i) (n) =
    if i >= n then 0 - 1
    else if mba-ff i "id" == id then i
    else mba-feature-index-loop id (i + 1) n

  mba-feature-index : Text -> Integer
  mba-feature-index (id) = mba-feature-index-loop id 0 (mba-feature-count 0)

  mba-art : Text -> Text
  mba-art (id) = page-data ("art-" & id)

  mba-bg : Text -> Text
  mba-bg (id) =
    let u = mba-art id
    in if text-length u == 0 then "" else " style='background-image:url(" & u & ")'"

Section: Selection


  mba-sel : Integer -> Text
  mba-sel (x) =
    let s = state-get-text "sel"
    in if text-length s == 0 then "," else s

  mba-sel-has : Text -> Boolean
  mba-sel-has (id) = text-contains (mba-sel 0) ("," & id & ",")

  mba-sel-ids-loop : Integer, Integer, List Text -> List Text
  mba-sel-ids-loop (i) (n) (acc) =
    if i >= n then acc
    else if mba-sel-has (mba-ff i "id") then mba-sel-ids-loop (i + 1) n (list-push acc (mba-ff i "id"))
    else mba-sel-ids-loop (i + 1) n acc

  mba-sel-ids : Integer -> List Text
  mba-sel-ids (x) = mba-sel-ids-loop 0 (mba-feature-count 0) []

  mba-sel-all-loop : Integer, Integer, Text -> Text
  mba-sel-all-loop (i) (n) (acc) = if i >= n then acc else mba-sel-all-loop (i + 1) n (acc & mba-ff i "id" & ",")

  mba-set-sel : Text -> Integer
  mba-set-sel (s) =
    let a = state-set-text "sel" s
    in let b = state-set-text "code" ""
    in let c = state-set-text "artifact" ""
    in mba-paint-selection 0

  mba-toggle : Text -> Integer
  mba-toggle (id) =
    if mba-sel-has id then mba-set-sel (text-replace (mba-sel 0) ("," & id & ",") ",")
    else mba-set-sel (mba-sel 0 & id & ",")

  mba-card-click : Text -> Integer
  mba-card-click (el-id) = mba-toggle (text-replace el-id "card-" "")

  mba-paint-card : Integer -> Integer
  mba-paint-card (i) =
    let el = dom-get ("card-" & mba-ff i "id")
    in let a = if mba-sel-has (mba-ff i "id") then dom-add-class el "on" else dom-remove-class el "on"
    in 0

  mba-paint-cards : Integer, Integer -> Integer
  mba-paint-cards (i) (n) = if i >= n then 0 else let p = mba-paint-card i in mba-paint-cards (i + 1) n

  mba-titles-loop : List Text, Integer, List Text -> List Text
  mba-titles-loop (ids) (i) (acc) =
    if i >= list-length ids then acc
    else mba-titles-loop ids (i + 1) (list-push acc (mba-ff (mba-feature-index (list-at ids i)) "title"))

  mba-paint-selection : Integer -> Integer
  mba-paint-selection (x) =
    let n = mba-feature-count 0
    in let p = mba-paint-cards 0 n
    in let ids = mba-sel-ids 0
    in let c = dom-set-text (dom-get "count") (show (list-length ids) & " of " & show n & " powers chosen")
    in let t = if list-length ids == 0 then "Choose at least one power above." else mba-join (mba-titles-loop ids 0 []) " + "
    in let d = dom-set-text (dom-get "build-game") t
    in let r = mba-reset-track 0
    in mba-single-state 0

Section: Markup

  mba-card : Integer -> Text
  mba-card (i) =
    let id = mba-esc (mba-ff i "id")
    in "<div class='card' id='card-" & id & "'><div class='art'" & mba-bg (mba-ff i "id") & "></div><span class='rune'>&#10003;</span><div class='txt'>" & mba-tag "span" "ftitle" (mba-esc (mba-ff i "title")) & mba-tag "span" "fblurb" (mba-esc (mba-ff i "blurb")) & "</div></div>"

  mba-cards-loop : Integer, Integer, Text -> Text
  mba-cards-loop (i) (n) (acc) = if i >= n then acc else mba-cards-loop (i + 1) n (acc & mba-card i)

  mba-hero : Text
  mba-hero =
    "<header class='hero' id='hero'" & mba-bg "hero" & "><div class='wrap'>" & mba-tag "div" "eyebrow" "ModBuilder" & "<h1>Forge your <em>mod</em>.</h1>"
    & "<p>Pick the powers you want. The mod is compiled from its Codex source right here in your browser, built against your own copy of the game, tested in a sealed copy, and dropped into your play copy. Your Steam game is never touched.</p>"
    & "<div class='steps'><span><b>I</b>Choose</span><span><b>II</b>Forge</span><span><b>III</b>Play</span></div></div></header>"

  mba-game-section : Integer -> Text
  mba-game-section (x) =
    if mba-has-game 0 == False then "<p class='hint'>No game mods are built into this page.</p>"
    else "<section class='game' id='game-" & mba-esc (mba-field "game") & "'><div class='game-head'><div>" & mba-tag "div" "eyebrow" "Choose your powers" & mba-tag "h2" "" (mba-esc (mba-field "title")) & "</div><div class='quick'><span class='count' id='count'></span><button id='q-all'>All</button><button id='q-none'>None</button></div></div><div class='cards'>" & mba-cards-loop 0 (mba-feature-count 0) "" & "</div></section>"

  mba-forge-panel : Text
  mba-forge-panel =
    "<section class='forge' id='forge'" & mba-bg "forge" & "><div class='in'>" & mba-tag "div" "eyebrow" "The forge" & "<h2>Strike the anvil</h2><div class='chosen' id='build-game'></div>"
    & "<button class='big' id='a-forge'><span class='ham'>&#9874;</span><span>Forge &amp; Install</span><span class='sparks' id='sparks'></span></button>"
    & "<div class='track'><div class='pip' id='pip-package'><i>1</i>Forge</div><div class='pip' id='pip-test'><i>2</i>Trial</div><div class='pip' id='pip-install'><i>3</i>Install</div></div>"
    & "<span class='status' id='status'></span><div class='victory' id='victory'><h3 id='victory-title'></h3><p id='victory-text'></p></div></div></section>"

  mba-row : Text, Text -> Text
  mba-row (id) (label) = "<div class='row'><label for='" & id & "'>" & label & "</label><input id='" & id & "'></div>"

  mba-details : Text
  mba-details =
    "<details class='more' id='more'><summary>Details: profile, bridge, single steps and receipts</summary><div class='body'><h3>Game profile</h3>"
    & "<div class='row'><label for='p-saved'>Saved profiles</label><select id='p-saved'></select></div>"
    & mba-row "p-id" "Profile name" & mba-row "p-gamePath" "Game directory" & mba-row "p-testSavePath" "Separate test save directory" & mba-row "p-installPath" "Play copy to install into"
    & mba-row "p-groupLimit" "Maximum linked chests per bench (1 to 4)"
    & "<div class='row'><label>Workbench links</label><span><button class='toggle' id='p-links'></button> explicit links only, within the game's chopping block range</span></div>"
    & "<div class='acts'><button id='p-save'>Save profile</button><button id='p-export'>Export profile</button><button id='p-import'>Import profile</button></div>"
    & "<h3>Local bridge</h3>" & mba-row "b-url" "Bridge address" & mba-row "b-token" "Bridge token"
    & "<div class='hint'>Start this page with <b>pwsh apps/modbuilder/run.ps1</b> and the bridge is connected for you; or run <b>apps/prism/build-bridge.ps1</b> and paste the token it prints. <span id='b-state'></span></div>"
    & "<h3>Single steps</h3><div class='acts'><button id='a-emit'>Emit C#</button><button id='a-inspect'>Inspect game</button><button id='a-build'>Build extension</button><button id='a-test' class='off'>Test extension</button><button id='a-install' class='off'>Install</button></div>"
    & "<pre class='out' id='out'></pre></div></details>"

  mba-footer : Text
  mba-footer = "<footer>Windows x64 Mono Unity games only; solo play only. Every build records a receipt of its inputs, and each install keeps the previous build and your saves for restore. Illustrations are AI-generated with Diffusion Forge.</footer>"

  mba-skeleton : Integer -> Text
  mba-skeleton (x) = mba-hero & "<main class='wrap'>" & mba-game-section 0 & mba-forge-panel & mba-details & mba-footer & "</main>"

Section: Status

  mba-say : Text, Text -> Integer
  mba-say (msg) (cls) =
    let el = dom-get "status"
    in let a = dom-remove-class el "ok"
    in let b = dom-remove-class el "err"
    in let c = if text-length cls > 0 then dom-add-class el cls else el
    in let d = dom-set-text el msg
    in 0

  mba-out : Text -> Integer
  mba-out (s) =
    let el = dom-get "out"
    in let a = dom-set-text el s
    in let b = dom-set-style el "display" (if text-length s > 0 then "block" else "none")
    in 0

  mba-pip : Text, Text -> Integer
  mba-pip (step) (cls) =
    let el = dom-get ("pip-" & step)
    in let a = dom-remove-class el "run"
    in let b = dom-remove-class el "done"
    in let c = dom-remove-class el "fail"
    in let d = if text-length cls > 0 then dom-add-class el cls else el
    in 0

  mba-reset-track : Integer -> Integer
  mba-reset-track (x) =
    let a = mba-pip "package" ""
    in let b = mba-pip "test" ""
    in let c = mba-pip "install" ""
    in let d = dom-remove-class (dom-get "victory") "show"
    in 0

  mba-single-state : Integer -> Integer
  mba-single-state (x) =
    let has = text-length (state-get-text "artifact") > 0
    in let a = if has then dom-remove-class (dom-get "a-test") "off" else dom-add-class (dom-get "a-test") "off"
    in let b = if has then dom-remove-class (dom-get "a-install") "off" else dom-add-class (dom-get "a-install") "off"
    in 0

Section: Profile

  mba-refusal : Text, Text, Text, Text, Text -> Text
  mba-refusal (id) (game) (tests) (install) (limit) =
    if mba-id-ok id == False then "Profile name must use letters, digits, dots, underscores or hyphens"
    else if (mba-plain game & mba-plain tests & mba-plain install) == False then "A profile path holds a control character or is too long"
    else if text-to-integer limit < 1 | text-to-integer limit > 4 then "Linked chests per bench must be 1 to 4"
    else if text-length game > 0 & text-length tests > 0 & mba-same-path game tests then "Test saves need a separate directory"
    else if text-length game > 0 & text-length install > 0 & mba-same-path game install then "Install into a separate play copy, never the original game"
    else ""

  mba-v : Text -> Text
  mba-v (id) = dom-get-value (dom-get id)

  mba-links : Integer -> Text
  mba-links (x) = if state-get "links" == 1 then "true" else "false"

  mba-form-refusal : Integer -> Text
  mba-form-refusal (x) = mba-refusal (mba-v "p-id") (mba-v "p-gamePath") (mba-v "p-testSavePath") (mba-v "p-installPath") (mba-v "p-groupLimit")

  mba-jf : Text, Text -> Text
  mba-jf (k) (v) = json-stringify k & ":" & json-stringify v

  mba-profile-json : Integer -> Text
  mba-profile-json (x) =
    let head = "{\"version\":1," & mba-jf "id" (mba-v "p-id") & ",\"kind\":\"unity\"," & mba-jf "profile" mba-profile-id
    in let paths = "," & mba-jf "gamePath" (mba-v "p-gamePath") & "," & mba-jf "testSavePath" (mba-v "p-testSavePath") & "," & mba-jf "installPath" (mba-v "p-installPath")
    in let tools = ",\"macToolchain\":\"\",\"minimumOS\":\"\""
    in head & paths & tools & ",\"groupLimit\":" & show (text-to-integer (mba-v "p-groupLimit")) & ",\"workbenchLinks\":" & mba-links 0 & "}"

  mba-set : Text, Text -> Integer
  mba-set (id) (v) =
    let a = dom-set-value (dom-get id) v
    in 0

  mba-paint-links : Integer -> Integer
  mba-paint-links (x) =
    let a = dom-set-text (dom-get "p-links") (if state-get "links" == 1 then "On" else "Off")
    in 0

  mba-show-profile : List Text -> Integer
  mba-show-profile (o) =
    let a = mba-set "p-id" (json-obj-field o "id")
    in let b = mba-set "p-gamePath" (json-obj-field o "gamePath")
    in let c = mba-set "p-testSavePath" (json-obj-field o "testSavePath")
    in let d = mba-set "p-installPath" (json-obj-field o "installPath")
    in let lim = json-obj-field o "groupLimit"
    in let h = mba-set "p-groupLimit" (if text-length lim == 0 then "4" else lim)
    in let i = state-set "links" (if json-obj-field o "workbenchLinks" == "false" then 0 else 1)
    in mba-paint-links 0

  mba-obj-refusal : List Text -> Text
  mba-obj-refusal (o) =
    if json-obj-field o "version" /= "1" | json-obj-field o "kind" /= "unity" then "Unknown target schema or family"
    else if json-obj-field o "profile" /= mba-profile-id then "Unsupported target version: " & json-obj-field o "profile"
    else let lim = json-obj-field o "groupLimit"
    in mba-refusal (json-obj-field o "id") (json-obj-field o "gamePath") (json-obj-field o "testSavePath") (json-obj-field o "installPath") (if text-length lim == 0 then "4" else lim)

  mba-saved : Integer -> List Text
  mba-saved (x) =
    let s = local-storage-get "modbuilder.targets"
    in if json-valid s then json-parse-obj s else json-parse-obj "[]"

  mba-saved-count : Integer -> Integer
  mba-saved-count (x) = text-to-integer (json-obj-field (mba-saved 0) "length")

  mba-saved-at : Integer -> Text
  mba-saved-at (i) = json-obj-field (mba-saved 0) (show i)

  mba-keep-loop : Text, Integer, Integer, List Text -> List Text
  mba-keep-loop (id) (i) (n) (acc) =
    if i >= n then acc
    else if json-obj-field (json-parse-obj (mba-saved-at i)) "id" == id then mba-keep-loop id (i + 1) n acc
    else mba-keep-loop id (i + 1) n (list-push acc (mba-saved-at i))

  mba-save-text : Text -> Integer
  mba-save-text (p) =
    let id = json-obj-field (json-parse-obj p) "id"
    in let kept = mba-keep-loop id 0 (mba-saved-count 0) []
    in let s = local-storage-set "modbuilder.targets" ("[" & mba-join (list-push kept p) "," & "]")
    in mba-paint-saved 0

  mba-options-loop : Integer, Integer, Text -> Text
  mba-options-loop (i) (n) (acc) =
    if i >= n then acc
    else let id = mba-esc (json-obj-field (json-parse-obj (mba-saved-at i)) "id")
    in mba-options-loop (i + 1) n (acc & "<option value='" & id & "'>" & id & "</option>")

  mba-paint-saved : Integer -> Integer
  mba-paint-saved (x) =
    let a = dom-set-html (dom-get "p-saved") ("<option value=''>Choose a profile</option>" & mba-options-loop 0 (mba-saved-count 0) "")
    in 0

  mba-pick-saved-loop : Text, Integer, Integer -> Integer
  mba-pick-saved-loop (id) (i) (n) =
    if i >= n then 0
    else let o = json-parse-obj (mba-saved-at i)
    in if json-obj-field o "id" == id then mba-show-profile o else mba-pick-saved-loop id (i + 1) n

  mba-saved-change : Text -> Integer
  mba-saved-change (id) = mba-pick-saved-loop id 0 (mba-saved-count 0)

  mba-default-profile : Integer -> Integer
  mba-default-profile (x) =
    if mba-saved-count 0 > 0 then mba-show-profile (json-parse-obj (mba-saved-at 0))
    else mba-show-profile (json-parse-obj "{\"id\":\"unity-local\",\"groupLimit\":4,\"workbenchLinks\":true}")

  mba-take-profile : Text -> Integer
  mba-take-profile (json) =
    if json-valid json == False then mba-say "That profile is not a JSON object" "err"
    else let o = json-parse-obj json
    in let why = mba-obj-refusal o
    in if text-length why > 0 then mba-say ("The profile was refused: " & why) "err"
    else let s = mba-save-text json
    in mba-show-profile o

Section: Bridge

  mba-bridge-url : Integer -> Text
  mba-bridge-url (x) =
    let u = local-storage-get "prism.bridge.url"
    in if text-length u == 0 then mba-bridge-default else u

  mba-token : Integer -> Text
  mba-token (x) = local-storage-get "prism.bridge.token"

  mba-headers : Integer -> Text
  mba-headers (x) = "{\"Content-Type\":\"application/json\"," & mba-jf "X-Bridge-Token" (mba-token 0) & "}"

  mba-health-cb : Text -> Integer
  mba-health-cb (r) =
    let o = if json-valid r then json-parse-obj r else json-parse-obj "{}"
    in let s = if json-obj-field o "ok" /= "true" then "not detected" else if json-obj-field o "tokenOk" == "true" then "connected, token accepted" else if json-obj-field o "tokenOk" == "false" then "reachable, but that token is wrong" else "reachable, no token given yet"
    in let a = dom-set-text (dom-get "b-state") ("Bridge: " & s & ".")
    in 0

  mba-probe : Integer -> Integer
  mba-probe (x) = fetch-with-then (mba-bridge-url 0 & "/health") "GET" (mba-headers 0) "" mba-health-cb

  mba-bridge-edit : Text -> Integer
  mba-bridge-edit (v) =
    let a = local-storage-set "prism.bridge.url" (mba-v "b-url")
    in let b = local-storage-set "prism.bridge.token" (mba-v "b-token")
    in mba-probe 0

  mba-features-json : Integer -> Text
  mba-features-json (x) = "[" & mba-join (mba-quote-loop (mba-sel-ids 0) 0 []) "," & "]"

  mba-quote-loop : List Text, Integer, List Text -> List Text
  mba-quote-loop (xs) (i) (acc) = if i >= list-length xs then acc else mba-quote-loop xs (i + 1) (list-push acc (json-stringify (list-at xs i)))

  mba-request : Text -> Text
  mba-request (op) =
    let head = "{" & mba-jf "operation" op & ",\"profile\":" & mba-profile-json 0
    in head & "," & mba-jf "code" (state-get-text "code") & "," & mba-jf "artifact" (state-get-text "artifact") & ",\"features\":" & mba-features-json 0 & "}"

  mba-send : Text -> Integer
  mba-send (op) = fetch-with-then (mba-bridge-url 0 & "/target") "POST" (mba-headers 0) (mba-request op) mba-target-done

Section: Emission

  mba-sources-loop : List Text, Integer, Text, List Text -> List Text
  mba-sources-loop (srcs) (i) (seen) (acc) =
    if i >= list-length srcs then acc
    else let name = list-at srcs i
    in if text-contains seen ("," & name & ",") then mba-sources-loop srcs (i + 1) seen acc
    else mba-sources-loop srcs (i + 1) (seen & name & ",") (list-push acc name)

  mba-feature-sources : Integer -> List Text
  mba-feature-sources (i) =
    let arr = json-parse-obj (mba-ff i "sources")
    in mba-array-loop arr 0 (text-to-integer (json-obj-field arr "length")) []

  mba-array-loop : List Text, Integer, Integer, List Text -> List Text
  mba-array-loop (arr) (i) (n) (acc) = if i >= n then acc else mba-array-loop arr (i + 1) n (list-push acc (json-obj-field arr (show i)))

  mba-all-sources-loop : List Text, Integer, List Text -> List Text
  mba-all-sources-loop (ids) (i) (acc) =
    if i >= list-length ids then acc
    else mba-all-sources-loop ids (i + 1) (acc & mba-feature-sources (mba-feature-index (list-at ids i)))

  mba-lines-loop : List Text, Integer, Text, List Text -> List Text
  mba-lines-loop (ids) (i) (k) (acc) =
    if i >= list-length ids then acc
    else mba-lines-loop ids (i + 1) k (list-push acc ("    " & mba-ff (mba-feature-index (list-at ids i)) k))

  mba-entry-file : List Text -> Text
  mba-entry-file (ids) =
    let head = "Chapter: " & mba-field "entryChapter" & "\n\nSection: Engine Entry\n\n  effect Process where\n"
    in head & mba-join (mba-lines-loop ids 0 "effect" []) "\n" & "\n\nSection: Entry\n\n  opening : [Process] Nothing = act\n" & mba-join (mba-lines-loop ids 0 "start" []) "\n" & "\n  end\n"

  mba-with-newline : Text -> Text
  mba-with-newline (t) = if text-length t == 0 then t else if substring t (text-length t - 1) 1 == "\n" then t else t & "\n"

  mba-unit-loop : List Text, Integer, List Text, Text -> Text
  mba-unit-loop (names) (i) (files) (acc) =
    if i >= list-length names then acc
    else mba-unit-loop names (i + 1) files (acc & mba-with-newline (json-obj-field files (list-at names i)))

  mba-unit : Integer -> Text
  mba-unit (x) =
    let ids = mba-sel-ids 0
    in let names = mba-sources-loop (mba-all-sources-loop ids 0 []) 0 "," []
    in mba-unit-loop names 0 (json-parse-obj (mba-field "files")) "" & mba-with-newline (mba-entry-file ids)

  mba-index-of : List Text, Text, Integer -> Integer
  mba-index-of (xs) (v) (i) = if i >= list-length xs then 0 - 1 else if list-at xs i == v then i else mba-index-of xs v (i + 1)

  mba-slice-loop : List Text, Integer, Integer, List Text -> List Text
  mba-slice-loop (xs) (i) (stop) (acc) = if i >= stop then acc else mba-slice-loop xs (i + 1) stop (list-push acc (list-at xs i))

  mba-refused-line : List Text, Integer -> Boolean
  mba-refused-line (xs) (i) =
    if i >= list-length xs then False
    else let l = list-at xs i
    in if text-starts-with l "REFUSED" | text-starts-with l "[UNSUPPORTED]" | text-starts-with l "!EXC" | text-starts-with l "OUT OF MEMORY" | text-starts-with l "!WASM" then True
    else mba-refused-line xs (i + 1)

  mba-compiled : Text -> Integer
  mba-compiled (out) =
    let lines = text-split out "\n"
    in let first = mba-index-of lines "IR-BEGIN" 0
    in let last = mba-index-of lines "IR-END" 0
    in if first < 0 | last <= first then mba-fail ("The compiler produced no IR: " & substring out 0 600)
    else let ir = mba-join (mba-slice-loop lines (first + 1) last []) "\n"
    in wasm-run-then "unity-stdio.wasm" ("UNITY " & mba-profile-id & "\n" & ir) mba-emitted

  mba-emitted : Text -> Integer
  mba-emitted (cs) =
    if mba-refused-line (text-split cs "\n") 0 then mba-fail ("The Unity plug refused: " & substring cs 0 600)
    else if text-contains cs "public static class PrismUnityEntry" == False then mba-fail "The Unity plug emitted no library entry"
    else let a = state-set-text "code" cs
    in mba-after-code 0

  mba-emit : Integer -> Integer
  mba-emit (x) =
    if text-length (state-get-text "code") > 0 then mba-after-code 0
    else let a = mba-say "Compiling the mod from its Codex source..." ""
    in wasm-run-then "codex-compiler.wasm" ("IR-UNI decks=" & mba-decks & "\n" & mba-unit 0) mba-compiled

Section: The Forge


  mba-busy : Integer -> Boolean
  mba-busy (x) = state-get "busy" == 1

  mba-start : Text -> Integer
  mba-start (job) =
    if mba-busy 0 then 0
    else if list-length (mba-sel-ids 0) == 0 then mba-say "Choose at least one power first." "err"
    else let why = mba-form-refusal 0
    in if text-length why > 0 then mba-say why "err"
    else let a = state-set "busy" 1
    in let b = state-set-text "job" job
    in let c = mba-reset-track 0
    in let d = mba-out ""
    in let e = dom-add-class (dom-get "a-forge") "busy"
    in let f = if job == "forge" | job == "build" then mba-step-run "package" else 0
    in mba-emit 0

  mba-step-run : Text -> Integer
  mba-step-run (step) =
    let a = state-set-text "pip" step
    in mba-pip step "run"

  mba-finish : Text, Text -> Integer
  mba-finish (msg) (cls) =
    let a = state-set "busy" 0
    in let b = dom-remove-class (dom-get "a-forge") "busy"
    in let c = mba-single-state 0
    in mba-say msg cls

  mba-fail : Text -> Integer
  mba-fail (msg) =
    let p = state-get-text "pip"
    in let a = if text-length p > 0 then mba-pip p "fail" else 0
    in let b = state-set-text "pip" ""
    in mba-finish msg "err"

  mba-after-code : Integer -> Integer
  mba-after-code (x) =
    let job = state-get-text "job"
    in if job == "emit" then let d = download-text (state-get-text "code") (mba-field "game" & "-mod.cs") "text/plain" in mba-finish "Unity C# downloaded." "ok"
    else if job == "forge" | job == "build" then let a = mba-say "Forging against your game..." "" in mba-send "package"
    else if job == "test" then let a = mba-say "Testing in a sealed copy..." "" in mba-send "test"
    else if job == "install" then let a = mba-say "Installing into your play copy..." "" in mba-send "install"
    else mba-finish "" ""

  mba-target-done : Text -> Integer
  mba-target-done (r) =
    let a = mba-out r
    in if json-valid r == False then mba-fail "The bridge answered something that is not JSON"
    else let o = json-parse-obj r
    in if json-obj-field o "ok" /= "true" then mba-fail (mba-why o)
    else mba-advance o

  mba-why : List Text -> Text
  mba-why (o) =
    let e = json-obj-field o "err"
    in if text-length e > 0 then e else let t = json-obj-field o "out" in if text-length t > 0 then substring t 0 600 else "The bridge refused the action"

  mba-advance : List Text -> Integer
  mba-advance (o) =
    let op = json-obj-field o "operation"
    in let job = state-get-text "job"
    in if op == "package" then mba-packaged o job
    else if op == "test" & job == "forge" then let a = mba-pip "test" "done" in let b = mba-step-run "install" in let c = mba-say "Installing into your play copy..." "" in mba-send "install"
    else if op == "test" then let a = mba-pip "test" "done" in mba-finish "The trial passed in a sealed copy." "ok"
    else if op == "install" then mba-installed o
    else mba-finish ("Done: " & op) "ok"

  mba-packaged : List Text, Text -> Integer
  mba-packaged (o) (job) =
    let a = state-set-text "artifact" (json-obj-field o "artifact")
    in let b = mba-pip "package" "done"
    in if job == "forge" then let c = mba-step-run "test" in let d = mba-say "Testing in a sealed copy..." "" in mba-send "test"
    else mba-finish ("Built " & json-obj-field o "buildNumber" & ".") "ok"

  mba-installed : List Text -> Integer
  mba-installed (o) =
    let a = mba-pip "install" "done"
    in let b = dom-set-text (dom-get "victory-title") ("Build " & json-obj-field o "buildNumber" & " is installed!")
    in let c = dom-set-text (dom-get "victory-text") ("Launch Valheim - Prism and look for the build number on the main menu. The previous build and your saves are kept in " & json-obj-field o "backup" & ".")
    in let d = dom-add-class (dom-get "victory") "show"
    in let e = mba-sparks 0
    in mba-finish "Forged, tested and installed." "ok"

  mba-spark : Integer -> Text
  mba-spark (i) = "<i class='f" & show (random-int 1 6) & "' style='left:" & show (random-int (0 - 90) 90) & "px;top:" & show (random-int (0 - 20) 20) & "px;animation-delay:" & show (random-int 0 250) & "ms'></i>"

  mba-sparks-loop : Integer, Text -> Text
  mba-sparks-loop (i) (acc) = if i >= 44 then acc else mba-sparks-loop (i + 1) (acc & mba-spark i)

  mba-sparks : Integer -> Integer
  mba-sparks (x) =
    let a = dom-set-html (dom-get "sparks") (mba-sparks-loop 0 "")
    in set-timeout (\t -> mba-clear-sparks t) 1600

  mba-clear-sparks : Integer -> Integer
  mba-clear-sparks (t) =
    let a = dom-set-html (dom-get "sparks") ""
    in 0

  mba-single : Text -> Integer
  mba-single (id) =
    if id == "a-forge" then mba-start "forge"
    else if id == "a-emit" then mba-start "emit"
    else if id == "a-build" then mba-start "build"
    else if id == "a-test" then (if text-length (state-get-text "artifact") == 0 then mba-say "Build the extension first." "err" else mba-start "test")
    else if id == "a-install" then (if text-length (state-get-text "artifact") == 0 then mba-say "Build the extension first." "err" else mba-start "install")
    else if id == "a-inspect" then mba-inspect 0
    else 0

  mba-inspect : Integer -> Integer
  mba-inspect (x) =
    let why = mba-form-refusal 0
    in if text-length why > 0 then mba-say why "err"
    else let a = state-set-text "job" "inspect"
    in fetch-with-then (mba-bridge-url 0 & "/target") "POST" (mba-headers 0) ("{" & mba-jf "operation" "inspect" & ",\"profile\":" & mba-profile-json 0 & "}") mba-target-done

Section: Handoff

 The launcher (run.ps1) opens the page at #bridge=<token>&profile=<url-encoded
 JSON>; a link #mod=<game>:<id>,<id> preselects features.

  mba-take-hash : Text -> Integer
  mba-take-hash (h) =
    if text-starts-with h "#bridge=" then mba-take-bridge (substring h 8 (text-length h - 8))
    else if text-starts-with h "#mod=" then mba-take-mod (substring h 5 (text-length h - 5))
    else 0

  mba-token-ok : Text -> Boolean
  mba-token-ok (t) = text-length t > 0 & mba-id-ok-loop t 0

  mba-take-bridge : Text -> Integer
  mba-take-bridge (rest) =
    let parts = text-split rest "&profile="
    in let tok = list-at parts 0
    in if mba-token-ok tok == False then mba-say "The launcher token was refused" "err"
    else let a = local-storage-set "prism.bridge.url" mba-bridge-default
    in let b = local-storage-set "prism.bridge.token" tok
    in let c = mba-set "b-url" mba-bridge-default
    in let d = mba-set "b-token" tok
    in let e = if list-length parts > 1 then mba-take-profile (uri-decode-component (list-at parts 1)) else 0
    in let f = location-clear-hash 0
    in mba-probe 0

  mba-known-loop : List Text, Integer -> Text
  mba-known-loop (ids) (i) =
    if i >= list-length ids then ""
    else if mba-feature-index (list-at ids i) < 0 then list-at ids i
    else mba-known-loop ids (i + 1)

  mba-take-mod : Text -> Integer
  mba-take-mod (rest) =
    let parts = text-split rest ":"
    in if list-length parts /= 2 | list-at parts 0 /= mba-field "game" then mba-say ("No mod catalogue for " & list-at parts 0) "err"
    else let ids = text-split (list-at parts 1) ","
    in let bad = mba-known-loop ids 0
    in if text-length bad > 0 then mba-say (mba-field "title" & " has no feature " & bad) "err"
    else mba-set-sel ("," & mba-join ids "," & ",")

Section: Entry

  mba-on : Text, (Text -> Integer) -> Integer
  mba-on (id) (cb) =
    let a = dom-on-click (dom-get id) cb
    in 0

  mba-wire-cards : Integer, Integer -> Integer
  mba-wire-cards (i) (n) = if i >= n then 0 else let a = mba-on ("card-" & mba-ff i "id") mba-card-click in mba-wire-cards (i + 1) n

  mba-links-click : Text -> Integer
  mba-links-click (id) =
    let a = state-set "links" (if state-get "links" == 1 then 0 else 1)
    in mba-paint-links 0

  mba-save-click : Text -> Integer
  mba-save-click (id) =
    let why = mba-form-refusal 0
    in if text-length why > 0 then mba-say why "err" else let a = mba-save-text (mba-profile-json 0) in mba-say "Profile saved." "ok"

  mba-export-click : Text -> Integer
  mba-export-click (id) =
    let why = mba-form-refusal 0
    in if text-length why > 0 then mba-say why "err" else download-text (mba-profile-json 0) (mba-v "p-id" & ".prism-target.json") "application/json"

  mba-import-click : Text -> Integer
  mba-import-click (id) = pick-file-text ".json" mba-take-profile

  mba-wire : Integer -> Integer
  mba-wire (x) =
    let a = mba-wire-cards 0 (mba-feature-count 0)
    in let b = mba-on "q-all" (\i -> mba-set-sel ("," & mba-sel-all-loop 0 (mba-feature-count 0) ""))
    in let c = mba-on "q-none" (\i -> mba-set-sel ",")
    in let d = mba-on "a-forge" mba-single
    in let e = mba-on "a-emit" mba-single
    in let f = mba-on "a-inspect" mba-single
    in let g = mba-on "a-build" mba-single
    in let h = mba-on "a-test" mba-single
    in let k = mba-on "a-install" mba-single
    in let l = mba-on "p-links" mba-links-click
    in let m = mba-on "p-save" mba-save-click
    in let n = mba-on "p-export" mba-export-click
    in let o = mba-on "p-import" mba-import-click
    in let p = dom-on-input (dom-get "p-saved") mba-saved-change
    in let q = dom-on-input (dom-get "b-url") mba-bridge-edit
    in let r = dom-on-input (dom-get "b-token") mba-bridge-edit
    in on-hash-change mba-take-hash

  mba-init : Integer -> Integer
  mba-init (x) =
    let a = state-set-text "sel" ("," & mba-sel-all-loop 0 (mba-feature-count 0) "")
    in let b = mba-paint-saved 0
    in let c = mba-default-profile 0
    in let d = mba-set "b-url" (mba-bridge-url 0)
    in let e = mba-set "b-token" (mba-token 0)
    in let f = mba-paint-selection 0
    in let g = mba-take-hash (location-hash 0)
    in mba-probe 0

  mba-tree : Integer -> WidgetNode
  mba-tree (x) = widget-box "root" "" [widget-label "" (mba-skeleton 0 & "<!--&-->")]

  opening : [Console] Integer
  opening = act
    let t = inject-app-style mba-theme mba-css
    in let m = mount-widget-themed mba-theme (mba-tree 0)
    in let w = if mba-has-game 0 then mba-wire 0 else 0
    in if mba-has-game 0 then mba-init 0 else 0
  end
