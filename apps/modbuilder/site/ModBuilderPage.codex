Chapter: ModBuilder Central
  cites Site chapter SiteTheme

 We say:

Section: Theme

  mb-palette : Palette
  mb-palette = Palette { pal-bg = #0C0B10, pal-fg = #EEE6D6, pal-primary = #D4A017, pal-secondary = #16141D, pal-accent = #E27B34, pal-muted = #A39CAE, pal-error = #E27B34, pal-success = #7FB77E, pal-warning = #E27B34, pal-border = #2E2A38 }

  mb-theme : Theme
  mb-theme =
    let bare = ss-flat (ws 0 0 bn ez (eu 0))
    in Theme { th-name = "modbuilder", th-palette = mb-palette, th-panel = bare, th-button = bare, th-label = bare, th-input = bare, th-gauge = bare, th-separator = bare }

Section: CSS

  mb-css-base : Text
  mb-css-base =
    "@import url('https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap');"
    & ":root{--ink:#0C0B10;--stone:#16141D;--stone2:#1D1A26;--line:#2E2A38;--gold:#D4A017;--gold-dim:#8F6D12;--ember:#E27B34;--moon:#86A8D8;--parch:#EEE6D6;--ash:#A39CAE;--ok:#7FB77E;--display:'IM Fell English SC','Iowan Old Style','Palatino Linotype',Georgia,serif;--body:'Alegreya Sans','Segoe UI',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,Consolas,monospace;color-scheme:dark}"
    & "html{background:var(--ink)}"
    & "html body{background:var(--ink);color:var(--parch);font-family:var(--body);font-size:18px;line-height:1.6;margin:0}"
    & "*,*::before,*::after{box-sizing:content-box}#app{display:contents}#app .wk-label{display:contents}"
    & "a{color:var(--gold)}"
    & "a:focus-visible,button:focus-visible{outline:2px solid var(--moon);outline-offset:3px}"
    & ".wrap{max-width:1120px;margin:0 auto;padding-inline:clamp(16px,4vw,40px)}"
    & "h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1.1;text-wrap:balance;margin:0}"
    & "h2{font-size:clamp(32px,4.4vw,48px);color:var(--parch)}"
    & "h3{font-size:24px;color:var(--gold)}"
    & "p{margin:0}"
    & ".eyebrow{font-family:var(--body);font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}"
    & ".lede{color:var(--ash);max-width:62ch}"

  mb-css-top : Text
  mb-css-top =
    ".draft{background:var(--stone2);border-bottom:1px solid var(--line);color:var(--ash);font-size:14px;text-align:center;padding-block:8px}"
    & ".draft b{color:var(--ember);font-weight:700}"
    & ".bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:18px}"
    & ".brand{display:flex;align-items:baseline;gap:10px;text-decoration:none}"
    & ".brand .mark{font-family:var(--display);font-size:24px;color:var(--gold)}"
    & ".brand .of{font-size:13px;color:var(--ash);letter-spacing:.08em}"
    & ".btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-weight:700;font-size:16px;text-decoration:none;border-radius:4px;padding:12px 20px;border:1px solid var(--gold);cursor:pointer}"
    & ".btn.solid{background:var(--gold);color:#1a1405}"
    & ".btn.solid:hover{background:#e6b52a}"
    & ".btn.ghost{background:transparent;color:var(--gold)}"
    & ".btn.ghost:hover{background:rgba(212,160,23,.1)}"
    & ".hero{position:relative;overflow:hidden;border-block:1px solid var(--line)}"
    & ".hero img{display:block;width:100%;height:clamp(420px,62vw,640px);object-fit:cover;object-position:center 40%}"
    & ".hero::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,11,16,.15) 0%,rgba(12,11,16,.35) 45%,rgba(12,11,16,.94) 100%)}"
    & ".hero .copy{position:absolute;left:0;right:0;bottom:0;z-index:1;padding-block:0 clamp(28px,5vw,56px)}"
    & ".hero h1{font-size:clamp(44px,8vw,92px);color:var(--parch);text-shadow:0 2px 30px rgba(0,0,0,.8)}"
    & ".hero h1 em{font-style:normal;color:var(--gold)}"
    & ".hero p.sub{font-size:clamp(17px,2vw,21px);color:#d8d0c2;max-width:58ch;margin-top:14px;text-shadow:0 1px 12px rgba(0,0,0,.9)}"
    & ".hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}"
    & ".proven{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border-bottom:1px solid var(--line)}"
    & ".proven div{background:var(--ink);padding:22px clamp(16px,3vw,28px)}"
    & ".proven .n{font-family:var(--display);font-size:34px;color:var(--gold);line-height:1}"
    & ".proven .t{color:var(--ash);font-size:15px;margin-top:6px}"

  mb-css-body : Text
  mb-css-body =
    ".sec{padding-block:clamp(56px,8vw,96px)}"
    & ".head{display:grid;gap:12px;margin-bottom:36px}"
    & ".steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}"
    & ".step figure{margin:0;aspect-ratio:1/1;overflow:hidden;border-radius:4px;border:1px solid var(--line)}"
    & ".step img{width:100%;height:100%;object-fit:cover;display:block}"
    & ".step .num{font-family:var(--display);color:var(--ember);font-size:20px;margin-top:16px}"
    & ".step h3{margin-top:2px}"
    & ".step p{color:var(--ash);margin-top:8px;font-size:17px}"
    & ".receipt-sec{background:var(--stone);border-block:1px solid var(--line)}"
    & ".receipt-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:40px;align-items:start}"
    & ".receipt-grid .notes{display:grid;gap:18px}"
    & ".note b{color:var(--parch)}"
    & ".note{color:var(--ash);font-size:17px}"
    & ".receipt{background:#0F0E14;border:1px solid var(--line);border-radius:4px;overflow-x:auto;position:relative}"
    & ".receipt .rh{display:flex;justify-content:space-between;gap:12px;font-family:var(--mono);font-size:12px;color:var(--ash);padding:12px 16px;border-bottom:1px dashed var(--line)}"
    & ".receipt .rh .okk{color:var(--ok)}"
    & ".receipt pre{margin:0;padding:16px;font-family:var(--mono);font-size:13px;line-height:1.75;color:#cfc7b8;white-space:pre}"
    & ".receipt .k{color:var(--moon)}"
    & ".receipt .h{color:var(--gold)}"
    & ".receipt .c{color:#6f687b}"
    & ".packs{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}"
    & ".packs figure{margin:0;border:1px solid var(--line);border-radius:4px;overflow:hidden}"
    & ".packs img{display:block;width:100%}"
    & ".packs .lede{margin-top:12px}"
    & ".packlist{display:grid;gap:10px;margin-top:20px}"
    & ".pack{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border:1px solid var(--line);border-radius:4px;background:var(--stone)}"
    & ".pack .nm{font-weight:700}"
    & ".chip{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:999px;white-space:nowrap;align-self:center}"
    & ".chip.ready{background:rgba(127,183,126,.14);color:var(--ok)}"
    & ".chip.vote{background:rgba(134,168,216,.14);color:var(--moon)}"
    & ".chip.study{background:rgba(226,123,52,.14);color:var(--ember)}"
    & ".later{margin-top:28px}"
    & ".suggest{padding:0;margin:10px 0 0;display:grid;gap:0;border-top:1px solid var(--line)}"
    & ".suggest .li{display:flex;justify-content:space-between;gap:12px;padding-block:10px;border-bottom:1px solid var(--line)}"
    & ".suggest .li b{font-weight:500;color:var(--parch)}"
    & ".suggest .li .yr{color:var(--ash);font-size:15px;white-space:nowrap}"
    & ".fine{color:var(--ash);font-size:14px;margin-top:10px}"

  mb-css-end : Text
  mb-css-end =
    ".ladder{display:grid;gap:0;border-left:2px solid var(--gold-dim);margin-left:8px}"
    & ".rung{position:relative;padding:0 0 30px 32px}"
    & ".rung::before{content:'';position:absolute;left:-9px;top:6px;width:16px;height:16px;border-radius:50%;background:var(--ink);border:2px solid var(--gold)}"
    & ".rung.base::before{background:var(--gold)}"
    & ".rung .amt{font-family:var(--display);font-size:34px;color:var(--parch);font-variant-numeric:tabular-nums}"
    & ".rung .lbl{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}"
    & ".rung p{color:var(--ash);max-width:60ch}"
    & ".fees{color:var(--ash);font-size:15px;margin-top:4px}"
    & ".tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}"
    & ".tier{border:1px solid var(--line);border-radius:4px;padding:22px;background:var(--stone);display:grid;gap:8px;align-content:start}"
    & ".tier .pr{font-family:var(--display);font-size:36px;color:var(--gold);line-height:1;font-variant-numeric:tabular-nums}"
    & ".tier .nm{font-weight:700;font-size:19px}"
    & ".tier p{color:var(--ash);font-size:16px}"
    & ".tier.founder{grid-row:span 2;background:linear-gradient(180deg,rgba(212,160,23,.08),var(--stone) 40%);border-color:var(--gold-dim)}"
    & ".tier.founder img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:3px;border:1px solid var(--line);margin-bottom:6px}"
    & ".limits{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 40px;margin-top:8px}"
    & ".limits .li{color:var(--ash)}"
    & ".limits .li b{color:var(--parch)}"
    & ".clean{padding:0;margin:0;display:grid;gap:14px}"
    & ".clean .li{padding-left:22px;position:relative}"
    & ".clean .li::before{content:'';position:absolute;left:0;top:.62em;width:10px;height:2px;background:var(--ember)}"
    & ".foot{border-top:1px solid var(--line);padding-block:36px;color:var(--ash);font-size:15px}"
    & ".foot .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px}"
    & "@media (max-width:860px){.proven,.steps,.tiers{grid-template-columns:1fr}.receipt-grid,.packs,.limits{grid-template-columns:1fr}.tier.founder{grid-row:auto}}"
    & "@media (prefers-reduced-motion:no-preference){.hero img{animation:drift 26s ease-in-out infinite alternate}@keyframes drift{from{transform:scale(1.02)}to{transform:scale(1.07) translateY(-1%)}}}"

  mb-css : Text
  mb-css = mb-css-base & mb-css-top & mb-css-body & mb-css-end

Section: Parts

  mb-raw : Text -> WidgetNode
  mb-raw (markup) = widget-label "" (markup & "<!--&-->")

  mb-box : Text, List WidgetNode -> WidgetNode
  mb-box (cls) (children) = widget-box "" cls children

  mb-link : Text, Text, Text -> WidgetNode
  mb-link (cls) (href) (label) =
    wk-attach (widget-custom "" ("link:" & cls & "|" & href) 0 0) [mb-raw label] 0 1

  mb-tag : Text, Text, Text -> Text
  mb-tag (tag) (cls) (body) =
    if cls == "" then "<" & tag & ">" & body & "</" & tag & ">"
    else "<" & tag & " class='" & cls & "'>" & body & "</" & tag & ">"

  mb-img : Text, Text -> Text
  mb-img (src) (alt) = "<img src='img/" & src & "' alt='Illustration: " & alt & "'>"

  mb-head : Text, Text, Text -> WidgetNode
  mb-head (eyebrow) (title) (lede) =
    mb-box "head" [mb-raw (mb-tag "div" "eyebrow" eyebrow), mb-raw (mb-tag "h2" "" title), mb-raw (mb-tag "p" "lede" lede)]

  mb-head-bare : Text, Text -> WidgetNode
  mb-head-bare (eyebrow) (title) =
    mb-box "head" [mb-raw (mb-tag "div" "eyebrow" eyebrow), mb-raw (mb-tag "h2" "" title)]

  mb-proven : Text, Text -> WidgetNode
  mb-proven (big) (small) =
    mb-box "" [mb-raw (mb-tag "div" "n" big), mb-raw (mb-tag "div" "t" small)]

  mb-step : Text, Text, Text, Text, Text -> WidgetNode
  mb-step (src) (alt) (num) (title) (body) =
    mb-box "step" [mb-raw (mb-tag "figure" "" (mb-img src alt)), mb-raw (mb-tag "div" "num" num), mb-raw (mb-tag "h3" "" title), mb-raw (mb-tag "p" "" body)]

  mb-note : Text -> WidgetNode
  mb-note (body) = mb-raw (mb-tag "p" "note" body)

  mb-pack : Text, Text, Text -> WidgetNode
  mb-pack (name) (chip) (label) =
    mb-box "pack" [mb-raw (mb-tag "span" "nm" name), mb-raw (mb-tag "span" ("chip " & chip) label)]

  mb-suggest : Text, Text -> WidgetNode
  mb-suggest (name) (years) =
    mb-box "li" [mb-raw (mb-tag "b" "" name), mb-raw (mb-tag "span" "yr" years)]

  mb-rung : Text, Text, Text, Text -> WidgetNode
  mb-rung (cls) (label) (amount) (body) =
    mb-box cls [mb-raw (mb-tag "div" "lbl" label), mb-raw (mb-tag "div" "amt" amount), mb-raw (mb-tag "p" "" body)]

  mb-tier : Text, Text, Text -> WidgetNode
  mb-tier (price) (name) (body) =
    mb-box "tier" [mb-raw (mb-tag "div" "pr" price), mb-raw (mb-tag "div" "nm" name), mb-raw (mb-tag "p" "" body)]

  mb-limit : Text, Text -> WidgetNode
  mb-limit (lead) (rest) = mb-box "li" [mb-raw (mb-tag "b" "" lead & " " & rest)]

  mb-spaces : Integer -> Text
  mb-spaces (n) = if n <= 0 then "" else " " & mb-spaces (n - 1)

  mb-rline : Text, Text, Text -> Text
  mb-rline (indent) (key) (value) =
    indent & mb-tag "span" "k" key & mb-spaces (15 - text-length indent - text-length key) & value & "\n"

  mb-hash : Text, Text -> Text
  mb-hash (first) (last) = mb-tag "span" "h" (first & "&hellip;" & last)

Section: Top

  mb-draft : WidgetNode
  mb-draft = mb-box "draft" [mb-raw "<b>Draft for review.</b> Campaign figures are proposals; the Kickstarter page is not live."]

  mb-bar : WidgetNode
  mb-bar =
    mb-box "wrap bar" [
      mb-raw "<a class='brand' href='https://cobblestoneproject.com' target='_blank' rel='noopener'><span class='mark'>ModBuilder Central</span><span class='of'>a Cobblestone project</span></a>",
      mb-link "btn ghost" "#campaign" "The campaign"
    ]

  mb-hero : WidgetNode
  mb-hero =
    mb-box "hero" [
      mb-raw (mb-img "hero.jpg" "a craftsman&#39;s workbench in a stone workshop at night, an open book lit by a small forge."),
      mb-box "copy" [
        mb-box "wrap" [
          mb-raw (mb-tag "div" "eyebrow" "Free for Valheim &middot; Kickstarter for the next game"),
          mb-raw "<h1>Mod the games<br><em>you own.</em></h1>",
          mb-raw (mb-tag "p" "sub" "Mods travel as signed source. Your own machine builds each one against your own copy of the game, and you decide whose word you trust. Nobody hands you a DLL."),
          mb-box "ctas" [
            mb-link "btn solid" "#free" "Try it now for Valheim!",
            mb-link "btn ghost" "#campaign" "Back the next game"
          ]
        ]
      ]
    ]

  mb-proven-strip : WidgetNode
  mb-proven-strip =
    mb-box "proven" [
      mb-proven "Free" "for Valheim: proven end to end in play, source to mod to game.",
      mb-proven "0 loaders" "No BepInEx, no Harmony, no Doorstop. Our own small bootstrap, pinned to your game&#39;s hashes.",
      mb-proven "Every build" "leaves a receipt: every input and the output, each by its hash."
    ]

Section: How It Works

  mb-how : WidgetNode
  mb-how =
    widget-box "how" "sec" [
      mb-box "wrap" [
        mb-head "How it works" "Three steps, and the middle one happens on your machine" "Today a mod site hands you a compiled file, and you trust the site, the uploader and every loader in between. ModBuilder moves the build to you.",
        mb-box "steps" [
          mb-step "source.jpg" "a small house rising from the pages of an open book." "1" "Get the source" "A mod is readable Codex source plus a short manifest, signed by its author. You can read every line before anything runs.",
          mb-step "receipts.jpg" "two identical crystals on a sealed scroll." "2" "Build it yourself" "ModBuilder compiles the source against the game files already on your disk. None of the game&#39;s code is ever copied or shipped. You get the mod and a receipt.",
          mb-step "trust.jpg" "a round stone table of linked glowing seals." "3" "Trust people, not a site" "Authors sign. Players and reviewers vouch. Your own policy decides what installs. Anyone can rebuild a mod and compare the receipts."
        ]
      ]
    ]

Section: Receipt

  mb-receipt-text : Text
  mb-receipt-text =
    mb-rline "" "game" "valheim"
    & mb-rline "" "engine" "unity 6000.0.75f1 &middot; mono &middot; windows x64"
    & mb-rline "" "feature" "arc"
    & mb-rline "  " "source" "CircumhorizontalArc.codex"
    & mb-rline "  " "sha256" (mb-hash "348007E61402CA8A" "DFE339D3")
    & mb-rline "" "gameAssembly" (mb-hash "59F53FB55D99D22A" "4033ADB1")
    & mb-rline "" "unityPlayer" (mb-hash "4D161E15D8CCDB32" "9AEA98F3")
    & mb-rline "" "sourceHash" (mb-hash "447C7A917A1EA3A5" "F18EA39F")
    & mb-rline "" "compilerHash" (mb-hash "F355CD6CBF807530" "2C97C175")
    & mb-rline "" "artifactHash" (mb-hash "39756DF83DC74F16" "D96BE9CC")
    & mb-tag "span" "c" "# 15 referenced assemblies, each by sha256," & "\n"
    & mb-tag "span" "c" "# read from your install, never redistributed"

  mb-receipt : WidgetNode
  mb-receipt =
    mb-box "sec receipt-sec" [
      mb-box "wrap receipt-grid" [
        mb-box "notes" [
          mb-raw (mb-tag "div" "eyebrow" "A real receipt"),
          mb-raw (mb-tag "h2" "" "What a build leaves behind"),
          mb-note "This is an excerpt of an actual receipt from <b>25 September 2026</b>: a one-feature Valheim mod (a sky arc) built from source and accepted in play. Local paths are removed.",
          mb-note "<b>Game hashes</b> pin the exact game build the mod was made for, so a game update never loads a stale mod.",
          mb-note "<b>Source, compiler and output hashes</b> let anyone rebuild the mod and compare the result against this receipt."
        ],
        mb-box "receipt" [
          mb-box "rh" [
            mb-raw (mb-tag "span" "" "receipt.json &middot; build 20260925.022424"),
            mb-raw (mb-tag "span" "okk" "ok")
          ],
          mb-raw (mb-tag "pre" "" mb-receipt-text)
        ]
      ]
    ]

Section: Game Packs

  mb-packs : WidgetNode
  mb-packs =
    widget-box "free" "sec" [
      mb-box "wrap packs" [
        mb-raw (mb-tag "figure" "" (mb-img "packs.jpg" "glowing wooden crates on stone shelves.")),
        mb-box "" [
          mb-raw (mb-tag "div" "eyebrow" "Game packs"),
          mb-raw (mb-tag "h2" "" "Valheim is free. The next game is yours to fund."),
          mb-raw (mb-tag "p" "lede" "Each supported game gets a pack: a small library that names the game&#39;s hooks for mod authors. Packs cover single-player Unity games that run on Mono. A feature built for one game is backported to the others wherever it fits, Valheim included."),
          mb-box "packlist" [
            mb-pack "Valheim" "ready" "free, working today",
            mb-pack "The next game" "vote" "funding goal",
            mb-pack "Two more packs" "vote" "stretch goal",
            mb-pack "IL2CPP games" "study" "feasibility study"
          ],
          mb-raw (mb-tag "p" "eyebrow later" "Suggested next games"),
          mb-box "suggest" [
            mb-suggest "Hollow Knight: Silksong" "2025 &middot; single-player",
            mb-suggest "RimWorld" "2018 &middot; single-player",
            mb-suggest "Risk of Rain 2" "2020 &middot; solo mode",
            mb-suggest "Subnautica / Below Zero" "2018 / 2021 &middot; single-player",
            mb-suggest "Dyson Sphere Program" "2021 &middot; single-player"
          ],
          mb-raw (mb-tag "p" "fine" "Suggestions, not commitments: each is a Unity game on Mono with a large mod scene. The campaign page names the one the funding goal pays for.")
        ]
      ]
    ]

Section: Campaign

  mb-campaign : WidgetNode
  mb-campaign =
    widget-box "campaign" "sec receipt-sec" [
      mb-box "wrap" [
        mb-head "The campaign" "What each goal pays for" "ModBuilder is free and working for Valheim before the campaign opens, so you can try the real thing first. Pledges pay for the next game.",
        mb-box "ladder" [
          mb-rung "rung base" "Funding goal" "&#36;30,000" "ModBuilder for the next game, named on the campaign page, then as many more games as the budget delivers. Each game that shares code with the last one costs less, so the count is found by building, not promised up front.",
          mb-rung "rung" "Stretch 1" "&#36;50,000" "More games, chosen by backer vote, as far as the money goes.",
          mb-rung "rung" "Stretch 2" "&#36;75,000" "Mac and Linux as host machines.",
          mb-rung "rung" "Stretch 3" "&#36;100,000" "A written study of IL2CPP games: what it would take, published whatever it finds. A study, not a promise."
        ],
        mb-raw (mb-tag "p" "fees" "Kickstarter and payment processing take roughly 8 to 10 per cent of every pledge; the goals above account for it.")
      ]
    ]

Section: Rewards

  mb-founder : WidgetNode
  mb-founder =
    mb-box "tier founder" [
      mb-raw (mb-img "seal.jpg" "a bronze seal stamp and molten amber wax on cobblestone."),
      mb-raw (mb-tag "div" "pr" "&#36;35"),
      mb-raw (mb-tag "div" "nm" "Founder"),
      mb-raw (mb-tag "p" "" "Early access, plus a founder key vouched into the trust web at launch. Mods you sign start with a known name behind them.")
    ]

  mb-rewards : WidgetNode
  mb-rewards =
    mb-box "sec" [
      mb-box "wrap" [
        mb-head "Rewards" "Every reward is digital" "No shipping, no warehouse, no delay waiting on a factory.",
        mb-box "tiers" [
          mb-tier "&#36;5" "Supporter" "Your name on the backers page.",
          mb-founder,
          mb-tier "&#36;15" "Early access" "The new game&#39;s pack before its public release.",
          mb-tier "&#36;75" "Game voter" "Everything in Founder, plus a vote on the stretch-goal game packs.",
          mb-tier "&#36;250" "Pack sponsor" "Your credit on a game pack of your choosing.",
          mb-tier "&#36;1,000" "Studio" "A working session with the team to plan a pack for your studio&#39;s own Mono game.",
          mb-tier "&#36;5,000" "Your game" "Every &#36;5,000 pledge gets a game worked on: the game you choose, as long as it is a single-player Unity game on Mono. You get whatever &#36;5,000 of work delivers for it."
        ]
      ]
    ]

Section: Limits

  mb-limits : WidgetNode
  mb-limits =
    mb-box "sec receipt-sec" [
      mb-box "wrap" [
        mb-head-bare "Straight answers" "What ModBuilder does not do",
        mb-box "clean limits" [
          mb-limit "Single-player only." "No online play, and no games with anti-cheat.",
          mb-limit "Mono Unity games first." "IL2CPP games are a study, not a feature.",
          mb-limit "No sandbox claim." "A signature proves who wrote a mod, not what it does. You read the source, or trust someone who did.",
          mb-limit "No game code shipped." "Everything builds against your own install; ModBuilder redistributes none of it."
        ]
      ]
    ]

  mb-footer : WidgetNode
  mb-footer =
    mb-box "foot" [
      mb-box "wrap row" [
        mb-raw "<span>ModBuilder Central is a <a href='https://cobblestoneproject.com' target='_blank' rel='noopener'>Cobblestone</a> project.</span>",
        mb-raw (mb-tag "span" "" "Illustrations on this page were generated locally with a Stable Diffusion model and are illustrations only.")
      ]
    ]

Section: Entry

  mb-page-tree : Integer -> WidgetNode
  mb-page-tree (x) =
    widget-box "root" "" [mb-draft, mb-bar, mb-hero, mb-proven-strip, mb-how, mb-receipt, mb-packs, mb-campaign, mb-rewards, mb-limits, mb-footer]

  mb-render : Integer -> Integer
  mb-render (x) = mount-widget-themed mb-theme (mb-page-tree 0)

  mb-click : Text -> Integer
  mb-click (id) = 0

  opening : [Console] Integer
  opening = act
    let t = inject-app-style mb-theme mb-css
    in let s = set-render mb-render
    in let h = register-handlers no-pick mb-click
    in mb-render 0
  end

