                              CstMultiply
                              (CstParenthesized
                                (CstBinary
                                  CstAdd
                                  (CstName "elevation" [])
                                  (CstBinary CstMultiply (CstParenthesized (CstBinary CstSubtract (CstName "v" []) (CstNumber "0.5" CstFloat))) (CstName "thickness" []))
                                )
