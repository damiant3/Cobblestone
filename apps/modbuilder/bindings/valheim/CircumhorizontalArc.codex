  unity-circumhorizontal-arc-install : Integer -> CstMember
  unity-circumhorizontal-arc-install (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstInternal, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "Install",
        cm-type-params = [],
        cm-params = [CstParameter { cp-modifiers = [], cp-type = (CstNamedType "ArcPreviewSettings" []), cp-name = "preview", cp-default = None }],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstName "instance" []) (CstReturn None) None),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstEqual (CstMemberAccess (CstName "preview" []) "aps_spectrum" []) CstNull)
                  (CstBinary CstLess (CstMemberAccess (CstMemberAccess (CstName "preview" []) "aps_spectrum" []) "Count" []) (CstNumber "2" CstInt))
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Arc preview needs a spectrum") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstLess (CstMemberAccess (CstName "preview" []) "aps_period_days" []) (CstNumber "1" CstInt))
                  (CstBinary CstEqual (CstMemberAccess (CstName "preview" []) "aps_weathers" []) CstNull)
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Arc preview needs a day period and a weather list") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "host",
                    cv-value = (Just
                      (CstObjectNew (CstNamedType "UnityEngine.GameObject" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Prism Circumhorizontal Arc") }] [])
                    )
                  }
                ]
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "DontDestroyOnLoad" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "host" []) }]
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "instance" [])
                  (CstCall (CstMemberAccess (CstName "host" []) "AddComponent" [(CstNamedType "PrismCircumhorizontalArc" [])]) [])
                )
              ),
              (CstExpression (CstAssignment CstAssign (CstMemberAccess (CstName "instance" []) "settings" []) (CstName "preview" []))),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "instance" []) "weathers" [])
                  (CstCall
                    (CstMemberAccess
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "preview" []) "aps_weathers" []) "Select" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "_Cce" []) "ToUnicode" []) }]
                      )
                      "ToList"
                      []
                    )
                    []
                  )
                )
              )
            ]
          )
        )
      }
    )

  unity-circumhorizontal-arc-spectrum : Integer -> CstMember
  unity-circumhorizontal-arc-spectrum (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "UnityEngine.Color" []),
        cm-name = "Spectrum",
        cm-type-params = [],
        cm-params = [CstParameter { cp-modifiers = [], cp-type = (CstNamedType "float" []), cp-name = "position", cp-default = None }],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables [] CstInferredType [CstVariable { cv-name = "palette", cv-value = (Just (CstMemberAccess (CstName "settings" []) "aps_spectrum" [])) }]),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "scaled",
                    cv-value = (Just
                      (CstBinary
                        CstMultiply
                        (CstCall
                          (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Clamp01" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "position" []) }]
                        )
                        (CstParenthesized (CstBinary CstSubtract (CstMemberAccess (CstName "palette" []) "Count" []) (CstNumber "1" CstInt)))
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "index",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstName "Math" []) "Min" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCast (CstNamedType "int" []) (CstName "scaled" [])) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstSubtract (CstMemberAccess (CstName "palette" []) "Count" []) (CstNumber "2" CstInt)) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "a",
                    cv-value = (Just (CstIndex (CstName "palette" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "index" []) }]))
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "b",
                    cv-value = (Just
                      (CstIndex (CstName "palette" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstAdd (CstName "index" []) (CstNumber "1" CstInt)) }])
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "left",
                    cv-value = (Just
                      (CstObjectNew
                        (CstNamedType "UnityEngine.Color" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "a" []) "ac_red" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "a" []) "ac_green" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "a" []) "ac_blue" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) }
                        ]
                        []
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "right",
                    cv-value = (Just
                      (CstObjectNew
                        (CstNamedType "UnityEngine.Color" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "b" []) "ac_red" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "b" []) "ac_green" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstMemberAccess (CstName "b" []) "ac_blue" []) (CstNumber "1000" CstFloat)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) }
                        ]
                        []
                      )
                    )
                  }
                ]
              ),
              (CstReturn
                (Just
                  (CstCall
                    (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Color" []) "Lerp" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "left" []) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "right" []) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstSubtract (CstName "scaled" []) (CstName "index" [])) }
                    ]
                  )
                )
              )
            ]
          )
        )
      }
    )

  unity-circumhorizontal-arc-build-mesh : Integer -> CstMember
  unity-circumhorizontal-arc-build-mesh (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "UnityEngine.Mesh" []),
        cm-name = "BuildMesh",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "vertices",
                    cv-value = (Just
                      (CstArrayNew
                        (CstNamedType "UnityEngine.Vector3" [])
                        [
                          (CstBinary
                            CstMultiply
                            (CstParenthesized (CstBinary CstAdd (CstName "Columns" []) (CstNumber "1" CstInt)))
                            (CstParenthesized (CstBinary CstAdd (CstName "Rows" []) (CstNumber "1" CstInt)))
                          )
                        ]
                        []
                        False
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "colours",
                    cv-value = (Just (CstArrayNew (CstNamedType "UnityEngine.Color" []) [(CstMemberAccess (CstName "vertices" []) "Length" [])] [] False))
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "uv",
                    cv-value = (Just (CstArrayNew (CstNamedType "UnityEngine.Vector2" []) [(CstMemberAccess (CstName "vertices" []) "Length" [])] [] False))
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "triangles",
                    cv-value = (Just
                      (CstArrayNew
                        (CstNamedType "int" [])
                        [(CstBinary CstMultiply (CstBinary CstMultiply (CstName "Columns" []) (CstName "Rows" [])) (CstNumber "6" CstInt))]
                        []
                        False
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "elevation",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Clamp" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCast (CstNamedType "float" []) (CstMemberAccess (CstName "settings" []) "aps_elevation_degrees" [])) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "2" CstFloat) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "60" CstFloat) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "span",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Clamp" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCast (CstNamedType "float" []) (CstMemberAccess (CstName "settings" []) "aps_span_degrees" [])) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "20" CstFloat) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "100" CstFloat) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "thickness",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Clamp" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCast (CstNamedType "float" []) (CstMemberAccess (CstName "settings" []) "aps_band_degrees" [])) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "2" CstFloat) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "20" CstFloat) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "halfWidth",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Tan" [])
                        [
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstBinary
                              CstMultiply
                              (CstBinary CstMultiply (CstName "span" []) (CstNumber "0.5" CstFloat))
                              (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Deg2Rad" [])
                            )
                          }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstFor
                (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "y", cv-value = (Just (CstNumber "0" CstInt)) }])
                (Just (CstBinary CstLessEqual (CstName "y" []) (CstName "Rows" [])))
                [(CstUnary CstPostIncrement (CstName "y" []))]
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [CstVariable { cv-name = "v", cv-value = (Just (CstBinary CstDivide (CstCast (CstNamedType "float" []) (CstName "y" [])) (CstName "Rows" []))) }]
                    ),
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "altitude",
                          cv-value = (Just
