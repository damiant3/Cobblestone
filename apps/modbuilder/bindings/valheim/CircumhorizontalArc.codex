                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) },
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstBinary
                                    CstMultiply
                                    (CstCall
                                      (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Min" [])
                                      [
                                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "v" []) },
                                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstSubtract (CstNumber "1" CstFloat) (CstName "v" [])) }
                                      ]
                                    )
                                    (CstNumber "8" CstFloat)
                                  )
                                }
                              ]
                            )
                          )
                        }
                      ]
                    ),
                    (CstFor
                      (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "x", cv-value = (Just (CstNumber "0" CstInt)) }])
                      (Just (CstBinary CstLessEqual (CstName "x" []) (CstName "Columns" [])))
                      [(CstUnary CstPostIncrement (CstName "x" []))]
                      (CstBlock
                        [
                          (CstVariables
                            []
                            CstInferredType
                            [CstVariable { cv-name = "u", cv-value = (Just (CstBinary CstDivide (CstCast (CstNamedType "float" []) (CstName "x" [])) (CstName "Columns" []))) }]
                          ),
                          (CstVariables
                            []
                            CstInferredType
                            [
                              CstVariable {
                                cv-name = "index",
                                cv-value = (Just
                                  (CstBinary
                                    CstAdd
                                    (CstBinary CstMultiply (CstName "y" []) (CstParenthesized (CstBinary CstAdd (CstName "Columns" []) (CstNumber "1" CstInt))))
                                    (CstName "x" [])
                                  )
                                )
                              }
                            ]
                          ),
                          (CstExpression
                            (CstAssignment
                              CstAssign
                              (CstIndex (CstName "vertices" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "index" []) }])
                              (CstObjectNew
                                (CstNamedType "UnityEngine.Vector3" [])
                                [
                                  CstArgument {
                                    ca-mode = [],
                                    ca-name = "",
                                    ca-value = (CstBinary
                                      CstMultiply
                                      (CstBinary CstMultiply (CstParenthesized (CstBinary CstSubtract (CstName "u" []) (CstNumber "0.5" CstFloat))) (CstNumber "2" CstFloat))
