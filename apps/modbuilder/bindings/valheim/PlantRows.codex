  unity-plant-rows-emit : [Console] Nothing
  unity-plant-rows-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstInternal, CstSealed], ch-name = "PrismPlantRows", ch-bases = [(CstNamedType "UnityEngine.MonoBehaviour" [])] }) unity-plant-rows-members 0

  unity-plant-rows-effect : Integer -> CstMember
  unity-plant-rows-effect (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPublic, CstStatic],
        cm-result = (CstNamedType "Func" [(CstNamedType "Func" [(CstNamedType "long" []), (CstNamedType "long" [])]), (CstNamedType "object" [])]),
        cm-name = "unity_plant_rows_start",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Func" [(CstNamedType "long" []), (CstNamedType "long" [])]), cp-name = "length", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstReturn
                (Just
                  (CstLambdaBlock
                    [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "spacing", cp-default = None }]
                    (CstBlock
                      [
                        (CstExpression
                          (CstCall
                            (CstMemberAccess (CstName "PrismPlantRows" []) "Install" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "length" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "spacing" []) }]
                          )
                        ),
                        (CstReturn (Just CstNull))
                      ]
                    )
                  )
                )
              )
            ]
          )
        )
      }
    )
