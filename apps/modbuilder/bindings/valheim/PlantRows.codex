                      (CstBlock [CstBreak])
                      None
                    ),
                    (CstVariables
                      []
                      (CstNamedType "float" [])
                      [
                        CstVariable {
                          cv-name = "stamina",
                          cv-value = (Just
                            (CstCast
                              (CstNamedType "float" [])
                              (CstCall
                                (CstMemberAccess (CstName "BuildStamina" []) "Invoke" [])
                                [
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull }
                                ]
                              )
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstUnary
                        CstNot
                        (CstCall
                          (CstMemberAccess (CstName "player" []) "HaveStamina" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "stamina" []) }]
                        )
                      )
                      (CstBlock [CstBreak])
                      None
                    ),
                    (CstIf
                      (CstBinary
                        CstAnd
                        (CstBinary
                          CstAnd
                          (CstBinary CstNotEqual (CstName "tool" []) CstNull)
                          (CstMemberAccess (CstMemberAccess (CstName "tool" []) "m_shared" []) "m_useDurability" [])
                        )
                        (CstBinary
                          CstLessEqual
                          (CstMemberAccess (CstName "tool" []) "m_durability" [])
                          (CstNumber "0" CstFloat)
                        )
                      )
                      (CstBlock [CstBreak])
                      None
                    ),
                    (CstIf
                      (CstUnary CstNot (CstName "free" []))
                      (CstBlock
                        [
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstName "player" []) "ConsumeResources" [])
                              [
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstMemberAccess (CstName "piece" []) "m_resources" [])
                                },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstInt) },
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstUnary CstNegate (CstNumber "1" CstInt))
                                },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstInt) }
                              ]
                            )
                          )
                        ]
                      )
                      None
                    ),
                    (CstExpression (CstAssignment CstAssign (CstName "placing" []) (CstBoolean True))),
                    (CstTry
                      (CstBlock
                        [
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstName "player" []) "PlacePiece" [])
                              [
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "piece" []) },
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstIndex
                                    (CstName "targets" [])
                                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "k" []) }]
                                  )
                                },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "rotation" []) },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBoolean False) },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBoolean False) }
                              ]
                            )
                          )
                        ]
                      )
                      []
                      (Just
                        (CstBlock [(CstExpression (CstAssignment CstAssign (CstName "placing" []) (CstBoolean False)))])
                      )
                    ),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstName "player" []) "UseStamina" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "stamina" []) }]
                      )
                    ),
                    (CstIf
                      (CstBinary
                        CstNotEqual
                        (CstName "skill" [])
                        (CstMemberAccess (CstMemberAccess (CstName "Skills" []) "SkillType" []) "None" [])
                      )
                      (CstBlock
                        [
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstName "player" []) "RaiseSkill" [])
                              [
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "skill" []) },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) }
                              ]
                            )
                          )
                        ]
                      )
                      None
                    ),
                    (CstIf
                      (CstBinary
                        CstAnd
                        (CstBinary CstNotEqual (CstName "tool" []) CstNull)
                        (CstMemberAccess (CstMemberAccess (CstName "tool" []) "m_shared" []) "m_useDurability" [])
                      )
                      (CstBlock
                        [
                          (CstExpression
                            (CstAssignment
                              CstSubtractAssign
                              (CstMemberAccess (CstName "tool" []) "m_durability" [])
                              (CstCast
                                (CstNamedType "float" [])
                                (CstCall
                                  (CstMemberAccess (CstName "PlaceDurability" []) "Invoke" [])
                                  [
                                    CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                                    CstArgument {
                                      ca-mode = [],
                                      ca-name = "",
                                      ca-value = (CstArrayNew (CstNamedType "object" []) [] [(CstName "tool" [])] True)
                                    }
                                  ]
                                )
                              )
                            )
                          )
                        ]
                      )
                      None
                    ),
                    (CstExpression (CstUnary CstPostIncrement (CstName "placed" [])))
                  ]
                )
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Debug" []) "Log" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstBinary CstAdd (CstString "PRISM PLANT ROW placed ") (CstName "placed" []))
                    }
                  ]
                )
              )
            ]
          )
        )
      }
    )

Section: Hoe Planting

 Rows belong to the planting tool: the cultivator, unless the tool kit names
 the hoe. Without the tool kit the hoe carries every piece of the cultivator's
 table and plants one at a time.

  pr-n : Text -> CstExpr
  pr-n (name) = CstName name []

  pr-d : CstExpr, Text -> CstExpr
  pr-d (target) (member) = CstMemberAccess target member []

  pr-call : CstExpr, List CstExpr -> CstExpr
  pr-call (f) (args) = CstCall f (list-map (\v -> CstArgument { ca-mode = [], ca-name = "", ca-value = v }) args)

  pr-var : Text, CstExpr -> CstStmt
  pr-var (name) (value) = CstVariables [] CstInferredType [CstVariable { cv-name = name, cv-value = Just value }]

  pr-table : Text -> CstExpr
  pr-table (item) = pr-d (pr-d (pr-d (CstCall (CstMemberAccess (pr-n item) "GetComponent" [CstNamedType "ItemDrop" []]) []) "m_itemData") "m_shared") "m_buildPieces"

  unity-plant-rows-grafted : Integer -> CstMember
  unity-plant-rows-grafted (unused) = CstField [] [CstPrivate, CstStatic] (CstNamedType "ObjectDB" []) [CstVariable { cv-name = "grafted", cv-value = None }]

  unity-plant-rows-planting-tool : Integer -> CstMember
  unity-plant-rows-planting-tool (unused) = CstField [] [CstInternal, CstStatic] (CstNamedType "string" []) [CstVariable { cv-name = "plantingTool", cv-value = Just (CstString "Cultivator") }]

  unity-plant-rows-graft-flag : Integer -> CstMember
  unity-plant-rows-graft-flag (unused) = CstField [] [CstInternal, CstStatic] (CstNamedType "bool" []) [CstVariable { cv-name = "graftHoe", cv-value = Just (CstBoolean True) }]

  unity-plant-rows-cultivating : Integer -> CstMember
  unity-plant-rows-cultivating (unused) =
    let item = pr-n "item"
    in CstMethod CstMethodSpec {
      cm-attributes = [],
      cm-modifiers = [CstPrivate, CstStatic],
      cm-result = CstNamedType "bool" [],
      cm-name = "Cultivating",
      cm-type-params = [],
      cm-params = [CstParameter { cp-modifiers = [], cp-type = CstNamedType "Player" [], cp-name = "player", cp-default = None }],
      cm-body = Just (CstBlock [
        pr-var "item" (CstAs (pr-call (pr-d (pr-n "RightItem") "Invoke") [pr-n "player", CstNull]) (CstNamedType "ItemDrop.ItemData" [])),
        CstIf (CstBinary CstOr (CstBinary CstEqual item CstNull) (CstUnary CstNot (pr-d (pr-n "ObjectDB") "instance"))) (CstReturn (Just (CstBoolean False))) None,
        pr-var "cultivator" (pr-call (pr-d (pr-d (pr-n "ObjectDB") "instance") "GetItemPrefab") [pr-n "plantingTool"]),
        CstReturn (Just (CstBinary CstAnd (pr-n "cultivator") (CstBinary CstEqual (pr-d (pr-d item "m_shared") "m_buildPieces") (pr-table "cultivator"))))
      ])
    }

  unity-plant-rows-graft-hoe : Integer -> CstMember
  unity-plant-rows-graft-hoe (unused) =
    let db = pr-n "db"
    in let hoe-pieces = pr-d (pr-n "hoeTable") "m_pieces"
    in let p = pr-n "p"
    in CstMethod CstMethodSpec {
      cm-attributes = [],
      cm-modifiers = [CstPrivate, CstStatic],
      cm-result = CstNamedType "void" [],
      cm-name = "GraftHoe",
      cm-type-params = [],
      cm-params = [],
      cm-body = Just (CstBlock [
        pr-var "db" (pr-d (pr-n "ObjectDB") "instance"),
        CstIf (CstBinary CstOr (CstBinary CstOr (CstUnary CstNot (pr-n "graftHoe")) (CstUnary CstNot db)) (CstBinary CstEqual (pr-n "grafted") db)) (CstReturn None) None,
        pr-var "hoe" (pr-call (pr-d db "GetItemPrefab") [CstString "Hoe"]),
        pr-var "cultivator" (pr-call (pr-d db "GetItemPrefab") [CstString "Cultivator"]),
        CstIf (CstBinary CstOr (CstUnary CstNot (pr-n "hoe")) (CstUnary CstNot (pr-n "cultivator"))) (CstReturn None) None,
        pr-var "hoeTable" (pr-table "hoe"),
        pr-var "cultivatorTable" (pr-table "cultivator"),
        CstIf (CstBinary CstOr (CstUnary CstNot (pr-n "hoeTable")) (CstUnary CstNot (pr-n "cultivatorTable"))) (CstReturn None) None,
        CstForEach CstInferredType "p" (pr-d (pr-n "cultivatorTable") "m_pieces") (CstIf (CstBinary CstAnd p (CstUnary CstNot (pr-call (pr-d hoe-pieces "Contains") [p]))) (CstExpression (pr-call (pr-d hoe-pieces "Add") [p])) None),
        CstExpression (CstAssignment CstAssign (pr-n "grafted") db)
      ])
    }

