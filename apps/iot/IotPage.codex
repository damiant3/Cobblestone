Chapter: IotPage
  cites Site chapter SiteTheme

 We say:

Section: CSS

  iot-extra-css : Text
  iot-extra-css =
    ".iot{max-width:1100px;margin:0 auto;padding:0 24px}"

Section: Tree

  iot-nav : WidgetNode
  iot-nav = site-nav [widget-label "nl0" "Hardware", widget-label "nl1" "Protocols", widget-label "nl2" "Security", widget-label "nl3" "HAL", widget-label "nl4" "Home"]

  iot-hero : WidgetNode
  iot-hero = site-hero "No OS &#x2022; No Runtime &#x2022; No Attack Surface" "BARE METAL IoT" "Codex runs on microcontrollers with no OS, no runtime, no attack surface. Memory-safe by construction. <em>Shipping to STM32, ESP32, and Raspberry Pi.</em>&shy;" [site-stat "s0" "3" "Target Platforms", site-stat "s1" "4" "Protocol Stacks", site-stat "s2" "0" "OS Depen&shy;dencies", site-stat "s3" "0" "CVE Surface"]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      iot-nav,
      iot-hero,
      widget-box "body" "iot" [
        hardware-section 0,
        protocol-section 0,
        security-section 0,
        hal-section 0,
        site-footer [
          widget-label "fl0" "Home",
          widget-label "fl1" "GitHub",
          widget-label "fl2" "Documentation",
          widget-label "fl3" "Hardware Guide"
        ]
      ]
    ]

Section: Hardware

  hardware-section : Integer -> WidgetNode
  hardware-section (x) =
    site-section "hw" "TARGET HARDWARE" "Runs Where It Matters" "From hard realtime cortex-M to Linux-capable application processors &mdash; one language, every target." [
      site-card-grid-3 "hw-grid" [
        site-card "h0" "&#x1F4A0;" "STM32F4" "ARM Cortex-M4 at 168 MHz. Ultra-hard realtime. FPU, DMA, 192 KB SRAM. Industrial sensors, motor control, medical devices.",
        site-card "h1" "&#x1F4E1;" "ESP32-C6" "RISC-V core at 160 MHz. Thread and Matter mesh networking built in. WiFi 6, BLE 5.3, Zigbee. Smart home and industrial IoT.",
        site-card "h2" "&#x1F4BB;" "Raspberry Pi 4/5" "Cortex-A72, up to 8 GB RAM. Linux interop for gateway and edge compute. Camera, display, GPIO &mdash; full board support."
      ]
    ]

Section: Protocol Stack

  protocol-section : Integer -> WidgetNode
  protocol-section (x) =
    site-section "proto" "PROTOCOL STACK" "Every Wire, Every Mesh" "Pub/sub telemetry, constrained REST, device management, and smart home mesh &mdash; all type-safe." [
      site-card-grid-4 "proto-grid" [
        site-card "p0" "&#x1F4E8;" "MQTT v5" "Pub/sub telemetry with QoS levels, shared subscriptions, and topic aliases. Lightweight enough for Cortex-M.",
        site-card "p1" "&#x1F310;" "CoAP" "RFC 7252 constrained RESTful protocol. Observe, block transfer, DTLS security. Built for lossy networks.",
        site-card "p2" "&#x1F4F2;" "LwM2M v1.2" "OMA device management and OTA firmware updates. Bootstrap, registration, reporting &mdash; all over CoAP.",
        site-card "p3" "&#x1F3E0;" "Matter / Thread" "Smart home mesh over 802.15.4. IPv6 native, border router support, multi-admin fabric. Interop by design."
      ]
    ]

Section: Security

  sec-visual : WidgetNode
  sec-visual = site-bullet-list "sec-list" [widget-label "sl0" "Signed CDX binaries &mdash; Ed25519 signatures over SHA-256 content hashes", widget-label "sl1" "Capability manifests &mdash; explicit effect surface, no ambient authority", widget-label "sl2" "Linear resource types &mdash; GPIO, UART, SPI, I2C used exactly once then returned", widget-label "sl3" "No OS means no syscalls, no privilege escalation, no kernel exploits", widget-label "sl4" "OTA updates with dual-gate verification and anti-rollback fuse counters"]

  sec-info : WidgetNode
  sec-info = site-showcase-info "sec-info" "Security by Subtraction" "Traditional embedded stacks bolt security onto an OS that was never designed for it. Codex removes the OS entirely. The compiler enforces memory safety, the type system enforces resource discipline, and the binary is signed end-to-end. The attack surface is the hardware and nothing else." [site-tag "st0" "Ed25519", site-tag "st1" "SHA-256", site-tag "st2" "Linear Types", site-tag "st3" "No Heap Exploits", site-tag "st4" "Anti-Rollback"]

  security-section : Integer -> WidgetNode
  security-section (x) =
    site-section "sec" "SECURITY" "No OS Means No OS Attack Surface" "Every layer is ours. Every byte is accounted for. Every effect is in the type system." [
      site-showcase "sec-show" sec-visual sec-info
    ]

Section: HAL

  hal-code : WidgetNode
  hal-code = site-code-block "hb1" "GpioDriver.codex" "<span class='kw'>Chapter:</span> <span class='ty'>GpioDriver</span>\n  <span class='kw'>cites</span> HAL <span class='kw'>chapter</span> <span class='ty'>Board</span>\n\n <span class='cm'>GPIO with linear ownership.</span>\n\n<span class='kw'>Section:</span> <span class='ty'>Pins</span>\n\n  <span class='fn'>blink</span> : <span class='ty'>Pin</span> -o <span class='ty'>Pin</span>\n  <span class='fn'>blink</span> (pin) =\n    <span class='kw'>let</span> p1 = <span class='fn'>pin-high</span> pin\n    <span class='kw'>in let</span> p2 = <span class='fn'>delay-ms</span> <span class='st'>500</span> p1\n    <span class='kw'>in let</span> p3 = <span class='fn'>pin-low</span> p2\n    <span class='kw'>in</span> <span class='fn'>delay-ms</span> <span class='st'>500</span> p3&shy;"

  hal-info : WidgetNode
  hal-info = site-showcase-info "hi1" "Linear Hardware Resources" "A GPIO pin is a linear value &mdash; it must be used exactly once, then returned. You cannot forget to release a pin. You cannot use a pin after giving it away. The type system enforces this at compile time, not at runtime." [site-tag "hi1a" "Pin, UART, SPI, I2C &mdash; all linear resources", site-tag "hi1b" "Effect types track every hardware access", site-tag "hi1c" "Board definitions: Nrf9160Board, Fe310Board, Nrf52840Board", site-tag "hi1d2" "Zero-cost abstractions &mdash; compiles to direct register writes"]

  hal-section : Integer -> WidgetNode
  hal-section (x) =
    site-section "hal" "HARDWARE ABSTRACTION" "Types That Touch Hardware" "Linear types for pins, effect types for I/O. The type system knows what your hardware is doing." [
      site-showcase "hal-show" hal-code hal-info
    ]

Section: Handlers

  iot-click : Text -> Integer
  iot-click (id) = 0

Section: Entry

  render-iot : Integer -> Integer
  render-iot (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init iot-extra-css
    in let s = set-render render-iot
    in let h = register-handlers no-pick iot-click
    in render-iot 0
  end

