 Map viewer with search, layers, and points of interest.

 We say:

Section: Theme

  maps-theme : Theme
  maps-theme =
    let p = Palette { pal-bg = 1710618, pal-fg = #D8D8D8, pal-primary = #4490FF, pal-secondary = #222222, pal-accent = #4490FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #2A2A2A }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws #222222 (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 10 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "maps-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  maps-css : Text
  maps-css =
    "*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}body{background:#1a1a1a;color:#d8d8d8;font-family:system-ui,sans-serif}#app{display:flex;height:100vh;position:relative}"
    & ".map-canvas{flex:1;background:linear-gradient(135deg,#1a2a1a 0%,#1a2a2a 25%,#2a3a2a 50%,#1a2a3a 75%,#2a2a2a 100%);position:relative;overflow:hidden}"
    & ".map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:60px 60px}"
    & ".map-road{position:absolute;background:rgba(255,255,255,.08);border-radius:2px}"
    & ".map-road.h{height:3px;width:100%}.map-road.v{width:3px;height:100%}"
    & ".map-pin{position:absolute;font-size:28px;cursor:pointer;transform:translate(-50%,-100%);transition:transform .15s;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}"
    & ".map-pin:hover{transform:translate(-50%,-100%) scale(1.3)}"
    & ".search-bar{position:absolute;top:16px;left:16px;right:16px;max-width:400px;z-index:10}"
    & ".search-bar input{width:100%;background:rgba(30,30,30,.95);border:1px solid #333;border-radius:24px;padding:12px 20px;color:#d8d8d8;font-size:14px;outline:none;box-shadow:0 4px 12px rgba(0,0,0,.4)}"
    & ".search-bar input:focus{border-color:#4493ff}"
    & ".map-controls{position:absolute;right:16px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:10}"
    & ".map-controls button,.map-controls .wk-btn{width:40px;height:40px;background:rgba(30,30,30,.95);border:1px solid #333;border-radius:8px;color:#ddd;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center}"
    & ".map-controls button:hover,.map-controls .wk-btn:hover{background:#333}"
    & ".info-panel{position:absolute;bottom:16px;left:16px;width:320px;background:rgba(26,26,26,.95);border:1px solid #333;border-radius:12px;padding:16px;z-index:10;box-shadow:0 4px 16px rgba(0,0,0,.4)}"
    & ".info-panel h3{font-size:16px;font-weight:600;margin-bottom:4px}"
    & ".info-panel .address{font-size:13px;color:#888;margin-bottom:12px}"
    & ".info-panel .details{display:flex;gap:12px;font-size:12px;color:#aaa}"
    & ".info-panel .detail{display:flex;align-items:center;gap:4px}"
    & ".layer-panel{position:absolute;top:80px;left:16px;width:200px;background:rgba(26,26,26,.95);border:1px solid #333;border-radius:12px;padding:12px;z-index:10}"
    & ".layer-panel h4{font-size:12px;color:#888;text-transform:uppercase;margin-bottom:8px;letter-spacing:.5px}"
    & ".layer-item{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:13px;cursor:pointer}"
    & ".layer-dot{width:10px;height:10px;border-radius:50%}"
    & ".compass{position:absolute;top:16px;right:16px;width:48px;height:48px;background:rgba(30,30,30,.95);border:1px solid #333;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:bold;color:#e44;z-index:10}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-panel "root" DirColumn 0 [
      widget-box "map-canvas" "map-canvas" [
        widget-box "grid" "map-grid" [],
        widget-box "r1" "map-road h" [],
        widget-box "r2" "map-road h" [],
        widget-box "r3" "map-road v" [],
        widget-box "r4" "map-road v" [],
        widget-box-click "pin1" (pin-cls 1) [ widget-label "pin1-i" "&#x1F4CD;" ],
        widget-box-click "pin2" (pin-cls 2) [ widget-label "pin2-i" "&#x1F4CD;" ],
        widget-box-click "pin3" (pin-cls 3) [ widget-label "pin3-i" "&#x1F4CD;" ],
        widget-box "search" "search-bar" [
          widget-add-child (widget-custom "search-input" "input" 0 0) (widget-label "search-p" "Search places...")
        ],
        widget-box "controls" "map-controls" [
          widget-button "zoom-in" "+",
          widget-button "zoom-out" "-",
          widget-button "locate" "&#x1F4CD;",
          widget-button "layers" "&#x1F5FA;"
        ],
        widget-box "compass" "compass" [ widget-label "compass-n" "N" ],
        layer-panel 0,
        info-panel 0
      ]
    ]

  layer-panel : Integer -> WidgetNode
  layer-panel (x) =
    let show = state-get "show-layers"
    in if show == 0 then widget-label "no-layers" ""
    else widget-box "layer-panel" "layer-panel" [
      widget-label "lp-title" "MAP LAYERS",
      widget-box-click "ly-road" (layer-cls 0) [ widget-label "lr-dot" "&#x1F7E2;", widget-label "lr-name" "Roads" ],
      widget-box-click "ly-sat" (layer-cls 1) [ widget-label "ls-dot" "&#x1F535;", widget-label "ls-name" "Satellite" ],
      widget-box-click "ly-ter" (layer-cls 2) [ widget-label "lt-dot" "&#x1F7E4;", widget-label "lt-name" "Terrain" ],
      widget-box-click "ly-trf" (layer-cls 3) [ widget-label "lf-dot" "&#x1F7E1;", widget-label "lf-name" "Traffic" ]
    ]

  layer-cls : Integer -> Text
  layer-cls (i) =
    if state-get "active-layer" == i then "layer-item active" else "layer-item"
  pin-cls : Integer -> Text
  pin-cls (i) =
    if state-get "selected-pin" == i then "map-pin active" else "map-pin"

  info-panel : Integer -> WidgetNode
  info-panel (x) =
    let p = let sp = state-get "selected-pin" in if sp == 0 then 1 else sp
    in widget-box "info" "info-panel" [
      widget-label "info-name" (pin-name p),
      widget-label "info-addr" (pin-coords p),
      widget-box "info-details" "details" [
        widget-box "id1" "detail" [ widget-label "id1-v" ("&#x1F321; " & pin-temp p) ],
        widget-box "id2" "detail" [ widget-label "id2-v" (pin-elev p) ],
        widget-box "id3" "detail" [ widget-label "id3-v" "&#x1F553; 12:42 PM" ]
      ]
    ]

  pin-name : Integer -> Text
  pin-name (i) =
    if i == 1 then "Portland, Oregon"
    else if i == 2 then "Seattle, Washington"
    else "San Francisco, California"
  pin-coords : Integer -> Text
  pin-coords (i) =
    if i == 1 then "45.5152&#xB0; N, 122.6784&#xB0; W"
    else if i == 2 then "47.6062&#xB0; N, 122.3321&#xB0; W"
    else "37.7749&#xB0; N, 122.4194&#xB0; W"
  pin-temp : Integer -> Text
  pin-temp (i) =
    if i == 1 then "68&#xB0;F"
    else if i == 2 then "61&#xB0;F"
    else "64&#xB0;F"
  pin-elev : Integer -> Text
  pin-elev (i) =
    if i == 1 then "&#x1F4CF; 50 ft elev"
    else if i == 2 then "&#x1F4CF; 175 ft elev"
    else "&#x1F4CF; 52 ft elev"

Section: Handlers

  maps-click : Text -> Integer
  maps-click (id) =
    if id == "layers" then let s = state-set-render "show-layers" (if state-get "show-layers" == 1 then 0 else 1) in 0
    else if id == "ly-road" then let s = state-set-render "active-layer" 0 in 0
    else if id == "ly-sat" then let s = state-set-render "active-layer" 1 in 0
    else if id == "ly-ter" then let s = state-set-render "active-layer" 2 in 0
    else if id == "ly-trf" then let s = state-set-render "active-layer" 3 in 0
    else if id == "pin1" then let s = state-set-render "selected-pin" 1 in 0
    else if id == "pin2" then let s = state-set-render "selected-pin" 2 in 0
    else if id == "pin3" then let s = state-set-render "selected-pin" 3 in 0
    else 0

Section: Entry

  render-maps : Integer -> Integer
  render-maps (x) = mount-widget-themed maps-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style maps-theme maps-css
    in let s = set-render render-maps
    in let h = register-handlers no-pick maps-click
    in render-maps 0
  end

