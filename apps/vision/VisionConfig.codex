Chapter: VisionConfig
  cites Vision chapter VisionTypes

 Configuration and customization for Vision. Response windows,
 nudge thresholds, notification rules, scoring weights, and
 domain routing preferences are all configurable per-org.

Section: Response Window Config

  ResponseWindowConfig = record {
    rwc-musing-sec : Integer,
    rwc-suggestion-sec : Integer,
    rwc-directive-sec : Integer,
    rwc-mandate-sec : Integer
  }

  rwc-default : ResponseWindowConfig
  rwc-default = ResponseWindowConfig {
    rwc-musing-sec = 0,
    rwc-suggestion-sec = 432000,
    rwc-directive-sec = 172800,
    rwc-mandate-sec = 86400
  }

  rwc-fast : ResponseWindowConfig
  rwc-fast = ResponseWindowConfig {
    rwc-musing-sec = 0,
    rwc-suggestion-sec = 172800,
    rwc-directive-sec = 86400,
    rwc-mandate-sec = 28800
  }

  rwc-relaxed : ResponseWindowConfig
  rwc-relaxed = ResponseWindowConfig {
    rwc-musing-sec = 0,
    rwc-suggestion-sec = 604800,
    rwc-directive-sec = 432000,
    rwc-mandate-sec = 172800
  }

  rwc-window-for : ResponseWindowConfig, SignalWeight -> Integer
  rwc-window-for (cfg) (w) = when w
    is Musing -> cfg.rwc-musing-sec
    is Suggestion -> cfg.rwc-suggestion-sec
    is Directive -> cfg.rwc-directive-sec
    is Mandate -> cfg.rwc-mandate-sec

Section: Nudge Config

  NudgeConfig = record {
    nc-approaching-hours : Integer,
    nc-overdue-repeat-hours : Integer,
    nc-escalate-after-days : Integer,
    nc-max-nudges-per-hold : Integer
  }

  nc-default : NudgeConfig
  nc-default = NudgeConfig {
    nc-approaching-hours = 24,
    nc-overdue-repeat-hours = 48,
    nc-escalate-after-days = 7,
    nc-max-nudges-per-hold = 5
  }

Section: Notification Config

  NotificationConfig = record {
    ntf-musing : NotifAction,
    ntf-suggestion : NotifAction,
    ntf-directive : NotifAction,
    ntf-mandate : NotifAction
  }

  NotifAction =
    | NaFeedOnly
    | NaFeedAndDigest
    | NaImmediate
    | NaImmediateCascade

  ntf-default : NotificationConfig
  ntf-default = NotificationConfig {
    ntf-musing = NaFeedOnly,
    ntf-suggestion = NaFeedAndDigest,
    ntf-directive = NaImmediate,
    ntf-mandate = NaImmediateCascade
  }

  ntf-for-weight : NotificationConfig, SignalWeight -> NotifAction
  ntf-for-weight (cfg) (w) = when w
    is Musing -> cfg.ntf-musing
    is Suggestion -> cfg.ntf-suggestion
    is Directive -> cfg.ntf-directive
    is Mandate -> cfg.ntf-mandate

Section: Scoring Config

  ScoringConfig = record {
    sc-risk-critical-penalty : Integer,
    sc-risk-high-penalty : Integer,
    sc-risk-medium-penalty : Integer,
    sc-risk-low-penalty : Integer,
    sc-milestone-weight : Integer,
    sc-risk-weight : Integer,
    sc-confidence-floor : Integer
  }

  sc-default : ScoringConfig
  sc-default = ScoringConfig {
    sc-risk-critical-penalty = 20,
    sc-risk-high-penalty = 10,
    sc-risk-medium-penalty = 5,
    sc-risk-low-penalty = 1,
    sc-milestone-weight = 70,
    sc-risk-weight = 30,
    sc-confidence-floor = 40
  }

Section: Master Config

  VisionConfig = record {
    vc-response-windows : ResponseWindowConfig,
    vc-nudge : NudgeConfig,
    vc-notification : NotificationConfig,
    vc-scoring : ScoringConfig,
    vc-org-name : Text,
    vc-timezone-offset-hours : Integer,
    vc-work-start-hour : Integer,
    vc-work-end-hour : Integer,
    vc-work-days : Integer
  }

  config-default : VisionConfig
  config-default = VisionConfig {
    vc-response-windows = rwc-default,
    vc-nudge = nc-default,
    vc-notification = ntf-default,
    vc-scoring = sc-default,
    vc-org-name = "Codex",
    vc-timezone-offset-hours = 0,
    vc-work-start-hour = 9,
    vc-work-end-hour = 17,
    vc-work-days = 5
  }

  is-work-hours : VisionConfig, Integer -> Boolean
  is-work-hours (cfg) (hour-of-day) =
    if hour-of-day >= cfg.vc-work-start-hour
    then hour-of-day < cfg.vc-work-end-hour
    else False
