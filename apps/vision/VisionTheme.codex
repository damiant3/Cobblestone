Chapter: VisionTheme
  cites Vision chapter VisionTypes

 Theme for the Vision app. Signal weight colors, tier indicators,
 and state badges. Extends the dark-gold Codex theme.

Section: Weight Colors

  vt-musing-color : Integer = #8b949e
  vt-suggestion-color : Integer = #58a6ff
  vt-directive-color : Integer = #ffd700
  vt-mandate-color : Integer = #f85149

  vt-weight-bg : SignalWeight -> Integer
  vt-weight-bg (w) = when w
    is Musing -> #1a1a2e
    is Suggestion -> #0d2137
    is Directive -> #2d2600
    is Mandate -> #2d0f0f

Section: State Colors

  vt-state-color : SignalState -> Integer
  vt-state-color (s) = when s
    is SigNew -> #58a6ff
    is SigPickedUp -> #ffd700
    is SigPushed -> #f0883e
    is SigResponded -> #3fb950
    is SigClosed -> #8b949e
    is SigExpired -> #f85149

Section: Role Colors

  vt-role-color : PersonRole -> Integer
  vt-role-color (r) = when r
    is RoleExec -> #ffd700
    is RoleVP -> #f0883e
    is RoleDirector -> #58a6ff
    is RoleLead -> #3fb950
    is RoleIC -> #8b949e

Section: Risk Colors

  vt-risk-color : RiskLevel -> Integer
  vt-risk-color (r) = when r
    is RiskLow -> #3fb950
    is RiskMedium -> #ffd700
    is RiskHigh -> #f0883e
    is RiskCritical -> #f85149

Section: Layout Constants

  vt-bg : Integer = #0d1117
  vt-surface : Integer = #161b22
  vt-border : Integer = #30363d
  vt-text-primary : Integer = #f0f6fc
  vt-text-secondary : Integer = #8b949e
  vt-sidebar-width : Integer = 240
  vt-header-height : Integer = 48
  vt-signal-card-height : Integer = 80
