Chapter: VisionTheme
  cites Vision chapter VisionTypes

 Theme for the Vision app. Signal weight colors, tier indicators,
 and state badges. Extends the dark-gold Codex theme.

Section: Weight Colors

  vt-musing-color : Integer = 0x8b949e
  vt-suggestion-color : Integer = 0x58a6ff
  vt-directive-color : Integer = 0xffd700
  vt-mandate-color : Integer = 0xf85149

  vt-weight-bg : SignalWeight -> Integer
  vt-weight-bg (w) = when w
    is Musing -> 0x1a1a2e
    is Suggestion -> 0x0d2137
    is Directive -> 0x2d2600
    is Mandate -> 0x2d0f0f

Section: State Colors

  vt-state-color : SignalState -> Integer
  vt-state-color (s) = when s
    is SigNew -> 0x58a6ff
    is SigPickedUp -> 0xffd700
    is SigPushed -> 0xf0883e
    is SigResponded -> 0x3fb950
    is SigClosed -> 0x8b949e
    is SigExpired -> 0xf85149

Section: Role Colors

  vt-role-color : PersonRole -> Integer
  vt-role-color (r) = when r
    is RoleExec -> 0xffd700
    is RoleVP -> 0xf0883e
    is RoleDirector -> 0x58a6ff
    is RoleLead -> 0x3fb950
    is RoleIC -> 0x8b949e

Section: Risk Colors

  vt-risk-color : RiskLevel -> Integer
  vt-risk-color (r) = when r
    is RiskLow -> 0x3fb950
    is RiskMedium -> 0xffd700
    is RiskHigh -> 0xf0883e
    is RiskCritical -> 0xf85149

Section: Layout Constants

  vt-bg : Integer = 0x0d1117
  vt-surface : Integer = 0x161b22
  vt-border : Integer = 0x30363d
  vt-text-primary : Integer = 0xf0f6fc
  vt-text-secondary : Integer = 0x8b949e
  vt-sidebar-width : Integer = 240
  vt-header-height : Integer = 48
  vt-signal-card-height : Integer = 80
