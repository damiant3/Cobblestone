Section: Particle Store

 md is modulo for wrapping the ever-increasing spawn cursor into a slot.

  md : Integer, Integer -> Integer
  md (a) (n) = a - (a / n) * n

  rnd : Integer -> Integer
  rnd (n) =
    let a = n * 374761393 + 668265263
    in let b = bit-xor a (bit-shru a 13)
    in let c = b * 1274126177
    in bit-and (bit-xor c (bit-shru c 16)) #FFFFFF

  write-particle : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  write-particle (slot) (px) (py) (vx) (vy) (life) (col) (kind) =
    let o = slot * part-stride
    in let a = poke-32 part-base (o + f-px) px
    in let b = poke-32 part-base (o + f-py) py
    in let c = poke-32 part-base (o + f-vx) vx
    in let d = poke-32 part-base (o + f-vy) vy
    in let e = poke-32 part-base (o + f-life) life
    in let f = poke-32 part-base (o + f-max) life
    in let g = poke-32 part-base (o + f-col) col
    in let h = poke-32 part-base (o + f-kind) kind
    in slot

  clear-parts : Integer -> Integer
  clear-parts (i) =
    if i >= part-cap then 0
    else let w = poke-32 part-base (i * part-stride + f-kind) 0
    in clear-parts (i + 1)

Section: Simulation

 A burst spawns burst-count sparks radiating from a center, each with a
 jittered speed and lifetime so the flower has soft edges. cx/cy and the
 velocities are fixed-point (1/256 pixel).

  spawn-burst : Integer, Integer, Integer, Integer, Integer -> Integer
  spawn-burst (cx) (cy) (col) (cursor) (i) =
    if i >= burst-count then cursor
    else let jit = rnd (cx + cy * 3 + i * 2654435)
    in let ang = i * 6283 / burst-count + bit-and jit 63
    in let spd = 240 + bit-and (bit-shru jit 6) 640
    in let vx = (fw-cos ang) * spd / 1000
    in let vy = (fw-sin ang) * spd / 1000
    in let life = 40 + bit-and (bit-shru jit 16) 70
    in let slot = md cursor part-cap
    in let w = write-particle slot cx cy vx vy life col 1
    in spawn-burst cx cy col (cursor + 1) (i + 1)

  maybe-launch : Integer, Integer -> Integer
  maybe-launch (frame) (cursor) =
    if md frame launch-every /= 0 then cursor
    else let r = rnd (frame * 17 + 3)
    in let lx = 70 + (bit-and r 1023) * (sw - 140) / 1024
    in let vy0 = 0 - (2280 + bit-and (bit-shru r 10) 300)
    in let vx0 = ((bit-and (bit-shru r 20) 255) - 128) * 4
    in let col = burst-color (bit-shru r 18)
    in let slot = md cursor part-cap
    in let w = write-particle slot (lx * 256) ((horizon - 30) * 256) vx0 vy0 240 col 2
    in cursor + 1

  finale-launch : Integer, Integer, Integer -> Integer
  finale-launch (frame) (cursor) (i) =
    if i >= 3 then cursor
    else let r = rnd (frame * 131 + i * 977 + 7)
    in let lx = 60 + (bit-and r 1023) * (sw - 120) / 1024
    in let vy0 = 0 - (2250 + bit-and (bit-shru r 10) 350)
    in let vx0 = ((bit-and (bit-shru r 20) 255) - 128) * 5
    in let col = burst-color (bit-shru r 18)
    in let slot = md cursor part-cap
    in let w = write-particle slot (lx * 256) ((horizon - 20) * 256) vx0 vy0 200 col 2
    in finale-launch frame (cursor + 1) (i + 1)

  launch-frame : Integer, Integer -> Integer
  launch-frame (frame) (cursor) =
    if is-finale frame >= 1 then finale-gate frame cursor
    else maybe-launch frame cursor

  finale-gate : Integer, Integer -> Integer
  finale-gate (frame) (cursor) =
    if md frame 3 == 0 then finale-launch frame cursor 0 else cursor

  update-steps : Integer, Integer -> Integer
  update-steps (cursor) (n) =
    if n <= 0 then cursor
    else update-steps (update-all 0 cursor) (n - 1)

  update-all : Integer, Integer -> Integer
  update-all (i) (cursor) =
    if i >= part-cap then cursor
    else let o = i * part-stride
    in let kind = peek-32 part-base (o + f-kind)
    in if kind == 0 then update-all (i + 1) cursor
    else let life = peek-32 part-base (o + f-life)
    in if life <= 0 then
      let k = poke-32 part-base (o + f-kind) 0
      in update-all (i + 1) cursor
    else let px = peek-32 part-base (o + f-px)
    in let py = peek-32 part-base (o + f-py)
    in let vx = peek-32 part-base (o + f-vx)
    in let vy = peek-32 part-base (o + f-vy)
    in let vy2 = vy + gravity
    in let a = poke-32 part-base (o + f-px) (px + vx)
    in let b = poke-32 part-base (o + f-py) (py + vy)
    in let c = poke-32 part-base (o + f-vy) vy2
    in let d = poke-32 part-base (o + f-life) (life - 1)
    in if kind == 2 then
      if py <= burst-alt * 256 then
        let col = peek-32 part-base (o + f-col)
        in let kill = poke-32 part-base (o + f-kind) 0
        in let cur2 = spawn-burst (px + vx) (py + vy) col cursor 0
        in update-all (i + 1) cur2
      else let ts = md cursor part-cap
      in let tw = write-particle ts (px + vx) (py + vy) (vx / 3) (vy / 4 + 20) 14 #FFC864 1
      in update-all (i + 1) (cursor + 1)
    else update-all (i + 1) cursor

Section: Particle Draw

  reflect-spark : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  reflect-spark (cmd) (idx) (sx) (ry) (sz) (base) (fade) =
    if ry >= sh then idx
    else put-rect-add cmd idx (sx - sz) (ry - sz) (sz * 2) (sz * 2) (scale-col base (fade / 3)) 2000

  scale-col : Integer, Integer -> Integer
  scale-col (packed) (f) =
    let r = bit-and (bit-shru packed 16) 255
    in let g = bit-and (bit-shru packed 8) 255
    in let b = bit-and packed 255
    in bit-or (bit-shl (r * f / 1000) 16) (bit-or (bit-shl (g * f / 1000) 8) (b * f / 1000))

  draw-particles : Integer, Integer, Integer -> Integer
  draw-particles (cmd) (idx) (i) =
    if i >= part-cap then idx
    else if idx >= max-tri then idx
    else let o = i * part-stride
    in let kind = peek-32 part-base (o + f-kind)
    in if kind == 0 then draw-particles cmd idx (i + 1)
    else let life = peek-32 part-base (o + f-life)
    in let maxl = peek-32 part-base (o + f-max)
    in let sx = (peek-32 part-base (o + f-px)) / 256
    in let sy = (peek-32 part-base (o + f-py)) / 256
    in let fade = if maxl <= 0 then 0 else life * 1000 / maxl
    in let base = peek-32 part-base (o + f-col)
    in if kind == 2 then
      let i2 = put-rect-add cmd idx (sx - 3) (sy - 3) 6 6 shell-col 300
      in draw-particles cmd i2 (i + 1)
    else let col = scale-col base fade
    in let sz = if fade > 600 then 3 else 2
    in let i2 = put-rect-add cmd idx (sx - sz) (sy - sz) (sz * 2) (sz * 2) col 300
    in let ry = 2 * horizon - sy
    in let i3 = if ry > horizon then reflect-spark cmd i2 sx ry sz base fade else i2
    in draw-particles cmd i3 (i + 1)

 Photoreal draw: soft round embers that cool from white-hot to their
 ember color to a dim red as they age, blended additively with a radial
 falloff and bloom.

  cool-col : Integer, Integer -> Integer
  cool-col (base) (fade) =
    if fade > 820 then #FFF4E0
    else if fade > 520 then base
    else scale-col base (fade * 2 + 120)

  draw-particles-soft : Integer, Integer, Integer -> Integer
  draw-particles-soft (cmd) (idx) (i) =
    if i >= part-cap then idx
    else if idx >= max-tri then idx
    else let o = i * part-stride
    in let kind = peek-32 part-base (o + f-kind)
    in if kind == 0 then draw-particles-soft cmd idx (i + 1)
    else let life = peek-32 part-base (o + f-life)
    in let maxl = peek-32 part-base (o + f-max)
    in let sx = (peek-32 part-base (o + f-px)) / 256
    in let sy = (peek-32 part-base (o + f-py)) / 256
    in let fade = if maxl <= 0 then 0 else life * 1000 / maxl
    in let base = peek-32 part-base (o + f-col)
    in if kind == 2 then
      let i2 = put-sprite cmd idx sx sy 5 shell-col
      in draw-particles-soft cmd i2 (i + 1)
    else let col = cool-col base fade
    in let sz = if fade > 600 then 5 else 4
    in let i2 = put-sprite cmd idx sx sy sz col
    in draw-particles-soft cmd i2 (i + 1)

Section: Scene

  is-finale : Integer -> Integer
  is-finale (frame) =
    if force-finale >= 1 then 1
    else if md frame cycle-total >= cycle-cities then 1 else 0

  scene-city : Integer -> Integer
  scene-city (frame) =
    if force-city >= 0 then force-city
    else md (md frame cycle-total / frames-per-city) num-cities

  render-scene : Integer, Integer, Integer -> Integer
  render-scene (cmd) (frame) (mode) =
    if mode == 1 then render-real cmd frame
    else if is-finale frame >= 1 then render-finale cmd frame
    else render-city-scene cmd frame

 Mode 1: the photoreal take. Same skyline and burst physics, but sparks
 are soft luminous embers (no HUD chrome), letting the bloom and grade
 carry a long-exposure, photographic look.

  render-real : Integer, Integer -> Integer
  render-real (cmd) (frame) =
    let i1 = draw-water cmd 0
    in let i2 = draw-skyline cmd i1 (scene-city frame)
    in draw-particles-soft cmd i2 0

  render-city-scene : Integer, Integer -> Integer
  render-city-scene (cmd) (frame) =
    let city = scene-city frame
    in let i0 = draw-sky cmd 0
    in let i1 = draw-water cmd i0
    in let i2 = draw-skyline cmd i1 city
    in let i3 = draw-particles cmd i2 0
    in let i4 = draw-banner cmd i3
    in draw-city-name cmd i4 city

  render-finale : Integer, Integer -> Integer
  render-finale (cmd) (frame) =
    let i0 = draw-sky cmd 0
    in let i1 = draw-water cmd i0
    in let i2 = draw-city cmd i1 0 909
    in let i3 = draw-particles cmd i2 0
    in let i4 = draw-banner cmd i3
    in draw-finale-text cmd i4

  draw-finale-text : Integer, Integer -> Integer
  draw-finale-text (cmd) (idx) =
    let bx = 316
    in let by = 250
    in let bs = 14
    in let i0 = gc cmd idx bx by bs banner-col 0 g-u
    in let i1 = gc cmd i0 bx by bs banner-col 1 g-s
    in let i2 = gc cmd i1 bx by bs banner-col 2 g-a
    in let i4 = gc cmd i2 bx by bs banner-col 4 g-d2
    in let i5 = gc cmd i4 bx by bs banner-col 5 g-d5
    in let i6 = gc cmd i5 bx by bs banner-col 6 g-d0
    in draw-finale-sub cmd i6

  draw-finale-sub : Integer, Integer -> Integer
  draw-finale-sub (cmd) (idx) =
    let sx = 368
    in let sy = 470
    in let ss = 8
    in let i0 = gc cmd idx sx sy ss name-col 0 g-d2
    in let i1 = gc cmd i0 sx sy ss name-col 1 g-d5
    in let i2 = gc cmd i1 sx sy ss name-col 2 g-d0
    in let i4 = gc cmd i2 sx sy ss name-col 4 g-y
    in let i5 = gc cmd i4 sx sy ss name-col 5 g-e
    in let i6 = gc cmd i5 sx sy ss name-col 6 g-a
    in let i7 = gc cmd i6 sx sy ss name-col 7 g-r
    in gc cmd i7 sx sy ss name-col 8 g-s

  seed-scene : Integer -> Integer
  seed-scene (dummy) =
    let c0 = clear-parts 0
    in let c1 = spawn-burst (300 * 256) (170 * 256) #FF3324 c0 0
    in spawn-burst (720 * 256) (150 * 256) #3A6BFF c1 0

Section: Frame Loop

 Port I/O carries the Device.Port capability effect, so each port call
 is an act-bind. The pure launch/update/draw run in a let-in tail; the
 flush and the returned cursor thread through flush-ret.

  poll-key : Integer -> [Device.Port] Integer
  poll-key (kb) = act
    d <- port-in-byte 96
    let sc = peek-byte kb 0
    in let ack = poke-byte kb 0 0
    in sc
  end

  flush-ret : Integer, Integer -> [Device.Port] Integer
  flush-ret (n) (ret) = act
    f <- port-out-32 1024 n
    ret
  end

  clear-select : Integer -> [Device.Port] Integer
  clear-select (mode) =
    if mode == 1 then port-out-32 1038 fade-sky
    else port-out-32 1025 sky-top

  clear-frame : Integer -> [Device.Port] Integer
  clear-frame (mode) = act
    r <- clear-select mode
    d <- port-out-32 1026 0
    r
  end

  render-frame : Integer, Integer, Integer, Integer -> [Device.Port] Integer
  render-frame (cmd) (frame) (cursor) (mode) = act
    a <- clear-frame mode
    let cur1 = launch-frame frame cursor
    in let cur2 = update-steps cur1 sim-substeps
    in let n = render-scene cmd frame mode
    in flush-ret n cur2
  end

  edge-mode : Integer, Integer, Integer -> Integer
  edge-mode (sc) (prev) (mode) =
    if sc == 59 then (if prev == 59 then mode else 1 - mode)
    else mode

  fw-loop : Integer, Integer, Integer, Integer, Integer -> [Device.Port] Text
  fw-loop (cmd) (frame) (cursor) (mode) (prev) = act
    sc <- poll-key kb-addr
    nc <- render-frame cmd frame cursor (edge-mode sc prev mode)
    when sc == 16
      is True -> "done"
      is otherwise -> fw-loop cmd (frame + 1) nc (edge-mode sc prev mode) sc
  end

Section: Fixed-Point Trig

  fw-sin : Integer -> Integer
  fw-sin (raw) =
    let a = fw-wrap raw
    in if a <= 1570 then fw-sin-core a
    else if a <= 3141 then fw-sin-core (3141 - a)
    else if a <= 4712 then 0 - fw-sin-core (a - 3141)
    else 0 - fw-sin-core (6283 - a)

  fw-cos : Integer -> Integer
  fw-cos (raw) = fw-sin (raw + 1570)

  fw-sin-core : Integer -> Integer
  fw-sin-core (x) =
    let x2 = x * x / 1000
    in let x3 = x2 * x / 1000
    in let x5 = x3 * x2 / 1000
    in x - x3 / 6 + x5 / 120

  fw-wrap : Integer -> Integer
  fw-wrap (a) = let m = a - (a / 6283) * 6283 in if m < 0 then m + 6283 else m

Section: Entry

  opening : [Console, Device.Port] Nothing = act
    con <- port-out-32 1040 1
    result <- fw-loop cmd-buf 0 (seed-scene 0) 0 0
    print-line-uni result
  end

Page 1
