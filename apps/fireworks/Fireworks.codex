Chapter: Fireworks
  cites Foreword chapter Console
  cites UI chapter KeyInput

 USA 250 -- fireworks bursting over a major American city skyline,
 rendered on the bare-metal host GPU triangle rasterizer. The guest
 composes a screen-space triangle command buffer in RAM at 0xBE000000
 and fires I/O port 0x400; codex-vm rasterizes it at native speed into
 the GOP framebuffer, with an atmosphere-glow bloom pass for free.

 Stage 2: a live particle simulation. Shells launch from the rooftops,
 arc upward under gravity, and explode into radial bursts of sparks
 that fall and fade over their lifetime. Particles live in a fixed
 flat RAM buffer (poke/peek, O(1), zero per-frame heap allocation).

 We say:

Section: Constants

  cmd-buf : Integer = #BE000000
  sw : Integer = 1024
  sh : Integer = 768
  horizon : Integer = 680
  max-tri : Integer = 60000
  city-seed : Integer = 777

  num-cities : Integer = 5
  frames-per-city : Integer = 600
  finale-len : Integer = 900
  cycle-cities : Integer = num-cities * frames-per-city
  cycle-total : Integer = cycle-cities + finale-len
  force-city : Integer = -1
  force-finale : Integer = 0

  part-base : Integer = #B0000000
  part-cap : Integer = 2600
  part-stride : Integer = 32
  gravity : Integer = 20
  launch-every : Integer = 9
  burst-count : Integer = 150
  sim-substeps : Integer = 3
  burst-alt : Integer = 170

 Particle field byte offsets within a 32-byte slot. Position and
 velocity are fixed-point at 1/256 pixel.

  f-px : Integer = 0
  f-py : Integer = 4
  f-vx : Integer = 8
  f-vy : Integer = 12
  f-life : Integer = 16
  f-max : Integer = 20
  f-col : Integer = 24
  f-kind : Integer = 28

Section: Colors

  sky-top : Integer = #060616
  sky-horizon : Integer = #2A1840
  fade-sky : Integer = #04040E
  water-top : Integer = #180C28
  water-bottom : Integer = #05030A
  building-col : Integer = #141634
  shell-col : Integer = #FFF0C0

  landmark-col : Integer = #1C2148
  antenna-col : Integer = #C83A2A
  gg-orange : Integer = #C0442A
  gg-cable : Integer = #8A2F1E
  needle-col : Integer = #2A3060
  monument-col : Integer = #D8D2C0
  dome-col : Integer = #C8C4B4
  trans-col : Integer = #6A6E86

  burst-color : Integer -> Integer
  burst-color (k) =
    let m = k - (k / 6) * 6
    in if m == 0 then #FF3324
    else if m == 1 then #FFFFFF
    else if m == 2 then #3A6BFF
    else if m == 3 then #FFD028
    else if m == 4 then #46E070
    else #C64BFF

Section: Triangle Primitives

 A triangle is 72 bytes in the command buffer: three screen xy pairs,
 three packed XRGB per-vertex colors, three depths, then six texture
 coords at zero. Winding gives a negative signed area so the rasterizer
 keeps the face. Small depth values draw in front; the sky/water use
 large depths as the backdrop.

  bump : Integer, Integer -> Integer
  bump (written) (t) = t

  put-tri3 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-tri3 (cmd) (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) (d) =
    let o = idx * 72
    in bump (gpu-mem-write cmd o x0 + gpu-mem-write cmd (o + 4) y0 + gpu-mem-write cmd (o + 8) x1 + gpu-mem-write cmd (o + 12) y1 + gpu-mem-write cmd (o + 16) x2 + gpu-mem-write cmd (o + 20) y2 + gpu-mem-write cmd (o + 24) c0 + gpu-mem-write cmd (o + 28) c1 + gpu-mem-write cmd (o + 32) c2 + gpu-mem-write cmd (o + 36) d + gpu-mem-write cmd (o + 40) d + gpu-mem-write cmd (o + 44) d + gpu-mem-write cmd (o + 48) 0 + gpu-mem-write cmd (o + 52) 0 + gpu-mem-write cmd (o + 56) 0 + gpu-mem-write cmd (o + 60) 0 + gpu-mem-write cmd (o + 64) 0 + gpu-mem-write cmd (o + 68) 0) (idx + 1)

  put-rect : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-rect (cmd) (idx) (x) (y) (w) (h) (col) (d) =
    if idx >= max-tri then idx
    else put-tri3 cmd (put-tri3 cmd idx x y x (y + h) (x + w) y col col col d) (x + w) y x (y + h) (x + w) (y + h) col col col d

  put-quad-c : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-quad-c (cmd) (idx) (x) (y) (w) (h) (ctop) (cbot) (d) =
    if idx >= max-tri then idx
    else put-tri3 cmd (put-tri3 cmd idx x y x (y + h) (x + w) y ctop cbot ctop d) (x + w) y x (y + h) (x + w) (y + h) ctop cbot cbot d

 put-tri3-add / put-rect-add tag the triangle for additive blending by
 storing 1 in the first texcoord slot; codex-vm cinematic mode reads that
 flag and sums the fragment into the framebuffer instead of overwriting,
 so overlapping sparks build hot, bloom-able cores.

  put-tri3-add : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-tri3-add (cmd) (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) (d) =
    let o = idx * 72
    in bump (gpu-mem-write cmd o x0 + gpu-mem-write cmd (o + 4) y0 + gpu-mem-write cmd (o + 8) x1 + gpu-mem-write cmd (o + 12) y1 + gpu-mem-write cmd (o + 16) x2 + gpu-mem-write cmd (o + 20) y2 + gpu-mem-write cmd (o + 24) c0 + gpu-mem-write cmd (o + 28) c1 + gpu-mem-write cmd (o + 32) c2 + gpu-mem-write cmd (o + 36) d + gpu-mem-write cmd (o + 40) d + gpu-mem-write cmd (o + 44) d + gpu-mem-write cmd (o + 48) 1 + gpu-mem-write cmd (o + 52) 0 + gpu-mem-write cmd (o + 56) 0 + gpu-mem-write cmd (o + 60) 0 + gpu-mem-write cmd (o + 64) 0 + gpu-mem-write cmd (o + 68) 0) (idx + 1)

  put-rect-add : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-rect-add (cmd) (idx) (x) (y) (w) (h) (col) (d) =
    if idx >= max-tri then idx
    else put-tri3-add cmd (put-tri3-add cmd idx x y x (y + h) (x + w) y col col col d) (x + w) y x (y + h) (x + w) (y + h) col col col d

 put-sprite draws a SOFT round additive glow: a quad tagged u0=2 with the
 sprite center (cx,cy) and radius stored in the texcoords, so codex-vm
 cinematic mode shades each fragment with a radial falloff. Combined with
 bloom this reads as a real luminous ember instead of a hard square.

  put-tri3-soft : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-tri3-soft (cmd) (idx) (x0) (y0) (x1) (y1) (x2) (y2) (col) (cx) (cy) (r) =
    let o = idx * 72
    in bump (gpu-mem-write cmd o x0 + gpu-mem-write cmd (o + 4) y0 + gpu-mem-write cmd (o + 8) x1 + gpu-mem-write cmd (o + 12) y1 + gpu-mem-write cmd (o + 16) x2 + gpu-mem-write cmd (o + 20) y2 + gpu-mem-write cmd (o + 24) col + gpu-mem-write cmd (o + 28) col + gpu-mem-write cmd (o + 32) col + gpu-mem-write cmd (o + 36) 300 + gpu-mem-write cmd (o + 40) 300 + gpu-mem-write cmd (o + 44) 300 + gpu-mem-write cmd (o + 48) 2 + gpu-mem-write cmd (o + 52) 0 + gpu-mem-write cmd (o + 56) cx + gpu-mem-write cmd (o + 60) cy + gpu-mem-write cmd (o + 64) r + gpu-mem-write cmd (o + 68) 0) (idx + 1)

  put-sprite : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  put-sprite (cmd) (idx) (sx) (sy) (r) (col) =
    if idx >= max-tri then idx
    else let x0 = sx - r
    in let y0 = sy - r
    in let x1 = sx + r
    in let y1 = sy + r
    in put-tri3-soft cmd (put-tri3-soft cmd idx x0 y0 x0 y1 x1 y0 col sx sy r) x1 y0 x0 y1 x1 y1 col sx sy r

Section: Sky and Water

  draw-sky : Integer, Integer -> [Gpu.Memory] Integer
  draw-sky (cmd) (idx) = put-quad-c cmd idx 0 0 sw horizon sky-top sky-horizon 9000

  draw-water : Integer, Integer -> [Gpu.Memory] Integer
  draw-water (cmd) (idx) = put-quad-c cmd idx 0 horizon sw (sh - horizon) water-top water-bottom 8600

Section: Procedural Skyline

  hsh : Integer -> Integer
  hsh (n) = bit-and (bit-shru ((n * 1103515245) + 12345) 16) 1023

  draw-city : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-city (cmd) (idx) (bx) (seed) =
    if bx >= sw then idx
    else if idx >= max-tri then idx
    else let bw = 44 + (hsh (bx + seed)) * 46 / 1024
    in let bh = 90 + (hsh (bx * 3 + seed + 11)) * 340 / 1024
    in let top = horizon - bh
    in let cols = (bw - 12) / 12
    in let rows = (bh - 18) / 14
    in draw-city cmd (draw-windows cmd (put-rect cmd idx bx top bw bh building-col 700) bx top bw bh (bx + seed) 0 cols rows) (bx + bw + 7) seed

  draw-windows : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-windows (cmd) (idx) (bx) (top) (bw) (bh) (seed) (k) (cols) (rows) =
    if cols <= 0 then idx
    else if rows <= 0 then idx
    else if k >= cols * rows then idx
    else if idx >= max-tri then idx
    else let cc = k - (k / cols) * cols
    in let rr = k / cols
    in let lit = bit-and (hsh (bx + k * 31 + seed)) 7
    in if lit >= 3 then draw-windows cmd idx bx top bw bh seed (k + 1) cols rows
    else let wx = bx + 6 + cc * 12
    in let wy = top + 10 + rr * 14
    in let wcol = if bit-and (hsh (bx + k * 7 + seed)) 1 == 0 then #FFD070 else #BFD8FF
    in draw-windows cmd (put-rect cmd idx wx wy 6 8 wcol 650) bx top bw bh seed (k + 1) cols rows

Section: Landmarks

  draw-skyline : Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-skyline (cmd) (idx) (city) =
    if city == 0 then draw-nyc cmd idx
    else if city == 1 then draw-chicago cmd idx
    else if city == 2 then draw-sf cmd idx
    else if city == 3 then draw-seattle cmd idx
    else draw-dc cmd idx

  draw-nyc : Integer, Integer -> [Gpu.Memory] Integer
  draw-nyc (cmd) (idx) =
    draw-empire cmd (draw-city cmd idx 0 101) 512

