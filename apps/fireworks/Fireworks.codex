  draw-willis : Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-willis (cmd) (idx) (cx) =
    put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd idx (cx - 80) (horizon - 300) 160 300 landmark-col 500) (cx - 80) (horizon - 372) 104 72 landmark-col 495) (cx - 40) (horizon - 420) 80 48 landmark-col 490) (cx - 30) (horizon - 470) 24 50 landmark-col 485) (cx + 6) (horizon - 470) 24 50 landmark-col 485) (cx - 20) (horizon - 512) 4 42 antenna-col 480) (cx + 14) (horizon - 512) 4 42 antenna-col 480

  draw-sf : Integer, Integer -> [Gpu.Memory] Integer
  draw-sf (cmd) (idx) =
    draw-goldengate cmd (draw-transamerica cmd (draw-city cmd idx 0 307) 800) 380 644

  draw-transamerica : Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-transamerica (cmd) (idx) (cx) =
    put-tri3 cmd (put-rect cmd idx (cx - 6) (horizon - 120) 12 120 trans-col 505) (cx - 30) (horizon - 120) (cx + 30) (horizon - 120) cx (horizon - 400) trans-col trans-col trans-col 505

  draw-goldengate : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-goldengate (cmd) (idx) (lx) (rx) =
    let ttop = horizon - 340
    in draw-cable cmd (put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd (put-rect cmd idx (lx - 12) ttop 24 (horizon - ttop) gg-orange 450) (rx - 12) ttop 24 (horizon - ttop) gg-orange 450) (lx - 12) (ttop + 40) 24 14 gg-orange 445) (rx - 12) (ttop + 40) 24 14 gg-orange 445) lx (horizon - 150) (rx - lx) 8 gg-orange 448) lx ttop (rx - lx) 130 0

  draw-cable : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-cable (cmd) (idx) (x0) (topy) (span) (sag) (i) =
    if i > 24 then idx
    else let u = i * 2 - 24
    in let px = x0 + i * span / 24
    in let yy = topy + sag - sag * u * u / 576
    in draw-cable cmd (put-rect cmd idx (px - 1) yy 3 3 gg-cable 440) x0 topy span sag (i + 1)

  draw-seattle : Integer, Integer -> [Gpu.Memory] Integer
  draw-seattle (cmd) (idx) =
    draw-needle cmd (draw-city cmd idx 0 411) 512

  draw-needle : Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-needle (cmd) (idx) (cx) =
    put-tri3 cmd (put-rect cmd (put-tri3 cmd (put-rect cmd (put-rect cmd (put-tri3 cmd (put-tri3 cmd idx (cx - 60) horizon (cx - 30) horizon (cx - 6) (horizon - 280) needle-col needle-col needle-col 500) (cx + 30) horizon (cx + 60) horizon (cx + 6) (horizon - 280) needle-col needle-col needle-col 500) (cx - 6) (horizon - 280) 12 280 needle-col 498) (cx - 48) (horizon - 306) 96 20 needle-col 490) (cx + 48) (horizon - 286) (cx - 48) (horizon - 286) cx (horizon - 274) needle-col needle-col needle-col 490) (cx - 4) (horizon - 344) 8 38 needle-col 488) (cx - 4) (horizon - 344) (cx + 4) (horizon - 344) cx (horizon - 362) antenna-col antenna-col antenna-col 486

  draw-dc : Integer, Integer -> [Gpu.Memory] Integer
  draw-dc (cmd) (idx) =
