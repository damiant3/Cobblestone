    in let j1 = gc cmd j0 x0 y s c 1 g-o
    in let j2 = gc cmd j1 x0 y s c 2 g-m
    in let j3 = gc cmd j2 x0 y s c 3 g-e
    in let j5 = gc cmd j3 x0 y s c 5 g-o
    in let j6 = gc cmd j5 x0 y s c 6 g-f
    in let j8 = gc cmd j6 x0 y s c 8 g-t
    in let j9 = gc cmd j8 x0 y s c 9 g-h
    in let j10 = gc cmd j9 x0 y s c 10 g-e
    in let j12 = gc cmd j10 x0 y s c 12 g-r
    in let j13 = gc cmd j12 x0 y s c 13 g-e
    in let j14 = gc cmd j13 x0 y s c 14 g-i
    in let j15 = gc cmd j14 x0 y s c 15 g-g
    in let j16 = gc cmd j15 x0 y s c 16 g-n
    in let j17 = gc cmd j16 x0 y s c 17 g-i
    in let j18 = gc cmd j17 x0 y s c 18 g-n
    in let j19 = gc cmd j18 x0 y s c 19 g-g
    in let j21 = gc cmd j19 x0 y s c 21 g-s
    in let j22 = gc cmd j21 x0 y s c 22 g-u
    in let j23 = gc cmd j22 x0 y s c 23 g-p
    in let j24 = gc cmd j23 x0 y s c 24 g-e
    in let j25 = gc cmd j24 x0 y s c 25 g-r
    in let j26 = gc cmd j25 x0 y s c 26 g-b
    in let j27 = gc cmd j26 x0 y s c 27 g-o
    in let j28 = gc cmd j27 x0 y s c 28 g-w
    in let j29 = gc cmd j28 x0 y s c 29 g-l
    in let j31 = gc cmd j29 x0 y s c 31 g-c
    in let j32 = gc cmd j31 x0 y s c 32 g-h
    in let j33 = gc cmd j32 x0 y s c 33 g-a
    in let j34 = gc cmd j33 x0 y s c 34 g-m
    in let j35 = gc cmd j34 x0 y s c 35 g-p
    in let j36 = gc cmd j35 x0 y s c 36 g-i
    in let j37 = gc cmd j36 x0 y s c 37 g-o
    in let j38 = gc cmd j37 x0 y s c 38 g-n
    in let j40 = gc cmd j38 x0 y s c 40 g-s
    in let j41 = gc cmd j40 x0 y s c 41 g-e
    in let j42 = gc cmd j41 x0 y s c 42 g-a
    in let j43 = gc cmd j42 x0 y s c 43 g-h
    in let j44 = gc cmd j43 x0 y s c 44 g-a
    in let j45 = gc cmd j44 x0 y s c 45 g-w
    in let j46 = gc cmd j45 x0 y s c 46 g-k
    in let j47 = gc cmd j46 x0 y s c 47 g-s
    in gc cmd j47 x0 y s c 48 g-bang

  draw-name-dc : Integer, Integer -> Integer
  draw-name-dc (cmd) (idx) =
    let x0 = 382
    in let y = name-y
    in let s = txt-sz
    in let i0 = gc cmd idx x0 y s name-col 0 g-w
    in let i1 = gc cmd i0 x0 y s name-col 1 g-a
    in let i2 = gc cmd i1 x0 y s name-col 2 g-s
    in let i3 = gc cmd i2 x0 y s name-col 3 g-h
    in let i4 = gc cmd i3 x0 y s name-col 4 g-i
    in let i5 = gc cmd i4 x0 y s name-col 5 g-n
    in let i6 = gc cmd i5 x0 y s name-col 6 g-g
    in let i7 = gc cmd i6 x0 y s name-col 7 g-t
    in let i8 = gc cmd i7 x0 y s name-col 8 g-o
    in let i9 = gc cmd i8 x0 y s name-col 9 g-n
    in let i11 = gc cmd i9 x0 y s name-col 11 g-d
