    in let s = txt-sz
    in gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd (gc cmd idx x0 b s banner-col 0 g-u) x0 b s banner-col 1 g-s) x0 b s banner-col 2 g-a) x0 b s banner-col 4 g-d2) x0 b s banner-col 5 g-d5) x0 b s banner-col 6 g-d0) x0 b s banner-col 8 g-dot) x0 b s banner-col 10 g-d1) x0 b s banner-col 11 g-d7) x0 b s banner-col 12 g-d7) x0 b s banner-col 13 g-d6) x0 b s banner-col 14 g-dash) x0 b s banner-col 15 g-d2) x0 b s banner-col 16 g-d0) x0 b s banner-col 17 g-d2) x0 b s banner-col 18 g-d6

