 We say:

Section: Theme

  tasks-theme : Theme
  tasks-theme =
    let p = Palette { pal-bg = 1250067, pal-fg = #D8D8D8, pal-primary = 6865407, pal-secondary = #1B1B1B, pal-accent = 6865407, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #262626 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 6) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "tasks-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  tasks-css : Text
  tasks-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#131320;color:#d8d8d8;font-family:system-ui,sans-serif;height:100vh;overflow:hidden}#app{display:flex;flex-direction:column;height:100vh}"
    & ".board-hdr{padding:16px 24px;background:#1a1a2e;border-bottom:1px solid #262640;display:flex;align-items:center;gap:16px}"
    & ".board-hdr h1{font-size:20px;font-weight:600;color:#d8d8d8}"
    & ".board-hdr .wk-btn,.board-hdr button{background:#6868ff;color:#fff;border:none;padding:8px 16px;border-radius:6px;font-size:13px;cursor:pointer}"
    & ".board{flex:1;display:flex;gap:16px;padding:20px 24px;overflow-x:auto}"
    & ".column{width:300px;flex-shrink:0;background:#1a1a2e;border-radius:12px;display:flex;flex-direction:column;max-height:100%}"
    & ".col-hdr{padding:14px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #262640}"
    & ".col-title{font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px}"
    & ".col-count{background:#262640;color:#888;font-size:11px;padding:2px 8px;border-radius:10px}"
    & ".col-cards{flex:1;padding:8px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}"
    & ".card{background:#222240;border-radius:8px;padding:12px;cursor:pointer;transition:background .15s,transform .15s;border-left:3px solid transparent}"
    & ".card:hover{background:#2a2a4a;transform:translateY(-1px)}"
    & ".card.priority-high{border-left-color:#e74c3c}"
    & ".card.priority-med{border-left-color:#f0a030}"
    & ".card.priority-low{border-left-color:#3c8c5f}"
    & ".card-title{font-size:13px;font-weight:600;margin-bottom:6px}"
    & ".card-desc{font-size:12px;color:#888;line-height:1.4;margin-bottom:8px}"
    & ".card-footer{display:flex;align-items:center;justify-content:space-between}"
    & ".card-tag{font-size:10px;padding:2px 8px;border-radius:4px;background:#262640;color:#aaa}"
    & ".card-avatar{width:24px;height:24px;border-radius:50%;background:#6868ff;font-size:10px;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold}"
    & ".add-card{padding:8px 16px;color:#666;font-size:13px;cursor:pointer;text-align:center;border-radius:6px;transition:background .15s}"
    & ".add-card:hover{background:#222240;color:#aaa}"
    & "dialog.wk-dialog{background:#1a1a2e;color:#d8d8d8;border:1px solid #333;border-radius:12px;padding:24px;max-width:400px;width:90%}"
    & "dialog.wk-dialog::backdrop{background:rgba(0,0,0,.7)}"
    & "dialog.wk-dialog h3{margin-bottom:8px}dialog.wk-dialog p{color:#999;margin-bottom:16px;font-size:14px}"
    & "dialog.wk-dialog input{width:100%;background:#222240;border:1px solid #333;border-radius:8px;padding:10px;color:#d8d8d8;font-size:14px;outline:none;margin-bottom:8px}"
    & "dialog.wk-dialog .wk-row{display:flex}dialog.wk-dialog .wk-btn{padding:8px 20px;border-radius:6px;border:none;cursor:pointer;font-size:14px;background:#6868ff;color:#fff;margin-left:8px}"
    & "dialog.wk-dialog .wk-btn:first-child{background:#333;color:#d8d8d8}"
    & ".filter-bar{display:flex;align-items:center;gap:8px;padding:8px 24px;background:#15152a;border-bottom:1px solid #262640}"
    & ".filter-bar .filter-btn{background:#262640;color:#aaa;border:none;padding:6px 14px;border-radius:6px;font-size:12px;cursor:pointer;transition:background .15s}"
    & ".filter-bar .filter-btn:hover{background:#333360}"
    & ".filter-bar .filter-btn.active{background:#6868ff;color:#fff}"
    & ".search-box{background:#222240;border:1px solid #333;border-radius:6px;padding:6px 12px;color:#d8d8d8;font-size:13px;outline:none;width:200px}"
    & ".completion-bar{display:flex;align-items:center;gap:8px;margin-left:auto}"
    & ".completion-track{width:120px;height:6px;background:#262640;border-radius:3px;overflow:hidden}"
    & ".completion-fill{height:100%;background:#41AF4E;border-radius:3px;transition:width .3s}"
    & ".completion-text{font-size:12px;color:#888}"
    & ".detail-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:100}"
    & ".detail-card{background:#1a1a2e;border-radius:12px;padding:24px;width:480px;max-width:90%;border:1px solid #333}"
    & ".detail-card h2{font-size:18px;margin-bottom:12px;color:#fff}"
    & ".detail-card .detail-row{display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:13px;color:#aaa}"
    & ".detail-card .detail-row .detail-label{color:#666;min-width:80px}"
    & ".detail-card .detail-desc{font-size:13px;color:#999;line-height:1.5;margin-bottom:16px;padding:12px;background:#222240;border-radius:8px}"
    & ".detail-card .detail-actions{display:flex;gap:8px;margin-top:16px}"
    & ".detail-card .detail-actions button,.detail-card .detail-actions .wk-btn{padding:8px 16px;border-radius:6px;border:none;cursor:pointer;font-size:13px}"
    & ".detail-btn-close{background:#333;color:#d8d8d8}"
    & ".detail-btn-advance{background:#41AF4E;color:#fff}"
    & ".detail-btn-regress{background:#f0a030;color:#fff}"
    & ".card-due{font-size:10px;color:#888;margin-top:4px}"
    & ".card-overdue{color:#e74c3c;font-weight:600}"
    & ".tag-bug{background:#3c1515;color:#e74c3c}"
    & ".tag-feature{background:#152a3c;color:#5599dd}"
    & ".tag-design{background:#2a1540;color:#aa77ee}"
    & ".tag-crypto{background:#1a2a15;color:#55cc55}"
    & ".tag-enhancement{background:#2a2515;color:#ddaa44}"
    & ".tag-research{background:#152a2a;color:#55aaaa}"
    & ".tag-review{background:#2a2a15;color:#cccc55}"
    & ".tag-milestone{background:#1a1a3c;color:#8888ff}"
    & ".tag-test{background:#152a15;color:#55dd55}"
    & ".tag-ui{background:#2a153c;color:#cc77ff}"
    & ".tag-new{background:#262640;color:#aaa}"
    & ".archive-btn{background:#333;color:#aaa;border:none;padding:6px 14px;border-radius:6px;font-size:12px;cursor:pointer}"
    & ".archive-btn:hover{background:#442222;color:#e74c3c}"
    & ".detail-edit-row{display:flex;gap:8px;margin-bottom:12px}"
    & ".detail-edit-btn{background:#262640;color:#aaa;border:none;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer;transition:background .15s}"
    & ".detail-edit-btn:hover{background:#333360;color:#ddd}"
    & ".detail-btn-delete{background:#3c1515;color:#e74c3c}"
    & ".detail-btn-delete:hover{background:#5c2525;color:#ff6666}"
    & ".overdue-badge{color:#e74c3c;font-weight:600;font-size:10px}"
    & ".completion-bar .wk-gauge{width:120px;height:6px;appearance:none;border:none;border-radius:3px;background:#262640}"
    & ".completion-bar .wk-gauge::-webkit-progress-bar{background:#262640;border-radius:3px}"
    & ".completion-bar .wk-gauge::-webkit-progress-value{background:#41AF4E;border-radius:3px}"
    & ".completion-bar .wk-gauge::-moz-progress-bar{background:#41AF4E;border-radius:3px}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let total = total-tasks 0
    in let done-count = state-get "col-count-4"
    in let pct = if total == 0 then 0 else (done-count * 100) / total
    in let detail = state-get "show-detail"
    in widget-panel "root" DirColumn 0 [
      widget-box "board-hdr" "board-hdr" [
        widget-label "title" "CodexTasks",
        widget-button "add-task" "+ New Task",
        widget-box "completion-bar" "completion-bar" [
          widget-label "pct-text" (show pct & "% complete (" & show done-count & "/" & show total & ")"),
          widget-gauge "pct-fill" pct 100
        ]
      ],
      filter-bar-tree 0,
      widget-box "board" "board" [
        column-tree "backlog" "Backlog" 0,
        column-tree "todo" "To Do" 1,
        column-tree "progress" "In Progress" 2,
        column-tree "review" "Review" 3,
        column-tree "done" "Done" 4
      ],
      if detail == 1 then detail-overlay-tree 0 else widget-label "no-detail" ""
    ]

  total-tasks : Integer -> Integer
  total-tasks (x) =
    let c0 = state-get "col-count-0"
    in let c1 = state-get "col-count-1"
    in let c2 = state-get "col-count-2"
    in let c3 = state-get "col-count-3"
    in let c4 = state-get "col-count-4"
    in c0 + c1 + c2 + c3 + c4

  filter-bar-tree : Integer -> WidgetNode
  filter-bar-tree (x) =
    let fp = state-get "filter-priority"
    in let search = state-get-text "search-text"
    in widget-box "filter-bar" "filter-bar" [
      widget-label "filter-lbl" "Filter:",
      widget-box-click "fp-all" (if fp == 0 then "filter-btn active" else "filter-btn") [ widget-label "fp-all-l" "All" ],
      widget-box-click "fp-high" (if fp == 1 then "filter-btn active" else "filter-btn") [ widget-label "fp-high-l" "High" ],
      widget-box-click "fp-med" (if fp == 2 then "filter-btn active" else "filter-btn") [ widget-label "fp-med-l" "Medium" ],
      widget-box-click "fp-low" (if fp == 3 then "filter-btn active" else "filter-btn") [ widget-label "fp-low-l" "Low" ],
      widget-input "search-input" search (text-length search),
      widget-box-click "archive-btn" "archive-btn" [ widget-label "archive-lbl" "Archive Done" ]
    ]

  detail-overlay-tree : Integer -> WidgetNode
  detail-overlay-tree (x) =
    let dk = state-get-text "detail-task"
    in let title = state-get-text ("task-title-" & dk)
    in let desc = state-get-text ("task-desc-" & dk)
    in let pri = state-get-text ("task-pri-" & dk)
    in let tag = state-get-text ("task-tag-" & dk)
    in let assignee = state-get-text ("task-assignee-" & dk)
    in let due = state-get-text ("task-due-" & dk)
    in widget-box-click "detail-overlay" "detail-overlay" [
      widget-box "detail-card" "detail-card" [
        widget-label "detail-title" title,
        widget-box "detail-desc-box" "detail-desc" [
          widget-label "detail-desc" (if text-length desc == 0 then "No description." else desc)
        ],
        widget-box "detail-r1" "detail-row" [
          widget-label "dl-pri-l" "Priority:",
          widget-label "dl-pri-v" pri
        ],
        widget-box "detail-r2" "detail-row" [
          widget-label "dl-tag-l" "Label:",
          widget-label "dl-tag-v" tag
        ],
        widget-box "detail-r3" "detail-row" [
          widget-label "dl-asgn-l" "Assignee:",
          widget-label "dl-asgn-v" (if text-length assignee == 0 then "Unassigned" else assignee)
        ],
        widget-box "detail-r4" "detail-row" [
          widget-label "dl-due-l" "Due:",
          widget-label "dl-due-v" (if text-length due == 0 then "No due date" else due)
        ],
        widget-box "detail-edits" "detail-edit-row" [
          widget-box-click "detail-cycle-pri" "detail-edit-btn" [ widget-label "dp-l" ("Priority: " & pri & " &#x21C5;") ],
          widget-box-click "detail-cycle-tag" "detail-edit-btn" [ widget-label "dt-l" ("Label: " & tag & " &#x21C5;") ]
        ],
        widget-box "detail-actions" "detail-actions" [
          widget-box-click "detail-regress" "detail-btn-regress" [ widget-label "dr-l" "&#x2190; Move Back" ],
          widget-box-click "detail-advance" "detail-btn-advance" [ widget-label "da-l" "Move Forward &#x2192;" ],
          widget-box-click "detail-delete" "detail-btn-delete" [ widget-label "dd-l" "&#x1F5D1; Delete" ],
          widget-box-click "detail-close" "detail-btn-close" [ widget-label "dc-l" "Close" ]
        ]
      ]
    ]

  column-tree : Text, Text, Integer -> WidgetNode
  column-tree (id) (title) (col-idx) =
    let count = state-get ("col-count-" & show col-idx)
    in widget-box id "column" [
      widget-box (id & "-hdr") "col-hdr" [
        widget-box (id & "-t") "col-title" [
          widget-label (id & "-tl") title,
          widget-label (id & "-c") (show count)
        ]
      ],
      widget-box (id & "-cards") "col-cards" (build-cards col-idx 0 count []),
      widget-box-click (id & "-add") "add-card" [ widget-label (id & "-al") "+ Add card" ]
    ]

  pri-matches-filter : Text, Integer -> Boolean
  pri-matches-filter (pri) (fp) =
    if fp == 0 then True
    else if fp == 1 then pri == "high"
    else if fp == 2 then pri == "med"
    else pri == "low"

  tag-css-class : Text -> Text
  tag-css-class (tag) =
    if tag == "bug" then "card-tag tag-bug"
    else if tag == "feature" then "card-tag tag-feature"
    else if tag == "design" then "card-tag tag-design"
    else if tag == "crypto" then "card-tag tag-crypto"
    else if tag == "enhancement" then "card-tag tag-enhancement"
    else if tag == "research" then "card-tag tag-research"
    else if tag == "review" then "card-tag tag-review"
    else if tag == "milestone" then "card-tag tag-milestone"
    else if tag == "test" then "card-tag tag-test"
    else if tag == "ui" then "card-tag tag-ui"
    else "card-tag tag-new"

  is-overdue : Text -> Integer
  is-overdue (due) =
    if text-length due < 10 then 0
    else let yr = text-to-int (substring due 0 4)
    in let mo = text-to-int (substring due 5 7)
    in let dy = text-to-int (substring due 8 10)
    in if yr < 2026 then 1
    else if yr > 2026 then 0
    else if mo < 6 then 1
    else if mo > 6 then 0
    else if dy < 19 then 1
    else 0

  build-cards : Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  build-cards (col) (i) (count) (acc) =
    if i >= count then acc
    else let key = show col & "-" & show i
    in let title = state-get-text ("task-title-" & key)
    in let desc = state-get-text ("task-desc-" & key)
    in let tag = state-get-text ("task-tag-" & key)
    in let pri = state-get-text ("task-pri-" & key)
    in let due = state-get-text ("task-due-" & key)
    in let assignee = state-get-text ("task-assignee-" & key)
    in let fp = state-get "filter-priority"
    in let search = state-get-text "search-text"
    in let pri-ok = pri-matches-filter pri fp
    in let text-ok = if text-length search == 0 then True else text-contains title search
    in if pri-ok == False then build-cards col (i + 1) count acc
    else if text-ok == False then build-cards col (i + 1) count acc
    else let avatar-letter = if text-length assignee == 0 then "?" else substring assignee 0 1
    in let overdue = is-overdue due
    in let due-cls = if text-length due == 0 then "card-due" else if overdue == 1 then "card-due card-overdue" else "card-due"
    in let item = widget-box-click ("card-" & key) ("card priority-" & pri) [
      widget-label ("ct-" & key) title,
      widget-label ("cd-" & key) desc,
      widget-box ("cf-" & key) "card-footer" [
        widget-box ("cg-" & key) (tag-css-class tag) [widget-label ("cgt-" & key) tag],
        widget-add-child (widget-custom ("cv-" & key) "box:card-avatar" 0 0) (widget-label ("cvl-" & key) avatar-letter)
      ],
      if text-length due > 0 then widget-box ("cdue-" & key) due-cls [widget-label ("cdut-" & key) ((if overdue == 1 then "&#x26A0; " else "") & due)] else widget-label ("cdue-" & key) ""
    ]
    in build-cards col (i + 1) count (list-push acc item)

