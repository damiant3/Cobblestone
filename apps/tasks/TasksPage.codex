    in let t38 = state-set-text "task-desc-4-1" "All tests pass including poison build and REPL batch"
    in let t39 = state-set-text "task-tag-4-1" "test"
    in let t40 = state-set-text "task-pri-4-1" "high"
    in let t40a = state-set-text "task-assignee-4-1" "Damian"
    in let t40b = state-set-text "task-due-4-1" "2026-05-15"
    in 0

Section: Handlers

  tasks-click : Text -> Integer
  tasks-click (id) =
    if id == "add-task" then show-prompt "New Task" "Task title:" "task name" add-cb-1
    else if id == "backlog-add" then show-prompt "Add to Backlog" "Task title:" "task name" add-cb-0
    else if id == "todo-add" then show-prompt "Add to To Do" "Task title:" "task name" add-cb-1
    else if id == "progress-add" then show-prompt "Add to In Progress" "Task title:" "task name" add-cb-2
    else if id == "review-add" then show-prompt "Add to Review" "Task title:" "task name" add-cb-3
    else if id == "done-add" then show-prompt "Add to Done" "Task title:" "task name" add-cb-4
    else if id == "fp-all" then let s = state-set-render "filter-priority" 0 in 0
    else if id == "fp-high" then let s = state-set-render "filter-priority" 1 in 0
    else if id == "fp-med" then let s = state-set-render "filter-priority" 2 in 0
    else if id == "fp-low" then let s = state-set-render "filter-priority" 3 in 0
    else if id == "detail-close" then let s = state-set-render "show-detail" 0 in 0
    else if id == "detail-overlay" then let s = state-set-render "show-detail" 0 in 0
    else if id == "detail-advance" then advance-task 0
    else if id == "detail-regress" then regress-task 0
    else if id == "archive-btn" then archive-done 0
    else if id == "detail-delete" then delete-detail-task 0
    else if id == "detail-cycle-pri" then cycle-detail-priority 0
    else if id == "detail-cycle-tag" then cycle-detail-tag 0
    else if text-length id > 5 then if substring id 0 5 == "card-" then open-card-detail (substring id 5 (text-length id)) else 0
    else 0

  tasks-input : Text, Text -> Integer
  tasks-input (id) (value) =
    if id == "search-input" then let s = state-set-text-render "search-text" value in 0
    else 0

  open-card-detail : Text -> Integer
  open-card-detail (key) =
    let s1 = state-set-text "detail-task" key
    in let s2 = state-set-render "show-detail" 1
    in 0

  find-col-of-key : Text -> Integer
  find-col-of-key (key) =
    if text-length key >= 3 then let col-char = substring key 0 1
      in if col-char == "0" then 0
      else if col-char == "1" then 1
      else if col-char == "2" then 2
      else if col-char == "3" then 3
      else if col-char == "4" then 4
      else (-1)
    else (-1)

  find-idx-of-key : Text -> Integer
  find-idx-of-key (key) =
    if text-length key >= 3 then let idx-str = substring key 2 (text-length key)
      in text-to-int idx-str
    else (-1)

  copy-task-state : Text, Text -> Integer
  copy-task-state (from-key) (to-key) =
    let t1 = state-set-text ("task-title-" & to-key) (state-get-text ("task-title-" & from-key))
    in let t2 = state-set-text ("task-desc-" & to-key) (state-get-text ("task-desc-" & from-key))
    in let t3 = state-set-text ("task-tag-" & to-key) (state-get-text ("task-tag-" & from-key))
    in let t4 = state-set-text ("task-pri-" & to-key) (state-get-text ("task-pri-" & from-key))
    in let t5 = state-set-text ("task-assignee-" & to-key) (state-get-text ("task-assignee-" & from-key))
    in let t6 = state-set-text ("task-due-" & to-key) (state-get-text ("task-due-" & from-key))
    in 0

  shift-tasks-down : Integer, Integer, Integer -> Integer
  shift-tasks-down (col) (from) (count) =
    if from >= count then 0
    else let src = show col & "-" & show (from + 1)
    in let dst = show col & "-" & show from
    in if (from + 1) >= count then 0
    else let c = copy-task-state src dst
    in shift-tasks-down col (from + 1) count

  advance-task : Integer -> Integer
  advance-task (x) =
    let dk = state-get-text "detail-task"
    in let col = find-col-of-key dk
    in let idx = find-idx-of-key dk
    in if col >= 4 then 0
    else let dest-col = col + 1
    in let dest-count = state-get ("col-count-" & show dest-col)
    in let dest-key = show dest-col & "-" & show dest-count
    in let c1 = copy-task-state dk dest-key
    in let s1 = state-set ("col-count-" & show dest-col) (dest-count + 1)
    in let src-count = state-get ("col-count-" & show col)
    in let sh = shift-tasks-down col idx src-count
    in let s2 = state-set ("col-count-" & show col) (src-count - 1)
    in let new-key = dest-key
    in let s3 = state-set-text "detail-task" new-key
    in let s4 = state-set-render "show-detail" 1
    in 0

  regress-task : Integer -> Integer
  regress-task (x) =
    let dk = state-get-text "detail-task"
    in let col = find-col-of-key dk
    in let idx = find-idx-of-key dk
    in if col <= 0 then 0
    else let dest-col = col - 1
    in let dest-count = state-get ("col-count-" & show dest-col)
    in let dest-key = show dest-col & "-" & show dest-count
    in let c1 = copy-task-state dk dest-key
    in let s1 = state-set ("col-count-" & show dest-col) (dest-count + 1)
    in let src-count = state-get ("col-count-" & show col)
    in let sh = shift-tasks-down col idx src-count
    in let s2 = state-set ("col-count-" & show col) (src-count - 1)
    in let new-key = dest-key
    in let s3 = state-set-text "detail-task" new-key
    in let s4 = state-set-render "show-detail" 1
    in 0

  cycle-detail-priority : Integer -> Integer
  cycle-detail-priority (x) =
    let dk = state-get-text "detail-task"
    in let pri = state-get-text ("task-pri-" & dk)
    in let next = if pri == "low" then "med" else if pri == "med" then "high" else "low"
    in let s = state-set-text ("task-pri-" & dk) next
    in let s2 = state-set-render "show-detail" 1
    in 0

  cycle-detail-tag : Integer -> Integer
  cycle-detail-tag (x) =
    let dk = state-get-text "detail-task"
    in let tag = state-get-text ("task-tag-" & dk)
    in let next = if tag == "new" then "bug"
      else if tag == "bug" then "feature"
      else if tag == "feature" then "design"
      else if tag == "design" then "enhancement"
      else if tag == "enhancement" then "crypto"
      else if tag == "crypto" then "research"
      else if tag == "research" then "review"
      else if tag == "review" then "test"
      else if tag == "test" then "ui"
      else if tag == "ui" then "milestone"
      else "new"
    in let s = state-set-text ("task-tag-" & dk) next
    in let s2 = state-set-render "show-detail" 1
    in 0

  delete-detail-task : Integer -> Integer
  delete-detail-task (x) =
    let dk = state-get-text "detail-task"
    in let col = find-col-of-key dk
    in let idx = find-idx-of-key dk
    in if col < 0 then 0
    else let src-count = state-get ("col-count-" & show col)
    in let sh = shift-tasks-down col idx src-count
    in let s1 = state-set ("col-count-" & show col) (src-count - 1)
    in let s2 = state-set-render "show-detail" 0
    in 0

  clear-col-tasks : Integer, Integer, Integer -> Integer
  clear-col-tasks (col) (i) (count) =
    if i >= count then 0
    else let key = show col & "-" & show i
    in let s1 = state-set-text ("task-title-" & key) ""
    in let s2 = state-set-text ("task-desc-" & key) ""
    in let s3 = state-set-text ("task-tag-" & key) ""
    in let s4 = state-set-text ("task-pri-" & key) ""
    in let s5 = state-set-text ("task-assignee-" & key) ""
    in let s6 = state-set-text ("task-due-" & key) ""
    in clear-col-tasks col (i + 1) count

  archive-done : Integer -> Integer
  archive-done (x) =
    let count = state-get "col-count-4"
    in let c = clear-col-tasks 4 0 count
    in let s = state-set-render "col-count-4" 0
    in 0

  add-to-col : Integer, Text -> Integer
  add-to-col (col) (name) =
    if name == "" then 0
    else let count = state-get ("col-count-" & show col)
    in let key = show col & "-" & show count
    in let s1 = state-set-text ("task-title-" & key) name
    in let s2 = state-set-text ("task-desc-" & key) ""
    in let s3 = state-set-text ("task-tag-" & key) "new"
    in let s4 = state-set-text ("task-pri-" & key) "med"
    in let s5 = state-set-text ("task-assignee-" & key) ""
    in let s6 = state-set-text ("task-due-" & key) ""
    in let s7 = state-set-render ("col-count-" & show col) (count + 1)
    in 0

  add-cb-0 : Text -> Integer
  add-cb-0 (name) = add-to-col 0 name
  add-cb-1 : Text -> Integer
  add-cb-1 (name) = add-to-col 1 name
  add-cb-2 : Text -> Integer
  add-cb-2 (name) = add-to-col 2 name
  add-cb-3 : Text -> Integer
  add-cb-3 (name) = add-to-col 3 name
  add-cb-4 : Text -> Integer
  add-cb-4 (name) = add-to-col 4 name

Section: Entry

  render-tasks : Integer -> Integer
  render-tasks (x) = mount-widget-themed tasks-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style tasks-theme tasks-css
    in let s = set-render render-tasks
    in let h = register-handlers no-pick tasks-click
    in let hi = register-input-handler tasks-input
    in let d = load-sample-tasks 0
    in render-tasks 0
  end

Page 1
