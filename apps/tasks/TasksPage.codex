 Kanban task board with columns and drag-style cards.

 We say:

Section: Theme

  tasks-theme : Theme
  tasks-theme =
    let p = Palette { pal-bg = 1250067, pal-fg = 14211288, pal-primary = 6865407, pal-secondary = 1776411, pal-accent = 6865407, pal-muted = 7829367, pal-error = 15486256, pal-success = 4304718, pal-warning = 16750848, pal-border = 2500134 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 6) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "tasks-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  tasks-css : Text
  tasks-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#131320;color:#d8d8d8;font-family:system-ui,sans-serif;height:100vh;overflow:hidden}#app{display:flex;flex-direction:column;height:100vh}"
    & ".board-hdr{padding:16px 24px;background:#1a1a2e;border-bottom:1px solid #262640;display:flex;align-items:center;gap:16px}"
    & ".board-hdr h1{font-size:20px;font-weight:600;color:#d8d8d8}"
    & ".board-hdr .wk-btn,.board-hdr button{background:#6868ff;color:#fff;border:none;padding:8px 16px;border-radius:6px;font-size:13px;cursor:pointer}"
    & ".board{flex:1;display:flex;gap:16px;padding:20px 24px;overflow-x:auto}"
    & ".column{width:300px;flex-shrink:0;background:#1a1a2e;border-radius:12px;display:flex;flex-direction:column;max-height:100%}"
    & ".col-hdr{padding:14px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #262640}"
    & ".col-title{font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px}"
    & ".col-count{background:#262640;color:#888;font-size:11px;padding:2px 8px;border-radius:10px}"
    & ".col-cards{flex:1;padding:8px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}"
    & ".card{background:#222240;border-radius:8px;padding:12px;cursor:pointer;transition:background .15s,transform .15s;border-left:3px solid transparent}"
    & ".card:hover{background:#2a2a4a;transform:translateY(-1px)}"
    & ".card.priority-high{border-left-color:#e74c3c}"
    & ".card.priority-med{border-left-color:#f0a030}"
    & ".card.priority-low{border-left-color:#3c8c5f}"
    & ".card-title{font-size:13px;font-weight:600;margin-bottom:6px}"
    & ".card-desc{font-size:12px;color:#888;line-height:1.4;margin-bottom:8px}"
    & ".card-footer{display:flex;align-items:center;justify-content:space-between}"
    & ".card-tag{font-size:10px;padding:2px 8px;border-radius:4px;background:#262640;color:#aaa}"
    & ".card-avatar{width:24px;height:24px;border-radius:50%;background:#6868ff;font-size:10px;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold}"
    & ".add-card{padding:8px 16px;color:#666;font-size:13px;cursor:pointer;text-align:center;border-radius:6px;transition:background .15s}"
    & ".add-card:hover{background:#222240;color:#aaa}"
    & "dialog.wk-dialog{background:#1a1a2e;color:#d8d8d8;border:1px solid #333;border-radius:12px;padding:24px;max-width:400px;width:90%}"
    & "dialog.wk-dialog::backdrop{background:rgba(0,0,0,.7)}"
    & "dialog.wk-dialog h3{margin-bottom:8px}dialog.wk-dialog p{color:#999;margin-bottom:16px;font-size:14px}"
    & "dialog.wk-dialog input{width:100%;background:#222240;border:1px solid #333;border-radius:8px;padding:10px;color:#d8d8d8;font-size:14px;outline:none;margin-bottom:8px}"
    & "dialog.wk-dialog .wk-row{display:flex}dialog.wk-dialog .wk-btn{padding:8px 20px;border-radius:6px;border:none;cursor:pointer;font-size:14px;background:#6868ff;color:#fff;margin-left:8px}"
    & "dialog.wk-dialog .wk-btn:first-child{background:#333;color:#d8d8d8}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-panel "root" DirColumn 0 [
      widget-box "board-hdr" "board-hdr" [
        widget-label "title" "CodexTasks",
        widget-button "add-task" "+ New Task"
      ],
      widget-box "board" "board" [
        column-tree "backlog" "Backlog" 0,
        column-tree "todo" "To Do" 1,
        column-tree "progress" "In Progress" 2,
        column-tree "review" "Review" 3,
        column-tree "done" "Done" 4
      ]
    ]

  column-tree : Text, Text, Integer -> WidgetNode
  column-tree (id) (title) (col-idx) =
    let count = state-get ("col-count-" & show col-idx)
    in widget-box id "column" [
      widget-box (id & "-hdr") "col-hdr" [
        widget-box (id & "-t") "col-title" [
          widget-label (id & "-tl") title,
          widget-label (id & "-c") (show count)
        ]
      ],
      widget-box (id & "-cards") "col-cards" (build-cards col-idx 0 count []),
      widget-box-click (id & "-add") "add-card" [ widget-label (id & "-al") "+ Add card" ]
    ]

  build-cards : Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  build-cards (col) (i) (count) (acc) =
    if i >= count then acc
    else let key = show col & "-" & show i
    in let title = state-get-text ("task-title-" & key)
    in let desc = state-get-text ("task-desc-" & key)
    in let tag = state-get-text ("task-tag-" & key)
    in let pri = state-get-text ("task-pri-" & key)
    in let item = widget-box ("card-" & key) ("card priority-" & pri) [
      widget-label ("ct-" & key) title,
      widget-label ("cd-" & key) desc,
      widget-box ("cf-" & key) "card-footer" [
        widget-label ("cg-" & key) tag,
        widget-add-child (widget-custom ("cv-" & key) "box:card-avatar" 0 0) (widget-label ("cvl-" & key) "D")
      ]
    ]
    in build-cards col (i + 1) count (list-push acc item)

