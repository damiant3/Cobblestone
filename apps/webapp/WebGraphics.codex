Chapter: WebGraphics
  cites UI chapter Charts
  cites UI chapter Vector

Section: Svg

  mount-svg : Text, Integer, Integer -> Integer
  mount-svg (id) (w) (h) = 0
  svg-draw-cmds : Text, List DrawCmd -> Integer
  svg-draw-cmds (id) (cmds) = 0
  svg-label : Text, Text -> Integer
  svg-label (id) (label) = 0
  svg-fill-path : Text, VecPath, Integer -> Integer
  svg-fill-path (id) (p) (color) = 0
  svg-stroke-path : Text, VecPath, Integer, Integer -> Integer
  svg-stroke-path (id) (p) (width) (color) = 0

Section: Charts

  web-then : Integer, Integer -> Integer
  web-then (first) (second) = second

  mount-chart : Text, Chart -> Integer
  mount-chart (id) (c) = web-then (mount-svg id (c.ch-width) (c.ch-height)) (web-then (svg-label id (c.ch-title)) (svg-draw-cmds id (chart-render c)))