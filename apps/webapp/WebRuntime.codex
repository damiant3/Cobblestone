Chapter: WebRuntime
  cites UI chapter Theme
  cites UI chapter Widget

Section: Dom

  DomElement = record { dom-id : Integer }
  dom-null : DomElement = DomElement { dom-id = 0 }
  dom-get : Text -> DomElement
  dom-get (id) = dom-null
  dom-create : Text -> DomElement
  dom-create (tag) = dom-null
  dom-set-text : DomElement, Text -> DomElement
  dom-set-text (el) (s) = el
  dom-append : DomElement, DomElement -> DomElement
  dom-append (parent) (child) = parent
  dom-query : Text -> DomElement
  dom-query (sel) = dom-null
  dom-get-value : DomElement -> Text
  dom-get-value (el) = ""
  dom-set-html : DomElement, Text -> DomElement
  dom-set-html (el) (s) = el
  dom-on-click : DomElement, (Text -> Integer) -> DomElement
  dom-on-click (el) (cb) = el
  dom-on-input : DomElement, (Text -> Integer) -> DomElement
  dom-on-input (el) (cb) = el
  dom-on-key : DomElement, (Text -> Integer) -> DomElement
  dom-on-key (el) (cb) = el
  dom-click : DomElement -> DomElement
  dom-click (el) = el
  audio-on-position : DomElement, (Integer -> Integer) -> DomElement
  audio-on-position (el) (cb) = el
  audio-seek : DomElement, Integer -> DomElement
  audio-seek (el) (position) = el
  image-pixels-then : Text, Integer, Integer, (List Integer -> Integer) -> Integer
  image-pixels-then (name) (w) (h) (cb) = 0
  texture-pixels-then : Text, Integer, Integer, (List Integer -> Integer) -> Integer
  texture-pixels-then (name) (w) (h) (cb) = 0
  canvas-pixels : DomElement, Integer, Integer, List Integer -> DomElement
  canvas-pixels (el) (w) (h) (pixels) = el
  media-seek-ms : DomElement, Integer -> DomElement
  media-seek-ms (el) (ms) = el
  media-pause : DomElement -> DomElement
  media-pause (el) = el
  media-play-then : DomElement, (Text -> Integer) -> Integer
  media-play-then (el) (cb) = 0

