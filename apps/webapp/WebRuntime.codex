Chapter: WebRuntime
  cites UI chapter Theme
  cites UI chapter Widget

 The single copy of the JS-bridge stub contract for browser apps built
 through the HTML plug. Each definition below is a Codex-typed signature
 for a function the plug's runtime provides in JavaScript. The plug
 skips these definitions at emit time and routes calls to the runtime;
 the bodies exist only to satisfy the type checker. The names are the
 contract: HtmlEmitter matches them in is-html-builtin, in order to bind
 a call site to the browser runtime. Adding a runtime primitive means
 adding the JS to HtmlEmitter, adding the stub here, and regenerating —
 never copying stubs into an app chapter.

Section: Dom

  DomElement = record { dom-id : Integer }
  dom-null : DomElement = DomElement { dom-id = 0 }
  dom-get : Text -> DomElement
  dom-get (id) = dom-null
  dom-create : Text -> DomElement
  dom-create (tag) = dom-null
  dom-set-text : DomElement, Text -> DomElement
  dom-set-text (el) (s) = el
  dom-append : DomElement, DomElement -> DomElement
  dom-append (parent) (child) = parent
  dom-query : Text -> DomElement
  dom-query (sel) = dom-null
  dom-get-value : DomElement -> Integer
  dom-get-value (el) = 0
  dom-set-html : DomElement, Text -> DomElement
  dom-set-html (el) (s) = el
  dom-on-click : DomElement, (Text -> Integer) -> DomElement
  dom-on-click (el) (cb) = el
  dom-on-input : DomElement, (Text -> Integer) -> DomElement
  dom-on-input (el) (cb) = el
  dom-on-key : DomElement, (Text -> Integer) -> DomElement
  dom-on-key (el) (cb) = el

Section: State

  state-get : Text -> Integer
  state-get (k) = 0
  state-set : Text, Integer -> Integer
  state-set (k) (v) = v
  state-get-text : Text -> Text
  state-get-text (k) = ""
  state-set-text : Text, Text -> Text
  state-set-text (k) (v) = v
  state-set-render : Text, Integer -> Integer
  state-set-render (k) (v) = v
  state-set-text-render : Text, Text -> Text
  state-set-text-render (k) (v) = v
  request-render : Integer -> Integer
  request-render (x) = 0
  local-storage-get : Text -> Text
  local-storage-get (k) = ""
  local-storage-set : Text, Text -> Integer
  local-storage-set (k) (v) = 0
  clipboard-write : Text -> Integer
  clipboard-write (text) = 0
  fetch-get-then : Text, (Text -> Integer) -> Integer
  fetch-get-then (url) (cb) = 0

Section: Mount

  register-handlers : (Text, Integer -> Integer), (Text -> Integer) -> Integer
  register-handlers (on-pick) (on-click) = 0
  register-input-handler : (Text, Text -> Integer) -> Integer
  register-input-handler (on-input) = 0
  set-render : (Integer -> Integer) -> Integer
  set-render (fn) = 0
  inject-theme-css : Theme -> Integer
  inject-theme-css (th) = 0
  mount-widget-themed : Theme, WidgetNode -> Integer
  mount-widget-themed (th) (n) = 0
  mount-widget-into : Text, WidgetNode -> Integer
  mount-widget-into (id) (n) = 0

Section: Channels

  play-tone : Integer, Integer, Integer -> Integer
  play-tone (freq) (ms) (wave) = 0
  show-prompt : Text, Text, Text, (Text -> Integer) -> Integer
  show-prompt (t) (m) (p) (cb) = 0
  set-timeout : (Integer -> Integer), Integer -> Integer
  set-timeout (fn) (ms) = 0
