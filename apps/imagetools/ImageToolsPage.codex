 We say:

Section: Theme

  imagetools-theme : Theme
  imagetools-theme =
    let p = Palette { pal-bg = #111111, pal-fg = #E1E1E1, pal-primary = 43775, pal-secondary = #1B1B1B, pal-accent = 43775, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #262626 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "imagetools-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  imagetools-css : Text
  imagetools-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#111;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".imgtools{display:grid;grid-template-columns:1fr 300px;min-height:100vh}"
    & ".workspace{display:flex;flex-direction:column;background:#0d0d0d}"
    & ".ws-toolbar{display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid #222;background:#141414}"
    & ".ws-toolbar .wk-btn{background:#222;border:1px solid #333;color:#ccc;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".ws-toolbar .wk-btn:hover{background:#2a2a2a}"
    & ".ws-brand{font-size:16px;font-weight:700;color:#00aaff;margin-right:16px}"
    & ".ws-sep{width:1px;height:20px;background:#333}"
    & ".ws-canvas{flex:1;display:flex;align-items:center;justify-content:center;overflow:auto;padding:24px}"
    & ".preview-img{background:#1a1a1a;border:1px dashed #333;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:120px;width:640px;height:400px;position:relative}"
    & ".preview-empty{display:flex;flex-direction:column;align-items:center;gap:12px;color:#444}"
    & ".preview-empty-icon{font-size:64px}"
    & ".preview-empty-text{font-size:15px}"
    & ".preview-empty-hint{font-size:12px;color:#333}"
    & ".ws-footer{display:flex;align-items:center;justify-content:space-between;padding:6px 16px;border-top:1px solid #222;background:#141414;font-size:11px;color:#555}"
    & ".panel{background:#141414;border-left:1px solid #222;padding:0;overflow-y:auto;display:flex;flex-direction:column}"
    & ".panel-section{padding:16px;border-bottom:1px solid #1a1a1a}"
    & ".panel-title{font-size:12px;color:#555;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}"
    & ".panel-row{display:flex;gap:8px;margin-bottom:8px;align-items:center}"
    & ".panel-lbl{font-size:11px;color:#666;min-width:50px}"
    & ".panel-val{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:5px 8px;color:#ccc;font-size:12px;flex:1;text-align:center}"
    & ".panel-unit{font-size:10px;color:#555;min-width:16px}"
    & ".link-icon{color:#00aaff;cursor:pointer;font-size:14px}"
    & ".aspect-btns{display:flex;gap:4px;flex-wrap:wrap}"
    & ".aspect-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:5px 10px;font-size:11px;color:#888;cursor:pointer}"
    & ".aspect-btn:hover{border-color:#00aaff;color:#ccc}"
    & ".aspect-btn.active{border-color:#00aaff;background:#0a1a2a;color:#00aaff}"
    & ".rotate-btns{display:flex;gap:6px}"
    & ".rotate-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px 14px;font-size:14px;color:#888;cursor:pointer}"
    & ".rotate-btn:hover{border-color:#00aaff;color:#ccc}"
    & ".slider-row{display:flex;align-items:center;gap:8px}"
    & ".slider{flex:1;height:4px;background:#2a2a2a;border-radius:2px;position:relative}"
    & ".slider-fill{height:100%;background:#00aaff;border-radius:2px;width:50%}"
    & ".slider-val{font-size:11px;color:#888;min-width:32px;text-align:right}"
    & ".format-btns{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}"
    & ".format-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px;text-align:center;cursor:pointer;font-size:12px;color:#888}"
    & ".format-btn:hover{border-color:#00aaff;color:#ccc}"
    & ".format-btn.active{border-color:#00aaff;background:#0a1a2a;color:#00aaff}"
    & ".export-btn{width:100%;background:#00aaff;color:#fff;border:none;padding:10px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-top:8px}"
    & ".export-btn:hover{background:#0099ee}"
    & ".batch-drop{border:2px dashed #2a2a2a;border-radius:8px;padding:20px;text-align:center;color:#444;font-size:13px;cursor:pointer;margin-top:8px}"
    & ".batch-drop:hover{border-color:#00aaff;color:#666}"
    & ".batch-info{display:flex;justify-content:space-between;font-size:11px;color:#666;margin-top:8px}"
    & ".batch-bar{height:4px;background:#2a2a2a;border-radius:2px;margin-top:6px}"
    & ".batch-bar-fill{height:100%;background:#00aaff;border-radius:2px;width:0%}"
    & ".histo-section{padding:16px;border-bottom:1px solid #1a1a1a}"
    & ".histo-bar-row{display:flex;align-items:center;gap:6px;margin-bottom:6px}"
    & ".histo-ch{font-size:11px;font-weight:700;min-width:14px}"
    & ".histo-ch-r{color:#ff4444}"
    & ".histo-ch-g{color:#44cc44}"
    & ".histo-ch-b{color:#4488ff}"
    & ".histo-ch-l{color:#cccccc}"
    & ".histo-bar{flex:1;height:8px;background:#1a1a1a;border-radius:3px;overflow:hidden}"
    & ".histo-fill{height:100%;border-radius:3px}"
    & ".histo-fill-r{background:#ff4444;width:62%}"
    & ".histo-fill-g{background:#44cc44;width:48%}"
    & ".histo-fill-b{background:#4488ff;width:71%}"
    & ".histo-fill-l{background:#cccccc;width:55%}"
    & ".histo-val{font-size:10px;color:#666;min-width:28px;text-align:right}"
    & ".picker-section{padding:16px;border-bottom:1px solid #1a1a1a}"
    & ".picker-swatch{width:32px;height:32px;border-radius:6px;border:1px solid #333;background:#00aaff}"
    & ".picker-hex{font-size:13px;color:#ccc;font-family:monospace}"
    & ".picker-rgb{font-size:11px;color:#666}"
    & ".meta-row{display:flex;justify-content:space-between;font-size:11px;color:#666;padding:2px 0}"
    & ".meta-val{color:#aaa}"
    & ".compare-active{background:#0a1a2a !important;border-color:#00aaff !important;color:#00aaff !important}"
    & ".compare-split{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;gap:16px;font-size:12px;color:#555}"
    & ".compare-split span{padding:4px 12px;border:1px solid #333;border-radius:4px}"
    & ".ruler-active{background:#0a1a2a !important;border-color:#00aaff !important;color:#00aaff !important}"
    & ".grid-active{background:#0a1a2a !important;border-color:#00aaff !important;color:#00aaff !important}"
    & ".filter-row{display:flex;align-items:center;gap:6px;margin-bottom:8px}"
    & ".filter-lbl{font-size:11px;color:#666;min-width:55px}"
    & ".filter-val{font-size:11px;color:#888;min-width:24px;text-align:center}"
    & ".filter-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:4px;padding:3px 8px;font-size:12px;color:#888;cursor:pointer}"
    & ".filter-btn:hover{border-color:#00aaff;color:#ccc}"
    & ".wmark-section{padding:16px;border-bottom:1px solid #1a1a1a}"
    & ".wmark-preview{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px 12px;font-size:12px;color:#666;font-style:italic;margin-bottom:8px}"
    & ".preset-btns{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}"
    & ".preset-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px;text-align:center;cursor:pointer;font-size:11px;color:#888}"
    & ".preset-btn:hover{border-color:#00aaff;color:#ccc}"
    & ".paste-status{font-size:11px;color:#00aaff;margin-left:8px}"
    & ".preset-btn.active{border-color:#00aaff;background:#0a1a2a;color:#00aaff}"
    & ".slider-row{display:flex;align-items:center;gap:6px;margin-bottom:8px}"
    & ".slider-row .slider-val{min-width:36px}"
    & ".slider-row .wk-gauge{flex:1;height:4px;appearance:none;border:none;border-radius:2px;background:#2a2a2a}"
    & ".slider-row .wk-gauge::-webkit-progress-bar{background:#2a2a2a;border-radius:2px}"
    & ".slider-row .wk-gauge::-webkit-progress-value{background:#00aaff;border-radius:2px}"
    & ".slider-row .wk-gauge::-moz-progress-bar{background:#00aaff;border-radius:2px}"

Section: Constructors

  zoom-text : Integer -> Text
  zoom-text (z) =
    if z == -2 then "50%"
    else if z == -1 then "75%"
    else if z == 1 then "150%"
    else if z == 2 then "200%"
    else if z == 3 then "300%"
    else "100%"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let has-image = state-get "has-image"
    in widget-box "imgtools" "imgtools" [
      workspace-view has-image,
      tools-panel 0
    ]

  workspace-view : Integer -> WidgetNode
  workspace-view (has-image) =
    widget-box "workspace" "workspace" [
      widget-box "ws-bar" "ws-toolbar" [
        widget-label "brand" "CodexImageTools",
        widget-label "sep0" "",
        widget-button "btn-open" "&#x1F4C2; Open",
        widget-button "btn-paste" "Paste",
        widget-label "sep1" "",
        widget-button "btn-undo" "&#x21B6;",
        widget-button "btn-redo" "&#x21B7;",
        widget-label "sep2" "",
        widget-button "btn-zin" "+",
        widget-label "zoom" (zoom-text (state-get "zoom-level")),
        widget-button "btn-zout" "-",
        widget-button "btn-fit" "Fit",
        widget-label "sep3" "",
        widget-button "btn-compare" (if state-get "compare-on" == 1 then "&#x1F50D; Compare" else "Compare"),
        widget-button "btn-ruler" (if state-get "ruler-on" == 1 then "&#x1F4CF; Ruler" else "Ruler"),
        widget-button "btn-grid" (if state-get "grid-on" == 1 then "&#x23F9; Grid" else "Grid"),
        if state-get "paste-flag" == 1 then widget-label "paste-ind" "Pasted from clipboard" else widget-label "paste-ind" ""
      ],
      if has-image == 1
      then widget-box "canvas" "ws-canvas" [
        widget-label "img" "&#x1F5BC;",
        if state-get "compare-on" == 1
        then widget-box "cmp-split" "compare-split" [
          widget-label "cmp-before" "Before",
          widget-label "cmp-after" "After"
        ]
        else widget-label "cmp-none" ""
      ]
      else widget-box "canvas" "ws-canvas" [
        widget-box "empty" "preview-empty" [
          widget-label "empty-icon" "&#x1F5BC;",
          widget-label "empty-text" "Open an image to begin",
          widget-label "empty-hint" "Supports PNG, JPEG, BMP, QOI, TIFF"
        ]
      ],
      widget-box "footer" "ws-footer" [
        widget-label "ft-dims" (if state-get "has-image" == 1 then (show (state-get "img-w") & " x " & show (state-get "img-h") & " px") else "No image loaded"),
        widget-label "ft-size" (if state-get "has-image" == 1 then (show (state-get "file-size-kb") & " KB") else ""),
        widget-label "ft-fmt" (if state-get "has-image" == 1 then (format-label (state-get "export-format")) else ""),
        widget-label "ft-dpi" (if state-get "has-image" == 1 then (show (state-get "img-dpi") & " DPI") else "")
      ]
    ]

  tools-panel : Integer -> WidgetNode
  tools-panel (x) =
    widget-box "panel" "panel" [
      crop-section 0,
      resize-section 0,
      rotate-section 0,
      adjust-section 0,
      filter-section 0,
      format-section 0,
      histogram-section 0,
      picker-section 0,
      metadata-section 0,
      watermark-section 0,
      preset-section 0
    ]

  crop-section : Integer -> WidgetNode
  crop-section (x) =
    widget-box "sec-crop" "panel-section" [
      widget-label "crop-hdr" "CROP",
      widget-box "crop-dims" "" [
        widget-box "crop-x" "panel-row" [
          widget-label "crop-x-l" "X",
          widget-label "crop-x-v" "0",
          widget-label "crop-x-u" "px"
        ],
        widget-box "crop-y" "panel-row" [
          widget-label "crop-y-l" "Y",
          widget-label "crop-y-v" "0",
          widget-label "crop-y-u" "px"
        ],
        widget-box "crop-w" "panel-row" [
          widget-label "crop-w-l" "W",
          widget-label "crop-w-v" "640",
          widget-label "crop-w-u" "px"
        ],
        widget-box "crop-h" "panel-row" [
          widget-label "crop-h-l" "H",
          widget-label "crop-h-v" "400",
          widget-label "crop-h-u" "px"
        ]
      ],
      widget-label "aspect-hdr" "Aspect Ratio",
      widget-box "aspects" "aspect-btns" [
        widget-button "asp-free" "Free",
        widget-button "asp-1" "1:1",
        widget-button "asp-43" "4:3",
        widget-button "asp-169" "16:9",
        widget-button "asp-32" "3:2"
      ],
      widget-button "btn-crop" "Apply Crop"
    ]

  resize-section : Integer -> WidgetNode
  resize-section (x) =
    widget-box "sec-resize" "panel-section" [
      widget-label "resize-hdr" "RESIZE",
      widget-box "resize-w" "panel-row" [
        widget-label "rw-l" "Width",
        widget-label "rw-v" "640",
        widget-label "rw-u" "px"
      ],
      widget-box "resize-h" "panel-row" [
        widget-label "rh-l" "Height",
        widget-label "rh-v" "400",
        widget-label "rh-u" "px"
      ],
      widget-box "resize-pct" "panel-row" [
        widget-label "rp-l" "Scale",
        widget-label "rp-v" "100",
        widget-label "rp-u" "%"
      ],
      widget-label "lock-lbl" "&#x1F512; Lock aspect ratio",
      widget-button "btn-resize" "Apply Resize"
    ]

  rotate-section : Integer -> WidgetNode
  rotate-section (x) =
    widget-box "sec-rotate" "panel-section" [
      widget-label "rotate-hdr" "ROTATE / FLIP",
      widget-box "rotate-btns" "rotate-btns" [
        widget-button "rot-ccw" "&#x21BA; 90",
        widget-button "rot-cw" "&#x21BB; 90",
        widget-button "rot-180" "180&#xB0;",
        widget-button "flip-h" "&#x2194;",
        widget-button "flip-v" "&#x2195;"
      ]
    ]

  adjust-section : Integer -> WidgetNode
  adjust-section (x) =
    let b = state-get "brightness"
    in let c = state-get "contrast"
    in let sa = state-get "saturation"
    in widget-box "sec-adjust" "panel-section" [
      widget-label "adjust-hdr" "ADJUSTMENTS",
      widget-box "adj-bright" "slider-row" [
        widget-label "bright-l" "Brightness",
        widget-button "bright-down" "-",
        widget-gauge "bright-fill" (50 + b / 2) 100,
        widget-label "bright-v" (show b),
        widget-button "bright-up" "+"
      ],
      widget-box "adj-contrast" "slider-row" [
        widget-label "contrast-l" "Contrast",
        widget-button "contrast-down" "-",
        widget-gauge "contrast-fill" (50 + c / 2) 100,
        widget-label "contrast-v" (show c),
        widget-button "contrast-up" "+"
      ],
      widget-box "adj-sat" "slider-row" [
        widget-label "sat-l" "Saturation",
        widget-button "sat-down" "-",
        widget-gauge "sat-fill" (50 + sa / 2) 100,
        widget-label "sat-v" (show sa),
        widget-button "sat-up" "+"
      ],
      widget-button "btn-reset-adj" "Reset All"
    ]

  format-section : Integer -> WidgetNode
  format-section (x) =
    let ef = state-get "export-format"
    in let qual = state-get "quality"
    in widget-box "sec-format" "panel-section" [
      widget-label "format-hdr" "EXPORT",
      widget-box "fmts" "format-btns" [
        widget-box-click "fmt-png" (if ef == 1 then "format-btn active" else "format-btn") [ widget-label "fp-l" "PNG" ],
        widget-box-click "fmt-jpg" (if ef == 2 then "format-btn active" else "format-btn") [ widget-label "fj-l" "JPEG" ],
        widget-box-click "fmt-bmp" (if ef == 3 then "format-btn active" else "format-btn") [ widget-label "fb-l" "BMP" ],
        widget-box-click "fmt-qoi" (if ef == 4 then "format-btn active" else "format-btn") [ widget-label "fq-l" "QOI" ],
        widget-box-click "fmt-tiff" (if ef == 5 then "format-btn active" else "format-btn") [ widget-label "ft-l" "TIFF" ],
        widget-box-click "fmt-webp" (if ef == 6 then "format-btn active" else "format-btn") [ widget-label "fw-l" "WebP" ]
      ],
      widget-box "quality" "slider-row" [
        widget-label "qual-l" "Quality",
        widget-button "qual-down" "-",
        widget-gauge "qual-fill" qual 100,
        widget-label "qual-v" (show qual & "%"),
        widget-button "qual-up" "+"
      ],
      widget-button "btn-export" "&#x1F4BE; Export",
      widget-label "batch-hdr" "BATCH",
      widget-label "batch-drop" "Drop multiple images here",
      widget-box "batch-stats" "batch-info" [
        widget-label "batch-count" ("Files: " & show (state-get "batch-count")),
        widget-label "batch-pct" (show (state-get "batch-progress") & "% done")
      ],
      widget-box "batch-prog" "batch-bar" [
        widget-label "batch-fill" ""
      ]
    ]

  histogram-section : Integer -> WidgetNode
  histogram-section (x) =
    widget-box "sec-histo" "panel-section" [
      widget-label "histo-hdr" "HISTOGRAM",
      widget-box "histo-r" "histo-bar-row" [
        widget-label "histo-r-ch" "R",
        widget-box "histo-r-bar" "histo-bar" [
          widget-label "histo-r-fill" ""
        ],
        widget-label "histo-r-val" (show (state-get "histo-r"))
      ],
      widget-box "histo-g" "histo-bar-row" [
        widget-label "histo-g-ch" "G",
        widget-box "histo-g-bar" "histo-bar" [
          widget-label "histo-g-fill" ""
        ],
        widget-label "histo-g-val" (show (state-get "histo-g"))
      ],
      widget-box "histo-b" "histo-bar-row" [
        widget-label "histo-b-ch" "B",
        widget-box "histo-b-bar" "histo-bar" [
          widget-label "histo-b-fill" ""
        ],
        widget-label "histo-b-val" (show (state-get "histo-b"))
      ],
      widget-box "histo-l" "histo-bar-row" [
        widget-label "histo-l-ch" "L",
        widget-box "histo-l-bar" "histo-bar" [
          widget-label "histo-l-fill" ""
        ],
        widget-label "histo-l-val" (show (state-get "histo-l"))
      ]
    ]

  picker-section : Integer -> WidgetNode
  picker-section (x) =
    widget-box "sec-picker" "panel-section" [
      widget-label "picker-hdr" "COLOR PICKER",
      widget-box "picker-row" "panel-row" [
        widget-label "picker-swatch" "",
        widget-label "picker-hex" (state-get-text "picker-color"),
        widget-button "btn-eyedrop" "&#x1F4A7; Eyedropper"
      ],
      widget-box "picker-rgb" "panel-row" [
        widget-label "picker-r-lbl" "R:",
        widget-label "picker-r-val" (show (state-get "picker-r")),
        widget-label "picker-g-lbl" "G:",
        widget-label "picker-g-val" (show (state-get "picker-g")),
        widget-label "picker-b-lbl" "B:",
        widget-label "picker-b-val" (show (state-get "picker-b"))
      ]
    ]

  metadata-section : Integer -> WidgetNode
  metadata-section (x) =
    widget-box "sec-meta" "panel-section" [
      widget-label "meta-hdr" "METADATA",
      widget-box "meta-dims" "meta-row" [
        widget-label "meta-dims-l" "Dimensions",
        widget-label "meta-dims-v" (show (state-get "img-w") & " x " & show (state-get "img-h"))
      ],
      widget-box "meta-fmt" "meta-row" [
        widget-label "meta-fmt-l" "Format",
        widget-label "meta-fmt-v" (format-label (state-get "export-format"))
      ],
      widget-box "meta-size" "meta-row" [
        widget-label "meta-size-l" "File Size",
        widget-label "meta-size-v" (show (state-get "file-size-kb") & " KB")
      ],
      widget-box "meta-depth" "meta-row" [
        widget-label "meta-depth-l" "Color Depth",
        widget-label "meta-depth-v" (show (state-get "color-depth") & " bit")
      ],
      widget-box "meta-dpi" "meta-row" [
        widget-label "meta-dpi-l" "DPI",
        widget-label "meta-dpi-v" (show (state-get "img-dpi"))
      ]
    ]

  filter-section : Integer -> WidgetNode
  filter-section (x) =
    widget-box "sec-filter" "panel-section" [
      widget-label "filter-hdr" "FILTERS",
      widget-box "filter-sharp" "filter-row" [
        widget-label "sharp-l" "Sharpen",
        widget-button "sharp-down" "-",
        widget-label "sharp-v" (show (state-get "sharpen")),
        widget-button "sharp-up" "+"
      ],
      widget-box "filter-blur" "filter-row" [
        widget-label "blur-l" "Blur",
        widget-button "blur-down" "-",
        widget-label "blur-v" (show (state-get "blur")),
        widget-button "blur-up" "+"
      ]
    ]

  watermark-section : Integer -> WidgetNode
  watermark-section (x) =
    widget-box "sec-wmark" "panel-section" [
      widget-label "wmark-hdr" "WATERMARK",
      widget-label "wmark-preview" (state-get-text "wmark-text"),
      widget-button "btn-wmark" (if state-get "wmark-on" == 1 then "&#x2705; Watermark On" else "Watermark Off")
    ]

  preset-section : Integer -> WidgetNode
  preset-section (x) =
    let pa = state-get "preset-active"
    in widget-box "sec-preset" "panel-section" [
      widget-label "preset-hdr" "PRESETS",
      widget-box "presets" "preset-btns" [
        widget-box-click "pre-auto" (if pa == 1 then "preset-btn active" else "preset-btn") [ widget-label "pa-l" "&#x2728; Auto-Enhance" ],
        widget-box-click "pre-gray" (if pa == 2 then "preset-btn active" else "preset-btn") [ widget-label "pg-l" "Grayscale" ],
        widget-box-click "pre-sepia" (if pa == 3 then "preset-btn active" else "preset-btn") [ widget-label "ps-l" "Sepia" ],
        widget-box-click "pre-invert" (if pa == 4 then "preset-btn active" else "preset-btn") [ widget-label "pi-l" "Invert" ]
      ]
    ]

Section: Handlers

  rotate-label : Integer -> Text
  rotate-label (angle) =
    if angle == 0 then "0&#xB0;"
    else if angle == 90 then "90&#xB0; CW"
    else if angle == 180 then "180&#xB0;"
    else "90&#xB0; CCW"

  format-label : Integer -> Text
  format-label (f) =
    if f == 1 then "PNG"
    else if f == 2 then "JPEG"
    else if f == 3 then "BMP"
    else if f == 4 then "QOI"
    else if f == 5 then "TIFF"
    else "WebP"

  clamp-val : Integer, Integer, Integer -> Integer
  clamp-val (v) (lo) (hi) =
    if v < lo then lo
    else if v > hi then hi
    else v

  imagetools-click : Text -> Integer
  imagetools-click (id) =
    if id == "btn-open" then
      let s1 = state-set "has-image" 1
      in let s2 = state-set "img-w" 1024
      in let s3 = state-set "img-h" 768
      in let s4 = state-set "crop-w" 1024
      in let s5 = state-set "crop-h" 768
      in let s6 = state-set "rotate-angle" 0
      in let s7 = state-set "flip-h" 0
      in let s8 = state-set "flip-v" 0
      in let s9 = state-set "file-size-kb" 1536
      in let s10 = state-set "color-depth" 24
      in let s11 = state-set "img-dpi" 96
      in let s12 = state-set "paste-flag" 0
      in let s13 = state-set "histo-r" 158
      in let s14 = state-set "histo-g" 122
      in let s15 = state-set "histo-b" 181
      in let s16 = state-set-render "histo-l" 140 in 0
    else if id == "btn-paste" then
      let s1 = state-set "has-image" 1
      in let s2 = state-set "img-w" 640
      in let s3 = state-set "img-h" 480
      in let s4 = state-set "file-size-kb" 245
      in let s5 = state-set "paste-flag" 1
      in let s6 = state-set-render "color-depth" 24 in 0
    else if id == "btn-undo" then
      let u = state-get "undo-count"
      in if u > 0 then let s = state-set-render "undo-count" (u - 1) in 0 else 0
    else if id == "btn-redo" then
      let s = state-set-render "undo-count" (state-get "undo-count" + 1) in 0
    else if id == "fmt-png" then let s = state-set-render "export-format" 1 in 0
    else if id == "fmt-jpg" then let s = state-set-render "export-format" 2 in 0
    else if id == "fmt-bmp" then let s = state-set-render "export-format" 3 in 0
    else if id == "fmt-qoi" then let s = state-set-render "export-format" 4 in 0
    else if id == "fmt-tiff" then let s = state-set-render "export-format" 5 in 0
    else if id == "fmt-webp" then let s = state-set-render "export-format" 6 in 0
    else if id == "asp-free" then let s = state-set-render "aspect-lock" 1 in 0
    else if id == "asp-1" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" h
      in let s2 = state-set-render "aspect-lock" 2 in 0
    else if id == "asp-43" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" (h * 4 / 3)
      in let s2 = state-set-render "aspect-lock" 3 in 0
    else if id == "asp-169" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" (h * 16 / 9)
      in let s2 = state-set-render "aspect-lock" 4 in 0
    else if id == "asp-32" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" (h * 3 / 2)
      in let s2 = state-set-render "aspect-lock" 5 in 0
    else if id == "rot-ccw" then
      let a = state-get "rotate-angle"
      in let s = state-set-render "rotate-angle" ((a + 270) - ((a + 270) / 360) * 360) in 0
    else if id == "rot-cw" then
      let a = state-get "rotate-angle"
      in let s = state-set-render "rotate-angle" ((a + 90) - ((a + 90) / 360) * 360) in 0
    else if id == "rot-180" then
      let a = state-get "rotate-angle"
      in let s = state-set-render "rotate-angle" ((a + 180) - ((a + 180) / 360) * 360) in 0
    else if id == "flip-h" then let s = state-set-render "flip-h" (1 - state-get "flip-h") in 0
    else if id == "flip-v" then let s = state-set-render "flip-v" (1 - state-get "flip-v") in 0
    else if id == "bright-up" then
      let s = state-set-render "brightness" (clamp-val (state-get "brightness" + 10) (-100) 100) in 0
    else if id == "bright-down" then
      let s = state-set-render "brightness" (clamp-val (state-get "brightness" - 10) (-100) 100) in 0
    else if id == "contrast-up" then
      let s = state-set-render "contrast" (clamp-val (state-get "contrast" + 10) (-100) 100) in 0
    else if id == "contrast-down" then
      let s = state-set-render "contrast" (clamp-val (state-get "contrast" - 10) (-100) 100) in 0
    else if id == "sat-up" then
      let s = state-set-render "saturation" (clamp-val (state-get "saturation" + 10) (-100) 100) in 0
    else if id == "sat-down" then
      let s = state-set-render "saturation" (clamp-val (state-get "saturation" - 10) (-100) 100) in 0
    else if id == "btn-zin" then
      let s = state-set-render "zoom-level" (clamp-val (state-get "zoom-level" + 1) 0 8) in 0
    else if id == "btn-zout" then
      let s = state-set-render "zoom-level" (clamp-val (state-get "zoom-level" - 1) 0 8) in 0
    else if id == "btn-fit" then let s = state-set-render "zoom-level" 0 in 0
    else if id == "btn-export" then
      let s = state-set-render "export-count" (state-get "export-count" + 1) in 0
    else if id == "crop-apply" then
      let s = state-set-render "crop-applied" 1 in 0
    else if id == "resize-apply" then
      let s = state-set-render "resize-applied" 1 in 0
    else if id == "btn-compare" then let s = state-set-render "compare-on" (1 - state-get "compare-on") in 0
    else if id == "btn-ruler" then let s = state-set-render "ruler-on" (1 - state-get "ruler-on") in 0
    else if id == "btn-grid" then let s = state-set-render "grid-on" (1 - state-get "grid-on") in 0
    else if id == "sharp-up" then
      let s = state-set-render "sharpen" (clamp-val (state-get "sharpen" + 10) 0 100) in 0
    else if id == "sharp-down" then
      let s = state-set-render "sharpen" (clamp-val (state-get "sharpen" - 10) 0 100) in 0
    else if id == "blur-up" then
      let s = state-set-render "blur" (clamp-val (state-get "blur" + 10) 0 100) in 0
    else if id == "blur-down" then
      let s = state-set-render "blur" (clamp-val (state-get "blur" - 10) 0 100) in 0
    else if id == "btn-eyedrop" then
      let s1 = state-set-text "picker-color" "#44AAFF"
      in let s2 = state-set "picker-r" 68
      in let s3 = state-set "picker-g" 170
      in let s4 = state-set-render "picker-b" 255 in 0
    else if id == "btn-wmark" then let s = state-set-render "wmark-on" (1 - state-get "wmark-on") in 0
    else if id == "pre-auto" then
      let s1 = state-set "brightness" 15
      in let s2 = state-set "contrast" 10
      in let s3 = state-set "saturation" 5
      in let s4 = state-set-render "preset-active" 1 in 0
    else if id == "pre-gray" then
      let s1 = state-set "saturation" (-100)
      in let s2 = state-set-render "preset-active" 2 in 0
    else if id == "pre-sepia" then
      let s1 = state-set "saturation" (-50)
      in let s2 = state-set "brightness" 10
      in let s3 = state-set-render "preset-active" 3 in 0
    else if id == "pre-invert" then
      let s = state-set-render "preset-active" 4 in 0
    else if id == "qual-up" then
      let s = state-set-render "quality" (clamp-val (state-get "quality" + 5) 10 100) in 0
    else if id == "qual-down" then
      let s = state-set-render "quality" (clamp-val (state-get "quality" - 5) 10 100) in 0
    else if id == "btn-reset-adj" then
      let s1 = state-set "brightness" 0
      in let s2 = state-set "contrast" 0
      in let s3 = state-set "saturation" 0
      in let s4 = state-set-render "preset-active" 0 in 0
    else if id == "batch-drop" then
      let c = state-get "batch-count" + 3
      in let p = clamp-val (c * 100 / 10) 0 100
      in let s1 = state-set "batch-count" c
      in let s2 = state-set-render "batch-progress" p in 0
    else 0

Section: Entry

  render-imagetools : Integer -> Integer
  render-imagetools (x) = mount-widget-themed imagetools-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style imagetools-theme imagetools-css
    in let s0 = state-set "histo-r" 158
    in let s1 = state-set "histo-g" 122
    in let s2 = state-set "histo-b" 181
    in let s3 = state-set "histo-l" 140
    in let s4 = state-set-text "picker-color" "#000000"
    in let s5 = state-set "picker-r" 0
    in let s6 = state-set "picker-g" 0
    in let s7 = state-set "picker-b" 0
    in let s8 = state-set "file-size-kb" 0
    in let s9 = state-set "color-depth" 24
    in let s10 = state-set "img-dpi" 72
    in let s11 = state-set-text "wmark-text" "CodexImageTools"
    in let s12 = state-set "wmark-on" 0
    in let s13 = state-set "sharpen" 0
    in let s14 = state-set "blur" 0
    in let s15 = state-set "batch-count" 0
    in let s16 = state-set "batch-progress" 0
    in let s17 = state-set "quality" 92
    in let s18 = state-set "export-format" 1
    in let s19 = state-set "brightness" 0
    in let s20 = state-set "contrast" 0
    in let s21 = state-set "saturation" 0
    in let s22 = state-set "preset-active" 0
    in let s23 = state-set "has-image" 0
    in let s24 = state-set "zoom-level" 0
    in let s = set-render render-imagetools
    in let h = register-handlers no-pick imagetools-click
    in render-imagetools 0
  end

Page 1
