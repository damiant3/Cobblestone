Chapter: GpuPage
  cites Site chapter SiteTheme

 We say:

Section: Extra CSS

  gpu-extra-css : Text
  gpu-extra-css =
    ".gpu-page{max-width:1100px;margin:0 auto;padding:0 24px}"

    & ".code-showcase{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}"
    & ".code-info>.wk-label:first-child{font-size:20px;font-weight:700;color:#fff;margin-bottom:12px}"
    & ".code-info>.wk-label:nth-child(2){font-size:15px;color:#8b949e;line-height:1.7;margin-bottom:16px}"

    & ".phase-list{list-style:none;padding:0;position:relative;padding-left:24px}"
    & ".phase-list::before{content:'';position:absolute;left:5px;top:0;bottom:0;width:2px;background:#1e1e2e}"
    & ".phase-list>.wk-label{padding:8px 0;font-size:14px;color:#aaa;position:relative;line-height:1.5}"
    & ".phase-list>.wk-label::before{content:'';display:inline-block;width:10px;height:10px;background:#d4a017;border-radius:50%;position:absolute;left:-23px;top:12px;border:2px solid #0a0a12}"

    & ".cdx-mock{height:320px;background:linear-gradient(180deg,#0a0a18 0%,#12121e 50%,#0e0e1a 100%);position:relative;overflow:hidden;padding:20px;font-family:'JetBrains Mono',monospace;font-size:11px;color:#8b949e}"
    & ".cdx-mock>.wk-label{line-height:1.8}"
    & ".cdx-mock .kw{color:#d4a017}.cdx-mock .ty{color:#f1c40f}.cdx-mock .nu{color:#f0883e}.cdx-mock .cm{color:#555;font-style:italic}"
    & ".cdx-hdr-line{color:#d4a017;font-weight:bold;font-size:12px;letter-spacing:1px;margin-bottom:12px}"

    & ".smp-mock{height:320px;background:linear-gradient(180deg,#0a0a18 0%,#12121e 100%);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;gap:24px;padding:20px}"
    & ".core-box{background:rgba(20,20,30,.9);border:1px solid #1e1e2e;border-radius:12px;padding:16px;text-align:center;width:100px;transition:border-color .3s}"
    & ".core-box:first-child{border-color:#d4a017}"
    & ".core-box>.wk-label:first-child{font-size:11px;color:#d4a017;font-weight:700;letter-spacing:1px;margin-bottom:6px}"
    & ".core-box>.wk-label:nth-child(2){font-size:20px;margin-bottom:4px}"
    & ".core-box>.wk-label:last-child{font-size:10px;color:#8b949e}"
    & ".smp-bus{width:60px;height:2px;background:#1e1e2e;position:relative}"
    & ".smp-bus>.wk-label{position:absolute;top:-8px;left:50%;transform:translateX(-50%);font-size:8px;color:#555;white-space:nowrap;display:inline}"

Section: Tree

  gpu-hero : WidgetNode
  gpu-hero = site-hero "GPU &#x2022; SIMD &#x2022; SMP &#x2022; CDX" "PARALLEL EVERYTHING" "GPU kernels in Codex. Explicit SIMD vectors. Symmetric multiprocessing. <em>One language, every level of parallelism.</em>&shy;" [site-stat "s0" "8" "Emit Targets", site-stat "s1" "512" "Bit Vectors", site-stat "s2" "5" "SMP Phases", site-stat "s3" "224" "Byte CDX Header"]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      site-nav [
        widget-label "nl0" "GPU",
        widget-label "nl1" "SIMD",
        widget-label "nl2" "SMP",
        widget-label "nl3" "CDX Format",
        widget-label "nl4" "Home"
      ],
      gpu-hero,
      widget-box "body" "gpu-page" [
        gpu-section 0,
        simd-section 0,
        smp-section 0,
        cdx-section 0,
        site-footer [
          widget-label "fl0" "Home",
          widget-label "fl1" "GitHub",
          widget-label "fl2" "Documentation",
          widget-label "fl3" "CodexMagic"
        ]
      ]
    ]

Section: GPU Compute

  gpu-info2 : WidgetNode
  gpu-info2 = site-showcase-info "gpu-info2" "From PCIe to Pixels" "Codex owns the full GPU stack. PCIe enumeration is done. The roadmap: shared-memory proxy, then virtio GPU, then UEFI GOP framebuffer, then direct hardware init. No driver blobs, no kernel modules &mdash; just Codex talking to the bus." [site-tag "gpt0" "PCIe Enumeration", site-tag "gpt1" "Shared-Memory Proxy", site-tag "gpt2" "Virtio GPU", site-tag "gpt3" "UEFI GOP", site-tag "gpt4" "Direct Init"]

  gpu-phases : WidgetNode
  gpu-phases = widget-box "gpu-phases" "showcase-visual" [widget-box "gpu-pl" "phase-list" [widget-label "gph0" "&#x2705; PCIe enumeration &mdash; device discovery on the bus", widget-label "gph1" "&#x1F6A7; Shared-memory proxy &mdash; host/device data exchange", widget-label "gph2" "&#x1F6A7; Virtio GPU &mdash; virtualized rendering pipeline", widget-label "gph3" "&#x1F6A7; UEFI GOP &mdash; firmware framebuffer access", widget-label "gph4" "&#x1F6A7; Direct init &mdash; bare-metal GPU programming"]]

  gpu-section : Integer -> WidgetNode
  gpu-section (x) =
    site-section "gpu" "GPU COMPUTE" "Kernels in Pure Codex" "Write GPU compute kernels in the same language as everything else &mdash; no annotations, no separate shading language." [
      widget-box "gpu-show" "code-showcase" [
        site-code-block-nodes "gcb" "VectorAdd.codex" [site-span "fn" "vector-add", widget-text " : ", site-span "ty" "Vector N Real", widget-text " -&gt; ", site-span "ty" "Vector N Real", widget-text " -&gt; [", site-span "ty" "Device", widget-text "] ", site-span "ty" "Vector N Real", widget-text "\n", site-span "fn" "vector-add", widget-text " (a) (b) = ", site-span "kw" "act", widget-text "\n  ", site-span "kw" "let", widget-text " tid = ", site-span "fn" "thread-id", widget-text " 0\n  ", site-span "kw" "in let", widget-text " result = ", site-span "fn" "shared-alloc", widget-text " N\n  ", site-span "kw" "in let", widget-text " _ = ", site-span "fn" "store", widget-text " result tid ((", site-span "fn" "load", widget-text " a tid) + (", site-span "fn" "load", widget-text " b tid))\n  ", site-span "kw" "in let", widget-text " _ = ", site-span "fn" "barrier", widget-text " 0\n  ", site-span "kw" "in", widget-text " result\n", site-span "kw" "end", widget-text "\n\n", site-span "cm" "The [Device] effect carries the kernel.", widget-text "\n", site-span "cm" "No @kernel annotation needed.", widget-text "&shy;"],
        widget-box "gci" "code-info" [
          widget-label "gcit" "Effect-Driven GPU",
          widget-label "gcid" "GPU kernels are ordinary Codex functions carried by the [Device] effect. The compiler emits PTX as its 8th target &mdash; alongside x86-64, ARM64, RISC-V, WASM, JavaScript, Python, and Rust.",
          site-bullet-list "gcil" [
            widget-label "gcia" "No @kernel annotation &mdash; the [Device] effect is the marker",
            widget-label "gcib" "PTX is the 8th emit mode in the compiler",
            widget-label "gcic" "Proxy model for NVIDIA (firmware requires signed blobs)",
            widget-label "gcid2" "Intrinsics: Thread, Warp, Block, Grid, Shared, Atomic, Barrier"
          ]
        ]
      ],
      site-showcase "gpu-show2" gpu-info2 gpu-phases
    ]

Section: SIMD

  simd-section : Integer -> WidgetNode
  simd-section (x) =
    site-section "simd" "EXPLICIT SIMD" "Vectors You Can See" "No autovectorization. SIMD in Codex is explicit, intentional, and type-safe." [
      widget-box "simd-show" "code-showcase" [
        widget-box "sci" "code-info" [
          widget-label "scit" "Vector N T",
          widget-label "scid" "SIMD vectors are first-class types. N is a compile-time power of two. T is Integer or Real. The compiler maps to the widest available register file &mdash; SSE2, NEON, AVX, AVX-512, SVE, or RISC-V V.",
          site-bullet-list "scil" [
            widget-label "scia" "Vector N T &mdash; N is comptime power-of-2, T is Integer or Real",
            widget-label "scib" "== on Real is a compile error &mdash; use ~ for approximate comparison",
            widget-label "scic" "Bounds prover integration: Vector N (Integer between L and H)",
            widget-label "scid2" "No autovectorization &mdash; SIMD is explicit and intentional"
          ]
        ],
        site-code-block-nodes "scb" "SimdExample.codex" [site-span "fn" "dot-product", widget-text " : ", widget-el "span" "ty" "" [widget-text "Vector ", site-span "nu" "4", widget-text " Real"], widget-text " -&gt; ", widget-el "span" "ty" "" [widget-text "Vector ", site-span "nu" "4", widget-text " Real"], widget-text " -&gt; ", site-span "ty" "Real", widget-text "\n", site-span "fn" "dot-product", widget-text " (a) (b) =\n  ", site-span "kw" "let", widget-text " prod = a * b\n  ", site-span "kw" "in", widget-text " ", site-span "fn" "vector-reduce-add", widget-text " prod\n\n", site-span "cm" "128-bit portable: SSE2 on x86,", widget-text "\n", site-span "cm" "NEON on ARM64.", widget-text "\n", site-span "cm" "No autovectorization &mdash; you", widget-text "\n", site-span "cm" "wrote this, you own it.", widget-text "&shy;"]
      ],
      site-card-grid-3 "simd-grid" [
        site-card "sp0" "&#x31;&#xFE0F;&#x20E3;" "Phase 1: SSE2 + NEON" "128-bit portable vector API. The baseline &mdash; every x86-64 and ARM64 target gets SIMD from day one.",
        site-card "sp1" "&#x32;&#xFE0F;&#x20E3;" "Phase 2: AVX / AVX2" "256-bit YMM registers. Doubled throughput for floating-point workloads on modern x86.",
        site-card "sp2" "&#x33;&#xFE0F;&#x20E3;" "Phase 3: AVX-512 + SVE" "512-bit and scalable vectors. AVX-512 on x86, SVE on ARM64, V extension on RISC-V.",
        site-card "sp3" "&#x34;&#xFE0F;&#x20E3;" "Phase 4: Crypto" "Hardware crypto acceleration. AES-NI, CLMUL, and architecture-specific crypto intrinsics."
      ]
    ]

Section: SMP

  smp-visual : WidgetNode
  smp-visual = widget-box "smp-vis" "showcase-visual" [widget-box "smp-scr" "smp-mock" [widget-box "core0" "core-box" [widget-label "c0t" "BSP", widget-label "c0i" "&#x1F7E2;", widget-label "c0s" "Core 0"], widget-box "bus01" "smp-bus" [widget-label "b01" "IPI&shy;"], widget-box "core1" "core-box" [widget-label "c1t" "AP", widget-label "c1i" "&#x1F7E1;", widget-label "c1s" "Core 1"], widget-box "bus12" "smp-bus" [widget-label "b12" "IPI&shy;"], widget-box "core2" "core-box" [widget-label "c2t" "AP", widget-label "c2i" "&#x1F7E1;", widget-label "c2s" "Core 2"], widget-box "bus23" "smp-bus" [widget-label "b23" "IPI&shy;"], widget-box "core3" "core-box" [widget-label "c3t" "AP", widget-label "c3i" "&#x1F7E1;", widget-label "c3s" "Core 3"]]]

  smp-info : WidgetNode
  smp-info = site-showcase-info "smp-info" "5-Phase Bare-Metal SMP" "Phase 1 delivers atomic-load, atomic-store, and atomic-cas with the [Atomic] effect. The BSP sends INIT/STARTUP IPIs on x86-64, PSCI CPU_ON on ARM64, SBI hart_start on RISC-V. Per-core run queues with work stealing. Per-core heap arenas eliminate contention. No kernel locks &mdash; incompatible with punctual." [site-tag "smpt0" "Atomics", site-tag "smpt1" "Per-Core Bootstrap", site-tag "smpt2" "Per-Core Scheduler", site-tag "smpt3" "Per-Core Heap", site-tag "smpt4" "IPI"]

  smp-section : Integer -> WidgetNode
  smp-section (x) =
    site-section "smp" "SYMMETRIC MULTIPROCESSING" "Every Core, No Locks" "Bare-metal SMP with per-core heaps, per-core schedulers, and work stealing &mdash; no kernel locks." [
      site-showcase "smp-show" smp-visual smp-info,
      widget-box "smp-show2" "code-showcase" [
        site-code-block-nodes "smcb" "Atomic.codex" [site-span "fn" "atomic-cas", widget-text " : ", site-span "ty" "Ptr Integer", widget-text " -&gt; ", site-span "ty" "Integer", widget-text " -&gt; ", site-span "ty" "Integer", widget-text " -&gt; [", site-span "ty" "Atomic", widget-text "] ", site-span "ty" "Integer", widget-text "\n\n", site-span "cm" "x86-64: lock cmpxchg", widget-text "\n", site-span "cm" "ARM64:  ldaxr / stlxr", widget-text "\n", site-span "cm" "RISC-V: lr.d / sc.d", widget-text "\n\n", site-span "fn" "spinlock-acquire", widget-text " : ", site-span "ty" "Ptr Integer", widget-text " -&gt; [", site-span "ty" "Atomic", widget-text "] ", site-span "ty" "Integer", widget-text "\n", site-span "fn" "spinlock-acquire", widget-text " (lock) = ", site-span "kw" "act", widget-text "\n  ", site-span "kw" "let", widget-text " old = ", site-span "fn" "atomic-cas", widget-text " lock ", site-span "nu" "0", widget-text " ", site-span "nu" "1", widget-text "\n  ", site-span "kw" "in if", widget-text " old == ", site-span "nu" "0", widget-text " ", site-span "kw" "then", widget-text " ", site-span "nu" "1", widget-text "\n  ", site-span "kw" "else", widget-text " ", site-span "fn" "spinlock-acquire", widget-text " lock\n", site-span "kw" "end", widget-text "&shy;"],
        widget-box "smci" "code-info" [
          widget-label "smcit" "Cross-Architecture Atomics",
          widget-label "smcid" "The [Atomic] effect tracks every atomic operation. The compiler emits the correct instruction sequence for each target &mdash; lock cmpxchg on x86-64, load-exclusive/store-exclusive on ARM64, load-reserved/store-conditional on RISC-V.",
          site-bullet-list "smcil" [
            widget-label "smcia" "x86-64: BSP sends INIT/STARTUP IPIs to APs",
            widget-label "smcib" "ARM64: PSCI CPU_ON via SMC/HVC",
            widget-label "smcic" "RISC-V: SBI hart_start",
            widget-label "smcid2" "Per-core run queues with work stealing"
          ]
        ]
      ]
    ]

Section: CDX Binary Format

  cdx-visual : WidgetNode
  cdx-visual = widget-box "cdx-vis" "showcase-visual" [widget-box "cdx-scr" "cdx-mock" [widget-el "span" "wk-label" "id|cdx-h0" [site-span "cdx-hdr-line" "CDX BINARY LAYOUT", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h1" [site-span "kw" "offset  size  field", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h2" [site-span "nu" "0x000", widget-text "   ", site-span "nu" "8", widget-text "     ", site-span "ty" "magic", widget-text "           ", site-span "cm" "CDX\\x00\\x01\\x00\\x00\\x00", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h3" [site-span "nu" "0x008", widget-text "   ", site-span "nu" "32", widget-text "    ", site-span "ty" "content-hash", widget-text "    ", site-span "cm" "SHA-256 of everything after sig", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h4" [site-span "nu" "0x028", widget-text "   ", site-span "nu" "64", widget-text "    ", site-span "ty" "signature", widget-text "       ", site-span "cm" "Ed25519 over content-hash", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h5" [site-span "nu" "0x068", widget-text "   ", site-span "nu" "32", widget-text "    ", site-span "ty" "capability-tbl", widget-text "  ", site-span "cm" "effect capabilities", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h6" [site-span "nu" "0x088", widget-text "   ", site-span "nu" "32", widget-text "    ", site-span "ty" "proof-hash-tbl", widget-text "  ", site-span "cm" "type proof hashes", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h7" [site-span "nu" "0x0A8", widget-text "   ", site-span "nu" "24", widget-text "    ", site-span "ty" "text-section", widget-text "    ", site-span "cm" "executable code", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h8" [site-span "nu" "0x0C0", widget-text "   ", site-span "nu" "24", widget-text "    ", site-span "ty" "rodata-section", widget-text "  ", site-span "cm" "read-only data", widget-text "&shy;"], widget-el "span" "wk-label" "id|cdx-h9" [site-span "cm" "224 bytes total header &mdash; no .data, no .bss, no relocations", widget-text "&shy;"]]]

  cdx-info : WidgetNode
  cdx-info = site-showcase-info "cdx-info" "Trust Built Into the Format" "Every CDX binary carries its own SHA-256 content hash and Ed25519 signature in the header. Identity is content-addressed. The capability table declares what effects the binary uses. The proof hash table links type-safety proofs to the binary. No dynamic linking. No GOT/PLT. No .data or .bss sections. What you see is what runs." [site-tag "cdxt0" "224-Byte Header", site-tag "cdxt1" "SHA-256 Hash", site-tag "cdxt2" "Ed25519 Signature", site-tag "cdxt3" "Capability Table", site-tag "cdxt4" "Content-Addressed", site-tag "cdxt5" "No Dynamic Linking"]

  cdx-section : Integer -> WidgetNode
  cdx-section (x) =
    site-section "cdx" "CDX BINARY FORMAT" "Not ELF. Not PE. CDX." "A native binary format with cryptographic identity built in. No dynamic linking, no GOT/PLT, no .data/.bss." [
      site-showcase "cdx-show" cdx-visual cdx-info,
      site-card-grid-3 "cdx-grid" [
        site-card "cx0" "&#x1F512;" "Signed at Birth" "Every CDX binary is signed with Ed25519 at compile time. The signature covers a SHA-256 content hash. Tamper with one byte and the binary refuses to load.",
        site-card "cx1" "&#x1F4E6;" "ELF Wrapper" "For QEMU development and Linux interop, Codex emits ELF wrappers and ELF+CDX-note binaries. The CDX payload rides inside a standard container.",
        site-card "cx2" "&#x2696;" "No Relocations" "CDX binaries are position-dependent with no GOT, no PLT, no dynamic linker. The binary is the truth. Static, simple, verifiable."
      ]
    ]

Section: Handlers

  gpu-click : Text -> Integer
  gpu-click (id) = 0

Section: Entry

  render-gpu : Integer -> Integer
  render-gpu (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init gpu-extra-css
    in let s = set-render render-gpu
    in let h = register-handlers no-pick gpu-click
    in render-gpu 0
  end

