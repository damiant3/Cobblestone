Chapter: EdgeMeshFailover

  cites Engine chapter EdgeMesh
  cites Net chapter GroupMembership
  cites Mesh chapter EdgeMeshLive
  cites Mesh chapter EdgeMeshPlace

 `EdgeMeshGameServers.md` phase 4, stage 1: inter-region failover. Phase 3
 stage 2 refuses when a game has no healthy node in the region asked for, which
 is right for a wrong-game node and wrong for a whole region that has gone
 down.

 Distance is the sum of the two absolute co-ordinate differences rather than a
 great-circle arc. The value orders candidate regions and is never reported as
 a distance, and the ordering the two agree on is the same for regions this far
 apart.

Section: How Far Apart

  fo-distance : EdgeRegion, EdgeRegion -> Integer
  fo-distance (a) (b) = em-abs ((a.er-lat) - (b.er-lat)) + em-abs ((a.er-lon) - (b.er-lon))

  fo-has-node : GroupState, EdgeRegion, Text -> Boolean
  fo-has-node (g) (r) (game) =
    when gs-pick-load-balanced g (place-game-service game r)
      is None -> False
      is Just (loc) -> True

Section: The Nearest Region Still Serving The Game

  fo-best-loop : GroupState, List EdgeRegion, EdgeRegion, Text, Integer, Integer, Integer, Integer -> Integer
  fo-best-loop (g) (rs) (home) (game) (home-idx) (i) (best) (best-dist) =
    if i >= list-length rs then best
    else if i == home-idx then fo-best-loop g rs home game home-idx (i + 1) best best-dist
    else let r = list-at rs i
    in let d = fo-distance home r
    in let take = fo-has-node g r game & (best < 0 | d < best-dist)
    in if take then fo-best-loop g rs home game home-idx (i + 1) i d
    else fo-best-loop g rs home game home-idx (i + 1) best best-dist

Section: Placing With A Fallback

  PlaceOutcome =
    | PlacedHome (ServiceLocation)
    | PlacedAway (Text) (ServiceLocation)
    | PlaceRefused (Text)

  place-or-failover : GroupState, RegionList, Integer, Text -> PlaceOutcome
  place-or-failover (g) (rl) (home-idx) (game) =
    when mesh-region-at rl home-idx
      is None -> PlaceRefused ("no such region: " & show home-idx)
      is Just (home) -> fo-from-home g rl home home-idx game

  fo-from-home : GroupState, RegionList, EdgeRegion, Integer, Text -> PlaceOutcome
  fo-from-home (g) (rl) (home) (home-idx) (game) =
    when place-for-game g rl home-idx game
      is GamePlacedAt (gm) (loc) -> PlacedHome (loc)
      is GamePlacementRefused (why) -> fo-away g rl home home-idx game

  fo-away : GroupState, RegionList, EdgeRegion, Integer, Text -> PlaceOutcome
  fo-away (g) (rl) (home) (home-idx) (game) =
    let b = fo-best-loop g (rl.rl-regions) home game home-idx 0 (0 - 1) 0
    in if b < 0 then PlaceRefused (game & " has no healthy node in any region")
    else fo-at g rl b game

  fo-at : GroupState, RegionList, Integer, Text -> PlaceOutcome
  fo-at (g) (rl) (idx) (game) =
    when place-for-game g rl idx game
      is GamePlacedAt (gm) (loc) -> PlacedAway ((list-at (rl.rl-regions) idx).er-name) (loc)
      is GamePlacementRefused (why) -> PlaceRefused (why)

Section: Reporting

  fo-label : PlaceOutcome -> Text
  fo-label (o) =
    when o
      is PlacedHome (loc) -> "home, on " & loc.sl-member-id
      is PlacedAway (region) (loc) -> "failed over to " & region & ", on " & loc.sl-member-id
      is PlaceRefused (why) -> "refused: " & why
