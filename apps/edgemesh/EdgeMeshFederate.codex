Chapter: EdgeMeshFederate

  cites Engine chapter EdgeMesh
  cites Foreword chapter Maybe

 `EdgeMeshGameServers.md` phase 3, stage 1: federation. `mq-find-pair` pairs on
 rating and wait alone, so one queue holding two games pairs across them, and a
 queue entry carries a mode but no game at all.

 The partition is applied by narrowing the queue handed to `mq-try-pair`, not by
 a second pairing rule. The rating window widens with wait time there, and a
 partition written beside it rather than in front of it is a partition that a
 long enough wait defeats.

Section: A Lane Per Game

  GameLane = record {
    gl-game : Text,
    gl-queue : MatchQueue
  }

  FedQueue = record {
    fq-lanes : List GameLane
  }

  fed-new : FedQueue
  fed-new = FedQueue { fq-lanes = [] }

  fed-lane-index : List GameLane, Text, Integer -> Integer
  fed-lane-index (lanes) (game) (i) =
    if i >= list-length lanes then 0 - 1
    else if (list-at lanes i).gl-game == game then i
    else fed-lane-index lanes game (i + 1)

  fed-enqueue : FedQueue, Text, QueuedPlayer -> FedQueue
  fed-enqueue (q) (game) (p) =
    let i = fed-lane-index (q.fq-lanes) game 0
    in if i < 0 then
      FedQueue { fq-lanes = list-push (q.fq-lanes) (GameLane { gl-game = game, gl-queue = mq-enqueue mq-new p }) }
    else
      let lane = list-at (q.fq-lanes) i
      in FedQueue { fq-lanes = list-set-at (q.fq-lanes) i (GameLane { gl-game = game, gl-queue = mq-enqueue (lane.gl-queue) p }) }

  fed-lane-count : FedQueue -> Integer
  fed-lane-count (q) = list-length (q.fq-lanes)

  fed-waiting : FedQueue, Text -> Integer
  fed-waiting (q) (game) =
    let i = fed-lane-index (q.fq-lanes) game 0
    in if i < 0 then 0 else (list-at (q.fq-lanes) i).gl-queue.mq-count

Section: Mode Within A Lane

  fed-mode-key : GameMode -> Text
  fed-mode-key (m) =
    when m
      is ModeRanked -> "ranked"
      is ModeCasual -> "casual"
      is ModeTournament -> "tournament"
      is ModeCustom (n) -> "custom:" & n

  fed-keep-mode : List QueuedPlayer, Text, Integer, List QueuedPlayer -> List QueuedPlayer
  fed-keep-mode (ps) (key) (i) (acc) =
    if i >= list-length ps then acc
    else let p = list-at ps i
    in fed-keep-mode ps key (i + 1) (if fed-mode-key (p.qp-game-mode) == key then list-push acc p else acc)

  fed-sub-queue : MatchQueue, Text -> MatchQueue
  fed-sub-queue (q) (key) =
    let ps = fed-keep-mode (q.mq-players) key 0 []
    in MatchQueue {
      mq-players = ps,
      mq-count = list-length ps,
      mq-max-wait = q.mq-max-wait,
      mq-rating-window = q.mq-rating-window
    }

Section: Pairing Within One Lane

  FedMatch =
    | FedPaired (Text) (MatchPair)
    | FedWaiting (Text)

  fed-try-pair : FedQueue, Text, GameMode, Integer -> FedMatch
  fed-try-pair (q) (game) (mode) (now) =
    let i = fed-lane-index (q.fq-lanes) game 0
    in if i < 0 then FedWaiting ("no lane for " & game)
    else let lane = list-at (q.fq-lanes) i
    in when mq-try-pair (fed-sub-queue (lane.gl-queue) (fed-mode-key mode)) now
      is None -> FedWaiting (game & " " & fed-mode-key mode & " has no pair")
      is Just (mp) -> FedPaired (game) (mp)

Section: Reporting

  fed-match-label : FedMatch -> Text
  fed-match-label (fm) =
    when fm
      is FedPaired (game) (mp) ->
        "paired in " & game & ": " & (mp.mp-player-a).qp-name & " vs " & (mp.mp-player-b).qp-name & " diff=" & show (mp.mp-rating-diff)
      is FedWaiting (why) -> "waiting: " & why
