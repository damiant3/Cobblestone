Chapter: EdgeMeshRewards

  cites Engine chapter EdgeMesh
  cites Mesh chapter EdgeMeshFederate

 `EdgeMeshGameServers.md` phase 3, stage 3: cross-plane rewards, play Chess and
 earn coins for CodexMagic. `MatchReward` carries two player ids and two coin
 amounts and names no game and no destination, so where a reward LANDS is not
 expressible today.

 `compute-reward` is the foreword's and stays there; this chapter decides only
 where the coins go and whether they may go there yet.

Section: Wallets Per Plane

  PlaneWallet = record {
    pw-plane : Text,
    pw-balance : Integer
  }

  Ledger = record {
    lg-wallets : List PlaneWallet,
    lg-settled : List Integer
  }

  ledger-new : Ledger
  ledger-new = Ledger { lg-wallets = [], lg-settled = [] }

  ledger-index : List PlaneWallet, Text, Integer -> Integer
  ledger-index (ws) (plane) (i) =
    if i >= list-length ws then 0 - 1
    else if (list-at ws i).pw-plane == plane then i
    else ledger-index ws plane (i + 1)

  ledger-open : Ledger, Text -> Ledger
  ledger-open (l) (plane) =
    if ledger-index (l.lg-wallets) plane 0 >= 0 then l
    else Ledger {
      lg-wallets = (l.lg-wallets) & [PlaneWallet { pw-plane = plane, pw-balance = 0 }],
      lg-settled = l.lg-settled
    }

  ledger-planes : Ledger -> Integer
  ledger-planes (l) = list-length (l.lg-wallets)

  ledger-balance : Ledger, Text -> Integer
  ledger-balance (l) (plane) =
    let i = ledger-index (l.lg-wallets) plane 0
    in if i < 0 then 0 - 1 else (list-at (l.lg-wallets) i).pw-balance

 A NEW wallet list rather than `list-set-at`. That builtin is a bounds check, an
 address, a store and a return of the SAME pointer (`CostModel.md` 5.1, where it
 is the zero-allocation row), so crediting through it writes into whatever
 ledger the caller still holds.

  ledger-credit-loop : List PlaneWallet, Text, Integer, Integer, List PlaneWallet -> List PlaneWallet
  ledger-credit-loop (ws) (plane) (coins) (i) (acc) =
    if i >= list-length ws then acc
    else let w = list-at ws i
    in let one = if w.pw-plane == plane then PlaneWallet { pw-plane = w.pw-plane, pw-balance = (w.pw-balance) + coins } else w
    in ledger-credit-loop ws plane coins (i + 1) (acc & [one])

  ledger-add : Ledger, Text, Integer -> Ledger
  ledger-add (l) (plane) (coins) =
    if ledger-index (l.lg-wallets) plane 0 < 0 then l
    else Ledger {
      lg-wallets = ledger-credit-loop (l.lg-wallets) plane coins 0 [],
      lg-settled = l.lg-settled
    }

Section: Settling Once

  ledger-has : List Integer, Integer, Integer -> Boolean
  ledger-has (xs) (v) (i) =
    if i >= list-length xs then False
    else if list-at xs i == v then True
    else ledger-has xs v (i + 1)

  ledger-settled : Ledger, Integer -> Boolean
  ledger-settled (l) (match-id) = ledger-has (l.lg-settled) match-id 0

  Settlement =
    | Settled (Text) (Integer)
    | SettleRefused (Text)

  SettleResult = record {
    sr-ledger : Ledger,
    sr-outcome : Settlement
  }

  settle-refuse : Ledger, Text -> SettleResult
  settle-refuse (l) (why) = SettleResult { sr-ledger = l, sr-outcome = SettleRefused (why) }

  settle : Ledger, Integer, Text, Text, MatchReward -> SettleResult
  settle (l) (match-id) (winner-plane) (loser-plane) (rw) =
    if ledger-settled l match-id then settle-refuse l ("match " & show match-id & " is already settled")
    else if ledger-index (l.lg-wallets) winner-plane 0 < 0 then settle-refuse l ("no wallet on plane " & winner-plane)
    else if ledger-index (l.lg-wallets) loser-plane 0 < 0 then settle-refuse l ("no wallet on plane " & loser-plane)
    else let credited = ledger-add (ledger-add l winner-plane (rw.mr-winner-coins)) loser-plane (rw.mr-loser-coins)
    in SettleResult {
      sr-ledger = Ledger { lg-wallets = credited.lg-wallets, lg-settled = (credited.lg-settled) & [match-id] },
      sr-outcome = Settled (winner-plane) (rw.mr-winner-coins)
    }

  settle-fed : Ledger, Integer, Text, Text, FedMatch, Boolean -> SettleResult
  settle-fed (l) (match-id) (winner-plane) (loser-plane) (fm) (ranked) =
    when fm
      is FedWaiting (why) -> settle-refuse l ("nothing to settle: " & why)
      is FedPaired (game) (mp) ->
        settle l match-id winner-plane loser-plane (compute-reward ((mp.mp-player-a).qp-rating) ((mp.mp-player-b).qp-rating) ranked)

Section: Reporting

  settle-label : Settlement -> Text
  settle-label (s) =
    when s
      is Settled (plane) (coins) -> "credited " & show coins & " to " & plane
      is SettleRefused (why) -> "refused: " & why
