Chapter: BomGenerator
  cites Foreword chapter List

Section: Entry

  BomEntry = record {
    be-ref-list : List Text,
    be-value : Text,
    be-footprint : Text,
    be-manufacturer : Text,
    be-mpn : Text,
    be-quantity : Integer,
    be-unit-price : Integer,
    be-line-total : Integer,
    be-description : Text,
    be-category : Text
  }

Section: Format

  BomFormat =
    | BomCsv
    | BomJson
    | BomHtml
    | BomText

Section: Group Mode

  BomGroupMode =
    | GroupByValue
    | GroupByMpn
    | GroupByFootprint
    | Ungrouped

Section: Sort Mode

  BomSortMode =
    | SortByRef
    | SortByValue
    | SortByCategory
    | SortByPrice

Section: Config

  BomConfig = record {
    bc-format : BomFormat,
    bc-group-mode : BomGroupMode,
    bc-sort-mode : BomSortMode,
    bc-include-dnp : Integer,
    bc-include-virtual : Integer,
    bc-currency-symbol : Text
  }

  default-bom-config : BomConfig
  default-bom-config = BomConfig {
    bc-format = BomCsv,
    bc-group-mode = GroupByValue,
    bc-sort-mode = SortByRef,
    bc-include-dnp = 0,
    bc-include-virtual = 0,
    bc-currency-symbol = "$"
  }

Section: Report

  BomReport = record {
    br-entries : List BomEntry,
    br-total-unique : Integer,
    br-total-quantity : Integer,
    br-total-cost : Integer,
    br-dnp-count : Integer,
    br-generated-date : Text
  }

Section: Reference Formatting

  bom-refs-join : List Text, Text -> Text
  bom-refs-join (refs) (acc) =
    bom-refs-join-loop refs acc 0 (list-length refs)

  bom-refs-join-loop : List Text, Text, Integer, Integer -> Text
  bom-refs-join-loop (refs) (acc) (i) (n) =
    if i >= n then acc
    else let r = list-at refs i
    in bom-refs-join-item r refs acc i n

  bom-refs-join-item : Text, List Text, Text, Integer, Integer -> Text
  bom-refs-join-item (r) (refs) (acc) (i) (n) =
    if i + 1 < n then bom-refs-join-loop refs (acc & r & ", ") (i + 1) n
    else bom-refs-join-loop refs (acc & r) (i + 1) n

  bom-entry-refs-text : BomEntry -> Text
  bom-entry-refs-text (entry) = bom-refs-join entry.be-ref-list ""

Section: Price Formatting

  bom-format-price : Integer -> Text
  bom-format-price (cents) =
    let dollars = cents / 100
    in let remainder = cents - dollars * 100
    in if remainder < 10
      then show dollars & ".0" & (show remainder)
      else show dollars & "." & (show remainder)

Section: CSV Output

  csv-field-sep : Text
  csv-field-sep = ","

  bom-csv-refs : BomEntry -> Text
  bom-csv-refs (entry) = bom-entry-refs-text entry & csv-field-sep

  bom-csv-mid : BomEntry -> Text
  bom-csv-mid (entry) = entry.be-value & csv-field-sep & entry.be-footprint & csv-field-sep & entry.be-manufacturer & csv-field-sep & entry.be-mpn & csv-field-sep

  bom-csv-qty : BomEntry -> Text
  bom-csv-qty (entry) = show entry.be-quantity & csv-field-sep

  bom-csv-prices : BomEntry, Text -> Text
  bom-csv-prices (entry) (currency) = currency & (bom-format-price entry.be-unit-price) & csv-field-sep & currency & (bom-format-price entry.be-line-total) & csv-field-sep

  bom-csv-tail : BomEntry -> Text
  bom-csv-tail (entry) = entry.be-description & csv-field-sep & entry.be-category

  bom-entry-to-csv-line : BomEntry, Text -> Text
  bom-entry-to-csv-line (entry) (currency) =
    bom-csv-refs entry & bom-csv-mid entry & bom-csv-qty entry & bom-csv-prices entry currency & bom-csv-tail entry

Section: JSON Output

  bom-json-kv-str : Text, Text -> Text
  bom-json-kv-str (key) (val) = "'" & key & "': '" & val & "'"

  bom-json-kv-int : Text, Integer -> Text
  bom-json-kv-int (key) (val) = "'" & key & "': " & (show val)

  bom-json-head : BomEntry -> Text
  bom-json-head (entry) = bom-json-kv-str "refs" (bom-entry-refs-text entry) & ", " & bom-json-kv-str "value" entry.be-value & ", " & bom-json-kv-str "footprint" entry.be-footprint

  bom-json-mid : BomEntry -> Text
  bom-json-mid (entry) = bom-json-kv-str "manufacturer" entry.be-manufacturer & ", " & bom-json-kv-str "mpn" entry.be-mpn

  bom-json-nums : BomEntry -> Text
  bom-json-nums (entry) = bom-json-kv-int "quantity" entry.be-quantity & ", " & bom-json-kv-int "unit-price" entry.be-unit-price & ", " & bom-json-kv-int "line-total" entry.be-line-total

  bom-json-tail : BomEntry -> Text
  bom-json-tail (entry) = bom-json-kv-str "description" entry.be-description & ", " & bom-json-kv-str "category" entry.be-category

  bom-entry-to-json : BomEntry -> Text
  bom-entry-to-json (entry) =
    "{" & bom-json-head entry & ", " & bom-json-mid entry & ", " & bom-json-nums entry & ", " & bom-json-tail entry & "}"

Section: Report Summary

  bom-summary-counts : BomReport -> Text
  bom-summary-counts (report) = show report.br-total-unique & " unique parts, " & (show report.br-total-quantity) & " total, "

  bom-report-summary : BomReport, Text -> Text
  bom-report-summary (report) (currency) =
    bom-summary-counts report & currency & (bom-format-price report.br-total-cost)
