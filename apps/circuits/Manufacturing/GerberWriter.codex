Chapter: GerberWriter
  cites Foreword chapter List

 RS-274X Gerber file generation. Produces industry-standard photoplot
 files for PCB fabrication. Coordinates are internally nanometers and
 formatted to the configured decimal format on output.

Section: Aperture

  GerberAperture =
    | ApertureCircle (Integer)
    | ApertureRect (Integer) (Integer)
    | ApertureObround (Integer) (Integer)
    | AperturePolygon (Integer) (Integer) (Integer)

Section: Command

  GerberCommand =
    | GcMove (Integer) (Integer)
    | GcFlash (Integer) (Integer)
    | GcInterpolate (Integer) (Integer)
    | GcSetAperture (Integer)
    | GcRegionStart
    | GcRegionEnd
    | GcComment (Text)
    | GcEndOfFile

Section: Layer

  GerberLayer = record {
    gl-layer-name : Text,
    gl-polarity : Text,
    gl-apertures : List GerberAperture,
    gl-commands : List GerberCommand
  }

Section: Config

  GerberConfig = record {
    gc-format-integer : Integer,
    gc-format-decimal : Integer,
    gc-unit-mode : Text,
    gc-zero-suppression : Text
  }

  default-gerber-config : GerberConfig
  default-gerber-config = GerberConfig {
    gc-format-integer = 4,
    gc-format-decimal = 6,
    gc-unit-mode = "MM",
    gc-zero-suppression = "L"
  }

Section: Coordinate Formatting

 Formats a nanometer integer into the coordinate string used in Gerber
 files. The value is scaled so that the decimal digits represent the
 fractional part without an explicit decimal point.

  gerber-format-coord : Integer -> Text
  gerber-format-coord (nm) =
    let microns = nm / 1000
    in if microns < 0
      then "-" & show (0 - microns)
      else show microns

Section: Aperture Text

  gerber-aperture-to-text : GerberAperture, Integer -> Text
  gerber-aperture-to-text (ap) (id) =
    let d = show id
    in when ap
      is ApertureCircle (diam) ->
        "%ADD" & d & "C," & (gerber-format-coord diam) & "*%"
      is ApertureRect (w) (h) ->
        "%ADD" & d & "R," & (gerber-format-coord w) & "X" & (gerber-format-coord h) & "*%"
      is ApertureObround (w) (h) ->
        "%ADD" & d & "O," & (gerber-format-coord w) & "X" & (gerber-format-coord h) & "*%"
      is AperturePolygon (diam) (verts) (rot) ->
        "%ADD" & d & "P," & (gerber-format-coord diam) & "X" & (show verts) & "X" & (gerber-format-coord rot) & "*%"

Section: Command Text

  gerber-command-to-text : GerberCommand -> Text
  gerber-command-to-text (cmd) = when cmd
    is GcMove (x) (y) ->
      "D02*" & "X" & (gerber-format-coord x) & "Y" & (gerber-format-coord y) & "D02*"
    is GcFlash (x) (y) ->
      "X" & (gerber-format-coord x) & "Y" & (gerber-format-coord y) & "D03*"
    is GcInterpolate (x) (y) ->
      "X" & (gerber-format-coord x) & "Y" & (gerber-format-coord y) & "D01*"
    is GcSetAperture (id) ->
      "D" & (show id) & "*"
    is GcRegionStart -> "G36*"
    is GcRegionEnd -> "G37*"
    is GcComment (text) -> "G04 " & text & "*"
    is GcEndOfFile -> "M02*"

Section: Header

  gerber-header-text : GerberConfig -> Text
  gerber-header-text (cfg) =
    let unit-cmd = if cfg.gc-unit-mode == "MM" then "%MOMM*%" else "%MOIN*%"
    in let fs = "%FS" & cfg.gc-zero-suppression & "AX" & (show cfg.gc-format-integer) & (show cfg.gc-format-decimal) & "Y" & (show cfg.gc-format-integer) & (show cfg.gc-format-decimal) & "*%"
    in "G04 Generated by Codex Circuits*" & "" & fs & "" & unit-cmd & ""

Section: Aperture List Emission

  gerber-apertures-text : List GerberAperture, Integer, Integer, Text -> Text
  gerber-apertures-text (aps) (idx) (start-id) (acc) =
    gerber-apertures-loop aps idx start-id acc 0 (list-length aps)

  gerber-apertures-loop : List GerberAperture, Integer, Integer, Text, Integer, Integer -> Text
  gerber-apertures-loop (aps) (idx) (start-id) (acc) (i) (n) =
    if i >= n then acc
    else let a = list-at aps i
    in let line = gerber-aperture-to-text a (start-id + idx + i)
    in gerber-apertures-loop aps idx start-id (acc & line & "") (i + 1) n

Section: Command List Emission

  gerber-commands-text : List GerberCommand, Text -> Text
  gerber-commands-text (cmds) (acc) =
    gerber-commands-loop cmds acc 0 (list-length cmds)

  gerber-commands-loop : List GerberCommand, Text, Integer, Integer -> Text
  gerber-commands-loop (cmds) (acc) (i) (n) =
    if i >= n then acc
    else let c = list-at cmds i
    in gerber-commands-loop cmds (acc & gerber-command-to-text c & "") (i + 1) n

Section: Layer File

 Assembles a complete Gerber layer file: header, polarity, aperture
 definitions, then the draw commands, terminated by end-of-file.

  gerber-layer-to-text : GerberLayer, GerberConfig -> Text
  gerber-layer-to-text (layer) (cfg) =
    let header = gerber-header-text cfg
    in let polarity = "%LP" & layer.gl-polarity & "*%" & ""
    in let apertures = gerber-apertures-text layer.gl-apertures 0 10 ""
    in let commands = gerber-commands-text layer.gl-commands ""
    in header & polarity & apertures & commands & "M02*" & ""
