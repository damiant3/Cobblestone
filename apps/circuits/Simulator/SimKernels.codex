Chapter: SimKernels
  cites Foreword chapter List
  cites Foreword chapter Maybe
  cites Gpu chapter DeviceMath

 GPU-accelerated sparse matrix solver stubs for SPICE simulation.
 Defines the kernel interface for direct and iterative linear system
 solvers operating on compressed sparse row data. The solver back-end
 dispatches to GPU compute kernels via the Device effect when available
 and falls back to CPU iteration otherwise.

Section: Matrix Element

  MatrixElement = record {
    me-row : Integer,
    me-col : Integer,
    me-value : Real
  }

Section: Sparse Matrix

  SparseMatrix = record {
    sm-rows : Integer,
    sm-cols : Integer,
    sm-elements : List MatrixElement,
    sm-nnz : Integer
  }

Section: Matrix Vector

  MatrixVector = record {
    mv-size : Integer,
    mv-values : List Real
  }

Section: Solve Method

  SolveMethod =
    | DirectLU
    | IterativeGMRES
    | ConjugateGradient

Section: Solver Configuration

  SolverConfig = record {
    sc-method : SolveMethod,
    sc-tolerance : Real,
    sc-max-iterations : Integer
  }

Section: Solver Result

  SolverResult = record {
    sr-solution : MatrixVector,
    sr-converged : Integer,
    sr-iterations : Integer,
    sr-residual : Real
  }

Section: Matrix Construction

  empty-sparse-matrix : Integer, Integer -> SparseMatrix
  empty-sparse-matrix (rows) (cols) = SparseMatrix {
    sm-rows = rows,
    sm-cols = cols,
    sm-elements = [],
    sm-nnz = 0
  }

  matrix-add-element : SparseMatrix, Integer, Integer, Real -> SparseMatrix
  matrix-add-element (mat) (row) (col) (val) = SparseMatrix {
    sm-rows = mat.sm-rows,
    sm-cols = mat.sm-cols,
    sm-elements = list-push mat.sm-elements (MatrixElement { me-row = row, me-col = col, me-value = val }),
    sm-nnz = mat.sm-nnz + 1
  }

  matrix-nnz : SparseMatrix -> Integer
  matrix-nnz (mat) = mat.sm-nnz

Section: Vector Construction

  zero-vector : Integer -> MatrixVector
  zero-vector (n) = MatrixVector {
    mv-size = n,
    mv-values = build-zero-list n 0 []
  }

  build-zero-list : Integer, Integer, List Real -> List Real
  build-zero-list (n) (i) (acc) =
    if i >= n then acc
    else build-zero-list n (i + 1) (list-push acc 0.0)

Section: Vector Operations

 Functional update: returns a new vector with the element at the given
 index replaced. Rebuilds the value list via index scan.

  vector-set : MatrixVector, Integer, Real -> MatrixVector
  vector-set (vec) (idx) (val) = MatrixVector {
    mv-size = vec.mv-size,
    mv-values = vector-set-scan vec.mv-values idx val 0 (list-length vec.mv-values) []
  }

  vector-set-scan : List Real, Integer, Real, Integer, Integer, List Real -> List Real
  vector-set-scan (vals) (idx) (new-val) (i) (n) (acc) =
    if i >= n then acc else vec-set-step vals idx new-val i n acc

  vec-set-step : List Real, Integer, Real, Integer, Integer, List Real -> List Real
  vec-set-step (vals) (idx) (new-val) (i) (n) (acc) =
    let v = list-at vals i
    in let out = if i == idx then new-val else v
    in vector-set-scan vals idx new-val (i + 1) n (list-push acc out)

 Dot product of two vectors computed by recursive walk over the
 value lists.

  vector-dot : MatrixVector, MatrixVector -> Real
  vector-dot (a) (b) =
    vector-dot-scan a.mv-values b.mv-values 0 (list-length a.mv-values) 0.0

  vector-dot-scan : List Real, List Real, Integer, Integer, Real -> Real
  vector-dot-scan (as) (bs) (i) (n) (acc) =
    if i >= n then acc else vec-dot-step as bs i n acc

  vec-dot-step : List Real, List Real, Integer, Integer, Real -> Real
  vec-dot-step (as) (bs) (i) (n) (acc) =
    let va = list-at as i
    in let vb = list-at bs i
    in vector-dot-scan as bs (i + 1) n (acc + va * vb)

 Euclidean norm: square root of the dot product with itself.
 Uses Newton's method for the square root approximation.

  vector-norm : MatrixVector -> Real
  vector-norm (vec) =
    let dot = vector-dot vec vec
    in real-sqrt dot

Section: Solver Defaults

  default-solver-config : SolverConfig
  default-solver-config = SolverConfig {
    sc-method = DirectLU,
    sc-tolerance = 0.000001,
    sc-max-iterations = 1000
  }

Section: Solver Summary

  solver-summary : SolverResult -> Text
  solver-summary (res) =
    let status = if res.sr-converged == 1 then "converged" else "not converged"
    in "Solver " & status & " in " & (show res.sr-iterations) & " iterations"

Section: Matrix Density

 Returns the density of the sparse matrix as a percentage: the number
 of stored nonzero elements over the total number of cells.

  matrix-density : SparseMatrix -> Integer
  matrix-density (mat) =
    let total = mat.sm-rows * mat.sm-cols
    in if total == 0 then 0
    else mat.sm-nnz * 100 / total
