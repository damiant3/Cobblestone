Section: Built-in Op-Amp Models

 LM358 dual operational amplifier. Represented as a subcircuit
 reference name for .subckt inclusion.

  model-lm358 : DeviceModel
  model-lm358 = DeviceModel {
      dm-name = "LM358",
      dm-type = "SUBCKT",
      dm-level = 0,
      dm-params = [ModelParam { mp-name = "GBW", mp-value = "1e6" }, ModelParam { mp-name = "AVOL", mp-value = "100000" }, ModelParam { mp-name = "ROUT", mp-value = "75" }]
    }

  model-ideal-opamp : DeviceModel
  model-ideal-opamp = DeviceModel {
      dm-name = "IDEALOA",
      dm-type = "SUBCKT",
      dm-level = 0,
      dm-params = [ModelParam { mp-name = "AVOL", mp-value = "1e12" }, ModelParam { mp-name = "ROUT", mp-value = "0.001" }]
    }

Section: SPICE Formatting

  device-model-to-spice : DeviceModel -> Text
  device-model-to-spice (dm) =
    if dm.dm-type == "SUBCKT" then "* subcircuit reference: " & dm.dm-name else device-model-spice-fmt dm

  device-model-spice-fmt : DeviceModel -> Text
  device-model-spice-fmt (dm) =
    let header = ".model " & dm.dm-name & " " & dm.dm-type
    in let params = format-model-params dm.dm-params 0 (list-length dm.dm-params) ""
    in header & " (" & params & ")"

  format-model-params : List ModelParam, Integer, Integer, Text -> Text
  format-model-params (params) (i) (len) (acc) =
    if i >= len then acc else fmt-param-step params i len acc

  fmt-param-step : List ModelParam, Integer, Integer, Text -> Text
  fmt-param-step (params) (i) (len) (acc) =
    let p = list-at params i
    in let pair = p.mp-name & "=" & p.mp-value
    in let next = if acc == "" then pair else acc & " " & pair
    in format-model-params params (i + 1) len next
