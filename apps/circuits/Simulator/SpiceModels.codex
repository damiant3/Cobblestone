Chapter: SpiceModels
  cites Foreword chapter List

Section: Model Parameter

  ModelParam = record {
    mp-name : Text,
    mp-value : Text
  }

Section: Device Model

  DeviceModel = record {
    dm-name : Text,
    dm-type : Text,
    dm-level : Integer,
    dm-params : List ModelParam
  }

Section: Built-in Diode Models

 1N4148 small signal switching diode. Fast recovery, low capacitance.

  model-1n4148 : DeviceModel
  model-1n4148 = DeviceModel {
      dm-name = "D1N4148",
      dm-type = "D",
      dm-level = 1,
      dm-params = [ModelParam { mp-name = "IS", mp-value = "2.52e-9" }, ModelParam { mp-name = "RS", mp-value = "0.568" }, ModelParam { mp-name = "N", mp-value = "1.752" }, ModelParam { mp-name = "BV", mp-value = "100" }, ModelParam { mp-name = "IBV", mp-value = "100e-6" }, ModelParam { mp-name = "CJO", mp-value = "4e-12" }]
    }

  model-ideal-diode : DeviceModel
  model-ideal-diode = DeviceModel {
      dm-name = "DIDEAL",
      dm-type = "D",
      dm-level = 1,
      dm-params = [ModelParam { mp-name = "IS", mp-value = "1e-14" }, ModelParam { mp-name = "N", mp-value = "0.001" }]
    }

