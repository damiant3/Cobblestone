Chapter: BitmapFont
  cites Foreword chapter List

 5x7 pixel bitmap font for GPU-rect text rendering. Each glyph is
 encoded as 7 row bitmasks (5 bits each, MSB=leftmost pixel).
 Characters are rendered as 1x1 GPU rects per set pixel.

Section: Glyph Data

  glyph-rows : Integer -> List Integer
  glyph-rows (ch) =
    if ch == 48 then [14, 17, 19, 21, 25, 17, 14]
    else if ch == 49 then [4, 12, 4, 4, 4, 4, 14]
    else if ch == 50 then [14, 17, 1, 2, 4, 8, 31]
    else if ch == 51 then [14, 17, 1, 6, 1, 17, 14]
    else if ch == 52 then [2, 6, 10, 18, 31, 2, 2]
    else if ch == 53 then [31, 16, 30, 1, 1, 17, 14]
    else if ch == 54 then [6, 8, 16, 30, 17, 17, 14]
    else if ch == 55 then [31, 1, 2, 4, 4, 4, 4]
    else if ch == 56 then [14, 17, 17, 14, 17, 17, 14]
    else if ch == 57 then [14, 17, 17, 15, 1, 2, 12]
    else glyph-rows-alpha ch

  glyph-rows-alpha : Integer -> List Integer
  glyph-rows-alpha (ch) =
    if ch == 65 then [14, 17, 17, 31, 17, 17, 17]
    else if ch == 66 then [30, 17, 17, 30, 17, 17, 30]
    else if ch == 67 then [14, 17, 16, 16, 16, 17, 14]
    else if ch == 68 then [30, 17, 17, 17, 17, 17, 30]
    else if ch == 69 then [31, 16, 16, 30, 16, 16, 31]
    else if ch == 70 then [31, 16, 16, 30, 16, 16, 16]
    else if ch == 71 then [14, 17, 16, 19, 17, 17, 14]
    else if ch == 72 then [17, 17, 17, 31, 17, 17, 17]
    else if ch == 73 then [14, 4, 4, 4, 4, 4, 14]
    else if ch == 74 then [7, 2, 2, 2, 2, 18, 12]
    else if ch == 75 then [17, 18, 20, 24, 20, 18, 17]
    else if ch == 76 then [16, 16, 16, 16, 16, 16, 31]
    else if ch == 77 then [17, 27, 21, 21, 17, 17, 17]
    else glyph-rows-alpha2 ch

  glyph-rows-alpha2 : Integer -> List Integer
  glyph-rows-alpha2 (ch) =
    if ch == 78 then [17, 25, 21, 19, 17, 17, 17]
    else if ch == 79 then [14, 17, 17, 17, 17, 17, 14]
    else if ch == 80 then [30, 17, 17, 30, 16, 16, 16]
    else if ch == 81 then [14, 17, 17, 17, 21, 18, 13]
    else if ch == 82 then [30, 17, 17, 30, 20, 18, 17]
    else if ch == 83 then [14, 17, 16, 14, 1, 17, 14]
    else if ch == 84 then [31, 4, 4, 4, 4, 4, 4]
    else if ch == 85 then [17, 17, 17, 17, 17, 17, 14]
    else if ch == 86 then [17, 17, 17, 17, 10, 10, 4]
    else if ch == 87 then [17, 17, 17, 21, 21, 27, 17]
    else if ch == 88 then [17, 17, 10, 4, 10, 17, 17]
    else if ch == 89 then [17, 17, 10, 4, 4, 4, 4]
    else if ch == 90 then [31, 1, 2, 4, 8, 16, 31]
    else glyph-rows-misc ch

  glyph-rows-misc : Integer -> List Integer
  glyph-rows-misc (ch) =
    if ch == 46 then [0, 0, 0, 0, 0, 0, 4]
    else if ch == 44 then [0, 0, 0, 0, 4, 4, 8]
    else if ch == 45 then [0, 0, 0, 14, 0, 0, 0]
    else if ch == 58 then [0, 0, 4, 0, 4, 0, 0]
    else if ch == 32 then [0, 0, 0, 0, 0, 0, 0]
    else if ch == 40 then [2, 4, 8, 8, 8, 4, 2]
    else if ch == 41 then [8, 4, 2, 2, 2, 4, 8]
    else if ch == 43 then [0, 4, 4, 31, 4, 4, 0]
    else if ch == 61 then [0, 0, 31, 0, 31, 0, 0]
    else if ch == 47 then [1, 2, 2, 4, 8, 8, 16]
    else [0, 0, 14, 10, 14, 0, 0]

Section: CCE to ASCII

  cce-to-ascii : Integer -> Integer
  cce-to-ascii (c) =
    if c == 2 then 32
    else if c >= 3 then if c <= 12 then c + 45 else cce-alpha c
    else 32

  cce-alpha : Integer -> Integer
  cce-alpha (c) =
    if c == 13 then 69 else if c == 14 then 84 else if c == 15 then 65
    else if c == 16 then 79 else if c == 17 then 73 else if c == 18 then 78
    else if c == 19 then 83 else if c == 20 then 72 else if c == 21 then 82
    else if c == 22 then 68 else if c == 23 then 76 else if c == 24 then 67
    else if c == 25 then 85 else if c == 26 then 77 else if c == 27 then 87
    else if c == 28 then 70 else if c == 29 then 71 else if c == 30 then 89
    else if c == 31 then 80 else if c == 32 then 66 else if c == 33 then 86
    else if c == 34 then 75 else if c == 35 then 74 else if c == 36 then 88
    else if c == 37 then 81 else if c == 38 then 90
    else if c >= 39 then if c <= 64 then cce-alpha (c - 26) else cce-punct c
    else 32

  cce-punct : Integer -> Integer
  cce-punct (c) =
    if c == 65 then 46 else if c == 66 then 44 else if c == 67 then 33
    else if c == 68 then 63 else if c == 69 then 58 else if c == 70 then 59
    else if c == 71 then 39 else if c == 73 then 45 else if c == 74 then 40
    else if c == 75 then 41 else if c == 76 then 43 else if c == 77 then 61
    else if c == 78 then 42 else if c == 81 then 47
    else 32

  text-char-at : Text, Integer -> Integer
  text-char-at (t) (i) = cce-to-ascii (char-code (char-at t i))

Section: GPU Text Rendering

  draw-gpu-text : Integer, Integer, Integer, Text, Integer, Integer -> Integer
  draw-gpu-text (n) (x) (y) (txt) (color) (max-tris) =
    let len = text-length txt
    in draw-gpu-chars n x y txt color 0 len max-tris

  draw-gpu-chars : Integer, Integer, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  draw-gpu-chars (n) (x) (y) (txt) (color) (i) (len) (max-tris) =
    if i >= len then n
    else if n >= max-tris then n
    else let ch = text-char-at txt i
    in let rows = glyph-rows ch
    in let n2 = draw-glyph-rows n (x + i * 6) y rows color 0 max-tris
    in draw-gpu-chars n2 x y txt color (i + 1) len max-tris

  draw-glyph-rows : Integer, Integer, Integer, List Integer, Integer, Integer, Integer -> Integer
  draw-glyph-rows (n) (x) (y) (rows) (color) (row) (max-tris) =
    if row >= 7 then n
    else if n >= max-tris then n
    else let bits = list-at rows row
    in let n2 = draw-glyph-bits n x (y + row) bits color 4 max-tris
    in draw-glyph-rows n2 x y rows color (row + 1) max-tris

  draw-glyph-bits : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-glyph-bits (n) (x) (y) (bits) (color) (bit) (max-tris) =
    if bit < 0 then n
    else if n >= max-tris then n
    else let px = x + (4 - bit)
    in let on = if bit-and bits (bit-shl 1 bit) > 0 then 1 else 0
    in let n2 = if on == 1 then let w = gpu-rect-top n px y 1 1 color in n + 2 else n
    in draw-glyph-bits n2 x y bits color (bit - 1) max-tris

Section: Chrome Text Rendering

  draw-gpu-text-chrome : Integer, Integer, Integer, Text, Integer, Integer -> Integer
  draw-gpu-text-chrome (n) (x) (y) (txt) (color) (max-tris) =
    let len = text-length txt
    in draw-gpu-chars-chrome n x y txt color 0 len max-tris

  draw-gpu-chars-chrome : Integer, Integer, Integer, Text, Integer, Integer, Integer, Integer -> Integer
  draw-gpu-chars-chrome (n) (x) (y) (txt) (color) (i) (len) (max-tris) =
    if i >= len then n
    else if n >= max-tris then n
    else let ch = text-char-at txt i
    in let rows = glyph-rows ch
    in let n2 = draw-glyph-rows-chrome n (x + i * 6) y rows color 0 max-tris
    in draw-gpu-chars-chrome n2 x y txt color (i + 1) len max-tris

  draw-glyph-rows-chrome : Integer, Integer, Integer, List Integer, Integer, Integer, Integer -> Integer
  draw-glyph-rows-chrome (n) (x) (y) (rows) (color) (row) (max-tris) =
    if row >= 7 then n
    else if n >= max-tris then n
    else let bits = list-at rows row
    in let n2 = draw-glyph-bits-chrome n x (y + row) bits color 4 max-tris
    in draw-glyph-rows-chrome n2 x y rows color (row + 1) max-tris

  draw-glyph-bits-chrome : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-glyph-bits-chrome (n) (x) (y) (bits) (color) (bit) (max-tris) =
    if bit < 0 then n
    else if n >= max-tris then n
    else let px = x + (4 - bit)
    in let on = if bit-and bits (bit-shl 1 bit) > 0 then 1 else 0
    in let n2 = if on == 1 then let w = gpu-rect-chrome n px y 1 1 color in n + 2 else n
    in draw-glyph-bits-chrome n2 x y bits color (bit - 1) max-tris
