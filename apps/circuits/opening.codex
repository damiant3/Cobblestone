Chapter: CircuitsApp
  cites Foreword chapter List
  cites Foreword chapter Console

 Codex Circuits v2.0 — interactive EDA application.
 CanvasModel items, ViewPort transforms, InputSystem polling,
 BitmapFont text, dropdown menus, disk save/load.

Section: GPU Constants

  gpu-cmd : Integer = #BE000000

Section: GPU Primitives

  gpu-tri : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-tri (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in let s = poke-32 gpu-cmd off x0
    in let s1 = s + poke-32 gpu-cmd (off + 4) y0
    in let s2 = s1 + poke-32 gpu-cmd (off + 8) x1
    in let s3 = s2 + poke-32 gpu-cmd (off + 12) y1
    in let s4 = s3 + poke-32 gpu-cmd (off + 16) x2
    in let s5 = s4 + poke-32 gpu-cmd (off + 20) y2
    in let s6 = s5 + poke-32 gpu-cmd (off + 24) c0
    in let s7 = s6 + poke-32 gpu-cmd (off + 28) c1
    in let s8 = s7 + poke-32 gpu-cmd (off + 32) c2
    in let s9 = s8 + poke-32 gpu-cmd (off + 36) 10000
    in let sa = s9 + poke-32 gpu-cmd (off + 40) 10000
    in let sb = sa + poke-32 gpu-cmd (off + 44) 10000
    in let sc = sb + poke-32 gpu-cmd (off + 48) 0
    in let sd = sc + poke-32 gpu-cmd (off + 52) 0
    in let se = sd + poke-32 gpu-cmd (off + 56) 0
    in let sf = se + poke-32 gpu-cmd (off + 60) 0
    in let sg = sf + poke-32 gpu-cmd (off + 64) 0
    in sg + poke-32 gpu-cmd (off + 68) 0

  gpu-rect : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-rect (idx) (x) (y) (w) (h) (color) =
    let t0 = gpu-tri idx x y (x + w) y x (y + h) color color color
    in t0 + gpu-tri (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-tri-front : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-tri-front (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in let s = poke-32 gpu-cmd off x0
    in let s1 = s + poke-32 gpu-cmd (off + 4) y0
    in let s2 = s1 + poke-32 gpu-cmd (off + 8) x1
    in let s3 = s2 + poke-32 gpu-cmd (off + 12) y1
    in let s4 = s3 + poke-32 gpu-cmd (off + 16) x2
    in let s5 = s4 + poke-32 gpu-cmd (off + 20) y2
    in let s6 = s5 + poke-32 gpu-cmd (off + 24) c0
    in let s7 = s6 + poke-32 gpu-cmd (off + 28) c1
    in let s8 = s7 + poke-32 gpu-cmd (off + 32) c2
    in let s9 = s8 + poke-32 gpu-cmd (off + 36) 1000
    in let sa = s9 + poke-32 gpu-cmd (off + 40) 1000
    in let sb = sa + poke-32 gpu-cmd (off + 44) 1000
    in let sc = sb + poke-32 gpu-cmd (off + 48) 0
    in let sd = sc + poke-32 gpu-cmd (off + 52) 0
    in let se = sd + poke-32 gpu-cmd (off + 56) 0
    in let sf = se + poke-32 gpu-cmd (off + 60) 0
    in let sg = sf + poke-32 gpu-cmd (off + 64) 0
    in sg + poke-32 gpu-cmd (off + 68) 0

  gpu-tri-mid : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-tri-mid (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in let s = poke-32 gpu-cmd off x0
    in let s1 = s + poke-32 gpu-cmd (off + 4) y0
    in let s2 = s1 + poke-32 gpu-cmd (off + 8) x1
    in let s3 = s2 + poke-32 gpu-cmd (off + 12) y1
    in let s4 = s3 + poke-32 gpu-cmd (off + 16) x2
    in let s5 = s4 + poke-32 gpu-cmd (off + 20) y2
    in let s6 = s5 + poke-32 gpu-cmd (off + 24) c0
    in let s7 = s6 + poke-32 gpu-cmd (off + 28) c1
    in let s8 = s7 + poke-32 gpu-cmd (off + 32) c2
    in let s9 = s8 + poke-32 gpu-cmd (off + 36) 2000
    in let sa = s9 + poke-32 gpu-cmd (off + 40) 2000
    in let sb = sa + poke-32 gpu-cmd (off + 44) 2000
    in let sc = sb + poke-32 gpu-cmd (off + 48) 0
    in let sd = sc + poke-32 gpu-cmd (off + 52) 0
    in let se = sd + poke-32 gpu-cmd (off + 56) 0
    in let sf = se + poke-32 gpu-cmd (off + 60) 0
    in let sg = sf + poke-32 gpu-cmd (off + 64) 0
    in sg + poke-32 gpu-cmd (off + 68) 0

  gpu-rect-mid : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-rect-mid (idx) (x) (y) (w) (h) (color) =
    let t0 = gpu-tri-mid idx x y (x + w) y x (y + h) color color color
    in t0 + gpu-tri-mid (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-rect-chrome : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-rect-chrome (idx) (x) (y) (w) (h) (color) =
    let t0 = gpu-tri-chrome idx x y (x + w) y x (y + h) color color color
    in t0 + gpu-tri-chrome (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-tri-chrome : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-tri-chrome (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in let s = poke-32 gpu-cmd off x0
    in let s1 = s + poke-32 gpu-cmd (off + 4) y0
    in let s2 = s1 + poke-32 gpu-cmd (off + 8) x1
    in let s3 = s2 + poke-32 gpu-cmd (off + 12) y1
    in let s4 = s3 + poke-32 gpu-cmd (off + 16) x2
    in let s5 = s4 + poke-32 gpu-cmd (off + 20) y2
    in let s6 = s5 + poke-32 gpu-cmd (off + 24) c0
    in let s7 = s6 + poke-32 gpu-cmd (off + 28) c1
    in let s8 = s7 + poke-32 gpu-cmd (off + 32) c2
    in let s9 = s8 + poke-32 gpu-cmd (off + 36) 5000
    in let sa = s9 + poke-32 gpu-cmd (off + 40) 5000
    in let sb = sa + poke-32 gpu-cmd (off + 44) 5000
    in let sc = sb + poke-32 gpu-cmd (off + 48) 0
    in let sd = sc + poke-32 gpu-cmd (off + 52) 0
    in let se = sd + poke-32 gpu-cmd (off + 56) 0
    in let sf = se + poke-32 gpu-cmd (off + 60) 0
    in let sg = sf + poke-32 gpu-cmd (off + 64) 0
    in sg + poke-32 gpu-cmd (off + 68) 0

  gpu-rect-top : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gpu-rect-top (idx) (x) (y) (w) (h) (color) =
    let t0 = gpu-tri-front idx x y (x + w) y x (y + h) color color color
    in t0 + gpu-tri-front (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

Section: Tool Constants

  tool-select : Integer = 0
  tool-place : Integer = 1
  tool-wire : Integer = 2

  tool-name : Integer -> Text
  tool-name (t) = if t == 0 then "SELECT" else if t == 1 then "PLACE" else "WIRE"

Section: Menu Constants

  menu-none : Integer = 0
  menu-file : Integer = 1
  menu-edit : Integer = 2
  menu-view : Integer = 3
  menu-place : Integer = 4

Section: App Dimensions

  app-w : Integer = 1024
  app-h : Integer = 768
  canvas-top : Integer = 52
  max-tris : Integer = 15000

Section: App State

  AppState = record {
    as-input : InputState,
    as-viewport : ViewPort,
    as-items : List CanvasItem,
    as-history : EditHistory,
    as-tool : Integer,
    as-palette-idx : Integer,
    as-frame : Integer,
    as-quit : Integer,
    as-show-help : Integer,
    as-prev-left : Integer,
    as-prev-key : Integer,
    as-dragging : Integer,
    as-drag-ox : Integer,
    as-drag-oy : Integer,
    as-wire-active : Integer,
    as-wire-x : Integer,
    as-wire-y : Integer,
    as-menu-open : Integer,
    as-dirty : Integer
  }

Section: Init

  app-init : AppState
  app-init =
    let cw = app-w - sidebar-w
    in let ch = app-h - canvas-top - status-h
    in let vp = viewport-new 0 canvas-top cw ch
    in let vp2 = viewport-pan vp (-200) (-250)
    in AppState {
      as-input = input-new app-w app-h,
      as-viewport = vp2,
      as-items = build-demo-items,
      as-history = eh-new,
      as-tool = tool-select,
      as-palette-idx = 0,
      as-frame = 0,
      as-quit = 0,
      as-show-help = 0,
      as-prev-left = 0,
      as-prev-key = 0,
      as-dragging = 0,
      as-drag-ox = 0,
      as-drag-oy = 0,
      as-wire-active = 0,
      as-wire-x = 0,
      as-wire-y = 0,
      as-menu-open = menu-none,
      as-dirty = 0
    }

Section: Entry

  opening : [Console] Nothing = act
    let result = app-loop app-init
    in print-line ("Codex Circuits | " & (show result) & " frames")
  end

Section: Main Loop

  app-loop : AppState -> Integer
  app-loop (st) =
    let inp = input-poll (st.as-input)
    in let st2 = process-all st inp
    in if st2.as-quit == 1 then st2.as-frame
    else let total = render-frame st2
    in app-loop st2

Section: Master Input

  process-all : AppState, InputState -> AppState
  process-all (st) (inp) =
    let raw-key = inp.in-key
    in let key = if raw-key > 0 then if raw-key < 128 then if st.as-prev-key == 0 then raw-key else 0 else 0 else 0
    in let left-down = if inp.in-left == 1 then if st.as-prev-left == 0 then 1 else 0 else 0
    in let left-up = if inp.in-left == 0 then if st.as-prev-left == 1 then 1 else 0 else 0
    in let mx = inp.in-mx
    in let my = inp.in-my
    in let st2 = if st.as-menu-open /= menu-none then process-menu-input st inp key left-down mx my else process-normal st inp key left-down left-up mx my
    in AppState {
      as-input = inp,
      as-viewport = st2.as-viewport,
      as-items = st2.as-items,
      as-history = st2.as-history,
      as-tool = st2.as-tool,
      as-palette-idx = st2.as-palette-idx,
      as-frame = st.as-frame + 1,
      as-quit = st2.as-quit,
      as-show-help = st2.as-show-help,
      as-prev-left = inp.in-left,
      as-prev-key = raw-key,
      as-dragging = st2.as-dragging,
      as-drag-ox = st2.as-drag-ox,
      as-drag-oy = st2.as-drag-oy,
      as-wire-active = st2.as-wire-active,
      as-wire-x = st2.as-wire-x,
      as-wire-y = st2.as-wire-y,
      as-menu-open = st2.as-menu-open,
      as-dirty = st2.as-dirty
    }

Section: Menu Input

  process-menu-input : AppState, InputState, Integer, Integer, Integer, Integer -> AppState
  process-menu-input (st) (inp) (key) (left-down) (mx) (my) =
    if key == 1 then menu-close st
    else if left-down == 0 then st
    else if my < toolbar-h then process-menubar-click st mx
    else process-menu-item-click st mx my

  menu-close : AppState -> AppState
  menu-close (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = st.as-dirty
  }

  set-menu : AppState, Integer -> AppState
  set-menu (st) (m) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = m, as-dirty = st.as-dirty
  }

  process-menubar-click : AppState, Integer -> AppState
  process-menubar-click (st) (mx) = menubar-dispatch st mx (menubar-zone mx)

  menubar-zone : Integer -> Integer
  menubar-zone (mx) = mz-file mx

  mz-file : Integer -> Integer
  mz-file (mx) = if mx >= 4 then if mx < 54 then 1 else mz-edit mx else 0

  mz-edit : Integer -> Integer
  mz-edit (mx) = if mx >= 58 then if mx < 98 then 2 else mz-view mx else 0

  mz-view : Integer -> Integer
  mz-view (mx) = if mx >= 102 then if mx < 142 then 3 else mz-place mx else 0

  mz-place : Integer -> Integer
  mz-place (mx) = if mx >= 146 then if mx < 186 then 4 else 0 else 0

  menubar-dispatch : AppState, Integer, Integer -> AppState
  menubar-dispatch (st) (mx) (zone) =
    if zone == 1 then set-menu st (if st.as-menu-open == menu-file then menu-none else menu-file)
    else if zone == 2 then set-menu st (if st.as-menu-open == menu-edit then menu-none else menu-edit)
    else if zone == 3 then set-menu st (if st.as-menu-open == menu-view then menu-none else menu-view)
    else if zone == 4 then set-menu st (if st.as-menu-open == menu-place then menu-none else menu-place)
    else menu-close st

  process-menu-item-click : AppState, Integer, Integer -> AppState
  process-menu-item-click (st) (mx) (my) =
    if st.as-menu-open == menu-file then process-file-click st mx my
    else if st.as-menu-open == menu-edit then process-edit-click st mx my
    else if st.as-menu-open == menu-view then process-view-click st mx my
    else if st.as-menu-open == menu-place then process-place-click st mx my
    else menu-close st

  menu-item-hit : Integer, Integer, Integer, Integer, Integer -> Integer
  menu-item-hit (mx) (my) (menu-x) (menu-y) (idx) =
    let iy = menu-y + 2 + idx * 20
    in if mx >= menu-x then if mx < menu-x + 120 then if my >= iy then if my < iy + 20 then 1 else 0 else 0 else 0 else 0

  process-file-click : AppState, Integer, Integer -> AppState
  process-file-click (st) (mx) (my) =
    let bx = 4
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-file-new st
    else if menu-item-hit mx my bx by 1 == 1 then do-file-save st
    else if menu-item-hit mx my bx by 2 == 1 then do-file-load st
    else if menu-item-hit mx my bx by 3 == 1 then do-quit st
    else menu-close st

  process-edit-click : AppState, Integer, Integer -> AppState
  process-edit-click (st) (mx) (my) =
    let bx = 58
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-undo (menu-close st)
    else if menu-item-hit mx my bx by 1 == 1 then do-delete (menu-close st)
    else if menu-item-hit mx my bx by 2 == 1 then do-rotate (menu-close st)
    else if menu-item-hit mx my bx by 3 == 1 then do-duplicate (menu-close st)
    else if menu-item-hit mx my bx by 4 == 1 then do-select-all (menu-close st)
    else menu-close st

  process-view-click : AppState, Integer, Integer -> AppState
  process-view-click (st) (mx) (my) =
    let bx = 102
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-zoom-in (menu-close st)
    else if menu-item-hit mx my bx by 1 == 1 then do-zoom-out (menu-close st)
    else if menu-item-hit mx my bx by 2 == 1 then do-zoom-fit (menu-close st)
    else if menu-item-hit mx my bx by 3 == 1 then do-toggle-help (menu-close st)
    else menu-close st

  process-place-click : AppState, Integer, Integer -> AppState
  process-place-click (st) (mx) (my) =
    let bx = 146
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-set-palette (menu-close st) 0
    else if menu-item-hit mx my bx by 1 == 1 then do-set-palette (menu-close st) 1
    else if menu-item-hit mx my bx by 2 == 1 then do-set-palette (menu-close st) 2
    else if menu-item-hit mx my bx by 3 == 1 then do-set-palette (menu-close st) 3
    else if menu-item-hit mx my bx by 4 == 1 then do-set-palette (menu-close st) 4
    else if menu-item-hit mx my bx by 5 == 1 then do-set-palette (menu-close st) 5
    else menu-close st

Section: Menu Actions

  do-file-new : AppState -> AppState
  do-file-new (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = [], as-history = eh-new,
    as-tool = tool-select, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = menu-none, as-dirty = 0
  }

  do-file-save : AppState -> AppState
  do-file-save (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = 0
  }

  do-file-load : AppState -> AppState
  do-file-load (st) = menu-close st

  do-quit : AppState -> AppState
  do-quit (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 1,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = st.as-dirty
  }

  do-undo : AppState -> AppState
  do-undo (st) =
    if eh-can-undo (st.as-history) == 0 then st
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = eh-top (st.as-history), as-history = eh-pop (st.as-history),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = st.as-menu-open, as-dirty = 1
    }

  do-delete : AppState -> AppState
  do-delete (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = delete-selected (st.as-items), as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1
  }

  do-rotate : AppState -> AppState
  do-rotate (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = rotate-selected (st.as-items), as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1
  }

  do-duplicate : AppState -> AppState
  do-duplicate (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = duplicate-selected (st.as-items) 20, as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1
  }

  do-select-all : AppState -> AppState
  do-select-all (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = marquee-select (st.as-items) (-9999) (-9999) 9999 9999, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

  do-zoom-in : AppState -> AppState
  do-zoom-in (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-in (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

  do-zoom-out : AppState -> AppState
  do-zoom-out (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-out (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

  do-zoom-fit : AppState -> AppState
  do-zoom-fit (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-fit (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

  do-toggle-help : AppState -> AppState
  do-toggle-help (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = if st.as-show-help == 1 then 0 else 1,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

  do-set-palette : AppState, Integer -> AppState
  do-set-palette (st) (idx) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = tool-place, as-palette-idx = idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

Section: Normal Input

  process-normal : AppState, InputState, Integer, Integer, Integer, Integer, Integer -> AppState
  process-normal (st) (inp) (key) (left-down) (left-up) (mx) (my) =
    let vp2 = if inp.in-middle == 1 then viewport-pan (st.as-viewport) (inp.in-dx) (0 - inp.in-dy) else st.as-viewport
    in let vp3 = process-vp-keys vp2 key
    in let st2 = process-key-cmds st key
    in let st3 = process-mouse st2 inp left-down left-up mx my
    in AppState {
      as-input = inp,
      as-viewport = vp3,
      as-items = st3.as-items,
      as-history = st3.as-history,
      as-tool = st3.as-tool,
      as-palette-idx = st3.as-palette-idx,
      as-frame = st.as-frame,
      as-quit = 0,
      as-show-help = st3.as-show-help,
      as-prev-left = st.as-prev-left,
      as-prev-key = st.as-prev-key,
      as-dragging = st3.as-dragging,
      as-drag-ox = st3.as-drag-ox,
      as-drag-oy = st3.as-drag-oy,
      as-wire-active = st3.as-wire-active,
      as-wire-x = st3.as-wire-x,
      as-wire-y = st3.as-wire-y,
      as-menu-open = st3.as-menu-open,
      as-dirty = st3.as-dirty
    }

  process-vp-keys : ViewPort, Integer -> ViewPort
  process-vp-keys (vp) (key) =
    if key == 78 then viewport-zoom-in vp
    else if key == 74 then viewport-zoom-out vp
    else if key == 71 then viewport-zoom-fit vp
    else vp

  process-key-cmds : AppState, Integer -> AppState
  process-key-cmds (st) (key) =
    if key == 0 then st
    else if key == 31 then set-tool st tool-select
    else if key == 17 then set-tool st tool-wire
    else if key == 25 then set-tool st tool-place
    else if key == 35 then do-toggle-help st
    else if key == 83 then do-delete st
    else if key == 19 then do-rotate st
    else if key == 32 then do-duplicate st
    else if key == 44 then do-undo st
    else if key == 2 then do-set-palette st 0
    else if key == 3 then do-set-palette st 1
    else if key == 4 then do-set-palette st 2
    else if key == 5 then do-set-palette st 3
    else if key == 6 then do-set-palette st 4
    else if key == 7 then do-set-palette st 5
    else st

  set-tool : AppState, Integer -> AppState
  set-tool (st) (t) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = t, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty
  }

Section: Mouse Handling

  process-mouse : AppState, InputState, Integer, Integer, Integer, Integer -> AppState
  process-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if my < toolbar-h then process-toolbar-click st left-down mx
    else if mx >= app-w - sidebar-w then process-sidebar-click st left-down mx my
    else if my < canvas-top then st
    else if my >= app-h - status-h then st
    else process-canvas-mouse st inp left-down left-up mx my

  process-toolbar-click : AppState, Integer, Integer -> AppState
  process-toolbar-click (st) (left-down) (mx) =
    if left-down == 0 then st
    else toolbar-dispatch st (toolbar-zone mx)

  toolbar-zone : Integer -> Integer
  toolbar-zone (mx) = toolbar-zone-file mx

  toolbar-zone-file : Integer -> Integer
  toolbar-zone-file (mx) = if mx >= 4 then if mx < 54 then 1 else toolbar-zone-edit mx else 0

  toolbar-zone-edit : Integer -> Integer
  toolbar-zone-edit (mx) = if mx >= 58 then if mx < 98 then 2 else toolbar-zone-view mx else 0

  toolbar-zone-view : Integer -> Integer
  toolbar-zone-view (mx) = if mx >= 102 then if mx < 142 then 3 else toolbar-zone-place mx else 0

  toolbar-zone-place : Integer -> Integer
  toolbar-zone-place (mx) = if mx >= 146 then if mx < 186 then 4 else toolbar-zone-tools mx else 0

  toolbar-zone-tools : Integer -> Integer
  toolbar-zone-tools (mx) = if mx >= 210 then if mx < 250 then 5 else if mx >= 254 then if mx < 294 then 6 else if mx >= 298 then if mx < 338 then 7 else 0 else 0 else 0 else 0

  toolbar-dispatch : AppState, Integer -> AppState
  toolbar-dispatch (st) (zone) =
    if zone == 1 then set-menu st menu-file
    else if zone == 2 then set-menu st menu-edit
    else if zone == 3 then set-menu st menu-view
    else if zone == 4 then set-menu st menu-place
    else if zone == 5 then set-tool st tool-select
    else if zone == 6 then set-tool st tool-wire
    else if zone == 7 then set-tool st tool-place
    else st

  process-sidebar-click : AppState, Integer, Integer, Integer -> AppState
  process-sidebar-click (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let rel-y = my - canvas-top - 28
    in let idx = rel-y / 20
    in if idx < 0 then st
    else if idx >= palette-count then st
    else do-set-palette st idx

  process-canvas-mouse : AppState, InputState, Integer, Integer, Integer, Integer -> AppState
  process-canvas-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if st.as-tool == tool-select then process-select-mouse st inp left-down left-up mx my
    else if st.as-tool == tool-place then process-place-mouse st left-down mx my
    else process-wire-mouse st left-down mx my

  process-select-mouse : AppState, InputState, Integer, Integer, Integer, Integer -> AppState
  process-select-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if left-down == 1 then do-select-start st mx my
    else if left-up == 1 then do-drag-end st
    else if inp.in-left == 1 then do-drag-continue st mx my
    else st

  do-select-start : AppState, Integer, Integer -> AppState
  do-select-start (st) (mx) (my) =
    let wx = vp-screen-to-world-x (st.as-viewport) mx
    in let wy = vp-screen-to-world-y (st.as-viewport) my
    in let hit = hit-test-items (st.as-items) wx wy 0 0
    in if hit < 0 then AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = deselect-all (st.as-items), as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = st.as-dirty
    }
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = select-only (st.as-items) hit, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1
    }

  do-drag-continue : AppState, Integer, Integer -> AppState
  do-drag-continue (st) (mx) (my) =
    if st.as-dragging == 0 then st
    else let dx = mx - st.as-drag-ox
    in let dy = my - st.as-drag-oy
    in if dx == 0 then if dy == 0 then st else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = move-selected (st.as-items) 0 dy, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1
    }
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = move-selected (st.as-items) dx dy, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1
    }

  do-drag-end : AppState -> AppState
  do-drag-end (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = st.as-dirty
  }

  process-place-mouse : AppState, Integer, Integer, Integer -> AppState
  process-place-mouse (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let vp = st.as-viewport
    in let wx = grid-snap (vp-screen-to-world-x vp mx) (vp.vp-grid)
    in let wy = grid-snap (vp-screen-to-world-y vp my) (vp.vp-grid)
    in let pe = palette-at (st.as-palette-idx)
    in let nid = next-item-id (st.as-items)
    in let ref = auto-ref (pe.pe-prefix) (st.as-items)
    in let items2 = place-component (st.as-items) nid wx wy pe ref
    in AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = items2, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1
    }

  process-wire-mouse : AppState, Integer, Integer, Integer -> AppState
  process-wire-mouse (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let vp = st.as-viewport
    in let wx = grid-snap (vp-screen-to-world-x vp mx) (vp.vp-grid)
    in let wy = grid-snap (vp-screen-to-world-y vp my) (vp.vp-grid)
    in if st.as-wire-active == 0 then AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = st.as-items, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 1, as-wire-x = wx, as-wire-y = wy,
      as-menu-open = menu-none, as-dirty = st.as-dirty
    }
    else let nid = next-item-id (st.as-items)
    in let items2 = place-wire-seg (st.as-items) nid (st.as-wire-x) (st.as-wire-y) wx wy
    in AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = items2, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1
    }

Section: Render Frame

  render-frame : AppState -> Integer
  render-frame (st) =
    let cl = port-out-32 1025 col-bg
    in let cd = cl + port-out-32 1026 0
    in let n0 = 0
    in let n1 = draw-menubar-bg n0 st
    in let n2 = draw-menubar-text n1 st
    in let n3 = draw-tab-bar-bg n2
    in let n4 = draw-tab-bar-text n3
    in let n5 = draw-grid-gpu n4 (st.as-viewport)
    in let n6 = draw-items-gpu n5 (st.as-items) (st.as-viewport)
    in let n7 = draw-item-refs n6 (st.as-items) (st.as-viewport)
    in let n8 = draw-wire-preview n7 st
    in let n9 = draw-place-ghost n8 st
    in let na = draw-sidebar-bg n9 (st.as-palette-idx)
    in let nb = draw-sidebar-text na (st.as-palette-idx)
    in let nc = draw-status-bg nb st
    in let nd = draw-status-text-all nc st
    in let ne = draw-crosshair-gpu nd (st.as-input.in-mx) (st.as-input.in-my) (st.as-viewport)
    in let nf = if st.as-menu-open /= menu-none then draw-dropdown ne st else ne
    in let ng = if st.as-show-help == 1 then draw-help-gpu nf else nf
    in port-out-32 1024 ng

Section: Grid

  draw-grid-gpu : Integer, ViewPort -> Integer
  draw-grid-gpu (n) (vp) =
    let gz = vp.vp-grid * vp.vp-zoom / 100
    in if gz < 8 then n
    else draw-grid-dots n (vp.vp-canvas-x) (vp.vp-canvas-y) (vp.vp-canvas-w) (vp.vp-canvas-h) gz col-grid 0

  draw-grid-dots : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-grid-dots (n) (cx) (cy) (cw) (ch) (gz) (color) (i) =
    let x = cx + (i * gz + gz / 2)
    in if x >= cx + cw then n
    else if n >= max-tris then n
    else let n2 = draw-grid-col n x cy ch gz color 0
    in draw-grid-dots n2 cx cy cw ch gz color (i + 1)

  draw-grid-col : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-grid-col (n) (x) (cy) (ch) (gz) (color) (j) =
    let y = cy + (j * gz + gz / 2)
    in if y >= cy + ch then n
    else if n >= max-tris then n
    else let w = gpu-rect n x y 1 1 color
    in draw-grid-col (n + 2) x cy ch gz color (j + 1)

Section: Draw Items

  draw-items-gpu : Integer, List CanvasItem, ViewPort -> Integer
  draw-items-gpu (n) (items) (vp) =
    draw-item-loop n items vp 0 (list-length items)

  draw-item-loop : Integer, List CanvasItem, ViewPort, Integer, Integer -> Integer
  draw-item-loop (n) (items) (vp) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in let sx = vp-world-to-screen-x vp (item.ci-x)
    in let sy = vp-world-to-screen-y vp (item.ci-y)
    in let sw = item.ci-w * vp.vp-zoom / 100
    in let sh = item.ci-h * vp.vp-zoom / 100
    in let color = if item.ci-selected == 1 then col-selection else item.ci-color
    in let n2 = draw-item-shape n item sx sy sw sh color
    in let n3 = if item.ci-selected == 1 then draw-sel-box n2 sx sy sw sh else n2
    in draw-item-loop n3 items vp (i + 1) count

  draw-item-shape : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-item-shape (n) (item) (sx) (sy) (sw) (sh) (color) =
    when item.ci-kind
      is CiComponent -> draw-comp-shape n item sx sy sw sh color
      is CiWire -> let rw = if sw < 1 then 1 else sw in let rh = if sh < 1 then 1 else sh in let w0 = gpu-rect n sx sy rw rh color in n + 2
      is CiLabel -> draw-gpu-text n sx sy (item.ci-ref) color max-tris
      is CiJunction -> let w0 = gpu-rect n (sx - 3) (sy - 3) 6 6 color in n + 2
      is CiPowerRail -> let rw = if sw < 1 then 1 else sw in let w0 = gpu-rect n sx sy rw 1 color in n + 2

  draw-comp-shape : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-comp-shape (n) (item) (sx) (sy) (sw) (sh) (color) =
    when item.ci-subtype
      is SubIc -> draw-ic-gpu n sx sy sw sh color (item.ci-pins-left) (item.ci-pins-right)
      is SubResistor -> draw-res-gpu n sx sy sw sh color
      is SubCapacitor -> draw-cap-gpu n sx sy sh color
      is SubLed -> draw-led-gpu n sx sy sw sh color
      is SubConnector -> draw-conn-gpu n sx sy sw sh color (item.ci-pins-right)
      is SubSwitch -> draw-sw-gpu n sx sy sw color
      is SubGeneric -> let w0 = gpu-rect n sx sy sw sh color in n + 2

  draw-ic-gpu : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-ic-gpu (n) (x) (y) (w) (h) (color) (pl) (pr) =
    let w0 = gpu-rect n x y w 1 color
    in let w1 = w0 + gpu-rect (n + 2) x (y + h - 1) w 1 color
    in let w2 = w1 + gpu-rect (n + 4) x y 1 h color
    in let w3 = w2 + gpu-rect (n + 6) (x + w - 1) y 1 h color
    in let w4 = w3 + gpu-tri (n + 8) (x + w / 2 - 4) y (x + w / 2 + 4) y (x + w / 2) (y + 6) col-text-dim col-text-dim col-text-dim
    in let n2 = n + 9
    in let n3 = draw-pins-side n2 (x - 10) y h pl 10 0
    in draw-pins-side n3 (x + w) y h pr 10 0

  draw-pins-side : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-pins-side (n) (px) (y) (h) (count) (pw) (i) =
    if i >= count then n
    else if n >= max-tris then n
    else let py = y + 8 + i * ((h - 16) / (if count > 1 then count - 1 else 1))
    in let w = gpu-rect n px py pw 1 col-pin
    in draw-pins-side (n + 2) px y h count pw (i + 1)

  draw-res-gpu : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-res-gpu (n) (x) (y) (w) (h) (color) =
    let w0 = gpu-rect n x y w h #2A2A2A
    in let w1 = w0 + gpu-rect (n + 2) x y w 1 color
    in let w2 = w1 + gpu-rect (n + 4) x (y + h - 1) w 1 color
    in let w3 = w2 + gpu-rect (n + 6) x y 1 h color
    in let w4 = w3 + gpu-rect (n + 8) (x + w - 1) y 1 h color
    in let w5 = w4 + gpu-rect (n + 10) (x - 10) (y + h / 2) 10 1 col-pin
    in let w6 = w5 + gpu-rect (n + 12) (x + w) (y + h / 2) 10 1 col-pin
    in n + 14

  draw-cap-gpu : Integer, Integer, Integer, Integer, Integer -> Integer
  draw-cap-gpu (n) (x) (y) (h) (color) =
    let mx = x + 8
    in let w0 = gpu-rect n mx y 1 (h / 3) color
    in let w1 = w0 + gpu-rect (n + 2) (x + 2) (y + h / 3) 12 2 color
    in let w2 = w1 + gpu-rect (n + 4) (x + 2) (y + h * 2 / 3) 12 2 color
    in let w3 = w2 + gpu-rect (n + 6) mx (y + h * 2 / 3 + 2) 1 (h / 3) color
    in n + 8

  draw-led-gpu : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-led-gpu (n) (x) (y) (w) (h) (color) =
    let w0 = gpu-tri n x y x (y + h) (x + w) (y + h / 2) color color color
    in let w1 = w0 + gpu-rect (n + 1) (x + w) y 2 h color
    in let w2 = w1 + gpu-rect (n + 3) (x - 10) (y + h / 2) 10 1 col-pin
    in let w3 = w2 + gpu-rect (n + 5) (x + w + 2) (y + h / 2) 10 1 col-pin
    in n + 7

  draw-conn-gpu : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  draw-conn-gpu (n) (x) (y) (w) (h) (color) (pins) =
    let w0 = gpu-rect n x y w h color
    in let w1 = w0 + gpu-rect (n + 2) x y w 1 col-text-dim
    in let w2 = w1 + gpu-rect (n + 4) x (y + h - 1) w 1 col-text-dim
    in draw-pins-side (n + 6) (x + w) y h pins 10 0

  draw-sw-gpu : Integer, Integer, Integer, Integer, Integer -> Integer
  draw-sw-gpu (n) (x) (y) (w) (color) =
    let w0 = gpu-rect n (x - 10) (y + 7) 10 1 color
    in let w1 = w0 + gpu-rect (n + 2) (x + w) (y + 7) 10 1 color
    in let w2 = w1 + gpu-rect (n + 4) (x + w / 2) y 1 7 color
    in n + 6

Section: Selection Box

  draw-sel-box : Integer, Integer, Integer, Integer, Integer -> Integer
  draw-sel-box (n) (x) (y) (w) (h) =
    let m = 2
    in let w0 = gpu-rect n (x - m) (y - m) (w + m * 2) m #FFFFFF
    in let w1 = w0 + gpu-rect (n + 2) (x - m) (y + h) (w + m * 2) m #FFFFFF
    in let w2 = w1 + gpu-rect (n + 4) (x - m) y m h #FFFFFF
    in let w3 = w2 + gpu-rect (n + 6) (x + w) y m h #FFFFFF
    in n + 8

Section: Item Refs

  draw-item-refs : Integer, List CanvasItem, ViewPort -> Integer
  draw-item-refs (n) (items) (vp) = draw-ref-loop n items vp 0 (list-length items)

  draw-ref-loop : Integer, List CanvasItem, ViewPort, Integer, Integer -> Integer
  draw-ref-loop (n) (items) (vp) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in let n2 = draw-ref-if-comp n item vp
    in draw-ref-loop n2 items vp (i + 1) count

  draw-ref-if-comp : Integer, CanvasItem, ViewPort -> Integer
  draw-ref-if-comp (n) (item) (vp) =
    when item.ci-kind
      is CiComponent -> if text-length (item.ci-ref) == 0 then n else draw-gpu-text n (vp-world-to-screen-x vp (item.ci-x)) (vp-world-to-screen-y vp (item.ci-y) - 9) (item.ci-ref) col-refdes max-tris
      is otherwise -> n

Section: Wire Preview

  draw-wire-preview : Integer, AppState -> Integer
  draw-wire-preview (n) (st) =
    if st.as-wire-active == 0 then n
    else let vp = st.as-viewport
    in let sx1 = vp-world-to-screen-x vp (st.as-wire-x)
    in let sy1 = vp-world-to-screen-y vp (st.as-wire-y)
    in let sx2 = st.as-input.in-mx
    in let sy2 = st.as-input.in-my
    in let rw = if sx1 < sx2 then sx2 - sx1 else sx1 - sx2
    in let rh = if sy1 < sy2 then sy2 - sy1 else sy1 - sy2
    in let lx = if sx1 < sx2 then sx1 else sx2
    in let ly = if sy1 < sy2 then sy1 else sy2
    in let w0 = gpu-rect n lx sy1 (if rw < 1 then 1 else rw) 1 col-wire
    in let w1 = w0 + gpu-rect (n + 2) sx2 ly 1 (if rh < 1 then 1 else rh) col-wire
    in n + 4

Section: Placement Ghost

  draw-place-ghost : Integer, AppState -> Integer
  draw-place-ghost (n) (st) =
    if st.as-tool /= tool-place then n
    else let mx = st.as-input.in-mx
    in let my = st.as-input.in-my
    in let cw = app-w - sidebar-w
    in if mx >= cw then n
    else if my < canvas-top then n
    else if my >= app-h - status-h then n
    else let pe = palette-at (st.as-palette-idx)
    in let gw = pe.pe-w
    in let gh = pe.pe-h
    in let gx = mx - gw / 2
    in let gy = my - gh / 2
    in let w0 = gpu-rect n gx gy gw gh #335577
    in let w1 = w0 + gpu-rect (n + 2) gx gy gw 1 col-selection
    in let w2 = w1 + gpu-rect (n + 4) gx (gy + gh - 1) gw 1 col-selection
    in let w3 = w2 + gpu-rect (n + 6) gx gy 1 gh col-selection
    in let w4 = w3 + gpu-rect (n + 8) (gx + gw - 1) gy 1 gh col-selection
    in let n2 = n + 10
    in draw-gpu-text n2 gx (gy - 9) (pe.pe-name) col-selection max-tris

Section: Menu Bar

  btn-hover : Integer, Integer, Integer, Integer -> Integer
  btn-hover (mx) (my) (lo) (hi) =
    if mx >= lo then if mx < hi then if my < toolbar-h then 1 else 0 else 0 else 0

  draw-menubar-bg : Integer, AppState -> Integer
  draw-menubar-bg (n) (st) =
    let tool = st.as-tool
    in let mx = st.as-input.in-mx
    in let my = st.as-input.in-my
    in let w0 = gpu-rect n 0 0 app-w toolbar-h col-toolbar
    in let file-bg = if st.as-menu-open == menu-file then col-accent else if btn-hover mx my 4 54 == 1 then #1A3A70 else col-toolbar
    in let edit-bg = if st.as-menu-open == menu-edit then col-accent else if btn-hover mx my 58 98 == 1 then #1A3A70 else col-toolbar
    in let view-bg = if st.as-menu-open == menu-view then col-accent else if btn-hover mx my 102 142 == 1 then #1A3A70 else col-toolbar
    in let place-bg = if st.as-menu-open == menu-place then col-accent else if btn-hover mx my 146 186 == 1 then #1A3A70 else col-toolbar
    in let w1 = w0 + gpu-rect (n + 2) 4 4 50 20 file-bg
    in let w2 = w1 + gpu-rect (n + 4) 58 4 40 20 edit-bg
    in let w3 = w2 + gpu-rect (n + 6) 102 4 40 20 view-bg
    in let w4 = w3 + gpu-rect (n + 8) 146 4 40 20 place-bg
    in let w5 = w4 + gpu-rect (n + 10) 200 4 3 20 #444466
    in let sel-c = if tool == tool-select then col-accent else col-panel
    in let wir-c = if tool == tool-wire then col-accent else col-panel
    in let plc-c = if tool == tool-place then col-accent else col-panel
    in let w6 = w5 + gpu-rect (n + 12) 210 4 40 20 sel-c
    in let w7 = w6 + gpu-rect (n + 14) 254 4 40 20 wir-c
    in let w8 = w7 + gpu-rect (n + 16) 298 4 40 20 plc-c
    in let dirty-c = if st.as-dirty == 1 then col-accent else col-toolbar
    in let w9 = w8 + gpu-rect (n + 18) (app-w - 60) 4 56 20 dirty-c
    in n + 20

  draw-menubar-text : Integer, AppState -> Integer
  draw-menubar-text (n) (st) =
    let n1 = draw-gpu-text-chrome n 12 10 "FILE" col-text max-tris
    in let n2 = draw-gpu-text-chrome n1 65 10 "EDIT" col-text max-tris
    in let n3 = draw-gpu-text-chrome n2 109 10 "VIEW" col-text max-tris
    in let n4 = draw-gpu-text-chrome n3 149 10 "PLACE" col-text max-tris
    in let n5 = draw-gpu-text-chrome n4 216 10 "SEL" col-text max-tris
    in let n6 = draw-gpu-text-chrome n5 260 10 "WIRE" col-text max-tris
    in let n7 = draw-gpu-text-chrome n6 304 10 "PLCE" col-text max-tris
    in draw-gpu-text-chrome n7 (app-w - 54) 10 (if st.as-dirty == 1 then "UNSAVED" else "SAVED") col-text max-tris

Section: Dropdown Menus

  draw-dropdown : Integer, AppState -> Integer
  draw-dropdown (n) (st) =
    let n2 = draw-dropdown-bg n st
    in draw-dropdown-text n2 st

  draw-dropdown-bg : Integer, AppState -> Integer
  draw-dropdown-bg (n) (st) =
    if st.as-menu-open == menu-file then draw-file-bg n st
    else if st.as-menu-open == menu-edit then draw-edit-bg n st
    else if st.as-menu-open == menu-view then draw-view-bg n st
    else if st.as-menu-open == menu-place then draw-place-bg n st
    else n

  draw-dropdown-text : Integer, AppState -> Integer
  draw-dropdown-text (n) (st) =
    if st.as-menu-open == menu-file then draw-file-items n st
    else if st.as-menu-open == menu-edit then draw-edit-items n st
    else if st.as-menu-open == menu-view then draw-view-items n st
    else if st.as-menu-open == menu-place then draw-place-items n st
    else n

  draw-menu-bg : Integer, Integer, Integer, Integer -> Integer
  draw-menu-bg (n) (x) (y) (count) =
    let mh = count * 20 + 4
    in let w0 = gpu-rect-mid n x y 124 mh #0A0A1E
    in let w1 = w0 + gpu-rect-mid (n + 2) x y 124 1 col-accent
    in let w2 = w1 + gpu-rect-mid (n + 4) x (y + mh - 1) 124 1 col-accent
    in let w3 = w2 + gpu-rect-mid (n + 6) x y 1 mh col-accent
    in let w4 = w3 + gpu-rect-mid (n + 8) (x + 123) y 1 mh col-accent
    in n + 10

  draw-menu-item-bg : Integer, Integer, Integer, Integer, AppState -> Integer
  draw-menu-item-bg (n) (x) (y) (idx) (st) =
    let iy = y + 2 + idx * 20
    in let mx = st.as-input.in-mx
    in let my = st.as-input.in-my
    in let hover = if mx >= x then if mx < x + 120 then if my >= iy then if my < iy + 20 then 1 else 0 else 0 else 0 else 0
    in let bg = if hover == 1 then col-accent else #0A0A1E
    in let w0 = gpu-rect-mid n (x + 2) iy 120 20 bg
    in n + 2

  draw-menu-item-text : Integer, Integer, Integer, Integer, Text, Integer -> Integer
  draw-menu-item-text (n) (x) (y) (idx) (label) (color) =
    let iy = y + 2 + idx * 20
    in draw-gpu-text n (x + 8) (iy + 6) label color max-tris

  draw-file-bg : Integer, AppState -> Integer
  draw-file-bg (n) (st) = let n2 = draw-menu-bg n 4 toolbar-h 4 in let n3 = draw-menu-item-bg n2 4 toolbar-h 0 st in let n4 = draw-menu-item-bg n3 4 toolbar-h 1 st in let n5 = draw-menu-item-bg n4 4 toolbar-h 2 st in draw-menu-item-bg n5 4 toolbar-h 3 st

  draw-file-items : Integer, AppState -> Integer
  draw-file-items (n) (st) = let n2 = draw-menu-item-text n 4 toolbar-h 0 "NEW" col-text in let n3 = draw-menu-item-text n2 4 toolbar-h 1 "SAVE" col-text in let n4 = draw-menu-item-text n3 4 toolbar-h 2 "LOAD" col-text-dim in draw-menu-item-text n4 4 toolbar-h 3 "QUIT" col-text

  draw-edit-bg : Integer, AppState -> Integer
  draw-edit-bg (n) (st) = let n2 = draw-menu-bg n 58 toolbar-h 5 in let n3 = draw-menu-item-bg n2 58 toolbar-h 0 st in let n4 = draw-menu-item-bg n3 58 toolbar-h 1 st in let n5 = draw-menu-item-bg n4 58 toolbar-h 2 st in let n6 = draw-menu-item-bg n5 58 toolbar-h 3 st in draw-menu-item-bg n6 58 toolbar-h 4 st

  draw-edit-items : Integer, AppState -> Integer
  draw-edit-items (n) (st) = let n2 = draw-menu-item-text n 58 toolbar-h 0 "UNDO      Z" col-text in let n3 = draw-menu-item-text n2 58 toolbar-h 1 "DELETE  DEL" col-text in let n4 = draw-menu-item-text n3 58 toolbar-h 2 "ROTATE    R" col-text in let n5 = draw-menu-item-text n4 58 toolbar-h 3 "DUPLICATE D" col-text in draw-menu-item-text n5 58 toolbar-h 4 "SELECT ALL" col-text

  draw-view-bg : Integer, AppState -> Integer
  draw-view-bg (n) (st) = let n2 = draw-menu-bg n 102 toolbar-h 4 in let n3 = draw-menu-item-bg n2 102 toolbar-h 0 st in let n4 = draw-menu-item-bg n3 102 toolbar-h 1 st in let n5 = draw-menu-item-bg n4 102 toolbar-h 2 st in draw-menu-item-bg n5 102 toolbar-h 3 st

  draw-view-items : Integer, AppState -> Integer
  draw-view-items (n) (st) = let n2 = draw-menu-item-text n 102 toolbar-h 0 "ZOOM IN  +" col-text in let n3 = draw-menu-item-text n2 102 toolbar-h 1 "ZOOM OUT -" col-text in let n4 = draw-menu-item-text n3 102 toolbar-h 2 "FIT  HOME" col-text in draw-menu-item-text n4 102 toolbar-h 3 "HELP     H" col-text

  draw-place-bg : Integer, AppState -> Integer
  draw-place-bg (n) (st) = let n2 = draw-menu-bg n 146 toolbar-h 6 in let n3 = draw-menu-item-bg n2 146 toolbar-h 0 st in let n4 = draw-menu-item-bg n3 146 toolbar-h 1 st in let n5 = draw-menu-item-bg n4 146 toolbar-h 2 st in let n6 = draw-menu-item-bg n5 146 toolbar-h 3 st in let n7 = draw-menu-item-bg n6 146 toolbar-h 4 st in draw-menu-item-bg n7 146 toolbar-h 5 st

  draw-place-items : Integer, AppState -> Integer
  draw-place-items (n) (st) = let n2 = draw-menu-item-text n 146 toolbar-h 0 "RESISTOR  1" col-text in let n3 = draw-menu-item-text n2 146 toolbar-h 1 "CAPACITOR 2" col-text in let n4 = draw-menu-item-text n3 146 toolbar-h 2 "LED       3" col-text in let n5 = draw-menu-item-text n4 146 toolbar-h 3 "IC        4" col-text in let n6 = draw-menu-item-text n5 146 toolbar-h 4 "CONNECTOR 5" col-text in draw-menu-item-text n6 146 toolbar-h 5 "SWITCH    6" col-text

Section: Tab Bar

  draw-tab-bar-bg : Integer -> Integer
  draw-tab-bar-bg (n) =
    let y = toolbar-h
    in let w0 = gpu-rect n 0 y app-w tab-h col-panel
    in let w1 = w0 + gpu-rect (n + 2) 2 (y + 2) 80 20 col-bg
    in let w2 = w1 + gpu-rect (n + 4) 2 (y + 22) 80 2 col-accent
    in let w3 = w2 + gpu-rect (n + 6) 86 (y + 2) 70 20 col-toolbar
    in let w4 = w3 + gpu-rect (n + 8) 160 (y + 2) 80 20 col-toolbar
    in let w5 = w4 + gpu-rect (n + 10) 244 (y + 2) 60 20 col-toolbar
    in n + 12

  draw-tab-bar-text : Integer -> Integer
  draw-tab-bar-text (n) =
    let y = toolbar-h
    in let n1 = draw-gpu-text-chrome n 10 (y + 8) "SCHEMATIC" #FFFFFF max-tris
    in let n2 = draw-gpu-text-chrome n1 94 (y + 8) "PCB" col-text-dim max-tris
    in let n3 = draw-gpu-text-chrome n2 168 (y + 8) "3D VIEW" col-text-dim max-tris
    in draw-gpu-text-chrome n3 252 (y + 8) "SIM" col-text-dim max-tris

Section: Sidebar

  draw-sidebar-bg : Integer, Integer -> Integer
  draw-sidebar-bg (n) (pal-idx) =
    let sx = app-w - sidebar-w
    in let sh = app-h - canvas-top - status-h
    in let w0 = gpu-rect n sx canvas-top sidebar-w sh col-panel
    in let w1 = w0 + gpu-rect (n + 2) sx canvas-top 1 sh #444466
    in let w2 = w1 + gpu-rect (n + 4) (sx + 4) (canvas-top + 4) 192 16 col-toolbar
    in let n2 = n + 6
    in draw-palette-bg n2 sx (canvas-top + 28) pal-idx 0

  draw-palette-bg : Integer, Integer, Integer, Integer, Integer -> Integer
  draw-palette-bg (n) (sx) (y) (sel) (i) =
    if i >= palette-count then n
    else let bg = if i == sel then col-accent else col-toolbar
    in let w0 = gpu-rect n (sx + 4) (y + i * 20) 192 16 bg
    in draw-palette-bg (n + 2) sx y sel (i + 1)

  draw-sidebar-text : Integer, Integer -> Integer
  draw-sidebar-text (n) (pal-idx) =
    let sx = app-w - sidebar-w
    in let n2 = draw-gpu-text-chrome n (sx + 8) (canvas-top + 8) "COMPONENTS" col-text max-tris
    in draw-palette-text n2 sx (canvas-top + 28) pal-idx 0

  draw-palette-text : Integer, Integer, Integer, Integer, Integer -> Integer
  draw-palette-text (n) (sx) (y) (sel) (i) =
    if i >= palette-count then n
    else if n >= max-tris then n
    else let pe = palette-at i
    in let label = (show (i + 1)) & " " & (pe.pe-name)
    in let n2 = draw-gpu-text-chrome n (sx + 8) (y + i * 20 + 4) label col-text max-tris
    in draw-palette-text n2 sx y sel (i + 1)

Section: Status Bar

  draw-status-bg : Integer, AppState -> Integer
  draw-status-bg (n) (st) =
    let sy = app-h - status-h
    in let w0 = gpu-rect n 0 sy app-w status-h col-toolbar
    in n + 2

  draw-status-text-all : Integer, AppState -> Integer
  draw-status-text-all (n) (st) =
    let sy = app-h - status-h
    in let vp = st.as-viewport
    in let wx = vp-screen-to-world-x vp (st.as-input.in-mx)
    in let wy = vp-screen-to-world-y vp (st.as-input.in-my)
    in let item-count = list-length (st.as-items)
    in let sel-count = count-selected (st.as-items)
    in let n2 = n
    in let n3 = draw-gpu-text-chrome n2 4 (sy + 6) ("X:" & (show wx)) col-wire max-tris
    in let n4 = draw-gpu-text-chrome n3 80 (sy + 6) ("Y:" & (show wy)) col-wire max-tris
    in let n5 = draw-gpu-text-chrome n4 160 (sy + 6) (tool-name (st.as-tool)) col-accent max-tris
    in let n6 = draw-gpu-text-chrome n5 260 (sy + 6) ((show item-count) & " ITEMS") col-text-dim max-tris
    in let n7 = draw-gpu-text-chrome n6 380 (sy + 6) ((show sel-count) & " SEL") col-text-dim max-tris
    in let n8 = draw-gpu-text-chrome n7 480 (sy + 6) ((show (vp.vp-zoom)) & "%") col-text-dim max-tris
    in draw-gpu-text-chrome n8 560 (sy + 6) ("G:" & (show (vp.vp-grid))) col-text-dim max-tris

Section: Crosshair

  draw-crosshair-gpu : Integer, Integer, Integer, ViewPort -> Integer
  draw-crosshair-gpu (n) (mx) (my) (vp) =
    if mx < vp.vp-canvas-x then n
    else if mx >= vp.vp-canvas-x + vp.vp-canvas-w then n
    else if my < vp.vp-canvas-y then n
    else if my >= vp.vp-canvas-y + vp.vp-canvas-h then n
    else let cs = 10
    in let w0 = gpu-rect-top n (mx - cs) my (cs * 2) 1 #FFFFFF
    in let w1 = w0 + gpu-rect-top (n + 2) mx (my - cs) 1 (cs * 2) #FFFFFF
    in n + 4

Section: Help Overlay

  draw-help-gpu : Integer -> Integer
  draw-help-gpu (n) =
    let ox = 180
    in let oy = 100
    in let ow = 540
    in let oh = 460
    in let w0 = gpu-rect-mid n ox oy ow oh #0A0A1E
    in let w1 = w0 + gpu-rect-mid (n + 2) ox oy ow 2 col-accent
    in let w2 = w1 + gpu-rect-mid (n + 4) ox (oy + oh - 2) ow 2 col-accent
    in let w3 = w2 + gpu-rect-mid (n + 6) ox oy 2 oh col-accent
    in let w4 = w3 + gpu-rect-mid (n + 8) (ox + ow - 2) oy 2 oh col-accent
    in let n2 = n + 10
    in let n3 = draw-gpu-text n2 (ox + 10) (oy + 10) "CODEX CIRCUITS V2.0" col-accent max-tris
    in let n4 = draw-gpu-text n3 (ox + 10) (oy + 35) "MENUS: CLICK FILE/EDIT/VIEW/PLACE" col-text max-tris
    in let n5 = draw-gpu-text n4 (ox + 10) (oy + 55) "TOOLS: S=SELECT  W=WIRE  P=PLACE" col-text max-tris
    in let n6 = draw-gpu-text n5 (ox + 10) (oy + 75) "1-6   SELECT COMPONENT TYPE" col-text max-tris
    in let n7 = draw-gpu-text n6 (ox + 10) (oy + 100) "SELECT: CLICK TO PICK, DRAG TO MOVE" col-text max-tris
    in let n8 = draw-gpu-text n7 (ox + 10) (oy + 120) "WIRE: CLICK START, CLICK END" col-text max-tris
    in let n9 = draw-gpu-text n8 (ox + 10) (oy + 140) "PLACE: CLICK CANVAS TO DROP COMPONENT" col-text max-tris
    in let na = draw-gpu-text n9 (ox + 10) (oy + 165) "DEL=DELETE  R=ROTATE  D=DUPLICATE" col-text max-tris
    in let nb = draw-gpu-text na (ox + 10) (oy + 185) "Z=UNDO  Q=QUIT  H=THIS HELP" col-text max-tris
    in let nc = draw-gpu-text nb (ox + 10) (oy + 210) "MIDDLE DRAG = PAN CANVAS" col-text max-tris
    in let nd = draw-gpu-text nc (ox + 10) (oy + 230) "NUM+/- = ZOOM  HOME = RESET VIEW" col-text max-tris
    in let ne = draw-gpu-text nd (ox + 10) (oy + 260) "SIDEBAR: CLICK COMPONENT TO SELECT" col-text-dim max-tris
    in let nf = draw-gpu-text ne (ox + 10) (oy + 280) "FILE > SAVE WRITES TO DISK" col-text-dim max-tris
    in let ng = draw-gpu-text nf (ox + 10) (oy + 300) "FILE > NEW CLEARS THE SCHEMATIC" col-text-dim max-tris
    in let nh = draw-gpu-text ng (ox + 10) (oy + 330) "GRID SNAP + UNDO STACK + DIRTY FLAG" #444466 max-tris
    in draw-gpu-text nh (ox + 10) (oy + 350) "ROTATE + DUPLICATE + SELECT ALL" #444466 max-tris
