Chapter: CircuitsApp
  cites Foreword chapter List
  cites Foreword chapter Console
  cites UI chapter InputSource
  cites UI chapter Canvas

 Codex Circuits v2.0 — interactive EDA application.
 CanvasModel items, ViewPort transforms, InputSource polling,
 BitmapFont text, dropdown menus, disk save/load.

Section: GPU Constants

  gpu-cmd : Integer = #BE000000

Section: GPU Primitives

  gpu-seq : Integer, Integer -> Integer
  gpu-seq (written) (r) = r

  gpu-tri : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-tri (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in gpu-mem-write gpu-cmd off x0 + gpu-mem-write gpu-cmd (off + 4) y0 + gpu-mem-write gpu-cmd (off + 8) x1 + gpu-mem-write gpu-cmd (off + 12) y1 + gpu-mem-write gpu-cmd (off + 16) x2 + gpu-mem-write gpu-cmd (off + 20) y2 + gpu-mem-write gpu-cmd (off + 24) c0 + gpu-mem-write gpu-cmd (off + 28) c1 + gpu-mem-write gpu-cmd (off + 32) c2 + gpu-mem-write gpu-cmd (off + 36) 10000 + gpu-mem-write gpu-cmd (off + 40) 10000 + gpu-mem-write gpu-cmd (off + 44) 10000 + gpu-mem-write gpu-cmd (off + 48) 0 + gpu-mem-write gpu-cmd (off + 52) 0 + gpu-mem-write gpu-cmd (off + 56) 0 + gpu-mem-write gpu-cmd (off + 60) 0 + gpu-mem-write gpu-cmd (off + 64) 0 + gpu-mem-write gpu-cmd (off + 68) 0

  gpu-rect : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-rect (idx) (x) (y) (w) (h) (color) =
    gpu-tri idx x y (x + w) y x (y + h) color color color + gpu-tri (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-tri-front : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-tri-front (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in gpu-mem-write gpu-cmd off x0 + gpu-mem-write gpu-cmd (off + 4) y0 + gpu-mem-write gpu-cmd (off + 8) x1 + gpu-mem-write gpu-cmd (off + 12) y1 + gpu-mem-write gpu-cmd (off + 16) x2 + gpu-mem-write gpu-cmd (off + 20) y2 + gpu-mem-write gpu-cmd (off + 24) c0 + gpu-mem-write gpu-cmd (off + 28) c1 + gpu-mem-write gpu-cmd (off + 32) c2 + gpu-mem-write gpu-cmd (off + 36) 1000 + gpu-mem-write gpu-cmd (off + 40) 1000 + gpu-mem-write gpu-cmd (off + 44) 1000 + gpu-mem-write gpu-cmd (off + 48) 0 + gpu-mem-write gpu-cmd (off + 52) 0 + gpu-mem-write gpu-cmd (off + 56) 0 + gpu-mem-write gpu-cmd (off + 60) 0 + gpu-mem-write gpu-cmd (off + 64) 0 + gpu-mem-write gpu-cmd (off + 68) 0

  gpu-tri-mid : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-tri-mid (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in gpu-mem-write gpu-cmd off x0 + gpu-mem-write gpu-cmd (off + 4) y0 + gpu-mem-write gpu-cmd (off + 8) x1 + gpu-mem-write gpu-cmd (off + 12) y1 + gpu-mem-write gpu-cmd (off + 16) x2 + gpu-mem-write gpu-cmd (off + 20) y2 + gpu-mem-write gpu-cmd (off + 24) c0 + gpu-mem-write gpu-cmd (off + 28) c1 + gpu-mem-write gpu-cmd (off + 32) c2 + gpu-mem-write gpu-cmd (off + 36) 2000 + gpu-mem-write gpu-cmd (off + 40) 2000 + gpu-mem-write gpu-cmd (off + 44) 2000 + gpu-mem-write gpu-cmd (off + 48) 0 + gpu-mem-write gpu-cmd (off + 52) 0 + gpu-mem-write gpu-cmd (off + 56) 0 + gpu-mem-write gpu-cmd (off + 60) 0 + gpu-mem-write gpu-cmd (off + 64) 0 + gpu-mem-write gpu-cmd (off + 68) 0

  gpu-rect-mid : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-rect-mid (idx) (x) (y) (w) (h) (color) =
    gpu-tri-mid idx x y (x + w) y x (y + h) color color color + gpu-tri-mid (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-rect-chrome : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-rect-chrome (idx) (x) (y) (w) (h) (color) =
    gpu-tri-chrome idx x y (x + w) y x (y + h) color color color + gpu-tri-chrome (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

  gpu-tri-chrome : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-tri-chrome (idx) (x0) (y0) (x1) (y1) (x2) (y2) (c0) (c1) (c2) =
    let off = idx * 72
    in gpu-mem-write gpu-cmd off x0 + gpu-mem-write gpu-cmd (off + 4) y0 + gpu-mem-write gpu-cmd (off + 8) x1 + gpu-mem-write gpu-cmd (off + 12) y1 + gpu-mem-write gpu-cmd (off + 16) x2 + gpu-mem-write gpu-cmd (off + 20) y2 + gpu-mem-write gpu-cmd (off + 24) c0 + gpu-mem-write gpu-cmd (off + 28) c1 + gpu-mem-write gpu-cmd (off + 32) c2 + gpu-mem-write gpu-cmd (off + 36) 5000 + gpu-mem-write gpu-cmd (off + 40) 5000 + gpu-mem-write gpu-cmd (off + 44) 5000 + gpu-mem-write gpu-cmd (off + 48) 0 + gpu-mem-write gpu-cmd (off + 52) 0 + gpu-mem-write gpu-cmd (off + 56) 0 + gpu-mem-write gpu-cmd (off + 60) 0 + gpu-mem-write gpu-cmd (off + 64) 0 + gpu-mem-write gpu-cmd (off + 68) 0

  gpu-rect-top : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  gpu-rect-top (idx) (x) (y) (w) (h) (color) =
    gpu-tri-front idx x y (x + w) y x (y + h) color color color + gpu-tri-front (idx + 1) (x + w) y (x + w) (y + h) x (y + h) color color color

Section: Tool Constants

  tool-select : Integer = 0
  tool-place : Integer = 1
  tool-wire : Integer = 2

  tool-name : Integer -> Text
  tool-name (t) = if t == 0 then "SELECT" else if t == 1 then "PLACE" else "WIRE"

Section: Menu Constants

  menu-none : Integer = 0
  menu-file : Integer = 1
  menu-edit : Integer = 2
  menu-view : Integer = 3
  menu-place : Integer = 4

Section: App Dimensions

  app-w : Integer = 1024
  app-h : Integer = 768
  canvas-top : Integer = 52
  max-tris : Integer = 20000

Section: App State

  AppState = record {
    as-input : RawInput,
    as-viewport : ViewPort,
    as-items : List CanvasItem,
    as-history : EditHistory,
    as-tool : Integer,
    as-palette-idx : Integer,
    as-frame : Integer,
    as-quit : Integer,
    as-show-help : Integer,
    as-prev-left : Integer,
    as-prev-key : Integer,
    as-dragging : Integer,
    as-drag-ox : Integer,
    as-drag-oy : Integer,
    as-wire-active : Integer,
    as-wire-x : Integer,
    as-wire-y : Integer,
    as-menu-open : Integer,
    as-dirty : Integer,
    as-hover-idx : Integer,
    as-tab : Integer
  }

Section: Init

  app-init : AppState
  app-init =
    let cw = app-w - sidebar-w
    in let ch = app-h - canvas-top - status-h
    in let vp = viewport-new 0 canvas-top cw ch
    in let vp2 = viewport-pan vp (-200) (-250)
    in AppState {
      as-input = raw-input-new app-w app-h,
      as-viewport = vp2,
      as-items = build-demo-items,
      as-history = eh-new,
      as-tool = tool-select,
      as-palette-idx = 0,
      as-frame = 0,
      as-quit = 0,
      as-show-help = 0,
      as-prev-left = 0,
      as-prev-key = 0,
      as-dragging = 0,
      as-drag-ox = 0,
      as-drag-oy = 0,
      as-wire-active = 0,
      as-wire-x = 0,
      as-wire-y = 0,
      as-menu-open = menu-none,
      as-dirty = 0,
      as-hover-idx = -1,
      as-tab = 0
    }

Section: Entry

  opening : [Console, Device.Port, Gpu.Compute, Gpu.Memory] Nothing = act
    result <- app-loop app-init
    print-line ("Codex Circuits | " & (show result) & " frames")
  end

Section: Main Loop

  app-loop : AppState -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  app-loop (st) = act
    inp <- raw-input-poll (st.as-input)
    let st2 = process-all st inp
    in if st2.as-quit == 1 then st2.as-frame
    else app-loop-render st2
  end

  app-loop-render : AppState -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  app-loop-render (st) = act
    total <- render-frame st
    app-loop st
  end

Section: Master Input

  process-all : AppState, RawInput -> AppState
  process-all (st) (inp) =
    let raw-key = inp.ri-key
    in let key = if raw-key > 0 then if raw-key < 128 then if st.as-prev-key == 0 then raw-key else 0 else 0 else 0
    in let left-down = if inp.ri-left == 1 then if st.as-prev-left == 0 then 1 else 0 else 0
    in let left-up = if inp.ri-left == 0 then if st.as-prev-left == 1 then 1 else 0 else 0
    in let mx = inp.ri-mx
    in let my = inp.ri-my
    in let st2 = if st.as-menu-open /= menu-none then process-menu-input st inp key left-down mx my else process-normal st inp key left-down left-up mx my
    in let wx = vp-screen-to-world-x (st2.as-viewport) mx
    in let wy = vp-screen-to-world-y (st2.as-viewport) my
    in let hover = if my >= canvas-top then if my < app-h - status-h then if mx < app-w - sidebar-w then hit-test-items (st2.as-items) wx wy 0 0 else -1 else -1 else -1
    in AppState {
      as-input = inp,
      as-viewport = st2.as-viewport,
      as-items = st2.as-items,
      as-history = st2.as-history,
      as-tool = st2.as-tool,
      as-palette-idx = st2.as-palette-idx,
      as-frame = st.as-frame + 1,
      as-quit = st2.as-quit,
      as-show-help = st2.as-show-help,
      as-prev-left = inp.ri-left,
      as-prev-key = raw-key,
      as-dragging = st2.as-dragging,
      as-drag-ox = st2.as-drag-ox,
      as-drag-oy = st2.as-drag-oy,
      as-wire-active = st2.as-wire-active,
      as-wire-x = st2.as-wire-x,
      as-wire-y = st2.as-wire-y,
      as-menu-open = st2.as-menu-open,
      as-dirty = st2.as-dirty, as-hover-idx = hover, as-tab = st2.as-tab
    }

Section: Menu Input

  process-menu-input : AppState, RawInput, Integer, Integer, Integer, Integer -> AppState
  process-menu-input (st) (inp) (key) (left-down) (mx) (my) =
    if key == 1 then menu-close st
    else if left-down == 0 then st
    else if my < toolbar-h then process-menubar-click st mx
    else process-menu-item-click st mx my

  menu-close : AppState -> AppState
  menu-close (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  set-menu : AppState, Integer -> AppState
  set-menu (st) (m) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = m, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  process-menubar-click : AppState, Integer -> AppState
  process-menubar-click (st) (mx) = menubar-dispatch st mx (menubar-zone mx)

  menubar-zone : Integer -> Integer
  menubar-zone (mx) = mz-file mx

  mz-file : Integer -> Integer
  mz-file (mx) = if mx >= 4 then if mx < 54 then 1 else mz-edit mx else 0

  mz-edit : Integer -> Integer
  mz-edit (mx) = if mx >= 58 then if mx < 98 then 2 else mz-view mx else 0

  mz-view : Integer -> Integer
  mz-view (mx) = if mx >= 102 then if mx < 142 then 3 else mz-place mx else 0

  mz-place : Integer -> Integer
  mz-place (mx) = if mx >= 146 then if mx < 186 then 4 else 0 else 0

  menubar-dispatch : AppState, Integer, Integer -> AppState
  menubar-dispatch (st) (mx) (zone) =
    if zone == 1 then set-menu st (if st.as-menu-open == menu-file then menu-none else menu-file)
    else if zone == 2 then set-menu st (if st.as-menu-open == menu-edit then menu-none else menu-edit)
    else if zone == 3 then set-menu st (if st.as-menu-open == menu-view then menu-none else menu-view)
    else if zone == 4 then set-menu st (if st.as-menu-open == menu-place then menu-none else menu-place)
    else menu-close st

  process-menu-item-click : AppState, Integer, Integer -> AppState
  process-menu-item-click (st) (mx) (my) =
    if st.as-menu-open == menu-file then process-file-click st mx my
    else if st.as-menu-open == menu-edit then process-edit-click st mx my
    else if st.as-menu-open == menu-view then process-view-click st mx my
    else if st.as-menu-open == menu-place then process-place-click st mx my
    else menu-close st

  menu-item-hit : Integer, Integer, Integer, Integer, Integer -> Integer
  menu-item-hit (mx) (my) (menu-x) (menu-y) (idx) =
    let iy = menu-y + 2 + idx * 20
    in if mx >= menu-x then if mx < menu-x + 120 then if my >= iy then if my < iy + 20 then 1 else 0 else 0 else 0 else 0

  process-file-click : AppState, Integer, Integer -> AppState
  process-file-click (st) (mx) (my) =
    let bx = 4
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-file-new st
    else if menu-item-hit mx my bx by 1 == 1 then do-file-save st
    else if menu-item-hit mx my bx by 2 == 1 then do-file-load st
    else if menu-item-hit mx my bx by 3 == 1 then do-quit st
    else menu-close st

  process-edit-click : AppState, Integer, Integer -> AppState
  process-edit-click (st) (mx) (my) =
    let bx = 58
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-undo (menu-close st)
    else if menu-item-hit mx my bx by 1 == 1 then do-delete (menu-close st)
    else if menu-item-hit mx my bx by 2 == 1 then do-rotate (menu-close st)
    else if menu-item-hit mx my bx by 3 == 1 then do-duplicate (menu-close st)
    else if menu-item-hit mx my bx by 4 == 1 then do-select-all (menu-close st)
    else menu-close st

  process-view-click : AppState, Integer, Integer -> AppState
  process-view-click (st) (mx) (my) =
    let bx = 102
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-zoom-in (menu-close st)
    else if menu-item-hit mx my bx by 1 == 1 then do-zoom-out (menu-close st)
    else if menu-item-hit mx my bx by 2 == 1 then do-zoom-fit (menu-close st)
    else if menu-item-hit mx my bx by 3 == 1 then do-toggle-help (menu-close st)
    else menu-close st

  process-place-click : AppState, Integer, Integer -> AppState
  process-place-click (st) (mx) (my) =
    let bx = 146
    in let by = toolbar-h
    in if menu-item-hit mx my bx by 0 == 1 then do-set-palette (menu-close st) 0
    else if menu-item-hit mx my bx by 1 == 1 then do-set-palette (menu-close st) 1
    else if menu-item-hit mx my bx by 2 == 1 then do-set-palette (menu-close st) 2
    else if menu-item-hit mx my bx by 3 == 1 then do-set-palette (menu-close st) 3
    else if menu-item-hit mx my bx by 4 == 1 then do-set-palette (menu-close st) 4
    else if menu-item-hit mx my bx by 5 == 1 then do-set-palette (menu-close st) 5
    else if menu-item-hit mx my bx by 6 == 1 then do-set-palette (menu-close st) 6
    else if menu-item-hit mx my bx by 7 == 1 then do-set-palette (menu-close st) 7
    else if menu-item-hit mx my bx by 8 == 1 then do-set-palette (menu-close st) 8
    else menu-close st

Section: Menu Actions

  do-file-new : AppState -> AppState
  do-file-new (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = [], as-history = eh-new,
    as-tool = tool-select, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = menu-none, as-dirty = 0, as-hover-idx = -1, as-tab = 0
  }

  do-file-save : AppState -> AppState
  do-file-save (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = 0, as-hover-idx = -1, as-tab = 0
  }

  do-file-load : AppState -> AppState
  do-file-load (st) = menu-close st

  do-quit : AppState -> AppState
  do-quit (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 1,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-undo : AppState -> AppState
  do-undo (st) =
    if eh-can-undo (st.as-history) == 0 then st
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = eh-top (st.as-history), as-history = eh-pop (st.as-history),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = st.as-menu-open, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  do-delete : AppState -> AppState
  do-delete (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = delete-selected (st.as-items), as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-rotate : AppState -> AppState
  do-rotate (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = rotate-selected (st.as-items), as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-duplicate : AppState -> AppState
  do-duplicate (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = duplicate-selected (st.as-items) 20, as-history = eh-push (st.as-history) (st.as-items),
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-select-all : AppState -> AppState
  do-select-all (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = marquee-select (st.as-items) (-9999) (-9999) 9999 9999, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-zoom-in : AppState -> AppState
  do-zoom-in (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-in (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-zoom-out : AppState -> AppState
  do-zoom-out (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-out (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-zoom-fit : AppState -> AppState
  do-zoom-fit (st) = AppState {
    as-input = st.as-input, as-viewport = viewport-zoom-fit (st.as-viewport),
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-toggle-help : AppState -> AppState
  do-toggle-help (st) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = if st.as-show-help == 1 then 0 else 1,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = st.as-dragging, as-drag-ox = st.as-drag-ox, as-drag-oy = st.as-drag-oy,
    as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

  do-set-palette : AppState, Integer -> AppState
  do-set-palette (st) (idx) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = tool-place, as-palette-idx = idx,
    as-frame = st.as-frame, as-quit = 0,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

Section: Normal Input

  process-normal : AppState, RawInput, Integer, Integer, Integer, Integer, Integer -> AppState
  process-normal (st) (inp) (key) (left-down) (left-up) (mx) (my) =
    let vp2 = if inp.ri-middle == 1 then viewport-pan (st.as-viewport) (ri-dx inp) (0 - (ri-dy inp)) else st.as-viewport
    in let vp3 = process-vp-keys vp2 key
    in let st2 = process-key-cmds st key
    in let st3 = process-mouse st2 inp left-down left-up mx my
    in AppState {
      as-input = inp,
      as-viewport = vp3,
      as-items = st3.as-items,
      as-history = st3.as-history,
      as-tool = st3.as-tool,
      as-palette-idx = st3.as-palette-idx,
      as-frame = st.as-frame,
      as-quit = 0,
      as-show-help = st3.as-show-help,
      as-prev-left = st.as-prev-left,
      as-prev-key = st.as-prev-key,
      as-dragging = st3.as-dragging,
      as-drag-ox = st3.as-drag-ox,
      as-drag-oy = st3.as-drag-oy,
      as-wire-active = st3.as-wire-active,
      as-wire-x = st3.as-wire-x,
      as-wire-y = st3.as-wire-y,
      as-menu-open = st3.as-menu-open,
      as-dirty = st3.as-dirty, as-hover-idx = st3.as-hover-idx, as-tab = st3.as-tab
    }

  process-vp-keys : ViewPort, Integer -> ViewPort
  process-vp-keys (vp) (key) =
    if key == 78 then viewport-zoom-in vp
    else if key == 74 then viewport-zoom-out vp
    else if key == 71 then viewport-zoom-fit vp
    else vp

  process-key-cmds : AppState, Integer -> AppState
  process-key-cmds (st) (key) =
    if key == 0 then st
    else if key == 31 then set-tool st tool-select
    else if key == 17 then set-tool st tool-wire
    else if key == 25 then set-tool st tool-place
    else if key == 35 then do-toggle-help st
    else if key == 83 then do-delete st
    else if key == 19 then do-rotate st
    else if key == 32 then do-duplicate st
    else if key == 44 then do-undo st
    else if key == 2 then do-set-palette st 0
    else if key == 3 then do-set-palette st 1
    else if key == 4 then do-set-palette st 2
    else if key == 5 then do-set-palette st 3
    else if key == 6 then do-set-palette st 4
    else if key == 7 then do-set-palette st 5
    else if key == 8 then do-set-palette st 6
    else if key == 9 then do-set-palette st 7
    else if key == 10 then do-set-palette st 8
    else st

  set-tool : AppState, Integer -> AppState
  set-tool (st) (t) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = t, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = st.as-menu-open, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
  }

Section: Mouse Handling

  process-mouse : AppState, RawInput, Integer, Integer, Integer, Integer -> AppState
  process-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if my < toolbar-h then process-toolbar-click st left-down mx
    else if mx >= app-w - sidebar-w then process-sidebar-click st left-down mx my
    else if my < canvas-top then process-tab-click st left-down mx
    else if my >= app-h - status-h then st
    else process-canvas-mouse st inp left-down left-up mx my

  process-toolbar-click : AppState, Integer, Integer -> AppState
  process-toolbar-click (st) (left-down) (mx) =
    if left-down == 0 then st
    else toolbar-dispatch st (toolbar-zone mx)

  toolbar-zone : Integer -> Integer
  toolbar-zone (mx) = toolbar-zone-file mx

  toolbar-zone-file : Integer -> Integer
  toolbar-zone-file (mx) = if mx >= 4 then if mx < 54 then 1 else toolbar-zone-edit mx else 0

  toolbar-zone-edit : Integer -> Integer
  toolbar-zone-edit (mx) = if mx >= 58 then if mx < 98 then 2 else toolbar-zone-view mx else 0

  toolbar-zone-view : Integer -> Integer
  toolbar-zone-view (mx) = if mx >= 102 then if mx < 142 then 3 else toolbar-zone-place mx else 0

  toolbar-zone-place : Integer -> Integer
  toolbar-zone-place (mx) = if mx >= 146 then if mx < 186 then 4 else toolbar-zone-tools mx else 0

  toolbar-zone-tools : Integer -> Integer
  toolbar-zone-tools (mx) = if mx >= 210 then if mx < 250 then 5 else if mx >= 254 then if mx < 294 then 6 else if mx >= 298 then if mx < 338 then 7 else 0 else 0 else 0 else 0

  toolbar-dispatch : AppState, Integer -> AppState
  toolbar-dispatch (st) (zone) =
    if zone == 1 then set-menu st menu-file
    else if zone == 2 then set-menu st menu-edit
    else if zone == 3 then set-menu st menu-view
    else if zone == 4 then set-menu st menu-place
    else if zone == 5 then set-tool st tool-select
    else if zone == 6 then set-tool st tool-wire
    else if zone == 7 then set-tool st tool-place
    else st

  process-tab-click : AppState, Integer, Integer -> AppState
  process-tab-click (st) (left-down) (mx) =
    if left-down == 0 then st
    else if mx < 82 then set-tab st 0
    else if mx < 156 then set-tab st 1
    else if mx < 240 then set-tab st 2
    else if mx < 304 then set-tab st 3
    else st

  set-tab : AppState, Integer -> AppState
  set-tab (st) (t) = AppState {
    as-input = st.as-input, as-viewport = st.as-viewport,
    as-items = st.as-items, as-history = st.as-history,
    as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
    as-frame = st.as-frame, as-quit = st.as-quit,
    as-show-help = st.as-show-help,
    as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
    as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
    as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
    as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = t
  }

  process-sidebar-click : AppState, Integer, Integer, Integer -> AppState
  process-sidebar-click (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let rel-y = my - canvas-top - 28
    in let idx = rel-y / 20
    in if idx < 0 then st
    else if idx >= palette-count then st
    else do-set-palette st idx

  process-canvas-mouse : AppState, RawInput, Integer, Integer, Integer, Integer -> AppState
  process-canvas-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if st.as-tool == tool-select then process-select-mouse st inp left-down left-up mx my
    else if st.as-tool == tool-place then process-place-mouse st left-down mx my
    else process-wire-mouse st left-down mx my

  process-select-mouse : AppState, RawInput, Integer, Integer, Integer, Integer -> AppState
  process-select-mouse (st) (inp) (left-down) (left-up) (mx) (my) =
    if left-down == 1 then do-select-start st mx my
    else if left-up == 1 then do-drag-end st
    else if inp.ri-left == 1 then do-drag-continue st mx my
    else st

  do-select-start : AppState, Integer, Integer -> AppState
  do-select-start (st) (mx) (my) =
    let wx = vp-screen-to-world-x (st.as-viewport) mx
    in let wy = vp-screen-to-world-y (st.as-viewport) my
    in let hit = hit-test-items (st.as-items) wx wy 0 0
    in if hit < 0 then AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = deselect-all (st.as-items), as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 2, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = select-only (st.as-items) hit, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  do-drag-continue : AppState, Integer, Integer -> AppState
  do-drag-continue (st) (mx) (my) =
    if st.as-dragging == 0 then st
    else if st.as-dragging == 2 then st
    else let dx = mx - st.as-drag-ox
    in let dy = my - st.as-drag-oy
    in if dx == 0 then if dy == 0 then st else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = move-selected (st.as-items) 0 dy, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = move-selected (st.as-items) dx dy, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 1, as-drag-ox = mx, as-drag-oy = my,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  do-drag-end : AppState -> AppState
  do-drag-end (st) =
    if st.as-dragging == 2 then do-marquee-end st
    else AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = st.as-items, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
      as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  do-marquee-end : AppState -> AppState
  do-marquee-end (st) =
    let vp = st.as-viewport
    in let wx0 = vp-screen-to-world-x vp (st.as-drag-ox)
    in let wy0 = vp-screen-to-world-y vp (st.as-drag-oy)
    in let wx1 = vp-screen-to-world-x vp ((st.as-input).ri-mx)
    in let wy1 = vp-screen-to-world-y vp ((st.as-input).ri-my)
    in AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = marquee-select (st.as-items) wx0 wy0 wx1 wy1, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = st.as-wire-active, as-wire-x = st.as-wire-x, as-wire-y = st.as-wire-y,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  process-place-mouse : AppState, Integer, Integer, Integer -> AppState
  process-place-mouse (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let vp = st.as-viewport
    in let wx = grid-snap (vp-screen-to-world-x vp mx) (vp.vp-grid)
    in let wy = grid-snap (vp-screen-to-world-y vp my) (vp.vp-grid)
    in let pe = palette-at (st.as-palette-idx)
    in let nid = next-item-id (st.as-items)
    in let ref = auto-ref (pe.pe-prefix) (st.as-items)
    in let items2 = place-component (st.as-items) nid wx wy pe ref
    in AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = items2, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

  process-wire-mouse : AppState, Integer, Integer, Integer -> AppState
  process-wire-mouse (st) (left-down) (mx) (my) =
    if left-down == 0 then st
    else let vp = st.as-viewport
    in let wx = grid-snap (vp-screen-to-world-x vp mx) (vp.vp-grid)
    in let wy = grid-snap (vp-screen-to-world-y vp my) (vp.vp-grid)
    in if st.as-wire-active == 0 then AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = st.as-items, as-history = st.as-history,
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 1, as-wire-x = wx, as-wire-y = wy,
      as-menu-open = menu-none, as-dirty = st.as-dirty, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }
    else let nid = next-item-id (st.as-items)
    in let items2 = place-wire-seg (st.as-items) nid (st.as-wire-x) (st.as-wire-y) wx wy
    in AppState {
      as-input = st.as-input, as-viewport = st.as-viewport,
      as-items = items2, as-history = eh-push (st.as-history) (st.as-items),
      as-tool = st.as-tool, as-palette-idx = st.as-palette-idx,
      as-frame = st.as-frame, as-quit = 0,
      as-show-help = st.as-show-help,
      as-prev-left = st.as-prev-left, as-prev-key = st.as-prev-key,
      as-dragging = 0, as-drag-ox = 0, as-drag-oy = 0,
      as-wire-active = 0, as-wire-x = 0, as-wire-y = 0,
      as-menu-open = menu-none, as-dirty = 1, as-hover-idx = st.as-hover-idx, as-tab = st.as-tab
    }

Section: Render Frame

  render-frame : AppState -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  render-frame (st) = act
    cl <- gpu-out 1025 col-bg
    cd <- gpu-out 1026 0
    n1 <- draw-menubar-bg 0 st
    n2 <- draw-menubar-text n1 st
    n3 <- draw-tab-bar-bg n2 (st.as-tab)
    n4 <- draw-tab-bar-text n3 (st.as-tab)
    n5 <- if st.as-tab == 0 then render-schematic-view n4 st else if st.as-tab == 1 then render-pcb-view n4 st else if st.as-tab == 2 then render-3d-view n4 st else if st.as-tab == 3 then render-sim-view n4 st else render-placeholder-view n4 st
    nc <- draw-status-bg n5 st
    nd <- draw-status-text-all nc st
    ne <- if st.as-tab == 0 then draw-crosshair-gpu nd ((st.as-input).ri-mx) ((st.as-input).ri-my) (st.as-viewport) else nd
    nf <- if st.as-menu-open /= menu-none then draw-dropdown ne st else ne
    ng <- if st.as-show-help == 1 then draw-help-gpu nf else nf
    gpu-out 1024 ng
  end

  render-schematic-view : Integer, AppState -> [Gpu.Memory] Integer
  render-schematic-view (n) (st) =
    let desc-y = canvas-top + 28 + palette-count * 20 + 12
    in draw-properties-panel (draw-description-panel (draw-sidebar-text (draw-sidebar-bg (draw-place-ghost (draw-wire-preview (draw-marquee-if (draw-item-refs (draw-items-gpu (draw-title-block (draw-grid-gpu n (st.as-viewport)) (st.as-viewport)) (st.as-items) (st.as-viewport) (st.as-hover-idx)) (st.as-items) (st.as-viewport)) st) st) st) (st.as-palette-idx)) (st.as-palette-idx)) desc-y) (desc-y + 90) st

  draw-marquee-if : Integer, AppState -> [Gpu.Memory] Integer
  draw-marquee-if (n) (st) =
    if st.as-dragging == 2 then draw-marquee-rect n st else n

  render-pcb-view : Integer, AppState -> [Gpu.Memory] Integer
  render-pcb-view (n) (st) =
    let bx = 120
    in let by = 80
    in let bw = 560
    in let bh = 380
    in draw-gpu-text-chrome (draw-gpu-text-chrome (pcb-draw-tracks (pcb-draw-footprints (pcb-draw-mounting-holes (gpu-seq (gpu-rect n bx by bw bh col-substrate + gpu-rect (n + 2) bx by bw 2 col-courtyard + gpu-rect (n + 4) bx (by + bh - 2) bw 2 col-courtyard + gpu-rect (n + 6) bx by 2 bh col-courtyard + gpu-rect (n + 8) (bx + bw - 2) by 2 bh col-courtyard) (n + 10)) bx by bw bh) (st.as-items) bx by) bx by) (bx + 4) (by + bh + 6) "PCB: 56mm x 38mm  2-LAYER  FR4 1.6mm" col-text-dim max-tris) (bx + 350) (by + bh + 6) "SCALE 1:1" col-text-dim max-tris

  pcb-draw-mounting-holes : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-mounting-holes (n) (bx) (by) (bw) (bh) =
    let m = 15
    in pcb-draw-hole (pcb-draw-hole (pcb-draw-hole (pcb-draw-hole n (bx + m) (by + m) 8) (bx + bw - m) (by + m) 8) (bx + m) (by + bh - m) 8) (bx + bw - m) (by + bh - m) 8

  pcb-draw-hole : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-hole (n) (cx) (cy) (r) =
    gpu-seq (gpu-rect n (cx - r) (cy - r) (r * 2) (r * 2) col-pad + gpu-rect (n + 2) (cx - r + 2) (cy - r + 2) (r * 2 - 4) (r * 2 - 4) #1A1A1A) (n + 4)

  pcb-draw-footprints : Integer, List CanvasItem, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-footprints (n) (items) (bx) (by) =
    pcb-fp-loop n items bx by 0 (list-length items)

  pcb-fp-loop : Integer, List CanvasItem, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-fp-loop (n) (items) (bx) (by) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in pcb-fp-loop (pcb-draw-one-fp n item bx by) items bx by (i + 1) count

  pcb-draw-one-fp : Integer, CanvasItem, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-one-fp (n) (item) (bx) (by) = when item.ci-kind
    is CiComponent -> pcb-draw-comp-fp n item bx by
    is otherwise -> n

  pcb-draw-comp-fp : Integer, CanvasItem, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-comp-fp (n) (item) (bx) (by) =
    let px = bx + 40 + item.ci-x / 2
    in let py = by + 20 + item.ci-y / 2
    in let pw = item.ci-w / 2 + 4
    in let ph = item.ci-h / 2 + 4
    in draw-gpu-text (pcb-draw-fp-pads (gpu-seq (gpu-rect n px py pw ph #1A3A1A + gpu-rect (n + 2) px py pw 1 col-silk + gpu-rect (n + 4) px (py + ph - 1) pw 1 col-silk + gpu-rect (n + 6) px py 1 ph col-silk + gpu-rect (n + 8) (px + pw - 1) py 1 ph col-silk) (n + 10)) item px py pw ph) (px + 2) (py + ph + 2) (item.ci-ref) col-silk max-tris

  pcb-draw-fp-pads : Integer, CanvasItem, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-fp-pads (n) (item) (px) (py) (pw) (ph) = when item.ci-subtype
    is SubIc -> pcb-draw-ic-pads n px py pw ph (item.ci-pins-left) (item.ci-pins-right)
    is SubResistor -> pcb-draw-2pad n px py pw ph
    is SubCapacitor -> pcb-draw-2pad-v n px py pw ph
    is SubLed -> pcb-draw-2pad n px py pw ph
    is SubConnector -> pcb-draw-conn-pads n px py pw ph (item.ci-pins-right)
    is SubSwitch -> pcb-draw-2pad n px py pw ph
    is SubGeneric -> pcb-draw-2pad n px py pw ph

  pcb-draw-2pad : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-2pad (n) (px) (py) (pw) (ph) =
    gpu-seq (gpu-rect n (px - 4) (py + ph / 2 - 2) 6 5 col-pad + gpu-rect (n + 2) (px + pw - 2) (py + ph / 2 - 2) 6 5 col-pad) (n + 4)

  pcb-draw-2pad-v : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-2pad-v (n) (px) (py) (pw) (ph) =
    gpu-seq (gpu-rect n (px + pw / 2 - 2) (py - 3) 5 5 col-pad + gpu-rect (n + 2) (px + pw / 2 - 2) (py + ph - 2) 5 5 col-pad) (n + 4)

  pcb-draw-ic-pads : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-ic-pads (n) (px) (py) (pw) (ph) (pl) (pr) =
    pcb-draw-pad-row (pcb-draw-pad-row n (px - 3) py ph pl 0) (px + pw - 1) py ph pr 0

  pcb-draw-pad-row : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-pad-row (n) (px) (py) (ph) (count) (i) =
    if i >= count then n
    else if n >= max-tris then n
    else let pad-y = py + 3 + i * ((ph - 6) / (if count > 1 then count - 1 else 1))
    in pcb-draw-pad-row (gpu-seq (gpu-rect n px pad-y 5 3 col-pad) (n + 2)) px py ph count (i + 1)

  pcb-draw-conn-pads : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-conn-pads (n) (px) (py) (pw) (ph) (count) =
    pcb-draw-pad-row n (px + pw / 2 - 2) py ph count 0

  pcb-draw-tracks : Integer, Integer, Integer -> [Gpu.Memory] Integer
  pcb-draw-tracks (n) (bx) (by) =
    gpu-seq (gpu-rect n (bx + 60) (by + 30) 300 1 col-track-front + gpu-rect (n + 2) (bx + 60) (by + 350) 300 1 col-track-front + gpu-rect (n + 4) (bx + 60) (by + 30) 1 320 col-track-front + gpu-rect (n + 6) (bx + 360) (by + 30) 1 320 col-track-front + gpu-rect (n + 8) (bx + 100) (by + 80) 200 1 col-track-back + gpu-rect (n + 10) (bx + 100) (by + 300) 200 1 col-track-back + gpu-rect (n + 12) (bx + 200) (by + 100) 1 180 col-via + gpu-rect (n + 14) (bx + 200) (by + 98) 5 5 col-via) (n + 16)

  render-3d-view : Integer, AppState -> [Gpu.Memory] Integer
  render-3d-view (n) (st) =
    let cx = 400
    in let cy = 300
    in let bw = 280
    in let bh = 190
    in let tilt = 40
    in draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-3d-components (draw-3d-board n cx cy bw bh tilt) (st.as-items) cx cy bw bh tilt) 140 (cy + bh / 2 + tilt + 20) "3D BOARD VIEWER" col-accent max-tris) 140 (cy + bh / 2 + tilt + 35) "STM32F405 DEV BOARD  56x38mm  FR4 1.6mm" col-text-dim max-tris) 140 (cy + bh / 2 + tilt + 50) "ROTATE: DRAG  ZOOM: SCROLL" col-text-dim max-tris

  draw-3d-board : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-3d-board (n) (cx) (cy) (bw) (bh) (tilt) =
    let lx = cx - bw / 2
    in let rx = cx + bw / 2
    in let ty = cy - bh / 2
    in let by = cy + bh / 2
    in let depth = 12
    in let n2 = n + 5
    in let n3 = n2 + 8
    in gpu-seq (gpu-tri n lx (ty - tilt) rx (ty - tilt) lx (by - tilt) col-substrate col-substrate col-substrate + gpu-tri (n + 1) rx (ty - tilt) rx (by - tilt) lx (by - tilt) col-substrate col-substrate col-substrate + gpu-tri (n + 2) lx (by - tilt) rx (by - tilt) lx by #1A3010 #1A3010 #1A3010 + gpu-tri (n + 3) rx (by - tilt) rx by lx by #1A3010 #1A3010 #1A3010 + gpu-tri (n + 4) rx (ty - tilt) rx by rx (by - tilt) #243A18 #243A18 #243A18 + gpu-rect n2 (lx + 2) (ty - tilt + 2) (bw - 4) 2 col-courtyard + gpu-rect (n2 + 2) (lx + 2) (by - tilt - 4) (bw - 4) 2 col-courtyard + gpu-rect (n2 + 4) (lx + 2) (ty - tilt + 2) 2 (bh - tilt - 6) col-courtyard + gpu-rect (n2 + 6) (rx - 4) (ty - tilt + 2) 2 (bh - tilt - 6) col-courtyard + gpu-rect n3 (lx + 10) (ty - tilt + 10) 8 8 col-pad + gpu-rect (n3 + 2) (rx - 18) (ty - tilt + 10) 8 8 col-pad + gpu-rect (n3 + 4) (lx + 10) (by - tilt - 18) 8 8 col-pad + gpu-rect (n3 + 6) (rx - 18) (by - tilt - 18) 8 8 col-pad) (n3 + 8)

  draw-3d-components : Integer, List CanvasItem, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-3d-components (n) (items) (cx) (cy) (bw) (bh) (tilt) =
    draw-3d-comp-loop n items cx cy bw bh tilt 0 (list-length items)

  draw-3d-comp-loop : Integer, List CanvasItem, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-3d-comp-loop (n) (items) (cx) (cy) (bw) (bh) (tilt) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in draw-3d-comp-loop (draw-3d-one-comp n item cx cy bw bh tilt) items cx cy bw bh tilt (i + 1) count

  draw-3d-one-comp : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-3d-one-comp (n) (item) (cx) (cy) (bw) (bh) (tilt) = when item.ci-kind
    is CiComponent -> draw-3d-comp-block n item cx cy bw bh tilt
    is otherwise -> n

  draw-3d-comp-block : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-3d-comp-block (n) (item) (cx) (cy) (bw) (bh) (tilt) =
    let ox = cx - bw / 2 + 20
    in let oy = cy - bh / 2 - tilt + 10
    in let px = ox + item.ci-x / 3
    in let py = oy + item.ci-y / 3
    in let pw = item.ci-w / 3 + 2
    in let ph = item.ci-h / 3 + 2
    in let ch = comp-3d-height item
    in let top-color = comp-3d-color item
    in let side-color = comp-3d-side-color item
    in gpu-seq (gpu-rect n px py pw ph top-color) (if ch <= 1 then n + 2 else gpu-seq (gpu-rect (n + 2) px (py + ph) pw ch side-color) (n + 4))

  comp-3d-height : CanvasItem -> Integer
  comp-3d-height (item) = when item.ci-subtype
    is SubIc -> 6
    is SubResistor -> 2
    is SubCapacitor -> 4
    is SubLed -> 3
    is SubConnector -> 8
    is SubSwitch -> 4
    is SubGeneric -> 3

  comp-3d-color : CanvasItem -> Integer
  comp-3d-color (item) = when item.ci-subtype
    is SubIc -> #222222
    is SubResistor -> #553322
    is SubCapacitor -> #886633
    is SubLed -> item.ci-color
    is SubConnector -> #AAAAAA
    is SubSwitch -> #888888
    is SubGeneric -> #666666

  comp-3d-side-color : CanvasItem -> Integer
  comp-3d-side-color (item) = when item.ci-subtype
    is SubIc -> #111111
    is SubResistor -> #332211
    is SubCapacitor -> #664422
    is SubLed -> #114411
    is SubConnector -> #777777
    is SubSwitch -> #555555
    is SubGeneric -> #444444

  render-sim-view : Integer, AppState -> [Gpu.Memory] Integer
  render-sim-view (n) (st) =
    let gx = 100
    in let gy = 80
    in let gw = 600
    in let gh = 400
    in draw-gpu-text-chrome (draw-gpu-text-chrome (draw-sim-legend (draw-sim-nrst-trace (draw-sim-led-trace (draw-sim-vcc-trace (draw-sim-axes (draw-sim-grid (gpu-seq (gpu-rect n gx gy gw gh #0D0D1E + gpu-rect (n + 2) gx gy gw 1 #333355 + gpu-rect (n + 4) gx (gy + gh) gw 1 #333355 + gpu-rect (n + 6) gx gy 1 gh #333355 + gpu-rect (n + 8) (gx + gw) gy 1 gh #333355) (n + 10)) gx gy gw gh) gx gy gw gh) gx gy gw gh) gx gy gw gh) gx gy gw gh) gx gy gw gh) (gx + 4) (gy - 12) "TRANSIENT ANALYSIS  0-10ms  VCC=3.3V" col-accent max-tris) (gx + gw - 160) (gy - 12) "CODEX SPICE v0.1" col-text-dim max-tris

  draw-sim-grid : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-grid (n) (gx) (gy) (gw) (gh) =
    draw-sim-grid-v n gx gy gw gh 1 10

  draw-sim-grid-v : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-grid-v (n) (gx) (gy) (gw) (gh) (i) (count) =
    if i >= count then n
    else let x = gx + i * gw / count
    in let label = (show i) & "ms"
    in draw-sim-grid-v (draw-gpu-text (gpu-seq (gpu-rect n x gy 1 gh #1A1A2E) (n + 2)) (x - 6) (gy + gh + 4) label col-text-dim max-tris) gx gy gw gh (i + 1) count

  draw-sim-axes : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-axes (n) (gx) (gy) (gw) (gh) =
    let mid-y = gy + gh / 2
    in draw-sim-axis-mid (draw-gpu-text (draw-gpu-text (draw-gpu-text n (gx - 30) (gy + 4) "3.3" col-text-dim max-tris) (gx - 30) (gy + gh / 2 - 3) "1.6" col-text-dim max-tris) (gx - 18) (gy + gh - 10) "0" col-text-dim max-tris) gx mid-y gw

  draw-sim-axis-mid : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-axis-mid (n) (gx) (mid-y) (gw) =
    gpu-seq (gpu-rect n gx mid-y gw 1 #1A1A2E) (n + 2)

  draw-sim-vcc-trace : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-vcc-trace (n) (gx) (gy) (gw) (gh) =
    let y-3v3 = gy + 10
    in let ramp-w = gw / 20
    in gpu-seq (gpu-tri n gx (gy + gh - 10) (gx + ramp-w) y-3v3 gx y-3v3 #CC3333 #CC3333 #CC3333 + gpu-rect (n + 1) (gx + ramp-w) y-3v3 (gw - ramp-w) 2 #CC3333) (n + 3)

  draw-sim-led-trace : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-led-trace (n) (gx) (gy) (gw) (gh) =
    draw-sim-led-steps n gx gy gw gh 0 20

  draw-sim-led-steps : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-led-steps (n) (gx) (gy) (gw) (gh) (i) (steps) =
    if i >= steps then n
    else if n >= max-tris then n
    else let x0 = gx + i * gw / steps
    in let x1 = gx + (i + 1) * gw / steps
    in let on = if i / 2 * 2 == i then 1 else 0
    in let led-y = if on == 1 then gy + gh / 4 else gy + gh - 20
    in draw-sim-led-steps (gpu-seq (gpu-rect n x0 led-y (x1 - x0) 2 #33CC33) (n + 2)) gx gy gw gh (i + 1) steps

  draw-sim-nrst-trace : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-nrst-trace (n) (gx) (gy) (gw) (gh) =
    let high-y = gy + 16
    in let low-y = gy + gh - 10
    in let pulse-x = gx + gw / 4
    in let pulse-w = gw / 15
    in gpu-seq (gpu-rect n gx high-y (pulse-x - gx) 2 #4488CC + gpu-rect (n + 2) pulse-x high-y 2 (low-y - high-y) #4488CC + gpu-rect (n + 4) pulse-x low-y pulse-w 2 #4488CC + gpu-rect (n + 6) (pulse-x + pulse-w) high-y 2 (low-y - high-y) #4488CC + gpu-rect (n + 8) (pulse-x + pulse-w) high-y (gw - (pulse-x - gx) - pulse-w) 2 #4488CC) (n + 10)

  draw-sim-legend : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sim-legend (n) (gx) (gy) (gw) (gh) =
    let lx = gx + gw + 10
    in let ly = gy + 10
    in draw-sim-legend-row (draw-sim-legend-row (draw-sim-legend-row n lx ly "VCC" #CC3333) lx (ly + 16) "LED1" #33CC33) lx (ly + 32) "NRST" #4488CC

  draw-sim-legend-row : Integer, Integer, Integer, Text, Integer -> [Gpu.Memory] Integer
  draw-sim-legend-row (n) (lx) (ly) (label) (color) =
    draw-gpu-text (gpu-seq (gpu-rect n lx ly 12 2 color) (n + 2)) (lx + 16) (ly - 3) label col-text max-tris

  render-placeholder-view : Integer, AppState -> [Gpu.Memory] Integer
  render-placeholder-view (n) (st) =
    let tab-label = if st.as-tab == 1 then "PCB LAYOUT" else if st.as-tab == 2 then "3D BOARD VIEWER" else "SPICE SIMULATION"
    in let cx = app-w / 2 - 60
    in let cy = app-h / 2 - 20
    in draw-gpu-text (draw-gpu-text (gpu-seq (gpu-rect n (cx - 20) (cy - 20) 200 80 #0D0D1E + gpu-rect (n + 2) (cx - 20) (cy - 20) 200 2 col-accent + gpu-rect (n + 4) (cx - 20) (cy + 58) 200 2 col-accent + gpu-rect (n + 6) (cx - 20) (cy - 20) 2 80 col-accent + gpu-rect (n + 8) (cx + 178) (cy - 20) 2 80 col-accent) (n + 10)) cx cy tab-label col-accent max-tris) cx (cy + 20) "COMING SOON" col-text-dim max-tris

Section: Grid

  draw-grid-gpu : Integer, ViewPort -> [Gpu.Memory] Integer
  draw-grid-gpu (n) (vp) =
    let gz = vp.vp-grid * vp.vp-zoom / 100
    in if gz < 8 then n
    else draw-grid-dots n (vp.vp-canvas-x) (vp.vp-canvas-y) (vp.vp-canvas-w) (vp.vp-canvas-h) gz col-grid 0

  draw-grid-dots : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-grid-dots (n) (cx) (cy) (cw) (ch) (gz) (color) (i) =
    let x = cx + (i * gz + gz / 2)
    in if x >= cx + cw then n
    else if n >= max-tris then n
    else draw-grid-dots (draw-grid-col n x cy ch gz color 0) cx cy cw ch gz color (i + 1)

  draw-grid-col : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-grid-col (n) (x) (cy) (ch) (gz) (color) (j) =
    let y = cy + (j * gz + gz / 2)
    in if y >= cy + ch then n
    else if n >= max-tris then n
    else draw-grid-col (gpu-seq (gpu-rect n x y 1 1 color) (n + 2)) x cy ch gz color (j + 1)

Section: Title Block

  draw-title-block : Integer, ViewPort -> [Gpu.Memory] Integer
  draw-title-block (n) (vp) =
    let bw = 600
    in let bh = 440
    in let bx = vp-world-to-screen-x vp (-60)
    in let by = vp-world-to-screen-y vp (-40)
    in let ex = vp-world-to-screen-x vp (bw - 60)
    in let ey = vp-world-to-screen-y vp (bh - 40)
    in let sw = ex - bx
    in let sh = ey - by
    in if bx >= vp.vp-canvas-x + vp.vp-canvas-w then n
    else if by >= vp.vp-canvas-y + vp.vp-canvas-h then n
    else if ex < vp.vp-canvas-x then n
    else if ey < vp.vp-canvas-y then n
    else draw-title-box (draw-zone-rows (draw-zone-cols (gpu-seq (gpu-rect n bx by sw 1 #333355 + gpu-rect (n + 2) bx (ey - 1) sw 1 #333355 + gpu-rect (n + 4) bx by 1 sh #333355 + gpu-rect (n + 6) (ex - 1) by 1 sh #333355) (n + 8)) bx by sw sh 0 8) bx by sw sh 0 5) ex ey

  draw-title-box : Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-title-box (n) (ex) (ey) =
    let tbx = ex - 200
    in let tby = ey - 50
    in let tbw = 199
    in let tbh = 49
    in draw-gpu-text (draw-gpu-text (draw-gpu-text (draw-gpu-text (gpu-seq (gpu-rect n tbx tby tbw tbh #0D0D1E + gpu-rect (n + 2) tbx tby tbw 1 #333355 + gpu-rect (n + 4) tbx (tby + tbh - 1) tbw 1 #333355 + gpu-rect (n + 6) tbx tby 1 tbh #333355 + gpu-rect (n + 8) (tbx + tbw - 1) tby 1 tbh #333355 + gpu-rect (n + 10) tbx (tby + 18) tbw 1 #333355) (n + 12)) (tbx + 4) (tby + 5) "CODEX CIRCUITS" col-accent max-tris) (tbx + 4) (tby + 24) "STM32F405 DEV BOARD" col-text max-tris) (tbx + 4) (tby + 36) "SHEET 1/1  REV A" col-text-dim max-tris) (tbx + 120) (tby + 36) "2026-06-28" col-text-dim max-tris

  draw-zone-cols : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-zone-cols (n) (bx) (by) (sw) (sh) (i) (cols) =
    if i >= cols then n
    else if n >= max-tris then n
    else let cx = bx + i * sw / cols
    in let label = zone-col-label i
    in draw-zone-cols (draw-gpu-text (draw-gpu-text (gpu-seq (gpu-rect n cx by 1 6 #333355 + gpu-rect (n + 2) cx (by + sh - 6) 1 6 #333355) (n + 4)) (cx + sw / cols / 2 - 3) (by - 10) label #444466 max-tris) (cx + sw / cols / 2 - 3) (by + sh + 3) label #444466 max-tris) bx by sw sh (i + 1) cols

  zone-col-label : Integer -> Text
  zone-col-label (i) =
    if i == 0 then "A" else if i == 1 then "B" else if i == 2 then "C"
    else if i == 3 then "D" else if i == 4 then "E" else if i == 5 then "F"
    else if i == 6 then "G" else "H"

  draw-zone-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-zone-rows (n) (bx) (by) (sw) (sh) (i) (rows) =
    if i >= rows then n
    else if n >= max-tris then n
    else let ry = by + i * sh / rows
    in let label = show (i + 1)
    in draw-zone-rows (draw-gpu-text (draw-gpu-text (gpu-seq (gpu-rect n bx ry 6 1 #333355 + gpu-rect (n + 2) (bx + sw - 6) ry 6 1 #333355) (n + 4)) (bx - 10) (ry + sh / rows / 2 - 3) label #444466 max-tris) (bx + sw + 4) (ry + sh / rows / 2 - 3) label #444466 max-tris) bx by sw sh (i + 1) rows

Section: Draw Items

  draw-items-gpu : Integer, List CanvasItem, ViewPort, Integer -> [Gpu.Memory] Integer
  draw-items-gpu (n) (items) (vp) (hover) =
    draw-item-loop n items vp hover 0 (list-length items)

  draw-item-loop : Integer, List CanvasItem, ViewPort, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-item-loop (n) (items) (vp) (hover) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in let sx = vp-world-to-screen-x vp (item.ci-x)
    in let sy = vp-world-to-screen-y vp (item.ci-y)
    in let sw = item.ci-w * vp.vp-zoom / 100
    in let sh = item.ci-h * vp.vp-zoom / 100
    in let color = if item.ci-selected == 1 then col-selection else if i == hover then col-hover else item.ci-color
    in draw-item-loop (draw-item-box (draw-item-shape n item sx sy sw sh color) (item.ci-selected) (if i == hover then 1 else 0) sx sy sw sh) items vp hover (i + 1) count

  draw-item-box : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-item-box (n) (sel) (hov) (sx) (sy) (sw) (sh) =
    if sel == 1 then draw-sel-box n sx sy sw sh
    else if hov == 1 then draw-hover-box n sx sy sw sh
    else n

  draw-item-shape : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-item-shape (n) (item) (sx) (sy) (sw) (sh) (color) =
    when item.ci-kind
      is CiComponent -> draw-comp-shape n item sx sy sw sh color
      is CiWire -> let rw = if sw < 1 then 1 else sw in let rh = if sh < 1 then 1 else sh in gpu-seq (gpu-rect n sx sy rw rh color) (n + 2)
      is CiLabel -> draw-gpu-text n sx sy (item.ci-ref) color max-tris
      is CiJunction -> draw-junction-gpu n sx sy color
      is CiPowerRail -> draw-power-rail-gpu n sx sy sw color

  draw-comp-shape : Integer, CanvasItem, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-comp-shape (n) (item) (sx) (sy) (sw) (sh) (color) =
    when item.ci-subtype
      is SubIc -> draw-ic-gpu n sx sy sw sh color (item.ci-pins-left) (item.ci-pins-right)
      is SubResistor -> draw-res-gpu n sx sy sw sh color
      is SubCapacitor -> draw-cap-gpu n sx sy sh color
      is SubLed -> draw-led-gpu n sx sy sw sh color
      is SubConnector -> draw-conn-gpu n sx sy sw sh color (item.ci-pins-right)
      is SubSwitch -> draw-sw-gpu n sx sy sw color
      is SubGeneric -> draw-generic-gpu n sx sy sw sh color

  draw-ic-gpu : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-ic-gpu (n) (x) (y) (w) (h) (color) (pl) (pr) =
    draw-pins-numbered (draw-pins-numbered (gpu-seq (gpu-rect n x y w h #1A1A2E + gpu-rect (n + 2) x y w 2 color + gpu-rect (n + 4) x (y + h - 2) w 2 color + gpu-rect (n + 6) x y 2 h color + gpu-rect (n + 8) (x + w - 2) y 2 h color + gpu-tri (n + 10) (x + w / 2 - 5) y (x + w / 2 + 5) y (x + w / 2) (y + 8) col-text-dim col-text-dim col-text-dim) (n + 11)) (x - 10) x y h pl 10 0 1) (x + w) (x + w - 12) y h pr 10 0 (pl + 1)

  draw-pins-numbered : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-pins-numbered (n) (px) (lx) (y) (h) (count) (pw) (i) (num) =
    if i >= count then n
    else if n >= max-tris then n
    else let py = y + 8 + i * ((h - 16) / (if count > 1 then count - 1 else 1))
    in draw-pins-numbered (draw-gpu-text (gpu-seq (gpu-rect n px py pw 1 col-pin) (n + 2)) (lx + 2) (py - 3) (show (num + i)) col-text-dim max-tris) px lx y h count pw (i + 1) num

  draw-pins-side : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-pins-side (n) (px) (y) (h) (count) (pw) (i) =
    if i >= count then n
    else if n >= max-tris then n
    else let py = y + 8 + i * ((h - 16) / (if count > 1 then count - 1 else 1))
    in draw-pins-side (gpu-seq (gpu-rect n px py pw 1 col-pin) (n + 2)) px y h count pw (i + 1)

  draw-res-gpu : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-res-gpu (n) (x) (y) (w) (h) (color) =
    let zs = w / 8
    in gpu-seq (gpu-rect n x y w h #1E1E38 + gpu-rect (n + 2) x y w 1 color + gpu-rect (n + 4) x (y + h - 1) w 1 color + gpu-rect (n + 6) x y 1 h color + gpu-rect (n + 8) (x + w - 1) y 1 h color + gpu-rect (n + 10) (x - 10) (y + h / 2) 10 1 col-pin + gpu-rect (n + 12) (x + w) (y + h / 2) 10 1 col-pin + gpu-rect (n + 14) (x + zs) (y + 1) 1 (h - 2) col-text-dim + gpu-rect (n + 16) (x + zs * 3) (y + 1) 1 (h - 2) col-text-dim + gpu-rect (n + 18) (x + zs * 5) (y + 1) 1 (h - 2) col-text-dim + gpu-rect (n + 20) (x + zs * 7) (y + 1) 1 (h - 2) col-text-dim) (n + 22)

  draw-cap-gpu : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-cap-gpu (n) (x) (y) (h) (color) =
    let mx = x + 8
    in gpu-seq (gpu-rect n mx y 1 (h / 3) color + gpu-rect (n + 2) (x + 2) (y + h / 3) 12 2 color + gpu-rect (n + 4) (x + 2) (y + h * 2 / 3) 12 2 color + gpu-rect (n + 6) mx (y + h * 2 / 3 + 2) 1 (h / 3) color) (n + 8)

  draw-led-gpu : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-led-gpu (n) (x) (y) (w) (h) (color) =
    gpu-seq (gpu-tri n x y x (y + h) (x + w) (y + h / 2) color color color + gpu-rect (n + 1) (x + w) y 2 h color + gpu-rect (n + 3) (x - 10) (y + h / 2) 10 1 col-pin + gpu-rect (n + 5) (x + w + 2) (y + h / 2) 10 1 col-pin) (n + 7)

  draw-conn-gpu : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-conn-gpu (n) (x) (y) (w) (h) (color) (pins) =
    draw-conn-pin-dots (draw-pins-side (gpu-seq (gpu-rect n x y w h color + gpu-rect (n + 2) x y w 2 col-text-dim + gpu-rect (n + 4) x (y + h - 2) w 2 col-text-dim + gpu-rect (n + 6) x y 2 h col-text-dim + gpu-rect (n + 8) (x + w - 2) y 2 h col-text-dim) (n + 10)) (x + w) y h pins 10 0) x y h pins 0

  draw-sw-gpu : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sw-gpu (n) (x) (y) (w) (color) =
    let cy = y + 8
    in gpu-seq (gpu-rect n (x - 10) cy 10 1 col-pin + gpu-rect (n + 2) (x + w) cy 10 1 col-pin + gpu-rect (n + 4) x (cy - 1) 3 3 color + gpu-rect (n + 6) (x + w - 3) (cy - 1) 3 3 color + gpu-rect (n + 8) (x + 3) (cy - 6) (w - 6) 2 color + gpu-rect (n + 10) (x + w / 2 - 1) (cy - 6) 2 6 color) (n + 12)

Section: Connector Pin Dots

  draw-conn-pin-dots : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-conn-pin-dots (n) (x) (y) (h) (count) (i) =
    if i >= count then n
    else if n >= max-tris then n
    else let py = y + 8 + i * ((h - 16) / (if count > 1 then count - 1 else 1))
    in draw-conn-pin-dots (gpu-seq (gpu-rect n (x + 4) (py - 2) 5 5 col-pin) (n + 2)) x y h count (i + 1)

Section: Junction and Power Symbols

  draw-junction-gpu : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-junction-gpu (n) (x) (y) (color) =
    gpu-seq (gpu-rect n (x - 3) (y - 3) 7 7 color + gpu-rect (n + 2) (x - 2) (y - 4) 5 1 color + gpu-rect (n + 4) (x - 2) (y + 4) 5 1 color + gpu-rect (n + 6) (x - 4) (y - 2) 1 5 color + gpu-rect (n + 8) (x + 4) (y - 2) 1 5 color) (n + 10)

  draw-power-rail-gpu : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-power-rail-gpu (n) (x) (y) (w) (color) =
    let rw = if w < 1 then 1 else w
    in if color == #CC3333 then draw-vcc-rail n x y rw
    else draw-gnd-rail n x y rw

  draw-vcc-rail : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-vcc-rail (n) (x) (y) (w) =
    gpu-seq (gpu-rect n x y w 2 #CC3333 + gpu-tri (n + 2) (x - 4) (y - 2) (x + 4) (y - 2) x (y - 8) #CC3333 #CC3333 #CC3333 + gpu-tri (n + 3) (x + w - 4) (y - 2) (x + w + 4) (y - 2) (x + w) (y - 8) #CC3333 #CC3333 #CC3333) (n + 4)

  draw-gnd-rail : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-gnd-rail (n) (x) (y) (w) =
    gpu-seq (gpu-rect n x y w 2 #53E467 + gpu-rect (n + 2) (x - 4) (y + 4) 12 2 #53E467 + gpu-rect (n + 4) (x - 2) (y + 8) 8 2 #53E467 + gpu-rect (n + 6) x (y + 12) 4 2 #53E467 + gpu-rect (n + 8) (x + w - 4) (y + 4) 12 2 #53E467 + gpu-rect (n + 10) (x + w - 2) (y + 8) 8 2 #53E467 + gpu-rect (n + 12) (x + w) (y + 12) 4 2 #53E467) (n + 14)

Section: Generic Component

  draw-generic-gpu : Integer, Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-generic-gpu (n) (x) (y) (w) (h) (color) =
    gpu-seq (gpu-rect n x y w 1 color + gpu-rect (n + 2) x (y + h - 1) w 1 color + gpu-rect (n + 4) x y 1 h color + gpu-rect (n + 6) (x + w - 1) y 1 h color + gpu-rect (n + 8) (x - 10) (y + h / 2) 10 1 col-pin + gpu-rect (n + 10) (x + w) (y + h / 2) 10 1 col-pin) (n + 12)

Section: Selection Box

  draw-sel-box : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-sel-box (n) (x) (y) (w) (h) =
    let m = 2
    in gpu-seq (gpu-rect n (x - m) (y - m) (w + m * 2) m #FFFFFF + gpu-rect (n + 2) (x - m) (y + h) (w + m * 2) m #FFFFFF + gpu-rect (n + 4) (x - m) y m h #FFFFFF + gpu-rect (n + 6) (x + w) y m h #FFFFFF) (n + 8)

Section: Hover Box

  draw-hover-box : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-hover-box (n) (x) (y) (w) (h) =
    let m = 1
    in gpu-seq (gpu-rect n (x - m) (y - m) (w + m * 2) m col-hover + gpu-rect (n + 2) (x - m) (y + h) (w + m * 2) m col-hover + gpu-rect (n + 4) (x - m) y m h col-hover + gpu-rect (n + 6) (x + w) y m h col-hover) (n + 8)

Section: Marquee Rectangle

  draw-marquee-rect : Integer, AppState -> [Gpu.Memory] Integer
  draw-marquee-rect (n) (st) =
    let x0 = st.as-drag-ox
    in let y0 = st.as-drag-oy
    in let x1 = (st.as-input).ri-mx
    in let y1 = (st.as-input).ri-my
    in let lx = if x0 < x1 then x0 else x1
    in let ly = if y0 < y1 then y0 else y1
    in let rw = if x0 < x1 then x1 - x0 else x0 - x1
    in let rh = if y0 < y1 then y1 - y0 else y0 - y1
    in if rw < 2 then n
    else if rh < 2 then n
    else gpu-seq (gpu-rect-top n lx ly rw 1 col-selection + gpu-rect-top (n + 2) lx (ly + rh) rw 1 col-selection + gpu-rect-top (n + 4) lx ly 1 rh col-selection + gpu-rect-top (n + 6) (lx + rw) ly 1 rh col-selection) (n + 8)

Section: Item Refs

  draw-item-refs : Integer, List CanvasItem, ViewPort -> [Gpu.Memory] Integer
  draw-item-refs (n) (items) (vp) = draw-ref-loop n items vp 0 (list-length items)

  draw-ref-loop : Integer, List CanvasItem, ViewPort, Integer, Integer -> [Gpu.Memory] Integer
  draw-ref-loop (n) (items) (vp) (i) (count) =
    if i >= count then n
    else if n >= max-tris then n
    else let item = list-at items i
    in draw-ref-loop (draw-ref-if-comp n item vp) items vp (i + 1) count

  draw-ref-if-comp : Integer, CanvasItem, ViewPort -> [Gpu.Memory] Integer
  draw-ref-if-comp (n) (item) (vp) =
    when item.ci-kind
      is CiComponent -> if text-length (item.ci-ref) == 0 then n else draw-gpu-text n (vp-world-to-screen-x vp (item.ci-x)) (vp-world-to-screen-y vp (item.ci-y) - 9) (item.ci-ref) col-refdes max-tris
      is otherwise -> n

Section: Wire Preview

  draw-wire-preview : Integer, AppState -> [Gpu.Memory] Integer
  draw-wire-preview (n) (st) =
    if st.as-wire-active == 0 then n
    else let vp = st.as-viewport
    in let sx1 = vp-world-to-screen-x vp (st.as-wire-x)
    in let sy1 = vp-world-to-screen-y vp (st.as-wire-y)
    in let sx2 = (st.as-input).ri-mx
    in let sy2 = (st.as-input).ri-my
    in let rw = if sx1 < sx2 then sx2 - sx1 else sx1 - sx2
    in let rh = if sy1 < sy2 then sy2 - sy1 else sy1 - sy2
    in let lx = if sx1 < sx2 then sx1 else sx2
    in let ly = if sy1 < sy2 then sy1 else sy2
    in gpu-seq (gpu-rect n lx sy1 (if rw < 1 then 1 else rw) 1 col-wire + gpu-rect (n + 2) sx2 ly 1 (if rh < 1 then 1 else rh) col-wire) (n + 4)

Section: Placement Ghost

  draw-place-ghost : Integer, AppState -> [Gpu.Memory] Integer
  draw-place-ghost (n) (st) =
    if st.as-tool /= tool-place then n
    else let mx = (st.as-input).ri-mx
    in let my = (st.as-input).ri-my
    in let cw = app-w - sidebar-w
    in if mx >= cw then n
    else if my < canvas-top then n
    else if my >= app-h - status-h then n
    else let pe = palette-at (st.as-palette-idx)
    in let gw = pe.pe-w
    in let gh = pe.pe-h
    in let gx = mx - gw / 2
    in let gy = my - gh / 2
    in draw-gpu-text (gpu-seq (gpu-rect n gx gy gw gh #335577 + gpu-rect (n + 2) gx gy gw 1 col-selection + gpu-rect (n + 4) gx (gy + gh - 1) gw 1 col-selection + gpu-rect (n + 6) gx gy 1 gh col-selection + gpu-rect (n + 8) (gx + gw - 1) gy 1 gh col-selection) (n + 10)) gx (gy - 9) (pe.pe-name) col-selection max-tris

Section: Menu Bar

  btn-hover : Integer, Integer, Integer, Integer -> Integer
  btn-hover (mx) (my) (lo) (hi) =
    if mx >= lo then if mx < hi then if my < toolbar-h then 1 else 0 else 0 else 0

  draw-menubar-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-menubar-bg (n) (st) =
    let tool = st.as-tool
    in let mx = (st.as-input).ri-mx
    in let my = (st.as-input).ri-my
    in let file-bg = if st.as-menu-open == menu-file then col-accent else if btn-hover mx my 4 54 == 1 then #1A3A70 else col-toolbar
    in let edit-bg = if st.as-menu-open == menu-edit then col-accent else if btn-hover mx my 58 98 == 1 then #1A3A70 else col-toolbar
    in let view-bg = if st.as-menu-open == menu-view then col-accent else if btn-hover mx my 102 142 == 1 then #1A3A70 else col-toolbar
    in let place-bg = if st.as-menu-open == menu-place then col-accent else if btn-hover mx my 146 186 == 1 then #1A3A70 else col-toolbar
    in let sel-c = if tool == tool-select then col-accent else col-panel
    in let wir-c = if tool == tool-wire then col-accent else col-panel
    in let plc-c = if tool == tool-place then col-accent else col-panel
    in let dirty-c = if st.as-dirty == 1 then col-accent else col-toolbar
    in gpu-seq (gpu-rect n 0 0 app-w toolbar-h col-toolbar + gpu-rect (n + 2) 4 4 50 20 file-bg + gpu-rect (n + 4) 58 4 40 20 edit-bg + gpu-rect (n + 6) 102 4 40 20 view-bg + gpu-rect (n + 8) 146 4 40 20 place-bg + gpu-rect (n + 10) 200 4 3 20 #444466 + gpu-rect (n + 12) 210 4 40 20 sel-c + gpu-rect (n + 14) 254 4 40 20 wir-c + gpu-rect (n + 16) 298 4 40 20 plc-c + gpu-rect (n + 18) (app-w - 60) 4 56 20 dirty-c) (n + 20)

  draw-menubar-text : Integer, AppState -> [Gpu.Memory] Integer
  draw-menubar-text (n) (st) =
    draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome n 12 10 "FILE" col-text max-tris) 65 10 "EDIT" col-text max-tris) 109 10 "VIEW" col-text max-tris) 149 10 "PLACE" col-text max-tris) 216 10 "SEL" col-text max-tris) 260 10 "WIRE" col-text max-tris) 304 10 "PLCE" col-text max-tris) (app-w - 54) 10 (if st.as-dirty == 1 then "UNSAVED" else "SAVED") col-text max-tris

Section: Dropdown Menus

  draw-dropdown : Integer, AppState -> [Gpu.Memory] Integer
  draw-dropdown (n) (st) =
    draw-dropdown-text (draw-dropdown-bg n st) st

  draw-dropdown-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-dropdown-bg (n) (st) =
    if st.as-menu-open == menu-file then draw-file-bg n st
    else if st.as-menu-open == menu-edit then draw-edit-bg n st
    else if st.as-menu-open == menu-view then draw-view-bg n st
    else if st.as-menu-open == menu-place then draw-place-bg n st
    else n

  draw-dropdown-text : Integer, AppState -> [Gpu.Memory] Integer
  draw-dropdown-text (n) (st) =
    if st.as-menu-open == menu-file then draw-file-items n st
    else if st.as-menu-open == menu-edit then draw-edit-items n st
    else if st.as-menu-open == menu-view then draw-view-items n st
    else if st.as-menu-open == menu-place then draw-place-items n st
    else n

  draw-menu-bg : Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-menu-bg (n) (x) (y) (count) =
    let mh = count * 20 + 4
    in gpu-seq (gpu-rect-mid n x y 124 mh #0A0A1E + gpu-rect-mid (n + 2) x y 124 1 col-accent + gpu-rect-mid (n + 4) x (y + mh - 1) 124 1 col-accent + gpu-rect-mid (n + 6) x y 1 mh col-accent + gpu-rect-mid (n + 8) (x + 123) y 1 mh col-accent) (n + 10)

  draw-menu-item-bg : Integer, Integer, Integer, Integer, AppState -> [Gpu.Memory] Integer
  draw-menu-item-bg (n) (x) (y) (idx) (st) =
    let iy = y + 2 + idx * 20
    in let mx = (st.as-input).ri-mx
    in let my = (st.as-input).ri-my
    in let hover = if mx >= x then if mx < x + 120 then if my >= iy then if my < iy + 20 then 1 else 0 else 0 else 0 else 0
    in let bg = if hover == 1 then col-accent else #0A0A1E
    in gpu-seq (gpu-rect-mid n (x + 2) iy 120 20 bg) (n + 2)

  draw-menu-item-text : Integer, Integer, Integer, Integer, Text, Integer -> [Gpu.Memory] Integer
  draw-menu-item-text (n) (x) (y) (idx) (label) (color) =
    let iy = y + 2 + idx * 20
    in draw-gpu-text n (x + 8) (iy + 6) label color max-tris

  draw-file-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-file-bg (n) (st) = draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-bg n 4 toolbar-h 4) 4 toolbar-h 0 st) 4 toolbar-h 1 st) 4 toolbar-h 2 st) 4 toolbar-h 3 st

  draw-file-items : Integer, AppState -> [Gpu.Memory] Integer
  draw-file-items (n) (st) = draw-menu-item-text (draw-menu-item-text (draw-menu-item-text (draw-menu-item-text n 4 toolbar-h 0 "NEW" col-text) 4 toolbar-h 1 "SAVE" col-text) 4 toolbar-h 2 "LOAD" col-text-dim) 4 toolbar-h 3 "QUIT" col-text

  draw-edit-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-edit-bg (n) (st) = draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-bg n 58 toolbar-h 5) 58 toolbar-h 0 st) 58 toolbar-h 1 st) 58 toolbar-h 2 st) 58 toolbar-h 3 st) 58 toolbar-h 4 st

  draw-edit-items : Integer, AppState -> [Gpu.Memory] Integer
  draw-edit-items (n) (st) = draw-menu-item-text (draw-menu-item-text (draw-menu-item-text (draw-menu-item-text (draw-menu-item-text n 58 toolbar-h 0 "UNDO      Z" col-text) 58 toolbar-h 1 "DELETE  DEL" col-text) 58 toolbar-h 2 "ROTATE    R" col-text) 58 toolbar-h 3 "DUPLICATE D" col-text) 58 toolbar-h 4 "SELECT ALL" col-text

  draw-view-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-view-bg (n) (st) = draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-item-bg (draw-menu-bg n 102 toolbar-h 4) 102 toolbar-h 0 st) 102 toolbar-h 1 st) 102 toolbar-h 2 st) 102 toolbar-h 3 st

  draw-view-items : Integer, AppState -> [Gpu.Memory] Integer
  draw-view-items (n) (st) = draw-menu-item-text (draw-menu-item-text (draw-menu-item-text (draw-menu-item-text n 102 toolbar-h 0 "ZOOM IN  +" col-text) 102 toolbar-h 1 "ZOOM OUT -" col-text) 102 toolbar-h 2 "FIT  HOME" col-text) 102 toolbar-h 3 "HELP     H" col-text

