Section: Tab Bar

  draw-tab-bar-bg : Integer, Integer -> [Gpu.Memory] Integer
  draw-tab-bar-bg (n) (active) =
    let y = toolbar-h
    in let t0 = if active == 0 then col-bg else col-toolbar
    in let t1 = if active == 1 then col-bg else col-toolbar
    in let t2 = if active == 2 then col-bg else col-toolbar
    in let t3 = if active == 3 then col-bg else col-toolbar
    in gpu-seq (gpu-rect n 0 y app-w tab-h col-panel + gpu-rect (n + 2) 2 (y + 2) 80 20 t0 + gpu-rect (n + 4) 86 (y + 2) 70 20 t1 + gpu-rect (n + 6) 160 (y + 2) 80 20 t2 + gpu-rect (n + 8) 244 (y + 2) 60 20 t3 + gpu-rect (n + 10) 2 (y + 22) 80 2 (if active == 0 then col-accent else col-panel) + gpu-rect (n + 12) 86 (y + 22) 70 2 (if active == 1 then col-accent else col-panel) + gpu-rect (n + 14) 160 (y + 22) 80 2 (if active == 2 then col-accent else col-panel) + gpu-rect (n + 16) 244 (y + 22) 60 2 (if active == 3 then col-accent else col-panel)) (n + 18)

  draw-tab-bar-text : Integer, Integer -> [Gpu.Memory] Integer
  draw-tab-bar-text (n) (active) =
    let y = toolbar-h
    in let c0 = if active == 0 then #FFFFFF else col-text-dim
    in let c1 = if active == 1 then #FFFFFF else col-text-dim
    in let c2 = if active == 2 then #FFFFFF else col-text-dim
    in let c3 = if active == 3 then #FFFFFF else col-text-dim
    in draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome n 10 (y + 8) "SCHEMATIC" c0 max-tris) 94 (y + 8) "PCB" c1 max-tris) 168 (y + 8) "3D VIEW" c2 max-tris) 252 (y + 8) "SIM" c3 max-tris

Section: Sidebar

  draw-sidebar-bg : Integer, Integer -> [Gpu.Memory] Integer
  draw-sidebar-bg (n) (pal-idx) =
    let sx = app-w - sidebar-w
    in let sh = app-h - canvas-top - status-h
    in draw-palette-bg (gpu-seq (gpu-rect n sx canvas-top sidebar-w sh col-panel + gpu-rect (n + 2) sx canvas-top 1 sh #444466 + gpu-rect (n + 4) (sx + 4) (canvas-top + 4) 192 16 col-toolbar) (n + 6)) sx (canvas-top + 28) pal-idx 0

  draw-palette-bg : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-palette-bg (n) (sx) (y) (sel) (i) =
    if i >= palette-count then n
    else let bg = if i == sel then col-accent else col-toolbar
    in draw-palette-bg (gpu-seq (gpu-rect n (sx + 4) (y + i * 20) 192 16 bg) (n + 2)) sx y sel (i + 1)

  draw-sidebar-text : Integer, Integer -> [Gpu.Memory] Integer
  draw-sidebar-text (n) (pal-idx) =
    let sx = app-w - sidebar-w
    in draw-palette-text (draw-gpu-text-chrome n (sx + 8) (canvas-top + 8) "COMPONENTS" col-text max-tris) sx (canvas-top + 28) pal-idx 0

  draw-palette-text : Integer, Integer, Integer, Integer, Integer -> [Gpu.Memory] Integer
  draw-palette-text (n) (sx) (y) (sel) (i) =
    if i >= palette-count then n
    else if n >= max-tris then n
    else let pe = palette-at i
    in let label = (show (i + 1)) & " " & (pe.pe-name)
    in draw-palette-text (draw-gpu-text-chrome n (sx + 8) (y + i * 20 + 4) label col-text max-tris) sx y sel (i + 1)

Section: Status Bar

  draw-status-bg : Integer, AppState -> [Gpu.Memory] Integer
  draw-status-bg (n) (st) =
    let sy = app-h - status-h
    in gpu-seq (gpu-rect n 0 sy app-w status-h col-toolbar) (n + 2)

  draw-status-text-all : Integer, AppState -> [Gpu.Memory] Integer
  draw-status-text-all (n) (st) =
    let sy = app-h - status-h
    in let vp = st.as-viewport
    in let wx = vp-screen-to-world-x vp ((st.as-input).ri-mx)
    in let wy = vp-screen-to-world-y vp ((st.as-input).ri-my)
    in let item-count = list-length (st.as-items)
    in let sel-count = count-selected (st.as-items)
    in let hover-label = status-hover-label (st.as-items) (st.as-hover-idx)
    in let undo-label = if eh-can-undo (st.as-history) == 1 then "UNDO:" & (show (st.as-history).us-depth) else ""
    in draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome n 4 (sy + 6) ("X:" & (show wx)) col-wire max-tris) 80 (sy + 6) ("Y:" & (show wy)) col-wire max-tris) 160 (sy + 6) (tool-name (st.as-tool)) col-accent max-tris) 260 (sy + 6) ((show item-count) & " ITEMS") col-text-dim max-tris) 380 (sy + 6) ((show sel-count) & " SEL") col-text-dim max-tris) 480 (sy + 6) ((show (vp.vp-zoom)) & "%") col-text-dim max-tris) 560 (sy + 6) ("G:" & (show (vp.vp-grid))) col-text-dim max-tris) 640 (sy + 6) hover-label col-hover max-tris) 740 (sy + 6) undo-label col-text-dim max-tris

  status-hover-label : List CanvasItem, Integer -> Text
  status-hover-label (items) (idx) =
    if idx < 0 then ""
    else if idx >= list-length items then ""
    else let item = list-at items idx
    in let kind = status-item-kind item
    in if text-length (item.ci-ref) > 0 then item.ci-ref & " (" & kind & ")"
    else kind

  status-item-kind : CanvasItem -> Text
  status-item-kind (item) = when item.ci-kind
    is CiComponent -> when item.ci-subtype
      is SubIc -> "IC"
      is SubResistor -> "RES"
      is SubCapacitor -> "CAP"
      is SubLed -> "LED"
      is SubConnector -> "CONN"
      is SubSwitch -> "SW"
      is SubGeneric -> "COMP"
    is CiWire -> "WIRE"
    is CiLabel -> "LABEL"
    is CiJunction -> "JCT"
    is CiPowerRail -> "RAIL"

Section: Crosshair

  draw-crosshair-gpu : Integer, Integer, Integer, ViewPort -> [Gpu.Memory] Integer
  draw-crosshair-gpu (n) (mx) (my) (vp) =
    if mx < vp.vp-canvas-x then n
    else if mx >= vp.vp-canvas-x + vp.vp-canvas-w then n
    else if my < vp.vp-canvas-y then n
    else if my >= vp.vp-canvas-y + vp.vp-canvas-h then n
    else let cx = vp.vp-canvas-x
    in let cy = vp.vp-canvas-y
    in let cw = vp.vp-canvas-w
    in let ch = vp.vp-canvas-h
    in gpu-seq (gpu-rect-top n cx my cw 1 #44447788 + gpu-rect-top (n + 2) mx cy 1 ch #44447788 + gpu-rect-top (n + 4) (mx - 8) my 17 1 #FFFFFF + gpu-rect-top (n + 6) mx (my - 8) 1 17 #FFFFFF) (n + 8)

Section: Description Panel

  draw-description-panel : Integer, Integer -> [Gpu.Memory] Integer
  draw-description-panel (n) (y) =
    let sx = app-w - sidebar-w
    in draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (draw-gpu-text-chrome (gpu-seq (gpu-rect n (sx + 4) y 192 1 #444466 + gpu-rect (n + 2) (sx + 4) (y + 4) 192 16 col-toolbar) (n + 4)) (sx + 8) (y + 8) "DESCRIPTION" col-text max-tris) (sx + 8) (y + 26) "STM32F405 minimum" col-text-dim max-tris) (sx + 8) (y + 38) "development board." col-text-dim max-tris) (sx + 8) (y + 52) "USB-C, 3.3V LDO," col-text-dim max-tris) (sx + 8) (y + 64) "LEDs, reset, XTAL." col-text-dim max-tris

Section: Properties Panel

  draw-properties-panel : Integer, Integer, AppState -> [Gpu.Memory] Integer
  draw-properties-panel (n) (y) (st) =
    let sx = app-w - sidebar-w
    in draw-properties-body (draw-gpu-text-chrome (gpu-seq (gpu-rect n (sx + 4) y 192 1 #444466 + gpu-rect (n + 2) (sx + 4) (y + 4) 192 16 col-toolbar) (n + 4)) (sx + 8) (y + 8) "PROPERTIES" col-text max-tris) sx y st

  draw-properties-body : Integer, Integer, Integer, AppState -> [Gpu.Memory] Integer
  draw-properties-body (n) (sx) (y) (st) =
    let idx = st.as-hover-idx
    in if idx < 0 then draw-gpu-text-chrome n (sx + 8) (y + 26) "Hover to inspect" col-text-dim max-tris
    else if idx >= list-length (st.as-items) then draw-gpu-text-chrome n (sx + 8) (y + 26) "Hover to inspect" col-text-dim max-tris
    else draw-prop-detail n sx y (list-at (st.as-items) idx)

  draw-prop-detail : Integer, Integer, Integer, CanvasItem -> [Gpu.Memory] Integer
  draw-prop-detail (n) (sx) (y) (item) =
    let kind = prop-comp-kind item
    in let val = prop-val item
    in let pos = (show (item.ci-x)) & "," & (show (item.ci-y)) & "  " & (show (item.ci-w)) & "x" & (show (item.ci-h))
    in let fp = prop-pkg item
    in draw-prop-text-if (draw-gpu-text-chrome (draw-prop-text-if (draw-prop-text-if (draw-gpu-text-chrome n (sx + 8) (y + 26) kind col-accent max-tris) (sx + 8) (y + 40) (item.ci-ref) col-refdes) (sx + 8) (y + 54) val col-value) (sx + 8) (y + 68) pos col-text-dim max-tris) (sx + 8) (y + 82) fp col-text-dim

  draw-prop-text-if : Integer, Integer, Integer, Text, Integer -> [Gpu.Memory] Integer
  draw-prop-text-if (n) (x) (y) (t) (color) =
    if text-length t > 0 then draw-gpu-text-chrome n x y t color max-tris else n

  prop-comp-kind : CanvasItem -> Text
  prop-comp-kind (item) = when item.ci-kind
    is CiComponent -> prop-sub-kind (item.ci-subtype)
    is CiWire -> "Wire"
    is CiLabel -> "Label"
    is CiJunction -> "Junction"
    is CiPowerRail -> "Power Rail"

  prop-sub-kind : CompSubtype -> Text
  prop-sub-kind (st) = when st
    is SubIc -> "IC"
    is SubResistor -> "Resistor"
    is SubCapacitor -> "Capacitor"
    is SubLed -> "LED"
    is SubConnector -> "Connector"
    is SubSwitch -> "Switch"
    is SubGeneric -> "Component"

  prop-val : CanvasItem -> Text
  prop-val (item) =
    let ref = item.ci-ref
    in if ref == "R1" then "1.5K"
    else if ref == "R2" then "1.5K"
    else if ref == "R3" then "330"
    else if ref == "R4" then "330"
    else if ref == "R5" then "10K"
    else if ref == "C1" then "100nF"
    else if ref == "C2" then "100nF"
    else if ref == "C3" then "10uF"
    else if ref == "C4" then "100nF"
    else if ref == "U1" then "STM32F405RG"
    else if ref == "U2" then "LDO-3V3"
    else if ref == "D1" then "Green LED"
    else if ref == "D2" then "Red LED"
    else if ref == "Y1" then "8 MHz"
    else if ref == "J1" then "USB-C"
    else if ref == "SW1" then "Tactile"
    else ""

  prop-pkg : CanvasItem -> Text
  prop-pkg (item) = when item.ci-kind
    is CiComponent -> prop-sub-pkg (item.ci-ref) (item.ci-subtype)
    is otherwise -> ""

  prop-sub-pkg : Text, CompSubtype -> Text
  prop-sub-pkg (ref) (st) = when st
    is SubIc -> if ref == "U1" then "LQFP-64" else "SOT-223"
    is SubResistor -> "0402"
    is SubCapacitor -> if ref == "C3" then "0805" else "0402"
    is SubLed -> "0603"
    is SubConnector -> "USB-C-16P"
    is SubSwitch -> "6x6mm"
    is SubGeneric -> "HC49"

