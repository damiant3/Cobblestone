Chapter: DesignRules
  cites Foreword chapter List
  cites Foreword chapter Maybe

 Design rule definitions for both ERC (electrical rules check) and
 DRC (design rules check). Rules are data — the checker walks the
 design and evaluates each rule. Rules can be customized per net class,
 per area, or globally.

Section: Severity

  RuleSeverity =
    | SeverityError
    | SeverityWarning
    | SeverityInfo
    | SeverityIgnore

  severity-name : RuleSeverity -> Text
  severity-name (s) = when s
    is SeverityError -> "error"
    is SeverityWarning -> "warning"
    is SeverityInfo -> "info"
    is SeverityIgnore -> "ignore"

Section: Clearance Rules

  ClearanceRule = record {
    cr-name : Text,
    cr-min-clearance : Integer,
    cr-layer : Integer,
    cr-net-class-a : Text,
    cr-net-class-b : Text,
    cr-severity : RuleSeverity
  }

  default-clearance : ClearanceRule
  default-clearance = ClearanceRule {
    cr-name = "default-clearance",
    cr-min-clearance = 200000,
    cr-layer = -1,
    cr-net-class-a = "*",
    cr-net-class-b = "*",
    cr-severity = SeverityError
  }

Section: Width Rules

  WidthRule = record {
    wr-name : Text,
    wr-min-width : Integer,
    wr-max-width : Integer,
    wr-net-class : Text,
    wr-severity : RuleSeverity
  }

  default-width : WidthRule
  default-width = WidthRule {
    wr-name = "default-width",
    wr-min-width = 150000,
    wr-max-width = 10000000,
    wr-net-class = "*",
    wr-severity = SeverityError
  }

Section: Via Rules

  ViaRule = record {
    vr-name : Text,
    vr-min-diameter : Integer,
    vr-max-diameter : Integer,
    vr-min-drill : Integer,
    vr-max-drill : Integer,
    vr-min-annular-ring : Integer,
    vr-net-class : Text,
    vr-severity : RuleSeverity
  }

  default-via : ViaRule
  default-via = ViaRule {
    vr-name = "default-via",
    vr-min-diameter = 600000,
    vr-max-diameter = 3000000,
    vr-min-drill = 300000,
    vr-max-drill = 1500000,
    vr-min-annular-ring = 150000,
    vr-net-class = "*",
    vr-severity = SeverityError
  }

Section: Impedance Rules

  ImpedanceRule = record {
    ir-name : Text,
    ir-target-impedance : Integer,
    ir-tolerance-pct : Integer,
    ir-is-differential : Integer,
    ir-net-class : Text,
    ir-severity : RuleSeverity
  }

Section: Length Rules

  LengthRule = record {
    lr-name : Text,
    lr-min-length : Integer,
    lr-max-length : Integer,
    lr-max-skew : Integer,
    lr-net-class : Text,
    lr-severity : RuleSeverity
  }

Section: Spacing Rules

  SpacingRule = record {
    sr-name : Text,
    sr-min-silk-to-pad : Integer,
    sr-min-silk-to-silk : Integer,
    sr-min-hole-to-hole : Integer,
    sr-min-hole-to-edge : Integer,
    sr-min-track-to-edge : Integer,
    sr-severity : RuleSeverity
  }

  default-spacing : SpacingRule
  default-spacing = SpacingRule {
    sr-name = "default-spacing",
    sr-min-silk-to-pad = 100000,
    sr-min-silk-to-silk = 100000,
    sr-min-hole-to-hole = 250000,
    sr-min-hole-to-edge = 500000,
    sr-min-track-to-edge = 250000,
    sr-severity = SeverityError
  }

Section: Manufacturing Profile

 A manufacturing profile represents a fab house's capabilities.
 DRC rules can be generated from a profile to catch violations
 before submitting to manufacturing.

  ManufacturingProfile = record {
    mp-name : Text,
    mp-min-trace : Integer,
    mp-min-space : Integer,
    mp-min-drill : Integer,
    mp-min-annular : Integer,
    mp-min-silk-width : Integer,
    mp-min-silk-height : Integer,
    mp-min-hole-to-hole : Integer,
    mp-min-hole-to-edge : Integer,
    mp-max-layers : Integer,
    mp-max-board-width : Integer,
    mp-max-board-height : Integer,
    mp-supports-blind-via : Integer,
    mp-supports-buried-via : Integer,
    mp-supports-micro-via : Integer
  }

  standard-pcb-profile : ManufacturingProfile
  standard-pcb-profile = ManufacturingProfile {
    mp-name = "Standard PCB (JLCPCB/PCBWay)",
    mp-min-trace = 127000,
    mp-min-space = 127000,
    mp-min-drill = 300000,
    mp-min-annular = 125000,
    mp-min-silk-width = 150000,
    mp-min-silk-height = 800000,
    mp-min-hole-to-hole = 250000,
    mp-min-hole-to-edge = 250000,
    mp-max-layers = 16,
    mp-max-board-width = 500000000,
    mp-max-board-height = 500000000,
    mp-supports-blind-via = 0,
    mp-supports-buried-via = 0,
    mp-supports-micro-via = 0
  }

  advanced-pcb-profile : ManufacturingProfile
  advanced-pcb-profile = ManufacturingProfile {
    mp-name = "Advanced PCB (OSH Park)",
    mp-min-trace = 127000,
    mp-min-space = 127000,
    mp-min-drill = 254000,
    mp-min-annular = 102000,
    mp-min-silk-width = 150000,
    mp-min-silk-height = 800000,
    mp-min-hole-to-hole = 200000,
    mp-min-hole-to-edge = 200000,
    mp-max-layers = 8,
    mp-max-board-width = 250000000,
    mp-max-board-height = 250000000,
    mp-supports-blind-via = 0,
    mp-supports-buried-via = 0,
    mp-supports-micro-via = 0
  }

Section: Violation

  DrcViolation = record {
    dv-rule-name : Text,
    dv-severity : RuleSeverity,
    dv-message : Text,
    dv-x : Integer,
    dv-y : Integer,
    dv-item-a : Text,
    dv-item-b : Text,
    dv-actual-value : Integer,
    dv-required-value : Integer
  }

Section: Rule Set

  DesignRuleSet = record {
    drs-clearance-rules : List ClearanceRule,
    drs-width-rules : List WidthRule,
    drs-via-rules : List ViaRule,
    drs-impedance-rules : List ImpedanceRule,
    drs-length-rules : List LengthRule,
    drs-spacing-rules : List SpacingRule,
    drs-profile : ManufacturingProfile
  }

  default-rule-set : DesignRuleSet
  default-rule-set = DesignRuleSet {
    drs-clearance-rules = [default-clearance],
    drs-width-rules = [default-width],
    drs-via-rules = [default-via],
    drs-impedance-rules = [],
    drs-length-rules = [],
    drs-spacing-rules = [default-spacing],
    drs-profile = standard-pcb-profile
  }
