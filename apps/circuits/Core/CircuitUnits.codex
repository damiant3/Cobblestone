Chapter: CircuitUnits
  cites Foreword chapter List

Section: Length

  Nanometer = unit Integer
  Micrometer = unit Integer
  Millimeter = unit Integer
  Mil = unit Integer
  Inch = unit Integer

  nm-to-mm : Nanometer -> Millimeter
  nm-to-mm (n) = Millimeter (n / 1000000)

  um-to-mm : Micrometer -> Millimeter
  um-to-mm (n) = Millimeter (n / 1000)

  mil-to-mm : Mil -> Millimeter
  mil-to-mm (n) = Millimeter (n * 254 / 10000)

  mm-to-mil : Millimeter -> Mil
  mm-to-mil (n) = Mil (n * 10000 / 254)

  mm-to-nm : Millimeter -> Nanometer
  mm-to-nm (n) = Nanometer (n * 1000000)

  inch-to-mm : Inch -> Millimeter
  inch-to-mm (n) = Millimeter (n * 254 / 10)

  mm-to-inch : Millimeter -> Inch
  mm-to-inch (n) = Inch (n * 10 / 254)

Section: Angle

  Degree = unit Integer
  Decidegree = unit Integer

  degree-to-decidegree : Degree -> Decidegree
  degree-to-decidegree (d) = Decidegree (d * 10)

  decidegree-to-degree : Decidegree -> Integer
  decidegree-to-degree (d) = d / 10

Section: Electrical

  Ohm = unit Integer
  Milliohm = unit Integer
  Farad = unit Integer
  Picofarad = unit Integer
  Nanofarad = unit Integer
  Microfarad = unit Integer
  Henry = unit Integer
  Nanohenry = unit Integer
  Microhenry = unit Integer
  Ampere = unit Integer
  Milliampere = unit Integer
  Volt = unit Integer
  Millivolt = unit Integer
  Watt = unit Integer
  Milliwatt = unit Integer
  Hertz = unit Integer
  Kilohertz = unit Integer
  Megahertz = unit Integer
  Gigahertz = unit Integer

  pf-to-nf : Picofarad -> Nanofarad
  pf-to-nf (p) = Nanofarad (p / 1000)

  nf-to-uf : Nanofarad -> Microfarad
  nf-to-uf (n) = Microfarad (n / 1000)

  nh-to-uh : Nanohenry -> Microhenry
  nh-to-uh (n) = Microhenry (n / 1000)

  ma-to-a : Milliampere -> Ampere
  ma-to-a (m) = Ampere (m / 1000)

  mv-to-v : Millivolt -> Volt
  mv-to-v (m) = Volt (m / 1000)

  hz-to-khz : Hertz -> Kilohertz
  hz-to-khz (h) = Kilohertz (h / 1000)

  khz-to-mhz : Kilohertz -> Megahertz
  khz-to-mhz (k) = Megahertz (k / 1000)

  mhz-to-ghz : Megahertz -> Gigahertz
  mhz-to-ghz (m) = Gigahertz (m / 1000)

Section: Time

  Picosecond = unit Integer
  Nanosecond = unit Integer
  Microsecond = unit Integer

  ps-to-ns : Picosecond -> Nanosecond
  ps-to-ns (p) = Nanosecond (p / 1000)

  ns-to-us : Nanosecond -> Microsecond
  ns-to-us (n) = Microsecond (n / 1000)

Section: Temperature

  Kelvin = unit Integer
  Celsius = unit Integer

  celsius-to-kelvin : Celsius -> Kelvin
  celsius-to-kelvin (c) = Kelvin (c + 273)

  kelvin-to-celsius : Kelvin -> Celsius
  kelvin-to-celsius (k) = Celsius (k - 273)

Section: Geometry

 A 2D point in nanometer coordinates. Internal representation uses
 nanometers for sub-mil precision without floating point.

  Point2D = record {
    px : Integer,
    py : Integer
  }

  point-zero : Point2D
  point-zero = Point2D { px = 0, py = 0 }

  point-add : Point2D, Point2D -> Point2D
  point-add (a) (b) = Point2D { px = a.px + b.px, py = a.py + b.py }

  point-sub : Point2D, Point2D -> Point2D
  point-sub (a) (b) = Point2D { px = a.px - b.px, py = a.py - b.py }

  point-scale : Point2D, Integer -> Point2D
  point-scale (p) (s) = Point2D { px = p.px * s, py = p.py * s }

  point-distance-sq : Point2D, Point2D -> Integer
  point-distance-sq (a) (b) =
    let dx = a.px - b.px
    in let dy = a.py - b.py
    in dx * dx + dy * dy

  BoundingBox = record {
    bb-x1 : Integer,
    bb-y1 : Integer,
    bb-x2 : Integer,
    bb-y2 : Integer
  }

  bb-width : BoundingBox -> Integer
  bb-width (bb) = bb.bb-x2 - bb.bb-x1

  bb-height : BoundingBox -> Integer
  bb-height (bb) = bb.bb-y2 - bb.bb-y1

  bb-contains : BoundingBox, Point2D -> Integer
  bb-contains (bb) (p) =
    if p.px >= bb.bb-x1 then
      if p.px <= bb.bb-x2 then
        if p.py >= bb.bb-y1 then
          if p.py <= bb.bb-y2 then 1
          else 0
        else 0
      else 0
    else 0

  bb-union : BoundingBox, BoundingBox -> BoundingBox
  bb-union (a) (b) =
    let x1 = if a.bb-x1 < b.bb-x1 then a.bb-x1 else b.bb-x1
    in let y1 = if a.bb-y1 < b.bb-y1 then a.bb-y1 else b.bb-y1
    in let x2 = if a.bb-x2 > b.bb-x2 then a.bb-x2 else b.bb-x2
    in let y2 = if a.bb-y2 > b.bb-y2 then a.bb-y2 else b.bb-y2
    in BoundingBox { bb-x1 = x1, bb-y1 = y1, bb-x2 = x2, bb-y2 = y2 }

  bb-intersects : BoundingBox, BoundingBox -> Integer
  bb-intersects (a) (b) =
    if a.bb-x1 > b.bb-x2 then 0
    else if a.bb-x2 < b.bb-x1 then 0
    else if a.bb-y1 > b.bb-y2 then 0
    else if a.bb-y2 < b.bb-y1 then 0
    else 1

Section: Color

  Color = record {
    color-r : Integer between 0 and 255,
    color-g : Integer between 0 and 255,
    color-b : Integer between 0 and 255,
    color-a : Integer between 0 and 255
  }

  color-rgb : Integer, Integer, Integer -> Color
  color-rgb (r) (g) (b) = Color {
    color-r = __narrow r,
    color-g = __narrow g,
    color-b = __narrow b,
    color-a = __narrow 255
  }

  color-rgba : Integer, Integer, Integer, Integer -> Color
  color-rgba (r) (g) (b) (a) = Color {
    color-r = __narrow r,
    color-g = __narrow g,
    color-b = __narrow b,
    color-a = __narrow a
  }

  color-to-argb : Color -> Integer
  color-to-argb (c) =
    c.color-a * 16777216 + c.color-r * 65536 + c.color-g * 256 + c.color-b
