Chapter: ProjectModel
  cites Foreword chapter List
  cites Foreword chapter Maybe

Section: Display Units

  DisplayUnits =
    | Millimeters
    | Mils
    | Inches

Section: Sheet Reference

  SheetRef = record {
    sr-sheet-id : Text,
    sr-sheet-name : Text,
    sr-sheet-file : Text,
    sr-parent-sheet-id : Text
  }

Section: Project Settings

  ProjectSettings = record {
    ps-grid-size-nm : Integer,
    ps-snap-to-grid : Integer,
    ps-units-display : DisplayUnits,
    ps-auto-save-interval : Integer,
    ps-author : Text,
    ps-company : Text,
    ps-date : Text
  }

  default-settings : ProjectSettings
  default-settings = ProjectSettings {
    ps-grid-size-nm = 1270000,
    ps-snap-to-grid = 1,
    ps-units-display = Millimeters,
    ps-auto-save-interval = 300,
    ps-author = "",
    ps-company = "",
    ps-date = ""
  }

Section: Project

  Project = record {
    pr-name : Text,
    pr-sheets : List SheetRef,
    pr-netlist : Text,
    pr-stack-up : Text,
    pr-design-rules : Text,
    pr-variant-set : Text,
    pr-settings : ProjectSettings,
    pr-output-dir : Text
  }

  empty-project : Text -> Project
  empty-project (name) = Project {
    pr-name = name,
    pr-sheets = [],
    pr-netlist = "",
    pr-stack-up = "",
    pr-design-rules = "",
    pr-variant-set = "",
    pr-settings = default-settings,
    pr-output-dir = "output"
  }

  project-add-sheet : Project, SheetRef -> Project
  project-add-sheet (proj) (sheet) = Project {
    pr-name = proj.pr-name,
    pr-sheets = list-push proj.pr-sheets sheet,
    pr-netlist = proj.pr-netlist,
    pr-stack-up = proj.pr-stack-up,
    pr-design-rules = proj.pr-design-rules,
    pr-variant-set = proj.pr-variant-set,
    pr-settings = proj.pr-settings,
    pr-output-dir = proj.pr-output-dir
  }

  project-sheet-count : Project -> Integer
  project-sheet-count (proj) = list-length proj.pr-sheets

Section: Sheet Lookup

  project-find-sheet : Project, Text -> Maybe SheetRef
  project-find-sheet (proj) (sheet-id) =
    find-sheet-by-id proj.pr-sheets sheet-id

  find-sheet-by-id : List SheetRef, Text -> Maybe SheetRef
  find-sheet-by-id (sheets) (sheet-id) = find-sheet-by-id-loop sheets sheet-id 0 (list-length sheets)

  find-sheet-by-id-loop : List SheetRef, Text, Integer, Integer -> Maybe SheetRef
  find-sheet-by-id-loop (sheets) (sheet-id) (i) (n) =
    if i >= n then None
    else let s = list-at sheets i
    in if s.sr-sheet-id == sheet-id then Just s
    else find-sheet-by-id-loop sheets sheet-id (i + 1) n
