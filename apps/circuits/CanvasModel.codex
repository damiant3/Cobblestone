Chapter: CanvasModel
  cites Foreword chapter List

Section: Item Kind

  CanvasItemKind =
    | CiComponent
    | CiWire
    | CiLabel
    | CiJunction
    | CiPowerRail

Section: Canvas Item

  CompSubtype =
    | SubIc
    | SubResistor
    | SubCapacitor
    | SubLed
    | SubConnector
    | SubSwitch
    | SubGeneric

  CanvasItem = record {
    ci-id : Integer,
    ci-kind : CanvasItemKind,
    ci-x : Integer,
    ci-y : Integer,
    ci-w : Integer,
    ci-h : Integer,
    ci-color : Integer,
    ci-ref : Text,
    ci-selected : Integer,
    ci-subtype : CompSubtype,
    ci-pins-left : Integer,
    ci-pins-right : Integer,
    ci-rotation : Integer
  }

Section: Construction Helpers

  ci-ic : Integer, Integer, Integer, Integer, Integer, Integer, Text, Integer, Integer -> CanvasItem
  ci-ic (id) (x) (y) (w) (h) (color) (ref) (pl) (pr) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = w, ci-h = h, ci-color = color, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubIc, ci-pins-left = pl, ci-pins-right = pr, ci-rotation = 0
  }

  ci-resistor : Integer, Integer, Integer, Text -> CanvasItem
  ci-resistor (id) (x) (y) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = 32, ci-h = 10, ci-color = #E8A838, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubResistor, ci-pins-left = 1, ci-pins-right = 1, ci-rotation = 0
  }

  ci-capacitor : Integer, Integer, Integer, Text -> CanvasItem
  ci-capacitor (id) (x) (y) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = 16, ci-h = 24, ci-color = #E8A838, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubCapacitor, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-led-part : Integer, Integer, Integer, Integer, Text -> CanvasItem
  ci-led-part (id) (x) (y) (color) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = 20, ci-h = 20, ci-color = color, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubLed, ci-pins-left = 1, ci-pins-right = 1, ci-rotation = 0
  }

  ci-connector : Integer, Integer, Integer, Integer, Integer, Text, Integer -> CanvasItem
  ci-connector (id) (x) (y) (w) (h) (ref) (pins) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = w, ci-h = h, ci-color = #555555, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubConnector, ci-pins-left = 0, ci-pins-right = pins, ci-rotation = 0
  }

  ci-switch : Integer, Integer, Integer, Text -> CanvasItem
  ci-switch (id) (x) (y) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = 24, ci-h = 16, ci-color = #E8A838, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubSwitch, ci-pins-left = 1, ci-pins-right = 1, ci-rotation = 0
  }

  ci-component : Integer, Integer, Integer, Integer, Integer, Integer, Text -> CanvasItem
  ci-component (id) (x) (y) (w) (h) (color) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiComponent, ci-x = x, ci-y = y,
    ci-w = w, ci-h = h, ci-color = color, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-wire : Integer, Integer, Integer, Integer, Integer, Integer -> CanvasItem
  ci-wire (id) (x) (y) (w) (h) (color) = CanvasItem {
    ci-id = id, ci-kind = CiWire, ci-x = x, ci-y = y,
    ci-w = w, ci-h = h, ci-color = color, ci-ref = "", ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-label : Integer, Integer, Integer, Integer, Text -> CanvasItem
  ci-label (id) (x) (y) (chars) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiLabel, ci-x = x, ci-y = y,
    ci-w = chars * 6 + 4, ci-h = 12, ci-color = #53E4E4, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-net-label : Integer, Integer, Integer, Integer, Text -> CanvasItem
  ci-net-label (id) (x) (y) (chars) (ref) = CanvasItem {
    ci-id = id, ci-kind = CiLabel, ci-x = x, ci-y = y,
    ci-w = chars * 6 + 4, ci-h = 12, ci-color = #4488CC, ci-ref = ref, ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-junction : Integer, Integer, Integer, Integer -> CanvasItem
  ci-junction (id) (x) (y) (color) = CanvasItem {
    ci-id = id, ci-kind = CiJunction, ci-x = x, ci-y = y,
    ci-w = 6, ci-h = 6, ci-color = color, ci-ref = "", ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

  ci-rail : Integer, Integer, Integer, Integer, Integer -> CanvasItem
  ci-rail (id) (x) (y) (w) (color) = CanvasItem {
    ci-id = id, ci-kind = CiPowerRail, ci-x = x, ci-y = y,
    ci-w = w, ci-h = 1, ci-color = color, ci-ref = "", ci-selected = 0,
    ci-subtype = SubGeneric, ci-pins-left = 0, ci-pins-right = 0, ci-rotation = 0
  }

