Chapter: SymbolModel
  cites Foreword chapter List

Section: Pin Shape

  PinShape =
    | PinShapeLine
    | PinShapeClock
    | PinShapeInverted
    | PinShapeInvertedClock
    | PinShapeLowInput
    | PinShapeLowOutput
    | PinShapeEdgeClock
    | PinShapeNonLogic

Section: Pin Record

  SymPin = record {
    syp-number : Text,
    syp-name : Text,
    syp-x : Integer,
    syp-y : Integer,
    syp-length : Integer,
    syp-orientation : Integer,
    syp-electrical-type : Integer,
    syp-shape : PinShape,
    syp-hidden : Integer,
    syp-unit : Integer
  }

  sym-pin : Text, Text, Integer, Integer, Integer, Integer -> SymPin
  sym-pin (num) (name) (x) (y) (len) (orient) = SymPin {
    syp-number = num,
    syp-name = name,
    syp-x = x,
    syp-y = y,
    syp-length = len,
    syp-orientation = orient,
    syp-electrical-type = 0,
    syp-shape = PinShapeLine,
    syp-hidden = 0,
    syp-unit = 1
  }

Section: Body Graphics

  BodyGraphic =
    | BgRect (Integer) (Integer) (Integer) (Integer) (Integer)
    | BgCircle (Integer) (Integer) (Integer) (Integer)
    | BgArc (Integer) (Integer) (Integer) (Integer) (Integer) (Integer)
    | BgLine (Integer) (Integer) (Integer) (Integer) (Integer)
    | BgPolyline (List Integer) (Integer)
    | BgText (Text) (Integer) (Integer) (Integer)
    | BgBezier (Integer) (Integer) (Integer) (Integer) (Integer) (Integer) (Integer) (Integer) (Integer)

Section: Symbol Definition

  SymbolDef = record {
    sd-name : Text,
    sd-reference : Text,
    sd-value : Text,
    sd-pins : List SymPin,
    sd-graphics : List BodyGraphic,
    sd-pin-count : Integer,
    sd-unit-count : Integer,
    sd-body-style-count : Integer,
    sd-show-pin-names : Integer,
    sd-show-pin-numbers : Integer,
    sd-pin-name-offset : Integer,
    sd-power-symbol : Integer,
    sd-description : Text,
    sd-keywords : List Text,
    sd-datasheet : Text
  }

  empty-symbol : Text -> SymbolDef
  empty-symbol (name) = SymbolDef {
    sd-name = name,
    sd-reference = "U",
    sd-value = name,
    sd-pins = [],
    sd-graphics = [],
    sd-pin-count = 0,
    sd-unit-count = 1,
    sd-body-style-count = 1,
    sd-show-pin-names = 1,
    sd-show-pin-numbers = 1,
    sd-pin-name-offset = 500000,
    sd-power-symbol = 0,
    sd-description = "",
    sd-keywords = [],
    sd-datasheet = ""
  }

  symbol-add-pin : SymbolDef, SymPin -> SymbolDef
  symbol-add-pin (s) (p) = SymbolDef {
    sd-name = s.sd-name,
    sd-reference = s.sd-reference,
    sd-value = s.sd-value,
    sd-pins = list-push s.sd-pins p,
    sd-graphics = s.sd-graphics,
    sd-pin-count = s.sd-pin-count + 1,
    sd-unit-count = s.sd-unit-count,
    sd-body-style-count = s.sd-body-style-count,
    sd-show-pin-names = s.sd-show-pin-names,
    sd-show-pin-numbers = s.sd-show-pin-numbers,
    sd-pin-name-offset = s.sd-pin-name-offset,
    sd-power-symbol = s.sd-power-symbol,
    sd-description = s.sd-description,
    sd-keywords = s.sd-keywords,
    sd-datasheet = s.sd-datasheet
  }

  symbol-add-graphic : SymbolDef, BodyGraphic -> SymbolDef
  symbol-add-graphic (s) (g) = SymbolDef {
    sd-name = s.sd-name,
    sd-reference = s.sd-reference,
    sd-value = s.sd-value,
    sd-pins = s.sd-pins,
    sd-graphics = list-push s.sd-graphics g,
    sd-pin-count = s.sd-pin-count,
    sd-unit-count = s.sd-unit-count,
    sd-body-style-count = s.sd-body-style-count,
    sd-show-pin-names = s.sd-show-pin-names,
    sd-show-pin-numbers = s.sd-show-pin-numbers,
    sd-pin-name-offset = s.sd-pin-name-offset,
    sd-power-symbol = s.sd-power-symbol,
    sd-description = s.sd-description,
    sd-keywords = s.sd-keywords,
    sd-datasheet = s.sd-datasheet
  }

Section: Common Symbols

  symbol-resistor : SymbolDef
  symbol-resistor =
    let s = empty-symbol "R"
    in let s1 = SymbolDef {
      sd-name = s.sd-name,
      sd-reference = "R",
      sd-value = "R",
      sd-pins = s.sd-pins,
      sd-graphics = s.sd-graphics,
      sd-pin-count = s.sd-pin-count,
      sd-unit-count = 1,
      sd-body-style-count = 1,
      sd-show-pin-names = 0,
      sd-show-pin-numbers = 0,
      sd-pin-name-offset = 0,
      sd-power-symbol = 0,
      sd-description = "Resistor",
      sd-keywords = ["R", "resistor"],
      sd-datasheet = ""
    }
    in let s2 = symbol-add-pin s1 (sym-pin "1" "~" 0 (-1270000) 635000 1)
    in let s3 = symbol-add-pin s2 (sym-pin "2" "~" 0 1270000 635000 3)
    in let s4 = symbol-add-graphic s3 (BgRect (-254000) (-635000) 254000 635000 50000)
    in s4

  symbol-capacitor : SymbolDef
  symbol-capacitor =
    let s = empty-symbol "C"
    in let s1 = SymbolDef {
      sd-name = s.sd-name,
      sd-reference = "C",
      sd-value = "C",
      sd-pins = s.sd-pins,
      sd-graphics = s.sd-graphics,
      sd-pin-count = s.sd-pin-count,
      sd-unit-count = 1,
      sd-body-style-count = 1,
      sd-show-pin-names = 0,
      sd-show-pin-numbers = 0,
      sd-pin-name-offset = 0,
      sd-power-symbol = 0,
      sd-description = "Capacitor",
      sd-keywords = ["C", "capacitor"],
      sd-datasheet = ""
    }
    in let s2 = symbol-add-pin s1 (sym-pin "1" "~" 0 (-1270000) 508000 1)
    in let s3 = symbol-add-pin s2 (sym-pin "2" "~" 0 1270000 508000 3)
    in let s4 = symbol-add-graphic s3 (BgLine (-381000) (-127000) 381000 (-127000) 50000)
    in let s5 = symbol-add-graphic s4 (BgLine (-381000) 127000 381000 127000 50000)
    in s5
