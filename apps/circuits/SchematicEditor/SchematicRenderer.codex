Chapter: SchematicRenderer
  cites Foreword chapter List

Section: View Transform

  SchematicView = record {
    sv-pan-x : Integer,
    sv-pan-y : Integer,
    sv-zoom-num : Integer,
    sv-zoom-den : Integer,
    sv-screen-w : Integer,
    sv-screen-h : Integer
  }

  default-schematic-view : Integer, Integer -> SchematicView
  default-schematic-view (w) (h) = SchematicView {
    sv-pan-x = 0,
    sv-pan-y = 0,
    sv-zoom-num = 1,
    sv-zoom-den = 100000,
    sv-screen-w = w,
    sv-screen-h = h
  }

  view-to-screen-x : SchematicView, Integer -> Integer
  view-to-screen-x (v) (wx) =
    (wx - v.sv-pan-x) * v.sv-zoom-num / v.sv-zoom-den + v.sv-screen-w / 2

  view-to-screen-y : SchematicView, Integer -> Integer
  view-to-screen-y (v) (wy) =
    (wy - v.sv-pan-y) * v.sv-zoom-num / v.sv-zoom-den + v.sv-screen-h / 2

  screen-to-world-x : SchematicView, Integer -> Integer
  screen-to-world-x (v) (sx) =
    (sx - v.sv-screen-w / 2) * v.sv-zoom-den / v.sv-zoom-num + v.sv-pan-x

  screen-to-world-y : SchematicView, Integer -> Integer
  screen-to-world-y (v) (sy) =
    (sy - v.sv-screen-h / 2) * v.sv-zoom-den / v.sv-zoom-num + v.sv-pan-y

  view-zoom-in : SchematicView -> SchematicView
  view-zoom-in (v) = SchematicView {
    sv-pan-x = v.sv-pan-x,
    sv-pan-y = v.sv-pan-y,
    sv-zoom-num = v.sv-zoom-num * 12 / 10,
    sv-zoom-den = v.sv-zoom-den,
    sv-screen-w = v.sv-screen-w,
    sv-screen-h = v.sv-screen-h
  }

  view-zoom-out : SchematicView -> SchematicView
  view-zoom-out (v) = SchematicView {
    sv-pan-x = v.sv-pan-x,
    sv-pan-y = v.sv-pan-y,
    sv-zoom-num = v.sv-zoom-num * 10 / 12,
    sv-zoom-den = v.sv-zoom-den,
    sv-screen-w = v.sv-screen-w,
    sv-screen-h = v.sv-screen-h
  }

  view-pan : SchematicView, Integer, Integer -> SchematicView
  view-pan (v) (dx) (dy) = SchematicView {
    sv-pan-x = v.sv-pan-x + dx * v.sv-zoom-den / v.sv-zoom-num,
    sv-pan-y = v.sv-pan-y + dy * v.sv-zoom-den / v.sv-zoom-num,
    sv-zoom-num = v.sv-zoom-num,
    sv-zoom-den = v.sv-zoom-den,
    sv-screen-w = v.sv-screen-w,
    sv-screen-h = v.sv-screen-h
  }

Section: Grid

  GridStyle =
    | GridDots
    | GridLines
    | GridCrosses
    | GridNone

  SchematicGrid = record {
    sg-spacing : Integer,
    sg-style : GridStyle,
    sg-color : Integer,
    sg-visible : Integer
  }

  default-grid : SchematicGrid
  default-grid = SchematicGrid {
    sg-spacing = 1270000,
    sg-style = GridDots,
    sg-color = #333333,
    sg-visible = 1
  }

  snap-to-grid : Integer, Integer -> Integer
  snap-to-grid (coord) (grid-size) =
    if grid-size <= 0 then coord
    else let half = grid-size / 2
    in if coord >= 0 then (coord + half) / grid-size * grid-size
    else (coord - half) / grid-size * grid-size

