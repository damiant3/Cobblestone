    sc-erc-error = #FF0000,
    sc-erc-warning = #CC8800
  }

Section: Render State

  SchematicRenderState = record {
    srs-view : SchematicView,
    srs-grid : SchematicGrid,
    srs-colors : SchematicColors,
    srs-show-pin-names : Integer,
    srs-show-pin-numbers : Integer,
    srs-show-ref-des : Integer,
    srs-show-values : Integer,
    srs-show-grid : Integer,
    srs-show-ratsnest : Integer,
    srs-highlight-net : Integer
  }

  default-render-state : Integer, Integer -> SchematicRenderState
  default-render-state (w) (h) = SchematicRenderState {
    srs-view = default-schematic-view w h,
    srs-grid = default-grid,
    srs-colors = dark-schematic-colors,
    srs-show-pin-names = 1,
    srs-show-pin-numbers = 1,
    srs-show-ref-des = 1,
    srs-show-values = 1,
    srs-show-grid = 1,
    srs-show-ratsnest = 0,
    srs-highlight-net = -1
  }

Section: Wire Rendering Helpers

  HopOver = record {
    ho-x : Integer,
    ho-y : Integer,
    ho-radius : Integer,
    ho-wire-index : Integer
  }

  wire-is-horizontal : Integer, Integer, Integer, Integer -> Integer
  wire-is-horizontal (x1) (y1) (x2) (y2) = if y1 == y2 then 1 else 0

  wire-is-vertical : Integer, Integer, Integer, Integer -> Integer
  wire-is-vertical (x1) (y1) (x2) (y2) = if x1 == x2 then 1 else 0

Section: Symbol Rendering Helpers

  SymbolTransform = record {
    st-origin-x : Integer,
    st-origin-y : Integer,
    st-rotation : Integer,
    st-mirror : Integer
  }

  transform-point : SymbolTransform, Integer, Integer -> Integer
  transform-point (xf) (lx) (ly) =
    if xf.st-rotation == 0 then
      if xf.st-mirror == 0 then xf.st-origin-x + lx
      else xf.st-origin-x - lx
    else if xf.st-rotation == 90 then
      if xf.st-mirror == 0 then xf.st-origin-x - ly
      else xf.st-origin-x + ly
    else if xf.st-rotation == 180 then
      if xf.st-mirror == 0 then xf.st-origin-x - lx
      else xf.st-origin-x + lx
    else
      if xf.st-mirror == 0 then xf.st-origin-x + ly
      else xf.st-origin-x - ly

  transform-point-y : SymbolTransform, Integer, Integer -> Integer
  transform-point-y (xf) (lx) (ly) =
    if xf.st-rotation == 0 then xf.st-origin-y + ly
    else if xf.st-rotation == 90 then xf.st-origin-y + lx
    else if xf.st-rotation == 180 then xf.st-origin-y - ly
    else xf.st-origin-y - lx
