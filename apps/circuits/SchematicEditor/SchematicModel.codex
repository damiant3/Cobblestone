Chapter: SchematicModel
  cites Foreword chapter List
  cites Foreword chapter Maybe

 We say:

Section: Wire and Junction

  WireSegment = record {
    ws-x1 : Integer,
    ws-y1 : Integer,
    ws-x2 : Integer,
    ws-y2 : Integer,
    ws-net-name : Text
  }

  Junction = record {
    jn-x : Integer,
    jn-y : Integer
  }

Section: Bus Entry

  BusEntry = record {
    be-x : Integer,
    be-y : Integer,
    be-bus-name : Text,
    be-net-name : Text
  }

Section: No Connect

  NoConnect = record {
    nc-x : Integer,
    nc-y : Integer
  }

Section: Power Symbol

  PowerSymbolType =
    | VccSymbol
    | GndSymbol
    | PowerFlag
    | CustomPower (Text)

  PowerSymbol = record {
    ps-x : Integer,
    ps-y : Integer,
    ps-net-name : Text,
    ps-symbol-type : PowerSymbolType
  }

Section: Labels

  NetLabel = record {
    nl-x : Integer,
    nl-y : Integer,
    nl-text : Text,
    nl-rotation : Integer
  }

  LabelShape =
    | LabelInput
    | LabelOutput
    | LabelBidir
    | LabelTriState
    | LabelPassive

  GlobalLabel = record {
    gl-x : Integer,
    gl-y : Integer,
    gl-text : Text,
    gl-shape : LabelShape
  }

  HierarchicalLabel = record {
    hl-x : Integer,
    hl-y : Integer,
    hl-text : Text,
    hl-shape : LabelShape
  }

Section: Schematic Symbol

  SchematicSymbol = record {
    ss-ref : Text,
    ss-component-name : Text,
    ss-x : Integer,
    ss-y : Integer,
    ss-rotation : Integer,
    ss-mirror : Integer,
    ss-unit : Integer,
    ss-variant-overrides : Text
  }

Section: Sheet

  SubSheetRef = record {
    sr-id : Text,
    sr-name : Text,
    sr-file : Text,
    sr-x : Integer,
    sr-y : Integer,
    sr-width : Integer,
    sr-height : Integer
  }

  Sheet = record {
    sh-sheet-id : Text,
    sh-sheet-name : Text,
    sh-symbols : List SchematicSymbol,
    sh-wires : List WireSegment,
    sh-junctions : List Junction,
    sh-labels : List NetLabel,
    sh-global-labels : List GlobalLabel,
    sh-hierarchical-labels : List HierarchicalLabel,
    sh-power-symbols : List PowerSymbol,
    sh-no-connects : List NoConnect,
    sh-bus-entries : List BusEntry,
    sh-sub-sheets : List SubSheetRef
  }

Section: Sheet Construction

  empty-sheet : Text, Text -> Sheet
  empty-sheet (id) (name) = Sheet {
    sh-sheet-id = id,
    sh-sheet-name = name,
    sh-symbols = [],
    sh-wires = [],
    sh-junctions = [],
    sh-labels = [],
    sh-global-labels = [],
    sh-hierarchical-labels = [],
    sh-power-symbols = [],
    sh-no-connects = [],
    sh-bus-entries = [],
    sh-sub-sheets = []
  }

  sheet-add-symbol : Sheet, SchematicSymbol -> Sheet
  sheet-add-symbol (sh) (sym) = Sheet {
    sh-sheet-id = sh.sh-sheet-id,
    sh-sheet-name = sh.sh-sheet-name,
    sh-symbols = list-push sh.sh-symbols sym,
    sh-wires = sh.sh-wires,
    sh-junctions = sh.sh-junctions,
    sh-labels = sh.sh-labels,
    sh-global-labels = sh.sh-global-labels,
    sh-hierarchical-labels = sh.sh-hierarchical-labels,
    sh-power-symbols = sh.sh-power-symbols,
    sh-no-connects = sh.sh-no-connects,
    sh-bus-entries = sh.sh-bus-entries,
    sh-sub-sheets = sh.sh-sub-sheets
  }

  sheet-add-wire : Sheet, WireSegment -> Sheet
  sheet-add-wire (sh) (w) = Sheet {
    sh-sheet-id = sh.sh-sheet-id,
    sh-sheet-name = sh.sh-sheet-name,
    sh-symbols = sh.sh-symbols,
    sh-wires = list-push sh.sh-wires w,
    sh-junctions = sh.sh-junctions,
    sh-labels = sh.sh-labels,
    sh-global-labels = sh.sh-global-labels,
    sh-hierarchical-labels = sh.sh-hierarchical-labels,
    sh-power-symbols = sh.sh-power-symbols,
    sh-no-connects = sh.sh-no-connects,
    sh-bus-entries = sh.sh-bus-entries,
    sh-sub-sheets = sh.sh-sub-sheets
  }

Section: Sheet Queries

  sheet-symbol-count : Sheet -> Integer
  sheet-symbol-count (sh) = list-length sh.sh-symbols

  sheet-wire-count : Sheet -> Integer
  sheet-wire-count (sh) = list-length sh.sh-wires
