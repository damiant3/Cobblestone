Chapter: SchematicPersist
  cites Foreword chapter List

Section: Fact Kind

  fact-kind-schematic : Integer
  fact-kind-schematic = 30

  fact-kind-pcb : Integer
  fact-kind-pcb = 31

  fact-kind-component-lib : Integer
  fact-kind-component-lib = 32

  fact-kind-project : Integer
  fact-kind-project = 33

  fact-kind-simulation : Integer
  fact-kind-simulation = 34

  fact-kind-manufacturing : Integer
  fact-kind-manufacturing = 35

  fact-kind-variant : Integer
  fact-kind-variant = 36

Section: Save Metadata

  SaveMetadata = record {
    sm-author : Text,
    sm-timestamp : Text,
    sm-tool-version : Text,
    sm-fact-kind : Integer,
    sm-content-hash : Text,
    sm-parent-hash : Text,
    sm-description : Text
  }

  save-metadata : Text, Text, Integer -> SaveMetadata
  save-metadata (author) (timestamp) (kind) = SaveMetadata {
    sm-author = author,
    sm-timestamp = timestamp,
    sm-tool-version = "Codex Circuits 0.1.0",
    sm-fact-kind = kind,
    sm-content-hash = "",
    sm-parent-hash = "",
    sm-description = ""
  }

Section: Auto-Save

  AutoSaveConfig = record {
    asc-enabled : Integer,
    asc-interval-seconds : Integer,
    asc-max-backups : Integer,
    asc-backup-dir : Text
  }

  default-auto-save : AutoSaveConfig
  default-auto-save = AutoSaveConfig {
    asc-enabled = 1,
    asc-interval-seconds = 300,
    asc-max-backups = 10,
    asc-backup-dir = "backups/"
  }

Section: Recent Files

  RecentFile = record {
    rf-name : Text,
    rf-path : Text,
    rf-last-opened : Text,
    rf-project-type : Text
  }

  RecentFileList = record {
    rfl-files : List RecentFile,
    rfl-max-count : Integer
  }

  empty-recent-files : RecentFileList
  empty-recent-files = RecentFileList {
    rfl-files = [],
    rfl-max-count = 20
  }

  recent-add : RecentFileList, RecentFile -> RecentFileList
  recent-add (rl) (f) = RecentFileList {
    rfl-files = list-push rl.rfl-files f,
    rfl-max-count = rl.rfl-max-count
  }
