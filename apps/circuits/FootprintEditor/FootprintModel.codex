      fpd-graphics = fp2.fpd-graphics,
      fpd-courtyard-x1 = (-1480000),
      fpd-courtyard-y1 = (-650000),
      fpd-courtyard-x2 = 1480000,
      fpd-courtyard-y2 = 650000,
      fpd-origin-x = 0,
