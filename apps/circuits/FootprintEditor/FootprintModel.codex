  fp-soic-8 : FpDef
  fp-soic-8 =
    let fp = empty-footprint-def "SOIC-8_3.9x4.9mm_P1.27mm"
    in let fp1 = fp-add-pad fp (fp-pad-smd "1" (-2700000) (-1905000) 1550000 600000)
    in let fp2 = fp-add-pad fp1 (fp-pad-smd "2" (-2700000) (-635000) 1550000 600000)
    in let fp3 = fp-add-pad fp2 (fp-pad-smd "3" (-2700000) 635000 1550000 600000)
    in let fp4 = fp-add-pad fp3 (fp-pad-smd "4" (-2700000) 1905000 1550000 600000)
    in let fp5 = fp-add-pad fp4 (fp-pad-smd "5" 2700000 1905000 1550000 600000)
    in let fp6 = fp-add-pad fp5 (fp-pad-smd "6" 2700000 635000 1550000 600000)
    in let fp7 = fp-add-pad fp6 (fp-pad-smd "7" 2700000 (-635000) 1550000 600000)
    in let fp8 = fp-add-pad fp7 (fp-pad-smd "8" 2700000 (-1905000) 1550000 600000)
    in FpDef {
      fpd-name = fp8.fpd-name,
      fpd-description = "SOIC-8 3.9x4.9mm 1.27mm pitch",
      fpd-pads = fp8.fpd-pads,
      fpd-graphics = fp8.fpd-graphics,
      fpd-courtyard-x1 = (-3750000),
      fpd-courtyard-y1 = (-2750000),
      fpd-courtyard-x2 = 3750000,
      fpd-courtyard-y2 = 2750000,
      fpd-origin-x = 0,
      fpd-origin-y = 0,
      fpd-model-3d = "SOIC-8.step",
      fpd-model-offset-x = 0,
      fpd-model-offset-y = 0,
      fpd-model-offset-z = 0,
      fpd-model-scale = 1000,
      fpd-tags = ["soic", "8-pin", "1.27mm"]
    }
