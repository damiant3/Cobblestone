      fpd-graphics = fp2.fpd-graphics,
      fpd-courtyard-x1 = (-1060000),
      fpd-courtyard-y1 = (-560000),
      fpd-courtyard-x2 = 1060000,
      fpd-courtyard-y2 = 560000,
