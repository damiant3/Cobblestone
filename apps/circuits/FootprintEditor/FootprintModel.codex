Chapter: FootprintModel
  cites Foreword chapter List

Section: Pad Geometry

  FpPadShape =
    | FpShapeRect
    | FpShapeCircle
    | FpShapeOval
    | FpShapeRoundRect (Integer)
    | FpShapeTrapezoid (Integer)

  FpPadType =
    | FpPadSmd
    | FpPadThruHole
    | FpPadNpth
    | FpPadConnector

  FpPad = record {
    fpp-number : Text,
    fpp-x : Integer,
    fpp-y : Integer,
    fpp-width : Integer,
    fpp-height : Integer,
    fpp-shape : FpPadShape,
    fpp-type : FpPadType,
    fpp-drill : Integer,
    fpp-drill-shape : Integer,
    fpp-rotation : Integer,
    fpp-paste-margin : Integer,
    fpp-mask-margin : Integer,
    fpp-thermal-gap : Integer,
    fpp-thermal-width : Integer
  }

  fp-pad-smd : Text, Integer, Integer, Integer, Integer -> FpPad
  fp-pad-smd (num) (x) (y) (w) (h) = FpPad {
    fpp-number = num,
    fpp-x = x,
    fpp-y = y,
    fpp-width = w,
    fpp-height = h,
    fpp-shape = FpShapeRect,
    fpp-type = FpPadSmd,
    fpp-drill = 0,
    fpp-drill-shape = 0,
    fpp-rotation = 0,
    fpp-paste-margin = 0,
    fpp-mask-margin = 0,
    fpp-thermal-gap = 0,
    fpp-thermal-width = 0
  }

  fp-pad-thru : Text, Integer, Integer, Integer, Integer -> FpPad
  fp-pad-thru (num) (x) (y) (diameter) (drill) = FpPad {
    fpp-number = num,
    fpp-x = x,
    fpp-y = y,
    fpp-width = diameter,
    fpp-height = diameter,
    fpp-shape = FpShapeCircle,
    fpp-type = FpPadThruHole,
    fpp-drill = drill,
    fpp-drill-shape = 0,
    fpp-rotation = 0,
    fpp-paste-margin = 0,
    fpp-mask-margin = 0,
    fpp-thermal-gap = 200000,
    fpp-thermal-width = 250000
  }

Section: Graphic Elements

  FpGraphicType =
    | FpGfxLine (Integer) (Integer) (Integer) (Integer) (Integer)
    | FpGfxRect (Integer) (Integer) (Integer) (Integer) (Integer)
    | FpGfxCircle (Integer) (Integer) (Integer) (Integer)
    | FpGfxArc (Integer) (Integer) (Integer) (Integer) (Integer) (Integer)
    | FpGfxPoly (List Integer) (Integer)
    | FpGfxText (Text) (Integer) (Integer) (Integer) (Integer)

  FpGraphicLayer =
    | FpLayerFab
    | FpLayerSilk
    | FpLayerCourtyard
    | FpLayerPaste
    | FpLayerMask
    | FpLayerCopper

  FpGraphic = record {
    fg-graphic : FpGraphicType,
    fg-layer : FpGraphicLayer,
    fg-side : Integer
  }

Section: Footprint Definition

  FpDef = record {
    fpd-name : Text,
    fpd-description : Text,
    fpd-pads : List FpPad,
    fpd-graphics : List FpGraphic,
    fpd-courtyard-x1 : Integer,
    fpd-courtyard-y1 : Integer,
    fpd-courtyard-x2 : Integer,
    fpd-courtyard-y2 : Integer,
    fpd-origin-x : Integer,
    fpd-origin-y : Integer,
    fpd-model-3d : Text,
    fpd-model-offset-x : Integer,
    fpd-model-offset-y : Integer,
    fpd-model-offset-z : Integer,
    fpd-model-scale : Integer,
    fpd-tags : List Text
  }

  empty-footprint-def : Text -> FpDef
  empty-footprint-def (name) = FpDef {
    fpd-name = name,
    fpd-description = "",
    fpd-pads = [],
    fpd-graphics = [],
    fpd-courtyard-x1 = 0,
    fpd-courtyard-y1 = 0,
    fpd-courtyard-x2 = 0,
    fpd-courtyard-y2 = 0,
    fpd-origin-x = 0,
    fpd-origin-y = 0,
    fpd-model-3d = "",
    fpd-model-offset-x = 0,
    fpd-model-offset-y = 0,
    fpd-model-offset-z = 0,
    fpd-model-scale = 1000,
    fpd-tags = []
  }

  fp-add-pad : FpDef, FpPad -> FpDef
  fp-add-pad (fp) (pad) = FpDef {
    fpd-name = fp.fpd-name,
    fpd-description = fp.fpd-description,
    fpd-pads = list-push fp.fpd-pads pad,
    fpd-graphics = fp.fpd-graphics,
    fpd-courtyard-x1 = fp.fpd-courtyard-x1,
    fpd-courtyard-y1 = fp.fpd-courtyard-y1,
    fpd-courtyard-x2 = fp.fpd-courtyard-x2,
    fpd-courtyard-y2 = fp.fpd-courtyard-y2,
    fpd-origin-x = fp.fpd-origin-x,
    fpd-origin-y = fp.fpd-origin-y,
    fpd-model-3d = fp.fpd-model-3d,
    fpd-model-offset-x = fp.fpd-model-offset-x,
    fpd-model-offset-y = fp.fpd-model-offset-y,
    fpd-model-offset-z = fp.fpd-model-offset-z,
    fpd-model-scale = fp.fpd-model-scale,
    fpd-tags = fp.fpd-tags
  }

  fp-pad-count : FpDef -> Integer
  fp-pad-count (fp) = list-length fp.fpd-pads

Section: Common Packages

 IPC-7351 compliant footprint generators for standard packages.

  fp-resistor-0402 : FpDef
  fp-resistor-0402 =
    let fp = empty-footprint-def "R_0402_1005Metric"
    in let fp1 = fp-add-pad fp (fp-pad-smd "1" (-480000) 0 560000 620000)
    in let fp2 = fp-add-pad fp1 (fp-pad-smd "2" 480000 0 560000 620000)
    in FpDef {
      fpd-name = fp2.fpd-name,
      fpd-description = "Resistor SMD 0402 (1005 Metric)",
      fpd-pads = fp2.fpd-pads,
      fpd-graphics = fp2.fpd-graphics,
      fpd-courtyard-x1 = (-1060000),
      fpd-courtyard-y1 = (-560000),
      fpd-courtyard-x2 = 1060000,
      fpd-courtyard-y2 = 560000,
      fpd-origin-x = 0,
      fpd-origin-y = 0,
      fpd-model-3d = "R_0402.step",
      fpd-model-offset-x = 0,
      fpd-model-offset-y = 0,
      fpd-model-offset-z = 0,
      fpd-model-scale = 1000,
      fpd-tags = ["resistor", "0402", "1005"]
    }

