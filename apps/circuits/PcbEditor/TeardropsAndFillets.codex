Chapter: TeardropsAndFillets
  cites Foreword chapter List

 Teardrop and fillet generation for PCB tracks at pad and via
 junctions. Teardrops improve solder joint reliability and reduce
 etch-breakout risk at transitions from narrow traces to wider pads.

Section: Teardrop Style

  TeardropStyle =
    | TeardropCurved
    | TeardropStraight
    | TeardropNone

  TeardropConfig = record {
    tc-style : TeardropStyle,
    tc-length-ratio : Integer,
    tc-width-ratio : Integer,
    tc-max-length : Integer,
    tc-apply-to-pads : Integer,
    tc-apply-to-vias : Integer,
    tc-apply-to-track-ends : Integer
  }

  default-teardrop-config : TeardropConfig
  default-teardrop-config = TeardropConfig {
    tc-style = TeardropCurved,
    tc-length-ratio = 500,
    tc-width-ratio = 1000,
    tc-max-length = 2000000,
    tc-apply-to-pads = 1,
    tc-apply-to-vias = 1,
    tc-apply-to-track-ends = 0
  }

Section: Teardrop Geometry

  TeardropShape = record {
    ts-pad-x : Integer,
    ts-pad-y : Integer,
    ts-pad-diameter : Integer,
    ts-track-width : Integer,
    ts-track-angle : Integer,
    ts-length : Integer,
    ts-left-x : Integer,
    ts-left-y : Integer,
    ts-right-x : Integer,
    ts-right-y : Integer,
    ts-tip-x : Integer,
    ts-tip-y : Integer,
    ts-layer : Integer,
    ts-net : Integer
  }

  compute-teardrop-length : Integer, Integer, Integer -> Integer
  compute-teardrop-length (pad-diameter) (ratio) (max-length) =
    let len = pad-diameter * ratio / 1000
    in if len > max-length then max-length else len

Section: Fillet

 Track-to-track fillets smooth the transition at corners to reduce
 current crowding and improve impedance continuity.

  FilletConfig = record {
    fc-radius : Integer,
    fc-segments : Integer,
    fc-apply-to-corners : Integer,
    fc-min-angle : Integer
  }

  default-fillet-config : FilletConfig
  default-fillet-config = FilletConfig {
    fc-radius = 250000,
    fc-segments = 8,
    fc-apply-to-corners = 1,
    fc-min-angle = 15
  }

  FilletArc = record {
    fa-center-x : Integer,
    fa-center-y : Integer,
    fa-radius : Integer,
    fa-start-angle : Integer,
    fa-end-angle : Integer,
    fa-width : Integer,
    fa-layer : Integer,
    fa-net : Integer
  }

Section: Application Summary

  TeardropSummary = record {
    tds-pad-teardrops : Integer,
    tds-via-teardrops : Integer,
    tds-fillets : Integer,
    tds-total : Integer
  }

  teardrop-summary-text : TeardropSummary -> Text
  teardrop-summary-text (s) =
    let a = "Teardrops: " & (show s.tds-pad-teardrops) & " pads, " & (show s.tds-via-teardrops) & " vias, "
    in a & (show s.tds-fillets) & " fillets (" & (show s.tds-total) & " total)"
