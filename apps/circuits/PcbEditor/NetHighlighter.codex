Chapter: NetHighlighter
  cites Foreword chapter List

 Net highlighting and inspection for the PCB editor. When a net is
 highlighted, all tracks, vias, and pads belonging to that net are
 drawn in the highlight color while everything else is dimmed.

Section: Highlight Mode

  HighlightMode =
    | HighlightSingle (Integer)
    | HighlightMultiple (List Integer)
    | HighlightDiffPair (Integer) (Integer)
    | HighlightNetClass (Text)
    | HighlightNone

Section: Net Inspector

 Collects statistics about a net: total routed length, via count,
 pad count, layer usage, and clearance violations.

  NetInspection = record {
    ni-net-id : Integer,
    ni-net-name : Text,
    ni-net-class : Text,
    ni-total-length : Integer,
    ni-via-count : Integer,
    ni-pad-count : Integer,
    ni-track-count : Integer,
    ni-layers-used : List Integer,
    ni-layer-count : Integer,
    ni-shortest-segment : Integer,
    ni-longest-segment : Integer,
    ni-clearance-ok : Integer
  }

  empty-net-inspection : Integer, Text -> NetInspection
  empty-net-inspection (net-id) (name) = NetInspection {
    ni-net-id = net-id,
    ni-net-name = name,
    ni-net-class = "Default",
    ni-total-length = 0,
    ni-via-count = 0,
    ni-pad-count = 0,
    ni-track-count = 0,
    ni-layers-used = [],
    ni-layer-count = 0,
    ni-shortest-segment = 999999999,
    ni-longest-segment = 0,
    ni-clearance-ok = 1
  }

  ni-add-track : NetInspection, Integer -> NetInspection
  ni-add-track (ni) (length) = NetInspection {
    ni-net-id = ni.ni-net-id,
    ni-net-name = ni.ni-net-name,
    ni-net-class = ni.ni-net-class,
    ni-total-length = ni.ni-total-length + length,
    ni-via-count = ni.ni-via-count,
    ni-pad-count = ni.ni-pad-count,
    ni-track-count = ni.ni-track-count + 1,
    ni-layers-used = ni.ni-layers-used,
    ni-layer-count = ni.ni-layer-count,
    ni-shortest-segment = if length < ni.ni-shortest-segment then length else ni.ni-shortest-segment,
    ni-longest-segment = if length > ni.ni-longest-segment then length else ni.ni-longest-segment,
    ni-clearance-ok = ni.ni-clearance-ok
  }

  ni-add-via : NetInspection -> NetInspection
  ni-add-via (ni) = NetInspection {
    ni-net-id = ni.ni-net-id,
    ni-net-name = ni.ni-net-name,
    ni-net-class = ni.ni-net-class,
    ni-total-length = ni.ni-total-length,
    ni-via-count = ni.ni-via-count + 1,
    ni-pad-count = ni.ni-pad-count,
    ni-track-count = ni.ni-track-count,
    ni-layers-used = ni.ni-layers-used,
    ni-layer-count = ni.ni-layer-count,
    ni-shortest-segment = ni.ni-shortest-segment,
    ni-longest-segment = ni.ni-longest-segment,
    ni-clearance-ok = ni.ni-clearance-ok
  }

  ni-add-pad : NetInspection -> NetInspection
  ni-add-pad (ni) = NetInspection {
    ni-net-id = ni.ni-net-id,
    ni-net-name = ni.ni-net-name,
    ni-net-class = ni.ni-net-class,
    ni-total-length = ni.ni-total-length,
    ni-via-count = ni.ni-via-count,
    ni-pad-count = ni.ni-pad-count + 1,
    ni-track-count = ni.ni-track-count,
    ni-layers-used = ni.ni-layers-used,
    ni-layer-count = ni.ni-layer-count,
    ni-shortest-segment = ni.ni-shortest-segment,
    ni-longest-segment = ni.ni-longest-segment,
    ni-clearance-ok = ni.ni-clearance-ok
  }

  ni-summary : NetInspection -> Text
  ni-summary (ni) =
    let a = "Net " & ni.ni-net-name & " (" & ni.ni-net-class & "): "
    in let b = show ni.ni-track-count & " tracks, " & (show ni.ni-via-count) & " vias, "
    in a & b & (show ni.ni-pad-count) & " pads, " & show (ni.ni-total-length / 1000000) & " mm total"

Section: Ratsnest Visibility

  RatsnestFilter =
    | ShowAllRatsnest
    | ShowSelectedNetRatsnest (Integer)
    | ShowUnroutedOnly
    | HideRatsnest

  ratsnest-filter-name : RatsnestFilter -> Text
  ratsnest-filter-name (f) = when f
    is ShowAllRatsnest -> "All"
    is ShowSelectedNetRatsnest (id) -> "Net " & (show id)
    is ShowUnroutedOnly -> "Unrouted Only"
    is HideRatsnest -> "Hidden"
