Chapter: DifferentialPairs
  cites Foreword chapter List

 Differential pair routing for high-speed signal integrity. Manages
 paired nets (P/N), enforces coupling gap, calculates differential
 impedance from stack-up parameters, and provides length matching
 with skew constraints.

Section: Differential Pair Definition

  DiffPair = record {
    dp-name : Text,
    dp-net-p : Integer,
    dp-net-n : Integer,
    dp-gap : Integer,
    dp-width : Integer,
    dp-impedance-target : Integer,
    dp-max-skew : Integer,
    dp-max-length : Integer,
    dp-layer : Integer
  }

  diff-pair : Text, Integer, Integer, Integer, Integer -> DiffPair
  diff-pair (name) (net-p) (net-n) (gap) (width) = DiffPair {
    dp-name = name,
    dp-net-p = net-p,
    dp-net-n = net-n,
    dp-gap = gap,
    dp-width = width,
    dp-impedance-target = 90000,
    dp-max-skew = 5000,
    dp-max-length = 0,
    dp-layer = 0
  }

Section: Differential Impedance

 Edge-coupled microstrip differential impedance approximation.
 All dimensions in nanometers, dielectric constant scaled by 1000.
 Returns impedance in milliohms.

  diff-microstrip-impedance : Integer, Integer, Integer, Integer, Integer -> Integer
  diff-microstrip-impedance (width) (gap) (height) (thickness) (er-x1000) =
    let z0-single = 87000 * height / (er-x1000 + 1414) * 1000 / (width + thickness)
    in let coupling = 1000 - 48000 * height / (gap + height) / 1000
    in let z-diff = z0-single * 2 * coupling / 1000
    in z-diff

Section: Pair Segment

  DiffPairSegment = record {
    dps-p-x1 : Integer,
    dps-p-y1 : Integer,
    dps-p-x2 : Integer,
    dps-p-y2 : Integer,
    dps-n-x1 : Integer,
    dps-n-y1 : Integer,
    dps-n-x2 : Integer,
    dps-n-y2 : Integer,
    dps-width : Integer,
    dps-gap : Integer,
    dps-layer : Integer
  }

Section: Length Measurement

  DiffPairLengths = record {
    dpl-name : Text,
    dpl-length-p : Integer,
    dpl-length-n : Integer,
    dpl-skew : Integer,
    dpl-within-tolerance : Integer
  }

  measure-diff-pair-lengths : Text, Integer, Integer, Integer -> DiffPairLengths
  measure-diff-pair-lengths (name) (len-p) (len-n) (max-skew) =
    let skew = if len-p > len-n then len-p - len-n else len-n - len-p
    in DiffPairLengths {
      dpl-name = name,
      dpl-length-p = len-p,
      dpl-length-n = len-n,
      dpl-skew = skew,
      dpl-within-tolerance = if skew <= max-skew then 1 else 0
    }

Section: Common Differential Pair Definitions

  usb-2-diff-pair : Integer, Integer -> DiffPair
  usb-2-diff-pair (net-dp) (net-dm) = DiffPair {
    dp-name = "USB",
    dp-net-p = net-dp,
    dp-net-n = net-dm,
    dp-gap = 150000,
    dp-width = 300000,
    dp-impedance-target = 90000,
    dp-max-skew = 50000,
    dp-max-length = 75000000,
    dp-layer = 0
  }

  hdmi-diff-pair : Text, Integer, Integer -> DiffPair
  hdmi-diff-pair (name) (net-p) (net-n) = DiffPair {
    dp-name = name,
    dp-net-p = net-p,
    dp-net-n = net-n,
    dp-gap = 127000,
    dp-width = 200000,
    dp-impedance-target = 100000,
    dp-max-skew = 25000,
    dp-max-length = 150000000,
    dp-layer = 0
  }

