Chapter: TestGlobe
  cites Globe chapter GlobeTypes
  cites Globe chapter GlobeScene
  cites Globe chapter GlobeData

 Tests for the globe app.

Section: Harness

  assert-eq : Text, Text, Text -> Text
  assert-eq (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected \"" & expected & "\" got \"" & actual & "\""

  assert-int : Text, Integer, Integer -> Text
  assert-int (label) (expected) (actual) =
    if expected == actual then "PASS " & label
    else "FAIL " & label & ": expected " & show expected & " got " & show actual

  assert-true : Text, Boolean -> Text
  assert-true (label) (val) = if val then "PASS " & label else "FAIL " & label

Section: Overlay Types

  test-overlays : Text
  test-overlays =
    let t1 = assert-eq "aircraft-label" "Aircraft" (ov-label OvAircraft)
    in let t2 = assert-eq "quake-label" "Earthquakes" (ov-label OvEarthquakes)
    in let t3 = assert-eq "wind-label" "Wind" (ov-label OvWind)
    in t1 & "\n" & t2 & "\n" & t3

Section: Camera

  test-camera : Text
  test-camera =
    let cam = globe-camera-new
    in let t1 = assert-int "init-dist" 25000 (cam.gcam-dist)
    in let cam2 = gcam-orbit cam 5000 10000
    in let t2 = assert-int "orbit-lat" 35000 (cam2.gcam-lat)
    in let cam3 = gcam-zoom cam (-20000)
    in let t3 = assert-int "zoom-min" 6500 (cam3.gcam-dist)
    in t1 & "\n" & t2 & "\n" & t3

Section: Globe State

  test-state : Text
  test-state =
    let gs = globe-state-new
    in let t1 = assert-int "overlay-count" 7 (gs.gs-overlay-count)
    in let t2 = assert-true "auto-rotate" (gs.gs-auto-rotate)
    in let gs2 = globe-toggle-overlay gs 0
    in let ov = list-at (gs2.gs-overlays) 0
    in let t3 = assert-true "aircraft-on" (ov.os-enabled)
    in t1 & "\n" & t2 & "\n" & t3

Section: Colors

  test-colors : Text
  test-colors =
    let t1 = assert-true "cold-blue" (temp-to-rgb (-20000) < 16711680)
    in let t2 = assert-true "hot-red" (temp-to-rgb 40000 > 10000000)
    in let t3 = assert-int "small-quake" 2 (quake-mag-to-size 1000)
    in let t4 = assert-int "big-quake" 20 (quake-mag-to-size 8000)
    in t1 & "\n" & t2 & "\n" & t3 & "\n" & t4

Section: Cities

  test-cities : Text
  test-cities =
    let cities = major-cities
    in let t1 = assert-int "city-count" 36 (list-length cities)
    in let tokyo = list-at cities 0
    in let t2 = assert-eq "tokyo" "Tokyo" (tokyo.cp-name)
    in t1 & "\n" & t2

