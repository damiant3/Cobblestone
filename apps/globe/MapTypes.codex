Chapter: MapTypes
  cites Globe chapter GlobeTypes
  cites Foreword chapter Maybe

 Types for the map/GIS mode. Road network graph, points of
 interest, route segments, turn-by-turn directions, elevation
 data, and map tile addressing.

Section: Road Network

  RoadClass =
    | RcMotorway
    | RcTrunk
    | RcPrimary
    | RcSecondary
    | RcTertiary
    | RcResidential
    | RcService
    | RcTrack
    | RcFootway
    | RcCycleway

  rc-label : RoadClass -> Text
  rc-label (r) = when r
    is RcMotorway -> "Motorway"
    is RcTrunk -> "Trunk"
    is RcPrimary -> "Primary"
    is RcSecondary -> "Secondary"
    is RcTertiary -> "Tertiary"
    is RcResidential -> "Residential"
    is RcService -> "Service"
    is RcTrack -> "Track"
    is RcFootway -> "Footway"
    is RcCycleway -> "Cycleway"

  rc-speed-limit : RoadClass -> Integer
  rc-speed-limit (r) = when r
    is RcMotorway -> 120
    is RcTrunk -> 100
    is RcPrimary -> 80
    is RcSecondary -> 60
    is RcTertiary -> 50
    is RcResidential -> 30
    is RcService -> 20
    is RcTrack -> 15
    is RcFootway -> 5
    is RcCycleway -> 20

  rc-color : RoadClass -> Integer
  rc-color (r) = when r
    is RcMotorway -> #E892A2
    is RcTrunk -> #F9B29C
    is RcPrimary -> #FCD6A4
    is RcSecondary -> #F7FABF
    is RcTertiary -> #FFFFFF
    is RcResidential -> #FFFFFF
    is RcService -> #CCCCCC
    is RcTrack -> #BBA47C
    is RcFootway -> #FA8072
    is RcCycleway -> #0000FF

  rc-width : RoadClass -> Integer
  rc-width (r) = when r
    is RcMotorway -> 6
    is RcTrunk -> 5
    is RcPrimary -> 4
    is RcSecondary -> 3
    is RcTertiary -> 2
    is RcResidential -> 2
    is RcService -> 1
    is RcTrack -> 1
    is RcFootway -> 1
    is RcCycleway -> 1

  rc-is-drivable : RoadClass -> Boolean
  rc-is-drivable (r) = when r
    is RcFootway -> False
    is RcCycleway -> False
    is otherwise -> True

  RoadNode = record {
    rn-id : Integer,
    rn-lat : Integer,
    rn-lon : Integer,
    rn-elevation : Integer,
    rn-edge-count : Integer
  }

  RoadEdge = record {
    re-id : Integer,
    re-from : Integer,
    re-to : Integer,
    re-road-class : RoadClass,
    re-name : Text,
    re-length-m : Integer,
    re-speed-limit : Integer,
    re-oneway : Boolean,
    re-toll : Boolean,
    re-bridge : Boolean,
    re-tunnel : Boolean,
    re-surface : RoadSurface
  }

  RoadSurface =
    | RsPaved
    | RsAsphalt
    | RsConcrete
    | RsGravel
    | RsDirt
    | RsUnknown

  rs-label : RoadSurface -> Text
  rs-label (s) = when s
    is RsPaved -> "Paved"
    is RsAsphalt -> "Asphalt"
    is RsConcrete -> "Concrete"
    is RsGravel -> "Gravel"
    is RsDirt -> "Dirt"
    is RsUnknown -> "Unknown"

Section: Route

  TravelMode =
    | TmDriving
    | TmWalking
    | TmCycling
    | TmTransit

  tm-label : TravelMode -> Text
  tm-label (m) = when m
    is TmDriving -> "Driving"
    is TmWalking -> "Walking"
    is TmCycling -> "Cycling"
    is TmTransit -> "Transit"

  tm-speed-factor : TravelMode -> Integer
  tm-speed-factor (m) = when m
    is TmDriving -> 100
    is TmWalking -> 5
    is TmCycling -> 20
    is TmTransit -> 60

  RouteStep = record {
    rst-instruction : Text,
    rst-maneuver : Maneuver,
    rst-distance-m : Integer,
    rst-duration-sec : Integer,
    rst-road-name : Text,
    rst-road-class : RoadClass,
    rst-start-lat : Integer,
    rst-start-lon : Integer,
    rst-end-lat : Integer,
    rst-end-lon : Integer,
    rst-heading : Integer
  }

  Maneuver =
    | MnContinue
    | MnTurnLeft
    | MnTurnRight
    | MnSlightLeft
    | MnSlightRight
    | MnSharpLeft
    | MnSharpRight
    | MnUturn
    | MnMerge
    | MnForkLeft
    | MnForkRight
    | MnRoundabout (Integer)
    | MnExitRoundabout
    | MnRampOn
    | MnRampOff
    | MnArrive
    | MnDepart

  mn-label : Maneuver -> Text
  mn-label (m) = when m
    is MnContinue -> "Continue"
    is MnTurnLeft -> "Turn left"
    is MnTurnRight -> "Turn right"
    is MnSlightLeft -> "Slight left"
    is MnSlightRight -> "Slight right"
    is MnSharpLeft -> "Sharp left"
    is MnSharpRight -> "Sharp right"
    is MnUturn -> "U-turn"
    is MnMerge -> "Merge"
    is MnForkLeft -> "Fork left"
    is MnForkRight -> "Fork right"
    is MnRoundabout (exit) -> "Roundabout exit " & show exit
    is MnExitRoundabout -> "Exit roundabout"
    is MnRampOn -> "Take ramp"
    is MnRampOff -> "Exit ramp"
    is MnArrive -> "Arrive"
    is MnDepart -> "Depart"

  mn-icon : Maneuver -> Text
  mn-icon (m) = when m
    is MnContinue -> "|"
    is MnTurnLeft -> "<"
    is MnTurnRight -> ">"
    is MnSlightLeft -> "\\"
    is MnSlightRight -> "/"
    is MnSharpLeft -> "<<"
    is MnSharpRight -> ">>"
    is MnUturn -> "U"
    is MnMerge -> "Y"
    is MnForkLeft -> "y<"
    is MnForkRight -> "y>"
    is MnRoundabout (exit) -> "O"
    is MnExitRoundabout -> "o>"
    is MnRampOn -> "/^"
    is MnRampOff -> "v\\"
    is MnArrive -> "[A]"
    is MnDepart -> "[D]"

  Route = record {
    rt-id : Integer,
    rt-name : Text,
    rt-mode : TravelMode,
    rt-steps : List RouteStep,
    rt-step-count : Integer,
    rt-total-distance-m : Integer,
    rt-total-duration-sec : Integer,
    rt-waypoints : List GeoCoord,
    rt-waypoint-count : Integer,
    rt-elevation-gain : Integer,
    rt-elevation-loss : Integer,
    rt-toll-roads : Boolean,
    rt-avoid-highways : Boolean
  }

Section: Points of Interest

  PoiCategory =
    | PoiGas
    | PoiFood
    | PoiLodging
    | PoiParking
    | PoiHospital
    | PoiPharmacy
    | PoiSchool
    | PoiBank
    | PoiAtm
    | PoiShopping
    | PoiGrocery
    | PoiPost
    | PoiPolice
    | PoiFire
    | PoiChurch
    | PoiPark
    | PoiMuseum
    | PoiAirport
    | PoiTrainStation
    | PoiBusStop
    | PoiEVCharger
    | PoiRestArea
    | PoiViewpoint

  poi-label : PoiCategory -> Text
  poi-label (c) = when c
    is PoiGas -> "Gas Station"
    is PoiFood -> "Restaurant"
    is PoiLodging -> "Lodging"
    is PoiParking -> "Parking"
    is PoiHospital -> "Hospital"
    is PoiPharmacy -> "Pharmacy"
    is PoiSchool -> "School"
    is PoiBank -> "Bank"
    is PoiAtm -> "ATM"
    is PoiShopping -> "Shopping"
    is PoiGrocery -> "Grocery"
    is PoiPost -> "Post Office"
    is PoiPolice -> "Police"
    is PoiFire -> "Fire Station"
    is PoiChurch -> "Church"
    is PoiPark -> "Park"
    is PoiMuseum -> "Museum"
    is PoiAirport -> "Airport"
    is PoiTrainStation -> "Train Station"
    is PoiBusStop -> "Bus Stop"
    is PoiEVCharger -> "EV Charger"
    is PoiRestArea -> "Rest Area"
    is PoiViewpoint -> "Viewpoint"

  poi-icon : PoiCategory -> Text
  poi-icon (c) = when c
    is PoiGas -> "G"
    is PoiFood -> "F"
    is PoiLodging -> "H"
    is PoiParking -> "P"
    is PoiHospital -> "+"
    is PoiPharmacy -> "Rx"
    is PoiSchool -> "S"
    is PoiBank -> "$"
    is PoiAtm -> "$"
    is PoiShopping -> "M"
    is PoiGrocery -> "G"
    is PoiPost -> "E"
    is PoiPolice -> "!"
    is PoiFire -> "!"
    is PoiChurch -> "T"
    is PoiPark -> "W"
    is PoiMuseum -> "M"
    is PoiAirport -> "A"
    is PoiTrainStation -> "T"
    is PoiBusStop -> "B"
    is PoiEVCharger -> "E"
    is PoiRestArea -> "R"
    is PoiViewpoint -> "V"

  PointOfInterest = record {
    poi-id : Integer,
    poi-name : Text,
    poi-category : PoiCategory,
    poi-lat : Integer,
    poi-lon : Integer,
    poi-address : Text,
    poi-phone : Text,
    poi-rating : Integer,
    poi-open-now : Boolean
  }

Section: Map Tile

  MapTile = record {
    mt-x : Integer,
    mt-y : Integer,
    mt-zoom : Integer,
    mt-loaded : Boolean
  }

  tile-from-coord : Integer, Integer, Integer -> MapTile
  tile-from-coord (lat) (lon) (zoom) =
    let n = bit-shl 1 zoom
    in let x = (lon + 180000) * n / 360000
    in let y = n / 2
    in MapTile { mt-x = x, mt-y = y, mt-zoom = zoom, mt-loaded = False }

Section: Elevation

  ElevationPoint = record {
    ep-lat : Integer,
    ep-lon : Integer,
    ep-elevation-m : Integer
  }

  ElevationProfile = record {
    epr-points : List ElevationPoint,
    epr-count : Integer,
    epr-min : Integer,
    epr-max : Integer,
    epr-gain : Integer,
    epr-loss : Integer
  }

Section: Geocode Result

  GeocodeResult = record {
    gcr-name : Text,
    gcr-display : Text,
    gcr-lat : Integer,
    gcr-lon : Integer,
    gcr-type : Text,
    gcr-confidence : Integer
  }

Section: Traffic

  TrafficLevel =
    | TlFreeFlow
    | TlLight
    | TlModerate
    | TlHeavy
    | TlStandstill

  tl-color : TrafficLevel -> Integer
  tl-color (t) = when t
    is TlFreeFlow -> #3fb950
    is TlLight -> #8BC34A
    is TlModerate -> #ffd700
    is TlHeavy -> #f0883e
    is TlStandstill -> #f85149

  tl-speed-factor : TrafficLevel -> Integer
  tl-speed-factor (t) = when t
    is TlFreeFlow -> 100
    is TlLight -> 85
    is TlModerate -> 60
    is TlHeavy -> 30
    is TlStandstill -> 5

  TrafficSegment = record {
    ts-edge-id : Integer,
    ts-level : TrafficLevel,
    ts-speed-kmh : Integer,
    ts-delay-sec : Integer,
    ts-updated : Integer
  }

Section: Bookmark

  MapBookmark = record {
    mb-id : Integer,
    mb-name : Text,
    mb-lat : Integer,
    mb-lon : Integer,
    mb-zoom : Integer,
    mb-category : Text,
    mb-notes : Text,
    mb-created : Integer
  }

Section: Route Options

  RouteOptions = record {
    ro-mode : TravelMode,
    ro-avoid-tolls : Boolean,
    ro-avoid-highways : Boolean,
    ro-avoid-ferries : Boolean,
    ro-prefer-scenic : Boolean,
    ro-max-walking-km : Integer,
    ro-departure-time : Integer,
    ro-arrival-time : Integer
  }

  ro-default : RouteOptions
  ro-default = RouteOptions {
    ro-mode = TmDriving,
    ro-avoid-tolls = False,
    ro-avoid-highways = False,
    ro-avoid-ferries = False,
    ro-prefer-scenic = False,
    ro-max-walking-km = 2,
    ro-departure-time = 0,
    ro-arrival-time = 0
  }
