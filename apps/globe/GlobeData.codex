Chapter: GlobeData
  cites Globe chapter GlobeTypes

 Data sources:
   Aircraft:    OpenSky Network (opensky-network.org) - CC BY-NC-SA
   Earthquakes: USGS (earthquake.usgs.gov) - public domain (US govt)
   Weather:     Open-Meteo (open-meteo.com) - CC BY 4.0
   ISS:         Open Notify (open-notify.org) - free, no auth
   Volcanoes:   Smithsonian GVP (volcano.si.edu) - public domain

Section: Feed URLs

  feed-aircraft-url : Text
  feed-aircraft-url = "https://opensky-network.org/api/states/all"

  feed-earthquakes-url : Text
  feed-earthquakes-url = "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson"

  feed-iss-url : Text
  feed-iss-url = "http://api.open-notify.org/iss-now.json"

  feed-weather-url : Integer, Integer -> Text
  feed-weather-url (lat) (lon) =
    "https://api.open-meteo.com/v1/forecast?latitude=" & show (lat / 1000)
    & "&longitude=" & show (lon / 1000)
    & "&current=temperature_2m,wind_speed_10m,wind_direction_10m,relative_humidity_2m,surface_pressure"

  feed-wildfires-url : Text
  feed-wildfires-url = "https://eonet.gsfc.nasa.gov/api/v3/events?category=wildfires&status=open&limit=200"

  feed-storms-url : Text
  feed-storms-url = "https://eonet.gsfc.nasa.gov/api/v3/events?category=severeStorms&status=open&limit=100"

  feed-volcanoes-url : Text
  feed-volcanoes-url = "https://eonet.gsfc.nasa.gov/api/v3/events?category=volcanoes&status=open&limit=50"

  feed-fireballs-url : Text
  feed-fireballs-url = "https://ssd-api.jpl.nasa.gov/fireball.api?limit=100"

  feed-solar-flares-url : Text
  feed-solar-flares-url = "https://api.nasa.gov/DONKI/FLR?startDate=2026-06-01&api_key=DEMO_KEY"

  feed-ocean-buoys-url : Text
  feed-ocean-buoys-url = "https://www.ndbc.noaa.gov/data/latest_obs/latest_obs.txt"

  feed-radar-index-url : Text
  feed-radar-index-url = "https://api.rainviewer.com/public/weather-maps.json"

Section: Major Cities (for weather grid)

  CityPoint = record {
    cp-name : Text,
    cp-lat : Integer,
    cp-lon : Integer,
    cp-pop : Integer
  }

