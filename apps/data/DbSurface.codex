Chapter: DbSurface
  cites Data chapter Dashboard
  cites Data chapter StarSchema
  cites Data chapter Backup
  cites Data chapter GraphStore
  cites Data chapter Mvcc
  cites Data chapter Proxy
  cites Data chapter SortMerge
  cites Data chapter SpatialIndex
  cites Data chapter SysIntegration
  cites Data chapter TwoPhaseCommit

 This entry chapter exists so the app sweep, which reaches chapters through an
 `opening`'s cites, compiles the seventeen chapters no other entry reaches.
 Each line calls one definition of one cited chapter, so no cite is unused; the
 answers are not the subject, the compile is.

Section: Display

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni "=== Codex DB surface ==="
    print-line-uni ("dashboard-css    : " & show (text-length dash-css))
    print-line-uni ("star-role        : " & table-role-name RoleFact)
    print-line-uni ("backup-chain     : " & yn (validate-backup-chain []))
    print-line-uni ("graph-node       : " & show ((gnode 1 "person").gn-id))
    print-line-uni ("mvcc-versions    : " & show (vs-new.vs-count))
    print-line-uni ("proxy-available  : " & yn (be-is-available (backend-new 1 "127.0.0.1" 5432)))
    print-line-uni ("sort-merge-rows  : " & show ((sort-merge-join [] [] "id" "id").sm-count))
    print-line-uni ("spatial-dist-sq  : " & show (point-dist-sq (Point2D { px = 0, py = 0 }) (Point2D { px = 3, py = 4 })))
    print-line-uni ("sys-stats        : " & show (text-length (isys-stats isys-new)))
    print-line-uni ("tpc-participant  : " & show ((participant-new 1 "node-1").pt-id))
  end

