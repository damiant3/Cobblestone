 We say:

Section: Schema

  employees-table : TableDef
  employees-table = table-def-with-pk "employees" [
    col-def-not-null "id" ColInteger,
    col-def-not-null "name" ColText,
    col-def-not-null "department" ColText,
    col-def "salary" ColInteger,
    col-def "hire-year" ColInteger
  ] ["id"]

  departments-table : TableDef
  departments-table = table-def-with-pk "departments" [
    col-def-not-null "name" ColText,
    col-def-not-null "budget" ColInteger,
    col-def "head" ColText
  ] ["name"]

Section: Seed Data

  seed-employees : Catalog -> Catalog
  seed-employees (cat) =
    let s = table-schema employees-table
    in let rows = [
      row-new s [ValInteger 1,  ValText "Alice",   ValText "Engineering", ValInteger 125000, ValInteger 2022],
      row-new s [ValInteger 2,  ValText "Bob",     ValText "Engineering", ValInteger 118000, ValInteger 2023],
      row-new s [ValInteger 3,  ValText "Carol",   ValText "Sales",       ValInteger 95000,  ValInteger 2021],
      row-new s [ValInteger 4,  ValText "Dave",    ValText "Sales",       ValInteger 88000,  ValInteger 2024],
      row-new s [ValInteger 5,  ValText "Eve",     ValText "Research",    ValInteger 135000, ValInteger 2020],
      row-new s [ValInteger 6,  ValText "Frank",   ValText "Research",    ValInteger 110000, ValInteger 2023],
      row-new s [ValInteger 7,  ValText "Grace",   ValText "Engineering", ValInteger 142000, ValInteger 2019],
      row-new s [ValInteger 8,  ValText "Heidi",   ValText "Sales",       ValInteger 78000,  ValInteger 2025],
      row-new s [ValInteger 9,  ValText "Ivan",    ValText "Research",    ValInteger 98000,  ValInteger 2024],
      row-new s [ValInteger 10, ValText "Judy",    ValText "Engineering", ValInteger 131000, ValInteger 2021]
    ]
    in seed-insert-rows cat "employees" rows 0 (list-length rows)

  seed-insert-rows : Catalog, Text, List RowData, Integer, Integer -> Catalog
  seed-insert-rows (cat) (table) (rows) (i) (len) =
    if i >= len then cat
    else let r = catalog-insert-row cat table (list-at rows i)
    in seed-insert-rows (r.cir-cat) table rows (i + 1) len

Section: Queries

  all-by-salary : Catalog -> QueryResult
  all-by-salary (cat) =
    let scan = RelScan "employees"
    in let sorted = RelSort scan [SortSpec { sort-col = "salary", sort-dir = SortDesc }]
    in query cat sorted

  engineering-roster : Catalog -> QueryResult
  engineering-roster (cat) =
    let scan = RelScan "employees"
    in let filtered = RelFilter scan (PredColCmp "department" CmpEq (ValText "Engineering"))
    in let projected = RelProject filtered (proj-columns ["name", "salary"])
    in let sorted = RelSort projected [SortSpec { sort-col = "salary", sort-dir = SortDesc }]
    in query cat sorted

  top-earners : Catalog -> QueryResult
  top-earners (cat) =
    let scan = RelScan "employees"
    in let sorted = RelSort scan [SortSpec { sort-col = "salary", sort-dir = SortDesc }]
    in let limited = RelLimit sorted 3
    in let projected = RelProject limited (proj-columns ["name", "department", "salary"])
    in query cat projected

  department-summary : Catalog -> QueryResult
  department-summary (cat) =
    let scan = RelScan "employees"
    in let grouped = RelGroup scan ["department"] [
        AggSpec { agg-func = AggCount, agg-alias = "headcount" },
        AggSpec { agg-func = AggSum "salary", agg-alias = "total-salary" },
        AggSpec { agg-func = AggAvg "salary", agg-alias = "avg-salary" }
      ]
    in let sorted = RelSort grouped [SortSpec { sort-col = "total-salary", sort-dir = SortDesc }]
    in query cat sorted

  recent-hires : Catalog -> QueryResult
  recent-hires (cat) =
    let scan = RelScan "employees"
    in let filtered = RelFilter scan (PredColCmp "hire-year" CmpGe (ValInteger 2024))
    in let projected = RelProject filtered (proj-columns ["name", "department", "hire-year"])
    in let sorted = RelSort projected [SortSpec { sort-col = "hire-year", sort-dir = SortAsc }]
    in query cat sorted

  research-stars : Catalog -> QueryResult
  research-stars (cat) =
    let scan = RelScan "employees"
    in let filtered = RelFilter scan (PredAnd
        (PredColCmp "department" CmpEq (ValText "Research"))
        (PredColCmp "salary" CmpGt (ValInteger 100000)))
    in let projected = RelProject filtered (proj-columns ["name", "salary"])
    in query cat projected

Section: Display

  format-result : Text, QueryResult -> Text
  format-result (label) (qr) =
    if qr.qr-ok == False then label & ": ERROR " & qr.qr-msg
    else label & " (" & show (qr.qr-count) & " rows):\n" & format-rows (qr.qr-rows) 0 (qr.qr-count) ""

  format-rows : List RowData, Integer, Integer, Text -> Text
  format-rows (rows) (i) (len) (acc) =
    if i >= len then acc
    else let row = list-at rows i
    in let line = "  " & format-row-vals (row.values) 0 (list-length (row.values)) ""
    in format-rows rows (i + 1) len (acc & line & "\n")

  format-row-vals : List ColumnValue, Integer, Integer, Text -> Text
  format-row-vals (vals) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vals i
    in let sep = if i > 0 then " | " else ""
    in let t = when v
      is ValInteger (n) -> show n
      is ValText (t) -> t
      is ValBoolean (b) -> if b then "True" else "False"
      is ValNull -> "NULL"
    in format-row-vals vals (i + 1) len (acc & sep & t)

Section: Body

  opening : [Console] Nothing = act
    let cat0 = catalog-new
    in let cr1 = catalog-create-table cat0 employees-table
    in let cat = seed-employees (cr1.cat)
    in act
      print-line-uni "=== Codex DB Example ==="
      print-line-uni ""
      print-line-uni (format-result "All by Salary" (all-by-salary cat))
      print-line-uni (format-result "Engineering Roster" (engineering-roster cat))
      print-line-uni (format-result "Top 3 Earners" (top-earners cat))
      print-line-uni (format-result "Department Summary" (department-summary cat))
      print-line-uni (format-result "Recent Hires" (recent-hires cat))
      print-line-uni (format-result "Research Stars" (research-stars cat))
    end
  end

