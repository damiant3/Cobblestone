 We say:

Section: Schema

  employees-table : TableDef
  employees-table = table-def-with-pk "employees" [
    col-def-not-null "id" ColInteger,
    col-def-not-null "name" ColText,
    col-def-not-null "department" ColText,
    col-def "salary" ColInteger,
    col-def "hire-year" ColInteger
  ] ["id"]

Section: Seed Data

  seed-employees : Catalog -> Catalog
  seed-employees (cat) =
    let s = table-schema employees-table
    in let rows = [
      row-new s [ValInteger 1,  ValText "Alice",   ValText "Engineering", ValInteger 125000, ValInteger 2022],
      row-new s [ValInteger 2,  ValText "Bob",     ValText "Engineering", ValInteger 118000, ValInteger 2023],
      row-new s [ValInteger 3,  ValText "Carol",   ValText "Sales",       ValInteger 95000,  ValInteger 2021],
      row-new s [ValInteger 4,  ValText "Dave",    ValText "Sales",       ValInteger 88000,  ValInteger 2024],
      row-new s [ValInteger 5,  ValText "Eve",     ValText "Research",    ValInteger 135000, ValInteger 2020],
      row-new s [ValInteger 6,  ValText "Frank",   ValText "Research",    ValInteger 110000, ValInteger 2023],
      row-new s [ValInteger 7,  ValText "Grace",   ValText "Engineering", ValInteger 142000, ValInteger 2019],
      row-new s [ValInteger 8,  ValText "Heidi",   ValText "Sales",       ValInteger 78000,  ValInteger 2025],
      row-new s [ValInteger 9,  ValText "Ivan",    ValText "Research",    ValInteger 98000,  ValInteger 2024],
      row-new s [ValInteger 10, ValText "Judy",    ValText "Engineering", ValInteger 131000, ValInteger 2021]
    ]
    in seed-insert-rows cat "employees" rows 0 (list-length rows)

  seed-insert-rows : Catalog, Text, List RowData, Integer, Integer -> Catalog
  seed-insert-rows (cat) (table) (rows) (i) (len) =
    if i >= len then cat
    else let r = catalog-insert-row cat table (list-at rows i)
    in seed-insert-rows (r.cir-cat) table rows (i + 1) len

