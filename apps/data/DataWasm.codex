 The browser interface for the database, on the same WASI shape the notebook
 uses: a query arrives on `fd_read`, the result table leaves on `fd_write`,
 both plain UTF-8, and `_start` runs once so the page instantiates per query.
 Each query therefore gets a freshly seeded catalog and a clean heap, which is
 what a module with no collector wants anyway.

 There is no SQL text parser. A query is either the NAME of a plan or one
 filter, `<column> <op> <value>`.

Section: The Table

  dw-catalog : Integer -> Catalog
  dw-catalog (dummy) =
    let cr = catalog-create-table catalog-new employees-table
    in seed-employees (cr.cat)

Section: The Plans

  dw-all : RelOp
  dw-all = RelSort (RelScan "employees") [SortSpec { sort-col = "salary", sort-dir = SortDesc }]

  dw-engineering : RelOp
  dw-engineering =
    let scan = RelScan "employees"
    in let filtered = RelFilter scan (PredColCmp "department" CmpEq (ValText "Engineering"))
    in let projected = RelProject filtered (proj-columns ["name", "salary"])
    in RelSort projected [SortSpec { sort-col = "salary", sort-dir = SortDesc }]

  dw-top : RelOp
  dw-top =
    let scan = RelScan "employees"
    in let sorted = RelSort scan [SortSpec { sort-col = "salary", sort-dir = SortDesc }]
    in let limited = RelLimit sorted 3
    in RelProject limited (proj-columns ["name", "department", "salary"])

  dw-departments : RelOp
  dw-departments =
    let scan = RelScan "employees"
    in let aggs = [
      AggSpec { agg-func = AggCount, agg-alias = "headcount" },
      AggSpec { agg-func = AggSum "salary", agg-alias = "total-salary" },
      AggSpec { agg-func = AggAvg "salary", agg-alias = "avg-salary" }
    ]
    in RelGroup scan ["department"] aggs

  dw-recent : RelOp
  dw-recent =
    let scan = RelScan "employees"
    in let filtered = RelFilter scan (PredColCmp "hire-year" CmpGe (ValInteger 2024))
    in RelSort filtered [SortSpec { sort-col = "hire-year", sort-dir = SortDesc }]

Section: Selecting a Plan

 An unknown name lists what there is rather than answering another query.

  dw-plan-for : Text -> Maybe RelOp
  dw-plan-for (name) =
    if name == "all" then Just dw-all
    else if name == "engineering" then Just dw-engineering
    else if name == "top" then Just dw-top
    else if name == "departments" then Just dw-departments
    else if name == "recent" then Just dw-recent
    else None

  dw-names : Text
  dw-names = "all, engineering, top, departments, recent"

Section: A Written Filter

  DwAsk = record { da-ok : Boolean, da-plan : RelOp, da-algebra : Text, da-why : Text }

  dw-refuse : Text -> DwAsk
  dw-refuse (why) = DwAsk { da-ok = False, da-plan = dw-all, da-algebra = "", da-why = why }

  dw-op-for : Text -> Maybe CmpOp
  dw-op-for (t) =
    if t == "=" then Just CmpEq
    else if t == "==" then Just CmpEq
    else if t == "!=" then Just CmpNe
    else if t == "<>" then Just CmpNe
    else if t == "<" then Just CmpLt
    else if t == ">" then Just CmpGt
    else if t == "<=" then Just CmpLe
    else if t == ">=" then Just CmpGe
    else None

  dw-op-text : CmpOp -> Text
  dw-op-text (op) =
    when op
      is CmpEq -> "="
      is CmpNe -> "!="
      is CmpLt -> "<"
      is CmpGt -> ">"
      is CmpLe -> "<="
      is CmpGe -> ">="

  dw-ops : Text
  dw-ops = "= != < > <= >="

  dw-digits : Text, Integer, Integer -> Boolean
  dw-digits (t) (i) (n) =
    if i >= n then True
    else if is-digit (char-at t i) then dw-digits t (i + 1) n
    else False

  dw-int-text : Text -> Boolean
  dw-int-text (t) =
    let n = text-length t
    in if n == 0 then False
    else if text-starts-with t "-" then (n > 1) & dw-digits t 1 n
    else dw-digits t 0 n

  dw-int-of : Text -> Integer
  dw-int-of (t) =
    if text-starts-with t "-" then 0 - text-to-integer (substring t 1 (text-length t - 1))
    else text-to-integer t

  dw-unquote : Text -> Text
  dw-unquote (t) =
    let n = text-length t
    in if n < 2 then t
    else if (text-starts-with t "\"") & (substring t (n - 1) 1 == "\"") then substring t 1 (n - 2)
    else t

  dw-col-index : List Text, Text, Integer, Integer -> Integer
  dw-col-index (names) (col) (i) (n) =
    if i >= n then -1
    else if list-at names i == col then i
    else dw-col-index names col (i + 1) n

  dw-join : List Text, Integer, Integer, Text -> Text
  dw-join (names) (i) (n) (acc) =
    if i >= n then acc
    else dw-join names (i + 1) n (acc & (if i > 0 then ", " else "") & list-at names i)

  dw-filter : Text, CmpOp, ColumnValue, Text -> DwAsk
  dw-filter (col) (op) (v) (shown) =
    DwAsk { da-ok = True,
      da-plan = RelFilter (RelScan "employees") (PredColCmp col op v),
      da-algebra = "RelFilter (RelScan \"employees\") (" & col & " " & dw-op-text op & " " & shown & ")",
      da-why = "" }

  dw-typed : Text, CmpOp, Text, ColumnType -> DwAsk
  dw-typed (col) (op) (val) (ty) =
    when ty
      is ColInteger ->
        if dw-int-text val then dw-filter col op (ValInteger (dw-int-of val)) (show (dw-int-of val))
        else dw-refuse (col & " holds integers and " & val & " is not one")
      is ColText -> dw-filter col op (ValText val) ("\"" & val & "\"")
      is ColBoolean ->
        if val == "true" then dw-filter col op (ValBoolean True) "true"
        else if val == "false" then dw-filter col op (ValBoolean False) "false"
        else dw-refuse (col & " holds true or false and " & val & " is neither")

  dw-ask-parts : Text, Text, Text -> DwAsk
  dw-ask-parts (col) (opt) (val) =
    let s = table-schema employees-table
    in let idx = dw-col-index (s.col-names) col 0 (s.col-count)
    in if idx < 0 then dw-refuse ("no column " & col & "; the columns are " & dw-join (s.col-names) 0 (s.col-count) "")
    else when dw-op-for opt
      is Just (op) -> dw-typed col op val (list-at (s.col-types) idx)
      is otherwise -> dw-refuse ("no operator " & opt & "; the operators are " & dw-ops)

  dw-after : Text, Integer -> Text
  dw-after (t) (i) = text-trim (substring t (i + 1) (text-length t - i - 1))

  dw-ask : Text -> DwAsk
  dw-ask (q) =
    let t = text-trim q
    in let i1 = text-index-of t " "
    in if i1 < 0 then dw-refuse "a filter is <column> <op> <value>"
    else let rest = dw-after t i1
    in let i2 = text-index-of rest " "
    in if i2 < 0 then dw-refuse "a filter is <column> <op> <value>"
    else dw-ask-parts (substring t 0 i1) (substring rest 0 i2) (dw-unquote (dw-after rest i2))

Section: Rendering

  dw-vals : List ColumnValue, Integer, Integer, Text -> Text
  dw-vals (vals) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vals i
    in let sep = if i > 0 then " | " else ""
    in let t = when v
      is ValInteger (n) -> show n
      is ValText (s) -> s
      is ValBoolean (b) -> if b then "True" else "False"
      is ValNull -> "NULL"
    in dw-vals vals (i + 1) len (acc & sep & t)

  dw-rows : List RowData, Integer, Integer, Text -> Text
  dw-rows (rows) (i) (len) (acc) =
    if i >= len then acc
    else let row = list-at rows i
    in let line = dw-vals (row.values) 0 (list-length (row.values)) ""
    in dw-rows rows (i + 1) len (acc & line & "\n")

  dw-render : QueryResult -> Text
  dw-render (qr) =
    if qr.qr-ok == False then "query error: " & qr.qr-msg
    else show (qr.qr-count) & " rows\n" & dw-rows (qr.qr-rows) 0 (qr.qr-count) ""

Section: One Query

  dw-run : Text -> Text
  dw-run (name) =
    when dw-plan-for name
      is Just (plan) -> dw-render (query (dw-catalog 0) plan)
      is otherwise -> dw-run-filter name

  dw-run-filter : Text -> Text
  dw-run-filter (q) =
    if text-index-of (text-trim q) " " < 0 then "no such query: " & q & "\nknown: " & dw-names & "\nor a filter: <column> <op> <value>"
    else let a = dw-ask q
    in if a.da-ok then "plan: " & a.da-algebra & "\n" & dw-render (query (dw-catalog 0) (a.da-plan))
    else "bad filter: " & a.da-why

Section: Entry Point

  wasm-exports : Text = ""

  opening : [Console] Nothing = act
    asked <- read-line
    when asked
      is Just (name) -> print-line-uni (dw-run name)
      is otherwise -> print-line-uni ("no such query: \nknown: " & dw-names)
    end
  end

