Chapter: ProfilePage
  cites UI chapter Widget
  cites UI chapter Layout
  cites MobileApp chapter MobileApp

 Profile and settings page. Shows account info, export function,
 and sign-out.

Section: State Keys

  sk-prof-msg : Text = "prof-msg"

Section: Page Tree

  profile-page-tree : Integer -> WidgetNode
  profile-page-tree (x) =
   let handle = state-get-text "cx_handle"
   in let display = state-get-text sk-home-display
   in let msg = state-get-text sk-prof-msg
   in widget-panel "prof-root" DirColumn 12 [
     widget-label "prof-title" (if text-length display > 0 then display else "Profile"),
     widget-label "prof-handle" ("@" & handle),
     widget-separator "sep-account",
     widget-label "acct-title" "Account",
     widget-button "export-btn" "Export My Creations",
     widget-separator "sep-app",
     widget-label "app-title" "App Info",
     widget-label "app-version" "CodexMagic Mobile v0.1",
     widget-label "app-engine" "Built with Codex MAUI plug",
     widget-label "app-server" ("Server: " & api-base),
     widget-separator "sep-signout",
     widget-button "logout-btn" "Sign Out",
     if text-length msg > 0 then widget-label "prof-msg" msg
     else widget-label "prof-msg-empty" ""
   ]

Section: Export

  profile-export : Integer -> Integer
  profile-export (x) =
   let tok = state-get-text "cx_token"
   in let url = api-base & "/api/export?t=" & url-encode tok
   in let s = set-msg sk-prof-msg "Exporting..."
   in fetch-get-then url (profile-export-cb)

  profile-export-cb : Text -> Integer
  profile-export-cb (resp) =
   if text-length resp > 0 then set-msg sk-prof-msg "Export ready (check server)"
   else set-msg sk-prof-msg "None to export"

Section: Handlers

  profile-on-click : Text -> Integer
  profile-on-click (id) =
   if id == "export-btn" then profile-export 0
   else if id == "logout-btn" then
     let tok = state-get-text "cx_token"
     in let url = api-base & "/api/auth/logout?t=" & url-encode tok
     in let s1 = local-storage-set "cx_tok" ""
     in let s2 = state-set-text "cx_token" ""
     in let f = fetch-get-then url (logout-cb)
     in navigate-to-login 0
   else 0

  logout-cb : Text -> Integer
  logout-cb (resp) = 0

  profile-on-pick : Text, Integer -> Integer
  profile-on-pick (group) (idx) = 0

