Chapter: ClanPage
  cites UI chapter Widget
  cites UI chapter Layout

 Placeholder for clan features. Clans require the CodexMagic
 game server which is not yet merged with the explorer server.
 Shows a preview of what clan features will offer.

Section: Page Tree

  clan-page-tree : Integer -> WidgetNode
  clan-page-tree (x) =
   widget-panel "clan-root" DirColumn 16 [
     widget-label "clan-title" "Clans",
     widget-separator "sep-top",
     widget-label "clan-desc" "Clans are communities of players who share a card library, run tournaments, and compete against other clans.",
     widget-separator "sep-features",
     widget-label "feat-title" "Coming Soon",
     widget-panel "feat-list" DirColumn 8 [
       widget-label "feat-1" "Browse and join public clans",
       widget-label "feat-2" "Create your own clan with custom rules",
       widget-label "feat-3" "Shared card library with checkout system",
       widget-label "feat-4" "Clan tournaments (Swiss, Elimination, League)",
       widget-label "feat-5" "Inter-clan challenges with stakes",
       widget-label "feat-6" "Clan economy with custom coin",
       widget-label "feat-7" "Age-bracket safety controls"
     ],
     widget-separator "sep-bottom",
     widget-label "clan-status" "Waiting for server merge..."
   ]

Section: Handlers

  clan-on-click : Text -> Integer
  clan-on-click (id) = 0

  clan-on-pick : Text, Integer -> Integer
  clan-on-pick (group) (idx) = 0

