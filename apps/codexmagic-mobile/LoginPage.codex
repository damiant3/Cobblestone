Chapter: LoginPage
  cites UI chapter Widget
  cites UI chapter Layout

 Login and registration page. Two modes toggled by a button.
 Posts credentials to the explorer server auth API.
 Input text syncs via widget ID state keys -- the MAUI runtime
 stores Entry text changes under the widget's wn-id.

Section: State Keys

  sk-auth-mode : Text = "auth-mode"
  sk-auth-msg : Text = "auth-msg"

Section: Page Tree

  login-page-tree : Integer -> WidgetNode
  login-page-tree (x) =
   let mode = state-get sk-auth-mode
   in let msg = state-get-text sk-auth-msg
   in let is-register = mode == 1
   in let title = if is-register then "Create Account" else "Sign In"
   in let toggle-label = if is-register then "Have an account? Sign In" else "New player? Create Account"
   in widget-panel "login-root" DirColumn 16 [
     widget-label "logo" "CodexMagic",
     widget-label "subtitle" "Collectible Card Game",
     widget-separator "sep0",
     widget-label "auth-title" title,
     widget-input "handle" "Handle" 0,
     if is-register then widget-input "display" "Display Name" 0
     else widget-label "spacer1" "",
     widget-input "pass" "Password" 0,
     if is-register then widget-input "pass2" "Confirm Password" 0
     else widget-label "spacer2" "",
     widget-button "auth-submit" (if is-register then "Register" else "Login"),
     widget-label "auth-msg" msg,
     widget-separator "sep1",
     widget-button "auth-toggle" toggle-label
   ]

Section: Handlers

  login-on-click : Text -> Integer
  login-on-click (id) =
   if id == "auth-toggle" then
     let mode = state-get sk-auth-mode
     in let new-mode = if mode == 0 then 1 else 0
     in let s1 = state-set sk-auth-mode new-mode
     in let s2 = state-set-text sk-auth-msg ""
     in let r = request-render 0
     in 0
   else if id == "auth-submit" then
     login-do-submit 0
   else 0

  login-do-submit : Integer -> Integer
  login-do-submit (x) =
   let mode = state-get sk-auth-mode
   in let handle = state-get-text "handle"
   in let pass = state-get-text "pass"
   in if text-length handle == 0 then set-msg sk-auth-msg "Handle is required"
   else if text-length pass == 0 then set-msg sk-auth-msg "Password is required"
   else if mode == 1 then login-do-register handle pass
   else login-do-login handle pass

  login-do-login : Text, Text -> Integer
  login-do-login (handle) (pass) =
   let s = set-msg sk-auth-msg "Signing in..."
   in let url = api-base & "/api/auth/login?u=" & url-encode handle & "&p=" & url-encode pass
   in fetch-then url "POST" "" (login-cb)

  login-do-register : Text, Text -> Integer
  login-do-register (handle) (pass) =
   let pass2 = state-get-text "pass2"
   in let display = state-get-text "display"
   in if pass /= pass2 then set-msg sk-auth-msg "Passwords do not match"
   else if text-length display == 0 then set-msg sk-auth-msg "Display name is required"
   else let s = set-msg sk-auth-msg "Creating account..."
   in let url = api-base & "/api/auth/register?u=" & url-encode handle & "&d=" & url-encode display & "&p=" & url-encode pass
   in fetch-then url "POST" "" (register-cb)

  login-cb : Text -> Integer
  login-cb (resp) =
   let obj = json-parse-obj resp
   in let tok = json-obj-field obj "token"
   in let err = json-obj-field obj "error"
   in if text-length err > 0 then set-msg sk-auth-msg err
   else if text-length tok > 0 then
     let s1 = local-storage-set "cx_tok" tok
     in let s2 = state-set-text "cx_token" tok
     in let s3 = state-set-text "cx_handle" (json-obj-field obj "handle")
     in navigate-to-home 0
   else set-msg sk-auth-msg "Login failed"

  register-cb : Text -> Integer
  register-cb (resp) =
   let obj = json-parse-obj resp
   in let err = json-obj-field obj "error"
   in if text-length err > 0 then set-msg sk-auth-msg err
   else let m = set-msg sk-auth-msg "Account created! Signing in..."
   in let handle = state-get-text "handle"
   in let pass = state-get-text "pass"
   in login-do-login handle pass

  login-on-pick : Text, Integer -> Integer
  login-on-pick (group) (idx) = 0

