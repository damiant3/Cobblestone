Section: Helpers

  bsn : BorderSide = BorderSide { brd-width = 0, brd-color = 0 }
  bn : Border = Border { bdr-top = bsn, bdr-right = bsn, bdr-bottom = bsn, bdr-left = bsn, bdr-corner = CornerSharp }
  ez : Edges = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  ws-sized : Integer, Integer, Border, Edges, Edges, Integer, Integer -> WidgetStyle
  ws-sized (bg) (fg) (b) (pad) (mar) (mw) (mh) = WidgetStyle { ws-bg = __narrow bg, ws-fg = __narrow fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = __narrow mw, ws-min-height = __narrow mh, ws-shadow = shadow-none, ws-gradient = gradient-none, ws-accent-border = accent-border-none, ws-bevel = bevel-none }

Section: Palette

  mobile-palette : Palette
  mobile-palette = Palette {
    pal-bg = #0A0A0A, pal-fg = #E8E8E8,
    pal-primary = #D4A017, pal-secondary = #3D2F1F,
    pal-accent = #FFD700, pal-muted = #666666,
    pal-error = #CC0000, pal-success = #33CC00,
    pal-warning = #FF9900, pal-border = #2A2A2A
  }

Section: Theme

  mobile-theme : Theme
  mobile-theme =
    let p = mobile-palette
    in let pad = exy 20 12
    in let mar = eu 4
    in let base = ws (p.pal-bg) (p.pal-fg) bn pad ez
    in let btn-n = ws-sized (p.pal-primary) #111111 (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let btn-h = ws-sized (p.pal-accent) #111111 (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let btn-d = ws-sized (p.pal-muted) (p.pal-muted) (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 6)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 6)) pad mar
    in let sep = ws-sized (p.pal-border) (p.pal-border) bn ez (exy 0 8) 0 2
    in let gauge = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-border) (CornerRound 4)) (eu 2) mar
    in Theme {
      th-name = "mobile-dark-gold",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = ss-flat gauge,
      th-separator = ss-flat sep
    }

Section: App Helpers

  set-msg : Text, Text -> Integer
  set-msg (key) (val) =
   let s = state-set-text key val
   in let r = request-render 0
   in 0

