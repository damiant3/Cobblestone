Chapter: MobileTheme
  cites UI chapter Theme
  cites UI chapter Widget

 Dark-gold theme for the CodexMagic mobile app. Adapted from
 the explorer's dark-gold with larger padding for touch targets.

Section: Helpers

  bsn : BorderSide = BorderSide { brd-width = 0, brd-color = 0 }
  bn : Border = Border { bdr-top = bsn, bdr-right = bsn, bdr-bottom = bsn, bdr-left = bsn, bdr-corner = CornerSharp }
  ez : Edges = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  bdr : Integer, Integer, CornerStyle -> Border
  bdr (w) (c) (corner) =
    let s = BorderSide { brd-width = w, brd-color = c }
    in Border { bdr-top = s, bdr-right = s, bdr-bottom = s, bdr-left = s, bdr-corner = corner }

  exy : Integer, Integer -> Edges
  exy (x) (y) = Edges { edge-top = y, edge-right = x, edge-bottom = y, edge-left = x }

  eu : Integer -> Edges
  eu (v) = Edges { edge-top = v, edge-right = v, edge-bottom = v, edge-left = v }

  ws : Integer, Integer, Border, Edges, Edges -> WidgetStyle
  ws (bg) (fg) (b) (pad) (mar) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0 }

  ws-sized : Integer, Integer, Border, Edges, Edges, Integer, Integer -> WidgetStyle
  ws-sized (bg) (fg) (b) (pad) (mar) (mw) (mh) = WidgetStyle { ws-bg = bg, ws-fg = fg, ws-border = b, ws-padding = pad, ws-margin = mar, ws-min-width = mw, ws-min-height = mh }

  ss-flat : WidgetStyle -> StateStyles
  ss-flat (s) = StateStyles { ss-normal = s, ss-hover = s, ss-pressed = s, ss-disabled = s, ss-focused = s }

Section: Palette

  mobile-palette : Palette
  mobile-palette = Palette {
    pal-bg = 657930, pal-fg = 15263976,
    pal-primary = 13934615, pal-secondary = 4009759,
    pal-accent = 16766720, pal-muted = 6710886,
    pal-error = 13369344, pal-success = 3394560,
    pal-warning = 16750848, pal-border = 2763306
  }

Section: Theme

  mobile-theme : Theme
  mobile-theme =
    let p = mobile-palette
    in let pad = exy 20 12
    in let mar = eu 4
    in let base = ws (p.pal-bg) (p.pal-fg) bn pad mar
    in let btn-n = ws-sized (p.pal-primary) 1118481 (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let btn-h = ws-sized (p.pal-accent) 1118481 (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let btn-d = ws-sized (p.pal-muted) (p.pal-muted) (bdr 0 0 (CornerRound 8)) (exy 24 14) mar 0 44
    in let lbl = ws 0 (p.pal-fg) bn ez mar
    in let inp-n = ws (p.pal-secondary) (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 6)) pad mar
    in let inp-f = ws (p.pal-secondary) (p.pal-fg) (bdr 2 (p.pal-accent) (CornerRound 6)) pad mar
    in let sep = ws-sized (p.pal-border) (p.pal-border) bn ez (exy 0 8) 0 2
    in let gauge = ws (p.pal-secondary) (p.pal-primary) (bdr 1 (p.pal-border) (CornerRound 4)) (eu 2) mar
    in Theme {
      th-name = "mobile-dark-gold",
      th-palette = p,
      th-panel = ss-flat base,
      th-button = StateStyles { ss-normal = btn-n, ss-hover = btn-h, ss-pressed = btn-n, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = ss-flat lbl,
      th-input = StateStyles { ss-normal = inp-n, ss-hover = inp-n, ss-pressed = inp-n, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = ss-flat gauge,
      th-separator = ss-flat sep
    }

Section: App Helpers

  set-msg : Text, Text -> Integer
  set-msg (key) (val) =
   let s = state-set-text key val
   in let r = request-render 0
   in 0

