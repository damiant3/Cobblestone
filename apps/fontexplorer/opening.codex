Section: Application State

  mutable ExplorerState = record {
    es-preview : PreviewState,
    es-glyph-net : NeuralNetwork,
    es-kern-net : NeuralNetwork,
    es-config : FontModelConfig,
    es-export-path : Text
  }

Section: Window Layout

  build-explorer-window : ExplorerState -> WidgetNode
  build-explorer-window (state) =
    let title = widget-label "title" "Codex Font Explorer"
    in let weight-slider = widget-slider "Weight" 100 900 state.es-preview.ps-weight
    in let italic-slider = widget-slider "Italic" 0 1000 state.es-preview.ps-italic
    in let temp-slider = widget-slider "Temperature" 0 1000 state.es-preview.ps-temperature
    in let text-input = widget-input "Preview text" state.es-preview.ps-sample-text 0
    in let export-btn = widget-button "Export TTF" "Export TTF"
    in let style-label = widget-label "style" (style-to-name state.es-preview.ps-weight state.es-preview.ps-italic)
    in let controls = widget-panel "controls" DirColumn 8 [
      title,
      weight-slider,
      italic-slider,
      temp-slider,
      style-label,
      text-input,
      export-btn
    ]
    in let preview-upper = widget-label "preview-upper" "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    in let preview-lower = widget-label "preview-lower" "abcdefghijklmnopqrstuvwxyz 0123456789"
    in let preview-sample = widget-label "preview-sample" state.es-preview.ps-sample-text
    in let preview-kern = widget-label "preview-kern" "AVA To Ty WA VA LT"
    in let preview = widget-panel "preview" DirColumn 12 [
      preview-upper,
      preview-lower,
      preview-sample,
      preview-kern
    ]
    in widget-panel "explorer" DirRow 16 [
      widget-set-min controls 280 0,
      preview
    ]

Section: Event Handling

  clamp-range : Integer, Integer, Integer -> Integer
  clamp-range (v) (lo) (hi) =
    if v < lo then lo else if v > hi then hi else v

  handle-explorer-event : ExplorerState, Event -> ExplorerState
  handle-explorer-event (state) (event) =
    when event.ev-kind
      is EvKeyDown (k) (mods) -> handle-explorer-key state (key-upper k)
      is otherwise -> state

  handle-explorer-key : ExplorerState, Integer -> ExplorerState
  handle-explorer-key (state) (k) =
    if k == key-up then
      let ps = preview-set-weight state.es-preview (clamp-range (state.es-preview.ps-weight + 50) 100 900)
      in state.es-preview = ps
    else if k == key-down then
      let ps = preview-set-weight state.es-preview (clamp-range (state.es-preview.ps-weight - 50) 100 900)
      in state.es-preview = ps
    else if k == key-right then
      let ps = preview-set-italic state.es-preview (clamp-range (state.es-preview.ps-italic + 100) 0 1000)
      in state.es-preview = ps
    else if k == key-left then
      let ps = preview-set-italic state.es-preview (clamp-range (state.es-preview.ps-italic - 100) 0 1000)
      in state.es-preview = ps
    else if k == char-code 'T' then
      let ps = preview-set-temperature state.es-preview (clamp-range (state.es-preview.ps-temperature + 100) 0 1000)
      in state.es-preview = ps
    else if k == char-code 'E' then export-current-font state
    else state

Section: Export

  export-current-font : ExplorerState -> ExplorerState
  export-current-font (state) =
    let params = GlyphParams {
      weight = state.es-preview.ps-weight,
      italic = state.es-preview.ps-italic,
      temperature = state.es-preview.ps-temperature,
      font-blend = []
    }
    in let name = "CodexAI-" & style-to-name params.weight params.italic
    in state

Section: Entry Point

  opening : [Console, FileSystem] Nothing
  opening = act
    print-line "Codex Font Explorer v0.1"
    print-line "Loading model weights..."
    let config = FontModelConfig {
      input-dim = 102,
      hidden1 = 256,
      hidden2 = 128,
      output-dim = 119,
      n-outer-pts = 32,
      n-inner1-pts = 16,
      n-inner2-pts = 8,
      n-fonts = 0
    }
    in let preview = preview-init
    in let state = ExplorerState {
      es-preview = preview,
      es-glyph-net = nn-new,
      es-kern-net = nn-new,
      es-config = config,
      es-export-path = "FontExplorer-output.ttf"
    }
    in let window = build-explorer-window state
    in act
      print-line "Window built. Ready."
      print-line "  Keys: Up/Down weight, Left/Right italic, T temperature, E export"
      print-line ("  Preview: " & state.es-preview.ps-sample-text)
    end
  end
