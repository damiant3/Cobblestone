Chapter: FontPreview
  cites Foreword chapter List
  cites Foreword chapter Console
  cites Encode chapter TrueTypeWriter

Section: Preview State

  PreviewState = record {
    ps-weight : Integer,
    ps-italic : Integer,
    ps-temperature : Integer,
    ps-sample-text : Text,
    ps-font-path : Text,
    ps-dirty : Integer
  }

  preview-init : PreviewState
  preview-init = PreviewState {
    ps-weight = 375,
    ps-italic = 0,
    ps-temperature = 0,
    ps-sample-text = "The quick brown fox jumps over the lazy dog",
    ps-font-path = "",
    ps-dirty = 1
  }

  preview-set-weight : PreviewState, Integer -> PreviewState
  preview-set-weight (ps) (w) =
    __record-set (__record-set ps "ps-weight" w) "ps-dirty" 1

  preview-set-italic : PreviewState, Integer -> PreviewState
  preview-set-italic (ps) (i) =
    __record-set (__record-set ps "ps-italic" i) "ps-dirty" 1

  preview-set-temperature : PreviewState, Integer -> PreviewState
  preview-set-temperature (ps) (t) =
    __record-set (__record-set ps "ps-temperature" t) "ps-dirty" 1

  preview-set-text : PreviewState, Text -> PreviewState
  preview-set-text (ps) (t) =
    __record-set (__record-set ps "ps-sample-text" t) "ps-dirty" 1

  preview-needs-refresh : PreviewState -> Integer
  preview-needs-refresh (ps) = ps.ps-dirty

  preview-mark-clean : PreviewState -> PreviewState
  preview-mark-clean (ps) = __record-set ps "ps-dirty" 0

Section: Font Name Generation

  weight-to-name : Integer -> Text
  weight-to-name (w) =
    if w < 200 then "Thin"
    else if w < 350 then "Light"
    else if w < 450 then "Regular"
    else if w < 550 then "Medium"
    else if w < 650 then "SemiBold"
    else if w < 750 then "Bold"
    else if w < 850 then "ExtraBold"
    else "Black"

  style-to-name : Integer, Integer -> Text
  style-to-name (weight) (italic) =
    let wn = weight-to-name weight
    in if italic > 500 then wn & " Italic"
    else wn
