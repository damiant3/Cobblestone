Chapter: RealtimePage
  cites Site chapter SiteTheme

 Punctual &mdash; a compile-time contract for guaranteed bounded-time
 execution. No runtime checks. No external WCET tools. The compiler
 proves your deadline.

 We say:

Section: Extra CSS

  realtime-extra-css : Text
  realtime-extra-css =
    ".realtime{max-width:1100px;margin:0 auto;padding:0 24px}"
    & ".profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}"
    & ".profile{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;transition:border-color .2s,transform .2s}"
    & ".profile:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".profile>.wk-label:first-child{font-size:16px;font-weight:700;color:#d4a017;margin-bottom:4px}"
    & ".profile>.wk-label:nth-child(2){font-size:13px;color:#8b949e;margin-bottom:12px}"
    & ".profile-costs{list-style:none;padding:0}"
    & ".profile-costs>.wk-label{padding:4px 0;font-size:13px;color:#aaa;font-family:'JetBrains Mono',Consolas,monospace}"
    & ".tiers{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}"
    & ".tier{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;transition:border-color .2s,transform .2s}"
    & ".tier:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".tier>.wk-label:first-child{font-size:18px;font-weight:700;color:#fff;margin-bottom:4px}"
    & ".tier>.wk-label:nth-child(2){font-size:14px;color:#d4a017;font-weight:600;margin-bottom:8px}"
    & ".tier>.wk-label:nth-child(3){font-size:14px;color:#8b949e;line-height:1.6}"
    & ".prior-art{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}"
    & ".prior{background:rgba(20,20,30,.7);border:1px solid #1e1e2e;border-radius:12px;padding:24px;transition:border-color .2s,transform .2s}"
    & ".prior:hover{border-color:#d4a017;transform:translateY(-4px)}"
    & ".prior>.wk-label:first-child{font-size:16px;font-weight:700;color:#fff;margin-bottom:4px}"
    & ".prior>.wk-label:nth-child(2){font-size:14px;color:#d4a017;font-weight:600;margin-bottom:8px}"
    & ".prior>.wk-label:nth-child(3){font-size:14px;color:#8b949e;line-height:1.6}"
    & "@media(max-width:768px){.profiles{grid-template-columns:1fr}.tiers{grid-template-columns:1fr}.prior-art{grid-template-columns:1fr}}"

Section: Tree

  rt-hero : WidgetNode
  rt-hero = site-hero "Compile-Time &#x2022; Verified &#x2022; Zero Cost" "PUNCTUAL" "A compile-time contract for guaranteed bounded-time execution. No runtime checks. No external WCET tools. <em>The compiler proves your deadline.</em>&shy;" [site-stat "s0" "0" "Runtime Checks", site-stat "s1" "100%" "Static Veri&shy;fication", site-stat "s2" "3" "Architecture Profiles", site-stat "s3" "4" "Deadline Tiers"]

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "root" "" [
      site-nav [
        widget-label "nl0" "Home",
        widget-label "nl1" "Punctual",
        widget-label "nl2" "WCET",
        widget-label "nl3" "Profiles",
        widget-label "nl4" "Tiers"
      ],
      rt-hero,
      widget-box "body" "realtime" [
        what-section 0,
        wcet-section 0,
        profiles-section 0,
        tiers-section 0,
        prior-section 0,
        site-footer [
          widget-label "fl0" "Home",
          widget-label "fl1" "IoT",
          widget-label "fl2" "Docu&shy;mentation",
          widget-label "fl3" "GitHub"
        ]
      ]
    ]

Section: What Is Punctual

  what-code : WidgetNode
  what-code = site-code-block "wcb" "Sensor.codex" "<span class='kw'>punctual</span>\n<span class='fn'>sensor-read</span> : <span class='ty'>SensorHandle</span>\n  -&gt; [<span class='ty'>Gpio</span>, <span class='ty'>Clock</span>] <span class='ty'>SensorReading</span>\n<span class='fn'>sensor-read</span> (h) = <span class='kw'>act</span>\n  <span class='kw'>let</span> raw = <span class='fn'>gpio-read</span> h\n  <span class='kw'>in let</span> cal = <span class='fn'>calibrate</span> raw\n  <span class='kw'>in let</span> ts = <span class='fn'>clock-now</span> 0\n  <span class='kw'>in</span> <span class='ty'>SensorReading</span> {\n    sr-value = cal,\n    sr-time = ts\n  }\n<span class='kw'>end</span>&shy;"

  what-info : WidgetNode
  what-info = site-showcase-info "wci" "Per-Function Timing Contract" "Place the punctual keyword before any function signature. The compiler statically computes worst-case instruction count and rejects the program if bounded execution cannot be proven." [site-tag "wci0" "Bounded time", site-tag "wci1" "Bounded memory", site-tag "wci2" "No blocking", site-tag "wci3" "Preemptible"]

  what-section : Integer -> WidgetNode
  what-section (x) =
    site-section "what" "THE KEYWORD" "What Is Punctual" "A single keyword that turns compile-time timing analysis on for any function." [
      site-showcase "what-show" what-code what-info
    ]

Section: WCET Analysis

  wcet-section : Integer -> WidgetNode
  wcet-section (x) =
    site-section "wcet" "ANALYSIS ENGINE" "Three-Layer WCET Analysis" "Sound by default. Architecture-aware when needed. Measured for final tuning." [
      site-card-grid-3 "wcet-grid" [
        site-card "ly0" "LAYER 1" "Structural Bounds" "Compile-time, sound. Proves every loop terminates, every recursion has a fuel cap, every branch is finite. If this layer passes, the function is provably bounded.",
        site-card "ly1" "LAYER 2" "Instruction-Count Bounds" "Architecture-aware. Maps each IR node to exact cycle costs for the target ISA. Produces a worst-case instruction count that accounts for pipeline stalls, cache misses, and branch misprediction penalties.",
        site-card "ly2" "LAYER 3" "Measured Calibration" "Runtime, informational. Optional profiling pass that measures actual execution times on hardware and compares against the static bounds. Used for tuning, not for correctness."
      ]
    ]

Section: Architecture Profiles

  profiles-section : Integer -> WidgetNode
  profiles-section (x) =
    site-section "prof" "TARGET HARDWARE" "Architecture Profiles" "Cycle costs per instruction class, per target. The compiler uses these to compute WCET." [
      widget-box "prof-grid" "profiles" [
        profile-card "p0" "Cortex-M4" "168 MHz, in-order" [
          widget-label "p0c0" "alu    = 1 cycle",
          widget-label "p0c1" "mul    = 1 cycle",
          widget-label "p0c2" "div    = 2-12 cycles",
          widget-label "p0c3" "load   = 2 cycles",
          widget-label "p0c4" "branch = 3 cycles"
        ],
        profile-card "p1" "ESP32-C6 RISC-V" "160 MHz, in-order" [
          widget-label "p1c0" "alu    = 1 cycle",
          widget-label "p1c1" "mul    = 1-5 cycles",
          widget-label "p1c2" "div    = 6-35 cycles",
          widget-label "p1c3" "load   = 2 cycles",
          widget-label "p1c4" "branch = 3 cycles"
        ],
        profile-card "p2" "Cortex-A72" "out-of-order, conservative" [
          widget-label "p2c0" "alu    = 1 cycle",
          widget-label "p2c1" "mul    = 3 cycles",
          widget-label "p2c2" "div    = 4-20 cycles",
          widget-label "p2c3" "load   = 4 cycles",
          widget-label "p2c4" "branch = 8 cycles"
        ]
      ]
    ]

  profile-card : Text, Text, Text, List WidgetNode -> WidgetNode
  profile-card (id) (name) (desc) (costs) =
    widget-box id "profile" [
      widget-label (id & "n") name,
      widget-label (id & "d") desc,
      widget-box (id & "c") "profile-costs" costs
    ]

Section: Deadline Tiers

  tiers-section : Integer -> WidgetNode
  tiers-section (x) =
    site-section "tiers" "DEADLINE CLASSES" "Deadline Tiers" "Four tiers of real-time guarantee, from motor control loops to MQTT keepalives." [
      widget-box "tiers-grid" "tiers" [
        tier-card "d0" "Ultra-Hard" "1 &mdash; 100 &#xB5;s" "Motor control loops, EtherCAT fieldbus, safety-critical actuator commands. Every microsecond is accounted for. Compiler rejects any function that cannot prove sub-100&#xB5;s worst case.",
        tier-card "d1" "Hard" "100 &#xB5;s &mdash; 10 ms" "Factory automation, PLC scan cycles, CAN bus frames. The bread and butter of industrial real-time. Punctual functions at this tier run on Cortex-M4 and RISC-V targets.",
        tier-card "d2" "Firm" "10 ms &mdash; 1 s" "5G URLLC slots, Thread mesh networking, audio DSP buffers. Late data is degraded data &mdash; the system works but quality drops. Punctual enforces the bound; the application decides the policy.",
        tier-card "d3" "Soft" "1 s &mdash; minutes" "CoAP acknowledgments, MQTT keepalives, OTA update checks. Deadlines matter for protocol compliance but a single miss does not cause failure. Punctual still proves the bound."
      ]
    ]

  tier-card : Text, Text, Text, Text -> WidgetNode
  tier-card (id) (name) (range) (desc) =
    widget-box id "tier" [
      widget-label (id & "n") name,
      widget-label (id & "r") range,
      widget-label (id & "d") desc
    ]

Section: Prior Art

  prior-section : Integer -> WidgetNode
  prior-section (x) =
    site-section "prior" "WHY THIS IS DIFFERENT" "Prior Art" "Every existing approach requires either whole-language restrictions or external tools. Codex does neither." [
      widget-box "prior-grid" "prior-art" [
        prior-card "pa0" "Ada Ravenscar" "Global restrictions + external tools" "Restricts the entire tasking profile. WCET analysis requires third-party tools costing $50K+. The language itself proves nothing about timing.",
        prior-card "pa1" "Esterel / SCADE" "Restricted language" "The entire language is synchronous and bounded &mdash; but you cannot write general-purpose code. Every function pays the restriction tax, not just the ones that need it.",
        prior-card "pa2" "Idris Totality" "Proves termination, not timing" "Total functions are guaranteed to terminate, but termination says nothing about how long. A total function can take a year. Punctual proves a cycle count.",
        prior-card "pa3" "Codex Punctual" "Per-function, compiler-verified, zero cost" "No global restrictions. No external tools. No runtime overhead. The punctual keyword opts a single function into static timing analysis. Everything else is unconstrained. The compiler does all the work."
      ]
    ]

  prior-card : Text, Text, Text, Text -> WidgetNode
  prior-card (id) (name) (approach) (desc) =
    widget-box id "prior" [
      widget-label (id & "n") name,
      widget-label (id & "a") approach,
      widget-label (id & "d") desc
    ]

Section: Handlers

  realtime-click : Text -> Integer
  realtime-click (id) = 0

Section: Entry

  render-realtime : Integer -> Integer
  render-realtime (x) = mount-widget-themed site-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = site-init realtime-extra-css
    in let s = set-render render-realtime
    in let h = register-handlers no-pick realtime-click
    in render-realtime 0
  end

