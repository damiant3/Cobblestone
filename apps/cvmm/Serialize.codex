Chapter: Serialize
  cites Cvmm chapter CvmmTypes
  cites Cvmm chapter ResourceModel
  cites Cvmm chapter Command
  cites Cvmm chapter Monitor
  cites Cvmm chapter DataBinding

 Wire format serialization boundary. Every type that crosses the
 TCP/HTTP boundary gets serialized here. No other chapter should
 build JSON strings. This is the single place where Codex data
 structures become wire-format text, and the single place to change
 if the wire format changes.

 The HTML plug emits these as JavaScript functions. The CDX server
 calls them at route boundaries. No domain logic here — just
 structure-to-text conversion.

Section: Primitives

  json-text : Text -> Text
  json-text (s) = "\"" & s & "\""

  json-int : Integer -> Text
  json-int (n) = show n

  json-bool : Boolean -> Text
  json-bool (b) = if b then "true" else "false"

  json-pair : Text, Text -> Text
  json-pair (key) (val) = json-text key & ":" & val

  json-pair-text : Text, Text -> Text
  json-pair-text (key) (val) = json-text key & ":" & json-text val

  json-pair-int : Text, Integer -> Text
  json-pair-int (key) (val) = json-text key & ":" & json-int val

  json-pair-bool : Text, Boolean -> Text
  json-pair-bool (key) (val) = json-text key & ":" & json-bool val

  json-obj : List Text -> Text
  json-obj (pairs) = "{" & json-join pairs 0 (list-length pairs) "" & "}"

  json-arr : List Text -> Text
  json-arr (items) = "[" & json-join items 0 (list-length items) "" & "]"

  json-join : List Text, Integer, Integer, Text -> Text
  json-join (items) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else ","
    in json-join items (i + 1) n (acc & sep & list-at items i)

Section: PropValue Serialization

  serialize-pv : PropValue -> Text
  serialize-pv (v) = when v
    is PvText (s) -> json-text s
    is PvInt (n) -> json-int n
    is PvBool (b) -> json-bool b
    is PvBytes (sz) -> json-int (sz.bs-bytes)
    is PvDuration (secs) -> json-int secs
    is PvPercent (n) -> json-int n
    is PvStatus (s) -> json-text (status-label s)
    is PvNone -> "null"

Section: Property Serialization

  serialize-property : Property -> Text
  serialize-property (p) =
    json-obj [
      json-pair-text "key" (p.prop-key),
      json-pair-text "label" (p.prop-label),
      json-pair "value" (serialize-pv (p.prop-value)),
      json-pair-text "display" (pv-to-text (p.prop-value)),
      json-pair-text "unit" (p.prop-unit),
      json-pair-bool "editable" (p.prop-editable)
    ]

  serialize-properties : List Property, Integer, Integer -> Text
  serialize-properties (props) (i) (n) =
    json-arr (ser-props-loop props i n [])

  ser-props-loop : List Property, Integer, Integer, List Text -> List Text
  ser-props-loop (props) (i) (n) (acc) =
    if i >= n then acc
    else ser-props-loop props (i + 1) n (list-push acc (serialize-property (list-at props i)))

Section: Resource Serialization

  serialize-resource : Resource -> Text
  serialize-resource (r) =
    json-obj [
      json-pair-text "id" (r.res-id),
      json-pair-text "name" (r.res-name),
      json-pair-text "kind" (r.res-kind),
      json-pair-text "status" (status-label (r.res-status)),
      json-pair-text "icon" (r.res-icon),
      json-pair-text "category" (r.res-category),
      json-pair-text "parentId" (r.res-parent-id),
      json-pair-int "childCount" (r.res-children-count),
      json-pair "properties" (serialize-properties (r.res-properties) 0 (r.res-prop-count)),
      json-pair "capabilities" (serialize-caps (r.res-capabilities) 0 (r.res-cap-count))
    ]

  serialize-caps : List Capability, Integer, Integer -> Text
  serialize-caps (caps) (i) (n) =
    json-arr (ser-caps-loop caps i n [])

  ser-caps-loop : List Capability, Integer, Integer, List Text -> List Text
  ser-caps-loop (caps) (i) (n) (acc) =
    if i >= n then acc
    else let c = list-at caps i
    in let entry = json-obj [
      json-pair-text "label" (cap-label c),
      json-pair-bool "destructive" (cap-is-destructive c),
      json-pair-bool "confirm" (cap-needs-confirm c)
    ]
    in ser-caps-loop caps (i + 1) n (list-push acc entry)

  serialize-resources : List Resource, Integer, Integer -> Text
  serialize-resources (rs) (i) (n) =
    json-arr (ser-res-loop rs i n [])

  ser-res-loop : List Resource, Integer, Integer, List Text -> List Text
  ser-res-loop (rs) (i) (n) (acc) =
    if i >= n then acc
    else ser-res-loop rs (i + 1) n (list-push acc (serialize-resource (list-at rs i)))

Section: ResourceCollection Serialization

  serialize-collection : ResourceCollection -> Text
  serialize-collection (rc) =
    json-obj [
      json-pair-text "kind" (rc.rc-kind),
      json-pair-int "count" (rc.rc-count),
      json-pair-int "healthy" (rc-healthy-count rc),
      json-pair-text "selected" (rc.rc-selected),
      json-pair "resources" (serialize-resources (rc.rc-resources) 0 (rc.rc-count))
    ]

Section: Command Serialization

  serialize-command : CommandRecord -> Text
  serialize-command (r) =
    json-obj [
      json-pair-int "id" (r.cr-id),
      json-pair-text "description" (r.cr-description),
      json-pair-text "state" (cmd-state-label (r.cr-state)),
      json-pair-int "timestamp" (r.cr-timestamp)
    ]

  serialize-history : CommandHistory -> Text
  serialize-history (hist) =
    json-obj [
      json-pair-int "count" (hist.ch-count),
      json-pair-int "cursor" (hist.ch-cursor),
      json-pair-bool "canUndo" (ch-can-undo hist),
      json-pair-bool "canRedo" (ch-can-redo hist),
      json-pair "recent" (json-arr (ser-cmd-loop (ch-recent hist 10) 0 (list-length (ch-recent hist 10)) []))
    ]

  ser-cmd-loop : List CommandRecord, Integer, Integer, List Text -> List Text
  ser-cmd-loop (cmds) (i) (n) (acc) =
    if i >= n then acc
    else ser-cmd-loop cmds (i + 1) n (list-push acc (serialize-command (list-at cmds i)))

Section: Binding Serialization

  serialize-binding : Binding -> Text
  serialize-binding (b) =
    json-obj [
      json-pair-text "id" (b.bind-id),
      json-pair-text "source" (ds-kind-label (b.bind-source)),
      json-pair-text "target" (b.bind-target),
      json-pair-int "interval" (b.bind-interval-ms),
      json-pair "output" (serialize-pv (b.bind-last-output)),
      json-pair-text "outputDisplay" (pv-to-text (b.bind-last-output)),
      json-pair-int "updates" (b.bind-update-count),
      json-pair-bool "active" (b.bind-active)
    ]

Section: Shortcut Serialization

  serialize-shortcut : Shortcut -> Text
  serialize-shortcut (sc) =
    json-obj [
      json-pair-text "id" (sc.sc-id),
      json-pair-text "chord" (format-chord (sc.sc-chord)),
      json-pair-text "description" (sc.sc-description),
      json-pair-text "scope" (scope-label (sc.sc-scope)),
      json-pair-bool "enabled" (sc.sc-enabled)
    ]

  serialize-shortcuts : ShortcutRegistry -> Text
  serialize-shortcuts (reg) =
    json-arr (ser-sc-loop (reg.sr-shortcuts) 0 (reg.sr-count) [])

  ser-sc-loop : List Shortcut, Integer, Integer, List Text -> List Text
  ser-sc-loop (scs) (i) (n) (acc) =
    if i >= n then acc
    else ser-sc-loop scs (i + 1) n (list-push acc (serialize-shortcut (list-at scs i)))

Section: Error and OK

  serialize-error : Text -> Text
  serialize-error (msg) = json-obj [json-pair-text "error" msg]

  serialize-ok : Text -> Text
  serialize-ok (msg) = json-obj [json-pair-bool "ok" True, json-pair-text "message" msg]

