Chapter: CvmmTheme
  cites UI chapter Theme
  cites UI chapter BoxModel

 OS-level theme for CVMM. Dark by default -- this is a systems tool, not
 a consumer app. High contrast text, muted chrome, accent on interactive
 elements. Designed to read well on high-DPI displays and low-light
 conditions (server rooms, night shifts).

Section: Palette

  cvmm-palette-dark : Palette
  cvmm-palette-dark = Palette {
    pal-bg = #121212,
    pal-fg = #E0E0E0,
    pal-primary = #4A90E2,
    pal-secondary = #222222,
    pal-accent = #477ECC,
    pal-muted = #666666,
    pal-error = #DD3044,
    pal-success = #41BC47,
    pal-warning = #FF9900,
    pal-border = #333333
  }

  cvmm-palette-light : Palette
  cvmm-palette-light = Palette {
    pal-bg = #F0F0F0,
    pal-fg = #222222,
    pal-primary = #396C6E,
    pal-secondary = #CCCCCC,
    pal-accent = #396C6E,
    pal-muted = #808080,
    pal-error = #DD3044,
    pal-success = #2E8B57,
    pal-warning = #E67E22,
    pal-border = #CCCCCC
  }

Section: Widget Styles

  cvmm-edge-zero : Edges
  cvmm-edge-zero = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  cvmm-edge-sm : Edges
  cvmm-edge-sm = Edges { edge-top = 4, edge-right = 8, edge-bottom = 4, edge-left = 8 }

  cvmm-edge-md : Edges
  cvmm-edge-md = Edges { edge-top = 8, edge-right = 12, edge-bottom = 8, edge-left = 12 }

  cvmm-edge-lg : Edges
  cvmm-edge-lg = Edges { edge-top = 12, edge-right = 16, edge-bottom = 12, edge-left = 16 }

  cvmm-border-none : Border
  cvmm-border-none =
    let side = BorderSide { brd-width = 0, brd-color = 0 }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerSharp }

  cvmm-border-subtle : Integer -> Border
  cvmm-border-subtle (color) =
    let side = BorderSide { brd-width = 1, brd-color = __narrow color }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerRound 4 }

  cvmm-border-round : Integer, Integer -> Border
  cvmm-border-round (color) (radius) =
    let side = BorderSide { brd-width = 1, brd-color = __narrow color }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerRound radius }

Section: State Sets

  cvmm-ws : Integer, Integer, Edges, Edges, Border, Integer, Integer -> WidgetStyle
  cvmm-ws (bg) (fg) (pad) (mar) (bdr) (minw) (minh) = WidgetStyle {
    ws-bg = __narrow bg, ws-fg = __narrow fg, ws-padding = pad, ws-margin = mar,
    ws-border = bdr, ws-min-width = __narrow minw, ws-min-height = __narrow minh,
    ws-shadow = shadow-none, ws-gradient = gradient-none, ws-accent-border = accent-border-none
  }

  cvmm-ws-rich : Integer, Integer, Edges, Edges, Border, Integer, Integer, Shadow, Gradient, AccentBorder -> WidgetStyle
  cvmm-ws-rich (bg) (fg) (pad) (mar) (bdr) (minw) (minh) (sh) (gr) (ab) = WidgetStyle {
    ws-bg = __narrow bg, ws-fg = __narrow fg, ws-padding = pad, ws-margin = mar,
    ws-border = bdr, ws-min-width = __narrow minw, ws-min-height = __narrow minh,
    ws-shadow = sh, ws-gradient = gr, ws-accent-border = ab
  }

  cvmm-ss : WidgetStyle -> StateStyles
  cvmm-ss (normal) = StateStyles {
    ss-normal = normal,
    ss-hover = normal,
    ss-pressed = normal,
    ss-disabled = normal,
    ss-focused = normal
  }

  cvmm-ss-interactive : WidgetStyle, WidgetStyle, WidgetStyle -> StateStyles
  cvmm-ss-interactive (normal) (hover) (pressed) = StateStyles {
    ss-normal = normal,
    ss-hover = hover,
    ss-pressed = pressed,
    ss-disabled = normal,
    ss-focused = hover
  }

Section: Dark Theme

  cvmm-theme-dark : Theme
  cvmm-theme-dark =
    let pal = cvmm-palette-dark
    in let panel-ws = cvmm-ws (pal.pal-bg) (pal.pal-fg) cvmm-edge-zero cvmm-edge-zero cvmm-border-none 0 0
    in let label-ws = cvmm-ws 0 (pal.pal-fg) cvmm-edge-sm cvmm-edge-zero cvmm-border-none 0 0
    in let btn-normal = cvmm-ws (pal.pal-primary) #FFFFFF cvmm-edge-sm cvmm-edge-sm (cvmm-border-round (pal.pal-primary) 4) 0 28
    in let btn-hover = cvmm-ws (pal.pal-accent) #FFFFFF cvmm-edge-sm cvmm-edge-sm (cvmm-border-round (pal.pal-accent) 4) 0 28
    in let btn-pressed = cvmm-ws #333333 #FFFFFF cvmm-edge-sm cvmm-edge-sm (cvmm-border-round #333333 4) 0 28
    in let input-ws = cvmm-ws #222222 (pal.pal-fg) cvmm-edge-sm cvmm-edge-sm (cvmm-border-subtle (pal.pal-border)) 120 28
    in let gauge-ws = cvmm-ws #222222 (pal.pal-primary) cvmm-edge-zero cvmm-edge-sm (cvmm-border-round (pal.pal-border) 4) 60 16
    in let sep-ws = cvmm-ws (pal.pal-border) 0 cvmm-edge-zero cvmm-edge-sm cvmm-border-none 0 1
    in Theme {
      th-name = "cvmm-dark",
      th-palette = pal,
      th-panel = cvmm-ss panel-ws,
      th-label = cvmm-ss label-ws,
      th-button = cvmm-ss-interactive btn-normal btn-hover btn-pressed,
      th-input = cvmm-ss input-ws,
      th-gauge = cvmm-ss gauge-ws,
      th-separator = cvmm-ss sep-ws
    }

Section: Enriched Styles

  cvmm-card-style : WidgetStyle
  cvmm-card-style =
    cvmm-ws-rich cvmm-color-card #E0E0E0 cvmm-edge-md cvmm-edge-sm (cvmm-border-round #333333 6) 0 0 (shadow-subtle #0A0A0A) gradient-none accent-border-none

  cvmm-elevated-style : WidgetStyle
  cvmm-elevated-style =
    cvmm-ws-rich cvmm-color-card #E0E0E0 cvmm-edge-md cvmm-edge-sm (cvmm-border-round #333333 8) 0 0 (shadow-medium #0A0A0A) gradient-none accent-border-none

  cvmm-sidebar-style : WidgetStyle
  cvmm-sidebar-style =
    cvmm-ws-rich cvmm-color-sidebar #E0E0E0 cvmm-edge-sm cvmm-edge-zero cvmm-border-none 0 0 shadow-none (gradient-h cvmm-color-sidebar #1A1A1A) accent-border-none

  cvmm-header-style : WidgetStyle
  cvmm-header-style =
    cvmm-ws-rich cvmm-color-header #E0E0E0 cvmm-edge-md cvmm-edge-zero cvmm-border-none 0 0 shadow-none gradient-none (accent-border-bottom 2 #4A90E2)

  cvmm-input-focus-style : WidgetStyle
  cvmm-input-focus-style =
    cvmm-ws-rich #222222 #E0E0E0 cvmm-edge-sm cvmm-edge-sm (cvmm-border-round #477ECC 4) 120 28 (shadow-subtle #1A3A5C) gradient-none accent-border-none

  cvmm-button-accent-style : WidgetStyle
  cvmm-button-accent-style =
    cvmm-ws-rich #4A90E2 #FFFFFF cvmm-edge-sm cvmm-edge-sm (cvmm-border-round #4A90E2 4) 0 28 shadow-none gradient-none (accent-border-top 2 #6BB0FF)

Section: Semantic Colors

  cvmm-color-sidebar : Integer = #171717
  cvmm-color-header : Integer = #1C1C1C
  cvmm-color-card : Integer = #202020
  cvmm-color-card-hover : Integer = #262626
  cvmm-color-success : Integer = #41BC47
  cvmm-color-warning : Integer = #FF9900
  cvmm-color-error : Integer = #DD3044
  cvmm-color-info : Integer = #477ECC
  cvmm-color-text-muted : Integer = #666666
  cvmm-color-text-bright : Integer = #FFFFFF
  cvmm-color-divider : Integer = #333333

