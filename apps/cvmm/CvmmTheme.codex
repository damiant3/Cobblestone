Section: Widget Styles

  cvmm-edge-zero : EdgeInsets
  cvmm-edge-zero = EdgeInsets { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  cvmm-edge-sm : EdgeInsets
  cvmm-edge-sm = EdgeInsets { edge-top = 4, edge-right = 8, edge-bottom = 4, edge-left = 8 }

  cvmm-edge-md : EdgeInsets
  cvmm-edge-md = EdgeInsets { edge-top = 8, edge-right = 12, edge-bottom = 8, edge-left = 12 }

  cvmm-edge-lg : EdgeInsets
  cvmm-edge-lg = EdgeInsets { edge-top = 12, edge-right = 16, edge-bottom = 12, edge-left = 16 }

  cvmm-border-none : Border
  cvmm-border-none =
    let side = BorderSide { brd-width = 0, brd-color = 0 }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerSharp }

  cvmm-border-subtle : Integer -> Border
  cvmm-border-subtle (color) =
    let side = BorderSide { brd-width = 1, brd-color = color }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerRound 4 }

  cvmm-border-round : Integer, Integer -> Border
  cvmm-border-round (color) (radius) =
    let side = BorderSide { brd-width = 1, brd-color = color }
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = CornerRound radius }

Section: State Sets

  cvmm-ws : Integer, Integer, EdgeInsets, EdgeInsets, Border, Integer, Integer -> WidgetStyle
  cvmm-ws (bg) (fg) (pad) (mar) (bdr) (minw) (minh) = WidgetStyle {
    ws-bg = bg, ws-fg = fg, ws-padding = pad, ws-margin = mar,
    ws-border = bdr, ws-min-width = minw, ws-min-height = minh
  }

  cvmm-ss : WidgetStyle -> StateSet
  cvmm-ss (normal) = StateSet {
    ss-normal = normal,
    ss-hover = normal,
    ss-pressed = normal,
    ss-disabled = normal,
    ss-focused = normal
  }

  cvmm-ss-interactive : WidgetStyle, WidgetStyle, WidgetStyle -> StateSet
  cvmm-ss-interactive (normal) (hover) (pressed) = StateSet {
    ss-normal = normal,
    ss-hover = hover,
    ss-pressed = pressed,
    ss-disabled = normal,
    ss-focused = hover
  }

Section: Dark Theme

  cvmm-theme-dark : Theme
  cvmm-theme-dark =
    let pal = cvmm-palette-dark
    in let panel-ws = cvmm-ws (pal.pal-bg) (pal.pal-fg) cvmm-edge-zero cvmm-edge-zero cvmm-border-none 0 0
    in let label-ws = cvmm-ws 0 (pal.pal-fg) cvmm-edge-sm cvmm-edge-zero cvmm-border-none 0 0
    in let btn-normal = cvmm-ws (pal.pal-primary) 16777215 cvmm-edge-sm cvmm-edge-sm (cvmm-border-round (pal.pal-primary) 4) 0 28
    in let btn-hover = cvmm-ws (pal.pal-accent) 16777215 cvmm-edge-sm cvmm-edge-sm (cvmm-border-round (pal.pal-accent) 4) 0 28
    in let btn-pressed = cvmm-ws 3355443 16777215 cvmm-edge-sm cvmm-edge-sm (cvmm-border-round 3355443 4) 0 28
    in let input-ws = cvmm-ws 2236962 (pal.pal-fg) cvmm-edge-sm cvmm-edge-sm (cvmm-border-subtle (pal.pal-border)) 120 28
    in let gauge-ws = cvmm-ws 2236962 (pal.pal-primary) cvmm-edge-zero cvmm-edge-sm (cvmm-border-round (pal.pal-border) 4) 60 16
    in let sep-ws = cvmm-ws (pal.pal-border) 0 cvmm-edge-zero cvmm-edge-sm cvmm-border-none 0 1
    in Theme {
      th-palette = pal,
      th-panel = cvmm-ss panel-ws,
      th-label = cvmm-ss label-ws,
      th-button = cvmm-ss-interactive btn-normal btn-hover btn-pressed,
      th-input = cvmm-ss input-ws,
      th-gauge = cvmm-ss gauge-ws,
      th-separator = cvmm-ss sep-ws
    }

