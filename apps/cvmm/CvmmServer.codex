Section: Mock Data

  server-registry : ServiceRegistry
  server-registry = service-register service-registry-empty "web" 0 0

  server-views : DriveManagerState, UsbManagerState, ExplorerState -> ManagerViews
  server-views (drives) (usb) (files) = ManagerViews {
    mv-file = files,
    mv-drive = drives,
    mv-usb = usb,
    mv-proc = pm-live,
    mv-service = sm-from-registry server-registry,
    mv-port = port-monitor-new,
    mv-net = nm-live,
    mv-display = dm-live,
    mv-server = server-manager-new,
    mv-fleet = fleet-manager-new,
    mv-deploy = deploy-manager-new,
    mv-log = lv-live disk-load,
    mv-terminal = term-from-views nm-live usb dm-live,
    mv-mesh-group = group-new "codex-mesh" "local",
    mv-mesh-health = health-checker-new
  }

Section: Summary from Views

  summary-from-views : ManagerViews -> SystemSummary
  summary-from-views (v) = SystemSummary {
    sys-hostname = "codex-vm",
    sys-device = DeviceId { dev-uuid = "local", dev-name = "codex-vm", dev-kind = DevVirtualMachine },
    sys-status = StatusOnline,
    sys-uptime = Uptime { ut-seconds = 3600 },
    sys-cpu-percent = (v.mv-proc).pm-total-cpu,
    sys-mem-used = (v.mv-proc).pm-total-mem,
    sys-mem-total = megabytes 2048,
    sys-disk-used = bytes 246205644,
    sys-disk-total = bytes 536870912,
    sys-process-count = (v.mv-proc).pm-count,
    sys-service-count = (v.mv-service).sm-count,
    sys-port-count = (v.mv-port).pm-listener-count,
    sys-nic-count = (v.mv-net).nm-nic-count,
    sys-fleet-count = (v.mv-fleet).fm-node-count,
    sys-mesh-total = (v.mv-fleet).fm-node-count,
    sys-mesh-alive = fm-healthy-count (v.mv-fleet),
    sys-healthy-checks = (v.mv-mesh-health).hcs-total-healthy,
    sys-total-checks = (v.mv-mesh-health).hcs-count
  }

Section: Entry

  live-views : ManagerViews, WebLoop -> ManagerViews
  live-views (views) (ls) = __record-set views "mv-port" (portmon-live (ls.transport) "web" "CVMM Web Server")

  route : ManagerViews, AppState, Text -> Text
  route (views) (st) (path) = cvmm-route st views path

  opening : [Console, Device.Block, Device.Port, Network.Read, Network.Write] Nothing = act
    drives <- dm-read-block-devices
    attached <- usb-attach
    files <- fe-live
    let views = server-views drives (um-from-attach attached) files
    in let summary = summary-from-views views
    in let st = __record-set app-state-new "app-summary" summary
    in act
      r <- web-serve-framed-with (\ls path -> route (live-views views ls) st path)
      print-line-uni "CVMM SHUTDOWN"
    end
  end

