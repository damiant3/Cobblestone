 Route dispatch for all CVMM API endpoints. Each manager's routes
 are grouped by prefix. The route function maps a path to a JSON
 response body. State is passed through -- each route handler reads
 its slice and produces JSON.

Section: JSON Helpers

  json-error : Text -> Text
  json-error (msg) = "{\"error\":\"" & msg & "\"}"

  json-ok-msg : Text -> Text
  json-ok-msg (msg) = "{\"ok\":true,\"message\":\"" & msg & "\"}"

  json-list : List Text, Integer, Integer, Text -> Text
  json-list (items) (i) (n) (acc) =
    if i >= n then "[" & acc & "]"
    else let sep = if i == 0 then "" else ","
    in json-list items (i + 1) n (acc & sep & list-at items i)

Section: Route Dispatch

  cvmm-route : AppState, ManagerViews, Text -> Text
  cvmm-route (st) (views) (path) =
    if text-starts-with path "/api/system" then route-system st path
    else if text-starts-with path "/api/fs" then route-fs (views.mv-file) path
    else if text-starts-with path "/api/drive" then route-drive (views.mv-drive) path
    else if text-starts-with path "/api/usb" then route-usb (views.mv-usb) path
    else if text-starts-with path "/api/process" then route-process (views.mv-proc) path
    else if text-starts-with path "/api/service" then route-service (views.mv-service) path
    else if text-starts-with path "/api/port" then route-port (views.mv-port) path
    else if text-starts-with path "/api/net" then route-net (views.mv-net) path
    else if text-starts-with path "/api/display" then route-display (views.mv-display) path
    else if text-starts-with path "/api/server" then route-server (views.mv-server) path
    else if text-starts-with path "/api/fleet" then route-fleet (views.mv-fleet) path
    else if text-starts-with path "/api/deploy" then route-deploy (views.mv-deploy) path
    else if text-starts-with path "/api/monitor" then json-error "monitor temporarily disabled"
    else if text-starts-with path "/api/log" then route-log (views.mv-log) path
    else if text-starts-with path "/api/terminal" then route-terminal (views.mv-terminal) path
    else if text-starts-with path "/api/shell" then route-shell st path
    else json-error "unknown route"

Section: System Routes

  route-system : AppState, Text -> Text
  route-system (st) (path) =
    if text-ends-with path "/status" then system-summary-to-json (st.app-summary)
    else if text-ends-with path "/state" then shell-state-to-json st
    else json-error "unknown system route"

Section: File System Routes

  route-fs : ExplorerState, Text -> Text
  route-fs (st) (path) =
    if text-ends-with path "/list" then
      file-entries-to-json (st.ex-entries) 0 (st.ex-entry-count) ""
    else if text-ends-with path "/cwd" then
      "{\"cwd\":\"" & st.ex-cwd & "\",\"count\":" & show (st.ex-entry-count) & "}"
    else if text-ends-with path "/stats" then
      "{\"cwd\":\"" & st.ex-cwd
      & "\",\"files\":" & show (explorer-file-count st)
      & ",\"dirs\":" & show (explorer-dir-count st)
      & ",\"totalSize\":" & show (explorer-total-size st).bs-bytes
      & ",\"selectedSize\":" & show (explorer-selected-size st).bs-bytes
      & ",\"selected\":" & show (st.ex-selected-count) & "}"
    else json-error "unknown fs route"

Section: Drive Routes

  route-drive : DriveManagerState, Text -> Text
  route-drive (st) (path) =
    if text-ends-with path "/list" then
      let jsons = dm-disks-json (st.dm-disks) 0 (st.dm-disk-count) []
      in json-list jsons 0 (list-length jsons) ""
    else if text-ends-with path "/partitions" then
      let jsons = dm-parts-json (st.dm-partitions) 0 (st.dm-partition-count) []
      in json-list jsons 0 (list-length jsons) ""
    else json-error "unknown drive route"

  dm-disks-json : List PhysicalDisk, Integer, Integer, List Text -> List Text
  dm-disks-json (disks) (i) (n) (acc) =
    if i >= n then acc
    else dm-disks-json disks (i + 1) n (list-push acc (physical-disk-to-json (list-at disks i)))

  dm-parts-json : List Partition, Integer, Integer, List Text -> List Text
  dm-parts-json (parts) (i) (n) (acc) =
    if i >= n then acc
    else dm-parts-json parts (i + 1) n (list-push acc (partition-to-json (list-at parts i)))

