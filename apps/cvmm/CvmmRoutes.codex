Section: Display Routes

  route-display : DisplayManagerState, Text -> Text
  route-display (st) (path) =
    if text-ends-with path "/monitors" then
      "{\"gpus\":" & show (st.disp-gpu-count) & ",\"monitors\":" & show (st.disp-monitor-count) & ",\"totalPixels\":" & show (st.disp-total-pixels) & "}"
    else json-error "unknown display route"

Section: Port Expanded Routes

  route-port-expanded : PortMonitorState, Text -> Text
  route-port-expanded (st) (path) =
    if text-ends-with path "/summary" then
      "{\"listeners\":" & show (st.pm-listener-count)
      & ",\"connections\":" & show (st.pm-connection-count)
      & ",\"active\":" & show (portmon-active-connections st)
      & ",\"rules\":" & show (st.pm-rule-count)
      & ",\"totalIn\":" & show (portmon-total-in st).bs-bytes
      & ",\"totalOut\":" & show (portmon-total-out st).bs-bytes & "}"
    else json-error "unknown port route"

Section: Server Routes

  route-server : ServerManagerState, Text -> Text
  route-server (st) (path) =
    if text-ends-with path "/list" then
      let jsons = svr-svrs-json (st.svr-servers) 0 (st.svr-count) []
      in json-list jsons 0 (list-length jsons) ""
    else json-error "unknown server route"

  svr-svrs-json : List ManagedServer, Integer, Integer, List Text -> List Text
  svr-svrs-json (svrs) (i) (n) (acc) =
    if i >= n then acc
    else svr-svrs-json svrs (i + 1) n (list-push acc (managed-server-to-json (list-at svrs i)))

Section: Fleet Routes

  route-fleet : FleetManagerState, Text -> Text
  route-fleet (st) (path) =
    if text-ends-with path "/list" then
      let jsons = fm-nodes-json (st.fm-nodes) 0 (st.fm-node-count) []
      in json-list jsons 0 (list-length jsons) ""
    else if text-ends-with path "/health" then
      let healthy = fm-healthy-count st
      in let disc = if st.fm-discovery-active then "true" else "false"
      in "{\"total\":" & show (st.fm-node-count) & ",\"healthy\":" & show healthy & ",\"discovery\":" & disc & "}"
    else json-error "unknown fleet route"

  fm-nodes-json : List FleetNode, Integer, Integer, List Text -> List Text
  fm-nodes-json (nodes) (i) (n) (acc) =
    if i >= n then acc
    else fm-nodes-json nodes (i + 1) n (list-push acc (fleet-node-to-json (list-at nodes i)))

Section: Deploy Routes

  route-deploy : DeployManagerState, Text -> Text
  route-deploy (st) (path) =
    if text-ends-with path "/list" then
      "{\"total\":" & show (st.dpm-count) & ",\"active\":" & show (st.dpm-active-count) & "}"
    else json-error "unknown deploy route"

Section: Log Routes

  route-log : LogViewerState, Text -> Text
  route-log (st) (path) =
    if text-ends-with path "/list" then
      let visible = lv-visible-entries st
      in log-entries-to-json visible 0 (list-length visible) ""
    else if text-ends-with path "/summary" then
      log-buffer-summary-json (st.lv-buffer)
    else json-error "unknown log route"

Section: Terminal Routes

  route-terminal : TerminalState, Text -> Text
  route-terminal (st) (path) =
    if text-ends-with path "/state" then terminal-state-to-json st
    else if text-ends-with path "/screen" then
      "{\"screen\":\"" & term-screen-text st & "\"}"
    else json-error "unknown terminal route"

Section: Shell Routes

  route-shell : AppState, Text -> Text
  route-shell (st) (path) =
    if text-ends-with path "/state" then shell-state-to-json st
    else if text-ends-with path "/navigate" then json-ok-msg "navigate requires POST"
    else json-error "unknown shell route"

