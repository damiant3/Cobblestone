    else json-error "unknown usb route"

  um-devs-json : List UsbDevice, Integer, Integer, List Text -> List Text
  um-devs-json (devs) (i) (n) (acc) =
    if i >= n then acc
    else um-devs-json devs (i + 1) n (list-push acc (usb-device-to-json (list-at devs i)))

Section: Process Routes

  route-process : ProcessManagerState, Text -> Text
  route-process (st) (path) =
    if text-ends-with path "/list" then
      let jsons = pm-procs-json (st.pm-processes) 0 (st.pm-count) []
      in json-list jsons 0 (list-length jsons) ""
    else if text-ends-with path "/stats" then
      "{\"count\":" & show (st.pm-count)
      & ",\"totalCpu\":" & show (st.pm-total-cpu)
      & ",\"totalMem\":" & show (st.pm-total-mem).bs-bytes
      & ",\"totalThreads\":" & show (st.pm-total-threads) & "}"
    else json-error "unknown process route"

  pm-procs-json : List ProcessEntry, Integer, Integer, List Text -> List Text
  pm-procs-json (procs) (i) (n) (acc) =
    if i >= n then acc
    else pm-procs-json procs (i + 1) n (list-push acc (process-to-json (list-at procs i)))

