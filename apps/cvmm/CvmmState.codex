    is ViewDashboard -> "Dashboard"
    is ViewFileExplorer -> "Files"
    is ViewDriveManager -> "Drives"
    is ViewUsbManager -> "USB"
    is ViewProcessManager -> "Processes"
    is ViewServiceManager -> "Services"
    is ViewPortMonitor -> "Ports"
    is ViewNetworkManager -> "Network"
    is ViewDisplayManager -> "Display"
    is ViewServerManager -> "Servers"
    is ViewFleetManager -> "Fleet"
    is ViewDeployManager -> "Deploy"
    is ViewLogViewer -> "Logs"
    is ViewTerminal -> "Terminal"
    is ViewMonitor -> "Monitor"
    is ViewMesh -> "Mesh"
    is ViewSettings -> "Settings"
    is ViewCalendar -> "Calendar"
    is ViewNotes -> "Notes"
    is ViewAudio -> "Audio"
    is ViewNotifications -> "Notifications"
    is ViewScreenSaver -> "Screen Saver"
    is ViewPower -> "Power"
    is ViewDateTime -> "Date & Time"
    is ViewBluetooth -> "Bluetooth"
    is ViewPrivacy -> "Privacy"
    is ViewDefaultApps -> "Default Apps"
    is ViewWallpaper -> "Wallpaper"
    is ViewKeyboardRgb -> "Keyboard"

