Section: View Dispatch

  settings-view-widget : Text -> WidgetNode
  settings-view-widget (view-id) =
    if view-id == "audio" then ac-mixer-widget audio-control-new
    else if view-id == "notifications" then nm-history-widget (notification-manager-new 1024 768)
    else if view-id == "screensaver" then ss-settings-widget screen-saver-new
    else if view-id == "power" then power-widget power-manager-new
    else if view-id == "datetime" then dt-settings-widget datetime-new
    else if view-id == "bluetooth" then bt-settings-widget bluetooth-new
    else if view-id == "privacy" then ps-settings-widget privacy-new
    else if view-id == "defaultapps" then da-settings-widget default-apps-new
    else if view-id == "wallpaper" then wp-settings-widget wallpaper-new
    else if view-id == "keyboard" then widget-label "kbd-rgb-view" (format-keyboard-rgb keyboard-rgb-new)
    else if view-id == "calendar" then cal-widget (calendar-app-new 2026 6 22)
    else widget-label "unknown-view" ("View: " & view-id)

  is-settings-view : Text -> Boolean
  is-settings-view (view-id) =
    if view-id == "audio" then True
    else if view-id == "notifications" then True
    else if view-id == "screensaver" then True
    else if view-id == "power" then True
    else if view-id == "datetime" then True
    else if view-id == "bluetooth" then True
    else if view-id == "privacy" then True
    else if view-id == "defaultapps" then True
    else if view-id == "wallpaper" then True
    else if view-id == "keyboard" then True
    else if view-id == "calendar" then True
    else if view-id == "notes" then True
    else False

