Chapter: FileLive
  cites Cvmm chapter FileExplorer
  cites Cvmm chapter CvmmTypes
  cites Foreword chapter Fat16

 The view of the FAT16 volume's root: its directories, then its files, as the
 volume lists them. The volume reports names only, so sizes read 0.

Section: Mapping

  fl-entries : List Text, Text, FileKind, Integer, Integer, List FileEntry -> List FileEntry
  fl-entries (names) (prefix) (kind) (i) (n) (acc) =
    if i >= n then acc
    else let nm = list-at names i
    in fl-entries names prefix kind (i + 1) n (list-push acc (file-entry-new nm (prefix & nm) kind 0))

  fe-from-listing : List Text, List Text -> ExplorerState
  fe-from-listing (dirs) (files) =
    let d = fl-entries dirs "/" FkDirectory 0 (list-length dirs) []
    in let all = fl-entries files "/" FkFile 0 (list-length files) d
    in explorer-navigate explorer-new "/" all

  fe-live : [Device.Block] ExplorerState
  fe-live = act
    dirs <- list-directories ""
    files <- list-files "" ""
    fe-from-listing dirs files
  end

