Chapter: TerminalLive
  cites Cvmm chapter Terminal
  cites Cvmm chapter NetworkManager
  cites Cvmm chapter UsbManager
  cites Cvmm chapter DisplayManager

 The terminal's boot banner, composed from the live views so that each line
 states what the machine reported: the bound NIC, the USB devices bound, and
 the display mode. A view that found nothing says so.

Section: Banner

  tl-nic-line : NetworkManagerState -> Text
  tl-nic-line (nm) =
    if nm.nm-nic-count == 0 then "NIC: none"
    else let n = list-at (nm.nm-nics) 0
    in "NIC: " & n.nic-name & " " & n.nic-mac

  tl-usb-line : UsbManagerState -> Text
  tl-usb-line (um) = "USB: " & show (um.um-device-count) & " devices on " & show (um.um-host-controllers) & " host controllers"

  tl-display-line : DisplayManagerState -> Text
  tl-display-line (dm) =
    if dm.disp-monitor-count == 0 then "Display: none"
    else let m = list-at (dm.disp-monitors) 0
    in "Display: " & show ((m.mon-resolution).res-width) & "x" & show ((m.mon-resolution).res-height)

  term-from-views : NetworkManagerState, UsbManagerState, DisplayManagerState -> TerminalState
  term-from-views (nm) (um) (dm) =
    let t1 = term-writeln (terminal-new 25 80) "Codex OS (bare-metal x86-64)"
    in let t2 = term-writeln t1 (tl-nic-line nm)
    in let t3 = term-writeln t2 (tl-usb-line um)
    in let t4 = term-writeln t3 (tl-display-line dm)
    in let t5 = term-writeln t4 ""
    in let t6 = term-writeln t5 "Type 'help' for available commands."
    in term-write t6 "codex> "

