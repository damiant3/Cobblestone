Chapter: LogViewer
  cites Cvmm chapter CvmmTypes
  cites UI chapter Widget
  cites UI chapter Layout
  cites Foreword chapter Maybe

 Unified system log viewer. Aggregates log lines from all services,
 kernel messages, driver events, and network activity into one
 timeline. Each line has a source, severity, timestamp, and message.
 Supports filtering by source, severity, and text search. Tail mode
 auto-scrolls to the latest entry. This is the first thing you open
 when something goes wrong.

Section: Log Types

  LogSeverity =
    | LogTrace
    | LogDebug
    | LogInfo
    | LogWarn
    | LogError
    | LogFatal

  log-severity-label : LogSeverity -> Text
  log-severity-label (s) = when s
    is LogTrace -> "TRACE"
    is LogDebug -> "DEBUG"
    is LogInfo -> "INFO"
    is LogWarn -> "WARN"
    is LogError -> "ERROR"
    is LogFatal -> "FATAL"

  log-severity-ordinal : LogSeverity -> Integer
  log-severity-ordinal (s) = when s
    is LogTrace -> 0
    is LogDebug -> 1
    is LogInfo -> 2
    is LogWarn -> 3
    is LogError -> 4
    is LogFatal -> 5

  LogSource =
    | SrcKernel
    | SrcScheduler
    | SrcNetwork
    | SrcUsb
    | SrcDisplay
    | SrcService (Text)
    | SrcApp (Text)

  log-source-label : LogSource -> Text
  log-source-label (s) = when s
    is SrcKernel -> "kernel"
    is SrcScheduler -> "scheduler"
    is SrcNetwork -> "network"
    is SrcUsb -> "usb"
    is SrcDisplay -> "display"
    is SrcService (name) -> "svc:" & name
    is SrcApp (name) -> "app:" & name

Section: Log Entry

  LogEntry = record {
    le-id : Integer,
    le-timestamp : Integer,
    le-source : LogSource,
    le-severity : LogSeverity,
    le-message : Text,
    le-details : Text
  }

  log-entry-new : Integer, Integer, LogSource, LogSeverity, Text -> LogEntry
  log-entry-new (id) (ts) (src) (sev) (msg) = LogEntry {
    le-id = id,
    le-timestamp = ts,
    le-source = src,
    le-severity = sev,
    le-message = msg,
    le-details = ""
  }

Section: Log Buffer

  LogBuffer = record {
    lb-entries : List LogEntry,
    lb-count : Integer,
    lb-max-entries : Integer,
    lb-next-id : Integer,
    lb-error-count : Integer,
    lb-warn-count : Integer
  }

  log-buffer-new : Integer -> LogBuffer
  log-buffer-new (max-size) = LogBuffer {
    lb-entries = [],
    lb-count = 0,
    lb-max-entries = max-size,
    lb-next-id = 1,
    lb-error-count = 0,
    lb-warn-count = 0
  }

  log-append : LogBuffer, Integer, LogSource, LogSeverity, Text -> LogBuffer
  log-append (buf) (ts) (src) (sev) (msg) =
    let entry = log-entry-new (buf.lb-next-id) ts src sev msg
    in let new-entries = if buf.lb-count >= buf.lb-max-entries then
      list-push (log-drop-oldest (buf.lb-entries) (buf.lb-count)) entry
    else list-push (buf.lb-entries) entry
    in let new-count = if buf.lb-count >= buf.lb-max-entries then buf.lb-count else buf.lb-count + 1
    in let err-delta = if log-severity-ordinal sev >= 4 then 1 else 0
    in let warn-delta = if log-severity-ordinal sev == 3 then 1 else 0
    in LogBuffer {
      lb-entries = new-entries,
      lb-count = new-count,
      lb-max-entries = buf.lb-max-entries,
      lb-next-id = buf.lb-next-id + 1,
      lb-error-count = buf.lb-error-count + err-delta,
      lb-warn-count = buf.lb-warn-count + warn-delta
    }

  log-drop-oldest : List LogEntry, Integer -> List LogEntry
  log-drop-oldest (entries) (count) =
    if count <= 1 then []
    else log-drop-loop entries 1 count []

  log-drop-loop : List LogEntry, Integer, Integer, List LogEntry -> List LogEntry
  log-drop-loop (entries) (i) (n) (acc) =
    if i >= n then acc
    else log-drop-loop entries (i + 1) n (list-push acc (list-at entries i))

Section: Log Viewer State

  LogViewerState = record {
    lv-buffer : LogBuffer,
    lv-filter-text : Text,
    lv-filter-severity : Integer,
    lv-filter-source : Text,
    lv-tail-mode : Boolean,
    lv-selected-id : Integer,
    lv-paused : Boolean
  }

  log-viewer-new : LogViewerState
  log-viewer-new = LogViewerState {
    lv-buffer = log-buffer-new 1000,
    lv-filter-text = "",
    lv-filter-severity = 0,
    lv-filter-source = "",
    lv-tail-mode = True,
    lv-selected-id = -1,
    lv-paused = False
  }

Section: Actions

  lv-append : LogViewerState, Integer, LogSource, LogSeverity, Text -> LogViewerState
  lv-append (st) (ts) (src) (sev) (msg) =
    if st.lv-paused then st
    else __record-set st "lv-buffer" (log-append (st.lv-buffer) ts src sev msg)

  lv-set-filter-text : LogViewerState, Text -> LogViewerState
  lv-set-filter-text (st) (f) = __record-set st "lv-filter-text" f

  lv-set-filter-severity : LogViewerState, Integer -> LogViewerState
  lv-set-filter-severity (st) (min-sev) = __record-set st "lv-filter-severity" min-sev

  lv-set-filter-source : LogViewerState, Text -> LogViewerState
  lv-set-filter-source (st) (src) = __record-set st "lv-filter-source" src

  lv-toggle-tail : LogViewerState -> LogViewerState
  lv-toggle-tail (st) = __record-set st "lv-tail-mode" (if st.lv-tail-mode then False else True)

  lv-toggle-pause : LogViewerState -> LogViewerState
  lv-toggle-pause (st) = __record-set st "lv-paused" (if st.lv-paused then False else True)

  lv-select : LogViewerState, Integer -> LogViewerState
  lv-select (st) (id) = __record-set st "lv-selected-id" id

  lv-clear : LogViewerState -> LogViewerState
  lv-clear (st) = __record-set st "lv-buffer" (log-buffer-new ((st.lv-buffer).lb-max-entries))

Section: Filtering

  lv-visible-entries : LogViewerState -> List LogEntry
  lv-visible-entries (st) =
    lv-filter-loop (st.lv-buffer).lb-entries (st.lv-filter-text) (st.lv-filter-severity) (st.lv-filter-source) 0 (st.lv-buffer).lb-count []

  lv-filter-loop : List LogEntry, Text, Integer, Text, Integer, Integer, List LogEntry -> List LogEntry
  lv-filter-loop (entries) (text-filter) (min-sev) (src-filter) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in let sev-ok = log-severity-ordinal (e.le-severity) >= min-sev
    in let text-ok = if text-length text-filter == 0 then True else text-contains (e.le-message) text-filter
    in let src-ok = if text-length src-filter == 0 then True else log-source-label (e.le-source) == src-filter
    in if sev-ok then if text-ok then if src-ok then
      lv-filter-loop entries text-filter min-sev src-filter (i + 1) n (list-push acc e)
    else lv-filter-loop entries text-filter min-sev src-filter (i + 1) n acc
    else lv-filter-loop entries text-filter min-sev src-filter (i + 1) n acc
    else lv-filter-loop entries text-filter min-sev src-filter (i + 1) n acc

Section: Widget Building

  lv-entry-row : LogEntry -> WidgetNode
  lv-entry-row (e) =
    let ts-label = widget-label ("log-ts-" & show (e.le-id)) (show (e.le-timestamp))
    in let sev-label = widget-label ("log-sev-" & show (e.le-id)) (log-severity-label (e.le-severity))
    in let src-label = widget-label ("log-src-" & show (e.le-id)) (log-source-label (e.le-source))
    in let msg-label = widget-label ("log-msg-" & show (e.le-id)) (e.le-message)
    in let state = if log-severity-ordinal (e.le-severity) >= 4 then 2
      else if log-severity-ordinal (e.le-severity) >= 3 then 1
      else 0
    in let row = widget-panel ("log-" & show (e.le-id)) DirRow 8 [ts-label, sev-label, src-label, msg-label]
    in widget-set-state row state

  lv-widget : LogViewerState -> WidgetNode
  lv-widget (st) =
    let buf = st.lv-buffer
    in let title = widget-label "lv-title" "System Log"
    in let summary = widget-label "lv-summary" (show (buf.lb-count) & " entries, " & show (buf.lb-error-count) & " errors, " & show (buf.lb-warn-count) & " warnings")
    in let filter-input = widget-input "lv-filter" (st.lv-filter-text) (text-length (st.lv-filter-text))
    in let sev-btns = widget-toolbar "lv-sev" [
      widget-button "lv-all" "All",
      widget-button "lv-info" "Info+",
      widget-button "lv-warn" "Warn+",
      widget-button "lv-error" "Error+"
    ]
    in let tail-btn = widget-button "lv-tail" (if st.lv-tail-mode then "Tail: ON" else "Tail: OFF")
    in let pause-btn = widget-button "lv-pause" (if st.lv-paused then "Resume" else "Pause")
    in let clear-btn = widget-button "lv-clear" "Clear"
    in let toolbar = widget-toolbar "lv-toolbar" [filter-input, tail-btn, pause-btn, clear-btn]
    in let visible = lv-visible-entries st
    in let rows = lv-rows visible 0 (list-length visible) []
    in widget-panel "log-viewer" DirColumn 4 ([title, summary, sev-btns, toolbar] & rows)

  lv-rows : List LogEntry, Integer, Integer, List WidgetNode -> List WidgetNode
  lv-rows (entries) (i) (n) (acc) =
    if i >= n then acc
    else lv-rows entries (i + 1) n (list-push acc (lv-entry-row (list-at entries i)))

Section: JSON

  log-entry-to-json : LogEntry -> Text
  log-entry-to-json (e) =
    "{\"id\":" & show (e.le-id)
    & ",\"timestamp\":" & show (e.le-timestamp)
    & ",\"source\":\"" & log-source-label (e.le-source)
    & "\",\"severity\":\"" & log-severity-label (e.le-severity)
    & "\",\"message\":\"" & e.le-message & "\"}"

  log-entries-to-json : List LogEntry, Integer, Integer, Text -> Text
  log-entries-to-json (entries) (i) (n) (acc) =
    if i >= n then "[" & acc & "]"
    else let sep = if i == 0 then "" else ","
    in log-entries-to-json entries (i + 1) n (acc & sep & log-entry-to-json (list-at entries i))

  log-buffer-summary-json : LogBuffer -> Text
  log-buffer-summary-json (buf) =
    "{\"count\":" & show (buf.lb-count)
    & ",\"errors\":" & show (buf.lb-error-count)
    & ",\"warnings\":" & show (buf.lb-warn-count)
    & ",\"maxEntries\":" & show (buf.lb-max-entries) & "}"

