Chapter: DataProviders
  cites Cvmm chapter CvmmTypes
  cites Cvmm chapter ResourceModel
  cites Cvmm chapter SyncProvider

 Domain-specific data providers and search connectors for each
 productivity app. Each section configures providers with the right
 endpoints, field mappings, and search parameters. This is the
 catalog of external data sources the productivity suite can talk to.

Section: Calendar Providers

  caldav-provider : Text, Text -> Provider
  caldav-provider (name) (url) =
    prov-set-direction (provider-new ("cal-" & name) name PkCalDav url) SyncBidirectional

  google-calendar-provider : Provider
  google-calendar-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "gcal" "Google Calendar" PkGoogle "https://www.googleapis.com/calendar/v3")
      (AuthOAuth2 "" "")) SyncBidirectional) 300

  microsoft-calendar-provider : Provider
  microsoft-calendar-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "mscal" "Outlook Calendar" PkMicrosoft "https://graph.microsoft.com/v1.0/me/calendar")
      (AuthOAuth2 "" "")) SyncBidirectional) 300

  apple-calendar-provider : Provider
  apple-calendar-provider =
    prov-set-direction (provider-new "apcal" "Apple Calendar" PkApple "https://caldav.icloud.com") SyncBidirectional

  cal-import-mapping : ImportMapping
  cal-import-mapping =
    let m = import-mapping-new "calendar-events" "gcal" "events"
    in let m1 = im-add-field m "summary" "title"
    in let m2 = im-add-field m1 "description" "description"
    in let m3 = im-add-field m2 "start.dateTime" "start-time"
    in let m4 = im-add-field m3 "end.dateTime" "end-time"
    in let m5 = im-add-field m4 "location" "location"
    in m5

Section: Contact Providers

  carddav-provider : Text, Text -> Provider
  carddav-provider (name) (url) =
    prov-set-direction (provider-new ("card-" & name) name PkCardDav url) SyncBidirectional

  google-contacts-provider : Provider
  google-contacts-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "gcontacts" "Google Contacts" PkGoogle "https://people.googleapis.com/v1")
      (AuthOAuth2 "" "")) SyncBidirectional) 600

  microsoft-contacts-provider : Provider
  microsoft-contacts-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "mscontacts" "Outlook Contacts" PkMicrosoft "https://graph.microsoft.com/v1.0/me/contacts")
      (AuthOAuth2 "" "")) SyncBidirectional) 600

  vcard-import-mapping : ImportMapping
  vcard-import-mapping =
    let m = import-mapping-new "vcard-contacts" "carddav" "contacts"
    in let m1 = im-add-field m "fn" "first-name"
    in let m2 = im-add-field m1 "n.family" "last-name"
    in let m3 = im-add-field m2 "email.value" "email"
    in let m4 = im-add-field m3 "tel.value" "phone"
    in let m5 = im-add-field m4 "adr.street" "address"
    in let m6 = im-add-field m5 "adr.locality" "city"
    in let m7 = im-add-field m6 "adr.region" "state"
    in let m8 = im-add-field m7 "adr.postal" "zip"
    in let m9 = im-add-field m8 "org" "company"
    in m9

Section: Plant Database Providers

  plant-db-provider : Provider
  plant-db-provider =
    provider-new "plantdb" "Plant Database" PkPlantDb "https://trefle.io/api/v1"

  usda-plants-provider : Provider
  usda-plants-provider =
    provider-new "usda" "USDA Plants" PkPlantDb "https://plantsdb.xyz/api"

  plant-search-categories : List Text
  plant-search-categories = [
    "Vegetables", "Fruits", "Herbs", "Flowers", "Trees",
    "Shrubs", "Succulents", "Grasses", "Vines", "Houseplants"
  ]

  plant-import-mapping : ImportMapping
  plant-import-mapping =
    let m = import-mapping-new "plant-lookup" "plantdb" "plants"
    in let m1 = im-add-field m "common_name" "name"
    in let m2 = im-add-field m1 "scientific_name" "variety"
    in let m3 = im-add-field m2 "light" "sun-needs"
    in let m4 = im-add-field m3 "watering" "water-days"
    in m4

Section: Auto Maintenance Providers

  auto-service-db-provider : Provider
  auto-service-db-provider =
    provider-new "autodb" "Service Schedule DB" PkAutoDb "https://api.carmd.com/v3.0"

  nhtsa-provider : Provider
  nhtsa-provider =
    provider-new "nhtsa" "NHTSA Recalls" PkAutoDb "https://api.nhtsa.gov/recalls"

  obd-provider : Provider
  obd-provider =
    provider-new "obd" "OBD-II Scanner" PkCustom "obd" "local://obd2"

  auto-service-intervals : List Text
  auto-service-intervals = [
    "Oil Change 5000mi/6mo",
    "Tire Rotation 7500mi/6mo",
    "Brake Inspection 15000mi/12mo",
    "Transmission Fluid 60000mi/48mo",
    "Coolant Flush 30000mi/24mo",
    "Air Filter 15000mi/12mo",
    "Spark Plugs 60000mi/48mo",
    "Timing Belt 60000mi/48mo",
    "Battery 50000mi/36mo",
    "Wiper Blades 12000mi/12mo"
  ]

  vin-decode-mapping : ImportMapping
  vin-decode-mapping =
    let m = import-mapping-new "vin-decode" "autodb" "vehicles"
    in let m1 = im-add-field m "make" "make"
    in let m2 = im-add-field m1 "model" "model"
    in let m3 = im-add-field m2 "year" "year"
    in m3

Section: Recipe Providers

  recipe-db-provider : Provider
  recipe-db-provider =
    provider-new "recipedb" "Recipe Database" PkRecipeDb "https://api.edamam.com/api/recipes/v2"

  spoonacular-provider : Provider
  spoonacular-provider =
    prov-set-auth (provider-new "spoon" "Spoonacular" PkRecipeDb "https://api.spoonacular.com") (AuthApiKey "")

  recipe-search-categories : List Text
  recipe-search-categories = [
    "Breakfast", "Lunch", "Dinner", "Dessert", "Snack",
    "Appetizer", "Side Dish", "Soup", "Salad", "Beverage",
    "Bread", "Sauce", "Marinade", "Smoothie"
  ]

  recipe-cuisines : List Text
  recipe-cuisines = [
    "American", "Italian", "Mexican", "Chinese", "Japanese",
    "Indian", "Thai", "French", "Mediterranean", "Korean",
    "Vietnamese", "Greek", "Middle Eastern", "Ethiopian", "Caribbean"
  ]

  recipe-diets : List Text
  recipe-diets = [
    "Vegetarian", "Vegan", "Gluten-Free", "Dairy-Free",
    "Keto", "Paleo", "Low-Carb", "Whole30", "Pescatarian"
  ]

  recipe-import-mapping : ImportMapping
  recipe-import-mapping =
    let m = import-mapping-new "recipe-import" "recipedb" "recipes"
    in let m1 = im-add-field m "label" "title"
    in let m2 = im-add-field m1 "cuisineType" "cuisine"
    in let m3 = im-add-field m2 "mealType" "category"
    in let m4 = im-add-field m3 "totalTime" "cook-minutes"
    in let m5 = im-add-field m4 "yield" "servings"
    in m5

Section: Book / ISBN Providers

  isbn-provider : Provider
  isbn-provider =
    provider-new "isbn" "ISBN Lookup" PkIsbn "https://openlibrary.org/api"

  google-books-provider : Provider
  google-books-provider =
    provider-new "gbooks" "Google Books" PkIsbn "https://www.googleapis.com/books/v1"

  goodreads-provider : Provider
  goodreads-provider =
    provider-new "goodreads" "Goodreads" PkCustom "goodreads" "https://www.goodreads.com/search"

  book-search-genres : List Text
  book-search-genres = [
    "Fiction", "Non-Fiction", "Science Fiction", "Fantasy", "Mystery",
    "Thriller", "Romance", "Horror", "Biography", "Memoir",
    "History", "Science", "Philosophy", "Psychology", "Self-Help",
    "Business", "Poetry", "Graphic Novel", "Young Adult", "Children"
  ]

  book-import-mapping : ImportMapping
  book-import-mapping =
    let m = import-mapping-new "book-isbn" "isbn" "books"
    in let m1 = im-add-field m "title" "title"
    in let m2 = im-add-field m1 "authors.0" "author"
    in let m3 = im-add-field m2 "isbn_13" "isbn"
    in let m4 = im-add-field m3 "number_of_pages" "pages"
    in let m5 = im-add-field m4 "subjects.0" "genre"
    in m5

Section: Fitness Providers

  strava-provider : Provider
  strava-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "strava" "Strava" PkFitness "https://www.strava.com/api/v3")
      (AuthOAuth2 "" "")) SyncPull) 900

  fitbit-provider : Provider
  fitbit-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "fitbit" "Fitbit" PkFitness "https://api.fitbit.com/1")
      (AuthOAuth2 "" "")) SyncPull) 900

  garmin-provider : Provider
  garmin-provider =
    prov-set-direction (prov-set-auth
      (provider-new "garmin" "Garmin Connect" PkFitness "https://connect.garmin.com/proxy")
      (AuthOAuth2 "" "")) SyncPull

  apple-health-provider : Provider
  apple-health-provider =
    prov-set-direction (provider-new "ahealth" "Apple Health" PkFitness "local://healthkit") SyncPull

  workout-import-mapping : ImportMapping
  workout-import-mapping =
    let m = import-mapping-new "strava-workouts" "strava" "workouts"
    in let m1 = im-add-field m "name" "title"
    in let m2 = im-add-field m1 "type" "type"
    in let m3 = im-add-field m2 "moving_time" "duration-minutes"
    in let m4 = im-add-field m3 "distance" "distance-meters"
    in let m5 = im-add-field m4 "calories" "calories"
    in m5

Section: Weather Provider

  weather-provider : Provider
  weather-provider =
    prov-set-auto-sync (provider-new "weather" "Weather" PkWeather "https://api.open-meteo.com/v1") 1800

Section: Budget Providers

  plaid-provider : Provider
  plaid-provider =
    prov-set-auto-sync (prov-set-direction (prov-set-auth
      (provider-new "plaid" "Plaid" PkRest "https://api.plaid.com" "https://api.plaid.com")
      (AuthToken "")) SyncPull) 3600

  csv-import-provider : Provider
  csv-import-provider =
    provider-new "csv" "CSV Import" (PkCustom "csv") "local://csv"

Section: Default Provider Sets

  default-calendar-providers : List Provider
  default-calendar-providers = [
    google-calendar-provider,
    microsoft-calendar-provider,
    apple-calendar-provider
  ]

  default-contact-providers : List Provider
  default-contact-providers = [
    google-contacts-provider,
    microsoft-contacts-provider
  ]

  default-plant-providers : List Provider
  default-plant-providers = [
    plant-db-provider,
    usda-plants-provider,
    weather-provider
  ]

  default-auto-providers : List Provider
  default-auto-providers = [
    auto-service-db-provider,
    nhtsa-provider,
    obd-provider
  ]

  default-recipe-providers : List Provider
  default-recipe-providers = [
    recipe-db-provider,
    spoonacular-provider
  ]

  default-book-providers : List Provider
  default-book-providers = [
    isbn-provider,
    google-books-provider,
    goodreads-provider
  ]

  default-fitness-providers : List Provider
  default-fitness-providers = [
    strava-provider,
    fitbit-provider,
    garmin-provider,
    apple-health-provider
  ]

  default-budget-providers : List Provider
  default-budget-providers = [
    plaid-provider,
    csv-import-provider
  ]

Section: All Providers

  all-default-providers : ProviderRegistry
  all-default-providers =
    let reg = provider-registry-new
    in let r1 = pr-add (pr-add (pr-add reg google-calendar-provider) microsoft-calendar-provider) apple-calendar-provider
    in let r2 = pr-add (pr-add r1 google-contacts-provider) microsoft-contacts-provider
    in let r3 = pr-add (pr-add r2 plant-db-provider) usda-plants-provider
    in let r4 = pr-add (pr-add (pr-add r3 auto-service-db-provider) nhtsa-provider) obd-provider
    in let r5 = pr-add (pr-add r4 recipe-db-provider) spoonacular-provider
    in let r6 = pr-add (pr-add (pr-add r5 isbn-provider) google-books-provider) goodreads-provider
    in let r7 = pr-add (pr-add (pr-add (pr-add r6 strava-provider) fitbit-provider) garmin-provider) apple-health-provider
    in let r8 = pr-add r7 weather-provider
    in let r9 = pr-add (pr-add r8 plaid-provider) csv-import-provider
    in r9

  all-import-mappings : List ImportMapping
  all-import-mappings = [
    cal-import-mapping,
    vcard-import-mapping,
    plant-import-mapping,
    vin-decode-mapping,
    recipe-import-mapping,
    book-import-mapping,
    workout-import-mapping
  ]

