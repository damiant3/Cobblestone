Section: Budget

  budget-cat-to-jv : BudgetCategory -> JsonValue
  budget-cat-to-jv (c) = json-object [
    json-pair "id" (json-int c.bc-id),
    json-pair "name" (json-str c.bc-name),
    json-pair "parent" (json-int c.bc-parent-id),
    json-pair "budget" (json-int c.bc-budget-cents),
    json-pair "spent" (json-int c.bc-spent-cents),
    json-pair "color" (json-str c.bc-color),
    json-pair "income" (json-bool c.bc-is-income)
  ]

  budget-txn-to-jv : BudgetTransaction -> JsonValue
  budget-txn-to-jv (t) = json-object [
    json-pair "id" (json-int t.bt-id),
    json-pair "date" (json-int t.bt-date),
    json-pair "desc" (json-str t.bt-description),
    json-pair "amt" (json-int t.bt-amount-cents),
    json-pair "catId" (json-int t.bt-category-id),
    json-pair "catName" (json-str t.bt-category-name),
    json-pair "acct" (json-str t.bt-account),
    json-pair "notes" (json-str t.bt-notes),
    json-pair "income" (json-bool t.bt-is-income)
  ]

  budget-cat-from-jv : JsonValue -> BudgetCategory
  budget-cat-from-jv (jv) = BudgetCategory {
    bc-id = json-get-int jv "id" 0,
    bc-name = json-get-str jv "name" "",
    bc-parent-id = json-get-int jv "parent" 0,
    bc-budget-cents = json-get-int jv "budget" 0,
    bc-spent-cents = json-get-int jv "spent" 0,
    bc-color = json-get-str jv "color" "#888",
    bc-is-income = json-get-bool jv "income" False
  }

  budget-txn-from-jv : JsonValue -> BudgetTransaction
  budget-txn-from-jv (jv) = BudgetTransaction {
    bt-id = json-get-int jv "id" 0,
    bt-date = json-get-int jv "date" 0,
    bt-description = json-get-str jv "desc" "",
    bt-amount-cents = json-get-int jv "amt" 0,
    bt-category-id = json-get-int jv "catId" 0,
    bt-category-name = json-get-str jv "catName" "",
    bt-account = json-get-str jv "acct" "default",
    bt-notes = json-get-str jv "notes" "",
    bt-is-income = json-get-bool jv "income" False
  }

  budget-save : DiskFactStore, List BudgetCategory, List BudgetTransaction, Integer -> DiskFactStore
  budget-save (store) (cats) (txns) (ts) =
    let j = json-emit (json-object [
      json-pair "cats" (json-array (list-map budget-cat-to-jv cats)),
      json-pair "txns" (json-array (list-map budget-txn-to-jv txns))
    ])
    in app-log-info (app-write-and-checkpoint store pk-budget j ts) "budget" "Budget saved" ts

  budget-load-cats : DiskFactStore -> List BudgetCategory
  budget-load-cats (store) =
    let found = app-scan-last store pk-budget
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "cats" budget-cat-from-jv

  budget-load-txns : DiskFactStore -> List BudgetTransaction
  budget-load-txns (store) =
    let found = app-scan-last store pk-budget
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "txns" budget-txn-from-jv

