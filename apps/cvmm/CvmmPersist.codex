    ti-title = json-get-str jv "title" "",
    ti-description = json-get-str jv "desc" "",
    ti-list = json-get-str jv "list" "Inbox",
    ti-completed = json-get-bool jv "done" False,
    ti-priority = int-to-pri (json-get-int jv "pri" 3),
    ti-due = json-get-int jv "due" 0,
