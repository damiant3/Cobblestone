Section: JSON Array Parse Helpers

  parse-jv-array : Text, (JsonValue -> a) -> List a
  parse-jv-array (txt) (convert) =
    let parsed = json-parse txt
    in when parsed
      is Nothing -> []
      is Just (arr) -> parse-jv-items arr convert 0

  parse-jv-items : JsonValue, (JsonValue -> a), Integer -> List a
  parse-jv-items (arr) (convert) (i) =
    let item = json-array-at arr i
    in when item
      is Nothing -> []
      is Just (jv) -> convert jv :: parse-jv-items arr convert (i + 1)

  parse-jv-sub : JsonValue, Text, (JsonValue -> a) -> List a
  parse-jv-sub (parent) (key) (convert) =
    let sub = json-get parent key
    in when sub
      is Nothing -> []
      is Just (arr) -> parse-jv-items arr convert 0
