  car-save : DiskFactStore, List Vehicle, List MaintRecord, List FuelRecord, Integer -> DiskFactStore
  car-save (store) (vehicles) (maint) (fuel) (ts) =
    let j = json-emit (json-object [
      json-pair "v" (json-array (list-map vehicle-to-jv vehicles)),
      json-pair "m" (json-array (list-map maint-to-jv maint)),
      json-pair "f" (json-array (list-map fuel-to-jv fuel))
    ])
    in app-log-info (app-write-and-checkpoint store pk-car j ts) "car" "Maintenance log saved" ts

  car-load-vehicles : DiskFactStore -> List Vehicle
  car-load-vehicles (store) =
    let found = app-scan-last store pk-car
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "v" vehicle-from-jv

  car-load-maint : DiskFactStore -> List MaintRecord
  car-load-maint (store) =
    let found = app-scan-last store pk-car
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "m" maint-from-jv

  car-load-fuel : DiskFactStore -> List FuelRecord
  car-load-fuel (store) =
    let found = app-scan-last store pk-car
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "f" fuel-from-jv

Section: Fitness

  workout-to-jv : Workout -> JsonValue
  workout-to-jv (w) = json-object [
    json-pair "id" (json-int w.wo-id),
    json-pair "date" (json-int w.wo-date),
    json-pair "type" (json-str (wt-label w.wo-type)),
    json-pair "title" (json-str w.wo-title),
    json-pair "dur" (json-int w.wo-duration-min),
    json-pair "cal" (json-int w.wo-calories),
    json-pair "dist" (json-int w.wo-distance-m),
    json-pair "notes" (json-str w.wo-notes),
    json-pair "rating" (json-int w.wo-rating)
  ]

  bodylog-to-jv : BodyLog -> JsonValue
  bodylog-to-jv (b) = json-object [
    json-pair "id" (json-int b.bl-id),
    json-pair "date" (json-int b.bl-date),
    json-pair "wt" (json-int b.bl-weight-g),
    json-pair "fat" (json-int b.bl-fat-pct-x10),
    json-pair "hr" (json-int b.bl-resting-hr),
    json-pair "sys" (json-int b.bl-bp-sys),
    json-pair "dia" (json-int b.bl-bp-dia),
    json-pair "sleep" (json-int b.bl-sleep-min),
    json-pair "steps" (json-int b.bl-steps),
    json-pair "water" (json-int b.bl-water-ml),
    json-pair "notes" (json-str b.bl-notes)
  ]

  label-to-wt : Text -> WorkoutType
  label-to-wt (s) =
    if s == "Run" then WtRun
    else if s == "Bike" then WtBike
    else if s == "Swim" then WtSwim
    else if s == "Lift" then WtLift
    else if s == "Walk" then WtWalk
    else if s == "Yoga" then WtYoga
    else if s == "HIIT" then WtHiit
    else if s == "Stretch" then WtStretch
    else if s == "Hike" then WtHike
    else WtOther s

  workout-from-jv : JsonValue -> Workout
  workout-from-jv (jv) = Workout {
    wo-id = json-get-int jv "id" 0,
    wo-date = json-get-int jv "date" 0,
    wo-type = label-to-wt (json-get-str jv "type" "Other"),
    wo-title = json-get-str jv "title" "",
    wo-duration-min = json-get-int jv "dur" 0,
    wo-calories = json-get-int jv "cal" 0,
    wo-distance-m = json-get-int jv "dist" 0,
    wo-notes = json-get-str jv "notes" "",
    wo-rating = json-get-int jv "rating" 0
  }

  bodylog-from-jv : JsonValue -> BodyLog
  bodylog-from-jv (jv) = BodyLog {
    bl-id = json-get-int jv "id" 0,
    bl-date = json-get-int jv "date" 0,
    bl-weight-g = json-get-int jv "wt" 0,
    bl-fat-pct-x10 = json-get-int jv "fat" 0,
    bl-resting-hr = json-get-int jv "hr" 0,
    bl-bp-sys = json-get-int jv "sys" 0,
    bl-bp-dia = json-get-int jv "dia" 0,
    bl-sleep-min = json-get-int jv "sleep" 0,
    bl-steps = json-get-int jv "steps" 0,
    bl-water-ml = json-get-int jv "water" 0,
    bl-notes = json-get-str jv "notes" ""
  }

  fitness-save : DiskFactStore, List Workout, List BodyLog, Integer -> DiskFactStore
  fitness-save (store) (workouts) (logs) (ts) =
    let j = json-emit (json-object [
      json-pair "w" (json-array (list-map workout-to-jv workouts)),
      json-pair "b" (json-array (list-map bodylog-to-jv logs))
    ])
    in app-log-info (app-write-and-checkpoint store pk-fitness j ts) "fitness" "Fitness data saved" ts

  fitness-load-workouts : DiskFactStore -> List Workout
  fitness-load-workouts (store) =
    let found = app-scan-last store pk-fitness
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "w" workout-from-jv

  fitness-load-body : DiskFactStore -> List BodyLog
  fitness-load-body (store) =
    let found = app-scan-last store pk-fitness
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "b" bodylog-from-jv

Section: Garden

  plant-to-jv : Plant -> JsonValue
  plant-to-jv (p) = json-object [
    json-pair "id" (json-int p.pl-id),
    json-pair "name" (json-str p.pl-name),
    json-pair "var" (json-str p.pl-variety),
    json-pair "loc" (json-str p.pl-location),
    json-pair "planted" (json-int p.pl-planted),
    json-pair "waterDays" (json-int p.pl-water-days),
    json-pair "sun" (json-str p.pl-sun),
    json-pair "notes" (json-str p.pl-notes),
    json-pair "alive" (json-bool p.pl-alive),
    json-pair "lastWater" (json-int p.pl-last-watered),
    json-pair "lastAction" (json-str p.pl-last-action),
    json-pair "logCount" (json-int p.pl-log-count)
  ]

  garden-log-to-jv : GardenLogEntry -> JsonValue
  garden-log-to-jv (g) = json-object [
    json-pair "pid" (json-int g.gl-plant-id),
    json-pair "date" (json-int g.gl-date),
    json-pair "action" (json-str (ga-label g.gl-action)),
    json-pair "notes" (json-str g.gl-notes)
  ]

  plant-from-jv : JsonValue -> Plant
  plant-from-jv (jv) = Plant {
    pl-id = json-get-int jv "id" 0,
    pl-name = json-get-str jv "name" "",
    pl-variety = json-get-str jv "var" "",
    pl-location = json-get-str jv "loc" "",
    pl-planted = json-get-int jv "planted" 0,
    pl-water-days = json-get-int jv "waterDays" 7,
    pl-sun = json-get-str jv "sun" "Full Sun",
    pl-notes = json-get-str jv "notes" "",
    pl-alive = json-get-bool jv "alive" True,
    pl-last-watered = json-get-int jv "lastWater" 0,
    pl-last-action = json-get-str jv "lastAction" "",
    pl-log-count = json-get-int jv "logCount" 0
  }

  garden-log-from-jv : JsonValue -> GardenLogEntry
  garden-log-from-jv (jv) = GardenLogEntry {
    gl-plant-id = json-get-int jv "pid" 0,
    gl-date = json-get-int jv "date" 0,
    gl-action = label-to-ga (json-get-str jv "action" "Water"),
    gl-notes = json-get-str jv "notes" ""
  }

  label-to-ga : Text -> GardenAction
  label-to-ga (s) =
    if s == "Water" then GaWater
    else if s == "Fertilize" then GaFertilize
    else if s == "Prune" then GaPrune
    else if s == "Harvest" then GaHarvest
    else if s == "Repot" then GaRepot
    else if s == "Weed" then GaWeedControl
    else if s == "Pest Control" then GaPestControl
    else GaObservation

  garden-save : DiskFactStore, List Plant, List GardenLogEntry, Integer -> DiskFactStore
  garden-save (store) (plants) (logs) (ts) =
    let j = json-emit (json-object [
      json-pair "p" (json-array (list-map plant-to-jv plants)),
      json-pair "l" (json-array (list-map garden-log-to-jv logs))
    ])
    in app-log-info (app-write-and-checkpoint store pk-garden j ts) "garden" "Garden data saved" ts

  garden-load-plants : DiskFactStore -> List Plant
  garden-load-plants (store) =
    let found = app-scan-last store pk-garden
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "p" plant-from-jv

  garden-load-logs : DiskFactStore -> List GardenLogEntry
  garden-load-logs (store) =
    let found = app-scan-last store pk-garden
    in when found
      is Nothing -> []
      is Just (txt) -> let parsed = json-parse txt
        in when parsed
          is Nothing -> []
          is Just (jv) -> parse-jv-sub jv "l" garden-log-from-jv

Section: Home Projects

  project-to-jv : HomeProject -> JsonValue
  project-to-jv (p) = json-object [
    json-pair "id" (json-int p.hp-id),
    json-pair "title" (json-str p.hp-title),
    json-pair "desc" (json-str p.hp-description),
    json-pair "room" (json-str p.hp-room),
    json-pair "cat" (json-str (pj-cat-label p.hp-category)),
    json-pair "status" (json-str (pj-status-label p.hp-status)),
    json-pair "pri" (json-int p.hp-priority),
    json-pair "budget" (json-int p.hp-budget-cents),
    json-pair "spent" (json-int p.hp-spent-cents),
    json-pair "start" (json-int p.hp-start-date),
    json-pair "end" (json-int p.hp-end-date),
    json-pair "created" (json-int p.hp-created),
    json-pair "mats" (json-array (list-map material-to-jv p.hp-materials))
  ]

  material-to-jv : Material -> JsonValue
  material-to-jv (m) = json-object [
    json-pair "name" (json-str m.mat-name),
    json-pair "qty" (json-int m.mat-quantity),
    json-pair "cost" (json-int m.mat-cost-cents),
    json-pair "bought" (json-bool m.mat-purchased),
    json-pair "store" (json-str m.mat-store)
  ]

  label-to-pj-cat : Text -> ProjectCategory
  label-to-pj-cat (s) =
    if s == "Repair" then PjRepair
    else if s == "Renovation" then PjRenovation
    else if s == "Landscaping" then PjLandscaping
    else if s == "Cleaning" then PjCleaning
    else if s == "Organization" then PjOrganization
    else if s == "Decor" then PjDecor
    else PjMaintenance

  label-to-pj-status : Text -> ProjectStatus
  label-to-pj-status (s) =
    if s == "Planning" then PjPlanning
    else if s == "In Progress" then PjInProgress
    else if s == "On Hold" then PjOnHold
    else if s == "Complete" then PjComplete
    else PjCancelled

  project-from-jv : JsonValue -> HomeProject
  project-from-jv (jv) = HomeProject {
    hp-id = json-get-int jv "id" 0,
    hp-title = json-get-str jv "title" "",
    hp-description = json-get-str jv "desc" "",
    hp-room = json-get-str jv "room" "",
    hp-category = label-to-pj-cat (json-get-str jv "cat" "Repair"),
    hp-status = label-to-pj-status (json-get-str jv "status" "Planning"),
    hp-priority = json-get-int jv "pri" 3,
    hp-budget-cents = json-get-int jv "budget" 0,
    hp-spent-cents = json-get-int jv "spent" 0,
    hp-start-date = json-get-int jv "start" 0,
    hp-end-date = json-get-int jv "end" 0,
    hp-created = json-get-int jv "created" 0,
    hp-materials = parse-jv-sub jv "mats" material-from-jv
  }

  material-from-jv : JsonValue -> Material
  material-from-jv (jv) = Material {
    mat-name = json-get-str jv "name" "",
    mat-quantity = json-get-int jv "qty" 1,
    mat-cost-cents = json-get-int jv "cost" 0,
    mat-purchased = json-get-bool jv "bought" False,
    mat-store = json-get-str jv "store" ""
  }

  home-save : DiskFactStore, List HomeProject, Integer -> DiskFactStore
  home-save (store) (projects) (ts) =
    let j = json-emit (json-array (list-map project-to-jv projects))
    in app-log-info (app-write-and-checkpoint store pk-home j ts) "home" ("Saved " & show (list-length projects) & " projects") ts

  home-load : DiskFactStore -> List HomeProject
  home-load (store) =
    let found = app-scan-last store pk-home
    in when found
      is Nothing -> []
      is Just (txt) -> parse-jv-array txt project-from-jv

Section: Reading List

  book-to-jv : Book -> JsonValue
  book-to-jv (b) = json-object [
    json-pair "id" (json-int b.bk-id),
    json-pair "title" (json-str b.bk-title),
    json-pair "author" (json-str b.bk-author),
    json-pair "isbn" (json-str b.bk-isbn),
    json-pair "genre" (json-str b.bk-genre),
    json-pair "pages" (json-int b.bk-pages),
    json-pair "cur" (json-int b.bk-current-page),
    json-pair "status" (json-int (bs-to-int b.bk-status)),
    json-pair "rating" (json-int b.bk-rating),
    json-pair "started" (json-int b.bk-started),
    json-pair "finished" (json-int b.bk-finished),
    json-pair "notes" (json-str b.bk-notes),
    json-pair "created" (json-int b.bk-created)
  ]

  bs-to-int : BookStatus -> Integer
  bs-to-int (s) = when s
    is BsWantToRead -> 0
    is BsReading -> 1
    is BsRead -> 2
    is BsAbandoned -> 3

  int-to-bs : Integer -> BookStatus
  int-to-bs (n) =
    if n == 0 then BsWantToRead
    else if n == 1 then BsReading
    else if n == 2 then BsRead
    else BsAbandoned

  book-from-jv : JsonValue -> Book
  book-from-jv (jv) = Book {
    bk-id = json-get-int jv "id" 0,
    bk-title = json-get-str jv "title" "",
    bk-author = json-get-str jv "author" "",
    bk-isbn = json-get-str jv "isbn" "",
    bk-genre = json-get-str jv "genre" "",
    bk-pages = json-get-int jv "pages" 0,
    bk-current-page = json-get-int jv "cur" 0,
    bk-status = int-to-bs (json-get-int jv "status" 0),
    bk-rating = json-get-int jv "rating" 0,
    bk-started = json-get-int jv "started" 0,
    bk-finished = json-get-int jv "finished" 0,
    bk-notes = json-get-str jv "notes" "",
    bk-created = json-get-int jv "created" 0
  }

  reading-save : DiskFactStore, List Book, Integer -> DiskFactStore
  reading-save (store) (books) (ts) =
    let j = json-emit (json-array (list-map book-to-jv books))
    in app-log-info (app-write-and-checkpoint store pk-reading j ts) "reading" ("Saved " & show (list-length books) & " books") ts

  reading-load : DiskFactStore -> List Book
  reading-load (store) =
    let found = app-scan-last store pk-reading
    in when found
      is Nothing -> []
      is Just (txt) -> parse-jv-array txt book-from-jv

