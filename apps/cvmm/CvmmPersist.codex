    fr-date = json-get-int jv "date" 0,
    fr-odometer = json-get-int jv "odo" 0,
    fr-gallons-x100 = json-get-int jv "gal" 0,
    fr-cost-cents = json-get-int jv "cost" 0,
    fr-station = json-get-str jv "sta" "",
