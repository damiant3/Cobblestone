 Persistent storage for all CVMM productivity mini-utilities.
 Each domain serializes to JSON and is stored as a DiskFacts
 entry with its own kind ID.

Section: Kind Constants

  pk-notes : Integer = 28
  pk-recipes : Integer = 29
  pk-contacts : Integer = 30
  pk-calendar : Integer = 31
  pk-budget : Integer = 32
  pk-car : Integer = 33
  pk-fitness : Integer = 34
  pk-garden : Integer = 35
  pk-home : Integer = 36
  pk-reading : Integer = 37
  pk-todo : Integer = 38

Section: Notes

  note-to-jv : Note -> JsonValue
  note-to-jv (n) = json-object [
    json-pair "id" (json-int n.note-id),
    json-pair "title" (json-str n.note-title),
    json-pair "body" (json-str n.note-body),
    json-pair "folder" (json-str n.note-folder),
    json-pair "pinned" (json-bool n.note-pinned),
    json-pair "archived" (json-bool n.note-archived),
    json-pair "created" (json-int n.note-created),
    json-pair "modified" (json-int n.note-modified)
  ]

  note-from-jv : JsonValue -> Note
  note-from-jv (jv) = Note {
    note-id = json-get-int jv "id" 0,
    note-title = json-get-str jv "title" "",
    note-body = json-get-str jv "body" "",
    note-folder = json-get-str jv "folder" "Inbox",
    note-tags = [], note-tag-count = 0,
    note-color = NcDefault,
    note-pinned = json-get-bool jv "pinned" False,
    note-archived = json-get-bool jv "archived" False,
    note-created = json-get-int jv "created" 0,
    note-modified = json-get-int jv "modified" 0,
    note-word-count = 0, note-char-count = 0
  }

  notes-save : DiskFactStore, List Note, Integer -> DiskFactStore
  notes-save (store) (notes) (ts) =
    let j = json-emit (json-array (list-map note-to-jv notes))
    in app-log-info (app-write-and-checkpoint store pk-notes j ts) "notes" ("Saved " & show (list-length notes) & " notes") ts

  notes-load : DiskFactStore -> List Note
  notes-load (store) =
    let found = app-scan-last store pk-notes
    in when found
      is Nothing -> []
      is Just (txt) -> parse-jv-array txt note-from-jv

Section: Recipes

  recipe-to-jv : RecipeDetail -> JsonValue
  recipe-to-jv (r) = json-object [
    json-pair "id" (json-int r.rd-id),
    json-pair "title" (json-str r.rd-title),
    json-pair "desc" (json-str r.rd-description),
    json-pair "cat" (json-str r.rd-category),
    json-pair "cuisine" (json-str r.rd-cuisine),
    json-pair "prep" (json-int r.rd-prep-min),
    json-pair "cook" (json-int r.rd-cook-min),
    json-pair "servings" (json-int r.rd-servings),
    json-pair "diff" (json-str r.rd-difficulty),
    json-pair "rating" (json-int r.rd-rating),
    json-pair "source" (json-str r.rd-source),
    json-pair "fav" (json-bool r.rd-favorite),
    json-pair "cooked" (json-int r.rd-times-cooked),
    json-pair "ings" (json-array (list-map ing-to-jv r.rd-ingredients)),
    json-pair "steps" (json-array (list-map step-to-jv r.rd-steps))
  ]

  ing-to-jv : Ingredient -> JsonValue
  ing-to-jv (i) = json-object [
    json-pair "n" (json-str i.ing-name),
    json-pair "q" (json-str i.ing-quantity),
    json-pair "u" (json-str i.ing-unit),
    json-pair "o" (json-bool i.ing-optional),
    json-pair "s" (json-int i.ing-sort)
  ]

  step-to-jv : RecipeStep -> JsonValue
  step-to-jv (s) = json-object [
    json-pair "n" (json-int s.rs-num),
    json-pair "i" (json-str s.rs-instruction),
    json-pair "d" (json-int s.rs-duration-min)
  ]

  recipe-from-jv : JsonValue -> RecipeDetail
  recipe-from-jv (jv) = RecipeDetail {
    rd-id = json-get-int jv "id" 0,
    rd-title = json-get-str jv "title" "",
    rd-description = json-get-str jv "desc" "",
    rd-category = json-get-str jv "cat" "Other",
    rd-cuisine = json-get-str jv "cuisine" "",
    rd-prep-min = json-get-int jv "prep" 0,
    rd-cook-min = json-get-int jv "cook" 0,
    rd-servings = json-get-int jv "servings" 4,
    rd-difficulty = json-get-str jv "diff" "Easy",
    rd-rating = json-get-int jv "rating" 0,
    rd-source = json-get-str jv "source" "",
    rd-favorite = json-get-bool jv "fav" False,
    rd-times-cooked = json-get-int jv "cooked" 0,
    rd-ingredients = parse-jv-sub jv "ings" ing-from-jv,
    rd-ingredient-count = 0,
    rd-steps = parse-jv-sub jv "steps" step-from-jv,
    rd-step-count = 0,
    rd-tags = [], rd-tag-count = 0
  }

  ing-from-jv : JsonValue -> Ingredient
  ing-from-jv (jv) = Ingredient {
    ing-name = json-get-str jv "n" "",
    ing-quantity = json-get-str jv "q" "",
    ing-unit = json-get-str jv "u" "",
    ing-optional = json-get-bool jv "o" False,
    ing-sort = json-get-int jv "s" 0
  }

  step-from-jv : JsonValue -> RecipeStep
  step-from-jv (jv) = RecipeStep {
    rs-num = json-get-int jv "n" 0,
    rs-instruction = json-get-str jv "i" "",
    rs-duration-min = json-get-int jv "d" 0
  }

  recipes-save : DiskFactStore, List RecipeDetail, Integer -> DiskFactStore
  recipes-save (store) (recipes) (ts) =
    let j = json-emit (json-array (list-map recipe-to-jv recipes))
    in app-log-info (app-write-and-checkpoint store pk-recipes j ts) "recipes" ("Saved " & show (list-length recipes) & " recipes") ts

  recipes-load : DiskFactStore -> List RecipeDetail
  recipes-load (store) =
    let found = app-scan-last store pk-recipes
    in when found
      is Nothing -> []
      is Just (txt) -> parse-jv-array txt recipe-from-jv

