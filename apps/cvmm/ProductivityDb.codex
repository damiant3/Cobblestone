    col-def "prep-minutes" ColInteger,
    col-def "cook-minutes" ColInteger,
    col-def "servings" ColInteger,
    col-def "difficulty" ColText,
    col-def-not-null "rating" ColInteger,
    col-def "source" ColText,
    col-def-not-null "favorite" ColBoolean,
    col-def-not-null "created" ColInteger,
    col-def "last-cooked" ColInteger,
    col-def "times-cooked" ColInteger
  ] ["id"]

  recipe-ingredients-table : TableDef
  recipe-ingredients-table = table-def-with-pk "recipe_ingredients" [
    col-def-not-null "recipe-id" ColInteger,
    col-def-not-null "sort-order" ColInteger,
    col-def-not-null "name" ColText,
    col-def-not-null "quantity" ColText,
    col-def "unit" ColText,
    col-def "optional" ColBoolean
  ] ["recipe-id", "sort-order"]

  recipe-steps-table : TableDef
  recipe-steps-table = table-def-with-pk "recipe_steps" [
    col-def-not-null "recipe-id" ColInteger,
    col-def-not-null "step-num" ColInteger,
    col-def-not-null "instruction" ColText,
    col-def "duration-minutes" ColInteger
  ] ["recipe-id", "step-num"]

  recipe-tags-table : TableDef
  recipe-tags-table = table-def-with-pk "recipe_tags" [
    col-def-not-null "recipe-id" ColInteger,
    col-def-not-null "tag" ColText
  ] ["recipe-id", "tag"]

