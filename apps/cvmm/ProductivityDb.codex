Section: Row Builders

  note-row : Integer, Text, Text, Text, Text, Boolean, Integer -> RowData
  note-row (id) (title) (body) (folder) (color) (pinned) (ts) =
    row-new (table-schema notes-table) [ValInteger id, ValText title, ValText body, ValText folder, ValText color, ValBoolean pinned, ValBoolean False, ValInteger ts, ValInteger ts, ValInteger 0]

  todo-row : Integer, Text, Text, Integer, Integer, Integer -> RowData
  todo-row (id) (title) (list-name) (priority) (sort-order) (ts) =
    row-new (table-schema todos-table) [ValInteger id, ValText title, ValNull, ValText list-name, ValBoolean False, ValInteger priority, ValNull, ValNull, ValInteger sort-order, ValInteger ts, ValNull, ValNull]

  contact-row : Integer, Text, Text, Text, Text, Integer -> RowData
  contact-row (id) (first) (last) (email) (phone) (ts) =
    row-new (table-schema contacts-table) [ValInteger id, ValText first, ValText last, ValNull, ValNull, ValNull, ValText email, ValText phone, ValNull, ValNull, ValNull, ValNull, ValNull, ValNull, ValNull, ValNull, ValNull, ValBoolean False, ValInteger ts, ValInteger ts]

  event-row : Integer, Text, Integer, Integer, Boolean, Text, Integer -> RowData
  event-row (id) (title) (start) (end-time) (all-day) (calendar) (ts) =
    row-new (table-schema events-table) [ValInteger id, ValText title, ValNull, ValInteger start, ValInteger end-time, ValBoolean all-day, ValNull, ValText calendar, ValNull, ValNull, ValNull, ValInteger ts]

  recipe-row : Integer, Text, Text, Text, Integer, Integer, Integer, Integer -> RowData
  recipe-row (id) (title) (category) (cuisine) (prep) (cook) (servings) (ts) =
    row-new (table-schema recipes-table) [ValInteger id, ValText title, ValNull, ValText category, ValText cuisine, ValInteger prep, ValInteger cook, ValInteger servings, ValNull, ValInteger 0, ValNull, ValBoolean False, ValInteger ts, ValNull, ValInteger 0]

  vehicle-row : Integer, Text, Text, Integer, Integer -> RowData
  vehicle-row (id) (make) (model) (year) (odometer) =
    row-new (table-schema vehicles-table) [ValInteger id, ValText make, ValText model, ValInteger year, ValNull, ValNull, ValNull, ValInteger odometer, ValNull, ValNull]

  book-row : Integer, Text, Text, Text, Integer, Text, Integer -> RowData
  book-row (id) (title) (author) (genre) (pages) (status) (ts) =
    row-new (table-schema books-table) [ValInteger id, ValText title, ValText author, ValNull, ValText genre, ValInteger pages, ValInteger 0, ValText status, ValNull, ValNull, ValNull, ValNull, ValInteger ts]

  workout-row : Integer, Integer, Text, Integer, Integer, Integer -> RowData
  workout-row (id) (date) (wtype) (duration) (calories) (ts) =
    row-new (table-schema workouts-table) [ValInteger id, ValInteger date, ValText wtype, ValNull, ValInteger duration, ValInteger calories, ValNull, ValNull, ValNull]

  plant-row : Integer, Text, Text, Text, Integer -> RowData
  plant-row (id) (name) (variety) (location) (planted) =
    row-new (table-schema plants-table) [ValInteger id, ValText name, ValText variety, ValText location, ValInteger planted, ValNull, ValNull, ValNull, ValBoolean True]

  transaction-row : Integer, Integer, Text, Integer, Integer, Boolean -> RowData
  transaction-row (id) (date) (desc) (amount-cents) (cat-id) (is-income) =
    row-new (table-schema transactions-table) [ValInteger id, ValInteger date, ValText desc, ValInteger amount-cents, ValInteger cat-id, ValNull, ValNull, ValBoolean is-income]

