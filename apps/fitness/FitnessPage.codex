  load-stats : Integer -> Integer
  load-stats (x) =
    let s1 = state-set-text "total-cal" "524"
    in let s2 = state-set-text "total-ex-min" "30"
    in let s3 = state-set-text "total-steps" "7,842"
    in let s4 = state-set-text "total-dist" "3.6"
    in let s5 = state-set "streak-count" 7
    in let s6 = state-set-text "streak-count-txt" "7"
    in 0

  load-goals : Integer -> Integer
  load-goals (x) =
    let s1 = state-set "goal-cal" 4200
    in let s2 = state-set "goal-ex" 300
    in let s3 = state-set "actual-cal" 3200
    in let s4 = state-set "actual-ex" 210
    in 0

  load-pr-data : Integer -> Integer
  load-pr-data (x) =
    let s0 = state-set "pr-count" 4
    in let s1 = state-set-text "pr-label-0" "Fastest 5K"
    in let s2 = state-set-text "pr-value-0" "24:30"
