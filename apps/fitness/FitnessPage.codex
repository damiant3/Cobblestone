    in let s3 = state-set-text "body-height" "5'11\""
    in 0

Section: Entry

  render-fitness : Integer -> Integer
  render-fitness (x) = mount-widget-themed fitness-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style fitness-theme fitness-css
    in let d1 = load-workout-data 0
    in let d2 = load-stats 0
    in let d3 = load-goals 0
    in let d4 = load-pr-data 0
    in let d5 = load-body-data 0
    in let s1 = state-set "selected-workout" (-1)
    in let s2 = state-set "log-type" 0
    in let s3 = state-set "filter-type" 0
    in let s4 = state-set "editing-goals" 0
    in let s5 = state-set "export-status" 0
    in let s5b = state-set-text "weight-input-val" ""
    in let s5c = state-set "weight-log-count" 0
    in let s6 = set-render render-fitness
    in let h = register-handlers no-pick fitness-click
    in let hi = register-input-handler fitness-input
    in render-fitness 0
  end

