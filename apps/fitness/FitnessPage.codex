 We say:

Section: Theme

  fitness-theme : Theme
  fitness-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 16735334, pal-secondary = 1447446, pal-accent = 4521183, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "fitness-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  fitness-css : Text
  fitness-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0a0a0a;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".fitness{max-width:960px;margin:0 auto;padding:24px}"
    & ".fit-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}"
    & ".fit-brand{font-size:22px;font-weight:700;color:#ff5e57}"
    & ".fit-date{font-size:13px;color:#666}"
    & ".rings{display:flex;gap:24px;justify-content:center;margin-bottom:32px}"
    & ".ring{text-align:center}"
    & ".ring-circle{width:120px;height:120px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;position:relative;margin:0 auto 8px}"
    & ".ring-move{border:6px solid #222;box-shadow:inset 0 0 0 6px #222;background:conic-gradient(#ff3b30 0deg,#ff3b30 252deg,#222 252deg)}"
    & ".ring-exercise{border:6px solid #222;box-shadow:inset 0 0 0 6px #222;background:conic-gradient(#30d158 0deg,#30d158 180deg,#222 180deg)}"
    & ".ring-stand{border:6px solid #222;box-shadow:inset 0 0 0 6px #222;background:conic-gradient(#5ac8fa 0deg,#5ac8fa 288deg,#222 288deg)}"
    & ".ring-inner{width:96px;height:96px;border-radius:50%;background:#0a0a0a;display:flex;align-items:center;justify-content:center;flex-direction:column}"
    & ".ring-val{font-size:24px;font-weight:700}"
    & ".ring-unit{font-size:10px;color:#888}"
    & ".ring-label{font-size:12px;color:#888}"
    & ".ring-goal{font-size:10px;color:#555}"
    & ".stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:28px}"
    & ".stat-card{background:#161616;border-radius:12px;padding:16px;text-align:center}"
    & ".stat-val{font-size:24px;font-weight:700;margin-bottom:2px}"
    & ".stat-lbl{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:.5px}"
    & ".stat-move .stat-val{color:#ff3b30}"
    & ".stat-exercise .stat-val{color:#30d158}"
    & ".stat-steps .stat-val{color:#5ac8fa}"
    & ".stat-dist .stat-val{color:#bf5af2}"
    & ".stat-streak .stat-val{color:#ff9500}"
    & ".week-chart{background:#161616;border-radius:12px;padding:20px;margin-bottom:28px}"
    & ".week-title{font-size:14px;font-weight:600;margin-bottom:16px}"
    & ".week-bars{display:flex;align-items:flex-end;gap:8px;height:120px}"
    & ".week-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px}"
    & ".week-bar{width:100%;border-radius:4px 4px 0 0;transition:height .3s}"
    & ".week-day{font-size:10px;color:#666}"
    & ".week-val{font-size:10px;color:#888}"
    & ".section-title{font-size:14px;font-weight:600;margin-bottom:12px}"
    & ".workout-list{display:flex;flex-direction:column;gap:8px;margin-bottom:28px}"
    & ".workout-item{display:flex;align-items:center;gap:14px;background:#161616;border-radius:10px;padding:14px 16px;cursor:pointer;transition:background .1s}"
    & ".workout-item:hover{background:#1a1a1a}"
    & ".workout-item.selected{background:#1a1a1a;box-shadow:inset 3px 0 0 #ff3b30}"
    & ".workout-icon{font-size:28px;width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}"
    & ".workout-info{flex:1}"
    & ".workout-name{font-size:14px;font-weight:600;margin-bottom:3px}"
    & ".workout-meta{font-size:12px;color:#666}"
    & ".workout-cal{font-size:14px;font-weight:600;color:#ff3b30;flex-shrink:0}"
    & ".quick-log{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:28px}"
    & ".quick-btn{background:#161616;border:1px solid #222;border-radius:10px;padding:16px 8px;text-align:center;cursor:pointer;transition:border-color .15s}"
    & ".quick-btn:hover{border-color:#ff3b30}"
    & ".quick-btn.active{border-color:#ff3b30;background:#2a1414}"
    & ".quick-icon{font-size:24px;margin-bottom:6px}"
    & ".quick-name{font-size:11px;color:#999}"
    & ".goals-section{background:#161616;border-radius:12px;padding:20px;margin-bottom:28px}"
    & ".goals-title{font-size:14px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between}"
    & ".goals-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}"
    & ".goal-item{display:flex;flex-direction:column;gap:6px}"
    & ".goal-label{font-size:12px;color:#888}"
    & ".goal-progress{font-size:18px;font-weight:600}"
    & ".goal-bar{height:6px;background:#222;border-radius:3px;overflow:hidden}"
    & ".goal-fill{height:100%;border-radius:3px;transition:width .3s}"
    & ".goal-fill-cal{background:#ff3b30}"
    & ".goal-fill-ex{background:#30d158}"
    & ".goal-edit-row{display:flex;gap:8px;align-items:center;margin-top:8px}"
    & ".goal-input{background:#222;border:1px solid #333;border-radius:6px;color:#e1e1e1;padding:6px 10px;font-size:13px;width:80px}"
    & ".pr-section{background:#161616;border-radius:12px;padding:20px;margin-bottom:28px}"
    & ".pr-title{font-size:14px;font-weight:600;margin-bottom:14px}"
    & ".pr-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}"
    & ".pr-item{display:flex;flex-direction:column;gap:4px;padding:12px;background:#1e1e1e;border-radius:8px}"
    & ".pr-label{font-size:12px;color:#888}"
    & ".pr-value{font-size:20px;font-weight:700;color:#ffd60a}"
    & ".body-section{background:#161616;border-radius:12px;padding:20px;margin-bottom:28px}"
    & ".body-title{font-size:14px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between}"
    & ".body-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}"
    & ".body-item{text-align:center;padding:12px;background:#1e1e1e;border-radius:8px}"
    & ".body-val{font-size:22px;font-weight:700;color:#5ac8fa;margin-bottom:4px}"
    & ".body-lbl{font-size:11px;color:#888}"
    & ".filter-bar{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}"
    & ".filter-btn{background:#1e1e1e;border:1px solid #333;border-radius:16px;padding:6px 14px;font-size:11px;color:#999;cursor:pointer;transition:all .15s}"
    & ".filter-btn:hover{border-color:#ff3b30;color:#e1e1e1}"
    & ".filter-btn.active{background:#2a1414;border-color:#ff3b30;color:#ff3b30}"
    & ".export-bar{display:flex;align-items:center;gap:12px;margin-bottom:20px}"
    & ".export-msg{font-size:12px;color:#41af4e}"
    & ".add-workout-bar{display:flex;gap:8px;margin-bottom:16px}"

  workout-cal-estimate : Integer -> Integer
  workout-cal-estimate (lt) =
    if lt == 1 then 350
    else if lt == 2 then 400
    else if lt == 3 then 450
    else if lt == 4 then 300
    else if lt == 5 then 180
    else if lt == 6 then 320
    else if lt == 7 then 380
    else 250

  goal-pct : Integer, Integer -> Integer
  goal-pct (actual) (goal) =
    if goal == 0 then 0 else (actual * 100) / goal

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "fitness" "fitness" [
      widget-box "hdr" "fit-hdr" [
        widget-label "brand" "CodexFitness",
        widget-label "date" "Sunday, June 8, 2026"
      ],
      rings-section 0,
      stats-row 0,
      quick-log 0,
      widget-box "add-bar" "add-workout-bar" [
        widget-button "btn-add-workout" "Log Workout"
      ],
      goals-section 0,
      week-chart 0,
      pr-section 0,
      body-section 0,
      widget-box "export-bar" "export-bar" [
        widget-button "btn-export" "Export Stats",
        if state-get "export-status" == 1 then widget-label "export-msg" "Stats exported!" else widget-label "export-msg" ""
      ],
      widget-label "recent-hdr" "Recent Workouts",
      filter-bar 0,
      widget-box "workouts" "workout-list" (build-workout-list 0 (state-get "workout-count") [])
    ]

  rings-section : Integer -> WidgetNode
  rings-section (x) =
    let cal = state-get-text "total-cal"
    in let ex = state-get-text "total-ex-min"
    in widget-box "rings" "rings" [
      ring "r-move" "ring-move" cal "CAL" "Move" "Goal: 600",
      ring "r-exercise" "ring-exercise" ex "MIN" "Exercise" "Goal: 60",
      ring "r-stand" "ring-stand" "8" "HRS" "Stand" "Goal: 10"
    ]

  ring : Text, Text, Text, Text, Text, Text -> WidgetNode
  ring (id) (cls) (val) (metric-unit) (label) (goal) =
    widget-box id "ring" [
      widget-box (id & "c") cls [
        widget-box (id & "i") "ring-inner" [
          widget-label (id & "v") val,
          widget-label (id & "u") metric-unit
        ]
      ],
      widget-label (id & "l") label,
      widget-label (id & "g") goal
    ]

  stats-row : Integer -> WidgetNode
  stats-row (x) =
    let cal = state-get-text "total-cal"
    in let ex = state-get-text "total-ex-min"
    in let steps = state-get-text "total-steps"
    in let dist = state-get-text "total-dist"
    in let streak = state-get-text "streak-count-txt"
    in widget-box "stats" "stats-row" [
      stat-card "s-cal" "stat-move" cal "Calories",
      stat-card "s-ex" "stat-exercise" (ex & " min") "Exercise",
      stat-card "s-steps" "stat-steps" steps "Steps",
      stat-card "s-dist" "stat-dist" (dist & " mi") "Distance",
      stat-card "s-streak" "stat-streak" (streak & " days" & if state-get "streak-count" >= 7 then " &#x1F525;" else "") "Streak"
    ]

  stat-card : Text, Text, Text, Text -> WidgetNode
  stat-card (id) (cls) (val) (label) =
    widget-box id ("stat-card " & cls) [
      widget-label (id & "v") val,
      widget-label (id & "l") label
    ]

  quick-log : Integer -> WidgetNode
  quick-log (x) =
    widget-box "quick" "quick-log" [
      quick-btn "q-run" "&#x1F3C3;" "Run" 1,
      quick-btn "q-bike" "&#x1F6B4;" "Cycle" 2,
      quick-btn "q-swim" "&#x1F3CA;" "Swim" 3,
      quick-btn "q-lift" "&#x1F3CB;" "Weights" 4,
      quick-btn "q-yoga" "&#x1F9D8;" "Yoga" 5,
      quick-btn "q-hike" "&#x26F0;" "Hike" 6,
      quick-btn "q-row" "&#x1F6A3;" "Row" 7,
      quick-btn "q-other" "&#x2795;" "Other" 8,
      if state-get "log-type" > 0 then widget-label "cal-est" ("Est. " & show (workout-cal-estimate (state-get "log-type")) & " cal/30min") else widget-label "cal-est" ""
    ]

  quick-btn : Text, Text, Text, Integer -> WidgetNode
  quick-btn (id) (icon) (name) (n) =
    widget-box-click id (if state-get "log-type" == n then "quick-btn active" else "quick-btn") [
      widget-label (id & "i") icon,
      widget-label (id & "n") name
    ]

  goals-section : Integer -> WidgetNode
  goals-section (x) =
    let gcal = state-get "goal-cal"
    in let gex = state-get "goal-ex"
    in let acal = state-get "actual-cal"
    in let aex = state-get "actual-ex"
    in let editing = state-get "editing-goals"
    in widget-box "goals" "goals-section" [
      widget-box "goals-hdr" "goals-title" [
        widget-label "goals-t" "Weekly Goals",
        widget-button "btn-edit-goals" (if editing == 1 then "Done" else "Edit Goals")
      ],
      widget-box "goals-g" "goals-grid" [
        widget-box "goal-cal-item" "goal-item" [
          widget-label "goal-cal-lbl" "Calories",
          widget-label "goal-cal-prog" (show acal & " / " & show gcal & " (" & show (goal-pct acal gcal) & "%)"),
          widget-box "goal-cal-bar" "goal-bar" [
            widget-label "goal-cal-fill" ""
          ]
        ],
        widget-box "goal-ex-item" "goal-item" [
          widget-label "goal-ex-lbl" "Exercise (min)",
          widget-label "goal-ex-prog" (show aex & " / " & show gex & " (" & show (goal-pct aex gex) & "%)"),
          widget-box "goal-ex-bar" "goal-bar" [
            widget-label "goal-ex-fill" ""
          ]
        ]
      ],
      if editing == 1 then widget-box "goal-edit" "goal-edit-row" [
        widget-label "ge-cal-lbl" "Cal target:",
        wk-attach (widget-custom "ge-cal-input" "input" 0 0) [] 0 2,
        widget-label "ge-ex-lbl" "Ex target:",
        wk-attach (widget-custom "ge-ex-input" "input" 0 0) [] 0 2
      ] else widget-label "goal-edit-spacer" ""
    ]

  pr-section : Integer -> WidgetNode
  pr-section (x) =
    widget-box "prs" "pr-section" [
      widget-label "pr-t" "Personal Records",
      widget-box "pr-g" "pr-grid" (build-pr-items 0 (state-get "pr-count") [])
    ]

  build-pr-items : Integer, Integer, List WidgetNode -> List WidgetNode
  build-pr-items (i) (count) (acc) =
    if i >= count then acc
    else let lbl = state-get-text ("pr-label-" & show i)
    in let val = state-get-text ("pr-value-" & show i)
    in let item = widget-box ("pr-" & show i) "pr-item" [
      widget-label ("pr-l-" & show i) lbl,
      widget-label ("pr-v-" & show i) val
    ]
    in build-pr-items (i + 1) count (list-push acc item)

  body-section : Integer -> WidgetNode
  body-section (x) =
    let wt = state-get-text "body-weight"
    in let bmi = state-get-text "body-bmi"
    in let ht = state-get-text "body-height"
    in widget-box "body" "body-section" [
      widget-box "body-hdr" "body-title" [
        widget-label "body-t" "Body Metrics",
        widget-box "weight-log-row" "goal-edit-row" [
          wk-attach (widget-custom "weight-input" "input" 0 0) [] 0 2,
          widget-button "btn-log-weight" "Log Weight"
        ]
      ],
      widget-box "body-g" "body-grid" [
        widget-box "body-wt" "body-item" [
          widget-label "body-wt-v" (wt & " lbs"),
          widget-label "body-wt-l" "Weight"
        ],
        widget-box "body-bmi-item" "body-item" [
          widget-label "body-bmi-v" bmi,
          widget-label "body-bmi-l" "BMI"
        ],
        widget-box "body-ht" "body-item" [
          widget-label "body-ht-v" ht,
          widget-label "body-ht-l" "Height"
        ]
      ]
    ]

  filter-bar : Integer -> WidgetNode
  filter-bar (x) =
    let f = state-get "filter-type"
    in widget-box "filters" "filter-bar" [
      widget-box-click "f-all" (if f == 0 then "filter-btn active" else "filter-btn") [widget-label "f-all-t" "All"],
      widget-box-click "f-run" (if f == 1 then "filter-btn active" else "filter-btn") [widget-label "f-run-t" "Run"],
      widget-box-click "f-bike" (if f == 2 then "filter-btn active" else "filter-btn") [widget-label "f-bike-t" "Cycle"],
      widget-box-click "f-swim" (if f == 3 then "filter-btn active" else "filter-btn") [widget-label "f-swim-t" "Swim"],
      widget-box-click "f-lift" (if f == 4 then "filter-btn active" else "filter-btn") [widget-label "f-lift-t" "Weights"],
      widget-box-click "f-yoga" (if f == 5 then "filter-btn active" else "filter-btn") [widget-label "f-yoga-t" "Yoga"]
    ]

  week-chart : Integer -> WidgetNode
  week-chart (x) =
    widget-box "week" "week-chart" [
      widget-label "week-title" "This Week",
      widget-box "bars" "week-bars" [
        bar-col "b-mon" "Mon" "480" 80,
        bar-col "b-tue" "Tue" "620" 100,
        bar-col "b-wed" "Wed" "390" 65,
        bar-col "b-thu" "Thu" "550" 92,
        bar-col "b-fri" "Fri" "710" 100,
        bar-col "b-sat" "Sat" "320" 53,
        bar-col "b-sun" "Sun" "524" 87
      ]
    ]

  bar-col : Text, Text, Text, Integer -> WidgetNode
  bar-col (id) (day) (val) (pct) =
    widget-box id "week-bar-wrap" [
      widget-label (id & "v") val,
      widget-label (id & "b") "",
      widget-label (id & "d") day
    ]

  build-workout-list : Integer, Integer, List WidgetNode -> List WidgetNode
  build-workout-list (i) (count) (acc) =
    if i >= count then acc
    else let ft = state-get "filter-type"
    in let wtype = state-get ("w-type-" & show i)
    in if ft > 0 then if wtype /= ft then build-workout-list (i + 1) count acc
    else let name = state-get-text ("w-name-" & show i)
    in let dur = state-get-text ("w-dur-" & show i)
    in let cal = state-get-text ("w-cal-" & show i)
    in let dist = state-get-text ("w-dist-" & show i)
    in let date = state-get-text ("w-date-" & show i)
    in let icon = state-get-text ("w-icon-" & show i)
    in let meta = date & " &#x2022; " & dist & " &#x2022; " & dur
    in let sel = state-get "selected-workout"
    in let item = widget-box-click ("w" & show i) (if sel == i + 1 then "workout-item selected" else "workout-item") [
      widget-label ("w" & show i & "i") icon,
      widget-box ("w" & show i & "info") "workout-info" [
        widget-label ("w" & show i & "n") name,
        widget-label ("w" & show i & "m") meta
      ],
      widget-label ("w" & show i & "c") (cal & " cal")
    ]
    in build-workout-list (i + 1) count (list-push acc item)
    else let name = state-get-text ("w-name-" & show i)
    in let dur = state-get-text ("w-dur-" & show i)
    in let cal = state-get-text ("w-cal-" & show i)
    in let dist = state-get-text ("w-dist-" & show i)
    in let date = state-get-text ("w-date-" & show i)
    in let icon = state-get-text ("w-icon-" & show i)
    in let meta = date & " &#x2022; " & dist & " &#x2022; " & dur
    in let sel = state-get "selected-workout"
    in let item = widget-box-click ("w" & show i) (if sel == i + 1 then "workout-item selected" else "workout-item") [
      widget-label ("w" & show i & "i") icon,
      widget-box ("w" & show i & "info") "workout-info" [
        widget-label ("w" & show i & "n") name,
        widget-label ("w" & show i & "m") meta
      ],
      widget-label ("w" & show i & "c") (cal & " cal")
    ]
    in build-workout-list (i + 1) count (list-push acc item)

Section: Handlers

  fitness-click : Text -> Integer
  fitness-click (id) =
    if id == "q-run" then let s = state-set-render "log-type" 1 in 0
    else if id == "q-bike" then let s = state-set-render "log-type" 2 in 0
    else if id == "q-swim" then let s = state-set-render "log-type" 3 in 0
    else if id == "q-lift" then let s = state-set-render "log-type" 4 in 0
    else if id == "q-yoga" then let s = state-set-render "log-type" 5 in 0
    else if id == "q-hike" then let s = state-set-render "log-type" 6 in 0
    else if id == "q-row" then let s = state-set-render "log-type" 7 in 0
    else if id == "q-other" then let s = state-set-render "log-type" 8 in 0
    else if id == "f-all" then let s = state-set-render "filter-type" 0 in 0
    else if id == "f-run" then let s = state-set-render "filter-type" 1 in 0
    else if id == "f-bike" then let s = state-set-render "filter-type" 2 in 0
    else if id == "f-swim" then let s = state-set-render "filter-type" 3 in 0
    else if id == "f-lift" then let s = state-set-render "filter-type" 4 in 0
    else if id == "f-yoga" then let s = state-set-render "filter-type" 5 in 0
    else if id == "btn-edit-goals" then let cur = state-get "editing-goals" in let s = state-set-render "editing-goals" (if cur == 1 then 0 else 1) in 0
    else if id == "btn-export" then let s = state-set-render "export-status" 1 in 0
    else if id == "btn-log-weight" then
      let wv = state-get-text "weight-input-val"
      in let cur = state-get "weight-log-count"
      in let s1 = if text-length wv > 0 then state-set-text "body-weight" wv else ""
      in let s2 = state-set-render "weight-log-count" (cur + 1)
      in 0
    else if id == "btn-add-workout" then add-workout 0
    else if text-starts-with id "w" then let s = state-set-render "selected-workout" (id-num id + 1) in 0
    else 0

  add-workout : Integer -> Integer
  add-workout (x) =
    let lt = state-get "log-type"
    in let idx = state-get "workout-count"
    in let nm = if lt == 1 then "Run" else if lt == 2 then "Cycle" else if lt == 3 then "Swim" else if lt == 4 then "Weights" else if lt == 5 then "Yoga" else if lt == 6 then "Hike" else if lt == 7 then "Row" else "Workout"
    in let ic = if lt == 1 then "&#x1F3C3;" else if lt == 2 then "&#x1F6B4;" else if lt == 3 then "&#x1F3CA;" else if lt == 4 then "&#x1F3CB;" else if lt == 5 then "&#x1F9D8;" else if lt == 6 then "&#x26F0;" else if lt == 7 then "&#x1F6A3;" else "&#x2795;"
    in let ty = if lt >= 1 then if lt <= 5 then lt else 1 else 1
    in let s1 = state-set-text ("w-name-" & show idx) nm
    in let s2 = state-set ("w-type-" & show idx) ty
    in let s3 = state-set-text ("w-dur-" & show idx) "30 min"
    in let s4 = state-set-text ("w-cal-" & show idx) (show (workout-cal-estimate lt))
    in let s5 = state-set-text ("w-dist-" & show idx) "0"
    in let s6 = state-set-text ("w-date-" & show idx) "Today"
    in let s7 = state-set-text ("w-icon-" & show idx) ic
    in let s8 = state-set-render "workout-count" (idx + 1)
    in 0

  fitness-input : Text, Text -> Integer
  fitness-input (id) (value) =
    if id == "ge-cal-input" then let s = state-set-text "goal-cal-input" value in 0
    else if id == "ge-ex-input" then let s = state-set-text "goal-ex-input" value in 0
    else if id == "weight-input" then let s = state-set-text "weight-input-val" value in 0
    else 0

