 The picture is apps/diffusion's SDXL text to image at Forge's DPM++ SDE
 with its Automatic (Karras) schedule. After a saved PNG, Diffusion chapter
 ImageOut holds the scanlines at io-raw: per row a filter byte 0, then R G B.

Section: Types
  ForgeConfig = record {
    fc-ckpt : Text,
    fc-negative : Text,
    fc-out : Text,
    fc-width : Integer,
    fc-height : Integer,
    fc-steps : Integer,
    fc-cfg : Real,
    fc-seed : Integer,
    fc-generate-3d : Boolean
  }

  ForgeResult = record {
    fr-status : Text,
    fr-ok : Boolean,
    fr-png : Text,
    fr-mesh-bytes : List Integer,
    fr-prompt : Text,
    fr-width : Integer,
    fr-height : Integer,
    fr-has-mesh : Boolean
  }

Section: Default Configuration
  forge-default-config : ForgeConfig
  forge-default-config = ForgeConfig {
    fc-ckpt = "dreamshaperXL_lightningDPMSDE.safetensors",
    fc-negative = "",
    fc-out = "assetforge.png",
    fc-width = 1024,
    fc-height = 1024,
    fc-steps = 6,
    fc-cfg = 2.0,
    fc-seed = 42,
    fc-generate-3d = True
  }

  forge-fast-config : ForgeConfig
  forge-fast-config = ForgeConfig {
    fc-ckpt = "dreamshaperXL_lightningDPMSDE.safetensors",
    fc-negative = "",
    fc-out = "assetforge.png",
    fc-width = 512,
    fc-height = 512,
    fc-steps = 6,
    fc-cfg = 2.0,
    fc-seed = 42,
    fc-generate-3d = False
  }

  forge-with-seed : ForgeConfig, Integer, Text -> ForgeConfig
  forge-with-seed (c) (seed) (out) = ForgeConfig {
    fc-ckpt = c.fc-ckpt,
    fc-negative = c.fc-negative,
    fc-out = out,
    fc-width = c.fc-width,
    fc-height = c.fc-height,
    fc-steps = c.fc-steps,
    fc-cfg = c.fc-cfg,
    fc-seed = seed,
    fc-generate-3d = c.fc-generate-3d
  }

Section: Generation
  forge-request : Text, ForgeConfig -> Txt2Img
  forge-request (prompt) (c) =
    let params = prompt & "\nNegative prompt: " & c.fc-negative & "\nSteps: " & show (c.fc-steps) & ", Sampler: DPM++ SDE, Schedule type: Karras, CFG scale: " & show (c.fc-cfg) & ", Seed: " & show (c.fc-seed) & ", Size: " & show (c.fc-width) & "x" & show (c.fc-height) & ", Model: " & c.fc-ckpt
    in Txt2Img { ti-ckpt = c.fc-ckpt, ti-prompt = prompt, ti-negative = c.fc-negative, ti-sampler = ti-dpmpp-sde, ti-scheduler = 0, ti-steps = c.fc-steps, ti-cfg = c.fc-cfg, ti-seed = c.fc-seed, ti-width = c.fc-width, ti-height = c.fc-height, ti-out = c.fc-out, ti-params = params, ti-clip-skip = 1, ti-extras = ti-no-extras }

  forge-generate : ClipBpe, Text, ForgeConfig, Recon3dState -> ForgeResult
  forge-generate (bpe) (prompt) (c) (recon) =
    let status = txt2img bpe (forge-request prompt c)
    in let ok = text-starts-with status "png "
    in let mesh = if ok & c.fc-generate-3d then image-to-glb (forge-saved-image (c.fc-width) (c.fc-height)) recon else []
    in ForgeResult { fr-status = status, fr-ok = ok, fr-png = c.fc-out, fr-mesh-bytes = mesh, fr-prompt = prompt, fr-width = c.fc-width, fr-height = c.fc-height, fr-has-mesh = list-length mesh > 0 }

  forge-saved-image : Integer, Integer -> ImageData
  forge-saved-image (w) (h) = image-new w h (forge-scan-pixels w h 0 0 (__list-with-capacity (w * h)))

  forge-scan-pixels : Integer, Integer, Integer, Integer, List Rgb -> List Rgb
  forge-scan-pixels (w) (h) (y) (x) (acc) =
    if y >= h then acc
    else if x >= w then forge-scan-pixels w h (y + 1) 0 acc
    else let at = io-raw + y * (1 + w * 3) + 1 + x * 3
    in forge-scan-pixels w h y (x + 1) (list-push acc (rgb (peek-byte at 0) (peek-byte at 1) (peek-byte at 2)))

Section: Batch Generation
  forge-batch : ClipBpe, List Text, ForgeConfig, Recon3dState -> List ForgeResult
  forge-batch (bpe) (prompts) (c) (recon) = forge-batch-loop bpe prompts c recon 0 []

  forge-batch-loop : ClipBpe, List Text, ForgeConfig, Recon3dState, Integer, List ForgeResult -> List ForgeResult
  forge-batch-loop (bpe) (prompts) (c) (recon) (i) (acc) =
    if i >= list-length prompts then acc
    else let ci = forge-with-seed c (c.fc-seed + i * 7919) (show i & "-" & c.fc-out)
    in forge-batch-loop bpe prompts c recon (i + 1) (list-push acc (forge-generate bpe (list-at prompts i) ci recon))

Section: Queries
  format-forge-config : ForgeConfig -> Text
  format-forge-config (cfg) =
    show (cfg.fc-width) & "x" & show (cfg.fc-height) & " steps=" & show (cfg.fc-steps) & " cfg=" & show (cfg.fc-cfg) & " 3d=" & (if cfg.fc-generate-3d then "yes" else "no")

  format-forge-result : ForgeResult -> Text
  format-forge-result (r) =
    let mesh = if r.fr-has-mesh then " glb=" & show (list-length (r.fr-mesh-bytes)) & "B" else ""
    in "\"" & r.fr-prompt & "\" " & r.fr-png & ": " & r.fr-status & mesh

