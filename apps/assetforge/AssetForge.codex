Section: Types
  ForgeConfig = record {
    fc-model-path : Text,
    fc-recon-model-path : Text,
    fc-output-dir : Text,
    fc-width : Integer,
    fc-height : Integer,
    fc-steps : Integer,
    fc-guidance : Integer,
    fc-seed : Integer,
    fc-generate-3d : Boolean,
    fc-grid-res : Integer
  }

  ForgeResult = record {
    fr-image-bytes : List Integer,
    fr-mesh-bytes : List Integer,
    fr-prompt : Text,
    fr-width : Integer,
    fr-height : Integer,
    fr-has-mesh : Boolean
  }

