Section: Generation
  forge-generate : Text, ForgeConfig, PipelineState, Recon3dState -> ForgeResult
  forge-generate (prompt) (config) (pipe-state) (recon-state) =
    let output = pipeline-generate prompt pipe-state
    in let png = pipeline-to-png output
    in if config.fc-generate-3d then
      let img = forge-output-to-image output
      in let glb = image-to-glb img recon-state
      in ForgeResult { fr-image-bytes = png, fr-mesh-bytes = glb, fr-prompt = prompt, fr-width = config.fc-width, fr-height = config.fc-height, fr-has-mesh = True }
    else ForgeResult { fr-image-bytes = png, fr-mesh-bytes = [], fr-prompt = prompt, fr-width = config.fc-width, fr-height = config.fc-height, fr-has-mesh = False }

  forge-output-to-image : PipelineOutput -> ImageData
  forge-output-to-image (output) =
    let pixels = forge-unpack-pixels (output.po-pixels) 0 (output.po-width * output.po-height) []
    in image-new (output.po-width) (output.po-height) pixels

  forge-unpack-pixels : List Integer, Integer, Integer, List Rgb -> List Rgb
  forge-unpack-pixels (packed) (i) (n) (acc) =
    if i >= n then acc
    else let p = list-at packed i
    in let r = bit-and (bit-shru p 16) 255
    in let g = bit-and (bit-shru p 8) 255
    in let b = bit-and p 255
    in forge-unpack-pixels packed (i + 1) n (list-push acc (Rgb { cr = r, cg = g, cb = b }))

Section: Batch Generation
  forge-batch : List Text, ForgeConfig, PipelineState, Recon3dState -> List ForgeResult
  forge-batch (prompts) (config) (pipe-state) (recon-state) =
    forge-batch-loop prompts config pipe-state recon-state 0 (list-length prompts) []

  forge-batch-loop : List Text, ForgeConfig, PipelineState, Recon3dState, Integer, Integer, List ForgeResult -> List ForgeResult
  forge-batch-loop (prompts) (config) (pipe-state) (recon-state) (i) (n) (acc) =
    if i >= n then acc
    else let seed-config = forge-with-seed config ((config.fc-seed) + i * 7919)
    in let pipe = forge-update-pipe-seed pipe-state (config.fc-seed + i * 7919)
    in let result = forge-generate (list-at prompts i) seed-config pipe recon-state
    in forge-batch-loop prompts config pipe-state recon-state (i + 1) n (list-push acc result)

  forge-with-seed : ForgeConfig, Integer -> ForgeConfig
  forge-with-seed (config) (seed) =
    ForgeConfig { fc-model-path = config.fc-model-path, fc-recon-model-path = config.fc-recon-model-path, fc-output-dir = config.fc-output-dir, fc-width = config.fc-width, fc-height = config.fc-height, fc-steps = config.fc-steps, fc-guidance = config.fc-guidance, fc-seed = seed, fc-generate-3d = config.fc-generate-3d, fc-grid-res = config.fc-grid-res }

  forge-update-pipe-seed : PipelineState, Integer -> PipelineState
  forge-update-pipe-seed (state) (seed) =
    PipelineState {
      ps-config = PipelineConfig {
        pc-width = (state.ps-config.pc-width),
        pc-height = (state.ps-config.pc-height),
        pc-num-steps = (state.ps-config.pc-num-steps),
        pc-guidance-scale = (state.ps-config.pc-guidance-scale),
        pc-seed = seed,
        pc-latent-channels = (state.ps-config.pc-latent-channels),
        pc-latent-scale = (state.ps-config.pc-latent-scale)
      },
      ps-text-encoder = state.ps-text-encoder,
      ps-unet = state.ps-unet,
      ps-scheduler = state.ps-scheduler,
      ps-vae-decoder-w = state.ps-vae-decoder-w,
      ps-vae-decoder-b = state.ps-vae-decoder-b,
      ps-tokenizer = state.ps-tokenizer
    }

Section: Queries
  format-forge-config : ForgeConfig -> Text
  format-forge-config (cfg) =
    show (cfg.fc-width) & "x" & show (cfg.fc-height) & " steps=" & show (cfg.fc-steps) & " cfg=" & show (cfg.fc-guidance) & " 3d=" & (if cfg.fc-generate-3d then "yes" else "no")

  format-forge-result : ForgeResult -> Text
  format-forge-result (r) =
    "\"" & r.fr-prompt & "\" " & show (r.fr-width) & "x" & show (r.fr-height) & " png=" & show (list-length (r.fr-image-bytes)) & "B" & (if r.fr-has-mesh then " glb=" & show (list-length (r.fr-mesh-bytes)) & "B" else "")

