Section: Queries
  format-card-spec : CardSpec -> Text
  format-card-spec (card) =
    card.cs-name & " [" & card.cs-type & "] " & card.cs-rarity & " (" & card.cs-color & ")"

  format-card-result : CardArtResult -> Text
  format-card-result (r) =
    format-card-spec (r.car-card) & " -> png=" & show (list-length (r.car-image-bytes)) & "B" & (if r.car-has-mesh then " glb=" & show (list-length (r.car-mesh-bytes)) & "B" else "")

