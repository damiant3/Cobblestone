 We say:

Section: Types
  CardSpec = record {
    cs-name : Text,
    cs-type : Text,
    cs-rarity : Text,
    cs-color : Text,
    cs-flavor : Text,
    cs-keywords : List Text
  }

  CardArtResult = record {
    car-card : CardSpec,
    car-prompt : Text,
    car-image-bytes : List Integer,
    car-mesh-bytes : List Integer,
    car-has-mesh : Boolean
  }

Section: Card Types
  card-type-creature : Text = "Creature"
  card-type-spell : Text = "Spell"
  card-type-artifact : Text = "Artifact"
  card-type-enchantment : Text = "Enchantment"
  card-type-land : Text = "Land"

Section: Rarities
  rarity-common : Text = "Common"
  rarity-uncommon : Text = "Uncommon"
  rarity-rare : Text = "Rare"
  rarity-mythic : Text = "Mythic"

Section: Colors
  color-white : Text = "White"
  color-blue : Text = "Blue"
  color-black : Text = "Black"
  color-red : Text = "Red"
  color-green : Text = "Green"
  color-colorless : Text = "Colorless"

Section: Prompt Construction
  card-art-prompt : CardSpec -> Text
  card-art-prompt (card) =
    let base = card-type-prompt (card.cs-type) (card.cs-name)
    in let color-style = card-color-style (card.cs-color)
    in let rarity-quality = card-rarity-quality (card.cs-rarity)
    in let flavor = if text-length (card.cs-flavor) > 0 then ", " & card.cs-flavor else ""
    in let keywords = card-keywords-to-text (card.cs-keywords) 0 (list-length (card.cs-keywords)) ""
    in base & ", " & color-style & flavor & keywords & ", " & rarity-quality & ", " & card-art-style

  card-type-prompt : Text, Text -> Text
  card-type-prompt (card-type) (name) =
    if card-type == card-type-creature then "a powerful fantasy creature named " & name & ", full body portrait, dynamic pose"
    else if card-type == card-type-spell then "a magical spell effect called " & name & ", swirling energy, arcane symbols"
    else if card-type == card-type-artifact then "an ancient magical artifact called " & name & ", ornate details, glowing runes"
    else if card-type == card-type-enchantment then "a mystical enchantment called " & name & ", ethereal aura, magical patterns"
    else if card-type == card-type-land then "a majestic fantasy landscape called " & name & ", sweeping vista, atmospheric lighting"
    else "fantasy illustration of " & name

  card-color-style : Text -> Text
  card-color-style (color) =
    if color == color-white then "radiant light, holy energy, golden accents, pristine white"
    else if color == color-blue then "deep blue tones, water and wind, arcane knowledge, mystical"
    else if color == color-black then "dark shadows, necromantic energy, skull motifs, ominous"
    else if color == color-red then "fiery reds, explosive energy, volcanic, aggressive"
    else if color == color-green then "lush vegetation, primal forces, natural growth, wild"
    else "metallic sheen, crystalline structure, neutral tones"

  card-rarity-quality : Text -> Text
  card-rarity-quality (rarity) =
    if rarity == rarity-mythic then "masterpiece quality, legendary, epic scale, breathtaking detail"
    else if rarity == rarity-rare then "highly detailed, impressive composition, dramatic lighting"
    else if rarity == rarity-uncommon then "detailed illustration, good composition, clear subject"
    else "clean illustration, clear subject, solid composition"

  card-art-style : Text
  card-art-style = "fantasy card game art, digital painting, vibrant colors, sharp focus, professional illustration, aspect ratio 5:7"

  card-keywords-to-text : List Text, Integer, Integer, Text -> Text
  card-keywords-to-text (keywords) (i) (n) (acc) =
    if i >= n then acc
    else let kw = list-at keywords i
    in card-keywords-to-text keywords (i + 1) n (acc & ", " & kw)

Section: Pipeline Integration
  card-generate-art : CardSpec, PipelineState, Recon3dState, Boolean -> CardArtResult
  card-generate-art (card) (pipe-state) (recon-state) (gen-3d) =
    let prompt = card-art-prompt card
    in let output = pipeline-generate prompt pipe-state
    in let png = pipeline-to-png output
    in if gen-3d then
      let img = card-output-to-image output
      in let glb = image-to-glb img recon-state
      in CardArtResult { car-card = card, car-prompt = prompt, car-image-bytes = png, car-mesh-bytes = glb, car-has-mesh = True }
    else CardArtResult { car-card = card, car-prompt = prompt, car-image-bytes = png, car-mesh-bytes = [], car-has-mesh = False }

  card-output-to-image : PipelineOutput -> ImageData
  card-output-to-image (output) =
    let pixels = card-unpack-pixels (output.po-pixels) 0 (output.po-width * output.po-height) []
    in image-new (output.po-width) (output.po-height) pixels

  card-unpack-pixels : List Integer, Integer, Integer, List Rgb -> List Rgb
  card-unpack-pixels (packed) (i) (n) (acc) =
    if i >= n then acc
    else let p = list-at packed i
    in let r = bit-and (bit-shru p 16) 255
    in let g = bit-and (bit-shru p 8) 255
    in let b = bit-and p 255
    in card-unpack-pixels packed (i + 1) n (list-push acc (Rgb { cr = r, cg = g, cb = b }))

Section: Batch Card Generation
  card-generate-batch : List CardSpec, PipelineState, Recon3dState, Boolean -> List CardArtResult
  card-generate-batch (cards) (pipe-state) (recon-state) (gen-3d) =
    card-batch-loop cards pipe-state recon-state gen-3d 0 (list-length cards) []

  card-batch-loop : List CardSpec, PipelineState, Recon3dState, Boolean, Integer, Integer, List CardArtResult -> List CardArtResult
  card-batch-loop (cards) (pipe-state) (recon-state) (gen-3d) (i) (n) (acc) =
    if i >= n then acc
    else let card = list-at cards i
    in let result = card-generate-art card pipe-state recon-state gen-3d
    in card-batch-loop cards pipe-state recon-state gen-3d (i + 1) n (list-push acc result)

