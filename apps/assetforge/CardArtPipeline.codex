    cs-color = color-colorless,
    cs-flavor = "a scepter that bends time, encrusted with temporal crystals",
    cs-keywords = ["legendary", "time manipulation"]
  }

Section: Queries
  format-card-spec : CardSpec -> Text
  format-card-spec (card) =
    card.cs-name & " [" & card.cs-type & "] " & card.cs-rarity & " (" & card.cs-color & ")"

  format-card-result : CardArtResult -> Text
  format-card-result (r) =
    format-card-spec (r.car-card) & " -> " & format-forge-result (r.car-forge)

