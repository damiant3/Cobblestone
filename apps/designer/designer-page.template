<!DOCTYPE html>
<html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Codex Designer</title>
<style>{{CSS}}</style>
</head><body>
<div class="dsg-app">
  <div class="dsg-header">
    <span class="dsg-logo">CODEX DESIGNER</span>
    <span class="dsg-sep"></span>
    <span id="dsg-status" class="dsg-status">Loading...</span>
  </div>
  <div class="dsg-body">
    <div class="dsg-left">
      <div class="dsg-palette" id="palette"></div>
      <div class="dsg-tree" id="tree"></div>
    </div>
    <div class="dsg-center">
      <div class="dsg-canvas-wrap">
        <div class="dsg-canvas" id="canvas"></div>
        <div class="dsg-preview" id="preview"></div>
      </div>
      <div class="dsg-code" id="code-output">
        <div class="dsg-code-header">CODEX OUTPUT <span class="dsg-code-controls"><button class="dsg-font-btn" onclick="adjustCodeFont(-0.08)">-</button><button class="dsg-font-btn" onclick="adjustCodeFont(0.08)">+</button><button id="copy-btn" class="dsg-copy-btn">Copy</button></span></div>
        <pre id="code-text" class="dsg-code-pre"></pre>
      </div>
    </div>
    <div class="dsg-props" id="props"></div>
  </div>
</div>
<script>{{JS}}</script>
</body></html>
