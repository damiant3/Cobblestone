Chapter: DesignerInteraction

 Event delegation for the Designer props panel. Replaces inline JS with
 Codex DOM builtins compiled to JavaScript via the JS plug. Handles
 change events on property inputs and click events on action buttons.

 We say:

Section: Props Event Handlers

  on-prop-change : Integer -> Integer
  on-prop-change (evt) =
    let el = dom-event-target evt
    in let prop-text = dom-dataset-get el "propText"
    in if prop-text != "" then
      let idx = text-to-integer prop-text
      in set-widget-text idx (dom-get-value el)
    else let prop-action = dom-dataset-get el "propAction"
    in if prop-action != "" then
      let idx = text-to-integer prop-action
      in set-widget-onclick idx (dom-get-value el)
    else let set-p = dom-dataset-get el "setProp"
    in if set-p != "" then
      let idx = text-to-integer (dom-dataset-get el "idx")
      in set-prop idx set-p (dom-get-value el)
    else 0

  on-action-click : Integer -> Integer
  on-action-click (evt) =
    let target = dom-event-target evt
    in let btn = dom-closest target "[data-action]"
    in if dom-not-null btn then
      let action = dom-dataset-get btn "action"
      in let idx = text-to-integer (dom-dataset-get btn "idx")
      in if action == "dup" then dup-widget idx
      else if action == "delete" then
        let d = delete-widget idx
        in render-all 0
      else 0
    else 0

Section: Setup

  setup-props-events : Integer -> Integer
  setup-props-events (x) =
    let doc = dom-document
    in let a = dom-on-change doc on-prop-change
    in let b = dom-on-click doc on-action-click
    in 0

