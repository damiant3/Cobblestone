Chapter: BooksPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 We say:

Section: Theme

  books-theme : Theme
  books-theme =
    let p = Palette { pal-bg = #101010, pal-fg = #D8D8D8, pal-primary = #D2B3FF, pal-secondary = #181818, pal-accent = #D2B3FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "books-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  books-css : Text
  books-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#101010;color:#d8d8d8;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".books{min-height:100vh}"
    & ".books-hdr{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid #222}"
    & ".books-brand{font-size:20px;font-weight:700;color:#d2a0ff}"
    & ".books-tabs{display:flex;gap:4px}"
    & ".books-tabs .wk-btn{background:none;border:none;color:#888;padding:8px 16px;cursor:pointer;border-radius:6px;font-size:13px}"
    & ".books-tabs .wk-btn:hover{color:#ddd;background:#1a1a1a}"
    & ".books-search{background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:8px 16px;color:#ccc;font-size:13px;width:240px}"
    & ".section-hdr{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;padding:24px 24px 16px}"
    & ".shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:20px;padding:0 24px 32px}"
    & ".book-card{cursor:pointer;transition:transform .15s}"
    & ".book-card:hover{transform:translateY(-6px)}"
    & ".book-cover{aspect-ratio:2/3;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:48px;margin-bottom:10px;box-shadow:2px 4px 12px rgba(0,0,0,.4);position:relative;overflow:hidden}"
    & ".book-cover::after{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:rgba(255,255,255,.15)}"
    & ".book-title{font-size:13px;font-weight:600;line-height:1.3;margin-bottom:3px}"
    & ".book-author{font-size:11px;color:#777}"
    & ".book-progress{height:3px;background:#222;border-radius:2px;margin-top:6px;overflow:hidden}"
    & ".book-progress-fill{height:100%;background:#d2a0ff;border-radius:2px}"
    & ".reader{max-width:640px;margin:0 auto;padding:40px 24px}"
    & ".reader-nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px}"
    & ".reader-back{color:#d2a0ff;cursor:pointer;font-size:13px}"
    & ".reader-chapter{font-size:12px;color:#666}"
    & ".reader-title{font-size:24px;font-weight:700;margin-bottom:8px;color:#fff}"
    & ".reader-author{font-size:14px;color:#777;margin-bottom:32px}"
    & ".reader-body{font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.9;color:#ccc}"
    & ".reader-body p{margin-bottom:20px;text-indent:1.5em}"
    & ".reader-body p:first-child{text-indent:0}"
    & ".reader-footer{display:flex;justify-content:space-between;margin-top:40px;padding-top:20px;border-top:1px solid #222;font-size:12px;color:#555}"
    & ".reading-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;padding:0 24px 32px}"
    & ".reading-row{display:flex;gap:14px;background:#161616;border-radius:10px;padding:14px;cursor:pointer;transition:background .1s}"
    & ".reading-row:hover{background:#1a1a1a}"
    & ".reading-cover{width:56px;height:84px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;box-shadow:1px 2px 6px rgba(0,0,0,.3)}"
    & ".reading-info{flex:1;min-width:0}"
    & ".reading-title{font-size:14px;font-weight:600;margin-bottom:3px}"
    & ".reading-author{font-size:11px;color:#777;margin-bottom:6px}"
    & ".reading-pct{font-size:11px;color:#d2a0ff}"
    & ".stats-bar{display:flex;gap:24px;padding:12px 24px;background:#161616;border-radius:8px;margin:0 24px 16px}"
    & ".stat-item{font-size:13px;color:#999}"
    & ".stat-value{color:#d2a0ff;font-weight:600;margin-left:6px}"
    & ".sort-bar{display:flex;gap:8px;padding:0 24px 16px}"
    & ".sort-bar .wk-btn{font-size:12px;padding:4px 12px;border-radius:4px;background:#1a1a1a;border:none;color:#888;cursor:pointer}"
    & ".sort-bar .wk-btn:hover{color:#ddd}"
    & ".reader-tools{display:flex;gap:12px;align-items:center;padding:8px 0;border-bottom:1px solid #222;margin-bottom:16px}"
    & ".reader-tools .wk-btn{font-size:12px;padding:4px 12px;background:#1a1a1a;border:none;color:#aaa;cursor:pointer;border-radius:4px}"
    & ".reader-tools .wk-btn:hover{color:#fff}"
    & ".tool-label{font-size:11px;color:#666;margin-left:4px}"
    & ".page-nav{display:flex;gap:12px;align-items:center;margin-top:16px}"
    & ".page-nav .wk-btn{font-size:13px;padding:6px 16px;background:#1a1a1a;border:none;color:#aaa;cursor:pointer;border-radius:4px}"
    & ".page-nav .wk-btn:hover{background:#222;color:#fff}"
    & ".bookmark-btn{color:#d2a0ff !important}"
    & ".font-controls{display:flex;gap:4px;align-items:center}"
    & ".font-label{font-size:11px;color:#666;padding:0 4px}"
    & ".theme-toggle{display:flex;gap:6px;align-items:center}"
    & ".theme-label{font-size:11px;color:#666}"
    & ".sort-bar{align-items:center}"
    & ".search-indicator{padding:10px 24px;background:#161622;border-bottom:1px solid #282838;font-size:13px;color:#d2a0ff;display:flex;align-items:center;gap:8px}"
    & ".book-pct{font-size:10px;color:#d2a0ff;margin-top:4px}"
    & ".book-genre{font-size:10px;color:#555;margin-top:2px}"

  est-reading-time-left : Integer -> Integer
  est-reading-time-left (n) =
    let cur = state-get ("current-page-" & show n)
    in let total = book-pages n
    in let remaining = total - cur
    in (remaining * 2) / 60

  star-text : Integer, Integer -> Text
  star-text (n) (rating) =
    if n > 5 then ""
    else (if n <= rating then "&#x2605;" else "&#x2606;") & star-text (n + 1) rating

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let view = state-get "reading"
    in if view == 1 then reader-view 0
    else library-view 0

  library-view : Integer -> WidgetNode
  library-view (x) =
    let tab = state-get "active-tab"
    in widget-box "books" "books" [
      widget-box "hdr" "books-hdr" [
        widget-label "brand" "CodexBooks",
        widget-box "tabs" "books-tabs" [
          widget-button "tab-lib" "Library",
          widget-button "tab-store" "Book Store",
          widget-button "tab-audio" "Audiobooks",
          widget-button "tab-search" "Search"
        ],
        widget-label "search" "Search books..."
      ],
      if tab == 1 then store-view 0
      else if tab == 2 then audiobooks-view 0
      else library-content 0
    ]

  store-view : Integer -> WidgetNode
  store-view (x) =
    widget-box "store-view" "" [
      widget-label "store-hdr" "Book Store",
      widget-label "store-icon" "&#x1F4DA;",
      widget-label "store-msg" "Browse the store to find new titles"
    ]

  audiobooks-view : Integer -> WidgetNode
  audiobooks-view (x) =
    widget-box "audio-view" "" [
      widget-label "audio-hdr" "Audiobooks",
      widget-label "audio-icon" "&#x1F3A7;",
      widget-label "audio-msg" "Audiobook playback coming in a future release"
    ]

  library-content : Integer -> WidgetNode
  library-content (x) =
    widget-box "lib-content" "" [
      search-indicator 0,
      stats-bar 0,
      widget-label "cont-hdr" "Continue Reading",
      reading-strip 0,
      widget-label "lib-hdr" "Library",
      sort-bar 0,
      book-shelf 0
    ]

  reading-strip : Integer -> WidgetNode
  reading-strip (x) =
    widget-box "reading-strip" "reading-strip" [
      reading-row "cr0" "&#x1F4D6;" "#1a2a3a" "The Pragmatic Programmer" "David Thomas, Andrew Hunt" (show (book-progress-pct 0) & "% &#x2022; " & show (est-reading-time-left 0) & "h left"),
      reading-row "cr1" "&#x1F52D;" "#2a1a2a" "Surely You're Joking, Mr. Feynman" "Richard Feynman" (show (book-progress-pct 1) & "% &#x2022; " & show (est-reading-time-left 1) & "h left"),
      reading-row "cr2" "&#x1F331;" "#1a2a1a" "Walden" "Henry David Thoreau" (show (book-progress-pct 2) & "% &#x2022; " & show (est-reading-time-left 2) & "h left")
    ]

  book-title : Integer -> Text
  book-title (n) =
    if n == 0 then "The Pragmatic Programmer" else if n == 1 then "Surely You're Joking, Mr. Feynman"
    else if n == 2 then "Walden" else if n == 3 then "The Art of UNIX Programming"
    else if n == 4 then "The Martian" else if n == 5 then "Thinking, Fast and Slow"
    else if n == 6 then "Cosmos" else if n == 7 then "Structure and Interpretation of Computer Programs"
    else if n == 8 then "Dune" else "Godel, Escher, Bach"

  book-author : Integer -> Text
  book-author (n) =
    if n == 0 then "David Thomas & Andrew Hunt" else if n == 1 then "Richard Feynman"
    else if n == 2 then "Henry David Thoreau" else if n == 3 then "Eric S. Raymond"
    else if n == 4 then "Andy Weir" else if n == 5 then "Daniel Kahneman"
    else if n == 6 then "Carl Sagan" else if n == 7 then "Abelson & Sussman"
    else if n == 8 then "Frank Herbert" else "Douglas Hofstadter"

  book-pages : Integer -> Integer
  book-pages (n) =
    if n == 0 then 352 else if n == 1 then 391
    else if n == 2 then 215 else if n == 3 then 480
    else if n == 4 then 369 else if n == 5 then 499
    else if n == 6 then 365 else if n == 7 then 657
    else if n == 8 then 412 else 777

  book-genre : Integer -> Text
  book-genre (n) =
    if n == 0 then "Programming" else if n == 1 then "Science"
    else if n == 2 then "Philosophy" else if n == 3 then "Programming"
    else if n == 4 then "Fiction" else if n == 5 then "Psychology"
    else if n == 6 then "Science" else if n == 7 then "Programming"
    else if n == 8 then "Fiction" else "Philosophy"

  book-progress-pct : Integer -> Integer
  book-progress-pct (n) =
    let cur = state-get ("current-page-" & show n)
    in let total = book-pages n
    in if total == 0 then 0 else (cur * 100) / total

  total-pages-read : Integer -> Integer
  total-pages-read (n) =
    if n >= 10 then 0
    else (state-get ("current-page-" & show n)) + total-pages-read (n + 1)

  books-completed : Integer -> Integer
  books-completed (n) =
    if n >= 10 then 0
    else let cur = state-get ("current-page-" & show n)
    in let total = book-pages n
    in let done = if cur >= total then 1 else 0
    in done + books-completed (n + 1)

  search-indicator : Integer -> WidgetNode
  search-indicator (x) =
    let sa = state-get "search-active"
    in if sa == 1 then widget-box "search-bar" "search-indicator" [
      widget-label "search-icon" "&#x1F50D;",
      widget-label "search-txt" "Search active -- type to filter library",
      widget-button "tab-search" "Dismiss"
    ] else widget-label "search-off" ""

  stats-bar : Integer -> WidgetNode
  stats-bar (x) =
    let bm = state-get "bookmark-count"
    in widget-box "stats-bar" "stats-bar" [
      widget-box "st-pages" "stat-item" [
        widget-label "st-pl" "Pages Read:",
        widget-label "st-pv" (show (total-pages-read 0))
      ],
      widget-box "st-done" "stat-item" [
        widget-label "st-dl" "Completed:",
        widget-label "st-dv" (show (books-completed 0) & " / 10")
      ],
      widget-box "st-bm" "stat-item" [
        widget-label "st-bl" "Bookmarks:",
        widget-label "st-bv" (show bm)
      ],
      widget-box "st-lib" "stat-item" [
        widget-label "st-ll" "Library:",
        widget-label "st-lv" "10 books"
      ]
    ]

  sort-label : Integer -> Text
  sort-label (m) =
    if m == 0 then "Title" else if m == 1 then "Author" else "Recent"

  sort-bar : Integer -> WidgetNode
  sort-bar (x) =
    let mode = state-get "sort-mode"
    in widget-box "sort-bar" "sort-bar" [
      widget-label "sort-lbl" "Sort by:",
      widget-button "sort-title" "Title",
      widget-button "sort-author" "Author",
      widget-button "sort-recent" "Recent",
      widget-label "sort-cur" ("[" & sort-label mode & "]")
    ]

  reading-row : Text, Text, Text, Text, Text, Text -> WidgetNode
  reading-row (id) (icon) (bg) (title) (author) (pct) =
    widget-box-click id "reading-row" [
      widget-label (id & "c") icon,
      widget-box (id & "i") "reading-info" [
        widget-label (id & "t") title,
        widget-label (id & "a") author,
        widget-label (id & "p") pct
      ]
    ]

  book-shelf : Integer -> WidgetNode
  book-shelf (x) =
    widget-box "shelf" "shelf" [
      book-card "b0" "&#x1F4D6;" "#1a2a3a" "The Pragmatic Programmer" "David Thomas" 0,
      book-card "b1" "&#x1F52D;" "#2a1a2a" "Surely You're Joking" "R. Feynman" 1,
      book-card "b2" "&#x1F331;" "#1a2a1a" "Walden" "H.D. Thoreau" 2,
      book-card "b3" "&#x1F4D0;" "#2a2a1a" "The Art of UNIX" "E.S. Raymond" 3,
      book-card "b4" "&#x1F680;" "#1a1a2a" "The Martian" "Andy Weir" 4,
      book-card "b5" "&#x1F9E0;" "#2a1a1a" "Thinking, Fast and Slow" "D. Kahneman" 5,
      book-card "b6" "&#x1F30C;" "#1a1a3a" "Cosmos" "Carl Sagan" 6,
      book-card "b7" "&#x1F4BB;" "#0a2a2a" "Structure and Interpretation" "Abelson & Sussman" 7,
      book-card "b8" "&#x1F3F0;" "#2a0a1a" "Dune" "Frank Herbert" 8,
      book-card "b9" "&#x2699;" "#1a2a2a" "Godel, Escher, Bach" "Douglas Hofstadter" 9
    ]

  book-card : Text, Text, Text, Text, Text, Integer -> WidgetNode
  book-card (id) (icon) (bg) (title) (author) (idx) =
    let pct = book-progress-pct idx
    in let cur = state-get ("current-page-" & show idx)
    in let total = book-pages idx
    in let time-left = est-reading-time-left idx
    in widget-box-click id "book-card" [
      widget-label (id & "c") icon,
      widget-label (id & "t") title,
      widget-label (id & "a") author,
      widget-label (id & "g") (book-genre idx),
      widget-box (id & "pb") "book-progress" [
        widget-label (id & "pf") ""
      ],
      widget-label (id & "pct") (if pct > 0 then show cur & "/" & show total & " (" & show pct & "%)" else ""),
      widget-label (id & "eta") (if pct > 0 then if time-left > 0 then show time-left & "h left" else "Done!" else "")
    ]

  font-size-label : Integer -> Text
  font-size-label (s) =
    if s == 0 then "Small" else if s == 1 then "Medium" else "Large"

  reading-theme-label : Integer -> Text
  reading-theme-label (t) =
    if t == 0 then "Dark" else if t == 1 then "Light" else "Sepia"

  reader-toolbar : Integer -> WidgetNode
  reader-toolbar (x) =
    let fs = state-get "font-size"
    in let rt = state-get "reading-theme"
    in let sel = state-get "selected-book"
    in let bm-page = state-get ("bookmark-page-" & show sel)
    in let rating = state-get ("rating-" & show sel)
    in widget-box "reader-tools" "reader-tools" [
      widget-button "bookmark" (if bm-page > 0 then "&#x1F516; p." & show bm-page else "&#x1F516; Bookmark"),
      widget-label "tool-sep1" "|",
      widget-box "font-ctl" "font-controls" [
        widget-button "font-down" "A-",
        widget-label "font-lbl" (font-size-label fs),
        widget-button "font-up" "A+"
      ],
      widget-label "tool-sep2" "|",
      widget-box "theme-ctl" "theme-toggle" [
        widget-label "theme-lbl" (reading-theme-label rt),
        widget-button "theme-toggle" "Theme"
      ],
      widget-label "tool-sep3" "|",
      widget-box "rating-ctl" "font-controls" [
        widget-button "rate-1" (if rating >= 1 then "&#x2605;" else "&#x2606;"),
        widget-button "rate-2" (if rating >= 2 then "&#x2605;" else "&#x2606;"),
        widget-button "rate-3" (if rating >= 3 then "&#x2605;" else "&#x2606;"),
        widget-button "rate-4" (if rating >= 4 then "&#x2605;" else "&#x2606;"),
        widget-button "rate-5" (if rating >= 5 then "&#x2605;" else "&#x2606;")
      ]
    ]

  reader-view : Integer -> WidgetNode
  reader-view (x) =
    let sel = state-get "selected-book"
    in let cur-page = state-get ("current-page-" & show sel)
    in let total = book-pages sel
    in let pct = book-progress-pct sel
    in widget-box "reader" "reader" [
      widget-box "reader-nav" "reader-nav" [
        widget-button "back" "&#x2190; Library",
        widget-label "r-ch" "Chapter 1 of 12"
      ],
      reader-toolbar 0,
      widget-label "r-title" (book-title sel),
      widget-label "r-author" (book-author sel & " | " & book-genre sel),
      widget-box "r-body" "reader-body" [
        widget-label "r-p1" (if sel == 0 then "We feel that there is no point in developing software unless you care about doing it well. So rather than wasting your time with yet another programming book, we figured we'd cut to the chase and give you the most effective strategies we know." else "Opening " & book-title sel & " by " & book-author sel & ". Chapter content streams when you are online; your place is saved here."),
        widget-label "r-p2" (if sel == 0 then "Think about what you're doing. Constantly critique and appraise your work. The old army saying stands: never stop thinking about what you're doing. If you don't care about the work, why should anyone else?" else ""),
        widget-label "r-p3" (if sel == 0 then "Provide options, don't make lame excuses. Before you approach anyone to tell them why something can't be done, is late, or is broken, stop and listen to yourself. Talk to the rubber duck on your monitor. Does your excuse sound reasonable, or stupid?" else ""),
        widget-label "r-p4" (if sel == 0 then "Don't live with broken windows. One broken window, left unrepaired for any substantial length of time, instills in the inhabitants of the building a sense of abandonment. So one more window gets broken, and litter starts to appear, and serious structural damage begins." else "")
      ],
      widget-box "r-foot" "reader-footer" [
        widget-label "r-page" ("Page " & show cur-page & " of " & show total),
        widget-label "r-pct" (show pct & "%" & if est-reading-time-left sel > 0 then " &#x2022; " & show (est-reading-time-left sel) & "h remaining" else " &#x2022; Complete!")
      ],
      widget-box "r-prog-bar" "book-progress" [
        widget-label "r-prog-fill" ""
      ],
      widget-box "page-nav" "page-nav" [
        widget-button "page-prev" "&#x2190; Previous",
        widget-label "page-pos" (show cur-page & " / " & show total),
        widget-button "page-next" "Next &#x2192;"
      ]
    ]

Section: Handlers

  books-click : Text -> Integer
  books-click (id) =
    if id == "back" then let s = state-set-render "reading" 0 in 0
    else if id == "bookmark" then
      let sel = state-get "selected-book"
      in let pg = state-get ("current-page-" & show sel)
      in let bc = state-get "bookmark-count"
      in let s1 = state-set ("bookmark-page-" & show sel) pg
      in let s2 = state-set-render "bookmark-count" (bc + 1)
      in 0
    else if id == "font-up" then let fs = state-get "font-size" in if fs >= 2 then 0 else let s = state-set-render "font-size" (fs + 1) in 0
    else if id == "font-down" then let fs = state-get "font-size" in if fs <= 0 then 0 else let s = state-set-render "font-size" (fs - 1) in 0
    else if id == "theme-toggle" then let rt = state-get "reading-theme" in let next = if rt >= 2 then 0 else rt + 1 in let s = state-set-render "reading-theme" next in 0
    else if id == "sort-title" then let s = state-set-render "sort-mode" 0 in 0
    else if id == "sort-author" then let s = state-set-render "sort-mode" 1 in 0
    else if id == "sort-recent" then let s = state-set-render "sort-mode" 2 in 0
    else if id == "tab-lib" then let s = state-set-render "active-tab" 0 in 0
    else if id == "tab-store" then let s = state-set-render "active-tab" 1 in 0
    else if id == "tab-audio" then let s = state-set-render "active-tab" 2 in 0
    else if id == "rate-1" then let sel = state-get "selected-book" in let s = state-set-render ("rating-" & show sel) 1 in 0
    else if id == "rate-2" then let sel = state-get "selected-book" in let s = state-set-render ("rating-" & show sel) 2 in 0
    else if id == "rate-3" then let sel = state-get "selected-book" in let s = state-set-render ("rating-" & show sel) 3 in 0
    else if id == "rate-4" then let sel = state-get "selected-book" in let s = state-set-render ("rating-" & show sel) 4 in 0
    else if id == "rate-5" then let sel = state-get "selected-book" in let s = state-set-render ("rating-" & show sel) 5 in 0
    else if id == "tab-search" then let cur = state-get "search-active" in let nv = if cur == 0 then 1 else 0 in let s = state-set-render "search-active" nv in 0
    else if id == "page-next" then let sel = state-get "selected-book" in let cur = state-get ("current-page-" & show sel) in let total = book-pages sel in if cur >= total then 0 else let s = state-set-render ("current-page-" & show sel) (cur + 1) in 0
    else if id == "page-prev" then let sel = state-get "selected-book" in let cur = state-get ("current-page-" & show sel) in if cur <= 0 then 0 else let s = state-set-render ("current-page-" & show sel) (cur - 1) in 0
    else if text-starts-with id "cr" then let s = state-set "selected-book" (id-num id) in let s2 = state-set-render "reading" 1 in 0
    else if text-starts-with id "b" then let s = state-set "selected-book" (id-num id) in let s2 = state-set-render "reading" 1 in 0
    else 0

Section: Entry

  render-books : Integer -> Integer
  render-books (x) = mount-widget-themed books-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style books-theme books-css
    in let i0 = state-set "reading" 0
