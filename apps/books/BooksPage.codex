    in let i7 = state-set "active-tab" 0
    in let cp0 = state-set "current-page-0" 120
    in let cp1 = state-set "current-page-1" 85
    in let cp2 = state-set "current-page-2" 45
    in let cp3 = state-set "current-page-3" 0
    in let cp4 = state-set "current-page-4" 0
    in let cp5 = state-set "current-page-5" 0
