Chapter: Impression

Section: Definitions

  Impression = record {
    imp-number : Integer,
    imp-when : Integer,
    imp-printer : Text
  }

  impression-line : Impression -> Text
  impression-line (imp) =
    ordinal (imp.imp-number) & " impression, struck at " & show (imp.imp-when)
    & " by " & (imp.imp-printer)

  ordinal : Integer -> Text
  ordinal (n) =
    if n == 1 then "first"
    else if n == 2 then "second"
    else if n == 3 then "third"
    else show n & "th"

