Chapter: CapturePage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Screen capture tool with region selection, annotation, and export.

 We say:

Section: Theme

  capture-theme : Theme
  capture-theme =
    let p = Palette { pal-bg = 1118481, pal-fg = 14803425, pal-primary = 4493567, pal-secondary = 1776411, pal-accent = 4493567, pal-muted = 7829367, pal-error = 15486256, pal-success = 4304718, pal-warning = 16750848, pal-border = 2500134 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "capture-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  capture-css : Text
  capture-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#111;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".capture{display:grid;grid-template-columns:56px 1fr 280px;min-height:100vh}"
    & ".toolbar{background:#0a0a0a;border-right:1px solid #222;padding:12px 0;display:flex;flex-direction:column;align-items:center;gap:4px}"
    & ".tool-btn{width:40px;height:40px;border-radius:8px;border:none;background:none;color:#888;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;transition:all .1s}"
    & ".tool-btn:hover{background:#1a1a1a;color:#ddd}"
    & ".tool-btn.active{background:#0044ff;color:#fff}"
    & ".tool-sep{width:28px;height:1px;background:#222;margin:4px 0}"
    & ".canvas-area{display:flex;flex-direction:column;background:#0d0d0d}"
    & ".canvas-toolbar{display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid #222;background:#141414}"
    & ".canvas-toolbar .wk-btn{background:#222;border:1px solid #333;color:#ccc;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".canvas-toolbar .wk-btn:hover{background:#2a2a2a}"
    & ".canvas-sep{width:1px;height:20px;background:#333}"
    & ".canvas{flex:1;display:flex;align-items:center;justify-content:center;overflow:auto}"
    & ".canvas-img{background:#1a1a1a;border:1px solid #333;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:120px;width:800px;height:500px;position:relative}"
    & ".canvas-empty{display:flex;flex-direction:column;align-items:center;gap:16px;color:#444}"
    & ".canvas-empty-icon{font-size:64px}"
    & ".canvas-empty-text{font-size:16px}"
    & ".canvas-empty-hint{font-size:13px;color:#333}"
    & ".props{background:#141414;border-left:1px solid #222;padding:16px;overflow-y:auto}"
    & ".props-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".prop-group{margin-bottom:20px}"
    & ".prop-label{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}"
    & ".prop-row{display:flex;gap:8px;margin-bottom:8px}"
    & ".prop-input{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 10px;color:#ccc;font-size:12px;flex:1}"
    & ".prop-unit{font-size:11px;color:#555;padding:6px 0;min-width:20px}"
    & ".format-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}"
    & ".format-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px;text-align:center;cursor:pointer;font-size:12px;color:#888;transition:all .1s}"
    & ".format-btn:hover{border-color:#0044ff;color:#ddd}"
    & ".format-btn.active{border-color:#0044ff;background:#0a1a3a;color:#4488ff}"
    & ".history{border-top:1px solid #222;padding-top:16px;margin-top:auto}"
    & ".history-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}"
    & ".history-item{display:flex;gap:10px;padding:8px;border-radius:8px;cursor:pointer;transition:background .1s;margin-bottom:4px}"
    & ".history-item:hover{background:#1a1a1a}"
    & ".history-thumb{width:48px;height:32px;border-radius:4px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}"
    & ".history-info{flex:1;min-width:0}"
    & ".history-name{font-size:12px;font-weight:500;margin-bottom:2px}"
    & ".history-meta{font-size:10px;color:#555}"

Section: Constructors

  zoom-text : Integer -> Text
  zoom-text (z) =
    if z == -2 then "50%"
    else if z == -1 then "75%"
    else if z == 1 then "150%"
    else if z == 2 then "200%"
    else if z == 3 then "300%"
    else "100%"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "capture" "capture" [
      tool-bar 0,
      canvas-area 0,
      props-panel 0
    ]

  tool-bar : Integer -> WidgetNode
  tool-bar (x) =
    widget-box "toolbar" "toolbar" [
      widget-button "t-select" "&#x25ED;",
      widget-button "t-region" "&#x2B1C;",
      widget-button "t-window" "&#x1F5D4;",
      widget-button "t-full" "&#x1F5B5;",
      widget-label "sep1" "",
      widget-button "t-arrow" "&#x2197;",
      widget-button "t-rect" "&#x25A1;",
      widget-button "t-circle" "&#x25CB;",
      widget-button "t-text" "T",
      widget-button "t-blur" "&#x25A8;",
      widget-label "sep2" "",
      widget-button "t-undo" "&#x21B6;",
      widget-button "t-redo" "&#x21B7;"
    ]

  canvas-area : Integer -> WidgetNode
  canvas-area (x) =
    let has-image = state-get "has-image"
    in widget-box "canvas-area" "canvas-area" [
      widget-box "canvas-bar" "canvas-toolbar" [
        widget-button "btn-capture" "&#x1F4F7; Capture",
        widget-button "btn-open" "Open File",
        widget-button "btn-paste" "Paste",
        widget-label "csep1" "",
        widget-button "btn-zoom-in" "+",
        widget-label "zoom-level" (zoom-text (state-get "zoom-level")),
        widget-button "btn-zoom-out" "-",
        widget-label "csep2" "",
        widget-button "btn-save" "Save",
        widget-button "btn-copy" "Copy",
        widget-button "btn-share" "Share"
      ],
      if has-image == 1
      then widget-box "canvas" "canvas" [
        widget-label "img" "&#x1F5BC;"
      ]
      else widget-box "canvas" "canvas" [
        widget-box "empty" "canvas-empty" [
          widget-label "empty-icon" "&#x1F4F7;",
          widget-label "empty-text" "No capture yet",
          widget-label "empty-hint" "Press Capture or paste an image"
        ]
      ]
    ]

  props-panel : Integer -> WidgetNode
  props-panel (x) =
    widget-box "props" "props" [
      widget-label "props-hdr" "Properties",
      widget-box "crop-group" "prop-group" [
        widget-label "crop-lbl" "CROP",
        widget-box "crop-w" "prop-row" [
          widget-label "crop-w-l" "W",
          widget-label "crop-w-v" "800",
          widget-label "crop-w-u" "px"
        ],
        widget-box "crop-h" "prop-row" [
          widget-label "crop-h-l" "H",
          widget-label "crop-h-v" "500",
          widget-label "crop-h-u" "px"
        ]
      ],
      widget-box "aspect-group" "prop-group" [
        widget-label "aspect-lbl" "ASPECT RATIO",
        widget-box "aspects" "format-grid" [
          widget-button "asp-free" "Free",
          widget-button "asp-1" "1:1",
          widget-button "asp-169" "16:9",
          widget-button "asp-43" "4:3"
        ]
      ],
      widget-box "format-group" "prop-group" [
        widget-label "format-lbl" "EXPORT FORMAT",
        widget-box "formats" "format-grid" [
          widget-button "fmt-png" "PNG",
          widget-button "fmt-jpg" "JPEG",
          widget-button "fmt-bmp" "BMP",
          widget-button "fmt-qoi" "QOI"
        ]
      ],
      widget-box "quality-group" "prop-group" [
        widget-label "quality-lbl" "QUALITY",
        widget-label "quality-val" "92%"
      ],
      widget-box "history" "history" [
        widget-label "hist-hdr" "Recent",
        history-item "h0" "&#x1F5BC;" "screenshot-001.png" "Just now &#x2022; 1.2 MB",
        history-item "h1" "&#x1F5BC;" "crop-diagram.png" "10 min ago &#x2022; 340 KB",
        history-item "h2" "&#x1F5BC;" "ui-mockup.jpg" "1 hour ago &#x2022; 890 KB"
      ]
    ]

  history-item : Text, Text, Text, Text -> WidgetNode
  history-item (id) (icon) (name) (meta) =
    widget-box id "history-item" [
      widget-label (id & "th") icon,
      widget-box (id & "i") "history-info" [
        widget-label (id & "n") name,
        widget-label (id & "m") meta
      ]
    ]

Section: Handlers

  capture-click : Text -> Integer
  capture-click (id) =
    if id == "btn-capture" then let s = state-set-render "has-image" 1 in 0
    else if id == "t-arrow" then let s = state-set-render "tool-active" 1 in 0
    else if id == "t-rect" then let s = state-set-render "tool-active" 2 in 0
    else if id == "t-circle" then let s = state-set-render "tool-active" 3 in 0
    else if id == "t-text" then let s = state-set-render "tool-active" 4 in 0
    else if id == "t-blur" then let s = state-set-render "tool-active" 5 in 0
    else if id == "fmt-png" then let s = state-set-render "export-format" 1 in 0
    else if id == "fmt-jpg" then let s = state-set-render "export-format" 2 in 0
    else if id == "fmt-bmp" then let s = state-set-render "export-format" 3 in 0
    else if id == "fmt-qoi" then let s = state-set-render "export-format" 4 in 0
    else if id == "asp-free" then let s = state-set-render "aspect-mode" 1 in 0
    else if id == "asp-1" then let s = state-set-render "aspect-mode" 2 in 0
    else if id == "asp-169" then let s = state-set-render "aspect-mode" 3 in 0
    else if id == "asp-43" then let s = state-set-render "aspect-mode" 4 in 0
    else if id == "btn-zoom-in" then let s = state-set-render "zoom-level" (state-get "zoom-level" + 1) in 0
    else if id == "btn-zoom-out" then let s = state-set-render "zoom-level" (state-get "zoom-level" - 1) in 0
    else 0

Section: Entry

  render-capture : Integer -> Integer
  render-capture (x) = mount-widget-themed capture-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style capture-theme capture-css
    in let s = set-render render-capture
    in let h = register-handlers no-pick capture-click
    in render-capture 0
  end

