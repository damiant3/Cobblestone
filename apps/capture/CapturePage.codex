Chapter: CapturePage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 We say:

Section: Theme

  capture-theme : Theme
  capture-theme =
    let p = Palette { pal-bg = #111111, pal-fg = #E1E1E1, pal-primary = #4490FF, pal-secondary = #1B1B1B, pal-accent = #4490FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #262626 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "capture-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  capture-css : Text
  capture-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#111;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".capture{display:grid;grid-template-columns:56px 1fr 280px;min-height:100vh}"
    & ".toolbar{background:#0a0a0a;border-right:1px solid #222;padding:12px 0;display:flex;flex-direction:column;align-items:center;gap:4px}"
    & ".tool-btn{width:40px;height:40px;border-radius:8px;border:none;background:none;color:#888;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;transition:all .1s}"
    & ".tool-btn:hover{background:#1a1a1a;color:#ddd}"
    & ".tool-btn.active{background:#0044ff;color:#fff}"
    & ".tool-sep{width:28px;height:1px;background:#222;margin:4px 0}"
    & ".canvas-area{display:flex;flex-direction:column;background:#0d0d0d}"
    & ".canvas-toolbar{display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid #222;background:#141414}"
    & ".canvas-toolbar .wk-btn{background:#222;border:1px solid #333;color:#ccc;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:12px}"
    & ".canvas-toolbar .wk-btn:hover{background:#2a2a2a}"
    & ".canvas-sep{width:1px;height:20px;background:#333}"
    & ".canvas{flex:1;display:flex;align-items:center;justify-content:center;overflow:auto}"
    & ".canvas-img{background:#1a1a1a;border:1px solid #333;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:120px;width:800px;height:500px;position:relative}"
    & ".canvas-empty{display:flex;flex-direction:column;align-items:center;gap:16px;color:#444}"
    & ".canvas-empty-icon{font-size:64px}"
    & ".canvas-empty-text{font-size:16px}"
    & ".canvas-empty-hint{font-size:13px;color:#333}"
    & ".props{background:#141414;border-left:1px solid #222;padding:16px;overflow-y:auto}"
    & ".props-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".prop-group{margin-bottom:20px}"
    & ".prop-label{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}"
    & ".prop-row{display:flex;gap:8px;margin-bottom:8px}"
    & ".prop-input{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 10px;color:#ccc;font-size:12px;flex:1}"
    & ".prop-unit{font-size:11px;color:#555;padding:6px 0;min-width:20px}"
    & ".format-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}"
    & ".format-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px;text-align:center;cursor:pointer;font-size:12px;color:#888;transition:all .1s}"
    & ".format-btn:hover{border-color:#0044ff;color:#ddd}"
    & ".format-btn.active{border-color:#0044ff;background:#0a1a3a;color:#4488ff}"
    & ".history{border-top:1px solid #222;padding-top:16px;margin-top:auto}"
    & ".history-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}"
    & ".history-item{display:flex;gap:10px;padding:8px;border-radius:8px;cursor:pointer;transition:background .1s;margin-bottom:4px}"
    & ".history-item:hover{background:#1a1a1a}"
    & ".history-thumb{width:48px;height:32px;border-radius:4px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}"
    & ".history-info{flex:1;min-width:0}"
    & ".history-name{font-size:12px;font-weight:500;margin-bottom:2px}"
    & ".history-meta{font-size:10px;color:#555}"
    & ".color-picker{display:flex;gap:6px;margin:8px 0}"
    & ".color-dot{width:24px;height:24px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:border-color .1s}"
    & ".color-dot:hover{border-color:#fff}"
    & ".color-dot.active{border-color:#fff;box-shadow:0 0 8px rgba(255,255,255,.3)}"
    & ".width-sel{display:flex;gap:6px;margin:8px 0}"
    & ".width-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 12px;font-size:11px;color:#888;cursor:pointer}"
    & ".width-btn.active{border-color:#4490ff;color:#4490ff}"
    & ".mode-sel{display:flex;gap:6px;margin:8px 0}"
    & ".mode-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:8px 10px;font-size:11px;color:#888;cursor:pointer;text-align:center}"
    & ".mode-btn.active{border-color:#4490ff;color:#4490ff;background:#0a1a3a}"
    & ".delay-sel{display:flex;gap:6px;margin:8px 0}"
    & ".delay-btn{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;padding:6px 10px;font-size:11px;color:#888;cursor:pointer}"
    & ".delay-btn.active{border-color:#4490ff;color:#4490ff}"
    & ".anno-list{margin:8px 0;max-height:120px;overflow-y:auto}"
    & ".anno-item{font-size:11px;color:#999;padding:4px 0;border-bottom:1px solid #1a1a1a}"
    & ".status-bar{display:flex;align-items:center;gap:12px;padding:4px 16px;border-top:1px solid #222;background:#0a0a0a;font-size:11px;color:#555}"
    & ".status-item{display:flex;align-items:center;gap:4px}"
    & ".grid-overlay{position:absolute;inset:0;background-image:linear-gradient(rgba(68,144,255,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(68,144,255,.1) 1px,transparent 1px);background-size:20px 20px;pointer-events:none}"
    & ".file-name-input{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:4px;padding:4px 8px;color:#ccc;font-size:11px;width:120px}"

Section: Constructors

  zoom-text : Integer -> Text
  zoom-text (z) =
    if z == -2 then "50%"
    else if z == -1 then "75%"
    else if z == 1 then "150%"
    else if z == 2 then "200%"
    else if z == 3 then "300%"
    else "100%"

  color-name : Integer -> Text
  color-name (c) =
    if c == 0 then "Red"
    else if c == 1 then "Blue"
    else if c == 2 then "Green"
    else if c == 3 then "Yellow"
    else "White"

  color-hex : Integer -> Text
  color-hex (c) =
    if c == 0 then "#EC4D30"
    else if c == 1 then "#4490FF"
    else if c == 2 then "#41AF4E"
    else if c == 3 then "#FFD700"
    else "#FFFFFF"

  width-name : Integer -> Text
  width-name (w) =
    if w == 1 then "Thin"
    else if w == 2 then "Medium"
    else "Thick"

  width-px : Integer -> Text
  width-px (w) =
    if w == 1 then "1px"
    else if w == 2 then "3px"
    else "5px"

  capture-mode-name : Integer -> Text
  capture-mode-name (m) =
    if m == 0 then "Fullscreen"
    else if m == 1 then "Window"
    else "Region"

  capture-mode-icon : Integer -> Text
  capture-mode-icon (m) =
    if m == 0 then "&#x1F5B5;"
    else if m == 1 then "&#x1F5D4;"
    else "&#x2B1C;"

  delay-label : Integer -> Text
  delay-label (d) =
    if d == 0 then "No Delay"
    else show d & "s"

  anno-type-name : Integer -> Text
  anno-type-name (t) =
    if t == 1 then "Arrow"
    else if t == 2 then "Rectangle"
    else if t == 3 then "Circle"
    else if t == 4 then "Text"
    else "Blur"

  tool-instruction : Integer -> Text
  tool-instruction (t) =
    if t == 0 then "Click to select and move annotations"
    else if t == 1 then "Draw an arrow on the canvas"
    else if t == 2 then "Draw a rectangle on the canvas"
    else if t == 3 then "Draw a circle on the canvas"
    else if t == 4 then "Click to place text on the canvas"
    else "Draw a blur region on the canvas"

  anno-entry : Integer, Integer, Integer, Integer -> Text
  anno-entry (idx) (tool-t) (cx) (cy) =
    show idx & ". " & anno-type-name tool-t & " at (" & show cx & "," & show cy & ")"

  anno-entry-from-state : Integer -> Text
  anno-entry-from-state (idx) =
    let t = state-get ("ann-type-" & show idx)
    in let ax = state-get ("ann-x-" & show idx)
    in let ay = state-get ("ann-y-" & show idx)
    in anno-entry (idx + 1) t ax ay

  file-ext : Integer -> Text
  file-ext (f) =
    if f == 1 then ".png"
    else if f == 2 then ".jpg"
    else if f == 3 then ".bmp"
    else ".qoi"

  current-filename : Integer -> Text
  current-filename (x) =
    let name = state-get-text "file-name"
    in let fmt = let f = state-get "export-format" in if f == 0 then 1 else f
    in if text-length name == 0 then "screenshot-001" & file-ext fmt
    else name & file-ext fmt

  image-dim-text : Integer -> Text
  image-dim-text (x) =
    let w = let wv = state-get "crop-w" in if wv == 0 then 800 else wv
    in let h = let hv = state-get "crop-h" in if hv == 0 then 500 else hv
    in show w & " &#xD7; " & show h & " px"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "capture" "capture" [
      tool-bar 0,
      canvas-area 0,
      props-panel 0
    ]

  tool-btn-class : Integer, Integer -> Text
  tool-btn-class (tool-id) (active) =
    if tool-id == active then "tool-btn active" else "tool-btn"

  tool-bar : Integer -> WidgetNode
  tool-bar (x) =
    let active = state-get "tool-active"
    in widget-box "toolbar" "toolbar" [
      widget-box "t-select" (tool-btn-class 0 active) [widget-button "t-select" "&#x25ED;"],
      widget-button "t-region" "&#x2B1C;",
      widget-button "t-window" "&#x1F5D4;",
      widget-button "t-full" "&#x1F5B5;",
      widget-label "sep1" "",
      widget-box "tb-arrow" (tool-btn-class 1 active) [widget-button "t-arrow" "&#x2197;"],
      widget-box "tb-rect" (tool-btn-class 2 active) [widget-button "t-rect" "&#x25A1;"],
      widget-box "tb-circle" (tool-btn-class 3 active) [widget-button "t-circle" "&#x25CB;"],
      widget-box "tb-text" (tool-btn-class 4 active) [widget-button "t-text" "T"],
      widget-box "tb-blur" (tool-btn-class 5 active) [widget-button "t-blur" "&#x25A8;"],
      widget-label "sep2" "",
      widget-button "t-undo" "&#x21B6;",
      widget-button "t-redo" "&#x21B7;"
    ]

  canvas-area : Integer -> WidgetNode
  canvas-area (x) =
    let has-image = state-get "has-image"
    in let show-grid = state-get "show-grid"
    in let cm = let m = state-get "capture-mode" in capture-mode-name m
    in let dl = let d = state-get "delay-timer" in delay-label d
    in widget-box "canvas-area" "canvas-area" [
      widget-box "canvas-bar" "canvas-toolbar" [
        widget-button "btn-capture" ("&#x1F4F7; " & cm),
        widget-button "btn-open" "Open File",
        widget-button "btn-paste" "Paste",
        widget-label "csep1" "",
        widget-button "btn-zoom-in" "+",
        widget-label "zoom-level" (zoom-text (state-get "zoom-level")),
        widget-button "btn-zoom-out" "-",
        widget-label "csep2" "",
        widget-label "dim-display" (image-dim-text 0),
        widget-label "csep3" "",
        widget-button "btn-save" "Save",
        widget-button "btn-copy" "&#x1F4CB; Copy",
        widget-button "btn-share" "Share"
      ],
      let cur-tool = state-get "tool-active"
    in let fmt = let f = state-get "export-format" in if f == 0 then 1 else f
    in let canvas-status = if has-image == 1
        then if cur-tool == 0 then image-dim-text 0 & " | " & format-name fmt
        else tool-name cur-tool & " - " & tool-instruction cur-tool
        else "No image loaded"
    in if has-image == 1
      then widget-box "canvas" "canvas" [
        widget-box "canvas-img" "canvas-img" [
          widget-label "img" "&#x1F5BC;",
          widget-label "canvas-info" canvas-status,
          if show-grid == 1 then widget-box "grid-ov" "grid-overlay" [] else widget-label "no-grid-ov" ""
        ]
      ]
      else widget-box "canvas" "canvas" [
        widget-box "empty" "canvas-empty" [
          widget-label "empty-icon" "&#x1F4F7;",
          widget-label "empty-text" "No capture yet",
          widget-label "empty-hint" "Press Capture or paste an image"
        ]
      ],
      widget-box "statusbar" "status-bar" [
        widget-label "st-file" ("&#x1F4C4; " & current-filename 0),
        widget-label "st-dim" (image-dim-text 0),
        widget-label "st-fmt" (format-name (let f = state-get "export-format" in if f == 0 then 1 else f)),
        widget-label "st-tool" ("Tool: " & tool-name (state-get "tool-active")),
        widget-label "st-color" ("Color: " & color-name (state-get "anno-color")),
        widget-label "st-delay" ("Delay: " & dl)
      ]
    ]

  props-panel : Integer -> WidgetNode
  props-panel (x) =
    let cur-color = state-get "anno-color"
    in let cur-width = let w = state-get "line-width" in if w == 0 then 2 else w
    in let cur-mode = state-get "capture-mode"
    in let cur-delay = state-get "delay-timer"
    in let anno-ct = state-get "annotation-count"
    in widget-box "props" "props" [
      widget-label "props-hdr" "Properties",
      widget-box "mode-group" "prop-group" [
        widget-label "mode-lbl" "CAPTURE MODE",
        widget-box "modes" "mode-sel" [
          widget-button "mode-full" (capture-mode-icon 0 & " Full"),
          widget-button "mode-win" (capture-mode-icon 1 & " Window"),
          widget-button "mode-reg" (capture-mode-icon 2 & " Region")
        ]
      ],
      widget-box "delay-group" "prop-group" [
        widget-label "delay-lbl" "DELAY TIMER",
        widget-box "delays" "delay-sel" [
          widget-button "delay-0" "0s",
          widget-button "delay-3" "3s",
          widget-button "delay-5" "5s",
          widget-button "delay-10" "10s"
        ]
      ],
      widget-box "color-group" "prop-group" [
        widget-label "color-lbl" "ANNOTATION COLOR",
        widget-box "colors" "color-picker" [
          widget-button "clr-0" ("&#x1F534; " & if cur-color == 0 then "&#x2713;" else ""),
          widget-button "clr-1" ("&#x1F535; " & if cur-color == 1 then "&#x2713;" else ""),
          widget-button "clr-2" ("&#x1F7E2; " & if cur-color == 2 then "&#x2713;" else ""),
          widget-button "clr-3" ("&#x1F7E1; " & if cur-color == 3 then "&#x2713;" else ""),
          widget-button "clr-4" ("&#x26AA; " & if cur-color == 4 then "&#x2713;" else "")
        ]
      ],
      widget-box "width-group" "prop-group" [
        widget-label "width-lbl" "LINE WIDTH",
        widget-box "widths" "width-sel" [
          widget-button "lw-1" "Thin",
          widget-button "lw-2" "Medium",
          widget-button "lw-3" "Thick"
        ]
      ],
      widget-box "grid-group" "prop-group" [
        widget-button "grid-toggle" (if state-get "show-grid" == 1 then "&#x2611; Grid On" else "&#x2610; Grid Off")
      ],
      widget-box "crop-group" "prop-group" [
        widget-label "crop-lbl" "CROP",
        widget-box "crop-w" "prop-row" [
          widget-label "crop-w-l" "W",
          widget-label "crop-w-v" (let w = state-get "crop-w" in if w == 0 then "800" else show w),
          widget-label "crop-w-u" "px"
        ],
        widget-box "crop-h" "prop-row" [
          widget-label "crop-h-l" "H",
          widget-label "crop-h-v" (let h = state-get "crop-h" in if h == 0 then "500" else show h),
          widget-label "crop-h-u" "px"
        ]
      ],
      widget-box "aspect-group" "prop-group" [
        widget-label "aspect-lbl" "ASPECT RATIO",
        widget-box "aspects" "format-grid" [
          widget-button "asp-free" "Free",
          widget-button "asp-1" "1:1",
          widget-button "asp-169" "16:9",
          widget-button "asp-43" "4:3"
        ]
      ],
      widget-box "format-group" "prop-group" [
        widget-label "format-lbl" "EXPORT FORMAT",
        widget-box "formats" "format-grid" [
          widget-button "fmt-png" "PNG",
          widget-button "fmt-jpg" "JPEG",
          widget-button "fmt-bmp" "BMP",
          widget-button "fmt-qoi" "QOI"
        ]
      ],
      widget-box "quality-group" "prop-group" [
        widget-label "quality-lbl" "QUALITY",
        widget-box "quality-ctrl" "prop-row" [
          widget-button "quality-down" "-",
          widget-label "quality-val" (show (let q = state-get "quality" in if q == 0 then 92 else q) & "%"),
          widget-button "quality-up" "+"
        ]
      ],
      widget-box "name-group" "prop-group" [
        widget-label "name-lbl" "FILENAME",
        widget-label "name-val" (current-filename 0)
      ],
      widget-box "anno-group" "prop-group" [
        widget-label "anno-lbl" ("ANNOTATIONS - " & show anno-ct & " annotations"),
        annotation-list anno-ct
      ],
      widget-box "history" "history" [
        widget-label "hist-hdr" "Recent",
        history-item "h0" "&#x1F5BC;" "screenshot-001.png" "Just now &#x2022; 1.2 MB",
        history-item "h1" "&#x1F5BC;" "crop-diagram.png" "10 min ago &#x2022; 340 KB",
        history-item "h2" "&#x1F5BC;" "ui-mockup.jpg" "1 hour ago &#x2022; 890 KB"
      ]
    ]

  annotation-list : Integer -> WidgetNode
  annotation-list (ct) =
    if ct == 0 then widget-label "no-annos" "No annotations"
    else if ct == 1 then widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0)
    ]
    else if ct == 2 then widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0),
      widget-label "a1" (anno-entry-from-state 1)
    ]
    else if ct == 3 then widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0),
      widget-label "a1" (anno-entry-from-state 1),
      widget-label "a2" (anno-entry-from-state 2)
    ]
    else if ct == 4 then widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0),
      widget-label "a1" (anno-entry-from-state 1),
      widget-label "a2" (anno-entry-from-state 2),
      widget-label "a3" (anno-entry-from-state 3)
    ]
    else if ct == 5 then widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0),
      widget-label "a1" (anno-entry-from-state 1),
      widget-label "a2" (anno-entry-from-state 2),
      widget-label "a3" (anno-entry-from-state 3),
      widget-label "a4" (anno-entry-from-state 4)
    ]
    else widget-box "annos" "anno-list" [
      widget-label "a0" (anno-entry-from-state 0),
      widget-label "a1" (anno-entry-from-state 1),
      widget-label "a2" (anno-entry-from-state 2),
      widget-label "a3" (anno-entry-from-state 3),
      widget-label "a4" (anno-entry-from-state 4),
      widget-label "a-more" ("... and " & show (ct - 5) & " more")
    ]

  history-item : Text, Text, Text, Text -> WidgetNode
  history-item (id) (icon) (name) (meta) =
    widget-box id "history-item" [
      widget-label (id & "th") icon,
      widget-box (id & "i") "history-info" [
        widget-label (id & "n") name,
        widget-label (id & "m") meta
      ]
    ]

Section: Handlers

  tool-name : Integer -> Text
  tool-name (t) =
    if t == 0 then "Select"
    else if t == 1 then "Arrow"
    else if t == 2 then "Rectangle"
    else if t == 3 then "Circle"
    else if t == 4 then "Text"
    else "Blur"

  format-name : Integer -> Text
  format-name (f) =
    if f == 1 then "PNG"
    else if f == 2 then "JPEG"
    else if f == 3 then "BMP"
    else "QOI"

  aspect-label : Integer -> Text
  aspect-label (a) =
    if a == 1 then "Free"
    else if a == 2 then "1:1"
    else if a == 3 then "16:9"
    else "4:3"

  crop-w-for-aspect : Integer, Integer -> Integer
  crop-w-for-aspect (aspect) (h) =
    if aspect == 2 then h
    else if aspect == 3 then h * 16 / 9
    else if aspect == 4 then h * 4 / 3
    else 800

  capture-click : Text -> Integer
  capture-click (id) =
    if id == "btn-capture" then
      let s1 = state-set "has-image" 1
      in let s2 = state-set "crop-w" 800
      in let s3 = state-set "crop-h" 500
      in let s4 = state-set "annotation-count" 0
      in let s5 = state-set-render "ann-max" 0 in 0
    else if id == "btn-open" then
      let s1 = state-set "has-image" 1
      in let s2 = state-set "crop-w" 1024
      in let s3 = state-set-render "crop-h" 768 in 0
    else if id == "btn-paste" then
      let s1 = state-set "has-image" 1
      in let s2 = state-set-render "crop-w" 640 in 0
    else if id == "btn-copy" then
      let s = state-set-render "copy-count" (state-get "copy-count" + 1) in 0
    else if id == "t-select" then let s = state-set-render "tool-active" 0 in 0
    else if id == "t-arrow" then
      let s1 = state-set "tool-active" 1
      in let ct = state-get "annotation-count"
      in let s2 = state-set ("ann-type-" & show ct) 1
      in let s3 = state-set ("ann-x-" & show ct) (120 + ct * 40)
      in let s4 = state-set ("ann-y-" & show ct) (80 + ct * 30)
      in let new-ct = ct + 1
      in let s5 = state-set "ann-max" new-ct
      in let s6 = state-set-render "annotation-count" new-ct in 0
    else if id == "t-rect" then
      let s1 = state-set "tool-active" 2
      in let ct = state-get "annotation-count"
      in let s2 = state-set ("ann-type-" & show ct) 2
      in let s3 = state-set ("ann-x-" & show ct) (200 + ct * 40)
      in let s4 = state-set ("ann-y-" & show ct) (150 + ct * 30)
      in let new-ct = ct + 1
      in let s5 = state-set "ann-max" new-ct
      in let s6 = state-set-render "annotation-count" new-ct in 0
    else if id == "t-circle" then
      let s1 = state-set "tool-active" 3
      in let ct = state-get "annotation-count"
      in let s2 = state-set ("ann-type-" & show ct) 3
      in let s3 = state-set ("ann-x-" & show ct) (250 + ct * 40)
      in let s4 = state-set ("ann-y-" & show ct) (180 + ct * 30)
      in let new-ct = ct + 1
      in let s5 = state-set "ann-max" new-ct
      in let s6 = state-set-render "annotation-count" new-ct in 0
    else if id == "t-text" then
      let s1 = state-set "tool-active" 4
      in let ct = state-get "annotation-count"
      in let s2 = state-set ("ann-type-" & show ct) 4
      in let s3 = state-set ("ann-x-" & show ct) (310 + ct * 40)
      in let s4 = state-set ("ann-y-" & show ct) (200 + ct * 30)
      in let new-ct = ct + 1
      in let s5 = state-set "ann-max" new-ct
      in let s6 = state-set-render "annotation-count" new-ct in 0
    else if id == "t-blur" then
      let s1 = state-set "tool-active" 5
      in let ct = state-get "annotation-count"
      in let s2 = state-set ("ann-type-" & show ct) 5
      in let s3 = state-set ("ann-x-" & show ct) (400 + ct * 40)
      in let s4 = state-set ("ann-y-" & show ct) (250 + ct * 30)
      in let new-ct = ct + 1
      in let s5 = state-set "ann-max" new-ct
      in let s6 = state-set-render "annotation-count" new-ct in 0
    else if id == "t-undo" then
      let ct = state-get "annotation-count"
      in if ct > 0 then let s = state-set-render "annotation-count" (ct - 1) in 0 else 0
    else if id == "t-redo" then
      let ct = state-get "annotation-count"
      in let mx = state-get "ann-max"
      in if ct < mx then let s = state-set-render "annotation-count" (ct + 1) in 0 else 0
    else if id == "fmt-png" then let s = state-set-render "export-format" 1 in 0
    else if id == "fmt-jpg" then let s = state-set-render "export-format" 2 in 0
    else if id == "fmt-bmp" then let s = state-set-render "export-format" 3 in 0
    else if id == "fmt-qoi" then let s = state-set-render "export-format" 4 in 0
    else if id == "asp-free" then let s = state-set-render "aspect-mode" 1 in 0
    else if id == "asp-1" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" h
      in let s2 = state-set-render "aspect-mode" 2 in 0
    else if id == "asp-169" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" (h * 16 / 9)
      in let s2 = state-set-render "aspect-mode" 3 in 0
    else if id == "asp-43" then
      let h = state-get "crop-h"
      in let s1 = state-set "crop-w" (h * 4 / 3)
      in let s2 = state-set-render "aspect-mode" 4 in 0
    else if id == "btn-zoom-in" then
      let z = state-get "zoom-level"
      in if z < 8 then let s = state-set-render "zoom-level" (z + 1) in 0 else 0
    else if id == "btn-zoom-out" then
      let z = state-get "zoom-level"
      in if z > 1 then let s = state-set-render "zoom-level" (z - 1) in 0 else 0
    else if id == "btn-save" then
      let s = state-set-render "save-count" (state-get "save-count" + 1) in 0
    else if id == "clr-0" then let s = state-set-render "anno-color" 0 in 0
    else if id == "clr-1" then let s = state-set-render "anno-color" 1 in 0
    else if id == "clr-2" then let s = state-set-render "anno-color" 2 in 0
    else if id == "clr-3" then let s = state-set-render "anno-color" 3 in 0
    else if id == "clr-4" then let s = state-set-render "anno-color" 4 in 0
    else if id == "lw-1" then let s = state-set-render "line-width" 1 in 0
    else if id == "lw-2" then let s = state-set-render "line-width" 2 in 0
    else if id == "lw-3" then let s = state-set-render "line-width" 3 in 0
    else if id == "grid-toggle" then
      let g = state-get "show-grid"
      in let s = state-set-render "show-grid" (if g == 1 then 0 else 1) in 0
    else if id == "mode-full" then let s = state-set-render "capture-mode" 0 in 0
    else if id == "mode-win" then let s = state-set-render "capture-mode" 1 in 0
    else if id == "mode-reg" then let s = state-set-render "capture-mode" 2 in 0
    else if id == "delay-0" then let s = state-set-render "delay-timer" 0 in 0
    else if id == "delay-3" then let s = state-set-render "delay-timer" 3 in 0
    else if id == "delay-5" then let s = state-set-render "delay-timer" 5 in 0
    else if id == "delay-10" then let s = state-set-render "delay-timer" 10 in 0
    else if id == "quality-up" then
      let q = let qv = state-get "quality" in if qv == 0 then 92 else qv
      in if q < 100 then let nq = if q + 5 > 100 then 100 else q + 5
        in let s = state-set-render "quality" nq in 0 else 0
    else if id == "quality-down" then
      let q = let qv = state-get "quality" in if qv == 0 then 92 else qv
      in if q > 10 then let nq = if q - 5 < 10 then 10 else q - 5
        in let s = state-set-render "quality" nq in 0 else 0
    else 0

Section: Entry

  render-capture : Integer -> Integer
  render-capture (x) = mount-widget-themed capture-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style capture-theme capture-css
    in let s01 = state-set "tool-active" 0
    in let s02 = state-set "has-image" 0
    in let s03 = state-set "show-grid" 0
    in let s04 = state-set "capture-mode" 0
    in let s05 = state-set "delay-timer" 0
    in let s06 = state-set "zoom-level" 0
    in let s07 = state-set "export-format" 0
    in let s08 = state-set "anno-color" 0
    in let s09 = state-set "line-width" 0
    in let s10 = state-set "annotation-count" 0
    in let s11 = state-set "crop-w" 0
    in let s12 = state-set "crop-h" 0
    in let s13 = state-set "quality" 0
    in let s14 = state-set "ann-max" 0
    in let s15 = state-set "copy-count" 0
    in let s16 = state-set "save-count" 0
    in let s17 = state-set "aspect-mode" 0
    in let s18 = state-set-text "file-name" ""
    in let s = set-render render-capture
    in let h = register-handlers no-pick capture-click
    in render-capture 0
  end

