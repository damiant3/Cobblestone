Section: Request Contract

  AccpRequest = record {
    op : Text,
    source : Text,
    input : Text,
    id : Text,
    ms : Integer,
    stdout-limit : Integer,
    library : Text,
    output : Text,
    prose : Boolean,
    lease : Text,
    why : Text
  }

  ap-bad : Text -> AccpRequest
  ap-bad (why) = AccpRequest {
    op = "",
    source = "\"\"",
    input = "\"\"",
    id = "",
    ms = 2000,
    stdout-limit = 65536,
    library = "none",
    output = "text",
    prose = False,
    lease = "",
    why = why
  }

  ap-known-fields : List AccpField, Integer -> Boolean
  ap-known-fields (fs) (i) =
    if i >= list-length fs then True
    else let k = (list-at fs i).key
    in if k == "op" | k == "source" | k == "input" | k == "id" | k == "limits" | k == "lease" | k == "plug" | k == "library" | k == "output" | k == "prose" | k == "requester" | k == "signature" | k == "nonce" | k == "issued_at" | k == "question" | k == "label" | k == "policy"
      then ap-known-fields fs (i + 1) else False

  ap-string-size : Text, Boolean -> Integer
  ap-string-size (s) (no-nul) =
    if text-length s < 2 | aj-is s 0 "\"" == False then -1
    else ap-string-size-loop s 1 0 no-nul

  ap-string-size-loop : Text, Integer, Integer, Boolean -> Integer
  ap-string-size-loop (s) (i) (count) (no-nul) =
    if i >= text-length s - 1 then count
    else if count > 65536 then count
    else if aj-is s i "\\" then
      let u = if aj-is s (i + 1) "u" then aj-quad s (i + 2) else 32
      in if no-nul & u == 0 then -1
      else let pair = u >= 55296 & u <= 56319
      in let size = if pair then 4 else if u < 128 then 1 else if u < 2048 then 2 else 3
      in let next = if pair then i + 12 else if aj-is s (i + 1) "u" then i + 6 else i + 2
      in ap-string-size-loop s next (count + size) no-nul
    else ap-string-size-loop s (i + 1) (count + 1) no-nul

  ap-request : Text -> AccpRequest
  ap-request (line) =
    let o = aj-object line
    in if o.ok == False then ap-bad "invalid JSON object or duplicate property"
    else if ap-known-fields o.fields 0 == False then ap-bad "unknown request field"
    else if aj-get o "lease" /= "" & aj-text o "op" /= "run" then ap-bad "lease is only valid for run"
    else if aj-get o "lease" /= "" & (ap-string-size (aj-get o "lease") True < 0 | text-length (aj-get o "lease") > 16386) then
      ap-bad "lease must be a string of at most 16384 hex digits"
    else let op = aj-text o "op"
    in let library-raw = aj-get o "library"
    in let library = if library-raw == "" then "none" else aj-text o "library"
    in let output-raw = aj-get o "output"
    in let output = if output-raw == "" then "text" else aj-text o "output"
    in let id = aj-get o "id"
    in let source = aj-get o "source"
    in let input = aj-get o "input"
    in let ls = aj-get o "limits"
    in let limits = aj-object (if ls == "" then "{}" else ls)
    in let ms-raw = aj-get limits "ms"
    in let out-raw = aj-get limits "stdout_bytes"
    in let ms = if ms-raw == "" then 2000 else aj-int ms-raw
    in let out = if out-raw == "" then 65536 else aj-int out-raw
    in let limit-count = (if ms-raw == "" then 0 else 1) + (if out-raw == "" then 0 else 1)
    in if limits.ok == False | list-length limits.fields > limit-count
      then ap-bad "invalid limits object"
    else if ms <= 0 | ms > 10000 | out <= 0 | out > 65536 then ap-bad "limits exceed host bounds"
    else if id /= "" & (ap-string-size id False < 0 | text-length id > 1024) then
      ap-bad "id must be a bounded string"
    else if op /= "check" & op /= "run" & op /= "lens" & op /= "describe" & op /= "challenge" & op /= "policy" then
      ap-bad "unsupported op"
    else if op /= "policy" & (aj-get o "question" /= "" | aj-get o "label" /= "" | aj-get o "policy" /= "") then
      ap-bad "question, label and policy are only valid for the policy op"
    else if op == "policy" & (library-raw /= "" | source /= "" | input /= "" | aj-get o "plug" /= "" | output-raw /= "" | aj-get o "prose" /= "") then
      ap-bad "policy takes no program"
    else if op == "policy" & aj-text o "question" /= "can-allow" & aj-text o "question" /= "widens" & aj-text o "question" /= "dead-rules" then
      ap-bad "question must be can-allow, widens or dead-rules"
    else if op == "policy" & (aj-text o "question" == "can-allow") /= (aj-get o "label" /= "") then
      ap-bad "label is required by can-allow and valid for no other question"
    else if op == "policy" & aj-get o "label" /= "" & (ap-string-size (aj-get o "label") True < 1 | ap-string-size (aj-get o "label") True > 256) then
      ap-bad "label must be a NUL-free string of 1 to 256 bytes"
    else if op == "policy" & (aj-text o "question" == "widens") /= (aj-get o "policy" /= "") then
      ap-bad "policy is required by widens and valid for no other question"
    else if op == "policy" & aj-get o "policy" /= "" & (ap-string-size (aj-get o "policy") True < 1 | ap-string-size (aj-get o "policy") True > 65536) then
      ap-bad "policy must be a NUL-free string of 1 to 65536 bytes"
    else if (op == "describe" | op == "challenge") & ar-carries o then ap-bad (op & " is not signed")
    else if op == "challenge" & (library-raw /= "" | source /= "" | input /= "" | aj-get o "plug" /= "" | ls /= "") then
      ap-bad "challenge takes no program"
    else if library /= "none" & library /= "math" & library /= "physics" & library /= "experiment" & library /= "exact" then
      ap-bad "unknown library; choose none, math, physics, experiment or exact"
    else if output /= "text" & output /= "json" then ap-bad "output must be text or json"
    else if op /= "run" & output-raw /= "" then ap-bad "output is only valid for run"
    else if op == "describe" & library-raw /= "" then ap-bad "describe takes no library"
    else if op == "describe" & (source /= "" | input /= "" | aj-get o "plug" /= "") then
      ap-bad "describe takes no program"
    else if op /= "describe" & op /= "challenge" & op /= "policy" & (ap-string-size source True < 0 | ap-string-size source True > 65536) then
      ap-bad "source must be a NUL-free string within source_bytes"
    else if input /= "" & (op /= "run" | ap-string-size input False < 0 | ap-string-size input False > 65536) then
      ap-bad "invalid input or input_bytes exceeded"
    else if op == "lens" & aj-text o "plug" /= "wasm" then ap-bad "only the wasm lens is supported"
    else if op /= "lens" & aj-get o "plug" /= "" then ap-bad "plug is only valid for lens"
    else if aj-get o "prose" /= "" & aj-get o "prose" /= "true" & aj-get o "prose" /= "false" then ap-bad "prose must be true or false"
    else if op /= "check" & aj-get o "prose" /= "" then ap-bad "prose is only valid for check"
    else
      AccpRequest {
        op = op,
        source = if source == "" then "\"\"" else source,
        input = if input == "" then "\"\"" else input,
        id = id,
        ms = ms,
        stdout-limit = out,
        library = library,
        output = output,
        prose = aj-get o "prose" == "true",
        lease = if aj-get o "lease" == "" then "" else aj-text o "lease",
        why = ""
      }

Section: Adapter Wire

  ap-call : Text -> [Console] AccpObject
  ap-call (message) = act
    print-line-uni message
    answer <- read-line
    when answer
      is Just (s) -> aj-object s
      is None -> AccpObject { fields = [], ok = False }
  end

  ap-error : Text, Text, Text -> Text
  ap-error (status) (stage) (why) = "{\"status\":" & aj-quote status & ",\"stage\":" & aj-quote stage & ",\"reason\":" & aj-quote why & "}"

  ap-step-error : AccpObject, Text -> Text
  ap-step-error (r) (stage) =
    if r.ok == False then ap-error "error" stage "adapter response missing or malformed"
    else let status = aj-text r "status"
    in let base = ap-error (if status == "timeout" | status == "trapped" | status == "refused" then status else "error") stage (aj-text r "reason")
    in if stage == "run" & aj-get r "bytes" /= "" then
      "{" & ap-fields base & ",\"stdout\":" & aj-get r "text" & ",\"stdout_base64\":" & aj-get r "bytes" & ",\"output_sha256\":" & aj-get r "sha256" & "}"
    else base

  ap-limits : AccpRequest -> Text
  ap-limits (r) = "{\"ms\":" & show r.ms & ",\"stdout_bytes\":" & show r.stdout-limit & "}"

  ap-fields : Text -> Text
  ap-fields (obj) = if text-length obj < 2 then "" else substring obj 1 (text-length obj - 2)

  ap-response-id : Text, AccpRequest -> Text
  ap-response-id (line) (req) =
    if req.id /= "" then req.id
    else let o = aj-object line
    in let id = aj-get o "id"
    in if o.ok & ap-string-size id False >= 0 & text-length id <= 1024 then id else ""

  ap-metadata : Text, Text, Text -> Text
  ap-metadata (meta) (id) (response) =
    "{" & ap-fields response & "," & ap-fields meta & (if id == "" then "" else ",\"id\":" & id) & "}"

Section: Compiler Output

  AccpCompile = record { ir : Text, diagnostics : List Text, ok : Boolean }

  ap-line-end : Text, Integer -> Integer
  ap-line-end (s) (i) = if i >= text-length s then i else if aj-is s i "\n" then i else ap-line-end s (i + 1)

  ap-contains : Text, Text -> Boolean
  ap-contains (s) (needle) = ap-contains-loop s needle 0

  ap-contains-loop : Text, Text, Integer -> Boolean
  ap-contains-loop (s) (needle) (i) =
    if i + text-length needle > text-length s then False
    else if substring s i (text-length needle) == needle then
      True
    else ap-contains-loop s needle (i + 1)

  ap-compile : Text -> AccpCompile
  ap-compile (s) = ap-compile-lines s 0 -1 -1 0 []

  ap-compile-lines : Text, Integer, Integer, Integer, Integer, List Text -> AccpCompile
  ap-compile-lines (s) (i) (start) (stop) (blocks) (diags) =
    if i >= text-length s then
      AccpCompile {
        ir = if start >= 0 & stop >= start then substring s start (stop - start) else "",
        diagnostics = diags,
        ok = blocks == 2 & start >= 0 & stop > start
      }
    else let stop-line = ap-line-end s i
    in let line = substring s i (stop-line - i)
    in if line == "IR-BEGIN" then
      if blocks /= 0 then AccpCompile { ir = "", diagnostics = diags, ok = False }
      else ap-compile-lines s (stop-line + 1) (stop-line + 1) stop 1 diags
    else if line == "IR-END" then
      if blocks /= 1 then AccpCompile { ir = "", diagnostics = diags, ok = False }
      else ap-compile-lines s (stop-line + 1) start i 2 diags
    else let ds = if blocks /= 1 & (ap-contains line "error CDX" | ap-contains line "CODEGEN") then
      list-push diags line
    else diags
    in ap-compile-lines s (stop-line + 1) start stop blocks ds

Section: Pipeline

  ap-row : AccpAdmission -> Text
  ap-row (a) = "\"row\":" & ai-json-list a.row & ",\"scopes\":" & ai-json-list a.scopes

  ap-with-row : Text, AccpAdmission -> Text
  ap-with-row (response) (a) = "{" & ap-fields response & "," & ap-row a & "}"

  ap-source : AccpRequest -> [Console] AccpObject
  ap-source (req) = act
    if req.library == "none" | req.why /= "" then
      aj-object ("{\"status\":\"ok\",\"source\":" & req.source & "}")
    else act
      bundle <- ap-call ("{\"bridge\":\"library\",\"name\":" & aj-quote req.library & "}")
      if bundle.ok == False | aj-text bundle "status" /= "ok" then
        aj-object (ap-error "error" "library" "library artifact unavailable")
      else let library-source = aj-get bundle "source"
      in let source = "\"" & substring library-source 1 (text-length library-source - 2) & "\\n" & substring req.source 1 (text-length req.source - 2) & "\""
      in if ap-string-size source True > 65536 then
        aj-object (ap-error "refused" "library" "combined library and caller source exceeds source_bytes")
      else aj-object ("{\"status\":\"ok\",\"source\":" & source & "}")
    end
  end

  ap-prose-lines : Text, Integer, List Text -> List Text
  ap-prose-lines (s) (i) (acc) =
    if i >= text-length s then acc
    else let stop = ap-line-end s i
    in let line = substring s i (stop - i)
    in ap-prose-lines s (stop + 1) (if ap-contains line "warning CDX11" & list-length acc < 64 then list-push acc line else acc)

  ap-lease-refused : AccpAdmission, Text, Text -> Text
  ap-lease-refused (a) (why) (lease) =
    "{\"status\":\"refused\",\"stage\":\"admission\",\"reason\":" & aj-quote why & "," & ap-row a & ",\"needs\":" & ai-json-list (ai-needs a)
      & (if lease == "" then "" else ",\"lease\":" & lease) & "}"

  ap-flow-refused : AccpAdmission, FlowVerdict, Text, Text, Text -> Text
  ap-flow-refused (a) (v) (lease) (analysis) (second) =
    "{\"status\":\"refused\",\"stage\":\"flow\",\"reason\":" & aj-quote (v.reason) & "," & ap-row a & ",\"flow\":" & afl-pairs-json (v.pairs)
      & ",\"analysis\":" & analysis & second & ",\"lease\":" & lease & "}"

  ap-raw-refused : AccpAdmission, List Text, Text -> Text
  ap-raw-refused (a) (raw) (lease) =
    "{\"status\":\"refused\",\"stage\":\"flow\",\"reason\":\"program names raw memory under a flow rule\"," & ap-row a
      & ",\"needs\":[\"no raw memory under a flow rule\"],\"raw\":" & ai-json-list raw & ",\"lease\":" & lease & "}"

  ap-leased : AccpRequest, Text, AccpAdmission, AccpBinding -> [Console] Text
  ap-leased (req) (ir) (a) (b) = act
    when ag-unhex req.lease
      is None -> ap-lease-refused a "lease is not lowercase hex" ""
      is Just (bs) ->
        when decode-grant-checked bs
          is None -> ap-lease-refused a "lease is not a canonical grant encoding" ""
          is Just (g) -> act
            clock <- ap-call "{\"bridge\":\"now\"}"
            held <- ap-call "{\"bridge\":\"policy\"}"
            let seconds = aj-get clock "seconds"
            in let week-minute = aj-get clock "week_minute"
            in let pol = if held.ok & aj-text held "status" == "ok" then ag-policy-from (aj-text held "text") (aj-text held "name_book") (g.grantor.public-key) else None
            in let why = if clock.ok == False | seconds == "" | week-minute == "" then "host clock unavailable"
            else ag-admit-held b g (ag-seconds seconds) (aj-int week-minute) pol (if held.ok & aj-text held "status" == "ok" then ag-policy-unread (aj-text held "text") else "") a.row a.scopes
            in if why /= "" then ap-lease-refused a why (ag-lease-json g)
            else let fv = afl-check (g.flow-rules) a.row a.scopes
            in if fv.ok == False & list-length (fv.pairs) == 0 then ap-flow-refused a fv (ag-lease-json g) (afi-json (afi-analyse (g.flow-rules) ir)) ""
            else if fv.ok == False then ap-flow-ruled req ir a g pol (aj-int week-minute) fv
            else ap-leased-run req ir a g pol (aj-int week-minute) ""
          end
  end

  ap-flow-ruled : AccpRequest, Text, AccpAdmission, GrantMsg, Maybe Policy, Integer, FlowVerdict -> [Console] Text
  ap-flow-ruled (req) (ir) (a) (g) (pol) (wm) (fv) = act
    let first = afi-analyse (g.flow-rules) ir
    in let second = afc-check (g.flow-rules) ir
    in let both = ",\"analysis\":" & afi-json first & ",\"analysis_second\":" & aj-quote second
    in if first.verdict == "no path" & second == "no path" then ap-leased-run req ir a g pol wm both
    else ap-flow-refused a fv (ag-lease-json g) (afi-json first) (",\"analysis_second\":" & aj-quote second)
  end

  ap-leased-run : AccpRequest, Text, AccpAdmission, GrantMsg, Maybe Policy, Integer, Text -> [Console] Text
  ap-leased-run (req) (ir) (a) (g) (pol) (wm) (flow) = act
    let raw = afl-raw-check (g.flow-rules) ir
    in if list-length raw > 0 then ap-raw-refused a raw (ag-lease-json g)
    else let q = ag-quota-of pol g wm a.row a.scopes
    in if q.found == False then act
      ran <- ap-lens-run req ir a
      "{" & ap-fields ran & ",\"lease\":" & ag-lease-json g & flow & "}"
    end
    else act
      usage <- ap-call ("{\"bridge\":\"quota\",\"grantor\":" & aj-quote (ag-hex (g.grantor.public-key)) & ",\"holder\":" & aj-quote (ag-hex (g.from.public-key))
        & ",\"rule\":" & aj-quote (q.rule) & ",\"period\":" & aj-quote (q.period) & ",\"lease_id\":" & aj-quote (ag-hex (g.id)) & ",\"minutes\":" & show (q.minutes) & "}")
      let spent = aj-get usage "spent_ms"
      in let over = ag-quota-refusal q (if usage.ok then aj-text usage "status" else "") spent
      in if over /= "" then ap-lease-refused a over (ag-lease-json g)
      else act
        ran <- ap-lens-run req ir a
        "{" & ap-fields ran & ",\"lease\":" & ag-lease-json g & flow & ",\"quota\":{\"rule\":" & aj-quote (q.rule) & ",\"minutes\":" & show (q.minutes) & ",\"period\":" & aj-quote (q.period) & ",\"spent_ms_before\":" & spent & "}}"
      end
    end
  end

  ap-challenged : AccpRequest, Text, AccpAdmission, AccpBinding, Text -> [Console] Text
  ap-challenged (req) (ir) (a) (b) (nonce) = act
    spent <- ap-call ("{\"bridge\":\"spend\",\"nonce\":" & aj-quote nonce & "}")
    if spent.ok & aj-text spent "status" == "ok" then ap-leased req ir a b
    else ap-lease-refused a "a leased run's nonce must be a challenge this instance issued and has not spent" ""
  end

  ap-policy-ask : Text, AccpBinding -> [Console] Text
  ap-policy-ask (line) (b) = act
    held <- ap-call "{\"bridge\":\"policy\"}"
    apq-ask line b (if held.ok & aj-text held "status" == "ok" then aj-text held "text" else "") (if held.ok then aj-text held "name_book" else "")
  end

  ap-dispatch : AccpRequest, Text, Text, AccpBinding, Text -> [Console] Text
  ap-dispatch (req) (line) (source) (b) (nonce) = act
    if req.op == "policy" then ap-policy-ask line b else ap-run req source b nonce
  end

  ap-authed-run : AccpRequest, Text, Text, Text, AccpBinding -> [Console] Text
  ap-authed-run (req) (line) (meta) (source) (b) = act
    if ar-request-bound meta == False then
      (if ar-carries (aj-object line) then ap-error "refused" "request" "requester, signature, nonce and issued_at are only valid on a request-bound instance"
      else ap-dispatch req line source b "")
    else act
      clock <- ap-call "{\"bridge\":\"now\"}"
      let auth = ar-authenticate line b (if clock.ok then ag-seconds (aj-get clock "seconds") else 0 - 1)
      in if auth.why /= "" then ap-error "refused" "authentication" auth.why
      else act
        seen <- ap-call ("{\"bridge\":\"nonce\",\"nonce\":" & aj-quote auth.nonce & "}")
        if seen.ok == False | aj-text seen "status" /= "ok" then
          ap-error "refused" "authentication" (if seen.ok then aj-text seen "reason" else "nonce table unavailable")
        else act
          ran <- ap-dispatch req line source (ar-as-requester b auth.requester) auth.nonce
          "{" & ap-fields ran & ",\"requester\":" & aj-quote auth.requester & "}"
        end
      end
    end
  end

  ap-challenge : Text -> [Console] Text
  ap-challenge (meta) = act
    if ar-request-bound meta == False then ap-error "refused" "request" "challenge is only valid on a request-bound instance"
    else act
      issued <- ap-call "{\"bridge\":\"challenge\"}"
      if issued.ok & aj-text issued "status" == "ok" then
        "{\"status\":\"ok\",\"nonce\":" & aj-quote (aj-text issued "nonce") & ",\"expires_in\":60}"
      else ap-error "refused" "challenge" (if issued.ok then aj-text issued "reason" else "challenge unavailable")
    end
  end

  ap-run : AccpRequest, Text, AccpBinding, Text -> [Console] Text
  ap-run (req) (source) (binding) (nonce) = act
    compiled <- ap-call ("{\"bridge\":\"compile\",\"source\":" & source & ",\"prose\":" & (if req.prose then "true" else "false") & ",\"limits\":" & ap-limits req & "}")
    if aj-text compiled "status" /= "ok" then ap-step-error compiled "compile"
    else let c = ap-compile (aj-text compiled "text")
    in if list-length c.diagnostics > 0 then
      "{\"status\":\"diagnostics\",\"diagnostics\":" & ai-json-list c.diagnostics & "}"
    else if c.ok == False then ap-error "error" "compile" "missing or malformed IR frame"
    else let a = ai-admit c.ir
    in if a.ok == False then ap-error "refused" "admission" a.reason
    else if req.op == "check" then
      "{\"status\":\"ok\",\"diagnostics\":[]," & ap-row a & ",\"outside_ambient\":" & ai-json-list (ai-needs a) & (if req.prose then ",\"prose_findings\":" & ai-json-list (ap-prose-lines (aj-text compiled "text") 0 []) else "") & "}"
    else if list-length (ai-needs a) > 0 then
      (if req.lease == "" then "{\"status\":\"refused\",\"stage\":\"admission\"," & ap-row a & ",\"needs\":" & ai-json-list (ai-needs a) & "}"
      else if nonce /= "" then ap-challenged req c.ir a binding nonce
      else ap-leased req c.ir a binding)
    else if req.lease /= "" then ap-error "refused" "admission" "lease presented for a run that needs none"
    else ap-lens-run req c.ir a
  end

  ap-lens-run : AccpRequest, Text, AccpAdmission -> [Console] Text
  ap-lens-run (req) (ir) (admission) = act
    lens <- ap-call ("{\"bridge\":\"lens\",\"ir\":" & aj-quote ir & "}")
    if aj-text lens "status" /= "ok" then ap-with-row (ap-step-error lens "lens") admission
    else if req.op == "lens" then
      "{\"status\":\"ok\",\"wat\":" & aj-get lens "text" & "," & ap-row admission & "}"
    else act
      assembled <- ap-call ("{\"bridge\":\"assemble\"}")
      if aj-text assembled "status" /= "ok" then
        ap-with-row (ap-step-error assembled "assemble") admission
      else if ab-admit (aj-text assembled "wasm") == False then
        ap-error "refused" "imports" "module has malformed or forbidden imports"
      else act
        ran <- ap-call ("{\"bridge\":\"execute\",\"input\":" & req.input & "}")
        if aj-text ran "status" /= "ok" then ap-with-row (ap-step-error ran "run") admission
        else ap-output req ran admission
      end
    end
  end

Section: Completion

  ap-json-compact : Text, Integer, Integer, List Text -> Text
  ap-json-compact (s) (i) (start) (parts) =
    if i >= text-length s then text-concat-list (list-push parts (substring s start (i - start)))
    else if aj-is s i "\"" then ap-json-compact s (aj-string s i).next start parts
    else if aj-space (aj-at s i) then
      ap-json-compact s (i + 1) (i + 1) (list-push parts (substring s start (i - start)))
    else ap-json-compact s (i + 1) start parts

  ap-output : AccpRequest, AccpObject, AccpAdmission -> Text
  ap-output (req) (ran) (admission) =
    let raw = aj-text ran "text"
    in let parsed = if req.output == "json" then aj-object raw else aj-object "{}"
    in let status = if parsed.ok then
      "\"status\":\"ok\""
    else
      "\"status\":\"error\",\"stage\":\"result\",\"reason\":\"stdout must contain exactly one valid JSON object\""
    in "{" & status & ",\"stdout\":" & aj-get ran "text" & ",\"stdout_base64\":" & aj-get ran "bytes" & ",\"output_sha256\":" & aj-get ran "sha256"
      & (if req.output == "json" & parsed.ok then ",\"result\":" & ap-json-compact raw 0 0 [] else "") & "," & ap-row admission & "}"

  ap-null : AccpObject, Text -> Text
  ap-null (o) (key) = let v = aj-get o key in if v == "" then "null" else v

  ap-decision-fields : Text -> Text
  ap-decision-fields (answer) =
    let o = aj-object answer
    in ",\"row\":" & ap-null o "row" & ",\"scopes\":" & ap-null o "scopes"
      & ",\"needs\":" & ap-null o "needs" & ",\"flow\":" & ap-null o "flow" & ",\"raw\":" & ap-null o "raw" & ",\"analysis\":" & ap-null o "analysis" & ",\"analysis_second\":" & ap-null o "analysis_second" & ",\"stage\":" & ap-null o "stage"
      & ",\"reason\":" & ap-null o "reason" & ",\"output_sha256\":" & ap-null o "output_sha256"
      & ",\"grant\":{\"ambient\":[\"Console\"],\"lease\":" & ap-null o "lease" & (if aj-get o "requester" == "" then "" else ",\"requester\":" & aj-get o "requester") & "}"

  ap-describe : Text
  ap-describe = "{\"status\":\"ok\",\"protocol\":\"accp-1\",\"ambient\":[\"Console\"],\"evidence\":\"artifact-digests-only\",\"limits\":{\"frame_bytes\":262144,\"source_bytes\":65536,\"input_bytes\":65536,\"ms\":10000,\"stdout_bytes\":65536,\"intermediate_bytes\":16777216,\"program_memory_bytes\":67108864,\"compiler_memory_bytes\":536870912,\"concurrency\":1}}"

  ap-evaluate : Text, Text, Text, Integer, Boolean -> [Console] AccpObject
  ap-evaluate (meta) (header) (line) (heap-base) (defer-response) = act
    let req = ap-request line
    in act
      prepared <- ap-source req
      hashes <- ap-call ("{\"bridge\":\"hash-inputs\",\"source\":" & req.source & ",\"input\":" & req.input & ",\"compiled_source\":" & (if req.why == "" & req.op /= "describe" & req.op /= "challenge" & req.op /= "policy" & aj-text prepared "status" == "ok" then aj-get prepared "source" else "null") & "}")
      answer <- if req.why /= "" then ap-error "refused" "request" req.why
      else if req.op == "describe" then ap-describe
      else if req.op == "challenge" then ap-challenge meta
      else if aj-text prepared "status" /= "ok" then
        ap-error (aj-text prepared "status") "library" (aj-text prepared "reason")
      else ap-authed-run req line meta (aj-get prepared "source") (ag-binding meta)
      receipt <- ap-call "{\"bridge\":\"clock\"}"
      let library-fields = ",\"library\":" & aj-quote req.library & ",\"compiled_source_sha256\":" & aj-get hashes "compiled_source_sha256"
      in let response = ap-metadata meta (ap-response-id line req) ("{" & ap-fields answer & library-fields & ",\"ms\":" & (if receipt.ok then aj-get receipt "ms" else "{}") & "}")
      in act
        digest <- ap-call ("{\"bridge\":\"digest-response\",\"response\":" & response & "}")
        let h = aj-object header
        in let src-hash = if req.why == "" then aj-get hashes "source_sha256" else "null"
        in let input-hash = if req.why == "" then aj-get hashes "input_sha256" else "null"
        in let chain = "{\"version\":1,\"previous\":" & aj-get h "previous" & ",\"request_sha256\":" & aj-get h "request_sha256"
        in let inputs = ",\"source_sha256\":" & src-hash & ",\"input_sha256\":" & input-hash & library-fields
        in let outcome = ",\"response_sha256\":" & aj-get digest "sha256" & ",\"status\":" & aj-get (aj-object answer) "status"
        in let limits = ",\"compiler_mode\":\"IR-UNI decks=12" & (if req.prose then " prose" else "") & "\",\"limits\":" & ap-limits req & "," & ap-fields meta & "}"
        in let fact-text = chain & inputs & outcome & ap-decision-fields answer & limits
        in let heap-used = __heap-save - heap-base
        in act
          ap-call ("{\"bridge\":\"record\",\"record\":" & fact-text & ",\"response\":" & response & ",\"defer_response\":" & (if defer-response then "true" else "false") & ",\"heap_start\":" & show heap-base & ",\"heap_bytes\":" & show heap-used & "}")
        end
      end
    end
  end

  ap-serve-one : Text, Text, Text, Integer -> [Console] Boolean
  ap-serve-one (meta) (header) (line) (heap-base) = act
    ack <- ap-evaluate meta header line heap-base False
    aj-text ack "status" == "ok"
  end

  ap-loop : Text -> [Console] Nothing
  ap-loop (meta) = act
    let base = __heap-save
    in act
      header <- read-line
      when header
        is None -> print-uni ""
        is Just (h) -> act
          line <- read-line
          when line
            is None -> print-uni ""
            is Just (s) -> act
              keep <- ap-serve-one meta h s base
              let reclaimed = __heap-restore base
              in if keep then ap-loop meta else print-uni ""
            end
        end
    end
  end

