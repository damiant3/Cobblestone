Chapter: AccpPhysics
  cites Accp chapter AccpMath

Section: SI Mechanics

  physics-position : Real, Real, Real, Real -> MathResult
  physics-position (x0) (velocity) (acceleration) (seconds) =
    if math-finite x0 == False | math-finite velocity == False | math-finite acceleration == False | math-finite seconds == False | seconds < 0.0 then MathError "position requires finite inputs and nonnegative elapsed time"
    else math-result (x0 + velocity * seconds + 0.5 * acceleration * seconds * seconds)

  physics-force : Real, Real -> MathResult
  physics-force (mass) (acceleration) =
    if math-finite mass == False | math-finite acceleration == False | mass < 0.0 then MathError "force requires finite inputs and nonnegative mass"
    else math-result (mass * acceleration)

  physics-kinetic-energy : Real, Real -> MathResult
  physics-kinetic-energy (mass) (speed) =
    if math-finite mass == False | math-finite speed == False | mass < 0.0 | speed < 0.0 then MathError "mass and speed must be finite and nonnegative"
    else math-result (0.5 * mass * speed * speed)

  physics-gravity-force : Real, Real, Real, Real -> MathResult
  physics-gravity-force (gravitational-constant) (mass-a) (mass-b) (distance) =
    if math-finite gravitational-constant == False | math-finite mass-a == False | math-finite mass-b == False | math-finite distance == False then MathError "gravity requires finite inputs"
    else if gravitational-constant <= 0.0 | mass-a < 0.0 | mass-b < 0.0 | distance <= 0.0 then MathError "gravity requires positive G and distance, nonnegative masses"
    else math-result (gravitational-constant * mass-a / distance * mass-b / distance)

  physics-orbital-speed : Real, Real -> MathResult
  physics-orbital-speed (mu) (radius) =
    if math-finite mu == False | math-finite radius == False | mu <= 0.0 | radius <= 0.0 then MathError "orbit requires positive finite gravitational parameter and radius"
    else math-sqrt (mu / radius)

  physics-projectile-range : Real, Real, Real -> MathResult
  physics-projectile-range (speed) (angle) (gravity) =
    if math-finite speed == False | math-finite angle == False | math-finite gravity == False | speed < 0.0 | angle < 0.0 | angle > math-pi * 0.5 | gravity <= 0.0 then MathError "projectile requires finite nonnegative speed, angle in [0,pi/2], positive gravity"
    else math-result (speed * speed / gravity * real-sin (2.0 * angle))

Section: Oscillation and Waves

  physics-spring-period : Real, Real -> MathResult
  physics-spring-period (mass) (stiffness) =
    if math-finite mass == False | math-finite stiffness == False | mass <= 0.0 | stiffness <= 0.0 then MathError "spring requires positive finite mass and stiffness"
    else when math-sqrt (mass / stiffness)
      is MathError (why) -> MathError why
      is MathValue (r) -> math-result (2.0 * math-pi * r)

  physics-wave-speed : Real, Real -> MathResult
  physics-wave-speed (frequency) (wavelength) =
    if math-finite frequency == False | math-finite wavelength == False | frequency <= 0.0 | wavelength <= 0.0 then MathError "frequency and wavelength must be finite and positive"
    else math-result (frequency * wavelength)

Section: Circuits and Thermal Energy

  physics-ohm-current : Real, Real -> MathResult
  physics-ohm-current (voltage) (resistance) =
    if math-finite voltage == False | math-finite resistance == False | resistance <= 0.0 then MathError "Ohm current requires finite voltage and positive finite resistance"
    else math-result (voltage / resistance)

  physics-heat : Real, Real, Real -> MathResult
  physics-heat (mass) (specific-heat) (temperature-change) =
    if math-finite mass == False | math-finite specific-heat == False | math-finite temperature-change == False | mass < 0.0 | specific-heat <= 0.0 then MathError "heat requires finite inputs, nonnegative mass and positive specific heat"
    else math-result (mass * specific-heat * temperature-change)

