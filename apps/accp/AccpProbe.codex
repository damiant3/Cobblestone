Chapter: AccpProbe
  cites Accp chapter AccpProtocol
  cites Foreword chapter Ed25519
  cites Foreword chapter Maybe

Section: Proof Interface

 The signing secret is RFC 8032 section 7.1 TEST 2, the requester key of the
 test.ps1 request-binding arms.

  probe-secret : List Integer = [76, 205, 8, 155, 40, 255, 150, 218, 157, 182, 195, 70, 236, 17, 78, 15, 91, 138, 49, 159, 53, 171, 166, 36, 218, 140, 246, 237, 79, 184, 166, 251]

  probe-one : Text -> [Console] Nothing
  probe-one (line) = act
    let o = aj-object line
    in let op = aj-text o "op"
    in if op == "ir" then
      let a = ai-admit (aj-text o "text")
      in print-line-uni ("{\"ok\":" & (if a.ok then "true" else "false") & ",\"reason\":" & aj-quote a.reason & ",\"needs\":" & ai-json-list (ai-needs a) & "}")
    else if op == "wasm" then
      print-line-uni (if ab-admit (aj-text o "text") then "true" else "false")
    else if op == "request" then print-line-uni (aj-quote ((ap-request (aj-text o "text")).why))
    else if op == "sign" then print-line-uni (aj-quote (ar-sign (aj-text o "text") probe-secret (ed25519-public-key probe-secret)))
    else print-line-uni "false"
  end

  probe-loop : [Console] Nothing
  probe-loop = act
    let base = __heap-save
    in act
      line <- read-line
      when line
        is None -> print-uni ""
        is Just (s) -> act
          probe-one s
          let restored = __heap-restore base
          in probe-loop
        end
    end
  end

  opening : [Console] Nothing = probe-loop

