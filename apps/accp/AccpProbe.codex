Chapter: AccpProbe
  cites Accp chapter AccpProtocol
  cites Foreword chapter Maybe

Section: Proof Interface

  probe-one : Text -> [Console] Nothing
  probe-one (line) = act
    let o = aj-object line
    in let op = aj-text o "op"
    in if op == "ir" then
      let a = ai-admit (aj-text o "text")
      in print-line-uni ("{\"ok\":" & (if a.ok then "true" else "false") & ",\"reason\":" & aj-quote a.reason & ",\"needs\":" & ai-json-list (ai-needs a) & "}")
    else if op == "wasm" then print-line-uni (if ab-admit (aj-text o "text") then "true" else "false")
    else if op == "request" then print-line-uni (aj-quote ((ap-request (aj-text o "text")).why))
    else print-line-uni "false"
  end

  probe-loop : [Console] Nothing
  probe-loop = act
    let base = __heap-save
    in act
      line <- read-line
      when line
        is None -> print-uni ""
        is Just (s) -> act
          probe-one s
          let restored = __heap-restore base
          in probe-loop
        end
    end
  end

  opening : [Console] Nothing = probe-loop

