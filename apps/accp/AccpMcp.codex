Chapter: AccpMcp
  cites Accp chapter AccpMcpProtocol
  cites Foreword chapter Maybe

Section: Entry

  opening : [Console] Nothing = act
    metadata <- read-line
    when metadata
      is None -> print-uni ""
      is Just (s) -> act
        let base = __heap-save
        in act
          modules <- ap-call "{\"bridge\":\"inspect-modules\"}"
          let valid = modules.ok & ab-admit (aj-text modules "compiler") & ab-admit (aj-text modules "lens")
          in let restored = __heap-restore base
          in if valid then act
            print-line-uni "{\"bridge\":\"ready\",\"ok\":true}"
            mc-loop s 0
          end
          else print-line-uni "{\"bridge\":\"ready\",\"ok\":false}"
        end
      end
  end

