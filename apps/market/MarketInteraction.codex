Chapter: MarketInteraction

Section: Action Dispatch

  dispatch-action : Text, Integer -> Integer
  dispatch-action (action) (el) =
    if text-eq action "add-to-cart" then dispatch-add-to-cart el
    else if text-eq action "select-option" then dispatch-select-option el
    else 0

  dispatch-add-to-cart : Integer -> Integer
  dispatch-add-to-cart (el) =
    let item = dom-dataset-get el "item"
    in dom-not-null el

  dispatch-select-option : Integer -> Integer
  dispatch-select-option (el) =
    let opt = dom-dataset-get el "option"
    in let choice = dom-dataset-get el "choice"
    in dom-not-null el

Section: Click Handler

  on-click-handler : Integer -> Integer
  on-click-handler (event) =
    let target = dom-event-target event
    in let el = dom-closest target "[data-action]"
    in if dom-not-null el == 0 then 0
    else let action = dom-dataset-get el "action"
    in dispatch-action action el

Section: Setup

  setup-market-events : Integer -> Integer
  setup-market-events (doc) =
    dom-on-click doc on-click-handler

