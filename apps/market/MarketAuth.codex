Section: Password Hashing

 A stored hash reads pbkdf2-sha256$iterations$salt-hex$hash-hex. 20000
 iterations costs 0.38 to 0.48 s per verify on codex-vm (val 2026-10-07),
 and a verify stalls the request loop for that time (CORE-11). The legacy form is 64 hex digits of one
 HMAC-SHA256 keyed by the store's merchant id; it verifies at full length
 until migrate-password-hash rewrites the record.

  password-scheme : Text = "pbkdf2-sha256"
  password-iterations : Integer = 20000
  password-params : PbkdfParams = PbkdfParams { pb-iterations = password-iterations, pb-hash-length = 32 }

  password-salt : Text, Text, Text, Integer -> List Integer
  password-salt (merchant-id) (user-id) (email) (ts) =
    let digest = sha256-bytes (text-to-bytes (merchant-id & "|" & user-id & "|" & email & "|" & show ts))
    in pw-take digest 16 0 (__list-with-capacity 16)

  pw-take : List Integer, Integer, Integer, List Integer -> List Integer
  pw-take (bytes) (count) (i) (out) =
    if i >= count then out
    else pw-take bytes count (i + 1) (list-push out (list-at bytes i))

  pw-hex : List Integer, Integer, Text -> Text
  pw-hex (bytes) (i) (acc) =
    if i >= list-length bytes then acc
    else pw-hex bytes (i + 1) (acc & byte-to-hex (list-at bytes i))

  pw-nibble : Text, Integer -> Integer
  pw-nibble (c) (n) =
    if n > 15 then 0 - 1
    else if sha256-hex-nibble n == c then n
    else pw-nibble c (n + 1)

  pw-unhex : Text, Integer, List Integer -> List Integer
  pw-unhex (s) (i) (out) =
    if bit-and (text-length s) 1 /= 0 then []
    else if i >= text-length s then out
    else let hi = pw-nibble (substring s i 1) 0
    in let lo = pw-nibble (substring s (i + 1) 1) 0
    in if hi < 0 | lo < 0 then []
    else pw-unhex s (i + 2) (list-push out (hi * 16 + lo))

  pw-digits : Text, Integer -> Boolean
  pw-digits (s) (i) =
    if text-length s < 1 | text-length s > 9 then False
    else if i >= text-length s then True
    else let d = pw-nibble (substring s i 1) 0
    in if d < 0 | d > 9 then False
    else pw-digits s (i + 1)

  hash-password : Text, List Integer -> Text
  hash-password (password) (salt) =
    let derived = pbkdf-hash (text-to-bytes password) salt password-params
    in if list-length (derived.pbr-hash) /= 32 then ""
    else password-scheme & "$" & show password-iterations & "$" & pw-hex salt 0 "" & "$" & pw-hex (derived.pbr-hash) 0 ""

  password-record : Text -> Maybe PbkdfResult
  password-record (stored) =
    let parts = text-split stored "$"
    in if list-length parts /= 4 then None
    else if list-at parts 0 /= password-scheme then None
    else if pw-digits (list-at parts 1) 0 == False then None
    else let iterations = text-to-integer (list-at parts 1)
    in let salt = pw-unhex (list-at parts 2) 0 []
    in let hash = pw-unhex (list-at parts 3) 0 []
    in if iterations < password-iterations | list-length salt /= 16 | list-length hash /= 32 then None
    else Just (PbkdfResult {
      pbr-hash = hash,
      pbr-salt = salt,
      pbr-params = PbkdfParams { pb-iterations = iterations, pb-hash-length = 32 }
    })

  password-legacy : Text -> Boolean
  password-legacy (stored) = text-length stored == 64 & list-length (pw-unhex stored 0 []) == 32

  legacy-verify : Text, Text, Text -> Boolean
  legacy-verify (password) (merchant-id) (stored) =
    let expected = hash-words-to-bytes (hmac-sha256 (text-to-bytes merchant-id) (text-to-bytes password))
    in let held = pw-unhex stored 0 []
    in list-length held == 32 & pb-constant-eq expected held 0 32 0

  verify-password : Text, Text, Text -> Boolean
  verify-password (password) (merchant-id) (stored-hash) =
    if password-legacy stored-hash then legacy-verify password merchant-id stored-hash
    else when password-record stored-hash
      is None -> False
      is Just (held) -> pbkdf-verify (text-to-bytes password) held

  migrate-password-hash : User, Text, Text, Integer -> Maybe User
  migrate-password-hash (user) (password) (merchant-id) (ts) =
    if password-legacy (user.user-pass-hash) == False then None
    else if legacy-verify password merchant-id (user.user-pass-hash) == False then None
    else Just (User {
      user-id = user.user-id,
      user-email = user.user-email,
      user-name = user.user-name,
      user-pass-hash = hash-password password (password-salt merchant-id (user.user-id) (user.user-email) ts),
      user-role = user.user-role,
      user-created = user.user-created,
      user-last-login = ts
    })

Section: Session Management

  session-duration : Integer = 86400

  create-session : MarketState, Text, UserRole, Integer -> (MarketState, Session)
  create-session (st) (user-id) (role) (ts) =
    let (st2, sid) = market-gen-id st "sess"
    in let sess = Session {
      sess-id = sid,
      sess-user-id = user-id,
      sess-role = role,
      sess-created = ts,
      sess-expires = ts + session-duration
    }
    in let log2 = log-info-msg (st2.mkt-log) "auth" ("session created for " & user-id) ts
    in let st3 = __record-set st2 "mkt-log" log2
    in (st3, sess)

  session-valid : Session, Integer -> Boolean
  session-valid (sess) (now) = now < sess.sess-expires

Section: User Registration

  register-user : MarketState, Text, Text, Text, Integer -> (MarketState, User)
  register-user (st) (email) (name) (password) (ts) =
    let (st2, uid) = market-gen-id st "usr"
    in let pass-hash = hash-password password (password-salt (st2.mkt-config.store-merchant-id) uid email ts)
    in let user = User {
      user-id = uid,
      user-email = email,
      user-name = name,
      user-pass-hash = pass-hash,
      user-role = RoleCustomer,
      user-created = ts,
      user-last-login = ts
    }
    in let log2 = log-info-msg (st2.mkt-log) "auth" ("registered " & email) ts
    in let st3 = __record-set st2 "mkt-log" log2
    in (st3, user)

  create-admin-user : MarketState, Text, Text, Text, Integer -> (MarketState, User)
  create-admin-user (st) (email) (name) (password) (ts) =
    let (st2, user) = register-user st email name password ts
    in let admin = __record-set user "user-role" RoleAdmin
    in let log2 = log-info-msg (st2.mkt-log) "auth" ("admin created " & email) ts
    in let st3 = __record-set st2 "mkt-log" log2
    in (st3, admin)
