Section: Read Functions

  market-read-products : MarketState -> List Product
  market-read-products (st) = sample-products

  market-read-users : MarketState -> List User
  market-read-users (st) = sample-users

  market-read-orders : MarketState -> List Order
  market-read-orders (st) = sample-orders

  market-read-product-by-id : MarketState, Text -> Maybe Product
  market-read-product-by-id (st) (id) =
    find-product-by-id sample-products id 0

  find-product-by-id : List Product, Text, Integer -> Maybe Product
  find-product-by-id (products) (id) (i) =
    if i >= list-length products then None
    else let p = list-at products i
    in if p.product-id == id then Just p
    else find-product-by-id products id (i + 1)

  market-read-user-by-id : MarketState, Text -> Maybe User
  market-read-user-by-id (st) (id) =
    find-user-by-id sample-users id 0

  find-user-by-id : List User, Text, Integer -> Maybe User
  find-user-by-id (users) (id) (i) =
    if i >= list-length users then None
    else let u = list-at users i
    in if u.user-id == id then Just u
    else find-user-by-id users id (i + 1)

  market-read-orders-for-user : MarketState, Text -> List Order
  market-read-orders-for-user (st) (user-id) =
    filter-orders-by-user sample-orders user-id 0 []

  filter-orders-by-user : List Order, Text, Integer, List Order -> List Order
  filter-orders-by-user (orders) (user-id) (i) (acc) =
    if i >= list-length orders then acc
    else let o = list-at orders i
    in if o.order-user-id == user-id
      then filter-orders-by-user orders user-id (i + 1) (list-push acc o)
      else filter-orders-by-user orders user-id (i + 1) acc

Section: Table Helpers

 This chapter defined its own table-def, with the field names TableDef
 stopped having. Schema defines table-def and this chapter already cites
 it, so the local copy was shadowing a working function with a broken
 one under the same name. Deleted rather than repaired: two definitions
 of table-def in one unit is the collision that let this drift out of
 sync unnoticed in the first place.
