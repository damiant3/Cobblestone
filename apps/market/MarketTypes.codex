    mp-return-days = 30,
    mp-return-policy = "Returns accepted within 30 days of delivery.",
    mp-shipping-policy = "Ships within 1-3 business days.",
    mp-privacy-policy = "We do not share your information with third parties."
  }

Section: Drop-Ship Suppliers

  Supplier = record {
    sup-id : Text,
    sup-name : Text,
    sup-api-endpoint : Text,
    sup-api-key : Text,
    sup-lead-time-days : Integer,
    sup-countries : List Text,
    sup-active : Boolean
  }

  DropShipListing = record {
    dsl-id : Text,
    dsl-supplier-id : Text,
    dsl-supplier-sku : Text,
    dsl-product-id : Text,
    dsl-cost : Money,
    dsl-retail-price : Money,
    dsl-auto-order : Boolean,
    dsl-stock-sync : Boolean,
    dsl-last-synced : Integer
  }

  dropship-margin : DropShipListing -> Money
  dropship-margin (d) =
    money (d.dsl-retail-price.amount - d.dsl-cost.amount) (d.dsl-retail-price.currency)

  dropship-margin-pct : DropShipListing -> Integer
  dropship-margin-pct (d) =
    if d.dsl-retail-price.amount == 0 then 0
    else (d.dsl-retail-price.amount - d.dsl-cost.amount) * 100 / d.dsl-retail-price.amount

Section: Content Creators

  CreatorTier =
    | CreatorFree
    | CreatorPro
    | CreatorEnterprise

  creator-tier-name : CreatorTier -> Text
  creator-tier-name (t) =
    when t
      is CreatorFree -> "Free"
      is CreatorPro -> "Pro"
      is CreatorEnterprise -> "Enterprise"

  Creator = record {
    cr-id : Text,
    cr-merchant-id : Text,
    cr-display-name : Text,
    cr-bio : Text,
    cr-avatar-url : Text,
    cr-cover-url : Text,
    cr-tier : CreatorTier,
    cr-follower-count : Integer,
    cr-total-tips : Money,
    cr-social-links : List SocialLink,
    cr-featured-products : List Text,
    cr-verified : Boolean
  }

  SocialLink = record {
    sl-platform : Text,
    sl-url : Text,
    sl-display : Text
  }

  social-link : Text, Text, Text -> SocialLink
  social-link (platform) (url) (display) = SocialLink {
    sl-platform = platform,
    sl-url = url,
    sl-display = display
  }

  ContentItem = record {
    ci-id : Text,
    ci-creator-id : Text,
    ci-type : ContentType,
    ci-title : Text,
    ci-body : Text,
    ci-media-url : Text,
    ci-product-ids : List Text,
    ci-likes : Integer,
    ci-created : Integer
  }

  ContentType =
    | ContentPost
    | ContentVideo
    | ContentTutorial
    | ContentReview
    | ContentUnboxing
    | ContentLookbook

  content-type-name : ContentType -> Text
  content-type-name (t) =
    when t
      is ContentPost -> "post"
      is ContentVideo -> "video"
      is ContentTutorial -> "tutorial"
      is ContentReview -> "review"
      is ContentUnboxing -> "unboxing"
      is ContentLookbook -> "lookbook"

  Tip = record {
    tip-id : Text,
    tip-from-user : Text,
    tip-to-creator : Text,
    tip-amount : Money,
    tip-message : Text,
    tip-created : Integer
  }

Section: Marketplace Commission

  CommissionSplit = record {
    cs-platform-bps : Integer,
    cs-merchant-bps : Integer,
    cs-creator-bps : Integer,
    cs-affiliate-bps : Integer
  }

  default-commission : CommissionSplit
  default-commission = CommissionSplit {
    cs-platform-bps = 1000,
    cs-merchant-bps = 8500,
    cs-creator-bps = 0,
    cs-affiliate-bps = 500
  }

  creator-commission : CommissionSplit
  creator-commission = CommissionSplit {
    cs-platform-bps = 1500,
    cs-merchant-bps = 0,
    cs-creator-bps = 8000,
    cs-affiliate-bps = 500
  }

  calc-commission : CommissionSplit, Money -> Money
  calc-commission (cs) (sale) =
    money (sale.amount * cs.cs-platform-bps / 10000) (sale.currency)

  calc-payout : CommissionSplit, Money -> Money
  calc-payout (cs) (sale) =
    money (sale.amount * (cs.cs-merchant-bps + cs.cs-creator-bps) / 10000) (sale.currency)

Section: Affiliate Tracking

  Affiliate = record {
    aff-id : Text,
    aff-user-id : Text,
    aff-code : Text,
    aff-commission-bps : Integer,
    aff-total-earned : Money,
    aff-total-clicks : Integer,
    aff-total-conversions : Integer,
    aff-created : Integer
  }

  AffiliateClick = record {
    ac-affiliate-id : Text,
    ac-product-id : Text,
    ac-referrer : Text,
    ac-converted : Boolean,
    ac-order-id : Text,
    ac-timestamp : Integer
  }

Section: Payout

  PayoutStatus =
    | PayoutPending
    | PayoutProcessing
    | PayoutCompleted
    | PayoutFailed (Text)

  Payout = record {
    po-id : Text,
    po-merchant-id : Text,
    po-amount : Money,
    po-status : PayoutStatus,
    po-period-start : Integer,
    po-period-end : Integer,
    po-line-items : Integer,
    po-created : Integer
  }
