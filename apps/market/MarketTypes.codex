  ProductKind =
    | Physical
    | Digital
    | Service
    | Bundle

  product-kind-name : ProductKind -> Text
  product-kind-name (k) =
    when k
      is Physical -> "physical"
      is Digital -> "digital"
      is Service -> "service"
      is Bundle -> "bundle"

Section: Product Bundles

  BundleItem = record {
    bi-product-id : Text,
    bi-quantity : Integer,
    bi-discount-pct : Integer
  }

  ProductBundle = record {
    pb-id : Text,
    pb-name : Text,
    pb-items : List BundleItem,
    pb-bundle-price : Maybe Money
  }

  bundle-savings : ProductBundle, List Product -> Money
  bundle-savings (pb) (products) =
    when pb.pb-bundle-price
      is Just (bp) ->
        let full = bundle-full-price (pb.pb-items) products 0
        in money (full - bp.amount) (bp.currency)
      is None -> money-zero USD

  bundle-full-price : List BundleItem, List Product, Integer -> Integer
  bundle-full-price (items) (products) (acc) =
    if list-length items == 0 then acc
    else let bi = list-at items 0
    in let prod-price = find-product-price (bi.bi-product-id) products
    in bundle-full-price (list-tail items) products (acc + prod-price * bi.bi-quantity)

  find-product-price : Text, List Product -> Integer
  find-product-price (pid) (products) =
    find-product-price-loop pid products 0

  find-product-price-loop : Text, List Product, Integer -> Integer
  find-product-price-loop (pid) (products) (i) =
    if i >= list-length products then 0
    else let p = list-at products i
    in if p.product-id == pid then p.product-price.amount
    else find-product-price-loop pid products (i + 1)

Section: Fulfillment

  FulfillmentStatus =
    | AwaitingFulfillment
    | Processing
    | ShipmentCreated (Text)
    | InTransit (Text)
    | OutForDelivery
    | FulfillmentDelivered
    | ReturnRequested
    | Returned

  fulfillment-status-name : FulfillmentStatus -> Text
  fulfillment-status-name (s) =
    when s
      is AwaitingFulfillment -> "awaiting"
      is Processing -> "processing"
      is ShipmentCreated (tracking) -> "shipped: " & tracking
      is InTransit (tracking) -> "in transit: " & tracking
      is OutForDelivery -> "out for delivery"
      is FulfillmentDelivered -> "delivered"
      is ReturnRequested -> "return requested"
      is Returned -> "returned"

  Shipment = record {
    shp-id : Text,
    shp-order-id : Text,
    shp-tracking : Text,
    shp-carrier : Text,
    shp-status : FulfillmentStatus,
    shp-shipped-date : Integer,
    shp-delivered-date : Integer
  }

