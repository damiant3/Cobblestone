Chapter: MarketTypes
  cites Foreword chapter Maybe
  cites Foreword chapter List
  cites Foreword chapter ListUtils

Section: Money

  Currency =
    | USD
    | EUR
    | GBP
    | CAD
    | AUD
    | JPY
    | CustomCurrency (Text)

  currency-code : Currency -> Text
  currency-code (c) =
    when c
      is USD -> "USD"
      is EUR -> "EUR"
      is GBP -> "GBP"
      is CAD -> "CAD"
      is AUD -> "AUD"
      is JPY -> "JPY"
      is CustomCurrency (code) -> code

  Money = record {
    amount : Integer,
    currency : Currency
  }

  money : Integer, Currency -> Money
  money (amt) (cur) = Money { amount = amt, currency = cur }

  money-usd : Integer -> Money
  money-usd (cents) = money cents USD

  money-add : Money, Money -> Money
  money-add (a) (b) = Money { amount = a.amount + b.amount, currency = a.currency }

  money-mul : Money, Integer -> Money
  money-mul (m) (qty) = Money { amount = m.amount * qty, currency = m.currency }

  money-zero : Currency -> Money
  money-zero (cur) = money 0 cur

  format-money : Money -> Text
  format-money (m) =
    let dollars = m.amount / 100
    in let cents = m.amount - dollars * 100
    in let cents-str = if cents < 10 then "0" & show cents else show cents
    in currency-code (m.currency) & " " & show dollars & "." & cents-str

Section: Option Definition

  OptionChoice = record {
    choice-id : Text,
    choice-label : Text,
    choice-swatch : Text,
    choice-price-adj : Integer
  }

  option-choice : Text, Text -> OptionChoice
  option-choice (id) (label) = OptionChoice {
    choice-id = id,
    choice-label = label,
    choice-swatch = "",
    choice-price-adj = 0
  }

  option-choice-color : Text, Text, Text -> OptionChoice
  option-choice-color (id) (label) (hex) = OptionChoice {
    choice-id = id,
    choice-label = label,
    choice-swatch = hex,
    choice-price-adj = 0
  }

  option-choice-priced : Text, Text, Integer -> OptionChoice
  option-choice-priced (id) (label) (adj) = OptionChoice {
    choice-id = id,
    choice-label = label,
    choice-swatch = "",
    choice-price-adj = adj
  }

  OptionDef = record {
    option-id : Text,
    option-name : Text,
    option-choices : List OptionChoice
  }

  option-def : Text, Text, List OptionChoice -> OptionDef
  option-def (id) (name) (choices) = OptionDef {
    option-id = id,
    option-name = name,
    option-choices = choices
  }

Section: Product

  ProductStatus =
    | Active
    | Draft
    | Archived

  Product = record {
    product-id : Text,
    product-name : Text,
    product-slug : Text,
    product-desc : Text,
    product-price : Money,
    product-status : ProductStatus,
    product-options : List OptionDef,
    product-tags : List Text,
    product-image-url : Text,
    product-weight-grams : Integer,
    product-created : Integer,
    product-updated : Integer
  }

  Variant = record {
    variant-id : Text,
    variant-product-id : Text,
    variant-choices : List OptionChoice,
    variant-sku : Text,
    variant-price-override : Maybe Money,
    variant-stock : Integer,
    variant-weight-grams : Integer
  }

  variant-price : Product, Variant -> Money
  variant-price (prod) (var) =
    when var.variant-price-override
      is Just (p) -> p
      is None -> variant-adjusted-price prod var

  variant-adjusted-price : Product, Variant -> Money
  variant-adjusted-price (prod) (var) =
    let adj = sum-adjustments (var.variant-choices) 0
    in money-add (prod.product-price) (money adj (prod.product-price.currency))

  sum-adjustments : List OptionChoice, Integer -> Integer
  sum-adjustments (choices) (acc) =
    if list-length choices == 0 then acc
    else sum-adjustments (list-tail choices) (acc + (list-at choices 0).choice-price-adj)

Section: Cart

  CartItem = record {
    ci-product-id : Text,
    ci-variant-id : Text,
    ci-quantity : Integer,
    ci-unit-price : Money
  }

  Cart = record {
    cart-id : Text,
    cart-items : List CartItem,
    cart-user-id : Text,
    cart-created : Integer,
    cart-updated : Integer
  }

  cart-new : Text, Text, Integer -> Cart
  cart-new (id) (user-id) (ts) = Cart {
    cart-id = id,
    cart-items = [],
    cart-user-id = user-id,
    cart-created = ts,
    cart-updated = ts
  }

  cart-subtotal : Cart -> Money
  cart-subtotal (c) = cart-sum-items (c.cart-items) (money-zero USD)

  cart-sum-items : List CartItem, Money -> Money
  cart-sum-items (items) (acc) =
    if list-length items == 0 then acc
    else let item = list-at items 0
    in cart-sum-items (list-tail items) (money-add acc (money-mul (item.ci-unit-price) (item.ci-quantity)))

  cart-item-count : Cart -> Integer
  cart-item-count (c) = cart-count-items (c.cart-items) 0

  cart-count-items : List CartItem, Integer -> Integer
  cart-count-items (items) (acc) =
    if list-length items == 0 then acc
    else cart-count-items (list-tail items) (acc + (list-at items 0).ci-quantity)

