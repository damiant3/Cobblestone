Section: Shipping

  ShippingMethod =
    | FlatRate (Money)
    | WeightBased (Integer)
    | FreeOver (Money)
    | FreeShipping
    | LocalPickup

  shipping-method-name : ShippingMethod -> Text
  shipping-method-name (m) =
    when m
      is FlatRate (p) -> "Flat Rate (" & format-money p & ")"
      is WeightBased (rate) -> "Weight-based"
      is FreeOver (threshold) -> "Free over " & format-money threshold
      is FreeShipping -> "Free Shipping"
      is LocalPickup -> "Local Pickup"

  ShippingResult = record {
    ship-method : Text,
    ship-cost : Money,
    ship-est-days : Integer
  }

  calc-shipping : ShippingMethod, Money, Integer -> ShippingResult
  calc-shipping (method) (subtotal) (weight-g) =
    when method
      is FlatRate (rate) -> ShippingResult { ship-method = "Flat Rate", ship-cost = rate, ship-est-days = 5 }
      is WeightBased (rate-per-kg) ->
        let cost = weight-g * rate-per-kg / 1000
        in ShippingResult { ship-method = "Standard", ship-cost = money cost (subtotal.currency), ship-est-days = 7 }
      is FreeOver (threshold) ->
        if subtotal.amount >= threshold.amount then ShippingResult { ship-method = "Free Shipping", ship-cost = money-zero (subtotal.currency), ship-est-days = 7 }
        else ShippingResult { ship-method = "Standard", ship-cost = money 599 (subtotal.currency), ship-est-days = 7 }
      is FreeShipping -> ShippingResult { ship-method = "Free", ship-cost = money-zero (subtotal.currency), ship-est-days = 5 }
      is LocalPickup -> ShippingResult { ship-method = "Pickup", ship-cost = money-zero (subtotal.currency), ship-est-days = 0 }

Section: Coupons and Discounts

  DiscountType =
    | PercentOff (Integer)
    | FixedOff (Money)
    | FreeShipDiscount
    | BuyXGetY (Integer) (Integer)

  Coupon = record {
    coupon-code : Text,
    coupon-discount : DiscountType,
    coupon-min-order : Money,
    coupon-max-uses : Integer,
    coupon-used-count : Integer,
    coupon-expires : Integer,
    coupon-applies-to : Text,
    coupon-active : Boolean
  }

  coupon-valid : Coupon, Money, Integer -> Boolean
  coupon-valid (c) (subtotal) (now) =
    if c.coupon-active == False then False
    else if now > c.coupon-expires then False
    else if c.coupon-max-uses > 0 then if c.coupon-used-count >= c.coupon-max-uses then False else subtotal.amount >= c.coupon-min-order.amount
    else subtotal.amount >= c.coupon-min-order.amount

  apply-discount : DiscountType, Money -> Money
  apply-discount (disc) (subtotal) =
    when disc
      is PercentOff (pct) -> money (subtotal.amount * pct / 100) (subtotal.currency)
      is FixedOff (amt) -> if amt.amount > subtotal.amount then subtotal else amt
      is FreeShipDiscount -> money-zero (subtotal.currency)
      is BuyXGetY (buy) (get) -> money-zero (subtotal.currency)

Section: Reviews

  Review = record {
    rev-id : Text,
    rev-product-id : Text,
    rev-user-id : Text,
    rev-user-name : Text,
    rev-rating : Integer,
    rev-title : Text,
    rev-body : Text,
    rev-verified : Boolean,
    rev-created : Integer
  }

  review-stars : Integer -> Text
  review-stars (n) = stars-loop n 0 ""

  stars-loop : Integer, Integer, Text -> Text
  stars-loop (rating) (i) (acc) =
    if i >= 5 then acc
    else if i < rating then stars-loop rating (i + 1) (acc & "\x2605")
    else stars-loop rating (i + 1) (acc & "\x2606")

  avg-rating : List Review, Integer, Integer -> Integer
  avg-rating (reviews) (sum) (count) =
    if list-length reviews == 0 then if count == 0 then 0 else sum / count
    else avg-rating (list-tail reviews) (sum + (list-at reviews 0).rev-rating) (count + 1)

Section: Wishlists

  WishlistItem = record {
    wl-product-id : Text,
    wl-variant-id : Text,
    wl-added : Integer
  }

  Wishlist = record {
    wl-id : Text,
    wl-user-id : Text,
    wl-items : List WishlistItem
  }

  wishlist-new : Text, Text -> Wishlist
  wishlist-new (id) (uid) = Wishlist { wl-id = id, wl-user-id = uid, wl-items = [] }

  wishlist-add : Wishlist, Text, Text, Integer -> Wishlist
  wishlist-add (wl) (pid) (vid) (ts) =
    __record-set wl "wl-items" (list-push (wl.wl-items) (WishlistItem {
      wl-product-id = pid, wl-variant-id = vid, wl-added = ts
    }))

  wishlist-contains : Wishlist, Text -> Boolean
  wishlist-contains (wl) (pid) = wl-search (wl.wl-items) pid 0

  wl-search : List WishlistItem, Text, Integer -> Boolean
  wl-search (items) (pid) (i) =
    if i >= list-length items then False
    else if (list-at items i).wl-product-id == pid then True
    else wl-search items pid (i + 1)

