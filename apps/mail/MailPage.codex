  count-folder-unread : Integer, Integer, Integer, Integer -> Integer
  count-folder-unread (i) (count) (folder) (acc) =
    if i >= count then acc
    else let mf = state-get ("m-folder-" & show i)
    in let mr = state-get ("m-read-" & show i)
    in if mf == folder then
      if mr == 0 then count-folder-unread (i + 1) count folder (acc + 1)
      else count-folder-unread (i + 1) count folder acc
    else count-folder-unread (i + 1) count folder acc

Section: Handlers

  mail-click : Text -> Integer
  mail-click (id) =
    if id == "compose-new" then
      let s1 = state-set-text "comp-to-val" ""
      in let s2 = state-set-text "comp-subj-val" ""
      in let s3 = state-set-text "comp-body-val" ""
      in let s4 = state-set-render "composing" 1
      in 0
    else if id == "comp-close" then let s = state-set-render "composing" 0 in 0
    else if id == "send-mail" then send-mail 0
    else if id == "save-draft" then save-draft 0
    else if id == "f-inbox" then let s = state-set-render "folder" 0 in 0
    else if id == "f-sent" then let s = state-set-render "folder" 1 in 0
    else if id == "f-drafts" then let s = state-set-render "folder" 2 in 0
    else if id == "f-trash" then let s = state-set-render "folder" 3 in 0
    else if id == "f-spam" then let s = state-set-render "folder" 4 in 0
    else if id == "f-archive" then let s = state-set-render "folder" 5 in 0
    else if id == "reply" then handle-reply 0
    else if id == "forward" then handle-forward 0
    else if id == "delete" then handle-delete 0
    else if id == "star-msg" then handle-star-toggle 0
    else if id == "mark-unread" then handle-mark-unread 0
    else if id == "archive-msg" then handle-move-to-folder 5
    else if id == "spam-msg" then handle-move-to-folder 4
    else if id == "select-all" then handle-select-all 0
    else if id == "cancel-select" then let s = state-set-render "select-mode" 0 in 0
    else if id == "delete-selected" then let s = state-set-render "select-mode" 0 in 0
    else if text-starts-with id "mail-" then
      let msg-idx = id-num id
      in let s1 = state-set ("m-read-" & show msg-idx) 1
      in let s2 = state-set-render "active-mail" msg-idx
      in 0
    else 0

  handle-reply : Integer -> Integer
  handle-reply (x) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let from = state-get-text ("m-from-" & show active)
    in let subj = state-get-text ("m-subj-" & show active)
    in let s1 = state-set-text "comp-to-val" from
    in let s2 = state-set-text "comp-subj-val" ("Re: " & subj)
    in let s3 = state-set-text "comp-body-val" ""
    in let s4 = state-set-render "composing" 1
    in 0

  handle-forward : Integer -> Integer
  handle-forward (x) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let subj = state-get-text ("m-subj-" & show active)
    in let body = state-get-text ("m-body-" & show active)
    in let s1 = state-set-text "comp-to-val" ""
    in let s2 = state-set-text "comp-subj-val" ("Fwd: " & subj)
    in let s3 = state-set-text "comp-body-val" body
    in let s4 = state-set-render "composing" 1
    in 0

  handle-delete : Integer -> Integer
  handle-delete (x) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let s1 = state-set ("m-folder-" & show active) 3
    in let s2 = state-set-render "active-mail" (-1)
    in 0

  handle-star-toggle : Integer -> Integer
  handle-star-toggle (x) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let cur = state-get ("m-star-" & show active)
    in let next = if cur == 1 then 0 else 1
    in let s = state-set-render ("m-star-" & show active) next
    in 0

  handle-mark-unread : Integer -> Integer
  handle-mark-unread (x) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let cur = state-get ("m-read-" & show active)
    in let nv = if cur == 0 then 1 else 0
    in let s1 = state-set ("m-read-" & show active) nv
    in let s2 = state-set-render "active-mail" active
    in 0

  handle-move-to-folder : Integer -> Integer
  handle-move-to-folder (target-folder) =
    let active = state-get "active-mail"
    in if active < 0 then 0
    else let s1 = state-set ("m-folder-" & show active) target-folder
    in let s2 = state-set-render "active-mail" (-1)
    in 0

  handle-select-all : Integer -> Integer
  handle-select-all (x) =
    let cur = state-get "select-mode"
    in let next = if cur == 1 then 0 else 1
    in let s = state-set-render "select-mode" next
    in 0

  mail-input : Text, Text -> Integer
  mail-input (id) (value) =
    if id == "comp-to" then let s = state-set-text "comp-to-val" value in 0
    else if id == "comp-subj" then let s = state-set-text "comp-subj-val" value in 0
    else if id == "comp-body" then let s = state-set-text "comp-body-val" value in 0
    else 0

  send-mail : Integer -> Integer
  send-mail (x) =
    let to = state-get-text "comp-to-val"
    in let subj = state-get-text "comp-subj-val"
    in let body = state-get-text "comp-body-val"
    in let count = state-get "mail-count"
    in let s1 = state-set-text ("m-from-" & show count) ("To: " & to)
    in let s2 = state-set-text ("m-subj-" & show count) (if subj == "" then "(no subject)" else subj)
    in let s3 = state-set-text ("m-snip-" & show count) body
    in let s4 = state-set-text ("m-date-" & show count) "Now"
    in let s5 = state-set-text ("m-body-" & show count) body
    in let s6 = state-set "mail-count" (count + 1)
    in let s7 = state-set ("m-read-" & show count) 1
    in let s8 = state-set ("m-star-" & show count) 0
    in let s9 = state-set ("m-attach-" & show count) 0
    in let s10 = state-set ("m-folder-" & show count) 1
    in let s11 = state-set-text "comp-to-val" ""
    in let s12 = state-set-text "comp-subj-val" ""
    in let s13 = state-set-text "comp-body-val" ""
    in let s14 = state-set "active-mail" count
    in let s15 = state-set-render "composing" 0
    in 0

  save-draft : Integer -> Integer
  save-draft (x) =
    let to = state-get-text "comp-to-val"
    in let subj = state-get-text "comp-subj-val"
    in let body = state-get-text "comp-body-val"
    in let count = state-get "mail-count"
    in let s1 = state-set-text ("m-from-" & show count) ("Draft to: " & to)
    in let s2 = state-set-text ("m-subj-" & show count) (if subj == "" then "(no subject)" else subj)
    in let s3 = state-set-text ("m-snip-" & show count) body
    in let s4 = state-set-text ("m-date-" & show count) "Now"
    in let s5 = state-set-text ("m-body-" & show count) body
    in let s6 = state-set "mail-count" (count + 1)
    in let s7 = state-set ("m-read-" & show count) 1
    in let s8 = state-set ("m-star-" & show count) 0
    in let s9 = state-set ("m-attach-" & show count) 0
    in let s10 = state-set ("m-folder-" & show count) 2
    in let s11 = state-set-render "composing" 0
    in 0

Section: Entry

  render-mail : Integer -> Integer
  render-mail (x) = mount-widget-themed mail-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style mail-theme mail-css
    in let s1 = state-set "active-mail" (-1)
    in let s2 = state-set "folder" 0
    in let s3 = state-set "select-mode" 0
    in let s3b = state-set "composing" 0
    in let s4 = set-render render-mail
    in let h = register-handlers no-pick mail-click
    in let hi = register-input-handler mail-input
    in let d = load-sample-mail 0
    in render-mail 0
  end

