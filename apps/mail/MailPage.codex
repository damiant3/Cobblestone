Chapter: MailPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 We say:

Section: Theme

  mail-theme : Theme
  mail-theme =
    let p = Palette { pal-bg = #181818, pal-fg = #D8D8D8, pal-primary = #4490FF, pal-secondary = #202020, pal-accent = #4490FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #EF9B01, pal-border = #2A2A2A }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 1 (p.pal-border) CornerSharp) (exy 12 8) (eu 0)
    in let btn = ws (p.pal-primary) #FFFFFF (bdr 0 0 (CornerRound 6)) (exy 16 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in let inp = ws #202020 (p.pal-fg) (bdr 1 (p.pal-border) (CornerRound 6)) (exy 12 8) (eu 0)
    in Theme { th-name = "mail-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = inp, ss-focused = inp }, th-gauge = ss-flat base, th-separator = ss-flat (ws (p.pal-border) (p.pal-border) bn ez (exy 0 4)) }

Section: CSS

  mail-css : Text
  mail-css =
    "*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}body{background:#181818;color:#d8d8d8;font-family:system-ui,sans-serif}#app{display:flex;height:100vh}"
    & ".folders{width:220px;background:#1e1e1e;border-right:1px solid #2a2a2a;padding:12px 0;display:flex;flex-direction:column}"
    & ".folders h2{padding:12px 16px;font-size:16px;color:#4493ff;font-weight:600}"
    & ".folder{padding:10px 20px;cursor:pointer;font-size:14px;color:#999;transition:background .15s;display:flex;align-items:center;gap:10px}"
    & ".folder:hover,.folder.active{background:#262626;color:#d8d8d8}"
    & ".folder .count{margin-left:auto;background:#4493ff;color:#fff;font-size:10px;padding:1px 6px;border-radius:8px}"
    & ".folder .count.zero{display:none}"
    & ".mail-list{width:360px;background:#1a1a1a;border-right:1px solid #2a2a2a;display:flex;flex-direction:column}"
    & ".mail-list-hdr{padding:12px 16px;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;gap:8px}"
    & ".mail-list-hdr input{flex:1;background:#262626;border:none;border-radius:6px;padding:8px 12px;color:#d8d8d8;font-size:13px;outline:none}"
    & ".mail-items{flex:1;overflow-y:auto}"
    & ".mail-item{padding:12px 16px;border-bottom:1px solid #222;cursor:pointer;transition:background .15s}"
    & ".mail-item:hover,.mail-item.active{background:#252525}"
    & ".mail-item.unread{border-left:3px solid #4493ff}"
    & ".mail-item.unread .mail-from{font-weight:700}"
    & ".mail-from{font-size:13px;font-weight:600;color:#d8d8d8;margin-bottom:2px}"
    & ".mail-subj{font-size:13px;color:#ccc;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".mail-snip{font-size:12px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".mail-date{font-size:11px;color:#555;float:right}"
    & ".mail-star{color:#EF9B01;font-size:13px;margin-left:4px}"
    & ".mail-attach{color:#999;font-size:12px;margin-left:4px}"
    & ".mail-indicators{display:flex;align-items:center;gap:4px;margin-left:auto}"
    & ".mail-view{flex:1;display:flex;flex-direction:column;background:#181818}"
    & ".mail-view-hdr{padding:20px 24px;border-bottom:1px solid #2a2a2a}"
    & ".mail-view-subj{font-size:20px;font-weight:600;margin-bottom:8px}"
    & ".mail-view-meta{font-size:13px;color:#777;display:flex;gap:16px}"
    & ".mail-view-body{flex:1;padding:24px;font-size:14px;line-height:1.7;color:#bbb;overflow-y:auto}"
    & ".mail-view-actions{padding:12px 24px;border-top:1px solid #2a2a2a;display:flex;gap:8px}"
    & ".mail-view-actions .wk-btn{padding:8px 16px;border-radius:6px;font-size:13px}"
    & ".select-bar{padding:8px 16px;background:#262626;border-bottom:1px solid #2a2a2a;display:flex;align-items:center;gap:8px}"
    & ".compose-modal{position:fixed;bottom:0;right:24px;width:500px;background:#1e1e1e;border:1px solid #333;border-bottom:none;border-radius:8px 8px 0 0;display:flex;flex-direction:column;max-height:60vh;z-index:50}"
    & ".compose-hdr{padding:10px 16px;background:#262626;border-radius:8px 8px 0 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer}"
    & ".compose-hdr span{font-size:14px;font-weight:600}"
    & ".compose-fields{padding:8px 16px}"
    & ".compose-fields input{width:100%;background:#181818;border:none;border-bottom:1px solid #333;padding:8px 0;color:#d8d8d8;font-size:13px;outline:none;margin-bottom:4px}"
    & ".compose-body{flex:1;padding:8px 16px}"
    & ".compose-body textarea{width:100%;height:200px;background:#181818;border:none;color:#d8d8d8;font-size:14px;resize:none;outline:none}"
    & ".compose-actions{padding:8px 16px;display:flex;gap:8px}"
    & ".empty-mail{flex:1;display:flex;align-items:center;justify-content:center;color:#555;font-size:14px}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let view = state-get "view"
    in widget-panel "root" DirRow 0 [
      folders-panel 0,
      mail-list-panel 0,
      if state-get "composing" == 1 then compose-panel 0 else mail-view-panel 0
    ]

  folders-panel : Integer -> WidgetNode
  folders-panel (x) =
    let sel = state-get "folder"
    in let mc = state-get "mail-count"
    in let ci = count-folder-unread 0 mc 0 0
    in let cs = count-folder-unread 0 mc 1 0
    in let cd = count-folder-unread 0 mc 2 0
    in let ct = count-folder-unread 0 mc 3 0
    in let csp = count-folder-unread 0 mc 4 0
    in let ca = count-folder-unread 0 mc 5 0
    in widget-box "folders" "folders" [
      widget-label "brand" "CodexMail",
      widget-button "compose-new" "&#x270F; Compose",
      widget-box-click "f-inbox" (if sel == 0 then "folder active" else "folder") [
        widget-label "fi-icon" "&#x1F4E5;",
        widget-label "fi-label" "Inbox",
        widget-label "fi-count" (if ci > 0 then show ci else "")
      ],
      widget-box-click "f-sent" (if sel == 1 then "folder active" else "folder") [
        widget-label "fs-icon" "&#x1F4E4;",
        widget-label "fs-label" "Sent",
        widget-label "fs-count" (if cs > 0 then show cs else "")
      ],
      widget-box-click "f-drafts" (if sel == 2 then "folder active" else "folder") [
        widget-label "fd-icon" "&#x1F4DD;",
        widget-label "fd-label" "Drafts",
        widget-label "fd-count" (if cd > 0 then show cd else "")
      ],
      widget-box-click "f-trash" (if sel == 3 then "folder active" else "folder") [
        widget-label "ft-icon" "&#x1F5D1;",
        widget-label "ft-label" "Trash",
        widget-label "ft-count" (if ct > 0 then show ct else "")
      ],
      widget-box-click "f-spam" (if sel == 4 then "folder active" else "folder") [
        widget-label "fsp-icon" "&#x26A0;",
        widget-label "fsp-label" "Spam",
        widget-label "fsp-count" (if csp > 0 then show csp else "")
      ],
      widget-box-click "f-archive" (if sel == 5 then "folder active" else "folder") [
        widget-label "fa-icon" "&#x1F4E6;",
        widget-label "fa-label" "Archive",
        widget-label "fa-count" (if ca > 0 then show ca else "")
      ]
    ]

  mail-list-panel : Integer -> WidgetNode
  mail-list-panel (x) =
    let count = state-get "mail-count"
    in let sel-mode = state-get "select-mode"
    in widget-box "mail-list" "mail-list" [
      widget-box "ml-hdr" "mail-list-hdr" [
        widget-add-child (widget-custom "ml-search" "input" 0 0) (widget-label "ml-sp" "Search mail..."),
        widget-button "select-all" "Select All"
      ],
      if sel-mode == 1 then widget-box "sel-bar" "select-bar" [
        widget-label "sel-info" "Selection active",
        widget-button "delete-selected" "Delete Selected",
        widget-button "cancel-select" "Cancel"
      ] else widget-label "sel-spacer" "",
      widget-box "mail-items" "mail-items" (build-mail-items 0 count [])
    ]

  build-mail-items : Integer, Integer, List WidgetNode -> List WidgetNode
  build-mail-items (i) (count) (acc) =
    if i >= count then acc
    else let folder = state-get "folder"
    in let msg-folder = state-get ("m-folder-" & show i)
    in if msg-folder /= folder then build-mail-items (i + 1) count acc
    else let from = state-get-text ("m-from-" & show i)
    in let subj = state-get-text ("m-subj-" & show i)
    in let snip = state-get-text ("m-snip-" & show i)
    in let date = state-get-text ("m-date-" & show i)
    in let active = state-get "active-mail"
    in let is-read = state-get ("m-read-" & show i)
    in let is-star = state-get ("m-star-" & show i)
    in let has-attach = state-get ("m-attach-" & show i)
    in let css-class = if active == i then (if is-read == 0 then "mail-item active unread" else "mail-item active") else (if is-read == 0 then "mail-item unread" else "mail-item")
    in let star-indicator = if is-star == 1 then widget-label ("mx-" & show i) "&#x2B50;" else widget-label ("mx-" & show i) ""
    in let attach-indicator = if has-attach == 1 then widget-label ("ma-" & show i) "&#x1F4CE;" else widget-label ("ma-" & show i) ""
    in let item = widget-box-click ("mail-" & show i) css-class [
      widget-box ("mh-" & show i) "mail-item-hdr" [
        widget-label ("mf-" & show i) from,
        widget-box ("mi-" & show i) "mail-indicators" [
          star-indicator,
          attach-indicator,
          widget-label ("md-" & show i) date
        ]
      ],
      widget-label ("ms-" & show i) subj,
      widget-label ("mn-" & show i) snip
    ]
    in build-mail-items (i + 1) count (list-push acc item)

  mail-view-panel : Integer -> WidgetNode
  mail-view-panel (x) =
    let active = state-get "active-mail"
    in if active < 0 then widget-box "mail-view" "empty-mail" [ widget-label "mv-empty" "Select an email to read" ]
    else let subj = state-get-text ("m-subj-" & show active)
    in let from = state-get-text ("m-from-" & show active)
    in let body = state-get-text ("m-body-" & show active)
    in let date = state-get-text ("m-date-" & show active)
    in let is-star = state-get ("m-star-" & show active)
    in let star-text = if is-star == 1 then "&#x2B50; Unstar" else "&#x2606; Star"
    in widget-box "mail-view" "mail-view" [
      widget-box "mv-hdr" "mail-view-hdr" [
        widget-label "mv-subj" subj,
        widget-box "mv-meta" "mail-view-meta" [
          widget-label "mv-from" ("From: " & from),
          widget-label "mv-date" date
        ]
      ],
      widget-box "mv-body" "mail-view-body" [ widget-label "mv-text" body ],
      widget-box "mv-actions" "mail-view-actions" [
        widget-button "reply" "&#x21A9; Reply",
        widget-button "forward" "&#x21AA; Forward",
        widget-button "star-msg" star-text,
        widget-button "mark-unread" (if state-get ("m-read-" & show active) == 0 then "Mark Read" else "Mark Unread"),
        widget-button "archive-msg" "&#x1F4E6; Archive",
        widget-button "spam-msg" "&#x26A0; Spam",
        widget-button "delete" "&#x1F5D1; Delete"
      ]
    ]

  compose-panel : Integer -> WidgetNode
  compose-panel (x) =
    widget-box "mail-view" "mail-view" [
      widget-box "comp" "compose-modal" [
        widget-box "comp-hdr" "compose-hdr" [
          widget-label "comp-title" "New Message",
          widget-button "comp-close" "&#x2715;"
        ],
        widget-box "comp-fields" "compose-fields" [
          wk-attach (widget-custom "comp-to" "input" 0 0) [widget-label "comp-to-v" (state-get-text "comp-to-val"), widget-label "comp-to-p" "To"] 0 2,
          wk-attach (widget-custom "comp-subj" "input" 0 0) [widget-label "comp-subj-v" (state-get-text "comp-subj-val"), widget-label "comp-subj-p" "Subject"] 0 2
        ],
        widget-box "comp-body-wrap" "compose-body" [
          wk-attach (widget-custom "comp-body" "textarea" 0 0) [widget-label "comp-body-v" (state-get-text "comp-body-val")] 0 1
        ],
        widget-box "comp-actions" "compose-actions" [
          widget-button "send-mail" "&#x27A4; Send",
          widget-button "save-draft" "Save Draft"
        ]
      ]
    ]

