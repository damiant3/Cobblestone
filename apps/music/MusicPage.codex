Chapter: MusicPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Music player with playlists, album art, and playback controls.

 We say:

Section: Theme

  music-theme : Theme
  music-theme =
    let p = Palette { pal-bg = #111111, pal-fg = #D8D8D8, pal-primary = 1947988, pal-secondary = #1B1B1B, pal-accent = 1947988, pal-muted = #777777, pal-error = #EC4D30, pal-success = 1947988, pal-warning = #EF9B01, pal-border = #262626 }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws 0 (p.pal-fg) bn (eu 0) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "music-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  music-css : Text
  music-css =
    "*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}body{background:#111;color:#d8d8d8;font-family:system-ui,sans-serif}#app{display:flex;flex-direction:column;height:100vh}"
    & ".main{flex:1;display:flex;overflow:hidden}"
    & ".sidebar{width:240px;background:#000;padding:16px 0;display:flex;flex-direction:column;gap:8px}"
    & ".sidebar h2{padding:8px 20px;font-size:20px;color:#1db954;font-weight:bold}"
    & ".nav-item{padding:10px 20px;color:#aaa;font-size:14px;cursor:pointer;transition:color .15s}"
    & ".nav-item:hover,.nav-item.active{color:#fff}"
    & ".playlist-hdr{padding:16px 20px 8px;font-size:11px;color:#666;text-transform:uppercase;letter-spacing:1px}"
    & ".content{flex:1;overflow-y:auto;padding:24px 32px;background:linear-gradient(180deg,#1a1a2e 0%,#111 300px)}"
    & ".content h1{font-size:28px;font-weight:bold;margin-bottom:24px}"
    & ".album-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}"
    & ".album-card{background:#181818;border-radius:8px;padding:16px;cursor:pointer;transition:background .2s}"
    & ".album-card:hover{background:#282828}"
    & ".album-art{width:100%;aspect-ratio:1;border-radius:6px;margin-bottom:12px;display:flex;align-items:center;justify-content:center;font-size:48px}"
    & ".album-name{font-size:14px;font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".album-artist{font-size:12px;color:#777}"
    & ".track-list{margin-top:16px}"
    & ".track{display:flex;align-items:center;gap:16px;padding:10px 16px;border-radius:4px;cursor:pointer;transition:background .15s}"
    & ".track:hover{background:#1a1a1a}"
    & ".track.playing{color:#1db954}"
    & ".track-num{width:20px;text-align:right;font-size:13px;color:#666}"
    & ".track-info{flex:1}"
    & ".track-title{font-size:14px}"
    & ".track-artist{font-size:12px;color:#777}"
    & ".track-dur{font-size:13px;color:#666}"
    & ".player{height:80px;background:#181818;border-top:1px solid #282828;display:flex;align-items:center;padding:0 16px;gap:16px}"
    & ".player-art{width:56px;height:56px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:28px;background:#282828}"
    & ".player-info{width:180px}"
    & ".player-title{font-size:13px;font-weight:600}"
    & ".player-artist{font-size:11px;color:#777}"
    & ".player-controls{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}"
    & ".player-btns{display:flex;align-items:center;gap:20px}"
    & ".player-btns .wk-btn,.player-btns button{background:none;border:none;color:#aaa;font-size:18px;cursor:pointer;padding:4px}"
    & ".player-btns .wk-btn:hover,.player-btns button:hover{color:#fff}"
    & ".play-btn{width:36px;height:36px;border-radius:50%;background:#fff !important;color:#000 !important;display:flex;align-items:center;justify-content:center;font-size:16px !important}"
    & ".progress{width:100%;max-width:600px;height:4px;background:#333;border-radius:2px;overflow:hidden}"
    & ".progress-fill{height:100%;background:#1db954;width:35%;border-radius:2px}"
    & ".player-vol{display:flex;align-items:center;gap:8px;width:150px}"
    & ".vol-bar{flex:1;height:4px;background:#333;border-radius:2px;overflow:hidden}"
    & ".vol-fill{height:100%;background:#fff;width:70%;border-radius:2px}"
    & ".album-detail{padding:24px 32px}"
    & ".album-detail-hdr{display:flex;align-items:flex-end;gap:24px;margin-bottom:32px}"
    & ".album-detail-hdr .album-art{width:200px;height:200px;flex-shrink:0;font-size:72px}"
    & ".album-detail-hdr .album-meta{display:flex;flex-direction:column;gap:8px}"
    & ".album-detail-hdr .album-meta h2{font-size:36px;font-weight:bold}"
    & ".album-detail-hdr .album-meta p{font-size:14px;color:#aaa}"
    & ".back-btn{background:none;border:none;color:#aaa;cursor:pointer;font-size:14px;margin-bottom:16px;padding:4px 0}"
    & ".back-btn:hover{color:#fff}"
    & ".like-btn{background:none;border:none;color:#555;font-size:16px;cursor:pointer;padding:2px 6px;transition:color .15s}"
    & ".like-btn:hover{color:#e04060}"
    & ".like-btn.liked{color:#e04060}"
    & ".queue-panel{background:#181818;border-radius:8px;padding:16px;margin-top:16px}"
    & ".queue-panel h3{font-size:14px;font-weight:600;margin-bottom:12px;color:#aaa}"
    & ".vol-level{font-size:11px;color:#888;min-width:24px;text-align:center}"
    & ".shuffle.active{color:#1db954 !important}"
    & ".repeat.active{color:#1db954 !important}"
    & ".search-view{padding:48px;text-align:center}"
    & ".search-view h2{font-size:24px;margin-bottom:12px}"
    & ".search-view p{color:#777;font-size:14px}"

Section: Data

  album-name : Integer -> Text
  album-name (n) =
    if n == 1 then "Prismatic Dreams"
    else if n == 2 then "Ember Sessions"
    else if n == 3 then "Deep Current"
    else if n == 4 then "Emerald Path"
    else if n == 5 then "Starfield"
    else if n == 6 then "Acoustic Gold"
    else if n == 7 then "Violet Hour"
    else "Iron Resonance"

  album-artist : Integer -> Text
  album-artist (n) =
    if n == 1 then "Crystal Miners"
    else if n == 2 then "The Ashenvale"
    else if n == 3 then "Sapphire Coast"
    else if n == 4 then "Forest Echo"
    else if n == 5 then "Nebula One"
    else if n == 6 then "Topaz Strings"
    else if n == 7 then "Dusk Ensemble"
    else "Ferric Bloom"

  album-icon : Integer -> Text
  album-icon (n) =
    if n == 1 then "&#x1F3B5;"
    else if n == 2 then "&#x1F525;"
    else if n == 3 then "&#x1F30A;"
    else if n == 4 then "&#x1F33F;"
    else if n == 5 then "&#x2728;"
    else if n == 6 then "&#x1F3B8;"
    else if n == 7 then "&#x1F31C;"
    else "&#x26A1;"

  album-bg : Integer -> Text
  album-bg (n) =
    if n == 1 then "#1a3a4a"
    else if n == 2 then "#3a1a1a"
    else if n == 3 then "#1a2a4a"
    else if n == 4 then "#1a3a1a"
    else if n == 5 then "#2a2a3a"
    else if n == 6 then "#3a2a1a"
    else if n == 7 then "#2a1a3a"
    else "#2a2a2a"

  track-title : Integer -> Text
  track-title (n) =
    if n == 1 then "Crystalline"
    else if n == 2 then "Molten Core"
    else if n == 3 then "Tidal Force"
    else if n == 4 then "Canopy Light"
    else if n == 5 then "Supernova"
    else if n == 6 then "Amber Glow"
    else if n == 7 then "Reef Walker"
    else if n == 8 then "Iron Veil"
    else if n == 9 then "Twilight Arc"
    else "Pulse Engine"

  track-artist : Integer -> Text
  track-artist (n) =
    if n == 1 then "Crystal Miners"
    else if n == 2 then "The Ashenvale"
    else if n == 3 then "Sapphire Coast"
    else if n == 4 then "Forest Echo"
    else if n == 5 then "Nebula One"
    else if n == 6 then "Topaz Strings"
    else if n == 7 then "Sapphire Coast"
    else if n == 8 then "Ferric Bloom"
    else if n == 9 then "Dusk Ensemble"
    else "Nebula One"

  track-duration : Integer -> Text
  track-duration (n) =
    if n == 1 then "3:42"
    else if n == 2 then "4:15"
    else if n == 3 then "3:58"
    else if n == 4 then "5:01"
    else if n == 5 then "4:33"
    else if n == 6 then "3:27"
    else if n == 7 then "4:48"
    else if n == 8 then "3:55"
    else if n == 9 then "5:12"
    else "4:06"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-panel "root" DirColumn 0 [
      widget-box "main" "main" [
        sidebar-tree 0,
        content-tree 0
      ],
      player-bar 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexMusic",
      widget-box-click "n-home" "nav-item active" [ widget-label "nh" "&#x1F3E0; Home" ],
      widget-box-click "n-search" "nav-item" [ widget-label "ns" "&#x1F50D; Search" ],
      widget-box "n-lib" "nav-item" [ widget-label "nl" "&#x1F4DA; Library" ],
      widget-label "pl-hdr" "PLAYLISTS",
      widget-box-click "pl-1" "nav-item" [ widget-label "p1" "Liked Songs" ],
      widget-box "pl-2" "nav-item" [ widget-label "p2" "Chill Vibes" ],
      widget-box "pl-3" "nav-item" [ widget-label "p3" "Workout" ],
      widget-box "pl-4" "nav-item" [ widget-label "p4" "Focus" ]
    ]

  content-tree : Integer -> WidgetNode
  content-tree (x) =
    let vm = state-get "view-mode"
    in let sv = state-get "search-view"
    in let lv = state-get "show-liked"
    in if sv == 1 then search-view-tree 0
    else if lv == 1 then liked-view-tree 0
    else if vm == 1 then album-detail-view 0
    else home-view-tree 0

  home-view-tree : Integer -> WidgetNode
  home-view-tree (x) =
    let qv = state-get "queue-visible"
    in widget-box "content" "content" [
      widget-label "greet" "Good evening",
      widget-box "albums" "album-grid" [
        album-card "a1" (album-icon 1) (album-bg 1) (album-name 1) (album-artist 1),
        album-card "a2" (album-icon 2) (album-bg 2) (album-name 2) (album-artist 2),
        album-card "a3" (album-icon 3) (album-bg 3) (album-name 3) (album-artist 3),
        album-card "a4" (album-icon 4) (album-bg 4) (album-name 4) (album-artist 4),
        album-card "a5" (album-icon 5) (album-bg 5) (album-name 5) (album-artist 5),
        album-card "a6" (album-icon 6) (album-bg 6) (album-name 6) (album-artist 6),
        album-card "a7" (album-icon 7) (album-bg 7) (album-name 7) (album-artist 7),
        album-card "a8" (album-icon 8) (album-bg 8) (album-name 8) (album-artist 8)
      ],
      widget-label "recent-hdr" "Recently Played",
      widget-label "track-count" "10 tracks",
      widget-box "tracks" "track-list" [
        track-row "t1" "1" (track-title 1) (track-artist 1) (track-duration 1),
        track-row "t2" "2" (track-title 2) (track-artist 2) (track-duration 2),
        track-row "t3" "3" (track-title 3) (track-artist 3) (track-duration 3),
        track-row "t4" "4" (track-title 4) (track-artist 4) (track-duration 4),
        track-row "t5" "5" (track-title 5) (track-artist 5) (track-duration 5),
        track-row "t6" "6" (track-title 6) (track-artist 6) (track-duration 6),
        track-row "t7" "7" (track-title 7) (track-artist 7) (track-duration 7),
        track-row "t8" "8" (track-title 8) (track-artist 8) (track-duration 8),
        track-row "t9" "9" (track-title 9) (track-artist 9) (track-duration 9),
        track-row "t10" "10" (track-title 10) (track-artist 10) (track-duration 10)
      ],
      if qv == 1 then queue-panel 0 else widget-label "qh" ""
    ]

  search-view-tree : Integer -> WidgetNode
  search-view-tree (x) =
    widget-box "content" "content" [
      widget-box "sv" "search-view" [
        widget-label "sv-h" "&#x1F50D; Search",
        widget-label "sv-p" "Find your favorite songs, albums, and artists"
      ]
    ]

  liked-view-tree : Integer -> WidgetNode
  liked-view-tree (x) =
    widget-box "content" "content" [
      widget-button "back-liked" "&#x2190; Back",
      widget-label "liked-hdr" "Liked Songs",
      widget-box "liked-tracks" "track-list" (build-liked-tracks 1 10 [])
    ]

  build-liked-tracks : Integer, Integer, List WidgetNode -> List WidgetNode
  build-liked-tracks (i) (max) (acc) =
    if i > max then acc
    else let lk = state-get ("liked-" & show i)
    in if lk == 1 then build-liked-tracks (i + 1) max (list-push acc (track-row ("lt" & show i) (show i) (track-title i) (track-artist i) (track-duration i)))
    else build-liked-tracks (i + 1) max acc

  album-detail-view : Integer -> WidgetNode
  album-detail-view (x) =
    let sel = state-get "selected-album"
    in widget-box "content" "content" [
      widget-box "ad" "album-detail" [
        widget-button "back-home" "&#x2190; Back",
        widget-box "ad-hdr" "album-detail-hdr" [
          widget-add-child (widget-custom "ad-art" ("box:album-art") 0 0) (widget-label "ad-icon" (album-icon sel)),
          widget-box "ad-meta" "album-meta" [
            widget-label "ad-type" "ALBUM",
            widget-label "ad-name" (album-name sel),
            widget-label "ad-artist" (album-artist sel)
          ]
        ],
        widget-box "ad-tracks" "track-list" [
          track-row "dt1" "1" (track-title 1) (album-artist sel) (track-duration 1),
          track-row "dt2" "2" (track-title 2) (album-artist sel) (track-duration 2),
          track-row "dt3" "3" (track-title 3) (album-artist sel) (track-duration 3),
          track-row "dt4" "4" (track-title 4) (album-artist sel) (track-duration 4),
          track-row "dt5" "5" (track-title 5) (album-artist sel) (track-duration 5)
        ]
      ]
    ]

  album-card : Text, Text, Text, Text, Text -> WidgetNode
  album-card (id) (icon) (bg) (name) (artist) =
    widget-box-click id "album-card" [
      widget-add-child (widget-custom (id & "a") ("box:album-art") 0 0) (widget-label (id & "i") icon),
      widget-label (id & "n") name,
      widget-label (id & "r") artist
    ]

  track-row : Text, Text, Text, Text, Text -> WidgetNode
  track-row (id) (num) (title) (artist) (dur) =
    let tn = id-num id
    in let cls = if tn == state-get "now-playing-track" then "track playing" else "track"
    in let lk = state-get ("liked-" & show tn)
    in let heart-cls = if lk == 1 then "like-btn liked" else "like-btn"
    in widget-box-click id cls [
      widget-label (id & "n") (if tn == state-get "now-playing-track" then "&#x1F50A;" else num),
      widget-box (id & "i") "track-info" [
        widget-label (id & "t") title,
        widget-label (id & "a") artist
      ],
      widget-label (id & "d") dur,
      widget-button ("like-" & show tn) "&#x2764;"
    ]

  queue-panel : Integer -> WidgetNode
  queue-panel (x) =
    let cur = state-get "now-playing-track"
    in let n1 = if cur >= 10 then 1 else cur + 1
    in let n2 = if n1 >= 10 then 1 else n1 + 1
    in let n3 = if n2 >= 10 then 1 else n2 + 1
    in widget-box "qp" "queue-panel" [
      widget-label "qp-hdr" "Up Next",
      track-row "q1" (show n1) (track-title n1) (track-artist n1) (track-duration n1),
      track-row "q2" (show n2) (track-title n2) (track-artist n2) (track-duration n2),
      track-row "q3" (show n3) (track-title n3) (track-artist n3) (track-duration n3)
    ]

  player-bar : Integer -> WidgetNode
  player-bar (x) =
    let playing = state-get "playing"
    in let cur = state-get "now-playing-track"
    in let shuf = state-get "shuffle"
    in let rpt = state-get "repeat-mode"
    in let vol = state-get "volume"
    in let vol-pct = if vol == 0 then "0" else show (vol * 10)
    in let shuf-cls = if shuf == 1 then "shuffle active" else "shuffle"
    in let rpt-cls = if rpt > 0 then "repeat active" else "repeat"
    in let rpt-icon = if rpt == 2 then "&#x1F502;" else "&#x1F501;"
    in widget-box "player" "player" [
      widget-box "part" "player-art" [ widget-label "part-i" "&#x1F3B5;" ],
      widget-box "pinfo" "player-info" [
        widget-label "ptitle" (if cur > 0 then track-title cur else ""),
        widget-label "partist" (if cur > 0 then track-artist cur else ""),
        widget-label "pdur" (if cur > 0 then track-duration cur else "")
      ],
      widget-box "pctrl" "player-controls" [
        widget-box "pbtns" "player-btns" [
          widget-box-click "shuffle" shuf-cls [widget-label "shuf-i" "&#x1F500;"],
          widget-button "prev" "&#x23EE;",
          widget-button "play" (if playing == 1 then "&#x23F8;" else "&#x25B6;"),
          widget-button "next" "&#x23ED;",
          widget-box-click "repeat" rpt-cls [widget-label "rpt-i" rpt-icon],
          widget-button "queue" "&#x1F4CB;"
        ],
        widget-box "prog" "progress" [
          widget-box "prog-fill" "progress-fill" []
        ]
      ],
      widget-box "pvol" "player-vol" [
        widget-button "vol-down" "&#x1F509;",
        widget-box "vol-bar" "vol-bar" [
          widget-box "vol-fill" "vol-fill" []
        ],
        widget-button "vol-up" "&#x1F50A;",
        widget-label "vol-lbl" (vol-pct & "%")
      ]
    ]

Section: Handlers

  music-click : Text -> Integer
  music-click (id) =
    if id == "play" then let s = state-set-render "playing" (if state-get "playing" == 1 then 0 else 1) in 0
    else if id == "next" then
      let cur = state-get "now-playing-track"
      in let nxt = if cur >= 10 then 1 else cur + 1
      in let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" nxt in 0
    else if id == "prev" then
      let cur = state-get "now-playing-track"
      in let pv = if cur <= 1 then 10 else cur - 1
      in let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" pv in 0
    else if id == "shuffle" then let s = state-set-render "shuffle" (if state-get "shuffle" == 1 then 0 else 1) in 0
    else if id == "repeat" then
      let rm = state-get "repeat-mode"
      in let nrm = if rm >= 2 then 0 else rm + 1
      in let s = state-set-render "repeat-mode" nrm in 0
    else if id == "vol-up" then
      let v = state-get "volume"
      in let nv = if v >= 10 then 10 else v + 1
      in let s = state-set-render "volume" nv in 0
    else if id == "vol-down" then
      let v = state-get "volume"
      in let nv = if v <= 0 then 0 else v - 1
      in let s = state-set-render "volume" nv in 0
    else if id == "queue" then let s = state-set-render "queue-visible" (if state-get "queue-visible" == 1 then 0 else 1) in 0
    else if id == "back-home" then let s = state-set "view-mode" 0 in let s2 = state-set-render "selected-album" 0 in 0
    else if id == "back-liked" then let s = state-set-render "show-liked" 0 in 0
    else if id == "pl-1" then let s = state-set "search-view" 0 in let s2 = state-set "view-mode" 0 in let s3 = state-set-render "show-liked" 1 in 0
    else if id == "n-home" then let s = state-set "search-view" 0 in let s2 = state-set "show-liked" 0 in let s3 = state-set-render "view-mode" 0 in 0
    else if id == "n-search" then let s = state-set "view-mode" 0 in let s2 = state-set-render "search-view" 1 in 0
    else if text-starts-with id "like-" then
      let ln = id-num id
      in let key = "liked-" & show ln
      in let cur = state-get key
      in let s = state-set-render key (if cur == 1 then 0 else 1) in 0
    else if text-starts-with id "a" then
      let an = id-num id
      in if an >= 1 then
        let s = state-set "search-view" 0 in let s2 = state-set "selected-album" an in let s3 = state-set-render "view-mode" 1 in 0
      else 0
    else if text-starts-with id "t" then
      let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" (id-num id) in 0
    else if text-starts-with id "dt" then
      let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" (id-num id) in 0
    else if text-starts-with id "lt" then
      let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" (id-num id) in 0
    else if text-starts-with id "q" then
      let s = state-set "playing" 1 in let s2 = state-set-render "now-playing-track" (id-num id) in 0
    else 0

Section: Entry

  render-music : Integer -> Integer
  render-music (x) =
    let s = state-set "volume" (if state-get "volume" == 0 then 7 else state-get "volume")
    in mount-widget-themed music-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let sv = state-set "volume" 7
    in let s01 = state-set "playing" 0
    in let s02 = state-set "now-playing-track" 0
    in let s03 = state-set "shuffle" 0
    in let s04 = state-set "repeat-mode" 0
    in let s05 = state-set "view-mode" 0
    in let s06 = state-set "search-view" 0
    in let s07 = state-set "selected-album" 0
    in let s08 = state-set "queue-visible" 0
    in let s09 = state-set "show-liked" 0
    in let t = inject-app-style music-theme music-css
    in let s = set-render render-music
    in let h = register-handlers no-pick music-click
    in render-music 0
  end

Page 1
