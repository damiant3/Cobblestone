  news-item : Text, Text, Text, Text -> WidgetNode
  news-item (id) (time) (source) (title) =
    widget-box id "news-item" [
      widget-label (id & "t") time,
      widget-box (id & "b") "" [
        widget-label (id & "h") title,
        widget-label (id & "s") source
      ]
    ]

Section: Chart

  price-bar-chart : Integer -> WidgetNode
  price-bar-chart (x) =
    widget-box "bars" "detail-grid" [
      price-bar "bar-mon" "Mon" 72,
      price-bar "bar-tue" "Tue" 85,
      price-bar "bar-wed" "Wed" 60,
      price-bar "bar-thu" "Thu" 90,
      price-bar "bar-fri" "Fri" 78
    ]

  price-bar : Text, Text, Integer -> WidgetNode
  price-bar (id) (label) (pct) =
    widget-box id "detail-card" [
      widget-label (id & "l") label,
      widget-gauge (id & "g") pct 100,
      widget-label (id & "v") (show pct & "%")
    ]

Section: Handlers

  markets-click : Text -> Integer
  markets-click (id) =
    if id == "n-stocks" then let s = state-set-render "tab" 0 in 0
    else if id == "n-bonds" then let s = state-set-render "tab" 1 in 0
    else if id == "n-commodities" then let s = state-set-render "tab" 2 in 0
    else if id == "n-watchlist" then let s = state-set-render "tab" 3 in 0
    else if id == "p-1d" then let s = state-set-render "period" 0 in 0
    else if id == "p-5d" then let s = state-set-render "period" 1 in 0
    else if id == "p-1m" then let s = state-set-render "period" 2 in 0
    else if id == "p-3m" then let s = state-set-render "period" 3 in 0
    else if id == "p-6m" then let s = state-set-render "period" 4 in 0
    else if id == "p-1y" then let s = state-set-render "period" 5 in 0
    else if id == "p-5y" then let s = state-set-render "period" 6 in 0
    else if id == "p-max" then let s = state-set-render "period" 7 in 0
    else if id == "btn-add" then let s = state-set-render "watchlist-count" (state-get "watchlist-count" + 1) in 0
    else 0

Section: Entry

  render-markets : Integer -> Integer
  render-markets (x) = mount-widget-themed markets-theme (page-tree 0)

  opening : [Console] Integer
  opening = act
    let t = inject-app-style markets-theme markets-css
    in let sp = state-set "period" 5
    in let s = set-render render-markets
    in let h = register-handlers no-pick markets-click
    in render-markets 0
  end

