  market-news (x) =
    widget-box "news" "news-list" [
      news-item "n0" "2:15 PM" "Reuters" "Fed signals patience on rate cuts as inflation data remains mixed",
      news-item "n1" "1:42 PM" "Bloomberg" "NVIDIA surges on AI chip demand outlook, hits new revenue record",
      news-item "n2" "12:58 PM" "CNBC" "Treasury yields pull back as bond auction sees strong demand",
