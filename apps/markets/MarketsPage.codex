Chapter: MarketsPage
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Financial markets tracker for stocks, bonds, commodities, and indices with
 watchlists, sparkline charts, and market overview.

 We say:

Section: Theme

  markets-theme : Theme
  markets-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = #41AF4E, pal-secondary = 1447446, pal-accent = #4490FF, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "markets-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  markets-css : Text
  markets-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0b0e11;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".markets{display:grid;grid-template-columns:280px 1fr;min-height:100vh}"
    & ".sidebar{background:#0f1216;border-right:1px solid #1c2127;padding:16px 0;overflow-y:auto}"
    & ".sidebar-hdr{font-size:18px;font-weight:700;padding:8px 20px 4px;color:#3fb950}"
    & ".sidebar-sub{font-size:11px;color:#555;padding:0 20px 16px}"
    & ".search-box{margin:0 16px 12px;background:#161b20;border:1px solid #1c2127;border-radius:8px;padding:8px 12px;color:#ccc;font-size:13px}"
    & ".nav-group{margin-bottom:4px}"
    & ".nav-hdr{font-size:10px;color:#444;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px}"
    & ".nav-item{padding:8px 20px;cursor:pointer;font-size:13px;color:#8b949e;transition:background .1s;display:flex;align-items:center;justify-content:space-between}"
    & ".nav-item:hover{background:#161b20;color:#ccc}"
    & ".nav-item.active{color:#3fb950;background:#0d1a12}"
    & ".nav-count{font-size:11px;color:#444}"
    & ".main{overflow-y:auto;padding:20px 24px}"
    & ".ticker-strip{display:flex;gap:12px;margin-bottom:20px;overflow-x:auto;padding-bottom:4px}"
    & ".ticker{background:#131820;border:1px solid #1c2127;border-radius:8px;padding:10px 16px;min-width:150px;flex-shrink:0;cursor:pointer;transition:border-color .15s}"
    & ".ticker:hover{border-color:#3fb950}"
    & ".ticker-sym{font-size:12px;font-weight:700;color:#ccc;margin-bottom:2px}"
    & ".ticker-price{font-size:18px;font-weight:700;margin-bottom:2px}"
    & ".ticker-chg{font-size:12px;font-weight:600}"
    & ".up{color:#3fb950}.down{color:#f85149}"
    & ".section-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}"
    & ".section-title{font-size:15px;font-weight:600}"
    & ".section-link{font-size:12px;color:#449dff;cursor:pointer}"
    & ".quote-table{width:100%;font-size:13px;margin-bottom:24px}"
    & ".quote-table>div{display:grid;grid-template-columns:80px 1fr repeat(5,100px);gap:0;align-items:center}"
    & ".quote-table>div:first-child{border-bottom:2px solid #1c2127}"
    & ".quote-table>div:first-child .wk-lbl{color:#555;font-size:10px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;padding:8px 12px}"
    & ".quote-table>div:not(:first-child){border-bottom:1px solid #131820;cursor:pointer}"
    & ".quote-table>div:not(:first-child):hover{background:#131820}"
    & ".quote-table>div .wk-lbl{padding:10px 12px;font-variant-numeric:tabular-nums}"
    & ".quote-table>div .wk-lbl:first-child{font-weight:700;color:#e6edf3}"
    & ".quote-table>div .wk-lbl:nth-child(2){color:#8b949e;font-size:12px}"
    & ".quote-table>div .wk-lbl:nth-child(n+3){text-align:right}"
    & ".spark{display:inline-block;width:80px;height:24px;vertical-align:middle}"
    & ".detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:24px}"
    & ".detail-card{background:#131820;border:1px solid #1c2127;border-radius:10px;padding:16px}"
    & ".detail-label{font-size:10px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}"
    & ".detail-val{font-size:20px;font-weight:700}"
    & ".detail-sub{font-size:11px;color:#8b949e;margin-top:2px}"
    & ".chart-placeholder{background:#131820;border:1px solid #1c2127;border-radius:10px;height:240px;display:flex;align-items:center;justify-content:center;color:#333;font-size:14px;margin-bottom:24px}"
    & ".period-btns{display:flex;gap:4px;margin-bottom:12px}"
    & ".period-btn{background:#131820;border:1px solid #1c2127;color:#8b949e;padding:5px 12px;border-radius:6px;cursor:pointer;font-size:11px}"
    & ".period-btn:hover{color:#ccc;border-color:#333}"
    & ".period-btn.active{background:#0d1a12;border-color:#3fb950;color:#3fb950}"
    & ".news-list{margin-bottom:24px}"
    & ".news-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #131820;cursor:pointer}"
    & ".news-item:hover{background:#0f1216}"
    & ".news-time{font-size:11px;color:#555;min-width:60px;flex-shrink:0}"
    & ".news-title{font-size:13px;color:#ccc;line-height:1.4}"
    & ".news-source{font-size:11px;color:#449dff}"

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    let tab = state-get "tab"
    in widget-box "markets" "markets" [
      sidebar-tree tab,
      if tab == 1 then bonds-view 0
      else if tab == 2 then commodities-view 0
      else if tab == 3 then watchlist-view 0
      else stocks-view 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (tab) =
    widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexMarkets",
      widget-label "sub" "Real-time financial data",
      widget-label "search" "Search symbol...",
      widget-box "ng-markets" "nav-group" [
        widget-label "nh-markets" "Markets",
        nav-item "n-stocks" "&#x1F4C8; Stocks" "" (tab == 0),
        nav-item "n-bonds" "&#x1F3E6; Bonds" "" (tab == 1),
        nav-item "n-commodities" "&#x1F6E2; Commodities" "" (tab == 2)
      ],
      widget-box "ng-personal" "nav-group" [
        widget-label "nh-personal" "Personal",
        nav-item "n-watchlist" "&#x2B50; Watchlist" "8" (tab == 3),
        nav-item "n-portfolio" "&#x1F4BC; Portfolio" "" False,
        nav-item "n-alerts" "&#x1F514; Alerts" "2" False
      ],
      widget-box "ng-indices" "nav-group" [
        widget-label "nh-indices" "Indices",
        index-item "ix-sp" "S&P 500" "5,892.41" "+0.87%" True,
        index-item "ix-dow" "Dow Jones" "43,218.75" "+0.62%" True,
        index-item "ix-nas" "Nasdaq" "19,104.33" "+1.24%" True,
        index-item "ix-rut" "Russell 2000" "2,187.45" "-0.31%" False
      ]
    ]

  nav-item : Text, Text, Text, Boolean -> WidgetNode
  nav-item (id) (label) (count) (active) =
    let cls = if active then "nav-item active" else "nav-item"
    in if text-length count > 0
    then widget-box id cls [widget-label (id & "l") label, widget-label (id & "c") count]
    else widget-box id cls [widget-label (id & "l") label]

  index-item : Text, Text, Text, Text, Boolean -> WidgetNode
  index-item (id) (name) (price) (chg) (is-up) =
    widget-box id "nav-item" [
      widget-label (id & "n") name,
      widget-box (id & "r") "" [
        widget-label (id & "p") price,
        widget-label (id & "c") chg
      ]
    ]

  stocks-view : Integer -> WidgetNode
  stocks-view (x) =
    widget-box "main" "main" [
      ticker-strip 0,
      widget-box "sh-stocks" "section-hdr" [
        widget-label "st-stocks" "Stocks",
        widget-label "sl-all" "View All"
      ],
      period-buttons 0,
      widget-box "chart" "chart-placeholder" [
        widget-label "chart-lbl" ("Chart: S&P 500 &#x2014; " & period-name (state-get "period")),
        price-bar-chart 0
      ],
      stock-table 0,
      widget-box "sh-news" "section-hdr" [
        widget-label "st-news" "Market News",
        widget-label "sl-news" "More"
      ],
      market-news 0
    ]

  ticker-strip : Integer -> WidgetNode
  ticker-strip (x) =
    widget-box "tickers" "ticker-strip" [
      ticker-card "t-aapl" "AAPL" "198.45" "+2.31" "+1.18%" True,
      ticker-card "t-msft" "MSFT" "452.80" "+5.12" "+1.14%" True,
      ticker-card "t-googl" "GOOGL" "178.92" "-0.84" "-0.47%" False,
      ticker-card "t-amzn" "AMZN" "203.15" "+3.67" "+1.84%" True,
      ticker-card "t-nvda" "NVDA" "131.28" "+4.56" "+3.60%" True,
      ticker-card "t-tsla" "TSLA" "248.90" "-6.30" "-2.47%" False,
      ticker-card "t-meta" "META" "512.40" "+8.15" "+1.62%" True
    ]

  ticker-card : Text, Text, Text, Text, Text, Boolean -> WidgetNode
  ticker-card (id) (sym) (price) (chg) (pct) (is-up) =
    let chg-cls = if is-up then "ticker up" else "ticker down"
    in widget-box id chg-cls [
      widget-label (id & "s") sym,
      widget-label (id & "p") price,
      widget-label (id & "c") (chg & " (" & pct & ")")
    ]

  period-name : Integer -> Text
  period-name (n) =
    if n == 0 then "1 Day" else if n == 1 then "5 Days" else if n == 2 then "1 Month"
    else if n == 3 then "3 Months" else if n == 4 then "6 Months" else if n == 5 then "1 Year"
    else if n == 6 then "5 Years" else "Max"

  period-buttons : Integer -> WidgetNode
  period-buttons (x) =
    widget-box "periods" "period-btns" [
      widget-button "p-1d" "1D",
      widget-button "p-5d" "5D",
      widget-button "p-1m" "1M",
      widget-button "p-3m" "3M",
      widget-button "p-6m" "6M",
      widget-button "p-1y" "1Y",
      widget-button "p-5y" "5Y",
      widget-button "p-max" "Max"
    ]

  stock-table : Integer -> WidgetNode
  stock-table (x) =
    widget-box "stocks-tbl" "quote-table" [
      widget-box "st-hdr" "" [
        widget-label "th-sym" "SYMBOL",
        widget-label "th-name" "NAME",
        widget-label "th-price" "PRICE",
        widget-label "th-chg" "CHANGE",
        widget-label "th-pct" "%",
        widget-label "th-vol" "VOLUME",
        widget-label "th-cap" "MKT CAP"
      ],
      stock-row "sr-aapl" "AAPL" "Apple Inc." "198.45" "+2.31" "+1.18%" "52.3M" "3.02T" True,
      stock-row "sr-msft" "MSFT" "Microsoft Corp." "452.80" "+5.12" "+1.14%" "28.1M" "3.37T" True,
      stock-row "sr-googl" "GOOGL" "Alphabet Inc." "178.92" "-0.84" "-0.47%" "31.5M" "2.21T" False,
      stock-row "sr-amzn" "AMZN" "Amazon.com Inc." "203.15" "+3.67" "+1.84%" "44.8M" "2.12T" True,
      stock-row "sr-nvda" "NVDA" "NVIDIA Corp." "131.28" "+4.56" "+3.60%" "89.2M" "3.22T" True,
      stock-row "sr-tsla" "TSLA" "Tesla Inc." "248.90" "-6.30" "-2.47%" "67.4M" "793B" False,
      stock-row "sr-meta" "META" "Meta Platforms" "512.40" "+8.15" "+1.62%" "18.7M" "1.30T" True,
      stock-row "sr-brk" "BRK.B" "Berkshire Hathaway" "472.35" "+1.89" "+0.40%" "4.2M" "1.03T" True,
      stock-row "sr-jpm" "JPM" "JPMorgan Chase" "218.60" "+3.42" "+1.59%" "12.3M" "634B" True,
      stock-row "sr-v" "V" "Visa Inc." "298.15" "-1.20" "-0.40%" "8.9M" "612B" False
    ]

  stock-row : Text, Text, Text, Text, Text, Text, Text, Text, Boolean -> WidgetNode
  stock-row (id) (sym) (name) (price) (chg) (pct) (vol) (cap) (is-up) =
    let color-cls = if is-up then "up" else "down"
    in widget-box id "" [
      widget-label (id & "s") sym,
      widget-label (id & "n") name,
      widget-label (id & "p") price,
      widget-box (id & "cw") color-cls [widget-label (id & "c") chg],
      widget-box (id & "pw") color-cls [widget-label (id & "pct") pct],
      widget-label (id & "v") vol,
      widget-label (id & "cap") cap
    ]

  bonds-view : Integer -> WidgetNode
  bonds-view (x) =
    widget-box "main" "main" [
      widget-box "sh-treas" "section-hdr" [
        widget-label "st-treas" "U.S. Treasury Yields"
      ],
      detail-row "tr" [
        detail-card "tr-2y" "2-Year" "4.28%" "&#x25B2; 0.03",
        detail-card "tr-5y" "5-Year" "4.12%" "&#x25B2; 0.02",
        detail-card "tr-10y" "10-Year" "4.35%" "&#x25BC; 0.01",
        detail-card "tr-30y" "30-Year" "4.52%" "&#x25BC; 0.02"
      ],
      widget-label "yield-chart" "Yield Curve Chart",
      widget-box "sh-corp" "section-hdr" [
        widget-label "st-corp" "Corporate Bonds"
      ],
      bond-table 0,
      widget-box "sh-muni" "section-hdr" [
        widget-label "st-muni" "Municipal Bonds"
      ],
      muni-table 0
    ]

  detail-row : Text, List WidgetNode -> WidgetNode
  detail-row (id) (cards) =
    wk-attach (widget-custom id "box:detail-grid" 0 0) cards 0 (list-length cards)

  detail-card : Text, Text, Text, Text -> WidgetNode
  detail-card (id) (label) (val) (sub) =
    widget-box id "detail-card" [
      widget-label (id & "l") label,
      widget-label (id & "v") val,
      widget-label (id & "s") sub
    ]

  bond-table : Integer -> WidgetNode
  bond-table (x) =
