      bond-row "b-pg" "Procter & Gamble" "2.45%" "2027" "3.98%" "99.20" "AA-"
    ]

  bond-row : Text, Text, Text, Text, Text, Text, Text -> WidgetNode
  bond-row (id) (name) (coupon) (mat) (yield) (price) (rating) =
