      widget-box "bt-hdr" "" [
        widget-label "bh-name" "ISSUER",
        widget-label "bh-coupon" "COUPON",
        widget-label "bh-mat" "MATURITY",
        widget-label "bh-yield" "YIELD",
        widget-label "bh-price" "PRICE",
        widget-label "bh-rating" "RATING"
      ],
