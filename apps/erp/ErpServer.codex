    in erp-seed-customers st2

Section: HTTP Transport

  ErpLoop = record {
    erp-transport : TcpTransportState,
    erp-state : ErpState,
    erp-requests : Integer
  }

 BOTH RESPONSES GO THROUGH ONE SENDER so the truncation branch exists once.
 A half-written HTTP response cannot be repaired mid-stream, and the loop below
 keeps serving on whatever transport comes back, so a short write left it
 reading the client's next request out of the middle of a corrupted body.
 Closing turns that into a short body and a FIN the client can report.

  erp-send : TcpTransportState, List Integer -> [Network.Read, Network.Write] TcpTransportState
  erp-send (ts) (bytes) = act
    r <- net-io-send-raw-checked ts bytes
    if r.ns-complete then r.ns-transport
    else net-io-close (r.ns-transport)
  end

  erp-handle-request : ErpLoop, TransportRecvResult -> [Network.Read, Network.Write] ErpLoop
  erp-handle-request (ls) (recv) =
    let req = http-parse-request (recv.body)
    in if req.valid == False then act
      ts2 <- erp-send (ls.erp-transport) (http-encode (erp-bad-request "malformed request"))
      ErpLoop { erp-transport = ts2, erp-state = ls.erp-state, erp-requests = ls.erp-requests + 1 }
    end
    else let (st2, resp) = erp-route (ls.erp-state) req
      in let resp-bytes = http-encode resp
      in act
        ts2 <- erp-send (ls.erp-transport) resp-bytes
        ErpLoop { erp-transport = ts2, erp-state = st2, erp-requests = ls.erp-requests + 1 }
      end

  erp-loop : ErpLoop -> [Console, Network.Read, Network.Write] Integer
  erp-loop (ls) = act
    recv <- net-io-recv-loop (ls.erp-transport) 0
    if recv.has-message then act
      next <- erp-handle-request ls recv
      erp-loop next
    end
    else act
      ls.erp-requests
    end
  end

  erp-local-mac : List Integer = [82, 84, 0, 18, 52, 100]
  erp-local-ip : List Integer = [10, 0, 2, 15]
  erp-gateway-ip : List Integer = [10, 0, 2, 2]
  erp-host-ip : List Integer = [127, 0, 0, 1]

  erp-server : ErpState -> [Console, Network.Read, Network.Write] Integer
  erp-server (st) =
    let sess = net-session-new erp-local-mac erp-local-ip erp-gateway-ip 49154 9200 erp-host-ip 2000
    in let ts = transport-new sess
    in act
      ts1 <- net-io-connect ts
      erp-loop (ErpLoop { erp-transport = ts1, erp-state = st, erp-requests = 0 })
    end

