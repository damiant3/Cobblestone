Section: GL State

  GlState = record {
    gl-db : DbServer,
    gl-log : LogState,
    gl-accounts : List GlAccount,
    gl-periods : List FiscalPeriod,
    gl-journals : List JournalEntry,
    gl-balances : HamtMap Integer,
    gl-next-id : Integer,
    gl-company : Text
  }

  gl-accounts-tdef : TableDef
  gl-accounts-tdef = table-def "gl_accounts" [col-def-not-null "number" ColText, col-def "name" ColText, col-def "atype" ColText, col-def "company" ColText]

  gl-journals-tdef : TableDef
  gl-journals-tdef = table-def "gl_journals" [col-def-not-null "id" ColText, col-def "period" ColInteger, col-def "year" ColInteger, col-def "description" ColText]

  gl-lines-tdef : TableDef
  gl-lines-tdef = table-def "gl_journal_lines" [col-def-not-null "je" ColText, col-def "account" ColText, col-def "debit" ColInteger, col-def "credit" ColInteger]

  gl-audit-tdef : TableDef
  gl-audit-tdef = table-def "gl_audit" [col-def-not-null "seq" ColInteger, col-def "category" ColText, col-def "message" ColText]

  gl-init : Text -> GlState
  gl-init (company) =
    let db = db-server-new ("gl-" & company)
    in let db2 = db-create-table db gl-accounts-tdef
    in let db3 = db-create-table db2 gl-journals-tdef
    in let db4 = db-create-table db3 gl-lines-tdef
    in let db5 = db-create-table db4 gl-audit-tdef
    in let log = logger-new 256 log-info
    in let log2 = log-info-msg log "gl" ("initialized for " & company) 0
    in GlState {
      gl-db = db5,
      gl-log = log2,
      gl-accounts = [],
      gl-periods = [],
      gl-journals = [],
      gl-balances = hamt-empty,
      gl-next-id = 100000,
      gl-company = company
    }

  gl-gen-id : GlState, Text -> (GlState, Text)
  gl-gen-id (st) (prefix) =
    let id = prefix & "-" & show (st.gl-next-id)
    in (__record-set st "gl-next-id" (st.gl-next-id + 1), id)

Section: Chart of Accounts

  add-account : GlState, GlAccount -> GlState
  add-account (st) (acct) =
    let st2 = __record-set st "gl-accounts" (list-push (st.gl-accounts) acct)
    in let row = row-new (table-schema gl-accounts-tdef) [ValText (acct.gl-number), ValText (acct.gl-name), ValText (account-type-name (acct.gl-type)), ValText (acct.gl-company)]
    in let st3 = __record-set st2 "gl-db" (db-insert (st2.gl-db) "gl_accounts" row)
    in let log2 = log-info-msg (st.gl-log) "gl" ("added account " & acct.gl-number & " " & acct.gl-name) 0
    in __record-set st3 "gl-log" log2

  find-account : GlState, Text -> Maybe GlAccount
  find-account (st) (number) = find-acct-loop (st.gl-accounts) number 0

  find-acct-loop : List GlAccount, Text, Integer -> Maybe GlAccount
  find-acct-loop (accts) (num) (i) =
    if i >= list-length accts then None
    else let a = list-at accts i
    in if a.gl-number == num then Just a
    else find-acct-loop accts num (i + 1)

  standard-coa : Text -> List GlAccount
  standard-coa (company) = [
    GlAccount { gl-number = "1000", gl-name = "Cash", gl-type = Asset, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = True, gl-active = True },
    GlAccount { gl-number = "1100", gl-name = "Accounts Receivable", gl-type = Asset, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = True, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "1200", gl-name = "Inventory", gl-type = Asset, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "1300", gl-name = "Prepaid Expenses", gl-type = Asset, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "1500", gl-name = "Fixed Assets", gl-type = Asset, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = True, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "1510", gl-name = "Accumulated Depreciation", gl-type = Asset, gl-parent = "1500", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "2000", gl-name = "Accounts Payable", gl-type = Liability, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = True, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "2100", gl-name = "Accrued Liabilities", gl-type = Liability, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "2200", gl-name = "Taxes Payable", gl-type = Liability, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "2300", gl-name = "Wages Payable", gl-type = Liability, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "3000", gl-name = "Common Stock", gl-type = Equity, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
    GlAccount { gl-number = "3100", gl-name = "Retained Earnings", gl-type = Equity, gl-parent = "", gl-company = company, gl-currency = "USD", gl-is-control = False, gl-is-bank = False, gl-active = True },
