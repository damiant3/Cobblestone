Section: Star Schema

  Dimension = record {
    dim-id : Text,
    dim-name : Text,
    dim-hierarchy : List DimLevel,
    dim-members : List DimMember
  }

  DimLevel = record {
    dl-name : Text,
    dl-sort-order : Integer
  }

  DimMember = record {
    dm-key : Text,
    dm-label : Text,
    dm-parent : Text,
    dm-level : Text,
    dm-attributes : List DimAttr
  }

  DimAttr = record {
    da-name : Text,
    da-value : Text
  }

  FactTable = record {
    ft-name : Text,
    ft-dimensions : List Text,
    ft-measures : List MeasureDef,
    ft-rows : List FactRow
  }

  MeasureDef = record {
    md-name : Text,
    md-type : MeasureType,
    md-format : Text
  }

  MeasureType =
    | MsSum
    | MsCount
    | MsAvg
    | MsMin
    | MsMax

  FactRow = record {
    fr-dim-keys : List Text,
    fr-measures : List Integer
  }

