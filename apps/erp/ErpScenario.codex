Section: Journal Helpers

  scn-je : Text, Integer, List JournalLine, JournalSource -> JournalEntry
  scn-je (id) (date) (lines) (source) =
    JournalEntry {
      je-id = id, je-company = "CODEX", je-date = date,
      je-period = 6, je-year = 2026, je-description = id,
      je-lines = lines, je-source = source, je-posted = False,
      je-reversed = False, je-reversal-of = "", je-created-by = "scenario",
      je-approved-by = "", je-created = 0
    }

  scn-post : GlState, JournalEntry -> GlState
  scn-post (st) (je) =
    when post-journal st je
      is (st2, r) -> st2

Section: The Month

 Each step threads the ledger forward. The result record carries the
 final state plus everything the report needs to tie subledgers to
 control accounts.

  ScenarioResult = record {
    scn-state : GlState,
    scn-match-ok : Boolean,
    scn-ap-open : Integer,
    scn-ar-open : Integer,
    scn-close-rejected : Boolean
  }

  run-month : ScenarioResult
  run-month =
    let st0 = gl-init scn-company
    in let st1 = load-standard-coa st0
    in let st2 = __record-set st1 "gl-periods" [FiscalPeriod { fp-year = 2026, fp-period = 6, fp-company = "CODEX", fp-start-date = 20260601, fp-end-date = 20260630, fp-status = PeriodOpen }]
    in let cfg = standard-config 6 2026
    in let st3 = scn-post st2 (scn-je "CAPITAL" 20260601 [journal-line-debit "1000" 5000000 "" "seed capital", journal-line-credit "3000" 5000000 "" "common stock"] SrcManual)
    in let st4 = scn-post st3 (gr-gl-entries scn-gr scn-po cfg)
    in let (st5, ap-inv) = create-ap-invoice st4 cfg scn-vendor "RMI-100" 20260612 scn-ap-lines 0
    in let match-ok = all-matched (three-way-match scn-po scn-gr ap-inv)
    in run-month-rest st5 cfg ap-inv match-ok

 The month continues in run-month-rest; splitting the function keeps
 the let chain shallow enough to read.

  run-month-rest : GlState, ErpConfig, ApInvoice, Boolean -> ScenarioResult
  run-month-rest (st5) (cfg) (ap-inv) (match-ok) =
    let (st6, apr) = ap-post-invoice st5 cfg ap-inv
    in let (st7, app) = ap-payment st6 cfg ap-inv 0 20260625
    in let st8 = scn-post st7 (payroll-journal scn-payroll cfg)
    in let st9 = scn-post st8 (scn-je "ABSORB" 20260618 [journal-line-debit "1200" 60000 "CC-PROD" "labor absorbed into WIP", journal-line-credit "6000" 60000 "CC-PROD" "labor applied"] SrcInventory)
    in let st10 = scn-post st9 (delivery-gl scn-delivery scn-materials cfg)
    in let (st11, ar-inv) = create-ar-invoice st10 cfg scn-customer "BILL-1" 20260620 scn-ar-lines 0
    in let (st12, arr) = ar-post-invoice st11 cfg ar-inv
    in let (st13, arc) = ar-cash-receipt st12 cfg ar-inv (ar-inv.ari-amount + ar-inv.ari-tax-amount) 20260628
    in let st14 = scn-post st13 (allocation-je scn-alloc "CODEX" cfg)
    in let st15 = scn-post st14 (scn-je "ASSET" 20260605 [journal-line-debit "1500" 480000 "" "CNC machine", journal-line-credit "1000" 480000 "" "cash purchase"] SrcAsset)
    in let depr = monthly-depreciation scn-machine 1
    in let st16 = scn-post st15 (scn-je "DEPR" 20260630 [journal-line-debit "6400" depr "" "monthly depreciation", journal-line-credit "1510" depr "" "accumulated depreciation"] SrcClosing)
    in let st17 = __record-set st16 "gl-periods" [FiscalPeriod { fp-year = 2026, fp-period = 6, fp-company = "CODEX", fp-start-date = 20260601, fp-end-date = 20260630, fp-status = PeriodClosed }]
    in let late = post-journal st17 (scn-je "LATE" 20260630 [journal-line-debit "1000" 1 "" "late", journal-line-credit "4000" 1 "" "late"] SrcManual)
    in when late
      is (st18, late-r) ->
        let rejected = when late-r is PostFailed (m) -> True is otherwise -> False
        in ScenarioResult {
          scn-state = st18,
          scn-match-ok = match-ok,
          scn-ap-open = get-balance st18 "2000",
          scn-ar-open = get-balance st18 "1100",
          scn-close-rejected = rejected
        }

Section: Report

  bool-text : Boolean -> Text
  bool-text (b) = if b then "True" else "False"

  tb-line-text : TrialBalanceLine -> Text
  tb-line-text (l) =
    "  " & l.tb-account & " " & l.tb-name & "  D=" & show (l.tb-debit) & " C=" & show (l.tb-credit)

  tb-lines-text : List TrialBalanceLine, Integer, List Text -> List Text
  tb-lines-text (lines) (i) (acc) =
    if i >= list-length lines then acc
    else tb-lines-text lines (i + 1) (list-push acc (tb-line-text (list-at lines i)))

  scenario-report : List Text
  scenario-report =
    let result = run-month
    in let st = result.scn-state
    in let tb = trial-balance st
    in let d = tb-total-debits tb
    in let c = tb-total-credits tb
    in let rev = total-revenue st
    in let exp = total-expenses st
    in let ni = net-income st
    in let assets = total-assets st
    in let liab = total-liabilities st
    in let equity = total-equity st
    in let eq-holds = assets == liab + equity + ni
    in let head = [
      "CODEX -- one month, period 6/2026",
      "three-way-match: " & bool-text (result.scn-match-ok),
      "ap-control-after-payment: " & show (result.scn-ap-open),
      "ar-control-after-receipt: " & show (result.scn-ar-open),
      "close-rejects-posting: " & bool-text (result.scn-close-rejected),
      "TRIAL BALANCE  debits=" & show d & " credits=" & show c & " balanced=" & bool-text (d == c)
    ]
    in let body = tb-lines-text tb 0 head
    in let pl1 = "P&L  revenue=" & show rev & " expenses=" & show exp & " net-income=" & show ni
    in let bs1 = "BALANCE SHEET  assets=" & show assets & " liabilities=" & show liab & " equity=" & show equity
    in let eq1 = "EQUATION  assets == liabilities + equity + net-income: " & bool-text eq-holds
    in list-push (list-push (list-push body pl1) bs1) eq1
