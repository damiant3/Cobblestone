Chapter: ErpSnapshotMain
  cites ERP chapter ErpTypes
  cites ERP chapter FinGL
  cites ERP chapter ErpScenario
  cites Foreword chapter Console

Section: Report

  snap-kv : Text, Integer -> Text
  snap-kv (k) (v) = k & "=" & show v & "\n"

  snap-tb-text : List TrialBalanceLine, Integer, Text -> Text
  snap-tb-text (tb) (i) (acc) =
    if i >= list-length tb then acc
    else let l = list-at tb i
    in snap-tb-text tb (i + 1) (acc & "tb|" & l.tb-account & "|" & l.tb-name & "|" & show (l.tb-debit) & "|" & show (l.tb-credit) & "\n")

  snap-report : Integer -> Text
  snap-report (x) =
    let r = run-month
    in let gl = r.scn-state
    in let head = snap-kv "revenue" (total-revenue gl) & snap-kv "expenses" (total-expenses gl) & snap-kv "net" (net-income gl) & snap-kv "cash" (get-balance gl "1000")
    in let body = snap-kv "assets" (total-assets gl) & snap-kv "liabilities" (total-liabilities gl) & snap-kv "equity" (total-equity gl) & snap-kv "ap-open" (r.scn-ap-open) & snap-kv "ar-open" (r.scn-ar-open)
    in head & body & snap-tb-text (trial-balance gl) 0 "" & "end=1"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (snap-report 0)
  end
