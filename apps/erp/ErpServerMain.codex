Chapter: ErpServerMain
  cites ERP chapter ErpServer
  cites Foreword chapter Console

 The bootable entry point for the ERP server. It lives in its own chapter,
 apart from the ErpServer library, so a program can cite ErpServer for its
 route logic (as erp-server-test does) without inheriting a second `opening`.

Section: Entry Point

  opening : [Console, Network.Read, Network.Write] Nothing = act
    print-line-uni "Codex ERP server starting on port 9200..."
    print-line-uni "Routes:"
    print-line-uni "  GET  /health              - Health check"
    print-line-uni "  GET  /api/gl/accounts     - Chart of accounts"
    print-line-uni "  GET  /api/gl/trial-balance - Trial balance"
    print-line-uni "  POST /api/gl/journal      - Post journal entry"
    print-line-uni "  GET  /api/ap/aging        - AP aging buckets"
    print-line-uni "  GET  /api/ar/aging        - AR aging buckets"
    print-line-uni "  GET  /api/kpi/dashboard   - KPI dashboard"
    let st = erp-state-new 6 2026
    in let st2 = erp-init-with-seed st
    in act
      print-line-uni ("Initialized: " & show (list-length (st2.erp-gl).gl-accounts) & " accounts, " & show (list-length (st2.erp-ap)) & " AP invoices, " & show (list-length (st2.erp-ar)) & " AR invoices")
      served <- erp-server st2
      print-line-uni ("ERP server closed after " & show served & " requests")
    end
  end
