    | ApApproved
    | ApScheduled
    | ApPaid
    | ApDisputed
    | ApVoided

  ap-status-name : ApStatus -> Text
  ap-status-name (s) =
    when s
      is ApPending -> "pending"
      is ApApproved -> "approved"
      is ApScheduled -> "scheduled"
      is ApPaid -> "paid"
      is ApDisputed -> "disputed"
      is ApVoided -> "voided"

