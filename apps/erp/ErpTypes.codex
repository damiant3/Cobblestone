Section: Fixed Assets

  AssetClass =
    | Buildings
    | Machinery
    | Vehicles
    | Furniture
    | IT_Equipment
    | Intangible
    | LandAsset

  DepreciationMethod =
    | StraightLine
    | DecliningBalance (Integer)
    | SumOfYears
    | UnitsOfProduction

  FixedAsset = record {
    fa-id : Text,
    fa-name : Text,
    fa-company : Text,
    fa-class : AssetClass,
    fa-cost : Integer,
    fa-salvage-value : Integer,
    fa-useful-life-months : Integer,
    fa-depreciation-method : DepreciationMethod,
    fa-accumulated-depr : Integer,
    fa-acquisition-date : Integer,
    fa-in-service-date : Integer,
    fa-disposal-date : Integer,
    fa-gl-asset-account : Text,
    fa-gl-depr-account : Text,
    fa-gl-accum-account : Text,
    fa-cost-center : Text,
    fa-location : Text,
    fa-serial-number : Text,
    fa-status : AssetStatus
  }

  AssetStatus =
    | AssetActive
    | AssetDisposed
    | AssetFullyDepreciated
    | AssetTransferred

  net-book-value : FixedAsset -> Integer
  net-book-value (fa) = fa.fa-cost - fa.fa-accumulated-depr

  monthly-depreciation : FixedAsset, Integer -> Integer
  monthly-depreciation (fa) (month) =
    when fa.fa-depreciation-method
      is StraightLine ->
        if fa.fa-useful-life-months == 0 then 0
        else (fa.fa-cost - fa.fa-salvage-value) / fa.fa-useful-life-months
      is DecliningBalance (rate-pct) ->
        net-book-value fa * rate-pct / 1200
      is SumOfYears ->
        sum-of-months-depreciation fa month
      is UnitsOfProduction -> 0

 The month parameter is the one-based month in service. StraightLine
 and DecliningBalance ignore the month: the first is constant and the
 second reads the asset's accumulated state. UnitsOfProduction is not
 a time-based method, therefore the monthly figure is zero by
 definition; use units-depreciation with the period's actual units.
 Sum-of-years applied to a life of M months: month m bears the
 fraction (M - m + 1) over M(M+1)/2 of the depreciable base, with
 truncating division. The final month absorbs the rounding remainder
 when a schedule is summed.

  sum-of-months-depreciation : FixedAsset, Integer -> Integer
  sum-of-months-depreciation (fa) (month) =
    let m = fa.fa-useful-life-months
    in if m == 0 then 0
    else if month < 1 then 0
    else if month > m then 0
    else let depreciable = fa.fa-cost - fa.fa-salvage-value
    in let denom = m * (m + 1) / 2
    in depreciable * (m - month + 1) / denom

  units-depreciation : FixedAsset, Integer, Integer -> Integer
  units-depreciation (fa) (units) (total-units) =
    if total-units == 0 then 0
    else (fa.fa-cost - fa.fa-salvage-value) * units / total-units

Section: Bank Reconciliation

  BankStatement = record {
    bs-id : Text,
    bs-bank-account : Text,
    bs-company : Text,
    bs-period : Integer,
    bs-opening-balance : Integer,
    bs-closing-balance : Integer,
    bs-transactions : List BankTransaction
  }

  BankTransaction = record {
    bt-ref : Text,
    bt-date : Integer,
    bt-description : Text,
    bt-amount : Integer,
    bt-matched : Boolean,
    bt-matched-je : Text
  }

Section: Payment Terms

  PaymentTerms = record {
    pt-code : Text,
    pt-name : Text,
    pt-net-days : Integer,
    pt-discount-days : Integer,
    pt-discount-pct : Integer
  }

  net-30 : PaymentTerms
  net-30 = PaymentTerms { pt-code = "NET30", pt-name = "Net 30", pt-net-days = 30, pt-discount-days = 0, pt-discount-pct = 0 }

  two-ten-net-30 : PaymentTerms
  two-ten-net-30 = PaymentTerms { pt-code = "2/10N30", pt-name = "2/10 Net 30", pt-net-days = 30, pt-discount-days = 10, pt-discount-pct = 200 }

  net-60 : PaymentTerms
  net-60 = PaymentTerms { pt-code = "NET60", pt-name = "Net 60", pt-net-days = 60, pt-discount-days = 0, pt-discount-pct = 0 }

Section: Tax Configuration

  TaxCode = record {
    tc-code : Text,
    tc-name : Text,
    tc-rate-bps : Integer,
    tc-gl-account : Text,
    tc-recoverable : Boolean
  }

Section: Currency and Exchange Rates

  ExchangeRate = record {
    xr-from : Text,
    xr-to : Text,
    xr-rate-x10000 : Integer,
    xr-date : Integer
  }

  convert-currency : Integer, ExchangeRate -> Integer
  convert-currency (amount) (rate) =
    (amount * rate.xr-rate-x10000 + 5000) / 10000
