Chapter: ErpTypes
  cites Foreword chapter Maybe
  cites Foreword chapter List

 Foundation types for the ERP suite. All monetary amounts are integers
 in the smallest currency unit. All dates are integers (YYYYMMDD for
 periods, unix seconds for timestamps). Every entity has a company
 code for multi-company isolation.

 Scaling conventions, binding for the whole suite: money is integer
 cents. Rates are basis points where 10000 equals 100 percent.
 Ratios and indices use x100 where 100 equals 1.00 (CPI, SPI,
 utilization, percent-complete). Fractional quantities use x1000
 (bill-of-material component quantities). Exchange rates use x10000.
 A field name carries its scale as a suffix whenever the value is not
 plain cents: rate-bps, spi-x100, quantity-x1000, rate-x10000.
 Division by a scale constant rounds half up by adding half the
 divisor first; bare truncating division on a scaled value is a bug.

Section: Company and Organization

  Company = record {
    co-code : Text,
    co-name : Text,
    co-currency : Text,
    co-country : Text,
    co-fiscal-year-start : Integer,
    co-active : Boolean
  }

  CostCenter = record {
    cc-code : Text,
    cc-name : Text,
    cc-company : Text,
    cc-manager : Text,
    cc-parent : Text,
    cc-active : Boolean
  }

  Department = record {
    dept-code : Text,
    dept-name : Text,
    dept-company : Text,
    dept-cost-center : Text,
    dept-head : Text
  }

  Plant = record {
    plant-code : Text,
    plant-name : Text,
    plant-company : Text,
    plant-address : Text,
    plant-country : Text
  }

  Warehouse = record {
    wh-code : Text,
    wh-name : Text,
    wh-plant : Text,
    wh-type : WarehouseType,
    wh-capacity : Integer
  }

  WarehouseType =
    | WhRaw
    | WhFinished
    | WhWip
    | WhTransit
    | WhReturns

Section: Chart of Accounts

  AccountType =
    | Asset
    | Liability
    | Equity
    | Revenue
    | Expense

  account-type-name : AccountType -> Text
  account-type-name (t) =
    when t
      is Asset -> "Asset"
      is Liability -> "Liability"
      is Equity -> "Equity"
      is Revenue -> "Revenue"
      is Expense -> "Expense"

  account-normal-balance : AccountType -> Text
  account-normal-balance (t) =
    when t
      is Asset -> "debit"
      is Expense -> "debit"
      is Liability -> "credit"
      is Equity -> "credit"
      is Revenue -> "credit"

  GlAccount = record {
    gl-number : Text,
    gl-name : Text,
    gl-type : AccountType,
    gl-parent : Text,
    gl-company : Text,
    gl-currency : Text,
    gl-is-control : Boolean,
    gl-is-bank : Boolean,
    gl-active : Boolean
  }

Section: Fiscal Periods

  FiscalPeriod = record {
    fp-year : Integer,
    fp-period : Integer,
    fp-company : Text,
    fp-start-date : Integer,
    fp-end-date : Integer,
    fp-status : PeriodStatus
  }

  PeriodStatus =
    | PeriodOpen
    | PeriodSoftClose
    | PeriodClosed

  period-status-name : PeriodStatus -> Text
  period-status-name (s) =
    when s
      is PeriodOpen -> "open"
      is PeriodSoftClose -> "soft-close"
      is PeriodClosed -> "closed"

Section: Journal Entries (Double-Entry Core)

  JournalEntry = record {
    je-id : Text,
    je-company : Text,
    je-date : Integer,
    je-period : Integer,
    je-year : Integer,
    je-description : Text,
    je-lines : List JournalLine,
    je-source : JournalSource,
    je-posted : Boolean,
    je-reversed : Boolean,
    je-reversal-of : Text,
    je-created-by : Text,
    je-approved-by : Text,
    je-created : Integer
  }

  JournalLine = record {
    jl-account : Text,
    jl-debit : Integer,
    jl-credit : Integer,
    jl-cost-center : Text,
    jl-description : Text,
    jl-currency : Text,
    jl-fx-amount : Integer,
    jl-fx-rate : Integer
  }

  journal-line-debit : Text, Integer, Text, Text -> JournalLine
  journal-line-debit (acct) (amt) (cc) (desc) = JournalLine {
    jl-account = acct, jl-debit = amt, jl-credit = 0,
    jl-cost-center = cc, jl-description = desc,
    jl-currency = "", jl-fx-amount = 0, jl-fx-rate = 0
  }

  journal-line-credit : Text, Integer, Text, Text -> JournalLine
  journal-line-credit (acct) (amt) (cc) (desc) = JournalLine {
    jl-account = acct, jl-debit = 0, jl-credit = amt,
    jl-cost-center = cc, jl-description = desc,
    jl-currency = "", jl-fx-amount = 0, jl-fx-rate = 0
  }

  JournalSource =
    | SrcManual
    | SrcAP
    | SrcAR
    | SrcPayroll
    | SrcInventory
    | SrcAsset
    | SrcBank
    | SrcAllocation
    | SrcClosing

  je-is-balanced : JournalEntry -> Boolean
  je-is-balanced (je) =
    let totals = sum-je-lines (je.je-lines) 0 0
    in totals.total-debits == totals.total-credits

  JeTotals = record { total-debits : Integer, total-credits : Integer }

  sum-je-lines : List JournalLine, Integer, Integer -> JeTotals
  sum-je-lines (lines) (d) (c) =
    if list-length lines == 0 then JeTotals { total-debits = d, total-credits = c }
    else let l = list-at lines 0
    in sum-je-lines (list-tail lines) (d + l.jl-debit) (c + l.jl-credit)

