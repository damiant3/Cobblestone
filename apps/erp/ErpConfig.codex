Section: Account Map

  AccountMap = record {
    am-cash : Text,
    am-ar-control : Text,
    am-inventory : Text,
    am-input-tax : Text,
    am-ap-control : Text,
    am-gr-ir : Text,
    am-tax-payable : Text,
    am-wages-payable : Text,
    am-accrued : Text,
    am-common-stock : Text,
    am-retained-earnings : Text,
    am-revenue : Text,
    am-cogs : Text,
    am-salaries : Text,
    am-benefits : Text,
    am-allocation : Text
  }

  standard-account-map : AccountMap
  standard-account-map = AccountMap {
    am-cash = "1000",
    am-ar-control = "1100",
    am-inventory = "1200",
    am-input-tax = "1300",
    am-ap-control = "2000",
    am-gr-ir = "2100",
    am-tax-payable = "2200",
    am-wages-payable = "2300",
    am-accrued = "2100",
    am-common-stock = "3000",
    am-retained-earnings = "3100",
    am-revenue = "4000",
    am-cogs = "5000",
    am-salaries = "6000",
    am-benefits = "6100",
    am-allocation = "6900"
  }

Section: Configuration

 Rates are in basis points: 10000 = 100 percent. The posting period
 and year stamp every journal entry a subledger builds, replacing the
 former period 0 / year 0 placeholders.

  ErpConfig = record {
    cfg-accounts : AccountMap,
    cfg-tax-codes : List TaxCode,
    cfg-sales-tax-bps : Integer,
    cfg-period : Integer,
    cfg-year : Integer
  }

  standard-sales-tax : TaxCode
  standard-sales-tax = TaxCode { tc-code = "ST", tc-name = "Sales Tax", tc-rate-bps = 800, tc-gl-account = "2200", tc-recoverable = False }

  standard-config : Integer, Integer -> ErpConfig
  standard-config (period) (year) = ErpConfig {
    cfg-accounts = standard-account-map,
    cfg-tax-codes = [standard-sales-tax],
    cfg-sales-tax-bps = 800,
    cfg-period = period,
    cfg-year = year
  }
