    agt-active : Boolean
  }

  AgentType =
    | CaptiveAgent
    | IndependentAgent
    | Broker
    | GeneralAgent
    | ManagingGeneral

Section: Loss Ratios

  LossRatio = record {
    lr-line : Text,
    lr-earned-premium : Integer,
    lr-incurred-losses : Integer,
    lr-loss-ratio-pct : Integer,
    lr-expense-ratio-pct : Integer,
    lr-combined-ratio-pct : Integer,
    lr-period : Integer
  }

  calc-loss-ratio : Integer, Integer, Integer -> LossRatio
  calc-loss-ratio (earned) (losses) (expenses) =
    let lr = if earned == 0 then 0 else losses * 100 / earned
    in let er = if earned == 0 then 0 else expenses * 100 / earned
    in LossRatio {
      lr-line = "", lr-earned-premium = earned,
      lr-incurred-losses = losses, lr-loss-ratio-pct = lr,
      lr-expense-ratio-pct = er, lr-combined-ratio-pct = lr + er,
      lr-period = 0
    }

  is-profitable : LossRatio -> Boolean
  is-profitable (lr) = lr.lr-combined-ratio-pct < 100
