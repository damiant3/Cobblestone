  SalesSummary = record {
    ss-total-orders : Integer,
    ss-total-revenue : Integer,
    ss-total-cogs : Integer,
    ss-gross-margin : Integer,
    ss-avg-order-value : Integer,
    ss-return-rate-pct : Integer,
    ss-top-customers : List Text,
    ss-top-products : List Text
  }

  CustomerSummary = record {
    cs-customer-id : Text,
    cs-name : Text,
    cs-total-orders : Integer,
    cs-total-revenue : Integer,
    cs-total-returns : Integer,
    cs-avg-days-to-pay : Integer,
    cs-credit-used : Integer,
    cs-credit-limit : Integer
  }
