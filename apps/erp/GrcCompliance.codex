    ComplianceObligation { co2-id = "gdpr-dpia", co2-name = "GDPR Data Protection Impact Assessment", co2-regulation = "GDPR", co2-frequency = "annual", co2-due-date = 0, co2-owner = "DPO", co2-status = "pending", co2-last-completed = 0 },
    ComplianceObligation { co2-id = "aml-sar", co2-name = "AML Suspicious Activity Reporting", co2-regulation = "BSA/AML", co2-frequency = "ongoing", co2-due-date = 0, co2-owner = "Compliance Officer", co2-status = "active", co2-last-completed = 0 }
