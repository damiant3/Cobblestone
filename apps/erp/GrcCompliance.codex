 Governance, Risk, and Compliance: access controls, segregation of
 duties (SoD), risk assessment, audit management, policy management,
 incident tracking, and regulatory compliance calendars.

Section: Access Controls

  AccessRole = record {
    ar-id : Text,
    ar-name : Text,
    ar-module : Text,
    ar-permissions : List Permission
  }

  Permission = record {
    perm-object : Text,
    perm-action : PermAction,
    perm-scope : Text
  }

  PermAction =
    | PermCreate
    | PermRead
    | PermUpdate
    | PermDelete
    | PermApprove
    | PermPost
    | PermExecute

  UserAccess = record {
    ua-user-id : Text,
    ua-roles : List Text,
    ua-granted-by : Text,
    ua-granted-date : Integer,
    ua-review-date : Integer,
    ua-status : Text
  }

Section: Segregation of Duties

  SodRule = record {
    sod-id : Text,
    sod-name : Text,
    sod-risk-level : RiskLevel,
    sod-conflicting-roles : (Text, Text),
    sod-description : Text,
    sod-mitigation : Text
  }

  RiskLevel =
    | RiskCritical
    | RiskHigh
    | RiskMedium
    | RiskLow

  SodViolation = record {
    sv-user-id : Text,
    sv-rule-id : Text,
    sv-roles : List Text,
    sv-detected : Integer,
    sv-mitigated : Boolean,
    sv-mitigation-control : Text,
    sv-approved-by : Text
  }

  standard-sod-rules : List SodRule
  standard-sod-rules = [
    SodRule { sod-id = "sod-01", sod-name = "AP Create + AP Approve", sod-risk-level = RiskCritical, sod-conflicting-roles = ("ap-clerk", "ap-approver"), sod-description = "Same user should not create and approve AP invoices", sod-mitigation = "Management review of all approved invoices" },
    SodRule { sod-id = "sod-02", sod-name = "PO Create + GR Confirm", sod-risk-level = RiskHigh, sod-conflicting-roles = ("buyer", "warehouse-receiver"), sod-description = "Same user should not create purchase orders and confirm goods receipt", sod-mitigation = "Quarterly audit of PO/GR pairs" },
    SodRule { sod-id = "sod-03", sod-name = "User Admin + Financial Post", sod-risk-level = RiskCritical, sod-conflicting-roles = ("user-admin", "gl-poster"), sod-description = "Same user should not manage user access and post financial transactions", sod-mitigation = "Compensating control: dual approval for JE over threshold" },
    SodRule { sod-id = "sod-04", sod-name = "Vendor Master + AP Payment", sod-risk-level = RiskCritical, sod-conflicting-roles = ("vendor-master", "payment-run"), sod-description = "Same user should not maintain vendor bank details and run payment batches", sod-mitigation = "Bank detail changes require manager approval" },
    SodRule { sod-id = "sod-05", sod-name = "AR Invoice + Cash Receipt", sod-risk-level = RiskHigh, sod-conflicting-roles = ("ar-clerk", "cashier"), sod-description = "Same user should not create invoices and record cash receipts", sod-mitigation = "Daily reconciliation by supervisor" }
  ]

Section: Risk Assessment

  Risk = record {
    risk-id : Text,
    risk-name : Text,
    risk-category : RiskCategory,
    risk-likelihood : Integer,
    risk-impact : Integer,
    risk-score : Integer,
    risk-owner : Text,
    risk-mitigation : Text,
    risk-residual-score : Integer,
    risk-status : Text,
    risk-last-assessed : Integer
  }

  RiskCategory =
    | FinancialRisk
    | OperationalRisk
    | ComplianceRisk
    | StrategicRisk
    | ReputationalRisk
    | CyberRisk
    | ThirdPartyRisk

  calc-risk-score : Integer, Integer -> Integer
  calc-risk-score (likelihood) (impact) = likelihood * impact

  risk-rating : Integer -> Text
  risk-rating (score) =
    if score >= 20 then "critical"
    else if score >= 12 then "high"
    else if score >= 6 then "medium"
    else "low"

  RiskMatrix = record {
    rm-total-risks : Integer,
    rm-critical : Integer,
    rm-high : Integer,
    rm-medium : Integer,
    rm-low : Integer,
    rm-mitigated-pct : Integer
  }

Section: Audit Management

  Audit = record {
    aud-id : Text,
    aud-name : Text,
    aud-type : AuditType,
    aud-scope : Text,
    aud-auditor : Text,
    aud-planned-start : Integer,
    aud-planned-end : Integer,
    aud-actual-start : Integer,
    aud-actual-end : Integer,
    aud-status : AuditStatus,
    aud-findings : List AuditFinding,
    aud-opinion : Text
  }

  AuditType =
    | InternalAudit
    | ExternalAudit
    | RegulatoryExam
    | SoxAudit
    | ItAudit
    | ComplianceAudit

  AuditStatus =
    | AudPlanned
    | AudFieldwork
    | AudDraftReport
    | AudFinalReport
    | AudClosed

  AuditFinding = record {
    af-id : Text,
    af-title : Text,
    af-severity : RiskLevel,
    af-description : Text,
    af-recommendation : Text,
    af-management-response : Text,
    af-remediation-date : Integer,
    af-status : Text
  }

Section: Policy Management

  PolicyDoc = record {
    pd2-id : Text,
    pd2-title : Text,
    pd2-category : Text,
    pd2-version : Integer,
    pd2-effective : Integer,
    pd2-review-date : Integer,
    pd2-owner : Text,
    pd2-approver : Text,
    pd2-content : Text,
    pd2-status : Text
  }

  PolicyAttestation = record {
    pa2-policy-id : Text,
    pa2-user-id : Text,
    pa2-attested : Integer,
    pa2-acknowledged : Boolean
  }

Section: Incident Management

  Incident = record {
    inc-id : Text,
    inc-type : IncidentType,
    inc-severity : RiskLevel,
    inc-description : Text,
    inc-reporter : Text,
    inc-assigned-to : Text,
    inc-root-cause : Text,
    inc-corrective-action : Text,
    inc-status : Text,
    inc-reported : Integer,
    inc-resolved : Integer,
    inc-financial-impact : Integer
  }

  IncidentType =
    | DataBreach
    | FraudAttempt
    | PolicyViolation
    | RegulatoryViolation
    | OperationalIncident
    | ThirdPartyIncident
    | Whistleblower

Section: Compliance Calendar

  ComplianceObligation = record {
    co2-id : Text,
    co2-name : Text,
    co2-regulation : Text,
    co2-frequency : Text,
    co2-due-date : Integer,
    co2-owner : Text,
    co2-status : Text,
    co2-last-completed : Integer
  }

  common-obligations : List ComplianceObligation
  common-obligations = [
