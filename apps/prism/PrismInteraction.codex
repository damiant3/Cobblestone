Chapter: PrismInteraction

 Interaction module for Prism. Wires up data-action attributes to
 their handler functions and provides syntax highlighting triggers.

Section: Action Dispatch

  dispatch-action : Text -> Integer
  dispatch-action (action) =
    if action == "compile-file" then compile-file-action unit
    else 0

  compile-file-action : Unit -> Integer
  compile-file-action (u) =
    let btn = dom-query "[data-action=\"compile-file\"]"
    in if dom-not-null btn then
      let win = dom-window unit
      in let path = dom-dataset-get btn "current-path"
      in if text-length path > 0 then do-compile path
      else 0
    else 0

  do-compile : Text -> Integer
  do-compile (path) =
    let out = dom-get-by-id "plug-output"
    in if dom-not-null out then dom-set-html out ("Compiling " & path & "...")
    else 0

Section: Syntax Highlight

  highlight-source : Text -> Integer
  highlight-source (element-id) =
    let el = dom-get-by-id element-id
    in if dom-not-null el then 1
    else 0

Section: Setup

  setup-prism-events : Integer -> Integer
  setup-prism-events (unused) =
    let doc = dom-document unit
    in let actions = dom-query-all "[data-action]"
    in bind-action-listeners actions 0

  bind-action-listeners : List Integer, Integer -> Integer
  bind-action-listeners (elements) (i) =
    if i >= list-length elements then 0
    else let el = list-at elements i
    in let action = dom-dataset-get el "data-action"
    in let h = dom-on-click el (dispatch-action action)
    in bind-action-listeners elements (i + 1)

