 We say:

Section: Serving

  serve-work : WorkIndex, AgentIdentity, WorkRequestMsg -> WorkReplyMsg
  serve-work (ix) (me) (req) =
    when work-by-hash ix (req.hash)
      is None -> WorkReplyMsg { from = me, hash = req.hash, payload = "" }
      is Just (d) -> WorkReplyMsg { from = me, hash = req.hash, payload = (when source-def-to-text d is Just (t) -> t is None -> "") }

  reply-is-empty : WorkReplyMsg -> Boolean
  reply-is-empty (r) = text-length (r.payload) == 0

Section: Asking

  ask-work : AgentIdentity, Text -> WorkRequestMsg
  ask-work (me) (hash) = WorkRequestMsg { from = me, hash = hash }

Section: Taking An Answer

  accept-reply : WorkReplyMsg, Text -> Maybe SourceDefinition
  accept-reply (reply) (wanted) =
    if reply.hash /= wanted then None
    else if text-length (reply.payload) == 0 then None
    else accept-decoded (source-def-from-text (reply.payload)) wanted

  accept-decoded : Maybe SourceDefinition, Text -> Maybe SourceDefinition
  accept-decoded (m) (wanted) =
    when m
      is None -> None
      is Just (d) -> if fact-content-hash (d.sd-content) == wanted then Just d else None

