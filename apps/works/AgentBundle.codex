 We say:

Section: Verdict

  AgentBundleInfo = record {
    bi-name : Text,
    bi-version : Text,
    bi-model : Text,
    bi-model-bytes : Integer,
    bi-architecture : Text,
    bi-tensor-count : Integer,
    bi-first-tensor : Text
  }

  AgentBundleVerdict =
    | BundleOk (AgentBundleInfo)
    | BundleRefused (Text)

  bundle-verdict-label : AgentBundleVerdict -> Text
  bundle-verdict-label (v) = when v
    is BundleOk (info) -> "ok"
    is BundleRefused (why) -> "refused: " & why

Section: The ASCII Boundary

  ab-text-to-ascii : Text -> List Integer
  ab-text-to-ascii (s) = ab-tta-loop s 0 (text-length s) []

  ab-tta-loop : Text, Integer, Integer, List Integer -> List Integer
  ab-tta-loop (s) (i) (n) (acc) =
    if i >= n then acc
    else ab-tta-loop s (i + 1) n (list-push acc (to-unicode (char-code (char-at s i))))

  ab-ascii-to-text : List Integer, Integer, Integer, Text -> Text
  ab-ascii-to-text (bs) (i) (n) (acc) =
    if i >= n then acc
    else ab-ascii-to-text bs (i + 1) n (acc & cce-foreign-byte-text (list-at bs i))

Section: Manifest Scanning

  ab-next-line : List Integer, Integer -> Integer
  ab-next-line (data) (pos) =
    if pos >= list-length data then list-length data
    else if list-at data pos == 10 then pos + 1
    else ab-next-line data (pos + 1)

  ab-value-end : List Integer, Integer -> Integer
  ab-value-end (data) (pos) =
    if pos >= list-length data then pos
    else if list-at data pos == 10 then pos
    else ab-value-end data (pos + 1)

  ab-match-at : List Integer, List Integer, Integer, Integer -> Boolean
  ab-match-at (data) (key) (pos) (i) =
    if i >= list-length key then True
    else if pos + i >= list-length data then False
    else if list-at data (pos + i) /= list-at key i then False
    else ab-match-at data key pos (i + 1)

  ab-value-offset : List Integer, List Integer, Integer -> Integer
  ab-value-offset (data) (key) (pos) =
    if pos >= list-length data then -1
    else if ab-match-at data key pos 0 then ab-value-after data key pos
    else ab-value-offset data key (ab-next-line data pos)

  ab-value-after : List Integer, List Integer, Integer -> Integer
  ab-value-after (data) (key) (pos) =
    let after = pos + list-length key
    in if after >= list-length data then -1
    else if list-at data after == 32 then after + 1
    else ab-value-offset data key (ab-next-line data pos)

  ab-slice : List Integer, Integer, Integer, List Integer -> List Integer
  ab-slice (data) (i) (stop) (acc) =
    if i >= stop then acc
    else ab-slice data (i + 1) stop (list-push acc (list-at data i))

  ab-field-bytes : List Integer, Text -> List Integer
  ab-field-bytes (data) (key) =
    let off = ab-value-offset data (ab-text-to-ascii key) 0
    in if off < 0 then []
    else ab-slice data off (ab-value-end data off) []

  ab-field-text : List Integer, Text -> Text
  ab-field-text (data) (key) =
    let bs = ab-field-bytes data key
    in ab-ascii-to-text bs 0 (list-length bs) ""

Section: Numbers And Hex

  ab-decimal : List Integer, Integer, Integer, Integer -> Integer
  ab-decimal (bs) (i) (n) (acc) =
    if i >= n then acc
    else let d = list-at bs i
    in if d < 48 then acc
    else if d > 57 then acc
    else ab-decimal bs (i + 1) n (acc * 10 + (d - 48))

  ab-field-decimal : List Integer, Text -> Integer
  ab-field-decimal (data) (key) =
    let bs = ab-field-bytes data key
    in if list-length bs == 0 then -1
    else ab-decimal bs 0 (list-length bs) 0

  ab-hex-nibble : Integer -> Integer
  ab-hex-nibble (b) =
    if b >= 48 & b <= 57 then b - 48
    else if b >= 97 & b <= 102 then b - 87
    else if b >= 65 & b <= 70 then b - 55
    else -1

  ab-hex-bytes : List Integer, Integer, Integer, List Integer -> List Integer
  ab-hex-bytes (hex) (i) (n) (acc) =
    if i + 1 >= n then acc
    else let hi = ab-hex-nibble (list-at hex i)
    in if hi < 0 then acc
    else let lo = ab-hex-nibble (list-at hex (i + 1))
    in if lo < 0 then acc
    else ab-hex-bytes hex (i + 2) n (list-push acc (hi * 16 + lo))

  ab-field-hex : List Integer, Text -> List Integer
  ab-field-hex (data) (key) =
    let bs = ab-field-bytes data key
    in ab-hex-bytes bs 0 (list-length bs) []

Section: The Chain

  agent-manifest-name : Text = "AGENT.MAN"

  bundled-agent-verdict : [Device.Block] AgentBundleVerdict
  bundled-agent-verdict = act
    vol <- fat16-boot-volume
    man <- fat16-read-bytes vol agent-manifest-name
    when man
      is None -> BundleRefused ("manifest not found: " & agent-manifest-name)
      is Just (mb) -> ab-check-signature vol mb
  end

  ab-check-signature : Fat16Volume, List Integer -> [Device.Block] AgentBundleVerdict
  ab-check-signature (vol) (mb) =
    let sig-off = ab-value-offset mb (ab-text-to-ascii "sig") 0
    in if sig-off < 0 then BundleRefused "manifest carries no signature"
    else let signed-len = sig-off - 4
    in let sig = ab-field-hex mb "sig"
    in let pub = ab-field-hex mb "pubkey"
    in if list-length sig /= 64 then BundleRefused "signature is not 64 bytes"
    else if list-length pub /= 32 then BundleRefused "public key is not 32 bytes"
    else let msg = ab-slice mb 0 signed-len []
    in if ed25519-verify pub msg sig == False
      then BundleRefused "manifest signature does not verify"
      else ab-check-model vol mb

  ab-check-model : Fat16Volume, List Integer -> [Device.Block] AgentBundleVerdict
  ab-check-model (vol) (mb) =
    let model-name = ab-field-text mb "model"
    in let bps = vol.vol-bytes-per-sector
    in if text-length model-name == 0 then BundleRefused "manifest names no model"
    else if bps - (bps / 64) * 64 /= 0
      then BundleRefused ("sector size " & show bps & " is not a whole number of digest blocks")
    else act
      found <- fat16-resolve-path vol model-name
      when found
        is None -> BundleRefused ("model not found: " & model-name)
        is Just (entry) -> ab-check-size vol mb model-name entry
    end

  ab-check-size : Fat16Volume, List Integer, Text, Fat16DirEntry -> [Device.Block] AgentBundleVerdict
  ab-check-size (vol) (mb) (model-name) (entry) =
    let claimed-len = ab-field-decimal mb "model-bytes"
    in if claimed-len /= (entry.de-size)
      then BundleRefused ("model is " & show (entry.de-size) & " bytes, manifest claims " & show claimed-len)
    else act
      hash <- ab-model-digest vol (entry.de-cluster) (entry.de-size)
      ab-check-digest vol mb model-name entry hash
    end

  ab-check-digest : Fat16Volume, List Integer, Text, Fat16DirEntry, List Integer -> [Device.Block] AgentBundleVerdict
  ab-check-digest (vol) (mb) (model-name) (entry) (hash) =
    let claimed = ab-field-text mb "model-sha256"
    in let actual = sha256-to-hex hash
    in if claimed /= actual
      then BundleRefused "model digest does not match the signed manifest"
      else ab-parse-window vol mb model-name entry 0

Section: The Parse Window

  ab-window-sizes : List Integer = [1048576, 8388608, 67108864]

  ab-parse-window : Fat16Volume, List Integer, Text, Fat16DirEntry, Integer -> [Device.Block] AgentBundleVerdict
  ab-parse-window (vol) (mb) (model-name) (entry) (i) =
    let want = list-at ab-window-sizes i
    in let win = if want > (entry.de-size) then (entry.de-size) else want
    in let mark = __heap-save
    in act
      pre <- fat16-read-cluster-bytes vol (entry.de-cluster) win 0 [] (entry.de-cluster) 1 0
      ab-window-read vol mb model-name entry i mark pre
    end

  ab-window-read : Fat16Volume, List Integer, Text, Fat16DirEntry, Integer, Integer, Maybe (List Integer) -> [Device.Block] AgentBundleVerdict
  ab-window-read (vol) (mb) (model-name) (entry) (i) (mark) (read) =
    when read
      is None -> BundleRefused "model file's cluster chain ends, leaves the volume or cycles before its size"
      is Just (pre) -> ab-window-step vol mb model-name entry i mark pre

  ab-window-step : Fat16Volume, List Integer, Text, Fat16DirEntry, Integer, Integer, List Integer -> [Device.Block] AgentBundleVerdict
  ab-window-step (vol) (mb) (model-name) (entry) (i) (mark) (pre) =
    if gguf-tensor-info-offset pre >= 0 then ab-parse-model mb model-name (entry.de-size) pre
    else if list-length pre >= (entry.de-size) then ab-parse-model mb model-name (entry.de-size) pre
    else if i + 1 >= list-length ab-window-sizes
      then BundleRefused ("model metadata does not fit a " & show (list-length pre) & " byte parse window")
      else let dropped = __heap-restore mark
      in ab-parse-window vol mb model-name entry (i + 1)

  ab-parse-model : List Integer, Text, Integer, List Integer -> AgentBundleVerdict
  ab-parse-model (mb) (model-name) (model-size) (bs) =
    let h = gguf-parse-header bs
    in if h.gh-valid == False then BundleRefused "model is not a GGUF file"
    else let ti-off = gguf-tensor-info-offset bs
    in if ti-off < 0 then BundleRefused "model metadata block could not be walked"
    else if h.gh-tensor-count <= 0 then BundleRefused "model declares no tensors"
    else let first = gguf-parse-tensor-info bs ti-off
    in if first.gti-valid == False then BundleRefused "model tensor table could not be walked"
    else BundleOk (AgentBundleInfo {
      bi-name = ab-field-text mb "name",
      bi-version = ab-field-text mb "version",
      bi-model = model-name,
      bi-model-bytes = model-size,
      bi-architecture = gguf-metadata-text bs "general.architecture",
      bi-tensor-count = h.gh-tensor-count,
      bi-first-tensor = first.gti-name
    })

Section: Streaming The Digest

  ab-model-digest : Fat16Volume, Integer, Integer -> [Device.Block] List Integer
  ab-model-digest (vol) (cluster) (size) =
    if size <= 0 then sha256 []
    else let hash = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
    in let mark = __heap-save
    in ab-hash-chain vol cluster size 0 size hash mark

  ab-hash-chain : Fat16Volume, Integer, Integer, Integer, Integer, List Integer, Integer -> [Device.Block] List Integer
  ab-hash-chain (vol) (cluster) (remaining) (sector-off) (total) (hash) (mark) =
    let dropped = __heap-restore mark
    in if remaining <= 0 then hash
    else if fat16-is-end cluster then hash
    else act
      buf <- block-read-sector (fat16-cluster-sector vol cluster + sector-off)
      ab-hash-sector vol cluster remaining sector-off total hash mark buf
    end

  ab-hash-sector : Fat16Volume, Integer, Integer, Integer, Integer, List Integer, Integer, Integer -> [Device.Block] List Integer
  ab-hash-sector (vol) (cluster) (remaining) (sector-off) (total) (hash) (mark) (buf) =
    let bps = vol.vol-bytes-per-sector
    in if remaining <= bps then ab-hash-tail buf remaining total hash
    else let carried = ab-hash-blocks buf 0 bps hash
    in let next-off = sector-off + 1
    in if next-off >= (vol.vol-sectors-per-cluster)
      then ab-hash-chain vol (fat16-next-cluster vol cluster) (remaining - bps) 0 total carried mark
      else ab-hash-chain vol cluster (remaining - bps) next-off total carried mark

  ab-hash-blocks : Integer, Integer, Integer, List Integer -> List Integer
  ab-hash-blocks (buf) (off) (n) (hash) =
    if n < 64 then hash
    else let mark = __heap-save
    in let words = sha256-buf-block-words buf off
    in let carried = sha256-compress hash words
    in let dropped = __heap-restore mark
    in ab-hash-blocks buf (off + 64) (n - 64) carried

  ab-hash-tail : Integer, Integer, Integer, List Integer -> List Integer
  ab-hash-tail (buf) (n) (total) (hash) =
    let full = (n / 64) * 64
    in let carried = ab-hash-blocks buf 0 full hash
    in let tail = sha256-buf-tail-bytes buf full (n - full) []
    in let stopped = list-push tail 128
    in let slack = 55 - (total - (total / 64) * 64)
    in let zeros = if slack < 0 then slack + 64 else slack
    in let padded = append-length-be (append-zeros stopped zeros) (total * 8)
    in sha256-buf-final-blocks padded carried 0 (list-length padded)

Section: Reporting

  format-bundle-info : AgentBundleInfo -> Text
  format-bundle-info (i) =
    i.bi-name & " v" & i.bi-version
    & "\n  model: " & i.bi-model & " (" & show (i.bi-model-bytes) & " bytes)"
    & "\n  architecture: " & i.bi-architecture
    & "\n  tensors: " & show (i.bi-tensor-count) & " first=" & i.bi-first-tensor

  format-bundle-verdict : AgentBundleVerdict -> Text
  format-bundle-verdict (v) = when v
    is BundleOk (info) -> "BUNDLE OK\n" & format-bundle-info info
    is BundleRefused (why) -> "BUNDLE REFUSED: " & why
