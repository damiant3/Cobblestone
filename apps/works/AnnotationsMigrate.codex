Chapter: AnnotationsMigrate
  cites Works chapter Annotation
  cites Foreword chapter Maybe

 We say:

Section: Schema Version

  current-schema-version : Integer = 1

  AnnotationFile = record {
    schema-version : Integer,
    annotations : List Annotation
  }

  needs-migration : Integer -> Boolean
  needs-migration (file-version) = file-version < current-schema-version

  is-future-version : Integer -> Boolean
  is-future-version (file-version) = file-version > current-schema-version

  is-current-version : Integer -> Boolean
  is-current-version (file-version) = file-version == current-schema-version

Section: Migration Status

  MigrationStatus =
    | MigrationOk
    | MigrationFutureVersion
    | MigrationUnknownPath

  migration-status-label : MigrationStatus -> Text
  migration-status-label (s) = when s
    is MigrationOk -> "ok"
    is MigrationFutureVersion -> "future-version"
    is MigrationUnknownPath -> "unknown-path"

  MigrationResult = record {
    status : MigrationStatus,
    file : AnnotationFile,
    from-version : Integer,
    to-version : Integer
  }

Section: Migration Driver

  migrate-forward : AnnotationFile -> MigrationResult
  migrate-forward (file) =
    if is-future-version (file.schema-version) then
      MigrationResult {
        status = MigrationFutureVersion,
        file = file,
        from-version = file.schema-version,
        to-version = current-schema-version
      }
    else if is-current-version (file.schema-version) then
      MigrationResult {
        status = MigrationOk,
        file = file,
        from-version = file.schema-version,
        to-version = current-schema-version
      }
    else MigrationResult {
      status = MigrationUnknownPath,
      file = file,
      from-version = file.schema-version,
      to-version = current-schema-version
    }

Section: File Construction

  make-annotation-file : Integer, List Annotation -> AnnotationFile
  make-annotation-file (version) (anns) =
    AnnotationFile { schema-version = version, annotations = anns }

  current-annotation-file : List Annotation -> AnnotationFile
  current-annotation-file (anns) =
    make-annotation-file current-schema-version anns

