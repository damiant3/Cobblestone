  cites Works chapter GopWorld

 We say:

Section: Registers

  clk-reg-seconds : Integer = 0
  clk-reg-minutes : Integer = 2
  clk-reg-hours : Integer = 4
  clk-reg-day : Integer = 7
  clk-reg-month : Integer = 8
  clk-reg-year : Integer = 9

  clk-set-bit : Integer = 128
  clk-h24-bit : Integer = 2
  clk-pm-bit : Integer = 128

Section: State

  clk-field-cell : Integer = 0
  clk-editing-cell : Integer = 4
  clk-zone-cell : Integer = 8
  clk-h-cell : Integer = 12
  clk-mi-cell : Integer = 16
  clk-s-cell : Integer = 20
  clk-d-cell : Integer = 24
  clk-mo-cell : Integer = 28
  clk-y-cell : Integer = 32
  clk-ready-cell : Integer = 36

  clk-zone-bias : Integer = zone-bias
  clk-fields : Integer = 7

  clk-view-cell : Integer = 64
  clk-zid-cell : Integer = 68
  clk-cfmt-cell : Integer = 72
  clk-dfmt-cell : Integer = 76
  clk-stripe-cell : Integer = 80
  clk-world-cell : Integer = 84
  clk-pick-cell : Integer = 88
  clk-loaded-cell : Integer = 92

  clk-band-cell : Integer = 96

  clk-band : Integer -> Integer
  clk-band (ks) =
    let v = peek-32 ks clk-band-cell
    in if v == 0 then zone-band-default else bit-and (v - 1) zone-band-all

  clk-set-band : Integer, Integer -> Integer
  clk-set-band (ks) (m) = poke-32 ks clk-band-cell (bit-and m zone-band-all + 1)

  clk-band-has : Integer, Integer -> Boolean
  clk-band-has (ks) (bit) = bit-and (clk-band ks) bit /= 0

  clk-band-toggle : Integer, Integer -> Integer
  clk-band-toggle (ks) (bit) =
    let m = clk-band ks
    in clk-set-band ks (if bit-and m bit /= 0 then m - bit else m + bit)

  clk-view-face : Integer = 0
  clk-view-zones : Integer = 1
  clk-view-formats : Integer = 2

  clk-view : Integer -> Integer
  clk-view (ks) = peek-32 ks clk-view-cell

  clk-set-view : Integer, Integer -> Integer
  clk-set-view (ks) (v) = poke-32 ks clk-view-cell v

  clk-zid : Integer -> Integer
  clk-zid (ks) = peek-32 ks clk-zid-cell

  clk-cfmt : Integer -> Integer
  clk-cfmt (ks) = peek-32 ks clk-cfmt-cell

  clk-dfmt : Integer -> Integer
  clk-dfmt (ks) = peek-32 ks clk-dfmt-cell

  clk-stripe : Integer -> Integer
  clk-stripe (ks) = peek-32 ks clk-stripe-cell - 12

  clk-set-stripe : Integer, Integer -> Integer
  clk-set-stripe (ks) (s) =
    let c = if s < zone-stripe-min then zone-stripe-min else if s > 11 then 11 else s
    in let a = poke-32 ks clk-stripe-cell (c + 12)
    in poke-32 ks clk-pick-cell 0

  clk-pick : Integer -> Integer
  clk-pick (ks) = peek-32 ks clk-pick-cell

  clk-world : Integer -> Integer
  clk-world (ks) = peek-32 ks clk-world-cell

  clk-stripe-list : Integer -> List Integer
  clk-stripe-list (ks) = zone-stripe-ids (clk-stripe ks)

  clk-picked : Integer -> Integer
  clk-picked (ks) =
    let ids = clk-stripe-list ks
    in let n = list-length ids
    in if n == 0 then 0
    else list-at ids (if clk-pick ks >= n then n - 1 else clk-pick ks)

  clk-field : Integer -> Integer
  clk-field (ks) = peek-32 ks clk-field-cell

  clk-editing : Integer -> Boolean
  clk-editing (ks) = peek-32 ks clk-editing-cell == 1

  clk-zone : Integer -> Integer
  clk-zone (ks) = peek-32 ks clk-zone-cell - clk-zone-bias

  clk-set-zone : Integer, Integer -> Integer
  clk-set-zone (ks) (z) = poke-32 ks clk-zone-cell (zone-clamp z + clk-zone-bias)

  clk-ensure : Integer -> [Device.Port] Integer
  clk-ensure (ks) = act
    if peek-32 ks clk-ready-cell == 1 then 0
    else act
      z <- zone-load
      let r = poke-32 ks clk-ready-cell 1
      in clk-set-zone ks z
    end
  end

  clk-ensure2 : Integer -> [Device.Port] Integer
  clk-ensure2 (ks) = act
    if peek-32 ks clk-loaded-cell == 1 then 0
    else act
      r <- zone2-load
      let a = poke-32 ks clk-loaded-cell 1
      in let id = if zone-valid (r.zc-id) then r.zc-id else 0
      in let b = poke-32 ks clk-zid-cell id
      in let c = poke-32 ks clk-cfmt-cell (if r.zc-clock == loc-clock-12 then loc-clock-12 else loc-clock-24)
      in let d = poke-32 ks clk-dfmt-cell (if r.zc-date > loc-date-ymd then loc-date-dmy else r.zc-date)
      in let e = poke-32 ks clk-world-cell wld-build
      in let f = clk-set-stripe ks (if id == 0 then 0 else (zone-row-of id).zr-stripe)
      in let g = clk-set-zone ks (r.zc-minutes / 60)
      in let bnd = clk-set-band ks (r.zc-band)
      in poke-32 ks clk-ready-cell 1
    end
  end

  clk-note-now : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  clk-note-now (ks) (h) (mi) (s) (d) (mo) (y) =
    let a = poke-32 ks clk-h-cell h
    in let b = poke-32 ks clk-mi-cell mi
    in let c = poke-32 ks clk-s-cell s
    in let e = poke-32 ks clk-d-cell d
    in let f = poke-32 ks clk-mo-cell mo
    in poke-32 ks clk-y-cell y

  clk-record : Integer, Integer, Integer, Integer, Integer -> ZoneRec
  clk-record (ks) (y) (m) (d) (hh) =
    let id = clk-zid ks
    in ZoneRec {
      zc-minutes = if zone-valid id then zone-offset-on id y m d hh else clk-zone ks * 60,
      zc-id = id,
      zc-clock = clk-cfmt ks,
      zc-date = clk-dfmt ks,
      zc-band = clk-band ks
    }

Section: Reading

  clk-mode : Integer -> [Device.Port] Integer
  clk-mode (d) = act
    b <- rtc-read rtc-reg-status-b
    b
  end

  clk-field-value : Integer, Integer -> [Device.Port] Integer
  clk-field-value (reg) (b) = act
    raw <- rtc-read reg
    rtc-decode raw (bit-and b rtc-binary-bit)
  end

  clk-decode-hour : Integer, Integer -> Integer
  clk-decode-hour (raw) (b) =
    let pm = bit-and raw clk-pm-bit /= 0
    in let v = rtc-decode (bit-and raw 127) (bit-and b rtc-binary-bit)
    in if bit-and b clk-h24-bit /= 0 then v
    else if pm then (if v == 12 then 12 else v + 12)
    else (if v == 12 then 0 else v)

  clk-hour-now : Integer -> [Device.Port] Integer
  clk-hour-now (b) = act
    raw <- rtc-read clk-reg-hours
    clk-decode-hour raw b
  end

Section: Writing

  clk-write : Integer, Integer -> [Device.Port] Integer
  clk-write (reg) (v) = act
    w <- port-out-byte rtc-port-index reg
    port-out-byte rtc-port-data v
  end

  clk-int-to-bcd : Integer -> Integer
  clk-int-to-bcd (v) = bit-shl (v / 10) 4 + int-mod v 10

  clk-encode : Integer, Integer -> Integer
  clk-encode (v) (b) = if bit-and b rtc-binary-bit /= 0 then v else clk-int-to-bcd v

  clk-encode-hour : Integer, Integer -> Integer
  clk-encode-hour (h) (b) =
    if bit-and b clk-h24-bit /= 0 then clk-encode h b
    else if h == 0 then clk-encode 12 b
    else if h < 12 then clk-encode h b
    else if h == 12 then clk-encode 12 b + clk-pm-bit
    else clk-encode (h - 12) b + clk-pm-bit

  clk-commit : Integer -> [Device.Port] Integer
  clk-commit (ks) = act
    b <- rtc-read rtc-reg-status-b
    f <- clk-write rtc-reg-status-b (bit-or b clk-set-bit)
    w1 <- clk-write clk-reg-hours (clk-encode-hour (peek-32 ks clk-h-cell) b)
    w2 <- clk-write clk-reg-minutes (clk-encode (peek-32 ks clk-mi-cell) b)
    w3 <- clk-write clk-reg-seconds (clk-encode (peek-32 ks clk-s-cell) b)
    w4 <- clk-write clk-reg-day (clk-encode (peek-32 ks clk-d-cell) b)
    w5 <- clk-write clk-reg-month (clk-encode (peek-32 ks clk-mo-cell) b)
    w6 <- clk-write clk-reg-year (clk-encode (peek-32 ks clk-y-cell) b)
    r <- (clk-write rtc-reg-status-b b)
    1
  end

  clk-load : Integer -> [Device.Port] Integer
  clk-load (ks) = act
    idle <- rtc-wait-idle rtc-uip-fuel
    b <- clk-mode 0
    h <- clk-hour-now b
    mi <- clk-field-value clk-reg-minutes b
    s <- clk-field-value clk-reg-seconds b
    d <- clk-field-value clk-reg-day b
    mo <- clk-field-value clk-reg-month b
    y <- clk-field-value clk-reg-year b
    let a = poke-32 ks clk-h-cell h
    in let c = poke-32 ks clk-mi-cell mi
    in let e = poke-32 ks clk-s-cell s
    in let g = poke-32 ks clk-d-cell d
    in let i = poke-32 ks clk-mo-cell mo
    in let j = poke-32 ks clk-y-cell y
    in let k = poke-32 ks clk-editing-cell 1
    in poke-32 ks clk-field-cell 0
  end

Section: Formatting

  clk-pad2 : Integer -> Text
  clk-pad2 (v) = if v < 10 then "0" & show v else show v

  clk-wrap24 : Integer -> Integer
  clk-wrap24 (h) = int-mod (h + 24) 24

  clk-hms : Integer, Integer, Integer -> Text
  clk-hms (h) (mi) (s) = clk-pad2 h & ":" & clk-pad2 mi & ":" & clk-pad2 s

  clk-preview-tree : Integer, Integer, Integer, Integer -> WidgetNode
  clk-preview-tree (h) (mi) (s) (rows) =
    widget-panel "clk-preview" DirColumn 0 [
      widget-set-min (widget-label "clk-preview-now" (clk-hms h mi s)) 0 rows ]

  clk-month-name : Integer -> Text
  clk-month-name (m) =
    if m == 1 then "January" else if m == 2 then "February" else if m == 3 then "March"
    else if m == 4 then "April" else if m == 5 then "May" else if m == 6 then "June"
    else if m == 7 then "July" else if m == 8 then "August" else if m == 9 then "September"
    else if m == 10 then "October" else if m == 11 then "November" else if m == 12 then "December"
    else "?"

  clk-date-text : Integer, Integer, Integer -> Text
  clk-date-text (d) (mo) (y) = clk-month-name mo & " " & show d & ", " & show (2000 + y)

Section: Fields

  clk-field-name : Integer -> Text
  clk-field-name (f) =
    if f == 0 then "Hour" else if f == 1 then "Minute" else if f == 2 then "Second"
    else if f == 3 then "Day" else if f == 4 then "Month" else if f == 5 then "Year"
    else "Zone"

  clk-field-cell-of : Integer -> Integer
  clk-field-cell-of (f) =
    if f == 0 then clk-h-cell else if f == 1 then clk-mi-cell else if f == 2 then clk-s-cell
    else if f == 3 then clk-d-cell else if f == 4 then clk-mo-cell else clk-y-cell

  clk-field-max : Integer -> Integer
  clk-field-max (f) =
    if f == 0 then 23 else if f == 1 then 59 else if f == 2 then 59
    else if f == 3 then 31 else if f == 4 then 12 else 99

  clk-field-min : Integer -> Integer
  clk-field-min (f) = if f == 3 | f == 4 then 1 else 0

  clk-bump : Integer, Integer -> Integer
  clk-bump (ks) (delta) =
    let f = clk-field ks
    in if f == 6 then clk-set-zone ks (clk-zone ks + delta)
    else let c = clk-field-cell-of f
    in let lo = clk-field-min f
    in let hi = clk-field-max f
    in let v = peek-32 ks c + delta
    in poke-32 ks c (if v < lo then hi else if v > hi then lo else v)

  clk-field-text : Integer, Integer -> Text
  clk-field-text (ks) (f) =
    if f == 6 then zone-text (clk-zone ks)
    else if f == 5 then show (2000 + peek-32 ks clk-y-cell)
    else clk-pad2 (peek-32 ks (clk-field-cell-of f))

Section: The Tree

  clk-row : Integer, Integer -> WidgetNode
  clk-row (ks) (f) =
    let mark = if clk-field ks == f then "> " else "  "
    in widget-set-min (widget-button ("clk-f-" & clk-field-name f) (mark & clk-field-name f & "   " & clk-field-text ks f)) 0 22

  clk-rows : Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  clk-rows (ks) (i) (stop) (acc) =
    if i >= stop then acc
    else clk-rows ks (i + 1) stop (list-push acc (clk-row ks i))

  clk-split : Integer = 4

  clk-art-h : Integer = 132

  clk-art : Text -> WidgetNode
  clk-art (id) = widget-set-min (widget-label id "") 0 clk-art-h

  clk-band-text : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  clk-band-text (ks) (h) (mi) (s) (d) (mo) (y) =
    let t = clk-local-mins ks h mi (2000 + y) mo d
    in let lh = clk-local-h t
    in let lm = clk-local-mi t
    in let tt = if clk-band-has ks zone-band-time then loc-time (clk-cfmt ks) lh lm s else ""
    in let dt = if clk-band-has ks zone-band-date then loc-date (clk-dfmt ks) (2000 + y) mo d else ""
    in let id = clk-zid ks
    in let off = if clk-band-has ks zone-band-offset == False then ""
                 else if zone-valid id then loc-utc-text (zone-offset-on id (2000 + y) mo d h)
                 else zone-text (clk-zone ks)
    in clk-join3 tt dt off

  clk-join2 : Text, Text -> Text
  clk-join2 (a) (b) =
    if text-length a == 0 then b
    else if text-length b == 0 then a
    else a & "   " & b

  clk-join3 : Text, Text, Text -> Text
  clk-join3 (a) (b) (c) = clk-join2 (clk-join2 a b) c

  clk-nav-h : Integer = 22

  clk-nav-sel : Integer -> Integer
  clk-nav-sel (ks) =
    if clk-editing ks then 3
    else if clk-view ks == clk-view-zones then 1
    else if clk-view ks == clk-view-formats then 2
    else 0

  clk-nav : Integer -> WidgetNode
  clk-nav (ks) =
    widget-fixed (widget-tabs "clk-nav" ["Clock", "World", "Formats", "Set the clock"] (clk-nav-sel ks)) 0 clk-nav-h

  clk-local-mins : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  clk-local-mins (ks) (h) (mi) (y) (mo) (d) =
    let id = clk-zid ks
    in h * 60 + mi + (if zone-valid id then zone-offset-on id y mo d h else clk-zone ks * 60)

  clk-local-h : Integer -> Integer
  clk-local-h (t) = int-mod (int-mod t 1440 + 1440) 1440 / 60

  clk-local-mi : Integer -> Integer
  clk-local-mi (t) = int-mod (int-mod t 1440 + 1440) 1440 / 1 - clk-local-h t * 60

  clk-where : Integer, Integer, Integer, Integer, Integer -> Text
  clk-where (ks) (y) (mo) (d) (hh) =
    let id = clk-zid ks
    in if zone-valid id == False then "no zone chosen   " & zone-text (clk-zone ks)
    else (zone-row-of id).zr-city & "   " & loc-utc-text (zone-offset-on id y mo d hh)
         & (if zone-is-summer id y mo d hh then "   summer time" else "")

  clk-face-tree : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> WidgetNode
  clk-face-tree (ks) (h) (mi) (s) (d) (mo) (y) =
    let t = clk-local-mins ks h mi (2000 + y) mo d
    in let lh = clk-local-h t
    in let lm = clk-local-mi t
    in widget-panel "clk-pane" DirColumn 6 [
      clk-nav ks,
      clk-art "clk-art",
      widget-set-min (widget-label "clk-now" (loc-time (clk-cfmt ks) lh lm s)) 0 26,
      widget-set-min (widget-label "clk-date" (loc-date-long (clk-dfmt ks) (2000 + y) mo d & "   " & loc-dow-name (loc-dow (2000 + y) mo d))) 0 22,
      widget-set-min (widget-label "clk-zone" (clk-where ks (2000 + y) mo d h)) 0 22,
      widget-set-flex (widget-label "clk-gap" "") 1
    ]

  clk-zrow : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> WidgetNode
  clk-zrow (ks) (i) (id) (y) (mo) (d) (hh) =
    let mark = if clk-pick ks == i then "> " else "  "
    in widget-set-min (widget-button ("clk-z-" & show id) (mark & zone-label id y mo d hh)) 0 22

  clk-zrows : Integer, List Integer, Integer, Integer, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  clk-zrows (ks) (ids) (i) (y) (mo) (d) (hh) (acc) =
    if i >= list-length ids then acc
    else clk-zrows ks ids (i + 1) y mo d hh (list-push acc (clk-zrow ks i (list-at ids i) y mo d hh))

  clk-zones-tree : Integer, Integer, Integer, Integer, Integer -> WidgetNode
  clk-zones-tree (ks) (y) (mo) (d) (hh) =
    let ids = clk-stripe-list ks
    in widget-panel "clk-pane" DirColumn 6 [
      clk-nav ks,
      clk-art "clk-map",
      widget-set-min (widget-label "clk-band" ("band " & loc-utc-text (clk-stripe ks * 60) & "    " & show (list-length ids) & " places")) 0 22,
      widget-fixed (widget-panel "clk-bandnav" DirRow 4 [
        widget-button "clk-band-w" "< west",
        widget-button "clk-band-e" "east >"
      ]) 0 22,
      widget-set-flex (widget-panel "clk-zlist" DirColumn 2 (clk-zrows ks ids 0 y mo d hh [])) 1,
      widget-set-min (widget-label "clk-help" "click the map, then a place") 0 20
    ]

  clk-frow : Text, Text, Text, Boolean -> WidgetNode
  clk-frow (id) (nm) (sample) (on) =
    widget-set-min (widget-button id ((if on then "> " else "  ") & nm & "    " & sample)) 0 22

  clk-brow : Text, Text, Boolean -> WidgetNode
  clk-brow (id) (nm) (on) =
    widget-set-min (widget-button id ((if on then "[x]  " else "[ ]  ") & nm)) 0 22

  clk-band-preview : Integer, Integer, Integer, Integer -> Text
  clk-band-preview (ks) (y) (mo) (d) =
    let p = clk-band-text ks 13 5 0 d mo (y - 2000)
    in if text-length p == 0 then "nothing" else p

  clk-formats-tree : Integer, Integer, Integer, Integer -> WidgetNode
  clk-formats-tree (ks) (y) (mo) (d) =
    widget-panel "clk-pane" DirColumn 6 [
      clk-nav ks,
      widget-set-min (widget-label "clk-fh" "The clock") 0 22,
      clk-frow "clk-c24" "24 hour" (loc-time loc-clock-24 13 5 0) (clk-cfmt ks == loc-clock-24),
      clk-frow "clk-c12" "12 hour" (loc-time loc-clock-12 13 5 0) (clk-cfmt ks == loc-clock-12),
      widget-set-min (widget-label "clk-fd" "The date") 0 22,
      clk-frow "clk-dmy" "day month year" (loc-date loc-date-dmy y mo d) (clk-dfmt ks == loc-date-dmy),
      clk-frow "clk-mdy" "month day year" (loc-date loc-date-mdy y mo d) (clk-dfmt ks == loc-date-mdy),
      clk-frow "clk-ymd" "year month day" (loc-date loc-date-ymd y mo d) (clk-dfmt ks == loc-date-ymd),
      widget-set-min (widget-label "clk-fb" "The taskbar clock") 0 22,
      clk-brow "clk-b-time" "the time" (clk-band-has ks zone-band-time),
      clk-brow "clk-b-date" "the date" (clk-band-has ks zone-band-date),
      clk-brow "clk-b-off" "the zone offset" (clk-band-has ks zone-band-offset),
      widget-set-min (widget-label "clk-bpreview" ("shows: " & clk-band-preview ks y mo d)) 0 22,
      widget-set-flex (widget-label "clk-gap2" "") 1,
      widget-set-min (widget-label "clk-help" "click a row to keep it") 0 20
    ]

  clk-tree : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> WidgetNode
  clk-tree (ks) (h) (mi) (s) (d) (mo) (y) =
    if clk-editing ks then
      let face = widget-panel "clk-face" DirColumn 4 [
        widget-set-min (widget-label "clk-now" ("This machine    " & clk-hms h mi s)) 0 26,
        widget-set-min (widget-label "clk-date" ("                " & clk-date-text d mo y)) 0 22
      ]
      in let left = widget-panel "clk-edit-l" DirColumn 2 (clk-rows ks 0 clk-split [])
      in let right = widget-panel "clk-edit-r" DirColumn 2 (clk-rows ks clk-split clk-fields [])
      in widget-panel "clk-pane" DirColumn 8 [
        clk-nav ks,
        face,
        widget-set-flex (widget-panel "clk-edit" DirRow 8 [widget-set-flex left 1, widget-set-flex right 1]) 1,
        widget-fixed (widget-panel "clk-editnav" DirRow 4 [
          widget-button "clk-less" ("-  " & clk-field-name (clk-field ks)),
          widget-button "clk-more" ("+  " & clk-field-name (clk-field ks)),
          widget-button "clk-keep" "Write it to the clock",
          widget-button "clk-cancel" "Cancel"
        ]) 0 22,
        widget-set-min (widget-label "clk-help2" "click a field, then - or +") 0 20
      ]
    else if clk-view ks == clk-view-zones then clk-zones-tree ks (2000 + y) mo d h
    else if clk-view ks == clk-view-formats then clk-formats-tree ks (2000 + y) mo d
    else clk-face-tree ks h mi s d mo y

Section: Keys

  clk-key-view : Integer, Integer -> Integer
  clk-key-view (ks) (sc) =
    if sc == 1 then let d = clk-set-view ks clk-view-face in 1
    else if clk-view ks == clk-view-zones then
      if sc == 75 then let d = clk-set-stripe ks (clk-stripe ks - 1) in 1
      else if sc == 77 then let d = clk-set-stripe ks (clk-stripe ks + 1) in 1
      else if sc == 72 then let d = poke-32 ks clk-pick-cell (if clk-pick ks <= 0 then 0 else clk-pick ks - 1) in 1
      else if sc == 80 then
        let n = list-length (clk-stripe-list ks)
        in let d = poke-32 ks clk-pick-cell (if clk-pick ks + 1 >= n then (if n == 0 then 0 else n - 1) else clk-pick ks + 1)
        in 1
      else if sc == 28 then
        let id = clk-picked ks
        in if id == 0 then 1
        else let a = poke-32 ks clk-zid-cell id
        in let b = clk-set-view ks clk-view-face
        in 5
      else 0
    else
      if sc == 72 then let d = clk-fmt-prev ks in 1
      else if sc == 80 then let d = clk-fmt-next ks in 1
      else if sc == 28 then let d = clk-set-view ks clk-view-face in 5
      else 0

  clk-fmt-row : Integer -> Integer
  clk-fmt-row (ks) = if clk-cfmt ks == loc-clock-12 then 1 else 0

  clk-fmt-set : Integer, Integer -> Integer
  clk-fmt-set (ks) (r) =
    if r <= 0 then poke-32 ks clk-cfmt-cell loc-clock-24
    else if r == 1 then poke-32 ks clk-cfmt-cell loc-clock-12
    else poke-32 ks clk-dfmt-cell (r - 2)

  clk-fmt-at : Integer -> Integer
  clk-fmt-at (ks) = if clk-cfmt ks == loc-clock-12 then 1 else 0

  clk-fmt-prev : Integer -> Integer
  clk-fmt-prev (ks) =
    if clk-dfmt ks > 0 then poke-32 ks clk-dfmt-cell (clk-dfmt ks - 1)
    else poke-32 ks clk-cfmt-cell loc-clock-24

  clk-fmt-next : Integer -> Integer
  clk-fmt-next (ks) =
    if clk-cfmt ks == loc-clock-24 then poke-32 ks clk-cfmt-cell loc-clock-12
    else if clk-dfmt ks < loc-date-ymd then poke-32 ks clk-dfmt-cell (clk-dfmt ks + 1)
    else 0

  clk-key : Integer, Integer -> Integer
  clk-key (ks) (sc) =
    if clk-editing ks == False & clk-view ks /= clk-view-face then clk-key-view ks sc
    else if sc == 1 then (if clk-editing ks then let d = poke-32 ks clk-editing-cell 0 in 1 else 1)
    else if clk-editing ks == False then
      if sc == 31 then 2
      else if sc == 44 then let d = clk-set-view ks clk-view-zones in 1
      else if sc == 33 then let d = clk-set-view ks clk-view-formats in 1
      else 0
    else if sc == 72 then let d = clk-bump ks 1 in 1
    else if sc == 80 then let d = clk-bump ks (0 - 1) in 1
    else if sc == 75 then let d = poke-32 ks clk-field-cell (int-mod (clk-field ks + clk-fields - 1) clk-fields) in 1
    else if sc == 77 then let d = poke-32 ks clk-field-cell (int-mod (clk-field ks + 1) clk-fields) in 1
    else if sc == 28 then 4
    else 0

