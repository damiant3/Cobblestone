 A2b's payload: the desktop, with nothing between the power button and
 it. GopBoot reaches the same desktop through the first-boot ceremony
 and a menu, and both of those need a keyboard. On the ASUS TUF the
 keyboard is the open question -- measured 2026-08-04, no key delivered
 in 3978 seconds after the firmware handback -- so a boot whose panel
 evidence depends on typing answers neither question. This one asks the
 panel questions alone: the mode, the aspect, the seven panes, and what
 the Monitor pane reads off the machine.

 We say:

Section: Narration

  db-trace : Integer, Integer, Integer, CbfFont, Integer, Text -> Integer
  db-trace (base) (stride) (h) (font) (row) (t) =
    let y = h / 2 + 80 + row * 14
    in let bg = gop-fill-rect base stride 8 y 400 12 0
    in gop-draw-text base stride font 8 y t #00FF00 1 0

  db-diag : Integer, Integer, Integer, Integer, CbfFont -> Integer
  db-diag (base) (w) (h) (stride) (font) =
    let b1 = gop-fill-rect base stride 0 0 w (h / 8) #FF0000
    in let b2 = gop-fill-rect base stride 0 (h / 8) w (h / 8) #00FF00
    in let b3 = gop-fill-rect base stride 0 (h / 4) w (h / 8) #0000FF
    in let b4 = gop-fill-rect base stride 0 (h * 3 / 8) w (h / 8) #FFFFFF
    in let bg = gop-fill-rect base stride 0 (h / 2) w (h / 2) 0
    in let l1 = gop-draw-text base stride font 8 (h / 2 + 8) "CODEX DESK BOOT   bars: red green blue white" #FFFFFF 1 0
    in let l2 = gop-draw-text base stride font 8 (h / 2 + 24) ("w=" & show w & "  h=" & show h & "  stride=" & show stride) #FFFFFF 1 0
    in gop-draw-text base stride font 8 (h / 2 + 40) ("fb=" & show base) #FFFFFF 1 0

Section: The Hold

 The diag is held on the RTC, not on a spin count. GopBoot holds it with
 boot-spin 150000000, and a spin budget is not a duration: the same
 constant is a long pause on one machine and a flicker on another, and
 on the ASUS the whole diag went by faster than a camera could be lined
 up on it. Damian, 2026-08-04, photographing it: "flash on screen too
 quickly to line up the shot."

 The number was five, then thirty, now ten, all within one day and all
 from the bench rather than from an argument. Five was not enough to
 line up a camera on a rig that has to be walked to; thirty was more
 than the rig needs once it is standing (Damian, 2026-08-04, both
 readings). Ten is what a mounted camera actually costs, and the cost
 is paid on every boot of this payload.

  db-hold-secs : Integer = 10

  db-hold-fuel : Integer = 2000000000

  db-hold-row : Integer, Integer, Integer, CbfFont, Integer -> Integer
  db-hold-row (base) (stride) (h) (font) (left) =
    let y = h / 2 + 56
    in let bg = gop-fill-rect base stride 8 y 400 12 0
    in gop-draw-text base stride font 8 y ("diag hold: " & show left & "s -- photograph now") #FFFF00 1 0

  db-hold-start : Integer, Integer, Integer, CbfFont -> [Device.Port] Integer
  db-hold-start (base) (stride) (h) (font) = act
    let r0 = db-hold-row base stride h font db-hold-secs
    in act
      s0 <- rtc-seconds 0
      db-hold base stride h font s0 db-hold-secs db-hold-fuel
    end
  end

  db-hold : Integer, Integer, Integer, CbfFont, Integer, Integer, Integer -> [Device.Port] Integer
  db-hold (base) (stride) (h) (font) (prev) (left) (fuel) = act
    now <- rtc-seconds 0
    if left <= 0 then 0
    else if fuel <= 0 then 0
    else if now < 0 then db-hold base stride h font prev left (fuel - 1)
    else if now == prev then db-hold base stride h font prev left (fuel - 1)
    else let r = db-hold-row base stride h font (left - 1)
    in db-hold base stride h font now (left - 1) (fuel - 1)
  end

Section: The Keyboard Table

 One row per bound keyboard interface, off the cells usb-kbd-note wrote
 at bind time (GopUsb: count at 47, rows at 80-95). The row width is 720
 rather than db-trace's 400 because a row carries idVendor:idProduct,
 which is the field that names the device a silent interface belongs to
 -- the reading the whole 2026-08 keyboard campaign never had.

  db-krow : Integer, Integer, Integer, CbfFont, Integer, Text -> Integer
  db-krow (base) (stride) (h) (font) (row) (t) =
    let y = h / 2 + 80 + row * 14
    in let bg = gop-fill-rect base stride 8 y 720 12 0
    in gop-draw-text base stride font 8 y t #00FF00 1 0

  db-kbd-row-kind : Integer -> Text
  db-kbd-row-kind (meta) =
    if bit-and meta 512 /= 0 then " mouse"
    else if bit-and meta 256 /= 0 then " raw"
    else " kbd"

  db-kbd-row-txt : Integer -> Text
  db-kbd-row-txt (i) =
    let base = 80 + i * 4
    in let meta = xdiag-get (base + 2)
    in "hid" & show (i + 1) & " id=" & hex-i32 (xdiag-get base)
      & " port=" & show (bit-shru (xdiag-get (base + 1)) 24)
      & " route=" & hex-i32 (bit-and (xdiag-get (base + 1)) #FFFFF)
      & " dci=" & show (bit-and meta 255)
      & db-kbd-row-kind meta
      & " spd=" & show (bit-and (bit-shru meta 12) 15)
      & " buf=" & hex-i32 (xdiag-get (base + 3))

  db-kbd-table-rows : Integer, Integer, Integer, CbfFont, Integer, Integer -> Integer
  db-kbd-table-rows (base) (stride) (h) (font) (i) (n) =
    if i >= n then 0
    else if i >= 4 then 0
    else let r = db-krow base stride h font (4 + i) (db-kbd-row-txt i)
    in db-kbd-table-rows base stride h font (i + 1) n

  db-kbd-table : Integer, Integer, Integer, CbfFont -> Integer
  db-kbd-table (base) (stride) (h) (font) =
    let n = xdiag-get 47
    in let s = db-krow base stride h font 3 ("hid interfaces bound=" & show n)
    in db-kbd-table-rows base stride h font 0 n

Section: The Keyboard Hold

  db-khold-row : Integer, Integer, Integer, CbfFont, Integer -> Integer
  db-khold-row (base) (stride) (h) (font) (left) =
    let y = h / 2 + 56
    in let bg = gop-fill-rect base stride 8 y 720 12 0
    in gop-draw-text base stride font 8 y ("keyboard hold: " & show left & "s -- any key skips -- photograph the table") #FFFF00 1 0

  db-hold-dwell : Integer = 3

  db-kbd-hold : Integer, Integer, Integer, CbfFont, UsbKbd, Integer, Integer, Integer -> [Device.Port] Integer
  db-kbd-hold (base) (stride) (h) (font) (kbd) (prev) (left) (fuel) = act
    sc <- kbd-take kbd
    now <- rtc-seconds 0
    if if sc /= 0 then left <= db-hold-secs - db-hold-dwell else False then 1
    else if left <= 0 then 0
    else if fuel <= 0 then 0
    else if now < 0 then db-kbd-hold base stride h font kbd prev left (fuel - 1)
    else if now == prev then db-kbd-hold base stride h font kbd prev left (fuel - 1)
    else let r = db-khold-row base stride h font (left - 1)
    in let l = db-krow base stride h font 8 ("live: " & desk-kbd-line kbd)
    in db-kbd-hold base stride h font kbd now (left - 1) (fuel - 1)
  end

  db-kbd-hold-start : Integer, Integer, Integer, CbfFont, UsbKbd -> [Device.Port] Integer
  db-kbd-hold-start (base) (stride) (h) (font) (kbd) = act
    d <- kbd-take kbd
    let r0 = db-khold-row base stride h font db-hold-secs
    in let l0 = db-krow base stride h font 8 ("live: " & desk-kbd-line kbd)
    in act
      s0 <- rtc-seconds 0
      db-kbd-hold base stride h font kbd s0 db-hold-secs db-hold-fuel
    end
  end

Section: Entry

  db-flow : Integer, Integer, Integer, Integer, CbfFont -> [Device.Port, Device.Mmio, Gpu.Compute, Gpu.Memory] Integer
  db-flow (base) (w) (h) (stride) (font) = act
    let dg = db-diag base w h stride font
    in act
      hd <- db-hold-start base stride h font
      let t0 = db-trace base stride h font 0 "stage: spine..."
      in act
        ri <- runtime-init 0
        let t1 = db-trace base stride h font 1 "spine OK  stage: usb..."
        in act
          att <- usb-attach
          let t2 = db-trace base stride h font 2 ("usb OK kbd=" & (if (att.ua-kbd).uk-ok then "Y" else "n") & " mouse=" & (if (att.ua-mouse).um-ok then "Y" else "n") & " disk=" & (if (att.ua-disk).md-ok then "Y" else "n") & "  stage: kbd hold...")
          in let tk = db-kbd-table base stride h font
          in act
            hk <- db-kbd-hold-start base stride h font (att.ua-kbd)
            med <- medium-select
            let t3 = db-trace base stride h font 9 ("medium kind=" & show med & "  stage: desk...")
            in desk-run base w h stride font (att.ua-kbd) (att.ua-mouse)
          end
        end
      end
    end
  end

  opening : [Device.Port, Device.Mmio, Gpu.Compute, Gpu.Memory] Integer
  opening =
    let font = cbf-init
    in db-flow (boot-fb-base 0) (boot-fb-w 0) (boot-fb-h 0) (boot-fb-stride 0) font
