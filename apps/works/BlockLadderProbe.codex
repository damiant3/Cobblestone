Chapter: BlockLadderProbe
  cites Works chapter MetalLadder

 We say:

Section: Cells

  probe-systab-cell : Integer = 30704

  probe-part-lba : Integer = 2048

  probe-scratch-lba : Integer = 30000

  probe-mark-a : Integer = 165

Section: Entry

  probe-bps : Integer -> Integer
  probe-bps (buf) = peek-byte buf 11 + bit-shl (peek-byte buf 12) 8

  probe-read-ok : Integer -> Integer
  probe-read-ok (buf) =
    if buf == 0 then 0
    else if peek-byte buf 510 /= 85 then 0
    else if peek-byte buf 511 /= 170 then 0
    else 1

  probe-truth : Boolean -> Integer
  probe-truth (b) = if b then 1 else 0

  probe-step : Text, Integer, Integer, Integer -> [Console] Nothing
  probe-step (tag) (ok) (colour) (prev) = act
    fb <- ladder-pass ok colour prev
    print-line-uni ("LADDER " & tag & " ok=" & show ok & " painted fb=" & show fb)
    h <- ladder-hold-if ok prev
    print-line-uni ("LADDER " & tag & " continuing")
  end

  opening : [Console, Device.Block] Integer = act
    a <- probe-step "entered" 1 ladder-cyan ladder-red
    print-line-uni ("LADDER fb base=" & show (boot-fb-base 0) & " w=" & show (boot-fb-w 0) & " h=" & show (boot-fb-h 0) & " stride=" & show (boot-fb-stride 0))
    b <- probe-step "systab" (probe-truth (peek-qword probe-systab-cell 0 /= 0)) ladder-yellow ladder-cyan
    sb <- block-read-sector probe-part-lba
    c <- probe-step "read" (probe-read-ok sb) ladder-magenta ladder-yellow
    print-line-uni ("LADDER bps=" & show (probe-bps sb) & " b0=" & show (peek-byte sb 0) & " b11=" & show (peek-byte sb 11) & " b12=" & show (peek-byte sb 12))
    d <- probe-step "bpb" (probe-truth (probe-bps sb == 512)) ladder-orange ladder-magenta
    m0 <- poke-byte sb 0 probe-mark-a
    wr <- block-write-sector probe-scratch-lba sb
    rb <- block-read-sector probe-scratch-lba
    e <- probe-step "readback" (probe-read-ok rb) ladder-orange ladder-magenta
    f <- probe-step "wrote" (probe-truth (peek-byte rb 0 == probe-mark-a)) ladder-white ladder-orange
    ladder-hold ladder-white
  end
