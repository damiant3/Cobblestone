Chapter: GopInputQueue
  cites Works chapter GopAhci

Section: Storage

  di-cap : Integer = 256
  di-event-bytes : Integer = 64
  di-meta-bytes : Integer = 256
  di-trace-cap : Integer = 4096
  di-trace-bytes : Integer = 32
  di-motion : Integer = 1
  di-button : Integer = 2
  di-key : Integer = 3

 Metadata and event fields are qwords. The fixed block survives the desk's
 frame and pane heap restores. No queue or trace operation allocates.

  di-head : Integer = 0
  di-count : Integer = 8
  di-sequence : Integer = 16
  di-loss : Integer = 24
  di-overflow : Integer = 32
  di-tracing : Integer = 40
  di-trace-count : Integer = 48
  di-trace-loss : Integer = 56
  di-last-pass : Integer = 64
  di-max-gap : Integer = 72
  di-passes : Integer = 80
  di-rearms : Integer = 88
  di-col-x : Integer = 96
  di-col-y : Integer = 104
  di-col-buttons : Integer = 112
  di-out-kind : Integer = 120
  di-out-key : Integer = 128
  di-out-click : Integer = 136
  di-out-sequence : Integer = 144
  di-no-rearm : Integer = 152
  di-drop-edge : Integer = 160
  di-notified : Integer = 168
  di-last-event : Integer = 176
  di-event-gap : Integer = 184
  di-event-count : Integer = 192
  di-errors : Integer = 200
  di-error-code : Integer = 208
  di-error-notified : Integer = 216

 Event offsets: kind, first sequence, last sequence, x/dx, y/dy,
 buttons/scancode, collected x, collected y. Motion keeps summed deltas
 and the last clamped position; edges retain their exact position.

  di-new : Integer -> Integer
  di-new (tracing) =
    let q = alloc-zeroed (di-meta-bytes + di-cap * di-event-bytes + di-trace-cap * di-trace-bytes) 64
    in let a = poke-qword q di-tracing tracing
    in q

  di-at : Integer, Integer -> Integer
  di-at (q) (index) = q + di-meta-bytes + index * di-event-bytes

  di-trace : Integer, Integer, Integer, Integer, Integer -> Integer
  di-trace (q) (kind) (seq) (now) (value) =
    if peek-qword q di-tracing == 0 then 0
    else let n = peek-qword q di-trace-count
    in if n >= di-trace-cap then poke-qword q di-trace-loss (peek-qword q di-trace-loss + 1)
    else let t = q + di-meta-bytes + di-cap * di-event-bytes + n * di-trace-bytes
    in let a = poke-qword t 0 kind
    in let b = poke-qword t 8 seq
    in let c = poke-qword t 16 now
    in let d = poke-qword t 24 value
    in poke-qword q di-trace-count (n + 1)

  di-lost : Integer -> Integer
  di-lost (q) =
    let a = poke-qword q di-overflow 1
    in let b = poke-qword q di-loss (peek-qword q di-loss + 1)
    in 0

  di-push : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  di-push (q) (kind) (dx) (dy) (value) (x) (y) (now) =
    let timing = di-event-note q now
    in let seq = peek-qword q di-sequence + 1
    in let a = poke-qword q di-sequence seq
    in let n = peek-qword q di-count
    in let tail = di-at q (int-mod (peek-qword q di-head + n + di-cap - 1) di-cap)
    in let merge = kind == di-motion & n > 0 & peek-qword tail 0 == di-motion & peek-qword tail 40 == value & peek-qword tail 16 == seq - 1
    in if merge then
      let b = poke-qword tail 16 seq
      in let c = poke-qword tail 24 (peek-qword tail 24 + dx)
      in let d = poke-qword tail 32 (peek-qword tail 32 + dy)
      in let e = poke-qword tail 48 x
      in let f = poke-qword tail 56 y
      in let t = di-trace q 1 seq now kind
      in 1
    else if n >= di-cap then di-lost q
    else let e = di-at q (int-mod (peek-qword q di-head + n) di-cap)
    in let b = poke-qword e 0 kind
    in let c = poke-qword e 8 seq
    in let d = poke-qword e 16 seq
    in let f = poke-qword e 24 dx
    in let g = poke-qword e 32 dy
    in let h = poke-qword e 40 value
    in let i = poke-qword e 48 x
    in let j = poke-qword e 56 y
    in let k = poke-qword q di-count (n + 1)
    in let t = di-trace q 1 seq now kind
    in 1

  di-event-note : Integer, Integer -> Integer
  di-event-note (q) (now) =
    let prev = peek-qword q di-last-event
    in let gap = if peek-qword q di-event-count > 0 & now >= prev then now - prev else 0
    in let a = poke-qword q di-event-gap (if gap > peek-qword q di-event-gap then gap else peek-qword q di-event-gap)
    in let b = poke-qword q di-last-event now
    in poke-qword q di-event-count (peek-qword q di-event-count + 1)

  di-front : Integer -> Integer
  di-front (q) = if peek-qword q di-count == 0 then 0 else di-at q (peek-qword q di-head)

  di-pop : Integer, Integer -> Integer
  di-pop (q) (now) =
    let e = di-front q
    in if e == 0 then 0
    else let t = di-trace q 2 (peek-qword e 16) now (peek-qword e 0)
    in let a = poke-qword q di-head (int-mod (peek-qword q di-head + 1) di-cap)
    in let b = poke-qword q di-count (peek-qword q di-count - 1)
    in 1

  di-pass : Integer, Integer -> Integer
  di-pass (q) (now) =
    let prev = peek-qword q di-last-pass
    in let gap = if now >= prev & peek-qword q di-passes > 0 then now - prev else 0
    in let a = poke-qword q di-last-pass now
    in let b = poke-qword q di-max-gap (if gap > peek-qword q di-max-gap then gap else peek-qword q di-max-gap)
    in poke-qword q di-passes (peek-qword q di-passes + 1)
