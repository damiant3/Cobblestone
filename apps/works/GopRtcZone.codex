Chapter: GopRtcZone
  cites Foreword chapter Maybe
  cites Works chapter GopRtc
  cites Works chapter GopZone (ZoneMachine, zone-machine-load)
  cites Foreword chapter TimeZone (Zone, LocalChoice, local-to-utc-choosing)
  cites Foreword chapter DateTime (ymd-to-days)

Section: Conversion

  rtc-civil-seconds : RtcCivil -> Integer
  rtc-civil-seconds (c) =
    ymd-to-days (c.rc-year) (c.rc-month) (c.rc-day) * 86400 + c.rc-hour * 3600 + c.rc-minute * 60 + c.rc-second

  rtc-utc-of : RtcCivil, ZoneMachine, Maybe Zone -> Maybe Integer
  rtc-utc-of (c) (zm) (mz) =
    if c.rc-ok == False then None
    else if zm.zm-rtc-local == False then Just (rtc-civil-seconds c)
    else
      when mz
        is None -> None
        is Just (z) -> if z.name /= zm.zm-name then None else local-to-utc-choosing z (rtc-civil-seconds c) AfterGap

  rtc-utc-read : Maybe Zone -> [Device.Port] Maybe Integer
  rtc-utc-read (mz) = act
    c <- rtc-civil 0
    zm <- zone-machine-load
    rtc-utc-of c zm mz
  end
