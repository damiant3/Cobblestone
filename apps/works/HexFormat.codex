Chapter: HexFormat
  cites Encode chapter Hex

 We say:

Section: Hex Conversion

  hex-i32 : Integer -> Text
  hex-i32 (v) =
    hex-byte (bit-and (bit-shru v 24) 255)
    & hex-byte (bit-and (bit-shru v 16) 255)
    & hex-byte (bit-and (bit-shru v 8) 255)
    & hex-byte (bit-and v 255)

  hex-i64 : Integer -> Text
  hex-i64 (v) =
    hex-i32 (bit-shru v 32) & hex-i32 (bit-and v 4294967295)

Section: Size Formatting

  format-bytes : Integer -> Text
  format-bytes (n) =
    if n >= 1073741824 then show (n / 1073741824) & " GB"
    else if n >= 1048576 then show (n / 1048576) & " MB"
    else if n >= 1024 then show (n / 1024) & " KB"
    else show n & " bytes"

  format-bytes-exact : Integer -> Text
  format-bytes-exact (n) = show n & " bytes (" & format-bytes n & ")"

Section: Hash Display

  format-hash-short : Text -> Text
  format-hash-short (hash) =
    if text-length hash >= 16 then substring hash 0 16 & "..."
    else hash

Section: Table Formatting

  pad-right : Text, Integer -> Text
  pad-right (s) (width) =
    if text-length s >= width then s
    else pad-right (s & " ") width

  pad-left : Text, Integer -> Text
  pad-left (s) (width) =
    if text-length s >= width then s
    else pad-left (" " & s) width

  format-column : Text, Integer -> Text
  format-column (s) (width) = pad-right s width

  format-number : Integer, Integer -> Text
  format-number (n) (width) = pad-left (show n) width

