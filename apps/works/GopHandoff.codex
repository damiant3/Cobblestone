Chapter: GopHandoff

 We say:

Section: Block

  handoff-base : Integer = 126976

  handoff-magic : Integer = 5063257923364865091

  handoff-present : Integer -> Boolean
  handoff-present (dummy) = peek-qword handoff-base 0 == handoff-magic

  handoff-fb-base : Integer -> Integer
  handoff-fb-base (dummy) =
    if handoff-present 0 then peek-qword handoff-base 16
    else 0

  handoff-w : Integer -> Integer
  handoff-w (dummy) = bit-and (peek-qword handoff-base 24) 4294967295

  handoff-h : Integer -> Integer
  handoff-h (dummy) = bit-shru (peek-qword handoff-base 24) 32

  handoff-stride : Integer -> Integer
  handoff-stride (dummy) = bit-and (peek-qword handoff-base 32) 4294967295

  handoff-version : Integer -> Integer
  handoff-version (dummy) = if handoff-present 0 then bit-and (peek-qword handoff-base 8) 4294967295 else 0

  handoff-has-v2 : Integer -> Boolean
  handoff-has-v2 (dummy) = handoff-version 0 >= 2

  handoff-smbios3 : Integer -> Integer
  handoff-smbios3 (dummy) = if handoff-has-v2 0 then peek-qword handoff-base 48 else 0

  handoff-smbios2 : Integer -> Integer
  handoff-smbios2 (dummy) = if handoff-has-v2 0 then peek-qword handoff-base 56 else 0

  handoff-edid-size : Integer -> Integer
  handoff-edid-size (dummy) = if handoff-has-v2 0 then bit-and (peek-qword handoff-base 64) 4294967295 else 0

  handoff-edid-base : Integer = handoff-base + 72

  handoff-has-v3 : Integer -> Boolean
  handoff-has-v3 (dummy) = handoff-version 0 >= 3

  handoff-gop-maxmode : Integer -> Integer
  handoff-gop-maxmode (dummy) = if handoff-has-v3 0 then bit-and (peek-qword handoff-base 200) 4294967295 else 0

  handoff-gop-mode-before : Integer -> Integer
  handoff-gop-mode-before (dummy) = if handoff-has-v3 0 then bit-shru (peek-qword handoff-base 200) 32 else 0

  handoff-gop-mode-chosen : Integer -> Integer
  handoff-gop-mode-chosen (dummy) = if handoff-has-v3 0 then bit-and (peek-qword handoff-base 208) 4294967295 else 0

  handoff-gop-flag-ran : Integer = 1
  handoff-gop-flag-called : Integer = 2

  handoff-gop-flags : Integer -> Integer
  handoff-gop-flags (dummy) = if handoff-has-v3 0 then bit-shru (peek-qword handoff-base 208) 32 else 0

  handoff-gop-ran : Integer -> Boolean
  handoff-gop-ran (dummy) = bit-and (handoff-gop-flags 0) handoff-gop-flag-ran /= 0

  handoff-gop-called : Integer -> Boolean
  handoff-gop-called (dummy) = bit-and (handoff-gop-flags 0) handoff-gop-flag-called /= 0

  handoff-gop-status : Integer -> Integer
  handoff-gop-status (dummy) = if handoff-has-v3 0 then peek-qword handoff-base 216 else 0
Section: Boot Framebuffer

  boot-fb-base : Integer -> Integer
  boot-fb-base (dummy) = handoff-fb-base 0

  boot-fb-w : Integer -> Integer
  boot-fb-w (dummy) = handoff-w 0

  boot-fb-h : Integer -> Integer
  boot-fb-h (dummy) = handoff-h 0

  boot-fb-stride : Integer -> Integer
  boot-fb-stride (dummy) = handoff-stride 0
