 We say:

Section: Field

  GtField = record {
    gf-base : Integer,
    gf-stride : Integer,
    gf-font : CbfFont,
    gf-x : Integer,
    gf-y : Integer,
    gf-wchars : Integer,
    gf-scale : Integer,
    gf-fg : Integer,
    gf-bg : Integer,
    gf-cursor : Integer,
    gf-masked : Boolean
  }

Section: Drawing

  gt-draw : GtField, Text -> Integer
  gt-draw (f) (buf) =
    let cw = 8 * f.gf-scale
    in let ch = 16 * f.gf-scale
    in let clear = gop-fill-rect f.gf-base f.gf-stride f.gf-x f.gf-y ((f.gf-wchars + 1) * cw) ch f.gf-bg
    in let t = if f.gf-masked then gt-draw-mask f (text-length buf) 0
       else gop-draw-text f.gf-base f.gf-stride f.gf-font f.gf-x f.gf-y buf f.gf-fg f.gf-scale 0
    in gop-fill-rect f.gf-base f.gf-stride (f.gf-x + text-length buf * cw) f.gf-y cw ch f.gf-cursor

  gt-draw-mask : GtField, Integer, Integer -> Integer
  gt-draw-mask (f) (n) (i) =
    if i >= n then 0
    else let star = char-code (char-at "*" 0)
    in let d = gop-char-rows f.gf-base f.gf-stride f.gf-font (f.gf-x + i * 8 * f.gf-scale) f.gf-y star f.gf-fg f.gf-scale 0
    in gt-draw-mask f n (i + 1)

Section: Editing

 Extended keys arrive as an 0xE0 prefix (ignored as a break code by
 the layout) followed by a plain make code that collides with the
 numpad: an arrow key would otherwise type a digit. A single-line
 field has no cursor movement, so every navigation make code is
 simply ignored.

  gt-nav-key : Integer -> Boolean
  gt-nav-key (sc) =
    sc == 71 | sc == 72 | sc == 73 | sc == 75 | sc == 77 | sc == 79 | sc == 80 | sc == 81 | sc == 82 | sc == 83

  gt-apply : GtField, Text, KbEvent -> Text
  gt-apply (f) (buf) (ev) =
    if ev.pressed then gt-apply-pressed f buf ev else buf

  gt-apply-pressed : GtField, Text, KbEvent -> Text
  gt-apply-pressed (f) (buf) (ev) =
    if ev.scancode == 14 then gt-backspace f buf
    else if gt-nav-key (ev.scancode) then buf
    else if ev.ascii == 0 then buf
    else if text-length buf >= f.gf-wchars then buf
    else let nb = buf & char-to-text (code-to-char (ev.ascii))
    in let d = gt-draw f nb
    in nb

  gt-backspace : GtField, Text -> Text
  gt-backspace (f) (buf) =
    if text-length buf == 0 then buf
    else let nb = text-take buf (text-length buf - 1)
    in let d = gt-draw f nb
    in nb

Section: Input Loop

 The loop must be constant-stack and quiet-heap: it tail-calls ITSELF
 (the compiler's TCO handles direct self-recursion in act tails), and
 the idle path -- no byte waiting -- allocates nothing and touches no
 MMIO. Key events allocate one KbEvent, and printable keys one Text;
 both are bounded by keystrokes, not by polling. Enter (make code 28)
 returns the line. Programs hosting this loop compile with the pet
 flag, like every interactive poll loop on the boot path.

 Each key event also samples the HPET main counter (0xFED00000 + 0xF0,
 megahertz-rate) and the timer tick cell, folding them into an entropy
 accumulator the caller receives beside the text -- keystroke timing
 the machine cannot predict. On hardware without an HPET at the
 standard base the read degrades to a constant and the accumulator
 still carries the tick cell and scancode sequence.

  GtLine = record {
    gl-text : Text,
    gl-entropy : Integer between -9223372036854775808 and 9223372036854775807 wrapping
  }

  hpet-base : Integer = 4275044352

 A field that stops accepting keys used to leave a blank screen: the
 wizard paints its vitals from the WAIT loop, and this is not that loop,
 so the one screen where input can die silently was the one screen with
 no instrument. These two blocks are that instrument, and they are drawn
 rather than printed so nothing allocates on a poll that never returns.

 Left block alternates every gt-beat-mask polls. Blinking means this loop
 is still turning and the keyboard is delivering nothing; frozen means the
 loop itself stopped. Right block is red once the controller has been
 handed back to firmware, which on a machine with no legacy emulation is
 a one-way door and means no key can ever arrive again.

  gt-beat-mask : Integer = 65535

  gt-beat-live : Integer = 65280

  gt-beat-dark : Integer = 4210752

  gt-beat-released : Integer = 16711680

  gt-heartbeat : GtField, Integer, Integer -> Integer
  gt-heartbeat (f) (n) (rel) =
    let cw = 8 * f.gf-scale
    in let ch = 16 * f.gf-scale
    in let bx = f.gf-x + (f.gf-wchars + 2) * cw
    in let col = if bit-and (n / (gt-beat-mask + 1)) 1 == 0 then gt-beat-live else gt-beat-dark
    in let a = gop-fill-rect f.gf-base f.gf-stride bx f.gf-y cw ch col
    in let rcol = if rel /= 0 then gt-beat-released else gt-beat-dark
    in gop-fill-rect f.gf-base f.gf-stride (bx + 2 * cw) f.gf-y cw ch rcol

  gt-read-line : GtField, UsbKbd, Text, KbState, Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer -> [Device.Port, Device.Mmio] GtLine
  gt-read-line (f) (k) (buf) (st) (ent) (n) = act
    sc <- kbd-take k
    hp <- if sc == 0 then 0 else read-mmio hpet-base 240
    beat <- if bit-and n gt-beat-mask == 0 then gt-heartbeat f n (kbd-released 0) else 0
    if sc == 0 then gt-read-line f k buf st ent (n + 1)
    else if sc == 28 then GtLine { gl-text = buf, gl-entropy = ent }
    else let ev = kb-process-scancode st (__narrow sc)
    in gt-read-line f k (gt-apply f buf ev) (ev.state) (ent * 1099511628211 + hp * 31 + peek-qword 28672 0 + sc) (n + 1)
  end

  gt-input : GtField, UsbKbd -> [Device.Port, Device.Mmio] GtLine
  gt-input (f) (k) = act
    h0 <- read-mmio hpet-base 240
    d <- gt-draw f ""
    gt-read-line f k "" kb-state-new h0 0
  end
