 To vm-sweep gives VmSweepResult,
   running all samples and producing pass/fail/skip counts.

 We say:

Section: Types

  VmSweepResult = record {
    vsr-pass : Integer,
    vsr-fail : Integer,
    vsr-skip : Integer,
    vsr-total : Integer,
    vsr-results : List VmSampleResult
  }

  VmSampleResult = record {
    vsm-name : Text,
    vsm-verdict : SampleResult,
    vsm-output : Text
  }

Section: Single Sample

  vm-compile-and-run-sample : List Integer, Text, Integer -> [FileSystem.Read, Device.Block] VmSampleResult
  vm-compile-and-run-sample (seed-cdx) (source-path) (revision-id) = act
    let name = path-stem source-path
    in act
    entry <- classify-sample source-path name
    when entry.kind
      is Skipped -> VmSampleResult { vsm-name = name, vsm-verdict = SkippedResult, vsm-output = "" }
      is ExpectedFailure -> act
        source <- read-text source-path
        let result = vm-compile-cdx seed-cdx source revision-id
        in let eval = evaluate-failing (result.vcr-success) (entry.sidecar) (result.vcr-log)
        in VmSampleResult { vsm-name = name, vsm-verdict = eval, vsm-output = "" }
      end
      is ExpectedOutput -> act
        source <- read-text source-path
        let result = vm-compile-cdx seed-cdx source revision-id
        in if result.vcr-success == False then VmSampleResult { vsm-name = name, vsm-verdict = FailCompile, vsm-output = "" }
        else let run = vm-run-cdx (result.vcr-binary) revision-id
        in let eval = evaluate-expected (entry.sidecar) (run.vro-text)
        in VmSampleResult { vsm-name = name, vsm-verdict = eval, vsm-output = run.vro-text }
      end
      is CompileOnly -> act
        source <- read-text source-path
        let result = vm-compile-cdx seed-cdx source revision-id
        in if result.vcr-success then VmSampleResult { vsm-name = name, vsm-verdict = PassUnverified, vsm-output = "" }
        else VmSampleResult { vsm-name = name, vsm-verdict = FailCompile, vsm-output = "" }
      end
    end
  end

Section: Full Sweep

  vm-sweep : List Integer, Text, Integer -> [FileSystem.Read, Device.Block] VmSweepResult
  vm-sweep (seed-cdx) (test-dir) (revision-id) = act
    plan <- plan-sweep test-dir
    vm-sweep-loop seed-cdx (plan.samples) 0 (plan.sample-count) revision-id [] 0 0 0
  end

  vm-sweep-loop : List Integer, List SampleEntry, Integer, Integer, Integer, List VmSampleResult, Integer, Integer, Integer -> [FileSystem.Read, Device.Block] VmSweepResult
  vm-sweep-loop (seed) (samples) (i) (len) (rev) (results) (pass) (fail) (skip) =
    if i >= len then VmSweepResult { vsr-pass = pass, vsr-fail = fail, vsr-skip = skip, vsr-total = len, vsr-results = results }
    else let entry = list-at samples i
    in act
    r <- vm-compile-and-run-sample seed (entry.source-path) rev
    let new-results = list-push results r
    in let is-pass = when r.vsm-verdict
      is PassVerified -> True
      is PassUnverified -> True
      is PassFailing -> True
      is otherwise -> False
    in let is-skip = when r.vsm-verdict
      is SkippedResult -> True
      is otherwise -> False
    in let np = if is-pass then pass + 1 else pass
    in let nf = if is-pass == False & is-skip == False then fail + 1 else fail
    in let ns = if is-skip then skip + 1 else skip
    in vm-sweep-loop seed samples (i + 1) len rev new-results np nf ns
    end

Section: Result Formatting

  format-sweep-result : VmSweepResult -> Text
  format-sweep-result (r) =
    "total=" & show (r.vsr-total) & "  pass=" & show (r.vsr-pass) & "  fail=" & show (r.vsr-fail) & "  skip=" & show (r.vsr-skip)

