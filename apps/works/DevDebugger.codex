 Interactive debugger for the UEFI dev console. Memory inspector,
 port I/O probe, breakpoint table, stack walker, and perf counters.
 Operates on the live system — no GDB, no host-side tooling.

 We say:

Section: Debugger Mode

  DebugMode =
    | DebugMemory
    | DebugIO
    | DebugBreakpoints
    | DebugStack
    | DebugPerf
    | DebugRegisters

Section: Breakpoint

  Breakpoint = record {
    id : Integer,
    address : Integer,
    original-byte : Integer,
    enabled : Boolean,
    hit-count : Integer,
    label : Text
  }

  BreakpointTable = record {
    entries : List Breakpoint,
    next-id : Integer
  }

  bp-table-empty : BreakpointTable = BreakpointTable { entries = [], next-id = 1 }

  bp-add : BreakpointTable, Integer, Text -> BreakpointTable
  bp-add (tbl) (addr) (label) =
    let orig = peek-byte addr 0
    in let bp = Breakpoint { id = tbl.next-id, address = addr, original-byte = orig, enabled = True, hit-count = 0, label = label }
    in let w = poke-byte addr 0 204
    in BreakpointTable { entries = list-snoc (tbl.entries) bp, next-id = tbl.next-id + 1 }

  bp-remove : BreakpointTable, Integer -> BreakpointTable
  bp-remove (tbl) (id) =
    BreakpointTable { entries = bp-filter (tbl.entries) id 0 (list-length (tbl.entries)) [], next-id = tbl.next-id }

  bp-filter : List Breakpoint, Integer, Integer, Integer, List Breakpoint -> List Breakpoint
  bp-filter (bps) (remove-id) (i) (len) (acc) =
    if i >= len then acc
    else let bp = list-at bps i
    in if bp.id == remove-id then
      let w = poke-byte (bp.address) 0 (bp.original-byte)
      in bp-filter bps remove-id (i + 1) len acc
    else bp-filter bps remove-id (i + 1) len (list-push acc bp)

Section: Debugger State

  DebuggerState = record {
    mode : DebugMode,
    breakpoints : BreakpointTable,
    last-address : Integer,
    dump-length : Integer,
    watch-ports : List Integer,
    status : Text,
    map1 : Maybe Map1Info
  }

  debugger-init : DebuggerState
  debugger-init = DebuggerState {
    mode = DebugMemory,
    breakpoints = bp-table-empty,
    last-address = 1048576,
    dump-length = 256,
    watch-ports = [],
    status = "Debugger ready",
    map1 = None
  }

