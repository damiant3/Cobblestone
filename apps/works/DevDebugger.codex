 Interactive debugger for the UEFI dev console. Memory inspector,
 port I/O probe, breakpoint table, stack walker, and perf counters.
 Operates on the live system — no GDB, no host-side tooling.

 We say:

Section: Debugger Mode

  DebugMode =
    | DebugMemory
    | DebugIO
    | DebugBreakpoints
    | DebugStack
    | DebugPerf
    | DebugRegisters

Section: Breakpoint

  Breakpoint = record {
    id : Integer,
    address : Integer,
    original-byte : Integer,
    enabled : Boolean,
    hit-count : Integer,
    label : Text
  }

  BreakpointTable = record {
    entries : List Breakpoint,
    next-id : Integer
  }

  bp-table-empty : BreakpointTable = BreakpointTable { entries = [], next-id = 1 }

  bp-add : BreakpointTable, Integer, Text -> BreakpointTable
  bp-add (tbl) (addr) (label) =
    let orig = peek-byte addr 0
    in let bp = Breakpoint { id = tbl.next-id, address = addr, original-byte = orig, enabled = True, hit-count = 0, label = label }
    in let w = poke-byte addr 0 204
    in BreakpointTable { entries = list-snoc (tbl.entries) bp, next-id = tbl.next-id + 1 }

  bp-remove : BreakpointTable, Integer -> BreakpointTable
  bp-remove (tbl) (id) =
    BreakpointTable { entries = bp-filter (tbl.entries) id 0 (list-length (tbl.entries)) [], next-id = tbl.next-id }

  bp-filter : List Breakpoint, Integer, Integer, Integer, List Breakpoint -> List Breakpoint
  bp-filter (bps) (remove-id) (i) (len) (acc) =
    if i >= len then acc
    else let bp = list-at bps i
    in if bp.id == remove-id then
      let w = poke-byte (bp.address) 0 (bp.original-byte)
      in bp-filter bps remove-id (i + 1) len acc
    else bp-filter bps remove-id (i + 1) len (list-push acc bp)

Section: Debugger State

  DebuggerState = record {
    mode : DebugMode,
    breakpoints : BreakpointTable,
    last-address : Integer,
    dump-length : Integer,
    watch-ports : List Integer,
    status : Text,
    map1 : Maybe Map1Info
  }

  debugger-init : DebuggerState
  debugger-init = DebuggerState {
    mode = DebugMemory,
    breakpoints = bp-table-empty,
    last-address = 1048576,
    dump-length = 256,
    watch-ports = [],
    status = "Debugger ready",
    map1 = None
  }

Section: Debugger Menu

  debug-menu : MenuState
  debug-menu = menu-new "Debugger" [
    menu-item "Memory Dump" "mem",
    menu-item "Memory Read (byte/word/dword/qword)" "read",
    menu-item "Memory Write" "write",
    menu-item "Port I/O" "io",
    menu-item "Breakpoints" "bp",
    menu-item "Add Breakpoint (by name)" "bp-add",
    menu-item "Stack Walk" "stack",
    menu-item "Backtrace" "bt",
    menu-item "Perf Counters" "perf",
    menu-item "Symbol Lookup" "sym",
    menu-item "Address Lookup" "addr",
    menu-item "Back" "back"
  ]

Section: Memory Commands

  debug-mem-dump : DebuggerState, Integer, Integer -> List Text
  debug-mem-dump (dbg) (addr) (len) =
    debug-dump-lines addr len 0 []

  debug-dump-lines : Integer, Integer, Integer, List Text -> List Text
  debug-dump-lines (addr) (len) (off) (acc) =
    if off >= len then acc
    else let line-bytes = if len - off >= 16 then 16 else len - off
    in let hex-part = dump-hex-bytes addr off line-bytes 0 ""
    in let ascii-part = dump-ascii-bytes addr off line-bytes 0 ""
    in let line = hex-i64 (addr + off) & "  " & hex-part & " |" & ascii-part & "|"
    in debug-dump-lines addr len (off + 16) (list-push acc line)

  dump-hex-bytes : Integer, Integer, Integer, Integer, Text -> Text
  dump-hex-bytes (base) (off) (count) (i) (acc) =
    if i >= 16 then acc
    else if i >= count then dump-hex-bytes base off count (i + 1) (acc & "   ")
    else let b = peek-byte base (off + i)
    in let sep = if i == 8 then "  " else " "
    in dump-hex-bytes base off count (i + 1) (acc & hex-byte b & sep)

  dump-ascii-bytes : Integer, Integer, Integer, Integer, Text -> Text
  dump-ascii-bytes (base) (off) (count) (i) (acc) =
    if i >= count then acc
    else let b = peek-byte base (off + i)
    in let ch = if b >= 32 then if b < 127 then char-to-text (code-to-char b) else "." else "."
    in dump-ascii-bytes base off count (i + 1) (acc & ch)

Section: Symbol Lookup

  debug-sym-lookup : SourceIndex, Text -> Text
  debug-sym-lookup (idx) (query) =
    let results = search-by-prefix idx query
    in if list-length results == 0 then "No symbols matching '" & query & "'"
    else format-search-results results

Section: MAP1 Debug Map

  Map1Info = record {
    base : Integer,
    count : Integer,
    strings-base : Integer
  }

  map1-magic-le : Integer = 826361677

  map1-find : Maybe Map1Info
  map1-find =
    map1-scan 1048576 5242880

  map1-scan : Integer, Integer -> Maybe Map1Info
  map1-scan (addr) (limit) =
    if addr >= limit then None
    else let word = peek-32 addr 0
    in if word == map1-magic-le then map1-validate addr
    else map1-scan (addr + 4) limit

  map1-validate : Integer -> Maybe Map1Info
  map1-validate (addr) =
    let count = peek-32 addr 4
    in let str-off = peek-32 addr 8
    in if count > 0 then if count < 100000 then if str-off == 12 + count * 12
       then Just (Map1Info { base = addr, count = count, strings-base = addr + str-off })
       else None
       else None
    else None

  Map1Entry = record {
    code-offset : Integer,
    code-size : Integer,
    name-offset : Integer
  }

  map1-read-entry : Integer, Integer -> Map1Entry
  map1-read-entry (base) (i) =
    let addr = base + 12 + i * 12
    in Map1Entry { code-offset = peek-32 addr 0, code-size = peek-32 addr 4, name-offset = peek-32 addr 8 }

  map1-lookup : Map1Info, Integer -> Maybe Map1Entry
  map1-lookup (info) (target) =
    map1-bsearch info target 0 (info.count)

  map1-bsearch : Map1Info, Integer, Integer, Integer -> Maybe Map1Entry
  map1-bsearch (info) (target) (lo) (hi) =
    if lo >= hi then None
    else let mid = lo + (hi - lo) / 2
    in let entry = map1-read-entry (info.base) mid
    in if target < entry.code-offset then map1-bsearch info target lo mid
    else if target >= entry.code-offset + entry.code-size then map1-bsearch info target (mid + 1) hi
    else Just entry

  map1-read-name : Map1Info, Integer -> Text
  map1-read-name (info) (name-off) =
    map1-read-chars (info.strings-base + name-off) 0 ""

  map1-read-chars : Integer, Integer, Text -> Text
  map1-read-chars (addr) (i) (acc) =
    let b = peek-byte addr i
    in if b == 0 then acc
    else if i > 200 then acc
    else map1-read-chars addr (i + 1) (acc & char-to-text (code-to-char b))

  resolve-addr : DebuggerState, Integer -> Text
  resolve-addr (dbg) (rip) =
    let info = when (dbg.map1)
      is Just (m) -> Just m
      is None -> map1-find
    in when info
      is None -> "<no debug info>"
      is Just (m) ->
        let target = rip - 1048576
        in when (map1-lookup m target)
          is None -> "<unknown 0x" & hex-i64 rip & ">"
          is Just (entry) ->
            let name = map1-read-name m (entry.name-offset)
            in let off = target - entry.code-offset
            in name & "+0x" & hex-i32 off

Section: Symbolic Breakpoints

  map1-find-by-name : Map1Info, Text -> Maybe Map1Entry
  map1-find-by-name (info) (name) =
    map1-name-scan info name 0 (info.count)

  map1-name-scan : Map1Info, Text, Integer, Integer -> Maybe Map1Entry
  map1-name-scan (info) (name) (i) (count) =
    if i >= count then None
    else let entry = map1-read-entry (info.base) i
    in let entry-name = map1-read-name info (entry.name-offset)
    in if entry-name == name then Just entry
    else map1-name-scan info name (i + 1) count

  bp-add-symbolic : DebuggerState, Text -> DebuggerState
  bp-add-symbolic (dbg) (name) =
    let info = when (dbg.map1)
      is Just (m) -> Just m
      is None -> map1-find
    in let dbg1 = when info is Just (m) -> __record-set dbg "map1" (Just m) is None -> dbg
    in when info
      is None -> __record-set dbg1 "status" "No debug map found"
      is Just (m) ->
        when map1-find-by-name m name
          is None -> __record-set dbg1 "status" ("Symbol not found: " & name)
          is Just (entry) ->
            let addr = 1048576 + entry.code-offset
            in let tbl = bp-add (dbg1.breakpoints) addr name
            in let d2 = __record-set dbg1 "breakpoints" tbl
            in __record-set d2 "status" ("Breakpoint #" & show (tbl.next-id - 1) & " at " & name & " (0x" & hex-i64 addr & ")")

  bp-list-text : BreakpointTable -> List Text
  bp-list-text (tbl) =
    if list-length (tbl.entries) == 0 then ["  (no breakpoints)"]
    else bp-list-format (tbl.entries) 0 (list-length (tbl.entries)) []

  bp-list-format : List Breakpoint, Integer, Integer, List Text -> List Text
  bp-list-format (bps) (i) (len) (acc) =
    if i >= len then acc
    else let bp = list-at bps i
    in let en = if bp.enabled then "ON " else "OFF"
    in let line = "  #" & show (bp.id) & " " & en & " 0x" & hex-i64 (bp.address) & " hits=" & show (bp.hit-count) & " " & bp.label
    in bp-list-format bps (i + 1) len (list-push acc line)

Section: Exception Info

  debug-exc-addr : Integer = 28928
  debug-exc-vector-off : Integer = 0
  debug-exc-rip-off : Integer = 8
  debug-exc-rsp-off : Integer = 16
  debug-exc-flags-off : Integer = 24

  debug-read-exc-vector : Integer = peek-qword debug-exc-addr debug-exc-vector-off
  debug-read-exc-rip : Integer = peek-qword debug-exc-addr debug-exc-rip-off
  debug-read-exc-rsp : Integer = peek-qword debug-exc-addr debug-exc-rsp-off

Section: Backtrace

  debug-backtrace : DebuggerState, Integer, Integer -> List Text
  debug-backtrace (dbg) (rsp) (max-frames) =
    debug-bt-walk dbg rsp max-frames 0 []

  debug-bt-walk : DebuggerState, Integer, Integer, Integer, List Text -> List Text
  debug-bt-walk (dbg) (rsp) (max) (depth) (acc) =
    if depth >= max then acc
    else if rsp == 0 then acc
    else if rsp >= 2147483648 then acc
    else let ret-addr = peek-qword rsp 0
    in if ret-addr == 0 then acc
    else let sym = resolve-addr dbg ret-addr
    in let line = "  #" & show depth & " 0x" & hex-i64 ret-addr & " " & sym
    in debug-bt-walk dbg (rsp + 8) max (depth + 1) (list-push acc line)

  debug-backtrace-from-exc : DebuggerState -> List Text
  debug-backtrace-from-exc (dbg) =
    let rsp = debug-read-exc-rsp
    in let rip = debug-read-exc-rip
    in let rip-sym = resolve-addr dbg rip
    in let header = "  => 0x" & hex-i64 rip & " " & rip-sym
    in [header] & debug-backtrace dbg rsp 16

Section: Register View

  debug-register-view : List Text
  debug-register-view =
    let rip = debug-read-exc-rip
    in let rsp = debug-read-exc-rsp
    in let vec = debug-read-exc-vector
    in ["  Registers (from last exception):",
        "  RIP = 0x" & hex-i64 rip,
        "  RSP = 0x" & hex-i64 rsp,
        "  Vector = " & show vec]

Section: Perf View

  debug-perf-view : List Text
  debug-perf-view =
    let hpet-lo = peek-32 4275830784 240
    in let hpet-hi = peek-32 4275830784 244
    in ["  Performance Counters:",
        "  HPET counter = 0x" & hex-i32 hpet-hi & hex-i32 hpet-lo]

Section: Port Watch

  debug-port-watch : List Integer -> List Text
  debug-port-watch (ports) = debug-port-watch-loop ports 0 (list-length ports) []

  debug-port-watch-loop : List Integer, Integer, Integer, List Text -> List Text
  debug-port-watch-loop (ports) (i) (len) (acc) =
    if i >= len then acc
    else let port = list-at ports i
    in let val = port-in-byte port
    in let line = "port 0x" & hex-i32 port & " = 0x" & hex-byte val & " (" & show val & ")"
    in debug-port-watch-loop ports (i + 1) len (list-push acc line)

