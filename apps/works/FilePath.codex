Chapter: FilePath
  cites Foreword chapter Maybe

 Path manipulation for the Codex build environment. Pure functions
 over Text — no I/O, no platform-specific logic. Paths use forward
 slashes internally; conversion to platform format happens at the
 I/O boundary.

 We say:

Section: Components

  path-join : Text, Text -> Text
  path-join (base) (child) =
    if text-length base == 0 then child
    else if text-length child == 0 then base
    else base & "/" & child

  path-dir : Text -> Text
  path-dir (p) =
    let parts = text-split p "/"
    in let len = list-length parts
    in if len <= 1 then "."
    else path-join-parts parts 0 (len - 1) ""

  path-filename : Text -> Text
  path-filename (p) =
    let parts = text-split p "/"
    in let len = list-length parts
    in if len == 0 then ""
    else list-at parts (len - 1)

  path-stem : Text -> Text
  path-stem (p) =
    let name = path-filename p
    in let parts = text-split name "."
    in if list-length parts <= 1 then name
    else list-at parts 0

  path-extension : Text -> Text
  path-extension (p) =
    let name = path-filename p
    in let parts = text-split name "."
    in let len = list-length parts
    in if len <= 1 then ""
    else "." & list-at parts (len - 1)

  path-join-parts : List Text, Integer, Integer, Text -> Text
  path-join-parts (parts) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else "/"
    in path-join-parts parts (i + 1) len (acc & sep & list-at parts i)

Section: Sidecar Paths

  path-with-extension : Text, Text -> Text
  path-with-extension (p) (ext) =
    let stem = path-dir p & "/" & path-stem p
    in stem & ext

  path-expected : Text -> Text
  path-expected (source) = path-with-extension source ".expected"

  path-failing : Text -> Text
  path-failing (source) = path-with-extension source ".failing"

  path-skip : Text -> Text
  path-skip (source) = path-with-extension source ".skip"

Section: Directory Listing

  list-codex-files : Text -> List Text
  list-codex-files (dir) = list-files dir ".codex"

