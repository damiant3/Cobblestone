Section: Color Scheme
  vga-sh-hdr : Integer between 0 and 255 = __narrow (vga-attr vga-white vga-blue)
  vga-sh-body : Integer between 0 and 255 = __narrow (vga-attr vga-light-gray vga-black)
  vga-sh-ok : Integer between 0 and 255 = __narrow (vga-attr vga-light-green vga-black)
  vga-sh-prompt : Integer between 0 and 255 = __narrow (vga-attr vga-light-green vga-black)
  vga-sh-input : Integer between 0 and 255 = __narrow (vga-attr vga-white vga-black)
  vga-sh-output : Integer between 0 and 255 = __narrow (vga-attr vga-cyan vga-black)
  vga-sh-error : Integer between 0 and 255 = __narrow (vga-attr vga-light-red vga-black)

Section: Boot Banner
  vga-sh-banner : VgaCursor -> VgaCursor
  vga-sh-banner (cur) =
    let clr = vga-clear vga-sh-body
    in let h = vga-clear-row 0 vga-sh-hdr
    in let w1 = vga-put-text 0 1 "Cobblestone" vga-sh-hdr
    in let w2 = vga-put-text 0 64 "bare-metal x86-64" vga-sh-hdr
    in let cur1 = VgaCursor { row = 2, col = 0, attr = vga-sh-ok }
    in let cur2 = vga-cursor-write-line cur1 "  Boot complete. Shell ready."
    in VgaCursor { row = cur2.row + 1, col = 0, attr = vga-sh-body }

Section: Prompt Drawing
  vga-sh-draw-prompt : VgaCursor -> VgaCursor
  vga-sh-draw-prompt (cur) =
    let cur1 = vga-cursor-write-text (VgaCursor { row = cur.row, col = 0, attr = vga-sh-prompt }) "codex"
    in let cur2 = vga-cursor-write-text cur1 "> "
    in VgaCursor { row = cur2.row, col = cur2.col, attr = vga-sh-input }

Section: Shell REPL with VGA
  vga-sh-repl : ShellState, BinaryStore, VgaCursor -> [Console, Identity] Nothing
  vga-sh-repl (state) (bs) (cur) = act
    let cur1 = vga-sh-draw-prompt cur
    in print-line-uni ">"
    input <- read-line
    when input
     is Just (line) ->
      let cur2 = vga-cursor-write-text (VgaCursor { row = cur1.row, col = cur1.col, attr = vga-sh-input }) line
      in let cur3 = vga-cursor-newline cur2
      in let pr = parse-command line
      in when pr
        is ParseError (msg) ->
          let out = "? " & msg
          in let cur4 = vga-cursor-write-line (VgaCursor { row = cur3.row, col = 0, attr = vga-sh-error }) out
          in act
            print-line-uni out
            vga-sh-repl state bs cur4
          end
        is ParseOk (cmd) -> act
          dr <- dispatch cmd state bs
          vga-sh-continue dr bs cur3
        end
     is None -> print-line-uni "eof"
  end

  vga-sh-continue : DispatchResult, BinaryStore, VgaCursor -> [Console, Identity] Nothing
  vga-sh-continue (dr) (bs) (cur3) =
    let out-attr = if dr.running then vga-sh-output else vga-sh-body
    in let cur4 = vga-cursor-write-line (VgaCursor { row = cur3.row, col = 0, attr = out-attr }) (dr.output)
    in if dr.running then act
      print-line-uni (dr.output)
      vga-sh-repl (dr.new-state) bs cur4
    end
    else print-line-uni (dr.output)

Section: Entry Point
  vga-sh-start : ShellState, BinaryStore -> [Console, Identity] Nothing
  vga-sh-start (state) (bs) =
    let cur = vga-sh-banner (vga-cursor-new vga-sh-body)
    in vga-sh-repl state bs cur

