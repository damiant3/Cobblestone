Section: Modifier Tracking

  gbr-mod-shift : Integer = 1
  gbr-mod-ctrl : Integer = 2
  gbr-mod-alt : Integer = 4

  gbr-is-mod : Integer -> Boolean
  gbr-is-mod (sc) =
    sc == 29 | sc == 157 | sc == 42 | sc == 170 | sc == 54 | sc == 182 | sc == 56 | sc == 184

  gbr-mods : Integer, Integer -> Integer
  gbr-mods (mods) (sc) =
    if sc == 29 then bit-or mods gbr-mod-ctrl
    else if sc == 157 then bit-and mods 5
    else if sc == 42 then bit-or mods gbr-mod-shift
    else if sc == 54 then bit-or mods gbr-mod-shift
    else if sc == 170 then bit-and mods 6
    else if sc == 182 then bit-and mods 6
    else if sc == 56 then bit-or mods gbr-mod-alt
    else if sc == 184 then bit-and mods 3
    else mods

Section: Pane

  gbr-repaint : Integer, Integer, Integer, Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, BrowserState -> BrowserState
  gbr-repaint (base) (x) (y) (w) (h) (stride) (rows) (font) (tf) (mouse) (cs) (s) (st) =
    let hd = cursor-hide cs base stride
    in let fit = browser-scroll-fit st (w / s) (h / s)
    in let frame = __heap-save
    in let th = fit.bs-theme
    in let laid = widget-layout (browser-render fit) th (layout-rect (x / s) (y / s) (w / s) (h / s))
    in let d = gbr-paint base stride rows (layout-rect x y w h) font tf laid th s (browser-scroll-offset fit)
    in let memo = browser-memo-laid fit laid frame
    in let cu = if mouse.um-ok then cursor-update cs base stride rows w h s (mouse-x mouse) (mouse-y mouse) else 0
    in memo

  gbr-paint : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer, Integer -> Integer
  gbr-paint (base) (stride) (rows) (pane) (font) (tf) (laid) (th) (s) (off) =
    let mv = when browser-laid-viewport laid
      is None -> 0
      is Just (vp) -> comp-translate-kids (vp.wn-children) 0 (0 - off) 0
    in gbr-walk base stride rows pane font tf laid th s

  gbr-walk : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer -> Integer
  gbr-walk (base) (stride) (rows) (pane) (font) (tf) (laid) (th) (s) =
    when browser-laid-viewport laid
      is None -> comp-walk base stride rows pane font tf laid th s
      is Just (vp) ->
        let vclip = comp-clip pane (comp-mul-rect (vp.wn-bounds) s)
        in let d1 = comp-walk-except base stride rows pane font tf laid th s (vp.wn-id)
        in let d2 = comp-draw-node base stride rows vclip font tf vp th s
        in comp-walk-kids base stride rows vclip font tf (vp.wn-children) th 0 s

  gbr-show : Integer, Integer, Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, BrowserPane -> Integer
  gbr-show (base) (x) (y) (w) (h) (stride) (font) (tf) (s) (bp) =
    let st = bp.bp-st
    in when st.bs-laid
      is None -> 0
      is Just (laid) -> gbr-walk base stride h (layout-rect x y w h) font tf laid (st.bs-theme) s

Section: Step

  BrowserPane = record {
    bp-st : BrowserState,
    bp-mods : Integer
  }

  gbr-new : Integer, Integer -> [Device.Port] BrowserPane
  gbr-new (w) (h) =
    let st = browser-init w h browser-theme-default display-init-text-fallback
    in BrowserPane { bp-st = st, bp-mods = 0 }

  gbr-first-paint : Integer, Integer, Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, BrowserPane -> Integer
  gbr-first-paint (base) (x) (y) (w) (h) (stride) (font) (tf) (mouse) (cs) (s) (bp) =
    let shown = gbr-repaint base x y w h stride h font tf mouse cs s (bp.bp-st)
    in let k = __record-set bp "bp-st" shown
    in 0

  gbr-step : Integer, Integer, Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, BrowserPane, Integer, Boolean -> [Device.Port] Integer
  gbr-step (base) (x) (y) (w) (h) (stride) (font) (tf) (mouse) (cs) (s) (bp) (sc) (clicked) =
    let st = bp.bp-st
    in let mods = bp.bp-mods
    in if clicked then
      let mx = comp-hit-x (mouse-x mouse) s
      in let my = comp-hit-y (mouse-y mouse) s
      in let code = browser-click-code st mx my
      in let d = __heap-restore (st.bs-laid-mark)
      in let next = browser-apply-click st mx my code
      in let shown = gbr-repaint base x y w h stride h font tf mouse cs s next
      in let k = __record-set bp "bp-st" shown
      in 0 - 1
    else if sc == 0 then 1
    else if gbr-is-mod sc then
      let k = __record-set bp "bp-mods" (gbr-mods mods sc)
      in 1
    else if sc >= 128 then 1
    else
      let key = poll-key-decode sc mods
      in let d = __heap-restore (st.bs-laid-mark)
      in let next = browser-dispatch-event st (event-key-down key mods 0)
      in let shown = gbr-repaint base x y w h stride h font tf mouse cs s next
      in let k = __record-set bp "bp-st" shown
      in 0 - 1
