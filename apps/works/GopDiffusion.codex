Chapter: GopDiffusion
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter Theme
  cites UI chapter Dropdown
  cites UI chapter Validation
  cites UI chapter SettingsPanel
  cites UI chapter CommandPalette

Section: Options

  gdf-model-options : List Text
  gdf-model-options = ["realisticVision v6", "realisticVision v5.1", "cyberrealisticXL v4", "dreamshaperXL", "flux1-schnell-fp8"]

  gdf-sampler-options : List Text
  gdf-sampler-options = ["Euler", "Euler a", "DPM++ 2M", "DPM++ SDE", "DDIM"]

  gdf-vae-options : List Text
  gdf-vae-options = ["auto", "ae.safetensors", "none"]

  gdf-lora-options : List Text
  gdf-lora-options = ["none", "BookCover_Redmond", "pixel-art-xl", "papercut-xl", "wall_concept"]

  gdf-model-dropdown : DropdownState
  gdf-model-dropdown = dropdown-new "gdf-model" gdf-model-options

  gdf-sampler-dropdown : DropdownState
  gdf-sampler-dropdown = dropdown-with-selected "gdf-sampler" gdf-sampler-options 2

Section: Validation

  gdf-form : FormValidation
  gdf-form = form-validation [
    field-validation "width" [VrRequired, VrPattern "number", VrRange 64 2048],
    field-validation "height" [VrRequired, VrPattern "number", VrRange 64 2048],
    field-validation "steps" [VrRequired, VrPattern "number", VrRange 1 150],
    field-validation "seed" [VrPattern "number"]
  ]

Section: Settings

  gdf-settings-spec : SettingsSpec
  gdf-settings-spec =
    let spec = settings-spec "gdf-settings" "Generation Settings" [
      sf-dropdown-sel "model" "Model" gdf-model-options 0,
      sf-dropdown-sel "sampler" "Sampler" gdf-sampler-options 2,
      sf-slider "steps" "Steps" 20 1 50,
      sf-slider "cfg" "CFG Scale" 7 1 20,
      sf-number "width" "Width" 512,
      sf-number "height" "Height" 512,
      sf-number "seed" "Seed" 42,
      sf-sep,
      sf-heading "Post-Processing",
      sf-dropdown "vae" "VAE" gdf-vae-options,
      sf-dropdown "lora" "LoRA" gdf-lora-options,
      sf-slider "lora-wt" "LoRA Weight" 100 0 200,
      sf-toggle "hires" "Hires Fix" False
    ]
    in settings-with-validation spec gdf-form

Section: Command Palette

  gdf-palette : PaletteState
  gdf-palette = palette-new "gdf-pal" [
    palette-command "gen" "Generate" "Enter" "action" 1,
    palette-command "stop" "Stop" "Esc" "action" 2,
    palette-command "seed-rand" "Random seed" "r" "action" 3,
    palette-command "save" "Save image" "s" "action" 4,
    palette-command "model-next" "Next model" "m" "nav" 5,
    palette-command "sampler-next" "Next sampler" "n" "nav" 6
  ]

Section: Layout

  gdf-settings-w : Integer = 200
  gdf-steps : Integer = 20

Section: Screen

  gdf-tab : Integer, Text -> WidgetNode
  gdf-tab (i) (lbl) = widget-set-flex (widget-set-min (widget-button ("gdf-tab-" & show i) lbl) 80 20) 0

  gdf-tab-bar : Integer -> WidgetNode
  gdf-tab-bar (dummy) =
    widget-panel "gdf-tabs" DirRow 4 [
      gdf-tab 0 "txt2img",
      gdf-tab 1 "img2img",
      gdf-tab 2 "inpaint",
      gdf-tab 3 "upscale",
      widget-set-flex (widget-label "gdf-tab-pad" "") 1
    ]

  gdf-buttons : Integer -> WidgetNode
  gdf-buttons (dummy) =
    widget-panel "gdf-btns" DirRow 6 [
      widget-set-flex (widget-set-min (widget-button "gdf-gen" "Generate") 110 24) 0,
      widget-set-flex (widget-set-min (widget-button "gdf-stop" "Stop") 110 24) 0,
      widget-set-flex (widget-label "gdf-btn-pad" "") 1
    ]

  gdf-status : Integer -> WidgetNode
  gdf-status (step) =
    widget-panel "gdf-status" DirRow 8 [
      widget-set-flex (widget-label "gdf-stat" (if step > 0 then "Generating" else "Ready")) 1,
      widget-set-flex (widget-label "gdf-model-name" "model: realisticVision v6") 1,
      widget-set-flex (widget-label "gdf-gpu" "no accelerator") 1
    ]

  gdf-tree : Integer -> WidgetNode
  gdf-tree (step) =
    let caption = if step > 0 then "Generating " & show step & " of " & show gdf-steps else "No image yet"
    in widget-panel "gdf-root" DirColumn 6 [
      widget-set-min (gdf-tab-bar 0) 0 26,
      widget-label "gdf-lbl-prompt" "Prompt",
      widget-set-min (widget-input "gdf-prompt" "a yellow rubber duck floating on a pond" 0) 0 22,
      widget-label "gdf-lbl-neg" "Negative",
      widget-set-min (widget-input "gdf-neg" "blurry, low quality, deformed" 0) 0 22,
      widget-set-min (gdf-buttons 0) 0 26,
      widget-separator "gdf-sep",
      widget-label "gdf-preview-cap" caption,
      widget-label "gdf-hint" "Generate is not wired to anything yet -- see works-backlog WORKS-3",
      widget-set-flex (widget-panel "gdf-canvas" DirColumn 0 []) 1,
      widget-separator "gdf-sep2",
      gdf-status step
    ]
