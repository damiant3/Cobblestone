Chapter: GopSettings
  cites Works chapter GopFat16
  cites Foreword chapter Maybe

 We say:

Section: Kinds

  gst-kind-int : Integer = 0
  gst-kind-bool : Integer = 1
  gst-kind-text : Integer = 2

Section: The Schema

  SettingKey = record {
    sk-id : Integer,
    sk-name : Text,
    sk-kind : Integer,
    sk-default : Integer,
    sk-lo : Integer,
    sk-hi : Integer,
    sk-default-text : Text,
    sk-text-limit : Integer
  }

  SettingsStore = record {
    st-keys : List SettingKey,
    st-vals : List Integer,
    st-texts : List Text,
    st-count : Integer
  }

  SetResult =
    | SetOk (SettingsStore)
    | SetRefused (Text)

  SettingValue =
    | SettingInteger (Integer)
    | SettingBoolean (Boolean)
    | SettingText (Text)

  gst-int-key : Integer, Text, Integer, Integer, Integer -> SettingKey
  gst-int-key (id) (name) (dflt) (lo) (hi) =
    SettingKey { sk-id = id, sk-name = name, sk-kind = gst-kind-int, sk-default = dflt, sk-lo = lo, sk-hi = hi, sk-default-text = "", sk-text-limit = 0 }

  gst-bool-key : Integer, Text, Boolean -> SettingKey
  gst-bool-key (id) (name) (dflt) =
    SettingKey { sk-id = id, sk-name = name, sk-kind = gst-kind-bool, sk-default = if dflt then 1 else 0, sk-lo = 0, sk-hi = 1, sk-default-text = "", sk-text-limit = 0 }

  gst-text-key : Integer, Text, Text, Integer -> SettingKey
  gst-text-key (id) (name) (dflt) (limit) =
    SettingKey { sk-id = id, sk-name = name, sk-kind = gst-kind-text, sk-default = 0, sk-lo = 0, sk-hi = 0, sk-default-text = dflt, sk-text-limit = limit }

  gst-id-before : List SettingKey, Integer, Integer, Integer -> Boolean
  gst-id-before (keys) (id) (stop) (i) = if i >= stop then False else if (list-at keys i).sk-id == id then True else gst-id-before keys id stop (i + 1)

  gst-schema-why : List SettingKey, Integer -> Text
  gst-schema-why (keys) (i) =
    if list-length keys > gst-max-keys then "too many settings"
    else if i >= list-length keys then ""
    else let k = list-at keys i
    in if k.sk-id <= 0 | k.sk-name == "" then "setting needs a positive id and name"
    else if gst-id-before keys (k.sk-id) i 0 then "duplicate setting id: " & show (k.sk-id)
    else if k.sk-kind < gst-kind-int | k.sk-kind > gst-kind-text then "unknown setting type: " & k.sk-name
    else if k.sk-kind == gst-kind-text then
      if k.sk-text-limit < 0 | text-length (k.sk-default-text) > k.sk-text-limit then "invalid text default or limit: " & k.sk-name else gst-schema-why keys (i + 1)
    else if k.sk-lo > k.sk-hi | k.sk-default < k.sk-lo | k.sk-default > k.sk-hi then "invalid default or range: " & k.sk-name
    else if k.sk-kind == gst-kind-bool & (k.sk-lo /= 0 | k.sk-hi /= 1) then "invalid boolean range: " & k.sk-name
    else gst-schema-why keys (i + 1)

  gst-checked-store : List SettingKey -> SetResult
  gst-checked-store (keys) = let why = gst-schema-why keys 0 in if why == "" then SetOk (gst-store keys) else SetRefused why

  gst-defaults : List SettingKey, Integer, Integer, List Integer -> List Integer
  gst-defaults (keys) (i) (n) (acc) =
    if i >= n then acc
    else let k = list-at keys i
    in gst-defaults keys (i + 1) n (list-push acc (k.sk-default))

  gst-store : List SettingKey -> SettingsStore
  gst-store (keys) =
    let n = list-length keys
    in SettingsStore { st-keys = keys, st-vals = gst-defaults keys 0 n [], st-texts = gst-text-defaults keys 0 [], st-count = n }

  gst-text-defaults : List SettingKey, Integer, List Text -> List Text
  gst-text-defaults (keys) (i) (acc) = if i >= list-length keys then acc else gst-text-defaults keys (i + 1) (list-push acc ((list-at keys i).sk-default-text))

Section: Reading

  gst-index-of : SettingsStore, Integer, Integer -> Integer
  gst-index-of (s) (id) (i) =
    if i >= s.st-count then 0 - 1
    else let k = list-at (s.st-keys) i
    in if k.sk-id == id then i else gst-index-of s id (i + 1)

  gst-get : SettingsStore, Integer, Integer -> Integer
  gst-get (s) (id) (fallback) =
    let idx = gst-index-of s id 0
    in if idx < 0 then fallback else if (list-at (s.st-keys) idx).sk-kind == gst-kind-text then fallback else list-at (s.st-vals) idx

  gst-get-text : SettingsStore, Integer, Text -> Text
  gst-get-text (s) (id) (fallback) =
    let idx = gst-index-of s id 0
    in if idx < 0 then fallback else if (list-at (s.st-keys) idx).sk-kind /= gst-kind-text then fallback else list-at (s.st-texts) idx

  gst-value : SettingsStore, Integer -> Maybe SettingValue
  gst-value (s) (id) =
    let idx = gst-index-of s id 0
    in if idx < 0 then None
    else let k = list-at (s.st-keys) idx
    in if k.sk-kind == gst-kind-text then Just (SettingText (list-at (s.st-texts) idx))
    else if k.sk-kind == gst-kind-bool then Just (SettingBoolean (list-at (s.st-vals) idx /= 0))
    else Just (SettingInteger (list-at (s.st-vals) idx))

  gst-get-bool : SettingsStore, Integer, Boolean -> Boolean
  gst-get-bool (s) (id) (fallback) =
    gst-get s id (if fallback then 1 else 0) /= 0

Section: Writing

  gst-vals-with : SettingsStore, Integer, Integer, Integer, List Integer -> List Integer
  gst-vals-with (s) (idx) (v) (i) (acc) =
    if i >= s.st-count then acc
    else let cur = if i == idx then v else list-at (s.st-vals) i
    in gst-vals-with s idx v (i + 1) (list-push acc cur)

  gst-set : SettingsStore, Integer, Integer -> SetResult
  gst-set (s) (id) (v) =
    let idx = gst-index-of s id 0
    in if idx < 0 then SetRefused ("no such setting: " & show id)
    else let k = list-at (s.st-keys) idx
    in if k.sk-kind == gst-kind-text then SetRefused (k.sk-name & " requires text")
    else if v < k.sk-lo then SetRefused (k.sk-name & " rejects " & show v & ", low limit " & show (k.sk-lo))
    else if v > k.sk-hi then SetRefused (k.sk-name & " rejects " & show v & ", high limit " & show (k.sk-hi))
    else SetOk (__record-set s "st-vals" (gst-vals-with s idx v 0 []))

  gst-set-bool : SettingsStore, Integer, Boolean -> SetResult
  gst-set-bool (s) (id) (on) =
    let idx = gst-index-of s id 0
    in if idx < 0 then SetRefused ("no such setting: " & show id)
    else if (list-at (s.st-keys) idx).sk-kind /= gst-kind-bool then SetRefused ((list-at (s.st-keys) idx).sk-name & " is not boolean")
    else gst-set s id (if on then 1 else 0)

  gst-texts-with : SettingsStore, Integer, Text, Integer, List Text -> List Text
  gst-texts-with (s) (idx) (v) (i) (acc) = if i >= s.st-count then acc else gst-texts-with s idx v (i + 1) (list-push acc (if i == idx then v else list-at (s.st-texts) i))

  gst-set-text : SettingsStore, Integer, Text -> SetResult
  gst-set-text (s) (id) (v) =
    let idx = gst-index-of s id 0
    in if idx < 0 then SetRefused ("no such setting: " & show id)
    else let k = list-at (s.st-keys) idx
    in if k.sk-kind /= gst-kind-text then SetRefused (k.sk-name & " is not text")
    else if text-length v > k.sk-text-limit then SetRefused (k.sk-name & " exceeds text limit " & show (k.sk-text-limit))
    else SetOk (__record-set s "st-texts" (gst-texts-with s idx v 0 []))

  gst-set-value : SettingsStore, Integer, SettingValue -> SetResult
  gst-set-value (s) (id) (v) = when v
    is SettingText (t) -> gst-set-text s id t
    is SettingBoolean (b) -> gst-set-bool s id b
    is SettingInteger (n) ->
      let idx = gst-index-of s id 0
      in if idx < 0 then SetRefused ("no such setting: " & show id)
      else if (list-at (s.st-keys) idx).sk-kind /= gst-kind-int then SetRefused ((list-at (s.st-keys) idx).sk-name & " is not integer")
      else gst-set s id n

  gst-copy : SettingsStore -> SettingsStore
  gst-copy (s) = SettingsStore { st-keys = s.st-keys, st-vals = gst-vals-with s (0 - 1) 0 0 [], st-texts = gst-texts-with s (0 - 1) "" 0 [], st-count = s.st-count }

  gst-or-keep : SettingsStore, SetResult -> SettingsStore
  gst-or-keep (s) (r) = when r
    is SetOk (s2) -> s2
    is SetRefused (why) -> s

  gst-why : SetResult -> Text
  gst-why (r) = when r
    is SetOk (s2) -> ""
    is SetRefused (why) -> why

Section: Restoring A Default

  gst-reset : SettingsStore, Integer -> SetResult
  gst-reset (s) (id) =
    let idx = gst-index-of s id 0
    in if idx < 0 then SetRefused ("no such setting: " & show id)
    else let k = list-at (s.st-keys) idx
    in if k.sk-kind == gst-kind-text then gst-set-text s id (k.sk-default-text) else gst-set s id (k.sk-default)

  gst-reset-all : SettingsStore -> SettingsStore
  gst-reset-all (s) = gst-store (s.st-keys)

Section: The File

  gst-magic0 : Integer = 67
  gst-magic1 : Integer = 83
  gst-magic2 : Integer = 84
  gst-magic3 : Integer = 49

  gst-bias : Integer = 2147483648

  gst-hdr-bytes : Integer = 8
  gst-rec-bytes : Integer = 8
  gst-max-keys : Integer = 48
  gst-buf-bytes : Integer = 512

  gst-name-bytes : Integer, Text, Integer -> Integer
  gst-name-bytes (buf) (s) (i) =
    if i >= text-length s then 0
    else let w = poke-byte buf i (to-unicode (char-code (char-at s i)))
    in gst-name-bytes buf s (i + 1)

  gst-name : Integer
  gst-name =
    let b = __heap-save
    in let adv = __heap-advance 16
    in let w = gst-name-bytes b "SETTINGSDAT" 0
    in b

  gst-u16-at : Integer, Integer -> Integer
  gst-u16-at (buf) (off) =
    peek-byte buf off + bit-shl (peek-byte buf (off + 1)) 8

  gst-u32-at : Integer, Integer -> Integer
  gst-u32-at (buf) (off) =
    gst-u16-at buf off + bit-shl (gst-u16-at buf (off + 2)) 16

Section: Saving

  gst-put-recs : SettingsStore, Integer, Integer, Integer -> Integer
  gst-put-recs (s) (buf) (i) (off) =
    if i >= s.st-count then 0
    else let k = list-at (s.st-keys) i
    in let a = gfat-put-u32 buf off (k.sk-id)
    in let b = gfat-put-u32 buf (off + 4) (list-at (s.st-vals) i + gst-bias)
    in gst-put-recs s buf (i + 1) (off + gst-rec-bytes)

  gst-save : SettingsStore -> [Device.Port] Boolean
  gst-save (s) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then False
    else if s.st-count > gst-max-keys | gst-has-text (s.st-keys) 0 then False
    else
      let buf = __heap-save
      in let adv = __heap-advance gst-buf-bytes
      in let a = poke-byte buf 0 gst-magic0
      in let b = poke-byte buf 1 gst-magic1
      in let c = poke-byte buf 2 gst-magic2
      in let d = poke-byte buf 3 gst-magic3
      in let e = gfat-put-u16 buf 4 (s.st-count)
      in let f = poke-byte buf 6 0
      in let g = poke-byte buf 7 0
      in let h = gst-put-recs s buf 0 gst-hdr-bytes
      in gfat-write-small-file (m.gm-vol) gst-name buf (gst-hdr-bytes + gst-rec-bytes * s.st-count)
  end

  gst-has-text : List SettingKey, Integer -> Boolean
  gst-has-text (keys) (i) = if i >= list-length keys then False else if (list-at keys i).sk-kind == gst-kind-text then True else gst-has-text keys (i + 1)

Section: Loading

  gst-apply-rec : SettingsStore, Integer, Integer -> SettingsStore
  gst-apply-rec (s) (buf) (off) =
    let id = gst-u32-at buf off
    in let v = gst-u32-at buf (off + 4) - gst-bias
    in gst-or-keep s (gst-set s id v)

  gst-apply-recs : SettingsStore, Integer, Integer, Integer, Integer -> SettingsStore
  gst-apply-recs (s) (buf) (i) (n) (off) =
    if i >= n then s
    else gst-apply-recs (gst-apply-rec s buf off) buf (i + 1) n (off + gst-rec-bytes)

  gst-load : SettingsStore -> [Device.Port] SettingsStore
  gst-load (s) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then s
    else act
      f <- gfat-read-file (m.gm-vol) "SETTINGS.DAT"
      if f.gf-ok == False then s
      else if f.gf-len < gst-hdr-bytes then s
      else if peek-byte (f.gf-buf) 0 /= gst-magic0 then s
      else if peek-byte (f.gf-buf) 1 /= gst-magic1 then s
      else if peek-byte (f.gf-buf) 2 /= gst-magic2 then s
      else if peek-byte (f.gf-buf) 3 /= gst-magic3 then s
      else let n = gst-u16-at (f.gf-buf) 4
      in let avail = (f.gf-len - gst-hdr-bytes) / gst-rec-bytes
      in if n > avail then s
      else if n > gst-max-keys then s
      else gst-apply-recs s (f.gf-buf) 0 n gst-hdr-bytes
    end
  end

