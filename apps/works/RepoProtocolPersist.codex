Section: Annotation Persistence (Kind 35)

 Format: hash|chapter|path|kind-name|author|timestamp|body

  annotation-to-persist-text : Annotation -> Text
  annotation-to-persist-text (a) =
    let t = a.target
    in a.hash & "|" & t.chapter & "|" & t.path & "|"
    & annotation-kind-name a.kind & "|" & a.author & "|"
    & show a.timestamp & "|" & a.body

  annotation-from-persist-text : Text -> Maybe Annotation
  annotation-from-persist-text (line) =
    let parts = text-split line "|"
    in if list-length parts < 7 then None
    else let ann = Annotation {
      hash = list-at parts 0,
      target = AnnotationTarget {
        chapter = list-at parts 1,
        path = list-at parts 2
      },
      kind = parse-annotation-kind (list-at parts 3),
      author = list-at parts 4,
      timestamp = parse-decimal-full (list-at parts 5),
      body = list-at parts 6
    }
    in Just ann

  repo-persist-save-annotation : DiskFactStore, Annotation, Integer -> DiskFactStore
  repo-persist-save-annotation (store) (ann) (timestamp) =
    app-write-and-checkpoint store persist-kind-annotation (annotation-to-persist-text ann) timestamp

  repo-persist-load-last-annotation : DiskFactStore -> Maybe Annotation
  repo-persist-load-last-annotation (store) =
    let found = app-scan-last store persist-kind-annotation
    in when found
      is None -> None
      is Just (txt) -> annotation-from-persist-text txt

  repo-persist-load-all-annotations : DiskFactStore -> List Annotation
  repo-persist-load-all-annotations (store) =
    let texts = app-scan-all store persist-kind-annotation
    in parse-annotation-persist-list texts 0 (list-length texts) []

  parse-annotation-persist-list : List Text, Integer, Integer, List Annotation -> List Annotation
  parse-annotation-persist-list (texts) (i) (len) (acc) =
    if i >= len then acc
    else let parsed = annotation-from-persist-text (list-at texts i)
    in when parsed
      is Just (a) -> parse-annotation-persist-list texts (i + 1) len (list-push acc a)
      is None -> parse-annotation-persist-list texts (i + 1) len acc

Section: Proposal Persistence (Kind 36)

 Format: id|author-fp|chapter|path|timestamp|status-int|sig-hex|changed-csv|description|justification

  proposal-to-persist-text : Proposal -> Text
  proposal-to-persist-text (p) =
    let t = p.target
    in let status-int = proposal-status-to-int p.status
    in let sig-hex = bytes-to-hex p.signature
    in let defs-csv = join-with-comma p.changed-definitions 0 (list-length p.changed-definitions) ""
    in p.id & "|" & p.author-fingerprint & "|"
    & t.chapter & "|" & t.path & "|"
    & show p.timestamp & "|" & show status-int & "|"
    & sig-hex & "|" & defs-csv & "|"
    & p.description & "|" & p.justification

  proposal-from-persist-text : Text -> Maybe Proposal
  proposal-from-persist-text (line) =
    let parts = text-split line "|"
    in if list-length parts < 10 then None
    else let target = AnnotationTarget {
      chapter = list-at parts 2,
      path = list-at parts 3
    }
    in let prop = Proposal {
      id = list-at parts 0,
      author-fingerprint = list-at parts 1,
      target = target,
      description = list-at parts 8,
      justification = list-at parts 9,
      changed-definitions = split-comma (list-at parts 7),
      signature = hex-decode (list-at parts 6),
      timestamp = parse-decimal-full (list-at parts 4),
      status = int-to-proposal-status (parse-decimal-full (list-at parts 5))
    }
    in Just prop

  repo-persist-save-proposal : DiskFactStore, Proposal, Integer -> DiskFactStore
  repo-persist-save-proposal (store) (prop) (timestamp) =
    app-write-and-checkpoint store persist-kind-proposal (proposal-to-persist-text prop) timestamp

  repo-persist-load-last-proposal : DiskFactStore -> Maybe Proposal
  repo-persist-load-last-proposal (store) =
    let found = app-scan-last store persist-kind-proposal
    in when found
      is None -> None
      is Just (txt) -> proposal-from-persist-text txt

  repo-persist-load-all-proposals : DiskFactStore -> List Proposal
  repo-persist-load-all-proposals (store) =
    let texts = app-scan-all store persist-kind-proposal
    in parse-proposal-list texts 0 (list-length texts) []

  parse-proposal-list : List Text, Integer, Integer, List Proposal -> List Proposal
  parse-proposal-list (texts) (i) (len) (acc) =
    if i >= len then acc
    else let parsed = proposal-from-persist-text (list-at texts i)
    in when parsed
      is Just (p) -> parse-proposal-list texts (i + 1) len (list-push acc p)
      is None -> parse-proposal-list texts (i + 1) len acc

Section: Verdict Persistence (Kind 37)

 Format: id|proposal-id|author-fp|kind-int|amend-note|sig-hex|timestamp|reason

  verdict-to-persist-text : Verdict -> Text
  verdict-to-persist-text (v) =
    let kind-int = verdict-kind-to-int v.kind
    in let amend-note = when v.kind is Amend (note) -> note is otherwise -> ""
    in let sig-hex = bytes-to-hex v.signature
    in v.id & "|" & v.proposal-id & "|" & v.author-fingerprint & "|"
    & show kind-int & "|" & amend-note & "|"
    & sig-hex & "|" & show v.timestamp & "|" & v.reason

  verdict-from-persist-text : Text -> Maybe Verdict
  verdict-from-persist-text (line) =
    let parts = text-split line "|"
    in if list-length parts < 8 then None
    else let kind-int = parse-decimal-full (list-at parts 3)
    in let kind = if kind-int == 0 then Accept
      else if kind-int == 1 then Reject
      else if kind-int == 2 then Amend (list-at parts 4)
      else Abstain
    in let verd = Verdict {
      id = list-at parts 0,
      proposal-id = list-at parts 1,
      author-fingerprint = list-at parts 2,
      kind = kind,
      reason = list-at parts 7,
      signature = hex-decode (list-at parts 5),
      timestamp = parse-decimal-full (list-at parts 6)
    }
    in Just verd

  repo-persist-save-verdict : DiskFactStore, Verdict, Integer -> DiskFactStore
  repo-persist-save-verdict (store) (verd) (timestamp) =
    app-write-and-checkpoint store persist-kind-verdict (verdict-to-persist-text verd) timestamp

  repo-persist-load-last-verdict : DiskFactStore -> Maybe Verdict
  repo-persist-load-last-verdict (store) =
    let found = app-scan-last store persist-kind-verdict
    in when found
      is None -> None
      is Just (txt) -> verdict-from-persist-text txt

  repo-persist-load-all-verdicts : DiskFactStore -> List Verdict
  repo-persist-load-all-verdicts (store) =
    let texts = app-scan-all store persist-kind-verdict
    in parse-verdict-list texts 0 (list-length texts) []

  parse-verdict-list : List Text, Integer, Integer, List Verdict -> List Verdict
  parse-verdict-list (texts) (i) (len) (acc) =
    if i >= len then acc
    else let parsed = verdict-from-persist-text (list-at texts i)
    in when parsed
      is Just (v) -> parse-verdict-list texts (i + 1) len (list-push acc v)
      is None -> parse-verdict-list texts (i + 1) len acc

Section: Discussion Persistence (Kind 38)

 Format: hash|thread-id|author|timestamp|parent-hash|body

  post-to-persist-text : Post -> Text
  post-to-persist-text (p) =
    p.hash & "|" & p.thread-id & "|" & p.author & "|"
    & show p.timestamp & "|" & p.parent-hash & "|" & p.body

  post-from-persist-text : Text -> Maybe Post
  post-from-persist-text (line) =
    let parts = text-split line "|"
    in if list-length parts < 6 then None
    else let post = Post {
      hash = list-at parts 0,
      thread-id = list-at parts 1,
      author = list-at parts 2,
      body = list-at parts 5,
      timestamp = parse-decimal-full (list-at parts 3),
      parent-hash = list-at parts 4
    }
    in Just post

  repo-persist-save-post : DiskFactStore, Post, Integer -> DiskFactStore
  repo-persist-save-post (store) (post) (timestamp) =
    app-write-and-checkpoint store persist-kind-discussion (post-to-persist-text post) timestamp

  repo-persist-load-last-post : DiskFactStore -> Maybe Post
  repo-persist-load-last-post (store) =
    let found = app-scan-last store persist-kind-discussion
    in when found
      is None -> None
      is Just (txt) -> post-from-persist-text txt

  repo-persist-load-all-posts : DiskFactStore -> List Post
  repo-persist-load-all-posts (store) =
    let texts = app-scan-all store persist-kind-discussion
    in parse-post-list texts 0 (list-length texts) []

  parse-post-list : List Text, Integer, Integer, List Post -> List Post
  parse-post-list (texts) (i) (len) (acc) =
    if i >= len then acc
    else let parsed = post-from-persist-text (list-at texts i)
    in when parsed
      is Just (p) -> parse-post-list texts (i + 1) len (list-push acc p)
      is None -> parse-post-list texts (i + 1) len acc

