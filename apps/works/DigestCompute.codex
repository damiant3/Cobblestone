Chapter: DigestCompute
  cites Foreword chapter Sha256

 DigestCompute computes and formats digests for seed artifacts.
 DigestCompute replaces the manual Get-FileHash calls in the seed
 rebuild checklist with a Codex-native implementation.

 We say:

Section: Digest Record

  DigestRecord = record {
    path : Text,
    size : Integer,
    sha256 : Text
  }

  compute-digest : Text, List Integer -> DigestRecord
  compute-digest (path) (bytes) =
    DigestRecord {
      path = path,
      size = list-length bytes,
      sha256 = sha256-to-hex (sha256 bytes)
    }

Section: Formatting

  format-digest : DigestRecord -> Text
  format-digest (d) =
    d.path & "\n"
    & "  Size:   " & show (d.size) & " bytes\n"
    & "  SHA256: " & d.sha256

  format-digest-table : List DigestRecord -> Text
  format-digest-table (ds) = format-digest-table-loop ds 0 (list-length ds) ""

  format-digest-table-loop : List DigestRecord, Integer, Integer, Text -> Text
  format-digest-table-loop (ds) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else "\n"
    in format-digest-table-loop ds (i + 1) len (acc & sep & format-digest (list-at ds i))

Section: Comparison

  digests-match : DigestRecord, DigestRecord -> Boolean
  digests-match (a) (b) = a.sha256 == b.sha256

  verify-fixed-point : DigestRecord, DigestRecord -> Text
  verify-fixed-point (stage1) (stage2) =
    if digests-match stage1 stage2 then
      "FIXED POINT: " & show (stage1.size) & " bytes, byte-identical"
    else "DIVERGED: stage1=" & stage1.sha256 & " stage2=" & stage2.sha256

