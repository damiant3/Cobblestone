 CompilerDriver is the self-hosted compiler driver. CompilerDriver
 replaces the PS1 orchestration scripts (sample-compile-selfhost.ps1,
 pingpong-self.ps1, sweep.ps1) with Codex-native logic. The driver
 runs on the Codex OS — the compiler invokes itself via process-spawn
 to compile samples and verify the fixed point.

 On bare metal with the scheduler, a compile is just: spawn a
 process that reads source from a file, compiles the source, and
 writes the output binary. No QEMU, no TCP sockets, no PS1.

 We say:

Section: Compile Request

  CompileMode =
    | ModeCdx
    | ModeElf
    | ModeEfi
    | ModeImg

  CompileRequest = record {
    source-path : Text,
    output-path : Text,
    mode : CompileMode
  }

  compile-mode-string : CompileMode -> Text
  compile-mode-string (m) = when m
    is ModeCdx -> "CDX"
    is ModeElf -> "ELF"
    is ModeEfi -> "EFI"
    is ModeImg -> "IMG"

Section: Compile Result

  CompileResult = record {
    success : Boolean,
    output-path : Text,
    output-size : Integer,
    error-count : Integer,
    log : Text
  }

  compile-succeeded : CompileResult -> Boolean
  compile-succeeded (r) = r.success

  compile-failed : CompileResult -> Boolean
  compile-failed (r) = r.success == False

Section: Self-Compile

 The compiler compiling itself. Reads the source tree via
 SourceConcat, feeds the source to the compiler, and captures the
 output CDX. This is the core of pingpong.

  SelfCompileResult = record {
    cdx-path : Text,
    cdx-size : Integer,
    cdx-hash : Text,
    success : Boolean
  }

  self-compile-plan : Text, Text, Text -> SelfCompileResult
  self-compile-plan (codex-dir) (foreword-dir) (output-path) =
    let source = concat-compiler-source codex-dir foreword-dir
    in let source-hash = sha256-to-hex (sha256 (text-to-bytes source))
    in SelfCompileResult {
      cdx-path = output-path,
      cdx-size = text-length source,
      cdx-hash = source-hash,
      success = False
    }

Section: Fixed Point Check

  FixedPointResult = record {
    stage1-hash : Text,
    stage2-hash : Text,
    byte-identical : Boolean,
    size : Integer
  }

  check-fixed-point : Text, Text -> FixedPointResult
  check-fixed-point (stage1-hash) (stage2-hash) =
    FixedPointResult {
      stage1-hash = stage1-hash,
      stage2-hash = stage2-hash,
      byte-identical = stage1-hash == stage2-hash,
      size = 0
    }

  format-fixed-point : FixedPointResult -> Text
  format-fixed-point (r) =
    if r.byte-identical then "FIXED POINT: " & show (r.size) & " bytes, byte-identical"
    else "DIVERGED: stage1=" & r.stage1-hash & " stage2=" & r.stage2-hash

Section: Sample Compile

 Compile a single sample and evaluate the result against its
 sidecar. This is the inner loop of sweep.

  SampleCompileResult = record {
    name : Text,
    result : SampleResult,
    compile-ok : Boolean,
    output : Text
  }

  evaluate-sample : Text, Boolean, Text, Text -> SampleCompileResult
  evaluate-sample (source-path) (compile-ok) (runtime-output) (compile-log) =
    let name = path-stem source-path
    in let entry = classify-sample source-path name
    in when entry.kind
      is Skipped -> SampleCompileResult { name = name, result = SkippedResult, compile-ok = False, output = "" }
      is ExpectedFailure ->
        let r = evaluate-failing compile-ok (entry.sidecar) compile-log
        in SampleCompileResult { name = name, result = r, compile-ok = compile-ok, output = "" }
      is ExpectedOutput ->
        if compile-ok == False then SampleCompileResult { name = name, result = FailCompile, compile-ok = False, output = "" }
        else let r = evaluate-expected (entry.sidecar) runtime-output
        in SampleCompileResult { name = name, result = r, compile-ok = True, output = runtime-output }
      is CompileOnly ->
        if compile-ok then SampleCompileResult { name = name, result = PassUnverified, compile-ok = True, output = "" }
        else SampleCompileResult { name = name, result = FailCompile, compile-ok = False, output = "" }

Section: Sweep Driver

 Run the full sample battery. Enumerates test files, compiles
 each, evaluates results, and produces a summary.

  SweepPlan = record {
    test-dir : Text,
    samples : List SampleEntry,
    sample-count : Integer
  }

  plan-sweep : Text -> SweepPlan
  plan-sweep (test-dir) =
    let files = list-files test-dir ".codex"
    in let entries = for f in files -> let name = path-stem f in classify-sample f name
    in SweepPlan {
      test-dir = test-dir,
      samples = entries,
      sample-count = list-length entries
    }

Section: Seed Rebuild Driver

 The complete seed rebuild sequence as typed Codex data.
 Each step produces a record; the next step consumes it.
 This is the checklist as code.

  RebuildStep =
    | StepSelfBuild
    | StepFixedPoint
    | StepCanary
    | StepSweep
    | StepVerify
    | StepDigest
    | StepComplete

  RebuildState = record {
    step : RebuildStep,
    cdx-hash : Text,
    fixed-point : Boolean,
    sweep-summary : SweepSummary,
    verified : Boolean
  }

  rebuild-initial : RebuildState = RebuildState {
    step = StepSelfBuild,
    cdx-hash = "",
    fixed-point = False,
    sweep-summary = empty-sweep-summary,
    verified = False
  }

  rebuild-is-green : RebuildState -> Boolean
  rebuild-is-green (s) =
    s.fixed-point & sweep-all-green (s.sweep-summary) & s.verified

