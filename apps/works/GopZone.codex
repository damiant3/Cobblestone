Chapter: GopZone
  cites Works chapter GopFat16

Section: Range

  zone-bias : Integer = 12
  zone-min : Integer = 0 - 12
  zone-max : Integer = 14

  zone-clamp : Integer -> Integer
  zone-clamp (z) = if z < zone-min then zone-min else if z > zone-max then zone-max else z

  zone-pad2 : Integer -> Text
  zone-pad2 (v) = if v < 10 then "0" & show v else show v

  zone-text : Integer -> Text
  zone-text (z) = if z < 0 then "UTC-" & zone-pad2 (0 - z) else "UTC+" & zone-pad2 z

Section: The File

  zone-magic0 : Integer = 67
  zone-magic1 : Integer = 84
  zone-magic2 : Integer = 90
  zone-magic3 : Integer = 49

  zone-file-len : Integer = 8

  zone2-len : Integer = 16
  zone2-bias : Integer = 720
  zone-min-minutes : Integer = 0 - 720
  zone-max-minutes : Integer = 840

  zone-clamp-minutes : Integer -> Integer
  zone-clamp-minutes (m) =
    if m < zone-min-minutes then zone-min-minutes
    else if m > zone-max-minutes then zone-max-minutes
    else m

  zone-hours-of : Integer -> Integer
  zone-hours-of (m) = if m >= 0 then (m + 30) / 60 else 0 - ((0 - m + 30) / 60)

  ZoneRec = record {
    zc-minutes : Integer,
    zc-id : Integer,
    zc-clock : Integer,
    zc-date : Integer,
    zc-band : Integer
  }

  zone-band-time : Integer = 1
  zone-band-date : Integer = 2
  zone-band-offset : Integer = 4

  zone-band-default : Integer = 1

  zone-band-all : Integer = 7

  zone-rec-default : ZoneRec
  zone-rec-default = ZoneRec { zc-minutes = 0, zc-id = 0, zc-clock = 0, zc-date = 0, zc-band = zone-band-default }

  zone-name-bytes : Integer, Text, Integer -> Integer
  zone-name-bytes (buf) (s) (i) =
    if i >= text-length s then 0
    else let w = poke-byte buf i (to-unicode (char-code (char-at s i)))
    in zone-name-bytes buf s (i + 1)

  zone-name : Integer
  zone-name =
    let b = __heap-save
    in let adv = __heap-advance 16
    in let w = zone-name-bytes b "TIMEZONEDAT" 0
    in b

Section: The machine record

  zone-ver-off : Integer = 5
  zone-ver-named : Integer = 2
  zone-rtc-off : Integer = 6
  zone-name-len-off : Integer = 16
  zone-name-off : Integer = 17
  zone-name-max : Integer = 63
  zone-buf-bytes : Integer = 96

  ZoneMachine = record {
    zm-name : Text,
    zm-rtc-local : Boolean
  }

  zone-machine-default : ZoneMachine
  zone-machine-default = ZoneMachine { zm-name = "", zm-rtc-local = False }

  zone-name-ascii : Text, Integer -> Boolean
  zone-name-ascii (s) (i) =
    if i >= text-length s then True
    else if to-unicode (char-code (char-at s i)) > 127 then False
    else zone-name-ascii s (i + 1)

  zone-name-fits : Text -> Boolean
  zone-name-fits (s) = text-length s <= zone-name-max & zone-name-ascii s 0

  zone-text-of : Integer, Integer, Integer, Text -> Text
  zone-text-of (buf) (i) (stop) (acc) =
    if i >= stop then acc
    else zone-text-of buf (i + 1) stop (acc & char-to-text (code-to-char (from-unicode (peek-byte buf i))))

Section: Packing

  zone-head-ok : Integer, Integer -> Boolean
  zone-head-ok (buf) (len) =
    if len < zone-file-len then False
    else if peek-byte buf 0 /= zone-magic0 then False
    else if peek-byte buf 1 /= zone-magic1 then False
    else if peek-byte buf 2 /= zone-magic2 then False
    else peek-byte buf 3 == zone-magic3

  zone-hours-at : Integer, Integer -> Integer
  zone-hours-at (buf) (len) =
    if zone-head-ok buf len then zone-clamp (peek-byte buf 4 - zone-bias) else 0

  zone-rec-of : Integer, Integer -> ZoneRec
  zone-rec-of (buf) (len) =
    if zone-head-ok buf len == False then zone-rec-default
    else if len < zone2-len then ZoneRec { zc-minutes = zone-hours-at buf len * 60, zc-id = 0, zc-clock = 0, zc-date = 0, zc-band = zone-band-default }
    else
      let mins = zone-clamp-minutes (peek-byte buf 8 + peek-byte buf 9 * 256 - zone2-bias)
      in let bb = peek-byte buf 14
      in ZoneRec {
        zc-minutes = mins,
        zc-id = peek-byte buf 10 + peek-byte buf 11 * 256,
        zc-clock = peek-byte buf 12,
        zc-date = peek-byte buf 13,
        zc-band = if bb == 0 then zone-band-default else bit-and (bb - 1) zone-band-all
      }

  zone-machine-of : Integer, Integer -> ZoneMachine
  zone-machine-of (buf) (len) =
    if zone-head-ok buf len == False then zone-machine-default
    else if len < zone-name-off then zone-machine-default
    else if peek-byte buf zone-ver-off /= zone-ver-named then zone-machine-default
    else
      let n = peek-byte buf zone-name-len-off
      in if n > zone-name-max | len < zone-name-off + n then zone-machine-default
      else ZoneMachine { zm-name = zone-text-of buf zone-name-off (zone-name-off + n) "", zm-rtc-local = peek-byte buf zone-rtc-off == 1 }

  zone-pack-head : Integer, ZoneRec -> Integer
  zone-pack-head (buf) (r) =
    let mins = zone-clamp-minutes (r.zc-minutes)
    in let a = poke-byte buf 0 zone-magic0
    in let b = poke-byte buf 1 zone-magic1
    in let c = poke-byte buf 2 zone-magic2
    in let d = poke-byte buf 3 zone-magic3
    in let e = poke-byte buf 4 (zone-clamp (zone-hours-of mins) + zone-bias)
    in let h = poke-byte buf 7 0
    in let i = poke-byte buf 8 (int-mod (mins + zone2-bias) 256)
    in let j = poke-byte buf 9 ((mins + zone2-bias) / 256)
    in let k = poke-byte buf 10 (int-mod (r.zc-id) 256)
    in let l = poke-byte buf 11 (r.zc-id / 256)
    in let n = poke-byte buf 12 (r.zc-clock)
    in let o = poke-byte buf 13 (r.zc-date)
    in let p = poke-byte buf 14 (int-mod (bit-and (r.zc-band) zone-band-all + 1) 256)
    in poke-byte buf 15 0

  zone-pack : Integer, ZoneRec, ZoneMachine -> Integer
  zone-pack (buf) (r) (zm) =
    let name = if zone-name-fits (zm.zm-name) then zm.zm-name else ""
    in let hd = zone-pack-head buf r
    in let v = poke-byte buf zone-ver-off zone-ver-named
    in let t = poke-byte buf zone-rtc-off (if zm.zm-rtc-local then 1 else 0)
    in let n = poke-byte buf zone-name-len-off (text-length name)
    in let w = zone-name-bytes (buf + zone-name-off) name 0
    in zone-name-off + text-length name

  zone-hours-rec : Integer -> ZoneRec
  zone-hours-rec (z) = ZoneRec { zc-minutes = zone-clamp z * 60, zc-id = 0, zc-clock = 0, zc-date = 0, zc-band = zone-band-default }

Section: Saving

  zone-write : ZoneRec, ZoneMachine -> [Device.Port] Boolean
  zone-write (r) (zm) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then False
    else
      let buf = __heap-save
      in let adv = __heap-advance zone-buf-bytes
      in let len = zone-pack buf r zm
      in gfat-write-small-file (m.gm-vol) zone-name buf len
  end

  zone-save : Integer -> [Device.Port] Boolean
  zone-save (z) = act
    zm <- zone-machine-load
    zone-write (zone-hours-rec z) zm
  end

  zone2-save : ZoneRec -> [Device.Port] Boolean
  zone2-save (r) = act
    zm <- zone-machine-load
    zone-write r zm
  end

  zone-machine-save : ZoneMachine -> [Device.Port] Boolean
  zone-machine-save (zm) = act
    r <- zone2-load
    if zone-name-fits (zm.zm-name) == False then False
    else zone-write r zm
  end

Section: Loading

  zone2-load : [Device.Port] ZoneRec
  zone2-load = act
    m <- gfat-mount-esp
    if m.gm-ok == False then zone-rec-default
    else act
      f <- gfat-read-file (m.gm-vol) "TIMEZONE.DAT"
      if f.gf-ok == False then zone-rec-default
      else zone-rec-of (f.gf-buf) (f.gf-len)
    end
  end

  zone-machine-load : [Device.Port] ZoneMachine
  zone-machine-load = act
    m <- gfat-mount-esp
    if m.gm-ok == False then zone-machine-default
    else act
      f <- gfat-read-file (m.gm-vol) "TIMEZONE.DAT"
      if f.gf-ok == False then zone-machine-default
      else zone-machine-of (f.gf-buf) (f.gf-len)
    end
  end

  zone-load : [Device.Port] Integer
  zone-load = act
    m <- gfat-mount-esp
    if m.gm-ok == False then 0
    else act
      f <- gfat-read-file (m.gm-vol) "TIMEZONE.DAT"
      if f.gf-ok == False then 0
      else zone-hours-at (f.gf-buf) (f.gf-len)
    end
  end

