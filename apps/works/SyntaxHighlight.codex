Chapter: SyntaxHighlight
  cites Foreword chapter CCE

 THE INDENT DECIDES EVERYTHING, and it decides it before any character
 is looked at. `scan-token` in the compiler's lexer branches on
 `s.column == 2`: a line whose text begins one space in is PROSE and its
 contents are never tokenized, and one more space makes the same line
 code. So this classifier counts leading spaces first and only then asks
 what the characters are. Getting that order wrong produces a highlighter
 that colours the word `cites` inside an English sentence, which is the
 same confusion the compiler itself raises CDX3010 for.

   zero spaces   a Chapter: or Section: header
   one space     prose, whole line, no tokens inside it
   two or more   code

 We say:

Section: Classes

  SynClass =
   | SynPlain
   | SynProse
   | SynHeader
   | SynDirective
   | SynKeyword
   | SynType
   | SynName
   | SynNumber
   | SynString
   | SynOperator

  SynRun = record {
   sr-start : Integer,
   sr-len : Integer,
   sr-class : SynClass
  }

  syn-class-tag : SynClass -> Text
  syn-class-tag (k) =
   when k
    is SynPlain -> "."
    is SynProse -> "p"
    is SynHeader -> "h"
    is SynDirective -> "d"
    is SynKeyword -> "k"
    is SynType -> "T"
    is SynName -> "n"
    is SynNumber -> "9"
    is SynString -> "s"
    is SynOperator -> "o"

Section: Characters

  syn-ch : Text -> Integer
  syn-ch (t) = char-code (char-at t 0)

  syn-hyphen : Integer
  syn-hyphen = syn-ch "-"

  syn-dquote : Integer
  syn-dquote = syn-ch "\""

  syn-hash : Integer
  syn-hash = syn-ch "#"

  syn-backslash : Integer
  syn-backslash = syn-ch "\\"

  syn-is-word-char : Text, Integer -> Boolean
  syn-is-word-char (s) (i) =
   let c = char-at s i
   in is-letter c | is-digit c

Section: Indent

  syn-indent : Text, Integer, Integer -> Integer
  syn-indent (s) (i) (len) =
   if i >= len then i
   else if is-whitespace (char-at s i) then syn-indent s (i + 1) len
   else i

Section: Keywords

 The reserved word list, as `docs/DevelopersGuide.md` states it. `as` is
 deliberately absent: it is not reserved, it is the idiomatic name for a
 list, and colouring it as a keyword would be wrong in most of the tree.

  syn-directives : List Text
  syn-directives = ["cites", "quotes", "grounds", "trusting"]

  syn-keywords : List Text
  syn-keywords = [
   "let", "in", "if", "then", "else", "when", "is", "otherwise", "act", "end",
   "record", "mutable", "punctual", "unit", "above",
   "claim", "proof", "qed", "forall", "exists", "induction",
   "linear", "effect", "where", "with", "between", "and", "such", "that",
   "class", "instance", "lazy", "True", "False"
  ]

  syn-in-list : List Text, Text, Integer, Integer -> Boolean
  syn-in-list (xs) (w) (i) (len) =
   if i >= len then False
   else if list-at xs i == w then True
   else syn-in-list xs w (i + 1) len

Section: Classifying One Word

  syn-classify-word : Text -> SynClass
  syn-classify-word (w) =
   if syn-in-list syn-directives w 0 (list-length syn-directives) then SynDirective
   else if syn-in-list syn-keywords w 0 (list-length syn-keywords) then SynKeyword
   else if text-length w == 0 then SynPlain
   else if is-upper (char-at w 0) then SynType
   else SynName

Section: Token Ends

  syn-word-end : Text, Integer, Integer -> Integer
  syn-word-end (s) (i) (len) =
   if i >= len then i
   else if syn-is-word-char s i then syn-word-end s (i + 1) len
   else if char-code (char-at s i) == syn-hyphen
         & i + 1 < len
         & syn-is-word-char s (i + 1)
    then syn-word-end s (i + 2) len
   else i

  syn-number-end : Text, Integer, Integer -> Integer
  syn-number-end (s) (i) (len) =
   if i >= len then i
   else if is-digit (char-at s i) | is-letter (char-at s i) then syn-number-end s (i + 1) len
   else i

  syn-string-end : Text, Integer, Integer -> Integer
  syn-string-end (s) (i) (len) =
   if i >= len then i
   else if char-code (char-at s i) == syn-backslash then syn-string-end s (i + 2) len
   else if char-code (char-at s i) == syn-dquote then i + 1
   else syn-string-end s (i + 1) len

Section: Classifying A Line

  syn-line : Text -> List SynRun
  syn-line (s) =
   let len = text-length s
   in let ind = syn-indent s 0 len
   in if ind >= len then []
   else if ind == 0 then [SynRun { sr-start = 0, sr-len = len, sr-class = SynHeader }]
   else if ind == 1 then [SynRun { sr-start = 1, sr-len = len - 1, sr-class = SynProse }]
   else syn-code-runs s ind len []

  syn-code-runs : Text, Integer, Integer, List SynRun -> List SynRun
  syn-code-runs (s) (i) (len) (acc) =
   if i >= len then acc
   else if is-whitespace (char-at s i) then syn-code-runs s (i + 1) len acc
   else syn-code-token s i len acc

  syn-code-token : Text, Integer, Integer, List SynRun -> List SynRun
  syn-code-token (s) (i) (len) (acc) =
   let c = char-at s i
   in let code = char-code c
   in if code == syn-dquote then
     let e = syn-string-end s (i + 1) len
     in syn-code-runs s e len (list-push acc (SynRun { sr-start = i, sr-len = e - i, sr-class = SynString }))
   else if code == syn-hash then
     let e = syn-number-end s (i + 1) len
     in syn-code-runs s e len (list-push acc (SynRun { sr-start = i, sr-len = e - i, sr-class = SynNumber }))
   else if is-digit c then
     let e = syn-number-end s i len
     in syn-code-runs s e len (list-push acc (SynRun { sr-start = i, sr-len = e - i, sr-class = SynNumber }))
   else if is-letter c then
     let e = syn-word-end s i len
     in let w = substring s i (e - i)
     in syn-code-runs s e len (list-push acc (SynRun { sr-start = i, sr-len = e - i, sr-class = syn-classify-word w }))
   else syn-code-runs s (i + 1) len (list-push acc (SynRun { sr-start = i, sr-len = 1, sr-class = SynOperator }))

Section: Rendering A Classification

  syn-tags : Text -> Text
  syn-tags (s) = syn-tag-fill (syn-line s) (text-length s) 0 0 ""

  syn-tag-fill : List SynRun, Integer, Integer, Integer, Text -> Text
  syn-tag-fill (runs) (len) (i) (ri) (acc) =
   if i >= len then acc
   else if ri >= list-length runs then syn-tag-fill runs len (i + 1) ri (acc & " ")
   else let r = list-at runs ri
   in if i < r.sr-start then syn-tag-fill runs len (i + 1) ri (acc & " ")
   else if i < (r.sr-start) + (r.sr-len) then syn-tag-fill runs len (i + 1) ri (acc & syn-class-tag (r.sr-class))
   else syn-tag-fill runs len i (ri + 1) acc

Section: Colours

  syn-colour : SynClass -> Integer
  syn-colour (k) =
   when k
    is SynPlain -> #D8D8D8
    is SynProse -> #7FA87F
    is SynHeader -> #E8C86A
    is SynDirective -> #C88ED8
    is SynKeyword -> #6AA9E8
    is SynType -> #6AD8C0
    is SynName -> #D8D8D8
    is SynNumber -> #E8916A
    is SynString -> #C0D86A
    is SynOperator -> #9AA0A8
