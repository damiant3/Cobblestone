Chapter: SourceFactsBridge
  cites Works chapter RepoProtocolPersist
  cites Works chapter KeyManager
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Kernel chapter DiskFacts

 Bridge between the PowerShell source scanner and the Codex
 persistence layer. Reads a pipe-delimited manifest from serial
 (one SourceDefinition per line), signs each with a generated
 Ed25519 keypair, persists to DiskFacts kind 30, and reports
 the count.

 Run with: build/compile.ps1 to compile, then boot in codex-vm
 with -disk pointing to a blank disk image. Feed the manifest
 from build/output/source-facts.manifest over serial.

Section: Keypair Generation

  bridge-keypair : Keypair
  bridge-keypair =
    let seed = sha256 (text-to-bytes "codex-source-scanner-agent")
    in generate-keypair seed

Section: Signing

  sign-definition : Keypair, SourceDefinition -> SourceDefinition
  sign-definition (kp) (def) =
    let content = def.sd-hash & "|" & def.sd-path & "|" & def.sd-quire & "|" & def.sd-chapter
    in let sig = sign-content kp content
    in SourceDefinition {
      sd-hash = def.sd-hash,
      sd-path = def.sd-path,
      sd-quire = def.sd-quire,
      sd-chapter = def.sd-chapter,
      sd-signer = kp.fingerprint,
      sd-signature = sig
    }

Section: Process One Line

  process-line : DiskFactStore, Keypair, Text, Integer -> DiskFactStore
  process-line (store) (kp) (line) (timestamp) =
    let parsed = source-def-from-text line
    in when parsed
      is None -> store
      is Just (def) ->
        let signed = sign-definition kp def
        in repo-persist-save-definition store signed timestamp

Section: Manifest Loop

  manifest-loop : DiskFactStore, Keypair, Integer, Integer -> [Console] DiskFactStore
  manifest-loop (store) (kp) (count) (timestamp) = act
    result <- read-line
    when result
      is None ->
        let dummy = print-line ("FACTS:" & show count)
        in store
      is Just (line) ->
        if text-length line == 0 then
          let dummy = print-line ("FACTS:" & show count)
          in store
        else let new-store = process-line store kp line timestamp
        in manifest-loop new-store kp (count + 1) timestamp
  end

Section: Entry Point

  opening : [Console] None
  opening = act
    let kp = bridge-keypair
    in let store = disk-load
    in print-line ("BRIDGE:ready fp=" & kp.fingerprint)
    final <- manifest-loop store kp 0 0
    let saved = disk-checkpoint final
    in print-line ("BRIDGE:done facts=" & show (disk-fact-count saved))
  end

