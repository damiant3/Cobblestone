 We say:

Section: Server State

  WebServer = record {
    router : Router,
    transport : TcpTransportState,
    requests-served : Integer between 0 and 4294967295
  }

  WebResponse = record {
    response : HttpResponse,
    server : WebServer
  }

Section: Server Operations

  web-server-new : Router, TcpTransportState -> WebServer
  web-server-new (r) (ts) = WebServer { router = r, transport = ts, requests-served = 0 }

  web-server-handle : WebServer, List Integer, ShellState -> [Identity] WebResponse
  web-server-handle (srv) (req-bytes) (state) =
    let req = http-parse-request req-bytes
    in if req.valid == False then WebResponse {
      response = http-error "malformed request",
      server = WebServer { router = srv.router, transport = srv.transport, requests-served = srv.requests-served + 1 }
    }
    else let m = router-match (srv.router) (req.method) (req.path)
    in if m.matched == False then WebResponse {
      response = http-not-found,
      server = WebServer { router = srv.router, transport = srv.transport, requests-served = srv.requests-served + 1 }
    }
    else handled-response srv (dispatch-handler (m.handler) req state)

  handled-response : WebServer, HttpResponse -> WebResponse
  handled-response (srv) (resp) = WebResponse {
    response = resp,
    server = WebServer { router = srv.router, transport = srv.transport, requests-served = srv.requests-served + 1 }
  }

  dispatch-handler : RouteHandler, HttpRequest, ShellState -> [Identity] HttpResponse
  dispatch-handler (handler) (req) (state) =
    if handler.service == "status" then serve-status state
    else if handler.service == "health" then serve-health state
    else if handler.service == "info" then http-plain (format-report (gather-report state))
    else http-plain ("handled by " & handler.service)

Section: Built-in Handlers

  serve-status : ShellState -> HttpResponse
  serve-status (state) =
    let body = html-page "Codex OS" (
      html-h1 "Codex OS"
      & html-p (html-span-class "ok" "[running]" & " bare-metal x86-64")
      & html-h2 "Programs"
      & html-p (show (registry-count (state.registry)) & " installed")
      & html-h2 "Policy"
      & html-p ((state.policy).name & " (" & show (list-length ((state.policy).rules)) & " rules)")
    )
    in http-html body

  serve-health : ShellState -> [Identity] HttpResponse
  serve-health (state) = http-plain (format-report (gather-report state))

Section: Wire Protocol

  web-server-send-response : WebServer, HttpResponse -> WebServer
  web-server-send-response (srv) (resp) =
    let bytes = http-encode resp
    in let sr = transport-send-message (srv.transport) 0 bytes
    in WebServer { router = srv.router, transport = sr.transport, requests-served = srv.requests-served }

Section: Queries

  web-server-stats : WebServer -> Text
  web-server-stats (srv) = "served=" & show (srv.requests-served) & " " & router-stats (srv.router)

