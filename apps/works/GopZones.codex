    zrow "Africa/Johannesburg" "Johannesburg" 120 loc-dst-none 2,
    zrow "Europe/Moscow" "Moscow" 180 loc-dst-none 3,
    zrow "Asia/Istanbul" "Istanbul" 180 loc-dst-none 3,
    zrow "Africa/Nairobi" "Nairobi" 180 loc-dst-none 3,
    zrow "Asia/Tehran" "Tehran" 210 loc-dst-none 3,
    zrow "Asia/Dubai" "Dubai" 240 loc-dst-none 4,
    zrow "Asia/Kabul" "Kabul" 270 loc-dst-none 4,
    zrow "Asia/Karachi" "Karachi" 300 loc-dst-none 5,
    zrow "Asia/Kolkata" "Kolkata" 330 loc-dst-none 5,
    zrow "Asia/Kathmandu" "Kathmandu" 345 loc-dst-none 6,
