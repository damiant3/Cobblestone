  cites Foreword chapter Maybe

 To concat-compiler-source gives Text,
   producing the full concatenated source from codex-dir and foreword-dir paths.

 We say:

Section: Chapter Rename

  rename-chapter-header : Text, Text -> Text
  rename-chapter-header (content) (quire) =
    if text-length quire == 0 then content
    else let lines = text-split content "\n"
    in rename-first-chapter lines quire 0 (list-length lines) []

  rename-first-chapter : List Text, Text, Integer, Integer, List Text -> Text
  rename-first-chapter (lines) (quire) (i) (len) (acc) =
    if i >= len then join-lines acc 0 (list-length acc) ""
    else let line = list-at lines i
    in if text-starts-with line "Chapter: " then
      let name = substring line 9 (text-length line - 9)
      in let renamed = "Chapter: " & quire & "--" & name
      in rename-first-chapter lines quire (i + 1) len (list-push acc renamed)
    else rename-first-chapter lines quire (i + 1) len (list-push acc line)

  join-lines : List Text, Integer, Integer, Text -> Text
  join-lines (lines) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else "\n"
    in join-lines lines (i + 1) len (acc & sep & list-at lines i)

Section: Cite Extraction

  extract-foreword-cites : Text -> List Text
  extract-foreword-cites (content) =
    let lines = text-split content "\n"
    in extract-cites-loop lines 0 (list-length lines) []

  extract-cites-loop : List Text, Integer, Integer, List Text -> List Text
  extract-cites-loop (lines) (i) (len) (acc) =
    if i >= len then acc
    else let line = list-at lines i
    in if text-contains line "cites Foreword chapter " then
      let parts = text-split line "cites Foreword chapter "
      in if list-length parts >= 2 then
        let name = take-identifier (list-at parts 1) 0 (text-length (list-at parts 1)) ""
        in if text-length name > 0 then extract-cites-loop lines (i + 1) len (list-push acc name)
        else extract-cites-loop lines (i + 1) len acc
      else extract-cites-loop lines (i + 1) len acc
    else extract-cites-loop lines (i + 1) len acc

  take-identifier : Text, Integer, Integer, Text -> Text
  take-identifier (s) (i) (len) (acc) =
    if i >= len then acc
    else let c = char-at s i
    in if is-letter c then take-identifier s (i + 1) len (acc & char-to-text c)
    else if is-digit c then take-identifier s (i + 1) len (acc & char-to-text c)
    else if c == char-at "-" 0 then take-identifier s (i + 1) len (acc & char-to-text c)
    else if c == char-at "_" 0 then take-identifier s (i + 1) len (acc & char-to-text c)
    else acc

Section: Transitive Foreword Resolution

  CiteQueue = record {
    cq-seen : List Text,
    cq-ordered : List Text
  }

  resolve-forewords-transitive : Text, List Text -> [FileSystem.Read, Device.Block] CiteQueue
  resolve-forewords-transitive (foreword-dir) (initial-names) =
    process-cite-queue foreword-dir (CiteQueue { cq-seen = [], cq-ordered = [] }) initial-names 0 (list-length initial-names)

  process-cite-queue : Text, CiteQueue, List Text, Integer, Integer -> [FileSystem.Read, Device.Block] CiteQueue
  process-cite-queue (foreword-dir) (q) (names) (i) (len) =
    if i >= len then q
    else let name = list-at names i
    in if list-has-text (q.cq-seen) name 0 (list-length (q.cq-seen))
      then process-cite-queue foreword-dir q names (i + 1) len
    else let path = path-join foreword-dir (name & ".codex")
    in if file-exists path then act
      content <- read-text path
      let sub-cites = extract-foreword-cites content
      in let q2 = CiteQueue { cq-seen = list-push (q.cq-seen) name, cq-ordered = list-push (q.cq-ordered) name }
      in act
        q3 <- process-cite-queue foreword-dir q2 sub-cites 0 (list-length sub-cites)
        process-cite-queue foreword-dir q3 names (i + 1) len
      end
    end
    else process-cite-queue foreword-dir (CiteQueue { cq-seen = list-push (q.cq-seen) name, cq-ordered = q.cq-ordered }) names (i + 1) len

  list-has-text : List Text, Text, Integer, Integer -> Boolean
  list-has-text (xs) (target) (i) (len) =
    if i >= len then False
    else if list-at xs i == target then True
    else list-has-text xs target (i + 1) len

Section: Foreword Loading

  load-forewords : Text, List Text -> [FileSystem.Read, Device.Block] Text
  load-forewords (foreword-dir) (names) =
    load-forewords-loop foreword-dir names 0 (list-length names) ""

  load-forewords-loop : Text, List Text, Integer, Integer, Text -> [FileSystem.Read, Device.Block] Text
  load-forewords-loop (foreword-dir) (names) (i) (len) (acc) =
    if i >= len then acc
    else let name = list-at names i
    in let path = path-join foreword-dir (name & ".codex")
    in if file-exists path then act
      content <- read-text path
      let renamed = rename-chapter-header content "Foreword"
      in load-forewords-loop foreword-dir names (i + 1) len (acc & renamed & "\n\n")
    end
    else load-forewords-loop foreword-dir names (i + 1) len acc

Section: Source Tree Loading

  load-source-tree : Text -> [FileSystem.Read, Device.Block] Text
  load-source-tree (codex-dir) = act
    raw-root <- list-files codex-dir ".codex"
    raw-dirs <- list-directories codex-dir
    let root-files = sort-by raw-root (\a b -> text-compare a b)
    in let sub-dirs = sort-by raw-dirs (\a b -> text-compare a b)
    in act
      root-text <- load-files-with-quire codex-dir root-files "" 0 (list-length root-files) ""
      sub-text <- load-subdirs codex-dir sub-dirs 0 (list-length sub-dirs) ""
      root-text & sub-text
    end
  end

  load-subdirs : Text, List Text, Integer, Integer, Text -> [FileSystem.Read, Device.Block] Text
  load-subdirs (codex-dir) (dirs) (i) (len) (acc) =
    if i >= len then acc
    else let dir-name = list-at dirs i
    in let dir-path = path-join codex-dir dir-name
    in act
      raw-files <- list-files dir-path ".codex"
      let files = sort-by raw-files (\a b -> text-compare a b)
      in act
        text <- load-files-with-quire dir-path files dir-name 0 (list-length files) ""
        load-subdirs codex-dir dirs (i + 1) len (acc & text)
      end
    end

  load-files-with-quire : Text, List Text, Text, Integer, Integer, Text -> [FileSystem.Read, Device.Block] Text
  load-files-with-quire (dir) (paths) (quire) (i) (len) (acc) =
    if i >= len then acc
    else act
      content <- read-text (list-at paths i)
      let renamed = rename-chapter-header content quire
      in load-files-with-quire dir paths quire (i + 1) len (acc & renamed & "\n\n")
    end

Section: Full Concatenation

  concat-compiler-source : Text, Text -> [FileSystem.Read, Device.Block] Text
  concat-compiler-source (codex-dir) (foreword-dir) = act
    all-files <- list-files codex-dir ".codex"
    sub-dirs <- list-directories codex-dir
    all-cites <- collect-all-cites codex-dir all-files sub-dirs
    resolved <- resolve-forewords-transitive foreword-dir all-cites
    foreword-text <- load-forewords foreword-dir (resolved.cq-ordered)
    source-text <- load-source-tree codex-dir
    foreword-text & source-text
  end

  collect-all-cites : Text, List Text, List Text -> [FileSystem.Read, Device.Block] List Text
  collect-all-cites (codex-dir) (root-files) (sub-dirs) = act
    root-cites <- collect-cites-from-files root-files 0 (list-length root-files) []
    collect-subdir-cites codex-dir sub-dirs 0 (list-length sub-dirs) root-cites
  end

  collect-cites-from-files : List Text, Integer, Integer, List Text -> [FileSystem.Read, Device.Block] List Text
  collect-cites-from-files (paths) (i) (len) (acc) =
    if i >= len then acc
    else act
      content <- read-text (list-at paths i)
      let found = extract-foreword-cites content
      in collect-cites-from-files paths (i + 1) len (merge-unique acc found 0 (list-length found))
    end

  collect-subdir-cites : Text, List Text, Integer, Integer, List Text -> [FileSystem.Read, Device.Block] List Text
  collect-subdir-cites (codex-dir) (dirs) (i) (len) (acc) =
    if i >= len then acc
    else let dir-path = path-join codex-dir (list-at dirs i)
    in act
      files <- list-files dir-path ".codex"
      sub-acc <- collect-cites-from-files files 0 (list-length files) acc
      collect-subdir-cites codex-dir dirs (i + 1) len sub-acc
    end

  merge-unique : List Text, List Text, Integer, Integer -> List Text
  merge-unique (acc) (items) (i) (len) =
    if i >= len then acc
    else let item = list-at items i
    in if list-has-text acc item 0 (list-length acc) then merge-unique acc items (i + 1) len
    else merge-unique (list-push acc item) items (i + 1) len

