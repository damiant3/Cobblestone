 We say:

Section: The Kit

  IconKit = record {
    ik-dir : Icon,
    ik-src : Icon,
    ik-img : Icon,
    ik-bin : Icon
  }

  gicon-dir : Integer = 0

  gicon-src : Integer = 1

  gicon-img : Integer = 2

  gicon-bin : Integer = 3

  gicon-kit : IconKit
  gicon-kit =
    IconKit { ik-dir = ico-folder-8, ik-src = ico-code-8, ik-img = ico-image-8, ik-bin = ico-file-8 }

  gicon-pick : IconKit, Integer -> Icon
  gicon-pick (kit) (kind) =
    if kind == gicon-dir then kit.ik-dir
    else if kind == gicon-src then kit.ik-src
    else if kind == gicon-img then kit.ik-img
    else kit.ik-bin

Section: Blit

  gicon-cols : Integer, Integer, Integer, Icon, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gicon-cols (base) (stride) (rows) (ico) (px) (py) (scale) (color) (row) (col) =
    if col >= ico.ico-width then 0
    else if px + (col + 1) * scale > stride then 0
    else let on = icon-get ico col row
    in let d = if on == 1 then gop-fill-rect base stride rows (px + col * scale) (py + row * scale) scale scale color else 0
    in gicon-cols base stride rows ico px py scale color row (col + 1)

  gicon-rows : Integer, Integer, Integer, Icon, Integer, Integer, Integer, Integer, Integer -> Integer
  gicon-rows (base) (stride) (rows) (ico) (px) (py) (scale) (color) (row) =
    if row >= ico.ico-height then 0
    else let r = gicon-cols base stride rows ico px py scale color row 0
    in gicon-rows base stride rows ico px py scale color (row + 1)

  gicon-blit : Integer, Integer, Integer, Icon, Integer, Integer, Integer, Integer -> Integer
  gicon-blit (base) (stride) (rows) (ico) (px) (py) (scale) (color) =
    if scale <= 0 then 0
    else gicon-rows base stride rows ico px py scale color 0

  gicon-size : Icon, Integer -> Integer
  gicon-size (ico) (scale) = ico.ico-width * scale

Section: Drawn Icons

  gicon-render : VecPath, Integer -> Integer
  gicon-render (p) (n) =
    let buf = alloc-bytes (n * n)
    in let cov = vec-coverage-in p gicon-em n
    in let w = gicon-store buf cov 0 (n * n)
    in buf

  gicon-store : Integer, List Integer, Integer, Integer -> Integer
  gicon-store (buf) (cov) (i) (n) =
    if i >= n then 0
    else let w = poke-byte buf i (list-at cov i)
    in gicon-store buf cov (i + 1) n

  gicon-cov-at : Integer, Integer, Integer, Integer -> Integer
  gicon-cov-at (blob) (n) (x) (y) = peek-byte blob (y * n + x)

  gicon-cov-cols : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gicon-cov-cols (base) (stride) (rows) (blob) (n) (px) (py) (color) (row) (col) =
    if col >= n then 0
    else if px + col >= stride then 0
    else let d = gop-blend base stride rows (px + col) (py + row) color (gicon-cov-at blob n col row)
    in gicon-cov-cols base stride rows blob n px py color row (col + 1)

  gicon-cov-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gicon-cov-rows (base) (stride) (rows) (blob) (n) (px) (py) (color) (row) =
    if row >= n then 0
    else let r = gicon-cov-cols base stride rows blob n px py color row 0
    in gicon-cov-rows base stride rows blob n px py color (row + 1)

  gicon-blit-cov : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gicon-blit-cov (base) (stride) (rows) (blob) (n) (px) (py) (color) =
    if n <= 0 then 0
    else gicon-cov-rows base stride rows blob n px py color 0

  gicon-em : Integer = 32

  gicon-box : VecPath, Integer, Integer, Integer, Integer -> VecPath
  gicon-box (p) (x) (y) (w) (h) =
    let a = vec-move-to p x y
    in let b = vec-line-to a (x + w) y
    in let c = vec-line-to b (x + w) (y + h)
    in let d = vec-line-to c x (y + h)
    in vec-close d

  gicon-ring : VecPath, Integer, Integer, Integer, Integer -> VecPath
  gicon-ring (p) (cx) (cy) (ro) (ri) =
    vec-circle-loop (vec-circle-loop p cx cy ro 24 0 True) cx cy ri 24 0 True

  gicon-vec-menu : VecPath
  gicon-vec-menu =
    gicon-box (gicon-box (gicon-box vec-path-new 5 7 22 3) 5 14 22 3) 5 21 22 3

  gicon-vec-grid : VecPath
  gicon-vec-grid =
    gicon-box (gicon-box (gicon-box (gicon-box vec-path-new 5 5 9 9) 18 5 9 9) 5 18 9 9) 18 18 9 9

