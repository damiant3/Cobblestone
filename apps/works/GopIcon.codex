  gicon-vec-named : Text -> VecPath
  gicon-vec-named (name) =
    if name == "menu" then gicon-vec-menu
    else if name == "grid" then gicon-vec-grid
    else if name == "folder" then gicon-vec-folder
    else if name == "edit" then gicon-vec-edit
    else if name == "terminal" then gicon-vec-terminal
    else if name == "power" then gicon-vec-power
    else if name == "clock" then gicon-vec-clock
    else if name == "calendar" then gicon-vec-calendar
