    else if name == "code" then gicon-vec-code
    else if name == "home" then gicon-vec-home
    else if name == "win-close" then gicon-vec-win-close
    else if name == "win-min" then gicon-vec-win-min
    else if name == "win-max" then gicon-vec-win-max
    else gicon-vec-file

