  gicon-vec-win-max = gicon-box (gicon-box vec-path-new 6 6 20 20) 9 9 14 14

  gicon-drawn-count : Integer = 22

  gicon-drawn-name : Integer -> Text
  gicon-drawn-name (i) =
    if i == 0 then "menu"
    else if i == 1 then "grid"
    else if i == 2 then "folder"
    else if i == 3 then "edit"
    else if i == 4 then "terminal"
    else if i == 5 then "power"
    else if i == 6 then "clock"
    else if i == 7 then "calendar"
    else if i == 8 then "eye"
    else if i == 9 then "bell"
    else if i == 10 then "cloud"
    else if i == 11 then "check"
    else if i == 12 then "image"
    else if i == 13 then "star"
    else if i == 14 then "settings"
    else if i == 15 then "info"
    else if i == 16 then "code"
    else if i == 17 then "home"
    else if i == 19 then "win-close"
    else if i == 20 then "win-min"
    else if i == 21 then "win-max"
    else "file"

  gicon-drawn-slot : Text, Integer -> Integer
  gicon-drawn-slot (name) (i) =
    if i >= gicon-drawn-count then 0 - 1
    else if gicon-drawn-name i == name then i
    else gicon-drawn-slot name (i + 1)

  gicon-drawn : Text -> Boolean
  gicon-drawn (name) = gicon-drawn-slot name 0 >= 0

  gicon-vec-disc : VecPath
