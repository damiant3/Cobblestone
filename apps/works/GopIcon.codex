    in let p2 = vec-bezier-to p 28 14 28 22 16 28
    in let p3 = vec-bezier-to p2 4 22 4 14 16 4
    in vec-close p3

Section: By Name

  gicon-named : Text -> Icon
  gicon-named (name) =
    if name == "folder" then ico-folder-8
    else if name == "code" then ico-code-8
    else if name == "image" then ico-image-8
    else if name == "clock" then ico-clock-8
    else if name == "calendar" then ico-calendar-8
    else if name == "grid" then ico-grid-8
    else if name == "eye" then ico-eye-8
    else if name == "edit" then ico-edit-8
    else if name == "bell" then ico-bell-8
    else if name == "terminal" then ico-terminal-8
    else if name == "cloud" then ico-cloud-8
    else if name == "check" then ico-check-8
    else if name == "star" then ico-star-8
    else if name == "settings" then ico-settings-8
