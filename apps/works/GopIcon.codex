    in let c = vec-line-to b 16 13
    in let d = vec-line-to c 23 6
    in let e = vec-line-to d 26 9
    in let f = vec-line-to e 19 16
    in let g = vec-line-to f 26 23
    in let i = vec-line-to g 23 26
    in let j = vec-line-to i 16 19
    in let k = vec-line-to j 9 26
    in let l = vec-line-to k 6 23
    in let m = vec-line-to l 13 16
