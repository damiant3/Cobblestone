Chapter: GopPrograms
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter Theme
  cites Foreword chapter StringUtils
  cites Dev chapter GlobalSearch
  cites Dev chapter AppLauncher

Section: Geometry

  gpr-sel-cell : Integer = 0
  gpr-q-len-cell : Integer = 4
  gpr-q-at : Integer = 8
  gpr-q-max : Integer = 40
  gpr-mru-n-cell : Integer = 48
  gpr-mru-at : Integer = 52
  gpr-mru-max : Integer = 5

Section: The Programs

  GprEntry = record {
    ge-group : Text,
    ge-label : Text,
    ge-scan : Integer,
    ge-icon : Text
  }

  gpr-entries : List GprEntry = [
    GprEntry { ge-group = "Accessories", ge-label = "Clock", ge-scan = 37, ge-icon = "clock" },
    GprEntry { ge-group = "Accessories", ge-label = "Calculator", ge-scan = 46, ge-icon = "grid" },
    GprEntry { ge-group = "Accessories", ge-label = "Calendar", ge-scan = 38, ge-icon = "calendar" },
    GprEntry { ge-group = "Accessories", ge-label = "Aquarium", ge-scan = 16, ge-icon = "eye" },
    GprEntry { ge-group = "Accessories", ge-label = "Sheets", ge-scan = 31, ge-icon = "grid" },
    GprEntry { ge-group = "Productivity", ge-label = "Text Editor", ge-scan = 18, ge-icon = "edit" },
    GprEntry { ge-group = "Productivity", ge-label = "Issues", ge-scan = 23, ge-icon = "bell" },
    GprEntry { ge-group = "Productivity", ge-label = "Files", ge-scan = 33, ge-icon = "folder" },
    GprEntry { ge-group = "Productivity", ge-label = "Console", ge-scan = 20, ge-icon = "terminal" },
    GprEntry { ge-group = "Productivity", ge-label = "Browser", ge-scan = 48, ge-icon = "cloud" },
    GprEntry { ge-group = "Productivity", ge-label = "Review", ge-scan = 19, ge-icon = "check" },
    GprEntry { ge-group = "Graphics", ge-label = "3D View", ge-scan = 4, ge-icon = "image" },
    GprEntry { ge-group = "Graphics", ge-label = "Diffusion", ge-scan = 32, ge-icon = "star" },
    GprEntry { ge-group = "Settings", ge-label = "Settings", ge-scan = 30, ge-icon = "settings" },
    GprEntry { ge-group = "Settings", ge-label = "System Info", ge-scan = 50, ge-icon = "info" },
    GprEntry { ge-group = "Settings", ge-label = "Web Server", ge-scan = 17, ge-icon = "cloud" },
    GprEntry { ge-group = "Settings", ge-label = "Program Runner", ge-scan = 25, ge-icon = "code" }
  ]

  gpr-count : Integer
  gpr-count = list-length gpr-entries

  gpr-at : Integer -> GprEntry
  gpr-at (i) = list-at gpr-entries i

Section: State

  gpr-sel : Integer -> Integer
  gpr-sel (ps) = peek-32 ps gpr-sel-cell

  gpr-set-sel : Integer, Integer -> Integer
  gpr-set-sel (ps) (i) =
    poke-32 ps gpr-sel-cell (if i < 0 then 0 else if i >= gpr-count then gpr-count - 1 else i)

  gpr-ensure : Integer -> Integer
  gpr-ensure (ps) =
    let q = poke-32 ps gpr-q-len-cell 0
    in let recent = gpr-mru ps
    in gpr-set-sel ps (if list-length recent > 0 then list-at recent 0 else gpr-sel ps)

Section: Recent

  gpr-scan-index : Integer, Integer -> Integer
  gpr-scan-index (sc) (i) =
    if i >= gpr-count then 0 - 1
    else if (gpr-at i).ge-scan == sc then i
    else gpr-scan-index sc (i + 1)

  gpr-mru-n : Integer -> Integer
  gpr-mru-n (ps) = peek-32 ps gpr-mru-n-cell

  gpr-mru-loop : Integer, Integer, Integer, List Integer -> List Integer
  gpr-mru-loop (ps) (i) (n) (acc) =
    if i >= n then acc
    else let e = gpr-scan-index (peek-byte ps (gpr-mru-at + i)) 0
    in gpr-mru-loop ps (i + 1) n (if e < 0 then acc else list-push acc e)

  gpr-mru : Integer -> List Integer
  gpr-mru (ps) = gpr-mru-loop ps 0 (gpr-mru-n ps) []

  gpr-mru-labels : List Integer, Integer, List Text -> List Text
  gpr-mru-labels (es) (i) (acc) =
    if i >= list-length es then acc
    else gpr-mru-labels es (i + 1) (list-push acc ((gpr-at (list-at es i)).ge-label))

  gpr-mru-store : Integer, List Text, Integer -> Integer
  gpr-mru-store (ps) (ids) (i) =
    if i >= list-length ids then poke-32 ps gpr-mru-n-cell i
    else let e = gpr-label-index (list-at ids i) 0
    in let b = poke-byte ps (gpr-mru-at + i) (if e < 0 then 0 else (gpr-at e).ge-scan)
    in gpr-mru-store ps ids (i + 1)

  gpr-launched : Integer, Integer -> Integer
  gpr-launched (ps) (sc) =
    let e = gpr-scan-index sc 0
    in if e < 0 then sc
    else let ids = gpr-mru-labels (gpr-mru ps) 0 []
    in let next = al-add-recent ids ((gpr-at e).ge-label) (list-length ids) gpr-mru-max
    in let s = gpr-mru-store ps next 0
    in sc

  gpr-in : List Integer, Integer, Integer -> Boolean
  gpr-in (xs) (v) (i) = if i >= list-length xs then False else if list-at xs i == v then True else gpr-in xs v (i + 1)

  gpr-mru-pick : List Integer, List Integer, Integer, List Integer -> List Integer
  gpr-mru-pick (recent) (ms) (i) (acc) =
    if i >= list-length recent then acc
    else gpr-mru-pick recent ms (i + 1) (if gpr-in ms (list-at recent i) 0 then list-push acc (list-at recent i) else acc)

  gpr-rest : List Integer, List Integer, Integer, List Integer -> List Integer
  gpr-rest (ms) (recent) (i) (acc) =
    if i >= list-length ms then acc
    else gpr-rest ms recent (i + 1) (if gpr-in recent (list-at ms i) 0 then acc else list-push acc (list-at ms i))

  gpr-recent-first : Integer, List Integer -> List Integer
  gpr-recent-first (ps) (ms) =
    let recent = gpr-mru ps
    in gpr-rest ms recent 0 (gpr-mru-pick recent ms 0 [])

Section: Search

  gpr-q-len : Integer -> Integer
  gpr-q-len (ps) = peek-32 ps gpr-q-len-cell

 Scancode set 1: the letter rows start at 16, 30 and 44, the digit row at 2.

  gpr-sc-char : Integer -> Text
  gpr-sc-char (sc) =
    if sc >= 16 & sc <= 25 then substring "qwertyuiop" (sc - 16) 1
    else if sc >= 30 & sc <= 38 then substring "asdfghjkl" (sc - 30) 1
    else if sc >= 44 & sc <= 50 then substring "zxcvbnm" (sc - 44) 1
    else if sc >= 2 & sc <= 11 then substring "1234567890" (sc - 2) 1
    else if sc == 57 then " "
    else ""

  gpr-q-pieces : Integer, Integer, Integer, List Text -> List Text
  gpr-q-pieces (ps) (i) (n) (acc) =
    if i >= n then acc
    else gpr-q-pieces ps (i + 1) n (list-push acc (gpr-sc-char (peek-byte ps (gpr-q-at + i))))

  gpr-query : Integer -> Text
  gpr-query (ps) = text-concat-list (gpr-q-pieces ps 0 (gpr-q-len ps) (__list-with-capacity (gpr-q-len ps + 1)))

  gpr-provider-add : SearchProvider, Integer -> SearchProvider
  gpr-provider-add (p) (i) =
    if i >= gpr-count then p
    else let e = gpr-at i
    in gpr-provider-add (sprov-add-entry p (search-result (show i) (text-to-lower (e.ge-label)) (text-to-lower (e.ge-group)) (e.ge-icon) ScApps (e.ge-label))) (i + 1)

  gpr-label-index : Text, Integer -> Integer
  gpr-label-index (label) (i) =
    if i >= gpr-count then 0 - 1
    else if (gpr-at i).ge-label == label then i
    else gpr-label-index label (i + 1)

  gpr-result-indices : List GsSearchResult, Integer, List Integer -> List Integer
  gpr-result-indices (rs) (i) (acc) =
    if i >= list-length rs then acc
    else gpr-result-indices rs (i + 1) (list-push acc (gpr-label-index ((list-at rs i).sr-action) 0))

  gpr-matches : Integer -> List Integer
  gpr-matches (ps) =
    let st = gs-set-query (gs-register-provider global-search-new (gpr-provider-add (search-provider-new "programs" "Programs" ScApps) 0)) (gpr-query ps)
    in gpr-recent-first ps (gpr-result-indices (st.gs-results) 0 [])

  gpr-pos-of : List Integer, Integer, Integer -> Integer
  gpr-pos-of (ms) (v) (i) =
    if i >= list-length ms then 0 - 1
    else if list-at ms i == v then i
    else gpr-pos-of ms v (i + 1)

  gpr-step-match : Integer, Integer -> Integer
  gpr-step-match (ps) (dir) =
    let ms = gpr-matches ps
    in let n = list-length ms
    in if n == 0 then 0
    else let at = gpr-pos-of ms (gpr-sel ps) 0
    in let to = if at < 0 then 0 else if at + dir < 0 then 0 else if at + dir >= n then n - 1 else at + dir
    in gpr-set-sel ps (list-at ms to)

  gpr-q-set : Integer, Integer -> Integer
  gpr-q-set (ps) (n) =
    let q = poke-32 ps gpr-q-len-cell n
    in let ms = gpr-matches ps
    in if n > 0 & list-length ms > 0 then gpr-set-sel ps (list-at ms 0) else 0

  gpr-q-push : Integer, Integer -> Integer
  gpr-q-push (ps) (sc) =
    let n = gpr-q-len ps
    in if n >= gpr-q-max then 0
    else let b = poke-byte ps (gpr-q-at + n) sc
    in gpr-q-set ps (n + 1)

  gpr-q-pop : Integer -> Integer
  gpr-q-pop (ps) = if gpr-q-len ps <= 0 then 0 else gpr-q-set ps (gpr-q-len ps - 1)

  gpr-search-cap : Integer = 8

  gpr-search-rows : List Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  gpr-search-rows (ms) (sel) (i) (acc) =
    if i >= list-length ms | i >= gpr-search-cap then acc
    else gpr-search-rows ms sel (i + 1) (list-push acc (gpr-row (list-at ms i) sel))

  gpr-search-tree : Integer -> WidgetNode
  gpr-search-tree (ps) =
    let ms = gpr-matches ps
    in let head = widget-set-min-h (widget-label "gpr-q" ("Search: " & gpr-query ps & "_")) 22
    in let rows = if list-length ms == 0 then [widget-set-min-h (widget-label "gpr-q-none" "no match") 22] else gpr-search-rows ms (gpr-sel ps) 0 []
    in widget-panel "gpr-menu" DirColumn 2 ([head] & rows)

Section: The Tree

  gpr-heads : Integer -> Boolean
  gpr-heads (i) =
    if i <= 0 then True
    else (gpr-at i).ge-group /= (gpr-at (i - 1)).ge-group

  gpr-mark : Integer, Integer -> Text
  gpr-mark (i) (sel) = if i == sel then "> " else "  "

  gpr-mark-cells : Integer = 2

  gpr-icon-cells : Integer = 2

  gpr-gutter : Text = "   "

  gpr-key-name : Integer -> Text
  gpr-key-name (sc) =
    if sc == 20 then "t"
    else if sc == 18 then "e"
    else if sc == 33 then "f"
    else if sc == 4 then "3"
    else if sc == 16 then "q"
    else if sc == 32 then "d"
    else if sc == 48 then "b"
    else if sc == 23 then "i"
    else if sc == 19 then "r"
    else if sc == 38 then "l"
    else if sc == 46 then "c"
    else if sc == 50 then "m"
    else if sc == 30 then "a"
    else if sc == 37 then "k"
    else "?"

  gpr-row : Integer, Integer -> WidgetNode
  gpr-row (i) (sel) =
    let e = gpr-at i
    in let btn = widget-button ("gpr-" & e.ge-label) (gpr-mark i sel & gpr-gutter & e.ge-label)
    in widget-set-min-h btn 22

  gpr-split : Integer = 11

  gpr-rows : Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  gpr-rows (i) (stop) (sel) (acc) =
    if i >= stop then acc
    else let acc1 = if gpr-heads i then list-push acc (widget-set-min (widget-label ("gpr-h-" & (gpr-at i).ge-group) ((gpr-at i).ge-group)) 0 20) else acc
    in gpr-rows (i + 1) stop sel (list-push acc1 (gpr-row i sel))

  gpr-tree : Integer -> WidgetNode
  gpr-tree (ps) =
    let sel = gpr-sel ps
    in let left = widget-panel "gpr-left" DirColumn 2 (gpr-rows 0 gpr-split sel [])
    in let right = widget-panel "gpr-right" DirColumn 2 (gpr-rows gpr-split gpr-count sel [])
    in let cols = widget-panel "gpr-cols" DirRow 8 [widget-set-flex left 1, widget-set-flex right 1]
    in let help = widget-set-min (widget-label "gpr-help" "up/down choose   Enter opens") 0 20
    in widget-panel "gpr-pane" DirColumn 6 [widget-set-flex cols 1, help]

Section: The Menu Tree

  gpr-group-prefix : Text = "gprg-"

  gpr-open-group : Integer -> Text
  gpr-open-group (ps) = (gpr-at (gpr-sel ps)).ge-group

  gpr-group-scan : Text, Integer -> Integer
  gpr-group-scan (id) (i) =
    if i >= gpr-count then 0
    else if gpr-heads i & id == (gpr-group-prefix & (gpr-at i).ge-group) then i + 1
    else gpr-group-scan id (i + 1)

  gpr-group-mark : Boolean -> Text
  gpr-group-mark (open) = if open then "- " else "+ "

  gpr-open-max : Integer = 6

  GprWindow = record {
    gw-lo : Integer,
    gw-hi : Integer,
    gw-note : Text
  }

  gpr-group-first : List GprEntry, Text, Integer -> Integer
  gpr-group-first (es) (grp) (i) =
    if i >= list-length es then i
    else if (list-at es i).ge-group == grp then i
    else gpr-group-first es grp (i + 1)

  gpr-group-end : List GprEntry, Text, Integer -> Integer
  gpr-group-end (es) (grp) (i) =
    if i >= list-length es then i
    else if (list-at es i).ge-group == grp then gpr-group-end es grp (i + 1)
    else i

  gpr-window : Integer, Integer -> GprWindow
  gpr-window (ps) (cap) =
    let es = gpr-entries
    in let sel = gpr-sel ps
    in let grp = (list-at es sel).ge-group
    in let g0 = gpr-group-first es grp 0
    in let n = gpr-group-end es grp g0 - g0
    in let raw = sel - g0 - cap + 1
    in let first = if n <= cap then 0 else if raw < 0 then 0 else if raw > n - cap then n - cap else raw
    in let shown = if n < cap then n else cap
    in let note = if n <= cap then "" else "  " & integer-to-text (first + 1) & "-" & integer-to-text (first + shown) & " of " & integer-to-text n
    in GprWindow { gw-lo = g0 + first, gw-hi = g0 + first + shown, gw-note = note }

  gpr-group-row : Integer, Boolean, Text -> WidgetNode
  gpr-group-row (i) (open) (note) =
    let e = gpr-at i
    in let btn = widget-button (gpr-group-prefix & e.ge-group) (gpr-group-mark open & e.ge-group & note)
    in widget-set-min-h btn 22

  gpr-menu-rows : Integer, Integer, Text, GprWindow, List WidgetNode -> List WidgetNode
  gpr-menu-rows (i) (sel) (open) (win) (acc) =
    if i >= gpr-count then acc
    else let e = gpr-at i
    in let here = e.ge-group == open
    in let acc1 = if gpr-heads i then list-push acc (gpr-group-row i here (if here then win.gw-note else "")) else acc
    in let acc2 = if here & i >= win.gw-lo & i < win.gw-hi then list-push acc1 (gpr-row i sel) else acc1
    in gpr-menu-rows (i + 1) sel open win acc2

  gpr-col-prefix : Text = "gprc-"

  gpr-group-items : Integer, GprWindow, Integer, List WidgetNode -> List WidgetNode
  gpr-group-items (sel) (win) (i) (acc) =
    if i >= win.gw-hi then acc
    else if i < win.gw-lo then gpr-group-items sel win (i + 1) acc
    else gpr-group-items sel win (i + 1) (list-push acc (gpr-row i sel))

  gpr-menu-cols : Integer, Integer, Text, GprWindow, List WidgetNode -> List WidgetNode
  gpr-menu-cols (i) (sel) (open) (win) (acc) =
    if i >= gpr-count then acc
    else if gpr-heads i == False then gpr-menu-cols (i + 1) sel open win acc
    else
      let g = (gpr-at i).ge-group
      in let head = list-push [] (gpr-group-row i (g == open) (if g == open then win.gw-note else ""))
      in let kids = if g == open then gpr-group-items sel win 0 head else head
      in gpr-menu-cols (i + 1) sel open win (list-push acc (widget-panel (gpr-col-prefix & g) DirColumn 2 kids))

  gpr-menu-tree-cap : Integer, Boolean, Integer -> WidgetNode
  gpr-menu-tree-cap (ps) (across) (cap) =
    let win = gpr-window ps cap
    in if gpr-q-len ps > 0 then gpr-search-tree ps
    else if across then widget-panel "gpr-menu" DirRow 8 (gpr-menu-cols 0 (gpr-sel ps) (gpr-open-group ps) win [])
    else widget-panel "gpr-menu" DirColumn 2 (gpr-menu-rows 0 (gpr-sel ps) (gpr-open-group ps) win [])

  gpr-menu-tree : Integer, Boolean -> WidgetNode
  gpr-menu-tree (ps) (across) = gpr-menu-tree-cap ps across gpr-open-max

Section: Keys

  gpr-key : Integer, Integer -> Integer
  gpr-key (ps) (sc) =
    if gpr-q-len ps > 0 & (sc == 72 | sc == 80) then let d = gpr-step-match ps (if sc == 72 then 0 - 1 else 1) in 0
    else if sc == 72 then let d = gpr-set-sel ps (gpr-sel ps - 1) in 0
    else if sc == 80 then let d = gpr-set-sel ps (gpr-sel ps + 1) in 0
    else if sc == 28 then (if gpr-q-len ps > 0 & list-length (gpr-matches ps) == 0 then 0 else (gpr-at (gpr-sel ps)).ge-scan)
    else if sc == 14 then let d = gpr-q-pop ps in 0
    else if gpr-sc-char sc /= "" then let d = gpr-q-push ps sc in 0
    else 0

  gpr-id-scan : Text, Integer -> Integer
  gpr-id-scan (id) (i) =
    if i >= gpr-count then 0
    else if id == ("gpr-" & (gpr-at i).ge-label) then (gpr-at i).ge-scan
    else gpr-id-scan id (i + 1)

Page 1
