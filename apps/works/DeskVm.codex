Chapter: DeskVm
  cites Works chapter GopDesk
  cites Works chapter GopUsb
  cites Works chapter GopWeb
  cites Kernel chapter BitmapFont

 We say:

Section: Handoff

  vm-fb-base : Integer = 3204448256
  vm-cell-w : Integer = 1988
  vm-cell-h : Integer = 1992
  vm-cell-stride : Integer = 2016

Section: Entry

  opening : [Device.Port, Device.Mmio, Gpu.Compute, Gpu.Memory, Identity, Audio, Concurrent, Capability, Network.Read, Network.Write] Integer
  opening =
    let w = peek-32 vm-cell-w 0
    in let h = peek-32 vm-cell-h 0
    in let stride = peek-32 vm-cell-stride 0
    in let font = cbf-init
    in act
      ri <- runtime-init 0
      att <- usb-attach
      svc <- gopweb-hold
      desk-run vm-fb-base w h stride font (att.ua-kbd) (att.ua-mouse) svc
    end

