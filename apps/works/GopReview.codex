  cites UI chapter Scroll

Section: State

  grv-sel-cell : Integer = 0
  grv-mode-cell : Integer = 4
  grv-reason-cell : Integer = 8
  grv-rlen-cell : Integer = 12
  grv-kind-cell : Integer = 16
  grv-mods-cell : Integer = 20
  grv-scroll-cell : Integer = 24
  grv-view-cell : Integer = 28
  grv-old-cell : Integer = 32
  grv-pick-cell : Integer = 36

  grv-mode-list : Integer = 0
  grv-mode-detail : Integer = 1
  grv-mode-reason : Integer = 2
  grv-mode-pick : Integer = 3

  grv-reason-cols : Integer = 72

  grv-init : Integer -> Integer
  grv-init (rs) =
    let b = alloc-zeroed grv-reason-cols 64
    in let a = poke-32 rs grv-reason-cell b
    in let c = poke-32 rs grv-rlen-cell 0
    in let d = poke-32 rs grv-kind-cell 0
    in let e = poke-32 rs grv-mods-cell 0
    in let f = poke-32 rs grv-scroll-cell 0
    in let g = poke-32 rs grv-old-cell 0
    in let h = poke-32 rs grv-pick-cell 0
    in poke-32 rs grv-view-cell 1

  grv-scroll-y : Integer -> Integer
  grv-scroll-y (rs) = peek-32 rs grv-scroll-cell

  grv-set-scroll : Integer, Integer -> Integer
  grv-set-scroll (rs) (y) = poke-32 rs grv-scroll-cell (if y < 0 then 0 else y)

  grv-view-rows : Integer -> Integer
  grv-view-rows (rs) = let v = peek-32 rs grv-view-cell in if v < 1 then 1 else v

  grv-sel : Integer -> Integer
  grv-sel (rs) = peek-32 rs grv-sel-cell

  grv-mode : Integer -> Integer
  grv-mode (rs) = peek-32 rs grv-mode-cell

  grv-set-sel : Integer, Integer, Integer -> Integer
  grv-set-sel (rs) (i) (n) =
    poke-32 rs grv-sel-cell (if i < 0 then 0 else if n <= 0 then 0 else if i >= n then n - 1 else i)

  grv-set-mode : Integer, Integer -> Integer
  grv-set-mode (rs) (m) = poke-32 rs grv-mode-cell m

Section: The Reason Buffer

  grv-reason-buf : Integer -> Integer
  grv-reason-buf (rs) = peek-32 rs grv-reason-cell

  grv-reason-len : Integer -> Integer
  grv-reason-len (rs) = peek-32 rs grv-rlen-cell

  grv-reason-chars : Integer, Integer, Integer, Text -> Text
  grv-reason-chars (buf) (i) (stop) (acc) =
    if i >= stop then acc
    else let b = peek-byte buf i
    in let ch = if b < 32 | b == 127 then " " else char-encode (code-to-char (from-unicode b))
    in grv-reason-chars buf (i + 1) stop (acc & ch)

  grv-reason-text : Integer -> Text
  grv-reason-text (rs) = grv-reason-chars (grv-reason-buf rs) 0 (grv-reason-len rs) ""

  grv-type : Integer, Integer -> Integer
  grv-type (rs) (ch) =
    let n = grv-reason-len rs
    in if n >= grv-reason-cols then n
    else let w = poke-byte (grv-reason-buf rs) n ch
    in poke-32 rs grv-rlen-cell (n + 1)

  grv-back : Integer -> Integer
  grv-back (rs) =
    let n = grv-reason-len rs
    in if n <= 0 then 0 else poke-32 rs grv-rlen-cell (n - 1)

  grv-shift-of : Integer, Integer -> Integer
  grv-shift-of (mods) (sc) =
    if sc == 42 | sc == 54 then 1
    else if sc == 170 | sc == 182 then 0
    else mods

Section: The Store

  GrvData = record {
    gd-ok : Boolean,
    gd-base : Integer,
    gd-facts : Integer,
    gd-proposals : List Proposal,
    gd-verdicts : List Verdict,
    gd-sups : List Supersession
  }

  grv-none : GrvData = GrvData { gd-ok = False, gd-base = 0, gd-facts = 0, gd-proposals = [], gd-verdicts = [], gd-sups = [] }

  grv-load : Integer -> [Device.Port] GrvData
  grv-load (dummy) = act
    st <- gfs-mount
    if st.gfs-ok == False then grv-none
    else act
      ptexts <- gfs-scan-all st persist-kind-proposal
      vtexts <- gfs-scan-all st persist-kind-verdict
      stexts <- gfs-scan-all st persist-kind-supersession
      GrvData {
        gd-ok = True,
        gd-base = st.gfs-base,
        gd-facts = st.gfs-count,
        gd-proposals = parse-proposal-list ptexts 0 (list-length ptexts) [],
        gd-verdicts = parse-verdict-list vtexts 0 (list-length vtexts) [],
        gd-sups = parse-supersession-list stexts 0 (list-length stexts) []
      }
    end
  end

  grv-count : GrvData -> Integer
  grv-count (d) = list-length (d.gd-proposals)

  grv-open-count : List Proposal, Integer, Integer -> Integer
  grv-open-count (ps) (i) (acc) =
    if i >= list-length ps then acc
    else let p = list-at ps i
    in grv-open-count ps (i + 1) (if (when p.status is ProposalOpen -> True is otherwise -> False) then acc + 1 else acc)

Section: Verdict Tallies

  grv-kind-code : VerdictKind -> Integer
  grv-kind-code (k) =
    when k
      is Accept -> 0
      is Reject -> 1
      is Amend (note) -> 2
      is Abstain -> 3

  grv-tally : List Verdict, Text, Integer, Integer, Integer -> Integer
  grv-tally (vs) (pid) (code) (i) (acc) =
    if i >= list-length vs then acc
    else let v = list-at vs i
    in let hit = (v.proposal-id == pid) & (grv-kind-code (v.kind) == code)
    in grv-tally vs pid code (i + 1) (if hit then acc + 1 else acc)

  grv-tally-text : List Verdict, Text -> Text
  grv-tally-text (vs) (pid) =
    show (grv-tally vs pid 0 0 0) & "a " & show (grv-tally vs pid 1 0 0) & "r " & show (grv-tally vs pid 2 0 0) & "m " & show (grv-tally vs pid 3 0 0) & "x"

  grv-verdicts-for : List Verdict, Text, Integer, List Verdict -> List Verdict
  grv-verdicts-for (vs) (pid) (i) (acc) =
    if i >= list-length vs then acc
    else let v = list-at vs i
    in grv-verdicts-for vs pid (i + 1) (if v.proposal-id == pid then list-push acc v else acc)

Section: The Chain

  grv-chain-cap : Integer = 64

  grv-sup-of : List Supersession, Text, Integer -> Text
  grv-sup-of (sups) (id) (i) =
    if i >= list-length sups then ""
    else let s = list-at sups i
    in if s.sup-old == id then s.sup-new else grv-sup-of sups id (i + 1)

  grv-proposal-by-id : List Proposal, Text, Integer -> Integer
  grv-proposal-by-id (ps) (id) (i) =
    if i >= list-length ps then 0 - 1
    else if (list-at ps i).id == id then i
    else grv-proposal-by-id ps id (i + 1)

  ChainStep = record {
    ch-id : Text,
    ch-index : Integer
  }

  grv-chain : GrvData, Text, Integer, List Text, List ChainStep -> List ChainStep
  grv-chain (d) (id) (depth) (seen) (acc) =
    if depth >= grv-chain-cap then acc
    else if grv-seen seen id 0 then acc
    else let idx = grv-proposal-by-id (d.gd-proposals) id 0
    in let acc2 = list-push acc (ChainStep { ch-id = id, ch-index = idx })
    in let next = grv-sup-of (d.gd-sups) id 0
    in if text-length next == 0 then acc2
    else grv-chain d next (depth + 1) (list-push seen id) acc2

  grv-seen : List Text, Text, Integer -> Boolean
  grv-seen (xs) (id) (i) =
    if i >= list-length xs then False
    else if list-at xs i == id then True
    else grv-seen xs id (i + 1)

  grv-chain-lines : GrvData, List ChainStep, Integer, List Text -> List Text
  grv-chain-lines (d) (steps) (i) (acc) =
    if i >= list-length steps then acc
    else let s = list-at steps i
    in let marker = if i == 0 then "  this one:  " else "  replaced by:  "
    in let body = if s.ch-index < 0 then grv-short (s.ch-id) 16 & "   NOT ON THIS MEDIUM" else grv-short (s.ch-id) 16 & "   " & (list-at (d.gd-proposals) (s.ch-index)).description
    in grv-chain-lines d steps (i + 1) (list-push acc (marker & body))

  grv-chain-block : GrvData, Integer -> List Text
  grv-chain-block (d) (sel) =
    let p = list-at (d.gd-proposals) sel
    in let steps = grv-chain d (p.id) 0 [] []
    in if list-length steps <= 1 then ["Supersession:  none on this medium"]
    else list-push (grv-chain-lines d steps 0 []) ""

Section: Names

  grv-short : Text, Integer -> Text
  grv-short (t) (n) = if text-length t <= n then t else text-take t n

  grv-target-text : AnnotationTarget -> Text
  grv-target-text (t) = if text-length (t.path) == 0 then t.chapter else t.chapter & ":" & t.path

  grv-verdict-line : Verdict -> Text
  grv-verdict-line (v) =
    verdict-kind-name (v.kind) & "  " & grv-short (v.author-fingerprint) 12 & "  " & v.reason

Section: Wrapping

  grv-glyph-w : Integer
  grv-glyph-w = (widget-label "" "M").wn-min-w

  grv-wrap-gutter : Integer = 4

  grv-cpl : Integer -> Integer
  grv-cpl (wrap-w) = if grv-glyph-w <= 0 then 0 else (wrap-w - grv-wrap-gutter) / grv-glyph-w

  grv-is-space : Integer -> Boolean
  grv-is-space (cc) = if cc >= 1 then cc <= 2 else False

  grv-comma : Integer
  grv-comma = char-code (char-at "," 0)

  grv-break-at : Text, Integer, Integer, Integer, Integer, Integer -> Integer
  grv-break-at (s) (cpl) (i) (col) (start) (last) =
    if i >= text-length s then i
    else if col >= cpl then (if last > start then last else i)
    else let cc = char-code (char-at s i)
    in if grv-is-space cc then grv-break-at s cpl (i + 1) (col + 1) start i
    else if cc == grv-comma then grv-break-at s cpl (i + 1) (col + 1) start (i + 1)
    else grv-break-at s cpl (i + 1) (col + 1) start last

  grv-wrap-lines : Text, Integer, Integer, List Text -> List Text
  grv-wrap-lines (s) (cpl) (start) (acc) =
    if cpl <= 0 then list-push acc (text-drop s start)
    else if start >= text-length s then acc
    else let cut = grv-break-at s cpl start 0 start start
    in let line = text-substring s start (cut - start)
    in let skip = if cut >= text-length s then cut else if grv-is-space (char-code (char-at s cut)) then cut + 1 else cut
    in let next = if skip <= start then start + 1 else skip
    in grv-wrap-lines s cpl next (list-push acc line)

  grv-cap-lines : List Text, Integer, Integer -> List Text
  grv-cap-lines (ls) (n) (cpl) =
    if n <= 0 then []
    else if list-length ls <= n then ls
    else grv-cap-go ls n cpl 0 []

  grv-cap-go : List Text, Integer, Integer, Integer, List Text -> List Text
  grv-cap-go (ls) (n) (cpl) (i) (acc) =
    if i >= n then acc
    else let raw = list-at ls i
    in let room = if cpl - 3 < text-length raw then cpl - 3 else text-length raw
    in let line = if i < n - 1 then raw else if room <= 0 then raw else text-take raw room & "..."
    in grv-cap-go ls n cpl (i + 1) (list-push acc line)

  grv-line-labels : Text, List Text, Integer, List WidgetNode -> List WidgetNode
  grv-line-labels (id) (ls) (i) (acc) =
    if i >= list-length ls then acc
    else let lbl = widget-set-min (widget-label (id & "-" & show i) (list-at ls i)) 0 18
    in grv-line-labels id ls (i + 1) (list-push acc lbl)

  grv-field-lines : Text, Integer -> List Text
  grv-field-lines (t) (cpl) = if text-length t == 0 then [""] else grv-wrap-lines t cpl 0 []

  grv-wrap-all : List Text, Integer, Integer, List Text -> List Text
  grv-wrap-all (src) (cpl) (i) (acc) =
    if i >= list-length src then acc
    else grv-wrap-all src cpl (i + 1) (acc & grv-field-lines (list-at src i) cpl)

  grv-body-lines : GrvData, Integer, Integer -> List Text
  grv-body-lines (d) (sel) (cpl) =
    let p = list-at (d.gd-proposals) sel
    in grv-wrap-all (grv-chain-block d sel) cpl 0 []
      & [""]
      & grv-field-lines ("Changes:  " & join-with-comma (p.changed-definitions) 0 (list-length (p.changed-definitions)) "") cpl
      & [""]
      & grv-field-lines (p.description) cpl
      & [""]
      & grv-field-lines (p.justification) cpl

  grv-row-h : Integer = 24

Section: The List

  grv-columns : List TableColumn
  grv-columns = [
    table-column "pid" "ID" 84,
    table-column "target" "Target" 150,
    table-column "author" "Author" 100,
    table-column "status" "Status" 60,
    table-column "verdicts" "Verdicts" 100,
    table-column "desc" "Description" 94
  ]

  grv-rows : GrvData, Integer, Integer, List TableRow -> List TableRow
  grv-rows (d) (sel) (i) (acc) =
    if i >= grv-count d then acc
    else let p = list-at (d.gd-proposals) i
    in let tr = table-row (show (i + 1)) [
        (if i == sel then "> " else "  ") & grv-short (p.id) 8,
        grv-target-text (p.target),
        grv-short (p.author-fingerprint) 12,
        proposal-status-name (p.status),
        grv-tally-text (d.gd-verdicts) (p.id),
        p.description
      ]
    in grv-rows d sel (i + 1) (list-push acc tr)

  grv-table : GrvData, Integer, Integer -> DataTableState
  grv-table (d) (sel) (content-h) =
    let t0 = data-table-new "review" grv-columns (grv-rows d sel 0 [])
    in let fitted = data-table-fit t0 content-h
    in let size = fitted.dt-page-size
    in if size <= 0 then fitted else __record-set fitted "dt-page" (sel / size)

  grv-title : GrvData -> Text
  grv-title (d) =
    if d.gd-ok == False then "Review -- no fact store on this medium"
    else "Review -- " & show (grv-count d) & " proposals, " & show (grv-open-count (d.gd-proposals) 0 0) & " open   (store at LBA " & show (d.gd-base) & ", " & show (d.gd-facts) & " facts)"

  grv-list-tree : GrvData, Integer, Integer -> WidgetNode
  grv-list-tree (d) (sel) (content-h) =
    widget-panel "grv-root" DirColumn 6 [
      widget-label "grv-title" (grv-title d),
      widget-separator "grv-sep",
      data-table-widget (grv-table d sel content-h),
      widget-set-flex (widget-panel "grv-fill" DirColumn 0 []) 1,
      widget-separator "grv-sep2",
      widget-label "grv-help" "up/down select   Enter opens"
    ]

Section: The Detail

  grv-verdict-rows : List Verdict, Integer, Integer, List WidgetNode -> List WidgetNode
  grv-verdict-rows (vs) (cpl) (i) (acc) =
    if i >= list-length vs then acc
    else let txt = "  " & grv-verdict-line (list-at vs i)
    in let one = grv-cap-lines (grv-wrap-lines txt cpl 0 []) 1 cpl
    in let head = if list-length one == 0 then "" else list-at one 0
    in let lbl = widget-set-min (widget-label ("grv-v-" & show i) head) 0 18
    in grv-verdict-rows vs cpl (i + 1) (list-push acc lbl)

  grv-detail-tree : GrvData, Integer, Integer, Maybe Text, Integer, Integer, Text -> WidgetNode
  grv-detail-tree (d) (sel) (rs) (signer) (wrap-w) (view-rows) (prompt) =
    let p = list-at (d.gd-proposals) sel
    in let vs = grv-verdicts-for (d.gd-verdicts) (p.id) 0 []
    in let cpl = grv-cpl wrap-w
    in let measuring = view-rows <= 0
    in let lines = if measuring then [""] else grv-body-lines d sel cpl
    in let labels = grv-line-labels "grv-body" lines 0 []
    in let vr = if measuring then 1 else view-rows
    in let st = scroll-to (scroll-new 0 (vr * grv-row-h) 0 (list-length labels * grv-row-h)) 0 (if measuring then 0 else grv-scroll-y rs)
    in let kept = if measuring then 0 else poke-32 rs grv-scroll-cell (st.scr-offset-y)
    in let keptv = if measuring then 0 else poke-32 rs grv-view-cell vr
    in let region = widget-set-flex (widget-panel "grv-body-row" DirRow 4 [
        widget-set-flex (widget-panel "grv-body-col" DirColumn 6 (scroll-slice labels st grv-row-h)) 1,
        scroll-bar-or-gap "grv-bar" st
      ]) 0
    in let head = [
        widget-label "grv-title" ("Proposal " & grv-short (p.id) 16 & "  " & proposal-status-name (p.status)),
        widget-separator "grv-sep",
        widget-set-min (widget-label "grv-target" ("Target:   " & grv-target-text (p.target))) 0 18,
        widget-set-min (widget-label "grv-author" ("Author:   " & p.author-fingerprint)) 0 18,
        widget-set-min (widget-label "grv-when" ("When:     " & show (p.timestamp))) 0 18
      ]
    in let mid = [
        widget-separator "grv-sep3",
        widget-set-min (widget-label "grv-vhead" ("Verdicts: " & show (list-length vs))) 0 18
      ]
    in let idle = when signer
        is None -> "Identity locked: verdicts cannot be cast this boot"
        is Just (fp) -> "Signing as " & fp & "   a accept   r reject   b abstain"
    in let who = if text-length prompt == 0 then idle else prompt
    in let help = if text-length prompt == 0 then "up/down scrolls   Esc back to the list   " & scroll-label st grv-row-h else "Enter casts   Esc cancels   a reason is optional"
    in let tail = [
        widget-set-flex (widget-panel "grv-fill" DirColumn 0 []) 1,
        widget-set-min (widget-label "grv-who" who) 0 18,
        widget-label "grv-help" help
      ]
    in let sep2 = [widget-separator "grv-sep2"]
    in widget-panel "grv-root" DirColumn 6 (head & sep2 & [region] & mid & grv-verdict-rows vs cpl 0 [] & tail)

  grv-prompt-text : Integer -> Text
  grv-prompt-text (rs) =
    if grv-mode rs == grv-mode-reason then verdict-kind-name (grv-kind-of (peek-32 rs grv-kind-cell)) & ":  " & grv-reason-text rs & "_"
    else ""

  grv-pick-text : GrvData, Integer -> Text
  grv-pick-text (d) (rs) =
    if grv-mode rs /= grv-mode-pick then ""
    else let i = peek-32 rs grv-pick-cell
    in if i < 0 then "" else if i >= grv-count d then ""
    else "Superseded by:  " & grv-short ((list-at (d.gd-proposals) i).id) 12 & "  " & (list-at (d.gd-proposals) i).description

  grv-in-detail : Integer -> Boolean
  grv-in-detail (rs) = if grv-mode rs == grv-mode-detail then True else if grv-mode rs == grv-mode-reason then True else grv-mode rs == grv-mode-pick

  grv-tree : GrvData, Integer, Maybe Text, Integer, Integer, Integer -> WidgetNode
  grv-tree (d) (rs) (signer) (content-h) (wrap-w) (view-rows) =
    if grv-in-detail rs & grv-count d > 0 then grv-detail-tree d (grv-sel rs) rs signer wrap-w view-rows (if grv-mode rs == grv-mode-pick then grv-pick-text d rs else grv-prompt-text rs)
    else grv-list-tree d (grv-sel rs) content-h

Section: Keys

  grv-key-list : Integer, Integer, Integer -> Integer
  grv-key-list (rs) (sc) (n) =
    if sc == 72 then let d = grv-set-sel rs (grv-sel rs - 1) n in 1
    else if sc == 80 then let d = grv-set-sel rs (grv-sel rs + 1) n in 1
    else if sc == 28 then (if n > 0 then let z = grv-set-scroll rs 0 in let d = grv-set-mode rs grv-mode-detail in 1 else 0)
    else 0

  grv-key-detail : Integer, Integer, Integer -> Integer
  grv-key-detail (rs) (sc) (can) =
    if sc == 1 then let d = grv-set-mode rs grv-mode-list in 1
    else if sc == 72 then let d = grv-set-scroll rs (grv-scroll-y rs - grv-row-h) in 1
    else if sc == 80 then let d = grv-set-scroll rs (grv-scroll-y rs + grv-row-h) in 1
    else if sc == 73 then let d = grv-set-scroll rs (grv-scroll-y rs - grv-view-rows rs * grv-row-h) in 1
    else if sc == 81 then let d = grv-set-scroll rs (grv-scroll-y rs + grv-view-rows rs * grv-row-h) in 1
    else if sc == 71 then let d = grv-set-scroll rs 0 in 1
    else if sc == 31 then grv-begin-pick rs
    else if can == 0 then 0
    else if sc == 30 then grv-begin-reason rs 3
    else if sc == 19 then grv-begin-reason rs 4
    else if sc == 48 then grv-begin-reason rs 5
    else 0

  grv-begin-reason : Integer, Integer -> Integer
  grv-begin-reason (rs) (kind) =
    let k = poke-32 rs grv-kind-cell kind
    in let c = poke-32 rs grv-rlen-cell 0
    in let m = grv-set-mode rs grv-mode-reason
    in 1

  grv-begin-pick : Integer -> Integer
  grv-begin-pick (rs) =
    let o = poke-32 rs grv-old-cell (grv-sel rs)
    in let p = poke-32 rs grv-pick-cell (grv-sel rs)
    in let m = grv-set-mode rs grv-mode-pick
    in 1

  grv-key-pick : Integer, Integer, Integer -> Integer
  grv-key-pick (rs) (sc) (n) =
    if sc == 1 then let d = grv-set-mode rs grv-mode-detail in 1
    else if sc == 72 then let d = grv-set-pick rs (peek-32 rs grv-pick-cell - 1) n in 1
    else if sc == 80 then let d = grv-set-pick rs (peek-32 rs grv-pick-cell + 1) n in 1
    else if sc == 28 then let d = grv-set-mode rs grv-mode-detail in 6
    else 0

  grv-set-pick : Integer, Integer, Integer -> Integer
  grv-set-pick (rs) (i) (n) =
    poke-32 rs grv-pick-cell (if i < 0 then 0 else if n <= 0 then 0 else if i >= n then n - 1 else i)

  grv-key-reason : Integer, Integer, Integer -> Integer
  grv-key-reason (rs) (sc) (md) =
    if sc == 1 then let d = grv-set-mode rs grv-mode-detail in 1
    else if sc == 28 then let d = grv-set-mode rs grv-mode-detail in peek-32 rs grv-kind-cell
    else if sc == 14 then let d = grv-back rs in 1
    else if sc >= 128 then 0
    else let ch = apply-mods (scancode-to-keycode sc) md
    in if ch >= 32 & ch < 127 then let d = grv-type rs ch in 1 else 0

  grv-key : Integer, Integer, Integer, Integer, Integer -> Integer
  grv-key (rs) (sc) (n) (md) (can) =
    if grv-mode rs == grv-mode-reason then grv-key-reason rs sc md
    else if grv-mode rs == grv-mode-pick then grv-key-pick rs sc n
    else if grv-mode rs == grv-mode-detail then grv-key-detail rs sc can
    else grv-key-list rs sc n

Section: Casting

  grv-kind-of : Integer -> VerdictKind
  grv-kind-of (r) = if r == 3 then Accept else if r == 4 then Reject else Abstain

  grv-supersede : GrvData, Integer, Integer -> [Device.Port] Integer
  grv-supersede (d) (rs) (ts) = act
    let old-i = peek-32 rs grv-old-cell
    in let new-i = peek-32 rs grv-pick-cell
    in if old-i == new-i then 0
    else if old-i < 0 then 0
    else if new-i < 0 then 0
    else if old-i >= grv-count d then 0
    else if new-i >= grv-count d then 0
    else act
      let po = list-at (d.gd-proposals) old-i
      in let pn = list-at (d.gd-proposals) new-i
      in act
        st <- gfs-mount
        if st.gfs-ok == False then 0
        else act
          w <- gfs-write-and-checkpoint st persist-kind-supersession (supersession-to-persist-text (create-supersession (po.id) (pn.id) ts)) ts
          if w.gfs-count == st.gfs-count + 1 then 1 else 0
        end
      end
    end
  end

  grv-cast : GrvData, Integer, Integer, Integer -> [Device.Port, Identity] Integer
  grv-cast (d) (rs) (r) (ts) = act
    if grv-count d <= 0 then 0
    else act
      let p = list-at (d.gd-proposals) (grv-sel rs)
      in act
        v0 <- create-verdict-loaded (p.id) (grv-kind-of r) (grv-reason-text rs) ts
        when v0
          is None -> 0
          is Just (v) -> act
            st <- gfs-mount
            if st.gfs-ok == False then 0
            else act
              w <- gfs-write-and-checkpoint st persist-kind-verdict (verdict-to-persist-text v) ts
              if w.gfs-count == st.gfs-count + 1 then 1 else 0
            end
          end
      end
    end
  end
