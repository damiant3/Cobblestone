Chapter: RendererWeightRange
  cites Engine chapter Renderer3D
  cites Engine chapter RendererWork
  cites Foreword chapter Console

  rwr-vertex : Integer, Integer, Integer -> ProjVert
  rwr-vertex (x) (y) (depth) =
    let v = rw-vertex-new 0
    in let a = __record-set v "pv-sx" x
    in let b = __record-set v "pv-sy" y
    in __record-set v "pv-depth" depth

  opening : [Console] Nothing = act
    let a = rwr-vertex (-100000) (-100000) 0
    in let b = rwr-vertex 100000 (-100000) 1000
    in let c = rwr-vertex 0 100000 2000
    in let plain = r3d-target-new 2 2 0
    in let shaded = r3d-target-new 2 2 0
    in let reverse = r3d-target-new 2 2 0
    in let ctx = r3d-shade-ctx-flat 42
    in let p = r3d-scan-cols plain a b c 42 0 0 0
    in let s = r3d-scan-cols-sh shaded a b c ctx 0 0 0 0
    in let r = r3d-scan-cols-sh reverse a c b ctx 0 0 0 0
    in act
      print-line ("plain " & show (peek-32 (plain.r3t-base) 0 == 42 & peek-32 (plain.r3t-depth) 0 == 1250))
      print-line ("shaded " & show (peek-32 (shaded.r3t-base) 0 == 42 & peek-32 (shaded.r3t-depth) 0 == 1250))
      print-line ("reverse-winding " & show (peek-32 (reverse.r3t-base) 0 == 42 & peek-32 (reverse.r3t-depth) 0 == 1250))
    end
  end

