 We say:

Section: BMP Encoding

  shot-row-bytes : Integer -> Integer
  shot-row-bytes (w) = bit-and (w * 3 + 3) (-4)

  shot-header : Integer, Integer, Integer, Integer -> Integer
  shot-header (buf) (w) (h) (size) =
    let a = poke-byte buf 0 66
    in let b = poke-byte buf 1 77
    in let c = gfat-put-u32 buf 2 size
    in let d = gfat-put-u32 buf 6 0
    in let e = gfat-put-u32 buf 10 54
    in let f = gfat-put-u32 buf 14 40
    in let g = gfat-put-u32 buf 18 w
    in let i = gfat-put-u32 buf 22 h
    in let j = gfat-put-u16 buf 26 1
    in let k = gfat-put-u16 buf 28 24
    in let l = gfat-put-u32 buf 30 0
    in let m = gfat-put-u32 buf 34 (size - 54)
    in let n = gfat-put-u32 buf 38 2835
    in let o = gfat-put-u32 buf 42 2835
    in let p = gfat-put-u32 buf 46 0
    in gfat-put-u32 buf 50 0

  shot-copy-row : Integer, Integer, Integer, Integer -> Integer
  shot-copy-row (dst) (src) (w) (x) =
    if x >= w then 0
    else let a = poke-byte dst (x * 3) (peek-byte src (x * 4))
    in let b = poke-byte dst (x * 3 + 1) (peek-byte src (x * 4 + 1))
    in let c = poke-byte dst (x * 3 + 2) (peek-byte src (x * 4 + 2))
    in shot-copy-row dst src w (x + 1)

  shot-copy-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  shot-copy-rows (buf) (base) (w) (h) (stride) (rb) (y) =
    if y >= h then 0
    else let r = shot-copy-row (buf + 54 + y * rb) (base + (h - 1 - y) * stride * 4) w 0
    in shot-copy-rows buf base w h stride rb (y + 1)

Section: Naming

  shot-digit2 : Integer, Integer, Integer -> Integer
  shot-digit2 (buf) (off) (v) =
    let a = poke-byte buf off (48 + v / 10)
    in poke-byte buf (off + 1) (48 + int-mod v 10)

  shot-name : Integer, Integer, Integer, Integer -> Integer
  shot-name (buf) (hh) (mm) (ss) =
    let a = poke-byte buf 0 83
    in let b = poke-byte buf 1 72
    in let c = shot-digit2 buf 2 hh
    in let d = shot-digit2 buf 4 mm
    in let e = shot-digit2 buf 6 ss
    in let f = poke-byte buf 8 66
    in let g = poke-byte buf 9 77
    in poke-byte buf 10 80

  shot-bcd : Integer -> Integer
  shot-bcd (n) = (n / 16) * 10 + int-mod n 16

  shot-pad2 : Integer -> Text
  shot-pad2 (n) = if n < 10 then "0" & show n else show n

Section: Capture

  shot-diag-text : Text -> Text
  shot-diag-text (what) =
    what & " s" & show (xdiag-get gfat-cell-stage)
    & " m" & show med-selected
    & " c" & show (xdiag-get msc-cell-lastcc)
    & " p" & show (xdiag-get msc-cell-phase)
    & " w" & show (xdiag-get gfat-cell-write)
    & " f" & show (xdiag-get msc-cell-fuel-lo)
    & " l" & show (xdiag-get msc-cell-fail-lba)
    & " r" & show (xdiag-get msc-cell-retry)

  shot-no-room : Fat16Volume, Integer -> [Device.Port] Text
  shot-no-room (vol) (size) = act
    f <- gfat-load-fat vol
    let cb = (vol.vol-bytes-per-sector) * (vol.vol-sectors-per-cluster)
    in let free = if f.gft-ok == False then 0 else gfat-count-free vol (f.gft-buf) 2 (gfat-max-cluster vol) 0
    in "shot needs " & show (size / 1024) & " KB, medium has " & show (free * cb / 1024) & " KB free"
  end

  shot-take : Integer, Integer, Integer, Integer -> [Device.Port] Text
  shot-take (base) (w) (h) (stride) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then shot-diag-text "shot: no ESP"
    else act
      rh <- rtc-read 4
      rm <- rtc-read 2
      ss <- rtc-seconds 0
      let hh = shot-bcd rh
      in let mi = shot-bcd rm
      in let s2 = if ss < 0 then 0 else ss
      in let rb = shot-row-bytes w
      in let size = 54 + rb * h
      in let buf = alloc-zeroed (bit-and (size + 511) (-512)) 64
      in let hd = shot-header buf w h size
      in let px = shot-copy-rows buf base w h stride rb 0
      in let nb = alloc-zeroed 16 16
      in let nm = shot-name nb hh mi s2
      in act
        ok <- gfat-write-file (m.gm-vol) nb buf size
        if ok then "shot SH" & shot-pad2 hh & shot-pad2 mi & shot-pad2 s2 & ".BMP ok"
        else if xdiag-get gfat-cell-write == gfat-w-nospace then shot-no-room (m.gm-vol) size
        else shot-diag-text "shot write FAILED"
      end
    end
  end

Section: Probe Wait

  shot-hint : Integer, Integer, Integer, Integer, Integer, CbfFont, Integer -> Integer
  shot-hint (base) (w) (h) (stride) (rows) (font) (med) =
    let scale = if w >= 1024 then 2 else 1
    in let y = h - 50
    in let bg = gop-fill-rect base stride rows 0 y w (h - y) 1710638
    in gop-draw-text base stride rows font 40 y (if med == 0 then "F12 shots OFF: no medium carrying CODEX.CDX" else "F12 saves the screen to the stick") (if med == 0 then 16755200 else 9474192) scale 0

  shot-spin : Integer -> Integer
  shot-spin (n) = shot-spin (n + 1)

  shot-loop : Integer, Integer, Integer, Integer, CbfFont, UsbKbd -> [Device.Port] Integer
  shot-loop (base) (w) (h) (stride) (font) (kbd) = act
    sc <- kbd-take kbd
    if sc == 88 then act
      let mark = __heap-save
      in act
        t <- shot-take base w h stride
        let scale = if w >= 1024 then 2 else 1
        in let y = h - 50
        in let bg = gop-fill-rect base stride h 0 y w (h - y) 1710638
        in let tx = gop-draw-text base stride h font 40 y t 65280 scale 0
        in let r = __heap-restore mark
        in shot-loop base w h stride font kbd
      end
    end
    else shot-loop base w h stride font kbd
  end

  shot-wait : Integer, Integer, Integer, Integer, CbfFont, UsbKbd -> [Device.Port] Integer
  shot-wait (base) (w) (h) (stride) (font) (kbd) = act
    med <- medium-select
    let hint = shot-hint base w h stride h font med
    in if med == 0 then shot-spin 0
    else shot-loop base w h stride font kbd
  end

Section: Bounded Window

  shot-window-fuel : Integer = 500000000

  shot-window : Integer, Integer, Integer, Integer, CbfFont, UsbKbd, Integer -> [Device.Port] Integer
  shot-window (base) (w) (h) (stride) (font) (kbd) (secs) = act
    med <- medium-select
    if med == 0 then 0
    else act
      let scale = if w >= 1024 then 2 else 1
      in let y = h - 50
      in let hint = gop-draw-text base stride h font 40 y ("F12 saves the screen (" & show secs & "s window), then the arm runs") 16776960 scale 0
      in act
        r <- rtc-seconds 0
        shot-window-loop base w h stride font kbd r 0 secs 0
      end
    end
  end

  shot-window-loop : Integer, Integer, Integer, Integer, CbfFont, UsbKbd, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  shot-window-loop (base) (w) (h) (stride) (font) (kbd) (prev) (elapsed) (secs) (spins) = act
    if elapsed >= secs then 0
    else if spins >= shot-window-fuel then 0
    else act
      sc <- kbd-take kbd
      now <- rtc-seconds 0
      let tick = now >= 0 & now /= prev
      in let e2 = if tick then elapsed + 1 else elapsed
      in let p2 = if now >= 0 then now else prev
      in if sc == 88 then act
        let mark = __heap-save
        in act
          t <- shot-take base w h stride
          let scale = if w >= 1024 then 2 else 1
          in let y = h - 50
          in let bg = gop-fill-rect base stride h 0 y w (h - y) 1710638
          in let tx = gop-draw-text base stride h font 40 y t 65280 scale 0
          in let rr = __heap-restore mark
          in shot-window-loop base w h stride font kbd p2 e2 secs (spins + 1)
        end
      end
      else shot-window-loop base w h stride font kbd p2 e2 secs (spins + 1)
    end
  end
