 We say:

Section: Serve One Request

  ts-buf-to-list : Integer, Integer, Integer, List Integer -> List Integer
  ts-buf-to-list (buf) (i) (n) (acc) =
    if i >= n then acc
    else ts-buf-to-list buf (i + 1) n (list-push acc (peek-byte buf i))

  tab-serve-one : (HttpRequest -> HttpResponse) -> [Console, FileSystem] Nothing
  tab-serve-one (route) = act
    raw <- read-file-raw ""
    let req = http-parse-request (ts-buf-to-list ((address-of raw) + 4) 0 (text-length raw) [])
    in let resp = if req.valid then web-dispatch route web-observe-none web-new req else http-error "Bad request"
    in write-binary (http-encode resp)
  end
