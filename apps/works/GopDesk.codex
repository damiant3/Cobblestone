 We say:

Section: Palette and Layout

  dk-col-bar : Integer = #002244
  dk-col-wall : Integer = #001428
  dk-col-task : Integer = #000E1C
  dk-col-win : Integer = #003366
  dk-col-title : Integer = #004488
  dk-col-text : Integer = #A5ACAF
  dk-col-bright : Integer = #FFFFFF
  dk-col-hint : Integer = #69BE28
  dk-col-warn : Integer = #FFB040

  dk-bar-h : Integer = 22
  dk-task-h : Integer = 28

  dk-task-band-cell : Integer = 76

  dk-task-px : Integer, Integer -> Integer
  dk-task-px (ds) (w) =
    let c = peek-32 ds dk-task-band-cell
    in if c <= 0 then dk-task-h * ui-wscale w else c

  dk-task-w : Integer = 120

  dk-edge-bottom : Integer = 0
  dk-edge-top : Integer = 1
  dk-edge-left : Integer = 2
  dk-edge-right : Integer = 3

  dk-task-edge-cell : Integer = 168

  dk-task-edge : Integer -> Integer
  dk-task-edge (ds) = peek-32 ds dk-task-edge-cell

  dk-task-vertical : Integer -> Boolean
  dk-task-vertical (ds) = dk-task-edge ds >= dk-edge-left
  dk-win-w : Integer = 360
  dk-title-h : Integer = 20
  dk-body-y0 : Integer = 32
  dk-line-h : Integer = 18
  dk-para-gap : Integer = 6

  dk-win-pad-b : Integer = 30

  dk-palette : Palette
  dk-palette = Palette {
    pal-bg = dk-col-wall,
    pal-fg = dk-col-text,
    pal-primary = dk-col-hint,
    pal-secondary = dk-col-title,
    pal-accent = dk-col-bright,
    pal-muted = dk-col-task,
    pal-error = dk-col-warn,
    pal-success = dk-col-hint,
    pal-warning = dk-col-warn,
    pal-border = dk-col-bar
  }

Section: Appearance

  dk-scheme-cell : Integer = 52
  dk-adorn-cell : Integer = 56
  dk-sound-cell : Integer = 64
  dk-sound-on-cell : Integer = 68
  dk-icons-cell : Integer = 72

  dk-cal-cell : Integer = 84
  dk-dif-cell : Integer = 88
  dk-sty-cell : Integer = 92

  dk-trk-cell : Integer = 96

  dk-mon-cell : Integer = 100
  dk-mon-kbd-cell : Integer = 0
  dk-mon-mouse-cell : Integer = 4

  dk-scene-cell : Integer = 104
  dk-fish-cell : Integer = 108

  dk-bro-cell : Integer = 112

  dk-files-cell : Integer = 116

  dk-adorn-border : Integer = 1
  dk-adorn-gradient : Integer = 2
  dk-adorn-shadow : Integer = 4
  dk-adorn-round : Integer = 8

  dk-adorn-default : Integer = 15

  dk-adorn-on : Integer, Integer -> Boolean
  dk-adorn-on (flags) (bit) = bit-and flags bit /= 0

  dk-on-off : Integer, Integer -> Text
  dk-on-off (flags) (bit) = if dk-adorn-on flags bit then "on" else "off"

  dk-adorn-flip : Integer, Integer -> Integer
  dk-adorn-flip (flags) (bit) = if dk-adorn-on flags bit then flags - bit else flags + bit

  dk-scheme-count : Integer = 6

  dk-lang : Integer -> DesignLanguage
  dk-lang (i) = if i == 4 then sk-flightdeck else sk-chevy

  dk-is-lang : Integer -> Boolean
  dk-is-lang (i) = i >= 4

  dk-scheme-name : Integer -> Text
  dk-scheme-name (i) =
    if dk-is-lang i then (dk-lang i).dl-name
    else if i == 1 then "terminal" else if i == 2 then "lcars" else if i == 3 then "minimal" else "seahawk"

  dk-scheme-palette : Integer -> Palette
  dk-scheme-palette (i) =
    if dk-is-lang i then (dk-lang i).dl-palette
    else if i == 1 then palette-terminal else if i == 2 then palette-lcars else if i == 3 then palette-minimal else dk-palette

Section: Appearance That Survives A Reboot

  dk-set-scheme : Integer = 1
  dk-set-adorn : Integer = 2
  dk-set-sound : Integer = 3
  dk-set-edge : Integer = 4

  dk-set-pinned : Integer = 5

  dk-pinned-all : Integer = 524287

  dk-settings-keys : List SettingKey
  dk-settings-keys = [
    gst-int-key dk-set-scheme "colour scheme" 0 0 (dk-scheme-count - 1),
    gst-int-key dk-set-adorn "adornments" dk-adorn-default 0 15,
    gst-int-key dk-set-sound "sounds" 0 0 1,
    gst-int-key dk-set-edge "task frame edge" dk-edge-bottom dk-edge-bottom dk-edge-right,
    gst-int-key dk-set-pinned "pinned apps" 0 0 dk-pinned-all
  ]

  dk-settings-of : Integer -> SettingsStore
  dk-settings-of (ds) =
    let s0 = gst-store dk-settings-keys
    in let s1 = gst-or-keep s0 (gst-set s0 dk-set-scheme (peek-32 ds dk-scheme-cell))
    in let s2 = gst-or-keep s1 (gst-set s1 dk-set-adorn (peek-32 ds dk-adorn-cell))
    in let s3 = gst-or-keep s2 (gst-set s2 dk-set-sound (peek-32 ds dk-sound-on-cell))
    in let s4 = gst-or-keep s3 (gst-set s3 dk-set-edge (dk-task-edge ds))
    in gst-or-keep s4 (gst-set s4 dk-set-pinned (peek-32 ds dk-pinned-cell))

  dk-settings-save : Integer -> [Device.Port] Boolean
  dk-settings-save (ds) = gst-save (dk-settings-of ds)

  dk-settings-into : Integer, SettingsStore -> Integer
  dk-settings-into (ds) (st) =
    let sp = poke-32 ds dk-scheme-cell (gst-get st dk-set-scheme 0)
    in let ap = poke-32 ds dk-adorn-cell (gst-get st dk-set-adorn dk-adorn-default)
    in let sn = poke-32 ds dk-sound-on-cell (gst-get st dk-set-sound 0)
    in let ep = poke-32 ds dk-task-edge-cell (gst-get st dk-set-edge dk-edge-bottom)
    in poke-32 ds dk-pinned-cell (gst-get st dk-set-pinned 0)

Section: Sound

  dk-snd-blk-buf : Integer = 16
  dk-snd-blk-len : Integer = 20
  dk-snd-blk-req : Integer = 48
  dk-snd-blk-focus : Integer = 52
  dk-snd-slot-click : Integer = 0
  dk-snd-slot-focus : Integer = 1
  dk-snd-slot-error : Integer = 2
  dk-snd-slot-notify : Integer = 3

  dk-snd-focus-fx : SoundEffect
  dk-snd-focus-fx = sound-effect "focus" WavSine 600 40 200

  dk-snd-render : Integer, Integer, SoundEffect -> Integer
  dk-snd-render (blk) (slot) (fx) =
    let n = hda-sample-rate * fx.snd-duration / 1000
    in let buf = hda-square-tone-at (fx.snd-freq) n (hda-amplitude * fx.snd-volume / 1000)
    in let b0 = poke-32 blk (dk-snd-blk-buf + slot * 8) buf
    in poke-32 blk (dk-snd-blk-len + slot * 8) (n * 4)

  dk-snd-init : Integer -> Integer
  dk-snd-init (ds) =
    let blk = alloc-zeroed 64 128
    in let r0 = dk-snd-render blk dk-snd-slot-click snd-click
    in let r1 = dk-snd-render blk dk-snd-slot-focus dk-snd-focus-fx
    in let r2 = dk-snd-render blk dk-snd-slot-error snd-error
    in let r3 = dk-snd-render blk dk-snd-slot-notify snd-success
    in poke-32 ds dk-sound-cell blk

  dk-snd-play-slot : Integer, Integer -> [Audio] Integer
  dk-snd-play-slot (ds) (slot) =
    let blk = peek-32 ds dk-sound-cell
    in if peek-32 ds dk-sound-on-cell == 0 then 0
    else if blk == 0 then 0
    else hda-play-pcm-at blk (peek-32 blk (dk-snd-blk-buf + slot * 8)) (peek-32 blk (dk-snd-blk-len + slot * 8))

  dk-snd-play : Integer -> [Audio] Integer
  dk-snd-play (ds) = dk-snd-play-slot ds dk-snd-slot-click

  dk-snd-click : Integer, Boolean -> [Audio] Integer
  dk-snd-click (ds) (clicked) = if clicked then dk-snd-play ds else 0

  dk-snd-request : Integer, Integer -> Integer
  dk-snd-request (ds) (slot) =
    let blk = peek-32 ds dk-sound-cell
    in if blk == 0 then 0 else poke-32 blk dk-snd-blk-req (slot + 1)

  dk-snd-pump : Integer -> [Audio] Integer
  dk-snd-pump (ds) =
    let blk = peek-32 ds dk-sound-cell
    in if blk == 0 then 0
    else let r = peek-32 blk dk-snd-blk-req
    in if r == 0 then 0
    else let c = poke-32 blk dk-snd-blk-req 0
    in dk-snd-play-slot ds (r - 1)

  dk-snd-focus-note : Integer -> [Audio] Integer
  dk-snd-focus-note (ds) =
    let blk = peek-32 ds dk-sound-cell
    in if blk == 0 then 0
    else let f = peek-32 ds desk-focus-cell
    in let last = peek-32 blk dk-snd-blk-focus
    in let w = poke-32 blk dk-snd-blk-focus f
    in if f == last | f == desk-focus-none | last == desk-focus-none then 0
    else dk-snd-play-slot ds dk-snd-slot-focus

Section: Drawn Icons

  dk-icons-size : Integer -> Integer
  dk-icons-size (blk) = peek-32 blk 0

  dk-icons-at : Integer, Text -> Integer
  dk-icons-at (blk) (name) = peek-32 blk (4 + 4 * gicon-drawn-slot name 0)

  dk-icons-render : Integer, Integer, Integer -> Integer
  dk-icons-render (blk) (n) (i) =
    if i >= gicon-drawn-count then 0
    else let w = poke-32 blk (4 + 4 * i) (gicon-render (gicon-vec-named (gicon-drawn-name i)) n)
    in dk-icons-render blk n (i + 1)

  dk-icon-px : Integer -> Integer
  dk-icon-px (avail) = if avail < 8 then 8 else avail * 4 / 5

  dk-icons-init : Integer, GopFont, Integer -> Integer
  dk-icons-init (ds) (tf) (w) =
    let ws = ui-wscale w
    in let avail = desk-text-w tf ws desk-chrome-gutter
    in let n = dk-icon-px avail
    in let blk = alloc-zeroed (8 + 4 * gicon-drawn-count) 64
    in let sp = poke-32 blk 0 n
    in let r = dk-icons-render blk n 0
    in poke-32 ds dk-icons-cell blk

Section: Chrome

  dk-corner-r : Integer = 6

  dk-corner : Integer -> CornerStyle
  dk-corner (f) = if dk-adorn-on f dk-adorn-round then CornerRound dk-corner-r else CornerSharp

  dk-bdr : Integer, Integer, Integer -> Border
  dk-bdr (f) (c) (n) = border-uniform (if dk-adorn-on f dk-adorn-border then n else 0) c (dk-corner f)

  dk-grad : Integer, Integer, Integer -> Gradient
  dk-grad (f) (a) (b) = if dk-adorn-on f dk-adorn-gradient then gradient-v a b else gradient-none

  dk-shade : Integer -> Shadow
  dk-shade (f) = if dk-adorn-on f dk-adorn-shadow then shadow-subtle 0 else shadow-none

  dk-theme-of : Integer, Integer -> Theme
  dk-theme-of (scheme) (f) =
    if dk-is-lang scheme then sk-theme (dk-lang scheme)
    else dk-theme-palette scheme f

  dk-theme-palette : Integer, Integer -> Theme
  dk-theme-palette (scheme) (f) =
    let pal = dk-scheme-palette scheme
    in let bdr = dk-bdr f (pal.pal-border) 1
    in let pad = edges-uniform 4
    in let mar = edges-uniform 2
    in let sh = dk-shade f
    in let base = widget-style-rich (pal.pal-bg) (pal.pal-fg) border-none pad edges-zero shadow-none (dk-grad f (pal.pal-bg) (pal.pal-muted)) accent-border-none
    in let btn = widget-style-rich (pal.pal-primary) (pal.pal-bg) bdr pad mar sh (dk-grad f (pal.pal-primary) (pal.pal-secondary)) accent-border-none
    in let btn-h = widget-style-rich (pal.pal-accent) (pal.pal-bg) bdr pad mar sh (dk-grad f (pal.pal-accent) (pal.pal-primary)) accent-border-none
    in let btn-p = widget-style-rich (pal.pal-secondary) (pal.pal-fg) bdr pad mar shadow-none (dk-grad f (pal.pal-secondary) (pal.pal-bg)) accent-border-none
    in let btn-d = widget-style (pal.pal-muted) (pal.pal-muted) bdr pad mar
    in let inp = widget-style (pal.pal-bg) (pal.pal-fg) (dk-bdr f (pal.pal-muted) 1) pad mar
    in let inp-f = widget-style (pal.pal-bg) (pal.pal-fg) (dk-bdr f (pal.pal-accent) 2) pad mar
    in let lbl = widget-style 0 (pal.pal-fg) border-none edges-zero mar
    in let sep = widget-style (pal.pal-border) (pal.pal-border) border-none edges-zero (edges-xy 0 4)
    in Theme {
      th-name = dk-scheme-name scheme,
      th-palette = pal,
      th-panel = state-styles-flat base,
      th-button = StateStyles { ss-normal = btn, ss-hover = btn-h, ss-pressed = btn-p, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = state-styles-flat lbl,
      th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = state-styles-flat (widget-style (pal.pal-bg) (pal.pal-primary) bdr (edges-uniform 2) mar),
      th-separator = state-styles-flat sep
    }

  dk-theme-ds : Integer -> Theme
  dk-theme-ds (ds) = dk-theme-of (peek-32 ds dk-scheme-cell) (peek-32 ds dk-adorn-cell)

  dk-pal : Integer -> Palette
  dk-pal (ds) = dk-scheme-palette (peek-32 ds dk-scheme-cell)

  dk-wall : Integer -> Integer
  dk-wall (ds) = (dk-pal ds).pal-bg

  dk-gpu : Integer -> Integer
  dk-gpu (ds) = peek-32 ds desk-gpu-cell

Section: Window Metrics

  dk-win-fits : Integer, Integer, GopFont, Integer, Integer -> Boolean
  dk-win-fits (w) (h) (tf) (s) (ds) = dk-win-h tf s * s <= dk-cbox-h w h ds

  dk-win-s : Integer, Integer, GopFont, Integer -> Integer
  dk-win-s (w) (h) (tf) (ds) =
    let s = ui-scale w
    in if dk-win-fits w h tf s ds then s
    else 1

  dk-win-x : Integer, Integer, Integer -> Integer
  dk-win-x (w) (s) (ds) =
    dk-cbox-x w ds + (dk-cbox-w w ds - dk-win-w * s) / 2

  dk-win-y : Integer, Integer, Integer, GopFont, Integer -> Integer
  dk-win-y (w) (h) (s) (tf) (ds) =
    dk-cbox-y w ds + (dk-cbox-h w h ds - dk-win-h tf s * s) / 2

Section: RTC

  dk-bcd : Integer -> Integer
  dk-bcd (n) = (n / 16) * 10 + int-mod n 16

  dk-pad2 : Integer -> Text
  dk-pad2 (n) = if n < 10 then "0" & show n else show n

Section: Chrome

  desk-gpu-cell : Integer = 48

  desk-console-cell : Integer = 36

  desk-edit-cell : Integer = 28

  desk-mark-cell : Integer = 4
  desk-prog-cell : Integer = 44
  desk-clock-cell : Integer = 60

  desk-gpu-present : Integer -> [Gpu.Compute] Integer
  desk-gpu-present (dummy) = if gpu-in #403 == 1 then 1 else 0

  desk-task-clock-w : Integer = 220

  dk-task-clock-w-of : Integer -> Integer
  dk-task-clock-w-of (ds) =
    let cks = peek-32 ds desk-clock-cell
    in if cks == 0 then desk-task-clock-w
    else
      let want = text-length (clk-band-preview cks 2026 12 31) * 8 + 24
      in if want < desk-task-clock-w then desk-task-clock-w else want

  desk-focus-name : Integer -> Text
  desk-focus-name (fid) =
    if fid == desk-focus-files then "Files"
    else if fid == desk-focus-bro then "Web"
    else if fid == desk-focus-scene then "3D"
    else if fid == desk-focus-fish then "Fish"
    else if fid == desk-focus-edit then "Edit"
    else ""

  desk-task-text : Integer, Integer, Text -> Text
  desk-task-text (ms) (i) (acc) =
    if i >= desk-marks-depth ms then acc
    else
      let nm = desk-focus-name (desk-marks-id ms i)
      in let acc2 = if text-length nm == 0 then acc else if text-length acc == 0 then nm else acc & "   " & nm
      in desk-task-text ms (i + 1) acc2

  dk-pill-id : Integer -> Text
  dk-pill-id (fid) = "pill-" & show fid

  dk-focus-max : Integer = 18

  dk-pinned-cell : Integer = 244

  dk-ds-bytes : Integer = 512

  dk-sheet-cell : Integer = 256

  dk-bit-of : Integer -> Integer
  dk-bit-of (n) = if n <= 0 then 1 else 2 * dk-bit-of (n - 1)

  dk-fid-sc : Integer -> Integer
  dk-fid-sc (fid) =
    if fid == desk-focus-mon then 50
    else if fid == desk-focus-cal then 38
    else if fid == desk-focus-style then 30
    else if fid == desk-focus-calc then 46
    else if fid == desk-focus-clkp then 37
    else if fid == desk-focus-prog then 25
    else if fid == desk-focus-dif then 32
    else if fid == desk-focus-trk then 23
    else if fid == desk-focus-con then 20
    else if fid == desk-focus-files then 33
    else if fid == desk-focus-bro then 48
    else if fid == desk-focus-scene then 4
    else if fid == desk-focus-fish then 16
    else if fid == desk-focus-edit then 18
    else if fid == desk-focus-rev then 19
    else if fid == desk-focus-web then 17
    else if fid == desk-focus-sheet then 31
    else 0

  dk-pinned-get : Integer, Integer -> Boolean
  dk-pinned-get (ds) (fid) =
    if fid < 0 then False
    else if fid > dk-focus-max then False
    else if dk-fid-sc fid == 0 then False
    else bit-and (peek-32 ds dk-pinned-cell) (dk-bit-of fid) /= 0

  dk-pinned-toggle : Integer, Integer -> Integer
  dk-pinned-toggle (ds) (fid) =
    if fid < 0 then 0
    else if fid > dk-focus-max then 0
    else if dk-fid-sc fid == 0 then 0
    else
      let f = peek-32 ds dk-pinned-cell
      in let b = dk-bit-of fid
      in poke-32 ds dk-pinned-cell (if bit-and f b /= 0 then f - b else f + b)

  dk-pill-live : Integer, Integer, Integer -> Boolean
  dk-pill-live (ws) (ds) (fid) =
    if dk-wr-find ws fid 0 >= 0 then True else dk-pinned-get ds fid

  dk-pills : Integer, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  dk-pills (ws) (ds) (e) (fid) (acc) =
    if fid > dk-focus-max then acc
    else if dk-pill-live ws ds fid == False then dk-pills ws ds e (fid + 1) acc
    else if dk-pedge-get ds fid /= e then dk-pills ws ds e (fid + 1) acc
    else dk-pills ws ds e (fid + 1) (list-push acc (widget-set-flex (widget-button (dk-pill-id fid) (desk-chrome-gutter & desk-wnd-title fid)) 0))

  desk-pill-icons : Integer, Integer, Integer, WidgetNode, Theme, Integer, GopFont, Integer, Integer -> Integer
  desk-pill-icons (base) (stride) (rows) (laid) (th) (ws) (tf) (ds) (fid) =
    if fid > dk-focus-max then 0
    else if dk-pill-live (peek-32 ds dk-wr-cell) ds fid == False then desk-pill-icons base stride rows laid th ws tf ds (fid + 1)
    else
      let d = desk-icon-on base stride rows laid th ws tf "" desk-chrome-gutter (dk-pill-id fid) (dk-pill-icon fid) ds
      in desk-pill-icons base stride rows laid th ws tf ds (fid + 1)

  desk-taskbar : Integer, GopFont, Integer -> WidgetNode
  desk-taskbar (ds) (tf) (ws) =
    let mb = widget-button "menu" "   Cobblestone"
    in let mbh = math-max (mb.wn-min-h) (math-max comp-glyph-h (dk-task-btn-h tf ws))
    in let menu = widget-set-flex (widget-set-min-h mb mbh) 0
    in let tasks = widget-set-flex (widget-label "tasks" "") 1
    in let clock = widget-set-min (widget-label "task-clock" "") (if dk-task-vertical ds then 0 else dk-task-clock-w-of ds) 0
    in let kids = dk-pills (peek-32 ds dk-wr-cell) ds (dk-task-edge ds) 0 (list-push [] menu)
    in let kids2 = list-push (list-push kids tasks) clock
    in if dk-task-vertical ds
      then widget-set-flex (widget-set-min (widget-panel "taskbar" DirColumn 4 kids2) dk-task-w 0) 0
      else widget-set-flex (widget-set-min (widget-panel "taskbar" DirRow 4 kids2) 0 dk-task-h) 0

  dk-task-btn-h : GopFont, Integer -> Integer
  dk-task-btn-h (tf) (ws) = if tf.gf-ok then dk-line-step tf ws / ws else comp-glyph-h

  dk-task-init : Integer, GopFont, Integer -> Integer
  dk-task-init (ds) (tf) (w) =
    let mk = __heap-save
    in let ws = ui-wscale w
    in let m = widget-measure (comp-fit-text (desk-taskbar ds tf ws) tf ws) (dk-theme-ds ds)
    in let v = if dk-task-vertical ds then m.wn-min-w * ws else m.wn-min-h * ws
    in let sp = dk-strip-panel ds ws (dk-task-edge ds) [dk-strip-spec ws]
    in let ms = widget-measure (comp-fit-text sp tf ws) (dk-theme-ds ds)
    in let sv = if dk-task-vertical ds then ms.wn-min-w * ws else ms.wn-min-h * ws
    in let d = __heap-restore mk
    in poke-32 ds dk-task-band-cell (if v >= sv then v else sv)

  dk-strip-spec : Integer -> WidgetNode
  dk-strip-spec (ws) =
    let b = widget-button "strip-spec" (desk-chrome-gutter & "System Info")
    in widget-set-flex b 0

  dk-strip-panel : Integer, Integer, Integer, List WidgetNode -> WidgetNode
  dk-strip-panel (ds) (ws) (e) (kids) =
    if e >= dk-edge-left
      then widget-set-flex (widget-set-min (widget-panel "strip" DirColumn 4 kids) dk-task-w 0) 0
      else widget-set-flex (widget-set-min (widget-panel "strip" DirRow 4 kids) 0 dk-task-h) 0

  dk-strip-init : Integer, GopFont, Integer -> Integer
  dk-strip-init (ds) (tf) (w) =
    let mk = __heap-save
    in let ws = ui-wscale w
    in let row = comp-fit-text (dk-strip-panel ds ws dk-edge-bottom [dk-strip-spec ws]) tf ws
    in let col = comp-fit-text (dk-strip-panel ds ws dk-edge-left [dk-strip-spec ws]) tf ws
    in let mh = widget-measure row (dk-theme-ds ds)
    in let mv = widget-measure col (dk-theme-ds ds)
    in let hv = mh.wn-min-h * ws
    in let vv = mv.wn-min-w * ws
    in let d = __heap-restore mk
    in let a = poke-32 ds dk-strip-h-cell hv
    in poke-32 ds dk-strip-v-cell vv

  dk-topgap : Integer -> WidgetNode
  dk-topgap (w) =
    widget-set-flex (widget-set-min (widget-panel "topgap" DirColumn 0 []) 0 (dk-bar-h * ui-scale w / ui-wscale w)) 0

  dk-edge-node : Integer, GopFont, Integer, Integer -> WidgetNode
  dk-edge-node (ds) (tf) (s) (e) =
    if dk-task-edge ds == e then comp-fit-text (desk-taskbar ds tf s) tf s
    else comp-fit-text (dk-strip-panel ds s e (dk-pills (peek-32 ds dk-wr-cell) ds e 0 [])) tf s

  dk-edge-live : Integer, Integer -> Boolean
  dk-edge-live (ds) (e) = if dk-task-edge ds == e then True else dk-strip-any ds e 0

  dk-side-col : Integer, GopFont, Integer, Integer, Integer -> WidgetNode
  dk-side-col (ds) (tf) (s) (w) (e) =
    widget-set-flex (widget-panel (if e == dk-edge-left then "bandcol" else "bandcol-r") DirColumn 0 [dk-topgap w, widget-set-flex (dk-edge-node ds tf s e) 1]) 0

  desk-chrome-face : WidgetNode, Integer, Integer, GopFont -> WidgetNode
  desk-chrome-face (content) (w) (ds) (tf) =
    let s = ui-wscale w
    in let body = widget-set-flex content 1
    in let m0 = list-push [] (dk-topgap w)
    in let m1 = if dk-edge-live ds dk-edge-top then list-push m0 (dk-edge-node ds tf s dk-edge-top) else m0
    in let m2 = list-push m1 body
    in let m3 = if dk-edge-live ds dk-edge-bottom then list-push m2 (dk-edge-node ds tf s dk-edge-bottom) else m2
    in let mid = widget-set-flex (widget-panel "right" DirColumn 0 m3) 1
    in let r0 = if dk-edge-live ds dk-edge-left then list-push [] (dk-side-col ds tf s w dk-edge-left) else []
    in let r1 = list-push r0 mid
    in let r2 = if dk-edge-live ds dk-edge-right then list-push r1 (dk-side-col ds tf s w dk-edge-right) else r1
    in widget-panel "root" DirRow 0 r2

  desk-chrome-with : WidgetNode, Integer, Integer -> WidgetNode
  desk-chrome-with (content) (w) (ds) = desk-chrome-face content w ds gfont-none

  desk-chrome-gutter : Text = "   "

  desk-chrome-icons : Integer, Integer, Integer, WidgetNode, Theme, Integer, GopFont, Integer -> Integer
  desk-chrome-icons (base) (stride) (rows) (laid) (th) (ws) (tf) (ds) =
    let g = desk-chrome-gutter
    in let a = desk-icon-on base stride rows laid th ws tf "" g "menu" "menu" ds
    in let b = desk-icon-on base stride rows laid th ws tf "" g "shutdown" "power" ds
    in desk-pill-icons base stride rows laid th ws tf ds 0

  dk-chrome-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Integer -> WidgetNode
  dk-chrome-paint (base) (w) (h) (stride) (font) (tf) (tree) (ds) =
    let laid = comp-render base stride h font tf (desk-chrome-face tree w ds tf) (dk-theme-ds ds) w h (ui-wscale w)
    in let ic = desk-chrome-icons base stride h laid (dk-theme-ds ds) (ui-wscale w) tf ds
    in let inval = poke-32 ds desk-second-cell (0 - 1)
    in laid

Section: Drawing

  desk-line : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Integer, Text, Integer -> Integer
  desk-line (base) (stride) (h) (font) (s) (tf) (x) (y) (t) (fg) =
    if tf.gf-ok then gfont-text tf base stride h x y t fg
    else gop-draw-text base stride h font x y t fg s 0

  dk-wrap-cols : Integer -> Integer
  dk-wrap-cols (s) =
    let c = (dk-win-w * s - 20 * s) / (8 * s)
    in if c < 8 then 8 else c

  dk-break : Text, Integer, Integer, Integer -> Integer
  dk-break (t) (limit) (i) (best) =
    if i >= limit then best
    else if is-whitespace (char-at t i) then dk-break t limit (i + 1) i
    else dk-break t limit (i + 1) best

  dk-wrap-count : Text, Integer -> Integer
  dk-wrap-count (t) (cols) =
    let n = text-length t
    in if n <= cols then 1
    else let b = dk-break t cols 0 0
    in let cut = if b <= 0 then cols else b
    in let skip = if b <= 0 then cut else cut + 1
    in 1 + dk-wrap-count (substring t skip (n - skip)) cols

  dk-para-intro : Text = "The Cobblestone desktop frame on the bare runtime. Input arrives over USB HID or PS/2; the clock runs on PIT ticks and the CMOS RTC. No emulator devices and no frame pacing."

  dk-para-hint : Text = "The Cobblestone button on the taskbar opens the start menu, and closes it again: every app by group, with Shutdown at the foot of it. An app opens in a window you can move by its title bar, and close with the x. Files browses this stick, Edit opens a source file, Console takes commands."

  dk-para-font : GopFont -> Text
  dk-para-font (tf) = if tf.gf-ok then "Font: shared TrueType UI face from this stick's ESP." else "Font: CBF bitmap (no TTF on the ESP)."

  dk-line-step : GopFont, Integer -> Integer
  dk-line-step (tf) (s) = if tf.gf-ok then tf.gf-gh * 5 / 4 else dk-line-h * s

  dk-body-lines : GopFont, Integer -> Integer
  dk-body-lines (tf) (s) =
    let cols = dk-wrap-cols s
    in dk-wrap-count dk-para-intro cols + dk-wrap-count (dk-para-font tf) cols + dk-wrap-count dk-para-hint cols

  dk-win-h : GopFont, Integer -> Integer
  dk-win-h (tf) (s) = dk-body-y0 + dk-body-lines tf s * dk-line-step tf s / s + 2 * dk-para-gap + dk-win-pad-b

  dk-wrap-draw : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Integer, Text, Integer, Integer -> Integer
  dk-wrap-draw (base) (stride) (h) (font) (s) (tf) (x) (y) (t) (fg) (cols) =
    let n = text-length t
    in if n <= cols then desk-line base stride h font s tf x y t fg
    else let b = dk-break t cols 0 0
    in let cut = if b <= 0 then cols else b
    in let skip = if b <= 0 then cut else cut + 1
    in let l = desk-line base stride h font s tf x y (substring t 0 cut) fg
    in dk-wrap-draw base stride h font s tf x (y + dk-line-step tf s) (substring t skip (n - skip)) fg cols

  
  desk-topbar : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Integer -> Integer
  desk-topbar (base) (w) (stride) (font) (s) (tf) (h) (ds) =
    let pal = dk-pal ds
    in let bar = gop-fill-rect base stride h 0 0 w (dk-bar-h * s) (pal.pal-border)
    in desk-line base stride h font s tf (8 * s) (4 * s) "Cobblestone" (pal.pal-accent)

  desk-window : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> Integer
  desk-window (base) (w) (h) (stride) (font) (tf) (ds) =
    let pal = dk-pal ds
    in let s = dk-win-s w h tf ds
    in let wx = dk-win-x w s ds
    in let wy = dk-win-y w h s tf ds
    in let cols = dk-wrap-cols s
    in let tx = wx + 10 * s
    in let body = gop-fill-rect base stride h wx wy (dk-win-w * s) (dk-win-h tf s * s) (pal.pal-muted)
    in let title = gop-fill-rect base stride h wx wy (dk-win-w * s) (dk-title-h * s) (pal.pal-secondary)
    in let cap = desk-line base stride h font s tf (wx + 6 * s) (wy + 2 * s) "Welcome" (pal.pal-accent)
    in let y1 = wy + dk-body-y0 * s
    in let p1 = dk-wrap-draw base stride h font s tf tx y1 dk-para-intro (pal.pal-fg) cols
    in let y2 = y1 + dk-wrap-count dk-para-intro cols * dk-line-step tf s + dk-para-gap * s
    in let p2 = dk-wrap-draw base stride h font s tf tx y2 (dk-para-font tf) (pal.pal-accent) cols
    in let y3 = y2 + dk-wrap-count (dk-para-font tf) cols * dk-line-step tf s + dk-para-gap * s
    in dk-wrap-draw base stride h font s tf tx y3 dk-para-hint (pal.pal-primary) cols

  desk-draw : Integer, Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer -> WidgetNode
  desk-draw (base) (w) (h) (stride) (font) (s) (tf) (ds) =
    let wall = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in let laid = comp-render base stride h font tf (desk-chrome-face (widget-panel "content" DirColumn 0 []) w ds tf) (dk-theme-ds ds) w h (ui-wscale w)
    in let ic = desk-chrome-icons base stride h laid (dk-theme-ds ds) (ui-wscale w) tf ds
    in let inval = poke-32 ds desk-second-cell (0 - 1)
    in let bar = desk-topbar base w stride font s tf h ds
    in let win = desk-window base w h stride font tf ds
    in laid

  desk-draw-clock : Integer, Integer, Integer, Integer, CbfFont, GopFont, Text, Integer, WidgetNode -> Integer
  desk-draw-clock (base) (w) (h) (stride) (font) (tf) (t) (ds) (root) =
    when widget-find root "taskbar"
      is None -> 0
      is Just (tb) -> desk-taskbar-clock base w h stride font tf t ds tb

  dk-clock-ink : GopFont, Integer -> Integer
  dk-clock-ink (tf) (s) = if tf.gf-ok then tf.gf-gh else 14 * s

  desk-taskbar-clock : Integer, Integer, Integer, Integer, CbfFont, GopFont, Text, Integer, WidgetNode -> Integer
  desk-taskbar-clock (base) (w) (h) (stride) (font) (tf) (t) (ds) (tb) =
    let s = ui-scale w
    in let ws = ui-wscale w
    in let th = dk-theme-ds ds
    in let cell = when widget-find tb "task-clock"
      is Just (n) -> comp-mul-rect (n.wn-bounds) ws
      is None -> comp-mul-rect (tb.wn-bounds) ws
    in let st = widget-resolve-style tb th
    in let bg = comp-box base stride h cell (tb.wn-bounds) st (st.ws-bg) ws
    in let ft = dk-clock-fit tf s t (cell.lr-w - 8 * s)
    in let tw = dk-clock-tw tf s ft
    in let want = cell.lr-x + cell.lr-w - tw - 8 * s
    in let tx = if want < cell.lr-x then cell.lr-x else want
    in let ty = cell.lr-y + (cell.lr-h - dk-clock-ink tf s) / 2
    in desk-line base stride h font s tf tx ty ft ((dk-pal ds).pal-accent)

  dk-clock-tw : GopFont, Integer, Text -> Integer
  dk-clock-tw (tf) (s) (t) = if tf.gf-ok then gfont-text-w tf t else text-length t * 8 * s

  dk-clock-fit : GopFont, Integer, Text, Integer -> Text
  dk-clock-fit (tf) (s) (t) (room) =
    if text-length t == 0 then t
    else if dk-clock-tw tf s t <= room then t
    else dk-clock-fit tf s (substring t 0 (text-length t - 1)) room

Section: Clock Gate

  desk-second-cell : Integer = 8

  desk-clock : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, WidgetNode -> [Device.Port] Integer
  desk-clock (base) (w) (h) (stride) (font) (tf) (ds) (root) = act
    now <- rtc-seconds 0
    if now < 0 then 0
    else if now == peek-32 ds desk-second-cell then 0
    else act
      hh <- rtc-read 4
      mm <- rtc-read 2
      dd <- rtc-read 7
      mo <- rtc-read 8
      yy <- rtc-read 9
      let st = poke-32 ds desk-second-cell now
      in let cks = peek-32 ds desk-clock-cell
      in let note = dk-notice-take ds now
      in let txt = if text-length note > 0 then note
                   else if cks == 0 then dk-pad2 (dk-bcd hh) & ":" & dk-pad2 (dk-bcd mm) & ":" & dk-pad2 now
                   else clk-band-text cks (dk-bcd hh) (dk-bcd mm) now (dk-bcd dd) (dk-bcd mo) (dk-bcd yy)
      in desk-draw-clock base w h stride font tf txt ds root
    end
  end

Section: Notice

 A notice is shown in the clock cell for 5 distinct RTC seconds, long enough
 to read a verdict of the length `desk-shot` writes.

  dk-notice-cell : Integer = 272
  dk-notice-cols : Integer = 60
  dk-notice-secs : Integer = 5

  dk-notice-init : Integer -> Integer
  dk-notice-init (ds) = poke-32 ds dk-notice-cell (alloc-zeroed (12 + 4 * dk-notice-cols) 64)

  dk-notice-set : Integer, Text -> Integer
  dk-notice-set (ds) (t) =
    let blk = peek-32 ds dk-notice-cell
    in if blk == 0 then 0
    else let n = math-min (text-length t) dk-notice-cols
    in let c = dk-notice-copy blk t 0 n
    in let l = poke-32 blk 4 n
    in let k = poke-32 blk 8 (0 - 1)
    in let r = poke-32 blk 0 dk-notice-secs
    in poke-32 ds desk-second-cell (0 - 1)

  dk-notice-copy : Integer, Text, Integer, Integer -> Integer
  dk-notice-copy (blk) (t) (i) (n) =
    if i >= n then 0
    else let w = poke-32 blk (12 + 4 * i) (char-code (char-at t i))
    in dk-notice-copy blk t (i + 1) n

  dk-notice-chars : Integer, Integer, Integer, Text -> Text
  dk-notice-chars (blk) (i) (n) (acc) =
    if i >= n then acc
    else dk-notice-chars blk (i + 1) n (acc & char-encode (code-to-char (peek-32 blk (12 + 4 * i))))

  dk-notice-take : Integer, Integer -> Text
  dk-notice-take (ds) (now) =
    let blk = peek-32 ds dk-notice-cell
    in if blk == 0 then ""
    else let left = peek-32 blk 0
    in if left <= 0 then ""
    else if peek-32 blk 8 == now then dk-notice-chars blk 0 (peek-32 blk 4) ""
    else let k = poke-32 blk 8 now
    in let d = poke-32 blk 0 (left - 1)
    in dk-notice-chars blk 0 (peek-32 blk 4) ""

Section: Monitor

  dk-mon-val-dx : Integer = 100
  dk-mon-tick-cell : Integer = 28672

  dk-yn : Boolean -> Text
  dk-yn (b) = if b then "yes" else "no"

  dk-mon-line : Text, Text -> WidgetNode
  dk-mon-line (k) (v) =
    let kl = widget-set-tone (widget-label ("mon-k-" & k) k) tone-primary
    in widget-panel ("mon-r-" & k) DirRow 4 [widget-set-min kl dk-mon-val-dx (kl.wn-min-h), widget-set-flex (widget-label ("mon-v-" & k) v) 1]

  dk-mon-entries-text : Integer, Integer, Integer -> Text
  dk-mon-entries-text (ms) (i) (n) =
    if i >= n then ""
    else " " & show (desk-marks-id ms i) & "@" & hex-i64 (desk-marks-mark ms i) & dk-mon-entries-text ms (i + 1) n

  dk-prev-mid : Integer, Integer -> Integer
  dk-prev-mid (pb) (fid) =
    peek-32 (dk-prev-at pb fid) ((dk-prev-h / 2 * dk-prev-w + dk-prev-w / 2) * 4)

  dk-mon-prev-entries : Integer, Integer -> Text
  dk-mon-prev-entries (pb) (fid) =
    if fid >= dk-prev-slots then ""
    else if dk-prev-mid pb fid == 0 then dk-mon-prev-entries pb (fid + 1)
    else " " & show fid & "=0x" & hex-i32 (dk-prev-mid pb fid) & dk-mon-prev-entries pb (fid + 1)

  dk-mon-prev-text : Integer -> Text
  dk-mon-prev-text (ds) =
    let pb = peek-32 ds dk-prev-cell
    in if pb == 0 then "none" else dk-mon-prev-entries pb 1

  dk-mon-marks-text : Integer -> Text
  dk-mon-marks-text (ds) =
    let ms = peek-32 ds desk-marks-cell
    in let d = desk-marks-depth ms
    in "depth " & show d & "   root 0x" & hex-i64 (peek-32 ds desk-root-cell) & "  " & dk-mon-entries-text ms 0 d

  dk-mon-tree : Integer, Integer, Integer, Integer, Integer, GopFont, AcpiInfo, Text, Integer -> WidgetNode
  dk-mon-tree (ds) (base) (w) (h) (stride) (tf) (ai) (clk) (ticks) =
    let blk = peek-32 ds dk-mon-cell
    in widget-panel "mon" DirColumn 2 [
      widget-label "mon-title" "SYSTEM MONITOR",
      dk-mon-line "display" (show w & " x " & show h & "   stride " & show stride),
      dk-mon-line "framebuffer" ("0x" & hex-i64 base & "   scale " & show (ui-scale w)),
      dk-mon-line "input" ("keyboard " & (if peek-32 blk dk-mon-kbd-cell == 1 then "USB HID" else "mailbox") & "   mouse " & dk-yn (peek-32 blk dk-mon-mouse-cell == 1)),
      dk-mon-line "font" (if tf.gf-ok then "TrueType UI face   cell " & show (tf.gf-gh) & "   baseline " & show (tf.gf-asc) & "   cap " & show (tf.gf-cap) else "CBF bitmap"),
      dk-mon-line "acpi" (if ai.ai-ok then "rev " & show (ai.ai-revision) & "   tables " & show (ai.ai-tables) else "no RSDP: stub, EBDA and BIOS area all empty"),
      dk-mon-line "lapic" ("0x" & hex-i32 (ai.ai-lapic) & "   ioapic 0x" & hex-i32 (ai.ai-ioapic)),
      dk-mon-line "power" ("S5 " & dk-yn (ai.ai-s5-ok) & "   reset " & dk-yn (ai.ai-reset-ok) & "   sci " & show (ai.ai-sci)),
      dk-mon-line "clock" (clk & "   ticks " & show ticks),
      dk-mon-line "memory" ("heap frontier 0x" & hex-i64 __heap-save & "   desk mark 0x" & hex-i64 (peek-32 ds desk-mark-cell)),
      dk-mon-line "marks" (dk-mon-marks-text ds),
      dk-mon-line "preview" (dk-mon-prev-text ds),
      dk-mon-line "stack" desk-stack-text,
      widget-set-flex (widget-label "mon-spacer" "") 1
    ]

  desk-stack-min-addr : Integer = 28736
  desk-stack-top-addr : Integer = 4072

  desk-stack-text : Text
  desk-stack-text =
    let mn = peek-qword desk-stack-min-addr 0
    in let tp = peek-qword desk-stack-top-addr 0
    in if mn >= tp then "never narrowed -- this CDX was not built with -Trace"
    else "min rsp 0x" & hex-i64 mn & "   depth " & show (tp - mn) & " B"

  FilesState = record {
    fs-fonts : GopAppFont,
    fs-vol : Fat16Volume,
    fs-count : Integer,
    fs-clusters : List Integer,
    fs-names : List Text,
    fs-sel : Integer,
    fs-top : Integer,
    fs-ptr : Integer,
    fs-mode : Integer
  }

  DeskApps = record {
    da-fonts : GopAppFont,
    da-files : Maybe FilesState,
    da-browser : Maybe BrowserPane,
    da-scene : Maybe ScenePane,
    da-edit : Maybe EditState,
    da-sheet : Maybe SheetPane,
    da-review : Maybe GrvData
  }

  desk-apps-empty : GopAppFont -> DeskApps
  desk-apps-empty (fonts) = DeskApps { da-fonts = fonts, da-files = None, da-browser = None, da-scene = None, da-edit = None, da-sheet = None, da-review = None }

  desk-marks-cell : Integer = 20
  desk-marks-max : Integer = 8

  desk-marks-depth : Integer -> Integer
  desk-marks-depth (ms) = peek-32 ms 0

  desk-marks-id : Integer, Integer -> Integer
  desk-marks-id (ms) (i) = peek-32 ms (8 * i + 8)

  desk-marks-mark : Integer, Integer -> Integer
  desk-marks-mark (ms) (i) = peek-32 ms (8 * i + 12)

  desk-marks-push : Integer, Integer, Integer -> Integer
  desk-marks-push (ms) (fid) (mark) =
    let d = desk-marks-depth ms
    in if d >= desk-marks-max then d
    else
      let a = poke-32 ms (8 * d + 8) fid
      in let b = poke-32 ms (8 * d + 12) mark
      in poke-32 ms 0 (d + 1)

  desk-marks-clear : Integer -> Integer
  desk-marks-clear (ms) = poke-32 ms 0 0

  desk-marks-find : Integer, Integer, Integer -> Integer
  desk-marks-find (ms) (fid) (i) =
    if i < 0 then 0 - 1
    else if desk-marks-id ms i == fid then i
    else desk-marks-find ms fid (i - 1)

  desk-marks-kill : Integer, Integer -> Integer
  desk-marks-kill (ms) (fid) =
    let i = desk-marks-find ms fid (desk-marks-depth ms - 1)
    in if i < 0 then 0 else poke-32 ms (8 * i + 8) desk-focus-none

  desk-marks-remark : Integer, Integer, Integer -> Integer
  desk-marks-remark (ms) (fid) (mark) =
    let d = desk-marks-depth ms
    in let i = desk-marks-find ms fid (d - 1)
    in if i < 0 then 0
    else if i + 1 < d & mark >= desk-marks-mark ms (i + 1) then 0 - 1
    else if i > 0 & mark < desk-marks-mark ms (i - 1) then 0 - 1
    else let w = poke-32 ms (8 * i + 12) mark
    in 1

  desk-marks-reclaim : Integer, Integer -> Integer
  desk-marks-reclaim (ms) (acc) =
    let d = desk-marks-depth ms
    in if d <= 0 then acc
    else if desk-marks-id ms (d - 1) /= desk-focus-none then acc
    else
      let m = desk-marks-mark ms (d - 1)
      in let p = poke-32 ms 0 (d - 1)
      in desk-marks-reclaim ms m

  desk-marks-any-live : Integer, Integer -> Boolean
  desk-marks-any-live (ms) (i) =
    if i < 0 then False
    else if desk-marks-id ms i /= desk-focus-none then True
    else desk-marks-any-live ms (i - 1)

  desk-root-cell : Integer = 224
  desk-rootend-cell : Integer = 228

  desk-marks-live-above : Integer, Integer, Integer -> Boolean
  desk-marks-live-above (ms) (e) (i) =
    if i < 0 then False
    else if desk-marks-id ms i /= desk-focus-none & desk-marks-mark ms i >= e then True
    else desk-marks-live-above ms e (i - 1)

  desk-root-may-reclaim : Integer, Integer, Integer -> Boolean
  desk-root-may-reclaim (ms) (s) (e) =
    if s == 0 | e == 0 then False
    else if desk-marks-live-above ms e (desk-marks-depth ms - 1) then False
    else True

  desk-root-reclaim : Integer -> Integer
  desk-root-reclaim (ds) =
    let s = peek-32 ds desk-root-cell
    in let e = peek-32 ds desk-rootend-cell
    in let ms = peek-32 ds desk-marks-cell
    in if desk-root-may-reclaim ms s e then
      let d = __heap-restore s
      in 1
    else 0

  desk-root-note : Integer, Integer -> Integer
  desk-root-note (ds) (s) =
    let a = poke-32 ds desk-root-cell s
    in poke-32 ds desk-rootend-cell __heap-save

  desk-marks-extent : Integer, Integer, Integer -> Integer
  desk-marks-extent (ms) (i) (top) =
    let d = desk-marks-depth ms
    in if i < 0 then 0
    else if i >= d then 0
    else let lo = desk-marks-mark ms i
    in let hi = if i + 1 < d then desk-marks-mark ms (i + 1) else top
    in hi - lo

  desk-marks-extent-sum : Integer, Integer, Integer -> Integer
  desk-marks-extent-sum (ms) (i) (top) =
    if i < 0 then 0
    else desk-marks-extent ms i top + desk-marks-extent-sum ms (i - 1) top

  desk-span-holds-root : Integer, Integer, Integer, Integer -> Boolean
  desk-span-holds-root (ms) (i) (top) (r) =
    let d = desk-marks-depth ms
    in if i < 0 then False
    else if i >= d then False
    else if r == 0 then False
    else let lo = desk-marks-mark ms i
    in let hi = if i + 1 < d then desk-marks-mark ms (i + 1) else top
    in r >= lo & r < hi

  desk-span-reusable : Integer, Integer, Integer, Integer -> Boolean
  desk-span-reusable (ms) (i) (top) (r) =
    if desk-marks-id ms i /= desk-focus-none then False
    else if desk-span-holds-root ms i top r then False
    else True

  desk-span-pick : Integer, Integer, Integer, Integer, Integer -> Integer
  desk-span-pick (ms) (top) (r) (want) (i) =
    if i >= desk-marks-depth ms then 0 - 1
    else if desk-span-reusable ms i top r & desk-marks-extent ms i top >= want then i
    else desk-span-pick ms top r want (i + 1)

  desk-reservation-top-cell : Integer = 36344

  desk-poke-q : Integer, Integer -> Integer
  desk-poke-q (addr) (v) =
    let b0 = poke-byte addr 0 (int-mod v 256)
    in let b1 = poke-byte addr 1 (int-mod (v / 256) 256)
    in let b2 = poke-byte addr 2 (int-mod (v / 65536) 256)
    in let b3 = poke-byte addr 3 (int-mod (v / 16777216) 256)
    in let b4 = poke-byte addr 4 (int-mod (v / 4294967296) 256)
    in let b5 = poke-byte addr 5 (int-mod (v / 1099511627776) 256)
    in let b6 = poke-byte addr 6 (int-mod (v / 281474976710656) 256)
    in poke-byte addr 7 (int-mod (v / 72057594037927936) 256)

  desk-hole-enter : Integer, Integer, Integer, Integer -> Integer
  desk-hole-enter (ms) (top) (r) (want) =
    let i = desk-span-pick ms top r want 0
    in if i < 0 then 0 - 1
    else let lo = desk-marks-mark ms i
    in let hi = lo + desk-marks-extent ms i top
    in let w = desk-poke-q desk-reservation-top-cell hi
    in let s = __deck-set lo
    in let en = __deck-enter
    in i

  desk-hole-exit : Integer, Integer, Integer -> Integer
  desk-hole-exit (ms) (i) (fid) =
    if i < 0 then 0
    else let ex = __deck-exit
    in poke-32 ms (8 * i + 8) fid

  desk-hole-top : Integer, Integer, Integer -> Integer
  desk-hole-top (ms) (i) (top) =
    if i < 0 then 0
    else desk-marks-mark ms i + desk-marks-extent ms i top

  desk-hole-room : Integer, Integer, Integer -> Integer
  desk-hole-room (ms) (i) (top) =
    if i < 0 then 0
    else let hi = desk-hole-top ms i top
    in let cur = alloc-bytes 0
    in if cur >= hi then 0 else hi - cur

  desk-hole-fits : Integer, Integer, Integer, Integer -> Boolean
  desk-hole-fits (ms) (i) (top) (want) =
    if i < 0 then False
    else desk-hole-room ms i top >= want

  desk-scene-want : Integer, Integer -> Integer
  desk-scene-want (bw) (bh) = bw * bh * 8 + 4096

  dk-prev-w : Integer = 128
  dk-prev-h : Integer = 72
  dk-prev-slots : Integer = 19
  dk-prev-cell : Integer = 232

  dk-prev-bytes : Integer
  dk-prev-bytes = dk-prev-w * dk-prev-h * 4

  dk-prev-at : Integer, Integer -> Integer
  dk-prev-at (pb) (fid) = pb + fid * dk-prev-bytes

  dk-prev-clamp : Integer, Integer -> Integer
  dk-prev-clamp (v) (hi) =
    if v < 0 then 0
    else if v >= hi then hi - 1
    else v

  dk-prev-row : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-prev-row (base) (stride) (w) (h) (dst) (rx) (ry) (rw) (rh) (py) (px) (sy) =
    if px >= dk-prev-w then 0
    else
      let sx = dk-prev-clamp (rx + px * rw / dk-prev-w) w
      in let c = peek-32 base ((sy * stride + sx) * 4)
      in let p = poke-32 dst ((py * dk-prev-w + px) * 4) c
      in dk-prev-row base stride w h dst rx ry rw rh py (px + 1) sy

  dk-prev-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-prev-rows (base) (stride) (w) (h) (dst) (rx) (ry) (rw) (rh) (py) =
    if py >= dk-prev-h then 0
    else
      let sy = dk-prev-clamp (ry + py * rh / dk-prev-h) h
      in let r = dk-prev-row base stride w h dst rx ry rw rh py 0 sy
      in dk-prev-rows base stride w h dst rx ry rw rh (py + 1)

  dk-prev-capture : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-prev-capture (base) (w) (h) (stride) (ds) (fid) =
    let pb = peek-32 ds dk-prev-cell
    in if pb == 0 then 0
    else if fid <= desk-focus-none then 0
    else if fid >= dk-prev-slots then 0
    else
      let blk = desk-wnd-blk fid ds
      in let st = dk-wnd-st blk
      in let rw = dk-wnd-rw blk w st ds
      in let rh = dk-wnd-rh blk w h st ds
      in if rw <= 0 | rh <= 0 then 0
      else dk-prev-rows base stride w h (dk-prev-at pb fid) (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) rw rh 0

  dk-prev-own : Integer -> Boolean
  dk-prev-own (fid) = fid == desk-focus-clkp

  dk-prev-render : Integer, CbfFont, GopFont, Theme, Palette, WidgetNode -> Integer
  dk-prev-render (dst) (font) (tf) (th) (pal) (tree) =
    let bg = gop-fill-rect dst dk-prev-w 0 0 dk-prev-w dk-prev-h (pal.pal-bg)
    in let laid = comp-render-at dst dk-prev-w dk-prev-h font tf tree th 0 0 dk-prev-w dk-prev-h 1
    in 1

  dk-prev-fresh : Integer, Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  dk-prev-fresh (base) (w) (h) (stride) (ds) (font) (tf) (fid) =
    let pb = peek-32 ds dk-prev-cell
    in if pb == 0 then act 0 end
    else if fid <= desk-focus-none | fid >= dk-prev-slots then act 0 end
    else if dk-prev-own fid == False then act 0 end
    else act
      tree <- desk-wnd-preview-tree fid ds base w h stride tf
      dk-prev-render (dk-prev-at pb fid) font tf (dk-theme-ds ds) (dk-pal ds) tree
    end

  desk-wnd-preview-tree : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> [Device.Port] WidgetNode
  desk-wnd-preview-tree (fid) (ds) (base) (w) (h) (stride) (tf) =
    if fid == desk-focus-clkp then act
      idle <- rtc-wait-idle rtc-uip-fuel
      b <- clk-mode 0
      hh <- clk-hour-now b
      mi <- clk-field-value clk-reg-minutes b
      ss <- clk-field-value clk-reg-seconds b
      clk-preview-tree hh mi ss dk-prev-h
    end
    else desk-wnd-tree fid ds base w h stride tf

  desk-focus-cell : Integer = 12
  desk-focus-none : Integer = 0
  desk-focus-mon : Integer = 1
  desk-focus-cal : Integer = 2
  desk-focus-style : Integer = 3
  desk-focus-calc : Integer = 4
  desk-focus-clkp : Integer = 5
  desk-focus-prog : Integer = 6
  desk-focus-dif : Integer = 7
  desk-focus-trk : Integer = 8
  desk-focus-con : Integer = 9
  desk-focus-files : Integer = 10
  desk-focus-bro : Integer = 11
  desk-focus-scene : Integer = 12
  desk-focus-fish : Integer = 13
  desk-focus-edit : Integer = 14
  desk-focus-web : Integer = 17

  dk-web-cell : Integer = 248
  desk-focus-menu : Integer = 15
  desk-focus-rev : Integer = 16

  desk-focus-sheet : Integer = 18

  desk-review-cell : Integer = 0

  desk-mon-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-mon-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-mon-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-mon-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-mon sc clicked
    if ev == desk-wnd-ev-close then act 0 end
    else if ev == desk-wnd-ev-min then act desk-step-hide end
    else if ev == desk-wnd-ev-stay then act 1 end
    else act
      let mark = __heap-save
      in act
        now <- rtc-seconds 0
        if sc == 88 then act
          s <- desk-shot base w h stride font tf ds
          let d = __heap-restore mark
          in 1
        end
        else if now < 0 | now == peek-32 ds 16 then act
          let d = __heap-restore mark
          in 1
        end
        else act
          let st = poke-32 ds 16 now
          in let hd = cursor-hide cs base stride
          in act
            p <- desk-mon-paint base w h stride font tf ds
            let c = dk-cursor base w h stride cs mouse
            in let dropped = __heap-restore mark
            in 1
          end
        end
      end
    end
  end

  desk-mon-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-mon-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let blk = peek-32 ds dk-mon-cell
    in let kp = poke-32 blk dk-mon-kbd-cell (if kbd.uk-ok then 1 else 0)
    in let mp = poke-32 blk dk-mon-mouse-cell (if mouse.um-ok then 1 else 0)
    in let o = desk-wnd-open desk-focus-mon w h ds
    in let due = poke-32 ds 16 255
    in act
      p0 <- desk-mon-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

  desk-step-of : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Integer, Boolean -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-step-of (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (foc) (sc) (clicked) =
    if foc == desk-focus-mon then desk-mon-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-cal then desk-wnd-quiet-step base w h stride font tf kbd mouse ds cs desk-focus-cal sc clicked
    else if foc == desk-focus-dif then desk-wnd-quiet-step base w h stride font tf kbd mouse ds cs desk-focus-dif sc clicked
    else if foc == desk-focus-trk then desk-trk-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-rev then desk-rev-step base w h stride font tf kbd mouse ds cs apps sc
    else if foc == desk-focus-con then desk-console-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-style then desk-style-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-calc then desk-calc-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-clkp then desk-clock-pane-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-prog then desk-prog-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-menu then desk-menu-step base w h stride font tf kbd mouse ds cs apps sc clicked
    else if foc == desk-focus-files then desk-files-step base w h stride font tf kbd mouse ds cs apps sc clicked
    else if foc == desk-focus-bro then desk-browser-step base w h stride font tf mouse ds cs apps root sc clicked
    else if foc == desk-focus-scene then desk-scene-step base w h stride font tf kbd mouse ds cs apps gsc-scene desk-focus-scene sc clicked
    else if foc == desk-focus-fish then desk-scene-step base w h stride font tf kbd mouse ds cs apps gf-scene desk-focus-fish sc clicked
    else if foc == desk-focus-edit then desk-edit-step base w h stride font tf mouse ds cs apps sc clicked
    else if foc == desk-focus-web then desk-web-step base w h stride font tf kbd mouse ds cs sc clicked
    else if foc == desk-focus-sheet then desk-sheet-step base w h stride font tf kbd mouse ds cs apps sc clicked
    else 0

  desk-quiet-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer -> [Device.Port] Integer
  desk-quiet-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) =
    if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else 1

  desk-wnd-quiet-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-wnd-quiet-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (fid) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs fid sc clicked
    if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else 1
  end

  dk-apps-lo-cell : Integer = 260
  dk-apps-hi-cell : Integer = 264

  dk-restay-cell : Integer = 268

  desk-apps-reclaim : Integer -> Integer
  desk-apps-reclaim (ds) =
    let lo = peek-32 ds dk-apps-lo-cell
    in let hi = peek-32 ds dk-apps-hi-cell
    in if lo > 0 & lo < hi & __heap-save == hi then (let r = __heap-restore lo in 1) else 0

  desk-apps-note : Integer, Integer, Integer -> Integer
  desk-apps-note (ds) (lo) (hi) =
    let a = poke-32 ds dk-apps-lo-cell lo
    in poke-32 ds dk-apps-hi-cell hi

  desk-renew : Maybe a -> Maybe a
  desk-renew (m) = when m
    is None -> None
    is otherwise -> m

  desk-app-close-to : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer

  desk-app-close-to (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (sc) =
    let fid = peek-32 ds desk-focus-cell
    in let unreg = dk-wr-close (peek-32 ds dk-wr-cell) fid
    in let ms = peek-32 ds desk-marks-cell
    in let fonts = apps.da-fonts
    in let sb = apps.da-browser
    in let ss = apps.da-scene
    in let se = apps.da-edit
    in let sfi = apps.da-files
    in let ssh = apps.da-sheet
    in let srv = apps.da-review
    in let kl = desk-marks-kill ms fid
    in let rec = desk-marks-reclaim ms (0 - 1)
    in let dep = desk-marks-depth ms
    in let cf = poke-32 ds desk-focus-cell desk-focus-none
    in let hd2 = cursor-hide cs base stride
    in let tgt = if dep <= 0 then peek-32 ds desk-mark-cell else if rec < 0 then __heap-save else rec
    in let eb = peek-32 ds desk-edit-cell
    in let ev = desk-edit-drop eb tgt fid
    in let dropped = __heap-restore tgt
    in let rc = desk-root-reclaim ds
    in let ar = desk-apps-reclaim ds
    in let lo = __heap-save
    in let nf = if fid == desk-focus-files then None else desk-renew sfi
    in let nb = if fid == desk-focus-bro then None else desk-renew sb
    in let nsc = if fid == desk-focus-scene | fid == desk-focus-fish then None else desk-renew ss
    in let ne = if fid == desk-focus-edit then None else desk-renew se
    in let nsh = if fid == desk-focus-sheet then None else desk-renew ssh
    in let nrv = if fid == desk-focus-rev then None else desk-renew srv
    in let fresh = if dep <= 0 then desk-apps-empty fonts else DeskApps { da-fonts = fonts, da-files = nf, da-browser = nb, da-scene = nsc, da-edit = ne, da-sheet = nsh, da-review = nrv }
    in let rm = __heap-save
    in let an = desk-apps-note ds lo rm
    in let root = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let c0 = dk-cursor base w h stride cs mouse
    in desk-dispatch base w h stride font tf kbd mouse ds cs fresh root sc False

  desk-step-hide : Integer = 1000000

  desk-step-dismiss : Integer = 1000001

  desk-menu-dismiss : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-menu-dismiss (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) = act
    hd <- cursor-hide cs base stride
    let cf = poke-32 ds desk-focus-cell desk-focus-none
    in let rc = desk-root-reclaim ds
    in let rm = __heap-save
    in let root = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let vis = dk-wr-visible (peek-32 ds dk-wr-cell) ds
    in if vis == desk-focus-none then
      let c0 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    else act
      let rf = poke-32 ds desk-focus-cell vis
      in act
        p <- desk-wnd-paint-all base w h stride font tf ds
        let c0 = dk-cursor base w h stride cs mouse
        in desk-loop base w h stride font tf kbd mouse ds cs apps root
      end
    end
  end

  desk-app-hide : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer

  desk-app-hide (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) = act
    let snap = dk-prev-capture base w h stride ds (peek-32 ds desk-focus-cell)
    in let cf = poke-32 ds desk-focus-cell desk-focus-none
    in let hd2 = cursor-hide cs base stride
    in let rc = desk-root-reclaim ds
    in let rm = __heap-save
    in let root = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let vis = dk-wr-visible (peek-32 ds dk-wr-cell) ds
    in if vis == desk-focus-none then
      let c0 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    else act
      let rf = poke-32 ds desk-focus-cell vis
      in act
        p <- desk-wnd-paint-all base w h stride font tf ds
        let c0 = dk-cursor base w h stride cs mouse
        in desk-loop base w h stride font tf kbd mouse ds cs apps root
      end
    end
  end

  desk-app-close : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer

  desk-app-close (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) =
    let fid = peek-32 ds desk-focus-cell
    in let wsr = peek-32 ds dk-wr-cell
    in let nxt = if dk-wr-find wsr fid 0 >= 0 then dk-wr-close wsr fid else desk-focus-none
    in if nxt /= desk-focus-none then desk-wnd-close-to base w h stride font tf kbd mouse ds cs apps nxt
    else desk-app-close-plain base w h stride font tf kbd mouse ds cs apps

  desk-wnd-close-to : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-wnd-close-to (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (nxt) = act
    hd <- act cursor-hide cs base stride end
    let fid = peek-32 ds desk-focus-cell
    in let ms = peek-32 ds desk-marks-cell
    in let fonts = apps.da-fonts
    in let sb = apps.da-browser
    in let ss = apps.da-scene
    in let se = apps.da-edit
    in let sfi = apps.da-files
    in let ssh = apps.da-sheet
    in let srv = apps.da-review
    in let kl = desk-marks-kill ms fid
    in let rec = desk-marks-reclaim ms (0 - 1)
    in let dep = desk-marks-depth ms
    in let tgt = if dep <= 0 then peek-32 ds desk-mark-cell else if rec < 0 then __heap-save else rec
    in let eb = peek-32 ds desk-edit-cell
    in let ev = desk-edit-drop eb tgt fid
    in let dropped = __heap-restore tgt
    in let sf = poke-32 ds desk-focus-cell nxt
    in let rc = desk-root-reclaim ds
    in let ar = desk-apps-reclaim ds
    in let lo = __heap-save
    in let nf = if fid == desk-focus-files then None else desk-renew sfi
    in let nb = if fid == desk-focus-bro then None else desk-renew sb
    in let nsc = if fid == desk-focus-scene | fid == desk-focus-fish then None else desk-renew ss
    in let ne = if fid == desk-focus-edit then None else desk-renew se
    in let nsh = if fid == desk-focus-sheet then None else desk-renew ssh
    in let nrv = if fid == desk-focus-rev then None else desk-renew srv
    in let fresh = if dep <= 0 then desk-apps-empty fonts else DeskApps { da-fonts = fonts, da-files = nf, da-browser = nb, da-scene = nsc, da-edit = ne, da-sheet = nsh, da-review = nrv }
    in let rm = __heap-save
    in let an = desk-apps-note ds lo rm
    in let root = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in act
      p <- desk-wnd-paint-all base w h stride font tf ds
      let c0 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs fresh root
    end
  end

  desk-app-close-plain : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-app-close-plain (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) =
    let fid = peek-32 ds desk-focus-cell
    in let ms = peek-32 ds desk-marks-cell
    in let fonts = apps.da-fonts
    in let sb = apps.da-browser
    in let ss = apps.da-scene
    in let se = apps.da-edit
    in let sfi = apps.da-files
    in let ssh = apps.da-sheet
    in let srv = apps.da-review
    in let kl = desk-marks-kill ms fid
    in let rec = desk-marks-reclaim ms (0 - 1)
    in let dep = desk-marks-depth ms
    in let cf = poke-32 ds desk-focus-cell desk-focus-none
    in let hd2 = cursor-hide cs base stride
    in let tgt = if dep <= 0 then peek-32 ds desk-mark-cell else if rec < 0 then __heap-save else rec
    in let eb = peek-32 ds desk-edit-cell
    in let ev = desk-edit-drop eb tgt fid
    in let dropped = __heap-restore tgt
    in let rc = desk-root-reclaim ds
    in let ar = desk-apps-reclaim ds
    in let lo = __heap-save
    in let nf = if fid == desk-focus-files then None else desk-renew sfi
    in let nb = if fid == desk-focus-bro then None else desk-renew sb
    in let nsc = if fid == desk-focus-scene | fid == desk-focus-fish then None else desk-renew ss
    in let ne = if fid == desk-focus-edit then None else desk-renew se
    in let nsh = if fid == desk-focus-sheet then None else desk-renew ssh
    in let nrv = if fid == desk-focus-rev then None else desk-renew srv
    in let fresh = if dep <= 0 then desk-apps-empty fonts else DeskApps { da-fonts = fonts, da-files = nf, da-browser = nb, da-scene = nsc, da-edit = ne, da-sheet = nsh, da-review = nrv }
    in let rm = __heap-save
    in let an = desk-apps-note ds lo rm
    in let root = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let c0 = dk-cursor base w h stride cs mouse
    in desk-loop base w h stride font tf kbd mouse ds cs fresh root
  end

Section: Calculator

  desk-calc-draw : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-calc-draw (base) (w) (h) (stride) (font) (tf) (ks) (ds) =
    desk-wnd-paint-all base w h stride font tf ds

  desk-calc-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-calc-paint (base) (w) (h) (stride) (font) (tf) (ks) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-calc-draw base w h stride font tf ks ds
  end

  dk-calc-hit : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> Integer
  dk-calc-hit (w) (h) (ks) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let blk = peek-32 ds 24
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let laid = widget-layout (gcalc-tree ks) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let code = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
          is Just (wgt) -> gcalc-id-scan (wgt.wn-id)
          is None -> 0
    in let dropped = __heap-restore probe
    in code

  desk-calc-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-calc-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ks) (ds) = act
    hd <- act cursor-hide cs base stride end
    p <- desk-calc-draw base w h stride font tf ks ds
    dk-cursor base w h stride cs mouse
  end

  desk-calc-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-calc-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-calc sc clicked
    let ks = peek-32 ds 24
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else
      let mark = __heap-save
      in let hit = if clicked then dk-calc-hit w h ks (mouse-x mouse) (mouse-y mouse) ds tf else 0
      in if hit /= 0 then act
        let a = gcalc-key ks hit
        in act
          p <- desk-calc-repaint base w h stride font tf cs mouse ks ds
          let d = __heap-restore mark
          in 1
        end
      end
      else if gcalc-key ks sc == 0 then
        let d = __heap-restore mark
        in 1
      else act
        p <- desk-calc-repaint base w h stride font tf cs mouse ks ds
        let d = __heap-restore mark
        in 1
      end
  end

Section: The Console Pane

  desk-console-draw : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-console-draw (base) (w) (h) (stride) (font) (tf) (ns) (ds) =
    desk-wnd-paint-all base w h stride font tf ds

  desk-console-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-console-paint (base) (w) (h) (stride) (font) (tf) (ns) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-console-draw base w h stride font tf ns ds
  end

  desk-console-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-console-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ns) (ds) = act
    hd <- act cursor-hide cs base stride end
    p <- desk-console-draw base w h stride font tf ns ds
    dk-cursor base w h stride cs mouse
  end

  dk-conp-mods-cell : Integer = 16

  desk-console-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-console-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-con sc clicked
    let ns = peek-32 ds desk-console-cell
    in let md = gcon-shift-of (peek-32 ns dk-conp-mods-cell) sc
    in let sm = poke-32 ns dk-conp-mods-cell md
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if sc == 0 then 1
    else act
      let mark = __heap-save
      in act
        a <- gcon-key ns sc md
        p <- desk-console-repaint base w h stride font tf cs mouse ns ds
        let d = __heap-restore mark
        in 1
      end
    end
  end

  desk-console-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-console-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ns) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let e = gcon-ensure ns
    in let o = desk-wnd-open desk-focus-con w h ds
    in act
      p0 <- desk-console-paint base w h stride font tf ns ds
      let m0 = poke-32 ns dk-conp-mods-cell 0
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Clock

Section: Windows

  dk-strip-any : Integer, Integer, Integer -> Boolean
  dk-strip-any (ds) (e) (fid) =
    if fid > dk-focus-max then False
    else if dk-pill-live (peek-32 ds dk-wr-cell) ds fid == False then dk-strip-any ds e (fid + 1)
    else if dk-pedge-get ds fid == e then True
    else dk-strip-any ds e (fid + 1)

  dk-strip-h-cell : Integer = 216
  dk-strip-v-cell : Integer = 220

  dk-strip-depth : Integer, Integer, Integer -> Integer
  dk-strip-depth (ds) (w) (e) =
    let c = peek-32 ds (if e >= dk-edge-left then dk-strip-v-cell else dk-strip-h-cell)
    in if c > 0 then c
    else if e >= dk-edge-left then dk-task-w * ui-wscale w
    else dk-task-h * ui-wscale w

  dk-strip-px : Integer, Integer, Integer -> Integer
  dk-strip-px (ds) (w) (e) =
    if dk-task-edge ds == e then dk-task-px ds w
    else if dk-strip-any ds e 0 then dk-strip-depth ds w e
    else 0

  dk-cbox-x : Integer, Integer -> Integer
  dk-cbox-x (w) (ds) = dk-strip-px ds w dk-edge-left

  dk-cbox-y : Integer, Integer -> Integer
  dk-cbox-y (w) (ds) =
    dk-bar-h * ui-scale w + dk-strip-px ds w dk-edge-top

  dk-cbox-w : Integer, Integer -> Integer
  dk-cbox-w (w) (ds) =
    w - dk-cbox-x w ds - dk-strip-px ds w dk-edge-right

  dk-cbox-h : Integer, Integer, Integer -> Integer
  dk-cbox-h (w) (h) (ds) =
    h - dk-cbox-y w ds - dk-strip-px ds w dk-edge-bottom

  dk-wnd-st-normal : Integer = 0
  dk-wnd-st-max : Integer = 1

  dk-wnd-st-min : Integer = 2

  dk-wnd-minimised : Integer -> Boolean
  dk-wnd-minimised (blk) = dk-wnd-st blk == dk-wnd-st-min

  dk-wnd-w : Integer, Integer, Integer -> Integer
  dk-wnd-w (w) (st) (ds) = if st == dk-wnd-st-max then dk-cbox-w w ds else dk-cbox-w w ds * 3 / 4

  dk-wnd-h : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-h (w) (h) (st) (ds) = if st == dk-wnd-st-max then dk-cbox-h w h ds else dk-cbox-h w h ds * 3 / 4

  dk-wnd-x : Integer, Integer, Integer -> Integer
  dk-wnd-x (w) (st) (ds) = dk-cbox-x w ds + (dk-cbox-w w ds - dk-wnd-w w st ds) / 2

  dk-wnd-y : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-y (w) (h) (st) (ds) = dk-cbox-y w ds + (dk-cbox-h w h ds - dk-wnd-h w h st ds) / 2

  dk-wnd-st-cell : Integer = 44
  dk-wnd-rx-cell : Integer = 48
  dk-wnd-ry-cell : Integer = 52
  dk-wnd-rw-cell : Integer = 56
  dk-wnd-rh-cell : Integer = 60

  dk-wnd-st : Integer -> Integer
  dk-wnd-st (blk) = peek-32 blk dk-wnd-st-cell

  dk-wnd-placed : Integer -> Boolean
  dk-wnd-placed (blk) = peek-32 blk dk-wnd-rw-cell /= 0

  dk-wnd-place : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-wnd-place (blk) (x) (y) (ww) (wh) =
    let a = poke-32 blk dk-wnd-rx-cell x
    in let b = poke-32 blk dk-wnd-ry-cell y
    in let c = poke-32 blk dk-wnd-rw-cell ww
    in poke-32 blk dk-wnd-rh-cell wh

  dk-cell-signed : Integer -> Integer
  dk-cell-signed (v) = if v >= 2147483648 then v - 4294967296 else v

  dk-wnd-rx : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-rx (blk) (w) (st) (ds) =
    if st == dk-wnd-st-max then dk-cbox-x w ds
    else if dk-wnd-placed blk then dk-cell-signed (peek-32 blk dk-wnd-rx-cell)
    else dk-wnd-x w dk-wnd-st-normal ds

  dk-wnd-ry : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-wnd-ry (blk) (w) (h) (st) (ds) =
    if st == dk-wnd-st-max then dk-cbox-y w ds
    else if dk-wnd-placed blk then dk-cell-signed (peek-32 blk dk-wnd-ry-cell)
    else dk-wnd-y w h dk-wnd-st-normal ds

  dk-wnd-rw : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-rw (blk) (w) (st) (ds) =
    if st == dk-wnd-st-max then dk-cbox-w w ds
    else if dk-wnd-placed blk then peek-32 blk dk-wnd-rw-cell
    else dk-wnd-w w dk-wnd-st-normal ds

  dk-wnd-rh : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-wnd-rh (blk) (w) (h) (st) (ds) =
    if st == dk-wnd-st-max then dk-cbox-h w h ds
    else if dk-wnd-placed blk then peek-32 blk dk-wnd-rh-cell
    else dk-wnd-h w h dk-wnd-st-normal ds

Section: The window registry

  dk-wr-cell : Integer = 80

  dk-wr-max : Integer = 15

  dk-wr-count : Integer -> Integer
  dk-wr-count (ws) = peek-32 ws 0

  dk-wr-at : Integer, Integer -> Integer
  dk-wr-at (ws) (i) = peek-32 ws (4 * i + 4)

  dk-wr-set : Integer, Integer, Integer -> Integer
  dk-wr-set (ws) (i) (fid) = poke-32 ws (4 * i + 4) fid

  dk-wr-top : Integer -> Integer
  dk-wr-top (ws) =
    if dk-wr-count ws <= 0 then desk-focus-none
    else dk-wr-at ws (dk-wr-count ws - 1)

  dk-wr-find : Integer, Integer, Integer -> Integer
  dk-wr-find (ws) (fid) (i) =
    if i >= dk-wr-count ws then 0 - 1
    else if dk-wr-at ws i == fid then i
    else dk-wr-find ws fid (i + 1)

  dk-wr-slide : Integer, Integer -> Integer
  dk-wr-slide (ws) (i) =
    if i + 1 >= dk-wr-count ws then i
    else
      let a = dk-wr-set ws i (dk-wr-at ws (i + 1))
      in dk-wr-slide ws (i + 1)

  dk-wr-raise : Integer, Integer -> Integer
  dk-wr-raise (ws) (fid) =
    let i = dk-wr-find ws fid 0
    in if i < 0 then dk-wr-top ws
    else
      let last = dk-wr-count ws - 1
      in let s = dk-wr-slide ws i
      in let p = dk-wr-set ws last fid
      in dk-wr-top ws

  dk-wr-open : Integer, Integer -> Integer
  dk-wr-open (ws) (fid) =
    if dk-wr-find ws fid 0 >= 0 then dk-wr-raise ws fid
    else if dk-wr-count ws >= dk-wr-max then dk-wr-top ws
    else
      let n = dk-wr-count ws
      in let a = dk-wr-set ws n fid
      in let c = poke-32 ws 0 (n + 1)
      in dk-wr-top ws

  dk-wr-close : Integer, Integer -> Integer
  dk-wr-close (ws) (fid) =
    let i = dk-wr-find ws fid 0
    in if i < 0 then dk-wr-top ws
    else
      let s = dk-wr-slide ws i
      in let c = poke-32 ws 0 (dk-wr-count ws - 1)
      in dk-wr-top ws

  dk-wr-sink : Integer, Integer -> Integer
  dk-wr-sink (ws) (i) =
    if i <= 0 then 0
    else
      let a = dk-wr-set ws i (dk-wr-at ws (i - 1))
      in dk-wr-sink ws (i - 1)

  dk-wr-top-vis : Integer, Integer, Integer -> Integer
  dk-wr-top-vis (ws) (ds) (i) =
    if i < 0 then desk-focus-none
    else
      let fid = dk-wr-at ws i
      in if dk-wnd-minimised (desk-wnd-blk fid ds) then dk-wr-top-vis ws ds (i - 1)
      else fid

  dk-wr-visible : Integer, Integer -> Integer
  dk-wr-visible (ws) (ds) = dk-wr-top-vis ws ds (dk-wr-count ws - 1)

  dk-wr-cycle : Integer -> Integer
  dk-wr-cycle (ws) =
    let n = dk-wr-count ws
    in if n <= 1 then dk-wr-top ws
    else
      let t = dk-wr-at ws (n - 1)
      in let s = dk-wr-sink ws (n - 1)
      in let b = dk-wr-set ws 0 t
      in dk-wr-top ws

Section: Windows, continued

  dk-wnd-bar-h : GopFont, Integer -> Integer
  dk-wnd-bar-h (tf) (ws) = (if tf.gf-ok then tf.gf-gh else comp-glyph-h * ws) + 8 * ws

  dk-wnd-btn-x : Integer, Integer, GopFont, Integer, Integer -> Integer
  dk-wnd-btn-x (wx) (ww) (tf) (ws) (i) =
    wx + ww - (3 - i) * dk-wnd-bar-h tf ws

  dk-wnd-btn : Integer, Integer, Integer, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  dk-wnd-btn (base) (stride) (rows) (bx) (by) (name) (side) (ds) (ground) =
    let blk = peek-32 ds dk-icons-cell
    in let pal = dk-pal ds
    in if blk == 0 then 0
    else let ih = dk-icons-size blk
    in gicon-blit-cov base stride rows (dk-icons-at blk name) ih (bx + (side - ih) / 2) (by + (side - ih) / 2) (theme-ink-on pal ground)

  dk-wnd-border : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-wnd-border (base) (stride) (rows) (wx) (wy) (ww) (wh) (ds) (w) =
    let pal = dk-pal ds
    in let ws = ui-wscale w
    in let e0 = gop-fill-rect base stride rows wx wy ww ws (pal.pal-border)
    in let e1 = gop-fill-rect base stride rows wx (wy + wh - ws) ww ws (pal.pal-border)
    in let e2 = gop-fill-rect base stride rows wx wy ws wh (pal.pal-border)
    in gop-fill-rect base stride rows (wx + ww - ws) wy ws wh (pal.pal-border)

  dk-wnd-frame : Integer, Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Text, Integer, Integer, Integer, Integer, Integer, Boolean -> WidgetNode
  dk-wnd-frame (base) (w) (h) (stride) (font) (tf) (tree) (title) (ds) (wx) (wy) (ww) (wh) (focused) =
    let pal = dk-pal ds
    in let ws = ui-wscale w
    in let s = ui-scale w
    in let barcol = if focused then pal.pal-primary else pal.pal-secondary
    in let bh = dk-wnd-bar-h tf ws
    in let body = gop-fill-rect base stride h wx wy ww wh (pal.pal-bg)
    in let bar = gop-fill-rect base stride h (wx + ws) (wy + ws) (ww - 2 * ws) bh barcol
    in let cap = desk-line base stride h font s tf (wx + 8 * ws) (wy + 4 * ws) title (theme-ink-on pal barcol)
    in let b0 = dk-wnd-btn base stride h (dk-wnd-btn-x wx ww tf ws 0) wy "win-min" bh ds barcol
    in let b1 = dk-wnd-btn base stride h (dk-wnd-btn-x wx ww tf ws 1) wy "win-max" bh ds barcol
    in let b2 = dk-wnd-btn base stride h (dk-wnd-btn-x wx ww tf ws 2) wy "win-close" bh ds barcol
    in let laid = comp-render-at base stride h font tf tree (dk-theme-ds ds) wx (wy + bh) ww (wh - bh) ws
    in let bd = dk-wnd-border base stride h wx wy ww wh ds w
    in laid

  dk-wnd-none : Integer = 0
  dk-wnd-min : Integer = 1
  dk-wnd-max : Integer = 2
  dk-wnd-close : Integer = 3
  dk-wnd-bar : Integer = 4
  dk-wnd-body : Integer = 5

  dk-wnd-hit : Integer, Integer, Integer, Integer, Integer, Integer, GopFont, Integer -> Integer
  dk-wnd-hit (wx) (wy) (ww) (wh) (mx) (my) (tf) (ws) =
    let bh = dk-wnd-bar-h tf ws
    in if mx < wx then dk-wnd-none
    else if mx >= wx + ww then dk-wnd-none
    else if my < wy then dk-wnd-none
    else if my >= wy + wh then dk-wnd-none
    else if my >= wy + bh then dk-wnd-body
    else if mx >= dk-wnd-btn-x wx ww tf ws 2 then dk-wnd-close
    else if mx >= dk-wnd-btn-x wx ww tf ws 1 then dk-wnd-max
    else if mx >= dk-wnd-btn-x wx ww tf ws 0 then dk-wnd-min
    else dk-wnd-bar

Section: What a windowed pane is

  desk-wnd-blk : Integer, Integer -> Integer
  desk-wnd-blk (fid) (ds) =
    if fid == desk-focus-clkp then peek-32 ds desk-clock-cell
    else if fid == desk-focus-calc then peek-32 ds 24
    else if fid == desk-focus-con then peek-32 ds desk-console-cell
    else if fid == desk-focus-prog then peek-32 ds desk-prog-cell
    else if fid == desk-focus-cal then peek-32 ds dk-cal-cell
    else if fid == desk-focus-dif then peek-32 ds dk-dif-cell
    else if fid == desk-focus-style then peek-32 ds dk-sty-cell
    else if fid == desk-focus-trk then peek-32 ds dk-trk-cell
    else if fid == desk-focus-mon then peek-32 ds dk-mon-cell
    else if fid == desk-focus-scene then peek-32 ds dk-scene-cell
    else if fid == desk-focus-fish then peek-32 ds dk-fish-cell
    else if fid == desk-focus-bro then peek-32 ds dk-bro-cell
    else if fid == desk-focus-files then peek-32 ds dk-files-cell
    else if fid == desk-focus-edit then peek-32 ds desk-edit-cell
    else if fid == desk-focus-web then peek-32 ds dk-web-cell
    else if fid == desk-focus-sheet then peek-32 ds dk-sheet-cell
    else 0

  desk-wnd-title : Integer -> Text
  desk-wnd-title (fid) =
    if fid == desk-focus-clkp then "Clock"
    else if fid == desk-focus-calc then "Calculator"
    else if fid == desk-focus-con then "Console"
    else if fid == desk-focus-prog then "Program Runner"
    else if fid == desk-focus-cal then "Calendar"
    else if fid == desk-focus-dif then "Diffusion"
    else if fid == desk-focus-style then "Appearance"
    else if fid == desk-focus-trk then "Issues"
    else if fid == desk-focus-mon then "System Info"
    else if fid == desk-focus-scene then "3D View"
    else if fid == desk-focus-fish then "Aquarium"
    else if fid == desk-focus-bro then "Browser"
    else if fid == desk-focus-files then "Files"
    else if fid == desk-focus-edit then "Text Editor"
    else if fid == desk-focus-web then "Web Server"
    else if fid == desk-focus-sheet then "Sheets"
    else ""

  dk-pill-icon : Integer -> Text
  dk-pill-icon (fid) =
    if fid == desk-focus-clkp then "clock"
    else if fid == desk-focus-calc then "grid"
    else if fid == desk-focus-con then "terminal"
    else if fid == desk-focus-prog then "code"
    else if fid == desk-focus-cal then "calendar"
    else if fid == desk-focus-dif then "star"
    else if fid == desk-focus-style then "settings"
    else if fid == desk-focus-trk then "bell"
    else if fid == desk-focus-mon then "info"
    else if fid == desk-focus-scene then "image"
    else if fid == desk-focus-fish then "eye"
    else if fid == desk-focus-bro then "cloud"
    else if fid == desk-focus-files then "folder"
    else if fid == desk-focus-edit then "edit"
    else if fid == desk-focus-web then "cloud"
    else if fid == desk-focus-sheet then "grid"
    else ""

  desk-wnd-tree : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> [Device.Port] WidgetNode
  desk-wnd-tree (fid) (ds) (base) (w) (h) (stride) (tf) =
    if fid == desk-focus-scene | fid == desk-focus-fish | fid == desk-focus-bro | fid == desk-focus-files | fid == desk-focus-edit | fid == desk-focus-sheet then act widget-panel "scene-body" DirColumn 0 [] end
    else if fid == desk-focus-mon then act
      hh <- rtc-read 4
      mm <- rtc-read 2
      ss <- rtc-seconds 0
      let ai = acpi-boot 0
      in let clk = dk-pad2 (dk-bcd hh) & ":" & dk-pad2 (dk-bcd mm) & ":" & dk-pad2 ss
      in dk-mon-tree ds base w h stride tf ai clk (peek-32 dk-mon-tick-cell 0)
    end
    else if fid == desk-focus-trk then act
      let srv = tk-init-tracker-db
      in let filter = peek-32 ds 32
      in let sel = peek-32 ds 40
      in let box = desk-trk-win-box w h srv filter sel ds tf
      in gtk-tree srv filter sel (box.lr-h) (box.lr-w)
    end
    else if fid == desk-focus-calc then act gcalc-tree (peek-32 ds 24) end
    else if fid == desk-focus-web then act gopweb-tree (peek-32 ds dk-web-cell) end
    else if fid == desk-focus-con then act gcon-tree (peek-32 ds desk-console-cell) end
    else if fid == desk-focus-prog then act gpr-tree (peek-32 ds desk-prog-cell) end
    else if fid == desk-focus-dif then act gdf-tree 0 end
    else if fid == desk-focus-style then act dk-style-tree (peek-32 ds dk-scheme-cell) (peek-32 ds dk-adorn-cell) (peek-32 ds dk-sound-on-cell) (dk-task-edge ds) end
    else if fid == desk-focus-cal then act
      yy <- rtc-read 9
      mm <- rtc-read 8
      dd <- rtc-read 7
      gcal-tree (2000 + dk-bcd yy) (dk-bcd mm) (dk-bcd dd)
    end
    else act
      idle <- rtc-wait-idle rtc-uip-fuel
      b <- clk-mode 0
      hh <- clk-hour-now b
      mi <- clk-field-value clk-reg-minutes b
      ss <- clk-field-value clk-reg-seconds b
      dd <- clk-field-value clk-reg-day b
      mo <- clk-field-value clk-reg-month b
      yy <- clk-field-value clk-reg-year b
      let cks = peek-32 ds desk-clock-cell
      in let note = if cks == 0 then 0 else if clk-editing cks then 0 else clk-note-now cks hh mi ss dd mo yy
      in clk-tree cks hh mi ss dd mo yy
    end

  dk-wnd-step-px : Integer -> Integer
  dk-wnd-step-px (w) = 24 * ui-wscale w

  dk-wnd-span : Integer, Integer -> Integer
  dk-wnd-span (room) (step) = if room < step then 1 else room / step + 1

  dk-wnd-cascade-x : Integer, Integer, Integer -> Integer
  dk-wnd-cascade-x (n) (w) (ds) =
    let step = dk-wnd-step-px w
    in int-mod n (dk-wnd-span (dk-cbox-w w ds / 8) step) * step

  dk-wnd-cascade-y : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-cascade-y (n) (w) (h) (ds) =
    let step = dk-wnd-step-px w
    in int-mod n (dk-wnd-span (dk-cbox-h w h ds / 8) step) * step

  dk-refit-clamp : Integer, Integer, Integer -> Integer
  dk-refit-clamp (v) (lo) (hi) = dk-drag-clamp v lo (if hi < lo then lo else hi)

  dk-wnd-refit-one : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-refit-one (fid) (w) (h) (ds) =
    let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in if st == dk-wnd-st-max then 0
    else if dk-wnd-placed blk == False then 0
    else let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds
    in let nx = dk-refit-clamp (dk-wnd-rx blk w st ds) (dk-cbox-x w ds) (dk-cbox-x w ds + dk-cbox-w w ds - ww)
    in let ny = dk-refit-clamp (dk-wnd-ry blk w h st ds) (dk-cbox-y w ds) (dk-cbox-y w ds + dk-cbox-h w h ds - wh)
    in dk-wnd-place blk nx ny ww wh

  dk-wnd-refit : Integer, Integer, Integer, Integer -> Integer
  dk-wnd-refit (w) (h) (ds) (i) =
    let ws = peek-32 ds dk-wr-cell
    in if i >= dk-wr-count ws then 0
    else let r = dk-wnd-refit-one (dk-wr-at ws i) w h ds
    in dk-wnd-refit w h ds (i + 1)

  dk-wnd-content : Integer, Integer, Integer, Integer, GopFont, Integer -> LayoutRect
  dk-wnd-content (fid) (w) (h) (ds) (tf) (s) =
    let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in layout-rect (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds + bh) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds - bh)

  dk-wnd-wants-box : Integer -> Boolean
  dk-wnd-wants-box (fid) =
    fid == desk-focus-prog | fid == desk-focus-cal | fid == desk-focus-dif | fid == desk-focus-trk | fid == desk-focus-mon | fid == desk-focus-sheet

  desk-wnd-open : Integer, Integer, Integer, Integer -> Integer
  desk-wnd-open (fid) (w) (h) (ds) =
    let ws = peek-32 ds dk-wr-cell
    in let n = dk-wr-count ws
    in let blk = desk-wnd-blk fid ds
    in let fresh = dk-wnd-placed blk == False
    in let ox = dk-wnd-cascade-x n w ds
    in let oy = dk-wnd-cascade-y n w h ds
    in let p = if fresh then dk-wnd-place blk (dk-wnd-x w dk-wnd-st-normal ds + ox) (dk-wnd-y w h dk-wnd-st-normal ds + oy) (dk-wnd-w w dk-wnd-st-normal ds) (dk-wnd-h w h dk-wnd-st-normal ds) else 0
    in let m = if fresh & dk-wnd-wants-box fid then poke-32 blk dk-wnd-st-cell dk-wnd-st-max else 0
    in dk-wr-open ws fid

  desk-clock-art : Integer, Integer, Integer, Integer, WidgetNode, Integer -> Integer
  desk-clock-art (base) (stride) (rows) (ws) (laid) (ds) =
    let ks = peek-32 ds desk-clock-cell
    in if ks == 0 then 0
    else if clk-editing ks then 0
    else if clk-view ks == clk-view-zones then desk-clock-map base stride rows ws laid ds ks
    else if clk-view ks == clk-view-formats then 0
    else desk-clock-face base stride rows ws laid ds ks

  desk-clock-box : WidgetNode, Text, Integer -> LayoutRect
  desk-clock-box (laid) (id) (ws) =
    when widget-find laid id
      is Just (n) -> comp-mul-rect (n.wn-bounds) ws
      is None -> layout-rect 0 0 0 0

  desk-clock-face : Integer, Integer, Integer, Integer, WidgetNode, Integer, Integer -> Integer
  desk-clock-face (base) (stride) (rows) (ws) (laid) (ds) (ks) =
    let b = desk-clock-box laid "clk-art" ws
    in if b.lr-w <= 0 then 0
    else if b.lr-h <= 0 then 0
    else
      let pal = dk-pal ds
      in let r = (if b.lr-w < b.lr-h then b.lr-w else b.lr-h) / 2 - 4
      in if r <= 4 then 0
      else
        let cx = b.lr-x + b.lr-w / 2
        in let cy = b.lr-y + b.lr-h / 2
        in let t = clk-local-mins ks (peek-32 ks clk-h-cell) (peek-32 ks clk-mi-cell) (2000 + peek-32 ks clk-y-cell) (peek-32 ks clk-mo-cell) (peek-32 ks clk-d-cell)
        in face-draw base stride rows (layout-rect (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h)) cx cy r (clk-local-h t) (clk-local-mi t) (peek-32 ks clk-s-cell) (pal.pal-bg) (pal.pal-muted) (pal.pal-fg) (pal.pal-accent)

  desk-clock-map : Integer, Integer, Integer, Integer, WidgetNode, Integer, Integer -> Integer
  desk-clock-map (base) (stride) (rows) (ws) (laid) (ds) (ks) =
    let b = desk-clock-box laid "clk-map" ws
    in if b.lr-w <= 0 then 0
    else
      let pal = dk-pal ds
      in let sc = desk-clock-scale (b.lr-w) (b.lr-h)
      in if sc <= 0 then 0
      else
        let ox = b.lr-x + (b.lr-w - wld-cols * sc) / 2
        in let oy = b.lr-y + (b.lr-h - wld-rows * sc) / 2
        in wld-draw base stride rows (layout-rect (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h)) (clk-world ks) ox oy sc (pal.pal-bg) (pal.pal-secondary) (pal.pal-muted) (clk-stripe ks)

  desk-clock-scale : Integer, Integer -> Integer
  desk-clock-scale (w) (h) =
    let a = w / wld-cols
    in let b = h / wld-rows
    in if a < b then a else b

  desk-clock-laid : Integer, Integer, GopFont, Integer, Integer -> WidgetNode
  desk-clock-laid (w) (h) (tf) (ds) (ks) =
    let s = ui-wscale w
    in let blk = desk-wnd-blk desk-focus-clkp ds
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in widget-layout (clk-tree ks (peek-32 ks clk-h-cell) (peek-32 ks clk-mi-cell) (peek-32 ks clk-s-cell) (peek-32 ks clk-d-cell) (peek-32 ks clk-mo-cell) (peek-32 ks clk-y-cell)) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))

  desk-clock-nav-none : Integer = 0 - 1

  desk-clock-nav-click : WidgetNode, Integer, Integer, Integer, Integer -> Integer
  desk-clock-nav-click (laid) (mx) (my) (ws) (ks) =
    if desk-widget-hit laid mx my "clk-nav-tab-0" ws then
      let a = poke-32 ks clk-editing-cell 0
      in let b = clk-set-view ks clk-view-face
      in 1
    else if desk-widget-hit laid mx my "clk-nav-tab-1" ws then
      let a = poke-32 ks clk-editing-cell 0
      in let b = clk-set-view ks clk-view-zones
      in 1
    else if desk-widget-hit laid mx my "clk-nav-tab-2" ws then
      let a = poke-32 ks clk-editing-cell 0
      in let b = clk-set-view ks clk-view-formats
      in 1
    else if desk-widget-hit laid mx my "clk-nav-tab-3" ws then
      let a = clk-set-view ks clk-view-face
      in 3
    else desk-clock-nav-none

  desk-clock-field-click : WidgetNode, Integer, Integer, Integer, Integer, Integer -> Integer
  desk-clock-field-click (laid) (mx) (my) (ws) (ks) (i) =
    if i >= clk-fields then 0
    else if desk-widget-hit laid mx my ("clk-f-" & clk-field-name i) ws then
      let d = poke-32 ks clk-field-cell i
      in 1
    else desk-clock-field-click laid mx my ws ks (i + 1)

  desk-clock-edit-click : WidgetNode, Integer, Integer, Integer, Integer -> Integer
  desk-clock-edit-click (laid) (mx) (my) (ws) (ks) =
    if desk-widget-hit laid mx my "clk-less" ws then let d = clk-bump ks (0 - 1) in 1
    else if desk-widget-hit laid mx my "clk-more" ws then let d = clk-bump ks 1 in 1
    else if desk-widget-hit laid mx my "clk-keep" ws then 4
    else if desk-widget-hit laid mx my "clk-cancel" ws then 5
    else desk-clock-field-click laid mx my ws ks 0

  desk-clock-click : Integer, Integer, GopFont, UsbMouse, Integer, Integer -> Integer
  desk-clock-click (w) (h) (tf) (mouse) (ds) (ks) =
    let ws = ui-wscale w
    in let laid = desk-clock-laid w h tf ds ks
    in let mx = mouse-x mouse
    in let my = mouse-y mouse
    in let nv = desk-clock-nav-click laid mx my ws ks
    in if nv /= desk-clock-nav-none then nv
    else if clk-editing ks then desk-clock-edit-click laid mx my ws ks
    else if clk-view ks == clk-view-zones then
      if desk-widget-hit laid mx my "clk-band-w" ws then let d = clk-set-stripe ks (clk-stripe ks - 1) in 1
      else if desk-widget-hit laid mx my "clk-band-e" ws then let d = clk-set-stripe ks (clk-stripe ks + 1) in 1
      else
        let b = desk-clock-box laid "clk-map" ws
        in let sc = desk-clock-scale (b.lr-w) (b.lr-h)
        in if sc <= 0 then 0
        else
          let ox = b.lr-x + (b.lr-w - wld-cols * sc) / 2
          in let oy = b.lr-y + (b.lr-h - wld-rows * sc) / 2
          in let s = wld-hit-stripe ox oy sc mx my 0
          in if s /= wld-none then let d = clk-set-stripe ks s in 1
          else desk-clock-row-click laid mx my ws ks
    else if clk-view ks == clk-view-formats then desk-clock-fmt-click laid mx my ws ks
    else 0

  desk-clock-row-at : WidgetNode, Integer, Integer, Integer, List Integer, Integer, Integer -> Integer
  desk-clock-row-at (laid) (mx) (my) (ws) (ids) (i) (n) =
    if i >= n then 0 - 1
    else if desk-widget-hit laid mx my ("clk-z-" & show (list-at ids i)) ws then i
    else desk-clock-row-at laid mx my ws ids (i + 1) n

  desk-clock-row-click : WidgetNode, Integer, Integer, Integer, Integer -> Integer
  desk-clock-row-click (laid) (mx) (my) (ws) (ks) =
    let ids = clk-stripe-list ks
    in let i = desk-clock-row-at laid mx my ws ids 0 (list-length ids)
    in if i < 0 then 0
    else
      let a = poke-32 ks clk-pick-cell i
      in let b = poke-32 ks clk-zid-cell (list-at ids i)
      in let c = clk-set-view ks clk-view-face
      in 2

  desk-clock-fmt-click : WidgetNode, Integer, Integer, Integer, Integer -> Integer
  desk-clock-fmt-click (laid) (mx) (my) (ws) (ks) =
    if desk-widget-hit laid mx my "clk-c24" ws then let d = poke-32 ks clk-cfmt-cell loc-clock-24 in 2
    else if desk-widget-hit laid mx my "clk-c12" ws then let d = poke-32 ks clk-cfmt-cell loc-clock-12 in 2
    else if desk-widget-hit laid mx my "clk-dmy" ws then let d = poke-32 ks clk-dfmt-cell loc-date-dmy in 2
    else if desk-widget-hit laid mx my "clk-mdy" ws then let d = poke-32 ks clk-dfmt-cell loc-date-mdy in 2
    else if desk-widget-hit laid mx my "clk-ymd" ws then let d = poke-32 ks clk-dfmt-cell loc-date-ymd in 2
    else if desk-widget-hit laid mx my "clk-b-time" ws then let d = clk-band-toggle ks zone-band-time in 2
    else if desk-widget-hit laid mx my "clk-b-date" ws then let d = clk-band-toggle ks zone-band-date in 2
    else if desk-widget-hit laid mx my "clk-b-off" ws then let d = clk-band-toggle ks zone-band-offset in 2
    else 0
  desk-wnd-over : Integer, Integer, Integer, Integer, GopFont, Integer, WidgetNode, Integer -> Integer
  desk-wnd-over (base) (stride) (rows) (ws) (tf) (fid) (laid) (ds) =
    if fid == desk-focus-prog then
      let es = gpr-entries
      in desk-gpr-icons base stride rows laid (dk-theme-ds ds) ws tf es (list-length es) (gpr-sel (peek-32 ds desk-prog-cell)) 0 ds
    else if fid == desk-focus-clkp then desk-clock-art base stride rows ws laid ds
    else 0

  desk-wnd-one : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, Boolean -> [Device.Port] WidgetNode
  desk-wnd-one (base) (w) (h) (stride) (font) (tf) (ds) (fid) (focused) = act
    tree <- desk-wnd-tree fid ds base w h stride tf
    let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in let laid = dk-wnd-frame base w h stride font tf tree (desk-wnd-title fid) ds (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) focused
    in let ov = desk-wnd-over base stride h (ui-wscale w) tf fid laid ds
    in laid
  end

  desk-wnd-walk : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, Integer -> [Device.Port] Integer
  desk-wnd-walk (base) (w) (h) (stride) (font) (tf) (ds) (ws) (i) =
    if i >= dk-wr-count ws then act 0 end
    else if dk-wnd-minimised (desk-wnd-blk (dk-wr-at ws i) ds) then
      desk-wnd-walk base w h stride font tf ds ws (i + 1)
    else act
      one <- desk-wnd-one base w h stride font tf ds (dk-wr-at ws i) (dk-wr-at ws i == dk-wr-visible ws ds)
      desk-wnd-walk base w h stride font tf ds ws (i + 1)
    end

  desk-wnd-index : Integer, Integer, Integer -> Integer
  desk-wnd-index (ws) (fid) (i) =
    if i >= dk-wr-count ws then 0 - 1
    else if dk-wr-at ws i == fid then i
    else desk-wnd-index ws fid (i + 1)

  desk-wnd-paint-from : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-wnd-paint-from (base) (w) (h) (stride) (font) (tf) (ds) (fid) =
    let ws = peek-32 ds dk-wr-cell
    in let i = desk-wnd-index ws fid 0
    in if i < 0 then act 0 end
    else desk-wnd-walk base w h stride font tf ds ws i

  desk-wnd-band : Integer, Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Integer -> Integer
  desk-wnd-band (base) (w) (stride) (rows) (font) (tf) (laid) (ds) =
    when widget-find laid "taskbar"
      is None -> 0
      is Just (tb) ->
        let ws = ui-wscale w
        in let r = comp-walk base stride rows (comp-mul-rect (tb.wn-bounds) ws) font tf tb (dk-theme-ds ds) ws
        in let ic = desk-chrome-icons base stride rows laid (dk-theme-ds ds) ws tf ds
        in poke-32 ds desk-second-cell (0 - 1)

  desk-wnd-paint-all : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-wnd-paint-all (base) (w) (h) (stride) (font) (tf) (ds) = act
    let rs = poke-32 ds dk-restay-cell (dk-wr-visible (peek-32 ds dk-wr-cell) ds)
    in let chrome = dk-chrome-paint base w h stride font tf (widget-panel "content" DirColumn 0 []) ds
    in act
      all <- desk-wnd-walk base w h stride font tf ds (peek-32 ds dk-wr-cell) 0
      let band = desk-wnd-band base w stride h font tf chrome ds
      in desk-topbar base w stride font (ui-scale w) tf h ds
    end
  end

  desk-wnd-at : Integer, Integer, Integer, Integer, GopFont, Integer, Integer, Integer -> Integer
  desk-wnd-at (w) (h) (mx) (my) (tf) (ds) (ws) (i) =
    if i < 0 then desk-focus-none
    else
      let fid = dk-wr-at ws i
      in let blk = desk-wnd-blk fid ds
      in let st = dk-wnd-st blk
      in if dk-wnd-minimised blk then desk-wnd-at w h mx my tf ds ws (i - 1)
      else if dk-wnd-hit (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) mx my tf (ui-wscale w) /= dk-wnd-none then fid
      else desk-wnd-at w h mx my tf ds ws (i - 1)

Section: Dragging a window by its titlebar

  dk-drag-cell : Integer = 120
  dk-drag-off-cell : Integer = 124

Section: Resize zones

  dk-size-none : Integer = 0
  dk-size-l : Integer = 1
  dk-size-r : Integer = 2
  dk-size-t : Integer = 3
  dk-size-b : Integer = 4
  dk-size-tl : Integer = 5
  dk-size-tr : Integer = 6
  dk-size-bl : Integer = 7
  dk-size-br : Integer = 8

  dk-size-grip : Integer = 6

  dk-size-zone-rect : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-zone-rect (rx) (ry) (rw) (rh) (g) (mx) (my) =
    if mx < rx - g then dk-size-none
    else if mx > rx + rw + g then dk-size-none
    else if my < ry - g then dk-size-none
    else if my > ry + rh + g then dk-size-none
    else
      let l = mx <= rx + g
      in let r = mx >= rx + rw - g
      in let t = my <= ry + g
      in let b = my >= ry + rh - g
      in if t & l then dk-size-tl
      else if t & r then dk-size-tr
      else if b & l then dk-size-bl
      else if b & r then dk-size-br
      else if l then dk-size-l
      else if r then dk-size-r
      else if t then dk-size-t
      else if b then dk-size-b
      else dk-size-none

  dk-size-zone : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-zone (ds) (w) (h) (mx) (my) =
    let fid = dk-wr-visible (peek-32 ds dk-wr-cell) ds
    in if fid == desk-focus-none then dk-size-none
    else
      let blk = desk-wnd-blk fid ds
      in if blk == 0 then dk-size-none
      else
        let st = dk-wnd-st blk
        in if st == dk-wnd-st-max then dk-size-none
        else
          let g = dk-size-grip * ui-scale w
          in dk-size-zone-rect (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) g mx my

  dk-size-cursor : Integer -> Integer
  dk-size-cursor (z) =
    if z == dk-size-l then cursor-shape-ew
    else if z == dk-size-r then cursor-shape-ew
    else if z == dk-size-t then cursor-shape-ns
    else if z == dk-size-b then cursor-shape-ns
    else if z == dk-size-tl then cursor-shape-nwse
    else if z == dk-size-br then cursor-shape-nwse
    else if z == dk-size-tr then cursor-shape-nesw
    else if z == dk-size-bl then cursor-shape-nesw
    else cursor-shape-arrow

  dk-size-cell : Integer = 144
  dk-size-fid-cell : Integer = 148
  dk-size-x0-cell : Integer = 152
  dk-size-y0-cell : Integer = 156
  dk-size-w0-cell : Integer = 160
  dk-size-h0-cell : Integer = 164

  dk-size-active : Integer -> Integer
  dk-size-active (ds) = peek-32 ds dk-size-cell

  dk-size-begin : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-begin (ds) (fid) (z) (x0) (y0) (w0) (h0) =
    let a = poke-32 ds dk-size-fid-cell fid
    in let b = poke-32 ds dk-size-x0-cell x0
    in let c = poke-32 ds dk-size-y0-cell y0
    in let d = poke-32 ds dk-size-w0-cell w0
    in let e = poke-32 ds dk-size-h0-cell h0
    in poke-32 ds dk-size-cell z

  dk-size-end : Integer -> Integer
  dk-size-end (ds) = poke-32 ds dk-size-cell dk-size-none

  dk-size-left : Integer -> Boolean
  dk-size-left (z) = z == dk-size-l | z == dk-size-tl | z == dk-size-bl

  dk-size-right : Integer -> Boolean
  dk-size-right (z) = z == dk-size-r | z == dk-size-tr | z == dk-size-br

  dk-size-top : Integer -> Boolean
  dk-size-top (z) = z == dk-size-t | z == dk-size-tl | z == dk-size-tr

  dk-size-bot : Integer -> Boolean
  dk-size-bot (z) = z == dk-size-b | z == dk-size-bl | z == dk-size-br

  dk-size-minw : Integer -> Integer
  dk-size-minw (w) = 200 * ui-scale w

  dk-size-minh : Integer -> Integer
  dk-size-minh (w) = 120 * ui-scale w

  dk-size-new-w : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-new-w (z) (x0) (w0) (mx) (minw) =
    if dk-size-left z then
      let nw = (x0 + w0) - mx
      in if nw < minw then minw else nw
    else if dk-size-right z then
      let nw = mx - x0
      in if nw < minw then minw else nw
    else w0

  dk-size-new-x : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-new-x (z) (x0) (w0) (mx) (minw) =
    if dk-size-left z then (x0 + w0) - dk-size-new-w z x0 w0 mx minw
    else x0

  dk-size-new-h : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-new-h (z) (y0) (h0) (my) (minh) (w) (h) (ds) =
    if dk-size-top z then
      let top = dk-cbox-y w ds
      in let ty = if my < top then top else my
      in let nh = (y0 + h0) - ty
      in if nh < minh then minh else nh
    else if dk-size-bot z then
      let bot = dk-cbox-y w ds + dk-cbox-h w h ds
      in let by = if my > bot then bot else my
      in let nh = by - y0
      in if nh < minh then minh else nh
    else h0

  dk-size-new-y : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-size-new-y (z) (y0) (h0) (my) (minh) (w) (h) (ds) =
    if dk-size-top z then (y0 + h0) - dk-size-new-h z y0 h0 my minh w h ds
    else y0

Section: The loop's own rate

  dk-rate-n-cell : Integer = 128
  dk-rate-t0-cell : Integer = 132
  dk-rate-cell : Integer = 136
  dk-rate-armed-cell : Integer = 140
  dk-rate-mask : Integer = 4294967295

  dk-rate-tick : Integer -> Integer
  dk-rate-tick (ds) =
    let n = peek-32 ds dk-rate-n-cell + 1
    in if peek-32 ds dk-rate-armed-cell == 0 then
      let a = poke-32 ds dk-rate-armed-cell 1
      in let b = poke-32 ds dk-rate-t0-cell (bit-and hpet-ticks dk-rate-mask)
      in let c = poke-32 ds dk-rate-n-cell n
      in 1
    else
      let tps = hpet-ticks-per-second
      in if tps <= 0 then (let z = poke-32 ds dk-rate-n-cell n in 0)
      else
        let now = bit-and hpet-ticks dk-rate-mask
        in let t0 = peek-32 ds dk-rate-t0-cell
        in let d = bit-and (now - t0) dk-rate-mask
        in if d < tps then (let z = poke-32 ds dk-rate-n-cell n in 0)
        else
          let r = poke-32 ds dk-rate-cell (n * tps / d)
          in let a = poke-32 ds dk-rate-t0-cell now
          in let b = poke-32 ds dk-rate-n-cell 0
          in 1

  dk-rate-w : Integer = 96

  desk-rate-paint : Integer, Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, UsbMouse, Integer -> Integer
  desk-rate-paint (base) (w) (h) (stride) (font) (s) (tf) (cs) (mouse) (ds) =
    let hd = cursor-hide cs base stride
    in let pal = dk-pal ds
    in let x = w - dk-rate-w * s
    in let bg = gop-fill-rect base stride h x 0 (dk-rate-w * s) (dk-bar-h * s) (pal.pal-border)
    in let t = if hpet-ticks-per-second <= 0 then "no hpet" else show (peek-32 ds dk-rate-cell) & " it/s"
    in let d = desk-line base stride h font s tf x (4 * s) t (pal.pal-accent)
    in dk-cursor base w h stride cs mouse

  dk-drag-fid : Integer -> Integer
  dk-drag-fid (ds) = peek-32 ds dk-drag-cell

  dk-drag-dx : Integer -> Integer
  dk-drag-dx (ds) = peek-32 ds dk-drag-off-cell / 65536

  dk-drag-dy : Integer -> Integer
  dk-drag-dy (ds) = peek-32 ds dk-drag-off-cell - dk-drag-dx ds * 65536

  dk-drag-begin : Integer, Integer, Integer, Integer -> Integer
  dk-drag-begin (ds) (fid) (dx) (dy) =
    let a = poke-32 ds dk-drag-off-cell (dx * 65536 + dy)
    in poke-32 ds dk-drag-cell fid

  dk-drag-end : Integer -> Integer
  dk-drag-end (ds) = poke-32 ds dk-drag-cell desk-focus-none

  dk-drag-held : UsbMouse -> Boolean
  dk-drag-held (mouse) = bit-and (mouse-buttons mouse) 1 /= 0

  dk-flick-p1-cell : Integer = 172
  dk-flick-t1-cell : Integer = 176
  dk-flick-p0-cell : Integer = 180
  dk-flick-t0-cell : Integer = 184
  dk-flick-cell : Integer = 188
  dk-flick-dir-cell : Integer = 192
  dk-flick-org-cell : Integer = 196
  dk-flick-rt-cell : Integer = 200

  dk-pt : Integer, Integer -> Integer
  dk-pt (x) (y) = x * 65536 + y

  dk-pt-x : Integer -> Integer
  dk-pt-x (v) = v / 65536

  dk-pt-y : Integer -> Integer
  dk-pt-y (v) = v - dk-pt-x v * 65536

  dk-flick-speed : Integer = 700
  dk-flick-reach : Integer = 24
  dk-flick-ms : Integer = 300

  dk-flick-roll : Integer = 40

  dk-flick-begin : Integer, Integer, Integer, Integer -> Integer
  dk-flick-begin (ds) (x) (y) (now) =
    let a = poke-32 ds dk-flick-p1-cell (dk-pt x y)
    in let b = poke-32 ds dk-flick-t1-cell now
    in let c = poke-32 ds dk-flick-p0-cell (dk-pt x y)
    in poke-32 ds dk-flick-t0-cell now

  dk-flick-sample : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-flick-sample (ds) (x) (y) (now) (tps) =
    let el = bit-and (now - peek-32 ds dk-flick-t0-cell) dk-rate-mask
    in if tps <= 0 then 0
    else if el * 1000 < dk-flick-roll * tps then 0
    else
      let a = poke-32 ds dk-flick-p1-cell (peek-32 ds dk-flick-p0-cell)
      in let b = poke-32 ds dk-flick-t1-cell (peek-32 ds dk-flick-t0-cell)
      in let c = poke-32 ds dk-flick-p0-cell (dk-pt x y)
      in let d = poke-32 ds dk-flick-t0-cell now
      in 1

  dk-flick-mag : Integer, Integer -> Integer
  dk-flick-mag (dx) (dy) =
    let ax = if dx < 0 then 0 - dx else dx
    in let ay = if dy < 0 then 0 - dy else dy
    in if ax >= ay then ax else ay

  dk-flick-edge : Integer, Integer -> Integer
  dk-flick-edge (dx) (dy) =
    let ax = if dx < 0 then 0 - dx else dx
    in let ay = if dy < 0 then 0 - dy else dy
    in if ax >= ay then (if dx < 0 then dk-edge-left else dk-edge-right)
       else (if dy < 0 then dk-edge-top else dk-edge-bottom)

  dk-flick-fast : Integer, Integer, Integer, Integer -> Boolean
  dk-flick-fast (dx) (dy) (el) (tps) =
    if tps <= 0 then False
    else if el <= 0 then False
    else dk-flick-mag dx dy * tps >= dk-flick-speed * el

  dk-flick-through : Integer, Integer, Integer, Integer -> Boolean
  dk-flick-through (dir) (dx) (dy) (reach) =
    if dir == dk-edge-left then 0 - dx >= reach
    else if dir == dk-edge-right then dx >= reach
    else if dir == dk-edge-top then 0 - dy >= reach
    else dy >= reach

  dk-flick-expired : Integer, Integer -> Boolean
  dk-flick-expired (el) (tps) =
    if tps <= 0 then True else el * 1000 > dk-flick-ms * tps

  dk-flick-wait : Integer = 0
  dk-flick-dock : Integer = 1
  dk-flick-drop : Integer = 2

  dk-flick-verdict : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-flick-verdict (dir) (dx) (dy) (reach) (el) (tps) =
    if dk-flick-expired el tps then dk-flick-drop
    else if dk-flick-through dir dx dy reach then dk-flick-dock
    else dk-flick-wait

  dk-flick-fid : Integer -> Integer
  dk-flick-fid (ds) = peek-32 ds dk-flick-cell

  dk-pedge-cell : Integer = 212

  dk-pedge-slots : Integer = 19

  dk-pedge-init : Integer -> Integer
  dk-pedge-init (ds) = poke-32 ds dk-pedge-cell (alloc-zeroed (4 * dk-pedge-slots) 4)

  dk-pedge-set : Integer, Integer, Integer -> Integer
  dk-pedge-set (ds) (fid) (e) =
    if fid < 0 then 0
    else if fid >= dk-pedge-slots then 0
    else poke-32 (peek-32 ds dk-pedge-cell) (4 * fid) (e + 1)

  dk-pedge-get : Integer, Integer -> Integer
  dk-pedge-get (ds) (fid) =
    if fid < 0 then dk-task-edge ds
    else if fid >= dk-pedge-slots then dk-task-edge ds
    else let v = peek-32 (peek-32 ds dk-pedge-cell) (4 * fid)
    in if v == 0 then dk-task-edge ds else v - 1

  dk-flick-arm : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-flick-arm (ds) (fid) (dir) (x) (y) (now) =
    let a = poke-32 ds dk-flick-dir-cell dir
    in let b = poke-32 ds dk-flick-org-cell (dk-pt x y)
    in let c = poke-32 ds dk-flick-rt-cell now
    in poke-32 ds dk-flick-cell fid

  dk-flick-end : Integer -> Integer
  dk-flick-end (ds) = poke-32 ds dk-flick-cell desk-focus-none

  dk-drag-clamp : Integer, Integer, Integer -> Integer
  dk-drag-clamp (v) (lo) (hi) =
    if v < lo then lo else if v > hi then hi else v

  dk-drag-keep : Integer = 64

  dk-drag-x : Integer, Integer, Integer -> Integer
  dk-drag-x (x) (ww) (w) =
    dk-drag-clamp x (dk-drag-keep - ww) (w - dk-drag-keep)

  dk-drag-keep-y : Integer -> Integer
  dk-drag-keep-y (w) = dk-bar-h * ui-wscale w

  dk-drag-y : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-drag-y (y) (wh) (w) (h) (ds) =
    let keep = dk-drag-keep-y w
    in let stop = if wh < keep then wh else keep
    in dk-drag-clamp y (dk-cbox-y w ds) (dk-cbox-y w ds + dk-cbox-h w h ds - stop)

  dk-drag-to-x : Integer, Integer, Integer, Integer -> Integer
  dk-drag-to-x (ds) (mx) (ww) (w) = dk-drag-x (mx - dk-drag-dx ds) ww w

  dk-drag-to-y : Integer, Integer, Integer, Integer, Integer -> Integer
  dk-drag-to-y (ds) (my) (wh) (w) (h) = dk-drag-y (my - dk-drag-dy ds) wh w h ds

  dk-drag-edge : Integer = 2

  desk-wnd-drag-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-wnd-drag-step (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) =
    let fid = dk-drag-fid ds
    in let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds
    in let ox = dk-wnd-rx blk w st ds
    in let oy = dk-wnd-ry blk w h st ds
    in if dk-drag-held mouse == False then act
      hd <- act cursor-hide cs base stride end
      let e = gop-xor-frame base stride w h ox oy ww wh dk-drag-edge
      in let now = hpet-ticks
      in let bp = peek-32 ds dk-flick-p1-cell
      in let vx = mouse-x mouse - dk-pt-x bp
      in let vy = mouse-y mouse - dk-pt-y bp
      in let el = bit-and (now - peek-32 ds dk-flick-t1-cell) dk-rate-mask
      in let d = dk-drag-end ds
      in let f = if dk-flick-fast vx vy el hpet-ticks-per-second
        then dk-flick-arm ds fid (dk-flick-edge vx vy) (mouse-x mouse) (mouse-y mouse) now
        else 0
      in act
        r <- desk-wnd-paint-all base w h stride font tf ds
        c <- act dk-cursor base w h stride cs mouse end
        desk-wnd-ev-stay
      end
    end
    else
      let s = dk-flick-sample ds (mouse-x mouse) (mouse-y mouse) hpet-ticks hpet-ticks-per-second
      in let nx = dk-drag-to-x ds (mouse-x mouse) ww w
      in let ny = dk-drag-to-y ds (mouse-y mouse) wh w h
      in if nx == ox & ny == oy then act desk-wnd-ev-stay end
      else act
        hd <- act cursor-hide cs base stride end
        let e = gop-xor-frame base stride w h ox oy ww wh dk-drag-edge
        in let p = dk-wnd-place blk nx ny ww wh
        in let n = gop-xor-frame base stride w h nx ny ww wh dk-drag-edge
        in act
          c <- act dk-cursor base w h stride cs mouse end
          desk-wnd-ev-stay
        end
      end

  dk-flick-dock-at : Integer, Integer, Integer -> Integer
  dk-flick-dock-at (ds) (fid) (dir) =
    let e = dk-flick-end ds
    in let p = dk-pedge-set ds fid dir
    in poke-32 (desk-wnd-blk fid ds) dk-wnd-st-cell dk-wnd-st-min

  desk-wnd-flick-step : Integer, Integer, UsbMouse, Integer -> Integer
  desk-wnd-flick-step (w) (ds) (mouse) (now) =
    let fid = dk-flick-fid ds
    in let dir = peek-32 ds dk-flick-dir-cell
    in let org = peek-32 ds dk-flick-org-cell
    in let dx = mouse-x mouse - dk-pt-x org
    in let dy = mouse-y mouse - dk-pt-y org
    in let el = bit-and (now - peek-32 ds dk-flick-rt-cell) dk-rate-mask
    in let v = dk-flick-verdict dir dx dy (dk-flick-reach * ui-scale w) el hpet-ticks-per-second
    in if v == dk-flick-dock then
      let m = dk-flick-dock-at ds fid dir
      in desk-wnd-ev-min
    else if v == dk-flick-drop then
      let e = dk-flick-end ds
      in desk-wnd-ev-stay
    else desk-wnd-ev-stay

  desk-wnd-size-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-wnd-size-step (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) =
    let z = dk-size-active ds
    in let fid = peek-32 ds dk-size-fid-cell
    in let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in let ox = dk-wnd-rx blk w st ds
    in let oy = dk-wnd-ry blk w h st ds
    in let ow = dk-wnd-rw blk w st ds
    in let oh = dk-wnd-rh blk w h st ds
    in if dk-drag-held mouse == False then act
      hd <- act cursor-hide cs base stride end
      let e = gop-xor-frame base stride w h ox oy ow oh dk-drag-edge
      in let d = dk-size-end ds
      in act
        r <- desk-wnd-paint-all base w h stride font tf ds
        c <- act dk-cursor base w h stride cs mouse end
        desk-wnd-ev-stay
      end
    end
    else
      let x0 = dk-cell-signed (peek-32 ds dk-size-x0-cell)
      in let y0 = dk-cell-signed (peek-32 ds dk-size-y0-cell)
      in let w0 = peek-32 ds dk-size-w0-cell
      in let h0 = peek-32 ds dk-size-h0-cell
      in let nw = dk-size-new-w z x0 w0 (mouse-x mouse) (dk-size-minw w)
      in let nx = dk-size-new-x z x0 w0 (mouse-x mouse) (dk-size-minw w)
      in let nh = dk-size-new-h z y0 h0 (mouse-y mouse) (dk-size-minh w) w h ds
      in let ny = dk-size-new-y z y0 h0 (mouse-y mouse) (dk-size-minh w) w h ds
      in if nx == ox & ny == oy & nw == ow & nh == oh then act desk-wnd-ev-stay end
      else act
        hd <- act cursor-hide cs base stride end
        let e = gop-xor-frame base stride w h ox oy ow oh dk-drag-edge
        in let p = dk-wnd-place blk nx ny nw nh
        in let n = gop-xor-frame base stride w h nx ny nw nh dk-drag-edge
        in act
          c <- act dk-cursor base w h stride cs mouse end
          desk-wnd-ev-stay
        end
      end

Section: The window chrome's own step

  desk-wnd-ev-pass : Integer = 0
  desk-wnd-ev-stay : Integer = 1
  desk-wnd-ev-close : Integer = 2

  desk-wnd-ev-min : Integer = 3

  desk-wnd-key-cycle : Integer = 15

  desk-wnd-chrome-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-wnd-chrome-step (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) (fid) (sc) (clicked) =
    let ws = peek-32 ds dk-wr-cell
    in let blk = desk-wnd-blk fid ds
    in let st = dk-wnd-st blk
    in let onto = if clicked then desk-wnd-at w h (mouse-x mouse) (mouse-y mouse) tf ds ws (dk-wr-count ws - 1) else desk-focus-none
    in let btn = if clicked & onto == fid then dk-wnd-hit (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) (mouse-x mouse) (mouse-y mouse) tf (ui-wscale w) else dk-wnd-none
    in let zone = if clicked & fid == dk-wr-visible ws ds & st /= dk-wnd-st-max then dk-size-zone-rect (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) (dk-size-grip * ui-scale w) (mouse-x mouse) (mouse-y mouse) else dk-size-none
    in let fd = if dk-flick-fid ds /= desk-focus-none & (clicked | dk-flick-fid ds /= fid) then dk-flick-end ds else 0
    in if peek-32 ds dk-restay-cell == fid then act
      let c = poke-32 ds dk-restay-cell desk-focus-none
      in desk-wnd-ev-stay
    end
    else if dk-size-active ds /= dk-size-none then desk-wnd-size-step base w h stride font tf mouse ds cs
    else if dk-drag-fid ds /= desk-focus-none then desk-wnd-drag-step base w h stride font tf mouse ds cs
    else if dk-flick-fid ds /= desk-focus-none then act desk-wnd-flick-step w ds mouse hpet-ticks end
    else if sc == desk-wnd-key-cycle & dk-wr-count ws > 1 then act
      let t = dk-wr-cycle ws
      in let f = poke-32 ds desk-focus-cell t
      in act
        r <- desk-wnd-repaint base w h stride font tf cs mouse ds
        desk-wnd-ev-stay
      end
    end
    else if btn == dk-wnd-close then act desk-wnd-ev-close end
    else if btn == dk-wnd-max then act
      let t = poke-32 blk dk-wnd-st-cell (if st == dk-wnd-st-max then dk-wnd-st-normal else dk-wnd-st-max)
      in act
        r <- desk-wnd-repaint base w h stride font tf cs mouse ds
        desk-wnd-ev-stay
      end
    end
    else if btn == dk-wnd-min then act
      let t = poke-32 blk dk-wnd-st-cell dk-wnd-st-min
      in desk-wnd-ev-min
    end

    else if zone /= dk-size-none then act
      hd <- act cursor-hide cs base stride end
      let g = dk-size-begin ds fid zone (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds)
      in let o = gop-xor-frame base stride w h (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) dk-drag-edge
      in act
        c <- act dk-cursor base w h stride cs mouse end
        desk-wnd-ev-stay
      end
    end
    else if clicked & onto /= desk-focus-none & onto /= fid then act
      let t = dk-wr-raise ws onto
      in let f = poke-32 ds desk-focus-cell t
      in let ob = desk-wnd-blk onto ds
      in let ost = dk-wnd-st ob
      in let ohit = dk-wnd-hit (dk-wnd-rx ob w ost ds) (dk-wnd-ry ob w h ost ds) (dk-wnd-rw ob w ost ds) (dk-wnd-rh ob w h ost ds) (mouse-x mouse) (mouse-y mouse) tf (ui-wscale w)
      in let g = if ohit == dk-wnd-bar & ost /= dk-wnd-st-max then dk-drag-begin ds onto (mouse-x mouse - dk-wnd-rx ob w ost ds) (mouse-y mouse - dk-wnd-ry ob w h ost ds) else 0
      in let fb = if dk-drag-fid ds /= desk-focus-none then dk-flick-begin ds (mouse-x mouse) (mouse-y mouse) hpet-ticks else 0
      in if dk-drag-fid ds /= desk-focus-none then act
        hd <- act cursor-hide cs base stride end
        let o = gop-xor-frame base stride w h (dk-wnd-rx ob w ost ds) (dk-wnd-ry ob w h ost ds) (dk-wnd-rw ob w ost ds) (dk-wnd-rh ob w h ost ds) dk-drag-edge
        in act
          c <- act dk-cursor base w h stride cs mouse end
          desk-wnd-ev-stay
        end
      end
      else act
        r <- desk-wnd-repaint base w h stride font tf cs mouse ds
        desk-wnd-ev-stay
      end
    end
    else if btn == dk-wnd-bar & st /= dk-wnd-st-max then act
      hd <- act cursor-hide cs base stride end
      let g = dk-drag-begin ds fid (mouse-x mouse - dk-wnd-rx blk w st ds) (mouse-y mouse - dk-wnd-ry blk w h st ds)
      in let fb = dk-flick-begin ds (mouse-x mouse) (mouse-y mouse) hpet-ticks
      in let o = gop-xor-frame base stride w h (dk-wnd-rx blk w st ds) (dk-wnd-ry blk w h st ds) (dk-wnd-rw blk w st ds) (dk-wnd-rh blk w h st ds) dk-drag-edge
      in act
        c <- act dk-cursor base w h stride cs mouse end
        desk-wnd-ev-stay
      end
    end
    else act desk-wnd-ev-pass end

  desk-wnd-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer -> [Device.Port] Integer
  desk-wnd-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ds) = act
    hd <- act cursor-hide cs base stride end
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in act
      p <- desk-wnd-paint-all base w h stride font tf ds
      dk-cursor base w h stride cs mouse
    end
  end

  desk-clock-read : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer

  desk-clock-read (base) (w) (h) (stride) (font) (tf) (ks) (ds) =
    desk-wnd-paint-from base w h stride font tf ds desk-focus-clkp

  desk-clock-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer

  desk-clock-paint (base) (w) (h) (stride) (font) (tf) (ks) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-clock-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-clock-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ks) (ds) = act
    hd <- act cursor-hide cs base stride end
    p <- desk-clock-read base w h stride font tf ks ds
    dk-cursor base w h stride cs mouse
  end

  dk-clkp-last-cell : Integer = 40

  desk-clock-pane-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-clock-pane-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    let mark = __heap-save
    in act
      now <- rtc-seconds-unguarded 0
      ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-clkp sc clicked
      let ks = peek-32 ds desk-clock-cell
      in if ev == desk-wnd-ev-close then let d = __heap-restore mark in 0
      else if ev == desk-wnd-ev-min then let d = __heap-restore mark in desk-step-hide
      else if ev == desk-wnd-ev-stay then
        let u = poke-32 ks dk-clkp-last-cell now
        in let d = __heap-restore mark
        in 1
      else if sc == 88 then act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
      else if clicked then act
        let a = desk-clock-click w h tf mouse ds ks
        in act
          l <- if a == 3 then clk-load ks else act 0 end
          c <- if a == 4 then clk-commit ks else act 0 end
          zs <- if a == 4 then zone-save (clk-zone ks) else act False end
          let e = if a == 4 | a == 5 then poke-32 ks clk-editing-cell 0 else 0
          in act
            p <- if a == 0 then act 0 end else desk-clock-repaint base w h stride font tf cs mouse ks ds
            z <- if a == 2 then zone2-save (clk-record ks (2000 + peek-32 ks clk-y-cell) (peek-32 ks clk-mo-cell) (peek-32 ks clk-d-cell) (peek-32 ks clk-h-cell)) else act False end
            let u = poke-32 ks dk-clkp-last-cell now
            in let d = __heap-restore mark
            in 1
          end
        end
      end
      else if sc == 0 then
        if now == peek-32 ks dk-clkp-last-cell then
          let d = __heap-restore mark
          in 1
        else act
          p <- desk-clock-repaint base w h stride font tf cs mouse ks ds
          let u = poke-32 ks dk-clkp-last-cell now
          in let d = __heap-restore mark
          in 1
        end
      else act
        let a = clk-key ks sc
        in if a == 3 then let d = __heap-restore mark in 0
        else if a == 2 then act
          l <- clk-load ks
          p <- desk-clock-repaint base w h stride font tf cs mouse ks ds
          let u = poke-32 ks dk-clkp-last-cell now
          in let d = __heap-restore mark
          in 1
        end
        else if a == 5 then act
          z <- zone2-save (clk-record ks (2000 + peek-32 ks clk-y-cell) (peek-32 ks clk-mo-cell) (peek-32 ks clk-d-cell) (peek-32 ks clk-h-cell))
          p <- desk-clock-repaint base w h stride font tf cs mouse ks ds
          let u = poke-32 ks dk-clkp-last-cell now
          in let d = __heap-restore mark
          in 1
        end
        else if a == 4 then act
          c <- clk-commit ks
          z <- zone-save (clk-zone ks)
          let e = poke-32 ks clk-editing-cell 0
          in act
            p <- desk-clock-repaint base w h stride font tf cs mouse ks ds
            let u = poke-32 ks dk-clkp-last-cell now
            in let d = __heap-restore mark
            in 1
          end
        end
        else if a == 1 then act
          p <- desk-clock-repaint base w h stride font tf cs mouse ks ds
          let u = poke-32 ks dk-clkp-last-cell now
          in let d = __heap-restore mark
          in 1
        end
        else
          let d = __heap-restore mark
          in 1
      end
    end
  end

  desk-clock-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-clock-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ks) (apps) (root) = act
    hd <- cursor-hide cs base stride
    e <- clk-ensure ks
    e2 <- clk-ensure2 ks
    let o = desk-wnd-open desk-focus-clkp w h ds
    in act
      p0 <- desk-clock-paint base w h stride font tf ks ds
      c1 <- act dk-cursor base w h stride cs mouse end
      let u = poke-32 ks dk-clkp-last-cell (0 - 1)
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Programs

  desk-text-w : GopFont, Integer, Text -> Integer
  desk-text-w (tf) (ws) (t) =
    if tf.gf-ok then gfont-text-w tf t else text-length t * comp-cell-w * ws

  desk-icon-in : Integer, Integer, Integer, WidgetNode, Theme, Integer, GopFont, Text, Text, Text, Integer -> Integer
  desk-icon-in (base) (stride) (rows) (n) (th) (ws) (tf) (prefix) (gutter) (name) (ds) =
    let st = widget-resolve-style n th
    in let c = comp-mul-rect (box-content-from-style (n.wn-bounds) st) ws
    in let room = math-min (desk-text-w tf ws gutter) (c.lr-h)
    in let avail = room
    in let scale = if avail < 8 then 1 else avail / 8
    in let sh = 8 * scale
    in let ih = dk-icon-px avail
    in let sy = c.lr-y + (if c.lr-h > sh then (c.lr-h - sh) / 2 else 0)
    in let iy = c.lr-y + (if c.lr-h > ih then (c.lr-h - ih) / 2 else 0)
    in let ix = c.lr-x + desk-text-w tf ws prefix
    in let blk = peek-32 ds dk-icons-cell
    in if blk == 0 then gicon-blit base stride rows (gicon-named name) ix sy scale (st.ws-fg)
    else if gicon-drawn name == False then gicon-blit base stride rows (gicon-named name) ix sy scale (st.ws-fg)
    else if dk-icons-size blk /= ih then gicon-blit base stride rows (gicon-named name) ix sy scale (st.ws-fg)
    else gicon-blit-cov base stride rows (dk-icons-at blk name) ih ix iy (st.ws-fg)

  desk-icon-on : Integer, Integer, Integer, WidgetNode, Theme, Integer, GopFont, Text, Text, Text, Text, Integer -> Integer
  desk-icon-on (base) (stride) (rows) (laid) (th) (ws) (tf) (prefix) (gutter) (id) (name) (ds) =
    when widget-find laid id
      is Just (n) -> desk-icon-in base stride rows n th ws tf prefix gutter name ds
      is None -> 0

  desk-gpr-icons : Integer, Integer, Integer, WidgetNode, Theme, Integer, GopFont, List GprEntry, Integer, Integer, Integer, Integer -> Integer
  desk-gpr-icons (base) (stride) (rows) (laid) (th) (ws) (tf) (es) (n) (sel) (i) (ds) =
    if i >= n then 0
    else let e = list-at es i
    in let d = desk-icon-on base stride rows laid th ws tf (gpr-mark i sel) (gpr-gutter) ("gpr-" & e.ge-label) (e.ge-icon) ds
    in desk-gpr-icons base stride rows laid th ws tf es n sel (i + 1) ds

  desk-programs-draw : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-programs-draw (base) (w) (h) (stride) (font) (tf) (ps) (ds) =
    desk-wnd-paint-all base w h stride font tf ds

  desk-programs-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer -> [Device.Port] Integer
  desk-programs-paint (base) (w) (h) (stride) (font) (tf) (ps) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-programs-draw base w h stride font tf ps ds
  end

  desk-programs-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-programs-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ps) (ds) = act
    hd <- act cursor-hide cs base stride end
    p <- desk-programs-draw base w h stride font tf ps ds
    dk-cursor base w h stride cs mouse
  end

  dk-prog-hit : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> Integer
  dk-prog-hit (w) (h) (ps) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let blk = peek-32 ds desk-prog-cell
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let laid = widget-layout (gpr-tree ps) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let code = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
          is Just (wgt) -> gpr-id-scan (wgt.wn-id) 0
          is None -> 0
    in let dropped = __heap-restore probe
    in code

  desk-prog-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-prog-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-prog sc clicked
    let ps = peek-32 ds desk-prog-cell
    in let hit = if clicked & ev == desk-wnd-ev-pass then dk-prog-hit w h ps (mouse-x mouse) (mouse-y mouse) ds tf else 0
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if hit /= 0 then hit
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if sc == 0 then 1
    else
      act
        let mark = __heap-save
        in act
          p <- desk-programs-repaint base w h stride font tf cs mouse ps ds
          let d = __heap-restore mark
          in 1
        end
      end
  end

  desk-menu-w : Integer = 120

  desk-menu-body : Integer, Boolean -> WidgetNode
  desk-menu-body (ps) (across) =
    let b0 = widget-button "shutdown" (desk-chrome-gutter & "Shutdown")
    in let bye = widget-set-min-h b0 22
    in let foot = if across then widget-panel "sysmenu-foot" DirRow 0 [widget-set-flex bye 0, widget-set-flex (widget-panel "sysmenu-fgap" DirColumn 0 []) 1] else bye
    in widget-panel "sysmenu-body" DirColumn 4 [widget-set-flex (gpr-menu-tree ps across) 0, foot]

  desk-menu-tree : Integer, GopFont, Integer, Integer -> WidgetNode
  desk-menu-tree (ps) (tf) (s) (ds) =
    let across = dk-task-vertical ds
    in let body = widget-set-flex (comp-fit-text (desk-menu-body ps across) tf s) 0
    in let gap = widget-set-flex (widget-label "sysmenu-tgap" "") 1
    in let stack = if dk-task-edge ds == dk-edge-bottom then [gap, body] else [body, gap]
    in let col = widget-set-flex (widget-set-min (widget-panel "sysmenu-col" DirColumn 0 stack) desk-menu-w 0) 0
    in let rgap = widget-set-flex (widget-panel "sysmenu-rgap" DirColumn 0 []) 1
    in widget-panel "sysmenu-root" DirRow 0 (if dk-task-edge ds == dk-edge-right then [rgap, col] else [col, rgap])

  dk-menu-laid : Integer, Integer, Integer, Integer, GopFont -> WidgetNode
  dk-menu-laid (w) (h) (ps) (ds) (tf) =
    let s = ui-wscale w
    in widget-layout (desk-chrome-face (desk-menu-tree ps tf s ds) w ds tf) (dk-theme-ds ds) (layout-rect 0 0 (w / s) (h / s))

  desk-menu-over : Integer, Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Integer, Integer -> Integer
  desk-menu-over (base) (w) (stride) (rows) (font) (tf) (laid) (ps) (ds) =
    when widget-find laid "sysmenu-body"
      is None -> 0
      is Just (mb) ->
        let ws = ui-wscale w
        in let r = comp-walk base stride rows (comp-mul-rect (mb.wn-bounds) ws) font tf mb (dk-theme-ds ds) ws
        in let ic = desk-gpr-icons base stride rows laid (dk-theme-ds ds) ws tf gpr-entries gpr-count (gpr-sel ps) 0 ds
        in desk-icon-on base stride rows laid (dk-theme-ds ds) ws tf "" desk-chrome-gutter "shutdown" "power" ds

  desk-wnd-content : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, UsbMouse, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  desk-wnd-content (base) (w) (h) (stride) (font) (tf) (ds) (cs) (mouse) (apps) =
    let fid = dk-wr-visible (peek-32 ds dk-wr-cell) ds
    in let ms = peek-32 ds desk-marks-cell
    in let live = desk-marks-find ms fid (desk-marks-depth ms - 1) >= 0
    in if fid == desk-focus-bro then (when apps.da-browser
      is Just (bp) ->
        let box = dk-wnd-content desk-focus-bro w h ds tf (ui-wscale w)
        in gbr-show base (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) stride font tf (ui-scale w) bp
      is None -> 0)
    else if fid == desk-focus-scene & live then (when apps.da-scene
      is Just (sp) ->
        let pl = desk-scene-place sp base w h stride tf ds fid
        in gsc-show stride (apps.da-fonts) gsc-scene sp
      is None -> 0)
    else if fid == desk-focus-fish & live then (when apps.da-scene
      is Just (sp) ->
        let pl = desk-scene-place sp base w h stride tf ds fid
        in gsc-show stride (apps.da-fonts) gf-scene sp
      is None -> 0)
    else if fid == desk-focus-edit then (when apps.da-edit
      is Just (st) -> ged-reenter base (dk-wnd-content desk-focus-edit w h ds tf (ui-wscale w)) w h stride (apps.da-fonts) (dk-pal ds) mouse cs (peek-32 ds desk-edit-cell) st
      is None -> 0)
    else if fid == desk-focus-files then (when apps.da-files
      is Just (st) -> if st.fs-mode == 1 then 0 else gfl-paint-cur base (dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)) stride h (ui-scale w) (st.fs-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) (st.fs-sel) (st.fs-top) (st.fs-names)
      is None -> 0)
    else 0

  desk-menu-draw : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, Integer, UsbMouse, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  desk-menu-draw (base) (w) (h) (stride) (font) (tf) (ps) (ds) (cs) (mouse) (apps) = act
    p <- desk-wnd-paint-all base w h stride font tf ds
    q <- desk-wnd-content base w h stride font tf ds cs mouse apps
    desk-menu-over base w stride h font tf (dk-menu-laid w h ps ds tf) ps ds
  end

  desk-menu-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer, Integer, DeskApps -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  desk-menu-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ps) (ds) (apps) = act
    let hd = cursor-hide cs base stride
    in act
      p <- desk-menu-draw base w h stride font tf ps ds cs mouse apps
      dk-cursor base w h stride cs mouse
    end
  end

  dk-sc-bye : Integer = 65536

  dk-sc-group : Integer = 131072

  dk-sc-toggle : Integer = 262144

  desk-sc-shot : Integer = 88

  dk-menu-hit : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> Integer
  dk-menu-hit (w) (h) (ps) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let laid = dk-menu-laid w h ps ds tf
    in let code = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
          is Just (wgt) ->
            if wgt.wn-id == "shutdown" then dk-sc-bye
            else if wgt.wn-id == "menu" then dk-sc-toggle
            else
              let g = gpr-group-scan (wgt.wn-id) 0
              in if g /= 0 then dk-sc-group + g - 1 else gpr-id-scan (wgt.wn-id) 0
          is None -> 0
    in let dropped = __heap-restore probe
    in code

  dk-menu-out : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> Boolean
  dk-menu-out (w) (h) (ps) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let laid = dk-menu-laid w h ps ds tf
    in let v = when widget-find laid "sysmenu-body"
          is Just (n) ->
            let b = n.wn-bounds
            in let hx = comp-hit-x mx s
            in let hy = comp-hit-y my s
            in hx < b.lr-x | hx >= b.lr-x + b.lr-w | hy < b.lr-y | hy >= b.lr-y + b.lr-h
          is None -> True
    in let dropped = __heap-restore probe
    in v

  desk-menu-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer, Boolean -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  desk-menu-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (sc) (clicked) =
    let ps = peek-32 ds desk-prog-cell
    in let hit = if clicked then dk-menu-hit w h ps (mouse-x mouse) (mouse-y mouse) ds tf else 0
    in if hit == dk-sc-toggle then desk-step-dismiss
    else if sc == 1 then desk-step-dismiss
    else if hit >= dk-sc-group then act
      let g = gpr-set-sel ps (hit - dk-sc-group)
      in let mark = __heap-save
      in act
        p <- desk-menu-repaint base w h stride font tf cs mouse ps ds apps
        let d = __heap-restore mark
        in 1
      end
    end
    else if hit /= 0 then hit
    else if clicked & dk-menu-out w h ps (mouse-x mouse) (mouse-y mouse) ds tf then
      let r = mouse-put-click mouse
      in desk-step-dismiss
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if sc == 0 then 1
    else if sc == 28 then gpr-key ps sc
    else act
      let k = gpr-key ps sc
      in let mark = __heap-save
      in act
        p <- desk-menu-repaint base w h stride font tf cs mouse ps ds apps
        let d = __heap-restore mark
        in 1
      end
    end

  desk-menu-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-menu-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ps) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let e = gpr-ensure ps
    in act
      p0 <- desk-menu-draw base w h stride font tf ps ds cs mouse apps
      let sf = poke-32 ds desk-focus-cell desk-focus-menu
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

  desk-programs-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-programs-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ps) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let e = gpr-ensure ps
    in let o = desk-wnd-open desk-focus-prog w h ds
    in act
      p0 <- desk-programs-paint base w h stride font tf ps ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

  desk-calc-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-calc-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ks) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-calc w h ds
    in act
      p0 <- desk-calc-paint base w h stride font tf ks ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: The Web Server Pane

  desk-web-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-web-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-web w h ds
    in act
      p0 <- desk-wnd-paint-all base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

  dk-web-hit : Integer, Integer, Integer, Integer, Integer, Integer, GopFont -> Integer
  dk-web-hit (w) (h) (blk) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let laid = widget-layout (gopweb-tree blk) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let cmd = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
          is Just (wgt) -> if wgt.wn-id == "web-stop" then gopweb-cmd-stop else if wgt.wn-id == "web-start" then gopweb-cmd-start else 0
          is None -> 0
    in let d = __heap-restore probe
    in cmd

  desk-web-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, UsbMouse, Integer -> [Device.Port] Integer
  desk-web-repaint (base) (w) (h) (stride) (font) (tf) (cs) (mouse) (ds) = act
    hd <- act cursor-hide cs base stride end
    p <- desk-wnd-paint-all base w h stride font tf ds
    dk-cursor base w h stride cs mouse
  end

  dk-web-fresh : Integer, Integer -> Boolean
  dk-web-fresh (blk) (hit) =
    hit /= 0
    | peek-32 blk gopweb-blk-count /= peek-32 blk gopweb-blk-seen
    | peek-32 blk gopweb-blk-paused /= peek-32 blk gopweb-blk-shown

  desk-web-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-web-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-web sc clicked
    let blk = peek-32 ds dk-web-cell
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else
      let mark = __heap-save
      in let hit = if clicked then dk-web-hit w h blk (mouse-x mouse) (mouse-y mouse) ds tf else 0
      in let sent = if hit == 0 then 0 else poke-32 blk gopweb-blk-cmd hit
      in if dk-web-fresh blk hit == False then
        let d = __heap-restore mark
        in 1
      else
        let nt = if peek-32 blk gopweb-blk-count /= peek-32 blk gopweb-blk-seen then dk-snd-request ds dk-snd-slot-notify else 0
        in let sn = poke-32 blk gopweb-blk-seen (peek-32 blk gopweb-blk-count)
        in let sh = poke-32 blk gopweb-blk-shown (peek-32 blk gopweb-blk-paused)
        in act
          p <- desk-web-repaint base w h stride font tf cs mouse ds
          let d = __heap-restore mark
          in 1
        end
  end

Section: Calendar

  desk-cal-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-cal-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-sheet-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-sheet-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-sheet-body : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, SheetPane -> WidgetNode
  desk-sheet-body (base) (w) (h) (stride) (font) (tf) (ds) (sp) =
    let ws = ui-wscale w
    in let blk = desk-wnd-blk desk-focus-sheet ds
    in let st = dk-wnd-st blk
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds
    in let box = dk-wnd-content desk-focus-sheet w h ds tf ws
    in let fill = gop-fill-rect base stride h (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) ((dk-pal ds).pal-bg)
    in let laid = comp-render-at base stride h font tf (gsh-tree sp) (dk-theme-ds ds) (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) ws
    in let bd = dk-wnd-border base stride h wx wy ww wh ds w
    in laid

  desk-sheet-repaint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, DeskApps -> Integer
  desk-sheet-repaint (base) (w) (h) (stride) (font) (tf) (ds) (apps) =
    when apps.da-sheet
      is Just (sp) ->
        let mk = __heap-save
        in let laid = desk-sheet-body base w h stride font tf ds sp
        in let dr = __heap-restore mk
        in 1
      is None -> 0

  desk-sheet-hit : Integer, Integer, Integer, Integer, Integer, GopFont, SheetPane -> Integer
  desk-sheet-hit (w) (h) (mx) (my) (ds) (tf) (sp) =
    let s = ui-wscale w
    in let box = dk-wnd-content desk-focus-sheet w h ds tf s
    in let probe = __heap-save
    in let laid = widget-layout (gsh-tree sp) (dk-theme-ds ds) (layout-rect (box.lr-x / s) (box.lr-y / s) (box.lr-w / s) (box.lr-h / s))
    in let cell = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
      is Just (wgt) -> gsh-cell-at (wgt.wn-id) 0 0
      is None -> 0 - 1
    in let dropped = __heap-restore probe
    in cell

  dk-sheet-mods-cell : Integer = 0

  desk-sheet-key : DeskApps, Integer, Integer -> Integer
  desk-sheet-key (apps) (sc) (md) =
    when apps.da-sheet
      is Just (sp) ->
        if sc == 28 then
          if vw-len (sp.sp-buf) <= 0 then 0
          else let a = __record-set sp "sp-sheet" (gsh-commit sp)
          in let b = __record-set sp "sp-buf" ""
          in 1
        else if sc == 14 then
          if vw-len (sp.sp-buf) <= 0 then 0
          else let a = __record-set sp "sp-buf" (gsh-buf-back (sp.sp-buf))
          in 1
        else if sc >= 128 then 0
        else let ch = apply-mods (scancode-to-keycode sc) md
        in if ch >= 32 & ch < 127 then
          let a = __record-set sp "sp-buf" (gsh-buf-add (sp.sp-buf) ch)
          in 1
        else 0
      is None -> 0

  desk-sheet-take : DeskApps, Integer -> Integer
  desk-sheet-take (apps) (cell) =
    if cell < 0 then 0
    else when apps.da-sheet
      is Just (sp) ->
        let a = __record-set sp "sp-row" (cell / gsh-cols-shown)
        in let b = __record-set sp "sp-col" (cell - (cell / gsh-cols-shown) * gsh-cols-shown)
        in 1
      is None -> 0

  desk-sheet-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer, Boolean -> [Device.Port] Integer
  desk-sheet-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-sheet sc clicked
    let blk = peek-32 ds dk-sheet-cell
    in let md = gcon-shift-of (peek-32 blk dk-sheet-mods-cell) sc
    in let sm = poke-32 blk dk-sheet-mods-cell md
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then act
      let r = desk-sheet-repaint base w h stride font tf ds apps
      in 1
    end
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if clicked then act
      let cell = when apps.da-sheet
        is Just (sp) -> desk-sheet-hit w h (mouse-x mouse) (mouse-y mouse) ds tf sp
        is None -> 0 - 1
      in let took = desk-sheet-take apps cell
      in if took == 0 then 1
      else act
        hd <- cursor-hide cs base stride
        let r = desk-sheet-repaint base w h stride font tf ds apps
        in let c0 = dk-cursor base w h stride cs mouse
        in 1
      end
    end
    else if desk-sheet-key apps sc md == 0 then 1
    else act
      hd <- cursor-hide cs base stride
      let r = desk-sheet-repaint base w h stride font tf ds apps
      in let c0 = dk-cursor base w h stride cs mouse
      in 0 - 1
    end
  end

  desk-sheet-focus : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-sheet-focus (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    when apps.da-sheet
      is Just (sp) -> desk-sheet-reenter base w h stride font tf kbd mouse ds cs apps root sp
      is None -> desk-sheet-open base w h stride font tf kbd mouse ds cs apps root

  desk-sheet-reenter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, SheetPane -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-sheet-reenter (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (sp) =
    let o = desk-wnd-open desk-focus-sheet w h ds
    in let mk = __heap-save
    in act
      hd <- cursor-hide cs base stride
      p0 <- desk-sheet-paint base w h stride font tf ds
      let laid = desk-sheet-body base w h stride font tf ds sp
      in let dr = __heap-restore mk
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end

  desk-sheet-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-sheet-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let ke = desk-browser-evict ds
    in let mp = desk-marks-push (peek-32 ds desk-marks-cell) desk-focus-sheet __heap-save
    in let sp = gsh-pane-new (peek-32 ds dk-sheet-cell)
    in let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = apps.da-files, da-browser = None, da-scene = apps.da-scene, da-edit = apps.da-edit, da-sheet = Just sp, da-review = apps.da-review }
    in let o = desk-wnd-open desk-focus-sheet w h ds
    in act
      p0 <- desk-sheet-paint base w h stride font tf ds
      let mk = __heap-save
      in let laid = desk-sheet-body base w h stride font tf ds sp
      in let dr = __heap-restore mk
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
    end
  end

  desk-cal-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-cal-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-cal w h ds
    in act
      p0 <- desk-cal-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Issues

  desk-trk-win-box : Integer, Integer, DbServer, Integer, Integer, Integer, GopFont -> LayoutRect
  desk-trk-win-box (w) (h) (srv) (filter) (sel) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let blk = peek-32 ds dk-trk-cell
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let measured = widget-layout (gtk-tree srv filter sel (0 - 1) 0) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let bw = when widget-find measured "issues"
      is Just (n) -> (n.wn-bounds).lr-w
      is None -> 0
    in let bxh = when widget-find measured "issues"
      is Just (n) -> (n.wn-bounds).lr-h
      is None -> 0
    in let dropped = __heap-restore probe
    in layout-rect 0 0 bw bxh

  desk-trk-hit : Integer, Integer, Integer, Integer, Integer, DbServer, Integer, Integer, GopFont -> Integer
  desk-trk-hit (w) (h) (mx) (my) (ds) (srv) (filter) (sel) (tf) =
    let box = desk-trk-win-box w h srv filter sel ds tf
    in let probe = __heap-save
    in let s = ui-wscale w
    in let blk = peek-32 ds dk-trk-cell
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let laid = widget-layout (gtk-tree srv filter sel (box.lr-h) (box.lr-w)) (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let row = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
      is Just (wgt) -> gtk-row-at srv filter sel (box.lr-h) (box.lr-w) (wgt.wn-id)
      is None -> 0 - 1
    in let dropped = __heap-restore probe
    in row

  desk-trk-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-trk-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-trk-rows : DbServer, Integer -> Integer
  desk-trk-rows (srv) (filter) =
    let r = tk-db-all-issues srv
    in list-length (gtk-rows-from-db (r.qr-rows) filter 0 (r.qr-count) [])

  desk-trk-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-trk-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-trk sc clicked
    let pass = clicked & ev == desk-wnd-ev-pass
    in if ev == desk-wnd-ev-close then act 0 end
    else if ev == desk-wnd-ev-min then act desk-step-hide end
    else if ev == desk-wnd-ev-stay then act 1 end
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if (sc /= 0) | pass then act
      let mark = __heap-save
      in let srv = tk-init-tracker-db
      in let filter = peek-32 ds 32
      in let sel = peek-32 ds 40
      in let n = desk-trk-rows srv filter
      in let hi = if n > 0 then n - 1 else 0
      in let nf = if sc == 33 then int-mod (filter + 1) 3 else filter
      in let ns0 = if sc == 72 then (if sel > 0 then sel - 1 else 0) else sel
      in let ns1 = if sc == 80 then (if ns0 < hi then ns0 + 1 else hi) else ns0
      in let ns2 = if sc == 33 then 0 else ns1
      in let hit-row = if pass then desk-trk-hit w h (mouse-x mouse) (mouse-y mouse) ds srv filter sel tf else 0 - 1
      in let ns = if hit-row >= 0 then hit-row else ns2
      in if nf == filter & ns == sel then act
        let d = __heap-restore mark
        in 1
      end
      else act
        let f1 = poke-32 ds 32 nf
        in let s1 = poke-32 ds 40 ns
        in let hd = cursor-hide cs base stride
        in act
          p <- desk-trk-paint base w h stride font tf ds
          let c = dk-cursor base w h stride cs mouse
          in let d = __heap-restore mark
          in 1
        end
      end
    end
    else act 1 end
  end

  desk-trk-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-trk-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-trk w h ds
    in act
      p0 <- desk-trk-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Review

  desk-content-h : Integer, Integer, Integer -> Integer
  desk-content-h (w) (h) (ds) =
    h / ui-wscale w - dk-bar-h * ui-scale w / ui-wscale w - dk-task-px ds w / ui-wscale w

  desk-rev-box : Integer, Integer, GrvData, Integer, Maybe Text, Integer, GopFont -> LayoutRect
  desk-rev-box (w) (h) (data) (rs) (signer) (ds) (tf) =
    let probe = __heap-save
    in let s = ui-wscale w
    in let measured = widget-layout (desk-chrome-face (grv-tree data rs signer (desk-content-h w h ds) (0 - 1) 0) w ds tf) (dk-theme-ds ds) (layout-rect 0 0 (w / s) (h / s))
    in let bw = when widget-find measured "grv-body-0"
      is Just (n) -> (n.wn-bounds).lr-w
      is None -> 0 - 1
    in let sh = when widget-find measured "grv-fill"
      is Just (n) -> (n.wn-bounds).lr-h
      is None -> 0
    in let dropped = __heap-restore probe
    in layout-rect 0 0 bw sh

  desk-rev-draw : Integer, Integer, Integer, Integer, CbfFont, GopFont, GrvData, Integer, Integer, Maybe Text -> Integer
  desk-rev-draw (base) (w) (h) (stride) (font) (tf) (data) (rs) (ds) (signer) =
    let box = if grv-in-detail rs then desk-rev-box w h data rs signer ds tf else layout-rect-zero
    in let view = if box.lr-h <= 0 then 1 else 1 + (box.lr-h) / grv-row-h
    in let tree = grv-tree data rs signer (desk-content-h w h ds) (box.lr-w) (if grv-in-detail rs then view else 0)
    in let laid = dk-chrome-paint base w h stride font tf tree ds
    in desk-topbar base w stride font (ui-scale w) tf h ds

  desk-rev-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, GrvData, Integer, Integer, Maybe Text -> Integer
  desk-rev-paint (base) (w) (h) (stride) (font) (tf) (data) (rs) (ds) (signer) =
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-rev-draw base w h stride font tf data rs ds signer

  desk-rev-stamp : Integer -> [Device.Port] Integer
  desk-rev-stamp (dummy) = act
    yy <- rtc-read 9
    mm <- rtc-read 8
    dd <- rtc-read 7
    hh <- rtc-read 4
    mi <- rtc-read 2
    ss <- rtc-read 0
    let day = ((2000 + dk-bcd yy) * 100 + dk-bcd mm) * 100 + dk-bcd dd
    in (day * 100 + dk-bcd hh) * 10000 + dk-bcd mi * 100 + dk-bcd ss
  end

  desk-rev-data : DeskApps -> [Device.Port] GrvData
  desk-rev-data (apps) = act
    when apps.da-review
      is Just (d) -> d
      is None -> grv-load 0
  end

  desk-rev-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer -> [Device.Port, Identity] Integer
  desk-rev-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (sc) =
    if sc == 0 then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else act
      let rs = peek-32 ds desk-review-cell
      in let md = grv-shift-of (peek-32 rs grv-mods-cell) sc
      in let sm = poke-32 rs grv-mods-cell md
      in act
       data <- desk-rev-data apps
       let mark = __heap-save
       in act
        signer0 <- loaded-fingerprint
        let can = when signer0
          is None -> 0
          is Just (fp) -> 1
        in let r0 = grv-key rs sc (grv-count data) md can
        in act
         cast <- if r0 == 6 then act
             ts <- desk-rev-stamp 0
             grv-supersede data rs ts
           end else if r0 >= 3 then act
             ts <- desk-rev-stamp 0
             grv-cast data rs r0 ts
           end else 0
         let r = if r0 >= 3 then 1 else r0
         in if r == 2 then
           let m = grv-set-mode rs grv-mode-list
           in let s = grv-set-sel rs 0 1
           in let d = __heap-restore mark
           in 0
         else if r == 0 then
           let d = __heap-restore mark
           in 1
         else if cast == 1 then act
           data2 <- grv-load 0
           let keep = __record-set apps "da-review" (Just data2)
           in let hd = cursor-hide cs base stride
           in let p = desk-rev-paint base w h stride font tf data2 rs ds signer0
           in let c = dk-cursor base w h stride cs mouse
           in 0 - 1
         end
         else act
           let hd = cursor-hide cs base stride
           in let p = desk-rev-paint base w h stride font tf data rs ds signer0
           in let c = dk-cursor base w h stride cs mouse
           in let d = __heap-restore mark
           in 1
         end
        end
       end
      end
    end

  desk-rev-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-rev-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    signer <- loaded-fingerprint
    data <- grv-load 0
    let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = apps.da-files, da-browser = apps.da-browser, da-scene = apps.da-scene, da-edit = apps.da-edit, da-sheet = apps.da-sheet, da-review = Just data }
    in let mark = __heap-save
    in let rs = peek-32 ds desk-review-cell
    in act
     let s0 = grv-set-sel rs (grv-sel rs) (grv-count data)
     in let p0 = desk-rev-paint base w h stride font tf data rs ds signer
     in let d = __heap-restore mark
     in let sf = poke-32 ds desk-focus-cell desk-focus-rev
     in let c1 = dk-cursor base w h stride cs mouse
     in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
    end
  end

Section: Diffusion

  desk-dif-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-dif-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-dif-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-dif-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-dif w h ds
    in act
      p0 <- desk-dif-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Appearance Pane

  dk-edge-name : Integer -> Text
  dk-edge-name (e) =
    if e == dk-edge-top then "top"
    else if e == dk-edge-left then "left"
    else if e == dk-edge-right then "right"
    else "bottom"

  dk-style-tree : Integer, Integer, Integer, Integer -> WidgetNode
  dk-style-tree (scheme) (f) (snd) (edge) =
    widget-panel "style" DirColumn 4 [widget-label "style-title" "APPEARANCE", widget-button "style-scheme" ("Colour scheme: " & dk-scheme-name scheme), widget-button "style-border" ("Borders: " & dk-on-off f dk-adorn-border), widget-button "style-grad" ("Gradients: " & dk-on-off f dk-adorn-gradient), widget-button "style-shadow" ("Shadows: " & dk-on-off f dk-adorn-shadow), widget-button "style-round" ("Rounded corners: " & dk-on-off f dk-adorn-round), widget-button "style-sound" ("Sounds: " & dk-sound-name snd), widget-button "style-edge" ("Task frame: " & dk-edge-name edge), widget-label "style-hint" "Click a row, or space b g s r a e.", widget-set-flex (widget-label "style-spacer" "") 1]

  dk-sound-name : Integer -> Text
  dk-sound-name (v) = if v == 0 then "off" else "on"

  dk-style-id-code : Text -> Integer
  dk-style-id-code (id) =
    if id == "style-scheme" then 1
    else if id == "style-border" then 2
    else if id == "style-grad" then 3
    else if id == "style-shadow" then 4
    else if id == "style-round" then 5
    else if id == "style-sound" then 6
    else if id == "style-edge" then 7
    else 0

  dk-style-key : Integer -> Integer
  dk-style-key (sc) =
    if sc == 57 then 1
    else if sc == 48 then 2
    else if sc == 34 then 3
    else if sc == 31 then 4
    else if sc == 19 then 5
    else if sc == 30 then 6
    else if sc == 18 then 7
    else 0

  dk-style-hit : Integer, Integer, Integer, Integer, Integer, GopFont -> Integer
  dk-style-hit (w) (h) (mx) (my) (ds) (tf) =
    let probe = __heap-save
    in let tree = dk-style-tree (peek-32 ds dk-scheme-cell) (peek-32 ds dk-adorn-cell) (peek-32 ds dk-sound-on-cell) (dk-task-edge ds)
    in let s = ui-wscale w
    in let blk = peek-32 ds dk-sty-cell
    in let st = dk-wnd-st blk
    in let bh = dk-wnd-bar-h tf s
    in let wx = dk-wnd-rx blk w st ds
    in let wy = dk-wnd-ry blk w h st ds + bh
    in let ww = dk-wnd-rw blk w st ds
    in let wh = dk-wnd-rh blk w h st ds - bh
    in let laid = widget-layout tree (dk-theme-ds ds) (layout-rect (wx / s) (wy / s) (ww / s) (wh / s))
    in let code = when ev-hit-widget laid (comp-hit-x mx s) (comp-hit-y my s)
          is Just (wgt) -> dk-style-id-code (wgt.wn-id)
          is None -> 0
    in let dropped = __heap-restore probe
    in code

  dk-sc-style : Integer = 30

  dk-style-flip : Integer, Integer -> Integer
  dk-style-flip (ds) (bit) = poke-32 ds dk-adorn-cell (dk-adorn-flip (peek-32 ds dk-adorn-cell) bit)

  dk-style-apply : Integer, Integer -> Integer
  dk-style-apply (ds) (code) =
    if code == 1 then poke-32 ds dk-scheme-cell (int-mod (peek-32 ds dk-scheme-cell + 1) dk-scheme-count)
    else if code == 2 then dk-style-flip ds dk-adorn-border
    else if code == 3 then dk-style-flip ds dk-adorn-gradient
    else if code == 4 then dk-style-flip ds dk-adorn-shadow
    else if code == 5 then dk-style-flip ds dk-adorn-round
    else if code == 6 then poke-32 ds dk-sound-on-cell (1 - peek-32 ds dk-sound-on-cell)
    else if code == 7 then poke-32 ds dk-task-edge-cell (int-mod (dk-task-edge ds + 1) 4)
    else 0

  desk-style-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-style-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let bg = gop-fill-rect base stride h 0 0 w h (dk-wall ds)
    in desk-wnd-paint-all base w h stride font tf ds
  end

  desk-style-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer, Boolean -> [Device.Port] Integer
  desk-style-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (sc) (clicked) = act
    ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-style sc clicked
    let click = if clicked & ev == desk-wnd-ev-pass then dk-style-hit w h (mouse-x mouse) (mouse-y mouse) ds tf else 0
    in let code = if click /= 0 then click else dk-style-key sc
    in if ev == desk-wnd-ev-close then 0
    else if ev == desk-wnd-ev-min then desk-step-hide
    else if ev == desk-wnd-ev-stay then 1
    else if sc == 88 then act
      let mark = __heap-save
      in act
        s <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if code == 0 then 1
    else act
      let mark = __heap-save
      in let a = dk-style-apply ds code
      in let rt = if code == 7 then dk-task-init ds tf w else 0
      in let rf = if code == 7 then dk-wnd-refit w h ds 0 else 0
      in act
        sv <- dk-settings-save ds
        let hd = cursor-hide cs base stride
        in act
          p <- desk-style-paint base w h stride font tf ds
          let c = dk-cursor base w h stride cs mouse
          in let d = __heap-restore mark
          in if code == 7 then dk-sc-style else 1
        end
      end
    end
  end

  desk-style-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-style-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-style w h ds
    in act
      p0 <- desk-style-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end

Section: Loop

  desk-widget-hit : WidgetNode, Integer, Integer, Text, Integer -> Boolean
  desk-widget-hit (root) (mx) (my) (id) (s) =
    when ev-hit-widget root (comp-hit-x mx s) (comp-hit-y my s)
      is Just (wgt) -> wgt.wn-id == id
      is None -> False

  dk-cursor : Integer, Integer, Integer, Integer, Integer, UsbMouse -> Integer
  dk-cursor (base) (w) (h) (stride) (cs) (mouse) =
    if mouse.um-ok
    then cursor-update cs base stride h w h (ui-scale w) (mouse-x mouse) (mouse-y mouse)
    else 0

  dk-pump : Integer, Integer, Integer, Integer, Integer, UsbMouse -> Integer
  dk-pump (base) (w) (h) (stride) (cs) (mouse) =
    if mouse-pump mouse w h == 1
    then let c = dk-cursor base w h stride cs mouse in 1
    else 0

Section: The Editor

  desk-edit-drop : Integer, Integer, Integer -> Integer
  desk-edit-drop (eb) (tgt) (fid) =
    let p = peek-32 eb 0
    in if p /= 0 & (tgt <= p | fid == desk-focus-edit) then poke-32 eb 0 0 else 0

  desk-edit-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, DeskApps, Integer, Boolean -> [Identity, Device.Port] Integer
  desk-edit-step (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) (apps) (sc) (clicked) =
    when apps.da-edit
      is None -> act 0 end
      is Just (st) -> act
        ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-edit sc clicked
        if ev == desk-wnd-ev-close then act 0 end
        else if ev == desk-wnd-ev-min then act desk-step-hide end
        else if ev == desk-wnd-ev-stay then act
          p <- (ged-reenter base (dk-wnd-content desk-focus-edit w h ds tf (ui-wscale w)) w h stride (apps.da-fonts) (dk-pal ds) mouse cs (peek-32 ds desk-edit-cell) st)
          1
        end
        else act
          r <- ged-step base (dk-wnd-content desk-focus-edit w h ds tf (ui-wscale w)) w h stride (apps.da-fonts) (dk-pal ds) mouse cs (peek-32 ds desk-edit-cell) st sc clicked
          if r == ged-step-hide then desk-step-hide else r
        end
      end

  desk-edit-focus : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-edit-focus (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    when apps.da-edit
      is Just (st) -> desk-edit-reenter base w h stride font tf kbd mouse ds cs apps root st
      is None -> desk-edit-open base w h stride font tf kbd mouse ds cs apps root

  desk-edit-reenter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, EditState -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-edit-reenter (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (st) =
    let hd = cursor-hide cs base stride
    in let rc = desk-root-reclaim ds
    in let rm = __heap-save
    in let root2 = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let o = desk-wnd-open desk-focus-edit w h ds
    in let mk = __heap-save
    in act
      w0 <- desk-wall-paint base w h stride font tf ds
      p <- ged-reenter base (dk-wnd-content desk-focus-edit w h ds tf (ui-wscale w)) w h stride (apps.da-fonts) (dk-pal ds) mouse cs (peek-32 ds desk-edit-cell) st
      let dr = __heap-restore mk
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let inval = poke-32 ds desk-second-cell (0 - 1)
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root2
    end

  desk-edit-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-edit-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    let ke = desk-browser-evict ds
    in let mk0 = __heap-save
    in act
    start <- gpt-esp-start
    let r0 = __heap-restore mk0
    in let ms = peek-32 ds desk-marks-cell
    in let hole = desk-hole-enter ms __heap-save (peek-32 ds desk-root-cell) desk-edit-want
    in let b0 = __heap-save
    in let mp = if hole < 0 then desk-marks-push ms desk-focus-edit b0 else 0
    in act
    st <- ged-build start (peek-32 ds desk-edit-cell)
    let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = apps.da-files, da-browser = None, da-scene = apps.da-scene, da-edit = Just st, da-sheet = apps.da-sheet, da-review = apps.da-review }
    in let fill = if hole < 0 then desk-hole-pad b0 desk-edit-want else 0
    in let claimed = desk-hole-exit ms hole desk-focus-edit
    in let o = desk-wnd-open desk-focus-edit w h ds
    in act
    w0 <- desk-wall-paint base w h stride font tf ds
    let mk = __heap-save
    in act
    p <- ged-first-paint base (dk-wnd-content desk-focus-edit w h ds tf (ui-wscale w)) w h stride (ui-scale w) (apps.da-fonts) (dk-pal ds) mouse cs st
    let dr = __heap-restore mk
    in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
    in let inval = poke-32 ds desk-second-cell (0 - 1)
    in let c1 = dk-cursor base w h stride cs mouse
    in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
    end
    end
    end
    end
  end

  desk-edit-want : Integer = ged-init-bytes + 16384

  desk-hole-pad : Integer, Integer -> Integer
  desk-hole-pad (b0) (want) =
    let used = __heap-save - b0
    in if used < want then (let adv = __heap-advance (want - used) in want - used) else 0

Section: Files

  desk-files-focus : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-files-focus (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    when apps.da-files
      is Just (st) -> desk-files-reenter base w h stride font tf kbd mouse ds cs apps root st
      is None -> desk-files-open base w h stride font tf kbd mouse ds cs apps root

  desk-files-reenter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, FilesState -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-files-reenter (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (st) =
    let s = ui-scale w
    in let o = desk-wnd-open desk-focus-files w h ds
    in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
    in let mk = __heap-save
    in act
      hd <- cursor-hide cs base stride
      w0 <- desk-wall-paint base w h stride font tf ds
      d <- gfl-paint-cur base box stride h s (st.fs-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) (st.fs-sel) (st.fs-top) (st.fs-names)
      let dr = __heap-restore mk
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end

  desk-files-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-files-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    let ke = desk-browser-evict ds
    in let mk0 = __heap-save
    in act
    start <- gpt-esp-start
    let r0 = __heap-restore mk0
    in let ms = peek-32 ds desk-marks-cell
    in let hole = desk-hole-enter ms __heap-save (peek-32 ds desk-root-cell) desk-files-want
    in let mp = if hole < 0 then desk-marks-push ms desk-focus-files __heap-save else 0
    in act
    m <- desk-files-mount start
    st <- desk-files-build (apps.da-fonts) m
    let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = Just st, da-browser = None, da-scene = apps.da-scene, da-edit = apps.da-edit, da-sheet = apps.da-sheet, da-review = apps.da-review }
    in let claimed = desk-hole-exit ms hole desk-focus-files
    in act
    hd <- cursor-hide cs base stride
    let s = ui-scale w
    in let o = desk-wnd-open desk-focus-files w h ds
    in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
    in act
    w0 <- desk-wall-paint base w h stride font tf ds
    if m.gm-ok == False then act
      let se = dk-snd-request ds dk-snd-slot-error
      in act
      f <- gfl-draw-frame base box stride h s (apps.da-fonts) (dk-pal ds) ""
      t <- gapp-ui-text base stride h (apps.da-fonts) (box.lr-x + 10 * s) (box.lr-y + 26 * s) (shot-diag-text "no FAT ESP on the boot medium") (gfl-dim (dk-pal ds)) s 0
      t2 <- gapp-ui-text base stride h (apps.da-fonts) (box.lr-x + 10 * s) (box.lr-y + box.lr-h - 18 * s) "Esc back" (gfl-hint (dk-pal ds)) s 0
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
      end
    end
    else let mk = __heap-save
    in act
      d <- gfl-paint-cur base box stride h s (apps.da-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) 0 0 (st.fs-names)
      let dr = __heap-restore mk
      in let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let c1 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
    end
    end
    end
    end
  end

  desk-files-mount : Integer -> [Device.Port] GfatMount
  desk-files-mount (start) =
    if start == 0 then GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else gfat-mount-at start

  desk-files-root : Fat16Volume -> Integer
  desk-files-root (vol) = if gfat-is32 vol then vol.vol-root-start else 0 - 1

  desk-files-build : GopAppFont, GfatMount -> [Device.Port] FilesState
  desk-files-build (fonts) (m) = act
    let clusters = [desk-files-root (m.gm-vol)]
    in act
      n <- if m.gm-ok then gfl-count-cur (m.gm-vol) clusters else act 0 end
      FilesState { fs-fonts = fonts, fs-vol = m.gm-vol, fs-count = n, fs-clusters = clusters, fs-names = [], fs-sel = 0, fs-top = 0, fs-ptr = 0, fs-mode = 0 }
    end
  end

  desk-files-want : Integer = 8192

  desk-files-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer, Boolean -> [Device.Port] Integer
  desk-files-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (sc) (clicked) =
    when apps.da-files
      is None -> act 0 end
      is Just (st) -> act
        ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-files sc clicked
        if ev == desk-wnd-ev-close then act 0 end
        else if ev == desk-wnd-ev-min then act desk-step-hide end
        else if ev == desk-wnd-ev-stay then act
          let hd = cursor-hide cs base stride
          in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
          in if st.fs-mode == 1 then let c = dk-cursor base w h stride cs mouse in 1
          else act
            p <- gfl-paint-cur base box stride h (ui-scale w) (st.fs-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) (st.fs-sel) (st.fs-top) (st.fs-names)
            let c = dk-cursor base w h stride cs mouse
            in 1
          end
        end
        else desk-files-on base w h stride font tf kbd mouse ds cs st sc clicked
      end

  desk-files-moved : FilesState, UsbMouse -> Boolean
  desk-files-moved (st) (mouse) = st.fs-ptr /= (mouse-x mouse) * 4096 + (mouse-y mouse)

  desk-files-on : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, FilesState, Integer, Boolean -> [Device.Port] Integer
  desk-files-on (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (st) (sc) (clicked) =
    if st.fs-mode == 1 then desk-files-viewing base w h stride font tf mouse ds cs st sc clicked
    else desk-files-listing base w h stride font tf kbd mouse ds cs st sc clicked

  desk-files-viewing : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, FilesState, Integer, Boolean -> [Device.Port] Integer
  desk-files-viewing (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) (st) (sc) (clicked) =
    let s = ui-scale w
    in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
    in if sc == 88 then act
      let mark = __heap-save
      in act
        r <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if sc == 1 | sc == 28 then
      let a = __record-set st "fs-mode" 0
      in let b = __record-set st "fs-ptr" ((mouse-x mouse) * 4096 + (mouse-y mouse))
      in let hd = cursor-hide cs base stride
      in act
        p <- gfl-paint-cur base box stride h s (st.fs-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) (st.fs-sel) (st.fs-top) (st.fs-names)
        let c = dk-cursor base w h stride cs mouse
        in 1
      end
    else 1

  desk-files-listing : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, FilesState, Integer, Boolean -> [Device.Port] Integer
  desk-files-listing (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (st) (sc) (clicked) =
    let s = ui-scale w
    in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
    in let n = st.fs-count
    in let sel = st.fs-sel
    in let mv = desk-files-moved st mouse
    in let hover = if mv | clicked then gfl-row-at box s (st.fs-top) n (mouse-x mouse) (mouse-y mouse) else 0 - 1
    in let pk = __record-set st "fs-ptr" ((mouse-x mouse) * 4096 + (mouse-y mouse))
    in if sc == 88 then act
      let mark = __heap-save
      in act
        r <- desk-shot base w h stride font tf ds
        let d = __heap-restore mark
        in 1
      end
    end
    else if sc == 15 then desk-step-hide
    else if sc == 1 then
      if list-length (st.fs-clusters) <= 1 then 1
      else desk-files-up base w h stride font tf mouse cs st ds
    else if (sc == 28 & n > 0) | (clicked & hover >= 0) then
      desk-files-pick base w h stride font tf kbd mouse cs st (if clicked & hover >= 0 then hover else sel) ds
    else if sc == 72 & sel > 0 then desk-files-move base w h stride font tf mouse cs st (sel - 1) ds
    else if sc == 80 & sel < n - 1 then desk-files-move base w h stride font tf mouse cs st (sel + 1) ds
    else if hover >= 0 & hover /= sel then desk-files-move base w h stride font tf mouse cs st hover ds
    else 1

  desk-files-move : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, FilesState, Integer, Integer -> [Device.Port] Integer
  desk-files-move (base) (w) (h) (stride) (font) (tf) (mouse) (cs) (st) (ns) (ds) =
    let s = ui-scale w
    in let box = dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)
    in let t2 = gfl-clamp-top ns (st.fs-top) (gfl-rows-vis box s)
    in let a = __record-set st "fs-sel" ns
    in let b = __record-set st "fs-top" t2
    in let hd = cursor-hide cs base stride
    in act
      p <- gfl-paint-cur base box stride h s (st.fs-fonts) (dk-pal ds) (st.fs-vol) (st.fs-clusters) (st.fs-count) ns t2 (st.fs-names)
      let c = dk-cursor base w h stride cs mouse
      in 1
    end

  desk-files-pick : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, FilesState, Integer, Integer -> [Device.Port] Integer
  desk-files-pick (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (cs) (st) (idx) (ds) = act
    win <- gfl-window-cur (st.fs-vol) (st.fs-clusters) idx 1
    if list-length win == 0 then 1
    else let e = list-at win 0
    in if gfl-is-dir e then desk-files-enter base w h stride font tf mouse cs st e ds
    else act
      p <- gfl-preview-paint base (dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)) stride h (ui-scale w) (st.fs-fonts) (dk-pal ds) cs (st.fs-vol) e
      let a = __record-set st "fs-sel" idx
      in let b = __record-set st "fs-top" (gfl-clamp-top idx (st.fs-top) (gfl-rows-vis (dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)) (ui-scale w)))
      in let m = __record-set st "fs-mode" 1
      in let c = dk-cursor base w h stride cs mouse
      in 1
    end
  end

  desk-files-enter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, FilesState, Fat16DirEntry, Integer -> [Device.Port] Integer
  desk-files-enter (base) (w) (h) (stride) (font) (tf) (mouse) (cs) (st) (e) (ds) = act
    let c2 = list-push (st.fs-clusters) (e.de-cluster)
    in let n2 = list-push (st.fs-names) (e.de-name)
    in act
      n <- gfl-count-cur (st.fs-vol) c2
      desk-files-land base w h stride font tf mouse cs st n c2 n2 ds
    end
  end

  desk-files-up :Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, FilesState, Integer -> [Device.Port] Integer
  desk-files-up (base) (w) (h) (stride) (font) (tf) (mouse) (cs) (st) (ds) = act
    let c2 = gfl-pop-int (st.fs-clusters)
    in let n2 = gfl-pop-text (st.fs-names)
    in act
      n <- gfl-count-cur (st.fs-vol) c2
      desk-files-land base w h stride font tf mouse cs st n c2 n2 ds
    end
  end

  desk-files-land : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, FilesState, Integer, List Integer, List Text, Integer -> [Device.Port] Integer
  desk-files-land (base) (w) (h) (stride) (font) (tf) (mouse) (cs) (st) (n) (c2) (n2) (ds) =
    let a = __record-set st "fs-clusters" c2
    in let b = __record-set st "fs-names" n2
    in let c = __record-set st "fs-count" n
    in let d = __record-set st "fs-sel" 0
    in let f = __record-set st "fs-top" 0
    in let hd = cursor-hide cs base stride
    in let mk = __heap-save
    in act
      p <- gfl-paint-cur base (dk-wnd-content desk-focus-files w h ds tf (ui-wscale w)) stride h (ui-scale w) (st.fs-fonts) (dk-pal ds) (st.fs-vol) c2 n 0 0 n2
      let r = __heap-restore mk
      in let cu = dk-cursor base w h stride cs mouse
      in 0 - 1
    end

Section: The 3D panes

  desk-scene-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, (Integer -> Scene3DState), Integer, Integer, Boolean -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-scene-step (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (build) (foc) (sc) (clicked) =
    when apps.da-scene
      is None -> act 0 end
      is Just (sp) -> act
        ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs foc sc clicked
        if ev == desk-wnd-ev-close then act
          v <- (gs-viewport-release)
          0
        end
        else if ev == desk-wnd-ev-min then act
          v <- (gs-viewport-release)
          desk-step-hide
        end
        else if ev == desk-wnd-ev-stay then act 1 end
        else act
          let pl = desk-scene-place sp base w h stride tf ds foc
          in act
            r <- gsc-step base w h stride (apps.da-fonts) kbd mouse cs build sp sc (dk-task-px ds w)
            if r == gsc-step-hide then desk-step-hide else r
          end
        end
      end

  desk-scene-place : ScenePane, Integer, Integer, Integer, Integer, GopFont, Integer, Integer -> Integer
  desk-scene-place (sp) (base) (w) (h) (stride) (tf) (ds) (foc) =
    let blk = desk-wnd-blk foc ds
    in let s = ui-wscale w
    in let bh = dk-wnd-bar-h tf s
    in let st = dk-wnd-st blk
    in gsc-place sp base stride (dk-wnd-rx blk w st ds + s) (dk-wnd-ry blk w h st ds + bh) (dk-wnd-rw blk w st ds - 2 * s) (dk-wnd-rh blk w h st ds - bh - s)

  desk-scene-sibling : Integer -> Integer
  desk-scene-sibling (foc) = if foc == desk-focus-scene then desk-focus-fish else desk-focus-scene

  desk-scene-focus : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-scene-focus (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (sky) (foc) =
    let ms = peek-32 ds desk-marks-cell
    in let live = desk-marks-find ms foc (desk-marks-depth ms - 1) >= 0
    in if live then desk-scene-reenter base w h stride font tf kbd mouse ds cs apps root foc
    else desk-scene-open base w h stride font tf kbd mouse ds cs apps root sky foc

  desk-scene-reenter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-scene-reenter (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (foc) = act
    let hd = cursor-hide cs base stride
    in let rc = desk-root-reclaim ds
    in let rm = __heap-save
    in let root2 = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in let o = desk-wnd-open foc w h ds
    in act
      p0 <- desk-wall-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let inval = poke-32 ds desk-second-cell (0 - 1)
      in desk-loop base w h stride font tf kbd mouse ds cs apps root2
    end
  end

  desk-scene-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-scene-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (sky) (foc) =
    let ms = peek-32 ds desk-marks-cell
    in let ko = desk-marks-kill ms (desk-scene-sibling foc)
    in let ke = desk-browser-evict ds
    in let bw = dk-cbox-w w ds
    in let bh = dk-cbox-h w h ds
    in let hole = desk-hole-enter ms __heap-save (peek-32 ds desk-root-cell) (desk-scene-want bw bh)
    in let mp = if hole < 0 then desk-marks-push ms foc __heap-save else 0
    in act
    sp <- gsc-new base stride cs (dk-gpu ds) sky bw bh
    let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = apps.da-files, da-browser = None, da-scene = Just sp, da-edit = apps.da-edit, da-sheet = apps.da-sheet, da-review = apps.da-review }
    in let claimed = desk-hole-exit ms hole foc
    in let o = desk-wnd-open foc w h ds
    in act
      p0 <- desk-wall-paint base w h stride font tf ds
      let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
      in let inval = poke-32 ds desk-second-cell (0 - 1)
      in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
    end
  end

  desk-wall-paint : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-wall-paint (base) (w) (h) (stride) (font) (tf) (ds) = act
    let mark = __heap-save
    in act
      bg <- act gop-fill-rect base stride h 0 0 w h (dk-wall ds) end
      p <- desk-wnd-paint-all base w h stride font tf ds
      let d = __heap-restore mark
      in 0
    end
  end


  desk-shot : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer -> [Device.Port] Integer
  desk-shot (base) (w) (h) (stride) (font) (tf) (ds) = act
    let mark = __heap-save
    in act
      t <- shot-take base w h stride
      let n = dk-notice-set ds t
      in let d = __heap-restore mark
      in 0
    end
  end

  desk-snap : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-snap (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    r <- desk-shot base w h stride font tf ds
    desk-loop base w h stride font tf kbd mouse ds cs apps root
  end

  desk-shutdown : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-shutdown (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    r <- acpi-poweroff (acpi-boot 0)
    let s = dk-win-s w h tf ds
    in let m = desk-line base stride h font s tf (dk-win-x w s ds + 10 * s) (dk-win-y w h s tf ds + (dk-win-h tf s - 24) * s) "firmware declined the power transition" ((dk-pal ds).pal-error)
    in desk-loop base w h stride font tf kbd mouse ds cs apps root
  end

Section: Browser



  desk-browser-evict : Integer -> Integer
  desk-browser-evict (ds) = desk-marks-kill (peek-32 ds desk-marks-cell) desk-focus-bro

  desk-browser-focus : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-browser-focus (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    when apps.da-browser
      is Just (bp) -> desk-browser-reenter base w h stride font tf kbd mouse ds cs apps root bp
      is None -> desk-browser-open base w h stride font tf kbd mouse ds cs apps root

  desk-browser-reenter : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, BrowserPane -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-browser-reenter (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (bp) = act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-bro w h ds
    in let rm = desk-marks-remark (peek-32 ds desk-marks-cell) desk-focus-bro __heap-save
    in act
      c0 <- desk-wall-paint base w h stride font tf ds
      let box = dk-wnd-content desk-focus-bro w h ds tf (ui-wscale w)
      in act
        p <- gbr-first-paint base (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) stride font tf mouse cs (ui-scale w) bp
        let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
        in let inval = poke-32 ds desk-second-cell (0 - 1)
        in let c1 = dk-cursor base w h stride cs mouse
        in desk-loop base w h stride font tf kbd mouse ds cs apps root
      end
    end
  end

  desk-browser-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-browser-open (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) =
    let mp = desk-marks-push (peek-32 ds desk-marks-cell) desk-focus-bro __heap-save
    in act
    hd <- cursor-hide cs base stride
    let o = desk-wnd-open desk-focus-bro w h ds
    in let box0 = dk-wnd-content desk-focus-bro w h ds tf (ui-wscale w)
    in act
      bp <- gbr-new (box0.lr-w) (box0.lr-h)
      let apps2 = DeskApps { da-fonts = apps.da-fonts, da-files = apps.da-files, da-browser = Just bp, da-scene = apps.da-scene, da-edit = apps.da-edit, da-sheet = apps.da-sheet, da-review = apps.da-review }
      in act
        c0 <- desk-wall-paint base w h stride font tf ds
        p <- gbr-first-paint base (box0.lr-x) (box0.lr-y) (box0.lr-w) (box0.lr-h) stride font tf mouse cs (ui-scale w) bp
        let sf = poke-32 ds desk-focus-cell (dk-wr-top (peek-32 ds dk-wr-cell))
        in let inval = poke-32 ds desk-second-cell (0 - 1)
        in let c1 = dk-cursor base w h stride cs mouse
        in desk-loop base w h stride font tf kbd mouse ds cs apps2 root
      end
    end
  end

  desk-browser-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Boolean -> [Device.Port] Integer
  desk-browser-step (base) (w) (h) (stride) (font) (tf) (mouse) (ds) (cs) (apps) (root) (sc) (clicked) =
    when apps.da-browser
      is None -> act 0 end
      is Just (bp) -> act
        ev <- desk-wnd-chrome-step base w h stride font tf mouse ds cs desk-focus-bro sc clicked
        let box = dk-wnd-content desk-focus-bro w h ds tf (ui-wscale w)
        in if ev == desk-wnd-ev-close then act 0 end
        else if ev == desk-wnd-ev-min then act desk-step-hide end
        else if ev == desk-wnd-ev-stay then act
          let d = __heap-restore ((bp.bp-st).bs-laid-mark)
          in let p = gbr-first-paint base (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) stride font tf mouse cs (ui-scale w) bp
          in 0 - 1
        end
            else if sc == 15 then act desk-step-hide end
        else if sc == 88 then act
          let mark = __heap-save
          in act
            r <- desk-shot base w h stride font tf ds
            let d = __heap-restore mark
            in 1
          end
        end
        else gbr-step base (box.lr-x) (box.lr-y) (box.lr-w) (box.lr-h) stride font tf mouse cs (ui-scale w) bp sc clicked
      end

  desk-wnd-to-desk : Integer, Integer, Integer, UsbMouse, GopFont, Boolean -> Boolean
  desk-wnd-to-desk (ds) (w) (h) (mouse) (tf) (clicked) =
    let ws = peek-32 ds dk-wr-cell
    in clicked
       & dk-wr-count ws > 0
       & dk-wr-find ws (peek-32 ds desk-focus-cell) 0 >= 0
       & desk-wnd-at w h (mouse-x mouse) (mouse-y mouse) tf ds ws (dk-wr-count ws - 1) == desk-focus-none
       & dk-size-zone ds w h (mouse-x mouse) (mouse-y mouse) == dk-size-none

  desk-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) = act
    let y = process-yield
    in let fmark = __heap-save
    in act
      sc <- kbd-take kbd
      ck <- if dk-drag-fid ds == desk-focus-none then desk-clock base w h stride font tf ds root else act 0 end
      let rr = dk-rate-tick ds
      in let rp = if rr == 1 then desk-rate-paint base w h stride font (ui-scale w) tf cs mouse ds else 0
      in let mv = mouse-pump mouse w h
      in let zs = if mv == 1 & dk-drag-fid ds == desk-focus-none & dk-size-active ds == dk-size-none then cursor-set-shape cs (dk-size-cursor (dk-size-zone ds w h (mouse-x mouse) (mouse-y mouse))) else 0
      in let cu = if mv == 1 then cursor-update cs base stride h w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in let clicked = mouse-take-click mouse
      in act
        cl <- dk-snd-click ds clicked
        fn <- dk-snd-focus-note ds
        pm <- dk-snd-pump ds
        if desk-wnd-to-desk ds w h mouse tf clicked then
          let d = __heap-restore fmark
          in desk-dispatch base w h stride font tf kbd mouse ds cs apps root sc clicked
        else if peek-32 ds desk-focus-cell /= desk-focus-none then act
          alive <- desk-step-of base w h stride font tf kbd mouse ds cs apps root (peek-32 ds desk-focus-cell) sc clicked
          if alive == 0 then desk-app-close base w h stride font tf kbd mouse ds cs apps
          else if alive == desk-step-dismiss then desk-menu-dismiss base w h stride font tf kbd mouse ds cs apps
          else if alive == desk-step-hide then desk-app-hide base w h stride font tf kbd mouse ds cs apps
          else if alive == 1 then
            let d = __heap-restore fmark
            in desk-loop base w h stride font tf kbd mouse ds cs apps root
          else if alive < 0 then desk-loop base w h stride font tf kbd mouse ds cs apps root
          else desk-app-close-to base w h stride font tf kbd mouse ds cs apps alive
        end
        else if clicked == False & sc /= desk-sc-shot then act
          hv <- dk-hover-maybe (mv == 1 | peek-32 ds dk-hover-cell /= desk-focus-none) base w h stride font tf ds cs root mouse
          let d = __heap-restore fmark
          in desk-loop base w h stride font tf kbd mouse ds cs apps root
        end
        else
          let d = __heap-restore fmark
          in desk-dispatch base w h stride font tf kbd mouse ds cs apps root sc clicked
      end
    end
  end

  dk-pillc-cell : Integer = 204
  dk-pillc-t-cell : Integer = 208
  dk-dclick-ms : Integer = 400

  dk-dclick : Integer, Integer, Integer, Integer -> Boolean
  dk-dclick (last) (fid) (el) (tps) =
    if tps <= 0 then False
    else if last /= fid then False
    else el * 1000 <= dk-dclick-ms * tps

  dk-pillc-note : Integer, Integer, Integer -> Integer
  dk-pillc-note (ds) (fid) (now) =
    let a = poke-32 ds dk-pillc-t-cell now
    in poke-32 ds dk-pillc-cell fid

  dk-pillc-clear : Integer -> Integer
  dk-pillc-clear (ds) = poke-32 ds dk-pillc-cell desk-focus-none

  dk-hover-cell : Integer = 236
  dk-hover-t-cell : Integer = 240
  dk-hover-ms : Integer = 400

  dk-hover-note : Integer, Integer, Integer -> Integer
  dk-hover-note (ds) (fid) (now) =
    if peek-32 ds dk-hover-cell == fid then fid
    else
      let a = poke-32 ds dk-hover-t-cell (bit-and now dk-rate-mask)
      in let b = poke-32 ds dk-hover-cell fid
      in fid

  dk-hover-held : Integer, Integer, Integer -> Integer
  dk-hover-held (ds) (now) (tps) =
    if peek-32 ds dk-hover-cell == desk-focus-none then 0
    else
      let d = bit-and (now - peek-32 ds dk-hover-t-cell) dk-rate-mask
      in d * 1000 / tps

  dk-hover-ready : Integer, Integer, Integer -> Boolean
  dk-hover-ready (ds) (now) (tps) =
    if peek-32 ds dk-hover-cell == desk-focus-none then False
    else dk-hover-held ds now tps >= dk-hover-ms

  dk-prev-gap : Integer = 8

  dk-prev-fit : Integer, Integer, Integer -> Integer
  dk-prev-fit (v) (size) (limit) =
    if v < 0 then 0
    else if v + size > limit then limit - size
    else v

  dk-prev-bubble : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> LayoutRect
  dk-prev-bubble (px) (py) (pw) (ph) (e) (w) (h) =
    let x0 = if e == dk-edge-left then px + pw + dk-prev-gap
      else if e == dk-edge-right then px - dk-prev-w - dk-prev-gap
      else px + pw / 2 - dk-prev-w / 2
    in let y0 = if e == dk-edge-top then py + ph + dk-prev-gap
      else if e == dk-edge-bottom then py - dk-prev-h - dk-prev-gap
      else py + ph / 2 - dk-prev-h / 2
    in layout-rect (dk-prev-fit x0 dk-prev-w w) (dk-prev-fit y0 dk-prev-h h) dk-prev-w dk-prev-h

  dk-bub-cell : Integer = 252
  dk-bub-shown : Integer = 0
  dk-bub-x : Integer = 4
  dk-bub-y : Integer = 8
  dk-bub-save : Integer = 32

  dk-bub-init : Integer -> Integer
  dk-bub-init (ds) = poke-32 ds dk-bub-cell (alloc-zeroed (dk-bub-save + dk-prev-bytes) 64)

  dk-bub-cols-in : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-bub-cols-in (base) (stride) (buf) (x0) (y0) (py) (px) =
    if px >= dk-prev-w then 0
    else let c = poke-32 buf ((py * dk-prev-w + px) * 4) (peek-32 base (((y0 + py) * stride + x0 + px) * 4))
    in dk-bub-cols-in base stride buf x0 y0 py (px + 1)

  dk-bub-rows-in : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-bub-rows-in (base) (stride) (buf) (x0) (y0) (py) =
    if py >= dk-prev-h then 0
    else let r = dk-bub-cols-in base stride buf x0 y0 py 0
    in dk-bub-rows-in base stride buf x0 y0 (py + 1)

  dk-bub-cols-out : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-bub-cols-out (base) (stride) (src) (x0) (y0) (py) (px) =
    if px >= dk-prev-w then 0
    else let c = poke-32 base (((y0 + py) * stride + x0 + px) * 4) (peek-32 src ((py * dk-prev-w + px) * 4))
    in dk-bub-cols-out base stride src x0 y0 py (px + 1)

  dk-bub-rows-out : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-bub-rows-out (base) (stride) (src) (x0) (y0) (py) =
    if py >= dk-prev-h then 0
    else let r = dk-bub-cols-out base stride src x0 y0 py 0
    in dk-bub-rows-out base stride src x0 y0 (py + 1)

  dk-bub-visible : Integer -> Boolean
  dk-bub-visible (ds) =
    let bb = peek-32 ds dk-bub-cell
    in if bb == 0 then False else peek-32 bb dk-bub-shown /= 0

  dk-bub-show : Integer, Integer, Integer, Integer, Integer, LayoutRect -> Integer
  dk-bub-show (base) (stride) (ds) (cs) (fid) (r) =
    let bb = peek-32 ds dk-bub-cell
    in let pb = peek-32 ds dk-prev-cell
    in if bb == 0 | pb == 0 then 0
    else if peek-32 bb dk-bub-shown /= 0 then 0
    else if fid <= desk-focus-none | fid >= dk-prev-slots then 0
    else let ch = cursor-hide cs base stride
    in let sx = poke-32 bb dk-bub-x (r.lr-x)
    in let sy = poke-32 bb dk-bub-y (r.lr-y)
    in let sv = dk-bub-rows-in base stride (bb + dk-bub-save) (r.lr-x) (r.lr-y) 0
    in let bl = dk-bub-rows-out base stride (dk-prev-at pb fid) (r.lr-x) (r.lr-y) 0
    in poke-32 bb dk-bub-shown 1

  dk-bub-hide : Integer, Integer, Integer, Integer -> Integer
  dk-bub-hide (base) (stride) (ds) (cs) =
    let bb = peek-32 ds dk-bub-cell
    in if bb == 0 then 0
    else if peek-32 bb dk-bub-shown == 0 then 0
    else let ch = cursor-hide cs base stride
    in let rs = dk-bub-rows-out base stride (bb + dk-bub-save) (peek-32 bb dk-bub-x) (peek-32 bb dk-bub-y) 0
    in poke-32 bb dk-bub-shown 0

  dk-bub-wanted : Integer, Integer -> Boolean
  dk-bub-wanted (ds) (fid) =
    let blk = desk-wnd-blk fid ds
    in if blk == 0 then False else dk-wnd-minimised blk

  dk-bub-open : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, Integer, LayoutRect -> [Device.Port] Integer
  dk-bub-open (base) (w) (h) (stride) (font) (tf) (ds) (cs) (fid) (r) = act
    fr <- dk-prev-fresh base w h stride ds font tf fid
    dk-bub-show base stride ds cs fid r
  end

  dk-hover-step : Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, WidgetNode, UsbMouse -> [Device.Port] Integer
  dk-hover-step (base) (w) (h) (stride) (font) (tf) (ds) (cs) (root) (mouse) =
    let s = ui-wscale w
    in let mx = mouse-x mouse
    in let my = mouse-y mouse
    in let pill = dk-pill-hit root mx my (peek-32 ds dk-wr-cell) ds s 0
    in let left = if pill /= peek-32 ds dk-hover-cell then dk-bub-hide base stride ds cs else 0
    in let noted = dk-hover-note ds pill hpet-ticks
    in if pill == desk-focus-none then act 0 end
    else if dk-bub-visible ds then act 0 end
    else if dk-hover-ready ds hpet-ticks hpet-ticks-per-second == False then act 0 end
    else if dk-bub-wanted ds pill == False then act 0 end
    else when ev-hit-widget root (comp-hit-x mx s) (comp-hit-y my s)
      is Just (wgt) -> dk-bub-open base w h stride font tf ds cs pill (dk-prev-bubble ((wgt.wn-bounds).lr-x * s) ((wgt.wn-bounds).lr-y * s) ((wgt.wn-bounds).lr-w * s) ((wgt.wn-bounds).lr-h * s) (dk-pedge-get ds pill) w h)
      is None -> act 0 end

  dk-hover-maybe : Boolean, Integer, Integer, Integer, Integer, CbfFont, GopFont, Integer, Integer, WidgetNode, UsbMouse -> [Device.Port] Integer
  dk-hover-maybe (go) (base) (w) (h) (stride) (font) (tf) (ds) (cs) (root) (mouse) =
    if go then dk-hover-step base w h stride font tf ds cs root mouse else act 0 end

  dk-pill-hit : WidgetNode, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dk-pill-hit (root) (mx) (my) (ws) (ds) (s) (fid) =
    if fid > dk-focus-max then desk-focus-none
    else if dk-pill-live ws ds fid == False then dk-pill-hit root mx my ws ds s (fid + 1)
    else if desk-widget-hit root mx my (dk-pill-id fid) s then fid
    else dk-pill-hit root mx my ws ds s (fid + 1)

  desk-pill-restore : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer

  desk-pill-restore (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (fid) = act
    hd <- act cursor-hide cs base stride end
    let ws = peek-32 ds dk-wr-cell
    in let st = poke-32 (desk-wnd-blk fid ds) dk-wnd-st-cell dk-wnd-st-normal
    in let t = dk-wr-raise ws fid
    in let sf = poke-32 ds desk-focus-cell fid
    in let rc = desk-root-reclaim ds
    in let rm = __heap-save
    in let root2 = desk-draw base w h stride font (ui-scale w) tf ds
    in let rn = desk-root-note ds rm
    in if fid == desk-focus-files then desk-files-focus base w h stride font tf kbd mouse ds cs apps root2
    else if fid == desk-focus-bro then desk-browser-focus base w h stride font tf kbd mouse ds cs apps root2
    else if fid == desk-focus-edit then desk-edit-focus base w h stride font tf kbd mouse ds cs apps root2
    else if fid == desk-focus-scene then desk-scene-focus base w h stride font tf kbd mouse ds cs apps root2 gsc-sky desk-focus-scene
    else if fid == desk-focus-fish then desk-scene-focus base w h stride font tf kbd mouse ds cs apps root2 gf-sky desk-focus-fish
    else if fid == desk-focus-sheet then desk-sheet-focus base w h stride font tf kbd mouse ds cs apps root2
    else act
      p <- desk-wnd-paint-all base w h stride font tf ds
      let c0 = dk-cursor base w h stride cs mouse
      in desk-loop base w h stride font tf kbd mouse ds cs apps root2
    end
  end

  desk-pill-minimise : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-pill-minimise (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (fid) =
    let st = poke-32 (desk-wnd-blk fid ds) dk-wnd-st-cell dk-wnd-st-min
    in desk-app-hide base w h stride font tf kbd mouse ds cs apps

  desk-dispatch : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Boolean -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-dispatch (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (sc) (clicked) =
    let bh = dk-bub-hide base stride ds cs
    in let pill = if clicked then dk-pill-hit root (mouse-x mouse) (mouse-y mouse) (peek-32 ds dk-wr-cell) ds (ui-wscale w) 0 else desk-focus-none
    in if pill /= desk-focus-none then
      if dk-wr-find (peek-32 ds dk-wr-cell) pill 0 < 0 then desk-dispatch-app base w h stride font tf kbd mouse ds cs apps root (dk-fid-sc pill) False
      else
        let now = hpet-ticks
        in let el = bit-and (now - peek-32 ds dk-pillc-t-cell) dk-rate-mask
        in if dk-dclick (peek-32 ds dk-pillc-cell) pill el hpet-ticks-per-second then
          let c = dk-pillc-clear ds
          in desk-pill-minimise base w h stride font tf kbd mouse ds cs apps pill
        else
          let n = dk-pillc-note ds pill now
          in desk-pill-restore base w h stride font tf kbd mouse ds cs apps root pill
    else if clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "task-clock" (ui-wscale w) then
      let now = hpet-ticks
      in let el = bit-and (now - peek-32 ds dk-pillc-t-cell) dk-rate-mask
      in if dk-dclick (peek-32 ds dk-pillc-cell) desk-focus-clkp el hpet-ticks-per-second then
        let c = dk-pillc-clear ds
        in desk-clock-open base w h stride font tf kbd mouse ds cs (peek-32 ds desk-clock-cell) apps root
      else
        let n = dk-pillc-note ds desk-focus-clkp now
        in desk-dispatch-app base w h stride font tf kbd mouse ds cs apps root sc clicked
    else desk-dispatch-app base w h stride font tf kbd mouse ds cs apps root sc clicked

  desk-dispatch-app : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DeskApps, WidgetNode, Integer, Boolean -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer
  desk-dispatch-app (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (apps) (root) (sc) (clicked) =
    let files = if sc == 33 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "files" (ui-wscale w)
    in let scene = (if sc == 4 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "scene" (ui-wscale w))
    in let fish = (if sc == 16 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "fish" (ui-wscale w))
    in let mon = if sc == 50 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "monitor" (ui-wscale w)
    in let calc = if sc == 46 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "calc" (ui-wscale w)
    in let con = if sc == 20 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "console" (ui-wscale w)
    in let cal = if sc == 38 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "cal" (ui-wscale w)
    in let trk = if sc == 23 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "issues" (ui-wscale w)
    in let rev = if sc == 19 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "review" (ui-wscale w)
    in let dif = if sc == 32 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "diffusion" (ui-wscale w)
    in let bro = if sc == 48 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "browser" (ui-wscale w)
    in let edt = if sc == 18 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "edit" (ui-wscale w)
    in let sty = if sc == 30 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "style" (ui-wscale w)
    in let bye = sc == dk-sc-bye
    in let prg = if sc == 25 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "programs" (ui-wscale w)
    in let sysm = if sc == 41 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "menu" (ui-wscale w)
    in let clk = if sc == 37 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "clock" (ui-wscale w)
    in let web = if sc == 17 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "webserver" (ui-wscale w)
    in let sht = if sc == 31 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "sheets" (ui-wscale w)
    in if sc == 88 then desk-snap base w h stride font tf kbd mouse ds cs apps root
    else if sysm then desk-menu-open base w h stride font tf kbd mouse ds cs (peek-32 ds desk-prog-cell) apps root
    else if prg then desk-programs-open base w h stride font tf kbd mouse ds cs (peek-32 ds desk-prog-cell) apps root
    else if clk then desk-clock-open base w h stride font tf kbd mouse ds cs (peek-32 ds desk-clock-cell) apps root
    else if files then desk-files-focus base w h stride font tf kbd mouse ds cs apps root
    else if scene then desk-scene-focus base w h stride font tf kbd mouse ds cs apps root gsc-sky desk-focus-scene
    else if fish then desk-scene-focus base w h stride font tf kbd mouse ds cs apps root gf-sky desk-focus-fish
    else if mon then desk-mon-open base w h stride font tf kbd mouse ds cs apps root
    else if calc then desk-calc-open base w h stride font tf kbd mouse ds cs (peek-32 ds 24) apps root
    else if con then desk-console-open base w h stride font tf kbd mouse ds cs (peek-32 ds desk-console-cell) apps root
    else if sht then desk-sheet-open base w h stride font tf kbd mouse ds cs apps root
    else if cal then desk-cal-open base w h stride font tf kbd mouse ds cs apps root
    else if trk then desk-trk-open base w h stride font tf kbd mouse ds cs apps root
    else if rev then desk-rev-open base w h stride font tf kbd mouse ds cs apps root
    else if dif then desk-dif-open base w h stride font tf kbd mouse ds cs apps root
    else if bro then desk-browser-focus base w h stride font tf kbd mouse ds cs apps root
    else if edt then desk-edit-focus base w h stride font tf kbd mouse ds cs apps root
    else if sty then desk-style-open base w h stride font tf kbd mouse ds cs apps root
    else if web then desk-web-open base w h stride font tf kbd mouse ds cs apps root
    else if bye then desk-shutdown base w h stride font tf kbd mouse ds cs apps root
    else desk-loop base w h stride font tf kbd mouse ds cs apps root
  end

  dk-ui-ppem : Integer -> Integer
  dk-ui-ppem (w) = if w >= 1600 then 16 else 14

  desk-font : Integer -> [Device.Port] GopFont
  desk-font (w) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then gfont-none
    else gfont-selected (m.gm-vol) (dk-ui-ppem w)
  end

  desk-app-fonts : Integer, GopFont, CbfFont -> [Device.Port] GopAppFont
  desk-app-fonts (w) (ui) (bitmap) = act
    mounted <- gfat-mount-esp
    if mounted.gm-ok == False then GopAppFont { af-ui = ui, af-code = gfont-none, af-bitmap = bitmap }
    else act
      code <- gfont-load (mounted.gm-vol) "PLEXMONO.TTF" (dk-ui-ppem w)
      GopAppFont { af-ui = ui, af-code = code, af-bitmap = bitmap }
    end
  end

  desk-run : Integer, Integer, Integer, Integer, CbfFont, UsbKbd, UsbMouse, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory, Identity, Audio] Integer

  desk-run (base) (w) (h) (stride) (font) (kbd) (mouse) (web) = act
    tf <- desk-font w
    af <- desk-app-fonts w tf font
    gp <- desk-gpu-present 0
    st <- gst-load (gst-store dk-settings-keys)
    let s = ui-scale w
    in let ds = alloc-zeroed dk-ds-bytes 64
    in let wbp = poke-32 ds dk-web-cell web
    in let hs = hpet-start
    in let cs = alloc-zeroed 2048 64
    in let ks = alloc-zeroed 64 64
    in let ns = alloc-zeroed 64 64
    in let kp = poke-32 ds 24 ks
    in let np = poke-32 ds desk-console-cell ns
    in let ep = poke-32 ds desk-edit-cell (alloc-zeroed 192 64)
    in let ci = gcon-init ns
    in let pp = poke-32 ds desk-prog-cell (alloc-zeroed 64 64)
    in let kp2 = poke-32 ds desk-clock-cell (alloc-zeroed 128 64)
    in let rvp = poke-32 ds desk-review-cell (alloc-zeroed 64 64)
    in let rvi = grv-init (peek-32 ds desk-review-cell)
    in let msp = poke-32 ds desk-marks-cell (alloc-zeroed 128 64)
    in let pvp = poke-32 ds dk-prev-cell (alloc-zeroed (dk-prev-slots * dk-prev-bytes) 64)
    in let wrp = poke-32 ds dk-wr-cell (alloc-zeroed 64 64)
    in let calp = poke-32 ds dk-cal-cell (alloc-zeroed 64 64)
    in let difp = poke-32 ds dk-dif-cell (alloc-zeroed 64 64)
    in let styp = poke-32 ds dk-sty-cell (alloc-zeroed 64 64)
    in let trkp = poke-32 ds dk-trk-cell (alloc-zeroed 64 64)
    in let monp = poke-32 ds dk-mon-cell (alloc-zeroed 64 64)
    in let scnp = poke-32 ds dk-scene-cell (alloc-zeroed 64 64)
    in let fshp = poke-32 ds dk-fish-cell (alloc-zeroed 64 64)
    in let brop = poke-32 ds dk-bro-cell (alloc-zeroed 64 64)
    in let flsp = poke-32 ds dk-files-cell (alloc-zeroed 64 64)
    in let shtp = poke-32 ds dk-sheet-cell (alloc-zeroed 64 64)
    in let gpk = poke-32 ds desk-gpu-cell gp
    in let sdi = dk-snd-init ds
    in let ici = dk-icons-init ds tf w
    in let pei = dk-pedge-init ds
    in let bbi = dk-bub-init ds
    in let nti = dk-notice-init ds
    in let ap = dk-settings-into ds st
    in let tki = dk-task-init ds tf w
    in let sti = dk-strip-init ds tf w
    in act
      ce <- clk-ensure (peek-32 ds desk-clock-cell)
      ce2 <- clk-ensure2 (peek-32 ds desk-clock-cell)
      let wp = mouse-warp mouse (w / 2) (h / 2)
      in let apps = desk-apps-empty af
      in let bm = poke-32 ds desk-mark-cell __heap-save
      in let rm = __heap-save
      in let root = desk-draw base w h stride font s tf ds
      in let rn = desk-root-note ds rm
      in let c0 = cursor-update cs base stride h w h s (w / 2) (h / 2)
      in desk-loop base w h stride font tf kbd mouse ds cs apps root
    end
  end
