 The desktop shell frame on the real runtime -- H4's first rung. The
 guios desktop proved a 19-app shell in the emulator, but it leans on
 codex-vm devices no real machine has: a host-side triangle rasterizer
 at MMIO 0xBE000000 with doorbell ports 0x400-0x402, absolute mouse
 coordinates synthesized on ports 0xE1-0xE4, and frame pacing by
 port-224 VM exits. This chapter is the frame those apps will land on,
 built only from what the Option A runtime actually provides: the GOP
 framebuffer from the handoff cells, keyboard and mouse from the H2
 USB stack (or PS/2 through the same mailbox), the PIT tick cell for
 pacing, and the CMOS RTC for wall-clock time.

 There is no frame loop running at a made-up rate. The desktop is
 event-driven: the loop polls the keyboard mailbox and the mouse pump
 -- both allocation-free when idle -- and repaints exactly what an
 event dirtied. The clock redraws when the tick cell says a second
 has passed. A machine showing an idle desktop executes a poll loop
 that allocates nothing and writes nothing.

 We say:

Section: Palette and Layout

 Three of these are the Seattle Seahawks brand colours exactly, and the
 rest are a ramp of College Navy so nothing on the desktop is a blue that
 belongs to nobody. The exact ones are the bar (College Navy 002244), the
 body text (Wolf Grey A5ACAF) and the hint line (Action Green 69BE28).

  dk-col-bar : Integer = #002244
  dk-col-wall : Integer = #001428
  dk-col-task : Integer = #000E1C
  dk-col-win : Integer = #003366
  dk-col-title : Integer = #004488
  dk-col-text : Integer = #A5ACAF
  dk-col-bright : Integer = #FFFFFF
  dk-col-hint : Integer = #69BE28
  dk-col-warn : Integer = #FFB040

  dk-bar-h : Integer = 22
  dk-task-h : Integer = 28
  dk-win-w : Integer = 360
  dk-title-h : Integer = 20
  dk-body-y0 : Integer = 32
  dk-line-h : Integer = 18
  dk-para-gap : Integer = 6

  dk-win-pad-b : Integer = 30

  dk-palette : Palette
  dk-palette = Palette {
    pal-bg = dk-col-wall,
    pal-fg = dk-col-text,
    pal-primary = dk-col-hint,
    pal-secondary = dk-col-title,
    pal-accent = dk-col-bright,
    pal-muted = dk-col-task,
    pal-error = dk-col-warn,
    pal-success = dk-col-hint,
    pal-warning = dk-col-warn,
    pal-border = dk-col-bar
  }

  dk-theme : Theme
  dk-theme =
    let pal = dk-palette
    in let bdr = border-uniform 1 (pal.pal-border) CornerSharp
    in let pad = edges-uniform 4
    in let mar = edges-uniform 2
    in let base = widget-style (pal.pal-bg) (pal.pal-fg) bdr pad mar
    in let btn = widget-style (pal.pal-primary) (pal.pal-bg) bdr pad mar
    in let btn-h = widget-style (pal.pal-accent) (pal.pal-bg) bdr pad mar
    in let btn-p = widget-style (pal.pal-secondary) (pal.pal-fg) bdr pad mar
    in let btn-d = widget-style (pal.pal-muted) (pal.pal-muted) bdr pad mar
    in let inp = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 1 (pal.pal-muted) CornerSharp) pad mar
    in let inp-f = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 2 (pal.pal-accent) CornerSharp) pad mar
    in let lbl = widget-style 0 (pal.pal-fg) border-none edges-zero mar
    in let sep = widget-style (pal.pal-border) (pal.pal-border) border-none edges-zero (edges-xy 0 4)
    in Theme {
      th-name = "desk",
      th-palette = pal,
      th-panel = state-styles-flat base,
      th-button = StateStyles { ss-normal = btn, ss-hover = btn-h, ss-pressed = btn-p, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = state-styles-flat lbl,
      th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = state-styles-flat (widget-style (pal.pal-bg) (pal.pal-primary) bdr (edges-uniform 2) mar),
      th-separator = state-styles-flat sep
    }

  dk-win-x : Integer, Integer -> Integer
  dk-win-x (w) (s) = (w - dk-win-w * s) / 2

  dk-win-y : Integer, Integer, GopFont -> Integer
  dk-win-y (h) (s) (tf) = (h - dk-task-h * s - dk-win-h tf s * s) / 2

Section: RTC

 The CMOS RTC answers on ports 0x70/0x71 on every PC, virtual or
 real -- no VM convenience involved. Registers 0, 2, 4 are seconds,
 minutes, hours, BCD-encoded. `rtc-read` and the guarded `rtc-seconds`
 come from GopRtc, which waits out Update-In-Progress and reads twice:
 a raw seconds read from a fast poll loop lands in the update window
 constantly and answers garbage.

  dk-bcd : Integer -> Integer
  dk-bcd (n) = (n / 16) * 10 + int-mod n 16

  dk-pad2 : Integer -> Text
  dk-pad2 (n) = if n < 10 then "0" & show n else show n

Section: Chrome

 The shell chrome built with the real widget system: a sidebar column of
 app buttons pinned 160 wide, and a right-hand column of flexible content
 over a 24-pixel taskbar row. The compositor lays it out against the real
 panel rectangle and paints it in software.

  desk-sidebar : Integer -> WidgetNode
  desk-sidebar (dummy) =
    widget-set-flex (widget-set-min (widget-panel "sidebar" DirColumn 1 [widget-label "brand" "CODEX", widget-button "files" "Files", widget-button "scene" "3D View", widget-button "calc" "Calc", widget-button "cal" "Calendar", widget-button "issues" "Issues", widget-button "diffusion" "Diffusion", widget-button "monitor" "Monitor", widget-set-flex (widget-label "sidebar-spacer" "") 1, widget-button "shutdown" "Shutdown"]) 160 0) 0

  desk-taskbar : Integer -> WidgetNode
  desk-taskbar (dummy) =
    widget-set-flex (widget-set-min (widget-panel "taskbar" DirRow 4 [widget-set-min (widget-label "task-brand" "CODEX") 56 0, widget-set-flex (widget-label "task-spacer" "") 1]) 0 24) 0

  desk-chrome-with : WidgetNode, Integer -> WidgetNode
  desk-chrome-with (content) (s) =
    let gap = widget-set-flex (widget-set-min (widget-panel "topgap" DirColumn 0 []) 0 (dk-bar-h * s)) 0
    in widget-panel "root" DirRow 0 [desk-sidebar 0, widget-set-flex (widget-panel "right" DirColumn 0 [gap, widget-set-flex content 1, desk-taskbar 0]) 1]

  desk-chrome : Integer -> WidgetNode
  desk-chrome (dummy) = widget-panel "root" DirRow 0 [desk-sidebar 0, widget-set-flex (widget-panel "right" DirColumn 0 [widget-set-flex (widget-panel "content" DirColumn 0 []) 1, desk-taskbar 0]) 1]

Section: Drawing

  desk-line : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Integer, Text, Integer -> Integer
  desk-line (base) (stride) (h) (font) (s) (tf) (x) (y) (t) (fg) =
    if tf.gf-ok then gfont-text tf base stride h x y t fg
    else gop-draw-text base stride font x y t fg s 0

  dk-wrap-cols : Integer -> Integer
  dk-wrap-cols (s) =
    let c = (dk-win-w * s - 20 * s) / (8 * s)
    in if c < 8 then 8 else c

  dk-break : Text, Integer, Integer, Integer -> Integer
  dk-break (t) (limit) (i) (best) =
    if i >= limit then best
    else if is-whitespace (char-at t i) then dk-break t limit (i + 1) i
    else dk-break t limit (i + 1) best

 The panel is sized from the text rather than the text trimmed to the
 panel. The body used to be four hand-broken lines drawn WITHOUT the
 wrapper: 44, 45 and 47 characters against a 42-column width, so three of
 them ran 50 pixels past the right frame, and the wrapped hint below them
 fell 26 pixels past the bottom of a fixed 160. Both were measured off the
 glass. A hand-broken line cannot be checked by anything, so there are no
 hand-broken lines here now.

  dk-wrap-count : Text, Integer -> Integer
  dk-wrap-count (t) (cols) =
    let n = text-length t
    in if n <= cols then 1
    else let b = dk-break t cols 0 0
    in let cut = if b <= 0 then cols else b
    in let skip = if b <= 0 then cut else cut + 1
    in 1 + dk-wrap-count (substring t skip (n - skip)) cols

  dk-para-intro : Text = "The Codex desktop frame on the bare runtime. Input arrives over USB HID or PS/2; the clock runs on PIT ticks and the CMOS RTC. No emulator devices, no frame pacing, no font disk."

  dk-para-hint : Text = "Files (f) browses this stick. 3D View (3) renders a scene. Calc (c) does arithmetic. Calendar (l) shows the month. Issues (i) lists the tracker. Monitor (m) reads the machine. Shutdown powers the machine off."

  dk-para-font : GopFont -> Text
  dk-para-font (tf) = if tf.gf-ok then "Font: TrueType CMUNSS.TTF from this stick's ESP." else "Font: CBF bitmap (no TTF on the ESP)."

  dk-body-lines : GopFont, Integer -> Integer
  dk-body-lines (tf) (s) =
    let cols = dk-wrap-cols s
    in dk-wrap-count dk-para-intro cols + dk-wrap-count (dk-para-font tf) cols + dk-wrap-count dk-para-hint cols

  dk-win-h : GopFont, Integer -> Integer
  dk-win-h (tf) (s) = dk-body-y0 + dk-body-lines tf s * dk-line-h + 2 * dk-para-gap + dk-win-pad-b

  dk-wrap-draw : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Integer, Text, Integer, Integer -> Integer
  dk-wrap-draw (base) (stride) (h) (font) (s) (tf) (x) (y) (t) (fg) (cols) =
    let n = text-length t
    in if n <= cols then desk-line base stride h font s tf x y t fg
    else let b = dk-break t cols 0 0
    in let cut = if b <= 0 then cols else b
    in let skip = if b <= 0 then cut else cut + 1
    in let l = desk-line base stride h font s tf x y (substring t 0 cut) fg
    in dk-wrap-draw base stride h font s tf x (y + 18 * s) (substring t skip (n - skip)) fg cols

  desk-topbar : Integer, Integer, Integer, CbfFont, Integer -> Integer
  desk-topbar (base) (w) (stride) (font) (s) =
    let bar = gop-fill-rect base stride 0 0 w (dk-bar-h * s) dk-col-bar
    in gop-draw-text base stride font (8 * s) (4 * s) "Codex" dk-col-bright s 0

  desk-window : Integer, Integer, Integer, Integer, CbfFont, Integer, GopFont -> Integer
  desk-window (base) (w) (h) (stride) (font) (s) (tf) =
    let wx = dk-win-x w s
    in let wy = dk-win-y h s tf
    in let cols = dk-wrap-cols s
    in let tx = wx + 10 * s
    in let body = gop-fill-rect base stride wx wy (dk-win-w * s) (dk-win-h tf s * s) dk-col-win
    in let title = gop-fill-rect base stride wx wy (dk-win-w * s) (dk-title-h * s) dk-col-title
    in let cap = gop-draw-text base stride font (wx + 6 * s) (wy + 2 * s) "Welcome" dk-col-bright s 0
    in let y1 = wy + dk-body-y0 * s
    in let p1 = dk-wrap-draw base stride h font s tf tx y1 dk-para-intro dk-col-text cols
    in let y2 = y1 + (dk-wrap-count dk-para-intro cols * dk-line-h + dk-para-gap) * s
    in let p2 = dk-wrap-draw base stride h font s tf tx y2 (dk-para-font tf) dk-col-bright cols
    in let y3 = y2 + (dk-wrap-count (dk-para-font tf) cols * dk-line-h + dk-para-gap) * s
    in dk-wrap-draw base stride h font s tf tx y3 dk-para-hint dk-col-hint cols

  desk-draw : Integer, Integer, Integer, Integer, CbfFont, Integer, GopFont -> WidgetNode
  desk-draw (base) (w) (h) (stride) (font) (s) (tf) =
    let laid = comp-render base stride font (desk-chrome 0) dk-theme w h
    in let bar = desk-topbar base w stride font s
    in let win = desk-window base w h stride font s tf
    in laid

  desk-draw-clock : Integer, Integer, Integer, Integer, CbfFont, Text -> Integer
  desk-draw-clock (base) (w) (h) (stride) (font) (t) =
    let s = ui-scale w
    in let tw = text-length t * 8 * s
    in let tx = w - tw - 8 * s
    in let ty = 4 * s
    in let bg = gop-fill-rect base stride tx ty tw (14 * s) dk-col-bar
    in gop-draw-text base stride font tx ty t dk-col-bright s 0

Section: Clock Gate

 It was the tick cell (28672, ~18 ticks per second) until 2026-08-04,
 when the ASUS TUF answered `pit=979` twice, 3405 seconds apart: the
 timer interrupt stops on that board at about 54 seconds and never
 resumes, while IRQ1 keeps delivering and the RTC keeps counting. A
 repaint gated on a dead counter never fires, so the clock froze and
 the Monitor pane below painted one frame for the life of the pane --
 which reads as a hung desktop and was reported as one. The RTC is
 read off ports 0x70/0x71 with no interrupt, no PIC and no handler in
 the path; a machine that boots has one.

  desk-second-cell : Integer = 8

 The eight raw report bytes, because on the ASUS TUF 2026-08-04 the pair
 above read `ev` climbing and `sc` stuck at 0 -- reports arrive and decode
 to nothing -- and that leaves exactly one question. A boot HID report is
 modifiers, a reserved byte, then six usage codes (HID 1.11 B.1), so
 `rp=00000000...` with a key held means the data never reached the buffer
 and the fault is the transfer, while any non-zero usage byte means the
 data is there and `hid-step` is the fault. Two branches, and no bed here
 can produce either: OVMF answers `ev=0` and never gets this far.

  desk-rep : Integer, Integer, Text -> Text
  desk-rep (a) (i) (acc) =
    if i >= 8 then acc
    else desk-rep a (i + 1) (acc & hex-byte (peek-byte a i))

 One block per bound keyboard interface: events then sticky non-zero
 reports, with decoded scancodes once for the shared mailbox. The 13061
 flight answered c=, a=, p= and b= on the glass (SUCCESS, ring walking,
 our own endpoint, low buffer), so those rows retired; e/n per interface
 is the pair that now discriminates -- any interface whose n climbs with
 a key held is the one the person is typing on.

  desk-kbd-line : UsbKbd -> Text
  desk-kbd-line (kbd) =
    if kbd.uk-ok == False then "k=n"
    else desk-kbd-peer-txt kbd ("k" & show (1 + kbd-peers kbd)
      & " e" & show (kbd-events kbd) & "n" & show (kbd-live kbd)
      & "s" & show (kbd-scans kbd)) 0

  desk-kbd-peer-txt : UsbKbd, Text, Integer -> Text
  desk-kbd-peer-txt (kbd) (acc) (i) =
    if i >= kbd-peers kbd then acc
    else let p = kbd-peer kbd i
    in desk-kbd-peer-txt kbd (acc & " |e" & show (kbd-events p) & "n" & show (kbd-live p)) (i + 1)

  desk-clock : Integer, Integer, Integer, Integer, CbfFont, Integer, UsbKbd -> [Device.Port] Integer
  desk-clock (base) (w) (h) (stride) (font) (ds) (kbd) = act
    now <- rtc-seconds 0
    if now < 0 then 0
    else if now == peek-32 ds desk-second-cell then 0
    else act
      hh <- rtc-read 4
      mm <- rtc-read 2
      let st = poke-32 ds desk-second-cell now
      in desk-draw-clock base w h stride font (desk-kbd-line kbd & "  " & dk-pad2 (dk-bcd hh) & ":" & dk-pad2 (dk-bcd mm) & ":" & dk-pad2 now)
    end
  end

Section: Monitor

 What this machine is, read from the live sources at paint time rather
 than from anything cached at boot. It is the first pane worth having on
 a board nobody has booted before: the geometry row alone answers the
 question the whole 2026-08-02 display campaign was about, and it answers
 it on the glass without a serial port.

  dk-mon-x : Integer = 160
  dk-mon-row-h : Integer = 18

  dk-mon-val-dx : Integer = 100
  dk-mon-tick-cell : Integer = 28672

  dk-yn : Boolean -> Text
  dk-yn (b) = if b then "yes" else "no"

  desk-mon-row : Integer, Integer, Integer, CbfFont, Integer, GopFont, Integer, Text, Text -> Integer
  desk-mon-row (base) (stride) (h) (font) (s) (tf) (y) (k) (v) =
    let x = dk-mon-x + 12 * s
    in let lbl = desk-line base stride h font s tf x y k dk-col-hint
    in desk-line base stride h font s tf (x + dk-mon-val-dx * s) y v dk-col-text

  desk-mon-draw : Integer, Integer, Integer, Integer, CbfFont, Integer, GopFont, UsbKbd, UsbMouse, AcpiInfo, Text, Integer -> Integer
  desk-mon-draw (base) (w) (h) (stride) (font) (s) (tf) (kbd) (mouse) (ai) (clk) (ticks) =
    let top = dk-bar-h * s
    in let ph = h - dk-task-h * s - top
    in let bg = gop-fill-rect base stride dk-mon-x top (w - dk-mon-x) ph dk-col-wall
    in let y0 = top + 12 * s
    in let hd = desk-line base stride h font s tf (dk-mon-x + 12 * s) y0 "SYSTEM MONITOR" dk-col-bright
    in let r = dk-mon-row-h * s
    in let y1 = y0 + 2 * r
    in let a = desk-mon-row base stride h font s tf y1 "display" (show w & " x " & show h & "   stride " & show stride)
    in let b = desk-mon-row base stride h font s tf (y1 + r) "framebuffer" ("0x" & hex-i64 base & "   scale " & show s)
    in let c = desk-mon-row base stride h font s tf (y1 + 2 * r) "input" ("keyboard " & (if kbd.uk-ok then "USB HID" else "mailbox") & "   mouse " & dk-yn (mouse.um-ok))
    in let d = desk-mon-row base stride h font s tf (y1 + 3 * r) "font" (if tf.gf-ok then "TrueType CMUNSS.TTF" else "CBF bitmap")
    in let e = desk-mon-row base stride h font s tf (y1 + 4 * r) "acpi" (if ai.ai-ok then "rev " & show (ai.ai-revision) & "   tables " & show (ai.ai-tables) else "no RSDP: stub, EBDA and BIOS area all empty")
    in let f = desk-mon-row base stride h font s tf (y1 + 5 * r) "lapic" ("0x" & hex-i32 (ai.ai-lapic) & "   ioapic 0x" & hex-i32 (ai.ai-ioapic))
    in let g = desk-mon-row base stride h font s tf (y1 + 6 * r) "power" ("S5 " & dk-yn (ai.ai-s5-ok) & "   reset " & dk-yn (ai.ai-reset-ok) & "   sci " & show (ai.ai-sci))
    in let i = desk-mon-row base stride h font s tf (y1 + 7 * r) "clock" (clk & "   ticks " & show ticks)
    in desk-line base stride h font s tf (dk-mon-x + 12 * s) (top + ph - 20 * s) "Esc returns." dk-col-hint

 Repainted on the same RTC-second gate the taskbar clock uses, so the
 time is live rather than frozen at entry. The `ticks` figure it prints
 is the PIT cell READ rather than waited on: on a board whose timer
 dies it stops climbing while the rest of the pane keeps updating,
 which turns a fault that used to freeze this pane into a number
 reporting itself. The bracket is what keeps an open
 pane from growing: every row builds Text that nothing outside the frame
 reads. `ai` is parsed once in desk-monitor, below the mark, because
 re-walking the ACPI tables every second would be work with no answer
 that can change.

  desk-mon-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, AcpiInfo -> [Device.Port] Integer
  desk-mon-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (ai) = act
    let mark = __heap-save
    in act
      sc <- kbd-take kbd
      now <- rtc-seconds 0
      if sc == 1 then let d = __heap-restore mark in 0
      else if sc == 88 then act
        s <- desk-shot base w h stride font
        let d = __heap-restore mark
        in desk-mon-loop base w h stride font tf kbd mouse ds ai
      end
      else if now < 0 | now == peek-32 ds 16 then
        let d = __heap-restore mark
        in desk-mon-loop base w h stride font tf kbd mouse ds ai
      else act
        hh <- rtc-read 4
        mm <- rtc-read 2
        let st = poke-32 ds 16 now
        in let clk = dk-pad2 (dk-bcd hh) & ":" & dk-pad2 (dk-bcd mm) & ":" & dk-pad2 now
        in let p = desk-mon-draw base w h stride font (ui-scale w) tf kbd mouse ai clk (peek-32 dk-mon-tick-cell 0)
        in let dropped = __heap-restore mark
        in desk-mon-loop base w h stride font tf kbd mouse ds ai
      end
    end
  end

  desk-monitor : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-monitor (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    hd <- cursor-hide cs base stride
    let due = poke-32 ds 16 255
    in let ai = acpi-boot 0
    in act
      r <- desk-mon-loop base w h stride font tf kbd mouse ds ai
      let root = desk-draw base w h stride font (ui-scale w) tf
      in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in desk-loop base w h stride font tf kbd mouse ds cs root
    end
  end

Section: Calculator

  desk-calc-paint : Integer, Integer, Integer, Integer, CbfFont, Integer -> Integer
  desk-calc-paint (base) (w) (h) (stride) (font) (ks) =
    let bg = gop-fill-rect base stride 0 0 w h dk-col-wall
    in let laid = comp-render base stride font (desk-chrome-with (gcalc-tree ks) (ui-scale w)) dk-theme w h
    in desk-topbar base w stride font (ui-scale w)

  desk-calc-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-calc-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (ks) = act
    let mark = __heap-save
    in act
      sc <- kbd-take kbd
      if sc == 1 then let d = __heap-restore mark in 0
      else if sc == 88 then act
        s <- desk-shot base w h stride font
        let d = __heap-restore mark
        in desk-calc-loop base w h stride font tf kbd mouse ds ks
      end
      else if gcalc-key ks sc == 0 then
        let d = __heap-restore mark
        in desk-calc-loop base w h stride font tf kbd mouse ds ks
      else
        let p = desk-calc-paint base w h stride font ks
        in let d = __heap-restore mark
        in desk-calc-loop base w h stride font tf kbd mouse ds ks
    end
  end

  desk-calc : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, Integer -> [Device.Port] Integer
  desk-calc (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (ks) = act
    hd <- cursor-hide cs base stride
    let p0 = desk-calc-paint base w h stride font ks
    in act
      r <- desk-calc-loop base w h stride font tf kbd mouse ds ks
      let root = desk-draw base w h stride font (ui-scale w) tf
      in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in desk-loop base w h stride font tf kbd mouse ds cs root
    end
  end

Section: Calendar

 The calendar pane. The month is a still picture until the date changes,
 so it is painted once on entry and the loop then only waits for Esc.
 There is no tick gate and no repaint: a calendar that repainted every
 second would be writing the same pixels 86,399 times a day to be right
 once.

 RTC registers 7, 8 and 9 are day of month, month and year, BCD like the
 time registers. The year register carries two digits, so the century is
 the caller's to supply and this assumes 2000.

  desk-cal-paint : Integer, Integer, Integer, Integer, CbfFont -> [Device.Port] Integer
  desk-cal-paint (base) (w) (h) (stride) (font) = act
    yy <- rtc-read 9
    mm <- rtc-read 8
    dd <- rtc-read 7
    let bg = gop-fill-rect base stride 0 0 w h dk-col-wall
    in let tree = gcal-tree (2000 + dk-bcd yy) (dk-bcd mm) (dk-bcd dd)
    in let laid = comp-render base stride font (desk-chrome-with tree (ui-scale w)) dk-theme w h
    in desk-topbar base w stride font (ui-scale w)
  end

  desk-cal-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-cal-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    sc <- kbd-take kbd
    if sc == 1 then 0
    else if sc == 88 then act
      s <- desk-shot base w h stride font
      desk-cal-loop base w h stride font tf kbd mouse ds cs
    end
    else desk-cal-loop base w h stride font tf kbd mouse ds cs
  end

  desk-cal : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-cal (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    hd <- cursor-hide cs base stride
    p0 <- desk-cal-paint base w h stride font
    r <- desk-cal-loop base w h stride font tf kbd mouse ds cs
    let root = desk-draw base w h stride font (ui-scale w) tf
    in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
    in desk-loop base w h stride font tf kbd mouse ds cs root
  end

Section: Issues

  desk-trk-paint : Integer, Integer, Integer, Integer, CbfFont, DbServer, Integer, Integer -> Integer
  desk-trk-paint (base) (w) (h) (stride) (font) (srv) (filter) (sel) =
    let bg = gop-fill-rect base stride 0 0 w h dk-col-wall
    in let tree = gtk-tree srv filter sel
    in let laid = comp-render base stride font (desk-chrome-with tree (ui-scale w)) dk-theme w h
    in desk-topbar base w stride font (ui-scale w)

  desk-trk-rows : DbServer, Integer -> Integer
  desk-trk-rows (srv) (filter) =
    let r = tk-db-all-issues srv
    in list-length (gtk-rows-from-db (r.qr-rows) filter 0 (r.qr-count) [])

  desk-trk-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, DbServer -> [Device.Port] Integer
  desk-trk-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (srv) = act
    let mark = __heap-save
    in act
      sc <- kbd-take kbd
      let filter = peek-32 ds 32
      in let sel = peek-32 ds 40
      in let n = desk-trk-rows srv filter
      in let hi = if n > 0 then n - 1 else 0
      in let nf = if sc == 33 then int-mod (filter + 1) 3 else filter
      in let ns0 = if sc == 72 then (if sel > 0 then sel - 1 else 0) else sel
      in let ns1 = if sc == 80 then (if ns0 < hi then ns0 + 1 else hi) else ns0
      in let ns = if sc == 33 then 0 else ns1
      in if sc == 1 then let d = __heap-restore mark in 0
      else if sc == 88 then act
        s <- desk-shot base w h stride font
        let d = __heap-restore mark
        in desk-trk-loop base w h stride font tf kbd mouse ds cs srv
      end
      else if nf == filter & ns == sel then
        let d = __heap-restore mark
        in desk-trk-loop base w h stride font tf kbd mouse ds cs srv
      else
        let f1 = poke-32 ds 32 nf
        in let s1 = poke-32 ds 40 ns
        in let p = desk-trk-paint base w h stride font srv nf ns
        in let d = __heap-restore mark
        in desk-trk-loop base w h stride font tf kbd mouse ds cs srv
    end
  end

  desk-trk : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-trk (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    hd <- cursor-hide cs base stride
    let srv = tk-init-tracker-db
    in let p0 = desk-trk-paint base w h stride font srv (peek-32 ds 32) (peek-32 ds 40)
    in act
      r <- desk-trk-loop base w h stride font tf kbd mouse ds cs srv
      let root = desk-draw base w h stride font (ui-scale w) tf
      in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in desk-loop base w h stride font tf kbd mouse ds cs root
    end
  end

Section: Diffusion

  desk-dif-paint : Integer, Integer, Integer, Integer, CbfFont -> Integer
  desk-dif-paint (base) (w) (h) (stride) (font) =
    let bg = gop-fill-rect base stride 0 0 w h dk-col-wall
    in let laid = comp-render base stride font (desk-chrome-with (gdf-tree 0) (ui-scale w)) dk-theme w h
    in desk-topbar base w stride font (ui-scale w)

  desk-dif-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-dif-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    sc <- kbd-take kbd
    if sc == 1 then 0
    else if sc == 88 then act
      s <- desk-shot base w h stride font
      desk-dif-loop base w h stride font tf kbd mouse ds cs
    end
    else desk-dif-loop base w h stride font tf kbd mouse ds cs
  end

  desk-dif : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-dif (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    hd <- cursor-hide cs base stride
    let p0 = desk-dif-paint base w h stride font
    in act
      r <- desk-dif-loop base w h stride font tf kbd mouse ds cs
      let root = desk-draw base w h stride font (ui-scale w) tf
      in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in desk-loop base w h stride font tf kbd mouse ds cs root
    end
  end

Section: Loop

  desk-widget-hit : WidgetNode, Integer, Integer, Text -> Boolean
  desk-widget-hit (root) (mx) (my) (id) =
    when ev-hit-widget root mx my
      is Just (wgt) -> wgt.wn-id == id
      is None -> False

  desk-files : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-files (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    r <- gfl-run base w h stride font kbd mouse cs
    hd <- cursor-hide cs base stride
    let root = desk-draw base w h stride font (ui-scale w) tf
    in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
    in desk-loop base w h stride font tf kbd mouse ds cs root
  end

 The bracket is not decoration. `gsc-run` allocates the render target and
 its depth buffer outside any extent of its own, measured at 4,617,256
 bytes for one visit at 1024x768 and the same again for the next, and the
 boot image gives Codex a 128 MB heap (`build-option-a.ps1 -AllocPages
 32768`, which is `cdx-to-pe`'s `-HeapPages`) rather than the ~3 GB a
 codex-vm bed hands out. Without this, every trip into the pane spends the
 arena that the shot path's sector buffers are drawn from, permanently,
 and no bed at the default memory size can express the cost.

  desk-scene : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer -> [Device.Port] Integer
  desk-scene (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) = act
    let mark = __heap-save
    in act
      r <- gsc-run base w h stride font kbd cs
      let dropped = __heap-restore mark
      in let root = desk-draw base w h stride font (ui-scale w) tf
      in let c0 = if mouse.um-ok then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
      in desk-loop base w h stride font tf kbd mouse ds cs root
    end
  end

 F12 writes the live frame to the boot stick as SHhhmmss.BMP and paints
 the verdict into the taskbar -- the telemetry channel that retires the
 camera rig. The whole capture is heap-bracketed: the 2-and-a-bit
 megabyte frame copy and the FAT image are reclaimed before the loop
 continues, after the verdict Text has been painted.

  desk-shot : Integer, Integer, Integer, Integer, CbfFont -> [Device.Port] Integer
  desk-shot (base) (w) (h) (stride) (font) = act
    let mark = __heap-save
    in act
      t <- shot-take base w h stride
      let s = ui-scale w
      in let bg = gop-fill-rect base stride (200 * s) (h - dk-task-h * s + 4 * s) (300 * s) (16 * s) dk-col-task
      in let tx = gop-draw-text base stride font (204 * s) (h - dk-task-h * s + 6 * s) t dk-col-hint s 0
      in let d = __heap-restore mark
      in 0
    end
  end

  desk-snap : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, WidgetNode -> [Device.Port] Integer
  desk-snap (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (root) = act
    r <- desk-shot base w h stride font
    desk-loop base w h stride font tf kbd mouse ds cs root
  end

  desk-shutdown : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, WidgetNode -> [Device.Port] Integer
  desk-shutdown (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (root) = act
    r <- acpi-poweroff (acpi-boot 0)
    let s = ui-scale w
    in let m = desk-line base stride h font s tf (dk-win-x w s + 10 * s) (dk-win-y h s tf + (dk-win-h tf s - 24) * s) "firmware declined the power transition" dk-col-warn
    in desk-loop base w h stride font tf kbd mouse ds cs root
  end

  desk-loop : Integer, Integer, Integer, Integer, CbfFont, GopFont, UsbKbd, UsbMouse, Integer, Integer, WidgetNode -> [Device.Port] Integer
  desk-loop (base) (w) (h) (stride) (font) (tf) (kbd) (mouse) (ds) (cs) (root) = act
    sc <- kbd-take kbd
    ck <- desk-clock base w h stride font ds kbd
    let mv = mouse-pump mouse w h
    in let cu = if mv == 1 then cursor-update cs base stride w h (ui-scale w) (mouse-x mouse) (mouse-y mouse) else 0
    in let clicked = mv == 1 & mouse-clicked mouse
    in let files = if sc == 33 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "files"
    in let scene = if sc == 4 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "scene"
    in let mon = if sc == 50 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "monitor"
    in let calc = if sc == 46 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "calc"
    in let cal = if sc == 38 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "cal"
    in let trk = if sc == 23 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "issues"
    in let dif = if sc == 32 then True else clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "diffusion"
    in let bye = clicked & desk-widget-hit root (mouse-x mouse) (mouse-y mouse) "shutdown"
    in if sc == 88 then desk-snap base w h stride font tf kbd mouse ds cs root
    else if files then desk-files base w h stride font tf kbd mouse ds cs
    else if scene then desk-scene base w h stride font tf kbd mouse ds cs
    else if mon then desk-monitor base w h stride font tf kbd mouse ds cs
    else if calc then desk-calc base w h stride font tf kbd mouse ds cs (peek-32 ds 24)
    else if cal then desk-cal base w h stride font tf kbd mouse ds cs
    else if trk then desk-trk base w h stride font tf kbd mouse ds cs
    else if dif then desk-dif base w h stride font tf kbd mouse ds cs
    else if bye then desk-shutdown base w h stride font tf kbd mouse ds cs root
    else desk-loop base w h stride font tf kbd mouse ds cs root
  end

  desk-font : Integer -> [Device.Port] GopFont
  desk-font (dummy) = act
    m <- gfat-mount-esp
    if m.gm-ok == False then gfont-none
    else gfont-load (m.gm-vol) "CMUNSS.TTF"
  end

  desk-run : Integer, Integer, Integer, Integer, CbfFont, UsbKbd, UsbMouse -> [Device.Port] Integer
 The calculator's state block is allocated once here and its ADDRESS is
 kept in a `ds` cell, so no pane signature has to grow a parameter. The
 cell is 32-bit: there is no `poke-qword` builtin (only `peek-qword`), and
 a heap address fits because the bare-metal arena tops out below 4 GB --
 `peek-32` zero-extends, so it round-trips exactly rather than sign-
 extending into a negative pointer.

  desk-run (base) (w) (h) (stride) (font) (kbd) (mouse) = act
    tf <- desk-font 0
    let s = ui-scale w
    in let ds = alloc-zeroed 64 64
    in let cs = alloc-zeroed 2048 64
    in let ks = alloc-zeroed 64 64
    in let kp = poke-32 ds 24 ks
    in let wp = mouse-warp mouse (w / 2) (h / 2)
    in let root = desk-draw base w h stride font s tf
    in let c0 = cursor-update cs base stride w h s (w / 2) (h / 2)
    in desk-loop base w h stride font tf kbd mouse ds cs root
  end
