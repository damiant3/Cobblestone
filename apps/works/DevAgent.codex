  role-switch-title : Text = "Switch Agent Role"

  role-switch-menu : MenuState
  role-switch-menu = menu-new role-switch-title [
    menu-item "Dev Console Assistant" "dev",
    menu-item "UI Design Assistant" "ui",
    menu-item "Build Watcher" "build",
    menu-item "Code Reviewer" "review",
