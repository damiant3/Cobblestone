  ]

Section: Formatting

  format-agent-status : AgentStatus -> Text
  format-agent-status (s) = when s
    is AgentReady -> "ready"
    is AgentRunning -> "running"
    is AgentStopped -> "stopped"
    is AgentError (msg) -> "error: " & msg

  format-agent-info : AgentState -> Text
  format-agent-info (a) =
    a.manifest.name & " v" & a.manifest.version
    & " [" & format-agent-status (a.status) & "]"
    & "\n  " & format-coordinator-status (a.coordinator)

  format-gpu-status : GpuBridge -> Text
  format-gpu-status (bridge) =
    "GPU Bridge: " & if bridge.bridge-ready then "READY (doorbell @ #420)" else "NOT READY"

  format-agent-line : AgentState -> Text
  format-agent-line (a) =
    a.manifest.name & " v" & a.manifest.version
    & " [" & format-agent-status (a.status) & "]"
    & " role=" & agent-role-label (a.coordinator.active-role.role)

  format-agent-registry : AgentRegistry -> Text
  format-agent-registry (reg) =
    if reg.count == 0 then "Registry: empty (no agent registered)"
    else let es = hamt-to-list (reg.agents)
    in "Registry: " & show (reg.count) & " agent(s)"
      & agent-line-loop es 0 (list-length es) ""

  agent-line-loop : List (HamtEntry AgentState), Integer, Integer, Text -> Text
  agent-line-loop (es) (i) (n) (acc) =
    if i >= n then acc
    else agent-line-loop es (i + 1) n (acc & "\n  " & format-agent-line ((list-at es i).value))

Section: GPU Probe

 The tolerance is `codex/test/gpu-doorbell`'s and for its reason: the
 guest decoder divides the mantissa down to scale 1000 before applying
 the exponent, so 19.0 arrives as 18992 rather than 19000. One part in a
 hundred is far tighter than the 3000-unit gap between the entries.

  gpu-probe-a : Tensor = Tensor { data = [1000, 2000, 3000, 4000], rows = 2, cols = 2 }
  gpu-probe-b : Tensor = Tensor { data = [5000, 6000, 7000, 8000], rows = 2, cols = 2 }

  gpu-probe-near : Integer, Integer -> Boolean
  gpu-probe-near (got) (want) =
    let diff = if got > want then got - want else want - got
    in diff <= want / 100

  agent-gpu-probe : GpuBridge -> Text
  agent-gpu-probe (bridge) =
    when gpu-bridge-matmul bridge gpu-probe-a gpu-probe-b
      is None -> "GPU Bridge: no reply (nothing is serving compute)"
      is Just (t) -> gpu-probe-verdict t

  gpu-probe-verdict : Tensor -> Text
  gpu-probe-verdict (t) =
    if list-length (t.data) /= 4
      then "GPU Bridge: reply held " & show (list-length (t.data)) & " values, wanted 4"
    else if gpu-probe-near (list-at (t.data) 0) 19000
      & gpu-probe-near (list-at (t.data) 1) 22000
      & gpu-probe-near (list-at (t.data) 2) 43000
      & gpu-probe-near (list-at (t.data) 3) 50000
      then "GPU Bridge: serving (2x2 matmul verified)"
    else "GPU Bridge: wrong arithmetic (" & show (list-at (t.data) 0) & " "
      & show (list-at (t.data) 1) & " " & show (list-at (t.data) 2) & " "
      & show (list-at (t.data) 3) & ")"

