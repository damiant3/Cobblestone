 We say:

Section: Agent State

  AgentManifest = record {
    name : Text,
    version : Text,
    author-key : Text,
    cdx-hash : Text,
    capabilities : List Text,
    gpu-required : Boolean
  }

  AgentStatus =
    | AgentReady
    | AgentRunning
    | AgentStopped
    | AgentError (Text)

  AgentState = record {
    manifest : AgentManifest,
    status : AgentStatus,
    runtime : AgentRuntimeState,
    coordinator : CoordinatorState,
    process-id : Integer,
    output-buffer : List Text
  }

  agent-state-new : AgentManifest, RoleConfig -> AgentState
  agent-state-new (m) (role) = AgentState {
    manifest = m,
    status = AgentReady,
    runtime = runtime-init,
    coordinator = coordinator-init role,
    process-id = 0,
    output-buffer = []
  }

Section: Agent Registry

  AgentRegistry = record {
    agents : HamtMap AgentState,
    count : Integer
  }

  agent-registry-empty : AgentRegistry = AgentRegistry { agents = hamt-empty, count = 0 }

  agent-register : AgentRegistry, AgentManifest, RoleConfig -> AgentRegistry
  agent-register (reg) (m) (role) =
    if hamt-contains (reg.agents) (m.name) then reg
    else AgentRegistry {
      agents = hamt-set (reg.agents) (m.name) (agent-state-new m role),
      count = reg.count + 1
    }

  agent-lookup : AgentRegistry, Text -> Maybe AgentState
  agent-lookup (reg) (name) = hamt-get (reg.agents) name

  agent-names : AgentRegistry -> List Text
  agent-names (reg) =
    let es = hamt-to-list (reg.agents)
    in agent-name-loop es 0 (list-length es) []

  agent-name-loop : List (HamtEntry AgentState), Integer, Integer, List Text -> List Text
  agent-name-loop (es) (i) (n) (acc) =
    if i >= n then acc
    else agent-name-loop es (i + 1) n (list-push acc ((list-at es i).key))

  agent-switch-role : AgentRegistry, Text, RoleConfig -> AgentRegistry
  agent-switch-role (reg) (name) (role) =
    when hamt-get (reg.agents) name
      is None -> reg
      is Just (a) ->
        let moved = __record-set a "coordinator" (coordinator-switch-role (a.coordinator) role)
        in __record-set reg "agents" (hamt-set (reg.agents) name moved)

Section: Role Selection

  role-config-for-key : Text -> Maybe RoleConfig
  role-config-for-key (key) =
    if key == "dev" then Just dev-console-role
    else if key == "ui" then Just ui-assist-role
    else if key == "build" then Just build-watch-role
    else if key == "review" then Just code-review-role
    else if key == "general" then Just general-role
    else None

