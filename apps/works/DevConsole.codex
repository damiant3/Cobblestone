 UEFI dev console. Hold a key during boot to enter. Menu-driven
 interface with code browser, editor, compiler, test runner,
 debugger, agent manager, hypervisor, and UI launcher. Runs on
 UEFI console I/O (ConOut/ConIn).

 We say:

Section: Console Mode

  ConsoleMode =
    | ModeMainMenu
    | ModeBrowse
    | ModeViewSource
    | ModeSearch
    | ModeEdit
    | ModeCompile
    | ModeSweep
    | ModeDebug
    | ModeVerify
    | ModeAnnotations
    | ModeAgent
    | ModeHypervisor
    | ModeUiLaunch
    | ModeDriveManager
    | ModeIdentity
    | ModeSystemInfo

Section: Console State

  DevConsoleState = record {
    mode : ConsoleMode,
    source-index : SourceIndex,
    console : UefiConsoleState,
    menu : MenuState,
    search-query : Text,
    search-results : List SearchResult,
    editor : Maybe EditorState,
    debugger : DebuggerState,
    undo-stack : UndoStack,
    redo-stack : UndoStack,
    view-scroll : Integer,
    view-chapter-idx : Integer,
    status : Text,
    running : Boolean,
    ann-persist : AnnotationPersistState,
    disk-store : DiskFactStore,
    agents : AgentRegistry
  }

  dev-console-init : UefiConsoleState, DiskFactStore, Keypair -> DevConsoleState
  dev-console-init (con) (disk) (kp) =
    let ann-st = persist-driver-init kp disk
    in DevConsoleState {
      mode = ModeMainMenu,
      source-index = empty-source-index,
      console = con,
      menu = main-menu,
      search-query = "",
      search-results = [],
      editor = None,
      debugger = debugger-init,
      undo-stack = undo-stack-new 50,
      redo-stack = undo-stack-new 50,
      view-scroll = 0,
      view-chapter-idx = 0,
      status = "Cobblestone Dev Console",
      running = True,
      ann-persist = ann-st,
      disk-store = disk,
      agents = agent-registry-empty
    }

