Section: Annotation Dispatch

  dispatch-annotations-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-annotations-menu (key) (state) =
    if key == "facts" then
      let result = cmd-facts (state.ann-persist)
      in __record-set (__record-set state "ann-persist" (result.state)) "status" (result.output)
    else if key == "log" then
      let result = cmd-log (state.ann-persist)
      in __record-set (__record-set state "ann-persist" (result.state)) "status" (result.output)
    else if key == "checkpoint" then
      let result = cmd-checkpoint (state.ann-persist)
      in __record-set (__record-set state "ann-persist" (result.state)) "status" (result.output)
    else if key == "ann-status" then
      let status = persist-status-line (state.ann-persist) (editor-state-or-default state)
      in __record-set state "status" status
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

  editor-state-or-default : DevConsoleState -> EditorState
  editor-state-or-default (state) =
    when state.editor
      is Just (e) -> e
      is None -> editor-empty

Section: Menu Dispatch

  dispatch-main-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-main-menu (key) (state) =
    if key == "browse" then
      let bm = browse-menu (state.source-index.chapter-names)
      in __record-set (__record-set (__record-set state "mode" ModeBrowse) "menu" bm) "status" ("Source: " & show (list-length (state.source-index.chapter-names)) & " chapters")
    else if key == "search" then __record-set (__record-set state "mode" ModeSearch) "status" "Enter search query:"
    else if key == "edit" then __record-set (__record-set state "mode" ModeEdit) "status" "Enter file path:"
    else if key == "compile" then __record-set (__record-set (__record-set state "mode" ModeCompile) "menu" compile-menu) "status" "Select compile target"
    else if key == "sweep" then __record-set (__record-set (__record-set state "mode" ModeSweep) "menu" sweep-menu) "status" "Test runner"
    else if key == "verify" then __record-set (__record-set state "mode" ModeVerify) "status" "Verifying seed..."
    else if key == "debug" then __record-set (__record-set (__record-set state "mode" ModeDebug) "menu" debug-menu) "status" "Debugger"
    else if key == "annotations" then __record-set (__record-set (__record-set state "mode" ModeAnnotations) "menu" annotations-menu) "status" "Annotations"
    else if key == "agent" then __record-set (__record-set (__record-set state "mode" ModeAgent) "menu" agent-menu) "status" "Agent Manager"
    else if key == "drives" then __record-set (__record-set (__record-set state "mode" ModeDriveManager) "menu" drive-manager-menu) "status" "Drive Manager"
    else if key == "identity" then __record-set (__record-set (__record-set state "mode" ModeIdentity) "menu" identity-menu) "status" "Identity"
    else if key == "vm" then __record-set (__record-set (__record-set state "mode" ModeHypervisor) "menu" hypervisor-menu) "status" "Hypervisor"
    else if key == "ui" then __record-set (__record-set (__record-set state "mode" ModeUiLaunch) "menu" ui-launcher-menu) "status" "UI Launcher"
    else if key == "info" then __record-set (__record-set state "mode" ModeSystemInfo) "status" "System Information"
    else if key == "boot" then __record-set state "running" False
    else state

Section: Debugger Dispatch

  dispatch-debug-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-debug-menu (key) (state) =
    if key == "mem" then
      let lines = debug-mem-dump (state.debugger) (state.debugger.last-address) (state.debugger.dump-length)
      in __record-set (__record-set state "status" ("Memory @ 0x" & hex-i64 (state.debugger.last-address))) "search-results" []
    else if key == "io" then
      let dbg = __record-set (state.debugger) "mode" DebugIO
      in __record-set (__record-set state "debugger" dbg) "status" "Port I/O watch"
    else if key == "bp" then
      let dbg = __record-set (state.debugger) "mode" DebugBreakpoints
      in __record-set (__record-set state "debugger" dbg) "status" ("Breakpoints: " & show (list-length (state.debugger.breakpoints.entries)))
    else if key == "bp-add" then __record-set state "status" "Enter function name:"
    else if key == "stack" then
      let dbg = __record-set (state.debugger) "mode" DebugStack
      in __record-set (__record-set state "debugger" dbg) "status" "Backtrace"
    else if key == "bt" then
      let dbg = __record-set (state.debugger) "mode" DebugStack
      in __record-set (__record-set state "debugger" dbg) "status" "Backtrace"
    else if key == "perf" then
      let dbg = __record-set (state.debugger) "mode" DebugPerf
      in __record-set (__record-set state "debugger" dbg) "status" "Perf counters"
    else if key == "sym" then __record-set state "status" "Enter symbol name:"
    else if key == "addr" then __record-set state "status" "Enter address (hex):"
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

  render-debug-view : DevConsoleState -> [Device.Port] List Text
  render-debug-view (state) =
    let dbg = state.debugger
    in when dbg.mode
      is DebugMemory -> debug-mem-dump dbg (dbg.last-address) (dbg.dump-length)
      is DebugIO -> debug-port-watch (dbg.watch-ports)
      is DebugBreakpoints -> bp-list-text (dbg.breakpoints)
      is DebugStack -> debug-backtrace-from-stall dbg
      is DebugPerf -> debug-perf-view
      is DebugRegisters -> debug-register-view
      is DebugDisk -> dbg.disk-lines
      is DebugReport -> dbg.report-lines

  render-breakpoint-list : List Breakpoint, Integer, Integer, List Text -> List Text
  render-breakpoint-list (bps) (i) (len) (acc) =
    if i >= len then if len == 0 then ["  (no breakpoints set)"] else acc
    else let bp = list-at bps i
    in let en = if bp.enabled then "ON " else "OFF"
    in let line = "  #" & show (bp.id) & " " & en & " 0x" & hex-i64 (bp.address) & " hits=" & show (bp.hit-count) & " " & bp.label
    in render-breakpoint-list bps (i + 1) len (list-push acc line)

Section: Compile Dispatch

  dispatch-compile-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-compile-menu (key) (state) =
    if key == "cdx" then __record-set state "status" "Enter source path (CDX output):"
    else if key == "elf" then __record-set state "status" "Enter source path (ELF output):"
    else if key == "efi" then __record-set state "status" "Enter source path (EFI output):"
    else if key == "img" then __record-set state "status" "Building disk image..."
    else if key == "pingpong" then __record-set state "status" "Starting self-compile (pingpong)..."
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

Section: Sweep Dispatch

  dispatch-sweep-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-sweep-menu (key) (state) =
    if key == "all" then __record-set state "status" "Running all samples..."
    else if key == "single" then __record-set state "status" "Enter sample name:"
    else if key == "failing" then __record-set state "status" "Running failing samples..."
    else if key == "results" then __record-set state "status" "Last results:"
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

Section: Agent Dispatch

 The registry lives in the console state rather than in a global, so
 registering an agent is a state transition like any other and the whole
 dispatch stays a function from state to state.

  dispatch-agent-menu : Text, DevConsoleState -> [Device.Block] DevConsoleState
  dispatch-agent-menu (key) (state) =
    if state.menu.title == role-switch-title then dispatch-role-key key state
    else if key == "load" then agent-do-load state
    else if key == "status" then __record-set state "status" (agent-status-text state)
    else if key == "list" then __record-set state "status" (format-agent-registry (state.agents))
    else if key == "role" then __record-set (__record-set state "menu" role-switch-menu) "status" "Select role"
    else if key == "gpu" then __record-set state "status" (agent-gpu-probe gpu-bridge-init)
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

 Loading is the bundled path and only the bundled path. It asks
 `verify-bundled-agent`, which is the signature-then-digest-then-format
 chain in `Works chapter AgentBundle`, and registers nothing when that
 chain refuses. The refusal is reported with the reason the chain gave,
 because "could not load agent" would hide which link broke, and which
 link broke is the whole content of the answer.

  agent-do-load : DevConsoleState -> [Device.Block] DevConsoleState
  agent-do-load (state) = act
    v <- verify-bundled-agent
    when v
      is PackageInvalid (why) -> __record-set state "status" ("Agent refused: " & why)
      is PackageValid (pkg) -> agent-do-register state pkg
  end

  agent-do-register : DevConsoleState, AgentPackage -> DevConsoleState
  agent-do-register (state) (pkg) =
    let reg = agent-register (state.agents) (pkg.manifest) dev-console-role
    in let note = "Registered " & pkg.manifest.name & " v" & pkg.manifest.version & " (" & show (reg.count) & " in registry)"
    in let s = __record-set state "agents" reg
    in __record-set s "status" note

  agent-status-text : DevConsoleState -> Text
  agent-status-text (state) =
    let names = agent-names (state.agents)
    in if list-length names == 0 then "Agent: none registered (Load Agent reads the boot image)"
    else when agent-lookup (state.agents) (list-at names 0)
      is None -> "Agent: registry disagrees with itself"
      is Just (a) -> format-agent-info a

  dispatch-role-key : Text, DevConsoleState -> DevConsoleState
  dispatch-role-key (key) (state) =
    if key == "back" then __record-set (__record-set state "menu" agent-menu) "status" "Agent Manager"
    else when role-config-for-key key
      is None -> state
      is Just (rc) -> agent-do-switch-role state rc

  agent-do-switch-role : DevConsoleState, RoleConfig -> DevConsoleState
  agent-do-switch-role (state) (rc) =
    let names = agent-names (state.agents)
    in let back = __record-set state "menu" agent-menu
    in if list-length names == 0 then __record-set back "status" "No agent registered; role not switched"
    else let name = list-at names 0
    in let reg = agent-switch-role (state.agents) name rc
    in let s = __record-set back "agents" reg
    in __record-set s "status" (name & " role -> " & agent-role-label (rc.role))

Section: Hypervisor Dispatch

  dispatch-hypervisor-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-hypervisor-menu (key) (state) =
    if key == "vmx-init" then __record-set state "status" "VMX init: checking CPU support..."
    else if key == "vmx-launch" then __record-set state "status" "Launching HLT guest..."
    else if key == "vmx-serial" then __record-set state "status" "Launching serial guest..."
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

Section: UI Launcher Dispatch

  dispatch-ui-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-ui-menu (key) (state) =
    if key == "auto" then __record-set state "status" "Launching UI (auto resolution)..."
    else if key == "1080p" then __record-set state "status" "Launching UI (1920x1080)..."
    else if key == "720p" then __record-set state "status" "Launching UI (1280x720)..."
    else if key == "xga" then __record-set state "status" "Launching UI (1024x768)..."
    else if key == "list-modes" then __record-set state "status" "Querying GOP modes..."
    else if key == "back" then __record-set (__record-set (__record-set state "mode" ModeMainMenu) "menu" main-menu) "status" "Cobblestone Dev Console"
    else state

Section: Search Interface

  dev-console-search : DevConsoleState, Text -> DevConsoleState
  dev-console-search (state) (query) =
    let prefix-results = search-by-prefix (state.source-index) query
    in let sub-results = if list-length prefix-results > 0 then prefix-results
      else search-by-substring (state.source-index) query
    in let result-count = list-length sub-results
    in __record-set (__record-set (__record-set state "search-query" query) "search-results" sub-results) "status" (show result-count & " results for '" & query & "'")

Section: Rendering

  render-dev-console : DevConsoleState -> [Device.Port] List Text
  render-dev-console (state) =
    let header = ["", "  Cobblestone Dev Console", "  " & state.status, ""]
    in when state.mode
      is ModeMainMenu -> header & render-menu (state.menu)
      is ModeBrowse -> header & render-menu (state.menu)
      is ModeViewSource -> header & ["  (source viewer -- see draw-console-screen)"]
      is ModeSearch ->
        let result-lines = for r in (state.search-results) -> "  " & format-search-result r
        in header & ["  Search: " & state.search-query, ""] & result-lines
      is ModeCompile -> header & render-menu (state.menu)
      is ModeSweep -> header & render-menu (state.menu)
      is ModeDebug -> header & render-menu (state.menu) & [""] & render-debug-view state
      is ModeAgent -> header & render-menu (state.menu)
      is ModeHypervisor -> header & render-menu (state.menu)
      is ModeUiLaunch -> header & render-menu (state.menu)
      is ModeEdit -> header & render-editor-view state
      is ModeVerify -> header & ["  Verify Seed Integrity", ""] & render-menu (state.menu)
      is ModeAnnotations -> header & render-menu (state.menu) & ["", "  " & persist-status-line (state.ann-persist) (editor-state-or-default state)]
      is ModeDriveManager -> header & ["  Drive Manager", ""] & render-menu (state.menu)
      is ModeIdentity -> header & ["  Identity", ""] & render-menu (state.menu)
      is ModeSystemInfo -> header & ["  System Info", ""] & render-menu (state.menu)

  render-editor-view : DevConsoleState -> List Text
  render-editor-view (state) =
    when state.editor
      is Just (e) -> ["  Editing: " & e.file-path, "  " & editor-status-line e, ""] & editor-visible-lines e
      is None -> ["  No file open. Select a chapter to edit."]

