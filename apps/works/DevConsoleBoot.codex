 Boot-time entry point for the UEFI dev console. The UEFI stub
 checks for a held key (Escape or F12) during the first second
 of boot. If detected, enters the dev console. Otherwise proceeds
 to normal Codex boot (compiler REPL on serial).

 We say:

 Boot sequence:
   1. UEFI loads BOOTX64.EFI
   2. PE stub prints "Codex UEFI Boot"
   3. Check ConIn for held key (500ms poll)
   4. Key held -> index source tree, enter dev console
   5. No key -> jump to __start (bare-metal compiler)

Section: Boot Key Detection

  uefi-partition-start : Integer = 2048

  BootKeyResult =
    | BootKeyHeld (UefiKey)
    | BootKeyNone

  check-boot-key-held : Integer -> BootKeyResult
  check-boot-key-held (poll-count) =
    if poll-count <= 0 then BootKeyNone
    else BootKeyNone

Section: Source Tree Indexing

  index-compiler-source : Text -> SourceIndex
  index-compiler-source (codex-dir) =
    let idx = empty-source-index
    in let idx2 = index-known-chapter idx "Lexer" compiler-lexer-lines
    in let idx3 = index-known-chapter idx2 "Parser" compiler-parser-lines
    in let idx4 = index-known-chapter idx3 "TypeChecker" compiler-typechecker-lines
    in let idx5 = index-known-chapter idx4 "IrGen" compiler-irgen-lines
    in let idx6 = index-known-chapter idx5 "Codegen" compiler-codegen-lines
    in let idx7 = index-known-chapter idx6 "Emitter" compiler-emitter-lines
    in idx7

  index-full-dev-surface : SourceIndex
  index-full-dev-surface =
    let idx = index-compiler-source "codex/compiler"
    in let idx2 = index-known-chapter idx "List" foreword-list-lines
    in let idx3 = index-known-chapter idx2 "Maybe" foreword-maybe-lines
    in let idx4 = index-known-chapter idx3 "Text" foreword-text-lines
    in let idx5 = index-known-chapter idx4 "Console" foreword-console-lines
    in let idx6 = index-known-chapter idx5 "DevConsole" app-devconsole-lines
    in let idx7 = index-known-chapter idx6 "Explorer" app-explorer-lines
    in let idx8 = index-known-chapter idx7 "Market" app-market-lines
    in let idx9 = index-known-chapter idx8 "ERP" app-erp-lines
    in idx9

  index-dir-source : SourceIndex, Text -> SourceIndex
  index-dir-source (idx) (dir) = idx

  index-known-chapter : SourceIndex, Text, List Text -> SourceIndex
  index-known-chapter (idx) (name) (lines) =
    let start = idx.source-line-count
    in let line-count = list-length lines
    in let idx2 = SourceIndex {
      name-trie = idx.name-trie,
      locations = idx.locations,
      chapter-names = list-push (idx.chapter-names) name,
      chapter-starts = list-push (idx.chapter-starts) start,
      source-lines = idx.source-lines & lines,
      source-line-count = start + line-count,
      total-defs = idx.total-defs
    }
    in scan-lines-for-defs idx2 name lines 0 line-count start

  scan-lines-for-defs : SourceIndex, Text, List Text, Integer, Integer, Integer -> SourceIndex
  scan-lines-for-defs (idx) (chapter) (lines) (i) (len) (base) =
    if i >= len then idx
    else let line = list-at lines i
    in let idx2 = try-index-def idx chapter line (base + i)
    in scan-lines-for-defs idx2 chapter lines (i + 1) len base

  try-index-def : SourceIndex, Text, Text, Integer -> SourceIndex
  try-index-def (idx) (chapter) (line) (line-num) =
    if text-starts-with line "  " then
      if text-contains line " : " then
        let name = extract-first-word line
        in if text-length name > 0 then
          index-add-def idx (DefLocation { chapter = chapter, name = name, line = line-num, kind = DefFunction })
        else idx
      else idx
    else if text-starts-with line "Section: " then
      let sec-name = substring line 9 (text-length line - 9)
      in index-add-def idx (DefLocation { chapter = chapter, name = sec-name, line = line-num, kind = DefSection })
    else idx

  extract-first-word : Text -> Text
  extract-first-word (line) =
    let trimmed = text-trim line
    in let sp = text-index-of trimmed " "
    in if sp < 0 then trimmed
    else substring trimmed 0 sp

