 We say:

Section: Console State

  UefiConsoleState = record {
    sys-table : Integer,
    con-out : Integer,
    con-in : Integer,
    rows : Integer,
    cols : Integer,
    cursor-row : Integer,
    cursor-col : Integer
  }

  uefi-console-init : Integer -> UefiConsoleState
  uefi-console-init (sys-table) =
    UefiConsoleState {
      sys-table = sys-table,
      con-out = peek-qword sys-table 64,
      con-in = peek-qword sys-table 48,
      rows = 25,
      cols = 80,
      cursor-row = 0,
      cursor-col = 0
    }

Section: Text Attributes

  UefiColor =
    | UefiBlack
    | UefiBlue
    | UefiGreen
    | UefiCyan
    | UefiRed
    | UefiMagenta
    | UefiBrown
    | UefiLightGray
    | UefiDarkGray
    | UefiLightBlue
    | UefiLightGreen
    | UefiLightCyan
    | UefiLightRed
    | UefiLightMagenta
    | UefiYellow
    | UefiWhite

  uefi-color-code : UefiColor -> Integer
  uefi-color-code (c) = when c
    is UefiBlack -> 0
    is UefiBlue -> 1
    is UefiGreen -> 2
    is UefiCyan -> 3
    is UefiRed -> 4
    is UefiMagenta -> 5
    is UefiBrown -> 6
    is UefiLightGray -> 7
    is UefiDarkGray -> 8
    is UefiLightBlue -> 9
    is UefiLightGreen -> 10
    is UefiLightCyan -> 11
    is UefiLightRed -> 12
    is UefiLightMagenta -> 13
    is UefiYellow -> 14
    is UefiWhite -> 15

  uefi-attr : UefiColor, UefiColor -> Integer
  uefi-attr (fg) (bg) = bit-or (uefi-color-code fg) (bit-shl (uefi-color-code bg) 4)

