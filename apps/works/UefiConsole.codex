Section: Key Input

  UefiKey = record {
    scan-code : Integer,
    char-code : Integer,
    shift-state : Integer
  }

  uefi-key-is-char : UefiKey -> Boolean
  uefi-key-is-char (k) =
    if k.char-code <= 0 then False
    else if key-is-named (k.char-code) then False
    else True

  uefi-key-is-enter : UefiKey -> Boolean
  uefi-key-is-enter (k) = k.char-code == key-enter

  uefi-key-is-backspace : UefiKey -> Boolean
  uefi-key-is-backspace (k) = k.char-code == key-backspace

  uefi-key-is-escape : UefiKey -> Boolean
  uefi-key-is-escape (k) = k.char-code == key-escape

  uefi-key-is-tab : UefiKey -> Boolean
  uefi-key-is-tab (k) = k.char-code == key-tab

  uefi-key-is-arrow-up : UefiKey -> Boolean
  uefi-key-is-arrow-up (k) = k.char-code == key-up

  uefi-key-is-arrow-down : UefiKey -> Boolean
  uefi-key-is-arrow-down (k) = k.char-code == key-down

Section: Shift State

  uefi-shift-valid : Integer = 2147483648
  uefi-right-shift : Integer = 1
  uefi-left-shift : Integer = 2
  uefi-right-ctrl : Integer = 4
  uefi-left-ctrl : Integer = 8
  uefi-right-alt : Integer = 16
  uefi-left-alt : Integer = 32
  uefi-right-logo : Integer = 64
  uefi-left-logo : Integer = 128
  uefi-menu-key : Integer = 256
  uefi-sysreq : Integer = 512
  uefi-any-shift : Integer = 3
  uefi-any-ctrl : Integer = 12
  uefi-any-alt : Integer = 48
  uefi-any-logo : Integer = 192

Section: Modifier Predicates

  uefi-key-has-shift : UefiKey -> Boolean
  uefi-key-has-shift (k) = bit-and (k.shift-state) mod-shift > 0

  uefi-key-has-ctrl : UefiKey -> Boolean
  uefi-key-has-ctrl (k) = bit-and (k.shift-state) mod-ctrl > 0

  uefi-key-has-alt : UefiKey -> Boolean
  uefi-key-has-alt (k) = bit-and (k.shift-state) mod-alt > 0

  uefi-key-has-logo : UefiKey -> Boolean
  uefi-key-has-logo (k) = bit-and (k.shift-state) uefi-any-logo > 0

  uefi-key-shift-valid : UefiKey -> Boolean
  uefi-key-shift-valid (k) = bit-and (k.shift-state) uefi-shift-valid > 0

Section: Key Predicates

  uefi-key-is-arrow-left : UefiKey -> Boolean
  uefi-key-is-arrow-left (k) = k.char-code == key-left

  uefi-key-is-arrow-right : UefiKey -> Boolean
  uefi-key-is-arrow-right (k) = k.char-code == key-right

  uefi-key-is-home : UefiKey -> Boolean
  uefi-key-is-home (k) = k.char-code == key-home

  uefi-key-is-end : UefiKey -> Boolean
  uefi-key-is-end (k) = k.char-code == key-end

  uefi-key-is-insert : UefiKey -> Boolean
  uefi-key-is-insert (k) = False

  uefi-key-is-delete : UefiKey -> Boolean
  uefi-key-is-delete (k) = k.char-code == key-delete

  uefi-key-is-page-up : UefiKey -> Boolean
  uefi-key-is-page-up (k) = k.char-code == key-pgup

  uefi-key-is-page-down : UefiKey -> Boolean
  uefi-key-is-page-down (k) = k.char-code == key-pgdn

  uefi-key-char : UefiKey -> Integer
  uefi-key-char (k) = k.char-code

Section: Combo Predicates

  uefi-key-is-ctrl-alt-del : UefiKey -> Boolean
  uefi-key-is-ctrl-alt-del (k) =
    if uefi-key-shift-valid k == False then False
    else if uefi-key-has-ctrl k == False then False
    else if uefi-key-has-alt k == False then False
    else k.char-code == key-delete

  uefi-key-is-ctrl-c : UefiKey -> Boolean
  uefi-key-is-ctrl-c (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'C'

  uefi-key-is-ctrl-s : UefiKey -> Boolean
  uefi-key-is-ctrl-s (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'S'

  uefi-key-is-ctrl-z : UefiKey -> Boolean
  uefi-key-is-ctrl-z (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'Z'

  uefi-key-is-ctrl-f : UefiKey -> Boolean
  uefi-key-is-ctrl-f (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'F'

  uefi-key-is-ctrl-g : UefiKey -> Boolean
  uefi-key-is-ctrl-g (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'G'

  uefi-key-is-ctrl-y : UefiKey -> Boolean
  uefi-key-is-ctrl-y (k) =
    if uefi-key-has-ctrl k == False then False
    else key-upper (k.char-code) == char-code 'Y'

Section: Pointer Input

  UefiPointerState = record {
    rel-x : Integer,
    rel-y : Integer,
    rel-z : Integer,
    left-button : Boolean,
    right-button : Boolean
  }

  uefi-pointer-no-movement : UefiPointerState -> Boolean
  uefi-pointer-no-movement (p) =
    if p.rel-x == 0 then
      if p.rel-y == 0 then p.rel-z == 0 else False
    else False

  uefi-pointer-any-button : UefiPointerState -> Boolean
  uefi-pointer-any-button (p) =
    if p.left-button then True else p.right-button

  UefiAbsPointerState = record {
    abs-x : Integer,
    abs-y : Integer,
    abs-z : Integer,
    active-buttons : Integer
  }

Section: Graphics Output

  UefiGopMode = record {
    max-mode : Integer,
    current-mode : Integer,
    fb-base : Integer,
    fb-size : Integer,
    h-resolution : Integer,
    v-resolution : Integer,
    pixels-per-scanline : Integer
  }

  UefiPixel = record {
    blue : Integer,
    green : Integer,
    red : Integer,
    reserved : Integer
  }

  uefi-pixel : Integer, Integer, Integer -> UefiPixel
  uefi-pixel (r) (g) (b) = UefiPixel { blue = b, green = g, red = r, reserved = 0 }

  uefi-pixel-pack : UefiPixel -> Integer
  uefi-pixel-pack (p) =
    bit-or (bit-or (p.blue) (bit-shl (p.green) 8)) (bit-or (bit-shl (p.red) 16) (bit-shl (p.reserved) 24))

Section: Network

  UefiNetState = record {
    mac-addr : List Integer,
    media-present : Boolean,
    started : Boolean,
    initialized : Boolean
  }

  UefiNetPacket = record {
    data : List Integer,
    length : Integer,
    src-mac : List Integer,
    dst-mac : List Integer,
    ethertype : Integer
  }

Section: The GOP Console

 After ExitBootServices the firmware console is gone, and the boot payload
 draws the same 80 by 25 cell grid into the GOP framebuffer instead. The
 block lives at 0x1E000, inside the free hole between the xHCI diagnostic
 block and the GOP handoff block that `GopXhci` maps, and metal does not
 clear that hole; therefore the grid is on only when offset 0 holds the
 magic "GTC1". Offsets 4 and 8 are the framebuffer base as two 32-bit
 halves, 12 the width, 16 the height, 20 the stride in pixels. The sixteen
 colours are the EFI text attribute colours the UEFI specification numbers
 0 to 15. Offsets 24 and 28 are the key ring's read and write counts, 32 the
 keys a full ring dropped, and 64 up the 32 slots: one writer advances 28
 after the slot is stored, one reader advances 24. Offset 56 counts the
 reader's yields: on one core the boot process that feeds the ring runs only
 when the reader yields.

  ugc-block : Integer = 122880
  ugc-magic : Integer = #47544331
  ugc-cols : Integer = 80
  ugc-rows : Integer = 25

  ugc-on : Integer -> Boolean
  ugc-on (dummy) = peek-32 ugc-block 0 == ugc-magic

  ugc-enable : Integer, Integer, Integer, Integer -> Integer
  ugc-enable (base) (w) (h) (stride) =
    let a = poke-32 ugc-block 4 (bit-and base 4294967295)
    in let b = poke-32 ugc-block 8 (bit-shru base 32)
    in let c = poke-32 ugc-block 12 w
    in let d = poke-32 ugc-block 16 h
    in let e = poke-32 ugc-block 20 stride
    in let rh = poke-32 ugc-block 24 0
    in let rt = poke-32 ugc-block 28 0
    in let rd = poke-32 ugc-block 32 0
    in let ry = poke-32 ugc-block 56 0
    in let m = poke-32 ugc-block 0 ugc-magic
    in ugc-clear 0

  ugc-disable : Integer -> Integer
  ugc-disable (dummy) = poke-32 ugc-block 0 0

  ugc-ring-n : Integer = 32

  ugc-drops : Integer -> Integer
  ugc-drops (dummy) = peek-32 ugc-block 32

  ugc-key-push : Integer -> Integer
  ugc-key-push (k) =
    let head = peek-32 ugc-block 24
    in let tail = peek-32 ugc-block 28
    in if tail - head >= ugc-ring-n then poke-32 ugc-block 32 (peek-32 ugc-block 32 + 1)
    else let s = poke-32 ugc-block (64 + 4 * int-mod tail ugc-ring-n) k
    in poke-32 ugc-block 28 (tail + 1)

  ugc-key-pop : Integer -> Integer
  ugc-key-pop (dummy) =
    let head = peek-32 ugc-block 24
    in if head == peek-32 ugc-block 28 then 0
    else let k = peek-32 ugc-block (64 + 4 * int-mod head ugc-ring-n)
    in let a = poke-32 ugc-block 24 (head + 1)
    in k

  ugc-yield : [Concurrent] Integer
  ugc-yield =
    if ugc-on 0 then
      let n = poke-32 ugc-block 56 (peek-32 ugc-block 56 + 1)
      in process-yield
    else 0

  ugc-yields : Integer -> Integer
  ugc-yields (dummy) = peek-32 ugc-block 56

  ugc-key-feed : Integer -> Integer
  ugc-key-feed (sc) =
    let k = poll-key-decode sc (atomic-load kbd-mod-addr)
    in if k == 0 then 0 else ugc-key-push k

  ugc-base : Integer -> Integer
  ugc-base (dummy) = peek-32 ugc-block 4 + peek-32 ugc-block 8 * 4294967296

  ugc-w : Integer -> Integer
  ugc-w (dummy) = peek-32 ugc-block 12

  ugc-h : Integer -> Integer
  ugc-h (dummy) = peek-32 ugc-block 16

  ugc-stride : Integer -> Integer
  ugc-stride (dummy) = peek-32 ugc-block 20

  ugc-scale : Integer -> Integer
  ugc-scale (dummy) = ui-scale (ugc-w 0)

  ugc-rgb : Integer -> Integer
  ugc-rgb (c) =
    if c == 0 then #000000 else if c == 1 then #0000AA else if c == 2 then #00AA00
    else if c == 3 then #00AAAA else if c == 4 then #AA0000 else if c == 5 then #AA00AA
    else if c == 6 then #AA5500 else if c == 7 then #AAAAAA else if c == 8 then #555555
    else if c == 9 then #5555FF else if c == 10 then #55FF55 else if c == 11 then #55FFFF
    else if c == 12 then #FF5555 else if c == 13 then #FF55FF else if c == 14 then #FFFF55
    else #FFFFFF

  ugc-fill : Integer, Integer, Integer, Integer -> Integer
  ugc-fill (row) (col) (n) (bg) =
    let s = ugc-scale 0
    in gop-fill-rect (ugc-base 0) (ugc-stride 0) (ugc-h 0) (col * 8 * s) (row * 16 * s) (n * 8 * s) (16 * s) (ugc-rgb bg)

  ugc-put : Integer, Integer, Text, Integer, Integer -> Integer
  ugc-put (row) (col) (txt) (fg) (bg) =
    let mark = __heap-save
    in let s = ugc-scale 0
    in let n = math-min (text-length txt) (ugc-cols - col)
    in let f = ugc-fill row col n bg
    in let t = if n <= 0 then 0 else gop-draw-text (ugc-base 0) (ugc-stride 0) (ugc-h 0) cbf-init (col * 8 * s) (row * 16 * s) (substring txt 0 n) (ugc-rgb fg) s 0
    in let r = __heap-restore mark
    in t

  ugc-clear : Integer -> Integer
  ugc-clear (dummy) = gop-fill-rect (ugc-base 0) (ugc-stride 0) (ugc-h 0) 0 0 (ugc-w 0) (ugc-h 0) (ugc-rgb 0)

Section: Console Operations

  uefi-con-set-attr : Integer, Integer -> Integer
  uefi-con-set-attr (fg) (bg) = if ugc-on 0 then 0 else uefi-set-attr (bit-or fg (bit-shl bg 4))

  uefi-con-clear : Integer
  uefi-con-clear = if ugc-on 0 then ugc-clear 0 else uefi-clear-screen

  uefi-con-move : Integer, Integer -> Integer
  uefi-con-move (col) (row) = if ugc-on 0 then 0 else uefi-set-cursor col row

  uefi-con-hide-cursor : Integer
  uefi-con-hide-cursor = if ugc-on 0 then 0 else uefi-enable-cursor 0

  uefi-con-show-cursor : Integer
  uefi-con-show-cursor = if ugc-on 0 then 0 else uefi-enable-cursor 1

  uefi-con-put-text : Integer, Integer, Text, Integer, Integer -> [Console] Nothing
  uefi-con-put-text (row) (col) (txt) (fg) (bg) =
    if ugc-on 0 then act
      let d = ugc-put row col txt fg bg
      in print-uni ""
    end
    else let w0 = uefi-con-set-attr fg bg
    in let w1 = uefi-con-move col row
    in print-uni txt

  uefi-con-fill-row : Integer, Integer, Integer -> [Console] Nothing
  uefi-con-fill-row (row) (fg) (bg) =
    if ugc-on 0 then act
      let d = ugc-fill row 0 ugc-cols bg
      in print-uni ""
    end
    else let w0 = uefi-con-set-attr fg bg
    in let w1 = uefi-con-move 0 row
    in print-uni "                                                                               "

  uefi-key-of : Integer -> UefiKey
  uefi-key-of (raw) =
    UefiKey {
      scan-code = raw,
      char-code = raw,
      shift-state = bit-or poll-mods uefi-shift-valid
    }

  uefi-con-wait-key-spin : Integer -> UefiKey
  uefi-con-wait-key-spin (n) =
    let raw = if ugc-on 0 then ugc-key-pop 0 else poll-key
    in if raw == 0 then uefi-con-wait-key-spin (n + 1)
    else uefi-key-of raw

  uefi-con-wait-key : UefiKey
  uefi-con-wait-key = uefi-con-wait-key-spin 0

  uefi-con-wait-key-ex-spin : Integer -> UefiKey
  uefi-con-wait-key-ex-spin (n) =
    let raw = if ugc-on 0 then ugc-key-pop 0 else poll-key
    in if raw == 0 then uefi-con-wait-key-ex-spin (n + 1)
    else uefi-key-of raw

  uefi-con-wait-key-ex : UefiKey
  uefi-con-wait-key-ex = uefi-con-wait-key-ex-spin 0

  uefi-con-poll-key : Maybe UefiKey
  uefi-con-poll-key =
    let raw = if ugc-on 0 then ugc-key-pop 0 else poll-key
    in if raw == 0 then None
    else Just (uefi-key-of raw)

