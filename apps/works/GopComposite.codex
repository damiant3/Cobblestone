 The software compositor -- H4b. The guios shell renders its widget
 tree through codex-vm's host rasterizer (a command buffer at MMIO
 0xBE000000 flushed by ports 0x400-0x402), a device no real machine
 has. But the GPU walk only ever emitted axis-aligned filled
 rectangles, and text was always a separate direct-to-framebuffer
 pass -- so the whole pipeline ports to a plain walk of the laid-out
 tree: resolve each node's style from the theme, fill its bounds,
 draw its text, recurse into its children so they paint over their
 parent. Same foreword widget system, same flex layout, same theme
 records; only the final metres of the pipeline change.

 **All seven widget kinds are drawn here as of 2026-08-03.** This handled
 five and answered `otherwise -> 0` for `WkInput` and `WkCustom`, which is
 a widget that lays out, occupies its space, and paints nothing -- the
 shape that reads as a layout bug when it is a missing arm. The two
 arrived when `apps/guios/GopRender.codex` was compared against this one
 during the guios retirement: that chapter drew all seven, against a
 GopBuf through codex-vm's host rasterizer, and is the one being retired.

 We say:

Section: Node Drawing

  comp-text : Integer, Integer, CbfFont, LayoutRect, Integer, Integer, Text, Integer -> Integer
  comp-text (base) (stride) (font) (b) (dx) (dy) (t) (fg) =
    gop-draw-text base stride font (b.lr-x + dx) (b.lr-y + dy) t fg 1 0

  comp-gauge-fill : Integer, Integer, LayoutRect, Integer, Integer, Integer -> Integer
  comp-gauge-fill (base) (stride) (b) (v) (mx) (fg) =
    if mx <= 0 then 0
    else let fw = (b.lr-w) * (if v > mx then mx else v) / mx
    in if fw <= 0 then 0
    else gop-fill-rect base stride (b.lr-x) (b.lr-y) fw (b.lr-h) fg

  comp-fit : Text, Integer -> Text
  comp-fit (t) (cols) =
    if cols <= 0 then ""
    else if text-length t <= cols then t
    else substring t 0 cols

  comp-input : Integer, Integer, CbfFont, LayoutRect, Text, Integer, Integer, Integer -> Integer
  comp-input (base) (stride) (font) (b) (t) (cursor) (fg) (bg) =
    let fill = gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) bg
    in let cols = (b.lr-w - 8) / 8
    in let txt = comp-text base stride font b 4 4 (comp-fit t cols) fg
    in let want = b.lr-x + 4 + cursor * 8
    in let hi = b.lr-x + b.lr-w - 2
    in let cx = if want > hi then hi else want
    in gop-fill-rect base stride cx (b.lr-y + 3) 1 (if b.lr-h > 6 then b.lr-h - 6 else 1) fg

  comp-custom : Integer, Integer, LayoutRect, Text, Integer, Integer -> Integer
  comp-custom (base) (stride) (b) (tag) (fg) (bg) =
    if tag == "event-dot"
    then gop-fill-rect base stride (b.lr-x + b.lr-w / 2 - 3) (b.lr-y + b.lr-h / 2 - 3) 6 6 fg
    else gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) bg

 A node's TONE overrides the style's foreground: `tone-success` paints a
 label green wherever the theme would have painted it plain. It is how
 `StatusBadge` and everything built on it says what it means, and this
 chapter ignored it -- so a badge rendered here was the same colour
 whatever it was reporting, which is the whole content of a badge.
 `theme-tone-fg` falls through to the style's own foreground for
 `tone-none`, so this is not a special case, it is the general one.

  comp-fg : Theme, WidgetNode, WidgetStyle -> Integer
  comp-fg (th) (node) (st) = theme-tone-fg th (node.wn-tone) (st.ws-fg)

  comp-draw-node : Integer, Integer, CbfFont, WidgetNode, Theme -> Integer
  comp-draw-node (base) (stride) (font) (node) (th) =
    let st = widget-resolve-style node th
    in let b = node.wn-bounds
    in let fg = comp-fg th node st
    in when node.wn-kind
      is WkPanel -> gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) (st.ws-bg)
      is WkSeparator -> gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) (st.ws-fg)
      is WkLabel (t) -> comp-text base stride font b 4 3 (comp-fit t ((b.lr-w - 4) / 8)) fg
      is WkButton (t) ->
        let bg = gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) (st.ws-bg)
        in comp-text base stride font b 8 4 (comp-fit t ((b.lr-w - 8) / 8)) fg
      is WkGauge (v) (mx) ->
        let bg = gop-fill-rect base stride (b.lr-x) (b.lr-y) (b.lr-w) (b.lr-h) (st.ws-bg)
        in comp-gauge-fill base stride b v mx fg
      is WkInput (t) (c) -> comp-input base stride font b t c fg (st.ws-bg)
      is WkCustom (tag) -> comp-custom base stride b tag fg (st.ws-bg)
      is otherwise -> 0

Section: Tree Walk

  comp-walk : Integer, Integer, CbfFont, WidgetNode, Theme -> Integer
  comp-walk (base) (stride) (font) (node) (th) =
    let d = comp-draw-node base stride font node th
    in comp-walk-kids base stride font (node.wn-children) th 0

  comp-walk-kids : Integer, Integer, CbfFont, List WidgetNode, Theme, Integer -> Integer
  comp-walk-kids (base) (stride) (font) (kids) (th) (i) =
    if i >= list-length kids then 0
    else let w = comp-walk base stride font (list-at kids i) th
    in comp-walk-kids base stride font kids th (i + 1)

Section: Render

  comp-render : Integer, Integer, CbfFont, WidgetNode, Theme, Integer, Integer -> WidgetNode
  comp-render (base) (stride) (font) (root) (th) (w) (h) =
    let laid = widget-layout root th (layout-rect 0 0 w h)
    in let d = comp-walk base stride font laid th
    in laid
