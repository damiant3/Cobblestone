 We say:

Section: Decoration

  comp-chan : Integer, Integer -> Integer
  comp-chan (c) (sh) = bit-and (bit-shru c sh) 255

  comp-lerp : Integer, Integer, Integer, Integer -> Integer
  comp-lerp (a) (b) (i) (n) =
    if n <= 1 then a
    else let d = n - 1
    in let j = if i > d then d else i
    in let r = (comp-chan a 16 * (d - j) + comp-chan b 16 * j) / d
    in let g = (comp-chan a 8 * (d - j) + comp-chan b 8 * j) / d
    in let bl = (comp-chan a 0 * (d - j) + comp-chan b 0 * j) / d
    in bit-shl r 16 + bit-shl g 8 + bl

  comp-corner-r : CornerStyle -> Integer
  comp-corner-r (c) = when c
    is CornerSharp -> 0
    is CornerRound (r) -> r
    is CornerBevel (r) -> r

  comp-fit-r : CornerStyle, Integer, Integer, Integer -> Integer
  comp-fit-r (c) (w) (h) (s) = math-min (comp-corner-r c * s) (math-min w h / 2)

  comp-corner-ins256 : CornerStyle, Integer, Integer, Integer, Integer -> Integer
  comp-corner-ins256 (c) (w) (h) (y) (s) =
    comp-arc256 c (comp-fit-r c w h s) (2 * math-min y (h - 1 - y))

  comp-arc256 : CornerStyle, Integer, Integer -> Integer
  comp-arc256 (c) (k) (d2) =
    if k <= 0 then 0
    else if d2 >= 2 * k then 0
    else when c
      is CornerSharp -> 0
      is CornerBevel (r) -> (2 * k - d2) * 128
      is CornerRound (r) -> let dy2 = 2 * k - d2 in k * 256 - math-isqrt ((4 * k * k - dy2 * dy2) * 16384)

  comp-arc-cov : CornerStyle, Integer, Integer, Integer -> Integer
  comp-arc-cov (c) (k) (d) (i) =
    let v = (d + 1) * 256 - comp-arc256 c k (2 * i + 1)
    in if v <= 0 then 0 else if v > 255 then 255 else v

  comp-round-run : Integer, Integer, Integer, LayoutRect, LayoutRect, CornerStyle, Integer, Integer, Boolean, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-round-run (base) (stride) (rows) (clip) (r) (c) (c0) (c1) (horiz) (flat) (k) (d) (row) (i) (hi) =
    if i >= hi then 0
    else
      let cov = comp-arc-cov c k d i
      in let lx = r.lr-x + i
      in let rx = r.lr-x + r.lr-w - 1 - i
      in let lc = if horiz then comp-lerp c0 c1 i (r.lr-w) else flat
      in let rc = if horiz then comp-lerp c0 c1 (rx - r.lr-x) (r.lr-w) else flat
      in let a = if cov <= 0 then 0 else comp-blend-px base stride rows clip lx row lc cov
      in let b = if cov <= 0 then 0 else if rx <= lx then 0 else comp-blend-px base stride rows clip rx row rc cov
      in comp-round-run base stride rows clip r c c0 c1 horiz flat k d row (i + 1) hi

Section: The Clip

  comp-fill : Integer, Integer, Integer, LayoutRect, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-fill (base) (stride) (rows) (clip) (px) (py) (pw) (ph) (color) =
    let x0 = math-max px (clip.lr-x)
    in let y0 = math-max py (clip.lr-y)
    in let x1 = math-min (px + pw) (clip.lr-x + clip.lr-w)
    in let y1 = math-min (py + ph) (clip.lr-y + clip.lr-h)
    in if x1 <= x0 then 0
    else if y1 <= y0 then 0
    else gop-fill-rect base stride rows x0 y0 (x1 - x0) (y1 - y0) color

  comp-row-h : Integer, Integer, Integer, LayoutRect, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-row-h (base) (stride) (rows) (clip) (bx) (bw) (y) (x) (xend) (a) (b) =
    if x >= xend then 0
    else let p = if x < clip.lr-x then 0
      else if x >= clip.lr-x + clip.lr-w then 0
      else gop-put base stride rows x y (comp-lerp a b (x - bx) bw)
    in comp-row-h base stride rows clip bx bw y (x + 1) xend a b

  comp-blend-px : Integer, Integer, Integer, LayoutRect, Integer, Integer, Integer, Integer -> Integer
  comp-blend-px (base) (stride) (rows) (clip) (x) (y) (c) (a) =
    if a <= 0 then 0
    else if x < clip.lr-x then 0
    else if x >= clip.lr-x + clip.lr-w then 0
    else if y < clip.lr-y then 0
    else if y >= clip.lr-y + clip.lr-h then 0
    else if a >= 255 then gop-put base stride rows x y c
    else gop-put base stride rows x y (comp-lerp (gop-get base stride rows x y) c a 256)

  comp-rows : Integer, Integer, Integer, LayoutRect, LayoutRect, CornerStyle, Integer, Integer, Boolean, Boolean, Integer, Integer -> Integer
  comp-rows (base) (stride) (rows) (clip) (r) (cs) (c0) (c1) (grad) (horiz) (y) (s) =
    if y >= r.lr-h then 0
    else let k = comp-fit-r cs (r.lr-w) (r.lr-h) s
    in let d = math-min y (r.lr-h - 1 - y)
    in let outer = comp-arc256 cs k (2 * d)
    in let inner = comp-arc256 cs k (2 * d + 2)
    in let hi = (outer + 255) / 256
    in let lo = inner / 256
    in let w = box-clamp0 (r.lr-w - 2 * hi)
    in let x = r.lr-x + hi
    in let flat = if grad then comp-lerp c0 c1 y (r.lr-h) else c0
    in let row = r.lr-y + y
    in let inside = row >= clip.lr-y & row < clip.lr-y + clip.lr-h
    in let one = if w <= 0 then 0 else if inside == False then 0 else if grad & horiz then comp-row-h base stride rows clip (r.lr-x) (r.lr-w) row x (x + w) c0 c1 else comp-fill base stride rows clip x row w 1 flat
    in let e = if inside == False then 0 else comp-round-run base stride rows clip r cs c0 c1 (grad & horiz) flat k d row lo hi
    in comp-rows base stride rows clip r cs c0 c1 grad horiz (y + 1) s

  comp-border-box : LayoutRect, WidgetStyle -> LayoutRect
  comp-border-box (b) (st) =
    let m = st.ws-margin
    in let bw = box-clamp0 (b.lr-w - edges-h m)
    in let bh = box-clamp0 (b.lr-h - edges-v m)
    in layout-rect (b.lr-x + m.edge-left) (b.lr-y + m.edge-top) bw bh

  comp-fill-box : Integer, Integer, Integer, LayoutRect, LayoutRect, WidgetStyle, Integer, Integer -> Integer
  comp-fill-box (base) (stride) (rows) (clip) (r) (st) (bg) (s) =
    let g = st.ws-gradient
    in let on = g.gr-enabled
    in let c0 = if on then g.gr-start-color else bg
    in let c1 = if on then g.gr-end-color else bg
    in let horiz = on & (g.gr-vertical == False)
    in comp-rows base stride rows clip r ((st.ws-border).bdr-corner) c0 c1 on horiz 0 s

  comp-blend-run : Integer, Integer, Integer, LayoutRect, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-blend-run (base) (stride) (rows) (clip) (x) (xend) (y) (c) (a) =
    if x >= xend then 0
    else let p = comp-blend-px base stride rows clip x y c a
    in comp-blend-run base stride rows clip (x + 1) xend y c a

  comp-shadow-row : Integer, Integer, Integer, LayoutRect, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-shadow-row (base) (stride) (rows) (clip) (x0) (x1) (y) (c) (a) (ey0) (ey1) (ex0) (ex1) =
    if y < ey0 then comp-blend-run base stride rows clip x0 x1 y c a
    else if y >= ey1 then comp-blend-run base stride rows clip x0 x1 y c a
    else let l = comp-blend-run base stride rows clip x0 (math-min x1 ex0) y c a
    in comp-blend-run base stride rows clip (math-max x0 ex1) x1 y c a

  comp-shadow-layer : Integer, Integer, Integer, LayoutRect, LayoutRect, Integer, CornerStyle, Integer, Integer, LayoutRect, Integer, Integer -> Integer
  comp-shadow-layer (base) (stride) (rows) (clip) (r) (lk) (cs) (c) (a) (ex) (ek) (y) =
    if y >= r.lr-h then 0
    else
      let d = math-min y (r.lr-h - 1 - y)
      in let ins = comp-arc256 cs lk (2 * d) / 256
      in let row = r.lr-y + y
      in let ey = row - ex.lr-y
      in let ed = if ey < 0 then 0 - 1 else if ey >= ex.lr-h then 0 - 1 else math-min ey (ex.lr-h - 1 - ey)
      in let eins = if ed < 0 then 0 else comp-arc256 cs ek (2 * ed) / 256
      in let one = comp-shadow-row base stride rows clip (r.lr-x + ins) (r.lr-x + r.lr-w - ins) row c a (ex.lr-y) (ex.lr-y + ex.lr-h) (ex.lr-x + eins) (ex.lr-x + ex.lr-w - eins)
      in comp-shadow-layer base stride rows clip r lk cs c a ex ek (y + 1)

  comp-grow : LayoutRect, Integer -> LayoutRect
  comp-grow (r) (k) = layout-rect (r.lr-x - k) (r.lr-y - k) (r.lr-w + 2 * k) (r.lr-h + 2 * k)

  comp-shadow-stack : Integer, Integer, Integer, LayoutRect, LayoutRect, CornerStyle, Integer, Integer, LayoutRect, Integer, Integer -> Integer
  comp-shadow-stack (base) (stride) (rows) (clip) (sr) (cs) (c) (a) (ex) (ek) (j) =
    if j < 0 then 0
    else let one = comp-shadow-layer base stride rows clip (comp-grow sr j) (ek + j) cs c a ex ek 0
    in comp-shadow-stack base stride rows clip sr cs c a ex ek (j - 1)

  comp-shadow : Integer, Integer, Integer, LayoutRect, LayoutRect, WidgetStyle, Integer -> Integer
  comp-shadow (base) (stride) (rows) (clip) (r) (st) (s) =
    let sh = st.ws-shadow
    in if sh.sh-enabled == False then 0
    else let sr = layout-rect (r.lr-x + sh.sh-offset-x * s) (r.lr-y + sh.sh-offset-y * s) (r.lr-w) (r.lr-h)
    in let cs = (st.ws-border).bdr-corner
    in let k = sh.sh-blur * s
    in let ek = comp-fit-r cs (r.lr-w) (r.lr-h) s
    in if k <= 0 then comp-rows base stride rows clip sr cs (sh.sh-color) (sh.sh-color) False False 0 s
    else comp-shadow-stack base stride rows clip sr cs (sh.sh-color) (255 / (k + 1)) r ek k

  comp-bstroke-run : Integer, Integer, Integer, LayoutRect, LayoutRect, CornerStyle, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-bstroke-run (base) (stride) (rows) (clip) (r) (c) (k) (n) (col) (d) (row) (i) (hi) =
    if i >= hi then 0
    else
      let outer = comp-arc-cov c k d i
      in let di = d - n
      in let ii = i - n
      in let inner = if di < 0 then 0 else if ii < 0 then 0 else comp-arc-cov c (k - n) di ii
      in let a = outer - inner
      in let cov = if a <= 0 then 0 else if a > 255 then 255 else a
      in let lx = r.lr-x + i
      in let rx = r.lr-x + r.lr-w - 1 - i
      in let p0 = if cov <= 0 then 0 else comp-blend-px base stride rows clip lx row col cov
      in let p1 = if cov <= 0 then 0 else if rx <= lx then 0 else comp-blend-px base stride rows clip rx row col cov
      in comp-bstroke-run base stride rows clip r c k n col d row (i + 1) hi

  comp-bstroke : Integer, Integer, Integer, LayoutRect, LayoutRect, CornerStyle, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  comp-bstroke (base) (stride) (rows) (clip) (r) (c) (k) (tn) (tc) (bn) (bc) (y) =
    if y >= r.lr-h then 0
    else
      let d = math-min y (r.lr-h - 1 - y)
      in if d >= k then comp-bstroke base stride rows clip r c k tn tc bn bc (y + 1)
      else
        let top = y * 2 < r.lr-h
        in let n = if top then tn else bn
        in let col = if top then tc else bc
        in let hi = math-min (r.lr-w / 2) (k + n + 1)
        in let one = if n <= 0 then 0 else comp-bstroke-run base stride rows clip r c k n col d (r.lr-y + y) 0 hi
        in comp-bstroke base stride rows clip r c k tn tc bn bc (y + 1)

  comp-border : Integer, Integer, Integer, LayoutRect, LayoutRect, Border, Integer -> Integer
  comp-border (base) (stride) (rows) (clip) (r) (bd) (s) =
    let k = comp-fit-r (bd.bdr-corner) (r.lr-w) (r.lr-h) s
    in let ih = box-clamp0 (r.lr-w - 2 * k)
    in let iv = box-clamp0 (r.lr-h - 2 * k)
    in let tw = (bd.bdr-top).brd-width * s
    in let bw = (bd.bdr-bottom).brd-width * s
    in let lw = (bd.bdr-left).brd-width * s
    in let rw = (bd.bdr-right).brd-width * s
    in let d0 = if tw > 0 & ih > 0 then comp-fill base stride rows clip (r.lr-x + k) (r.lr-y) ih tw ((bd.bdr-top).brd-color) else 0
    in let d1 = if bw > 0 & ih > 0 then comp-fill base stride rows clip (r.lr-x + k) (r.lr-y + r.lr-h - bw) ih bw ((bd.bdr-bottom).brd-color) else 0
    in let d2 = if lw > 0 & iv > 0 then comp-fill base stride rows clip (r.lr-x) (r.lr-y + k) lw iv ((bd.bdr-left).brd-color) else 0
    in let d3 = if rw > 0 & iv > 0 then comp-fill base stride rows clip (r.lr-x + r.lr-w - rw) (r.lr-y + k) rw iv ((bd.bdr-right).brd-color) else 0
    in if k <= 0 then 0
    else comp-bstroke base stride rows clip r (bd.bdr-corner) k tw ((bd.bdr-top).brd-color) bw ((bd.bdr-bottom).brd-color) 0

  comp-accent : Integer, Integer, Integer, LayoutRect, LayoutRect, AccentBorder, Integer -> Integer
  comp-accent (base) (stride) (rows) (clip) (r) (ab) (s) =
    if ab.ab-enabled == False then 0
    else let n = ab.ab-width * s
    in if n <= 0 then 0
    else if ab.ab-side == 0 then comp-fill base stride rows clip (r.lr-x) (r.lr-y) (r.lr-w) n (ab.ab-color)
    else if ab.ab-side == 1 then comp-fill base stride rows clip (r.lr-x + r.lr-w - n) (r.lr-y) n (r.lr-h) (ab.ab-color)
    else if ab.ab-side == 2 then comp-fill base stride rows clip (r.lr-x) (r.lr-y + r.lr-h - n) (r.lr-w) n (ab.ab-color)
    else comp-fill base stride rows clip (r.lr-x) (r.lr-y) n (r.lr-h) (ab.ab-color)

  comp-bevel : Integer, Integer, Integer, LayoutRect, LayoutRect, WidgetStyle, Integer -> Integer
  comp-bevel (base) (stride) (rows) (clip) (r) (st) (s) =
    let bv = st.ws-bevel
    in if bv.bv-enabled == False then 0
    else let n = bv.bv-width * s
    in if n <= 0 then 0
    else let k = comp-fit-r ((st.ws-border).bdr-corner) (r.lr-w) (r.lr-h) s
    in let ih = box-clamp0 (r.lr-w - 2 * k)
    in let iv = box-clamp0 (r.lr-h - 2 * k)
    in let tl = bevel-tl bv
    in let br = bevel-br bv
    in let d0 = if ih > 0 then comp-fill base stride rows clip (r.lr-x + k) (r.lr-y) ih n tl else 0
    in let d1 = if iv > 0 then comp-fill base stride rows clip (r.lr-x) (r.lr-y + k) n iv tl else 0
    in let d2 = if ih > 0 then comp-fill base stride rows clip (r.lr-x + k) (r.lr-y + r.lr-h - n) ih n br else 0
    in if iv > 0 then comp-fill base stride rows clip (r.lr-x + r.lr-w - n) (r.lr-y + k) n iv br else 0

  comp-mul-rect : LayoutRect, Integer -> LayoutRect
  comp-mul-rect (r) (s) = layout-rect (r.lr-x * s) (r.lr-y * s) (r.lr-w * s) (r.lr-h * s)

  comp-box : Integer, Integer, Integer, LayoutRect, LayoutRect, WidgetStyle, Integer, Integer -> Integer
  comp-box (base) (stride) (rows) (clip) (b) (st) (bg) (s) =
    let r = comp-mul-rect (comp-border-box b st) s
    in if r.lr-w <= 0 | r.lr-h <= 0 then 0
    else let sh = comp-shadow base stride rows clip r st s
    in let f = comp-fill-box base stride rows clip r st bg s
    in let d = comp-border base stride rows clip r (st.ws-border) s
    in let bv = comp-bevel base stride rows clip r st s
    in comp-accent base stride rows clip r (st.ws-accent-border) s

Section: Node Drawing

  comp-glyph-h : Integer = 16

  comp-cell-w : Integer = 8

  comp-text-top : GopFont, LayoutRect, Integer -> Integer
  comp-text-top (tf) (c) (s) =
    let gh = if tf.gf-ok then tf.gf-gh else comp-glyph-h * s
    in let dy = if tf.gf-ok then (c.lr-h - tf.gf-cap) / 2 - (tf.gf-asc - tf.gf-cap)
      else if c.lr-h > gh then (c.lr-h - gh) / 2 else 0
    in c.lr-y + dy

  comp-text : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, LayoutRect, Text, Integer, Integer -> Integer
  comp-text (base) (stride) (rows) (clip) (font) (tf) (c) (t) (fg) (s) =
    let gh = if tf.gf-ok then tf.gf-gh else comp-glyph-h * s
    in let ty = comp-text-top tf c s
    in if ty < clip.lr-y then 0
    else if ty + gh > clip.lr-y + clip.lr-h then 0
    else if c.lr-x < clip.lr-x then 0
    else if tf.gf-ok then
      let cr = c.lr-x + c.lr-w
      in let pr = clip.lr-x + clip.lr-w
      in let right = if cr < pr then cr else pr
      in let shown = comp-fit-px tf t (right - c.lr-x)
      in gfont-text-clip tf base stride (clip.lr-y + clip.lr-h) right (c.lr-x) ty shown fg
    else gop-draw-text base stride rows font (c.lr-x) ty (comp-fit t (comp-cols c s)) fg s 0

  comp-fit-px : GopFont, Text, Integer -> Text
  comp-fit-px (tf) (t) (avail) =
    if avail <= 0 then ""
    else if gfont-text-w tf t <= avail then t
    else comp-fit-px-loop tf t avail 0 (text-length t - 1)

  comp-fit-px-loop : GopFont, Text, Integer, Integer, Integer -> Text
  comp-fit-px-loop (tf) (t) (avail) (lo) (hi) =
    if hi <= lo then substring t 0 lo
    else let mid = (lo + hi + 1) / 2
    in if gfont-text-w tf (substring t 0 mid) <= avail
      then comp-fit-px-loop tf t avail mid hi
      else comp-fit-px-loop tf t avail lo (mid - 1)

  comp-cols : LayoutRect, Integer -> Integer
  comp-cols (c) (s) = c.lr-w / (comp-cell-w * s)

  comp-gauge-fill : Integer, Integer, Integer, LayoutRect, LayoutRect, Integer, Integer, Integer -> Integer
  comp-gauge-fill (base) (stride) (rows) (clip) (b) (v) (mx) (fg) =
    if mx <= 0 then 0
    else let fw = (b.lr-w) * (if v > mx then mx else v) / mx
    in if fw <= 0 then 0
    else comp-fill base stride rows clip (b.lr-x) (b.lr-y) fw (b.lr-h) fg

  comp-fit : Text, Integer -> Text
  comp-fit (t) (cols) =
    if cols <= 0 then ""
    else if text-length t <= cols then t
    else substring t 0 cols

  comp-input : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, LayoutRect, LayoutRect, WidgetStyle, Text, Integer, Integer, Integer -> Integer
  comp-input (base) (stride) (rows) (clip) (font) (tf) (b) (c) (st) (t) (cursor) (fg) (s) =
    let fill = comp-box base stride rows clip b st (st.ws-bg) s
    in let txt = comp-text base stride rows clip font tf c t fg s
    in let n = if cursor < 0 then 0 else if cursor > text-length t then text-length t else cursor
    in let gh = if tf.gf-ok then tf.gf-cap else comp-glyph-h * s
    in let want = if tf.gf-ok then c.lr-x + gfont-text-w tf (substring t 0 n)
      else c.lr-x + cursor * comp-cell-w * s
    in let hi = c.lr-x + c.lr-w - 1
    in let cx = if want > hi then hi else want
    in let ch = if c.lr-h < gh then c.lr-h else gh
    in let dy = if c.lr-h > gh then (c.lr-h - gh) / 2 else 0
    in if ch <= 0 | cx < c.lr-x then 0
    else comp-fill base stride rows clip cx (c.lr-y + dy) s ch fg

  comp-dot : Integer, Integer, Integer, LayoutRect, LayoutRect, Integer, Integer, Boolean -> Integer
  comp-dot (base) (stride) (rows) (clip) (c) (fg) (bg) (filled) =
    let d = math-min (c.lr-w) (c.lr-h)
    in if d <= 0 then 0
    else let x = c.lr-x + (c.lr-w - d) / 2
    in let y = c.lr-y + (c.lr-h - d) / 2
    in let outer = comp-rows base stride rows clip (layout-rect x y d d) (CornerRound (d / 2)) fg fg False False 0 1
    in if filled then outer
    else let t = if d >= 6 then d / 4 else 1
    in let id = d - 2 * t
    in if id <= 0 then outer
    else comp-rows base stride rows clip (layout-rect (x + t) (y + t) id id) (CornerRound (id / 2)) bg bg False False 0 1

  comp-icon-tag : Text -> Boolean
  comp-icon-tag (tag) =
    if text-length tag <= 5 then False else substring tag 0 5 == "icon:"

  comp-icon : Integer, Integer, Integer, LayoutRect, LayoutRect, Text, Integer -> Integer
  comp-icon (base) (stride) (rows) (clip) (c) (tag) (fg) =
    let name = substring tag 5 (text-length tag - 5)
    in let d = math-min (c.lr-w) (c.lr-h)
    in let sc = if d < 8 then 1 else d / 8
    in let sz = 8 * sc
    in let x = c.lr-x + (c.lr-w - sz) / 2
    in let y = c.lr-y + (c.lr-h - sz) / 2
    in if x < clip.lr-x then 0
    else if y < clip.lr-y then 0
    else if x + sz > clip.lr-x + clip.lr-w then 0
    else if y + sz > clip.lr-y + clip.lr-h then 0
    else gicon-blit base stride rows (gicon-named name) x y sc fg

  comp-custom : Integer, Integer, Integer, LayoutRect, LayoutRect, LayoutRect, WidgetStyle, Text, Integer, Integer -> Integer
  comp-custom (base) (stride) (rows) (clip) (b) (c) (st) (tag) (fg) (s) =
    if tag == wk-spacer-tag then 0
    else if tag == "event-dot"
    then comp-fill base stride rows clip (c.lr-x + c.lr-w / 2 - 3 * s) (c.lr-y + c.lr-h / 2 - 3 * s) (6 * s) (6 * s) fg
    else if tag == "status-dot" then comp-dot base stride rows clip (comp-mul-rect b s) fg (st.ws-bg) False
    else if tag == "status-dot-filled" then comp-dot base stride rows clip (comp-mul-rect b s) fg (st.ws-bg) True
    else if comp-icon-tag tag then comp-icon base stride rows clip (comp-mul-rect b s) tag fg
    else comp-box base stride rows clip b st (st.ws-bg) s

  comp-fg : Theme, WidgetNode, WidgetStyle -> Integer
  comp-fg (th) (node) (st) = theme-tone-fg th (node.wn-tone) (st.ws-fg)

  comp-focus-ring : Integer, Integer, Integer, LayoutRect, WidgetNode, Theme, Integer -> Integer
  comp-focus-ring (base) (stride) (rows) (clip) (node) (th) (s) =
    if flag-has (widget-flags node) flag-focused == False then 0
    else if widget-state-of node == state-focused then 0
    else let r = comp-mul-rect (comp-border-box (node.wn-bounds) (widget-resolve-style node th)) s
    in let c = (th.th-palette).pal-accent
    in let t = comp-fill base stride rows clip (r.lr-x) (r.lr-y) (r.lr-w) s c
    in let b = comp-fill base stride rows clip (r.lr-x) (r.lr-y + r.lr-h - s) (r.lr-w) s c
    in let l = comp-fill base stride rows clip (r.lr-x) (r.lr-y) s (r.lr-h) c
    in comp-fill base stride rows clip (r.lr-x + r.lr-w - s) (r.lr-y) s (r.lr-h) c

  comp-draw-node : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer -> Integer
  comp-draw-node (base) (stride) (rows) (clip) (font) (tf) (node) (th) (s) =
    let d = comp-draw-kind base stride rows clip font tf node th s
    in let f = comp-focus-ring base stride rows clip node th s
    in comp-state-marks base stride rows clip node th s

  comp-state-marks : Integer, Integer, Integer, LayoutRect, WidgetNode, Theme, Integer -> Integer
  comp-state-marks (base) (stride) (rows) (clip) (node) (th) (s) =
    let flags = widget-flags node
    in if bit-and flags (flag-checked + flag-invalid + flag-busy) == 0 then 0
    else let st = widget-resolve-style node th
    in let r = comp-mul-rect (comp-border-box (node.wn-bounds) st) s
    in let pal = th.th-palette
    in let e = if flag-has flags flag-invalid then comp-fill base stride rows clip (r.lr-x) (r.lr-y + r.lr-h - 2 * s) (r.lr-w) (2 * s) (pal.pal-error) else 0
    in let c = if flag-has flags flag-checked then comp-fill base stride rows clip (r.lr-x + r.lr-w - 6 * s) (r.lr-y + 2 * s) (4 * s) (4 * s) (st.ws-fg) else 0
    in if flag-has flags flag-busy then comp-fill base stride rows clip (r.lr-x) (r.lr-y) (r.lr-w / 3) s (pal.pal-warning) else 0

  comp-draw-kind : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer -> Integer
  comp-draw-kind (base) (stride) (rows) (clip) (font) (tf) (node) (th) (s) =
    let st = widget-resolve-style node th
    in let b = node.wn-bounds
    in let c = comp-mul-rect (box-content-from-style b st) s
    in let fg = comp-fg th node st
    in when node.wn-kind
      is WkPanel -> comp-box base stride rows clip b st (st.ws-bg) s
      is WkStack -> 0
      is WkSeparator -> comp-box base stride rows clip b st (st.ws-fg) s
      is WkLabel (t) -> comp-text base stride rows clip font tf c t fg s
      is WkButton (t) ->
        let bg = comp-box base stride rows clip b st (st.ws-bg) s
        in comp-text base stride rows clip font tf c t fg s
      is WkGauge (v) (mx) ->
        let bg = comp-box base stride rows clip b st (st.ws-bg) s
        in comp-gauge-fill base stride rows clip c v mx fg
      is WkInput (t) (cur) -> comp-input base stride rows clip font tf b c st t cur fg s
      is WkCustom (tag) -> comp-custom base stride rows clip b c st tag fg s
      is otherwise -> 0

Section: Translate

  comp-translate : WidgetNode, Integer, Integer -> WidgetNode
  comp-translate (n) (dx) (dy) =
    let b = n.wn-bounds
    in let moved = __record-set n "wn-bounds" (layout-rect (b.lr-x + dx) (b.lr-y + dy) (b.lr-w) (b.lr-h))
    in let k = comp-translate-kids (n.wn-children) dx dy 0
    in moved

  comp-translate-kids : List WidgetNode, Integer, Integer, Integer -> Integer
  comp-translate-kids (ks) (dx) (dy) (i) =
    if i >= list-length ks then 0
    else let t = comp-translate (list-at ks i) dx dy
    in comp-translate-kids ks dx dy (i + 1)

Section: Tree Walk

  comp-kids-clip : WidgetNode, LayoutRect, Integer -> LayoutRect
  comp-kids-clip (node) (clip) (s) =
    if widget-is-scroll-view node then comp-clip clip (comp-mul-rect (node.wn-bounds) s) else clip

  comp-walk : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer -> Integer
  comp-walk (base) (stride) (rows) (clip) (font) (tf) (node) (th) (s) =
    let d = comp-draw-node base stride rows clip font tf node th s
    in comp-walk-kids base stride rows (comp-kids-clip node clip s) font tf (node.wn-children) th 0 s

  comp-walk-kids : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, List WidgetNode, Theme, Integer, Integer -> Integer
  comp-walk-kids (base) (stride) (rows) (clip) (font) (tf) (kids) (th) (i) (s) =
    if i >= list-length kids then 0
    else let w = comp-walk base stride rows clip font tf (list-at kids i) th s
    in comp-walk-kids base stride rows clip font tf kids th (i + 1) s

  comp-walk-except : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, WidgetNode, Theme, Integer, Text -> Integer
  comp-walk-except (base) (stride) (rows) (clip) (font) (tf) (node) (th) (s) (skip) =
    if node.wn-id == skip then 0
    else let d = comp-draw-node base stride rows clip font tf node th s
    in comp-walk-except-kids base stride rows (comp-kids-clip node clip s) font tf (node.wn-children) th 0 s skip

  comp-walk-except-kids : Integer, Integer, Integer, LayoutRect, CbfFont, GopFont, List WidgetNode, Theme, Integer, Integer, Text -> Integer
  comp-walk-except-kids (base) (stride) (rows) (clip) (font) (tf) (kids) (th) (i) (s) (skip) =
    if i >= list-length kids then 0
    else let w = comp-walk-except base stride rows clip font tf (list-at kids i) th s skip
    in comp-walk-except-kids base stride rows clip font tf kids th (i + 1) s skip

  comp-clip : LayoutRect, LayoutRect -> LayoutRect
  comp-clip (a) (b) =
    let x0 = math-max (a.lr-x) (b.lr-x)
    in let y0 = math-max (a.lr-y) (b.lr-y)
    in let x1 = math-min (a.lr-x + a.lr-w) (b.lr-x + b.lr-w)
    in let y1 = math-min (a.lr-y + a.lr-h) (b.lr-y + b.lr-h)
    in layout-rect x0 y0 (box-clamp0 (x1 - x0)) (box-clamp0 (y1 - y0))

Section: Render

  comp-hit-x : Integer, Integer -> Integer
  comp-hit-x (mx) (s) = mx / s

  comp-hit-y : Integer, Integer -> Integer
  comp-hit-y (my) (s) = my / s

  comp-fit-w : GopFont, Integer, Text -> Integer
  comp-fit-w (tf) (s) (t) = (gfont-text-w tf t + s - 1) / s

  comp-fit-node : WidgetNode, GopFont, Integer -> WidgetNode
  comp-fit-node (n) (tf) (s) =
    let fitted = when n.wn-kind
      is WkLabel (t) -> if n.wn-fit-w then widget-fit-min-w n (comp-fit-w tf s t) else n
      is WkButton (t) -> if n.wn-fit-w then widget-fit-min-w n (comp-fit-w tf s t + 16) else n
      is otherwise -> n
    in if fitted.wn-child-count == 0 then fitted
    else widget-set-children fitted (comp-fit-kids (fitted.wn-children) tf s 0 (fitted.wn-child-count) [])

  comp-fit-kids : List WidgetNode, GopFont, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  comp-fit-kids (kids) (tf) (s) (i) (n) (acc) =
    if i >= n then acc
    else comp-fit-kids kids tf s (i + 1) n (list-push acc (comp-fit-node (list-at kids i) tf s))

  comp-fit-text : WidgetNode, GopFont, Integer -> WidgetNode
  comp-fit-text (root) (tf) (s) = if tf.gf-ok then comp-fit-node root tf s else root

  comp-render-at : Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Theme, Integer, Integer, Integer, Integer, Integer -> WidgetNode
  comp-render-at (base) (stride) (rows) (font) (tf) (root) (th) (ox) (oy) (w) (h) (s) =
    let laid = widget-layout root th (layout-rect (ox / s) (oy / s) (w / s) (h / s))
    in let d = comp-walk base stride rows (layout-rect ox oy w h) font tf laid th s
    in laid

  comp-render : Integer, Integer, Integer, CbfFont, GopFont, WidgetNode, Theme, Integer, Integer, Integer -> WidgetNode
  comp-render (base) (stride) (rows) (font) (tf) (root) (th) (w) (h) (s) =
    comp-render-at base stride rows font tf root th 0 0 w h s
