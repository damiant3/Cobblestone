 We say:

Section: Socket Operations

  hs-op-socket : Integer = 0
  hs-op-bind : Integer = 1
  hs-op-listen : Integer = 2
  hs-op-accept : Integer = 3
  hs-op-close : Integer = 4
  hs-op-recv : Integer = 5
  hs-op-send : Integer = 6
  hs-op-reuseaddr : Integer = 7

  hs-buffer-bytes : Integer = 65536
  hs-backlog : Integer = 16

  hs-err-socket : Integer = 0 - 1
  hs-err-bind : Integer = 0 - 2
  hs-err-listen : Integer = 0 - 3

Section: Buffer and List

  hs-buf-to-list : Integer, Integer, Integer, List Integer -> List Integer
  hs-buf-to-list (buf) (i) (n) (acc) =
    if i >= n then acc
    else hs-buf-to-list buf (i + 1) n (list-push acc (peek-byte buf i))

  hs-list-to-buf : Integer, List Integer, Integer, Integer -> Integer
  hs-list-to-buf (buf) (bs) (i) (n) =
    if i >= n then n
    else let ignored = poke-byte buf i (list-at bs i)
    in hs-list-to-buf buf bs (i + 1) n

Section: Serving One Connection

  hs-send-all : Integer, Integer, Integer, Integer -> [Network.Write] Integer
  hs-send-all (fd) (buf) (off) (n) = act
    if off >= n then off
    else act
      sent <- host-socket hs-op-send fd (buf + off) (n - off)
      if sent <= 0 then (0 - 1)
      else hs-send-all fd buf (off + sent) n
    end
  end

  HostedServed = record { state : WebState, ok : Boolean }

  hs-serve-one : (HttpRequest -> HttpResponse), WebState, Integer, Integer -> [Network.Write] HostedServed
  hs-serve-one (route) (st) (cfd) (buf) = act
    n <- host-socket hs-op-recv cfd buf hs-buffer-bytes
    if n <= 0 then act
      closed <- host-socket hs-op-close cfd 0 0
      HostedServed { state = st, ok = False }
    end
    else
      let req = http-parse-request (hs-buf-to-list buf 0 n [])
      in let ns = WebState { request-count = (st.request-count) + 1 }
      in let resp = if req.valid then web-dispatch route web-observe-none ns req else http-error "Bad request"
      in let out = http-encode resp
      in let len = list-length out
      in let staged = hs-list-to-buf buf out 0 len
      in act
        sent <- hs-send-all cfd buf 0 len
        closed <- host-socket hs-op-close cfd 0 0
        HostedServed { state = ns, ok = sent >= 0 }
      end
  end

Section: The Accept Loop

  hs-loop : (HttpRequest -> HttpResponse), WebState, Integer, Integer, Integer -> [Network.Write] Integer
  hs-loop (route) (st) (fd) (buf) (remaining) = act
    if remaining == 0 then (st.request-count)
    else act
      cfd <- host-socket hs-op-accept fd 0 0
      if cfd < 0 then (st.request-count)
      else act
        served <- hs-serve-one route st cfd buf
        hs-loop route (served.state) fd buf (remaining - 1)
      end
    end
  end

  hosted-listen : Integer -> [Network.Write] Integer
  hosted-listen (port) = act
    fd <- host-socket hs-op-socket 0 0 0
    if fd < 0 then hs-err-socket
    else act
      reused <- host-socket hs-op-reuseaddr fd 0 0
      bound <- host-socket hs-op-bind fd port 0
      if bound < 0 then act
        closed <- host-socket hs-op-close fd 0 0
        hs-err-bind
      end
      else act
        listening <- host-socket hs-op-listen fd hs-backlog 0
        if listening < 0 then act
          closed <- host-socket hs-op-close fd 0 0
          hs-err-listen
        end
        else fd
      end
    end
  end

  hosted-serve-on : (HttpRequest -> HttpResponse), Integer, Integer -> [Network.Write] Integer
  hosted-serve-on (route) (fd) (count) =
    let buf = alloc-bytes hs-buffer-bytes
    in act
      served <- hs-loop route web-new fd buf count
      closed <- host-socket hs-op-close fd 0 0
      served
    end

  hosted-serve-n : (HttpRequest -> HttpResponse), Integer, Integer -> [Network.Write] Integer
  hosted-serve-n (route) (port) (count) = act
    fd <- hosted-listen port
    if fd < 0 then fd
    else hosted-serve-on route fd count
  end

  hosted-serve : (HttpRequest -> HttpResponse), Integer -> [Network.Write] Integer
  hosted-serve (route) (port) = hosted-serve-n route port (0 - 1)
