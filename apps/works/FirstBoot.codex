 First-boot experience. When Codex boots from a USB stick for the
 first time (no IdentityFact in DiskFacts), FirstBoot runs the
 first-boot wizard: generate and encrypt identity, choose or
 acquire an agent, configure upstream, and enter the UEFI console.

 We say:

Section: First Boot State

  FirstBootPhase =
    | PhaseWelcome
    | PhaseIdentity
    | PhaseAgentSelect
    | PhaseAgentSetup
    | PhaseUpstream
    | PhaseModeSelect
    | PhaseSaveConfig
    | PhaseComplete

  FirstBootState = record {
    phase : FirstBootPhase,
    disk-store : DiskFactStore,
    agent-package : Maybe AgentPackage,
    agent-runtime : AgentRuntimeState,
    upstream : UpstreamConfig,
    selected-mode : BootMode,
    config-saved : Boolean,
    status : Text
  }

  BootMode =
    | BootDevConsole
    | BootUi
    | BootSerialRepl

  boot-mode-label : BootMode -> Text
  boot-mode-label (m) = when m
    is BootDevConsole -> "Dev Console (UEFI text)"
    is BootUi -> "Graphical UI (GOP framebuffer)"
    is BootSerialRepl -> "Serial REPL (headless)"

Section: Initialization

  first-boot-init : DiskFactStore -> FirstBootState
  first-boot-init (store) = FirstBootState {
    phase = PhaseWelcome,
    disk-store = store,
    agent-package = None,
    agent-runtime = runtime-init,
    upstream = default-upstream,
    selected-mode = BootDevConsole,
    config-saved = False,
    status = ""
  }

Section: Boot Entry Point

  first-boot-entry : DiskFactStore, Integer -> [Console, Identity] DiskFactStore
  first-boot-entry (store) (timestamp) =
    if sysdb-is-fresh store then
      first-boot-fresh store timestamp
    else
      first-boot-returning store

  first-boot-fresh : DiskFactStore, Integer -> [Console, Identity] DiskFactStore
  first-boot-fresh (store) (timestamp) = act
    idm-show-lines welcome-lines
    let w1 = first-boot-wait-enter
    in act
      result <- idm-first-boot store timestamp
      when result.idm-result
       is IdmOk -> result.idm-store
       is IdmWrongPassphrase -> result.idm-store
       is IdmNoIdentity -> result.idm-store
       is IdmError (msg) -> act
         idm-show-lines ["  Error: " & msg]
         result.idm-store
       end
    end
  end

  first-boot-returning : DiskFactStore -> [Console, Identity] DiskFactStore
  first-boot-returning (store) =
    first-boot-unlock-loop store 3

  first-boot-unlock-loop : DiskFactStore, Integer -> [Console, Identity] DiskFactStore
  first-boot-unlock-loop (store) (retries) =
    if retries <= 0 then act
      idm-show-lines ["", "  Too many failed attempts.", ""]
      store
    end
    else act
      result <- idm-unlock store
      when result.idm-result
       is IdmOk -> act
         idm-show-lines ["", "  Identity unlocked.", ""]
         result.idm-store
       end
       is IdmWrongPassphrase -> act
         idm-show-lines ["  Wrong passphrase. Try again.", ""]
         first-boot-unlock-loop store (retries - 1)
       end
       is IdmNoIdentity -> act
         idm-show-lines ["  No identity found on this stick.", ""]
         store
       end
       is IdmError (msg) -> act
         idm-show-lines ["  Error: " & msg]
         store
       end
    end

  first-boot-wait-enter : Integer
  first-boot-wait-enter =
    let ch = poll-key
    in if ch == key-enter then 0
    else first-boot-wait-enter

Section: Welcome Screen

  welcome-lines : List Text
  welcome-lines = [
    "",
    "  ================================================================",
    "                      Welcome to Codex",
    "  ================================================================",
    "",
    "  A self-sustaining operating system, compiler, and development",
    "  environment. Everything on this device was compiled by itself.",
    "",
    "  This is first boot. We will:",
    "    1. Generate your identity (Ed25519 keypair)",
    "    2. Set up an AI agent (optional)",
    "    3. Choose your preferred interface",
    "",
    "  Press Enter to begin.",
    ""
  ]

Section: Identity

 Identity generation, encryption, and persistence are handled by
 IdentityManager (codex/os/kernel/IdentityManager.codex). The
 first-boot-entry function above calls idm-first-boot for fresh
 sticks and idm-unlock for returning users. The private key is
 stored encrypted in DiskFacts (AES-256-CBC, HKDF-SHA256 key
 derivation from passphrase) and decrypted into a pinned kernel
 memory region at unlock time.

Section: Agent Selection

  agent-select-lines : BundledAgentResult -> List Text
  agent-select-lines (bundled) = [
    "",
    "  AI Agent Setup",
    "  ==============",
    "",
    "  An agent helps you write code, navigate the codebase,",
    "  run builds, and debug problems. It runs locally on this",
    "  device. For harder problems it can escalate to a larger",
    "  model on a remote server.",
    "",
    "  Available agents:"
  ] & when bundled
    is BundledFound (path) -> ["    [B] Bundled agent at " & path]
    is BundledNone -> ["    (no bundled agent on this image)"]
  & [
    "    [L] Load from USB drive or disk path",
    "    [D] Download from network",
    "    [S] Skip (no agent)",
    ""
  ]

Section: Upstream Configuration

  upstream-config-lines : List Text
  upstream-config-lines = [
    "",
    "  Upstream Server (optional)",
    "  ==========================",
    "",
    "  For complex tasks, the local agent can escalate to a",
    "  full-size model on a remote server. Enter the server",
    "  address or press Enter to skip.",
    ""
  ]

Section: Mode Selection

  mode-select-menu : MenuState
  mode-select-menu = menu-new "Choose Interface" [
    menu-item "Dev Console (text menus, code browser, compiler)" "dev",
    menu-item "Graphical UI (framebuffer, widgets, mouse)" "ui",
    menu-item "Serial REPL (headless, for automation)" "serial"
  ]

Section: Configuration Persistence

  first-boot-save-mode : DiskFactStore, BootMode, Integer -> DiskFactStore
  first-boot-save-mode (store) (mode) (timestamp) =
    let mode-int = when mode
      is BootDevConsole -> sysdb-boot-mode-console
      is BootUi -> sysdb-boot-mode-ui
      is BootSerialRepl -> sysdb-boot-mode-serial
    in let cfg = SysBootConfig {
      sbc-boot-mode = mode-int,
      sbc-boot-partition = 0,
      sbc-boot-drive-serial = ""
    }
    in let store2 = sysdb-write-boot-config store cfg timestamp
    in disk-checkpoint store2

  first-boot-load-mode : DiskFactStore -> BootMode
  first-boot-load-mode (store) =
    let cfg-maybe = sysdb-find-boot-config store
    in when cfg-maybe
      is None -> BootDevConsole
      is Just (cfg) ->
        if cfg.sbc-boot-mode == sysdb-boot-mode-ui then BootUi
        else if cfg.sbc-boot-mode == sysdb-boot-mode-serial then BootSerialRepl
        else BootDevConsole

