Section: Mode Selection

  mode-select-menu : MenuState
  mode-select-menu = menu-new "Choose Interface" [
    menu-item "Dev Console (text menus, code browser, compiler)" "dev",
    menu-item "Graphical UI (framebuffer, widgets, mouse)" "ui",
    menu-item "Serial REPL (headless, for automation)" "serial"
  ]

Section: Configuration Persistence

 Boot configuration is stored in DiskFacts via SysBootConfig
 (defined in DiskFacts.codex). The sysdb-write-boot-config and
 sysdb-find-boot-config functions handle serialization. The
 IdentityManager writes the initial BootConfigFact during the
 first-boot ceremony.

  first-boot-save-mode : DiskFactStore, BootMode, Integer -> DiskFactStore
  first-boot-save-mode (store) (mode) (timestamp) =
    let mode-int = when mode
      is BootDevConsole -> sysdb-boot-mode-console
      is BootUi -> sysdb-boot-mode-ui
      is BootSerialRepl -> sysdb-boot-mode-serial
    in let cfg = SysBootConfig {
      sbc-boot-mode = mode-int,
      sbc-boot-partition = 0,
      sbc-boot-drive-serial = ""
    }
    in let store2 = sysdb-write-boot-config store cfg timestamp
    in disk-checkpoint store2

  first-boot-load-mode : DiskFactStore -> BootMode
  first-boot-load-mode (store) =
    let cfg-maybe = sysdb-find-boot-config store
    in when cfg-maybe
      is None -> BootDevConsole
      is Just (cfg) ->
        if cfg.sbc-boot-mode == sysdb-boot-mode-ui then BootUi
        else if cfg.sbc-boot-mode == sysdb-boot-mode-serial then BootSerialRepl
        else BootDevConsole

