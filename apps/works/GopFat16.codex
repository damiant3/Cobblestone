 We say:

Section: GPT

  gpt-sig-ok : Integer -> Boolean
  gpt-sig-ok (buf) =
    peek-byte buf 0 == 69 & peek-byte buf 1 == 70 & peek-byte buf 2 == 73
    & peek-byte buf 3 == 32 & peek-byte buf 4 == 80 & peek-byte buf 5 == 65
    & peek-byte buf 6 == 82 & peek-byte buf 7 == 84

  gfat-crc32-buf : List Integer, Integer, Integer, Integer, Integer -> Integer
  gfat-crc32-buf (tbl) (crc) (buf) (i) (len) =
    if i >= len then crc
    else gfat-crc32-buf tbl (bit-xor (list-at tbl (bit-and (bit-xor crc (peek-byte buf i)) 255)) (bit-shru crc 8)) buf (i + 1) len

  gfat-crc32-zeros : List Integer, Integer, Integer -> Integer
  gfat-crc32-zeros (tbl) (crc) (n) =
    if n <= 0 then crc
    else gfat-crc32-zeros tbl (bit-xor (list-at tbl (bit-and crc 255)) (bit-shru crc 8)) (n - 1)

  gpt-header-crc-ok : Integer -> Boolean
  gpt-header-crc-ok (buf) =
    let hsize = fat16-read-u32 buf 12
    in if hsize < 92 then False
    else if hsize > 512 then False
    else let tbl = crc32-table
    in let c0 = gfat-crc32-buf tbl 4294967295 buf 0 16
    in let c1 = gfat-crc32-zeros tbl c0 4
    in let c2 = gfat-crc32-buf tbl c1 buf 20 hsize
    in bit-xor c2 4294967295 == fat16-read-u32 buf 16

  gpt-array-geom-ok : Integer -> Boolean
  gpt-array-geom-ok (buf) =
    let lba = fat16-read-u32 buf 72
    in let cnt = fat16-read-u32 buf 80
    in let sz = fat16-read-u32 buf 84
    in let first-usable = fat16-read-u32 buf 40
    in lba >= 2
    & cnt >= 1 & cnt <= 1024
    & sz >= 128 & sz <= 512
    & int-mod sz 128 == 0
    & lba + (cnt * sz + 511) / 512 <= first-usable

  gpt-array-crc : List Integer, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gpt-array-crc (tbl) (crc) (lba) (remaining) (i) = act
    if remaining <= 0 then crc
    else act
      b <- disk-read-sector (lba + i)
      if b.dr-ok == False then 0 - 1
      else let n = if remaining < 512 then remaining else 512
      in gpt-array-crc tbl (gfat-crc32-buf tbl crc (b.dr-buf) 0 n) lba (remaining - n) (i + 1)
    end
  end

  gpt-array-crc-ok : Integer -> [Device.Port] Boolean
  gpt-array-crc-ok (hdr) = act
    c <- gpt-array-crc crc32-table 4294967295 (fat16-read-u32 hdr 72) ((fat16-read-u32 hdr 80) * (fat16-read-u32 hdr 84)) 0
    if c < 0 then False else bit-xor c 4294967295 == fat16-read-u32 hdr 88
  end

  gpt-esp-start : [Device.Port] Integer
  gpt-esp-start = act
    hdr <- disk-read-sector 1
    if hdr.dr-ok == False then let s = gfat-note-stage gfat-stage-hdr in 0
    else if gpt-sig-ok (hdr.dr-buf) == False then let s = gfat-note-stage gfat-stage-sig in 0
    else if gpt-header-crc-ok (hdr.dr-buf) == False then let s = gfat-note-stage gfat-stage-hcrc in 0
    else if gpt-array-geom-ok (hdr.dr-buf) == False then let s = gfat-note-stage gfat-stage-ageo in 0
    else act
      acrc <- gpt-array-crc-ok (hdr.dr-buf)
      if acrc == False then let s = gfat-note-stage gfat-stage-acrc in 0
      else act
        ents <- disk-read-sector (fat16-read-u32 (hdr.dr-buf) 72)
        if ents.dr-ok == False then let s = gfat-note-stage gfat-stage-ents in 0
        else let e = gpt-scan-entries (ents.dr-buf) 0
        in if e == 0 then let s = gfat-note-stage gfat-stage-guid in 0
        else e
      end
    end
  end

  gfat-is-esp-at : Integer, Integer -> Boolean
  gfat-is-esp-at (buf) (off) =
    let want = gpt-esp-type-guid
    in gfat-guid-eq-buf buf off want 0

  gfat-guid-eq-buf : Integer, Integer, List Integer, Integer -> Boolean
  gfat-guid-eq-buf (buf) (off) (want) (i) =
    if i >= 16 then True
    else if peek-byte buf (off + i) /= list-at want i then False
    else gfat-guid-eq-buf buf off want (i + 1)

  gpt-scan-entries : Integer, Integer -> Integer
  gpt-scan-entries (buf) (i) =
    if i >= 4 then 0
    else let off = i * 128
    in if gfat-is-esp-at buf off then fat16-read-u32 buf (off + 32)
    else gpt-scan-entries buf (i + 1)

Section: Mount

  gfat-cell-stage : Integer = 80

  gfat-stage-hdr : Integer = 1
  gfat-stage-sig : Integer = 2
  gfat-stage-ents : Integer = 3
  gfat-stage-guid : Integer = 4
  gfat-stage-bpb : Integer = 5
  gfat-stage-bps : Integer = 6
  gfat-stage-ok : Integer = 7
  gfat-stage-geom : Integer = 8
  gfat-stage-hcrc : Integer = 9
  gfat-stage-ageo : Integer = 10
  gfat-stage-acrc : Integer = 11

  gfat-note-stage : Integer -> Integer
  gfat-note-stage (s) = xdiag-put gfat-cell-stage s

  gfat-cell-write : Integer = 83

  gfat-note-write : Integer -> Integer
  gfat-note-write (s) = xdiag-put gfat-cell-write s

  gfat-cell-written : Integer = 88

  gfat-note-written : Integer -> Integer
  gfat-note-written (n) = xdiag-put gfat-cell-written n

  gfat-cell-lastsize : Integer = 89

  gfat-note-lastsize : Integer -> Integer
  gfat-note-lastsize (n) = xdiag-put gfat-cell-lastsize n

  gfat-cell-banklost : Integer = 90

  gfat-note-banklost : Integer -> Integer
  gfat-note-banklost (n) = xdiag-put gfat-cell-banklost n

  GfatMount = record {
    gm-ok : Boolean,
    gm-vol : Fat16Volume
  }

  gfat-null-vol : Fat16Volume
  gfat-null-vol = Fat16Volume {
    vol-part-start = 0, vol-bytes-per-sector = 0, vol-sectors-per-cluster = 0,
    vol-reserved-sectors = 0, vol-num-fats = 0, vol-root-entry-count = 0,
    vol-fat-sectors = 0, vol-fat-start = 0, vol-root-start = 0, vol-data-start = 0,
    vol-total-sectors = 0, vol-cluster-count = 0
  }

  gfat-is32 : Fat16Volume -> Boolean
  gfat-is32 (vol) = vol.vol-root-entry-count == 0

  gfat-parse-bpb : Integer, Integer -> Fat16Volume
  gfat-parse-bpb (part-start) (buf) =
    if fat16-read-u16 buf 22 /= 0 then fat16-parse-bpb part-start buf
    else let bps = fat16-read-u16 buf 11
    in let spc = peek-byte buf 13
    in let reserved = fat16-read-u16 buf 14
    in let nfats = peek-byte buf 16
    in let fatsz = fat16-read-u32 buf 36
    in let fat-start = part-start + reserved
    in let data-start = fat-start + nfats * fatsz
    in let total = fat16-total-sectors buf
    in let data-sectors = total - (data-start - part-start)
    in let clusters = if spc == 0 then 0 else if data-sectors <= 0 then 0 else data-sectors / spc
    in Fat16Volume {
      vol-part-start = part-start,
      vol-bytes-per-sector = bps,
      vol-sectors-per-cluster = spc,
      vol-reserved-sectors = reserved,
      vol-num-fats = nfats,
      vol-root-entry-count = 0,
      vol-fat-sectors = fatsz,
      vol-fat-start = fat-start,
      vol-root-start = fat16-read-u32 buf 44,
      vol-data-start = data-start,
      vol-total-sectors = total,
      vol-cluster-count = clusters
    }

  gfat-pow2-ok : Integer -> Boolean
  gfat-pow2-ok (n) = n > 0 & bit-and n (n - 1) == 0

  gfat-geometry-ok : Fat16Volume -> Boolean
  gfat-geometry-ok (vol) =
    let vol-end = (vol.vol-part-start) + (vol.vol-total-sectors)
    in gfat-pow2-ok (vol.vol-sectors-per-cluster)
    & (vol.vol-sectors-per-cluster) <= 128
    & (vol.vol-reserved-sectors) >= 1
    & (vol.vol-num-fats) >= 1
    & (vol.vol-num-fats) <= 2
    & (vol.vol-fat-sectors) > 0
    & (vol.vol-total-sectors) > 0
    & (vol.vol-cluster-count) > 0
    & (vol.vol-fat-start) >= (vol.vol-part-start)
    & (vol.vol-fat-start) < vol-end
    & (vol.vol-data-start) > (vol.vol-fat-start)
    & (vol.vol-data-start) < vol-end

  gfat-mount-at : Integer -> [Device.Port] GfatMount
  gfat-mount-at (part-start) = act
    b <- disk-read-sector part-start
    if b.dr-ok == False then let s = gfat-note-stage gfat-stage-bpb in GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else let vol = gfat-parse-bpb part-start (b.dr-buf)
    in if vol.vol-bytes-per-sector /= 512 then let s = gfat-note-stage gfat-stage-bps in GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else if gfat-geometry-ok vol == False then let s = gfat-note-stage gfat-stage-geom in GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else let s = gfat-note-stage gfat-stage-ok in GfatMount { gm-ok = True, gm-vol = vol }
  end

  gfat-mount-esp : [Device.Port] GfatMount
  gfat-mount-esp = act
    start <- gpt-esp-start
    if start == 0 then GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else gfat-mount-at start
  end

Section: FAT Chain

  gfat-is-end : Fat16Volume, Integer -> Boolean
  gfat-is-end (vol) (cluster) =
    if gfat-is32 vol then fat32-is-end cluster else fat16-is-end cluster

  gfat-cluster-ok : Fat16Volume, Integer -> Boolean
  gfat-cluster-ok (vol) (cluster) =
    cluster >= 2 & cluster < gfat-max-cluster vol

  gfat-next-cluster : Fat16Volume, Integer -> [Device.Port] Integer
  gfat-next-cluster (vol) (cluster) = act
    if gfat-is32 vol then act
      b <- disk-read-sector ((vol.vol-fat-start) + (cluster * 4) / (vol.vol-bytes-per-sector))
      if b.dr-ok then bit-and (fat16-read-u32 (b.dr-buf) (int-mod (cluster * 4) (vol.vol-bytes-per-sector))) 268435455 else 268435455
    end
    else act
      b <- disk-read-sector ((vol.vol-fat-start) + (cluster * 2) / (vol.vol-bytes-per-sector))
      if b.dr-ok then fat16-read-u16 (b.dr-buf) (int-mod (cluster * 2) (vol.vol-bytes-per-sector)) else 65535
    end
  end

Section: Directory Search

  gfat-read-entry32 : Integer, Integer -> Fat16DirEntry
  gfat-read-entry32 (buf) (off) =
    let e = fat16-read-dir-entry buf off
    in __record-set e "de-cluster" (bit-or (e.de-cluster) (bit-shl (fat16-read-u16 buf (off + 20)) 16))

  gfat-scan-entries32 : Integer, Text, Integer, Integer -> Maybe Fat16DirEntry
  gfat-scan-entries32 (buf) (name) (i) (count) =
    if i >= count then None
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then None
      else gfat-scan-entries32 buf name (i + 1) count
    else if fat16-is-lfn-entry buf off then gfat-scan-entries32 buf name (i + 1) count
    else if fat16-is-volume-label buf off then gfat-scan-entries32 buf name (i + 1) count
    else let entry = gfat-read-entry32 buf off
    in if fat16-name-matches (entry.de-name) name then Just entry
    else gfat-scan-entries32 buf name (i + 1) count

  gfat-scan-entries : Fat16Volume, Integer, Text -> Maybe Fat16DirEntry
  gfat-scan-entries (vol) (buf) (name) =
    if gfat-is32 vol then gfat-scan-entries32 buf name 0 ((vol.vol-bytes-per-sector) / 32)
    else fat16-scan-sector-entries buf name 0 ((vol.vol-bytes-per-sector) / 32)

  gfat-find-in-root : Fat16Volume, Text -> [Device.Port] Maybe Fat16DirEntry
  gfat-find-in-root (vol) (name) =
    if gfat-is32 vol then gfat-find-in-dir vol (vol.vol-root-start) name
    else let root-sectors = ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)
    in gfat-scan-root vol name (vol.vol-root-start) root-sectors

  gfat-scan-root : Fat16Volume, Text, Integer, Integer -> [Device.Port] Maybe Fat16DirEntry
  gfat-scan-root (vol) (name) (sector) (remaining) = act
    if remaining <= 0 then None
    else act
      b <- disk-read-sector sector
      if b.dr-ok == False then None
      else when gfat-scan-entries vol (b.dr-buf) name
        is Just (entry) -> Just entry
        is None -> gfat-scan-root vol name (sector + 1) (remaining - 1)
    end
  end

  gfat-find-in-dir : Fat16Volume, Integer, Text -> [Device.Port] Maybe Fat16DirEntry
  gfat-find-in-dir (vol) (cluster) (name) = act
    if gfat-is-end vol cluster then None
    else if gfat-cluster-ok vol cluster == False then None
    else act
      hit <- gfat-scan-cluster vol name (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster)
      when hit
        is Just (entry) -> Just entry
        is None -> act
          nxt <- gfat-next-cluster vol cluster
          gfat-find-in-dir vol nxt name
        end
    end
  end

  gfat-scan-cluster : Fat16Volume, Text, Integer, Integer -> [Device.Port] Maybe Fat16DirEntry
  gfat-scan-cluster (vol) (name) (sector) (remaining) = act
    if remaining <= 0 then None
    else act
      b <- disk-read-sector sector
      if b.dr-ok == False then None
      else when gfat-scan-entries vol (b.dr-buf) name
        is Just (entry) -> Just entry
        is None -> gfat-scan-cluster vol name (sector + 1) (remaining - 1)
    end
  end

Section: Path Resolution

  gfat-resolve : Fat16Volume, Text -> [Device.Port] Maybe Fat16DirEntry
  gfat-resolve (vol) (path) = act
    let parts = fat16-split-path path
    in if list-length parts == 0 then None
    else act
      first <- gfat-find-in-root vol (list-at parts 0)
      when first
        is None -> None
        is Just (e) -> gfat-walk vol parts 1 (list-length parts) e
    end
  end

  gfat-walk : Fat16Volume, List Text, Integer, Integer, Fat16DirEntry -> [Device.Port] Maybe Fat16DirEntry
  gfat-walk (vol) (parts) (depth) (total) (e) = act
    if depth >= total then Just e
    else if bit-and (e.de-attr) 16 /= 16 then None
    else act
      nxt <- gfat-find-in-dir vol (e.de-cluster) (list-at parts depth)
      when nxt
        is None -> None
        is Just (e2) -> gfat-walk vol parts (depth + 1) total e2
    end
  end

Section: Directory Listing

  gfat-dot-entry : Text -> Boolean
  gfat-dot-entry (name) = if name == "." then True else name == ".."

  gfat-collect-entries : Fat16Volume, Integer, List Fat16DirEntry -> List Fat16DirEntry
  gfat-collect-entries (vol) (buf) (acc) =
    gfat-collect-loop vol buf 0 ((vol.vol-bytes-per-sector) / 32) acc

  gfat-collect-loop : Fat16Volume, Integer, Integer, Integer, List Fat16DirEntry -> List Fat16DirEntry
  gfat-collect-loop (vol) (buf) (i) (count) (acc) =
    if i >= count then acc
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then acc
      else gfat-collect-loop vol buf (i + 1) count acc
    else if fat16-is-lfn-entry buf off then gfat-collect-loop vol buf (i + 1) count acc
    else if fat16-is-volume-label buf off then gfat-collect-loop vol buf (i + 1) count acc
    else let entry = if gfat-is32 vol then gfat-read-entry32 buf off else fat16-read-dir-entry buf off
    in if gfat-dot-entry (entry.de-name) then gfat-collect-loop vol buf (i + 1) count acc
    else gfat-collect-loop vol buf (i + 1) count (list-push acc entry)

  gfat-sector-has-end : Integer, Integer -> Boolean
  gfat-sector-has-end (buf) (count) = gfat-has-end-loop buf 0 count

  gfat-has-end-loop : Integer, Integer, Integer -> Boolean
  gfat-has-end-loop (buf) (i) (count) =
    if i >= count then False
    else if peek-byte buf (i * 32) == 0 then True
    else gfat-has-end-loop buf (i + 1) count

  gfat-list-walk : Fat16Volume, Integer, Integer, Integer, List Fat16DirEntry -> [Device.Port] List Fat16DirEntry
  gfat-list-walk (vol) (sector) (remaining) (cluster) (acc) = act
    if remaining <= 0 then
      if cluster < 0 then acc
      else act
        nxt <- gfat-next-cluster vol cluster
        if gfat-is-end vol nxt then acc
        else if gfat-cluster-ok vol nxt == False then acc
        else gfat-list-walk vol (fat16-cluster-sector vol nxt) (vol.vol-sectors-per-cluster) nxt acc
      end
    else act
      b <- disk-read-sector sector
      if b.dr-ok == False then acc
      else let acc2 = gfat-collect-entries vol (b.dr-buf) acc
      in if gfat-sector-has-end (b.dr-buf) ((vol.vol-bytes-per-sector) / 32) then acc2
      else gfat-list-walk vol (sector + 1) (remaining - 1) cluster acc2
    end
  end

  gfat-list-dir : Fat16Volume, Integer -> [Device.Port] List Fat16DirEntry
  gfat-list-dir (vol) (cluster) =
    if gfat-cluster-ok vol cluster == False then []
    else gfat-list-walk vol (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster) cluster []

  gfat-list-root : Fat16Volume -> [Device.Port] List Fat16DirEntry
  gfat-list-root (vol) =
    if gfat-is32 vol then gfat-list-dir vol (vol.vol-root-start)
    else let root-sectors = ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)
    in gfat-list-walk vol (vol.vol-root-start) root-sectors (-1) []

Section: Windowed Listing

  GfatCursor = record {
    gc-sector : Integer,
    gc-remaining : Integer,
    gc-cluster : Integer,
    gc-index : Integer,
    gc-done : Boolean
  }

  gfat-slot : Integer, Integer -> Integer
  gfat-slot (buf) (off) =
    if fat16-is-free-entry buf off then (if peek-byte buf off == 0 then 0 else 1)
    else if fat16-is-lfn-entry buf off then 1
    else if fat16-is-volume-label buf off then 1
    else if peek-byte buf off == 46 then 1
    else 2

  gfat-slot-count : Integer, Integer, Integer, Integer -> Integer
  gfat-slot-count (buf) (i) (per) (acc) =
    if i >= per then acc
    else let k = gfat-slot buf (i * 32)
    in if k == 0 then acc
    else gfat-slot-count buf (i + 1) per (if k == 2 then acc + 1 else acc)

  gfat-slot-take : Fat16Volume, Integer, Integer, Integer, Integer, Integer, Integer, List Fat16DirEntry -> List Fat16DirEntry
  gfat-slot-take (vol) (buf) (i) (per) (idx) (from) (upto) (acc) =
    if i >= per then acc
    else let off = i * 32
    in let k = gfat-slot buf off
    in if k == 0 then acc
    else if k == 1 then gfat-slot-take vol buf (i + 1) per idx from upto acc
    else if idx < from | idx >= upto then gfat-slot-take vol buf (i + 1) per (idx + 1) from upto acc
    else let e = if gfat-is32 vol then gfat-read-entry32 buf off else fat16-read-dir-entry buf off
    in gfat-slot-take vol buf (i + 1) per (idx + 1) from upto (list-push acc e)

  gfat-cursor-at : Fat16Volume, Integer -> GfatCursor
  gfat-cursor-at (vol) (cur) =
    if cur < 0 then GfatCursor { gc-sector = vol.vol-root-start, gc-remaining = ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector), gc-cluster = 0 - 1, gc-index = 0, gc-done = False }
    else if gfat-cluster-ok vol cur == False then GfatCursor { gc-sector = 0, gc-remaining = 0, gc-cluster = 0 - 1, gc-index = 0, gc-done = True }
    else GfatCursor { gc-sector = fat16-cluster-sector vol cur, gc-remaining = vol.vol-sectors-per-cluster, gc-cluster = cur, gc-index = 0, gc-done = False }

  gfat-cursor-done : GfatCursor -> Integer
  gfat-cursor-done (c) =
    let d = __record-set c "gc-done" True
    in 0

  gfat-cursor-hop : Fat16Volume, GfatCursor -> [Device.Port] Integer
  gfat-cursor-hop (vol) (c) =
    if c.gc-cluster < 0 then gfat-cursor-done c
    else let mk = __heap-save
    in act
      nxt <- gfat-next-cluster vol (c.gc-cluster)
      let r = __heap-restore mk
      in if gfat-is-end vol nxt | gfat-cluster-ok vol nxt == False then gfat-cursor-done c
      else let a = __record-set c "gc-cluster" nxt
      in let b = __record-set c "gc-sector" (fat16-cluster-sector vol nxt)
      in let d = __record-set c "gc-remaining" (vol.vol-sectors-per-cluster)
      in 0
    end

  gfat-cursor-next : GfatCursor, Integer, Boolean -> Integer
  gfat-cursor-next (c) (k) (ended) =
    let a = __record-set c "gc-index" (c.gc-index + k)
    in if ended then gfat-cursor-done c
    else let b = __record-set c "gc-sector" (c.gc-sector + 1)
    in let d = __record-set c "gc-remaining" (c.gc-remaining - 1)
    in 0

  gfat-seek : Fat16Volume, GfatCursor, Integer -> [Device.Port] Integer
  gfat-seek (vol) (c) (from) = act
    if c.gc-done then 0
    else if c.gc-remaining <= 0 then act
      h <- gfat-cursor-hop vol c
      gfat-seek vol c from
    end
    else let mk = __heap-save
    in act
      b <- disk-read-sector (c.gc-sector)
      let per = (vol.vol-bytes-per-sector) / 32
      in let k = if b.dr-ok then gfat-slot-count (b.dr-buf) 0 per 0 else 0
      in let ended = if b.dr-ok then gfat-sector-has-end (b.dr-buf) per else True
      in let r = __heap-restore mk
      in if c.gc-index + k > from then 0
      else let n = gfat-cursor-next c k ended
      in gfat-seek vol c from
    end
  end

  gfat-take : Fat16Volume, GfatCursor, Integer, Integer, List Fat16DirEntry -> [Device.Port] List Fat16DirEntry
  gfat-take (vol) (c) (from) (upto) (acc) = act
    if c.gc-done | c.gc-index >= upto then acc
    else if c.gc-remaining <= 0 then act
      h <- gfat-cursor-hop vol c
      gfat-take vol c from upto acc
    end
    else act
      b <- disk-read-sector (c.gc-sector)
      if b.dr-ok == False then acc
      else let per = (vol.vol-bytes-per-sector) / 32
      in let acc2 = gfat-slot-take vol (b.dr-buf) 0 per (c.gc-index) from upto acc
      in let n = gfat-cursor-next c (gfat-slot-count (b.dr-buf) 0 per 0) (gfat-sector-has-end (b.dr-buf) per)
      in gfat-take vol c from upto acc2
    end
  end

  gfat-dir-count : Fat16Volume, Integer -> [Device.Port] Integer
  gfat-dir-count (vol) (cur) =
    let c = gfat-cursor-at vol cur
    in act
      s <- gfat-seek vol c 2147483647
      c.gc-index
    end

  gfat-dir-window : Fat16Volume, Integer, Integer, Integer -> [Device.Port] List Fat16DirEntry
  gfat-dir-window (vol) (cur) (from) (n) =
    let c = gfat-cursor-at vol cur
    in act
      s <- gfat-seek vol c from
      gfat-take vol c from (from + n) []
    end

Section: File Reading

  gfat-read-into : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-read-into (vol) (cluster) (size) (dest) =
    gfat-read-loop vol cluster size dest 0 0

  gfat-read-loop : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-read-loop (vol) (cluster) (remaining) (dest) (written) (sector-off) = act
    if remaining <= 0 then written
    else if gfat-is-end vol cluster then written
    else if gfat-cluster-ok vol cluster == False then written
    else act
      b <- disk-read-sector (fat16-cluster-sector vol cluster + sector-off)
      if b.dr-ok == False then written
      else let bps = vol.vol-bytes-per-sector
      in let n = if remaining < bps then remaining else bps
      in let c = gfat-copy (b.dr-buf) dest written n 0
      in let off2 = sector-off + 1
      in if off2 >= (vol.vol-sectors-per-cluster)
        then act
          nxt <- gfat-next-cluster vol cluster
          gfat-read-loop vol nxt (remaining - n) dest (written + n) 0
        end
        else gfat-read-loop vol cluster (remaining - n) dest (written + n) off2
    end
  end

  gfat-copy : Integer, Integer, Integer, Integer, Integer -> Integer
  gfat-copy (src) (dest) (dest-off) (n) (i) =
    if i >= n then 0
    else let w = poke-byte dest (dest-off + i) (peek-byte src i)
    in gfat-copy src dest dest-off n (i + 1)

  GfatFile = record {
    gf-ok : Boolean,
    gf-buf : Integer,
    gf-len : Integer
  }

  gfat-read-file : Fat16Volume, Text -> [Device.Port] GfatFile
  gfat-read-file (vol) (path) = act
    e <- gfat-resolve vol path
    when e
      is None -> GfatFile { gf-ok = False, gf-buf = 0, gf-len = 0 }
      is Just (entry) -> act
        let dest = __heap-save
        in let adv = __heap-advance (entry.de-size + 8)
        in act
          n <- gfat-read-into vol (entry.de-cluster) (entry.de-size) dest
          GfatFile { gf-ok = n == entry.de-size, gf-buf = dest, gf-len = n }
        end
      end
  end

Section: Bulk File Reading

  GfatFat = record {
    gft-ok : Boolean,
    gft-buf : Integer
  }

  gfat-load-fat : Fat16Volume -> [Device.Port] GfatFat
  gfat-load-fat (vol) = act
    let n = vol.vol-fat-sectors
    in let buf = __heap-save
    in let adv = __heap-advance (n * 512 + 8)
    in act
      ok <- disk-read-into (vol.vol-fat-start) n buf
      GfatFat { gft-ok = ok, gft-buf = buf }
    end
  end

  gfat-fat-next : Fat16Volume, Integer, Integer -> Integer
  gfat-fat-next (vol) (fat) (cluster) =
    if gfat-is32 vol then bit-and (fat16-read-u32 fat (cluster * 4)) 268435455
    else fat16-read-u16 fat (cluster * 2)

  gfat-run-length : Fat16Volume, Integer, Integer, Integer, Integer -> Integer
  gfat-run-length (vol) (fat) (cluster) (cap) (n) =
    if n >= cap then n
    else if gfat-cluster-ok vol cluster == False then n
    else let nxt = gfat-fat-next vol fat cluster
    in if nxt == cluster + 1 then gfat-run-length vol fat (cluster + 1) cap (n + 1)
    else n + 1

  gfat-read-runs : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-read-runs (vol) (fat) (cluster) (sectors-left) (dest) (written) = act
    if sectors-left <= 0 then written
    else if gfat-is-end vol cluster then written
    else if gfat-cluster-ok vol cluster == False then written
    else act
      let spc = vol.vol-sectors-per-cluster
      in let clusters-left = (sectors-left + spc - 1) / spc
      in let run = gfat-run-length vol fat cluster clusters-left 0
      in let run-sectors = if run * spc > sectors-left then sectors-left else run * spc
      in act
        ok <- disk-read-into (fat16-cluster-sector vol cluster) run-sectors (dest + written * 512)
        if ok == False then written
        else act
          nxt <- gfat-fat-next vol fat (cluster + run - 1)
          gfat-read-runs vol fat nxt (sectors-left - run-sectors) dest (written + run-sectors)
        end
      end
    end
  end

  gfat-read-file-bulk : Fat16Volume, Text, Integer -> [Device.Port] Integer
  gfat-read-file-bulk (vol) (path) (dest) = act
    e <- gfat-resolve vol path
    when e
      is None -> 0
      is Just (entry) -> act
        f <- gfat-load-fat vol
        if f.gft-ok == False then 0
        else act
          let sectors = (entry.de-size + 511) / 512
          in act
            got <- gfat-read-runs vol (f.gft-buf) (entry.de-cluster) sectors dest 0
            if got * 512 >= entry.de-size then entry.de-size else 0
          end
        end
      end
    end
  end

  gfat-file-size : Fat16Volume, Text -> [Device.Port] Integer
  gfat-file-size (vol) (path) = act
    e <- gfat-resolve vol path
    when e
      is None -> 0
      is Just (entry) -> entry.de-size
    end
  end

  gfat-text : Integer, Integer, Integer, Text -> Text
  gfat-text (buf) (i) (n) (acc) =
    if i >= n then acc
    else let cp = from-unicode (peek-byte buf i)
    in if cp < 0 then gfat-text buf (i + 1) n acc
    else gfat-text buf (i + 1) n (acc & char-encode (code-to-char cp))

Section: Writing

  gfat-w-oversize : Integer = 1
  gfat-w-s-fatload : Integer = 2
  gfat-w-s-nospace : Integer = 3
  gfat-w-s-fat : Integer = 4
  gfat-w-s-data : Integer = 5
  gfat-w-s-noslot : Integer = 6
  gfat-w-s-direntry : Integer = 7
  gfat-w-s-collide : Integer = 8

  gfat-w-fatload : Integer = 11
  gfat-w-nospace : Integer = 12
  gfat-w-flush : Integer = 13
  gfat-w-data : Integer = 14
  gfat-w-noslot : Integer = 15
  gfat-w-direntry : Integer = 16
  gfat-w-collide : Integer = 17

  gfat-w-ok : Integer = 20
  gfat-w-dirty : Integer = 100

  gfat-put-u16 : Integer, Integer, Integer -> Integer
  gfat-put-u16 (buf) (off) (v) =
    let a = poke-byte buf off (bit-and v 255)
    in poke-byte buf (off + 1) (bit-and (bit-shru v 8) 255)

  gfat-put-u32 : Integer, Integer, Integer -> Integer
  gfat-put-u32 (buf) (off) (v) =
    let a = gfat-put-u16 buf off (bit-and v 65535)
    in gfat-put-u16 buf (off + 2) (bit-and (bit-shru v 16) 65535)

  gfat-max-cluster : Fat16Volume -> Integer
  gfat-max-cluster (vol) =
    let width = if gfat-is32 vol then 4 else 2
    in let cap = (vol.vol-fat-sectors) * (vol.vol-bytes-per-sector) / width
    in let limit = fat16-last-cluster vol + 1
    in if limit < cap then limit else cap

  gfat-find-free : Fat16Volume, Integer, Integer, Integer -> Integer
  gfat-find-free (vol) (fat) (cluster) (max-cluster) =
    if cluster >= max-cluster then 0
    else if gfat-fat-next vol fat cluster == 0 then cluster
    else gfat-find-free vol fat (cluster + 1) max-cluster

  gfat-count-free : Fat16Volume, Integer, Integer, Integer, Integer -> Integer
  gfat-count-free (vol) (fat) (cluster) (max-cluster) (acc) =
    if cluster >= max-cluster then acc
    else gfat-count-free vol fat (cluster + 1) max-cluster (if gfat-fat-next vol fat cluster == 0 then acc + 1 else acc)

  gfat-set-fat-entry : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-set-fat-entry (vol) (cluster) (value) (copy) = act
    let width = if gfat-is32 vol then 4 else 2
    in let byte-off = cluster * width
    in let sec-in-fat = byte-off / (vol.vol-bytes-per-sector)
    in let off-in-sec = int-mod byte-off (vol.vol-bytes-per-sector)
    in let lba = (vol.vol-fat-start) + copy * (vol.vol-fat-sectors) + sec-in-fat
    in act
      b <- disk-read-sector lba
      if b.dr-ok == False then False
      else let p = if gfat-is32 vol
        then gfat-put-u32 (b.dr-buf) off-in-sec (bit-or (bit-and (fat16-read-u32 (b.dr-buf) off-in-sec) 4026531840) (bit-and value 268435455))
        else gfat-put-u16 (b.dr-buf) off-in-sec value
      in disk-write-into lba 1 (b.dr-buf)
    end
  end

  gfat-eoc : Fat16Volume -> Integer
  gfat-eoc (vol) = if gfat-is32 vol then 268435455 else 65535

  gfat-mark-both : Fat16Volume, Integer, Integer -> [Device.Port] Boolean
  gfat-mark-both (vol) (cluster) (value) = act
    a <- gfat-set-fat-entry vol cluster value 0
    if a == False then False
    else if vol.vol-num-fats < 2 then True
    else gfat-set-fat-entry vol cluster value 1
  end

  gfat-mark-eoc : Fat16Volume, Integer -> [Device.Port] Boolean
  gfat-mark-eoc (vol) (cluster) = gfat-mark-both vol cluster (gfat-eoc vol)

  gfat-root-slot : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-root-slot (vol) (name-buf) (sector) (remaining) (checked) = act
    if remaining <= 0 then -1
    else if checked >= (vol.vol-root-entry-count) then -1
    else act
      b <- disk-read-sector sector
      if b.dr-ok == False then -1
      else let hit = gfat-slot-in-sector (b.dr-buf) name-buf 0 ((vol.vol-bytes-per-sector) / 32)
      in if hit >= 0 then sector * 4096 + hit
      else gfat-root-slot vol name-buf (sector + 1) (remaining - 1) (checked + ((vol.vol-bytes-per-sector) / 32))
    end
  end

  gfat-dir-slot32 : Fat16Volume, Integer, Integer -> [Device.Port] Integer
  gfat-dir-slot32 (vol) (name-buf) (cluster) = act
    if gfat-is-end vol cluster then -1
    else if gfat-cluster-ok vol cluster == False then -1
    else act
      hit <- gfat-slot-in-cluster vol name-buf (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster)
      if hit >= 0 then hit
      else act
        nxt <- gfat-next-cluster vol cluster
        gfat-dir-slot32 vol name-buf nxt
      end
    end
  end

  gfat-slot-in-cluster : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-slot-in-cluster (vol) (name-buf) (sector) (remaining) = act
    if remaining <= 0 then -1
    else act
      b <- disk-read-sector sector
      if b.dr-ok == False then -1
      else let hit = gfat-slot-in-sector (b.dr-buf) name-buf 0 ((vol.vol-bytes-per-sector) / 32)
      in if hit >= 0 then sector * 4096 + hit
      else gfat-slot-in-cluster vol name-buf (sector + 1) (remaining - 1)
    end
  end

  gfat-slot-in-sector : Integer, Integer, Integer, Integer -> Integer
  gfat-slot-in-sector (buf) (name-buf) (i) (count) =
    if i >= count then -1
    else let off = i * 32
    in if gfat-name-eq buf off name-buf then off
    else let first = peek-byte buf off
    in if first == 0 | first == 229 then off
    else gfat-slot-in-sector buf name-buf (i + 1) count

  gfat-name-eq : Integer, Integer, Integer -> Boolean
  gfat-name-eq (buf) (off) (name-buf) = gfat-name-eq-loop buf off name-buf 0

  gfat-name-eq-loop : Integer, Integer, Integer, Integer -> Boolean
  gfat-name-eq-loop (buf) (off) (name-buf) (i) =
    if i >= 11 then True
    else if peek-byte buf (off + i) /= peek-byte name-buf i then False
    else gfat-name-eq-loop buf off name-buf (i + 1)

  gfat-write-dir-entry : Integer, Integer, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-dir-entry (name-buf) (slot) (cluster) (size) (bytes-per-sector) = act
    let lba = slot / 4096
    in let off = int-mod slot 4096
    in act
      b <- disk-read-sector lba
      if b.dr-ok == False then False
      else let buf = b.dr-buf
      in let nm = gfat-copy name-buf buf off 11 0
      in let z = gfat-zero-range buf (off + 11) 21
      in let at = poke-byte buf (off + 11) 32
      in let ch = gfat-put-u16 buf (off + 20) (bit-shru cluster 16)
      in let cl = gfat-put-u16 buf (off + 26) (bit-and cluster 65535)
      in let sz = gfat-put-u32 buf (off + 28) size
      in disk-write-into lba 1 buf
    end
  end

  gfat-zero-range : Integer, Integer, Integer -> Integer
  gfat-zero-range (buf) (off) (n) =
    if n <= 0 then 0
    else let w = poke-byte buf off 0
    in gfat-zero-range buf (off + 1) (n - 1)

  gfat-write-small-file : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-small-file (vol) (name-buf) (src) (size) = gfat-write-small-file-in vol name-buf src size (-1)

  gfat-write-small-file-in : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-small-file-in (vol) (name-buf) (src) (size) (dir) = act
    if size > (vol.vol-bytes-per-sector) * (vol.vol-sectors-per-cluster) then let s = gfat-note-write gfat-w-oversize in False
    else act
      f <- gfat-load-fat vol
      if f.gft-ok == False then let s = gfat-note-write gfat-w-s-fatload in False
      else let free = gfat-find-free vol (f.gft-buf) 2 (gfat-max-cluster vol)
      in if free == 0 then let s = gfat-note-write gfat-w-s-nospace in False
      else act
        clear <- gfat-chain-is-clear vol (f.gft-buf) free 1
        if clear == False then let s = gfat-note-write gfat-w-s-collide in False
        else gfat-small-commit vol name-buf src size free dir
      end
    end
  end

  gfat-small-commit : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-small-commit (vol) (name-buf) (src) (size) (free) (dir) = act
    dw <- disk-write-into (fat16-cluster-sector vol free) (vol.vol-sectors-per-cluster) src
    if dw == False then let s = gfat-note-write gfat-w-s-data in False
    else act
      slot <- gfat-find-slot-in vol name-buf dir
      if slot < 0 then let s = gfat-note-write gfat-w-s-noslot in False
      else act
        eoc <- gfat-mark-eoc vol free
        if eoc == False then let s = gfat-note-write gfat-w-s-fat in False
        else act
          de <- gfat-write-dir-entry name-buf slot free size (vol.vol-bytes-per-sector)
          if de then let s = gfat-note-write gfat-w-ok in True
          else act
            rb <- gfat-mark-both vol free 0
            let s = gfat-note-write (if rb then gfat-w-s-direntry else gfat-w-s-direntry + gfat-w-dirty)
            in False
          end
        end
      end
    end
  end

  gfat-find-slot : Fat16Volume, Integer -> [Device.Port] Integer
  gfat-find-slot (vol) (name-buf) = gfat-find-slot-in vol name-buf (-1)

  gfat-find-slot-in : Fat16Volume, Integer, Integer -> [Device.Port] Integer
  gfat-find-slot-in (vol) (name-buf) (dir) = act
    if dir >= 2 then gfat-dir-slot32 vol name-buf dir
    else if gfat-is32 vol then gfat-dir-slot32 vol name-buf (vol.vol-root-start)
    else gfat-root-slot vol name-buf (vol.vol-root-start) (((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)) 0
  end

Section: Multi-Cluster Writing

  gfat-write-cap : Integer = 64

  gfat-fat-put : Fat16Volume, Integer, Integer, Integer -> Integer
  gfat-fat-put (vol) (fat) (cluster) (value) =
    if gfat-is32 vol then gfat-put-u32 fat (cluster * 4) (bit-or (bit-and (fat16-read-u32 fat (cluster * 4)) 4026531840) (bit-and value 268435455))
    else gfat-put-u16 fat (cluster * 2) value

  gfat-chain-alloc : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> Integer
  gfat-chain-alloc (vol) (fat) (need) (from) (first) (prev) =
    if need <= 0 then first
    else let free = gfat-find-free vol fat from (gfat-max-cluster vol)
    in if free == 0 then 0
    else let l = if prev == 0 then 0 else gfat-fat-put vol fat prev free
    in let m = gfat-fat-put vol fat free (gfat-eoc vol)
    in gfat-chain-alloc vol fat (need - 1) (free + 1) (if first == 0 then free else first) free

  gfat-no-report : Integer, Integer -> Integer
  gfat-no-report (ctx) (done) = 0

  gfat-write-sectors : Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-sectors (lba) (count) (src) =
    gfat-write-sectors-watched lba count src 0 0 gfat-no-report

  gfat-write-sectors-watched : Integer, Integer, Integer, Integer, Integer, (Integer, Integer -> Integer) -> [Device.Port] Boolean
  gfat-write-sectors-watched (lba) (count) (src) (done) (ctx) (report) = act
    if count <= 0 then True
    else let n = if count > gfat-write-cap then gfat-write-cap else count
    in act
      ok <- disk-write-into lba n src
      if ok == False then False
      else let r = report ctx (done + n)
      in gfat-write-sectors-watched (lba + n) (count - n) (src + n * 512) (done + n) ctx report
    end
  end

  gfat-flush-fat : Fat16Volume, Integer -> [Device.Port] Boolean
  gfat-flush-fat (vol) (fat) = act
    a <- gfat-write-sectors (vol.vol-fat-start) (vol.vol-fat-sectors) fat
    if a == False then False
    else if vol.vol-num-fats < 2 then True
    else gfat-write-sectors ((vol.vol-fat-start) + (vol.vol-fat-sectors)) (vol.vol-fat-sectors) fat
  end

  gfat-chain-release : Fat16Volume, Integer, Integer, Integer -> Integer
  gfat-chain-release (vol) (fat) (cluster) (fuel) =
    if fuel <= 0 then 0
    else if gfat-cluster-ok vol cluster == False then 0
    else if gfat-is-end vol cluster then 0
    else let nxt = gfat-fat-next vol fat cluster
    in let z = gfat-fat-put vol fat cluster 0
    in gfat-chain-release vol fat nxt (fuel - 1)

  gfat-rollback-chain : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-rollback-chain (vol) (fat) (first) (fuel) = act
    let r = gfat-chain-release vol fat first fuel
    in gfat-flush-fat vol fat
  end

  gfat-bit-set : Integer, Integer -> Integer
  gfat-bit-set (bm) (i) =
    poke-byte bm (i / 8) (bit-or (peek-byte bm (i / 8)) (bit-shl 1 (int-mod i 8)))

  gfat-bit-get : Integer, Integer -> Boolean
  gfat-bit-get (bm) (i) =
    bit-and (peek-byte bm (i / 8)) (bit-shl 1 (int-mod i 8)) /= 0

  gfat-mark-chain : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> Integer
  gfat-mark-chain (vol) (fat) (bm) (cluster) (limit) (fuel) =
    if fuel <= 0 then 0
    else if cluster < 2 then fuel
    else if cluster >= limit then fuel
    else if gfat-is-end vol cluster then fuel
    else let m = gfat-bit-set bm cluster
    in gfat-mark-chain vol fat bm (gfat-fat-next vol fat cluster) limit (fuel - 1)

  gfat-mark-depth : Integer = 8

  gfat-mark-entries : Fat16Volume, Integer, Integer, List Fat16DirEntry, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-mark-entries (vol) (fat) (bm) (es) (i) (limit) (fuel) (depth) = act
    if i >= list-length es then fuel
    else if fuel <= 0 then 0
    else act
      rest <- gfat-mark-one vol fat bm (list-at es i) limit fuel depth
      gfat-mark-entries vol fat bm es (i + 1) limit rest depth
    end
  end

  gfat-mark-one : Fat16Volume, Integer, Integer, Fat16DirEntry, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-mark-one (vol) (fat) (bm) (e) (limit) (fuel) (depth) = act
    let after = gfat-mark-chain vol fat bm (e.de-cluster) limit fuel
    in if bit-and (e.de-attr) 16 /= 16 then after
    else if depth <= 0 then after
    else if e.de-cluster < 2 then after
    else if after <= 0 then after
    else act
      let mark = __heap-save
      in act
        kids <- gfat-list-dir vol (e.de-cluster)
        r <- gfat-mark-entries vol fat bm kids 0 limit after (depth - 1)
        let d = __heap-restore mark
        in r
      end
    end
  end

  gfat-chain-hits : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> Boolean
  gfat-chain-hits (vol) (fat) (bm) (cluster) (limit) (fuel) =
    if fuel <= 0 then False
    else if cluster < 2 then False
    else if cluster >= limit then False
    else if gfat-is-end vol cluster then False
    else if gfat-bit-get bm cluster then True
    else gfat-chain-hits vol fat bm (gfat-fat-next vol fat cluster) limit (fuel - 1)

  gfat-chain-is-clear : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-chain-is-clear (vol) (fat) (first) (need) = act
    let limit = gfat-max-cluster vol
    in let bytes = limit / 8 + 8
    in let bm = __heap-save
    in let adv = __heap-advance bytes
    in let z = gfat-zero-range bm 0 bytes
    in act
      es <- gfat-list-root vol
      m <- gfat-mark-entries vol fat bm es 0 limit (limit + 1) gfat-mark-depth
      if gfat-chain-hits vol fat bm first limit (need + 1) then False else True
    end
  end

  gfat-write-runs : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Port] Integer
  gfat-write-runs (vol) (fat) (cluster) (sectors-left) (src) (written) =
    gfat-write-runs-watched vol fat cluster sectors-left src written 0 gfat-no-report

  gfat-write-runs-watched : Fat16Volume, Integer, Integer, Integer, Integer, Integer, Integer, (Integer, Integer -> Integer) -> [Device.Port] Integer
  gfat-write-runs-watched (vol) (fat) (cluster) (sectors-left) (src) (written) (ctx) (report) = act
    if sectors-left <= 0 then written
    else if gfat-is-end vol cluster then written
    else if gfat-cluster-ok vol cluster == False then written
    else act
      let spc = vol.vol-sectors-per-cluster
      in let clusters-left = (sectors-left + spc - 1) / spc
      in let run = gfat-run-length vol fat cluster clusters-left 0
      in let run-sectors = if run * spc > sectors-left then sectors-left else run * spc
      in act
        ok <- gfat-write-sectors-watched (fat16-cluster-sector vol cluster) run-sectors (src + written * 512) written ctx report
        if ok == False then written
        else act
          nxt <- gfat-fat-next vol fat (cluster + run - 1)
          gfat-write-runs-watched vol fat nxt (sectors-left - run-sectors) src (written + run-sectors) ctx report
        end
      end
    end
  end

  gfat-write-file : Fat16Volume, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-file (vol) (name-buf) (src) (size) = gfat-write-file-in vol name-buf src size (-1)

  gfat-write-file-in : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-write-file-in (vol) (name-buf) (src) (size) (dir) =
    gfat-write-file-in-watched vol name-buf src size dir 0 gfat-no-report

  gfat-write-file-in-watched : Fat16Volume, Integer, Integer, Integer, Integer, Integer, (Integer, Integer -> Integer) -> [Device.Port] Boolean
  gfat-write-file-in-watched (vol) (name-buf) (src) (size) (dir) (ctx) (report) = act
    let cbytes = (vol.vol-bytes-per-sector) * (vol.vol-sectors-per-cluster)
    in if size <= cbytes then gfat-write-small-file-in vol name-buf src size dir
    else act
      f <- gfat-load-fat vol
      if f.gft-ok == False then let s = gfat-note-write gfat-w-fatload in False
      else let need = (size + cbytes - 1) / cbytes
      in let first = gfat-chain-alloc vol (f.gft-buf) need 2 0 0
      in if first == 0 then let s = gfat-note-write gfat-w-nospace in False
      else act
        clear <- gfat-chain-is-clear vol (f.gft-buf) first need
        if clear == False then let s = gfat-note-write gfat-w-collide in False
        else gfat-big-commit-watched vol (f.gft-buf) name-buf src size first need dir ctx report
      end
    end
  end

  gfat-big-commit : Fat16Volume, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device.Port] Boolean
  gfat-big-commit (vol) (fat) (name-buf) (src) (size) (first) (need) (dir) =
    gfat-big-commit-watched vol fat name-buf src size first need dir 0 gfat-no-report

  gfat-big-commit-watched : Fat16Volume, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, (Integer, Integer -> Integer) -> [Device.Port] Boolean
  gfat-big-commit-watched (vol) (fat) (name-buf) (src) (size) (first) (need) (dir) (ctx) (report) = act
    let sectors = (size + 511) / 512
    in act
      wr <- gfat-write-runs-watched vol fat first sectors src 0 ctx report
      let w = gfat-note-written wr
      in if wr < sectors then let s = gfat-note-write gfat-w-data in False
      else act
        slot <- gfat-find-slot-in vol name-buf dir
        if slot < 0 then let s = gfat-note-write gfat-w-noslot in False
        else act
          ff <- gfat-flush-fat vol fat
          if ff == False then let s = gfat-note-write gfat-w-flush in False
          else act
            de <- gfat-write-dir-entry name-buf slot first size (vol.vol-bytes-per-sector)
            if de then let s = gfat-note-write gfat-w-ok in True
            else act
              rb <- gfat-rollback-chain vol fat first (need + 1)
              let s = gfat-note-write (if rb then gfat-w-direntry else gfat-w-direntry + gfat-w-dirty)
              in False
            end
          end
        end
      end
    end
  end
