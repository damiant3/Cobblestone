 We say:

Section: Palette and Geometry

  gfl-bg : Palette -> Integer
  gfl-bg (p) = p.pal-muted

  gfl-title : Palette -> Integer
  gfl-title (p) = p.pal-secondary

  gfl-text : Palette -> Integer
  gfl-text (p) = p.pal-fg

  gfl-bright : Palette -> Integer
  gfl-bright (p) = p.pal-accent

  gfl-sel : Palette -> Integer
  gfl-sel (p) = p.pal-accent

  gfl-on-sel : Palette -> Integer
  gfl-on-sel (p) = theme-ink-on p (p.pal-accent)

  gfl-dim : Palette -> Integer
  gfl-dim (p) = p.pal-primary

  gfl-hint : Palette -> Integer
  gfl-hint (p) = p.pal-primary

  gfl-row-h : Integer -> Integer
  gfl-row-h (s) = 18 * s

  gfl-rows-y0 : LayoutRect, Integer -> Integer
  gfl-rows-y0 (box) (s) = box.lr-y + 44 * s

  gfl-rows-vis : LayoutRect, Integer -> Integer
  gfl-rows-vis (box) (s) = (box.lr-h - 74 * s) / gfl-row-h s

  gfl-row-at : LayoutRect, Integer, Integer, Integer, Integer, Integer -> Integer
  gfl-row-at (box) (s) (top) (n) (mx) (my) =
    let y0 = gfl-rows-y0 box s
    in if mx < box.lr-x then -1
    else if mx >= box.lr-x + box.lr-w then -1
    else if my < y0 then -1
    else let row = top + (my - y0) / gfl-row-h s
    in if row >= n then -1
    else if row - top >= gfl-rows-vis box s then -1
    else row

  gfl-clamp-top : Integer, Integer, Integer -> Integer
  gfl-clamp-top (sel) (top) (vis) =
    if sel < top then sel
    else if sel >= top + vis then sel - vis + 1
    else top

Section: Formatting

  gfl-pad : Text, Integer -> Text
  gfl-pad (t) (width) =
    if text-length t >= width then t
    else gfl-pad (t & " ") width

  gfl-is-dir : Fat16DirEntry -> Boolean
  gfl-is-dir (e) = bit-and (e.de-attr) 16 == 16

  gfl-size-text : Fat16DirEntry -> Text
  gfl-size-text (e) = if gfl-is-dir e then "<DIR>" else show (e.de-size)

  gfl-row-text : Fat16DirEntry -> Text
  gfl-row-text (e) = gfl-pad (e.de-name) 16 & gfl-size-text e

  gfl-hex-digit : Integer -> Text
  gfl-hex-digit (v) =
    if v == 0 then "0" else if v == 1 then "1" else if v == 2 then "2"
    else if v == 3 then "3" else if v == 4 then "4" else if v == 5 then "5"
    else if v == 6 then "6" else if v == 7 then "7" else if v == 8 then "8"
    else if v == 9 then "9" else if v == 10 then "a" else if v == 11 then "b"
    else if v == 12 then "c" else if v == 13 then "d" else if v == 14 then "e"
    else "f"

  gfl-hex-byte : Integer -> Text
  gfl-hex-byte (b) = gfl-hex-digit (bit-and (bit-shru b 4) 15) & gfl-hex-digit (bit-and b 15)

  gfl-ascii : Integer -> Text
  gfl-ascii (c) =
    if c < 32 then "."
    else if c > 126 then "."
    else char-encode (code-to-char (from-unicode c))

  gfl-hex-n : LayoutRect, GopAppFont, Integer -> Integer
  gfl-hex-n (box) (font) (s) =
    let cells = (box.lr-w - 20 * s) / gapp-col-w font s
    in let fit = (cells - 1) / 4
    in if fit > 16 then 16 else if fit < 1 then 1 else fit

  gfl-hex-line : Integer, Integer, Integer -> Text
  gfl-hex-line (buf) (off) (n) =
    gfl-hex-run buf off n "" & " " & gfl-ascii-run buf off n ""

  gfl-hex-run : Integer, Integer, Integer, Text -> Text
  gfl-hex-run (buf) (off) (n) (acc) =
    if n == 0 then acc
    else gfl-hex-run buf (off + 1) (n - 1) (acc & gfl-hex-byte (peek-byte buf off) & " ")

  gfl-ascii-run : Integer, Integer, Integer, Text -> Text
  gfl-ascii-run (buf) (off) (n) (acc) =
    if n == 0 then acc
    else gfl-ascii-run buf (off + 1) (n - 1) (acc & gfl-ascii (peek-byte buf off))

  gfl-path-text : List Text -> Text
  gfl-path-text (names) = gfl-path-loop names 0 "ESP:/"

  gfl-path-loop : List Text, Integer, Text -> Text
  gfl-path-loop (names) (i) (acc) =
    if i >= list-length names then acc
    else gfl-path-loop names (i + 1) (acc & list-at names i & "/")

Section: Drawing

  gfl-draw-columns : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Integer, Integer, Text, Text, Integer -> Integer
  gfl-draw-columns (base) (box) (stride) (rows) (s) (font) (x) (y) (name) (size) (fg) =
    let split = box.lr-x + box.lr-w - 90 * s
    in let a = gapp-ui-text-fit base stride rows font x y (split - 12 * s) name fg s
    in gapp-ui-text-fit base stride rows font split y (box.lr-x + box.lr-w - 10 * s) size fg s

  gfl-draw-frame : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, Text -> Integer

  gfl-draw-frame (base) (box) (stride) (rows) (s) (font) (pal) (title) =
    let px = box.lr-x
    in let py = box.lr-y
    in let pw = box.lr-w
    in let ph = box.lr-h
    in let body = gop-fill-rect base stride rows px py pw ph (gfl-bg pal)
    in let bar = gop-fill-rect base stride rows px py pw (20 * s) (gfl-title pal)
    in gapp-ui-text base stride rows font (px + 6 * s) (py + 2 * s) title (gfl-bright pal) s 0

  gfl-draw-rows : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, IconKit, List Fat16DirEntry, Integer, Integer, Integer -> Integer
  gfl-draw-rows (base) (box) (stride) (rows) (s) (font) (pal) (kit) (win) (sel) (top) (i) =
    if i >= list-length win then 0
    else if i >= gfl-rows-vis box s then 0
    else let idx = top + i
    in let y = gfl-rows-y0 box s + i * gfl-row-h s
    in let px = box.lr-x
    in let hl = if idx == sel then gop-fill-rect base stride rows px y (box.lr-w) (gfl-row-h s) (gfl-sel pal) else 0
    in let e = list-at win i
    in let fg = if idx == sel then gfl-on-sel pal else if gfl-is-dir e then gfl-bright pal else gfl-text pal
    in let ico = gicon-pick kit (gfl-kind e)
    in let d = gicon-blit base stride rows ico (px + 10 * s) (y + s) (gfl-icon-scale s) fg
    in let t = gfl-draw-columns base box stride rows s font (px + 10 * s + gfl-icon-col kit s) (y + s) (e.de-name) (gfl-size-text e) fg
    in gfl-draw-rows base box stride rows s font pal kit win sel top (i + 1)

  gfl-draw-list : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, List Fat16DirEntry, Integer, Integer, Integer, List Text -> Integer
  gfl-draw-list (base) (box) (stride) (rows) (s) (font) (pal) (win) (count) (sel) (top) (names) =
    let f = gfl-draw-frame base box stride rows s font pal (gfl-path-text names)
    in let px = box.lr-x
    in let py = box.lr-y
    in let kit = gicon-kit
    in let hdr = gfl-draw-columns base box stride rows s font (px + 10 * s + gfl-icon-col kit s) (py + 26 * s) "Name" "Size" (gfl-dim pal)
    in let drawn = gfl-draw-rows base box stride rows s font pal kit win sel top 0
    in let none = if count == 0 then gapp-ui-text base stride rows font (px + 10 * s) (gfl-rows-y0 box s) "(empty directory)" (gfl-dim pal) s 0 else 0
    in gapp-ui-text base stride rows font (px + 10 * s) (py + box.lr-h - 18 * s) "Up/Down move   Enter open   Esc back" (gfl-hint pal) s 0

  gfl-is-source : Fat16DirEntry -> Boolean
  gfl-is-source (e) = gfl-ext-is (e.de-name) "SRC"

  gfl-ext-is : Text, Text -> Boolean
  gfl-ext-is (name) (ext) =
    let n = text-length name
    in let m = text-length ext
    in if n < m then False
    else substring name (n - m) m == ext

  gfl-is-image : Fat16DirEntry -> Boolean
  gfl-is-image (e) = gfl-ext-is (e.de-name) "BMP" | gfl-ext-is (e.de-name) "PNG" | gfl-ext-is (e.de-name) "JPG"

  gfl-is-textish : Fat16DirEntry -> Boolean
  gfl-is-textish (e) = gfl-is-source e | gfl-ext-is (e.de-name) "COD" | gfl-ext-is (e.de-name) "TXT" | gfl-ext-is (e.de-name) "MD"

  gfl-kind : Fat16DirEntry -> Integer
  gfl-kind (e) =
    if gfl-is-dir e then gicon-dir
    else if gfl-is-textish e then gicon-src
    else if gfl-is-image e then gicon-img
    else gicon-bin

  gfl-icon-scale : Integer -> Integer
  gfl-icon-scale (s) = 2 * s

  gfl-icon-col : IconKit, Integer -> Integer
  gfl-icon-col (kit) (s) = gicon-size (gicon-pick kit gicon-bin) (gfl-icon-scale s) + 4 * s

  gfl-draw-preview : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, Fat16DirEntry, Integer, Integer -> Integer
  gfl-draw-preview (base) (box) (stride) (rows) (s) (font) (pal) (e) (buf) (got) =
    let f = gfl-draw-frame base box stride rows s font pal (e.de-name)
    in let px = box.lr-x
    in let py = box.lr-y
    in let sz = gapp-ui-text base stride rows font (px + 10 * s) (py + 26 * s) (show (e.de-size) & " bytes") (gfl-bright pal) s 0
    in let body = if gfl-is-source e
      then gfl-source-lines base box stride rows s font (gfl-bg pal) buf 0 got 0
      else gfl-preview-lines base box stride rows s font pal buf 0 (if got > 128 then 128 else got)
    in gapp-ui-text base stride rows font (px + 10 * s) (py + box.lr-h - 18 * s) "Esc back" (gfl-hint pal) s 0

Section: Source Preview

  gfl-lf : Integer
  gfl-lf = 10

  gfl-src-line-end : Integer, Integer, Integer -> Integer
  gfl-src-line-end (buf) (off) (n) =
    if off >= n then off
    else if peek-byte buf off == gfl-lf then off
    else gfl-src-line-end buf (off + 1) n

  gfl-src-text : Integer, Integer, Integer, Text -> Text
  gfl-src-text (buf) (off) (stop) (acc) =
    if off >= stop then acc
    else let b = peek-byte buf off
    in let ch = if b < 32 | b == 127 then " " else char-encode (code-to-char (from-unicode b))
    in gfl-src-text buf (off + 1) stop (acc & ch)

  gfl-source-lines : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Integer, Integer, Integer, Integer, Integer -> Integer
  gfl-source-lines (base) (box) (stride) (rows) (s) (font) (ground) (buf) (off) (n) (row) =
    if off >= n then 0
    else if row >= gfl-rows-vis box s then 0
    else let stop = gfl-src-line-end buf off n
    in let line = gfl-src-text buf off stop ""
    in let y = gfl-rows-y0 box s + row * gfl-row-h s
    in let d = gfl-draw-runs base box stride rows s font ground line (syn-line line) 0 y
    in gfl-source-lines base box stride rows s font ground buf (stop + 1) n (row + 1)

  gfl-draw-runs : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Integer, Text, List SynRun, Integer, Integer -> Integer
  gfl-draw-runs (base) (box) (stride) (rows) (s) (font) (ground) (line) (runs) (i) (y) =
    if i >= list-length runs then 0
    else let r = list-at runs i
    in let cols = (box.lr-w - 20 * s) / gapp-col-w font s
    in if r.sr-start >= cols then 0
    else let room = cols - r.sr-start
    in let t = substring line (r.sr-start) (if r.sr-len > room then room else r.sr-len)
    in let x = box.lr-x + 10 * s + (r.sr-start) * gapp-col-w font s
    in let d = gapp-code-text base stride rows font x y t (syn-ink ground (r.sr-class)) s 0
    in gfl-draw-runs base box stride rows s font ground line runs (i + 1) y

  gfl-preview-lines : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, Integer, Integer, Integer -> Integer
  gfl-preview-lines (base) (box) (stride) (rows) (s) (font) (pal) (buf) (off) (n) =
    if off >= n then 0
    else let per = gfl-hex-n box font s
    in let take = if n - off > per then per else n - off
    in let y = gfl-rows-y0 box s + (off / per) * gfl-row-h s
    in let t = gapp-code-text base stride rows font (box.lr-x + 10 * s) y (gfl-hex-line buf off take) (gfl-text pal) s 0
    in gfl-preview-lines base box stride rows s font pal buf (off + per) n

Section: Navigation State

  gfl-pop-int : List Integer -> List Integer
  gfl-pop-int (xs) = gfl-pop-int-loop xs 0 []

  gfl-pop-int-loop : List Integer, Integer, List Integer -> List Integer
  gfl-pop-int-loop (xs) (i) (acc) =
    if i >= list-length xs - 1 then acc
    else gfl-pop-int-loop xs (i + 1) (list-push acc (list-at xs i))

  gfl-pop-text : List Text -> List Text
  gfl-pop-text (xs) = gfl-pop-text-loop xs 0 []

  gfl-pop-text-loop : List Text, Integer, List Text -> List Text
  gfl-pop-text-loop (xs) (i) (acc) =
    if i >= list-length xs - 1 then acc
    else gfl-pop-text-loop xs (i + 1) (list-push acc (list-at xs i))

  gfl-cur-dir : List Integer -> Integer
  gfl-cur-dir (clusters) = list-at clusters (list-length clusters - 1)

  gfl-list-cur : Fat16Volume, List Integer -> [Device.Port] List Fat16DirEntry
  gfl-list-cur (vol) (clusters) = act
    let cur = gfl-cur-dir clusters
    in if cur < 0 then gfat-list-root vol
    else gfat-list-dir vol cur
  end

  gfl-count-cur : Fat16Volume, List Integer -> [Device.Port] Integer
  gfl-count-cur (vol) (clusters) = gfat-dir-count vol (gfl-cur-dir clusters)

  gfl-window-cur : Fat16Volume, List Integer, Integer, Integer -> [Device.Port] List Fat16DirEntry
  gfl-window-cur (vol) (clusters) (from) (n) = gfat-dir-window vol (gfl-cur-dir clusters) from n

  gfl-paint-cur : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, Fat16Volume, List Integer, Integer, Integer, Integer, List Text -> [Device.Port] Integer
  gfl-paint-cur (base) (box) (stride) (rows) (s) (font) (pal) (vol) (clusters) (count) (sel) (top) (names) = act
    win <- gfl-window-cur vol clusters top (gfl-rows-vis box s)
    gfl-draw-list base box stride rows s font pal win count sel top names
  end

Section: Preview

  gfl-preview-paint : Integer, LayoutRect, Integer, Integer, Integer, GopAppFont, Palette, Integer, Fat16Volume, Fat16DirEntry -> [Device.Port] Integer
  gfl-preview-paint (base) (box) (stride) (rows) (s) (font) (pal) (cs) (vol) (e) = act
    hd <- cursor-hide cs base stride
    if e.de-size == 0 | e.de-cluster < 2 then act
      f <- gfl-draw-frame base box stride rows s font pal (e.de-name)
      t <- gapp-ui-text base stride rows font (box.lr-x + 10 * s) (box.lr-y + 26 * s) "empty file" (gfl-dim pal) s 0
      gapp-ui-text base stride rows font (box.lr-x + 10 * s) (box.lr-y + box.lr-h - 18 * s) "Esc back" (gfl-hint pal) s 0
    end
    else act
      b <- disk-read-sector (fat16-cluster-sector vol (e.de-cluster))
      let got = if b.dr-ok then (if e.de-size < 512 then e.de-size else 512) else 0
      in gfl-draw-preview base box stride rows s font pal e (b.dr-buf) got
    end
  end
Section: Loop

