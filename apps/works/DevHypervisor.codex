  VmxStatus =
    | VmxOk
    | VmxFailed (Integer)

Section: Is VMX Available At All

 **Measured here rather than assumed** (2026-07-27, under codex-vm): the
 MSR reads **1** -- lock set, VMX-outside-SMX clear -- which is exactly
 the encoding of a machine whose firmware has VT-x turned off. It is not
 zero, which is what the "an MSR outside codex-vm's list reads zero" note
 would have predicted, and the difference is worth having measured: the
 conclusion is the same and the reason for it is not.

  vmx-feature-control-msr : Integer = 58

  vmx-fc-lock : Integer = 1
  vmx-fc-vmx-outside-smx : Integer = 4

  vmx-err-no-vtx : Integer = 1

  vmx-feature-control : Integer
  vmx-feature-control = rdmsr vmx-feature-control-msr

  vmx-available : Boolean
  vmx-available =
    let fc = vmx-feature-control
    in bit-and fc vmx-fc-lock == vmx-fc-lock
     & bit-and fc vmx-fc-vmx-outside-smx == vmx-fc-vmx-outside-smx

  vmx-unavailable-reason : Text
  vmx-unavailable-reason =
    let fc = vmx-feature-control
    in if bit-and fc vmx-fc-lock /= vmx-fc-lock
      then "IA32_FEATURE_CONTROL is unlocked (" & show fc & "): firmware never configured VMX"
      else "VT-x is locked off in firmware (IA32_FEATURE_CONTROL=" & show fc & "): enable it in the BIOS"

Section: VMX Lifecycle

  vmx-init-region : Integer, Integer -> Integer
  vmx-init-region (addr) (revision-id) =
    let w0 = poke-32 addr 0 revision-id
    in addr

  vmx-enable : Integer -> VmxStatus
  vmx-enable (revision-id) =
    if vmx-available == False then VmxFailed vmx-err-no-vtx
    else let cr4 = vmx-fixed-cr4
    in let region = vmx-alloc-zeroed vmx-vmcs-size vmx-page-size
    in let w0 = vmx-init-region region revision-id
    in let result = vmxon region
    in VmxOk

  vmx-create-vmcs : Integer -> VmxStatus
  vmx-create-vmcs (revision-id) =
    if vmx-available == False then VmxFailed vmx-err-no-vtx
    else let region = vmx-alloc-zeroed vmx-vmcs-size vmx-page-size
    in let w0 = vmx-init-region region revision-id
    in let c0 = vmclear region
    in let l0 = vmptrld region
    in VmxOk

Section: VMCS Setup

  vmcs-setup-guest-segments : Integer
  vmcs-setup-guest-segments =
    let w0 = vmwrite vmcs-guest-cs-sel 8
    in let w1 = vmwrite vmcs-guest-cs-base 0
    in let w2 = vmwrite vmcs-guest-cs-limit 4294967295
    in let w3 = vmwrite vmcs-guest-cs-ar 43019
    in let w4 = vmwrite vmcs-guest-ds-sel 16
    in let w5 = vmwrite vmcs-guest-ds-base 0
    in let w6 = vmwrite vmcs-guest-ds-limit 4294967295
    in let w7 = vmwrite vmcs-guest-ds-ar 40963
    in let w8 = vmwrite vmcs-guest-es-sel 16
    in let w9 = vmwrite vmcs-guest-es-base 0
    in let w10 = vmwrite vmcs-guest-es-limit 4294967295
    in let w11 = vmwrite vmcs-guest-es-ar 40963
    in let w12 = vmwrite vmcs-guest-ss-sel 16
    in let w13 = vmwrite vmcs-guest-ss-base 0
    in let w14 = vmwrite vmcs-guest-ss-limit 4294967295
    in let w15 = vmwrite vmcs-guest-ss-ar 40963
    in let w16 = vmwrite vmcs-guest-fs-sel 0
    in let w17 = vmwrite vmcs-guest-fs-base 0
    in let w18 = vmwrite vmcs-guest-fs-limit 0
    in let w19 = vmwrite vmcs-guest-fs-ar 65538
    in let w20 = vmwrite vmcs-guest-gs-sel 0
    in let w21 = vmwrite vmcs-guest-gs-base 0
    in let w22 = vmwrite vmcs-guest-gs-limit 0
    in let w23 = vmwrite vmcs-guest-gs-ar 65538
    in let w24 = vmwrite vmcs-guest-tr-sel 24
    in let w25 = vmwrite vmcs-guest-tr-base 0
    in let w26 = vmwrite vmcs-guest-tr-limit 103
    in let w27 = vmwrite vmcs-guest-tr-ar 139
    in let w28 = vmwrite vmcs-guest-ldtr-sel 0
    in let w29 = vmwrite vmcs-guest-ldtr-base 0
    in let w30 = vmwrite vmcs-guest-ldtr-limit 0
    in let w31 = vmwrite vmcs-guest-ldtr-ar 65538
    in 0

  vmcs-setup-guest-state : Integer, Integer, Integer -> Integer
  vmcs-setup-guest-state (entry-rip) (entry-rsp) (cr3) =
    let w0 = vmwrite vmcs-guest-cr0 vmx-fixed-cr0
    in let w1 = vmwrite vmcs-guest-cr3 cr3
    in let w2 = vmwrite vmcs-guest-cr4 vmx-fixed-cr4
    in let w3 = vmwrite vmcs-guest-rip entry-rip
    in let w4 = vmwrite vmcs-guest-rsp entry-rsp
    in let w5 = vmwrite vmcs-guest-rflags 2
    in let w6 = vmwrite vmcs-guest-gdtr-base 0
    in let w7 = vmwrite vmcs-guest-gdtr-limit 47
    in let w8 = vmwrite vmcs-guest-idtr-base 0
    in let w9 = vmwrite vmcs-guest-idtr-limit 0
    in let w10 = vmwrite vmcs-vmx-link-ptr 4294967295
    in let w11 = vmwrite vmcs-guest-sysenter-cs 0
    in let w12 = vmwrite vmcs-guest-sysenter-esp 0
    in let w13 = vmwrite vmcs-guest-sysenter-eip 0
    in let w14 = vmcs-setup-guest-segments
    in 0

  vmcs-setup-host-state : Integer -> Integer
  vmcs-setup-host-state (host-cr3) =
    let w0 = vmwrite vmcs-host-cr0 vmx-fixed-cr0
    in let w1 = vmwrite vmcs-host-cr3 host-cr3
    in let w2 = vmwrite vmcs-host-cr4 vmx-fixed-cr4
    in let w5 = vmwrite vmcs-host-cs-sel 8
    in let w6 = vmwrite vmcs-host-ss-sel 16
    in let w7 = vmwrite vmcs-host-ds-sel 16
    in let w8 = vmwrite vmcs-host-es-sel 16
    in let w9 = vmwrite vmcs-host-fs-sel 0
    in let w10 = vmwrite vmcs-host-gs-sel 0
    in let w11 = vmwrite vmcs-host-tr-sel 24
    in 0

  vmcs-setup-controls : Integer -> Integer
  vmcs-setup-controls (eptp) =
    let pin = vmx-adjust-control msr-vmx-pinbased-ctls 0
    in let proc = vmx-adjust-control msr-vmx-procbased-ctls 2164260992
    in let proc2 = vmx-adjust-control msr-vmx-procbased2 2
    in let exit-ctl = vmx-adjust-control msr-vmx-exit-ctls 512
    in let entry-ctl = vmx-adjust-control msr-vmx-entry-ctls 512
    in let w0 = vmwrite vmcs-pin-based-controls pin
    in let w1 = vmwrite vmcs-proc-based-controls proc
    in let w2 = vmwrite vmcs-secondary-controls proc2
    in let w3 = vmwrite vmcs-ept-pointer eptp
    in let w4 = vmwrite vmcs-exit-controls exit-ctl
    in let w5 = vmwrite vmcs-entry-controls entry-ctl
    in 0

Section: VM Exit Handling

  vm-read-exit-info : VmExitInfo
  vm-read-exit-info =
    let reason = vmread vmcs-exit-reason
    in let qual = vmread vmcs-exit-qualification
    in VmExitInfo { reason = reason, qualification = qual }

  vm-exit-is-io : VmExitInfo -> Boolean
  vm-exit-is-io (info) = bit-and (info.reason) 65535 == 30

  vm-exit-is-hlt : VmExitInfo -> Boolean
  vm-exit-is-hlt (info) = bit-and (info.reason) 65535 == 12

  vm-exit-io-port : VmExitInfo -> Integer
  vm-exit-io-port (info) = bit-shru (info.qualification) 16

  vm-exit-io-is-out : VmExitInfo -> Boolean
  vm-exit-io-is-out (info) = bit-and (info.qualification) 8 == 0

  vm-exit-io-size : VmExitInfo -> Integer
  vm-exit-io-size (info) = bit-and (info.qualification) 7

  vm-exit-is-cpuid : VmExitInfo -> Boolean
  vm-exit-is-cpuid (info) = bit-and (info.reason) 65535 == 10

  vm-exit-is-msr-read : VmExitInfo -> Boolean
  vm-exit-is-msr-read (info) = bit-and (info.reason) 65535 == 31

  vm-exit-is-msr-write : VmExitInfo -> Boolean
  vm-exit-is-msr-write (info) = bit-and (info.reason) 65535 == 32

  vmcs-guest-rax : Integer = 25600
  vmcs-guest-inst-len : Integer = 17408

