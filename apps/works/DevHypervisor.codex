  vm-handle-rdmsr : Integer
  vm-handle-rdmsr = 0

Section: Formatting

  format-exit-reason : Integer -> Text
  format-exit-reason (r) =
    let code = bit-and r 65535
    in if code == 0 then "exception"
    else if code == 1 then "external-interrupt"
    else if code == 7 then "interrupt-window"
    else if code == 10 then "cpuid"
    else if code == 12 then "hlt"
    else if code == 18 then "vmcall"
    else if code == 28 then "cr-access"
    else if code == 30 then "io-instruction"
    else if code == 31 then "rdmsr"
    else if code == 32 then "wrmsr"
    else if code == 48 then "ept-violation"
    else "exit-" & show code

  format-exit-info : VmExitInfo -> Text
  format-exit-info (info) =
    "reason=" & format-exit-reason (info.reason) & " qual=0x" & hex-i64 (info.qualification)

Section: Guest Page Tables

  guest-pt-base : Integer = 12582912

  vm-build-pml4 : Integer -> Integer
  vm-build-pml4 (host-base) =
    let pml4-gpa = guest-pt-base
    in let pdpt-gpa = pml4-gpa + vmx-page-size
    in let pd-gpa = pdpt-gpa + vmx-page-size
    in let pml4 = host-base + pml4-gpa
    in let pdpt = host-base + pdpt-gpa
    in let pd = host-base + pd-gpa
    in let w0 = poke-32 pml4 0 (bit-or pdpt-gpa 3)
    in let w1 = poke-32 pml4 4 0
    in let w2 = vm-zero-rest pml4 8 vmx-page-size
    in let w3 = poke-32 pdpt 0 (bit-or pd-gpa 3)
    in let w4 = poke-32 pdpt 4 0
    in let w5 = vm-zero-rest pdpt 8 vmx-page-size
    in let w6 = vm-fill-pd pd 0 ept-entries-per-table
    in let w7 = vm-zero-rest pd (ept-entries-per-table * 8) vmx-page-size
    in pml4-gpa

  vm-fill-pd : Integer, Integer, Integer -> Integer
  vm-fill-pd (pd) (i) (count) =
    if i >= count then 0
    else let addr = i * 2097152
    in let entry = bit-or addr 131
    in let w0 = poke-32 pd (i * 8) (bit-and entry 4294967295)
    in let w1 = poke-32 pd (i * 8 + 4) (bit-shru entry 32)
    in vm-fill-pd pd (i + 1) count

  vm-zero-rest : Integer, Integer, Integer -> Integer
  vm-zero-rest (base) (off) (limit) =
    if off >= limit then 0
    else let w = poke-32 base off 0
    in vm-zero-rest base (off + 4) limit

Section: Extended Page Tables

 Intel's encoding, not ours (SDM Vol 3C, 29.3.2 and 29.4.2). In an EPT entry
 that maps a 2 MB page, bits 2:0 are read, write and execute, bits 5:3 carry
 the EPT memory type, and bit 7 marks the entry as a leaf rather than a
 pointer to the next table; the frame occupies bits 51:21. A non-leaf entry
 carries the permission bits and the next table's address and nothing else.
 The EPT pointer holds the memory type in bits 2:0 and the page-walk length
 MINUS ONE in bits 5:3, so a four-level walk is written as three.

  ept-perm-rwx : Integer = 7
  ept-memtype-wb : Integer = 48
  ept-leaf : Integer = 128
  eptp-memtype-wb : Integer = 6
  eptp-walk-length-4 : Integer = 24
  ept-entries-per-table : Integer = 512

  vm-poke-64 : Integer, Integer, Integer -> Integer
  vm-poke-64 (base) (off) (value) =
    let w0 = poke-32 base off (bit-and value msr-low32-mask)
    in poke-32 base (off + 4) (bit-shru value 32)

  vm-ept-leaf-entry : Integer -> Integer
  vm-ept-leaf-entry (host-frame) =
    bit-or host-frame (bit-or ept-perm-rwx (bit-or ept-memtype-wb ept-leaf))

  vm-ept-table-entry : Integer -> Integer
  vm-ept-table-entry (table-addr) = bit-or table-addr ept-perm-rwx

  vm-eptp : Integer -> Integer
  vm-eptp (pml4) = bit-or pml4 (bit-or eptp-memtype-wb eptp-walk-length-4)

  vm-ept-fill-pd : Integer, Integer, Integer, Integer -> Integer
  vm-ept-fill-pd (pd) (host-base) (i) (count) =
    if i >= count then 0
    else let w = vm-poke-64 pd (i * 8) (vm-ept-leaf-entry (host-base + i * vmx-large-page-size))
    in vm-ept-fill-pd pd host-base (i + 1) count

  vm-ept-leaf-count : Integer -> Integer
  vm-ept-leaf-count (bytes) =
    let n = bytes / vmx-large-page-size
    in if n > ept-entries-per-table then ept-entries-per-table else n

  vm-build-ept : Integer, Integer, Integer -> Integer
  vm-build-ept (ept-base) (guest-host-base) (guest-bytes) =
    let pml4 = ept-base
    in let pdpt = pml4 + vmx-page-size
    in let pd = pdpt + vmx-page-size
    in let w0 = vm-poke-64 pml4 0 (vm-ept-table-entry pdpt)
    in let w1 = vm-poke-64 pdpt 0 (vm-ept-table-entry pd)
    in let w2 = vm-ept-fill-pd pd guest-host-base 0 (vm-ept-leaf-count guest-bytes)
    in vm-eptp pml4

Section: Guest Memory Loading

  vm-load-bytes-to-guest : Integer, List Integer, Integer, Integer -> Integer
  vm-load-bytes-to-guest (dest) (bs) (i) (len) =
    if i >= len then 0
    else let w = poke-byte dest i (list-at bs i)
    in vm-load-bytes-to-guest dest bs (i + 1) len

Section: VM Run Loop

  VmRunResult =
    | VmHalted
    | VmIoExit (VmExitInfo)
    | VmCrashed (VmExitInfo)
    | VmRefused (Text)

  vm-launch-and-run : Integer -> VmRunResult
  vm-launch-and-run (max-exits) =
    let launch-status = vmlaunch-full
    in vm-run-loop 0 max-exits

  vm-run-loop : Integer, Integer -> VmRunResult
  vm-run-loop (exits) (max-exits) =
    if exits >= max-exits then VmCrashed (vm-read-exit-info)
    else let info = vm-read-exit-info
    in if vm-exit-is-hlt info then VmHalted
    else if vm-exit-is-io info then VmIoExit info
    else VmCrashed info

  vm-resume-after-io : Integer, Integer -> VmRunResult
  vm-resume-after-io (exits) (max-exits) =
    let rip = vmread vmcs-guest-rip
    in let inst-len = vmread 17408
    in let w = vmwrite vmcs-guest-rip (rip + inst-len)
    in let resume-status = vmresume-full
    in vm-run-loop (exits + 1) max-exits

Section: Device-Aware VM Run

  VmDevices = record {
    vd-com1 : VmSerialPort,
    vd-com2 : VmSerialPort,
    vd-ide : VmIdeState
  }

  VmFullResult = record {
    vfr-status : VmRunResult,
    vfr-devices : VmDevices
  }

  vm-devices-new : VmDevices
  vm-devices-new = VmDevices {
    vd-com1 = vm-serial-new vm-com1-base,
    vd-com2 = vm-serial-new vm-com2-base,
    vd-ide = vm-ide-new
  }

  vm-devices-with-input : VmDevices, List Integer -> VmDevices
  vm-devices-with-input (devs) (data) = VmDevices {
    vd-com1 = vm-serial-with-input (devs.vd-com1) data,
    vd-com2 = devs.vd-com2,
    vd-ide = devs.vd-ide
  }

  vm-devices-with-disk : VmDevices, Integer, Integer -> VmDevices
  vm-devices-with-disk (devs) (disk-addr) (total-sectors) = VmDevices {
    vd-com1 = devs.vd-com1,
    vd-com2 = devs.vd-com2,
    vd-ide = vm-ide-attach disk-addr total-sectors
  }

  vm-launch-with-devices : Integer, VmDevices -> VmFullResult
  vm-launch-with-devices (max-exits) (devs) =
    let launch-status = vmlaunch-full
    in if launch-status /= 0
      then VmFullResult { vfr-status = VmRefused "vmlaunch failed", vfr-devices = devs }
    else vm-device-loop 0 max-exits devs

  vm-device-loop : Integer, Integer, VmDevices -> VmFullResult
  vm-device-loop (exits) (max-exits) (devs) =
    if exits >= max-exits then VmFullResult { vfr-status = VmCrashed (vm-read-exit-info), vfr-devices = devs }
    else let info = vm-read-exit-info
    in let code = bit-and (info.reason) 65535
    in if code == 12 then VmFullResult { vfr-status = VmHalted, vfr-devices = devs }
    else if code == 30 then
      let port = vm-exit-io-port info
      in let devs2 = vm-dispatch-io devs info port
      in vm-resume-with-devices (exits + 1) max-exits devs2
    else if code == 10 then
      let w = vm-handle-cpuid
      in vm-resume-with-devices (exits + 1) max-exits devs
    else if code == 31 then
      let w = vm-handle-rdmsr
      in vm-resume-with-devices (exits + 1) max-exits devs
    else if code == 32 then
      vm-resume-with-devices (exits + 1) max-exits devs
    else VmFullResult { vfr-status = VmCrashed info, vfr-devices = devs }

  vm-resume-with-devices : Integer, Integer, VmDevices -> VmFullResult
  vm-resume-with-devices (exits) (max-exits) (devs) =
    let rip = vmread vmcs-guest-rip
    in let inst-len = vmread 17408
    in let w = vmwrite vmcs-guest-rip (rip + inst-len)
    in let resume-status = vmresume-full
    in vm-device-loop (exits + 1) max-exits devs

  vm-dispatch-io : VmDevices, VmExitInfo, Integer -> VmDevices
  vm-dispatch-io (devs) (info) (port) =
    if vm-serial-owns-port (devs.vd-com1) port then
      if vm-exit-io-is-out info then VmDevices {
        vd-com1 = vm-serial-handle-out (devs.vd-com1) port (vm-exit-io-data info),
        vd-com2 = devs.vd-com2, vd-ide = devs.vd-ide
      }
      else let result = vm-serial-handle-in (devs.vd-com1) port
      in let w = vm-inject-io-result (result.sir-value)
      in VmDevices { vd-com1 = result.sir-port, vd-com2 = devs.vd-com2, vd-ide = devs.vd-ide }
    else if vm-serial-owns-port (devs.vd-com2) port then
      if vm-exit-io-is-out info then VmDevices {
        vd-com1 = devs.vd-com1,
        vd-com2 = vm-serial-handle-out (devs.vd-com2) port (vm-exit-io-data info),
        vd-ide = devs.vd-ide
      }
      else let result = vm-serial-handle-in (devs.vd-com2) port
      in let w = vm-inject-io-result (result.sir-value)
      in VmDevices { vd-com1 = devs.vd-com1, vd-com2 = result.sir-port, vd-ide = devs.vd-ide }
    else if vm-ide-owns-port (devs.vd-ide) port then
      if vm-exit-io-is-out info then VmDevices {
        vd-com1 = devs.vd-com1, vd-com2 = devs.vd-com2,
        vd-ide = vm-ide-handle-out (devs.vd-ide) port (vm-exit-io-data info)
      }
      else let result = vm-ide-handle-in (devs.vd-ide) port
      in let w = vm-inject-io-result (result.iir-value)
      in VmDevices { vd-com1 = devs.vd-com1, vd-com2 = devs.vd-com2, vd-ide = result.iir-state }
    else devs

  vm-exit-io-data : VmExitInfo -> Integer
  vm-exit-io-data (info) = vmread 25602

  vm-inject-io-result : Integer -> Integer
  vm-inject-io-result (value) = vmwrite 25602 value

Section: Guest Provisioning

  guest-min-mb : Integer = 32

  guest-max-mb : Integer
  guest-max-mb = ept-entries-per-table * vmx-large-page-size / vmx-bytes-per-mb
  guest-arena-reserve : Integer = 16777216
  ram-size-addr : Integer = 4072

  VmGuest = record {
    vg-ok : Boolean,
    vg-host-base : Integer,
    vg-eptp : Integer,
    vg-reason : Text
  }

  vm-ram-size : Integer
  vm-ram-size =
    peek-byte ram-size-addr 0 + bit-shl (peek-byte ram-size-addr 1) 8
      + bit-shl (peek-byte ram-size-addr 2) 16 + bit-shl (peek-byte ram-size-addr 3) 24

  vm-arena-free : Integer
  vm-arena-free = vm-ram-size - __heap-save

  vm-guest-refused : Text -> VmGuest
  vm-guest-refused (why) =
    VmGuest { vg-ok = False, vg-host-base = 0, vg-eptp = 0, vg-reason = why }

 A raw CDX guest enters at `__start`, which loads RSP from `ram-size-addr`
 and then stores its heap position to `deck-pos-addr`, both absolute
 addresses inside the first 64 KB. Under EPT those are guest-physical, so
 they land in this freshly allocated region rather than in the host's low
 memory, and the region is handed over unzeroed: zeroing the whole guest
 would be one store per dword across the entire allocation. Only the low
 window is initialised, and the RAM size the guest will adopt as its stack
 top is written there.

  guest-low-init-bytes : Integer = 65536

  vm-init-guest-low : Integer, Integer -> Integer
  vm-init-guest-low (host-base) (guest-bytes) =
    let z = vmx-zero-dwords host-base 0 (guest-low-init-bytes / 4)
    in vm-poke-64 host-base ram-size-addr guest-bytes

  vm-guest-sizing : Integer -> VmGuest
  vm-guest-sizing (mb) =
    if mb < guest-min-mb
      then vm-guest-refused ("guest memory " & show mb & " MB is below the " & show guest-min-mb & " MB minimum")
    else if mb > guest-max-mb
      then vm-guest-refused ("guest memory " & show mb & " MB is above the " & show guest-max-mb & " MB maximum")
    else let bytes = mb * vmx-bytes-per-mb
    in let free = vm-arena-free
    in if bytes + guest-arena-reserve >= free
      then vm-guest-refused ("guest needs " & show bytes & " bytes and the arena has " & show free & " free")
    else VmGuest { vg-ok = True, vg-host-base = 0, vg-eptp = 0, vg-reason = "" }

  vm-prepare-guest : GuestConfig -> VmGuest
  vm-prepare-guest (cfg) =
    if vmx-available == False then vm-guest-refused vmx-unavailable-reason
    else let sized = vm-guest-sizing (cfg.memory-mb)
    in if sized.vg-ok == False then sized
    else let bytes = cfg.memory-mb * vmx-bytes-per-mb
    in let host-base = vmx-alloc-raw bytes vmx-large-page-size
    in let ept-base = vmx-alloc-zeroed (3 * vmx-page-size) vmx-page-size
    in let low = vm-init-guest-low host-base bytes
    in VmGuest {
      vg-ok = True,
      vg-host-base = host-base,
      vg-eptp = vm-build-ept ept-base host-base bytes,
      vg-reason = ""
    }

Section: Full VM Setup

  vm-setup-guest : GuestConfig, Integer, VmGuest, List Integer -> Integer
  vm-setup-guest (cfg) (revision-id) (g) (guest-code) =
    let e0 = vmx-enable revision-id
    in let e1 = vmx-create-vmcs revision-id
    in let pt = vm-build-pml4 (g.vg-host-base)
    in let w0 = vm-load-bytes-to-guest (g.vg-host-base + cfg.entry-point) guest-code 0 (list-length guest-code)
    in let w1 = vmcs-setup-guest-state (cfg.entry-point) guest-stack-top pt
    in let w2 = vmcs-setup-host-state cpu-read-cr3
    in vmcs-setup-controls (g.vg-eptp)

  vm-setup-and-launch : GuestConfig, Integer, List Integer -> VmRunResult
  vm-setup-and-launch (cfg) (revision-id) (guest-code) =
    let g = vm-prepare-guest cfg
    in if g.vg-ok == False then VmRefused (g.vg-reason)
    else let w = vm-setup-guest cfg revision-id g guest-code
    in vm-launch-and-run 10000

  vm-setup-and-run-with-serial : GuestConfig, Integer, List Integer, List Integer -> VmFullResult
  vm-setup-and-run-with-serial (cfg) (revision-id) (guest-code) (serial-input) =
    let g = vm-prepare-guest cfg
    in if g.vg-ok == False
      then VmFullResult { vfr-status = VmRefused (g.vg-reason), vfr-devices = vm-devices-new }
    else let w = vm-setup-guest cfg revision-id g guest-code
    in let devs = vm-devices-with-input vm-devices-new serial-input
    in vm-launch-with-devices 1000000 devs

Section: Menu

  hypervisor-menu : MenuState
  hypervisor-menu = menu-new "Hypervisor" [
    menu-item "VMX Init Test" "vmx-init",
    menu-item "Launch Guest (HLT)" "vmx-launch",
    menu-item "Launch Guest (Serial)" "vmx-serial",
    menu-item "Back" "back"
  ]

