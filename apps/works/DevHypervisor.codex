Section: VMX Constants

  vmx-cr4-vmxe : Integer = 8192
  vmx-vmcs-size : Integer = 4096
  vmx-page-size : Integer = 4096
  vmx-large-page-size : Integer = 2097152
  vmx-bytes-per-mb : Integer = 1048576

  guest-memory-base : Integer = 16777216
  guest-stack-top : Integer = 20971520
  guest-entry-point : Integer = 1048576

Section: Region Allocation

  vmx-align-up : Integer, Integer -> Integer
  vmx-align-up (v) (a) =
    let m = a - 1
    in (v + m) - bit-and (v + m) m

  vmx-zero-dwords : Integer, Integer, Integer -> Integer
  vmx-zero-dwords (base) (i) (n) =
    if i >= n then 0
    else let w = poke-32 base (i * 4) 0
    in vmx-zero-dwords base (i + 1) n

  vmx-alloc-raw : Integer, Integer -> Integer
  vmx-alloc-raw (size) (align) =
    let raw = __heap-save
    in let adv = __heap-advance (size + align)
    in vmx-align-up raw align

  vmx-alloc-zeroed : Integer, Integer -> Integer
  vmx-alloc-zeroed (size) (align) =
    let base = vmx-alloc-raw size align
    in let z = vmx-zero-dwords base 0 (size / 4)
    in base

Section: VMX Capability MSRs

  msr-vmx-basic : Integer = 1152
  msr-vmx-pinbased-ctls : Integer = 1153
  msr-vmx-procbased-ctls : Integer = 1154
  msr-vmx-exit-ctls : Integer = 1155
  msr-vmx-entry-ctls : Integer = 1156
  msr-vmx-cr0-fixed0 : Integer = 1158
  msr-vmx-cr0-fixed1 : Integer = 1159
  msr-vmx-cr4-fixed0 : Integer = 1160
  msr-vmx-cr4-fixed1 : Integer = 1161
  msr-vmx-procbased2 : Integer = 1163
  msr-low32-mask : Integer = 4294967295

 IA32_VMX_BASIC EXISTS ONLY ON A PROCESSOR IN WHICH VMX IS ENABLED, and
 reading it anywhere else is a #GP, not a zero. Measured: this faulted
 with `!EXC=0d RIP=... RDI=0000000000000480` under codex-vm -- 0x480 being
 the MSR index -- before any of the availability checks below could run,
 because a caller naturally asks for the revision id first and hands it to
 `vmx-enable`.

  vmx-read-revision-id : Integer
  vmx-read-revision-id =
    if vmx-available == False then 0
    else bit-and (rdmsr msr-vmx-basic) 2147483647

  vmx-adjust-control : Integer, Integer -> Integer
  vmx-adjust-control (msr-index) (desired) =
    if vmx-available == False then desired
    else let raw = rdmsr msr-index
    in let must-be-1 = bit-and raw msr-low32-mask
    in let allowed-1 = bit-shru raw 32
    in bit-and (bit-or desired must-be-1) allowed-1

  vmx-fixed-cr0 : Integer
  vmx-fixed-cr0 =
    let fixed0 = rdmsr msr-vmx-cr0-fixed0
    in let fixed1 = rdmsr msr-vmx-cr0-fixed1
    in bit-and (bit-or 2147483697 fixed0) fixed1

  vmx-fixed-cr4 : Integer
  vmx-fixed-cr4 =
    let fixed0 = rdmsr msr-vmx-cr4-fixed0
    in let fixed1 = rdmsr msr-vmx-cr4-fixed1
    in bit-and (bit-or vmx-cr4-vmxe fixed0) fixed1

