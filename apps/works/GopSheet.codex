Section: The Pane's State

  SheetPane = record {
    sp-sheet : Sheet,
    sp-row : Integer,
    sp-col : Integer,
    sp-buf : Text
  }

  gsh-pane-new : Integer -> SheetPane
  gsh-pane-new (dummy) =
    SheetPane { sp-sheet = gsh-demo 0, sp-row = 1, sp-col = 0, sp-buf = "" }

  gsh-buf-add : Text, Integer -> Text
  gsh-buf-add (buf) (ch) = buf & utf8-bytes-to-text (list-push [] ch)

  gsh-buf-back : Text -> Text
  gsh-buf-back (buf) =
    let bs = text-to-utf8-bytes buf
    in let n = list-length bs
    in if n <= 0 then buf
    else utf8-bytes-to-text (ev-slice bs 0 (n - 1) [])

  gsh-commit : SheetPane -> Sheet
  gsh-commit (sp) = sheet-type (sp.sp-sheet) (sp.sp-row) (sp.sp-col) (sp.sp-buf)

Section: The Sheet This Pane Shows

  gsh-rows-shown : Integer = 6
  gsh-cols-shown : Integer = 4
  gsh-cell-w : Integer = 92
  gsh-cell-h : Integer = 20

  gsh-demo : Integer -> Sheet
  gsh-demo (dummy) =
    let s0 = sheet-open gsh-rows-shown gsh-cols-shown 512
    in let s1 = sheet-type (sheet-type s0 0 0 "Item") 0 1 "Qty"
    in let s2 = sheet-type (sheet-type s1 0 2 "Cost") 0 3 "Total"
    in let s3 = sheet-type (sheet-type s2 1 0 "Widget") 1 1 "3"
    in let s4 = sheet-type (sheet-type s3 1 2 "250") 1 3 "=B2*C2"
    in let s5 = sheet-type (sheet-type s4 2 0 "Gadget") 2 1 "2"
    in let s6 = sheet-type (sheet-type s5 2 2 "400") 2 3 "=B3*C3"
    in let s7 = sheet-type (sheet-type s6 3 0 "Total") 3 3 "=SUM(D2:D3)"
    in sheet-type (sheet-type s7 4 0 "Refused") 4 3 "=B2+A2"

Section: The Tree

  gsh-cell-chars : Integer
  gsh-cell-chars = gsh-cell-w / 8

  gsh-cell-id : Integer, Integer -> Text
  gsh-cell-id (r) (c) = "sh-c-" & show r & "-" & show c

  gsh-cell-at : Text, Integer, Integer -> Integer
  gsh-cell-at (id) (r) (c) =
    if r >= gsh-rows-shown then 0 - 1
    else if c >= gsh-cols-shown then gsh-cell-at id (r + 1) 0
    else if id == gsh-cell-id r c then r * gsh-cols-shown + c
    else gsh-cell-at id r (c + 1)

  gsh-cell-text : Sheet, Results, Integer, Integer, Integer, Integer, Text -> Text
  gsh-cell-text (sh) (rs) (r) (c) (fr) (fc) (buf) =
    if r == fr & c == fc & vw-len buf > 0 then vw-left-of buf gsh-cell-chars
    else vw-cell sh rs r c gsh-cell-chars

  gsh-cell-label : Sheet, Results, Integer, Integer, Integer, Integer, Text -> WidgetNode
  gsh-cell-label (sh) (rs) (r) (c) (fr) (fc) (buf) =
    let base = widget-set-min (widget-label (gsh-cell-id r c) (gsh-cell-text sh rs r c fr fc buf)) gsh-cell-w gsh-cell-h
    in if r == fr & c == fc then widget-set-tone base tone-primary else base

  gsh-row-cells : Sheet, Results, Integer, Integer, List WidgetNode, Integer, Integer, Text -> List WidgetNode
  gsh-row-cells (sh) (rs) (r) (c) (acc) (fr) (fc) (buf) =
    if c >= gsh-cols-shown then acc
    else gsh-row-cells sh rs r (c + 1) (list-push acc (gsh-cell-label sh rs r c fr fc buf)) fr fc buf

  gsh-row : Sheet, Results, Integer, Integer, Integer, Text -> WidgetNode
  gsh-row (sh) (rs) (r) (fr) (fc) (buf) =
    widget-set-min (widget-panel ("sh-r-" & show r) DirRow 4 (gsh-row-cells sh rs r 0 [] fr fc buf)) 0 gsh-cell-h

  gsh-rows : Sheet, Results, Integer, List WidgetNode, Integer, Integer, Text -> List WidgetNode
  gsh-rows (sh) (rs) (r) (acc) (fr) (fc) (buf) =
    if r >= gsh-rows-shown then acc
    else gsh-rows sh rs (r + 1) (list-push acc (gsh-row sh rs r fr fc buf)) fr fc buf

  gsh-head-cells : Integer, List WidgetNode -> List WidgetNode
  gsh-head-cells (c) (acc) =
    if c >= gsh-cols-shown then acc
    else gsh-head-cells (c + 1) (list-push acc (widget-set-min (widget-label ("sh-h-" & show c) (gr-col-name c)) gsh-cell-w gsh-cell-h))

  gsh-head : Integer -> WidgetNode
  gsh-head (dummy) =
    widget-set-min (widget-panel "sh-head" DirRow 4 (gsh-head-cells 0 [])) 0 gsh-cell-h

  gsh-grid-h : Integer
  gsh-grid-h = gsh-rows-shown * gsh-cell-h + (gsh-rows-shown - 1) * 2

  gsh-tree : SheetPane -> WidgetNode
  gsh-tree (sp) =
    let sh = sp.sp-sheet
    in let rs = eval-run (sh.sh-prog)
    in let grid = widget-set-min (widget-set-flex (widget-panel "sh-grid" DirColumn 2 (gsh-rows sh rs 0 [] (sp.sp-row) (sp.sp-col) (sp.sp-buf))) 0) 0 gsh-grid-h
    in let slack = widget-spacer "sh-slack"
    in widget-panel "sh-root" DirColumn 4 (list-push (list-push (list-push (list-push [] (gsh-head 0)) (widget-separator "sh-sep")) grid) slack)

