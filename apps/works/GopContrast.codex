Chapter: GopContrast
  cites UI chapter Theme

  gac-palette : Palette = Palette {
    pal-bg = 0, pal-fg = 16777215,
    pal-primary = 16777215, pal-secondary = 0,
    pal-accent = 65535, pal-muted = 0,
    pal-error = 16776960, pal-success = 65535,
    pal-warning = 16776960, pal-border = 16777215
  }

  gac-theme : Theme =
    let edge = border-uniform 1 16777215 CornerSharp
    in let pad = edges-uniform 4
    in let margin = edges-uniform 2
    in let panel = widget-style 0 16777215 border-none pad edges-zero
    in let button = widget-style 0 16777215 edge pad margin
    in let active = widget-style 0 16777215 (border-uniform 1 65535 CornerSharp) pad margin
    in let label = widget-style 0 16777215 border-none edges-zero margin
    in let states = StateStyles { ss-normal = button, ss-hover = active, ss-pressed = active, ss-disabled = button, ss-focused = button }
    in Theme {
      th-name = "High contrast", th-palette = gac-palette,
      th-panel = state-styles-flat panel,
      th-button = states,
      th-label = state-styles-flat label,
      th-input = state-styles-flat button,
      th-gauge = state-styles-flat button,
      th-separator = state-styles-flat (widget-style 0 16777215 border-none edges-zero (edges-xy 0 4))
    }
