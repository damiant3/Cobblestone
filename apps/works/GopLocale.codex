Chapter: GopLocale

Section: Days

  loc-dow-t : Integer -> Integer
  loc-dow-t (m) =
    if m == 1 then 0 else if m == 2 then 3 else if m == 3 then 2
    else if m == 4 then 5 else if m == 5 then 0 else if m == 6 then 3
    else if m == 7 then 5 else if m == 8 then 1 else if m == 9 then 4
    else if m == 10 then 6 else if m == 11 then 2 else 4

  loc-dow : Integer, Integer, Integer -> Integer
  loc-dow (y) (m) (d) =
    let yy = if m < 3 then y - 1 else y
    in int-mod (yy + yy / 4 - yy / 100 + yy / 400 + loc-dow-t m + d) 7

  loc-dow-name : Integer -> Text
  loc-dow-name (w) =
    if w == 0 then "Sunday" else if w == 1 then "Monday" else if w == 2 then "Tuesday"
    else if w == 3 then "Wednesday" else if w == 4 then "Thursday" else if w == 5 then "Friday"
    else "Saturday"

Section: Months

  loc-leap : Integer -> Boolean
  loc-leap (y) = int-mod y 4 == 0 & (int-mod y 100 /= 0 | int-mod y 400 == 0)

  loc-month-len : Integer, Integer -> Integer
  loc-month-len (y) (m) =
    if m == 2 then (if loc-leap y then 29 else 28)
    else if m == 4 | m == 6 | m == 9 | m == 11 then 30
    else 31

  loc-month-name : Integer -> Text
  loc-month-name (m) =
    if m == 1 then "January" else if m == 2 then "February" else if m == 3 then "March"
    else if m == 4 then "April" else if m == 5 then "May" else if m == 6 then "June"
    else if m == 7 then "July" else if m == 8 then "August" else if m == 9 then "September"
    else if m == 10 then "October" else if m == 11 then "November" else if m == 12 then "December"
    else "?"

  loc-month-short : Integer -> Text
  loc-month-short (m) =
    if m == 1 then "Jan" else if m == 2 then "Feb" else if m == 3 then "Mar"
    else if m == 4 then "Apr" else if m == 5 then "May" else if m == 6 then "Jun"
    else if m == 7 then "Jul" else if m == 8 then "Aug" else if m == 9 then "Sep"
    else if m == 10 then "Oct" else if m == 11 then "Nov" else if m == 12 then "Dec"
    else "?"

  loc-nth-dow : Integer, Integer, Integer, Integer -> Integer
  loc-nth-dow (y) (m) (w) (n) =
    if n <= 0 then loc-last-dow y m w
    else let first = 1 + int-mod (w - loc-dow y m 1 + 7) 7
    in first + 7 * (n - 1)

  loc-last-dow : Integer, Integer, Integer -> Integer
  loc-last-dow (y) (m) (w) =
    let len = loc-month-len y m
    in len - int-mod (loc-dow y m len - w + 7) 7

Section: Summer time

  loc-dst-none : Integer = 0
  loc-dst-eu : Integer = 1
  loc-dst-us : Integer = 2
  loc-dst-au : Integer = 3
  loc-dst-nz : Integer = 4
  loc-dst-south : Integer = 5

  loc-dst-name : Integer -> Text
  loc-dst-name (r) =
    if r == loc-dst-none then "no summer time"
    else if r == loc-dst-eu then "European"
    else if r == loc-dst-us then "North American"
    else if r == loc-dst-au then "Australian"
    else if r == loc-dst-nz then "New Zealand"
    else "southern"

  loc-md : Integer, Integer -> Integer
  loc-md (m) (d) = m * 100 + d

  loc-in-window : Integer, Integer, Integer -> Boolean
  loc-in-window (now) (start) (stop) =
    if start <= stop then now >= start & now < stop
    else now >= start | now < stop

  loc-dst-start : Integer, Integer -> Integer
  loc-dst-start (rule) (y) =
    if rule == loc-dst-eu then loc-md 3 (loc-last-dow y 3 0)
    else if rule == loc-dst-us then loc-md 3 (loc-nth-dow y 3 0 2)
    else if rule == loc-dst-au then loc-md 10 (loc-nth-dow y 10 0 1)
    else if rule == loc-dst-nz then loc-md 9 (loc-last-dow y 9 0)
    else if rule == loc-dst-south then loc-md 10 (loc-nth-dow y 10 0 3)
    else 0

  loc-dst-end : Integer, Integer -> Integer
  loc-dst-end (rule) (y) =
    if rule == loc-dst-eu then loc-md 10 (loc-last-dow y 10 0)
    else if rule == loc-dst-us then loc-md 11 (loc-nth-dow y 11 0 1)
    else if rule == loc-dst-au then loc-md 4 (loc-nth-dow y 4 0 1)
    else if rule == loc-dst-nz then loc-md 4 (loc-nth-dow y 4 0 1)
    else if rule == loc-dst-south then loc-md 2 (loc-nth-dow y 2 0 3)
    else 0

  loc-dst-on : Integer, Integer, Integer, Integer, Integer -> Boolean
  loc-dst-on (rule) (y) (m) (d) (hh) =
    if rule == loc-dst-none then False
    else
      let now = loc-md m d
      in let s = loc-dst-start rule y
      in let e = loc-dst-end rule y
      in if now == s then hh >= 2
      else if now == e then hh < 2
      else loc-in-window now s e

  loc-dst-minutes : Integer -> Integer
  loc-dst-minutes (rule) = if rule == loc-dst-none then 0 else 60

Section: Formats

  loc-clock-24 : Integer = 0
  loc-clock-12 : Integer = 1

  loc-date-dmy : Integer = 0
  loc-date-mdy : Integer = 1
  loc-date-ymd : Integer = 2

  loc-clock-name : Integer -> Text
  loc-clock-name (f) = if f == loc-clock-12 then "12 hour" else "24 hour"

  loc-date-name : Integer -> Text
  loc-date-name (f) =
    if f == loc-date-mdy then "month day year"
    else if f == loc-date-ymd then "year month day"
    else "day month year"

  loc-pad2 : Integer -> Text
  loc-pad2 (v) = if v < 10 then "0" & show v else show v

  loc-hour-12 : Integer -> Integer
  loc-hour-12 (h) = if h == 0 then 12 else if h > 12 then h - 12 else h

  loc-meridiem : Integer -> Text
  loc-meridiem (h) = if h < 12 then "AM" else "PM"

  loc-time : Integer, Integer, Integer, Integer -> Text
  loc-time (f) (h) (mi) (s) =
    if f == loc-clock-12 then loc-pad2 (loc-hour-12 h) & ":" & loc-pad2 mi & ":" & loc-pad2 s & " " & loc-meridiem h
    else loc-pad2 h & ":" & loc-pad2 mi & ":" & loc-pad2 s

  loc-time-short : Integer, Integer, Integer -> Text
  loc-time-short (f) (h) (mi) =
    if f == loc-clock-12 then loc-pad2 (loc-hour-12 h) & ":" & loc-pad2 mi & " " & loc-meridiem h
    else loc-pad2 h & ":" & loc-pad2 mi

  loc-date : Integer, Integer, Integer, Integer -> Text
  loc-date (f) (y) (m) (d) =
    if f == loc-date-mdy then loc-pad2 m & "/" & loc-pad2 d & "/" & show y
    else if f == loc-date-ymd then show y & "-" & loc-pad2 m & "-" & loc-pad2 d
    else loc-pad2 d & "/" & loc-pad2 m & "/" & show y

  loc-date-long : Integer, Integer, Integer, Integer -> Text
  loc-date-long (f) (y) (m) (d) =
    if f == loc-date-mdy then loc-month-name m & " " & show d & ", " & show y
    else if f == loc-date-ymd then show y & " " & loc-month-name m & " " & show d
    else show d & " " & loc-month-name m & " " & show y

Section: Offsets

  loc-off-text : Integer -> Text
  loc-off-text (mins) =
    let neg = mins < 0
    in let a = if neg then 0 - mins else mins
    in (if neg then "-" else "+") & loc-pad2 (a / 60) & ":" & loc-pad2 (int-mod a 60)

  loc-utc-text : Integer -> Text
  loc-utc-text (mins) = "UTC" & loc-off-text mins

