 We say:

Section: Font Handle

  GopAppFont = record { af-ui : GopFont, af-code : GopFont, af-bitmap : CbfFont }

  gapp-fallback : CbfFont -> GopAppFont
  gapp-fallback (bitmap) = GopAppFont { af-ui = gfont-none, af-code = gfont-none, af-bitmap = bitmap }

  gapp-col-w : GopAppFont, Integer -> Integer
  gapp-col-w (f) (scale) =
    let width = if f.af-code.gf-ok then gfont-text-w (f.af-code) "M" else 0
    in if width > 0 then width else 8 * scale

  gapp-ui-w : GopAppFont, Text, Integer -> Integer
  gapp-ui-w (f) (text) (scale) =
    if f.af-ui.gf-ok then gfont-text-w (f.af-ui) text else text-length text * 8 * scale

  gapp-ui-h : GopAppFont, Integer -> Integer
  gapp-ui-h (f) (scale) = if f.af-ui.gf-ok then f.af-ui.gf-gh else 16 * scale

  gapp-ui-text-fit : Integer, Integer, Integer, GopAppFont, Integer, Integer, Integer, Text, Integer, Integer -> Integer
  gapp-ui-text-fit (base) (stride) (rows) (f) (x) (y) (right) (text) (fg) (scale) =
    if right <= x then 0
    else if f.af-ui.gf-ok then gfont-text-clip (f.af-ui) base stride rows right x y text fg
    else let cols = (right - x) / (8 * scale)
    in gop-draw-text base stride rows (f.af-bitmap) x y (if text-length text > cols then substring text 0 cols else text) fg scale 0

  gapp-ui-text : Integer, Integer, Integer, GopAppFont, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  gapp-ui-text (base) (stride) (rows) (f) (x) (y) (text) (fg) (scale) (i) =
    if f.af-ui.gf-ok then gfont-text-clip (f.af-ui) base stride rows stride x y (if i == 0 then text else substring text i (text-length text - i)) fg
    else gop-draw-text base stride rows (f.af-bitmap) x y text fg scale i

  gapp-code-text : Integer, Integer, Integer, GopAppFont, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  gapp-code-text (base) (stride) (rows) (f) (x) (y) (text) (fg) (scale) (i) =
    if f.af-code.gf-ok then gfont-text-clip (f.af-code) base stride rows stride x y (if i == 0 then text else substring text i (text-length text - i)) fg
    else gop-draw-text base stride rows (f.af-bitmap) x y text fg scale i

  GopFont = record {
    gf-ok : Boolean,
    gf-base : Integer,
    gf-gw : Integer,
    gf-gh : Integer,
    gf-asc : Integer,
    gf-cap : Integer
  }

  gfont-none : GopFont
  gfont-none = GopFont { gf-ok = False, gf-base = 0, gf-gw = 0, gf-gh = 0, gf-asc = 0, gf-cap = 0 }

Section: Load

  gfont-config-name : Integer, Integer, Integer, Text -> Text
  gfont-config-name (buf) (i) (count) (acc) =
    if i >= count then acc
    else let u = peek-byte buf i
    in if u == 0 | u == 10 | u == 13 | u == 32 then acc
    else if (u >= 65 & u <= 90) | (u >= 48 & u <= 57) | u == 46 | u == 95 then
      gfont-config-name buf (i + 1) count (acc & char-encode (code-to-char (from-unicode u)))
    else ""

  gfont-selected : Fat16Volume, Integer -> [Device.Port] GopFont
  gfont-selected (vol) (ppem) = act
    size <- gfat-file-size vol "UIFONT.CFG"
    if size <= 0 | size > 16 then gfont-load vol "CMUNSS.TTF" ppem
    else act
      let buf = __heap-save
      in let reserved = __heap-advance 1024
      in act
        read <- gfat-read-file-bulk vol "UIFONT.CFG" buf
        let name = if read == size then gfont-config-name buf 0 size "" else ""
        in if text-length name == 0 then gfont-load vol "CMUNSS.TTF" ppem
        else act
          selected <- gfont-load vol name ppem
          if selected.gf-ok then selected else gfont-load vol "CMUNSS.TTF" ppem
        end
      end
    end
  end

  gfont-load : Fat16Volume, Text, Integer -> [Device.Port] GopFont
  gfont-load (vol) (name) (ppem) = act
    size <- gfat-file-size vol name
    if size == 0 then gfont-none
    else act
      let buf = __heap-save
      in let adv = __heap-advance (size + 1024)
      in act
        n <- gfat-read-file-bulk vol name buf
        if n == 0 then gfont-none
        else if fb-ttf-plausible buf n then
          let font = fb-parse-ttf buf size
          in let rasters = fb-render-ascii buf font ppem
          in let maxw = fl-max-width rasters 0 0
          in let maxh = fl-max-height rasters 0 0
          in let gbase = fl-raster-to-gobf rasters maxw maxh
          in let upem = font.tf-head.th-units-per-em
          in let asc = font.tf-head.th-y-max * ppem / upem
          in GopFont { gf-ok = True, gf-base = gbase, gf-gw = maxw, gf-gh = maxh, gf-asc = asc, gf-cap = fl-cap-rows buf font ppem }
        else gfont-none
      end
    end
  end

Section: Draw

  gfont-text : GopFont, Integer, Integer, Integer, Integer, Integer, Text, Integer -> Integer
  gfont-text (f) (base) (stride) (h) (x) (y) (s) (fg) =
    gbf-put-text (GopBuf { gb-base = base, gb-width = stride, gb-height = h }) (f.gf-base) (f.gf-gw) (f.gf-gh) x y s fg

  gfont-text-clip : GopFont, Integer, Integer, Integer, Integer, Integer, Integer, Text, Integer -> Integer
  gfont-text-clip (f) (base) (stride) (h) (max-x) (x) (y) (s) (fg) =
    gbf-put-text-clip (GopBuf { gb-base = base, gb-width = stride, gb-height = h }) (f.gf-base) (f.gf-gw) (f.gf-gh) x y max-x s fg

  gfont-text-w : GopFont, Text -> Integer
  gfont-text-w (f) (s) =
    if f.gf-ok == False then 0
    else gbf-measure-text (f.gf-base) (f.gf-gw) (f.gf-gh) s
