    else if r == 4 then 864
    else if r == 5 then 1584
    else if r == 6 then 3096
    else if r == 7 then 2056
    else if r == 8 then 3640
    else if r >= 9 & r <= 14 then 544
    else if r == 15 then 3640
    else if r == 16 then 2056
    else if r == 17 then 3096
    else if r == 18 then 1584
    else if r == 19 then 864
    else if r == 20 then 448
