    else if r == 5 then 448
    else if r == 6 then 992
    else if r == 7 then 2032
    else if r >= 8 & r <= 15 then 448
    else if r == 16 then 2032
    else if r == 17 then 992
    else if r == 18 then 448
    else if r == 19 then 128
    else 0

