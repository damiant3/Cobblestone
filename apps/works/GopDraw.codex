    else if r == 11 then 32784
    else if r == 12 then 32776
    else if r == 13 then 32772
    else if r == 14 then 32770
    else if r == 15 then 32895
    else if r == 16 then 32832
    else if r == 17 then 33856
    else if r == 18 then 35360
    else if r == 19 then 37136
    else if r == 20 then 41096
    else if r == 21 then 49220
    else if r == 22 then 32804
