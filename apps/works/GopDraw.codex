  cursor-fill-nesw (r) =
    if r == 7 then 124
    else if r == 8 then 60
    else if r == 9 then 60
    else if r == 10 then 124
    else if r == 11 then 228
    else if r == 12 then 448
    else if r == 13 then 4992
    else if r == 14 then 7936
    else if r == 15 then 7680
    else if r == 16 then 7680
    else if r == 17 then 7936
    else 0

  cursor-edge-of : Integer, Integer -> Integer
  cursor-edge-of (shape) (r) =
    if shape == cursor-shape-ew then cursor-edge-ew r
    else if shape == cursor-shape-ns then cursor-edge-ns r
    else if shape == cursor-shape-nwse then cursor-edge-nwse r
    else if shape == cursor-shape-nesw then cursor-edge-nesw r
    else cursor-edge-mask r

  cursor-fill-of : Integer, Integer -> Integer
  cursor-fill-of (shape) (r) =
    if shape == cursor-shape-ew then cursor-fill-ew r
    else if shape == cursor-shape-ns then cursor-fill-ns r
    else if shape == cursor-shape-nwse then cursor-fill-nwse r
    else if shape == cursor-shape-nesw then cursor-fill-nesw r
    else cursor-fill-mask r

 The shape lives in the cursor block rather than being passed down from the
 desk on every move, because `cursor-hide` and `cursor-update` are called from
 a dozen places that have no idea what the pointer is over and must not have to
 learn.

  cursor-shape-cell : Integer = 20

  cursor-shape : Integer -> Integer
  cursor-shape (cs) = peek-32 cs cursor-shape-cell

  cursor-set-shape : Integer, Integer -> Integer
  cursor-set-shape (cs) (shape) = poke-32 cs cursor-shape-cell shape

  cursor-paint-cols : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cursor-paint-cols (base) (stride) (mx) (my) (skipx) (cwc) (py) (em) (fm) (px) =
    if px >= cwc then 0
    else let lc = px + skipx
    in let e = bit-and (bit-shru em (15 - lc)) 1
    in let f = bit-and (bit-shru fm (15 - lc)) 1
    in let w = if e == 1 then gop-put base stride (mx + px) (my + py) cursor-col-edge
          else if f == 1 then gop-put base stride (mx + px) (my + py) cursor-col-fill
          else 0
    in cursor-paint-cols base stride mx my skipx cwc py em fm (px + 1)

  cursor-paint-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cursor-paint-rows (base) (stride) (mx) (my) (skipx) (skipy) (shape) (cwc) (chc) (py) =
    if py >= chc then 0
    else let lr = py + skipy
    in let em = cursor-edge-of shape lr
    in let fm = cursor-fill-of shape lr
    in let w = cursor-paint-cols base stride mx my skipx cwc py em fm 0
    in cursor-paint-rows base stride mx my skipx skipy shape cwc chc (py + 1)

  cursor-save-cols : Integer, Integer, Integer, Integer, Integer -> Integer
  cursor-save-cols (cs) (base) (stride) (r) (c) =
    if c >= peek-32 cs 12 then 0
    else let a = poke-32 cs (32 + (r * 16 + c) * 4) (peek-32 base (((peek-32 cs 8 + r) * stride + peek-32 cs 4 + c) * 4))
    in cursor-save-cols cs base stride r (c + 1)

  cursor-save-rows : Integer, Integer, Integer, Integer -> Integer
  cursor-save-rows (cs) (base) (stride) (r) =
    if r >= peek-32 cs 16 then 0
    else let cc = cursor-save-cols cs base stride r 0
    in cursor-save-rows cs base stride (r + 1)

  cursor-rest-cols : Integer, Integer, Integer, Integer, Integer -> Integer
  cursor-rest-cols (cs) (base) (stride) (r) (c) =
    if c >= peek-32 cs 12 then 0
    else let a = poke-32 base (((peek-32 cs 8 + r) * stride + peek-32 cs 4 + c) * 4) (peek-32 cs (32 + (r * 16 + c) * 4))
    in cursor-rest-cols cs base stride r (c + 1)

  cursor-rest-rows : Integer, Integer, Integer, Integer -> Integer
  cursor-rest-rows (cs) (base) (stride) (r) =
    if r >= peek-32 cs 16 then 0
    else let cc = cursor-rest-cols cs base stride r 0
    in cursor-rest-rows cs base stride (r + 1)

  cursor-min : Integer, Integer -> Integer
  cursor-min (a) (b) = if a < b then a else b

  cursor-hide : Integer, Integer, Integer -> Integer
  cursor-hide (cs) (base) (stride) =
    if peek-32 cs 0 == 0 then 0
    else let r = cursor-rest-rows cs base stride 0
    in poke-32 cs 0 0

 THE SAVED RECTANGLE IS CLIPPED TO THE GLASS AND THE MASK IS INDEXED THROUGH
 THE CLIP. With the arrow's hotspot at its tip the sprite origin was the
 pointer, which is never negative, so `cursor-save-cols` and `cursor-rest-cols`
 could walk the framebuffer with raw address arithmetic and no bound. A centred
 hotspot puts the origin at `mx - 8`, which IS negative along the left edge of
 the screen, and those two functions have no guard of their own: this is the
 same shape as the `gop-put`/`gop-get` fault that cost a guest crash on
 2026-08-26, one layer over.

 So the origin is clamped and the number of mask rows and columns skipped is
 carried into the paint. The sprite is CROPPED at the edges of the glass rather
 than the framebuffer being walked off, and what is saved is exactly what is
 painted, which is the invariant the restore depends on.

 The clip is four named functions rather than arithmetic inline in
 `cursor-update`, because the update needs a framebuffer and a pointer and can
 only be checked by looking at a screen. Where the sprite lands, and how much
 of it survives the edge of the glass, is decidable without either.

  cursor-org : Integer, Integer -> Integer
  cursor-org (m) (hot) = m - hot

  cursor-lo : Integer -> Integer
  cursor-lo (o) = if o < 0 then 0 else o

  cursor-skip : Integer -> Integer
  cursor-skip (o) = if o < 0 then 0 - o else 0

  cursor-span : Integer, Integer, Integer -> Integer
  cursor-span (o) (extent) (limit) =
    cursor-min (extent - cursor-skip o) (limit - cursor-lo o)

  cursor-update : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cursor-update (cs) (base) (stride) (pw) (ph) (s) (mx) (my) =
    let r0 = if peek-32 cs 0 /= 0 then cursor-rest-rows cs base stride 0 else 0
    in let shape = cursor-shape cs
    in let ox = cursor-org mx (cursor-hot-x shape)
    in let oy = cursor-org my (cursor-hot-y shape)
    in let x0 = cursor-lo ox
    in let y0 = cursor-lo oy
    in let skipx = cursor-skip ox
    in let skipy = cursor-skip oy
    in let cwc = cursor-span ox cursor-w pw
    in let chc = cursor-span oy cursor-h ph
    in if cwc <= 0 then poke-32 cs 0 0
    else if chc <= 0 then poke-32 cs 0 0
    else
      let s0 = poke-32 cs 4 x0
      in let s1 = poke-32 cs 8 y0
      in let s2 = poke-32 cs 12 cwc
      in let s3 = poke-32 cs 16 chc
      in let sv = cursor-save-rows cs base stride 0
      in let d0 = cursor-paint-rows base stride x0 y0 skipx skipy shape cwc chc 0
      in poke-32 cs 0 1

Section: Pixel

  gop-put : Integer, Integer, Integer, Integer, Integer -> Integer
 A PIXEL OFF THE SIDE OF THE GLASS LANDS ON THE NEXT ROW, and until windows
 could hang off the screen nothing ever asked for one. `(y * stride + x) * 4`
 with `x` past the scan line is simply the next row's arithmetic, so a window
 dragged off the right edge drew its missing strip down the LEFT of the
 screen: Damian, 2026-08-26, "like a continuous secret path from screen to
 screen". A negative `x` does the same thing one row up.

 THE GUARD IS HERE AND NOT AT THE CALLERS because every path funnels through
 this one write -- the fills, the glyph rows, the icons, the cursor, the
 window border. Six direct fills in `dk-wnd-frame` alone would each have
 needed their own, and the tree render's clip is the WINDOW's rect, which is
 exactly the rect that is off the screen.

 `stride` is the scan line in pixels and is the only bound this function has.
 It has no height, so `y` is guarded against going negative and nothing more;
 the bottom is held by the drag clamp keeping a window's whole height on the
 glass, which is a weaker place for it and is said out loud here rather than
 left to be discovered.

  gop-put (base) (stride) (x) (y) (color) =
    if x < 0 then 0
    else if x >= stride then 0
    else if y < 0 then 0
    else poke-32 base ((y * stride + x) * 4) color

 The GOP framebuffer is ordinary RAM at GPA 0xBF000000 with no MMIO trap, so
 reading a pixel back costs what any other load costs. That is what makes
 partial coverage affordable: a caller that knows a pixel is half covered
 reads what is under it and mixes.

 AND THE READ NEEDS THE SAME BOUND, which cost a guest crash to learn. Only
 the WRITE was guarded at first, on the reasoning that an out-of-bounds write
 is the dangerous one. Dragging the Calculator off the LEFT edge faulted the
 guest immediately: `!EXC=0e`, `CR2=0x4bf2ce658`, which is the framebuffer
 base plus an offset that has run past 4 GiB because a negative `x` was
 carried into the address as an unsigned 32-bit word. The faulting RIP
 resolved to `peek-32`, not to any writer.

 IT IS THIS FUNCTION BECAUSE PARTIAL COVERAGE READS WHAT IT IS ABOUT TO
 BLEND WITH. The rounded corners, the bevel and the soft shadow all sample
 the destination pixel through here, so they are exactly the paths that run
 along a window's border -- the border that is off the screen. The note above
 about reading a pixel back being affordable is what made this reachable at
 all.

 Off the glass answers 0. Nothing on the screen is blended from it, because
 the write that would consume it is refused by the guard in `gop-put`.

  gop-get : Integer, Integer, Integer, Integer -> Integer
  gop-get (base) (stride) (x) (y) =
    if x < 0 then 0
    else if x >= stride then 0
    else if y < 0 then 0
    else peek-32 base ((y * stride + x) * 4)

  gop-chan : Integer, Integer -> Integer
  gop-chan (c) (sh) = bit-and (bit-shru c sh) 255

  gop-mix : Integer, Integer, Integer -> Integer
  gop-mix (dst) (src) (a) =
    let r = (gop-chan dst 16 * (255 - a) + gop-chan src 16 * a) / 255
    in let g = (gop-chan dst 8 * (255 - a) + gop-chan src 8 * a) / 255
    in let b = (gop-chan dst 0 * (255 - a) + gop-chan src 0 * a) / 255
    in bit-shl r 16 + bit-shl g 8 + b

  gop-blend : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-blend (base) (stride) (x) (y) (color) (a) =
    if a <= 0 then 0
    else if a >= 255 then gop-put base stride x y color
    else gop-put base stride x y (gop-mix (gop-get base stride x y) color a)

Section: Rectangles

  gop-rect-cols : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-rect-cols (base) (stride) (px) (py) (pw) (color) (x) =
    if x >= pw then 0
    else let p = gop-put base stride (px + x) py color
    in gop-rect-cols base stride px py pw color (x + 1)

  gop-fill-rect : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
 THE BULK FILL CLIPS ITS SPAN ONCE RATHER THAN PER PIXEL. `gop-put` guards
 every write, which is what makes the scattered writers safe, but a
 full-screen fill is 1.44 million of them and a rect that is entirely on the
 glass should pay nothing for the window that hangs off it. Narrowing the
 span here means the inner loop never offers `gop-put` a pixel to reject.

  gop-fill-rect (base) (stride) (px) (py) (pw) (ph) (color) =
    let x0 = if px < 0 then 0 else px
    in let x1 = if px + pw > stride then stride else px + pw
    in if x1 <= x0 then 0
    else gop-rect-rows base stride x0 py (x1 - x0) ph color 0

  gop-rect-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-rect-rows (base) (stride) (px) (py) (pw) (ph) (color) (y) =
    if y >= ph then 0
    else let r = gop-rect-cols base stride px (py + y) pw color 0
    in gop-rect-rows base stride px py pw ph color (y + 1)

Section: Glyph

  gop-char-cols : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-char-cols (base) (stride) (px) (py) (glyph) (fg) (scale) (col) =
    if col >= 8 then 0
    else let on = bit-and (bit-shru glyph (7 - col)) 1
    in let p = if on == 1 then gop-fill-rect base stride (px + col * scale) py scale scale fg else 0
    in gop-char-cols base stride px py glyph fg scale (col + 1)

  gop-char-rows : Integer, Integer, CbfFont, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-char-rows (base) (stride) (font) (px) (py) (cce) (fg) (scale) (row) =
    if row >= 16 then 0
    else let glyph = cbf-row font cce row
    in let r = gop-char-cols base stride px (py + row * scale) glyph fg scale 0
    in gop-char-rows base stride font px py cce fg scale (row + 1)

  gop-draw-text : Integer, Integer, CbfFont, Integer, Integer, Text, Integer, Integer, Integer -> Integer
 CLIPPED AT THE SCANLINE, and the clip is the whole point. The framebuffer
 is linear, so a glyph drawn past the end of a row does not fall off the
 screen: its pixels land on the NEXT row, on top of whatever is there. A
 line one character too long therefore destroys itself AND its neighbour,
 and it does it silently. Measured 2026-07-29 on two of the three sitting
 rungs at 1280x800: MscAlignProbe's LIVENESS line came back reading
 "ng)LIVENESS out-of-range" with its own tail sitting on its head, and
 KbdDiagProbe's instruction line the same way.

 Panel width is not ours to choose, and it is the one thing about the
 target machine we do not know before the sitting. A line that fits the dev
 box at 1280 wraps at 1024 and shreds the screen at 800, so without this
 bound every probe's legibility is a bet on the panel.

  gop-draw-text (base) (stride) (font) (px) (py) (s) (fg) (scale) (i) =
    if i >= text-length s then 0
    else if px + (i + 1) * 8 * scale > stride then 0
    else let cce = char-code (char-at s i)
    in let c = gop-char-rows base stride font (px + i * 8 * scale) py cce fg scale 0
    in gop-draw-text base stride font px py s fg scale (i + 1)

Section: Wrapped Text

  gop-word-len : Text, Integer -> Integer
  gop-word-len (s) (i) =
    if i >= text-length s then 0
    else if gop-is-space (char-code (char-at s i)) then 0
    else 1 + gop-word-len s (i + 1)

  gop-is-space : Integer -> Boolean
  gop-is-space (cc) = if cc >= 1 then cc <= 2 else False

  gop-draw-text-wrap : Integer, Integer, CbfFont, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  gop-draw-text-wrap (base) (stride) (font) (px) (py) (s) (fg) (scale) (w) =
    let cpl = (w - px) / (8 * scale)
    in if cpl <= 0 then 0
    else gop-wrap-go base stride font px py s fg scale cpl 0 0 0

  gop-wrap-go : Integer, Integer, CbfFont, Integer, Integer, Text, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-wrap-go (base) (stride) (font) (px) (py) (s) (fg) (scale) (cpl) (i) (col) (line) =
    if i >= text-length s then line + 1
    else let cc = char-code (char-at s i)
    in if gop-is-space cc then
      (if col + 1 + gop-word-len s (i + 1) > cpl
       then gop-wrap-go base stride font px py s fg scale cpl (i + 1) 0 (line + 1)
       else gop-wrap-go base stride font px py s fg scale cpl (i + 1) (col + 1) line)
    else if col >= cpl then gop-wrap-go base stride font px py s fg scale cpl i 0 (line + 1)
    else let c = gop-char-rows base stride font (px + col * 8 * scale) (py + line * 16 * scale) cc fg scale 0
    in gop-wrap-go base stride font px py s fg scale cpl (i + 1) (col + 1) line

Section: Scale

  ui-scale : Integer -> Integer
  ui-scale (w) = if w >= 1024 then 2 else 1

 The WIDGET layer scales separately from the hand-drawn one, and the reason is
 that a widget tree's minimum sizes are written in the space it is laid out in.
 Every app tree in this tree was authored against 1024x768, so dividing that
 space to scale the chrome does not shrink the chrome, it shrinks the ROOM: at
 scale 2 a 1024x768 panel lays out in 512x384 and the calculator loses four of
 its fifteen keys off the bottom. Measured 2026-08-11. So this stays 1 until
 the panel is big enough that halving it still leaves more room than 1024x768
 gave, which is why the step is at 1600 and not at 1024.

  ui-wscale : Integer -> Integer
  ui-wscale (w) = if w >= 1600 then 2 else 1


Section: An inverting frame

 A rectangle outline XORed into the framebuffer, which is how a window is
 dragged without repainting it.

 THERE IS NO BACK BUFFER HERE, so a live move costs an erase and a redraw of
 the whole window on every mouse sample and the scanout catches the gap. That
 is what a person sees as flicker, and no amount of narrowing WHICH pixels are
 repainted removes it: the window's own pixels are the ones that blink.
 Measured the honest way, by asking Damian twice -- scoping the repaint down
 from the whole screen to the chrome changed nothing he could see.

 XOR is the classic answer because it is its OWN eraser. Drawing the same
 frame a second time restores every pixel exactly, whatever was underneath,
 with no save-under buffer and no knowledge of the background. What moves per
 sample is then four thin bands rather than a window.

 It inverts the low 24 bits and leaves the top byte alone, so the outline is
 visible over the wall, over another window and over the chrome, and the
 padding byte the GOP carries is untouched.

  gop-xor-mask : Integer = 16777215

  gop-xor-span : Integer, Integer, Integer, Integer, Integer -> Integer
  gop-xor-span (base) (stride) (y) (x) (x1) =
    if x >= x1 then 0
    else let o = (y * stride + x) * 4
    in let v = poke-32 base o (bit-xor (peek-32 base o) gop-xor-mask)
    in gop-xor-span base stride y (x + 1) x1

  gop-xor-band : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-xor-band (base) (stride) (x0) (x1) (y) (y1) =
    if y >= y1 then 0
    else let r = gop-xor-span base stride y x0 x1
    in gop-xor-band base stride x0 x1 (y + 1) y1

 EVERY BAND IS CLIPPED TO THE GLASS, and that is not defensive tidiness: a
 window may be dragged partly off the screen, so an unclipped span would walk
 off the end of a scan line into the next row, or off the end of the
 framebuffer entirely. A band clipped to nothing answers zero and draws
 nothing, which is also what makes the degenerate sizes below safe.

  gop-xor-rect : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-xor-rect (base) (stride) (sw) (sh) (x) (y) (w) (h) =
    let x0 = if x < 0 then 0 else x
    in let y0 = if y < 0 then 0 else y
    in let x1 = if x + w > sw then sw else x + w
    in let y1 = if y + h > sh then sh else y + h
    in if x0 >= x1 then 0
    else if y0 >= y1 then 0
    else gop-xor-band base stride x0 x1 y0 y1

 The two side bands are inset by the thickness so the corners are inverted
 ONCE. Inverting a corner twice would restore it and leave the frame with four
 notches, which is the sort of defect that looks like a rounding error and is
 not.

  gop-xor-frame : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gop-xor-frame (base) (stride) (sw) (sh) (x) (y) (w) (h) (t) =
    let a = gop-xor-rect base stride sw sh x y w t
    in let b = gop-xor-rect base stride sw sh x (y + h - t) w t
    in let c = gop-xor-rect base stride sw sh x (y + t) t (h - 2 * t)
    in gop-xor-rect base stride sw sh (x + w - t) (y + t) t (h - 2 * t)
