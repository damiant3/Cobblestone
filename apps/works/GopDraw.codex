  cursor-edge-nesw (r) =
    if r == 6 then 254
    else if r == 7 then 130
    else if r == 8 then 194
    else if r == 9 then 194
    else if r == 10 then 386
    else if r == 11 then 794
    else if r == 12 then 15934
    else if r == 13 then 11360
    else if r == 14 then 8384
    else if r == 15 then 8576
    else if r == 16 then 8576
