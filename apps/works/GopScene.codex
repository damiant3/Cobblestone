 We say:

Section: Geometry

  gsc-radius : Real = 5.2
  gsc-eye-height : Real = 2200.0
  gsc-turn : Integer = 6283

Section: Scene

  gsc-camera : Integer, Real -> Camera3D
  gsc-camera (angle) (aspect) =
    let ca = real-from-int (cordic-cos angle)
    in let sa = real-from-int (cordic-sin angle)
    in let c = camera3d-new (vec3-new (ca * gsc-radius) gsc-eye-height (sa * gsc-radius)) (vec3-new 0.0 300.0 0.0) 0.785
    in __record-set c "c3-aspect" aspect

  gsc-aspect : Integer, Integer -> Real
  gsc-aspect (w) (h) = if h <= 0 then 1.333 else real-from-int w / real-from-int h

  gsc-ground-tex : EngineTexture
  gsc-ground-tex = etx-checkerboard 8 8 1 (etx-pack-rgb 170 150 120) (etx-pack-rgb 110 95 75)

  gsc-scene : Integer -> Scene3DState
  gsc-scene (dummy) =
    let scene = scene3d-new (gsc-camera 0 1.333)
    in let checker = gsc-ground-tex
    in let ground = sn3-with-mesh "ground" (mesh-plane 3000 3000) (emat-set-texture (emat-flat (rgb 240 240 240)) checker)
    in let cube = sn3-set-pos (sn3-with-mesh "cube" (mesh-cube 900) (emat-shiny (rgb 90 130 210) 32)) (-900.0) 900.0 0.0
    in let pyr = sn3-set-pos (sn3-with-mesh "pyr" (mesh-pyramid 600 1100) emat-red) 1100.0 0.0 (-300.0)
    in let ball = sn3-set-pos (sn3-with-mesh "ball" (mesh-sphere 700 12 8) emat-gold) 300.0 700.0 1700.0
    in let ring = sn3-set-pos (sn3-with-mesh "ring" (mesh-torus 650 220 12 8) (emat-set-shading (emat-color (rgb 60 180 90)) GouraudShaded)) (-2000.0) 220.0 1900.0
    in let s2 = scene3d-add (scene3d-add (scene3d-add (scene3d-add (scene3d-add scene ground) cube) pyr) ball) ring
    in let key = dir-light (vec3-new (-400.0) 800.0 400.0) (rgb 255 250 235) 850
    in scene3d-set-ambient (scene3d-add-light s2 key) 260

Section: Loop

  gsc-blit-span : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gsc-blit-span (dst) (doff) (src) (soff) (w) (x) =
    if x >= w then 0
    else let d = poke-32 dst ((doff + x) * 4) (peek-32 src ((soff + x) * 4))
    in gsc-blit-span dst doff src soff w (x + 1)

  gsc-blit-rows : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gsc-blit-rows (dst) (stride) (src) (sstride) (w) (h) (y) =
    if y >= h then 0
    else let d = gsc-blit-span dst (y * stride) src (y * sstride) w 0
    in gsc-blit-rows dst stride src sstride w h (y + 1)

  gsc-shadow-map : Integer = 256

 A presentation unit copies at most 1024 pixels, even when a scanline is
 wider than the unit. The caller retains only the returned pixel offset.

  gsc-present-pixels : Integer = 1024

  gsc-blit-unit : Integer, Integer, R3dTriState, Integer -> Integer
  gsc-blit-unit (dst) (stride) (tgt) (at) =
    if tgt.r3t-w <= 0 | tgt.r3t-h <= 0 | stride < tgt.r3t-w | tgt.r3t-stride < tgt.r3t-w then 0 - 1
    else if at < 0 | at > tgt.r3t-w * tgt.r3t-h then 0 - 1
    else if at == tgt.r3t-w * tgt.r3t-h then at
    else let service = (tgt.r3t-service) 0
    in let remaining = tgt.r3t-w * tgt.r3t-h - at
    in let take = if remaining < gsc-present-pixels then remaining else gsc-present-pixels
    in gsc-blit-unit-work dst stride tgt at (at + take)

  gsc-blit-unit-work : Integer, Integer, R3dTriState, Integer, Integer -> Integer
  gsc-blit-unit-work (dst) (stride) (tgt) (at) (limit) =
    if at >= limit then at
    else let y = at / tgt.r3t-w
    in let x = int-mod at tgt.r3t-w
    in let left = tgt.r3t-w - x
    in let take = if left < limit - at then left else limit - at
    in let d = gsc-blit-span dst (y * stride) (tgt.r3t-base) (y * tgt.r3t-stride) (x + take) x
    in gsc-blit-unit-work dst stride tgt (at + take) limit

  gsc-blit-serviced : Integer, Integer, R3dTriState, Integer -> Integer
  gsc-blit-serviced (dst) (stride) (tgt) (y) =
    gsc-blit-units dst stride tgt (y * tgt.r3t-w)

  gsc-blit-units : Integer, Integer, R3dTriState, Integer -> Integer
  gsc-blit-units (dst) (stride) (tgt) (at) =
    let next = gsc-blit-unit dst stride tgt at
    in if next < 0 then next
    else if next >= tgt.r3t-w * tgt.r3t-h then 0
    else gsc-blit-units dst stride tgt next

  gsc-shadow-map-gpu : Integer = 1024

  gsc-label-sw : Text = "3D: software pipeline. Drag to turn. S toggles shadows, G the GPU. F12 shoots."

  gsc-label-gpu : Text = "3D: host rasterizer, culled, shadow-mapped. S toggles shadows, G software."

  gsc-frame : R3dTriState, Scene3DState, Integer, Integer, Integer, Integer, GopAppFont, Integer, Integer, Integer, GpuView -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  gsc-frame (tgt) (scene) (angle) (sky) (base) (stride) (font) (ch) (sh) (gpu) (gv) = act
    if gpu /= 1 & gsc-tgt-ok tgt == False then
      let bg = gop-fill-rect base stride ch (gv.gv-x) (ch - gsc-label-band) (gv.gv-w) gsc-label-band sky
      in gapp-ui-text-fit base stride ch font (gv.gv-x + 8) (ch - gapp-ui-h font 1) (gv.gv-x + gv.gv-w - 8) (gsc-bad-target tgt) 16711680 1
    else
      let posed = scene3d-set-camera scene (gsc-camera angle (if gpu == 1 then gsc-aspect (gv.gv-w) (gv.gv-h) else gsc-aspect (tgt.r3t-w) (tgt.r3t-h)))
      in if gpu == 1 then act
        g <- if sh == 1 then gs-render-shadowed posed gv sky gsc-shadow-map-gpu else gs-render-in posed gv sky
        let bg = gop-fill-rect base stride ch (gv.gv-x) (ch - gsc-label-band) (tgt.r3t-w) gsc-label-band sky
        in gapp-ui-text-fit base stride ch font (gv.gv-x + 8) (ch - gapp-ui-h font 1) (gv.gv-x + gv.gv-w - 8) gsc-label-gpu 65280 1
      end
      else
        let c = r3d-target-clear tgt sky
        in let d = if sh == 1 then r3d-render-shadowed tgt posed gsc-shadow-map else r3d-render-into tgt posed
        in let b = gsc-blit-serviced (base + gv.gv-x * 4) stride tgt 0
        in gapp-ui-text-fit base stride ch font (gv.gv-x + 8) (ch - gapp-ui-h font 1) (gv.gv-x + gv.gv-w - 8) gsc-label-sw 65280 1
  end

  gsc-tgt-ok : R3dTriState -> Boolean
  gsc-tgt-ok (tgt) = r3d-base-ok (tgt.r3t-base) & r3d-base-ok (tgt.r3t-depth)

  gsc-bad-target : R3dTriState -> Text
  gsc-bad-target (tgt) = "3D TARGET REFUSED base " & integer-to-text (tgt.r3t-base) & " depth " & integer-to-text (tgt.r3t-depth) & " w " & integer-to-text (tgt.r3t-w) & " h " & integer-to-text (tgt.r3t-h)

  gsc-shot : Integer, Integer, Integer, Integer, GopAppFont, Integer -> [Device.Port] Integer
  gsc-shot (scr-base) (w) (h) (stride) (font) (band) = act
    let mark = __heap-save
    in act
      t <- shot-take scr-base w h stride
      let s = ui-scale w
      in let bg = gop-fill-rect scr-base stride h (200 * s) (h - band + 4 * s) (300 * s) (16 * s) #000E1C
      in let tx = gapp-ui-text scr-base stride h font (204 * s) (h - band + 6 * s) t #69BE28 s 0
      in let d = __heap-restore mark
      in 0
    end
  end

  gsc-poll-steps : Integer = 12

  gsc-poll : UsbKbd, Integer -> [Device.Port] Integer
  gsc-poll (kbd) (n) = act
    if n <= 0 then 0
    else act
      sc <- kbd-take kbd
      if sc /= 0 then sc
      else gsc-poll kbd (n - 1)
    end
  end

  gsc-angle : Integer, Integer -> Integer
  gsc-angle (now) (mins) = int-mod (((if now < 0 then 0 else now) + (gsc-bcd mins) * 60) * 105) gsc-turn

Section: Step

  ScenePane = record {
    sp-tgt : R3dTriState,
    sp-px : Integer,
    sp-dp : Integer,
    sp-bw : Integer,
    sp-bh : Integer,
    sp-gv : GpuView,
    sp-sky : Integer,
    sp-ch : Integer,
    sp-fb : Integer,
    sp-sh : Integer,
    sp-gpu : Integer,
    sp-n : Integer,
    sp-t0 : Integer,
    sp-yaw : Integer,
    sp-look : Integer,
    sp-ptr : Integer,
    sp-present : Integer,
    sp-stride : Integer,
    sp-ready : Integer,
    sp-job : Maybe R3dSceneWork,
    sp-front : R3dTriState,
    sp-advance : (Scene3DState, Integer -> Integer),
    sp-allowed : Integer
  }

  gsc-look-gain : Integer = 8
  gsc-look-max : Integer = 64

  gsc-look-clamp : Integer -> Integer
  gsc-look-clamp (d) = if d > gsc-look-max then gsc-look-max else if d < 0 - gsc-look-max then 0 - gsc-look-max else d

  gsc-new : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] ScenePane
  gsc-new (base) (stride) (cs) (gpu) (sky) (bw) (bh) = act
    hd <- cursor-hide cs base stride
    let px = alloc-bytes (bw * bh * 4)
    in let dp = alloc-bytes (bw * bh * 4)
    in act
      tx <- if gpu == 1 then gs-tex-upload gsc-ground-tex else 0
      let started = hpet-start
      in ScenePane {
        sp-tgt = R3dTriState { r3t-base = px, r3t-depth = dp, r3t-w = bw, r3t-h = bh, r3t-stride = bw, r3t-service = r3d-no-service },
        sp-px = px,
        sp-dp = dp,
        sp-bw = bw,
        sp-bh = bh,
        sp-gv = gv-new 0 0 bw (bh - gsc-label-band),
        sp-sky = sky,
        sp-ch = bh,
        sp-fb = base,
        sp-sh = 1,
        sp-gpu = gpu,
        sp-n = 0,
        sp-t0 = hpet-ticks,
        sp-yaw = 0,
        sp-look = 0,
        sp-ptr = 0,
        sp-present = 0 - 1,
        sp-stride = stride,
        sp-ready = 0,
        sp-job = None,
        sp-front = R3dTriState { r3t-base = px, r3t-depth = dp, r3t-w = bw, r3t-h = bh, r3t-stride = bw, r3t-service = r3d-no-service },
        sp-advance = gsc-no-advance,
        sp-allowed = 1
      }
    end
  end

  gsc-fit : Integer, Integer -> Integer
  gsc-fit (want) (cap) = if want < 0 then 0 else if want > cap then cap else want

  gsc-no-advance : Scene3DState, Integer -> Integer
  gsc-no-advance (scene) (tick) = 0

  gsc-owned : ScenePane -> Boolean
  gsc-owned (sp) = when sp.sp-job is None -> False is Just (job) -> True

  gsc-own : ScenePane, Scene3DState, (Scene3DState, Integer -> Integer) -> Integer
  gsc-own (sp) (scene) (advance) =
    let front = __record-set (sp.sp-front) "r3t-base" (alloc-bytes (sp.sp-bw * sp.sp-bh * 4))
    in let job = __record-set sp "sp-job" (Just (sj-new scene (sp.sp-tgt) gsc-shadow-map))
    in let animation = __record-set sp "sp-advance" advance
    in 0

  gsc-copy-vector : Vec3, Vec3 -> Integer
  gsc-copy-vector (dst) (src) =
    let x = __record-set dst "vx" (src.vx)
    in let y = __record-set dst "vy" (src.vy)
    in let z = __record-set dst "vz" (src.vz)
    in 0

  gsc-copy-camera : Camera3D, Camera3D -> Integer
  gsc-copy-camera (dst) (src) =
    let eye = gsc-copy-vector (dst.c3-eye) (src.c3-eye)
    in let target = gsc-copy-vector (dst.c3-target) (src.c3-target)
    in let up = gsc-copy-vector (dst.c3-up) (src.c3-up)
    in let fov = __record-set dst "c3-fov" (src.c3-fov)
    in let near = __record-set dst "c3-near" (src.c3-near)
    in let far = __record-set dst "c3-far" (src.c3-far)
    in let aspect = __record-set dst "c3-aspect" (src.c3-aspect)
    in 0

  gsc-place : ScenePane, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  gsc-place (sp) (base) (stride) (x) (y) (w) (h) =
    let gv = sp.sp-gv
    in let same-view = gv.gv-x == x & gv.gv-y == y & gv.gv-w == w
    in let same-rows = gv.gv-h == h - gsc-label-band & sp.sp-stride == stride
    in let same-base = sp.sp-fb == base + y * stride * 4
    in let invalid = if same-view & same-rows & same-base then 0 else gsc-invalidate sp
    in let a = gsc-view-place gv x y w (h - gsc-label-band)
    in let b = __record-set sp "sp-ch" h
    in let c = __record-set sp "sp-fb" (base + y * stride * 4)
    in let d = __record-set (sp.sp-tgt) "r3t-w" (gsc-fit w (sp.sp-bw))
    in let e = __record-set (sp.sp-tgt) "r3t-h" (gsc-fit h (sp.sp-bh))
    in let g = __record-set (sp.sp-tgt) "r3t-base" (sp.sp-px)
    in let h1 = __record-set (sp.sp-tgt) "r3t-depth" (sp.sp-dp)
    in let i = __record-set (sp.sp-tgt) "r3t-stride" (sp.sp-bw)
    in let j = __record-set sp "sp-stride" stride
    in let fw = __record-set (sp.sp-front) "r3t-w" (gsc-fit w (sp.sp-bw))
    in let fh = __record-set (sp.sp-front) "r3t-h" (gsc-fit h (sp.sp-bh))
    in 0

  gsc-cancel : ScenePane -> Integer
  gsc-cancel (sp) =
    let at = __record-set sp "sp-present" (0 - 1)
    in let job = when sp.sp-job is None -> 0 is Just (work) -> sj-cancel work
    in 0

  gsc-invalidate : ScenePane -> Integer
  gsc-invalidate (sp) =
    let cancel = gsc-cancel sp
    in let ready = __record-set sp "sp-ready" 0
    in 0

  gsc-view-place : GpuView, Integer, Integer, Integer, Integer -> Integer
  gsc-view-place (gv) (x) (y) (w) (h) =
    let a = __record-set gv "gv-x" x
    in let b = __record-set gv "gv-y" y
    in let c = __record-set gv "gv-w" w
    in let d = __record-set gv "gv-h" h
    in 0

  gsc-take : UsbKbd, Integer -> [Device.Port] Integer
  gsc-take (kbd) (sc0) = act
    if sc0 /= 0 then sc0
    else gsc-poll kbd (gsc-poll-steps - 1)
  end

  gsc-step-hide : Integer = 2

  gsc-look : ScenePane, UsbMouse -> Integer
  gsc-look (sp) (mouse) =
    let px = (mouse-x mouse) * 4096 + (mouse-y mouse)
    in let held = bit-and (mouse-buttons mouse) 1 /= 0
    in let moved = mouse.um-ok & held & sp.sp-ptr /= 0 & px /= sp.sp-ptr
    in let d = if moved then gsc-look-clamp ((mouse-x mouse) - (sp.sp-ptr / 4096)) else 0
    in let a = __record-set sp "sp-yaw" (int-mod (sp.sp-yaw + d * gsc-look-gain + gsc-turn) gsc-turn)
    in let b = __record-set sp "sp-ptr" (if mouse.um-ok then px else sp.sp-ptr)
    in let c = __record-set sp "sp-look" (if moved then 1 else sp.sp-look)
    in 0

  gsc-step : Integer, Integer, Integer, Integer, GopAppFont, UsbKbd, UsbMouse, Integer, (Integer -> Scene3DState), ScenePane, Integer, Integer, Integer -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  gsc-step (base) (w) (h) (stride) (font) (kbd) (mouse) (cs) (build) (sp) (sc0) (band) (iq) = act
    sc <- if iq == 0 then gsc-take kbd sc0 else act sc0 end
    if sc == 15 then act
      v <- (gs-viewport-release)
      let cancel = gsc-cancel sp
      in gsc-step-hide
    end
    else if sc == 88 then act
      s <- (gsc-shot base w h stride font band)
      1
    end
    else if sc == 31 then
      let cancel = gsc-invalidate sp
      in let a = __record-set sp "sp-sh" (1 - sp.sp-sh)
      in let b = __record-set sp "sp-n" 0
      in let c = __record-set sp "sp-t0" hpet-ticks
      in 1
    else if sc == 34 then
      let cancel = gsc-invalidate sp
      in let a = __record-set sp "sp-gpu" (1 - sp.sp-gpu)
      in let b = __record-set sp "sp-n" 0
      in let c = __record-set sp "sp-t0" hpet-ticks
      in 1
    else if sp.sp-allowed == 0 | (iq /= 0 & peek-qword iq di-count > 0) then
      let lk = gsc-look sp mouse
      in 1
    else act
      let lk = gsc-look sp mouse
      in let prior-service = (sp.sp-tgt).r3t-service
      in let prior-front-service = (sp.sp-front).r3t-service
      in let hook = __record-set (sp.sp-tgt) "r3t-service" (if gsc-owned sp then r3d-no-service else (\ignored -> di-collect iq kbd mouse w h))
      in let front-hook = __record-set (sp.sp-front) "r3t-service" (\ignored -> di-collect iq kbd mouse w h)
      in let tgt = sp.sp-tgt
      in let software = sp.sp-gpu /= 1 & gsc-tgt-ok tgt & tgt.r3t-w > 0 & tgt.r3t-h > 0
      in let hd = cursor-hide cs base stride
      in act
        f <- if software & sp.sp-ready < 0 then act 0 end
        else if software & sp.sp-present >= 0 then
          act
            gsc-present-step sp stride font h
          end
        else if software & gsc-render-active sp then act
          let phase = gsc-render-unit sp
          in if phase < 0 then gsc-refused sp stride font else phase
        end
        else act
          now <- rtc-seconds 0
          mins <- rtc-read 2
          let ang = if sp.sp-look == 1 then sp.sp-yaw else gsc-orbit now mins
          in if software then act
            when sp.sp-job
              is None -> gsc-render-ready sp (build now) ang
              is Just (job) ->
                let advance = (sp.sp-advance) (job.sj-scene) now
                in let camera = gsc-copy-camera (job.sj-scene.s3-camera) (gsc-camera ang (gsc-aspect (tgt.r3t-w) (tgt.r3t-h)))
                in let begun = sj-begin job (sp.sp-sky) (sp.sp-sh)
                in if begun < 0 then gsc-refused sp stride font else begun
          end
          else act
            f0 <- gsc-frame tgt (build now) ang (sp.sp-sky) (sp.sp-fb) stride font (sp.sp-ch) (sp.sp-sh) (sp.sp-gpu) (sp.sp-gv)
            let ready = __record-set sp "sp-ready" (if sp.sp-gpu == 1 then 0 else 1)
            in gsc-completed sp stride font h
          end
        end
        let unhook = __record-set (sp.sp-tgt) "r3t-service" prior-service
        in let front-unhook = __record-set (sp.sp-front) "r3t-service" prior-front-service
        in let cu = if mouse.um-ok then cursor-update cs base stride h w h 1 (mouse-x mouse) (mouse-y mouse) else 0
        in 1
      end
    end
  end

  gsc-render-ready : ScenePane, Scene3DState, Integer -> Integer
  gsc-render-ready (sp) (scene) (angle) =
    let tgt = sp.sp-tgt
    in let aspect = gsc-aspect (tgt.r3t-w) (tgt.r3t-h)
    in let posed = scene3d-set-camera scene (gsc-camera angle aspect)
    in let clear = r3d-target-clear tgt (sp.sp-sky)
    in let draw = if sp.sp-sh == 1 then r3d-render-shadowed tgt posed gsc-shadow-map
      else r3d-render-into tgt posed
    in let ready = __record-set sp "sp-ready" 1
    in let at = __record-set sp "sp-present" 0
    in 0

  gsc-render-active : ScenePane -> Boolean
  gsc-render-active (sp) = when sp.sp-job
    is None -> False
    is Just (job) -> job.sj-phase > 0 & job.sj-phase < 9

  gsc-refused : ScenePane, Integer, GopAppFont -> Integer
  gsc-refused (sp) (stride) (font) =
    let failed = __record-set sp "sp-ready" (0 - 1)
    in gapp-ui-text-fit (sp.sp-fb) stride (sp.sp-ch) font (sp.sp-gv.gv-x + 8) (sp.sp-ch - gapp-ui-h font 1) (sp.sp-gv.gv-x + sp.sp-gv.gv-w - 8) "3D WORK REFUSED" 16711680 1

  gsc-render-quanta : Integer = 8

  gsc-render-unit : ScenePane -> Integer
  gsc-render-unit (sp) = gsc-render-units sp gsc-render-quanta

  gsc-render-units : ScenePane, Integer -> Integer
  gsc-render-units (sp) (remaining) = when sp.sp-job
    is None -> 0
    is Just (job) ->
      let phase = sj-step job
      in if phase < 0 then phase
      else if phase /= 9 then
        if remaining <= 1 then phase else gsc-render-units sp (remaining - 1)
      else let completed = sp.sp-tgt.r3t-base
      in let next = sp.sp-front.r3t-base
      in let front = __record-set (sp.sp-front) "r3t-base" completed
      in let back = __record-set (sp.sp-tgt) "r3t-base" next
      in let pixels = __record-set sp "sp-px" next
      in let ready = __record-set sp "sp-ready" 1
      in let at = __record-set sp "sp-present" 0
      in 0

  gsc-presentation-target : ScenePane -> R3dTriState
  gsc-presentation-target (sp) = when sp.sp-job
    is None -> sp.sp-tgt
    is Just (job) -> sp.sp-front

  gsc-completed : ScenePane, Integer, GopAppFont, Integer -> Integer
  gsc-completed (sp) (stride) (font) (rows) =
    let cancel = gsc-cancel sp
    in let count = __record-set sp "sp-n" (sp.sp-n + 1)
    in gsc-hud (sp.sp-fb) stride rows font (sp.sp-ch) (sp.sp-gv) (sp.sp-n) (sp.sp-t0)

  gsc-present-step : ScenePane, Integer, GopAppFont, Integer -> Integer
  gsc-present-step (sp) (stride) (font) (rows) =
    if sp.sp-ready /= 1 | stride /= sp.sp-stride then gsc-invalidate sp
    else let tgt = gsc-presentation-target sp
    in let gv = sp.sp-gv
    in let next = gsc-blit-unit (sp.sp-fb + gv.gv-x * 4) stride tgt (sp.sp-present)
    in if next < 0 then gsc-invalidate sp
    else if next < tgt.r3t-w * tgt.r3t-h then
      let at = __record-set sp "sp-present" next
      in 0
    else
      let x = gv.gv-x + 8
      in let y = sp.sp-ch - gapp-ui-h font 1
      in let right = gv.gv-x + gv.gv-w - 8
      in let label = gapp-ui-text-fit (sp.sp-fb) stride (sp.sp-ch) font x y right gsc-label-sw 65280 1
      in gsc-completed sp stride font rows

  gsc-show : Integer, GopAppFont, (Integer -> Scene3DState), ScenePane -> [Device.Port, Gpu.Compute, Gpu.Memory] Integer
  gsc-show (stride) (font) (build) (sp) = act
    let cancel = gsc-cancel sp
    in let tgt = gsc-presentation-target sp
    in let gv = sp.sp-gv
    in if sp.sp-gpu /= 1 & gsc-tgt-ok tgt & sp.sp-ready == 1 then
      let b = gsc-blit-rows (sp.sp-fb + gv.gv-x * 4) stride (tgt.r3t-base) (tgt.r3t-stride) (tgt.r3t-w) (tgt.r3t-h) 0
      in gapp-ui-text-fit (sp.sp-fb) stride (sp.sp-ch) font (gv.gv-x + 8) (sp.sp-ch - gapp-ui-h font 1) (gv.gv-x + gv.gv-w - 8) gsc-label-sw 65280 1
    else if gsc-owned sp & sp.sp-gpu /= 1 then 0
    else
      let mark = __heap-save
      in act
        now <- rtc-seconds 0
        mins <- rtc-read 2
        let ang = if sp.sp-look == 1 then sp.sp-yaw else gsc-orbit now mins
        in act
          f <- gsc-frame tgt (build now) ang (sp.sp-sky) (sp.sp-fb) stride font (sp.sp-ch) (sp.sp-sh) (sp.sp-gpu) gv
          let ready = __record-set sp "sp-ready" (if sp.sp-gpu == 1 then 0 else 1)
          in let d = __heap-restore mark
          in f
        end
      end
  end

  gsc-hud : Integer, Integer, Integer, GopAppFont, Integer, GpuView, Integer, Integer -> Integer
  gsc-hud (base) (stride) (rows) (font) (ch) (gv) (n) (t0) =
    let tps = hpet-ticks-per-second
    in let d = hpet-ticks - t0
    in let ms = if tps <= 0 then 0 else d * 1000 / tps
    in let t = if ms <= 0 then "f" & show n else "f" & show n & " " & show (ms / n) & "ms"
    in gapp-ui-text base stride rows font (gv.gv-x + gv.gv-w - gapp-ui-w font t 1 - 8) (ch - gapp-ui-h font 1) t 65280 1 0

  gsc-bcd : Integer -> Integer
  gsc-bcd (n) = (n / 16) * 10 + int-mod n 16

  gsc-orbit : Integer, Integer -> Integer
  gsc-orbit (now) (mins) =
    let started = hpet-start
    in let tps = hpet-ticks-per-second
    in let ticks = hpet-ticks
    in if tps <= 0 then gsc-angle now mins
    else if ticks <= 0 then gsc-angle now mins
    else int-mod (ticks * 105 / tps) gsc-turn

  gsc-label-band : Integer = 20

  gsc-sky : Integer = rgb-to-packed (rgb 20 20 30)

