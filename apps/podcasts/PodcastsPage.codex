 Podcast client with subscriptions, episode queue, and playback controls.

 We say:

Section: Theme

  podcasts-theme : Theme
  podcasts-theme =
    let p = Palette { pal-bg = 986895, pal-fg = #E1E1E1, pal-primary = 8913151, pal-secondary = 1447446, pal-accent = 8913151, pal-muted = #777777, pal-error = #EC4D30, pal-success = #41AF4E, pal-warning = #FF9900, pal-border = #1E1E2E }
    in let base = ws (p.pal-bg) (p.pal-fg) (bdr 0 0 CornerSharp) (eu 0) (eu 0)
    in let btn = ws (p.pal-secondary) (p.pal-fg) (bdr 0 0 (CornerRound 6)) (exy 12 8) (eu 0)
    in let lbl = ws 0 (p.pal-fg) bn ez (eu 0)
    in Theme { th-name = "podcasts-dark", th-palette = p, th-panel = ss-flat base, th-button = StateStyles { ss-normal = btn, ss-hover = btn, ss-pressed = btn, ss-disabled = btn, ss-focused = btn }, th-label = ss-flat lbl, th-input = ss-flat base, th-gauge = ss-flat base, th-separator = ss-flat base }

Section: CSS

  podcasts-css : Text
  podcasts-css =
    "*{margin:0;padding:0;box-sizing:border-box}body{background:#0f0f0f;color:#e1e1e1;font-family:system-ui,sans-serif;min-height:100vh}#app{display:contents}"
    & ".podcasts{display:grid;grid-template-columns:240px 1fr;grid-template-rows:1fr 72px;min-height:100vh}"
    & ".sidebar{background:#141414;border-right:1px solid #222;padding:16px 0;overflow-y:auto;grid-row:1/3}"
    & ".sidebar-hdr{font-size:20px;font-weight:700;padding:8px 20px 16px;color:#8800ff}"
    & ".nav-item{padding:10px 20px;cursor:pointer;font-size:13px;color:#999;transition:background .1s;display:flex;align-items:center;gap:10px}"
    & ".nav-item:hover{background:#1a1a1a;color:#ddd}"
    & ".nav-item.active{color:#8800ff}"
    & ".nav-sep{height:1px;background:#222;margin:8px 20px}"
    & ".sub-title{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:1px;padding:12px 20px 6px}"
    & ".show-item{padding:8px 20px;cursor:pointer;font-size:13px;color:#999;display:flex;align-items:center;gap:10px}"
    & ".show-item:hover{background:#1a1a1a;color:#ddd}"
    & ".show-item.subscribed{color:#ccc}"
    & ".show-art{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}"
    & ".main{overflow-y:auto;padding:24px}"
    & ".section-title{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}"
    & ".show-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px;margin-bottom:32px}"
    & ".show-card{cursor:pointer;transition:transform .15s}"
    & ".show-card:hover{transform:translateY(-4px)}"
    & ".show-cover{aspect-ratio:1;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:56px;margin-bottom:8px}"
    & ".show-name{font-size:14px;font-weight:600;margin-bottom:2px}"
    & ".show-author{font-size:12px;color:#666}"
    & ".episode-list{margin-top:8px}"
    & ".episode{padding:14px 0;border-bottom:1px solid #1a1a1a;display:grid;grid-template-columns:48px 1fr auto;gap:14px;align-items:center;cursor:pointer}"
    & ".episode:hover{background:#141414}"
    & ".episode.playing{background:#1a0a2a}"
    & ".ep-art{width:48px;height:48px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:24px}"
    & ".ep-title{font-size:14px;font-weight:600;margin-bottom:3px}"
    & ".ep-show{font-size:12px;color:#666;margin-bottom:4px}"
    & ".ep-desc{font-size:13px;color:#888;line-height:1.4}"
    & ".ep-meta{font-size:12px;color:#555;text-align:right;white-space:nowrap}"
    & ".ep-dl{font-size:11px;color:#8800ff;margin-top:4px}"
    & ".player{grid-column:2/3;background:#181818;border-top:1px solid #222;display:flex;align-items:center;padding:0 24px;gap:16px}"
    & ".player-art{width:48px;height:48px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:24px;background:#1a0a2a;flex-shrink:0}"
    & ".player-info{flex:1;min-width:0}"
    & ".player-title{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    & ".player-show{font-size:11px;color:#666}"
    & ".player-controls{display:flex;align-items:center;gap:16px}"
    & ".player-controls .wk-btn{background:none;border:none;color:#ccc;font-size:18px;cursor:pointer;padding:4px}"
    & ".player-play{background:#8800ff !important;color:#fff !important;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px}"
    & ".player-progress{flex:2;display:flex;align-items:center;gap:8px;min-width:200px}"
    & ".progress-bar{flex:1;height:4px;background:#333;border-radius:2px;position:relative}"
    & ".progress-fill{width:35%;height:100%;background:#8800ff;border-radius:2px}"
    & ".progress-time{font-size:11px;color:#666;min-width:40px}"
    & ".speed-btn{background:#222 !important;border:1px solid #444 !important;color:#ccc;font-size:11px;padding:2px 8px;border-radius:10px;cursor:pointer;white-space:nowrap}"
    & ".speed-btn:hover{background:#333 !important}"
    & ".show-detail{margin-bottom:24px;display:flex;gap:20px;align-items:flex-start}"
    & ".show-detail-cover{width:120px;height:120px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:64px;flex-shrink:0}"
    & ".show-detail-info{flex:1}"
    & ".show-detail-name{font-size:22px;font-weight:700;margin-bottom:4px}"
    & ".show-detail-author{font-size:14px;color:#888;margin-bottom:12px}"
    & ".sub-btn{background:#8800ff;color:#fff;border:none;padding:8px 20px;border-radius:20px;font-size:13px;cursor:pointer}"
    & ".sub-btn.subscribed{background:#333;color:#999}"
    & ".search-view{text-align:center;padding:60px 20px;color:#666}"
    & ".search-view-title{font-size:18px;margin-bottom:8px;color:#999}"

Section: Data

  show-name : Integer -> Text
  show-name (n) =
    if n == 0 then "Syntax" else if n == 1 then "99% Invisible"
    else if n == 2 then "Radiolab" else if n == 3 then "The Daily"
    else if n == 4 then "Science Friday" else if n == 5 then "Song Exploder"
    else if n == 6 then "Corecursive" else "Darknet Diaries"

  show-icon : Integer -> Text
  show-icon (n) =
    if n == 0 then "&#x1F4BB;" else if n == 1 then "&#x1F3D7;"
    else if n == 2 then "&#x1F4E1;" else if n == 3 then "&#x1F4F0;"
    else if n == 4 then "&#x1F52D;" else if n == 5 then "&#x1F3A7;"
    else if n == 6 then "&#x1F504;" else "&#x1F574;"

  show-bg : Integer -> Text
  show-bg (n) =
    if n == 0 then "#1a0a2a" else if n == 1 then "#0a1a2a"
    else if n == 2 then "#1a2a0a" else if n == 3 then "#2a1a0a"
    else if n == 4 then "#0a2a2a" else if n == 5 then "#2a0a1a"
    else if n == 6 then "#0a0a2a" else "#2a0a0a"

  show-author : Integer -> Text
  show-author (n) =
    if n == 0 then "Wes Bos & Scott Tolinski" else if n == 1 then "Roman Mars"
    else if n == 2 then "Lulu Miller" else if n == 3 then "The New York Times"
    else if n == 4 then "Ira Flatow" else if n == 5 then "Hrishikesh Hirway"
    else if n == 6 then "Adam Gordon Bell" else "Jack Rhysider"

  show-ep-count : Integer -> Integer
  show-ep-count (n) =
    if n == 0 then 3 else if n == 1 then 3 else if n == 2 then 3
    else if n == 3 then 3 else if n == 4 then 2 else if n == 5 then 2
    else if n == 6 then 2 else 2

  ep-title-for : Integer, Integer -> Text
  ep-title-for (s) (e) =
    if s == 0 then (if e == 0 then "Deno 2.0 Deep Dive" else if e == 1 then "CSS Container Queries" else "TypeScript 6 Preview")
    else if s == 1 then (if e == 0 then "The Smell of Old Books" else if e == 1 then "The Post Office You Love" else "Lawn Order")
    else if s == 2 then (if e == 0 then "The Gondola Diaries" else if e == 1 then "Cellmates" else "Unraveling")
    else if s == 3 then (if e == 0 then "The Trade Talks" else if e == 1 then "A Shifting Court" else "The Search")
    else if s == 4 then (if e == 0 then "The Coral Reef Revival" else "Dark Skies Return")
    else if s == 5 then (if e == 0 then "Beyonce: Texas Hold Em" else "Billie Eilish: Birds")
    else if s == 6 then (if e == 0 then "The Birth of Erlang" else "LLMs From Scratch")
    else if e == 0 then "The Lazarus Heist" else "Jackpot"

  ep-desc-for : Integer, Integer -> Text
  ep-desc-for (s) (e) =
    if s == 0 then (if e == 0 then "New features in Deno 2.0 for web developers" else if e == 1 then "Deep dive into container queries and responsive components" else "What is coming in the next major TypeScript release")
    else if s == 1 then (if e == 0 then "Why old books smell and the chemistry behind it" else if e == 1 then "The most beloved post office in America" else "The hidden design of suburban lawns")
    else if s == 2 then (if e == 0 then "Venetian gondolas and modern physics" else if e == 1 then "Unlikely friendships forged in cells" else "A thread that connects everything")
    else if s == 3 then (if e == 0 then "Latest trade negotiations and global economy" else if e == 1 then "The Supreme Court faces a new era" else "Inside the nationwide manhunt")
    else if s == 4 then (if e == 0 then "Restoring coral reefs with 3D-printed limestone" else "Astronomers fight to save the night sky")
    else if s == 5 then (if e == 0 then "Breaking down the genre-bending hit" else "The making of a haunting single")
    else if s == 6 then (if e == 0 then "Joe Armstrong on creating a language" else "Building language models from first principles")
    else if e == 0 then "North Korea's billion dollar bank heist" else "How a hacker won the lottery four times"

  ep-duration : Integer -> Integer
  ep-duration (n) =
    if n == 0 then 2530 else if n == 1 then 1680 else if n == 2 then 3300
    else if n == 3 then 1500 else if n == 4 then 2100 else if n == 5 then 2280
    else if n == 6 then 3060 else 1920

  ep-date-for : Integer -> Text
  ep-date-for (n) =
    if n == 0 then "Today" else if n == 1 then "Today" else if n == 2 then "Yesterday"
    else if n == 3 then "Yesterday" else if n == 4 then "2 days ago" else if n == 5 then "2 days ago"
    else if n == 6 then "3 days ago" else "3 days ago"

  format-time : Integer -> Text
  format-time (secs) =
    let m = secs / 60
    in let s = secs - m * 60
    in if s < 10 then show m & ":0" & show s else show m & ":" & show s

  speed-label : Integer -> Text
  speed-label (n) =
    if n == 0 then "1x" else if n == 1 then "1.25x" else if n == 2 then "1.5x" else if n == 3 then "2x" else "0.5x"

  count-subscriptions : Integer, Integer -> Integer
  count-subscriptions (i) (acc) =
    if i >= 8 then acc
    else let v = state-get ("sub-" & show i)
    in count-subscriptions (i + 1) (acc + v)

  count-downloads : Integer, Integer -> Integer
  count-downloads (i) (acc) =
    if i >= 8 then acc
    else let v = state-get ("dl-" & show i)
    in count-downloads (i + 1) (acc + v)

  ep-progress-pct : Integer -> Integer
  ep-progress-pct (idx) =
    let pos = state-get ("ep-pos-" & show idx)
    in let dur = ep-duration idx
    in if dur == 0 then 0 else pos * 100 / dur

Section: Tree

  page-tree : Integer -> WidgetNode
  page-tree (x) =
    widget-box "podcasts" "podcasts" [
      sidebar-tree 0,
      main-area 0,
      player-bar 0
    ]

  sidebar-tree : Integer -> WidgetNode
  sidebar-tree (x) =
    let sel = state-get "selected-show"
    in let sa = state-get "search-active"
    in widget-box "sidebar" "sidebar" [
      widget-label "brand" "CodexPodcasts",
      widget-box-click "nav-now" (if sa == 0 then if state-get "nav-view" == 0 then "nav-item active" else "nav-item" else "nav-item") [widget-label "nav-now-l" "&#x25B6; Listen Now"],
      widget-box-click "nav-queue" (if state-get "nav-view" == 1 then "nav-item active" else "nav-item") [widget-label "nav-queue-l" "&#x1F4CB; Up Next"],
      widget-box-click "nav-lib" (if state-get "nav-view" == 2 then "nav-item active" else "nav-item") [widget-label "nav-lib-l" "&#x1F4DA; Library"],
      widget-box-click "nav-search" (if sa == 1 then "nav-item active" else "nav-item") [widget-label "nav-search-l" "&#x1F50D; Search"],
      widget-label "sep" "",
      widget-label "sub-count" (show (count-subscriptions 0 0) & " subscribed"),
      widget-label "sub-hdr" "Subscriptions",
      sidebar-show 0 sel,
      sidebar-show 1 sel,
      sidebar-show 2 sel,
      sidebar-show 3 sel,
      sidebar-show 4 sel,
      sidebar-show 5 sel,
      sidebar-show 6 sel,
      sidebar-show 7 sel
    ]

  sidebar-show : Integer, Integer -> WidgetNode
  sidebar-show (idx) (sel) =
    let sub = state-get ("sub-" & show idx)
    in let cls = if idx == sel then "show-item active" else if sub == 1 then "show-item subscribed" else "show-item"
    in widget-box-click ("ss-" & show idx) cls [
      widget-label ("ss-" & show idx & "i") (show-icon idx),
      widget-label ("ss-" & show idx & "n") (show-name idx)
    ]

  queue-view : Integer -> WidgetNode
  queue-view (x) =
    widget-box "main" "main" [
      widget-label "queue-hdr" "Up Next",
      widget-label "queue-msg" "Your queued episodes will appear here."
    ]

  library-view : Integer -> WidgetNode
  library-view (x) =
    widget-box "main" "main" [
      widget-label "lib-hdr" "Library",
      widget-label "lib-msg" "All downloaded and saved episodes."
    ]

  main-area : Integer -> WidgetNode
  main-area (x) =
    let sa = state-get "search-active"
    in if sa == 1 then search-view 0
    else let nv = state-get "nav-view"
    in if nv == 1 then queue-view 0
    else if nv == 2 then library-view 0
    else let sel = state-get "selected-show"
    in if sel >= 0 then show-detail-view sel
    else browse-view 0

  browse-view : Integer -> WidgetNode
  browse-view (x) =
    widget-box "main" "main" [
      widget-label "sec-shows" "Your Shows",
      show-grid 0,
      widget-label "sec-recent" "Recent Episodes",
      all-episode-list 0
    ]

  search-view : Integer -> WidgetNode
  search-view (x) =
    widget-box "main" "main" [
      widget-box "search-box" "search-view" [
        widget-label "search-title" "Search Podcasts",
        widget-label "search-hint" "Browse shows from the sidebar or click Listen Now to return"
      ]
    ]

  show-detail-view : Integer -> WidgetNode
  show-detail-view (idx) =
    let sub = state-get ("sub-" & show idx)
    in let ep-cnt = show-ep-count idx
    in let expanded = state-get "expanded-ep"
    in widget-box "main" "main" [
      widget-box "sd-hdr" "show-detail" [
        widget-label "sd-cover" (show-icon idx),
        widget-box "sd-info" "show-detail-info" [
          widget-label "sd-name" (show-name idx),
          widget-label "sd-author" (show-author idx),
          widget-label "sd-ep-count" (show ep-cnt & " episodes"),
          widget-button "sd-sub" (if sub == 1 then "Subscribed &#x2713;" else "Subscribe")
        ]
      ],
      widget-label "sec-eps" "Episodes",
      show-episode-list idx 0
    ]

  show-grid : Integer -> WidgetNode
  show-grid (x) =
    widget-box "shows" "show-grid" [
      show-card-at 0,
      show-card-at 1,
      show-card-at 2,
      show-card-at 3,
      show-card-at 4,
      show-card-at 5,
      show-card-at 6,
      show-card-at 7
    ]

  show-card-at : Integer -> WidgetNode
  show-card-at (idx) =
    widget-box-click ("sc" & show idx) "show-card" [
      widget-label ("sc" & show idx & "c") (show-icon idx),
      widget-label ("sc" & show idx & "n") (show-name idx),
      widget-label ("sc" & show idx & "a") (show-author idx)
    ]

  all-episode-list : Integer -> WidgetNode
  all-episode-list (x) =
    widget-box "episodes" "episode-list" [
      ep-row 0 0 0,
      ep-row 1 1 0,
      ep-row 2 2 0,
      ep-row 3 3 0,
      ep-row 4 0 1,
      ep-row 5 1 1,
      ep-row 6 4 0,
      ep-row 7 5 0
    ]

  show-episode-list : Integer, Integer -> WidgetNode
  show-episode-list (s) (x) =
    let cnt = show-ep-count s
    in if cnt >= 3 then widget-box "episodes" "episode-list" [
      ep-row-show s 0,
      ep-row-show s 1,
      ep-row-show s 2
    ]
    else widget-box "episodes" "episode-list" [
      ep-row-show s 0,
      ep-row-show s 1
    ]

  ep-row : Integer, Integer, Integer -> WidgetNode
  ep-row (idx) (s) (e) =
    let cur = state-get "now-playing-episode"
    in let dl = state-get ("dl-" & show idx)
    in let dl-prog = state-get ("dl-prog-" & show idx)
    in let pos = state-get ("ep-pos-" & show idx)
    in let expanded = state-get "expanded-ep"
    in let cls = if cur == idx then "episode playing" else "episode"
    in let dur = ep-duration idx
    in let prog-text = if pos > 0 then format-time pos & " / " & format-time dur else show (dur / 60) & " min"
    in let dl-text = if dl == 1 then "&#x2713; Downloaded" else if dl-prog > 0 then "&#x2B07; " & show dl-prog & "%" else "&#x2B07; Download"
    in widget-box-click ("ep" & show idx) cls [
      widget-label ("ep" & show idx & "art") (show-icon s),
      widget-box ("ep" & show idx & "info") "" [
        widget-label ("ep" & show idx & "t") (ep-title-for s e),
        widget-label ("ep" & show idx & "s") (show-name s),
        if expanded == idx then widget-label ("ep" & show idx & "d") (ep-desc-for s e) else widget-label ("ep" & show idx & "d") "",
        widget-button ("ep" & show idx & "expand") (if expanded == idx then "Collapse" else "Show Notes")
      ],
      widget-box ("ep" & show idx & "meta") "ep-meta" [
        widget-label ("ep" & show idx & "m") prog-text,
        widget-label ("ep" & show idx & "dt") (ep-date-for idx),
        widget-label ("ep" & show idx & "dl") dl-text
      ]
    ]

  ep-row-show : Integer, Integer -> WidgetNode
  ep-row-show (s) (e) =
    let eid = s * 10 + e
    in let cur = state-get "now-playing-episode"
    in let dl = state-get ("dl-" & show eid)
    in let cls = if cur == eid then "episode playing" else "episode"
    in widget-box-click ("ep" & show eid) cls [
      widget-label ("ep" & show eid & "art") (show-icon s),
      widget-box ("ep" & show eid & "info") "" [
        widget-label ("ep" & show eid & "t") (ep-title-for s e),
        widget-label ("ep" & show eid & "s") (show-name s),
        widget-label ("ep" & show eid & "d") (ep-desc-for s e)
      ],
      widget-box ("ep" & show eid & "meta") "ep-meta" [
        widget-label ("ep" & show eid & "m") (show (ep-duration eid / 60) & " min"),
        widget-label ("ep" & show eid & "dt") (ep-date-for e),
        widget-label ("ep" & show eid & "dl") (if dl == 1 then "&#x2713; Downloaded" else "&#x2B07; Download")
      ]
    ]

  player-bar : Integer -> WidgetNode
  player-bar (x) =
    let cur = state-get "now-playing-episode"
    in let played = state-get "played-seconds"
    in let total = ep-duration cur
    in let spd = state-get "speed"
    in let pct = if total == 0 then 0 else played * 100 / total
    in widget-box "player" "player" [
      widget-label "pl-art" (show-icon cur),
      widget-box "pl-info" "player-info" [
        widget-label "pl-title" (ep-title-for (cur / 10) (cur - cur / 10 * 10)),
        widget-label "pl-show" (show-name (cur / 10))
      ],
      widget-box "pl-ctrl" "player-controls" [
        widget-button "pl-back" "&#x23EA;",
        widget-button "pl-play" (if state-get "playing" == 1 then "&#x23F8;" else "&#x25B6;"),
        widget-button "pl-fwd" "&#x23E9;"
      ],
      widget-box "pl-prog" "player-progress" [
        widget-label "pl-cur" (format-time played),
        widget-box "pl-bar" "progress-bar" [
          widget-label "pl-fill" ""
        ],
        widget-label "pl-tot" (format-time total),
        widget-label "pl-pct" (show pct & "%")
      ],
      widget-button "pl-speed" (speed-label spd),
      widget-label "pl-dl-total" (show (count-downloads 0 0) & " downloaded")
    ]

Section: Handlers

  podcasts-click : Text -> Integer
  podcasts-click (id) =
    if id == "pl-play" then
      let s = state-set-render "playing" (if state-get "playing" == 1 then 0 else 1) in 0
    else if id == "pl-fwd" then
      let cur = state-get "now-playing-episode"
      in let nx = if cur >= 7 then 0 else cur + 1
      in let s = state-set "playing" 1
      in let s2 = state-set "played-seconds" 0
      in let s3 = state-set-render "now-playing-episode" nx in 0
    else if id == "pl-back" then
      let cur = state-get "now-playing-episode"
      in let pv = if cur <= 0 then 7 else cur - 1
      in let s = state-set "playing" 1
      in let s2 = state-set "played-seconds" 0
      in let s3 = state-set-render "now-playing-episode" pv in 0
    else if id == "pl-speed" then
      let spd = state-get "speed"
      in let nx = if spd >= 4 then 0 else spd + 1
      in let s = state-set-render "speed" nx in 0
    else if id == "sd-sub" then
      let sel = state-get "selected-show"
      in let cur = state-get ("sub-" & show sel)
      in let s = state-set-render ("sub-" & show sel) (if cur == 1 then 0 else 1) in 0
    else if id == "nav-now" then
      let s = state-set "search-active" 0
      in let s2 = state-set "nav-view" 0
      in let s3 = state-set-render "selected-show" ((-1)) in 0
    else if id == "nav-search" then
      let s = state-set "selected-show" ((-1))
      in let s2 = state-set-render "search-active" 1 in 0
    else if id == "nav-queue" then
      let s = state-set "search-active" 0
      in let s2 = state-set "selected-show" ((-1))
      in let s3 = state-set-render "nav-view" 1 in 0
    else if id == "nav-lib" then
      let s = state-set "search-active" 0
      in let s2 = state-set "selected-show" ((-1))
      in let s3 = state-set-render "nav-view" 2 in 0
    else if text-starts-with id "sc" then
      let idx = id-num id
      in let s = state-set "search-active" 0
      in let s2 = state-set-render "selected-show" idx in 0
    else if text-starts-with id "ss-" then
      let idx = id-num id
      in let s = state-set "search-active" 0
      in let s2 = state-set-render "selected-show" idx in 0
    else if text-starts-with id "ep" then
      let n = id-num id
      in if text-starts-with id "ep" then
        let dl-key = "dl-" & show n
        in let suffix = substring id (text-length "ep" + text-length (show n)) (text-length id)
        in if text-starts-with suffix "dl" then
          let cur = state-get dl-key
          in if cur == 1 then let s = state-set-render dl-key 0 in 0
          else let s1 = state-set ("dl-prog-" & show n) 75
          in let s2 = state-set-render dl-key 1 in 0
        else if text-starts-with suffix "expand" then
          let exp = state-get "expanded-ep"
          in if exp == n then let s = state-set-render "expanded-ep" ((-1)) in 0
          else let s = state-set-render "expanded-ep" n in 0
        else
          let s = state-set "playing" 1
          in let s2 = state-set "played-seconds" 0
          in let s3 = state-set ("ep-pos-" & show n) 0
          in let s4 = state-set-render "now-playing-episode" n in 0
      else 0
    else 0

