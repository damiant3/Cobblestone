Chapter: BrowserRemoteProbe
  cites Browser chapter PageRuntime
  cites Browser chapter PageSandbox
  cites Browser chapter TrustManager
  cites Browser chapter ContentCache
  cites Foreword chapter Console

Section: Probe

  res-code : PageLoadResult -> Integer
  res-code (r) =
    when r
      is PageLoaded (tree) (title) (caps) -> 1
      is PageCompileError (m) -> 2
      is PageFetchError (m) -> 3
      is PageTrustDenied (t) -> 4
      is PageSizeDenied (s) -> 5

  res-title : PageLoadResult -> Text
  res-title (r) =
    when r
      is PageLoaded (tree) (title) (caps) -> title
      is PageCompileError (m) -> m
      is PageFetchError (m) -> m
      is PageTrustDenied (t) -> "trust"
      is PageSizeDenied (s) -> "size"

  probe : Text -> [Network.Read, Network.Write] PageLoadResult
  probe (addr) =
    resolve-and-load-remote addr sandbox-default-config (trust-store-new []) (cache-new 64) 800 600

  report : Text, Text -> [Console, Network.Read, Network.Write] Nothing
  report (name) (addr) = act
    r <- probe addr
    print-line-uni ("remote " & name & " code=" & integer-to-text (res-code r) & " title=" & res-title r)
  end

  opening : [Console, Network.Read, Network.Write] Nothing = act
    report "hello" "codex://pages.test/hello"
    report "body-publisher" "codex://pages.test/body-publisher"
    report "header-publisher" "codex://pages.test/header-publisher"
    report "missing" "codex://pages.test/missing"
    print-line-uni "remote done"
  end
