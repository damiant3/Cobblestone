 Prints TZDB.BIN for the vendored release as hex, 1024 bytes a line, then
 "end"; build/tz-db.ps1 turns it into the file.

Section: Body

  hex-digit : Integer -> Text
  hex-digit (n) = substring "0123456789abcdef" n 1

  hex-range : List Integer, Integer, Integer -> Text
  hex-range (bs) (i) (stop) =
    if i >= stop then ""
    else hex-digit (bit-shr (list-at bs i) 4) & hex-digit (bit-and (list-at bs i) 15) & hex-range bs (i + 1) stop

  print-from : List Integer, Integer -> [Console] Nothing
  print-from (bs) (i) =
    if i >= list-length bs then print-line-uni "end"
    else act
      print-line-uni (hex-range bs i (if i + 1024 < list-length bs then i + 1024 else list-length bs))
      print-from bs (i + 1024)
    end

  opening : [Console] Nothing =
    let db = tz-parse tz-sources
    in print-from (tz-db-build db) 0