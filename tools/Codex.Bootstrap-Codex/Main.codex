Chapter: Main
  cites Codex chapter Characters
  cites Codex chapter Console
  cites Codex chapter Files
  cites Codex chapter Lists
  cites Codex chapter Process
  cites Codex chapter Text

 Codex-side reimplementation of tools/Codex.Bootstrap. Supports the bench
 family today: bench prints medians, bench-save writes medians to
 bench-baseline.json, bench-check reads that baseline and compares. All
 three shell out to `codex build` with --emit-phase-timings via
 run-process-full and parse PHASE lines from stderr. Other C# Bootstrap
 modes follow in later CLs.

Section: Constants

  default-codex-dir : Text = "Codex.Codex"

  default-cli-exe : Text = "tools/Codex.Cli/bin/Debug/net8.0/Codex.Cli.exe"

  default-baseline-path : Text = "tools/Codex.Bootstrap-Codex/bench-baseline.json"

  default-binary-out-dir : Text = "build-output/bare-metal"

  default-codex-emit-out-dir : Text = "build-output/bootstrap"

 Default regression gate for --bench-check. Interpreted as whole percent
 against the total median. Written into bench-baseline.json by --bench-save
 and re-read by --bench-check so the gate can be tuned per-project without
 rebuilding the exe.
  default-threshold-percent : Integer = 10

  warmup-runs : Integer = 3

  measured-runs : Integer = 10

  phase-names : List Text =
    ["parse", "desugar", "scope", "resolve", "check", "lower", "emit"]

Section: Types

  Phase = record { name : Text, hundredths : Integer }

Section: Parsing

 Parse "NN.NN" into hundredths-of-a-millisecond. Matches the %F2 format the
 Codex.Cli PhaseTimer emits, so we can reconstruct the printed precision
 without relying on a Double type. "21.19" -> 2119; "7" -> 700.
  parse-hundredths : Text -> Integer
  parse-hundredths (s) =
    let parts = text-split s "."
    in if list-length parts >= 2 then
         text-to-integer (list-at parts 0) * 100 + text-to-integer (list-at parts 1)
       else
         text-to-integer s * 100

 Parse one stderr line into a Phase. Non-PHASE lines come back with an
 empty name so the caller can drop them.
  parse-phase-line : Text -> Phase
  parse-phase-line (line) =
    if text-starts-with line "PHASE " then
      let rest = substring line 6 (text-length line - 6)
      in let parts = text-split rest " "
      in if list-length parts == 2 then
           Phase { name = list-at parts 0, hundredths = parse-hundredths (list-at parts 1) }
         else
           Phase { name = "", hundredths = 0 }
    else
      Phase { name = "", hundredths = 0 }

  collect-phases : List Text -> Integer -> Integer -> List Phase -> List Phase
  collect-phases (lines) (i) (n) (acc) =
    if i >= n then acc
    else let p = parse-phase-line (list-at lines i)
    in if p.name == "" then collect-phases lines (i + 1) n acc
    else collect-phases lines (i + 1) n (list-snoc acc p)

  parse-stderr : Text -> List Phase
  parse-stderr (stderr) =
    let lines = text-split stderr "\n"
    in collect-phases lines 0 (list-length lines) []

  find-phase : List Phase -> Text -> Integer -> Integer -> Integer
  find-phase (phases) (name) (i) (n) =
    if i >= n then 0
    else let p = list-at phases i
    in if p.name == name then p.hundredths
    else find-phase phases name (i + 1) n

Section: Stats

 Selection sort ascending. O(n^2) is fine for n=10.
  min-index : List Integer -> Integer -> Integer -> Integer -> Integer
  min-index (xs) (i) (n) (best) =
    if i >= n then best
    else if list-at xs i < list-at xs best then min-index xs (i + 1) n i
    else min-index xs (i + 1) n best

  sort-step : List Integer -> Integer -> Integer -> List Integer
  sort-step (xs) (start) (n) =
    if start >= n then xs
    else let mi = min-index xs start n start
    in if mi == start then sort-step xs (start + 1) n
    else let tmp = list-at xs start
      in let xs1 = list-set-at xs start (list-at xs mi)
      in let xs2 = list-set-at xs1 mi tmp
      in sort-step xs2 (start + 1) n

  sort-ints : List Integer -> List Integer
  sort-ints (xs) = sort-step xs 0 (list-length xs)

  median : List Integer -> Integer
  median (xs) =
    let sorted = sort-ints xs
    in list-at sorted (list-length sorted / 2)

Section: Formatting

 Hundredths-of-ms to "NN.NN". Pad the fractional part to two digits so the
 output visually aligns with the C# "F2" format.
  show-ms : Integer -> Text
  show-ms (h) =
    let whole = h / 100
    in let frac = h - whole * 100
    in let frac-s = if frac < 10 then "0" ++ integer-to-text frac else integer-to-text frac
    in integer-to-text whole ++ "." ++ frac-s

  pad-right : Text -> Integer -> Text
  pad-right (s) (w) =
    if text-length s >= w then s
    else pad-right (s ++ " ") w

  pad-left : Text -> Integer -> Text
  pad-left (s) (w) =
    if text-length s >= w then s
    else pad-left (" " ++ s) w

Section: Run

 One compile through `codex build --emit-phase-timings`. The CLI writes
 PHASE lines to stderr, which we split into a list of Phase records.
  run-once : Text -> Text -> [Process] List Phase
  run-once (cli) (codex-dir) =
    let cmd-args = "build " ++ codex-dir ++ " --emit-phase-timings"
    in act
      r <- run-process-full cli cmd-args
      parse-stderr (r.stderr)
    end

 Gather one named phase's hundredths across every run into a flat list.
  gather : List (List Phase) -> Text -> Integer -> Integer -> List Integer -> List Integer
  gather (runs) (name) (i) (n) (acc) =
    if i >= n then acc
    else let ph = list-at runs i
      in let v = find-phase ph name 0 (list-length ph)
      in gather runs name (i + 1) n (list-snoc acc v)

Section: Bench

  warmup-loop : Text -> Text -> Integer -> Integer -> [Console, Process] Nothing
  warmup-loop (cli) (codex-dir) (i) (n) =
    if i >= n then print-line ("  warmup done (" ++ integer-to-text n ++ " iterations)")
    else act
      _ <- run-once cli codex-dir
      print-line ("  warmup " ++ integer-to-text (i + 1) ++ "/" ++ integer-to-text n)
      warmup-loop cli codex-dir (i + 1) n
    end

  measured-loop : Text -> Text -> Integer -> Integer -> List (List Phase) -> [Console, Process] List (List Phase)
  measured-loop (cli) (codex-dir) (i) (n) (acc) =
    if i >= n then act
      print-line ("  measured done (" ++ integer-to-text n ++ " iterations)")
      acc
    end
    else act
      phases <- run-once cli codex-dir
      print-line ("  run " ++ integer-to-text (i + 1) ++ "/" ++ integer-to-text n)
      measured-loop cli codex-dir (i + 1) n (list-snoc acc phases)
    end

 Shared across --bench, --bench-save, --bench-check. Prints the banner,
 runs warmup + measured, returns the list of runs. Callers decide how to
 report (stdout table / JSON / delta vs baseline).
  collect-runs : Text -> Text -> [Console, Process] List (List Phase)
  collect-runs (cli) (codex-dir) = act
    print-line ("Benchmark: " ++ codex-dir)
    print-line ("CLI:       " ++ cli)
    print-line ("Protocol:  " ++ integer-to-text warmup-runs ++ " warmup + " ++ integer-to-text measured-runs ++ " measured, median reported")
    print-line ""
    warmup-loop cli codex-dir 0 warmup-runs
    runs <- measured-loop cli codex-dir 0 measured-runs []
    print-line ""
    runs
  end

 Walk phase-names in order and compute each stage's median hundredths.
 Position i of the result aligns with position i of phase-names, so the
 two lists zip without extra bookkeeping downstream.
  all-medians-loop : List (List Phase) -> List Text -> Integer -> Integer -> List Integer -> List Integer
  all-medians-loop (runs) (names) (i) (n) (acc) =
    if i >= n then acc
    else let name = list-at names i
    in let hs = gather runs name 0 (list-length runs) []
    in let m = median hs
    in all-medians-loop runs names (i + 1) n (list-snoc acc m)

  all-medians : List (List Phase) -> List Integer
  all-medians (runs) =
    all-medians-loop runs phase-names 0 (list-length phase-names) []

  list-sum-loop : List Integer -> Integer -> Integer -> Integer -> Integer
  list-sum-loop (xs) (i) (n) (acc) =
    if i >= n then acc
    else list-sum-loop xs (i + 1) n (acc + list-at xs i)

  total-of : List Integer -> Integer
  total-of (xs) = list-sum-loop xs 0 (list-length xs) 0

  print-medians-loop : List Integer -> List Text -> Integer -> Integer -> [Console] Nothing
  print-medians-loop (medians) (names) (i) (n) =
    if i >= n then print-line "  ----------------------"
    else act
      print-line ("  " ++ pad-right (list-at names i) 10 ++ " " ++ pad-left (show-ms (list-at medians i)) 8 ++ " ms")
      print-medians-loop medians names (i + 1) n
    end

  print-bench-report : List Integer -> [Console] Nothing
  print-bench-report (medians) = act
    print-line "Per-stage (median ms):"
    print-medians-loop medians phase-names 0 (list-length phase-names)
    print-line ("  " ++ pad-right "total" 10 ++ " " ++ pad-left (show-ms (total-of medians)) 8 ++ " ms")
  end

  bench : Text -> Text -> [Console, Process] Nothing
  bench (cli) (codex-dir) = act
    runs <- collect-runs cli codex-dir
    print-bench-report (all-medians runs)
  end

Section: JSON

 Find the substring '"key":' in the baseline JSON, then consume whitespace
 and read the numeric token that follows into parse-hundredths. Returns 0
 if the key is missing. Good enough for a flat one-level baseline --
 thresholdPercent and medianMs read the same way.
  skip-ws-loop : Text -> Integer -> Integer -> Integer
  skip-ws-loop (s) (i) (n) =
    if i >= n then i
    else if is-whitespace (char-at s i) then skip-ws-loop s (i + 1) n
    else i

  scan-num-end-loop : Text -> Integer -> Integer -> Integer
  scan-num-end-loop (s) (i) (n) =
    if i >= n then i
    else let c = char-at s i
    in if is-digit c | c == '.' | c == '-' then scan-num-end-loop s (i + 1) n
    else i

  extract-leading-number : Text -> Integer
  extract-leading-number (s) =
    let n = text-length s
    in let start = skip-ws-loop s 0 n
    in let stop = scan-num-end-loop s start n
    in if stop <= start then 0
    else parse-hundredths (substring s start (stop - start))

  parse-json-number-at-key : Text -> Text -> Integer
  parse-json-number-at-key (json) (key) =
    let delim = "\"" ++ key ++ "\":"
    in let parts = text-split json delim
    in if list-length parts < 2 then 0
    else extract-leading-number (list-at parts 1)

 Build the baseline document. Stage order follows phase-names so readers
 can zip positionally; total is redundant with the sum but kept explicit
 so human readers don't have to add seven numbers.
  format-stages-loop : List Integer -> List Text -> Integer -> Integer -> Text -> Text
  format-stages-loop (vals) (names) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i + 1 < n then "," else ""
    in let entry = "    \"" ++ list-at names i ++ "\": " ++ show-ms (list-at vals i) ++ sep ++ "\n"
    in format-stages-loop vals names (i + 1) n (acc ++ entry)

  format-bench-json : List Integer -> Text -> Text
  format-bench-json (medians) (commit) =
    "{\n"
    ++ "  \"commit\": \"" ++ commit ++ "\",\n"
    ++ "  \"medianMs\": " ++ show-ms (total-of medians) ++ ",\n"
    ++ "  \"thresholdPercent\": " ++ integer-to-text default-threshold-percent ++ ",\n"
    ++ "  \"stages\": {\n"
    ++ format-stages-loop medians phase-names 0 (list-length phase-names) ""
    ++ "  }\n"
    ++ "}\n"

Section: BenchSave

 Strip a single trailing LF if present. `git rev-parse --short HEAD` always
 ends with one; we want the bare hash in the JSON.
  trim-trailing-newline : Text -> Text
  trim-trailing-newline (s) =
    let n = text-length s
    in if n == 0 then s
    else if char-at s (n - 1) == '\n' then substring s 0 (n - 1)
    else s

  get-git-commit : [Process] Text
  get-git-commit = act
    r <- run-process-full "git" "rev-parse --short HEAD"
    if r.exit-code == 0 then trim-trailing-newline (r.stdout) else "unknown"
  end

  bench-save : Text -> Text -> Text -> [Console, FileSystem, Process] Nothing
  bench-save (cli) (codex-dir) (baseline-path) = act
    runs <- collect-runs cli codex-dir
    let medians = all-medians runs
    in act
      print-bench-report medians
      commit <- get-git-commit
      let json = format-bench-json medians commit
      in act
        write-file baseline-path json
        print-line ""
        print-line ("Saved baseline to: " ++ baseline-path)
        print-line ("  total: " ++ show-ms (total-of medians) ++ " ms   commit: " ++ commit)
      end
    end
  end

Section: BenchCheck

 Render a hundredths-of-percent delta. +520 -> "+5.20%", -85 -> "-0.85%".
 Zero baseline short-circuits to "n/a" since the comparison would divide
 by zero -- happens when a stage is missing from the baseline file.
  format-delta-pct : Integer -> Integer -> Text
  format-delta-pct (baseline) (current) =
    if baseline == 0 then "n/a"
    else let delta-pct = (current - baseline) * 10000 / baseline
    in if delta-pct < 0 then "-" ++ show-ms (0 - delta-pct) ++ "%"
    else "+" ++ show-ms delta-pct ++ "%"

  compare-row : Text -> Integer -> Integer -> [Console] Nothing
  compare-row (label) (baseline) (current) =
    print-line ("  " ++ pad-right label 10
              ++ " " ++ pad-left (show-ms baseline) 8 ++ " ms"
              ++ " " ++ pad-left (show-ms current) 8 ++ " ms"
              ++ " " ++ pad-left (format-delta-pct baseline current) 9)

  compare-rows-loop : List Integer -> List Integer -> List Text -> Integer -> Integer -> [Console] Nothing
  compare-rows-loop (baselines) (currents) (names) (i) (n) =
    if i >= n then print-line "  -------------------------------------------------"
    else act
      compare-row (list-at names i) (list-at baselines i) (list-at currents i)
      compare-rows-loop baselines currents names (i + 1) n
    end

  collect-baseline-stages-loop : Text -> List Text -> Integer -> Integer -> List Integer -> List Integer
  collect-baseline-stages-loop (json) (names) (i) (n) (acc) =
    if i >= n then acc
    else let v = parse-json-number-at-key json (list-at names i)
    in collect-baseline-stages-loop json names (i + 1) n (list-snoc acc v)

  collect-baseline-stages : Text -> List Integer
  collect-baseline-stages (json) =
    collect-baseline-stages-loop json phase-names 0 (list-length phase-names) []

 Prints REGRESSION or OK. Exit-code plumbing is a follow-up -- when
 Codex gains an exit builtin, CI should match on the REGRESSION line
 until then.
  bench-check : Text -> Text -> Text -> [Console, FileSystem, Process] Nothing
  bench-check (cli) (codex-dir) (baseline-path) =
    if file-exists baseline-path then act
     json <- read-file baseline-path
     let baseline-total = parse-json-number-at-key json "medianMs"
     in let threshold = parse-json-number-at-key json "thresholdPercent" / 100
     in let baseline-stages = collect-baseline-stages json
     in act
      runs <- collect-runs cli codex-dir
      let current-stages = all-medians runs
      in let current-total = total-of current-stages
      in act
       print-line ("Baseline: " ++ show-ms baseline-total ++ " ms   threshold: " ++ integer-to-text threshold ++ "%")
       print-line ""
       print-line ("  " ++ pad-right "stage" 10 ++ " " ++ pad-left "baseline" 11 ++ " " ++ pad-left "current" 11 ++ " " ++ pad-left "delta" 9)
       print-line "  -------------------------------------------------"
       compare-rows-loop baseline-stages current-stages phase-names 0 (list-length phase-names)
       compare-row "total" baseline-total current-total
       print-line ""
       let delta-pct-hundredths = if baseline-total == 0 then 0
                                  else (current-total - baseline-total) * 10000 / baseline-total
       in if delta-pct-hundredths > threshold * 100 then
         print-line ("REGRESSION: " ++ format-delta-pct baseline-total current-total
                  ++ " exceeds " ++ integer-to-text threshold ++ "% threshold")
         else print-line ("OK: within " ++ integer-to-text threshold ++ "% threshold ("
                  ++ format-delta-pct baseline-total current-total ++ ")")
      end
     end
    end
    else print-line ("error: baseline not found at " ++ baseline-path ++ " -- run --bench-save first")

Section: BuildEmit

 One-shot codex build invocation. Fan the CLI's stdout/stderr back to
 our console so the user sees the compiler's own verdict (Compiled
 to ..., warning / error lines, etc.). No timing instrumentation -- this
 is a passthrough, not a bench.

 Everything in a single print-line call because the emitter lowers if-
 then-else-chains inside an act-block into bare C# ternaries, which CS0201
 rejects as statements. Easier to compose the output as a pure string and
 print it once.
  format-build-output : ProcessResult -> Text
  format-build-output (r) =
    let stderr-section = if text-length (r.stderr) == 0 then ""
                         else "\n--- stderr ---\n" ++ r.stderr
    in let exit-note = if r.exit-code == 0 then ""
                       else "\n(codex build exited " ++ integer-to-text (r.exit-code) ++ ")"
    in r.stdout ++ stderr-section ++ exit-note

  run-codex-build : Text -> Text -> [Console, Process] Nothing
  run-codex-build (cli) (args) = act
    print-line ("  " ++ cli ++ " " ++ args)
    print-line ""
    r <- run-process-full cli args
    print-line (format-build-output r)
  end

 Only append optional flag=value when the value is non-empty. Lets the
 --binary mode pass --exit-mode / --watchdog through transparently when
 the user specified them, and stay out of codex build's way otherwise so
 the CLI's own defaults apply.
  append-optional-flag : Text -> Text -> Text -> Text
  append-optional-flag (base) (flag) (value) =
    if text-length value == 0 then base
    else base ++ " " ++ flag ++ "=" ++ value

  binary-args : Text -> Text -> Text -> Text -> Text
  binary-args (codex-dir) (out-dir) (exit-mode) (watchdog) =
    let base = "build " ++ codex-dir ++ " --target x86-64 --output-dir " ++ out-dir
    in let with-exit = append-optional-flag base "--exit-mode" exit-mode
    in append-optional-flag with-exit "--watchdog" watchdog

  binary : Text -> Text -> Text -> Text -> Text -> [Console, Process] Nothing
  binary (cli) (codex-dir) (out-dir) (exit-mode) (watchdog) = act
    print-line ("Binary emit: " ++ codex-dir ++ " -> " ++ out-dir ++ "/Codex.Codex (ELF)")
    run-codex-build cli (binary-args codex-dir out-dir exit-mode watchdog)
  end

  codex-emit : Text -> Text -> Text -> [Console, Process] Nothing
  codex-emit (cli) (codex-dir) (out-dir) = act
    print-line ("Codex-text emit: " ++ codex-dir ++ " -> " ++ out-dir ++ "/Codex.Codex.codex")
    run-codex-build cli ("build " ++ codex-dir ++ " --target codex --output-dir " ++ out-dir)
  end

Section: SampleEmit

 emit-sample / binary-sample compile a single sample to an exact output
 path. ref-sweep.sh wires both: `--emit-sample <src> <outdir>/<name>.cs`
 for the selfhost-cs row, `--binary-sample <src> <outdir>/<name>.elf`
 for selfhost-netbin. Both go through the CLI's --output-file flag so
 the emitted file lands at the literal path the sweep script expects;
 the wrapper just assembles the argv and forwards stderr.
  emit-sample : Text -> Text -> Text -> [Console, Process] Nothing
  emit-sample (cli) (src) (out) = act
    print-line ("Sample emit: " ++ src ++ " -> " ++ out)
    run-codex-build cli ("build " ++ src ++ " --target cs --output-file " ++ out)
  end

  binary-sample : Text -> Text -> Text -> Text -> Text -> [Console, Process] Nothing
  binary-sample (cli) (src) (out) (exit-mode) (watchdog) = act
    let base = "build " ++ src ++ " --target x86-64 --output-file " ++ out
    in let with-exit = append-optional-flag base "--exit-mode" exit-mode
    in let full = append-optional-flag with-exit "--watchdog" watchdog
    in act
      print-line ("Sample binary: " ++ src ++ " -> " ++ out)
      run-codex-build cli full
    end
  end

Section: DumpSource

 Quire-aware concat lives in the CLI now (`codex dump-source <dir> [out]`).
 The Bootstrap-Codex side is just an arg shuffler so callers can keep
 invoking through this binary while we migrate scripts off the C# tool.
  dump-source : Text -> Text -> Text -> [Console, Process] Nothing
  dump-source (cli) (codex-dir) (out) = act
    print-line ("Source dump: " ++ codex-dir ++ " -> " ++ out)
    run-codex-build cli ("dump-source " ++ codex-dir ++ " " ++ out)
  end

Section: Dispatch

 Skip argv[0] (the executable path, per get-args semantics). The first
 real arg is the mode; remaining args are mode-specific and may include
 flag/value pairs.
  arg-at : List Text -> Integer -> Text -> Text
  arg-at (args) (i) (fallback) =
    if i >= list-length args then fallback
    else list-at args i

 Scan args for `--cli <path>` (or --cli=<path>) and return the value; fall
 back to default-cli-exe when absent. Used so the user can point at any
 codex CLI binary without having to be in the repo root.
  find-flag-loop : List Text -> Integer -> Integer -> Text -> Text -> Text
  find-flag-loop (args) (i) (n) (flag) (fallback) =
    if i >= n then fallback
    else let a = list-at args i
    in if a == flag then
         if i + 1 < n then list-at args (i + 1) else fallback
       else if text-starts-with a (flag ++ "=") then
         substring a (text-length flag + 1) (text-length a - (text-length flag + 1))
       else
         find-flag-loop args (i + 1) n flag fallback

  find-flag : List Text -> Text -> Text -> Text
  find-flag (args) (flag) (fallback) =
    find-flag-loop args 0 (list-length args) flag fallback

 Positional args after the mode that don't start with "-". Lets
 `--bench [codex-dir]` work with the dir anywhere in the tail args, and
 `--emit-sample <src> <out>` pull two positionals in order. Skips
 "-"-prefixed tokens but does NOT skip values of space-separated flags
 (e.g. `--cli /path` would treat `/path` as a positional). Callers that
 mix positionals with `--flag value` should use `--flag=value` form;
 ref-sweep does.
  positional-at-loop : List Text -> Integer -> Integer -> Integer -> Text -> Text
  positional-at-loop (args) (i) (n) (need) (fallback) =
    if i >= n then fallback
    else let a = list-at args i
    in if text-starts-with a "-" then positional-at-loop args (i + 1) n need fallback
    else if need == 0 then a
    else positional-at-loop args (i + 1) n (need - 1) fallback

  positional-at : List Text -> Integer -> Integer -> Text -> Text
  positional-at (args) (start) (need) (fallback) =
    positional-at-loop args start (list-length args) need fallback

  first-positional : List Text -> Integer -> Text -> Text
  first-positional (args) (start) (fallback) =
    positional-at args start 0 fallback

  print-usage : [Console] Nothing = act
    print-line "Usage: Bootstrap-Codex <mode> [codex-dir] [options]"
    print-line ""
    print-line "  --bench [dir]         3 warmup + 10 measured compiles, print medians."
    print-line "  --bench-save [dir]    Same protocol; write medians to baseline JSON."
    print-line "  --bench-check [dir]   Same protocol; compare to baseline; print delta table."
    print-line ""
    print-line "  --binary [dir]        Self-host to bare-metal ELF via `codex build --target x86-64`."
    print-line "                        Accepts --exit-mode and --watchdog, passed through."
    print-line "  --codex-emit [dir]    Self-host to Codex text via `codex build --target codex`."
    print-line ""
    print-line "  --emit-sample <src> <out>     Compile <src>.codex to C# at exact path <out>."
    print-line "  --binary-sample <src> <out>   Compile <src>.codex to ELF at exact path <out>."
    print-line "                                Accepts --exit-mode and --watchdog."
    print-line "  --dump-source <dir> <out>     Quire-aware concat of every .codex in <dir>"
    print-line "                                + cited foreword chapters, written to <out>."
    print-line ""
    print-line "  --cli <path>          Path to codex CLI binary"
    print-line "  --baseline <path>     Path to bench-baseline.json (bench-save / bench-check)"
    print-line "  --out <dir>           Output directory (binary / codex-emit)"
    print-line "  --exit-mode <m>       repl | qemu-exit | acpi-s5  (binary / binary-sample)"
    print-line "  --watchdog <m>        progress | pet              (binary / binary-sample)"
    print-line ""
    print-line ("  Defaults: codex-dir=" ++ default-codex-dir)
    print-line ("            cli=" ++ default-cli-exe)
    print-line ("            baseline=" ++ default-baseline-path)
    print-line ("            binary out=" ++ default-binary-out-dir)
    print-line ("            codex-emit out=" ++ default-codex-emit-out-dir)
  end

  dispatch : List Text -> [Console, FileSystem, Process] Nothing
  dispatch (args) =
    let mode = arg-at args 1 ""
    in let cli = find-flag args "--cli" default-cli-exe
    in let codex-dir = first-positional args 2 default-codex-dir
    in let baseline = find-flag args "--baseline" default-baseline-path
    in let exit-mode = find-flag args "--exit-mode" ""
    in let watchdog = find-flag args "--watchdog" ""
    in if mode == "--bench" then bench cli codex-dir
    else if mode == "--bench-save" then bench-save cli codex-dir baseline
    else if mode == "--bench-check" then bench-check cli codex-dir baseline
    else if mode == "--binary" then
      let out-dir = find-flag args "--out" default-binary-out-dir
      in binary cli codex-dir out-dir exit-mode watchdog
    else if mode == "--codex-emit" then
      let out-dir = find-flag args "--out" default-codex-emit-out-dir
      in codex-emit cli codex-dir out-dir
    else if mode == "--emit-sample" then
      let src = positional-at args 2 0 ""
      in let out = positional-at args 2 1 ""
      in emit-sample cli src out
    else if mode == "--binary-sample" then
      let src = positional-at args 2 0 ""
      in let out = positional-at args 2 1 ""
      in binary-sample cli src out exit-mode watchdog
    else if mode == "--dump-source" then
      let src-dir = positional-at args 2 0 default-codex-dir
      in let out = positional-at args 2 1 ""
      in dump-source cli src-dir out
    else print-usage

  opening : [Console, FileSystem, Process] Nothing = act
    args <- get-args
    dispatch args
  end

