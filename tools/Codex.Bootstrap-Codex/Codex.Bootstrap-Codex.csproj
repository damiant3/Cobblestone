<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Codex.BootstrapCodex</RootNamespace>
    <AssemblyName>Codex.Bootstrap-Codex</AssemblyName>
    <CodexCliExe>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Codex.Cli\bin\$(Configuration)\net8.0\Codex.Cli.exe'))</CodexCliExe>
    <CodexCliDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Codex.Cli\bin\$(Configuration)\net8.0\Codex.Cli.dll'))</CodexCliDll>
    <GeneratedCs>$(MSBuildProjectDirectory)\out\Codex.Bootstrap-Codex.cs</GeneratedCs>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit path, not a glob: the file is generated by RegenerateCs
         before csc runs, but globs are evaluated at project-load time,
         so an empty out/ dir would leave the Compile item set empty and
         produce CS5001 on clean-room builds. -->
    <Compile Include="$(GeneratedCs)" />
  </ItemGroup>
  <ItemGroup>
    <CodexSources Include="**/*.codex" />
  </ItemGroup>
  <Target Name="RegenerateCs" BeforeTargets="BeforeCompile"
          Condition="'$(SkipCodexRegenerate)' != 'true'"
          Inputs="@(CodexSources);codex.project.json"
          Outputs="$(GeneratedCs)">
    <Message Importance="high" Text="Regenerating $(GeneratedCs) from .codex sources..." />
    <Exec Command="&quot;$(CodexCliExe)&quot; build &quot;$(MSBuildProjectDirectory)&quot;"
          Condition="Exists('$(CodexCliExe)')"
          ConsoleToMSBuild="true" />
    <Exec Command="dotnet &quot;$(CodexCliDll)&quot; build &quot;$(MSBuildProjectDirectory)&quot;"
          Condition="!Exists('$(CodexCliExe)') AND Exists('$(CodexCliDll)')"
          ConsoleToMSBuild="true" />
  </Target>
</Project>
