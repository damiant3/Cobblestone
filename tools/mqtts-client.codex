Section: The Socket

  mqtts-transport : Integer -> TcpTransportState
  mqtts-transport (x) =
    let sess = net-session-new mqtts-local-mac mqtts-local-ip mqtts-gateway-ip mqtts-local-port mqtts-broker-port mqtts-gateway-ip 1000
    in transport-new sess

Section: TLS Record Framing

 A TLS record is a five-byte header -- type, two version bytes, and a
 sixteen-bit length -- and then that many bytes.

  rec-total : List Integer -> Integer
  rec-total (buf) = 5 + (list-at buf 3 * 256 + list-at buf 4)

  rec-ready : List Integer -> Boolean
  rec-ready (buf) =
    if list-length buf < 5 then False
    else list-length buf >= rec-total buf

  rec-drop : List Integer, Integer -> List Integer
  rec-drop (bs) (n) = tls-slice bs n (list-length bs - n) []

  MqttsRecv = record {
    mq-ts : TcpTransportState,
    mq-rec : List Integer,
    mq-rest : List Integer,
    mq-ok : Boolean
  }

  mqtts-poll-start : Integer = 49000000

 How many records to take before giving up on a step. It is not one per
 MQTT packet, because a TLS 1.3 server sends things of its own: OpenSSL
 posts two NewSessionTicket records the moment the handshake finishes,
 and each is a record that yields no application bytes at all. A budget
 of two, which is generous in MQTT terms, was consumed entirely by those
 tickets and the CONNACK behind them was never read.

  mqtts-rounds : Integer = 8

  mqtts-recv-record : TcpTransportState, List Integer, Integer -> [Network.Read, Network.Write] MqttsRecv
  mqtts-recv-record (ts) (buf) (guard) =
    if guard <= 0 then MqttsRecv { mq-ts = ts, mq-rec = [], mq-rest = buf, mq-ok = False }
    else if rec-ready buf
    then MqttsRecv { mq-ts = ts, mq-rec = tls-take-bytes buf (rec-total buf), mq-rest = rec-drop buf (rec-total buf), mq-ok = True }
    else act
      rr <- net-io-recv-raw ts mqtts-poll-start
      if rr.has-data == False then MqttsRecv { mq-ts = rr.transport, mq-rec = [], mq-rest = buf, mq-ok = False }
      else mqtts-recv-record (rr.transport) (buf & (rr.data)) (guard - 1)
    end

  mqtts-send-all : TcpTransportState, List (List Integer), Integer -> [Network.Read, Network.Write] TcpTransportState
  mqtts-send-all (ts) (recs) (i) =
    if i >= list-length recs then ts
    else act
      ts1 <- net-io-send-raw ts (list-at recs i)
      mqtts-send-all ts1 recs (i + 1)
    end

Section: The Handshake

  MqttsHs = record {
    hs-ts : TcpTransportState,
    hs-ep : TlsEp,
    hs-rest : List Integer
  }

  mqtts-drive : TcpTransportState, TlsEp, List Integer, Integer -> [Network.Read, Network.Write] MqttsHs
  mqtts-drive (ts) (ep) (buf) (guard) =
    if tls-ep-done ep then MqttsHs { hs-ts = ts, hs-ep = ep, hs-rest = buf }
    else if guard <= 0 then MqttsHs { hs-ts = ts, hs-ep = ep, hs-rest = buf }
    else act
      rr <- mqtts-recv-record ts buf 100000
      if rr.mq-ok == False then MqttsHs { hs-ts = rr.mq-ts, hs-ep = ep, hs-rest = rr.mq-rest }
      else let step = tls-ep-recv ep (rr.mq-rec)
      in act
        ts2 <- mqtts-send-all (rr.mq-ts) (step.tes-out) 0
        mqtts-drive ts2 (step.tes-ep) (rr.mq-rest) (guard - 1)
      end
    end

Section: MQTT Inside TLS

  MqttsRun = record {
    mr-mep : MqttEp,
    mr-tep : TlsEp,
    mr-ts : TcpTransportState,
    mr-buf : List Integer,
    mr-used : Integer,
    mr-got : Boolean
  }

  mqtts-send-mqtt : TlsEp, TcpTransportState, List (List Integer), Integer -> [Network.Read, Network.Write] MqttsRun
  mqtts-send-mqtt (tep) (ts) (pkts) (i) =
    if i >= list-length pkts then MqttsRun { mr-mep = mqtt-ep-new, mr-tep = tep, mr-ts = ts, mr-buf = [], mr-used = 0, mr-got = True }
    else let step = tls-ep-send-app tep (list-at pkts i)
    in act
      ts1 <- mqtts-send-all ts (step.tes-out) 0
      mqtts-send-mqtt (step.tes-ep) ts1 pkts (i + 1)
    end

  mqtts-pump : MqttEp, TlsEp, TcpTransportState, List Integer, Integer -> [Network.Read, Network.Write] MqttsRun
  mqtts-pump (mep) (tep) (ts) (buf) (used) =
    act
      rr <- mqtts-recv-record ts buf 100000
      if rr.mq-ok == False then MqttsRun { mr-mep = mep, mr-tep = tep, mr-ts = rr.mq-ts, mr-buf = rr.mq-rest, mr-used = used, mr-got = False }
      else let step = tls-ep-recv tep (rr.mq-rec)
      in let app = tls-ep-app-in (step.tes-ep)
      in let fresh = mqtt-slice app used (list-length app)
      in let mstep = mqtt-ep-recv mep fresh 0
      in act
        ts2 <- mqtts-send-all (rr.mq-ts) (step.tes-out) 0
        r <- mqtts-send-mqtt (step.tes-ep) ts2 (mstep.ms-out) 0
        MqttsRun { mr-mep = mstep.ms-ep, mr-tep = r.mr-tep, mr-ts = r.mr-ts, mr-buf = rr.mq-rest, mr-used = used + (mstep.ms-consumed), mr-got = True }
      end
    end

  mqtts-settle : MqttEp, TlsEp, TcpTransportState, List Integer, Integer, Integer -> [Network.Read, Network.Write] MqttsRun
  mqtts-settle (mep) (tep) (ts) (buf) (used) (rounds) =
    if rounds <= 0 then MqttsRun { mr-mep = mep, mr-tep = tep, mr-ts = ts, mr-buf = buf, mr-used = used, mr-got = False }
    else act
      r <- mqtts-pump mep tep ts buf used
      if r.mr-got == False then r
      else mqtts-settle (r.mr-mep) (r.mr-tep) (r.mr-ts) (r.mr-buf) (r.mr-used) (rounds - 1)
    end

Section: Reporting

  mqtts-bytes-text : List Integer, Integer, Text -> Text
  mqtts-bytes-text (bs) (i) (acc) =
    if i >= list-length bs then acc
    else mqtts-bytes-text bs (i + 1) (if i == 0 then show (list-at bs i) else acc & "," & show (list-at bs i))

Section: The Session

  mqtts-session : MqttsHs -> [Network.Read, Network.Write, Console.Write] Nothing
  mqtts-session (hs) =
    let c = mqtt-ep-connect mqtt-ep-new mqtts-config
    in act
      s0 <- mqtts-send-mqtt (hs.hs-ep) (hs.hs-ts) (c.ms-out) 0
      r1 <- mqtts-settle (c.ms-ep) (s0.mr-tep) (s0.mr-ts) (hs.hs-rest) 0 mqtts-rounds
      print-line-uni ("mqtts connect ready=" & show (mqtt-ep-ready (r1.mr-mep)) & " reason=" & show (mqtt-ep-connack (r1.mr-mep)))
      let sub = mqtt-ep-subscribe (r1.mr-mep) mqtts-topic QosAtLeastOnce
      in act
        s1 <- mqtts-send-mqtt (r1.mr-tep) (r1.mr-ts) (sub.ms-out) 0
        r2 <- mqtts-settle (sub.ms-ep) (s1.mr-tep) (s1.mr-ts) (r1.mr-buf) (r1.mr-used) mqtts-rounds
        print-line-uni ("mqtts subscribe granted=" & show (mqtt-ep-suback (r2.mr-mep)))
        let p = mqtt-ep-publish (r2.mr-mep) mqtts-topic mqtts-payload QosAtLeastOnce 0
        in act
          s2 <- mqtts-send-mqtt (r2.mr-tep) (r2.mr-ts) (p.ms-out) 0
          r3 <- mqtts-settle (p.ms-ep) (s2.mr-tep) (s2.mr-ts) (r2.mr-buf) (r2.mr-used) mqtts-rounds
          print-line-uni ("mqtts publish acked=" & show (mqtt-ep-published (r3.mr-mep)))
          print-line-uni ("mqtts delivered count=" & show (mqtt-ep-in-count (r3.mr-mep)) & " payload=" & mqtts-bytes-text (mqtt-ep-in-payload (r3.mr-mep)) 0 "")
          ts9 <- net-io-close (r3.mr-ts)
          print-line-uni "mqtts closed"
        end
      end
    end

  mqtts-config : MqttConnectConfig
  mqtts-config = MqttConnectConfig {
    client-id = "codex-secure", keep-alive = 60, clean-start = True,
    username = None, password = None }

Section: Entry

  mqtts-anchors : List X509Anchor =
    when x509-parse mqtts-ca
      is None -> []
      is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  opening : [Network.Read, Network.Write, Console.Write] Nothing = act
    ts <- net-io-connect (mqtts-transport 0)
    when (ts.session).conn.state
      is TcpEstablished -> mqtts-open ts
      is otherwise -> print-line-uni "mqtts: broker did not answer on 8883"
  end

  mqtts-open : TcpTransportState -> [Network.Read, Network.Write, Console.Write] Nothing
  mqtts-open (ts) =
    let st0 = tls-ep-hello (tls-ep-client-new mqtts-priv mqtts-random mqtts-anchors mqtts-cal-now mqtts-peer-name)
    in act
      ts1 <- mqtts-send-all ts (st0.tes-out) 0
      hs <- mqtts-drive ts1 (st0.tes-ep) [] 200
      print-line-uni ("mqtts tls done=" & show (tls-ep-done (hs.hs-ep)) & " authenticated=" & show (tls-ep-authenticated (hs.hs-ep)) & " anchors=" & show (list-length mqtts-anchors))
      if tls-ep-done (hs.hs-ep) then mqtts-session hs
      else print-line-uni "mqtts: TLS handshake did not complete"
    end
