Section: The Socket

  serve-port : Integer = 9443

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  nat-gw-mac : List Integer = [82, 85, 10, 0, 2, 2]

  fresh-transport : Integer -> TcpTransportState
  fresh-transport (x) =
    let sess = net-session-new local-mac local-ip gateway-ip serve-port 0 gateway-ip 1000
    in let sess2 = set-arp sess (arp-cache-add (sess.arp) gateway-ip nat-gw-mac)
    in transport-new sess2

Section: Record Boundaries

 A TLS record is a five-byte header -- type, two version bytes, and a
 sixteen-bit length -- followed by that many bytes.

  rec-total : List Integer -> Integer
  rec-total (buf) = 5 + (list-at buf 3 * 256 + list-at buf 4)

  has-record : List Integer -> Boolean
  has-record (buf) =
    if list-length buf < 5 then False
    else list-length buf >= rec-total buf

  drop-n : List Integer, Integer -> List Integer
  drop-n (bs) (n) = tls-slice bs n (list-length bs - n) []

Section: Sending

 One step of the endpoint can emit several records -- a server's first
 flight is ServerHello, EncryptedExtensions, Certificate,
 CertificateVerify and Finished -- and each goes out whole.

  send-all : TcpTransportState, List (List Integer), Integer -> [Network.Write, Console.Write] TcpTransportState
  send-all (ts) (outs) (i) =
    if i >= list-length outs then ts
    else let r = list-at outs i
    in act
      print-line-uni ("  out[" & show i & "] bytes=" & show (list-length r) & " hdr=" & show (list-at r 0) & "," & show (list-at r 1) & "," & show (list-at r 2) & "," & show (list-at r 3) & "," & show (list-at r 4) & " declared=" & show (list-at r 3 * 256 + list-at r 4))
      ts1 <- net-io-send-raw ts r
      send-all ts1 outs (i + 1)
    end

Section: The Connection

 Feed every complete record in the buffer to the endpoint before asking
 the socket for more. A server flight can arrive coalesced into one
 segment and a client's Finished can share a segment with its first
 application record, so draining the buffer is not an optimisation.

  drain : TlsEp, TcpTransportState, List Integer -> [Network.Read, Network.Write, Console.Write] ConnState
  drain (ep) (ts) (buf) =
    if has-record buf == False then ConnState { cs-ep = ep, cs-ts = ts, cs-buf = buf }
    else let n = rec-total buf
    in let rec = tls-take-bytes buf n
    in let step = tls-ep-recv ep rec
    in act
      print-line-uni ("  rec type=" & show (list-at buf 0) & " len=" & show n & " -> outs=" & show (list-length (step.tes-out)) & " done=" & show (tls-ep-done (step.tes-ep)))
      ts1 <- send-all ts (step.tes-out) 0
      drain (step.tes-ep) ts1 (drop-n buf n)
    end

  ConnState = record {
    cs-ep : TlsEp,
    cs-ts : TcpTransportState,
    cs-buf : List Integer
  }

 The connection loop. Read, drain, and stop when the endpoint has both
 completed the handshake and received an application record -- at which
 point the same bytes go back, encrypted under the server application
 key, and the harness compares them.

  serve-conn : TlsEp, TcpTransportState, List Integer, Integer -> [Network.Read, Network.Write, Console.Write] Text
  serve-conn (ep) (ts) (buf) (fuel) =
    if fuel <= 0 then "fuel-exhausted"
    else act
      st <- drain ep ts buf
      if tls-ep-done (st.cs-ep) & list-length (tls-ep-app-in (st.cs-ep)) > 0
      then echo-back (st.cs-ep) (st.cs-ts)
      else act
        r <- net-io-recv-raw (st.cs-ts) 0
        if r.has-data == False then "peer-silent"
        else serve-conn (st.cs-ep) (r.transport) ((st.cs-buf) & (r.data)) (fuel - 1)
      end
    end

  echo-back : TlsEp, TcpTransportState -> [Network.Write, Console.Write] Text
  echo-back (ep) (ts) =
    let payload = tls-ep-app-in ep
    in let step = tls-ep-send-app ep payload
    in act
      ts1 <- send-all ts (step.tes-out) 0
      ts2 <- net-io-close ts1
      let verdict = "echoed " & show (list-length payload)
      in verdict
    end

Section: Entry

  serve-one : Integer -> [Network.Read, Network.Write, Console.Write] Text
  serve-one (x) = act
    ts <- net-io-accept (net-io-listen (fresh-transport 0)) 0
    print-line-uni "tls-serve: accept returned"
    when (ts.session).conn.state
      is TcpEstablished -> serve-conn (tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub) ts [] 4000
      is otherwise -> "no-conn"
  end

 One connection at a time, but MANY of them in succession. A server that
 accepts exactly once is indistinguishable from a hung one the moment
 anything else touches the port -- a readiness probe that connects and
 closes consumes the single accept, and the client that follows waits
 forever on a listener that has already moved on. That is not
 hypothetical: it is what the first run of build/tls-interop-test.ps1
 did, and the symptom was a handshake timeout with a guest sitting at
 "listening".

  serve-loop : Integer -> [Network.Read, Network.Write, Console.Write] Integer
  serve-loop (count) = act
    verdict <- serve-one 0
    print-line-uni ("tls-serve " & show count & ": " & verdict)
    serve-loop (count + 1)
  end

  opening : [Network.Read, Network.Write, Console.Write] Nothing = act
    print-line-uni ("tls-serve: listening on guest port " & show serve-port)
    served <- serve-loop 0
    print-line-uni ("tls-serve: closed after " & show served)
  end
