%YAML 1.2
---
# Codex syntax highlighting for Sublime Text 3+.
#
# Mirrors tools/vscode/syntaxes/codex.tmLanguage.json.
# When you change one, change the other. Token list lives in
# Codex.Codex/Syntax/Token.codex; lexer keyword classification in
# Codex.Codex/Syntax/Lexer.codex (classify-word).
name: Codex
file_extensions: [codex]
scope: source.codex

contexts:
  main:
    - include: prose-headers
    - include: type-signatures
    - include: annotations
    - include: char-literals
    - include: strings
    - include: numbers
    - include: keywords
    - include: effect-brackets
    - include: operators
    - include: boolean-constants
    - include: types
    - include: function-definition
    - include: identifiers

  prose-headers:
    - match: '^(Chapter|Section):\s*(.*)$'
      captures:
        1: keyword.control.header.codex
        2: markup.heading.codex

  type-signatures:
    - match: '^(\s*)((?:[a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*))(\s*:)(\s.+)$'
      captures:
        2: entity.name.function.codex
        3: keyword.operator.type-annotation.codex

  function-definition:
    - match: '^(\s*)((?:[a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*))(\s+\(|\s+=)'
      captures:
        2: entity.name.function.codex

  annotations:
    - match: '@[a-z][a-z0-9-]*'
      scope: entity.name.tag.annotation.codex

  char-literals:
    - match: "'(?=([^'\\\\]|\\\\.)')"
      scope: punctuation.definition.string.begin.codex
      push:
        - meta_scope: string.quoted.single.char.codex
        - match: "'"
          scope: punctuation.definition.string.end.codex
          pop: true
        - match: '\\.'
          scope: constant.character.escape.codex

  strings:
    - match: '"""'
      scope: punctuation.definition.string.begin.codex
      push:
        - meta_scope: string.quoted.triple.codex
        - match: '"""'
          scope: punctuation.definition.string.end.codex
          pop: true
        - match: '\\.'
          scope: constant.character.escape.codex
    - match: '"'
      scope: punctuation.definition.string.begin.codex
      push:
        - meta_scope: string.quoted.double.codex
        - match: '"'
          scope: punctuation.definition.string.end.codex
          pop: true
        - match: '\\.'
          scope: constant.character.escape.codex

  numbers:
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?\b'
      scope: constant.numeric.codex

  keywords:
    - match: '\b(let|in|between|if|then|else|when|where|is|otherwise|act|end|record|cites|effect|with|linear)\b'
      scope: keyword.control.codex
    - match: '\b(claim|proof|qed|forall|exists)\b'
      scope: keyword.other.proof.codex

  effect-brackets:
    - match: '\[([A-Z][A-Za-z0-9]*)\]'
      scope: storage.type.effect.codex
      captures:
        1: entity.name.type.effect.codex

  operators:
    - match: '→|←|≡|≠|≤|≥|⊢|⊗|∀|∃'
      scope: keyword.operator.unicode.codex
    - match: '->|<-|===|/=|<=|>=|==|\+\+|::|\|-|\(\*\*\)'
      scope: keyword.operator.ascii.codex
    - match: '\|'
      scope: keyword.operator.pipe.codex
    - match: '[=+\-*/^&<>]'
      scope: keyword.operator.codex

  types:
    - match: '\b[A-Z][A-Za-z0-9]*\b'
      scope: entity.name.type.codex

  boolean-constants:
    - match: '\b(True|False)\b'
      scope: constant.language.boolean.codex

  identifiers:
    - match: '\b[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\b'
      scope: variable.other.codex
