Chapter: Codex Agent
  cites Codex chapter Console
  cites Codex chapter Files
  cites Codex chapter Process
  cites Codex chapter Text
  cites Codex chapter Characters
  cites Codex chapter Lists
  cites Codex chapter Numbers

 AI agent toolkit for Codex sessions. Commands dispatch through variant
 types — no cascade text compares for the main command, subcommands, or
 state machines.

Section: Types

  Command =
   | CmdPeek
   | CmdStat
   | CmdSnap
   | CmdHelp
   | CmdInit
   | CmdStatus
   | CmdPlan
   | CmdCheck
   | CmdDoctor
   | CmdHandoff
   | CmdLog
   | CmdRecall
   | CmdBuild
   | CmdTest
   | CmdOrient
   | CmdGreet
   | CmdRoster
   | CmdUnknown (Text)

  SnapAction =
   | SnapSave
   | SnapDiff
   | SnapRestore
   | SnapUnknown (Text)

  PlanAction =
   | PlanShow
   | PlanClear
   | PlanAdd
   | PlanUnknown (Text)

  HandoffAction =
   | HandoffShow
   | HandoffPush
   | HandoffReview
   | HandoffApprove
   | HandoffRequestChanges
   | HandoffMerge
   | HandoffAbandon
   | HandoffUnknown (Text)

  HandoffState =
   | StateDraft
   | StateAwaitingReview
   | StateUnderReview
   | StateChangesRequested
   | StateApproved
   | StateMerged
   | StateAbandoned
   | StateUnknown (Text)

  OrientTopic =
   | TopicVision
   | TopicSyntax
   | TopicPipeline
   | TopicAgents
   | TopicStyle
   | TopicGit
   | TopicTools
   | TopicStructure
   | TopicPitfalls
   | TopicUnknown (Text)

  LoadLevel =
   | LoadGreen
   | LoadYellow
   | LoadOrange
   | LoadRed

Section: Parsing

  parse-command : Text -> Command
  parse-command (s) =
   if s == "peek" then CmdPeek
   else if s == "stat" then CmdStat
   else if s == "snap" then CmdSnap
   else if s == "help" then CmdHelp
   else if s == "init" then CmdInit
   else if s == "status" then CmdStatus
   else if s == "plan" then CmdPlan
   else if s == "check" then CmdCheck
   else if s == "doctor" then CmdDoctor
   else if s == "handoff" then CmdHandoff
   else if s == "log" then CmdLog
   else if s == "recall" then CmdRecall
   else if s == "build" then CmdBuild
   else if s == "test" then CmdTest
   else if s == "orient" then CmdOrient
   else if s == "greet" then CmdGreet
   else if s == "roster" then CmdRoster
   else CmdUnknown s

  cmd-needs-repo : Command -> Boolean
  cmd-needs-repo (cmd) =
   when cmd
    is CmdPeek -> False
    is CmdStat -> False
    is CmdSnap -> False
    is CmdHelp -> False
    is otherwise -> True

  parse-snap-action : Text -> SnapAction
  parse-snap-action (s) =
   if s == "save" then SnapSave
   else if s == "diff" then SnapDiff
   else if s == "restore" then SnapRestore
   else SnapUnknown s

  parse-plan-action : Text -> PlanAction
  parse-plan-action (s) =
   if s == "show" then PlanShow
   else if s == "clear" then PlanClear
   else if s == "add" then PlanAdd
   else PlanUnknown s

  parse-handoff-action : Text -> HandoffAction
  parse-handoff-action (s) =
   if s == "show" then HandoffShow
   else if s == "push" then HandoffPush
   else if s == "review" then HandoffReview
   else if s == "approve" then HandoffApprove
   else if s == "request-changes" then HandoffRequestChanges
   else if s == "merge" then HandoffMerge
   else if s == "abandon" then HandoffAbandon
   else HandoffUnknown s

  parse-handoff-state : Text -> HandoffState
  parse-handoff-state (s) =
   if s == "draft" then StateDraft
   else if s == "awaiting-review" then StateAwaitingReview
   else if s == "under-review" then StateUnderReview
   else if s == "changes-requested" then StateChangesRequested
   else if s == "approved" then StateApproved
   else if s == "merged" then StateMerged
   else if s == "abandoned" then StateAbandoned
   else StateUnknown s

  parse-orient-topic : Text -> OrientTopic
  parse-orient-topic (s) =
   if s == "vision" then TopicVision
   else if s == "syntax" then TopicSyntax
   else if s == "pipeline" then TopicPipeline
   else if s == "agents" then TopicAgents
   else if s == "style" then TopicStyle
   else if s == "git" then TopicGit
   else if s == "tools" then TopicTools
   else if s == "structure" then TopicStructure
   else if s == "pitfalls" then TopicPitfalls
   else TopicUnknown s

Section: Text Utilities

  is-digit-at : Text -> Integer -> Integer -> Boolean
  is-digit-at (s) (i) (len) =
   if i >= len then True
   else let c = char-to-text (char-at s i)
   in if text-contains "0123456789" c then is-digit-at s (i + 1) len
    else False

  is-integer-text : Text -> Boolean
  is-integer-text (s) =
   let len = text-length s
   in if len == 0 then False
    else let first = char-to-text (char-at s 0)
    in if first == "-" then
      if len > 1 then is-digit-at s 1 len
      else False
     else is-digit-at s 0 len

  parse-int-or : Text -> Integer -> Integer
  parse-int-or (s) (default-val) =
   if is-integer-text s then text-to-integer s
   else default-val

  pad-right : Text -> Integer -> Text
  pad-right (s) (width) =
   if text-length s >= width then s
   else pad-right (s ++ " ") width

  pad-left : Text -> Integer -> Text
  pad-left (s) (width) =
   if text-length s >= width then s
   else pad-left (" " ++ s) width

  count-lines : Text -> Integer
  count-lines (content) =
   if text-length content == 0 then 0
   else list-length (text-split content "\n")

  size-hint : Integer -> Text
  size-hint (lines) =
   if lines > 300 then " !! LARGE"
   else if lines > 100 then " ~  medium"
   else ""

  format-line : Integer -> Text -> Text
  format-line (num) (line) =
   pad-left (integer-to-text num) 5 ++ "  " ++ line

  format-lines-loop : List Text -> Integer -> Integer -> Text
  format-lines-loop (lines) (current) (end-line) =
   if current > end-line then ""
   else if current > list-length lines then ""
   else let line = list-at lines (current - 1)
   in let formatted = format-line current line
   in let rest = format-lines-loop lines (current + 1) end-line
   in if text-length rest == 0 then formatted
       else formatted ++ "\n" ++ rest

  take-last-n : List Text -> Integer -> Integer -> Integer -> Text
  take-last-n (lines) (idx) (start) (total) =
   if idx >= total then ""
   else if idx < start then take-last-n lines (idx + 1) start total
   else let line = list-at lines idx
   in let rest = take-last-n lines (idx + 1) start total
   in if text-length rest == 0 then line
    else line ++ "\n" ++ rest

  collect-args : List Text -> Integer -> Integer -> Text
  collect-args (args) (idx) (start) =
   if idx >= list-length args then ""
   else let word = list-at args idx
   in if idx == start then word ++ collect-args args (idx + 1) start
     else " " ++ word ++ collect-args args (idx + 1) start

  snap-path : Text -> Text
  snap-path (file) = file ++ ".snap"

Section: Paths

  join-parts-loop : List Text -> Integer -> Integer -> Text -> Text
  join-parts-loop (parts) (idx) (last-idx) (acc) =
   if idx > last-idx then acc
   else let part = list-at parts idx
   in let next = if text-length acc == 0 then part else acc ++ "/" ++ part
   in join-parts-loop parts (idx + 1) last-idx next

  find-repo-root-loop : List Text -> Integer -> Integer -> Text
  find-repo-root-loop (parts) (idx) (n) =
   if idx >= n then ""
   else if text-starts-with (list-at parts idx) "NewRepository" then join-parts-loop parts 0 idx ""
   else find-repo-root-loop parts (idx + 1) n

  repo-root : [Process] Text
  repo-root = act
   cwd <- current-dir
   let normalized = text-replace cwd "\\" "/"
   in let parts = text-split normalized "/"
   in find-repo-root-loop parts 0 (list-length parts)
  end

  repo-path : Text -> [Process] Text
  repo-path (rel) = act
   root <- repo-root
   if text-length root == 0 then rel
   else root ++ "/" ++ rel
  end

  repo-root-missing-msg : [Process] Text
  repo-root-missing-msg = act
   cwd <- current-dir
   "  Could not find project root.\n  Looking for 'NewRepository*' in the parent path of:\n    " ++ cwd ++ "\n  cd into a NewRepository-* checkout and try again."
  end

  codex-agent-dir : [Process] Text = repo-path ".codex-agent"
  plan-file : [Process] Text = repo-path ".codex-agent/plan.txt"
  log-file : [Process] Text = repo-path ".codex-agent/session.log"
  build-log : [Process] Text = repo-path ".codex-agent/last-build.txt"
  test-log : [Process] Text = repo-path ".codex-agent/last-test.txt"
  known-conditions-file : [Process] Text = repo-path "docs/KNOWN-CONDITIONS.md"
  handoff-file : [Process] Text = repo-path ".handoff"
  agents-dir : [Process] Text = repo-path "docs/Agents"

  agent-file : Text -> [Process] Text
  agent-file (name) = act
   dir <- agents-dir
   dir ++ "/" ++ name ++ ".txt"
  end

  ensure-codex-agent-dir : [FileSystem, Process] Text
  ensure-codex-agent-dir = act
   dir <- codex-agent-dir
   if file-exists dir then ""
   else run-process "pwsh" ("-Command New-Item -ItemType Directory -Force -Path " ++ dir)
  end

  read-if-exists : Text -> [FileSystem, Process] Text
  read-if-exists (path) = if file-exists path then read-file path else ""

Section: Key-Value Helpers

  kv-get : Text -> List Text -> Integer -> Text
  kv-get (key) (lines) (idx) =
   if idx >= list-length lines then ""
   else let line = list-at lines idx
   in let prefix = key ++ "="
   in if text-starts-with line prefix then substring line (text-length prefix) (text-length line - text-length prefix)
      else kv-get key lines (idx + 1)

  kv-set-loop : Text -> Text -> List Text -> Text -> Integer -> Integer -> Text
  kv-set-loop (key) (value) (lines) (prefix) (idx) (found) =
   if idx >= list-length lines then
    if found == 0 then key ++ "=" ++ value ++ "\n"
    else ""
   else let line = list-at lines idx
   in let rest = kv-set-loop key value lines prefix (idx + 1) (if text-starts-with line prefix then 1 else found)
   in if text-starts-with line prefix then key ++ "=" ++ value ++ "\n" ++ rest
     else if text-length line == 0 then rest
     else line ++ "\n" ++ rest

  kv-set : Text -> Text -> Text -> Text
  kv-set (key) (value) (content) =
   let lines = text-split content "\n"
   in let prefix = key ++ "="
   in kv-set-loop key value lines prefix 0 0

Section: Environment

  detect-agent : [FileSystem, Process] Text
  detect-agent = act
   dir <- current-dir
   if text-contains dir "linux" | text-contains dir "Linux" then "linux-agent"
   else "windows-agent"
  end

  get-current-branch : [FileSystem, Process] Text
  get-current-branch = act
   result <- run-process "git" "rev-parse --abbrev-ref HEAD"
   let lines = text-split result "\n"
   in if list-length lines > 0 then list-at lines 0 else "unknown"
  end

Section: Peek

  do-peek : List Text -> [Console, FileSystem, Process] Nothing
  do-peek (args) =
   let argc = list-length args
   in if argc < 3 then print-line "Usage: codex-agent peek <file> [start] [end]"
    else let file = list-at args 2
    in if file-exists file then act
      content <- read-file file
      let all-lines = text-split content "\n"
      in let total = list-length all-lines
      in let raw-start = if argc > 3 then parse-int-or (list-at args 3) 1 else 1
      in let start = if raw-start < 1 then 1 else raw-start
      in let end-line = if argc > 4 then parse-int-or (list-at args 4) 0 else 0
      in let actual-end = if end-line == 0 then total else end-line
      in let header = "--- " ++ file ++ " lines " ++ integer-to-text start ++ ".." ++ integer-to-text actual-end ++ " of " ++ integer-to-text total ++ " ---"
      in print-line (header ++ "\n" ++ format-lines-loop all-lines start actual-end)
     end
     else print-line ("File not found: " ++ file)

Section: Stat

  stat-loop : List Text -> Integer -> Integer -> Integer -> [FileSystem, Process] Text
  stat-loop (args) (idx) (total-lines) (total-chars) =
   if idx >= list-length args then
    if idx > 3 then
     "\n" ++ pad-right ("TOTAL (" ++ integer-to-text (idx - 2) ++ " files)") 50 ++ pad-left (integer-to-text total-lines) 7 ++ pad-left (integer-to-text total-chars) 9
    else ""
   else let file = list-at args idx
   in if file-exists file then act
     content <- read-file file
     rest <- stat-loop args (idx + 1) (total-lines + count-lines content) (total-chars + text-length content)
     let row = pad-right file 50 ++ pad-left (integer-to-text (count-lines content)) 7 ++ pad-left (integer-to-text (text-length content)) 9 ++ size-hint (count-lines content)
     in row ++ "\n" ++ rest
    end
    else act
     rest <- stat-loop args (idx + 1) total-lines total-chars
     "  (not found: " ++ file ++ ")\n" ++ rest
    end

  do-stat : List Text -> [Console, FileSystem, Process] Nothing
  do-stat (args) =
   let argc = list-length args
   in if argc < 3 then print-line "Usage: codex-agent stat <file> [file2] ..."
    else let header = pad-right "File" 50 ++ pad-left "Lines" 7 ++ pad-left "Chars" 9
    in let sep = "-------------------------------------------------- ------- --------"
    in print-line (header ++ "\n" ++ sep ++ "\n" ++ stat-loop args 2 0 0)

Section: Snap

  do-snap-save : Text -> [Console, FileSystem, Process] Nothing
  do-snap-save (file) =
   if file-exists file then act
    content <- read-file file
    _ <- write-file (snap-path file) content
    print-line ("  Snapshot saved: " ++ file ++ " (" ++ integer-to-text (count-lines content) ++ " lines)")
   end
   else print-line ("  File not found: " ++ file)

  do-snap-restore : Text -> [Console, FileSystem, Process] Nothing
  do-snap-restore (file) =
   let snap = snap-path file
   in if file-exists snap then act
    content <- read-file snap
    _ <- write-file file content
    print-line ("  Restored: " ++ file ++ " (" ++ integer-to-text (count-lines content) ++ " lines)")
   end
   else print-line ("  No snapshot found for " ++ file ++ ". Run 'snap save' first.")

  do-snap-diff : Text -> [Console, FileSystem, Process] Nothing
  do-snap-diff (file) =
   let snap = snap-path file
   in if file-exists snap then
    if file-exists file then act
     old-content <- read-file snap
     new-content <- read-file file
     let old-lines = count-lines old-content
     in let new-lines = count-lines new-content
     in let delta = new-lines - old-lines
     in if old-content == new-content then
         print-line ("-- " ++ file ++ ": no changes (" ++ integer-to-text old-lines ++ " lines) --")
        else
         print-line ("-- " ++ file ++ " --\n  Before: " ++ integer-to-text old-lines ++ " lines   After: " ++ integer-to-text new-lines ++ " lines   Delta: " ++ integer-to-text delta ++ "\n  Use 'codex-agent peek " ++ file ++ "' to inspect.\n-- End diff --")
    end
    else print-line ("  File not found: " ++ file)
   else print-line ("  No snapshot for " ++ file ++ ". Run 'codex-agent snap save " ++ file ++ "' first.")

  do-snap : List Text -> [Console, FileSystem, Process] Nothing
  do-snap (args) =
   let argc = list-length args
   in if argc < 3 then print-line "Usage: codex-agent snap <save|diff|restore> <file>"
    else when parse-snap-action (list-at args 2)
     is SnapSave -> if argc < 4 then print-line "Usage: codex-agent snap save <file>"
                    else do-snap-save (list-at args 3)
     is SnapDiff -> if argc < 4 then print-line "Usage: codex-agent snap diff <file>"
                    else do-snap-diff (list-at args 3)
     is SnapRestore -> if argc < 4 then print-line "Usage: codex-agent snap restore <file>"
                       else do-snap-restore (list-at args 3)
     is SnapUnknown (a) -> print-line ("Unknown snap action: " ++ a ++ ". Use save, diff, or restore.")

Section: Status

  check-file-status : Text -> Text -> [FileSystem, Process] Text
  check-file-status (label) (path) =
   if file-exists path then label ++ ": found"
   else label ++ ": MISSING"

  do-status : List Text -> [Console, FileSystem, Process] Nothing
  do-status (args) =
   print-line (
    "=== Codex Agent Status ===\n" ++
    check-file-status "  Solution     " (repo-path "Codex.sln") ++ "\n" ++
    check-file-status "  Build props  " (repo-path "Directory.Build.props") ++ "\n" ++
    check-file-status "  Contributing " (repo-path "CONTRIBUTING.md") ++ "\n" ++
    check-file-status "  Current plan " (repo-path "docs/CurrentPlan.md") ++ "\n" ++
    check-file-status "  Agent rules  " (repo-path "CONTRIBUTING.md") ++ "\n" ++
    "=========================="
   )

Section: Plan

  do-plan-show : [Console, FileSystem, Process] Nothing
  do-plan-show =
   if file-exists plan-file then act
    content <- read-file plan-file
    if text-length content == 0 then print-line "  (no tasks)"
    else print-line ("=== Agent Plan ===\n" ++ content ++ "==================")
   end
   else print-line "  (no plan file yet. Use 'codex-agent plan add <task>' to start.)"

  do-plan-add-join : List Text -> Integer -> Text
  do-plan-add-join (args) (idx) =
   if idx >= list-length args then ""
   else if idx == 3 then list-at args idx ++ do-plan-add-join args (idx + 1)
   else " " ++ list-at args idx ++ do-plan-add-join args (idx + 1)

  do-plan-clear : [Console, FileSystem, Process] Nothing
  do-plan-clear = act
   _ <- ensure-codex-agent-dir
   _ <- write-file plan-file ""
   print-line "  Plan cleared."
  end

  do-plan-add : List Text -> [Console, FileSystem, Process] Nothing
  do-plan-add (args) =
   if list-length args < 4 then print-line "Usage: codex-agent plan add <task description>"
   else act
    _ <- ensure-codex-agent-dir
    existing <- if file-exists plan-file then read-file plan-file else ""
    let task = do-plan-add-join args 3
    in let new-content = if text-length existing == 0 then "- " ++ task ++ "\n" else existing ++ "- " ++ task ++ "\n"
    in act
       _ <- write-file plan-file new-content
       print-line ("  Added: " ++ task)
      end
   end

  do-plan : List Text -> [Console, FileSystem, Process] Nothing
  do-plan (args) =
   let argc = list-length args
   in if argc < 3 then do-plan-show
    else when parse-plan-action (list-at args 2)
     is PlanShow -> do-plan-show
     is PlanClear -> do-plan-clear
     is PlanAdd -> do-plan-add args
     is PlanUnknown (a) -> print-line ("Unknown plan action: " ++ a ++ ". Use add, show, or clear.")

Section: Handoff

  valid-transition : HandoffState -> HandoffState -> Boolean
  valid-transition (from-state) (to-state) =
   when from-state
    is StateDraft -> when to-state
     is StateAwaitingReview -> True
     is otherwise -> False
    is StateAwaitingReview -> when to-state
     is StateUnderReview -> True
     is StateAbandoned -> True
     is otherwise -> False
    is StateUnderReview -> when to-state
     is StateApproved -> True
     is StateChangesRequested -> True
     is StateAbandoned -> True
     is otherwise -> False
    is StateChangesRequested -> when to-state
     is StateAwaitingReview -> True
     is StateAbandoned -> True
     is otherwise -> False
    is StateApproved -> when to-state
     is StateMerged -> True
     is StateAbandoned -> True
     is otherwise -> False
    is StateAbandoned -> when to-state
     is StateAwaitingReview -> True
     is otherwise -> False
    is StateMerged -> when to-state
     is StateAwaitingReview -> True
     is otherwise -> False
    is otherwise -> False

  next-action-hint : HandoffState -> Text
  next-action-hint (state) =
   when state
    is StateDraft -> "Author: run 'handoff push <summary>' to request review"
    is StateAwaitingReview -> "Reviewer: run 'handoff review' to begin review"
    is StateUnderReview -> "Reviewer: run 'handoff approve' or 'handoff request-changes <reason>'"
    is StateChangesRequested -> "Author: fix issues, then 'handoff push <summary>' to re-request review"
    is StateApproved -> "Anyone: run 'handoff merge' to merge to master"
    is StateMerged -> "Done. Merge complete."
    is StateAbandoned -> "Abandoned. No action needed."
    is StateUnknown (t) -> "Unknown state."

  make-handoff-content : Text -> Text -> Text -> Text -> Text
  make-handoff-content (branch) (agent) (summary) (state) =
   "state=" ++ state ++ "\nbranch=" ++ branch ++ "\nauthor=" ++ agent ++ "\nreviewer=\nsummary=" ++ summary ++ "\nupdated=see-git-log\nnotes=\n"

  read-handoff-or-empty : [FileSystem, Process] Text
  read-handoff-or-empty = if file-exists handoff-file then read-file handoff-file else ""

  do-handoff-show : [Console, FileSystem, Process] Nothing
  do-handoff-show =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let state = parse-handoff-state state-text
    in let branch = kv-get "branch" lines 0
    in let author = kv-get "author" lines 0
    in let reviewer = kv-get "reviewer" lines 0
    in let summary = kv-get "summary" lines 0
    in let updated = kv-get "updated" lines 0
    in let notes = kv-get "notes" lines 0
    in print-line ("=== Handoff ===\n  State:    " ++ state-text ++ "\n  Branch:   " ++ branch ++ "\n  Author:   " ++ author ++ "\n  Reviewer: " ++ (if text-length reviewer == 0 then "(none yet)" else reviewer) ++ "\n  Summary:  " ++ summary ++ "\n  Updated:  " ++ updated ++ "\n  Notes:    " ++ notes ++ "\n  Next:     " ++ next-action-hint state ++ "\n===============")
   end
   else print-line "  No active handoff. Use 'codex-agent handoff push <summary>' to create one."

  do-handoff-push : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-push (args) =
   let argc = list-length args
   in if argc < 4 then print-line "Usage: codex-agent handoff push <summary>"
    else act
     branch <- get-current-branch
     agent <- detect-agent
     old-content <- read-handoff-or-empty
     let summary = collect-args args 3 3
     in let old-lines = text-split old-content "\n"
     in let old-state-text = kv-get "state" old-lines 0
     in let from-state = if text-length old-state-text == 0 then StateDraft else parse-handoff-state old-state-text
     in if valid-transition from-state StateAwaitingReview == False then print-line ("  ERROR: cannot transition from '" ++ old-state-text ++ "' to 'awaiting-review'")
          else let new-content = make-handoff-content branch agent summary "awaiting-review"
          in act
            _ <- write-file handoff-file new-content
            _ <- run-process "git" ("add " ++ handoff-file)
            _ <- run-process "git" ("commit -m \"handoff: " ++ summary ++ "\"")
            print-line ("  Handoff created: awaiting-review\n  Branch:  " ++ branch ++ "\n  Author:  " ++ agent ++ "\n  Summary: " ++ summary ++ "\n  Next: push branch to origin, then another agent runs 'handoff review'")
           end
    end

  do-handoff-review : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-review (args) =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    agent <- detect-agent
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let state = parse-handoff-state state-text
    in if valid-transition state StateUnderReview == False then print-line ("  ERROR: cannot review from state '" ++ state-text ++ "' (need awaiting-review)")
        else let new-content = kv-set "state" "under-review" (kv-set "reviewer" agent content)
        in act
          _ <- write-file handoff-file new-content
          let branch = kv-get "branch" lines 0
          in let summary = kv-get "summary" lines 0
          in print-line ("  Review started\n  Branch:   " ++ branch ++ "\n  Summary:  " ++ summary ++ "\n  Reviewer: " ++ agent ++ "\n  Next: build, test, review code, then 'handoff approve' or 'handoff request-changes <reason>'")
         end
   end
   else print-line "  No handoff found. Nothing to review."

  do-handoff-approve : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-approve (args) =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let state = parse-handoff-state state-text
    in if valid-transition state StateApproved == False then print-line ("  ERROR: cannot approve from state '" ++ state-text ++ "' (need under-review)")
        else let new-content = kv-set "state" "approved" content
        in act
          _ <- write-file handoff-file new-content
          let branch = kv-get "branch" lines 0
          in print-line ("  APPROVED\n  Branch: " ++ branch ++ "\n  Next: run 'handoff merge' to merge to master and clean up")
         end
   end
   else print-line "  No handoff found."

  do-handoff-request-changes : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-request-changes (args) =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let state = parse-handoff-state state-text
    in if valid-transition state StateChangesRequested == False then print-line ("  ERROR: cannot request changes from state '" ++ state-text ++ "' (need under-review)")
        else let reason = if list-length args > 3 then collect-args args 3 3 else "(no reason given)"
        in let new-content = kv-set "state" "changes-requested" (kv-set "notes" reason content)
        in act
           _ <- write-file handoff-file new-content
           let branch = kv-get "branch" lines 0
           in print-line ("  CHANGES REQUESTED\n  Branch: " ++ branch ++ "\n  Reason: " ++ reason ++ "\n  Next: author fixes issues, then 'handoff push <summary>'")
          end
   end
   else print-line "  No handoff found."

  do-handoff-merge : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-merge (args) =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let state = parse-handoff-state state-text
    in if valid-transition state StateMerged == False then print-line ("  ERROR: cannot merge from state '" ++ state-text ++ "' (need approved)")
        else let branch = kv-get "branch" lines 0
        in let summary = kv-get "summary" lines 0
        in let author = kv-get "author" lines 0
        in let reviewer = kv-get "reviewer" lines 0
        in let merge-msg = "merge: " ++ branch ++ " -- " ++ summary ++ " (author: " ++ author ++ ", reviewer: " ++ reviewer ++ ")"
        in act
              _ <- write-file handoff-file (kv-set "state" "merged" content)
              _ <- run-process "git" "checkout master"
              _ <- run-process "git" ("merge " ++ branch ++ " --no-ff -m \"" ++ merge-msg ++ "\"")
              print-line ("  MERGED to master\n  Commit: " ++ merge-msg ++ "\n  Next: push master")
             end
   end
   else print-line "  No handoff found."

  do-handoff-abandon : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff-abandon (args) =
   if file-exists handoff-file then act
    content <- read-file handoff-file
    let lines = text-split content "\n"
    in let state-text = kv-get "state" lines 0
    in let new-content = kv-set "state" "abandoned" content
    in act
        _ <- write-file handoff-file new-content
        let branch = kv-get "branch" lines 0
        in print-line ("  ABANDONED\n  Branch: " ++ branch ++ "\n  Previous state: " ++ state-text)
       end
   end
   else print-line "  No handoff found."

  do-handoff : List Text -> [Console, FileSystem, Process] Nothing
  do-handoff (args) =
   let argc = list-length args
   in if argc < 3 then do-handoff-show
    else when parse-handoff-action (list-at args 2)
     is HandoffShow -> do-handoff-show
     is HandoffPush -> do-handoff-push args
     is HandoffReview -> do-handoff-review args
     is HandoffApprove -> do-handoff-approve args
     is HandoffRequestChanges -> do-handoff-request-changes args
     is HandoffMerge -> do-handoff-merge args
     is HandoffAbandon -> do-handoff-abandon args
     is HandoffUnknown (a) -> print-line ("Unknown handoff action: " ++ a ++ ". Use show, push, review, approve, request-changes, merge, or abandon.")

Section: Logging

  do-log : List Text -> [Console, FileSystem, Process] Nothing
  do-log (args) =
   let argc = list-length args
   in if argc < 3 then print-line "Usage: codex-agent log <message>"
    else act
     _ <- ensure-codex-agent-dir
     existing <- if file-exists log-file then read-file log-file else ""
     let msg = collect-args args 2 2
     in let entry = "[LOG] " ++ msg
     in act
        _ <- write-file log-file (existing ++ entry ++ "\n")
        print-line ("  Logged: " ++ msg)
       end
    end

Section: Recall

  do-recall : List Text -> [Console, FileSystem, Process] Nothing
  do-recall (args) =
   if file-exists log-file then act
    content <- read-file log-file
    if text-length content == 0 then print-line "  (session log is empty)"
    else let lines = text-split content "\n"
    in let raw-total = list-length lines
    in let total = if raw-total > 0 then raw-total - 1 else 0
    in let n = if list-length args > 2 then parse-int-or (list-at args 2) 10 else 10
    in let start = if total > n then total - n else 0
    in print-line ("=== Session Log (last " ++ integer-to-text n ++ ") ===\n" ++ take-last-n lines 0 start total ++ "\n===========================")
   end
   else print-line "  (no session log yet. Use 'codex-agent log <msg>' or run build/test.)"

Section: Doctor

  count-error-lines : List Text -> Integer -> Integer -> Integer
  count-error-lines (lines) (idx) (acc) =
   if idx >= list-length lines then acc
   else let line = list-at lines idx
   in let has-error = text-contains line ": error "
   in count-error-lines lines (idx + 1) (if has-error then acc + 1 else acc)

  count-warning-lines : List Text -> Integer -> Integer -> Integer
  count-warning-lines (lines) (idx) (acc) =
   if idx >= list-length lines then acc
   else let line = list-at lines idx
   in let has-warn = text-contains line ": warning "
   in count-warning-lines lines (idx + 1) (if has-warn then acc + 1 else acc)

  first-error-line : List Text -> Integer -> Text
  first-error-line (lines) (idx) =
   if idx >= list-length lines then ""
   else let line = list-at lines idx
   in if text-contains line ": error " then line
     else first-error-line lines (idx + 1)

  has-succeeded : List Text -> Integer -> Boolean
  has-succeeded (lines) (idx) =
   if idx >= list-length lines then False
   else let line = list-at lines idx
   in if text-contains line "Build succeeded" then True
    else if text-contains line "succeeded" then
     if text-contains line "0 failed" then True else has-succeeded lines (idx + 1)
    else has-succeeded lines (idx + 1)

  has-test-failure : List Text -> Integer -> Boolean
  has-test-failure (lines) (idx) =
   if idx >= list-length lines then False
   else let line = list-at lines idx
   in if text-contains line "Failed!" then True
    else has-test-failure lines (idx + 1)

  has-any-test-result : List Text -> Integer -> Boolean
  has-any-test-result (lines) (idx) =
   if idx >= list-length lines then False
   else let line = list-at lines idx
   in if text-contains line "Passed!" then True
    else if text-contains line "Failed!" then True
    else has-any-test-result lines (idx + 1)

  count-test-passed : List Text -> Integer -> Text
  count-test-passed (lines) (idx) =
   if idx >= list-length lines then "?"
   else let line = list-at lines idx
   in if text-contains line "Passed" then line
    else if text-contains line "Failed" then line
    else count-test-passed lines (idx + 1)

  count-condition-headers : List Text -> Integer -> Integer -> Integer
  count-condition-headers (lines) (idx) (acc) =
   if idx >= list-length lines then acc
   else let line = list-at lines idx
   in let is-header = text-starts-with line "### "
   in count-condition-headers lines (idx + 1) (if is-header then acc + 1 else acc)

  collect-condition-summaries : List Text -> Integer -> Text
  collect-condition-summaries (lines) (idx) =
   if idx >= list-length lines then ""
   else let line = list-at lines idx
   in let rest = collect-condition-summaries lines (idx + 1)
   in if text-starts-with line "### " then
      "  * " ++ line ++ "\n" ++ rest
     else rest

  cs5001-check-for : Text -> [FileSystem, Process] Text
  cs5001-check-for (csproj-path) =
   if file-exists csproj-path then act
    csproj <- read-file csproj-path
    if text-contains csproj "<OutputType>Exe</OutputType>" then "  CS5001 trap: ACTIVE (Codex.Codex is Exe, will emit CS5001 -- this is expected)"
    else "  CS5001 trap: cleared"
   end
   else "  CS5001 trap: n/a (no Codex.Codex project)"

  session-status-line : [FileSystem, Process] Text
  session-status-line =
   if file-exists log-file then act
    log-content <- read-file log-file
    "  Session log: " ++ integer-to-text (count-lines log-content) ++ " entries"
   end
   else "  Session log: (none -- new session)"

  last-build-status-line : [FileSystem, Process] Text
  last-build-status-line =
   if file-exists build-log then act
    bc <- read-file build-log
    "  Last build: " ++ integer-to-text (count-error-lines (text-split bc "\n") 0 0) ++ " errors (see " ++ build-log ++ ")"
   end
   else "  Last build: (no record)"

  last-test-status-line : [FileSystem, Process] Text
  last-test-status-line =
   if file-exists test-log then act
    tc <- read-file test-log
    "  Last test: " ++ count-test-passed (text-split tc "\n") 0 ++ " (see " ++ test-log ++ ")"
   end
   else "  Last test: (no record)"

  handoff-status-line : [FileSystem, Process] Text
  handoff-status-line =
   if file-exists handoff-file then act
    hc <- read-file handoff-file
    let hl = text-split hc "\n"
    in let hs-text = kv-get "state" hl 0
    in let hb = kv-get "branch" hl 0
    in "  Handoff: " ++ hs-text ++ " on " ++ hb ++ " -- " ++ next-action-hint (parse-handoff-state hs-text)
   end
   else "  Handoff: (none active)"

  do-doctor : List Text -> [Console, FileSystem, Process] Nothing
  do-doctor (args) = act
   kc-body <- if file-exists known-conditions-file then read-file known-conditions-file else ""
   cs5001-check <- cs5001-check-for (repo-path "Codex.Codex/Codex.Codex.csproj")
   session-status <- session-status-line
   last-build-status <- last-build-status-line
   last-test-status <- last-test-status-line
   handoff-status <- handoff-status-line
   let kc-status = if file-exists known-conditions-file then "found" else "MISSING"
   in let kc-lines = if text-length kc-body > 0 then text-split kc-body "\n" else text-split "" "\n"
   in let n-conditions = count-condition-headers kc-lines 0 0
   in let summaries = collect-condition-summaries kc-lines 0
   in print-line ("=== Doctor -- Known Conditions & Diagnostics ===\n" ++ "  Conditions file: " ++ kc-status ++ " (" ++ integer-to-text n-conditions ++ " known)\n" ++ summaries ++ cs5001-check ++ "\n" ++ session-status ++ "\n" ++ last-build-status ++ "\n" ++ last-test-status ++ "\n" ++ handoff-status ++ "\n" ++ "  Advice: CS5001 in Codex.Codex is PRE-EXISTING. Do NOT investigate.\n" ++ "  Advice: Do NOT extract effectful helper functions in .codex -- inline instead.\n" ++ "  Advice: After editing .codex files, check for else->then corruption.\n" ++ "  Advice: ALWAYS snap save before editing. edit_file has deleted code from files in this repo. See TEF-009.\n" ++ "  See: docs/KNOWN-CONDITIONS.md for full details.\n" ++ "================================================")
  end

Section: Cognitive Check

  default-budget : Integer = 60000

  agent-label : Text -> Text
  agent-label (name) =
   if name == "windows" then "Agent Windows (VS)"
   else if name == "linux" then "Agent Linux (Claude sandbox)"
   else "unknown agent (using default 60K budget)"

  check-level : Integer -> LoadLevel
  check-level (pct) =
   if pct > 90 then LoadRed
   else if pct > 70 then LoadOrange
   else if pct > 40 then LoadYellow
   else LoadGreen

  load-level-text : LoadLevel -> Text
  load-level-text (ll) =
   when ll
    is LoadRed -> "RED - overloaded, build and verify NOW"
    is LoadOrange -> "ORANGE - high load, finish current task then build"
    is LoadYellow -> "YELLOW - moderate, stay focused"
    is LoadGreen -> "GREEN - plenty of headroom"

  plan-status-line : [FileSystem, Process] Text
  plan-status-line =
   if file-exists plan-file then act
    planc <- read-file plan-file
    if text-length planc == 0 then "  Plan: (empty)"
    else "  Plan: " ++ integer-to-text (list-length (text-split planc "\n") - 1) ++ " tasks"
   end
   else "  Plan: (none)"

  do-check : List Text -> [Console, FileSystem, Process] Nothing
  do-check (args) = act
   pc <- read-if-exists (repo-path "Codex.Codex/Syntax/Parser.codex")
   tc <- read-if-exists (repo-path "Codex.Codex/Types/TypeChecker.codex")
   ec <- read-if-exists (repo-path "Codex.Codex/Emit/CSharpEmitter.codex")
   lc <- read-if-exists (repo-path "Codex.Codex/IR/Lowering.codex")
   uc <- read-if-exists (repo-path "Codex.Codex/Types/Unifier.codex")
   xc <- read-if-exists (repo-path "Codex.Codex/Syntax/Lexer.codex")
   plan-status <- plan-status-line
   let argc = list-length args
   in let name = if argc > 2 then list-at args 2 else "unknown"
   in let budget = default-budget
   in let label = agent-label name
   in let parser-chars = text-length pc
   in let tc-chars = text-length tc
   in let emitter-chars = text-length ec
   in let lowering-chars = text-length lc
   in let unifier-chars = text-length uc
   in let lexer-chars = text-length xc
   in let total-hot = parser-chars + tc-chars + emitter-chars + lowering-chars + unifier-chars + lexer-chars
   in let pct = (total-hot * 100) / budget
   in let level = load-level-text (check-level pct)
   in print-line ("=== Cognitive Check ===\n" ++ "  Agent:  " ++ label ++ "\n" ++ "  Hot path files: " ++ integer-to-text total-hot ++ " chars / " ++ integer-to-text budget ++ " budget (" ++ integer-to-text pct ++ "%)\n" ++ "  Load: " ++ level ++ "\n" ++ "  Parser.codex:       " ++ pad-left (integer-to-text parser-chars) 6 ++ " chars\n" ++ "  TypeChecker.codex:  " ++ pad-left (integer-to-text tc-chars) 6 ++ " chars\n" ++ "  CSharpEmitter.codex:" ++ pad-left (integer-to-text emitter-chars) 6 ++ " chars\n" ++ "  Lowering.codex:     " ++ pad-left (integer-to-text lowering-chars) 6 ++ " chars\n" ++ "  Unifier.codex:      " ++ pad-left (integer-to-text unifier-chars) 6 ++ " chars\n" ++ "  Lexer.codex:        " ++ pad-left (integer-to-text lexer-chars) 6 ++ " chars\n" ++ plan-status ++ "\n" ++ "=======================")
  end

Section: Build

  do-build : List Text -> [Console, FileSystem, Process] Nothing
  do-build (args) = act
   _ <- ensure-codex-agent-dir
   output <- run-process "dotnet" "build Codex.sln --verbosity quiet"
   _ <- write-file build-log output
   log-existing <- read-if-exists log-file
   verify-output <- run-process "pwsh" "-File tools/codex-agent-verify.ps1 docs/CurrentPlan.md docs/Active/ToDo/CSharpCleanup.md docs/Agents/TOOL-ERROR-REGISTRY.md docs/KNOWN-CONDITIONS.md CONTRIBUTING.md"
   let lines = text-split output "\n"
   in let errs = count-error-lines lines 0 0
   in let warns = count-warning-lines lines 0 0
   in let status = if has-succeeded lines 0 then "PASS" else "FAIL"
   in let first-err = if errs > 0 then "\n  First error: " ++ first-error-line lines 0 else ""
   in let summary = "=== Build " ++ status ++ " === errors: " ++ integer-to-text errs ++ "  warnings: " ++ integer-to-text warns ++ first-err ++ "\n  Full log: " ++ build-log
   in let log-entry = "[BUILD] " ++ status ++ " errors=" ++ integer-to-text errs ++ " warnings=" ++ integer-to-text warns
   in act
           _ <- write-file log-file (log-existing ++ log-entry ++ "\n")
           print-line (summary ++ "\n" ++ verify-output)
          end
  end

Section: Test

  do-test : List Text -> [Console, FileSystem, Process] Nothing
  do-test (args) =
   let argc = list-length args
   in let extra = if argc > 2 then " --filter " ++ list-at args 2 else ""
   in act
     _ <- ensure-codex-agent-dir
     output <- run-process "dotnet" ("test Codex.sln --verbosity quiet" ++ extra)
     _ <- write-file test-log output
     log-existing <- read-if-exists log-file
     let lines = text-split output "\n"
     in let errs = count-error-lines lines 0 0
     in let test-line = count-test-passed lines 0
     in let status = if errs > 0 then "BUILD-FAIL"
                        else if has-any-test-result lines 0 then
                         if has-test-failure lines 0 then "FAIL" else "PASS"
                        else "FAIL"
     in let first-err = if errs > 0 then "\n  First error: " ++ first-error-line lines 0 else ""
     in let summary = "=== Test " ++ status ++ " === " ++ test-line ++ first-err ++ "\n  Full log: " ++ test-log
     in let log-entry = "[TEST] " ++ status ++ " " ++ test-line
     in act
             _ <- write-file log-file (log-existing ++ log-entry ++ "\n")
             print-line summary
            end
    end

Section: Agent Registry

  do-greet : List Text -> [Console, FileSystem, Process] Nothing
  do-greet (args) =
   let argc = list-length args
   in if argc < 3 then print-line "Usage: codex-agent greet <name> <context> <tools> <os> <workdir>"
    else act
     _ <- if file-exists agents-dir then "" else run-process "pwsh" ("-Command New-Item -ItemType Directory -Force -Path " ++ agents-dir)
     dotnet-ver <- run-process "dotnet" "--version"
     workdir-val <- if argc > 6 then list-at args 6 else current-dir
     let name = list-at args 2
     in let ctx = if argc > 3 then list-at args 3 else ""
     in let tools-val = if argc > 4 then list-at args 4 else ""
     in let os-val = if argc > 5 then list-at args 5 else ""
     in let content = "agent=" ++ name ++ "\ncontext=" ++ ctx ++ "\ntools=" ++ tools-val ++ "\nos=" ++ os-val ++ "\nworkdir=" ++ workdir-val ++ "\ndotnet=" ++ dotnet-ver ++ "last-seen=see-git-log\n"
     in act
           _ <- write-file (agent-file name) content
           print-line ("  Agent registered: " ++ name ++ "\n  Context: " ++ (if text-length ctx > 0 then ctx else "(default)") ++ "\n  Tools: " ++ (if text-length tools-val > 0 then tools-val else "(none)") ++ "\n  OS: " ++ (if text-length os-val > 0 then os-val else "(unknown)") ++ "\n  Workdir: " ++ workdir-val)
          end
    end

  format-agent-entry : Text -> Text
  format-agent-entry (content) =
   let lines = text-split content "\n"
   in let name = kv-get "agent" lines 0
   in let ctx = kv-get "context" lines 0
   in let tools-val = kv-get "tools" lines 0
   in let os-val = kv-get "os" lines 0
   in let workdir-val = kv-get "workdir" lines 0
   in "  " ++ pad-right name 16 ++ "  " ++ pad-right (if text-length ctx > 0 then ctx else "?") 44 ++ "  " ++ pad-right os-val 40 ++ "  " ++ pad-right tools-val 44 ++ "  " ++ workdir-val

  format-roster-loop : List Text -> Integer -> [FileSystem, Process] Text
  format-roster-loop (files) (idx) =
   if idx >= list-length files then ""
   else act
    content <- read-file (list-at files idx)
    rest <- format-roster-loop files (idx + 1)
    let entry = format-agent-entry content
    in if text-length rest == 0 then entry
      else entry ++ "\n" ++ rest
   end

  do-roster : List Text -> [Console, FileSystem, Process] Nothing
  do-roster (args) = act
   files <- list-files agents-dir "*.txt"
   if list-length files == 0 then print-line "  No agents registered. Use 'codex-agent greet <name>' to register."
   else act
    entries <- format-roster-loop files 0
    let header = "=== Agent Roster ==="
    in print-line (header ++ "\n" ++ entries ++ "\n=====================")
   end
  end

Section: Orient

  plan-info-line : Text -> [FileSystem, Process] Text
  plan-info-line (plan-doc) =
   if file-exists plan-doc then act
    pc <- read-file plan-doc
    let pl = text-split pc "\n"
    in "  Current plan: " ++ plan-doc ++ " (" ++ integer-to-text (list-length pl) ++ " lines)"
   end
   else "  Current plan: (none)"

  orient-level0 : [Console, FileSystem, Process] Nothing
  orient-level0 = act
    plan-doc <- repo-path "docs/CurrentPlan.md"
    agents-dir-val <- agents-dir
    roster-files <- list-files agents-dir-val "*.txt"
    roster-info <- if list-length roster-files > 0 then format-roster-loop roster-files 0
     else "  (none registered -- use 'codex-agent greet <name>')"
    plan-info <- plan-info-line plan-doc
    print-line (
    "=== Codex Project — Quick Orientation ===\n" ++
    "\n" ++
    "  Language:  Self-hosting compiler, .codex source, ML-family syntax\n" ++
    "  Pipeline:  Lexer -> Parser -> Desugarer -> NameResolver -> TypeChecker -> Lowering -> Emitter\n" ++
    "  Backends:  15 (C#, JS, Python, Rust, C++, Go, Java, Ada, Fortran, COBOL, IL, RISC-V, ARM64, x86-64, WASM)\n" ++
    "  Tests:     900+, run with: dotnet test Codex.sln\n" ++
    "  Build:     dotnet build Codex.sln (.NET 8, TreatWarningsAsErrors)\n" ++
    "  Self-host: 26 .codex files in Codex.Codex/\n" ++
    "\n" ++
    "  Bootstrap: Three separate fixed-point proofs. See docs/CodexBootstrap.png.\n" ++
    "    1   (.NET, C# output):        self-host under dotnet, stage1 == stage3.\n" ++
    "    1.1 (.NET, Codex-text out):   self-host under dotnet, stage1 == stage2.\n" ++
    "    2   (BARE-METAL, Codex-text): the real pingpong. ELF under QEMU.\n" ++
    "        Requires BOTH sem-equiv(source, stage1)=PASS AND stage1 == stage2.\n" ++
    "        Run: wsl bash tools/pingpong-self.sh (legacy: tools/pingpong.sh)\n" ++
    "    3   (BARE-METAL, binary out): self-compiled ELF byte-identical. Not yet green (MM4 Phase 8).\n" ++
    "    Truth table: bootstraps 1 and 1.1 do NOT prove bootstrap 2 (pingpong).\n" ++
    "    Verification artefacts: docs/Test/ (source.codex, bootstrap1-*, bootstrap1.1-*, bootstrap2-*).\n" ++
    "\n" ++
    "  Agents:\n" ++ roster-info ++ "\n" ++
    "\n" ++
    plan-info ++ "\n" ++
    "\n" ++
    "  Key docs:\n" ++
    "    ** VISION:    docs/FOUNDING-VISION.md  (READ THIS FIRST) **\n" ++
    "    Overview:     docs/00-OVERVIEW.md\n" ++
    "    Principles:   docs/10-PRINCIPLES.md\n" ++
    "    Syntax:       docs/SYNTAX-QUICKREF.md\n" ++
    "    Pitfalls:     docs/KNOWN-CONDITIONS.md\n" ++
    "    Tool errors:  docs/Agents/TOOL-ERROR-REGISTRY.md\n" ++
    "    Code style:   CONTRIBUTING.md\n" ++
    "    Route map:    docs/Stories/THE-LAST-PEAK.md\n" ++
    "\n" ++
    "  Project structure:\n" ++
    "    Core -> Syntax -> Ast -> Semantics -> Types -> IR -> Emit -> Emit.* -> Cli\n" ++
    "    Codex.Core has zero deps (root). Codex.Cli references everything.\n" ++
    "\n" ++
    "  Topics (use 'orient <topic>' for detail):\n" ++
    "    vision, syntax, pipeline, agents, style, git, tools, structure, pitfalls\n" ++
    "\n" ++
    "=========================================")
   end

  print-topic-file : Text -> [Console, FileSystem, Process] Nothing
  print-topic-file (rel) = act
   p <- repo-path rel
   if file-exists p then act
     content <- read-file p
     print-line content
    end
    else print-line ("  " ++ p ++ " not found")
  end

  style-topic-text : Text =
   "=== Code Style Quick Reference ===\n" ++
   "\n" ++
   "  C#:\n" ++
   "    Private fields: m_ prefix (m_diagnostics)\n" ++
   "    Properties/types: PascalCase. Locals: camelCase.\n" ++
   "    sealed record for immutable ref. readonly record struct for values.\n" ++
   "    No XML doc comments (///). No var. No unused fields.\n" ++
   "    Prefer Map<K,V> (Codex.Core) over ImmutableDictionary.\n" ++
   "    4 spaces, UTF-8, max 120 chars/line. TreatWarningsAsErrors.\n" ++
   "\n" ++
   "  Codex (.codex):\n" ++
   "    Booleans: True / False (capital T/F)\n" ++
   "    Application: left-assoc, f x y = (f x) y\n" ++
   "    Pattern matching: when/if, not match/case\n" ++
   "    All functions curried. Effects in brackets: [Console] Nothing\n" ++
   "    Do NOT extract effectful helper functions — inline instead.\n" ++
   "\n" ++
   "  Full details: CONTRIBUTING.md\n" ++
   "================================="

  git-topic-text : Text =
   "=== Git Workflow ===\n" ++
   "  Branch naming: windows/<topic>, linux/<topic>, nut/<topic>, hex/<topic>\n" ++
   "  Conventional Commits: feat:, fix:, docs:, test:, chore:, refactor:\n" ++
   "  No agent merges own work to master without review.\n" ++
   "  Handoff: codex-agent handoff push/review/approve/merge\n" ++
   "==================="

  tools-topic-text : Text =
   "=== Agent Toolkit ===\n" ++
   "  Runs natively: tools/codex-agent/codex-agent.exe <command> <args>\n" ++
   "  Or via dotnet: dotnet tools/codex-agent/codex-agent.dll <command> <args>\n" ++
   "\n" ++
   "  codex-agent   Main toolkit (init, build, test, doctor, handoff, peek, stat, snap, etc.)\n" ++
   "  codex-status  Status line helper (separate binary)\n" ++
   "\n" ++
   "  Run 'codex-agent help' for full command list.\n" ++
   "===================="

  structure-topic-text : Text =
   "=== Project Structure ===\n" ++
   "  Dependency flow (one way):\n" ++
   "    Core -> Syntax -> Ast -> Semantics -> Types -> IR -> Emit -> Emit.* -> Cli\n" ++
   "\n" ++
   "  Codex.Core      Zero deps (root). Map<K,V>, ValueMap, SourceSpan.\n" ++
   "  Codex.Syntax    Lexer + Parser. Token, SyntaxTree.\n" ++
   "  Codex.Ast       AST nodes. Expression, Declaration.\n" ++
   "  Codex.Semantics Name resolution. NameResolver, Scope.\n" ++
   "  Codex.Types     Type checking + inference. TypeChecker, Unifier.\n" ++
   "  Codex.IR        IR lowering. IRModule, IRNode.\n" ++
   "  Codex.Emit      Emitter interface. ICodeEmitter.\n" ++
   "  Codex.Emit.*    15 backend emitters (CSharp, IL, RiscV, Arm64, etc.)\n" ++
   "  Codex.Cli       Composition root. build/run/repl/bootstrap commands.\n" ++
   "\n" ++
   "  Self-hosted: 26 .codex files in Codex.Codex/\n" ++
   "  Bootstrap:   tools/Codex.Bootstrap/\n" ++
   "  Tests:       Codex.Core.Tests, Codex.Syntax.Tests, etc.\n" ++
   "========================"

  pipeline-topic-text : Text =
   "=== Compiler Pipeline ===\n" ++
   "  Source (.codex)\n" ++
   "    |-> Lexer      tokenizes source text\n" ++
   "    |-> Parser     builds syntax tree\n" ++
   "    |-> Desugarer  expands syntactic sugar\n" ++
   "    |-> NameResolver  resolves identifiers to bindings\n" ++
   "    |-> TypeChecker   Hindley-Milner inference + effect tracking\n" ++
   "    |-> Lowering      AST -> IR (IRModule, IRNode)\n" ++
   "    |-> Emitter       IR -> target code\n" ++
   "\n" ++
   "  Hot path files (self-hosted):\n" ++
   "    Codex.Codex/Syntax/Lexer.codex\n" ++
   "    Codex.Codex/Syntax/Parser.codex\n" ++
   "    Codex.Codex/Types/TypeChecker.codex\n" ++
   "    Codex.Codex/Types/Unifier.codex\n" ++
   "    Codex.Codex/IR/Lowering.codex\n" ++
   "    Codex.Codex/Emit/CSharpEmitter.codex\n" ++
   "========================="

  do-orient-agents : [Console, FileSystem, Process] Nothing
  do-orient-agents = act
   agent-files <- list-files agents-dir "*.txt"
   if list-length agent-files > 0 then act
    entries <- format-roster-loop agent-files 0
    print-line ("=== Agent Roster (detailed) ===\n" ++ entries ++ "\n\n  Register: codex-agent greet <name> <context> <tools> <os> <workdir>\n" ++ "  Branch prefixes: windows/, linux/, nut/, hex/\n" ++ "  No agent merges own work to master without review.\n" ++ "==============================")
   end
   else print-line "  No agents registered. Use 'codex-agent greet <name>'."
  end

  orient-topic : OrientTopic -> [Console, FileSystem, Process] Nothing
  orient-topic (topic) =
   when topic
    is TopicVision -> print-topic-file "docs/FOUNDING-VISION.md"
    is TopicSyntax -> print-topic-file "docs/SYNTAX-QUICKREF.md"
    is TopicPitfalls -> print-topic-file "docs/KNOWN-CONDITIONS.md"
    is TopicStyle -> print-line style-topic-text
    is TopicAgents -> do-orient-agents
    is TopicGit -> print-line git-topic-text
    is TopicTools -> print-line tools-topic-text
    is TopicStructure -> print-line structure-topic-text
    is TopicPipeline -> print-line pipeline-topic-text
    is TopicUnknown (t) -> print-line ("  Unknown topic: " ++ t ++ ". Available: vision, syntax, pipeline, agents, style, git, tools, structure, pitfalls")

  do-orient : List Text -> [Console, FileSystem, Process] Nothing
  do-orient (args) =
   let argc = list-length args
   in if argc < 3 then orient-level0
    else orient-topic (parse-orient-topic (list-at args 2))

Section: Init

  do-init : List Text -> [Console, FileSystem, Process] Nothing
  do-init (args) = act
   agent <- repo-path "tools/codex-agent/codex-agent.dll"
   verify-script <- repo-path "tools/codex-agent-verify.ps1"
   plan-path <- repo-path "docs/CurrentPlan.md"
   cleanup-path <- repo-path "docs/Active/ToDo/CSharpCleanup.md"
   registry-path <- repo-path "docs/Agents/TOOL-ERROR-REGISTRY.md"
   conditions-path <- repo-path "docs/KNOWN-CONDITIONS.md"
   contributing-path <- repo-path "CONTRIBUTING.md"
   let verify-files = plan-path ++ " " ++ cleanup-path ++ " " ++ registry-path ++ " " ++ conditions-path ++ " " ++ contributing-path
   in act
    doctor-out <- run-process "dotnet" (agent ++ " doctor")
    check-out <- run-process "dotnet" (agent ++ " check")
    status-out <- run-process "dotnet" (agent ++ " status")
    handoff-out <- run-process "dotnet" (agent ++ " handoff show")
    verify-out <- run-process "pwsh" ("-File " ++ verify-script ++ " " ++ verify-files)
    git-log <- run-process "git" "log --oneline -5"
    git-branches <- run-process "git" "branch -r"
    print-line (doctor-out ++ "\n" ++ check-out ++ "\n" ++ status-out ++ "\n" ++ handoff-out ++ "\n" ++ verify-out ++ "\n=== Recent Commits ===\n" ++ git-log ++ "\n=== Remote Branches ===\n" ++ git-branches)
   end
  end

Section: Help

  print-help : [Console] Nothing
  print-help =
   print-line (
    "codex-agent - Codex compiler toolkit for AI agents\n" ++
    "\n" ++
    "Commands:\n" ++
    "  peek <file> [start] [end]          Read file lines safely\n" ++
    "  stat <file> [file2] ...            File statistics (lines, chars)\n" ++
    "  snap save <file>                   Snapshot before editing\n" ++
    "  snap diff <file>                   Compare file to snapshot\n" ++
    "  snap restore <file>                Restore from snapshot\n" ++
    "  status                             Project status check\n" ++
    "  plan [add <task>|show|clear]       Task list (survives context loss)\n" ++
    "  check [agent]                      Cognitive load estimate (windows|linux; others use default budget)\n" ++
    "  doctor                             Known conditions & diagnostics briefing\n" ++
    "  handoff [show]                     Show current handoff state\n" ++
    "  handoff push <summary>             Create/update handoff, request review\n" ++
    "  handoff review                     Pick up handoff for review\n" ++
    "  handoff approve                    Approve after review\n" ++
    "  handoff request-changes <reason>   Request changes with reason\n" ++
    "  handoff merge                      Merge approved branch to master\n" ++
    "  handoff abandon                    Abandon handoff\n" ++
    "  log <message>                      Append to session log\n" ++
    "  recall [n]                         Show last N session log entries (default 10)\n" ++
    "  build                              Build + compact summary (full log stored)\n" ++
    "  test [filter]                      Test + compact summary (full log stored)\n" ++
    "  orient [topic]                      Project map (topics: vision, syntax, pipeline, agents, style, git, tools, structure, pitfalls)\n" ++
    "  greet <name> [ctx] [tools] [os] [wd]  Register agent identity and capabilities\n" ++
    "  roster                              Show registered agents and capabilities\n" ++
    "  init                                Full session start (doctor+check+status+handoff+verify+git)\n" ++
    "  help                                This message\n" ++
    "\n" ++
    "Handoff lifecycle: draft -> awaiting-review -> under-review -> approved -> merged\n" ++
    "                                             \\-> changes-requested -> awaiting-review\n" ++
    "\n" ++
    "Usage: codex-agent <command> [args]\n" ++
    "Built from codex-agent.codex via the Codex IL backend."
   )

Section: Main

  dispatch-command : Command -> List Text -> [Console, FileSystem, Process] Nothing
  dispatch-command (cmd) (args) =
   when cmd
    is CmdPeek -> do-peek args
    is CmdStat -> do-stat args
    is CmdSnap -> do-snap args
    is CmdHelp -> print-help
    is CmdInit -> do-init args
    is CmdStatus -> do-status args
    is CmdPlan -> do-plan args
    is CmdCheck -> do-check args
    is CmdDoctor -> do-doctor args
    is CmdHandoff -> do-handoff args
    is CmdLog -> do-log args
    is CmdRecall -> do-recall args
    is CmdBuild -> do-build args
    is CmdTest -> do-test args
    is CmdOrient -> do-orient args
    is CmdGreet -> do-greet args
    is CmdRoster -> do-roster args
    is CmdUnknown (n) -> print-line ("Unknown command: " ++ n ++ ". Run 'codex-agent help' for usage.")

  opening : [Console, FileSystem, Process] Nothing = act
   args <- get-args
   let argc = list-length args
   in if argc < 2 then print-help
   else let cmd = parse-command (list-at args 1)
   in act
    root <- repo-root
    if text-length root == 0 & cmd-needs-repo cmd then act
     msg <- repo-root-missing-msg
     print-line msg
    end
    else dispatch-command cmd args
   end
  end

