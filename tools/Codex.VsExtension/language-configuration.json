{
  "comments": {},
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*=\\s*$|^.*\\b(act|if|when|where|let|record|trying)\\b.*$",
    "decreaseIndentPattern": "^\\s*(else|in|end|is)\\b"
  },
  "folding": {
    "markers": {
      "start": "^(Chapter|Section):",
      "end": "^(Chapter|Section|Page)\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*act\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*record\\s*\\{\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[a-zA-Z][a-zA-Z0-9]*(-[a-z][a-zA-Z0-9]*)*"
}
