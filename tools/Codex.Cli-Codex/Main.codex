Chapter: Main
  cites Codex chapter Console
  cites Codex chapter Files
  cites Codex chapter Lists
  cites Codex chapter Process
  cites Codex chapter Text

 The Codex CLI. Selfhost (Codex.Codex.dll) emits C#; csc compiles to
 a .NET DLL that a small wrapper exe loads.

Section: Constants

  version-text : Text = "Codex 0.1.0-bootstrap"

  version-tagline : Text = "The beginning."

Section: Argv

  arg-at : List Text -> Integer -> Text -> Text
  arg-at (args) (i) (fallback) =
    if i >= list-length args then fallback
    else list-at args i

  flag-at : List Text -> Text -> Text -> Text
  flag-at (args) (name) (fallback) =
    flag-at-loop args name fallback 1 (list-length args)

  flag-at-loop : List Text -> Text -> Text -> Integer -> Integer -> Text
  flag-at-loop (args) (name) (fallback) (i) (n) =
    if i >= n then fallback
    else if list-at args i == name then arg-at args (i + 1) fallback
    else flag-at-loop args name fallback (i + 1) n

Section: Native Commands

  print-version : [Console] Nothing = act
    print-line version-text
    print-line version-tagline
  end

  print-usage : [Console] Nothing = act
    print-line "Codex - A language for the rest of human time"
    print-line ""
    print-line "Usage: codex <command> [arguments]"
    print-line ""
    print-line "Commands:"
    print-line "  build <file|dir>  Compile a Codex file or project (today: x86-64-bare only)"
    print-line "                    --target <t>        x86-64-bare (only target supported)"
    print-line "                    --output-dir <d>    Where to write the ELF"
    print-line "                    --exit-mode <m>     repl | qemu-exit (default qemu-exit)"
    print-line "                    --watchdog <m>      progress | pet (default progress)"
    print-line "  dump-source <dir> [out]  Quire-aware concat of every .codex in <dir>"
    print-line "  version           Display the Codex version"
    print-line "  --help, -h        Display this help message"
  end

  not-yet-implemented : Text -> [Console, Process] Nothing
  not-yet-implemented (cmd) = act
    print-error ("codex: " ++ cmd ++ " not yet implemented.")
    process-exit 1
  end

Section: Source Concatenation

 Walk root + one level of subdirectory for *.codex, sort, prepend each
 cited Foreword chapter (Chapter: line rewritten to Foreword--<name>),
 emit each subdirectory file with Chapter: rewritten to <Quire>--<X>.

  rewrite-chapter-prefix : Text -> Text -> Text
  rewrite-chapter-prefix (content) (prefix) =
   if text-length prefix == 0 then content
   else text-replace content "Chapter: " ("Chapter: " ++ prefix ++ "--")

  read-and-prefix : Text -> Text -> Text
  read-and-prefix (path) (prefix) =
   rewrite-chapter-prefix (read-file path) prefix

  concat-list-of-files : List Text -> Text -> Integer -> Integer -> Text -> Text
  concat-list-of-files (paths) (prefix) (i) (n) (acc) =
   if i >= n then acc
   else let chunk = read-and-prefix (list-at paths i) prefix
        in concat-list-of-files paths prefix (i + 1) n (acc ++ chunk ++ "\n\n")

  concat-quire-dir : Text -> Text -> Text
  concat-quire-dir (subdir) (acc) =
   let quire = path-filename subdir
   in let files = list-files subdir "*.codex"
   in concat-list-of-files files quire 0 (list-length files) acc

  concat-subdirs : List Text -> Integer -> Integer -> Text -> Text
  concat-subdirs (subdirs) (i) (n) (acc) =
   if i >= n then acc
   else concat-subdirs subdirs (i + 1) n (concat-quire-dir (list-at subdirs i) acc)

  is-name-char : Char -> Boolean
  is-name-char (c) = is-letter c | is-digit c | c == '-' | c == '_'

  scan-name-end : Text -> Integer -> Integer -> Integer
  scan-name-end (text) (i) (limit) =
   if i >= limit then i
   else if is-name-char (char-at text i) then scan-name-end text (i + 1) limit
   else i

  scan-foreword-name : Text -> Integer -> Integer -> Text
  scan-foreword-name (text) (start) (limit) =
   if start >= limit then ""
   else if is-name-char (char-at text start)
   then let stop = scan-name-end text start limit
        in substring text start (stop - start)
   else ""

  matches-prefix-at : Text -> Integer -> Text -> Integer -> Integer -> Boolean
  matches-prefix-at (text) (text-i) (pattern) (pat-i) (pat-len) =
   if pat-i >= pat-len then True
   else if text-i >= text-length text then False
   else if char-at text text-i == char-at pattern pat-i
   then matches-prefix-at text (text-i + 1) pattern (pat-i + 1) pat-len
   else False

  collect-foreword-cites : Text -> Integer -> Integer -> List Text -> List Text
  collect-foreword-cites (body) (i) (n) (acc) =
   if i >= n then acc
   else if matches-prefix-at body i "cites Foreword chapter " 0 23
   then let after = i + 23
        in let name = scan-foreword-name body after n
        in if text-length name == 0 then collect-foreword-cites body (i + 1) n acc
           else collect-foreword-cites body (after + text-length name) n (list-snoc acc name)
   else collect-foreword-cites body (i + 1) n acc

  list-contains-text : List Text -> Text -> Integer -> Integer -> Boolean
  list-contains-text (xs) (x) (i) (n) =
   if i >= n then False
   else if list-at xs i == x then True
   else list-contains-text xs x (i + 1) n

  insert-sorted : List Text -> Text -> List Text
  insert-sorted (xs) (x) =
   insert-sorted-loop xs x 0 (list-length xs) []

  append-rest : List Text -> List Text -> Integer -> Integer -> List Text
  append-rest (acc) (xs) (i) (n) =
   if i >= n then acc
   else append-rest (list-snoc acc (list-at xs i)) xs (i + 1) n

  insert-sorted-loop : List Text -> Text -> Integer -> Integer -> List Text -> List Text
  insert-sorted-loop (xs) (x) (i) (n) (acc) =
   if i >= n then list-snoc acc x
   else if text-compare x (list-at xs i) <= 0
   then append-rest (list-snoc acc x) xs i n
   else insert-sorted-loop xs x (i + 1) n (list-snoc acc (list-at xs i))

  dedupe-sorted-loop : List Text -> Integer -> Integer -> List Text -> List Text
  dedupe-sorted-loop (xs) (i) (n) (acc) =
   if i >= n then acc
   else let x = list-at xs i
   in if list-contains-text acc x 0 (list-length acc)
      then dedupe-sorted-loop xs (i + 1) n acc
      else dedupe-sorted-loop xs (i + 1) n (insert-sorted acc x)

  dedupe-sorted : List Text -> List Text
  dedupe-sorted (xs) = dedupe-sorted-loop xs 0 (list-length xs) []

  concat-foreword-files : List Text -> Integer -> Integer -> Text -> Text
  concat-foreword-files (names) (i) (n) (acc) =
   if i >= n then acc
   else let name = list-at names i
   in let path = "foreword/" ++ name ++ ".codex"
   in if file-exists path
      then let chunk = rewrite-chapter-prefix (read-file path) "Foreword"
           in concat-foreword-files names (i + 1) n (acc ++ chunk ++ "\n\n")
      else concat-foreword-files names (i + 1) n acc

  load-cited-forewords : Text -> Text
  load-cited-forewords (body) =
   let raw-names = collect-foreword-cites body 0 (text-length body) []
   in let unique = dedupe-sorted raw-names
   in concat-foreword-files unique 0 (list-length unique) ""

  build-source-from-dir : Text -> Text
  build-source-from-dir (codex-dir) =
   let root-files = list-files codex-dir "*.codex"
   in let subdirs = list-directories codex-dir
   in let root-text = concat-list-of-files root-files "" 0 (list-length root-files) ""
   in let body-text = concat-subdirs subdirs 0 (list-length subdirs) root-text
   in let foreword-text = load-cited-forewords body-text
   in if text-length foreword-text == 0 then body-text
      else foreword-text ++ body-text

  do-dump-source : Text -> Text -> [Console, FileSystem] Nothing
  do-dump-source (codex-dir) (out-path) =
   let combined = build-source-from-dir codex-dir
   in act
    write-file out-path combined
    print-line ("Wrote " ++ integer-to-text (text-length combined) ++ " chars to " ++ out-path)
   end

Section: Build

 build today supports only --target x86-64-bare. The selfhost
 external-compile-bare builtin wraps compile_to_binary_with_options
 via a C# call into Codex.Codex.dll.

  is-directory : Text -> Boolean
  is-directory (path) = file-exists (path ++ "/codex.project.json")

  load-source : Text -> Text
  load-source (input) =
   if is-directory input then build-source-from-dir input
   else read-file input

  do-build : Text -> Text -> Text -> Text -> Text -> [Console, FileSystem, Process] Nothing
  do-build (input) (output-dir) (chapter) (exit-mode-str) (wd-mode-str) =
   let source = load-source input
   in let bytes = external-compile-bare source chapter exit-mode-str wd-mode-str
   in let out-path = output-dir ++ "/" ++ chapter ++ ".elf"
   in if list-length bytes == 0 then process-exit 1
      else act
        create-directory output-dir
        write-binary-file out-path bytes
        print-line ("Compiled to " ++ out-path ++ " (x86-64-bare, " ++ integer-to-text (list-length bytes) ++ " bytes)")
      end

Section: Dispatch

  chapter-name-of : Text -> Text
  chapter-name-of (input) =
   if text-length input == 0 then "output"
   else let stripped = strip-trailing-slash input
        in let last-sep = find-last-sep stripped (text-length stripped - 1)
        in if last-sep < 0 then stripped
           else substring stripped (last-sep + 1) (text-length stripped - last-sep - 1)

  strip-trailing-slash : Text -> Text
  strip-trailing-slash (s) =
   if text-length s == 0 then s
   else let last = char-at s (text-length s - 1)
        in if last == '/' | last == '\\'
           then substring s 0 (text-length s - 1)
           else s

  find-last-sep : Text -> Integer -> Integer
  find-last-sep (s) (i) =
   if i < 0 then -1
   else let c = char-at s i
        in if c == '/' | c == '\\' then i
           else find-last-sep s (i - 1)

  dispatch-build : List Text -> [Console, FileSystem, Process] Nothing
  dispatch-build (args) =
   let input = arg-at args 2 ""
   in let target = flag-at args "--target" "x86-64-bare"
   in let output-dir = flag-at args "--output-dir" "."
   in let exit-mode = flag-at args "--exit-mode" "qemu-exit"
   in let wd-mode = flag-at args "--watchdog" "progress"
   in let chapter = chapter-name-of input
   in if text-length input == 0 then act
        print-error "codex: build: missing input path"
        process-exit 1
      end
      else if target == "x86-64-bare" then do-build input output-dir chapter exit-mode wd-mode
      else act
        print-error ("codex: build: target " ++ target ++ " not supported (x86-64-bare only)")
        process-exit 1
      end

  dispatch : List Text -> [Console, FileSystem, Process] Nothing
  dispatch (args) =
    let cmd = arg-at args 1 ""
    in if text-length cmd == 0 then print-usage
    else if cmd == "version" then print-version
    else if cmd == "--help" then print-usage
    else if cmd == "-h" then print-usage
    else if cmd == "dump-source" then do-dump-source (arg-at args 2 "") (arg-at args 3 "/tmp/codex-all-source.codex")
    else if cmd == "build" then dispatch-build args
    else not-yet-implemented cmd

Section: Entry Point

  opening : [Console, FileSystem, Process] Nothing = act
    args <- get-args
    dispatch args
  end
