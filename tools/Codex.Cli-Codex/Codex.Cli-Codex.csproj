<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Codex.CliCodex</RootNamespace>
    <AssemblyName>Codex.Cli-Codex</AssemblyName>
    <StartupObject>Bridge</StartupObject>
    <SelfhostDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Codex.Codex\bin\$(Configuration)\net8.0\Codex.Codex.dll'))</SelfhostDll>
    <CodexHostDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\CodexHost\bin\$(Configuration)\net8.0\CodexHost.dll'))</CodexHostDll>
    <Source>$(MSBuildProjectDirectory)\Main.codex</Source>
    <GeneratedCs>$(MSBuildProjectDirectory)\out\Codex.Cli-Codex.cs</GeneratedCs>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit path, not a glob: the file is generated by RegenerateCs
         before csc runs, but globs are evaluated at project-load time,
         so an empty out/ dir would leave the Compile item set empty and
         produce CS5001 on clean-room builds. -->
    <Compile Include="$(GeneratedCs)" />
    <Compile Include="Bridge.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Codex.Codex">
      <HintPath>..\..\Codex.Codex\bin\Debug\net8.0\Codex.Codex.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <CodexSources Include="**/*.codex" />
  </ItemGroup>
  <!-- Compile via CodexHost (a stack-bumped launcher around selfhost).
       CodexHost calls Codex_Codex_Codex.compile_text on a 32MB-stack
       thread because selfhost's curried lambdas overflow the 1MB default.
       Argv: CSHARP <input> <output> <chapter-name>. Chapter name is
       "CliCodex" so the generated class can be referenced from
       the wrapper exe directly. -->
  <Target Name="RegenerateCs" BeforeTargets="BeforeCompile"
          Condition="'$(SkipCodexRegenerate)' != 'true'"
          Inputs="@(CodexSources);codex.project.json;$(SelfhostDll);$(CodexHostDll)"
          Outputs="$(GeneratedCs)">
    <Error Condition="!Exists('$(SelfhostDll)')"
           Text="Selfhost not built. Run 'dotnet build Codex.sln' first to produce $(SelfhostDll)." />
    <Error Condition="!Exists('$(CodexHostDll)')"
           Text="CodexHost not built. Run 'dotnet build tools/CodexHost/CodexHost.csproj' first." />
    <MakeDir Directories="$(MSBuildProjectDirectory)\out" />
    <Message Importance="high" Text="Regenerating $(GeneratedCs) via CodexHost ($(CodexHostDll))" />
    <Exec Command="dotnet &quot;$(CodexHostDll)&quot; CSHARP &quot;$(Source)&quot; &quot;$(GeneratedCs)&quot; CliCodex"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Strip the generated top-level statement so Bridge.cs's Main is the
         exe entry point (Bridge runs opening() on a 32MB-stack thread). -->
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Content '$(GeneratedCs)') -replace '^Codex_CliCodex\.opening\(\);$','' | Set-Content '$(GeneratedCs)'&quot;"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command="sed -i 's/^Codex_CliCodex\.opening();$//' '$(GeneratedCs)'"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) OR $([MSBuild]::IsOSPlatform('OSX'))" />
  </Target>
</Project>
