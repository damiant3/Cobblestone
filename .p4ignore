# .p4ignore -- files p4 reconcile/add should never touch.
# Patterns match relative to this file. A leading / anchors to this dir.

# VCS metadata (git lives alongside; don't import it)
.git/
.gitattributes
.gitmodules

# Editor / IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# .NET build artifacts
bin/
obj/
packages/
TestResults/
*.nupkg
*.snupkg

# Project build outputs
build-output/
test-output/
test-output-cross/
build/output/
build/output-*/
old/generated-output/

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store

# Node (defensive; may not apply)
node_modules/

# Local-only p4 state
.p4config

# AgentGrid coordination mailbox pointer (written by AgentGrid at launch)
.agentgrid

# Claude Code local machine settings (NOT the shared settings.json)
.claude/settings.local.json

# Claude Code scheduled-task lock -- per-machine runtime state, written by the
# harness. It is not shared and it is not source. Ignored because
# p4-stale-check reported it on every run, and a check that always prints a
# line you are meant to ignore is a check that will hide a real one: the same
# script's other half caught a BACKLOG.md sitting a revision behind the depot
# head, which would have silently dropped two other agents' edits. That signal
# is worth keeping clean. (.claude/skills/ IS tracked and shared -- do not
# widen this to .claude/.)
.claude/scheduled_tasks.lock

# Published/packaged build outputs under tools (except codex-agent -- kept
# intentionally so a fresh clone can orient immediately without a build).
tools/Codex.Mcp/published/

# Renode runtime is installed once box-wide (C:\Renode or $CODEX_RENODE_HOME),
# not copied per-workspace. Only the small board .repl files under
# tools/renode/codex/ are tracked; ignore the ~120 MB runtime if present.
tools/renode/*
!tools/renode/codex/
samples/*.exe
samples/*.runtimeconfig.json
samples/list-test


# Debug symbols and native compile droppings (cl.exe leaves .obj in cwd)
*.pdb
*.obj

# Historical phone firmware blobs (too large, not source)
docs/Done/Phone/phone/flash/

# Generated game assets (regenerate locally with tools/generate-game-*.ps1)
assets/games/previews/
assets/games/backgammon/
assets/games/battleship/
assets/games/blackjack/
assets/games/bridge/
assets/games/checkers/
assets/games/connect4/
assets/games/crazyeights/
assets/games/dotsandboxes/
assets/games/game2048/
assets/games/go/
assets/games/gofish/
assets/games/hexgame/
assets/games/hexwar/
assets/games/liarsdice/
assets/games/life/
assets/games/mahjong/
assets/games/mancala/
assets/games/minesweeper/
assets/games/monopoly/
assets/games/othello/
assets/games/pinochle/
assets/games/poker/
assets/games/pokervariants/
assets/games/risk/
assets/games/royalur/
assets/games/rps/
assets/games/setgame/
assets/games/spider/
assets/games/tictactoe/
assets/games/war/
assets/games/yahtzee/
.doc-counts
# The landing site's packaged compile/ surface is BUILD OUTPUT, assembled by
# apps/landing/build.ps1 from the wasm plug. 4 MB of module and source that
# regenerate from the seed; the page and its art are tracked, this is not.
apps/landing/web/gpushow/
apps/landing/web/fishtank/
apps/landing/web/spark/
apps/landing/web/fireworks/
# globe/ is assembled by the same script and had no line here, so it read as an
# untracked add to anything sweeping the tree.
apps/landing/web/globe/
# Spark's browser module and its WAT are build output: apps/spark/build-wasm.ps1
# regenerates both from SparkWasm.codex and the wasm plug, and the landing
# build calls it. fishtank tracked its module and shipped one four days stale.
apps/spark/web/spark.wasm
apps/spark/web/build-output/
# The fireworks skyline module, on exactly those terms: apps/fireworks/
# build-wasm.ps1 regenerates it from FireworksShow.codex and the wasm plug, and
# apps/landing/build.ps1 calls it while assembling the site.
apps/fireworks/web/fireworks-show.wasm
apps/fireworks/web/build-output/
apps/landing/web/compile/
# EXCEPT prism.html, tracked at Damian's direction 2026-08-26 so it can be
# pointed at directly. It is the one artifact here that is worth tracking,
# because it is the only one that WORKS ALONE: build-page.ps1 inlines the
# compiler, all three target plugs, the examples and the backdrop into it, so
# a copy of this single file opened from anywhere compiles Codex with nothing
# beside it. index.html and the loose modules stay ignored; index.html fetches
# 4 MB from its own directory and cannot be handed to anybody as one file.
!apps/landing/web/compile/prism.html
# The games' wasm modules are build output on the same terms as compile/:
# apps/games/build-wasm.ps1 regenerates each one from the game's own Codex
# source and the wasm plug, and apps/landing/build.ps1 calls it while
# assembling the site, so the bundle is reproducible from the depot without
# carrying a binary per game. The PAGES beside them are hand-written source
# and stay tracked.
apps/landing/web/games/*.wasm

# The C64 emulator's module, on exactly those terms: apps/c64/build-wasm.ps1
# regenerates it from apps/c64's own Codex source and the wasm plug, and
# apps/landing/build.ps1 calls it while assembling the site. The page beside
# it is hand-written source and stays tracked.
apps/landing/web/c64/*.wasm

# The notebook's evaluator, on the same terms: apps/mathbook/build-wasm.ps1
# regenerates it from apps/mathbook's own Codex source and the wasm plug, and
# apps/landing/build.ps1 calls it while assembling the site.
apps/landing/web/mathbook/*.wasm

# The relational engine's module, on the same terms: apps/data/build-wasm.ps1
# regenerates it from apps/data's own Codex source and the wasm plug.
apps/landing/web/data/*.wasm

# The arcade's art is build output on the same terms. The tracked source is
# assets/games/ (164 files, 70 MB); apps/games/build-art.ps1 re-encodes the
# 1280x800 PNG scenes to JPEG and copies the card faces and thumbnails,
# which turns roughly 40 MB of background into about 6.5 MB of bundle.
apps/landing/web/games/art/

# The star map's module and its WAT, on spark's terms: apps/starmap/build-wasm.ps1
# regenerates both from StarMapWasm.codex and the wasm plug, and the landing
# build calls it before it grades and stages them.
apps/starmap/web/starmap.wasm
apps/starmap/web/build-output/
apps/landing/web/starmap/