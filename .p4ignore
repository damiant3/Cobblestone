# .p4ignore -- files p4 reconcile/add should never touch.
# Patterns match relative to this file. A leading / anchors to this dir.

# VCS metadata (git lives alongside; don't import it)
.git/
.gitattributes
.gitmodules

# Editor / IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# .NET build artifacts
bin/
obj/
packages/
TestResults/
*.nupkg
*.snupkg

# Project build outputs
build-output/
test-output/
test-output-cross/
build/output/
build/output-*/
old/generated-output/

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store

# Node (defensive; may not apply)
node_modules/

# Local-only p4 state
.p4config

# AgentGrid coordination mailbox pointer (written by AgentGrid at launch)
.agentgrid

# Claude Code local machine settings (NOT the shared settings.json)
.claude/settings.local.json

# Claude Code scheduled-task lock -- per-machine runtime state, written by the
# harness. It is not shared and it is not source. Ignored because
# p4-stale-check reported it on every run, and a check that always prints a
# line you are meant to ignore is a check that will hide a real one: the same
# script's other half caught a BACKLOG.md sitting a revision behind the depot
# head, which would have silently dropped two other agents' edits. That signal
# is worth keeping clean. (.claude/skills/ IS tracked and shared -- do not
# widen this to .claude/.)
.claude/scheduled_tasks.lock

# Published/packaged build outputs under tools (except codex-agent -- kept
# intentionally so a fresh clone can orient immediately without a build).
tools/Codex.Mcp/published/

# Renode runtime is installed once box-wide (C:\Renode or $CODEX_RENODE_HOME),
# not copied per-workspace. Only the small board .repl files under
# tools/renode/codex/ are tracked; ignore the ~120 MB runtime if present.
tools/renode/*
!tools/renode/codex/
samples/*.exe
samples/*.runtimeconfig.json
samples/list-test


# Debug symbols and native compile droppings (cl.exe leaves .obj in cwd)
*.pdb
*.obj

# Historical phone firmware blobs (too large, not source)
docs/Done/Phone/phone/flash/

# Generated game assets (regenerate locally with tools/generate-game-*.ps1)
assets/games/previews/
assets/games/backgammon/
assets/games/battleship/
assets/games/blackjack/
assets/games/bridge/
assets/games/checkers/
assets/games/connect4/
assets/games/crazyeights/
assets/games/dotsandboxes/
assets/games/game2048/
assets/games/go/
assets/games/gofish/
assets/games/hexgame/
assets/games/hexwar/
assets/games/liarsdice/
assets/games/life/
assets/games/mahjong/
assets/games/mancala/
assets/games/minesweeper/
assets/games/monopoly/
assets/games/othello/
assets/games/pinochle/
assets/games/poker/
assets/games/pokervariants/
assets/games/risk/
assets/games/royalur/
assets/games/rps/
assets/games/setgame/
assets/games/spider/
assets/games/tictactoe/
assets/games/war/
assets/games/yahtzee/
.doc-counts
