  cites Works chapter GopHandoff

 PHASE 1 is the endpoint-attributed USB pump. Every transfer event is
 attributed to its ENDPOINT (the event TRB's control dword carries the
 endpoint id in bits 20:16); earlier probes counted any transfer event
 as a keyboard completion, so a single leftover EP0 control completion
 read as "the interrupt endpoint fired once, then went silent." EPINT
 counts only completions whose endpoint id equals the keyboard's dci;
 EP0 and OTH count the impostors; LATCH counts codes taken from the
 per-slot latch, where attribution is already lost. Findings are
 rewritten to KBDDIAG.TXT on the boot stick's own ESP whenever the
 counters change -- each write is durable the moment it lands, so a
 later phase hanging costs nothing already recorded.

 PHASE 2 is the ownership handback experiment -- the feasibility test
 for a permanent "no USB keyboard, fall back to PS/2" boot feature. On
 a board whose only keyboard is USB, the PS/2 route IS the firmware's
 SMM legacy emulation, and that emulation serves keys only while the
 firmware owns the controller our disk driver claimed. The phase halts
 the controller, restores the firmware's own SMI enables (recorded by
 the handoff at diag index 39), clears the OS-owned semaphore, and
 then counts PS/2 arrivals on BOTH routes -- the IRQ1 mailbox and a
 floating-bus-guarded port 0x60 poll, because SMM emulation on some
 boards only answers the polled port. PS2 climbing here means the
 fallback is real.

 The counters are ZEROED at start. Phases advance on the PIT tick
 (~18 Hz, the spine runtime-init started) with a paint-count fallback
 for firmware whose tick never moves. The pump path per iteration
 allocates nothing.

 We say:

Section: Counters

 The block sits at 37000, ABOVE every claimed cell region below it: the
 GopUsbMsc publish block (36480-36571 -- the v8.0 probe overlapped it at
 36480, wiping the publish magic, so the first file write fell into
 msc-connect's controller reset and silently killed the keyboard
 endpoint it was instrumenting), and the pointer mailbox (36736). The
 xHCI diag block was in that list until 2026-07-30, when it moved off
 the PML4 page to 0x1D000; it no longer competes for this band.

  kd-cell : Integer = 37000

 The EXPERIMENT cells moved off the 37000 band on 2026-08-03. Writes at
 kd-cell offsets 132-140 (bytes 37132-37143) at pump time corrupt an
 unnamed tenant: the same experiment writing the same values to bytes
 37400+ or here runs clean, and with 132-140 live the next QR encode
 dies in qr-put-slice-bits with #UD -- bisected across variants A/B/C
 under codex-vm -hid-nak, deterministic, same RIP every run. The band
 boundary is measured, not derived: offset 128 is safe, 132 is not. The
 tenant is NOT the publish block (36480-36571), the mouse mailbox
 (36736-36751), or any greppable constant; finding it is an open item.
 These cells live on the xhci-diag page (0x1D000), 1 KB past the 96
 dwords xdiag claims, which this probe's own attach zeroes and owns.

  kx-cell : Integer = 119808

  kd-inc : Integer -> Integer
  kd-inc (off) = poke-32 kd-cell off ((peek-32 kd-cell off) + 1)

  kd-zero : Integer
  kd-zero =
    let a0 = poke-32 kd-cell 0 0
    in let a1 = poke-32 kd-cell 4 0
    in let a2 = poke-32 kd-cell 8 0
    in let a3 = poke-32 kd-cell 12 0
    in let a4 = poke-32 kd-cell 16 0
    in let a5 = poke-32 kd-cell 20 0
    in let a6 = poke-32 kd-cell 24 0
    in let a7 = poke-32 kd-cell 28 0
    in let a8 = poke-32 kd-cell 32 0
    in let a9 = poke-32 kd-cell 36 0
    in let aa = poke-32 kd-cell 40 0
    in let ab = poke-32 kd-cell 44 #FFFFFFFF
    in let ac = poke-32 kd-cell 48 0
    in let ad = poke-32 kd-cell 52 0
    in let ae = poke-32 kd-cell 56 1
    in let af = poke-32 kd-cell 60 0
    in let ag = poke-32 kd-cell 64 0
    in let ah = poke-32 kd-cell 68 0
    in let ai = poke-32 kd-cell 72 0
    in let aj = poke-32 kd-cell 76 0
    in let ak = poke-32 kd-cell 80 0
    in let al = poke-32 kd-cell 84 0
    in let am = poke-32 kd-cell 88 0
    in let an = poke-32 kd-cell 92 0
    in let ao = poke-32 kx-cell 0 0
    in let ap = poke-32 kx-cell 4 0
    in let aq = poke-32 kx-cell 8 0
    in let ar = poke-32 kx-cell 12 0
    in let as0 = poke-32 kx-cell 16 0
    in let at0 = poke-32 kx-cell 20 0
    in let au = poke-32 kx-cell 24 0
    in let av = poke-32 kx-cell 28 0
    in let aw = poke-32 kx-cell 32 0
    in let ax = poke-32 kx-cell 36 0
    in let ay = poke-32 kx-cell 40 0
    in let az = poke-32 kx-cell 44 0
    in let ba = poke-32 kx-cell 48 0
    in let bb = poke-32 kx-cell 52 0
    in let bc = poke-32 kx-cell 56 0
    in let bd = poke-32 kx-cell 60 0
    in let be = poke-32 kx-cell 64 0
    in poke-32 kd-cell 96 #FFFFFFFF

  kd-mark-tick : Integer -> Integer
  kd-mark-tick (d) = poke-32 kd-cell 76 (bit-and (peek-qword xhci-tick-cell 0) #FFFFFFFF)

  kd-tick-delta : Integer -> Integer
  kd-tick-delta (d) = bit-and (peek-qword xhci-tick-cell 0) #FFFFFFFF - peek-32 kd-cell 76

Section: Hex

  knib : Integer -> Text
  knib (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

  khx : Integer, Integer -> Text
  khx (v) (sh) = knib (bit-and (bit-shru v sh) 15)

  kh8 : Integer -> Text
  kh8 (v) = khx v 4 & khx v 0

  kh32 : Integer -> Text
  kh32 (v) = kh8 (bit-and (bit-shru v 24) 255) & kh8 (bit-and (bit-shru v 16) 255) & kh8 (bit-and (bit-shru v 8) 255) & kh8 (bit-and v 255)

  kyn : Integer -> Text
  kyn (v) = if v == 0 then "n" else "y"

  kbyte : Integer, Integer -> Text
  kbyte (buf) (i) = kh8 (peek-byte buf i)

  krpt : Integer -> Text
  krpt (buf) = kbyte buf 0 & " " & kbyte buf 1 & " " & kbyte buf 2 & " " & kbyte buf 3 & " " & kbyte buf 4 & " " & kbyte buf 5 & " " & kbyte buf 6 & " " & kbyte buf 7

Section: Raw Event Walk

 A probe-local copy of the driver's transfer wait that keeps what the
 driver throws away: the endpoint id, the completed TRB's pointer,
 and the residual. It preserves the driver's contract exactly -- a
 completion for a DIFFERENT slot is latched (the mass-storage waits
 during the file rewrite depend on that), other event types are
 consumed and skipped, and the idle path allocates nothing. A code
 taken from our own slot's latch is counted as LATCH and treated as a
 completion (the report was DMA'd), because the latch stores only the
 code -- whoever latched it consumed the endpoint id.

  kd-wait-raw : XhciHost, Integer, Integer -> Integer
  kd-wait-raw (xh) (slot) (dci) =
    let l = xhci-latch-take xh slot dci
    in if l /= 0 then
      let a = kd-inc 24
      in let c = poke-32 kd-cell 8 l
      in l
    else let st = xh.xh-state
    in let deq = peek-32 st xh-st-evt-deq
    in let cyc = peek-32 st xh-st-evt-cyc
    in let ctl = peek-32 (xh.xh-evt-ring) (deq * 16 + 12)
    in if bit-and ctl 1 /= cyc then 0
    else let ptr = peek-32 (xh.xh-evt-ring) (deq * 16)
    in let sts = peek-32 (xh.xh-evt-ring) (deq * 16 + 8)
    in let adv = xhci-evt-advance xh deq cyc
    in let ty = bit-and (bit-shru ctl 10) 63
    in if ty /= trb-t-xfer-event then kd-wait-raw xh slot dci
    else let code = bit-and (bit-shru sts 24) 255
    in let eslot = bit-and (bit-shru ctl 24) 255
    in let edci = bit-and (bit-shru ctl 16) 31
    in if eslot /= slot then
      let put = xhci-latch-put xh eslot edci code
      in kd-wait-raw xh slot dci
    else let rc = poke-32 kd-cell 28 ctl
    in let rp = poke-32 kd-cell 32 ptr
    in let rr = poke-32 kd-cell 36 (bit-and sts 16777215)
    in let cc = poke-32 kd-cell 8 code
    in if edci == dci then
      let e = kd-inc 0
      in code
    else if edci == 1 then
      let e = kd-inc 16
      in kd-wait-raw xh slot dci
    else let e = kd-inc 20
    in kd-wait-raw xh slot dci

Section: Instrumented Pump

  kd-step : UsbKbd -> Integer
  kd-step (k) =
    if k.uk-ok == False then 0
    else let ph = peek-32 (k.uk-state) 0
    in if ph == uk-ph-idle then kbd-arm k
    else if ph == uk-ph-armed then
      let code = kd-wait-raw (k.uk-host) ((k.uk-dev).ud-slot) (k.uk-dci)
      in if code == 0 then 0
      else kbd-set-phase k uk-ph-drain
    else let sc = kbd-drain k
    in if sc == 0 then 0
    else let s = kd-inc 4
    in poke-32 kd-cell 12 sc

  kd-spin : UsbKbd, Integer -> Integer
  kd-spin (k) (i) =
    let s = kd-step k
    in if i <= 0 then 0
    else kd-spin k (i - 1)

Section: Schedule Experiment

 Every arm below is a spec section, not a hunch; the derivation with
 page numbers is docs/Reference/xHCI_ServiceModel_Notes.md, built from
 docs/Reference/xHCI_Specification.pdf (rev 1.2). The guarantee under
 test is 4.14.3 p.266: an idle interrupt ring's first transaction shall
 be scheduled within IST + ESIT of the doorbell. The instruments, in
 execution order:

 PORTSC (5.4.8): PLS bits 8:5 must be U0(0); a U3(3) port is suspended
 and starves exactly the periodic schedule while leaving the firmware's
 later handback intact. Valid only if PP (bit 9) is set.

 MFINDEX (5.5.1, halt rule 4.14.2 p.260): sampled twice across a ~110ms
 PIT delay. Frozen means the controller believes every port is down and
 no frames exist for any periodic pipe.

 Stop Endpoint (4.6.9 p.133-134): forces the controller's INTERNAL
 dequeue into the output context -- parked at base with the device
 known-responsive (phase 2) means the schedule never issued the IN. The
 spec also makes a Stopped Transfer Event (code 26, 27 or 28) MANDATORY
 before the command completion, even on an idle ring; its code is taken
 from the slot latch. An xHC that completes the command but skips that
 event is not executing the transfer half of the stop.

 Restart doorbell, ~220ms wait (far beyond IST + ESIT), Stop Endpoint
 again: if dq moved between the stops, the restart scheduled and the
 loss is downstream; if identical, the doorbell-to-schedule path is
 dead. EP State reads around the restart are advisory only -- 4.8.3
 p.165 makes the Running write-back mandatory only before the next
 Transfer Event, so with no event it may lawfully read 3 forever (the
 v13 re=3 was this, not a refused restart).

 Runs ONCE, halfway through phase 1, from the pump path -- never from
 the repaint chain, which the two withdrawn instruments proved kills
 painting.

 kx cells: 0 ran, 4 stop1 event (ok in bit 8, code in 7:0), 8 dq1 low
 dword, 12 EP state post-stop1, 16 EP state after restart, 20 PORTSC
 raw, 24 MFINDEX delta, 28 stop1 latch code (the Stopped Transfer
 Event), 32 stop2 event, 36 stop2 latch code, 40 dq2. DEVX: 44 ran,
 48 device state (cfg byte, protocol byte, idle byte, ok-flag nibble),
 52-56 report sample 1, 60-64 report sample 2.

 A LIVE pipe is never touched: the v15 flight delivered idle reports
 for 48 s and then THIS experiment stopped the endpoint at its 45 s
 trigger, and on the ASUS Intel the doorbell-restart after a Stop
 Endpoint did not resume periodic delivery -- EPINT froze at 97 while
 the pump ran on. The experiments exist to autopsy a dead pipe, so
 they fire only when EPINT is still zero at trigger time.

  kd-schedx : UsbKbd -> Integer
  kd-schedx (k) =
    if k.uk-ok == False then 0
    else if peek-32 kd-cell 0 /= 0 then 0
    else if peek-32 kx-cell 0 /= 0 then 0
    else if peek-32 kd-cell 56 /= 1 then 0
    else if kd-tick-delta 0 < 270 then 0
    else let g = poke-32 kx-cell 0 1
    in let xh = k.uk-host
    in let slot = (k.uk-dev).ud-slot
    in let dctx = bit-and (peek-32 (xh.xh-dcbaa) (slot * 8)) (-64)
    in if dctx == 0 then poke-32 kx-cell 0 2
    else let port = bit-and (bit-shru (peek-32 dctx 4) 16) 255
    in let ps = poke-32 kx-cell 20 (if port > 0 then xhci-portsc xh (port - 1) else -1)
    in let mf1 = bit-and (peek-32 (xh.xh-rt) 0) 16383
    in let dl1 = xhci-delay-ticks 2
    in let mf2 = bit-and (peek-32 (xh.xh-rt) 0) 16383
    in let md = poke-32 kx-cell 24 (bit-and (mf2 - mf1) 16383)
    in let e1 = xhci-stop-endpoint xh slot (k.uk-dci)
    in let r1 = poke-32 kx-cell 4 (bit-or (if e1.xe-ok then 256 else 0) (e1.xe-code))
    in let f1 = poke-32 kx-cell 28 (xhci-latch-take xh slot (k.uk-dci))
    in let ep = dctx + (k.uk-dci) * (xh.xh-ctxsz)
    in let r2 = poke-32 kx-cell 8 (peek-32 ep 8)
    in let r3 = poke-32 kx-cell 12 (bit-and (peek-32 ep 0) 7)
    in let db = xhci-ring-doorbell xh slot (k.uk-dci)
    in let r4 = poke-32 kx-cell 16 (bit-and (peek-32 ep 0) 7)
    in let dl2 = xhci-delay-ticks 4
    in let e2 = xhci-stop-endpoint xh slot (k.uk-dci)
    in let r5 = poke-32 kx-cell 32 (bit-or (if e2.xe-ok then 256 else 0) (e2.xe-code))
    in let f2 = poke-32 kx-cell 36 (xhci-latch-take xh slot (k.uk-dci))
    in let r6 = poke-32 kx-cell 40 (peek-32 ep 8)
    in xhci-ring-doorbell xh slot (k.uk-dci)

Section: Device State Experiment

 The controller polls and the device NAKs (SCHEDX's verdict on metal),
 so the remaining questions belong to the DEVICE, and every one is
 askable over the control pipe that demonstrably works. HID 1.11:
 GET_PROTOCOL 7.2.5 (expect 0, boot), GET_IDLE 7.2.3 (the silencer --
 v14 and earlier SENT Set_Idle 0, v15's driver no longer does),
 GET_REPORT 7.2.1 (MANDATORY: the current input report over EP0,
 bypassing the interrupt pipe entirely). USB2 9.4.2 GET_CONFIGURATION
 (expect the configured value, 1). Two GET_REPORT samples ~1 s apart:
 a key held across them appears in sample 2 even if it was missed by
 sample 1, and a nonzero sample is the existence proof for a
 GET_REPORT-polling keyboard fallback. Fires once, after SCHEDX, from
 the pump path. Interface number is taken as 0 (a boot keyboard's
 interface on every board seen; a wrong guess answers STALL, which the
 flag nibble records as a failed request rather than silence).

  kd-devx : UsbKbd -> Integer
  kd-devx (k) =
    if k.uk-ok == False then 0
    else if peek-32 kx-cell 44 /= 0 then 0
    else if peek-32 kx-cell 0 == 0 then 0
    else if kd-tick-delta 0 < 340 then 0
    else let g = poke-32 kx-cell 44 1
    in let xh = k.uk-host
    in let dev = k.uk-dev
    in let buf = alloc-zeroed 64 64
    in let gc = xhci-ctrl-in xh dev 128 8 0 0 buf 1
    in let cfg = peek-byte buf 0
    in let gp = xhci-ctrl-in xh dev 161 3 0 0 buf 1
    in let proto = peek-byte buf 0
    in let gi = xhci-ctrl-in xh dev 161 2 0 0 buf 1
    in let idle = peek-byte buf 0
    in let g1 = xhci-ctrl-in xh dev 161 1 256 0 buf 8
    in let s1a = poke-32 kx-cell 52 (peek-32 buf 0)
    in let s1b = poke-32 kx-cell 56 (peek-32 buf 4)
    in let dl = xhci-delay-ticks 18
    in let g2 = xhci-ctrl-in xh dev 161 1 256 0 buf 8
    in let s2a = poke-32 kx-cell 60 (peek-32 buf 0)
    in let s2b = poke-32 kx-cell 64 (peek-32 buf 4)
    in let fl = (if gc then 1 else 0) + (if gp then 2 else 0) + (if gi then 4 else 0) + (if g1 then 8 else 0) + (if g2 then 16 else 0)
    in poke-32 kx-cell 48 (bit-or cfg (bit-or (bit-shl proto 8) (bit-or (bit-shl idle 16) (bit-shl fl 24))))

Section: Ownership Handback

 The reverse of the driver's take-ownership, for the phase-2
 experiment: halt the controller so the firmware inherits a quiescent
 device, restore the SMI enables the firmware had chosen (recorded at
 diag index 39 during the handoff), clear the OS-owned semaphore, and
 watch for the BIOS-owned bit to return. The reclaim is re-checked
 every paint during phase 2 because a firmware may take seconds of
 SMM work to re-own a controller -- the inline waits here are
 deliberately short (these loops poll MMIO, where the driver's settle
 fuel would stall the glass for a minute).

  xr-fuel : Integer = 200000

  xr-halt-wait : Integer, Integer -> Integer
  xr-halt-wait (op) (fuel) =
    if bit-and (peek-32 op 4) 1 /= 0 then 1
    else if fuel <= 0 then 0
    else xr-halt-wait op (fuel - 1)

  xr-reclaim-wait : Integer, Integer -> Integer
  xr-reclaim-wait (addr) (fuel) =
    if bit-and (peek-32 addr 0) xhci-legsup-bios /= 0 then 1
    else if fuel <= 0 then 0
    else xr-reclaim-wait addr (fuel - 1)

  xr-release : XhciHost -> Integer
  xr-release (xh) =
    if xh.xh-ok == False then
      let r = poke-32 kd-cell 68 0
      in poke-32 kd-cell 72 0
    else let op = xh.xh-op
    in let cmd = peek-32 op 0
    in let hw = poke-32 op 0 (bit-and cmd #FFFFFFFE)
    in let halted = xr-halt-wait op xr-fuel
    in if xdiag-get 9 == 0 then
      let r = poke-32 kd-cell 68 0
      in poke-32 kd-cell 72 0
    else let base = op - xdiag-get 4
    in let addr = xhci-find-legsup base (xdiag-get 8) 256
    in if addr == 0 then
      let r = poke-32 kd-cell 68 0
      in poke-32 kd-cell 72 0
    else let sa = poke-32 kd-cell 92 (bit-and addr #FFFFFFFF)
    in let rc = poke-32 addr 4 (xdiag-get 39)
    in let os = poke-32 addr 0 (bit-and (peek-32 addr 0) #FEFFFFFF)
    in let r = poke-32 kd-cell 68 1
    in poke-32 kd-cell 72 (xr-reclaim-wait addr xr-fuel)

  kd-reclaim-recheck : Integer -> Integer
  kd-reclaim-recheck (d) =
    if peek-32 kd-cell 68 == 0 then 0
    else if peek-32 kd-cell 72 /= 0 then 0
    else let a = peek-32 kd-cell 92
    in if a == 0 then 0
    else if bit-and (peek-32 a 0) xhci-legsup-bios /= 0 then poke-32 kd-cell 72 1
    else 0

Section: PS2 Watch

 Phase 2 counts keys on both PS/2 routes. The IRQ1 mailbox is what a
 real i8042 keyboard (or an SMM emulation that injects through the
 i8042) fills; the polled port is what a pure port-trap SMM emulation
 answers. The status read is floating-bus-guarded: a machine with no
 i8042 floats #FF, which must read as absent, not as data-ready.

  kd-note-ps2 : Integer -> Integer
  kd-note-ps2 (sc) =
    let a = kd-inc 60
    in poke-32 kd-cell 64 sc

  kd-poll-port : Integer -> [Device.Port] Integer
  kd-poll-port (d) = act
    st <- port-in-byte 100
    if st == 255 then 0
    else if bit-and st 1 == 0 then 0
    else act
      b <- port-in-byte 96
      if b == 255 then 0 else b
    end
  end

  kd-spin2 : Integer -> [Device.Port] Integer
  kd-spin2 (i) = act
    p <- kd-poll-port 0
    let a = if p /= 0 then kd-note-ps2 p else 0
    in let sc = gk-take 0
    in let b = if sc /= 0 then kd-note-ps2 sc else 0
    in if i <= 0 then 0
    else kd-spin2 (i - 1)
  end

Section: Findings File

 The file body mirrors the screen. It is rewritten only when the
 counter signature changes, and at most 250 times, so a stuck-key
 flood cannot chew the FAT's free clusters. Phase 2 never writes (the
 controller is the firmware's during the experiment); phase 3 forces
 one write by resetting the stored signature.

  kd-sig : Integer -> Integer
  kd-sig (d) = (peek-32 kd-cell 0) + (peek-32 kd-cell 16) * 7 + (peek-32 kd-cell 20) * 11 + (peek-32 kd-cell 24) * 13 + (peek-32 kd-cell 4) * 17 + (peek-32 kd-cell 60) * 19 + (peek-32 kd-cell 56) * 23 + (peek-32 kx-cell 0) * 29 + (peek-32 kx-cell 4) * 31 + (peek-32 kx-cell 32) * 37 + (peek-32 kx-cell 40) * 41 + (peek-32 kx-cell 44) * 43 + (peek-32 kx-cell 60) * 47

  kd-put-text : Integer, Text, Integer -> Integer
  kd-put-text (buf) (s) (i) =
    if i >= text-length s then 0
    else let w = poke-byte buf i (to-unicode (char-code (char-at s i)))
    in kd-put-text buf s (i + 1)

  kd-host-id : Integer -> Integer
  kd-host-id (z) = bit-or (bit-shl (xdiag-get 2) 16) (xdiag-get 3)

 Cell 44 is the keyboard's controller as ordinal PLUS ONE, so zero means no
 controller yielded one. Comparing that row's identity against cells 2-3
 answers the only question that makes the rest of the HOST line worth
 reading: whether it describes the keyboard's controller or another one.

  kd-host-is-kbd : Integer -> Boolean
  kd-host-is-kbd (z) =
    let o = xdiag-get 44
    in if o == 0 then False
    else if o > 4 then False
    else kd-host-id 0 == xdiag-get (48 + (o - 1) * 4)

  kd-file-body : UsbKbd -> Text
  kd-file-body (k) =
    let l1 = "KBDDIAG v16\n"
    in let l1a = "HOST id=" & kh32 (kd-host-id 0) & " run=" & show (xdiag-get 17) & " cnr=" & show (xdiag-get 16) & " ports=" & show (xdiag-get 14) & " slots=" & show (xdiag-get 13) & " HCC=" & kh32 (xdiag-get 5) & " xECP=" & show (xdiag-get 8) & "\n"
    in let l1b = "CTL n=" & show (xdiag-get 40) & " 0:" & kh32 (xdiag-get 48) & " 1:" & kh32 (xdiag-get 52) & " 2:" & kh32 (xdiag-get 56) & "\n"
    in let l1c = "ATTR kbd=" & show (xdiag-get 44) & " disk=" & show (xdiag-get 43) & " up=" & show (xdiag-get 41) & " msk=" & kh8 (xdiag-get 42) & " BAR=" & show (xdiag-get 30) & " " & kh32 (xdiag-get 32) & kh32 (xdiag-get 31) & "\n"
    in let l2 = "uk-ok=" & kyn (if k.uk-ok then 1 else 0) & " slot=" & show ((k.uk-dev).ud-slot) & " dci=" & show (k.uk-dci) & " speed=" & show ((k.uk-dev).ud-speed) & "\n"
    in let l3 = "EPINT=" & show (peek-32 kd-cell 0) & " EP0=" & show (peek-32 kd-cell 16) & " OTH=" & show (peek-32 kd-cell 20) & " LATCH=" & show (peek-32 kd-cell 24) & "\n"
    in let l4 = "code=" & kh8 (peek-32 kd-cell 8) & " resid=" & show (peek-32 kd-cell 36) & " ctl=" & kh32 (peek-32 kd-cell 28) & kd-stopx-line 0 & kd-schedx-line 0 & kd-s2-line 0 & "\n" & (if peek-32 kx-cell 44 == 0 then "" else "R1: " & kd-rpt2 52 & " " & kd-rpt2 56 & " " & kd-devx-line 0 & "\n")
    in let l5 = "trb=" & kh32 (peek-32 kd-cell 32) & " ring=" & kh32 (peek-32 kd-cell 48) & "\n"
    in let l6 = "REPORT " & krpt (k.uk-report) & "\n"
    in let l7 = "SCANS=" & show (peek-32 kd-cell 4) & " last=" & kh8 (peek-32 kd-cell 12) & " st=" & show (if k.uk-ok then peek-32 (k.uk-state) 0 else 9) & "\n"
    in let l8 = "PHASE=" & show (peek-32 kd-cell 56) & " released=" & show (peek-32 kd-cell 68) & " reclaim=" & show (peek-32 kd-cell 72) & " ps2=" & show (peek-32 kd-cell 60) & " ps2last=" & kh8 (peek-32 kd-cell 64) & "\n"
    in let l9 = "reacq kbd=" & show (peek-32 kd-cell 80) & " disk=" & show (peek-32 kd-cell 84) & " mount=" & show (peek-32 kd-cell 88) & "\n"
    in l1 & l1a & l1b & l1c & l2 & l3 & l4 & l5 & l6 & l7 & l8 & l9 & kd-ep-line 0

 `st` is the three-valued status and it comes FIRST: at zero the numbers
 after it were never taken, so they are not printed at all rather than
 printed as zeros a reader would take for measurements.

  kd-ep-line : Integer -> Text
  kd-ep-line (z) =
    let st = xdiag-get 64
    in if st == 0 then "EP st=0 NOT-READ\n"
    else let ask = xdiag-get 65
    in let got = xdiag-get 66
    in "EP st=" & show st & " bi=" & show (bit-and ask 65535) & " iv=" & show (bit-and got 65535) & " mp=" & show (bit-shru ask 16) & " es=" & show (bit-shru got 16) & " rt=" & show (xdiag-get 67) & " tt=" & show (bit-and (xdiag-get 68) 65535) & " sp=" & show (bit-and (xdiag-get 69) 255) & "\n"

  kd-file-write : GfatMount, UsbKbd, Integer -> [Device.Port] Integer
  kd-file-write (m) (k) (nbuf) = act
    if m.gm-ok == False then 0
    else if peek-32 kd-cell 40 >= 250 then 0
    else let sig = kd-sig 0
    in if sig == peek-32 kd-cell 44 then 0
    else act
      let buf = alloc-zeroed 4096 64
      in let body = kd-file-body k
      in let pw = kd-put-text buf body 0
      in act
        ok <- gfat-write-small-file (m.gm-vol) nbuf buf (text-length body)
        if ok then
          let a = kd-inc 40
          in poke-32 kd-cell 44 sig
        else 0
      end
    end
  end

 The same body renders as QR codes below the text (R-1 of
 TheSilentKeyboard.md): a photograph of the glass brings home exact
 bytes even when the machine cannot write one sector -- which on the
 ASUS it demonstrably cannot. The codes re-render whenever the
 counters change, independent of the disk; the human lines above
 them say whether the news is good, the codes say precisely what
 happened. Chunks carry "i/n;" prefixes for reassembly. Geometry
 reads the GOP handoff cells directly so the render needs no plumbing
 through the loop arguments.

  kd-qr-refresh : UsbKbd -> Integer
  kd-qr-refresh (k) =
    let sig = kd-sig 0
    in if sig == peek-32 kd-cell 96 then 0
    else let s96 = poke-32 kd-cell 96 sig
    in let base = boot-fb-base 0
    in let w = boot-fb-w 0
    in let h = boot-fb-h 0
    in let stride = boot-fb-stride 0
    in let body = kd-file-body k
    in let total = text-length body
    in let n = (total + 99) / 100
    in let qs = kd-qr-scale w n (if h >= 700 then 6 else 2)
    in let qy = if h >= 700 then 430 else 368
    in let clr = gop-fill-rect base stride 0 qy w (if h - qy < 310 then h - qy else 310) 1710638
    in kd-qr-chunks base stride qy qs body total n 0

 The panel is ONE row of codes, so the scale is chosen to make all of them
 fit rather than assumed. It used to be a constant 6 above 700 pixels, and
 at 1280x800 a five-chunk body put the last code at x=1216 with 270 pixels
 to draw: it ran off the glass and `qr-read.ps1` returned three chunks of
 five. Nothing in the render could report that, because a code drawn past
 the edge is not an error, it is just gone.

  kd-qr-scale : Integer, Integer, Integer -> Integer
  kd-qr-scale (w) (n) (s) =
    if s <= 1 then 1
    else if 40 + n * (45 * s + 24) <= w then s
    else kd-qr-scale w n (s - 1)

  kd-qr-chunks : Integer, Integer, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  kd-qr-chunks (base) (stride) (qy) (qs) (body) (total) (n) (i) =
    if i >= n then 0
    else let from = i * 100
    in let len = if total - from > 100 then 100 else total - from
    in let m = qr5-encode-part (show (i + 1) & "/" & show n & ";") body from len
    in let d = qr-draw base stride (40 + i * (45 * qs + 24)) qy qs m
    in kd-qr-chunks base stride qy qs body total n (i + 1)

 Only the disk usb-attach itself published is ever written: the
 selection cells are pinned to the USB medium before the mount, so
 the GPT walk, the ESP mount, and the file write all land on the boot
 stick. No published USB disk means no mount and no writes -- the
 probe still reads out on the glass.

  kd-mount : UsbAttach -> [Device.Port] GfatMount
  kd-mount (att) = act
    if (att.ua-disk).md-ok == False then GfatMount { gm-ok = False, gm-vol = gfat-null-vol }
    else let s = med-set med-kind-usb 0
    in act
      m <- gfat-mount-esp
      m
    end
  end

  kd-host : UsbAttach -> XhciHost
  kd-host (att) =
    if ((att.ua-kbd).uk-host).xh-ok then (att.ua-kbd).uk-host
    else (att.ua-disk).md-host

Section: Rendering

  krow : Integer, Integer, CbfFont, Integer, Integer, Text, Integer -> Integer
  krow (base) (stride) (font) (y) (scale) (s) (col) =
    gop-draw-text base stride font 40 y s col scale 0

  kd-phase-line : Integer -> Text
  kd-phase-line (d) =
    let ph = peek-32 kd-cell 56
    in if ph == 1 then "PHASE 1/3 USB pump - handback test in " & show ((540 - kd-tick-delta 0) / 18) & "s (hold keys NOW)"
    else if ph == 2 then "PHASE 2/3 HANDBACK rel=" & kyn (peek-32 kd-cell 68) & " reclaim=" & kyn (peek-32 kd-cell 72) & " PS2=" & show (peek-32 kd-cell 60) & " last=" & kh8 (peek-32 kd-cell 64) & " - press keys (PS/2 test), " & show ((360 - kd-tick-delta 0) / 18) & "s"
    else "PHASE 3/3 reacquired kbd=" & kyn (peek-32 kd-cell 80) & " disk=" & kyn (peek-32 kd-cell 84) & " mount=" & kyn (peek-32 kd-cell 88) & " - USB pump resumed (hold keys)"

 One controller entry per ordinal, and ONLY the ordinals the count names:
 the ASUS rendered a third entry of firmware leftovers because the row
 printed fixed slots 0-2 whatever n said.

  kd-ctl-ent : Integer -> Text
  kd-ctl-ent (i) =
    if i >= xdiag-get 40 then ""
    else " " & show i & ":" & kh32 (xdiag-get (48 + i * 4)) & " " & kh32 (xdiag-get (48 + i * 4 + 1)) & " st=" & show (xdiag-get (48 + i * 4 + 2))

 Two pump-time instruments were built here, bed-tested, and REMOVED, and
 the removal is the record: a GET_STATUS control transfer from the paint
 path, and a PORTSC read from the paint path. EACH ONE, independently,
 stops the paint chain dead after the row before it while the pump's own
 counters keep advancing -- measured on three builds at 1920x1080 under
 codex-vm -uefi, with the no-instrument build rendering every row every
 time. The pump path touches only RAM; these touched MMIO (and EP0) from
 inside the repaint. Until the mechanism is named, no row painted by this
 probe may read MMIO or issue a transfer.

 The OUTPUT endpoint context is the controller's, not ours: xHCI 6.2.3
 gives dword 0 bits 2:0 as EP State (0 disabled, 1 running, 2 halted,
 3 stopped, 4 error) and the qword at +8 as the current dequeue pointer
 with the cycle bit in bit 0. The controller updates these as it works,
 so on a board where the interrupt endpoint delivers nothing this row
 says WHICH silence it is: running with a parked dequeue, halted, error,
 or a context that was never copied out of the input at all.

  kd-stopx-line : Integer -> Text
  kd-stopx-line (z) =
    if peek-32 kx-cell 0 == 0 then ""
    else "  STOPX e=" & kyn (bit-shru (peek-32 kx-cell 4) 8) & " cc=" & show (bit-and (peek-32 kx-cell 4) 255) & " est=" & show (peek-32 kx-cell 12) & " dq=" & kh32 (bit-and (peek-32 kx-cell 8) (-16)) & " re=" & show (peek-32 kx-cell 16)

  kd-schedx-line : Integer -> Text
  kd-schedx-line (z) =
    if peek-32 kx-cell 0 == 0 then ""
    else "  SCHEDX p=" & kh32 (peek-32 kx-cell 20) & " pls=" & show (bit-and (bit-shru (peek-32 kx-cell 20) 5) 15) & " mf=+" & show (peek-32 kx-cell 24) & " f1=" & kh8 (peek-32 kx-cell 28)

  kd-s2-line : Integer -> Text
  kd-s2-line (z) =
    if peek-32 kx-cell 0 == 0 then ""
    else "  S2 e=" & kyn (bit-shru (peek-32 kx-cell 32) 8) & " cc=" & show (bit-and (peek-32 kx-cell 32) 255) & " dq2=" & kh32 (bit-and (peek-32 kx-cell 40) (-16)) & " f2=" & kh8 (peek-32 kx-cell 36)

  kd-rpt2 : Integer -> Text
  kd-rpt2 (base) = kh8 (bit-and (peek-32 kx-cell base) 255) & " " & kh8 (bit-and (bit-shru (peek-32 kx-cell base) 8) 255) & " " & kh8 (bit-and (bit-shru (peek-32 kx-cell base) 16) 255) & " " & kh8 (bit-and (bit-shru (peek-32 kx-cell base) 24) 255)

  kd-devx-line : Integer -> Text
  kd-devx-line (z) =
    if peek-32 kx-cell 44 == 0 then ""
    else let st = peek-32 kx-cell 48
    in "DEVX f=" & kh8 (bit-shru st 24) & " cfg=" & show (bit-and st 255) & " p=" & show (bit-and (bit-shru st 8) 255) & " i=" & show (bit-and (bit-shru st 16) 255) & " R2: " & kd-rpt2 60 & " " & kd-rpt2 64

  kd-epctx-line : UsbKbd -> Text
  kd-epctx-line (k) =
    if k.uk-ok == False then "EPCTX none"
    else let dctx = bit-and (peek-32 ((k.uk-host).xh-dcbaa) (((k.uk-dev).ud-slot) * 8)) (-64)
    in if dctx == 0 then "EPCTX dctx=0"
    else let ep = dctx + (k.uk-dci) * ((k.uk-host).xh-ctxsz)
    in let d0 = peek-32 ep 0
    in let dq = peek-32 ep 8
    in "EPCTX est=" & show (bit-and d0 7) & " dq=" & kh32 (bit-and dq (-16)) & " cyc=" & show (bit-and dq 1)

  kd-static : Integer, Integer, Integer, Integer, CbfFont, UsbAttach, GfatMount -> Integer
  kd-static (base) (w) (h) (stride) (font) (att) (m) =
    let k = att.ua-kbd
    in let scale = if w > 1280 then 2 else 1
    in let bg = gop-fill-rect base stride 0 0 w h 1710638
    in let rb = if k.uk-ok then poke-32 kd-cell 48 (bit-and (xhci-ring-trbs (k.uk-ring)) #FFFFFFFF) else 0
    in let t0 = krow base stride font 40 scale ("KBDDIAG v16  GEO w=" & show w & " h=" & show h & " stride=" & show stride & " fb=" & kh32 base & " sc=" & show scale) 65535
    in let t1 = krow base stride font 60 scale ("xHCI found=" & kyn (xdiag-get 1) & " CSZ=" & show (xdiag-get 6) & " PPC=" & show (xdiag-get 7) & " connected=" & show (xdiag-get 18) & " intel-route=" & kyn (xdiag-get 36)) 9474192
    in let t1b = krow base stride font 80 scale ("HOST id=" & kh32 (kd-host-id 0) & " run=" & kyn (xdiag-get 17) & " cnr=" & kyn (xdiag-get 16) & " reset=" & kyn (xdiag-get 15) & " slots=" & show (xdiag-get 13) & " ports=" & show (xdiag-get 14) & " HCC=" & kh32 (xdiag-get 5) & " xECP=" & show (xdiag-get 8)) (if xdiag-get 17 == 0 then 16755200 else 65280)
    in let t1c = krow base stride font 100 scale ("CTL n=" & show (xdiag-get 40) & kd-ctl-ent 0 & kd-ctl-ent 1 & kd-ctl-ent 2) 9474192
    in let t1d = krow base stride font 120 scale ("ATTR kbd-ctl=" & show (xdiag-get 44) & " disk-ctl=" & show (xdiag-get 43) & " up=" & show (xdiag-get 41) & " walked=" & kh8 (xdiag-get 42) & "   BAR=" & show (xdiag-get 30) & " " & kh32 (xdiag-get 32) & kh32 (xdiag-get 31)) (if kd-host-is-kbd 0 then 65280 else 16755200)
    in let t2 = krow base stride font 140 scale ("kbd uk-ok=" & kyn (if k.uk-ok then 1 else 0) & " slot=" & show ((k.uk-dev).ud-slot) & " dci=" & show (k.uk-dci) & " speed=" & show ((k.uk-dev).ud-speed)) (if k.uk-ok then 65280 else 16755200)
    in let t3 = krow base stride font 160 scale ("disk=" & kyn (if (att.ua-disk).md-ok then 1 else 0) & " mount=" & kyn (if m.gm-ok then 1 else 0) & "  findings -> KBDDIAG.TXT on the boot stick") (if m.gm-ok then 65280 else 16755200)
    in krow base stride font 180 scale "Hold a key in EACH phase. When done: PHOTOGRAPH THE QR CODES (exact bytes, no transcribing)." 9474192

  kd-paint : Integer, Integer, CbfFont, Integer, UsbKbd -> Integer
  kd-paint (base) (stride) (font) (scale) (k) =
    let cw = if stride - 80 < 1180 then stride - 80 else 1180
    in let clr = gop-fill-rect base stride 40 200 cw 220 1710638
    in let l1 = krow base stride font 200 scale ("p=" & show (peek-32 kd-cell 52) & " EPINT=" & show (peek-32 kd-cell 0) & "  EP0=" & show (peek-32 kd-cell 16) & "  OTH=" & show (peek-32 kd-cell 20) & "  LATCH=" & show (peek-32 kd-cell 24)) (if (peek-32 kd-cell 0) == 0 then 16755200 else 65280)
    in let l2 = krow base stride font 230 scale ("st=" & show (if k.uk-ok then peek-32 (k.uk-state) 0 else 9) & " code=" & kh8 (peek-32 kd-cell 8) & " resid=" & show (peek-32 kd-cell 36) & " ctl=" & kh32 (peek-32 kd-cell 28) & kd-stopx-line 0) 9474192
    in let l3 = krow base stride font 260 scale ("trb=" & kh32 (peek-32 kd-cell 32) & " ring=" & kh32 (peek-32 kd-cell 48) & "  " & kd-epctx-line k) 9474192
    in let l4 = krow base stride font 290 scale ("REPORT: " & krpt (k.uk-report) & kd-schedx-line 0) 16776960
    in let l5 = krow base stride font 320 scale ("SCANS=" & show (peek-32 kd-cell 4) & " last=" & kh8 (peek-32 kd-cell 12) & "  FILE-WRITES=" & show (peek-32 kd-cell 40) & kd-s2-line 0) 65535
    in let l6 = krow base stride font 350 scale ("p=" & show (peek-32 kd-cell 52) & " " & kd-phase-line 0) 16776960
    in krow base stride font 380 scale (kd-devx-line 0) 65280

Section: Phases

 The tick thresholds are the real clock (~90s and ~45s). The paint
 caps are escape hatches for tick-dead firmware only, sized ABOVE the
 tick path everywhere ticks work: with no USB keyboard the pump step
 is a single flag test and paints fly, so a low cap collapses a phase
 to seconds and a human never gets to press a key in it.

  kd-phase1-done : Integer -> Boolean
  kd-phase1-done (d) =
    if peek-32 kd-cell 56 /= 1 then False
    else if kd-tick-delta 0 >= 540 then True
    else peek-32 kd-cell 52 >= 20000

  kd-phase2-done : Integer -> Boolean
  kd-phase2-done (d) =
    if kd-tick-delta 0 >= 360 then True
    else peek-32 kd-cell 52 >= 10000

  kd-loop1 : UsbAttach, GfatMount, Integer, Integer, Integer, CbfFont, Integer -> [Device.Port] Integer
 Every iteration allocates ONLY transients -- row texts, the file body,
 QR matrices, the write sector buffers -- and on bare metal nothing
 frees them. Unbracketed, the loop exhausts the heap in about 2,400
 paints: the v14 metal freeze at p=2428 and every bed #UD under
 -hid-nak were this one OOM wearing two costumes (the #UD is the
 bounds trap of QR code fed a failed allocation). Everything that
 must survive an iteration -- att, m, nbuf, the counters -- was
 allocated before the loop or lives in fixed cells, so the bracket is
 total.

  kd-loop1 (att) (m) (nbuf) (base) (stride) (font) (scale) = act
    let hp = __heap-save
    in let z = kd-spin (att.ua-kbd) 300000
    in let sx = kd-schedx (att.ua-kbd)
    in let dx = kd-devx (att.ua-kbd)
    in act
      fw <- kd-file-write m (att.ua-kbd) nbuf
      let d = kd-paint base stride font scale (att.ua-kbd)
      in let q = kd-qr-refresh (att.ua-kbd)
      in let pc = kd-inc 52
      in let hr = __heap-restore hp
      in if kd-phase1-done 0 then kd-phase2 att m nbuf base stride font scale
      else kd-loop1 att m nbuf base stride font scale
    end
  end

  kd-phase2 : UsbAttach, GfatMount, Integer, Integer, Integer, CbfFont, Integer -> [Device.Port] Integer
  kd-phase2 (att) (m) (nbuf) (base) (stride) (font) (scale) = act
    let r = xr-release (kd-host att)
    in let p = poke-32 kd-cell 56 2
    in let t = kd-mark-tick 0
    in let pc = poke-32 kd-cell 52 0
    in let drain = gk-take 0
    in let d = kd-paint base stride font scale (att.ua-kbd)
    in kd-loop2 att m nbuf base stride font scale
  end

  kd-loop2 : UsbAttach, GfatMount, Integer, Integer, Integer, CbfFont, Integer -> [Device.Port] Integer
  kd-loop2 (att) (m) (nbuf) (base) (stride) (font) (scale) = act
    let hp = __heap-save
    in act
      s2 <- kd-spin2 300000
      let rl = kd-reclaim-recheck 0
      in let d = kd-paint base stride font scale (att.ua-kbd)
      in let q = kd-qr-refresh (att.ua-kbd)
      in let pc = kd-inc 52
      in let hr = __heap-restore hp
      in if kd-phase2-done 0 then kd-phase3 nbuf base stride font scale
      else kd-loop2 att m nbuf base stride font scale
    end
  end

  kd-phase3 : Integer, Integer, Integer, CbfFont, Integer -> [Device.Port] Integer
  kd-phase3 (nbuf) (base) (stride) (font) (scale) = act
    att <- usb-attach
    m <- kd-mount att
    let k = att.ua-kbd
    in let p = poke-32 kd-cell 56 3
    in let t = kd-mark-tick 0
    in let pc = poke-32 kd-cell 52 0
    in let rk = poke-32 kd-cell 80 (if k.uk-ok then 1 else 0)
    in let rd = poke-32 kd-cell 84 (if (att.ua-disk).md-ok then 1 else 0)
    in let rm = poke-32 kd-cell 88 (if m.gm-ok then 1 else 0)
    in let rb = if k.uk-ok then poke-32 kd-cell 48 (bit-and (xhci-ring-trbs (k.uk-ring)) #FFFFFFFF) else 0
    in let fs = poke-32 kd-cell 44 #FFFFFFFF
    in kd-loop1 att m nbuf base stride font scale
  end

  opening : [Device.Port, Device.Mmio] Integer
  opening =
    let base = boot-fb-base 0
    in let w = boot-fb-w 0
    in let h = boot-fb-h 0
    in let stride = boot-fb-stride 0
    in let font = cbf-init
    in let scale = if w > 1280 then 2 else 1
    in act
      ri <- runtime-init 0
      att <- usb-attach
      m <- kd-mount att
      let nbuf = alloc-zeroed 16 16
      in let nw = kd-put-text nbuf "KBDDIAG TXT" 0
      in let zz = kd-zero
      in let t0 = kd-mark-tick 0
      in let d0 = kd-static base w h stride font att m
      in kd-loop1 att m nbuf base stride font scale
    end
