  cites Works chapter GopShot

 We say:

  pnib : Integer -> Text
  pnib (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

  phx : Integer, Integer -> Text
  phx (v) (sh) = pnib (bit-and (bit-shru v sh) 15)

  phw : Integer -> Text
  phw (v) = phx v 28 & phx v 24 & phx v 20 & phx v 16 & phx v 12 & phx v 8 & phx v 4 & phx v 0

  ph32 : Integer -> Text
  ph32 (v) = "#" & phw v

  pyn : Integer -> Text
  pyn (v) = if v == 0 then "n" else "y"

  p16 : Integer -> Text
  p16 (v) = phx v 12 & phx v 8 & phx v 4 & phx v 0

  pst : Integer -> Text
  pst (v) =
    if v == 0 then "NEVER-OPENED"
    else if v == 1 then "BRINGUP-FAILED"
    else "running"

  pfnd : Integer -> Text
  pfnd (v) = "kbd=" & pyn (bit-and v 1) & " mouse=" & pyn (bit-and v 2) & " disk=" & pyn (bit-and v 4)

  pwhere : Integer -> Text
  pwhere (loc) = show (bit-shru loc 16) & ":" & show (bit-and (bit-shru loc 8) 255) & "." & show (bit-and loc 7)

  pctl-line : Integer, Integer, Integer, Integer, Integer -> Text
  pctl-line (i) (id) (loc) (st) (fm) =
    let who = p16 (bit-shru id 16) & ":" & p16 (bit-and id 65535)
    in "ctl" & show i & " " & who & " at " & pwhere loc & " " & pst st & " " & pfnd fm

  pctls : Integer, Integer, CbfFont, Integer, Integer, Integer -> Integer
  pctls (base) (stride) (font) (scale) (i) (n) =
    if i >= 4 then 0
    else if i >= n then 0
    else let st = xdiag-get (48 + i * 4 + 2)
    in let line = pctl-line i (xdiag-get (48 + i * 4)) (xdiag-get (48 + i * 4 + 1)) st (xdiag-get (48 + i * 4 + 3))
    in let t = prow base stride 40 font (440 + i * 20) scale line (if st == 2 then 65280 else 16755200)
    in pctls base stride font scale (i + 1) n

  pepok : Integer -> Boolean
  pepok (st) = st == 2

  pep1 : Integer -> Text
  pep1 (st) =
    if st == 0 then "HID EP: NOT READ -- endpoint never configured"
    else let ask = xdiag-get 65
    in let got = xdiag-get 66
    in "HID EP: bInterval asked=" & show (bit-and ask 65535) & " -> Interval set=" & show (bit-and got 65535)

  pep2 : Integer -> Text
  pep2 (st) =
    if st == 0 then "        (no descriptor fields were taken)"
    else let ask = xdiag-get 65
    in let got = xdiag-get 66
    in "        wMaxPacket asked=" & show (bit-shru ask 16) & " -> MaxESIT set=" & show (bit-shru got 16)

  pmsc-rung : Integer -> Text
  pmsc-rung (r) =
    if r == 0 then "0 NO MASS-STORAGE INTERFACE SEEN"
    else if r == 1 then "1 interface seen, NO BULK PAIR"
    else if r == 2 then "2 bulk pair found, SET-CONFIG REFUSED"
    else if r == 3 then "3 configured, CONFIGURE-ENDPOINT REFUSED"
    else if r == 4 then "4 endpoints up, NEVER CAME READY"
    else if r == 5 then "5 ready, CAPACITY REFUSED OR NOT 512-BYTE"
    else "6 disk usable"

  pmsc1 : Integer -> Text
  pmsc1 (r) = "MSC: rung=" & pmsc-rung r

  pmsc2 : Integer -> Text
  pmsc2 (r) =
    let ce = xdiag-get 71
    in let cet = if ce == 0 then "not issued" else if ce == 256 then "no event" else show ce
    in "     cfgv=" & show (xdiag-get 74) & " cfgep=" & cet & " blocksize=" & show (xdiag-get 72) & " sectors=" & show (xdiag-get 73)

 The completion code of the SET_CONFIGURATION itself, named rather than
 numbered: a photograph should not need the spec beside it. Zero is the
 fuel running out with no event at all, which is not a refusal and must
 not read as one.

  pcc : Integer -> Text
  pcc (c) =
    if c == 0 then "NO EVENT (fuel)"
    else if c == 256 then "NO EVENT (fuel)"
    else if c == 1 then "success"
    else if c == 4 then "USB TRANSACTION ERROR"
    else if c == 5 then "TRB ERROR"
    else if c == 6 then "STALL"
    else if c == 17 then "PARAMETER ERROR"
    else "code " & show c

  pmsc3 : Integer -> Text
  pmsc3 (r) =
    let w = xdiag-get 75
    in let ord = bit-and w 255
    in let ordt = if ord == 0 then "?" else show (ord - 1)
    in "     dev on ctl" & ordt & " port=" & show (bit-and (bit-shru w 8) 255) & " speed=" & show (bit-and (bit-shru w 16) 255) & " slot=" & show (bit-shru w 24) & " route=#" & phw (xdiag-get 76)

  pmsc4 : Integer -> Text
  pmsc4 (r) =
    let c2 = xdiag-get 79
    in let retry = if c2 == 0 then "" else "  retry: " & pcc c2
    in "     SET-CONFIG completion: " & pcc (xdiag-get 77) & retry

 The device's own port register, decoded. PED is the field to read against
 a transfer that failed on the wire: a port holding a device without being
 ENABLED explains a transaction error that no reading of the driver will.

  pmsc5 : Integer -> Text
  pmsc5 (r) =
    let raw = xdiag-get 78
    in if raw == 0 then "     dev PORTSC: not taken"
    else "     dev PORTSC=" & ph32 raw & " CCS=" & pyn (bit-and raw 1) & " PED=" & pyn (bit-and (bit-shru raw 1) 1) & " PR=" & pyn (bit-and (bit-shru raw 4) 1) & " spd=" & show (bit-and (bit-shru raw 10) 15)

  pep3 : Integer -> Text
  pep3 (st) =
    if st == 0 then "        (no route, TT or speed recorded)"
    else let tt = xdiag-get 68
    in let sd = xdiag-get 69
    in let tts = bit-and tt 65535
    in "        speed=" & show (bit-and sd 255) & " dci=" & show (bit-and (bit-shru sd 8) 255) & " route=#" & phw (xdiag-get 67) & " TT=" & pyn tts & " slot=" & show tts & (if st == 1 then "  CONFIGURE FAILED" else "")

  prow : Integer, Integer, Integer, CbfFont, Integer, Integer, Text, Integer -> Integer
  prow (base) (stride) (x) (font) (y) (scale) (s) (col) =
    gop-draw-text base stride font x y s col scale 0

  pports : Integer, Integer, CbfFont, Integer, Integer, Integer -> Integer
  pports (base) (stride) (font) (scale) (i) (n) =
    if i >= n then 0
    else if i >= 8 then 0
    else let raw = xdiag-get (20 + i)
    in let ccs = bit-and raw 1
    in let line = "port" & show i & " PORTSC=" & ph32 raw & " CCS=" & pyn ccs & " PED=" & pyn (bit-and (bit-shru raw 1) 1) & " PR=" & pyn (bit-and (bit-shru raw 4) 1) & " spd=" & show (bit-and (bit-shru raw 10) 15)
    in let t = prow base stride 40 font (200 + i * 20) scale line (if ccs == 0 then 9474192 else 65280)
    in pports base stride font scale (i + 1) n

  pdraw : Integer, Integer, Integer, Integer, CbfFont -> Integer
  pdraw (base) (w) (h) (stride) (font) =
    let scale = if w >= 1024 then 2 else 1
    in let bg = gop-fill-rect base stride 0 0 w h 1710638
    in let t0 = prow base stride 40 font 40 scale "xHCI TRUTH PROBE" 65535
    in let t1 = prow base stride 40 font 80 scale ("controller " & ph32 (xdiag-get 2) & ":" & ph32 (xdiag-get 3) & " found=" & pyn (xdiag-get 1) & " caplen=" & show (xdiag-get 4)) 65280
    in let t2 = prow base stride 40 font 100 scale ("HCCPARAMS1=" & ph32 (xdiag-get 5) & " CSZ=" & show (xdiag-get 6) & " PPC=" & show (xdiag-get 7) & " xECP=" & show (xdiag-get 8)) 9474192
    in let t3 = prow base stride 40 font 120 scale ("legsup=" & pyn (xdiag-get 9) & " before=" & ph32 (xdiag-get 10) & " after=" & ph32 (xdiag-get 11) & " released=" & pyn (xdiag-get 12)) 9474192
    in let t4 = prow base stride 40 font 140 scale ("slots=" & show (xdiag-get 13) & " ports=" & show (xdiag-get 14) & " reset=" & pyn (xdiag-get 15) & " cnr=" & pyn (xdiag-get 16) & " run=" & pyn (xdiag-get 17) & " connected=" & show (xdiag-get 18)) 16777215
    in let t4b = prow base stride 40 font 160 scale ("BAR verdict=" & show (xdiag-get 30) & " judged=#" & phw (xdiag-get 32) & "_" & phw (xdiag-get 31) & " op=" & ph32 (xdiag-get 19)) 16777215
    in let t5 = prow base stride 40 font 180 scale ("root ports, first 8 only. connected=#" & phw (xdiag-get 46) & " (bit N = port N):") 9474192
    in pports base stride font scale 0 (xdiag-get 14)

  opening : [Device.Port, Device.Mmio] Integer
  opening =
    let base = boot-fb-base 0
    in let w = boot-fb-w 0
    in let h = boot-fb-h 0
    in let stride = boot-fb-stride 0
    in let font = cbf-init
    in act
      ri <- runtime-init 0
      att <- usb-attach
      let d = pdraw base w h stride font
      in let sc = if w >= 1024 then 2 else 1
      in let e = prow base stride 40 font 400 sc ("ENUMERATED  kbd=" & pyn (if (att.ua-kbd).uk-ok then 1 else 0) & "  mouse=" & pyn (if (att.ua-mouse).um-ok then 1 else 0) & "  disk=" & pyn (if (att.ua-disk).md-ok then 1 else 0)) 16776960
      in let hs = prow base stride 40 font 420 sc ("xHCI seen=" & show (xdiag-get 40) & " opened=" & show (xdiag-get 41) & " walked=#" & phw (xdiag-get 42) & " disk-on-ctl=" & show (xdiag-get 43) & " kbd-on-ctl=" & show (xdiag-get 44)) 16776960
      in let cl = pctls base stride font sc 0 (xdiag-get 40)
      in let est = xdiag-get 64
      in let ep1 = prow base stride 40 font 520 sc (pep1 est) (if pepok est then 65280 else 16755200)
      in let ep2 = prow base stride 40 font 540 sc (pep2 est) (if pepok est then 9474192 else 16755200)
      in let ep3 = prow base stride 40 font 560 sc (pep3 est) (if pepok est then 9474192 else 16755200)
      in let mr = xdiag-get 70
      in let m1 = prow base stride 40 font 600 sc (pmsc1 mr) (if mr == 6 then 65280 else 16755200)
      in let m2 = prow base stride 40 font 620 sc (pmsc2 mr) 9474192
      in let m3 = prow base stride 40 font 640 sc (pmsc3 mr) 9474192
      in let m4 = prow base stride 40 font 660 sc (pmsc4 mr) (if mr == 6 then 9474192 else 16776960)
      in let m5 = prow base stride 40 font 680 sc (pmsc5 mr) 9474192
      in shot-wait base w h stride font (att.ua-kbd)
    end
