Section: Risk

  diag-risk-passive : Integer = 0
  diag-risk-touches : Integer = 1
  diag-risk-writes : Integer = 2
  diag-risk-may-wedge : Integer = 3

  diag-risk-name : Integer -> Text
  diag-risk-name (r) =
    if r == 0 then "passive"
    else if r == 1 then "touches"
    else if r == 2 then "writes"
    else "may-wedge"

Section: World

  diag-world-ebs : Integer = 0
  diag-world-uefi : Integer = 1

  diag-world-name : Integer -> Text
  diag-world-name (w) = if w == diag-world-uefi then "UEFI" else "EBS"

