Section: Context

  DiagCtx = record {
    dc-base : Integer,
    dc-w : Integer,
    dc-h : Integer,
    dc-stride : Integer,
    dc-scale : Integer,
    dc-font : CbfFont,
    dc-world : Integer,
    dc-id : Text,
    dc-kernel : Text,
    dc-cfg : List Text,
    dc-cfg-src : Text,
    dc-pci : PciScanResult,
    dc-box : Text,
    dc-ram : Text,
    dc-bank : Boolean,
    dc-vol : Fat16Volume,
    dc-lines : List Text,
    dc-slot-x : Integer,
    dc-slot-y : Integer,
    dc-slot-w : Integer,
    dc-slot-h : Integer
  }

  diag-ctx-with-slot : DiagCtx, Integer, Integer, Integer, Integer -> DiagCtx
  diag-ctx-with-slot (c) (x) (y) (w) (h) =
    DiagCtx { dc-base = c.dc-base, dc-w = c.dc-w, dc-h = c.dc-h, dc-stride = c.dc-stride, dc-scale = c.dc-scale, dc-font = c.dc-font, dc-world = c.dc-world, dc-id = c.dc-id, dc-kernel = c.dc-kernel, dc-cfg = c.dc-cfg, dc-cfg-src = c.dc-cfg-src, dc-pci = c.dc-pci, dc-box = c.dc-box, dc-ram = c.dc-ram, dc-bank = c.dc-bank, dc-vol = c.dc-vol, dc-lines = c.dc-lines, dc-slot-x = x, dc-slot-y = y, dc-slot-w = w, dc-slot-h = h }

  diag-ctx-with-lines : DiagCtx, List Text -> DiagCtx
  diag-ctx-with-lines (c) (lines) =
    DiagCtx { dc-base = c.dc-base, dc-w = c.dc-w, dc-h = c.dc-h, dc-stride = c.dc-stride, dc-scale = c.dc-scale, dc-font = c.dc-font, dc-world = c.dc-world, dc-id = c.dc-id, dc-kernel = c.dc-kernel, dc-cfg = c.dc-cfg, dc-cfg-src = c.dc-cfg-src, dc-pci = c.dc-pci, dc-box = c.dc-box, dc-ram = c.dc-ram, dc-bank = c.dc-bank, dc-vol = c.dc-vol, dc-lines = lines, dc-slot-x = c.dc-slot-x, dc-slot-y = c.dc-slot-y, dc-slot-w = c.dc-slot-w, dc-slot-h = c.dc-slot-h }

Section: Result

  DiagResult = record {
    dr-state : Text,
    dr-colour : Integer,
    dr-glass : List Text,
    dr-bank : List Text
  }

  diag-result : Text, Integer, List Text, List Text -> DiagResult
  diag-result (state) (colour) (glass) (bank) =
    DiagResult { dr-state = state, dr-colour = colour, dr-glass = glass, dr-bank = bank }

Section: Bank Notes

 gfat has no append, so a bank is a whole-file rewrite: the lines the ladder
 has banked so far, then whatever is being added, then END. A stage that
 wants its progress on the medium mid-run rewrites the file with its own
 note on the end; the ladder rewrites it again when the stage returns, so a
 note lives on the medium exactly as long as the stage is between it and
 its result, which is the interval a wedge freezes.

  dg-name-buf : Integer -> Integer
  dg-name-buf (dummy) =
    let nb = alloc-zeroed 16 16
    in let a = poke-byte nb 0 68
    in let b = poke-byte nb 1 73
    in let c = poke-byte nb 2 65
    in let d = poke-byte nb 3 71
    in let e = poke-byte nb 4 32
    in let f = poke-byte nb 5 32
    in let g = poke-byte nb 6 32
    in let h = poke-byte nb 7 32
    in let i = poke-byte nb 8 84
    in let j = poke-byte nb 9 88
    in let k = poke-byte nb 10 84
    in nb

  dg-fill : Integer, Text, Integer, Integer -> Integer
  dg-fill (buf) (s) (i) (n) =
    if i >= n then i
    else let b = poke-byte buf i (to-unicode (char-code-at s i))
    in dg-fill buf s (i + 1) n

  dg-join : List Text, Integer, List Text -> List Text
  dg-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else dg-join xs (i + 1) (list-push (list-push acc (list-at xs i)) "\n")

  dg-body : List Text -> Text
  dg-body (lines) = text-concat-list (list-push (dg-join lines 0 []) "END")

 to-unicode retains about a kilobyte per call and gfat-write-file loads the
 FAT onto the heap, so both are taken under a mark and released; only the
 byte buffer, allocated before the mark, survives to be written. That buffer
 is permanent per call, so a stage banking a note per step spends one file's
 length of heap per step.

  diag-bank-write-vol : Fat16Volume, List Text -> [Device.Port] Integer
  diag-bank-write-vol (vol) (lines) = diag-bank-write-text vol (dg-body lines)

  diag-bank-write-text : Fat16Volume, Text -> [Device.Port] Integer
  diag-bank-write-text (vol) (body) = act
    let n = text-length body
    in let buf = alloc-zeroed (n + 1024) 64
    in let nb = dg-name-buf 0
    in let mark = __heap-save
    in let f = dg-fill buf body 0 n
    in let r = __heap-restore mark
    in let mark2 = __heap-save
    in act
      ok <- gfat-write-file vol nb buf n
      let r2 = __heap-restore mark2
      in if ok == False then -1
      else act
        sz <- gfat-file-size vol "DIAG.TXT"
        let v = gfat-note-lastsize sz
        in if sz == n then n else -1
      end
    end
  end

 A note APPENDS to what is on the medium, not to what the ladder banked before
 the stage: the ctx's lines are fixed for the stage's whole run, so a note built
 on them replaces the note before it, and sitting 10 came back with
 "stage=b3 step=reset" and no clock row, the control erased by the step after
 it. The file is read back, its END stripped, the note added, and the whole
 written again; a file that cannot be read back is written from the ctx's
 lines as before, so a bank that never opened is still not a crash.

 THE FILE IS NEVER TURNED INTO TEXT. `gfat-text` appends one character at a
 time, so it leaves every prefix of the file on a bump heap: about eleven
 megabytes for a 4.8 KB bank, and the first version of this note did it once
 per step until the seventh note walked the heap into the stack (EXC=06 at a
 garbage RIP, R10 past RBP). The bytes are copied as bytes: the file's own
 bytes less a trailing END, the note, a newline, END. One buffer per note is
 the whole permanent cost, as for any other bank write.

  diag-note-bytes : Fat16Volume, Text -> [Device.Port] Integer
  diag-note-bytes (vol) (note) = act
    f <- gfat-read-file vol "DIAG.TXT"
    if f.gf-ok == False then -1
    else let keep = diag-keep-len (f.gf-buf) (f.gf-len)
    in let tail = note & "\n" & "END"
    in let n = keep + text-length tail
    in let buf = alloc-zeroed (n + 1024) 64
    in let nb = dg-name-buf 0
    in let c = diag-copy-bytes (f.gf-buf) buf 0 keep
    in let mark = __heap-save
    in let w = dg-fill-at buf keep tail 0 (text-length tail)
    in let r = __heap-restore mark
    in let mark2 = __heap-save
    in act
      ok <- gfat-write-file vol nb buf n
      let r2 = __heap-restore mark2
      in if ok == False then -1
      else act
        sz <- gfat-file-size vol "DIAG.TXT"
        let v = gfat-note-lastsize sz
        in if sz == n then n else -1
      end
    end
  end

  diag-keep-len : Integer, Integer -> Integer
  diag-keep-len (buf) (n) =
    if n >= 3 & peek-byte buf (n - 3) == 69 & peek-byte buf (n - 2) == 78 & peek-byte buf (n - 1) == 68 then n - 3
    else if n > 0 & peek-byte buf (n - 1) /= 10 then n
    else n

  diag-copy-bytes : Integer, Integer, Integer, Integer -> Integer
  diag-copy-bytes (src) (dst) (i) (n) =
    if i >= n then i
    else let w = poke-byte dst i (peek-byte src i)
    in diag-copy-bytes src dst (i + 1) n

  dg-fill-at : Integer, Integer, Text, Integer, Integer -> Integer
  dg-fill-at (buf) (at) (s) (i) (n) =
    if i >= n then i
    else let b = poke-byte buf (at + i) (to-unicode (char-code-at s i))
    in dg-fill-at buf at s (i + 1) n

  diag-bank-note : DiagCtx, Text -> [Device.Port] Integer
  diag-bank-note (c) (note) = act
    if c.dc-bank == False then -1
    else act
      n <- diag-note-bytes (c.dc-vol) note
      if n >= 0 then n
      else diag-bank-write-vol (c.dc-vol) (list-push (c.dc-lines) note)
    end
  end

Section: Hex

  diag-nib : Integer -> Text
  diag-nib (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

  diag-hex2 : Integer -> Text
  diag-hex2 (v) = diag-nib (bit-and (bit-shru v 4) 15) & diag-nib (bit-and v 15)

  diag-hex4 : Integer -> Text
  diag-hex4 (v) = diag-hex2 (bit-and (bit-shru v 8) 255) & diag-hex2 (bit-and v 255)

  diag-hex8 : Integer -> Text
  diag-hex8 (v) = diag-hex4 (bit-and (bit-shru v 16) 65535) & diag-hex4 (bit-and v 65535)

Section: Bytes To Text

 ASCII from a table or a descriptor: printable bytes become text, anything
 else becomes a dot so a length stays a length, and the read stops at NUL or
 the cap. from-unicode is the boundary conversion (R-CCE).

  diag-ascii : Integer, Integer, Integer, Text -> Text
  diag-ascii (buf) (i) (n) (acc) =
    if i >= n then acc
    else let b = peek-byte buf i
    in if b == 0 then acc
    else if b < 32 then diag-ascii buf (i + 1) n (acc & ".")
    else if b > 126 then diag-ascii buf (i + 1) n (acc & ".")
    else diag-ascii buf (i + 1) n (acc & char-to-text (code-to-char (from-unicode b)))

  diag-trim-right : Text, Integer -> Text
  diag-trim-right (s) (n) =
    if n <= 0 then ""
    else if char-code-at s (n - 1) == char-code-at " " 0 then diag-trim-right s (n - 1)
    else if char-code-at s (n - 1) == char-code-at "." 0 then diag-trim-right s (n - 1)
    else substring s 0 n

Section: Config

  diag-cfg-find : List Text, Integer, Text -> Text
  diag-cfg-find (cfg) (i) (name) =
    if i >= list-length cfg then ""
    else let line = list-at cfg i
    in if text-starts-with line (name & " ") then substring line (text-length name + 1) (text-length line - text-length name - 1)
    else if line == name then "on"
    else diag-cfg-find cfg (i + 1) name

  diag-cfg-value : DiagCtx, Text -> Text
  diag-cfg-value (c) (name) = diag-cfg-find (c.dc-cfg) 0 name
