 The stub pre-loads DIAG.CFG text into the serial input ring: bytes at
 0x500000, the write position in the quadword at 28704, the read position at
 28712 (cdx-to-pe.ps1 -Stdin; X86_64Boot.codex serial-ring-buf-addr). The
 SystemTable cell at 30704 is primed by the stub and zeroed after
 ExitBootServices, so a zero there is the EBS world and anything else is
 firmware still alive.

 We say:

Section: Cells

  dg-ring-buf : Integer = 5242880
  dg-ring-wpos : Integer = 28704
  dg-ring-rpos : Integer = 28712
  dg-ring-cap : Integer = 120
  dg-systab-cell : Integer = 30704

Section: Hold

 The ladder never returns. A bare self-call spins in a two-instruction loop
 that the runtime spine's watchdog reads as a hung guest (no heap or RIP
 movement) and panics after its window, ending the boot with a WD! dump on
 serial. In pet mode every function prologue pets the watchdog, so the hold
 calls a real function each turn and paints a heartbeat square at the band's
 right edge, which is also what tells a photograph the machine is alive.

  dg-beat : DiagCtx, Integer -> Integer
  dg-beat (c) (n) =
    if int-mod n 262144 /= 0 then 0
    else let on = int-mod (n / 262144) 2 == 0
    in gop-fill-rect (c.dc-base) (c.dc-stride) ((c.dc-w) - 24) (dg-row-y c (dg-band-row 0) + 4) 16 16 (if on then diag-col-good else diag-col-bg)

  dg-hold : DiagCtx, Integer -> Integer
  dg-hold (c) (n) = dg-hold c (n + 1 + dg-beat c n)

Section: The Table

  dg-stage-count : Integer = 16

  dg-stage-name : Integer -> Text
  dg-stage-name (i) =
    if i == 1 then "smbios"
    else if i == 2 then "edid"
    else if i == 3 then "cpu"
    else if i == 4 then "pci"
    else if i == 5 then "scene"
    else if i == 6 then "gopmode"
    else if i == 7 then "block"
    else if i == 8 then "xhci"
    else if i == 9 then "sink"
    else if i == 10 then "pch"
    else if i == 11 then "nicsit"
    else if i == 12 then "nicinit"
    else if i == 13 then "nicring"
    else if i == 14 then "b3"
    else if i == 15 then "pchk1"
    else if i == 16 then "asde"
    else "?"

 Stages are numbered in ladder order (the design's risk order): the passive
 ones first, then the bank opens, then the rest. Both tables below are by
 stage number, and a lift that adds the first non-passive stage extends this
 one rather than the run loop.

  dg-stage-risk : Integer -> Integer
  dg-stage-risk (i) = if i == 8 then diag-risk-passive else if i == 10 | i == 11 | i == 15 then diag-risk-touches else if i >= 7 then diag-risk-writes else diag-risk-passive

  dg-stage-run : DiagCtx, Integer -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagResult
  dg-stage-run (c) (i) =
    if i == 1 then dsm-run c
    else if i == 2 then ded-run c
    else if i == 3 then dcpu-run c
    else if i == 4 then dpci-run c
    else if i == 5 then dsc-run c
    else if i == 6 then dgop-run c
    else if i == 7 then dbl-run c
    else if i == 8 then dxh-run c
    else if i == 9 then dsk-run c
    else if i == 10 then dpch-run c
    else if i == 11 then nsi-run c
    else if i == 12 then nii-run c
    else if i == 13 then nir-run c
    else if i == 14 then db3-run c
    else if i == 15 then dpk-run c
    else if i == 16 then dasd-run c
    else diag-result "unknown" diag-col-bad ["no such stage"] ["no such stage"]

  dg-stage-picture : Integer -> Boolean
  dg-stage-picture (i) = i == 5 | i == 16

  dg-stage-rows : Integer -> Integer
  dg-stage-rows (i) = if dg-stage-picture i then 3 else 2

  dg-stage-enabled : DiagCtx, Integer -> Boolean
  dg-stage-enabled (c) (i) = diag-cfg-value c (dg-stage-name i) /= "off"

  dg-stage-defers : Integer -> Boolean
  dg-stage-defers (i) = i == 9

Section: Ring

  dg-ring-loop : Integer, Integer, Text -> Text
  dg-ring-loop (i) (n) (acc) =
    if i >= n then acc
    else let b = peek-byte dg-ring-buf i
    in if b == 0 then acc
    else let cp = from-unicode b
    in if cp < 0 then dg-ring-loop (i + 1) n acc
    else dg-ring-loop (i + 1) n (acc & char-to-text (code-to-char cp))

  dg-ring-text : Integer -> Text
  dg-ring-text (dummy) =
    let wpos = peek-qword dg-ring-wpos 0
    in let rpos = peek-qword dg-ring-rpos 0
    in if wpos <= rpos then ""
    else if wpos - rpos > dg-ring-cap then ""
    else dg-ring-loop rpos wpos ""

  dg-cfg-lines : Text -> List Text
  dg-cfg-lines (t) = if text-length t == 0 then [] else dg-cfg-keep (text-split t "\n") 0 []

  dg-cfg-keep : List Text, Integer, List Text -> List Text
  dg-cfg-keep (xs) (i) (acc) =
    if i >= list-length xs then acc
    else let l = list-at xs i
    in dg-cfg-keep xs (i + 1) (if text-length l == 0 then acc else list-push acc l)

Section: Geometry

  dg-row-h : DiagCtx -> Integer
  dg-row-h (c) = 16 * (c.dc-scale)

  dg-row-y : DiagCtx, Integer -> Integer
  dg-row-y (c) (row) = 8 + row * dg-row-h c

  dg-cols : DiagCtx, Integer, Integer -> Integer
  dg-cols (c) (x) (xend) = (xend - x - 8) / (8 * (c.dc-scale))

  dg-fit : DiagCtx, Integer, Integer, Text -> Text
  dg-fit (c) (x) (xend) (s) =
    let n = dg-cols c x xend
    in if text-length s <= n then s
    else if n < 4 then ""
    else substring s 0 (n - 3) & "..."

  dg-text-to : DiagCtx, Integer, Integer, Text, Integer, Integer -> Integer
  dg-text-to (c) (x) (y) (s) (col) (xend) = gop-draw-text (c.dc-base) (c.dc-stride) (c.dc-font) x y (dg-fit c x xend s) col (c.dc-scale) 0

  dg-text : DiagCtx, Integer, Integer, Text, Integer -> Integer
  dg-text (c) (x) (y) (s) (col) = dg-text-to c x y s col (c.dc-w)

  dg-clear-rows : DiagCtx, Integer, Integer -> Integer
  dg-clear-rows (c) (row) (n) = gop-fill-rect (c.dc-base) (c.dc-stride) 0 (dg-row-y c row) (c.dc-w) (n * dg-row-h c) diag-col-bg

  dg-stage-row : Integer -> Integer
  dg-stage-row (i) = dg-rows-before 1 i 4

  dg-rows-before : Integer, Integer, Integer -> Integer
  dg-rows-before (k) (i) (acc) = if k >= i then acc else dg-rows-before (k + 1) i (acc + dg-stage-rows k)

  dg-text-end : DiagCtx, Integer -> Integer
  dg-text-end (c) (i) = if dg-stage-picture i then ((c.dc-w) * 2) / 3 - 8 else c.dc-w

 EVERY STAGE GETS A SLOT IT CAN ACTUALLY PAINT, which it did not until
 2026-08-21. The grant used to be `dg-text-end c i + 8` wide by
 `dc-w - dg-text-end c i - 16`, and `dg-text-end` answers `dc-w` for every stage
 that is not one of the two picture stages. So a non-picture stage was handed
 **x = dc-w + 8 and w = -16**, and that is arithmetic rather than a geometry
 accident: it is -16 at 1024 wide, at 1920 wide, and at every width, because the
 two `dc-w` terms cancel. Measured off the bed with b3 at 1024x768: x=1032,
 w=-16, cols=-3.

 What that cost is the whole class of instrument, silently. A fill of negative
 width paints nothing and a fitter given negative columns answers the empty
 string, so a stage that painted its step to the glass compiled clean, printed
 its serial line, and put NOTHING on the screen. b3 hung on the 2026-08-21
 flight and the glass could not say which step it was inside, because the ASUS
 has no serial port and the step line's only other channel had been silently
 discarded since it was written.

 A NON-PICTURE STAGE NOW GETS ITS OWN ROW: x=8, the full width less the margins,
 one row high. A picture stage keeps the right third beside its text, which is
 what that third is for. Both are positive at any real framebuffer, and
 `dg-slot-refuses` below is the guard that says so out loud rather than painting
 nothing if this is ever got wrong again (L-FALSIF: an instrument that cannot
 fail is not evidence).

  dg-slot-for : DiagCtx, Integer -> DiagCtx
  dg-slot-for (c) (i) =
   if dg-stage-picture i
   then diag-ctx-with-slot c (dg-text-end c i + 8) (dg-row-y c (dg-stage-row i)) ((c.dc-w) - dg-text-end c i - 16) (dg-stage-rows i * dg-row-h c)
   else diag-ctx-with-slot c 8 (dg-row-y c (dg-stage-row i)) ((c.dc-w) - 16) (dg-row-h c)

 A REFUSAL HAS TO USE A CHANNEL THE DEFECT DOES NOT DISABLE. If the slot is
 degenerate the slot cannot carry the complaint, so this paints a bar across the
 TOP BAND, which is computed from `dc-w` alone and is in bounds whenever the
 framebuffer is, and says so on serial as well.

  dg-slot-refuses : DiagCtx, Integer -> Integer
  dg-slot-refuses (c) (i) =
   if (c.dc-slot-w) > 0 & (c.dc-slot-h) > 0 & (c.dc-slot-x) < (c.dc-w) then 0
   else let bar = gop-fill-rect (c.dc-base) (c.dc-stride) 0 0 (c.dc-w) 8 diag-col-bad
   in 1

  dg-band-row : Integer -> Integer
  dg-band-row (dummy) = dg-stage-row (dg-stage-count + 1)

Section: The Fixed Page

  dg-bar : DiagCtx, Integer, Integer -> Integer
  dg-bar (c) (i) (col) =
    let bw = (c.dc-w) / 8
    in gop-fill-rect (c.dc-base) (c.dc-stride) (i * bw) (dg-row-y c 1 + 2) bw (dg-row-h c - 4) col

  dg-bars : DiagCtx -> Integer
  dg-bars (c) =
    let a = dg-bar c 0 16777215
    in let b = dg-bar c 1 16711680
    in let d = dg-bar c 2 65280
    in let e = dg-bar c 3 255
    in let f = dg-bar c 4 65535
    in let g = dg-bar c 5 16711935
    in let h = dg-bar c 6 16776960
    in dg-bar c 7 0

  dg-head-line : DiagCtx -> Text
  dg-head-line (c) = "diag " & (c.dc-id) & " kernel " & (c.dc-kernel) & " world=" & diag-world-name (c.dc-world) & " cfg=" & show (list-length (c.dc-cfg)) & " src=" & (c.dc-cfg-src)

  dg-box-line : DiagCtx -> Text
  dg-box-line (c) = "box: " & (c.dc-box) & " fb=" & show (c.dc-w) & "x" & show (c.dc-h) & " stride=" & show (c.dc-stride) & " ram=" & (c.dc-ram)

  dg-ram-word : Integer -> Text
  dg-ram-word (dummy) = let mb = dsm-ram-mb 0 in if mb <= 0 then "unread" else show mb & "MB"

  dg-page : DiagCtx -> Integer
  dg-page (c) =
    let bg = gop-fill-rect (c.dc-base) (c.dc-stride) 0 0 (c.dc-w) (c.dc-h) diag-col-bg
    in let r0 = dg-text c 8 (dg-row-y c 0) "12345678 ABCDEFGH abcdefgh" diag-col-text
    in let r1 = dg-bars c
    in let r2 = dg-text c 8 (dg-row-y c 2) (dg-head-line c) diag-col-head
    in dg-text c 8 (dg-row-y c 3) (dg-box-line c) diag-col-text

Section: Stage Rows

  dg-paint-running : DiagCtx, Integer -> Integer
  dg-paint-running (c) (i) =
    let row = dg-stage-row i
    in let cl = dg-clear-rows c row (dg-stage-rows i)
    in dg-text c 8 (dg-row-y c row) (dg-stage-name i & " running") diag-col-dim

 BANK LOSS IS PAINTED WHEN IT IS SET, NOT AT THE SUMMARY. `gfat-cell-banklost`
 records the first stage whose bank write was refused, and until 2026-08-21 the
 only reader was the summary row. A run that never reaches the summary therefore
 destroys the evidence for the very failure it is having, and that is not
 hypothetical: on the 2026-08-21 flight b3 hung, the summary never painted, and
 the banked file carried `bank=ok` from the last good write with no banklost
 anywhere. One defect ate the other's instrument. L-BANK, one level up from the
 lesson's own statement: an instrument must not be reachable only through the
 thing it measures, and a summary is a thing that a hang measures.

 It takes the BAND rather than a stage row, because a stage row is overwritten
 by the next stage and the band is not. `dg-beat` repaints its heartbeat square
 at the band's right edge on its own cycle, so clearing the row here costs at
 most one blink.

 THE CELL IS THE STAGE PLUS ONE so that zero can mean none; this function takes
 the STAGE. Passing it the cell value is what shipped from 18341 until
 2026-08-21, and the glass then named the stage AFTER the one that lost the
 bank while `dg-bank-line` named the right one, so the two channels disagreed
 on the one reading a wedge leaves behind.

  dg-paint-banklost : DiagCtx, Integer -> Integer
  dg-paint-banklost (c) (i) =
    let row = dg-band-row 0
    in let cl = dg-clear-rows c row 1
    in dg-text c 8 (dg-row-y c row) ("BANK LOST AT STAGE " & show i & " " & dg-stage-name i & ", NOTHING AFTER THIS IS ON THE MEDIUM") diag-col-bad

  dg-glass-at : List Text, Integer -> Text
  dg-glass-at (g) (i) = if i < list-length g then list-at g i else ""

  dg-paint-result : DiagCtx, Integer, DiagResult -> Integer
  dg-paint-result (c) (i) (r) =
    let row = dg-stage-row i
    in let xend = dg-text-end c i
    in let rows = dg-stage-rows i
    in let cl = gop-fill-rect (c.dc-base) (c.dc-stride) 0 (dg-row-y c row) xend (rows * dg-row-h c) diag-col-bg
    in let more = if list-length (r.dr-bank) > list-length (r.dr-glass) then " +more in bank" else if list-length (r.dr-glass) > rows then " +more in bank" else ""
    in let a = dg-text-to c 8 (dg-row-y c row) (dg-stage-name i & " " & (r.dr-state) & "  " & dg-glass-at (r.dr-glass) 0) (r.dr-colour) xend
    in let b = dg-text-to c 8 (dg-row-y c (row + 1)) (dg-glass-at (r.dr-glass) 1 & (if rows == 2 then more else "")) diag-col-text xend
    in if rows == 2 then b else dg-text-to c 8 (dg-row-y c (row + 2)) (dg-glass-at (r.dr-glass) 2 & more) diag-col-text xend

  dg-paint-skipped : DiagCtx, Integer -> Integer
  dg-paint-skipped (c) (i) =
    let row = dg-stage-row i
    in let cl = dg-clear-rows c row (dg-stage-rows i)
    in dg-text c 8 (dg-row-y c row) (dg-stage-name i & " skipped (cfg off)") diag-col-dim

  dg-paint-pending : DiagCtx, Integer -> Integer
  dg-paint-pending (c) (i) =
    let row = dg-stage-row i
    in let cl = dg-clear-rows c row (dg-stage-rows i)
    in dg-text c 8 (dg-row-y c row) (dg-stage-name i & " deferred, runs last") diag-col-dim

Section: Serial

  dg-say : Text -> [Console] Integer
  dg-say (s) = act
    print-line-uni s
    let z = 0 in z
  end

  dg-say-block : List Text, Integer -> [Console] Integer
  dg-say-block (xs) (i) = act
    if i >= list-length xs then 0
    else act
      print-line-uni (list-at xs i)
      dg-say-block xs (i + 1)
    end
  end

Section: The Bank

  DiagBank = record {
    db-ok : Boolean,
    db-vol : Fat16Volume,
    db-kind : Integer,
    db-note : Text
  }

  dg-no-bank : Text -> DiagBank
  dg-no-bank (note) = DiagBank { db-ok = False, db-vol = gfat-null-vol, db-kind = 0, db-note = note }

  dg-kind-name : Integer -> Text
  dg-kind-name (k) =
    if k == med-kind-usb then "usb"
    else if k == med-kind-ahci then "ahci"
    else if k == med-kind-nvme then "nvme"
    else if k == med-kind-ide then "ide"
    else "none"

  dg-trim : Text, Integer -> Text
  dg-trim (s) (n) =
    if n <= 0 then ""
    else let ch = char-code-at s (n - 1)
    in if ch == char-code-at "\n" 0 then dg-trim s (n - 1)
    else if ch == char-code-at " " 0 then dg-trim s (n - 1)
    else substring s 0 n

 The lock: the ESP must carry DIAG.ID and its content must be the id the
 image was built with. 0 is no mount, 1 mounted without DIAG.ID, 2 a stale or
 foreign DIAG.ID, 3 the medium this image was written to.

  dg-lock : Fat16Volume, Text -> [Device.Port] Integer
  dg-lock (vol) (id) = act
    sz <- gfat-file-size vol "DIAG.ID"
    if sz <= 0 then 1
    else if sz > 64 then 2
    else act
      f <- gfat-read-file vol "DIAG.ID"
      if f.gf-ok == False then 2
      else let raw = gfat-text (f.gf-buf) 0 (f.gf-len) ""
      in let got = dg-trim raw (text-length raw)
      in if got == id then 3 else 2
    end
  end

  DiagProbe = record {
    dp-code : Integer,
    dp-vol : Fat16Volume
  }

  dg-probe : Integer, Integer, Text -> [Device.Port] DiagProbe
  dg-probe (kind) (index) (id) = act
    let s = med-set kind index
    in act
      m <- gfat-mount-esp
      if m.gm-ok == False then DiagProbe { dp-code = 0, dp-vol = gfat-null-vol }
      else act
        code <- dg-lock (m.gm-vol) id
        DiagProbe { dp-code = code, dp-vol = m.gm-vol }
      end
    end
  end

  dg-best-note : Integer -> Text
  dg-best-note (best) =
    if best == 2 then "DIAG.ID mismatch, refused"
    else if best == 1 then "no DIAG.ID on any ESP, refused"
    else "no bank, mount stage " & show (xdiag-get gfat-cell-stage)

  dg-try-usb : Text -> [Device.Port] DiagProbe
  dg-try-usb (id) = act
    let p = msc-published
    in if p.md-ok == False then DiagProbe { dp-code = 0, dp-vol = gfat-null-vol }
    else dg-probe med-kind-usb 0 id
  end

  dg-try-ahci : Integer, Text, Integer -> [Device.Port] DiagProbe
  dg-try-ahci (n) (id) (best) = act
    if n >= 4 then DiagProbe { dp-code = best, dp-vol = gfat-null-vol }
    else act
      hba <- ahci-find-nth n
      if hba.hba-ok == False then DiagProbe { dp-code = best, dp-vol = gfat-null-vol }
      else act
        r <- dg-probe med-kind-ahci n id
        if r.dp-code == 3 then r
        else dg-try-ahci (n + 1) id (if r.dp-code > best then r.dp-code else best)
      end
    end
  end

  dg-try-nvme : Text, Integer -> [Device.Port] DiagProbe
  dg-try-nvme (id) (best) = act
    c <- nvme-disk
    if c.nc-ok == False then DiagProbe { dp-code = best, dp-vol = gfat-null-vol }
    else act
      r <- dg-probe med-kind-nvme 0 id
      if r.dp-code == 3 then r else DiagProbe { dp-code = (if r.dp-code > best then r.dp-code else best), dp-vol = gfat-null-vol }
    end
  end

  dg-try-ide : Text, Integer -> [Device.Port] DiagProbe
  dg-try-ide (id) (best) = act
    absent <- ide-absent
    if absent then DiagProbe { dp-code = best, dp-vol = gfat-null-vol }
    else act
      r <- dg-probe med-kind-ide 0 id
      if r.dp-code == 3 then r else DiagProbe { dp-code = (if r.dp-code > best then r.dp-code else best), dp-vol = gfat-null-vol }
    end
  end

  dg-select : Text -> [Device.Port] DiagBank
  dg-select (id) = act
    if text-length id == 0 then dg-no-bank "no id in the image, bank refused"
    else act
      u <- dg-try-usb id
      if u.dp-code == 3 then DiagBank { db-ok = True, db-vol = u.dp-vol, db-kind = med-kind-usb, db-note = "" }
      else act
        a <- dg-try-ahci 0 id (u.dp-code)
        if a.dp-code == 3 then DiagBank { db-ok = True, db-vol = a.dp-vol, db-kind = med-kind-ahci, db-note = "" }
        else act
          n <- dg-try-nvme id (a.dp-code)
          if n.dp-code == 3 then DiagBank { db-ok = True, db-vol = n.dp-vol, db-kind = med-kind-nvme, db-note = "" }
          else act
            i <- dg-try-ide id (n.dp-code)
            if i.dp-code == 3 then DiagBank { db-ok = True, db-vol = i.dp-vol, db-kind = med-kind-ide, db-note = "" }
            else let cl = med-clear 0 in dg-no-bank (dg-best-note (i.dp-code))
          end
        end
      end
    end
  end

  dg-bank-write : DiagBank, List Text -> [Device.Port] Integer
  dg-bank-write (b) (lines) = act
    if b.db-ok == False then -1
    else diag-bank-write-vol (b.db-vol) lines
  end

 The write's RETURN is not the bank's truth and the third grouped sitting
 proved it: `DIAG.TXT` came back at 4,577 bytes with the SUMMARY painting
 `bank=ok`. The file's own directory entry is the truth, so every write reads
 the size back and disagreeing with what was handed over is a refusal like
 any other.

 BANK 1 is the first write, and a mount that then refuses the write is not a
 bank: the write stage cell (83) names where it stopped and the bank is
 reported as none, so the glass never claims a file that is not there.

  dg-open : DiagBank, List Text -> [Device.Port] DiagBank
  dg-open (b) (lines) = act
    if b.db-ok == False then b
    else act
      w <- dg-bank-write b (list-push (dg-copy lines 0 []) (dg-bank-line b))
      if w >= 0 then b
      else dg-no-bank ("write refused, write stage " & show (xdiag-get gfat-cell-write))
    end
  end

  dg-copy : List Text, Integer, List Text -> List Text
  dg-copy (xs) (i) (acc) =
    if i >= list-length xs then acc
    else dg-copy xs (i + 1) (list-push acc (list-at xs i))

Section: The Record

  dg-header-lines : DiagCtx -> List Text
  dg-header-lines (c) =
    ["DIAG1 id=" & (c.dc-id) & " kernel=" & (c.dc-kernel) & " world=" & diag-world-name (c.dc-world) & " cfg=" & show (list-length (c.dc-cfg)) & " src=" & (c.dc-cfg-src), "box=" & (c.dc-box) & " fb=" & show (c.dc-w) & "x" & show (c.dc-h) & " stride=" & show (c.dc-stride) & " ram=" & (c.dc-ram)]

  dg-indent : List Text, Integer, List Text -> List Text
  dg-indent (xs) (i) (acc) =
    if i >= list-length xs then acc
    else dg-indent xs (i + 1) (list-push acc ("  " & list-at xs i))

  dg-stage-lines : Integer, DiagResult -> List Text
  dg-stage-lines (i) (r) =
    dg-indent (r.dr-bank) 0 ["stage=" & dg-stage-name i & " state=" & (r.dr-state) & " risk=" & diag-risk-name (dg-stage-risk i)]

  dg-skip-lines : Integer -> List Text
  dg-skip-lines (i) = ["stage=" & dg-stage-name i & " state=skipped risk=" & diag-risk-name (dg-stage-risk i) & " cfg=off"]

  dg-bank-line : DiagBank -> Text
  dg-bank-line (b) =
    if b.db-ok == False then "bank=none " & (b.db-note)
    else let lost = xdiag-get gfat-cell-banklost
    in if lost == 0 then "bank=ok medium=" & dg-kind-name (b.db-kind)
       else "bank=lost at=" & dg-stage-name (lost - 1) & " size=" & show (xdiag-get gfat-cell-lastsize) & " medium=" & dg-kind-name (b.db-kind)

  dg-bank-whole : DiagBank -> Boolean
  dg-bank-whole (b) = if b.db-ok == False then False else xdiag-get gfat-cell-banklost == 0

Section: Verdicts

 One row per state word a stage can answer, and the row is the sentence a
 stranger acts on. A state with no row here prints "no verdict row" so the
 gap is visible on the glass rather than silent.

  dg-verdict-pci : Text -> Text
  dg-verdict-pci (s) =
    if s == "ok" then ""
    else if s == "BELOW3G" then "a device window sits inside our RAM arena; the box needs a mapping fix from us before any driver runs. Send DIAG.TXT; do not expect the network or USB rows to be right"
    else if s == "ABOVE4G" then "a 64-bit BAR sits above our mapping; that part faults on its first register read. Send DIAG.TXT"
    else if s == "unassigned" then "a NIC, storage or USB part has no BAR assigned; firmware left it unconfigured. Send DIAG.TXT"
    else if s == "empty" then "PCI config space answered nothing: a probe fault, not a bare machine. Send a photograph"
    else "no verdict row for pci " & s

  dg-verdict-scene : Text -> Text
  dg-verdict-scene (s) =
    if s == "rendered" then ""
    else if s == "blank" then "the render wrote nowhere useful; suspect the framebuffer base the firmware handed us. Photograph the screen; the fix is ours"
    else if s == "spilled" then "the render escaped its frame; the stride the firmware reported is not the panel's. Photograph the screen; the fix is ours"
    else if s == "no-fb" then "no framebuffer in the handoff block; GOP was refused. Send a photograph of the firmware boot menu"
    else if s == "no-room" then "the panel is too narrow for the render check. Photograph the screen"
    else "no verdict row for scene " & s

  dg-verdict-stage : Integer, Text -> Text
  dg-verdict-stage (i) (s) =
    if i == 1 then dg-verdict-smbios s
    else if i == 2 then dg-verdict-edid s
    else if i == 3 then dg-verdict-cpu s
    else if i == 4 then dg-verdict-pci s
    else if i == 5 then dg-verdict-scene s
    else if i == 6 then dg-verdict-gopmode s
    else if i == 7 then dg-verdict-block s
    else if i == 8 then dg-verdict-xhci s
    else if i == 9 then dg-verdict-sink s
    else if i == 10 then dg-verdict-pch s
    else if i == 11 then dg-verdict-nicsit s
    else if i == 12 then dg-verdict-nicinit s
    else if i == 13 then dg-verdict-nicring s
    else if i == 14 then dg-verdict-b3 s
    else if i == 15 then dg-verdict-pchk1 s
    else if i == 16 then dg-verdict-asde s
    else ""

  dg-verdict-gopmode : Text -> Text
  dg-verdict-gopmode (s) =
    if s == "honoured" then ""
    else if s == "kept" then ""
    else if s == "single" then "this firmware enumerates one graphics mode, so the resolution above is the only one available. Nothing to fix"
    else if s == "refused" then "the firmware REFUSED to move to the largest mode it enumerated; the picture above is its own console mode, not our choice. Send DIAG.TXT with the status on the row"
    else if s == "noloop" then "the mode-selection bank contradicts itself: more than one mode offered and the loop recorded as never run. The instrument is wrong, not the box. Send DIAG.TXT"
    else if s == "nostub" then "this image was built by a stub older than the mode-selection bank, so the row cannot answer. Rebuild the stick from a current tree"
    else "no verdict row for gopmode " & s

  dg-verdict-xhci : Text -> Text
  dg-verdict-xhci (s) =
    if s == "running" then ""
    else if s == "no-disk" then "an xHCI controller came up but no mass-storage device bound to it; the bank above says whether the medium was reached another way. Send DIAG.TXT"
    else if s == "bringup-failed" then "an xHCI controller is present and none of them reached running; the ctl rows name which and where. Send DIAG.TXT"
    else if s == "none" then "no xHCI controller was counted. THIS ROW CANNOT TELL YOU WHY: a box with no xHCI and a run where the bring-up never happened write the same zero. Read the block row above -- if it says via=USB the bring-up did happen and this is an instrument gap, not your box"
    else "no verdict row for xhci " & s

  dg-verdict-block : Text -> Text
  dg-verdict-block (s) =
    if s == "ok" then ""
    else if s == "no-medium" then "no medium banked, so the write side was not tried; the bank row above says why. Photograph the screen"
    else if s == "read-fail" then "the boot medium's own boot sector did not read back through our driver after the bank did; the read path is not stable. Send DIAG.TXT"
    else if s == "bpb-bad" then "the ESP boot sector read but its bytes-per-sector is not 512; the volume geometry is not what build-img lays down. Send DIAG.TXT"
    else if s == "write-refused" then "the medium refused a one-sector write past the volume; a read-only stick or a write path the firmware still owns. Try another stick, then send DIAG.TXT"
    else if s == "readback-fail" then "the sector wrote but would not read back; the medium dropped the write. Try another stick, then send DIAG.TXT"
    else if s == "mark-lost" then "the sector wrote and read back without the byte we wrote; the write went to another LBA or was cached and discarded. Send DIAG.TXT"
    else "no verdict row for block " & s

  dg-verdict-sink : Text -> Text
  dg-verdict-sink (s) =
    if s == "ok" then ""
    else if s == "no-medium" then "no medium banked, so the 2.7 MB write was not tried; the bank row above says why. Photograph the screen"
    else if s == "mount-fail" then "the bank's own volume would not mount a second time; the medium is not stable across the ladder. Send DIAG.TXT"
    else if s == "write-refused" then "the 2.7 MB streamed write was refused at the write stage the row names; a compiler output of seed size cannot be written to this stick. Try another stick, then send DIAG.TXT"
    else if s == "recovered" then "the 2.7 MB write went through, but NOT on the first attempt: the target stopped answering, the driver reset the endpoint and the retry carried it. The file is whole and the bank is intact, and the medium faltered under a sustained write and came back. Send DIAG.TXT; a stick that needs a reset mid-write is not one to trust with the next flight"
    else if s == "died" then "the target stopped answering during the write the row names, at the LBA it names: no transfer event came back at all, and the driver's endpoint reset did not bring it back. That is a different fault from a refusal, which completes and reports. Photograph the screen and send DIAG.TXT; the rows before this one were banked and are whole"
    else if s == "size-bad" then "the file wrote but its recorded size is not the size written; the directory entry or the FAT chain is wrong on this medium. Send DIAG.TXT"
    else if s == "read-fail" then "the file wrote at the right size and would not read back whole; the medium dropped part of the chain. Try another stick, then send DIAG.TXT"
    else if s == "bad-bytes" then "the file read back with bytes that differ from what was written (or shift=1 was asked for, in which case this is the oracle proving it can say no). Send DIAG.TXT"
    else if s == "ladder-all" then "every rung wrote, up to the 64-sector chunk that the 2.7 MB run refuses. So chunk size is NOT the variable and the total size is: the same chunk that fails in a 2.7 MB file succeeds in a 64 KB one. Send DIAG.TXT and SINKL.CDX"
    else if s == "ladder-stop" then "the rungs below the one named wrote and that one got no completion, so the row has measured the threshold rather than reporting a refusal. The rung is the number the next fix needs. Send DIAG.TXT and SINKL.CDX"
    else if s == "rung-1-refused" then "even a ONE-SECTOR write was refused here, while the block stage's one-sector write succeeded earlier in the same boot. Transfer size is innocent and the two stages differ in something else. Send DIAG.TXT and SINKL.CDX"
    else "no verdict row for sink " & s

  dg-verdict-pch : Text -> Text
  dg-verdict-pch (s) =
    if s == "ok" then ""
    else if s == "no-mdio" then "the MDIO door is shut: page 769 register 16 bit 10 is clear, so the paged reads beside it are not measurements and must not be read as the board's K1 or ULP state. The unpaged rows still stand. Send DIAG.TXT"
    else if s == "no-part" then "no eligible Intel NIC on the bus, so there is no PCH PHY to ask; every I219 question on this flight is unanswered. Nothing to send"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict), so no MAC CSR could be read. Send DIAG.TXT"
    else "no verdict row for pch " & s

  dg-verdict-nicsit : Text -> Text
  dg-verdict-nicsit (s) =
    if s == "ok" then ""
    else if s == "no-part" then "no eligible Intel NIC on the bus; the network rows below cannot run on this box. Nothing to do at your end"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict); a mapping fix from us before any driver runs. Send DIAG.TXT"
    else if s == "no-hpet" then "no HPET on this box, so the poll calibration has no clock; the registers were read. Send DIAG.TXT"
    else "no verdict row for nicsit " & s

  dg-verdict-nicinit : Text -> Text
  dg-verdict-nicinit (s) =
    if s == "ok" then ""
    else if s == "no-part" then "no eligible Intel NIC on the bus; the init sequence did not run. Nothing to do at your end"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict), so the init sequence did not touch the part; a mapping fix from us first. Send DIAG.TXT"
    else if s == "no-link" then "the card came up and reported no link inside the budget; check the cable and the far end, then send DIAG.TXT (the step durations are in it)"
    else if s == "no-mac" then "the card came up without a valid station address in RAL/RAH; the part's EEPROM did not load. Send DIAG.TXT"
    else if s == "no-hpet" then "no HPET, so no step could be timed; the sequence ran. Send DIAG.TXT"
    else "no verdict row for nicinit " & s

  dg-verdict-nicring : Text -> Text
  dg-verdict-nicring (s) =
    if s == "frames" then ""
    else if s == "quiet" then "the receiver is up and heard nothing in 2.4 s, and our own ARP got no answer; a quiet wire or a receiver that does not deliver. On a live network send DIAG.TXT (the DD map is in it)"
    else if s == "reader-broken" then "the transmit descriptor completed without DD, so our descriptor reader is looking at the wrong byte; every ring reading is void. Send DIAG.TXT; the fix is ours"
    else if s == "send-refused" then "the transmit descriptor never completed; the card took no frame from us. Send DIAG.TXT"
    else if s == "no-part" then "no eligible Intel NIC on the bus; nothing to receive with. Nothing to do at your end"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict), so nothing was received with it; a mapping fix from us first. Send DIAG.TXT"
    else if s == "no-hpet" then "no usable HPET rate, so every wait on this path would fall back to a count and take minutes; the stage banked the RDH answer and stopped rather than spend them. The arrival row carries the rate. Send DIAG.TXT; the fix is ours"
    else "no verdict row for nicring " & s

  dg-verdict-b3 : Text -> Text
  dg-verdict-b3 (s) =
    if s == "ok" then ""
    else if s == "short" then "the connection was up and only part of the payload went: the send stopped when the retransmit queue stayed full for the drain's whole budget. The row's sent= carries how many bytes of how many. The peer is reachable and slow, or our send path is; either way the reply below means nothing. Send DIAG.TXT"
    else if s == "mismatch" then "the peer answered and the bytes are not the ones DIAG.CFG said to expect; the row carries what came back. Send DIAG.TXT"
    else if s == "no-reply" then "the connection was established and the peer sent nothing back inside the budget; the stack works and the far end did not answer. Check what is listening on that port, then send DIAG.TXT"
    else if s == "refused" then "the handshake never completed: no SYN-ACK reached us. Check the peer address and port in DIAG.CFG and that the peer is reachable from this segment; if both are right the fix is ours"
    else if s == "no-arp" then "nobody answered ARP for the next hop in 2000 ms, so no frame could be addressed. Check the cable and that the peer is on this segment; set gw= in DIAG.CFG when the peer is not"
    else if s == "no-link" then "the link never came up inside the budget, so nothing was dialled. Plug the cable, boot again; if it repeats send DIAG.TXT"
    else if s == "no-card" then "an eligible Intel part is on the bus and the driver would not bind it; the row carries the card it chose instead. Send DIAG.TXT; the fix is ours"
    else if s == "no-peer" then "DIAG.CFG names no peer, so this stage was not asked to dial anything. Nothing to do at your end"
    else if s == "no-address" then "DIAG.CFG names a peer but no ip=, or one that does not parse, so there is no address to dial FROM. Add ip=<this box's address on that segment> and boot again. There is deliberately no default: an address is a fact about your network and a guess at it would send you looking for a fault that is not there"
    else if s == "no-lease" then "ip=dhcp was asked for and no DHCP server answered on this segment inside the budget. The address was asked for FROM the network, so this is the segment's answer and not a DIAG.CFG mistake: check that this port serves DHCP, or type a static ip= instead and boot again"
    else if s == "no-part" then "no eligible Intel NIC on the bus; nothing to talk over. Nothing to do at your end"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict), so the part was not touched; a mapping fix from us first. Send DIAG.TXT"
    else if s == "no-hpet" then "no usable HPET rate, so no wait on this path could be budgeted and the stage stopped rather than spend minutes finding out. Send DIAG.TXT; the fix is ours"
    else if s == "clock-stuck" then "the HPET reports a rate and its counter did not advance, so every budget in the driver would wait forever and nothing was dialled. Boot again; if it repeats send DIAG.TXT, the fix is ours"
    else "no verdict row for b3 " & s

  dg-verdict-pchk1 : Text -> Text
  dg-verdict-pchk1 (s) =
    if s == "taken" then ""
    else if s == "not-taken" then "the K1 write DID NOT TAKE: MDIO answered and Giga_K1_disable is clear after the driver ran. Nothing on this flight tested whether K1 is the fault, so do not read a still-dead link as K1 being innocent. The fix is ours. Send DIAG.TXT"
    else if s == "no-mdio" then "770.17 did not answer after the write, so this run cannot say whether the K1 step took. If the extcnf row shows firmware holding the semaphore, that is the reason. Send DIAG.TXT"
    else if s == "not-pch" then "this part is not an I219, so the driver skips the K1 step and there is nothing to read back; the row is inert on this box. Nothing to fix"
    else if s == "no-part" then "no eligible Intel NIC on the bus, so no K1 write happened and none could be read back. Nothing to send"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id, so it was never initialised and no K1 write was attempted; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable, so the PHY could not be asked. Send DIAG.TXT"
    else "no verdict row for pchk1 " & s

  dg-verdict-asde : Text -> Text
  dg-verdict-asde (s) =
    if s == "differs" then "the two bring-ups differ, so ASDE changes what this part does and finding 4 is answered. Send DIAG.TXT"
    else if s == "same" then "the two bring-ups agree: on this part ASDE changes nothing we can see, which is what the 82583V datasheet says should be true. Send DIAG.TXT"
    else if s == "asde-stuck" then "the ASDE bit did not stay set, so the arm that was supposed to differ never had ASDE on and the comparison above it means nothing. Send DIAG.TXT; the fix is ours"
    else if s == "ctrl-ro" then "CTRL is READ-ONLY to us: a bit we cleared read back set. Nothing this stage wrote was written, and neither arm means anything -- and it reaches further than this row, because receive and transmit bring-up write the same kind of register. Send DIAG.TXT; the fix is ours"
    else if s == "no-link" then "neither bring-up reached link, so there was nothing for ASDE to change. Plug the cable, boot again; if it repeats send DIAG.TXT"
    else if s == "no-part" then "no Intel NIC on bus 0, which is the only bus this stage scans. Nothing to do at your end"
    else if s == "rejected" then "an Intel NIC is present and our driver refuses it by device id; the row names the part. Send DIAG.TXT"
    else if s == "bar-bad" then "the NIC's register window is not reachable (the row names the verdict), so the part was not touched. Send DIAG.TXT"
    else "no verdict row for asde " & s

  dg-verdict-smbios : Text -> Text
  dg-verdict-smbios (s) =
    if s == "ok" then ""
    else if s == "no-table" then "the firmware published no SMBIOS table, so the box has no name here; send DIAG.TXT and tell us the make and model"
    else if s == "bad-anchor" then "the SMBIOS entry the firmware published is not an SMBIOS entry; send DIAG.TXT, the reading is ours to explain"
    else if s == "unmapped" then "the SMBIOS table sits outside the memory we map; send DIAG.TXT, the fix is ours"
    else if s == "no-system" then "the SMBIOS table carries no system record; send DIAG.TXT and tell us the make and model"
    else "no verdict row for smbios " & s

  dg-verdict-edid : Text -> Text
  dg-verdict-edid (s) =
    if s == "ok" then ""
    else if s == "absent" then ""
    else if s == "short" then "the firmware offered a truncated EDID; send DIAG.TXT"
    else if s == "bad-header" then "the EDID the firmware offered has no EDID header; send DIAG.TXT"
    else if s == "bad-checksum" then "the EDID the firmware offered fails its checksum; a bad cable or adapter is the usual cause. Send DIAG.TXT"
    else "no verdict row for edid " & s

  dg-verdict-cpu : Text -> Text
  dg-verdict-cpu (s) =
    if s == "ok" then ""
    else if s == "hypervisor" then "this is a virtual machine; every hardware row describes the hypervisor, not a board"
    else if s == "vmx-locked-off" then "the firmware has virtualisation (VT-x) switched off; enable it in firmware setup if you want to run the hypervisor"
    else if s == "no-brand" then "the CPU reports no brand string; send DIAG.TXT"
    else "no verdict row for cpu " & s

  dg-verdict-bank : DiagBank -> Text
  dg-verdict-bank (b) =
    if b.db-ok then ""
    else "the stick's ESP could not be mounted or written from the payload. Photograph the QR codes; try a different stick, FAT16, under 32 GB"

 Verdicts are listed worst first: a red stage's row before an amber one's,
 so the one sentence the band shows is the one that matters, and the bank's
 no-bank row after the stages' rows.

  dg-verdicts-pass : List Text, List Integer, Integer, Integer, List Text -> List Text
  dg-verdicts-pass (states) (colours) (i) (want) (acc) =
    if i >= list-length states then acc
    else let v = dg-verdict-stage (i + 1) (list-at states i)
    in let c = list-at colours i
    in let hit = if want == diag-col-bad then c == diag-col-bad else if want == diag-col-warn then c == diag-col-warn else (c /= diag-col-bad & c /= diag-col-warn)
    in dg-verdicts-pass states colours (i + 1) want (if text-length v == 0 then acc else if hit then list-push acc ("todo: " & v) else acc)

  dg-verdicts : List Text, List Integer, DiagBank -> List Text
  dg-verdicts (states) (colours) (b) =
    let a1 = dg-verdicts-pass states colours 0 diag-col-bad []
    in let a2 = dg-verdicts-pass states colours 0 diag-col-warn a1
    in let a3 = dg-verdicts-pass states colours 0 diag-col-dim a2
    in let v = dg-verdict-bank b
    in if text-length v == 0 then a3 else list-push a3 ("todo: " & v)

  dg-todo : List Text -> Text
  dg-todo (vs) =
    if list-length vs == 0 then "todo: nothing at your end; send DIAG.TXT anyway, a green box is a data point"
    else list-at vs 0

Section: The Codes

  dg-qr-pitch : Integer -> Integer
  dg-qr-pitch (s) = 45 * s + 24

  dg-qr-fits : Integer, Integer, Integer, Integer -> Boolean
  dg-qr-fits (w) (avail) (cn) (s) =
    let cols = (w - 40) / dg-qr-pitch s
    in if cols < 1 then False
    else ((cn + cols - 1) / cols) * dg-qr-pitch s <= avail

  dg-qr-scale : Integer, Integer, Integer -> Integer
  dg-qr-scale (w) (avail) (cn) =
    if dg-qr-fits w avail cn 6 then 6
    else if dg-qr-fits w avail cn 5 then 5
    else if dg-qr-fits w avail cn 4 then 4
    else 3

  dg-qr-cap : Integer, Integer, Integer -> Integer
  dg-qr-cap (w) (avail) (s) =
    let cols = (w - 40) / dg-qr-pitch s
    in let rows = avail / dg-qr-pitch s
    in if cols < 1 then 0 else if rows < 1 then 0 else cols * rows

  dg-qr-chunks : DiagCtx, Integer, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  dg-qr-chunks (c) (qy) (qs) (cols) (body) (total) (cn) (i) =
    if i >= cn then 0
    else let from = i * 100
    in let len = if total - from > 100 then 100 else total - from
    in let m = qr5-encode-part (show (i + 1) & "/" & show cn & ";") body from len
    in let d = qr-draw (c.dc-base) (c.dc-stride) (40 + (int-mod i cols) * dg-qr-pitch qs) (qy + (i / cols) * dg-qr-pitch qs) qs m
    in dg-qr-chunks c qy qs cols body total cn (i + 1)

 Scale 2 is never offered: at scale 2 the decoder finds the finder patterns
 and reads none of the codes. When even scale 3 cannot hold every chunk the
 BODY is cut to what fits and the label says so; the bank is the record.

  dg-qr : DiagCtx, Integer, Text -> Integer
  dg-qr (c) (qy) (body0) =
    let avail = (c.dc-h) - qy - 8
    in let total0 = text-length body0
    in let cn0 = (total0 + 99) / 100
    in let qs = dg-qr-scale (c.dc-w) avail cn0
    in let cap = dg-qr-cap (c.dc-w) avail qs
    in let cn = if cn0 > cap then cap else cn0
    in let body = if cn < cn0 & cn > 0 then substring body0 0 (cn * 100 - 4) & "CUT;" else body0
    in let total = text-length body
    in let cols = ((c.dc-w) - 40) / dg-qr-pitch qs
    in let note = "QR: " & show cn & " of " & show cn0 & " codes, " & show total & " bytes, scale " & show qs & (if qs < 4 then ". SHOOT CLOSE AND SQUARE" else "") & (if cn < cn0 then ". CUT: photograph, then send DIAG.TXT" else "")
    in let t = dg-text c 40 (qy - dg-row-h c) note (if qs < 4 then diag-col-note else diag-col-text)
    in if cn <= 0 then 0 else dg-qr-chunks c qy qs cols body total cn 0

  dg-summary-body : DiagCtx, List Text, List Text, DiagBank, Integer -> Text
  dg-summary-body (c) (states) (glass) (b) (bytes) =
    "DIAG1;id=" & (c.dc-id) & ";k=" & (c.dc-kernel) & ";w=" & diag-world-name (c.dc-world) & ";fb=" & show (c.dc-w) & "x" & show (c.dc-h) & "/" & show (c.dc-stride) & ";" & dg-summary-states states 0 "" & (if dg-bank-whole b then "bank=ok " & show bytes else dg-bank-line b) & ";" & text-concat-list glass

  dg-summary-states : List Text, Integer, Text -> Text
  dg-summary-states (states) (i) (acc) =
    if i >= list-length states then acc
    else dg-summary-states states (i + 1) (acc & dg-stage-name (i + 1) & "=" & list-at states i & ";")

Section: The Ladder

 Passive stages run before the bank opens; every stage after that rewrites
 the bank before the next one runs, so a wedge past a bank is a free finding
 (L-BANK). With only passive stages in the table the bank is written once,
 after them, and the shape is kept for the lifts that follow.

 A STAGE THAT CAN END THE RUN RUNS LAST, because the medium IS the bank and a
 stage that kills either one takes every later stage's record with it.
 Sitting 7 measured the cost: sink sits at 9, pch at 10, and DIAG.TXT came
 back holding stages 1 to 8 and nothing else, so the nine readings the flight
 was composed for existed only on the glass. dg-stage-defers names those
 stages, the main pass paints them pending and reserves their slot, and
 dg-run-deferred runs them after a labelled before-deferred summary is already
 on the medium.

 ASDE IS NOT DEFERRED, AND THE REASON IS THE TELEMETRY AND NOT THE LADDER.
 Asde wedged the box on 2026-08-11, so it looks like the same class as sink,
 and deferring it past the marker would guarantee it runs. It would also
 guarantee it runs UNBANKED whenever sink has just killed the medium, and on
 the ASUS that leaves it on one photograph: there is no serial port on that
 board (`docs/Hardware/HardwareSitting.md`, "There is no serial port on the
 ASUS"; the rig is a phone camera). Asde is the day's question and has been
 eaten twice already, so it runs last IN THE MAIN PASS, where its row is
 banked, and only sink goes past the marker.

 THE TRADE IS STATED RATHER THAN HIDDEN: an asde that wedges the box costs
 the marker and sink's answer with it. That is the cheaper loss, because sink
 refuses where asde hangs, and a refusal cannot eat the stage after it.

  DiagRun = record {
    run-lines : List Text,
    run-states : List Text,
    run-colours : List Integer,
    run-glass : List Text,
    run-count : Integer,
    run-skip : Integer
  }

  dg-run-one : DiagCtx, Integer, DiagRun -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagRun
  dg-run-one (c) (i) (r) = act
    if dg-stage-enabled c i == False then act
      let p = dg-paint-skipped c i
      in let ls = dg-skip-lines i
      in act
        s <- dg-say (list-at ls 0)
        DiagRun { run-lines = (r.run-lines) & ls, run-states = list-push (r.run-states) "skipped", run-colours = list-push (r.run-colours) diag-col-dim, run-glass = r.run-glass, run-count = r.run-count, run-skip = (r.run-skip) + 1 }
      end
    end
    else act
      res <- dg-stage-do (diag-ctx-with-lines c (r.run-lines)) i
      let ls = dg-stage-lines i res
      in DiagRun { run-lines = (r.run-lines) & ls, run-states = list-push (r.run-states) (res.dr-state), run-colours = list-push (r.run-colours) (res.dr-colour), run-glass = list-push (r.run-glass) (dg-stage-name i & ":" & dg-glass-at (res.dr-glass) 0 & ";"), run-count = (r.run-count) + 1, run-skip = r.run-skip }
    end
  end

  dg-stage-do : DiagCtx, Integer -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagResult
  dg-stage-do (c) (i) = act
    let p = dg-paint-running c i
    in let slot = dg-slot-for c i
    in let refused = dg-slot-refuses slot i
    in act
      res <- dg-stage-run slot i
      let q = dg-paint-result c i res
      in act
        s <- dg-say-block (dg-stage-lines i res) 0
        res
      end
    end
  end

 A deferred stage takes its slot in run-states and run-colours during the main
 pass and its real answer by list-set-at when it finally runs, because every
 reader of those two lists is POSITIONAL: dg-verdicts-pass and
 dg-summary-states both recover the stage from the index. run-lines and
 run-glass are order-only, so the late stage appends to them and the file
 stays in the order the serial printed.

  dg-run-late : DiagCtx, Integer, DiagRun -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagRun
  dg-run-late (c) (i) (r) = act
    res <- dg-stage-do (diag-ctx-with-lines c (r.run-lines)) i
    let ls = dg-stage-lines i res
    in DiagRun { run-lines = (r.run-lines) & ls, run-states = list-set-at (r.run-states) (i - 1) (res.dr-state), run-colours = list-set-at (r.run-colours) (i - 1) (res.dr-colour), run-glass = list-push (r.run-glass) (dg-stage-name i & ":" & dg-glass-at (res.dr-glass) 0 & ";"), run-count = (r.run-count) + 1, run-skip = r.run-skip }
  end


  dg-run-passive : DiagCtx, Integer, DiagRun -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagRun
  dg-run-passive (c) (i) (r) = act
    if i > dg-stage-count then r
    else if dg-stage-risk i /= diag-risk-passive then r
    else act
      r2 <- dg-run-one c i r
      dg-run-passive c (i + 1) r2
    end
  end

  dg-bank-step : DiagCtx, DiagBank, List Text, Integer -> [Device.Port] Integer
  dg-bank-step (c) (b) (lines) (at) = act
    w <- dg-bank-write b lines
    let l = if w >= 0 then 0
            else if xdiag-get gfat-cell-banklost == 0 then gfat-note-banklost (at + 1)
            else 0
    in let shout = if w >= 0 | (b.db-ok == False) then 0 else dg-paint-banklost c at
    in w
  end

  dg-run-rest : DiagCtx, Integer, DiagRun, DiagBank -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagRun
  dg-run-rest (c) (i) (r) (b) = act
    if i > dg-stage-count then r
    else if dg-stage-defers i & dg-stage-enabled c i then act
      let p = dg-paint-pending c i
      in dg-run-rest c (i + 1) (DiagRun { run-lines = r.run-lines, run-states = list-push (r.run-states) "deferred", run-colours = list-push (r.run-colours) diag-col-dim, run-glass = r.run-glass, run-count = r.run-count, run-skip = r.run-skip }) b
    end
    else act
      r2 <- dg-run-one c i r
      w <- dg-bank-step c b (r2.run-lines) i
      dg-run-rest c (i + 1) r2 b
    end
  end

  dg-run-deferred : DiagCtx, Integer, DiagRun, DiagBank -> [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] DiagRun
  dg-run-deferred (c) (i) (r) (b) = act
    if i > dg-stage-count then r
    else if (dg-stage-defers i & dg-stage-enabled c i) == False then dg-run-deferred c (i + 1) r b
    else act
      r2 <- dg-run-late c i r
      w <- dg-bank-step c b (r2.run-lines) i
      dg-run-deferred c (i + 1) r2 b
    end
  end

  dg-first-active : Integer -> Integer
  dg-first-active (i) =
    if i > dg-stage-count then i
    else if dg-stage-risk i /= diag-risk-passive then i
    else dg-first-active (i + 1)

Section: Entry

  dg-world : Integer -> Integer
  dg-world (dummy) = if peek-qword dg-systab-cell 0 == 0 then diag-world-ebs else diag-world-uefi

 Scale 2 when the fixed page fits at 32-pixel rows with a row of codes below
 the band, else 1: a small panel gets small text rather than a page with no
 QR block.

  dg-scale : Integer, Integer -> Integer
  dg-scale (w) (h) = if w >= 1024 & h >= 8 + (dg-band-row 0 + 2) * 32 + 8 + 32 + 204 + 8 then 2 else 1

  dg-cfg-src : Text, List Text -> Text
  dg-cfg-src (ring) (cfg) = if text-length ring > 0 then "stdin" else "default"

  dg-ctx : Integer -> DiagCtx
  dg-ctx (dummy) =
    let ring = dg-ring-text 0
    in let cfg = dg-cfg-lines ring
    in let w = boot-fb-w 0
    in DiagCtx { dc-base = boot-fb-base 0, dc-w = w, dc-h = boot-fb-h 0, dc-stride = boot-fb-stride 0, dc-scale = dg-scale w (boot-fb-h 0), dc-font = cbf-init, dc-world = dg-world 0, dc-id = diag-cfg-find cfg 0 "id", dc-kernel = diag-cfg-find cfg 0 "kernel", dc-cfg = cfg, dc-cfg-src = dg-cfg-src ring cfg, dc-pci = pci-scan-all, dc-box = dsm-box 0, dc-ram = dg-ram-word 0, dc-bank = False, dc-vol = gfat-null-vol, dc-lines = [], dc-slot-x = 0, dc-slot-y = 0, dc-slot-w = 0, dc-slot-h = 0 }

  dg-esp-cfg : DiagBank -> [Device.Port] List Text
  dg-esp-cfg (b) = act
    if b.db-ok == False then []
    else act
      sz <- gfat-file-size (b.db-vol) "DIAG.CFG"
      if sz <= 0 then []
      else if sz > 4096 then []
      else act
        f <- gfat-read-file (b.db-vol) "DIAG.CFG"
        if f.gf-ok == False then [] else dg-cfg-lines (gfat-text (f.gf-buf) 0 (f.gf-len) "")
      end
    end
  end

  dg-rcp-lines : List Text, Integer, List Text -> List Text
  dg-rcp-lines (xs) (i) (acc) =
    if i >= list-length xs then acc
    else if list-length acc >= 12 then acc
    else let l = list-at xs i
    in dg-rcp-lines xs (i + 1) (if text-length l == 0 then acc else acc & ["rcp " & l])

  dg-esp-rcp : DiagBank -> [Device.Port] List Text
  dg-esp-rcp (b) = act
    if b.db-ok == False then []
    else act
      sz <- gfat-file-size (b.db-vol) "DIAG.RCP"
      if sz <= 0 then ["rcp none"]
      else if sz > 2048 then ["rcp oversize"]
      else act
        f <- gfat-read-file (b.db-vol) "DIAG.RCP"
        if f.gf-ok == False then ["rcp unreadable"] else dg-rcp-lines (dg-cfg-lines (gfat-text (f.gf-buf) 0 (f.gf-len) "")) 0 []
      end
    end
  end

  dg-ctx-with-cfg : DiagCtx, List Text, Boolean, Fat16Volume -> DiagCtx
  dg-ctx-with-cfg (c) (more) (bank) (vol) =
    DiagCtx { dc-base = c.dc-base, dc-w = c.dc-w, dc-h = c.dc-h, dc-stride = c.dc-stride, dc-scale = c.dc-scale, dc-font = c.dc-font, dc-world = c.dc-world, dc-id = c.dc-id, dc-kernel = c.dc-kernel, dc-cfg = (c.dc-cfg) & more, dc-cfg-src = (c.dc-cfg-src) & (if list-length more == 0 then "" else "+file"), dc-pci = c.dc-pci, dc-box = c.dc-box, dc-ram = c.dc-ram, dc-bank = bank, dc-vol = vol, dc-lines = c.dc-lines, dc-slot-x = c.dc-slot-x, dc-slot-y = c.dc-slot-y, dc-slot-w = c.dc-slot-w, dc-slot-h = c.dc-slot-h }

  dg-band : DiagCtx, DiagRun, DiagBank, Integer, Text -> Integer
  dg-band (c) (r) (b) (bytes) (todo) =
    let row = dg-band-row 0
    in let cl = dg-clear-rows c row 2
    in let s = "SUMMARY run=" & show (r.run-count) & " skip=" & show (r.run-skip) & " " & dg-bank-line b & (if bytes >= 0 then " bytes=" & show bytes else "")
    in let a = dg-text c 8 (dg-row-y c row) s (if dg-bank-whole b then diag-col-good else diag-col-warn)
    in dg-text c 8 (dg-row-y c (row + 1)) todo diag-col-note

  opening : [Device.Port, Device.Mmio, Console, Network.Read, Network.Write] Integer
  opening = act
    ri <- runtime-init 0
    let c = dg-ctx 0
    in let hdr = dg-header-lines c
    in let pg = dg-page c
    in act
      s00 <- dg-say-block hdr 0
      r1 <- dg-run-passive c 1 (DiagRun { run-lines = hdr, run-states = [], run-colours = [], run-glass = [], run-count = 0, run-skip = 0 })
      att <- usb-attach
      b0 <- dg-select (c.dc-id)
      b <- dg-open b0 (r1.run-lines)
      more <- dg-esp-cfg b
      rcp <- dg-esp-rcp b
      let c2 = dg-ctx-with-cfg c more (b.db-ok) (b.db-vol)
      in let lines1 = ((r1.run-lines) & [dg-bank-line b & " cfg-file=" & show (list-length more)]) & rcp
      in act
        s0 <- dg-say (dg-bank-line b & " cfg-file=" & show (list-length more))
        s0r <- dg-say-block rcp 0
        w0 <- dg-bank-write b lines1
        ra <- dg-run-rest c2 (dg-first-active 1) (DiagRun { run-lines = lines1, run-states = r1.run-states, run-colours = r1.run-colours, run-glass = r1.run-glass, run-count = r1.run-count, run-skip = r1.run-skip }) b
        let preline = "before-deferred run=" & show (ra.run-count) & " skip=" & show (ra.run-skip) & " " & dg-bank-line b
        in let rp = DiagRun { run-lines = list-push (ra.run-lines) preline, run-states = ra.run-states, run-colours = ra.run-colours, run-glass = ra.run-glass, run-count = ra.run-count, run-skip = ra.run-skip }
        in act
          sp <- dg-say preline
          wp <- dg-bank-step c2 b (rp.run-lines) dg-stage-count
          r2 <- dg-run-deferred c2 (dg-first-active 1) rp b
          let vs0 = dg-verdicts (r2.run-states) (r2.run-colours) b
          in let todo = dg-todo vs0
          in let vs = if list-length vs0 == 0 then [todo] else vs0
          in let sum = "summary run=" & show (r2.run-count) & " skip=" & show (r2.run-skip) & " " & dg-bank-line b
          in let final = (list-push (r2.run-lines) sum) & vs
          in act
            bytes <- dg-bank-write b final
            let bd = dg-band c r2 b bytes todo
            in let qy = dg-row-y c (dg-band-row 0 + 2) + dg-row-h c + 8
            in let qr = dg-qr c qy (dg-summary-body c (r2.run-states) (r2.run-glass) b bytes)
            in act
              s1 <- dg-say sum
              s2 <- dg-say-block vs 0
              s3 <- dg-say "END"
              dg-hold c 0
            end
          end
        end
      end
    end
  end
