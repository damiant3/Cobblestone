cdx-prose-record-field-mismatch : Integer
cdx-prose-record-field-mismatch =
  1103

cdx-prose-variant-ctor-mismatch : Integer
cdx-prose-variant-ctor-mismatch =
  1104

cdx-prose-banned-word : Integer
cdx-prose-banned-word =
  1110

cdx-ir-error : Integer
cdx-ir-error =
  2000

cdx-type-mismatch : Integer
cdx-type-mismatch =
  2001

cdx-unknown-name : Integer
cdx-unknown-name =
  2002

cdx-arithmetic-requires-numeric : Integer
cdx-arithmetic-requires-numeric =
  2003

cdx-unknown-record-field : Integer
cdx-unknown-record-field =
  2005

cdx-infinite-type : Integer
cdx-infinite-type =
  2010

cdx-effect-undeclared : Integer
cdx-effect-undeclared =
  2031

cdx-type-arity : Integer
cdx-type-arity =
  2032

cdx-let-binds-effectful-value : Integer
cdx-let-binds-effectful-value =
