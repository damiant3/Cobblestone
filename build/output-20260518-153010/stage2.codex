mk-cdx : Integer, Text, Integer, Integer, Text -> CdxCodeInfo
mk-cdx (code) (name) (sev) (phase) (summary) =
  CdxCodeInfo {
   code = code,
   name = name,
   severity = sev,
   phase = phase,
   summary = summary
  }

cdx-registry : List CdxCodeInfo
cdx-registry =
  [mk-cdx cdx-too-many-errors "TooManyErrors" sev-error phase-infrastructure "Error cap reached; further errors suppressed.", mk-cdx cdx-invalid-tab-escape "InvalidTabEscape" sev-error phase-lexer "\\t escape is not valid in CCE; use spaces directly.", mk-cdx cdx-invalid-carriage-return-escape "InvalidCarriageReturnEscape" sev-error phase-lexer "\\r escape is not valid in CCE; use \\n for newlines.", mk-cdx cdx-expected-token-kind "ExpectedTokenKind" sev-error phase-parser "A specific token kind was required but a different one was found.", mk-cdx cdx-reserved-keyword-as-identifier "ReservedKeywordAsIdentifier" sev-error phase-parser "A reserved keyword was used where an identifier was required; rename it.", mk-cdx cdx-ir-error "IrError" sev-error phase-codegen "Codegen encountered an IrError node, indicating an earlier phase silently failed.", mk-cdx cdx-type-mismatch "TypeMismatch" sev-error phase-type-checker "Two types could not be unified.", mk-cdx cdx-unknown-name "UnknownName" sev-error phase-type-checker "Name was not found in the type environment during checking.", mk-cdx cdx-infinite-type "InfiniteType" sev-error phase-type-checker "Occurs check failed - unification would produce an infinite type.", mk-cdx cdx-effect-undeclared "EffectUndeclared" sev-error phase-type-checker "A function body performs effects not declared in its signature; add the missing effect label or handle the effect.", mk-cdx cdx-let-binds-effectful-value "LetBindsEffectfulValue" sev-error phase-type-checker "let-binding the result of an effectful call silently corrupts on bare metal; use act-bind (X <- expr) inside an act block.", mk-cdx cdx-unresolved-func-offset "UnresolvedFuncOffset" sev-error phase-codegen "A call or func-addr fixup refers to a function not present in the offset table; emission would produce wrong code.", mk-cdx cdx-error-type-in-ir "ErrorTypeInIR" sev-error phase-codegen "An IR node reached codegen with ErrorTy in its type; an earlier phase silently failed to resolve the type.", mk-cdx cdx-emit-not-implemented "EmitNotImplemented" sev-error phase-codegen "The requested emit option is not implemented yet; compile aborted before machine-code emission.", mk-cdx cdx-duplicate-definition "DuplicateDefinition" sev-error phase-name-resolver "The same name is introduced twice at chapter scope.", mk-cdx cdx-undefined-name "UndefinedName" sev-error phase-name-resolver "A name was referenced but is not in any visible scope.", mk-cdx cdx-duplicate-cite "DuplicateCite" sev-error phase-name-resolver "Two cite declarations in the same chapter select the same name; the later cite would silently shadow the earlier.", mk-cdx cdx-missing-cite "MissingCite" sev-error phase-name-resolver "A cited foreword chapter could not be found on disk; the chapter file is missing or the name is misspelled.", mk-cdx cdx-type-arity "TypeArity" sev-error phase-type-checker "A type constructor was applied with the wrong number of type arguments.", mk-cdx cdx-unterminated-text "UnterminatedText" sev-error phase-lexer "A text literal was not terminated before end of line.", mk-cdx cdx-resource-exhausted "ResourceExhausted" sev-error phase-infrastructure "Compiler recursion budget exhausted; the input was pathologically deep or a walker cycled. Bail rather than stack-overflow.", mk-cdx cdx-narrowing-record-set-literal "NarrowingRecordSetLiteral" sev-error phase-type-checker "A bounded-Integer field is being assigned a literal value that does not fit the field's declared bound; the codegen narrow-store would silently truncate at runtime. Adjust the literal or widen the field bound.", mk-cdx cdx-narrowing-record-set "NarrowingRecordSet" sev-warning phase-type-checker "A bounded-Integer field is being assigned a value whose static type is wider than the field's declared bound; the codegen narrow-store will silently truncate if the runtime value exceeds the bound.", mk-cdx cdx-field-assign-immutable "FieldAssignImmutable" sev-error phase-type-checker "Field assignment requires a mutable record type; this record is immutable.", mk-cdx cdx-use-after-consume "UseAfterConsume" sev-error phase-type-checker "Mutable binding was already consumed (moved); use after consume is not permitted.", mk-cdx cdx-mutable-alias "MutableAlias" sev-error phase-type-checker "Mutable record cannot be aliased; exactly one binding may hold it at a time.", mk-cdx cdx-capability-not-granted "CapabilityNotGranted" sev-error phase-capability-checker "The opening function requires an effect capability that is not granted at startup.", mk-cdx cdx-scope-violation "ScopeViolation" sev-error phase-capability-checker "An effect operation's argument is outside the granted scope for that capability.", mk-cdx cdx-prose-function-name-mismatch "ProseFunctionNameMismatch" sev-warning phase-parser "Prose function name does not match the notation definition below.", mk-cdx cdx-prose-parameter-mismatch "ProseParameterMismatch" sev-warning phase-parser "Prose parameter does not match the notation parameter.", mk-cdx cdx-prose-record-field-mismatch "ProseRecordFieldMismatch" sev-warning phase-parser "Prose record field does not match the notation record field.", mk-cdx cdx-prose-variant-ctor-mismatch "ProseVariantCtorMismatch" sev-warning phase-parser "Prose variant constructor does not match the notation variant constructor.", mk-cdx cdx-prose-banned-word "ProseBannedWord" sev-warning phase-parser "A banned word was used in load-bearing prose; replace it with the suggested substitute.", mk-cdx cdx-deprecated-plus-plus "DeprecatedPlusPlus" sev-deprecated phase-parser "++ is deprecated for concatenation; use & instead.", mk-cdx cdx-deprecated-arrow-params "DeprecatedArrowParams" sev-deprecated phase-parser "A -> B -> C parameter style is deprecated; use A, B -> C instead."]

cdx-lookup-loop : List CdxCodeInfo, Integer, Integer, Integer -> CdxCodeInfo
cdx-lookup-loop (reg) (code) (i) (len) =
  if i >= len then mk-cdx 0 "Unknown" sev-error phase-infrastructure "Unregistered CDX code."
  else let entry = list-at reg i
  in if entry.code == code then entry
     else cdx-lookup-loop reg code (i + 1) len

cdx-lookup : Integer -> CdxCodeInfo
cdx-lookup (code) =
  cdx-lookup-loop cdx-registry code 0 (list-length cdx-registry)

map-list : (a0 -> a1), List a0 -> List a1
map-list (f) (xs) =
  map-list-loop f xs 0 (list-length xs) []

map-list-loop : (a0 -> a1), List a0, Integer, Integer, List a1 -> List a1
map-list-loop (f) (xs) (i) (len) (acc) =
  if i == len then acc
  else map-list-loop f xs (i + 1) len (list-push acc (f (list-at xs i)))

fold-list : (a0, a1 -> a0), a0, List a1 -> a0
fold-list (f) (z) (xs) =
  fold-list-loop f z xs 0 (list-length xs)

fold-list-loop : (a0, a1 -> a0), a0, List a1, Integer, Integer -> a0
fold-list-loop (f) (z) (xs) (i) (len) =
  if i == len then z
  else fold-list-loop f (f z (list-at xs i)) xs (i + 1) len

bsearch-text-pos : List TypeBinding, Text, Integer, Integer -> Integer
bsearch-text-pos (bindings) (name) (lo) (hi) =
  if lo >= hi then lo
  else let mid = lo + (hi - lo) / 2
  in let mid-name = (list-at bindings mid).name
  in if text-compare name mid-name <= 0 then bsearch-text-pos bindings name lo mid
     else bsearch-text-pos bindings name (mid + 1) hi

bsearch-text-set : List Text, Text, Integer, Integer -> Integer
bsearch-text-set (names) (name) (lo) (hi) =
  if lo >= hi then lo
  else let mid = lo + (hi - lo) / 2
  in if text-compare name (list-at names mid) <= 0 then bsearch-text-set names name lo mid
     else bsearch-text-set names name (mid + 1) hi

text-set-has : List Text, Text -> Boolean
text-set-has (names) (name) =
  let len = list-length names
  in let pos = bsearch-text-set names name 0 len
  in if pos >= len then False
     else list-at names pos == name

text-set-insert : List Text, Text -> List Text
text-set-insert (names) (name) =
  let len = list-length names
  in let pos = bsearch-text-set names name 0 len
  in if pos < len then if list-at names pos == name then names
  else list-insert-at names pos name
     else list-insert-at names pos name

make-diagnostic : Integer, Integer, Text, SourceSpan -> Diagnostic
make-diagnostic (sev) (code) (msg) (span) =
  deck-record (Diagnostic {
   code = code,
   message = substring msg 0 (text-length msg),
   severity = sev,
   span = span,
   related-spans = []
  })

make-error : Integer, Text, SourceSpan -> Diagnostic
make-error (code) (msg) (span) =
  make-diagnostic sev-error code msg span

make-warning : Integer, Text, SourceSpan -> Diagnostic
make-warning (code) (msg) (span) =
  make-diagnostic sev-warning code msg span

make-info : Integer, Text, SourceSpan -> Diagnostic
make-info (code) (msg) (span) =
  make-diagnostic sev-info code msg span

make-deprecated : Integer, Text, SourceSpan -> Diagnostic
make-deprecated (code) (msg) (span) =
  make-diagnostic sev-deprecated code msg span

make-error-related : Integer, Text, SourceSpan, List SourceSpan -> Diagnostic
make-error-related (code) (msg) (span) (related) =
  deck-record (Diagnostic {
   code = code,
   message = substring msg 0 (text-length msg),
   severity = sev-error,
   span = span,
   related-spans = related
  })

format-cdx-code : Integer -> Text
format-cdx-code (n) =
  "CDX" & integer-to-text-padded n 4

diagnostic-display : Diagnostic, FileTable -> Text
diagnostic-display (d) (table) =
  let loc = span-display (d.span) table
  in let prefix = if loc == "" then ""
   else loc & ": "
  in prefix & severity-label (d.severity) & " " & format-cdx-code (d.code) & ": " & d.message

empty-bag : DiagnosticBag
empty-bag =
  DiagnosticBag {
   diagnostics = [],
   error-count = 0,
   truncated = False
  }

bag-from-list : List Diagnostic -> DiagnosticBag
bag-from-list (ds) =
  bag-from-list-loop empty-bag ds 0 (list-length ds)

bag-from-list-loop : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
bag-from-list-loop (bag) (ds) (i) (len) =
  if i == len then bag
  else bag-from-list-loop (bag-add bag (list-at ds i)) ds (i + 1) len

bag-add : DiagnosticBag, Diagnostic -> DiagnosticBag
bag-add (bag) (d) =
  if d.severity == sev-error then bag-add-error bag d
  else deck-record (DiagnosticBag {
   diagnostics = deck-record (list-push (bag.diagnostics) d),
   error-count = bag.error-count,
   truncated = bag.truncated
  })

bag-add-error : DiagnosticBag, Diagnostic -> DiagnosticBag
bag-add-error (bag) (d) =
  if bag.error-count >= max-errors then if bag.truncated then bag
  else deck-record (DiagnosticBag {
   diagnostics = deck-record (list-push (bag.diagnostics) (make-error cdx-too-many-errors "Too many errors. Further errors suppressed." synthetic-span)),
   error-count = bag.error-count + 1,
   truncated = True
  })
  else deck-record (DiagnosticBag {
   diagnostics = deck-record (list-push (bag.diagnostics) d),
   error-count = bag.error-count + 1,
   truncated = bag.truncated
  })

bag-concat : DiagnosticBag, List Diagnostic -> DiagnosticBag
bag-concat (bag) (ds) =
  bag-concat-loop bag ds 0 (list-length ds)

bag-concat-loop : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
bag-concat-loop (bag) (ds) (i) (len) =
  if i == len then bag
  else bag-concat-loop (bag-add bag (list-at ds i)) ds (i + 1) len

bag-merge : DiagnosticBag, DiagnosticBag -> DiagnosticBag
bag-merge (bag) (other) =
  bag-concat bag (other.diagnostics)

bag-merge-all : List DiagnosticBag -> DiagnosticBag
bag-merge-all (bags) =
  bag-merge-all-loop empty-bag bags 0 (list-length bags)

bag-merge-all-loop : DiagnosticBag, List DiagnosticBag, Integer, Integer -> DiagnosticBag
bag-merge-all-loop (acc) (bags) (i) (len) =
  if i == len then acc
  else bag-merge-all-loop (bag-merge acc (list-at bags i)) bags (i + 1) len

bag-has-errors : DiagnosticBag -> Boolean
bag-has-errors (bag) =
  bag.error-count > 0

bag-count : DiagnosticBag -> Integer
bag-count (bag) =
  list-length (bag.diagnostics)

bag-diagnostics : DiagnosticBag -> List Diagnostic
bag-diagnostics (bag) =
  bag.diagnostics

bag-errors : DiagnosticBag -> List Diagnostic
bag-errors (bag) =
  bag-errors-loop (bag.diagnostics) [] 0 (list-length (bag.diagnostics))

bag-errors-loop : List Diagnostic, List Diagnostic, Integer, Integer -> List Diagnostic
bag-errors-loop (ds) (acc) (i) (len) =
  if i == len then acc
  else let d = list-at ds i
  in if d.severity == sev-error then bag-errors-loop ds (list-push acc d) (i + 1) len
     else bag-errors-loop ds acc (i + 1) len

bag-has-code : DiagnosticBag, Integer -> Boolean
bag-has-code (bag) (code) =
  bag-has-code-loop (bag.diagnostics) code 0 (list-length (bag.diagnostics))

bag-has-code-loop : List Diagnostic, Integer, Integer, Integer -> Boolean
bag-has-code-loop (ds) (code) (i) (len) =
  if i == len then False
  else if (list-at ds i).code == code then True
  else bag-has-code-loop ds code (i + 1) len

bag-is-truncated : DiagnosticBag -> Boolean
bag-is-truncated (bag) =
  bag.truncated

make-name : Text -> Name
make-name (s) =
  Name { value = s }

name-value : Name -> Text
name-value (n) =
  n.value

opening-entry-point : Text
opening-entry-point =
  "opening"

djb2-hash : Text -> Integer
djb2-hash (s) =
  djb2-loop s 0 (text-length s) 5381

djb2-loop : Text, Integer, Integer, Integer -> Integer
djb2-loop (s) (i) (len) (h) =
  if i == len then h
  else djb2-loop s (i + 1) len (int-mod (h * 33 + char-code-at s i) 2147483647)

fill-empty-keys : Integer, Integer, List Text -> List Text
fill-empty-keys (n) (i) (acc) =
  if i >= n then acc
  else fill-empty-keys n (i + 1) (list-push acc "")

fill-empty-values : Integer, Integer, List Integer -> List Integer
fill-empty-values (n) (i) (acc) =
  if i >= n then acc
  else fill-empty-values n (i + 1) (list-push acc (-1))

offset-table-empty : OffsetTable
offset-table-empty =
  OffsetTable {
   keys = fill-empty-keys offset-table-size 0 (__list-with-capacity offset-table-size),
   values = fill-empty-values offset-table-size 0 (__list-with-capacity offset-table-size)
  }

offset-table-insert-at : List Text, List Integer, Integer, Text, Integer -> OffsetTable
offset-table-insert-at (ks) (vs) (slot) (k) (v) =
  let existing = list-at ks slot
  in if existing == "" then OffsetTable {
   keys = offset-table-text-replace-at ks slot k,
   values = offset-table-int-replace-at vs slot v
  }
     else if existing == k then OffsetTable {
   keys = ks,
   values = offset-table-int-replace-at vs slot v
  }
     else offset-table-insert-at ks vs (bit-and (slot + 1) offset-table-mask) k v

offset-table-set : OffsetTable, Text, Integer -> OffsetTable
offset-table-set (m) (k) (v) =
  let h = djb2-hash k
  in let slot = bit-and h offset-table-mask
  in offset-table-insert-checked (m.keys) (m.values) slot k v 0

offset-table-insert-checked : List Text, List Integer, Integer, Text, Integer, Integer -> OffsetTable
offset-table-insert-checked (ks) (vs) (slot) (k) (v) (steps) =
  if steps >= offset-table-size then offset-table-insert-at ks vs slot k v
  else let existing = list-at ks slot
  in if existing == "" then OffsetTable {
   keys = offset-table-text-replace-at ks slot k,
   values = offset-table-int-replace-at vs slot v
  }
     else if existing == k then OffsetTable {
   keys = ks,
   values = offset-table-int-replace-at vs slot v
  }
     else offset-table-insert-checked ks vs (bit-and (slot + 1) offset-table-mask) k v (steps + 1)

offset-table-lookup-probe : List Text, List Integer, Integer, Text, Integer -> Integer
offset-table-lookup-probe (ks) (vs) (slot) (k) (steps) =
  if steps >= offset-table-size then -1
  else let existing = list-at ks slot
  in if existing == "" then -1
     else if existing == k then list-at vs slot
     else offset-table-lookup-probe ks vs (bit-and (slot + 1) offset-table-mask) k (steps + 1)

offset-table-get : OffsetTable, Text -> Integer
offset-table-get (m) (k) =
  let h = djb2-hash k
  in let slot = bit-and h offset-table-mask
  in offset-table-lookup-probe (m.keys) (m.values) slot k 0

offset-table-text-replace-at : List Text, Integer, Text -> List Text
offset-table-text-replace-at (xs) (idx) (x) =
  list-set-at xs idx x

offset-table-int-replace-at : List Integer, Integer, Integer -> List Integer
offset-table-int-replace-at (xs) (idx) (x) =
  list-set-at xs idx x

offset-table-lookup : OffsetTable, Text -> Integer
offset-table-lookup (m) (name) =
  offset-table-get m name

phase-infrastructure : Integer
phase-infrastructure =
  0

phase-lexer : Integer
phase-lexer =
  1

phase-parser : Integer
phase-parser =
  2

phase-prose-validation : Integer
phase-prose-validation =
  3

phase-name-resolver : Integer
phase-name-resolver =
  4

phase-type-checker : Integer
phase-type-checker =
  5

phase-linearity : Integer
phase-linearity =
  6

phase-proof-checker : Integer
phase-proof-checker =
  7

phase-capability-checker : Integer
phase-capability-checker =
  8

phase-codegen : Integer
phase-codegen =
  9

phase-label : Integer -> Text
phase-label (p) =
  if p == phase-infrastructure then "Infrastructure"
  else if p == phase-lexer then "Lexer"
  else if p == phase-parser then "Parser"
  else if p == phase-prose-validation then "ProseValidation"
  else if p == phase-name-resolver then "NameResolver"
  else if p == phase-type-checker then "TypeChecker"
  else if p == phase-linearity then "Linearity"
  else if p == phase-proof-checker then "ProofChecker"
  else if p == phase-capability-checker then "CapabilityChecker"
  else if p == phase-codegen then "CodeGen"
  else "Unknown"

pitch : Integer -> Integer
pitch (size) =
  let p = __heap-save
  in let advanced = __heap-advance size
  in p

strike : Integer -> Nothing
strike (start) =
  __heap-restore start

build : Integer -> Integer
build (size) =
  let p = __heap-save
  in let deck-init = __deck-set p
  in let advanced = __heap-advance size
  in p

seal : Integer -> Nothing
seal (start) =
  __heap-advance 0

deck-record : a0 -> a0
deck-record (x) =
  x

init-phase-allocator : Integer
init-phase-allocator =
  let base = __heap-save
  in let deck-init = __deck-set base
  in base

phase-start : PhaseStart
phase-start =
  let bivy = pitch 0
  in PhaseStart {
   bivy-origin = bivy,
   deck-origin = __deck-pos
  }

phase-measure : PhaseStart -> PhaseMetrics
phase-measure (ps) =
  let hwm = __heap-save
  in let deck-now = __deck-pos
  in deck-record (PhaseMetrics {
   bivy-origin = ps.bivy-origin,
   bivy-hwm = hwm,
   deck-origin = ps.deck-origin,
   deck-end = deck-now
  })

phase-compact : Nothing
phase-compact =
  __heap-restore __deck-pos

sev-error : Integer
sev-error =
  0

sev-warning : Integer
sev-warning =
  1

sev-info : Integer
sev-info =
  2

sev-hint : Integer
sev-hint =
  3

sev-deprecated : Integer
sev-deprecated =
  4

severity-label : Integer -> Text
severity-label (s) =
  if s == sev-error then "error"
  else if s == sev-warning then "warning"
  else if s == sev-info then "info"
  else if s == sev-hint then "hint"
  else if s == sev-deprecated then "deprecated"
  else "unknown"

skip-list-text-max-height : Integer
skip-list-text-max-height =
  16

make-end-node : SkipNodeText
make-end-node =
  deck-record (SkipNodeText {
   value = "",
   is-end = True,
   forward = [],
   spans = []
  })

replicate-node : Integer, SkipNodeText -> List SkipNodeText
replicate-node (n) (v) =
  replicate-node-loop n v 0 []

replicate-node-loop : Integer, SkipNodeText, Integer, List SkipNodeText -> List SkipNodeText
replicate-node-loop (n) (v) (i) (acc) =
  if i == n then acc
  else replicate-node-loop n v (i + 1) (list-push acc v)

replicate-int : Integer, Integer -> List Integer
replicate-int (n) (v) =
  replicate-int-loop n v 0 []

replicate-int-loop : Integer, Integer, Integer, List Integer -> List Integer
replicate-int-loop (n) (v) (i) (acc) =
  if i == n then acc
  else replicate-int-loop n v (i + 1) (list-push acc v)

trailing-zeros : Integer -> Integer
trailing-zeros (n) =
  if n == 0 then 0
  else trailing-zeros-loop n 0

trailing-zeros-loop : Integer, Integer -> Integer
trailing-zeros-loop (n) (acc) =
  if n / 2 * 2 /= n then acc
  else trailing-zeros-loop (n / 2) (acc + 1)

pick-height : Integer -> Integer
pick-height (counter) =
  let raw = 1 + trailing-zeros counter
  in if raw > skip-list-text-max-height then skip-list-text-max-height
     else raw

skip-list-text-empty : SkipListText
skip-list-text-empty =
  let end-node = make-end-node
  in let head-forward = replicate-node skip-list-text-max-height end-node
  in let head-spans = replicate-int skip-list-text-max-height 0
  in deck-record (SkipListText {
   head = deck-record (SkipNodeText {
    value = "",
    is-end = False,
    forward = head-forward,
    spans = head-spans
   }),
   size = 0,
   max-level = 0
  })

skip-list-text-size : SkipListText -> Integer
skip-list-text-size (s) =
  s.size

skip-list-text-is-empty : SkipListText -> Boolean
skip-list-text-is-empty (s) =
  s.size == 0

skip-list-text-has : SkipListText, Text -> Boolean
skip-list-text-has (s) (v) =
  if s.size == 0 then False
  else has-descend (s.head) (s.max-level - 1) v

has-descend : SkipNodeText, Integer, Text -> Boolean
has-descend (node) (level) (v) =
  if level < 0 then False
  else let node2 = advance-while-less node level v
  in let next = list-at (node2.forward) level
  in if next.is-end then has-descend node2 (level - 1) v
     else if next.value == v then True
     else has-descend node2 (level - 1) v

advance-while-less : SkipNodeText, Integer, Text -> SkipNodeText
advance-while-less (node) (level) (v) =
  let next = list-at (node.forward) level
  in if next.is-end then node
     else if text-compare (next.value) v < 0 then advance-while-less next level v
     else node

skip-list-text-at : SkipListText, Integer -> Text
skip-list-text-at (s) (i) =
  if i < 0 then ""
  else if i >= s.size then ""
  else at-descend (s.head) 0 (i + 1) (s.max-level - 1)

at-descend : SkipNodeText, Integer, Integer, Integer -> Text
at-descend (node) (pos) (target) (level) =
  if level < 0 then if pos == target then node.value
  else ""
  else let advanced = advance-with-spans node pos target level
  in at-descend (advanced.node) (advanced.pos) target (level - 1)

advance-with-spans : SkipNodeText, Integer, Integer, Integer -> AdvanceResult
advance-with-spans (node) (pos) (target) (level) =
  let next = list-at (node.forward) level
  in if next.is-end then AdvanceResult {
   node = node,
   pos = pos
  }
     else let span = list-at (node.spans) level
  in if pos + span > target then AdvanceResult {
   node = node,
   pos = pos
  }
     else advance-with-spans next (pos + span) target level

skip-list-text-rank-of : SkipListText, Text -> Integer
skip-list-text-rank-of (s) (v) =
  if s.size == 0 then 0 - 1
  else rank-descend (s.head) 0 v (s.max-level - 1)

rank-descend : SkipNodeText, Integer, Text, Integer -> Integer
rank-descend (node) (pos) (v) (level) =
  if level < 0 then let next = list-at (node.forward) 0
  in if next.is-end then 0 - 1
     else if text-compare (next.value) v == 0 then pos
     else 0 - 1
  else let advanced = advance-rank node pos v level
  in rank-descend (advanced.node) (advanced.pos) v (level - 1)

advance-rank : SkipNodeText, Integer, Text, Integer -> AdvanceResult
advance-rank (node) (pos) (v) (level) =
  let next = list-at (node.forward) level
  in if next.is-end then AdvanceResult {
   node = node,
   pos = pos
  }
     else if text-compare (next.value) v < 0 then let span = list-at (node.spans) level
  in advance-rank next (pos + span) v level
     else AdvanceResult {
   node = node,
   pos = pos
  }

skip-list-text-to-list : SkipListText -> List Text
skip-list-text-to-list (s) =
  if s.size == 0 then []
  else to-list-loop (list-at (s.head.forward) 0) []

to-list-loop : SkipNodeText, List Text -> List Text
to-list-loop (node) (acc) =
  if node.is-end then acc
  else to-list-loop (list-at (node.forward) 0) (list-push acc (node.value))

skip-list-text-from-list : List Text -> SkipListText
skip-list-text-from-list (xs) =
  skip-list-text-from-list-loop xs 0 (list-length xs) skip-list-text-empty

skip-list-text-from-list-loop : List Text, Integer, Integer, SkipListText -> SkipListText
skip-list-text-from-list-loop (xs) (i) (len) (acc) =
  if i == len then acc
  else skip-list-text-from-list-loop xs (i + 1) len (skip-list-text-insert acc (list-at xs i))

skip-list-text-clone : SkipListText -> SkipListText
skip-list-text-clone (s) =
  skip-list-text-from-list (skip-list-text-to-list s)

skip-list-text-union : SkipListText, SkipListText -> SkipListText
skip-list-text-union (a) (b) =
  let xs = skip-list-text-to-list b
  in skip-list-text-union-loop a xs 0 (list-length xs)

skip-list-text-union-loop : SkipListText, List Text, Integer, Integer -> SkipListText
skip-list-text-union-loop (a) (xs) (i) (len) =
  if i == len then a
  else skip-list-text-union-loop (skip-list-text-insert a (list-at xs i)) xs (i + 1) len

skip-list-text-insert : SkipListText, Text -> SkipListText
skip-list-text-insert (s) (v) =
  let path = build-update-path s v
  in let pred0 = list-at (path.nodes) 0
  in let next0 = list-at (pred0.forward) 0
  in if next0.is-end == False then if next0.value == v then s
  else install-new-node s v path
     else install-new-node s v path

build-update-path : SkipListText, Text -> UpdatePath
build-update-path (s) (v) =
  let init-nodes = replicate-node skip-list-text-max-height (s.head)
  in let init-ranks = replicate-int skip-list-text-max-height 0
  in build-update-loop (s.head) 0 (s.max-level - 1) v init-nodes init-ranks

build-update-loop : SkipNodeText, Integer, Integer, Text, List SkipNodeText, List Integer -> UpdatePath
build-update-loop (cursor) (pos) (level) (v) (nodes) (ranks) =
  if level < 0 then UpdatePath {
   nodes = nodes,
   ranks = ranks
  }
  else let advanced = advance-less-with-spans cursor pos level v
  in let nodes2 = list-set-at nodes level (advanced.node)
  in let ranks2 = list-set-at ranks level (advanced.pos)
  in build-update-loop (advanced.node) (advanced.pos) (level - 1) v nodes2 ranks2

advance-less-with-spans : SkipNodeText, Integer, Integer, Text -> AdvanceResult
advance-less-with-spans (node) (pos) (level) (v) =
  let next = list-at (node.forward) level
  in if next.is-end then AdvanceResult {
   node = node,
   pos = pos
  }
     else if text-compare (next.value) v < 0 then let span = list-at (node.spans) level
  in advance-less-with-spans next (pos + span) level v
     else AdvanceResult {
   node = node,
   pos = pos
  }

install-new-node : SkipListText, Text, UpdatePath -> SkipListText
install-new-node (s) (v) (path) =
  let new-height = pick-height (s.size + 1)
  in let path2 = extend-path-for-height s path new-height
  in let new-pos = list-at (path2.ranks) 0 + 1
  in let new-node = allocate-node v new-height path2 new-pos
  in let s2 = splice-new-node s path2 new-node new-height new-pos 0
  in let new-max = if new-height > s2.max-level then new-height
   else s2.max-level
  in let s3 = bump-spans-above s2 path2 new-height new-max
  in deck-record (SkipListText {
   head = s3.head,
   size = s3.size + 1,
   max-level = new-max
  })

extend-path-for-height : SkipListText, UpdatePath, Integer -> UpdatePath
extend-path-for-height (s) (path) (new-height) =
  if new-height <= s.max-level then path
  else extend-path-loop s path (s.max-level) new-height

extend-path-loop : SkipListText, UpdatePath, Integer, Integer -> UpdatePath
extend-path-loop (s) (path) (l) (new-height) =
  if l == new-height then path
  else let nodes2 = list-set-at (path.nodes) l (s.head)
  in let ranks2 = list-set-at (path.ranks) l 0
  in let dummy = list-set-at (s.head.spans) l (s.size)
  in extend-path-loop s (UpdatePath {
   nodes = nodes2,
   ranks = ranks2
  }) (l + 1) new-height

allocate-node : Text, Integer, UpdatePath, Integer -> SkipNodeText
allocate-node (v) (height) (path) (new-pos) =
  let init-forward = replicate-node height make-end-node
  in let init-spans = replicate-int height 0
  in let node-forward = fill-new-forward path height init-forward 0
  in let node-spans = fill-new-spans path height init-spans new-pos 0
  in deck-record (SkipNodeText {
   value = v,
   is-end = False,
   forward = node-forward,
   spans = node-spans
  })

fill-new-forward : UpdatePath, Integer, List SkipNodeText, Integer -> List SkipNodeText
fill-new-forward (path) (height) (acc) (i) =
  if i == height then acc
  else let pred = list-at (path.nodes) i
  in let target = list-at (pred.forward) i
  in fill-new-forward path height (list-set-at acc i target) (i + 1)

fill-new-spans : UpdatePath, Integer, List Integer, Integer, Integer -> List Integer
fill-new-spans (path) (height) (acc) (new-pos) (i) =
  if i == height then acc
  else let pred = list-at (path.nodes) i
  in let pred-rank = list-at (path.ranks) i
  in let old-span = list-at (pred.spans) i
  in let new-span = old-span - (new-pos - pred-rank - 1)
  in fill-new-spans path height (list-set-at acc i new-span) new-pos (i + 1)

splice-new-node : SkipListText, UpdatePath, SkipNodeText, Integer, Integer, Integer -> SkipListText
splice-new-node (s) (path) (new-node) (height) (new-pos) (i) =
  if i == height then s
  else let pred = list-at (path.nodes) i
  in let pred-rank = list-at (path.ranks) i
  in let dummy1 = list-set-at (pred.forward) i new-node
  in let dummy2 = list-set-at (pred.spans) i (new-pos - pred-rank)
  in splice-new-node s path new-node height new-pos (i + 1)

bump-spans-above : SkipListText, UpdatePath, Integer, Integer -> SkipListText
bump-spans-above (s) (path) (from-level) (max-level-val) =
  if from-level >= max-level-val then s
  else let pred = list-at (path.nodes) from-level
  in let old = list-at (pred.spans) from-level
  in let dummy = list-set-at (pred.spans) from-level (old + 1)
  in bump-spans-above s path (from-level + 1) max-level-val

empty-file-table : FileTable
empty-file-table =
  FileTable { names = [] }

file-table-add : FileTable, Text -> FileTable
file-table-add (table) (name) =
  FileTable { names = list-push (table.names) name }

file-table-name : FileTable, Integer -> Text
file-table-name (table) (id) =
  if id <= 0 then ""
  else if id > list-length (table.names) then ""
  else list-at (table.names) (id - 1)

file-table-count : FileTable -> Integer
file-table-count (table) =
  list-length (table.names)

make-position : Integer, Integer, Integer -> SourcePosition
make-position (line) (col) (offset) =
  deck-record (SourcePosition {
   line = line,
   column = col,
   offset = offset
  })

make-span : SourcePosition, SourcePosition, Integer, Provenance -> SourceSpan
make-span (s) (e) (fid) (prov) =
  deck-record (SourceSpan {
   start = s,
   end = e,
   file-id = fid,
   provenance = prov
  })

span-length : SourceSpan -> Integer
span-length (span) =
  span.end.offset - span.start.offset

synthetic-span : SourceSpan
synthetic-span =
  SourceSpan {
   start = SourcePosition {
    line = 0,
    column = 0,
    offset = 0
   },
   end = SourcePosition {
    line = 0,
    column = 0,
    offset = 0
   },
   file-id = 0,
   provenance = ProvSynthetic
  }

is-synthetic-span : SourceSpan -> Boolean
is-synthetic-span (span) =
  span.file-id == 0

span-at : Integer, Integer, Integer, Integer, Integer -> SourceSpan
span-at (line) (col) (offset) (len) (fid) =
  let start = make-position line col offset
  in let stop = make-position line (col + len) (offset + len)
  in make-span start stop fid ProvParsed

span-with-provenance : SourceSpan, Provenance -> SourceSpan
span-with-provenance (span) (prov) =
  deck-record (SourceSpan {
   start = span.start,
   end = span.end,
   file-id = span.file-id,
   provenance = prov
  })

span-display : SourceSpan, FileTable -> Text
span-display (span) (table) =
  if is-synthetic-span span then ""
  else let name = file-table-name table (span.file-id)
  in (if name == "" then ""
  else name & ":") & integer-to-text (span.start.line) & ":" & integer-to-text (span.start.column)

pad-zeros-loop : Integer, Text -> Text
pad-zeros-loop (remaining) (s) =
  if remaining <= 0 then s
  else pad-zeros-loop (remaining - 1) ("0" & s)

integer-to-text-padded : Integer, Integer -> Text
integer-to-text-padded (n) (width) =
  let s = integer-to-text n
  in let len = text-length s
  in if len >= width then s
     else pad-zeros-loop (width - len) s

vm-profile-spec : VmProfile
vm-profile-spec =
  VmProfile {
   name = "spec",
   skip-ata-bring-up = False
  }

vm-profile-qemu-11-0-0 : VmProfile
vm-profile-qemu-11-0-0 =
  VmProfile {
   name = "QEMU-11.0.0",
   skip-ata-bring-up = True
  }

lookup-vm-profile : Text -> VmProfile
lookup-vm-profile (name) =
  if name == "QEMU-11.0.0" then vm-profile-qemu-11-0-0
  else vm-profile-spec

int-mod : Integer, Integer -> Integer
int-mod (n) (d) =
  let abs-d = if d < 0 then -(d)
   else d
  in let r = n - n / d * d
  in if r < 0 then r + abs-d
     else r

floor-div : Integer, Integer -> Integer
floor-div (n) (d) =
  if n >= 0 then n / d
  else (n - d + 1) / d

to-byte : Integer -> Integer
to-byte (n) =
  int-mod n 256

rex : Boolean, Boolean, Boolean, Boolean -> Integer
rex (w) (r) (x) (b) =
  let wv = if w then 8
   else 0
  in let rv = if r then 4
   else 0
  in let xv = if x then 2
   else 0
  in let bv = if b then 1
   else 0
  in 64 + wv + rv + xv + bv

rex-w : Integer, Integer -> Integer
rex-w (reg) (rm) =
  rex True (reg >= 8) False (rm >= 8)

modrm : Integer, Integer, Integer -> Integer
modrm (m) (reg) (rm) =
  m * 64 + int-mod reg 8 * 8 + int-mod rm 8

sib : Integer, Integer, Integer -> Integer
sib (scale) (index) (base-reg) =
  scale * 64 + int-mod index 8 * 8 + int-mod base-reg 8

write-bytes : Integer, Integer -> List Integer
write-bytes (v) (n) =
  if n == 0 then []
  else [to-byte v] & write-bytes (floor-div v 256) (n - 1)

write-i8 : Integer -> List Integer
write-i8 (v) =
  [to-byte v]

write-i32 : Integer -> List Integer
write-i32 (v) =
  write-bytes v 4

write-i64 : Integer -> List Integer
write-i64 (v) =
  write-bytes v 8

emit-mem-operand : Integer, Integer, Integer -> List Integer
emit-mem-operand (reg) (rm) (offset) =
  let rm-low = int-mod rm 8
  in let needs-sib = rm-low == 4
  in let rbp-base = rm-low == 5
  in let sib-byte = if needs-sib then [sib 0 4 rm-low]
   else []
  in if offset == 0 & rbp-base == False then [modrm 0 reg rm] & sib-byte
     else if offset >= -128 & offset <= 127 then [modrm 1 reg rm] & sib-byte & write-i8 offset
     else [modrm 2 reg rm] & sib-byte & write-i32 offset

