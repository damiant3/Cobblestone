Chapter: AgreeingApplies
  cites Foreword chapter Console

Section: F

  add-lens : List Integer, List Integer -> Integer
  add-lens (a) (b) = list-length a + list-length b

  w : Integer
  w = list-length [[], [1]] + add-lens [1, 2] [3]

  opening : [Console] Nothing = act
    print-line-uni (show w)
  end