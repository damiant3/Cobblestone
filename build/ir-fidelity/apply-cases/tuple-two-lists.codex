Chapter: TupleTwoLists
  cites Foreword chapter Console

Section: F

  read-two : Integer -> Integer
  read-two (n) =
   let x = [1, 2]
   in let y = [3, 4]
   in let (first, second) = (x, y)
   in list-at first 0 + list-at first 1 + n

  opening : [Console] Nothing = act
    print-line-uni (show (read-two 0))
  end