  skip-list-text-from-list (["abs", "bit-and", "bit-not", "bit-or", "bit-shl", "bit-shr", "bit-shru", "bit-xor", "__buf-read-bytes", "__buf-write-byte", "__buf-write-bytes", "chan-text-recv", "chan-text-send", "char-at", "char-code", "char-code-at", "char-to-text", "code-to-char", "current-dir", "__deck-alloc", "__deck-enter", "__deck-exit", "__deck-pos", "__deck-set", "fail", "file-exists", "get-args", "__heap-advance", "__heap-restore", "__heap-save", "int-mod", "integer-to-text", "is-digit", "is-letter", "is-whitespace", "__linked-list-empty", "__linked-list-push"] & ["__linked-list-to-list", "list-append", "list-at", "list-cons", "list-insert-at", "list-length", "list-set-at", "list-snoc", "list-push", "__list-with-capacity", "max", "min", "__narrow", "negate", "print-line", "print-line-raw", "print-line-uni", "print-uni", "print-error", "print-error-uni", "read-file", "read-file-raw", "read-file-uni", "read-line", "read-serial-cce", "__record-set", "run-state", "set-state", "show", "substring", "text-compare", "text-concat-list", "text-contains", "text-length", "text-replace", "text-split", "text-starts-with", "text-to-double-bits", "text-to-integer", "uefi-read-file", "write-binary", "write-file", "Refl", "assume", "sym", "trans", "cong"])

is-builtin : SkipListText, Text -> Boolean
is-builtin (names) (name) =
