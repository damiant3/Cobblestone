  write-i32 464367618 & write-i32 65536 & write-i32 3830534142 & write-i32 bare-metal-load-addr & write-i32 bare-metal-load-addr & write-i32 0 & write-i32 0 & write-i32 (bare-metal-load-addr + 32)

