
Chapter: Types--Unification

CharClass =
  | Whitespace
  | Digit
  | Lower
  | Upper
  | Punct
  | Accented
  | Cyrillic
  | Other

Sha256State = record {
  a : Integer,
  b : Integer,
  c : Integer,
  d : Integer,
  e : Integer,
  f : Integer,
  g : Integer,
  h : Integer
}

SortPartition = record {
  list : List a,
  pivot : Integer
}

Fat16Volume = record {
  vol-part-start : Integer,
  vol-bytes-per-sector : Integer,
  vol-sectors-per-cluster : Integer,
  vol-reserved-sectors : Integer,
  vol-num-fats : Integer,
  vol-root-entry-count : Integer,
  vol-fat-sectors : Integer,
  vol-fat-start : Integer,
  vol-root-start : Integer,
  vol-data-start : Integer
}

Fat16DirEntry = record {
  de-name : Text,
  de-attr : Integer,
  de-cluster : Integer,
  de-size : Integer
}

Maybe (a) =
  | Just (a)
  | None

CompileFlags = record {
  prose : Boolean
}

CompileTarget =
  | CtCodexText
  | CtX86_64Bare
  | CtCdx

CompileFrontend = record {
  type-defs : List ATypeDef,
  text-meta : IRTextMeta,
  ir : IRChapter,
  cdx-ir : IRChapter,
  sorted-type-defs : List TypeBinding,
  bag : DiagnosticBag,
  heap-marks : List Integer,
  phase-metrics : List PhaseMetrics
}

LexResult = record {
  tokens : List Token,
  bag : DiagnosticBag,
  heap-marks : List Integer,
  phase-metrics : List PhaseMetrics
}

ParseResult = record {
  doc : Document,
  colliding : SkipListText,
  assignments : List ChapterAssignment,
  parse-bag : DiagnosticBag,
  heap-marks : List Integer,
  phase-metrics : List PhaseMetrics
}

ScopeResult = record {
  scoped : AChapter,
  ctor-names : List Text,
  resolve-bag : DiagnosticBag,
  heap-marks : List Integer,
  phase-metrics : List PhaseMetrics
}

CompileChecked = record {
  scoped : AChapter,
  types : List TypeBinding,
  type-env : TypeEnv,
  ust : UnificationState,
  ctor-names : List Text,
  bag : DiagnosticBag,
  heap-marks : List Integer,
  phase-metrics : List PhaseMetrics
}

ForewordLoadResult = record {
  prefix : Text,
  bag : DiagnosticBag
}

DiskLoadState = record {
  dls-seen : List Text,
  dls-chunks : List Text
}

LiteralKind =
  | IntLit
  | NumLit
  | TextLit
  | CharLit
  | BoolLit

BinaryOp =
  | OpAdd
  | OpSub
  | OpMul
  | OpDiv
  | OpPow
  | OpEq
  | OpNotEq
  | OpLt
  | OpGt
  | OpLtEq
  | OpGtEq
  | OpDefEq
  | OpAppend
  | OpCons
  | OpAnd
  | OpOr

AExpr =
  | ALitExpr (Text) (LiteralKind) (SourceSpan)
  | ANameExpr (Name) (SourceSpan)
  | AApplyExpr (AExpr) (AExpr) (SourceSpan)
  | ABinaryExpr (AExpr) (BinaryOp) (AExpr) (SourceSpan)
  | AUnaryExpr (AExpr) (SourceSpan)
  | AIfExpr (AExpr) (AExpr) (AExpr) (SourceSpan)
  | ALetExpr (List ALetBind) (AExpr) (SourceSpan)
  | ALambdaExpr (List Name) (AExpr) (SourceSpan)
  | AMatchExpr (AExpr) (List AMatchArm) (SourceSpan)
  | AListExpr (List AExpr) (SourceSpan)
  | ARecordExpr (Name) (List AFieldExpr) (SourceSpan)
  | AFieldAccess (AExpr) (Name) (SourceSpan)
  | AActExpr (List AActStmt) (SourceSpan)
  | AHandleExpr (Name) (AExpr) (List AHandleClause) (SourceSpan)
  | AWithTimeoutExpr (Text) (List Name) (List Text) (AExpr) (SourceSpan)
  | ATryExpr (Integer) (List AActStmt) (List AActStmt) (List AActStmt) (SourceSpan)
  | AFieldAssignExpr (AExpr) (Name) (AExpr) (SourceSpan)
  | AErrorExpr (Text) (SourceSpan)

ALetBind = record {
  name : Name,
  value : AExpr,
  span : SourceSpan
}

AMatchArm = record {
  pattern : APat,
  body : AExpr,
  span : SourceSpan
}

AFieldExpr = record {
  name : Name,
  value : AExpr,
  span : SourceSpan
}

AActStmt =
  | AActBindStmt (Name) (AExpr) (SourceSpan)
  | AActExprStmt (AExpr) (SourceSpan)

AHandleClause = record {
  op-name : Name,
  params : List Name,
  resume-name : Name,
  body : AExpr,
  span : SourceSpan
}

APat =
  | AVarPat (Name) (SourceSpan)
  | ALitPat (Text) (LiteralKind) (SourceSpan)
  | ACtorPat (Name) (List APat) (SourceSpan)
  | AWildPat (SourceSpan)

ATypeExpr =
  | ANamedType (Name) (SourceSpan)
  | AFunType (ATypeExpr) (ATypeExpr) (SourceSpan)
  | AAppType (ATypeExpr) (List ATypeExpr) (SourceSpan)
  | AEffectType (List Name) (List Text) (ATypeExpr) (SourceSpan)
  | ABoundedIntType (ATypeExpr) (Integer) (Integer) (OverflowMode) (SourceSpan)
  | APropEqType (ATypeExpr) (ATypeExpr) (SourceSpan)
  | AConstrainedType (Name) (Name) (ATypeExpr) (SourceSpan)

AParam = record {
  name : Name,
  span : SourceSpan
}

ADef = record {
  name : Name,
  params : List AParam,
  declared-type : List ATypeExpr,
  body : AExpr,
  chapter-slug : Text,
  span : SourceSpan
}

ARecordFieldDef = record {
  name : Name,
  type-expr : ATypeExpr,
  span : SourceSpan
}

AVariantCtorDef = record {
  name : Name,
  fields : List ATypeExpr,
  span : SourceSpan
}

ATypeDef =
  | ARecordTypeDef (Name) (List Name) (List ARecordFieldDef) (Boolean) (SourceSpan)
  | AVariantTypeDef (Name) (List Name) (List AVariantCtorDef) (SourceSpan)

AEffectOpDef = record {
  name : Name,
  type-expr : ATypeExpr,
  span : SourceSpan
}

AEffectDef = record {
  name : Name,
  ops : List AEffectOpDef,
  span : SourceSpan
}

AClassDef = record {
  name : Name,
  methods : List AEffectOpDef,
  span : SourceSpan
}

AInstanceMethodDef = record {
  name : Name,
  params : List Name,
  body : AExpr,
  span : SourceSpan
}

AInstanceDef = record {
  class-name : Name,
  type-name : Name,
  methods : List AInstanceMethodDef,
  span : SourceSpan
}

ACitesDecl = record {
  quire : Name,
  chapter-name : Name,
  selected-names : List Name,
  citing-chapter : Text,
  span : SourceSpan
}

AChapter = record {
  name : Name,
  defs : List ADef,
  type-defs : List ATypeDef,
  effect-defs : List AEffectDef,
  class-defs : List AClassDef,
  instance-defs : List AInstanceDef,
  citations : List ACitesDecl,
  chapter-title : Text,
  prose : Text,
  section-titles : List Text,
  span : SourceSpan
}

CdxCodeInfo = record {
  code : Integer between 0 and 65535,
  name : Text,
  severity : Integer between 0 and 3,
  phase : Integer between 0 and 15,
  summary : Text
}

Diagnostic = record {
  code : Integer between 0 and 65535,
  message : Text,
  severity : Integer between 0 and 4,
  span : SourceSpan,
  related-spans : List SourceSpan
}

DiagnosticBag = record {
  diagnostics : List Diagnostic,
  error-count : Integer between 0 and 255,
  truncated : Boolean
}

Name = record {
  value : Text
}

OffsetTable = record {
  keys : List Text,
  values : List Integer
}

PhaseStart = record {
  bivy-origin : Integer between 0 and 4294967295,
  deck-origin : Integer between 0 and 4294967295
}

PhaseMetrics = record {
  bivy-origin : Integer between 0 and 4294967295,
  bivy-hwm : Integer between 0 and 4294967295,
  deck-origin : Integer between 0 and 4294967295,
  deck-end : Integer between 0 and 4294967295
}

SkipNodeText = record {
  value : Text,
  is-end : Boolean,
  forward : List SkipNodeText,
  spans : List Integer
}

SkipListText = record {
  head : SkipNodeText,
  size : Integer between 0 and 4294967295,
  max-level : Integer between 0 and 255
}

AdvanceResult = record {
  node : SkipNodeText,
  pos : Integer between 0 and 4294967295 wrapping
}

UpdatePath = record {
  nodes : List SkipNodeText,
  ranks : List Integer
}

Provenance =
  | ProvParsed
  | ProvDesugared
  | ProvSynthetic

SourcePosition = record {
  line : Integer between 0 and 131071,
  column : Integer between 0 and 4294967295,
  offset : Integer between 0 and 4294967295
}

SourceSpan = record {
  start : SourcePosition,
  end : SourcePosition,
  file-id : Integer between 0 and 65535,
  provenance : Provenance
}

FileTable = record {
  names : List Text
}

VmProfile = record {
  name : Text,
  skip-ata-bring-up : Boolean
}

X86_64ExitMode =
  | ExitRepl
  | Exit
  | ExitAcpiS5
  | ExitUefi

X86_64WatchdogMode =
  | WatchdogProgress
  | WatchdogPet

UserArity = record {
  name : Text,
  arity : Integer between 0 and 255
}

FuncOffset = record {
  name : Text,
  offset : Integer between 0 and 4294967295
}

CallPatch = record {
  patch-offset : Integer between 0 and 4294967295,
  target : Text
}

LocalBinding = record {
  name : Text,
  slot : Integer between 0 and 65535
}

FuncAddrFixup = record {
  patch-offset : Integer between 0 and 4294967295,
  target : Text
}

RodataFixup = record {
  patch-offset : Integer between 0 and 4294967295,
  rodata-offset : Integer between 0 and 4294967295
}

TcoState = record {
  active : Boolean,
  in-tail-pos : Boolean,
  loop-top : Integer between 0 and 4294967295,
  param-locals : List Integer,
  temp-locals : List Integer,
  current-func : Text,
  saved-next-local : Integer between 0 and 65535,
  saved-next-temp : Integer between 0 and 65535
}

mutable CodegenState = record {
  workspace : EmitWorkspace,
  code-len : Integer between 0 and 4294967295,
  data-len : Integer between 0 and 4294967295,
  fo-names : List Text,
  fo-offsets : List Integer,
  cp-offsets : List Integer,
  cp-targets : List Text,
  fa-offsets : List Integer,
  fa-targets : List Text,
  rf-poffsets : List Integer,
  rf-roffsets : List Integer,
  da-poffsets : List Integer,
  da-offsets : List Integer,
  stack-overflow-checks : List Integer,
  locals : List LocalBinding,
  next-temp : Integer between 0 and 65535,
  next-local : Integer between 0 and 65535,
  spill-count : Integer between 0 and 65535,
  load-local-toggle : Integer between 0 and 4294967295,
  tco : TcoState,
  type-defs : List TypeBinding,
  builtin-names : SkipListText,
  emit-work : Integer between 0 and 4294967295,
  exit-mode : X86_64ExitMode,
  watchdog-mode : X86_64WatchdogMode,
  opening-ret-type : CodexType,
  state-local : Integer,
  user-arities : List UserArity,
  bag : DiagnosticBag,
  deck-bound : Boolean,
  effect-op-addrs : List EffectOpAddr,
  vm-profile : VmProfile,
  poison-alloc : Boolean,
  trace-alloc : Boolean
}

EffectOpAddr = record {
  name : Text,
  addr : Integer between 0 and 4294967295
}

EmitResult = record {
  state : CodegenState,
  reg : Integer between 0 and 4294967295
}

TrampolineResult = record {
  bytes : List Integer,
  far-jump-patch-pos : Integer between 0 and 4294967295
}

EmitChapterResult = record {
  bytes : List Integer,
  bag : DiagnosticBag,
  symbol-map : List Text
}

FlatApply = record {
  func-name : Text,
  args : List IRExpr
}

SavedArgs = record {
  state : CodegenState,
  locals : List Integer
}

FieldLocal = record {
  name : Text,
  slot : Integer between 0 and 65535,
  value-expr : IRExpr
}

EvalFieldsResult = record {
  state : CodegenState,
  field-locals : List FieldLocal
}

MatchBranchState = record {
  cg-state : CodegenState,
  end-patches : List Integer
}

BivyAlloc = record {
  state : CodegenState,
  ptr-loc : Integer between 0 and 65535
}

PatchEntry = record {
  pos : Integer between 0 and 4294967295,
  b0 : Integer between 0 and 255,
  b1 : Integer between 0 and 255,
  b2 : Integer between 0 and 255,
  b3 : Integer between 0 and 255
}

TypeVarMap = record {
  entries : List Integer,
  next-id : Integer between 0 and 65535
}

ApplyChain = record {
  root : IRExpr,
  args : List IRExpr
}

EmitWorkspace = record {
  code-buffer : Integer between 0 and 4294967295,
  code-capacity : Integer between 0 and 4294967295,
  data-buffer : Integer between 0 and 4294967295,
  data-capacity : Integer between 0 and 4294967295
}

TcoAllocResult = record {
  alloc-state : CodegenState,
  alloc-locals : List Integer
}

ConcatManyEval = record {
  state : CodegenState,
  locals : List Integer
}

SumEqAccum = record {
  state : CodegenState,
  ne-jumps : List Integer,
  eq-jumps : List Integer
}

IsrStubResult = record {
  state : CodegenState,
  first-stub-vaddr : Integer between 0 and 4294967295
}

SyscallResult = record {
  state : CodegenState,
  handler-offset : Integer between 0 and 4294967295
}

CheckExpiryResult = record {
  state : CodegenState,
  deny-offset : Integer between 0 and 4294967295
}

BlockSyscallResult = record {
  state : CodegenState,
  done-jmp : Integer between 0 and 4294967295
}

BuiltinX86Emitter = record {
  name : Text,
  emit : CodegenState, List IRExpr -> EmitResult
}

MapStrings = record {
  bytes : List Integer,
  offsets : List Integer
}

FieldOffsetType = record {
  offset : Integer between 0 and 65535,
  type-val : CodexType
}

LayoutResult = record {
  offsets : List Integer,
  byte-size : Integer between 0 and 65535
}

RecordLayoutPair = record {
  sorted : SkipListText,
  layout : LayoutResult,
  by-list : Boolean
}

EmitPatternResult = record {
  state : CodegenState,
  next-branch-patch : Integer
}

StrEqHeadResult = record {
  cg : CodegenState,
  len-ne-pos : Integer between 0 and 4294967295
}

StrEqLoopResult = record {
  cg : CodegenState,
  loop-done-pos : Integer between 0 and 4294967295,
  byte-ne-pos : Integer between 0 and 4294967295
}

ItoaZeroResult = record {
  cg : CodegenState,
  skip-digits-pos : Integer between 0 and 4294967295
}

StrConcatCheckResult = record {
  cg : CodegenState,
  slow-path-pos : Integer between 0 and 4294967295
}

StrConcatFastResult = record {
  cg : CodegenState,
  fast-done-pos : Integer between 0 and 4294967295
}

HelpResult1 = record {
  cg : CodegenState,
  p1 : Integer between 0 and 4294967295
}

HelpResult2 = record {
  cg : CodegenState,
  p1 : Integer between 0 and 4294967295,
  p2 : Integer between 0 and 4294967295
}

HelpResult3 = record {
  cg : CodegenState,
  p1 : Integer between 0 and 4294967295,
  p2 : Integer between 0 and 4294967295,
  p3 : Integer between 0 and 4294967295
}

HelpResult4 = record {
  cg : CodegenState,
  p1 : Integer between 0 and 4294967295,
  p2 : Integer between 0 and 4294967295,
  p3 : Integer between 0 and 4294967295,
  p4 : Integer between 0 and 4294967295
}

ItoaState = record {
  cg : CodegenState,
  jmp-done-zero-pos : Integer between 0 and 4294967295
}

IRBinaryOp =
  | IrAddInt
  | IrSubInt
  | IrMulInt
  | IrDivInt
  | IrPowInt
  | IrAddNum
  | IrSubNum
  | IrMulNum
  | IrDivNum
  | IrEq
  | IrNotEq
  | IrLt
  | IrGt
  | IrLtEq
  | IrGtEq
  | IrAnd
  | IrOr
  | IrAppendText
  | IrAppendList
  | IrConsList

IRExpr =
  | IrIntLit (Integer) (SourceSpan)
  | IrNumLit (Integer) (SourceSpan)
  | IrTextLit (Text) (SourceSpan)
  | IrBoolLit (Boolean) (SourceSpan)
  | IrCharLit (Integer) (SourceSpan)
  | IrName (Text) (CodexType) (SourceSpan)
  | IrBinary (IRBinaryOp) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
  | IrNegate (IRExpr) (SourceSpan)
  | IrIf (IRExpr) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
  | IrLet (Text) (CodexType) (IRExpr) (IRExpr) (SourceSpan)
  | IrApply (IRExpr) (IRExpr) (CodexType) (SourceSpan)
  | IrLambda (List IRParam) (IRExpr) (CodexType) (SourceSpan)
  | IrList (List IRExpr) (CodexType) (SourceSpan)
  | IrMatch (IRExpr) (List IRBranch) (CodexType) (SourceSpan)
  | IrAct (List IRActStmt) (CodexType) (SourceSpan)
  | IrHandle (Text) (IRExpr) (List IRHandleClause) (CodexType) (SourceSpan)
  | IrWithTimeout (Integer) (List Text) (List Text) (IRExpr) (CodexType) (SourceSpan)
  | IrRecord (Text) (List IRFieldVal) (CodexType) (SourceSpan)
  | IrFieldAccess (IRExpr) (Text) (CodexType) (SourceSpan)
  | IrFork (IRExpr) (CodexType) (SourceSpan)
  | IrAwait (IRExpr) (CodexType) (SourceSpan)
  | IrTry (Integer) (List IRActStmt) (List IRActStmt) (List IRActStmt) (CodexType) (SourceSpan)
  | IrFieldStore (IRExpr) (Text) (IRExpr) (CodexType) (SourceSpan)
  | IrError (Text) (CodexType) (SourceSpan)

IRParam = record {
  name : Text,
  type-val : CodexType,
  span : SourceSpan
}

IRBranch = record {
  pattern : IRPat,
  body : IRExpr,
  span : SourceSpan
}

IRPat =
  | IrVarPat (Text) (CodexType) (SourceSpan)
  | IrLitPat (Text) (CodexType) (SourceSpan)
  | IrCtorPat (Text) (List IRPat) (CodexType) (SourceSpan)
  | IrWildPat (SourceSpan)

IRActStmt =
  | IrDoBind (Text) (CodexType) (IRExpr) (SourceSpan)
  | IrDoExec (IRExpr) (SourceSpan)

IRHandleClause = record {
  op-name : Text,
  params : List Text,
  resume-name : Text,
  body : IRExpr,
  span : SourceSpan
}

IRFieldVal = record {
  name : Text,
  value : IRExpr,
  span : SourceSpan
}

IRDef = record {
  name : Text,
  params : List IRParam,
  type-val : CodexType,
  body : IRExpr,
  chapter-slug : Text,
  span : SourceSpan
}

IRChapter = record {
  name : Name,
  defs : List IRDef,
  effect-op-names : List Text,
  span : SourceSpan
}

IRTextMeta = record {
  chapter-title : Text,
  prose : Text,
  section-titles : List Text,
  ctor-names : List Text
}

LiftCtx = record {
  reserved : SkipListText,
  counter : Integer between 0 and 4294967295,
  lifted : List IRDef
}

LiftExprResult = record {
  ctx : LiftCtx,
  expr : IRExpr
}

LiftExprsResult = record {
  ctx : LiftCtx,
  exprs : List IRExpr
}

LiftFieldsResult = record {
  ctx : LiftCtx,
  fields : List IRFieldVal
}

LiftBranchesResult = record {
  ctx : LiftCtx,
  branches : List IRBranch
}

LiftActStmtsResult = record {
  ctx : LiftCtx,
  stmts : List IRActStmt
}

LiftDefsResult = record {
  ctx : LiftCtx,
  defs : List IRDef
}

FreeVar = record {
  name : Text,
  type-val : CodexType
}

GenNameResult = record {
  ctx : LiftCtx,
  name : Text
}

LiftClausesResult = record {
  ctx : LiftCtx,
  clauses : List IRHandleClause
}

LowerCtx = record {
  overlay : LookupOverlay,
  base : List TypeBinding,
  ust : UnificationState,
  local-type-vars : List Integer
}

LookupOverlay =
  | OverlayNil
  | OverlayCons (TypeBinding) (LookupOverlay)

ChapterAssignment = record {
  def-name : Text,
  chapter-slug : Text
}

RenameEntry = record {
  original : Text,
  mangled : Text
}

mutable Scope = record {
  names : SkipListText,
  locals : SkipListText
}

ResolveResult = record {
  bag : DiagnosticBag,
  top-level-names : SkipListText,
  type-names : SkipListText,
  ctor-names : List Text
}

ResolveScopeResult = record {
  scope : Scope,
  errors : List Diagnostic
}

PatResult = record {
  scope : Scope,
  seen : SkipListText,
  errors : List Diagnostic
}

CollectResult = record {
  names : SkipListText,
  errors : List Diagnostic
}

CtorCollectResult = record {
  type-names : SkipListText,
  ctor-names : SkipListText,
  errors : List Diagnostic
}

TypeNameDupResult = record {
  type-acc : SkipListText,
  errors : List Diagnostic
}

VariantCtorResult = record {
  ctor-acc : SkipListText,
  errors : List Diagnostic
}

EffectOpCollectResult = record {
  op-names : SkipListText,
  errors : List Diagnostic
}

mutable LexState = record {
  source : Text,
  offset : Integer between 0 and 4294967295,
  line : Integer between 0 and 131071,
  column : Integer between 0 and 4294967295,
  file-id : Integer between 0 and 65535,
  errors : LinkedList Diagnostic,
  prose-mode : Boolean
}

LexStep =
  | LexToken (Token) (LexState)
  | LexEnd

TokenizeResult = record {
  tokens : List Token,
  errors : List Diagnostic
}

LexCollected = record {
  collected-tokens : LinkedList Token,
  collected-errors : LinkedList Diagnostic
}

BoundIntResult = record {
  value : Integer,
  state : ParseState
}

OverflowModeResult = record {
  value : OverflowMode,
  state : ParseState
}

EffectNamesResult = record {
  names : List Token,
  state : ParseState,
  scopes : List Token
}

CiteTitleResult = record {
  title : Text,
  state : ParseState
}

SelectedNamesResult = record {
  names : List Token,
  state : ParseState
}

ImportParseResult = record {
  imports : List CitesDecl,
  state : ParseState
}

CollectProseResult = record {
  state : ParseState,
  lines : LinkedList Text,
  blocks : LinkedList ProseBlock
}

EffectOpsResult = record {
  ops : List EffectOpDef,
  state : ParseState
}

ClassDefsResult = record {
  class-defs : List ClassDef,
  instance-defs : List InstanceDef
}

InstanceMethodsResult = record {
  defs : List InstanceMethodDef,
  state : ParseState
}

InstanceParamsResult = record {
  params : List Token,
  state : ParseState
}

BannedWord = record {
  word : Text,
  substitute : Text
}

mutable ParseState = record {
  tokens : List Token,
  pos : Integer between 0 and 4294967295,
  bag : DiagnosticBag,
  paren-depth : Integer between 0 and 65535,
  fuel : Integer
}

ParseExprResult =
  | ExprOk (Expr) (ParseState)

ParsePatResult =
  | PatOk (Pat) (ParseState)

ParseTypeResult =
  | TypeOk (TypeExpr) (ParseState)

ParseDefResult = record {
  maybe-def : Maybe Def,
  state : ParseState
}

ParseTypeDefResult = record {
  maybe-type-def : Maybe TypeDef,
  state : ParseState
}

HandleParseResult = record {
  clauses : List HandleClause,
  state : ParseState
}

HandleParamsResult = record {
  toks : LinkedList Token,
  state : ParseState
}

LambdaParamsResult = record {
  toks : LinkedList Token,
  state : ParseState
}

Expr =
  | LitExpr (Token)
  | NameExpr (Token)
  | AppExpr (Expr) (Expr)
  | BinExpr (Expr) (Token) (Expr)
  | UnaryExpr (Token) (Expr)
  | IfExpr (Expr) (Expr) (Expr)
  | LetExpr (List LetBind) (Expr)
  | MatchExpr (Expr) (List MatchArm)
  | ListExpr (List Expr)
  | RecordExpr (Token) (List RecordFieldExpr)
  | FieldExpr (Expr) (Token)
  | ParenExpr (Expr)
  | ActExpr (List ActStmt)
  | HandleExpr (Token) (Expr) (List HandleClause)
  | WithTimeoutExpr (Token) (List Token) (List Token) (Expr)
  | LambdaExpr (List Token) (Expr)
  | TryExpr (Token) (List ActStmt) (List ActStmt) (List ActStmt)
  | FieldAssignExpr (Expr) (Token) (Expr)
  | ErrExpr (Token)

LetBind = record {
  name : Token,
  value : Expr
}

MatchArm = record {
  pattern : Pat,
  body : Expr
}

RecordFieldExpr = record {
  name : Token,
  value : Expr
}

ActStmt =
  | ActBindStmt (Token) (Expr)
  | ActExprStmt (Expr)

HandleClause = record {
  op-name : Token,
  params : List Token,
  resume-name : Token,
  body : Expr
}

Pat =
  | VarPat (Token)
  | LitPat (Token)
  | CtorPat (Token) (List Pat)
  | WildPat (Token)

TypeExpr =
  | NamedType (Token)
  | FunType (TypeExpr) (TypeExpr)
  | AppType (TypeExpr) (List TypeExpr)
  | ParenType (TypeExpr)
  | ListType (TypeExpr)
  | LinearTypeExpr (TypeExpr)
  | EffectTypeExpr (List Token) (List Token) (TypeExpr)
  | BoundedIntType (TypeExpr) (Integer) (Integer) (OverflowMode)
  | PropEqType (TypeExpr) (TypeExpr) (SourceSpan)
  | ConstrainedType (TypeExpr) (TypeExpr)

TypeAnn = record {
  name : Token,
  type-expr : TypeExpr
}

Def = record {
  name : Token,
  params : List Token,
  ann : List TypeAnn,
  body : Expr,
  chapter-slug : Text
}

RecordFieldDef = record {
  name : Token,
  type-expr : TypeExpr
}

VariantCtorDef = record {
  name : Token,
  fields : List TypeExpr
}

EffectOpDef = record {
  name : Token,
  type-expr : TypeExpr
}

EffectDef = record {
  name : Token,
  ops : List EffectOpDef
}

ClassDef = record {
  name : Token,
  methods : List EffectOpDef
}

InstanceMethodDef = record {
  name : Token,
  params : List Token,
  body : Expr
}

InstanceDef = record {
  class-name : Token,
  type-name : Token,
  methods : List InstanceMethodDef
}

TypeBody =
  | RecordBody (List RecordFieldDef)
  | VariantBody (List VariantCtorDef)

TypeDef = record {
  name : Token,
  type-params : List Token,
  body : TypeBody,
  is-mutable : Boolean
}

ProseTransition =
  | PtNone
  | PtWeSay
  | PtThisIsWritten

ProseTemplate =
  | PtNoTemplate
  | PtRecordTemplate (Text)
  | PtVariantTemplate (Text)
  | PtFunctionTemplate (Text)
  | PtConstraintTemplate
  | PtProofTemplate
  | PtProcedureTemplate
  | PtQuantifiedTemplate

ProseBlock = record {
  text : Text,
  transition : ProseTransition,
  template : ProseTemplate
}

AnnotationNode = record {
  kind : Text,
  target : Text,
  body : Text
}

CitesDecl = record {
  quire : Token,
  chapter-name : Text,
  selected-names : List Token,
  citing-chapter : Text
}

Document = record {
  defs : List Def,
  type-defs : List TypeDef,
  effect-defs : List EffectDef,
  class-defs : List ClassDef,
  instance-defs : List InstanceDef,
  citations : List CitesDecl,
  chapter-title : Text,
  section-titles : List Text,
  prose : Text,
  prose-blocks : List ProseBlock,
  annotations : List AnnotationNode,
  parse-bag : DiagnosticBag
}

DefHeader = record {
  name : Token,
  params : List Token,
  ann : List TypeAnn,
  body-pos : Integer between 0 and 4294967295,
  chapter-slug : Text
}

ScanDefResult = record {
  maybe-header : Maybe DefHeader,
  state : ParseState
}

ScanResult = record {
  type-defs : List TypeDef,
  effect-defs : List EffectDef,
  class-defs : List ClassDef,
  instance-defs : List InstanceDef,
  def-headers : List DefHeader,
  citations : List CitesDecl,
  chapter-title : Text,
  section-titles : List Text
}

TokenKind =
  | EndOfFile
  | Newline
  | Indent
  | Dedent
  | IntegerLiteral
  | NumberLiteral
  | TextLiteral
  | CharLiteral
  | TrueKeyword
  | FalseKeyword
