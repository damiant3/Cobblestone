  in let st8 = st-append-code st7 (add-rr reg-r11 reg-rsi)
  in let st9 = st-append-code st8 (mov-store-byte reg-r11 reg-rdx 8)
  in let st10 = st-append-code st9 (add-ri reg-rsi 1)
  in let st11 = st-append-code st10 (jmp (last-copy - (st10.code-len + 5)))
  in patch-jcc-at st11 last-done-pos (st11.code-len)

emit-text-split-epilogue : CodegenState -> CodegenState
emit-text-split-epilogue (st) =
  let st0 = st-append-code st (mov-rr reg-rax reg-r15)
  in let st1 = st-append-code st0 (shl-ri reg-rax 3)
  in let st2 = st-append-code st1 (add-rr reg-rax reg-r14)
  in let st3 = st-append-code st2 (mov-store reg-rax reg-rdi 8)
  in let st4 = st-append-code st3 (add-ri reg-r15 1)
  in let st5 = st-append-code st4 (mov-store reg-r14 reg-r15 0)
  in let st6 = st-append-code st5 (mov-rr reg-rax reg-r14)
  in let st7 = st-append-code st6 (pop-r reg-r15)
  in let st8 = st-append-code st7 (pop-r reg-r14)
  in let st9 = st-append-code st8 (pop-r reg-r13)
  in let st10 = st-append-code st9 (pop-r reg-r12)
  in let st11 = st-append-code st10 (pop-r reg-rbx)
  in st-append-code st11 x86-ret

emit-text-split : CodegenState -> CodegenState
emit-text-split (st) =
  let st0 = emit-text-split-prologue st
  in let scan-loop = st0.code-len
  in let head = emit-text-split-scan-head st0
  in let st1 = emit-text-split-emit-seg (head.cg) scan-loop
  in let st2 = emit-text-split-seg-copy st1 scan-loop
  in let st3 = emit-text-split-not-delim st2 (head.p2) scan-loop
  in let st4 = emit-text-split-final-seg st3 (head.p1)
  in let st5 = emit-text-split-final-copy st4
  in emit-text-split-epilogue st5

ir-expr-type : IRExpr -> CodexType
ir-expr-type (e) =
  when e
   is IrIntLit (v) (s) -> int-ty-default
   is IrNumLit (v) (s) -> NumberTy
   is IrTextLit (v) (s) -> TextTy
   is IrBoolLit (v) (s) -> BooleanTy
   is IrCharLit (v) (s) -> CharTy
   is IrName (n) (t) (s) -> t
   is IrBinary (op) (l) (r) (t) (s) -> t
   is IrNegate (x) (s) -> int-ty-default
   is IrIf (c) (th) (el) (t) (s) -> t
   is IrLet (n) (t) (v) (b) (s) -> ir-expr-type b
   is IrApply (f) (a) (t) (s) -> t
   is IrLambda (ps) (b) (t) (s) -> t
   is IrList (es) (t) (s) -> ListTy t
   is IrMatch (sc) (bs) (t) (s) -> t
   is IrAct (ss) (t) (s) -> t
   is IrHandle (eff) (h) (cs) (t) (s) -> t
   is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> t
   is IrRecord (n) (fs) (t) (s) -> t
   is IrFieldAccess (r) (f) (t) (s) -> t
   is IrFork (body) (t) (s) -> t
   is IrAwait (task) (t) (s) -> t
   is IrTry (max) (body) (fb) (fail) (t) (s) -> t
   is IrFieldStore (r) (f) (v) (t) (s) -> t
   is IrError (m) (t) (s) -> t

set-ir-expr-type : IRExpr, CodexType -> IRExpr
set-ir-expr-type (e) (new-ty) =
  when e
   is IrName (n) (t) (s) -> deck-record (IrName n new-ty s)
   is IrApply (f) (a) (t) (s) -> deck-record (IrApply f a new-ty s)
   is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n new-ty v b s)
   is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf c th el new-ty s)
   is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch sc bs new-ty s)
   is IrAct (ss) (t) (s) -> deck-record (IrAct ss new-ty s)
   is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n fs new-ty s)
   is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess r f new-ty s)
   is otherwise -> e

ir-expr-span : IRExpr -> SourceSpan
ir-expr-span (e) =
  when e
   is IrIntLit (v) (s) -> s
   is IrNumLit (v) (s) -> s
   is IrTextLit (v) (s) -> s
   is IrBoolLit (v) (s) -> s
   is IrCharLit (v) (s) -> s
   is IrName (n) (t) (s) -> s
   is IrBinary (op) (l) (r) (t) (s) -> s
   is IrNegate (x) (s) -> s
   is IrIf (c) (th) (el) (t) (s) -> s
   is IrLet (n) (t) (v) (b) (s) -> s
   is IrApply (f) (a) (t) (s) -> s
   is IrLambda (ps) (b) (t) (s) -> s
   is IrList (es) (t) (s) -> s
   is IrMatch (sc) (bs) (t) (s) -> s
   is IrAct (ss) (t) (s) -> s
   is IrHandle (eff) (h) (cs) (t) (s) -> s
   is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> s
   is IrRecord (n) (fs) (t) (s) -> s
   is IrFieldAccess (r) (f) (t) (s) -> s
   is IrFork (body) (t) (s) -> s
   is IrAwait (task) (t) (s) -> s
   is IrTry (max) (body) (fb) (fail) (t) (s) -> s
   is IrFieldStore (r) (f) (v) (t) (s) -> s
   is IrError (m) (t) (s) -> s

lift-lambdas : IRChapter -> IRChapter
lift-lambdas (chapter) =
  let reserved = collect-reserved-names (chapter.defs) 0 (list-length (chapter.defs)) skip-list-text-empty
  in let ctx0 = LiftCtx {
    reserved = reserved,
    counter = 0,
    lifted = []
   }
  in let res = lift-defs ctx0 (chapter.defs) 0 (list-length (chapter.defs)) []
  in __record-set chapter "defs" (res.defs & res.ctx.lifted)

collect-reserved-names : List IRDef, Integer, Integer, SkipListText -> SkipListText
collect-reserved-names (defs) (i) (len) (acc) =
  if i >= len then acc
  else let d = list-at defs i
  in collect-reserved-names defs (i + 1) len (skip-list-text-insert acc (d.name))

params-to-names : List IRParam, Integer, Integer, SkipListText -> SkipListText
params-to-names (params) (i) (len) (acc) =
  if i >= len then acc
  else let p = list-at params i
  in params-to-names params (i + 1) len (skip-list-text-insert acc (p.name))

lift-defs : LiftCtx, List IRDef, Integer, Integer, List IRDef -> LiftDefsResult
lift-defs (ctx) (defs) (i) (len) (acc) =
  if i >= len then LiftDefsResult {
   ctx = ctx,
   defs = acc
  }
  else let d = list-at defs i
  in let absorbed = absorb-outer-lambdas d
  in let enclosing = params-to-names (absorbed.params) 0 (list-length (absorbed.params)) skip-list-text-empty
  in let body-res = lift-expr ctx enclosing (absorbed.body)
  in let new-def = deck-record (IRDef {
    name = absorbed.name,
    params = absorbed.params,
    type-val = absorbed.type-val,
    body = body-res.expr,
    chapter-slug = absorbed.chapter-slug,
    span = absorbed.span
   })
  in lift-defs (body-res.ctx) defs (i + 1) len (list-push acc new-def)

absorb-outer-lambdas : IRDef -> IRDef
absorb-outer-lambdas (d) =
  when d.body
   is IrLambda (lps) (lbody) (lty) (lsp) -> let extended-params = d.params & lps
   in let merged = deck-record (IRDef {
     name = d.name,
     params = extended-params,
     type-val = d.type-val,
     body = lbody,
     chapter-slug = d.chapter-slug,
     span = d.span
    })
   in absorb-outer-lambdas merged
   is otherwise -> d

lift-expr : LiftCtx, SkipListText, IRExpr -> LiftExprResult
lift-expr (ctx) (enclosing) (e) =
  when e
   is IrIntLit (v) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrNumLit (v) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrTextLit (v) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrBoolLit (v) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrCharLit (v) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrName (n) (t) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrError (m) (t) (s) -> LiftExprResult {
    ctx = ctx,
    expr = e
   }
   is IrLambda (ps) (b) (t) (s) -> lift-one-lambda ctx enclosing ps b t s
   is IrBinary (op) (l) (r) (t) (s) -> let l-res = lift-expr ctx enclosing l
   in let r-res = lift-expr (l-res.ctx) enclosing r
   in LiftExprResult {
    ctx = r-res.ctx,
    expr = deck-record (IrBinary op (l-res.expr) (r-res.expr) t s)
   }
   is IrNegate (x) (s) -> let x-res = lift-expr ctx enclosing x
   in LiftExprResult {
    ctx = x-res.ctx,
    expr = deck-record (IrNegate (x-res.expr) s)
   }
   is IrIf (c) (th) (el) (t) (s) -> let c-res = lift-expr ctx enclosing c
   in let th-res = lift-expr (c-res.ctx) enclosing th
   in let el-res = lift-expr (th-res.ctx) enclosing el
   in LiftExprResult {
    ctx = el-res.ctx,
    expr = deck-record (IrIf (c-res.expr) (th-res.expr) (el-res.expr) t s)
   }
   is IrLet (n) (t) (v) (b) (s) -> let v-res = lift-expr ctx enclosing v
   in let b-enclosing = skip-list-text-insert enclosing n
   in let b-res = lift-expr (v-res.ctx) b-enclosing b
   in LiftExprResult {
    ctx = b-res.ctx,
    expr = deck-record (IrLet n t (v-res.expr) (b-res.expr) s)
   }
   is IrApply (f) (a) (t) (s) -> let f-res = lift-expr ctx enclosing f
   in let a-res = lift-expr (f-res.ctx) enclosing a
   in LiftExprResult {
    ctx = a-res.ctx,
    expr = deck-record (IrApply (f-res.expr) (a-res.expr) t s)
   }
   is IrList (es) (t) (s) -> let es-res = lift-exprs ctx enclosing es 0 (list-length es) []
   in LiftExprResult {
    ctx = es-res.ctx,
    expr = deck-record (IrList (es-res.exprs) t s)
   }
   is IrMatch (sc) (bs) (t) (s) -> let sc-res = lift-expr ctx enclosing sc
   in let bs-res = lift-branches (sc-res.ctx) enclosing bs 0 (list-length bs) []
   in LiftExprResult {
    ctx = bs-res.ctx,
    expr = deck-record (IrMatch (sc-res.expr) (bs-res.branches) t s)
   }
   is IrAct (ss) (t) (s) -> let ss-res = lift-act-stmts ctx enclosing ss 0 (list-length ss) []
   in LiftExprResult {
    ctx = ss-res.ctx,
    expr = deck-record (IrAct (ss-res.stmts) t s)
   }
   is IrRecord (n) (fs) (t) (s) -> let fs-res = lift-fields ctx enclosing fs 0 (list-length fs) []
   in LiftExprResult {
    ctx = fs-res.ctx,
    expr = deck-record (IrRecord n (fs-res.fields) t s)
   }
   is IrFieldAccess (r) (f) (t) (s) -> let r-res = lift-expr ctx enclosing r
   in LiftExprResult {
    ctx = r-res.ctx,
    expr = deck-record (IrFieldAccess (r-res.expr) f t s)
   }
   is IrFieldStore (r) (f) (v) (t) (s) -> let r-res = lift-expr ctx enclosing r
   in let v-res = lift-expr (r-res.ctx) enclosing v
   in LiftExprResult {
    ctx = v-res.ctx,
    expr = deck-record (IrFieldStore (r-res.expr) f (v-res.expr) t s)
   }
   is IrFork (body) (t) (s) -> let b-res = lift-expr ctx enclosing body
   in LiftExprResult {
    ctx = b-res.ctx,
    expr = deck-record (IrFork (b-res.expr) t s)
   }
   is IrAwait (task) (t) (s) -> let t-res = lift-expr ctx enclosing task
   in LiftExprResult {
    ctx = t-res.ctx,
    expr = deck-record (IrAwait (t-res.expr) t s)
   }
   is IrHandle (eff) (h) (cs) (t) (s) -> let h-res = lift-expr ctx enclosing h
   in let clause-enclosing = add-clause-names-to-enclosing cs enclosing
   in let cs-res = lift-handle-clauses (h-res.ctx) clause-enclosing cs 0 (list-length cs) []
   in LiftExprResult {
    ctx = cs-res.ctx,
    expr = deck-record (IrHandle eff (h-res.expr) (cs-res.clauses) t s)
   }
   is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> let b-res = lift-expr ctx enclosing body
   in LiftExprResult {
    ctx = b-res.ctx,
    expr = deck-record (IrWithTimeout secs effs scopes (b-res.expr) t s)
   }
   is IrTry (max) (body) (fb) (fail) (t) (s) -> let body-res = lift-act-stmts ctx enclosing body 0 (list-length body) []
   in let fb-res = lift-act-stmts (body-res.ctx) enclosing fb 0 (list-length fb) []
   in let fail-res = lift-act-stmts (fb-res.ctx) enclosing fail 0 (list-length fail) []
   in LiftExprResult {
    ctx = fail-res.ctx,
    expr = deck-record (IrTry max (body-res.stmts) (fb-res.stmts) (fail-res.stmts) t s)
   }

lift-exprs : LiftCtx, SkipListText, List IRExpr, Integer, Integer, List IRExpr -> LiftExprsResult
lift-exprs (ctx) (enclosing) (es) (i) (len) (acc) =
  if i >= len then LiftExprsResult {
   ctx = ctx,
   exprs = acc
  }
  else let r = lift-expr ctx enclosing (list-at es i)
  in lift-exprs (r.ctx) enclosing es (i + 1) len (list-push acc (r.expr))

lift-branches : LiftCtx, SkipListText, List IRBranch, Integer, Integer, List IRBranch -> LiftBranchesResult
lift-branches (ctx) (enclosing) (bs) (i) (len) (acc) =
  if i >= len then LiftBranchesResult {
   ctx = ctx,
   branches = acc
  }
  else let b = list-at bs i
  in let branch-enclosing = ir--lambdalifting_collect-pattern-names (b.pattern) enclosing
  in let body-res = lift-expr ctx branch-enclosing (b.body)
  in let new-b = deck-record (IRBranch {
    pattern = b.pattern,
    body = body-res.expr,
    span = b.span
   })
  in lift-branches (body-res.ctx) enclosing bs (i + 1) len (list-push acc new-b)

lift-fields : LiftCtx, SkipListText, List IRFieldVal, Integer, Integer, List IRFieldVal -> LiftFieldsResult
lift-fields (ctx) (enclosing) (fs) (i) (len) (acc) =
  if i >= len then LiftFieldsResult {
   ctx = ctx,
   fields = acc
  }
  else let f = list-at fs i
  in let v-res = lift-expr ctx enclosing (f.value)
  in let new-f = deck-record (IRFieldVal {
    name = f.name,
    value = v-res.expr,
    span = f.span
   })
  in lift-fields (v-res.ctx) enclosing fs (i + 1) len (list-push acc new-f)

lift-act-stmts : LiftCtx, SkipListText, List IRActStmt, Integer, Integer, List IRActStmt -> LiftActStmtsResult
lift-act-stmts (ctx) (enclosing) (ss) (i) (len) (acc) =
  if i >= len then LiftActStmtsResult {
   ctx = ctx,
   stmts = acc
  }
  else let s = list-at ss i
  in when s
   is IrDoBind (n) (t) (v) (sp) -> let v-res = lift-expr ctx enclosing v
   in let new-enclosing = skip-list-text-insert enclosing n
   in lift-act-stmts (v-res.ctx) new-enclosing ss (i + 1) len (list-push acc (deck-record (IrDoBind n t (v-res.expr) sp)))
   is IrDoExec (v) (sp) -> let v-res = lift-expr ctx enclosing v
   in lift-act-stmts (v-res.ctx) enclosing ss (i + 1) len (list-push acc (deck-record (IrDoExec (v-res.expr) sp)))

lift-handle-clauses : LiftCtx, SkipListText, List IRHandleClause, Integer, Integer, List IRHandleClause -> LiftClausesResult
lift-handle-clauses (ctx) (enclosing) (cs) (i) (len) (acc) =
  if i >= len then LiftClausesResult {
   ctx = ctx,
   clauses = acc
  }
  else let c = list-at cs i
  in let clause-enc = skip-list-text-insert enclosing (c.resume-name)
  in let body-res = lift-expr ctx clause-enc (c.body)
  in let new-c = deck-record (IRHandleClause {
    op-name = c.op-name,
    params = c.params,
    resume-name = c.resume-name,
    body = body-res.expr,
    span = c.span
   })
  in lift-handle-clauses (body-res.ctx) enclosing cs (i + 1) len (list-push acc new-c)

add-clause-names-to-enclosing : List IRHandleClause, SkipListText -> SkipListText
add-clause-names-to-enclosing (cs) (enc) =
  add-clause-names-loop cs 0 (list-length cs) enc

add-clause-names-loop : List IRHandleClause, Integer, Integer, SkipListText -> SkipListText
add-clause-names-loop (cs) (i) (len) (enc) =
  if i >= len then enc
  else let c = list-at cs i
  in let enc1 = skip-list-text-insert enc (c.op-name)
  in let enc2 = skip-list-text-insert enc1 (c.resume-name)
  in add-clause-names-loop cs (i + 1) len enc2

ir--lambdalifting_collect-pattern-names : IRPat, SkipListText -> SkipListText
ir--lambdalifting_collect-pattern-names (p) (acc) =
  when p
   is IrVarPat (n) (t) (s) -> skip-list-text-insert acc n
   is IrLitPat (v) (t) (s) -> acc
   is IrWildPat (s) -> acc
   is IrCtorPat (n) (subs) (t) (s) -> collect-pattern-name-list subs 0 (list-length subs) acc

collect-pattern-name-list : List IRPat, Integer, Integer, SkipListText -> SkipListText
collect-pattern-name-list (ps) (i) (len) (acc) =
  if i >= len then acc
  else collect-pattern-name-list ps (i + 1) len (ir--lambdalifting_collect-pattern-names (list-at ps i) acc)

lift-one-lambda : LiftCtx, SkipListText, List IRParam, IRExpr, CodexType, SourceSpan -> LiftExprResult
lift-one-lambda (ctx) (enclosing) (ps) (body) (ty) (sp) =
  when body
   is IrLambda (inner-ps) (inner-body) (inner-ty) (inner-sp) -> lift-one-lambda ctx enclosing (ps & inner-ps) inner-body ty sp
   is otherwise -> let body-enclosing = params-to-names ps 0 (list-length ps) enclosing
   in let body-res = lift-expr ctx body-enclosing body
   in let param-names = params-to-names ps 0 (list-length ps) skip-list-text-empty
   in let sorted-free = collect-free-vars (body-res.expr) param-names enclosing []
   in let name-result = gen-unique-name (body-res.ctx) "__lam"
   in let ret-ty = infer-lambda-return-ty ty (list-length ps)
   in let lifted-params = build-lifted-params sorted-free ps
   in let lifted-ty = build-function-ty lifted-params 0 (list-length lifted-params) ret-ty
   in let lifted-def = deck-record (IRDef {
     name = name-result.name,
     params = lifted-params,
     type-val = lifted-ty,
     body = body-res.expr,
     chapter-slug = "",
     span = sp
    })
   in let ctx1 = __record-set (name-result.ctx) "lifted" (list-push (name-result.ctx.lifted) lifted-def)
   in let replacement = build-partial-app (name-result.name) lifted-ty sorted-free 0 (list-length sorted-free) sp
   in LiftExprResult {
    ctx = ctx1,
    expr = replacement
   }

gen-unique-name : LiftCtx, Text -> GenNameResult
gen-unique-name (ctx) (base) =
  gen-unique-name-loop ctx base (ctx.counter)

gen-unique-name-loop : LiftCtx, Text, Integer -> GenNameResult
gen-unique-name-loop (ctx) (base) (i) =
  let candidate = base & "_" & integer-to-text i
  in if skip-list-text-has (ctx.reserved) candidate then gen-unique-name-loop ctx base (i + 1)
     else let ctx1 = __record-set ctx "reserved" (skip-list-text-insert (ctx.reserved) candidate)
  in let ctx2 = __record-set ctx1 "counter" (i + 1)
  in GenNameResult {
   ctx = ctx2,
   name = candidate
  }

build-lifted-params : List FreeVar, List IRParam -> List IRParam
build-lifted-params (captures) (lam-params) =
  let cap-params = free-vars-to-params captures 0 (list-length captures) []
  in cap-params & lam-params

free-vars-to-params : List FreeVar, Integer, Integer, List IRParam -> List IRParam
free-vars-to-params (fvs) (i) (len) (acc) =
  if i >= len then acc
  else let f = list-at fvs i
  in free-vars-to-params fvs (i + 1) len (list-push acc (deck-record (IRParam {
   name = f.name,
   type-val = f.type-val,
   span = synthetic-span
  })))

build-function-ty : List IRParam, Integer, Integer, CodexType -> CodexType
build-function-ty (params) (i) (len) (ret) =
  if i >= len then ret
  else let p = list-at params i
  in FunTy (p.type-val) (build-function-ty params (i + 1) len ret)

infer-lambda-return-ty : CodexType, Integer -> CodexType
infer-lambda-return-ty (ty) (n-params) =
  if n-params == 0 then ty
  else when ty
   is FunTy (pt) (rt) -> infer-lambda-return-ty rt (n-params - 1)
   is otherwise -> ty

build-partial-app : Text, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
build-partial-app (name) (fn-ty) (captures) (i) (len) (sp) =
  build-partial-app-loop (deck-record (IrName name fn-ty sp)) fn-ty captures 0 len sp

build-partial-app-loop : IRExpr, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
build-partial-app-loop (acc) (acc-ty) (captures) (i) (len) (sp) =
  if i >= len then acc
  else let c = list-at captures i
  in let next-ty = when acc-ty
    is FunTy (pt) (rt) -> rt
    is otherwise -> acc-ty
  in let new-acc = deck-record (IrApply acc (deck-record (IrName (c.name) (c.type-val) sp)) next-ty sp)
  in build-partial-app-loop new-acc next-ty captures (i + 1) len sp

collect-free-vars : IRExpr, SkipListText, SkipListText, List FreeVar -> List FreeVar
collect-free-vars (e) (local-bound) (capturable) (acc) =
  when e
   is IrName (n) (t) (s) -> if skip-list-text-has capturable n & skip-list-text-has local-bound n == False & free-var-has acc n == False then let fv-pos = bsearch-freevar-pos acc n 0 (list-length acc)
   in list-insert-at acc fv-pos (FreeVar {
    name = n,
    type-val = t
   })
   else acc
   is IrIntLit (v) (s) -> acc
   is IrNumLit (v) (s) -> acc
   is IrTextLit (v) (s) -> acc
   is IrBoolLit (v) (s) -> acc
   is IrCharLit (v) (s) -> acc
   is IrError (m) (t) (s) -> acc
   is IrLambda (ps) (b) (t) (s) -> let inner-bound = params-to-names ps 0 (list-length ps) local-bound
   in collect-free-vars b inner-bound capturable acc
   is IrApply (f) (a) (t) (s) -> let acc1 = collect-free-vars f local-bound capturable acc
   in collect-free-vars a local-bound capturable acc1
   is IrBinary (op) (l) (r) (t) (s) -> let acc1 = collect-free-vars l local-bound capturable acc
   in collect-free-vars r local-bound capturable acc1
   is IrNegate (x) (s) -> collect-free-vars x local-bound capturable acc
   is IrIf (c) (th) (el) (t) (s) -> let acc1 = collect-free-vars c local-bound capturable acc
   in let acc2 = collect-free-vars th local-bound capturable acc1
   in collect-free-vars el local-bound capturable acc2
   is IrLet (n) (t) (v) (b) (s) -> let acc1 = collect-free-vars v local-bound capturable acc
   in let new-bound = skip-list-text-insert local-bound n
   in collect-free-vars b new-bound capturable acc1
   is IrMatch (sc) (bs) (t) (s) -> let acc1 = collect-free-vars sc local-bound capturable acc
   in collect-free-vars-branches bs local-bound capturable 0 (list-length bs) acc1
   is IrList (es) (t) (s) -> collect-free-vars-list es local-bound capturable 0 (list-length es) acc
   is IrRecord (n) (fs) (t) (s) -> collect-free-vars-fields fs local-bound capturable 0 (list-length fs) acc
   is IrFieldAccess (r) (f) (t) (s) -> collect-free-vars r local-bound capturable acc
   is IrFieldStore (r) (f) (v) (t) (s) -> let acc1 = collect-free-vars r local-bound capturable acc
   in collect-free-vars v local-bound capturable acc1
   is IrAct (ss) (t) (s) -> collect-free-vars-act-stmts ss local-bound capturable 0 (list-length ss) acc
   is IrFork (b) (t) (s) -> collect-free-vars b local-bound capturable acc
   is IrAwait (t2) (t) (s) -> collect-free-vars t2 local-bound capturable acc
   is IrHandle (eff) (h) (cs) (t) (s) -> let acc1 = collect-free-vars h local-bound capturable acc
   in collect-free-vars-clauses cs local-bound capturable acc1 0 (list-length cs)
   is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> collect-free-vars body local-bound capturable acc
   is IrTry (max) (body) (fb) (fail) (t) (s) -> let acc1 = collect-free-vars-act-stmts body local-bound capturable 0 (list-length body) acc
   in let acc2 = collect-free-vars-act-stmts fb local-bound capturable 0 (list-length fb) acc1
   in collect-free-vars-act-stmts fail local-bound capturable 0 (list-length fail) acc2

bsearch-freevar-pos : List FreeVar, Text, Integer, Integer -> Integer
bsearch-freevar-pos (xs) (name) (lo) (hi) =
  if lo >= hi then lo
  else let mid = lo + (hi - lo) / 2
  in if text-compare name ((list-at xs mid).name) <= 0 then bsearch-freevar-pos xs name lo mid
     else bsearch-freevar-pos xs name (mid + 1) hi

free-var-has : List FreeVar, Text -> Boolean
free-var-has (xs) (name) =
  let len = list-length xs
  in let pos = bsearch-freevar-pos xs name 0 len
  in if pos >= len then False
     else (list-at xs pos).name == name

collect-free-vars-list : List IRExpr, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
collect-free-vars-list (es) (local-bound) (capturable) (i) (len) (acc) =
  if i >= len then acc
  else collect-free-vars-list es local-bound capturable (i + 1) len (collect-free-vars (list-at es i) local-bound capturable acc)

collect-free-vars-branches : List IRBranch, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
collect-free-vars-branches (bs) (local-bound) (capturable) (i) (len) (acc) =
  if i >= len then acc
  else let b = list-at bs i
  in let branch-bound = ir--lambdalifting_collect-pattern-names (b.pattern) local-bound
  in let acc1 = collect-free-vars (b.body) branch-bound capturable acc
  in collect-free-vars-branches bs local-bound capturable (i + 1) len acc1

collect-free-vars-fields : List IRFieldVal, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
collect-free-vars-fields (fs) (local-bound) (capturable) (i) (len) (acc) =
  if i >= len then acc
  else let f = list-at fs i
  in collect-free-vars-fields fs local-bound capturable (i + 1) len (collect-free-vars (f.value) local-bound capturable acc)

collect-free-vars-act-stmts : List IRActStmt, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
collect-free-vars-act-stmts (ss) (local-bound) (capturable) (i) (len) (acc) =
  if i >= len then acc
  else let s = list-at ss i
  in when s
   is IrDoBind (n) (t) (v) (sp) -> let acc1 = collect-free-vars v local-bound capturable acc
   in let new-bound = skip-list-text-insert local-bound n
   in collect-free-vars-act-stmts ss new-bound capturable (i + 1) len acc1
   is IrDoExec (v) (sp) -> let acc1 = collect-free-vars v local-bound capturable acc
   in collect-free-vars-act-stmts ss local-bound capturable (i + 1) len acc1

collect-free-vars-clauses : List IRHandleClause, SkipListText, SkipListText, List FreeVar, Integer, Integer -> List FreeVar
collect-free-vars-clauses (cs) (local-bound) (capturable) (acc) (i) (len) =
  if i >= len then acc
  else let c = list-at cs i
  in let clause-bound = skip-list-text-insert local-bound (c.resume-name)
  in let clause-cap = skip-list-text-insert capturable (c.resume-name)
  in let acc1 = collect-free-vars (c.body) clause-bound clause-cap acc
  in collect-free-vars-clauses cs local-bound capturable acc1 (i + 1) len

lower-expr : AExpr, CodexType, LowerCtx -> IRExpr
lower-expr (e) (ty) (ctx) =
  lower-expr-at e ty ctx 0

lower-expr-at : AExpr, CodexType, LowerCtx, Integer -> IRExpr
lower-expr-at (e) (ty) (ctx) (depth) =
  if depth >= max-recursion-depth then deck-record (IrError "lower fuel exhausted" ty (aexpr-span e))
  else when e
   is ALitExpr (text) (kind) (s) -> lower-literal text kind s
   is ANameExpr (name) (s) -> lower-name (name.value) ty ctx s
   is AApplyExpr (f) (a) (s) -> lower-apply f a ty ctx s
   is ABinaryExpr (l) (op) (r) (s) -> let left-ir = lower-expr-at l ty ctx (depth + 1)
   in let left-ty = ir-expr-type left-ir
   in let right-ir = lower-expr-at r ty ctx (depth + 1)
   in deck-record (IrBinary (lower-bin-op op left-ty) left-ir right-ir (binary-result-type op left-ty ty) s)
   is AUnaryExpr (operand) (s) -> let inner = lower-expr-at operand int-ty-default ctx (depth + 1)
   in when inner
    is IrIntLit (v) (ls) -> deck-record (IrIntLit (-(v)) s)
    is otherwise -> deck-record (IrNegate inner s)
   is AIfExpr (c) (t) (e2) (s) -> let resolved = deep-resolve (ctx.ust) ty
   in let then-ir-0 = lower-expr-at t resolved ctx (depth + 1)
   in let then-ty-0 = ir-expr-type then-ir-0
   in let hint-0 = when resolved
     is ErrorTy -> then-ty-0
     is otherwise -> resolved
   in let else-ir = lower-expr-at e2 hint-0 ctx (depth + 1)
   in let else-ty = ir-expr-type else-ir
   in let result-ty = merge-ty hint-0 else-ty
   in let then-ir = if ty-has-error then-ty-0 & ty-has-error result-ty == False then lower-expr-at t result-ty ctx (depth + 1)
    else then-ir-0
   in deck-record (IrIf (lower-expr-at c BooleanTy ctx (depth + 1)) then-ir else-ir result-ty s)
   is ALetExpr (binds) (body) (s) -> lower-let binds body ty ctx s
   is ALambdaExpr (params) (body) (s) -> lower-lambda params body ty ctx s
   is AMatchExpr (scrut) (arms) (s) -> lower-match scrut arms ty ctx s
   is AListExpr (elems) (s) -> lower-list elems ty ctx s
   is ARecordExpr (name) (fields) (s) -> lower-record name fields ty ctx s
   is AFieldAccess (rec) (field) (s) -> let rec-ir = lower-expr-at rec ErrorTy ctx (depth + 1)
   in let rec-ty = deep-resolve (ctx.ust) (ir-expr-type rec-ir)
   in let stripped-rec-ty = when rec-ty
     is EffectfulTy (effs) (sc) (ret) -> deep-resolve (ctx.ust) ret
     is ForAllTy (id) (body) -> deep-resolve (ctx.ust) body
     is otherwise -> rec-ty
   in let resolved-rec-ty = when stripped-rec-ty
     is RecordTy (rn) (ra) (rf) -> stripped-rec-ty
     is ConstructedTy (cname) (cargs) -> let ctor-raw = lookup-type-split (ctx.overlay) (ctx.base) (cname.value)
     in let resolved-record = when ctor-raw
       is ErrorTy -> stripped-rec-ty
       is otherwise -> strip-fun-args (deep-resolve (ctx.ust) ctor-raw)
     in when resolved-record
      is RecordTy (rn) (ra) (rf) -> resolved-record
      is otherwise -> stripped-rec-ty
     is otherwise -> stripped-rec-ty
   in let field-ty = when resolved-rec-ty
     is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (field.value)
     is otherwise -> ty
   in let actual-field-ty = when field-ty
     is ErrorTy -> ty
     is otherwise -> field-ty
   in let fixed-rec = when rec-ty
     is RecordTy (rn) (ra) (rf) -> rec-ir
     is otherwise -> set-ir-expr-type rec-ir resolved-rec-ty
   in deck-record (IrFieldAccess fixed-rec (field.value) actual-field-ty s)
   is AActExpr (stmts) (s) -> lower-act stmts ty ctx s
   is AHandleExpr (eff) (body) (clauses) (s) -> lower-handle eff body clauses ty ctx s
   is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) -> let body-ir = lower-expr body ty ctx
   in deck-record (IrWithTimeout (text-to-integer timeout) (map-list name-value effs) scopes body-ir ty s)
   is ATryExpr (max) (body) (fb) (fail) (s) -> let body-ir = lower-act-stmts-loop body ty ctx 0 (list-length body)
   in let fb-ir = lower-act-stmts-loop fb ty ctx 0 (list-length fb)
   in let fail-ir = lower-act-stmts-loop fail ty ctx 0 (list-length fail)
   in let try-ty = act-block-type body-ir ty
   in deck-record (IrTry max body-ir fb-ir fail-ir try-ty s)
   is AFieldAssignExpr (rec) (field) (val) (s) -> let rec-ir = lower-expr-at rec ErrorTy ctx (depth + 1)
   in let rec-ty = deep-resolve (ctx.ust) (ir-expr-type rec-ir)
   in let val-ir = lower-expr-at val ErrorTy ctx (depth + 1)
   in deck-record (IrFieldStore rec-ir (field.value) val-ir rec-ty s)
   is AErrorExpr (msg) (s) -> deck-record (IrError msg ty s)

lower-name : Text, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-name (name) (ty) (ctx) (sp) =
  let recorded = lookup-expr-type (ctx.ust) sp
  in when recorded
   is ErrorTy -> let raw = lookup-type-split (ctx.overlay) (ctx.base) name
   in when raw
    is ErrorTy -> deck-record (IrName name ty sp)
    is otherwise -> let resolved = deep-resolve (ctx.ust) raw
    in let stripped = strip-forall-ty resolved
    in deck-record (IrName name (prefer-applied-ty ty stripped) sp)
   is otherwise -> let final = deep-resolve (ctx.ust) recorded
   in let stripped = strip-forall-ty final
   in deck-record (IrName name stripped sp)

ir--lowering_peel-effectful-ty : CodexType -> CodexType
ir--lowering_peel-effectful-ty (ty) =
  when ty
   is EffectfulTy (effs) (sc) (ret) -> ir--lowering_peel-effectful-ty ret
   is otherwise -> ty

ty-has-error : CodexType -> Boolean
ty-has-error (t) =
  when t
   is ErrorTy -> True
   is ListTy (e) -> ty-has-error e
   is otherwise -> False

merge-ty : CodexType, CodexType -> CodexType
merge-ty (a) (b) =
  when a
   is ErrorTy -> b
   is ListTy (ea) -> when b
    is ListTy (eb) -> ListTy (merge-ty ea eb)
    is otherwise -> a
   is otherwise -> a

prefer-applied-ty : CodexType, CodexType -> CodexType
prefer-applied-ty (expected) (stripped) =
  let peeled = ir--lowering_peel-effectful-ty expected
  in when peeled
   is ConstructedTy (en) (eargs) -> if list-length eargs == 0 then stripped
   else when stripped
    is SumTy (sn) (sa) (sc) -> if en.value == sn.value then peeled
    else stripped
    is RecordTy (rn) (ra) (rf) -> if en.value == rn.value then peeled
    else stripped
    is ConstructedTy (cn) (cargs) -> if en.value == cn.value & list-length cargs == list-length eargs then peeled
    else stripped
    is otherwise -> stripped
   is otherwise -> stripped

lower-literal : Text, LiteralKind, SourceSpan -> IRExpr
lower-literal (text) (kind) (sp) =
  when kind
   is IntLit -> deck-record (IrIntLit (text-to-integer text) sp)
   is NumLit -> deck-record (IrNumLit (text-to-double-bits text) sp)
   is TextLit -> deck-record (IrTextLit text sp)
   is CharLit -> deck-record (IrCharLit (text-to-integer text) sp)
   is BoolLit -> deck-record (IrBoolLit (text == "True") sp)

lower-apply : AExpr, AExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-apply (f) (a) (ty) (ctx) (sp) =
  let func-ir = lower-expr f ErrorTy ctx
  in let func-ty = deep-resolve (ctx.ust) (ir-expr-type func-ir)
  in let arg-ty = peel-fun-param func-ty
  in let ret-ty = peel-fun-return func-ty
  in let arg-ir = lower-expr a arg-ty ctx
  in let resolved-ret = subst-type-vars-from-arg arg-ty (ir-expr-type arg-ir) ret-ty
  in let actual-ret = when resolved-ret
    is ErrorTy -> ty
    is otherwise -> resolved-ret
  in let preferred-ret = prefer-applied-ty ty actual-ret
  in lower-apply-dispatch func-ir arg-ir preferred-ret sp

lower-apply-dispatch : IRExpr, IRExpr, CodexType, SourceSpan -> IRExpr
lower-apply-dispatch (func-ir) (arg-ir) (ret-ty) (sp) =
  when func-ir
   is IrName (n) (fty) (ns) -> if n == "fork" then deck-record (IrFork arg-ir ret-ty sp)
   else if n == "await" then deck-record (IrAwait arg-ir ret-ty sp)
   else deck-record (IrApply func-ir arg-ir ret-ty sp)
   is otherwise -> deck-record (IrApply func-ir arg-ir ret-ty sp)

lower-let : List ALetBind, AExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-let (binds) (body) (ty) (ctx) (sp) =
  if list-length binds == 0 then lower-expr body ty ctx
  else let b = list-at binds 0
  in let val-ir = lower-expr (b.value) ErrorTy ctx
  in let val-ty = deep-resolve (ctx.ust) (ir-expr-type val-ir)
  in let ctx2 = LowerCtx {
    overlay = OverlayCons (TypeBinding {
     name = b.name.value,
     bound-type = val-ty
    }) (ctx.overlay),
    base = ctx.base,
    ust = ctx.ust,
    local-type-vars = ctx.local-type-vars
   }
  in deck-record (IrLet (b.name.value) val-ty val-ir (lower-let-rest binds body ty ctx2 1 sp) sp)

lower-let-rest : List ALetBind, AExpr, CodexType, LowerCtx, Integer, SourceSpan -> IRExpr
lower-let-rest (binds) (body) (ty) (ctx) (i) (sp) =
  if i == list-length binds then lower-expr body ty ctx
  else let b = list-at binds i
  in let val-ir = lower-expr (b.value) ErrorTy ctx
  in let val-ty = deep-resolve (ctx.ust) (ir-expr-type val-ir)
  in let ctx2 = LowerCtx {
    overlay = OverlayCons (TypeBinding {
     name = b.name.value,
     bound-type = val-ty
    }) (ctx.overlay),
    base = ctx.base,
    ust = ctx.ust,
    local-type-vars = ctx.local-type-vars
   }
  in deck-record (IrLet (b.name.value) val-ty val-ir (lower-let-rest binds body ty ctx2 (i + 1) sp) sp)

lower-lambda : List Name, AExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-lambda (params) (body) (ty) (ctx) (sp) =
  let stripped = strip-forall-ty ty
  in let lparams = lower-lambda-params params stripped 0 sp
  in let lctx = bind-lambda-to-ctx ctx params stripped 0
  in deck-record (IrLambda lparams (lower-expr body (get-lambda-return stripped (list-length params)) lctx) ty sp)

bind-lambda-to-ctx : LowerCtx, List Name, CodexType, Integer -> LowerCtx
bind-lambda-to-ctx (ctx) (params) (ty) (i) =
  if i == list-length params then ctx
  else let p = list-at params i
  in let param-ty = peel-fun-param ty
  in let rest-ty = peel-fun-return ty
  in let ctx2 = LowerCtx {
    overlay = OverlayCons (TypeBinding {
     name = p.value,
     bound-type = param-ty
    }) (ctx.overlay),
    base = ctx.base,
    ust = ctx.ust,
    local-type-vars = ctx.local-type-vars
   }
  in bind-lambda-to-ctx ctx2 params rest-ty (i + 1)

lower-lambda-params : List Name, CodexType, Integer, SourceSpan -> List IRParam
lower-lambda-params (params) (ty) (i) (sp) =
  lower-lambda-params-acc params ty i sp []

lower-lambda-params-acc : List Name, CodexType, Integer, SourceSpan, List IRParam -> List IRParam
lower-lambda-params-acc (params) (ty) (i) (sp) (acc) =
  if i == list-length params then acc
  else let p = list-at params i
  in let param-ty = peel-fun-param ty
  in let rest-ty = peel-fun-return ty
  in lower-lambda-params-acc params rest-ty (i + 1) sp (list-push acc (deck-record (IRParam {
   name = p.value,
   type-val = param-ty,
   span = sp
  })))

get-lambda-return : CodexType, Integer -> CodexType
get-lambda-return (ty) (n) =
  if n == 0 then ty
  else when ty
   is FunTy (p) (r) -> get-lambda-return r (n - 1)
   is otherwise -> ErrorTy

lower-match : AExpr, List AMatchArm, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-match (scrut) (arms) (ty) (ctx) (sp) =
  let scrut-ir = lower-expr scrut ErrorTy ctx
  in let scrut-ty = ir-expr-type scrut-ir
  in let branches = lower-match-arms-loop arms ty scrut-ty ctx 0 (list-length arms)
  in let result-ty = when ty
    is ErrorTy -> infer-match-type branches 0 (list-length branches)
    is otherwise -> ty
  in deck-record (IrMatch scrut-ir branches result-ty sp)

infer-match-type : List IRBranch, Integer, Integer -> CodexType
infer-match-type (branches) (i) (len) =
  if i == len then ErrorTy
  else let b = list-at branches i
  in let body-ty = ir-expr-type (b.body)
  in when body-ty
   is ErrorTy -> infer-match-type branches (i + 1) len
   is otherwise -> body-ty

lower-match-arms-loop : List AMatchArm, CodexType, CodexType, LowerCtx, Integer, Integer -> List IRBranch
lower-match-arms-loop (arms) (ty) (scrut-ty) (ctx) (i) (len) =
  lower-match-arms-acc arms ty scrut-ty ctx i len []

lower-match-arms-acc : List AMatchArm, CodexType, CodexType, LowerCtx, Integer, Integer, List IRBranch -> List IRBranch
lower-match-arms-acc (arms) (ty) (scrut-ty) (ctx) (i) (len) (acc) =
  if i == len then acc
  else let arm = list-at arms i
  in let arm-ctx = bind-pattern-to-ctx ctx (arm.pattern) scrut-ty
  in lower-match-arms-acc arms ty scrut-ty ctx (i + 1) len (list-push acc (deck-record (IRBranch {
   pattern = lower-pattern (arm.pattern) scrut-ty,
   body = lower-expr (arm.body) ty arm-ctx,
   span = arm.span
  })))

bind-pattern-to-ctx : LowerCtx, APat, CodexType -> LowerCtx
bind-pattern-to-ctx (ctx) (pat) (ty) =
  when pat
   is AVarPat (name) (s) -> LowerCtx {
    overlay = OverlayCons (TypeBinding {
     name = name.value,
     bound-type = ty
    }) (ctx.overlay),
    base = ctx.base,
    ust = ctx.ust,
    local-type-vars = ctx.local-type-vars
   }
   is ACtorPat (ctor-name) (sub-pats) (s) -> let ctor-raw = lookup-type-split (ctx.overlay) (ctx.base) (ctor-name.value)
   in let ctor-ty = deep-resolve (ctx.ust) ctor-raw
   in let ctor-stripped = strip-forall-ty ctor-ty
   in let subst = pattern-type-subst ctor-stripped ty
   in let ctor-substituted = apply-ctor-subst subst ctor-stripped
   in bind-ctor-pattern-fields ctx sub-pats ctor-substituted 0 (list-length sub-pats)
   is AWildPat (s) -> ctx
   is ALitPat (text) (kind) (s) -> ctx

bind-ctor-pattern-fields : LowerCtx, List APat, CodexType, Integer, Integer -> LowerCtx
bind-ctor-pattern-fields (ctx) (sub-pats) (ctor-ty) (i) (len) =
  if i == len then ctx
  else when ctor-ty
   is FunTy (param-ty) (ret-ty) -> let ctx2 = bind-pattern-to-ctx ctx (list-at sub-pats i) param-ty
   in bind-ctor-pattern-fields ctx2 sub-pats ret-ty (i + 1) len
   is otherwise -> let ctx2 = bind-pattern-to-ctx ctx (list-at sub-pats i) ErrorTy
   in bind-ctor-pattern-fields ctx2 sub-pats ctor-ty (i + 1) len

lower-pattern : APat, CodexType -> IRPat
lower-pattern (p) (scrut-ty) =
  lower-pattern-at p scrut-ty 0

lower-pattern-at : APat, CodexType, Integer -> IRPat
lower-pattern-at (p) (scrut-ty) (depth) =
  if depth >= max-recursion-depth then deck-record (IrWildPat (apat-span p))
  else when p
   is AVarPat (name) (s) -> deck-record (IrVarPat (name.value) scrut-ty s)
   is ALitPat (text) (kind) (s) -> deck-record (IrLitPat text scrut-ty s)
   is ACtorPat (name) (subs) (s) -> deck-record (IrCtorPat (name.value) (lower-ctor-sub-patterns subs scrut-ty (name.value) 0 (depth + 1)) scrut-ty s)
   is AWildPat (s) -> deck-record (IrWildPat s)

lower-ctor-sub-patterns : List APat, CodexType, Text, Integer, Integer -> List IRPat
lower-ctor-sub-patterns (subs) (scrut-ty) (ctor-name) (i) (depth) =
  lower-ctor-sub-patterns-acc subs scrut-ty ctor-name i (list-length subs) depth []

lower-ctor-sub-patterns-acc : List APat, CodexType, Text, Integer, Integer, Integer, List IRPat -> List IRPat
lower-ctor-sub-patterns-acc (subs) (scrut-ty) (ctor-name) (i) (len) (depth) (acc) =
  if i == len then acc
  else let field-ty = lookup-ctor-field-type scrut-ty ctor-name i
  in lower-ctor-sub-patterns-acc subs scrut-ty ctor-name (i + 1) len depth (list-push acc (lower-pattern-at (list-at subs i) field-ty depth))

lookup-ctor-field-type : CodexType, Text, Integer -> CodexType
lookup-ctor-field-type (ty) (ctor-name) (field-idx) =
  when ty
   is SumTy (sname) (args) (ctors) -> find-ctor-field-type ctors ctor-name field-idx 0
   is otherwise -> ErrorTy

find-ctor-field-type : List SumCtor, Text, Integer, Integer -> CodexType
find-ctor-field-type (ctors) (ctor-name) (field-idx) (i) =
  if i == list-length ctors then ErrorTy
  else let c = list-at ctors i
  in if c.name.value == ctor-name then if field-idx < list-length (c.fields) then list-at (c.fields) field-idx
  else ErrorTy
     else find-ctor-field-type ctors ctor-name field-idx (i + 1)

pattern-type-subst : CodexType, CodexType -> List TypeBinding
pattern-type-subst (ctor-ty) (scrut-ty) =
  let ret-ty = strip-fun-args ctor-ty
  in let scrut-args = extract-scrut-args scrut-ty
  in if list-length scrut-args == 0 then []
     else when ret-ty
   is SumTy (sname) (args) (sum-ctors) -> let param-names = collect-sum-type-params sum-ctors 0 (list-length sum-ctors) []
   in pair-names-with-args param-names scrut-args 0 []
   is ConstructedTy (nr) (args-r) -> pair-positional-subst args-r scrut-args 0 (list-length args-r) []
   is otherwise -> []

extract-scrut-args : CodexType -> List CodexType
extract-scrut-args (ty) =
  when ty
   is ConstructedTy (n) (args) -> args
   is EffectfulTy (effs) (sc) (ret) -> extract-scrut-args ret
   is ForAllTy (id) (body) -> extract-scrut-args body
   is otherwise -> []

collect-sum-type-params : List SumCtor, Integer, Integer, List Text -> List Text
collect-sum-type-params (ctors) (i) (len) (acc) =
  if i == len then acc
  else let c = list-at ctors i
  in collect-sum-type-params ctors (i + 1) len (collect-type-param-names-in-types (c.fields) 0 (list-length (c.fields)) acc)

collect-type-param-names-in-types : List CodexType, Integer, Integer, List Text -> List Text
collect-type-param-names-in-types (tys) (i) (len) (acc) =
  if i == len then acc
  else collect-type-param-names-in-types tys (i + 1) len (collect-type-param-names-in-type (list-at tys i) acc)

collect-type-param-names-in-type : CodexType, List Text -> List Text
collect-type-param-names-in-type (ty) (acc) =
  when ty
   is ConstructedTy (name) (args) -> if list-length args == 0 then if is-type-param-name (name.value) & list-contains-text acc (name.value) == False then list-push acc (name.value)
   else acc
   else collect-type-param-names-in-types args 0 (list-length args) acc
   is FunTy (p) (r) -> collect-type-param-names-in-type r (collect-type-param-names-in-type p acc)
   is ListTy (e) -> collect-type-param-names-in-type e acc
   is LinkedListTy (e) -> collect-type-param-names-in-type e acc
   is otherwise -> acc

is-type-param-name : Text -> Boolean
is-type-param-name (name) =
  if text-length name == 0 then False
  else let code = char-code (char-at name 0)
  in code >= char-code 'e' & code <= char-code 'z'

list-contains-text : List Text, Text -> Boolean
list-contains-text (xs) (target) =
  list-contains-text-loop xs target 0 (list-length xs)

list-contains-text-loop : List Text, Text, Integer, Integer -> Boolean
list-contains-text-loop (xs) (target) (i) (len) =
  if i == len then False
  else if list-at xs i == target then True
  else list-contains-text-loop xs target (i + 1) len

pair-names-with-args : List Text, List CodexType, Integer, List TypeBinding -> List TypeBinding
pair-names-with-args (names) (args) (i) (acc) =
  if i == list-length names then acc
  else if i >= list-length args then acc
  else pair-names-with-args names args (i + 1) (list-push acc (TypeBinding {
   name = list-at names i,
   bound-type = list-at args i
  }))

pair-positional-subst : List CodexType, List CodexType, Integer, Integer, List TypeBinding -> List TypeBinding
pair-positional-subst (args-r) (args-s) (i) (len) (acc) =
  if i == len then acc
  else if i >= list-length args-s then acc
  else let r = list-at args-r i
  in let s = list-at args-s i
  in when r
   is ConstructedTy (name) (sub-args) -> if list-length sub-args == 0 then pair-positional-subst args-r args-s (i + 1) len (list-push acc (TypeBinding {
    name = name.value,
    bound-type = s
   }))
   else pair-positional-subst args-r args-s (i + 1) len acc
   is otherwise -> pair-positional-subst args-r args-s (i + 1) len acc

apply-ctor-subst : List TypeBinding, CodexType -> CodexType
apply-ctor-subst (subst) (ty) =
  if list-length subst == 0 then ty
  else when ty
   is ConstructedTy (name) (args) -> if list-length args == 0 then lookup-subst subst (name.value) ty
   else ConstructedTy name (apply-ctor-subst-list subst args 0 (list-length args) [])
   is FunTy (p) (r) -> FunTy (apply-ctor-subst subst p) (apply-ctor-subst subst r)
   is ListTy (e) -> ListTy (apply-ctor-subst subst e)
   is LinkedListTy (e) -> LinkedListTy (apply-ctor-subst subst e)
   is EffectfulTy (effs) (sc) (r) -> EffectfulTy effs sc (apply-ctor-subst subst r)
   is otherwise -> ty

apply-ctor-subst-list : List TypeBinding, List CodexType, Integer, Integer, List CodexType -> List CodexType
apply-ctor-subst-list (subst) (args) (i) (len) (acc) =
  if i == len then acc
  else apply-ctor-subst-list subst args (i + 1) len (list-push acc (apply-ctor-subst subst (list-at args i)))

lookup-subst : List TypeBinding, Text, CodexType -> CodexType
lookup-subst (subst) (name) (default-ty) =
  lookup-subst-loop subst name 0 (list-length subst) default-ty

lookup-subst-loop : List TypeBinding, Text, Integer, Integer, CodexType -> CodexType
lookup-subst-loop (subst) (name) (i) (len) (default-ty) =
  if i == len then default-ty
  else let b = list-at subst i
  in if b.name == name then b.bound-type
     else lookup-subst-loop subst name (i + 1) len default-ty

lower-list : List AExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-list (elems) (ty) (ctx) (sp) =
  if list-length elems == 0 then lower-empty-list ty ctx sp
  else lower-nonempty-list elems ty ctx sp

lower-empty-list : CodexType, LowerCtx, SourceSpan -> IRExpr
lower-empty-list (ty) (ctx) (sp) =
  let resolved = deep-resolve (ctx.ust) ty
  in when resolved
   is LinkedListTy (e) -> let ll-ty = deck-record (LinkedListTy e)
   in deck-record (IrApply (deck-record (IrName "__linked-list-empty" (deck-record (FunTy int-ty-default ll-ty)) sp)) (deck-record (IrIntLit 0 sp)) ll-ty sp)
   is ListTy (e) -> deck-record (IrList [] e sp)
   is otherwise -> deck-record (IrList [] ErrorTy sp)

lower-nonempty-list : List AExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-nonempty-list (elems) (ty) (ctx) (sp) =
  let resolved = deep-resolve (ctx.ust) ty
  in let from-context = when resolved
    is ListTy (e) -> e
    is otherwise -> ErrorTy
  in let elem-ty = when from-context
    is ErrorTy -> ir-expr-type (lower-expr (list-at elems 0) ErrorTy ctx)
    is otherwise -> from-context
  in deck-record (IrList (lower-list-elems-loop elems elem-ty ctx 0 (list-length elems)) elem-ty sp)

lower-list-elems-loop : List AExpr, CodexType, LowerCtx, Integer, Integer -> List IRExpr
lower-list-elems-loop (elems) (elem-ty) (ctx) (i) (len) =
  lower-list-elems-acc elems elem-ty ctx i len []

lower-list-elems-acc : List AExpr, CodexType, LowerCtx, Integer, Integer, List IRExpr -> List IRExpr
lower-list-elems-acc (elems) (elem-ty) (ctx) (i) (len) (acc) =
  if i == len then acc
  else lower-list-elems-acc elems elem-ty ctx (i + 1) len (list-push acc (lower-expr (list-at elems i) elem-ty ctx))

lower-record : Name, List AFieldExpr, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-record (name) (fields) (ty) (ctx) (sp) =
  let ctor-raw = lookup-type-split (ctx.overlay) (ctx.base) (name.value)
  in let record-ty = when ctor-raw
    is ErrorTy -> ty
    is otherwise -> strip-fun-args (deep-resolve (ctx.ust) ctor-raw)
  in let actual-ty = when record-ty
    is ErrorTy -> ty
    is otherwise -> record-ty
  in let lowered-fields = lower-record-fields-typed fields actual-ty ctx 0 (list-length fields)
  in let refined-actual = refine-record-ty-from-fields actual-ty lowered-fields ctx 0 (list-length lowered-fields)
  in let emit-ty = prefer-applied-record-ty ty refined-actual (ctx.local-type-vars)
  in deck-record (IrRecord (name.value) lowered-fields emit-ty sp)

refine-record-ty-from-fields : CodexType, List IRFieldVal, LowerCtx, Integer, Integer -> CodexType
refine-record-ty-from-fields (ty) (lowered) (ctx) (i) (len) =
  if i == len then ty
  else when ty
   is RecordTy (rn) (rargs) (rfields) -> let f = list-at lowered i
   in let declared = lookup-record-field rfields (f.name)
   in let actual = deep-resolve (ctx.ust) (ir-expr-type (f.value))
   in let ty2 = subst-type-vars-from-arg declared actual ty
   in refine-record-ty-from-fields ty2 lowered ctx (i + 1) len
   is otherwise -> ty

prefer-applied-record-ty : CodexType, CodexType, List Integer -> CodexType
prefer-applied-record-ty (expected) (fallback) (local-ids) =
  let peeled = ir--lowering_peel-effectful-ty expected
  in when peeled
   is ConstructedTy (en) (eargs) -> if list-length eargs == 0 then fallback
   else when fallback
    is RecordTy (fn) (fa) (ff) -> if en.value == fn.value & list-length eargs == list-length fa then RecordTy fn (pick-record-args eargs fa local-ids 0 (list-length eargs) []) ff
    else fallback
    is otherwise -> fallback
   is RecordTy (en) (eargs) (efields) -> if list-length eargs == 0 then fallback
   else when fallback
    is RecordTy (fn) (fa) (ff) -> if en.value == fn.value & list-length eargs == list-length fa then RecordTy fn (pick-record-args eargs fa local-ids 0 (list-length eargs) []) ff
    else peeled
    is otherwise -> peeled
   is otherwise -> fallback

pick-record-args : List CodexType, List CodexType, List Integer, Integer, Integer, List CodexType -> List CodexType
pick-record-args (eargs) (fargs) (local-ids) (i) (len) (acc) =
  if i == len then acc
  else let ea = list-at eargs i
  in let fa = list-at fargs i
  in let picked = when ea
    is TypeVar (id) -> if list-contains-int local-ids id then ea
    else fa
    is otherwise -> ea
  in pick-record-args eargs fargs local-ids (i + 1) len (list-push acc picked)

list-contains-int : List Integer, Integer -> Boolean
list-contains-int (xs) (target) =
  list-contains-int-loop xs target 0 (list-length xs)

list-contains-int-loop : List Integer, Integer, Integer, Integer -> Boolean
list-contains-int-loop (xs) (target) (i) (len) =
  if i == len then False
  else if list-at xs i == target then True
  else list-contains-int-loop xs target (i + 1) len

lower-record-fields-typed : List AFieldExpr, CodexType, LowerCtx, Integer, Integer -> List IRFieldVal
lower-record-fields-typed (fields) (record-ty) (ctx) (i) (len) =
  lower-record-fields-acc fields record-ty ctx i len []

lower-record-fields-acc : List AFieldExpr, CodexType, LowerCtx, Integer, Integer, List IRFieldVal -> List IRFieldVal
lower-record-fields-acc (fields) (record-ty) (ctx) (i) (len) (acc) =
  if i == len then acc
  else let f = list-at fields i
  in let field-expected = when record-ty
    is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (f.name.value)
    is otherwise -> ErrorTy
  in lower-record-fields-acc fields record-ty ctx (i + 1) len (list-push acc (deck-record (IRFieldVal {
   name = f.name.value,
   value = lower-expr (f.value) field-expected ctx,
   span = f.span
  })))

lower-act : List AActStmt, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-act (stmts) (ty) (ctx) (sp) =
  let lowered = lower-act-stmts-loop stmts ty ctx 0 (list-length stmts)
  in let act-ty = act-block-type lowered ty
  in deck-record (IrAct lowered act-ty sp)

act-block-type : List IRActStmt, CodexType -> CodexType
act-block-type (stmts) (fallback) =
  if list-length stmts == 0 then fallback
  else let last = list-at stmts (list-length stmts - 1)
  in when last
   is IrDoExec (e) (sp) -> ir-expr-type e
   is IrDoBind (nm) (bty) (e) (sp) -> bty

lower-act-stmts-loop : List AActStmt, CodexType, LowerCtx, Integer, Integer -> List IRActStmt
lower-act-stmts-loop (stmts) (ty) (ctx) (i) (len) =
  lower-act-stmts-acc stmts ty ctx i len []

lower-act-stmts-acc : List AActStmt, CodexType, LowerCtx, Integer, Integer, List IRActStmt -> List IRActStmt
lower-act-stmts-acc (stmts) (ty) (ctx) (i) (len) (acc) =
  if i == len then acc
  else let s = list-at stmts i
  in when s
   is AActBindStmt (name) (val) (sp) -> let val-ir = lower-expr val ty ctx
   in let val-ty = ir--lowering_peel-effectful-ty (ir-expr-type val-ir)
   in let ctx2 = LowerCtx {
     overlay = OverlayCons (TypeBinding {
      name = name.value,
      bound-type = val-ty
     }) (ctx.overlay),
     base = ctx.base,
     ust = ctx.ust,
     local-type-vars = ctx.local-type-vars
    }
   in lower-act-stmts-acc stmts ty ctx2 (i + 1) len (list-push acc (deck-record (IrDoBind (name.value) val-ty val-ir sp)))
   is AActExprStmt (e) (sp) -> lower-act-stmts-acc stmts ty ctx (i + 1) len (list-push acc (deck-record (IrDoExec (lower-expr e ty ctx) sp)))

lower-handle : Name, AExpr, List AHandleClause, CodexType, LowerCtx, SourceSpan -> IRExpr
lower-handle (eff) (body) (clauses) (ty) (ctx) (sp) =
  let body-ir = lower-expr body ty ctx
  in deck-record (IrHandle (eff.value) body-ir (lower-handle-clauses clauses ty ctx) ty sp)

lower-handle-clauses : List AHandleClause, CodexType, LowerCtx -> List IRHandleClause
lower-handle-clauses (clauses) (ty) (ctx) =
  lower-handle-clauses-loop clauses ty ctx 0

lower-handle-clauses-loop : List AHandleClause, CodexType, LowerCtx, Integer -> List IRHandleClause
lower-handle-clauses-loop (clauses) (ty) (ctx) (i) =
  lower-handle-clauses-acc clauses ty ctx i []

lower-handle-clauses-acc : List AHandleClause, CodexType, LowerCtx, Integer, List IRHandleClause -> List IRHandleClause
lower-handle-clauses-acc (clauses) (ty) (ctx) (i) (acc) =
  if i == list-length clauses then acc
  else let c = list-at clauses i
  in let body-ir = lower-expr (c.body) ty ctx
  in let param-names = lower-clause-param-names (c.params) 0 (list-length (c.params)) []
  in let wrapped = wrap-clause-body-in-lambda param-names body-ir (c.span)
  in lower-handle-clauses-acc clauses ty ctx (i + 1) (list-push acc (deck-record (IRHandleClause {
   op-name = c.op-name.value,
   params = param-names,
   resume-name = c.resume-name.value,
   body = wrapped,
   span = c.span
  })))

lower-clause-param-names : List Name, Integer, Integer, List Text -> List Text
lower-clause-param-names (ps) (i) (len) (acc) =
  if i >= len then acc
  else lower-clause-param-names ps (i + 1) len (list-push acc ((list-at ps i).value))

wrap-clause-body-in-lambda : List Text, IRExpr, SourceSpan -> IRExpr
wrap-clause-body-in-lambda (params) (body) (sp) =
  if list-length params == 0 then body
  else let ir-params = build-ir-params params 0 (list-length params) [] sp
  in let body-ty = ir-expr-type body
  in let lam-ty = build-lambda-type params body-ty 0
  in deck-record (IrLambda ir-params body lam-ty sp)

build-ir-params : List Text, Integer, Integer, List IRParam, SourceSpan -> List IRParam
build-ir-params (names) (i) (len) (acc) (sp) =
  if i >= len then acc
  else build-ir-params names (i + 1) len (list-push acc (deck-record (IRParam {
   name = list-at names i,
   type-val = int-ty-default,
   span = sp
  }))) sp

build-lambda-type : List Text, CodexType, Integer -> CodexType
build-lambda-type (params) (ret) (i) =
  if i >= list-length params then ret
  else FunTy int-ty-default (build-lambda-type params ret (i + 1))

lower-def : ADef, List TypeBinding, UnificationState -> IRDef
lower-def (d) (types) (ust) =
  let raw-type = lookup-type-bsearch types (d.name.value)
  in let full-type = deep-resolve ust raw-type
  in let stripped = strip-forall-ty full-type
  in let local-ids = collect-type-var-ids stripped []
  in let params = lower-def-params (d.params) stripped 0
  in let ret-type = get-return-type-n stripped (list-length (d.params))
  in let ctx = build-def-ctx types ust (d.params) stripped local-ids
  in deck-record (IRDef {
   name = d.name.value,
   params = params,
   type-val = full-type,
   body = lower-expr (d.body) ret-type ctx,
   chapter-slug = d.chapter-slug,
   span = d.span
  })

collect-type-var-ids : CodexType, List Integer -> List Integer
collect-type-var-ids (ty) (acc) =
  when ty
   is TypeVar (id) -> if list-contains-int acc id then acc
   else list-push acc id
   is otherwise -> codex-type-fold-children collect-type-var-ids ty acc

build-def-ctx : List TypeBinding, UnificationState, List AParam, CodexType, List Integer -> LowerCtx
build-def-ctx (types) (ust) (params) (ty) (local-ids) =
  let base-ctx = LowerCtx {
    overlay = OverlayNil,
    base = types,
    ust = ust,
    local-type-vars = local-ids
   }
  in bind-params-to-ctx base-ctx params ty 0

bind-params-to-ctx : LowerCtx, List AParam, CodexType, Integer -> LowerCtx
bind-params-to-ctx (ctx) (params) (ty) (i) =
  if i == list-length params then ctx
  else let p = list-at params i
  in let param-ty = peel-fun-param ty
  in let rest-ty = peel-fun-return ty
  in let ctx2 = LowerCtx {
    overlay = OverlayCons (TypeBinding {
     name = p.name.value,
     bound-type = param-ty
    }) (ctx.overlay),
    base = ctx.base,
    ust = ctx.ust,
    local-type-vars = ctx.local-type-vars
   }
  in bind-params-to-ctx ctx2 params rest-ty (i + 1)

lower-def-params : List AParam, CodexType, Integer -> List IRParam
lower-def-params (params) (ty) (i) =
  lower-def-params-acc params ty i []

lower-def-params-acc : List AParam, CodexType, Integer, List IRParam -> List IRParam
lower-def-params-acc (params) (ty) (i) (acc) =
  if i == list-length params then acc
  else let p = list-at params i
  in let param-ty = peel-fun-param ty
  in let rest-ty = peel-fun-return ty
  in lower-def-params-acc params rest-ty (i + 1) (list-push acc (deck-record (IRParam {
   name = p.name.value,
   type-val = param-ty,
   span = p.span
  })))

get-return-type-n : CodexType, Integer -> CodexType
get-return-type-n (ty) (n) =
  if n == 0 then ty
  else when ty
   is FunTy (p) (r) -> get-return-type-n r (n - 1)
   is otherwise -> ty

lower-chapter : AChapter, List TypeBinding, TypeEnv, UnificationState, List Text -> IRChapter
lower-chapter (m) (types) (env) (ust) (ctor-names) =
  let all-types = sort-bindings (types & env.bindings)
  in let sorted-ust = __record-set ust "expr-types" (sort-expr-types (ust.expr-types))
  in deck-record (IRChapter {
   name = m.name,
   defs = lower-defs (m.defs) all-types sorted-ust 0,
   effect-op-names = ir--lowering_collect-effect-op-names (m.effect-defs) 0 (list-length (m.effect-defs)) [],
   span = m.span
  })

ir--lowering_collect-effect-op-names : List AEffectDef, Integer, Integer, List Text -> List Text
ir--lowering_collect-effect-op-names (effs) (i) (len) (acc) =
  if i >= len then acc
  else let e = list-at effs i
  in ir--lowering_collect-effect-op-names effs (i + 1) len (collect-ops-from-def (e.ops) 0 (list-length (e.ops)) acc)

collect-ops-from-def : List AEffectOpDef, Integer, Integer, List Text -> List Text
collect-ops-from-def (ops) (i) (len) (acc) =
  if i >= len then acc
  else collect-ops-from-def ops (i + 1) len (list-push acc ((list-at ops i).name.value))

lower-defs : List ADef, List TypeBinding, UnificationState, Integer -> List IRDef
lower-defs (defs) (types) (ust) (i) =
  lower-defs-acc defs types ust i []

lower-defs-acc : List ADef, List TypeBinding, UnificationState, Integer, List IRDef -> List IRDef
lower-defs-acc (defs) (types) (ust) (i) (acc) =
  if i == list-length defs then acc
  else lower-defs-acc defs types ust (i + 1) (list-push acc (lower-def (list-at defs i) types ust))

lookup-overlay : LookupOverlay, Text -> CodexType
lookup-overlay (ovl) (name) =
  when ovl
   is OverlayNil -> ErrorTy
   is OverlayCons (b) (rest) -> if b.name == name then b.bound-type
   else lookup-overlay rest name

lookup-type : List TypeBinding, Text -> CodexType
lookup-type (bindings) (name) =
  lookup-type-loop bindings name 0 (list-length bindings)

lookup-type-loop : List TypeBinding, Text, Integer, Integer -> CodexType
lookup-type-loop (bindings) (name) (i) (len) =
  if i == len then ErrorTy
  else let b = list-at bindings i
  in if b.name == name then b.bound-type
     else lookup-type-loop bindings name (i + 1) len

lookup-type-bsearch : List TypeBinding, Text -> CodexType
lookup-type-bsearch (bindings) (name) =
  let len = list-length bindings
  in if len == 0 then ErrorTy
     else let pos = bsearch-text-pos bindings name 0 len
  in if pos >= len then ErrorTy
     else let b = list-at bindings pos
  in if b.name == name then b.bound-type
     else ErrorTy

lookup-type-split : LookupOverlay, List TypeBinding, Text -> CodexType
lookup-type-split (overlay) (base) (name) =
  let overlay-hit = lookup-overlay overlay name
  in when overlay-hit
   is ErrorTy -> lookup-type-bsearch base name
   is otherwise -> overlay-hit

compare-binding-names : TypeBinding, TypeBinding -> Integer
compare-binding-names (a) (b) =
  text-compare (a.name) (b.name)

sort-bindings : List TypeBinding -> List TypeBinding
sort-bindings (xs) =
  sort-by xs compare-binding-names

subst-type-vars-from-arg : CodexType, CodexType, CodexType -> CodexType
subst-type-vars-from-arg (param-ty) (arg-ty) (target) =
  when param-ty
   is TypeVar (id) -> subst-type-var-in-target target id arg-ty
   is ListTy (pe) -> subst-from-list pe arg-ty target
   is FunTy (pp) (pr) -> subst-from-fun pp pr arg-ty target
   is otherwise -> target

subst-from-list : CodexType, CodexType, CodexType -> CodexType
subst-from-list (pe) (arg-ty) (target) =
  when arg-ty
   is ListTy (ae) -> subst-type-vars-from-arg pe ae target
   is otherwise -> target

subst-from-fun : CodexType, CodexType, CodexType, CodexType -> CodexType
subst-from-fun (pp) (pr) (arg-ty) (target) =
  when arg-ty
   is FunTy (ap) (ar) -> let t2 = subst-type-vars-from-arg pp ap target
   in subst-type-vars-from-arg pr ar t2
   is otherwise -> target

subst-type-var-in-target : CodexType, Integer, CodexType -> CodexType
subst-type-var-in-target (ty) (var-id) (replacement) =
  if ty-has-typevars ty == False then ty
  else when ty
   is TypeVar (id) -> if id == var-id then replacement
   else ty
   is ForAllTy (fid) (body) -> if fid == var-id then ty
   else ForAllTy fid (subst-type-var-in-target body var-id replacement)
   is otherwise -> codex-type-map-children (\c -> subst-type-var-in-target c var-id replacement) ty

is-text-type : CodexType -> Boolean
is-text-type (ty) =
  when ty
   is TextTy -> True
   is otherwise -> False

is-number-type : CodexType -> Boolean
is-number-type (ty) =
  when ty
   is NumberTy -> True
   is otherwise -> False

is-boolean-type : CodexType -> Boolean
is-boolean-type (ty) =
  when ty
   is BooleanTy -> True
   is otherwise -> False

lower-bin-op : BinaryOp, CodexType -> IRBinaryOp
lower-bin-op (op) (ty) =
  when op
   is OpAdd -> if is-number-type ty then IrAddNum
   else IrAddInt
   is OpSub -> if is-number-type ty then IrSubNum
   else IrSubInt
   is OpMul -> if is-number-type ty then IrMulNum
   else IrMulInt
   is OpDiv -> if is-number-type ty then IrDivNum
   else IrDivInt
   is OpPow -> IrPowInt
   is OpEq -> IrEq
   is OpNotEq -> IrNotEq
   is OpLt -> IrLt
   is OpGt -> IrGt
   is OpLtEq -> IrLtEq
   is OpGtEq -> IrGtEq
   is OpDefEq -> IrEq
   is OpAppend -> if is-text-type ty then IrAppendText
   else IrAppendList
   is OpCons -> IrConsList
   is OpAnd -> if is-text-type ty then IrAppendText
   else if is-boolean-type ty then IrAnd
   else IrAppendList
   is OpOr -> IrOr

binary-result-type : BinaryOp, CodexType, CodexType -> CodexType
binary-result-type (op) (left-ty) (expected-ty) =
  when op
   is OpEq -> BooleanTy
   is OpNotEq -> BooleanTy
   is OpLt -> BooleanTy
   is OpGt -> BooleanTy
   is OpLtEq -> BooleanTy
   is OpGtEq -> BooleanTy
   is OpDefEq -> BooleanTy
   is OpAnd -> if is-boolean-type left-ty then BooleanTy
   else if is-text-type left-ty then TextTy
   else left-ty
   is OpOr -> BooleanTy
   is OpAppend -> if is-text-type left-ty then TextTy
   else if is-text-type expected-ty then TextTy
   else left-ty
   is otherwise -> left-ty

strip-fun-args-resolve : CodexType -> CodexType
strip-fun-args-resolve (ty) =
  when ty
   is FunTy (p) (r) -> strip-fun-args-resolve r
   is otherwise -> ty

resolve-ty-deep : List TypeBinding, CodexType -> CodexType
resolve-ty-deep (tdefs) (ty) =
  when ty
   is ConstructedTy (cname) (cargs) -> if list-length cargs > 0 then deck-record (ConstructedTy cname (resolve-ty-list tdefs cargs 0 (list-length cargs) []))
   else let raw = lookup-type-bsearch tdefs (cname.value)
   in when raw
    is RecordTy (rn) (ra) (rf) -> raw
    is SumTy (sn) (sa) (sc) -> raw
    is FunTy (p) (r) -> strip-fun-args-resolve r
    is otherwise -> deck-record (ConstructedTy cname [])
   is FunTy (p) (r) -> deck-record (FunTy (resolve-ty-deep tdefs p) (resolve-ty-deep tdefs r))
   is ListTy (e) -> deck-record (ListTy (resolve-ty-deep tdefs e))
   is LinkedListTy (e) -> deck-record (LinkedListTy (resolve-ty-deep tdefs e))
   is ForAllTy (id) (body) -> deck-record (ForAllTy id (resolve-ty-deep tdefs body))
   is EffectfulTy (effs) (sc) (ret) -> deck-record (EffectfulTy effs sc (resolve-ty-deep tdefs ret))
   is otherwise -> ty

resolve-ty-list : List TypeBinding, List CodexType, Integer, Integer, List CodexType -> List CodexType
resolve-ty-list (tdefs) (tys) (i) (len) (acc) =
  if i == len then acc
  else resolve-ty-list tdefs tys (i + 1) len (list-push acc (resolve-ty-deep tdefs (list-at tys i)))

rewrite-ir-pat : List TypeBinding, IRPat -> IRPat
rewrite-ir-pat (tdefs) (p) =
  when p
   is IrVarPat (name) (t) (s) -> deck-record (IrVarPat name (resolve-ty-deep tdefs t) s)
   is IrLitPat (v) (t) (s) -> deck-record (IrLitPat v (resolve-ty-deep tdefs t) s)
   is IrCtorPat (name) (subs) (t) (s) -> deck-record (IrCtorPat name (rewrite-ir-pat-list tdefs subs 0 (list-length subs) []) (resolve-ty-deep tdefs t) s)
   is IrWildPat (s) -> p

rewrite-ir-pat-list : List TypeBinding, List IRPat, Integer, Integer, List IRPat -> List IRPat
rewrite-ir-pat-list (tdefs) (ps) (i) (len) (acc) =
  if i == len then acc
  else rewrite-ir-pat-list tdefs ps (i + 1) len (list-push acc (rewrite-ir-pat tdefs (list-at ps i)))

rewrite-ir-expr : List TypeBinding, IRExpr -> IRExpr
rewrite-ir-expr (tdefs) (e) =
  when e
   is IrIntLit (v) (s) -> e
   is IrNumLit (v) (s) -> e
   is IrTextLit (v) (s) -> e
   is IrBoolLit (v) (s) -> e
   is IrCharLit (v) (s) -> e
   is IrName (n) (t) (s) -> deck-record (IrName n (resolve-ty-deep tdefs t) s)
   is IrBinary (op) (l) (r) (t) (s) -> deck-record (IrBinary op (rewrite-ir-expr tdefs l) (rewrite-ir-expr tdefs r) (resolve-ty-deep tdefs t) s)
   is IrNegate (x) (s) -> deck-record (IrNegate (rewrite-ir-expr tdefs x) s)
   is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf (rewrite-ir-expr tdefs c) (rewrite-ir-expr tdefs th) (rewrite-ir-expr tdefs el) (resolve-ty-deep tdefs t) s)
   is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) (rewrite-ir-expr tdefs b) s)
   is IrApply (f) (a) (t) (s) -> deck-record (IrApply (rewrite-ir-expr tdefs f) (rewrite-ir-expr tdefs a) (resolve-ty-deep tdefs t) s)
   is IrLambda (ps) (b) (t) (s) -> deck-record (IrLambda (rewrite-ir-params tdefs ps 0 (list-length ps) []) (rewrite-ir-expr tdefs b) (resolve-ty-deep tdefs t) s)
   is IrList (es) (t) (s) -> deck-record (IrList (rewrite-ir-expr-list tdefs es 0 (list-length es) []) (resolve-ty-deep tdefs t) s)
   is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch (rewrite-ir-expr tdefs sc) (rewrite-ir-branches tdefs bs 0 (list-length bs) []) (resolve-ty-deep tdefs t) s)
   is IrAct (ss) (t) (s) -> deck-record (IrAct (rewrite-ir-act-stmts tdefs ss 0 (list-length ss) []) (resolve-ty-deep tdefs t) s)
   is IrHandle (eff) (h) (cs) (t) (s) -> deck-record (IrHandle eff (rewrite-ir-expr tdefs h) (rewrite-ir-handle-clauses tdefs cs 0 (list-length cs) []) (resolve-ty-deep tdefs t) s)
   is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> deck-record (IrWithTimeout secs effs scopes (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
   is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n (rewrite-ir-record-fields tdefs fs 0 (list-length fs) []) (resolve-ty-deep tdefs t) s)
   is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess (rewrite-ir-expr tdefs r) f (resolve-ty-deep tdefs t) s)
   is IrFieldStore (r) (f) (v) (t) (s) -> deck-record (IrFieldStore (rewrite-ir-expr tdefs r) f (rewrite-ir-expr tdefs v) (resolve-ty-deep tdefs t) s)
   is IrFork (body) (t) (s) -> deck-record (IrFork (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
   is IrAwait (task) (t) (s) -> deck-record (IrAwait (rewrite-ir-expr tdefs task) (resolve-ty-deep tdefs t) s)
   is IrTry (max) (body) (fb) (fail) (t) (s) -> deck-record (IrTry max (rewrite-ir-act-stmts tdefs body 0 (list-length body) []) (rewrite-ir-act-stmts tdefs fb 0 (list-length fb) []) (rewrite-ir-act-stmts tdefs fail 0 (list-length fail) []) (resolve-ty-deep tdefs t) s)
   is IrError (m) (t) (s) -> deck-record (IrError m (resolve-ty-deep tdefs t) s)

rewrite-ir-expr-list : List TypeBinding, List IRExpr, Integer, Integer, List IRExpr -> List IRExpr
rewrite-ir-expr-list (tdefs) (es) (i) (len) (acc) =
  if i == len then acc
  else rewrite-ir-expr-list tdefs es (i + 1) len (list-push acc (rewrite-ir-expr tdefs (list-at es i)))

rewrite-ir-params : List TypeBinding, List IRParam, Integer, Integer, List IRParam -> List IRParam
rewrite-ir-params (tdefs) (ps) (i) (len) (acc) =
  if i == len then acc
  else let p = list-at ps i
  in rewrite-ir-params tdefs ps (i + 1) len (list-push acc (deck-record (IRParam {
   name = p.name,
   type-val = resolve-ty-deep tdefs (p.type-val),
   span = p.span
  })))

rewrite-ir-branches : List TypeBinding, List IRBranch, Integer, Integer, List IRBranch -> List IRBranch
rewrite-ir-branches (tdefs) (bs) (i) (len) (acc) =
  if i == len then acc
  else let b = list-at bs i
  in rewrite-ir-branches tdefs bs (i + 1) len (list-push acc (deck-record (IRBranch {
   pattern = rewrite-ir-pat tdefs (b.pattern),
   body = rewrite-ir-expr tdefs (b.body),
   span = b.span
  })))

rewrite-ir-act-stmts : List TypeBinding, List IRActStmt, Integer, Integer, List IRActStmt -> List IRActStmt
rewrite-ir-act-stmts (tdefs) (ss) (i) (len) (acc) =
  if i == len then acc
  else let s = list-at ss i
  in let ns = when s
    is IrDoBind (n) (t) (v) (sp) -> deck-record (IrDoBind n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) sp)
    is IrDoExec (v) (sp) -> deck-record (IrDoExec (rewrite-ir-expr tdefs v) sp)
  in rewrite-ir-act-stmts tdefs ss (i + 1) len (list-push acc ns)

rewrite-ir-handle-clauses : List TypeBinding, List IRHandleClause, Integer, Integer, List IRHandleClause -> List IRHandleClause
rewrite-ir-handle-clauses (tdefs) (cs) (i) (len) (acc) =
  if i == len then acc
  else let c = list-at cs i
  in rewrite-ir-handle-clauses tdefs cs (i + 1) len (list-push acc (deck-record (IRHandleClause {
   op-name = c.op-name,
   params = c.params,
   resume-name = c.resume-name,
   body = rewrite-ir-expr tdefs (c.body),
   span = c.span
  })))

rewrite-ir-record-fields : List TypeBinding, List IRFieldVal, Integer, Integer, List IRFieldVal -> List IRFieldVal
rewrite-ir-record-fields (tdefs) (fs) (i) (len) (acc) =
  if i == len then acc
  else let f = list-at fs i
  in rewrite-ir-record-fields tdefs fs (i + 1) len (list-push acc (deck-record (IRFieldVal {
   name = f.name,
   value = rewrite-ir-expr tdefs (f.value),
   span = f.span
  })))

rewrite-ir-def : List TypeBinding, IRDef -> IRDef
rewrite-ir-def (tdefs) (d) =
  deck-record (IRDef {
   name = d.name,
   params = rewrite-ir-params tdefs (d.params) 0 (list-length (d.params)) [],
   type-val = resolve-ty-deep tdefs (d.type-val),
   body = rewrite-ir-expr tdefs (d.body),
   chapter-slug = d.chapter-slug,
   span = d.span
  })

rewrite-ir-defs : List TypeBinding, List IRDef, Integer, Integer, List IRDef -> List IRDef
rewrite-ir-defs (tdefs) (defs) (i) (len) (acc) =
  if i == len then acc
  else rewrite-ir-defs tdefs defs (i + 1) len (list-push acc (rewrite-ir-def tdefs (list-at defs i)))

assign-chapters : List DefHeader, Text, Integer, List ChapterAssignment -> List ChapterAssignment
assign-chapters (headers) (current-chapter) (i) (acc) =
  if i == list-length headers then acc
  else let hdr = list-at headers i
  in assign-chapters headers current-chapter (i + 1) (list-push acc (ChapterAssignment {
   def-name = token-text (hdr.name),
   chapter-slug = current-chapter
  }))

find-colliding-names : List ChapterAssignment -> SkipListText
find-colliding-names (assignments) =
  find-collisions-loop assignments 0 (list-length assignments) skip-list-text-empty [] []

find-collisions-loop : List ChapterAssignment, Integer, Integer, SkipListText, List Text, List Text -> SkipListText
find-collisions-loop (assignments) (i) (len) (acc) (seen-names) (seen-slugs) =
  if i == len then acc
  else let a = list-at assignments i
  in if a.def-name == opening-entry-point then find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
     else if skip-list-text-has acc (a.def-name) then find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
     else let slen = list-length seen-names
  in let pos = bsearch-text-set seen-names (a.def-name) 0 slen
  in if pos < slen then if list-at seen-names pos == a.def-name then if list-at seen-slugs pos /= a.chapter-slug then find-collisions-loop assignments (i + 1) len (skip-list-text-insert acc (a.def-name)) seen-names seen-slugs
  else find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
  else find-collisions-loop assignments (i + 1) len acc (list-insert-at seen-names pos (a.def-name)) (list-insert-at seen-slugs pos (a.chapter-slug))
     else find-collisions-loop assignments (i + 1) len acc (list-insert-at seen-names pos (a.def-name)) (list-insert-at seen-slugs pos (a.chapter-slug))

count-openings : List ChapterAssignment, Integer, Integer, Integer -> Integer
count-openings (assignments) (i) (len) (count) =
  if i == len then count
  else let a = list-at assignments i
  in if a.def-name == opening-entry-point then count-openings assignments (i + 1) len (count + 1)
     else count-openings assignments (i + 1) len count

check-entry-point-duplicate : List ChapterAssignment -> List Diagnostic
check-entry-point-duplicate (assignments) =
  if count-openings assignments 0 (list-length assignments) 0 >= 2 then [make-error cdx-duplicate-definition "'opening' is defined in multiple chapters. A program has exactly one entry point." synthetic-span]
  else []

mangle-name : Text, Text -> Text
mangle-name (chapter-slug) (def-name) =
  slugify chapter-slug & "_" & def-name

slugify-loop : Text, Integer, Integer, List Text -> List Text
slugify-loop (s) (i) (len) (acc) =
  if i == len then acc
  else let c = char-code-at s i
  in if c == char-code-at " " 0 then slugify-loop s (i + 1) len (list-push acc "-")
     else if c >= cc-first-upper then if c <= cc-upper-z then slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char (c - 26))))
  else slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))
     else slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))

slugify : Text -> Text
slugify (s) =
  text-concat-list (slugify-loop s 0 (text-length s) [])

lookup-chapter : List ChapterAssignment, Text -> Text
lookup-chapter (assignments) (name) =
  lookup-chapter-loop assignments name 0 (list-length assignments)

lookup-chapter-loop : List ChapterAssignment, Text, Integer, Integer -> Text
lookup-chapter-loop (assignments) (name) (i) (len) =
  if i == len then ""
  else let a = list-at assignments i
  in if a.def-name == name then a.chapter-slug
     else lookup-chapter-loop assignments name (i + 1) len

bsearch-rename-pos : List RenameEntry, Text, Integer, Integer -> Integer
bsearch-rename-pos (entries) (name) (lo) (hi) =
  if lo >= hi then lo
  else let mid = lo + (hi - lo) / 2
  in if text-compare name ((list-at entries mid).original) <= 0 then bsearch-rename-pos entries name lo mid
     else bsearch-rename-pos entries name (mid + 1) hi

sorted-rename-insert : List RenameEntry, RenameEntry -> List RenameEntry
sorted-rename-insert (entries) (entry) =
  list-insert-at entries (bsearch-rename-pos entries (entry.original) 0 (list-length entries)) entry

scope-copy-text : Text -> Text
scope-copy-text (t) =
  if text-length t == 0 then ""
  else deck-record (substring t 0 (text-length t))

rename-lookup : List RenameEntry, Text -> Text
rename-lookup (entries) (name) =
  let len = list-length entries
  in let pos = bsearch-rename-pos entries name 0 len
  in if pos < len then if (list-at entries pos).original == name then scope-copy-text ((list-at entries pos).mangled)
  else name
     else name

is-colliding : SkipListText, Text -> Boolean
is-colliding (names) (name) =
  skip-list-text-has names name

rename-has-entry : List RenameEntry, Text -> Boolean
rename-has-entry (entries) (name) =
  let len = list-length entries
  in let pos = bsearch-rename-pos entries name 0 len
  in if pos >= len then False
     else (list-at entries pos).original == name

remove-rename : List RenameEntry, Text -> List RenameEntry
remove-rename (entries) (name) =
  if rename-has-entry entries name then remove-rename-loop entries name 0 (list-length entries) []
  else entries

remove-rename-loop : List RenameEntry, Text, Integer, Integer, List RenameEntry -> List RenameEntry
remove-rename-loop (entries) (name) (i) (len) (acc) =
  if i == len then acc
  else let e = list-at entries i
  in if e.original == name then remove-rename-loop entries name (i + 1) len acc
     else remove-rename-loop entries name (i + 1) len (list-push acc e)

remove-renames-for-params : List RenameEntry, List IRParam, Integer -> List RenameEntry
remove-renames-for-params (entries) (params) (i) =
  if i == list-length params then entries
  else let p = list-at params i
  in remove-renames-for-params (remove-rename entries (p.name)) params (i + 1)

rename-ir-expr : List RenameEntry, IRExpr -> IRExpr
rename-ir-expr (rn) (e) =
  when e
   is IrIntLit (v) (sp) -> e
   is IrNumLit (v) (sp) -> e
   is IrTextLit (v) (sp) -> e
   is IrBoolLit (v) (sp) -> e
   is IrCharLit (v) (sp) -> e
   is IrError (msg) (ty) (sp) -> e
   is IrFork (x) (ty) (sp) -> IrFork (rename-ir-expr rn x) ty sp
   is IrAwait (x) (ty) (sp) -> IrAwait (rename-ir-expr rn x) ty sp
   is IrNegate (x) (sp) -> IrNegate (rename-ir-expr rn x) sp
   is IrName (n) (ty) (sp) -> IrName (rename-lookup rn n) ty sp
   is IrBinary (op) (l) (r) (ty) (sp) -> IrBinary op (rename-ir-expr rn l) (rename-ir-expr rn r) ty sp
   is IrApply (f) (a) (ty) (sp) -> IrApply (rename-ir-expr rn f) (rename-ir-expr rn a) ty sp
   is IrIf (c) (t) (el) (ty) (sp) -> IrIf (rename-ir-expr rn c) (rename-ir-expr rn t) (rename-ir-expr rn el) ty sp
   is IrFieldAccess (rec) (field) (ty) (sp) -> IrFieldAccess (rename-ir-expr rn rec) field ty sp
   is IrLet (nm) (ty) (val) (body) (sp) -> rename-ir-let rn nm ty val body sp
   is IrLambda (params) (body) (ty) (sp) -> rename-ir-lambda rn params body ty sp
   is IrMatch (scrut) (branches) (ty) (sp) -> IrMatch (rename-ir-expr rn scrut) (rename-ir-branches rn branches 0 []) ty sp
   is IrList (elems) (ty) (sp) -> IrList (rename-ir-exprs rn elems 0 []) ty sp
   is IrRecord (nm) (fields) (ty) (sp) -> IrRecord nm (rename-ir-fields rn fields 0 []) ty sp
   is IrAct (stmts) (ty) (sp) -> IrAct (rename-ir-act-stmts rn stmts 0 []) ty sp
   is IrHandle (eff) (body) (clauses) (ty) (sp) -> IrHandle eff (rename-ir-expr rn body) (rename-ir-handle-clauses rn clauses 0 []) ty sp
   is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> IrWithTimeout secs effs scopes (rename-ir-expr rn body) ty sp
   is IrTry (max) (body) (fb) (fail) (ty) (sp) -> IrTry max (rename-ir-act-stmts rn body 0 []) (rename-ir-act-stmts rn fb 0 []) (rename-ir-act-stmts rn fail 0 []) ty sp

rename-ir-let : List RenameEntry, Text, CodexType, IRExpr, IRExpr, SourceSpan -> IRExpr
rename-ir-let (rn) (nm) (ty) (val) (body) (sp) =
  let rn2 = remove-rename rn nm
  in IrLet nm ty (rename-ir-expr rn val) (rename-ir-expr rn2 body) sp

rename-ir-lambda : List RenameEntry, List IRParam, IRExpr, CodexType, SourceSpan -> IRExpr
rename-ir-lambda (rn) (params) (body) (ty) (sp) =
  let rn2 = remove-renames-for-params rn params 0
  in IrLambda params (rename-ir-expr rn2 body) ty sp

rename-ir-exprs : List RenameEntry, List IRExpr, Integer, List IRExpr -> List IRExpr
rename-ir-exprs (rn) (elems) (i) (acc) =
  if i == list-length elems then acc
  else rename-ir-exprs rn elems (i + 1) (list-push acc (rename-ir-expr rn (list-at elems i)))

rename-ir-fields : List RenameEntry, List IRFieldVal, Integer, List IRFieldVal -> List IRFieldVal
rename-ir-fields (rn) (fields) (i) (acc) =
  if i == list-length fields then acc
  else let f = list-at fields i
  in rename-ir-fields rn fields (i + 1) (list-push acc (IRFieldVal {
   name = f.name,
   value = rename-ir-expr rn (f.value),
   span = f.span
  }))

rename-ir-branches : List RenameEntry, List IRBranch, Integer, List IRBranch -> List IRBranch
rename-ir-branches (rn) (branches) (i) (acc) =
  if i == list-length branches then acc
  else let b = list-at branches i
  in let rn2 = remove-renames-for-pat rn (b.pattern)
  in rename-ir-branches rn branches (i + 1) (list-push acc (IRBranch {
   pattern = b.pattern,
   body = rename-ir-expr rn2 (b.body),
   span = b.span
  }))

remove-renames-for-pat : List RenameEntry, IRPat -> List RenameEntry
remove-renames-for-pat (rn) (p) =
  when p
   is IrVarPat (nm) (ty) (sp) -> remove-rename rn nm
   is IrCtorPat (nm) (subs) (ty) (sp) -> remove-renames-for-pats rn subs 0
   is IrLitPat (v) (ty) (sp) -> rn
   is IrWildPat (sp) -> rn

remove-renames-for-pats : List RenameEntry, List IRPat, Integer -> List RenameEntry
remove-renames-for-pats (rn) (pats) (i) =
  if i == list-length pats then rn
  else remove-renames-for-pats (remove-renames-for-pat rn (list-at pats i)) pats (i + 1)

rename-ir-act-stmts : List RenameEntry, List IRActStmt, Integer, List IRActStmt -> List IRActStmt
rename-ir-act-stmts (rn) (stmts) (i) (acc) =
  if i == list-length stmts then acc
  else let stmt = list-at stmts i
  in when stmt
   is IrDoBind (nm) (ty) (expr) (sp) -> let rn2 = remove-rename rn nm
   in rename-ir-act-stmts rn2 stmts (i + 1) (list-push acc (IrDoBind nm ty (rename-ir-expr rn expr) sp))
   is IrDoExec (expr) (sp) -> rename-ir-act-stmts rn stmts (i + 1) (list-push acc (IrDoExec (rename-ir-expr rn expr) sp))

rename-ir-handle-clauses : List RenameEntry, List IRHandleClause, Integer, List IRHandleClause -> List IRHandleClause
rename-ir-handle-clauses (rn) (clauses) (i) (acc) =
  if i == list-length clauses then acc
  else let c = list-at clauses i
  in let rn2 = remove-rename rn (c.resume-name)
  in let rn3 = remove-clause-param-renames rn2 (c.params) 0 (list-length (c.params))
  in rename-ir-handle-clauses rn clauses (i + 1) (list-push acc (IRHandleClause {
   op-name = c.op-name,
   params = c.params,
   resume-name = c.resume-name,
   body = rename-ir-expr rn3 (c.body),
   span = c.span
  }))

remove-clause-param-renames : List RenameEntry, List Text, Integer, Integer -> List RenameEntry
remove-clause-param-renames (rn) (ps) (i) (len) =
  if i >= len then rn
  else remove-clause-param-renames (remove-rename rn (list-at ps i)) ps (i + 1) len

build-all-assignments : Text, List DefHeader, Integer, List ChapterAssignment -> List ChapterAssignment
build-all-assignments (source) (headers) (i) (acc) =
  if i == list-length headers then acc
  else let hdr = list-at headers i
  in build-all-assignments source headers (i + 1) (list-push acc (ChapterAssignment {
   def-name = token-text (hdr.name),
   chapter-slug = hdr.chapter-slug
  }))

build-chapter-rename-map : SkipListText, List ChapterAssignment, Text -> List RenameEntry
build-chapter-rename-map (colliding) (assignments) (cur-chap) =
  build-mod-renames colliding assignments cur-chap 0 (list-length assignments) []

build-mod-renames : SkipListText, List ChapterAssignment, Text, Integer, Integer, List RenameEntry -> List RenameEntry
build-mod-renames (colliding) (assignments) (cur-chap) (i) (len) (acc) =
  if i == len then acc
  else let a = list-at assignments i
  in if is-colliding colliding (a.def-name) then if a.chapter-slug == cur-chap then let cleaned = remove-rename acc (a.def-name)
  in build-mod-renames colliding assignments cur-chap (i + 1) len (sorted-rename-insert cleaned (RenameEntry {
   original = a.def-name,
   mangled = mangle-name cur-chap (a.def-name)
  }))
  else if has-rename acc (a.def-name) then build-mod-renames colliding assignments cur-chap (i + 1) len acc
  else build-mod-renames colliding assignments cur-chap (i + 1) len (sorted-rename-insert acc (RenameEntry {
   original = a.def-name,
   mangled = mangle-name (a.chapter-slug) (a.def-name)
  }))
     else build-mod-renames colliding assignments cur-chap (i + 1) len acc

has-rename : List RenameEntry, Text -> Boolean
has-rename (entries) (name) =
  rename-has-entry entries name

rename-aexpr : List RenameEntry, AExpr -> AExpr
rename-aexpr (rn) (e) =
  if list-length rn == 0 then e
  else when e
   is ALitExpr (v) (k) (s) -> e
   is AErrorExpr (msg) (s) -> e
   is ANameExpr (n) (s) -> let new-text = rename-lookup rn (n.value)
   in if new-text == n.value then e
      else deck-record (ANameExpr (deck-record (Name { value = new-text })) s)
   is ABinaryExpr (l) (op) (r) (s) -> deck-record (ABinaryExpr (rename-aexpr rn l) op (rename-aexpr rn r) s)
   is AUnaryExpr (x) (s) -> deck-record (AUnaryExpr (rename-aexpr rn x) s)
   is AApplyExpr (f) (a) (s) -> deck-record (AApplyExpr (rename-aexpr rn f) (rename-aexpr rn a) s)
   is AIfExpr (c) (t) (el) (s) -> deck-record (AIfExpr (rename-aexpr rn c) (rename-aexpr rn t) (rename-aexpr rn el) s)
   is ALetExpr (binds) (body) (s) -> rename-alet rn binds body s
   is ALambdaExpr (params) (body) (s) -> rename-alambda rn params body s
   is AMatchExpr (scrut) (arms) (s) -> deck-record (AMatchExpr (rename-aexpr rn scrut) (rename-amatch-arms rn arms 0 []) s)
   is AListExpr (elems) (s) -> deck-record (AListExpr (rename-aexprs rn elems 0 []) s)
   is ARecordExpr (name) (fields) (s) -> deck-record (ARecordExpr name (rename-afields rn fields 0 []) s)
   is AFieldAccess (rec) (field) (s) -> deck-record (AFieldAccess (rename-aexpr rn rec) field s)
   is AActExpr (stmts) (s) -> deck-record (AActExpr (rename-act-stmts rn stmts 0 []) s)
   is AHandleExpr (eff) (body) (clauses) (s) -> deck-record (AHandleExpr eff (rename-aexpr rn body) (rename-ahandle-clauses rn clauses 0 []) s)
   is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) -> deck-record (AWithTimeoutExpr timeout effs scopes (rename-aexpr rn body) s)
   is ATryExpr (max) (body) (fb) (fail) (s) -> deck-record (ATryExpr max (rename-act-stmts rn body 0 []) (rename-act-stmts rn fb 0 []) (rename-act-stmts rn fail 0 []) s)

rename-alet : List RenameEntry, List ALetBind, AExpr, SourceSpan -> AExpr
rename-alet (rn) (binds) (body) (s) =
  let new-binds = deck-record (rename-alet-binds rn binds 0 [])
  in let rn2 = remove-renames-for-let-binds rn binds 0
  in deck-record (ALetExpr new-binds (rename-aexpr rn2 body) s)

rename-alet-binds : List RenameEntry, List ALetBind, Integer, List ALetBind -> List ALetBind
rename-alet-binds (rn) (binds) (i) (acc) =
  if i == list-length binds then acc
  else let b = list-at binds i
  in rename-alet-binds rn binds (i + 1) (list-push acc (deck-record (ALetBind {
   name = b.name,
   value = rename-aexpr rn (b.value),
   span = b.span
  })))

remove-renames-for-let-binds : List RenameEntry, List ALetBind, Integer -> List RenameEntry
remove-renames-for-let-binds (rn) (binds) (i) =
  if i == list-length binds then rn
  else remove-renames-for-let-binds (remove-rename rn ((list-at binds i).name.value)) binds (i + 1)

rename-alambda : List RenameEntry, List Name, AExpr, SourceSpan -> AExpr
rename-alambda (rn) (params) (body) (s) =
  let rn2 = remove-renames-for-names rn params 0
  in deck-record (ALambdaExpr params (rename-aexpr rn2 body) s)

remove-renames-for-names : List RenameEntry, List Name, Integer -> List RenameEntry
remove-renames-for-names (rn) (names) (i) =
  if i == list-length names then rn
  else remove-renames-for-names (remove-rename rn ((list-at names i).value)) names (i + 1)

rename-aexprs : List RenameEntry, List AExpr, Integer, List AExpr -> List AExpr
rename-aexprs (rn) (elems) (i) (acc) =
  if i == list-length elems then acc
  else rename-aexprs rn elems (i + 1) (list-push acc (rename-aexpr rn (list-at elems i)))

rename-afields : List RenameEntry, List AFieldExpr, Integer, List AFieldExpr -> List AFieldExpr
rename-afields (rn) (fields) (i) (acc) =
  if i == list-length fields then acc
  else let f = list-at fields i
  in rename-afields rn fields (i + 1) (list-push acc (deck-record (AFieldExpr {
   name = f.name,
   value = rename-aexpr rn (f.value),
   span = f.span
  })))

rename-amatch-arms : List RenameEntry, List AMatchArm, Integer, List AMatchArm -> List AMatchArm
rename-amatch-arms (rn) (arms) (i) (acc) =
  if i == list-length arms then acc
  else let a = list-at arms i
  in let rn2 = remove-renames-for-apat rn (a.pattern)
  in rename-amatch-arms rn arms (i + 1) (list-push acc (deck-record (AMatchArm {
   pattern = a.pattern,
   body = rename-aexpr rn2 (a.body),
   span = a.span
  })))

remove-renames-for-apat : List RenameEntry, APat -> List RenameEntry
remove-renames-for-apat (rn) (p) =
  when p
   is AVarPat (n) (s) -> remove-rename rn (n.value)
   is ACtorPat (n) (subs) (s) -> remove-renames-for-apats rn subs 0
   is ALitPat (v) (k) (s) -> rn
   is AWildPat (s) -> rn

remove-renames-for-apats : List RenameEntry, List APat, Integer -> List RenameEntry
remove-renames-for-apats (rn) (pats) (i) =
  if i == list-length pats then rn
  else remove-renames-for-apats (remove-renames-for-apat rn (list-at pats i)) pats (i + 1)

rename-act-stmts : List RenameEntry, List AActStmt, Integer, List AActStmt -> List AActStmt
rename-act-stmts (rn) (stmts) (i) (acc) =
  if i == list-length stmts then acc
  else let s = list-at stmts i
  in when s
   is AActBindStmt (nm) (expr) (sp) -> let rn2 = remove-rename rn (nm.value)
   in rename-act-stmts rn2 stmts (i + 1) (list-push acc (deck-record (AActBindStmt nm (rename-aexpr rn expr) sp)))
   is AActExprStmt (expr) (sp) -> rename-act-stmts rn stmts (i + 1) (list-push acc (deck-record (AActExprStmt (rename-aexpr rn expr) sp)))

rename-ahandle-clauses : List RenameEntry, List AHandleClause, Integer, List AHandleClause -> List AHandleClause
rename-ahandle-clauses (rn) (clauses) (i) (acc) =
  if i == list-length clauses then acc
  else let c = list-at clauses i
  in let rn2 = remove-rename rn (c.resume-name.value)
  in let rn3 = remove-arenames-for-params rn2 (c.params) 0 (list-length (c.params))
  in rename-ahandle-clauses rn clauses (i + 1) (list-push acc (deck-record (AHandleClause {
   op-name = c.op-name,
   params = c.params,
   resume-name = c.resume-name,
   body = rename-aexpr rn3 (c.body),
   span = c.span
  })))

remove-arenames-for-params : List RenameEntry, List Name, Integer, Integer -> List RenameEntry
remove-arenames-for-params (rn) (ps) (i) (len) =
  if i >= len then rn
  else remove-arenames-for-params (remove-rename rn ((list-at ps i).value)) ps (i + 1) len

cite-selects-name : ACitesDecl, Text -> Boolean
cite-selects-name (c) (name) =
  cite-selects-name-loop (c.selected-names) name 0 (list-length (c.selected-names))

cite-selects-name-loop : List Name, Text, Integer, Integer -> Boolean
cite-selects-name-loop (names) (target) (j) (len) =
  if j == len then False
  else if (list-at names j).value == target then True
  else cite-selects-name-loop names target (j + 1) len

find-cite-conflict : List ACitesDecl, Text, Text, Integer, Integer -> Text
find-cite-conflict (citations) (citing) (name) (k) (total) =
  if k == total then ""
  else let c = list-at citations k
  in if c.citing-chapter == citing then if cite-selects-name c name then c.chapter-name.value
  else find-cite-conflict citations citing name (k + 1) total
     else find-cite-conflict citations citing name (k + 1) total

add-duplicate-cite-error : DiagnosticBag, ACitesDecl, Text, Text -> DiagnosticBag
add-duplicate-cite-error (bag) (cite) (name-val) (conflict) =
  bag-add bag (make-error cdx-duplicate-cite ("Name '" & name-val & "' is cited from both '" & cite.chapter-name.value & "' and '" & conflict & "' in chapter '" & cite.citing-chapter & "'") (cite.span))

check-cite-names : ACitesDecl, Integer, Integer, List ACitesDecl, Integer, Integer, DiagnosticBag -> DiagnosticBag
check-cite-names (cite) (j) (nlen) (all-citations) (i) (total) (bag) =
  if j == nlen then bag
  else let name = list-at (cite.selected-names) j
  in let conflict = find-cite-conflict all-citations (cite.citing-chapter) (name.value) (i + 1) total
  in let bag2 = if conflict == "" then bag
   else add-duplicate-cite-error bag cite (name.value) conflict
  in check-cite-names cite (j + 1) nlen all-citations i total bag2

check-duplicate-cites-loop : List ACitesDecl, Integer, Integer, DiagnosticBag -> DiagnosticBag
check-duplicate-cites-loop (citations) (i) (len) (bag) =
  if i == len then bag
  else let cite-i = list-at citations i
  in let bag2 = check-cite-names cite-i 0 (list-length (cite-i.selected-names)) citations i len bag
  in check-duplicate-cites-loop citations (i + 1) len bag2

check-duplicate-cites : List ACitesDecl -> DiagnosticBag
check-duplicate-cites (citations) =
  check-duplicate-cites-loop citations 0 (list-length citations) empty-bag

scope-achapter : AChapter, SkipListText, List ChapterAssignment -> AChapter
scope-achapter (ast) (colliding) (assignments) =
  let slug-cache = build-slug-cache assignments 0 (list-length assignments) []
  in let raw-defs = scope-adefs-ll (ast.defs) colliding assignments (ast.citations) slug-cache "" [] 0 (__linked-list-empty 0)
  in deck-record (AChapter {
   name = ast.name,
   defs = deck-record (__linked-list-to-list raw-defs),
   type-defs = ast.type-defs,
   effect-defs = ast.effect-defs,
   class-defs = ast.class-defs,
   instance-defs = ast.instance-defs,
   citations = ast.citations,
   chapter-title = ast.chapter-title,
   prose = ast.prose,
   section-titles = ast.section-titles,
   span = ast.span
  })

scope-adefs-ll : List ADef, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, Integer, LinkedList ADef -> LinkedList ADef
scope-adefs-ll (defs) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-rn) (i) (acc) =
  if i == list-length defs then acc
  else let d = list-at defs i
  in let rn = if d.chapter-slug == cur-slug then cur-rn
   else apply-cite-overrides (build-chapter-rename-map colliding assignments (d.chapter-slug)) citations colliding assignments slug-cache (d.chapter-slug) 0
  in let new-name = deck-record (Name { value = rename-lookup rn (d.name.value) })
  in let new-body = rename-aexpr rn (d.body)
  in scope-adefs-ll defs colliding assignments citations slug-cache (d.chapter-slug) rn (i + 1) (__linked-list-push acc (deck-record (ADef {
   name = new-name,
   params = d.params,
   declared-type = d.declared-type,
   body = new-body,
   chapter-slug = d.chapter-slug,
   span = d.span
  })))

apply-cite-overrides : List RenameEntry, List ACitesDecl, SkipListText, List ChapterAssignment, List Text, Text, Integer -> List RenameEntry
apply-cite-overrides (rn) (citations) (colliding) (assignments) (slug-cache) (cur-slug) (i) =
  apply-cite-overrides-loop rn citations colliding assignments slug-cache cur-slug i

apply-cite-overrides-loop : List RenameEntry, List ACitesDecl, SkipListText, List ChapterAssignment, List Text, Text, Integer -> List RenameEntry
apply-cite-overrides-loop (rn) (citations) (colliding) (assignments) (slug-cache) (cur-slug) (i) =
  if i == list-length citations then rn
  else let cite = list-at citations i
  in let full-cite-name = cite.quire.value & "--" & cite.chapter-name.value
  in let cite-slug = find-slug-for-cite-name full-cite-name assignments slug-cache
  in let rn2 = apply-cite-selected rn (cite.selected-names) cite-slug colliding assignments cur-slug 0
  in apply-cite-overrides-loop rn2 citations colliding assignments slug-cache cur-slug (i + 1)

build-slug-cache : List ChapterAssignment, Integer, Integer, List Text -> List Text
build-slug-cache (assignments) (i) (len) (acc) =
  if i == len then acc
  else build-slug-cache assignments (i + 1) len (list-push acc (slugify ((list-at assignments i).chapter-slug)))

find-slug-for-cite-name : Text, List ChapterAssignment, List Text -> Text
find-slug-for-cite-name (cite-name) (assignments) (slug-cache) =
  find-slug-for-cite-name-loop (slugify cite-name) assignments slug-cache 0 (list-length assignments)

find-slug-for-cite-name-loop : Text, List ChapterAssignment, List Text, Integer, Integer -> Text
find-slug-for-cite-name-loop (slug-cite) (assignments) (slug-cache) (i) (len) =
  if i == len then ""
  else if list-at slug-cache i == slug-cite then (list-at assignments i).chapter-slug
  else find-slug-for-cite-name-loop slug-cite assignments slug-cache (i + 1) len

apply-cite-selected : List RenameEntry, List Name, Text, SkipListText, List ChapterAssignment, Text, Integer -> List RenameEntry
apply-cite-selected (rn) (names) (cite-slug) (colliding) (assignments) (cur-slug) (i) =
  if i == list-length names then rn
  else let n = (list-at names i).value
  in if is-colliding colliding n then if chapter-defines-name assignments cur-slug n then apply-cite-selected rn names cite-slug colliding assignments cur-slug (i + 1)
  else let cleaned = remove-rename rn n
  in apply-cite-selected (sorted-rename-insert cleaned (RenameEntry {
   original = n,
   mangled = mangle-name cite-slug n
  })) names cite-slug colliding assignments cur-slug (i + 1)
     else apply-cite-selected rn names cite-slug colliding assignments cur-slug (i + 1)

chapter-defines-name : List ChapterAssignment, Text, Text -> Boolean
chapter-defines-name (assignments) (slug) (name) =
  chapter-defines-loop assignments slug name 0 (list-length assignments)

chapter-defines-loop : List ChapterAssignment, Text, Text, Integer, Integer -> Boolean
chapter-defines-loop (assignments) (slug) (name) (i) (len) =
  if i == len then False
  else let a = list-at assignments i
  in if a.def-name == name then if a.chapter-slug == slug then True
  else chapter-defines-loop assignments slug name (i + 1) len
     else chapter-defines-loop assignments slug name (i + 1) len

empty-scope : Scope
empty-scope =
  Scope {
   names = skip-list-text-empty,
   locals = skip-list-text-empty
  }

scope-has : Scope, Text -> Boolean
scope-has (sc) (name) =
  if skip-list-text-has (sc.locals) name then True
  else skip-list-text-has (sc.names) name

scope-add : Scope, Text -> Scope
scope-add (sc) (name) =
  __record-set sc "names" (skip-list-text-insert (sc.names) name)

scope-add-local : Scope, Text -> Scope
scope-add-local (sc) (name) =
  __record-set sc "locals" (skip-list-text-insert (sc.locals) name)

builtin-names : List Text
builtin-names =
  ["show", "negate", "True", "False", "Nothing", "print-line", "print-line-raw", "print-line-uni", "print-uni", "print-error", "print-error-uni", "read-line", "open-file", "read-all", "close-file", "read-file", "read-file-raw", "read-file-uni", "read-serial-cce", "write-file", "write-binary", "write-binary-file", "file-exists", "list-files", "list-directories", "create-directory", "path-combine", "path-filename", "external-compile-bare", "char-at", "char-to-text", "text-length", "substring", "is-letter", "is-digit", "is-whitespace", "text-to-integer", "text-to-double-bits", "integer-to-text", "text-replace", "text-split", "text-contains", "text-starts-with", "char-code", "char-code-at", "code-to-char", "list-length", "list-at", "list-insert-at", "list-set-at", "list-snoc", "list-push", "text-compare", "text-concat-list", "get-args", "get-env", "current-dir", "run-process", "run-process-full", "process-exit", "map", "get-state", "set-state", "run-state", "now", "random-integer", "fork", "await", "par", "race", "fail", "block-read", "block-write", "block-read-sector", "block-write-sector", "block-select", "block-sector-count", "peek-byte", "poke-byte", "port-in-byte", "port-out-byte", "port-in-16", "port-out-16", "port-in-32", "port-out-32", "peek-32", "peek-qword", "poke-32", "flush-tlb", "alloc-bytes", "process-yield", "process-spawn", "process-exit", "process-spawn-priority", "process-wait", "get-ticks", "process-get-pid", "process-restrict-cap", "process-kill", "process-get-cap", "process-status", "process-count", "chan-kern-create", "chan-kern-send", "chan-kern-recv", "chan-kern-close", "chan-kern-send-block", "chan-kern-recv-block", "chan-text-send", "chan-text-recv", "hardware-random", "identity-whoami", "identity-set", "device-seed", "boot-factstore-status", "identity-set-proc", "identity-get-proc", "process-spawn-with-heap", "net-status", "net-get-hwaddr", "net-send-raw", "net-recv-raw", "vmxon", "vmclear", "vmptrld", "vmlaunch", "vmresume", "vmread", "vmwrite", "rdmsr", "wrmsr", "vmlaunch-full", "vmresume-full", "uefi-set-attr", "uefi-clear-screen", "uefi-set-cursor", "uefi-enable-cursor", "uefi-set-mode", "uefi-read-key", "uefi-read-key-ex", "uefi-read-file", "__record-set", "__linked-list-empty", "__linked-list-push", "__linked-list-to-list", "__heap-save", "__heap-restore", "__heap-advance", "prof-start", "prof-dump", "__deck-pos", "__deck-set", "__deck-alloc", "__deck-enter", "__deck-exit", "__narrow", "__list-with-capacity", "__buf-write-byte", "__buf-write-bytes", "__buf-read-bytes", "bit-and", "bit-or", "bit-xor", "bit-shl", "bit-shr", "bit-shru", "bit-not", "int-mod", "abs", "min", "max", "Refl", "assume", "sym", "trans", "cong"]

is-type-name : Text -> Boolean
is-type-name (name) =
  if text-length name == 0 then False
  else is-letter (char-at name 0) & is-upper-char (char-at name 0)

is-upper-char : Char -> Boolean
is-upper-char (c) =
  let code = char-code c
  in code >= char-code 'E' & code <= char-code 'Z'

collect-top-level-names : List ADef, Integer, Integer, SkipListText, List Diagnostic -> CollectResult
collect-top-level-names (defs) (i) (len) (acc) (errs) =
  if i == len then deck-record (CollectResult {
   names = acc,
   errors = errs
  })
  else let def = list-at defs i
  in let name = def.name.value
  in if skip-list-text-has acc name then collect-top-level-names defs (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate definition: " & name) (def.span)])
     else collect-top-level-names defs (i + 1) len (skip-list-text-insert acc name) errs

collect-ctor-names : List ATypeDef, Integer, Integer, SkipListText, SkipListText, List Diagnostic -> CtorCollectResult
collect-ctor-names (type-defs) (i) (len) (type-acc) (ctor-acc) (errs) =
  if i == len then deck-record (CtorCollectResult {
   type-names = type-acc,
   ctor-names = ctor-acc,
   errors = errs
  })
  else let td = list-at type-defs i
  in when td
   is AVariantTypeDef (name) (params) (ctors) (s) -> let dup-check = check-type-name-dup type-acc (name.value) s errs
   in let ctor-result = collect-variant-ctors ctors 0 (list-length ctors) ctor-acc (dup-check.errors)
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) (ctor-result.ctor-acc) (ctor-result.errors)
   is ARecordTypeDef (name) (params) (fields) (is-mut) (s) -> let dup-check = check-type-name-dup type-acc (name.value) s errs
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) ctor-acc (dup-check.errors)

check-type-name-dup : SkipListText, Text, SourceSpan, List Diagnostic -> TypeNameDupResult
check-type-name-dup (type-acc) (name) (span) (errs) =
  if skip-list-text-has type-acc name then deck-record (TypeNameDupResult {
   type-acc = type-acc,
   errors = errs & [make-error cdx-duplicate-definition ("Duplicate type definition: '" & name & "' is already defined") span]
  })
  else deck-record (TypeNameDupResult {
   type-acc = skip-list-text-insert type-acc name,
   errors = errs
  })

collect-variant-ctors : List AVariantCtorDef, Integer, Integer, SkipListText, List Diagnostic -> VariantCtorResult
collect-variant-ctors (ctors) (i) (len) (acc) (errs) =
  if i == len then deck-record (VariantCtorResult {
   ctor-acc = acc,
   errors = errs
  })
  else let c = list-at ctors i
  in let name = c.name.value
  in if skip-list-text-has acc name then collect-variant-ctors ctors (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate constructor: '" & name & "' is already defined") (c.span)])
     else collect-variant-ctors ctors (i + 1) len (skip-list-text-insert acc name) errs

semantics--name-resolution_collect-effect-op-names : List AEffectDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
semantics--name-resolution_collect-effect-op-names (effs) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
  if i == len then deck-record (EffectOpCollectResult {
   op-names = op-acc,
   errors = errs
  })
  else let eff = list-at effs i
  in let after = collect-ops-of-effect (eff.ops) top-names ctor-names 0 (list-length (eff.ops)) op-acc errs
  in semantics--name-resolution_collect-effect-op-names effs top-names ctor-names (i + 1) len (after.op-names) (after.errors)

collect-ops-of-effect : List AEffectOpDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
collect-ops-of-effect (ops) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
  if i == len then deck-record (EffectOpCollectResult {
   op-names = op-acc,
   errors = errs
  })
  else let op = list-at ops i
  in let name = op.name.value
  in let op-is-dup = skip-list-text-has op-acc name
  in let collides = op-is-dup | skip-list-text-has top-names name | skip-list-text-has ctor-names name
  in let new-acc = if op-is-dup then op-acc
   else skip-list-text-insert op-acc name
  in let new-errs = if collides then errs & [make-error cdx-duplicate-definition ("Effect operation '" & name & "' conflicts with existing name") (op.span)]
   else errs
  in collect-ops-of-effect ops top-names ctor-names (i + 1) len new-acc new-errs

build-all-names-scope : SkipListText, SkipListText, List Text -> Scope
build-all-names-scope (top-names) (ctor-names) (builtins) =
  let top-list = skip-list-text-to-list top-names
  in let sc = add-names-to-scope empty-scope top-list 0 (list-length top-list)
  in let ctor-list = skip-list-text-to-list ctor-names
  in let sc2 = add-names-to-scope sc ctor-list 0 (list-length ctor-list)
  in add-names-to-scope sc2 builtins 0 (list-length builtins)

add-names-to-scope : Scope, List Text, Integer, Integer -> Scope
add-names-to-scope (sc) (names) (i) (len) =
  if i == len then sc
  else add-names-to-scope (scope-add sc (list-at names i)) names (i + 1) len

resolve-expr : Scope, AExpr -> List Diagnostic
resolve-expr (sc) (expr) =
  resolve-expr-at sc expr 0

resolve-expr-at : Scope, AExpr, Integer -> List Diagnostic
resolve-expr-at (sc) (expr) (depth) =
  if depth >= max-recursion-depth then [make-error cdx-resource-exhausted ("compiler resource exhausted in name-resolver.resolve-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)]
  else when expr
   is ALitExpr (val) (kind) (s) -> []
   is ANameExpr (name) (s) -> if scope-has sc (name.value) | is-type-name (name.value) then []
   else [make-error cdx-undefined-name ("Undefined name: " & name.value) s]
   is ABinaryExpr (left) (op) (right) (s) -> resolve-expr-at sc left (depth + 1) & resolve-expr-at sc right (depth + 1)
   is AUnaryExpr (operand) (s) -> resolve-expr-at sc operand (depth + 1)
   is AApplyExpr (func) (arg) (s) -> resolve-expr-at sc func (depth + 1) & resolve-expr-at sc arg (depth + 1)
   is AIfExpr (cond) (then-e) (else-e) (s) -> resolve-expr-at sc cond (depth + 1) & resolve-expr-at sc then-e (depth + 1) & resolve-expr-at sc else-e (depth + 1)
   is ALetExpr (bindings) (body) (s) -> resolve-let sc bindings body 0 (list-length bindings) skip-list-text-empty []
   is ALambdaExpr (params) (body) (s) -> let param-result = add-lambda-params sc params 0 (list-length params) s skip-list-text-empty []
   in param-result.errors & resolve-expr-at (param-result.scope) body (depth + 1)
   is AMatchExpr (scrutinee) (arms) (s) -> resolve-expr-at sc scrutinee (depth + 1) & resolve-match-arms sc arms 0 (list-length arms) []
   is AListExpr (elems) (s) -> resolve-list-elems sc elems 0 (list-length elems) []
   is ARecordExpr (name) (fields) (s) -> resolve-record-fields sc fields 0 (list-length fields) []
   is AFieldAccess (obj) (field) (s) -> resolve-expr-at sc obj (depth + 1)
   is AActExpr (stmts) (s) -> resolve-act-stmts sc stmts 0 (list-length stmts) skip-list-text-empty []
   is AHandleExpr (eff) (body) (clauses) (s) -> resolve-expr-at sc body (depth + 1) & resolve-handle-clauses sc clauses 0 (list-length clauses) []
   is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) -> resolve-expr-at sc body (depth + 1)
   is ATryExpr (max) (body) (fb) (fail) (s) -> resolve-act-stmts sc body 0 (list-length body) skip-list-text-empty [] & resolve-act-stmts sc fb 0 (list-length fb) skip-list-text-empty [] & resolve-act-stmts sc fail 0 (list-length fail) skip-list-text-empty []
   is AErrorExpr (msg) (s) -> []

resolve-handle-clauses : Scope, List AHandleClause, Integer, Integer, List Diagnostic -> List Diagnostic
resolve-handle-clauses (sc) (clauses) (i) (len) (errs) =
  if i == len then errs
  else let c = list-at clauses i
  in let clause-scope = Scope {
    names = sc.names,
    locals = skip-list-text-clone (sc.locals)
   }
  in let sc2 = scope-add-local clause-scope (c.resume-name.value)
  in let resume-seen = skip-list-text-insert skip-list-text-empty (c.resume-name.value)
  in let param-result = scope-add-clause-params sc2 (c.params) 0 (list-length (c.params)) (c.span) resume-seen []
  in let clause-errs = resolve-expr (param-result.scope) (c.body)
  in resolve-handle-clauses sc clauses (i + 1) len (errs & param-result.errors & clause-errs)

scope-add-clause-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
scope-add-clause-params (sc) (ps) (i) (len) (clause-span) (seen) (errs) =
  if i >= len then deck-record (ResolveScopeResult {
   scope = sc,
   errors = errs
  })
  else let name = (list-at ps i).value
  in if skip-list-text-has seen name then scope-add-clause-params sc ps (i + 1) len clause-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") clause-span])
     else scope-add-clause-params (scope-add-local sc name) ps (i + 1) len clause-span (skip-list-text-insert seen name) errs

resolve-let : Scope, List ALetBind, AExpr, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
resolve-let (sc) (bindings) (body) (i) (len) (seen) (errs) =
  if i == len then errs & resolve-expr sc body
  else let b = list-at bindings i
  in let name = b.name.value
  in let bind-errs = resolve-expr sc (b.value)
  in let dup-errs = if skip-list-text-has seen name then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name & "'") (b.span)]
   else []
  in let sc2 = scope-add-local sc name
  in resolve-let sc2 bindings body (i + 1) len (skip-list-text-insert seen name) (errs & bind-errs & dup-errs)

add-lambda-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
add-lambda-params (sc) (params) (i) (len) (lam-span) (seen) (errs) =
  if i == len then deck-record (ResolveScopeResult {
   scope = sc,
   errors = errs
  })
  else let name = (list-at params i).value
  in if skip-list-text-has seen name then add-lambda-params sc params (i + 1) len lam-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") lam-span])
     else add-lambda-params (scope-add-local sc name) params (i + 1) len lam-span (skip-list-text-insert seen name) errs

resolve-match-arms : Scope, List AMatchArm, Integer, Integer, List Diagnostic -> List Diagnostic
resolve-match-arms (sc) (arms) (i) (len) (errs) =
  if i == len then errs
  else let arm = list-at arms i
  in let arm-scope = Scope {
    names = sc.names,
    locals = skip-list-text-clone (sc.locals)
   }
  in let pat-result = semantics--name-resolution_collect-pattern-names arm-scope (arm.pattern)
  in let arm-errs = resolve-expr (pat-result.scope) (arm.body)
  in resolve-match-arms sc arms (i + 1) len (errs & pat-result.errors & arm-errs)

semantics--name-resolution_collect-pattern-names : Scope, APat -> ResolveScopeResult
semantics--name-resolution_collect-pattern-names (sc) (pat) =
  let pr = collect-pattern-names-at sc pat 0 skip-list-text-empty []
  in deck-record (ResolveScopeResult {
   scope = pr.scope,
   errors = pr.errors
  })

collect-pattern-names-at : Scope, APat, Integer, SkipListText, List Diagnostic -> PatResult
collect-pattern-names-at (sc) (pat) (depth) (seen) (errs) =
  if depth >= max-recursion-depth then deck-record (PatResult {
   scope = sc,
   seen = seen,
   errors = errs
  })
  else when pat
   is AVarPat (name) (s) -> if skip-list-text-has seen (name.value) then deck-record (PatResult {
    scope = sc,
    seen = seen,
    errors = errs & [make-error cdx-duplicate-definition ("Duplicate pattern variable: '" & name.value & "'") s]
   })
   else deck-record (PatResult {
    scope = scope-add-local sc (name.value),
    seen = skip-list-text-insert seen (name.value),
    errors = errs
   })
   is ACtorPat (name) (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs
   is ALitPat (val) (kind) (s) -> deck-record (PatResult {
    scope = sc,
    seen = seen,
    errors = errs
   })
   is AWildPat (s) -> deck-record (PatResult {
    scope = sc,
    seen = seen,
    errors = errs
   })

collect-ctor-pat-names : Scope, List APat, Integer, Integer, Integer, SkipListText, List Diagnostic -> PatResult
collect-ctor-pat-names (sc) (subs) (i) (len) (depth) (seen) (errs) =
  if i == len then deck-record (PatResult {
   scope = sc,
   seen = seen,
   errors = errs
  })
  else let sub = list-at subs i
  in let result = collect-pattern-names-at sc sub depth seen errs
  in collect-ctor-pat-names (result.scope) subs (i + 1) len depth (result.seen) (result.errors)

resolve-list-elems : Scope, List AExpr, Integer, Integer, List Diagnostic -> List Diagnostic
resolve-list-elems (sc) (elems) (i) (len) (errs) =
  if i == len then errs
  else let errs2 = resolve-expr sc (list-at elems i)
  in resolve-list-elems sc elems (i + 1) len (errs & errs2)

resolve-record-fields : Scope, List AFieldExpr, Integer, Integer, List Diagnostic -> List Diagnostic
resolve-record-fields (sc) (fields) (i) (len) (errs) =
  if i == len then errs
  else let f = list-at fields i
  in let errs2 = resolve-expr sc (f.value)
  in resolve-record-fields sc fields (i + 1) len (errs & errs2)

resolve-act-stmts : Scope, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
resolve-act-stmts (sc) (stmts) (i) (len) (seen) (errs) =
  if i == len then errs
  else let stmt = list-at stmts i
  in when stmt
   is AActExprStmt (e) (s) -> let errs2 = resolve-expr sc e
   in resolve-act-stmts sc stmts (i + 1) len seen (errs & errs2)
   is AActBindStmt (name) (e) (s) -> let errs2 = resolve-expr sc e
   in let dup-errs = if skip-list-text-has seen (name.value) then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name.value & "'") s]
    else []
   in let sc2 = scope-add-local sc (name.value)
   in resolve-act-stmts sc2 stmts (i + 1) len (skip-list-text-insert seen (name.value)) (errs & errs2 & dup-errs)

resolve-all-defs : Scope, List ADef, Integer, Integer, List Diagnostic -> List Diagnostic
resolve-all-defs (sc) (defs) (i) (len) (errs) =
  if i == len then errs
  else let def = list-at defs i
  in let fresh-scope = Scope {
    names = sc.names,
    locals = skip-list-text-empty
   }
  in let param-result = add-def-params fresh-scope (def.params) 0 (list-length (def.params)) []
  in let errs2 = resolve-expr (param-result.scope) (def.body)
  in resolve-all-defs sc defs (i + 1) len (errs & param-result.errors & errs2)

add-def-params : Scope, List AParam, Integer, Integer, List Diagnostic -> ResolveScopeResult
add-def-params (sc) (params) (i) (len) (errs) =
  if i == len then deck-record (ResolveScopeResult {
   scope = sc,
   errors = errs
  })
  else let p = list-at params i
  in let name = p.name.value
  in if skip-list-text-has (sc.locals) name then add-def-params sc params (i + 1) len (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") (p.span)])
     else add-def-params (scope-add-local sc name) params (i + 1) len errs

resolve-chapter : AChapter -> ResolveResult
resolve-chapter (mod) =
  resolve-chapter-with-citations mod []

resolve-chapter-with-citations : AChapter, List ResolveResult -> ResolveResult
resolve-chapter-with-citations (mod) (imported) =
  let top = collect-top-level-names (mod.defs) 0 (list-length (mod.defs)) skip-list-text-empty []
  in let ctors = collect-ctor-names (mod.type-defs) 0 (list-length (mod.type-defs)) skip-list-text-empty skip-list-text-empty []
  in let effect-ops = semantics--name-resolution_collect-effect-op-names (mod.effect-defs) (top.names) (ctors.ctor-names) 0 (list-length (mod.effect-defs)) skip-list-text-empty []
  in let cited-names = collect-cited-names imported 0 (list-length imported) skip-list-text-empty
  in let all-top = skip-list-text-union (skip-list-text-union (skip-list-text-clone (top.names)) (effect-ops.op-names)) cited-names
  in let sc = build-all-names-scope all-top (ctors.ctor-names) builtin-names
  in let expr-errs = resolve-all-defs sc (mod.defs) 0 (list-length (mod.defs)) []
  in let ctor-list = deck-record (skip-list-text-to-list (ctors.ctor-names))
  in deck-record (ResolveResult {
   bag = deck-record (bag-from-list (top.errors & ctors.errors & effect-ops.errors & expr-errs)),
   top-level-names = top.names,
   type-names = ctors.type-names,
   ctor-names = ctor-list
  })

collect-cited-names : List ResolveResult, Integer, Integer, SkipListText -> SkipListText
collect-cited-names (results) (i) (len) (acc) =
  if i == len then acc
  else let r = list-at results i
  in let acc2 = skip-list-text-union acc (r.top-level-names)
  in let acc3 = skip-list-text-union acc2 (skip-list-text-from-list (r.ctor-names))
  in collect-cited-names results (i + 1) len acc3

cc-newline : Integer
cc-newline =
  char-code '\n'

cc-cr : Integer
cc-cr =
  -1

cc-space : Integer
cc-space =
  char-code ' '

cc-double-quote : Integer
cc-double-quote =
  char-code '"'

cc-single-quote : Integer
cc-single-quote =
  char-code '\''

cc-ampersand : Integer
cc-ampersand =
  char-code '&'

cc-left-paren : Integer
cc-left-paren =
  char-code '('

cc-right-paren : Integer
cc-right-paren =
  char-code ')'

cc-star : Integer
cc-star =
  char-code '*'

cc-plus : Integer
cc-plus =
  char-code '+'

cc-comma : Integer
cc-comma =
  char-code ','

cc-minus : Integer
cc-minus =
  char-code '-'

cc-dot : Integer
cc-dot =
  char-code '.'

cc-slash : Integer
cc-slash =
  char-code '/'

cc-zero : Integer
cc-zero =
  char-code '0'

cc-nine : Integer
cc-nine =
  char-code '9'

cc-colon : Integer
cc-colon =
  char-code ':'

cc-less : Integer
cc-less =
  char-code '<'

cc-equals : Integer
cc-equals =
  char-code '='

cc-greater : Integer
cc-greater =
  char-code '>'

cc-first-upper : Integer
cc-first-upper =
  char-code 'E'

cc-upper-z : Integer
cc-upper-z =
  char-code 'Z'

cc-left-bracket : Integer
cc-left-bracket =
  char-code '['

cc-backslash : Integer
cc-backslash =
  char-code '\\'

cc-right-bracket : Integer
cc-right-bracket =
  char-code ']'

cc-caret : Integer
cc-caret =
  char-code '^'

cc-underscore : Integer
cc-underscore =
  char-code '_'

cc-lower-a : Integer
cc-lower-a =
  char-code 'a'

cc-lower-n : Integer
cc-lower-n =
  char-code 'n'

cc-lower-r : Integer
cc-lower-r =
  char-code 'r'

cc-lower-t : Integer
cc-lower-t =
  char-code 't'

cc-lower-z : Integer
cc-lower-z =
  char-code 'z'

cc-at : Integer
cc-at =
  char-code '@'

cc-left-brace : Integer
cc-left-brace =
  char-code '{'

cc-pipe : Integer
cc-pipe =
  char-code '|'

cc-right-brace : Integer
cc-right-brace =
  char-code '}'

is-letter-code : Integer -> Boolean
is-letter-code (c) =
  is-letter (code-to-char c)

is-digit-code : Integer -> Boolean
is-digit-code (c) =
  is-digit (code-to-char c)

make-lex-state : Text, Integer, LinkedList Diagnostic -> LexState
make-lex-state (src) (fid) (pre-errors) =
  LexState {
   source = src,
   offset = 0,
   line = 1,
   column = 1,
   file-id = fid,
   errors = pre-errors,
   prose-mode = False
  }

make-lex-state-prose : Text, Integer, LinkedList Diagnostic, Boolean -> LexState
make-lex-state-prose (src) (fid) (pre-errors) (prose) =
  LexState {
   source = src,
   offset = 0,
   line = 1,
   column = 1,
   file-id = fid,
   errors = pre-errors,
   prose-mode = prose
  }

add-lex-error : LexState, Integer, Text, SourceSpan -> LexState
add-lex-error (st) (code) (msg) (span) =
  __record-set st "errors" (__linked-list-push (st.errors) (make-error code msg span))

is-at-end : LexState -> Boolean
is-at-end (st) =
  st.offset >= text-length (st.source)

peek-code : LexState -> Integer
peek-code (st) =
  if is-at-end st then 0
  else char-code-at (st.source) (st.offset)

advance-char : LexState -> LexState
advance-char (st) =
  if peek-code st == cc-newline then LexState {
   source = st.source,
   offset = st.offset + 1,
   line = st.line + 1,
   column = 1,
   file-id = st.file-id,
   errors = st.errors,
   prose-mode = st.prose-mode
  }
  else LexState {
   source = st.source,
   offset = st.offset + 1,
   line = st.line,
   column = st.column + 1,
   file-id = st.file-id,
   errors = st.errors,
   prose-mode = st.prose-mode
  }

skip-spaces-end : Text, Integer, Integer -> Integer
skip-spaces-end (source) (offset) (len) =
  if offset >= len then offset
  else if char-code-at source offset == cc-space then skip-spaces-end source (offset + 1) len
  else offset

skip-spaces : LexState -> LexState
skip-spaces (st) =
  let len = text-length (st.source)
  in let stop = skip-spaces-end (st.source) (st.offset) len
  in if stop == st.offset then st
     else let new-col = st.column + (stop - st.offset)
  in let st1 = __record-set st "offset" stop
  in __record-set st1 "column" new-col

scan-ident-end : Text, Integer, Integer -> Integer
scan-ident-end (source) (offset) (len) =
  if offset >= len then offset
  else let c = char-code-at source offset
  in if is-letter-code c then scan-ident-end source (offset + 1) len
     else if is-digit-code c then scan-ident-end source (offset + 1) len
     else if c == cc-underscore then scan-ident-end source (offset + 1) len
     else if c == cc-minus then if offset + 1 >= len then offset
  else let nc = char-code-at source (offset + 1)
  in if is-letter-code nc | is-digit-code nc then scan-ident-end source (offset + 1) len
     else if nc == cc-minus then if offset + 2 >= len then offset
  else let nnc = char-code-at source (offset + 2)
  in if is-letter-code nnc | is-digit-code nnc then scan-ident-end source (offset + 2) len
     else offset
     else offset
     else offset

scan-ident-rest : LexState -> LexState
scan-ident-rest (st) =
  let len = text-length (st.source)
  in let stop = scan-ident-end (st.source) (st.offset) len
  in if stop == st.offset then st
     else let new-col = st.column + (stop - st.offset)
  in let st1 = __record-set st "offset" stop
  in __record-set st1 "column" new-col

scan-digits-end : Text, Integer, Integer -> Integer
scan-digits-end (source) (offset) (len) =
  if offset >= len then offset
  else let c = char-code-at source offset
  in if is-digit-code c then scan-digits-end source (offset + 1) len
     else if c == cc-underscore then scan-digits-end source (offset + 1) len
     else offset

scan-digits : LexState -> LexState
scan-digits (st) =
  let len = text-length (st.source)
  in let stop = scan-digits-end (st.source) (st.offset) len
  in if stop == st.offset then st
     else let new-col = st.column + (stop - st.offset)
  in let st1 = __record-set st "offset" stop
  in __record-set st1 "column" new-col

scan-string-end : Text, Integer, Integer -> Integer
scan-string-end (source) (offset) (len) =
  if offset >= len then offset
  else let c = char-code-at source offset
  in if c == cc-double-quote then offset + 1
     else if c == cc-newline then offset
     else if c == cc-backslash then scan-string-end source (offset + 2) len
     else scan-string-end source (offset + 1) len

scan-string-body : LexState -> LexState
scan-string-body (st) =
  let len = text-length (st.source)
  in let stop = scan-string-end (st.source) (st.offset) len
  in if stop == st.offset then st
     else let new-col = st.column + (stop - st.offset)
  in let st1 = __record-set st "offset" stop
  in let st2 = __record-set st1 "column" new-col
  in let terminated = stop <= len & stop > 0 & char-code-at (st.source) (stop - 1) == cc-double-quote
  in if terminated then st2
     else let open-span = span-at (st.line) (st.column - 1) (st.offset - 1) 1 (st.file-id)
  in let err = make-error cdx-unterminated-text "Unterminated text literal: hit end of line before closing '\"'" open-span
  in __record-set st2 "errors" (__linked-list-push (st2.errors) err)

validate-escapes-into : Text, Integer, Integer, Integer, Integer, LinkedList Diagnostic -> LinkedList Diagnostic
validate-escapes-into (s) (base-line) (base-col) (base-off) (fid) (errs) =
  validate-escapes-loop s 0 (text-length s) base-line base-col base-off fid errs

validate-escapes-loop : Text, Integer, Integer, Integer, Integer, Integer, Integer, LinkedList Diagnostic -> LinkedList Diagnostic
validate-escapes-loop (s) (i) (len) (line) (col) (off) (fid) (errs) =
  if i >= len then errs
  else let c = char-code-at s i
  in if c == cc-backslash then if i + 1 < len then let nc = char-code-at s (i + 1)
  in let esc-span = span-at line (col + i) (off + i) 2 fid
  in if nc == cc-lower-t then validate-escapes-loop s (i + 2) len line col off fid (__linked-list-push errs (make-error cdx-invalid-tab-escape "\\t escape is not valid in CCE; use spaces directly" esc-span))
     else if nc == cc-lower-r then validate-escapes-loop s (i + 2) len line col off fid (__linked-list-push errs (make-error cdx-invalid-carriage-return-escape "\\r escape is not valid in CCE; use \\n for newlines" esc-span))
     else validate-escapes-loop s (i + 2) len line col off fid errs
  else errs
     else validate-escapes-loop s (i + 1) len line col off fid errs

decode-escapes : Text -> Text
decode-escapes (s) =
  text-concat-list (decode-escapes-loop s 0 (text-length s) [])

decode-escapes-loop : Text, Integer, Integer, List Text -> List Text
decode-escapes-loop (s) (i) (len) (acc) =
  if i >= len then acc
  else let c = char-code-at s i
  in if c == cc-backslash then if i + 1 < len then let nc = char-code-at s (i + 1)
  in if nc == cc-lower-n then decode-escapes-loop s (i + 2) len (list-push acc (char-to-text '\n'))
     else if nc == cc-lower-t then decode-escapes-loop s (i + 2) len (list-push acc "  ")
     else if nc == cc-lower-r then decode-escapes-loop s (i + 2) len acc
     else if nc == cc-backslash then decode-escapes-loop s (i + 2) len (list-push acc "\\")
     else if nc == cc-double-quote then decode-escapes-loop s (i + 2) len (list-push acc "\"")
     else decode-escapes-loop s (i + 2) len (list-push acc (char-to-text (char-at s (i + 1))))
  else list-push acc (char-to-text (char-at s i))
     else decode-escapes-loop s (i + 1) len (list-push acc (char-to-text (char-at s i)))

classify-word : Text -> TokenKind
classify-word (w) =
  deck-record (if w == "let" then LetKeyword
  else if w == "in" then InKeyword
  else if w == "between" then BetweenKeyword
  else if w == "if" then IfKeyword
  else if w == "is" then IsKeyword
  else if w == "otherwise" then OtherwiseKeyword
  else if w == "then" then ThenKeyword
  else if w == "else" then ElseKeyword
  else if w == "when" then WhenKeyword
  else if w == "where" then WhereKeyword
  else if w == "act" then ActKeyword
  else if w == "end" then EndKeyword
  else if w == "record" then RecordKeyword
  else if w == "cites" then CitesKeyword
  else if w == "claim" then ClaimKeyword
  else if w == "proof" then ProofKeyword
  else if w == "qed" then QedKeyword
  else if w == "induction" then InductionKeyword
  else if w == "forall" then ForAllKeyword
  else if w == "exists" then ThereExistsKeyword
  else if w == "linear" then LinearKeyword
  else if w == "mutable" then MutableKeyword
  else if w == "effect" then EffectKeyword
  else if w == "class" then ClassKeyword
  else if w == "instance" then InstanceKeyword
  else if w == "with" then WithKeyword
  else if w == "with-timeout" then WithTimeoutKeyword
  else if w == "trying" then TryingKeyword
  else if w == "True" then TrueKeyword
  else if w == "False" then FalseKeyword
  else let first-code = char-code-at w 0
  in if first-code >= cc-first-upper then if first-code <= cc-upper-z then TypeIdentifier
  else Identifier
     else Identifier)

make-token : TokenKind, Integer, LexState -> Token
make-token (kind) (length) (st) =
  deck-record (Token {
   kind = kind,
   source = st.source,
   offset = st.offset,
   length = length,
   line = st.line,
   column = st.column,
   file-id = st.file-id
  })

extract-text : LexState, Integer, LexState -> Text
extract-text (st) (start) (end-st) =
  substring (st.source) start (end-st.offset - start)

scan-to-eol-end : Text, Integer, Integer -> Integer
scan-to-eol-end (source) (offset) (len) =
  if offset >= len then offset
  else let c = char-code-at source offset
  in if c == cc-newline then offset
     else scan-to-eol-end source (offset + 1) len

scan-prose-text : LexState -> LexStep
scan-prose-text (s) =
  let len = text-length (s.source)
  in let stop = scan-to-eol-end (s.source) (s.offset) len
  in let tok-len = stop - s.offset
  in if tok-len == 0 then LexToken (make-token (deck-record ProseText) 0 s) s
     else let new-col = s.column + tok-len
  in let s1 = __record-set s "offset" stop
  in let s2 = __record-set s1 "column" new-col
  in LexToken (make-token (deck-record ProseText) tok-len s) s2

skip-prose-line : LexState -> LexStep
skip-prose-line (s) =
  let len = text-length (s.source)
  in let stop = scan-to-eol-end (s.source) (s.offset) len
  in let tok-len = stop - s.offset
  in let new-col = s.column + tok-len
  in let s1 = __record-set s "offset" stop
  in let s2 = __record-set s1 "column" new-col
  in scan-token s2

scan-token : LexState -> LexStep
scan-token (st) =
  let s = skip-spaces st
  in if is-at-end s then LexEnd
     else let c = peek-code s
  in if c == cc-cr then scan-token (advance-char s)
     else if s.column == 2 & c /= cc-newline then if s.prose-mode then if c == cc-at then LexToken (make-token (deck-record AtSign) 1 s) (advance-char s)
  else scan-prose-text s
  else skip-prose-line s
     else if c == cc-newline then LexToken (make-token (deck-record Newline) 1 s) (advance-char s)
     else if c == cc-double-quote then let start = s.offset + 1
  in let after = scan-string-body (advance-char s)
  in let body-len = after.offset - start - 1
  in let safe-len = if body-len < 0 then 0
   else body-len
  in let raw = substring (s.source) start safe-len
  in let merged-errs = validate-escapes-into raw (s.line) (s.column + 1) start (s.file-id) (after.errors)
  in let after-with-errs = __record-set after "errors" merged-errs
  in LexToken (make-token (deck-record TextLiteral) (after.offset - s.offset) s) after-with-errs
     else if c == cc-single-quote then scan-char-literal s
     else if is-letter-code c then let start = s.offset
  in let after = scan-ident-rest (advance-char s)
  in let word = extract-text s start after
  in LexToken (make-token (classify-word word) (after.offset - start) s) after
     else if c == cc-underscore then let start = s.offset
  in let after = scan-ident-rest (advance-char s)
  in let word-len = after.offset - start
  in if word-len == 1 then LexToken (make-token (deck-record Underscore) 1 s) after
     else LexToken (make-token (classify-word (extract-text s start after)) word-len s) after
     else if is-digit-code c then let start = s.offset
  in let after = scan-digits (advance-char s)
  in if is-at-end after then LexToken (make-token (deck-record IntegerLiteral) (after.offset - start) s) after
     else if peek-code after == cc-dot then let after-dot = advance-char after
  in if is-at-end after-dot then LexToken (make-token (deck-record IntegerLiteral) (after.offset - start) s) after
     else if peek-code after-dot == cc-dot then LexToken (make-token (deck-record IntegerLiteral) (after.offset - start) s) after
     else let after2 = scan-digits after-dot
  in LexToken (make-token (deck-record NumberLiteral) (after2.offset - start) s) after2
     else LexToken (make-token (deck-record IntegerLiteral) (after.offset - start) s) after
     else scan-operator s

scan-operator : LexState -> LexStep
scan-operator (s) =
  let c = peek-code s
  in let next = advance-char s
  in if c == cc-left-paren then LexToken (make-token (deck-record LeftParen) 1 s) next
     else if c == cc-right-paren then LexToken (make-token (deck-record RightParen) 1 s) next
     else if c == cc-left-bracket then LexToken (make-token (deck-record LeftBracket) 1 s) next
     else if c == cc-right-bracket then LexToken (make-token (deck-record RightBracket) 1 s) next
     else if c == cc-left-brace then LexToken (make-token (deck-record LeftBrace) 1 s) next
     else if c == cc-right-brace then LexToken (make-token (deck-record RightBrace) 1 s) next
     else if c == cc-comma then LexToken (make-token (deck-record Comma) 1 s) next
     else if c == cc-dot then let nc = if is-at-end next then 0
   else peek-code next
  in if nc == cc-dot then LexToken (make-token (deck-record DotDot) 2 s) (advance-char next)
     else LexToken (make-token (deck-record Dot) 1 s) next
     else if c == cc-caret then LexToken (make-token (deck-record Caret) 1 s) next
     else if c == cc-ampersand then LexToken (make-token (deck-record Ampersand) 1 s) next
     else if c == cc-backslash then LexToken (make-token (deck-record Backslash) 1 s) next
     else scan-multi-char-operator s

scan-multi-char-operator : LexState -> LexStep
scan-multi-char-operator (s) =
  let c = peek-code s
  in let next = advance-char s
  in let nc = if is-at-end next then 0
   else peek-code next
  in if c == cc-plus then if nc == cc-plus then LexToken (make-token (deck-record PlusPlus) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Plus) 1 s) next
     else if c == cc-minus then if nc == cc-greater then LexToken (make-token (deck-record Arrow) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Minus) 1 s) next
     else if c == cc-star then LexToken (make-token (deck-record Star) 1 s) next
     else if c == cc-slash then if nc == cc-equals then LexToken (make-token (deck-record NotEquals) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Slash) 1 s) next
     else if c == cc-equals then if nc == cc-equals then let next2 = advance-char next
  in let nc2 = if is-at-end next2 then 0
   else peek-code next2
  in if nc2 == cc-equals then LexToken (make-token (deck-record TripleEquals) 3 s) (advance-char next2)
     else LexToken (make-token (deck-record DoubleEquals) 2 s) next2
  else if nc == cc-greater then LexToken (make-token (deck-record FatArrow) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Equals) 1 s) next
     else if c == cc-colon then if nc == cc-colon then LexToken (make-token (deck-record ColonColon) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Colon) 1 s) next
     else if c == cc-pipe then if nc == cc-minus then LexToken (make-token (deck-record Turnstile) 2 s) (advance-char next)
  else if nc == cc-greater then LexToken (make-token (deck-record PipeForward) 2 s) (advance-char next)
  else LexToken (make-token (deck-record Pipe) 1 s) next
     else if c == cc-less then if nc == cc-equals then LexToken (make-token (deck-record LessOrEqual) 2 s) (advance-char next)
  else if nc == cc-minus then LexToken (make-token (deck-record LeftArrow) 2 s) (advance-char next)
  else LexToken (make-token (deck-record LessThan) 1 s) next
     else if c == cc-greater then if nc == cc-equals then LexToken (make-token (deck-record GreaterOrEqual) 2 s) (advance-char next)
  else LexToken (make-token (deck-record GreaterThan) 1 s) next
     else LexToken (make-token (deck-record ErrorToken) 1 s) next

scan-char-literal : LexState -> LexStep
scan-char-literal (s) =
  let s1 = advance-char s
  in if is-at-end s1 then LexToken (make-token (deck-record ErrorToken) (s1.offset - s.offset) s) s1
     else if peek-code s1 == cc-backslash then let s2 = advance-char s1
  in if is-at-end s2 then LexToken (make-token (deck-record ErrorToken) (s2.offset - s.offset) s) s2
     else let esc-code = peek-code s2
  in let s3 = advance-char s2
  in let s4 = if is-at-end s3 then s3
   else if peek-code s3 == cc-single-quote then advance-char s3
   else s3
  in let esc-span = span-at (s1.line) (s1.column) (s1.offset) 2 (s1.file-id)
  in let s5 = if esc-code == cc-lower-t then add-lex-error s4 cdx-invalid-tab-escape "\\t escape is not valid in CCE; use a space character instead" esc-span
   else if esc-code == cc-lower-r then add-lex-error s4 cdx-invalid-carriage-return-escape "\\r escape is not valid in CCE; use '\\n' for newlines" esc-span
   else s4
  in LexToken (make-token (deck-record CharLiteral) (s5.offset - s.offset) s) s5
     else let s2 = advance-char s1
  in let s3 = if is-at-end s2 then s2
   else if peek-code s2 == cc-single-quote then advance-char s2
   else s2
  in LexToken (make-token (deck-record CharLiteral) (s3.offset - s.offset) s) s3

tokenize-collect : LexState, LinkedList Token -> LexCollected
tokenize-collect (st) (acc) =
  when scan-token st
   is LexToken (tok) (next) -> if tok.kind == EndOfFile then LexCollected {
    collected-tokens = __linked-list-push acc tok,
    collected-errors = next.errors
   }
   else tokenize-collect next (__linked-list-push acc tok)
   is LexEnd -> LexCollected {
    collected-tokens = __linked-list-push acc (make-token (deck-record EndOfFile) 0 st),
    collected-errors = st.errors
   }

tokenize : Text, Integer -> TokenizeResult
tokenize (src) (fid) =
  let raw = tokenize-collect (make-lex-state src fid (__linked-list-empty 0)) (__linked-list-empty 0)
  in TokenizeResult {
   tokens = __linked-list-to-list (raw.collected-tokens),
   errors = __linked-list-to-list (raw.collected-errors)
  }

tokenize-into : Text, Integer, Boolean -> TokenizeResult
tokenize-into (src) (fid) (prose) =
  let raw = tokenize-collect (make-lex-state-prose src fid (__linked-list-empty 0) prose) (__linked-list-empty 0)
  in deck-record (TokenizeResult {
   tokens = __linked-list-to-list (raw.collected-tokens),
   errors = __linked-list-to-list (raw.collected-errors)
  })

parse-type : ParseState -> ParseTypeResult
parse-type (st) =
  if parse-fuel-exhausted st then TypeOk (deck-record (NamedType (current st))) (emit-parse-fuel-error st "parse-type")
  else let st0 = consume-parse-fuel st
  in let atom-r = parse-type-atom st0
  in unwrap-type-ok atom-r parse-type-with-args

parse-type-with-args : TypeExpr, ParseState -> ParseTypeResult
parse-type-with-args (atom) (st) =
  let applied-r = parse-type-args atom st
  in unwrap-type-ok applied-r parse-type-bound-or-continue

parse-type-bound-or-continue : TypeExpr, ParseState -> ParseTypeResult
parse-type-bound-or-continue (left) (st) =
  if is-between-keyword (current-kind st) then parse-bound-between left (advance st)
  else parse-type-continue left st

parse-bound-int : ParseState -> BoundIntResult
parse-bound-int (st) =
  if is-minus (current-kind st) then let st1 = advance st
  in if is-literal (current-kind st1) then BoundIntResult {
   value = -(text-to-integer (token-text (current st1))),
   state = advance st1
  }
     else BoundIntResult {
   value = 0,
   state = report-bound-int-error st1
  }
  else if is-literal (current-kind st) then BoundIntResult {
   value = text-to-integer (token-text (current st)),
   state = advance st
  }
  else BoundIntResult {
   value = 0,
   state = report-bound-int-error st
  }

report-bound-int-error : ParseState -> ParseState
report-bound-int-error (st) =
  let tok = current st
  in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected integer literal in bound annotation, got '" & token-text tok & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

parse-bound-between : TypeExpr, ParseState -> ParseTypeResult
parse-bound-between (base) (st) =
  let lo-r = parse-bound-int st
  in let st-and = expect-and-keyword (lo-r.state)
  in let hi-r = parse-bound-int st-and
  in let mode-r = parse-overflow-mode (hi-r.state)
  in parse-type-continue (deck-record (BoundedIntType base (lo-r.value) (hi-r.value) (mode-r.value))) (mode-r.state)

expect-and-keyword : ParseState -> ParseState
expect-and-keyword (st) =
  if is-ident (current-kind st) & token-text (current st) == "and" then advance st
  else let tok = current st
  in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected 'and' in bound annotation, got '" & token-text tok & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

parse-overflow-mode : ParseState -> OverflowModeResult
parse-overflow-mode (st) =
  if is-ident (current-kind st) then let txt = token-text (current st)
  in if txt == "wrapping" then OverflowModeResult {
   value = deck-record OvWrapping,
   state = advance st
  }
     else if txt == "clamping" then OverflowModeResult {
   value = deck-record OvClamping,
   state = advance st
  }
     else if txt == "error" then OverflowModeResult {
   value = deck-record OvError,
   state = advance st
  }
     else OverflowModeResult {
   value = deck-record OvError,
   state = st
  }
  else OverflowModeResult {
   value = deck-record OvError,
   state = st
  }

parse-type-continue : TypeExpr, ParseState -> ParseTypeResult
parse-type-continue (left) (st) =
  if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-continue")
  else let st-fueled = consume-parse-fuel st
  in if is-arrow (current-kind st-fueled) then let arrow-span = token-to-span (current st-fueled)
  in let st2 = advance st-fueled
  in let right-result = parse-type st2
  in unwrap-type-ok right-result (make-fun-type-arrow left arrow-span)
     else if is-fat-arrow (current-kind st-fueled) then let st2 = advance st-fueled
  in let right-result = parse-type st2
  in unwrap-type-ok right-result (make-constrained-type left)
     else if current-kind st-fueled == TripleEquals then let eq-span = token-to-span (current st-fueled)
  in let st2 = advance st-fueled
  in let right-result = parse-type st2
  in unwrap-type-ok right-result (make-prop-eq-type left eq-span)
     else if is-comma (current-kind st-fueled) then if comma-starts-type-param st-fueled then let st2 = skip-newlines (advance st-fueled)
  in let right-result = parse-type st2
  in unwrap-type-ok right-result (make-fun-type left)
  else TypeOk left st-fueled
     else TypeOk left st-fueled

comma-starts-type-param : ParseState -> Boolean
comma-starts-type-param (st) =
  let next = peek-kind st 1
  in if is-type-ident next then True
     else if is-left-bracket next then True
     else if is-left-paren next then True
     else if is-ident next then if is-colon (peek-kind st 2) then False
  else True
     else False

make-fun-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
make-fun-type (left) (right) (st) =
  TypeOk (deck-record (FunType left right)) st

make-prop-eq-type : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
make-prop-eq-type (left) (span) (right) (st) =
  TypeOk (deck-record (PropEqType left right span)) st

make-constrained-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
make-constrained-type (constraint) (body) (st) =
  TypeOk (deck-record (ConstrainedType constraint body)) st

make-fun-type-arrow : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
make-fun-type-arrow (left) (arrow-span) (right) (st) =
  let st2 = when right
    is FunType (p) (r) (s) -> if bag-has-code (st.bag) cdx-deprecated-arrow-params then st
    else __record-set st "bag" (bag-add (st.bag) (make-deprecated cdx-deprecated-arrow-params "A -> B -> C is deprecated; use A, B -> C instead" arrow-span))
    is otherwise -> st
  in TypeOk (deck-record (FunType left right)) st2

unwrap-type-ok : ParseTypeResult, (TypeExpr, ParseState -> ParseTypeResult) -> ParseTypeResult
unwrap-type-ok (r) (f) =
  when r
   is TypeOk (t) (st) -> f t st

parse-type-atom : ParseState -> ParseTypeResult
parse-type-atom (st) =
  if is-ident (current-kind st) then let tok = current st
  in TypeOk (deck-record (NamedType tok)) (advance st)
  else if is-type-ident (current-kind st) then let tok = current st
  in TypeOk (deck-record (NamedType tok)) (advance st)
  else if is-left-paren (current-kind st) then parse-paren-type (advance st)
  else if is-left-bracket (current-kind st) then parse-effect-type (advance st)
  else let tok = current st
  in TypeOk (deck-record (NamedType tok)) (advance st)

parse-paren-type : ParseState -> ParseTypeResult
parse-paren-type (st) =
  let inner = parse-type st
  in unwrap-type-ok inner finish-paren-type

finish-paren-type : TypeExpr, ParseState -> ParseTypeResult
finish-paren-type (t) (st) =
  let st2 = expect RightParen st
  in TypeOk (deck-record (ParenType t)) st2

parse-effect-type : ParseState -> ParseTypeResult
parse-effect-type (st) =
  let effs = parse-effect-names st (__linked-list-empty 0) (__linked-list-empty 0)
  in let ret = parse-type (effs.state)
  in unwrap-type-ok ret (finish-effect-type (effs.names) (effs.scopes))

finish-effect-type : List Token, List Token, TypeExpr, ParseState -> ParseTypeResult
finish-effect-type (effs) (scopes) (ret) (st) =
  TypeOk (deck-record (EffectTypeExpr effs scopes ret)) st

empty-scope-tok : Token
empty-scope-tok =
  Token {
   kind = TextLiteral,
   source = "",
   offset = 0,
   length = 0,
   line = 0,
   column = 0,
   file-id = 0
  }

parse-effect-names : ParseState, LinkedList Token, LinkedList Token -> EffectNamesResult
parse-effect-names (st) (acc) (sacc) =
  if is-done st then EffectNamesResult {
   names = deck-record (__linked-list-to-list acc),
   state = st,
   scopes = deck-record (__linked-list-to-list sacc)
  }
  else if is-right-bracket (current-kind st) then EffectNamesResult {
   names = deck-record (__linked-list-to-list acc),
   state = advance st,
   scopes = deck-record (__linked-list-to-list sacc)
  }
  else if is-comma (current-kind st) then parse-effect-names (advance st) acc sacc
  else if is-ident (current-kind st) | is-type-ident (current-kind st) then let tok = current st
  in let st2 = advance st
  in if is-dot (current-kind st2) then parse-dotted-effect st2 tok acc sacc
     else parse-effect-with-scope st2 tok acc sacc
  else parse-effect-names (advance st) acc sacc

parse-effect-with-scope : ParseState, Token, LinkedList Token, LinkedList Token -> EffectNamesResult
parse-effect-with-scope (st) (name-tok) (acc) (sacc) =
  if is-text-lit (current-kind st) then let scope-tok = current st
  in parse-effect-names (advance st) (__linked-list-push acc name-tok) (__linked-list-push sacc scope-tok)
  else parse-effect-names st (__linked-list-push acc name-tok) (__linked-list-push sacc empty-scope-tok)

parse-dotted-effect : ParseState, Token, LinkedList Token, LinkedList Token -> EffectNamesResult
parse-dotted-effect (st) (base-tok) (acc) (sacc) =
  let st2 = advance st
  in if is-ident (current-kind st2) | is-type-ident (current-kind st2) then let sub = current st2
  in let combined = deck-record (Token {
    kind = Identifier,
    source = base-tok.source,
    offset = base-tok.offset,
    length = sub.offset + sub.length - base-tok.offset,
    line = base-tok.line,
    column = base-tok.column,
    file-id = base-tok.file-id
   })
  in parse-effect-with-scope (advance st2) combined acc sacc
     else parse-effect-names st2 (__linked-list-push acc base-tok) (__linked-list-push sacc empty-scope-tok)

parse-type-args : TypeExpr, ParseState -> ParseTypeResult
parse-type-args (base-type) (st) =
  if parse-fuel-exhausted st then TypeOk base-type (emit-parse-fuel-error st "parse-type-args")
  else let st-fueled = consume-parse-fuel st
  in if is-done st-fueled then TypeOk base-type st-fueled
     else if is-type-arg-start (current-kind st-fueled) then parse-type-arg-next base-type st-fueled
     else TypeOk base-type st-fueled

parse-type-arg-next : TypeExpr, ParseState -> ParseTypeResult
parse-type-arg-next (base-type) (st) =
  let arg-result = parse-type-atom st
  in unwrap-type-ok arg-result (continue-type-args base-type)

continue-type-args : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
continue-type-args (base-type) (arg) (st) =
  parse-type-args (deck-record (AppType base-type [arg])) st

parse-pattern : ParseState -> ParsePatResult
parse-pattern (st) =
  if parse-fuel-exhausted st then PatOk (deck-record (WildPat (current st))) (emit-parse-fuel-error st "parse-pattern")
  else let st-fueled = consume-parse-fuel st
  in if is-wildcard-pat (current-kind st-fueled) then PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)
     else if is-literal (current-kind st-fueled) then PatOk (deck-record (LitPat (current st-fueled))) (advance st-fueled)
     else if is-type-ident (current-kind st-fueled) then let tok = current st-fueled
  in parse-ctor-pattern-fields tok (__linked-list-empty 0) (advance st-fueled)
     else if is-ident (current-kind st-fueled) then PatOk (deck-record (VarPat (current st-fueled))) (advance st-fueled)
     else PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)

parse-ctor-pattern-fields : Token, LinkedList Pat, ParseState -> ParsePatResult
parse-ctor-pattern-fields (ctor) (acc) (st) =
  if parse-fuel-exhausted st then PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) (emit-parse-fuel-error st "parse-ctor-pattern-fields")
  else let st-fueled = consume-parse-fuel st
  in if is-left-paren (current-kind st-fueled) then let st2 = advance st-fueled
  in let sub = parse-pattern st2
  in unwrap-pat-ok sub (continue-ctor-fields ctor acc)
     else PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) st-fueled

continue-ctor-fields : Token, LinkedList Pat, Pat, ParseState -> ParsePatResult
continue-ctor-fields (ctor) (acc) (p) (st) =
  let st2 = expect RightParen st
  in parse-ctor-pattern-fields ctor (__linked-list-push acc p) st2

unwrap-pat-ok : ParsePatResult, (Pat, ParseState -> ParsePatResult) -> ParsePatResult
unwrap-pat-ok (r) (f) =
  when r
   is PatOk (p) (st) -> f p st

parse-type-annotation : ParseState -> ParseTypeResult
parse-type-annotation (st) =
  let st2 = advance st
  in let st3 = expect Colon st2
  in parse-type st3

parse-definition : ParseState -> ParseDefResult
parse-definition (st) =
  if is-done st then ParseDefResult {
   maybe-def = None,
   state = st
  }
  else if is-claim-keyword (current-kind st) then skip-claim-def st
  else if is-proof-keyword (current-kind st) then parse-definition (advance st)
  else if is-ident (current-kind st) then try-parse-def st
  else if is-type-ident (current-kind st) then try-parse-def st
  else ParseDefResult {
   maybe-def = None,
   state = st
  }

is-simple-claim : ParseState -> Boolean
is-simple-claim (st) =
  if is-ident (peek-kind st 1) then is-colon (peek-kind st 2)
  else False

parse-claim-annotation : ParseState -> AnnotationNode
parse-claim-annotation (st) =
  let st1 = advance st
  in if is-ident (current-kind st1) then let name = token-text (current st1)
  in let prop = collect-claim-prop (advance st1) ""
  in deck-record (AnnotationNode {
   kind = "claim",
   target = name,
   body = prop
  })
     else deck-record (AnnotationNode {
   kind = "claim",
   target = "",
   body = ""
  })

collect-claim-prop : ParseState, Text -> Text
collect-claim-prop (st) (acc) =
  if is-done st then acc
  else when current-kind st
   is Newline -> acc
   is otherwise -> collect-claim-prop (advance st) (acc & " " & token-text (current st))

skip-claim-def : ParseState -> ParseDefResult
skip-claim-def (st) =
  let col = (current st).column
  in let st2 = advance st
  in let st3 = skip-claim-tokens st2 col
  in parse-definition st3

skip-claim-tokens : ParseState, Integer -> ParseState
skip-claim-tokens (st) (col) =
  if is-done st then st
  else if (current st).column <= col & is-claim-or-def-start (current-kind st) then st
  else skip-claim-tokens (advance st) col

is-claim-or-def-start : TokenKind -> Boolean
is-claim-or-def-start (k) =
  when k
   is Identifier -> True
   is TypeIdentifier -> True
   is ClaimKeyword -> True
   is ProofKeyword -> True
   is otherwise -> False

try-parse-def : ParseState -> ParseDefResult
try-parse-def (st) =
  if is-colon (peek-kind st 1) then let first-name = current st
  in let ann-result = parse-type-annotation st
  in unwrap-type-for-def first-name ann-result
  else parse-def-body-with-ann [] st

unwrap-type-for-def : Token, ParseTypeResult -> ParseDefResult
unwrap-type-for-def (first-name) (r) =
  when r
   is TypeOk (ann-type) (st) -> if is-equals (current-kind st) then let ann = deck-record [deck-record (TypeAnn {
     name = first-name,
     type-expr = ann-type
    })]
   in let st2 = advance st
   in let st3 = skip-newlines st2
   in let body-result = parse-expr-col st3 (first-name.column)
   in unwrap-def-body body-result ann first-name []
   else let name-tok = deck-record (Token {
     kind = Identifier,
     source = "",
     offset = 0,
     length = 0,
     line = 0,
     column = 0,
     file-id = 0
    })
   in let ann = deck-record [deck-record (TypeAnn {
     name = name-tok,
     type-expr = ann-type
    })]
   in let st2 = skip-newlines st
   in parse-def-body-with-ann ann st2

parse-def-body-with-ann : List TypeAnn, ParseState -> ParseDefResult
parse-def-body-with-ann (ann) (st) =
  let st-skip = if is-proof-keyword (current-kind st) then advance st
   else st
  in let name-tok = current st-skip
  in let st2 = advance st-skip
  in parse-def-params-then ann name-tok (__linked-list-empty 0) st2

parse-def-params-then : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
parse-def-params-then (ann) (name-tok) (acc) (st) =
  if is-left-paren (current-kind st) then parse-def-params-after-lparen ann name-tok acc (advance st)
  else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st

parse-def-params-after-lparen : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
parse-def-params-after-lparen (ann) (name-tok) (acc) (st) =
  if is-ident (current-kind st) then let param = current st
  in let st2 = expect RightParen (advance st)
  in parse-def-params-then ann name-tok (__linked-list-push acc param) st2
  else if is-reserved-keyword (current-kind st) then let st2 = report-reserved-keyword "a parameter name" st
  in let st3 = expect RightParen (advance st2)
  in parse-def-params-then ann name-tok acc st3
  else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st

finish-def : List TypeAnn, Token, List Token, ParseState -> ParseDefResult
finish-def (ann) (name-tok) (params) (st) =
  if is-equals (current-kind st) then let st2 = advance st
  in let st3 = skip-newlines st2
  in let body-result = parse-expr-col st3 (name-tok.column)
  in unwrap-def-body body-result ann name-tok params
  else let tok = current st
  in let err-st = expect Equals st
  in let st2 = skip-body-tokens err-st (name-tok.column)
  in ParseDefResult {
   maybe-def = Just (deck-record (Def {
    name = name-tok,
    params = params,
    ann = ann,
    body = ErrExpr tok,
    chapter-slug = ""
   })),
   state = st2
  }

unwrap-def-body : ParseExprResult, List TypeAnn, Token, List Token -> ParseDefResult
unwrap-def-body (r) (ann) (name-tok) (params) =
  when r
   is ExprOk (b) (st) -> ParseDefResult {
    maybe-def = Just (deck-record (Def {
     name = name-tok,
     params = params,
     ann = ann,
     body = b,
     chapter-slug = ""
    })),
    state = st
   }

is-paren-type-param : ParseState -> Boolean
is-paren-type-param (st) =
  if is-left-paren (current-kind st) then let k1 = peek-kind st 1
  in if is-ident k1 then is-right-paren (peek-kind st 2)
     else if is-type-ident k1 then is-right-paren (peek-kind st 2)
     else False
  else False

is-type-param-pattern : ParseState -> Boolean
is-type-param-pattern (st) =
  if is-paren-type-param st then True
  else is-ident (current-kind st)

parse-type-params : ParseState, LinkedList Token -> ParseState
parse-type-params (st) (acc) =
  if is-paren-type-param st then parse-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
  else if is-ident (current-kind st) then parse-type-params (advance st) (__linked-list-push acc (current st))
  else st

collect-type-params : ParseState, LinkedList Token -> List Token
collect-type-params (st) (acc) =
  if is-paren-type-param st then collect-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
  else if is-ident (current-kind st) then collect-type-params (advance st) (__linked-list-push acc (current st))
  else deck-record (__linked-list-to-list acc)

parse-type-def : ParseState -> ParseTypeDefResult
parse-type-def (st) =
  if is-mutable-keyword (current-kind st) then let st0 = advance st
  in parse-type-def-inner True st0
  else parse-type-def-inner False st

parse-type-def-inner : Boolean, ParseState -> ParseTypeDefResult
parse-type-def-inner (is-mut) (st) =
  if is-type-ident (current-kind st) then let name-tok = current st
  in let st2 = advance st
  in let tparams = collect-type-params st2 (__linked-list-empty 0)
  in let st3 = parse-type-params st2 (__linked-list-empty 0)
  in if is-equals (current-kind st3) then let st4 = skip-newlines (advance st3)
  in if is-record-keyword (current-kind st4) then parse-record-type name-tok tparams is-mut st4
     else if is-pipe (current-kind st4) then parse-variant-type name-tok tparams st4
     else if is-type-ident (current-kind st4) & looks-like-variant st4 then parse-variant-type name-tok tparams st4
     else ParseTypeDefResult {
   maybe-type-def = None,
   state = st
  }
     else ParseTypeDefResult {
   maybe-type-def = None,
   state = st
  }
  else ParseTypeDefResult {
   maybe-type-def = None,
   state = st
  }

parse-record-type : Token, List Token, Boolean, ParseState -> ParseTypeDefResult
parse-record-type (name-tok) (tparams) (is-mut) (st) =
  let st2 = advance st
  in let st3 = expect LeftBrace st2
  in let st4 = skip-newlines st3
  in parse-record-fields-loop name-tok tparams is-mut (__linked-list-empty 0) st4

parse-record-fields-loop : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
parse-record-fields-loop (name-tok) (tparams) (is-mut) (acc) (st) =
  if is-right-brace (current-kind st) then ParseTypeDefResult {
   maybe-type-def = Just (deck-record (TypeDef {
    name = name-tok,
    type-params = tparams,
    body = RecordBody (deck-record (__linked-list-to-list acc)),
    is-mutable = is-mut
   })),
   state = advance st
  }
  else if is-field-name-token (current-kind st) then parse-one-record-field name-tok tparams is-mut acc st
  else ParseTypeDefResult {
   maybe-type-def = Just (deck-record (TypeDef {
    name = name-tok,
    type-params = tparams,
    body = RecordBody (deck-record (__linked-list-to-list acc)),
    is-mutable = is-mut
   })),
   state = st
  }

parse-one-record-field : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
parse-one-record-field (name-tok) (tparams) (is-mut) (acc) (st) =
  let field-name = current st
  in let st2 = advance st
  in let st3 = expect Colon st2
  in let field-type-result = parse-type st3
  in unwrap-record-field-type name-tok tparams is-mut acc field-name field-type-result

unwrap-record-field-type : Token, List Token, Boolean, LinkedList RecordFieldDef, Token, ParseTypeResult -> ParseTypeDefResult
unwrap-record-field-type (name-tok) (tparams) (is-mut) (acc) (field-name) (r) =
  when r
   is TypeOk (ft) (st) -> let field = deck-record (RecordFieldDef {
     name = field-name,
     type-expr = ft
    })
   in let st2 = skip-newlines st
   in if is-comma (current-kind st2) then parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) (skip-newlines (advance st2))
      else parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) st2

looks-like-variant : ParseState -> Boolean
looks-like-variant (st) =
  looks-like-variant-scan (st.tokens) (st.pos + 1) (list-length (st.tokens))

looks-like-variant-scan : List Token, Integer, Integer -> Boolean
looks-like-variant-scan (tokens) (i) (len) =
  if i >= len then False
  else let k = (list-at tokens i).kind
  in if is-pipe k then True
     else when k
   is Newline -> False
   is EndOfFile -> False
   is otherwise -> looks-like-variant-scan tokens (i + 1) len

parse-variant-type : Token, List Token, ParseState -> ParseTypeDefResult
parse-variant-type (name-tok) (tparams) (st) =
  if is-type-ident (current-kind st) then let ctor-name = current st
  in let st2 = advance st
  in parse-ctor-fields ctor-name (__linked-list-empty 0) st2 name-tok tparams (__linked-list-empty 0)
  else parse-variant-ctors name-tok tparams (__linked-list-empty 0) st

parse-variant-ctors : Token, List Token, LinkedList VariantCtorDef, ParseState -> ParseTypeDefResult
parse-variant-ctors (name-tok) (tparams) (acc) (st) =
  if is-pipe (current-kind st) then let st2 = skip-newlines (advance st)
  in let ctor-name = current st2
  in let st3 = advance st2
  in parse-ctor-fields ctor-name (__linked-list-empty 0) st3 name-tok tparams acc
  else ParseTypeDefResult {
   maybe-type-def = Just (deck-record (TypeDef {
    name = name-tok,
    type-params = tparams,
    body = VariantBody (deck-record (__linked-list-to-list acc)),
    is-mutable = False
   })),
   state = st
  }

parse-ctor-fields : Token, LinkedList TypeExpr, ParseState, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
parse-ctor-fields (ctor-name) (fields) (st) (name-tok) (tparams) (acc) =
  if is-left-paren (current-kind st) then let field-result = parse-type (advance st)
  in unwrap-ctor-field field-result ctor-name fields name-tok tparams acc
  else let st2 = skip-newlines st
  in let ctor = deck-record (VariantCtorDef {
    name = ctor-name,
    fields = deck-record (__linked-list-to-list fields)
   })
  in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) st2

unwrap-ctor-field : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
unwrap-ctor-field (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =
  when r
   is TypeOk (ty) (st) -> let st2 = expect RightParen st
   in parse-ctor-fields ctor-name (__linked-list-push fields ty) st2 name-tok tparams acc

parse-document : ParseState -> Document
parse-document (st) =
  let st2 = skip-newlines st
  in let imp-result = parse-citations st2 "" (__linked-list-empty 0)
  in let doc = parse-top-level (__linked-list-empty 0) (__linked-list-empty 0) (__linked-list-empty 0) (imp-result.imports) "" (__linked-list-empty 0) (__linked-list-empty 0) (__linked-list-empty 0) (__linked-list-empty 0) (imp-result.state)
  in let ci = scan-class-instance-defs (make-parse-state (st.tokens) "") (__linked-list-empty 0) (__linked-list-empty 0)
  in __record-set (__record-set doc "class-defs" (ci.class-defs)) "instance-defs" (ci.instance-defs)

deck-copy-text : Text -> Text
deck-copy-text (t) =
  if text-length t == 0 then ""
  else deck-record (substring t 0 (text-length t))

collect-cite-title : ParseState, Text -> CiteTitleResult
collect-cite-title (st) (acc) =
  if is-done st then CiteTitleResult {
   title = deck-copy-text acc,
   state = st
  }
  else when current-kind st
   is Newline -> CiteTitleResult {
    title = deck-copy-text acc,
    state = st
   }
   is LeftParen -> CiteTitleResult {
    title = deck-copy-text acc,
    state = st
   }
   is otherwise -> let tok = current st
   in collect-cite-title (advance st) (join-title-parts acc (token-text tok))

parse-citations : ParseState, Text, LinkedList CitesDecl -> ImportParseResult
parse-citations (st) (citing) (acc) =
  if is-cites-keyword (current-kind st) then let st2 = advance st
  in let quire-tok = current st2
  in let st3 = advance st2
  in let st4 = advance st3
  in let title-result = collect-cite-title st4 ""
  in let st5 = title-result.state
  in if is-left-paren (current-kind st5) then let sel = parse-selected-names (advance st5) (__linked-list-empty 0)
  in let st6 = skip-newlines (sel.state)
  in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {
   quire = quire-tok,
   chapter-name = title-result.title,
   selected-names = sel.names,
   citing-chapter = citing
  })))
     else let st6 = skip-newlines st5
  in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {
   quire = quire-tok,
   chapter-name = title-result.title,
   selected-names = [],
   citing-chapter = citing
  })))
  else ImportParseResult {
   imports = deck-record (__linked-list-to-list acc),
   state = st
  }

parse-selected-names : ParseState, LinkedList Token -> SelectedNamesResult
parse-selected-names (st) (acc) =
  if is-ident (current-kind st) | is-type-ident (current-kind st) then let tok = current st
  in let st2 = advance st
  in let acc2 = __linked-list-push acc tok
  in if is-comma (current-kind st2) then parse-selected-names (skip-newlines (advance st2)) acc2
     else if is-right-paren (current-kind st2) then SelectedNamesResult {
   names = deck-record (__linked-list-to-list acc2),
   state = advance st2
  }
     else SelectedNamesResult {
   names = deck-record (__linked-list-to-list acc2),
   state = st2
  }
  else if is-right-paren (current-kind st) then SelectedNamesResult {
   names = deck-record (__linked-list-to-list acc),
   state = advance st
  }
  else SelectedNamesResult {
   names = deck-record (__linked-list-to-list acc),
   state = st
  }

is-chapter-header : ParseState -> Boolean
is-chapter-header (st) =
  if is-type-ident (current-kind st) then let tok = current st
  in if tok.length == 7 then if token-text tok == "Chapter" then is-colon (peek-kind st 1)
  else False
     else False
  else False

is-section-header : ParseState -> Boolean
is-section-header (st) =
  if is-type-ident (current-kind st) then let tok = current st
  in if tok.length == 7 then if token-text tok == "Section" then is-colon (peek-kind st 1)
  else False
     else False
  else False

is-page-number : TokenKind -> Boolean
is-page-number (k) =
  when k
   is IntegerLiteral -> True
   is otherwise -> False

is-page-marker : ParseState -> Boolean
is-page-marker (st) =
  if is-type-ident (current-kind st) then let tok = current st
  in if tok.length == 4 then if token-text tok == "Page" then is-page-number (peek-kind st 1)
  else False
     else False
  else False

extract-header-title : ParseState -> Text
extract-header-title (st) =
  let st2 = advance (advance st)
  in deck-copy-text (collect-title-tokens st2 "")

join-title-parts : Text, Text -> Text
join-title-parts (acc) (next) =
  if text-length acc == 0 then next
  else if text-length next == 0 then acc
  else let prev-last = char-code-at acc (text-length acc - 1)
  in let next-first = char-code-at next 0
  in if (is-letter-code prev-last | is-digit-code prev-last) & (is-letter-code next-first | is-digit-code next-first) then deck-record (acc & " " & next)
     else deck-record (acc & next)

collect-title-tokens : ParseState, Text -> Text
collect-title-tokens (st) (acc) =
  if is-done st then acc
  else when current-kind st
   is Newline -> acc
   is otherwise -> let tok = current st
   in collect-title-tokens (advance st) (join-title-parts acc (token-text tok))

is-prose-line : ParseState -> Boolean
is-prose-line (st) =
  (current st).column == 2

skip-body-lines : ParseState -> ParseState
skip-body-lines (st) =
  let st2 = skip-newlines st
  in if is-done st2 then st2
     else if (current st2).column >= 3 then skip-body-lines (skip-to-next-line st2)
     else st2

skip-prose-lines : ParseState -> ParseState
skip-prose-lines (st) =
  let st2 = skip-newlines st
  in if is-done st2 then st2
     else if is-prose-line st2 then skip-prose-lines (skip-to-next-line st2)
     else if (current st2).column > 3 then skip-prose-lines (skip-to-next-line st2)
     else st2

is-prose-token : ParseState -> Boolean
is-prose-token (st) =
  current-kind st == ProseText

classify-transition : Text -> ProseTransition
classify-transition (line) =
  if text-contains line "We say:" then PtWeSay
  else if text-contains line "This is written:" then PtThisIsWritten
  else PtNone

extract-template-name : Text, Text -> Text
extract-template-name (line) (marker) =
  let parts = text-split line marker
  in if list-length parts < 1 then ""
     else let prefix = list-at parts 0
  in let words = text-split prefix " "
  in extract-last-word words (list-length words)

extract-last-word : List Text, Integer -> Text
extract-last-word (words) (len) =
  if len == 0 then ""
  else let w = list-at words (len - 1)
  in if text-length w == 0 then extract-last-word words (len - 1)
     else w

extract-function-name : Text -> Text
extract-function-name (line) =
  let parts = text-split line " "
  in if list-length parts < 2 then ""
     else let second = list-at parts 1
  in if text-length second == 0 then ""
     else second

classify-template : Text -> ProseTemplate
classify-template (line) =
  if text-contains line "is a record containing:" then PtRecordTemplate (extract-template-name line "is a record containing:")
  else if text-contains line "is one of:" then PtVariantTemplate (extract-template-name line "is one of:")
  else if text-contains line "is either:" then PtVariantTemplate (extract-template-name line "is either:")
  else if text-starts-with line "To " then PtFunctionTemplate (extract-function-name line)
  else if text-starts-with line "such that " then PtConstraintTemplate
  else if text-starts-with line "where " then PtConstraintTemplate
  else if text-starts-with line "provided that " then PtConstraintTemplate
  else if text-starts-with line "claim:" then PtProofTemplate
  else if text-starts-with line "Claim:" then PtProofTemplate
  else if text-starts-with line "therefore," then PtProofTemplate
  else if text-starts-with line "it follows that " then PtProofTemplate
  else if text-starts-with line "first," then PtProcedureTemplate
  else if text-starts-with line "First," then PtProcedureTemplate
  else if text-starts-with line "then," then PtProcedureTemplate
  else if text-starts-with line "Then," then PtProcedureTemplate
  else if text-starts-with line "finally," then PtProcedureTemplate
  else if text-starts-with line "Finally," then PtProcedureTemplate
  else if text-starts-with line "for every " then PtQuantifiedTemplate
  else if text-starts-with line "For every " then PtQuantifiedTemplate
  else if text-starts-with line "there exists " then PtQuantifiedTemplate
  else if text-starts-with line "There exists " then PtQuantifiedTemplate
  else if text-starts-with line "no " then PtQuantifiedTemplate
  else PtNoTemplate

classify-prose-line : Text -> ProseBlock
classify-prose-line (line) =
  deck-record (ProseBlock {
   text = line,
   transition = classify-transition line,
   template = classify-template line
  })

collect-prose-with-text : ParseState, LinkedList Text, LinkedList ProseBlock -> CollectProseResult
collect-prose-with-text (st) (acc) (blk-acc) =
  let st2 = skip-newlines st
  in if is-done st2 then CollectProseResult {
   state = st2,
   lines = acc,
   blocks = blk-acc
  }
     else if is-prose-token st2 then let txt = token-text (current st2)
  in let block = classify-prose-line txt
  in collect-prose-with-text (skip-to-next-line (advance st2)) (__linked-list-push acc (txt & "\n")) (__linked-list-push blk-acc block)
     else if is-prose-line st2 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
     else if (current st2).column > 3 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
     else CollectProseResult {
   state = st2,
   lines = acc,
   blocks = blk-acc
  }

skip-to-next-line : ParseState -> ParseState
skip-to-next-line (st) =
  if is-done st then st
  else when current-kind st
   is Newline -> advance st
   is otherwise -> skip-to-next-line (advance st)

is-at-sign : ParseState -> Boolean
is-at-sign (st) =
  current-kind st == AtSign

parse-annotation-line : ParseState -> AnnotationNode
parse-annotation-line (st) =
  let st1 = advance st
  in let kind-text = if is-done st1 then ""
   else token-text (current st1)
  in let st2 = if is-done st1 then st1
   else advance st1
  in let target-text = if is-done st2 then ""
   else token-text (current st2)
  in let st3 = if is-done st2 then st2
   else advance st2
  in let body-text = if is-done st3 then ""
   else token-text (current st3)
  in deck-record (AnnotationNode {
   kind = kind-text,
   target = target-text,
   body = body-text
  })

parse-top-level : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
parse-top-level (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
  if is-done st then let prose-text = deck-record (text-concat-list (deck-record (__linked-list-to-list prose)))
  in deck-record (Document {
   defs = deck-record (__linked-list-to-list defs),
   type-defs = deck-record (__linked-list-to-list type-defs),
   effect-defs = deck-record (__linked-list-to-list effect-defs),
   class-defs = [],
   instance-defs = [],
   citations = imports,
   chapter-title = ch-title,
   section-titles = deck-record (__linked-list-to-list sec-titles),
   prose = prose-text,
   prose-blocks = deck-record (__linked-list-to-list blocks),
   annotations = deck-record (__linked-list-to-list anns),
   parse-bag = st.bag
  })
  else if is-chapter-header st then let title = extract-header-title st
  in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
  in parse-top-level defs type-defs effect-defs imports title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
  else if is-section-header st then let title = extract-header-title st
  in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
  in parse-top-level defs type-defs effect-defs imports ch-title (__linked-list-push sec-titles title) (pr.lines) (pr.blocks) anns (pr.state)
  else if is-page-marker st then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
  else if is-cites-keyword (current-kind st) then let cite-result = parse-citations st ch-title (__linked-list-empty 0)
  in parse-top-level defs type-defs effect-defs (deck-record (imports & cite-result.imports)) ch-title sec-titles prose blocks anns (cite-result.state)
  else if is-effect-keyword (current-kind st) then parse-top-level-effect defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
  else if is-class-keyword (current-kind st) then let st-c1 = advance st
  in let st-c2 = advance st-c1
  in let st-c3 = if is-where-keyword (current-kind st-c2) then skip-newlines (advance st-c2)
   else st-c2
  in let ops = parse-effect-ops st-c3 (__linked-list-empty 0)
  in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (ops.state))
  else if is-instance-keyword (current-kind st) then let st-i1 = advance st
  in let st-i2 = advance st-i1
  in let st-i3 = advance st-i2
  in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3)
   else st-i3
  in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-body-lines st-i4)
  else if is-at-sign st then let ann = parse-annotation-line st
  in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns ann) (skip-to-next-line st)
  else if is-claim-keyword (current-kind st) then if is-simple-claim st then try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (advance st)
  else let claim-ann = parse-claim-annotation st
  in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns claim-ann) (skip-to-next-line st)
  else if is-proof-keyword (current-kind st) then try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (advance st)
  else if is-prose-line st then let pr = collect-prose-with-text st prose blocks
  in parse-top-level defs type-defs effect-defs imports ch-title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
  else if (current st).column > 3 then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
  else try-top-level-type-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st

parse-top-level-effect : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
parse-top-level-effect (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
  let st1 = advance st
  in let name-tok = current st1
  in let st2 = advance st1
  in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2)
   else st2
  in let ops = parse-effect-ops st3 (__linked-list-empty 0)
  in let ed = deck-record (EffectDef {
    name = name-tok,
    ops = ops.ops
   })
  in parse-top-level defs type-defs (__linked-list-push effect-defs ed) imports ch-title sec-titles prose blocks anns (skip-newlines (ops.state))

parse-effect-ops : ParseState, LinkedList EffectOpDef -> EffectOpsResult
parse-effect-ops (st) (acc) =
  if is-ident (current-kind st) then if is-colon (peek-kind st 1) then let op-tok = current st
  in let st2 = advance (advance st)
  in let type-result = parse-type st2
  in when type-result
   is TypeOk (ty) (st3) -> let op = deck-record (EffectOpDef {
     name = op-tok,
     type-expr = ty
    })
   in parse-effect-ops (skip-newlines st3) (__linked-list-push acc op)
  else EffectOpsResult {
   ops = deck-record (__linked-list-to-list acc),
   state = st
  }
  else EffectOpsResult {
   ops = deck-record (__linked-list-to-list acc),
   state = st
  }

scan-class-instance-defs : ParseState, LinkedList ClassDef, LinkedList InstanceDef -> ClassDefsResult
scan-class-instance-defs (st) (cacc) (iacc) =
  if is-done st then ClassDefsResult {
   class-defs = deck-record (__linked-list-to-list cacc),
   instance-defs = deck-record (__linked-list-to-list iacc)
  }
  else if is-class-keyword (current-kind st) then let st1 = advance st
  in let name-tok = current st1
  in let st2 = advance st1
  in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2)
   else st2
  in let ops = parse-effect-ops st3 (__linked-list-empty 0)
  in let cd = deck-record (ClassDef {
    name = name-tok,
    methods = ops.ops
   })
  in scan-class-instance-defs (skip-newlines (ops.state)) (__linked-list-push cacc cd) iacc
  else if is-instance-keyword (current-kind st) then let st1 = advance st
  in let class-tok = current st1
  in let st2 = advance st1
  in let type-tok = current st2
  in let st3 = advance st2
  in let st4 = if is-where-keyword (current-kind st3) then skip-newlines (advance st3)
   else st3
  in let methods = parse-instance-methods st4 (__linked-list-empty 0)
  in let id = deck-record (InstanceDef {
    class-name = class-tok,
    type-name = type-tok,
    methods = methods.defs
   })
  in scan-class-instance-defs (skip-newlines (methods.state)) cacc (__linked-list-push iacc id)
  else scan-class-instance-defs (advance st) cacc iacc

finish-instance-methods : LinkedList InstanceMethodDef, ParseState -> InstanceMethodsResult
finish-instance-methods (acc) (st) =
  InstanceMethodsResult {
   defs = deck-record (__linked-list-to-list acc),
   state = st
  }

parse-instance-methods : ParseState, LinkedList InstanceMethodDef -> InstanceMethodsResult
parse-instance-methods (st) (acc) =
  if is-ident (current-kind st) then let name-tok = current st
  in let st2 = advance st
  in let params-result = parse-instance-params st2 (__linked-list-empty 0)
  in if is-equals (current-kind (params-result.state)) then let st3 = skip-newlines (advance (params-result.state))
  in let expr-result = parse-expr st3
  in when expr-result
   is ExprOk (body) (st4) -> let md = deck-record (InstanceMethodDef {
     name = name-tok,
     params = params-result.params,
     body = body
    })
   in parse-instance-methods (skip-newlines st4) (__linked-list-push acc md)
     else finish-instance-methods acc st
  else finish-instance-methods acc st

parse-instance-params : ParseState, LinkedList Token -> InstanceParamsResult
parse-instance-params (st) (acc) =
  if is-left-paren (current-kind st) then let st2 = advance st
  in let p = current st2
  in let st3 = advance st2
  in let st4 = if is-right-paren (current-kind st3) then advance st3
   else st3
  in parse-instance-params st4 (__linked-list-push acc p)
  else InstanceParamsResult {
   params = deck-record (__linked-list-to-list acc),
   state = st
  }

try-top-level-type-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
try-top-level-type-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
  let td-result = parse-type-def st
  in let st2 = td-result.state
  in when td-result.maybe-type-def
   is Just (td) -> parse-top-level defs (__linked-list-push type-defs td) effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)
   is None -> try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st

try-top-level-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
try-top-level-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
  let def-result = parse-definition st
  in let st2 = def-result.state
  in when def-result.maybe-def
   is Just (d) -> let tagged = deck-record (Def {
     name = d.name,
     params = d.params,
     ann = d.ann,
     body = d.body,
     chapter-slug = ch-title
    })
   in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)
   is None -> parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance st2))

check-prose-record : Text, List RecordFieldDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-prose-record (template-name) (fields) (i) (len) (acc) =
  if i >= len then acc
  else check-prose-record template-name fields (i + 1) len acc

check-prose-variant : Text, List VariantCtorDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-prose-variant (template-name) (ctors) (i) (len) (acc) =
  if i >= len then acc
  else check-prose-variant template-name ctors (i + 1) len acc

check-prose-function : Text, List Def, List Diagnostic -> List Diagnostic
check-prose-function (template-name) (defs) (acc) =
  if list-length defs == 0 then acc
  else let first-def = list-at defs 0
  in let def-name = token-text (first-def.name)
  in if template-name == def-name then acc
     else list-push acc (make-warning cdx-prose-function-name-mismatch ("Prose declares function '" & template-name & "' but notation defines '" & def-name & "'") synthetic-span)

check-prose-block-against-defs : ProseBlock, List Def, List TypeDef, List Diagnostic -> List Diagnostic
check-prose-block-against-defs (block) (defs) (type-defs) (acc) =
  when block.template
   is PtFunctionTemplate (name) -> check-prose-function name defs acc
   is PtRecordTemplate (name) -> acc
   is PtVariantTemplate (name) -> acc
   is PtNoTemplate -> acc
   is PtConstraintTemplate -> acc
   is PtProofTemplate -> acc
   is PtProcedureTemplate -> acc
   is PtQuantifiedTemplate -> acc

check-prose-consistency : Document -> List Diagnostic
check-prose-consistency (doc) =
  check-prose-blocks-loop (doc.prose-blocks) (doc.defs) (doc.type-defs) 0 (list-length (doc.prose-blocks)) []

check-prose-blocks-loop : List ProseBlock, List Def, List TypeDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-prose-blocks-loop (blocks) (defs) (type-defs) (i) (len) (acc) =
  if i >= len then acc
  else let block = list-at blocks i
  in check-prose-blocks-loop blocks defs type-defs (i + 1) len (check-prose-block-against-defs block defs type-defs acc)

banned-words : List BannedWord
banned-words =
  [BannedWord {
   word = " it ",
   substitute = "the named value"
  }, BannedWord {
   word = " this ",
   substitute = "the named value"
  }, BannedWord {
   word = " they ",
   substitute = "the named collection"
  }, BannedWord {
   word = " some ",
   substitute = "a quantifier (all, every, exactly one, ...)"
  }, BannedWord {
   word = " many ",
   substitute = "a quantifier or explicit bound"
  }, BannedWord {
   word = " few ",
   substitute = "a quantifier or explicit bound"
  }, BannedWord {
   word = " etc.",
   substitute = "exhaust the list or use a type"
  }, BannedWord {
   word = " etc ",
   substitute = "exhaust the list or use a type"
  }, BannedWord {
   word = " so ",
   substitute = "'therefore' or 'in order to'"
  }, BannedWord {
   word = " since ",
   substitute = "'because' (causal) or 'after' (temporal)"
  }, BannedWord {
   word = " while ",
   substitute = "'during' or 'at the same time as'"
  }, BannedWord {
   word = " may ",
   substitute = "'can' (possibility) or 'is permitted to' (permission)"
  }, BannedWord {
   word = " might ",
   substitute = "'can' (possibility) or 'is permitted to' (permission)"
  }, BannedWord {
   word = " should ",
   substitute = "'must' (obligation) or 'is recommended to' (recommendation)"
  }]

check-banned-word : Text, BannedWord -> Maybe Diagnostic
check-banned-word (line) (bw) =
  if text-contains line (bw.word) then Just (make-warning cdx-prose-banned-word ("Banned word '" & bw.word & "' in load-bearing prose; use " & bw.substitute) synthetic-span)
  else None

check-banned-words-in-line : Text, List BannedWord, Integer, Integer, List Diagnostic -> List Diagnostic
check-banned-words-in-line (line) (words) (i) (len) (acc) =
  if i >= len then acc
  else let bw = list-at words i
  in when check-banned-word line bw
   is Just (d) -> check-banned-words-in-line line words (i + 1) len (list-push acc d)
   is None -> check-banned-words-in-line line words (i + 1) len acc

check-banned-in-blocks : List ProseBlock, Integer, Integer, Boolean, List Diagnostic -> List Diagnostic
check-banned-in-blocks (blocks) (i) (len) (in-we-say) (acc) =
  if i >= len then acc
  else let block = list-at blocks i
  in let now-in-we-say = when block.transition
    is PtWeSay -> True
    is PtThisIsWritten -> True
    is PtNone -> in-we-say
  in if now-in-we-say then let diags = check-banned-words-in-line (block.text) banned-words 0 (list-length banned-words) acc
  in check-banned-in-blocks blocks (i + 1) len now-in-we-say diags
     else check-banned-in-blocks blocks (i + 1) len now-in-we-say acc

check-prose-banned : Document -> List Diagnostic
check-prose-banned (doc) =
  check-banned-in-blocks (doc.prose-blocks) 0 (list-length (doc.prose-blocks)) False []

scan-document : ParseState -> ScanResult
scan-document (st) =
  let st2 = skip-newlines st
  in let imp-result = parse-citations st2 "" (__linked-list-empty 0)
  in scan-top-level (__linked-list-empty 0) (__linked-list-empty 0) (__linked-list-empty 0) (imp-result.imports) "" "" (__linked-list-empty 0) (imp-result.state)

scan-top-level : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, ParseState -> ScanResult
scan-top-level (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (st) =
  if is-done st then deck-record (ScanResult {
   type-defs = deck-record (__linked-list-to-list type-defs),
   effect-defs = deck-record (__linked-list-to-list effect-defs),
   class-defs = [],
   instance-defs = [],
   def-headers = deck-record (__linked-list-to-list headers),
   citations = imports,
   chapter-title = ch-title,
   section-titles = deck-record (__linked-list-to-list sec-titles)
  })
  else if is-chapter-header st then let title = extract-header-title st
  in scan-top-level headers type-defs effect-defs imports title title sec-titles (skip-prose-lines (skip-to-next-line st))
  else if is-section-header st then let title = extract-header-title st
  in scan-top-level headers type-defs effect-defs imports cur-chap ch-title (__linked-list-push sec-titles title) (skip-prose-lines (skip-to-next-line st))
  else if is-page-marker st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-to-next-line st)
  else if is-cites-keyword (current-kind st) then let cite-result = parse-citations st cur-chap (__linked-list-empty 0)
  in scan-top-level headers type-defs effect-defs (deck-record (imports & cite-result.imports)) cur-chap ch-title sec-titles (cite-result.state)
  else if is-effect-keyword (current-kind st) then scan-top-level-effect headers type-defs effect-defs imports cur-chap ch-title sec-titles st
  else if is-class-keyword (current-kind st) then let st-c1 = advance st
  in let st-c2 = advance st-c1
  in let st-c3 = if is-where-keyword (current-kind st-c2) then skip-newlines (advance st-c2)
   else st-c2
  in let ops = parse-effect-ops st-c3 (__linked-list-empty 0)
  in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-newlines (ops.state))
  else if is-instance-keyword (current-kind st) then let st-i1 = advance st
  in let st-i2 = advance st-i1
  in let st-i3 = advance st-i2
  in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3)
   else st-i3
  in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-body-lines st-i4)
  else if is-prose-line st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-prose-lines st)
  else if (current st).column > 3 then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-to-next-line st)
  else try-scan-type-def headers type-defs effect-defs imports cur-chap ch-title sec-titles st

scan-top-level-effect : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, ParseState -> ScanResult
scan-top-level-effect (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (st) =
  let st1 = advance st
  in let name-tok = current st1
  in let st2 = advance st1
  in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2)
   else st2
  in let ops = parse-effect-ops st3 (__linked-list-empty 0)
  in let ed = deck-record (EffectDef {
    name = name-tok,
    ops = ops.ops
   })
  in scan-top-level headers type-defs (__linked-list-push effect-defs ed) imports cur-chap ch-title sec-titles (skip-newlines (ops.state))

try-scan-type-def : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, ParseState -> ScanResult
try-scan-type-def (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (st) =
  let td-result = parse-type-def st
  in let st2 = td-result.state
  in when td-result.maybe-type-def
   is Just (td) -> scan-top-level headers (__linked-list-push type-defs td) effect-defs imports cur-chap ch-title sec-titles (skip-newlines st2)
   is None -> try-scan-def-header headers type-defs effect-defs imports cur-chap ch-title sec-titles st

try-scan-def-header : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, ParseState -> ScanResult
try-scan-def-header (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (st) =
  let hdr-result = scan-definition cur-chap st
  in let st2 = hdr-result.state
  in when hdr-result.maybe-header
   is Just (hdr) -> scan-top-level (__linked-list-push headers hdr) type-defs effect-defs imports cur-chap ch-title sec-titles (skip-newlines st2)
   is None -> scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles (skip-newlines (advance st2))

scan-definition : Text, ParseState -> ScanDefResult
scan-definition (cur-chap) (st) =
  if is-done st then ScanDefResult {
   maybe-header = None,
   state = st
  }
  else if is-ident (current-kind st) then try-scan-def cur-chap st
  else if is-type-ident (current-kind st) then try-scan-def cur-chap st
  else ScanDefResult {
   maybe-header = None,
   state = st
  }

try-scan-def : Text, ParseState -> ScanDefResult
try-scan-def (cur-chap) (st) =
  if is-colon (peek-kind st 1) then let first-name = current st
  in let ann-result = parse-type-annotation st
  in unwrap-type-for-scan cur-chap first-name ann-result
  else scan-def-body-with-ann cur-chap [] st

unwrap-type-for-scan : Text, Token, ParseTypeResult -> ScanDefResult
unwrap-type-for-scan (cur-chap) (first-name) (r) =
  when r
   is TypeOk (ann-type) (st) -> if is-equals (current-kind st) then let ann = deck-record [deck-record (TypeAnn {
     name = first-name,
     type-expr = ann-type
    })]
   in let st2 = advance st
   in let st3 = skip-newlines st2
   in let body-pos = st3.pos
   in let st4 = skip-body-tokens st3 (first-name.column)
   in ScanDefResult {
    maybe-header = Just (deck-record (DefHeader {
     name = first-name,
     params = [],
     ann = ann,
     body-pos = body-pos,
     chapter-slug = cur-chap
    })),
    state = st4
   }
   else let name-tok = deck-record (Token {
     kind = Identifier,
     source = "",
     offset = 0,
     length = 0,
     line = 0,
     column = 0,
     file-id = 0
    })
   in let ann = deck-record [deck-record (TypeAnn {
     name = name-tok,
     type-expr = ann-type
    })]
   in let st2 = skip-newlines st
   in scan-def-body-with-ann cur-chap ann st2

scan-def-body-with-ann : Text, List TypeAnn, ParseState -> ScanDefResult
scan-def-body-with-ann (cur-chap) (ann) (st) =
  let name-tok = current st
  in let st2 = advance st
  in scan-def-params-then cur-chap ann name-tok (__linked-list-empty 0) st2

scan-def-params-then : Text, List TypeAnn, Token, LinkedList Token, ParseState -> ScanDefResult
scan-def-params-then (cur-chap) (ann) (name-tok) (acc) (st) =
  if is-left-paren (current-kind st) then let st2 = advance st
  in if is-ident (current-kind st2) then let param = current st2
  in let st3 = advance st2
  in let st4 = expect RightParen st3
  in scan-def-params-then cur-chap ann name-tok (__linked-list-push acc param) st4
     else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st
  else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st

finish-def-scan : Text, List TypeAnn, Token, List Token, ParseState -> ScanDefResult
finish-def-scan (cur-chap) (ann) (name-tok) (params) (st) =
  if is-equals (current-kind st) == False then ScanDefResult {
   maybe-header = None,
   state = st
  }
  else let st2 = advance st
  in let st3 = skip-newlines st2
  in let body-pos = st3.pos
  in let st4 = skip-body-tokens st3 (name-tok.column)
  in ScanDefResult {
   maybe-header = Just (deck-record (DefHeader {
    name = name-tok,
    params = params,
    ann = ann,
    body-pos = body-pos,
    chapter-slug = cur-chap
   })),
   state = st4
  }

skip-body-tokens : ParseState, Integer -> ParseState
skip-body-tokens (st) (name-col) =
  if is-done st then st
  else let tok = current st
  in when tok.kind
   is Newline -> skip-body-tokens (advance st) name-col
   is Indent -> skip-body-tokens (advance st) name-col
   is Dedent -> skip-body-tokens (advance st) name-col
   is otherwise -> if tok.column <= name-col then st
   else skip-body-tokens (advance st) name-col

make-parse-state : List Token, Text -> ParseState
make-parse-state (toks) (source) =
  ParseState {
   tokens = toks,
   pos = 0,
   bag = empty-bag,
   paren-depth = 0,
   fuel = max-parse-fuel
  }

current : ParseState -> Token
current (st) =
  list-at (st.tokens) (st.pos)

current-kind : ParseState -> TokenKind
current-kind (st) =
  (current st).kind

advance : ParseState -> ParseState
advance (st) =
  if st.pos >= list-length (st.tokens) - 1 then st
  else ParseState {
   tokens = st.tokens,
   pos = st.pos + 1,
   bag = st.bag,
   paren-depth = st.paren-depth,
   fuel = st.fuel
  }

parse-fuel-exhausted : ParseState -> Boolean
parse-fuel-exhausted (st) =
  st.fuel <= 0

consume-parse-fuel : ParseState -> ParseState
consume-parse-fuel (st) =
  __record-set st "fuel" (st.fuel - 1)

emit-parse-fuel-error : ParseState, Text -> ParseState
emit-parse-fuel-error (st) (op) =
  __record-set st "bag" (bag-add (st.bag) (make-error cdx-resource-exhausted ("compiler resource exhausted in parser." & op & " (budget " & integer-to-text max-parse-fuel & ")") (token-to-span (current st))))

token-to-span : Token -> SourceSpan
token-to-span (tok) =
  span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id)

enter-paren : ParseState -> ParseState
enter-paren (st) =
  __record-set st "paren-depth" (st.paren-depth + 1)

exit-paren : ParseState -> ParseState
exit-paren (st) =
  __record-set st "paren-depth" (st.paren-depth - 1)

is-done : ParseState -> Boolean
is-done (st) =
  when current-kind st
   is EndOfFile -> True
   is otherwise -> False

peek-kind : ParseState, Integer -> TokenKind
peek-kind (st) (offset) =
  let idx = st.pos + offset
  in if idx >= list-length (st.tokens) then EndOfFile
     else (list-at (st.tokens) idx).kind

is-ident : TokenKind -> Boolean
is-ident (k) =
  when k
   is Identifier -> True
   is otherwise -> False

is-ident-like : TokenKind -> Boolean
is-ident-like (k) =
  when k
   is Identifier -> True
   is ActKeyword -> True
   is EndKeyword -> True
   is QedKeyword -> True
   is otherwise -> False

is-field-name-token : TokenKind -> Boolean
is-field-name-token (k) =
  when k
   is Identifier -> True
   is ActKeyword -> True
   is EndKeyword -> True
   is QedKeyword -> True
   is EffectKeyword -> True
   is WhereKeyword -> True
   is WithKeyword -> True
   is LinearKeyword -> True
   is ClaimKeyword -> True
   is ProofKeyword -> True
   is RecordKeyword -> True
   is otherwise -> False

is-type-ident : TokenKind -> Boolean
is-type-ident (k) =
  when k
   is TypeIdentifier -> True
   is otherwise -> False

is-arrow : TokenKind -> Boolean
is-arrow (k) =
  when k
   is Arrow -> True
   is otherwise -> False

is-equals : TokenKind -> Boolean
is-equals (k) =
  when k
   is Equals -> True
   is otherwise -> False

is-colon : TokenKind -> Boolean
is-colon (k) =
  when k
   is Colon -> True
   is otherwise -> False

is-plus-plus : TokenKind -> Boolean
is-plus-plus (k) =
  when k
   is PlusPlus -> True
   is otherwise -> False

is-comma : TokenKind -> Boolean
is-comma (k) =
  when k
   is Comma -> True
   is otherwise -> False

is-pipe : TokenKind -> Boolean
is-pipe (k) =
  when k
   is Pipe -> True
   is otherwise -> False

is-pipe-forward : TokenKind -> Boolean
is-pipe-forward (k) =
  when k
   is PipeForward -> True
   is otherwise -> False

is-dot : TokenKind -> Boolean
is-dot (k) =
  when k
   is Dot -> True
   is otherwise -> False

is-text-lit : TokenKind -> Boolean
is-text-lit (k) =
  when k
   is TextLiteral -> True
   is otherwise -> False

is-left-paren : TokenKind -> Boolean
is-left-paren (k) =
  when k
   is LeftParen -> True
   is otherwise -> False

is-left-brace : TokenKind -> Boolean
is-left-brace (k) =
  when k
   is LeftBrace -> True
   is otherwise -> False

is-left-bracket : TokenKind -> Boolean
is-left-bracket (k) =
  when k
   is LeftBracket -> True
   is otherwise -> False

is-right-brace : TokenKind -> Boolean
is-right-brace (k) =
  when k
   is RightBrace -> True
   is otherwise -> False

is-right-bracket : TokenKind -> Boolean
is-right-bracket (k) =
  when k
   is RightBracket -> True
   is otherwise -> False

is-right-paren : TokenKind -> Boolean
is-right-paren (k) =
  when k
   is RightParen -> True
   is otherwise -> False

is-if-keyword : TokenKind -> Boolean
is-if-keyword (k) =
  when k
   is IfKeyword -> True
   is otherwise -> False

is-is-keyword : TokenKind -> Boolean
is-is-keyword (k) =
  when k
   is IsKeyword -> True
   is otherwise -> False

is-match-arm-start : TokenKind -> Boolean
is-match-arm-start (k) =
  is-is-keyword k

is-otherwise-keyword : TokenKind -> Boolean
is-otherwise-keyword (k) =
  when k
   is OtherwiseKeyword -> True
   is otherwise -> False

is-wildcard-pat : TokenKind -> Boolean
is-wildcard-pat (k) =
  is-otherwise-keyword k

is-let-keyword : TokenKind -> Boolean
is-let-keyword (k) =
  when k
   is LetKeyword -> True
   is otherwise -> False

is-when-keyword : TokenKind -> Boolean
is-when-keyword (k) =
  when k
   is WhenKeyword -> True
   is InductionKeyword -> True
   is otherwise -> False

is-claim-keyword : TokenKind -> Boolean
is-claim-keyword (k) =
  when k
   is ClaimKeyword -> True
   is otherwise -> False

is-proof-keyword : TokenKind -> Boolean
is-proof-keyword (k) =
  when k
   is ProofKeyword -> True
   is otherwise -> False

is-act-keyword : TokenKind -> Boolean
is-act-keyword (k) =
  when k
   is ActKeyword -> True
   is otherwise -> False

is-end-keyword : TokenKind -> Boolean
is-end-keyword (k) =
  when k
   is EndKeyword -> True
   is otherwise -> False

is-with-keyword : TokenKind -> Boolean
is-with-keyword (k) =
  when k
   is WithKeyword -> True
   is otherwise -> False

is-with-timeout-keyword : TokenKind -> Boolean
is-with-timeout-keyword (k) =
  when k
   is WithTimeoutKeyword -> True
   is otherwise -> False

is-trying-keyword : TokenKind -> Boolean
is-trying-keyword (k) =
  when k
   is TryingKeyword -> True
   is otherwise -> False

is-effect-keyword : TokenKind -> Boolean
is-effect-keyword (k) =
  when k
   is EffectKeyword -> True
   is otherwise -> False

is-class-keyword : TokenKind -> Boolean
is-class-keyword (k) =
  when k
   is ClassKeyword -> True
   is otherwise -> False

is-instance-keyword : TokenKind -> Boolean
is-instance-keyword (k) =
  when k
   is InstanceKeyword -> True
   is otherwise -> False

is-fat-arrow : TokenKind -> Boolean
is-fat-arrow (k) =
  when k
   is FatArrow -> True
   is otherwise -> False

is-cites-keyword : TokenKind -> Boolean
is-cites-keyword (k) =
  when k
   is CitesKeyword -> True
   is otherwise -> False

is-where-keyword : TokenKind -> Boolean
is-where-keyword (k) =
  when k
   is WhereKeyword -> True
   is otherwise -> False

is-in-keyword : TokenKind -> Boolean
is-in-keyword (k) =
  when k
   is InKeyword -> True
   is otherwise -> False

is-between-keyword : TokenKind -> Boolean
is-between-keyword (k) =
  when k
   is BetweenKeyword -> True
   is otherwise -> False

is-else-keyword : TokenKind -> Boolean
is-else-keyword (k) =
  when k
   is ElseKeyword -> True
   is otherwise -> False

is-reserved-keyword : TokenKind -> Boolean
is-reserved-keyword (k) =
  when k
   is LetKeyword -> True
   is InKeyword -> True
   is BetweenKeyword -> True
   is IfKeyword -> True
   is IsKeyword -> True
   is OtherwiseKeyword -> True
   is ThenKeyword -> True
   is ElseKeyword -> True
   is WhenKeyword -> True
   is WhereKeyword -> True
   is SuchThatKeyword -> True
   is ActKeyword -> True
   is EndKeyword -> True
   is RecordKeyword -> True
   is CitesKeyword -> True
   is ClaimKeyword -> True
   is ProofKeyword -> True
   is QedKeyword -> True
   is InductionKeyword -> True
   is ForAllKeyword -> True
   is ThereExistsKeyword -> True
   is LinearKeyword -> True
   is MutableKeyword -> True
   is EffectKeyword -> True
   is WithKeyword -> True
   is TrueKeyword -> True
   is FalseKeyword -> True
   is otherwise -> False

is-minus : TokenKind -> Boolean
is-minus (k) =
  when k
   is Minus -> True
   is otherwise -> False

is-dedent : TokenKind -> Boolean
is-dedent (k) =
  when k
   is Dedent -> True
   is otherwise -> False

is-left-arrow : TokenKind -> Boolean
is-left-arrow (k) =
  when k
   is LeftArrow -> True
   is otherwise -> False

is-mutable-keyword : TokenKind -> Boolean
is-mutable-keyword (k) =
  when k
   is MutableKeyword -> True
   is otherwise -> False

is-record-keyword : TokenKind -> Boolean
is-record-keyword (k) =
  when k
   is RecordKeyword -> True
   is otherwise -> False

is-underscore : TokenKind -> Boolean
is-underscore (k) =
  when k
   is Underscore -> True
   is otherwise -> False

is-backslash : TokenKind -> Boolean
is-backslash (k) =
  when k
   is Backslash -> True
   is otherwise -> False

is-literal : TokenKind -> Boolean
is-literal (k) =
  when k
   is IntegerLiteral -> True
   is NumberLiteral -> True
   is TextLiteral -> True
   is CharLiteral -> True
   is TrueKeyword -> True
   is FalseKeyword -> True
   is otherwise -> False

is-app-start : TokenKind -> Boolean
is-app-start (k) =
  when k
   is Identifier -> True
   is TypeIdentifier -> True
   is IntegerLiteral -> True
   is NumberLiteral -> True
   is TextLiteral -> True
   is CharLiteral -> True
   is TrueKeyword -> True
   is FalseKeyword -> True
   is LeftParen -> True
   is LeftBracket -> True
   is ActKeyword -> True
   is WithKeyword -> True
   is otherwise -> False

is-compound : Expr -> Boolean
is-compound (e) =
  when e
   is MatchExpr (s) (arms) -> True
   is IfExpr (c) (t) (el) -> True
   is LetExpr (binds) (body) -> True
   is ActExpr (stmts) -> True
   is FieldAssignExpr (l) (f) (r) -> True
   is otherwise -> False

is-type-arg-start : TokenKind -> Boolean
is-type-arg-start (k) =
  when k
   is TypeIdentifier -> True
   is Identifier -> True
   is LeftParen -> True
   is IntegerLiteral -> True
   is otherwise -> False

operator-precedence : TokenKind -> Integer
operator-precedence (k) =
  when k
   is PlusPlus -> 5
   is ColonColon -> 5
   is Plus -> 6
   is Minus -> 6
   is Star -> 7
   is Slash -> 7
   is Caret -> 8
   is DoubleEquals -> 4
   is NotEquals -> 4
   is LessThan -> 4
   is GreaterThan -> 4
   is LessOrEqual -> 4
   is GreaterOrEqual -> 4
   is TripleEquals -> 4
   is Ampersand -> 3
   is Pipe -> 2
   is PipeForward -> 1
   is otherwise -> -1

is-right-assoc : TokenKind -> Boolean
is-right-assoc (k) =
  when k
   is PlusPlus -> True
   is ColonColon -> True
   is Caret -> True
   is Arrow -> True
   is otherwise -> False

expect : TokenKind, ParseState -> ParseState
expect (kind) (st) =
  if is-done st then st
  else if current-kind st == kind then advance st
  else let tok = current st
  in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("Expected token kind mismatch, got '" & token-text tok & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

expect-coded : TokenKind, Integer, Text, ParseState -> ParseState
expect-coded (kind) (code) (msg) (st) =
  if is-done st then st
  else if current-kind st == kind then advance st
  else let tok = current st
  in __record-set st "bag" (bag-add (st.bag) (make-error code (msg & " (got '" & token-text tok & "')") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

report-reserved-keyword : Text, ParseState -> ParseState
report-reserved-keyword (context) (st) =
  let tok = current st
  in __record-set st "bag" (bag-add (st.bag) (make-error cdx-reserved-keyword-as-identifier ("'" & token-text tok & "' is a reserved keyword and cannot be used as " & context & "; rename it") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

skip-newlines-pos : List Token, Integer, Integer -> Integer
skip-newlines-pos (tokens) (pos) (len) =
  if pos >= len - 1 then pos
  else let kind = (list-at tokens pos).kind
  in when kind
   is Newline -> skip-newlines-pos tokens (pos + 1) len
   is Indent -> skip-newlines-pos tokens (pos + 1) len
   is Dedent -> skip-newlines-pos tokens (pos + 1) len
   is otherwise -> pos

skip-newlines : ParseState -> ParseState
skip-newlines (st) =
  let end-pos = skip-newlines-pos (st.tokens) (st.pos) (list-length (st.tokens))
  in if end-pos == st.pos then st
     else __record-set st "pos" end-pos

parse-expr : ParseState -> ParseExprResult
parse-expr (st) =
  if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-expr")
  else parse-expr-col (consume-parse-fuel st) 0

parse-expr-col : ParseState, Integer -> ParseExprResult
parse-expr-col (st) (min-col) =
  parse-binary st 0 min-col

unwrap-expr-ok : ParseExprResult, (Expr, ParseState -> ParseExprResult) -> ParseExprResult
unwrap-expr-ok (r) (f) =
  when r
   is ExprOk (e) (st) -> f e st

parse-binary : ParseState, Integer, Integer -> ParseExprResult
parse-binary (st) (min-prec) (min-col) =
  if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-binary")
  else let st0 = consume-parse-fuel st
  in let left-result = parse-unary st0
  in unwrap-expr-ok left-result (start-binary-loop min-prec min-col)

start-binary-loop : Integer, Integer, Expr, ParseState -> ParseExprResult
start-binary-loop (min-prec) (min-col) (left) (st) =
  parse-binary-loop left st min-prec min-col

parse-binary-loop : Expr, ParseState, Integer, Integer -> ParseExprResult
parse-binary-loop (left) (st) (min-prec) (min-col) =
  if parse-fuel-exhausted st then ExprOk left (emit-parse-fuel-error st "parse-binary-loop")
  else let st-fueled = consume-parse-fuel st
  in let st1 = skip-newlines st-fueled
  in if is-done st1 then ExprOk left st1
     else if min-col > 0 & (current st1).column > 0 & (current st1).column <= min-col then ExprOk left st1
     else let prec = operator-precedence (current-kind st1)
  in if prec < min-prec then ExprOk left st1
     else let op = current st1
  in let st2 = skip-newlines (advance st1)
  in let next-min = if is-right-assoc (op.kind) then prec
   else prec + 1
  in let right-result = parse-binary st2 next-min min-col
  in unwrap-expr-ok right-result (continue-binary left op min-prec min-col)

continue-binary : Expr, Token, Integer, Integer, Expr, ParseState -> ParseExprResult
continue-binary (left) (op) (min-prec) (min-col) (right) (st) =
  let st2 = if is-plus-plus (op.kind) then if bag-has-code (st.bag) cdx-deprecated-plus-plus then st
   else __record-set st "bag" (bag-add (st.bag) (make-deprecated cdx-deprecated-plus-plus "++ is deprecated; use & instead" (token-to-span op)))
   else st
  in parse-binary-loop (deck-record (BinExpr left op right)) st2 min-prec min-col

parse-unary : ParseState -> ParseExprResult
parse-unary (st) =
  if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-unary")
  else let st0 = consume-parse-fuel st
  in if is-minus (current-kind st0) then let op = current st0
  in let result = parse-unary (advance st0)
  in unwrap-expr-ok result (finish-unary op)
     else parse-application st0

finish-unary : Token, Expr, ParseState -> ParseExprResult
finish-unary (op) (operand) (st) =
  ExprOk (deck-record (UnaryExpr op operand)) st

parse-application : ParseState -> ParseExprResult
parse-application (st) =
  let app-col = (current st).column
  in let func-result = parse-atom st
  in unwrap-expr-ok func-result (app-loop-start app-col)

app-loop-start : Integer, Expr, ParseState -> ParseExprResult
app-loop-start (app-col) (func) (st) =
  parse-app-loop app-col func st

parse-app-loop : Integer, Expr, ParseState -> ParseExprResult
parse-app-loop (app-col) (func) (st) =
  if parse-fuel-exhausted st then ExprOk func (emit-parse-fuel-error st "parse-app-loop")
  else let st-fueled = consume-parse-fuel st
  in if is-compound func then parse-dot-only func st-fueled
     else if is-done st-fueled then ExprOk func st-fueled
     else let st1 = if st-fueled.paren-depth > 0 then skip-newlines st-fueled
   else st-fueled
  in if is-app-start (current-kind st1) then let arg-result = parse-atom st1
  in unwrap-expr-ok arg-result (continue-app app-col func)
     else let st2 = check-multiline-app app-col func st1
  in parse-field-access func st2

is-applied : Expr -> Boolean
is-applied (e) =
  when e
   is AppExpr (f) (a) -> True
   is otherwise -> False

check-multiline-app : Integer, Expr, ParseState -> ParseState
check-multiline-app (app-col) (func) (st) =
  if st.paren-depth > 0 then st
  else if is-applied func == False then st
  else if st.pos == 0 then st
  else let peek-pos = skip-newlines-pos (st.tokens) (st.pos) (list-length (st.tokens))
  in if peek-pos == st.pos then st
     else if peek-pos >= list-length (st.tokens) - 1 then st
     else let next-tok = list-at (st.tokens) peek-pos
  in let last-tok = list-at (st.tokens) (st.pos - 1)
  in if is-left-paren (next-tok.kind) | is-left-bracket (next-tok.kind) then if next-tok.line > last-tok.line then let span = span-at (next-tok.line) (next-tok.column) (next-tok.offset) (next-tok.length) (next-tok.file-id)
  in __record-set st "bag" (bag-add (st.bag) (make-warning cdx-multiline-application ("Application ended at newline; '" & token-text next-tok & "' on line " & integer-to-text (next-tok.line) & " is not parsed as an argument (column " & integer-to-text (next-tok.column) & ", application started at column " & integer-to-text app-col & "). Place all arguments on one line or wrap in parentheses.") span))
  else st
     else st

continue-app : Integer, Expr, Expr, ParseState -> ParseExprResult
continue-app (app-col) (func) (arg) (st) =
  parse-app-loop app-col (deck-record (AppExpr func arg)) st

parse-atom : ParseState -> ParseExprResult
parse-atom (st) =
  if is-literal (current-kind st) then ExprOk (deck-record (LitExpr (current st))) (advance st)
  else if is-ident (current-kind st) then parse-field-access (deck-record (NameExpr (current st))) (advance st)
  else if is-type-ident (current-kind st) then parse-atom-type-ident st
  else if is-left-paren (current-kind st) then parse-paren-expr (advance st)
  else if is-left-bracket (current-kind st) then parse-list-expr st
  else if is-if-keyword (current-kind st) then parse-if-expr st
  else if is-let-keyword (current-kind st) then parse-let-expr st
  else if is-when-keyword (current-kind st) then parse-match-expr st
  else if is-act-keyword (current-kind st) then parse-act-expr st
  else if is-trying-keyword (current-kind st) then parse-try-expr st
  else if is-with-keyword (current-kind st) then parse-handle-expr st
  else if is-with-timeout-keyword (current-kind st) then parse-with-timeout-expr st
  else if is-backslash (current-kind st) then parse-lambda-expr st
  else if is-dot (current-kind st) then parse-selector-expr st
  else ExprOk (ErrExpr (current st)) (advance st)

parse-field-access : Expr, ParseState -> ParseExprResult
parse-field-access (node) (st) =
  if parse-fuel-exhausted st then ExprOk node (emit-parse-fuel-error st "parse-field-access")
  else let st-fueled = consume-parse-fuel st
  in if is-dot (current-kind st-fueled) then let st2 = advance st-fueled
  in if is-field-name-token (current-kind st2) then let field = current st2
  in let st3 = advance st2
  in let fe = deck-record (FieldExpr node field)
  in if is-equals (current-kind st3) then finish-field-assign fe field st3
     else parse-field-access fe st3
     else ExprOk node st-fueled
     else ExprOk node st-fueled

finish-field-assign : Expr, Token, ParseState -> ParseExprResult
finish-field-assign (lhs) (field) (st) =
  let st2 = advance st
  in let rhs = parse-expr st2
  in unwrap-expr-ok rhs (make-field-assign lhs field)

make-field-assign : Expr, Token, Expr, ParseState -> ParseExprResult
make-field-assign (lhs) (field) (rhs) (st) =
  ExprOk (deck-record (FieldAssignExpr lhs field rhs)) st

parse-dot-only : Expr, ParseState -> ParseExprResult
parse-dot-only (node) (st) =
  if parse-fuel-exhausted st then ExprOk node (emit-parse-fuel-error st "parse-dot-only")
  else let st-fueled = consume-parse-fuel st
  in if is-dot (current-kind st-fueled) then let st2 = advance st-fueled
  in if is-field-name-token (current-kind st2) then let field = current st2
  in let st3 = advance st2
  in parse-dot-only (deck-record (FieldExpr node field)) st3
     else ExprOk node st-fueled
     else ExprOk node st-fueled

parse-atom-type-ident : ParseState -> ParseExprResult
parse-atom-type-ident (st) =
  let tok = current st
  in let st2 = advance st
  in if is-left-brace (current-kind st2) then let rec-result = parse-record-expr tok st2
  in unwrap-expr-ok rec-result parse-field-access
     else parse-field-access (deck-record (NameExpr tok)) st2

parse-paren-expr : ParseState -> ParseExprResult
parse-paren-expr (st) =
  let st2 = skip-newlines (enter-paren st)
  in let inner = parse-expr st2
  in unwrap-expr-ok inner finish-paren-expr

finish-paren-expr : Expr, ParseState -> ParseExprResult
finish-paren-expr (e) (st) =
  let st2 = skip-newlines st
  in let st3 = expect RightParen st2
  in parse-field-access (deck-record (ParenExpr e)) (exit-paren st3)

parse-record-expr : Token, ParseState -> ParseExprResult
parse-record-expr (type-name) (st) =
  let st2 = advance st
  in let st3 = skip-newlines st2
  in parse-record-expr-fields type-name (__linked-list-empty 0) st3

parse-record-expr-fields : Token, LinkedList RecordFieldExpr, ParseState -> ParseExprResult
parse-record-expr-fields (type-name) (acc) (st) =
  let kind = current-kind st
  in if is-right-brace kind then ExprOk (deck-record (RecordExpr type-name (deck-record (__linked-list-to-list acc)))) (advance st)
     else if is-field-name-token kind then parse-record-field type-name acc st
     else ExprOk (deck-record (RecordExpr type-name (deck-record (__linked-list-to-list acc)))) (__record-set st "bag" (bag-add (st.bag) (make-error cdx-bad-field-syntax "Expected field name in record literal" (token-to-span (current st)))))

parse-record-field : Token, LinkedList RecordFieldExpr, ParseState -> ParseExprResult
parse-record-field (type-name) (acc) (st) =
  let field-name = current st
  in let st2 = advance st
  in let st3 = expect Equals st2
  in let val-result = parse-expr st3
  in unwrap-expr-ok val-result (finish-record-field type-name acc field-name)

finish-record-field : Token, LinkedList RecordFieldExpr, Token, Expr, ParseState -> ParseExprResult
finish-record-field (type-name) (acc) (field-name) (v) (st) =
  let field = deck-record (RecordFieldExpr {
    name = field-name,
    value = v
   })
  in let st2 = skip-newlines st
  in if is-comma (current-kind st2) then parse-record-expr-fields type-name (__linked-list-push acc field) (skip-newlines (advance st2))
     else parse-record-expr-fields type-name (__linked-list-push acc field) st2

parse-list-expr : ParseState -> ParseExprResult
parse-list-expr (st) =
  let st2 = advance st
  in let st3 = skip-newlines st2
  in parse-list-elements (__linked-list-empty 0) st3

parse-list-elements : LinkedList Expr, ParseState -> ParseExprResult
parse-list-elements (acc) (st) =
  if is-right-bracket (current-kind st) then ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list acc)))) (advance st)
  else if is-done st then ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list acc)))) (__record-set st "bag" (bag-add (st.bag) (make-error cdx-list-no-close "Unclosed list literal: expected ']' before end of input" (token-to-span (current st)))))
  else let elem = parse-expr st
  in unwrap-expr-ok elem (finish-list-element acc)

finish-list-element : LinkedList Expr, Expr, ParseState -> ParseExprResult
finish-list-element (acc) (e) (st) =
  let st2 = skip-newlines st
  in if is-comma (current-kind st2) then parse-list-elements (__linked-list-push acc e) (skip-newlines (advance st2))
     else if is-right-bracket (current-kind st2) then parse-list-elements (__linked-list-push acc e) st2
     else ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list (__linked-list-push acc e))))) (__record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-list-no-close "Unclosed list literal: expected ',' or ']'" (token-to-span (current st2)))))

parse-if-expr : ParseState -> ParseExprResult
parse-if-expr (st) =
  let st2 = skip-newlines (advance st)
  in let cond = parse-expr st2
  in unwrap-expr-ok cond parse-if-then

parse-if-then : Expr, ParseState -> ParseExprResult
parse-if-then (c) (st) =
  let st2 = skip-newlines st
  in let st3 = expect-coded ThenKeyword cdx-if-no-then "Expected 'then' in if expression" st2
  in let st4 = skip-newlines st3
  in let then-result = parse-expr st4
  in unwrap-expr-ok then-result (parse-if-else c)

parse-if-else : Expr, Expr, ParseState -> ParseExprResult
parse-if-else (c) (t) (st) =
  let st2 = skip-newlines st
  in let st3 = expect-coded ElseKeyword cdx-if-no-else "Expected 'else' in if expression" st2
  in let st4 = skip-newlines st3
  in let else-result = parse-expr st4
  in unwrap-expr-ok else-result (finish-if c t)

finish-if : Expr, Expr, Expr, ParseState -> ParseExprResult
finish-if (c) (t) (e) (st) =
  ExprOk (deck-record (IfExpr c t e)) st

parse-let-expr : ParseState -> ParseExprResult
parse-let-expr (st) =
  let st2 = skip-newlines (advance st)
  in parse-let-bindings (__linked-list-empty 0) st2

parse-let-bindings : LinkedList LetBind, ParseState -> ParseExprResult
parse-let-bindings (acc) (st) =
  if is-ident (current-kind st) then parse-let-binding acc st
  else if is-reserved-keyword-let-name st then parse-let-binding acc (report-reserved-keyword "a let-binding name" st)
  else if is-in-keyword (current-kind st) then let st2 = skip-newlines (advance st)
  in let body = parse-expr st2
  in unwrap-expr-ok body (finish-let acc)
  else let st-err = __record-set st "bag" (bag-add (st.bag) (make-error cdx-let-no-in "Expected 'in' after let bindings" (token-to-span (current st))))
  in let body = parse-expr st-err
  in unwrap-expr-ok body (finish-let acc)

is-reserved-keyword-let-name : ParseState -> Boolean
is-reserved-keyword-let-name (st) =
  if is-reserved-keyword (current-kind st) then is-equals (peek-kind st 1)
  else False

finish-let : LinkedList LetBind, Expr, ParseState -> ParseExprResult
finish-let (acc) (b) (st) =
  ExprOk (deck-record (LetExpr (deck-record (__linked-list-to-list acc)) b)) st

parse-let-binding : LinkedList LetBind, ParseState -> ParseExprResult
parse-let-binding (acc) (st) =
  let name-tok = current st
  in let st2 = advance st
  in let st3 = expect Equals st2
  in let val-result = parse-expr st3
  in unwrap-expr-ok val-result (finish-let-binding acc name-tok)

finish-let-binding : LinkedList LetBind, Token, Expr, ParseState -> ParseExprResult
finish-let-binding (acc) (name-tok) (v) (st) =
  let binding = deck-record (LetBind {
    name = name-tok,
    value = v
   })
  in let st2 = skip-newlines st
  in if is-comma (current-kind st2) then parse-let-bindings (__linked-list-push acc binding) (skip-newlines (advance st2))
     else parse-let-bindings (__linked-list-push acc binding) st2

parse-match-expr : ParseState -> ParseExprResult
parse-match-expr (st) =
  let st2 = advance st
  in let scrut = parse-expr st2
  in unwrap-expr-ok scrut start-match-branches

start-match-branches : Expr, ParseState -> ParseExprResult
start-match-branches (s) (st) =
  let st2 = skip-newlines st
  in let tok = current st2
  in parse-match-branches s (__linked-list-empty 0) (tok.column) (tok.line) st2

parse-match-branches : Expr, LinkedList MatchArm, Integer, Integer, ParseState -> ParseExprResult
parse-match-branches (scrut) (acc) (col) (ln) (st) =
  let tok = current st
  in if is-match-arm-start (current-kind st) & (tok.line == ln | tok.column == col) then parse-one-match-branch scrut acc col ln st
     else ExprOk (deck-record (MatchExpr scrut (deck-record (__linked-list-to-list acc)))) st

unwrap-pat-for-expr : ParsePatResult, (Pat, ParseState -> ParseExprResult) -> ParseExprResult
unwrap-pat-for-expr (r) (f) =
  when r
   is PatOk (p) (st) -> f p st

parse-one-match-branch : Expr, LinkedList MatchArm, Integer, Integer, ParseState -> ParseExprResult
parse-one-match-branch (scrut) (acc) (col) (ln) (st) =
  let st2 = advance st
  in let pat = parse-pattern st2
  in unwrap-pat-for-expr pat (parse-match-branch-body scrut acc col ln)

parse-match-branch-body : Expr, LinkedList MatchArm, Integer, Integer, Pat, ParseState -> ParseExprResult
parse-match-branch-body (scrut) (acc) (col) (ln) (p) (st) =
  let st2 = expect-coded Arrow cdx-match-no-arrow "Expected '->' in match arm" st
  in let st3 = skip-newlines st2
  in let body = parse-expr-col st3 col
  in unwrap-expr-ok body (finish-match-branch scrut acc col ln p)

finish-match-branch : Expr, LinkedList MatchArm, Integer, Integer, Pat, Expr, ParseState -> ParseExprResult
finish-match-branch (scrut) (acc) (col) (ln) (p) (b) (st) =
  let arm = deck-record (MatchArm {
    pattern = p,
    body = b
   })
  in let st2 = skip-newlines st
  in parse-match-branches scrut (__linked-list-push acc arm) col ln st2

looks-like-top-level-def : ParseState -> Boolean
looks-like-top-level-def (st) =
  if is-ident (current-kind st) | is-type-ident (current-kind st) then is-colon (peek-kind st 1)
  else False

is-act-bind : ParseState -> Boolean
is-act-bind (st) =
  if is-ident (current-kind st) then is-left-arrow (peek-kind st 1)
  else False

parse-act-expr : ParseState -> ParseExprResult
parse-act-expr (st) =
  let st2 = skip-newlines (advance st)
  in parse-act-stmts (__linked-list-empty 0) st2

parse-act-stmts : LinkedList ActStmt, ParseState -> ParseExprResult
parse-act-stmts (acc) (st) =
  if is-done st then ExprOk (deck-record (ActExpr (deck-record (__linked-list-to-list acc)))) st
  else if is-end-keyword (current-kind st) then let acc-list = deck-record (__linked-list-to-list acc)
  in if list-length acc-list == 0 then ExprOk (deck-record (ActExpr acc-list)) (advance (__record-set st "bag" (bag-add (st.bag) (make-error cdx-empty-act "Empty act block: 'act end' must contain at least one statement" (token-to-span (current st))))))
     else ExprOk (deck-record (ActExpr acc-list)) (advance st)
  else if is-act-bind st then parse-act-bind-stmt acc st
  else parse-act-expr-stmt acc st

parse-act-bind-stmt : LinkedList ActStmt, ParseState -> ParseExprResult
parse-act-bind-stmt (acc) (st) =
  let name-tok = current st
  in let st2 = advance (advance st)
  in let val-result = parse-expr st2
  in unwrap-expr-ok val-result (finish-act-bind acc name-tok)

finish-act-bind : LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
finish-act-bind (acc) (name-tok) (v) (st) =
  let st2 = skip-newlines st
  in parse-act-stmts (__linked-list-push acc (deck-record (ActBindStmt name-tok v))) st2

parse-act-expr-stmt : LinkedList ActStmt, ParseState -> ParseExprResult
parse-act-expr-stmt (acc) (st) =
  let expr-result = parse-expr st
  in unwrap-expr-ok expr-result (finish-act-expr acc)

finish-act-expr : LinkedList ActStmt, Expr, ParseState -> ParseExprResult
finish-act-expr (acc) (e) (st) =
  let st2 = skip-newlines st
  in parse-act-stmts (__linked-list-push acc (deck-record (ActExprStmt e))) st2

is-ident-text : ParseState, Text -> Boolean
is-ident-text (st) (txt) =
  if is-ident (current-kind st) then token-text (current st) == txt
  else False

parse-try-expr : ParseState -> ParseExprResult
parse-try-expr (st) =
  let st1 = skip-newlines (advance st)
  in if is-literal (current-kind st1) then let count-tok = current st1
  in let st2 = skip-newlines (advance st1)
  in let st3 = if is-ident-text st2 "times" then skip-newlines (advance st2)
   else __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-empty-act "Expected 'times' after attempt count in trying expression" (token-to-span (current st2))))
  in parse-try-body count-tok (__linked-list-empty 0) st3
     else ExprOk (deck-record (ErrExpr (current st1))) (advance st1)

parse-try-body : Token, LinkedList ActStmt, ParseState -> ParseExprResult
parse-try-body (count-tok) (acc) (st) =
  if is-done st then finish-try count-tok acc (__linked-list-empty 0) (__linked-list-empty 0) st
  else if is-end-keyword (current-kind st) then finish-try count-tok acc (__linked-list-empty 0) (__linked-list-empty 0) (advance st)
  else if is-ident-text st "falling" then let st2 = skip-newlines (advance st)
  in let st3 = if is-ident-text st2 "back" then skip-newlines (advance st2)
   else __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-empty-act "Expected 'back to' after 'falling'" (token-to-span (current st2))))
  in let st4 = if is-ident-text st3 "to" then skip-newlines (advance st3)
   else __record-set st3 "bag" (bag-add (st3.bag) (make-error cdx-empty-act "Expected 'to' after 'falling back'" (token-to-span (current st3))))
  in parse-try-fallback count-tok acc (__linked-list-empty 0) st4
  else if is-ident-text st "on" then let peek-st = advance st
  in if is-ident-text peek-st "failure" then let st2 = skip-newlines (advance peek-st)
  in parse-try-failure count-tok acc (__linked-list-empty 0) (__linked-list-empty 0) st2
     else parse-try-stmt count-tok acc st
  else parse-try-stmt count-tok acc st

parse-try-stmt : Token, LinkedList ActStmt, ParseState -> ParseExprResult
parse-try-stmt (count-tok) (acc) (st) =
  if is-act-bind st then let name-tok = current st
  in let st2 = advance (advance st)
  in let val-result = parse-expr st2
  in unwrap-expr-ok val-result (finish-try-bind count-tok acc name-tok)
  else let expr-result = parse-expr st
  in unwrap-expr-ok expr-result (finish-try-expr-stmt count-tok acc)

finish-try-bind : Token, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
finish-try-bind (count-tok) (acc) (name-tok) (v) (st) =
  let st2 = skip-newlines st
  in parse-try-body count-tok (__linked-list-push acc (deck-record (ActBindStmt name-tok v))) st2

finish-try-expr-stmt : Token, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
finish-try-expr-stmt (count-tok) (acc) (e) (st) =
  let st2 = skip-newlines st
  in parse-try-body count-tok (__linked-list-push acc (deck-record (ActExprStmt e))) st2

parse-try-fallback : Token, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
parse-try-fallback (count-tok) (body-acc) (fb-acc) (st) =
  if is-done st then finish-try count-tok body-acc fb-acc (__linked-list-empty 0) st
  else if is-end-keyword (current-kind st) then finish-try count-tok body-acc fb-acc (__linked-list-empty 0) (advance st)
  else if is-ident-text st "on" then let peek-st = advance st
  in if is-ident-text peek-st "failure" then let st2 = skip-newlines (advance peek-st)
  in parse-try-failure count-tok body-acc fb-acc (__linked-list-empty 0) st2
     else parse-try-fallback-stmt count-tok body-acc fb-acc st
  else parse-try-fallback-stmt count-tok body-acc fb-acc st

parse-try-fallback-stmt : Token, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
parse-try-fallback-stmt (count-tok) (body-acc) (fb-acc) (st) =
  if is-act-bind st then let name-tok = current st
  in let st2 = advance (advance st)
  in let val-result = parse-expr st2
  in unwrap-expr-ok val-result (finish-try-fb-bind count-tok body-acc fb-acc name-tok)
  else let expr-result = parse-expr st
  in unwrap-expr-ok expr-result (finish-try-fb-expr count-tok body-acc fb-acc)

finish-try-fb-bind : Token, LinkedList ActStmt, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
finish-try-fb-bind (count-tok) (body-acc) (fb-acc) (name-tok) (v) (st) =
  let st2 = skip-newlines st
  in parse-try-fallback count-tok body-acc (__linked-list-push fb-acc (deck-record (ActBindStmt name-tok v))) st2

finish-try-fb-expr : Token, LinkedList ActStmt, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
finish-try-fb-expr (count-tok) (body-acc) (fb-acc) (e) (st) =
  let st2 = skip-newlines st
  in parse-try-fallback count-tok body-acc (__linked-list-push fb-acc (deck-record (ActExprStmt e))) st2

parse-try-failure : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
parse-try-failure (count-tok) (body-acc) (fb-acc) (fail-acc) (st) =
  if is-done st then finish-try count-tok body-acc fb-acc fail-acc st
  else if is-end-keyword (current-kind st) then finish-try count-tok body-acc fb-acc fail-acc (advance st)
  else if is-act-bind st then let name-tok = current st
  in let st2 = advance (advance st)
  in let val-result = parse-expr st2
  in unwrap-expr-ok val-result (finish-try-fail-bind count-tok body-acc fb-acc fail-acc name-tok)
  else let expr-result = parse-expr st
  in unwrap-expr-ok expr-result (finish-try-fail-expr count-tok body-acc fb-acc fail-acc)

finish-try-fail-bind : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
finish-try-fail-bind (count-tok) (body-acc) (fb-acc) (fail-acc) (name-tok) (v) (st) =
  let st2 = skip-newlines st
  in parse-try-failure count-tok body-acc fb-acc (__linked-list-push fail-acc (deck-record (ActBindStmt name-tok v))) st2

finish-try-fail-expr : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
finish-try-fail-expr (count-tok) (body-acc) (fb-acc) (fail-acc) (e) (st) =
  let st2 = skip-newlines st
  in parse-try-failure count-tok body-acc fb-acc (__linked-list-push fail-acc (deck-record (ActExprStmt e))) st2

finish-try : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
finish-try (count-tok) (body-acc) (fb-acc) (fail-acc) (st) =
  let body-list = deck-record (__linked-list-to-list body-acc)
  in let fb-list = deck-record (__linked-list-to-list fb-acc)
  in let fail-list = deck-record (__linked-list-to-list fail-acc)
  in ExprOk (deck-record (TryExpr count-tok body-list fb-list fail-list)) st

parse-handle-expr : ParseState -> ParseExprResult
parse-handle-expr (st) =
  let st1 = advance st
  in let eff-tok = current st1
  in let st2 = advance st1
  in let body-result = parse-expr st2
  in unwrap-expr-ok body-result (finish-handle-body eff-tok)

finish-handle-body : Token, Expr, ParseState -> ParseExprResult
finish-handle-body (eff-tok) (body) (st) =
  let st2 = skip-newlines st
  in let clauses = parse-handle-clauses st2 (__linked-list-empty 0)
  in ExprOk (deck-record (HandleExpr eff-tok body (clauses.clauses))) (clauses.state)

parse-handle-clauses : ParseState, LinkedList HandleClause -> HandleParseResult
parse-handle-clauses (st) (acc) =
  if is-ident (current-kind st) then let op-tok = current st
  in let st1 = advance st
  in let all-params = parse-handle-params st1 (__linked-list-empty 0)
  in let all-params-list = deck-record (__linked-list-to-list (all-params.toks))
  in if list-length all-params-list > 0 then let resume-tok = list-at all-params-list (list-length all-params-list - 1)
  in let arg-params = take-tokens all-params-list (list-length all-params-list - 1) 0 (__linked-list-empty 0)
  in let st5 = expect Equals (all-params.state)
  in let st6 = skip-newlines st5
  in let body-result = parse-expr st6
  in unwrap-handle-clause-body op-tok (deck-record (__linked-list-to-list arg-params)) resume-tok body-result acc
     else HandleParseResult {
   clauses = deck-record (__linked-list-to-list acc),
   state = st
  }
  else HandleParseResult {
   clauses = deck-record (__linked-list-to-list acc),
   state = st
  }

take-tokens : List Token, Integer, Integer, LinkedList Token -> LinkedList Token
take-tokens (toks) (n) (i) (acc) =
  if i >= n then acc
  else take-tokens toks n (i + 1) (__linked-list-push acc (list-at toks i))

parse-handle-params : ParseState, LinkedList Token -> HandleParamsResult
parse-handle-params (st) (acc) =
  if is-left-paren (current-kind st) then let st1 = advance st
  in let tok = current st1
  in let st2 = advance st1
  in let st3 = expect RightParen st2
  in parse-handle-params st3 (__linked-list-push acc tok)
  else HandleParamsResult {
   toks = acc,
   state = st
  }

unwrap-handle-clause-body : Token, List Token, Token, ParseExprResult, LinkedList HandleClause -> HandleParseResult
unwrap-handle-clause-body (op-tok) (arg-params) (resume-tok) (result) (acc) =
  when result
   is ExprOk (body) (st) -> let clause = deck-record (HandleClause {
     op-name = op-tok,
     params = arg-params,
     resume-name = resume-tok,
     body = body
    })
   in let st2 = skip-newlines st
   in parse-handle-clauses st2 (__linked-list-push acc clause)

parse-with-timeout-expr : ParseState -> ParseExprResult
parse-with-timeout-expr (st) =
  let st1 = advance st
  in let timeout-tok = current st1
  in let st2 = advance st1
  in let st3 = expect LeftBracket st2
  in let effs = parse-effect-names st3 (__linked-list-empty 0) (__linked-list-empty 0)
  in let body-result = parse-expr (effs.state)
  in unwrap-expr-ok body-result (finish-with-timeout timeout-tok (effs.names) (effs.scopes))

finish-with-timeout : Token, List Token, List Token, Expr, ParseState -> ParseExprResult
finish-with-timeout (timeout-tok) (effs) (scopes) (body) (st) =
  ExprOk (deck-record (WithTimeoutExpr timeout-tok effs scopes body)) st

parse-lambda-expr : ParseState -> ParseExprResult
parse-lambda-expr (st) =
  let st2 = advance st
  in let params-result = collect-lambda-params st2 (__linked-list-empty 0)
  in let st3 = expect Arrow (params-result.state)
  in let st4 = skip-newlines st3
  in let body = parse-expr st4
  in unwrap-expr-ok body (finish-lambda (deck-record (__linked-list-to-list (params-result.toks))))

collect-lambda-params : ParseState, LinkedList Token -> LambdaParamsResult
collect-lambda-params (st) (acc) =
  if is-ident (current-kind st) then let tok = current st
  in collect-lambda-params (advance st) (__linked-list-push acc tok)
  else LambdaParamsResult {
   toks = acc,
   state = st
  }

finish-lambda : List Token, Expr, ParseState -> ParseExprResult
finish-lambda (params) (body) (st) =
  ExprOk (deck-record (LambdaExpr params body)) st

parse-selector-expr : ParseState -> ParseExprResult
parse-selector-expr (st) =
  let dot-tok = current st
  in let st2 = advance st
  in if is-field-name-token (current-kind st2) then let field = current st2
  in let st3 = advance st2
  in let param = deck-record (Token {
    kind = Identifier,
    source = "__r",
    offset = 0,
    length = 3,
    line = dot-tok.line,
    column = dot-tok.column,
    file-id = dot-tok.file-id
   })
  in let param-ref = deck-record (NameExpr param)
  in let access = deck-record (FieldExpr param-ref field)
  in ExprOk (deck-record (LambdaExpr [param] access)) st3
     else ExprOk (ErrExpr (current st)) st

token-text : Token -> Text
token-text (t) =
  substring (t.source) (t.offset) (t.length)

i64-max : Integer
i64-max =
  9223372036854775807

i64-min : Integer
i64-min =
  0 - 9223372036854775807 - 1

int-ty-default : CodexType
int-ty-default =
  IntegerTy i64-min i64-max OvError

peel-fun-param : CodexType -> CodexType
peel-fun-param (ty) =
  when ty
   is FunTy (p) (r) -> p
   is ForAllTy (id) (body) -> peel-fun-param body
   is otherwise -> ErrorTy

peel-fun-return : CodexType -> CodexType
peel-fun-return (ty) =
  when ty
   is FunTy (p) (r) -> r
   is ForAllTy (id) (body) -> peel-fun-return body
   is otherwise -> ErrorTy

strip-fun-args : CodexType -> CodexType
strip-fun-args (ty) =
  when ty
   is FunTy (p) (r) -> strip-fun-args r
   is ForAllTy (id) (body) -> strip-fun-args body
   is otherwise -> ty

strip-forall-ty : CodexType -> CodexType
strip-forall-ty (ty) =
  when ty
   is ForAllTy (id) (body) -> strip-forall-ty body
   is otherwise -> ty

hw-width-bytes : HwIntWidth -> Integer
hw-width-bytes (w) =
  when w
   is HwU8 -> 1
   is HwU16 -> 2
   is HwU32 -> 4
   is HwU64 -> 8
   is HwI8 -> 1
   is HwI16 -> 2
   is HwI32 -> 4
   is HwI64 -> 8

hw-width-signed : HwIntWidth -> Boolean
hw-width-signed (w) =
  when w
   is HwU8 -> False
   is HwU16 -> False
   is HwU32 -> False
   is HwU64 -> False
   is HwI8 -> True
   is HwI16 -> True
   is HwI32 -> True
   is HwI64 -> True

bounds-to-hw-width : Integer, Integer -> HwIntWidth
bounds-to-hw-width (lo) (hi) =
  if lo >= 0 then if hi <= 255 then HwU8
  else if hi <= 65535 then HwU16
  else if hi <= 4294967295 then HwU32
  else HwU64
  else if lo >= 0 - 128 & hi <= 127 then HwI8
  else if lo >= 0 - 32768 & hi <= 32767 then HwI16
  else if lo >= 0 - 2147483648 & hi <= 2147483647 then HwI32
  else HwI64

integer-ty-hw-width : CodexType -> HwIntWidth
integer-ty-hw-width (ty) =
  when ty
   is IntegerTy (lo) (hi) (mode) -> bounds-to-hw-width lo hi
   is otherwise -> HwI64

codex-type-map-children : (CodexType -> CodexType), CodexType -> CodexType
codex-type-map-children (f) (ty) =
  when ty
   is FunTy (param) (ret) -> deck-record (FunTy (f param) (f ret))
   is ListTy (elem) -> deck-record (ListTy (f elem))
   is LinkedListTy (elem) -> deck-record (LinkedListTy (f elem))
   is ForAllTy (id) (body) -> deck-record (ForAllTy id (f body))
   is EffectfulTy (effs) (sc) (ret) -> deck-record (EffectfulTy effs sc (f ret))
   is ConstructedTy (name) (args) -> deck-record (ConstructedTy name (map-children-list f args 0 (list-length args) []))
   is SumTy (name) (args) (ctors) -> deck-record (SumTy name (map-children-list f args 0 (list-length args) []) (map-children-sum-ctors f ctors 0 (list-length ctors) []))
   is RecordTy (name) (args) (fields) -> deck-record (RecordTy name (map-children-list f args 0 (list-length args) []) (map-children-record-fields f fields 0 (list-length fields) []))
   is PropEqTy (a) (b) -> deck-record (PropEqTy (f a) (f b))
   is otherwise -> ty

map-children-list : (CodexType -> CodexType), List CodexType, Integer, Integer, List CodexType -> List CodexType
map-children-list (f) (xs) (i) (len) (acc) =
  if i == len then acc
  else map-children-list f xs (i + 1) len (list-push acc (f (list-at xs i)))

map-children-record-fields : (CodexType -> CodexType), List RecordField, Integer, Integer, List RecordField -> List RecordField
map-children-record-fields (f) (fs) (i) (len) (acc) =
  if i == len then acc
  else let r = list-at fs i
  in map-children-record-fields f fs (i + 1) len (list-push acc (deck-record (RecordField {
   name = r.name,
   type-val = f (r.type-val)
  })))

map-children-sum-ctors : (CodexType -> CodexType), List SumCtor, Integer, Integer, List SumCtor -> List SumCtor
map-children-sum-ctors (f) (cs) (i) (len) (acc) =
  if i == len then acc
  else let c = list-at cs i
  in let new-fields = map-children-list f (c.fields) 0 (list-length (c.fields)) []
  in map-children-sum-ctors f cs (i + 1) len (list-push acc (deck-record (SumCtor {
   name = c.name,
   fields = new-fields
  })))

codex-type-fold-children : (CodexType, a0 -> a0), CodexType, a0 -> a0
codex-type-fold-children (f) (ty) (acc) =
  when ty
   is FunTy (p) (r) -> f r (f p acc)
   is ListTy (elem) -> f elem acc
   is LinkedListTy (elem) -> f elem acc
   is ForAllTy (id) (body) -> f body acc
   is EffectfulTy (effs) (sc) (ret) -> f ret acc
   is ConstructedTy (name) (args) -> fold-children-list f args 0 (list-length args) acc
   is SumTy (name) (args) (ctors) -> fold-children-sum-ctors f ctors 0 (list-length ctors) (fold-children-list f args 0 (list-length args) acc)
   is RecordTy (name) (args) (fields) -> fold-children-record-fields f fields 0 (list-length fields) (fold-children-list f args 0 (list-length args) acc)
   is PropEqTy (a) (b) -> f b (f a acc)
   is otherwise -> acc

fold-children-list : (CodexType, a0 -> a0), List CodexType, Integer, Integer, a0 -> a0
fold-children-list (f) (xs) (i) (len) (acc) =
  if i == len then acc
  else fold-children-list f xs (i + 1) len (f (list-at xs i) acc)

fold-children-record-fields : (CodexType, a0 -> a0), List RecordField, Integer, Integer, a0 -> a0
fold-children-record-fields (f) (fs) (i) (len) (acc) =
  if i == len then acc
  else let r = list-at fs i
  in fold-children-record-fields f fs (i + 1) len (f (r.type-val) acc)

fold-children-sum-ctors : (CodexType, a0 -> a0), List SumCtor, Integer, Integer, a0 -> a0
fold-children-sum-ctors (f) (cs) (i) (len) (acc) =
  if i == len then acc
  else let c = list-at cs i
  in fold-children-sum-ctors f cs (i + 1) len (fold-children-list f (c.fields) 0 (list-length (c.fields)) acc)

resolve-type-expr : List TypeBinding, ATypeExpr -> CodexType
resolve-type-expr (tdm) (texpr) =
  when texpr
   is ANamedType (name) (s) -> resolve-type-name tdm (name.value)
   is AFunType (param) (ret) (s) -> deck-record (FunTy (resolve-type-expr tdm param) (resolve-type-expr tdm ret))
   is AAppType (ctor) (args) (s) -> resolve-applied-type tdm ctor args
   is AEffectType (effs) (scopes) (ret) (s) -> deck-record (EffectfulTy effs scopes (resolve-type-expr tdm ret))
   is ABoundedIntType (base) (lo) (hi) (mode) (s) -> resolve-bounded-int-type tdm base lo hi mode
   is APropEqType (left) (right) (s) -> deck-record (PropEqTy (resolve-type-expr tdm left) (resolve-type-expr tdm right))
   is AConstrainedType (cn) (cv) (body) (s) -> resolve-type-expr tdm body

resolve-bounded-int-type : List TypeBinding, ATypeExpr, Integer, Integer, OverflowMode -> CodexType
resolve-bounded-int-type (tdm) (base) (lo) (hi) (mode) =
  let resolved = resolve-type-expr tdm base
  in when resolved
   is IntegerTy (b-lo) (b-hi) (b-mode) -> deck-record (IntegerTy lo hi mode)
   is otherwise -> ErrorTy

resolve-applied-type : List TypeBinding, ATypeExpr, List ATypeExpr -> CodexType
resolve-applied-type (tdm) (ctor) (args) =
  when ctor
   is ANamedType (name) (s) -> if name.value == "List" then if list-length args == 1 then deck-record (ListTy (resolve-type-expr tdm (list-at args 0)))
   else deck-record (ListTy ErrorTy)
   else if name.value == "LinkedList" then if list-length args == 1 then deck-record (LinkedListTy (resolve-type-expr tdm (list-at args 0)))
   else deck-record (LinkedListTy ErrorTy)
   else deck-record (ConstructedTy name (resolve-type-expr-list tdm args 0 (list-length args) []))
   is AAppType (inner-ctor) (inner-args) (s) -> resolve-applied-type tdm inner-ctor (inner-args & args)
   is otherwise -> resolve-type-expr tdm ctor

resolve-type-expr-list : List TypeBinding, List ATypeExpr, Integer, Integer, List CodexType -> List CodexType
resolve-type-expr-list (tdm) (args) (i) (len) (acc) =
  if i == len then acc
  else resolve-type-expr-list tdm args (i + 1) len (list-push acc (resolve-type-expr tdm (list-at args i)))

resolve-type-name : List TypeBinding, Text -> CodexType
resolve-type-name (tdm) (name) =
  if name == "Integer" then int-ty-default
  else if name == "Number" then NumberTy
  else if name == "Text" then TextTy
  else if name == "Boolean" then BooleanTy
  else if name == "Char" then CharTy
  else if name == "Nothing" then NothingTy
  else if name == "Proof" then ProofTy
  else lookup-type-def tdm name

lookup-type-def : List TypeBinding, Text -> CodexType
lookup-type-def (tdm) (name) =
  let len = list-length tdm
  in if len == 0 then deck-record (ConstructedTy (Name { value = name }) [])
     else let pos = bsearch-text-pos tdm name 0 len
  in if pos >= len then deck-record (ConstructedTy (Name { value = name }) [])
     else let b = list-at tdm pos
  in if b.name == name then b.bound-type
     else deck-record (ConstructedTy (Name { value = name }) [])

is-value-name : Text -> Boolean
is-value-name (name) =
  if text-length name == 0 then False
  else let code = char-code (char-at name 0)
  in code >= char-code 'e' & code <= char-code 'z'

parameterize-type : UnificationState, CodexType -> ParamResult
parameterize-type (st) (ty) =
  let r = parameterize-walk st [] ty
  in let wrapped = wrap-forall-from-entries (r.walked) (r.entries) 0 (list-length (r.entries))
  in ParamResult {
   parameterized = wrapped,
   entries = r.entries,
   state = r.state
  }

wrap-forall-from-entries : CodexType, List ParamEntry, Integer, Integer -> CodexType
wrap-forall-from-entries (ty) (entries) (i) (len) =
  if i == len then ty
  else let e = list-at entries i
  in deck-record (ForAllTy (e.var-id) (wrap-forall-from-entries ty entries (i + 1) len))

parameterize-walk : UnificationState, List ParamEntry, CodexType -> WalkResult
parameterize-walk (st) (entries) (ty) =
  when ty
   is ConstructedTy (name) (args) -> if list-length args == 0 & is-value-name (name.value) then let looked = find-param-entry entries (name.value) 0 (list-length entries)
   in if looked >= 0 then WalkResult {
    walked = TypeVar looked,
    entries = entries,
    state = st
   }
      else let fr = fresh-and-advance st
   in when fr.var-type
    is TypeVar (new-id) -> let new-entry = ParamEntry {
      param-name = name.value,
      var-id = new-id
     }
    in WalkResult {
     walked = fr.var-type,
     entries = list-push entries new-entry,
     state = fr.state
    }
    is otherwise -> WalkResult {
     walked = ty,
     entries = entries,
     state = fr.state
    }
   else parameterize-walk-children st entries ty
   is otherwise -> parameterize-walk-children st entries ty

parameterize-walk-children : UnificationState, List ParamEntry, CodexType -> WalkResult
parameterize-walk-children (st) (entries) (ty) =
  when ty
   is FunTy (param) (ret) -> let pr = parameterize-walk st entries param
   in let rr = parameterize-walk (pr.state) (pr.entries) ret
   in WalkResult {
    walked = deck-record (FunTy (pr.walked) (rr.walked)),
    entries = rr.entries,
    state = rr.state
   }
   is ListTy (elem) -> let er = parameterize-walk st entries elem
   in WalkResult {
    walked = deck-record (ListTy (er.walked)),
    entries = er.entries,
    state = er.state
   }
   is LinkedListTy (elem) -> let er = parameterize-walk st entries elem
   in WalkResult {
    walked = deck-record (LinkedListTy (er.walked)),
    entries = er.entries,
    state = er.state
   }
   is ForAllTy (id) (body) -> let br = parameterize-walk st entries body
   in WalkResult {
    walked = deck-record (ForAllTy id (br.walked)),
    entries = br.entries,
    state = br.state
   }
   is ConstructedTy (name) (args) -> let args-r = parameterize-walk-list st entries args 0 (list-length args) []
   in WalkResult {
    walked = deck-record (ConstructedTy name (args-r.walked-list)),
    entries = args-r.entries,
    state = args-r.state
   }
   is RecordTy (rname) (rargs) (rfields) -> let args-r = parameterize-walk-list st entries rargs 0 (list-length rargs) []
   in let fields-r = parameterize-walk-record-fields (args-r.state) (args-r.entries) rfields 0 (list-length rfields) []
   in WalkResult {
    walked = deck-record (RecordTy rname (args-r.walked-list) (fields-r.walked-fields)),
    entries = fields-r.entries,
    state = fields-r.state
   }
   is SumTy (sname) (sargs) (sctors) -> let args-r = parameterize-walk-list st entries sargs 0 (list-length sargs) []
   in let ctors-r = parameterize-walk-sum-ctors (args-r.state) (args-r.entries) sctors 0 (list-length sctors) []
   in WalkResult {
    walked = deck-record (SumTy sname (args-r.walked-list) (ctors-r.walked-ctors)),
    entries = ctors-r.entries,
    state = ctors-r.state
   }
   is otherwise -> WalkResult {
    walked = ty,
    entries = entries,
    state = st
   }

parameterize-walk-record-fields : UnificationState, List ParamEntry, List RecordField, Integer, Integer, List RecordField -> ParameterizeFieldsResult
parameterize-walk-record-fields (st) (entries) (fields) (i) (len) (acc) =
  if i == len then ParameterizeFieldsResult {
   walked-fields = acc,
   entries = entries,
   state = st
  }
  else let f = list-at fields i
  in let r = parameterize-walk st entries (f.type-val)
  in let f2 = deck-record (RecordField {
    name = f.name,
    type-val = r.walked
   })
  in parameterize-walk-record-fields (r.state) (r.entries) fields (i + 1) len (list-push acc f2)

parameterize-walk-sum-ctors : UnificationState, List ParamEntry, List SumCtor, Integer, Integer, List SumCtor -> ParameterizeCtorsResult
parameterize-walk-sum-ctors (st) (entries) (ctors) (i) (len) (acc) =
  if i == len then ParameterizeCtorsResult {
   walked-ctors = acc,
   entries = entries,
   state = st
  }
  else let c = list-at ctors i
  in let r = parameterize-walk-list st entries (c.fields) 0 (list-length (c.fields)) []
  in let c2 = deck-record (SumCtor {
    name = c.name,
    fields = r.walked-list
   })
  in parameterize-walk-sum-ctors (r.state) (r.entries) ctors (i + 1) len (list-push acc c2)

find-param-entry : List ParamEntry, Text, Integer, Integer -> Integer
find-param-entry (entries) (name) (i) (len) =
  if i == len then -1
  else let e = list-at entries i
  in if e.param-name == name then e.var-id
     else find-param-entry entries name (i + 1) len

parameterize-walk-list : UnificationState, List ParamEntry, List CodexType, Integer, Integer, List CodexType -> WalkListResult
parameterize-walk-list (st) (entries) (args) (i) (len) (acc) =
  if i == len then WalkListResult {
   walked-list = acc,
   entries = entries,
   state = st
  }
  else let r = parameterize-walk st entries (list-at args i)
  in parameterize-walk-list (r.state) (r.entries) args (i + 1) len (list-push acc (r.walked))

check-def : UnificationState, TypeEnv, ADef -> CheckResult
check-def (st) (env) (def) =
  let declared = resolve-declared-type st env def
  in let linked-state = if list-length (def.declared-type) == 0 then (unify (declared.state) (env-lookup (declared.env) (def.name.value)) (declared.expected-type) (def.span)).state
   else declared.state
  in let env2 = bind-def-params linked-state (declared.env) (def.params) (declared.expected-type) 0 (list-length (def.params))
  in let body-r = infer-expr (env2.state) (env2.env) (def.body)
  in let u = unify (body-r.state) (env2.remaining-type) (body-r.inferred-type) (aexpr-span (def.body))
  in let effect-checked = check-effect-subset (u.state) (env2.remaining-type) (deep-resolve (u.state) (body-r.inferred-type)) (aexpr-span (def.body))
  in let env-type = env-lookup env (def.name.value)
  in let tied-state = when env-type
    is ForAllTy (id) (body) -> (unify effect-checked (declared.expected-type) (strip-forall-ty env-type) (def.span)).state
    is otherwise -> effect-checked
  in CheckResult {
   inferred-type = declared.expected-type,
   state = tied-state
  }

check-effect-subset : UnificationState, CodexType, CodexType, SourceSpan -> UnificationState
check-effect-subset (st) (declared) (body) (span) =
  let declared-effs = extract-effects declared
  in let body-effs = extract-effects body
  in find-uncovered-effect st body-effs declared-effs span 0 (list-length body-effs)

extract-effects : CodexType -> List Name
extract-effects (ty) =
  when ty
   is EffectfulTy (effs) (sc) (inner) -> effs
   is otherwise -> []

extract-scopes : CodexType -> List Text
extract-scopes (ty) =
  when ty
   is EffectfulTy (effs) (sc) (inner) -> sc
   is otherwise -> []

find-uncovered-effect : UnificationState, List Name, List Name, SourceSpan, Integer, Integer -> UnificationState
find-uncovered-effect (st) (body-effs) (declared-effs) (span) (i) (len) =
  if i == len then st
  else let e = list-at body-effs i
  in if effect-covered-by declared-effs (e.value) then find-uncovered-effect st body-effs declared-effs span (i + 1) len
     else add-unify-error st cdx-effect-undeclared ("Effect '" & e.value & "' not declared in function signature") span

effect-covered-by : List Name, Text -> Boolean
effect-covered-by (declared) (body-eff) =
  if name-list-has declared body-eff then True
  else let dot-pos = find-dot body-eff 0 (text-length body-eff)
  in if dot-pos >= 0 then name-list-has declared (substring body-eff 0 dot-pos)
     else False

find-dot : Text, Integer, Integer -> Integer
find-dot (s) (i) (len) =
  if i == len then 0 - 1
  else if char-code (char-at s i) == 46 then i
  else find-dot s (i + 1) len

name-list-has : List Name, Text -> Boolean
name-list-has (names) (target) =
  name-list-has-loop names target 0 (list-length names)

name-list-has-loop : List Name, Text, Integer, Integer -> Boolean
name-list-has-loop (names) (target) (i) (len) =
  if i == len then False
  else if (list-at names i).value == target then True
  else name-list-has-loop names target (i + 1) len

resolve-declared-type : UnificationState, TypeEnv, ADef -> DefSetup
resolve-declared-type (st) (env) (def) =
  if list-length (def.declared-type) == 0 then let pcount = list-length (def.params)
  in let fun-built = build-undeclared-fun-type st pcount
  in DefSetup {
   expected-type = fun-built.fun-type,
   remaining-type = fun-built.fun-type,
   state = fun-built.state,
   env = env
  }
  else let env-type = env-lookup env (def.name.value)
  in let inst = instantiate-type st env-type
  in DefSetup {
   expected-type = inst.var-type,
   remaining-type = inst.var-type,
   state = inst.state,
   env = env
  }

build-undeclared-fun-type : UnificationState, Integer -> FunBuiltResult
build-undeclared-fun-type (st) (pcount) =
  let body-fr = fresh-and-advance st
  in if pcount == 0 then FunBuiltResult {
   fun-type = body-fr.var-type,
   state = body-fr.state
  }
     else build-fun-type-loop (body-fr.state) pcount (body-fr.var-type)

build-fun-type-loop : UnificationState, Integer, CodexType -> FunBuiltResult
build-fun-type-loop (st) (n) (acc) =
  if n == 0 then FunBuiltResult {
   fun-type = acc,
   state = st
  }
  else let fr = fresh-and-advance st
  in build-fun-type-loop (fr.state) (n - 1) (FunTy (fr.var-type) acc)

bind-def-params : UnificationState, TypeEnv, List AParam, CodexType, Integer, Integer -> DefParamResult
bind-def-params (st) (env) (params) (remaining) (i) (len) =
  if i == len then DefParamResult {
   state = st,
   env = env,
   remaining-type = remaining
  }
  else let p = list-at params i
  in when remaining
   is FunTy (param-ty) (ret-ty) -> let env2 = env-bind-local env (p.name.value) param-ty
   in bind-def-params st env2 params ret-ty (i + 1) len
   is otherwise -> let fr = fresh-and-advance st
   in let env2 = env-bind-local env (p.name.value) (fr.var-type)
   in bind-def-params (fr.state) env2 params remaining (i + 1) len

register-mutable-markers : TypeEnv, List ATypeDef, Integer, Integer -> TypeEnv
register-mutable-markers (env) (tdefs) (i) (len) =
  if i >= len then env
  else let td = list-at tdefs i
  in when td
   is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) -> if is-mut then let marker-name = "__mutable-" & name.value
   in register-mutable-markers (env-bind env marker-name int-ty-default) tdefs (i + 1) len
   else register-mutable-markers env tdefs (i + 1) len
   is AVariantTypeDef (name) (tparams) (ctors) (s) -> register-mutable-markers env tdefs (i + 1) len

collect-mutable-names : List ATypeDef, Integer, Integer, List Text -> List Text
collect-mutable-names (tdefs) (i) (len) (acc) =
  if i >= len then acc
  else let td = list-at tdefs i
  in when td
   is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) -> if is-mut then collect-mutable-names tdefs (i + 1) len (list-push acc (name.value))
   else collect-mutable-names tdefs (i + 1) len acc
   is AVariantTypeDef (name) (tparams) (ctors) (s) -> collect-mutable-names tdefs (i + 1) len acc

check-chapter : AChapter -> ChapterResult
check-chapter (mod) =
  let tdm = build-type-def-map (mod.type-defs) 0 (list-length (mod.type-defs)) []
  in let arity-errors = check-all-type-arities tdm mod
  in let tenv = register-type-defs empty-unification-state builtin-type-env tdm (mod.type-defs) 0 (list-length (mod.type-defs))
  in let st-with-arity = add-diagnostics-to-state (tenv.state) arity-errors 0 (list-length arity-errors)
  in let env-with-mut = register-mutable-markers (tenv.env) (mod.type-defs) 0 (list-length (mod.type-defs))
  in let env = register-all-defs st-with-arity env-with-mut tdm (mod.defs) 0 (list-length (mod.defs))
  in let env2 = register-effect-ops (env.state) (env.env) tdm (mod.effect-defs) 0 (list-length (mod.effect-defs))
  in let sorted-env = env-finalize (env2.env)
  in let pre-st = deck-record (UnificationState {
    substitutions = copy-list-with-headroom (env2.state.substitutions) substitution-capacity,
    next-id = env2.state.next-id,
    bag = env2.state.bag,
    expr-types = copy-list-with-headroom (env2.state.expr-types) expr-type-capacity
   })
  in let def-count = list-length (mod.defs)
  in let acc0 = deck-record (__list-with-capacity def-count)
  in check-all-defs pre-st sorted-env (mod.defs) 0 def-count acc0

add-diagnostics-to-state : UnificationState, List Diagnostic, Integer, Integer -> UnificationState
add-diagnostics-to-state (st) (diags) (i) (len) =
  if i == len then st
  else let d = list-at diags i
  in add-diagnostics-to-state (__record-set st "bag" (bag-add (st.bag) d)) diags (i + 1) len

register-all-defs : UnificationState, TypeEnv, List TypeBinding, List ADef, Integer, Integer -> LetBindResult
register-all-defs (st) (env) (tdm) (defs) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let def = list-at defs i
  in let ty = if list-length (def.declared-type) == 0 then let fr = fresh-and-advance st
   in let env2 = env-bind env (def.name.value) (fr.var-type)
   in LetBindResult {
    state = fr.state,
    env = env2
   }
   else let resolved = resolve-type-expr tdm (list-at (def.declared-type) 0)
   in let pr = parameterize-type st resolved
   in LetBindResult {
    state = pr.state,
    env = env-bind env (def.name.value) (pr.parameterized)
   }
  in register-all-defs (ty.state) (ty.env) tdm defs (i + 1) len

register-effect-ops : UnificationState, TypeEnv, List TypeBinding, List AEffectDef, Integer, Integer -> LetBindResult
register-effect-ops (st) (env) (tdm) (effs) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let eff = list-at effs i
  in let after = register-effect-ops-of st env tdm (eff.ops) 0 (list-length (eff.ops))
  in register-effect-ops (after.state) (after.env) tdm effs (i + 1) len

register-effect-ops-of : UnificationState, TypeEnv, List TypeBinding, List AEffectOpDef, Integer, Integer -> LetBindResult
register-effect-ops-of (st) (env) (tdm) (ops) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let op = list-at ops i
  in if env-has-unsorted env (op.name.value) then register-effect-ops-of st env tdm ops (i + 1) len
     else let resolved = resolve-type-expr tdm (op.type-expr)
  in let pr = parameterize-type st resolved
  in register-effect-ops-of (pr.state) (env-bind env (op.name.value) (pr.parameterized)) tdm ops (i + 1) len

check-all-defs : UnificationState, TypeEnv, List ADef, Integer, Integer, List TypeBinding -> ChapterResult
check-all-defs (st) (env) (defs) (i) (len) (acc) =
  if i == len then ChapterResult {
   types = acc,
   env = env,
   state = st
  }
  else let def = list-at defs i
  in let fresh-env = __record-set env "locals" []
  in let r = check-def st fresh-env def
  in let resolved = deep-resolve (r.state) (r.inferred-type)
  in let entry = deck-record (TypeBinding {
    name = def.name.value,
    bound-type = resolved
   })
  in check-all-defs (r.state) env defs (i + 1) len (list-push acc entry)

build-type-def-map : List ATypeDef, Integer, Integer, List TypeBinding -> List TypeBinding
build-type-def-map (tdefs) (i) (len) (acc) =
  if i == len then acc
  else let td = list-at tdefs i
  in let entry = when td
    is AVariantTypeDef (name) (type-params) (ctors) (s) -> let sum-ctors = build-sum-ctors tdefs ctors 0 (list-length ctors) [] acc
    in let ty-args = type-params-to-refs type-params 0 (list-length type-params) []
    in deck-record (TypeBinding {
     name = name.value,
     bound-type = deck-record (SumTy name ty-args sum-ctors)
    })
    is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) -> let rec-fields = build-record-fields-for-map tdefs fields 0 (list-length fields) [] acc
    in let ty-args = type-params-to-refs type-params 0 (list-length type-params) []
    in deck-record (TypeBinding {
     name = name.value,
     bound-type = deck-record (RecordTy name ty-args rec-fields)
    })
  in build-type-def-map tdefs (i + 1) len (list-insert-at acc (bsearch-text-pos acc (entry.name) 0 (list-length acc)) entry)

build-sum-ctors : List ATypeDef, List AVariantCtorDef, Integer, Integer, List SumCtor, List TypeBinding -> List SumCtor
build-sum-ctors (tdefs) (ctors) (i) (len) (acc) (partial-tdm) =
  if i == len then acc
  else let c = list-at ctors i
  in let field-types = resolve-type-expr-list-for-map tdefs (c.fields) 0 (list-length (c.fields)) [] partial-tdm
  in let sc = deck-record (SumCtor {
    name = c.name,
    fields = field-types
   })
  in build-sum-ctors tdefs ctors (i + 1) len (list-push acc sc) partial-tdm

build-record-fields-for-map : List ATypeDef, List ARecordFieldDef, Integer, Integer, List RecordField, List TypeBinding -> List RecordField
build-record-fields-for-map (tdefs) (fields) (i) (len) (acc) (partial-tdm) =
  if i == len then acc
  else let f = list-at fields i
  in let rfield = deck-record (RecordField {
    name = f.name,
    type-val = resolve-type-expr partial-tdm (f.type-expr)
   })
  in build-record-fields-for-map tdefs fields (i + 1) len (list-push acc rfield) partial-tdm

resolve-type-expr-list-for-map : List ATypeDef, List ATypeExpr, Integer, Integer, List CodexType, List TypeBinding -> List CodexType
resolve-type-expr-list-for-map (tdefs) (args) (i) (len) (acc) (partial-tdm) =
  if i == len then acc
  else resolve-type-expr-list-for-map tdefs args (i + 1) len (list-push acc (resolve-type-expr partial-tdm (list-at args i))) partial-tdm

register-type-defs : UnificationState, TypeEnv, List TypeBinding, List ATypeDef, Integer, Integer -> LetBindResult
register-type-defs (st) (env) (tdm) (tdefs) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let td = list-at tdefs i
  in let r = register-one-type-def st env tdm td
  in register-type-defs (r.state) (r.env) tdm tdefs (i + 1) len

type-params-to-refs : List Name, Integer, Integer, List CodexType -> List CodexType
type-params-to-refs (params) (i) (len) (acc) =
  if i == len then acc
  else let p = list-at params i
  in type-params-to-refs params (i + 1) len (list-push acc (deck-record (ConstructedTy p [])))

register-one-type-def : UnificationState, TypeEnv, List TypeBinding, ATypeDef -> LetBindResult
register-one-type-def (st) (env) (tdm) (td) =
  when td
   is AVariantTypeDef (name) (type-params) (ctors) (s) -> let sum-ty = lookup-type-def tdm (name.value)
   in let env1 = env-bind env (name.value) sum-ty
   in let result-ty = if list-length type-params == 0 then sum-ty
    else deck-record (ConstructedTy name (type-params-to-refs type-params 0 (list-length type-params) []))
   in register-variant-ctors st env1 tdm ctors result-ty 0 (list-length ctors)
   is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) -> let resolved-fields = build-record-fields tdm fields 0 (list-length fields) []
   in let ty-args = type-params-to-refs type-params 0 (list-length type-params) []
   in let result-ty = deck-record (RecordTy name ty-args resolved-fields)
   in let ctor-ty = build-record-ctor-type tdm fields result-ty 0 (list-length fields)
   in let pr = parameterize-type st ctor-ty
   in LetBindResult {
    state = pr.state,
    env = env-bind env (name.value) (pr.parameterized)
   }

build-record-fields : List TypeBinding, List ARecordFieldDef, Integer, Integer, List RecordField -> List RecordField
build-record-fields (tdm) (fields) (i) (len) (acc) =
  if i == len then acc
  else let f = list-at fields i
  in let rfield = deck-record (RecordField {
    name = f.name,
    type-val = resolve-type-expr tdm (f.type-expr)
   })
  in build-record-fields tdm fields (i + 1) len (list-push acc rfield)

lookup-record-field : List RecordField, Text -> CodexType
lookup-record-field (fields) (name) =
  if list-length fields == 0 then ErrorTy
  else let f = list-at fields 0
  in if f.name.value == name then f.type-val
     else lookup-record-field-loop fields name 1 (list-length fields)

lookup-record-field-loop : List RecordField, Text, Integer, Integer -> CodexType
lookup-record-field-loop (fields) (name) (i) (len) =
  if i == len then ErrorTy
  else let f = list-at fields i
  in if f.name.value == name then f.type-val
     else lookup-record-field-loop fields name (i + 1) len

register-variant-ctors : UnificationState, TypeEnv, List TypeBinding, List AVariantCtorDef, CodexType, Integer, Integer -> LetBindResult
register-variant-ctors (st) (env) (tdm) (ctors) (result-ty) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let ctor = list-at ctors i
  in let ctor-ty = build-ctor-type tdm (ctor.fields) result-ty 0 (list-length (ctor.fields))
  in let pr = parameterize-type st ctor-ty
  in let env2 = env-bind env (ctor.name.value) (pr.parameterized)
  in register-variant-ctors (pr.state) env2 tdm ctors result-ty (i + 1) len

build-ctor-type : List TypeBinding, List ATypeExpr, CodexType, Integer, Integer -> CodexType
build-ctor-type (tdm) (fields) (result) (i) (len) =
  if i == len then result
  else let rest = build-ctor-type tdm fields result (i + 1) len
  in deck-record (FunTy (resolve-type-expr tdm (list-at fields i)) rest)

build-record-ctor-type : List TypeBinding, List ARecordFieldDef, CodexType, Integer, Integer -> CodexType
build-record-ctor-type (tdm) (fields) (result) (i) (len) =
  if i == len then result
  else let f = list-at fields i
  in let rest = build-record-ctor-type tdm fields result (i + 1) len
  in deck-record (FunTy (resolve-type-expr tdm (f.type-expr)) rest)

flatten-app : ATypeExpr, List ATypeExpr -> FlatAppResult
flatten-app (expr) (outer-args) =
  when expr
   is AAppType (ctor) (args) (s) -> flatten-app ctor (args & outer-args)
   is otherwise -> FlatAppResult {
    ctor = expr,
    args = outer-args
   }

expected-arity-for : Text, List TypeBinding -> Integer
expected-arity-for (name) (tdm) =
  if name == "List" then 1
  else if name == "LinkedList" then 1
  else let t = lookup-type-def tdm name
  in when t
   is RecordTy (n) (args) (fields) -> list-length args
   is SumTy (n) (args) (ctors) -> list-length args
   is otherwise -> -1

atype-named : ATypeExpr -> Text
atype-named (expr) =
  when expr
   is ANamedType (name) (s) -> name.value
   is otherwise -> ""

check-arity-in-expr : List TypeBinding, ATypeExpr, List Diagnostic -> List Diagnostic
check-arity-in-expr (tdm) (expr) (acc) =
  when expr
   is AAppType (ctor) (args) (s) -> let flat = flatten-app ctor args
   in let flat-name = atype-named (flat.ctor)
   in let expected = if text-length flat-name == 0 then -1
    else expected-arity-for flat-name tdm
   in let actual = list-length (flat.args)
   in let acc2 = if expected >= 0 & actual /= expected then list-push acc (make-error cdx-type-arity ("Type '" & flat-name & "' expects " & integer-to-text expected & " type argument(s), got " & integer-to-text actual) s)
    else acc
   in check-arity-in-expr-list tdm (flat.args) 0 (list-length (flat.args)) acc2
   is AFunType (param) (ret) (s) -> check-arity-in-expr tdm ret (check-arity-in-expr tdm param acc)
   is AEffectType (effs) (scopes) (ret) (s) -> check-arity-in-expr tdm ret acc
   is otherwise -> acc

check-arity-in-expr-list : List TypeBinding, List ATypeExpr, Integer, Integer, List Diagnostic -> List Diagnostic
check-arity-in-expr-list (tdm) (xs) (i) (len) (acc) =
  if i == len then acc
  else check-arity-in-expr-list tdm xs (i + 1) len (check-arity-in-expr tdm (list-at xs i) acc)

check-arity-in-record-fields : List TypeBinding, List ARecordFieldDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-arity-in-record-fields (tdm) (fields) (i) (len) (acc) =
  if i == len then acc
  else let f = list-at fields i
  in check-arity-in-record-fields tdm fields (i + 1) len (check-arity-in-expr tdm (f.type-expr) acc)

check-arity-in-variant-ctors : List TypeBinding, List AVariantCtorDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-arity-in-variant-ctors (tdm) (ctors) (i) (len) (acc) =
  if i == len then acc
  else let c = list-at ctors i
  in check-arity-in-variant-ctors tdm ctors (i + 1) len (check-arity-in-expr-list tdm (c.fields) 0 (list-length (c.fields)) acc)

check-arity-in-typedef : List TypeBinding, ATypeDef, List Diagnostic -> List Diagnostic
check-arity-in-typedef (tdm) (td) (acc) =
  when td
   is AVariantTypeDef (name) (type-params) (ctors) (s) -> check-arity-in-variant-ctors tdm ctors 0 (list-length ctors) acc
   is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) -> check-arity-in-record-fields tdm fields 0 (list-length fields) acc

check-arity-in-def : List TypeBinding, ADef, List Diagnostic -> List Diagnostic
check-arity-in-def (tdm) (def) (acc) =
  if list-length (def.declared-type) == 0 then acc
  else check-arity-in-expr tdm (list-at (def.declared-type) 0) acc

check-arity-in-defs : List TypeBinding, List ADef, Integer, Integer, List Diagnostic -> List Diagnostic
check-arity-in-defs (tdm) (defs) (i) (len) (acc) =
  if i == len then acc
  else check-arity-in-defs tdm defs (i + 1) len (check-arity-in-def tdm (list-at defs i) acc)

check-arity-in-typedefs : List TypeBinding, List ATypeDef, Integer, Integer, List Diagnostic -> List Diagnostic
check-arity-in-typedefs (tdm) (tdefs) (i) (len) (acc) =
  if i == len then acc
  else check-arity-in-typedefs tdm tdefs (i + 1) len (check-arity-in-typedef tdm (list-at tdefs i) acc)

check-all-type-arities : List TypeBinding, AChapter -> List Diagnostic
check-all-type-arities (tdm) (mod) =
  let defs-errors = check-arity-in-defs tdm (mod.defs) 0 (list-length (mod.defs)) []
  in check-arity-in-typedefs tdm (mod.type-defs) 0 (list-length (mod.type-defs)) defs-errors

granted-capabilities : List Text
granted-capabilities =
  ["Console", "Console.Read", "Console.Write", "FileSystem", "FileSystem.Read", "FileSystem.Write", "Network", "Network.Read", "Network.Write", "Concurrent"]

check-opening-capabilities : List TypeBinding -> List Diagnostic
check-opening-capabilities (types) =
  let opening-ty = find-opening-type types 0 (list-length types)
  in let effs = extract-effects opening-ty
  in check-cap-list effs granted-capabilities 0 (list-length effs)

find-opening-type : List TypeBinding, Integer, Integer -> CodexType
find-opening-type (types) (i) (len) =
  if i == len then NothingTy
  else let t = list-at types i
  in if t.name == "opening" then strip-fun-args-for-cap (t.bound-type)
     else find-opening-type types (i + 1) len

strip-fun-args-for-cap : CodexType -> CodexType
strip-fun-args-for-cap (ty) =
  when ty
   is FunTy (p) (r) -> strip-fun-args-for-cap r
   is ForAllTy (id) (body) -> strip-fun-args-for-cap body
   is otherwise -> ty

check-cap-list : List Name, List Text, Integer, Integer -> List Diagnostic
check-cap-list (effs) (granted) (i) (len) =
  if i == len then []
  else let e = list-at effs i
  in let rest = check-cap-list effs granted (i + 1) len
  in if cap-name-covered granted (e.value) 0 (list-length granted) then rest
     else list-push rest (make-error cdx-capability-not-granted ("Effect '" & e.value & "' is not a granted capability") synthetic-span)

cap-name-covered : List Text, Text, Integer, Integer -> Boolean
cap-name-covered (granted) (eff) (i) (len) =
  if i == len then let dot-pos = find-dot eff 0 (text-length eff)
  in if dot-pos >= 0 then cap-name-covered granted (substring eff 0 dot-pos) 0 len
     else False
  else if list-at-text granted i == eff then True
  else cap-name-covered granted eff (i + 1) len

list-at-text : List Text, Integer -> Text
list-at-text (xs) (i) =
  list-at xs i

infer-literal : UnificationState, LiteralKind -> CheckResult
infer-literal (st) (kind) =
  when kind
   is IntLit -> CheckResult {
    inferred-type = int-ty-default,
    state = st
   }
   is NumLit -> CheckResult {
    inferred-type = NumberTy,
    state = st
   }
   is TextLit -> CheckResult {
    inferred-type = TextTy,
    state = st
   }
   is CharLit -> CheckResult {
    inferred-type = CharTy,
    state = st
   }
   is BoolLit -> CheckResult {
    inferred-type = BooleanTy,
    state = st
   }

infer-name : UnificationState, TypeEnv, Text, SourceSpan -> CheckResult
infer-name (st) (env) (name) (span) =
  if env-has env name then let raw = env-lookup env name
  in let inst = instantiate-type st raw
  in CheckResult {
   inferred-type = inst.var-type,
   state = record-expr-type (inst.state) span (inst.var-type)
  }
  else CheckResult {
   inferred-type = ErrorTy,
   state = add-unify-error st cdx-unknown-name ("Unknown name: " & name) span
  }

instantiate-type : UnificationState, CodexType -> FreshResult
instantiate-type (st) (ty) =
  when ty
   is ForAllTy (var-id) (body) -> let fr = fresh-and-advance st
   in let substituted = subst-type-var body var-id (fr.var-type)
   in instantiate-type (fr.state) substituted
   is otherwise -> FreshResult {
    var-type = ty,
    state = st
   }

subst-type-var : CodexType, Integer, CodexType -> CodexType
subst-type-var (ty) (var-id) (replacement) =
  if ty-has-typevars ty == False then ty
  else when ty
   is TypeVar (id) -> if id == var-id then replacement
   else ty
   is ForAllTy (inner-id) (body) -> if inner-id == var-id then ty
   else deck-record (ForAllTy inner-id (subst-type-var body var-id replacement))
   is otherwise -> codex-type-map-children (\c -> subst-type-var c var-id replacement) ty

infer-binary : UnificationState, TypeEnv, AExpr, BinaryOp, AExpr, SourceSpan -> CheckResult
infer-binary (st) (env) (left) (op) (right) (span) =
  let lr = infer-expr st env left
  in let rr = infer-expr (lr.state) env right
  in infer-binary-op (rr.state) (lr.inferred-type) (rr.inferred-type) op span

infer-binary-op : UnificationState, CodexType, CodexType, BinaryOp, SourceSpan -> CheckResult
infer-binary-op (st) (lt) (rt) (op) (span) =
  when op
   is OpAdd -> infer-arithmetic st lt rt span
   is OpSub -> infer-arithmetic st lt rt span
   is OpMul -> infer-arithmetic st lt rt span
   is OpDiv -> infer-arithmetic st lt rt span
   is OpPow -> infer-arithmetic st lt rt span
   is OpEq -> infer-comparison st lt rt span
   is OpNotEq -> infer-comparison st lt rt span
   is OpLt -> infer-comparison st lt rt span
   is OpGt -> infer-comparison st lt rt span
   is OpLtEq -> infer-comparison st lt rt span
   is OpGtEq -> infer-comparison st lt rt span
   is OpAnd -> infer-and st lt rt span
   is OpOr -> infer-logical st lt rt span
   is OpAppend -> infer-append st lt rt span
   is OpCons -> infer-cons st lt rt span
   is OpDefEq -> infer-comparison st lt rt span

infer-arithmetic : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-arithmetic (st) (lt) (rt) (span) =
  let r = unify st lt rt span
  in let resolved-l = resolve-silent (r.state) lt
  in let resolved-r = resolve-silent (r.state) rt
  in let st2 = if is-arithmetic-type resolved-l & is-arithmetic-type resolved-r then r.state
   else add-unify-error (r.state) cdx-arithmetic-requires-numeric "Arithmetic operator requires Integer or Number" span
  in CheckResult {
   inferred-type = lt,
   state = st2
  }

is-arithmetic-type : CodexType -> Boolean
is-arithmetic-type (ty) =
  when ty
   is IntegerTy (lo) (hi) (mode) -> True
   is NumberTy -> True
   is TypeVar (id) -> True
   is ErrorTy -> True
   is otherwise -> False

infer-comparison : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-comparison (st) (lt) (rt) (span) =
  let r = unify st lt rt span
  in CheckResult {
   inferred-type = BooleanTy,
   state = r.state
  }

infer-logical : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-logical (st) (lt) (rt) (span) =
  let r1 = unify st lt BooleanTy span
  in let r2 = unify (r1.state) rt BooleanTy span
  in CheckResult {
   inferred-type = BooleanTy,
   state = r2.state
  }

infer-and : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-and (st) (lt) (rt) (span) =
  let resolved = resolve-silent st lt
  in when resolved
   is BooleanTy -> infer-logical st lt rt span
   is TextTy -> infer-append st lt rt span
   is otherwise -> infer-append st lt rt span

infer-append : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-append (st) (lt) (rt) (span) =
  let resolved = resolve-silent st lt
  in when resolved
   is TextTy -> let r = unify st rt TextTy span
   in CheckResult {
    inferred-type = TextTy,
    state = r.state
   }
   is otherwise -> let r = unify st lt rt span
   in CheckResult {
    inferred-type = lt,
    state = r.state
   }

infer-cons : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
infer-cons (st) (lt) (rt) (span) =
  let list-ty = deck-record (ListTy lt)
  in let r = unify st rt list-ty span
  in CheckResult {
   inferred-type = list-ty,
   state = r.state
  }

infer-if : UnificationState, TypeEnv, AExpr, AExpr, AExpr, SourceSpan -> CheckResult
infer-if (st) (env) (cond) (then-e) (else-e) (span) =
  let cr = infer-expr st env cond
  in let r1 = unify (cr.state) (cr.inferred-type) BooleanTy (aexpr-span cond)
  in let tr = infer-expr (r1.state) env then-e
  in let er = infer-expr (tr.state) env else-e
  in let r2 = unify (er.state) (tr.inferred-type) (er.inferred-type) span
  in CheckResult {
   inferred-type = tr.inferred-type,
   state = r2.state
  }

infer-let : UnificationState, TypeEnv, List ALetBind, AExpr -> CheckResult
infer-let (st) (env) (bindings) (body) =
  let env2 = infer-let-bindings st env bindings 0 (list-length bindings)
  in infer-expr (env2.state) (env2.env) body

infer-let-bindings : UnificationState, TypeEnv, List ALetBind, Integer, Integer -> LetBindResult
infer-let-bindings (st) (env) (bindings) (i) (len) =
  if i == len then LetBindResult {
   state = st,
   env = env
  }
  else let b = list-at bindings i
  in let vr = infer-expr st env (b.value)
  in let resolved-ty = deep-resolve (vr.state) (vr.inferred-type)
  in let bound-ty = unwrap-effectful-or-error resolved-ty (b.name.value) (aexpr-span (b.value)) (vr.state)
  in let env2 = env-bind-local env (b.name.value) (bound-ty.ty)
  in infer-let-bindings (bound-ty.state) env2 bindings (i + 1) len

unwrap-effectful-or-error : CodexType, Text, SourceSpan, UnificationState -> UnwrapResult
unwrap-effectful-or-error (ty) (name) (span) (st) =
  when ty
   is EffectfulTy (effs) (sc) (inner) -> if list-length effs == 0 then UnwrapResult {
    ty = ty,
    state = st
   }
   else UnwrapResult {
    ty = inner,
    state = add-unify-error st cdx-let-binds-effectful-value ("let-binding '" & name & "' to an effectful value is not allowed outside an act-bind. Use '" & name & " <- ...' inside an act block.") span
   }
   is otherwise -> UnwrapResult {
    ty = ty,
    state = st
   }

infer-lambda : UnificationState, TypeEnv, List Name, AExpr -> CheckResult
infer-lambda (st) (env) (params) (body) =
  let pr = bind-lambda-params st env params 0 (list-length params) []
  in let br = infer-expr (pr.state) (pr.env) body
  in let fun-ty = wrap-fun-type (pr.param-types) (br.inferred-type)
  in CheckResult {
   inferred-type = fun-ty,
   state = br.state
  }

bind-lambda-params : UnificationState, TypeEnv, List Name, Integer, Integer, List CodexType -> LambdaBindResult
bind-lambda-params (st) (env) (params) (i) (len) (acc) =
  if i == len then LambdaBindResult {
   state = st,
   env = env,
   param-types = acc
  }
  else let p = list-at params i
  in let fr = fresh-and-advance st
  in let env2 = env-bind-local env (p.value) (fr.var-type)
  in bind-lambda-params (fr.state) env2 params (i + 1) len (list-push acc (fr.var-type))

wrap-fun-type : List CodexType, CodexType -> CodexType
wrap-fun-type (param-types) (result) =
  wrap-fun-type-loop param-types result (list-length param-types - 1)

wrap-fun-type-loop : List CodexType, CodexType, Integer -> CodexType
wrap-fun-type-loop (param-types) (result) (i) =
  if i < 0 then result
  else wrap-fun-type-loop param-types (deck-record (FunTy (list-at param-types i) result)) (i - 1)

infer-application : UnificationState, TypeEnv, AExpr, AExpr, SourceSpan -> CheckResult
infer-application (st) (env) (func) (arg) (span) =
  let fr = infer-expr st env func
  in let ar = when arg
    is ALitExpr (val) (kind) (s) -> infer-int-lit-arg (fr.state) (fr.inferred-type) val kind
    is otherwise -> infer-expr (fr.state) env arg
  in let ret = fresh-and-advance (ar.state)
  in let r = unify (ret.state) (fr.inferred-type) (deck-record (FunTy (ar.inferred-type) (ret.var-type))) span
  in let st-final = lint-record-set (r.state) env func arg (ar.inferred-type) (ret.var-type) span
  in CheckResult {
   inferred-type = ret.var-type,
   state = st-final
  }

lint-record-set : UnificationState, TypeEnv, AExpr, AExpr, CodexType, CodexType, SourceSpan -> UnificationState
lint-record-set (st) (env) (func) (value-arg) (value-ty) (return-ty) (span) =
  when func
   is AApplyExpr (inner-func) (field-name-arg) (s2) -> when inner-func
    is AApplyExpr (rs-name) (obj-arg) (s3) -> when rs-name
     is ANameExpr (n) (s4) -> if n.value == "__record-set" then lint-record-set-check st env value-arg value-ty return-ty field-name-arg span
     else st
     is otherwise -> st
    is otherwise -> st
   is otherwise -> st

lint-record-set-check : UnificationState, TypeEnv, AExpr, CodexType, CodexType, AExpr, SourceSpan -> UnificationState
lint-record-set-check (st) (env) (value-arg) (value-ty) (return-ty) (field-name-arg) (span) =
  when field-name-arg
   is ALitExpr (text-val) (kind) (s) -> when kind
    is TextLit -> let resolved-record-ty = deep-resolve st return-ty
    in let field-ty = lookup-field-ty-for-lint env resolved-record-ty text-val
    in lint-narrowing-check st value-arg value-ty field-ty span text-val
    is otherwise -> st
   is otherwise -> st

lookup-field-ty-for-lint : TypeEnv, CodexType, Text -> CodexType
lookup-field-ty-for-lint (env) (ty) (field-name) =
  when ty
   is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields field-name
   is ConstructedTy (cname) (cargs) -> let rec-ty = resolve-constructed-to-record env (cname.value)
   in when rec-ty
    is RecordTy (rname) (rargs) (rfields) -> let raw-ftype = lookup-record-field rfields field-name
    in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
    is otherwise -> ErrorTy
   is otherwise -> ErrorTy

is-narrow-call : AExpr -> Boolean
is-narrow-call (e) =
  when e
   is AApplyExpr (func) (arg) (s) -> when func
    is ANameExpr (name) (s2) -> name.value == "__narrow"
    is otherwise -> False
   is otherwise -> False

lint-narrowing-check : UnificationState, AExpr, CodexType, CodexType, SourceSpan, Text -> UnificationState
lint-narrowing-check (st) (value-arg) (value-ty) (field-ty) (span) (field-name) =
  if is-narrow-call value-arg then st
  else when field-ty
   is IntegerTy (f-lo) (f-hi) (f-mode) -> when f-mode
    is OvError -> when value-arg
     is ALitExpr (val-text) (kind) (s) -> when kind
      is IntLit -> let n = text-to-integer val-text
      in if n >= f-lo & n <= f-hi then st
         else __record-set st "bag" (bag-add (st.bag) (make-error cdx-narrowing-record-set-literal ("Field '" & field-name & "' has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but assigned literal " & integer-to-text n & " is out of range") span))
      is otherwise -> st
     is otherwise -> let resolved-vty = deep-resolve st value-ty
     in when resolved-vty
      is IntegerTy (v-lo) (v-hi) (v-mode) -> if v-lo >= f-lo & v-hi <= f-hi then st
      else __record-set st "bag" (bag-add (st.bag) (make-warning cdx-narrowing-record-set ("Field '" & field-name & "' has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but value type is " & integer-to-text v-lo & ".." & integer-to-text v-hi & "; codegen will silently truncate if runtime value exceeds bound") span))
      is otherwise -> st
    is otherwise -> st
   is otherwise -> st

infer-int-lit-arg : UnificationState, CodexType, Text, LiteralKind -> CheckResult
infer-int-lit-arg (st) (func-ty) (val) (kind) =
  when kind
   is IntLit -> let stripped = strip-forall-ty func-ty
   in when stripped
    is FunTy (param-ty) (ret-ty) -> when param-ty
     is IntegerTy (lo) (hi) (mode) -> let n = text-to-integer val
     in if n >= lo & n <= hi then CheckResult {
      inferred-type = deck-record (IntegerTy lo hi mode),
      state = st
     }
        else infer-literal st kind
     is otherwise -> infer-literal st kind
    is otherwise -> infer-literal st kind
   is otherwise -> infer-literal st kind

infer-list : UnificationState, TypeEnv, List AExpr, SourceSpan -> CheckResult
infer-list (st) (env) (elems) (span) =
  if list-length elems == 0 then let fr = fresh-and-advance st
  in CheckResult {
   inferred-type = fr.var-type,
   state = fr.state
  }
  else let first = infer-expr st env (list-at elems 0)
  in let st2 = unify-list-elems (first.state) env elems (first.inferred-type) 1 (list-length elems)
  in CheckResult {
   inferred-type = deck-record (ListTy (first.inferred-type)),
   state = st2
  }

unify-list-elems : UnificationState, TypeEnv, List AExpr, CodexType, Integer, Integer -> UnificationState
unify-list-elems (st) (env) (elems) (elem-ty) (i) (len) =
  if i == len then st
  else let e = list-at elems i
  in let er = infer-expr st env e
  in let r = unify (er.state) (er.inferred-type) elem-ty (aexpr-span e)
  in unify-list-elems (r.state) env elems elem-ty (i + 1) len

infer-match : UnificationState, TypeEnv, AExpr, List AMatchArm -> CheckResult
infer-match (st) (env) (scrutinee) (arms) =
  let sr = infer-expr st env scrutinee
  in let fr = fresh-and-advance (sr.state)
  in let st2 = infer-match-arms (fr.state) env (sr.inferred-type) (fr.var-type) arms 0 (list-length arms)
  in CheckResult {
   inferred-type = fr.var-type,
   state = st2
  }

infer-match-arms : UnificationState, TypeEnv, CodexType, CodexType, List AMatchArm, Integer, Integer -> UnificationState
infer-match-arms (st) (env) (scrut-ty) (result-ty) (arms) (i) (len) =
  if i == len then st
  else let arm = list-at arms i
  in let pr = bind-pattern st env (arm.pattern) scrut-ty
  in let br = infer-expr (pr.state) (pr.env) (arm.body)
  in let r = unify (br.state) (br.inferred-type) result-ty (aexpr-span (arm.body))
  in infer-match-arms (r.state) env scrut-ty result-ty arms (i + 1) len

bind-pattern : UnificationState, TypeEnv, APat, CodexType -> PatBindResult
bind-pattern (st) (env) (pat) (ty) =
  when pat
   is AVarPat (name) (s) -> PatBindResult {
    state = st,
    env = env-bind-local env (name.value) ty
   }
   is AWildPat (s) -> PatBindResult {
    state = st,
    env = env
   }
   is ALitPat (val) (kind) (s) -> PatBindResult {
    state = st,
    env = env
   }
   is ACtorPat (ctor-name) (sub-pats) (s) -> let ctor-lookup = instantiate-type st (env-lookup env (ctor-name.value))
   in let ctor-ret = strip-fun-args (ctor-lookup.var-type)
   in let unified = unify (ctor-lookup.state) ctor-ret ty s
   in bind-ctor-sub-patterns (unified.state) env sub-pats (ctor-lookup.var-type) 0 (list-length sub-pats)

bind-ctor-sub-patterns : UnificationState, TypeEnv, List APat, CodexType, Integer, Integer -> PatBindResult
bind-ctor-sub-patterns (st) (env) (sub-pats) (ctor-ty) (i) (len) =
  if i == len then PatBindResult {
   state = st,
   env = env
  }
  else when ctor-ty
   is FunTy (param-ty) (ret-ty) -> let pr = bind-pattern st env (list-at sub-pats i) param-ty
   in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ret-ty (i + 1) len
   is otherwise -> let fr = fresh-and-advance st
   in let pr = bind-pattern (fr.state) env (list-at sub-pats i) (fr.var-type)
   in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ctor-ty (i + 1) len

infer-act : UnificationState, TypeEnv, List AActStmt -> CheckResult
infer-act (st) (env) (stmts) =
  infer-act-loop st env stmts 0 (list-length stmts) NothingTy

infer-act-loop : UnificationState, TypeEnv, List AActStmt, Integer, Integer, CodexType -> CheckResult
infer-act-loop (st) (env) (stmts) (i) (len) (last-ty) =
  if i == len then CheckResult {
   inferred-type = last-ty,
   state = st
  }
  else let stmt = list-at stmts i
  in when stmt
   is AActExprStmt (e) (s) -> let er = infer-expr st env e
   in infer-act-loop (er.state) env stmts (i + 1) len (er.inferred-type)
   is AActBindStmt (name) (e) (s) -> let er = infer-expr st env e
   in let bound-ty = when er.inferred-type
     is EffectfulTy (effs) (sc) (inner) -> inner
     is otherwise -> er.inferred-type
   in let env2 = env-bind-local env (name.value) bound-ty
   in infer-act-loop (er.state) env2 stmts (i + 1) len (er.inferred-type)

infer-expr : UnificationState, TypeEnv, AExpr -> CheckResult
infer-expr (st) (env) (expr) =
  infer-expr-at st env expr 0

infer-expr-at : UnificationState, TypeEnv, AExpr, Integer -> CheckResult
infer-expr-at (st) (env) (expr) (depth) =
  if depth >= max-recursion-depth then CheckResult {
   inferred-type = ErrorTy,
   state = add-unify-error st cdx-resource-exhausted ("compiler resource exhausted in type-checker.infer-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)
  }
  else when expr
   is ALitExpr (val) (kind) (s) -> infer-literal st kind
   is ANameExpr (name) (s) -> infer-name st env (name.value) s
   is ABinaryExpr (left) (op) (right) (s) -> infer-binary st env left op right s
   is AUnaryExpr (operand) (s) -> let r = infer-expr-at st env operand (depth + 1)
   in let u = unify (r.state) (r.inferred-type) int-ty-default (aexpr-span operand)
   in CheckResult {
    inferred-type = int-ty-default,
    state = u.state
   }
   is AApplyExpr (func) (arg) (s) -> infer-application st env func arg s
   is AIfExpr (cond) (then-e) (else-e) (s) -> infer-if st env cond then-e else-e s
   is ALetExpr (bindings) (body) (s) -> infer-let st env bindings body
   is ALambdaExpr (params) (body) (s) -> infer-lambda st env params body
   is AMatchExpr (scrutinee) (arms) (s) -> infer-match st env scrutinee arms
   is AListExpr (elems) (s) -> infer-list st env elems s
   is AActExpr (stmts) (s) -> infer-act st env stmts
   is AFieldAccess (obj) (field) (s) -> let r = infer-expr-at st env obj (depth + 1)
   in let resolved = deep-resolve (r.state) (r.inferred-type)
   in when resolved
    is RecordTy (rname) (rargs) (rfields) -> let ftype = lookup-record-field rfields (field.value)
    in let st2 = when ftype
      is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
      is otherwise -> r.state
    in CheckResult {
     inferred-type = ftype,
     state = st2
    }
    is ConstructedTy (cname) (cargs) -> let record-type = resolve-constructed-to-record env (cname.value)
    in when record-type
     is RecordTy (rname) (rargs) (rfields) -> let raw-ftype = lookup-record-field rfields (field.value)
     in let ftype = apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
     in let st2 = when raw-ftype
       is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type '" & cname.value & "' has no field '" & field.value & "'") s
       is otherwise -> r.state
     in CheckResult {
      inferred-type = ftype,
      state = st2
     }
     is otherwise -> let fr = fresh-and-advance (r.state)
     in CheckResult {
      inferred-type = fr.var-type,
      state = fr.state
     }
    is otherwise -> let fr = fresh-and-advance (r.state)
    in CheckResult {
     inferred-type = fr.var-type,
     state = fr.state
    }
   is ARecordExpr (name) (fields) (s) -> let ctor-raw = if env-has env (name.value) then env-lookup env (name.value)
    else ErrorTy
   in let inst = instantiate-type st ctor-raw
   in let result-type = strip-fun-args (inst.var-type)
   in let st2 = infer-and-unify-record-fields (inst.state) env fields result-type 0 (list-length fields)
   in CheckResult {
    inferred-type = result-type,
    state = record-expr-type st2 s result-type
   }
   is AHandleExpr (eff) (body) (clauses) (s) -> let handled-env = strip-effect-from-env env (eff.value)
   in let body-r = infer-expr-at st handled-env body (depth + 1)
   in CheckResult {
    inferred-type = strip-handled-effect (body-r.inferred-type) (eff.value),
    state = body-r.state
   }
   is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) -> infer-expr-at st env body (depth + 1)
   is ATryExpr (max) (body) (fb) (fail) (s) -> let body-r = infer-act st env body
   in let fb-r = if list-length fb > 0 then infer-act (body-r.state) env fb
    else body-r
   in let fail-r = if list-length fail > 0 then infer-act (fb-r.state) env fail
    else fb-r
   in CheckResult {
    inferred-type = body-r.inferred-type,
    state = fail-r.state
   }
   is AFieldAssignExpr (rec) (field) (val) (s) -> let rr = infer-expr-at st env rec (depth + 1)
   in let vr = infer-expr-at (rr.state) env val (depth + 1)
   in let resolved = deep-resolve (vr.state) (rr.inferred-type)
   in let type-name = when resolved
     is RecordTy (rname) (rargs) (rfields) -> rname.value
     is ConstructedTy (cname) (cargs) -> cname.value
     is otherwise -> ""
   in let marker-name = "__mutable-" & type-name
   in let mut-ok = env-has env marker-name
   in let st-mut = if mut-ok then vr.state
    else add-unify-error (vr.state) cdx-field-assign-immutable ("Field assignment requires a mutable record; '" & type-name & "' is immutable") s
   in let field-ty = when resolved
     is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (field.value)
     is ConstructedTy (cname) (cargs) -> let record-type = resolve-constructed-to-record env (cname.value)
     in when record-type
      is RecordTy (rname) (rargs) (rfields) -> let raw-ftype = lookup-record-field rfields (field.value)
      in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
      is otherwise -> ErrorTy
     is otherwise -> ErrorTy
   in let st2 = when field-ty
     is ErrorTy -> add-unify-error st-mut cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
     is otherwise -> (unify st-mut (vr.inferred-type) field-ty s).state
   in CheckResult {
    inferred-type = rr.inferred-type,
    state = st2
   }
   is AErrorExpr (msg) (s) -> CheckResult {
    inferred-type = ErrorTy,
    state = st
   }

strip-effect-from-env : TypeEnv, Text -> TypeEnv
strip-effect-from-env (env) (eff-name) =
  TypeEnv {
   bindings = strip-binding-list (env.bindings) eff-name 0 (list-length (env.bindings)) [],
   locals = env.locals
  }

strip-binding-list : List TypeBinding, Text, Integer, Integer, List TypeBinding -> List TypeBinding
strip-binding-list (bs) (eff-name) (i) (len) (acc) =
  if i == len then acc
  else let b = list-at bs i
  in let stripped = strip-handled-effect (b.bound-type) eff-name
  in strip-binding-list bs eff-name (i + 1) len (list-push acc (deck-record (TypeBinding {
   name = b.name,
   bound-type = stripped
  })))

strip-handled-effect : CodexType, Text -> CodexType
strip-handled-effect (ty) (eff-name) =
  when ty
   is EffectfulTy (effs) (scopes) (ret) -> let remaining = filter-effect effs eff-name 0 (list-length effs) []
   in if list-length remaining == 0 then ret
      else deck-record (EffectfulTy remaining scopes ret)
   is ForAllTy (id) (body) -> deck-record (ForAllTy id (strip-handled-effect body eff-name))
   is FunTy (param) (ret) -> deck-record (FunTy param (strip-handled-effect ret eff-name))
   is otherwise -> ty

filter-effect : List Name, Text, Integer, Integer, List Name -> List Name
filter-effect (effs) (eff-name) (i) (len) (acc) =
  if i == len then acc
  else let e = list-at effs i
  in if e.value == eff-name then filter-effect effs eff-name (i + 1) len acc
     else filter-effect effs eff-name (i + 1) len (list-push acc e)

resolve-constructed-to-record : TypeEnv, Text -> CodexType
resolve-constructed-to-record (env) (name) =
  if env-has env name then strip-fun-args (env-lookup env name)
  else ErrorTy

apply-type-args-subst : List CodexType, List CodexType, CodexType, Integer, Integer -> CodexType
apply-type-args-subst (generic) (concrete-args) (ty) (i) (len) =
  if i == len then ty
  else if i >= list-length concrete-args then ty
  else let g = list-at generic i
  in when g
   is TypeVar (id) -> apply-type-args-subst generic concrete-args (subst-type-var ty id (list-at concrete-args i)) (i + 1) len
   is otherwise -> apply-type-args-subst generic concrete-args ty (i + 1) len

infer-record-fields : UnificationState, TypeEnv, List AFieldExpr, Integer, Integer -> UnificationState
infer-record-fields (st) (env) (fields) (i) (len) =
  if i == len then st
  else let f = list-at fields i
  in let r = infer-expr st env (f.value)
  in infer-record-fields (r.state) env fields (i + 1) len

infer-and-unify-record-fields : UnificationState, TypeEnv, List AFieldExpr, CodexType, Integer, Integer -> UnificationState
infer-and-unify-record-fields (st) (env) (fields) (record-ty) (i) (len) =
  if i == len then st
  else let f = list-at fields i
  in let r = infer-expr st env (f.value)
  in let expected = when record-ty
    is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (f.name.value)
    is otherwise -> ErrorTy
  in let st2 = when expected
    is ErrorTy -> r.state
    is otherwise -> (unify (r.state) (r.inferred-type) expected (aexpr-span (f.value))).state
  in let st3 = lint-narrowing-check st2 (f.value) (r.inferred-type) expected (aexpr-span (f.value)) (f.name.value)
  in infer-and-unify-record-fields st3 env fields record-ty (i + 1) len

empty-type-env : TypeEnv
empty-type-env =
  TypeEnv {
   bindings = [],
   locals = []
  }

env-lookup-in : List TypeBinding, Text -> CodexType
env-lookup-in (bs) (name) =
  let len = list-length bs
  in if len == 0 then ErrorTy
     else let pos = bsearch-text-pos bs name 0 len
  in if pos >= len then ErrorTy
     else let b = list-at bs pos
  in if b.name == name then b.bound-type
     else ErrorTy

env-has-in : List TypeBinding, Text -> Boolean
env-has-in (bs) (name) =
  let len = list-length bs
  in if len == 0 then False
     else let pos = bsearch-text-pos bs name 0 len
  in if pos >= len then False
     else (list-at bs pos).name == name

env-lookup : TypeEnv, Text -> CodexType
env-lookup (env) (name) =
  let llen = list-length (env.locals)
  in let lpos = bsearch-text-pos (env.locals) name 0 llen
  in if lpos < llen then let lb = list-at (env.locals) lpos
  in if lb.name == name then lb.bound-type
     else env-lookup-in (env.bindings) name
     else env-lookup-in (env.bindings) name

env-has : TypeEnv, Text -> Boolean
env-has (env) (name) =
  let llen = list-length (env.locals)
  in let lpos = bsearch-text-pos (env.locals) name 0 llen
  in if lpos < llen then if (list-at (env.locals) lpos).name == name then True
  else env-has-in (env.bindings) name
     else env-has-in (env.bindings) name

env-has-linear-in : List TypeBinding, Text, Integer, Integer -> Boolean
env-has-linear-in (bs) (name) (i) (len) =
  if i == len then False
  else if (list-at bs i).name == name then True
  else env-has-linear-in bs name (i + 1) len

env-has-unsorted : TypeEnv, Text -> Boolean
env-has-unsorted (env) (name) =
  env-has-linear-in (env.bindings) name 0 (list-length (env.bindings))

env-replace-in : List TypeBinding, Text, CodexType, Integer, Integer -> List TypeBinding
env-replace-in (bs) (name) (ty) (i) (len) =
  if i >= len then list-push bs (deck-record (TypeBinding {
   name = name,
   bound-type = ty
  }))
  else if (list-at bs i).name == name then list-set-at bs i (deck-record (TypeBinding {
   name = name,
   bound-type = ty
  }))
  else env-replace-in bs name ty (i + 1) len

env-bind : TypeEnv, Text, CodexType -> TypeEnv
env-bind (env) (name) (ty) =
  let bs = env.bindings
  in __record-set env "bindings" (env-replace-in bs name ty 0 (list-length bs))

env-bind-local : TypeEnv, Text, CodexType -> TypeEnv
env-bind-local (env) (name) (ty) =
  let len = list-length (env.locals)
  in let pos = bsearch-text-pos (env.locals) name 0 len
  in __record-set env "locals" (list-insert-at (env.locals) pos (deck-record (TypeBinding {
   name = name,
   bound-type = ty
  })))

compare-type-binding-names : TypeBinding, TypeBinding -> Integer
compare-type-binding-names (a) (b) =
  text-compare (a.name) (b.name)

env-finalize : TypeEnv -> TypeEnv
env-finalize (env) =
  __record-set env "bindings" (sort-by (env.bindings) compare-type-binding-names)

builtin-type-env : TypeEnv
builtin-type-env =
  let e = empty-type-env
  in let e2 = env-bind e "negate" (FunTy int-ty-default int-ty-default)
  in let e3 = env-bind e2 "text-length" (FunTy TextTy int-ty-default)
  in let e4 = env-bind e3 "integer-to-text" (FunTy int-ty-default TextTy)
  in let e5 = env-bind e4 "char-at" (FunTy TextTy (FunTy int-ty-default CharTy))
  in let e5b = env-bind e5 "char-to-text" (FunTy CharTy TextTy)
  in let e6 = env-bind e5b "substring" (FunTy TextTy (FunTy int-ty-default (FunTy int-ty-default TextTy)))
  in let e7 = env-bind e6 "is-letter" (FunTy CharTy BooleanTy)
  in let e8 = env-bind e7 "is-digit" (FunTy CharTy BooleanTy)
  in let e9 = env-bind e8 "is-whitespace" (FunTy CharTy BooleanTy)
  in let e10 = env-bind e9 "char-code" (FunTy CharTy int-ty-default)
  in let e10b = env-bind e10 "char-code-at" (FunTy TextTy (FunTy int-ty-default int-ty-default))
  in let e11 = env-bind e10b "code-to-char" (FunTy int-ty-default CharTy)
  in let e12 = env-bind e11 "text-replace" (FunTy TextTy (FunTy TextTy (FunTy TextTy TextTy)))
  in let e12b = env-bind e12 "text-to-double-bits" (FunTy TextTy int-ty-default)
