  in let st2 = st-append-code (cap-tmp.state) (li (cap-tmp.reg) count)
  in let st3 = st-append-code st2 (mov-store (deckp-tmp.reg) (cap-tmp.reg) 0)
  in let st4 = st-append-code st3 (add-ri (deckp-tmp.reg) 8)
  in let ptr-loc = alloc-local st4
  in let ptr-tmp = alloc-temp (ptr-loc.state)
  in let st5 = st-append-code (ptr-tmp.state) (mov-rr (ptr-tmp.reg) (deckp-tmp.reg))
  in let st6 = store-local st5 (ptr-loc.reg) (ptr-tmp.reg)
  in let st7 = st-append-code st6 (add-ri (deckp-tmp.reg) ((count + 1) * 8))
  in let st8 = st-append-code st7 (mov-store (addr-tmp.reg) (deckp-tmp.reg) 0)
  in let len-tmp = alloc-temp st8
