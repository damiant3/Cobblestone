emit-record-set-builtin : CodegenState, List IRExpr -> EmitResult
emit-record-set-builtin (st) (args) =
  let rec-result = emit--x86-64-code-generator_emit-expr (st-set-tail-pos st False) (list-at args 0)
  in let rec-loc = alloc-local (rec-result.state)
  in let st1 = store-local (rec-loc.state) (rec-loc.reg) (rec-result.reg)
  in let field-name = when list-at args 1
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
  in let rec-ty = resolve-constructed-ty st (ir-expr-type (list-at args 0))
  in let val-result = emit--x86-64-code-generator_emit-expr st1 (list-at args 2)
  in let loaded = load-local (val-result.state) (rec-loc.reg)
  in when rec-ty
   is RecordTy (rname) (rargs) (rfields) -> let fot = cce-byte-offset-and-type rfields field-name
   in EmitResult {
    state = emit-narrow-store-proven (loaded.state) (fot.type-val) (loaded.reg) (val-result.reg) (fot.offset) (list-at args 2),
    reg = loaded.reg
   }
   is otherwise -> let st-err = st-add-error (loaded.state) cdx-ir-error ("__record-set: unresolved type for field '" & field-name & "'") (ir-expr-span (list-at args 0))
   in EmitResult {
    state = st-append-code st-err [15, 11],
    reg = loaded.reg
   }

