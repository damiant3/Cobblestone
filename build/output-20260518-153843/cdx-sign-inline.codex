Chapter: CdxSignInline
  cites Foreword chapter Console
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha512
Section: Helpers
  bytes-to-csv : List Integer, Integer, Integer, Text -> Text
  bytes-to-csv (bs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in bytes-to-csv bs (i + 1) len (acc & sep & show (list-at bs i))
Section: Body
  opening : [Console] Nothing = act
    let key = [104, 84, 229, 179, 165, 113, 148, 54, 186, 134, 218, 177, 9, 26, 71, 179, 199, 76, 122, 161, 57, 214, 216, 197, 192, 69, 228, 94, 128, 249, 112, 143]
    in let hash = [68, 59, 170, 117, 108, 23, 83, 47, 69, 139, 73, 187, 27, 248, 131, 213, 205, 151, 233, 226, 157, 54, 13, 27, 47, 136, 151, 236, 53, 140, 80, 163]
    in let pub = ed25519-public-key key
    in let sig = ed25519-sign key pub hash
    in act
      print-line (bytes-to-csv pub 0 32 "")
      print-line (bytes-to-csv sig 0 64 "")
    end
  end