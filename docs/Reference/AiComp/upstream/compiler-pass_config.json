{
  "pipeline": [
    "dce",
    "loop-unroll",
    "simplify",
    "dce",
    "cse",
    "sroa",
    "strip-assume",
    "dce",
    "load-elim",
    "dse",
    "simplify",
    "slsr",
    "dce",
    "slp-vectorization",
    "dce",
    "cse",
    "mad-synthesis",
    "dce",
    "hir-to-lir",
    "copy-propagation",
    "lir-dce",
    "simplify-cfg",
    "phi-elimination",
    "inst-scheduling",
    "mir-reg-pressure-profiler",
    "mir-register-allocation",
    "mir-to-vliw"
  ],
  "passes": {
    "simplify": {
      "enabled": true,
      "options": {
        "constant_folding": true,
        "identities": true,
        "canonicalization": true,
        "select_to_mul": true,
        "select_to_alu_mux": false,
        "parity_pattern": true,
        "add_mul_fold": true,
        "range_fold": true,
        "assoc_fold": true,
        "mul_dist": true
      }
    },
    "load-elim": {
      "enabled": true,
      "options": {
        "restrict_ptr": true
      }
    },
    "dse": {
      "enabled": true,
      "options": {
        "restrict_ptr": true
      }
    },
    "strip-assume": {
      "enabled": true,
      "options": {}
    },
    "slp-vectorization": {
      "enabled": true,
      "options": {
        "restrict_ptr": true,
        "vectorize_memory": true,
        "gather": true,
        "vectorize_alu": true,
        "vectorize_varying_constants": false,
        "dual_representation_prune_threshold": 512
      }
    },
    "simplify-cfg": {
      "enabled": true,
      "options": {
        "remove_unreachable": true,
        "thread_trampolines": true,
        "merge_blocks": true,
        "simplify_cond_jump": true
      }
    },
    "inst-scheduling": {
      "enabled": true,
      "options": {
        "restrict_ptr": true,
        "prefer_load_fill": false,
        "devectorize_valu_to_alu": true,
        "devectorize_vector_ops_to_alu": true,
        "devectorize_vbroadcast_to_alu": true,
        "devectorize_partial_alu_fill": true,
        "prioritize_load_unblock": true,
        "register_pressure_limit": 0,
        "stream_stagger": "auto",
        "stream_stagger_threshold": 12,
        "stream_stagger_auto_min_gap_pct": 25,
        "stream_stagger_auto_pressure_headroom": 64,
        "stream_stagger_auto_candidate_start": 1,
        "stream_stagger_auto_candidate_multiplier": 2,
        "stream_stagger_auto_candidate_max": null,
        "stream_stagger_auto_direction": "auto",
        "static_devectorize_pct": 8,
        "const_via_flow": true,
        "const_via_flow_skip": 40
      }
    },
    "mir-reg-pressure-profiler": {
      "enabled": false,
      "options": {}
    },
    "mir-register-allocation": {
      "enabled": true,
      "options": {
        "enable_spilling": false,
        "spill_infra_size": 35,
        "debug_spills": false
      }
    },
    "slsr": {
      "enabled": true,
      "options": {
        "min_savings": 1
      }
    },
    "sroa": {
      "enabled": true,
      "options": {
        "table_promotion": true,
        "restrict_ptr": true,
        "max_window": 8,
        "share_window": 4,
        "repreload_gap": 10000
      }
    }
  }
}
