Chapter: Cdx2097PartialUnused

  cites Foreword chapter Console

Section: Body

 Four arms in one act block. CDX2097 must fire on exactly one of them.

  tally : Integer, Integer, Integer -> Integer
  tally (a) (b) (c) = a + b + c

  opening : [Console] Nothing = act
    let short = tally 1 2
    in let carried = tally 4 5
    in let full = tally 1 2 3
    in let done = carried 6
    in act
      print-line-uni (integer-to-text full)
    end
  end

