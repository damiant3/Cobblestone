 We say:

Section: Node State
  TrustPeer = record {
    session : TrustSession,
    name : Text,
    next-seq : Integer between 0 and 4294967295,
    last-seen-seq : Integer between 0 and 4294967295
  }

  TrustNode = record {
    public-key : List Integer,
    lattice : TrustLattice,
    policy : Policy,
    peers : List TrustPeer,
    peer-count : Integer between 0 and 255,
    outbound-seq : Integer between 0 and 4294967295
  }

  node-new : List Integer, TrustLattice, Policy -> TrustNode
  node-new (key) (lat) (pol) = TrustNode { public-key = key, lattice = lat, policy = pol, peers = [], peer-count = 0, outbound-seq = 0 }

Section: Peer Management
  node-add-peer : TrustNode, Text, TrustSession -> TrustNode
  node-add-peer (node) (name) (sess) =
    let peer = TrustPeer { session = sess, name = name, next-seq = 0, last-seen-seq = 0 }
    in TrustNode { public-key = node.public-key, lattice = node.lattice, policy = node.policy, peers = list-push (node.peers) peer, peer-count = node.peer-count + 1, outbound-seq = node.outbound-seq }

  node-find-peer : TrustNode, Text -> Maybe Integer
  node-find-peer (node) (name) = node-find-peer-loop (node.peers) name 0 (node.peer-count)

  node-find-peer-loop : List TrustPeer, Text, Integer, Integer -> Maybe Integer
  node-find-peer-loop (peers) (name) (i) (len) =
    if i >= len then None
    else if (list-at peers i).name == name then Just i
    else node-find-peer-loop peers name (i + 1) len

  node-get-peer : TrustNode, Integer -> TrustPeer
  node-get-peer (node) (idx) = list-at (node.peers) idx

  node-set-peer : TrustNode, Integer, TrustPeer -> TrustNode
  node-set-peer (node) (idx) (peer) =
    TrustNode { public-key = node.public-key, lattice = node.lattice, policy = node.policy, peers = list-set-at (node.peers) idx peer, peer-count = node.peer-count, outbound-seq = node.outbound-seq }

Section: Sending
  NodeSendResult = record {
    node : TrustNode,
    success : Boolean,
    error : Text
  }

  node-send : TrustNode, Text, AgentMessage -> NodeSendResult
  node-send (node) (peer-name) (msg) =
    let idx = node-find-peer node peer-name
    in when idx
      is None -> NodeSendResult { node = node, success = False, error = "peer not found: " & peer-name }
      is Just (i) ->
        let peer = node-get-peer node i
        in if trust-is-authenticated (peer.session) == False then NodeSendResult { node = node, success = False, error = "peer not authenticated: " & peer-name }
        else let sr = trust-send (peer.session) msg
        in let peer1 = TrustPeer { session = sr.session, name = peer.name, next-seq = peer.next-seq + 1, last-seen-seq = peer.last-seen-seq }
        in let node1 = node-set-peer node i peer1
        in let node2 = TrustNode { public-key = node1.public-key, lattice = node1.lattice, policy = node1.policy, peers = node1.peers, peer-count = node1.peer-count, outbound-seq = node1.outbound-seq + 1 }
        in NodeSendResult { node = node2, success = sr.success, error = "" }

Section: Receiving
  NodeRecvResult = record {
    node : TrustNode,
    message : AgentMessage,
    from-peer : Text,
    has-message : Boolean,
    policy-allowed : Boolean
  }

  node-recv : TrustNode, Integer -> NodeRecvResult
  node-recv (node) (current-time) = node-recv-loop node current-time 0

  node-recv-loop : TrustNode, Integer, Integer -> NodeRecvResult
  node-recv-loop (node) (current-time) (i) =
    if i >= node.peer-count then NodeRecvResult { node = node, message = MsgDeny (DenyMsg { id = [], proposal = [], from = AgentIdentity { public-key = [] }, reason = InsufficientTrust, evidence = [], signature = [] }), from-peer = "", has-message = False, policy-allowed = False }
    else let peer = node-get-peer node i
    in let rr = trust-recv (peer.session)
    in if rr.has-message == False then node-recv-loop (node-set-peer node i (TrustPeer { session = rr.session, name = peer.name, next-seq = peer.next-seq, last-seen-seq = peer.last-seen-seq })) current-time (i + 1)
    else let peer1 = TrustPeer { session = rr.session, name = peer.name, next-seq = peer.next-seq, last-seen-seq = peer.last-seen-seq + 1 }
    in let node1 = node-set-peer node i peer1
    in let decision = node-eval-msg node1 rr.message (peer1.session) current-time
    in NodeRecvResult { node = node1, message = rr.message, from-peer = peer.name, has-message = True, policy-allowed = decision.allowed }

Section: Policy Evaluation
  node-eval-msg : TrustNode, AgentMessage, TrustSession, Integer -> PolicyDecision
  node-eval-msg (node) (msg) (sess) (current-time) =
    let cap-name = node-msg-capability msg
    in let dir = node-msg-direction msg
    in let ctx = PolicyContext { capability = cap-name, direction = __narrow dir, trust-score = __narrow (trust-peer-score sess), current-time = current-time, agent-id = node-peer-key-hex (sess.peer-key) }
    in eval-policy (node.policy) ctx

  node-msg-capability : AgentMessage -> Text
  node-msg-capability (msg) = when msg
    is MsgPropose (p) -> (p.capability).name
    is MsgGrant (g) -> (g.capability).name
    is MsgHandoff (h) -> (h.capability).name
    is MsgDeny (d) -> "deny"
    is MsgExplain (e) -> "explain"
    is MsgNarrate (n) -> "narrate"
    is MsgInterrupt (i) -> "interrupt"
    is MsgAnnotate (a) -> "annotate"
    is MsgVerdict (v) -> "verdict"
    is MsgSyncOffer (s) -> "sync-offer"
    is MsgSyncReply (s) -> "sync-reply"
    is MsgWorkRequest (w) -> "work-request"
    is MsgWorkReply (w) -> "work-reply"
    is MsgLocateRequest (l) -> "locate-request"
    is MsgLocateReply (l) -> "locate-reply"
    is MsgAnnounceRequest (a) -> "announce-request"
    is MsgAnnounceReply (a) -> "announce-reply"

  node-msg-direction : AgentMessage -> Integer
  node-msg-direction (msg) = when msg
    is MsgPropose (p) -> (p.capability).direction
    is MsgGrant (g) -> (g.capability).direction
    is MsgHandoff (h) -> (h.capability).direction
    is otherwise -> 2

Section: Replay Protection
  node-is-replay : TrustNode, Integer, Integer -> Boolean
  node-is-replay (node) (peer-idx) (seq) =
    let peer = node-get-peer node peer-idx
    in seq <= peer.last-seen-seq

Section: Hex Helper
  node-peer-key-hex : List Integer -> Text
  node-peer-key-hex (key) = node-key-hex-loop key 0 (list-length key) ""

  node-key-hex-loop : List Integer, Integer, Integer, Text -> Text
  node-key-hex-loop (bs) (i) (len) (acc) =
    if i >= len then acc
    else let b = list-at bs i
    in node-key-hex-loop bs (i + 1) len (acc & node-nibble (bit-shru b 4) & node-nibble (bit-and b 15))

  node-nibble : Integer -> Text
  node-nibble (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

Section: Node Queries
  node-peer-count : TrustNode -> Integer
  node-peer-count (node) = node.peer-count

  node-stats : TrustNode -> Text
  node-stats (node) = "peers=" & show (node.peer-count) & " seq=" & show (node.outbound-seq)

