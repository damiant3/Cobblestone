Chapter: TrustLattice
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

 We say:

Section: Trust Scores

 Fixed-point trust scores: 0-10000 maps to 0.0-1.0.
 10000 = full trust, 0 = no trust.

  trust-max : Integer = 10000

  trust-none : Integer = 0

  trust-decay-factor : Integer = 8000

  trust-default-threshold : Integer = 5000

Section: Vouch Records

  Vouch = record {
    from : Text,
    target : Text,
    score : Integer between 0 and 65535
  }

  TrustEntry = record {
    agent : Text,
    direct-score : Integer between 0 and 65535,
    vouches : List Vouch
  }

  TrustLattice = record {
    entries : HamtMap TrustEntry
  }

  lattice-empty : TrustLattice = TrustLattice { entries = hamt-empty }

Section: Lattice Operations

  lattice-add-direct : TrustLattice, Text, Integer -> TrustLattice
  lattice-add-direct (lat) (agent) (score) =
    let existing = hamt-get (lat.entries) agent
    in let entry = when existing
      is Just (e) -> TrustEntry { agent = agent, direct-score = __narrow score, vouches = e.vouches }
      is None -> TrustEntry { agent = agent, direct-score = __narrow score, vouches = [] }
    in TrustLattice { entries = hamt-set (lat.entries) agent entry }

  lattice-add-vouch : TrustLattice, Text, Text, Integer -> TrustLattice
  lattice-add-vouch (lat) (from) (target) (score) =
    let v = Vouch { from = from, target = target, score = __narrow score }
    in let existing = hamt-get (lat.entries) target
    in let entry = when existing
      is Just (e) -> TrustEntry { agent = target, direct-score = e.direct-score, vouches = list-push (e.vouches) v }
      is None -> TrustEntry { agent = target, direct-score = 0, vouches = [v] }
    in TrustLattice { entries = hamt-set (lat.entries) target entry }

Section: Trust Computation

 Every voucher is re-scored by walking its own vouchers, so without a memo
 the walk is a tree of fan-out b truncated at depth 5: b + b^2 + ... + b^5
 nodes, exponential in the vouch fan-out. Measured on a dense
 graph before this memo existed, one lookup cost 2 ticks at b=15, 34 at
 b=23 and 89 at b=27 -- the last two ratios are 2.83 and 2.62 against a
 b^5 prediction of 2.75 and 2.61, so the shape was real and not a guess.
 Nearly five seconds for a single score, and an import pays this at build
 time.

 One memo per public lookup: it lives as long as the answer takes and its
 size is bounded by agents x 6, so the exponential recomputation is traded
 for a table that cannot outgrow the lattice.

  mutable TrustMemo = record {
    scores : HamtMap Integer
  }

  memo-key : Text, Integer -> Text
  memo-key (agent) (depth) = agent & "@" & show depth

  lattice-trust-score : TrustLattice, Text -> Integer
  lattice-trust-score (lat) (agent) =
    let memo = TrustMemo { scores = hamt-empty }
    in lattice-trust-score-at-depth lat memo agent 0

  compute-trust : TrustLattice, TrustMemo, TrustEntry, Integer -> Integer
  compute-trust (lat) (memo) (entry) (depth) =
    if depth > 5 then trust-none
    else let direct = entry.direct-score
    in let indirect = best-vouch-score lat memo (entry.vouches) 0 (list-length (entry.vouches)) depth
    in max-int direct indirect

  best-vouch-score : TrustLattice, TrustMemo, List Vouch, Integer, Integer, Integer -> Integer
  best-vouch-score (lat) (memo) (vouches) (i) (len) (depth) =
    if i == len then trust-none
    else let v = list-at vouches i
    in let voucher-trust = lattice-trust-score-at-depth lat memo (v.from) (depth + 1)
    in let decayed = decay-trust voucher-trust (v.score)
    in let rest = best-vouch-score lat memo vouches (i + 1) len depth
    in max-int decayed rest

  lattice-trust-score-at-depth : TrustLattice, TrustMemo, Text, Integer -> Integer
  lattice-trust-score-at-depth (lat) (memo) (agent) (depth) =
    if depth > 5 then trust-none
    else let cached = hamt-get (memo.scores) (memo-key agent depth)
    in when cached
      is Just (c) -> c
      is None -> score-and-memo lat memo agent depth

  score-and-memo : TrustLattice, TrustMemo, Text, Integer -> Integer
  score-and-memo (lat) (memo) (agent) (depth) =
    let entry = hamt-get (lat.entries) agent
    in let score = when entry
      is Just (e) -> compute-trust lat memo e depth
      is None -> trust-none
    in let __seq = memo.scores = hamt-set (memo.scores) (memo-key agent depth) score
    in score

  decay-trust : Integer, Integer -> Integer
  decay-trust (voucher-score) (vouch-strength) =
    voucher-score * vouch-strength * trust-decay-factor / (trust-max * trust-max)

  max-int : Integer, Integer -> Integer
  max-int (a) (b) = if a > b then a else b

Section: Threshold Checking

  lattice-meets-threshold : TrustLattice, Text, Integer -> Boolean
  lattice-meets-threshold (lat) (agent) (threshold) =
    lattice-trust-score lat agent >= threshold

  lattice-is-trusted : TrustLattice, Text -> Boolean
  lattice-is-trusted (lat) (agent) =
    lattice-meets-threshold lat agent trust-default-threshold

