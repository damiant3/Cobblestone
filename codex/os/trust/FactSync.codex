 We say:

Section: Enumerate

  fact-store-all : BareFactStore -> List Fact
  fact-store-all (store) =
    hamt-fold (\acc -> \k -> \f -> list-push acc f) [] (store.facts)

  fact-store-hashes : BareFactStore -> List Text
  fact-store-hashes (store) =
    hamt-fold (\acc -> \k -> \f -> list-push acc k) [] (store.facts)

Section: What A Store Is Missing

  fact-sync-missing : BareFactStore, List Text -> List Text
  fact-sync-missing (local) (offered) =
    fs-missing-loop local offered 0 (list-length offered) []

  fs-missing-loop : BareFactStore, List Text, Integer, Integer, List Text -> List Text
  fs-missing-loop (local) (offered) (i) (len) (acc) =
    if i >= len then acc
    else let h = list-at offered i
    in if fact-has local h
       then fs-missing-loop local offered (i + 1) len acc
       else fs-missing-loop local offered (i + 1) len (list-push acc h)

Section: Merge

  fact-sync-merge : BareFactStore, BareFactStore -> BareFactStore
  fact-sync-merge (into) (from) =
    let facts = fact-store-all from
    in fs-merge-loop facts 0 (list-length facts) into

  fs-merge-loop : List Fact, Integer, Integer, BareFactStore -> BareFactStore
  fs-merge-loop (facts) (i) (len) (acc) =
    if i >= len then acc
    else fs-merge-loop facts (i + 1) len (fact-store acc (list-at facts i))

  fact-sync-apply : BareFactStore, List Fact -> BareFactStore
  fact-sync-apply (store) (incoming) =
    fs-merge-loop incoming 0 (list-length incoming) store

Section: What A Store Can Answer

  fact-sync-facts-not-offered : BareFactStore, List Text -> List Fact
  fact-sync-facts-not-offered (store) (offered) =
    hamt-fold (\acc -> \k -> \f -> if sync-hash-member offered k then acc else list-push acc f) [] (store.facts)

  sync-hash-member : List Text, Text -> Boolean
  sync-hash-member (hs) (h) = sync-hash-member-loop hs 0 (list-length hs) h

  sync-hash-member-loop : List Text, Integer, Integer, Text -> Boolean
  sync-hash-member-loop (hs) (i) (len) (h) =
    if i >= len then False
    else if (list-at hs i) == h then True
    else sync-hash-member-loop hs (i + 1) len h

Section: Wire Codec

 The bytes that cross the wire. A hash list and a fact list each serialize as
 a le32 count followed by their length-prefixed elements, using the same
 deterministic framing the trust messages use. The accumulators grow with
 list-push (in-place, O(1) amortised) rather than repeated append, so encoding
 a bundle is linear in its byte length, not quadratic.

  sync-encode-hashes : List Text -> List Integer
  sync-encode-hashes (hs) =
    sync-enc-hashes-loop hs 0 (list-length hs) (frame-le32 (list-length hs))

  sync-enc-hashes-loop : List Text, Integer, Integer, List Integer -> List Integer
  sync-enc-hashes-loop (hs) (i) (len) (acc) =
    if i >= len then acc
    else sync-enc-hashes-loop hs (i + 1) len (sync-append acc (frame-encode-text (list-at hs i)))

  sync-decode-hashes : List Integer -> List Text
  sync-decode-hashes (bs) =
    sync-dec-hashes-loop bs 4 (frame-read-le32 bs 0) []

  sync-dec-hashes-loop : List Integer, Integer, Integer, List Text -> List Text
  sync-dec-hashes-loop (bs) (off) (remaining) (acc) =
    if remaining <= 0 then acc
    else let tr = frame-decode-text bs off
    in sync-dec-hashes-loop bs (tr.next-offset) (remaining - 1) (list-push acc (tr.value))

  sync-encode-facts : List Fact -> List Integer
  sync-encode-facts (fs) =
    sync-enc-facts-loop fs 0 (list-length fs) (frame-le32 (list-length fs))

  sync-enc-facts-loop : List Fact, Integer, Integer, List Integer -> List Integer
  sync-enc-facts-loop (fs) (i) (len) (acc) =
    if i >= len then acc
    else sync-enc-facts-loop fs (i + 1) len (sync-append acc (sync-encode-fact (list-at fs i)))

  sync-decode-facts : List Integer -> List Fact
  sync-decode-facts (bs) =
    sync-dec-facts-loop bs 4 (frame-read-le32 bs 0) []

  sync-dec-facts-loop : List Integer, Integer, Integer, List Fact -> List Fact
  sync-dec-facts-loop (bs) (off) (remaining) (acc) =
    if remaining <= 0 then acc
    else let fr = sync-decode-fact bs off
    in sync-dec-facts-loop bs (fr.next-offset) (remaining - 1) (list-push acc (fr.fact))

  sync-encode-fact : Fact -> List Integer
  sync-encode-fact (f) =
    [sync-kind-byte (f.kind)] & frame-encode-text (f.hash) & frame-encode-text (f.content) & frame-encode-text (f.author) & frame-le64 (f.timestamp)

  SyncFactResult = record {
    fact : Fact,
    next-offset : Integer between 0 and 4294967295
  }

  sync-decode-fact : List Integer, Integer -> SyncFactResult
  sync-decode-fact (bs) (off) =
    let k = sync-byte-kind (list-at bs off)
    in let hr = frame-decode-text bs (off + 1)
    in let cr = frame-decode-text bs (hr.next-offset)
    in let ar = frame-decode-text bs (cr.next-offset)
    in let ts = frame-read-le64 bs (ar.next-offset)
    in SyncFactResult { fact = Fact { hash = hr.value, kind = k, content = cr.value, author = ar.value, timestamp = ts }, next-offset = __narrow (ar.next-offset + 8) }

  sync-kind-byte : FactKind -> Integer
  sync-kind-byte (k) = when k
    is DefinitionFact -> 0
    is ProofFact -> 1
    is VouchFact -> 2
    is PolicyFact -> 3
    is CapabilityFact -> 4

  sync-byte-kind : Integer -> FactKind
  sync-byte-kind (b) =
    if b == 0 then DefinitionFact
    else if b == 1 then ProofFact
    else if b == 2 then VouchFact
    else if b == 3 then PolicyFact
    else CapabilityFact

  sync-append : List Integer, List Integer -> List Integer
  sync-append (acc) (src) = sync-append-loop acc src 0 (list-length src)

  sync-append-loop : List Integer, List Integer, Integer, Integer -> List Integer
  sync-append-loop (acc) (src) (i) (len) =
    if i >= len then acc
    else sync-append-loop (list-push acc (list-at src i)) src (i + 1) len

Section: The Wire Verb

  fact-sync-make-offer : BareFactStore, AgentIdentity -> SyncOfferMsg
  fact-sync-make-offer (store) (me) =
    SyncOfferMsg { from = me, payload = sync-encode-hashes (fact-store-hashes store) }

  fact-sync-answer-offer : BareFactStore, AgentIdentity, SyncOfferMsg -> SyncReplyMsg
  fact-sync-answer-offer (store) (me) (offer) =
    SyncReplyMsg { from = me, payload = sync-encode-facts (fact-sync-facts-not-offered store (sync-decode-hashes (offer.payload))) }

  fact-sync-absorb-reply : BareFactStore, SyncReplyMsg -> BareFactStore
  fact-sync-absorb-reply (store) (reply) =
    fact-sync-apply store (sync-decode-facts (reply.payload))
