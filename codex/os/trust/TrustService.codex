 Trust network service layer. Wraps a TrustNode with typed message
 handlers and forensic logging. OS components register handlers for
 specific message types; the service dispatches inbound messages,
 evaluates policy, logs decisions, and routes responses.

 We say:

Section: Handler Types
  HandlerResult = record {
    response : AgentMessage,
    has-response : Boolean,
    log-entry : ForensicChain
  }

  handler-no-response : ForensicChain -> HandlerResult
  handler-no-response (log) = HandlerResult { response = MsgDeny (DenyMsg { id = [], proposal = [], from = AgentIdentity { public-key = [] }, reason = InsufficientTrust, evidence = [], signature = [] }), has-response = False, log-entry = log }

  handler-with-response : AgentMessage, ForensicChain -> HandlerResult
  handler-with-response (msg) (log) = HandlerResult { response = msg, has-response = True, log-entry = log }

Section: Handler Table
  MessageHandler = record {
    tag : Integer between 0 and 7,
    name : Text,
    min-trust : Integer between 0 and 65535
  }

  HandlerTable = record {
    handlers : List MessageHandler,
    count : Integer between 0 and 255
  }

  handler-table-empty : HandlerTable
  handler-table-empty = HandlerTable { handlers = [], count = 0 }

  handler-table-add : HandlerTable, Integer, Text, Integer -> HandlerTable
  handler-table-add (ht) (tag) (name) (min-trust) =
    let h = MessageHandler { tag = __narrow tag, name = name, min-trust = __narrow min-trust }
    in HandlerTable { handlers = list-push (ht.handlers) h, count = ht.count + 1 }

  handler-table-lookup : HandlerTable, Integer -> Maybe MessageHandler
  handler-table-lookup (ht) (tag) = handler-lookup-loop (ht.handlers) tag 0 (ht.count)

  handler-lookup-loop : List MessageHandler, Integer, Integer, Integer -> Maybe MessageHandler
  handler-lookup-loop (hs) (tag) (i) (len) =
    if i >= len then None
    else let h = list-at hs i
    in if h.tag == tag then Just h
    else handler-lookup-loop hs tag (i + 1) len

Section: Service State
  TrustService = record {
    node : TrustNode,
    handlers : HandlerTable,
    log : List ForensicChain,
    log-count : Integer between 0 and 65535,
    messages-processed : Integer between 0 and 4294967295,
    messages-denied : Integer between 0 and 4294967295
  }

  service-new : TrustNode -> TrustService
  service-new (n) = TrustService { node = n, handlers = handler-table-empty, log = [], log-count = 0, messages-processed = 0, messages-denied = 0 }

  trust-service-register : TrustService, Integer, Text, Integer -> TrustService
  trust-service-register (svc) (tag) (name) (min-trust) =
    TrustService { node = svc.node, handlers = handler-table-add (svc.handlers) tag name min-trust, log = svc.log, log-count = svc.log-count, messages-processed = svc.messages-processed, messages-denied = svc.messages-denied }

Section: Message Processing
  ServiceProcessResult = record {
    service : TrustService,
    handled : Boolean,
    handler-name : Text,
    denied : Boolean,
    deny-reason : Text
  }

  service-process : TrustService, Integer -> ServiceProcessResult
  service-process (svc) (current-time) =
    let rr = node-recv (svc.node) current-time
    in if rr.has-message == False then ServiceProcessResult { service = TrustService { node = rr.node, handlers = svc.handlers, log = svc.log, log-count = svc.log-count, messages-processed = svc.messages-processed, messages-denied = svc.messages-denied }, handled = False, handler-name = "", denied = False, deny-reason = "" }
    else let tag = encode-agent-msg (rr.message)
    in let maybe-handler = handler-table-lookup (svc.handlers) tag
    in when maybe-handler
      is None -> service-unhandled svc rr current-time
      is Just (h) -> service-dispatch svc rr h current-time

  service-unhandled : TrustService, NodeRecvResult, Integer -> ServiceProcessResult
  service-unhandled (svc) (rr) (current-time) =
    let chain = chain-empty "service" current-time
    in let chain1 = chain-add-percept chain ("unhandled msg from " & rr.from-peer) 100
    in let chain2 = chain-add-policy chain1 "no-handler" False "no registered handler"
    in ServiceProcessResult {
      service = TrustService { node = rr.node, handlers = svc.handlers, log = list-push (svc.log) chain2, log-count = svc.log-count + 1, messages-processed = svc.messages-processed + 1, messages-denied = svc.messages-denied + 1 },
      handled = False,
      handler-name = "",
      denied = True,
      deny-reason = "no handler for tag " & show (encode-agent-msg (rr.message))
    }

  service-dispatch : TrustService, NodeRecvResult, MessageHandler, Integer -> ServiceProcessResult
  service-dispatch (svc) (rr) (handler) (current-time) =
    let chain = chain-empty "service" current-time
    in let chain1 = chain-add-percept chain ("msg from " & rr.from-peer & " type=" & msg-type-name (rr.message)) 100
    in if rr.policy-allowed == False then
      let chain2 = chain-add-policy chain1 "policy-deny" False "policy rejected"
      in ServiceProcessResult {
        service = TrustService { node = rr.node, handlers = svc.handlers, log = list-push (svc.log) chain2, log-count = svc.log-count + 1, messages-processed = svc.messages-processed + 1, messages-denied = svc.messages-denied + 1 },
        handled = False,
        handler-name = handler.name,
        denied = True,
        deny-reason = "policy rejected"
      }
    else let peer-trust = service-lookup-peer-trust (rr.node) (rr.from-peer)
    in if peer-trust < handler.min-trust then
      let chain2 = chain-add-policy chain1 "trust-threshold" False "peer trust below handler minimum"
      in ServiceProcessResult {
        service = TrustService { node = rr.node, handlers = svc.handlers, log = list-push (svc.log) chain2, log-count = svc.log-count + 1, messages-processed = svc.messages-processed + 1, messages-denied = svc.messages-denied + 1 },
        handled = False,
        handler-name = handler.name,
        denied = True,
        deny-reason = "trust below " & show (handler.min-trust)
      }
    else let chain2 = chain-add-policy chain1 (handler.name) True "allowed"
    in let chain3 = chain-add-action chain2 "dispatch" (handler.name) (msg-type-name (rr.message))
    in ServiceProcessResult {
      service = TrustService { node = rr.node, handlers = svc.handlers, log = list-push (svc.log) chain3, log-count = svc.log-count + 1, messages-processed = svc.messages-processed + 1, messages-denied = svc.messages-denied },
      handled = True,
      handler-name = handler.name,
      denied = False,
      deny-reason = ""
    }

  service-lookup-peer-trust : TrustNode, Text -> Integer
  service-lookup-peer-trust (node) (peer-name) =
    let idx = node-find-peer node peer-name
    in when idx
      is Just (i) -> trust-peer-score (node-get-peer node i).session
      is None -> 0

Section: Service Queries
  service-stats : TrustService -> Text
  service-stats (svc) = "processed=" & show (svc.messages-processed) & " denied=" & show (svc.messages-denied) & " handlers=" & show ((svc.handlers).count) & " log=" & show (svc.log-count)

  service-log-count : TrustService -> Integer
  service-log-count (svc) = svc.log-count

