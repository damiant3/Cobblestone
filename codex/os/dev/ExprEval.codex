Chapter: ExprEval
  cites Foreword chapter CCE

 A HYPHEN BINDS THE WAY IT BINDS EVERYWHERE ELSE IN CODEX. `heap-base-1`
 is one name and not a subtraction, because a hyphen followed by a digit
 continues an identifier; the subtraction is `heap-base - 1`. That is the
 same rule `docs/DevelopersGuide.md` states for the language, and having
 the debugger disagree with the language about what a hyphen means would
 be its own small trap.

 We say:

Section: The Answer

  ExprResult =
   | ExprOk (Integer)
   | ExprErr (Text)

  expr-is-ok : ExprResult -> Boolean
  expr-is-ok (r) = when r is ExprOk (v) -> True is ExprErr (m) -> False

  expr-value-or : ExprResult, Integer -> Integer
  expr-value-or (r) (d) = when r is ExprOk (v) -> v is ExprErr (m) -> d

  expr-show : ExprResult -> Text
  expr-show (r) = when r is ExprOk (v) -> show v is ExprErr (m) -> "error: " & m

  ExprStep = record {
   es-result : ExprResult,
   es-next : Integer
  }

  ex-step : ExprResult, Integer -> ExprStep
  ex-step (r) (n) = ExprStep { es-result = r, es-next = n }

  ex-failed : ExprStep -> Boolean
  ex-failed (st) = expr-is-ok (st.es-result) == False

Section: Characters

 Derived from Text literals, so they are CCE by construction. A hardcoded
 45 for a hyphen is the ASCII assumption this project has shipped more
 than once: `a` is 15 here and a space is 2.

  ex-ch : Text -> Integer
  ex-ch (t) = char-code (char-at t 0)

  ex-at-end : Text, Integer -> Boolean
  ex-at-end (s) (i) = i >= text-length s

  ex-is : Text, Integer, Text -> Boolean
  ex-is (s) (i) (t) =
   if ex-at-end s i then False
   else char-code (char-at s i) == ex-ch t

  ex-skip-spaces : Text, Integer -> Integer
  ex-skip-spaces (s) (i) =
   if ex-at-end s i then i
   else if is-whitespace (char-at s i) then ex-skip-spaces s (i + 1)
   else i

  ex-here : Text, Integer -> Text
  ex-here (s) (i) =
   if ex-at-end s i then "end of input"
   else "'" & substring s i 1 & "' at " & show i

Section: Named Constants

  ex-names : List Text
  ex-names = [
   "load-addr", "heap-base", "stack-top", "serial-ring",
   "proc-table", "idt", "page-tables", "gop-fb"
  ]

  ex-values : List Integer
  ex-values = [
   1048576, 6291456, 3221225472, 5242880,
   20480, 24576, 32768, 3204448256
  ]

  ex-lookup : Text -> ExprResult
  ex-lookup (name) = ex-lookup-loop name 0 (list-length ex-names)

  ex-lookup-loop : Text, Integer, Integer -> ExprResult
  ex-lookup-loop (name) (i) (len) =
   if i >= len then ExprErr ("unknown name " & name)
   else if list-at ex-names i == name then ExprOk (list-at ex-values i)
   else ex-lookup-loop name (i + 1) len

Section: Atoms

  ex-name-end : Text, Integer -> Integer
  ex-name-end (s) (i) =
   if ex-at-end s i then i
   else let c = char-at s i
   in if is-letter c | is-digit c then ex-name-end s (i + 1)
   else if ex-is s i "-" & i + 1 < text-length s
         & (is-letter (char-at s (i + 1)) | is-digit (char-at s (i + 1)))
    then ex-name-end s (i + 2)
   else i

 THE SIX LETTERS ARE COMPARED ONE AT A TIME, AND THAT IS NOT CLUMSINESS.
 The obvious version -- `if l >= 'a' & l <= 'f' then 10 + l - 'a'` -- is
 wrong here, and it was written that way first and shipped `0xff` as
 **391**. CCE orders letters by English frequency, not alphabetically:
 `a` is 15, `e` is 13, `f` is 28, and `c` is 24. So neither the range test
 nor the subtraction means anything. Digits ARE contiguous in CCE (3
 through 12), which is why the digit arm above is allowed its arithmetic
 and this one is not.

  ex-hex-letter : Text, Integer -> Integer
  ex-hex-letter (s) (i) =
   let l = to-lower (char-at s i)
   in let c = char-code l
   in if c == ex-ch "a" then 10
   else if c == ex-ch "b" then 11
   else if c == ex-ch "c" then 12
   else if c == ex-ch "d" then 13
   else if c == ex-ch "e" then 14
   else if c == ex-ch "f" then 15
   else 0 - 1

  ex-hex-digit : Text, Integer -> Integer
  ex-hex-digit (s) (i) =
   let c = char-at s i
   in if is-digit c then char-code c - ex-ch "0"
   else ex-hex-letter s i

  ex-hex : Text, Integer, Integer, Integer -> ExprStep
  ex-hex (s) (i) (acc) (n) =
   if ex-at-end s i then
     (if n == 0 then ex-step (ExprErr "0x with no digits") i else ex-step (ExprOk acc) i)
   else let d = ex-hex-digit s i
   in if d < 0 then
     (if n == 0 then ex-step (ExprErr "0x with no digits") i else ex-step (ExprOk acc) i)
   else ex-hex s (i + 1) (acc * 16 + d) (n + 1)

  ex-dec : Text, Integer, Integer, Integer -> ExprStep
  ex-dec (s) (i) (acc) (n) =
   if ex-at-end s i then ex-step (ExprOk acc) i
   else if is-digit (char-at s i) then ex-dec s (i + 1) (acc * 10 + (char-code (char-at s i) - ex-ch "0")) (n + 1)
   else ex-step (ExprOk acc) i

  ex-number : Text, Integer -> ExprStep
  ex-number (s) (i) =
   if ex-is s i "0" & i + 1 < text-length s & (ex-is s (i + 1) "x" | ex-is s (i + 1) "X")
    then ex-hex s (i + 2) 0 0
   else ex-dec s i 0 0

  ex-atom : Text, Integer, Integer -> ExprStep
  ex-atom (s) (i) (last) =
   let j = ex-skip-spaces s i
   in if ex-at-end s j then ex-step (ExprErr "expression ended where a value was expected") j
   else if ex-is s j "$" then ex-step (ExprOk last) (j + 1)
   else let c = char-at s j
   in if is-digit c then ex-number s j
   else if is-letter c then
     let e = ex-name-end s j
     in ex-step (ex-lookup (substring s j (e - j))) e
   else ex-step (ExprErr ("expected a value, found " & ex-here s j)) j

Section: Operators

 Two levels only, and it is a deliberate simplification written down
 rather than discovered: multiplicative binds tighter than everything
 else, and everything else is left to right. So `1 + 2 * 3` is 7, and
 `1 | 2 + 3` is 6 -- the or and the plus share a level, so it is
 `(1 | 2) + 3` and not the `1 | (2 + 3)` that C would give. A debugger
 line is short enough that left to right reads the way it is typed, and
 the test pins both directions so the choice cannot drift into being C's
 by accident.

  ex-op-len : Text, Integer -> Integer
  ex-op-len (s) (i) =
   if ex-is s i "<" & ex-is s (i + 1) "<" then 2
   else if ex-is s i ">" & ex-is s (i + 1) ">" then 2
   else if ex-is s i "+" | ex-is s i "-" | ex-is s i "*" | ex-is s i "/"
      | ex-is s i "&" | ex-is s i "|" | ex-is s i "^" then 1
   else 0

  ex-is-mul : Text, Integer -> Boolean
  ex-is-mul (s) (i) = ex-is s i "*" | ex-is s i "/"

  ex-apply : Text, Integer, Integer -> ExprResult
  ex-apply (op) (a) (b) =
   if op == "+" then ExprOk (a + b)
   else if op == "-" then ExprOk (a - b)
   else if op == "*" then ExprOk (a * b)
   else if op == "/" then (if b == 0 then ExprErr "divide by zero" else ExprOk (a / b))
   else if op == "&" then ExprOk (bit-and a b)
   else if op == "|" then ExprOk (bit-or a b)
   else if op == "^" then ExprOk (bit-xor a b)
   else if op == "<<" then ExprOk (bit-shl a b)
   else if op == ">>" then ExprOk (bit-shru a b)
   else ExprErr ("unknown operator " & op)

Section: The Two Chains

  ex-mul-chain : Text, Integer, Integer -> ExprStep
  ex-mul-chain (s) (i) (last) = ex-mul-loop s (ex-atom s i last) last

  ex-mul-loop : Text, ExprStep, Integer -> ExprStep
  ex-mul-loop (s) (st) (last) =
   if ex-failed st then st
   else let j = ex-skip-spaces s (st.es-next)
   in if ex-at-end s j then ex-step (st.es-result) j
   else if ex-is-mul s j == False then ex-step (st.es-result) j
   else let rhs = ex-atom s (j + 1) last
   in if ex-failed rhs then rhs
   else ex-mul-loop s (ex-step (ex-apply (substring s j 1) (expr-value-or (st.es-result) 0) (expr-value-or (rhs.es-result) 0)) (rhs.es-next)) last

  ex-top-chain : Text, Integer, Integer -> ExprStep
  ex-top-chain (s) (i) (last) = ex-top-loop s (ex-mul-chain s i last) last

  ex-top-loop : Text, ExprStep, Integer -> ExprStep
  ex-top-loop (s) (st) (last) =
   if ex-failed st then st
   else let j = ex-skip-spaces s (st.es-next)
   in if ex-at-end s j then ex-step (st.es-result) j
   else let n = ex-op-len s j
   in if n == 0 then ex-step (ExprErr ("expected an operator, found " & ex-here s j)) j
   else let rhs = ex-mul-chain s (j + n) last
   in if ex-failed rhs then rhs
   else ex-top-loop s (ex-step (ex-apply (substring s j n) (expr-value-or (st.es-result) 0) (expr-value-or (rhs.es-result) 0)) (rhs.es-next)) last

Section: Evaluating

  expr-eval : Text, Integer -> ExprResult
  expr-eval (s) (last) =
   let st = ex-top-chain s 0 last
   in if ex-failed st then st.es-result
   else let j = ex-skip-spaces s (st.es-next)
   in if ex-at-end s j then st.es-result
   else ExprErr ("unexpected " & ex-here s j)

  expr-eval-plain : Text -> ExprResult
  expr-eval-plain (s) = expr-eval s 0
