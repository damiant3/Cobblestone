Chapter: NetworkDiag
  cites Net chapter Ethernet
  cites Net chapter Icmp
  cites Net chapter Tcp
  cites Foreword chapter Maybe
  cites UI chapter Widget
  cites UI chapter Layout

Section: Diagnostic Tool

  DiagTool =
    | DiagPing
    | DiagTraceroute
    | DiagDnsLookup
    | DiagPortCheck
    | DiagSpeedTest

  diag-tool-label : DiagTool -> Text
  diag-tool-label (t) = when t
    is DiagPing -> "Ping"
    is DiagTraceroute -> "Traceroute"
    is DiagDnsLookup -> "DNS Lookup"
    is DiagPortCheck -> "Port Check"
    is DiagSpeedTest -> "Speed Test"

Section: Test Result

  DiagResult = record {
    dr-tool : DiagTool,
    dr-target : Text,
    dr-success : Boolean,
    dr-latency-ms : Integer,
    dr-detail : Text,
    dr-timestamp : Integer
  }

  diag-result : DiagTool, Text, Boolean, Integer, Text, Integer -> DiagResult
  diag-result (tool) (target) (ok) (latency) (detail) (ts) = DiagResult {
    dr-tool = tool, dr-target = target, dr-success = ok,
    dr-latency-ms = latency, dr-detail = detail, dr-timestamp = ts
  }

Section: Interface Info

  NetInterface = record {
    ni-name : Text,
    ni-ip : Text,
    ni-mac : Text,
    ni-link-speed : Integer,
    ni-up : Boolean,
    ni-rx-bytes : Integer,
    ni-tx-bytes : Integer
  }

  net-interface : Text, Text, Text, Integer -> NetInterface
  net-interface (name) (ip) (mac) (speed) = NetInterface {
    ni-name = name, ni-ip = ip, ni-mac = mac, ni-link-speed = speed,
    ni-up = True, ni-rx-bytes = 0, ni-tx-bytes = 0
  }

Section: Speed Test Result

  SpeedResult = record {
    sp-download-kbps : Integer,
    sp-upload-kbps : Integer,
    sp-ping-ms : Integer,
    sp-server : Text,
    sp-timestamp : Integer
  }

Section: State

  NetworkDiagState = record {
    nd-results : List DiagResult,
    nd-result-count : Integer,
    nd-interfaces : List NetInterface,
    nd-interface-count : Integer,
    nd-running : Boolean,
    nd-current-tool : DiagTool,
    nd-target : Text,
    nd-port : Integer,
    nd-last-speed : SpeedResult
  }

  network-diag-new : NetworkDiagState
  network-diag-new = NetworkDiagState {
    nd-results = [], nd-result-count = 0,
    nd-interfaces = [], nd-interface-count = 0,
    nd-running = False, nd-current-tool = DiagPing, nd-target = "",
    nd-port = 80,
    nd-last-speed = SpeedResult {
      sp-download-kbps = 0,
      sp-upload-kbps = 0,
      sp-ping-ms = 0,
      sp-server = "",
      sp-timestamp = 0
    }
  }

Section: Actions

  nd-with : NetworkDiagState, List DiagResult, List NetInterface, Boolean, DiagTool, Text, Integer, SpeedResult -> NetworkDiagState
  nd-with (st) (results) (ifaces) (running) (tool) (target) (port) (speed) = NetworkDiagState {
    nd-results = results, nd-result-count = list-length results,
    nd-interfaces = ifaces, nd-interface-count = list-length ifaces,
    nd-running = running, nd-current-tool = tool, nd-target = target,
    nd-port = port, nd-last-speed = speed
  }

  nd-set-target : NetworkDiagState, Text -> NetworkDiagState
  nd-set-target (st) (t) = nd-with st (st.nd-results) (st.nd-interfaces) (st.nd-running) (st.nd-current-tool) t (st.nd-port) (st.nd-last-speed)

  nd-set-tool : NetworkDiagState, DiagTool -> NetworkDiagState
  nd-set-tool (st) (t) = nd-with st (st.nd-results) (st.nd-interfaces) (st.nd-running) t (st.nd-target) (st.nd-port) (st.nd-last-speed)

  nd-set-port : NetworkDiagState, Integer -> NetworkDiagState
  nd-set-port (st) (p) = nd-with st (st.nd-results) (st.nd-interfaces) (st.nd-running) (st.nd-current-tool) (st.nd-target) p (st.nd-last-speed)

  nd-start : NetworkDiagState -> NetworkDiagState
  nd-start (st) = nd-with st (st.nd-results) (st.nd-interfaces) True (st.nd-current-tool) (st.nd-target) (st.nd-port) (st.nd-last-speed)

  nd-add-result : NetworkDiagState, DiagResult -> NetworkDiagState
  nd-add-result (st) (r) = nd-with st (st.nd-results & [r]) (st.nd-interfaces) False (st.nd-current-tool) (st.nd-target) (st.nd-port) (st.nd-last-speed)

  nd-add-interface : NetworkDiagState, NetInterface -> NetworkDiagState
  nd-add-interface (st) (iface) = nd-with st (st.nd-results) (st.nd-interfaces & [iface]) (st.nd-running) (st.nd-current-tool) (st.nd-target) (st.nd-port) (st.nd-last-speed)

  nd-update-speed : NetworkDiagState, SpeedResult -> NetworkDiagState
  nd-update-speed (st) (speed) = nd-with st (st.nd-results) (st.nd-interfaces) (st.nd-running) (st.nd-current-tool) (st.nd-target) (st.nd-port) speed

  nd-clear-results : NetworkDiagState -> NetworkDiagState
  nd-clear-results (st) = nd-with st [] (st.nd-interfaces) (st.nd-running) (st.nd-current-tool) (st.nd-target) (st.nd-port) (st.nd-last-speed)

Section: Ping

 An echo request is ICMP type 8 and its reply type 0 (RFC 792); a reply
 counts only when its identifier and sequence are the request's. A lost
 probe is written as a round trip of -1.

  nd-ping-request : List Integer, List Integer, Integer, Integer -> List Integer
  nd-ping-request (src) (dst) (ident) (seq) = icmp-build-echo-ip src dst ident seq [seq, 0, 0, 0, 0, 0, 0, 0]

  nd-icmp-of : List Integer -> Maybe IcmpMessage
  nd-icmp-of (pkt) =
    if list-length pkt < 20 then None
    else if ip-header-valid pkt == False | list-at pkt 9 /= ip-proto-icmp then None
    else icmp-parse-checked (nd-slice pkt (bit-and (list-at pkt 0) 15 * 4) (list-length pkt))

  nd-is-reply : List Integer, Integer, Integer -> Boolean
  nd-is-reply (pkt) (ident) (seq) =
    when nd-icmp-of pkt
      is None -> False
      is Just (m) -> m.icmp-type == icmp-type-echo-reply & m.identifier == ident & m.sequence == seq

  nd-ping-summary : List Integer -> Text
  nd-ping-summary (rtts) =
    let got = nd-received rtts 0 0
    in let sent = list-length rtts
    in show sent & " sent, " & show got & " received, " & show (if sent == 0 then 0 else (sent - got) * 100 / sent) & "% loss" & (if got == 0 then "" else ", rtt min/avg/max " & show (nd-rtt-min rtts 0 (0 - 1)) & "/" & show (nd-rtt-sum rtts 0 0 / got) & "/" & show (nd-rtt-max rtts 0 0) & " ms")

  nd-received : List Integer, Integer, Integer -> Integer
  nd-received (rtts) (i) (acc) =
    if i >= list-length rtts then acc
    else nd-received rtts (i + 1) (if list-at rtts i >= 0 then acc + 1 else acc)

  nd-rtt-min : List Integer, Integer, Integer -> Integer
  nd-rtt-min (rtts) (i) (best) =
    if i >= list-length rtts then best
    else let r = list-at rtts i
    in nd-rtt-min rtts (i + 1) (if r >= 0 & (best < 0 | r < best) then r else best)

  nd-rtt-max : List Integer, Integer, Integer -> Integer
  nd-rtt-max (rtts) (i) (best) =
    if i >= list-length rtts then best
    else nd-rtt-max rtts (i + 1) (if list-at rtts i > best then list-at rtts i else best)

  nd-rtt-sum : List Integer, Integer, Integer -> Integer
  nd-rtt-sum (rtts) (i) (acc) =
    if i >= list-length rtts then acc
    else nd-rtt-sum rtts (i + 1) (if list-at rtts i >= 0 then acc + list-at rtts i else acc)

Section: Traceroute

 A probe is an echo request whose IPv4 time to live (byte 8) is the hop
 number, carried again as the ICMP sequence. A router that drops it answers
 Time Exceeded (type 11), quoting the dropped packet's IPv4 header and its
 first 8 bytes, which hold the probe's identifier and sequence; the target
 answers with an echo reply; type 3 is Destination Unreachable.

  TraceHop = record {
    th-kind : Integer,
    th-ttl : Integer,
    th-from : Text
  }

  nd-trace-probe : List Integer, List Integer, Integer, Integer -> List Integer
  nd-trace-probe (src) (dst) (ident) (ttl) =
    let pkt = nd-ping-request src dst ident ttl
    in let hdr = nd-slice pkt 0 8 & [ttl, list-at pkt 9, 0, 0] & nd-slice pkt 12 20
    in let ck = ip-checksum hdr 0 20 0
    in nd-slice hdr 0 10 & write-be16 ck & nd-slice hdr 12 20 & nd-slice pkt 20 (list-length pkt)

  nd-trace-classify : List Integer, Integer -> TraceHop
  nd-trace-classify (pkt) (ident) =
    let none = TraceHop { th-kind = 0, th-ttl = 0, th-from = "" }
    in when nd-icmp-of pkt
      is None -> none
      is Just (m) -> nd-trace-kind m (nd-ip-text pkt 12) ident none

  nd-trace-kind : IcmpMessage, Text, Integer, TraceHop -> TraceHop
  nd-trace-kind (m) (from) (ident) (none) =
    if m.icmp-type == icmp-type-echo-reply then (if m.identifier == ident then TraceHop { th-kind = 2, th-ttl = m.sequence, th-from = from } else none)
    else if m.icmp-type == 11 | m.icmp-type == icmp-type-dest-unreachable then nd-trace-quoted (m.payload) ident (if m.icmp-type == 11 then 1 else 3) from none
    else none

  nd-trace-quoted : List Integer, Integer, Integer, Text, TraceHop -> TraceHop
  nd-trace-quoted (q) (ident) (kind) (from) (none) =
    if list-length q < 28 then none
    else let at = bit-and (list-at q 0) 15 * 4
    in if at < 20 | list-length q < at + 8 | list-at q 9 /= ip-proto-icmp | read-be16 q (at + 4) /= ident then none
    else TraceHop { th-kind = kind, th-ttl = read-be16 q (at + 6), th-from = from }

  nd-hop-line : TraceHop -> Text
  nd-hop-line (h) =
    if h.th-kind == 1 then show (h.th-ttl) & "  " & h.th-from
    else if h.th-kind == 2 then show (h.th-ttl) & "  " & h.th-from & "  reached"
    else if h.th-kind == 3 then show (h.th-ttl) & "  " & h.th-from & "  unreachable"
    else "*"

Section: Connections

  nd-conn-line : TcpConnection -> Text
  nd-conn-line (c) = nd-ip-list-text (c.local-ip) & ":" & show (c.local-port) & "  " & nd-ip-list-text (c.remote-ip) & ":" & show (c.remote-port) & "  " & tcp-state-name (c.state)

  nd-conn-dump : List TcpConnection, Integer, List Text -> List Text
  nd-conn-dump (conns) (i) (acc) =
    if i >= list-length conns then acc
    else nd-conn-dump conns (i + 1) (acc & [nd-conn-line (list-at conns i)])

Section: Bytes

  nd-slice : List Integer, Integer, Integer -> List Integer
  nd-slice (xs) (start) (stop) = nd-slice-loop xs start stop []

  nd-slice-loop : List Integer, Integer, Integer, List Integer -> List Integer
  nd-slice-loop (xs) (i) (stop) (acc) =
    if i >= stop | i >= list-length xs then acc
    else nd-slice-loop xs (i + 1) stop (list-push acc (list-at xs i))

  nd-ip-text : List Integer, Integer -> Text
  nd-ip-text (pkt) (at) = nd-ip-list-text (nd-slice pkt at (at + 4))

  nd-ip-list-text : List Integer -> Text
  nd-ip-list-text (ip) =
    if list-length ip /= 4 then "?"
    else show (list-at ip 0) & "." & show (list-at ip 1) & "." & show (list-at ip 2) & "." & show (list-at ip 3)

Section: Widget

  nd-widget : NetworkDiagState -> WidgetNode
  nd-widget (st) =
    let title = widget-label "nd-title" "Network Diagnostics"
    in let tool-btns = widget-panel "nd-tools" DirRow 4 [
      widget-button "nd-t-ping" "Ping",
      widget-button "nd-t-trace" "Traceroute",
      widget-button "nd-t-dns" "DNS Lookup",
      widget-button "nd-t-port" "Port Check",
      widget-button "nd-t-speed" "Speed Test"
    ]
    in let target-input = widget-input "nd-target" (st.nd-target) (text-length (st.nd-target))
    in let run-btn = widget-button "nd-run" (if st.nd-running then "Running..." else "Run")
    in let iface-section = nd-iface-widget st
    in let result-section = nd-result-widget st
    in widget-panel "nd-panel" DirColumn 4 [
      title,
      tool-btns,
      target-input,
      run-btn,
      iface-section,
      result-section
    ]

  nd-iface-widget : NetworkDiagState -> WidgetNode
  nd-iface-widget (st) =
    let title = widget-label "nd-if-title" "Interfaces"
    in let rows = nd-iface-rows st 0 (st.nd-interface-count) []
    in widget-panel "nd-ifaces" DirColumn 2 ([title] & rows)

  nd-iface-rows : NetworkDiagState, Integer, Integer, List WidgetNode -> List WidgetNode
  nd-iface-rows (st) (i) (n) (acc) =
    if i >= n then acc
    else let iface = list-at (st.nd-interfaces) i
    in let row = widget-label ("nd-if-" & show i) (iface.ni-name & " " & iface.ni-ip & " " & (if iface.ni-up then "UP" else "DOWN") & " " & show (iface.ni-link-speed) & " Mbps")
    in nd-iface-rows st (i + 1) n (list-push acc row)

  nd-result-widget : NetworkDiagState -> WidgetNode
  nd-result-widget (st) =
    let title = widget-label "nd-r-title" ("Results (" & show (st.nd-result-count) & ")")
    in let rows = nd-result-rows st 0 (st.nd-result-count) []
    in widget-panel "nd-results" DirColumn 2 ([title] & rows)

  nd-result-rows : NetworkDiagState, Integer, Integer, List WidgetNode -> List WidgetNode
  nd-result-rows (st) (i) (n) (acc) =
    if i >= n then acc
    else let r = list-at (st.nd-results) (n - 1 - i)
    in let status = if r.dr-success then "OK" else "FAIL"
    in let row = widget-label ("nd-r-" & show i) (diag-tool-label (r.dr-tool) & " " & r.dr-target & " " & status & " " & show (r.dr-latency-ms) & "ms " & r.dr-detail)
    in nd-result-rows st (i + 1) n (list-push acc row)

Section: Formatting

  format-network-diag : NetworkDiagState -> Text
  format-network-diag (st) =
    "tool=" & diag-tool-label (st.nd-current-tool) & " target=" & st.nd-target
    & " results=" & show (st.nd-result-count) & " interfaces=" & show (st.nd-interface-count)

