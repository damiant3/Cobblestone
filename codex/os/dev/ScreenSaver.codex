Section: Saver Programs

  SaverProgram = record {
    sp-id : Text,
    sp-name : Text,
    sp-description : Text,
    sp-has-preview : Boolean,
    sp-has-settings : Boolean
  }

  saver-program : Text, Text, Text -> SaverProgram
  saver-program (id) (name) (desc) = SaverProgram {
    sp-id = id, sp-name = name, sp-description = desc,
    sp-has-preview = True, sp-has-settings = False
  }

