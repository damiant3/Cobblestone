Chapter: TouchpadSettings
  cites UI chapter Widget
  cites UI chapter Layout

 Touchpad and pointing device settings. Sensitivity, acceleration,
 scroll direction, tap-to-click, multi-finger gestures. Applies to
 trackpads and precision touchpads over USB HID or PS/2.

Section: Scroll Direction

  ScrollDirection =
    | ScrollNatural
    | ScrollTraditional

  scroll-dir-label : ScrollDirection -> Text
  scroll-dir-label (d) = when d
    is ScrollNatural -> "Natural (content follows fingers)"
    is ScrollTraditional -> "Traditional (scroll bars)"

Section: Gesture

  GestureAction =
    | GestNone
    | GestBack
    | GestForward
    | GestSwitchApp
    | GestShowDesktop
    | GestNotificationCenter
    | GestMissionControl

  gesture-label : GestureAction -> Text
  gesture-label (g) = when g
    is GestNone -> "None"
    is GestBack -> "Go Back"
    is GestForward -> "Go Forward"
    is GestSwitchApp -> "Switch App"
    is GestShowDesktop -> "Show Desktop"
    is GestNotificationCenter -> "Notifications"
    is GestMissionControl -> "Mission Control"

Section: State

  TouchpadState = record {
    tp-enabled : Boolean,
    tp-sensitivity : Integer between 1 and 10,
    tp-acceleration : Integer between 0 and 100,
    tp-scroll-direction : ScrollDirection,
    tp-scroll-speed : Integer between 1 and 10,
    tp-tap-to-click : Boolean,
    tp-two-finger-scroll : Boolean,
    tp-two-finger-tap-right-click : Boolean,
    tp-three-finger-swipe : GestureAction,
    tp-three-finger-tap : GestureAction,
    tp-four-finger-swipe : GestureAction,
    tp-pinch-zoom : Boolean,
    tp-disable-while-typing : Boolean
  }

  touchpad-new : TouchpadState
  touchpad-new = TouchpadState {
    tp-enabled = True,
    tp-sensitivity = 5,
    tp-acceleration = 50,
    tp-scroll-direction = ScrollNatural,
    tp-scroll-speed = 5,
    tp-tap-to-click = True,
    tp-two-finger-scroll = True,
    tp-two-finger-tap-right-click = True,
    tp-three-finger-swipe = GestSwitchApp,
    tp-three-finger-tap = GestMissionControl,
    tp-four-finger-swipe = GestShowDesktop,
    tp-pinch-zoom = True,
    tp-disable-while-typing = True
  }

Section: Actions

  tp-toggle : TouchpadState -> TouchpadState
  tp-toggle (st) = __record-set st "tp-enabled" (if st.tp-enabled then False else True)

  tp-set-sensitivity : TouchpadState, Integer -> TouchpadState
  tp-set-sensitivity (st) (val) =
    let clamped = if val < 1 then 1 else if val > 10 then 10 else val
    in __record-set st "tp-sensitivity" clamped

  tp-set-acceleration : TouchpadState, Integer -> TouchpadState
  tp-set-acceleration (st) (val) =
    let clamped = if val < 0 then 0 else if val > 100 then 100 else val
    in __record-set st "tp-acceleration" clamped

  tp-toggle-scroll-dir : TouchpadState -> TouchpadState
  tp-toggle-scroll-dir (st) = when st.tp-scroll-direction
    is ScrollNatural -> __record-set st "tp-scroll-direction" ScrollTraditional
    is ScrollTraditional -> __record-set st "tp-scroll-direction" ScrollNatural

  tp-set-scroll-speed : TouchpadState, Integer -> TouchpadState
  tp-set-scroll-speed (st) (val) =
    let clamped = if val < 1 then 1 else if val > 10 then 10 else val
    in __record-set st "tp-scroll-speed" clamped

  tp-toggle-tap : TouchpadState -> TouchpadState
  tp-toggle-tap (st) = __record-set st "tp-tap-to-click" (if st.tp-tap-to-click then False else True)

  tp-toggle-two-finger-scroll : TouchpadState -> TouchpadState
  tp-toggle-two-finger-scroll (st) = __record-set st "tp-two-finger-scroll" (if st.tp-two-finger-scroll then False else True)

  tp-toggle-pinch : TouchpadState -> TouchpadState
  tp-toggle-pinch (st) = __record-set st "tp-pinch-zoom" (if st.tp-pinch-zoom then False else True)

  tp-toggle-disable-typing : TouchpadState -> TouchpadState
  tp-toggle-disable-typing (st) = __record-set st "tp-disable-while-typing" (if st.tp-disable-while-typing then False else True)

  tp-set-three-finger-swipe : TouchpadState, GestureAction -> TouchpadState
  tp-set-three-finger-swipe (st) (g) = __record-set st "tp-three-finger-swipe" g

  tp-set-four-finger-swipe : TouchpadState, GestureAction -> TouchpadState
  tp-set-four-finger-swipe (st) (g) = __record-set st "tp-four-finger-swipe" g

Section: Widget

  tp-widget : TouchpadState -> WidgetNode
  tp-widget (st) =
    let title = widget-label "tp-title" "Touchpad"
    in let toggle = widget-button "tp-toggle" (if st.tp-enabled then "Touchpad: ON" else "Touchpad: OFF")
    in let sens = tp-slider-row "Sensitivity" "tp-sens" (st.tp-sensitivity) 10
    in let accel = tp-slider-row "Acceleration" "tp-accel" (st.tp-acceleration) 100
    in let scroll-dir = widget-button "tp-scroll-dir" ("Scroll: " & scroll-dir-label (st.tp-scroll-direction))
    in let scroll-spd = tp-slider-row "Scroll Speed" "tp-scroll-spd" (st.tp-scroll-speed) 10
    in let sep = widget-separator "tp-sep"
    in let tap = widget-button "tp-tap" ("Tap to Click: " & if st.tp-tap-to-click then "ON" else "OFF")
    in let two-scroll = widget-button "tp-2scroll" ("Two-Finger Scroll: " & if st.tp-two-finger-scroll then "ON" else "OFF")
    in let pinch = widget-button "tp-pinch" ("Pinch to Zoom: " & if st.tp-pinch-zoom then "ON" else "OFF")
    in let typing = widget-button "tp-typing" ("Disable While Typing: " & if st.tp-disable-while-typing then "ON" else "OFF")
    in let gest-title = widget-label "tp-gest-title" "Gestures"
    in let gest3 = widget-label "tp-gest3" ("3-Finger Swipe: " & gesture-label (st.tp-three-finger-swipe))
    in let gest4 = widget-label "tp-gest4" ("4-Finger Swipe: " & gesture-label (st.tp-four-finger-swipe))
    in widget-panel "tp-panel" DirColumn 4 [title, toggle, sens, accel, scroll-dir, scroll-spd, sep, tap, two-scroll, pinch, typing, gest-title, gest3, gest4]

  tp-slider-row : Text, Text, Integer, Integer -> WidgetNode
  tp-slider-row (label) (id) (val) (max-val) =
    let lbl = widget-label (id & "-lbl") label
    in let gauge = widget-gauge (id & "-gauge") val max-val
    in let num = widget-label (id & "-num") (show val)
    in widget-panel id DirRow 4 [lbl, gauge, num]

Section: Formatting

  format-touchpad : TouchpadState -> Text
  format-touchpad (st) =
    (if st.tp-enabled then "ON" else "OFF")
    & " sens=" & show (st.tp-sensitivity) & " accel=" & show (st.tp-acceleration)
    & " scroll=" & scroll-dir-label (st.tp-scroll-direction)
    & " tap=" & if st.tp-tap-to-click then "yes" else "no"

