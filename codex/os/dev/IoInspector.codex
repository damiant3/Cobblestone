Chapter: IoInspector
  cites Dev chapter HexFormat
  cites Kernel chapter Console

 The IoInspector reads and displays I/O port registers (ATA,
 serial, PCI) via the console, providing live hardware state
 for bare-metal debugging.

 We say:

Section: Port Constants
  ata-data-port : Integer = 496
  ata-error-port : Integer = 497
  ata-sector-count-port : Integer = 498
  ata-lba-low-port : Integer = 499
  ata-lba-mid-port : Integer = 500
  ata-lba-high-port : Integer = 501
  ata-drive-head-port : Integer = 502
  ata-status-port : Integer = 503
  ata-alt-status-port : Integer = 1014

Section: Port Read/Write
  io-read : Integer, ConsoleState -> ConsoleState
  io-read (port) (con) =
    let v = port-in-byte port
    in console-write-text con ("port #" & u16-to-hex port & " = #" & byte-to-hex v & " (" & show v & ")")

  io-write : Integer, Integer, ConsoleState -> ConsoleState
  io-write (port) (val) (con) =
    let w = port-out-byte port val
    in console-write-text con ("port #" & u16-to-hex port & " <- #" & byte-to-hex val)

Section: ATA Register Dump
  io-ata-dump : ConsoleState -> ConsoleState
  io-ata-dump (con) =
    let status = port-in-byte ata-alt-status-port
    in let err = port-in-byte ata-error-port
    in let sc = port-in-byte ata-sector-count-port
    in let lba-lo = port-in-byte ata-lba-low-port
    in let lba-mid = port-in-byte ata-lba-mid-port
    in let lba-hi = port-in-byte ata-lba-high-port
    in let drvhd = port-in-byte ata-drive-head-port
    in let con1 = console-write-text con ("Status (#3F6): #" & byte-to-hex status & "  " & ata-decode-status status)
    in let con2 = console-write-char con1 1
    in let con3 = console-write-text con2 ("Error  (#1F1): #" & byte-to-hex err & "  " & ata-decode-error err)
    in let con4 = console-write-char con3 1
    in let con5 = console-write-text con4 ("SecCnt (#1F2): " & show sc)
    in let con6 = console-write-char con5 1
    in let con7 = console-write-text con6 ("LBA    (#1F3-5): " & byte-to-hex lba-lo & " " & byte-to-hex lba-mid & " " & byte-to-hex lba-hi)
    in let con8 = console-write-char con7 1
    in let drv = if bit-and drvhd 16 /= 0 then "slave" else "master"
    in let lba-mode = if bit-and drvhd 64 /= 0 then "LBA" else "CHS"
    in console-write-text con8 ("DrvHd  (#1F6): #" & byte-to-hex drvhd & "  " & drv & " " & lba-mode)

Section: COM1 Register Dump
  io-com1-dump : ConsoleState -> ConsoleState
  io-com1-dump (con) =
    let lsr = port-in-byte 1021
    in let msr = port-in-byte 1022
    in let ier = port-in-byte 1017
    in let con1 = console-write-text con ("COM1 LSR (#3FD): #" & byte-to-hex lsr & "  DR=" & bit-flag lsr 0 & " THRE=" & bit-flag lsr 5)
    in let con2 = console-write-char con1 1
    in let con3 = console-write-text con2 ("COM1 MSR (#3FE): #" & byte-to-hex msr)
    in let con4 = console-write-char con3 1
    in console-write-text con4 ("COM1 IER (#3F9): #" & byte-to-hex ier)

