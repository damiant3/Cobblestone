Chapter: EventBus
  cites Foreword chapter Maybe

 The EventBus delivers topic-keyed events to registered
 subscribers. Each event carries source, payload, and a
 monotonic sequence number for ordering guarantees.

 We say:

Section: Events

  BusEvent = record {
    topic : Text,
    source : Text,
    payload : Text,
    sequence : Integer between 0 and 4294967295
  }

Section: Subscription

  Subscription = record {
    subscriber : Text,
    topic : Text
  }

  EventBus = record {
    subscriptions : List Subscription,
    sub-count : Integer between 0 and 65535,
    events : List BusEvent,
    event-count : Integer between 0 and 65535,
    next-seq : Integer between 0 and 4294967295
  }

Section: Bus Operations

  bus-empty : EventBus
  bus-empty = EventBus { subscriptions = [], sub-count = 0, events = [], event-count = 0, next-seq = 0 }

  bus-subscribe : EventBus, Text, Text -> EventBus
  bus-subscribe (bus) (subscriber) (topic) =
    let sub = Subscription { subscriber = subscriber, topic = topic }
    in EventBus { subscriptions = list-push (bus.subscriptions) sub, sub-count = bus.sub-count + 1, events = bus.events, event-count = bus.event-count, next-seq = bus.next-seq }

  bus-unsubscribe : EventBus, Text, Text -> EventBus
  bus-unsubscribe (bus) (subscriber) (topic) =
    let filtered = filter-subs (bus.subscriptions) subscriber topic 0 (bus.sub-count) []
    in EventBus { subscriptions = filtered, sub-count = list-length filtered, events = bus.events, event-count = bus.event-count, next-seq = bus.next-seq }

  filter-subs : List Subscription, Text, Text, Integer, Integer, List Subscription -> List Subscription
  filter-subs (subs) (subscriber) (topic) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at subs i
    in if s.subscriber == subscriber then
      if s.topic == topic then filter-subs subs subscriber topic (i + 1) len acc
      else filter-subs subs subscriber topic (i + 1) len (list-push acc s)
    else filter-subs subs subscriber topic (i + 1) len (list-push acc s)

Section: Publishing

  bus-publish : EventBus, Text, Text, Text -> EventBus
  bus-publish (bus) (source) (topic) (payload) =
    let ev = BusEvent { topic = topic, source = source, payload = payload, sequence = bus.next-seq }
    in EventBus { subscriptions = bus.subscriptions, sub-count = bus.sub-count, events = list-push (bus.events) ev, event-count = bus.event-count + 1, next-seq = bus.next-seq + 1 }

Section: Consumption

  bus-events-for : EventBus, Text -> List BusEvent
  bus-events-for (bus) (subscriber) =
    let topics = subscriber-topics (bus.subscriptions) subscriber 0 (bus.sub-count) []
    in filter-events-by-topics (bus.events) topics 0 (bus.event-count) []

  subscriber-topics : List Subscription, Text, Integer, Integer, List Text -> List Text
  subscriber-topics (subs) (subscriber) (i) (len) (acc) =
    if i >= len then acc
    else let s = list-at subs i
    in if s.subscriber == subscriber then subscriber-topics subs subscriber (i + 1) len (list-push acc (s.topic))
    else subscriber-topics subs subscriber (i + 1) len acc

  filter-events-by-topics : List BusEvent, List Text, Integer, Integer, List BusEvent -> List BusEvent
  filter-events-by-topics (events) (topics) (i) (len) (acc) =
    if i >= len then acc
    else let ev = list-at events i
    in if topic-in-list (ev.topic) topics 0 (list-length topics) then
      filter-events-by-topics events topics (i + 1) len (list-push acc ev)
    else filter-events-by-topics events topics (i + 1) len acc

  topic-in-list : Text, List Text, Integer, Integer -> Boolean
  topic-in-list (topic) (topics) (i) (len) =
    if i >= len then False
    else if list-at topics i == topic then True
    else topic-in-list topic topics (i + 1) len

Section: Drain

  bus-drain : EventBus -> EventBus
  bus-drain (bus) = EventBus { subscriptions = bus.subscriptions, sub-count = bus.sub-count, events = [], event-count = 0, next-seq = bus.next-seq }

  bus-events-since : EventBus, Integer -> List BusEvent
  bus-events-since (bus) (seq) =
    filter-events-since (bus.events) seq 0 (bus.event-count) []

  filter-events-since : List BusEvent, Integer, Integer, Integer, List BusEvent -> List BusEvent
  filter-events-since (events) (seq) (i) (len) (acc) =
    if i >= len then acc
    else let ev = list-at events i
    in if ev.sequence >= seq then filter-events-since events seq (i + 1) len (list-push acc ev)
    else filter-events-since events seq (i + 1) len acc

Section: Queries

  bus-sub-count : EventBus -> Integer
  bus-sub-count (bus) = bus.sub-count

  bus-event-count : EventBus -> Integer
  bus-event-count (bus) = bus.event-count

  bus-stats : EventBus -> Text
  bus-stats (bus) = "subs=" & show (bus.sub-count) & " events=" & show (bus.event-count) & " seq=" & show (bus.next-seq)

