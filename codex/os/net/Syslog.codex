 We say:

Section: Constants
  syslog-port : Integer = 514

  syslog-facility-kern : Integer = 0
  syslog-facility-user : Integer = 1
  syslog-facility-daemon : Integer = 3
  syslog-facility-auth : Integer = 4
  syslog-facility-syslog : Integer = 5
  syslog-facility-local0 : Integer = 16
  syslog-facility-local7 : Integer = 23

  syslog-severity-emergency : Integer = 0
  syslog-severity-alert : Integer = 1
  syslog-severity-critical : Integer = 2
  syslog-severity-error : Integer = 3
  syslog-severity-warning : Integer = 4
  syslog-severity-notice : Integer = 5
  syslog-severity-info : Integer = 6
  syslog-severity-debug : Integer = 7

Section: Priority
  syslog-priority : Integer, Integer -> Integer
  syslog-priority (facility) (severity) = facility * 8 + severity

Section: Message Types
  SyslogMessage = record {
    facility : Integer between 0 and 23,
    severity : Integer between 0 and 7,
    hostname : Text,
    app-name : Text,
    msg : Text
  }

Section: Message Construction
  syslog-build-message : SyslogMessage -> List Integer
  syslog-build-message (m) =
    let pri = syslog-priority (m.facility) (m.severity)
    in let header = "<" & show pri & ">"
    in let body = header & m.hostname & " " & m.app-name & ": " & m.msg
    in syslog-text-to-bytes body

  syslog-text-to-bytes : Text -> List Integer
  syslog-text-to-bytes (s) =
    let cps = text-to-unicode-bytes s
    in syslog-encode-loop cps 0 (list-length cps) []

  syslog-encode-loop : List Integer, Integer, Integer, List Integer -> List Integer
  syslog-encode-loop (cps) (i) (len) (acc) =
    if i >= len then acc
    else let bs = utf8-encode-cp (list-at cps i)
    in syslog-encode-loop cps (i + 1) len (syslog-push-all acc bs 0 (list-length bs))

  syslog-push-all : List Integer, List Integer, Integer, Integer -> List Integer
  syslog-push-all (acc) (bs) (i) (n) =
    if i >= n then acc
    else syslog-push-all (list-push acc (list-at bs i)) bs (i + 1) n

Section: Convenience Builders
  syslog-emergency : Text, Text, Text -> SyslogMessage
  syslog-emergency (host) (app) (msg) = SyslogMessage { facility = syslog-facility-daemon, severity = syslog-severity-emergency, hostname = host, app-name = app, msg = msg }

  syslog-error : Text, Text, Text -> SyslogMessage
  syslog-error (host) (app) (msg) = SyslogMessage { facility = syslog-facility-daemon, severity = syslog-severity-error, hostname = host, app-name = app, msg = msg }

  syslog-warning : Text, Text, Text -> SyslogMessage
  syslog-warning (host) (app) (msg) = SyslogMessage { facility = syslog-facility-daemon, severity = syslog-severity-warning, hostname = host, app-name = app, msg = msg }

  syslog-info : Text, Text, Text -> SyslogMessage
  syslog-info (host) (app) (msg) = SyslogMessage { facility = syslog-facility-daemon, severity = syslog-severity-info, hostname = host, app-name = app, msg = msg }

  syslog-debug : Text, Text, Text -> SyslogMessage
  syslog-debug (host) (app) (msg) = SyslogMessage { facility = syslog-facility-daemon, severity = syslog-severity-debug, hostname = host, app-name = app, msg = msg }

  syslog-kern-info : Text, Text -> SyslogMessage
  syslog-kern-info (host) (msg) = SyslogMessage { facility = syslog-facility-kern, severity = syslog-severity-info, hostname = host, app-name = "kernel", msg = msg }

  syslog-auth-warning : Text, Text, Text -> SyslogMessage
  syslog-auth-warning (host) (app) (msg) = SyslogMessage { facility = syslog-facility-auth, severity = syslog-severity-warning, hostname = host, app-name = app, msg = msg }

Section: UDP Integration
  syslog-send-udp : List Integer, List Integer, Integer, SyslogMessage -> List Integer
  syslog-send-udp (src-ip) (syslog-ip) (src-port) (msg) =
    let payload = syslog-build-message msg
    in udp-build-ip-packet src-ip syslog-ip src-port syslog-port payload

  syslog-send-frame : List Integer, List Integer, List Integer, List Integer, Integer, SyslogMessage -> List Integer
  syslog-send-frame (dst-mac) (src-mac) (src-ip) (syslog-ip) (src-port) (msg) =
    let ip-pkt = syslog-send-udp src-ip syslog-ip src-port msg
    in eth-build-frame dst-mac src-mac eth-type-ipv4 ip-pkt

Section: Parsing
  SyslogParsed = record {
    priority : Integer,
    body : Text,
    valid : Boolean
  }

 RFC 5424 section 6.2.1 (and RFC 3164 4.1.1): the PRI is "<", one to three
 digits with no leading zero, then ">", so ">" sits at byte 4 at the latest,
 and the value is facility * 8 + severity, at most 23 * 8 + 7 = 191. The MSG
 is UTF-8.

  syslog-invalid : SyslogParsed
  syslog-invalid = SyslogParsed { priority = 0, body = "", valid = False }

  syslog-parse : List Integer -> SyslogParsed
  syslog-parse (data) =
    let dlen = list-length data
    in if dlen < 3 then syslog-invalid
    else if list-at data 0 /= 60 then syslog-invalid
    else let limit = min dlen 5
    in let pri-end = syslog-find-gt data 1 limit
    in if pri-end >= limit then syslog-invalid
    else if syslog-pri-ok data 1 pri-end then
      let pri = syslog-parse-digits data 1 pri-end 0
      in if pri > 191 then syslog-invalid
      else SyslogParsed { priority = pri, body = utf8-bytes-to-text (syslog-slice data (pri-end + 1) dlen []), valid = True }
    else syslog-invalid

  syslog-pri-ok : List Integer, Integer, Integer -> Boolean
  syslog-pri-ok (data) (start) (stop) =
    if stop - start < 1 then False
    else if stop - start > 1 then
      if list-at data start == 48 then False else syslog-all-digits data start stop
    else syslog-all-digits data start stop

  syslog-all-digits : List Integer, Integer, Integer -> Boolean
  syslog-all-digits (data) (i) (stop) =
    if i >= stop then True
    else if list-at data i < 48 then False
    else if list-at data i > 57 then False
    else syslog-all-digits data (i + 1) stop

  syslog-slice : List Integer, Integer, Integer, List Integer -> List Integer
  syslog-slice (data) (i) (n) (acc) =
    if i >= n then acc
    else syslog-slice data (i + 1) n (list-push acc (list-at data i))

  syslog-find-gt : List Integer, Integer, Integer -> Integer
  syslog-find-gt (data) (i) (dlen) =
    if i >= dlen then dlen
    else if list-at data i == 62 then i
    else syslog-find-gt data (i + 1) dlen

  syslog-parse-digits : List Integer, Integer, Integer, Integer -> Integer
  syslog-parse-digits (data) (i) (stop) (acc) =
    if i >= stop then acc
    else let d = list-at data i - 48
    in syslog-parse-digits data (i + 1) stop (acc * 10 + d)

Section: Formatting
  format-syslog : SyslogMessage -> Text
  format-syslog (m) =
    "<" & show (syslog-priority (m.facility) (m.severity)) & ">" & m.hostname & " " & m.app-name & ": " & m.msg

  syslog-severity-name : Integer -> Text
  syslog-severity-name (s) =
    if s == 0 then "EMERG"
    else if s == 1 then "ALERT"
    else if s == 2 then "CRIT"
    else if s == 3 then "ERR"
    else if s == 4 then "WARN"
    else if s == 5 then "NOTICE"
    else if s == 6 then "INFO"
    else if s == 7 then "DEBUG"
    else "?"

