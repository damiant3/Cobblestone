Chapter: NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet

 We say:

Section: ARP Cache
  ArpEntry = record {
    ip : List Integer,
    mac : List Integer
  }

  ArpCache = record {
    entries : List ArpEntry,
    count : Integer between 0 and 255
  }

  arp-cache-empty : ArpCache
  arp-cache-empty = ArpCache { entries = [], count = 0 }

  arp-cache-lookup : ArpCache, List Integer -> List Integer
  arp-cache-lookup (cache) (ip) = arp-cache-search (cache.entries) ip 0 (cache.count)

  arp-cache-search : List ArpEntry, List Integer, Integer, Integer -> List Integer
  arp-cache-search (entries) (ip) (i) (len) =
    if i >= len then []
    else let e = list-at entries i
    in if ip-equal (e.ip) ip then e.mac
    else arp-cache-search entries ip (i + 1) len

  arp-cache-add : ArpCache, List Integer, List Integer -> ArpCache
  arp-cache-add (cache) (ip) (mac) =
    ArpCache { entries = list-push (cache.entries) (ArpEntry { ip = ip, mac = mac }), count = cache.count + 1 }

Section: Network Session
  NetSession = record {
    local-mac : List Integer,
    local-ip : List Integer,
    gateway-ip : List Integer,
    conn : TcpConnection,
    arp : ArpCache,
    outbox : List (List Integer),
    rexmit-frame : List Integer,
    rexmit-ack : Integer,
    rexmit-rto : Integer,
    close-timer : Integer
  }

  net-session-new : List Integer, List Integer, List Integer, Integer, Integer, List Integer, Integer -> NetSession
  net-session-new (local-mac) (local-ip) (gateway-ip) (local-port) (remote-port) (remote-ip) (initial-seq) =
    NetSession {
      local-mac = local-mac,
      local-ip = local-ip,
      gateway-ip = gateway-ip,
      conn = tcp-new-connection local-port local-ip remote-port remote-ip initial-seq,
      arp = arp-cache-empty,
      outbox = [],
      rexmit-frame = [],
      rexmit-ack = 0,
      rexmit-rto = 0,
      close-timer = 0
    }

Section: Frame Wrapping
  tcp-pseudo-header : List Integer, List Integer, Integer -> List Integer
  tcp-pseudo-header (src-ip) (dst-ip) (tcp-len) =
    src-ip & dst-ip & [0, 6] & write-be16 tcp-len

  tcp-with-checksum : List Integer, List Integer, List Integer -> List Integer
  tcp-with-checksum (tcp-bytes) (src-ip) (dst-ip) =
    let tcp-len = list-length tcp-bytes
    in let pseudo = tcp-pseudo-header src-ip dst-ip tcp-len
    in let padded = if bit-and tcp-len 1 == 1 then pseudo & tcp-bytes & [0] else pseudo & tcp-bytes
    in let cksum = ip-checksum padded 0 (list-length padded) 0
    in list-set-at (list-set-at tcp-bytes 16 (bit-shru cksum 8)) 17 (bit-and cksum 255)

  wrap-tcp-in-ip-eth : NetSession, List Integer, List Integer -> List Integer
  wrap-tcp-in-ip-eth (sess) (tcp-bytes) (dst-mac) =
    let tcp-ck = tcp-with-checksum tcp-bytes (sess.local-ip) (sess.conn.remote-ip)
    in let ip-pkt = ip-build-packet (sess.local-ip) (sess.conn.remote-ip) ip-proto-tcp tcp-ck
    in eth-build-frame dst-mac (sess.local-mac) eth-type-ipv4 ip-pkt

  resolve-dst-mac : NetSession -> List Integer
  resolve-dst-mac (sess) =
    let cached = arp-cache-lookup (sess.arp) (sess.gateway-ip)
    in if list-length cached == 6 then cached
    else mac-broadcast

Section: Session Operations
  NetResult = record {
    session : NetSession,
    output : Text,
    data : List Integer
  }

  set-conn : NetSession, TcpConnection -> NetSession
  set-conn (s) (c) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = c, arp = s.arp, outbox = s.outbox, rexmit-frame = s.rexmit-frame, rexmit-ack = s.rexmit-ack, rexmit-rto = s.rexmit-rto, close-timer = s.close-timer }

  set-arp : NetSession, ArpCache -> NetSession
  set-arp (s) (a) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = a, outbox = s.outbox, rexmit-frame = s.rexmit-frame, rexmit-ack = s.rexmit-ack, rexmit-rto = s.rexmit-rto, close-timer = s.close-timer }

  set-outbox : NetSession, List (List Integer) -> NetSession
  set-outbox (s) (o) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = o, rexmit-frame = s.rexmit-frame, rexmit-ack = s.rexmit-ack, rexmit-rto = s.rexmit-rto, close-timer = s.close-timer }

Section: Reliability Timers

  net-rto-ticks : Integer = 3
  net-timewait-ticks : Integer = 4

  set-rexmit : NetSession, List Integer, Integer, Integer -> NetSession
  set-rexmit (s) (f) (ack) (rto) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-frame = f, rexmit-ack = ack, rexmit-rto = rto, close-timer = s.close-timer }

  set-close-timer : NetSession, Integer -> NetSession
  set-close-timer (s) (t) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-frame = s.rexmit-frame, rexmit-ack = s.rexmit-ack, rexmit-rto = s.rexmit-rto, close-timer = t }

  net-listen : NetSession -> NetResult
  net-listen (sess) =
    let step = tcp-step (sess.conn) EvListen
    in let s1 = set-conn sess (step.conn)
    in NetResult { session = s1, output = "listening", data = [] }

  net-connect : NetSession -> NetResult
  net-connect (sess) =
    let step = tcp-step (sess.conn) EvConnect
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (d) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (d) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in NetResult { session = set-outbox s1 frame, output = "connecting", data = [] }

  net-send : NetSession, List Integer -> NetResult
  net-send (sess) (payload) =
    let step = tcp-step (sess.conn) (EvSend payload)
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (d) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActError (m) -> []
      is ActNone -> []
      is ActEstablished -> []
      is ActData (d) -> []
      is ActClosed -> []
    in let out-text = when (step.action)
      is ActSend (seg) -> "sent " & show (list-length payload) & " bytes"
      is ActDataAck (d) (ack) -> "no action"
      is ActError (m) -> "error: " & m
      is ActNone -> "no action"
      is ActEstablished -> "no action"
      is ActData (d) -> "no action"
      is ActClosed -> "no action"
    in let s2 = set-outbox s1 frame
    in let s3 = if list-length payload > 0 & list-length frame > 0 then set-rexmit s2 (list-at frame 0) ((step.conn).send-next) net-rto-ticks else s2
    in NetResult { session = s3, output = out-text, data = [] }

  net-receive-segment : NetSession, TcpSegment -> NetResult
  net-receive-segment (sess) (seg) =
    let step = tcp-step (sess.conn) (EvSegment seg)
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActDataAck (d) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (d) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let recv = when (step.action)
      is ActData (d) -> d
      is ActDataAck (d) (ack) -> d
      is ActSend (s) -> []
      is ActNone -> []
      is ActEstablished -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let out-text = when (step.action)
      is ActData (d) -> "received " & show (list-length d) & " bytes"
      is ActDataAck (d) (ack) -> "received " & show (list-length d) & " bytes"
      is ActSend (s) -> "ack"
      is ActEstablished -> "established"
      is ActClosed -> "closed"
      is ActError (m) -> "error: " & m
      is ActNone -> "none"
    in let base = set-outbox s1 frame
    in let acked = tcp-has-flag seg tcp-flag-ack & seg.ack-num >= sess.rexmit-ack & sess.rexmit-rto > 0
    in let s2 = if acked then set-rexmit base [] 0 0 else base
    in let s3 = when ((step.conn).state)
      is TcpTimeWait -> set-close-timer s2 net-timewait-ticks
      is TcpLastAck -> set-close-timer s2 net-timewait-ticks
      is otherwise -> s2
    in NetResult { session = s3, output = out-text, data = recv }

  net-close : NetSession -> NetResult
  net-close (sess) =
    let step = tcp-step (sess.conn) EvClose
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (d) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (d) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let base = set-outbox s1 frame
    in let s2 = when ((step.conn).state)
      is TcpLastAck -> set-close-timer base net-timewait-ticks
      is otherwise -> base
    in NetResult { session = s2, output = "closing", data = [] }

  net-outbox-count : NetSession -> Integer
  net-outbox-count (sess) = list-length (sess.outbox)

  net-outbox-frame : NetSession, Integer -> List Integer
  net-outbox-frame (sess) (i) = list-at (sess.outbox) i

Section: Inbound Frame Processing
  net-process-frame : NetSession, List Integer -> NetResult
  net-process-frame (sess) (frame) =
    let et = eth-ethertype frame
    in if et == eth-type-arp then net-process-arp sess (eth-payload frame)
    else if et == eth-type-ipv4 then net-process-ip sess (eth-payload frame)
    else NetResult { session = sess, output = "unknown ethertype", data = [] }

  net-process-arp : NetSession, List Integer -> NetResult
  net-process-arp (sess) (payload) =
    let pkt = arp-parse payload
    in let new-arp = arp-cache-add (sess.arp) (pkt.sender-ip) (pkt.sender-mac)
    in NetResult { session = set-arp sess new-arp, output = "arp-learned", data = [] }

 THIS CHECK WAS ABSENT UNTIL 2026-07-20 AND ITS ABSENCE WAS INVISIBLE, because
 nothing in the tree had ever run two connections at once. `net-receive-segment`
 fed every TCP frame straight into `tcp-step` on whatever session was looping,
 so a session processed traffic addressed to a port it does not own.

  net-session-owns-segment : NetSession, TcpSegment -> Boolean
  net-session-owns-segment (sess) (seg) =
    if seg.dst-port /= (sess.conn).local-port then False
    else if (sess.conn).remote-port == 0 then True
    else seg.src-port == (sess.conn).remote-port

  net-in-established : NetSession -> Boolean
  net-in-established (sess) = when ((sess.conn).state)
    is TcpEstablished -> True
    is otherwise -> False

 The RFC 793 acceptability test: a data segment is in the receive window unless it
 is entirely old (every byte already delivered, so `seq + len <= recv-next` -- a
 duplicate a lossy peer retransmitted after losing our ACK) or it starts beyond
 the window we advertised (`seq >= recv-next + window`). Everything else overlaps
 the window and is delivered; the byte stream is reassembled above by payload
 order, so a forward seq gap within the window is not rejected here.

  net-seg-acceptable : NetSession, TcpSegment -> Boolean
  net-seg-acceptable (sess) (seg) =
    let rn = (sess.conn).recv-next
    in let win = (sess.conn).send-window
    in let seg-end = seg.seq-num + list-length (seg.payload)
    in if seg-end <= rn then False
    else if seg.seq-num >= rn + win then False
    else True

  net-dup-ack : NetSession -> NetResult
  net-dup-ack (sess) =
    let c = sess.conn
    in let ack = tcp-build-segment (c.local-port) (c.remote-port) (c.send-next) (c.recv-next) tcp-flag-ack (c.send-window) []
    in let frame = [wrap-tcp-in-ip-eth sess ack (resolve-dst-mac sess)]
    in NetResult { session = set-outbox sess frame, output = "out-of-window", data = [] }

  net-process-ip : NetSession, List Integer -> NetResult
  net-process-ip (sess) (ip-pkt) =
    let proto = ip-proto ip-pkt
    in if proto == ip-proto-tcp then
      let tcp-data = ip-payload ip-pkt
      in let seg = tcp-parse tcp-data
      in if net-session-owns-segment sess seg == False
        then NetResult { session = sess, output = "not-for-this-port", data = [] }
      else if net-in-established sess & list-length (seg.payload) > 0 & net-seg-acceptable sess seg == False
        then net-dup-ack sess
      else let r = net-receive-segment sess seg
      in let updated = when (r.session).conn.state
        is TcpSynReceived -> NetResult { session = set-conn (r.session) (set-remote ((r.session).conn) ((r.session).conn.remote-port) (ip-src ip-pkt)), output = r.output, data = r.data }
        is otherwise -> r
      in updated
    else NetResult { session = sess, output = "unknown proto", data = [] }

Section: Timer Tick

  net-tick : NetSession -> NetResult
  net-tick (sess) =
    let r1 = if sess.rexmit-rto == 1 then set-rexmit (set-outbox sess [sess.rexmit-frame]) (sess.rexmit-frame) (sess.rexmit-ack) net-rto-ticks
      else if sess.rexmit-rto > 1 then set-rexmit sess (sess.rexmit-frame) (sess.rexmit-ack) (sess.rexmit-rto - 1)
      else sess
    in let r2 = if r1.close-timer == 1 then set-close-timer (set-conn r1 (tcp-set-state (r1.conn) TcpClosed)) 0
      else if r1.close-timer > 1 then set-close-timer r1 (r1.close-timer - 1)
      else r1
    in NetResult { session = r2, output = "tick", data = [] }

