Chapter: NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet

 We say:

Section: ARP Cache
  ArpEntry = record {
    ip : List Integer,
    mac : List Integer
  }

  ArpCache = record {
    entries : List ArpEntry,
    count : Integer between 0 and 255
  }

  arp-cache-empty : ArpCache
  arp-cache-empty = ArpCache { entries = [], count = 0 }

  arp-cache-lookup : ArpCache, List Integer -> List Integer
  arp-cache-lookup (cache) (ip) = arp-cache-search (cache.entries) ip 0 (cache.count)

  arp-cache-search : List ArpEntry, List Integer, Integer, Integer -> List Integer
  arp-cache-search (entries) (ip) (i) (len) =
    if i >= len then []
    else let e = list-at entries i
    in if ip-equal (e.ip) ip then e.mac
    else arp-cache-search entries ip (i + 1) len

 Refuse at capacity rather than evict. Eviction would let a flood push the
 GATEWAY entry out, which is the one mapping this stack cannot work without and
 is learned first, so refusing keeps what was already learned and drops only
 the flood.

  arp-cache-max : Integer = 64

  arp-cache-index : List ArpEntry, List Integer, Integer, Integer -> Integer
  arp-cache-index (entries) (ip) (i) (len) =
    if i >= len then 0 - 1
    else if ip-equal ((list-at entries i).ip) ip then i
    else arp-cache-index entries ip (i + 1) len

  arp-cache-add : ArpCache, List Integer, List Integer -> ArpCache
  arp-cache-add (cache) (ip) (mac) =
    let at = arp-cache-index (cache.entries) ip 0 (cache.count)
    in if at >= 0
      then ArpCache { entries = list-set-at (cache.entries) at (ArpEntry { ip = ip, mac = mac }), count = cache.count }
    else if cache.count >= arp-cache-max then cache
    else ArpCache { entries = list-push (cache.entries) (ArpEntry { ip = ip, mac = mac }), count = cache.count + 1 }

Section: Network Session
  NetSession = record {
    local-mac : List Integer,
    local-ip : List Integer,
    gateway-ip : List Integer,
    conn : TcpConnection,
    arp : ArpCache,
    outbox : List (List Integer),
    rexmit-queue : List RexmitSeg,
    rexmit-rto : Integer,
    rexmit-tries : Integer,
    close-timer : Integer,
    now-ticks : Integer,
    srtt : Integer,
    rttvar : Integer
  }

  RexmitSeg = record {
    rx-frame : List Integer,
    rx-ack : Integer,
    rx-sent : Integer,
    rx-resent : Boolean
  }

  net-session-new : List Integer, List Integer, List Integer, Integer, Integer, List Integer, Integer -> NetSession
  net-session-new (local-mac) (local-ip) (gateway-ip) (local-port) (remote-port) (remote-ip) (initial-seq) =
    NetSession {
      local-mac = local-mac,
      local-ip = local-ip,
      gateway-ip = gateway-ip,
      conn = tcp-new-connection local-port local-ip remote-port remote-ip initial-seq,
      arp = arp-cache-empty,
      outbox = [],
      rexmit-queue = [],
      rexmit-rto = 0,
      rexmit-tries = 0,
      close-timer = 0,
      now-ticks = 0,
      srtt = 0,
      rttvar = 0
    }

Section: Frame Wrapping
  tcp-pseudo-header : List Integer, List Integer, Integer -> List Integer
  tcp-pseudo-header (src-ip) (dst-ip) (tcp-len) =
    src-ip & dst-ip & [0, 6] & write-be16 tcp-len

  tcp-with-checksum : List Integer, List Integer, List Integer -> List Integer
  tcp-with-checksum (tcp-bytes) (src-ip) (dst-ip) =
    let tcp-len = list-length tcp-bytes
    in let pseudo = tcp-pseudo-header src-ip dst-ip tcp-len
    in let cksum = ip-checksum tcp-bytes 0 tcp-len (ip-sum pseudo 0 (list-length pseudo) 0)
    in list-set-at (list-set-at tcp-bytes 16 (bit-shru cksum 8)) 17 (bit-and cksum 255)

 The pseudo-header and the odd-length pad are the same two the builder above
 constructs, because RFC 793 defines the checksum over exactly that shape and
 the receiver has to reproduce it byte for byte. The stored field at 16..17 is
 left in place: it is part of the sum, which is what makes a valid segment fold
 to zero.

  tcp-checksum-valid-at : List Integer, Integer, Integer, List Integer, List Integer -> Boolean
  tcp-checksum-valid-at (buf) (off) (stop) (src-ip) (dst-ip) =
    let tcp-len = stop - off
    in if tcp-len < 20 then False
    else let pseudo = tcp-pseudo-header src-ip dst-ip tcp-len
    in ip-checksum buf off stop (ip-sum pseudo 0 (list-length pseudo) 0) == 0

  tcp-checksum-valid : List Integer, List Integer, List Integer -> Boolean
  tcp-checksum-valid (tcp-bytes) (src-ip) (dst-ip) =
    tcp-checksum-valid-at tcp-bytes 0 (list-length tcp-bytes) src-ip dst-ip

  wrap-tcp-in-ip-eth : NetSession, List Integer, List Integer -> List Integer
  wrap-tcp-in-ip-eth (sess) (tcp-bytes) (dst-mac) =
    let tcp-ck = tcp-with-checksum tcp-bytes (sess.local-ip) (sess.conn.remote-ip)
    in let ip-pkt = ip-build-packet (sess.local-ip) (sess.conn.remote-ip) ip-proto-tcp tcp-ck
    in eth-build-frame dst-mac (sess.local-mac) eth-type-ipv4 ip-pkt

  resolve-dst-mac : NetSession -> List Integer
  resolve-dst-mac (sess) =
    let cached = arp-cache-lookup (sess.arp) (sess.gateway-ip)
    in if list-length cached == 6 then cached
    else mac-broadcast

Section: Session Operations
  NetResult = record {
    session : NetSession,
    output : Text,
    data : List Integer,
    data-off : Integer,
    data-stop : Integer
  }

  set-conn : NetSession, TcpConnection -> NetSession
  set-conn (s) (c) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = c, arp = s.arp, outbox = s.outbox, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = s.close-timer, now-ticks = s.now-ticks, srtt = s.srtt, rttvar = s.rttvar }

  set-arp : NetSession, ArpCache -> NetSession
  set-arp (s) (a) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = a, outbox = s.outbox, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = s.close-timer, now-ticks = s.now-ticks, srtt = s.srtt, rttvar = s.rttvar }

  set-outbox : NetSession, List (List Integer) -> NetSession
  set-outbox (s) (o) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = o, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = s.close-timer, now-ticks = s.now-ticks, srtt = s.srtt, rttvar = s.rttvar }

Section: Reliability Timers

  net-rto-ticks : Integer = 3
  net-timewait-ticks : Integer = 4

 A tick is whatever period the caller drives the session at, so these are
 counts and not durations. The retry ceiling exists because bare metal has
 no operator: an unbounded retransmit into a peer that has gone away is a
 device that never stops and never reports, which is the failure this
 project exists to prevent, and it is the same bound DtlsHandshake takes at
 10. Five retransmissions with the interval doubling spans 141 ticks before
 the connection is declared dead. At five tries the clamp binds only the
 last interval: unclamped that one would be 96 ticks rather than 48, which
 buys nothing against a peer already silent through four and pushes the
 give-up out to 189 ticks.

  net-rto-max-tries : Integer = 5
  net-rto-max-ticks : Integer = 48

 RFC 6298 sections 2 and 3, in ticks rather than seconds. The caller decides
 what a tick is worth and never tells us, which is why net-rto-ticks was a
 fixed 3 for as long as it was: an interval cannot be a duration here. The
 estimator does not need one. It needs only that the tick RATE is steady,
 and then the ratio between a measured round trip and the retransmit
 interval is right whatever the rate turns out to be. A fixed 3 is wrong in
 both directions at once -- far too eager on a slow link, far too patient on
 a fast one -- and no calibration was ever required to fix that.

 That holds for the ESTIMATOR only. The initial interval, net-rto-min-ticks,
 net-rto-max-ticks and the give-up ladder are wall-clock quantities written as
 tick counts, and mean what the caller's tick rate makes them mean.

 srtt is carried scaled by 8 and rttvar by 4, the standard integer form.
 The 1/8 and 1/4 gains are then shifts, and a divide-then-store does not
 truncate the estimate a little further on every single update.

  net-rto-min-ticks : Integer = 2

  set-rtt : NetSession, Integer, Integer -> NetSession
  set-rtt (s) (sr) (rv) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = s.close-timer, now-ticks = s.now-ticks, srtt = sr, rttvar = rv }

  set-now : NetSession, Integer -> NetSession
  set-now (s) (n) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = s.close-timer, now-ticks = n, srtt = s.srtt, rttvar = s.rttvar }

 A sample of zero is a round trip that completed inside one tick, not an
 absent measurement, and the two must not share a representation: srtt = 0
 is what "never measured" means here, so a zero sample would silently
 discard itself and leave the fixed default in place forever on the fastest
 links. It is floored at one tick instead, which is RFC 6298's clock
 granularity G doing its ordinary job -- the true value is below what this
 clock can express, and one tick is the smallest thing it can honestly say.

  net-rtt-update : NetSession, Integer -> NetSession
  net-rtt-update (s) (m) =
    if m < 0 then s
    else net-rtt-first s (if m == 0 then 1 else m)

  net-rtt-first : NetSession, Integer -> NetSession
  net-rtt-first (s) (m) =
    if s.srtt == 0 then set-rtt s (bit-shl m 3) (bit-shl m 1)
    else net-rtt-again s m

  net-rtt-again : NetSession, Integer -> NetSession
  net-rtt-again (s) (m) =
    let err = m - bit-shru (s.srtt) 3
    in let dev = if err < 0 then 0 - err else err
    in set-rtt s (s.srtt + err) (s.rttvar + (dev - bit-shru (s.rttvar) 2))

  net-rto-base : NetSession -> Integer
  net-rto-base (s) =
    if s.srtt == 0 then net-rto-ticks
    else net-rto-clamp (bit-shru (s.srtt) 3 + s.rttvar)

  net-rto-clamp : Integer -> Integer
  net-rto-clamp (t) =
    if t < net-rto-min-ticks then net-rto-min-ticks
    else if t > net-rto-max-ticks then net-rto-max-ticks
    else t

  net-rto-backoff : NetSession, Integer -> Integer
  net-rto-backoff (s) (tries) = net-rto-clamp (bit-shl (net-rto-base s) tries)

 Karn's algorithm, RFC 6298 section 3. A segment that was retransmitted
 cannot be sampled: the ack does not say which copy it answers, and the
 wrong guess feeds the estimator a round trip that never happened. It
 matters most under exactly the loss the estimator exists to survive, which
 is why the flag is carried per segment rather than inferred from the retry
 counter -- the counter is reset by any retiring ack, and a segment already
 retransmitted would become sampleable again.

  net-rtt-measure : List RexmitSeg, Integer, Integer, Integer -> Integer
  net-rtt-measure (q) (ack) (now) (i) =
    if i >= list-length q then 0 - 1
    else let e = list-at q i
    in if tcp-seq-le (e.rx-ack) ack & e.rx-resent == False then now - e.rx-sent
    else net-rtt-measure q ack now (i + 1)

  net-mark-resent : List RexmitSeg, Integer, List RexmitSeg -> List RexmitSeg
  net-mark-resent (q) (i) (acc) =
    if i >= list-length q then acc
    else let e = list-at q i
    in let e2 = if i == 0 then RexmitSeg { rx-frame = e.rx-frame, rx-ack = e.rx-ack, rx-sent = e.rx-sent, rx-resent = True } else e
    in net-mark-resent q (i + 1) (list-push acc e2)

  set-rexmit : NetSession, List RexmitSeg, Integer, Integer -> NetSession
  set-rexmit (s) (q) (rto) (tries) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-queue = q, rexmit-rto = rto, rexmit-tries = tries, close-timer = s.close-timer, now-ticks = s.now-ticks, srtt = s.srtt, rttvar = s.rttvar }

  set-close-timer : NetSession, Integer -> NetSession
  set-close-timer (s) (t) = NetSession { local-mac = s.local-mac, local-ip = s.local-ip, gateway-ip = s.gateway-ip, conn = s.conn, arp = s.arp, outbox = s.outbox, rexmit-queue = s.rexmit-queue, rexmit-rto = s.rexmit-rto, rexmit-tries = s.rexmit-tries, close-timer = t, now-ticks = s.now-ticks, srtt = s.srtt, rttvar = s.rttvar }

 The queue is bounded because there is no collector and the peer decides how
 fast it stops acking. An unbounded queue would let a silent peer choose our
 memory ceiling, which is the one thing a bare-metal stack must not concede,
 so a send past the bound is refused rather than served.

 The bound applies to DATA only, and the true ceiling is therefore nine
 rather than eight: net-close arms the FIN through the same queue without
 consulting the capacity, deliberately, because refusing to close a
 connection is a worse failure than carrying one more entry. A SYN cannot
 add to it, since a connection with anything queued is past CLOSED.

  net-rexmit-capacity : Integer = 8

  net-rexmit-full : NetSession -> Boolean
  net-rexmit-full (s) = list-length (s.rexmit-queue) >= net-rexmit-capacity

 The timer belongs to the OLDEST unacked segment (RFC 6298 section 5), so it
 is armed only when the queue goes from empty to occupied. A later send joins
 a timer that is already running rather than restarting it, which is what
 stops a steady stream of sends from postponing the first segment's deadline
 forever.

  net-rexmit-arm : NetSession, List Integer, Integer -> NetSession
  net-rexmit-arm (s) (frame) (ack) =
    let was-empty = list-length (s.rexmit-queue) == 0
    in let q = list-push (s.rexmit-queue) (RexmitSeg { rx-frame = frame, rx-ack = ack, rx-sent = s.now-ticks, rx-resent = False })
    in if was-empty then set-rexmit s q (net-rto-base s) 0
    else set-rexmit s q (s.rexmit-rto) (s.rexmit-tries)

  net-rexmit-prune : List RexmitSeg, Integer, Integer, List RexmitSeg -> List RexmitSeg
  net-rexmit-prune (q) (ack) (i) (acc) =
    if i >= list-length q then acc
    else let e = list-at q i
    in if tcp-seq-le (e.rx-ack) ack then net-rexmit-prune q ack (i + 1) acc
    else net-rexmit-prune q ack (i + 1) (list-push acc e)

  net-rexmit-retire : NetSession, List RexmitSeg -> NetSession
  net-rexmit-retire (s) (q) =
    if list-length q == 0 then set-rexmit s q 0 0
    else set-rexmit s q (net-rto-base s) 0

 A listener is constructed, not stepped: RFC 793 has no arc from FIN_WAIT_1 to
 LISTEN. The wait for the peer's FIN-ACK is abandoned, a deliberate deviation
 from RFC 793 section 3.5, because this stack serves one connection at a time.

 SYN_RECEIVED is not reset, because the client's ACK may still be in flight;
 it is BOUNDED rather than held, so a caller that sends a SYN and vanishes
 cannot pin the single socket. The bound counts re-listens rather than ticks
 because `arm64-net-io-accept` never calls `net-tick`.

  net-halfopen-relisten-budget : Integer = 8

  net-fresh-listen : NetSession -> NetResult
  net-fresh-listen (sess) =
    let s1 = set-conn sess (tcp-fresh-listener (sess.conn))
    in let s2 = set-rexmit s1 [] 0 0
    in let s3 = set-close-timer s2 0
    in NetResult { session = s3, output = "listening", data = [], data-off = 0, data-stop = 0 }

  net-listen : NetSession -> NetResult
  net-listen (sess) =
    when ((sess.conn).state)
      is TcpSynReceived ->
        if sess.close-timer == 0
          then NetResult { session = set-close-timer sess net-halfopen-relisten-budget, output = "listening", data = [], data-off = 0, data-stop = 0 }
        else if sess.close-timer > 1
          then NetResult { session = set-close-timer sess ((sess.close-timer) - 1), output = "listening", data = [], data-off = 0, data-stop = 0 }
        else net-fresh-listen sess
      is otherwise -> net-fresh-listen sess

  net-connect : NetSession -> NetResult
  net-connect (sess) =
    let step = tcp-step (sess.conn) EvConnect
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (pb) (po) (ps) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (pb) (po) (ps) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let base = set-outbox s1 frame
    in let s2 = if list-length frame > 0 then net-rexmit-arm base (list-at frame 0) ((step.conn).send-next) else base
    in NetResult { session = s2, output = "connecting", data = [], data-off = 0, data-stop = 0 }

  net-send : NetSession, List Integer -> NetResult
  net-send (sess) (payload) =
    if list-length payload > 0 & net-rexmit-full sess then NetResult { session = sess, output = "send queue full", data = [], data-off = 0, data-stop = 0 }
    else net-send-go sess payload

  net-send-go : NetSession, List Integer -> NetResult
  net-send-go (sess) (payload) =
    let step = tcp-step (sess.conn) (EvSend payload)
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (pb) (po) (ps) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActError (m) -> []
      is ActNone -> []
      is ActEstablished -> []
      is ActData (pb) (po) (ps) -> []
      is ActClosed -> []
    in let out-text = when (step.action)
      is ActSend (seg) -> "sent " & show (list-length payload) & " bytes"
      is ActDataAck (pb) (po) (ps) (ack) -> "no action"
      is ActError (m) -> "error: " & m
      is ActNone -> "no action"
      is ActEstablished -> "no action"
      is ActData (pb) (po) (ps) -> "no action"
      is ActClosed -> "no action"
    in let s2 = set-outbox s1 frame
    in let s3 = if list-length payload > 0 & list-length frame > 0 then net-rexmit-arm s2 (list-at frame 0) ((step.conn).send-next) else s2
    in NetResult { session = s3, output = out-text, data = [], data-off = 0, data-stop = 0 }

  net-receive-segment : NetSession, TcpSegment -> NetResult
  net-receive-segment (sess) (seg) =
    let step = tcp-step (sess.conn) (EvSegment seg)
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActDataAck (pb) (po) (ps) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (pb) (po) (ps) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let recv-buf = when (step.action)
      is ActData (pb) (po) (ps) -> pb
      is ActDataAck (pb) (po) (ps) (ack) -> pb
      is ActSend (s) -> []
      is ActNone -> []
      is ActEstablished -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let recv-off = when (step.action)
      is ActData (pb) (po) (ps) -> po
      is ActDataAck (pb) (po) (ps) (ack) -> po
      is ActSend (s) -> 0
      is ActNone -> 0
      is ActEstablished -> 0
      is ActClosed -> 0
      is ActError (m) -> 0
    in let recv-stop = when (step.action)
      is ActData (pb) (po) (ps) -> ps
      is ActDataAck (pb) (po) (ps) (ack) -> ps
      is ActSend (s) -> 0
      is ActNone -> 0
      is ActEstablished -> 0
      is ActClosed -> 0
      is ActError (m) -> 0    in let out-text = when (step.action)
      is ActData (pb) (po) (ps) -> "received " & show (ps - po) & " bytes"
      is ActDataAck (pb) (po) (ps) (ack) -> "received " & show (ps - po) & " bytes"
      is ActSend (s) -> "ack"
      is ActEstablished -> "established"
      is ActClosed -> "closed"
      is ActError (m) -> "error: " & m
      is ActNone -> "none"
    in let base = set-outbox s1 frame
    in let q0 = sess.rexmit-queue
    in let acking = tcp-has-flag seg tcp-flag-ack & list-length q0 > 0
    in let q2 = if acking then net-rexmit-prune q0 (seg.ack-num) 0 [] else q0
    in let m = if acking then net-rtt-measure q0 (seg.ack-num) (sess.now-ticks) 0 else 0 - 1
    in let base2 = net-rtt-update base m
    in let s2 = if list-length q2 < list-length q0 then net-rexmit-retire base2 q2 else base2
    in let s3 = when ((step.conn).state)
      is TcpTimeWait -> set-close-timer s2 net-timewait-ticks
      is TcpLastAck -> set-close-timer s2 net-timewait-ticks
      is TcpEstablished -> set-close-timer s2 0
      is otherwise -> s2
    in NetResult { session = s3, output = out-text, data = recv-buf, data-off = recv-off, data-stop = recv-stop }

  net-close : NetSession -> NetResult
  net-close (sess) =
    let step = tcp-step (sess.conn) EvClose
    in let s1 = set-conn sess (step.conn)
    in let frame = when (step.action)
      is ActSend (seg) -> [wrap-tcp-in-ip-eth s1 seg (resolve-dst-mac s1)]
      is ActDataAck (pb) (po) (ps) (ack) -> [wrap-tcp-in-ip-eth s1 ack (resolve-dst-mac s1)]
      is ActNone -> []
      is ActEstablished -> []
      is ActData (pb) (po) (ps) -> []
      is ActClosed -> []
      is ActError (m) -> []
    in let base = set-outbox s1 frame
    in let s2 = when ((step.conn).state)
      is TcpLastAck -> set-close-timer base net-timewait-ticks
      is otherwise -> base
    in let s3 = if list-length frame > 0 then net-rexmit-arm s2 (list-at frame 0) ((step.conn).send-next) else s2
    in NetResult { session = s3, output = "closing", data = [], data-off = 0, data-stop = 0 }

  net-outbox-count : NetSession -> Integer
  net-outbox-count (sess) = list-length (sess.outbox)

  net-outbox-frame : NetSession, Integer -> List Integer
  net-outbox-frame (sess) (i) = list-at (sess.outbox) i

Section: Inbound Frame Processing
  net-process-frame : NetSession, List Integer -> NetResult
  net-process-frame (sess) (frame) = net-process-frame-within sess frame (list-length frame)

  net-process-frame-within : NetSession, List Integer, Integer -> NetResult
  net-process-frame-within (sess) (frame) (stop) =
    let lim = if stop > list-length frame then list-length frame else stop
    in let et = eth-ethertype-within frame lim
    in if et == eth-type-arp then net-process-arp sess (eth-payload-loop frame eth-header-size lim [])
    else if et == eth-type-ipv4 then net-process-ip-within sess frame eth-header-size lim
    else NetResult { session = sess, output = "unknown ethertype", data = [], data-off = 0, data-stop = 0 }

 We learn only from an ARP reply addressed to us: learning from any frame on
 the wire is cache poisoning by construction, and RFC 826's licence to record
 the sender of a request is exactly the licence a forged request would use. A
 request aimed at us is answered from `pkt.sender-mac` and teaches nothing.

  net-process-arp : NetSession, List Integer -> NetResult
  net-process-arp (sess) (payload) =
    let pkt = arp-parse payload
    in if (pkt.op == arp-op-request) & ip-equal (pkt.target-ip) (sess.local-ip)
    then let reply = arp-build-reply (sess.local-mac) (sess.local-ip) (pkt.sender-mac) (pkt.sender-ip) (sess.local-mac)
    in NetResult { session = set-outbox sess ((sess.outbox) & [reply]), output = "arp-replied", data = [], data-off = 0, data-stop = 0 }
    else if (pkt.op == arp-op-reply) & ip-equal (pkt.target-ip) (sess.local-ip)
    then NetResult { session = set-arp sess (arp-cache-add (sess.arp) (pkt.sender-ip) (pkt.sender-mac)), output = "arp-learned", data = [], data-off = 0, data-stop = 0 }
    else NetResult { session = sess, output = "arp-ignored", data = [], data-off = 0, data-stop = 0 }

  net-arp-solicit : NetSession, List Integer -> NetSession
  net-arp-solicit (sess) (target) =
    set-outbox sess ((sess.outbox) & [arp-build-request (sess.local-mac) (sess.local-ip) target])

  net-arp-known : NetSession, List Integer -> Boolean
  net-arp-known (sess) (target) = list-length (arp-cache-lookup (sess.arp) target) == 6

  net-session-owns-segment : NetSession, TcpSegment -> Boolean
  net-session-owns-segment (sess) (seg) =
    if seg.dst-port /= (sess.conn).local-port then False
    else if (sess.conn).remote-port == 0 then True
    else seg.src-port == (sess.conn).remote-port

  net-in-established : NetSession -> Boolean
  net-in-established (sess) = when ((sess.conn).state)
    is TcpEstablished -> True
    is otherwise -> False

 The RFC 793 acceptability test: a data segment is in the receive window unless it
 is entirely old (every byte already delivered, so `seq + len <= recv-next` -- a
 duplicate a lossy peer retransmitted after losing our ACK) or it starts beyond
 the window we advertised (`seq >= recv-next + window`). Everything else overlaps
 the window and is delivered; the byte stream is reassembled above by payload
 order, so a forward seq gap within the window is not rejected here.

  net-seg-acceptable : NetSession, TcpSegment -> Boolean
  net-seg-acceptable (sess) (seg) =
    let rn = (sess.conn).recv-next
    in let win = (sess.conn).send-window
    in let seg-end = tcp-seq-wrap (seg.seq-num + tcp-seg-payload-len seg)
    in if tcp-seq-le seg-end rn then False
    else if tcp-seq-ge (seg.seq-num) (tcp-seq-wrap (rn + win)) then False
    else True

  net-dup-ack : NetSession -> NetResult
  net-dup-ack (sess) =
    let c = sess.conn
    in let ack = tcp-build-segment (c.local-port) (c.remote-port) (c.send-next) (c.recv-next) tcp-flag-ack (c.send-window) []
    in let frame = [wrap-tcp-in-ip-eth sess ack (resolve-dst-mac sess)]
    in NetResult { session = set-outbox sess frame, output = "out-of-window", data = [], data-off = 0, data-stop = 0 }

 A segment that fails any of the three tests is DROPPED and not acknowledged, which
 RFC 1122 4.2.3.2 requires: the sequence and port numbers an ACK would quote
 are drawn from the bytes just found untrustworthy. The peer's retransmit
 timer is what recovers it. The named output exists so a caller can see the
 refusal happen, the way not-for-this-port already can.

  net-process-ip : NetSession, List Integer -> NetResult
  net-process-ip (sess) (ip-pkt) = net-process-ip-at sess ip-pkt 0

  net-process-ip-at : NetSession, List Integer, Integer -> NetResult
  net-process-ip-at (sess) (pkt) (off) = net-process-ip-within sess pkt off (list-length pkt)

  net-process-ip-within : NetSession, List Integer, Integer, Integer -> NetResult
  net-process-ip-within (sess) (pkt) (off) (stop) =
    if ip-length-valid-within pkt off stop == False then NetResult { session = sess, output = "bad-ip-length", data = [], data-off = 0, data-stop = 0 }
    else if ip-header-valid-within pkt off stop == False then NetResult { session = sess, output = "bad-ip-checksum", data = [], data-off = 0, data-stop = 0 }
    else let proto = ip-proto-at pkt off
    in if proto == ip-proto-tcp then
      let tcp-off = off + ip-header-size
      in let tcp-stop = off + ip-total-length-at pkt off
      in if tcp-checksum-valid-at pkt tcp-off tcp-stop (ip-src-at pkt off) (ip-dst-at pkt off) == False
        then NetResult { session = sess, output = "bad-tcp-checksum", data = [], data-off = 0, data-stop = 0 }
      else let seg = tcp-parse-at pkt tcp-off tcp-stop
      in if net-session-owns-segment sess seg == False
        then NetResult { session = sess, output = "not-for-this-port", data = [], data-off = 0, data-stop = 0 }
      else if net-in-established sess & tcp-seg-payload-len seg > 0 & net-seg-acceptable sess seg == False
        then net-dup-ack sess
      else let r = net-receive-segment sess seg
      in let updated = when (r.session).conn.state
        is TcpSynReceived -> NetResult { session = set-conn (r.session) (set-remote ((r.session).conn) ((r.session).conn.remote-port) (ip-src-at pkt off)), output = r.output, data = r.data, data-off = r.data-off, data-stop = r.data-stop }
        is otherwise -> r
      in updated
    else NetResult { session = sess, output = "unknown proto", data = [], data-off = 0, data-stop = 0 }

Section: Timer Tick

  net-tick : NetSession -> NetResult
  net-tick (sess) =
    let s0 = set-now sess (sess.now-ticks + 1)
    in let expired = s0.rexmit-rto == 1 & list-length (s0.rexmit-queue) > 0
    in let gave-up = expired & s0.rexmit-tries >= net-rto-max-tries
    in let r1 = if gave-up then set-rexmit (set-conn s0 (tcp-set-state (s0.conn) TcpClosed)) [] 0 0
      else if expired then net-rexmit-again s0
      else if s0.rexmit-rto > 1 then set-rexmit s0 (s0.rexmit-queue) (s0.rexmit-rto - 1) (s0.rexmit-tries)
      else s0
    in let r2 = if r1.close-timer == 1 then set-close-timer (set-conn r1 (tcp-set-state (r1.conn) TcpClosed)) 0
      else if r1.close-timer > 1 then set-close-timer r1 (r1.close-timer - 1)
      else r1
    in let out = if gave-up then "rexmit-giveup" else "tick"
    in NetResult { session = r2, output = out, data = [], data-off = 0, data-stop = 0 }

  net-rexmit-again : NetSession -> NetSession
  net-rexmit-again (sess) =
    let n = sess.rexmit-tries + 1
    in let head = list-at (sess.rexmit-queue) 0
    in let q2 = net-mark-resent (sess.rexmit-queue) 0 []
    in set-rexmit (set-outbox sess [head.rx-frame]) q2 (net-rto-backoff sess n) n

