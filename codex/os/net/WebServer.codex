Section: Byte Codec (Unicode wire <-> CCE)

  local-mac : List Integer = net-driver-mac
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

  ws-text-to-bytes : Text, Integer, Integer, List Integer -> List Integer
  ws-text-to-bytes (s) (i) (stop) (acc) =
    if i >= stop then acc
    else ws-text-to-bytes s (i + 1) stop (list-push acc (to-unicode (char-code (char-at s i))))

  bytes-to-text : List Integer, Integer, Integer, Text -> Text
  bytes-to-text (bs) (off) (total) (acc) =
    if off >= total then acc
    else acc & text-concat-list (bytes-to-text-pieces bs off total (__list-with-capacity (total - off + 1)))

  bytes-to-text-pieces : List Integer, Integer, Integer, List Text -> List Text
  bytes-to-text-pieces (bs) (i) (stop) (acc) =
    if i >= stop then acc
    else let cce = from-unicode (list-at bs i)
    in bytes-to-text-pieces bs (i + 1) stop (list-push acc (char-to-text (code-to-char cce)))

Section: HTTP Serve Loop

  web-send-http : TcpTransportState, HttpResponse -> [Network.Read, Network.Write] TcpTransportState
  web-send-http (ts) (resp) =
    let response-bytes = http-encode resp
    in act
      r <- net-io-send-raw-checked ts response-bytes
      if r.ns-complete then r.ns-transport
      else net-io-close (r.ns-transport)
    end

  WebLoop = record { server : WebState, transport : TcpTransportState }

  web-handle-http : (HttpRequest -> HttpResponse), (Text -> Integer), WebLoop, List Integer -> [Network.Read, Network.Write] WebLoop
  web-handle-http (route) (obs) (ls) (raw-bytes) =
    let req = http-parse-request raw-bytes
    in if req.valid == False then act
      ts2 <- web-send-http (ls.transport) (http-error "Bad request")
      WebLoop { server = ls.server, transport = ts2 }
    end
    else let ns = WebState { request-count = (ls.server).request-count + 1 }
    in let response = web-dispatch route obs ns req
    in act
      ts2 <- web-send-http (ls.transport) response
      WebLoop { server = ns, transport = ts2 }
    end

  web-loop-http : (HttpRequest -> HttpResponse), (Text -> Integer), WebLoop -> [Console, Network.Read, Network.Write] Integer
  web-loop-http (route) (obs) (ls) = act
    recv <- net-io-recv-raw (ls.transport) 0
    if recv.has-data then act
      next <- web-handle-http route obs ls (recv.data)
      web-loop-http route obs next
    end
    else act
      0
    end
  end

  web-serve : (HttpRequest -> HttpResponse), (Text -> Integer) -> [Console, Network.Read, Network.Write] Integer
  web-serve (route) (obs) =
    let sess = net-session-new local-mac local-ip gateway-ip 49152 9200 host-ip 1000
    in let ts = transport-new sess
    in act
      ts1 <- net-io-connect ts
      web-loop-http route obs (WebLoop { server = web-new, transport = ts1 })
    end

Section: Concurrent Event Loop

 A client that reads its response and never closes is reaped after
 `web-idle-max` sweeps, one per `web-sweep-interval` empty polls. A
 connection's count resets only on its own frames, so an idle connection ages
 out while its neighbours are busy: the slowloris bound.

  nat-gw-mac : List Integer = [82, 85, 10, 0, 2, 2]

  WebConn = record { transport : TcpTransportState, server : WebState, pending : List Integer, idle : Integer }

 ONE RECEIVE BUFFER SERVES THE WHOLE MUX, the listen transport's, minted by
 the caller before the loop takes its compaction mark. A buffer minted inside
 the loop lies above that mark and `web-mux-compact` restores the heap past it
 while connections still point at it (`codex/test/web-mux-dangle`). Sharing is
 sound because the loop sends one response at a time, and the buffer is
 written only by the send's drain (`transport-feed-range`), which
 `web-mux-settle` empties into the connection's `pending` after every send.

  WebMux = record {
    listen : TcpTransportState,
    conns : List WebConn,
    served : Integer
  }

  frame-tcp : List Integer -> Boolean
  frame-tcp (frame) = frame-tcp-within frame (list-length frame)

  frame-tcp-within : List Integer, Integer -> Boolean
  frame-tcp-within (frame) (stop) =
    if eth-ethertype-within frame stop /= eth-type-ipv4 then False
    else if stop < eth-header-size + ip-header-size then False
    else ip-proto-at frame eth-header-size == ip-proto-tcp

  frame-seg : List Integer -> TcpSegment
  frame-seg (frame) = frame-seg-within frame (list-length frame)

  frame-seg-within : List Integer, Integer -> TcpSegment
  frame-seg-within (frame) (stop) =
    let ip-stop = eth-header-size + ip-total-length-at frame eth-header-size
    in tcp-parse-at frame (eth-header-size + ip-header-size) (if ip-stop > stop then stop else ip-stop)

 64 KiB: one request's headers. The default cap is 32 MiB, the whole of
 a spawned process's slot.

  serve-recv-buf-cap : Integer = 65536

  fresh-listen-transport : Integer -> TcpTransportState
  fresh-listen-transport (port) =
    let sess = net-session-new local-mac local-ip gateway-ip port 0 gateway-ip 1000
    in let sess2 = set-arp sess (arp-cache-add (sess.arp) gateway-ip nat-gw-mac)
    in transport-new-with-cap sess2 serve-recv-buf-cap

  web-mux-next-listen : WebMux, Integer -> TcpTransportState
  web-mux-next-listen (m) (port) =
    let sess = net-session-new local-mac local-ip gateway-ip port 0 gateway-ip 1000
    in let sess2 = set-arp sess (arp-cache-add (sess.arp) gateway-ip nat-gw-mac)
    in TcpTransportState { session = sess2, recv-base = (m.listen).recv-base, recv-len = 0, recv-cap = (m.listen).recv-cap, messages-sent = 0, messages-received = 0, arena-base = 0, gen = 0 }

 The mux must fit the 131,072-byte arena `web-mux-compact` copies it into, or
 compaction stops and the loop's garbage grows without bound. Its copy costs
 712 bytes plus 736 per connection (measured 2026-09-25, n = 16 and 64), so
 64 connections take 47,816 bytes and leave the rest for unparsed `pending`
 bytes, which the copy holds at 8 bytes each. A SYN beyond the cap is not
 answered, and the client retries it.

  web-mux-max-conns : Integer = 64

 Unparsed request bytes, summed over every connection, that the same arena
 holds beside 64 connections: the copy costs 8 bytes a byte (measured
 2026-09-25), so 8,192 bytes take 65,536 and leave 17,720 of the 131,072
 spare. A connection whose partial request would take the total past it is
 answered 413 and closed.

  web-mux-pending-budget : Integer = 8192

  web-mux-too-large : HttpResponse
  web-mux-too-large = HttpResponse { status = "413 Content Too Large", content-type = "text/plain", body = "Request too large" }

  web-mux-pending-held : WebMux, Integer, Integer, Integer -> Integer
  web-mux-pending-held (m) (idx) (i) (acc) =
    if i >= list-length (m.conns) then acc
    else if i == idx then web-mux-pending-held m idx (i + 1) acc
    else web-mux-pending-held m idx (i + 1) (acc + list-length ((list-at (m.conns) i).pending))

  web-mux-fed : TcpTransportState -> List Integer
  web-mux-fed (ts) = if ts.recv-len <= 0 then [] else __buf-read-bytes (ts.recv-base) 0 (ts.recv-len)

 The send's drain takes an arena set when the retransmit queue fills; handing
 it back after every send keeps one set in use at a time, the one
 `web-mux-run` minted below its mark.

  web-mux-settle : TcpTransportState -> TcpTransportState
  web-mux-settle (ts) = transport-drop-recv (transport-release ts)

  web-mux-owner : List WebConn, TcpSegment, Integer -> Integer
  web-mux-owner (conns) (seg) (i) =
    if i >= list-length conns then -1
    else let c = list-at conns i
    in if net-session-owns-segment ((c.transport).session) seg then i
    else web-mux-owner conns seg (i + 1)

  cl-pattern : List Integer = [99, 111, 110, 116, 101, 110, 116, 45, 108, 101, 110, 103, 116, 104, 58]

  wb-lower : Integer -> Integer
  wb-lower (b) = if b >= 65 then (if b <= 90 then b + 32 else b) else b

  wb-match-ci : List Integer, Integer, List Integer, Integer, Integer -> Boolean
  wb-match-ci (bs) (at) (pat) (j) (plen) =
    if j >= plen then True
    else if wb-lower (list-at bs (at + j)) == list-at pat j then wb-match-ci bs at pat (j + 1) plen
    else False

  wb-find-ci : List Integer, Integer, List Integer, Integer, Integer -> Integer
  wb-find-ci (bs) (len) (pat) (plen) (i) =
    if i + plen > len then -1
    else if wb-match-ci bs i pat 0 plen then i
    else wb-find-ci bs len pat plen (i + 1)

  wb-skip-spaces : List Integer, Integer, Integer -> Integer
  wb-skip-spaces (bs) (i) (len) =
    if i >= len then i
    else if list-at bs i == 32 then wb-skip-spaces bs (i + 1) len
    else i

  wb-parse-num : List Integer, Integer, Integer, Integer -> Integer
  wb-parse-num (bs) (i) (len) (acc) =
    if i >= len then acc
    else let b = list-at bs i
    in if b >= 48 then (if b <= 57 then wb-parse-num bs (i + 1) len (acc * 10 + (b - 48)) else acc) else acc

  wb-headers-end : List Integer, Integer, Integer -> Integer
  wb-headers-end (bs) (i) (len) =
    if i + 4 > len then -1
    else if list-at bs i == 13 then
      if list-at bs (i + 1) == 10 then
        if list-at bs (i + 2) == 13 then
          if list-at bs (i + 3) == 10 then i + 4
          else wb-headers-end bs (i + 1) len
        else wb-headers-end bs (i + 1) len
      else wb-headers-end bs (i + 1) len
    else wb-headers-end bs (i + 1) len

  wb-content-length : List Integer, Integer -> Integer
  wb-content-length (bs) (hdr-end) =
    let h = wb-find-ci bs hdr-end cl-pattern (list-length cl-pattern) 0
    in if h < 0 then 0
    else wb-parse-num bs (wb-skip-spaces bs (h + list-length cl-pattern) hdr-end) hdr-end 0

  wb-request-total : List Integer, Integer -> Integer
  wb-request-total (bs) (len) =
    let hdr-end = wb-headers-end bs 0 len
    in if hdr-end < 0 then -1
    else let total = hdr-end + wb-content-length bs hdr-end
    in if len >= total then total else -1

  wb-slice : List Integer, Integer, Integer, List Integer -> List Integer
  wb-slice (bs) (i) (stop) (acc) =
    if i >= stop then acc
    else wb-slice bs (i + 1) stop (list-push acc (list-at bs i))

  web-conn-closing : TcpTransportState -> Boolean
  web-conn-closing (ts) = when ((ts.session).conn.state)
    is TcpCloseWait -> True
    is TcpLastAck -> True
    is TcpClosed -> True
    is TcpTimeWait -> True
    is otherwise -> False

  web-mux-remove : List WebConn, Integer, Integer, List WebConn -> List WebConn
  web-mux-remove (conns) (idx) (i) (acc) =
    if i >= list-length conns then acc
    else if i == idx then web-mux-remove conns idx (i + 1) acc
    else web-mux-remove conns idx (i + 1) (list-push acc (list-at conns i))

  web-idle-max : Integer = 5
  web-sweep-interval : Integer = 1000000

 An empty poll reads a NIC register, and under codex-vm every register read
 is a VM exit. After `web-idle-polls` empty polls in a row the loop stops
 polling and waits for the tick (`get-ticks`, one memory load; 10 ms under
 codex-vm, 3,059 ticks in 31 s) to advance, yielding meanwhile, so an idle
 server reads the NIC about once a tick. A frame that arrives during the
 wait is answered at the next poll, at most one tick late.

 `web-idle-credit` is what one wait counts toward the sweep and the round
 bound, which are counted in polls, so that both keep their wall-clock
 cadence. Measured 2026-09-24, `-smp 2`, idle: the polling loop took
 13,946,936 port exits in 60 s at about 4.4 exits a poll, about 53,000
 polls a second, which is about 530 polls a tick, rounded to 512. The fuel
 bounds a clock that never advances (codex-vm `-rtc`).

  web-idle-polls : Integer = 4096
  web-idle-credit : Integer = 512
  web-idle-fuel : Integer = 5000000

  web-idle-wait : Integer -> Integer
  web-idle-wait (empties) =
    if empties < web-idle-polls then 0
    else let w = web-tick-wait get-ticks web-idle-fuel
    in web-idle-credit

  web-tick-wait : Integer, Integer -> Integer
  web-tick-wait (t0) (fuel) =
    if fuel <= 0 then 0
    else if get-ticks /= t0 then 1
    else let y = process-yield
    in web-tick-wait t0 (fuel - 1)

  web-mux-sweep : WebMux, Integer -> [Network.Read, Network.Write] WebMux
  web-mux-sweep (m) (i) =
    if i >= list-length (m.conns) then m
    else let c = list-at (m.conns) i
    in act
      t1 <- flush-transport-outbox (transport-tick (c.transport))
      if web-conn-closing t1 then act
        t2 <- flush-transport-outbox (transport-close t1)
        web-mux-sweep (WebMux { listen = m.listen, conns = web-mux-remove (m.conns) i 0 [], served = m.served }) i
      end
      else if c.idle + 1 >= web-idle-max then act
        reaped <- flush-transport-outbox (transport-close t1)
        web-mux-sweep (WebMux { listen = m.listen, conns = web-mux-remove (m.conns) i 0 [], served = m.served }) i
      end
      else web-mux-sweep (WebMux { listen = m.listen, conns = list-set-at (m.conns) i (WebConn { transport = t1, server = c.server, pending = c.pending, idle = c.idle + 1 }), served = m.served }) (i + 1)
    end

  web-mux-serve-conn : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, Integer, List Integer, Integer -> [Network.Read, Network.Write] WebMux
  web-mux-serve-conn (route) (obs) (m) (idx) (frame) (stop) =
    let c = list-at (m.conns) idx
    in let r = net-process-frame-within ((c.transport).session) frame stop
    in let ts1 = transport-set-session (c.transport) (r.session)
    in act
      ts2 <- flush-transport-outbox ts1
      if web-conn-closing ts2 then act
        ts3 <- flush-transport-outbox (transport-close ts2)
        WebMux { listen = m.listen, conns = web-mux-remove (m.conns) idx 0 [], served = m.served }
      end
      else web-mux-drain route obs m idx ts2 (c.server) ((c.pending) & (transport-slice (r.data) (r.data-off) (r.data-stop)))
    end

  web-mux-refuse : WebMux, Integer, TcpTransportState -> [Network.Read, Network.Write] WebMux
  web-mux-refuse (m) (idx) (ts) = act
    ts2 <- web-send-http ts web-mux-too-large
    ts3 <- flush-transport-outbox (transport-close (web-mux-settle ts2))
    WebMux { listen = m.listen, conns = web-mux-remove (m.conns) idx 0 [], served = m.served }
  end

  web-mux-drain : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, Integer, TcpTransportState, WebState, List Integer -> [Network.Read, Network.Write] WebMux
  web-mux-drain (route) (obs) (m) (idx) (ts) (srv) (pending) =
    let plen = list-length pending
    in let total = wb-request-total pending plen
    in if total < 0 then
      if web-mux-pending-held m idx 0 plen > web-mux-pending-budget then web-mux-refuse m idx ts
      else WebMux { listen = m.listen, conns = list-set-at (m.conns) idx (WebConn { transport = ts, server = srv, pending = pending, idle = 0 }), served = m.served }
    else let req = http-parse-request (wb-slice pending 0 total [])
    in let ns = WebState { request-count = srv.request-count + 1 }
    in let resp = web-dispatch route obs ns req
    in act
      ts2 <- web-send-http ts resp
      web-mux-drain route obs (WebMux { listen = m.listen, conns = m.conns, served = m.served + 1 }) idx (web-mux-settle ts2) ns ((wb-slice pending total plen []) & web-mux-fed ts2)
    end

  web-mux-accept : WebMux, List Integer, Integer, Integer -> [Network.Read, Network.Write] WebMux
  web-mux-accept (m) (frame) (stop) (port) =
    let r = net-process-frame-within ((m.listen).session) frame stop
    in let listen1 = transport-set-session (m.listen) (r.session)
    in act
      listen2 <- flush-transport-outbox listen1
      WebMux { listen = net-io-listen (web-mux-next-listen m port), conns = list-push (m.conns) (WebConn { transport = listen2, server = web-new, pending = [], idle = 0 }), served = m.served }
    end

  web-mux-feed : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, List Integer, Integer -> [Network.Read, Network.Write] WebMux
  web-mux-feed (route) (obs) (m) (frame) (port) = web-mux-feed-within route obs m frame (list-length frame) port

  web-mux-feed-within : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, List Integer, Integer, Integer -> [Network.Read, Network.Write] WebMux
  web-mux-feed-within (route) (obs) (m) (frame) (stop) (port) =
    if frame-tcp-within frame stop == False then m
    else let seg = frame-seg-within frame stop
    in let owner = web-mux-owner (m.conns) seg 0
    in if owner >= 0 then web-mux-serve-conn route obs m owner frame stop
    else if (seg.dst-port == port) then
      if tcp-has-flag seg tcp-flag-syn then (if list-length (m.conns) >= web-mux-max-conns then m else web-mux-accept m frame stop port)
      else m
    else m

  nc-webconns : List WebConn, Integer, Integer, List WebConn -> List WebConn
  nc-webconns (cs) (i) (n) (acc) =
    if i >= n then acc
    else let c = list-at cs i
    in nc-webconns cs (i + 1) n (list-push acc (WebConn { transport = nc-transport (c.transport), server = WebState { request-count = (c.server).request-count }, pending = nc-ints (c.pending), idle = c.idle }))

  nc-webmux : WebMux -> WebMux
  nc-webmux (m) = WebMux {
    listen = nc-transport (m.listen),
    conns = nc-webconns (m.conns) 0 (list-length (m.conns)) (__list-with-capacity (list-length (m.conns))),
    served = m.served
  }

  web-mux-compact : WebMux, Integer, Integer -> WebMux
  web-mux-compact (m) (set) (mark) =
    if __heap-save - mark <= net-compact-bytes then m
    else let h0 = __heap-save
    in let probe = nc-webmux m
    in let size = __heap-save - h0
    in if size > net-arena-bytes then let dropped = __heap-restore h0 in m
    else let target = nc-set-target set
    in let into = __heap-restore (nc-arena-at set target)
    in let copy = nc-webmux m
    in let back = __heap-restore mark
    in let committed = nc-set-commit set target
    in copy

  web-mux-loop : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, Integer, Integer, Integer, List Integer -> [Console, Network.Read, Network.Write] Integer
  web-mux-loop (route) (obs) (m) (port) (tries) (since) (rx) = web-mux-run route obs m port tries since rx 0 0

  web-mux-run : (HttpRequest -> HttpResponse), (Text -> Integer), WebMux, Integer, Integer, Integer, List Integer, Integer, Integer -> [Console, Network.Read, Network.Write] Integer
  web-mux-run (route) (obs) (m) (port) (tries) (since) (rx) (set) (mark) =
    if list-length rx == 0 then let s = nc-set-acquire (nc-pool-cell process-get-pid)
      in let send-set = nc-set-release (nc-set-acquire (nc-pool-cell process-get-pid))
      in let rx1 = net-io-rx rx
      in let mk = __heap-save
      in web-mux-run route obs m port tries since rx1 s mk
    else if tries > 50000000 then let served = m.served
      in let released = nc-set-release set
      in served
    else if since >= web-sweep-interval then act
      m1 <- web-mux-sweep m 0
      web-mux-run route obs (web-mux-compact m1 set mark) port (tries + 1) 0 rx set mark
    end
    else let hp = __heap-save
    in act
      n <- net-driver-recv-into rx
      if n == 0 then let restored = __heap-restore hp
        in let y = process-yield
        in let w = web-idle-wait tries
        in web-mux-run route obs m port (tries + 1 + w) (since + 1 + w) rx set mark
      else act
        m1 <- web-mux-feed-within route obs m rx n port
        web-mux-run route obs (web-mux-compact m1 set mark) port 0 (since + 1) rx set mark
      end
    end

  web-serve-concurrent : (HttpRequest -> HttpResponse), (Text -> Integer), Integer -> [Console, Network.Read, Network.Write] Integer
  web-serve-concurrent (route) (obs) (port) =
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport port), conns = [], served = 0 }
    in web-mux-loop route obs m0 port 0 0 []

Section: Legacy Framed Serve (for backward compat)

  web-serve-framed : (Text -> Text) -> [Console, Network.Read, Network.Write] Integer
  web-serve-framed (route) =
    let sess = net-session-new local-mac local-ip gateway-ip 49152 9100 host-ip 1000
    in let ts = transport-new sess
    in act
      ts1 <- net-io-connect ts
      web-loop-framed route (WebLoop { server = web-new, transport = ts1 })
    end

  web-loop-framed : (Text -> Text), WebLoop -> [Console, Network.Read, Network.Write] Integer
  web-loop-framed (route) (ls) = act
    recv <- net-io-recv-loop (ls.transport) 0
    if recv.has-message then act
      let request-text = bytes-to-text (recv.body) 0 (list-length (recv.body)) ""
      in let ns = WebState { request-count = (ls.server).request-count + 1 }
      in let path = extract-web-path request-text
      in let response = route path
      in act
        ts2 <- web-send (ls.transport) response
        web-loop-framed route (WebLoop { server = ns, transport = ts2 })
      end
    end
    else act
      0
    end
  end

  web-send : TcpTransportState, Text -> [Network.Read, Network.Write] TcpTransportState
  web-send (ts) (response) =
    let body = "200 application/json " & response
    in let body-bytes = ws-text-to-bytes body 0 (text-length body) []
    in act
      r <- net-io-send-checked ts 1 body-bytes
      if r.ns-complete then r.ns-transport
      else net-io-close (r.ns-transport)
    end

  extract-web-path : Text -> Text
  extract-web-path (line) =
    let parts = text-split line " "
    in if list-length parts < 2 then "/"
    else list-at parts 1

Page 1
