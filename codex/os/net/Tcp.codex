Chapter: Tcp
  cites Net chapter Ethernet

 We say:

Section: Constants
  tcp-header-size : Integer = 20
  tcp-flag-fin : Integer = 1
  tcp-flag-syn : Integer = 2
  tcp-flag-rst : Integer = 4
  tcp-flag-psh : Integer = 8
  tcp-flag-ack : Integer = 16

Section: TCP States
  TcpState =
    | TcpClosed
    | TcpListening
    | TcpSynSent
    | TcpSynReceived
    | TcpEstablished
    | TcpFinWait1
    | TcpFinWait2
    | TcpCloseWait
    | TcpLastAck
    | TcpTimeWait

  tcp-state-name : TcpState -> Text
  tcp-state-name (s) = when s
    is TcpClosed -> "CLOSED"
    is TcpListening -> "LISTENING"
    is TcpSynSent -> "SYN_SENT"
    is TcpSynReceived -> "SYN_RECEIVED"
    is TcpEstablished -> "ESTABLISHED"
    is TcpFinWait1 -> "FIN_WAIT_1"
    is TcpFinWait2 -> "FIN_WAIT_2"
    is TcpCloseWait -> "CLOSE_WAIT"
    is TcpLastAck -> "LAST_ACK"
    is TcpTimeWait -> "TIME_WAIT"

Section: TCP Segment
 THE PAYLOAD IS A RANGE INTO A BUFFER AND NOT A LIST OF ITS OWN, so parsing a
 segment out of a frame copies nothing: the field was 16,432 bytes on a
 1,514-byte frame (`net-recv-heap`). The range REPLACES the list rather than
 sitting beside it, because two representations of the same bytes are an
 invariant nothing enforces and they drift.

 `tcp-segment-of` is how a caller with a payload list builds one, and it is
 what every hand-written segment uses; the buffer is then the list itself and
 the range spans the whole of it.

  TcpSegment = record {
    src-port : Integer between 0 and 65535,
    dst-port : Integer between 0 and 65535,
    seq-num : Integer,
    ack-num : Integer,
    flags : Integer between 0 and 255,
    window : Integer between 0 and 65535,
    payload-buf : List Integer,
    payload-off : Integer,
    payload-stop : Integer
  }

  tcp-segment-of : Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> TcpSegment
  tcp-segment-of (src-port) (dst-port) (seq) (ack) (flags) (window) (payload) =
    TcpSegment {
      src-port = __narrow src-port, dst-port = __narrow dst-port,
      seq-num = seq, ack-num = ack, flags = __narrow flags, window = __narrow window,
      payload-buf = payload, payload-off = 0, payload-stop = list-length payload
    }

  tcp-seg-payload-len : TcpSegment -> Integer
  tcp-seg-payload-len (seg) = seg.payload-stop - seg.payload-off

  tcp-seg-payload : TcpSegment -> List Integer
  tcp-seg-payload (seg) = tcp-extract-payload (seg.payload-buf) (seg.payload-off) (seg.payload-stop)

  tcp-has-flag : TcpSegment, Integer -> Boolean
  tcp-has-flag (seg) (flag) = bit-and (seg.flags) flag > 0

Section: Segment Construction
  tcp-build-segment : Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  tcp-build-segment (src-port) (dst-port) (seq) (ack) (flags) (window) (payload) =
    let data-off = 5
    in let off-flags = bit-or (bit-shl data-off 12) flags
    in (write-be16 src-port & write-be16 dst-port & write-be32 seq & write-be32 ack & write-be16 off-flags & write-be16 window & [0, 0, 0, 0] & payload)

  write-be32 : Integer -> List Integer
  write-be32 (v) = [bit-and (bit-shru v 24) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 8) 255, bit-and v 255]

  read-be32 : List Integer, Integer -> Integer
  read-be32 (buf) (off) =
    if off + 4 > list-length buf then 0
    else let b0 = bit-shl (list-at buf off) 24
    in let b1 = bit-shl (list-at buf (off + 1)) 16
    in let b2 = bit-shl (list-at buf (off + 2)) 8
    in let b3 = list-at buf (off + 3)
    in bit-or b0 (bit-or b1 (bit-or b2 b3))

Section: Segment Parsing
 THE OFFSET FORM IS THE IMPLEMENTATION AND THE BARE NAME IS A WRAPPER, so a
 caller holding the driver's whole flat frame parses the segment where it sits
 rather than copying it out first: that copy is 16,400 bytes on a 1,514-byte
 frame (`net-recv-heap`). Nothing is copied here at all now: the segment's
 payload is the range `off + hdr-len` to `stop` into the caller's own buffer.

  tcp-parse-at : List Integer, Integer, Integer -> TcpSegment
  tcp-parse-at (buf) (off) (stop) =
    if stop - off < 20 then TcpSegment {
      src-port = 0, dst-port = 0, seq-num = 0, ack-num = 0,
      flags = 0, window = 0, payload-buf = [], payload-off = 0, payload-stop = 0
    }
    else let off-flags = read-be16 buf (off + 12)
    in let data-off = bit-and (bit-shru off-flags 12) 15
    in let hdr-len = data-off * 4
    in TcpSegment {
      src-port = __narrow (read-be16 buf off),
      dst-port = __narrow (read-be16 buf (off + 2)),
      seq-num = read-be32 buf (off + 4),
      ack-num = read-be32 buf (off + 8),
      flags = __narrow (bit-and off-flags 63),
      window = __narrow (read-be16 buf (off + 14)),
      payload-buf = buf,
      payload-off = off + hdr-len,
      payload-stop = stop
    }

  tcp-parse : List Integer -> TcpSegment
  tcp-parse (data) = tcp-parse-at data 0 (list-length data)

  tcp-extract-payload : List Integer, Integer, Integer -> List Integer
  tcp-extract-payload (data) (off) (len) =
    if off >= len then []
    else eth-payload-loop data off len []

Section: Sequence Arithmetic

 RFC 793 section 3.3: the sequence space is circular, 32 bits wide, and
 comparisons in it are the SIGN OF THE WRAPPED DIFFERENCE rather than the
 order of the two magnitudes. An ordinary compare is right only while
 neither operand has crossed 2^32, which on a link doing real work is a
 property with an expiry date rather than an invariant.

 Both halves are needed and neither is sufficient. A wrapped counter
 compared with an ordinary operator is wrong the moment the two operands
 sit on opposite sides of the seam; an unwrapped counter compared with
 serial arithmetic is wrong because the local value never re-enters the
 32-bit space the peer answers in. What arrives from the wire is always
 truncated, because `read-be32` reads four bytes.

  tcp-seq-space : Integer = 4294967296
  tcp-seq-half : Integer = 2147483648

  tcp-seq-wrap : Integer -> Integer
  tcp-seq-wrap (n) = bit-and n #FFFFFFFF

  tcp-seq-diff : Integer, Integer -> Integer
  tcp-seq-diff (a) (b) =
    let d = bit-and (a - b) #FFFFFFFF
    in if d >= tcp-seq-half then d - tcp-seq-space else d

  tcp-seq-lt : Integer, Integer -> Boolean
  tcp-seq-lt (a) (b) = tcp-seq-diff a b < 0

  tcp-seq-le : Integer, Integer -> Boolean
  tcp-seq-le (a) (b) = tcp-seq-diff a b <= 0

  tcp-seq-ge : Integer, Integer -> Boolean
  tcp-seq-ge (a) (b) = tcp-seq-diff a b >= 0

Section: Connection Record
  TcpConnection = record {
    state : TcpState,
    local-port : Integer between 0 and 65535,
    remote-port : Integer between 0 and 65535,
    local-ip : List Integer,
    remote-ip : List Integer,
    send-next : Integer,
    recv-next : Integer,
    send-window : Integer between 0 and 65535
  }

 RFC 793 section 3.2: a passive OPEN creates a socket bound to a local
 address with no foreign socket specified. It is not a transition out of a
 connection that once had a peer, and the difference is load-bearing here:
 a server closing from ESTABLISHED is in FIN_WAIT_1, and there is no
 transition from FIN_WAIT_1 to LISTEN in the state diagram, nor should there
 be. The listener below is CONSTRUCTED from the binding instead.

 send-next carries forward rather than restarting, because the peer of the
 connection just abandoned may still have segments in flight and RFC 793
 section 3.3 wants the sequence space advanced past them. recv-next resets
 because the next caller is a different peer and its sequence numbers are
 its own.

  tcp-fresh-listener : TcpConnection -> TcpConnection
  tcp-fresh-listener (c) =
    TcpConnection {
      state = TcpListening,
      local-port = c.local-port,
      remote-port = 0,
      local-ip = c.local-ip,
      remote-ip = c.remote-ip,
      send-next = c.send-next,
      recv-next = 0,
      send-window = c.send-window
    }

  tcp-new-connection : Integer, List Integer, Integer, List Integer, Integer -> TcpConnection
  tcp-new-connection (local-port) (local-ip) (remote-port) (remote-ip) (initial-seq) =
    TcpConnection {
      state = TcpClosed,
      local-port = __narrow local-port,
      remote-port = __narrow remote-port,
      local-ip = local-ip,
      remote-ip = remote-ip,
      send-next = tcp-seq-wrap initial-seq,
      recv-next = 0,
      send-window = 8192
    }

Section: State Machine Events
  TcpEvent =
    | EvConnect
    | EvSegment (TcpSegment)
    | EvSend (List Integer)
    | EvClose

  TcpAction =
    | ActSend (List Integer)
    | ActEstablished
    | ActData (List Integer) (Integer) (Integer)
    | ActDataAck (List Integer) (Integer) (Integer) (List Integer)
    | ActClosed
    | ActError (Text)
    | ActNone

  TcpStep = record {
    conn : TcpConnection,
    action : TcpAction
  }

Section: State Transitions
  tcp-step : TcpConnection, TcpEvent -> TcpStep
  tcp-step (conn) (ev) = when (conn.state)
    is TcpClosed -> tcp-step-closed conn ev
    is TcpListening -> tcp-step-listening conn ev
    is TcpSynSent -> tcp-step-syn-sent conn ev
    is TcpSynReceived -> tcp-step-syn-received conn ev
    is TcpEstablished -> tcp-step-established conn ev
    is TcpFinWait1 -> tcp-step-fin-wait1 conn ev
    is TcpFinWait2 -> tcp-step-fin-wait2 conn ev
    is TcpCloseWait -> tcp-step-close-wait conn ev
    is TcpLastAck -> tcp-step-last-ack conn ev
    is TcpTimeWait -> TcpStep { conn = conn, action = ActNone }

  tcp-set-state : TcpConnection, TcpState -> TcpConnection
  tcp-set-state (c) (s) = TcpConnection { state = s, local-port = c.local-port, remote-port = c.remote-port, local-ip = c.local-ip, remote-ip = c.remote-ip, send-next = c.send-next, recv-next = c.recv-next, send-window = c.send-window }

  set-send-next : TcpConnection, Integer -> TcpConnection
  set-send-next (c) (n) = TcpConnection { state = c.state, local-port = c.local-port, remote-port = c.remote-port, local-ip = c.local-ip, remote-ip = c.remote-ip, send-next = tcp-seq-wrap n, recv-next = c.recv-next, send-window = c.send-window }

  set-recv-next : TcpConnection, Integer -> TcpConnection
  set-recv-next (c) (n) = TcpConnection { state = c.state, local-port = c.local-port, remote-port = c.remote-port, local-ip = c.local-ip, remote-ip = c.remote-ip, send-next = c.send-next, recv-next = tcp-seq-wrap n, send-window = c.send-window }

  set-remote : TcpConnection, Integer, List Integer -> TcpConnection
  set-remote (c) (rp) (rip) = TcpConnection { state = c.state, local-port = c.local-port, remote-port = __narrow rp, local-ip = c.local-ip, remote-ip = rip, send-next = c.send-next, recv-next = c.recv-next, send-window = c.send-window }

Section: CLOSED State

 A CONNECTION ENTERING LISTENING FORGETS ITS PEER, and until 2026-07-20 it
 did not. `tcp-set-state` carries every field forward, `remote-port`
 included, so a listener that had once been claimed still named that peer
 after it closed and re-listened. Nothing read the field in that state, so
 the staleness was invisible -- until `net-session-owns-segment` began
 demultiplexing on it, and then a server that served one caller dropped
 every caller after: the fresh SYN came from a different source port, the
 gate read it as another connection's traffic, and the server waited
 forever for a request that was on the wire.

  tcp-step-closed : TcpConnection, TcpEvent -> TcpStep
  tcp-step-closed (conn) (ev) = when ev
    is EvConnect ->
      let syn = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) 0 tcp-flag-syn (conn.send-window) []
      in let c1 = tcp-set-state (set-send-next conn (conn.send-next + 1)) TcpSynSent
      in TcpStep { conn = c1, action = ActSend syn }
    is EvSegment (seg) -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "not connected" }
    is EvClose -> TcpStep { conn = conn, action = ActNone }

Section: LISTENING State
  tcp-step-listening : TcpConnection, TcpEvent -> TcpStep
  tcp-step-listening (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-syn then
        let c0 = set-remote conn (seg.src-port) (conn.remote-ip)
        in let c1 = set-recv-next (set-send-next c0 (c0.send-next + 1)) (seg.seq-num + 1)
        in let synack = tcp-build-segment (c0.local-port) (seg.src-port) (c0.send-next) (seg.seq-num + 1) (bit-or tcp-flag-syn tcp-flag-ack) (c0.send-window) []
        in TcpStep { conn = tcp-set-state c1 TcpSynReceived, action = ActSend synack }
      else TcpStep { conn = conn, action = ActNone }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "not connected" }
    is EvClose -> TcpStep { conn = tcp-set-state conn TcpClosed, action = ActClosed }

Section: SYN_SENT State
  tcp-step-syn-sent : TcpConnection, TcpEvent -> TcpStep
  tcp-step-syn-sent (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-syn & tcp-has-flag seg tcp-flag-ack then
        let c1 = set-recv-next (tcp-set-state conn TcpEstablished) (seg.seq-num + 1)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (seg.seq-num + 1) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActSend ack }
      else if tcp-has-flag seg tcp-flag-rst then TcpStep { conn = tcp-set-state conn TcpClosed, action = ActError "connection refused" }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose -> TcpStep { conn = tcp-set-state conn TcpClosed, action = ActClosed }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "not established" }

Section: SYN_RECEIVED State
  tcp-step-syn-received : TcpConnection, TcpEvent -> TcpStep
  tcp-step-syn-received (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-ack then
        if tcp-seg-payload-len seg > 0 then
          let c1 = set-recv-next (tcp-set-state conn TcpEstablished) (seg.seq-num + tcp-seg-payload-len seg)
          in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (c1.recv-next) tcp-flag-ack (conn.send-window) []
          in TcpStep { conn = c1, action = ActDataAck (seg.payload-buf) (seg.payload-off) (seg.payload-stop) ack }
        else TcpStep { conn = tcp-set-state conn TcpEstablished, action = ActEstablished }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose -> TcpStep { conn = tcp-set-state conn TcpClosed, action = ActClosed }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "not established" }

Section: ESTABLISHED State
  tcp-step-established : TcpConnection, TcpEvent -> TcpStep
  tcp-step-established (conn) (ev) = when ev
    is EvSend (data) ->
      let seg = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (conn.recv-next) (bit-or tcp-flag-ack tcp-flag-psh) (conn.send-window) data
      in let c1 = set-send-next conn (conn.send-next + list-length data)
      in TcpStep { conn = c1, action = ActSend seg }
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-fin then
        let c1 = set-recv-next (tcp-set-state conn TcpCloseWait) (seg.seq-num + 1)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (seg.seq-num + 1) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActSend ack }
      else if tcp-seg-payload-len seg > 0 then
        let c1 = set-recv-next conn (seg.seq-num + tcp-seg-payload-len seg)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (c1.recv-next) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActDataAck (seg.payload-buf) (seg.payload-off) (seg.payload-stop) ack }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose ->
      let fin = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (conn.recv-next) (bit-or tcp-flag-fin tcp-flag-ack) (conn.send-window) []
      in let c1 = tcp-set-state (set-send-next conn (conn.send-next + 1)) TcpFinWait1
      in TcpStep { conn = c1, action = ActSend fin }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }

Section: FIN_WAIT_1 State
  tcp-step-fin-wait1 : TcpConnection, TcpEvent -> TcpStep
  tcp-step-fin-wait1 (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-fin & tcp-has-flag seg tcp-flag-ack then
        let c1 = set-recv-next (tcp-set-state conn TcpTimeWait) (seg.seq-num + 1)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (seg.seq-num + 1) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActSend ack }
      else if tcp-has-flag seg tcp-flag-ack then TcpStep { conn = tcp-set-state conn TcpFinWait2, action = ActNone }
      else if tcp-has-flag seg tcp-flag-fin then
        let c1 = set-recv-next (tcp-set-state conn TcpTimeWait) (seg.seq-num + 1)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (seg.seq-num + 1) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActSend ack }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose -> TcpStep { conn = conn, action = ActNone }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "closing" }

Section: FIN_WAIT_2 State
  tcp-step-fin-wait2 : TcpConnection, TcpEvent -> TcpStep
  tcp-step-fin-wait2 (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-fin then
        let c1 = set-recv-next (tcp-set-state conn TcpTimeWait) (seg.seq-num + 1)
        in let ack = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (seg.seq-num + 1) tcp-flag-ack (conn.send-window) []
        in TcpStep { conn = c1, action = ActSend ack }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose -> TcpStep { conn = conn, action = ActNone }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "closing" }

Section: CLOSE_WAIT State
  tcp-step-close-wait : TcpConnection, TcpEvent -> TcpStep
  tcp-step-close-wait (conn) (ev) = when ev
    is EvClose ->
      let fin = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (conn.recv-next) (bit-or tcp-flag-fin tcp-flag-ack) (conn.send-window) []
      in let c1 = tcp-set-state (set-send-next conn (conn.send-next + 1)) TcpLastAck
      in TcpStep { conn = c1, action = ActSend fin }
    is EvSegment (seg) -> TcpStep { conn = conn, action = ActNone }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) ->
      let seg = tcp-build-segment (conn.local-port) (conn.remote-port) (conn.send-next) (conn.recv-next) (bit-or tcp-flag-ack tcp-flag-psh) (conn.send-window) data
      in let c1 = set-send-next conn (conn.send-next + list-length data)
      in TcpStep { conn = c1, action = ActSend seg }

Section: LAST_ACK State
  tcp-step-last-ack : TcpConnection, TcpEvent -> TcpStep
  tcp-step-last-ack (conn) (ev) = when ev
    is EvSegment (seg) ->
      if tcp-has-flag seg tcp-flag-ack then TcpStep { conn = tcp-set-state conn TcpClosed, action = ActClosed }
      else TcpStep { conn = conn, action = ActNone }
    is EvClose -> TcpStep { conn = conn, action = ActNone }
    is EvConnect -> TcpStep { conn = conn, action = ActNone }
    is EvSend (data) -> TcpStep { conn = conn, action = ActError "closing" }

