Section: DNS Records

  DnsRecord =
    | DnsA (List Integer)
    | DnsCname (Text)
    | DnsTxt (Text)

  DnsEntry = record {
    name : Text,
    dns-rec : DnsRecord,
    ttl : Integer between 0 and 4294967295,
    created : Integer
  }

  DnsCache = record {
    entries : HamtMap DnsEntry,
    count : Integer between 0 and 65535
  }

Section: Cache Operations

  dns-cache-empty : DnsCache
  dns-cache-empty = DnsCache { entries = hamt-empty, count = 0 }

  dns-cache-put : DnsCache, Text, DnsRecord, Integer, Integer -> DnsCache
  dns-cache-put (cache) (name) (rec) (ttl) (now) =
    let entry = DnsEntry { name = name, dns-rec = rec, ttl = __narrow ttl, created = now }
    in let had = hamt-contains (cache.entries) name
    in DnsCache {
      entries = hamt-set (cache.entries) name entry,
      count = if had then cache.count else cache.count + 1
    }

  dns-cache-lookup : DnsCache, Text, Integer -> Maybe DnsRecord
  dns-cache-lookup (cache) (name) (now) =
    let found = hamt-get (cache.entries) name
    in when found
      is None -> None
      is Just (entry) ->
        if now - entry.created > entry.ttl then None
        else Just (entry.dns-rec)

  dns-cache-remove : DnsCache, Text -> DnsCache
  dns-cache-remove (cache) (name) =
    if hamt-contains (cache.entries) name then
      DnsCache { entries = hamt-remove (cache.entries) name, count = cache.count - 1 }
    else cache

  dns-cache-count : DnsCache -> Integer
  dns-cache-count (cache) = cache.count

Section: Static Host Table

  HostEntry = record {
    hostname : Text,
    ip : List Integer
  }

  HostTable = record {
    hosts : List HostEntry,
    count : Integer between 0 and 255
  }

  host-table-empty : HostTable
  host-table-empty = HostTable { hosts = [], count = 0 }

  host-table-add : HostTable, Text, List Integer -> HostTable
  host-table-add (ht) (name) (ip) =
    let entry = HostEntry { hostname = name, ip = ip }
    in HostTable { hosts = list-push (ht.hosts) entry, count = ht.count + 1 }

  host-table-lookup : HostTable, Text -> Maybe (List Integer)
  host-table-lookup (ht) (name) = host-lookup-loop (ht.hosts) name 0 (ht.count)

  host-lookup-loop : List HostEntry, Text, Integer, Integer -> Maybe (List Integer)
  host-lookup-loop (hosts) (name) (i) (len) =
    if i >= len then None
    else let h = list-at hosts i
    in if h.hostname == name then Just (h.ip)
    else host-lookup-loop hosts name (i + 1) len

Section: Resolver

  DnsResolver = record {
    cache : DnsCache,
    hosts : HostTable
  }

  resolver-new : HostTable -> DnsResolver
  resolver-new (ht) = DnsResolver { cache = dns-cache-empty, hosts = ht }

  resolve : DnsResolver, Text, Integer -> Maybe (List Integer)
  resolve (r) (name) (now) =
    let host-result = host-table-lookup (r.hosts) name
    in when host-result
      is Just (ip) -> Just ip
      is None ->
        let cache-result = dns-cache-lookup (r.cache) name now
        in when cache-result
          is Just (rec) -> when rec
            is DnsA (ip) -> Just ip
            is otherwise -> None
          is None -> None

  resolver-cache-result : DnsResolver, Text, List Integer, Integer, Integer -> DnsResolver
  resolver-cache-result (r) (name) (ip) (ttl) (now) =
    let new-cache = dns-cache-put (r.cache) name (DnsA ip) ttl now
    in DnsResolver { cache = new-cache, hosts = r.hosts }

Section: Formatting

  format-dns-record : DnsRecord -> Text
  format-dns-record (rec) = when rec
    is DnsA (ip) -> format-ip ip
    is DnsCname (name) -> "CNAME " & name
    is DnsTxt (txt) -> "TXT " & txt

  format-ip : List Integer -> Text
  format-ip (ip) =
    if list-length ip < 4 then "?"
    else
      show (list-at ip 0) & "." & show (list-at ip 1) & "." & show (list-at ip 2) & "." & show (list-at ip 3)

Section: Wire Protocol Constants
  dns-port : Integer = 53
  dns-type-a : Integer = 1
  dns-type-cname : Integer = 5
  dns-type-txt : Integer = 16
  dns-class-in : Integer = 1
  dns-flags-query-rd : Integer = 256
  dns-header-size : Integer = 12

Section: Name Encoding
  dns-encode-name : Text -> List Integer
  dns-encode-name (name) =
    dns-encode-labels name 0 (text-length name) []

  dns-encode-labels : Text, Integer, Integer, List Integer -> List Integer
  dns-encode-labels (name) (start) (len) (acc) =
    if start >= len then acc & [0]
    else let dot-pos = dns-find-dot name start len
    in let label-len = dot-pos - start
    in let label-bytes = dns-extract-label name start dot-pos []
    in let next = if dot-pos < len then dot-pos + 1 else dot-pos
    in dns-encode-labels name next len (acc & [label-len] & label-bytes)

  dns-find-dot : Text, Integer, Integer -> Integer
  dns-find-dot (name) (i) (len) =
    if i >= len then len
    else if char-at name i == char-at "." 0 then i
    else dns-find-dot name (i + 1) len

  dns-extract-label : Text, Integer, Integer, List Integer -> List Integer
  dns-extract-label (name) (i) (stop) (acc) =
    if i >= stop then acc
    else
      dns-extract-label name (i + 1) stop (list-push acc (to-unicode (char-code (char-at name i))))

Section: Query Construction
  dns-build-query : Integer, Text, Integer -> List Integer
  dns-build-query (tx-id) (name) (qtype) =
    let header = write-be16 tx-id & write-be16 dns-flags-query-rd & write-be16 1 & write-be16 0 & write-be16 0 & write-be16 0
    in let qname = dns-encode-name name
    in let question = qname & write-be16 qtype & write-be16 dns-class-in
    in header & question

  dns-build-a-query : Integer, Text -> List Integer
  dns-build-a-query (tx-id) (name) = dns-build-query tx-id name dns-type-a

Section: Response Parsing
  DnsAnswer = record {
    owner : List Integer,
    rtype : Integer,
    rclass : Integer,
    ttl : Integer,
    rdata : List Integer,
    target : List Integer
  }

  DnsResponse = record {
    tx-id : Integer,
    flags : Integer,
    answer-count : Integer,
    answers : List DnsAnswer,
    valid : Boolean
  }

 ANSWER-COUNT IS WHAT WE PARSED, NOT WHAT THE WIRE CLAIMED. ancount is a
 16-bit field a peer chooses and dns-parse-answers stops at the end of the
 datagram, so every walker takes its bound from the parsed list, never from
 the header.

  dns-parse-response : List Integer -> DnsResponse
  dns-parse-response (data) =
    let dlen = list-length data
    in if dlen < dns-header-size then
      DnsResponse { tx-id = 0, flags = 0, answer-count = 0, answers = [], valid = False }
    else let tx-id = read-be16 data 0
    in let flags = read-be16 data 2
    in let qdcount = read-be16 data 4
    in let ancount = read-be16 data 6
    in let q-end = dns-skip-questions data dns-header-size qdcount
    in let answers = dns-parse-answers data q-end ancount []
    in DnsResponse {
      tx-id = tx-id,
      flags = flags,
      answer-count = list-length answers,
      answers = answers,
      valid = True
    }

  dns-skip-questions : List Integer, Integer, Integer -> Integer
  dns-skip-questions (data) (off) (count) =
    if count <= 0 then off
    else let name-end = dns-skip-name data off
    in dns-skip-questions data (name-end + 4) (count - 1)

  dns-skip-name : List Integer, Integer -> Integer
  dns-skip-name (data) (off) =
    if off >= list-length data then off
    else let b = list-at data off
    in if b == 0 then off + 1
    else if bit-and b 192 == 192 then off + 2
    else dns-skip-name data (off + 1 + b)

  dns-parse-answers : List Integer, Integer, Integer, List DnsAnswer -> List DnsAnswer
  dns-parse-answers (data) (off) (count) (acc) =
    if count <= 0 then acc
    else if off + 10 > list-length data then acc
    else let name-end = dns-skip-name data off
    in if name-end + 10 > list-length data then acc
    else let rtype = read-be16 data name-end
    in let ttl = dns-read-be32 data (name-end + 4)
    in let rdlen = read-be16 data (name-end + 8)
    in if name-end + 10 + rdlen > list-length data then acc
    else let rdata = dns-extract-rdata data (name-end + 10) rdlen []
    in let target = if rtype == dns-type-cname then dns-read-name data (name-end + 10) else []
    in let answer = DnsAnswer { owner = dns-read-name data off, rtype = rtype, rclass = read-be16 data (name-end + 2), ttl = ttl, rdata = rdata, target = target }
    in dns-parse-answers data (name-end + 10 + rdlen) (count - 1) (list-push acc answer)

 RFC 1035 sections 2.3.4 and 4.1.4: a label is at most 63 bytes, a name at most
 255, and the top two bits 11 mark a 14-bit pointer (01 and 10 are reserved).
 A pointer must land strictly before the run that holds it, so every jump moves
 the floor down and a pointer loop is refused rather than followed. Labels are
 lowered to ASCII lower case because names compare case-blind (RFC 4343). An
 empty list is a refused name and equals no encoded name, which ends in 0.

  dns-name-max : Integer = 255

  dns-read-name : List Integer, Integer -> List Integer
  dns-read-name (data) (off) = dns-read-name-at data off off []

  dns-read-name-at : List Integer, Integer, Integer, List Integer -> List Integer
  dns-read-name-at (data) (off) (low) (acc) =
    if off >= list-length data then []
    else let b = list-at data off
    in if b == 0 then dns-name-end acc
    else if bit-and b 192 == 192 then dns-read-name-jump data off low acc
    else if b > 63 then []
    else if off + 1 + b > list-length data then []
    else if list-length acc + 1 + b >= dns-name-max then []
    else dns-read-name-at data (off + 1 + b) low (dns-lower-label data (off + 1) (off + 1 + b) (list-push acc b))

  dns-name-end : List Integer -> List Integer
  dns-name-end (acc) = if list-length acc + 1 > dns-name-max then [] else acc & [0]

  dns-read-name-jump : List Integer, Integer, Integer, List Integer -> List Integer
  dns-read-name-jump (data) (off) (low) (acc) =
    if off + 2 > list-length data then []
    else let dest = bit-or (bit-shl (bit-and (list-at data off) 63) 8) (list-at data (off + 1))
    in if dest >= low then []
    else dns-read-name-at data dest dest acc

  dns-lower-label : List Integer, Integer, Integer, List Integer -> List Integer
  dns-lower-label (data) (i) (stop) (acc) =
    if i >= stop then acc
    else let c = list-at data i
    in dns-lower-label data (i + 1) stop (list-push acc (if c >= 65 & c <= 90 then c + 32 else c))

  dns-read-be32 : List Integer, Integer -> Integer
  dns-read-be32 (data) (off) =
    if off + 4 > list-length data then 0
    else let b0 = bit-shl (list-at data off) 24
    in let b1 = bit-shl (list-at data (off + 1)) 16
    in let b2 = bit-shl (list-at data (off + 2)) 8
    in let b3 = list-at data (off + 3)
    in bit-or b0 (bit-or b1 (bit-or b2 b3))

  dns-extract-rdata : List Integer, Integer, Integer, List Integer -> List Integer
  dns-extract-rdata (data) (off) (len) (acc) =
    if len <= 0 then acc
    else if off >= list-length data then acc
    else dns-extract-rdata data (off + 1) (len - 1) (list-push acc (list-at data off))

Section: Response Extraction
 RFC 1034 section 3.6.2: an answer for the name asked is an A record owned by
 that name, or by the end of a CNAME chain starting at it, in class IN. A chain
 longer than 16 links is refused, which bounds the chase at 17 scans of the
 answer list however many answers the datagram carries.

  dns-cname-max : Integer = 16

  dns-first-a-record : DnsResponse, Text -> Maybe (List Integer)
  dns-first-a-record (resp) (name) =
    when dns-a-answer resp name
      is None -> None
      is Just (a) -> Just (a.rdata)

  dns-first-a-ttl : DnsResponse, Text -> Integer
  dns-first-a-ttl (resp) (name) =
    when dns-a-answer resp name
      is None -> 0
      is Just (a) -> a.ttl

  dns-a-answer : DnsResponse, Text -> Maybe DnsAnswer
  dns-a-answer (resp) (name) =
    if resp.valid == False then None
    else let want = dns-read-name (dns-encode-name name) 0
    in if list-length want == 0 then None
    else dns-chase (resp.answers) want 0 (list-length (resp.answers))

  dns-chase : List DnsAnswer, List Integer, Integer, Integer -> Maybe DnsAnswer
  dns-chase (answers) (want) (links) (len) =
    when dns-find-owned answers want dns-type-a 0 len
      is Just (a) -> Just a
      is None -> if links >= dns-cname-max then None else dns-chase-cname answers (dns-find-owned answers want dns-type-cname 0 len) links len

  dns-chase-cname : List DnsAnswer, Maybe DnsAnswer, Integer, Integer -> Maybe DnsAnswer
  dns-chase-cname (answers) (found) (links) (len) =
    when found
      is None -> None
      is Just (c) -> if list-length (c.target) == 0 then None else dns-chase answers (c.target) (links + 1) len

  dns-find-owned : List DnsAnswer, List Integer, Integer, Integer, Integer -> Maybe DnsAnswer
  dns-find-owned (answers) (want) (rtype) (i) (len) =
    if i >= len then None
    else let a = list-at answers i
    in if dns-answer-fits a want rtype then Just a
    else dns-find-owned answers want rtype (i + 1) len

  dns-answer-fits : DnsAnswer, List Integer, Integer -> Boolean
  dns-answer-fits (a) (want) (rtype) =
    if a.rtype /= rtype then False
    else if a.rclass /= dns-class-in then False
    else if rtype == dns-type-a & list-length (a.rdata) /= 4 then False
    else dns-same-bytes (a.owner) want 0 (list-length want)

  dns-same-bytes : List Integer, List Integer, Integer, Integer -> Boolean
  dns-same-bytes (xs) (ys) (i) (n) =
    if list-length xs /= n then False
    else if i >= n then True
    else if list-at xs i /= list-at ys i then False
    else dns-same-bytes xs ys (i + 1) n

Section: UDP Integration
  dns-build-udp-query : List Integer, List Integer, Integer, Text -> List Integer
  dns-build-udp-query (src-ip) (dns-ip) (tx-id) (name) =
    let query = dns-build-a-query tx-id name
    in udp-build-ip-packet src-ip dns-ip 1024 dns-port query

