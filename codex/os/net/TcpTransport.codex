 TCP transport binding for the trust network. Sends and receives
 length-prefixed framed messages over a TCP connection via the
 NetworkStack. TcpTransport is Step 5 of the trust network
 implementation order (TrustAndRuntime.md).

 We say:

Section: Transport State
  TcpTransportState = record {
    session : NetSession,
    recv-buf : List Integer,
    messages-sent : Integer between 0 and 4294967295,
    messages-received : Integer between 0 and 4294967295
  }

  transport-new : NetSession -> TcpTransportState
  transport-new (sess) = TcpTransportState { session = sess, recv-buf = [], messages-sent = 0, messages-received = 0 }

Section: Send Message
  TransportSendResult = record {
    transport : TcpTransportState,
    success : Boolean,
    output : Text
  }

  transport-send-message : TcpTransportState, Integer, List Integer -> TransportSendResult
  transport-send-message (ts) (type-tag) (body) =
    let framed = frame-encode type-tag body
    in let r = net-send (ts.session) framed
    in TransportSendResult {
      transport = TcpTransportState { session = r.session, recv-buf = ts.recv-buf, messages-sent = ts.messages-sent + 1, messages-received = ts.messages-received },
      success = True,
      output = r.output
    }

Section: Receive Processing
  TransportRecvResult = record {
    transport : TcpTransportState,
    tag : Integer between 0 and 255,
    body : List Integer,
    has-message : Boolean
  }

  transport-feed-data : TcpTransportState, List Integer -> TcpTransportState
  transport-feed-data (ts) (data) =
    TcpTransportState { session = ts.session, recv-buf = ts.recv-buf & data, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-try-recv : TcpTransportState -> TransportRecvResult
  transport-try-recv (ts) =
    if list-length (ts.recv-buf) < 4 then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
    else let msg-len = frame-decode-length (ts.recv-buf)
    in let total = 4 + msg-len
    in if list-length (ts.recv-buf) < total then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
    else let tag = list-at (ts.recv-buf) 4
    in let body = transport-slice (ts.recv-buf) 5 total
    in let remaining = transport-slice (ts.recv-buf) total (list-length (ts.recv-buf))
    in let ts1 = TcpTransportState { session = ts.session, recv-buf = remaining, messages-sent = ts.messages-sent, messages-received = ts.messages-received + 1 }
    in TransportRecvResult { transport = ts1, tag = tag, body = body, has-message = True }

  transport-slice : List Integer, Integer, Integer -> List Integer
  transport-slice (buf) (start) (stop) = transport-slice-loop buf start stop []

  transport-slice-loop : List Integer, Integer, Integer, List Integer -> List Integer
  transport-slice-loop (buf) (i) (stop) (acc) =
    if i >= stop then acc
    else transport-slice-loop buf (i + 1) stop (list-push acc (list-at buf i))

Section: Feed Inbound Frame
  transport-process-frame : TcpTransportState, List Integer -> TransportRecvResult
  transport-process-frame (ts) (frame) =
    let r = net-process-frame (ts.session) frame
    in let ts1 = TcpTransportState { session = r.session, recv-buf = ts.recv-buf & r.data, messages-sent = ts.messages-sent, messages-received = ts.messages-received }
    in transport-try-recv ts1

Section: Connection Lifecycle
  transport-connect : TcpTransportState -> TcpTransportState
  transport-connect (ts) =
    let r = net-connect (ts.session)
    in TcpTransportState { session = r.session, recv-buf = ts.recv-buf, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-close : TcpTransportState -> TcpTransportState
  transport-close (ts) =
    let r = net-close (ts.session)
    in TcpTransportState { session = r.session, recv-buf = ts.recv-buf, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

Section: Stats
  transport-stats : TcpTransportState -> Text
  transport-stats (ts) = "sent=" & show (ts.messages-sent) & " recv=" & show (ts.messages-received) & " buf=" & show (list-length (ts.recv-buf))

