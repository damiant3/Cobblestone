 We say:

Section: Transport State
  TcpTransportState = record {
    session : NetSession,
    recv-base : Integer,
    recv-len : Integer,
    recv-cap : Integer,
    messages-sent : Integer between 0 and 4294967295,
    messages-received : Integer between 0 and 4294967295
  }

  transport-recv-buf-cap : Integer = 33554432

  transport-new : NetSession -> TcpTransportState
  transport-new (sess) = transport-new-with-cap sess transport-recv-buf-cap

  transport-new-with-cap : NetSession, Integer -> TcpTransportState
  transport-new-with-cap (sess) (cap) =
    let base = __heap-save
    in let adv = __heap-advance cap
    in TcpTransportState { session = sess, recv-base = base, recv-len = 0, recv-cap = cap, messages-sent = 0, messages-received = 0 }

Section: Send Message
  TransportSendResult = record {
    transport : TcpTransportState,
    success : Boolean,
    output : Text
  }

  transport-send-message : TcpTransportState, Integer, List Integer -> TransportSendResult
  transport-send-message (ts) (type-tag) (body) =
    let framed = frame-encode type-tag body
    in let r = net-send (ts.session) framed
    in TransportSendResult {
      transport = TcpTransportState { session = r.session, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent + 1, messages-received = ts.messages-received },
      success = True,
      output = r.output
    }

Section: Receive Processing
  TransportRecvResult = record {
    transport : TcpTransportState,
    tag : Integer between 0 and 255,
    body : List Integer,
    has-message : Boolean
  }

  transport-drop-recv : TcpTransportState -> TcpTransportState
  transport-drop-recv (ts) =
    TcpTransportState { session = ts.session, recv-base = ts.recv-base, recv-len = 0, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-feed-raw : TcpTransportState, List Integer -> TcpTransportState
  transport-feed-raw (ts) (data) =
    let n = list-length data
    in if (ts.recv-len + n) > (ts.recv-cap) then ts
    else let w = __buf-write-bytes (ts.recv-base) (ts.recv-len) data
    in TcpTransportState { session = ts.session, recv-base = ts.recv-base, recv-len = ts.recv-len + n, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-feed-data : TcpTransportState, List Integer -> TcpTransportState
  transport-feed-data (ts) (data) = transport-feed-raw ts data

  recv-buf-byte : TcpTransportState, Integer -> Integer
  recv-buf-byte (ts) (i) = peek-byte (ts.recv-base) i

  recv-buf-i32 : TcpTransportState, Integer -> Integer
  recv-buf-i32 (ts) (off) =
    recv-buf-byte ts off + recv-buf-byte ts (off + 1) * 256 + recv-buf-byte ts (off + 2) * 65536 + recv-buf-byte ts (off + 3) * 16777216

  transport-try-recv : TcpTransportState -> TransportRecvResult
  transport-try-recv (ts) =
    if ts.recv-len < 4 then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
    else let msg-len = recv-buf-i32 ts 0
    in if msg-len < 1 then TransportRecvResult { transport = transport-drop-recv ts, tag = 0, body = [], has-message = False }
    else if msg-len > (ts.recv-cap - 4) then TransportRecvResult { transport = transport-drop-recv ts, tag = 0, body = [], has-message = False }
    else let total = 4 + msg-len
    in if ts.recv-len < total then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
    else let tag = recv-buf-byte ts 4
    in let body = __buf-read-bytes (ts.recv-base) 5 (msg-len - 1)
    in let remaining-len = ts.recv-len - total
    in let hp = __heap-save
    in let remaining = __buf-read-bytes (ts.recv-base) total remaining-len
    in let w = __buf-write-bytes (ts.recv-base) 0 remaining
    in let restored = __heap-restore hp
    in let ts1 = TcpTransportState { session = ts.session, recv-base = ts.recv-base, recv-len = remaining-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received + 1 }
    in TransportRecvResult { transport = ts1, tag = __narrow tag, body = body, has-message = True }

  transport-slice : List Integer, Integer, Integer -> List Integer
  transport-slice (buf) (start) (stop) = transport-slice-loop buf start stop []

  transport-slice-loop : List Integer, Integer, Integer, List Integer -> List Integer
  transport-slice-loop (buf) (i) (stop) (acc) =
    if i >= stop then acc
    else transport-slice-loop buf (i + 1) stop (list-push acc (list-at buf i))

Section: Feed Inbound Frame

 `transport-feed-from` is `transport-feed-raw` taking the session as an
 argument instead of reading it off the transport. Both of its branches build
 exactly ONE record, which is the point: feeding through `transport-feed-raw`
 costs a second one, because the caller has to build a transport carrying the
 new session before it has anything to pass. Measured at
 `codex/test/net-recv-heap`: 64 of the 208 bytes a frame retained.

  transport-feed-from : TcpTransportState, NetSession, List Integer -> TcpTransportState
  transport-feed-from (ts) (sess) (data) =
    let n = list-length data
    in if (ts.recv-len + n) > (ts.recv-cap)
    then transport-set-session ts sess
    else let w = __buf-write-bytes (ts.recv-base) (ts.recv-len) data
    in TcpTransportState { session = sess, recv-base = ts.recv-base, recv-len = ts.recv-len + n, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

 FEEDING A RANGE INSTEAD OF A LIST. `transport-feed-from` takes a list, and on
 the accepted path that list is a pure intermediate: `tcp-parse-at` builds it
 out of the frame at 16,432 bytes for a 1,514-byte frame (`net-recv-heap`),
 `__buf-write-bytes` copies it into `recv-base`, and it is then dropped. This
 writes the same bytes straight out of the frame and allocates nothing.

 `__buf-write-byte buf off b` returns the offset PAST what it wrote, which is
 why it is not `poke-byte` (`WasmEmitter.codex`), so the cursor is the loop's
 accumulator rather than a second counter.

 `transport-process-frame` feeds through this, and `NetIO` and `Arm64NetIO`
 do the same. `transport-feed-from` remains for the callers that hold a list
 rather than a frame, and `net-recv-heap` compares the two byte for byte.

  transport-write-range : Integer, Integer, List Integer, Integer, Integer -> Integer
  transport-write-range (base) (dst) (buf) (i) (stop) =
    if i >= stop then dst
    else transport-write-range base (__buf-write-byte base dst (list-at buf i)) buf (i + 1) stop

  transport-feed-range : TcpTransportState, NetSession, List Integer, Integer, Integer -> TcpTransportState
  transport-feed-range (ts) (sess) (buf) (off) (stop) =
    let n = stop - off
    in if n <= 0 then transport-set-session ts sess
    else if (ts.recv-len + n) > (ts.recv-cap) then transport-set-session ts sess
    else let e = transport-write-range (ts.recv-base) (ts.recv-len) buf off stop
    in TcpTransportState { session = sess, recv-base = ts.recv-base, recv-len = ts.recv-len + n, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-process-frame : TcpTransportState, List Integer -> TransportRecvResult
  transport-process-frame (ts) (frame) =
    let r = net-process-frame (ts.session) frame
    in transport-try-recv (transport-feed-range ts (r.session) (r.data) (r.data-off) (r.data-stop))

Section: Connection Lifecycle
  transport-connect : TcpTransportState -> TcpTransportState
  transport-connect (ts) =
    let r = net-connect (ts.session)
    in transport-set-session ts (r.session)

  transport-close : TcpTransportState -> TcpTransportState
  transport-close (ts) =
    let r = net-close (ts.session)
    in transport-set-session ts (r.session)

  transport-set-session : TcpTransportState, NetSession -> TcpTransportState
  transport-set-session (ts) (sess) =
    TcpTransportState { session = sess, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  transport-tick : TcpTransportState -> TcpTransportState
  transport-tick (ts) = transport-set-session ts ((net-tick (ts.session)).session)

Section: Stats
  transport-stats : TcpTransportState -> Text
  transport-stats (ts) = "sent=" & show (ts.messages-sent) & " recv=" & show (ts.messages-received) & " buf=" & show (ts.recv-len)

