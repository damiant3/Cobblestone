Chapter: Udp
  cites Net chapter Ethernet

 We say:

Section: Constants
  udp-header-size : Integer = 8

Section: Datagram Type
  UdpDatagram = record {
    src-port : Integer between 0 and 65535,
    dst-port : Integer between 0 and 65535,
    payload : List Integer
  }

Section: Datagram Construction
  udp-build : Integer, Integer, List Integer -> List Integer
  udp-build (src-port) (dst-port) (payload) =
    let len = udp-header-size + list-length payload
    in write-be16 src-port & write-be16 dst-port & write-be16 len & [0, 0] & payload

Section: Checksums

 RFC 768. The pseudo-header is the same shape TCP's is, with the UDP protocol
 number and the UDP length, and the datagram is padded to an even byte count
 for the sum without that pad going on the wire.

 The two zero rules are not symmetric and both matter. A COMPUTED zero is
 transmitted as 0xFFFF, because on IPv4 a stored zero is the encoding for "no
 checksum here" and the two must not collide. A RECEIVED zero is accepted
 without checking, for the same reason read the other way: refusing it would
 refuse every peer that declines to compute one, which is legal, and included
 this stack until the send half below existed.

  udp-pseudo-header : List Integer, List Integer, Integer -> List Integer
  udp-pseudo-header (src-ip) (dst-ip) (udp-len) =
    src-ip & dst-ip & [0, ip-proto-udp] & write-be16 udp-len

  udp-sum : List Integer, List Integer, List Integer -> Integer
  udp-sum (udp-bytes) (src-ip) (dst-ip) =
    let udp-len = list-length udp-bytes
    in let pseudo = udp-pseudo-header src-ip dst-ip udp-len
    in let padded = if bit-and udp-len 1 == 1 then pseudo & udp-bytes & [0] else pseudo & udp-bytes
    in ip-checksum padded 0 (list-length padded) 0

  udp-with-checksum : List Integer, List Integer, List Integer -> List Integer
  udp-with-checksum (udp-bytes) (src-ip) (dst-ip) =
    let raw = udp-sum udp-bytes src-ip dst-ip
    in let cksum = if raw == 0 then 65535 else raw
    in list-set-at (list-set-at udp-bytes 6 (bit-shru cksum 8)) 7 (bit-and cksum 255)

  udp-checksum-valid : List Integer, List Integer, List Integer -> Boolean
  udp-checksum-valid (udp-bytes) (src-ip) (dst-ip) =
    if list-length udp-bytes < udp-header-size then False
    else if read-be16 udp-bytes 4 /= list-length udp-bytes then False
    else if read-be16 udp-bytes 6 == 0 then True
    else udp-sum udp-bytes src-ip dst-ip == 0

Section: Datagram Parsing
  udp-parse : List Integer -> UdpDatagram
  udp-parse (data) =
    let plen = list-length data
    in if plen < udp-header-size then UdpDatagram { src-port = 0, dst-port = 0, payload = [] }
    else let payload-len = read-be16 data 4 - udp-header-size
    in UdpDatagram {
      src-port = __narrow (read-be16 data 0),
      dst-port = __narrow (read-be16 data 2),
      payload = udp-extract-payload data udp-header-size (udp-header-size + payload-len) []
    }

  udp-extract-payload : List Integer, Integer, Integer, List Integer -> List Integer
  udp-extract-payload (data) (i) (stop) (acc) =
    if i >= stop then acc
    else if i >= list-length data then acc
    else udp-extract-payload data (i + 1) stop (list-push acc (list-at data i))

Section: IP Integration
  udp-build-ip-packet : List Integer, List Integer, Integer, Integer, List Integer -> List Integer
  udp-build-ip-packet (src-ip) (dst-ip) (src-port) (dst-port) (payload) =
    let udp-data = udp-with-checksum (udp-build src-port dst-port payload) src-ip dst-ip
    in ip-build-packet src-ip dst-ip ip-proto-udp udp-data

  udp-build-frame : List Integer, List Integer, List Integer, List Integer, Integer, Integer, List Integer -> List Integer
  udp-build-frame (dst-mac) (src-mac) (src-ip) (dst-ip) (src-port) (dst-port) (payload) =
    let ip-pkt = udp-build-ip-packet src-ip dst-ip src-port dst-port payload
    in eth-build-frame dst-mac src-mac eth-type-ipv4 ip-pkt

Section: Frame Parsing
  UdpFrame = record {
    src-ip : List Integer,
    dst-ip : List Integer,
    datagram : UdpDatagram,
    valid : Boolean
  }

  udp-parse-ip-payload : List Integer, List Integer, List Integer -> UdpFrame
  udp-parse-ip-payload (ip-payload) (src-ip) (dst-ip) =
    if list-length ip-payload < udp-header-size
    then UdpFrame { src-ip = src-ip, dst-ip = dst-ip, datagram = UdpDatagram { src-port = 0, dst-port = 0, payload = [] }, valid = False }
    else UdpFrame { src-ip = src-ip, dst-ip = dst-ip, datagram = udp-parse ip-payload, valid = True }

Section: Queries
  udp-datagram-length : UdpDatagram -> Integer
  udp-datagram-length (d) = list-length (d.payload)

  format-udp-datagram : UdpDatagram -> Text
  format-udp-datagram (d) =
    show (d.src-port) & "->" & show (d.dst-port) & " len=" & show (udp-datagram-length d)

  format-udp-frame : UdpFrame -> Text
  format-udp-frame (f) =
    udp-format-ip (f.src-ip) & ":" & show (f.datagram.src-port)
    & " -> " & udp-format-ip (f.dst-ip) & ":" & show (f.datagram.dst-port)
    & " len=" & show (udp-datagram-length (f.datagram))

  udp-format-ip : List Integer -> Text
  udp-format-ip (ip) =
    show (list-at ip 0) & "." & show (list-at ip 1) & "."
    & show (list-at ip 2) & "." & show (list-at ip 3)

