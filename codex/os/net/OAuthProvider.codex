Chapter: OAuthProvider
  cites Net chapter OAuthClient

Section: Google

  google-auth-url : Text = "https://accounts.google.com/o/oauth2/v2/auth"
  google-token-url : Text = "https://oauth2.googleapis.com/token"
  google-issuer : Text = "https://accounts.google.com"

  google-scopes-login : Text = "openid email profile"
  google-scopes-mail : Text = "openid email profile https://mail.google.com/"
  google-scopes-calendar : Text = "openid email profile https://www.googleapis.com/auth/calendar.readonly"
  google-scopes-drive : Text = "openid email profile https://www.googleapis.com/auth/drive.readonly"

  google-scopes-full : Text =
    "openid email profile https://mail.google.com/ https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/drive.readonly"

  google-oauth-config : Text, Text -> OAuthConfig
  google-oauth-config (client-id) (redirect-uri) = OAuthConfig {
    oc-provider = "google",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = google-scopes-login,
    oc-auth-url = google-auth-url,
    oc-token-url = google-token-url
  }

  google-oauth-mail : Text, Text -> OAuthConfig
  google-oauth-mail (client-id) (redirect-uri) = OAuthConfig {
    oc-provider = "google",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = google-scopes-mail,
    oc-auth-url = google-auth-url,
    oc-token-url = google-token-url
  }

  google-oauth-full : Text, Text -> OAuthConfig
  google-oauth-full (client-id) (redirect-uri) = OAuthConfig {
    oc-provider = "google",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = google-scopes-full,
    oc-auth-url = google-auth-url,
    oc-token-url = google-token-url
  }

Section: Microsoft

  microsoft-auth-url : Text, Text -> Text
  microsoft-auth-url (tenant) (suffix) =
    "https://login.microsoftonline.com/" & tenant & "/oauth2/v2.0/" & suffix

  microsoft-issuer : Text -> Text
  microsoft-issuer (tenant) = "https://login.microsoftonline.com/" & tenant & "/v2.0"

  microsoft-scopes-login : Text = "openid email profile offline_access"
  microsoft-scopes-mail : Text = "openid email profile offline_access https://outlook.office365.com/IMAP.AccessAsUser.All"
  microsoft-scopes-calendar : Text = "openid email profile offline_access https://graph.microsoft.com/Calendars.Read"
  microsoft-scopes-files : Text = "openid email profile offline_access https://graph.microsoft.com/Files.Read"

  microsoft-scopes-full : Text =
    "openid email profile offline_access https://outlook.office365.com/IMAP.AccessAsUser.All https://graph.microsoft.com/Calendars.Read https://graph.microsoft.com/Files.Read"

  microsoft-oauth-config : Text, Text, Text -> OAuthConfig
  microsoft-oauth-config (client-id) (tenant) (redirect-uri) = OAuthConfig {
    oc-provider = "microsoft",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = microsoft-scopes-login,
    oc-auth-url = microsoft-auth-url tenant "authorize",
    oc-token-url = microsoft-auth-url tenant "token"
  }

  microsoft-oauth-mail : Text, Text, Text -> OAuthConfig
  microsoft-oauth-mail (client-id) (tenant) (redirect-uri) = OAuthConfig {
    oc-provider = "microsoft",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = microsoft-scopes-mail,
    oc-auth-url = microsoft-auth-url tenant "authorize",
    oc-token-url = microsoft-auth-url tenant "token"
  }

  microsoft-oauth-full : Text, Text, Text -> OAuthConfig
  microsoft-oauth-full (client-id) (tenant) (redirect-uri) = OAuthConfig {
    oc-provider = "microsoft",
    oc-client-id = client-id,
    oc-redirect-uri = redirect-uri,
    oc-scopes = microsoft-scopes-full,
    oc-auth-url = microsoft-auth-url tenant "authorize",
    oc-token-url = microsoft-auth-url tenant "token"
  }

Section: Provider Detection

  oauth-provider-name : Text -> Text
  oauth-provider-name (issuer) =
    if text-contains issuer "google" then "google"
    else if text-contains issuer "microsoftonline" then "microsoft"
    else "unknown"

Section: Formatting

  format-provider : OAuthConfig -> Text
  format-provider (c) = c.oc-provider & " scopes=" & c.oc-scopes

