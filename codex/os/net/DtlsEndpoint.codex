Chapter: DtlsEndpoint
  cites Encode chapter Dtls
  cites Encode chapter DtlsHandshake
  cites Encode chapter DtlsHello
  cites Encode chapter DtlsMessage
  cites Encode chapter X509
  cites Encode chapter X509Chain
  cites Encode chapter TlsCert
  cites Foreword chapter DiffieHellman
  cites Foreword chapter Ed25519
  cites Foreword chapter Hmac
  cites Foreword chapter Hkdf
  cites Foreword chapter Tls
  cites Foreword chapter Maybe

 It is PURE, and deliberately so. Datagrams in, datagrams out; no socket,
 no clock, no I/O. It follows the Udp chapter's precedent -- os/net holds
 pure protocol logic and NetIO is the only thing that touches a wire. The
 payoff is that a DTLS handshake between two real endpoints, cookie
 exchange and all, runs as an ordinary battery sample with no network and
 no peer process. A datagram protocol whose difficulty is loss and
 reordering can be tested by simply choosing which datagrams to deliver.

 X.509 peer authentication only, with Ed25519 certificates (RFC 8410): that
 is the credential model, and its one real limit is that a chain signed by a
 commercial CA (RSA or ECDSA) cannot be validated -- this authenticates a
 fleet whose CA you run.

 One honest limit remains, and it is not hidden: no third-party DTLS peer
 has completed a handshake with this endpoint. The record layer has a
 known-answer oracle (codex/test/dtls-record), the key schedule has the RFC
 8448 vectors, and since 2026-08-09 the handshake FRAGMENTATION layer has a
 third-party oracle too (codex/test/dtls-openssl-fragments reassembles real
 OpenSSL fragments, including a flight OpenSSL refragmented differently on
 retransmission). The assembled handshake is still proven only between our
 own endpoints.

 What blocks the rest is a tool version, not a decision, and it is worth
 recording so nobody re-derives it: OpenSSL gained DTLS 1.3 in 3.5, and
 3.2.4 is what is installed here (measured 2026-08-09, both the mingw64 and
 usr/bin builds; Python's ssl module exposes no DTLS at any version). The
 fragmentation oracle works around this because RFC 6347 section 4.2.2 and
 RFC 9147 section 5.2 specify the same handshake message header, so a DTLS
 1.2 peer is a valid oracle for that layer and only that layer. A full
 interop test the way tls-interop-test does it needs OpenSSL 3.5 or later.

 We say:

Section: Types

  DtlsEp = record {
    ep-server : Boolean,
    ep-hs : DtlsHsState,
    ep-priv : List Integer,
    ep-pub : List Integer,
    ep-random : List Integer,
    ep-peer-pub : List Integer,
    ep-transcript : List Integer,
    ep-ch1 : List Integer,
    ep-cookie-secret : List Integer,
    ep-addr : List Integer,
    ep-send-seq : Integer,
    ep-msg-seq : Integer,
    ep-c-hs : List Integer,
    ep-s-hs : List Integer,
    ep-done : Boolean,
    ep-cert-chain : List (List Integer),
    ep-sign-priv : List Integer,
    ep-sign-pub : List Integer,
    ep-anchors : List X509Anchor,
    ep-cal-now : List Integer,
    ep-peer-key : X509Key,
    ep-auth-done : Boolean,
    ep-expected-peer : List Integer,
    ep-hs-secret : List Integer,
    ep-c-ap : List Integer,
    ep-s-ap : List Integer,
    ep-app-read-seq : Integer,
    ep-app-write-seq : Integer,
    ep-app-in : List Integer,
    ep-reasm : DtlsReasm
  }

  DtlsEpStep = record {
    es-ep : DtlsEp,
    es-out : List (List Integer)
  }

Section: Construction

  dtls-ep-new : Boolean, List Integer, List Integer, List Integer, List Integer -> DtlsEp
  dtls-ep-new (is-server) (priv) (random) (cookie-secret) (addr) =
    DtlsEp { ep-server = is-server, ep-hs = dtls-hs-new, ep-priv = priv, ep-pub = x25519-public-key priv,
             ep-random = random, ep-peer-pub = [], ep-transcript = [], ep-ch1 = [], ep-cookie-secret = cookie-secret,
             ep-addr = addr, ep-send-seq = 0, ep-msg-seq = 0, ep-c-hs = [], ep-s-hs = [], ep-done = False,
             ep-cert-chain = [], ep-sign-priv = [], ep-sign-pub = [], ep-anchors = [], ep-cal-now = [],
             ep-peer-key = X509Key { xk-alg = KeyUnknown, xk-bytes = [], xk-mod = [], xk-exp = [] }, ep-auth-done = False,
             ep-expected-peer = [], ep-hs-secret = [], ep-c-ap = [], ep-s-ap = [],
             ep-app-read-seq = 0, ep-app-write-seq = 0, ep-app-in = [], ep-reasm = dtls-reasm-new }

  dtls-ep-with-cert : DtlsEp, List (List Integer), List Integer, List Integer -> DtlsEp
  dtls-ep-with-cert (ep) (chain) (sign-priv) (sign-pub) =
    __record-set (__record-set (__record-set ep "ep-cert-chain" chain) "ep-sign-priv" sign-priv) "ep-sign-pub" sign-pub

  dtls-ep-with-anchors : DtlsEp, List X509Anchor, List Integer, List Integer -> DtlsEp
  dtls-ep-with-anchors (ep) (anchors) (cal-now) (expected) =
    __record-set (__record-set (__record-set ep "ep-anchors" anchors) "ep-cal-now" cal-now) "ep-expected-peer" expected

Section: Client

  dtls-ep-client : DtlsEp, Integer -> DtlsEpStep
  dtls-ep-client (ep) (now) =
    let r = dtls-hs-step (ep.ep-hs) (EvStart now)
    in let body = dtls-client-hello-body (dtls-ep-random ep) [] (ep.ep-pub) []
    in let tr = tls13-msg-transcript dtls-hs-client-hello body
    in let ep2 = __record-set (__record-set (__record-set ep "ep-hs" (r.step-state)) "ep-transcript" tr) "ep-ch1" tr
    in DtlsEpStep { es-ep = ep2, es-out = dtls-ep-wrap-into ep2 [] dtls-hs-client-hello 0 body }

  dtls-ep-random : DtlsEp -> List Integer
  dtls-ep-random (ep) = dtls-take-at (ep.ep-random) 0 32

Section: Receive

 One datagram in. Everything is bounds-checked before it is believed: a
 datagram is whatever an attacker chose to send.

  dtls-ep-recv : DtlsEp, List Integer, Integer -> DtlsEpStep
  dtls-ep-recv (ep) (dgram) (now) =
    if list-length dgram < 1 then dtls-ep-idle ep
    else if ep.ep-done then dtls-ep-recv-done ep dgram
    else if dtls-is-record (list-at dgram 0) then dtls-ep-recv-hs-enc ep dgram now
    else dtls-ep-recv-plain ep dgram now

 Once the handshake is done, a DTLS 1.3 record (unified header, top three
 bits 001) is application data and is opened under the peer's application
 key. Anything else after completion is dropped rather than believed.

  dtls-ep-recv-done : DtlsEp, List Integer -> DtlsEpStep
  dtls-ep-recv-done (ep) (dgram) =
    if dtls-is-record (list-at dgram 0) then dtls-ep-recv-app ep dgram
    else dtls-ep-idle ep

 A protected record BEFORE completion is a handshake message at the
 handshake epoch: the server flight after ServerHello, and the two
 Finished messages, all sealed under the handshake traffic keys (RFC 9147
 epoch 2). Open it under the PEER's handshake secret, then feed the inner
 handshake message to the very same dispatch the plaintext path uses --
 the decrypt is a thin layer, the machine underneath is unchanged. A record
 that does not open (a wrong key from a substituted key_share, say) yields
 no message and the state does not advance.

  dtls-ep-recv-hs-enc : DtlsEp, List Integer, Integer -> DtlsEpStep
  dtls-ep-recv-hs-enc (ep) (dgram) (now) =
    let secret = if ep.ep-server then ep.ep-c-hs else ep.ep-s-hs
    in when dtls-open (dtls-ep-keys secret) 0 dgram
      is None -> dtls-ep-idle ep
      is Just (p) -> dtls-ep-on-enc-hs ep p now

  dtls-ep-on-enc-hs : DtlsEp, DtlsPlain, Integer -> DtlsEpStep
  dtls-ep-on-enc-hs (ep) (p) (now) =
    if p.dp-type /= dtls-content-handshake then dtls-ep-idle ep
    else when dtls-msg-parse (p.dp-content)
      is None -> dtls-ep-idle ep
      is Just (m) -> dtls-ep-on-frag ep m now

  dtls-ep-recv-plain : DtlsEp, List Integer, Integer -> DtlsEpStep
  dtls-ep-recv-plain (ep) (dgram) (now) =
    when dtls-plain-decode dgram
      is None -> dtls-ep-idle ep
      is Just (p) -> dtls-ep-on-plain ep p now

  dtls-ep-on-plain : DtlsEp, DtlsPlainRec, Integer -> DtlsEpStep
  dtls-ep-on-plain (ep) (p) (now) =
    when dtls-msg-parse (p.dpr-fragment)
      is None -> dtls-ep-idle ep
      is Just (m) -> dtls-ep-on-frag ep m now

 RFC 9147 section 5.2. A message that arrives whole takes the same path it
 always did, without touching the buffer: that is what keeps an
 unfragmented handshake byte-identical rather than merely still working.
 Anything else accumulates until the fragments cover the declared length,
 and the buffer resets on completion so the next message does not inherit
 a satisfied one.

  dtls-ep-on-frag : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-on-frag (ep) (m) (now) =
    if m.dm-frag-offset == 0 & m.dm-frag-length == m.dm-length then dtls-ep-on-msg ep m now
    else dtls-ep-on-partial ep (dtls-reasm-add (ep.ep-reasm) m) now

  dtls-ep-on-partial : DtlsEp, DtlsReasm, Integer -> DtlsEpStep
  dtls-ep-on-partial (ep) (r) (now) =
    when dtls-reasm-message r
      is None -> dtls-ep-idle (__record-set ep "ep-reasm" r)
      is Just (whole) -> dtls-ep-on-msg (__record-set ep "ep-reasm" dtls-reasm-new) whole now

  dtls-ep-on-msg : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-on-msg (ep) (m) (now) =
    if ep.ep-server then dtls-ep-server-msg ep m now
    else dtls-ep-client-msg ep m now

Section: Server

 The server answers a cookieless ClientHello with a HelloRetryRequest and
 KEEPS NOTHING. That is the whole point: the state it would have
 allocated is exactly what an attacker with a forged source address wants
 it to allocate. It recomputes the cookie from the address instead.

  dtls-ep-server-msg : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-server-msg (ep) (m) (now) =
    if m.dm-type == dtls-hs-client-hello then dtls-ep-server-ch ep m now
    else if m.dm-type == dtls-hs-finished then dtls-ep-server-fin ep m
    else dtls-ep-idle ep

  dtls-ep-server-ch : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-server-ch (ep) (m) (now) =
    when dtls-ch-cookie (m.dm-body)
      is None -> dtls-ep-send-hrr ep m
      is Just (c) -> dtls-ep-server-check ep m c

 THE COOKIE CARRIES THE TRANSCRIPT. A stateless server has no
 ClientHello1 when it later needs to hash one -- and keeping it is exactly
 the state the cookie exists to avoid. RFC 8446 section 4.2.2 resolves
 this: the server puts the ClientHello1 hash INSIDE the cookie. So the
 cookie here is the hash followed by a MAC over the address AND the hash,
 which is what makes it both unforgeable and self-carrying.

  dtls-ep-cookie : List Integer, List Integer, List Integer -> List Integer
  dtls-ep-cookie (secret) (addr) (ch1-hash) =
    ch1-hash & hkdf-words-to-bytes (hmac-sha256 secret (addr & ch1-hash))

  dtls-ep-cookie-hash : List Integer, List Integer, List Integer -> Maybe (List Integer)
  dtls-ep-cookie-hash (secret) (addr) (cookie) =
    if list-length cookie /= 64 then None
    else dtls-ep-cookie-verify secret addr cookie

  dtls-ep-cookie-verify : List Integer, List Integer, List Integer -> Maybe (List Integer)
  dtls-ep-cookie-verify (secret) (addr) (cookie) =
    let h = dtls-take-at cookie 0 32
    in let mac = dtls-take-at cookie 32 32
    in if tls13-ct-equal (hkdf-words-to-bytes (hmac-sha256 secret (addr & h))) mac then Just h
    else None

  dtls-ep-send-hrr : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-send-hrr (ep) (m) =
    let ch1-hash = tls13-transcript-hash (dtls-msg-to-transcript m)
    in let cookie = dtls-ep-cookie (ep.ep-cookie-secret) (ep.ep-addr) ch1-hash
    in DtlsEpStep { es-ep = ep, es-out = dtls-ep-wrap-into ep [] dtls-hs-server-hello 0 (dtls-hrr-body [] cookie) }

 A cookie that does not verify MUST abort. It is not the same as no
 cookie: re-issuing a HelloRetryRequest here would give an attacker a
 free retry and an oracle.

  dtls-ep-server-check : DtlsEp, DtlsMsg, List Integer -> DtlsEpStep
  dtls-ep-server-check (ep) (m) (cookie) =
    when dtls-ep-cookie-hash (ep.ep-cookie-secret) (ep.ep-addr) cookie
      is None -> dtls-ep-idle ep
      is Just (h) -> dtls-ep-server-accept ep m cookie h

  dtls-ep-server-accept : DtlsEp, DtlsMsg, List Integer, List Integer -> DtlsEpStep
  dtls-ep-server-accept (ep) (m) (cookie) (ch1-hash) =
    when dtls-ch-key-share (m.dm-body)
      is None -> dtls-ep-idle ep
      is Just (peer) -> dtls-ep-server-flight ep m peer cookie ch1-hash

  dtls-ep-server-flight : DtlsEp, DtlsMsg, List Integer, List Integer, List Integer -> DtlsEpStep
  dtls-ep-server-flight (ep) (m) (peer) (cookie) (ch1-hash) =
    let sh-body = dtls-server-hello-body (dtls-ep-random ep) [] (ep.ep-pub)
    in let tr = dtls-ep-server-transcript ep m sh-body cookie ch1-hash
    in let hs = tls13-handshake-secret (x25519-shared-secret (ep.ep-priv) peer)
    in let th = tls13-transcript-hash tr
    in let c-hs = tls13-client-hs-traffic hs th
    in let s-hs = tls13-server-hs-traffic hs th
    in if list-length (ep.ep-cert-chain) == 0
    then dtls-ep-server-emit (dtls-ep-with-keys ep peer hs tr c-hs s-hs) sh-body th
    else dtls-ep-server-emit-auth ep peer hs tr c-hs s-hs sh-body

  dtls-ep-server-emit-auth : DtlsEp, List Integer, List Integer, List Integer, List Integer, List Integer, List Integer -> DtlsEpStep
  dtls-ep-server-emit-auth (ep) (peer) (hs) (tr) (c-hs) (s-hs) (sh-body) =
    let cert-body = tls-cert-encode (ep.ep-cert-chain)
    in let tr-cert = tr & tls13-msg-transcript dtls-hs-certificate cert-body
    in let th-cert = tls13-transcript-hash tr-cert
    in let cv-body = tls-cv-encode True (ep.ep-sign-priv) (ep.ep-sign-pub) th-cert
    in let tr-cv = tr-cert & tls13-msg-transcript dtls-hs-cert-verify cv-body
    in let th-cv = tls13-transcript-hash tr-cv
    in dtls-ep-server-emit-msgs (dtls-ep-with-keys ep peer hs tr-cv c-hs s-hs) sh-body cert-body cv-body th-cv

  dtls-ep-server-emit-msgs : DtlsEp, List Integer, List Integer, List Integer, List Integer -> DtlsEpStep
  dtls-ep-server-emit-msgs (ep) (sh-body) (cert-body) (cv-body) (th) =
    let sfin = tls13-verify-data (ep.ep-s-hs) th
    in let hk = dtls-ep-keys (ep.ep-s-hs)
    in let o0 = dtls-ep-wrap-into ep [] dtls-hs-server-hello 0 sh-body
    in let o1 = dtls-ep-seal-into hk o0 0 dtls-hs-certificate 1 cert-body
    in let o2 = dtls-ep-seal-into hk o1 (list-length o1 - list-length o0) dtls-hs-cert-verify 2 cv-body
    in let o3 = dtls-ep-seal-into hk o2 (list-length o2 - list-length o0) dtls-hs-finished 3 sfin
    in let ep2 = dtls-ep-derive-app ep ((ep.ep-transcript) & tls13-msg-transcript dtls-hs-finished sfin)
    in DtlsEpStep { es-ep = ep2, es-out = o3 }

  dtls-ep-server-transcript : DtlsEp, DtlsMsg, List Integer, List Integer, List Integer -> List Integer
  dtls-ep-server-transcript (ep) (m) (sh-body) (cookie) (ch1-hash) =
    let hrr = tls13-msg-transcript dtls-hs-server-hello (dtls-hrr-body [] cookie)
    in let ch2 = tls13-msg-transcript dtls-hs-client-hello (m.dm-body)
    in let sh = tls13-msg-transcript dtls-hs-server-hello sh-body
    in tls13-transcript-after-hrr-hash ch1-hash & hrr & ch2 & sh

  dtls-ep-server-emit : DtlsEp, List Integer, List Integer -> DtlsEpStep
  dtls-ep-server-emit (ep) (sh-body) (th) =
    let sfin = tls13-verify-data (ep.ep-s-hs) th
    in let o0 = dtls-ep-wrap-into ep [] dtls-hs-server-hello 0 sh-body
    in let o1 = dtls-ep-seal-into (dtls-ep-keys (ep.ep-s-hs)) o0 0 dtls-hs-finished 1 sfin
    in let ep2 = dtls-ep-derive-app ep ((ep.ep-transcript) & tls13-msg-transcript dtls-hs-finished sfin)
    in DtlsEpStep { es-ep = ep2, es-out = o1 }

  dtls-ep-server-fin : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-server-fin (ep) (m) =
    let th = tls13-transcript-hash (ep.ep-transcript)
    in if tls13-finished-ok (ep.ep-c-hs) th (m.dm-body)
    then DtlsEpStep { es-ep = __record-set ep "ep-done" True, es-out = [] }
    else dtls-ep-idle ep

Section: Client Receive

  dtls-ep-client-msg : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-client-msg (ep) (m) (now) =
    if m.dm-type /= dtls-hs-server-hello then dtls-ep-client-other ep m
    else if dtls-is-hrr (m.dm-body) then dtls-ep-client-hrr ep m now
    else dtls-ep-client-sh ep m

  dtls-ep-client-hrr : DtlsEp, DtlsMsg, Integer -> DtlsEpStep
  dtls-ep-client-hrr (ep) (m) (now) =
    when dtls-hrr-cookie (m.dm-body)
      is None -> dtls-ep-idle ep
      is Just (c) -> dtls-ep-client-ch2 ep m c now

  dtls-ep-client-ch2 : DtlsEp, DtlsMsg, List Integer, Integer -> DtlsEpStep
  dtls-ep-client-ch2 (ep) (m) (cookie) (now) =
    let r = dtls-hs-step (ep.ep-hs) (EvHelloRetry cookie now)
    in let body = dtls-client-hello-body (dtls-ep-random ep) [] (ep.ep-pub) cookie
    in let hrr = tls13-msg-transcript dtls-hs-server-hello (m.dm-body)
    in let ch2 = tls13-msg-transcript dtls-hs-client-hello body
    in let tr = tls13-transcript-after-hrr (ep.ep-ch1) & hrr & ch2
    in let ep2 = __record-set (__record-set ep "ep-hs" (r.step-state)) "ep-transcript" tr
    in DtlsEpStep { es-ep = ep2, es-out = dtls-ep-wrap-into ep2 [] dtls-hs-client-hello 1 body }

  dtls-ep-client-sh : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-sh (ep) (m) =
    when dtls-sh-key-share (m.dm-body)
      is None -> dtls-ep-idle ep
      is Just (peer) -> dtls-ep-client-keys ep m peer

  dtls-ep-client-keys : DtlsEp, DtlsMsg, List Integer -> DtlsEpStep
  dtls-ep-client-keys (ep) (m) (peer) =
    let tr = (ep.ep-transcript) & tls13-msg-transcript dtls-hs-server-hello (m.dm-body)
    in let shared = x25519-shared-secret (ep.ep-priv) peer
    in let hs = tls13-handshake-secret shared
    in let th = tls13-transcript-hash tr
    in DtlsEpStep { es-ep = dtls-ep-with-keys ep peer hs tr (tls13-client-hs-traffic hs th) (tls13-server-hs-traffic hs th), es-out = [] }

  dtls-ep-client-other : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-other (ep) (m) =
    if m.dm-type == dtls-hs-certificate then dtls-ep-client-cert ep m
    else if m.dm-type == dtls-hs-cert-verify then dtls-ep-client-cv ep m
    else if m.dm-type == dtls-hs-finished then dtls-ep-client-fin ep m
    else dtls-ep-idle ep

  dtls-ep-client-cert : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-cert (ep) (m) =
    dtls-ep-fold (dtls-ep-cert-peer-key ep m) m

  dtls-ep-fold : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-fold (ep) (m) =
    DtlsEpStep { es-ep = __record-set ep "ep-transcript" ((ep.ep-transcript) & dtls-msg-to-transcript m), es-out = [] }

  dtls-ep-cert-peer-key : DtlsEp, DtlsMsg -> DtlsEp
  dtls-ep-cert-peer-key (ep) (m) =
    when tls-cert-parse (m.dm-body)
      is None -> ep
      is Just (ders) -> dtls-ep-cert-parse-chain ep ders

  dtls-ep-cert-parse-chain : DtlsEp, List (List Integer) -> DtlsEp
  dtls-ep-cert-parse-chain (ep) (ders) =
    when dtls-ep-parse-chain ders
      is None -> ep
      is Just (certs) -> dtls-ep-cert-key-walk ep certs

  dtls-ep-cert-key-walk : DtlsEp, List X509Cert -> DtlsEp
  dtls-ep-cert-key-walk (ep) (certs) =
    when x509-verify-peer certs (ep.ep-anchors) (ep.ep-cal-now) (ep.ep-expected-peer)
      is ChainOk -> __record-set ep "ep-peer-key" ((list-at certs 0).xc-key)
      is otherwise -> ep

  dtls-ep-client-cv : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-cv (ep) (m) =
    let ok = tls-cv-verify True (ep.ep-peer-key) (m.dm-body) (tls13-transcript-hash (ep.ep-transcript))
    in dtls-ep-fold (__record-set ep "ep-auth-done" ok) m

 The server's Finished. Verify it, then send ours. A client that sends
 its Finished before checking the server's has authenticated nothing and
 announced its own key confirmation to an attacker.

  dtls-ep-client-fin : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-fin (ep) (m) =
    if dtls-ep-auth-missing ep then dtls-ep-idle ep
    else dtls-ep-client-fin-check ep m

  dtls-ep-client-fin-check : DtlsEp, DtlsMsg -> DtlsEpStep
  dtls-ep-client-fin-check (ep) (m) =
    let th = tls13-transcript-hash (ep.ep-transcript)
    in if tls13-finished-ok (ep.ep-s-hs) th (m.dm-body) == False then dtls-ep-idle ep
    else dtls-ep-client-send-fin (dtls-ep-derive-app ep ((ep.ep-transcript) & tls13-msg-transcript dtls-hs-finished (m.dm-body)))

  dtls-ep-auth-missing : DtlsEp -> Boolean
  dtls-ep-auth-missing (ep) =
    if list-length (ep.ep-anchors) == 0 then False
    else ep.ep-auth-done == False

  dtls-ep-parse-chain : List (List Integer) -> Maybe (List X509Cert)
  dtls-ep-parse-chain (ders) = dtls-ep-parse-loop ders 0 []

  dtls-ep-parse-loop : List (List Integer), Integer, List X509Cert -> Maybe (List X509Cert)
  dtls-ep-parse-loop (ders) (i) (acc) =
    if i >= list-length ders then Just acc
    else dtls-ep-parse-one ders i acc

  dtls-ep-parse-one : List (List Integer), Integer, List X509Cert -> Maybe (List X509Cert)
  dtls-ep-parse-one (ders) (i) (acc) =
    when x509-parse (list-at ders i)
      is None -> None
      is Just (c) -> dtls-ep-parse-loop ders (i + 1) (list-push acc c)

  dtls-ep-client-send-fin : DtlsEp -> DtlsEpStep
  dtls-ep-client-send-fin (ep) =
    let th = tls13-transcript-hash (ep.ep-transcript)
    in DtlsEpStep { es-ep = __record-set ep "ep-done" True,
                    es-out = dtls-ep-seal-into (dtls-ep-keys (ep.ep-c-hs)) [] 0 dtls-hs-finished 2 (tls13-verify-data (ep.ep-c-hs) th) }

Section: Application Data

 The handshake stops at the handshake traffic secrets. This derives the
 master secret and the two APPLICATION traffic secrets over the transcript
 THROUGH the server Finished -- the same hash both Finished messages are
 computed over, so client and server land on identical secrets -- and every
 record after that travels as DTLS 1.3 ciphertext (RFC 9147 section 4):
 sealed and opened by the Dtls chapter's dtls-seal / dtls-open, which carry
 the unified header, the per-record AEAD nonce, and the mandatory sequence
 number encryption. The inner content type is application_data (23) and the
 epoch is 3.

 The key schedule here is the generic TLS 1.3 one (tls13-master-secret and
 the ap-traffic secrets), the same primitives TlsEndpoint drives and the
 same ones the RFC 8448 vectors gate; the record protection is the DTLS
 record layer, gated by codex/test/dtls-record against an independent
 implementation. What has no oracle is the assembled handshake: no
 third-party DTLS peer is in the loop, so the whole exchange -- key
 agreement and, since the handshake epoch went protected, the flights too --
 is proven only between our own endpoints. An openssl DTLS 1.3 peer would
 turn that from a loopback into interop; until then, do not describe this as
 coaps:// on the open internet.

  dtls-ep-app-cap : Integer = 262144
  dtls-ep-hs-epoch : Integer = 2
  dtls-ep-app-epoch : Integer = 3
  dtls-ep-content-app : Integer = 23

  dtls-ep-derive-app : DtlsEp, List Integer -> DtlsEp
  dtls-ep-derive-app (ep) (tr) =
    let th = tls13-transcript-hash tr
    in let master = tls13-master-secret (ep.ep-hs-secret)
    in let c-ap = tls13-client-ap-traffic master th
    in let s-ap = tls13-server-ap-traffic master th
    in let e1 = __record-set (__record-set (__record-set ep "ep-transcript" tr) "ep-c-ap" c-ap) "ep-s-ap" s-ap
    in __record-set e1 "ep-app-in" (__list-with-capacity dtls-ep-app-cap)

 A traffic secret is not a key. The write key, IV and the sequence-number
 encryption key are each expanded out of it -- the sn-key over the "sn"
 label per RFC 9147 section 4.2.3. The same builder serves both the
 handshake epoch (over c-hs / s-hs) and the application epoch (over
 c-ap / s-ap); the epoch is keyed, so each derives its own distinct key.

  dtls-ep-keys : List Integer -> DtlsKeys
  dtls-ep-keys (secret) =
    DtlsKeys { dk-key = tls13-traffic-key secret, dk-iv = tls13-traffic-iv secret, dk-sn-key = dtls-sn-key secret 16 }

  dtls-ep-seal-hs : DtlsKeys, Integer, List Integer -> List Integer
  dtls-ep-seal-hs (k) (seq) (msg) =
    dtls-seal k dtls-ep-hs-epoch seq msg dtls-content-handshake

  dtls-ep-send-app : DtlsEp, List Integer -> DtlsEpStep
  dtls-ep-send-app (ep) (data) =
    let secret = if ep.ep-server then ep.ep-s-ap else ep.ep-c-ap
    in let rec = dtls-seal (dtls-ep-keys secret) dtls-ep-app-epoch (ep.ep-app-write-seq) data dtls-ep-content-app
    in DtlsEpStep { es-ep = __record-set ep "ep-app-write-seq" (ep.ep-app-write-seq + 1), es-out = [rec] }

  dtls-ep-recv-app : DtlsEp, List Integer -> DtlsEpStep
  dtls-ep-recv-app (ep) (rec) =
    let secret = if ep.ep-server then ep.ep-c-ap else ep.ep-s-ap
    in when dtls-open (dtls-ep-keys secret) 0 rec
      is None -> dtls-ep-idle ep
      is Just (p) -> DtlsEpStep { es-ep = dtls-ep-app-accept ep p, es-out = [] }

  dtls-ep-app-accept : DtlsEp, DtlsPlain -> DtlsEp
  dtls-ep-app-accept (ep) (p) =
    let e1 = __record-set ep "ep-app-read-seq" (ep.ep-app-read-seq + 1)
    in if p.dp-type == dtls-ep-content-app
    then __record-set e1 "ep-app-in" (dtls-ep-append (ep.ep-app-in) (p.dp-content) 0 (list-length (p.dp-content)))
    else e1

 Application data accumulates into ONE list, reserved to capacity at the
 handshake's end and pushed into in place, the discipline TlsEndpoint uses:
 the obvious per-record append copies the whole buffer every record and, on
 a heap with no collector, leaves every intermediate copy live. A body past
 the cap stops growing rather than reallocating.

  dtls-ep-append : List Integer, List Integer, Integer, Integer -> List Integer
  dtls-ep-append (dst) (src) (i) (n) =
    if i >= n then dst
    else if list-length dst >= dtls-ep-app-cap then dst
    else dtls-ep-append (list-push dst (list-at src i)) src (i + 1) n

  dtls-ep-app-in : DtlsEp -> List Integer
  dtls-ep-app-in (ep) = ep.ep-app-in

Section: Fragmentation

 UDP does not split a datagram that is too large for the path; the path
 drops it. So a handshake message past the path's limit either goes out in
 pieces or it never arrives at all, and the failure is a handshake that
 stalls with nothing to report. The Certificate message is the one that
 reaches that size in practice: two Ed25519 certificates and their framing
 already pass a kilobyte.

 1200 is not a measurement of this path. An endpoint with no clock, no
 ICMP and no socket cannot make one, and RFC 9147 section 4.4 leaves the
 number to the implementation. It is the value chosen so that no path has
 to be measured: 1200 bytes of UDP payload under a 40-byte IPv6 header and
 an 8-byte UDP header is 1248, inside the 1280 every IPv6 link is required
 to carry (RFC 8200 section 5), and far inside Ethernet's 1500. QUIC fixed
 on 1200 for the same reason (RFC 9000 section 14.1).

  dtls-ep-mtu : Integer = 1200

 The body limit is the MTU less the worst framing we emit. A sealed record
 costs 5 bytes of unified header, one inner content-type byte and a 16-byte
 tag; the handshake message header is 12 more; 34 in all. 1024 leaves 142
 bytes of slack against that, which is what lets an outer tunnel appear
 without this constant having to be re-derived, and it keeps a fragment
 boundary on a round number when reading a capture.

  dtls-ep-frag-body : Integer = 1024

 Each fragment is its own record and needs its own record sequence number,
 which is why these thread the output accumulated so far rather than
 returning a fresh list: a sealed record's sequence number is exactly how
 many sealed records already precede it in this flight.

  dtls-ep-wrap-into : DtlsEp, List (List Integer), Integer, Integer, List Integer -> List (List Integer)
  dtls-ep-wrap-into (ep) (acc) (msg-type) (msg-seq) (body) =
    dtls-ep-plain-loop (dtls-msg-fragments msg-type msg-seq body dtls-ep-frag-body) (ep.ep-send-seq) 0 acc

  dtls-ep-plain-loop : List (List Integer), Integer, Integer, List (List Integer) -> List (List Integer)
  dtls-ep-plain-loop (fs) (base) (i) (acc) =
    if i >= list-length fs then acc
    else dtls-ep-plain-loop fs base (i + 1) (list-push acc (dtls-plain-encode dtls-content-handshake 0 (base + i) (list-at fs i)))

  dtls-ep-seal-into : DtlsKeys, List (List Integer), Integer, Integer, Integer, List Integer -> List (List Integer)
  dtls-ep-seal-into (k) (acc) (rec-seq) (msg-type) (msg-seq) (body) =
    dtls-ep-seal-loop k (dtls-msg-fragments msg-type msg-seq body dtls-ep-frag-body) rec-seq 0 acc

  dtls-ep-seal-loop : DtlsKeys, List (List Integer), Integer, Integer, List (List Integer) -> List (List Integer)
  dtls-ep-seal-loop (k) (fs) (base) (i) (acc) =
    if i >= list-length fs then acc
    else dtls-ep-seal-loop k fs base (i + 1) (list-push acc (dtls-ep-seal-hs k (base + i) (list-at fs i)))

Section: Helpers

  dtls-ep-with-keys : DtlsEp, List Integer, List Integer, List Integer, List Integer, List Integer -> DtlsEp
  dtls-ep-with-keys (ep) (peer) (hs) (tr) (c) (s) =
    __record-set (__record-set (__record-set (__record-set (__record-set ep "ep-peer-pub" peer) "ep-hs-secret" hs) "ep-transcript" tr) "ep-c-hs" c) "ep-s-hs" s

  dtls-ep-idle : DtlsEp -> DtlsEpStep
  dtls-ep-idle (ep) = DtlsEpStep { es-ep = ep, es-out = [] }

  dtls-ep-done : DtlsEp -> Boolean
  dtls-ep-done (ep) = ep.ep-done

  dtls-ep-authenticated : DtlsEp -> Boolean
  dtls-ep-authenticated (ep) = ep.ep-auth-done

  dtls-take-at : List Integer, Integer, Integer -> List Integer
  dtls-take-at (bs) (off) (n) = dtls-ep-take-loop bs off n 0 []

  dtls-ep-take-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  dtls-ep-take-loop (bs) (off) (n) (i) (acc) =
    if i >= n then acc
    else if off + i >= list-length bs then acc
    else dtls-ep-take-loop bs off n (i + 1) (list-push acc (list-at bs (off + i)))
