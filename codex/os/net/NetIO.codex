Chapter: NetIO
  cites Net chapter NetDriver
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Net chapter NetCompact
  cites Net chapter MessageFraming
  cites Foreword chapter CCE

 The __heap-save / __heap-restore pairs are load-bearing and are why
 the effectful binds sit INSIDE an act while the save stays a pure let
 OUTSIDE it. Each of these loops polls up to fifty million times. The
 frame lands in one list allocated before the first mark and reused, so a
 poll allocates no frame; the restore reclaims whatever else a miss built.
 Each recursive call is also still a SELF tail call for the same
 reason: splitting one of these loops into a mutually-recursive helper
 would leave fifty million frames on a stack that has no guard page.

Section: The Poll Clock

 A tick is a count of empty polls whose rate NetDriver measures at bring-up.
 Give up takes at most 288 ticks: net-rto-max-tries is 5
 and every backoff interval is clamped at net-rto-max-ticks 48, so 48 for
 the first interval and 48 for each of the five retries. The fuel cap has
 to sit above that ladder or a loop waiting on a peer that has gone away
 ends by FUEL, which returns exactly what an ordinary timeout returns,
 instead of by give-up, which sets TcpClosed and says so. Expressing the
 cap in ticks is what keeps that true at any measured rate.

  net-io-max-ticks : Integer = 500

  net-io-tick-interval : Integer
  net-io-tick-interval = net-driver-poll-interval

  net-io-max-polls : Integer
  net-io-max-polls = net-io-tick-interval * net-io-max-ticks

 The drain is entered once per 1400-byte chunk and waits for room in the
 retransmit queue, not for the peer, so its cap sits BELOW the 288-tick
 give-up ladder: at 288 a stalled peer costs 28.8 s per chunk. 96 is two
 clamped RTO intervals (`net-rto-max-ticks` 48), so a slow peer still gets two
 retransmit cycles; `codex/test/net-drain-budget` fails if either number
 crosses the ladder.

  net-io-drain-ticks : Integer = 96

  net-io-drain-polls : Integer
  net-io-drain-polls = net-io-tick-interval * net-io-drain-ticks

  net-io-conn-closed : TcpTransportState -> Boolean
  net-io-conn-closed (ts) = when ((ts.session).conn).state
    is TcpClosed -> True
    is otherwise -> False

 The peer has sent its FIN (RFC 9293 section 3.10.7.4), so no more data can
 arrive and a receive is at end of stream. A send may still proceed.

  net-io-peer-finished : TcpTransportState -> Boolean
  net-io-peer-finished (ts) = when ((ts.session).conn).state
    is TcpCloseWait -> True
    is TcpLastAck -> True
    is TcpTimeWait -> True
    is TcpClosed -> True
    is otherwise -> False

Section: Flush Outbox

  flush-outbox-loop : NetSession, Integer, Integer -> [Network.Write] Integer
  flush-outbox-loop (sess) (i) (count) =
   if i >= count then 0
   else let frame = net-outbox-frame sess i
   in act
    sent <- net-driver-send-frame frame
    rest <- flush-outbox-loop sess (i + 1) count
    sent + rest
   end

  flush-transport-outbox : TcpTransportState -> [Network.Write] TcpTransportState
  flush-transport-outbox (ts) =
   let count = net-outbox-count (ts.session)
   in act
    flushed <- flush-outbox-loop (ts.session) 0 count
    let cleared = set-outbox (ts.session) []
    in transport-set-session ts (cleared)
   end

Section: Listen and Accept

  net-io-listen : TcpTransportState -> TcpTransportState
  net-io-listen (ts) =
   let r = net-listen (ts.session)
   in transport-set-session ts (r.session)

  net-io-accept : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-accept (ts) (tries) = net-io-accept-rx ts tries [] 0

  net-io-rx : List Integer -> List Integer
  net-io-rx (rx) = if list-length rx == 0 then net-driver-frame-buffer net-driver-frame-cap else rx

  net-io-accept-rx : TcpTransportState, Integer, List Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-accept-rx (ts) (tries) (rx) (mark) =
   if list-length rx == 0 & transport-stale ts then ts
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-accept-rx ta tries rx1 m
   else if tries > net-io-max-polls then ts
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-accept-rx ts (tries + 1) rx mark
    else let r = transport-process-frame-within ts rx n
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-accept-rx (transport-compact-past ts1 mark) (tries + 1) rx mark
    end
   end

Section: Resolve The Next Hop

  net-io-resolve : TcpTransportState, List Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-resolve (ts) (target) = net-io-resolve-hop ts target 0 net-io-tick-interval [] 0

  net-io-resolve-hop : TcpTransportState, List Integer, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-resolve-hop (ts) (target) (tries) (since) (rx) (mark) =
   if net-arp-known (ts.session) target then ts
   else if list-length rx == 0 & transport-stale ts then ts
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-resolve-hop ta target tries since rx1 m
   else if tries > net-io-max-polls then ts
   else if since >= net-io-tick-interval then act
     ts1 <- flush-transport-outbox (transport-set-session ts (net-arp-solicit (ts.session) target))
     net-io-resolve-hop (transport-compact-past ts1 mark) target (tries + 1) 0 rx mark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-resolve-hop ts target (tries + 1) (since + 1) rx mark
    else let r = net-process-frame-within (ts.session) rx n
    in act
      ts1 <- flush-transport-outbox (transport-set-session ts (r.session))
      net-io-resolve-hop (transport-compact-past ts1 mark) target (tries + 1) (since + 1) rx mark
    end
   end

Section: Connect and Wait

  net-io-connect : TcpTransportState -> [Network.Read, Network.Write] TcpTransportState
  net-io-connect (ts) =
   let ts1 = transport-connect ts
   in act
    ts2 <- flush-transport-outbox ts1
    net-io-wait-established ts2 0
   end

  net-io-wait-established : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-wait-established (ts) (tries) = net-io-wait-established-poll ts tries 0 [] 0

  net-io-wait-established-poll : TcpTransportState, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-wait-established-poll (ts) (tries) (since) (rx) (mark) =
   if list-length rx == 0 & transport-stale ts then ts
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-wait-established-poll ta tries since rx1 m
   else if tries > net-io-max-polls then ts
   else if net-io-conn-closed ts then ts
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-wait-established-poll (transport-compact-past ticked mark) (tries + 1) 0 rx mark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-wait-established-poll ts (tries + 1) (since + 1) rx mark
    else let r = transport-process-frame-within ts rx n
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-wait-established-poll (transport-compact-past ts1 mark) (tries + 1) (since + 1) rx mark
    end
   end

Section: Send

  net-mss : Integer = 1400

  net-io-send-drain : TcpTransportState, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-drain (ts) (tries) (since) = net-io-send-drain-rx ts tries since [] 0

  net-io-send-drain-rx : TcpTransportState, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-drain-rx (ts) (tries) (since) (rx) (mark) =
   if tries > net-io-drain-polls then ts
   else if net-rexmit-full (ts.session) == False then ts
   else if net-io-conn-closed ts then ts
   else if list-length rx == 0 & transport-stale ts then ts
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-send-drain-rx ta tries since rx1 m
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-send-drain-rx (transport-compact-past ticked mark) (tries + 1) 0 rx mark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-send-drain-rx ts (tries + 1) (since + 1) rx mark
    else let r = net-process-frame-within (ts.session) rx n
    in let fed = transport-feed-range ts (r.session) (r.data) (r.data-off) (r.data-stop)
    in act
      ts1 <- flush-transport-outbox fed
      net-io-send-drain-rx (transport-compact-past ts1 mark) (tries + 1) (since + 1) rx mark
    end
   end

  net-io-send-chunk : TcpTransportState, List Integer, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-chunk (ts) (data) (off) (total) =
   if off >= total then ts
   else let stop = if off + net-mss > total then total else off + net-mss
   in let chunk = transport-slice data off stop
   in act
    tsd <- net-io-send-drain ts 0 0
    if net-rexmit-full (tsd.session) then tsd
    else if net-io-conn-closed tsd then tsd
    else let r = net-send (tsd.session) chunk
    in let ts1 = transport-set-session tsd (r.session)
    in act
      ts2 <- flush-transport-outbox ts1
      net-io-send-chunk ts2 data (off + net-mss) total
    end
   end

  net-io-send : TcpTransportState, Integer, List Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send (ts) (tag) (body) =
   let framed = frame-encode tag body
   in net-io-send-chunk ts framed 0 (list-length framed)

  net-io-send-raw : TcpTransportState, List Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-raw (ts) (data) = net-io-send-chunk ts data 0 (list-length data)

Section: Send, Checked

 The stop at a refused chunk is not the defect and must not be removed:
 stopping costs one slice where walking the rest of the buffer cost 593,152
 bytes of them against 16,400, measured 2026-08-10 and pinned by
 `arm64-send-refusal`. The ceiling a caller runs into is arithmetic --
 `net-rexmit-capacity` segments of `net-mss` bytes, 11,200 on today's
 constants -- so a send above it stops at exactly the same offset every run.

  NetSendResult = record {
    ns-transport : TcpTransportState,
    ns-sent : Integer,
    ns-complete : Boolean
  }

  net-io-send-chunk-checked : TcpTransportState, List Integer, Integer, Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-chunk-checked (ts) (data) (off) (total) =
   if off >= total then NetSendResult { ns-transport = ts, ns-sent = total, ns-complete = True }
   else let stop = if off + net-mss > total then total else off + net-mss
   in let chunk = transport-slice data off stop
   in act
    tsd <- net-io-send-drain ts 0 0
    if net-rexmit-full (tsd.session) then NetSendResult { ns-transport = tsd, ns-sent = off, ns-complete = False }
    else if net-io-conn-closed tsd then NetSendResult { ns-transport = tsd, ns-sent = off, ns-complete = False }
    else let r = net-send (tsd.session) chunk
    in let ts1 = transport-set-session tsd (r.session)
    in if net-outbox-count (r.session) == 0 then NetSendResult { ns-transport = ts1, ns-sent = off, ns-complete = False }
    else act
      ts2 <- flush-transport-outbox ts1
      net-io-send-chunk-checked ts2 data (off + net-mss) total
    end
   end

  net-io-send-checked : TcpTransportState, Integer, List Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-checked (ts) (tag) (body) =
   let framed = frame-encode tag body
   in net-io-send-chunk-checked ts framed 0 (list-length framed)

  net-io-send-raw-checked : TcpTransportState, List Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-raw-checked (ts) (data) = net-io-send-chunk-checked ts data 0 (list-length data)

Section: Sending Text

 The conversion is the I/O boundary, so it goes through `to-unicode`:
 Codex Text is CCE internally and `char-code` answers the CCE point, not
 the ASCII one. Sending the CCE bytes does not error -- the far end simply
 reads something else -- which is the failure this project has already paid
 for twice (a TLS SNI hostname and every key-schedule label).

  text-to-bytes-chunk : Text, Integer, Integer, List Integer -> List Integer
  text-to-bytes-chunk (s) (i) (stop) (acc) =
   if i >= stop then acc
   else text-to-bytes-chunk s (i + 1) stop (list-push acc (to-unicode (char-code (char-at s i))))

  net-io-send-text-loop : TcpTransportState, Text, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-text-loop (ts) (t) (off) (len) =
   if off >= len then ts
   else let stop = if off + net-mss > len then len else off + net-mss
   in let chunk = text-to-bytes-chunk t off stop []
   in net-io-send-text-loop (net-io-send-chunk ts chunk 0 (list-length chunk)) t stop len

  net-io-send-text : TcpTransportState, Text -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-text (ts) (t) = net-io-send-text-loop ts t 0 (text-length t)

  net-io-send-text-loop-checked : TcpTransportState, Text, Integer, Integer, Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-text-loop-checked (ts) (t) (off) (len) (sent) =
   if off >= len then NetSendResult { ns-transport = ts, ns-sent = sent, ns-complete = True }
   else let stop = if off + net-mss > len then len else off + net-mss
   in let chunk = text-to-bytes-chunk t off stop []
   in act
    r <- net-io-send-chunk-checked ts chunk 0 (list-length chunk)
    if r.ns-complete then net-io-send-text-loop-checked (r.ns-transport) t stop len (sent + (r.ns-sent))
    else NetSendResult { ns-transport = r.ns-transport, ns-sent = sent + (r.ns-sent), ns-complete = False }
   end

  net-io-send-text-checked : TcpTransportState, Text -> [Network.Read, Network.Write] NetSendResult
  net-io-send-text-checked (ts) (t) = net-io-send-text-loop-checked ts t 0 (text-length t) 0

Section: Receive

 The check is at ENTRY and not inside the wait, deliberately. `transport-try-recv`
 scans the buffer, and the wait below runs to a fifty-million-try fuel cap;
 rescanning per iteration would put a buffer walk inside the hottest loop in the
 stack for no gain, because nothing new can arrive except through a frame.

  net-io-recv-loop : TcpTransportState, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-loop (ts) (tries) =
   let pending = transport-try-recv ts
   in if pending.has-message then pending
   else net-io-recv-wait (pending.transport) tries 0 [] 0

  net-io-recv-wait : TcpTransportState, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-wait (ts) (tries) (since) (rx) (mark) =
   if list-length rx == 0 & transport-stale ts then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-recv-wait ta tries since rx1 m
   else if tries > net-io-max-polls then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if net-io-peer-finished ts then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-recv-wait (transport-compact-past ticked mark) (tries + 1) 0 rx mark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-recv-wait ts (tries + 1) (since + 1) rx mark
    else let r = transport-process-frame-within ts rx n
    in act
      ts1 <- flush-transport-outbox (r.transport)
      if r.has-message then TransportRecvResult { transport = ts1, tag = r.tag, body = r.body, has-message = True }
      else net-io-recv-wait (transport-compact-past ts1 mark) (tries + 1) (since + 1) rx mark
    end
   end

Section: Receive Parked

 An empty poll here parks the core in `cpu-park` until the next interrupt,
 therefore a count of polls no longer measures time. A net tick is credited
 from HPET instead, one per `net-driver-tick-ms`, and the wait still ends at
 `net-io-max-ticks`; `net-io-max-polls` stays as the fuel for a counter that
 does not advance. A zero HPET rate falls back to the spinning wait. `hlt`
 faults in user mode, therefore no hosted program may reach this wait.

  net-io-recv-idle : TcpTransportState -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-idle (ts) =
   let pending = transport-try-recv ts
   in if pending.has-message then pending
   else let started = hpet-start
   in let per-tick = (hpet-ticks-per-second * net-driver-tick-ms) / 1000
   in if per-tick <= 0 then net-io-recv-wait (pending.transport) 0 0 [] 0
   else net-io-recv-parked (pending.transport) per-tick 0 0 hpet-ticks [] 0

  net-io-recv-parked : TcpTransportState, Integer, Integer, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-parked (ts) (per-tick) (ticks) (tries) (mark) (rx) (hmark) =
   if list-length rx == 0 & transport-stale ts then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-recv-parked ta per-tick ticks tries mark rx1 m
   else if ticks > net-io-max-ticks then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if tries > net-io-max-polls then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if net-io-peer-finished ts then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if hpet-ticks - mark >= per-tick then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-recv-parked (transport-compact-past ticked hmark) per-tick (ticks + 1) (tries + 1) (mark + per-tick) rx hmark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in let parked = cpu-park
      in net-io-recv-parked ts per-tick ticks (tries + 1) (mark + parked) rx hmark
    else let r = transport-process-frame-within ts rx n
    in act
      ts1 <- flush-transport-outbox (r.transport)
      if r.has-message then TransportRecvResult { transport = ts1, tag = r.tag, body = r.body, has-message = True }
      else net-io-recv-parked (transport-compact-past ts1 hmark) per-tick ticks (tries + 1) mark rx hmark
    end
   end

Section: Receive Raw (no framing)

  RawRecvResult = record {
    transport : TcpTransportState,
    data : List Integer,
    has-data : Boolean
  }

  net-io-recv-raw : TcpTransportState, Integer -> [Network.Read, Network.Write] RawRecvResult
  net-io-recv-raw (ts) (tries) = net-io-recv-raw-poll ts tries 0 [] 0

  net-io-recv-raw-poll : TcpTransportState, Integer, Integer, List Integer, Integer -> [Network.Read, Network.Write] RawRecvResult
  net-io-recv-raw-poll (ts) (tries) (since) (rx) (mark) =
   if list-length rx == 0 & transport-stale ts then RawRecvResult { transport = ts, data = [], has-data = False }
   else if list-length rx == 0 then let ta = transport-arenas ts
     in let rx1 = net-io-rx rx
     in let m = __heap-save
     in net-io-recv-raw-poll ta tries since rx1 m
   else if tries > net-io-max-polls then RawRecvResult { transport = ts, data = [], has-data = False }
   else if net-io-peer-finished ts then RawRecvResult { transport = ts, data = [], has-data = False }
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-recv-raw-poll (transport-compact-past ticked mark) (tries + 1) 0 rx mark
   end
   else let hp = __heap-save
   in act
    n <- net-driver-recv-into rx
    if n == 0 then let restored = __heap-restore hp
      in net-io-recv-raw-poll ts (tries + 1) (since + 1) rx mark
    else let r = net-process-frame-within (ts.session) rx n
    in act
      ts1 <- flush-transport-outbox (transport-set-session ts (r.session))
      if (r.data-stop - r.data-off) > 0 then RawRecvResult { transport = ts1, data = transport-slice (r.data) (r.data-off) (r.data-stop), has-data = True }
      else net-io-recv-raw-poll (transport-compact-past ts1 mark) (tries + 1) (since + 1) rx mark
    end
   end

Section: Poll One

  net-io-poll-one : TcpTransportState, Integer -> [Network.Read] List Integer
  net-io-poll-one (ts) (tries) =
   if tries > 5000000 then []
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame > 0 then frame
    else let restored = __heap-restore hp
      in net-io-poll-one ts (tries + 1)
   end

Section: Close

  net-io-close : TcpTransportState -> [Network.Write] TcpTransportState
  net-io-close (ts) =
   let ts1 = transport-close ts
   in act
    ts2 <- flush-transport-outbox ts1
    transport-release ts2
   end

Page 1
