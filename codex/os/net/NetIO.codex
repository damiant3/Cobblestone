Chapter: NetIO
  cites Net chapter NetDriver
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Net chapter MessageFraming
  cites Foreword chapter CCE

 This is the layer where the frames stop being data and start being
 traffic, so this is the layer that declares Network.Read and
 Network.Write. Everything below it (NetworkStack, TcpTransport,
 MessageFraming) only builds and parses bytes and stays pure;
 everything above it inherits these rows and must declare them, which
 is what earns a program cap-network-read and cap-network-write at
 boot. Until 2026-07-13 the NIC intrinsics were typed pure and gated
 by nothing, so this whole file was effect-free and said so.

 The __heap-save / __heap-restore pairs are load-bearing and are why
 the effectful binds sit INSIDE an act while the save stays a pure let
 OUTSIDE it. Each of these loops polls up to fifty million times, and
 net-driver-recv-frame allocates a list on every miss. Without the restore
 the bump allocator would walk the whole arena in a single accept.
 Each recursive call is also still a SELF tail call for the same
 reason: splitting one of these loops into a mutually-recursive helper
 would leave fifty million frames on a stack that has no guard page.

Section: The Poll Clock

 A tick here is a count of empty polls and not a duration, because this
 layer has no clock. How many polls that count should be is a question
 about the DRIVER underneath, so NetDriver answers it: it measures the rate
 once at bring-up and NetIO reads the answer. A guest that never brings the
 driver up reads NetDriver's fallback, which is the 100000 this line held
 until 2026-08-14, so nothing that was tuned against the NE2000 moves.

 Both numbers were wall-clock constants wearing tick clothing, and both had
 to move together. Give up takes at most 288 ticks: net-rto-max-tries is 5
 and every backoff interval is clamped at net-rto-max-ticks 48, so 48 for
 the first interval and 48 for each of the five retries. The fuel cap has
 to sit above that ladder or a loop waiting on a peer that has gone away
 ends by FUEL, which returns exactly what an ordinary timeout returns,
 instead of by give-up, which sets TcpClosed and says so. Expressing the
 cap in ticks is what keeps that true at any measured rate; at the fallback
 interval it is 50,000,000, the literal this line carried before.

  net-io-max-ticks : Integer = 500

  net-io-tick-interval : Integer
  net-io-tick-interval = net-driver-poll-interval

  net-io-max-polls : Integer
  net-io-max-polls = net-io-tick-interval * net-io-max-ticks

  net-io-conn-closed : TcpTransportState -> Boolean
  net-io-conn-closed (ts) = when ((ts.session).conn).state
    is TcpClosed -> True
    is otherwise -> False

Section: Flush Outbox

  flush-outbox-loop : NetSession, Integer, Integer -> [Network.Write] Integer
  flush-outbox-loop (sess) (i) (count) =
   if i >= count then 0
   else let frame = net-outbox-frame sess i
   in act
    sent <- net-driver-send-frame frame
    rest <- flush-outbox-loop sess (i + 1) count
    sent + rest
   end

  flush-transport-outbox : TcpTransportState -> [Network.Write] TcpTransportState
  flush-transport-outbox (ts) =
   let count = net-outbox-count (ts.session)
   in act
    flushed <- flush-outbox-loop (ts.session) 0 count
    let cleared = set-outbox (ts.session) []
    in TcpTransportState { session = cleared, recv-buf = [], recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }
   end

Section: Listen and Accept

  net-io-listen : TcpTransportState -> TcpTransportState
  net-io-listen (ts) =
   let r = net-listen (ts.session)
   in TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  net-io-accept : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-accept (ts) (tries) =
   if tries > net-io-max-polls then ts
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-accept ts (tries + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-accept ts1 (tries + 1)
    end
   end

Section: Connect and Wait

  net-io-connect : TcpTransportState -> [Network.Read, Network.Write] TcpTransportState
  net-io-connect (ts) =
   let ts1 = transport-connect ts
   in act
    ts2 <- flush-transport-outbox ts1
    net-io-wait-established ts2 0
   end

  net-io-wait-established : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-wait-established (ts) (tries) = net-io-wait-established-poll ts tries 0

  net-io-wait-established-poll : TcpTransportState, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-wait-established-poll (ts) (tries) (since) =
   if tries > net-io-max-polls then ts
   else if net-io-conn-closed ts then ts
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-wait-established-poll ticked (tries + 1) 0
   end
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-wait-established-poll ts (tries + 1) (since + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-wait-established-poll ts1 (tries + 1) (since + 1)
    end
   end

Section: Send

 net-io-send-chunk rebuilds the transport around the new session, and
 until 2026-07-14 it rebuilt it without recv-base, recv-len or
 recv-cap. A record field that is not named is not written, and __alloc
 zero-fills, so those three came back as zero -- which meant that after
 any send, the receive buffer's base address was 0. The next inbound
 frame fed through transport-feed-raw, which writes with
 __buf-write-bytes (ts.recv-base) ..., so the bytes off the wire landed
 at physical address 0: the IDT and the kernel metadata cells. Send,
 then receive, is the ordinary shape of a request, so the trust
 transport and the DTLS endpoint drove it.

  net-mss : Integer = 1400

  net-io-send-drain : TcpTransportState, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-drain (ts) (tries) (since) =
   if tries > net-io-max-polls then ts
   else if net-rexmit-full (ts.session) == False then ts
   else if net-io-conn-closed ts then ts
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-send-drain ticked (tries + 1) 0
   end
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-send-drain ts (tries + 1) (since + 1)
    else let r = net-process-frame (ts.session) frame
    in let fed = transport-feed-raw (TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }) (r.data)
    in act
      ts1 <- flush-transport-outbox fed
      net-io-send-drain ts1 (tries + 1) (since + 1)
    end
   end

  net-io-send-chunk : TcpTransportState, List Integer, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-chunk (ts) (data) (off) (total) =
   if off >= total then ts
   else let stop = if off + net-mss > total then total else off + net-mss
   in let chunk = transport-slice data off stop
   in act
    tsd <- net-io-send-drain ts 0 0
    if net-rexmit-full (tsd.session) then tsd
    else if net-io-conn-closed tsd then tsd
    else let r = net-send (tsd.session) chunk
    in let ts1 = TcpTransportState { session = r.session, recv-buf = tsd.recv-buf, recv-base = tsd.recv-base, recv-len = tsd.recv-len, recv-cap = tsd.recv-cap, messages-sent = tsd.messages-sent, messages-received = tsd.messages-received }
    in act
      ts2 <- flush-transport-outbox ts1
      net-io-send-chunk ts2 data (off + net-mss) total
    end
   end

  net-io-send : TcpTransportState, Integer, List Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send (ts) (tag) (body) =
   let framed = frame-encode tag body
   in net-io-send-chunk ts framed 0 (list-length framed)

  net-io-send-raw : TcpTransportState, List Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-raw (ts) (data) = net-io-send-chunk ts data 0 (list-length data)

Section: Send, Checked

 Testing the two refusal predicates is NOT enough and the first version of
 this section did only that. `net-send` answers `ActError` and produces no
 frame whenever the state machine declines the write, and in CLOSE_WAIT
 neither `net-rexmit-full` nor `net-io-conn-closed` is true, so a send into a
 half-closed connection passed both guards and dropped its bytes while
 reporting complete. The predicate that holds for every such case is the
 outbox: a non-empty chunk that produced no frame did not go.

 The stop at a refused chunk is not the defect and must not be removed:
 stopping costs one slice where walking the rest of the buffer cost 593,152
 bytes of them against 16,400, measured 2026-08-10 and pinned by
 `arm64-send-refusal`. The ceiling a caller runs into is arithmetic --
 `net-rexmit-capacity` segments of `net-mss` bytes, 11,200 on today's
 constants -- so a send above it stops at exactly the same offset every run.

  NetSendResult = record {
    ns-transport : TcpTransportState,
    ns-sent : Integer,
    ns-complete : Boolean
  }

  net-io-send-chunk-checked : TcpTransportState, List Integer, Integer, Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-chunk-checked (ts) (data) (off) (total) =
   if off >= total then NetSendResult { ns-transport = ts, ns-sent = total, ns-complete = True }
   else let stop = if off + net-mss > total then total else off + net-mss
   in let chunk = transport-slice data off stop
   in act
    tsd <- net-io-send-drain ts 0 0
    if net-rexmit-full (tsd.session) then NetSendResult { ns-transport = tsd, ns-sent = off, ns-complete = False }
    else if net-io-conn-closed tsd then NetSendResult { ns-transport = tsd, ns-sent = off, ns-complete = False }
    else let r = net-send (tsd.session) chunk
    in let ts1 = TcpTransportState { session = r.session, recv-buf = tsd.recv-buf, recv-base = tsd.recv-base, recv-len = tsd.recv-len, recv-cap = tsd.recv-cap, messages-sent = tsd.messages-sent, messages-received = tsd.messages-received }
    in if net-outbox-count (r.session) == 0 then NetSendResult { ns-transport = ts1, ns-sent = off, ns-complete = False }
    else act
      ts2 <- flush-transport-outbox ts1
      net-io-send-chunk-checked ts2 data (off + net-mss) total
    end
   end

  net-io-send-checked : TcpTransportState, Integer, List Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-checked (ts) (tag) (body) =
   let framed = frame-encode tag body
   in net-io-send-chunk-checked ts framed 0 (list-length framed)

  net-io-send-raw-checked : TcpTransportState, List Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-raw-checked (ts) (data) = net-io-send-chunk-checked ts data 0 (list-length data)

Section: Sending Text

 The conversion is the I/O boundary, so it goes through `to-unicode`:
 Codex Text is CCE internally and `char-code` answers the CCE point, not
 the ASCII one. Sending the CCE bytes does not error -- the far end simply
 reads something else -- which is the failure this project has already paid
 for twice (a TLS SNI hostname and every key-schedule label).

  text-to-bytes-chunk : Text, Integer, Integer, List Integer -> List Integer
  text-to-bytes-chunk (s) (i) (stop) (acc) =
   if i >= stop then acc
   else text-to-bytes-chunk s (i + 1) stop (list-push acc (to-unicode (char-code (char-at s i))))

  net-io-send-text-loop : TcpTransportState, Text, Integer, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-text-loop (ts) (t) (off) (len) =
   if off >= len then ts
   else let stop = if off + net-mss > len then len else off + net-mss
   in let chunk = text-to-bytes-chunk t off stop []
   in net-io-send-text-loop (net-io-send-chunk ts chunk 0 (list-length chunk)) t stop len

  net-io-send-text : TcpTransportState, Text -> [Network.Read, Network.Write] TcpTransportState
  net-io-send-text (ts) (t) = net-io-send-text-loop ts t 0 (text-length t)

 `net-io-send-text-loop` advances its offset to `stop` whether or not the
 chunk went out, so a refusal partway through does not end the walk. The
 consequence is worse than the shortfall it was found as: `net-io-send-chunk`
 drains before each chunk, so a queue that frees again resumes sending, and
 the far end is then handed the bytes either side of the refusal with the
 refused ones missing from the middle. The checked loop stops instead.

  net-io-send-text-loop-checked : TcpTransportState, Text, Integer, Integer, Integer -> [Network.Read, Network.Write] NetSendResult
  net-io-send-text-loop-checked (ts) (t) (off) (len) (sent) =
   if off >= len then NetSendResult { ns-transport = ts, ns-sent = sent, ns-complete = True }
   else let stop = if off + net-mss > len then len else off + net-mss
   in let chunk = text-to-bytes-chunk t off stop []
   in act
    r <- net-io-send-chunk-checked ts chunk 0 (list-length chunk)
    if r.ns-complete then net-io-send-text-loop-checked (r.ns-transport) t stop len (sent + (r.ns-sent))
    else NetSendResult { ns-transport = r.ns-transport, ns-sent = sent + (r.ns-sent), ns-complete = False }
   end

  net-io-send-text-checked : TcpTransportState, Text -> [Network.Read, Network.Write] NetSendResult
  net-io-send-text-checked (ts) (t) = net-io-send-text-loop-checked ts t 0 (text-length t) 0

Section: Receive

 The check is at ENTRY and not inside the wait, deliberately. `transport-try-recv`
 scans the buffer, and the wait below runs to a fifty-million-try fuel cap;
 rescanning per iteration would put a buffer walk inside the hottest loop in the
 stack for no gain, because nothing new can arrive except through a frame.

  net-io-recv-loop : TcpTransportState, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-loop (ts) (tries) =
   let pending = transport-try-recv ts
   in if pending.has-message then pending
   else net-io-recv-wait (pending.transport) tries 0

  net-io-recv-wait : TcpTransportState, Integer, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-wait (ts) (tries) (since) =
   if tries > net-io-max-polls then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if net-io-conn-closed ts then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-recv-wait ticked (tries + 1) 0
   end
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-recv-wait ts (tries + 1) (since + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      if r.has-message then TransportRecvResult { transport = ts1, tag = r.tag, body = r.body, has-message = True }
      else net-io-recv-wait ts1 (tries + 1) (since + 1)
    end
   end

Section: Receive Raw (no framing)

  RawRecvResult = record {
    transport : TcpTransportState,
    data : List Integer,
    has-data : Boolean
  }

  net-io-recv-raw : TcpTransportState, Integer -> [Network.Read, Network.Write] RawRecvResult
  net-io-recv-raw (ts) (tries) = net-io-recv-raw-poll ts tries 0

  net-io-recv-raw-poll : TcpTransportState, Integer, Integer -> [Network.Read, Network.Write] RawRecvResult
  net-io-recv-raw-poll (ts) (tries) (since) =
   if tries > net-io-max-polls then RawRecvResult { transport = ts, data = [], has-data = False }
   else if net-io-conn-closed ts then RawRecvResult { transport = ts, data = [], has-data = False }
   else if since >= net-io-tick-interval then act
     ticked <- flush-transport-outbox (transport-tick ts)
     net-io-recv-raw-poll ticked (tries + 1) 0
   end
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-recv-raw-poll ts (tries + 1) (since + 1)
    else let r = net-process-frame (ts.session) frame
    in act
      ts1 <- flush-transport-outbox (TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received })
      if list-length (r.data) > 0 then RawRecvResult { transport = ts1, data = r.data, has-data = True }
      else net-io-recv-raw-poll ts1 (tries + 1) (since + 1)
    end
   end

Section: Poll One

  net-io-poll-one : TcpTransportState, Integer -> [Network.Read] List Integer
  net-io-poll-one (ts) (tries) =
   if tries > 5000000 then []
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame > 0 then frame
    else let restored = __heap-restore hp
      in net-io-poll-one ts (tries + 1)
   end

Section: Close

  net-io-close : TcpTransportState -> [Network.Write] TcpTransportState
  net-io-close (ts) =
   let ts1 = transport-close ts
   in flush-transport-outbox ts1

