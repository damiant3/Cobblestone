Chapter: NetIO
  cites Net chapter NetDriver
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Net chapter MessageFraming
  cites Foreword chapter CCE

 I/O loop binding: flushes outbox frames to the NIC and polls for
 inbound frames. Which NIC is Net chapter NetDriver's question, not
 this one's -- this chapter names no card.

 This is the layer where the frames stop being data and start being
 traffic, so this is the layer that declares Network.Read and
 Network.Write. Everything below it (NetworkStack, TcpTransport,
 MessageFraming) only builds and parses bytes and stays pure;
 everything above it inherits these rows and must declare them, which
 is what earns a program cap-network-read and cap-network-write at
 boot. Until 2026-07-13 the NIC intrinsics were typed pure and gated
 by nothing, so this whole file was effect-free and said so.

 The __heap-save / __heap-restore pairs are load-bearing and are why
 the effectful binds sit INSIDE an act while the save stays a pure let
 OUTSIDE it. Each of these loops polls up to fifty million times, and
 net-driver-recv-frame allocates a list on every miss. Without the restore
 the bump allocator would walk the whole arena in a single accept.
 Each recursive call is also still a SELF tail call for the same
 reason: splitting one of these loops into a mutually-recursive helper
 would leave fifty million frames on a stack that has no guard page.

Section: Flush Outbox

  flush-outbox-loop : NetSession, Integer, Integer -> [Network.Write] Integer
  flush-outbox-loop (sess) (i) (count) =
   if i >= count then 0
   else let frame = net-outbox-frame sess i
   in act
    sent <- net-driver-send-frame frame
    rest <- flush-outbox-loop sess (i + 1) count
    sent + rest
   end

  flush-transport-outbox : TcpTransportState -> [Network.Write] TcpTransportState
  flush-transport-outbox (ts) =
   let count = net-outbox-count (ts.session)
   in act
    flushed <- flush-outbox-loop (ts.session) 0 count
    let cleared = set-outbox (ts.session) []
    in TcpTransportState { session = cleared, recv-buf = [], recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }
   end

Section: Listen and Accept

  net-io-listen : TcpTransportState -> TcpTransportState
  net-io-listen (ts) =
   let r = net-listen (ts.session)
   in TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }

  net-io-accept : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-accept (ts) (tries) =
   if tries > 50000000 then ts
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-accept ts (tries + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-accept ts1 (tries + 1)
    end
   end

Section: Connect and Wait

  net-io-connect : TcpTransportState -> [Network.Read, Network.Write] TcpTransportState
  net-io-connect (ts) =
   let ts1 = transport-connect ts
   in act
    ts2 <- flush-transport-outbox ts1
    net-io-wait-established ts2 0
   end

  net-io-wait-established : TcpTransportState, Integer -> [Network.Read, Network.Write] TcpTransportState
  net-io-wait-established (ts) (tries) =
   if tries > 10000 then ts
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-wait-established ts (tries + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      when (ts1.session).conn.state
       is TcpEstablished -> ts1
       is otherwise -> net-io-wait-established ts1 (tries + 1)
    end
   end

Section: Send

 net-io-send-chunk rebuilds the transport around the new session, and
 until 2026-07-14 it rebuilt it without recv-base, recv-len or
 recv-cap. A record field that is not named is not written, and __alloc
 zero-fills, so those three came back as zero -- which meant that after
 any send, the receive buffer's base address was 0. The next inbound
 frame fed through transport-feed-raw, which writes with
 __buf-write-bytes (ts.recv-base) ..., so the bytes off the wire landed
 at physical address 0: the IDT and the kernel metadata cells. Send,
 then receive, is the ordinary shape of a request, so the trust
 transport and the DTLS endpoint drove it.

 Every other constructor of a TcpTransportState in TcpTransport carries
 the three fields. This one is the exception, and it was the exception
 by omission rather than by intent.

  net-mss : Integer = 1400

  net-io-send-chunk : TcpTransportState, List Integer, Integer, Integer -> [Network.Write] TcpTransportState
  net-io-send-chunk (ts) (data) (off) (total) =
   if off >= total then ts
   else let stop = if off + net-mss > total then total else off + net-mss
   in let chunk = transport-slice data off stop
   in let r = net-send (ts.session) chunk
   in let ts1 = TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received }
   in act
    ts2 <- flush-transport-outbox ts1
    net-io-send-chunk ts2 data (off + net-mss) total
   end

  net-io-send : TcpTransportState, Integer, List Integer -> [Network.Write] TcpTransportState
  net-io-send (ts) (tag) (body) =
   let framed = frame-encode tag body
   in net-io-send-chunk ts framed 0 (list-length framed)

  net-io-send-raw : TcpTransportState, List Integer -> [Network.Write] TcpTransportState
  net-io-send-raw (ts) (data) = net-io-send-chunk ts data 0 (list-length data)

Section: Sending Text

 A plug answers in target-language source, which is Text, and this is the
 send it wants. It was missing here, so all 41 transpiler plugs carried
 their own byte-identical `send-text-loop` -- shadowing the transport
 rather than a missing cite, since every one of them already cites this
 chapter. Each copy also re-spelled `TcpTransportState`'s
 seven-field literal, which is how one incomplete literal became 46 bugs
 and how `net-io-send-chunk` above came to drop three fields and write
 inbound frames to physical address zero.

 The conversion is the I/O boundary, so it goes through `to-unicode`:
 Codex Text is CCE internally and `char-code` answers the CCE point, not
 the ASCII one. Sending the CCE bytes does not error -- the far end simply
 reads something else -- which is the failure this project has already paid
 for twice (a TLS SNI hostname and every key-schedule label).

  text-to-bytes-chunk : Text, Integer, Integer, List Integer -> List Integer
  text-to-bytes-chunk (s) (i) (stop) (acc) =
   if i >= stop then acc
   else text-to-bytes-chunk s (i + 1) stop (list-push acc (to-unicode (char-code (char-at s i))))

 Only the send half moves here. The receive half (`bytes-to-text-chunk`)
 stays in the plugs, because it is NOT the same function in all of them:
 40 accumulate into a `Text`, and `CSharpPlug` accumulates into a
 `List Text`. Same name, two types, and hoisting one of them would have
 quietly given the other a different function -- which is the
 duplicate-name hazard, met here in miniature.

  net-io-send-text-loop : TcpTransportState, Text, Integer, Integer -> [Network.Write] TcpTransportState
  net-io-send-text-loop (ts) (t) (off) (len) =
   if off >= len then ts
   else let stop = if off + net-mss > len then len else off + net-mss
   in let chunk = text-to-bytes-chunk t off stop []
   in net-io-send-text-loop (net-io-send-chunk ts chunk 0 (list-length chunk)) t stop len

  net-io-send-text : TcpTransportState, Text -> [Network.Write] TcpTransportState
  net-io-send-text (ts) (t) = net-io-send-text-loop ts t 0 (text-length t)

Section: Receive

 A MESSAGE ALREADY IN THE BUFFER IS ANSWERED WITHOUT WAITING FOR A FRAME, and
 without this the message is simply lost. `transport-process-frame` feeds a
 segment's payload into the receive buffer and tries to take a message out of
 it, so a complete message can be sitting there before anyone asks. The wait
 loop below blocks on `net-driver-recv-frame` first, so it would sit waiting
 for a frame that has already been and gone.

 It happens on the ordinary path, not a rare one. A client's final handshake ACK
 usually carries its first request piggybacked (PSH+ACK), so ONE frame both
 establishes the connection and delivers the request. `net-io-accept` returns
 the moment the connection is established and looks at nothing else, so the
 request rides in on the frame that ends the handshake and is buffered; the
 server then calls this and waits forever for a request it is already holding.

 Measured on `tools/cdx-registry`: it served its first request, went back to
 accept, took the second connection, and sat in this loop with the second
 request already buffered.

 The check is at ENTRY and not inside the wait, deliberately. `transport-try-recv`
 scans the buffer, and the wait below runs to a fifty-million-try fuel cap;
 rescanning per iteration would put a buffer walk inside the hottest loop in the
 stack for no gain, because nothing new can arrive except through a frame.

  net-io-recv-loop : TcpTransportState, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-loop (ts) (tries) =
   let pending = transport-try-recv ts
   in if pending.has-message then pending
   else net-io-recv-wait (pending.transport) tries

  net-io-recv-wait : TcpTransportState, Integer -> [Network.Read, Network.Write] TransportRecvResult
  net-io-recv-wait (ts) (tries) =
   if tries > 50000000 then TransportRecvResult { transport = ts, tag = 0, body = [], has-message = False }
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-recv-wait ts (tries + 1)
    else let r = transport-process-frame ts frame
    in act
      ts1 <- flush-transport-outbox (r.transport)
      if r.has-message then TransportRecvResult { transport = ts1, tag = r.tag, body = r.body, has-message = True }
      else net-io-recv-wait ts1 (tries + 1)
    end
   end

Section: Receive Raw (no framing)

  RawRecvResult = record {
    transport : TcpTransportState,
    data : List Integer,
    has-data : Boolean
  }

  net-io-recv-raw : TcpTransportState, Integer -> [Network.Read, Network.Write] RawRecvResult
  net-io-recv-raw (ts) (tries) =
   if tries > 50000000 then RawRecvResult { transport = ts, data = [], has-data = False }
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame == 0 then let restored = __heap-restore hp
      in net-io-recv-raw ts (tries + 1)
    else let r = net-process-frame (ts.session) frame
    in act
      ts1 <- flush-transport-outbox (TcpTransportState { session = r.session, recv-buf = ts.recv-buf, recv-base = ts.recv-base, recv-len = ts.recv-len, recv-cap = ts.recv-cap, messages-sent = ts.messages-sent, messages-received = ts.messages-received })
      if list-length (r.data) > 0 then RawRecvResult { transport = ts1, data = r.data, has-data = True }
      else net-io-recv-raw ts1 (tries + 1)
    end
   end

Section: Poll One

  net-io-poll-one : TcpTransportState, Integer -> [Network.Read] List Integer
  net-io-poll-one (ts) (tries) =
   if tries > 5000000 then []
   else let hp = __heap-save
   in act
    frame <- net-driver-recv-frame
    if list-length frame > 0 then frame
    else let restored = __heap-restore hp
      in net-io-poll-one ts (tries + 1)
   end

Section: Close

  net-io-close : TcpTransportState -> [Network.Write] TcpTransportState
  net-io-close (ts) =
   let ts1 = transport-close ts
   in flush-transport-outbox ts1

