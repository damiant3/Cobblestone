Section: Config Entry

  ConfigEntry = record {
    ce-key : Text,
    ce-value : Text,
    ce-version : Integer,
    ce-created : Integer,
    ce-modified : Integer,
    ce-ttl-sec : Integer,
    ce-expires : Integer,
    ce-namespace : Text
  }

  config-entry-new : Text, Text, Integer, Integer -> ConfigEntry
  config-entry-new (key) (value) (version) (ts) = ConfigEntry {
    ce-key = key, ce-value = value,
    ce-version = version,
    ce-created = ts, ce-modified = ts,
    ce-ttl-sec = 0, ce-expires = 0,
    ce-namespace = config-namespace key
  }

  config-namespace : Text -> Text
  config-namespace (key) = cn-loop key 0 (text-length key)

  cn-loop : Text, Integer, Integer -> Text
  cn-loop (key) (i) (len) =
    if i >= len then ""
    else if char-code (char-at key i) == char-code '.' then text-take key i
    else cn-loop key (i + 1) len

  ce-is-expired : ConfigEntry, Integer -> Boolean
  ce-is-expired (ce) (now) =
    if ce.ce-ttl-sec == 0 then False
    else now >= ce.ce-expires

Section: Watch

  ConfigWatch = record {
    cw-id : Integer,
    cw-prefix : Text,
    cw-callback : Text,
    cw-last-version : Integer
  }

Section: Config Store (backed by foreword KvStore/HAMT)

  ConfigStore = record {
    cs-values : KvStore,
    cs-meta : List ConfigEntry,
    cs-meta-count : Integer,
    cs-version : Integer,
    cs-watches : List ConfigWatch,
    cs-watch-count : Integer,
    cs-next-watch-id : Integer
  }

  config-store-new : ConfigStore
  config-store-new = ConfigStore {
    cs-values = kv-empty, cs-meta = [], cs-meta-count = 0,
    cs-version = 0,
    cs-watches = [], cs-watch-count = 0, cs-next-watch-id = 1
  }

  cs-make : ConfigStore, KvStore, List ConfigEntry, Integer, List ConfigWatch, Integer -> ConfigStore
  cs-make (st) (values) (meta) (version) (watches) (next-id) = ConfigStore {
    cs-values = values, cs-meta = meta, cs-meta-count = list-length meta,
    cs-version = version,
    cs-watches = watches, cs-watch-count = list-length watches,
    cs-next-watch-id = next-id
  }

  cs-set : ConfigStore, Text, Text, Integer -> ConfigStore
  cs-set (st) (key) (value) (ts) = cs-put st key value (-1) ts

  cs-set-ttl : ConfigStore, Text, Text, Integer, Integer -> ConfigStore
  cs-set-ttl (st) (key) (value) (ttl) (ts) = cs-put st key value ttl ts

  cs-put : ConfigStore, Text, Text, Integer, Integer -> ConfigStore
  cs-put (st) (key) (value) (ttl) (ts) =
    let v = st.cs-version + 1
    in let entry = when cs-get-meta (st.cs-meta) key 0 (st.cs-meta-count)
      is Just (old) -> cs-entry key value v (old.ce-created) ts (if ttl < 0 then old.ce-ttl-sec else ttl) (old.ce-namespace)
      is None -> cs-entry key value v ts ts (if ttl < 0 then 0 else ttl) (config-namespace key)
    in cs-make st (kv-put (st.cs-values) key value) (cs-put-meta (st.cs-meta) entry 0 (st.cs-meta-count) [] False) v (st.cs-watches) (st.cs-next-watch-id)

  cs-entry : Text, Text, Integer, Integer, Integer, Integer, Text -> ConfigEntry
  cs-entry (key) (value) (version) (created) (ts) (ttl) (ns) = ConfigEntry {
    ce-key = key, ce-value = value, ce-version = version,
    ce-created = created, ce-modified = ts,
    ce-ttl-sec = ttl, ce-expires = if ttl > 0 then ts + ttl else 0,
    ce-namespace = ns
  }

  cs-put-meta : List ConfigEntry, ConfigEntry, Integer, Integer, List ConfigEntry, Boolean -> List ConfigEntry
  cs-put-meta (entries) (e) (i) (n) (acc) (found) =
    if i >= n then (if found then acc else list-push acc e)
    else let old = list-at entries i
    in if old.ce-key == e.ce-key then cs-put-meta entries e (i + 1) n (list-push acc e) True
    else cs-put-meta entries e (i + 1) n (list-push acc old) found

  cs-get : ConfigStore, Text -> Maybe ConfigEntry
  cs-get (st) (key) =
    when kv-get (st.cs-values) key
      is Just (val) -> cs-get-meta (st.cs-meta) key 0 (st.cs-meta-count)
      is None -> None

  cs-get-meta : List ConfigEntry, Text, Integer, Integer -> Maybe ConfigEntry
  cs-get-meta (entries) (key) (i) (n) =
    if i >= n then None
    else let e = list-at entries i
    in if e.ce-key == key then Just e
    else cs-get-meta entries key (i + 1) n

  cs-get-value : ConfigStore, Text, Text -> Text
  cs-get-value (st) (key) (default-val) = kv-get-or (st.cs-values) key default-val

  cs-delete : ConfigStore, Text -> ConfigStore
  cs-delete (st) (key) =
    cs-make st (kv-delete (st.cs-values) key) (cs-delete-meta (st.cs-meta) key 0 (st.cs-meta-count) []) (st.cs-version + 1) (st.cs-watches) (st.cs-next-watch-id)

  cs-delete-meta : List ConfigEntry, Text, Integer, Integer, List ConfigEntry -> List ConfigEntry
  cs-delete-meta (entries) (key) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if e.ce-key == key then cs-delete-meta entries key (i + 1) n acc
    else cs-delete-meta entries key (i + 1) n (list-push acc e)

  cs-cas : ConfigStore, Text, Text, Text, Integer -> ConfigStore
  cs-cas (st) (key) (expected) (new-value) (ts) =
    let current = kv-get-or (st.cs-values) key ""
    in if current == expected then cs-set st key new-value ts
    else if text-length expected == 0 then
      when kv-get (st.cs-values) key
        is None -> cs-set st key new-value ts
        is Just (v) -> st
    else st

  cs-list-prefix : ConfigStore, Text -> List ConfigEntry
  cs-list-prefix (st) (prefix) = cs-prefix-loop (st.cs-meta) prefix 0 (st.cs-meta-count) []

  cs-prefix-loop : List ConfigEntry, Text, Integer, Integer, List ConfigEntry -> List ConfigEntry
  cs-prefix-loop (entries) (prefix) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if text-starts-with (e.ce-key) prefix then
      cs-prefix-loop entries prefix (i + 1) n (list-push acc e)
    else cs-prefix-loop entries prefix (i + 1) n acc

  cs-list-namespace : ConfigStore, Text -> List ConfigEntry
  cs-list-namespace (st) (ns) = cs-ns-loop (st.cs-meta) ns 0 (st.cs-meta-count) []

  cs-ns-loop : List ConfigEntry, Text, Integer, Integer, List ConfigEntry -> List ConfigEntry
  cs-ns-loop (entries) (ns) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if e.ce-namespace == ns then cs-ns-loop entries ns (i + 1) n (list-push acc e)
    else cs-ns-loop entries ns (i + 1) n acc

  cs-add-watch : ConfigStore, Text, Text -> ConfigStore
  cs-add-watch (st) (prefix) (callback) =
    let w = ConfigWatch {
      cw-id = st.cs-next-watch-id,
      cw-prefix = prefix,
      cw-callback = callback,
      cw-last-version = st.cs-version
    }
    in cs-make st (st.cs-values) (st.cs-meta) (st.cs-version) (list-push (for x in st.cs-watches -> x) w) (st.cs-next-watch-id + 1)

  cs-find-watch : List ConfigWatch, Integer, Integer, Integer -> Maybe ConfigWatch
  cs-find-watch (ws) (id) (i) (n) =
    if i >= n then None
    else let w = list-at ws i
    in if w.cw-id == id then Just w
    else cs-find-watch ws id (i + 1) n

  cs-watch-changes : ConfigStore, Integer -> List ConfigEntry
  cs-watch-changes (st) (id) =
    when cs-find-watch (st.cs-watches) id 0 (st.cs-watch-count)
      is Just (w) ->
        let under = cs-list-prefix st (w.cw-prefix)
        in cs-newer-loop under (w.cw-last-version) 0 (list-length under) []
      is None -> []

  cs-newer-loop : List ConfigEntry, Integer, Integer, Integer, List ConfigEntry -> List ConfigEntry
  cs-newer-loop (entries) (since) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if e.ce-version > since then cs-newer-loop entries since (i + 1) n (list-push acc e)
    else cs-newer-loop entries since (i + 1) n acc

  cs-watch-seen : ConfigStore, Integer -> ConfigStore
  cs-watch-seen (st) (id) =
    cs-make st (st.cs-values) (st.cs-meta) (st.cs-version) (cs-seen-loop (st.cs-watches) id (st.cs-version) 0 (st.cs-watch-count) []) (st.cs-next-watch-id)

  cs-seen-loop : List ConfigWatch, Integer, Integer, Integer, Integer, List ConfigWatch -> List ConfigWatch
  cs-seen-loop (ws) (id) (version) (i) (n) (acc) =
    if i >= n then acc
    else let w = list-at ws i
    in let w2 = if w.cw-id == id then ConfigWatch { cw-id = w.cw-id, cw-prefix = w.cw-prefix, cw-callback = w.cw-callback, cw-last-version = version } else w
    in cs-seen-loop ws id version (i + 1) n (list-push acc w2)

  cs-expire : ConfigStore, Integer -> ConfigStore
  cs-expire (st) (now) =
    let kept = cs-expire-loop (st.cs-meta) now 0 (st.cs-meta-count) []
    in if list-length kept == st.cs-meta-count then st
    else cs-make st (cs-expire-values (st.cs-values) (st.cs-meta) now 0 (st.cs-meta-count)) kept (st.cs-version + 1) (st.cs-watches) (st.cs-next-watch-id)

  cs-expire-values : KvStore, List ConfigEntry, Integer, Integer, Integer -> KvStore
  cs-expire-values (values) (entries) (now) (i) (n) =
    if i >= n then values
    else let e = list-at entries i
    in let v2 = if ce-is-expired e now then kv-delete values (e.ce-key) else values
    in cs-expire-values v2 entries now (i + 1) n

  cs-expire-loop : List ConfigEntry, Integer, Integer, Integer, List ConfigEntry -> List ConfigEntry
  cs-expire-loop (entries) (now) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if ce-is-expired e now then cs-expire-loop entries now (i + 1) n acc
    else cs-expire-loop entries now (i + 1) n (list-push acc e)

  cs-namespaces : ConfigStore -> List Text
  cs-namespaces (st) = cs-ns-uniq (st.cs-meta) 0 (st.cs-meta-count) []

  cs-ns-uniq : List ConfigEntry, Integer, Integer, List Text -> List Text
  cs-ns-uniq (entries) (i) (n) (acc) =
    if i >= n then acc
    else let ns = (list-at entries i).ce-namespace
    in if cs-ns-in acc ns 0 (list-length acc) then cs-ns-uniq entries (i + 1) n acc
    else cs-ns-uniq entries (i + 1) n (list-push acc ns)

  cs-ns-in : List Text, Text, Integer, Integer -> Boolean
  cs-ns-in (items) (target) (i) (n) =
    if i >= n then False
    else if list-at items i == target then True
    else cs-ns-in items target (i + 1) n

  cs-status : ConfigStore -> Text
  cs-status (st) =
    "config version=" & show (st.cs-version) & " entries=" & show (st.cs-meta-count) & " watches=" & show (st.cs-watch-count)

