Chapter: GossipProtocol
  cites Foreword chapter Maybe

Section: Gossip State

  GossipUpdate =
    | GuAlive (Text) (Integer)
    | GuSuspect (Text) (Integer)
    | GuDead (Text) (Integer)
    | GuJoin (Text) (Text) (Integer)
    | GuLeave (Text) (Integer)
    | GuMeta (Text) (Text) (Integer)

  gu-label : GossipUpdate -> Text
  gu-label (u) = when u
    is GuAlive (id) (gen) -> "ALIVE " & id & " gen=" & show gen
    is GuSuspect (id) (gen) -> "SUSPECT " & id & " gen=" & show gen
    is GuDead (id) (gen) -> "DEAD " & id & " gen=" & show gen
    is GuJoin (id) (addr) (gen) -> "JOIN " & id & " at " & addr
    is GuLeave (id) (gen) -> "LEAVE " & id
    is GuMeta (id) (key) (gen) -> "META " & id & "." & key

  gu-target : GossipUpdate -> Text
  gu-target (u) = when u
    is GuAlive (id) (gen) -> id
    is GuSuspect (id) (gen) -> id
    is GuDead (id) (gen) -> id
    is GuJoin (id) (addr) (gen) -> id
    is GuLeave (id) (gen) -> id
    is GuMeta (id) (key) (gen) -> id

  gu-generation : GossipUpdate -> Integer
  gu-generation (u) = when u
    is GuAlive (id) (gen) -> gen
    is GuSuspect (id) (gen) -> gen
    is GuDead (id) (gen) -> gen
    is GuJoin (id) (addr) (gen) -> gen
    is GuLeave (id) (gen) -> gen
    is GuMeta (id) (key) (gen) -> gen

Section: Peer Tracking

  GossipPeer = record {
    gp-id : Text,
    gp-address : Text,
    gp-status : Text,
    gp-generation : Integer,
    gp-last-seen : Integer,
    gp-metadata : List Text,
    gp-meta-count : Integer
  }

  gossip-peer-new : Text, Text -> GossipPeer
  gossip-peer-new (id) (addr) = GossipPeer {
    gp-id = id, gp-address = addr,
    gp-status = "alive", gp-generation = 1,
    gp-last-seen = 0, gp-metadata = [], gp-meta-count = 0
  }

Section: Gossip Messages

  GossipMsg =
    | GmPing (Text) (Integer) (List GossipUpdate)
    | GmAck (Text) (Integer) (List GossipUpdate)
    | GmPingReq (Text) (Text) (Integer)
    | GmPingReqAck (Text) (Text) (Boolean)

  gm-label : GossipMsg -> Text
  gm-label (m) = when m
    is GmPing (from) (seq) (updates) -> "PING from=" & from & " piggyback=" & show (list-length updates)
    is GmAck (from) (seq) (updates) -> "ACK from=" & from & " piggyback=" & show (list-length updates)
    is GmPingReq (from) (target) (seq) -> "PING-REQ from=" & from & " target=" & target
    is GmPingReqAck (from) (target) (alive) -> "PING-REQ-ACK " & target & " alive=" & if alive then
      "yes"
    else "no"

Section: Update Queue

  UpdateQueue = record {
    uq-updates : List UpdateEntry,
    uq-count : Integer,
    uq-max-piggyback : Integer,
    uq-retransmit-limit : Integer
  }

  UpdateEntry = record {
    ue-update : GossipUpdate,
    ue-remaining : Integer
  }

  update-queue-new : Integer, Integer -> UpdateQueue
  update-queue-new (max-piggyback) (retransmit) = UpdateQueue {
    uq-updates = [], uq-count = 0,
    uq-max-piggyback = max-piggyback,
    uq-retransmit-limit = retransmit
  }

  uq-with : UpdateQueue, List UpdateEntry -> UpdateQueue
  uq-with (q) (entries) = UpdateQueue {
    uq-updates = entries, uq-count = list-length entries,
    uq-max-piggyback = q.uq-max-piggyback,
    uq-retransmit-limit = q.uq-retransmit-limit
  }

  uq-enqueue : UpdateQueue, GossipUpdate -> UpdateQueue
  uq-enqueue (q) (update) =
    let kept = uq-drop-target (q.uq-updates) (gu-target update) 0 (q.uq-count) []
    in uq-with q (list-push kept (UpdateEntry { ue-update = update, ue-remaining = q.uq-retransmit-limit }))

  uq-drop-target : List UpdateEntry, Text, Integer, Integer, List UpdateEntry -> List UpdateEntry
  uq-drop-target (entries) (target) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at entries i
    in if gu-target (e.ue-update) == target then uq-drop-target entries target (i + 1) n acc
    else uq-drop-target entries target (i + 1) n (list-push acc e)

  UqTake = record { ut-updates : List GossipUpdate, ut-queue : UpdateQueue }

  uq-take : UpdateQueue -> UqTake
  uq-take (q) =
    let n = if q.uq-count < q.uq-max-piggyback then q.uq-count else q.uq-max-piggyback
    in uq-take-loop q 0 n [] []

  uq-take-loop : UpdateQueue, Integer, Integer, List GossipUpdate, List UpdateEntry -> UqTake
  uq-take-loop (q) (i) (n) (sent) (kept) =
    if i >= q.uq-count then UqTake { ut-updates = sent, ut-queue = uq-with q kept }
    else let e = list-at (q.uq-updates) i
    in if i >= n then uq-take-loop q (i + 1) n sent (list-push kept e)
    else let left = e.ue-remaining - 1
    in let kept2 = if left > 0 then list-push kept (UpdateEntry { ue-update = e.ue-update, ue-remaining = left }) else kept
    in uq-take-loop q (i + 1) n (list-push sent (e.ue-update)) kept2

Section: Gossip Node State

  GossipState = record {
    gos-id : Text,
    gos-address : Text,
    gos-peers : List GossipPeer,
    gos-peer-count : Integer,
    gos-generation : Integer,
    gos-sequence : Integer,
    gos-queue : UpdateQueue,
    gos-ping-interval : Integer,
    gos-ping-timeout : Integer,
    gos-suspect-timeout : Integer,
    gos-indirect-checks : Integer,
    gos-last-ping : Integer,
    gos-pings-sent : Integer,
    gos-pings-received : Integer,
    gos-updates-sent : Integer,
    gos-updates-received : Integer
  }

  gossip-new : Text, Text -> GossipState
  gossip-new (id) (addr) = GossipState {
    gos-id = id, gos-address = addr,
    gos-peers = [], gos-peer-count = 0,
    gos-generation = 1, gos-sequence = 0,
    gos-queue = update-queue-new 6 3,
    gos-ping-interval = 1,
    gos-ping-timeout = 3,
    gos-suspect-timeout = 10,
    gos-indirect-checks = 3,
    gos-last-ping = 0,
    gos-pings-sent = 0, gos-pings-received = 0,
    gos-updates-sent = 0, gos-updates-received = 0
  }

  gos-make : GossipState, List GossipPeer, UpdateQueue, Integer, Integer, Integer, Integer, Integer -> GossipState
  gos-make (st) (peers) (queue) (seq) (sent) (received) (usent) (ureceived) = GossipState {
    gos-id = st.gos-id, gos-address = st.gos-address,
    gos-peers = peers, gos-peer-count = list-length peers,
    gos-generation = st.gos-generation, gos-sequence = seq,
    gos-queue = queue,
    gos-ping-interval = st.gos-ping-interval,
    gos-ping-timeout = st.gos-ping-timeout,
    gos-suspect-timeout = st.gos-suspect-timeout,
    gos-indirect-checks = st.gos-indirect-checks,
    gos-last-ping = st.gos-last-ping,
    gos-pings-sent = sent, gos-pings-received = received,
    gos-updates-sent = usent, gos-updates-received = ureceived
  }

  gos-with : GossipState, List GossipPeer, UpdateQueue -> GossipState
  gos-with (st) (peers) (queue) =
    gos-make st peers queue (st.gos-sequence) (st.gos-pings-sent) (st.gos-pings-received) (st.gos-updates-sent) (st.gos-updates-received)

  gos-add-peer : GossipState, GossipPeer -> GossipState
  gos-add-peer (st) (p) =
    gos-with st (list-push (for x in st.gos-peers -> x) p) (uq-enqueue (st.gos-queue) (GuJoin (p.gp-id) (p.gp-address) (p.gp-generation)))

  gos-find-peer : GossipState, Text -> Maybe GossipPeer
  gos-find-peer (st) (id) = gos-find-loop (st.gos-peers) id 0 (st.gos-peer-count)

  gos-find-loop : List GossipPeer, Text, Integer, Integer -> Maybe GossipPeer
  gos-find-loop (peers) (id) (i) (n) =
    if i >= n then None
    else let p = list-at peers i
    in if p.gp-id == id then Just p
    else gos-find-loop peers id (i + 1) n

  gp-with : GossipPeer, Text, Integer, Integer -> GossipPeer
  gp-with (p) (status) (gen) (seen) = GossipPeer {
    gp-id = p.gp-id, gp-address = p.gp-address,
    gp-status = status, gp-generation = gen,
    gp-last-seen = seen, gp-metadata = p.gp-metadata, gp-meta-count = p.gp-meta-count
  }

  gos-replace-peer : List GossipPeer, GossipPeer, Integer, Integer, List GossipPeer -> List GossipPeer
  gos-replace-peer (peers) (np) (i) (n) (acc) =
    if i >= n then acc
    else let p = list-at peers i
    in gos-replace-peer peers np (i + 1) n (list-push acc (if p.gp-id == np.gp-id then np else p))

Section: Ping Cycle

  GossipPing = record { gpo-state : GossipState, gpo-msg : GossipMsg }

  gos-ping : GossipState -> GossipPing
  gos-ping (st) =
    let t = uq-take (st.gos-queue)
    in let next = gos-make st (st.gos-peers) (t.ut-queue) (st.gos-sequence + 1) (st.gos-pings-sent + 1) (st.gos-pings-received) (st.gos-updates-sent + list-length (t.ut-updates)) (st.gos-updates-received)
    in GossipPing { gpo-state = next, gpo-msg = GmPing (st.gos-id) (st.gos-sequence) (t.ut-updates) }

  gos-handle-ping : GossipState, Text, Integer, List GossipUpdate, Integer -> GossipState
  gos-handle-ping (st) (from) (seq) (updates) (now) =
    let st2 = gos-mark-alive (gos-apply-updates st updates now) from now
    in gos-make st2 (st2.gos-peers) (st2.gos-queue) (st2.gos-sequence) (st2.gos-pings-sent) (st2.gos-pings-received + 1) (st2.gos-updates-sent) (st2.gos-updates-received + list-length updates)

  gos-handle-ack : GossipState, Text, Integer, List GossipUpdate, Integer -> GossipState
  gos-handle-ack (st) (from) (seq) (updates) (now) =
    let st2 = gos-mark-alive (gos-apply-updates st updates now) from now
    in gos-make st2 (st2.gos-peers) (st2.gos-queue) (st2.gos-sequence) (st2.gos-pings-sent) (st2.gos-pings-received) (st2.gos-updates-sent) (st2.gos-updates-received + list-length updates)

  gos-apply-updates : GossipState, List GossipUpdate, Integer -> GossipState
  gos-apply-updates (st) (updates) (now) =
    gos-apply-loop st updates 0 (list-length updates) now

  gos-apply-loop : GossipState, List GossipUpdate, Integer, Integer, Integer -> GossipState
  gos-apply-loop (st) (updates) (i) (n) (now) =
    if i >= n then st
    else let u = list-at updates i
    in let st2 = gos-apply-single st u now
    in gos-apply-loop st2 updates (i + 1) n now

  gos-apply-single : GossipState, GossipUpdate, Integer -> GossipState
  gos-apply-single (st) (update) (now) =
    if gu-target update == st.gos-id then st
    else when update
      is GuAlive (id) (gen) -> gos-learn-id st id "alive" gen now update
      is GuSuspect (id) (gen) -> gos-learn-id st id "suspect" gen now update
      is GuDead (id) (gen) -> gos-learn-id st id "dead" gen now update
      is GuJoin (id) (addr) (gen) ->
        when gos-find-peer st id
          is Just (p) -> gos-learn st p "alive" gen now update
          is None -> gos-add-peer st (gp-with (gossip-peer-new id addr) "alive" gen now)
      is GuLeave (id) (gen) -> gos-learn-id st id "dead" gen now update
      is GuMeta (id) (key) (gen) -> st

  gos-learn-id : GossipState, Text, Text, Integer, Integer, GossipUpdate -> GossipState
  gos-learn-id (st) (id) (status) (gen) (now) (update) =
    when gos-find-peer st id
      is Just (p) -> gos-learn st p status gen now update
      is None -> st

  gos-learn : GossipState, GossipPeer, Text, Integer, Integer, GossipUpdate -> GossipState
  gos-learn (st) (p) (status) (gen) (now) (update) =
    if gos-overrides (p.gp-status) (p.gp-generation) status gen then
      gos-with st (gos-replace-peer (st.gos-peers) (gp-with p status gen now) 0 (st.gos-peer-count) []) (uq-enqueue (st.gos-queue) update)
    else st

  gos-overrides : Text, Integer, Text, Integer -> Boolean
  gos-overrides (cur) (cur-gen) (new) (new-gen) =
    if new == "alive" then new-gen > cur-gen
    else if new == "suspect" then
      (if cur == "alive" then new-gen >= cur-gen else if cur == "suspect" then new-gen > cur-gen else False)
    else if cur == "dead" then False
    else new-gen >= cur-gen

  gos-mark-alive : GossipState, Text, Integer -> GossipState
  gos-mark-alive (st) (id) (now) =
    when gos-find-peer st id
      is Just (p) -> gos-with st (gos-replace-peer (st.gos-peers) (gp-with p "alive" (p.gp-generation) now) 0 (st.gos-peer-count) []) (st.gos-queue)
      is None -> st

Section: Failure Detection

  gos-check-suspects : GossipState, Integer -> GossipState
  gos-check-suspects (st) (now) =
    let r = gos-suspect-loop (st.gos-peers) now (st.gos-suspect-timeout) (st.gos-ping-timeout) 0 (st.gos-peer-count) [] (st.gos-queue)
    in gos-with st (r.scr-peers) (r.scr-queue)

  SuspectCheckResult = record { scr-peers : List GossipPeer, scr-queue : UpdateQueue }

  gos-suspect-loop : List GossipPeer, Integer, Integer, Integer, Integer, Integer, List GossipPeer, UpdateQueue -> SuspectCheckResult
  gos-suspect-loop (peers) (now) (suspect-t) (ping-t) (i) (n) (acc) (queue) =
    if i >= n then SuspectCheckResult { scr-peers = acc, scr-queue = queue }
    else let p = list-at peers i
    in let elapsed = now - p.gp-last-seen
    in if p.gp-status == "alive" & elapsed > ping-t then
      gos-suspect-loop peers now suspect-t ping-t (i + 1) n (list-push acc (gp-with p "suspect" (p.gp-generation) (p.gp-last-seen))) (uq-enqueue queue (GuSuspect (p.gp-id) (p.gp-generation)))
    else if p.gp-status == "suspect" & elapsed > suspect-t then
      gos-suspect-loop peers now suspect-t ping-t (i + 1) n (list-push acc (gp-with p "dead" (p.gp-generation) (p.gp-last-seen))) (uq-enqueue queue (GuDead (p.gp-id) (p.gp-generation)))
    else gos-suspect-loop peers now suspect-t ping-t (i + 1) n (list-push acc p) queue

Section: Statistics

  gos-alive-count : GossipState -> Integer
  gos-alive-count (st) = gos-count-status (st.gos-peers) "alive" 0 (st.gos-peer-count) 0

  gos-suspect-count : GossipState -> Integer
  gos-suspect-count (st) = gos-count-status (st.gos-peers) "suspect" 0 (st.gos-peer-count) 0

  gos-dead-count : GossipState -> Integer
  gos-dead-count (st) = gos-count-status (st.gos-peers) "dead" 0 (st.gos-peer-count) 0

  gos-count-status : List GossipPeer, Text, Integer, Integer, Integer -> Integer
  gos-count-status (peers) (status) (i) (n) (acc) =
    if i >= n then acc
    else let delta = if (list-at peers i).gp-status == status then 1 else 0
    in gos-count-status peers status (i + 1) n (acc + delta)

  gos-status : GossipState -> Text
  gos-status (st) =
    "gossip " & st.gos-id & " peers=" & show (st.gos-peer-count) & " alive=" & show (gos-alive-count st) & " suspect=" & show (gos-suspect-count st) & " dead=" & show (gos-dead-count st) & " pings=" & show (st.gos-pings-sent) & "/" & show (st.gos-pings-received)

