 The VerifiedLoader combines CdxVerifier checks with trust-lattice
 policy evaluation, then maps verified CDX binaries into runnable
 process images with kernel-granted capability bits.

 We say:

Section: Kernel Capability Bits

 These must agree with the compiler's cap-* constants (X86_64Boot) and
 with boot-cap-mask-for (X86_64Chapter), because a binary is granted its
 authority by ONE of those two paths and must not get a different answer
 depending on which. Two of these were missing, and their absence was the
 disagreement: the boot path set cap-console (bit 0) and granted a
 Concurrent program ipc + process-create, and the loader granted neither,
 so the SAME binary could spawn a process when booted and could not when
 loaded. (BACKLOG 1.12.)

  kern-cap-console : Integer = 0

  kern-cap-concurrent : Integer = 3

  kern-cap-console-read : Integer = 4

  kern-cap-console-write : Integer = 5

  kern-cap-filesystem-read : Integer = 6

  kern-cap-filesystem-write : Integer = 7

  kern-cap-network-read : Integer = 8

  kern-cap-network-write : Integer = 9

  kern-cap-block-device : Integer = 10

  kern-cap-ipc : Integer = 11

  kern-cap-process-create : Integer = 12

  kern-cap-capability-admin : Integer = 14

  kern-cap-identity : Integer = 15

  kern-cap-device : Integer = 16

  kern-cap-gpu-compute : Integer = 17

  kern-cap-gpu-memory : Integer = 18

  kern-cap-camera : Integer = 19

  kern-cap-microphone : Integer = 20

  kern-cap-location : Integer = 21

  kern-cap-sensors : Integer = 22

  kern-cap-display : Integer = 23

  kern-cap-flash : Integer = 24

  kern-cap-audio : Integer = 25

Section: Load Decision

 A grant is a set of bits AND the extent over which they hold. The
 bitmask alone was the whole grant here, and the scope the verifier had
 already decoded was thrown away one line later -- so a binary whose
 manifest said "filesystem read, under /config/" was loaded with
 filesystem read over the ENTIRE volume. The authority survived the
 journey and the limit on it did not, which is the worst half to lose.

 Only the filesystem scope is carried, because it is the only one with a
 runtime chokepoint to enforce it (Fat16). A network authority and a
 console channel are checked at compile time and nowhere else, and a
 grant record that carried them would be claiming an enforcement that
 does not exist.

  CapGrant = record {
    bitmask : Integer,
    cap-count : Integer between 0 and 255,
    scope : Text,
    net-scope : Text
  }

  LoadDecision =
    | LoadApproved (CapGrant)
    | LoadDenied (VerifyResult)

Section: Capability Mapping

  dir-bits : Integer, Integer, Integer -> Integer
  dir-bits (direction) (read-bit) (write-bit) =
    if direction == cdx-dir-read then bit-shl 1 read-bit
    else if direction == cdx-dir-write then bit-shl 1 write-bit
    else bit-or (bit-shl 1 read-bit) (bit-shl 1 write-bit)

  cdx-cap-to-kern-bits : CdxCapability -> Integer
  cdx-cap-to-kern-bits (cap) =
    if cap.cap-id == cdx-cap-console then bit-or (bit-shl 1 kern-cap-console) (dir-bits (cap.direction) kern-cap-console-read kern-cap-console-write)
    else if cap.cap-id == cdx-cap-filesystem then dir-bits (cap.direction) kern-cap-filesystem-read kern-cap-filesystem-write
    else if cap.cap-id == cdx-cap-network then dir-bits (cap.direction) kern-cap-network-read kern-cap-network-write
    else if cap.cap-id == cdx-cap-concurrent then bit-or (bit-shl 1 kern-cap-concurrent) (bit-or (bit-shl 1 kern-cap-ipc) (bit-shl 1 kern-cap-process-create))
    else if cap.cap-id == cdx-cap-device then bit-or (bit-shl 1 kern-cap-block-device) (bit-shl 1 kern-cap-device)
    else if cap.cap-id == cdx-cap-identity then bit-shl 1 kern-cap-identity
    else if cap.cap-id == cdx-cap-capability then bit-shl 1 kern-cap-capability-admin
    else if cap.cap-id == cdx-cap-gpu-compute then bit-shl 1 kern-cap-gpu-compute
    else if cap.cap-id == cdx-cap-gpu-memory then bit-shl 1 kern-cap-gpu-memory
    else if cap.cap-id == cdx-cap-gpu then bit-or (bit-shl 1 kern-cap-gpu-compute) (bit-shl 1 kern-cap-gpu-memory)
    else if cap.cap-id == cdx-cap-camera then bit-shl 1 kern-cap-camera
    else if cap.cap-id == cdx-cap-microphone then bit-shl 1 kern-cap-microphone
    else if cap.cap-id == cdx-cap-location then bit-shl 1 kern-cap-location
    else if cap.cap-id == cdx-cap-sensors then bit-shl 1 kern-cap-sensors
    else if cap.cap-id == cdx-cap-display then bit-shl 1 kern-cap-display
    else if cap.cap-id == cdx-cap-flash then bit-shl 1 kern-cap-flash
    else if cap.cap-id == cdx-cap-audio then bit-shl 1 kern-cap-audio
    else 0

  cdx-caps-to-bitmask : List CdxCapability -> Integer
  cdx-caps-to-bitmask (caps) =
    caps-bitmask-loop caps 0 (list-length caps) 0

  caps-bitmask-loop : List CdxCapability, Integer, Integer, Integer -> Integer
  caps-bitmask-loop (caps) (i) (len) (acc) =
    if i >= len then acc
    else let cap = list-at caps i
    in caps-bitmask-loop caps (i + 1) len (bit-or acc (cdx-cap-to-kern-bits cap))

 The filesystem grant's scope, which the loader writes into the process
 table beside the bits. An absent filesystem capability and a filesystem
 capability with no scope both answer "" -- the empty prefix, which
 admits every path. That is the honest reading of an unscoped grant and
 it is what Fat16 already does with an empty scope, so the two agree by
 construction rather than by coincidence.

  cdx-caps-to-scope : List CdxCapability -> Text
  cdx-caps-to-scope (caps) =
    caps-scope-loop caps 0 (list-length caps)

  caps-scope-loop : List CdxCapability, Integer, Integer -> Text
  caps-scope-loop (caps) (i) (len) =
    if i >= len then ""
    else let cap = list-at caps i
    in if cap.cap-id == cdx-cap-filesystem & text-length (cap.scope) > 0
       then cap.scope
       else caps-scope-loop caps (i + 1) len

 The network authority scope, decoded the same way as the filesystem
 path scope but off the network capability. A loaded binary that
 declared [Network.Write "api.example.com"] carries that authority in
 its manifest; apply-load-decision installs it into the process's
 network scope cell so the fetch chokepoint enforces it at runtime.

  cdx-caps-to-net-scope : List CdxCapability -> Text
  cdx-caps-to-net-scope (caps) =
    caps-net-scope-loop caps 0 (list-length caps)

  caps-net-scope-loop : List CdxCapability, Integer, Integer -> Text
  caps-net-scope-loop (caps) (i) (len) =
    if i >= len then ""
    else let cap = list-at caps i
    in if cap.cap-id == cdx-cap-network & text-length (cap.scope) > 0
       then cap.scope
       else caps-net-scope-loop caps (i + 1) len

Section: Load Evaluation

  evaluate-load : List Integer, TrustLattice, Policy, Integer, BareFactStore, Integer -> LoadDecision
  evaluate-load (binary) (lattice) (policy) (current-time) (store) (fuel) =
    let result = verify-cdx-full binary lattice policy current-time store fuel
    in if result.accepted then
      let cap-off = read-le64 binary 136
      in let cap-sz = read-le64 binary 144
      in let caps = decode-capabilities binary cap-off (cap-off + cap-sz)
      in let bitmask = cdx-caps-to-bitmask caps
      in LoadApproved (CapGrant { bitmask = bitmask, cap-count = __narrow (list-length caps), scope = cdx-caps-to-scope caps, net-scope = cdx-caps-to-net-scope caps })
    else LoadDenied result

  load-approved : LoadDecision -> Boolean
  load-approved (d) = when d
    is LoadApproved (g) -> True
    is LoadDenied (r) -> False

  load-bitmask : LoadDecision -> Integer
  load-bitmask (d) = when d
    is LoadApproved (g) -> g.bitmask
    is LoadDenied (r) -> 0

 A DENIED load has no scope, and answering "" for it is not a hole: a
 denied decision writes nothing into the process table at all, so the
 empty string here is never installed anywhere. apply-load-decision is
 what enforces that, and it refuses before it writes either half.

  load-scope : LoadDecision -> Text
  load-scope (d) = when d
    is LoadApproved (g) -> g.scope
    is LoadDenied (r) -> ""

  load-reason : LoadDecision -> Text
  load-reason (d) = when d
    is LoadApproved (g) -> "approved"
    is LoadDenied (r) -> r.reason

