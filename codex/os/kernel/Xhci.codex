Chapter: Xhci
  cites Kernel chapter Usb
  cites Kernel chapter Pci
  cites Foreword chapter Maybe

 XHCI (USB 3.x) host controller driver. Manages command ring,
 event ring, transfer rings, and device context arrays. Discovers
 the controller via PCI, reads capability registers, and builds
 the data structures for USB device enumeration.

 We say:

Section: Constants
  xhci-pci-class : Integer = 12
  xhci-pci-subclass : Integer = 3
  xhci-pci-progif : Integer = 48

Section: Capability Registers (offsets from BAR0)
  xhci-cap-length : Integer = 0
  xhci-cap-hci-version : Integer = 2
  xhci-cap-hcs-params1 : Integer = 4
  xhci-cap-hcs-params2 : Integer = 8
  xhci-cap-hcs-params3 : Integer = 12
  xhci-cap-hcc-params1 : Integer = 16
  xhci-cap-db-offset : Integer = 20
  xhci-cap-rts-offset : Integer = 24

Section: Operational Registers (offsets from op-base)
  xhci-op-usbcmd : Integer = 0
  xhci-op-usbsts : Integer = 4
  xhci-op-pagesize : Integer = 8
  xhci-op-dnctrl : Integer = 20
  xhci-op-crcr : Integer = 24
  xhci-op-dcbaap : Integer = 48
  xhci-op-config : Integer = 56

Section: Command Bits
  xhci-cmd-run : Integer = 1
  xhci-cmd-hcrst : Integer = 2
  xhci-cmd-inte : Integer = 4
  xhci-sts-hch : Integer = 1

Section: TRB Types
  trb-normal : Integer = 1
  trb-setup : Integer = 2
  trb-data : Integer = 3
  trb-status : Integer = 4
  trb-link : Integer = 6
  trb-enable-slot : Integer = 9
  trb-address-device : Integer = 11
  trb-configure-endpoint : Integer = 12
  trb-evaluate-context : Integer = 13
  trb-noop-command : Integer = 23

  trb-command-completion : Integer = 33

Section: Controller State
  XhciController = record {
    xc-bar : Integer,
    xc-cap-length : Integer,
    xc-op-base : Integer,
    xc-rt-base : Integer,
    xc-db-base : Integer,
    xc-max-slots : Integer between 0 and 255,
    xc-max-ports : Integer between 0 and 255,
    xc-found : Boolean,
    xc-initialized : Boolean
  }

Section: Discovery
  xhci-discover : XhciController
  xhci-discover =
    let scan = pci-scan-bus 0
    in let found = pci-find-class scan xhci-pci-class xhci-pci-subclass
    in when found
      is None -> XhciController { xc-bar = 0, xc-cap-length = 0, xc-op-base = 0, xc-rt-base = 0, xc-db-base = 0, xc-max-slots = 0, xc-max-ports = 0, xc-found = False, xc-initialized = False }
      is Just (dev) ->
        let bar = pci-parse-bar (dev.pci-bus) (dev.pci-dev) (dev.pci-func) 0
        in let base = bar.bar-base
        in let cap-len = 0
        in XhciController { xc-bar = base, xc-cap-length = cap-len, xc-op-base = base + 32, xc-rt-base = base + 1024, xc-db-base = base + 2048, xc-max-slots = 32, xc-max-ports = 4, xc-found = True, xc-initialized = False }

  xhci-controller-empty : XhciController
  xhci-controller-empty = XhciController { xc-bar = 0, xc-cap-length = 0, xc-op-base = 0, xc-rt-base = 0, xc-db-base = 0, xc-max-slots = 0, xc-max-ports = 0, xc-found = False, xc-initialized = False }

Section: TRB (Transfer Request Block)
  Trb = record {
    trb-param-lo : Integer,
    trb-param-hi : Integer,
    trb-status : Integer,
    trb-control : Integer
  }

  trb-new : Integer, Integer, Integer, Integer -> Trb
  trb-new (param-lo) (param-hi) (status) (control) = Trb { trb-param-lo = param-lo, trb-param-hi = param-hi, trb-status = status, trb-control = control }

  trb-enable-slot-cmd : Trb
  trb-enable-slot-cmd = Trb { trb-param-lo = 0, trb-param-hi = 0, trb-status = 0, trb-control = bit-shl trb-enable-slot 10 }

  trb-noop : Trb
  trb-noop = Trb { trb-param-lo = 0, trb-param-hi = 0, trb-status = 0, trb-control = bit-shl trb-noop-command 10 }

  trb-setup-stage : UsbSetupPacket -> Trb
  trb-setup-stage (pkt) =
    let bytes = usb-encode-setup pkt
    in let lo = xhci-pack-u32 bytes 0
    in let hi = xhci-pack-u32 bytes 4
    in Trb { trb-param-lo = lo, trb-param-hi = hi, trb-status = 8, trb-control = bit-or (bit-shl trb-setup 10) 64 }

  trb-data-stage : Integer, Integer, Integer -> Trb
  trb-data-stage (addr) (length) (dir) =
    Trb { trb-param-lo = addr, trb-param-hi = 0, trb-status = length, trb-control = bit-or (bit-shl trb-data 10) (bit-or 32 (bit-shl dir 16)) }

  trb-status-stage : Integer -> Trb
  trb-status-stage (dir) =
    Trb { trb-param-lo = 0, trb-param-hi = 0, trb-status = 0, trb-control = bit-or (bit-shl trb-status 10) (bit-or 32 (bit-shl dir 16)) }

  trb-normal-data : Integer, Integer -> Trb
  trb-normal-data (addr) (length) =
    Trb { trb-param-lo = addr, trb-param-hi = 0, trb-status = length, trb-control = bit-or (bit-shl trb-normal 10) 32 }

  xhci-set-cycle : Trb, Integer -> Trb
  xhci-set-cycle (trb) (cycle) =
    Trb { trb-param-lo = trb.trb-param-lo, trb-param-hi = trb.trb-param-hi, trb-status = trb.trb-status, trb-control = bit-or (bit-and (trb.trb-control) (0 - 2)) cycle }

Section: Event Ring

  xhci-event-ring-addr : Integer = 2117632
  xhci-event-ring-size : Integer = 64
  xhci-erst-addr : Integer = 2121728

  xhci-init-event-ring : XhciController -> Integer
  xhci-init-event-ring (xc) =
    let rt = xc.xc-rt-base
    in let w0 = poke-32 (xhci-erst-addr) 0 xhci-event-ring-addr
    in let w1 = poke-32 (xhci-erst-addr) 4 0
    in let w2 = poke-32 (xhci-erst-addr) 8 xhci-event-ring-size
    in let w3 = poke-32 rt 40 xhci-event-ring-size
    in let w4 = poke-32 rt 48 xhci-erst-addr
    in let w5 = poke-32 rt 52 0
    in w0 + w1 + w2 + w3 + w4 + w5

  xhci-poll-event : XhciController, Integer -> Maybe Trb
  xhci-poll-event (xc) (index) =
    let trb = xhci-read-trb xhci-event-ring-addr index
    in if trb.trb-control == 0 then None
    else Just trb

Section: Event Helpers
  xhci-event-trb-type : Trb -> Integer
  xhci-event-trb-type (trb) = bit-and (bit-shru (trb.trb-control) 10) 63

  xhci-event-slot-id : Trb -> Integer
  xhci-event-slot-id (trb) = bit-and (bit-shru (trb.trb-control) 24) 255

  xhci-event-completion-code : Trb -> Integer
  xhci-event-completion-code (trb) = bit-and (bit-shru (trb.trb-status) 24) 255

  trb-encode : Trb -> List Integer
  trb-encode (trb) = xhci-le32 (trb.trb-param-lo) & xhci-le32 (trb.trb-param-hi) & xhci-le32 (trb.trb-status) & xhci-le32 (trb.trb-control)

Section: Device Slot
  XhciSlot = record {
    xs-slot-id : Integer between 1 and 255,
    xs-port : Integer between 1 and 255,
    xs-address : Integer,
    xs-speed : Integer between 0 and 5,
    xs-configured : Boolean
  }

  xhci-slot-new : Integer, Integer -> XhciSlot
  xhci-slot-new (slot-id) (port) = XhciSlot { xs-slot-id = __narrow slot-id, xs-port = __narrow port, xs-address = 0, xs-speed = 0, xs-configured = False }

Section: Port Status
  XhciPort = record {
    xp-number : Integer between 1 and 255,
    xp-connected : Boolean,
    xp-enabled : Boolean,
    xp-speed : Integer between 0 and 5
  }

  xhci-port-status : Integer, Integer -> XhciPort
  xhci-port-status (port-num) (portsc) =
    XhciPort { xp-number = __narrow port-num, xp-connected = bit-and portsc 1 > 0, xp-enabled = bit-and portsc 2 > 0, xp-speed = __narrow (bit-and (bit-shru portsc 10) 15) }

  xhci-speed-name : Integer -> Text
  xhci-speed-name (speed) =
    if speed == 1 then "Full (12Mbps)"
    else if speed == 2 then "Low (1.5Mbps)"
    else if speed == 3 then "High (480Mbps)"
    else if speed == 4 then "Super (5Gbps)"
    else if speed == 5 then "Super+ (10Gbps)"
    else "Unknown"

Section: Helpers
  xhci-le32 : Integer -> List Integer
  xhci-le32 (v) = [bit-and v 255, bit-and (bit-shru v 8) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 24) 255]

  xhci-pack-u32 : List Integer, Integer -> Integer
  xhci-pack-u32 (bytes) (off) =
    bit-or (list-at bytes off) (bit-or (bit-shl (list-at bytes (off + 1)) 8) (bit-or (bit-shl (list-at bytes (off + 2)) 16) (bit-shl (list-at bytes (off + 3)) 24)))

Section: Ring Management

  xhci-cmd-ring-addr : Integer = 2097152
  xhci-cmd-ring-size : Integer = 256

  xhci-write-trb : Integer, Integer, Trb -> Integer
  xhci-write-trb (ring-addr) (index) (trb) =
    let off = index * 16
    in let w0 = poke-32 ring-addr off (trb.trb-param-lo)
    in let w1 = poke-32 ring-addr (off + 4) (trb.trb-param-hi)
    in let w2 = poke-32 ring-addr (off + 8) (trb.trb-status)
    in let w3 = poke-32 ring-addr (off + 12) (trb.trb-control)
    in w0 + w1 + w2 + w3

  xhci-read-trb : Integer, Integer -> Trb
  xhci-read-trb (ring-addr) (index) =
    let off = index * 16
    in Trb { trb-param-lo = peek-32 ring-addr off, trb-param-hi = peek-32 ring-addr (off + 4), trb-status = peek-32 ring-addr (off + 8), trb-control = peek-32 ring-addr (off + 12) }

  xhci-ring-doorbell : XhciController, Integer, Integer -> Integer
  xhci-ring-doorbell (xc) (slot) (endpoint) =
    poke-32 (xc.xc-db-base) (slot * 4) endpoint

Section: Controller Init

  xhci-transfer-ring-addr : Integer = 2101248
  xhci-dcbaap-addr : Integer = 2105344
  xhci-slot-ctx-addr : Integer = 2109440
  xhci-data-buf-addr : Integer = 2113536

  xhci-init-controller : XhciController -> XhciController
  xhci-init-controller (xc) =
    if xc.xc-found == False then xc
    else let op = xc.xc-op-base
    in let w0 = poke-32 op 0 2
    in let w1 = xhci-wait-halted op 0
    in let w2 = poke-32 op 0 0
    in let w3 = poke-32 op 24 xhci-cmd-ring-addr
    in let w4 = poke-32 op 28 0
    in let w5 = poke-32 op 48 xhci-dcbaap-addr
    in let w6 = poke-32 op 52 0
    in let w7 = poke-32 op 56 32
    in let w8 = poke-32 op 0 1
    in __record-set xc "xc-initialized" True

  xhci-wait-halted : Integer, Integer -> Integer
  xhci-wait-halted (op) (tries) =
    if tries > 1000 then 0
    else let sts = peek-32 op 4
    in if bit-and sts 1 > 0 then 0
    else xhci-wait-halted op (tries + 1)

Section: Slot Enable

  usb-enable-slot : XhciController, Integer -> Integer
  usb-enable-slot (xc) (port) =
    if xc.xc-initialized == False then 0
    else let trb = trb-enable-slot-cmd
    in let w = xhci-write-trb xhci-cmd-ring-addr 0 (xhci-set-cycle trb 1)
    in let db = xhci-ring-doorbell xc 0 0
    in 1

Section: Control Transfer

  usb-control-transfer : Integer, UsbSetupPacket -> Integer
  usb-control-transfer (slot) (setup) = 0

  usb-control-transfer-xc : XhciController, Integer, UsbSetupPacket -> Integer
  usb-control-transfer-xc (xc) (slot) (setup) =
    if xc.xc-initialized == False then 0
    else let setup-trb = trb-setup-stage setup
    in let status-trb = trb-status-stage 1
    in let w0 = xhci-write-trb xhci-transfer-ring-addr 0 (xhci-set-cycle setup-trb 1)
    in let w1 = xhci-write-trb xhci-transfer-ring-addr 1 (xhci-set-cycle status-trb 1)
    in let db = xhci-ring-doorbell xc slot 1
    in 0

Section: Control Transfer with Data

  usb-control-read-xc : XhciController, Integer, UsbSetupPacket, Integer -> List Integer
  usb-control-read-xc (xc) (slot) (setup) (length) =
    if xc.xc-initialized == False then []
    else let setup-trb = trb-setup-stage setup
    in let data-trb = trb-data-stage xhci-data-buf-addr length 1
    in let status-trb = trb-status-stage 0
    in let w0 = xhci-write-trb xhci-transfer-ring-addr 0 (xhci-set-cycle setup-trb 1)
    in let w1 = xhci-write-trb xhci-transfer-ring-addr 1 (xhci-set-cycle data-trb 1)
    in let w2 = xhci-write-trb xhci-transfer-ring-addr 2 (xhci-set-cycle status-trb 1)
    in let db = xhci-ring-doorbell xc slot 1
    in xhci-read-buf xhci-data-buf-addr 0 length []

  xhci-read-buf : Integer, Integer, Integer, List Integer -> List Integer
  xhci-read-buf (addr) (off) (len) (acc) =
    if off >= len then acc
    else xhci-read-buf addr (off + 1) len (list-push acc (peek-byte addr off))

Section: Get Config Descriptor

  usb-get-config-desc : Integer -> List Integer
  usb-get-config-desc (slot) = []

  usb-get-config-desc-xc : XhciController, Integer -> List Integer
  usb-get-config-desc-xc (xc) (slot) =
    let setup = usb-setup-get-descriptor 2 0 255
    in usb-control-read-xc xc slot setup 255

Section: Get Device Descriptor

  usb-get-device-desc-xc : XhciController, Integer -> List Integer
  usb-get-device-desc-xc (xc) (slot) =
    let setup = usb-setup-get-descriptor 1 0 18
    in usb-control-read-xc xc slot setup 18

Section: Bulk Transfers

  usb-bulk-out : Integer, Integer, List Integer -> Integer
  usb-bulk-out (slot) (endpoint) (data) = 0

  usb-bulk-in : Integer, Integer, Integer -> List Integer
  usb-bulk-in (slot) (endpoint) (length) = []

  usb-bulk-out-xc : XhciController, Integer, Integer, List Integer -> Integer
  usb-bulk-out-xc (xc) (slot) (endpoint) (data) =
    if xc.xc-initialized == False then 0
    else let len = list-length data
    in let w = xhci-write-data xhci-data-buf-addr 0 data
    in let trb = trb-normal-data xhci-data-buf-addr len
    in let w1 = xhci-write-trb xhci-transfer-ring-addr 0 (xhci-set-cycle trb 1)
    in let db = xhci-ring-doorbell xc slot (endpoint * 2 + 1)
    in 0

  usb-bulk-in-xc : XhciController, Integer, Integer, Integer -> List Integer
  usb-bulk-in-xc (xc) (slot) (endpoint) (length) =
    if xc.xc-initialized == False then []
    else let trb = trb-normal-data xhci-data-buf-addr length
    in let w = xhci-write-trb xhci-transfer-ring-addr 0 (xhci-set-cycle trb 1)
    in let db = xhci-ring-doorbell xc slot (endpoint * 2)
    in xhci-read-buf xhci-data-buf-addr 0 length []

  xhci-write-data : Integer, Integer, List Integer -> Integer
  xhci-write-data (addr) (off) (data) =
    if list-length data <= off then 0
    else let w = poke-byte addr off (list-at data off)
    in w + xhci-write-data addr (off + 1) data

Section: Formatting
  format-xhci : XhciController -> Text
  format-xhci (xc) =
    if xc.xc-found then "xhci at " & pci-hex16 (bit-shru (xc.xc-bar) 16) & pci-hex16 (bit-and (xc.xc-bar) 65535) & " slots=" & show (xc.xc-max-slots) & " ports=" & show (xc.xc-max-ports)
    else "xhci: not found"

  format-xhci-port : XhciPort -> Text
  format-xhci-port (p) =
    "port" & show (p.xp-number) & ": " & (if p.xp-connected then "connected" else "empty") & " " & xhci-speed-name (p.xp-speed)

