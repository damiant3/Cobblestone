Chapter: VirtioNetX86
  cites Kernel chapter VirtioPciX86
  cites Kernel chapter Pci
  cites Foreword chapter Result
  cites Foreword chapter Maybe

 Modern virtio-net uses the 12-byte header, including num_buffers without
 MRG_RXBUF (VIRTIO 1.2 sections 5.1.6.1 through 5.1.6.4). Only MAC and
 VERSION_1 are negotiated: no checksum/segmentation or merged-buffer offload.
 The MAC-only QEMU profile leaves num_buffers zero. Zero and one both
 describe the single completed descriptor here; larger counts are refused.

  vnx-magic : Integer = #31584E56
  vnx-rx-q : Integer = 8
  vnx-tx-q : Integer = 80
  vnx-buffer-size : Integer = 2048
  vnx-header-size : Integer = 12
  vnx-frame-cap : Integer = 1522
  vnx-rx-count : Integer = 32
  vnx-tx-fuel : Integer = 10000000

 The 256-byte control block owns flattened VpxQueue metadata and DMA
 pointers. Empty polls read the used index without allocating a wrapper.
 Nonempty polls reconstruct a queue inside a scratch mark, save its integer
 metadata, and reclaim that wrapper before returning. No pointer into that
 scratch region enters the control block.

  vnx-save-queue : Integer, Integer, VpxQueue -> Integer
  vnx-save-queue (base) (at) (q) =
    let a = poke-qword base at q.desc
    in let b = poke-qword base (at + 8) q.avail
    in let c = poke-qword base (at + 16) q.used
    in let d = poke-qword base (at + 24) q.size
    in let e = poke-qword base (at + 32) q.notify
    in let f = poke-qword base (at + 40) q.index
    in let g = poke-qword base (at + 48) q.avail-index
    in let h = poke-qword base (at + 56) q.last-used
    in poke-qword base (at + 64) q.fault

  vnx-load-queue : Integer, Integer -> VpxQueue
  vnx-load-queue (base) (at) = VpxQueue {
    desc = peek-qword base at, avail = peek-qword base (at + 8),
    used = peek-qword base (at + 16), size = peek-qword base (at + 24),
    notify = peek-qword base (at + 32), index = peek-qword base (at + 40),
    avail-index = peek-qword base (at + 48), last-used = peek-qword base (at + 56),
    fault = peek-qword base (at + 64)
  }

  vnx-device-id : PciDevice -> Boolean
  vnx-device-id (d) = d.pci-vendor == #1AF4 & (d.pci-device-id == #1041 | d.pci-device-id == #1000)

  vnx-find-loop : List PciDevice, Integer -> Maybe PciDevice
  vnx-find-loop (devices) (i) =
    if i == list-length devices then None
    else let d = list-at devices i
    in if vnx-device-id d then Just d else vnx-find-loop devices (i + 1)

  vnx-find : PciScanResult -> Maybe PciDevice
  vnx-find (scan) = vnx-find-loop scan.devices 0

  vnx-mac-valid : Integer -> Boolean
  vnx-mac-valid (base) =
    bit-and (peek-byte base 0) 1 == 0 &
    (peek-byte base 0 /= 0 | peek-byte base 1 /= 0 | peek-byte base 2 /= 0 | peek-byte base 3 /= 0 | peek-byte base 4 /= 0 | peek-byte base 5 /= 0)

  vnx-desc : VpxQueue, Integer, Integer, Integer, Integer -> Integer
  vnx-desc (q) (id) (buffer) (length) (flags) =
    let at = id * 16
    in let a = vpx-w64 q.desc at buffer
    in let b = poke-32 q.desc (at + 8) length
    in let c = poke-16 q.desc (at + 12) flags
    in poke-16 q.desc (at + 14) 0

  vnx-fill-rx : VpxQueue, Integer, Integer -> Boolean
  vnx-fill-rx (q) (buffers) (i) =
    if i == vnx-rx-count then True
    else let desc = vnx-desc q i (buffers + i * vnx-buffer-size) vnx-buffer-size 2
    in if vpx-publish q i /= 0 then False else vnx-fill-rx q buffers (i + 1)

  vnx-copy-mac : VpxDevice, Integer, Integer -> Integer
  vnx-copy-mac (d) (base) (i) =
    if i == 6 then 0
    else let saved = poke-byte base (200 + i) (peek-byte d.config i)
    in vnx-copy-mac d base (i + 1)

  vnx-allocate : VpxDevice, VpxQueue, VpxQueue -> Result Integer Text
  vnx-allocate (d) (rx) (tx) =
    let base = alloc-bytes 256
    in let zero = vpx-zero base 256 0
    in let buffers = alloc-bytes (vnx-rx-count * vnx-buffer-size)
    in let tx-buffer = alloc-bytes vnx-buffer-size
    in let completion = alloc-bytes 8
    in let cleared = vpx-zero buffers (vnx-rx-count * vnx-buffer-size) 0
    in let clear-tx = vpx-zero tx-buffer vnx-buffer-size 0
    in let a = poke-qword base 0 vnx-magic
    in let b = poke-qword base 160 buffers
    in let c = poke-qword base 168 tx-buffer
    in let e = poke-qword base 176 completion
    in let common = poke-qword base 208 d.common
    in let generation = peek-byte d.common 21
    in let mac = vnx-copy-mac d base 0
    in if peek-byte d.common 21 /= generation | not (vnx-mac-valid (base + 200)) then Err "virtio net MAC changed or invalid"
    else if not (vnx-fill-rx rx buffers 0) then Err "virtio net receive publication failed"
    else let r = vnx-save-queue base vnx-rx-q rx
    in let t = vnx-save-queue base vnx-tx-q tx
    in let ready = vpx-ready d
    in Ok base

  vnx-init : PciDevice -> Result Integer Text
  vnx-init (pci) =
    if not (vnx-device-id pci) then Err "not a virtio network device"
    else when vpx-open pci
      is Err (e) -> Err e
      is Ok (d) ->
        if d.config-size < 6 then Err "virtio net MAC configuration truncated"
        else when vpx-reset d
          is Err (e) -> Err e
          is Ok (features) ->
            if bit-and features.low 32 == 0 then Err "virtio net MAC feature absent"
            else when vpx-accept d 32 1
              is Err (e) -> Err e
              is Ok (accepted) -> when vpx-queue d 0 vnx-rx-count
                is Err (e) -> Err e
                is Ok (rx) -> when vpx-queue d 1 8
                  is Err (e) -> Err e
                  is Ok (tx) -> vnx-allocate d rx tx

  vnx-valid : Integer -> Boolean
  vnx-valid (base) = if base == 0 then False else peek-qword base 0 == vnx-magic & peek-qword base 192 == 0

  vnx-fault : Integer -> Integer
  vnx-fault (base) = let fault = poke-qword base 192 1 in 0

  vnx-mac : Integer -> List Integer
  vnx-mac (base) =
    if not (vnx-valid base) then []
    else [peek-byte base 200,peek-byte base 201,peek-byte base 202,peek-byte base 203,peek-byte base 204,peek-byte base 205]

  vnx-pending : Integer -> Boolean
  vnx-pending (base) =
    if not (vnx-valid base) then False
    else peek-16 (peek-qword base (vnx-rx-q + 16)) 2 /= peek-qword base (vnx-rx-q + 56)

  vnx-copy-into : Integer, List Integer, Integer, Integer -> Integer
  vnx-copy-into (buffer) (dst) (length) (i) =
    if i == length then length
    else let saved = list-set-at dst i (peek-byte buffer (vnx-header-size + i))
    in vnx-copy-into buffer dst length (i + 1)

  vnx-receive : Integer, VpxQueue, List Integer -> Integer
  vnx-receive (base) (q) (dst) =
    let completion = peek-qword base 176
    in let got = vpx-take q completion
    in if got < 0 then vnx-fault base
    else if got == 0 then 0
    else let id = bit-and (peek-32 completion 0) #FFFFFFFF
    in let length = bit-and (peek-32 completion 4) #FFFFFFFF
    in if id >= vnx-rx-count | length > vnx-buffer-size then vnx-fault base
    else let buffer = peek-qword base 160 + id * vnx-buffer-size
    in let valid = length >= vnx-header-size + 14 & length <= vnx-header-size + vnx-frame-cap
    in let header = peek-byte buffer 0 == 0 & peek-byte buffer 1 == 0 & peek-16 buffer 10 <= 1
    in let size = if valid & header & length - vnx-header-size <= list-length dst then length - vnx-header-size else 0
    in let copied = if size > 0 then vnx-copy-into buffer dst size 0 else 0
    in let counted = if size > 0 then poke-qword base 216 (peek-qword base 216 + 1) else poke-qword base 232 (peek-qword base 232 + 1)
    in if vpx-publish q id /= 0 then vnx-fault base else copied

  vnx-recv-into : Integer, List Integer -> Integer
  vnx-recv-into (base) (dst) =
    if not (vnx-pending base) then 0
    else let mark = __heap-save
    in let q = vnx-load-queue base vnx-rx-q
    in let n = vnx-receive base q dst
    in let saved = vnx-save-queue base vnx-rx-q q
    in let restored = __heap-restore mark
    in n

  vnx-zeros : Integer, List Integer -> List Integer
  vnx-zeros (left) (acc) = if left <= 0 then acc else vnx-zeros (left - 1) (list-push acc 0)

  vnx-prefix : List Integer, Integer, Integer, List Integer -> List Integer
  vnx-prefix (src) (i) (length) (acc) = if i == length then acc else vnx-prefix src (i + 1) length (list-push acc (list-at src i))

  vnx-recv-frame : Integer -> List Integer
  vnx-recv-frame (base) =
    if not (vnx-pending base) then []
    else let dst = vnx-zeros vnx-frame-cap (__list-with-capacity vnx-frame-cap)
    in let n = vnx-recv-into base dst
    in vnx-prefix dst 0 n (__list-with-capacity n)

  vnx-octets : List Integer, Integer -> Boolean
  vnx-octets (frame) (i) =
    if i == list-length frame then True
    else let byte = list-at frame i
    in if byte < 0 | byte > 255 then False else vnx-octets frame (i + 1)

  vnx-write-frame : Integer, List Integer, Integer -> Integer
  vnx-write-frame (buffer) (frame) (i) =
    if i == list-length frame then 0
    else let saved = poke-byte buffer (vnx-header-size + i) (list-at frame i)
    in vnx-write-frame buffer frame (i + 1)

  vnx-await-tx : Integer, VpxQueue, Integer -> Integer
  vnx-await-tx (base) (q) (left) =
    let completion = peek-qword base 176
    in let got = vpx-take q completion
    in if got < 0 then vnx-fault base
    else if got == 1 then
      if peek-32 completion 0 /= 0 | peek-32 completion 4 /= 0 then vnx-fault base
      else let count = poke-qword base 224 (peek-qword base 224 + 1) in 1
    else if left <= 0 then vnx-fault base else vnx-await-tx base q (left - 1)

  vnx-send : Integer, List Integer -> Integer
  vnx-send (base) (frame) =
    if not (vnx-valid base) then 0
    else if list-length frame < 14 | list-length frame > vnx-frame-cap | not (vnx-octets frame 0) then 0
    else let mark = __heap-save
    in let q = vnx-load-queue base vnx-tx-q
    in let buffer = peek-qword base 168
    in let zero = vpx-zero buffer vnx-header-size 0
    in let written = vnx-write-frame buffer frame 0
    in let desc = vnx-desc q 0 buffer (vnx-header-size + list-length frame) 0
    in let sent = if vpx-publish q 0 /= 0 then vnx-fault base else vnx-await-tx base q vnx-tx-fuel
    in let saved = vnx-save-queue base vnx-tx-q q
    in let restored = __heap-restore mark
    in sent
