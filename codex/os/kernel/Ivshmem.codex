Chapter: Ivshmem
  cites Kernel chapter Pci
  cites Kernel chapter MmioMapX86
  cites Foreword chapter Maybe
  cites Foreword chapter Result

 QEMU's ivshmem spec (docs/specs/ivshmem-spec.rst, "The ivshmem PCI device's
 guest interface"): vendor 1af4, device 1110, revision 1; "BAR0 holds device
 registers (256 Byte MMIO)", "BAR2 maps the shared memory object". The spec
 states neither BAR2's width nor its size, so both 32- and 64-bit memory BARs
 are taken and the size is read by probing.

Section: Constants
  ivshmem-vendor : Integer = 6900
  ivshmem-device : Integer = 4368

  ivshmem-shm-bar : Integer = 2

Section: State
  IvshmemDev = record {
    shm-base : Integer,
    shm-size : Integer,
    shm-found : Boolean,
    shm-error : Text
  }

  ivshmem-not-found : IvshmemDev
  ivshmem-not-found = ivshmem-refused "ivshmem device absent"

  ivshmem-refused : Text -> IvshmemDev
  ivshmem-refused (why) = IvshmemDev { shm-base = 0, shm-size = 0, shm-found = False, shm-error = why }

Section: Initialization
  ivshmem-config : PciDevice, Integer -> Integer
  ivshmem-config (d) (offset) = bit-and (pci-read-config d.pci-bus d.pci-dev d.pci-func offset) #FFFFFFFF

  ivshmem-config-write : PciDevice, Integer, Integer -> Integer
  ivshmem-config-write (d) (offset) (value) = pci-write-config d.pci-bus d.pci-dev d.pci-func offset value

  ivshmem-region : PciDevice -> IvshmemDev
  ivshmem-region (d) =
    let offset = 16 + ivshmem-shm-bar * 4
    in let low = ivshmem-config d offset
    in let wide = bit-and low 6 == 4
    in if bit-and low 1 /= 0 | (bit-and low 6 /= 0 & not wide) then ivshmem-refused "ivshmem BAR2 is not a memory BAR"
    else let high = if wide then ivshmem-config d (offset + 4) else 0
    in if high >= 32768 then ivshmem-refused "ivshmem BAR2 outside canonical memory"
    else let base = bit-and low #FFFFFFF0 + high * #100000000
    in if base < #C0000000 then ivshmem-refused "ivshmem BAR2 unassigned or inside runtime RAM"
    else let command = bit-and (ivshmem-config d 4) 65535
    in let disabled = ivshmem-config-write d 4 (bit-and command #FFF8)
    in let probe-low = ivshmem-config-write d offset #FFFFFFFF
    in let probe-high = if wide then ivshmem-config-write d (offset + 4) #FFFFFFFF else 0
    in let mask = bit-and (ivshmem-config d offset) #FFFFFFF0
    in let high-mask = if wide then ivshmem-config d (offset + 4) else #FFFFFFFF
    in let restore-low = ivshmem-config-write d offset low
    in let restore-high = if wide then ivshmem-config-write d (offset + 4) high else 0
    in let restored = ivshmem-config-write d 4 command
    in let size = #100000000 - mask
    in if mask == 0 | high-mask /= #FFFFFFFF then ivshmem-refused "ivshmem BAR2 extent invalid"
    else when mx-check-window base size
      is Err (why) -> ivshmem-refused why
      is Ok (mapped) -> IvshmemDev { shm-base = base, shm-size = size, shm-found = True, shm-error = "" }

  ivshmem-init : IvshmemDev
  ivshmem-init =
    let scan = pci-scan-bus 0
    in let found = pci-find-device scan ivshmem-vendor ivshmem-device
    in when found
      is None -> ivshmem-not-found
      is Just (dev) ->
        let enabled = pci-enable-device dev
        in ivshmem-region dev

Section: MMIO Access
  shm-fits : IvshmemDev, Integer, Integer -> Boolean
  shm-fits (dev) (offset) (len) = dev.shm-found & offset >= 0 & len >= 0 & len <= dev.shm-size - offset

  shm-read-32 : IvshmemDev, Integer -> Integer
  shm-read-32 (dev) (offset) = if shm-fits dev offset 4 then peek-32 (dev.shm-base) offset else -1

  shm-write-32 : IvshmemDev, Integer, Integer -> Integer
  shm-write-32 (dev) (offset) (value) = if shm-fits dev offset 4 then poke-32 (dev.shm-base) offset value else -1

  shm-read-byte : IvshmemDev, Integer -> Integer
  shm-read-byte (dev) (offset) = if shm-fits dev offset 1 then peek-byte (dev.shm-base) offset else -1

  shm-write-byte : IvshmemDev, Integer, Integer -> Integer
  shm-write-byte (dev) (offset) (value) = if shm-fits dev offset 1 then poke-byte (dev.shm-base) offset value else -1

Section: Block Operations
  shm-write-bytes : IvshmemDev, Integer, List Integer, Integer, Integer -> Integer
  shm-write-bytes (dev) (offset) (data) (i) (len) =
    if shm-fits dev offset len == False then -1
    else shm-write-loop dev offset data i len

  shm-write-loop : IvshmemDev, Integer, List Integer, Integer, Integer -> Integer
  shm-write-loop (dev) (offset) (data) (i) (len) =
    if i >= len then 0
    else let w = poke-byte (dev.shm-base) (offset + i) (list-at data i)
    in shm-write-loop dev offset data (i + 1) len

  shm-read-bytes : IvshmemDev, Integer, Integer -> List Integer
  shm-read-bytes (dev) (offset) (len) =
    if shm-fits dev offset len == False then []
    else shm-read-loop dev offset len 0 []

  shm-read-loop : IvshmemDev, Integer, Integer, Integer, List Integer -> List Integer
  shm-read-loop (dev) (offset) (len) (i) (acc) =
    if i >= len then acc
    else shm-read-loop dev offset len (i + 1) (list-push acc (peek-byte (dev.shm-base) (offset + i)))

Section: Formatting
  format-ivshmem : IvshmemDev -> Text
  format-ivshmem (dev) =
    if dev.shm-found then
      "ivshmem at " & pci-hex16 (bit-shru (dev.shm-base) 48) & pci-hex16 (bit-and (bit-shru (dev.shm-base) 32) 65535)
      & pci-hex16 (bit-and (bit-shru (dev.shm-base) 16) 65535) & pci-hex16 (bit-and (dev.shm-base) 65535)
      & " size " & show (dev.shm-size)
    else "ivshmem refused: " & dev.shm-error

