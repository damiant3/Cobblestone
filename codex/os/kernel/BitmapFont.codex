Chapter: BitmapFont

 Codex Bitmap Font (CBF). 8x16 pixel glyphs indexed directly by
 CCE code (0-127). Font data lives in an alloc-bytes buffer for
 O(1) lookup: font-base + cce-code * 16 + row. No Unicode
 conversion needed at render time.

 We say:

Section: Constants
  cbf-glyph-height : Integer = 16
  cbf-glyph-width : Integer = 8
  cbf-glyph-count : Integer = 128
  cbf-data-size : Integer = 2048

Section: Font Handle
  CbfFont = record { cbf-base : Integer }

Section: Initialization
  cbf-init : CbfFont
  cbf-init =
    let base = alloc-bytes cbf-data-size
    in let w = cbf-write-all base
    in CbfFont { cbf-base = base + w - w }

Section: Glyph Lookup
  cbf-row : CbfFont, Integer, Integer -> Integer
  cbf-row (font) (cce) (row) =
    if cce < 0 then 0
    else if cce >= cbf-glyph-count then 0
    else if row < 0 then 0
    else if row >= cbf-glyph-height then 0
    else peek-byte (font.cbf-base) (cce * cbf-glyph-height + row)

  cbf-pixel : CbfFont, Integer, Integer, Integer -> Boolean
  cbf-pixel (font) (cce) (col) (row) =
    let glyph-byte = cbf-row font cce row
    in bit-and (bit-shru glyph-byte (7 - col)) 1 == 1

Section: Write All Glyphs
  cbf-write-all : Integer -> Integer
  cbf-write-all (base) =
    let w0 = cbf-write-whitespace base
    in let w1 = cbf-write-digits base
    in let w2 = cbf-write-lower base
    in let w3 = cbf-write-upper base
    in let w4 = cbf-write-punct base
    in let w5 = cbf-write-accented base
    in let w6 = cbf-write-cyrillic base
    in w0 + w1 + w2 + w3 + w4 + w5 + w6

Section: Whitespace (CCE 0-2)
  cbf-write-whitespace : Integer -> Integer
  cbf-write-whitespace (b) =
    let w0 = cbf-g b 0 0 0 0 0 0 0 0 0
    in let w1 = cbf-g b 1 0 0 0 0 0 0 0 0
    in let w2 = cbf-g b 2 0 0 0 0 0 0 0 0
    in w0 + w1 + w2

Section: Digits (CCE 3-12 -> 0-9)
  cbf-write-digits : Integer -> Integer
  cbf-write-digits (b) =
    let w0 = cbf-g b 3 60 102 110 118 102 102 60 0
    in let w1 = cbf-g b 4 24 56 24 24 24 24 126 0
    in let w2 = cbf-g b 5 60 102 6 12 24 48 126 0
    in let w3 = cbf-g b 6 60 102 6 28 6 102 60 0
    in let w4 = cbf-g b 7 12 28 44 108 126 12 12 0
    in let w5 = cbf-g b 8 126 96 124 6 6 102 60 0
    in let w6 = cbf-g b 9 60 96 96 124 102 102 60 0
    in let w7 = cbf-g b 10 126 6 12 24 48 48 48 0
    in let w8 = cbf-g b 11 60 102 102 60 102 102 60 0
    in let w9 = cbf-g b 12 60 102 102 62 6 6 60 0
    in w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 + w9

Section: Lowercase (CCE 13-38 -> e t a o i n s h r d l c u m w f g y p b v k j x q z)
  cbf-write-lower : Integer -> Integer
  cbf-write-lower (b) =
    let we = cbf-g b 13 0 0 60 102 126 96 60 0
    in let wt = cbf-g b 14 48 48 124 48 48 48 28 0
    in let wa = cbf-g b 15 0 0 60 6 62 102 62 0
    in let wo = cbf-g b 16 0 0 60 102 102 102 60 0
    in let wi = cbf-g b 17 24 0 56 24 24 24 60 0
    in let wn = cbf-g b 18 0 0 124 102 102 102 102 0
    in let ws = cbf-g b 19 0 0 62 96 60 6 124 0
    in let wh = cbf-g b 20 96 96 124 102 102 102 102 0
    in let wr = cbf-g b 21 0 0 124 102 96 96 96 0
    in let wd = cbf-g b 22 6 6 62 102 102 102 62 0
    in let wl = cbf-g b 23 56 24 24 24 24 24 60 0
    in let wc = cbf-g b 24 0 0 60 102 96 102 60 0
    in let wu = cbf-g b 25 0 0 102 102 102 102 62 0
    in let wm = cbf-g b 26 0 0 102 127 107 99 99 0
    in let ww = cbf-g b 27 0 0 99 99 107 127 54 0
    in let wf = cbf-g b 28 28 48 48 124 48 48 48 0
    in let wg = cbf-g b 29 0 0 62 102 102 62 6 60
    in let wy = cbf-g b 30 0 0 102 102 102 62 6 60
    in let wp = cbf-g b 31 0 0 124 102 102 124 96 96
    in let wb = cbf-g b 32 96 96 124 102 102 102 124 0
    in let wv = cbf-g b 33 0 0 102 102 102 60 24 0
    in let wk = cbf-g b 34 96 96 102 108 120 108 102 0
    in let wj = cbf-g b 35 12 0 28 12 12 12 108 56
    in let wx = cbf-g b 36 0 0 102 36 24 36 102 0
    in let wq = cbf-g b 37 0 0 62 102 102 62 6 6
    in let wz = cbf-g b 38 0 0 126 12 24 48 126 0
    in we + wt + wa + wo + wi + wn + ws + wh + wr + wd + wl + wc + wu + wm + ww + wf + wg + wy + wp + wb + wv + wk + wj + wx + wq + wz

Section: Uppercase (CCE 39-64 -> E T A O I N S H R D L C U M W F G Y P B V K J X Q Z)
