    in let wT = cbf-g b 40 126 24 24 24 24 24 24 0
    in let wA = cbf-g b 41 24 60 102 102 126 102 102 0
    in let wO = cbf-g b 42 60 102 102 102 102 102 60 0
    in let wI = cbf-g b 43 126 24 24 24 24 24 126 0
