    in let w94 = cbf-g b 94 24 60 102 0 0 0 0 0
    in let w95 = cbf-g b 95 24 60 102 0 0 0 0 0
    in let w96 = cbf-g b 96 24 60 102 0 0 0 0 0
    in w65 + w66 + w67 + w68 + w69 + w70 + w71 + w72 + w73 + w74 + w75 + w76 + w77 + w78 + w79 + w80 + w81 + w82 + w83 + w84 + w85 + w86 + w87 + w88 + w89 + w90 + w91 + w92 + w93 + w94 + w95 + w96

Section: Accented (CCE 97-112 -> approx glyphs)
  cbf-write-accented : Integer -> Integer
  cbf-write-accented (b) =
    let w97 = cbf-g b 97 12 24 60 102 126 96 60 0
    in let w98 = cbf-g b 98 48 24 60 102 126 96 60 0
    in let w99 = cbf-g b 99 24 0 60 102 126 96 60 0
    in let w100 = cbf-g b 100 24 0 60 102 126 96 60 0
    in let w101 = cbf-g b 101 12 24 60 6 62 102 62 0
    in let w102 = cbf-g b 102 48 24 60 6 62 102 62 0
    in let w103 = cbf-g b 103 24 0 60 6 62 102 62 0
    in let w104 = cbf-g b 104 24 0 60 6 62 102 62 0
    in let w105 = cbf-g b 105 12 24 60 102 102 102 60 0
    in let w106 = cbf-g b 106 24 0 60 102 102 102 60 0
    in let w107 = cbf-g b 107 24 0 60 102 102 102 60 0
    in let w108 = cbf-g b 108 12 24 102 102 102 102 62 0
    in let w109 = cbf-g b 109 24 0 102 102 102 102 62 0
    in let w110 = cbf-g b 110 0 0 124 102 102 102 102 0
    in let w111 = cbf-g b 111 0 0 60 102 96 102 60 0
    in let w112 = cbf-g b 112 24 0 56 24 24 24 60 0
    in w97 + w98 + w99 + w100 + w101 + w102 + w103 + w104 + w105 + w106 + w107 + w108 + w109 + w110 + w111 + w112

Section: Cyrillic (CCE 113-127 -> а о е и н т с р в л к м д п у)
  cbf-write-cyrillic : Integer -> Integer
  cbf-write-cyrillic (b) =
    let w113 = cbf-g b 113 0 0 60 6 62 102 62 0
    in let w114 = cbf-g b 114 0 0 60 102 102 102 60 0
    in let w115 = cbf-g b 115 0 0 60 102 126 96 60 0
    in let w116 = cbf-g b 116 0 0 124 102 102 102 102 0
    in let w117 = cbf-g b 117 0 0 124 102 102 102 102 0
    in let w118 = cbf-g b 118 126 24 24 24 24 24 24 0
    in let w119 = cbf-g b 119 0 0 62 96 60 6 124 0
    in let w120 = cbf-g b 120 0 0 124 102 96 96 96 0
    in let w121 = cbf-g b 121 0 0 102 102 102 60 24 0
    in let w122 = cbf-g b 122 56 24 24 24 24 24 60 0
    in let w123 = cbf-g b 123 96 96 102 108 120 108 102 0
    in let w124 = cbf-g b 124 0 0 102 127 107 99 99 0
    in let w125 = cbf-g b 125 6 6 62 102 102 102 62 0
    in let w126 = cbf-g b 126 0 0 124 102 102 124 96 96
    in let w127 = cbf-g b 127 0 0 102 102 102 102 62 0
    in w113 + w114 + w115 + w116 + w117 + w118 + w119 + w120 + w121 + w122 + w123 + w124 + w125 + w126 + w127

Section: Glyph Writer
  cbf-g : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cbf-g (base) (cce) (r2) (r3) (r4) (r5) (r6) (r7) (r8) (r9) =
    let off = cce * cbf-glyph-height
    in let w0 = poke-byte base off 0
    in let w1 = poke-byte base (off + 1) 0
    in let w2 = poke-byte base (off + 2) r2
    in let w3 = poke-byte base (off + 3) r3
    in let w4 = poke-byte base (off + 4) r4
    in let w5 = poke-byte base (off + 5) r5
    in let w6 = poke-byte base (off + 6) r6
    in let w7 = poke-byte base (off + 7) r7
    in let w8 = poke-byte base (off + 8) r8
    in let w9 = poke-byte base (off + 9) r9
    in let w10 = poke-byte base (off + 10) 0
    in let w11 = poke-byte base (off + 11) 0
    in let w12 = poke-byte base (off + 12) 0
    in let w13 = poke-byte base (off + 13) 0
    in let w14 = poke-byte base (off + 14) 0
    in let w15 = poke-byte base (off + 15) 0
    in w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 + w9 + w10 + w11 + w12 + w13 + w14 + w15

