    in let wS = cbf-g b 45 60 102 96 60 6 102 60 0
    in let wH = cbf-g b 46 102 102 102 126 102 102 102 0
    in let wR = cbf-g b 47 124 102 102 124 108 102 102 0
    in let wD = cbf-g b 48 120 108 102 102 102 108 120 0
    in let wL = cbf-g b 49 96 96 96 96 96 96 126 0
    in let wC = cbf-g b 50 60 102 96 96 96 102 60 0
    in let wU = cbf-g b 51 102 102 102 102 102 102 60 0
    in let wM = cbf-g b 52 99 119 127 107 99 99 99 0
    in let wW = cbf-g b 53 99 99 99 107 127 119 99 0
    in let wF = cbf-g b 54 126 96 96 124 96 96 96 0
    in let wG = cbf-g b 55 60 102 96 110 102 102 60 0
    in let wY = cbf-g b 56 102 102 102 60 24 24 24 0
    in let wP = cbf-g b 57 124 102 102 124 96 96 96 0
