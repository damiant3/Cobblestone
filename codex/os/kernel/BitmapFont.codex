    in wE + wT + wA + wO + wI + wN + wS + wH + wR + wD + wL + wC + wU + wM + wW + wF + wG + wY + wP + wB + wV + wK + wJ + wX + wQ + wZ

Section: Punctuation (CCE 65-96)
  cbf-write-punct : Integer -> Integer
  cbf-write-punct (b) =
    let w65 = cbf-g b 65 0 0 0 0 0 24 24 0
    in let w66 = cbf-g b 66 0 0 0 0 0 24 24 48
    in let w67 = cbf-g b 67 24 24 24 24 24 0 24 0
    in let w68 = cbf-g b 68 60 102 6 12 24 0 24 0
    in let w69 = cbf-g b 69 0 24 24 0 0 24 24 0
    in let w70 = cbf-g b 70 0 24 24 0 0 24 24 48
    in let w71 = cbf-g b 71 0 102 102 0 0 0 0 0
    in let w72 = cbf-g b 72 0 36 126 36 36 126 36 0
    in let w73 = cbf-g b 73 0 0 0 126 0 0 0 0
    in let w74 = cbf-g b 74 12 24 48 48 48 24 12 0
