    in let w77 = cbf-g b 77 0 0 126 0 126 0 0 0
    in let w78 = cbf-g b 78 0 102 60 255 60 102 0 0
    in let w79 = cbf-g b 79 6 12 24 48 24 12 6 0
    in let w80 = cbf-g b 80 96 48 24 12 24 48 96 0
    in let w81 = cbf-g b 81 6 12 24 48 96 192 0 0
    in let w82 = cbf-g b 82 60 102 110 110 96 98 60 0
    in let w83 = cbf-g b 83 0 36 126 36 36 126 36 0
    in let w84 = cbf-g b 84 0 0 0 38 0 0 0 0
    in let w85 = cbf-g b 85 0 0 0 0 0 0 126 0
    in let w86 = cbf-g b 86 192 96 48 24 12 6 0 0
    in let w87 = cbf-g b 87 24 24 24 24 24 24 24 24
