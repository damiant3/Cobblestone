Chapter: Pci
  cites Foreword chapter Maybe
  grounds Device.Port

 PCI Configuration Space access via I/O ports 0xCF8/0xCFC (CAM).
 Enumerates devices on bus 0, reads vendor/device IDs, class codes,
 BARs. Pure logic for address calculation; I/O port access uses
 builtins port-out-32 and port-in-32.

 We say:

Section: Constants
  pci-config-addr : Integer = 3320
  pci-config-data : Integer = 3324
  pci-vendor-nvidia : Integer = 4318
  pci-vendor-virtio : Integer = 6900
  pci-header-type-mask : Integer = 127

Section: Address Encoding
  pci-address : Integer, Integer, Integer, Integer -> Integer
  pci-address (bus) (device) (func) (offset) =
    bit-or 2147483648 (bit-or (bit-shl bus 16) (bit-or (bit-shl device 11) (bit-or (bit-shl func 8) (bit-and offset 252))))

Section: Device Info
  PciDevice = record {
    pci-bus : Integer between 0 and 255,
    pci-dev : Integer between 0 and 31,
    pci-func : Integer between 0 and 7,
    pci-vendor : Integer between 0 and 65535,
    pci-device-id : Integer between 0 and 65535,
    pci-class : Integer between 0 and 255,
    pci-subclass : Integer between 0 and 255,
    pci-header-type : Integer between 0 and 127
  }

  PciBar = record {
    bar-index : Integer between 0 and 5,
    bar-base : Integer,
    bar-is-io : Boolean,
    bar-is-64bit : Boolean
  }

Section: Device Scanning
  PciScanResult = record {
    devices : List PciDevice,
    count : Integer
  }

  pci-scan-bus : Integer -> PciScanResult
  pci-scan-bus (bus) = pci-scan-loop bus 0 0 [] 0

  pci-scan-loop : Integer, Integer, Integer, List PciDevice, Integer -> PciScanResult
  pci-scan-loop (bus) (dev) (func) (acc) (count) =
    if dev >= 32 then PciScanResult { devices = acc, count = count }
    else if func >= 8 then pci-scan-loop bus (dev + 1) 0 acc count
    else let vendor = pci-read-vendor bus dev func
    in if vendor == 65535 then
      if func == 0 then pci-scan-loop bus (dev + 1) 0 acc count
      else pci-scan-loop bus dev (func + 1) acc count
    else let device-id = pci-read-device-id bus dev func
    in let class-info = pci-read-class bus dev func
    in let hdr-type = pci-read-header-type bus dev func
    in let entry = PciDevice { pci-bus = __narrow bus, pci-dev = __narrow dev, pci-func = __narrow func, pci-vendor = __narrow vendor, pci-device-id = __narrow device-id, pci-class = __narrow (bit-and (bit-shru class-info 8) 255), pci-subclass = __narrow (bit-and class-info 255), pci-header-type = __narrow (bit-and hdr-type pci-header-type-mask) }
    in let multi = bit-and hdr-type 128 > 0
    in if func == 0 then
      if multi then pci-scan-loop bus dev 1 (list-push acc entry) (count + 1)
      else pci-scan-loop bus (dev + 1) 0 (list-push acc entry) (count + 1)
    else pci-scan-loop bus dev (func + 1) (list-push acc entry) (count + 1)

Section: The Whole Bus Tree

 `pci-scan-bus` answers ONE bus. A chipset-integrated part sits on bus 0
 and is found by it; a discrete part sits behind a PCI-to-PCI bridge, on a
 bus number only that bridge knows, and is not. Measured by fester under
 OVMF and recorded in `build/boot/diag/README.md`: with the only NIC behind
 a `pcie-root-port` the part is at `01:00.0` and bus 0 holds nothing but
 the bridge itself at `1b36:000c`. Scanning bus 0 alone returns an answer
 that looks complete and is empty, so anything asking "is there a NIC"
 must ask this instead.

 A header type of 1 is a bridge, and byte 24 bits 8..15 of its config
 space is the secondary bus it forwards to.

  pci-scan-max-depth : Integer = 3

  pci-sec-bus : PciDevice -> Integer
  pci-sec-bus (d) =
   bit-and (bit-shru (pci-read-config (d.pci-bus) (d.pci-dev) (d.pci-func) 24) 8) 255

  pci-scan-all : PciScanResult
  pci-scan-all =
   let devs = pci-collect 0 0 []
   in PciScanResult { devices = devs, count = list-length devs }

  pci-collect : Integer, Integer, List PciDevice -> List PciDevice
  pci-collect (bus) (depth) (acc) =
   if depth > pci-scan-max-depth then acc
   else let s = pci-scan-bus bus
   in pci-bridges (s.devices) (s.count) 0 bus depth (acc & s.devices)

  pci-bridges : List PciDevice, Integer, Integer, Integer, Integer, List PciDevice -> List PciDevice
  pci-bridges (devs) (n) (i) (bus) (depth) (acc) =
   if i >= n then acc
   else if (list-at devs i).pci-header-type == 1
   then pci-bridge-one (list-at devs i) devs n i bus depth acc
   else pci-bridges devs n (i + 1) bus depth acc

  pci-bridge-one : PciDevice, List PciDevice, Integer, Integer, Integer, Integer, List PciDevice -> List PciDevice
  pci-bridge-one (d) (devs) (n) (i) (bus) (depth) (acc) =
   let sec = pci-sec-bus d
   in if sec > bus
   then pci-bridges devs n (i + 1) bus depth (pci-collect sec (depth + 1) acc)
   else pci-bridges devs n (i + 1) bus depth acc

Section: Config Space Reads
  pci-read-config : Integer, Integer, Integer, Integer -> Integer
  pci-read-config (bus) (dev) (func) (offset) =
    let addr = pci-address bus dev func offset
    in pci-config-read-raw addr offset

  pci-config-read-raw : Integer, Integer -> Integer
  pci-config-read-raw (addr) (offset) =
    let w = port-out-32 pci-config-addr addr
    in w + port-in-32 pci-config-data

 Sizing a BAR is a write of all ones followed by a read: the device answers
 with its address bits held high and everything below its window clear, so
 the length is the complement of that mask plus one. The base must be
 written back afterwards, because sizing is a question and not a move.
 (pci-write-config is defined below, under PCI Config Write.)

  pci-bar-size : Integer, Integer, Integer, Integer -> Integer
  pci-bar-size (bus) (dev) (func) (bar-offset) =
    let base = pci-read-config bus dev func bar-offset
    in let q = pci-write-config bus dev func bar-offset (0 - 1)
    in let mask = pci-read-config bus dev func bar-offset
    in let r = pci-write-config bus dev func bar-offset base
    in if mask == 0 then 0
    else bit-and (0 - (bit-and mask (0 - 16))) 4294967295

  pci-read-vendor : Integer, Integer, Integer -> Integer
  pci-read-vendor (bus) (dev) (func) = bit-and (pci-read-config bus dev func 0) 65535

  pci-read-device-id : Integer, Integer, Integer -> Integer
  pci-read-device-id (bus) (dev) (func) = bit-shru (pci-read-config bus dev func 0) 16

  pci-read-class : Integer, Integer, Integer -> Integer
  pci-read-class (bus) (dev) (func) =
    let reg = pci-read-config bus dev func 8
    in bit-shru reg 16

  pci-read-header-type : Integer, Integer, Integer -> Integer
  pci-read-header-type (bus) (dev) (func) =
    let reg = pci-read-config bus dev func 12
    in bit-and (bit-shru reg 16) 255

  pci-read-bar : Integer, Integer, Integer, Integer -> Integer
  pci-read-bar (bus) (dev) (func) (bar-idx) = pci-read-config bus dev func (16 + bar-idx * 4)

Section: Device Queries
  pci-find-vendor : PciScanResult, Integer -> Maybe PciDevice
  pci-find-vendor (scan) (vendor) = pci-find-vendor-loop (scan.devices) vendor 0 (scan.count)

  pci-find-vendor-loop : List PciDevice, Integer, Integer, Integer -> Maybe PciDevice
  pci-find-vendor-loop (devs) (vendor) (i) (len) =
    if i >= len then None
    else let d = list-at devs i
    in if d.pci-vendor == vendor then Just d
    else pci-find-vendor-loop devs vendor (i + 1) len

  pci-find-class : PciScanResult, Integer, Integer -> Maybe PciDevice
  pci-find-class (scan) (cls) (subcls) = pci-find-class-loop (scan.devices) cls subcls 0 (scan.count)

  pci-find-class-loop : List PciDevice, Integer, Integer, Integer, Integer -> Maybe PciDevice
  pci-find-class-loop (devs) (cls) (subcls) (i) (len) =
    if i >= len then None
    else let d = list-at devs i
    in if d.pci-class == cls then if d.pci-subclass == subcls then Just d
      else pci-find-class-loop devs cls subcls (i + 1) len
    else pci-find-class-loop devs cls subcls (i + 1) len

  pci-index-class : PciScanResult, Integer, Integer, Integer -> Integer
  pci-index-class (scan) (cls) (subcls) (from) = pci-index-class-loop (scan.devices) cls subcls from (scan.count)

  pci-index-class-loop : List PciDevice, Integer, Integer, Integer, Integer -> Integer
  pci-index-class-loop (devs) (cls) (subcls) (i) (len) =
    if i >= len then -1
    else let d = list-at devs i
    in if d.pci-class == cls then if d.pci-subclass == subcls then i
      else pci-index-class-loop devs cls subcls (i + 1) len
    else pci-index-class-loop devs cls subcls (i + 1) len

  pci-count-class : PciScanResult, Integer, Integer -> Integer
  pci-count-class (scan) (cls) (subcls) = pci-count-class-loop (scan.devices) cls subcls 0 (scan.count) 0

  pci-count-class-loop : List PciDevice, Integer, Integer, Integer, Integer, Integer -> Integer
  pci-count-class-loop (devs) (cls) (subcls) (i) (len) (n) =
    if i >= len then n
    else let d = list-at devs i
    in if d.pci-class == cls then if d.pci-subclass == subcls then pci-count-class-loop devs cls subcls (i + 1) len (n + 1)
      else pci-count-class-loop devs cls subcls (i + 1) len n
    else pci-count-class-loop devs cls subcls (i + 1) len n

Section: Device ID Search
  pci-find-device : PciScanResult, Integer, Integer -> Maybe PciDevice
  pci-find-device (scan) (vendor) (device-id) = pci-find-dev-loop (scan.devices) vendor device-id 0 (scan.count)

  pci-find-dev-loop : List PciDevice, Integer, Integer, Integer, Integer -> Maybe PciDevice
  pci-find-dev-loop (devs) (vendor) (did) (i) (len) =
    if i >= len then None
    else let d = list-at devs i
    in if d.pci-vendor == vendor then if d.pci-device-id == did then Just d
      else pci-find-dev-loop devs vendor did (i + 1) len
    else pci-find-dev-loop devs vendor did (i + 1) len

Section: BAR Parsing
  pci-parse-bar : Integer, Integer, Integer, Integer -> PciBar
  pci-parse-bar (bus) (dev) (func) (bar-idx) =
    let raw = pci-read-bar bus dev func bar-idx
    in let is-io = bit-and raw 1 == 1
    in let is-64 = if is-io then False else bit-and (bit-shru raw 1) 3 == 2
    in let base = if is-io then bit-and raw 65532 else bit-and raw 4294967280
    in PciBar { bar-index = __narrow bar-idx, bar-base = base, bar-is-io = is-io, bar-is-64bit = is-64 }

Section: PCI Config Write
  pci-write-config : Integer, Integer, Integer, Integer, Integer -> Integer
  pci-write-config (bus) (dev) (func) (offset) (value) =
    let addr = pci-address bus dev func offset
    in let w = port-out-32 pci-config-addr addr
    in w + port-out-32 pci-config-data value

 Bringing a device up is three bits in the command register and not one:
 I/O space (1), memory space (2), and BUS MASTER (4). The third is what
 lets the device read and write host memory on its own initiative, which
 is how every card worth driving moves data -- a descriptor-ring NIC
 fetches its own descriptors and DMAs frame bodies, and with bus master
 clear it is enabled, addressable, silent, and gives no indication why.

  pci-enable-device : PciDevice -> Integer
  pci-enable-device (d) =
    let cmd = pci-read-config (d.pci-bus) (d.pci-dev) (d.pci-func) 4
    in let new-cmd = bit-or cmd 7
    in pci-write-config (d.pci-bus) (d.pci-dev) (d.pci-func) 4 new-cmd

Section: Formatting
  format-pci-device : PciDevice -> Text
  format-pci-device (d) =
    pci-hex16 (d.pci-vendor) & ":" & pci-hex16 (d.pci-device-id) & " class=" & show (d.pci-class) & "." & show (d.pci-subclass) & " at " & show (d.pci-bus) & ":" & show (d.pci-dev) & "." & show (d.pci-func)

  pci-hex16 : Integer -> Text
  pci-hex16 (v) = pci-nib (bit-and (bit-shru v 12) 15) & pci-nib (bit-and (bit-shru v 8) 15) & pci-nib (bit-and (bit-shru v 4) 15) & pci-nib (bit-and v 15)

  pci-nib : Integer -> Text
  pci-nib (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

