Chapter: Ne2k

 NE2000 NIC driver. Writes frames directly to the NE2000 data port
 via port I/O, matching the nic-ping test pattern.

Section: Constants

  ne2k-max-frame : Integer = 1536
  ne2k-cr-port : Integer = 768
  ne2k-tpsr-port : Integer = 772
  ne2k-tbcr0-port : Integer = 773
  ne2k-tbcr1-port : Integer = 774
  ne2k-isr-port : Integer = 775
  ne2k-rsar0-port : Integer = 776
  ne2k-rsar1-port : Integer = 777
  ne2k-rbcr0-port : Integer = 778
  ne2k-rbcr1-port : Integer = 779
  ne2k-data-port : Integer = 784
  ne2k-tx-page : Integer = 64

Section: Send

 The frame is staged byte-by-byte into the kernel TX buffer (plain
 memory writes), then net-send-raw moves it to the NIC with a single
 REP OUTSW - one VM exit instead of one exit per byte. net-send-raw
 sends length divided by two words, therefore an odd-length frame is
 padded with one zero byte; the trailing pad is outside the IP total
 length and every receiver ignores it.

  ne2k-tx-buf : Integer = 34592

  ne2k-stage-frame : List Integer, Integer, Integer -> Integer
  ne2k-stage-frame (bs) (i) (len) =
   if i >= len then i
   else let w = poke-byte ne2k-tx-buf i (list-at bs i)
   in ne2k-stage-frame bs (i + 1) len

  ne2k-send-frame : List Integer -> [Network.Write] Integer
  ne2k-send-frame (frame) =
   let len = list-length frame
   in if len > ne2k-max-frame then 0
   else let staged = ne2k-stage-frame frame 0 len
   in let pad = if int-mod len 2 == 1 then poke-byte ne2k-tx-buf len 0 else 0
   in net-send-raw ne2k-tx-buf (len + (int-mod len 2))

Section: Receive

  ne2k-recv-frame : [Network.Read] List Integer
  ne2k-recv-frame = act
   len <- net-recv-raw 33056
   if len <= 0 then [] else ne2k-read-from-buf 33056 0 len []
  end

  ne2k-read-from-buf : Integer, Integer, Integer, List Integer -> List Integer
  ne2k-read-from-buf (base) (i) (len) (acc) =
   if i >= len then acc
   else ne2k-read-from-buf base (i + 1) len (list-push acc (peek-byte base i))

Section: Status

  ne2k-available : [Network.Read] Boolean
  ne2k-available = net-status > 0

