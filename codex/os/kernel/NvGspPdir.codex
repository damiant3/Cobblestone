Chapter: NvGspPdir

 The SET_PAGE_DIRECTORY RPC payload (NV_VGPU_MSG_FUNCTION_SET_PAGE_DIRECTORY,
 54) as tinygrad builds it (tinygrad/runtime/support/nv/ip.py,
 rpc_set_page_directory, at c3aec477; structures in runtime/autogen/nv.py).
 rpc_set_page_directory_v1E_05 (48 bytes, little-endian): hClient 0, hDevice
 4, pasid 8, then NV0080_CTRL_DMA_SET_PAGE_DIRECTORY_PARAMS_v1E_05 at 16:
 physAddress 16 (64-bit), numEntries 24, flags 28 = 0x8 (all channels),
 hVASpace 32, chId 36 = 0, subDeviceId 40 = 1, pasid 44. Bytes 12..15 are
 zero.

Section: Payload

  nv-gsp-fn-set-page-directory : Integer
  nv-gsp-fn-set-page-directory = 54

  pdir-u32 : Integer -> List Integer
  pdir-u32 (v) = [bit-and v 255, bit-and (bit-shru v 8) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 24) 255]

  nv-gsp-set-page-directory : Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  nv-gsp-set-page-directory (client) (device) (vaspace) (pdir) (entries) (pasid) =
    let head = pdir-u32 client & pdir-u32 device & pdir-u32 pasid & pdir-u32 0
    in let params = pdir-u32 (bit-and pdir #FFFFFFFF) & pdir-u32 (bit-shru pdir 32) & pdir-u32 entries & pdir-u32 8
    in head & params & pdir-u32 vaspace & pdir-u32 0 & pdir-u32 1 & pdir-u32 pasid
