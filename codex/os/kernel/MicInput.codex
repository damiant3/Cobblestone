Chapter: MicInput
  cites Kernel chapter HdaAudio
  grounds Device.Mmio

 A reading is the peak absolute amplitude over a short window: a quiet room
 reads under about 15, a voice or a clap hundreds to thousands. The first
 capture returns near-silence while the ring fills, so a reading costs
 about 200 ms.

Section: The Microphone Effect

  mic-quiet-threshold : Integer = 40
  mic-window-bytes : Integer = 16384
  mic-ring-bytes : Integer = 262144

 219 ms is the 4 PIT ticks the settle was written as, at count 65,536.

  mic-settle-ms : Integer = 219

  mic-settle : Integer -> [Microphone] Integer
  mic-settle (target) =
    if get-ticks >= target then 0
    else mic-settle target

  mic-peak : Integer -> [Microphone] Integer
  mic-peak (nbytes) = act
    warm <- hda-capture 4096
    s <- mic-settle (get-ticks + (mic-settle-ms * pit-input-hz + pit-count * 1000 - 1) / (pit-count * 1000))
    buf <- hda-capture nbytes
    if warm == 0 | buf == 0 then -1
    else hda-peak buf (nbytes / 4)
  end

  mic-ms-bytes : Integer -> Integer
  mic-ms-bytes (ms) =
    let raw = hda-sample-rate * ms / 1000 * 4
    in if raw > mic-ring-bytes then mic-ring-bytes
    else if raw < 4096 then 4096
    else raw

  is-quiet : [Microphone] Boolean
  is-quiet = let p = mic-peak mic-window-bytes in p >= 0 & p < mic-quiet-threshold

  listen : Integer -> [Microphone] Text
  listen (ms) = let p = mic-peak (mic-ms-bytes ms) in if p < 0 then "mic-level:none" else "mic-level:" & show p
