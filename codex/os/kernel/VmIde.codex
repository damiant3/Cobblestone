Chapter: VmIde
  cites Foreword chapter CCE

Section: Constants

  vm-ide-base : Integer = 496
  vm-ide-ctrl : Integer = 1014
  vm-ide-data : Integer = 0
  vm-ide-error : Integer = 1
  vm-ide-sect-count : Integer = 2
  vm-ide-lba-lo : Integer = 3
  vm-ide-lba-mid : Integer = 4
  vm-ide-lba-hi : Integer = 5
  vm-ide-drive-head : Integer = 6
  vm-ide-command : Integer = 7
  vm-ide-status : Integer = 7

  vm-ide-status-bsy : Integer = 128
  vm-ide-status-drdy : Integer = 64
  vm-ide-status-drq : Integer = 8
  vm-ide-status-err : Integer = 1

  vm-ide-cmd-read : Integer = 32
  vm-ide-cmd-write : Integer = 48
  vm-ide-cmd-identify : Integer = 236

Section: State

  VmIdeState = record {
    ide-disk-addr : Integer,
    ide-disk-sectors : Integer,
    ide-sect-count : Integer,
    ide-lba-lo : Integer,
    ide-lba-mid : Integer,
    ide-lba-hi : Integer,
    ide-drive-head : Integer,
    ide-status : Integer,
    ide-error : Integer,
    ide-data-buf : Integer,
    ide-data-pos : Integer,
    ide-data-len : Integer,
    ide-sectors-left : Integer,
    ide-writing : Boolean,
    ide-ident-buf : Integer
  }

  vm-ide-new : VmIdeState
  vm-ide-new = VmIdeState {
    ide-disk-addr = 0,
    ide-disk-sectors = 0,
    ide-sect-count = 0,
    ide-lba-lo = 0,
    ide-lba-mid = 0,
    ide-lba-hi = 0,
    ide-drive-head = 0,
    ide-status = 80,
    ide-error = 0,
    ide-data-buf = 0,
    ide-data-pos = 0,
    ide-data-len = 0,
    ide-sectors-left = 0,
    ide-writing = False,
    ide-ident-buf = 0
  }

 The IDENTIFY page is allocated once here, not per command, so a guest that
 repeats IDENTIFY cannot grow the host heap.

  vm-ide-attach : Integer, Integer -> VmIdeState
  vm-ide-attach (disk-addr) (total-sectors) = VmIdeState {
    ide-disk-addr = disk-addr,
    ide-disk-sectors = total-sectors,
    ide-sect-count = 0,
    ide-lba-lo = 0,
    ide-lba-mid = 0,
    ide-lba-hi = 0,
    ide-drive-head = 0,
    ide-status = 80,
    ide-error = 0,
    ide-data-buf = 0,
    ide-data-pos = 0,
    ide-data-len = 0,
    ide-sectors-left = 0,
    ide-writing = False,
    ide-ident-buf = alloc-bytes 512
  }

Section: Port Ownership

  vm-ide-owns-port : VmIdeState, Integer -> Boolean
  vm-ide-owns-port (ide) (port) =
    (port >= vm-ide-base & port < vm-ide-base + 8) | port == vm-ide-ctrl

Section: Command Execution

  vm-ide-get-lba : VmIdeState -> Integer
  vm-ide-get-lba (ide) =
    bit-or (ide.ide-lba-lo) (bit-or (bit-shl (ide.ide-lba-mid) 8) (bit-or (bit-shl (ide.ide-lba-hi) 16) (bit-shl (bit-and (ide.ide-drive-head) 15) 24)))

  vm-ide-phase : VmIdeState, Integer, Integer, Integer, Integer, Integer, Boolean -> VmIdeState
  vm-ide-phase (ide) (status) (error) (buf) (len) (left) (writing) = VmIdeState {
    ide-disk-addr = ide.ide-disk-addr, ide-disk-sectors = ide.ide-disk-sectors,
    ide-sect-count = ide.ide-sect-count, ide-lba-lo = ide.ide-lba-lo,
    ide-lba-mid = ide.ide-lba-mid, ide-lba-hi = ide.ide-lba-hi,
    ide-drive-head = ide.ide-drive-head,
    ide-status = status, ide-error = error,
    ide-data-buf = buf, ide-data-pos = 0, ide-data-len = len,
    ide-sectors-left = left, ide-writing = writing, ide-ident-buf = ide.ide-ident-buf
  }

 Error register bits (ATA): 16 is IDNF, the sector is not on the disk; 4 is
 ABRT, the command is refused.

  vm-ide-start-transfer : VmIdeState, Boolean -> VmIdeState
  vm-ide-start-transfer (ide) (writing) =
    let lba = vm-ide-get-lba ide
    in let count = if ide.ide-sect-count == 0 then 256 else ide.ide-sect-count
    in if lba >= ide.ide-disk-sectors | count > ide.ide-disk-sectors - lba then
      vm-ide-phase ide (bit-or vm-ide-status-drdy vm-ide-status-err) 16 0 0 0 False
    else vm-ide-phase ide (bit-or vm-ide-status-drdy vm-ide-status-drq) 0 (ide.ide-disk-addr + lba * 512) 512 (count - 1) writing

  vm-ide-advance-sector : VmIdeState -> VmIdeState
  vm-ide-advance-sector (ide) =
    if ide.ide-sectors-left <= 0 then vm-ide-phase ide vm-ide-status-drdy 0 0 0 0 False
    else vm-ide-phase ide (bit-or vm-ide-status-drdy vm-ide-status-drq) 0 (ide.ide-data-buf + 512) 512 (ide.ide-sectors-left - 1) ide.ide-writing

  vm-ide-identify : VmIdeState -> VmIdeState
  vm-ide-identify (ide) =
    if ide.ide-ident-buf == 0 then vm-ide-phase ide (bit-or vm-ide-status-drdy vm-ide-status-err) 4 0 0 0 False
    else let filled = vm-ide-fill-identify ide.ide-ident-buf ide.ide-disk-sectors
    in vm-ide-phase ide (bit-or vm-ide-status-drdy vm-ide-status-drq) 0 ide.ide-ident-buf 512 0 False

Section: IDENTIFY DEVICE

 Word layout per ATA/ATAPI-8 ACS 7.16: word 0 bit 6 fixed device; 10-19
 serial, 23-26 firmware, 27-46 model, each string two ASCII bytes per word
 with the first character in the high byte, space padded; word 49 bit 9
 LBA supported; words 60-61 the LBA28 sector count, low word first.

  vm-ide-put-word : Integer, Integer, Integer -> Integer
  vm-ide-put-word (buf) (word) (value) =
    let lo = poke-byte buf (word * 2) (bit-and value 255)
    in poke-byte buf (word * 2 + 1) (bit-and (bit-shru value 8) 255)

  vm-ide-ascii-at : Text, Integer -> Integer
  vm-ide-ascii-at (s) (i) = if i >= text-length s then 32 else to-unicode (char-code-at s i)

  vm-ide-put-string : Integer, Integer, Integer, Text, Integer -> Integer
  vm-ide-put-string (buf) (word) (words) (s) (i) =
    if i >= words then 0
    else let w = vm-ide-put-word buf (word + i) (bit-or (bit-shl (vm-ide-ascii-at s (i * 2)) 8) (vm-ide-ascii-at s (i * 2 + 1)))
    in vm-ide-put-string buf word words s (i + 1)

  vm-ide-zero : Integer, Integer -> Integer
  vm-ide-zero (buf) (i) = if i >= 512 then 0 else let z = poke-byte buf i 0 in vm-ide-zero buf (i + 1)

  vm-ide-fill-identify : Integer, Integer -> Integer
  vm-ide-fill-identify (buf) (sectors) =
    let lba28 = if sectors > #0FFFFFFF then #0FFFFFFF else sectors
    in let z = vm-ide-zero buf 0
    in let a = vm-ide-put-word buf 0 64
    in let b = vm-ide-put-string buf 10 10 "CODEXVM00000001" 0
    in let c = vm-ide-put-string buf 23 4 "1.0" 0
    in let d = vm-ide-put-string buf 27 20 "Codex VM IDE disk" 0
    in let e = vm-ide-put-word buf 49 512
    in let f = vm-ide-put-word buf 60 (bit-and lba28 65535)
    in vm-ide-put-word buf 61 (bit-shru lba28 16)

Section: Output Handling

  vm-ide-handle-out : VmIdeState, Integer, Integer -> VmIdeState
  vm-ide-handle-out (ide) (port) (value) =
    let reg = port - vm-ide-base
    in if reg == vm-ide-sect-count then __record-set ide "ide-sect-count" (bit-and value 255)
    else if reg == vm-ide-lba-lo then __record-set ide "ide-lba-lo" (bit-and value 255)
    else if reg == vm-ide-lba-mid then __record-set ide "ide-lba-mid" (bit-and value 255)
    else if reg == vm-ide-lba-hi then __record-set ide "ide-lba-hi" (bit-and value 255)
    else if reg == vm-ide-drive-head then __record-set ide "ide-drive-head" (bit-and value 255)
    else if reg == vm-ide-command then
      if value == vm-ide-cmd-read then vm-ide-start-transfer ide False
      else if value == vm-ide-cmd-write then vm-ide-start-transfer ide True
      else if value == vm-ide-cmd-identify then vm-ide-identify ide
      else __record-set ide "ide-status" vm-ide-status-drdy
    else if reg == vm-ide-data then vm-ide-write-word ide value
    else ide

  vm-ide-write-word : VmIdeState, Integer -> VmIdeState
  vm-ide-write-word (ide) (value) =
    if not ide.ide-writing | ide.ide-data-pos >= ide.ide-data-len then ide
    else let lo = poke-byte (ide.ide-data-buf) (ide.ide-data-pos) (bit-and value 255)
    in let hi = poke-byte (ide.ide-data-buf) (ide.ide-data-pos + 1) (bit-and (bit-shru value 8) 255)
    in let new-pos = ide.ide-data-pos + 2
    in if new-pos >= ide.ide-data-len then vm-ide-advance-sector (__record-set ide "ide-data-pos" new-pos)
    else __record-set ide "ide-data-pos" new-pos

Section: Input Handling

  VmIdeInResult = record {
    iir-value : Integer,
    iir-state : VmIdeState
  }

  vm-ide-handle-in : VmIdeState, Integer -> VmIdeInResult
  vm-ide-handle-in (ide) (port) =
    if port == vm-ide-ctrl then VmIdeInResult { iir-value = ide.ide-status, iir-state = ide }
    else let reg = port - vm-ide-base
    in if reg == vm-ide-status then VmIdeInResult { iir-value = ide.ide-status, iir-state = ide }
    else if reg == vm-ide-error then VmIdeInResult { iir-value = ide.ide-error, iir-state = ide }
    else if reg == vm-ide-data then
      if ide.ide-writing | ide.ide-data-pos >= ide.ide-data-len then VmIdeInResult { iir-value = 0, iir-state = ide }
      else let lo = peek-byte (ide.ide-data-buf) (ide.ide-data-pos)
      in let hi = peek-byte (ide.ide-data-buf) (ide.ide-data-pos + 1)
      in let word = bit-or lo (bit-shl hi 8)
      in let new-pos = ide.ide-data-pos + 2
      in if new-pos >= ide.ide-data-len then
        VmIdeInResult {
          iir-value = word,
          iir-state = vm-ide-advance-sector (__record-set ide "ide-data-pos" new-pos)
        }
      else VmIdeInResult { iir-value = word, iir-state = __record-set ide "ide-data-pos" new-pos }
    else VmIdeInResult { iir-value = 255, iir-state = ide }

