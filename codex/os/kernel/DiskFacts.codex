Chapter: DiskFacts

  cites Foreword chapter FactStore
  cites Kernel chapter SystemDb

  cites Foreword chapter Maybe

  cites Foreword chapter Sha256

  cites Foreword chapter FactLog

  cites Foreword chapter Gpt

  grounds Device.Block

 We say:

Section: Constants

  superblock-magic : Text = fl-magic

  fact-log-start : Integer = fl-fact-log-start

  sector-size : Integer = fl-sector-size

Section: Byte Packing (Little-Endian)

  pack-u8 : Integer, Integer, Integer -> Integer

  pack-u8 (buf) (off) (val) =

    let p0 = poke-byte buf off (bit-and val 255)

    in off + 1

  unpack-u8 : Integer, Integer -> Integer

  unpack-u8 (buf) (off) = peek-byte buf off

  pack-u16-le : Integer, Integer, Integer -> Integer

  pack-u16-le (buf) (off) (val) =

    let p0 = poke-byte buf off (bit-and val 255)

    in let p1 = poke-byte buf (off + 1) (bit-and (bit-shru val 8) 255)

    in off + 2

  unpack-u16-le : Integer, Integer -> Integer

  unpack-u16-le (buf) (off) =

    bit-or (peek-byte buf off) (bit-shl (peek-byte buf (off + 1)) 8)

  pack-u32-le : Integer, Integer, Integer -> Integer

  pack-u32-le (buf) (off) (val) =

    let p0 = poke-byte buf off (bit-and val 255)

    in let p1 = poke-byte buf (off + 1) (bit-and (bit-shru val 8) 255)

    in let p2 = poke-byte buf (off + 2) (bit-and (bit-shru val 16) 255)

    in let p3 = poke-byte buf (off + 3) (bit-and (bit-shru val 24) 255)

    in off + 4

  unpack-u32-le : Integer, Integer -> Integer

  unpack-u32-le (buf) (off) =

    let b0 = peek-byte buf off

    in let b1 = bit-shl (peek-byte buf (off + 1)) 8

    in let b2 = bit-shl (peek-byte buf (off + 2)) 16

    in let b3 = bit-shl (peek-byte buf (off + 3)) 24

    in bit-or b0 (bit-or b1 (bit-or b2 b3))

  pack-u64-le : Integer, Integer, Integer -> Integer

  pack-u64-le (buf) (off) (val) =

    let p0 = poke-byte buf off (bit-and val 255)

    in let p1 = poke-byte buf (off + 1) (bit-and (bit-shru val 8) 255)

    in let p2 = poke-byte buf (off + 2) (bit-and (bit-shru val 16) 255)

    in let p3 = poke-byte buf (off + 3) (bit-and (bit-shru val 24) 255)

    in let p4 = poke-byte buf (off + 4) (bit-and (bit-shru val 32) 255)

    in let p5 = poke-byte buf (off + 5) (bit-and (bit-shru val 40) 255)

    in let p6 = poke-byte buf (off + 6) (bit-and (bit-shru val 48) 255)

    in let p7 = poke-byte buf (off + 7) (bit-and (bit-shru val 56) 255)

    in off + 8

  unpack-u64-le : Integer, Integer -> Integer

  unpack-u64-le (buf) (off) =

    let b0 = peek-byte buf off

    in let b1 = bit-shl (peek-byte buf (off + 1)) 8

    in let b2 = bit-shl (peek-byte buf (off + 2)) 16

    in let b3 = bit-shl (peek-byte buf (off + 3)) 24

    in let b4 = bit-shl (peek-byte buf (off + 4)) 32

    in let b5 = bit-shl (peek-byte buf (off + 5)) 40

    in let b6 = bit-shl (peek-byte buf (off + 6)) 48

    in let b7 = bit-shl (peek-byte buf (off + 7)) 56

    in bit-or b0 (bit-or b1 (bit-or b2 (bit-or b3 (bit-or b4 (bit-or b5 (bit-or b6 b7))))))

Section: Buffer Utilities

  zero-bytes : Integer, Integer, Integer -> Integer

  zero-bytes (buf) (off) (count) =

    zero-bytes-loop buf off count 0

  zero-bytes-loop : Integer, Integer, Integer, Integer -> Integer

  zero-bytes-loop (buf) (off) (count) (i) =

    if i >= count then 0

    else let p = poke-byte buf (off + i) 0

         in zero-bytes-loop buf off count (i + 1)

  pack-text : Integer, Integer, Text -> Integer

  pack-text (buf) (off) (txt) =

    pack-text-loop buf off txt 0 (text-length txt)

  pack-text-loop : Integer, Integer, Text, Integer, Integer -> Integer

  pack-text-loop (buf) (off) (txt) (i) (len) =

    if i >= len then off + i

    else let p = poke-byte buf (off + i) (char-code-at txt i)

         in pack-text-loop buf off txt (i + 1) len

  unpack-text : Integer, Integer, Integer -> Text

  unpack-text (buf) (off) (len) =

    text-concat-list (unpack-text-chars buf off len 0 [])

 The characters are collected into a LIST and joined once. Appending to the
 Text on every byte reallocates and copies the whole accumulator each time,
 so the intermediates grow as the square of the length and on a machine with
 no GC every one of them is live until the caller returns.

 Measured 2026-08-14 through cdx-serve, which reads a stored work through
 this function: 48 KB served in 23 s and 64 KB died with OUT OF MEMORY. That
 message is the STACK guard firing on a stack/heap collision and reads as
 heap exhaustion to everyone who meets it, so it was checked rather than
 assumed: the faulting RSP was 712 bytes below the stack base, so nothing had
 recursed, and the watchdog's last RIP was inside __str_concat. After this
 change the same server returns 190 KB in 41 s, and 64 KB in 19 s, which is
 less than the 48 KB took before.

 **64 KB is where it died THERE and is not where this function fails.** In
 isolation the old body reaches 64 KB comfortably; it broke inside cdx-serve
 because that heap was already carrying the work index and the transport's
 receive buffer, and the accumulator only had to supply the last of the arena.
 Measured alone it dies at 256 KB, which is what codex/test/diskfacts-unpack-large
 is sized to, because an arm built from the 64 KB symptom passes against the
 defect it was written for.

 It mattered because 39 of the 874 chapters in this tree are over 50 KB,
 TypeChecker at 186,205 bytes among them, so the repository could not serve
 the compiler's own largest sources.

 fat16-bytes-to-text had the identical shape and was changed to this idiom at
 main 14371. This is the same fix in the second place it was needed.

  unpack-text-chars : Integer, Integer, Integer, Integer, List Text -> List Text

  unpack-text-chars (buf) (off) (len) (i) (acc) =

    if i >= len then acc

    else unpack-text-chars buf off len (i + 1) (list-push acc (char-to-text (code-to-char (peek-byte buf (off + i)))))

Section: Hash Utilities

  pack-sha256-bytes : Integer, Integer, List Integer -> Integer

  pack-sha256-bytes (buf) (off) (words) =

    pack-sha256-loop buf off words 0

  pack-sha256-loop : Integer, Integer, List Integer, Integer -> Integer

  pack-sha256-loop (buf) (off) (words) (i) =

    if i >= 8 then off + 32

    else let w = list-at words i

    in let p0 = poke-byte buf (off + i * 4) (bit-and (bit-shru w 24) 255)

    in let p1 = poke-byte buf (off + i * 4 + 1) (bit-and (bit-shru w 16) 255)

    in let p2 = poke-byte buf (off + i * 4 + 2) (bit-and (bit-shru w 8) 255)

    in let p3 = poke-byte buf (off + i * 4 + 3) (bit-and w 255)

    in pack-sha256-loop buf off words (i + 1)

  unpack-sha256-hex : Integer, Integer -> Text

  unpack-sha256-hex (buf) (off) =

    unpack-sha256-hex-loop buf off 0 ""

  unpack-sha256-hex-loop : Integer, Integer, Integer, Text -> Text

  unpack-sha256-hex-loop (buf) (off) (i) (acc) =

    if i >= 32 then acc

    else let b = peek-byte buf (off + i)

    in unpack-sha256-hex-loop buf off (i + 1) (acc & byte-to-hex b)

Section: Superblock

  Superblock = record {

    log-head : Integer,

    fact-count : Integer,

    index-gen : Integer

  }

  empty-superblock : Superblock = Superblock {

    log-head = fact-log-start,

    fact-count = 0,

    index-gen = 1

  }

  pack-superblock : Integer, Superblock -> Integer

  pack-superblock (buf) (sb) =

    let z = zero-bytes buf 0 sector-size

    in let off0 = pack-text buf 0 superblock-magic

    in let off1 = pack-u64-le buf off0 (sb.log-head)

    in let off2 = pack-u64-le buf off1 (sb.fact-count)

    in pack-u64-le buf off2 (sb.index-gen)

  unpack-superblock : Integer -> Maybe Superblock

  unpack-superblock (buf) =

    let magic = unpack-text buf 0 8

    in if magic == superblock-magic then

      Just (Superblock {

        log-head = fl-sb-log-head buf,

        fact-count = unpack-u64-le buf 16,

        index-gen = fl-sb-index-gen buf

      })

    else None

  write-superblock : Integer, Superblock -> Integer

  write-superblock (base) (sb) =

    let buf = alloc-bytes sector-size

    in let off = pack-superblock buf sb

    in fact-write-at base (int-mod (sb.index-gen) 2) buf

  read-superblock-at : Integer, Integer -> Maybe Superblock

  read-superblock-at (base) (sector) =

    let buf = fact-read-at base sector

    in unpack-superblock buf

  pick-superblock : Maybe Superblock, Maybe Superblock -> Maybe Superblock

  pick-superblock (a) (b) =

    when a

      is None -> b

      is Just (sa) -> when b

        is None -> Just sa

        is Just (sb-val) ->

          if sb-val.index-gen > sa.index-gen then Just sb-val else Just sa

  read-superblock : Integer -> Maybe Superblock

  read-superblock (base) =

    let sb0 = read-superblock-at base 0

    in let sb1 = read-superblock-at base 1

    in pick-superblock sb0 sb1

Section: Fact Log Entries

  fact-kind-to-int : FactKind -> Integer

  fact-kind-to-int (k) =

    when k

      is DefinitionFact -> 0

      is ProofFact -> 1

      is VouchFact -> 2

      is PolicyFact -> 3

      is CapabilityFact -> 4

  int-to-fact-kind : Integer -> FactKind

  int-to-fact-kind (i) =

    if i == 0 then DefinitionFact

    else if i == 1 then ProofFact

    else if i == 2 then VouchFact

    else if i == 3 then PolicyFact

    else CapabilityFact

  fact-entry-header-size : Integer = fl-header-size

  sectors-for-fact : Integer -> Integer

  sectors-for-fact (content-len) = fl-sectors-for content-len

  pack-fact-entry : Integer, FactKind, Text, Integer -> Integer

  pack-fact-entry (buf) (kind) (content) (timestamp) =

    let content-len = text-length content

    in let num-sectors = sectors-for-fact content-len

    in let buf-size = num-sectors * sector-size

    in let z = zero-bytes buf 0 buf-size

    in let hash-words = sha256 (text-to-bytes content)

    in let h = pack-sha256-bytes buf 0 hash-words

    in let k = pack-u16-le buf fl-off-kind (fact-kind-to-int kind)

    in let t = pack-u64-le buf fl-off-timestamp timestamp

    in let c = pack-u32-le buf fl-off-content-len content-len

    in pack-text buf fl-header-size content

  write-fact-sectors : Integer, Integer, Integer, Integer, Integer -> Integer

  write-fact-sectors (base) (buf) (start-sector) (count) (i) =

    if i >= count then 0

    else let w = fact-write-at base (start-sector + i) (buf + i * sector-size)

         in write-fact-sectors base buf start-sector count (i + 1)

Section: Where The Store Lives On The Disk

 Every sector number in this chapter is RELATIVE to the store's base LBA.
 The superblock is at relative 0 and 1, the log runs from relative 2, and
 the base is added exactly once, in fact-read-at and fact-write-at. On a
 raw disk the base is 0 and every address is what it always was.

 So the store gets its own partition, type C0DE1A11-FAC7-4C0D-9E75-
 C0DEC0DE5EED, and addresses inside it. The installer creates it; the
 store finds it by its type GUID; a disk that carries a partition table
 and no such partition is refused rather than eaten.

Section: Resolving The Base

  fact-base-whole-disk : Integer = 0

  fact-base-refuse : Integer = 0 - 1

 The GPT signature is compared as RAW BYTES and not through Text.
 "EFI PART" is written by whatever partitioned the disk, so it is ASCII on
 the medium, while this chapter's own magic goes through pack-text and is
 therefore CCE. Reading those eight bytes as Text and comparing them
 against a literal is the CCE boundary bug this project has shipped more
 than once; it would answer False on every real GPT and the guard would
 never fire at all.

 Our own superblock cannot trip the MBR test. pack-superblock zeroes the
 sector and writes a magic and three counters into its first 32 bytes, so
 bytes 510 and 511 of a store's own sector 0 are zero.

  gpt-signature : List Integer

  gpt-signature = [69, 70, 73, 32, 80, 65, 82, 84]

  gpt-sig-matches : Integer, Integer -> Boolean

  gpt-sig-matches (buf) (i) =

    if i >= 8 then True

    else if peek-byte buf i /= list-at gpt-signature i then False

    else gpt-sig-matches buf (i + 1)

  disk-has-gpt-header : Boolean

  disk-has-gpt-header =

    let hdr = block-read-sector 1

    in gpt-sig-matches hdr 0

  disk-has-mbr-signature : Boolean

  disk-has-mbr-signature =

    let mbr = block-read-sector 0

    in peek-byte mbr 510 == 85 & peek-byte mbr 511 == 170

  disk-is-partitioned : Boolean

  disk-is-partitioned = disk-has-gpt-header | disk-has-mbr-signature

  fact-base-min-lba : Integer = 2

  DiskRegion = record {

    dr-base : Integer,

    dr-limit : Integer

  }

  fact-store-region : DiskRegion

  fact-store-region =

    if disk-is-partitioned == False then

      DiskRegion { dr-base = fact-base-whole-disk, dr-limit = 0 }

    else when gpt-read

      is None -> DiskRegion { dr-base = fact-base-refuse, dr-limit = 0 }

      is Just (disk) -> fact-region-from-gpt disk

  fact-region-from-gpt : GptDisk -> DiskRegion

  fact-region-from-gpt (disk) =

    when gpt-find-by-type disk gpt-codex-facts-guid

      is None -> DiskRegion { dr-base = fact-base-refuse, dr-limit = 0 }

      is Just (part) ->

        if part.gp-start-lba < fact-base-min-lba then

          DiskRegion { dr-base = fact-base-refuse, dr-limit = 0 }

        else DiskRegion {

          dr-base = part.gp-start-lba,

          dr-limit = (part.gp-end-lba) - (part.gp-start-lba) + 1

        }

Section: Relative Sector Access

  fact-read-at : Integer, Integer -> Integer

  fact-read-at (base) (rel) = block-read-sector (base + rel)

  fact-write-at : Integer, Integer, Integer -> Integer

  fact-write-at (base) (rel) (buf) = block-write-sector (base + rel) buf

  region-admits : Integer, Integer -> Boolean

  region-admits (limit) (end-rel) = if limit == 0 then True else end-rel <= limit

Section: Disk Operations

 A store carries the region it was opened against. It is captured once, at
 disk-init or disk-load, rather than resolved per access: resolving means
 reading the GPT, which is three sector reads and a list of partition
 records, and a log walk touches thousands of sectors. Per access it would
 be the heap blow-up this project has a review rule about.

  DiskFactStore = record {

    superblock : Superblock,

    mem : BareFactStore,

    base : Integer,

    limit : Integer

  }

  disk-usable : DiskFactStore -> Boolean

  disk-usable (store) = store.base >= 0

  disk-empty-in : DiskRegion -> DiskFactStore

  disk-empty-in (region) = DiskFactStore {

    superblock = empty-superblock,

    mem = fact-store-empty,

    base = region.dr-base,

    limit = region.dr-limit

  }

  disk-init : DiskFactStore

  disk-init = disk-empty-in fact-store-region

  disk-write-fact : DiskFactStore, FactKind, Text, Integer -> DiskFactStore

  disk-write-fact (store) (kind) (content) (timestamp) =

    if disk-usable store == False then store

    else let nsec = sectors-for-fact (text-length content)

    in if region-admits (store.limit) (store.superblock.log-head + nsec) == False then store

    else disk-write-fact-unguarded store kind content timestamp

  disk-write-fact-unguarded : DiskFactStore, FactKind, Text, Integer -> DiskFactStore

  disk-write-fact-unguarded (store) (kind) (content) (timestamp) =

    let sb = store.superblock

    in let content-len = text-length content

    in let nsec = sectors-for-fact content-len

    in let buf = alloc-bytes (nsec * sector-size)

    in let packed = pack-fact-entry buf kind content timestamp

    in let written = write-fact-sectors (store.base) buf (sb.log-head) nsec 0

    in let new-sb = Superblock {

      log-head = sb.log-head + nsec,

      fact-count = sb.fact-count + 1,

      index-gen = sb.index-gen

    }

    in let fact = fact-create kind content "" timestamp

    in let new-mem = fact-store (store.mem) fact

    in DiskFactStore {

      superblock = new-sb,

      mem = new-mem,

      base = store.base,

      limit = store.limit

    }

  disk-checkpoint : DiskFactStore -> DiskFactStore

  disk-checkpoint (store) =

    if disk-usable store == False then store

    else disk-checkpoint-unguarded store

  disk-checkpoint-unguarded : DiskFactStore -> DiskFactStore

  disk-checkpoint-unguarded (store) =

    let sb = store.superblock

    in let new-sb = Superblock {

      log-head = sb.log-head,

      fact-count = sb.fact-count,

      index-gen = sb.index-gen + 1

    }

    in let written = write-superblock (store.base) new-sb

    in DiskFactStore {

      superblock = new-sb,

      mem = store.mem,

      base = store.base,

      limit = store.limit

    }

  disk-read-fact : DiskFactStore, Text -> Maybe Fact

  disk-read-fact (store) (hash) = fact-load (store.mem) hash

  disk-fact-count : DiskFactStore -> Integer

  disk-fact-count (store) = store.superblock.fact-count

Section: Disk Load (Boot-Time Recovery)

  FactScan = record {
    fs-fact : Maybe Fact,
    fs-nsec : Integer
  }

  disk-copy-sector : Integer, Integer, Integer, Integer -> Integer

  disk-copy-sector (src) (dst) (dst-off) (i) =

    if i >= sector-size then 0

    else let w = poke-byte dst (dst-off + i) (peek-byte src i)

         in disk-copy-sector src dst dst-off (i + 1)

  disk-load-sectors : Integer, Integer, Integer, Integer, Integer -> Integer

  disk-load-sectors (base) (start) (count) (dst) (i) =

    if i >= count then 0

    else let src = fact-read-at base (start + i)

         in let c = disk-copy-sector src dst (i * sector-size) 0

         in disk-load-sectors base start count dst (i + 1)

  disk-read-entry-content : Integer, Integer, Integer -> Text

  disk-read-entry-content (base) (sector) (clen) =

    let nsec = sectors-for-fact clen

    in let buf = alloc-bytes (nsec * sector-size)

    in let loaded = disk-load-sectors base sector nsec buf 0

    in unpack-text buf fact-entry-header-size clen

  scan-fact-at : Integer, Integer, Integer -> FactScan

  scan-fact-at (base) (sector) (end-sector) =

    let buf = fact-read-at base sector

    in let content-len = fl-entry-content-len buf

    in if content-len == 0 then FactScan { fs-fact = None, fs-nsec = 1 }

    else let nsec = sectors-for-fact content-len

    in if sector + nsec > end-sector then FactScan { fs-fact = None, fs-nsec = 1 }

    else let kind-int = fl-entry-kind buf

    in let timestamp = fl-entry-timestamp buf

    in let content = disk-read-entry-content base sector content-len

    in let stored-hash = unpack-sha256-hex buf 0

    in let computed-hash = fact-content-hash content

    in if stored-hash == computed-hash then

         FactScan {

           fs-fact = Just (Fact { hash = computed-hash, kind = int-to-fact-kind kind-int, content = content, author = "", timestamp = timestamp }),

           fs-nsec = nsec

         }

       else FactScan { fs-fact = None, fs-nsec = nsec }

  disk-load-facts : Integer, Integer, Integer, BareFactStore -> BareFactStore

  disk-load-facts (base) (sector) (end-sector) (mem) =

    if sector >= end-sector then mem

    else let s = scan-fact-at base sector end-sector

         in when (s.fs-fact)

           is Just (f) -> disk-load-facts base (sector + (s.fs-nsec)) end-sector (fact-store mem f)

           is None -> disk-load-facts base (sector + (s.fs-nsec)) end-sector mem

  disk-load-with-sb : DiskRegion, Superblock -> DiskFactStore

  disk-load-with-sb (region) (sb) =

    let mem = disk-load-facts (region.dr-base) fact-log-start (sb.log-head) fact-store-empty

    in DiskFactStore {

      superblock = sb,

      mem = mem,

      base = region.dr-base,

      limit = region.dr-limit

    }

  disk-load : DiskFactStore

  disk-load =

    let region = fact-store-region

    in if region.dr-base < 0 then disk-empty-in region

    else when read-superblock (region.dr-base)

      is Just (sb) -> disk-load-with-sb region sb

      is None -> disk-empty-in region

Section: Identity Serialization

  sysdb-pack-identity : Integer, IdentityRecord -> Integer
  sysdb-pack-identity (buf) (rec) =
    let z = zero-bytes buf 0 sector-size
    in let off0 = pack-u8 buf 0 (rec.id-version)
    in let off1 = sysdb-pack-bytes buf off0 (rec.id-salt)
    in let off2 = sysdb-pack-bytes buf off1 (rec.id-iv)
    in let off3 = sysdb-pack-bytes buf off2 (rec.id-encrypted-key)
    in let off4 = sysdb-pack-bytes buf off3 (rec.id-public-key)
    in pack-u64-le buf off4 (rec.id-created-ticks)

  sysdb-unpack-identity : Integer -> Maybe IdentityRecord
  sysdb-unpack-identity (buf) =
    let version = unpack-u8 buf 0
    in let salt = sysdb-unpack-bytes buf 1 16
    in let iv = sysdb-unpack-bytes buf 17 16
    in let enc-key = sysdb-unpack-bytes buf 33 48
    in let pub-key = sysdb-unpack-bytes buf 81 32
    in let ticks = unpack-u64-le buf 113
    in Just (IdentityRecord {
      id-version = version,
      id-salt = salt,
      id-iv = iv,
      id-encrypted-key = enc-key,
      id-public-key = pub-key,
      id-created-ticks = ticks
    })

Section: Boot Config Serialization

  sysdb-pack-boot-config : Integer, SysBootConfig -> Integer
  sysdb-pack-boot-config (buf) (cfg) =
    let z = zero-bytes buf 0 sector-size
    in let off0 = pack-u8 buf 0 (cfg.sbc-boot-mode)
    in let off1 = pack-u8 buf off0 (cfg.sbc-boot-partition)
    in let off2 = pack-text buf off1 (cfg.sbc-boot-drive-serial)
    in pack-u8 buf off2 0

  sysdb-unpack-boot-config : Integer -> Maybe SysBootConfig
  sysdb-unpack-boot-config (buf) =
    let mode = unpack-u8 buf 0
    in let part = unpack-u8 buf 1
    in let serial = sysdb-unpack-cstr buf 2
    in Just (SysBootConfig {
      sbc-boot-mode = mode,
      sbc-boot-partition = part,
      sbc-boot-drive-serial = serial
    })

Section: System DB Byte Helpers

  sysdb-pack-bytes : Integer, Integer, List Integer -> Integer
  sysdb-pack-bytes (buf) (off) (bs) = sysdb-pack-bytes-loop buf off bs 0 (list-length bs)

  sysdb-pack-bytes-loop : Integer, Integer, List Integer, Integer, Integer -> Integer
  sysdb-pack-bytes-loop (buf) (off) (bs) (i) (len) =
    if i >= len then off + len
    else let p = poke-byte buf (off + i) (list-at bs i)
    in sysdb-pack-bytes-loop buf off bs (i + 1) len

  sysdb-unpack-bytes : Integer, Integer, Integer -> List Integer
  sysdb-unpack-bytes (buf) (off) (len) = sysdb-unpack-bytes-loop buf off len 0 []

  sysdb-unpack-bytes-loop : Integer, Integer, Integer, Integer, List Integer -> List Integer
  sysdb-unpack-bytes-loop (buf) (off) (len) (i) (acc) =
    if i >= len then acc
    else sysdb-unpack-bytes-loop buf off len (i + 1) (list-push acc (peek-byte buf (off + i)))

  sysdb-unpack-cstr : Integer, Integer -> Text
  sysdb-unpack-cstr (buf) (off) = sysdb-cstr-loop buf off ""

  sysdb-cstr-loop : Integer, Integer, Text -> Text
  sysdb-cstr-loop (buf) (off) (acc) =
    let b = peek-byte buf off
    in if b == 0 then acc
    else sysdb-cstr-loop buf (off + 1) (acc & char-to-text (code-to-char b))

Section: System DB Disk Operations

  sysdb-write-identity : DiskFactStore, IdentityRecord, Integer -> DiskFactStore
  sysdb-write-identity (store) (rec) (timestamp) =
    let buf = alloc-bytes sector-size
    in let packed = sysdb-pack-identity buf rec
    in let content = unpack-text buf 0 121
    in disk-write-fact store (int-to-fact-kind sysdb-kind-identity) content timestamp

  sysdb-write-boot-config : DiskFactStore, SysBootConfig, Integer -> DiskFactStore
  sysdb-write-boot-config (store) (cfg) (timestamp) =
    let buf = alloc-bytes sector-size
    in let packed = sysdb-pack-boot-config buf cfg
    in let serial-len = text-length (cfg.sbc-boot-drive-serial)
    in let content = unpack-text buf 0 (3 + serial-len)
    in disk-write-fact store (int-to-fact-kind sysdb-kind-boot-config) content timestamp

  sysdb-find-identity : DiskFactStore -> Maybe IdentityRecord
  sysdb-find-identity (store) =
    sysdb-scan-for-kind store sysdb-kind-identity fact-log-start

  sysdb-find-boot-config : DiskFactStore -> Maybe SysBootConfig
  sysdb-find-boot-config (store) =
    sysdb-scan-config store sysdb-kind-boot-config fact-log-start

  sysdb-scan-for-kind : DiskFactStore, Integer, Integer -> Maybe IdentityRecord
  sysdb-scan-for-kind (store) (target-kind) (sector) =
    if sector >= store.superblock.log-head then None
    else let buf = fact-read-at (store.base) sector
    in let kind-int = unpack-u16-le buf 32
    in if kind-int == target-kind then sysdb-unpack-identity buf
    else sysdb-scan-for-kind store target-kind (sector + 1)

  sysdb-scan-config : DiskFactStore, Integer, Integer -> Maybe SysBootConfig
  sysdb-scan-config (store) (target-kind) (sector) =
    if sector >= store.superblock.log-head then None
    else let buf = fact-read-at (store.base) sector
    in let kind-int = unpack-u16-le buf 32
    in if kind-int == target-kind then
      let content-len = unpack-u32-le buf 74
      in let content-buf = alloc-bytes sector-size
      in let w = sysdb-copy-content buf 78 content-buf 0 content-len
      in sysdb-unpack-boot-config content-buf
    else sysdb-scan-config store target-kind (sector + 1)

  sysdb-copy-content : Integer, Integer, Integer, Integer, Integer -> Integer
  sysdb-copy-content (src) (src-off) (dst) (dst-off) (len) =
    if len <= 0 then 0
    else let w = poke-byte dst dst-off (peek-byte src src-off)
    in sysdb-copy-content src (src-off + 1) dst (dst-off + 1) (len - 1)

  sysdb-is-fresh : DiskFactStore -> Boolean
  sysdb-is-fresh (store) = store.superblock.fact-count == 0

