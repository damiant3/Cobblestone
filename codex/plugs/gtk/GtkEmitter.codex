Chapter: GTK Emitter

Section: Sanitization

  gtk-sanitize : Text -> Text
  gtk-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  gtk-slash-pos : Text, Integer, Integer -> Integer
  gtk-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else gtk-slash-pos f (i + 1) len

  gtk-field : Text -> Text
  gtk-field (f) =
   let slash = gtk-slash-pos f 0 (text-length f)
   in if slash >= 0 then gtk-sanitize (substring f 0 slash)
      else gtk-sanitize f

  gtk-escape : Text -> Text
  gtk-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

  gtk-indent : Integer -> Text
  gtk-indent (n) =
   if n <= 0 then ""
   else "    " & gtk-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Expression Emission

  emit-gtk-expr : IRExpr, List ArityEntry -> Text
  emit-gtk-expr (e) (arities) =
   when e
    is IrIntLit (n) (sp) -> show n
    is IrNumLit (n) (sp) -> "struct.unpack('=d', struct.pack('=q', " & show n & "))[0]"
    is IrTextLit (s) (sp) -> "\"" & gtk-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "True" else "False"
    is IrCharLit (n) (sp) -> show n
    is IrName (n) (ty) (sp) -> gtk-sanitize n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-gtk-binary op l r arities
    is IrNegate (x) (nty) (sp) -> "(-" & emit-gtk-expr x arities & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-gtk-expr t arities & " if " & emit-gtk-expr c arities & " else " & emit-gtk-expr el arities & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(lambda " & gtk-sanitize name & ": " & emit-gtk-expr body arities & ")(" & emit-gtk-expr val arities & ")"
    is IrApply (f) (a) (ty) (sp) -> emit-gtk-apply e arities
    is IrLambda (params) (body) (ty) (sp) -> "(lambda " & emit-gtk-lambda-params params 0 & ": " & emit-gtk-expr body arities & ")"
    is IrList (elems) (ty) (sp) -> "[" & emit-gtk-list-elems elems arities 0 & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-gtk-match scrut branches arities
    is IrAct (stmts) (ty) (sp) -> emit-gtk-act stmts arities
    is IrRecord (name) (fields) (ty) (sp) -> gtk-sanitize name & "(" & emit-gtk-record-fields fields arities 0 & ")"
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-gtk-expr rec arities & "." & gtk-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(lambda _r: (setattr(_r, '" & gtk-field field & "', " & emit-gtk-expr val arities & "), _r)[-1])(" & emit-gtk-expr rec arities & ")"
    is IrFork (body) (ty) (sp) -> "__import__('concurrent.futures').ThreadPoolExecutor().submit(lambda: (" & emit-gtk-expr body arities & ")(None))"
    is IrAwait (task) (ty) (sp) -> "(" & emit-gtk-expr task arities & ").result()"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-gtk-expr body arities
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-gtk-expr body arities
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-gtk-act body arities
    is IrError (msg) (ty) (sp) -> "(lambda: (_ for _ in ()).throw(Exception(\"" & gtk-escape msg & "\")))()"

Section: Binary Operators

  gtk-vec-op-symbol : IRBinaryOp -> Text
  gtk-vec-op-symbol (op) =
   when op
    is IrAddVec -> "+"
    is IrSubVec -> "-"
    is IrMulVec -> "*"
    is IrDivVec -> "/"
    is otherwise -> "+"

  emit-gtk-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  emit-gtk-binary (op) (l) (r) (arities) =
   let lhs = emit-gtk-expr l arities
   in let rhs = emit-gtk-expr r arities
   in when op
    is IrAddInt | IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt | IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt -> "((lambda _a, _b: (abs(_a) // abs(_b)) * (1 if (_a >= 0) == (_b >= 0) else -1))(" & lhs & ", " & rhs & "))"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "((lambda _a, _b: (abs(_a) % abs(_b)) * (1 if _a >= 0 else -1))(" & lhs & ", " & rhs & "))"
    is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
    is IrEq -> "(" & lhs & " == " & rhs & ")"
    is IrNotEq -> "(" & lhs & " != " & rhs & ")"
    is IrLt | IrLtVec -> "(" & lhs & " < " & rhs & ")"
    is IrGt | IrGtVec -> "(" & lhs & " > " & rhs & ")"
    is IrLtEq | IrLtEqVec -> "(" & lhs & " <= " & rhs & ")"
    is IrGtEq | IrGtEqVec -> "(" & lhs & " >= " & rhs & ")"
    is IrApproxEq | IrApproxEqExact -> "(" & lhs & " == " & rhs & ")"
    is IrAnd -> "(" & lhs & " and " & rhs & ")"
    is IrOr -> "(" & lhs & " or " & rhs & ")"
    is IrAppendText -> "(" & lhs & " + " & rhs & ")"
    is IrAppendList -> "(" & lhs & " + " & rhs & ")"
    is IrConsList -> "[" & lhs & "] + " & rhs
    is IrAddVec | IrSubVec | IrMulVec | IrDivVec -> "[a " & gtk-vec-op-symbol op & " b for a, b in zip(" & lhs & ", " & rhs & ")]"

Section: Apply and Helpers

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-gtk-apply : IRExpr, List ArityEntry -> Text
  emit-gtk-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let func = emit-gtk-expr (chain.root) arities
   in func & "(" & emit-gtk-apply-args (chain.args) arities 0 & ")"

  emit-gtk-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-gtk-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-gtk-expr (list-at args i) arities & emit-gtk-apply-args args arities (i + 1)

  emit-gtk-lambda-params : List IRParam, Integer -> Text
  emit-gtk-lambda-params (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & gtk-sanitize (list-at params i).name & emit-gtk-lambda-params params (i + 1)

  emit-gtk-list-elems : List IRExpr, List ArityEntry, Integer -> Text
  emit-gtk-list-elems (elems) (arities) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-gtk-expr (list-at elems i) arities & emit-gtk-list-elems elems arities (i + 1)

  emit-gtk-record-fields : List IRFieldVal, List ArityEntry, Integer -> Text
  emit-gtk-record-fields (fields) (arities) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & gtk-sanitize (f.name) & "=" & emit-gtk-expr (f.value) arities & emit-gtk-record-fields fields arities (i + 1)

Section: Match

  emit-gtk-match : IRExpr, List IRBranch, List ArityEntry -> Text
  emit-gtk-match (scrut) (branches) (arities) =
   "(lambda _s: " & emit-gtk-match-body branches arities 0 0 & ")(" & emit-gtk-expr scrut arities & ")"

  emit-gtk-match-body : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-gtk-match-body (branches) (arities) (i) (opens) =
   if i == list-length branches then "(_ for _ in ()).throw(Exception('non-exhaustive match'))" & emit-gtk-close opens
   else let b = list-at branches i
   in emit-gtk-match-arm (b.pattern) (b.guard) (b.body) branches arities i opens

  emit-gtk-match-arm : IRPat, IRExpr, IRExpr, List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-gtk-match-arm (pat) (guard) (body) (branches) (arities) (i) (opens) =
   when pat
    is IrLitPat (text) (ty) (sp) ->
     let pre = if i > 0 then " else " else ""
     in pre & "(" & emit-gtk-expr body arities & " if _s == " & text & gtk-guard-and guard arities & emit-gtk-match-body branches arities (i + 1) (opens + 1)
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let pre = if i > 0 then " else " else ""
     in pre & "(" & emit-gtk-ctor-body subs body arities & " if isinstance(_s, " & gtk-sanitize name & ")" & gtk-ctor-guard-and subs guard arities & emit-gtk-match-body branches arities (i + 1) (opens + 1)
    is IrVarPat (name) (ty) (sp) ->
     let pre = if i > 0 then " else " else ""
     in if gtk-guard-trivial guard
        then pre & "(lambda " & gtk-sanitize name & ": " & emit-gtk-expr body arities & ")(_s)" & emit-gtk-close opens
        else pre & "((lambda " & gtk-sanitize name & ": " & emit-gtk-expr body arities & ")(_s) if (lambda " & gtk-sanitize name & ": " & emit-gtk-expr guard arities & ")(_s)" & emit-gtk-match-body branches arities (i + 1) (opens + 1)
    is IrVecPat (pats) (ty) (sp) ->
     let pre = if i > 0 then " else " else ""
     in if gtk-guard-trivial guard
        then pre & emit-gtk-expr body arities & emit-gtk-close opens
        else pre & "(" & emit-gtk-expr body arities & " if " & emit-gtk-expr guard arities & emit-gtk-match-body branches arities (i + 1) (opens + 1)
    is IrWildPat (sp) ->
     let pre = if i > 0 then " else " else ""
     in if gtk-guard-trivial guard
        then pre & emit-gtk-expr body arities & emit-gtk-close opens
        else pre & "(" & emit-gtk-expr body arities & " if " & emit-gtk-expr guard arities & emit-gtk-match-body branches arities (i + 1) (opens + 1)

  emit-gtk-ctor-body : List IRPat, IRExpr, List ArityEntry -> Text
  emit-gtk-ctor-body (subs) (body) (arities) =
   let binds = collect-gtk-binds subs 0
   in if list-length binds == 0 then emit-gtk-expr body arities
      else "(lambda " & emit-gtk-bind-names binds 0 & ": " & emit-gtk-expr body arities & ")(" & emit-gtk-bind-accesses binds 0 & ")"

 The rest of the match is the `else` of a conditional expression, so a guard
 goes in the CONDITION, applied to the same lambda that binds the payload and
 behind the `isinstance` short circuit, because reading `.field0` off the
 wrong class raises.

  gtk-guard-trivial : IRExpr -> Boolean
  gtk-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  gtk-guard-and : IRExpr, List ArityEntry -> Text
  gtk-guard-and (guard) (arities) =
   if gtk-guard-trivial guard then "" else " and (" & emit-gtk-expr guard arities & ")"

  gtk-ctor-guard-and : List IRPat, IRExpr, List ArityEntry -> Text
  gtk-ctor-guard-and (subs) (guard) (arities) =
   if gtk-guard-trivial guard then ""
   else let binds = collect-gtk-binds subs 0
   in if list-length binds == 0 then " and (" & emit-gtk-expr guard arities & ")"
      else " and (lambda " & emit-gtk-bind-names binds 0 & ": " & emit-gtk-expr guard arities & ")(" & emit-gtk-bind-accesses binds 0 & ")"

  GtkBind = record { name : Text, access : Text }

  collect-gtk-binds : List IRPat, Integer -> List GtkBind
  collect-gtk-binds (subs) (i) =
   if i == list-length subs then []
   else let sub = list-at subs i
   in let rest = collect-gtk-binds subs (i + 1)
   in when sub
    is IrVarPat (name) (ty) (sp) -> [GtkBind { name = name, access = "_s.field" & show i }] & rest
    is IrVecPat (pats) (ty) (sp) -> rest
    is otherwise -> rest

  emit-gtk-bind-names : List GtkBind, Integer -> Text
  emit-gtk-bind-names (bs) (i) =
   if i == list-length bs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & gtk-sanitize ((list-at bs i).name) & emit-gtk-bind-names bs (i + 1)

  emit-gtk-bind-accesses : List GtkBind, Integer -> Text
  emit-gtk-bind-accesses (bs) (i) =
   if i == list-length bs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & (list-at bs i).access & emit-gtk-bind-accesses bs (i + 1)

  emit-gtk-close : Integer -> Text
  emit-gtk-close (n) =
   if n <= 0 then ""
   else ")" & emit-gtk-close (n - 1)

Section: Act Blocks

  emit-gtk-act : List IRActStmt, List ArityEntry -> Text
  emit-gtk-act (stmts) (arities) =
   if gtk-has-binds stmts 0 then "(lambda: (" & emit-gtk-bind-chain stmts 0 arities & "))()"
   else "(lambda: [" & emit-gtk-act-elems stmts 0 arities & "][-1])()"

  gtk-has-binds : List IRActStmt, Integer -> Boolean
  gtk-has-binds (stmts) (i) =
   if i == list-length stmts then False
   else when (list-at stmts i)
    is IrDoBind (name) (ty) (val) (sp) -> True
    is IrDoExec (e) (sp) -> gtk-has-binds stmts (i + 1)

  emit-gtk-bind-chain : List IRActStmt, Integer, List ArityEntry -> Text
  emit-gtk-bind-chain (stmts) (i) (arities) =
   if i == list-length stmts then "None"
   else let s = list-at stmts i
   in if i == list-length stmts - 1 then
    when s
     is IrDoBind (name) (ty) (val) (sp) -> "(lambda " & gtk-sanitize name & ": " & gtk-sanitize name & ")(" & emit-gtk-expr val arities & ")"
     is IrDoExec (e) (sp) -> emit-gtk-expr e arities
   else when s
    is IrDoBind (name) (ty) (val) (sp) -> "(lambda " & gtk-sanitize name & ": " & emit-gtk-bind-chain stmts (i + 1) arities & ")(" & emit-gtk-expr val arities & ")"
    is IrDoExec (e) (sp) -> "[" & emit-gtk-expr e arities & ", " & emit-gtk-bind-chain stmts (i + 1) arities & "][-1]"

  emit-gtk-act-elems : List IRActStmt, Integer, List ArityEntry -> Text
  emit-gtk-act-elems (stmts) (i) (arities) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let elem = when s
    is IrDoBind (name) (ty) (val) (sp) -> emit-gtk-expr val arities
    is IrDoExec (e) (sp) -> emit-gtk-expr e arities
   in if i == list-length stmts - 1 then elem
      else elem & ", " & emit-gtk-act-elems stmts (i + 1) arities

Section: Type Definitions

  emit-gtk-type-def : ATypeDef -> Text
  emit-gtk-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     let sname = gtk-sanitize (name.value)
     in "@dataclass\nclass " & sname & ":\n" & emit-gtk-record-field-defs fields 0 & "\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-gtk-variant-ctor-defs ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-gtk-record-field-defs : List ARecordFieldDef, Integer -> Text
  emit-gtk-record-field-defs (fields) (i) =
   if i == list-length fields then "    pass\n"
   else let f = list-at fields i
   in "    " & gtk-sanitize (f.name.value) & " = None\n" & emit-gtk-record-field-defs fields (i + 1)

  emit-gtk-variant-ctor-defs : List AVariantCtorDef, Integer -> Text
  emit-gtk-variant-ctor-defs (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in let sname = gtk-sanitize (c.name.value)
   in (if n == 0 then "@dataclass\nclass " & sname & ":\n    tag = \"" & c.name.value & "\"\n\n"
       else "@dataclass\nclass " & sname & ":\n" & emit-gtk-ctor-field-defs n 0 & "    tag = \"" & c.name.value & "\"\n\n")
      & emit-gtk-variant-ctor-defs ctors (i + 1)

  emit-gtk-ctor-field-defs : Integer, Integer -> Text
  emit-gtk-ctor-field-defs (n) (i) =
   if i == n then ""
   else "    field" & show i & " = None\n" & emit-gtk-ctor-field-defs n (i + 1)

Section: Definition Emission

  emit-gtk-def : IRDef, List ArityEntry -> Text
  emit-gtk-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else let sname = gtk-sanitize (d.name)
   in if list-length (d.params) == 0
      then "def " & sname & "():\n    return " & emit-gtk-expr (d.body) arities & "\n\n"
      else "def " & sname & "(" & emit-gtk-def-params (d.params) 0 & "):\n    return " & emit-gtk-expr (d.body) arities & "\n\n"

  emit-gtk-def-params : List IRParam, Integer -> Text
  emit-gtk-def-params (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & gtk-sanitize (list-at params i).name & emit-gtk-def-params params (i + 1)

  emit-gtk-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-gtk-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-gtk-def (list-at defs i) arities & emit-gtk-defs defs (i + 1) arities

  emit-gtk-type-defs : List ATypeDef, Integer -> Text
  emit-gtk-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-gtk-type-def (list-at tds i) & emit-gtk-type-defs tds (i + 1)

Section: GTK Application Assembly

  emit-gtk-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-gtk-chapter (m) (meta) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let title = if meta.chapter-title == "" then "App" else meta.chapter-title
   in let imports = "import gi\ngi.require_version('Gtk', '4.0')\nfrom gi.repository import Gtk\nfrom dataclasses import dataclass\nimport struct\nimport sys\nsys.setrecursionlimit(1000000)\n\n"
   in let builtins = "def __narrow(n): return n\n_output_lines = []\ndef print_line_uni(s):\n    _output_lines.append(str(s))\ndef show(n): return str(n)\ndef text_length(s): return len(s)\ndef text_replace(s, a, b): return s if len(a) == 0 else s.replace(a, b)\ndef text_starts_with(s, p): return s.startswith(p)\ndef text_contains(s, sub): return sub in s\ndef text_split(s, sep): return [s] if len(sep) == 0 else s.split(sep)\ndef text_to_integer(s):\n    t = str(s)\n    i = 0\n    neg = False\n    if t[:1] == '-':\n        neg = True\n        i = 1\n    v = 0\n    while i < len(t) and '0' <= t[i] <= '9':\n        v = v * 10 + (ord(t[i]) - 48)\n        i += 1\n    return -v if neg else v\ndef text_compare(a, b): return 0 if a == b else (-1 if a < b else 1)\ndef list_length(xs): return len(xs)\ndef list_at(xs, i): return xs[i]\ndef integer_to_text(n): return str(n)\ndef negate(n): return -n\n\n"
   in let types-text = emit-gtk-type-defs type-defs 0
   in let defs-text = emit-gtk-defs (m.defs) 0 arities
   in let gtk-app = "class AppWindow(Gtk.ApplicationWindow):\n    def __init__(self, app):\n        super().__init__(application=app, title=\"" & gtk-escape title & "\")\n        self.set_default_size(640, 480)\n        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)\n        box.set_margin_top(10)\n        box.set_margin_start(10)\n        try:\n            opening()\n        except Exception as e:\n            _output_lines.append(str(e))\n        for line in _output_lines:\n            label = Gtk.Label(label=line, xalign=0)\n            box.append(label)\n        self.set_child(box)\n\ndef on_activate(app):\n    win = AppWindow(app)\n    win.present()\n\napp = Gtk.Application()\napp.connect('activate', on_activate)\napp.run(None)\n"
   in imports & builtins & types-text & defs-text & gtk-app

Page 1
