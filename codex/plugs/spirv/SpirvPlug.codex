Chapter: SpirvPlug
  cites Foreword chapter Maybe

Section: Body

  dispatch : Text -> [Console] Nothing
  dispatch (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in let words = emit-spirv-binary-chapter (parsed.chapter) (parsed.type-defs)
    in print-line-uni (spv-disasm words)
  end

  opening : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch mode
      is None -> print-line-uni "no input"
  end
