Chapter: SpirvBinPlug
  cites Foreword chapter Maybe

 Plug entry for the binary path. Reads IR text from serial, emits the
 SPIR-V word stream, validates it in-Codex (there is no spirv-val on the
 box), and writes the verdict, the id bound, and the words as
 space-separated decimals. A trivial host step packs the words
 little-endian into a .spv; the encoding and the checking are done here.

Section: Body

  dispatch-bin : Text -> [Console, FileSystem] Nothing
  dispatch-bin (mode) = act
    source <- read-file mode
    let parsed = parse-ir-chapter source
    in let words = emit-spirv-binary-chapter (parsed.chapter) (parsed.type-defs)
    in act
      print-line-uni ("SPV-BIN-VALIDATE: " & spv-validate words)
      print-line-uni ("SPV-BIN-BOUND: " & integer-to-text (list-at words 3))
      print-line-uni ("SPV-BIN-WORDS: " & spv-b-words-to-text words 0)
    end
  end

  opening : [Console, FileSystem] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch-bin mode
      is None -> print-line-uni "no input"
  end
