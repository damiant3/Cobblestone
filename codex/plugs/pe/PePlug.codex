Chapter: PePlug
  cites Net chapter NetIO
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Kernel chapter Ne2k

 Wire protocol: tag=4 for PE conversion.
 First byte of body = mode:
   0 = x86 kernel (CDX input)
   1 = x86 app (CDX input, bytes 1-4 = heap-pages LE)
   2 = ARM64 (wire protocol input: code+data+func table)

Section: Network Config

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Spin

 The spin-wait iteration count is hardware-dependent and there is no
 poll of the NE2K ISR TX-complete bit behind it.

  spin-wait : Integer, Integer -> Integer
  spin-wait (i) (n) =
   if i >= n then 0
   else spin-wait (i + 1) n

Section: Drain

  drain-wait : TcpTransportState, Integer -> [Network.Read] Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else act
    frame <- ne2k-recv-frame
    if list-length frame == 0 then drain-wait ts (tries + 1)
    else 0
   end

Section: Body

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9128 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let payload = recv.body
     in let payload-len = list-length payload
     in let payload-buf = __heap-save
     in let padv = __heap-advance payload-len
     in let pcopy = __buf-write-bytes payload-buf 0 payload
     in let mode = peek-byte payload-buf 0
     in let pe = if mode == 2 then build-arm64-pe-from-buf payload-buf 1
     else let cdx-off = if mode == 0 then 1 else 5
     in let heap-pages = if mode == 0 then 0 else list-at payload 1 + list-at payload 2 * 256 + list-at payload 3 * 65536 + list-at payload 4 * 16777216
     in let cdx = slice-bytes payload cdx-off payload-len
     in if mode == 0 then build-pe-from-cdx cdx else build-uefi-app-pe-from-cdx cdx heap-pages
     in let pe-len = list-length pe
     in act
      sent <- net-io-send-raw-checked (recv.transport) pe
      ts6 <- net-io-close (sent.ns-transport)
      drained <- drain-wait ts6 0
      let flushed = spin-wait 0 500000000
      in if sent.ns-complete then print-line-uni ("OK mode=" & show mode & " pe=" & show pe-len & " sent=" & show (sent.ns-sent) & " payload=" & show payload-len)
      else print-line-uni ("TRUNCATED sent=" & show (sent.ns-sent) & " of " & show pe-len & " mode=" & show mode & " payload=" & show payload-len)
     end
    else print-line-uni "FAIL"
   end

Section: ARM64 Wire Parser

  build-arm64-pe-from-buf : Integer, Integer -> List Integer
  build-arm64-pe-from-buf (buf) (wire-off) =
   let code-len = peek-byte buf wire-off + peek-byte buf (wire-off + 1) * 256 + peek-byte buf (wire-off + 2) * 65536 + peek-byte buf (wire-off + 3) * 16777216
   in let data-len = peek-byte buf (wire-off + 4) + peek-byte buf (wire-off + 5) * 256 + peek-byte buf (wire-off + 6) * 65536 + peek-byte buf (wire-off + 7) * 16777216
   in let func-count = peek-byte buf (wire-off + 8) + peek-byte buf (wire-off + 9) * 256 + peek-byte buf (wire-off + 10) * 65536 + peek-byte buf (wire-off + 11) * 16777216
   in let code-off = wire-off + 12
   in let func-table-off = wire-off + 12 + code-len + data-len
   in let start-offset = buf-find-first-func buf func-table-off
   in a64pe-build-pe-from-buf buf code-off code-len data-len start-offset

  buf-find-first-func : Integer, Integer -> Integer
  buf-find-first-func (buf) (off) =
   let name-len = peek-byte buf off + peek-byte buf (off + 1) * 256
   in peek-byte buf (off + 2 + name-len) + peek-byte buf (off + 3 + name-len) * 256 + peek-byte buf (off + 4 + name-len) * 65536 + peek-byte buf (off + 5 + name-len) * 16777216

  buf-find-opening : Integer, Integer, Integer -> Integer
  buf-find-opening (buf) (off) (count) = buf-find-opening-loop buf off count 0

  buf-find-opening-loop : Integer, Integer, Integer, Integer -> Integer
  buf-find-opening-loop (buf) (off) (count) (i) =
   if i >= count then 0
   else let name-len = peek-byte buf off + peek-byte buf (off + 1) * 256
   in let func-off = peek-byte buf (off + 2 + name-len) + peek-byte buf (off + 3 + name-len) * 256 + peek-byte buf (off + 4 + name-len) * 65536 + peek-byte buf (off + 5 + name-len) * 16777216
   in if name-len == 7 then
     if peek-byte buf (off + 2) == 111 & peek-byte buf (off + 3) == 112 & peek-byte buf (off + 4) == 101 & peek-byte buf (off + 5) == 110 & peek-byte buf (off + 6) == 105 & peek-byte buf (off + 7) == 110 & peek-byte buf (off + 8) == 103 then func-off
     else buf-find-opening-loop buf (off + 2 + name-len + 4) count (i + 1)
   else buf-find-opening-loop buf (off + 2 + name-len + 4) count (i + 1)

  wire-le32 : List Integer, Integer -> Integer
  wire-le32 (bs) (off) =
   list-at bs off + list-at bs (off + 1) * 256 + list-at bs (off + 2) * 65536 + list-at bs (off + 3) * 16777216

  wire-find-start : List Integer, Integer, Integer -> Integer
  wire-find-start (wire) (off) (count) = wire-find-start-loop wire off count 0

  wire-find-start-loop : List Integer, Integer, Integer, Integer -> Integer
  wire-find-start-loop (wire) (off) (count) (i) =
   if i >= count then 0
   else let name-len = list-at wire off + list-at wire (off + 1) * 256
   in let name = wire-read-name wire (off + 2) name-len
   in let func-off = wire-le32 wire (off + 2 + name-len)
   in if name == "__start" then func-off
   else wire-find-start-loop wire (off + 2 + name-len + 4) count (i + 1)

  wire-read-name : List Integer, Integer, Integer -> Text
  wire-read-name (wire) (off) (len) = wire-read-name-loop wire off 0 len ""

  wire-read-name-loop : List Integer, Integer, Integer, Integer, Text -> Text
  wire-read-name-loop (wire) (off) (i) (len) (acc) =
   if i >= len then acc
   else wire-read-name-loop wire off (i + 1) len (acc & char-to-text (code-to-char (list-at wire (off + i))))

Section: Byte Slicing

  slice-bytes : List Integer, Integer, Integer -> List Integer
  slice-bytes (bs) (from) (to) = slice-bytes-loop bs from to []

  slice-bytes-loop : List Integer, Integer, Integer, List Integer -> List Integer
  slice-bytes-loop (bs) (i) (to) (acc) =
   if i >= to then acc
   else slice-bytes-loop bs (i + 1) to (list-push acc (list-at bs i))

