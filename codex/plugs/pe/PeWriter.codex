   [72, 141, 179] & write-i32 data-off
   & [72, 199, 199] & write-i32 dest
   & [185] & write-i32 size
   & [243, 164]

  pe-stub-copy-rodata-section : Integer, Integer, Integer -> List Integer
  pe-stub-copy-rodata-section (data-off) (size) (dest) =
   if size == 0 then []
   else [72, 141, 179] & write-i32 data-off
   & [72, 191] & write-i64 dest
   & [185] & write-i32 size
   & [243, 164]

  pe-stub-patch-hlt-insn : Integer -> List Integer
  pe-stub-patch-hlt-insn (hlt-offset) =
   if hlt-offset < 0 then []
   else [72, 191] & write-i64 (1048576 + hlt-offset)
   & [198, 7, 144]

