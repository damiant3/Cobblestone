Chapter: PeWriter
  cites Common chapter ByteHelpers

Section: PE Format Constants
  pe-machine-amd64 : Integer = 34404
  pe-magic-pe32plus : Integer = 523
  pe-subsystem-efi-app : Integer = 10
  pe-section-code : Integer = 1610612768
  pe-section-idata-read : Integer = 1107296320
  pe-dll-chars-nx : Integer = 352
  pe-file-alignment : Integer = 512
  pe-section-alignment : Integer = 4096
  pe-header-size : Integer = 512

Section: Byte Readers
  pe-read-le32 : List Integer, Integer -> Integer
  pe-read-le32 (b) (off) =
   list-at b off + list-at b (off + 1) * 256 + list-at b (off + 2) * 65536 + list-at b (off + 3) * 16777216

  pe-read-le64 : List Integer, Integer -> Integer
  pe-read-le64 (b) (off) =
   pe-read-le32 b off + pe-read-le32 b (off + 4) * 4294967296

Section: DOS Header
  pe-dos-header : List Integer
  pe-dos-header =
   [77, 90] & pad-zeros 58 & write-i32 128 & pad-zeros (128 - 64)

Section: COFF Header
  pe-coff-header : Integer -> List Integer
  pe-coff-header (optional-hdr-size) =
   write-i16 pe-machine-amd64
   & write-i16 1
   & write-i32 0
   & write-i32 0
   & write-i32 0
   & write-i16 optional-hdr-size
   & write-i16 34

Section: Optional Header
  pe-optional-header : Integer, Integer, Integer -> List Integer
  pe-optional-header (code-size) (entry-rva) (image-size) =
   write-i16 pe-magic-pe32plus
   & [0, 0]
   & write-i32 code-size
   & write-i32 0
   & write-i32 0
   & write-i32 entry-rva
   & write-i32 pe-section-alignment
   & write-i64 0
   & write-i32 pe-section-alignment
   & write-i32 pe-file-alignment
   & pad-zeros 16
   & write-i32 image-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i16 pe-subsystem-efi-app
   & write-i16 0
   & pad-zeros 32
   & write-i32 0
   & write-i32 16
   & pad-zeros 128

Section: Section Header
  pe-text-section-header : Integer, Integer -> List Integer
  pe-text-section-header (virtual-size) (raw-size) =
   [46, 116, 101, 120, 116, 0, 0, 0]
   & write-i32 virtual-size
   & write-i32 pe-section-alignment
   & write-i32 raw-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i32 0
   & write-i16 0
   & write-i16 0
   & write-i32 pe-section-code

Section: UEFI PE Headers
  pe-coff-header-2 : Integer -> List Integer
  pe-coff-header-2 (optional-hdr-size) =
   write-i16 pe-machine-amd64
   & write-i16 2
   & write-i32 0
   & write-i32 0
   & write-i32 0
   & write-i16 optional-hdr-size
   & write-i16 34

  pe-optional-header-uefi : Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-optional-header-uefi (code-size) (entry-rva) (image-size) (reloc-rva) (reloc-size) =
   write-i16 pe-magic-pe32plus
   & [0, 0]
   & write-i32 code-size
   & write-i32 0
   & write-i32 0
   & write-i32 entry-rva
   & write-i32 pe-section-alignment
   & write-i64 0
   & write-i32 pe-section-alignment
   & write-i32 pe-file-alignment
   & pad-zeros 16
   & write-i32 image-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i16 pe-subsystem-efi-app
   & write-i16 pe-dll-chars-nx
   & pad-zeros 32
   & write-i32 0
   & write-i32 16
   & pad-zeros 40
   & write-i32 reloc-rva
   & write-i32 reloc-size
   & pad-zeros 80

  pe-reloc-section-header : Integer, Integer, Integer -> List Integer
  pe-reloc-section-header (virtual-size) (rva) (raw-offset) =
   [46, 114, 101, 108, 111, 99, 0, 0]
   & write-i32 virtual-size
   & write-i32 rva
   & write-i32 pe-file-alignment
   & write-i32 raw-offset
   & write-i32 0
   & write-i32 0
   & write-i16 0
   & write-i16 0
   & write-i32 pe-section-idata-read

  pe-reloc-dummy : List Integer
  pe-reloc-dummy =
   write-i32 0 & write-i32 8

