Section: HLT Scan

 Scans for the UEFI trampoline marker: F4 48 C7 C7 00 70 00 00.
 This is HLT (F4) followed by MOV RDI, 0x7000 (48 C7 C7 00 70 00 00)
 which appears in the boot trampoline at the point where it loads
 CR3 from the temporary page table at 0x7000. The PE stub patches
 the HLT to NOP (90) so UEFI boot skips the bare-metal halt. If
 the compiler changes this instruction sequence, this scan must
 be updated to match.

  pe-find-hlt-in-code : List Integer, Integer, Integer -> Integer
  pe-find-hlt-in-code (code) (i) (limit) =
   if i >= limit then 0 - 1
   else if list-at code i == 244 then
    if list-at code (i + 1) == 72 then
     if list-at code (i + 2) == 199 then
      if list-at code (i + 3) == 199 then
       if list-at code (i + 4) == 0 then
        if list-at code (i + 5) == 112 then
         if list-at code (i + 6) == 0 then
          if list-at code (i + 7) == 0 then i
          else pe-find-hlt-in-code code (i + 1) limit
         else pe-find-hlt-in-code code (i + 1) limit
        else pe-find-hlt-in-code code (i + 1) limit
       else pe-find-hlt-in-code code (i + 1) limit
      else pe-find-hlt-in-code code (i + 1) limit
     else pe-find-hlt-in-code code (i + 1) limit
    else pe-find-hlt-in-code code (i + 1) limit
   else pe-find-hlt-in-code code (i + 1) limit

Section: Build PE from CDX Bytes
  build-pe-from-cdx : List Integer -> List Integer
  build-pe-from-cdx (cdx) =
   let text-off = pe-read-le64 cdx 168
   in let text-sz = pe-read-le64 cdx 176
   in let rodata-off = pe-read-le64 cdx 184
   in let rodata-sz = pe-read-le64 cdx 192
   in let entry-off = pe-read-le64 cdx 200
   in let data-vaddr = 1048576 + align-up text-sz 8
   in let hlt-raw = pe-find-hlt-in-code cdx text-off (text-off + text-sz - 8)
   in let hlt-off = if hlt-raw < 0 then 0 - 1 else hlt-raw - text-off
   in let text-bytes = pe-extract cdx text-off text-sz
   in let rodata-bytes = pe-extract cdx rodata-off rodata-sz
   in let stub = pe-uefi-stub text-sz rodata-sz entry-off hlt-off data-vaddr
   in let code = stub & text-bytes & rodata-bytes
   in let code-size = list-length code
   in let code-raw = align-up code-size pe-file-alignment
   in let code-sec-end = align-up code-size pe-section-alignment
   in let reloc-rva = pe-section-alignment + code-sec-end
   in let image-size = align-up (reloc-rva + pe-section-alignment) pe-section-alignment
   in let reloc-raw-off = pe-header-size + code-raw
   in let headers = pe-dos-header & [80, 69, 0, 0] & pe-coff-header-2 240 & pe-optional-header-uefi code-raw pe-section-alignment image-size reloc-rva 8 & pe-text-section-header code-size code-raw & pe-reloc-section-header 8 reloc-rva reloc-raw-off
   in let hdr-len = list-length headers
   in let header-pad = pad-zeros (pe-header-size - hdr-len)
   in let code-pad = pad-zeros (code-raw - code-size)
   in let reloc-pad = pad-zeros (pe-file-alignment - 8)
   in headers & header-pad & code & code-pad & pe-reloc-dummy & reloc-pad

  build-uefi-app-pe-from-cdx : List Integer, Integer -> List Integer
  build-uefi-app-pe-from-cdx (cdx) (heap-pages) =
   let text-off = pe-read-le64 cdx 168
   in let text-sz = pe-read-le64 cdx 176
   in let rodata-off = pe-read-le64 cdx 184
   in let rodata-sz = pe-read-le64 cdx 192
   in let entry-off = pe-read-le64 cdx 200
   in let data-vaddr = 1048576 + align-up text-sz 8
   in let text-bytes = pe-extract cdx text-off text-sz
   in let rodata-bytes = pe-extract cdx rodata-off rodata-sz
   in let stub = pe-uefi-app-stub text-sz rodata-sz entry-off data-vaddr heap-pages
   in let code = stub & text-bytes & rodata-bytes
   in let code-size = list-length code
   in let code-raw = align-up code-size pe-file-alignment
   in let code-sec-end = align-up code-size pe-section-alignment
   in let reloc-rva = pe-section-alignment + code-sec-end
   in let image-size = align-up (reloc-rva + pe-section-alignment) pe-section-alignment
   in let reloc-raw-off = pe-header-size + code-raw
   in let headers = pe-dos-header & [80, 69, 0, 0] & pe-coff-header-2 240 & pe-optional-header-uefi code-raw pe-section-alignment image-size reloc-rva 8 & pe-text-section-header code-size code-raw & pe-reloc-section-header 8 reloc-rva reloc-raw-off
   in let hdr-len = list-length headers
   in let header-pad = pad-zeros (pe-header-size - hdr-len)
   in let code-pad = pad-zeros (code-raw - code-size)
   in let reloc-pad = pad-zeros (pe-file-alignment - 8)
   in headers & header-pad & code & code-pad & pe-reloc-dummy & reloc-pad

  pe-extract : List Integer, Integer, Integer -> List Integer
  pe-extract (src) (off) (len) =
   pe-extract-loop src off (off + len) []

  pe-extract-loop : List Integer, Integer, Integer, List Integer -> List Integer
  pe-extract-loop (src) (i) (stop) (acc) =
   if i >= stop then acc
   else pe-extract-loop src (i + 1) stop (list-push acc (list-at src i))

Page 1

Section: Windows Console PE

 A Windows console program, which is a different animal from the UEFI
 application the rest of this chapter builds: subsystem 3 rather than 10, and
 an import table the loader fills in, because a user process reaches the kernel
 through kernel32 rather than through a system table.

 THE LAYOUT IS FIXED AND SHARED WITH THE COMPILER. The emitted code calls
 kernel32 through absolute IAT addresses it baked in at compile time, so these
 numbers must equal hosted-win-image-base, hosted-win-idata-rva,
 hosted-win-text-rva and the four hosted-win-iat-* constants in
 X86_64Boot.codex. A disagreement is not a wrong answer, it is a call into
 whatever happens to be at that address.

 The import order is load-bearing, within each DLL and between the two: a slot
 address is its position, so the lists below must match the order
 cdx-to-pe-console.ps1 builds and the hosted-win-iat-* constants encode.

 ASLR is off (DllCharacteristics 0) because the code is position-dependent and
 patched for one address. That is a real constraint on the artifact, not a
 preference: a host that forces relocation will not run it.

 Windows refuses an image based at 0x10000, 0x20000 or 0x40000. 0x100000 is
 the lowest 64K-aligned base it accepts, which is why this value is 1048576
 and not lower. A declared section starting at SizeOfImage is refused the
 same way. Both refusals report only "not a valid application for this OS
 platform", naming neither the base nor the field, so neither is diagnosable
 from what Windows says.

 The consequence is that the copy stub is REQUIRED: the accepted base puts
 .text at 0x101000, 4 KB above where the position-dependent code expects to
 be, so the base cannot be chosen to avoid the copy. A fixed VirtualAlloc at
 0x100000 is granted, which is what the stub relies on.

  pec-image-base : Integer = 1048576
  pec-idata-rva : Integer = 4096
  pec-text-rva : Integer = 8192
  pec-file-align : Integer = 512
  pec-sect-align : Integer = 4096
  pec-headers-size : Integer = 512
  pec-subsystem-console : Integer = 3
 WINDOWS DEFAULTS THE STACK TO 1 MB AND THE COMPILER DOES NOT FIT IN IT. Its
 front end recurses over the syntax tree, and bare metal hands it a stack of
 hundreds of megabytes. Measured 2026-08-30: with the 1 MB default the hosted
 compiler read its input, dispatched on its mode and printed a refusal for an
 unknown one, all correctly, and died at 0xC0000005 the moment it was asked to
 compile anything. A reserve costs address space rather than memory, so this is
 not paid for unless it is used.

  pec-stack-reserve : Integer = 536870912

  pec-section-idata-rw : Integer = 3221225536

