  pe-uefi-stub : Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-uefi-stub (text-size) (rodata-size) (start-offset) (hlt-offset) (data-vaddr) =
   let stub0 = pe-build-stub text-size rodata-size start-offset hlt-offset data-vaddr 0
   in let stub-size = list-length stub0
   in pe-build-stub text-size rodata-size start-offset hlt-offset data-vaddr stub-size

  pe-stub-kernel-prolog : List Integer
  pe-stub-kernel-prolog =
   [85, 72, 137, 229,
    83, 65, 84, 65, 85, 65, 86, 65, 87, 86, 87,
    72, 131, 236, 40,
    73, 137, 215,
    73, 137, 206]

  pe-build-stub : Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-build-stub (text-size) (rodata-size) (start-offset) (hlt-offset) (data-vaddr) (stub-size) =
   let tramp-len = list-length pe-stub-trampoline-template
   in let call-off = list-length pe-stub-kernel-prolog
   in let tramp-data-off = stub-size - tramp-len - call-off
   in let text-data-off = stub-size - call-off
   in let rodata-data-off = stub-size + text-size - call-off
   in pe-stub-kernel-prolog
   & [232, 0, 0, 0, 0,
    91,
    72, 131, 235, 5]
   & pe-stub-alloc-pages ((text-size + rodata-size + 4095) / 4096)
   & pe-stub-copy-section text-data-off text-size 1048576
   & pe-stub-copy-rodata-section rodata-data-off rodata-size data-vaddr
   & pe-stub-patch-hlt-insn hlt-offset
   & pe-stub-store-systable
   & pe-stub-exit-boot-services
   & [185, 27, 0, 0, 0, 15, 50, 37, 255, 247, 255, 255, 15, 48]
   & pe-stub-setup-page-tables
   & pe-stub-copy-trampoline tramp-data-off
   & pe-stub-patch-trampoline start-offset
   & pe-stub-jmp-trampoline
   & pe-stub-trampoline-template

