Section: Failure Log

  pb-log : PbCode -> Integer
  pb-log (a) =
    let p = pb-frame a 648
    in let w0 = pb-bytes a [72, 137, 76, 36, 64]
    in let w1 = pb-ref a [72, 139, 13] 1408
    in let w2 = pb-bytes a [72, 141, 84, 36, 96, 65, 184, 4, 1, 0, 0]
    in let w3 = pb-api a 3
    in let w4 = pb-bytes a [133, 192]
    in let no-path = pb-jump a [15, 132]
    in let w5 = pb-bytes a [61, 4, 1, 0, 0]
    in let long-path = pb-jump a [15, 131]
    in let w6 = pb-bytes a [72, 141, 84, 36, 96]
    in let scan = a.pb-position
    in let w7 = pb-bytes a [102, 131, 124, 66, 254, 92]
    in let slash = pb-jump a [15, 132]
    in let w8 = pb-bytes a [255, 200]
    in let again = pb-rel a [15, 133] (a.pb-base + scan)
    in let no-directory = pb-jump a [233]
    in let found = a.pb-position
    in let w9 = pb-bytes a [61, 239, 0, 0, 0]
    in let no-room = pb-jump a [15, 131]
    in let w10 = pb-bytes a [102, 199, 4, 66, 0, 0, 72, 137, 209]
    in let w11 = pb-string a [72, 141, 21] 18
    in let w12 = pb-api a 9
    in let w13 = pb-bytes a [72, 141, 76, 36, 96, 186, 4, 0, 0, 0, 65, 184, 3, 0, 0, 0, 69, 49, 201,
      72, 199, 68, 36, 32, 4, 0, 0, 0, 72, 199, 68, 36, 40, 128, 0, 0, 0, 72, 199, 68, 36, 48, 0, 0, 0, 0]
    in let w14 = pb-api a 4
    in let w15 = pb-bytes a [72, 137, 68, 36, 72, 72, 131, 248, 255]
    in let no-file = pb-jump a [15, 132]
    in let w16 = pb-bytes a [72, 139, 76, 36, 64]
    in let w17 = pb-api a 8
    in let w18 = pb-bytes a [65, 137, 192, 72, 139, 76, 36, 72, 72, 139, 84, 36, 64, 76, 141, 76, 36, 80, 72, 199, 68, 36, 32, 0, 0, 0, 0]
    in let w19 = pb-api a 5
    in let w20 = pb-bytes a [72, 139, 76, 36, 72]
    in let w21 = pb-api a 6
    in let done = a.pb-position
    in let last = pb-return a 648
    in let f0 = pb-fix a no-path done
    in let f1 = pb-fix a long-path done
    in let f2 = pb-fix a slash found
    in let f3 = pb-fix a no-directory done
    in let f4 = pb-fix a no-room done
    in let f5 = pb-fix a no-file done
    in last

Section: Imports and Strings

  pb-import-name : Integer -> Text
  pb-import-name (i) = list-at ["GetModuleHandleW", "GetProcAddress", "VirtualProtect", "GetModuleFileNameW", "CreateFileW", "WriteFile", "CloseHandle", "lstrcmpA", "lstrlenA", "lstrcatW", "FindResourceW", "LoadResource", "LockResource", "SizeofResource", "DisableThreadLibraryCalls"] i

  pb-imports : Integer, Integer, Integer -> Integer
  pb-imports (buf) (rva) (i) =
    if i >= 15 then 0
    else let w0 = ped-put buf (64 + i * 8) (write-i64 (rva + 320 + i * 64))
    in let w1 = ped-put buf (192 + i * 8) (write-i64 (rva + 320 + i * 64))
    in let w2 = ped-ascii buf (322 + i * 64) (pb-import-name i) 0
    in pb-imports buf rva (i + 1)

  pb-name : Integer -> Text
  pb-name (i) = list-at ["UnityPlayer.dll", "GetProcAddress", "mono_runtime_invoke", "mono_method_get_name", "mono_method_get_class", "mono_class_get_name", "SceneLoader", "FejdStartup", "Awake", "mono_image_open_from_data_full", "mono_assembly_load_from_full", "mono_assembly_get_image", "mono_class_from_name", "mono_class_get_method_from_name", "PrismMod.dll", "", "PrismUnityEntry", "Initialize", "prism-bootstrap.log", "Prism captured mono_runtime_invoke\n", "Prism entering managed initializer after scene Awake\n", "REFUSED missing Mono entry points\n", "REFUSED managed payload missing\n", "REFUSED managed image\n", "REFUSED managed assembly\n", "REFUSED managed initializer missing\n", "FAILED managed initializer exception\n", "PASS managed initializer returned\n", "REFUSED Unity import hook\n"] i

  pb-wide : Integer, Integer, Text, Integer -> Integer
  pb-wide (buf) (off) (s) (i) =
    if i >= text-length s then ped-put buf (off + i * 2) [0, 0]
    else let w = ped-put buf (off + i * 2) (write-i16 (to-unicode (char-code-at s i)))
    in pb-wide buf off s (i + 1)

  pb-strings : Integer, Integer -> Integer
  pb-strings (buf) (i) =
    if i >= 29 then 0
    else let w = if i == 0 | i == 18 then pb-wide buf (1600 + i * 128) (pb-name i) 0 else ped-ascii buf (1600 + i * 128) (pb-name i) 0
    in pb-strings buf (i + 1)

Section: DLL Extension

  pb-offset : Integer -> Integer
  pb-offset (i) = list-at [0, 256, 1536, 2560, 4096, 6144] i

  pb-stack : Integer -> Integer
  pb-stack (i) = list-at [56, 104, 72, 88, 136, 648] i

  pb-function : PbCode, Integer -> Integer
  pb-function (a) (i) =
    if i == 0 then pb-entry a
    else if i == 1 then pb-install a
    else if i == 2 then pb-getproc a
    else if i == 3 then pb-invoke a
    else if i == 4 then pb-initialize a
    else pb-log a

  pb-functions : PbCode, Integer, Integer, Integer, Integer -> Boolean
  pb-functions (a) (data) (table) (unwind) (i) =
    if i >= 6 then True
    else let start = pb-offset i
    in let s = __record-set a "pb-position" start
    in let finish = pb-function a i
    in let limit = if i == 5 then 8192 else pb-offset (i + 1)
    in if finish > limit then False
    else let w0 = ped-put data (table + i * 12) (write-i32 (a.pb-base + start) & write-i32 (a.pb-base + finish) & write-i32 (a.pb-data + unwind + i * 8))
    in let w1 = ped-put data (unwind + i * 8) ([1, 7, 2, 0, 7, 1] & write-i16 (pb-stack i / 8))
    in pb-functions a data table unwind (i + 1)

  pb-shift-sections : Integer, Integer -> Integer
  pb-shift-sections (buf) (i) =
    if i >= 4 then 0
    else let off = 328 + i * 40 + 20
    in let w = ped-put buf off (write-i32 (pex-u32 buf off + 512))
    in pb-shift-sections buf (i + 1)

  build-mono-winhttp : List PeExport, Integer, Integer -> PeForwardDll
  build-mono-winhttp (exports) (payload) (payload-size) =
    if payload-size < 1 | payload-size > 67108864 then PeForwardDll { pfd-buffer = 0, pfd-size = 0, pfd-why = "managed payload outside 1..64 MiB" }
    else let forward = build-forwarding-winhttp exports
    in if forward.pfd-why /= "" then forward
    else let old = forward.pfd-buffer
    in let old-size = forward.pfd-size
    in let code-rva = pex-u32 old 144
    in let data-rva = code-rva + 8192
    in let old-table-size = pex-u32 old 228
    in let data-size = align-up (6000 + old-table-size + 72 + 48) 4096
    in let resource-rva = data-rva + data-size
    in let resource-size = 88 + payload-size
    in let code-raw = old-size + 512
    in let data-raw = code-raw + 8192
    in let resource-raw = data-raw + data-size
    in let size = resource-raw + align-up resource-size 512
    in let buf = alloc-bytes size
    in let zero = __memset buf 0 size
    in let c0 = pec-copy buf 0 old 0 512
    in let c1 = pec-copy buf 1024 old 512 (old-size - 512)
    in let shifted = pb-shift-sections buf 0
    in let h0 = ped-put buf 70 (write-i16 7)
    in let h1 = ped-put buf 104 (write-i32 code-rva)
    in let h2 = ped-put buf 144 (write-i32 (align-up (resource-rva + resource-size) 4096))
    in let h3 = ped-put buf 148 (write-i32 1024)
    in let h4 = ped-put buf 92 (write-i32 (pex-u32 old 92 + 8192))
    in let h5 = ped-put buf 96 (write-i32 (pex-u32 old 96 + data-size + align-up resource-size 512))
    in let h6 = ped-put buf 208 (write-i32 data-rva & write-i32 60)
    in let h7 = ped-put buf 216 (write-i32 resource-rva & write-i32 resource-size)
    in let h8 = ped-put buf 224 (write-i32 (data-rva + 6000) & write-i32 (old-table-size + 72))
    in let h9 = ped-put buf 296 (pad-zeros 8)
    in let h10 = ped-put buf 488 (
      pec-section [46, 98, 111, 111, 116] 8192 code-rva 8192 code-raw pe-section-code
      & pec-section [46, 98, 100, 97, 116, 97] data-size data-rva data-size data-raw pec-section-idata-rw
      & pec-section [46, 114, 115, 114, 99] resource-size resource-rva (align-up resource-size 512) resource-raw pe-section-idata-read)
    in let data = buf + data-raw
    in let old-data-raw = pex-u32 old 388
    in let imports = pec-copy data 0 old old-data-raw 20
    in let imp = ped-put data 20 (write-i32 (data-rva + 64) & pad-zeros 8 & write-i32 (data-rva + 1344) & write-i32 (data-rva + 192))
    in let imps = pb-imports data data-rva 0
    in let dll = ped-ascii data 1344 "kernel32.dll" 0
    in let strings = pb-strings data 0
    in let old-pdata-raw = pex-u32 old 428
    in let copy-table = pec-copy data 6000 old old-pdata-raw old-table-size
    in let asm = PbCode { pb-buffer = buf + code-raw, pb-position = 0, pb-base = code-rva, pb-data = data-rva }
    in let valid = pb-functions asm data (6000 + old-table-size) (6000 + old-table-size + 72) 0
    in let r = buf + resource-raw
    in let resource = ped-put r 0 (pad-zeros 14 & write-i16 1 & write-i32 10 & write-i32 2147483672
      & pad-zeros 14 & write-i16 1 & write-i32 101 & write-i32 2147483696
      & pad-zeros 14 & write-i16 1 & write-i32 0 & write-i32 72
      & write-i32 (resource-rva + 88) & write-i32 payload-size & pad-zeros 8)
    in let body = pec-copy r 88 payload 0 payload-size
    in if not valid then PeForwardDll { pfd-buffer = 0, pfd-size = 0, pfd-why = "bootstrap function exceeds its section slot" }
    else PeForwardDll { pfd-buffer = buf, pfd-size = size, pfd-why = "" }
