Section: Win64 Assembly

 PbCode is a single-owner emission cursor. RIP displacements refer to image
 RVAs, not preferred virtual addresses. Win64 frames reserve shadow space
 and leave RSP aligned at every call. Each frame has matching unwind data.

  PbCode = record { pb-buffer : Integer, pb-position : Integer, pb-base : Integer, pb-data : Integer }

  pb-bytes : PbCode, List Integer -> Integer
  pb-bytes (a) (bytes) =
    let next = ped-put (a.pb-buffer) (a.pb-position) bytes
    in let w = __record-set a "pb-position" next
    in next

  pb-rel : PbCode, List Integer, Integer -> Integer
  pb-rel (a) (op) (rva) =
    let next = ped-rel (a.pb-buffer) (a.pb-position) op (rva - a.pb-base)
    in let w = __record-set a "pb-position" next
    in next

  pb-ref : PbCode, List Integer, Integer -> Integer
  pb-ref (a) (op) (off) = pb-rel a op (a.pb-data + off)

  pb-api : PbCode, Integer -> Integer
  pb-api (a) (i) = pb-ref a [255, 21] (192 + i * 8)

  pb-call : PbCode, Integer -> Integer
  pb-call (a) (off) = pb-rel a [232] (a.pb-base + off)

  pb-jump : PbCode, List Integer -> Integer
  pb-jump (a) (op) = pb-rel a op 0

  pb-fix : PbCode, Integer, Integer -> Integer
  pb-fix (a) (after) (target) = ped-put (a.pb-buffer) (after - 4) (write-i32 (target - after))

  pb-string : PbCode, List Integer, Integer -> Integer
  pb-string (a) (op) (i) = pb-ref a op (1600 + i * 128)

  pb-frame : PbCode, Integer -> Integer
  pb-frame (a) (size) = pb-bytes a ([72, 129, 236] & write-i32 size)

  pb-return : PbCode, Integer -> Integer
  pb-return (a) (size) = pb-bytes a ([72, 129, 196] & write-i32 size & [195])

  pb-log-message : PbCode, Integer -> Integer
  pb-log-message (a) (i) =
    let w = pb-string a [72, 141, 13] i
    in pb-call a 6144

Section: Entry and Import Hook

  pb-entry : PbCode -> Integer
  pb-entry (a) =
    let p = pb-frame a 56
    in let w0 = pb-bytes a [72, 137, 76, 36, 32, 137, 84, 36, 40]
    in let old = pb-rel a [232] 4096
    in let w1 = pb-bytes a [131, 124, 36, 40, 1]
    in let skip = pb-jump a [15, 133]
    in let w2 = pb-bytes a [72, 139, 76, 36, 32]
    in let w3 = pb-ref a [72, 137, 13] 1408
    in let w4 = pb-api a 14
    in let w5 = pb-string a [72, 141, 13] 0
    in let w6 = pb-api a 0
    in let w7 = pb-bytes a [72, 137, 193]
    in let w8 = pb-call a 256
    in let done = a.pb-position
    in let w9 = pb-bytes a [184, 1, 0, 0, 0]
    in let last = pb-return a 56
    in let f = pb-fix a skip done
    in last

  pb-install : PbCode -> Integer
  pb-install (a) =
    let p = pb-frame a 104
    in let w0 = pb-bytes a [72, 137, 76, 36, 32, 72, 133, 201]
    in let no-module = pb-jump a [15, 132]
    in let w1 = pb-bytes a [102, 129, 57, 77, 90]
    in let bad-mz = pb-jump a [15, 133]
    in let w2 = pb-bytes a [139, 65, 60, 72, 1, 200, 129, 56, 80, 69, 0, 0]
    in let bad-pe = pb-jump a [15, 133]
    in let w3 = pb-bytes a [139, 128, 144, 0, 0, 0, 133, 192]
    in let no-imports = pb-jump a [15, 132]
    in let w4 = pb-bytes a [72, 1, 200, 72, 137, 68, 36, 40, 199, 68, 36, 72, 0, 0, 0, 0]
    in let descriptor = a.pb-position
    in let w5 = pb-bytes a [72, 139, 68, 36, 40, 131, 120, 12, 0]
    in let finish-desc = pb-jump a [15, 132]
    in let w6 = pb-bytes a [139, 16, 133, 210]
    in let no-names = pb-jump a [15, 132]
    in let w7 = pb-bytes a [72, 3, 84, 36, 32, 72, 137, 84, 36, 48, 139, 80, 16, 72, 3, 84, 36, 32, 72, 137, 84, 36, 56]
    in let symbol = a.pb-position
    in let w8 = pb-bytes a [72, 139, 68, 36, 48, 72, 139, 0, 72, 133, 192]
    in let finish-names = pb-jump a [15, 132]
    in let ordinal = pb-jump a [15, 136]
    in let w9 = pb-bytes a [72, 3, 68, 36, 32, 72, 141, 72, 2]
    in let w10 = pb-string a [72, 141, 21] 1
    in let w11 = pb-api a 7
    in let w12 = pb-bytes a [133, 192]
    in let other-name = pb-jump a [15, 133]
    in let w13 = pb-bytes a [72, 139, 76, 36, 56, 186, 8, 0, 0, 0, 65, 184, 4, 0, 0, 0, 76, 141, 76, 36, 64]
    in let w14 = pb-api a 2
    in let w15 = pb-bytes a [133, 192]
    in let protect-failed = pb-jump a [15, 132]
    in let w16 = pb-rel a [72, 141, 5] (a.pb-base + 1536)
    in let w17 = pb-bytes a [72, 139, 76, 36, 56, 72, 135, 1,
      199, 68, 36, 72, 1, 0, 0, 0, 186, 8, 0, 0, 0,
      68, 139, 68, 36, 64, 76, 141, 76, 36, 68]
    in let w18 = pb-api a 2
    in let next-name = a.pb-position
    in let w19 = pb-bytes a [72, 131, 68, 36, 48, 8, 72, 131, 68, 36, 56, 8]
    in let back-name = pb-rel a [233] (a.pb-base + symbol)
    in let next-desc = a.pb-position
    in let w20 = pb-bytes a [72, 131, 68, 36, 40, 20]
    in let back-desc = pb-rel a [233] (a.pb-base + descriptor)
    in let check-found = a.pb-position
    in let w21 = pb-bytes a [131, 124, 36, 72, 0]
    in let found = pb-jump a [15, 133]
    in let refuse = a.pb-position
    in let message = pb-log-message a 28
    in let done = a.pb-position
    in let last = pb-return a 104
    in let f0 = pb-fix a no-module refuse
    in let f1 = pb-fix a bad-mz refuse
    in let f2 = pb-fix a bad-pe refuse
    in let f3 = pb-fix a no-imports refuse
    in let f4 = pb-fix a finish-desc check-found
    in let f5 = pb-fix a no-names next-desc
    in let f6 = pb-fix a finish-names next-desc
    in let f7 = pb-fix a ordinal next-name
    in let f8 = pb-fix a other-name next-name
    in let f9 = pb-fix a protect-failed next-name
    in let f10 = pb-fix a found done
    in last

  pb-resolve-mono : PbCode, Integer, Integer -> Integer
  pb-resolve-mono (a) (name) (slot) =
    let w0 = pb-ref a [72, 139, 13] 1416
    in let w1 = pb-string a [72, 141, 21] name
    in let w2 = pb-api a 1
    in let w3 = pb-ref a [72, 137, 5] slot
    in pb-bytes a [72, 133, 192]

  pb-getproc : PbCode -> Integer
  pb-getproc (a) =
    let p = pb-frame a 72
    in let w0 = pb-bytes a [72, 137, 76, 36, 32, 72, 137, 84, 36, 40]
    in let w1 = pb-api a 1
    in let w2 = pb-bytes a [72, 137, 68, 36, 48, 72, 133, 192]
    in let absent = pb-jump a [15, 132]
    in let w3 = pb-bytes a [72, 139, 76, 36, 40, 72, 129, 249, 255, 255, 0, 0]
    in let ordinal = pb-jump a [15, 134]
    in let w4 = pb-string a [72, 141, 21] 2
    in let w5 = pb-api a 7
    in let w6 = pb-bytes a [133, 192]
    in let other = pb-jump a [15, 133]
    in let w7 = pb-bytes a [72, 139, 68, 36, 32]
    in let w8 = pb-ref a [72, 137, 5] 1416
    in let w9 = pb-bytes a [72, 139, 68, 36, 48]
    in let w10 = pb-ref a [72, 137, 5] 1424
    in let w11 = pb-resolve-mono a 3 1432
    in let missing1 = pb-jump a [15, 132]
    in let w12 = pb-resolve-mono a 4 1440
    in let missing2 = pb-jump a [15, 132]
    in let w13 = pb-resolve-mono a 5 1448
    in let missing3 = pb-jump a [15, 132]
    in let w14 = pb-log-message a 19
    in let w15 = pb-rel a [72, 141, 5] (a.pb-base + 2560)
    in let w16 = pb-bytes a [72, 137, 68, 36, 48]
    in let yes = pb-jump a [233]
    in let refuse = a.pb-position
    in let w17 = pb-log-message a 21
    in let done = a.pb-position
    in let w18 = pb-bytes a [72, 139, 68, 36, 48]
    in let last = pb-return a 72
    in let f0 = pb-fix a absent done
    in let f1 = pb-fix a ordinal done
    in let f2 = pb-fix a other done
    in let f3 = pb-fix a missing1 refuse
    in let f4 = pb-fix a missing2 refuse
    in let f5 = pb-fix a missing3 refuse
    in let f6 = pb-fix a yes done
    in last

