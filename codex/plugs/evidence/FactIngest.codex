Chapter: FactIngest
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Foreword chapter FactStore
  cites Foreword chapter TextSearch
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist

 Writes one compliance-evidence fact into the fact store partition of the
 disk codex-vm attached (`-disk`), the way an app persists: kind 50 (the
 AppPersist register), content one line naming the firmware's header hash,
 the package hash and the counts, timestamp the caller's. Input on the
 serial ring: `timestamp <n>`, `content <text>`, `END`. Output: one line
 `FACT ok kind=50 hash=<fact hash> count=<facts in store> head=<log head>`
 after a read-back of the entry, or `FACT refused <why>`. The opening
 declares Device.Block because the declared effects become the binary's
 capability grant: without it every block read answers zeros and a write
 goes nowhere, silently.

 We say:

Section: Kind

  fi-kind : Integer = 50

Section: Ring

  FiInput = record {
    fi-ts : Integer,
    fi-content : Text
  }

  fi-key : Text -> Text
  fi-key (line) =
    let parts = text-split line " "
    in if list-length parts == 0 then "" else list-at parts 0

  fi-value : Text -> Text
  fi-value (line) =
    let k = fi-key line
    in if text-length line <= text-length k + 1 then "" else substring line (text-length k + 1) (text-length line - text-length k - 1)

  fi-read : FiInput, Integer -> [Console] FiInput
  fi-read (i) (fuel) = act
    if fuel <= 0 then i
    else act
      r <- read-line-cce
      when r
        is None -> i
        is Just (line) -> fi-step i line fuel
      end
    end
  end

  fi-step : FiInput, Text, Integer -> [Console] FiInput
  fi-step (i) (line) (fuel) = act
    if line == "END" then i
    else if fi-key line == "timestamp" then fi-read (FiInput { fi-ts = text-to-integer (fi-value line), fi-content = i.fi-content }) (fuel - 1)
    else if fi-key line == "content" then fi-read (FiInput { fi-ts = i.fi-ts, fi-content = fi-value line }) (fuel - 1)
    else fi-read i (fuel - 1)
  end

Section: Body

 A package already recorded (same content) is reported ok without a second
 append: the store's log grows, and re-running an evidence run for an
 unchanged build should not double it. app-scan-all reads every kind-50 entry
 and compares content, because the fact hash the mem store dedups on is not
 loaded from disk (disk-load rebuilds mem from the log, but a fresh disk-load
 here has only what the log holds).

  fi-already : DiskFactStore, Text -> Boolean
  fi-already (store) (content) = fi-any (app-scan-all store fi-kind) content 0

  fi-any : List Text, Text, Integer -> Boolean
  fi-any (xs) (content) (i) =
    if i >= list-length xs then False
    else if list-at xs i == content then True
    else fi-any xs content (i + 1)

  fi-write : FiInput -> Text
  fi-write (i) =
    let store = disk-load
    in if disk-usable store == False then "FACT refused no fact store on the attached disk (no partition of the facts type, or the GPT did not read)"
    else if text-length (i.fi-content) == 0 then "FACT refused empty content"
    else if fi-already store (i.fi-content) then "FACT ok kind=" & show fi-kind & " hash=" & fact-content-hash (i.fi-content) & " count=" & show (store.superblock.fact-count) & " head=" & show (store.superblock.log-head) & " (already present)"
    else let s2 = app-write-and-checkpoint store fi-kind (i.fi-content) (i.fi-ts)
    in if s2.superblock.fact-count == store.superblock.fact-count then "FACT refused the store did not admit the entry (region full or unusable)"
    else when app-scan-last s2 fi-kind
      is None -> "FACT refused written but not readable back"
      is Just (back) -> (if back == i.fi-content then "FACT ok kind=" & show fi-kind & " hash=" & fact-content-hash (i.fi-content) & " count=" & show (s2.superblock.fact-count) & " head=" & show (s2.superblock.log-head) else "FACT refused read-back differs from what was written")

  opening : [Console, Device.Block] Nothing = act
    i <- fi-read (FiInput { fi-ts = 0, fi-content = "" }) 10000
    print-line-uni (fi-write i)
  end
