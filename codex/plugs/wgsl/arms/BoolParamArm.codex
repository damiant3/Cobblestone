Chapter: BoolParamArm
  cites Gpu chapter DeviceEffect

 We say:

Section: Kernels

  bp-pick : Boolean, Real -> Real
  bp-pick (flag) (x) = if flag then x else 0.0 - x

  bp-pos : Real -> Boolean
  bp-pos (x) = x > 0.0

  bp-abs : Integer, Integer, Integer -> [Device] Integer
  bp-abs (xb) (yb) (gid) = act
    x <- device-load-f32 xb gid
    device-store-f32 yb gid (bp-pick (bp-pos x) x)
  end
