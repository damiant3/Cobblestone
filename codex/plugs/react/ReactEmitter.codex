Chapter: React Emitter

Section: Sanitization

  react-sanitize : Text -> Text
  react-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  react-slash-pos : Text, Integer, Integer -> Integer
  react-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else react-slash-pos f (i + 1) len

  react-field : Text -> Text
  react-field (f) =
   let slash = react-slash-pos f 0 (text-length f)
   in if slash >= 0 then react-sanitize (substring f 0 slash)
      else react-sanitize f

  jsx-escape : Text -> Text
  jsx-escape (s) =
   let s1 = text-replace s "&" "&amp;"
   in let s2 = text-replace s1 "<" "&lt;"
   in let s3 = text-replace s2 ">" "&gt;"
   in let s4 = text-replace s3 "\"" "&quot;"
   in s4

  js-escape : Text -> Text
  js-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

  react-indent : Integer -> Text
  react-indent (n) =
   if n <= 0 then ""
   else "  " & react-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0 - 1
      else let e = list-at entries pos
      in if e.name == name then e.arity else 0 - 1

Section: Expression Emission

  emit-jsx-name : Text, List ArityEntry -> Text
  emit-jsx-name (n) (arities) =
   if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then react-sanitize n
   else let ar = lookup-arity arities n
   in if ar == 0 then react-sanitize n & "()"
      else if ar >= 2 then emit-jsx-partial-wrappers 0 ar & react-sanitize n & "(" & emit-jsx-partial-params 0 ar & ")"
      else react-sanitize n

  emit-jsx-lambda-params : List IRParam, Integer -> Text
  emit-jsx-lambda-params (params) (i) =
   if i == list-length params then ""
   else "(" & react-sanitize (list-at params i).name & ") => " & emit-jsx-lambda-params params (i + 1)

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

  prelude-arities : Text -> List ArityEntry
  prelude-arities (src) = prelude-scan (text-split src "function ") 1 []

  prelude-scan : List Text, Integer, List ArityEntry -> List ArityEntry
  prelude-scan (parts) (i) (acc) =
   if i >= list-length parts then acc
   else prelude-scan parts (i + 1) (sorted-insert-arity acc (prelude-entry (list-at parts i)))

  prelude-entry : Text -> ArityEntry
  prelude-entry (part) =
   let open = prelude-pos part "(" 0
   in let close = prelude-pos part ")" open
   in let params = substring part (open + 1) (close - open - 1)
   in ArityEntry { name = prelude-name (substring part 0 open), arity = __narrow (if text-length params == 0 then 0 else list-length (text-split params ",")), generic-count = 0 }

  prelude-pos : Text, Text, Integer -> Integer
  prelude-pos (s) (ch) (i) =
   if i >= text-length s then i
   else if char-to-text (char-at s i) == ch then i
   else prelude-pos s ch (i + 1)

  prelude-name : Text -> Text
  prelude-name (n) =
   if text-starts-with n "__" then n else text-replace n "_" "-"

  emit-jsx-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-jsx-expr (e) (arities) (indent) =
   when e
    is IrIntLit (n) (sp) -> show n
    is IrNumLit (n) (sp) -> show n
    is IrTextLit (s) (sp) -> "\"" & js-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> "String.fromCharCode(" & show n & ")"
    is IrName (n) (ty) (sp) -> emit-jsx-name n arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-jsx-binary op l r arities indent
    is IrNegate (x) (nty) (sp) -> "(-(" & emit-jsx-expr x arities indent & "))"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-jsx-expr c arities indent & " ? " & emit-jsx-expr t arities indent & " : " & emit-jsx-expr el arities indent & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> emit-jsx-let name val body arities indent
    is IrApply (f) (a) (ty) (sp) -> emit-jsx-apply e arities indent
    is IrLambda (params) (body) (ty) (sp) -> if list-length params == 0 then "(() => " & emit-jsx-expr body arities indent & ")" else "(" & emit-jsx-lambda-params params 0 & emit-jsx-expr body arities indent & ")"
    is IrList (elems) (ty) (sp) -> "[" & emit-jsx-list-elems elems arities indent 0 & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-jsx-match scrut branches arities indent
    is IrAct (stmts) (ty) (sp) -> emit-jsx-act stmts arities indent
    is IrRecord (name) (fields) (ty) (sp) -> "{ _type: \"" & name & "\"" & emit-jsx-record-fields fields arities indent 0 & " }"
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-jsx-expr rec arities indent & "." & react-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(" & emit-jsx-expr rec arities indent & "." & react-field field & " = " & emit-jsx-expr val arities indent & ")"
    is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => " & emit-jsx-expr body arities indent & ")"
    is IrAwait (task) (ty) (sp) -> "(await " & emit-jsx-expr task arities indent & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-jsx-expr body arities indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-jsx-expr body arities indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-jsx-act body arities indent
    is IrError (msg) (ty) (sp) -> "(() => { throw new Error(\"" & js-escape msg & "\"); })()"

Section: Binary Operators

  emit-jsx-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-jsx-binary (op) (l) (r) (arities) (indent) =
   let lhs = emit-jsx-expr l arities indent
   in let rhs = emit-jsx-expr r arities indent
   in when op
    is IrAddInt | IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt | IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt -> "Math.trunc(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "(" & lhs & " % " & rhs & ")"
    is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
    is IrAddVec -> "(" & lhs & ".map((v,i) => v + " & rhs & "[i]))"
    is IrSubVec -> "(" & lhs & ".map((v,i) => v - " & rhs & "[i]))"
    is IrMulVec -> "(" & lhs & ".map((v,i) => v * " & rhs & "[i]))"
    is IrDivVec -> "(" & lhs & ".map((v,i) => v / " & rhs & "[i]))"
    is IrEq -> "(" & lhs & " === " & rhs & ")"
    is IrNotEq -> "(" & lhs & " !== " & rhs & ")"
    is IrLt | IrLtVec -> "(" & lhs & " < " & rhs & ")"
    is IrGt | IrGtVec -> "(" & lhs & " > " & rhs & ")"
    is IrLtEq | IrLtEqVec -> "(" & lhs & " <= " & rhs & ")"
    is IrGtEq | IrGtEqVec -> "(" & lhs & " >= " & rhs & ")"
    is IrApproxEq | IrApproxEqExact -> "(" & lhs & " === " & rhs & ")"
    is IrAnd -> "(" & lhs & " && " & rhs & ")"
    is IrOr -> "(" & lhs & " || " & rhs & ")"
    is IrAppendText -> "(" & lhs & " + " & rhs & ")"
    is IrAppendList -> "([..." & lhs & ", ..." & rhs & "])"
    is IrConsList -> "[" & lhs & ", ..." & rhs & "]"

Section: Let, Apply, Match, Act

  emit-jsx-let : Text, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-jsx-let (name) (val) (body) (arities) (indent) =
   "(() => {\n" & react-indent (indent + 1) & "const " & react-sanitize name & " = " & emit-jsx-expr val arities (indent + 1) & ";\n" & react-indent (indent + 1) & "return " & emit-jsx-expr body arities (indent + 1) & ";\n" & react-indent indent & "})()"

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-jsx-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-jsx-apply (e) (arities) (indent) =
   let chain = collect-apply-chain e []
   in let func = emit-jsx-expr (chain.root) arities indent
   in when (chain.root)
    is IrName (n) (ty) (sp) ->
     if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then react-sanitize n & "(" & emit-jsx-apply-args (chain.args) arities indent 0 & ")"
     else let ar = lookup-arity arities n
     in if ar < 0 then react-sanitize n & emit-jsx-apply-rest (chain.args) arities indent 0
        else if ar == 0 then react-sanitize n & "()" & emit-jsx-apply-rest (chain.args) arities indent 0
        else emit-jsx-apply-split (react-sanitize n) (chain.args) ar arities indent
    is otherwise -> "(" & func & ")" & emit-jsx-apply-rest (chain.args) arities indent 0

  emit-jsx-apply-split : Text, List IRExpr, Integer, List ArityEntry, Integer -> Text
  emit-jsx-apply-split (func) (args) (ar) (arities) (indent) =
   if ar > 0 & list-length args > ar
   then func & "(" & emit-jsx-apply-args (list-take args ar) arities indent 0 & ")" & emit-jsx-apply-rest (list-drop args ar) arities indent 0
   else if ar > 0 & list-length args > 0 & list-length args < ar
   then emit-jsx-partial-wrappers 0 (ar - list-length args) & func & "(" & emit-jsx-apply-args args arities indent 0 & ", " & emit-jsx-partial-params 0 (ar - list-length args) & ")"
   else func & "(" & emit-jsx-apply-args args arities indent 0 & ")"

  emit-jsx-partial-wrappers : Integer, Integer -> Text
  emit-jsx-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & show i & "_) => " & emit-jsx-partial-wrappers (i + 1) count

  emit-jsx-partial-params : Integer, Integer -> Text
  emit-jsx-partial-params (i) (count) =
   if i == count then ""
   else (if i > 0 then ", " else "") & "_p" & show i & "_" & emit-jsx-partial-params (i + 1) count

  emit-jsx-apply-rest : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-jsx-apply-rest (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else "(" & emit-jsx-expr (list-at args i) arities indent & ")" & emit-jsx-apply-rest args arities indent (i + 1)

  emit-jsx-apply-args : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-jsx-apply-args (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-jsx-expr (list-at args i) arities indent & emit-jsx-apply-args args arities indent (i + 1)

  emit-jsx-param-names : List IRParam, Integer -> Text
  emit-jsx-param-names (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & react-sanitize (list-at params i).name & emit-jsx-param-names params (i + 1)

  emit-jsx-list-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-jsx-list-elems (elems) (arities) (indent) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-jsx-expr (list-at elems i) arities indent & emit-jsx-list-elems elems arities indent (i + 1)

  emit-jsx-record-fields : List IRFieldVal, List ArityEntry, Integer, Integer -> Text
  emit-jsx-record-fields (fields) (arities) (indent) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ", " & react-sanitize (f.name) & ": " & emit-jsx-expr (f.value) arities indent & emit-jsx-record-fields fields arities indent (i + 1)

  emit-jsx-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-jsx-match (scrut) (branches) (arities) (indent) =
   let sv = emit-jsx-expr scrut arities indent
   in "(() => {\n" & react-indent (indent + 1) & "const _s = " & sv & ";\n" & emit-jsx-branches branches arities (indent + 1) 0 & react-indent indent & "})()"

  emit-jsx-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-jsx-branches (branches) (arities) (indent) (i) =
   if i == list-length branches then react-indent indent & "throw new Error('non-exhaustive match');\n"
   else let b = list-at branches i
   in let cond = emit-jsx-pattern-cond (b.pattern) "_s"
   in let binds = emit-jsx-pattern-binds (b.pattern) "_s" indent
   in let body = emit-jsx-expr (b.body) arities indent
   in let ret = if jsx-guard-trivial (b.guard)
                then react-indent (indent + 1) & "return " & body & ";\n"
                else react-indent (indent + 1) & "if (" & emit-jsx-expr (b.guard) arities indent & ") { return " & body & "; }\n"
   in react-indent indent & "if (" & cond & ") {\n" & binds & ret & react-indent indent & "}\n" & emit-jsx-branches branches arities indent (i + 1)

 A guarded arm must not chain with else-if: the guard needs the pattern
 bindings, which sit inside the block, so a failed guard has to fall OUT of
 the block and reach the next test. Sequential ifs give that and an else-if
 chain cannot. The old shape also put the non-exhaustive throw INSIDE the
 last arm's block, where it fires when that arm's condition fails rather
 than when every arm has. With a trailing catch-all it is dead code.

  jsx-guard-trivial : IRExpr -> Boolean
  jsx-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  emit-jsx-pattern-cond : IRPat, Text -> Text
  emit-jsx-pattern-cond (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "true"
    is IrLitPat (text) (ty) (sp) -> scrut & " === " & text
    is IrCtorPat (name) (subs) (ty) (sp) -> scrut & "._tag === \"" & name & "\""
    is IrWildPat (sp) -> "true"
    is IrVecPat (pats) (ty) (sp) -> "true"

  emit-jsx-pattern-binds : IRPat, Text, Integer -> Text
  emit-jsx-pattern-binds (p) (scrut) (indent) =
   when p
    is IrVarPat (name) (ty) (sp) -> react-indent (indent + 1) & "const " & react-sanitize name & " = " & scrut & ";\n"
    is IrLitPat (text) (ty) (sp) -> ""
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-jsx-ctor-binds subs scrut indent 0
    is IrWildPat (sp) -> ""
    is IrVecPat (pats) (ty) (sp) -> ""

  emit-jsx-ctor-binds : List IRPat, Text, Integer, Integer -> Text
  emit-jsx-ctor-binds (subs) (scrut) (indent) (i) =
   if i == list-length subs then ""
   else let field-access = scrut & "._" & show i
   in emit-jsx-pattern-binds (list-at subs i) field-access indent & emit-jsx-ctor-binds subs scrut indent (i + 1)

  emit-jsx-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-jsx-act (stmts) (arities) (indent) =
   "(() => {\n" & emit-jsx-act-stmts stmts arities (indent + 1) 0 & react-indent indent & "})()"

  emit-jsx-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-jsx-act-stmts (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in when s
    is IrDoBind (name) (ty) (val) (sp) -> react-indent indent & "const " & react-sanitize name & " = " & emit-jsx-expr val arities indent & ";\n" & emit-jsx-act-stmts stmts arities indent (i + 1)
    is IrDoExec (e) (sp) ->
     if is-last then react-indent indent & "return " & emit-jsx-expr e arities indent & ";\n"
     else react-indent indent & emit-jsx-expr e arities indent & ";\n" & emit-jsx-act-stmts stmts arities indent (i + 1)

Section: Type Definitions

  emit-jsx-type-def : ATypeDef -> Text
  emit-jsx-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     "function " & react-sanitize (name.value) & "(fields) { return { _type: \"" & name.value & "\", ...fields }; }\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-jsx-variant-ctors ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-jsx-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-jsx-variant-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in let ctor-text = if n == 0 then "const " & react-sanitize (c.name.value) & " = { _tag: \"" & c.name.value & "\" };\n"
      else "function " & react-sanitize (c.name.value) & "(" & emit-jsx-ctor-params n 0 & ") { return { _tag: \"" & c.name.value & "\"" & emit-jsx-ctor-fields n 0 & " }; }\n"
   in ctor-text & emit-jsx-variant-ctors ctors (i + 1)

  emit-jsx-ctor-params : Integer, Integer -> Text
  emit-jsx-ctor-params (n) (i) =
   if i == n then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "_" & show i & emit-jsx-ctor-params n (i + 1)

  emit-jsx-ctor-fields : Integer, Integer -> Text
  emit-jsx-ctor-fields (n) (i) =
   if i == n then ""
   else ", _" & show i & ": _" & show i & emit-jsx-ctor-fields n (i + 1)

Section: Definition Emission

  emit-jsx-def : IRDef, List ArityEntry -> Text
  emit-jsx-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else let sname = react-sanitize (d.name)
   in if list-length (d.params) == 0
      then "function " & sname & "() {\n  return " & emit-jsx-expr (d.body) arities 1 & ";\n}\n\n"
      else "function " & sname & "(" & emit-jsx-param-names (d.params) 0 & ") {\n  return " & emit-jsx-expr (d.body) arities 1 & ";\n}\n\n"

  emit-jsx-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-jsx-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-jsx-def (list-at defs i) arities & emit-jsx-defs defs (i + 1) arities

  emit-jsx-type-defs : List ATypeDef, Integer -> Text
  emit-jsx-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-jsx-type-def (list-at tds i) & emit-jsx-type-defs tds (i + 1)

Section: React Component Assembly

  emit-react-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-react-chapter (m) (meta) (type-defs) =
   let title = if meta.chapter-title == "" then "App" else meta.chapter-title
   in let imports = "import React, { useState, useEffect, useRef } from 'react';\n\n"
   in let builtins = "function __narrow(n) { return n; }\nfunction print_line_uni(s) { console.log(s); }\nfunction print_line(s) { console.log(s); }\nfunction show(n) { return String(n); }\nfunction text_length(s) { return s.length; }\nfunction text_replace(s, a, b) { return a.length === 0 ? s : s.split(a).join(b); }\nfunction text_compare(a, b) { return a < b ? -1 : a > b ? 1 : 0; }\nfunction list_length(xs) { return xs.length; }\nfunction list_at(xs, i) { return xs[i]; }\nfunction list_push(xs, x) { return [...xs, x]; }\nfunction integer_to_text(n) { return String(n); }\nfunction char_code(c) { return c.charCodeAt ? c.charCodeAt(0) : c; }\nfunction char_at(s, i) { return s[i]; }\nfunction negate(n) { return -n; }\nfunction text_starts_with(s, p) { return s.startsWith(p); }\nfunction text_contains(s, sub) { return s.includes(sub); }\nfunction text_split(s, sep) { return sep.length === 0 ? [s] : s.split(sep); }\nfunction text_to_integer(s) { let t = String(s); let i = 0; let neg = false; if (t.charAt(0) === '-') { neg = true; i = 1; } let v = 0; while (i < t.length && t.charAt(i) >= '0' && t.charAt(i) <= '9') { v = v * 10 + (t.charCodeAt(i) - 48); i = i + 1; } return neg ? -v : v; }\n\n"
   in let arities = build-arity-map (m.defs) 0 (prelude-arities builtins)
   in let types-text = emit-jsx-type-defs type-defs 0
   in let defs-text = emit-jsx-defs (m.defs) 0 arities
   in let component = "export default function " & react-sanitize title & "() {\n  const [output, setOutput] = useState([]);\n  useEffect(() => {\n    const _print = print_line_uni;\n    print_line_uni = (s) => setOutput(prev => [...prev, s]);\n    try { opening(); } catch(e) { console.error(e); }\n    print_line_uni = _print;\n  }, []);\n  return (\n    <div className=\"app\">\n      {output.map((line, i) => <div key={i}>{line}</div>)}\n    </div>\n  );\n}\n"
   in imports & builtins & types-text & defs-text & component
