Chapter: Fat32Writer

Section: FAT32 Constants
  fat32-reserved-sectors : Integer = 32
  fat32-num-fats : Integer = 2
  fat32-eoi : Integer = 268435455

Section: Layout
  Fat32Layout = record {
   part-offset : Integer,
   part-sectors : Integer,
   fat-sectors : Integer,
   data-start-sect : Integer,
   total-clusters : Integer
  }

  fat32-compute-layout : Integer -> Fat32Layout
  fat32-compute-layout (total-sectors) =
   let backup-entries-lba = total-sectors - 1 - gpt-entry-sectors
   in let part-end-lba = backup-entries-lba - 1
   in let part-sectors = part-end-lba - gpt-part-start-lba + 1
   in let part-offset = gpt-part-start-lba * gpt-sector-size
   in let clusters-est = part-sectors - fat32-reserved-sectors
   in let fat-bytes = (clusters-est + 2) * 4
   in let fat-sectors = (fat-bytes + gpt-sector-size - 1) / gpt-sector-size
   in let data-start-sect = fat32-reserved-sectors + fat32-num-fats * fat-sectors
   in let data-sectors = part-sectors - data-start-sect
   in Fat32Layout {
    part-offset = part-offset,
    part-sectors = part-sectors,
    fat-sectors = fat-sectors,
    data-start-sect = data-start-sect,
    total-clusters = data-sectors
   }

Section: BPB
  fat32-write-bpb : Integer, Fat32Layout -> Integer
  fat32-write-bpb (buf) (lay) =
   let p = lay.part-offset
   in let w0 = __buf-write-byte buf p 235
   in let w1 = __buf-write-byte buf (p + 1) 88
   in let w2 = __buf-write-byte buf (p + 2) 144
   in let w3 = fat32-write-oem-name buf (p + 3) "CODEXOS " 0
   in let w4 = gpt-buf-write-i16 buf (p + 11) gpt-sector-size
   in let w5 = __buf-write-byte buf (p + 13) 1
   in let w6 = gpt-buf-write-i16 buf (p + 14) fat32-reserved-sectors
   in let w7 = __buf-write-byte buf (p + 16) fat32-num-fats
   in let w8 = __buf-write-byte buf (p + 21) 248
   in let w9 = gpt-buf-write-i16 buf (p + 24) 63
   in let w10 = gpt-buf-write-i16 buf (p + 26) 255
   in let w11 = gpt-buf-write-i32 buf (p + 28) gpt-part-start-lba
   in let w12 = gpt-buf-write-i32 buf (p + 32) (lay.part-sectors)
   in let w13 = gpt-buf-write-i32 buf (p + 36) (lay.fat-sectors)
   in let w14 = gpt-buf-write-i32 buf (p + 44) 2
   in let w15 = gpt-buf-write-i16 buf (p + 48) 1
   in let w16 = gpt-buf-write-i16 buf (p + 50) 6
   in let w17 = __buf-write-byte buf (p + 64) 128
   in let w18 = __buf-write-byte buf (p + 66) 41
   in let w19 = gpt-buf-write-i32 buf (p + 67) 3235905537
   in let w20 = fat32-write-oem-name buf (p + 71) "CODEX OS   " 0
   in let w21 = fat32-write-oem-name buf (p + 82) "FAT32   " 0
   in let w22 = __buf-write-byte buf (p + 510) 85
   in let w23 = __buf-write-byte buf (p + 511) 170
   in 0

  fat32-write-oem-name : Integer, Integer, Text, Integer -> Integer
  fat32-write-oem-name (buf) (off) (s) (i) =
   if i >= text-length s then off + text-length s
   else let w = __buf-write-byte buf (off + i) (char-code-at s i)
   in fat32-write-oem-name buf off s (i + 1)

Section: FSInfo
  fat32-write-fsinfo : Integer, Fat32Layout -> Integer
  fat32-write-fsinfo (buf) (lay) =
   let fsi = lay.part-offset + gpt-sector-size
   in let w0 = gpt-buf-write-i32 buf fsi 1098025042
   in let w1 = gpt-buf-write-i32 buf (fsi + 484) 1633967730
   in let w2 = gpt-buf-write-i32 buf (fsi + 488) (lay.total-clusters - 10)
   in let w3 = gpt-buf-write-i32 buf (fsi + 492) 6
   in let w4 = __buf-write-byte buf (fsi + 510) 85
   in let w5 = __buf-write-byte buf (fsi + 511) 170
   in 0

Section: Backup Boot Sector
  fat32-write-backup-boot : Integer, Fat32Layout -> Integer
  fat32-write-backup-boot (buf) (lay) =
   let src = lay.part-offset
   in let dst = lay.part-offset + 6 * gpt-sector-size
   in let hp = __heap-save
   in let bpb = __buf-read-bytes buf src gpt-sector-size
   in let w0 = __buf-write-bytes buf dst bpb
   in let fsi = __buf-read-bytes buf (src + gpt-sector-size) gpt-sector-size
   in let w1 = __buf-write-bytes buf (dst + gpt-sector-size) fsi
   in let restored = __heap-restore hp
   in 0

Section: FAT Tables
  fat32-fat-offset : Fat32Layout -> Integer
  fat32-fat-offset (lay) = lay.part-offset + fat32-reserved-sectors * gpt-sector-size

  fat32-write-fat-entry : Integer, Integer, Integer, Integer -> Integer
  fat32-write-fat-entry (buf) (fat1-off) (cluster) (value) =
   gpt-buf-write-i32 buf (fat1-off + cluster * 4) value

  fat32-write-fat-chain : Integer, Integer, Integer, Integer -> Integer
  fat32-write-fat-chain (buf) (fat1-off) (start-cluster) (count) =
   fat32-write-fat-chain-loop buf fat1-off start-cluster count 0

  fat32-write-fat-chain-loop : Integer, Integer, Integer, Integer, Integer -> Integer
  fat32-write-fat-chain-loop (buf) (fat1-off) (start) (count) (i) =
   if i >= count then 0
   else let c = start + i
   in let val = if i == count - 1 then fat32-eoi else c + 1
   in let w = fat32-write-fat-entry buf fat1-off c val
   in fat32-write-fat-chain-loop buf fat1-off start count (i + 1)

  fat32-copy-fat2 : Integer, Fat32Layout -> Integer
  fat32-copy-fat2 (buf) (lay) =
   let fat1 = fat32-fat-offset lay
   in let fat2 = fat1 + lay.fat-sectors * gpt-sector-size
   in let hp = __heap-save
   in let fat-data = __buf-read-bytes buf fat1 (lay.fat-sectors * gpt-sector-size)
   in let w = __buf-write-bytes buf fat2 fat-data
   in let restored = __heap-restore hp
   in 0

Section: Directory Entries
  fat32-cluster-offset : Fat32Layout, Integer -> Integer
  fat32-cluster-offset (lay) (cluster) =
   lay.part-offset + (lay.data-start-sect + cluster - 2) * gpt-sector-size

  fat32-write-dir-entry : Integer, Integer, Text, Integer, Integer, Integer -> Integer
  fat32-write-dir-entry (buf) (off) (name83) (attr) (cluster) (size) =
   let w0 = fat32-write-oem-name buf off name83 0
   in let w1 = __buf-write-byte buf (off + 11) attr
   in let w2 = gpt-buf-write-i16 buf (off + 20) (bit-shru cluster 16)
   in let w3 = gpt-buf-write-i16 buf (off + 22) 20480
   in let w4 = gpt-buf-write-i16 buf (off + 24) 23717
   in let w5 = gpt-buf-write-i16 buf (off + 26) (bit-and cluster 65535)
   in let w6 = gpt-buf-write-i32 buf (off + 28) size
   in off + 32

Section: Filesystem Assembly
  fat32-write-dirs : Integer, Fat32Layout, Integer, Integer -> Integer
  fat32-write-dirs (buf) (lay) (efi-cluster) (efi-size) =
   let root = fat32-cluster-offset lay 2
   in let w0 = fat32-write-dir-entry buf root "EFI        " 16 3 0
   in let w1 = fat32-write-dir-entry buf (root + 32) "SEED       " 16 4 0
   in let w2 = fat32-write-dir-entry buf (root + 64) "CODEX OS   " 8 0 0
   in let efi-dir = fat32-cluster-offset lay 3
   in let w3 = fat32-write-dir-entry buf efi-dir ".          " 16 3 0
   in let w4 = fat32-write-dir-entry buf (efi-dir + 32) "..         " 16 0 0
   in let w5 = fat32-write-dir-entry buf (efi-dir + 64) "BOOT       " 16 5 0
   in let seed-dir = fat32-cluster-offset lay 4
   in let w6 = fat32-write-dir-entry buf seed-dir ".          " 16 4 0
   in let w7 = fat32-write-dir-entry buf (seed-dir + 32) "..         " 16 0 0
   in let w8 = fat32-write-dir-entry buf (seed-dir + 64) "CODEX   CDX" 32 6 efi-size
   in let boot-dir = fat32-cluster-offset lay 5
   in let w9 = fat32-write-dir-entry buf boot-dir ".          " 16 5 0
   in let w10 = fat32-write-dir-entry buf (boot-dir + 32) "..         " 16 3 0
   in let w11 = fat32-write-dir-entry buf (boot-dir + 64) "BOOTX64 EFI" 32 efi-cluster efi-size
   in 0

  fat32-write-all : Integer, Fat32Layout, List Integer, List Integer -> Integer
  fat32-write-all (buf) (lay) (efi-bytes) (cdx-bytes) =
   let fat1 = fat32-fat-offset lay
   in let w0 = fat32-write-fat-entry buf fat1 0 268435448
   in let w1 = fat32-write-fat-entry buf fat1 1 fat32-eoi
   in let w2 = fat32-write-fat-entry buf fat1 2 fat32-eoi
   in let w3 = fat32-write-fat-entry buf fat1 3 fat32-eoi
   in let w4 = fat32-write-fat-entry buf fat1 4 fat32-eoi
   in let w5 = fat32-write-fat-entry buf fat1 5 fat32-eoi
   in let cdx-clusters = (list-length cdx-bytes + gpt-sector-size - 1) / gpt-sector-size
   in let w6 = fat32-write-fat-chain buf fat1 6 cdx-clusters
   in let efi-start = 6 + cdx-clusters
   in let efi-clusters = (list-length efi-bytes + gpt-sector-size - 1) / gpt-sector-size
   in let w7 = fat32-write-fat-chain buf fat1 efi-start efi-clusters
   in let w8 = fat32-write-dirs buf lay efi-start (list-length efi-bytes)
   in let w9 = __buf-write-bytes buf (fat32-cluster-offset lay 6) cdx-bytes
   in let w10 = __buf-write-bytes buf (fat32-cluster-offset lay efi-start) efi-bytes
   in let w11 = fat32-write-bpb buf lay
   in let w12 = fat32-write-fsinfo buf lay
   in let w13 = fat32-write-backup-boot buf lay
   in let w14 = fat32-copy-fat2 buf lay
   in 0

