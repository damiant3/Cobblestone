Chapter: ImgPlug
  cites Net chapter NetIO
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Kernel chapter Ne2k

 Request body, which the host half in img/run.ps1 must agree with byte
 for byte:

   Byte 0: fs-type (0=FAT32, 1=FAT16)
   Bytes 1-4: total-sectors (LE)
   Bytes 5-8: PE size (LE)
   Bytes 9-12: CDX size (LE)
   Bytes 13-16: source size (LE, 0 if none)
   Then: PE bytes, CDX bytes, source bytes (if any)

Section: Network Config

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Streaming Send

 An image is sent from a BUFFER rather than a list, so this keeps a chunked
 loop where `elf` and `pe` could hand the whole payload to
 `net-io-send-raw-checked`: reading the image into one list would cost the
 `__buf-read-bytes` blowup over every sector at once. What the loop no longer
 does is ignore a refusal. `net-send` answers "send queue full" with the
 session unchanged and the old loop advanced past it regardless, so a full
 retransmit queue dropped that chunk and kept walking; the bytes either side
 of the drop still arrived, which is corruption rather than truncation.

  ImgSendResult = record {
   is-transport : TcpTransportState,
   is-sent : Integer,
   is-complete : Boolean
  }

  send-buf-loop : TcpTransportState, Integer, Integer, Integer, Integer -> [Network.Read, Network.Write] ImgSendResult
  send-buf-loop (ts) (buf) (off) (remaining) (sent) =
   if remaining <= 0 then ImgSendResult { is-transport = ts, is-sent = sent, is-complete = True }
   else let chunk = if remaining > 1400 then 1400 else remaining
   in let bs = __buf-read-bytes buf off chunk
   in act
    r <- net-io-send-raw-checked ts bs
    if r.ns-complete then send-buf-loop (r.ns-transport) buf (off + chunk) (remaining - chunk) (sent + (r.ns-sent))
       else ImgSendResult { is-transport = r.ns-transport, is-sent = sent + (r.ns-sent), is-complete = False }
   end

Section: Drain

  drain-wait : TcpTransportState, Integer -> [Network.Read] Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else act
    frame <- ne2k-recv-frame
    if list-length frame == 0 then drain-wait ts (tries + 1)
    else 0
   end

Section: Read Helpers

  img-read-i32 : List Integer, Integer -> Integer
  img-read-i32 (bs) (off) =
   list-at bs off + list-at bs (off + 1) * 256 + list-at bs (off + 2) * 65536 + list-at bs (off + 3) * 16777216

Section: Body

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9118 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let payload = recv.body
     in let fs-type = list-at payload 0
     in let total-sectors = img-read-i32 payload 1
     in let pe-size = img-read-i32 payload 5
     in let cdx-size = img-read-i32 payload 9
     in let src-size = img-read-i32 payload 13
     in let hdr-len = 17
     in let payload-buf = __heap-save
     in let pa = __heap-advance (list-length payload)
     in let pw = __buf-write-bytes payload-buf 0 payload
     in let img-bytes = total-sectors * gpt-sector-size
     in let img-buf = __heap-save
     in let img-advance = __heap-advance img-bytes
     in let w0 = gpt-write-all img-buf total-sectors
     in let hp1 = __heap-save
     in let efi-bytes = __buf-read-bytes payload-buf hdr-len pe-size
     in let cdx-bytes = __buf-read-bytes payload-buf (hdr-len + pe-size) cdx-size
     in if fs-type == 0 then
      let lay = fat32-compute-layout total-sectors
      in let w1 = fat32-write-all img-buf lay efi-bytes cdx-bytes
      in let restored = __heap-restore hp1
      in act
       sent <- send-buf-loop (recv.transport) img-buf 0 img-bytes 0
       ts6 <- net-io-close (sent.is-transport)
       drained <- drain-wait ts6 0
       if sent.is-complete then print-line-uni ("OK img=" & show (img-bytes + drained - drained) & " sent=" & show (sent.is-sent) & " fat32 sectors=" & show total-sectors)
       else print-line-uni ("TRUNCATED sent=" & show (sent.is-sent) & " of " & show (img-bytes + drained - drained) & " fat32 sectors=" & show total-sectors)
      end
     else
      let lay = fat16w-compute-layout total-sectors
      in let source = if src-size > 0 then bytes-to-text-range ((__buf-read-bytes payload-buf (hdr-len + pe-size + cdx-size) src-size)) 0 src-size else ""
      in let w1 = fat16w-write-all img-buf lay efi-bytes cdx-bytes source
      in let restored = __heap-restore hp1
      in act
       sent <- send-buf-loop (recv.transport) img-buf 0 img-bytes 0
       ts6 <- net-io-close (sent.is-transport)
       drained <- drain-wait ts6 0
       if sent.is-complete then print-line-uni ("OK img=" & show (img-bytes + drained - drained) & " sent=" & show (sent.is-sent) & " fat16 sectors=" & show total-sectors)
       else print-line-uni ("TRUNCATED sent=" & show (sent.is-sent) & " of " & show (img-bytes + drained - drained) & " fat16 sectors=" & show total-sectors)
      end
    else print-line-uni "FAIL"
   end

