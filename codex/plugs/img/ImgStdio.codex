Chapter: ImgStdio

Section: Body

 The payload is the one `codex/plugs/img/run.ps1` builds: a filesystem byte,
 then four each of total sectors, PE size, CDX size, source COUNT and directory
 COUNT, then the directory table of 15 bytes per directory (an 8.3 name in 11
 bytes then that directory's file count), then the source table of 15 bytes per
 source (an 8.3 name in 11 bytes then that source's size), then the PE, the CDX
 and every source laid end to end. The sources are grouped by directory in
 directory order, and any source past the sum of the file counts is placed in
 the root, therefore a directory count of zero is a flat image.

  img-sum-sizes : Integer, Integer, Integer, Integer -> Integer
  img-sum-sizes (buf) (tbl-off) (n) (i) =
   if i >= n then 0
   else fat16w-buf-read-i32 buf (tbl-off + i * 15 + 11) + img-sum-sizes buf tbl-off n (i + 1)

 The image is assembled in a buffer and handed over with `write-binary-buf`,
 which copies nothing. The network entry streams the same buffer down a
 socket; a disk image is megabytes, so neither path may go through a list.

  plug-emit-bytes : Integer, Integer -> [Console] Nothing
  plug-emit-bytes (payload-buf) (payload-len) =
   let fixed-len = 21
   in if payload-len < fixed-len then print-line-uni ("REFUSED short payload " & show payload-len)
   else let hdr = __buf-read-bytes payload-buf 0 fixed-len
   in let fs-type = list-at hdr 0
   in let total-sectors = img-read-i32 hdr 1
   in let pe-size = img-read-i32 hdr 5
   in let cdx-size = img-read-i32 hdr 9
   in let src-count = img-read-i32 hdr 13
   in let dir-count = img-read-i32 hdr 17
   in let dtbl-off = fixed-len
   in let tbl-off = dtbl-off + dir-count * 15
   in let hdr-len = tbl-off + src-count * 15
   in if payload-len < hdr-len then print-line-uni ("REFUSED payload " & show payload-len & " shorter than the directory and source tables its counts of " & show dir-count & " and " & show src-count & " need, " & show hdr-len)
   else let src-total = img-sum-sizes payload-buf tbl-off src-count 0
   in if hdr-len + pe-size + cdx-size + src-total > payload-len then print-line-uni ("REFUSED payload " & show payload-len & " shorter than its own header claims " & show (hdr-len + pe-size + cdx-size + src-total))
   else let img-bytes = total-sectors * gpt-sector-size
   in let img-buf = __heap-save
   in let img-advance = __heap-advance img-bytes
   in let w0 = gpt-write-all img-buf total-sectors
   in let hp1 = __heap-save
   in let efi-bytes = __buf-read-bytes payload-buf hdr-len pe-size
   in let cdx-bytes = __buf-read-bytes payload-buf (hdr-len + pe-size) cdx-size
   in if fs-type == 0 then
    let lay = fat32-compute-layout total-sectors
    in let w1 = fat32-write-all img-buf lay efi-bytes cdx-bytes
    in let restored = __heap-restore hp1
    in write-binary-buf img-buf 0 img-bytes
   else
    let lay = fat16w-compute-layout total-sectors
    in let w1 = fat16w-write-all img-buf lay efi-bytes cdx-bytes src-count payload-buf tbl-off (hdr-len + pe-size + cdx-size) dir-count dtbl-off
    in let restored = __heap-restore hp1
    in write-binary-buf img-buf 0 img-bytes
