Chapter: DivProbe
  cites Gpu chapter DeviceEffect

 Probe for the PTX plug's integer divide: q = a / b and r = int-rem a b per
 element, s64 in and out, graded against host arithmetic by div-vs-host.cu.

Section: Kernels

  gpu-div-probe : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  gpu-div-probe (a) (b) (q) (r) (n) = act
   bx <- block-idx-x
   bd <- block-dim-x
   tx <- thread-idx-x
   if bx * bd + tx < n then div-one a b q r (bx * bd + tx)
   else 0
  end

  div-one : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  div-one (a) (b) (q) (r) (i) = act
   x <- device-load a i
   y <- device-load b i
   w <- device-store q i (x / y)
   device-store r i (int-rem x y)
  end
