Chapter: Lua Emitter
  cites Codex chapter Text
  cites Codex chapter Characters
  cites Codex chapter Lists
  cites Foreword chapter Sort

 Generates Lua source code from the IR.

Section: Keywords and Sanitization

  lua-keywords : List Text =
   ["and", "break", "do", "else", "elseif",
    "end", "false", "for", "function", "goto",
    "if", "in", "local", "nil", "not",
    "or", "repeat", "return", "then", "true",
    "until", "while"]

  is-lua-keyword-loop : List Text, Text, Integer, Integer -> Boolean
  is-lua-keyword-loop (kws) (name) (i) (len) =
   if i == len then False
   else if list-at kws i == name then True
   else is-lua-keyword-loop kws name (i + 1) len

  is-lua-keyword : Text -> Boolean
  is-lua-keyword (name) = is-lua-keyword-loop lua-keywords name 0 (list-length lua-keywords)

  lua-sanitize : Text -> Text
  lua-sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-lua-keyword s then "_" & s
      else s

  lua-escape-text : Text -> Text
  lua-escape-text (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = list-length (d.params),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Definition Emission

  emit-lua-type-defs : List ATypeDef, Integer -> Text
  emit-lua-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-lua-type-def (list-at tds i) & emit-lua-type-defs tds (i + 1)

  emit-lua-type-def : ATypeDef -> Text
  emit-lua-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (s) ->
     emit-lua-record-type (name.value) fields
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-lua-sum-type ctors

  emit-lua-sum-type : List AVariantCtorDef -> Text
  emit-lua-sum-type (ctors) =
   emit-lua-sum-type-loop ctors 0 (list-length ctors)

  emit-lua-sum-type-loop : List AVariantCtorDef, Integer, Integer -> Text
  emit-lua-sum-type-loop (ctors) (i) (len) =
   if i == len then ""
   else let c = list-at ctors i
   in emit-lua-ctor c & emit-lua-sum-type-loop ctors (i + 1) len

  emit-lua-ctor : AVariantCtorDef -> Text
  emit-lua-ctor (c) =
   let name = lua-sanitize (c.name.value)
   in "function " & name & "(" & emit-lua-ctor-params (c.fields) 0 & ")\n  return {tag = \"" & c.name.value & "\"" & emit-lua-ctor-field-assigns (c.fields) 0 & "}\nend\n\n"

  emit-lua-ctor-params : List ATypeExpr, Integer -> Text
  emit-lua-ctor-params (fields) (i) =
   if i == list-length fields then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "f" & integer-to-text i & emit-lua-ctor-params fields (i + 1)

  emit-lua-ctor-field-assigns : List ATypeExpr, Integer -> Text
  emit-lua-ctor-field-assigns (fields) (i) =
   if i == list-length fields then ""
   else ", field" & integer-to-text i & " = f" & integer-to-text i & emit-lua-ctor-field-assigns fields (i + 1)

  emit-lua-record-type : Text, List ARecordFieldDef -> Text
  emit-lua-record-type (name) (fields) =
   let sname = lua-sanitize name
   in "function " & sname & "(" & emit-lua-record-params fields 0 & ")\n  return {" & emit-lua-record-init fields 0 & "}\nend\n\n"

  emit-lua-record-params : List ARecordFieldDef, Integer -> Text
  emit-lua-record-params (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & lua-sanitize (f.name.value) & emit-lua-record-params fields (i + 1)

  emit-lua-record-init : List ARecordFieldDef, Integer -> Text
  emit-lua-record-init (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & lua-sanitize (f.name.value) & " = " & lua-sanitize (f.name.value) & emit-lua-record-init fields (i + 1)

Section: Expression Emission

  lua-max-depth : Integer = 256

  emit-lua-expr : IRExpr, List ArityEntry -> Text
  emit-lua-expr (e) (arities) = emit-lua-expr-at e arities 0

  emit-lua-expr-at : IRExpr, List ArityEntry, Integer -> Text
  emit-lua-expr-at (e) (arities) (depth) =
   if depth >= lua-max-depth then "nil"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> integer-to-text n & ".0"
    is IrTextLit (s) (sp) -> "\"" & lua-escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> emit-lua-name n ty arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-lua-binary op l r arities
    is IrNegate (operand) (sp) -> "(-" & emit-lua-expr-at operand arities (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-lua-expr-at c arities (depth + 1) & " and " & emit-lua-expr-at t arities (depth + 1) & " or " & emit-lua-expr-at el arities (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(function() local " & lua-sanitize name & " = " & emit-lua-expr-at val arities (depth + 1) & "; return " & emit-lua-expr-at body arities (depth + 1) & " end)()"
    is IrApply (f) (a) (ty) (sp) -> emit-lua-apply e arities
    is IrLambda (params) (body) (ty) (sp) -> "function(" & emit-lua-lambda-params params 0 & ") return " & emit-lua-expr body arities & " end"
    is IrList (elems) (ty) (sp) -> "{" & emit-lua-list-elems elems 0 arities & "}"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-lua-match scrut branches arities
    is IrAct (stmts) (ty) (sp) -> emit-lua-act stmts arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-lua-expr-at body arities (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-lua-expr-at body arities (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-lua-record name fields arities
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-lua-expr-at rec arities (depth + 1) & "." & lua-sanitize field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(function() local _r = " & emit-lua-expr-at rec arities (depth + 1) & "; _r." & lua-sanitize field & " = " & emit-lua-expr-at val arities (depth + 1) & "; return _r end)()"
    is IrFork (body) (ty) (sp) -> emit-lua-expr-at body arities (depth + 1)
    is IrAwait (task) (ty) (sp) -> emit-lua-expr-at task arities (depth + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> "(function() local ok, r = pcall(function() return " & emit-lua-act body arities & " end); if ok then return r else return " & emit-lua-act fb arities & " end end)()"
    is IrError (msg) (ty) (sp) -> "error(\"" & lua-escape-text msg & "\")"

  emit-lua-name : Text, CodexType, List ArityEntry -> Text
  emit-lua-name (n) (ty) (arities) =
   if n == "read-line" then "io.read()"
   else if n == "show" then "tostring"
   else if n == "True" then "true"
   else if n == "False" then "false"
   else if n == "Nothing" then "nil"
   else lua-sanitize n

  emit-lua-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  emit-lua-binary (op) (l) (r) (arities) =
   when op
    is IrAppendText -> "(" & emit-lua-expr l arities & " .. " & emit-lua-expr r arities & ")"
    is IrAppendList -> "(function() local _a = " & emit-lua-expr l arities & "; local _b = " & emit-lua-expr r arities & "; for _,v in ipairs(_b) do _a[#_a+1]=v end; return _a end)()"
    is IrConsList -> "(function() local _t = " & emit-lua-expr r arities & "; table.insert(_t, 1, " & emit-lua-expr l arities & "); return _t end)()"
    is IrDivInt -> "math.floor(" & emit-lua-expr l arities & " / " & emit-lua-expr r arities & ")"
    is IrPowInt -> "(" & emit-lua-expr l arities & " ^ " & emit-lua-expr r arities & ")"
    is IrAnd -> "(" & emit-lua-expr l arities & " and " & emit-lua-expr r arities & ")"
    is IrOr -> "(" & emit-lua-expr l arities & " or " & emit-lua-expr r arities & ")"
    is otherwise -> "(" & emit-lua-expr l arities & " " & lua-bin-op-symbol op & " " & emit-lua-expr r arities & ")"

  lua-bin-op-symbol : IRBinaryOp -> Text
  lua-bin-op-symbol (op) =
   when op
    is IrAddInt -> "+"
    is IrSubInt -> "-"
    is IrMulInt -> "*"
    is IrDivInt -> "/"
    is IrPowInt -> "^"
    is IrAddNum -> "+"
    is IrSubNum -> "-"
    is IrMulNum -> "*"
    is IrDivNum -> "/"
    is IrEq -> "=="
    is IrNotEq -> "~="
    is IrLt -> "<"
    is IrGt -> ">"
    is IrLtEq -> "<="
    is IrGtEq -> ">="
    is IrAnd -> "and"
    is IrOr -> "or"
    is IrAppendText -> ".."
    is IrAppendList -> "+"
    is IrConsList -> "+"

  emit-lua-lambda-params : List IRParam, Integer -> Text
  emit-lua-lambda-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then lua-sanitize ((list-at params i).name)
   else lua-sanitize ((list-at params i).name) & ", " & emit-lua-lambda-params params (i + 1)

  emit-lua-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  emit-lua-list-elems (elems) (i) (arities) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-lua-expr (list-at elems i) arities
   else emit-lua-expr (list-at elems i) arities & ", " & emit-lua-list-elems elems (i + 1) arities

  emit-lua-record : Text, List IRFieldVal, List ArityEntry -> Text
  emit-lua-record (name) (fields) (arities) =
   "{" & emit-lua-record-vals fields 0 arities & "}"

  emit-lua-record-vals : List IRFieldVal, Integer, List ArityEntry -> Text
  emit-lua-record-vals (fields) (i) (arities) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & lua-sanitize (f.name) & " = " & emit-lua-expr (f.value) arities & emit-lua-record-vals fields (i + 1) arities

  emit-lua-match : IRExpr, List IRBranch, List ArityEntry -> Text
  emit-lua-match (scrut) (branches) (arities) =
   "(function(_s) " & emit-lua-match-arms branches 0 arities & " end)(" & emit-lua-expr scrut arities & ")"

  emit-lua-match-arms : List IRBranch, Integer, List ArityEntry -> Text
  emit-lua-match-arms (branches) (i) (arities) =
   if i == list-length branches then "return nil"
   else let b = list-at branches i
   in emit-lua-match-arm (b.pattern) (b.body) arities i & " " & emit-lua-match-arms branches (i + 1) arities

  emit-lua-match-arm : IRPat, IRExpr, List ArityEntry, Integer -> Text
  emit-lua-match-arm (pat) (body) (arities) (i) =
   when pat
    is IrLitPat (text) (ty) (sp) -> "if _s == " & text & " then return " & emit-lua-expr body arities & " end"
    is IrCtorPat (name) (subs) (ty) (sp) -> "if _s.tag == \"" & name & "\" then return " & emit-lua-expr body arities & " end"
    is IrVarPat (name) (ty) (sp) -> "do local " & lua-sanitize name & " = _s; return " & emit-lua-expr body arities & " end"
    is IrWildPat (sp) -> "do return " & emit-lua-expr body arities & " end"

  emit-lua-act : List IRActStmt, List ArityEntry -> Text
  emit-lua-act (stmts) (arities) =
   "(function() " & emit-lua-act-stmts stmts 0 arities & " end)()"

  emit-lua-act-stmts : List IRActStmt, Integer, List ArityEntry -> Text
  emit-lua-act-stmts (stmts) (i) (arities) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> "local " & lua-sanitize name & " = " & emit-lua-expr val arities & "; "
    is IrDoExec (e) (sp) -> if is-last then "return " & emit-lua-expr e arities & "; " else emit-lua-expr e arities & "; ") & emit-lua-act-stmts stmts (i + 1) arities

Section: Apply Emission

  emit-lua-apply : IRExpr, List ArityEntry -> Text
  emit-lua-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     if n == "print-line-uni" then "print(" & emit-lua-expr (list-at args 0) arities & ")"
     else if n == "list-at" then emit-lua-expr (list-at args 0) arities & "[" & emit-lua-expr (list-at args 1) arities & " + 1]"
     else lua-sanitize n & "(" & emit-lua-apply-args args arities 0 & ")"
    is otherwise -> emit-lua-expr-curried e arities

  emit-lua-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-lua-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-lua-expr (list-at args i) arities
   else emit-lua-expr (list-at args i) arities & ", " & emit-lua-apply-args args arities (i + 1)

  emit-lua-expr-curried : IRExpr, List ArityEntry -> Text
  emit-lua-expr-curried (e) (arities) =
   when e
    is IrApply (f) (a) (ty) (sp) -> emit-lua-expr f arities & "(" & emit-lua-expr a arities & ")"
    is otherwise -> emit-lua-expr e arities

Section: Definition Emission

  emit-lua-def : IRDef, List ArityEntry -> Text
  emit-lua-def (d) (arities) =
   let name = lua-sanitize (d.name)
   in let params-text = emit-lua-def-params (d.params) 0
   in "function " & name & "(" & params-text & ")\n  return " & emit-lua-expr (d.body) arities & "\nend\n\n"

  emit-lua-def-params : List IRParam, Integer -> Text
  emit-lua-def-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then lua-sanitize ((list-at params i).name)
   else lua-sanitize ((list-at params i).name) & ", " & emit-lua-def-params params (i + 1)

  emit-lua-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-lua-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-lua-def (list-at defs i) arities & emit-lua-defs defs (i + 1) arities

Section: Chapter Emission

  emit-lua-chapter : IRChapter, List ATypeDef -> Text
  emit-lua-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let types-text = emit-lua-type-defs type-defs 0
   in let defs-text = emit-lua-defs (m.defs) 0 arities
   in types-text & defs-text & lua-sanitize opening-entry-point & "()\n"

