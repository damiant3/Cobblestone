Chapter: Swift Emitter
  cites Foreword chapter Sort

Section: Keywords and Sanitization

  sw-keywords : List Text =
   ["as", "associatedtype", "break", "case", "catch",
    "class", "continue", "default", "defer", "deinit",
    "do", "else", "enum", "extension", "fallthrough",
    "false", "fileprivate", "for", "func", "guard",
    "if", "import", "in", "init", "inout",
    "internal", "is", "let", "nil", "operator",
    "open", "private", "protocol", "public", "repeat",
    "rethrows", "return", "self", "static", "struct",
    "subscript", "super", "switch", "throw", "throws",
    "true", "try", "typealias", "var", "where", "while"]

  is-sw-keyword-loop : List Text, Text, Integer, Integer -> Boolean
  is-sw-keyword-loop (kws) (name) (i) (len) =
   if i == len then False
   else if list-at kws i == name then True
   else is-sw-keyword-loop kws name (i + 1) len

  is-sw-keyword : Text -> Boolean
  is-sw-keyword (name) = is-sw-keyword-loop sw-keywords name 0 (list-length sw-keywords)

  sw-sanitize : Text -> Text
  sw-sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-sw-keyword s then "`" & s & "`"
      else s

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  sw-slash-pos : Text, Integer, Integer -> Integer
  sw-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else sw-slash-pos f (i + 1) len

  sw-field : Text -> Text
  sw-field (f) =
   let slash = sw-slash-pos f 0 (text-length f)
   in if slash >= 0 then sw-sanitize (substring f 0 slash)
      else sw-sanitize f

  sw-escape-text : Text -> Text
  sw-escape-text (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Definition Emission

  emit-sw-type-defs : List ATypeDef, Integer -> Text
  emit-sw-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-sw-type-def (list-at tds i) & emit-sw-type-defs tds (i + 1)

  emit-sw-type-def : ATypeDef -> Text
  emit-sw-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     emit-sw-record-type (name.value) fields
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else emit-sw-sum-type (name.value) ctors
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-sw-sum-type : Text, List AVariantCtorDef -> Text
  emit-sw-sum-type (name) (ctors) =
   "enum " & sw-sanitize name & " {\n" & emit-sw-ctors ctors 0 (list-length ctors) & "}\n\n"

  emit-sw-ctors : List AVariantCtorDef, Integer, Integer -> Text
  emit-sw-ctors (ctors) (i) (len) =
   if i == len then ""
   else let c = list-at ctors i
   in "  case " & sw-sanitize (c.name.value) & emit-sw-ctor-fields (c.fields) 0 & "\n" & emit-sw-ctors ctors (i + 1) len

  emit-sw-ctor-fields : List ATypeExpr, Integer -> Text
  emit-sw-ctor-fields (fields) (i) =
   if i == list-length fields then ""
   else if i == 0 then "(" & "Any?" & emit-sw-ctor-fields-rest fields 1 & ")"
   else ""

  emit-sw-ctor-fields-rest : List ATypeExpr, Integer -> Text
  emit-sw-ctor-fields-rest (fields) (i) =
   if i == list-length fields then ""
   else ", Any?" & emit-sw-ctor-fields-rest fields (i + 1)

  emit-sw-record-type : Text, List ARecordFieldDef -> Text
  emit-sw-record-type (name) (fields) =
   let sname = sw-sanitize name
   in "struct " & sname & " {\n" & emit-sw-record-fields fields 0 & "}\n\n"

  emit-sw-record-fields : List ARecordFieldDef, Integer -> Text
  emit-sw-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "  var " & sw-sanitize (f.name.value) & ": Any?\n" & emit-sw-record-fields fields (i + 1)

Section: Expression Emission

  sw-max-depth : Integer = 256

  emit-sw-expr : IRExpr, List ArityEntry -> Text
  emit-sw-expr (e) (arities) = emit-sw-expr-at e arities 0

  emit-sw-expr-at : IRExpr, List ArityEntry, Integer -> Text
  emit-sw-expr-at (e) (arities) (depth) =
   if depth >= sw-max-depth then "nil"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> integer-to-text n & ".0"
    is IrTextLit (s) (sp) -> "\"" & sw-escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> emit-sw-name n ty arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-sw-binary op l r arities
    is IrNegate (operand) (nty) (sp) -> "(-" & emit-sw-expr-at operand arities (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-sw-expr-at c arities (depth + 1) & " ? " & emit-sw-expr-at t arities (depth + 1) & " : " & emit-sw-expr-at el arities (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "{ let " & sw-sanitize name & " = " & emit-sw-expr-at val arities (depth + 1) & "; return " & emit-sw-expr-at body arities (depth + 1) & " }()"
    is IrApply (f) (a) (ty) (sp) -> emit-sw-apply e arities
    is IrLambda (params) (body) (ty) (sp) -> "{ (" & emit-sw-lambda-params params 0 & ") in " & emit-sw-expr body arities & " }"
    is IrList (elems) (ty) (sp) -> "[" & emit-sw-list-elems elems 0 arities & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-sw-match scrut branches arities
    is IrAct (stmts) (ty) (sp) -> emit-sw-act stmts arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-sw-expr-at body arities (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-sw-expr-at body arities (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-sw-record name fields arities
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-sw-expr-at rec arities (depth + 1) & "." & sw-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "{ var _r = " & emit-sw-expr-at rec arities (depth + 1) & "; _r." & sw-field field & " = " & emit-sw-expr-at val arities (depth + 1) & "; return _r }()"
    is IrFork (body) (ty) (sp) -> emit-sw-expr-at body arities (depth + 1)
    is IrAwait (task) (ty) (sp) -> emit-sw-expr-at task arities (depth + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> "(try? { " & emit-sw-act body arities & " } ?? { " & emit-sw-act fb arities & " }())"
    is IrError (msg) (ty) (sp) -> "fatalError(\"" & sw-escape-text msg & "\")"

  emit-sw-name : Text, CodexType, List ArityEntry -> Text
  emit-sw-name (n) (ty) (arities) =
   if n == "read-line" then "readLine()!"
   else if n == "show" then "String(describing:)"
   else if n == "True" then "true"
   else if n == "False" then "false"
   else if n == "Nothing" then "nil"
   else sw-sanitize n

  emit-sw-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  emit-sw-binary (op) (l) (r) (arities) =
   when op
    is IrAppendText -> "(" & emit-sw-expr l arities & " + " & emit-sw-expr r arities & ")"
    is IrAppendList -> "(" & emit-sw-expr l arities & " + " & emit-sw-expr r arities & ")"
    is IrConsList -> "([" & emit-sw-expr l arities & "] + " & emit-sw-expr r arities & ")"
    is IrDivInt -> "(" & emit-sw-expr l arities & " / " & emit-sw-expr r arities & ")"
    is IrRemInt -> "(" & emit-sw-expr l arities & " % " & emit-sw-expr r arities & ")"
    is IrAnd -> "(" & emit-sw-expr l arities & " && " & emit-sw-expr r arities & ")"
    is IrOr -> "(" & emit-sw-expr l arities & " || " & emit-sw-expr r arities & ")"
    is IrAddVec -> "zip(" & emit-sw-expr l arities & ", " & emit-sw-expr r arities & ").map(+)"
    is IrSubVec -> "zip(" & emit-sw-expr l arities & ", " & emit-sw-expr r arities & ").map(-)"
    is IrMulVec -> "zip(" & emit-sw-expr l arities & ", " & emit-sw-expr r arities & ").map(*)"
    is IrDivVec -> "zip(" & emit-sw-expr l arities & ", " & emit-sw-expr r arities & ").map(/)"
    is otherwise -> "(" & emit-sw-expr l arities & " " & sw-bin-op-symbol op & " " & emit-sw-expr r arities & ")"

  sw-bin-op-symbol : IRBinaryOp -> Text
  sw-bin-op-symbol (op) =
   when op
    is IrAddInt | IrAddVec -> "+"
    is IrSubInt | IrSubVec -> "-"
    is IrMulInt | IrMulVec -> "*"
    is IrDivInt | IrDivVec -> "/"
    is IrRemInt -> "%"
    is IrPowInt -> "**"
    is IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrEq -> "=="
    is IrNotEq -> "!="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq -> "=="
    is IrApproxEqExact -> "=="
    is IrAnd -> "&&"
    is IrOr -> "||"
    is IrAppendText -> "+"
    is IrAppendList -> "+"
    is IrConsList -> "+"

  emit-sw-lambda-params : List IRParam, Integer -> Text
  emit-sw-lambda-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then sw-sanitize ((list-at params i).name) & ": Any?"
   else sw-sanitize ((list-at params i).name) & ": Any?, " & emit-sw-lambda-params params (i + 1)

  emit-sw-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  emit-sw-list-elems (elems) (i) (arities) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-sw-expr (list-at elems i) arities
   else emit-sw-expr (list-at elems i) arities & ", " & emit-sw-list-elems elems (i + 1) arities

  emit-sw-record : Text, List IRFieldVal, List ArityEntry -> Text
  emit-sw-record (name) (fields) (arities) =
   sw-sanitize name & "(" & emit-sw-record-vals fields 0 arities & ")"

  emit-sw-record-vals : List IRFieldVal, Integer, List ArityEntry -> Text
  emit-sw-record-vals (fields) (i) (arities) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & sw-sanitize (f.name) & ": " & emit-sw-expr (f.value) arities & emit-sw-record-vals fields (i + 1) arities

  emit-sw-match : IRExpr, List IRBranch, List ArityEntry -> Text
  emit-sw-match (scrut) (branches) (arities) =
   "{ let _s = " & emit-sw-expr scrut arities & "; switch _s { " & emit-sw-match-arms branches 0 arities & "} }()"

  emit-sw-match-arms : List IRBranch, Integer, List ArityEntry -> Text
  emit-sw-match-arms (branches) (i) (arities) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in emit-sw-match-arm (b.pattern) (b.guard) (b.body) arities & emit-sw-match-arms branches (i + 1) arities

 Swift carries the guard itself: `case p where g:` falls through to the next
 case when the guard is false. The BINDING is the other half and was absent:
 an enum case with associated values has to bind them to read them, so
 `case .Num(let n)` is what makes `n` mean anything in the body or the guard.

  sw-guard-trivial : IRExpr -> Boolean
  sw-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  sw-where-clause : IRExpr, List ArityEntry -> Text
  sw-where-clause (guard) (arities) =
   if sw-guard-trivial guard then "" else " where " & emit-sw-expr guard arities

  emit-sw-ctor-binders : List IRPat, Integer -> Text
  emit-sw-ctor-binders (subs) (i) =
   if i == list-length subs then ""
   else let sep = if i > 0 then ", " else ""
   in let sub = list-at subs i
   in sep & (when sub
    is IrVarPat (name) (ty) (sp) -> "let " & sw-sanitize name
    is otherwise -> "_") & emit-sw-ctor-binders subs (i + 1)

  emit-sw-match-arm : IRPat, IRExpr, IRExpr, List ArityEntry -> Text
  emit-sw-match-arm (pat) (guard) (body) (arities) =
   when pat
    is IrLitPat (text) (ty) (sp) -> "case " & text & sw-where-clause guard arities & ": return " & emit-sw-expr body arities & "; "
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then "default: let (" & emit-sw-tup-pat-names subs 0 & ") = _s as! (" & emit-sw-tup-pat-types subs 0 & "); return " & emit-sw-expr body arities & "; "
     else if list-length subs == 0 then "case ." & sw-sanitize name & sw-where-clause guard arities & ": return " & emit-sw-expr body arities & "; "
     else "case ." & sw-sanitize name & "(" & emit-sw-ctor-binders subs 0 & ")" & sw-where-clause guard arities & ": return " & emit-sw-expr body arities & "; "
    is IrVarPat (name) (ty) (sp) -> "case let " & sw-sanitize name & sw-where-clause guard arities & ": return " & emit-sw-expr body arities & "; "
    is IrWildPat (sp) -> if sw-guard-trivial guard then "default: return " & emit-sw-expr body arities & "; " else "case _ where " & emit-sw-expr guard arities & ": return " & emit-sw-expr body arities & "; "
    is IrVecPat (pats) (ty) (sp) -> if sw-guard-trivial guard then "default: return " & emit-sw-expr body arities & "; " else "case _ where " & emit-sw-expr guard arities & ": return " & emit-sw-expr body arities & "; "

  emit-sw-act : List IRActStmt, List ArityEntry -> Text
  emit-sw-act (stmts) (arities) =
   "{ " & emit-sw-act-stmts stmts 0 arities & " }()"

  emit-sw-act-stmts : List IRActStmt, Integer, List ArityEntry -> Text
  emit-sw-act-stmts (stmts) (i) (arities) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> "let " & sw-sanitize name & " = " & emit-sw-expr val arities & "; "
    is IrDoExec (e) (sp) -> emit-sw-expr e arities & "; ") & emit-sw-act-stmts stmts (i + 1) arities

Section: Builtin Emitters

  SwBuiltinEmitter = record {
   name : Text,
   emit : List IRExpr, List ArityEntry -> Text
  }

  bsearch-sw-emitter-pos : List SwBuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-sw-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-sw-emitter-pos entries name lo mid
      else bsearch-sw-emitter-pos entries name (mid + 1) hi

  sort-sw-emitters : List SwBuiltinEmitter -> List SwBuiltinEmitter
  sort-sw-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  sw-builtin-emitters : List SwBuiltinEmitter = sort-sw-emitters [
   SwBuiltinEmitter { name = "__narrow", emit = \args arities -> emit-sw-expr (list-at args 0) arities },
   SwBuiltinEmitter { name = "abs", emit = \args arities -> "abs(" & emit-sw-expr (list-at args 0) arities & ")" },
   SwBuiltinEmitter { name = "char-at", emit = \args arities -> "Array(" & emit-sw-expr (list-at args 0) arities & ")[" & emit-sw-expr (list-at args 1) arities & "]" },
   SwBuiltinEmitter { name = "char-code-at", emit = \args arities -> "Int(Array(" & emit-sw-expr (list-at args 0) arities & ")[" & emit-sw-expr (list-at args 1) arities & "].asciiValue!)" },
   SwBuiltinEmitter { name = "file-exists", emit = \args arities -> "FileManager.default.fileExists(atPath: " & emit-sw-expr (list-at args 0) arities & " as! String)" },
   SwBuiltinEmitter { name = "int-mod", emit = \args arities -> "({ (_a: Int, _b: Int) -> Int in let _m = abs(_b); let _r = _a % _m; return _r < 0 ? _r + _m : _r })(" & emit-sw-expr (list-at args 0) arities & " as! Int, " & emit-sw-expr (list-at args 1) arities & " as! Int)" },
   SwBuiltinEmitter { name = "integer-to-text", emit = \args arities -> "String(" & emit-sw-expr (list-at args 0) arities & " as! Int)" },
   SwBuiltinEmitter { name = "list-at", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! [Any?])[" & emit-sw-expr (list-at args 1) arities & " as! Int]" },
   SwBuiltinEmitter { name = "list-length", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! [Any?]).count" },
   SwBuiltinEmitter { name = "list-snoc", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! [Any?]) + [" & emit-sw-expr (list-at args 1) arities & "]" },
   SwBuiltinEmitter { name = "list-push", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! [Any?]) + [" & emit-sw-expr (list-at args 1) arities & "]" },
   SwBuiltinEmitter { name = "max", emit = \args arities -> "max(" & emit-sw-expr (list-at args 0) arities & " as! Int, " & emit-sw-expr (list-at args 1) arities & " as! Int)" },
   SwBuiltinEmitter { name = "min", emit = \args arities -> "min(" & emit-sw-expr (list-at args 0) arities & " as! Int, " & emit-sw-expr (list-at args 1) arities & " as! Int)" },
   SwBuiltinEmitter { name = "negate", emit = \args arities -> "(-(" & emit-sw-expr (list-at args 0) arities & " as! Int))" },
   SwBuiltinEmitter { name = "print-error-uni", emit = \args arities -> "FileHandle.standardError.write(String(describing: " & emit-sw-expr (list-at args 0) arities & ").data(using: .utf8)!)" },
   SwBuiltinEmitter { name = "print-line-uni", emit = \args arities -> "print(" & emit-sw-expr (list-at args 0) arities & ")" },
   SwBuiltinEmitter { name = "read-text", emit = \args arities -> "try! String(contentsOfFile: " & emit-sw-expr (list-at args 0) arities & " as! String, encoding: .utf8)" },
   SwBuiltinEmitter { name = "read-line", emit = \args arities -> "readLine()!" },
   SwBuiltinEmitter { name = "show", emit = \args arities -> "String(describing: " & emit-sw-expr (list-at args 0) arities & ")" },
   SwBuiltinEmitter { name = "substring", emit = \args arities -> "String(Array(" & emit-sw-expr (list-at args 0) arities & " as! String)[(" & emit-sw-expr (list-at args 1) arities & " as! Int)..<(" & emit-sw-expr (list-at args 1) arities & " as! Int) + (" & emit-sw-expr (list-at args 2) arities & " as! Int)])" },
   SwBuiltinEmitter { name = "text-compare", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! String).compare(" & emit-sw-expr (list-at args 1) arities & " as! String).rawValue" },
   SwBuiltinEmitter { name = "text-contains", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! String).contains(" & emit-sw-expr (list-at args 1) arities & " as! String)" },
   SwBuiltinEmitter { name = "text-length", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! String).count" },
   SwBuiltinEmitter { name = "text-replace", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! String).replacingOccurrences(of: " & emit-sw-expr (list-at args 1) arities & " as! String, with: " & emit-sw-expr (list-at args 2) arities & " as! String)" },
   SwBuiltinEmitter { name = "text-split", emit = \args arities -> "_cxTextSplit(" & emit-sw-expr (list-at args 0) arities & " as! String, " & emit-sw-expr (list-at args 1) arities & " as! String)" },
   SwBuiltinEmitter { name = "text-starts-with", emit = \args arities -> "(" & emit-sw-expr (list-at args 0) arities & " as! String).hasPrefix(" & emit-sw-expr (list-at args 1) arities & " as! String)" },
   SwBuiltinEmitter { name = "text-to-integer", emit = \args arities -> "_cxTextToInteger(" & emit-sw-expr (list-at args 0) arities & " as! String)" },
   SwBuiltinEmitter { name = "write-file", emit = \args arities -> "try! (" & emit-sw-expr (list-at args 1) arities & " as! String).write(toFile: " & emit-sw-expr (list-at args 0) arities & " as! String, atomically: true, encoding: .utf8)" }
  ]

  sw-try-builtin : Text, List IRExpr, List ArityEntry -> Text
  sw-try-builtin (n) (args) (arities) =
   let len = list-length sw-builtin-emitters
   in let pos = bsearch-sw-emitter-pos sw-builtin-emitters n 0 len
   in if pos >= len then ""
      else let entry = list-at sw-builtin-emitters pos
      in if entry.name == n then entry.emit args arities
         else ""

Section: Apply Emission

  emit-sw-apply : IRExpr, List ArityEntry -> Text
  emit-sw-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     let bi = sw-try-builtin n args arities
     in if text-length bi > 0 then bi
     else if is-mktup-name n then "(" & emit-sw-apply-args args arities 0 & ")"
     else sw-sanitize n & "(" & emit-sw-apply-args args arities 0 & ")"
    is otherwise -> emit-sw-expr-curried e arities

  emit-sw-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-sw-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-sw-expr (list-at args i) arities
   else emit-sw-expr (list-at args i) arities & ", " & emit-sw-apply-args args arities (i + 1)

  emit-sw-expr-curried : IRExpr, List ArityEntry -> Text
  emit-sw-expr-curried (e) (arities) =
   when e
    is IrApply (f) (a) (ty) (sp) -> emit-sw-expr f arities & "(" & emit-sw-expr a arities & ")"
    is otherwise -> emit-sw-expr e arities

Section: Definition Emission

  emit-sw-def : IRDef, List ArityEntry -> Text
  emit-sw-def (d) (arities) =
   let name = sw-sanitize (d.name)
   in let params-text = emit-sw-def-params (d.params) 0
   in "func " & name & "(" & params-text & ") -> Any? {\n  return " & emit-sw-expr (d.body) arities & "\n}\n\n"

  emit-sw-def-params : List IRParam, Integer -> Text
  emit-sw-def-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then "_ " & sw-sanitize ((list-at params i).name) & ": Any?"
   else "_ " & sw-sanitize ((list-at params i).name) & ": Any?, " & emit-sw-def-params params (i + 1)

  emit-sw-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-sw-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-sw-def (list-at defs i) arities & emit-sw-defs defs (i + 1) arities

Section: Chapter Emission

  emit-swift-chapter : IRChapter, List ATypeDef -> Text
  emit-swift-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let header = "import Foundation\n\n" & sw-text-builtins
   in let types-text = emit-sw-type-defs type-defs 0
   in let defs-text = emit-sw-defs (m.defs) 0 arities
   in header & types-text & defs-text & "let _codexDone = DispatchSemaphore(value: 0)\nlet _codexMain = Thread { " & sw-sanitize opening-entry-point & "(); _codexDone.signal() }\n_codexMain.stackSize = 512 * 1024 * 1024\n_codexMain.start()\n_codexDone.wait()\n"

 `Int(s)!` FORCE-UNWRAPS, so a non-numeric tail is a crash rather than the
 prefix or 0 Codex answers, and `components(separatedBy:)` with an empty
 separator does not answer the whole string. `replacingOccurrences(of:)`
 already answers the string unchanged for an empty needle and is left alone.

  sw-text-builtins : Text
  sw-text-builtins =
   "func _cxTextSplit(_ s: String, _ sep: String) -> [String] {\n  if sep.isEmpty { return [s] }\n  return s.components(separatedBy: sep)\n}\n\n"
   & "func _cxTextToInteger(_ s: String) -> Int {\n  let u = Array(s.unicodeScalars)\n  var i = 0\n  var neg = false\n  if i < u.count && u[i] == \"-\" { neg = true; i = 1 }\n  var v = 0\n  while i < u.count && u[i].value >= 48 && u[i].value <= 57 {\n    v = v * 10 + Int(u[i].value - 48)\n    i += 1\n  }\n  return neg ? -v : v\n}\n\n"

  emit-sw-tup-pat-names : List IRPat, Integer -> Text
  emit-sw-tup-pat-names (subs) (i) =
   if i == list-length subs then ""
   else let sep = if i > 0 then ", " else ""
   in let nm = when (list-at subs i)
    is IrVarPat (name) (ty) (sp) -> sw-sanitize name
    is IrWildPat (sp) -> "_"
    is IrVecPat (pats) (ty) (sp) -> "_"
    is otherwise -> "_"
   in sep & nm & emit-sw-tup-pat-names subs (i + 1)

  emit-sw-tup-pat-types : List IRPat, Integer -> Text
  emit-sw-tup-pat-types (subs) (i) =
   if i == list-length subs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "Any?" & emit-sw-tup-pat-types subs (i + 1)

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

