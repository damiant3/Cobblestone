Chapter: CIL Stdio

  plug-emit-ir-bytes : Text -> [Console] Nothing
  plug-emit-ir-bytes (text) =
   if text-starts-with text "CIL-UNITY\n" then cil-unity-input (text-drop text (text-length "CIL-UNITY\n"))
   else if ir-text-is-chapter text == False then print-line-uni "REFUSED CIL requires an IR chapter"
   else let parsed = parse-ir-chapter text
   in let program = cil-program parsed
   in let emitted = cil-emit-defs program 0
   in let constructors = cil-emit-record-ctors program 0
   in let closures = cil-emit-closures program 0
   in if program.error /= "" then print-line-uni ("REFUSED CIL " & program.error)
   else if list-length (program.defs) == 0 then print-line-uni "REFUSED CIL chapter has no definitions"
   else write-binary (cil-build-pe (program.md) (program.methods))
