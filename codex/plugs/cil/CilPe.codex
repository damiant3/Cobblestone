Chapter: CIL PE
  cites Foreword chapter Sha256

 ECMA-335 II.25: an IL-only PE32 DLL, one section, no native entry point.
 The CLI header precedes method bodies; metadata follows at four-byte alignment.

  cil-method-base : Integer = 8264

  cil-pe-header : Integer, Integer -> List Integer
  cil-pe-header (section-size) (raw-size) =
   let dos = [77, 90] & pad-zeros 58 & write-i32 128 & pad-zeros 64
   in let coff = [80, 69, 0, 0] & write-i16 332 & write-i16 1 & pad-zeros 12 & write-i16 224 & write-i16 8226
   in let opt = write-i16 267 & [0, 0] & write-i32 raw-size & pad-zeros 8 & write-i32 0 & write-i32 8192 & write-i32 0
    & write-i32 4194304 & write-i32 8192 & write-i32 512
    & write-i16 4 & write-i16 0 & write-i16 0 & write-i16 0 & write-i16 4 & write-i16 0 & write-i32 0
    & write-i32 (align-up (8192 + section-size) 8192) & write-i32 512 & write-i32 0 & write-i16 3 & write-i16 256
    & write-i32 1048576 & write-i32 4096 & write-i32 1048576 & write-i32 4096 & write-i32 0 & write-i32 16
    & pad-zeros 112 & write-i32 8192 & write-i32 72 & pad-zeros 8
   in let section = text-to-utf8-bytes ".text" & [0, 0, 0] & write-i32 section-size & write-i32 8192 & write-i32 raw-size & write-i32 512 & pad-zeros 12 & write-i32 1610612768
   in dos & coff & opt & section & pad-zeros 96

  cil-mvid-word : List Integer, Integer, Integer, Integer -> Integer
  cil-mvid-word (image) (offset) (word) (i) =
   if i >= 4 then 0
   else let set = list-set-at image (offset + i) (bit-and (bit-shru word ((3 - i) * 8)) 255)
   in cil-mvid-word image offset word (i + 1)

  cil-build-pe : CilMetadata, List Integer -> List Integer
  cil-build-pe (md) (methods) = cil-build-pe-resources md methods []

  cil-build-pe-resources : CilMetadata, List Integer, List Integer -> List Integer
  cil-build-pe-resources (md) (methods) (resources) =
   let meta = cil-metadata-image md
   in let meta-offset = 72 + align-up (list-length methods) 4
   in let resource-offset = align-up (meta-offset + list-length (meta.bytes)) 4
   in let resource-size = list-length resources
   in let cli = write-i32 72 & write-i16 2 & write-i16 5 & write-i32 (8192 + meta-offset) & write-i32 (list-length (meta.bytes)) & write-i32 1 & write-i32 0 & write-i32 (if resource-size == 0 then 0 else 8192 + resource-offset) & write-i32 resource-size & pad-zeros 40
   in let section = cli & cil-pad4 methods & meta.bytes & (if resource-size == 0 then [] else pad-zeros (resource-offset - meta-offset - list-length (meta.bytes)) & resources)
   in let raw-size = align-up (list-length section) 512
   in let image = cil-pe-header (list-length section) raw-size & section & pad-zeros (raw-size - list-length section)
   in let scratch = __heap-save
   in let allocated = __heap-advance (align-up (list-length image) 8)
   in let copied = __buf-write-bytes scratch 0 image
   in let digest = sha256-buf scratch 0 (list-length image)
   in let a = list-at digest 0
   in let b = list-at digest 1
   in let c = list-at digest 2
   in let d = list-at digest 3
   in let restored = __heap-restore scratch
   in let offset = 512 + meta-offset + meta.guid-offset
   in let w0 = cil-mvid-word image offset a 0
   in let w1 = cil-mvid-word image (offset + 4) b 0
   in let w2 = cil-mvid-word image (offset + 8) c 0
   in let w3 = cil-mvid-word image (offset + 12) d 0
   in image
