  cites Foreword chapter SkipListText

 Expression emission: identifiers, arity, apply chains, dispatch.

Section: Identifier Helpers

  cs-keywords-1 : SkipListText
  cs-keywords-1 =
   skip-list-text-from-list ["abstract", "as", "base", "bool", "break",
    "case", "catch", "class", "continue", "decimal",
    "default", "delegate", "do", "double", "else",
    "event", "false", "finally", "for", "if",
    "in", "int", "internal", "is", "long"]

  cs-keywords-2 : SkipListText
  cs-keywords-2 =
   skip-list-text-from-list ["namespace", "new", "null", "object", "out",
    "override", "params", "private", "protected", "public",
    "ref", "return", "sealed", "static", "string",
    "switch", "this", "throw", "true", "try",
    "typeof", "using", "virtual", "void", "while"]

  is-cs-keyword : Text -> Boolean
  is-cs-keyword (n) =
   if skip-list-text-has cs-keywords-1 n then True
   else skip-list-text-has cs-keywords-2 n

  sanitize : Text -> Text
  sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-cs-keyword s then "@" & s
      else if is-cs-member-name s then s & "_"
              else s

  cs-member-names : SkipListText = skip-list-text-from-list ["Equals", "GetHashCode", "GetType", "MemberwiseClone", "ToString"]

  is-cs-member-name : Text -> Boolean
  is-cs-member-name (n) = skip-list-text-has cs-member-names n

  cs-type : CodexType -> Text
  cs-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "long"
    is NumberTy -> "double"
    is TextTy -> "string"
    is BooleanTy -> "bool"
    is CharTy -> "long"
    is VoidTy -> "void"
    is NothingTy -> "object"
    is ErrorTy -> "object"
    is FunTy (p) (r) -> "Func<" & cs-type p & ", " & cs-type r & ">"
    is ListTy (elem) -> "List<" & cs-type elem & ">"
    is LinkedListTy (elem) -> "List<" & cs-type elem & ">"
    is TypeVar (id) -> "T" & integer-to-text id
    is ForAllTy (id) (body) -> cs-type body
    is SumTy (name) (ty-args) (ctors) -> if list-length ty-args == 0 then sanitize (name.value)
                                          else sanitize (name.value) & "<" & emit-cs-type-args ty-args 0 & ">"
    is RecordTy (name) (ty-args) (fields) -> if list-length ty-args == 0 then sanitize (name.value)
                                              else sanitize (name.value) & "<" & emit-cs-type-args ty-args 0 & ">"
    is ConstructedTy (name) (args) -> if list-length args == 0 then sanitize (name.value)
                                     else sanitize (name.value) & "<" & emit-cs-type-args args 0 & ">"
    is EffectfulTy (effects) (sc) (ret) -> cs-type ret

  emit-cs-type-args : List CodexType, Integer -> Text
  emit-cs-type-args (args) (i) =
   if i == list-length args then ""
   else let t = cs-type (list-at args i)
   in if i == list-length args - 1 then t
      else t & ", " & emit-cs-type-args args (i + 1)

Section: Arity Map

  ArityEntry = record {

   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255

  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = list-length (d.params),
    generic-count = list-length (collect-type-var-ids (d.type-val) [])
   }))

  build-arity-map-from-ast : List ADef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map-from-ast (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map-from-ast defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name.value,
    arity = list-length (d.params),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

  lookup-generic-count : List ArityEntry, Text -> Integer
  lookup-generic-count (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0
      else let e = list-at entries pos
      in if e.name == name then e.generic-count else 0

Section: Raw Reference Builtins

  RawBuiltin = record {

   name : Text,
   emission : Text

  }

  bsearch-raw-pos : List RawBuiltin, Text, Integer, Integer -> Integer
  bsearch-raw-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-raw-pos entries name lo mid
      else bsearch-raw-pos entries name (mid + 1) hi

  sort-raw-builtins : List RawBuiltin -> List RawBuiltin
  sort-raw-builtins (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  raw-builtins : List RawBuiltin = sort-raw-builtins [

   RawBuiltin { name = "read-line", emission = "((Maybe<string>)(Console.ReadLine() switch { null => new None<string>(), var _s => new Just<string>(_Cce.FromUnicode(_s)) }))" },
   RawBuiltin { name = "get-args", emission = "Environment.GetCommandLineArgs().Select(_Cce.FromUnicode).ToList()" },
   RawBuiltin { name = "current-dir", emission = "_Cce.FromUnicode(Directory.GetCurrentDirectory())" },
   RawBuiltin { name = "__heap-save", emission = "_Buf.heap_save()" },
   RawBuiltin { name = "__heap-restore", emission = "new Func<object, long>(_p => _Buf.heap_restore(_p))" },
   RawBuiltin { name = "__heap-advance", emission = "new Func<object, long>(_n => _Buf.heap_advance(_n))" },
   RawBuiltin { name = "__deck-pos", emission = "_Buf.heap_save()" },
   RawBuiltin { name = "__deck-set", emission = "new Func<object, long>(_p => _Buf.heap_restore(_p))" },
   RawBuiltin { name = "__deck-alloc", emission = "new Func<object, long>(_n => _Buf.heap_advance(_n))" },
   RawBuiltin { name = "__deck-enter", emission = "0L" },
   RawBuiltin { name = "__deck-exit", emission = "0L" },
   RawBuiltin { name = "__list-with-capacity", emission = "new Func<object, List<long>>(_c => _Buf.list_with_capacity(_c))" },
   RawBuiltin { name = "__buf-write-byte", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _v => _Buf.buf_write_byte(_b, _o, _v))" },
   RawBuiltin { name = "__buf-write-bytes", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _vs => _Buf.buf_write_bytes(_b, _o, _vs))" },
   RawBuiltin { name = "__buf-read-bytes", emission = "new Func<object, Func<object, Func<object, List<long>>>>(_b => _o => _n => _Buf.buf_read_bytes(_b, _o, _n))" },
   RawBuiltin { name = "get-state", emission = "_State.get_state" }

  ]

  lookup-raw-builtin : Text -> Text
  lookup-raw-builtin (name) =
   let len = list-length raw-builtins
   in let pos = bsearch-raw-pos raw-builtins name 0 len
   in if pos >= len then ""
      else let e = list-at raw-builtins pos
      in if e.name == name then e.emission else ""

Section: Apply Chain

 ApplyChain and collect-apply-chain are provided by the in-tree

 CodexEmitter chapter (codex/Emit/CodexEmitter.codex); when this

 chapter is bundled into a plug deck alongside the compiler frontend,

 redefining them trips CDX3001 (Duplicate type definition). The plug

 references them via the deck-wide resolver instead.

  is-upper-letter : Char -> Boolean
  is-upper-letter (c) =
   let code = char-code c
   in code >= char-code 'E' & code <= char-code 'Z'

  emit-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-expr (list-at args i) arities
        else emit-expr (list-at args i) arities & ", " & emit-apply-args args arities (i + 1)

  emit-partial-params : Integer, Integer -> Text
  emit-partial-params (i) (count) =
   if i == count then ""
   else if i == count - 1 then "_p" & integer-to-text i & "_"
        else "_p" & integer-to-text i & "_" & ", " & emit-partial-params (i + 1) count

  emit-partial-wrappers : Integer, Integer -> Text
  emit-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & integer-to-text i & "_) => " & emit-partial-wrappers (i + 1) count

  BuiltinEmitter = record {

   name : Text,
   emit : List IRExpr, List ArityEntry, CodexType -> Text

  }

  bsearch-emitter-pos : List BuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-emitter-pos entries name lo mid
      else bsearch-emitter-pos entries name (mid + 1) hi

  sort-emitters : List BuiltinEmitter -> List BuiltinEmitter
  sort-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  builtin-emitters : List BuiltinEmitter = sort-emitters [

   BuiltinEmitter { name = "show", emit = \args -> \arities -> \ty -> emit-builtin-show args arities },
   BuiltinEmitter { name = "negate", emit = \args -> \arities -> \ty -> "(-" & emit-expr (list-at args 0) arities & ")" },
   BuiltinEmitter { name = "print-line-uni", emit = \args -> \arities -> \ty -> emit-builtin-print-line-uni args arities },
   BuiltinEmitter { name = "print-error-uni", emit = \args -> \arities -> \ty -> emit-builtin-print-error-uni args arities },
   BuiltinEmitter { name = "text-length", emit = \args -> \arities -> \ty -> "((long)" & emit-expr (list-at args 0) arities & ".Length)" },
   BuiltinEmitter { name = "is-letter", emit = \args -> \arities -> \ty -> emit-builtin-is-letter args arities },
   BuiltinEmitter { name = "is-digit", emit = \args -> \arities -> \ty -> emit-builtin-is-digit args arities },
   BuiltinEmitter { name = "is-whitespace", emit = \args -> \arities -> \ty -> "(" & emit-expr (list-at args 0) arities & " <= 2L)" },
   BuiltinEmitter { name = "text-to-integer", emit = \args -> \arities -> \ty -> emit-builtin-text-to-integer args arities },
   BuiltinEmitter { name = "text-to-double-bits", emit = \args -> \arities -> \ty -> emit-builtin-text-to-double-bits args arities },
   BuiltinEmitter { name = "integer-to-text", emit = \args -> \arities -> \ty -> emit-builtin-integer-to-text args arities },
   BuiltinEmitter { name = "char-code", emit = \args -> \arities -> \ty -> emit-expr (list-at args 0) arities },
   BuiltinEmitter { name = "char-code-at", emit = \args -> \arities -> \ty -> emit-builtin-char-code-at args arities },
   BuiltinEmitter { name = "code-to-char", emit = \args -> \arities -> \ty -> emit-expr (list-at args 0) arities },
   BuiltinEmitter { name = "char-to-text", emit = \args -> \arities -> \ty -> "((char)" & emit-expr (list-at args 0) arities & ").ToString()" },
   BuiltinEmitter { name = "list-length", emit = \args -> \arities -> \ty -> "((long)" & emit-expr (list-at args 0) arities & ".Count)" },
   BuiltinEmitter { name = "char-at", emit = \args -> \arities -> \ty -> emit-builtin-char-at args arities },
   BuiltinEmitter { name = "substring", emit = \args -> \arities -> \ty -> emit-builtin-substring args arities },
   BuiltinEmitter { name = "list-at", emit = \args -> \arities -> \ty -> emit-builtin-list-at args arities },
   BuiltinEmitter { name = "list-insert-at", emit = \args -> \arities -> \ty -> emit-builtin-list-insert-at args arities },
   BuiltinEmitter { name = "list-set-at", emit = \args -> \arities -> \ty -> emit-builtin-list-set-at args arities },
   BuiltinEmitter { name = "list-snoc", emit = \args -> \arities -> \ty -> emit-builtin-list-snoc args arities },
   BuiltinEmitter { name = "text-compare", emit = \args -> \arities -> \ty -> emit-builtin-text-compare args arities },
   BuiltinEmitter { name = "text-replace", emit = \args -> \arities -> \ty -> emit-builtin-text-replace args arities },
   BuiltinEmitter { name = "open-file", emit = \args -> \arities -> \ty -> "File.OpenRead(" & emit-expr (list-at args 0) arities & ")" },
   BuiltinEmitter { name = "read-all", emit = \args -> \arities -> \ty -> emit-builtin-read-all args arities },
   BuiltinEmitter { name = "close-file", emit = \args -> \arities -> \ty -> emit-expr (list-at args 0) arities & ".Dispose()" },
   BuiltinEmitter { name = "read-line", emit = \args -> \arities -> \ty -> "((Maybe<string>)(Console.ReadLine() switch { null => new None<string>(), var _s => new Just<string>(_Cce.FromUnicode(_s)) }))" },
   BuiltinEmitter { name = "read-file", emit = \args -> \arities -> \ty -> emit-builtin-read-file args arities },
   BuiltinEmitter { name = "write-file", emit = \args -> \arities -> \ty -> emit-builtin-write-file args arities },
   BuiltinEmitter { name = "write-binary", emit = \args -> \arities -> \ty -> "((Func<object>)(() => { List<long> _bl = (List<long>)" & emit-expr (list-at args 0) arities & "; using System.IO.Stream _s = Console.OpenStandardOutput(); foreach (long _b in _bl) _s.WriteByte((byte)_b); _s.Flush(); return null; }))()" },
   BuiltinEmitter { name = "file-exists", emit = \args -> \arities -> \ty -> emit-builtin-file-exists args arities },
   BuiltinEmitter { name = "list-files", emit = \args -> \arities -> \ty -> emit-builtin-list-files args arities },
   BuiltinEmitter { name = "list-directories", emit = \args -> \arities -> \ty -> "Directory.GetDirectories(_Cce.ToUnicode(" & emit-expr (list-at args 0) arities & ")).Select(_Cce.FromUnicode).ToList()" },
   BuiltinEmitter { name = "write-binary-file", emit = \args -> \arities -> \ty -> "((Func<object>)(() => { List<long> _bl = (List<long>)" & emit-expr (list-at args 1) arities & "; byte[] _ba = new byte[_bl.Count]; for (int _i = 0; _i < _bl.Count; _i++) _ba[_i] = (byte)_bl[_i]; File.WriteAllBytes(_Cce.ToUnicode(" & emit-expr (list-at args 0) arities & "), _ba); return null; }))()" },
   BuiltinEmitter { name = "create-directory", emit = \args -> \arities -> \ty -> "((Func<object>)(() => { Directory.CreateDirectory(_Cce.ToUnicode(" & emit-expr (list-at args 0) arities & ")); return null; }))()" },
   BuiltinEmitter { name = "path-combine", emit = \args -> \arities -> \ty -> "_Cce.FromUnicode(Path.Combine(_Cce.ToUnicode(" & emit-expr (list-at args 0) arities & "), _Cce.ToUnicode(" & emit-expr (list-at args 1) arities & ")))" },
   BuiltinEmitter { name = "path-filename", emit = \args -> \arities -> \ty -> "_Cce.FromUnicode(Path.GetFileName(_Cce.ToUnicode(" & emit-expr (list-at args 0) arities & ")))" },
   BuiltinEmitter { name = "external-compile-bare", emit = \args -> \arities -> \ty -> "((Func<List<long>>)(() => { EmitChapterResult _r = Codex_Codex_Codex.compile_to_binary_with_options(" & emit-expr (list-at args 0) arities & ", " & emit-expr (list-at args 1) arities & ", " & "(" & emit-expr (list-at args 2) arities & " == _Cce.FromUnicode(\"repl\") ? (X86_64ExitMode)new ExitRepl() : new ExitQemuExit()), " & "(" & emit-expr (list-at args 3) arities & " == _Cce.FromUnicode(\"pet\") ? (X86_64WatchdogMode)new WatchdogPet() : new WatchdogProgress())); if (Codex_Codex_Codex.bag_has_errors(_r.bag)) { foreach (var _d in Codex_Codex_Codex.bag_diagnostics(_r.bag)) Console.Error.WriteLine(_d.span.start.line + \":\" + _d.span.start.column + \": \" + _Cce.ToUnicode(_d.message)); return new List<long>(); } return _r.bytes; }))()" },
   BuiltinEmitter { name = "text-concat-list", emit = \args -> \arities -> \ty -> "string.Concat(" & emit-expr (list-at args 0) arities & ")" },
   BuiltinEmitter { name = "text-split", emit = \args -> \arities -> \ty -> emit-builtin-text-split args arities },
   BuiltinEmitter { name = "text-contains", emit = \args -> \arities -> \ty -> emit-builtin-text-contains args arities },
   BuiltinEmitter { name = "text-starts-with", emit = \args -> \arities -> \ty -> emit-builtin-text-starts-with args arities },
   BuiltinEmitter { name = "get-args", emit = \args -> \arities -> \ty -> "Environment.GetCommandLineArgs().Select(_Cce.FromUnicode).ToList()" },
   BuiltinEmitter { name = "get-env", emit = \args -> \arities -> \ty -> emit-builtin-get-env args arities },
   BuiltinEmitter { name = "current-dir", emit = \args -> \arities -> \ty -> "_Cce.FromUnicode(Directory.GetCurrentDirectory())" },
   BuiltinEmitter { name = "run-process", emit = \args -> \arities -> \ty -> emit-builtin-run-process args arities },
   BuiltinEmitter { name = "run-process-full", emit = \args -> \arities -> \ty -> emit-builtin-run-process-full args arities },
   BuiltinEmitter { name = "process-exit", emit = \args -> \arities -> \ty -> "((Func<object>)(() => { Environment.Exit((int)(long)(" & emit-expr (list-at args 0) arities & ")); return null; }))()" },
   BuiltinEmitter { name = "fork", emit = \args -> \arities -> \ty -> "Task.Run(() => (" & emit-expr (list-at args 0) arities & ")(null))" },
   BuiltinEmitter { name = "await", emit = \args -> \arities -> \ty -> "(" & emit-expr (list-at args 0) arities & ").Result" },
   BuiltinEmitter { name = "par", emit = \args -> \arities -> \ty -> emit-builtin-par args arities },
   BuiltinEmitter { name = "race", emit = \args -> \arities -> \ty -> emit-builtin-race args arities },
   BuiltinEmitter { name = "__record-set", emit = \args -> \arities -> \ty -> emit-builtin-record-set args arities },
   BuiltinEmitter { name = "__linked-list-empty", emit = \args -> \arities -> \ty -> let et = when ty is LinkedListTy (elem) -> cs-type elem is otherwise -> "object" in "new List<" & et & ">()" },
   BuiltinEmitter { name = "__linked-list-push", emit = \args -> \arities -> \ty -> let et = when ty is LinkedListTy (elem) -> cs-type elem is otherwise -> "object" in "((Func<List<" & et & ">, " & et & ", List<" & et & ">>)((_ll, _v) => { _ll.Add(_v); return _ll; }))(" & emit-expr (list-at args 0) arities & ", " & emit-expr (list-at args 1) arities & ")" },
   BuiltinEmitter { name = "__linked-list-to-list", emit = \args -> \arities -> \ty -> emit-expr (list-at args 0) arities },
   BuiltinEmitter { name = "__heap-save", emit = \args -> \arities -> \ty -> "_Buf.heap_save()" },
