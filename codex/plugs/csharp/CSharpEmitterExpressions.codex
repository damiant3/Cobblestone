  emit-int-mod : List IRExpr, CsCtx -> Text
  emit-int-mod (args) (ctx) =
   "((Func<long, long, long>)((_a, _b) => { long _abs = _b < 0L ? -_b : _b; long _r = _a % _abs; return _r < 0L ? _r + _abs : _r; }))("
    & emit-expr (list-at args 0) ctx & ", "
    & emit-expr (list-at args 1) ctx & ")"

  is-builtin-name : Text -> Boolean
  is-builtin-name (n) =
   lookup-builtin-emitter n >= 0

  emit-builtin : Text, List IRExpr, CsCtx, CodexType -> Text
  emit-builtin (n) (args) (ctx) (result-ty) =
   emit-builtin-dispatch n args ctx result-ty

  lookup-builtin-emitter : Text -> Integer
  lookup-builtin-emitter (name) =
   let len = list-length builtin-emitters
   in let pos = bsearch-emitter-pos builtin-emitters name 0 len
   in if pos >= len then -1
      else if (list-at builtin-emitters pos).name == name then pos
      else -1

  emit-builtin-dispatch : Text, List IRExpr, CsCtx, CodexType -> Text
  emit-builtin-dispatch (n) (args) (ctx) (ty) =
   let idx = lookup-builtin-emitter n
   in if idx >= 0 then (list-at builtin-emitters idx).emit args ctx ty
      else ""

  cs-name-for : Text -> Text
  cs-name-for (n) = text-replace n "-" "_"

  emit-buf-call-1 : Text, List IRExpr, CsCtx -> Text
  emit-buf-call-1 (n) (args) (ctx) =
   "_Buf." & cs-name-for n & "(" & emit-expr (list-at args 0) ctx & ")"

  emit-buf-call-2 : Text, List IRExpr, CsCtx -> Text
  emit-buf-call-2 (n) (args) (ctx) =
   "_Buf." & cs-name-for n & "("
    & emit-expr (list-at args 0) ctx & ", "
    & emit-expr (list-at args 1) ctx & ")"

  emit-buf-call-3 : Text, List IRExpr, CsCtx -> Text
  emit-buf-call-3 (n) (args) (ctx) =
   "_Buf." & cs-name-for n & "("
    & emit-expr (list-at args 0) ctx & ", "
    & emit-expr (list-at args 1) ctx & ", "
    & emit-expr (list-at args 2) ctx & ")"

  bit-op-symbol : Text -> Text
  bit-op-symbol (n) =
   if n == "bit-and" then " & "
   else if n == "bit-or" then " | "
   else if n == "bit-xor" then " ^ "
   else if n == "bit-shl" then " << (int)"
   else if n == "bit-shr" then " >> (int)"
   else ""

  emit-bit-builtin : Text, List IRExpr, CsCtx -> Text
  emit-bit-builtin (n) (args) (ctx) =
   if n == "bit-not" then "(~" & emit-expr (list-at args 0) ctx & ")"
   else "(" & emit-expr (list-at args 0) ctx & bit-op-symbol n & emit-expr (list-at args 1) ctx & ")"

  emit-builtin-record-set : List IRExpr, CsCtx -> Text
  emit-builtin-record-set (args) (ctx) =
   let field-name = when (list-at args 1)
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in let f = cs-field field-name
   in let v = emit-expr (list-at args 2) ctx
   in let lname = store-local-name (list-at args 0) ctx
   in if text-length lname > 0 then "_Buf.store(" & lname & ", " & lname & "." & f & " = " & v & ")"
      else "_Buf.rset(" & emit-expr (list-at args 0) ctx & ", __rs => { __rs." & f & " = " & v & "; })"

  cs-slash-pos : Text, Integer, Integer -> Integer
  cs-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else cs-slash-pos f (i + 1) len

  cs-field : Text -> Text
  cs-field (f) =
   let slash = cs-slash-pos f 0 (text-length f)
   in if slash >= 0 then sanitize (substring f 0 slash)
   else sanitize f

 `show` is the one conversion that has to look at its argument's type.
 Convert.ToString of a Text hands back the same string, which is already
 CCE and must not be converted twice; of anything else it builds a fresh
 native string out of .NET's own digits and words, which must be.

  emit-builtin-show : List IRExpr, CsCtx -> Text
  emit-builtin-show (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in when ir-expr-type (list-at args 0)
    is TextTy -> "Convert.ToString(" & a0 & ")"
    is otherwise -> "_Cce.FromUnicode(Convert.ToString(" & a0 & "))"

  emit-builtin-print-line-uni : List IRExpr, CsCtx -> Text
  emit-builtin-print-line-uni (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "((Func<object>)(() => { Console.WriteLine(_Cce.ToUnicode(" & a0 & ")); return null; }))()"

  emit-builtin-print-error-uni : List IRExpr, CsCtx -> Text
  emit-builtin-print-error-uni (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "((Func<object>)(() => { Console.Error.WriteLine(_Cce.ToUnicode(" & a0 & ")); return null; }))()"

 The character predicates test CCE BANDS and must never be handed to
 `char.IsLetter` or its siblings. Codex text is CCE, which numbers its
 code points by frequency: the letter a is 15, and `(char)15` is a
 control character, so the predicate answers false. The bands are 1..2
 whitespace, 3..12 digit, and 13..64 or 97..127 letter, the hole being
 CCE's punctuation at 65..96.

 Written as a relational pattern rather than a comparison chain so the
 operand is named once; `and` binds tighter than `or` inside a pattern,
 and the two letter bands are parenthesised anyway so the grouping is
 not left to that rule.

  emit-builtin-is-letter : List IRExpr, CsCtx -> Text
  emit-builtin-is-letter (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "(" & a0 & " is (>= 13L and <= 64L) or (>= 97L and <= 127L))"

  emit-builtin-is-digit : List IRExpr, CsCtx -> Text
  emit-builtin-is-digit (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "(" & a0 & " is >= 3L and <= 12L)"

  emit-builtin-text-to-integer : List IRExpr, CsCtx -> Text
  emit-builtin-text-to-integer (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "_CxText.ToInteger(" & a0 & ")"

  emit-builtin-text-to-double-bits : List IRExpr, CsCtx -> Text
  emit-builtin-text-to-double-bits (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "BitConverter.DoubleToInt64Bits(double.Parse(_Cce.ToUnicode(" & a0 & "), System.Globalization.CultureInfo.InvariantCulture))"

  emit-builtin-integer-to-text : List IRExpr, CsCtx -> Text
  emit-builtin-integer-to-text (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "_Cce.FromUnicode(" & a0 & ".ToString())"

  emit-builtin-char-code-at : List IRExpr, CsCtx -> Text
  emit-builtin-char-code-at (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "((long)" & a0 & "[(int)" & a1 & "])"

  emit-builtin-char-at : List IRExpr, CsCtx -> Text
  emit-builtin-char-at (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "((long)" & a0 & "[(int)" & a1 & "])"

  emit-builtin-substring : List IRExpr, CsCtx -> Text
  emit-builtin-substring (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in let a2 = emit-expr (list-at args 2) ctx
   in a0 & ".Substring((int)" & a1 & ", (int)" & a2 & ")"

  emit-builtin-list-at : List IRExpr, CsCtx -> Text
  emit-builtin-list-at (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in a0 & "[(int)" & a1 & "]"

  emit-builtin-list-insert-at : List IRExpr, CsCtx -> Text
  emit-builtin-list-insert-at (args) (ctx) =
   let elem-ty = when ir-expr-type (list-at args 0)
    is ListTy (et) -> et
    is otherwise -> ErrorTy
   in let ty = cs-type elem-ty
   in let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in let a2 = emit-expr (list-at args 2) ctx
   in "((Func<List<" & ty & ">>)(() => { List<" & ty & "> _l = " & a0 & "; _l.Insert((int)" & a1 & ", " & a2 & "); return _l; }))()"

  emit-builtin-list-set-at : List IRExpr, CsCtx -> Text
  emit-builtin-list-set-at (args) (ctx) =
   let elem-ty = when ir-expr-type (list-at args 0)
    is ListTy (et) -> et
    is otherwise -> ErrorTy
   in let ty = cs-type elem-ty
   in let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in let a2 = emit-expr (list-at args 2) ctx
   in "((Func<List<" & ty & ">>)(() => { List<" & ty & "> _l = " & a0 & "; _l[(int)" & a1 & "] = " & a2 & "; return _l; }))()"

  emit-builtin-list-snoc : List IRExpr, CsCtx -> Text
  emit-builtin-list-snoc (args) (ctx) =
   let elem-ty = when ir-expr-type (list-at args 0)
    is ListTy (et) -> et
    is otherwise -> ErrorTy
   in let ty = cs-type elem-ty
   in let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "_Buf.lpush<" & ty & ">(" & a0 & ", " & a1 & ")"

  emit-builtin-text-compare : List IRExpr, CsCtx -> Text
  emit-builtin-text-compare (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "(long)string.CompareOrdinal(" & a0 & ", " & a1 & ")"

  emit-builtin-text-replace : List IRExpr, CsCtx -> Text
  emit-builtin-text-replace (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in let a2 = emit-expr (list-at args 2) ctx
   in "_CxText.Replace(" & a0 & ", " & a1 & ", " & a2 & ")"

  emit-builtin-read-all : List IRExpr, CsCtx -> Text
  emit-builtin-read-all (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "_Cce.FromUnicode(new System.IO.StreamReader(" & a0 & ").ReadToEnd())"

  emit-builtin-read-file : List IRExpr, CsCtx -> Text
  emit-builtin-read-file (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "_Cce.FromUnicode(File.ReadAllText(_Cce.ToUnicode(" & a0 & ")))"

  emit-builtin-write-file : List IRExpr, CsCtx -> Text
  emit-builtin-write-file (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "File.WriteAllText(_Cce.ToUnicode(" & a0 & "), _Cce.ToUnicode(" & a1 & "))"

  emit-builtin-file-exists : List IRExpr, CsCtx -> Text
  emit-builtin-file-exists (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "File.Exists(_Cce.ToUnicode(" & a0 & "))"

  emit-builtin-list-files : List IRExpr, CsCtx -> Text
  emit-builtin-list-files (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "_Cce.FromUnicodeArr(Directory.GetFiles(_Cce.ToUnicode(" & a0 & "), _Cce.ToUnicode(" & a1 & ")))"

  emit-builtin-text-split : List IRExpr, CsCtx -> Text
  emit-builtin-text-split (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "_CxText.Split(" & a0 & ", " & a1 & ")"

  emit-builtin-text-contains : List IRExpr, CsCtx -> Text
  emit-builtin-text-contains (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in a0 & ".Contains(" & a1 & ", StringComparison.Ordinal)"

 A lifted lambda's def takes `dynamic` parameters (see the emitter's
 def-side note), and C# refuses to convert such a method group to a
 concrete delegate type. A bare lambda converts where the group cannot,
 because the site's delegate context target-types it; a cast must NOT be
 added here, since the site's IR type can carry free type variables that
 name nothing in the enclosing method.

  is-lam-name : Text -> Boolean
  is-lam-name (n) =
   text-length n >= 6 & substring n 0 6 == "__lam_"

  emit-builtin-text-starts-with : List IRExpr, CsCtx -> Text
  emit-builtin-text-starts-with (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in a0 & ".StartsWith(" & a1 & ", StringComparison.Ordinal)"

  emit-builtin-get-env : List IRExpr, CsCtx -> Text
  emit-builtin-get-env (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "_Cce.FromUnicode(Environment.GetEnvironmentVariable(_Cce.ToUnicode(" & a0 & ")) ?? \"\")"

  emit-builtin-run-process : List IRExpr, CsCtx -> Text
  emit-builtin-run-process (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "((Func<string>)(() => {"
   & " System.Diagnostics.ProcessStartInfo _psi = new System.Diagnostics.ProcessStartInfo("
   & "_Cce.ToUnicode(" & a0 & "), _Cce.ToUnicode(" & a1 & "))"
   & " { RedirectStandardOutput = true, UseShellExecute = false };"
   & " System.Diagnostics.Process _p = System.Diagnostics.Process.Start(_psi)!;"
   & " string _o = _p.StandardOutput.ReadToEnd();"
   & " _p.WaitForExit(); return _Cce.FromUnicode(_o); }))()"

  emit-builtin-run-process-full : List IRExpr, CsCtx -> Text
  emit-builtin-run-process-full (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "((Func<ProcessResult>)(() => {"
   & " System.Diagnostics.ProcessStartInfo _psi = new System.Diagnostics.ProcessStartInfo("
   & "_Cce.ToUnicode(" & a0 & "), _Cce.ToUnicode(" & a1 & "))"
   & " { RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false };"
   & " System.Diagnostics.Process _p = System.Diagnostics.Process.Start(_psi)!;"
   & " string _so = _p.StandardOutput.ReadToEnd();"
   & " string _se = _p.StandardError.ReadToEnd();"
   & " _p.WaitForExit();"
   & " return new ProcessResult(_Cce.FromUnicode(_so), _Cce.FromUnicode(_se), (long)_p.ExitCode); }))()"

  emit-builtin-par : List IRExpr, CsCtx -> Text
  emit-builtin-par (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in let a1 = emit-expr (list-at args 1) ctx
   in "Task.WhenAll(" & a1 & ".Select(_x_ => Task.Run(() => (" & a0 & ")(_x_)))).Result.ToList()"

  emit-builtin-race : List IRExpr, CsCtx -> Text
  emit-builtin-race (args) (ctx) =
   let a0 = emit-expr (list-at args 0) ctx
   in "Task.WhenAny(" & a0 & ".Select(_t_ => Task.Run(() => _t_(null)))).Result.Result"

  emit-builtin-run-state : List IRExpr, CsCtx -> Text
  emit-builtin-run-state (args) (ctx) =
   let init = emit-expr (list-at args 0) ctx
   in let body = emit-expr (list-at args 1) ctx
   in "((Func<long>)(() => { long __saved = _State._value; _State._value = " & init & "; try { return " & body & "; } finally { _State._value = __saved; } }))()"

  sum-type-name : CodexType -> Text
  sum-type-name (ty) =
   when ty
    is SumTy (name) (args) (ctors) -> sanitize (name.value)
    is RecordTy (name) (args) (fields) -> sanitize (name.value)
    is ConstructedTy (name) (args) -> sanitize (name.value)
    is TypeCon (name) -> sanitize (name.value)
    is otherwise -> ""

  emit-ctor-upcast : Text, CodexType, Text -> Text
  emit-ctor-upcast (name) (ty) (args-str) =
   let ctor = "new " & sanitize name & extract-ctor-type-args ty & "(" & args-str & ")"
   in let sum-name = sum-type-name ty
   in if sum-name == "" then ctor
      else if sum-name == sanitize name then ctor
      else "((" & cs-type ty & ")(" & ctor & "))"

 The result type recorded on the outermost apply node carries the
 constructor's DECLARED type variable, not the one substituted at the call
 site: `hamt-node-set` is generic over tvar 35 and every inner type says
 35, while the node itself says tvar 8. Walking the root's function type
 one arrow per argument reaches the substituted result. The node's own
 type stays the fallback for any root that is not a full function type.

  applied-result-ty : CodexType, Integer, CodexType -> CodexType
  applied-result-ty (fn-ty) (n) (fallback) =
   if n == 0 then fn-ty
   else when fn-ty
    is FunTy (p) (fnrow) (r) -> applied-result-ty r (n - 1) fallback
    is ForAllTy (id) (body) -> applied-result-ty body n fallback
    is ForAllEff (id) (body) -> applied-result-ty body n fallback
    is EffectfulTy (effs) (sc) (ret) -> applied-result-ty ret n fallback
    is otherwise -> fallback

 `deck-record` is intercepted here by name, the same way x86-64 does it
 at `X86_64Compound.codex:149`, because its source body is `x` and its
 real meaning is in codegen: `emit-deck-record-wrapper` brackets the
 ARGUMENT's evaluation in __deck-enter / __deck-exit, which swaps the
 live allocation pointer onto the deck for the extent. C# evaluates an
 argument before the call, so only a lambda can bracket it.

 C# refuses a bare lambda as an argument to a dynamically dispatched
 call (CS1977), and a `map-list` whose list is a field read off a
 type-variable value is such a call: the receiver is `dynamic`, so the
 whole invocation is runtime-bound. The emission below makes the
 binding static instead: the field access is cast to the non-generic
 IEnumerable, so no argument is dynamic and the lambda converts at
 compile time, and `_Buf.dmap` rebuilds its result with the input
 list's own runtime element type, which is what the enclosing
 constructor call, itself runtime-bound, requires of the value.

  is-tvar-ty : CodexType -> Boolean
  is-tvar-ty (ty) =
   when ty
    is TypeVar (id) -> True
    is otherwise -> False

  is-dyn-receiver : IRExpr, CsCtx -> Boolean
  is-dyn-receiver (rec) (ctx) =
   when rec
    is IrName (n) (nty) (sp) -> name-in-list (ctx.dyn-locals) n 0 | is-tvar-ty nty
    is otherwise -> is-tvar-ty (ir-expr-type rec)

  is-tvar-field-list : IRExpr, CsCtx -> Boolean
  is-tvar-field-list (e) (ctx) =
   when e
    is IrFieldAccess (rec) (field) (ty) (sp) -> is-dyn-receiver rec ctx
    is otherwise -> False

  emit-apply : IRExpr, CsCtx -> Text
  emit-apply (e) (ctx) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
      is IrName (n) (ty) (sp) ->
       if n == "deck-record" & list-length args == 1 then "_Buf.deck_scope(() => " & emit-expr (list-at args 0) ctx & ")"
       else if is-builtin-name n & prefer-user-over-builtin n args ctx == False then emit-builtin n args ctx (ir-expr-type e)
       else if is-mktup-name n then "(" & emit-apply-args args ctx 0 & ")"
       else if text-length n > 0 & is-upper-letter (char-at n 0) then emit-ctor-upcast n (applied-result-ty ty (list-length args) (ir-expr-type e)) (emit-apply-args args ctx 0)
       else if n == "map-list" & list-length args == 2 & is-tvar-field-list (list-at args 1) ctx then "_Buf.dmap(" & emit-expr (list-at args 0) ctx & ", (System.Collections.IEnumerable)(" & emit-expr (list-at args 1) ctx & "))"
   else let ar = lookup-arity (ctx.arities) n
   in if ar > 1 & list-length args == ar then sanitize n & "(" & emit-apply-args args ctx 0 & ")"
            else if ar > 1 & list-length args < ar then let remaining = ar - list-length args
   in emit-partial-wrappers 0 remaining & sanitize n & "(" & emit-apply-args args ctx 0 & ", " & emit-partial-params 0 remaining & ")"
           else emit-expr-curried e ctx
      is otherwise -> emit-expr-curried e ctx

  emit-expr-curried : IRExpr, CsCtx -> Text
  emit-expr-curried (e) (ctx) =
   when e
    is IrApply (f) (a) (ty) (sp) -> emit-expr f ctx & "(" & emit-expr a ctx & ")"
    is otherwise -> emit-expr e ctx

  prefer-user-over-builtin : Text, List IRExpr, CsCtx -> Boolean
  prefer-user-over-builtin (n) (args) (ctx) =
   if lookup-arity (ctx.arities) n < 0 then False
   else if n == "list-length" then list-length args > 0 & is-builtin-list-arg-ty (ir-expr-type (list-at args 0)) == False
   else False

  is-builtin-list-arg-ty : CodexType -> Boolean
  is-builtin-list-arg-ty (ty) =
   when ty
    is ListTy (elem) -> True
    is LinkedListTy (elem) -> True
    is otherwise -> False

Section: Expression Emission

  max-emit-depth : Integer = 256

  emit-expr : IRExpr, CsCtx -> Text
  emit-expr (e) (ctx) = emit-expr-at e ctx 0

  emit-expr-at : IRExpr, CsCtx, Integer -> Text
  emit-expr-at (e) (ctx) (depth) =
   if depth >= max-emit-depth then "/* fuel exhausted */ default"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n & "L"
    is IrNumLit (n) (sp) -> "BitConverter.Int64BitsToDouble(" & integer-to-text n & "L)"
    is IrTextLit (s) (sp) -> "\"" & escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> if name-in-list (ctx.locals) n 0 then sanitize n else let raw = lookup-raw-builtin n in if text-length raw > 0 then raw else if text-length n > 0 & is-upper-letter (char-at n 0) then emit-ctor-upcast n ty "" else let ar = lookup-arity (ctx.arities) n in if ar == 0 then sanitize n & (if lookup-generic-count (ctx.arities) n > 0 then extract-fn-type-args ty else "") & "()" else if ar >= 2 then (if ty-is-concrete-value ty then sanitize n else emit-partial-wrappers 0 ar & sanitize n & "(" & emit-partial-params 0 ar & ")") else if is-lam-name n then "(_da0 => " & sanitize n & "(_da0))" else sanitize n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-binary op l r ty ctx
    is IrNegate (operand) (nty) (sp) -> "(-" & emit-expr-at operand ctx (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-expr-at c ctx (depth + 1) & " ? " & emit-expr-at t ctx (depth + 1) & " : " & emit-expr-at el ctx (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> emit-let name ty val body ctx
    is IrApply (f) (a) (ty) (sp) -> emit-apply e ctx
    is IrLambda (params) (body) (ty) (sp) -> emit-lambda params body ty ctx
    is IrList (elems) (ty) (sp) -> emit-list elems ty ctx
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-match scrut branches ty ctx
    is IrAct (stmts) (ty) (sp) -> emit-act stmts ty ctx
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-handle eff body clauses ty ctx
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-expr-at body ctx (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-record name fields ty ctx
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-expr-at rec ctx (depth + 1) & "." & cs-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> emit-field-store rec field val ty ctx (depth + 1)
    is IrFork (body) (ty) (sp) -> "Task.Run(() => (" & emit-expr-at body ctx (depth + 1) & ")(null))"
    is IrAwait (task) (ty) (sp) -> "(" & emit-expr-at task ctx (depth + 1) & ").Result"
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-cs-try max body fb fail-stmts ty ctx
    is IrError (msg) (ty) (sp) -> "/* error: " & msg & " */ default"

 A field store must be DESTRUCTIVE and must still be an expression of
 the record's type, because the IR places it wherever an expression can
 go. C# assignment is an expression but its type is the FIELD's, so the
 store is threaded through `_Buf.store(r, r.f = v)`: C# evaluates
 arguments left to right, so the record is read, the field assigned, and
 the same reference returned. That form reads the receiver twice, which
 is free only for a plain local; anything else goes through a lambda
 that binds the receiver once.

  emit-field-store : IRExpr, Text, IRExpr, CodexType, CsCtx, Integer -> Text
  emit-field-store (rec) (field) (val) (ty) (ctx) (depth) =
   let lname = store-local-name rec ctx
   in let f = cs-field field
   in let v = emit-expr-at val ctx depth
   in if text-length lname > 0 then "_Buf.store(" & lname & ", " & lname & "." & f & " = " & v & ")"
      else "((Func<" & cs-type ty & ">)(() => { var __r = " & emit-expr-at rec ctx depth & "; __r." & f & " = " & v & "; return __r; }))()"

  store-local-name : IRExpr, CsCtx -> Text
  store-local-name (rec) (ctx) =
   when rec
    is IrName (n) (nty) (nsp) -> if name-in-list (ctx.locals) n 0 then sanitize n else ""
    is otherwise -> ""

  hex-digit : Integer -> Text
  hex-digit (n) =
   if n == 0 then "0"
   else if n == 1 then "1"
   else if n == 2 then "2"
   else if n == 3 then "3"
   else if n == 4 then "4"
   else if n == 5 then "5"
   else if n == 6 then "6"
   else if n == 7 then "7"
   else if n == 8 then "8"
   else if n == 9 then "9"
   else if n == 10 then "A"
   else if n == 11 then "B"
   else if n == 12 then "C"
   else if n == 13 then "D"
   else if n == 14 then "E"
   else if n == 15 then "F"
   else "?"

  hex4 : Integer -> Text
  hex4 (n) =
   "00" & hex-digit (n / 16) & hex-digit (n - n / 16 * 16)

 Every character of a text literal is emitted as a `\u00XX` escape of its
 CCE BYTE, because the runtime string has to be CCE and the file does not.
 The plug's own Text is already CCE, one char per byte, so the byte is
 just `char-code-at`. Writing the escape rather than the character is what
 gets it past `print-uni`, which converts CCE to Unicode on the way out
 and would otherwise undo this on every literal in the file; the escape
 itself is ASCII and survives that conversion unchanged.

  escape-text : Text -> Text
  escape-text (s) =
   text-concat-list (escape-text-chars s 0 (text-length s) [])

  escape-text-chars : Text, Integer, Integer, List Text -> List Text
  escape-text-chars (s) (i) (len) (acc) =
   if i >= len then acc
   else escape-text-chars s (i + 1) len (list-push acc ("\\u" & hex4 (char-code-at s i)))

  ty-is-concrete-value : CodexType -> Boolean
  ty-is-concrete-value (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> True
    is RealTy (w) (m) -> True
    is TextTy -> True
    is BooleanTy -> True
    is CharTy -> True
    is ListTy (elem) -> True
    is LinkedListTy (elem) -> True
    is SumTy (name) (ty-args) (ctors) -> True
    is RecordTy (name) (ty-args) (fields) -> True
    is ConstructedTy (name) (args) -> True
    is TypeCon (name) -> True
    is ForAllTy (id) (body) -> ty-is-concrete-value body
    is ForAllEff (id) (body) -> ty-is-concrete-value body
    is LinearTy (body) -> ty-is-concrete-value body
    is TypeApply (body) (tyarg) -> ty-is-concrete-value body
    is otherwise -> False

  emit-bin-op : IRBinaryOp -> Text
  emit-bin-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "%"
    is IrPowInt -> "^"
    is IrEq -> "=="
    is IrNotEq -> "!="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq -> "=="
    is IrApproxEqExact -> "=="
    is IrAnd -> "&&"
    is IrOr -> "||"
    is IrAppendText -> "+"
    is IrAppendList -> "+"
    is IrConsList -> "+"

  emit-binary : IRBinaryOp, IRExpr, IRExpr, CodexType, CsCtx -> Text
  emit-binary (op) (l) (r) (ty) (ctx) =
   when op
    is IrAppendList -> "Enumerable.Concat(" & emit-expr l ctx & ", " & emit-expr r ctx & ").ToList()"
    is IrConsList -> "new List<" & cs-type (ir-expr-type l) & "> { " & emit-expr l ctx & " }.Concat(" & emit-expr r ctx & ").ToList()"
    is IrPowInt -> "((long)Math.Pow(" & emit-expr l ctx & ", " & emit-expr r ctx & "))"
    is IrAddVec | IrSubVec | IrMulVec | IrDivVec -> emit-expr l ctx & ".Zip(" & emit-expr r ctx & ", (a, b) => a " & emit-bin-op op & " b).ToList()"
    is otherwise -> "(" & emit-expr l ctx & " " & emit-bin-op op & " " & emit-expr r ctx & ")"

  has-typevar : CodexType -> Boolean
  has-typevar (ty) =
   when ty
    is TypeVar (id) -> True
    is ListTy (e) -> has-typevar e
    is LinkedListTy (e) -> has-typevar e
    is FunTy (p) (fnrow) (r) -> has-typevar p | has-typevar r
    is otherwise -> False

  cs-type-or-dynamic : CodexType -> Text
  cs-type-or-dynamic (ty) =
   if has-typevar ty then "var"
   else let t = cs-type ty
   in if t == "object" then "dynamic" else t

  LetBinding = record {

   name : Text,
   type-val : CodexType,
   val : IRExpr

  }

  LetChain = record {

   bindings : List LetBinding,
   body : IRExpr

  }

  collect-let-chain : IRExpr, List LetBinding -> LetChain
  collect-let-chain (expr) (acc) =
   when expr
    is IrLet (name) (ty) (val) (body) (sp) ->
     if let-chain-has-name acc name 0 (list-length acc)
      then LetChain {
       bindings = acc,
       body = expr
      }
      else collect-let-chain body (list-snoc acc (LetBinding {
       name = name,
       type-val = ty,
       val = val
      }))
    is otherwise -> LetChain {
     bindings = acc,
     body = expr
    }

  let-chain-has-name : List LetBinding, Text, Integer, Integer -> Boolean
  let-chain-has-name (bindings) (name) (i) (len) =
   if i == len then False
   else if (list-at bindings i).name == name then True
   else let-chain-has-name bindings name (i + 1) len

  emit-let-bindings-acc : List LetBinding, CsCtx, Integer, Integer, List Text -> List Text
  emit-let-bindings-acc (bindings) (ctx) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at bindings i
   in emit-let-bindings-acc bindings ctx (i + 1) len (list-snoc acc (cs-type-or-dynamic (b.type-val) & " " & sanitize (b.name) & " = " & emit-expr (b.val) ctx & "; "))

  emit-let : Text, CodexType, IRExpr, IRExpr, CsCtx -> Text
  emit-let (name) (ty) (val) (body) (ctx) =
   let chain = collect-let-chain body [LetBinding {
    name = name,
    type-val = ty,
    val = val
   }]
   in let ret-type = cs-type (ir-expr-type (chain.body))
   in let bindings-text = text-concat-list (emit-let-bindings-acc (chain.bindings) ctx 0 (list-length (chain.bindings)) [])
   in "((Func<" & ret-type & ">)(() => { " & bindings-text & "return " & emit-expr (chain.body) ctx & "; }))()"

 C# cannot INVOKE a lambda expression: `((x) => x + 1)(n)` is CS0149, method
 name expected, because a lambda has no type until it is converted to a
 delegate. The wire applies a lambda directly at its definition site, so the
 cast is not optional here. One cast on the outside is enough for a curried
 chain, since each inner lambda is then in a context that already expects a
 `Func<>` and converts by inference; `cs-type` spells `FunTy` curried already.

  emit-lambda : List IRParam, IRExpr, CodexType, CsCtx -> Text
  emit-lambda (params) (body) (ty) (ctx) =
   let raw = if list-length params == 0 then "(() => " & emit-expr body ctx & ")"
             else "(" & emit-lambda-params params 0 (list-length params) & emit-expr body ctx & ")"
   in if has-typevar ty then raw else "((" & cs-type ty & ")" & raw & ")"

  emit-lambda-params : List IRParam, Integer, Integer -> Text
  emit-lambda-params (params) (i) (len) =
   if i == len then ""
   else let p = list-at params i
    in "(" & sanitize (p.name) & ") => " & emit-lambda-params params (i + 1) len

  ty-has-tvar : CodexType -> Boolean
  ty-has-tvar (ty) =
   when ty
    is TypeVar (id) -> True
    is ListTy (e) -> ty-has-tvar e
    is LinkedListTy (e) -> ty-has-tvar e
    is VectorTy (vn) (vt) -> ty-has-tvar vt
    is FunTy (p) (fnrow) (r) -> ty-has-tvar p | ty-has-tvar r
    is ConstructedTy (nm) (as) -> ty-args-have-tvar as 0
    is SumTy (nm) (as) (cs) -> ty-args-have-tvar as 0
    is RecordTy (nm) (as) (fs) -> ty-args-have-tvar as 0
    is LinearTy (b) -> ty-has-tvar b
    is ForAllTy (id) (b) -> ty-has-tvar b
    is ForAllEff (id) (b) -> ty-has-tvar b
    is EffectfulTy (es) (sc) (r) -> ty-has-tvar r
    is otherwise -> False

  ty-args-have-tvar : List CodexType, Integer -> Boolean
  ty-args-have-tvar (as) (i) =
   if i >= list-length as then False
   else if ty-has-tvar (list-at as i) then True
   else ty-args-have-tvar as (i + 1)

 C# target-typed new: `new()` takes its type from the assignment, argument
 or cast around it, so it supplies an element type the IR does not carry.
 `__record-set` names its field with a text literal, which gives the type
 checker nothing to unify an empty list against, and the IR spells those
 ten sites `(list-expr (elems) error)`.

 A non-empty list carries the same unsubstituted-tvar defect as the apply
 node above: `collision-set-loop` is generic over tvar 39, its one element
 is typed 39, and the list says tvar 9. Where the recorded element type
 mentions a type variable the element's own type is the substituted one;
 where it does not, the recorded type is kept, so a list of constructors
 still widens to its declared sum type.

  emit-list : List IRExpr, CodexType, CsCtx -> Text
  emit-list (elems) (ty) (ctx) =
   if list-length elems == 0 then (when ty is ErrorTy -> "new()" is otherwise -> "new List<" & cs-type ty & ">()")
   else let et = if ty-has-tvar ty then ir-expr-type (list-at elems 0) else ty
   in "new List<" & cs-type et & "> { " & emit-list-elems elems 0 ctx & " }"

  emit-list-elems : List IRExpr, Integer, CsCtx -> Text
  emit-list-elems (elems) (i) (ctx) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-expr (list-at elems i) ctx
   else emit-expr (list-at elems i) ctx & ", " & emit-list-elems elems (i + 1) ctx

  emit-match : IRExpr, List IRBranch, CodexType, CsCtx -> Text
  emit-match (scrut) (branches) (ty) (ctx) =
   let result-cast = if has-typevar ty then "" else "(" & cs-type ty & ")"
   in let arms = emit-match-arms branches 0 ctx result-cast
   in let needs-wild = if (has-any-catch-all branches 0) | (cs-bool-exhaustive branches) then False else True
   in let scrut-ty = ir-expr-type scrut
   in let scrut-text = when scrut-ty
      is SumTy (sn) (sa) (sc) -> "((" & cs-type scrut-ty & ")(" & emit-expr scrut ctx & "))"
      is otherwise -> emit-expr scrut ctx
   in scrut-text & " switch { " & arms & (if needs-wild then "_ => throw new InvalidOperationException(\"Non-exhaustive match\"), " else "") & "}"

  cs-guard-trivial : IRExpr -> Boolean
  cs-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  emit-match-arms : List IRBranch, Integer, CsCtx, Text -> Text
  emit-match-arms (branches) (i) (ctx) (result-cast) =
   if i == list-length branches then ""
   else let arm = list-at branches i
   in let guard-clause = if cs-guard-trivial (arm.guard) then "" else " when " & emit-expr (arm.guard) ctx
   in let this-arm = emit-pattern (arm.pattern) & guard-clause & " => " & result-cast & "(" & emit-expr (arm.body) ctx & "), "
   in if is-catch-all (arm.pattern) & cs-guard-trivial (arm.guard) then this-arm
        else this-arm & emit-match-arms branches (i + 1) ctx result-cast

  is-catch-all : IRPat -> Boolean
  is-catch-all (p) =
   when p
    is IrWildPat (sp) -> True
    is IrVarPat (name) (ty) (sp) -> True
    is otherwise -> False

  is-tup-pattern : IRPat -> Boolean
  is-tup-pattern (p) =
   when p
    is IrCtorPat (name) (subs) (ty) (sp) -> is-mktup-name name
    is otherwise -> False

  has-any-catch-all : List IRBranch, Integer -> Boolean
  has-any-catch-all (branches) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if (is-catch-all (b.pattern) | is-tup-pattern (b.pattern)) & cs-guard-trivial (b.guard) then True
      else has-any-catch-all branches (i + 1)

 C# treats `true` and `false` as exhausting `bool`, so a trailing `_` arm
 after both is not dead code it will tolerate: it is CS8510, an error
 rather than a warning. Codex reaches this shape whenever a `when` on a
 Boolean names both arms, so the synthetic non-exhaustive arm has to be
 withheld exactly there. Only trivially-guarded arms count, because a
 guarded `is True` can fail at runtime and leave the match open.

  cs-pat-is-bool-lit : IRPat, Text -> Boolean
  cs-pat-is-bool-lit (p) (want) =
   when p
    is IrLitPat (text) (ty) (sp) -> text == want
    is otherwise -> False

  cs-has-bool-lit : List IRBranch, Text, Integer -> Boolean
  cs-has-bool-lit (branches) (want) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if cs-pat-is-bool-lit (b.pattern) want & cs-guard-trivial (b.guard) then True
      else cs-has-bool-lit branches want (i + 1)

  cs-bool-exhaustive : List IRBranch -> Boolean
  cs-bool-exhaustive (branches) =
   (cs-has-bool-lit branches "True" 0) & (cs-has-bool-lit branches "False" 0)

 A Boolean IrLitPat carries the SPELLING `True` or `False` rather than a
 number, and C# spells its Boolean keywords in lower case, so the wire's
 text cannot be emitted verbatim: `True` is an identifier there and the
 compiler answers CS0103. Bare metal decodes the same two spellings in
 `pat-lit-to-integer` (`codex/compiler/Syntax/Token.codex:149`); this is
 that decode for a target whose literals are words instead of integers.

  cs-bool-lit-text : Text -> Text
  cs-bool-lit-text (t) =
   if t == "True" then "true"
   else if t == "False" then "false"
   else t

  emit-pattern : IRPat -> Text
  emit-pattern (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> cs-type ty & " " & sanitize name
    is IrLitPat (text) (ty) (sp) -> cs-bool-lit-text text
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then "(" & emit-sub-patterns subs 0 & ")"
     else if list-length subs == 0 then sanitize name & extract-ctor-type-args ty & " { }"
      else sanitize name & extract-ctor-type-args ty & "(" & emit-sub-patterns subs 0 & ")"
    is IrWildPat (sp) -> "_"
    is IrVecPat (pats) (ty) (sp) -> "_"

  emit-sub-patterns : List IRPat, Integer -> Text
  emit-sub-patterns (subs) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in emit-sub-pattern sub & (if i < list-length subs - 1 then ", " else "") & emit-sub-patterns subs (i + 1)

  emit-sub-pattern : IRPat -> Text
  emit-sub-pattern (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> "var " & sanitize name
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-pattern p
    is IrWildPat (sp) -> "_"
    is IrLitPat (text) (ty) (sp) -> cs-bool-lit-text text
    is IrVecPat (pats) (ty) (sp) -> "_"

  emit-cs-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, CodexType, CsCtx -> Text
  emit-cs-try (max) (body) (fb) (fail-stmts) (ty) (ctx) =
   let body-text = emit-act body ty ctx
   in let fb-text = emit-act fb ty ctx
   in let fail-text = emit-act fail-stmts ty ctx
   in "((Func<" & cs-type ty & ">)(() => { var _try_ok = false; " & cs-type ty & " _try_result = default; for (var _try_i = 0; _try_i < " & integer-to-text max & "; _try_i++) { try { _try_result = " & body-text & "; _try_ok = true; break; } catch {} } if (_try_ok) return _try_result; try { return " & fb-text & "; } catch { return " & fail-text & "; } }))()"

  emit-act : List IRActStmt, CodexType, CsCtx -> Text
  emit-act (stmts) (ty) (ctx) =
   let actual-ty = when ty
    is EffectfulTy (effs) (sc) (ret) -> ret
    is otherwise -> ty
   in let ret-type = cs-type actual-ty
   in let len = list-length stmts
   in when actual-ty
    is VoidTy -> "((Func<object>)(() => { " & emit-act-stmts stmts 0 len False ctx & " return null; }))()"
    is NothingTy -> "((Func<object>)(() => { " & emit-act-stmts stmts 0 len False ctx & " return null; }))()"
    is ProofTy -> "((Func<object>)(() => { " & emit-act-stmts stmts 0 len False ctx & " return null; }))()"
    is PropEqTy (pl) (pr) -> "((Func<object>)(() => { " & emit-act-stmts stmts 0 len False ctx & " return null; }))()"
    is ErrorTy -> "((Func<object>)(() => { " & emit-act-stmts stmts 0 len False ctx & " return null; }))()"
    is otherwise -> if len == 0 then "((Func<" & ret-type & ">)(() => { return null; }))()"
    else "((Func<" & ret-type & ">)(() => { " & emit-act-stmts stmts 0 len True ctx & " }))()"

  emit-act-stmts : List IRActStmt, Integer, Integer, Boolean, CsCtx -> Text
  emit-act-stmts (stmts) (i) (len) (needs-return) (ctx) =
   if i == len then ""
   else let s = list-at stmts i
   in let is-last = i == len - 1
   in let use-return = if is-last then needs-return else False
   in emit-act-stmt s use-return ctx & " " & emit-act-stmts stmts (i + 1) len needs-return ctx

  is-irif-expr : IRExpr -> Boolean
  is-irif-expr (e) =
   when e
    is IrIf (c) (th) (el) (t) (s) -> True
    is otherwise -> False

  emit-act-stmt : IRActStmt, Boolean, CsCtx -> Text
  emit-act-stmt (s) (use-return) (ctx) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> cs-type-or-dynamic ty & " " & sanitize name & " = " & emit-expr val ctx & ";"
    is IrDoExec (e) (sp) ->
     if use-return then "return " & emit-expr e ctx & ";"
     else "_ = (" & emit-expr e ctx & ");"

  lookup-rec-field-ty : List RecordField, Text, Integer -> CodexType
  lookup-rec-field-ty (fields) (name) (i) =
   if i == list-length fields then ErrorTy
   else let f = list-at fields i
   in if f.name.value == name then f.type-val
      else lookup-rec-field-ty fields name (i + 1)

  cs-resolve-rec-fields : CsCtx, Name, List RecordField -> List RecordField
  cs-resolve-rec-fields (ctx) (rn) (rf) =
   if list-length rf > 0 then rf
   else record-fields-by-name (ctx.type-defs) (rn.value) 0

  clamp-field-val : CsCtx, CodexType, Text, Text -> Text
  clamp-field-val (ctx) (rec-ty) (field-name) (val-text) =
   when rec-ty
    is RecordTy (rn) (ra) (rf) ->
     let ft = lookup-rec-field-ty (cs-resolve-rec-fields ctx rn rf) field-name 0
     in when ft
      is IntegerTy (lo) (hi) (mode) ->
       when mode
        is OvClamping -> "Math.Clamp(" & val-text & ", " & integer-to-text lo & "L, " & integer-to-text hi & "L)"
        is otherwise -> val-text
      is otherwise -> val-text
    is otherwise -> val-text

  emit-record : Text, List IRFieldVal, CodexType, CsCtx -> Text
  emit-record (name) (fields) (ty) (ctx) =
   emit-ctor-upcast name ty (emit-record-fields fields 0 ctx ty)

  emit-record-fields : List IRFieldVal, Integer, CsCtx, CodexType -> Text
  emit-record-fields (fields) (i) (ctx) (rec-ty) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let val-text = emit-expr (f.value) ctx
   in let clamped = clamp-field-val ctx rec-ty (f.name) val-text
   in sanitize (f.name) & ": " & clamped & (if i < list-length fields - 1 then ", " else "") & emit-record-fields fields (i + 1) ctx rec-ty

  emit-handle : Text, IRExpr, List IRHandleClause, CodexType, CsCtx -> Text
  emit-handle (eff) (body) (clauses) (ty) (ctx) =
   let ret-type = cs-type ty
   in "((Func<" & ret-type & ">)(() => { " & emit-handle-clauses clauses ret-type ctx & "return " & emit-expr body ctx & "; }))()"

  emit-handle-clauses : List IRHandleClause, Text, CsCtx -> Text
  emit-handle-clauses (clauses) (ret-type) (ctx) =
   emit-handle-clauses-loop clauses 0 ret-type ctx

  emit-handle-clauses-loop : List IRHandleClause, Integer, Text, CsCtx -> Text
  emit-handle-clauses-loop (clauses) (i) (ret-type) (ctx) =
   if i == list-length clauses then ""
   else let c = list-at clauses i
   in let body-to-emit = unwrap-cs-clause-lambda (c.body) (list-length (c.params))
   in "Func<Func<" & ret-type & ", " & ret-type & ">, " & ret-type & "> _handle_" & sanitize (c.op-name) & "_ = (" & sanitize (c.resume-name) & ") => { return " & emit-expr body-to-emit ctx & "; }; " & emit-handle-clauses-loop clauses (i + 1) ret-type ctx

  unwrap-cs-clause-lambda : IRExpr, Integer -> IRExpr
  unwrap-cs-clause-lambda (e) (n) =
   if n == 0 then e
   else when e
    is IrLambda (ps) (b) (t) (s) -> b
    is otherwise -> e

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

