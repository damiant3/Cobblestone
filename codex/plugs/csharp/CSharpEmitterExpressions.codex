Chapter: CSharp Emitter

  cites Foreword chapter Sort
  cites Foreword chapter RankedTextSet

Section: Identifier Helpers

  cs-keywords-1 : RankedTextSet
  cs-keywords-1 =
   ranked-text-from-list ["abstract", "as", "base", "bool", "break",
    "case", "catch", "class", "continue", "decimal",
    "default", "delegate", "do", "double", "else",
    "event", "false", "finally", "for", "if",
    "in", "int", "internal", "is", "long"]

  cs-keywords-2 : RankedTextSet
  cs-keywords-2 =
   ranked-text-from-list ["namespace", "new", "null", "object", "out",
    "override", "params", "private", "protected", "public",
    "ref", "return", "sealed", "static", "string",
    "switch", "this", "throw", "true", "try",
    "typeof", "using", "virtual", "void", "while"]

  cs-keywords-3 : RankedTextSet
  cs-keywords-3 =
   ranked-text-from-list ["byte", "char", "checked", "const", "enum",
    "explicit", "extern", "fixed", "float", "foreach",
    "goto", "implicit", "interface", "lock", "operator",
    "readonly", "sbyte", "short", "sizeof", "stackalloc",
    "struct", "uint", "ulong", "unchecked", "unsafe",
    "ushort", "volatile"]

  is-cs-keyword : Text -> Boolean
  is-cs-keyword (n) =
   if ranked-text-has cs-keywords-1 n then True
   else if ranked-text-has cs-keywords-2 n then True
   else ranked-text-has cs-keywords-3 n

  sanitize : Text -> Text
  sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-cs-keyword s then "@" & s
      else if is-cs-member-name s then s & "_"
              else s

  cs-member-names : RankedTextSet = ranked-text-from-list ["Equals", "GetHashCode", "GetType", "MemberwiseClone", "ToString"]

  is-cs-member-name : Text -> Boolean
  is-cs-member-name (n) = ranked-text-has cs-member-names n

  cs-type : CodexType -> Text
  cs-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "long"
    is RealTy (w) (m) -> "double"
    is TextTy -> "string"
    is BooleanTy -> "bool"
    is CharTy -> "long"
    is VoidTy -> "void"
    is UnitTy (name) (inner) -> "void"
    is NothingTy -> "object"
    is ProofTy -> "object"
    is PropEqTy (pl) (pr) -> "object"
    is ErrorTy -> "object"
    is FunTy (p) (fnrow) (r) -> "Func<" & cs-type p & ", " & cs-type r & ">"
    is ListTy (elem) -> "List<" & cs-type elem & ">"
    is LinkedListTy (elem) -> "List<" & cs-type elem & ">"
    is TypeVar (id) -> "T" & integer-to-text id
    is ForAllTy (id) (body) -> cs-type body
    is ForAllEff (id) (body) -> cs-type body
    is LinearTy (body) -> cs-type body
    is TypeApply (body) (tyarg) -> cs-type body
    is SumTy (name) (ty-args) (ctors) -> if list-length ty-args == 0 then sanitize (name.value)
                                          else sanitize (name.value) & "<" & emit-cs-type-args ty-args 0 & ">"
    is RecordTy (name) (ty-args) (fields) -> if list-length ty-args > 0 then sanitize (name.value) & "<" & emit-cs-type-args ty-args 0 & ">"
                                              else sanitize (name.value) & extract-ctor-type-args ty
    is ConstructedTy (name) (args) -> if is-tup-type (name.value) then "(" & emit-cs-type-args args 0 & ")"
                                     else if list-length args == 0 then sanitize (name.value)
                                     else sanitize (name.value) & "<" & emit-cs-type-args args 0 & ">"
    is VectorTy (vn) (vt) -> "List<" & cs-type vt & ">"
    is VectorMaskTy (vn) -> "List<bool>"
    is TypeCon (name) -> sanitize (name.value)
    is EffectfulTy (effects) (sc) (ret) -> cs-type ret

  emit-cs-type-args : List CodexType, Integer -> Text
  emit-cs-type-args (args) (i) =
   if i == list-length args then ""
   else let t = cs-type (list-at args i)
   in if i == list-length args - 1 then t
      else t & ", " & emit-cs-type-args args (i + 1)

Section: Arity Map

  ArityEntry = record {

   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255

  }

  CsCtx = record {
   arities : List ArityEntry,
   type-defs : List ATypeDef,
   locals : List Text,
   dyn-locals : List Text
  }

  name-in-list : List Text, Text, Integer -> Boolean
  name-in-list (xs) (n) (i) =
   if i >= list-length xs then False
   else if list-at xs i == n then True
   else name-in-list xs n (i + 1)

  param-names : List IRParam, Integer, List Text -> List Text
  param-names (ps) (i) (acc) =
   if i >= list-length ps then acc
   else param-names ps (i + 1) (list-snoc acc ((list-at ps i).name))

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = __narrow (list-length (collect-type-var-ids (d.type-val) []))
   }))

 Streaming variants: build the arity map and find the entry return type
 straight from the raw def S-expressions, reading only each def's
 signature (name xs[1], params xs[3], return type xs[4]) - never the
 body xs[5]. This lets the plug emit defs one at a time without ever
 materializing the whole IRChapter (2295 IRDefs blew the 2GB heap).

 Accumulate with list-push (O(1) amortized, array-backed) then sort
 once with sort-by - NOT sorted-insert-arity per def. sorted-insert
 calls list-insert-at, a persistent-cons splice that recurses to the
 insert position rebuilding the prefix with & and list-tail; none of
 it is heap-restored here, so over 2295 defs it is O(n^2)+ permanent
 allocation that fills the heap and corrupts a live sum-tag, yielding
 a wild jump-table dispatch (EXC=06) ~600 defs in. list-push + one
 sort-by is O(n log n) and allocates nothing past the array.

 In-place insertion sort of the arity entries by name, reusing Sort's
 sort-swap (list-set-at mutation - allocates nothing). We do NOT use
 sort-by here: its helper returns the generic record SortPartition, and a
 bare `-> SortPartition` return type carries no type args/fields, so the
 emitter can't recover `<T>` and emits an unparameterized generic. A
 monomorphic sort sidesteps that. O(n^2) time on ~2300 entries is trivial
 and, being in-place + tail-recursive, costs no heap and no stack growth.

  arity-sink : List ArityEntry, Integer -> List ArityEntry
  arity-sink (xs) (j) =
   if j <= 0 then xs
   else if text-compare ((list-at xs (j - 1)).name) ((list-at xs j).name) <= 0 then xs
   else arity-sink (sort-swap xs (j - 1) j) (j - 1)

  arity-sort : List ArityEntry, Integer, Integer -> List ArityEntry
  arity-sort (xs) (i) (n) =
   if i >= n then xs
   else arity-sort (arity-sink xs i) (i + 1) n

  build-arity-map-sexp : List SExp, Integer, Integer, List ArityEntry -> List ArityEntry
  build-arity-map-sexp (def-sexps) (i) (n) (acc) =
   if i >= n then arity-sort acc 1 (list-length acc)
   else let xs = sexp-list (list-at def-sexps i)
   in build-arity-map-sexp def-sexps (i + 1) n (list-push acc (ArityEntry {
    name = sexp-str (list-at xs 1),
    arity = __narrow (list-length (sexp-list (list-at xs 3)) - 1),
    generic-count = __narrow (list-length (collect-type-var-ids (ir-parse-type (list-at xs 4)) []))
   }))

  opening-return-type-sexp : List SExp, Integer, Integer -> CodexType
  opening-return-type-sexp (def-sexps) (i) (n) =
   if i >= n then NothingTy
   else let xs = sexp-list (list-at def-sexps i)
   in if sexp-str (list-at xs 1) == opening-entry-point
      then strip-fun-args (ir-parse-type (list-at xs 4))
      else opening-return-type-sexp def-sexps (i + 1) n

  build-arity-map-from-ast : List ADef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map-from-ast (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map-from-ast defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name.value,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

  lookup-generic-count : List ArityEntry, Text -> Integer
  lookup-generic-count (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0
      else let e = list-at entries pos
      in if e.name == name then e.generic-count else 0

Section: Raw Reference Builtins

  RawBuiltin = record {

   name : Text,
   emission : Text

  }

  bsearch-raw-pos : List RawBuiltin, Text, Integer, Integer -> Integer
  bsearch-raw-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-raw-pos entries name lo mid
      else bsearch-raw-pos entries name (mid + 1) hi

  sort-raw-builtins : List RawBuiltin -> List RawBuiltin
  sort-raw-builtins (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  raw-builtins : List RawBuiltin = sort-raw-builtins [

   RawBuiltin { name = "read-line", emission = "((Maybe<string>)(Console.ReadLine() switch { null => new None<string>(), var _s => new Just<string>(_Cce.FromUnicode(_s)) }))" },
   RawBuiltin { name = "get-args", emission = "_Cce.FromUnicodeArr(Environment.GetCommandLineArgs())" },
   RawBuiltin { name = "current-dir", emission = "_Cce.FromUnicode(Directory.GetCurrentDirectory())" },
   RawBuiltin { name = "__heap-save", emission = "_Buf.heap_save()" },
   RawBuiltin { name = "__heap-restore", emission = "new Func<object, long>(_p => _Buf.heap_restore(_p))" },
   RawBuiltin { name = "__heap-advance", emission = "new Func<object, long>(_n => _Buf.heap_advance(_n))" },
   RawBuiltin { name = "__deck-pos", emission = "_Buf.deck_pos()" },
   RawBuiltin { name = "__deck-set", emission = "new Func<object, long>(_p => _Buf.deck_set(_p))" },
   RawBuiltin { name = "__deck-alloc", emission = "new Func<object, long>(_n => _Buf.deck_alloc(_n))" },
   RawBuiltin { name = "__deck-enter", emission = "_Buf.deck_enter()" },
   RawBuiltin { name = "__deck-exit", emission = "_Buf.deck_exit()" },
   RawBuiltin { name = "__list-with-capacity", emission = "new Func<object, List<long>>(_c => _Buf.list_with_capacity(_c))" },
   RawBuiltin { name = "__buf-write-byte", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _v => _Buf.buf_write_byte(_b, _o, _v))" },
   RawBuiltin { name = "__buf-write-bytes", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _vs => _Buf.buf_write_bytes(_b, _o, _vs))" },
   RawBuiltin { name = "__buf-read-bytes", emission = "new Func<object, Func<object, Func<object, List<long>>>>(_b => _o => _n => _Buf.buf_read_bytes(_b, _o, _n))" },
   RawBuiltin { name = "get-state", emission = "_State.get_state" },
   RawBuiltin { name = "__self-type-defs", emission = "new List<TypeBinding>()" },
   RawBuiltin { name = "ir-text", emission = "\"\"" },
   RawBuiltin { name = "lens-sql-exec", emission = "new Func<string, List<List<string>>>(_q => _Cce.FromUnicodeRows(_LensSql.exec(_Cce.ToUnicode(_q))))" },
   RawBuiltin { name = "lens-http-next", emission = "new Func<long, List<string>>(_p => _Cce.FromUnicodeList(_LensHttp.next(_p)))" },
   RawBuiltin { name = "lens-http-reply", emission = "new Func<long, Func<string, long>>(_p => _b => _LensHttp.reply(_p, _Cce.ToUnicode(_b)))" },
   RawBuiltin { name = "lens-http-reply-html", emission = "new Func<long, Func<string, long>>(_p => _b => _LensHttp.reply_html(_p, _Cce.ToUnicode(_b)))" },
   RawBuiltin { name = "process-get-pid", emission = "((long)Environment.ProcessId)" },
   RawBuiltin { name = "block-sector-count", emission = "0L" },
   RawBuiltin { name = "print-text", emission = "new Func<string, object>(_t => { Console.Write(_Cce.ToUnicode(_t)); return null; })" },
   RawBuiltin { name = "raw-bytes-to-text", emission = "new Func<object, string>(_bs => _Cce.RawBytesToText(_bs))" },
   RawBuiltin { name = "alloc-bytes", emission = "new Func<object, long>(_n => _Buf.alloc_bytes(_n))" },
   RawBuiltin { name = "peek-32", emission = "new Func<object, Func<object, long>>(_b => _o => _Buf.peek_32(_b, _o))" },
   RawBuiltin { name = "poke-32", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _v => _Buf.poke_32(_b, _o, _v))" },
   RawBuiltin { name = "peek-16", emission = "new Func<object, Func<object, long>>(_b => _o => _Buf.peek_16(_b, _o))" },
   RawBuiltin { name = "poke-16", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _v => _Buf.poke_16(_b, _o, _v))" },
   RawBuiltin { name = "poke-byte", emission = "new Func<object, Func<object, Func<object, long>>>(_b => _o => _v => _Buf.poke_byte(_b, _o, _v))" },
   RawBuiltin { name = "__memset", emission = "new Func<object, Func<object, Func<object, object>>>(_b => _v => _n => _Buf.memset(_b, _v, _n))" },
   RawBuiltin { name = "write-binary-buf", emission = "new Func<object, Func<object, Func<object, object>>>(_b => _o => _n => _Buf.write_binary_buf(_b, _o, _n))" },
   RawBuiltin { name = "port-out-byte", emission = "new Func<long, Func<long, long>>(_p => _v => 0L)" },
   RawBuiltin { name = "port-in-byte", emission = "new Func<long, long>(_p => 0L)" },
   RawBuiltin { name = "process-get-scope", emission = "new Func<long, string>(_pid => \"\")" },
   RawBuiltin { name = "prof-start", emission = "new Func<long, long>(_n => 0L)" },
   RawBuiltin { name = "prof-dump", emission = "new Func<long, long>(_n => 0L)" }

  ]

  lookup-raw-builtin : Text -> Text
  lookup-raw-builtin (name) =
   let len = list-length raw-builtins
   in let pos = bsearch-raw-pos raw-builtins name 0 len
   in if pos >= len then ""
      else let e = list-at raw-builtins pos
      in if e.name == name then e.emission else ""

Section: Platform Seam Overrides

  seam-override-names : List Text = ["lens-sql-exec", "lens-http-next", "lens-http-reply", "lens-http-reply-html"]

  seam-override-loop : Text, Integer, Integer -> Boolean
  seam-override-loop (n) (i) (len) =
   if i >= len then False
   else if list-at seam-override-names i == n then True
   else seam-override-loop n (i + 1) len

  is-seam-override : Text -> Boolean
  is-seam-override (n) = seam-override-loop n 0 (list-length seam-override-names)

Section: Apply Chain

  is-upper-letter : Char -> Boolean
  is-upper-letter (c) =
   let code = char-code c
   in code >= char-code 'E' & code <= char-code 'Z'

  emit-apply-args : List IRExpr, CsCtx, Integer -> Text
  emit-apply-args (args) (ctx) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-expr (list-at args i) ctx
        else emit-expr (list-at args i) ctx & ", " & emit-apply-args args ctx (i + 1)

  emit-partial-params : Integer, Integer -> Text
  emit-partial-params (i) (count) =
   if i == count then ""
   else if i == count - 1 then "_p" & integer-to-text i & "_"
        else "_p" & integer-to-text i & "_" & ", " & emit-partial-params (i + 1) count

  emit-partial-wrappers : Integer, Integer -> Text
  emit-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & integer-to-text i & "_) => " & emit-partial-wrappers (i + 1) count

  BuiltinEmitter = record {

   name : Text,
   emit : List IRExpr, CsCtx, CodexType -> Text

  }

  bsearch-emitter-pos : List BuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-emitter-pos entries name lo mid
      else bsearch-emitter-pos entries name (mid + 1) hi

  sort-emitters : List BuiltinEmitter -> List BuiltinEmitter
  sort-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  builtin-emitters : List BuiltinEmitter = sort-emitters [

   BuiltinEmitter { name = "show", emit = \args -> \ctx -> \ty -> emit-builtin-show args ctx },
   BuiltinEmitter { name = "negate", emit = \args -> \ctx -> \ty -> "(-" & emit-expr (list-at args 0) ctx & ")" },
   BuiltinEmitter { name = "print-line-uni", emit = \args -> \ctx -> \ty -> emit-builtin-print-line-uni args ctx },
   BuiltinEmitter { name = "print-error-uni", emit = \args -> \ctx -> \ty -> emit-builtin-print-error-uni args ctx },
   BuiltinEmitter { name = "text-length", emit = \args -> \ctx -> \ty -> "((long)" & emit-expr (list-at args 0) ctx & ".Length)" },
   BuiltinEmitter { name = "is-letter", emit = \args -> \ctx -> \ty -> emit-builtin-is-letter args ctx },
   BuiltinEmitter { name = "is-digit", emit = \args -> \ctx -> \ty -> emit-builtin-is-digit args ctx },
   BuiltinEmitter { name = "is-whitespace", emit = \args -> \ctx -> \ty -> "(" & emit-expr (list-at args 0) ctx & " is >= 1L and <= 2L)" },
   BuiltinEmitter { name = "text-to-integer", emit = \args -> \ctx -> \ty -> emit-builtin-text-to-integer args ctx },
   BuiltinEmitter { name = "text-to-double-bits", emit = \args -> \ctx -> \ty -> emit-builtin-text-to-double-bits args ctx },
   BuiltinEmitter { name = "integer-to-text", emit = \args -> \ctx -> \ty -> emit-builtin-integer-to-text args ctx },
   BuiltinEmitter { name = "char-code", emit = \args -> \ctx -> \ty -> emit-expr (list-at args 0) ctx },
   BuiltinEmitter { name = "char-code-at", emit = \args -> \ctx -> \ty -> emit-builtin-char-code-at args ctx },
   BuiltinEmitter { name = "code-to-char", emit = \args -> \ctx -> \ty -> emit-expr (list-at args 0) ctx },
   BuiltinEmitter { name = "to-unicode", emit = \args -> \ctx -> \ty -> emit-expr (list-at args 0) ctx },
   BuiltinEmitter { name = "from-unicode", emit = \args -> \ctx -> \ty -> emit-expr (list-at args 0) ctx },
   BuiltinEmitter { name = "char-to-text", emit = \args -> \ctx -> \ty -> "((char)" & emit-expr (list-at args 0) ctx & ").ToString()" },
   BuiltinEmitter { name = "char-encode", emit = \args -> \ctx -> \ty -> "_CxText.CharEncode(" & emit-expr (list-at args 0) ctx & ")" },
   BuiltinEmitter { name = "list-length", emit = \args -> \ctx -> \ty -> "((long)" & emit-expr (list-at args 0) ctx & ".Count)" },
   BuiltinEmitter { name = "char-at", emit = \args -> \ctx -> \ty -> emit-builtin-char-at args ctx },
   BuiltinEmitter { name = "substring", emit = \args -> \ctx -> \ty -> emit-builtin-substring args ctx },
   BuiltinEmitter { name = "list-at", emit = \args -> \ctx -> \ty -> emit-builtin-list-at args ctx },
   BuiltinEmitter { name = "list-insert-at", emit = \args -> \ctx -> \ty -> emit-builtin-list-insert-at args ctx },
   BuiltinEmitter { name = "list-set-at", emit = \args -> \ctx -> \ty -> emit-builtin-list-set-at args ctx },
   BuiltinEmitter { name = "list-snoc", emit = \args -> \ctx -> \ty -> emit-builtin-list-snoc args ctx },
   BuiltinEmitter { name = "text-compare", emit = \args -> \ctx -> \ty -> emit-builtin-text-compare args ctx },
   BuiltinEmitter { name = "text-replace", emit = \args -> \ctx -> \ty -> emit-builtin-text-replace args ctx },
   BuiltinEmitter { name = "open-file", emit = \args -> \ctx -> \ty -> "File.OpenRead(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & "))" },
   BuiltinEmitter { name = "read-all", emit = \args -> \ctx -> \ty -> emit-builtin-read-all args ctx },
   BuiltinEmitter { name = "close-file", emit = \args -> \ctx -> \ty -> emit-expr (list-at args 0) ctx & ".Dispose()" },
   BuiltinEmitter { name = "read-line", emit = \args -> \ctx -> \ty -> "((Maybe<string>)(Console.ReadLine() switch { null => new None<string>(), var _s => new Just<string>(_Cce.FromUnicode(_s)) }))" },
   BuiltinEmitter { name = "read-text", emit = \args -> \ctx -> \ty -> emit-builtin-read-file args ctx },
   BuiltinEmitter { name = "write-file", emit = \args -> \ctx -> \ty -> emit-builtin-write-file args ctx },
   BuiltinEmitter { name = "write-binary", emit = \args -> \ctx -> \ty -> "_Buf.write_binary(" & emit-expr (list-at args 0) ctx & ")" },
   BuiltinEmitter { name = "file-exists", emit = \args -> \ctx -> \ty -> emit-builtin-file-exists args ctx },
   BuiltinEmitter { name = "list-files", emit = \args -> \ctx -> \ty -> emit-builtin-list-files args ctx },
   BuiltinEmitter { name = "list-directories", emit = \args -> \ctx -> \ty -> "_Cce.FromUnicodeArr(Directory.GetDirectories(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & ")))" },
   BuiltinEmitter { name = "write-binary-file", emit = \args -> \ctx -> \ty -> "((Func<object>)(() => { List<long> _bl = (List<long>)" & emit-expr (list-at args 1) ctx & "; byte[] _ba = new byte[_bl.Count]; for (int _i = 0; _i < _bl.Count; _i++) _ba[_i] = (byte)_bl[_i]; File.WriteAllBytes(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & "), _ba); return null; }))()" },
   BuiltinEmitter { name = "create-directory", emit = \args -> \ctx -> \ty -> "((Func<object>)(() => { Directory.CreateDirectory(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & ")); return null; }))()" },
   BuiltinEmitter { name = "path-combine", emit = \args -> \ctx -> \ty -> "_Cce.FromUnicode(Path.Combine(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & "), _Cce.ToUnicode(" & emit-expr (list-at args 1) ctx & ")))" },
   BuiltinEmitter { name = "path-filename", emit = \args -> \ctx -> \ty -> "_Cce.FromUnicode(Path.GetFileName(_Cce.ToUnicode(" & emit-expr (list-at args 0) ctx & ")))" },
