Chapter: CSharp Syntax
  cites Foreword chapter Maybe

Section: Types

  CstType =
    | CstNamedType (Text) (List CstType)
    | CstArrayType (CstType) (Integer)
    | CstNullableType (CstType)
    | CstAliasType (Text) (CstType)
    | CstInferredType

  CstModifier = CstPublic | CstPrivate | CstInternal | CstProtected
    | CstStatic | CstReadonly | CstConst | CstSealed | CstPartial
    | CstVirtual | CstOverride | CstAbstract | CstExtern | CstUnsafe
    | CstAsync | CstNew | CstRef | CstOut | CstIn | CstParams

  CstUnaryOp = CstNot | CstNegate | CstPositive | CstComplement
    | CstPreIncrement | CstPreDecrement | CstPostIncrement | CstPostDecrement

  CstBinaryOp = CstAdd | CstSubtract | CstMultiply | CstDivide | CstRemainder
    | CstEqual | CstNotEqual | CstLess | CstLessEqual | CstGreater | CstGreaterEqual
    | CstAnd | CstOr | CstBitAnd | CstBitOr | CstBitXor | CstShiftLeft | CstShiftRight
    | CstCoalesce

  CstAssignOp = CstAssign | CstAddAssign | CstSubtractAssign | CstMultiplyAssign
    | CstDivideAssign | CstAndAssign | CstOrAssign | CstXorAssign

  CstNumberKind = CstInt | CstUInt | CstLong | CstULong | CstFloat | CstDouble | CstDecimal

Section: Expressions

  CstExpr =
    | CstName (Text) (List CstType)
    | CstString (Text)
    | CstCharacter (Integer)
    | CstNumber (Text) (CstNumberKind)
    | CstBoolean (Boolean)
    | CstNull
    | CstThis
    | CstBase
    | CstMemberAccess (CstExpr) (Text) (List CstType)
    | CstCall (CstExpr) (List CstArgument)
    | CstIndex (CstExpr) (List CstArgument)
    | CstObjectNew (CstType) (List CstArgument) (List CstExpr)
    | CstArrayNew (CstType) (List CstExpr) (List CstExpr) (Boolean)
    | CstImplicitArray (List CstExpr)
    | CstInitializer (List CstExpr)
    | CstUnary (CstUnaryOp) (CstExpr)
    | CstBinary (CstBinaryOp) (CstExpr) (CstExpr)
    | CstAssignment (CstAssignOp) (CstExpr) (CstExpr)
    | CstConditional (CstExpr) (CstExpr) (CstExpr)
    | CstCast (CstType) (CstExpr)
    | CstAs (CstExpr) (CstType)
    | CstIs (CstExpr) (CstType)
    | CstTypeOf (CstType)
    | CstTypeReference (CstType)
    | CstDefault (CstType)
    | CstChecked (Boolean) (CstExpr)
    | CstLambda (List CstParameter) (CstExpr)
    | CstLambdaBlock (List CstParameter) (CstStmt)
    | CstParenthesized (CstExpr)

  CstArgument = record {
    ca-mode : List CstModifier,
    ca-name : Text,
    ca-value : CstExpr
  }

  CstParameter = record {
    cp-modifiers : List CstModifier,
    cp-type : CstType,
    cp-name : Text,
    cp-default : Maybe CstExpr
  }

  CstVariable = record { cv-name : Text, cv-value : Maybe CstExpr }

Section: Statements

  CstStmt =
    | CstBlock (List CstStmt)
    | CstExpression (CstExpr)
    | CstVariables (List CstModifier) (CstType) (List CstVariable)
    | CstReturn (Maybe CstExpr)
    | CstThrow (Maybe CstExpr)
    | CstIf (CstExpr) (CstStmt) (Maybe CstStmt)
    | CstFor (CstStmt) (Maybe CstExpr) (List CstExpr) (CstStmt)
    | CstForEach (CstType) (Text) (CstExpr) (CstStmt)
    | CstWhile (CstExpr) (CstStmt)
    | CstDo (CstStmt) (CstExpr)
    | CstUsing (CstStmt) (CstStmt)
    | CstTry (CstStmt) (List CstCatch) (Maybe CstStmt)
    | CstSwitch (CstExpr) (List CstSwitchSection)
    | CstBreak
    | CstContinue
    | CstEmpty

  CstCatch = record {
    cc-type : Maybe CstType,
    cc-name : Text,
    cc-filter : Maybe CstExpr,
    cc-body : CstStmt
  }

  CstSwitchSection = record {
    cs-labels : List (Maybe CstExpr),
    cs-body : List CstStmt
  }

Section: Declarations

  CstAttribute = record { cat-type : CstType, cat-args : List CstExpr }

  CstConstraint = CstClassConstraint | CstStructConstraint | CstNewConstraint | CstTypeConstraint (CstType)

  CstTypeParameter = record { ctp-name : Text, ctp-constraints : List CstConstraint }

  CstMethodSpec = record {
    cm-attributes : List CstAttribute,
    cm-modifiers : List CstModifier,
    cm-result : CstType,
    cm-name : Text,
    cm-type-params : List CstTypeParameter,
    cm-params : List CstParameter,
    cm-body : Maybe CstStmt
  }

  CstConstructorSpec = record {
    cctor-modifiers : List CstModifier,
    cctor-name : Text,
    cctor-params : List CstParameter,
    cctor-body : CstStmt
  }

  CstClassHead = record {
    ch-modifiers : List CstModifier,
    ch-name : Text,
    ch-bases : List CstType
  }

  CstMember =
    | CstField (List CstAttribute) (List CstModifier) (CstType) (List CstVariable)
    | CstMethod (CstMethodSpec)
    | CstConstructor (CstConstructorSpec)
    | CstDelegate (CstMethodSpec)
    | CstClass (CstClassHead) (List CstMember)
    | CstNamespace (Text) (List CstMember)
    | CstUsingNamespace (Text)
    | CstUsingAlias (Text) (CstType)
