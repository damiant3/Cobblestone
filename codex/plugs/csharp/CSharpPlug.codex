Section: Helpers



  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Streaming Send

 Stream C# one def at a time to the output ring (print-uni, fire-and-
 forget) reclaiming the per-def parse + emit heap with __heap-restore
 between defs. Each def's IRDef is parsed from its raw S-expression only
 when it is emitted, so the whole IRChapter is never materialized.

  stream-defs-sexp : List SExp, CsCtx, Integer, Integer -> [Console] Nothing
  stream-defs-sexp (def-sexps) (ctx) (i) (n) =
   if i >= n then print-uni ""
   else let h = __heap-save
   in let cs = emit-def (parse-def (list-at def-sexps i)) ctx
   in act
    print-uni cs
    print-uni "\n"
    let restored = __heap-restore h
    in stream-defs-sexp def-sexps ctx (i + 1) n
   end

Section: Mutable Record Detection

 The wire carries the `mutable` marker as of 2026-08-08, and this plug
 deliberately does not read it. The set that must be settable in C# is
 derived from a STRICTER authority than the source marker: x86-64's
 `emit-field-store` writes destructively for every `field-store` node,
 so a record type that receives one must be assignable here to mean the
 same thing. A record declared `mutable` that is never stored to needs
 no settable field, and taking the marker instead would widen every such
 record for nothing. Read the store's own type slot, which lowering
 fills with the deep-resolved receiver type.

  collect-mut-names : List SExp, Integer, Integer, List Text -> List Text
  collect-mut-names (xs) (i) (n) (acc) =
   if i >= n then acc
   else collect-mut-names xs (i + 1) n (collect-mut-names-in (list-at xs i) acc)

  collect-mut-names-in : SExp, List Text -> List Text
  collect-mut-names-in (e) (acc) =
   when e
    is SList (xs) ->
     let acc1 = if list-length xs >= 5 then
                 (if sexp-atom (list-at xs 0) == "field-store" then push-store-ty (list-at xs 4) acc else acc)
                else acc
     in let acc2 = if is-record-set-apply xs then push-store-ty (sexp-last (list-at xs 2)) acc1 else acc1
     in collect-mut-names xs 0 (list-length xs) acc2
    is otherwise -> acc

  is-record-set-apply : List SExp -> Boolean
  is-record-set-apply (xs) =
   if list-length xs /= 4 then False
   else if sexp-atom (list-at xs 0) /= "apply" then False
   else let f = list-at xs 1
   in if sexp-head f /= "name" then False
      else sexp-str (list-at (sexp-list f) 1) == "__record-set"

  sexp-last : SExp -> SExp
  sexp-last (e) =
   let xs = sexp-list e
   in if list-length xs == 0 then e else list-at xs (list-length xs - 1)

  push-store-ty : SExp, List Text -> List Text
  push-store-ty (ty) (acc) =
   let h = sexp-head ty
   in if h == "record-ty" | h == "ctd" then
       let nm = sexp-str (list-at (sexp-list ty) 1)
       in if text-length nm == 0 then acc
          else if name-in-list acc nm 0 then acc
          else list-push acc nm
      else acc

Section: Drain

  drain-wait : TcpTransportState, Integer -> [Network.Read] Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else act
    frame <- ne2k-recv-frame
    if list-length frame == 0 then drain-wait ts (tries + 1)
    else 0
   end

Section: Body

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9107 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let ir-text = bytes-to-text (recv.body) 0 (list-length (recv.body))
     in let tokens = tokenize ir-text
     in let tree = build-tree tokens
     in let xs = sexp-list tree
     in let chap-name = sexp-str (list-at xs 1)
     in let type-defs = parse-atype-defs (walk-named-list xs "type-defs")
     in let def-sexps = walk-named-list xs "defs"
     in let n = list-length def-sexps
     in let arities = build-arity-map-sexp def-sexps 1 n []
     in let muts = collect-mut-names def-sexps 1 n []
      in let ctx = CsCtx { arities = arities, type-defs = type-defs, locals = [] }
     in let class-name = "Codex_" & sanitize chap-name
     in act
      print-uni (render-usings [cs-using "System", cs-using "System.Collections.Generic", cs-using "System.IO", cs-using "System.Linq", cs-using "System.Threading.Tasks"] 0 5 "")
      print-uni "\n"
      print-uni (opening-emit-entry class-name (opening-return-type-sexp def-sexps 1 n))
      print-uni emit-cce-runtime
      print-uni emit-buf-runtime
      print-uni emit-state-runtime
      print-uni (emit-seam-runtimes arities)
      print-uni (emit-type-defs type-defs 0 muts)
      print-uni (emit-class-header chap-name)
      stream-defs-sexp def-sexps ctx 1 n
      print-uni "}\n"
      closed <- net-io-close (recv.transport)
      print-uni ""
     end
    else print-line-uni "FAIL"
   end

