Chapter: CSharpPlug
  cites Net chapter NetIO
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Kernel chapter Ne2k
  cites Foreword chapter CCE

 Plug entry. Connects to host TCP server on port 9100,
 receives IR text, runs the C# emitter, sends C# source back.

Section: Helpers



  text-to-bytes : Text, Integer, Integer, List Integer -> List Integer
  text-to-bytes (s) (off) (total) (acc) =
   if off >= total then acc
   else let stop = if off + 256 > total then total else off + 256
   in let chunk = text-to-bytes-chunk s off stop []
   in text-to-bytes s stop total (acc & chunk)

  bytes-to-text-chunk : List Integer, Integer, Integer, List Text -> List Text
  bytes-to-text-chunk (bs) (i) (stop) (acc) =
   if i >= stop then acc
   else bytes-to-text-chunk bs (i + 1) stop (list-push acc (char-to-text (code-to-char (list-at bs i))))

 Convert the received IR byte list to text. Each 256-byte chunk's chars
 are collected in a list and joined once (text-concat-list), and the
 chunks themselves are collected and joined once -- O(n) total. The old
 `acc & chunk` accumulator was O(n^2) and hung on the ~9.7MB compiler IR
 before the plug emitted anything.

  bytes-to-text-chunks : List Integer, Integer, Integer, List Text -> List Text
  bytes-to-text-chunks (bs) (off) (total) (acc) =
   if off >= total then acc
   else let stop = if off + 256 > total then total else off + 256
   in let chunk = text-concat-list (bytes-to-text-chunk bs off stop [])
   in bytes-to-text-chunks bs stop total (list-push acc chunk)

  bytes-to-text : List Integer, Integer, Integer -> Text
  bytes-to-text (bs) (off) (total) =
   text-concat-list (bytes-to-text-chunks bs off total [])

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Streaming Send



  stream-defs : TcpTransportState, List IRDef, List ArityEntry, Integer, Integer -> [Network.Write] TcpTransportState
  stream-defs (ts) (defs) (arities) (i) (n) =
   if i >= n then ts
   else let cs = emit-def (list-at defs i) arities
   in act
    ts1 <- net-io-send-text ts (cs & "\n")
    stream-defs ts1 defs arities (i + 1) n
   end

 Stream C# one def at a time to the output ring (print-uni, fire-and-
 forget) reclaiming the per-def parse + emit heap with __heap-restore
 between defs. Each def's IRDef is parsed from its raw S-expression only
 when it is emitted, so the whole IRChapter is never materialized.

  stream-defs-sexp : List SExp, List ArityEntry, Integer, Integer -> [Console] Nothing
  stream-defs-sexp (def-sexps) (arities) (i) (n) =
   if i >= n then print-uni ""
   else let h = __heap-save
   in let cs = emit-def (parse-def (list-at def-sexps i)) arities
   in act
    print-uni cs
    print-uni "\n"
    let restored = __heap-restore h
    in stream-defs-sexp def-sexps arities (i + 1) n
   end

Section: Drain

  drain-wait : TcpTransportState, Integer -> [Network.Read] Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else act
    frame <- ne2k-recv-frame
    if list-length frame == 0 then drain-wait ts (tries + 1)
    else 0
   end

Section: Body

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9100 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let ir-text = bytes-to-text (recv.body) 0 (list-length (recv.body))
     in let tokens = tokenize ir-text
     in let tree = build-tree tokens
     in let xs = sexp-list tree
     in let chap-name = sexp-str (list-at xs 1)
     in let type-defs = parse-atype-defs (walk-named-list xs "type-defs")
     in let def-sexps = walk-named-list xs "defs"
     in let n = list-length def-sexps
     in let arities = build-arity-map-sexp def-sexps 1 n []
     in let class-name = "Codex_" & sanitize chap-name
     in act
      print-uni (render-usings [cs-using "System", cs-using "System.Collections.Generic", cs-using "System.IO", cs-using "System.Linq", cs-using "System.Threading.Tasks"] 0 5 "")
      print-uni "\n"
      print-uni (opening-emit-entry class-name (opening-return-type-sexp def-sexps 1 n))
      print-uni emit-cce-runtime
      print-uni emit-buf-runtime
      print-uni emit-state-runtime
      print-uni (emit-seam-runtimes arities)
      print-uni (emit-type-defs type-defs 0)
      print-uni (emit-class-header chap-name)
      stream-defs-sexp def-sexps arities 1 n
      print-uni "}\n"
      closed <- net-io-close (recv.transport)
      print-uni ""
     end
    else print-line-uni "FAIL"
   end

