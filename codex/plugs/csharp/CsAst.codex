Chapter: CsAst

 A small C# abstract syntax tree. Instead of concatenating raw C#
 strings, the plug builds a tree of named constructs -- usings, a
 namespace, classes, fields, methods, and parameters -- and a walker
 renders it. Method bodies and the IR-transpiled members remain raw C#
 text (the IR expression emitter produces those, and modelling every
 statement/expression is a separate, larger effort). This gives the file
 scaffolding and the runtime/WPF builtins a proper representation rather
 than a wall of string literals.

 We say:

Section: Nodes

  CsUsing = record { ns : Text }

  CsParam = record {
    ptype : Text,
    pname : Text,
    default-val : Text
  }

  CsField = record {
    modifiers : Text,
    ftype : Text,
    fname : Text,
    finit : Text
  }

  CsMethod = record {
    modifiers : Text,
    ret-type : Text,
    mname : Text,
    params : List CsParam,
    body : Text
  }

  CsClass = record {
    modifiers : Text,
    cname : Text,
    base-type : Text,
    fields : List CsField,
    methods : List CsMethod,
    raw-members : Text
  }

  CsFile = record {
    usings : List CsUsing,
    ns-name : Text,
    classes : List CsClass
  }

Section: Constructors

  cs-using : Text -> CsUsing
  cs-using (n) = CsUsing { ns = n }

  cs-param : Text, Text -> CsParam
  cs-param (t) (n) = CsParam { ptype = t, pname = n, default-val = "" }

  cs-param-def : Text, Text, Text -> CsParam
  cs-param-def (t) (n) (d) = CsParam { ptype = t, pname = n, default-val = d }

  cs-field : Text, Text, Text, Text -> CsField
  cs-field (m) (t) (n) (init) = CsField { modifiers = m, ftype = t, fname = n, finit = init }

  cs-method : Text, Text, Text, List CsParam, Text -> CsMethod
  cs-method (m) (r) (n) (ps) (b) = CsMethod { modifiers = m, ret-type = r, mname = n, params = ps, body = b }

Section: Rendering -- Indentation

  cs-ind : Integer -> Text
  cs-ind (n) = if n <= 0 then "" else "    " & cs-ind (n - 1)

Section: Rendering -- Usings

  render-usings : List CsUsing, Integer, Integer, Text -> Text
  render-usings (us) (i) (len) (acc) =
    if i >= len then acc
    else render-usings us (i + 1) len (acc & "using " & (list-at us i).ns & ";\n")

Section: Rendering -- Params

  render-param : CsParam -> Text
  render-param (p) =
    if text-length (p.default-val) > 0 then p.ptype & " " & p.pname & " = " & p.default-val
    else p.ptype & " " & p.pname

  render-params : List CsParam, Integer, Integer, Text -> Text
  render-params (ps) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i > 0 then ", " else ""
    in render-params ps (i + 1) len (acc & sep & render-param (list-at ps i))

Section: Rendering -- Fields

  render-field : CsField, Integer -> Text
  render-field (f) (depth) =
    let init = if text-length (f.finit) > 0 then " = " & f.finit else ""
    in cs-ind depth & f.modifiers & " " & f.ftype & " " & f.fname & init & ";\n"

  render-fields : List CsField, Integer, Integer, Integer, Text -> Text
  render-fields (fs) (i) (len) (depth) (acc) =
    if i >= len then acc
    else render-fields fs (i + 1) len depth (acc & render-field (list-at fs i) depth)

Section: Rendering -- Methods

  render-method : CsMethod, Integer -> Text
  render-method (m) (depth) =
    cs-ind depth & m.modifiers & " " & m.ret-type & " " & m.mname & "("
      & render-params (m.params) 0 (list-length (m.params)) "" & ") {\n"
      & m.body
      & cs-ind depth & "}\n\n"

  render-methods : List CsMethod, Integer, Integer, Integer, Text -> Text
  render-methods (ms) (i) (len) (depth) (acc) =
    if i >= len then acc
    else render-methods ms (i + 1) len depth (acc & render-method (list-at ms i) depth)

Section: Rendering -- Class and File

  render-class : CsClass, Integer -> Text
  render-class (c) (depth) =
    let base = if text-length (c.base-type) > 0 then " : " & c.base-type else ""
    in cs-ind depth & c.modifiers & " class " & c.cname & base & "\n" & cs-ind depth & "{\n"
      & render-fields (c.fields) 0 (list-length (c.fields)) (depth + 1) ""
      & render-methods (c.methods) 0 (list-length (c.methods)) (depth + 1) ""
      & c.raw-members
      & cs-ind depth & "}\n"

  render-classes : List CsClass, Integer, Integer, Integer, Text -> Text
  render-classes (cs) (i) (len) (depth) (acc) =
    if i >= len then acc
    else render-classes cs (i + 1) len depth (acc & render-class (list-at cs i) depth)

  render-cs-file : CsFile -> Text
  render-cs-file (f) =
    render-usings (f.usings) 0 (list-length (f.usings)) ""
      & "\nnamespace " & f.ns-name & "\n{\n"
      & render-classes (f.classes) 0 (list-length (f.classes)) 1 ""
      & "}\n"
