   },
   PlBuiltinEmitter {
     name = "char-encode",
     emit = \args arities -> "_cx_char_encode(" & emit-pl-expr (list-at args 0) arities & ")"
   },
   PlBuiltinEmitter {
     name = "code-to-char",
     emit = \args arities -> emit-pl-expr (list-at args 0) arities
   },
   PlBuiltinEmitter {
     name = "char-to-text",
     emit = \args arities -> "chr(" & emit-pl-expr (list-at args 0) arities & ")"
   },
   PlBuiltinEmitter {
     name = "fail",
     emit = \args arities -> "die(" & emit-pl-expr (list-at args 0) arities & " . \"\\n\")"
   },
   PlBuiltinEmitter {
     name = "int-mod",
     emit = \args arities -> "(" & emit-pl-expr (list-at args 0) arities & " % abs(" & emit-pl-expr (list-at args 1) arities & "))"
   },
   PlBuiltinEmitter {
     name = "integer-to-text",
     emit = \args arities -> "\"\" . " & emit-pl-expr (list-at args 0) arities
   },
   PlBuiltinEmitter {
     name = "is-digit",
     emit = \args arities -> "(sub { my $c = $_[0]; $c >= 3 && $c <= 12 ? 1 : 0 })->(" & emit-pl-expr (list-at args 0) arities & ")"
   },
   PlBuiltinEmitter {
     name = "is-whitespace",
     emit = \args arities -> "(sub { my $c = $_[0]; $c >= 1 && $c <= 2 ? 1 : 0 })->(" & emit-pl-expr (list-at args 0) arities & ")"
   },
   PlBuiltinEmitter {
     name = "is-letter",
     emit = \args arities -> "(sub { my $c = $_[0]; ($c >= 13 && $c <= 64) || ($c >= 97 && $c <= 127) ? 1 : 0 })->(" & emit-pl-expr (list-at args 0) arities & ")"
   },
   PlBuiltinEmitter {
     name = "list-at",
     emit = \args arities -> emit-pl-expr (list-at args 0) arities & "->[" & emit-pl-expr (list-at args 1) arities & "]"
   },
   PlBuiltinEmitter {
     name = "list-insert-at",
     emit = \args arities -> "(sub { my ($l, $i, $v) = @_; splice(@$l, $i, 0, $v); $l })->(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "list-set-at",
     emit = \args arities -> "(sub { my ($l, $i, $v) = @_; $l->[$i] = $v; $l })->(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "list-snoc",
