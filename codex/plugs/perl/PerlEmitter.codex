   PlBuiltinEmitter {
     name = "write-file",
     emit = \args arities -> "(sub { open my $fh, '>', " & emit-pl-expr (list-at args 0) arities & "; print $fh " & emit-pl-expr (list-at args 1) arities & " })->()"
   }
  ]

  pl-show : IRExpr, List ArityEntry -> Text
  pl-show (e) (arities) =
    when pl-base-ty (ir-expr-type e)
     is BooleanTy -> "(" & emit-pl-expr e arities & " ? \"True\" : \"False\")"
     is RealTy (w) (m) -> "_cx_real_show(" & emit-pl-expr e arities & ")"
     is otherwise -> "\"\" . " & emit-pl-expr e arities

  is-pl-builtin-name : Text -> Boolean
  is-pl-builtin-name (n) =
    let len = list-length pl-builtin-emitters
    in let pos = bsearch-pl-emitter-pos pl-builtin-emitters n 0 len
    in if pos >= len then False
    else (list-at pl-builtin-emitters pos).name == n

  pl-try-builtin : Text, List IRExpr, List ArityEntry -> Text
  pl-try-builtin (n) (args) (arities) =
    let len = list-length pl-builtin-emitters
    in let pos = bsearch-pl-emitter-pos pl-builtin-emitters n 0 len
    in if pos >= len then ""
    else let entry = list-at pl-builtin-emitters pos
    in if entry.name == n then entry.emit args arities
    else ""

Section: Definition Emission

  emit-pl-def : IRDef, List ArityEntry -> Text
  emit-pl-def (d) (arities) =
    let name = pl-sanitize (d.name)
    in "sub " & name & " {\n    my (" & emit-pl-lambda-params (d.params) 0 & ") = @_;\n    " & emit-pl-expr (d.body) (pl-with-locals (d.params) 0 arities) & "\n}\n\n"

  emit-pl-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-pl-defs (defs) (i) (arities) =
    if i == list-length defs then ""
    else emit-pl-def (list-at defs i) arities & emit-pl-defs defs (i + 1) arities

Section: Chapter Emission

 Perl promotes an integer past 2^63 to an unsigned and then to a double, so
 neither arm of the overflow contract holds natively. `use integer` wraps in
 two's complement, which is the band; the trap computes the same wrapped
 value and tests its sign, and the multiply also tests the quotient and the
 two -1 cases, because integer division wraps INT_MIN / -1 back to INT_MIN.
 It exits instead of dying: `try` lowers to eval, which would catch a die,
 and an x86-64 overflow trap is not a failure a try can recover.

  pl-int-helpers : Text
  pl-int-helpers =
    text-concat-list [
      "sub _cx_add_wrap { use integer; return $_[0] + $_[1]; }\n",
      "sub _cx_sub_wrap { use integer; return $_[0] - $_[1]; }\n",
      "sub _cx_mul_wrap { use integer; return $_[0] * $_[1]; }\n",
      "sub _cx_trap { print STDERR \"CODEX_TRAP_integer_overflow\\n\"; exit 255; }\n",
      "sub _cx_add_trap { my ($x, $y) = @_; my $w; { use integer; $w = $x + $y; }\n",
      "  _cx_trap() if ($x >= 0) == ($y >= 0) && ($w >= 0) != ($x >= 0); return $w; }\n",
      "sub _cx_sub_trap { my ($x, $y) = @_; my $w; { use integer; $w = $x - $y; }\n",
      "  _cx_trap() if ($x >= 0) != ($y >= 0) && ($w >= 0) != ($x >= 0); return $w; }\n",
      "sub _cx_mul_trap { my ($x, $y) = @_; return 0 if $x == 0 || $y == 0;\n",
      "  my ($w, $q, $min); { use integer; $min = -9223372036854775807 - 1; $w = $x * $y; $q = $w / $y; }\n",
      "  _cx_trap() if ($x == -1 && $y == $min) || ($y == -1 && $x == $min) || $q != $x; return $w; }\n",
      "sub _cx_ipow { my ($a, $b) = @_; return 0 if $b < 0; use integer; my $r = 1;\n",
      "  while ($b > 0) { $r *= $a if $b & 1; $b >>= 1; $a *= $a if $b > 0; } return $r; }\n",
      "sub _cx_bit_and { use integer; return $_[0] & $_[1]; }\n",
      "sub _cx_bit_or { use integer; return $_[0] | $_[1]; }\n",
      "sub _cx_bit_xor { use integer; return $_[0] ^ $_[1]; }\n",
      "sub _cx_bit_not { use integer; return ~$_[0]; }\n",
      "sub _cx_bit_shl { use integer; return $_[0] << $_[1]; }\n",
      "sub _cx_bit_shr { use integer; return $_[0] >> $_[1]; }\n",
      "sub _cx_bit_shru { my ($a, $b) = @_; return $a if $b == 0; return (($a & ~0) >> $b); }\n",
      "sub _cx_char_encode { my $c = int($_[0]); return chr($c) if $c < 128;\n",
      "  if ($c < 2176) { my $v = $c - 128; return chr(192 | ($v >> 6)) . chr(128 | ($v & 63)); }\n",
      "  if ($c < 67712) { my $v = $c - 2176; return chr(224 | ($v >> 12)) . chr(128 | (($v >> 6) & 63)) . chr(128 | ($v & 63)); }\n",
      "  my $v = $c - 67712; return chr(240 | ($v >> 18)) . chr(128 | (($v >> 12) & 63)) . chr(128 | (($v >> 6) & 63)) . chr(128 | ($v & 63)); }\n",
      pl-real-helpers,
      pl-heap-helpers
    ]

 A byte buffer lives in one perl string, `$_cx_mem`, addressed from 4096 so
 that 0 stays the null address; `alloc-bytes` bumps `$_cx_hp` by the request
 rounded up to 8 and zero-fills, as bare metal's bump allocator does. Every
 peek zero-extends, as bare metal's do.

  pl-heap-helpers : Text
  pl-heap-helpers =
    text-concat-list [
      "my $_cx_mem = \"\\0\" x 4096; my $_cx_hp = 4096;\n",
      "sub _cx_want { my $e = $_[0]; $_cx_mem .= \"\\0\" x ($e - length($_cx_mem)) if $e > length($_cx_mem); }\n",
      "sub alloc_bytes { my $a = $_cx_hp; $_cx_hp += ($_[0] + 7) & ~7; _cx_want($_cx_hp); return $a; }\n",
      "sub poke_byte { my ($b, $o, $v) = @_; _cx_want($b + $o + 1); substr($_cx_mem, $b + $o, 1) = chr($v & 255); return 0; }\n",
      "sub peek_byte { my ($b, $o) = @_; _cx_want($b + $o + 1); return ord(substr($_cx_mem, $b + $o, 1)); }\n",
      "sub poke_16 { my ($b, $o, $v) = @_; _cx_want($b + $o + 2); substr($_cx_mem, $b + $o, 2) = pack('v', $v & 0xFFFF); return 0; }\n",
      "sub peek_16 { my ($b, $o) = @_; _cx_want($b + $o + 2); return unpack('v', substr($_cx_mem, $b + $o, 2)); }\n",
      "sub poke_32 { my ($b, $o, $v) = @_; _cx_want($b + $o + 4); substr($_cx_mem, $b + $o, 4) = pack('V', $v & 0xFFFFFFFF); return 0; }\n",
      "sub peek_32 { my ($b, $o) = @_; _cx_want($b + $o + 4); return unpack('V', substr($_cx_mem, $b + $o, 4)); }\n",
      "sub poke_qword { my ($b, $o, $v) = @_; _cx_want($b + $o + 8); substr($_cx_mem, $b + $o, 8) = pack('q<', $v); return 0; }\n",
      "sub peek_qword { my ($b, $o) = @_; _cx_want($b + $o + 8); return unpack('q<', substr($_cx_mem, $b + $o, 8)); }\n",
      "sub _cx_buf_read_bytes { my ($b, $o, $n) = @_; _cx_want($b + $o + $n); return [map { ord(substr($_cx_mem, $b + $o + $_, 1)) } 0 .. $n - 1]; }\n",
      "sub _cx_buf_write_bytes { my ($b, $o, $xs) = @_; my $n = scalar(@$xs); _cx_want($b + $o + $n); for my $i (0 .. $n - 1) { substr($_cx_mem, $b + $o + $i, 1) = chr($xs->[$i] & 255); } return $o + $n; }\n",
      "sub _cx_vec_load { my ($b, $f) = @_; _cx_want($b + 16); return [unpack($f, substr($_cx_mem, $b, 8)), unpack($f, substr($_cx_mem, $b + 8, 8))]; }\n",
      "sub _cx_record_set { my ($r, $f, $v) = @_; $f =~ s{/.*}{}; $f =~ tr/-/_/; $r->{$f} = $v; return $r; }\n"
    ]

 A Real is a perl NV, an f64; a Real approximate is the NV rounded to f32
 (`pack 'f<'`). The rules are x86-64's: `real-to-int` is cvttsd2si, which
 answers INT64_MIN for a NaN, an infinity or anything out of range;
 `real-approx-from-int` goes through f64 as cvtsi2sd + cvtsd2ss do; an f32
 pattern is zero-extended as movd leaves it. A trapping Real traps when its
 result is not finite, a saturating one answers the largest finite value of
 its width for an infinity and 0 for a NaN. `~` and `~0` compare ULP distance
 on the monotonic ordinal (`emit-approx-eq`), tolerance 4 and 0. `show`
 prints the integer part, a point and up to 15 fractional digits, trailing
 zeros dropped and one kept, the sign from the sign bit.

  pl-real-helpers : Text
  pl-real-helpers =
    text-concat-list [
      "sub _cx_bits_to_real { return unpack('d<', pack('q<', $_[0])); }\n",
      "sub bits_to_real { return _cx_bits_to_real($_[0]); }\n",
      "sub real_to_bits { return unpack('q<', pack('d<', $_[0])); }\n",
      "sub to_real_approx { return unpack('f<', pack('f<', $_[0])); }\n",
      "sub bits_to_real_approx { return unpack('f<', pack('L<', $_[0] & 0xFFFFFFFF)); }\n",
      "sub real_approx_to_bits { return unpack('L<', pack('f<', $_[0])); }\n",
      "sub real_to_int { my $v = $_[0]; return -9223372036854775807 - 1 if $v != $v || $v >= 9223372036854775808.0 || $v < -9223372036854775808.0; return int($v); }\n",
      "sub real_approx_to_int { return real_to_int($_[0]); }\n",
      "sub real_from_int { return $_[0] * 1.0; }\n",
      "sub real_approx_from_int { return to_real_approx($_[0] * 1.0); }\n",
      "sub from_real_approx { return $_[0]; }\n",
      "sub to_real_trapping { return $_[0]; }\n",
      "sub from_real_trapping { return $_[0]; }\n",
      "sub to_real_saturating { return $_[0]; }\n",
      "sub from_real_saturating { return $_[0]; }\n",
      "sub to_real_approx_trapping { return $_[0]; }\n",
      "sub from_real_approx_trapping { return $_[0]; }\n",
      "sub to_real_approx_saturating { return $_[0]; }\n",
      "sub from_real_approx_saturating { return $_[0]; }\n",
      "sub text_to_double_bits { my $s = $_[0]; my $neg = substr($s, 0, 1) eq '-' ? 1 : 0; my $r = $neg ? substr($s, 1) : $s;\n",
      "  return $neg ? -9223372036854775807 - 1 : 0 if $r !~ /[1-9]/; no warnings; return real_to_bits(($neg ? -1 : 1) * ($r + 0)); }\n",
      "sub _cx_fdiv { my ($a, $b) = @_; return $a / $b if $b != 0; my $inf = 9**9**9; return $inf - $inf if $a != $a || $a == 0;\n",
      "  my $nb = (unpack('Q<', pack('d<', $b)) >> 63); return (($a < 0 ? 1 : 0) ^ $nb) ? -$inf : $inf; }\n",
      "sub _cx_real_trap { my $v = $_[0]; if ($v != $v || $v - $v != 0) { print STDERR \"CODEX_TRAP_real_not_finite\\n\"; exit 255; } return $v; }\n",
      "sub _cx_real_sat { my ($v, $w32) = @_; return 0.0 if $v != $v; return $v if $v - $v == 0;\n",
      "  my $m = $w32 ? 3.4028234663852886e38 : 1.7976931348623157e308; return $v > 0 ? $m : -$m; }\n",
      "sub _cx_real_ordinal { my ($v, $w32) = @_; use integer;\n",
      "  my $x = $w32 ? (unpack('L<', pack('f<', $v)) << 32) : unpack('q<', pack('d<', $v));\n",
      "  my $t = $x >> 63; my $o = ($x ^ ($t ? 9223372036854775807 : 0)) - $t; return $w32 ? ($o >> 32) : $o; }\n",
      "sub _cx_real_near { my ($a, $b, $w32, $tol) = @_; use integer;\n",
      "  my $d = _cx_real_ordinal($a, $w32) - _cx_real_ordinal($b, $w32); $d = -$d if $d < 0; return ($d >= 0 && $d <= $tol) ? 1 : 0; }\n",
      "sub _cx_real_show { my $v = $_[0]; my $neg = (unpack('Q<', pack('d<', $v)) >> 63) ? '-' : '';\n",
      "  my $e = abs($v); my $acc = int($e); my $s = real_to_int($acc); my $f = $e - $acc; my $d = ''; my $last = 0;\n",
      "  for my $k (1..15) { $f *= 10.0; my $x = int($f); $f -= $x; $d .= $x; $last = $k if $x != 0; }\n",
      "  return $neg . $s . '.' . ($last ? substr($d, 0, $last) : '0'); }\n"
    ]

  emit-perl-chapter : IRChapter, List ATypeDef -> Text
  emit-perl-chapter (m) (type-defs) =
    let arities = build-ctor-arities type-defs 0 (build-arity-map (m.defs) 0 [])
    in let header = "use strict;\nuse warnings;\nuse feature 'say';\n\nsub list_snoc { my ($xs, $v) = @_; if (@$xs) { push @$xs, $v; return $xs; } return [$v]; }\nsub list_push { my ($xs, $v) = @_; return list_snoc($xs, $v); }\nsub text_starts_with { my ($s, $p) = @_; return substr($s, 0, length($p)) eq $p; }\nsub text_split { my ($s, $sep) = @_; return [$s] if length($sep) == 0; my @p = split(/\\Q$sep\\E/, $s, -1); return \\@p; }\nsub _cx_text_replace { my ($s, $a, $b) = @_; return $s if length($a) == 0; my $r = ''; my $i = 0; while ($i < length($s)) { if (substr($s, $i, length($a)) eq $a) { $r .= $b; $i += length($a); } else { $r .= substr($s, $i, 1); $i += 1; } } return $r; }\n\n"
    in let types-text = emit-pl-type-defs type-defs 0
    in let defs-text = emit-pl-defs (m.defs) 0 arities
    in let entry = pl-emit-entry (m.defs)
    in header & pl-int-helpers & types-text & defs-text & entry

  emit-perl-chapter-stream-head : IRChapter, List ATypeDef -> Text
  emit-perl-chapter-stream-head (m) (type-defs) =
    let arities = build-ctor-arities type-defs 0 (build-arity-map (m.defs) 0 [])
    in let header = "use strict;\nuse warnings;\nuse feature 'say';\n\nsub list_snoc { my ($xs, $v) = @_; if (@$xs) { push @$xs, $v; return $xs; } return [$v]; }\nsub list_push { my ($xs, $v) = @_; return list_snoc($xs, $v); }\nsub text_starts_with { my ($s, $p) = @_; return substr($s, 0, length($p)) eq $p; }\nsub text_split { my ($s, $sep) = @_; return [$s] if length($sep) == 0; my @p = split(/\\Q$sep\\E/, $s, -1); return \\@p; }\nsub _cx_text_replace { my ($s, $a, $b) = @_; return $s if length($a) == 0; my $r = ''; my $i = 0; while ($i < length($s)) { if (substr($s, $i, length($a)) eq $a) { $r .= $b; $i += length($a); } else { $r .= substr($s, $i, 1); $i += 1; } } return $r; }\n\n"
    in let types-text = emit-pl-type-defs type-defs 0
    in let entry = pl-emit-entry (m.defs)
    in header & pl-int-helpers & types-text

  emit-perl-chapter-stream-tail : IRChapter, List ATypeDef -> Text
  emit-perl-chapter-stream-tail (m) (type-defs) =
    let arities = build-ctor-arities type-defs 0 (build-arity-map (m.defs) 0 [])
    in let header = "use strict;\nuse warnings;\nuse feature 'say';\n\nsub list_snoc { my ($xs, $v) = @_; if (@$xs) { push @$xs, $v; return $xs; } return [$v]; }\nsub list_push { my ($xs, $v) = @_; return list_snoc($xs, $v); }\nsub text_starts_with { my ($s, $p) = @_; return substr($s, 0, length($p)) eq $p; }\nsub text_split { my ($s, $sep) = @_; return [$s] if length($sep) == 0; my @p = split(/\\Q$sep\\E/, $s, -1); return \\@p; }\nsub _cx_text_replace { my ($s, $a, $b) = @_; return $s if length($a) == 0; my $r = ''; my $i = 0; while ($i < length($s)) { if (substr($s, $i, length($a)) eq $a) { $r .= $b; $i += length($a); } else { $r .= substr($s, $i, 1); $i += 1; } } return $r; }\n\n"
    in let types-text = emit-pl-type-defs type-defs 0
    in let entry = pl-emit-entry (m.defs)
    in entry

  emit-perl-chapter-stream-env : IRChapter, List ATypeDef -> List ArityEntry
  emit-perl-chapter-stream-env (m) (type-defs) =
    let arities = build-ctor-arities type-defs 0 (build-arity-map (m.defs) 0 [])
    in let header = "use strict;\nuse warnings;\nuse feature 'say';\n\nsub list_snoc { my ($xs, $v) = @_; if (@$xs) { push @$xs, $v; return $xs; } return [$v]; }\nsub list_push { my ($xs, $v) = @_; return list_snoc($xs, $v); }\nsub text_starts_with { my ($s, $p) = @_; return substr($s, 0, length($p)) eq $p; }\nsub text_split { my ($s, $sep) = @_; return [$s] if length($sep) == 0; my @p = split(/\\Q$sep\\E/, $s, -1); return \\@p; }\nsub _cx_text_replace { my ($s, $a, $b) = @_; return $s if length($a) == 0; my $r = ''; my $i = 0; while ($i < length($s)) { if (substr($s, $i, length($a)) eq $a) { $r .= $b; $i += length($a); } else { $r .= substr($s, $i, 1); $i += 1; } } return $r; }\n\n"
    in let types-text = emit-pl-type-defs type-defs 0
    in let entry = pl-emit-entry (m.defs)
    in arities

  emit-perl-chapter-stream-def : IRChapter, List ArityEntry, Integer -> Text
  emit-perl-chapter-stream-def (m) (v) (i) = emit-pl-def (list-at (m.defs) i) v

  pl-emit-entry : List IRDef -> Text
  pl-emit-entry (defs) = pl-emit-entry-loop defs 0

  pl-emit-entry-loop : List IRDef, Integer -> Text
  pl-emit-entry-loop (defs) (i) =
    if i >= list-length defs then ""
    else let d = list-at defs i
    in if d.name == opening-entry-point then
      if list-length (d.params) == 0 then pl-entry-call (pl-sanitize opening-entry-point & "()") (d.type-val) else ""
    else pl-emit-entry-loop defs (i + 1)

  pl-entry-call : Text, CodexType -> Text
  pl-entry-call (call) (ret) =
    when ret
     is EffectfulTy (effs) (scopes) (inner) -> pl-entry-call call inner
     is UnitTy (n) (inner) -> pl-entry-call call inner
     is IntegerTy (lo) (hi) (mode) -> "say(" & call & ");\n"
     is TextTy -> "say(" & call & ");\n"
     is BooleanTy -> "say(" & call & " ? \"True\" : \"False\");\n"
     is RealTy (w) (m) -> "say(_cx_real_show(" & call & "));\n"
     is otherwise -> call & ";\n"

