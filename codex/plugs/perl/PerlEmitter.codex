Chapter: Perl Emitter
  cites Foreword chapter Sort
  cites Foreword chapter CCE

Section: Keywords and Sanitization

  pl-keywords : List Text =
    ["chomp", "chop", "chr", "crypt", "die", "do", "dump", "each",
     "else", "elsif", "eval", "exec", "exit", "for", "foreach",
     "given", "goto", "grep", "if", "keys", "last", "length", "local",
     "map", "my", "next", "no", "our", "package", "print", "push",
     "redo", "require", "return", "say", "shift", "sort", "split",
     "sub", "unless", "until", "use", "values", "warn", "when", "while",
     "m", "q", "qq", "qr", "qw", "qx", "s", "tr", "y"]

  pl-is-keyword : Text, Integer -> Boolean
  pl-is-keyword (name) (i) =
    if i == list-length pl-keywords then False
    else if list-at pl-keywords i == name then True
    else pl-is-keyword name (i + 1)

  pl-sanitize : Text -> Text
  pl-sanitize (name) =
    let s0 = text-replace name "-" "_"
    in let s1 = text-replace (text-replace s0 "@" "_at_") "[" "_lb_"
    in let s = text-replace (text-replace (text-replace s1 "]" "_rb_") "," "_cm_") " " "_"
    in if pl-is-keyword s 0 then s & "_v"
    else s

 The IR spells a record field as `name/slot`. In a map-keyed target the
 slot lands INSIDE the key string, so the lookup misses silently rather
 than dividing; the key has to be the bare name.

  pl-slash-pos : Text, Integer, Integer -> Integer
  pl-slash-pos (f) (i) (len) =
    if i >= len then (-1)
    else if char-to-text (char-at f i) == "/" then i
    else pl-slash-pos f (i + 1) len

  pl-field : Text -> Text
  pl-field (f) =
    let slash = pl-slash-pos f 0 (text-length f)
    in if slash >= 0 then pl-sanitize (substring f 0 slash)
    else pl-sanitize f

  pl-escape : Text -> Text
  pl-escape (s) =
    let s1 = text-replace s "\\" "\\\\"
    in let s2 = text-replace s1 "\"" "\\\""
    in text-replace s2 "\n" "\\n"

 A literal's characters are CCE inside the plug, and CCE's multi-byte units
 share UTF-8's framing with different numbering, so raw bytes print 0x80 low
 from tier-1 slice 1 on. Each non-ASCII character is decoded here and written
 as its UTF-8 bytes, which keeps perl's strings byte strings.

  pl-hex-byte : Integer -> Text
  pl-hex-byte (b) = "\\x" & substring "0123456789ABCDEF" (b / 16) 1 & substring "0123456789ABCDEF" (b - b / 16 * 16) 1

  pl-utf8-escape : Integer -> Text
  pl-utf8-escape (u) =
    if u < 2048 then pl-hex-byte (192 + u / 64) & pl-hex-byte (128 + u - u / 64 * 64)
    else if u < 65536 then pl-hex-byte (224 + u / 4096) & pl-hex-byte (128 + u / 64 - u / 4096 * 64) & pl-hex-byte (128 + u - u / 64 * 64)
    else pl-hex-byte (240 + u / 262144) & pl-hex-byte (128 + u / 4096 - u / 262144 * 64) & pl-hex-byte (128 + u / 64 - u / 4096 * 64) & pl-hex-byte (128 + u - u / 64 * 64)

  pl-escape-text-loop : Text, Integer, Integer, List Text -> List Text
  pl-escape-text-loop (s) (i) (len) (acc) =
    if i >= len then acc
    else let n = cce-decode-length (char-code (char-at s i))
    in let u = to-unicode (cce-decode-at s i)
    in pl-escape-text-loop s (i + n) len (list-snoc acc (if u < 128 then pl-escape (substring s i n) else pl-utf8-escape u))

  pl-escape-text : Text -> Text
  pl-escape-text (s) = text-concat-list (pl-escape-text-loop s 0 (text-length s) [])

  pl-indent : Integer -> Text
  pl-indent (n) = if n <= 0 then "" else "    " & pl-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
    if lo >= hi then lo
    else let mid = lo + (hi - lo) / 2
    in let mid-name = (list-at entries mid).name
    in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
    else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
    let len = list-length xs
    in let pos = bsearch-arity-pos xs (e.name) 0 len
    in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
    if i == list-length defs then acc
    else let d = list-at defs i
    in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
     name = d.name,
     arity = __narrow (list-length (d.params)),
     generic-count = 0
    }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
    let len = list-length entries
    in let pos = bsearch-arity-pos entries name 0 len
    in if pos >= len then -1
    else let e = list-at entries pos
    in if e.name == name then e.arity else -1

 A function-typed parameter is entered in the arity map with generic-count 255,
 a count no definition has, so it shadows a definition of the same name.

  pl-local-mark : Integer = 255

  pl-is-local : List ArityEntry, Text -> Boolean
  pl-is-local (entries) (name) =
    let len = list-length entries
    in let pos = bsearch-arity-pos entries name 0 len
    in if pos >= len then False
    else let e = list-at entries pos
    in e.name == name & e.generic-count == pl-local-mark

  pl-is-fun-ty : CodexType -> Boolean
  pl-is-fun-ty (ty) =
    when ty
     is FunTy (p) (row) (r) -> True
     is otherwise -> False

  pl-has-fun-param : List IRParam, Integer -> Boolean
  pl-has-fun-param (params) (i) =
    if i >= list-length params then False
    else pl-is-fun-ty ((list-at params i).type-val) | pl-has-fun-param params (i + 1)

  pl-copy-arities : List ArityEntry, Integer, List ArityEntry -> List ArityEntry
  pl-copy-arities (xs) (i) (acc) =
    if i >= list-length xs then acc
    else pl-copy-arities xs (i + 1) (list-push acc (list-at xs i))

  pl-with-locals : List IRParam, Integer, List ArityEntry -> List ArityEntry
  pl-with-locals (params) (i) (arities) =
    if pl-has-fun-param params 0 == False then arities
    else pl-insert-locals params i (pl-copy-arities arities 0 [])

  pl-with-local : Text, CodexType, List ArityEntry -> List ArityEntry
  pl-with-local (name) (ty) (arities) =
    if pl-is-fun-ty ty == False then arities
    else sorted-insert-arity (pl-copy-arities arities 0 []) (ArityEntry {
      name = name,
      arity = 0,
      generic-count = __narrow pl-local-mark
    })

  pl-insert-locals : List IRParam, Integer, List ArityEntry -> List ArityEntry
  pl-insert-locals (params) (i) (acc) =
    if i >= list-length params then acc
    else let p = list-at params i
    in if pl-is-fun-ty (p.type-val) == False then pl-insert-locals params (i + 1) acc
    else pl-insert-locals params (i + 1) (sorted-insert-arity acc (ArityEntry {
      name = p.name,
      arity = 0,
      generic-count = __narrow pl-local-mark
    }))

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
    if code >= char-code 'E' then code <= char-code 'Z'
    else False

Section: Type Definition Emission

  emit-pl-type-defs : List ATypeDef, Integer -> Text
  emit-pl-type-defs (tds) (i) =
    if i == list-length tds then ""
    else emit-pl-type-def (list-at tds i) & emit-pl-type-defs tds (i + 1)

  emit-pl-type-def : ATypeDef -> Text
  emit-pl-type-def (td) =
    when td
     is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
      "sub new_" & pl-sanitize (name.value) & " { my %h = @_; " & pl-clamps (arec-fields-to-rfields fields 0 []) 0 & "return \\%h; }\n"
     is AVariantTypeDef (name) (tparams) (ctors) (s) ->
      emit-pl-ctors ctors 0
     is AUnitTypeDef (name) (unitbase) (s) -> ""

  pl-clamps : List RecordField, Integer -> Text
  pl-clamps (fs) (i) =
    if i >= list-length fs then ""
    else let f = list-at fs i
    in let k = "$h{'" & pl-sanitize (f.name.value) & "'}"
    in (when f.type-val
     is IntegerTy (lo) (hi) (mode) ->
      (when mode
       is OvClamping -> k & " = " & k & " < " & integer-to-text lo & " ? " & integer-to-text lo & " : " & k & " > "
         & integer-to-text hi & " ? " & integer-to-text hi & " : " & k & " if exists " & k & "; "
       is OvWrapping ->
        if lo < 0 - 4611686018427387904 | hi > 4611686018427387904 then ""
        else k & " = " & integer-to-text lo & " + ((" & k & " - " & integer-to-text lo & ") % " & integer-to-text (hi - lo + 1)
         & ") if exists " & k & "; "
       is otherwise -> "")
     is otherwise -> "") & pl-clamps fs (i + 1)

  emit-pl-ctors : List AVariantCtorDef, Integer -> Text
  emit-pl-ctors (ctors) (i) =
    if i == list-length ctors then ""
    else let c = list-at ctors i
    in let id = pl-sanitize (c.name.value)
    in let named = "sub new_" & id & " { my %h = @_; $h{tag} = \"" & c.name.value & "\"; return \\%h; }\n"
    in let fields = emit-pl-ctor-fields (list-length (c.fields)) 0
    in let positional = "sub " & id & " { return { tag => \"" & c.name.value & "\"" & fields & " }; }\n"
    in named & positional & emit-pl-ctors ctors (i + 1)

  emit-pl-ctor-fields : Integer, Integer -> Text
  emit-pl-ctor-fields (n) (i) =
    if i >= n then ""
    else ", field" & integer-to-text i & " => $_[" & integer-to-text i & "]" & emit-pl-ctor-fields n (i + 1)

  build-ctor-arities : List ATypeDef, Integer, List ArityEntry -> List ArityEntry
  build-ctor-arities (tds) (i) (acc) =
    if i == list-length tds then acc
    else when list-at tds i
     is AVariantTypeDef (name) (tparams) (ctors) (s) ->
      build-ctor-arities tds (i + 1) (add-ctor-arities ctors 0 acc)
     is otherwise -> build-ctor-arities tds (i + 1) acc

  add-ctor-arities : List AVariantCtorDef, Integer, List ArityEntry -> List ArityEntry
  add-ctor-arities (ctors) (i) (acc) =
    if i == list-length ctors then acc
    else let c = list-at ctors i
    in add-ctor-arities ctors (i + 1) (sorted-insert-arity acc (ArityEntry {
      name = c.name.value,
      arity = __narrow (list-length (c.fields)),
      generic-count = 0
    }))

Section: Expression Emission

  emit-pl-expr : IRExpr, List ArityEntry -> Text
  emit-pl-expr (e) (arities) = emit-pl-expr-at e arities 0

  emit-pl-expr-at : IRExpr, List ArityEntry, Integer -> Text
  emit-pl-expr-at (e) (arities) (depth) =
    if depth >= 256 then "undef"
    else when e
     is IrIntLit (n) (sp) -> integer-to-text n
     is IrNumLit (n) (sp) -> "_cx_bits_to_real(" & integer-to-text n & ")"
     is IrTextLit (s) (sp) -> "\"" & pl-escape-text s & "\""
     is IrBoolLit (b) (sp) -> if b then "1" else "0"
     is IrCharLit (n) (sp) -> integer-to-text n
     is IrName (n) (ty) (sp) -> emit-pl-name n arities
     is IrBinary (op) (l) (r) (ty) (sp) -> emit-pl-binary op l r ty arities
     is IrNegate (operand) (nty) (sp) -> "(-" & emit-pl-expr-at operand arities (depth + 1) & ")"
     is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-pl-expr-at c arities (depth + 1) & " ? " & emit-pl-expr-at t arities (depth + 1) & " : " & emit-pl-expr-at el arities (depth + 1) & ")"
     is IrLet (name) (ty) (val) (body) (sp) -> "(sub { my $" & pl-sanitize name & " = " & emit-pl-expr-at val arities (depth + 1) & "; " & emit-pl-expr-at body (pl-with-local name ty arities) (depth + 1) & " })->()"
     is IrApply (f) (a) (ty) (sp) -> emit-pl-apply e arities
     is IrLambda (params) (body) (ty) (sp) ->
      if list-length params == 0 then "sub { " & emit-pl-expr body arities & " }"
      else pl-curried-lambda params 0 body (pl-with-locals params 0 arities)
     is IrList (elems) (ty) (sp) -> "[" & emit-pl-list-elems elems 0 arities & "]"
     is IrMatch (scrut) (branches) (ty) (sp) -> emit-pl-match scrut branches arities depth
     is IrAct (stmts) (ty) (sp) -> emit-pl-act stmts arities
     is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-pl-expr-at body arities (depth + 1)
     is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-pl-expr-at body arities (depth + 1)
     is IrRecord (name) (fields) (ty) (sp) -> "new_" & pl-sanitize name & "(" & emit-pl-field-vals fields 0 arities & ")"
     is IrFieldAccess (rec) (field) (ty) (sp) -> emit-pl-expr-at rec arities (depth + 1) & "->{'" & pl-field field & "'}"
     is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(sub { my $r = " & emit-pl-expr-at rec arities (depth + 1) & "; $r->{'" & pl-field field & "'} = " & emit-pl-expr-at val arities (depth + 1) & "; $r })->()"
     is IrFork (body) (ty) (sp) -> emit-pl-expr-at body arities (depth + 1)
     is IrAwait (task) (ty) (sp) -> emit-pl-expr-at task arities (depth + 1)
     is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-pl-try max body fb fail-stmts arities
     is IrError (msg) (ty) (sp) -> "die(\"" & pl-escape msg & "\")"

  emit-pl-name : Text, List ArityEntry -> Text
  emit-pl-name (n) (arities) =
    if n == "True" then "1"
    else if n == "False" then "0"
    else if n == "Nothing" then "undef"
    else if n == "vec-empty" then "[]"
    else if n == "__heap-save" | n == "__heap-restore" | n == "__heap-advance" then "0"
    else if pl-is-local arities n then "$" & pl-sanitize n
    else let ar = lookup-arity arities n
    in if ar < 0 then "$" & pl-sanitize n
    else if ar == 0 then pl-sanitize n & "()"
    else emit-pl-partial-open 0 ar & pl-sanitize n & "(" & emit-pl-partial-params 0 ar & ")" & emit-pl-partial-close ar

  emit-pl-int-call : Text, IRExpr, IRExpr, CodexType, List ArityEntry -> Text
  emit-pl-int-call (op) (l) (r) (ty) (arities) =
    let mode = if int-ty-wraps ty then "_wrap(" else "_trap("
    in "_cx_" & op & mode & emit-pl-expr l arities & ", " & emit-pl-expr r arities & ")"

  emit-pl-binary : IRBinaryOp, IRExpr, IRExpr, CodexType, List ArityEntry -> Text
  emit-pl-binary (op) (l) (r) (ty) (arities) =
    when op
     is IrAddInt -> emit-pl-int-call "add" l r ty arities
     is IrSubInt -> emit-pl-int-call "sub" l r ty arities
     is IrMulInt -> emit-pl-int-call "mul" l r ty arities
     is IrAppendText -> "(" & emit-pl-expr l arities & " . " & emit-pl-expr r arities & ")"
     is IrAppendList -> "[@{" & emit-pl-expr l arities & "}, @{" & emit-pl-expr r arities & "}]"
     is IrConsList -> "[" & emit-pl-expr l arities & ", @{" & emit-pl-expr r arities & "}]"
     is IrEq -> "(" & emit-pl-expr l arities & (if pl-is-text l then " eq " else " == ") & emit-pl-expr r arities & ")"
     is IrNotEq -> "(" & emit-pl-expr l arities & (if pl-is-text l then " ne " else " != ") & emit-pl-expr r arities & ")"
     is IrDivNum -> pl-real-op op l r arities
     is IrApproxEq -> pl-real-near l r "4" arities
     is IrApproxEqExact -> pl-real-near l r "0" arities
     is IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox ->
      "to_real_approx(" & pl-real-op op l r arities & ")"
     is IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping ->
      "_cx_real_trap(" & pl-real-round ty (pl-real-op op l r arities) & ")"
     is IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating ->
      "_cx_real_sat(" & pl-real-round ty (pl-real-op op l r arities) & ", " & (if pl-real-is-f32 ty then "1" else "0") & ")"
     is IrAnd -> "(" & emit-pl-expr l arities & " && " & emit-pl-expr r arities & ")"
     is IrOr -> "(" & emit-pl-expr l arities & " || " & emit-pl-expr r arities & ")"
     is IrPowInt -> "_cx_ipow(" & emit-pl-expr l arities & ", " & emit-pl-expr r arities & ")"
     is IrDivInt -> "int(" & emit-pl-expr l arities & " / " & emit-pl-expr r arities & ")"
     is IrRemInt -> "((sub { my ($_ra, $_rb) = @_; my $_rr = abs($_ra) % abs($_rb); $_ra < 0 ? -$_rr : $_rr })->(" & emit-pl-expr l arities & ", " & emit-pl-expr r arities & "))"
     is IrAddVec -> "[map { " & emit-pl-expr l arities & "->[$_] + " & emit-pl-expr r arities & "->[$_] } 0..$#{" & emit-pl-expr l arities & "}]"
     is IrSubVec -> "[map { " & emit-pl-expr l arities & "->[$_] - " & emit-pl-expr r arities & "->[$_] } 0..$#{" & emit-pl-expr l arities & "}]"
     is IrMulVec -> "[map { " & emit-pl-expr l arities & "->[$_] * " & emit-pl-expr r arities & "->[$_] } 0..$#{" & emit-pl-expr l arities & "}]"
     is IrDivVec -> "[map { " & emit-pl-expr l arities & "->[$_] / " & emit-pl-expr r arities & "->[$_] } 0..$#{" & emit-pl-expr l arities & "}]"
     is otherwise -> "(" & emit-pl-expr l arities & " " & pl-bin-op op & " " & emit-pl-expr r arities & ")"

  pl-base-ty : CodexType -> CodexType
  pl-base-ty (ty) =
    when ty
     is UnitTy (n) (b) -> pl-base-ty b
     is otherwise -> ty

  pl-real-is-f32 : CodexType -> Boolean
  pl-real-is-f32 (ty) =
    when pl-base-ty ty
     is RealTy (w) (m) -> when w
      is RwF32 -> True
      is otherwise -> False
     is otherwise -> False

  pl-real-round : CodexType, Text -> Text
  pl-real-round (ty) (e) = if pl-real-is-f32 ty then "to_real_approx(" & e & ")" else e

  pl-real-op : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  pl-real-op (op) (l) (r) (arities) =
    when op
     is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "_cx_fdiv(" & emit-pl-expr l arities & ", " & emit-pl-expr r arities & ")"
     is otherwise -> "(" & emit-pl-expr l arities & " " & pl-bin-op op & " " & emit-pl-expr r arities & ")"

  pl-real-near : IRExpr, IRExpr, Text, List ArityEntry -> Text
  pl-real-near (l) (r) (tol) (arities) =
    when pl-base-ty (ir-expr-type l)
     is RealTy (w) (m) -> "_cx_real_near(" & emit-pl-expr l arities & ", " & emit-pl-expr r arities & ", " & (if pl-real-is-f32 (ir-expr-type l) then "1" else "0") & ", " & tol & ")"
     is otherwise -> "(" & emit-pl-expr l arities & " == " & emit-pl-expr r arities & ")"

  pl-is-text : IRExpr -> Boolean
  pl-is-text (e) =
    when pl-base-ty (ir-expr-type e)
     is TextTy -> True
     is otherwise -> False

  pl-bin-op : IRBinaryOp -> Text
  pl-bin-op (op) =
    when op
     is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
     is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
     is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
     is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
     is IrRemInt -> "%"
     is IrPowInt -> "**"
     is IrEq -> "=="
     is IrNotEq -> "!="
     is IrLt | IrLtVec -> "<"
     is IrGt | IrGtVec -> ">"
     is IrLtEq | IrLtEqVec -> "<="
     is IrGtEq | IrGtEqVec -> ">="
     is IrApproxEq -> "=="
     is IrApproxEqExact -> "=="
     is IrAnd -> "&&"
     is IrOr -> "||"
     is IrAppendText -> "."
     is IrAppendList -> "+"
     is IrConsList -> "+"

  emit-pl-lambda-params : List IRParam, Integer -> Text
  emit-pl-lambda-params (params) (i) =
    if i == list-length params then ""
    else if i == list-length params - 1 then "$" & pl-sanitize ((list-at params i).name)
    else "$" & pl-sanitize ((list-at params i).name) & ", " & emit-pl-lambda-params params (i + 1)

  emit-pl-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  emit-pl-list-elems (elems) (i) (arities) =
    if i == list-length elems then ""
    else if i == list-length elems - 1 then emit-pl-expr (list-at elems i) arities
    else emit-pl-expr (list-at elems i) arities & ", " & emit-pl-list-elems elems (i + 1) arities

  emit-pl-field-vals : List IRFieldVal, Integer, List ArityEntry -> Text
  emit-pl-field-vals (fields) (i) (arities) =
    if i == list-length fields then ""
    else let f = list-at fields i
    in let sep = if i > 0 then ", " else ""
    in sep & "'" & pl-sanitize (f.name) & "' => " & emit-pl-expr (f.value) arities & emit-pl-field-vals fields (i + 1) arities

  emit-pl-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-pl-match (scrut) (branches) (arities) (depth) =
    "(sub { my $_s = " & emit-pl-expr scrut arities & "; " & emit-pl-match-body branches 0 arities depth & " })->()"

  emit-pl-match-body : List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-pl-match-body (branches) (i) (arities) (depth) =
    if i == list-length branches then "die('Non-exhaustive match')"
    else let b = list-at branches i
    in emit-pl-match-arm (b.pattern) (b.guard) (b.body) branches i arities depth

 The rest of the match lives in each ternary's else, so a guard goes in the
 CONDITION, evaluated in the same `sub` that binds the payload, behind the
 tag test's short circuit so a hashref deref is never reached for the wrong
 constructor.

  pl-guard-trivial : IRExpr -> Boolean
  pl-guard-trivial (g) =
    when g
     is IrBoolLit (v) (sp) -> v
     is otherwise -> False

  pl-pat-test : IRPat, Text -> Text
  pl-pat-test (pat) (path) =
    when pat
     is IrLitPat (text) (ty) (sp) -> when pl-base-ty ty
      is TextTy -> "(" & path & " eq \"" & pl-escape-text text & "\")"
      is otherwise -> "(" & path & " == " & pl-lit-pat text & ")"
     is IrCtorPat (name) (subs) (ty) (sp) -> "(" & path & "->{'tag'} eq \"" & name & "\"" & pl-subs-test subs 0 path & ")"
     is otherwise -> "1"

  pl-subs-test : List IRPat, Integer, Text -> Text
  pl-subs-test (subs) (i) (path) =
    if i == list-length subs then ""
    else let t = pl-pat-test (list-at subs i) (path & "->{'field" & integer-to-text i & "'}")
    in (if t == "1" then "" else " && " & t) & pl-subs-test subs (i + 1) path

  pl-pat-binds : IRPat, Text -> Text
  pl-pat-binds (pat) (path) =
    when pat
     is IrVarPat (name) (ty) (sp) -> "my $" & pl-sanitize name & " = " & path & "; "
     is IrCtorPat (name) (subs) (ty) (sp) -> pl-subs-binds subs 0 path
     is otherwise -> ""

  pl-subs-binds : List IRPat, Integer, Text -> Text
  pl-subs-binds (subs) (i) (path) =
    if i == list-length subs then ""
    else pl-pat-binds (list-at subs i) (path & "->{'field" & integer-to-text i & "'}") & pl-subs-binds subs (i + 1) path

  pl-lit-pat : Text -> Text
  pl-lit-pat (text) =
    if text == "True" then "1"
    else if text == "False" then "0"
    else text

  emit-pl-match-arm : IRPat, IRExpr, IRExpr, List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-pl-match-arm (pat) (guard) (body) (branches) (i) (arities) (depth) =
    when pat
     is IrLitPat (text) (ty) (sp) -> "(" & pl-pat-test pat "$_s" & (if pl-guard-trivial guard then "" else " && (" & emit-pl-expr guard arities & ")") & " ? " & emit-pl-expr body arities & " : " & emit-pl-match-body branches (i + 1) arities depth & ")"
     is IrCtorPat (name) (subs) (ty) (sp) -> "(" & pl-pat-test pat "$_s" & (if pl-guard-trivial guard then "" else " && (sub { " & pl-pat-binds pat "$_s" & emit-pl-expr guard arities & " })->()") & " ? (sub { " & pl-pat-binds pat "$_s" & emit-pl-expr body arities & " })->() : " & emit-pl-match-body branches (i + 1) arities depth & ")"
     is IrVarPat (name) (ty) (sp) ->
      if pl-guard-trivial guard then
        "(sub { my $" & pl-sanitize name & " = $_s; " & emit-pl-expr body arities & " })->()"
      else
        "((sub { my $" & pl-sanitize name & " = $_s; " & emit-pl-expr guard arities & " })->() ? (sub { my $" & pl-sanitize name & " = $_s; " & emit-pl-expr body arities & " })->() : " & emit-pl-match-body branches (i + 1) arities depth & ")"
     is IrWildPat (sp) ->
      if pl-guard-trivial guard then emit-pl-expr body arities
      else
        "((" & emit-pl-expr guard arities & ") ? " & emit-pl-expr body arities & " : " & emit-pl-match-body branches (i + 1) arities depth & ")"
     is IrVecPat (pats) (ty) (sp) ->
      if pl-guard-trivial guard then emit-pl-expr body arities
      else
        "((" & emit-pl-expr guard arities & ") ? " & emit-pl-expr body arities & " : " & emit-pl-match-body branches (i + 1) arities depth & ")"

  emit-pl-act : List IRActStmt, List ArityEntry -> Text
  emit-pl-act (stmts) (arities) =
    "(sub { " & emit-pl-act-stmts stmts 0 arities & " })->()"

  emit-pl-act-stmts : List IRActStmt, Integer, List ArityEntry -> Text
  emit-pl-act-stmts (stmts) (i) (arities) =
    if i == list-length stmts then "undef"
    else let s = list-at stmts i
    in let next = (when s
     is IrDoBind (name) (ty) (val) (sp) -> pl-with-local name ty arities
     is IrDoExec (e) (sp) -> arities)
    in (when s
     is IrDoBind (name) (ty) (val) (sp) -> "my $" & pl-sanitize name & " = " & emit-pl-expr val arities & "; "
     is IrDoExec (e) (sp) -> emit-pl-expr e arities & "; ") & (if i < list-length stmts - 1 then emit-pl-act-stmts stmts (i + 1) next else "")

  emit-pl-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, List ArityEntry -> Text
  emit-pl-try (max) (body) (fb) (fail-stmts) (arities) =
    let body-text = emit-pl-act body arities
    in let fb-text = emit-pl-act fb arities
    in let tail = if list-length fb == 0 then "die $_try_err;"
      else if list-length fail-stmts == 0 then "return " & fb-text & ";"
      else "my $_try_fb; if (eval { $_try_fb = " & fb-text & "; 1 }) { return $_try_fb; } return " & emit-pl-act fail-stmts arities & ";"
    in "(sub { my $_try_err; for my $_try_i (1 .. " & integer-to-text max & ") { my $_try_result; if (eval { $_try_result = " & body-text & "; 1 }) { return $_try_result; } $_try_err = $@; } " & tail & " })->()"

Section: Apply Emission

  emit-pl-apply : IRExpr, List ArityEntry -> Text
  emit-pl-apply (e) (arities) =
    let chain = collect-apply-chain e []
    in let root = chain.root
    in let args = chain.args
    in when root
     is IrName (n) (ty) (sp) ->
      if pl-is-local arities n then emit-pl-curried ("$" & pl-sanitize n) args arities 0
      else if n == "vec-load-at" & lookup-arity arities n < 0 then pl-vec-load args (ir-expr-type e) arities
      else let bi = if lookup-arity arities n >= 0 then "" else pl-try-builtin n args arities
      in if text-length bi > 0 then bi
      else let ar = lookup-arity arities n
      in if ar < 1 then emit-pl-curried (pl-sanitize n) args arities 0
      else if list-length args == ar then
        pl-sanitize n & "(" & emit-pl-apply-args args arities 0 & ")"
      else if list-length args < ar then emit-pl-partial n args arities (ar - list-length args)
      else
        emit-pl-curried (pl-sanitize n & "(" & emit-pl-apply-args-upto args arities 0 ar & ")") args arities ar
     is otherwise -> emit-pl-curried ("(" & emit-pl-expr root arities & ")") args arities 0

 Every function VALUE takes one argument a call: a definition named as a
 value, a partial application and a lambda are all nested one-argument subs,
 so a call of a local or of an expression applies its arguments one at a
 time, and an application past a definition's arity calls at the arity and
 applies the surplus the same way.

  pl-vec-load : List IRExpr, CodexType, List ArityEntry -> Text
  pl-vec-load (args) (ty) (arities) =
    when pl-base-ty ty
     is VectorTy (vn) (ve) -> when pl-base-ty ve
      is RealTy (w) (m) -> "_cx_vec_load(" & emit-pl-expr (list-at args 0) arities & ", 'd<')"
      is otherwise -> "_cx_vec_load(" & emit-pl-expr (list-at args 0) arities & ", 'q<')"
     is otherwise -> "die('vec-load-at of a non-vector type')"

  pl-curried-lambda : List IRParam, Integer, IRExpr, List ArityEntry -> Text
  pl-curried-lambda (params) (i) (body) (arities) =
    if i >= list-length params then emit-pl-expr body arities
    else "sub { my ($" & pl-sanitize ((list-at params i).name) & ") = @_; " & pl-curried-lambda params (i + 1) body arities & " }"

  emit-pl-curried : Text, List IRExpr, List ArityEntry, Integer -> Text
  emit-pl-curried (base) (args) (arities) (i) =
    if i >= list-length args then base
    else let next = base & "->(" & emit-pl-expr (list-at args i) arities & ")"
    in emit-pl-curried next args arities (i + 1)

  emit-pl-apply-args-upto : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-pl-apply-args-upto (args) (arities) (i) (n) =
    if i >= n then ""
    else if i == n - 1 then emit-pl-expr (list-at args i) arities
    else
      emit-pl-expr (list-at args i) arities & ", " & emit-pl-apply-args-upto args arities (i + 1) n

  emit-pl-partial-open : Integer, Integer -> Text
  emit-pl-partial-open (i) (count) =
    if i == count then ""
    else "sub { my ($_p" & integer-to-text i & "_) = @_; " & emit-pl-partial-open (i + 1) count

  emit-pl-partial-close : Integer -> Text
  emit-pl-partial-close (count) =
    if count == 0 then "" else " }" & emit-pl-partial-close (count - 1)

  emit-pl-partial-params : Integer, Integer -> Text
  emit-pl-partial-params (i) (count) =
    if i == count then ""
    else if i == count - 1 then "$_p" & integer-to-text i & "_"
    else "$_p" & integer-to-text i & "_, " & emit-pl-partial-params (i + 1) count

  emit-pl-partial : Text, List IRExpr, List ArityEntry, Integer -> Text
  emit-pl-partial (n) (args) (arities) (short) =
    let call = pl-sanitize n & "(" & emit-pl-apply-args args arities 0 & ", " & emit-pl-partial-params 0 short & ")"
    in emit-pl-partial-open 0 short & call & emit-pl-partial-close short

  emit-pl-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-pl-apply-args (args) (arities) (i) =
    if i == list-length args then ""
    else if i == list-length args - 1 then emit-pl-expr (list-at args i) arities
    else emit-pl-expr (list-at args i) arities & ", " & emit-pl-apply-args args arities (i + 1)

  PlBuiltinEmitter = record {
   name : Text,
   emit : List IRExpr, List ArityEntry -> Text
  }

  bsearch-pl-emitter-pos : List PlBuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-pl-emitter-pos (entries) (name) (lo) (hi) =
    if lo >= hi then lo
    else let mid = lo + (hi - lo) / 2
    in let mid-name = (list-at entries mid).name
    in if text-compare name mid-name <= 0 then bsearch-pl-emitter-pos entries name lo mid
    else bsearch-pl-emitter-pos entries name (mid + 1) hi

  sort-pl-emitters : List PlBuiltinEmitter -> List PlBuiltinEmitter
  sort-pl-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  pl-builtin-emitters : List PlBuiltinEmitter = sort-pl-emitters [
   PlBuiltinEmitter {
     name = "bit-and",
     emit = \args arities -> "_cx_bit_and(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-not",
     emit = \args arities -> "_cx_bit_not(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-or",
     emit = \args arities -> "_cx_bit_or(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-shl",
     emit = \args arities -> "_cx_bit_shl(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-shr",
     emit = \args arities -> "_cx_bit_shr(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-shru",
     emit = \args arities -> "_cx_bit_shru(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "bit-xor",
     emit = \args arities -> "_cx_bit_xor(" & emit-pl-apply-args args arities 0 & ")"
   },
   PlBuiltinEmitter {
     name = "char-at",
     emit = \args arities -> "ord(substr(" & emit-pl-expr (list-at args 0) arities & ", " & emit-pl-expr (list-at args 1) arities & ", 1))"
   },
   PlBuiltinEmitter {
     name = "char-code",
     emit = \args arities -> emit-pl-expr (list-at args 0) arities
   },
