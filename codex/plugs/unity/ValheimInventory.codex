                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "linked",
                    cv-value = (Just
                      (CstBinary
                        CstCoalesce
                        (CstName "transactionChests" [])
                        (CstCall
                          (CstName "Linked" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                        )
                      )
                    )
                  }
                ]
              ),
              (CstIf (CstBinary CstEqual (CstMemberAccess (CstName "linked" []) "Count" []) (CstNumber "0" CstInt)) (CstReturn (Just CstNull)) None),
              (CstVariables [] CstInferredType [CstVariable { cv-name = "real", cv-value = (Just (CstCall (CstMemberAccess (CstName "player" []) "GetInventory" []) [])) }]),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "result",
                    cv-value = (Just
                      (CstObjectNew
                        (CstNamedType "Inventory" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Workbench resources") },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCall (CstMemberAccess (CstName "real" []) "GetWidth" []) []) },
