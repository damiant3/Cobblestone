  valheim-inventory-show-connection-effect : Integer -> CstMember
  valheim-inventory-show-connection-effect (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "ShowConnection",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Container" []), cp-name = "chest", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "CraftingStation" []), cp-name = "station", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "float" []), cp-name = "duration", cp-default = (Just (CstNumber "3" CstFloat)) }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstForEach
                CstInferredType
                "existing"
                (CstName "connections" [])
                (CstBlock
                  [
                    (CstIf
                      (CstParenthesized
                        (CstBinary
                          CstAnd
                          (CstParenthesized
                            (CstBinary
                              CstAnd
                              (CstParenthesized (CstBinary CstEqual (CstMemberAccess (CstName "existing" []) "chest" []) (CstName "chest" [])))
                              (CstParenthesized (CstBinary CstEqual (CstMemberAccess (CstName "existing" []) "station" []) (CstName "station" [])))
                            )
                          )
                          (CstMemberAccess (CstName "existing" []) "effect" [])
                        )
                      )
                      (CstBlock
                        [
                          (CstExpression
                            (CstAssignment
                              CstAssign
                              (CstMemberAccess (CstName "existing" []) "until" [])
                              (CstParenthesized (CstBinary CstAdd (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstName "duration" [])))
                            )
                          ),
                          (CstReturn None)
                        ]
                      )
                      None
                    )
                  ]
                )
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "effect",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "Instantiate" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstCall (CstName "ChoppingBlock" []) []) "m_connectionPrefab" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "chest" []) "transform" []) "position" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Quaternion" []) "identity" []) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstName "connections" []) "Add" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstObjectNew
                        (CstNamedType "Connection" [])
                        []
                        [
                          (CstAssignment CstAssign (CstName "chest" []) (CstName "chest" [])),
                          (CstAssignment CstAssign (CstName "station" []) (CstName "station" [])),
                          (CstAssignment CstAssign (CstName "effect" []) (CstName "effect" [])),
                          (CstAssignment
                            CstAssign
                            (CstName "until" [])
                            (CstParenthesized (CstBinary CstAdd (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstName "duration" [])))
                          )
                        ]
                      )
                    }
                  ]
                )
              ),
              (CstExpression (CstCall (CstName "UpdateConnections" []) []))
            ]
          )
        )
      }
    )

  valheim-inventory-update-connection-effects : Integer -> CstMember
  valheim-inventory-update-connection-effects (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
