  valheim-inventory-ensure-combined-view-capacity : Integer -> CstMember
  valheim-inventory-ensure-combined-view-capacity (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "bool" []),
        cm-name = "EnsureSurface",
        cm-type-params = [],
        cm-params = [CstParameter { cp-modifiers = [], cp-type = (CstNamedType "InventoryGui" []), cp-name = "gui", cp-default = None }],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables [] CstInferredType [CstVariable { cv-name = "player", cv-value = (Just (CstMemberAccess (CstName "Player" []) "m_localPlayer" [])) }]),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "candidate",
                    cv-value = (Just
                      (CstConditional
                        (CstName "gui" [])
                        (CstCast
                          (CstNamedType "Container" [])
                          (CstCall (CstMemberAccess (CstName "CurrentContainer" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "gui" []) }])
                        )
                        CstNull
                      )
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstUnary CstNot (CstCall (CstName "Solo" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]))
                  (CstUnary
                    CstNot
                    (CstCall
                      (CstName "Allowed" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "candidate" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                    )
                  )
                )
                (CstBlock
                  [
                    (CstExpression (CstCall (CstName "RestoreNativePanel" []) [])),
                    (CstExpression (CstAssignment CstAssign (CstName "root" []) CstNull)),
                    (CstExpression (CstAssignment CstAssign (CstName "chestView" []) CstNull)),
                    (CstReturn (Just (CstBoolean False)))
                  ]
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstNotEqual (CstName "root" []) (CstName "candidate" []))
                  (CstBinary CstGreaterEqual (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstName "nextDiscovery" []))
                )
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "next",
                          cv-value = (Just
                            (CstCall
                              (CstName "Group" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "candidate" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                            )
                          )
                        }
                      ]
                    ),
                    (CstExpression (CstAssignment CstAssign (CstName "dirty" []) (CstBoolean True))),
                    (CstExpression (CstAssignment CstAssign (CstName "root" []) (CstName "candidate" []))),
                    (CstExpression (CstAssignment CstAssign (CstName "group" []) (CstName "next" []))),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstName "nextDiscovery" [])
                        (CstBinary CstAdd (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstNumber "1" CstInt))
                      )
                    ),
                    (CstExpression (CstAssignment CstAssign (CstName "preview" []) CstNull)),
                    (CstExpression
                      (CstCall
                        (CstName "Watch" [])
                        [
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstCall
                              (CstMemberAccess
                                (CstCall
                                  (CstMemberAccess
                                    (CstCall
                                      (CstMemberAccess (CstName "group" []) "Concat" [])
                                      [
                                        CstArgument {
                                          ca-mode = [],
                                          ca-name = "",
                                          ca-value = (CstCall
                                            (CstName "Linked" [])
                                            [
                                              CstArgument { ca-mode = [], ca-name = "", ca-value = (CstCall (CstMemberAccess (CstName "player" []) "GetCurrentCraftingStation" []) []) },
                                              CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }
                                            ]
                                          )
                                        }
                                      ]
                                    )
                                    "Distinct"
                                    []
                                  )
                                  []
                                )
                                "ToList"
                                []
                              )
                              []
                            )
                          },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }
                        ]
                      )
                    ),
                    (CstExpression (CstCall (CstMemberAccess (CstName "positions" []) "Clear" []) [])),
                    (CstForEach
                      CstInferredType
                      "chest"
                      (CstName "group" [])
                      (CstExpression
                        (CstAssignment
                          CstAssign
                          (CstIndex (CstName "positions" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }])
                          (CstMemberAccess (CstMemberAccess (CstName "chest" []) "transform" []) "position" [])
                        )
                      )
                    ),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstName "observedStation" [])
                        (CstCall (CstName "BoundStation" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "root" []) }])
                      )
                    ),
                    (CstIf
                      (CstName "observedStation" [])
                      (CstExpression
                        (CstAssignment CstAssign (CstName "stationPosition" []) (CstMemberAccess (CstMemberAccess (CstName "observedStation" []) "transform" []) "position" []))
                      )
                      None
                    )
                  ]
                )
                None
              ),
              (CstIf (CstBinary CstOr (CstName "dirty" []) (CstBinary CstEqual (CstName "chestView" []) CstNull)) (CstExpression (CstCall (CstName "BuildView" []) [])) None),
              (CstExpression (CstCall (CstName "EnsureNativePanel" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "gui" []) }])),
              (CstReturn (Just (CstBoolean True)))
            ]
          )
        )
      }
    )

  valheim-inventory-build-combined-inventory-view : Integer -> CstMember
  valheim-inventory-build-combined-inventory-view (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "BuildView",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "viewSlots" [])
                  (CstCall
                    (CstName "Slots" [])
                    [
                      CstArgument {
                        ca-mode = [],
                        ca-name = "",
                        ca-value = (CstCall
                          (CstMemberAccess
                            (CstCall
                              (CstMemberAccess (CstName "group" []) "Select" [])
                              [
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstLambda
                                    [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "c", cp-default = None }]
                                    (CstCall (CstMemberAccess (CstName "c" []) "GetInventory" []) [])
                                  )
                                }
                              ]
                            )
                            "ToList"
                            []
                          )
                          []
                        )
                      }
                    ]
                  )
                )
              ),
              (CstVariables
                []
                (CstNamedType "int" [])
                [
                  CstVariable {
                    cv-name = "width",
                    cv-value = (Just
                      (CstConditional
                        (CstBinary CstGreater (CstMemberAccess (CstName "group" []) "Count" []) (CstNumber "1" CstInt))
                        (CstNumber "8" CstInt)
                        (CstCall (CstMemberAccess (CstCall (CstMemberAccess (CstName "root" []) "GetInventory" []) []) "GetWidth" []) [])
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                (CstNamedType "int" [])
                [
                  CstVariable {
                    cv-name = "height",
                    cv-value = (Just
                      (CstBinary
                        CstDivide
                        (CstParenthesized (CstBinary CstSubtract (CstBinary CstAdd (CstMemberAccess (CstName "viewSlots" []) "Count" []) (CstName "width" [])) (CstNumber "1" CstInt)))
                        (CstName "width" [])
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "chestView" [])
                  (CstObjectNew
                    (CstNamedType "Inventory" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Linked chests") },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "width" []) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "height" []) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression (CstCall (CstMemberAccess (CstName "displayItems" []) "Clear" []) [])),
              (CstFor
                (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "i", cv-value = (Just (CstNumber "0" CstInt)) }])
                (Just (CstBinary CstLess (CstName "i" []) (CstMemberAccess (CstName "viewSlots" []) "Count" [])))
                [(CstUnary CstPostIncrement (CstName "i" []))]
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "slot",
                          cv-value = (Just (CstIndex (CstName "viewSlots" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "i" []) }]))
                        }
                      ]
                    ),
                    (CstIf (CstBinary CstEqual (CstMemberAccess (CstName "slot" []) "item" []) CstNull) CstContinue None),
                    (CstVariables
                      []
                      CstInferredType
                      [CstVariable { cv-name = "copy", cv-value = (Just (CstCall (CstMemberAccess (CstMemberAccess (CstName "slot" []) "item" []) "Clone" []) [])) }]
                    ),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstMemberAccess (CstName "copy" []) "m_gridPos" [])
                        (CstObjectNew
                          (CstNamedType "Vector2i" [])
                          [
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstRemainder (CstName "i" []) (CstName "width" [])) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstDivide (CstName "i" []) (CstName "width" [])) }
                          ]
                          []
                        )
                      )
                    ),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstCall (CstMemberAccess (CstName "chestView" []) "GetAllItems" []) []) "Add" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "copy" []) }]
                      )
                    ),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstName "projectedItems" []) "Add" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "copy" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "slot" []) }]
                      )
                    ),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstIndex (CstName "displayItems" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "slot" []) "item" []) }])
                        (CstName "copy" [])
                      )
                    )
                  ]
                )
              ),
              (CstExpression (CstCall (CstName "Notify" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chestView" []) }])),
              (CstExpression (CstAssignment CstAssign (CstName "dirty" []) (CstBoolean False)))
            ]
          )
        )
      }
    )

  valheim-inventory-handle-native-grid-update : Integer -> CstMember
  valheim-inventory-handle-native-grid-update (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPublic, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "NativeGrid",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "InventoryGrid" []), cp-name = "grid", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Inventory" []), cp-name = "inventory", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Player" []), cp-name = "player", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "ItemDrop.ItemData" []), cp-name = "drag", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables [] CstInferredType [CstVariable { cv-name = "gui", cv-value = (Just (CstMemberAccess (CstName "InventoryGui" []) "instance" [])) }]),
              (CstIf
                (CstParenthesized
                  (CstBinary
                    CstAnd
                    (CstParenthesized (CstBinary CstAnd (CstName "instance" []) (CstName "gui" [])))
                    (CstParenthesized
                      (CstBinary
                        CstEqual
                        (CstName "grid" [])
                        (CstParenthesized
                          (CstCast
                            (CstNamedType "InventoryGrid" [])
                            (CstCall (CstMemberAccess (CstName "ContainerGrid" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "gui" []) }])
                          )
                        )
                      )
                    )
                  )
                )
                (CstBlock
                  [
                    (CstTry
                      (CstBlock
                        [
                          (CstIf
                            (CstCall (CstMemberAccess (CstName "instance" []) "EnsureSurface" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "gui" []) }])
                            (CstBlock
                              [
                                (CstVariables [] (CstNamedType "ItemDrop.ItemData" []) [CstVariable { cv-name = "shown", cv-value = (Just CstNull) }]),
                                (CstIf
                                  (CstParenthesized (CstBinary CstNotEqual (CstName "drag" []) CstNull))
                                  (CstBlock
                                    [
                                      (CstExpression
                                        (CstCall
                                          (CstMemberAccess (CstMemberAccess (CstName "instance" []) "displayItems" []) "TryGetValue" [])
                                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "drag" []) }, CstArgument { ca-mode = [CstOut], ca-name = "", ca-value = (CstName "shown" []) }]
                                        )
                                      )
                                    ]
                                  )
                                  None
                                ),
                                (CstExpression
                                  (CstCall
                                    (CstName "originalGrid" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "grid" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "instance" []) "chestView" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "shown" []) }
                                    ]
                                  )
                                ),
                                (CstExpression
                                  (CstCall
                                    (CstName "SetPhysicalSlots" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "grid" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "instance" []) "viewSlots" []) "Count" []) }
                                    ]
                                  )
                                ),
                                (CstReturn None)
                              ]
                            )
                            None
                          )
                        ]
                      )
                      [
                        CstCatch {
                          cc-type = (Just (CstNamedType "Exception" [])),
                          cc-name = "e",
                          cc-filter = None,
