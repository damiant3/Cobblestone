                                  (CstBinary
                                    CstOr
                                    (CstParenthesized
                                      (CstBinary
                                        CstOr
                                        (CstParenthesized (CstBinary CstEqual (CstName "ContainerGrid" []) CstNull))
                                        (CstParenthesized (CstBinary CstEqual (CstName "GridInventory" []) CstNull))
