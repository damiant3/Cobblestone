                        (CstMemberAccess (CstMemberAccess (CstName "Localization" []) "instance" []) "Localize" [])
                        [
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstCall (CstMemberAccess (CstCall (CstMemberAccess (CstName "root" []) "GetInventory" []) []) "GetName" []) [])
                          }
                        ]
                      )
                    )
                  )
                )
              )
            ]
          )
        )
      }
    )

  valheim-inventory-restore-native-container-panel : Integer -> CstMember
  valheim-inventory-restore-native-container-panel (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "RestoreNativePanel",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstName "panelGui" [])
                (CstBlock
                  [
                    (CstExpression
                      (CstCall
                        (CstName "SetPhysicalSlots" [])
                        [
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstCast
                              (CstNamedType "InventoryGrid" [])
                              (CstCall (CstMemberAccess (CstName "ContainerGrid" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "panelGui" []) }])
                            )
                          },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstUnary CstNegate (CstNumber "1" CstInt)) }
                        ]
                      )
                    ),
                    (CstExpression (CstAssignment CstAssign (CstMemberAccess (CstMemberAccess (CstName "panelGui" []) "m_container" []) "sizeDelta" []) (CstName "panelSize" []))),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstName "panelGui" []) "m_takeAllButton" []) "gameObject" []) "SetActive" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBoolean True) }]
                      )
                    ),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstName "panelGui" []) "m_stackAllButton" []) "gameObject" []) "SetActive" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBoolean True) }]
                      )
                    ),
                    (CstIf
                      (CstName "viewport" [])
                      (CstBlock [(CstExpression (CstAssignment CstAssign (CstMemberAccess (CstName "viewport" []) "sizeDelta" []) (CstName "viewportSize" [])))])
                      None
                    ),
                    (CstIf
                      (CstName "gridRect" [])
                      (CstBlock [(CstExpression (CstAssignment CstAssign (CstMemberAccess (CstName "gridRect" []) "sizeDelta" []) (CstName "gridSize" [])))])
                      None
                    )
                  ]
                )
                None
              ),
              (CstForEach
                CstInferredType
                "button"
                (CstName "buttons" [])
                (CstBlock
                  [
                    (CstIf
                      (CstName "button" [])
                      (CstBlock
                        [
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "Destroy" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "button" []) "gameObject" []) }]
                            )
                          )
                        ]
                      )
                      None
                    )
                  ]
                )
              ),
              (CstExpression (CstCall (CstMemberAccess (CstName "buttons" []) "Clear" []) [])),
              (CstExpression (CstAssignment CstAssign (CstName "panelGui" []) CstNull)),
              (CstExpression (CstAssignment CstAssign (CstName "viewport" []) CstNull)),
              (CstExpression (CstAssignment CstAssign (CstName "gridRect" []) CstNull))
            ]
          )
        )
      }
    )

