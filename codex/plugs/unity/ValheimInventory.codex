        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstParenthesized
                  (CstBinary
                    CstOr
                    (CstParenthesized
                      (CstBinary
                        CstOr
                        (CstParenthesized
                          (CstBinary
                            CstOr
                            (CstParenthesized
