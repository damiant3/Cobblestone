          (CstBlock
            [
              (CstFor
                (CstVariables
                  []
                  (CstNamedType "int" [])
                  [
                    CstVariable {
                      cv-name = "i",
                      cv-value = (Just (CstParenthesized (CstBinary CstSubtract (CstMemberAccess (CstName "connections" []) "Count" []) (CstNumber "1" CstInt))))
                    }
                  ]
                )
                (Just (CstParenthesized (CstBinary CstGreaterEqual (CstName "i" []) (CstNumber "0" CstInt))))
                [(CstUnary CstPostDecrement (CstName "i" []))]
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "c",
                          cv-value = (Just (CstIndex (CstName "connections" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "i" []) }]))
                        }
                      ]
                    ),
                    (CstIf
                      (CstParenthesized
                        (CstBinary
                          CstOr
                          (CstParenthesized
                            (CstBinary
                              CstOr
                              (CstParenthesized
                                (CstBinary
                                  CstOr
                                  (CstParenthesized
                                    (CstBinary
                                      CstOr
                                      (CstParenthesized
                                        (CstBinary
                                          CstOr
                                          (CstParenthesized
                                            (CstBinary
                                              CstOr
                                              (CstParenthesized
                                                (CstBinary
                                                  CstOr
                                                  (CstUnary CstNot (CstParenthesized (CstMemberAccess (CstName "c" []) "chest" [])))
                                                  (CstUnary CstNot (CstParenthesized (CstMemberAccess (CstName "c" []) "station" [])))
                                                )
                                              )
                                              (CstUnary CstNot (CstParenthesized (CstMemberAccess (CstName "c" []) "effect" [])))
                                            )
                                          )
                                          (CstParenthesized
                                            (CstBinary CstGreater (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstMemberAccess (CstName "c" []) "until" []))
                                          )
                                        )
                                      )
                                      (CstUnary
                                        CstNot
                                        (CstParenthesized
                                          (CstCall
                                            (CstName "InRange" [])
                                            [
                                              CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "c" []) "chest" []) },
                                              CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "c" []) "station" []) }
                                            ]
                                          )
                                        )
                                      )
                                    )
                                  )
                                  (CstParenthesized
                                    (CstBinary
                                      CstEqual
                                      (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "c" []) "chest" []) }])
                                      CstNull
                                    )
                                  )
                                )
                              )
                              (CstParenthesized
                                (CstBinary
                                  CstNotEqual
                                  (CstCall
                                    (CstMemberAccess
                                      (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "c" []) "chest" []) }])
                                      "GetString"
                                      []
                                    )
                                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                                  )
                                  (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "c" []) "station" []) }])
                                )
                              )
                            )
                          )
                          (CstUnary
                            CstNot
                            (CstCall
