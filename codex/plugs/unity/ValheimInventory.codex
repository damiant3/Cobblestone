  valheim-inventory-resolve-physical-slot : Integer -> CstMember
  valheim-inventory-resolve-physical-slot (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "Slot" []),
        cm-name = "ResolveSlot",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "ItemDrop.ItemData" []), cp-name = "shown", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Vector2i" []), cp-name = "pos", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstBinary CstNotEqual (CstName "shown" []) CstNull)
                (CstBlock
                  [
                    (CstVariables [] (CstNamedType "Slot" []) [CstVariable { cv-name = "slot", cv-value = None }]),
                    (CstIf
                      (CstBinary
                        CstOr
                        (CstBinary
                          CstOr
                          (CstUnary
                            CstNot
                            (CstCall
                              (CstMemberAccess (CstName "projectedItems" []) "TryGetValue" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "shown" []) }, CstArgument { ca-mode = [CstOut], ca-name = "", ca-value = (CstName "slot" []) }]
                            )
                          )
                          (CstBinary
                            CstNotEqual
                            (CstCall
                              (CstMemberAccess (CstMemberAccess (CstName "slot" []) "inventory" []) "GetItemAt" [])
                              [
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "slot" []) "x" []) },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "slot" []) "y" []) }
                              ]
                            )
                            (CstMemberAccess (CstName "slot" []) "item" [])
                          )
                        )
                        (CstBinary CstNotEqual (CstMemberAccess (CstMemberAccess (CstName "slot" []) "item" []) "m_stack" []) (CstMemberAccess (CstName "slot" []) "amount" []))
                      )
                      (CstThrow
                        (Just
                          (CstObjectNew
                            (CstNamedType "InvalidOperationException" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Inventory changed; try again") }]
                            []
                          )
                        )
                      )
                      None
                    ),
                    (CstReturn (Just (CstName "slot" [])))
                  ]
                )
                None
              ),
              (CstVariables
                []
                (CstNamedType "int" [])
                [
                  CstVariable {
                    cv-name = "index",
                    cv-value = (Just
                      (CstBinary
                        CstAdd
                        (CstBinary CstMultiply (CstMemberAccess (CstName "pos" []) "y" []) (CstCall (CstMemberAccess (CstName "chestView" []) "GetWidth" []) []))
                        (CstMemberAccess (CstName "pos" []) "x" [])
                      )
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary
                    CstOr
                    (CstBinary
                      CstOr
                      (CstBinary CstLess (CstMemberAccess (CstName "pos" []) "x" []) (CstNumber "0" CstInt))
                      (CstBinary CstGreaterEqual (CstMemberAccess (CstName "pos" []) "x" []) (CstCall (CstMemberAccess (CstName "chestView" []) "GetWidth" []) []))
                    )
                    (CstBinary CstLess (CstMemberAccess (CstName "pos" []) "y" []) (CstNumber "0" CstInt))
                  )
                  (CstBinary CstGreaterEqual (CstName "index" []) (CstMemberAccess (CstName "viewSlots" []) "Count" []))
                )
                (CstThrow
                  (Just
                    (CstObjectNew (CstNamedType "InvalidOperationException" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "No physical storage slot") }] [])
                  )
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstNotEqual
                  (CstMemberAccess (CstIndex (CstName "viewSlots" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "index" []) }]) "item" [])
                  CstNull
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Inventory changed; try again") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstReturn (Just (CstIndex (CstName "viewSlots" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "index" []) }])))
            ]
          )
        )
      }
    )

