                  (CstUnary CstNot (CstName "WorkbenchLinks" []))
                )
                (CstReturn
                  (Just
                    (CstCall
                      (CstName "originalRequirement" [])
                      [
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "element" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "requirement" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "craft" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "quality" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "multiplier" []) }
                      ]
                    )
                  )
                )
                None
              ),
              (CstVariables [] CstInferredType [CstVariable { cv-name = "real", cv-value = (Just (CstCall (CstMemberAccess (CstName "player" []) "GetInventory" []) [])) }]),
              (CstTry
                (CstBlock
                  [
                    (CstVariables [] (CstNamedType "Inventory" []) [CstVariable { cv-name = "available", cv-value = None }]),
                    (CstIf
                      (CstUnary CstNot (CstName "craft" []))
                      (CstExpression
                        (CstAssignment
                          CstAssign
                          (CstName "available" [])
                          (CstCall (CstMemberAccess (CstName "instance" []) "BuildingAvailable" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }])
                        )
                      )
                      (Just
                        (CstBlock
                          [
                            (CstVariables [] CstInferredType [CstVariable { cv-name = "gui", cv-value = (Just (CstMemberAccess (CstName "InventoryGui" []) "instance" [])) }]),
                            (CstVariables
                              []
                              CstInferredType
                              [CstVariable { cv-name = "station", cv-value = (Just (CstCall (CstMemberAccess (CstName "player" []) "GetCurrentCraftingStation" []) [])) }]
                            ),
                            (CstIf
                              (CstBinary
                                CstOr
                                (CstBinary CstOr (CstUnary CstNot (CstName "gui" [])) (CstUnary CstNot (CstName "station" [])))
                                (CstBinary CstLess (CstName "quality" []) (CstNumber "1" CstInt))
                              )
                              (CstReturn
                                (Just
                                  (CstCall
                                    (CstName "originalRequirement" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "element" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "requirement" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "craft" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "quality" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "multiplier" []) }
                                    ]
                                  )
                                )
                              )
                              None
                            ),
                            (CstVariables
                              []
                              CstInferredType
                              [
                                CstVariable {
                                  cv-name = "selected",
                                  cv-value = (Just (CstCall (CstMemberAccess (CstName "SelectedRecipe" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "gui" []) }]))
                                }
                              ]
                            ),
                            (CstVariables
                              []
                              CstInferredType
                              [
                                CstVariable {
                                  cv-name = "recipe",
                                  cv-value = (Just
                                    (CstCast
                                      (CstNamedType "Recipe" [])
                                      (CstCall
                                        (CstMemberAccess
                                          (CstCall
                                            (CstMemberAccess (CstCall (CstMemberAccess (CstName "selected" []) "GetType" []) []) "GetProperty" [])
                                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Recipe") }]
                                          )
                                          "GetValue"
                                          []
                                        )
                                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "selected" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull }]
                                      )
                                    )
                                  )
                                }
                              ]
                            ),
                            (CstIf
                              (CstBinary CstOr (CstUnary CstNot (CstName "recipe" [])) (CstMemberAccess (CstName "recipe" []) "m_requireOnlyOneIngredient" []))
                              (CstReturn
                                (Just
                                  (CstCall
                                    (CstName "originalRequirement" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "element" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "requirement" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "craft" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "quality" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "multiplier" []) }
                                    ]
                                  )
                                )
                              )
                              None
                            ),
                            (CstExpression
                              (CstAssignment
                                CstAssign
                                (CstName "available" [])
                                (CstCall
                                  (CstMemberAccess (CstName "instance" []) "Available" [])
                                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                                )
                              )
                            )
                          ]
                        )
                      )
                    ),
                    (CstIf
                      (CstBinary CstNotEqual (CstName "available" []) CstNull)
                      (CstExpression
                        (CstCall
                          (CstMemberAccess (CstName "PlayerInventory" []) "SetValue" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "available" []) }]
                        )
                      )
                      None
                    ),
                    (CstReturn
                      (Just
                        (CstCall
                          (CstName "originalRequirement" [])
                          [
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "element" []) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "requirement" []) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "craft" []) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "quality" []) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "multiplier" []) }
                          ]
                        )
                      )
                    )
                  ]
                )
                []
                (Just
                  (CstBlock
                    [
                      (CstExpression
                        (CstCall
                          (CstMemberAccess (CstName "PlayerInventory" []) "SetValue" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "real" []) }]
