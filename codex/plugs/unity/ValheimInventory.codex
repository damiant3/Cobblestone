                              (CstName "Allowed" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "c" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                            )
                            (CstCall
                              (CstName "InRange" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "c" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                            )
