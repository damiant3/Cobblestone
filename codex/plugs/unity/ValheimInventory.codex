                          (CstUnary CstNot (CstMemberAccess (CstName "item" []) "m_equipped" []))
                          (CstUnary CstNot (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_shared" []) "m_questItem" []))
                        )
                        (CstCall
                          (CstMemberAccess (CstName "group" []) "Any" [])
                          [
                            CstArgument {
                              ca-mode = [],
                              ca-name = "",
                              ca-value = (CstLambda
