        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "LinkBench",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Container" []), cp-name = "chest", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "CraftingStation" []), cp-name = "station", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables [] CstInferredType [CstVariable { cv-name = "player", cv-value = (Just (CstMemberAccess (CstName "Player" []) "m_localPlayer" [])) }]),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary
                    CstOr
                    (CstBinary
                      CstOr
                      (CstUnary CstNot (CstName "WorkbenchLinks" []))
                      (CstUnary
                        CstNot
                        (CstCall
                          (CstName "Allowed" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                        )
                      )
                    )
                    (CstUnary CstNot (CstName "station" []))
                  )
                  (CstUnary
                    CstNot
                    (CstCall
                      (CstName "InRange" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                    )
                  )
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Choose a workbench within chopping block range") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstVariables
                []
                CstInferredType
                [CstVariable { cv-name = "view", cv-value = (Just (CstCall (CstMemberAccess (CstName "station" []) "GetComponent" [(CstNamedType "ZNetView" [])]) [])) }]
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstOr (CstUnary CstNot (CstName "view" [])) (CstUnary CstNot (CstCall (CstMemberAccess (CstName "view" []) "IsOwner" []) [])))
                  (CstBinary CstEqual (CstCall (CstMemberAccess (CstName "view" []) "GetZDO" []) []) CstNull)
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Workbench ownership changed") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstVariables
                []
                (CstNamedType "string" [])
                [
                  CstVariable {
                    cv-name = "id",
                    cv-value = (Just (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]))
                  }
                ]
              ),
              (CstIf
                (CstBinary CstEqual (CstMemberAccess (CstName "id" []) "Length" []) (CstNumber "0" CstInt))
                (CstBlock
                  [
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstName "id" [])
                        (CstBinary
                          CstAdd
                          (CstString "1:")
                          (CstCall
                            (CstMemberAccess (CstCall (CstMemberAccess (CstName "Guid" []) "NewGuid" []) []) "ToString" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "N") }]
                          )
                        )
                      )
                    ),
                    (CstExpression
                      (CstCall
                        (CstMemberAccess (CstCall (CstMemberAccess (CstName "view" []) "GetZDO" []) []) "Set" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "StationKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "id" []) }]
                      )
                    )
                  ]
                )
                None
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "members",
                    cv-value = (Just
                      (CstCall
                        (CstName "Linked" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                      )
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary
                  CstAnd
                  (CstUnary
                    CstNot
                    (CstCall (CstMemberAccess (CstName "members" []) "Contains" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }])
                  )
                  (CstBinary CstGreaterEqual (CstMemberAccess (CstName "members" []) "Count" []) (CstName "GroupLimit" []))
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Workbench container limit reached") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]) "Set" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "id" []) }]
                )
              ),
              (CstExpression (CstCall (CstName "Invalidate" []) [])),
              (CstExpression
                (CstCall
                  (CstName "ShowConnection" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                )
              ),
              (CstExpression
                (CstCall
                  (CstName "Report" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstBinary
                        CstAdd
                        (CstString "Linked to ")
                        (CstCall
                          (CstMemberAccess (CstMemberAccess (CstName "Localization" []) "instance" []) "Localize" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "station" []) "m_name" []) }]
                        )
                      )
                    }
                  ]
                )
              )
            ]
          )
        )
      }
    )

