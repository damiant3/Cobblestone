  valheim-inventory-prepare-method-hook : Integer -> CstMember
  valheim-inventory-prepare-method-hook (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate, CstStatic],
        cm-result = (CstNamedType "T" []),
        cm-name = "Hook",
        cm-type-params = [CstTypeParameter { ctp-name = "T", ctp-constraints = [CstClassConstraint] }],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Type" []), cp-name = "owner", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "string" []), cp-name = "method", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "string" []), cp-name = "replacement", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "source",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstName "owner" []) "GetMethod" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "method" []) },
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstBinary
                              CstBitOr
                              (CstName "Flags" [])
                              (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstName "System" []) "Reflection" []) "BindingFlags" []) "Static" [])
                            )
                          }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary CstEqual (CstName "source" []) CstNull)
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstAdd (CstString "Missing inventory binding: ") (CstName "method" [])) }]
                      []
                    )
                  )
                )
                None
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "saved",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstName "PrismMethodBridge" []) "Copy" [(CstNamedType "T" [])])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "source" []) }]
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstName "patches" []) "Add" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstCall
                        (CstMemberAccess (CstName "PrismMethodBridge" []) "Prepare" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "source" []) },
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstCall
                              (CstMemberAccess (CstTypeOf (CstNamedType "PrismStorage" [])) "GetMethod" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "replacement" []) }]
                            )
                          }
                        ]
                      )
                    }
                  ]
                )
              ),
              (CstReturn (Just (CstName "saved" [])))
            ]
          )
        )
      }
    )

