  valheim-inventory-mask-padding-slots : Integer -> CstMember
  valheim-inventory-mask-padding-slots (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "SetPhysicalSlots",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "InventoryGrid" []), cp-name = "grid", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "int" []), cp-name = "capacity", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstUnary CstNot (CstName "grid" [])) (CstReturn None) None),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "elements",
                    cv-value = (Just
                      (CstCast
                        (CstNamedType "List" [(CstNamedType "InventoryElement" [])])
                        (CstCall (CstMemberAccess (CstName "GridElements" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "grid" []) }])
                      )
                    )
                  }
                ]
              ),
              (CstIf (CstBinary CstEqual (CstName "elements" []) CstNull) (CstReturn None) None),
              (CstVariables
                []
                (CstNamedType "int" [])
                [
                  CstVariable {
                    cv-name = "width",
                    cv-value = (Just
                      (CstConditional
                        (CstBinary CstEqual (CstCall (CstMemberAccess (CstName "grid" []) "GetInventory" []) []) CstNull)
                        (CstNumber "0" CstInt)
                        (CstCall (CstMemberAccess (CstCall (CstMemberAccess (CstName "grid" []) "GetInventory" []) []) "GetWidth" []) [])
                      )
                    )
                  }
                ]
              ),
              (CstForEach
                CstInferredType
                "element"
                (CstName "elements" [])
                (CstBlock
                  [
                    (CstVariables
                      []
                      (CstNamedType "bool" [])
                      [
                        CstVariable {
                          cv-name = "usable",
                          cv-value = (Just
                            (CstBinary
                              CstOr
                              (CstBinary CstLess (CstName "capacity" []) (CstNumber "0" CstInt))
                              (CstBinary
                                CstLess
                                (CstBinary
                                  CstAdd
                                  (CstBinary CstMultiply (CstMemberAccess (CstMemberAccess (CstName "element" []) "Position" []) "y" []) (CstName "width" []))
                                  (CstMemberAccess (CstMemberAccess (CstName "element" []) "Position" []) "x" [])
                                )
                                (CstName "capacity" [])
                              )
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstBinary CstNotEqual (CstMemberAccess (CstMemberAccess (CstName "element" []) "gameObject" []) "activeSelf" []) (CstName "usable" []))
                      (CstExpression
                        (CstCall
                          (CstMemberAccess (CstMemberAccess (CstName "element" []) "gameObject" []) "SetActive" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "usable" []) }]
                        )
                      )
                      None
                    )
                  ]
                )
              )
            ]
          )
        )
      }
    )

  valheim-inventory-preview-hovered-link : Integer -> CstMember
  valheim-inventory-preview-hovered-link (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "UpdateHoverConnection",
        cm-type-params = [],
        cm-params = [CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Player" []), cp-name = "player", cp-default = None }],
        cm-body = (Just
          (CstBlock
            [
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "hovered",
                    cv-value = (Just
                      (CstConditional
                        (CstCall (CstMemberAccess (CstName "InventoryGui" []) "IsVisible" []) [])
                        CstNull
                        (CstCall (CstMemberAccess (CstName "player" []) "GetHoverObject" []) [])
                      )
                    )
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "chest",
                    cv-value = (Just
                      (CstConditional (CstName "hovered" []) (CstCall (CstMemberAccess (CstName "hovered" []) "GetComponentInParent" [(CstNamedType "Container" [])]) []) CstNull)
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary
                    CstOr
                    (CstUnary CstNot (CstName "WorkbenchLinks" []))
                    (CstUnary
                      CstNot
                      (CstCall
                        (CstName "Allowed" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                      )
                    )
                  )
                  (CstBinary
                    CstEqual
                    (CstMemberAccess
                      (CstCall
                        (CstMemberAccess (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]) "GetString" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                      )
                      "Length"
                      []
                    )
                    (CstNumber "0" CstInt)
                  )
                )
                (CstBlock
                  [
                    (CstExpression (CstAssignment CstAssign (CstName "hoverChest" []) CstNull)),
                    (CstExpression (CstAssignment CstAssign (CstName "hoverStation" []) CstNull)),
                    (CstExpression (CstAssignment CstAssign (CstName "hoverLookupAt" []) (CstNumber "0" CstInt))),
                    (CstReturn None)
                  ]
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstNotEqual (CstName "chest" []) (CstName "hoverChest" []))
                  (CstBinary CstGreaterEqual (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstName "hoverLookupAt" []))
                )
                (CstBlock
                  [
                    (CstExpression (CstAssignment CstAssign (CstName "hoverChest" []) (CstName "chest" []))),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstName "hoverStation" [])
                        (CstCall (CstName "BoundStation" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }])
                      )
                    ),
                    (CstExpression
                      (CstAssignment
                        CstAssign
                        (CstName "hoverLookupAt" [])
                        (CstBinary CstAdd (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Time" []) "unscaledTime" []) (CstNumber "1" CstInt))
                      )
                    )
                  ]
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstAnd
                  (CstBinary
                    CstAnd
                    (CstName "hoverStation" [])
                    (CstCall
                      (CstName "InRange" [])
                      [
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) },
                        CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "hoverStation" []) }
                      ]
                    )
                  )
                  (CstBinary
                    CstEqual
                    (CstCall
                      (CstMemberAccess (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]) "GetString" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                    )
                    (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "hoverStation" []) }])
                  )
                )
                (CstBlock
                  [
                    (CstExpression
                      (CstCall
                        (CstName "ShowConnection" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "hoverStation" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) }
                        ]
                      )
                    )
                  ]
                )
                None
              )
            ]
          )
        )
      }
    )

