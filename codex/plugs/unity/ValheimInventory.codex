  valheim-inventory-get-chopping-block-prefab : Integer -> CstMember
  valheim-inventory-get-chopping-block-prefab (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "StationExtension" []),
        cm-name = "ChoppingBlock",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstName "chop" []) (CstReturn (Just (CstName "chop" []))) None),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "prefab",
                    cv-value = (Just
                      (CstConditional
                        (CstMemberAccess (CstName "ZNetScene" []) "instance" [])
                        (CstCall
                          (CstMemberAccess (CstMemberAccess (CstName "ZNetScene" []) "instance" []) "GetPrefab" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "piece_workbench_ext1") }]
                        )
                        CstNull
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "chop" [])
                  (CstConditional (CstName "prefab" []) (CstCall (CstMemberAccess (CstName "prefab" []) "GetComponent" [(CstNamedType "StationExtension" [])]) []) CstNull)
                )
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary
                    CstOr
                    (CstUnary CstNot (CstName "chop" []))
                    (CstBinary CstLessEqual (CstMemberAccess (CstName "chop" []) "m_maxStationDistance" []) (CstNumber "0" CstInt))
                  )
                  (CstUnary CstNot (CstMemberAccess (CstName "chop" []) "m_connectionPrefab" []))
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Chopping block connection data unavailable") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstReturn (Just (CstName "chop" [])))
            ]
          )
        )
      }
    )

  valheim-inventory-is-within-workbench-range : Integer -> CstMember
  valheim-inventory-is-within-workbench-range (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "bool" []),
        cm-name = "InRange",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Container" []), cp-name = "chest", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "CraftingStation" []), cp-name = "station", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstBinary CstOr (CstUnary CstNot (CstName "chest" [])) (CstUnary CstNot (CstName "station" []))) (CstReturn (Just (CstBoolean False))) None),
              (CstVariables
                []
                (CstNamedType "float" [])
                [CstVariable { cv-name = "radius", cv-value = (Just (CstMemberAccess (CstCall (CstName "ChoppingBlock" []) []) "m_maxStationDistance" [])) }]
              ),
              (CstReturn
                (Just
                  (CstBinary
                    CstLess
                    (CstMemberAccess
                      (CstParenthesized
                        (CstBinary
                          CstSubtract
                          (CstMemberAccess (CstMemberAccess (CstName "chest" []) "transform" []) "position" [])
                          (CstMemberAccess (CstMemberAccess (CstName "station" []) "transform" []) "position" [])
                        )
                      )
                      "sqrMagnitude"
                      []
                    )
                    (CstBinary CstMultiply (CstName "radius" []) (CstName "radius" []))
                  )
                )
              )
            ]
          )
        )
      }
    )

  valheim-inventory-find-linked-workbench : Integer -> CstMember
  valheim-inventory-find-linked-workbench (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "CraftingStation" []),
        cm-name = "BoundStation",
        cm-type-params = [],
        cm-params = [CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Container" []), cp-name = "chest", cp-default = None }],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstBinary
                  CstOr
                  (CstUnary CstNot (CstName "chest" []))
                  (CstBinary CstEqual (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]) CstNull)
                )
                (CstReturn (Just CstNull))
                None
              ),
              (CstVariables
                []
                (CstNamedType "string" [])
                [
                  CstVariable {
                    cv-name = "id",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]) "GetString" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                      )
                    )
                  }
                ]
              ),
              (CstIf (CstBinary CstEqual (CstMemberAccess (CstName "id" []) "Length" []) (CstNumber "0" CstInt)) (CstReturn (Just CstNull)) None),
              (CstVariables
                []
                (CstNamedType "int" [])
                [
                  CstVariable {
                    cv-name = "count",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Physics" []) "OverlapSphereNonAlloc" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "chest" []) "transform" []) "position" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstCall (CstName "ChoppingBlock" []) []) "m_maxStationDistance" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "collisions" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstUnary CstComplement (CstNumber "0" CstInt)) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "QueryTriggerInteraction" []) "Ignore" []) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstIf
                (CstBinary CstEqual (CstName "count" []) (CstMemberAccess (CstName "collisions" []) "Length" []))
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Nearby construction exceeds the discovery limit") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstVariables [] (CstNamedType "CraftingStation" []) [CstVariable { cv-name = "result", cv-value = (Just CstNull) }]),
              (CstFor
                (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "i", cv-value = (Just (CstNumber "0" CstInt)) }])
                (Just (CstBinary CstLess (CstName "i" []) (CstName "count" [])))
                [(CstUnary CstPostIncrement (CstName "i" []))]
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "station",
                          cv-value = (Just
                            (CstCall
                              (CstMemberAccess
                                (CstIndex (CstName "collisions" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "i" []) }])
                                "GetComponentInParent"
                                [(CstNamedType "CraftingStation" [])]
                              )
                              []
                            )
                          )
                        }
                      ]
                    ),
                    (CstExpression
                      (CstAssignment CstAssign (CstIndex (CstName "collisions" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "i" []) }]) CstNull)
                    ),
                    (CstIf
                      (CstBinary
                        CstAnd
                        (CstBinary
                          CstAnd
                          (CstName "station" [])
                          (CstBinary CstEqual (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]) (CstName "id" []))
                        )
                        (CstCall
                          (CstName "InRange" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                        )
                      )
                      (CstExpression (CstAssignment CstAssign (CstName "result" []) (CstName "station" [])))
                      None
                    )
                  ]
                )
              ),
              (CstReturn (Just (CstName "result" [])))
            ]
          )
        )
      }
    )

  valheim-inventory-find-workbench-containers : Integer -> CstMember
  valheim-inventory-find-workbench-containers (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "List" [(CstNamedType "Container" [])]),
        cm-name = "Linked",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "CraftingStation" []), cp-name = "station", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Player" []), cp-name = "player", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstOr (CstUnary CstNot (CstName "WorkbenchLinks" [])) (CstUnary CstNot (CstName "station" [])))
                  (CstBinary
                    CstEqual
                    (CstMemberAccess (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]) "Length" [])
                    (CstNumber "0" CstInt)
                  )
                )
                (CstReturn (Just (CstObjectNew (CstNamedType "List" [(CstNamedType "Container" [])]) [] [])))
                None
              ),
              (CstVariables
                []
                (CstNamedType "string" [])
                [
                  CstVariable {
                    cv-name = "id",
                    cv-value = (Just (CstCall (CstName "StationId" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]))
                  }
                ]
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "result",
                    cv-value = (Just
                      (CstCall
                        (CstName "Nearby" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "station" []) "transform" []) "position" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstCall (CstName "ChoppingBlock" []) []) "m_maxStationDistance" []) },
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }
                        ]
                      )
                    )
                  }
                ]
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstName "result" []) "RemoveAll" [])
                  [
                    CstArgument {
                      ca-mode = [],
                      ca-name = "",
                      ca-value = (CstLambda
                        [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "c", cp-default = None }]
                        (CstBinary
                          CstOr
                          (CstUnary
                            CstNot
                            (CstCall
                              (CstName "InRange" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "c" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }]
                            )
                          )
                          (CstBinary
                            CstNotEqual
                            (CstCall
                              (CstMemberAccess (CstCall (CstName "Data" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "c" []) }]) "GetString" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "LinkKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                            )
                            (CstName "id" [])
                          )
                        )
                      )
                    }
                  ]
                )
              ),
              (CstIf
                (CstBinary CstGreater (CstMemberAccess (CstName "result" []) "Count" []) (CstName "GroupLimit" []))
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Workbench container limit exceeded") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstReturn (Just (CstName "result" [])))
            ]
          )
        )
      }
    )

  valheim-inventory-get-linked-chest-group : Integer -> CstMember
  valheim-inventory-get-linked-chest-group (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "List" [(CstNamedType "Container" [])]),
        cm-name = "Group",
        cm-type-params = [],
        cm-params = [
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Container" []), cp-name = "chest", cp-default = None },
          CstParameter { cp-modifiers = [], cp-type = (CstNamedType "Player" []), cp-name = "player", cp-default = None }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstUnary
                  CstNot
                  (CstCall
                    (CstName "Allowed" [])
                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                  )
                )
                (CstReturn (Just (CstObjectNew (CstNamedType "List" [(CstNamedType "Container" [])]) [] [])))
                None
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "station",
                    cv-value = (Just (CstCall (CstName "BoundStation" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]))
                  }
                ]
              ),
              (CstIf
                (CstBinary CstOr (CstUnary CstNot (CstName "WorkbenchLinks" [])) (CstUnary CstNot (CstName "station" [])))
                (CstReturn (Just (CstObjectNew (CstNamedType "List" [(CstNamedType "Container" [])]) [] [(CstName "chest" [])])))
                None
              ),
              (CstTry
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "result",
                          cv-value = (Just
                            (CstCall
                              (CstName "Linked" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "station" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "player" []) }]
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstUnary CstNot (CstCall (CstMemberAccess (CstName "result" []) "Contains" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "chest" []) }]))
                      (CstThrow
                        (Just
                          (CstObjectNew
                            (CstNamedType "InvalidOperationException" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Chest moved; reopen the inventory") }]
                            []
                          )
                        )
                      )
                      None
                    ),
                    (CstReturn (Just (CstName "result" [])))
                  ]
                )
                [
                  CstCatch {
                    cc-type = (Just (CstNamedType "InvalidOperationException" [])),
                    cc-name = "error",
                    cc-filter = (Just (CstBinary CstEqual (CstMemberAccess (CstName "error" []) "Message" []) (CstString "Workbench container limit exceeded"))),
                    cc-body = (CstBlock
                      [
                        (CstIf
                          (CstBinary CstNotEqual (CstName "root" []) (CstName "chest" []))
                          (CstExpression
                            (CstCall
                              (CstName "Report" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Workbench has too many links. Unlink chests until at most four remain.") }]
                            )
                          )
                          None
                        ),
                        (CstReturn (Just (CstObjectNew (CstNamedType "List" [(CstNamedType "Container" [])]) [] [(CstName "chest" [])])))
