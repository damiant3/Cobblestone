                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Linked ingredients changed") }]
                                []
                              )
                            )
                          )
                        ]
                      )
                      None
                    ),
                    (CstVariables [] CstInferredType [CstVariable { cv-name = "used", cv-value = (Just (CstObjectNew (CstNamedType "HashSet" [(CstNamedType "int" [])]) [] [])) }]),
                    (CstVariables [] (CstNamedType "long" []) [CstVariable { cv-name = "total", cv-value = (Just (CstNumber "0" CstInt)) }]),
                    (CstForEach
                      CstInferredType
                      "move"
                      (CstCall (CstMemberAccess (CstMemberAccess (CstName "plan" []) "sp_moves" []) "ToArray" []) [])
                      (CstBlock
                        [
                          (CstVariables
                            []
                            (CstNamedType "long" [])
                            [
                              CstVariable { cv-name = "index", cv-value = (Just (CstMemberAccess (CstName "move" []) "sm_index" [])) },
                              CstVariable { cv-name = "expected", cv-value = (Just (CstMemberAccess (CstName "move" []) "sm_expected" [])) },
                              CstVariable { cv-name = "count", cv-value = (Just (CstMemberAccess (CstName "move" []) "sm_amount" [])) }
                            ]
                          ),
                          (CstIf
                            (CstParenthesized
                              (CstBinary
                                CstOr
                                (CstParenthesized
                                  (CstBinary
                                    CstOr
                                    (CstParenthesized
                                      (CstBinary
                                        CstOr
                                        (CstParenthesized (CstBinary CstLess (CstName "index" []) (CstNumber "0" CstInt)))
                                        (CstParenthesized (CstBinary CstGreaterEqual (CstName "index" []) (CstMemberAccess (CstName "slots" []) "Count" [])))
                                      )
                                    )
                                    (CstParenthesized (CstBinary CstLessEqual (CstName "count" []) (CstNumber "0" CstInt)))
                                  )
                                )
                                (CstUnary
                                  CstNot
                                  (CstParenthesized
                                    (CstCall
                                      (CstMemberAccess (CstName "used" []) "Add" [])
                                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "index" []))) }]
                                    )
                                  )
                                )
                              )
                            )
                            (CstBlock
                              [
                                (CstThrow
                                  (Just
                                    (CstObjectNew (CstNamedType "InvalidOperationException" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Invalid ingredient debit") }] [])
                                  )
                                )
                              ]
                            )
                            None
                          ),
                          (CstVariables
                            []
                            CstInferredType
                            [
                              CstVariable {
                                cv-name = "selected",
                                cv-value = (Just
                                  (CstIndex
                                    (CstName "slots" [])
                                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "index" []))) }]
                                  )
                                )
                              }
                            ]
                          ),
                          (CstVariables [] CstInferredType [CstVariable { cv-name = "item", cv-value = (Just (CstMemberAccess (CstName "selected" []) "item" [])) }]),
                          (CstIf
                            (CstParenthesized
                              (CstBinary
                                CstOr
                                (CstParenthesized
                                  (CstBinary
                                    CstOr
                                    (CstParenthesized
                                      (CstBinary
                                        CstOr
                                        (CstParenthesized
                                          (CstBinary
                                            CstOr
                                            (CstParenthesized
                                              (CstBinary
                                                CstOr
                                                (CstParenthesized (CstBinary CstEqual (CstName "item" []) CstNull))
                                                (CstParenthesized
                                                  (CstBinary
                                                    CstNotEqual
                                                    (CstName "expected" [])
                                                    (CstIndex
                                                      (CstName "remaining" [])
                                                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "index" []))) }]
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (CstParenthesized
                                              (CstBinary
                                                CstGreater
                                                (CstName "count" [])
                                                (CstIndex
                                                  (CstName "remaining" [])
                                                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "index" []))) }]
                                                )
                                              )
                                            )
                                          )
                                        )
                                        (CstParenthesized
                                          (CstBinary
                                            CstNotEqual
                                            (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_shared" []) "m_name" [])
                                            (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstName "need" []) "m_resItem" []) "m_itemData" []) "m_shared" []) "m_name" [])
                                          )
                                        )
                                      )
                                    )
                                    (CstParenthesized
                                      (CstParenthesized
                                        (CstBinary
                                          CstAnd
                                          (CstParenthesized (CstBinary CstGreaterEqual (CstName "itemQuality" []) (CstNumber "0" CstInt)))
                                          (CstParenthesized (CstBinary CstNotEqual (CstMemberAccess (CstName "item" []) "m_quality" []) (CstName "itemQuality" [])))
                                        )
                                      )
                                    )
                                  )
                                )
                                (CstParenthesized (CstBinary CstLess (CstMemberAccess (CstName "item" []) "m_worldLevel" []) (CstMemberAccess (CstName "Game" []) "m_worldLevel" [])))
                              )
                            )
                            (CstBlock
                              [
                                (CstThrow
                                  (Just
                                    (CstObjectNew
                                      (CstNamedType "InvalidOperationException" [])
                                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Ingredient plan does not match physical slots") }]
                                      []
                                    )
                                  )
                                )
                              ]
                            )
                            None
                          ),
                          (CstIf
                            (CstParenthesized
                              (CstBinary
                                CstAnd
                                (CstParenthesized
                                  (CstBinary CstNotEqual (CstMemberAccess (CstName "selected" []) "inventory" []) (CstCall (CstMemberAccess (CstName "player" []) "GetInventory" []) []))
                                )
                                (CstMemberAccess (CstName "item" []) "m_cheated" [])
                              )
                            )
                            (CstBlock
                              [
                                (CstThrow
                                  (Just
                                    (CstObjectNew
                                      (CstNamedType "InvalidOperationException" [])
                                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Move marked ingredients into your inventory before crafting") }]
                                      []
                                    )
                                  )
                                )
                              ]
                            )
                            None
                          ),
                          (CstExpression
                            (CstAssignment
                              CstSubtractAssign
                              (CstIndex
                                (CstName "remaining" [])
                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "index" []))) }]
                              )
                              (CstParenthesized (CstCast (CstNamedType "int" []) (CstName "count" [])))
                            )
                          ),
                          (CstExpression
                            (CstAssignment CstAssign (CstName "total" []) (CstChecked True (CstParenthesized (CstBinary CstAdd (CstName "total" []) (CstName "count" [])))))
                          ),
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstName "debits" []) "Add" [])
                              [
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstObjectNew
                                    (CstNamedType "StorageMove" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "index" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "expected" []) },
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "count" []) }
                                    ]
                                    []
                                  )
                                }
                              ]
                            )
                          )
                        ]
                      )
                    ),
                    (CstIf
                      (CstParenthesized (CstBinary CstNotEqual (CstName "total" []) (CstName "amount" [])))
                      (CstBlock
                        [
                          (CstThrow
                            (Just
                              (CstObjectNew
                                (CstNamedType "InvalidOperationException" [])
                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Invalid ingredient conservation") }]
                                []
                              )
                            )
                          )
                        ]
                      )
                      None
                    )
                  ]
                )
              ),
              (CstExpression (CstCall (CstName "CheckSlots" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "slots" []) }])),
              (CstExpression (CstAssignment CstAssign (CstName "consuming" []) (CstBoolean True))),
              (CstTry
                (CstBlock
                  [
                    (CstForEach
                      CstInferredType
                      "move"
                      (CstName "debits" [])
                      (CstBlock
                        [
                          (CstVariables
                            []
                            CstInferredType
                            [
                              CstVariable {
                                cv-name = "s",
                                cv-value = (Just
                                  (CstIndex
                                    (CstName "slots" [])
                                    [
                                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstMemberAccess (CstName "move" []) "sm_index" []))) }
                                    ]
                                  )
                                )
                              }
                            ]
                          ),
                          (CstIf
                            (CstBinary
                              CstAnd
                              (CstName "linkedOnly" [])
                              (CstBinary CstEqual (CstMemberAccess (CstName "s" []) "inventory" []) (CstCall (CstMemberAccess (CstName "player" []) "GetInventory" []) []))
                            )
                            CstContinue
                            None
                          ),
                          (CstIf
                            (CstUnary
                              CstNot
                              (CstParenthesized
                                (CstCall
                                  (CstMemberAccess (CstMemberAccess (CstName "s" []) "inventory" []) "RemoveItem" [])
                                  [
                                    CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "s" []) "item" []) },
                                    CstArgument {
                                      ca-mode = [],
                                      ca-name = "",
                                      ca-value = (CstParenthesized (CstCast (CstNamedType "int" []) (CstMemberAccess (CstName "move" []) "sm_amount" [])))
                                    }
                                  ]
                                )
                              )
                            )
                            (CstBlock
                              [
                                (CstThrow
                                  (Just
                                    (CstObjectNew
                                      (CstNamedType "InvalidOperationException" [])
                                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Game refused ingredient debit") }]
                                      []
                                    )
                                  )
                                )
                              ]
                            )
                            None
                          )
                        ]
                      )
                    )
                  ]
                )
                []
                (Just (CstBlock [(CstExpression (CstAssignment CstAssign (CstName "consuming" []) (CstBoolean False)))]))
              )
            ]
          )
        )
      }
    )

  unity-valheim-construction-members : List (Integer -> CstMember)
  unity-valheim-construction-members = [
    unity-valheim-construction-build-stations,
    unity-valheim-construction-placement-ghost,
    unity-valheim-construction-build-requirements-fn,
    unity-valheim-construction-place-piece-fn,
    unity-valheim-construction-original-build-requirements,
    unity-valheim-construction-original-place-piece,
    unity-valheim-construction-building,
    unity-valheim-construction-building-point,
    unity-valheim-construction-build-preview,
    unity-valheim-construction-build-preview-player,
    unity-valheim-construction-build-preview-point,
    unity-valheim-construction-build-preview-frame,
    unity-valheim-construction-prepare-construction-hooks,
    unity-valheim-construction-placement-point,
    unity-valheim-construction-building-chests,
    unity-valheim-construction-building-available,
    unity-valheim-construction-build-requirements,
    unity-valheim-construction-debit-resources,
    unity-valheim-construction-place-piece
  ]

  unity-valheim-construction-emit : [Console] Nothing
  unity-valheim-construction-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstInternal, CstSealed, CstPartial], ch-name = "PrismStorage", ch-bases = [] }) unity-valheim-construction-members 0
