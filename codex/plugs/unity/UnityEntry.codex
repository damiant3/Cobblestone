                    [CstVariable { cv-name = "args", cv-value = (Just (CstCall (CstMemberAccess (CstName "Environment" []) "GetCommandLineArgs" []) [])) }]
                  ),
                  (CstIf
                    (CstBinary
                      CstGreaterEqual
                      (CstCall
                        (CstMemberAccess (CstName "Array" []) "IndexOf" [])
                        [
