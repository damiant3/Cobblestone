                            CstOr
                            (CstBinary
                              CstOr
                              (CstBinary CstLess (CstName "index" []) (CstNumber "0" CstInt))
                              (CstBinary CstGreaterEqual (CstBinary CstAdd (CstName "index" []) (CstNumber "1" CstInt)) (CstMemberAccess (CstName "args" []) "Length" []))
                            )
                            (CstUnary
                              CstNot
                              (CstCall
