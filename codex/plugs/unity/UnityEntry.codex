                              cv-name = "index",
                              cv-value = (Just
                                (CstCall
                                  (CstMemberAccess (CstName "Array" []) "IndexOf" [])
                                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "args" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "-savedir") }]
