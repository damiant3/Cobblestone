                                  }
                                ]
                              )
                            )
                          )
                          (CstThrow
                            (Just
                              (CstObjectNew
                                (CstNamedType "InvalidOperationException" [])
                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Isolated test save directory missing") }]
                                []
                              )
                            )
