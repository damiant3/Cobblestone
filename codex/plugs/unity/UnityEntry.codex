                                (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstMemberAccess (CstName "System" []) "Security" []) "Cryptography" []) "SHA256" []) "Create" [])
                                []
                              )
                            )
                          }
                        ]
                      )
                      (CstBlock
                        [
                          (CstIf
                            (CstBinary
                              CstNotEqual
                              (CstCall
                                (CstMemberAccess
                                  (CstCall
                                    (CstMemberAccess (CstName "BitConverter" []) "ToString" [])
                                    [
                                      CstArgument {
                                        ca-mode = [],
                                        ca-name = "",
                                        ca-value = (CstCall (CstMemberAccess (CstName "hash" []) "ComputeHash" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "stream" []) }])
                                      }
                                    ]
                                  )
                                  "Replace"
                                  []
                                )
                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "-") }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                              )
