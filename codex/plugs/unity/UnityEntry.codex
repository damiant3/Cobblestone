                      [
                        CstVariable {
                          cv-name = "stream",
                          cv-value = (Just
                            (CstCall
                              (CstMemberAccess (CstName "File" []) "OpenRead" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "game" []) "Location" []) }]
                            )
                          )
