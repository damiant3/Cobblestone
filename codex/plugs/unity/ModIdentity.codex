Chapter: Unity Mod Identity

Section: Typed Interop

  unity-mod-identity-mod-name : Integer -> CstMember
  unity-mod-identity-mod-name (unused) =
    (CstField [] [CstInternal, CstConst] (CstNamedType "string" []) [CstVariable { cv-name = "ModName", cv-value = (Just (CstString "Prism Valheim")) }])

  unity-mod-identity-build-number : Integer -> CstMember
  unity-mod-identity-build-number (unused) =
    (CstField
      []
      [CstInternal, CstConst]
      (CstNamedType "string" [])
      [CstVariable { cv-name = "BuildNumber", cv-value = (Just (CstString "__PRISM_BUILD_NUMBER__")) }]
    )

  unity-mod-identity-instance : Integer -> CstMember
  unity-mod-identity-instance (unused) =
    (CstField [] [CstPrivate, CstStatic] (CstNamedType "PrismModIdentity" []) [CstVariable { cv-name = "instance", cv-value = None }])

  unity-mod-identity-label : Integer -> CstMember
  unity-mod-identity-label (unused) =
    (CstField [] [CstPrivate] (CstNamedType "TMPro.TMP_Text" []) [CstVariable { cv-name = "label", cv-value = None }])

  unity-mod-identity-install : Integer -> CstMember
  unity-mod-identity-install (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstInternal, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "Install",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstName "instance" []) (CstReturn None) None),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "host",
                    cv-value = (Just (CstObjectNew (CstNamedType "UnityEngine.GameObject" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Prism Mod Identity") }] []))
                  }
                ]
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "DontDestroyOnLoad" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "host" []) }]
                )
              ),
              (CstExpression
                (CstAssignment CstAssign (CstName "instance" []) (CstCall (CstMemberAccess (CstName "host" []) "AddComponent" [(CstNamedType "PrismModIdentity" [])]) []))
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstName "instance" []) "InvokeRepeating" [])
                  [
                    CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Refresh") },
                    CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) },
                    CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0.5" CstFloat) }
                  ]
                )
              )
            ]
          )
        )
      }
    )

  unity-mod-identity-refresh : Integer -> CstMember
  unity-mod-identity-refresh (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "Refresh",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstUnary CstNot (CstMemberAccess (CstName "FejdStartup" []) "instance" []))
                (CstBlock
                  [
                    (CstIf
                      (CstName "label" [])
                      (CstExpression
                        (CstCall
                          (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "Destroy" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "label" []) "gameObject" []) }]
                        )
                      )
                      None
                    ),
                    (CstExpression (CstAssignment CstAssign (CstName "label" []) CstNull)),
                    (CstReturn None)
                  ]
                )
                None
              ),
              (CstIf
                (CstBinary CstOr (CstName "label" []) (CstUnary CstNot (CstMemberAccess (CstMemberAccess (CstName "FejdStartup" []) "instance" []) "m_versionLabel" [])))
                (CstReturn None)
                None
              ),
              (CstVariables
                []
                CstInferredType
                [CstVariable { cv-name = "original", cv-value = (Just (CstMemberAccess (CstMemberAccess (CstName "FejdStartup" []) "instance" []) "m_versionLabel" [])) }]
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "label" [])
                  (CstCall
                    (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "Instantiate" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "original" []) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "original" []) "transform" []) "parent" []) }
                    ]
                  )
                )
              ),
              (CstExpression
                (CstAssignment CstAssign (CstMemberAccess (CstMemberAccess (CstName "label" []) "gameObject" []) "name" []) (CstString "PrismModIdentityLabel"))
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "label" []) "text" [])
                  (CstBinary CstAdd (CstBinary CstAdd (CstName "ModName" []) (CstString "  |  Build ")) (CstName "BuildNumber" []))
                )
              ),
              (CstExpression (CstAssignment CstAssign (CstMemberAccess (CstName "label" []) "raycastTarget" []) (CstBoolean False))),
              (CstExpression (CstAssignment CstAssign (CstMemberAccess (CstName "label" []) "enableAutoSizing" []) (CstBoolean False))),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "label" []) "fontSize" [])
                  (CstCall
                    (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Mathf" []) "Max" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "14" CstFloat) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "original" []) "fontSize" []) }
                    ]
                  )
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "label" []) "alignment" [])
                  (CstMemberAccess (CstMemberAccess (CstName "TMPro" []) "TextAlignmentOptions" []) "BottomLeft" [])
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "label" []) "overflowMode" [])
                  (CstMemberAccess (CstMemberAccess (CstName "TMPro" []) "TextOverflowModes" []) "Overflow" [])
                )
              ),
              (CstVariables [] CstInferredType [CstVariable { cv-name = "rect", cv-value = (Just (CstMemberAccess (CstName "label" []) "rectTransform" [])) }]),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "rect" []) "anchorMin" [])
                  (CstObjectNew
                    (CstNamedType "UnityEngine.Vector2" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "rect" []) "anchorMax" [])
                  (CstObjectNew
                    (CstNamedType "UnityEngine.Vector2" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstFloat) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "rect" []) "pivot" [])
                  (CstObjectNew
                    (CstNamedType "UnityEngine.Vector2" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstFloat) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "rect" []) "offsetMin" [])
                  (CstObjectNew
                    (CstNamedType "UnityEngine.Vector2" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "20" CstFloat) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "42" CstFloat) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstMemberAccess (CstName "rect" []) "offsetMax" [])
                  (CstObjectNew
                    (CstNamedType "UnityEngine.Vector2" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstUnary CstNegate (CstNumber "20" CstFloat)) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "74" CstFloat) }
                    ]
                    []
                  )
                )
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "label" []) "gameObject" []) "SetActive" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBoolean True) }]
                )
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Debug" []) "Log" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstAdd (CstString "PRISM MOD IDENTITY: ") (CstMemberAccess (CstName "label" []) "text" [])) }]
                )
              )
            ]
          )
        )
      }
    )

  unity-mod-identity-on-destroy : Integer -> CstMember
  unity-mod-identity-on-destroy (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "OnDestroy",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstName "label" [])
                (CstExpression
                  (CstCall
                    (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Object" []) "Destroy" [])
                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "label" []) "gameObject" []) }]
                  )
                )
                None
              ),
              (CstIf (CstBinary CstEqual (CstName "instance" []) CstThis) (CstExpression (CstAssignment CstAssign (CstName "instance" []) CstNull)) None)
            ]
          )
        )
      }
    )

  unity-mod-identity-members : List (Integer -> CstMember)
  unity-mod-identity-members = [
    unity-mod-identity-mod-name,
    unity-mod-identity-build-number,
    unity-mod-identity-instance,
    unity-mod-identity-label,
    unity-mod-identity-install,
    unity-mod-identity-refresh,
    unity-mod-identity-on-destroy
  ]

  unity-mod-identity-emit : [Console] Nothing
  unity-mod-identity-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstInternal, CstSealed], ch-name = "PrismModIdentity", ch-bases = [(CstNamedType "UnityEngine.MonoBehaviour" [])] }) unity-mod-identity-members 0
