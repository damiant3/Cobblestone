                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstAdd (CstName "MemberPrefix" []) (CstName "kept" [])) },
                            CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "id" []) }
                          ]
                        )
                      )
                      None
                    ),
                    (CstExpression (CstUnary CstPostIncrement (CstName "kept" [])))
                  ]
                )
              ),
              (CstIf (CstBinary CstEqual (CstName "kept" []) (CstName "count" [])) (CstReturn None) None),
              (CstFor
                (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "i", cv-value = (Just (CstName "kept" [])) }])
                (Just (CstBinary CstLess (CstName "i" []) (CstName "count" [])))
                [(CstUnary CstPostIncrement (CstName "i" []))]
                (CstExpression
                  (CstCall
                    (CstMemberAccess (CstName "home" []) "Set" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstBinary CstAdd (CstName "MemberPrefix" []) (CstName "i" [])) },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }
                    ]
                  )
                )
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstName "home" []) "Set" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "MemberCount" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "kept" []) }]
                )
              ),
              (CstIf
                (CstBinary
                  CstAnd
                  (CstBinary
                    CstAnd
                    (CstBinary CstAnd (CstBinary CstEqual (CstName "kept" []) (CstNumber "0" CstInt)) (CstName "killed" []))
                    (CstBinary
                      CstEqual
                      (CstCall
                        (CstMemberAccess (CstName "home" []) "GetLong" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "UntilKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "0" CstInt) }]
                      )
                      (CstNumber "0" CstInt)
                    )
                  )
                  (CstMemberAccess (CstName "EnvMan" []) "instance" [])
                )
                (CstBlock
                  [
                    (CstVariables
                      []
                      (CstNamedType "long" [])
                      [
                        CstVariable {
                          cv-name = "seconds",
                          cv-value = (Just
                            (CstCall
                              (CstCall
                                (CstName "clearanceDelay" [])
                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "EnvMan" []) "instance" []) "m_dayLengthSec" []) }]
                              )
                              [
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstCall (CstMemberAccess (CstName "random" []) "Next" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "8" CstInt) }])
                                }
                              ]
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstBinary CstGreater (CstName "seconds" []) (CstNumber "0" CstInt))
                      (CstBlock
                        [
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstName "home" []) "Set" [])
                              [
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "UntilKey" []) },
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstChecked
                                    True
                                    (CstBinary CstAdd (CstName "now" []) (CstBinary CstMultiply (CstName "seconds" []) (CstMemberAccess (CstName "TimeSpan" []) "TicksPerSecond" [])))
                                  )
                                }
                              ]
                            )
                          ),
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Debug" []) "Log" [])
                              [
                                CstArgument {
                                  ca-mode = [],
                                  ca-name = "",
                                  ca-value = (CstBinary CstAdd (CstBinary CstAdd (CstString "PRISM NECK ZONE CLEARED: next natural population in ") (CstName "seconds" [])) (CstString " game seconds"))
                                }
                              ]
                            )
                          )
                        ]
                      )
                      None
                    )
                  ]
                )
                None
              )
            ]
          )
        )
      }
    )

  unity-meadows-spawns-index-world : Integer -> CstMember
  unity-meadows-spawns-index-world (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "IndexWorld",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstBinary CstEqual (CstName "indexedWorld" []) (CstMemberAccess (CstName "ZDOMan" []) "instance" [])) (CstReturn None) None),
              (CstExpression (CstCall (CstMemberAccess (CstName "records" []) "Clear" []) [])),
              (CstExpression (CstCall (CstMemberAccess (CstName "population" []) "Clear" []) [])),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "objects",
                    cv-value = (Just
                      (CstCast
                        (CstNamedType "Dictionary" [(CstNamedType "ZDOID" []), (CstNamedType "ZDO" [])])
                        (CstCall
                          (CstMemberAccess (CstName "WorldObjects" []) "GetValue" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "ZDOMan" []) "instance" []) }]
                        )
                      )
                    )
                  }
                ]
              ),
              (CstForEach
                CstInferredType
                "data"
                (CstMemberAccess (CstName "objects" []) "Values" [])
                (CstBlock
                  [
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "zone",
                          cv-value = (Just
                            (CstCall
                              (CstMemberAccess (CstName "data" []) "GetString" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "ZoneKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstBinary CstGreater (CstMemberAccess (CstName "zone" []) "Length" []) (CstNumber "0" CstInt))
                      (CstExpression
                        (CstAssignment CstAssign (CstIndex (CstName "records" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "zone" []) }]) (CstName "data" []))
                      )
                      None
                    ),
                    (CstIf (CstBinary CstNotEqual (CstCall (CstMemberAccess (CstName "data" []) "GetPrefab" []) []) (CstName "NeckPrefab" [])) CstContinue None),
                    (CstVariables
                      []
                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "id",
                          cv-value = (Just
                            (CstCall
                              (CstMemberAccess (CstName "data" []) "GetString" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "NeckKey" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }]
                            )
                          )
                        }
                      ]
                    ),
                    (CstIf
                      (CstBinary CstGreater (CstMemberAccess (CstName "id" []) "Length" []) (CstNumber "0" CstInt))
                      (CstExpression
                        (CstAssignment CstAssign (CstIndex (CstName "population" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "id" []) }]) (CstName "data" []))
                      )
                      None
                    )
                  ]
                )
              ),
              (CstExpression (CstAssignment CstAssign (CstName "indexedWorld" []) (CstMemberAccess (CstName "ZDOMan" []) "instance" [])))
            ]
          )
        )
      }
    )

  unity-meadows-spawns-refresh : Integer -> CstMember
  unity-meadows-spawns-refresh (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPrivate],
        cm-result = (CstNamedType "void" []),
        cm-name = "Refresh",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstIf
                (CstBinary CstNotEqual (CstName "world" []) (CstMemberAccess (CstName "ZNet" []) "instance" []))
                (CstBlock
                  [
                    (CstExpression (CstCall (CstName "Clear" []) [])),
                    (CstExpression (CstAssignment CstAssign (CstName "world" []) (CstMemberAccess (CstName "ZNet" []) "instance" [])))
                  ]
                )
                None
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary
                    CstOr
                    (CstBinary CstOr (CstUnary CstNot (CstCall (CstName "Solo" []) [])) (CstUnary CstNot (CstMemberAccess (CstName "EnvMan" []) "instance" [])))
                    (CstBinary CstEqual (CstMemberAccess (CstName "ZDOMan" []) "instance" []) CstNull)
                  )
                  (CstUnary CstNot (CstMemberAccess (CstName "Player" []) "m_localPlayer" []))
                )
                (CstBlock [(CstExpression (CstCall (CstName "Clear" []) [])), (CstReturn None)])
                None
              ),
              (CstExpression (CstCall (CstName "IndexWorld" []) [])),
              (CstExpression (CstCall (CstMemberAccess (CstName "zones" []) "Clear" []) [])),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "systems",
                    cv-value = (Just
                      (CstAs
                        (CstCall (CstMemberAccess (CstName "SpawnInstances" []) "GetValue" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull }])
                        (CstNamedType "List" [(CstNamedType "SpawnSystem" [])])
                      )
                    )
                  }
                ]
              ),
              (CstIf (CstBinary CstEqual (CstName "systems" []) CstNull) (CstReturn None) None),
              (CstForEach
                CstInferredType
                "system"
                (CstName "systems" [])
                (CstBlock
                  [
                    (CstIf (CstUnary CstNot (CstName "system" [])) CstContinue None),
                    (CstVariables
                      []
                      CstInferredType
                      [CstVariable { cv-name = "view", cv-value = (Just (CstCall (CstMemberAccess (CstName "system" []) "GetComponent" [(CstNamedType "ZNetView" [])]) [])) }]
                    ),
                    (CstIf
                      (CstBinary
                        CstAnd
                        (CstBinary CstAnd (CstName "view" []) (CstCall (CstMemberAccess (CstName "view" []) "IsOwner" []) []))
                        (CstBinary CstNotEqual (CstCall (CstMemberAccess (CstName "view" []) "GetZDO" []) []) CstNull)
                      )
                      (CstExpression
                        (CstAssignment
                          CstAssign
                          (CstIndex
                            (CstName "zones" [])
                            [
                              CstArgument {
                                ca-mode = [],
                                ca-name = "",
                                ca-value = (CstCall
                                  (CstMemberAccess (CstName "ZoneSystem" []) "GetZone" [])
                                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstMemberAccess (CstName "system" []) "transform" []) "position" []) }]
                                )
                              }
                            ]
                          )
                          (CstCall (CstMemberAccess (CstName "view" []) "GetZDO" []) [])
                        )
                      )
                      None
                    )
                  ]
                )
              ),
              (CstForEach
                CstInferredType
                "character"
                (CstCall (CstMemberAccess (CstName "Character" []) "GetAllCharacters" []) [])
                (CstExpression
                  (CstCall
                    (CstName "Observe" [])
                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "character" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = CstNull }]
                  )
                )
              ),
              (CstForEach
                CstInferredType
                "home"
                (CstMemberAccess (CstName "zones" []) "Values" [])
                (CstExpression
                  (CstCall
                    (CstName "Reconcile" [])
                    [
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "home" []) },
                      CstArgument {
                        ca-mode = [],
                        ca-name = "",
                        ca-value = (CstMemberAccess (CstCall (CstMemberAccess (CstMemberAccess (CstName "ZNet" []) "instance" []) "GetTime" []) []) "Ticks" [])
                      },
                      CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "") }
                    ]
                  )
                )
              ),
              (CstExpression (CstCall (CstMemberAccess (CstName "removed" []) "Clear" []) [])),
              (CstForEach
                CstInferredType
                "pair"
                (CstName "handlers" [])
                (CstIf
                  (CstBinary
                    CstOr
                    (CstUnary CstNot (CstMemberAccess (CstName "pair" []) "Key" []))
                    (CstCall (CstMemberAccess (CstMemberAccess (CstName "pair" []) "Key" []) "IsDead" []) [])
                  )
                  (CstExpression
                    (CstCall
                      (CstMemberAccess (CstName "removed" []) "Add" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstMemberAccess (CstName "pair" []) "Key" []) }]
                    )
                  )
                  None
                )
              ),
              (CstForEach
                CstInferredType
                "character"
                (CstName "removed" [])
                (CstBlock
                  [
                    (CstExpression
                      (CstAssignment
                        CstSubtractAssign
                        (CstMemberAccess (CstName "character" []) "m_onDeath" [])
                        (CstIndex (CstName "handlers" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "character" []) }])
                      )
                    ),
                    (CstExpression
                      (CstCall (CstMemberAccess (CstName "handlers" []) "Remove" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "character" []) }])
                    )
                  ]
                )
              ),
              (CstExpression (CstCall (CstMemberAccess (CstName "removed" []) "Clear" []) []))
            ]
          )
        )
      }
    )

