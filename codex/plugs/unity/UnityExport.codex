Chapter: Unity Export

Section: Typed Interop

  unity-export-member-0 : Integer -> CstMember
  unity-export-member-0 (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPublic, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "Initialize",
        cm-type-params = [],
        cm-params = [],
        cm-body = (Just
          (CstBlock
            [
              (CstTry
                (CstBlock [(CstExpression (CstCall (CstMemberAccess (CstMemberAccess (CstName "PrismGenerated" []) "PrismUnityEntry" []) "Initialize" []) []))])
                [
                  CstCatch {
                    cc-type = (Just (CstNamedType "System.Exception" [])),
                    cc-name = "error",
                    cc-filter = None,
                    cc-body = (CstBlock
                      [
                        (CstExpression
                          (CstCall
                            (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Debug" []) "LogException" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "error" []) }]
                          )
                        ),
                        (CstVariables
                          []
                          CstInferredType
                          [
                            CstVariable {
                              cv-name = "args",
                              cv-value = (Just (CstCall (CstMemberAccess (CstMemberAccess (CstName "System" []) "Environment" []) "GetCommandLineArgs" []) []))
                            }
                          ]
                        ),
                        (CstIf
                          (CstCall (CstMemberAccess (CstMemberAccess (CstName "PrismGenerated" []) "PrismLocalSaves" []) "Configured" []) [])
                          (CstExpression (CstCall (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Application" []) "Quit" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstInt) }]))
                          None
                        ),
                        (CstIf
                          (CstBinary
                            CstOr
                            (CstBinary
                              CstGreaterEqual
                              (CstCall
                                (CstMemberAccess (CstMemberAccess (CstName "System" []) "Array" []) "IndexOf" [])
                                [
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "args" []) },
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "-prism-storage-test") }
                                ]
                              )
                              (CstNumber "0" CstInt)
                            )
                            (CstBinary
                              CstGreaterEqual
                              (CstCall
                                (CstMemberAccess (CstMemberAccess (CstName "System" []) "Array" []) "IndexOf" [])
                                [
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "args" []) },
                                  CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "-prism-isolated-test") }
                                ]
                              )
                              (CstNumber "0" CstInt)
                            )
                          )
                          (CstExpression
                            (CstCall
                              (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Application" []) "Quit" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstNumber "1" CstInt) }]
                            )
                          )
                          None
                        ),
                        (CstThrow None)
                      ]
                    )
                  }
                ]
                None
              )
            ]
          )
        )
      }
    )

  unity-export-members : List (Integer -> CstMember)
  unity-export-members = [
    unity-export-member-0
  ]

  unity-export-emit : [Console] Nothing
  unity-export-emit = cst-stream-class (CstClassHead { ch-modifiers = [CstPublic, CstStatic], ch-name = "PrismUnityEntry", ch-bases = [] }) unity-export-members 0
