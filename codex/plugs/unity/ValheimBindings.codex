                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "expected" []) },
                                CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "count" []) }
                              ]
                              []
                            )
                          }
                        ]
                      )
                    )
                  ]
                )
              ),
              (CstIf
                (CstBinary
                  CstOr
                  (CstBinary CstOr (CstBinary CstLess (CstName "remainder" []) (CstNumber "0" CstInt)) (CstBinary CstGreater (CstName "remainder" []) (CstName "amount" [])))
