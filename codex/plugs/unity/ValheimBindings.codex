                    (CstBinary CstNotEqual (CstMemberAccess (CstName "remainder" []) "m_stack" []) (CstNumber "29" CstInt))
                  )
                  (CstBinary CstNotEqual (CstMemberAccess (CstCall (CstMemberAccess (CstName "faulty" []) "GetAllItems" []) []) "Count" []) (CstNumber "0" CstInt))
                )
                (CstThrow
                  (Just
                    (CstObjectNew
                      (CstNamedType "InvalidOperationException" [])
                      [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Invalid plan reached the game") }]
                      []
                    )
                  )
                )
                None
              ),
              (CstExpression
                (CstCall
                  (CstMemberAccess (CstMemberAccess (CstName "UnityEngine" []) "Debug" []) "Log" [])
                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "PRISM STORAGE INVENTORY TEST PASS") }]
                )
              )
            ]
          )
        )
      }
    )

