                                  CstArgument { ca-mode = [CstOut], ca-name = "", ca-value = (CstName "item" []) }
                                ]
                              )
                            ),
                            (CstIf
                              (CstBinary CstGreaterEqual (CstMemberAccess (CstName "result" []) "Count" []) (CstNumber "8192" CstInt))
                              (CstThrow
                                (Just
                                  (CstObjectNew
                                    (CstNamedType "InvalidOperationException" [])
                                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Linked storage slot limit exceeded") }]
                                    []
                                  )
                                )
                              )
                              None
                            ),
                            (CstExpression
                              (CstCall
                                (CstMemberAccess (CstName "result" []) "Add" [])
                                [
                                  CstArgument {
                                    ca-mode = [],
                                    ca-name = "",
                                    ca-value = (CstObjectNew
                                      (CstNamedType "Slot" [])
                                      []
                                      [
                                        (CstAssignment CstAssign (CstName "inventory" []) (CstName "inv" [])),
                                        (CstAssignment CstAssign (CstName "x" []) (CstName "x" [])),
                                        (CstAssignment CstAssign (CstName "y" []) (CstName "y" [])),
                                        (CstAssignment CstAssign (CstName "width" []) (CstName "width" [])),
                                        (CstAssignment CstAssign (CstName "height" []) (CstName "height" [])),
                                        (CstAssignment CstAssign (CstName "item" []) (CstName "item" [])),
