                                  []
                                )
                              )
                            )
                            None
                          )
                        ]
                      )
                    ),
                    (CstIf
                      (CstBinary
                        CstNotEqual
                        (CstMemberAccess (CstName "item" []) "m_stack" [])
                        (CstBinary
                          CstSubtract
                          (CstName "original" [])
                          (CstParenthesized (CstBinary CstSubtract (CstName "amount" []) (CstCast (CstNamedType "int" []) (CstName "remainder" []))))
