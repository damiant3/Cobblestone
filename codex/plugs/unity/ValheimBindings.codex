              (CstExpression
                (CstAssignment
                  CstAssign
                  (CstName "originalRequirements" [])
                  (CstCall
                    (CstMemberAccess (CstName "PrismMethodBridge" []) "Copy" [(CstNamedType "RequirementsFn" [])])
                    [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "req" []) }]
                  )
