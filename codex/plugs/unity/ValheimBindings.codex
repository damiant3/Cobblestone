                                [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "item" []) }]
                              )
                            )
                          )
                        )
                      )
                      (CstThrow
                        (Just
                          (CstObjectNew
                            (CstNamedType "InvalidOperationException" [])
                            [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Deposit plan does not match physical slots") }]
                            []
                          )
                        )
                      )
                      None
                    ),
                    (CstExpression (CstAssignment CstAssign (CstName "total" []) (CstChecked True (CstBinary CstAdd (CstName "total" []) (CstName "count" []))))),
