                      CstInferredType
                      [
                        CstVariable {
                          cv-name = "byPosition",
                          cv-value = (Just (CstObjectNew (CstNamedType "Dictionary" [(CstNamedType "int" []), (CstNamedType "ItemDrop.ItemData" [])]) [] []))
                        }
                      ]
                    ),
                    (CstForEach
                      CstInferredType
                      "item"
                      (CstCall (CstMemberAccess (CstName "inv" []) "GetAllItems" []) [])
                      (CstBlock
                        [
                          (CstVariables
                            []
                            (CstNamedType "int" [])
                            [
                              CstVariable {
                                cv-name = "key",
                                cv-value = (Just
                                  (CstBinary
                                    CstAdd
                                    (CstBinary CstMultiply (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "y" []) (CstName "width" []))
                                    (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "x" [])
                                  )
                                )
                              }
                            ]
                          ),
                          (CstIf
                            (CstBinary
                              CstOr
                              (CstBinary
                                CstOr
                                (CstBinary
                                  CstOr
                                  (CstBinary
                                    CstOr
                                    (CstBinary CstLess (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "x" []) (CstNumber "0" CstInt))
                                    (CstBinary CstGreaterEqual (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "x" []) (CstName "width" []))
                                  )
                                  (CstBinary CstLess (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "y" []) (CstNumber "0" CstInt))
                                )
                                (CstBinary CstGreaterEqual (CstMemberAccess (CstMemberAccess (CstName "item" []) "m_gridPos" []) "y" []) (CstName "height" []))
                              )
                              (CstCall (CstMemberAccess (CstName "byPosition" []) "ContainsKey" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "key" []) }])
                            )
                            (CstThrow
                              (Just
                                (CstObjectNew
                                  (CstNamedType "InvalidOperationException" [])
                                  [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Inventory slot layout changed") }]
