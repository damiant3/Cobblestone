              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "craft",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstTypeOf (CstNamedType "InventoryGui" [])) "GetMethod" [])
                        [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "DoCrafting") }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "Flags" []) }]
                      )
