              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "consume",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstTypeOf (CstNamedType "Player" [])) "GetMethod" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "ConsumeResources") },
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstArrayNew
                              (CstNamedType "Type" [])
                              []
                              [
                                (CstTypeOf (CstArrayType (CstNamedType "Piece.Requirement" []) 1)),
                                (CstTypeOf (CstNamedType "int" [])),
                                (CstTypeOf (CstNamedType "int" [])),
                                (CstTypeOf (CstNamedType "int" []))
                              ]
