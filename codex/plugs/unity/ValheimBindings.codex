                            []
                          )
                        )
                      )
                      None
                    ),
                    (CstIf
                      (CstBinary CstEqual (CstMemberAccess (CstName "item" []) "m_stack" []) (CstNumber "0" CstInt))
                      (CstExpression (CstCall (CstMemberAccess (CstName "from" []) "RemoveItem" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "item" []) }]))
                      (Just (CstExpression (CstCall (CstName "Notify" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "from" []) }])))
                    ),
                    (CstExpression
