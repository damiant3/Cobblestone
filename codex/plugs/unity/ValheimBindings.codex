          (CstBlock
            [
              (CstVariables [] CstInferredType [CstVariable { cv-name = "result", cv-value = (Just (CstObjectNew (CstNamedType "List" [(CstNamedType "Slot" [])]) [] [])) }]),
              (CstForEach
                CstInferredType
                "inv"
                (CstName "inventories" [])
