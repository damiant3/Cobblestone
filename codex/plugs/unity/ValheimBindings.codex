  valheim-storage-install-storage-hooks : Integer -> CstMember
  valheim-storage-install-storage-hooks (unused) =
    (CstMethod
      CstMethodSpec {
        cm-attributes = [],
        cm-modifiers = [CstPublic, CstStatic],
        cm-result = (CstNamedType "void" []),
        cm-name = "Install",
        cm-type-params = [],
        cm-params = [
          CstParameter {
            cp-modifiers = [],
            cp-type = (CstNamedType
              "Func"
              [(CstNamedType "List" [(CstNamedType "StorageSlot" [])]), (CstNamedType "Func" [(CstNamedType "long" []), (CstNamedType "StoragePlan" [])])]
            ),
            cp-name = "deposit",
            cp-default = None
          },
          CstParameter {
            cp-modifiers = [],
            cp-type = (CstNamedType
              "Func"
              [(CstNamedType "List" [(CstNamedType "StorageSlot" [])]), (CstNamedType "Func" [(CstNamedType "long" []), (CstNamedType "StoragePlan" [])])]
            ),
            cp-name = "withdraw",
            cp-default = None
          }
        ],
        cm-body = (Just
          (CstBlock
            [
              (CstIf (CstName "instance" []) (CstBlock [(CstReturn None)]) None),
              (CstExpression (CstAssignment CstAssign (CstName "planDeposit" []) (CstName "deposit" []))),
              (CstExpression (CstAssignment CstAssign (CstName "planWithdraw" []) (CstName "withdraw" []))),
              (CstIf
                (CstParenthesized
                  (CstBinary
                    CstOr
                    (CstParenthesized
                      (CstBinary
                        CstOr
                        (CstParenthesized
                          (CstBinary
                            CstOr
                            (CstParenthesized
                              (CstBinary
                                CstOr
                                (CstParenthesized
                                  (CstBinary
                                    CstOr
                                    (CstParenthesized
                                      (CstBinary
                                        CstOr
                                        (CstParenthesized (CstBinary CstEqual (CstName "CurrentContainer" []) CstNull))
                                        (CstParenthesized (CstBinary CstEqual (CstName "PlayerInventory" []) CstNull))
                                      )
                                    )
                                    (CstParenthesized (CstBinary CstEqual (CstName "CraftRecipe" []) CstNull))
                                  )
                                )
                                (CstParenthesized (CstBinary CstEqual (CstName "CraftUpgrade" []) CstNull))
                              )
                            )
                            (CstParenthesized (CstBinary CstEqual (CstName "ContainerAccess" []) CstNull))
                          )
                        )
                        (CstParenthesized (CstBinary CstEqual (CstName "InventoryChanged" []) CstNull))
                      )
                    )
                    (CstParenthesized (CstBinary CstEqual (CstName "InventoryAddAt" []) CstNull))
                  )
                )
                (CstBlock
                  [
                    (CstThrow
                      (Just
                        (CstObjectNew
                          (CstNamedType "InvalidOperationException" [])
                          [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "Valheim storage binding unavailable") }]
                          []
                        )
                      )
                    )
                  ]
                )
                None
              ),
              (CstVariables
                []
                CstInferredType
                [
                  CstVariable {
                    cv-name = "req",
                    cv-value = (Just
                      (CstCall
                        (CstMemberAccess (CstTypeOf (CstNamedType "Player" [])) "GetMethod" [])
                        [
                          CstArgument { ca-mode = [], ca-name = "", ca-value = (CstString "HaveRequirements") },
                          CstArgument {
                            ca-mode = [],
                            ca-name = "",
                            ca-value = (CstArrayNew
                              (CstNamedType "Type" [])
