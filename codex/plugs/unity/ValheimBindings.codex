                                        (CstNamedType "object" [])
                                        []
                                        [
                                          (CstName "item" []),
                                          (CstCast (CstNamedType "int" []) (CstMemberAccess (CstName "move" []) "sm_amount" [])),
                                          (CstMemberAccess (CstName "s" []) "x" []),
                                          (CstMemberAccess (CstName "s" []) "y" []),
