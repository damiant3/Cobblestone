                                ca-name = "",
                                ca-value = (CstLambda
                                  [CstParameter { cp-modifiers = [], cp-type = CstInferredType, cp-name = "x", cp-default = None }]
                                  (CstObjectNew (CstNamedType "InventorySnapshot" []) [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "x" []) }] [])
                                )
                              }
                            ]
                          )
                          "ToArray"
                          []
                        )
                        []
                      )
                    )
                  }
                ]
              ),
              (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "original", cv-value = (Just (CstMemberAccess (CstName "item" []) "m_stack" [])) }]),
              (CstExpression (CstAssignment CstAssign (CstName "transaction" []) (CstBoolean True))),
              (CstTry
                (CstBlock
                  [
                    (CstForEach
                      CstInferredType
                      "move"
                      (CstName "moves" [])
