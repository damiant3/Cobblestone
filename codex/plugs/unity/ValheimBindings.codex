                            (CstCall
                              (CstMemberAccess (CstName "byPosition" []) "Add" [])
                              [CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "key" []) }, CstArgument { ca-mode = [], ca-name = "", ca-value = (CstName "item" []) }]
                            )
                          )
                        ]
                      )
                    ),
                    (CstFor
                      (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "y", cv-value = (Just (CstNumber "0" CstInt)) }])
                      (Just (CstBinary CstLess (CstName "y" []) (CstName "height" [])))
                      [(CstUnary CstPostIncrement (CstName "y" []))]
                      (CstFor
                        (CstVariables [] (CstNamedType "int" []) [CstVariable { cv-name = "x", cv-value = (Just (CstNumber "0" CstInt)) }])
                        (Just (CstBinary CstLess (CstName "x" []) (CstName "width" [])))
                        [(CstUnary CstPostIncrement (CstName "x" []))]
                        (CstBlock
