Chapter: ListSetAtRt

 `list-set-at` MUTATES IN PLACE. The compiler's skip list links its nodes
 purely by that side effect -- `splice-new-node` discards both results and
 returns the list unchanged -- so a copying implementation leaves every
 insert structurally invisible while the size counter still advances.

  Holder = record {
   cells : List Integer
  }

  clobber : List Integer -> Integer
  clobber (xs) =
   let ignored = list-set-at xs 1 99
   in 0

  clobber-field : Holder -> Integer
  clobber-field (h) =
   let ignored = list-set-at (h.cells) 2 77
   in 0

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else show-list xs (i + 1) (acc & " " & show (list-at xs i))

  opening : [Console] Nothing = act
   let xs = [10, 20, 30]
   in let d1 = clobber xs
   in let h = Holder { cells = [1, 2, 3] }
   in let d2 = clobber-field h
   in let ret = list-set-at xs 0 5
   in act
    print-line-uni ("after discarded set" & show-list xs 0 "")
    print-line-uni ("through field" & show-list (h.cells) 0 "")
    print-line-uni ("returned is same" & show-list ret 0 "")
    print-line-uni ("original sees it" & show-list xs 0 "")
   end
  end
