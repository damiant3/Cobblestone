Chapter: FieldOrderRt

 A record constructed with its fields written in a DIFFERENT order than the
 type declares them. The store offset must follow the DECLARED index, not the
 position the field was written in.

  Rec = record {
   a : Integer,
   b : Integer,
   c : Integer,
   d : Text
  }

  make-ordered : Integer -> Rec
  make-ordered (n) = Rec { a = 1, b = 2, c = 3, d = "ordered" }

  make-shuffled : Integer -> Rec
  make-shuffled (n) = Rec { d = "shuffled", c = 33, a = 11, b = 22 }

  opening : [Console] Nothing = act
   let o = make-ordered 0
   in let s = make-shuffled 0
   in act
    print-line-uni ("ordered a " & show (o.a))
    print-line-uni ("ordered b " & show (o.b))
    print-line-uni ("ordered c " & show (o.c))
    print-line-uni ("ordered d " & (o.d))
    print-line-uni ("shuffled a " & show (s.a))
    print-line-uni ("shuffled b " & show (s.b))
    print-line-uni ("shuffled c " & show (s.c))
    print-line-uni ("shuffled d " & (s.d))
   end
  end
