Chapter: ActTailRt

 The sidecar pins the stack to a browser worker's megabyte, and the depths are
 far past what that many real frames fit, so an ordinary call in an `act`
 block's last statement cannot pass.

  loop-act : Integer, Integer -> [Console] Integer
  loop-act (i) (len) =
   if i == len then i
   else act
    let step = i + 1
    in loop-act step len
   end

  ping-act : Integer -> [Console] Integer
  ping-act (n) =
   if n <= 0 then 0
   else act
    let m = n - 1
    in pong-act m
   end

  pong-act : Integer -> [Console] Integer
  pong-act (n) =
   if n <= 0 then 1
   else act
    let m = n - 1
    in ping-act m
   end

  opening : [Console] Nothing = act
   r <- loop-act 0 300000
   print-line-uni (show r)
   p <- ping-act 300000
   print-line-uni (show p)
   q <- pong-act 300001
   print-line-uni (show q)
  end
