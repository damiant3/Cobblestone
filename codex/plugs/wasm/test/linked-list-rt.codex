Chapter: LinkedListRt

  build-ll : LinkedList Integer, Integer, Integer -> LinkedList Integer
  build-ll (ll) (i) (n) =
   if i > n then ll
   else build-ll (__linked-list-push ll i) (i + 1) n

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else show-list xs (i + 1) (acc & show (list-at xs i) & " ")

  opening : [Console] Nothing = act
   let xs = __linked-list-to-list (build-ll (__linked-list-empty 8) 1 4)
   in print-line-uni ("order: " & show-list xs 0 "")
   print-line-uni ("empty len: " & show (list-length (__linked-list-to-list (__linked-list-empty 4))))
   print-line-uni ("concat: " & text-concat-list ["ab", "cd", "ef"])
   print-line-uni ("concat empty: [" & text-concat-list [] & "]")
   print-line-uni ("concat hole: [" & text-concat-list ["ab", "", "cd", "", ""] & "]")
   print-line-uni ("concat one: [" & text-concat-list ["solo"] & "]")
   print-line-uni ("concat len: " & show (text-length (text-concat-list ["aaa", "bbbb", "c"])))
   let big = __linked-list-to-list (build-ll (__linked-list-empty 4) 1 12)
   in print-line-uni ("big: " & show-list big 0 "")
  end
