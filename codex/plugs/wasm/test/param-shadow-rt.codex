Chapter: ParamShadowRt

  shadow-once : Integer -> Integer
  shadow-once (p) =
   let p = p + 10
   in p * 2

  shadow-twice : Integer, Integer -> Integer
  shadow-twice (p) (q) =
   let p = p + q
   in let p = p * 3
   in p + q

  shadow-text : Text -> Text
  shadow-text (s) =
   let s = s & "-inner"
   in s & "-tail"

  opening : [Console] Nothing = act
   print-line-uni ("shadow-once 5: " & show (shadow-once 5))
   print-line-uni ("shadow-twice 4 6: " & show (shadow-twice 4 6))
   print-line-uni ("shadow-text: " & shadow-text "base")
  end
