Chapter: TextCompareRt

 The skip list orders and searches by `text-compare`, so a wrong sign makes
 every lookup miss a key that is present.

  sgn : Integer -> Integer
  sgn (n) = if n < 0 then 0 - 1 else if n > 0 then 1 else 0

  opening : [Console] Nothing = act
   print-line-uni ("aa vs ab " & show (sgn (text-compare "aa" "ab")))
   print-line-uni ("ab vs aa " & show (sgn (text-compare "ab" "aa")))
   print-line-uni ("aa vs aa " & show (sgn (text-compare "aa" "aa")))
   print-line-uni ("a vs aa " & show (sgn (text-compare "a" "aa")))
   print-line-uni ("aa vs a " & show (sgn (text-compare "aa" "a")))
   print-line-uni ("double vs opening " & show (sgn (text-compare "double" "opening")))
   print-line-uni ("opening vs double " & show (sgn (text-compare "opening" "double")))
   print-line-uni ("empty vs a " & show (sgn (text-compare "" "a")))
   print-line-uni ("a vs empty " & show (sgn (text-compare "a" "")))
   print-line-uni ("abs vs abt " & show (sgn (text-compare "abs" "abt")))
  end
