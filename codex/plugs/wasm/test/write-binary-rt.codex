Chapter: WriteBinaryRt

  opening : [Console] Nothing = act
   write-binary [108, 105, 115, 116, 58, 79, 75, 10]
   let buf = alloc-bytes 16
   in let w = __buf-write-bytes buf 0 [98, 117, 102, 58, 79, 75, 10]
   in write-binary-buf buf 0 7
   let buf2 = alloc-bytes 16
   in let w2 = __buf-write-bytes buf2 0 [120, 121, 122, 58, 79, 75, 10]
   in write-binary-buf buf2 3 4
   print-line-uni "text after bytes"
  end
