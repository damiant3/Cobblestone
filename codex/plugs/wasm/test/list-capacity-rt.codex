Chapter: ListCapacityRt

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else show-list xs (i + 1) (acc & show (list-at xs i) & " ")

  fill : List Integer, Integer, Integer -> List Integer
  fill (xs) (i) (n) =
   if i > n then xs
   else fill (list-push xs i) (i + 1) n

  insert-each : List Integer, Integer, Integer -> List Integer
  insert-each (xs) (i) (n) =
   if i > n then xs
   else insert-each (list-insert-at xs 0 i) (i + 1) n

  opening : [Console] Nothing = act
   let empty = __list-with-capacity 8
   in print-line-uni ("cap empty len: " & show (list-length empty))
   let base = fill (__list-with-capacity 8) 1 4
   in print-line-uni ("filled: " & show-list base 0 "")
   let front = list-insert-at base 0 99
   in print-line-uni ("front: " & show-list front 0 "")
   let mid = list-insert-at base 2 99
   in print-line-uni ("mid: " & show-list mid 0 "")
   let tail = list-insert-at base (list-length base) 99
   in print-line-uni ("append at len: " & show-list tail 0 "")
   let one = list-insert-at (__list-with-capacity 0) 0 7
   in print-line-uni ("into empty: " & show-list one 0 "")
   print-line-uni ("prepends: " & show-list (insert-each (__list-with-capacity 0) 1 6) 0 "")
   let grown = fill (__list-with-capacity 2) 1 6
   in print-line-uni ("grown past cap: " & show-list grown 0 "")
   print-line-uni ("base after inserts, ALIASED not copied: " & show-list base 0 "")
  end
