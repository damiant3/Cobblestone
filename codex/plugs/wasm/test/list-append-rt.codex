Chapter: ListAppendRt

 `&` on lists and `::` are distinct operators from text append. With no arm
 for them the emitter fell through to integer addition, so appending two
 lists added their pointers.

  sum-list : List Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else sum-list xs (i + 1) (acc + list-at xs i)

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else show-list xs (i + 1) (acc & " " & show (list-at xs i))

  opening : [Console] Nothing = act
   let a = [1, 2, 3]
   in let b = [4, 5]
   in let both = a & b
   in let consed = 0 :: both
   in let empty-left = [] & b
   in let empty-right = a & []
   in act
    print-line-uni ("both len " & show (list-length both))
    print-line-uni ("both" & show-list both 0 "")
    print-line-uni ("both sum " & show (sum-list both 0 0))
    print-line-uni ("consed len " & show (list-length consed))
    print-line-uni ("consed" & show-list consed 0 "")
    print-line-uni ("empty-left" & show-list empty-left 0 "")
    print-line-uni ("empty-right" & show-list empty-right 0 "")
    print-line-uni ("a unchanged" & show-list a 0 "")
    print-line-uni ("b unchanged" & show-list b 0 "")
   end
  end
