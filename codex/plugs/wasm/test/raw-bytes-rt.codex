Chapter: RawBytesRt

  opening : [Console] Nothing = act
   print-line-uni ("three: " & raw-bytes-to-text [72, 105, 33])
   print-line-uni ("two: " & raw-bytes-to-text [20, 17])
   print-line-uni ("length: " & show (text-length (raw-bytes-to-text [72, 105, 33])))
   print-line-uni ("code at 0: " & show (char-code (char-at (raw-bytes-to-text [72, 105, 33]) 0)))
   print-line-uni ("empty: [" & raw-bytes-to-text [] & "]")
   print-line-uni ("truncates: " & show (char-code (char-at (raw-bytes-to-text [321]) 0)))
  end
