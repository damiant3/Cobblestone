Chapter: DeckReclaimRt

 The six allocator primitives are the contract `phase-compact` runs on, and a
 target that answers them with a constant or an alias reports success while
 reclaiming nothing. Every reading here is a COMPARISON rather than an
 address, so the two targets can be graded against each other at all.

  build-list : Integer, List Integer -> List Integer
  build-list (n) (acc) =
   if n <= 0 then acc
   else build-list (n - 1) (n :: acc)

  sum-list : List Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else sum-list xs (i + 1) (acc + list-at xs i)

  opening : [Console] Nothing = act
   let base = __heap-save
   in let deck-init = __deck-set base
   in let reserved = __heap-advance 65536
   in let entered = __deck-enter
   in let kept = build-list 8 []
   in let exited = __deck-exit
   in let deck-frontier = __deck-pos
   in let scratch = build-list 400 []
   in let high = __heap-save
   in let compacted = __heap-restore (__deck-pos)
   in let low = __heap-save
   in let after = build-list 400 []
   in act
    print-line-uni ("deck advanced past base " & show (deck-frontier > base))
    print-line-uni ("deck below bivy high " & show (deck-frontier < high))
    print-line-uni ("scratch raised the mark " & show (high > deck-frontier))
    print-line-uni ("compact lowered the mark " & show (low < high))
    print-line-uni ("compact landed on the deck " & show (low == deck-frontier))
    print-line-uni ("kept len " & show (list-length kept))
    print-line-uni ("kept sum " & show (sum-list kept 0 0))
    print-line-uni ("scratch sum " & show (sum-list scratch 0 0))
    print-line-uni ("after sum " & show (sum-list after 0 0))
    print-line-uni ("kept survives reuse " & show (sum-list kept 0 0 == 36))
   end
  end
