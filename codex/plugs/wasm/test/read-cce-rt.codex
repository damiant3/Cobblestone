Chapter: ReadCceRt
  cites Foreword chapter Maybe

  show-one : Integer -> [Console] Nothing
  show-one (n) = act
   r <- read-line-cce
   when r
    is Just (line) -> print-line-uni (show n & " got [" & line & "] len " & show (text-length line))
    is None -> print-line-uni (show n & " none")
  end

  opening : [Console] Nothing = act
   show-one 1
   show-one 2
   show-one 3
  end