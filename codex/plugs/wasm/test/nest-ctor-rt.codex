Chapter: NestCtorRt

  Kind =
    | Zed
    | One (Integer)

  Tok = record {
   kind : Kind,
   len : Integer
  }

  Res = record {
   first : Tok,
   note : Text
  }

  mk-tok : Kind, Integer -> Tok
  mk-tok (k) (n) = Tok { kind = k, len = n }

  kind-tag : Kind -> Integer
  kind-tag (k) =
   when k
    is Zed -> 0
    is One (v) -> v

  opening : [Console] Nothing = act
   let r = Res { first = mk-tok Zed 7, note = "note" }
   in act
    print-line-uni ("nested ctor tag: " & show (kind-tag ((r.first).kind)))
    print-line-uni ("nested ctor len: " & show ((r.first).len))
    print-line-uni ("note: " & r.note)
   end
   let r2 = Res { first = mk-tok (One 5) 9, note = "two" }
   in act
    print-line-uni ("payload tag: " & show (kind-tag ((r2.first).kind)))
    print-line-uni ("payload len: " & show ((r2.first).len))
    print-line-uni ("note2: " & r2.note)
   end
   let xs = [mk-tok Zed 1, mk-tok (One 3) 2]
   in act
    print-line-uni ("list len: " & show (list-length xs))
    print-line-uni ("elem0 len: " & show ((list-at xs 0).len))
    print-line-uni ("elem1 tag: " & show (kind-tag ((list-at xs 1).kind)))
   end
  end