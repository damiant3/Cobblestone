Chapter: WideRecordRt

  Wide = record {
   f0 : List Integer,
   f1 : List Integer,
   f2 : List Integer,
   f3 : List Integer,
   f4 : List Integer,
   f5 : List Integer,
   f6 : List Integer,
   f7 : List Integer,
   f8 : List Integer,
   f9 : Text,
   f10 : List Integer,
   f11 : Text,
   f12 : List Integer,
   f13 : List Integer,
   f14 : Integer
  }

  make-wide : List Integer -> Wide
  make-wide (xs) = Wide {
   f0 = xs,
   f1 = [],
   f2 = [],
   f3 = [],
   f4 = [],
   f5 = xs,
   f6 = [],
   f7 = [],
   f8 = [],
   f9 = "nine",
   f10 = [],
   f11 = "eleven",
   f12 = [],
   f13 = [],
   f14 = 14
  }

  opening : [Console] Nothing = act
   let w = make-wide [7, 8]
   in act
    print-line-uni ("f0 " & show (list-length (w.f0)))
    print-line-uni ("f1 " & show (list-length (w.f1)))
    print-line-uni ("f2 " & show (list-length (w.f2)))
    print-line-uni ("f3 " & show (list-length (w.f3)))
    print-line-uni ("f4 " & show (list-length (w.f4)))
    print-line-uni ("f5 " & show (list-length (w.f5)))
    print-line-uni ("f6 " & show (list-length (w.f6)))
    print-line-uni ("f7 " & show (list-length (w.f7)))
    print-line-uni ("f8 " & show (list-length (w.f8)))
    print-line-uni ("f9 " & (w.f9))
    print-line-uni ("f10 " & show (list-length (w.f10)))
    print-line-uni ("f11 " & (w.f11))
    print-line-uni ("f12 " & show (list-length (w.f12)))
    print-line-uni ("f13 " & show (list-length (w.f13)))
    print-line-uni ("f14 " & show (w.f14))
   end
  end
