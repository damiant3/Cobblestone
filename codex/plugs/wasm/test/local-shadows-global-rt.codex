Chapter: LocalShadowsGlobalRt

 A parameter and a let binding that share a name with top-level definitions.
 Locals shadow globals, so these must read the bound value and not the
 definition's funcref index.

  Holder = record {
   one : Integer,
   two : Integer
  }

  ch : Integer, Integer, Integer -> Integer
  ch (x) (y) (z) = 9000 + x + y + z

  mc : Integer -> Integer
  mc (x) = 7000 + x

  read-holder : Holder -> Integer
  read-holder (ch) = (ch.one) + (ch.two)

  use-let : Integer -> Integer
  use-let (n) = let mc = n + 5 in mc + 1

  opening : [Console] Nothing = act
   print-line-uni ("global ch " & show (ch 1 2 3))
   print-line-uni ("global mc " & show (mc 4))
   print-line-uni ("param shadow " & show (read-holder (Holder { one = 11, two = 22 })))
   print-line-uni ("let shadow " & show (use-let 10))
  end
