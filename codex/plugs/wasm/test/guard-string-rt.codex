Chapter: GuardStringRt

 A text literal that appears ONLY in a match-branch guard. The literals are
 built at run time, "zeb" & "ra", so no constant folding can decide the
 comparison before it reaches the string table.

  Box =
    | Boxed (Text)

  classify : Text -> Text
  classify (v) =
   when Boxed v
    is Boxed (x) when x == "zebra" -> "yes"
    is otherwise -> "no"

  opening : [Console] Nothing = act
   print-line-uni ("zebra " & classify ("zeb" & "ra"))
   print-line-uni ("other " & classify ("no" & "pe"))
  end
