Chapter: PowIntRt

 `a ^ b` on integers, built from values the folder cannot see through.

  base : Integer -> Integer
  base (n) = n + 2

  opening : [Console] Nothing = act
   print-line-uni ("2^10 " & show (base 0 ^ 10))
   print-line-uni ("7^0 " & show (base 5 ^ 0))
   print-line-uni ("0^5 " & show (base (0 - 2) ^ 5))
   print-line-uni ("-3^3 " & show (base (0 - 5) ^ 3))
   print-line-uni ("1^63 " & show (base (0 - 1) ^ 63))
   print-line-uni ("2^-1 " & show (base 0 ^ (0 - 1)))
  end
