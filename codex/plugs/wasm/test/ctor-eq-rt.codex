Chapter: CtorEqRt

  Shape =
    | Dot
    | Box (Integer)

  Tagged =
    | Named (Text)
    | Anon

  opening : [Console] Nothing = act
   print-line-uni ("show True: " & show True)
   print-line-uni ("show False: " & show False)
   print-line-uni ("1 == 1: " & show (1 == 1))
   print-line-uni ("1 == 2: " & show (1 == 2))
   print-line-uni ("nullary same: " & show (Dot == Dot))
   print-line-uni ("field same: " & show (Box 7 == Box 7))
   print-line-uni ("field differ: " & show (Box 7 == Box 9))
   print-line-uni ("tag differ: " & show (Dot == Box 7))
   print-line-uni ("not-eq same: " & show (Box 7 /= Box 7))
   print-line-uni ("not-eq differ: " & show (Box 7 /= Box 9))
   print-line-uni ("text field same: " & show (Named "ab" == Named "ab"))
   print-line-uni ("text field differ: " & show (Named "ab" == Named "cd"))
   print-line-uni ("text vs nullary: " & show (Named "ab" == Anon))
  end