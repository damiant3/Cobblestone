Chapter: ReadLineRt
  cites Foreword chapter Maybe

  echo-lines : Integer -> [Console] Nothing
  echo-lines (n) = act
   r <- read-line
   when r
    is Just (line) -> act
      print-line-uni (show n & ": [" & line & "] len " & show (text-length line))
      echo-lines (n + 1)
    end
    is None -> print-line-uni ("end after " & show n)
  end

  opening : [Console] Nothing = act
   echo-lines 0
  end