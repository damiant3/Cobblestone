Chapter: DoubleParseRt

  bits : Text -> Text
  bits (s) = s & " -> " & show (text-to-double-bits s)

  opening : [Console] Nothing = act
   print-line-uni (bits "0")
   print-line-uni (bits "42")
   print-line-uni (bits "-42")
   print-line-uni (bits "3.14")
   print-line-uni (bits "-0.5")
   print-line-uni (bits "0.001")
   print-line-uni (bits "2.718281828459045")
   print-line-uni (bits "10.0")
   print-line-uni (bits "")
  end
