Chapter: RecordSetSlotRt

 Two records share a field name at DIFFERENT slots. `__record-set` must take
 the slot from the record it is handed, not from the first type-def in the
 tree that happens to declare that name.

  Early = record {
   tag : Integer,
   shared : Integer
  }

  Late = record {
   a : Integer,
   b : Integer,
   c : Integer,
   d : Integer,
   shared : Integer
  }

  bump-late : Late -> Late
  bump-late (l) = __record-set l "shared" 99

  bump-early : Early -> Early
  bump-early (e) = __record-set e "shared" 77

  opening : [Console] Nothing = act
   let l0 = Late { a = 1, b = 2, c = 3, d = 4, shared = 5 }
   in let l1 = bump-late l0
   in let e0 = Early { tag = 8, shared = 9 }
   in let e1 = bump-early e0
   in act
    print-line-uni ("late a " & show (l1.a))
    print-line-uni ("late b " & show (l1.b))
    print-line-uni ("late c " & show (l1.c))
    print-line-uni ("late d " & show (l1.d))
    print-line-uni ("late shared " & show (l1.shared))
    print-line-uni ("early tag " & show (e1.tag))
    print-line-uni ("early shared " & show (e1.shared))
   end
  end
