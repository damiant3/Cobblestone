Chapter: CceTextRt

  opening : [Console] Nothing = act
   print-line-uni "ascii control: hello"
   print-line-uni "accented literal: héllo"
   print-line-uni ("literal length: " & show (text-length "héllo"))
   print-line-uni ("literal char code at 1: " & show (char-code (char-at "héllo" 1)))
   print-line-uni ("from a numeric code unit: " & char-to-text (code-to-char 97))
   print-line-uni ("negative through a text: " & show (text-to-integer ("-" & show 4207)))
  end
