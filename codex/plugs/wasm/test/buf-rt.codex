Chapter: BufRt

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else show-list xs (i + 1) (acc & show (list-at xs i) & " ")

  opening : [Console] Nothing = act
   let buf = alloc-bytes 64
   in let a = __buf-write-byte buf 0 65
   in let b = __buf-write-byte buf a 66
   in let c = __buf-write-bytes buf b [67, 68, 69]
   in print-line-uni ("cursors: " & show a & " " & show b & " " & show c)
   let buf2 = alloc-bytes 64
   in let e = __buf-write-bytes buf2 0 []
   in print-line-uni ("empty write returns: " & show e)
   let buf3 = alloc-bytes 64
   in let f = __buf-write-bytes buf3 0 [200, 255, 128, 127, 0, 1]
   in print-line-uni ("high bytes: " & show-list (__buf-read-bytes buf3 0 6) 0 "")
   let buf4 = alloc-bytes 64
   in let g = __buf-write-bytes buf4 0 [10, 20, 30, 40]
   in print-line-uni ("offset read: " & show-list (__buf-read-bytes buf4 1 2) 0 "")
   print-line-uni ("zero read: [" & show-list (__buf-read-bytes buf4 0 0) 0 "" & "]")
   let buf5 = alloc-bytes 64
   in let h = __buf-write-byte buf5 3 77
   in print-line-uni ("write at offset: " & show-list (__buf-read-bytes buf5 3 1) 0 "" & "cursor " & show h)
   print-line-uni ("truncates to a byte: " & show-list (__buf-read-bytes buf3 0 3) 0 "")
  end
