   "    (if (i32.lt_u (local.get $c) (i32.const 128)) (then\n" &
   "      (local.set $ptr (call $bump_alloc (i32.const 5)))\n" &
   "      (i32.store (local.get $ptr) (i32.const 1))\n" &
   "      (i32.store8 (i32.add (local.get $ptr) (i32.const 4)) (local.get $c))\n" &
   "      (return (i64.extend_i32_u (local.get $ptr)))))\n" &
   "    (if (i32.lt_u (local.get $c) (i32.const 2176)) (then\n" &
   "      (local.set $v (i32.sub (local.get $c) (i32.const 128)))\n" &
   "      (local.set $ptr (call $bump_alloc (i32.const 6)))\n" &
   "      (i32.store (local.get $ptr) (i32.const 2))\n" &
   "      (i32.store8 (i32.add (local.get $ptr) (i32.const 4)) (i32.or (i32.const 192) (i32.shr_u (local.get $v) (i32.const 6))))\n" &
   "      (i32.store8 (i32.add (local.get $ptr) (i32.const 5)) (i32.or (i32.const 128) (i32.and (local.get $v) (i32.const 63))))\n" &
   "      (return (i64.extend_i32_u (local.get $ptr)))))\n" &
