Chapter: WASM Emitter
  cites Foreword chapter CCE
  cites Foreword chapter ListUtils
  cites Foreword chapter Sort

Section: Keywords and Sanitization

  wat-keywords : List Text =
   ["block", "br", "call", "data", "drop", "elem", "else", "end",
    "export", "func", "global", "if", "import", "local", "loop",
    "memory", "module", "mut", "nop", "offset", "param", "result",
    "return", "select", "start", "table", "then", "type", "unreachable"]

  wat-is-keyword : Text, Integer -> Boolean
  wat-is-keyword (name) (i) =
   if i == list-length wat-keywords then False
   else if list-at wat-keywords i == name then True
   else wat-is-keyword name (i + 1)

  wat-sanitize : Text -> Text
  wat-sanitize (name) =
   let s = text-replace (text-replace (text-replace (text-replace name "-" "_") "[" "<") "]" ">") "," "|"
   in if wat-is-keyword s 0 then s & "_v"
      else s

  wat-escape : Text -> Text
  wat-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in text-replace s1 "\"" "\\\""

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

 WebAssembly has no function pointers, so a function used as a VALUE becomes
 an index into a table and the call becomes `call_indirect`. The index is the
 function's position in this sorted arity list, which is also the order the
 `elem` segment lists them in, so the two cannot drift: both are derived from
 the same list rather than kept in step by hand.

  lookup-fn-index : List ArityEntry, Text -> Integer
  lookup-fn-index (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else if (list-at entries pos).name == name then pos else -1

  wat-max-arity : List ArityEntry, Integer, Integer -> Integer
  wat-max-arity (entries) (i) (acc) =
   if i >= list-length entries then acc
   else let a = (list-at entries i).arity
   in wat-max-arity entries (i + 1) (if a > acc then a else acc)

  wat-params-of : Integer, Text -> Text
  wat-params-of (n) (acc) =
   if n <= 0 then acc else wat-params-of (n - 1) (acc & " (param i64)")

 One signature per arity, named by it. Every Codex value on this target is
 i64, so an arity fixes a signature completely and `call_indirect` can name
 it without inspecting the callee.

  wat-emit-fn-types : Integer, Integer, Text -> Text
  wat-emit-fn-types (n) (i) (acc) =
   if i > n then acc
   else let row = "  (type $fn" & integer-to-text i & " (func" & wat-params-of i "" & " (result i64)))\n"
   in wat-emit-fn-types n (i + 1) (acc & row)

  wat-emit-elem : List ArityEntry, Integer, Text -> Text
  wat-emit-elem (entries) (i) (acc) =
   acc & wat-emit-elem-span entries i (list-length entries)

  wat-emit-elem-span : List ArityEntry, Integer, Integer -> Text
  wat-emit-elem-span (entries) (lo) (hi) =
   if lo >= hi then ""
   else if hi - lo == 1 then " $" & wat-sanitize ((list-at entries lo).name)
   else let mid = lo + (hi - lo) / 2
   in wat-emit-elem-span entries lo mid & wat-emit-elem-span entries mid hi

  wat-fn-type-ceiling : List ArityEntry -> Integer
  wat-fn-type-ceiling (entries) =
   let m = wat-max-arity entries 0 0
   in if m < 1 then 1 else m

  wat-emit-table : List ArityEntry -> Text
  wat-emit-table (entries) =
   let n = list-length entries
   in "  (table $ft " & integer-to-text n & " funcref)\n" &
      wat-emit-fn-types (wat-fn-type-ceiling entries) 0 "" &
      "  (elem $ft (i32.const 0)" & wat-emit-elem entries 0 "" & ")\n"

Section: String Table

  StringEntry = record {
   value : Text,
   offset : Integer
  }

  strtab-contains : List StringEntry, Text, Integer -> Boolean
  strtab-contains (xs) (s) (i) =
   if i >= list-length xs then False
   else if (list-at xs i).value == s then True
   else strtab-contains xs s (i + 1)

  strtab-add : List StringEntry, Text -> List StringEntry
  strtab-add (xs) (s) =
   if strtab-contains xs s 0 then xs
   else list-push xs (StringEntry { value = s, offset = 0 })

  strtab-lookup : List StringEntry, Text, Integer -> Integer
  strtab-lookup (xs) (s) (i) =
   if i >= list-length xs then 0
   else if (list-at xs i).value == s then (list-at xs i).offset
   else strtab-lookup xs s (i + 1)

 The string table starts at 1024, so a lookup answering 0 names no string.

  wat-strtab-ref : List StringEntry, Text -> Text
  wat-strtab-ref (strings) (s) =
   let off = strtab-lookup strings s 0
   in if off == 0 then "(unreachable (; wasm plug: string literal absent from the table: " & s & " ;))"
      else "(i64.extend_i32_u (i32.const " & integer-to-text off & "))"

  strtab-assign-offsets : List StringEntry, Integer, Integer, List StringEntry -> List StringEntry
  strtab-assign-offsets (xs) (i) (off) (acc) =
   if i >= list-length xs then acc
   else let e = list-at xs i
   in let sz = 4 + text-length (e.value)
   in strtab-assign-offsets xs (i + 1) (off + sz) (list-push acc (StringEntry { value = e.value, offset = off }))

  strtab-end-offset : List StringEntry -> Integer
  strtab-end-offset (xs) =
   if list-length xs == 0 then 1024
   else let last = list-at xs (list-length xs - 1)
   in last.offset + 4 + text-length (last.value)

  collect-strings-expr : IRExpr, List StringEntry -> List StringEntry
  collect-strings-expr (e) (acc) =
   when e
    is IrIntLit (n) (sp) -> acc
    is IrNumLit (n) (sp) -> acc
    is IrTextLit (s) (sp) -> strtab-add acc s
    is IrBoolLit (b) (sp) -> acc
    is IrCharLit (n) (sp) -> acc
    is IrName (n) (ty) (sp) -> acc
    is IrBinary (op) (l) (r) (ty) (sp) -> collect-strings-expr r (collect-strings-expr l acc)
    is IrNegate (operand) (nty) (sp) -> collect-strings-expr operand acc
    is IrIf (c) (t) (el) (ty) (sp) -> collect-strings-expr el (collect-strings-expr t (collect-strings-expr c acc))
    is IrLet (name) (ty) (val) (body) (sp) -> collect-strings-expr body (collect-strings-expr val acc)
    is IrApply (f) (a) (ty) (sp) -> collect-strings-expr a (collect-strings-expr f acc)
    is IrLambda (params) (body) (ty) (sp) -> collect-strings-expr body acc
    is IrList (elems) (ty) (sp) -> collect-strings-list elems acc
    is IrMatch (scrut) (branches) (ty) (sp) -> collect-strings-branches branches (collect-strings-expr scrut acc)
    is IrAct (stmts) (ty) (sp) -> collect-strings-stmts stmts acc
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> collect-strings-expr body acc
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> collect-strings-expr body acc
    is IrRecord (name) (fields) (ty) (sp) -> collect-strings-fields fields acc
    is IrFieldAccess (rec) (field) (ty) (sp) -> collect-strings-expr rec acc
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> collect-strings-expr val (collect-strings-expr rec acc)
    is IrFork (body) (ty) (sp) -> collect-strings-expr body acc
    is IrAwait (task) (ty) (sp) -> collect-strings-expr task acc
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> collect-strings-stmts fail-stmts (collect-strings-stmts fb (collect-strings-stmts body acc))
    is IrError (msg) (ty) (sp) -> acc

  collect-strings-list : List IRExpr, List StringEntry -> List StringEntry
  collect-strings-list (xs) (acc) =
   collect-strings-list-loop xs acc 0

  collect-strings-list-loop : List IRExpr, List StringEntry, Integer -> List StringEntry
  collect-strings-list-loop (xs) (acc) (i) =
   if i >= list-length xs then acc
   else collect-strings-list-loop xs (collect-strings-expr (list-at xs i) acc) (i + 1)

  collect-strings-branches : List IRBranch, List StringEntry -> List StringEntry
  collect-strings-branches (bs) (acc) =
   collect-strings-branches-loop bs acc 0

  collect-strings-branches-loop : List IRBranch, List StringEntry, Integer -> List StringEntry
  collect-strings-branches-loop (bs) (acc) (i) =
   if i >= list-length bs then acc
   else let b = list-at bs i
   in collect-strings-branches-loop bs (collect-strings-pat (b.pattern) (collect-strings-expr (b.body) (collect-strings-expr (b.guard) acc))) (i + 1)

  collect-strings-pat : IRPat, List StringEntry -> List StringEntry
  collect-strings-pat (p) (acc) =
   when p
    is IrLitPat (t) (ty) (sp) -> if wat-is-text-type ty then strtab-add acc t else acc
    is IrCtorPat (n) (subs) (ty) (sp) -> collect-strings-pats subs acc 0
    is otherwise -> acc

  collect-strings-pats : List IRPat, List StringEntry, Integer -> List StringEntry
  collect-strings-pats (ps) (acc) (i) =
   if i >= list-length ps then acc
   else collect-strings-pats ps (collect-strings-pat (list-at ps i) acc) (i + 1)

  collect-strings-stmts : List IRActStmt, List StringEntry -> List StringEntry
  collect-strings-stmts (ss) (acc) =
   collect-strings-stmts-loop ss acc 0

  collect-strings-stmts-loop : List IRActStmt, List StringEntry, Integer -> List StringEntry
  collect-strings-stmts-loop (ss) (acc) (i) =
   if i >= list-length ss then acc
   else let s = list-at ss i
   in let acc1 = when s
    is IrDoBind (name) (ty) (val) (sp) -> collect-strings-expr val acc
    is IrDoExec (e) (sp) -> collect-strings-expr e acc
   in collect-strings-stmts-loop ss acc1 (i + 1)

  collect-strings-fields : List IRFieldVal, List StringEntry -> List StringEntry
  collect-strings-fields (fs) (acc) =
   collect-strings-fields-loop fs acc 0

  collect-strings-fields-loop : List IRFieldVal, List StringEntry, Integer -> List StringEntry
  collect-strings-fields-loop (fs) (acc) (i) =
   if i >= list-length fs then acc
   else collect-strings-fields-loop fs (collect-strings-expr ((list-at fs i).value) acc) (i + 1)

  collect-strings-defs : List IRDef, Integer, List StringEntry -> List StringEntry
  collect-strings-defs (defs) (i) (acc) =
   if i >= list-length defs then acc
   else collect-strings-defs defs (i + 1) (collect-strings-expr ((list-at defs i).body) acc)

  byte-to-hex : Integer -> Text
  byte-to-hex (b) =
   let hi = b / 16
   in let lo = int-mod b 16
   in "\\" & hex-digit hi & hex-digit lo

  hex-digit : Integer -> Text
  hex-digit (n) =
   if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
   else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
   else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
   else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
   else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
   else "f"

  i32-to-hex-bytes : Integer -> Text
  i32-to-hex-bytes (v) =
   byte-to-hex (int-mod v 256) &
   byte-to-hex (int-mod (v / 256) 256) &
   byte-to-hex (int-mod (v / 65536) 256) &
   byte-to-hex (int-mod (v / 16777216) 256)

  wat-escape-data : Text, Integer, Integer, List Text -> Text
  wat-escape-data (s) (i) (len) (acc) =
   if i >= len then text-concat-list acc
   else wat-escape-data s (i + 1) len (list-push acc (byte-to-hex (char-code (char-at s i))))

  emit-data-section : StringEntry -> Text
  emit-data-section (e) =
   let len = text-length (e.value)
   in "  (data (i32.const " & integer-to-text (e.offset) & ") \"" & i32-to-hex-bytes len & wat-escape-data (e.value) 0 len [] & "\")\n"

  emit-data-sections : List StringEntry, Integer -> Text
  emit-data-sections (xs) (i) =
   emit-data-span xs i (list-length xs)

  emit-data-span : List StringEntry, Integer, Integer -> Text
  emit-data-span (xs) (lo) (hi) =
   if lo >= hi then ""
   else if hi - lo == 1 then emit-data-section (list-at xs lo)
   else let mid = lo + (hi - lo) / 2
   in emit-data-span xs lo mid & emit-data-span xs mid hi

Section: CCE Output Tables

 2176 is the first CCE code point above tier 1, so the flat table covers
 tiers 0 and 1 and the block table covers tier 2.

  cce-tab-entries : Integer = 2176

  cce-tab-chunk-size : Integer = 128

  cce-tab-bytes : Integer = cce-tab-entries * 2

  cce-t2-entry-bytes : Integer = 12

  cce-out-buf-bytes : Integer = 256

  cce-flush-at : Integer = 240

  cce-in-buf-bytes : Integer = 65536

  cce-tables-bytes : Integer =
   cce-tab-bytes + cce-tier2-block-count * cce-t2-entry-bytes + cce-out-buf-bytes +
   cce-rev-entries + cce-in-buf-bytes

  cce-digit-zero : Integer = from-unicode 48

  cce-minus : Integer = from-unicode 45

  cce-dot : Integer = from-unicode 46

  cce-lower-e : Integer = from-unicode 101

  cce-plus : Integer = from-unicode 43

  cce-newline : Integer = from-unicode 10

 128 entries is the whole reverse table: a byte under 128 is ASCII whichever
 way it came, and `from-unicode` answers for exactly that band.

  cce-rev-entries : Integer = 128

  cce-rev-chunk : Integer, Integer, List Text -> Text
  cce-rev-chunk (start) (i) (acc) =
   if i >= cce-rev-entries then text-concat-list acc
   else let u = from-unicode (start + i)
   in let b = if u < 0 then 0 else if u > 255 then 0 else u
   in cce-rev-chunk start (i + 1) (list-push acc (byte-to-hex b))

  cce-u16-hex : Integer -> Text
  cce-u16-hex (v) =
   byte-to-hex (int-mod v 256) & byte-to-hex (int-mod (v / 256) 256)

  cce-tab-chunk : Integer, Integer, List Text -> Text
  cce-tab-chunk (start) (i) (acc) =
   if i >= cce-tab-chunk-size then text-concat-list acc
   else cce-tab-chunk start (i + 1) (list-push acc (cce-u16-hex (to-unicode (start + i))))

  cce-t2-chunk : Integer, List Text -> Text
  cce-t2-chunk (block) (acc) =
   if block >= cce-tier2-block-count then text-concat-list acc
   else cce-t2-chunk (block + 1) (list-push acc
    (i32-to-hex-bytes (cce-tier2-cce-base block) &
     i32-to-hex-bytes (cce-tier2-block-size block) &
     i32-to-hex-bytes (cce-tier2-block-unicode-base block)))

  wat-stream-cce-tab : Integer, Integer -> [Console] Nothing
  wat-stream-cce-tab (base) (start) =
   if start >= cce-tab-entries then print-uni ""
   else let h = __heap-save
   in let chunk = cce-tab-chunk start 0 []
   in act
    print-uni ("  (data (i32.const " & integer-to-text (base + start * 2) & ") \"" & chunk & "\")\n")
    let restored = __heap-restore h
    in wat-stream-cce-tab base (start + cce-tab-chunk-size)
   end

  wat-stream-cce-tables : Integer, Integer, Integer -> [Console] Nothing
  wat-stream-cce-tables (tab-base) (t2-base) (rev-base) = act
   wat-stream-cce-tab tab-base 0
   print-uni ("  (data (i32.const " & integer-to-text t2-base & ") \"" & cce-t2-chunk 0 [] & "\")\n")
   print-uni ("  (data (i32.const " & integer-to-text rev-base & ") \"" & cce-rev-chunk 0 0 [] & "\")\n")
  end

Section: Type Lookups

  find-record-field-index : List RecordField, Text, Integer -> Integer
  find-record-field-index (fields) (name) (i) =
   if i >= list-length fields then 0
   else if (list-at fields i).name.value == name then i
   else find-record-field-index fields name (i + 1)

  resolve-record-fields : List ATypeDef, Text, Integer -> List RecordField
  resolve-record-fields (tds) (name) (i) =
   if i >= list-length tds then []
   else when list-at tds i
    is ARecordTypeDef (n) (tp) (fds) (recmut) (sp) ->
     if n.value == name then afields-to-rfields fds 0 []
     else resolve-record-fields tds name (i + 1)
    is otherwise -> resolve-record-fields tds name (i + 1)

  afields-to-rfields : List ARecordFieldDef, Integer, List RecordField -> List RecordField
  afields-to-rfields (afs) (i) (acc) =
   if i >= list-length afs then acc
   else let af = list-at afs i
   in afields-to-rfields afs (i + 1) (list-push acc (RecordField { name = af.name, type-val = atype-to-codex-type (af.type-expr) }))

 WebAssembly has no integer min or max instruction -- i64.min and i64.max do
 not exist, only the float forms -- so the clamp is two `select`s, each testing
 with i64.gt_s or i64.lt_s. `select` yields its FIRST operand when the
 condition is non-zero.

  WatBand = record {
   clamps : Boolean,
   wraps : Boolean,
   blo : Integer,
   bhi : Integer
  }

  wat-no-band : WatBand
  wat-no-band = WatBand { clamps = False, wraps = False, blo = 0, bhi = 0 }

  wat-atype-band : ATypeExpr -> WatBand
  wat-atype-band (te) =
   when te
    is ABoundedIntType (b) (lo) (hi) (mode) (s) ->
     when mode
      is OvClamping -> WatBand { clamps = True, wraps = False, blo = lo, bhi = hi }
      is OvWrapping -> WatBand { clamps = False, wraps = True, blo = lo, bhi = hi }
      is otherwise -> wat-no-band
    is otherwise -> wat-no-band

  wat-band-in-afields : List ARecordFieldDef, Text, Integer -> WatBand
  wat-band-in-afields (fs) (name) (i) =
   if i >= list-length fs then wat-no-band
   else if (list-at fs i).name.value == name then wat-atype-band ((list-at fs i).type-expr)
   else wat-band-in-afields fs name (i + 1)

  wat-band-for-field : List ATypeDef, Text, Integer -> WatBand
  wat-band-for-field (tds) (field-name) (i) =
   if i >= list-length tds then wat-no-band
   else when list-at tds i
    is ARecordTypeDef (n) (tp) (fds) (recmut) (sp) ->
     let b = wat-band-in-afields fds field-name 0
     in if b.clamps | b.wraps then b else wat-band-for-field tds field-name (i + 1)
    is otherwise -> wat-band-for-field tds field-name (i + 1)

  wat-wrap : WatBand, Text -> Text
  wat-wrap (b) (v) =
   if b.blo == 0 then "(i64.and " & v & " (i64.const " & integer-to-text (b.bhi) & "))"
   else if b.bhi == 127 then "(i64.extend8_s " & v & ")"
   else if b.bhi == 32767 then "(i64.extend16_s " & v & ")"
   else if b.bhi == 2147483647 then "(i64.extend32_s " & v & ")"
   else if b.bhi == 9223372036854775807 then v
   else "(unreachable (; wasm plug: no form for a wrapping band " & integer-to-text (b.blo) & " to " & integer-to-text (b.bhi) & " ;))"

  wat-clamp : WatBand, Text -> Text
  wat-clamp (b) (v) =
   if b.wraps then wat-wrap b v
   else if b.clamps == False then v
   else let hi-c = "(i64.const " & integer-to-text (b.bhi) & ")"
   in let lo-c = "(i64.const " & integer-to-text (b.blo) & ")"
   in let hi-done = "(select " & hi-c & " " & v & " (i64.gt_s " & v & " " & hi-c & "))"
   in "(select " & lo-c & " " & hi-done & " (i64.lt_s " & hi-done & " " & lo-c & "))"

  field-index-from-ctx : WasmCtx, CodexType, Text -> Integer
  field-index-from-ctx (ctx) (ty) (field-name) =
   when ty
    is RecordTy (name) (args) (fields) ->
     if list-length fields > 0 then find-record-field-index fields field-name 0
     else find-record-field-index (record-fields-by-name (ctx.type-defs) (name.value) 0) field-name 0
    is ConstructedTy (name) (args) -> find-record-field-index (resolve-record-fields (ctx.type-defs) (name.value) 0) field-name 0
    is TypeCon (name) -> find-record-field-index (resolve-record-fields (ctx.type-defs) (name.value) 0) field-name 0
    is otherwise -> 0

  find-typedef-by-name : List ATypeDef, Text, Integer -> Integer
  find-typedef-by-name (tds) (name) (i) =
   if i >= list-length tds then -1
   else when list-at tds i
    is ARecordTypeDef (n) (tp) (fs) (recmut) (sp) -> if n.value == name then i else find-typedef-by-name tds name (i + 1)
    is AVariantTypeDef (n) (tp) (cs) (sp) -> if n.value == name then i else find-typedef-by-name tds name (i + 1)
    is AUnitTypeDef (n) (unitbase) (sp) -> if n.value == name then i else find-typedef-by-name tds name (i + 1)

  find-ctor-tag : List AVariantCtorDef, Text, Integer -> Integer
  find-ctor-tag (ctors) (name) (i) =
   if i >= list-length ctors then -1
   else if (list-at ctors i).name.value == name then i
   else find-ctor-tag ctors name (i + 1)

  find-ctor-in-typedefs : List ATypeDef, Text, Integer -> Integer
  find-ctor-in-typedefs (tds) (name) (i) =
   if i >= list-length tds then -1
   else when list-at tds i
    is AVariantTypeDef (n) (tp) (ctors) (sp) ->
     let tag = find-ctor-tag ctors name 0
     in if tag >= 0 then tag else find-ctor-in-typedefs tds name (i + 1)
    is otherwise -> find-ctor-in-typedefs tds name (i + 1)

  is-ctor-name : List ATypeDef, Text, Integer -> Boolean
  is-ctor-name (tds) (name) (i) =
   if i >= list-length tds then False
   else when list-at tds i
    is AVariantTypeDef (n) (tp) (ctors) (sp) ->
     if find-ctor-tag ctors name 0 >= 0 then True
     else is-ctor-name tds name (i + 1)
    is otherwise -> is-ctor-name tds name (i + 1)

Section: Emitter Context

  WasmCtx = record {
   arities : List ArityEntry,
   strings : List StringEntry,
   type-defs : List ATypeDef,
   bound : List Text,
   scrut-depth : Integer,
   inplace : List Text,
   eff-ops : List WhOp
  }

  wat-scrut-name : Integer -> Text
  wat-scrut-name (d) =
   if d <= 0 then "_s" else wat-scrut-name (d - 1) & "s"

  wat-scrut : WasmCtx -> Text
  wat-scrut (ctx) = "$" & wat-scrut-name (ctx.scrut-depth)

  wat-is-scrut : Text -> Boolean
  wat-is-scrut (n) =
   text-length n >= 2 & n == wat-scrut-name (text-length n - 2)

  wat-shift-scrut-name : Text -> Text
  wat-shift-scrut-name (n) =
   if wat-is-scrut n then wat-scrut-name (text-length n - 1) else n

  wat-shift-scrut : List Text, Integer, List Text -> List Text
  wat-shift-scrut (xs) (i) (acc) =
   if i >= list-length xs then acc
   else wat-shift-scrut xs (i + 1) (list-push acc (wat-shift-scrut-name (list-at xs i)))

  locals-merge : List Text, List Text, Integer -> List Text
  locals-merge (acc) (xs) (i) =
   if i >= list-length xs then acc
   else locals-merge (locals-add acc (list-at xs i)) xs (i + 1)

  ctx-deeper : WasmCtx -> WasmCtx
  ctx-deeper (ctx) =
   WasmCtx { arities = ctx.arities, strings = ctx.strings, type-defs = ctx.type-defs, bound = ctx.bound, scrut-depth = ctx.scrut-depth + 1, inplace = ctx.inplace, eff-ops = ctx.eff-ops }

Section: Local Collection

  locals-contains : List Text, Text -> Boolean
  locals-contains (xs) (name) =
   locals-contains-loop xs name 0

  locals-contains-loop : List Text, Text, Integer -> Boolean
  locals-contains-loop (xs) (name) (i) =
   if i >= list-length xs then False
   else if list-at xs i == name then True
   else locals-contains-loop xs name (i + 1)

  locals-add : List Text, Text -> List Text
  locals-add (xs) (name) =
   if locals-contains xs name then xs
   else list-push xs name

  ctx-with : WasmCtx, List Text -> WasmCtx
  ctx-with (ctx) (bd) =
   WasmCtx { arities = ctx.arities, strings = ctx.strings, type-defs = ctx.type-defs, bound = bd, scrut-depth = ctx.scrut-depth, inplace = ctx.inplace, eff-ops = ctx.eff-ops }

  ctx-with-inplace : WasmCtx, List Text -> WasmCtx
  ctx-with-inplace (ctx) (ip) =
   WasmCtx { arities = ctx.arities, strings = ctx.strings, type-defs = ctx.type-defs, bound = ctx.bound, scrut-depth = ctx.scrut-depth, inplace = ip, eff-ops = ctx.eff-ops }

  collect-locals-params : List IRParam, Integer, List Text -> List Text
  collect-locals-params (ps) (i) (acc) =
   if i >= list-length ps then acc
   else collect-locals-params ps (i + 1) (locals-add acc (wat-sanitize ((list-at ps i).name)))

  collect-locals-expr : IRExpr, List Text -> List Text
  collect-locals-expr (e) (acc) =
   when e
    is IrIntLit (n) (sp) -> acc
    is IrNumLit (n) (sp) -> acc
    is IrTextLit (s) (sp) -> acc
    is IrBoolLit (b) (sp) -> acc
    is IrCharLit (n) (sp) -> acc
    is IrName (n) (ty) (sp) -> locals-add (locals-add acc "_rp") "_tv"
    is IrBinary (op) (l) (r) (ty) (sp) -> collect-locals-expr r (collect-locals-expr l acc)
    is IrNegate (operand) (nty) (sp) -> collect-locals-expr operand acc
    is IrIf (c) (t) (el) (ty) (sp) -> collect-locals-expr el (collect-locals-expr t (collect-locals-expr c acc))
    is IrLet (name) (ty) (val) (body) (sp) -> collect-locals-expr body (collect-locals-expr val (locals-add acc (wat-sanitize name)))
    is IrApply (f) (a) (ty) (sp) -> collect-locals-expr a (collect-locals-expr f (locals-add (locals-add acc "_rp") "_tv"))
    is IrLambda (params) (body) (ty) (sp) -> collect-locals-expr body (collect-locals-params params 0 acc)
    is IrList (elems) (ty) (sp) -> collect-locals-list elems (locals-add (locals-add (locals-add acc "_rp") "_lp") "_tv")
    is IrMatch (scrut) (branches) (ty) (sp) -> collect-locals-branches branches (collect-locals-expr scrut (locals-add acc "_s"))
    is IrAct (stmts) (ty) (sp) -> collect-locals-stmts stmts acc
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> collect-locals-expr body acc
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> collect-locals-expr body acc
    is IrRecord (name) (fields) (ty) (sp) -> collect-locals-fields fields (locals-add (locals-add acc "_rp") "_tv")
    is IrFieldAccess (rec) (field) (ty) (sp) -> collect-locals-expr rec acc
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> collect-locals-expr val (collect-locals-expr rec (locals-add (locals-add acc "_rp") "_tv"))
    is IrFork (body) (ty) (sp) -> collect-locals-expr body acc
    is IrAwait (task) (ty) (sp) -> collect-locals-expr task acc
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> collect-locals-stmts fail-stmts (collect-locals-stmts fb (collect-locals-stmts body acc))
    is IrError (msg) (ty) (sp) -> acc

  collect-locals-list : List IRExpr, List Text -> List Text
  collect-locals-list (xs) (acc) =
   collect-locals-list-loop xs acc 0

  collect-locals-list-loop : List IRExpr, List Text, Integer -> List Text
  collect-locals-list-loop (xs) (acc) (i) =
   if i >= list-length xs then acc
   else collect-locals-list-loop xs (collect-locals-expr (list-at xs i) acc) (i + 1)

  collect-locals-branches : List IRBranch, List Text -> List Text
  collect-locals-branches (bs) (acc) =
   collect-locals-branches-loop bs acc 0

  collect-locals-branches-loop : List IRBranch, List Text, Integer -> List Text
  collect-locals-branches-loop (bs) (acc) (i) =
   if i >= list-length bs then acc
   else let b = list-at bs i
   in let acc1 = collect-locals-pat (b.pattern) acc
   in let acc2 = locals-merge acc1 (wat-shift-scrut (collect-locals-expr (b.guard) []) 0 []) 0
   in let acc3 = collect-locals-expr (b.body) acc2
   in collect-locals-branches-loop bs acc3 (i + 1)

  collect-locals-pat : IRPat, List Text -> List Text
  collect-locals-pat (p) (acc) =
   when p
    is IrVarPat (name) (ty) (sp) -> locals-add acc (wat-sanitize name)
    is IrCtorPat (name) (subs) (ty) (sp) -> collect-locals-pats subs acc
    is IrLitPat (text) (ty) (sp) -> acc
    is IrWildPat (sp) -> acc
    is IrVecPat (pats) (ty) (sp) -> acc

  collect-locals-pats : List IRPat, List Text -> List Text
  collect-locals-pats (ps) (acc) =
   collect-locals-pats-loop ps acc 0

  collect-locals-pats-loop : List IRPat, List Text, Integer -> List Text
  collect-locals-pats-loop (ps) (acc) (i) =
   if i >= list-length ps then acc
   else collect-locals-pats-loop ps (collect-locals-pat (list-at ps i) acc) (i + 1)

  collect-locals-stmts : List IRActStmt, List Text -> List Text
  collect-locals-stmts (ss) (acc) =
   collect-locals-stmts-loop ss acc 0

  collect-locals-stmts-loop : List IRActStmt, List Text, Integer -> List Text
  collect-locals-stmts-loop (ss) (acc) (i) =
   if i >= list-length ss then acc
   else let s = list-at ss i
   in let acc1 = when s
    is IrDoBind (name) (ty) (val) (sp) -> collect-locals-expr val (locals-add acc (wat-sanitize name))
    is IrDoExec (e) (sp) -> collect-locals-expr e acc
   in collect-locals-stmts-loop ss acc1 (i + 1)

  collect-locals-fields : List IRFieldVal, List Text -> List Text
  collect-locals-fields (fs) (acc) =
   collect-locals-fields-loop fs acc 0

  collect-locals-fields-loop : List IRFieldVal, List Text, Integer -> List Text
  collect-locals-fields-loop (fs) (acc) (i) =
   if i >= list-length fs then acc
   else collect-locals-fields-loop fs (collect-locals-expr ((list-at fs i).value) acc) (i + 1)

  emit-local-decls : List Text, Integer -> Text
  emit-local-decls (names) (i) =
   if i >= list-length names then ""
   else "(local $" & list-at names i & " i64) " & emit-local-decls names (i + 1)

 wat2wasm refuses a local that re-declares a parameter (`redefinition of
 parameter`) and rejects the whole module on the first one.

  params-contain : List IRParam, Text, Integer -> Boolean
  params-contain (ps) (name) (i) =
   if i >= list-length ps then False
   else if wat-sanitize ((list-at ps i).name) == name then True
   else params-contain ps name (i + 1)

  locals-minus-params : List Text, List IRParam, Integer, List Text -> List Text
  locals-minus-params (xs) (ps) (i) (acc) =
   if i >= list-length xs then acc
   else if params-contain ps (list-at xs i) 0 then locals-minus-params xs ps (i + 1) acc
   else locals-minus-params xs ps (i + 1) (list-push acc (list-at xs i))

Section: Type Definition Emission

  emit-wat-type-defs : List ATypeDef, Integer -> Text
  emit-wat-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-wat-type-def (list-at tds i) & emit-wat-type-defs tds (i + 1)

  emit-wat-type-def : ATypeDef -> Text
  emit-wat-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     "  ;; record " & name.value & ": " & integer-to-text (list-length fields) & " fields at 8 bytes each\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     "  ;; variant " & name.value & ": tag i64 + max " & integer-to-text (wat-variant-max-fields ctors 0 0) & " fields\n"
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  wat-variant-max-fields : List AVariantCtorDef, Integer, Integer -> Integer
  wat-variant-max-fields (ctors) (i) (mx) =
   if i == list-length ctors then mx
   else let n = list-length ((list-at ctors i).fields)
   in wat-variant-max-fields ctors (i + 1) (if n > mx then n else mx)

Section: Constructor Equality

  wat-eq-fn-prefix : Text = "$cx_eq_"

  wat-variant-typedef-name : List ATypeDef, Text -> Text
  wat-variant-typedef-name (tds) (n) =
   if text-length n == 0 then ""
   else let i = find-typedef-by-name tds n 0
   in if i < 0 then ""
      else when list-at tds i
       is AVariantTypeDef (vn) (tp) (cs) (s) -> n
       is otherwise -> ""

  wat-eq-sum-name : List ATypeDef, CodexType -> Text
  wat-eq-sum-name (tds) (ty) =
   when ty
    is SumTy (name) (args) (ctors) -> wat-variant-typedef-name tds (name.value)
    is ConstructedTy (name) (args) -> wat-variant-typedef-name tds (name.value)
    is TypeCon (name) -> wat-variant-typedef-name tds (name.value)
    is UnitTy (name) (inner) -> wat-eq-sum-name tds inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-eq-sum-name tds ret
    is otherwise -> ""

  wat-atype-head-name : ATypeExpr -> Text
  wat-atype-head-name (at) =
   when at
    is ANamedType (n) (s) -> n.value
    is AAppType (ctor) (args) (s) -> wat-atype-head-name ctor
    is ALinearType (inner) (s) -> wat-atype-head-name inner
    is ABoundedIntType (base) (lo) (hi) (mode) (s) -> wat-atype-head-name base
    is AConstrainedType (cn) (vn) (inner) (s) -> wat-atype-head-name inner
    is otherwise -> ""

  wat-eq-field-cmp : List ATypeDef, ATypeExpr, Text, Text -> Text
  wat-eq-field-cmp (tds) (fty) (la) (lb) =
   let fn = wat-atype-head-name fty
   in if fn == "Text" then "(call $text_eq " & la & " " & lb & ")"
      else if fn == "Real" then "(i64.extend_i32_u (f64.eq (f64.reinterpret_i64 " & la & ") (f64.reinterpret_i64 " & lb & ")))"
      else if text-length (wat-variant-typedef-name tds fn) > 0 then "(call " & wat-eq-fn-prefix & wat-sanitize fn & " " & la & " " & lb & ")"
      else "(i64.extend_i32_u (i64.eq " & la & " " & lb & "))"

  wat-eq-field-tests : List ATypeDef, List ATypeExpr, Integer -> Text
  wat-eq-field-tests (tds) (fs) (i) =
   if i >= list-length fs then ""
   else let off = 8 + i * 8
   in let la = "(i64.load (i32.add (i32.wrap_i64 (local.get $a)) (i32.const " & integer-to-text off & ")))"
   in let lb = "(i64.load (i32.add (i32.wrap_i64 (local.get $b)) (i32.const " & integer-to-text off & ")))"
   in "      (if (i64.eqz " & wat-eq-field-cmp tds (list-at fs i) la lb & ") (then (return (i64.const 0))))\n" &
      wat-eq-field-tests tds fs (i + 1)

  wat-eq-ctor-arms : List ATypeDef, List AVariantCtorDef, Integer -> Text
  wat-eq-ctor-arms (tds) (ctors) (i) =
   if i >= list-length ctors then ""
   else let fs = (list-at ctors i).fields
   in (if list-length fs == 0 then ""
       else "    (if (i64.eq (local.get $t) (i64.const " & integer-to-text i & ")) (then\n" &
            wat-eq-field-tests tds fs 0 &
            "      (return (i64.const 1))))\n") &
      wat-eq-ctor-arms tds ctors (i + 1)

  wat-all-ctors-nullary : List AVariantCtorDef, Integer -> Boolean
  wat-all-ctors-nullary (ctors) (i) =
   if i >= list-length ctors then True
   else if list-length ((list-at ctors i).fields) > 0 then False
   else wat-all-ctors-nullary ctors (i + 1)

  wat-eq-func : List ATypeDef, Text, List AVariantCtorDef -> Text
  wat-eq-func (tds) (tn) (ctors) =
   let hdr = "  (func " & wat-eq-fn-prefix & wat-sanitize tn & " (param $a i64) (param $b i64) (result i64)\n"
   in if wat-all-ctors-nullary ctors 0 then
    hdr & "    (i64.extend_i32_u (i64.eq (i64.load (i32.wrap_i64 (local.get $a))) (i64.load (i32.wrap_i64 (local.get $b))))))\n\n"
   else
    hdr &
    "    (local $t i64)\n" &
    "    (local.set $t (i64.load (i32.wrap_i64 (local.get $a))))\n" &
    "    (if (i64.ne (local.get $t) (i64.load (i32.wrap_i64 (local.get $b)))) (then (return (i64.const 0))))\n" &
    wat-eq-ctor-arms tds ctors 0 &
    "    (i64.const 1))\n\n"

  wat-eq-funcs : List ATypeDef, Integer -> Text
  wat-eq-funcs (tds) (i) =
   if i >= list-length tds then ""
   else (when list-at tds i
    is AVariantTypeDef (name) (tparams) (ctors) (s) -> wat-eq-func tds (name.value) ctors
    is otherwise -> "") & wat-eq-funcs tds (i + 1)

Section: Expression Emission

 4096 is the nesting depth at which this emitter refuses. wat2wasm's own parser
 limit sits between 200 and 250 folded expressions, and `let` recurses without
 nesting its output, so only this bound sees a deep `let` chain.

  emit-wat-expr : WasmCtx, IRExpr -> Text
  emit-wat-expr (ctx) (e) = emit-wat-expr-at ctx e 0

  emit-wat-expr-at : WasmCtx, IRExpr, Integer -> Text
  emit-wat-expr-at (ctx) (e) (depth) =
   if depth >= 4096 then "(unreachable (; wasm plug: expression nested past 4096, no form ;))"
   else when e
    is IrIntLit (n) (sp) -> "(i64.const " & integer-to-text n & ")"
    is IrNumLit (n) (sp) -> "(i64.const " & integer-to-text n & ")"
    is IrTextLit (s) (sp) -> wat-strtab-ref (ctx.strings) s
    is IrBoolLit (b) (sp) -> if b then "(i64.const 1)" else "(i64.const 0)"
    is IrCharLit (n) (sp) -> "(i64.const " & integer-to-text n & ")"
    is IrName (n) (ty) (sp) -> emit-wat-name ctx n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-wat-binary ctx op l r ty depth
    is IrNegate (operand) (nty) (sp) -> if wat-is-real-type (ir-expr-type operand) then wat-f64-out ("(f64.neg " & wat-f64-in (emit-wat-expr-at ctx operand (depth + 1)) & ")")
                                        else "(i64.sub (i64.const 0) " & emit-wat-expr-at ctx operand (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> emit-wat-if-chain ctx e depth
    is IrLet (name) (ty) (val) (body) (sp) -> "(local.set $" & wat-sanitize name & " " & emit-wat-expr-at ctx val (depth + 1) & ") " & emit-wat-expr-at ctx body (depth + 1)
    is IrApply (f) (a) (ty) (sp) -> emit-wat-apply ctx e
    is IrLambda (params) (body) (ty) (sp) -> emit-wat-expr-at ctx body (depth + 1)
    is IrList (elems) (ty) (sp) -> emit-wat-list ctx elems depth
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-wat-match ctx scrut branches depth
    is IrAct (stmts) (ty) (sp) -> emit-wat-act ctx stmts
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> wh-emit-handle ctx body clauses depth
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-wat-expr-at ctx body (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-wat-record ctx fields ty depth
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-wat-field-access ctx rec field ty depth
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> emit-wat-field-store ctx rec field val ty depth
    is IrFork (body) (ty) (sp) -> "(call $clo_apply1 " & emit-wat-expr-at ctx body (depth + 1) & " (i64.const 0))"
    is IrAwait (task) (ty) (sp) -> emit-wat-expr-at ctx task (depth + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-wat-act ctx body
    is IrError (msg) (ty) (sp) -> "(unreachable)"

  emit-wat-if-chain : WasmCtx, IRExpr, Integer -> Text
  emit-wat-if-chain (ctx) (e) (depth) =
   "(block $_i (result i64) " & emit-wat-if-arms ctx e depth & ")"

  emit-wat-if-arms : WasmCtx, IRExpr, Integer -> Text
  emit-wat-if-arms (ctx) (e) (depth) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     "(block $_c (br_if $_c (i32.eqz (i32.wrap_i64 " & emit-wat-expr-at ctx c (depth + 1) & "))) (br $_i " & emit-wat-expr-at ctx t (depth + 1) & ")) "
       & emit-wat-if-arms ctx el depth
    is otherwise -> emit-wat-expr-at ctx e (depth + 1)

 A `(local.set $x)` with no folded operand pops the WASM OPERAND STACK, which is
 per-invocation, so a pointer can be pushed, a field evaluated and the pointer
 popped back with no second local. Emitting that everywhere grows the module by
 roughly a third, so it is emitted only where the field expression can allocate.

  wat-scratch-safe : WasmCtx, IRExpr -> Boolean
  wat-scratch-safe (ctx) (e) =
   when e
    is IrIntLit (n) (sp) -> True
    is IrNumLit (n) (sp) -> True
    is IrTextLit (s) (sp) -> True
    is IrBoolLit (b) (sp) -> True
    is IrCharLit (n) (sp) -> True
    is IrName (n) (ty) (sp) -> wat-name-scratch-safe ctx n
    is IrBinary (op) (l) (r) (ty) (sp) -> wat-scratch-safe ctx l & wat-scratch-safe ctx r
    is IrNegate (operand) (nty) (sp) -> wat-scratch-safe ctx operand
    is IrFieldAccess (rec) (field) (ty) (sp) -> wat-scratch-safe ctx rec
    is IrApply (f) (a) (ty) (sp) -> wat-scratch-safe ctx f & wat-scratch-safe ctx a
    is otherwise -> False

  wat-name-scratch-safe : WasmCtx, Text -> Boolean
  wat-name-scratch-safe (ctx) (n) =
   if is-ctor-name (ctx.type-defs) n 0 then False
   else if n == "read-line" then False
   else if n == "read-line-cce" then False
   else if n == "__record-set" then False
   else True

  wat-guard-scratch : WasmCtx, IRExpr, Text, Text -> Text
  wat-guard-scratch (ctx) (e) (slot) (emitted) =
   if wat-scratch-safe ctx e then "(local.set $_tv " & emitted & ") "
   else "(local.get " & slot & ") (local.set $_tv " & emitted & ") (local.set " & slot & ") "

  emit-wat-record : WasmCtx, List IRFieldVal, CodexType, Integer -> Text
  emit-wat-record (ctx) (fields) (ty) (depth) =
   let fc = list-length fields
   in let sz = fc * 8
   in let alloc = "(local.set $_rp (i64.extend_i32_u (call $bump_alloc (i32.const " & integer-to-text sz & "))))"
   in let stores = emit-wat-record-fields ctx fields ty 0 depth
   in alloc & " " & stores & "(local.get $_rp)"

  emit-wat-record-fields : WasmCtx, List IRFieldVal, CodexType, Integer, Integer -> Text
  emit-wat-record-fields (ctx) (fields) (ty) (i) (depth) =
   if i >= list-length fields then ""
   else let f = list-at fields i
   in let off = wat-slot-in-ty ctx ty (f.name) i * 8
   in let band = wat-band-for-rec (ctx.type-defs) ty (f.name)
   in wat-guard-scratch ctx (f.value) "$_rp" (emit-wat-expr-at ctx (f.value) (depth + 1)) &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_rp)) (i32.const " & integer-to-text off & ")) " & wat-clamp band "(local.get $_tv)" & ") " & emit-wat-record-fields ctx fields ty (i + 1) depth

  find-field-in-typedefs : List ATypeDef, Text, Integer -> Integer
  find-field-in-typedefs (tds) (field-name) (i) =
   if i >= list-length tds then 0
   else when list-at tds i
    is ARecordTypeDef (n) (tp) (fds) (recmut) (sp) ->
     let idx = find-afield-index fds field-name 0
     in if idx >= 0 then idx else find-field-in-typedefs tds field-name (i + 1)
    is otherwise -> find-field-in-typedefs tds field-name (i + 1)

  wat-slash-pos : Text, Integer, Integer -> Integer
  wat-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else wat-slash-pos f (i + 1) len

  wat-field-bare : Text -> Text
  wat-field-bare (f) =
   let slash = wat-slash-pos f 0 (text-length f)
   in if slash >= 0 then substring f 0 slash else f

  wat-field-slot : List ATypeDef, Text -> Integer
  wat-field-slot (tds) (f) =
   let len = text-length f
   in let slash = wat-slash-pos f 0 len
   in if slash >= 0 then text-to-integer (substring f (slash + 1) (len - slash - 1))
      else find-field-in-typedefs tds f 0

  wat-type-name : CodexType -> Text
  wat-type-name (ty) =
   when ty
    is RecordTy (name) (args) (fields) -> name.value
    is ConstructedTy (name) (args) -> name.value
    is TypeCon (name) -> name.value
    is otherwise -> ""

  wat-band-in-typedef : List ATypeDef, Text, Text -> WatBand
  wat-band-in-typedef (tds) (type-name) (field-name) =
   let i = find-typedef-by-name tds type-name 0
   in if i < 0 then wat-no-band
      else when list-at tds i
       is ARecordTypeDef (n) (tp) (fds) (recmut) (sp) -> wat-band-in-afields fds field-name 0
       is otherwise -> wat-no-band

  wat-band-for-rec : List ATypeDef, CodexType, Text -> WatBand
  wat-band-for-rec (tds) (ty) (field-name) =
   let tn = wat-type-name ty
   in if text-length tn > 0 then wat-band-in-typedef tds tn field-name
      else wat-band-for-field tds field-name 0

  find-afield-index : List ARecordFieldDef, Text, Integer -> Integer
  find-afield-index (fds) (name) (i) =
   if i >= list-length fds then -1
   else if (list-at fds i).name.value == name then i
   else find-afield-index fds name (i + 1)

  emit-wat-field-access : WasmCtx, IRExpr, Text, CodexType, Integer -> Text
  emit-wat-field-access (ctx) (rec) (field-name) (result-ty) (depth) =
   let idx = wat-slot-for-expr ctx rec field-name
   in let off = idx * 8
   in "(i64.load (i32.add (i32.wrap_i64 " & emit-wat-expr-at ctx rec (depth + 1) & ") (i32.const " & integer-to-text off & ")))"

  emit-wat-field-store : WasmCtx, IRExpr, Text, IRExpr, CodexType, Integer -> Text
  emit-wat-field-store (ctx) (rec) (field-name) (val) (result-ty) (depth) =
   let idx = wat-slot-for-expr ctx rec field-name
   in let off = idx * 8
   in let band = wat-band-for-field (ctx.type-defs) (wat-field-bare field-name) 0
   in "(local.set $_rp " & emit-wat-expr-at ctx rec (depth + 1) & ") " &
      wat-guard-scratch ctx val "$_rp" (emit-wat-expr-at ctx val (depth + 1)) &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_rp)) (i32.const " & integer-to-text off & ")) " & wat-clamp band "(local.get $_tv)" & ") " &
      "(local.get $_rp)"

  emit-wat-list : WasmCtx, List IRExpr, Integer -> Text
  emit-wat-list (ctx) (elems) (depth) =
   let n = list-length elems
   in let cap = n
   in let sz = 8 + cap * 8
   in let alloc = "(local.set $_lp (i64.extend_i32_u (call $bump_alloc (i32.const " & integer-to-text sz & "))))"
   in let store-len = "(i32.store (i32.wrap_i64 (local.get $_lp)) (i32.const " & integer-to-text n & "))"
   in let store-cap = "(i32.store (i32.add (i32.wrap_i64 (local.get $_lp)) (i32.const 4)) (i32.const " & integer-to-text cap & "))"
   in let stores = emit-wat-list-elems ctx elems 0 depth
   in alloc & " " & store-len & " " & store-cap & " " & stores & "(local.get $_lp)"

  emit-wat-list-elems : WasmCtx, List IRExpr, Integer, Integer -> Text
  emit-wat-list-elems (ctx) (elems) (i) (depth) =
   emit-wat-list-span ctx elems i (list-length elems) depth

  emit-wat-list-span : WasmCtx, List IRExpr, Integer, Integer, Integer -> Text
  emit-wat-list-span (ctx) (elems) (lo) (hi) (depth) =
   if lo >= hi then ""
   else if hi - lo == 1 then emit-wat-list-elem ctx elems lo depth
   else let mid = lo + (hi - lo) / 2
   in emit-wat-list-span ctx elems lo mid depth & emit-wat-list-span ctx elems mid hi depth

  emit-wat-list-elem : WasmCtx, List IRExpr, Integer, Integer -> Text
  emit-wat-list-elem (ctx) (elems) (i) (depth) =
   let off = 8 + i * 8
   in wat-guard-scratch ctx (list-at elems i) "$_lp" (emit-wat-expr-at ctx (list-at elems i) (depth + 1)) &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_lp)) (i32.const " & integer-to-text off & ")) (local.get $_tv)) "

  emit-wat-name : WasmCtx, Text -> Text
 `unreachable` is stack-polymorphic, so a refusal assembles wherever a value
 is expected and traps only if that path actually runs.

  emit-wat-name (ctx) (n) =
   if locals-contains (ctx.bound) (wat-sanitize n) then "(local.get $" & wat-sanitize n & ")"
   else if n == "True" then "(i64.const 1)"
   else if n == "False" then "(i64.const 0)"
   else if n == "Nothing" then "(i64.const 0)"
   else if n == "__heap-save" then "(i64.extend_i32_u (global.get $heap_ptr))"
   else if n == "__deck-pos" then "(i64.extend_i32_u (global.get $deck_ptr))"
   else if n == "__deck-enter" then "(block (result i64) (call $__deck_enter) (i64.const 0))"
   else if n == "__deck-exit" then "(block (result i64) (call $__deck_exit) (i64.const 0))"
   else if n == "__self-type-defs" then "(call $list_with_capacity (i64.const 0))"
   else if n == "read-line" then wat-emit-maybe-line ctx "$read_line_raw"
   else if n == "read-line-cce" then wat-emit-maybe-line ctx "$read_line_cce_raw"
   else if n == "block-sector-count" then "(i64.extend_i32_u (i32.div_u (global.get $disk_size) (i32.const 512)))"
   else if n == "process-get-pid" then "(i64.const 0)"
   else if n == "hosted-kind" then "(i64.const 1)"
   else if n == "__heap-base" then "(i64.extend_i32_u (global.get $heap_start))"
   else if wh-op-arity (ctx.eff-ops) n 0 >= 0 then wh-emit-op-call ctx n []
   else if is-ctor-name (ctx.type-defs) n 0 then emit-wat-ctor ctx n []
   else let ar = lookup-arity (ctx.arities) n
   in if ar == 0 then "(call $" & wat-sanitize n & ")"
      else if ar > 0 then "(i64.const " & integer-to-text (lookup-fn-index (ctx.arities) n) & ")"
      else wat-refuse-name n

  emit-wat-binary : WasmCtx, IRBinaryOp, IRExpr, IRExpr, CodexType, Integer -> Text
  emit-wat-binary (ctx) (op) (l) (r) (ty) (depth) =
   when op
    is IrAddInt | IrSubInt | IrMulInt ->
     if int-ty-wraps ty then "(" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
     else "(call " & wat-int-trap-fn op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
    is IrAppendText -> "(call $text_append " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
    is IrAppendList -> "(call $list_append " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
    is IrConsList -> "(call $list_cons " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
    is IrEq -> if wat-is-text-type (ir-expr-type l) then "(call $text_eq " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
              else let sn = wat-eq-sum-name (ctx.type-defs) (ir-expr-type l)
              in if text-length sn > 0 then "(call " & wat-eq-fn-prefix & wat-sanitize sn & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
              else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrNotEq -> if wat-is-text-type (ir-expr-type l) then "(i64.extend_i32_u (i64.eqz (call $text_eq " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")))"
                 else let sn = wat-eq-sum-name (ctx.type-defs) (ir-expr-type l)
                 in if text-length sn > 0 then "(i64.extend_i32_u (i64.eqz (call " & wat-eq-fn-prefix & wat-sanitize sn & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")))"
                 else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> wat-emit-vec-cmp ctx op l r depth
    is IrLt -> if wat-is-real-type (ir-expr-type l) then "(i64.extend_i32_u (f64.lt " & wat-f64-in (emit-wat-expr-at ctx l (depth + 1)) & " " & wat-f64-in (emit-wat-expr-at ctx r (depth + 1)) & "))"
                         else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrGt -> if wat-is-real-type (ir-expr-type l) then "(i64.extend_i32_u (f64.gt " & wat-f64-in (emit-wat-expr-at ctx l (depth + 1)) & " " & wat-f64-in (emit-wat-expr-at ctx r (depth + 1)) & "))"
                         else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrLtEq -> if wat-is-real-type (ir-expr-type l) then "(i64.extend_i32_u (f64.le " & wat-f64-in (emit-wat-expr-at ctx l (depth + 1)) & " " & wat-f64-in (emit-wat-expr-at ctx r (depth + 1)) & "))"
                             else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrGtEq -> if wat-is-real-type (ir-expr-type l) then "(i64.extend_i32_u (f64.ge " & wat-f64-in (emit-wat-expr-at ctx l (depth + 1)) & " " & wat-f64-in (emit-wat-expr-at ctx r (depth + 1)) & "))"
                             else "(i64.extend_i32_u (" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & "))"
    is IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating | IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating | IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating ->
     wat-emit-real-arith ctx op l r depth
    is IrAddVec | IrSubVec | IrMulVec | IrDivVec -> wat-emit-vec-arith ctx op l r depth
    is IrPowInt -> "(call $cx_ipow " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"
    is IrApproxEq -> wat-emit-approx-eq ctx l r depth 4
    is IrApproxEqExact -> wat-emit-approx-eq ctx l r depth 0
    is otherwise -> "(" & wat-bin-instr op & " " & emit-wat-expr-at ctx l (depth + 1) & " " & emit-wat-expr-at ctx r (depth + 1) & ")"

  wat-int-trap-fn : IRBinaryOp -> Text
  wat-int-trap-fn (op) =
   when op
    is IrAddInt -> "$cx_add_trap"
    is IrSubInt -> "$cx_sub_trap"
    is otherwise -> "$cx_mul_trap"

  wat-bin-instr : IRBinaryOp -> Text
  wat-bin-instr (op) =
   when op
    is IrAddInt -> "i64.add"
    is IrSubInt -> "i64.sub"
    is IrMulInt -> "i64.mul"
    is IrDivInt -> "i64.div_s"
    is IrRemInt -> "i64.rem_s"
    is IrPowInt -> "i64.pow-does-not-exist"
    is IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "f64.add"
    is IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "f64.sub"
    is IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "f64.mul"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "f64.div"
    is IrAddVec -> "f64x2.add"
    is IrSubVec -> "f64x2.sub"
    is IrMulVec -> "f64x2.mul"
    is IrDivVec -> "f64x2.div"
    is IrEq -> "i64.eq"
    is IrNotEq -> "i64.ne"
    is IrLt | IrLtVec -> "i64.lt_s"
    is IrGt | IrGtVec -> "i64.gt_s"
    is IrLtEq | IrLtEqVec -> "i64.le_s"
    is IrGtEq | IrGtEqVec -> "i64.ge_s"
    is IrAnd -> "i64.and"
    is IrOr -> "i64.or"
    is IrAppendText -> "i64.add"
    is IrAppendList -> "i64.add"
    is IrConsList -> "i64.add"
    is IrApproxEq -> "i64.eq"
    is IrApproxEqExact -> "i64.eq"

 wabt's JS wat2wasm parses expressions recursively and dies with "memory access
 out of bounds" somewhere between WAT depth 188 and 309 (measured 2026-08-28),
 so a match must not nest by arm count.

  emit-wat-match : WasmCtx, IRExpr, List IRBranch, Integer -> Text
  emit-wat-match (ctx) (scrut) (branches) (depth) =
   if list-length branches == 0 then "(unreachable)"
   else "(local.set " & wat-scrut ctx & " " & emit-wat-expr ctx scrut & ") (block $_m (result i64) "
        & emit-wat-match-body ctx branches 0 depth & "(unreachable))"

  emit-wat-match-body : WasmCtx, List IRBranch, Integer, Integer -> Text
  emit-wat-match-body (ctx) (branches) (i) (depth) =
   if i >= list-length branches then ""
   else let b = list-at branches i
   in let arm = emit-wat-match-arm ctx (b.pattern) (b.guard) (b.body) branches i depth
   in arm & emit-wat-match-body ctx branches (i + 1) depth

  emit-wat-arm-block : Text, Text, Text, Text -> Text
  emit-wat-arm-block (pre) (cond) (post) (body) =
   "(block $_a " & pre & "(br_if $_a (i32.eqz " & cond & ")) " & post
     & "(br $_m " & body & ")) "

 wat spells hex `0x`; the `#` prefix Codex uses is refused by wat2wasm as
 "unexpected token #A9".

  wat-lit-pat-const : Text -> Text
  wat-lit-pat-const (t) =
   if t == "True" then "1"
   else if t == "False" then "0"
   else text-replace t "#" "0x"

  wat-lit-pat-test : WasmCtx, Text, CodexType -> Text
  wat-lit-pat-test (ctx) (text) (ty) =
   if wat-is-text-type ty then
    "(i32.wrap_i64 (call $text_eq (local.get " & wat-scrut ctx & ") " & wat-strtab-ref (ctx.strings) text & "))"
   else "(i64.eq (local.get " & wat-scrut ctx & ") (i64.const " & wat-lit-pat-const text & "))"

  wat-guard-trivial : IRExpr -> Boolean
  wat-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  emit-wat-guard-test : WasmCtx, IRExpr -> Text
  emit-wat-guard-test (ctx) (guard) = "(i32.wrap_i64 " & emit-wat-expr (ctx-deeper ctx) guard & ")"

  wat-arm-cond : WasmCtx, IRExpr -> Text
  wat-arm-cond (ctx) (guard) =
   if wat-guard-trivial guard then "(i32.const 1)" else emit-wat-guard-test ctx guard

  emit-wat-match-arm : WasmCtx, IRPat, IRExpr, IRExpr, List IRBranch, Integer, Integer -> Text
  emit-wat-match-arm (ctx) (pat) (guard) (body) (branches) (i) (depth) =
   when pat
    is IrLitPat (text) (ty) (sp) ->
     let lit-test = wat-lit-pat-test ctx text ty
     in let cond = if wat-guard-trivial guard then lit-test
        else "(i32.and " & lit-test & " " & emit-wat-guard-test ctx guard & ")"
     in emit-wat-arm-block "" cond "" (emit-wat-expr ctx body)
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-wat-ctor-pat ctx name subs guard body branches i depth
    is IrVarPat (name) (ty) (sp) ->
     let bind = "(local.set $" & wat-sanitize name & " (local.get " & wat-scrut ctx & ")) "
     in emit-wat-arm-block bind (wat-arm-cond ctx guard) "" (emit-wat-expr ctx body)
    is IrWildPat (sp) ->
     emit-wat-arm-block "" (wat-arm-cond ctx guard) "" (emit-wat-expr ctx body)
    is IrVecPat (pats) (ty) (sp) ->
     let vcond = wat-emit-vec-pat-cond ctx pats ty
     in let cond = if wat-guard-trivial guard then vcond
        else "(i32.and " & vcond & " " & emit-wat-guard-test ctx guard & ")"
     in emit-wat-arm-block "" cond "" (emit-wat-expr ctx body)

  emit-wat-ctor-pat : WasmCtx, Text, List IRPat, IRExpr, IRExpr, List IRBranch, Integer, Integer -> Text
  emit-wat-ctor-pat (ctx) (name) (subs) (guard) (body) (branches) (i) (depth) =
   let tag = find-ctor-in-typedefs (ctx.type-defs) name 0
   in let bind-subs = emit-wat-bind-ctor-subs ctx subs 0
   in if (i == list-length branches - 1) & wat-guard-trivial guard & (wat-ctor-has-test-subs subs 0 == False) then
    emit-wat-arm-block "" "(i32.const 1)" bind-subs (emit-wat-expr ctx body)
   else emit-wat-arm-block "" (wat-ctor-arm-cond ctx tag subs guard bind-subs) bind-subs (emit-wat-expr ctx body)

  wat-ctor-has-test-subs : List IRPat, Integer -> Boolean
  wat-ctor-has-test-subs (subs) (i) =
   if i >= list-length subs then False
   else when list-at subs i
    is IrLitPat (t) (ty) (sp) -> True
    is IrCtorPat (n) (ss) (ty) (sp) -> True
    is otherwise -> wat-ctor-has-test-subs subs (i + 1)

  wat-and-tests : Text, Text -> Text
  wat-and-tests (acc) (t) =
   if text-length acc == 0 then t else "(i32.and " & acc & " " & t & ")"

  wat-ctor-sub-tests : WasmCtx, List IRPat, Integer, Text -> Text
  wat-ctor-sub-tests (ctx) (subs) (i) (acc) =
   wat-ctor-sub-tests-at ctx subs i acc ("(local.get " & wat-scrut ctx & ")")

  wat-ctor-sub-tests-at : WasmCtx, List IRPat, Integer, Text, Text -> Text
  wat-ctor-sub-tests-at (ctx) (subs) (i) (acc) (base) =
   if i >= list-length subs then acc
   else let fld = "(i64.load (i32.add (i32.wrap_i64 " & base & ") (i32.const " & integer-to-text (8 + i * 8) & ")))"
   in when list-at subs i
    is IrCtorPat (n) (ss) (ty) (sp) ->
     let tag = find-ctor-in-typedefs (ctx.type-defs) n 0
     in let tag-test = "(i64.eq (i64.load (i32.wrap_i64 " & fld & ")) (i64.const " & integer-to-text tag & "))"
     in let binds = emit-wat-bind-ctor-subs-at ctx ss 0 fld
     in let inner = wat-ctor-sub-tests-at ctx ss 0 "" fld
     in let under = if text-length inner == 0 then "(i32.const 1)" else inner
     in let whole = if (text-length inner == 0) & (text-length binds == 0) then tag-test
        else "(if (result i32) " & tag-test & " (then " & binds & under & ") (else (i32.const 0)))"
     in wat-ctor-sub-tests-at ctx subs (i + 1) (wat-and-tests acc whole) base
    is IrLitPat (t) (ty) (sp) ->
     wat-ctor-sub-tests-at ctx subs (i + 1) (wat-and-tests acc
      (if wat-is-text-type ty
       then "(i32.wrap_i64 (call $text_eq " & fld & " " & wat-strtab-ref (ctx.strings) t & "))"
       else "(i64.eq " & fld & " (i64.const " & wat-lit-pat-const t & "))")) base
    is otherwise -> wat-ctor-sub-tests-at ctx subs (i + 1) acc base

  wat-ctor-arm-cond : WasmCtx, Integer, List IRPat, IRExpr, Text -> Text
  wat-ctor-arm-cond (ctx) (tag) (subs) (guard) (bind-subs) =
   let tag-test = "(i64.eq (i64.load (i32.wrap_i64 (local.get " & wat-scrut ctx & "))) (i64.const " & integer-to-text tag & "))"
   in let subt = wat-ctor-sub-tests ctx subs 0 ""
   in let inner = if wat-guard-trivial guard then subt
      else if text-length subt == 0 then emit-wat-guard-test ctx guard
      else "(if (result i32) " & subt & " (then " & emit-wat-guard-test ctx guard & ") (else (i32.const 0)))"
   in if text-length inner == 0 then tag-test
      else "(if (result i32) " & tag-test & " (then " & bind-subs & inner & ") (else (i32.const 0)))"

  emit-wat-bind-ctor-subs : WasmCtx, List IRPat, Integer -> Text
  emit-wat-bind-ctor-subs (ctx) (subs) (i) =
   emit-wat-bind-ctor-subs-at ctx subs i ("(local.get " & wat-scrut ctx & ")")

  emit-wat-bind-ctor-subs-at : WasmCtx, List IRPat, Integer, Text -> Text
  emit-wat-bind-ctor-subs-at (ctx) (subs) (i) (base) =
   if i >= list-length subs then ""
   else let fld = "(i64.load (i32.add (i32.wrap_i64 " & base & ") (i32.const " & integer-to-text (8 + i * 8) & ")))"
   in let sub = list-at subs i
   in (when sub
    is IrVarPat (name) (ty) (sp) -> "(local.set $" & wat-sanitize name & " " & fld & ") "
    is IrWildPat (sp) -> ""
    is IrVecPat (pats) (ty) (sp) -> ""
    is otherwise -> "") & emit-wat-bind-ctor-subs-at ctx subs (i + 1) base

  emit-wat-act : WasmCtx, List IRActStmt -> Text
  emit-wat-act (ctx) (stmts) =
   emit-wat-act-stmts ctx stmts 0

  emit-wat-act-stmts : WasmCtx, List IRActStmt, Integer -> Text
  emit-wat-act-stmts (ctx) (stmts) (i) =
   if i == list-length stmts then "(i64.const 0)"
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> "(local.set $" & wat-sanitize name & " " & emit-wat-expr ctx val & ") "
    is IrDoExec (e) (sp) -> if is-last then emit-wat-expr ctx e else "(drop " & emit-wat-expr ctx e & ") ") & (if is-last then "" else emit-wat-act-stmts ctx stmts (i + 1))

Section: Apply Emission

  emit-wat-apply : WasmCtx, IRExpr -> Text
  emit-wat-apply (ctx) (e) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     let bi = wat-try-builtin ctx n args
     in if text-length bi > 0 then bi
     else if wh-op-arity (ctx.eff-ops) n 0 >= 0 then wh-emit-op-call ctx n args
     else if locals-contains (ctx.bound) (wat-sanitize n) then wat-emit-indirect ctx args ("(local.get $" & wat-sanitize n & ")")
     else if is-ctor-name (ctx.type-defs) n 0 then emit-wat-ctor ctx n args
     else if lookup-arity (ctx.arities) n < 0 then
      (if locals-contains (ctx.bound) (wat-sanitize n)
       then wat-emit-indirect ctx args ("(local.get $" & wat-sanitize n & ")")
       else wat-refuse-name n)
     else wat-emit-named-apply ctx n args (lookup-arity (ctx.arities) n)
    is IrLambda (ps) (lbody) (lty) (lsp) -> emit-wat-lambda-apply ctx ps lbody args
    is otherwise -> wat-emit-indirect ctx args (emit-wat-expr ctx root)

  wat-emit-indirect : WasmCtx, List IRExpr, Text -> Text
  wat-emit-indirect (ctx) (args) (callee) =
   let n = list-length args
   in if n >= 2 & n <= wat-fn-type-ceiling (ctx.arities)
      then "(call $clo_apply" & integer-to-text n & " " & callee & wat-emit-indirect-args ctx args 0 & ")"
   else wat-emit-apply-chain ctx args 0 callee

  wat-emit-indirect-args : WasmCtx, List IRExpr, Integer -> Text
  wat-emit-indirect-args (ctx) (args) (i) =
   if i >= list-length args then ""
   else " " & emit-wat-expr ctx (list-at args i) & wat-emit-indirect-args ctx args (i + 1)

  wat-emit-apply-chain : WasmCtx, List IRExpr, Integer, Text -> Text
  wat-emit-apply-chain (ctx) (args) (i) (acc) =
   if i >= list-length args then acc
   else let step = "(call $clo_apply1 " & acc & " " & emit-wat-expr ctx (list-at args i) & ")"
   in wat-emit-apply-chain ctx args (i + 1) step

  wat-emit-named-apply : WasmCtx, Text, List IRExpr, Integer -> Text
  wat-emit-named-apply (ctx) (n) (args) (ar) =
   let k = list-length args
   in if k == ar then "(call $" & wat-sanitize n & " " & emit-wat-apply-args ctx args 0 & ")"
   else if k < ar then
    let seed = "(i64.const " & integer-to-text (lookup-fn-index (ctx.arities) n) & ")"
    in wat-emit-apply-chain ctx args 0 seed
   else
    let sat = "(call $" & wat-sanitize n & " " & emit-wat-apply-args ctx (list-take args ar) 0 & ")"
    in wat-emit-apply-chain ctx (list-drop args ar) 0 sat


 WebAssembly has no closures and no way to invoke a lambda where it stands, and
 a partial application has no wasm form.

  emit-wat-lambda-apply : WasmCtx, List IRParam, IRExpr, List IRExpr -> Text
  emit-wat-lambda-apply (ctx) (ps) (lbody) (args) =
   if list-length args < list-length ps
   then "(unreachable (; wasm plug: partial application of a lambda has no form ;))"
   else emit-wat-lambda-binds ctx ps args 0 & " " & emit-wat-expr ctx lbody

  emit-wat-lambda-binds : WasmCtx, List IRParam, List IRExpr, Integer -> Text
  emit-wat-lambda-binds (ctx) (ps) (args) (i) =
   if i >= list-length ps then ""
   else "(local.set $" & wat-sanitize ((list-at ps i).name) & " " & emit-wat-expr ctx (list-at args i) & ") "
        & emit-wat-lambda-binds ctx ps args (i + 1)

  wat-emit-maybe-line : WasmCtx, Text -> Text
  wat-emit-maybe-line (ctx) (reader) =
   let just-tag = find-ctor-in-typedefs (ctx.type-defs) "Just" 0
   in let none-tag = find-ctor-in-typedefs (ctx.type-defs) "None" 0
   in "(local.set $_tv (call " & reader & ")) " &
      "(if (result i64) (i64.eqz (local.get $_tv)) " &
      "(then (local.set $_rp (i64.extend_i32_u (call $bump_alloc (i32.const 8)))) " &
      "(i64.store (i32.wrap_i64 (local.get $_rp)) (i64.const " & integer-to-text none-tag & ")) " &
      "(local.get $_rp)) " &
      "(else (local.set $_rp (i64.extend_i32_u (call $bump_alloc (i32.const 16)))) " &
      "(i64.store (i32.wrap_i64 (local.get $_rp)) (i64.const " & integer-to-text just-tag & ")) " &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_rp)) (i32.const 8)) (local.get $_tv)) " &
      "(local.get $_rp)))"

  emit-wat-ctor : WasmCtx, Text, List IRExpr -> Text
  emit-wat-ctor (ctx) (name) (args) =
   let tag = find-ctor-in-typedefs (ctx.type-defs) name 0
   in let fc = list-length args
   in let sz = 8 + fc * 8
   in let alloc = "(local.set $_rp (i64.extend_i32_u (call $bump_alloc (i32.const " & integer-to-text sz & "))))"
   in let store-tag = "(i64.store (i32.wrap_i64 (local.get $_rp)) (i64.const " & integer-to-text tag & "))"
   in let stores = emit-wat-ctor-fields ctx args 0
   in alloc & " " & store-tag & " " & stores & "(local.get $_rp)"

  emit-wat-ctor-fields : WasmCtx, List IRExpr, Integer -> Text
  emit-wat-ctor-fields (ctx) (args) (i) =
   if i >= list-length args then ""
   else let off = 8 + i * 8
   in wat-guard-scratch ctx (list-at args i) "$_rp" (emit-wat-expr ctx (list-at args i)) &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_rp)) (i32.const " & integer-to-text off & ")) (local.get $_tv)) " & emit-wat-ctor-fields ctx args (i + 1)

  emit-wat-apply-args : WasmCtx, List IRExpr, Integer -> Text
  emit-wat-apply-args (ctx) (args) (i) =
   if i == list-length args then ""
   else emit-wat-expr ctx (list-at args i) & " " & emit-wat-apply-args ctx args (i + 1)

  wat-is-text-type : CodexType -> Boolean
  wat-is-text-type (ty) =
   when ty
    is TextTy -> True
    is UnitTy (n) (inner) -> wat-is-text-type inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-is-text-type ret
    is otherwise -> False

 A real is carried as its f64 BITS in an i64 slot and reaches an f64 only inside
 the operator that needs one. An approximate real is computed at f32: `f64.add`
 on two singles answers a finite double where single arithmetic overflows.
 2139095039 is the largest finite single and 2139095040 is `+inf`.

 IEEE-754: an all-ones exponent is an infinity or a NaN, and a nonzero mantissa
 within that is a NaN. Decrementing an infinity's bit pattern gives the largest
 finite magnitude of the same sign, because the decrement never reaches the
 sign bit. A ULP is a property of the width: the two smallest denormals either
 side of zero are 2 ULPs apart as singles and astronomically far apart as
 doubles.

 One 16-byte vector box is exactly one `v128`; the lane width is `16 / lanes`
 bytes. wasm SIMD has no integer divide at any width, so `i64x2.div` does not
 exist.

  wat-vec-shape : Integer, CodexType -> Text
  wat-vec-shape (lanes) (elem) =
   if wat-is-real-type elem then
    (if lanes == 2 then "f64x2" else if lanes == 4 then "f32x4" else "")
   else if wat-is-integer-elem elem then
    (if lanes == 2 then "i64x2" else if lanes == 4 then "i32x4" else "")
   else ""

  wat-is-integer-elem : CodexType -> Boolean
  wat-is-integer-elem (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> True
    is UnitTy (n) (inner) -> wat-is-integer-elem inner
    is otherwise -> False

  wat-vec-of-type : CodexType -> Text
  wat-vec-of-type (ty) =
   when ty
    is VectorTy (n) (elem) -> wat-vec-shape n elem
    is UnitTy (n) (inner) -> wat-vec-of-type inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-vec-of-type ret
    is otherwise -> ""

  wat-vec-lane-bytes : Text -> Integer
  wat-vec-lane-bytes (shape) = if shape == "f64x2" | shape == "i64x2" then 8 else 4

  wat-vec-refuse : Text -> Text
  wat-vec-refuse (why) = "(unreachable (; wasm plug: " & why & " ;))"

  wat-is-vec256-name : Text -> Boolean
  wat-is-vec256-name (n) = text-starts-with n "vec8-" | text-starts-with n "vec4d-" | text-starts-with n "mask8-" | text-starts-with n "mask4d-"

  wat-vec256-refuse : Text -> Text
  wat-vec256-refuse (n) = "(codex-refused-" & n & "-256-bit-vector-on-wasm)"

  wat-vec-is-wide : CodexType -> Boolean
  wat-vec-is-wide (ty) =
   when ty
    is VectorTy (n) (elem) -> if wat-is-real-type elem then (if wat-elem-is-f32 elem then n > 4 else n > 2) else n > 4
    is UnitTy (n) (inner) -> wat-vec-is-wide inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-vec-is-wide ret
    is otherwise -> False

  wat-elem-is-f32 : CodexType -> Boolean
  wat-elem-is-f32 (ty) =
   when ty
    is UnitTy (n) (inner) -> wat-elem-is-f32 inner
    is otherwise -> is-real-f32 ty

  wat-emit-vec-splat : WasmCtx, IRExpr, Integer -> Text
  wat-emit-vec-splat (ctx) (arg) (lanes) =
   let shape = wat-vec-shape lanes (ir-expr-type arg)
   in let v = emit-wat-expr ctx arg
   in if shape == "f64x2" then "(call $cx_vec_box (f64x2.splat (f64.reinterpret_i64 " & v & ")))"
      else if shape == "f32x4" then "(call $cx_vec_box (f32x4.splat (f32.demote_f64 (f64.reinterpret_i64 " & v & "))))"
      else if shape == "i64x2" then "(call $cx_vec_box (i64x2.splat " & v & "))"
      else if shape == "i32x4" then "(call $cx_vec_box (i32x4.splat (i32.wrap_i64 " & v & ")))"
      else wat-vec-refuse ("no vector shape for a splat of " & integer-to-text lanes & " lanes")

  wat-emit-vec-extract : WasmCtx, IRExpr, IRExpr -> Text
  wat-emit-vec-extract (ctx) (vec) (idx) =
   let shape = wat-vec-of-type (ir-expr-type vec)
   in if text-length shape == 0 then wat-vec-refuse "no vector shape for an extract"
   else let at = "(i32.add (i32.wrap_i64 " & emit-wat-expr ctx vec & ") (i32.mul (i32.wrap_i64 " & emit-wat-expr ctx idx & ") (i32.const " & integer-to-text (wat-vec-lane-bytes shape) & ")))"
   in if shape == "f64x2" | shape == "i64x2" then "(i64.load " & at & ")"
      else if shape == "f32x4" then "(i64.reinterpret_f64 (f64.promote_f32 (f32.load " & at & ")))"
      else "(i64.extend_i32_s (i32.load " & at & "))"

  wat-emit-vec-arith : WasmCtx, IRBinaryOp, IRExpr, IRExpr, Integer -> Text
  wat-emit-vec-arith (ctx) (op) (l) (r) (depth) =
   let shape = wat-vec-of-type (ir-expr-type l)
   in let isdiv = when op is IrDivVec -> True is otherwise -> False
   in if wat-vec-is-wide (ir-expr-type l) then wat-vec256-refuse "vector-operator"
   else if text-length shape == 0 then wat-vec-refuse "no vector shape for this arithmetic"
   else if isdiv & (shape == "i64x2" | shape == "i32x4") then
    wat-vec-refuse "wasm SIMD has no integer division, so a vector integer divide has no form"
   else "(call $cx_vec_box (" & shape & wat-vec-op-suffix op & " (v128.load (i32.wrap_i64 " & emit-wat-expr-at ctx l (depth + 1) & ")) (v128.load (i32.wrap_i64 " & emit-wat-expr-at ctx r (depth + 1) & "))))"

  wat-emit-vec-pat-cond : WasmCtx, List IRPat, CodexType -> Text
  wat-emit-vec-pat-cond (ctx) (pats) (ty) =
   let lanes = list-length pats
   in if lanes == 2 then wat-vec-pat-lanes ctx 8 pats 0 ""
      else if lanes == 4 then wat-vec-pat-lanes ctx 4 pats 0 ""
      else wat-vec-refuse ("no vector pattern form for " & integer-to-text lanes & " lanes")

  wat-vec-pat-lanes : WasmCtx, Integer, List IRPat, Integer, Text -> Text
  wat-vec-pat-lanes (ctx) (lb) (pats) (i) (acc) =
   if i >= list-length pats then (if text-length acc == 0 then "(i32.const 1)" else acc)
   else let at = "(i32.add (i32.wrap_i64 (local.get " & wat-scrut ctx & ")) (i32.const " & integer-to-text (i * lb) & "))"
   in let load = if lb == 8 then "(i64.load " & at & ")" else "(i64.extend_i32_s (i32.load " & at & "))"
   in when list-at pats i
    is IrLitPat (t) (pty) (sp) ->
     wat-vec-pat-lanes ctx lb pats (i + 1) (wat-and-tests acc ("(i64.eq " & load & " (i64.const " & wat-lit-pat-const t & "))"))
    is otherwise -> wat-vec-pat-lanes ctx lb pats (i + 1) acc

  wat-emit-vec-named-arith : WasmCtx, Text, List IRExpr -> Text
  wat-emit-vec-named-arith (ctx) (suffix) (args) =
   let l = list-at args 0
   in let shape = wat-vec-of-type (ir-expr-type l)
   in if text-length shape == 0 then wat-vec-refuse "no vector shape for this arithmetic"
   else if suffix == ".div" & (shape == "i64x2" | shape == "i32x4") then
    wat-vec-refuse "wasm SIMD has no integer division, so a vector integer divide has no form"
   else "(call $cx_vec_box (" & shape & suffix & " (v128.load (i32.wrap_i64 " & emit-wat-expr ctx l & ")) (v128.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & "))))"

  wat-emit-vec-reduce : WasmCtx, IRExpr -> Text
  wat-emit-vec-reduce (ctx) (vec) =
   let shape = wat-vec-of-type (ir-expr-type vec)
   in if text-length shape == 0 then wat-vec-refuse "no vector shape for a reduction"
      else "(call $cx_vec_sum_" & shape & " " & emit-wat-expr ctx vec & ")"

  wat-vec-op-suffix : IRBinaryOp -> Text
  wat-vec-op-suffix (op) =
   when op
    is IrAddVec -> ".add"
    is IrSubVec -> ".sub"
    is IrMulVec -> ".mul"
    is otherwise -> ".div"

 A lane comparison answers all-ones or all-zeros in every lane, which is the
 same 16-byte box a vector is, so a mask needs no representation of its own.
 The integer shapes spell their comparisons `_s`; the float ones do not.

  wat-emit-vec-cmp : WasmCtx, IRBinaryOp, IRExpr, IRExpr, Integer -> Text
  wat-emit-vec-cmp (ctx) (op) (l) (r) (depth) =
   let shape = wat-vec-of-type (ir-expr-type l)
   in if wat-vec-is-wide (ir-expr-type l) then wat-vec256-refuse "vector-comparison"
   else if text-length shape == 0 then wat-vec-refuse "no vector shape for this comparison"
   else let signed = if shape == "i64x2" | shape == "i32x4" then "_s" else ""
   in "(call $cx_vec_box (" & shape & wat-vec-cmp-suffix op & signed & " (v128.load (i32.wrap_i64 " & emit-wat-expr-at ctx l (depth + 1) & ")) (v128.load (i32.wrap_i64 " & emit-wat-expr-at ctx r (depth + 1) & "))))"

  wat-vec-cmp-suffix : IRBinaryOp -> Text
  wat-vec-cmp-suffix (op) =
   when op
    is IrLtVec -> ".lt"
    is IrGtVec -> ".gt"
    is IrLtEqVec -> ".le"
    is otherwise -> ".ge"

 Every mask builtin is declared over `VectorMask 2` and there is no other width
 in the language, so the query is `i64x2.bitmask` with no type consulted: two
 lanes, one bit each, all-set being 3.

  wat-emit-mask-query : WasmCtx, Text, IRExpr -> Text
  wat-emit-mask-query (ctx) (n) (m) =
   let bits = "(call $cx_mask_bits " & emit-wat-expr ctx m & ")"
   in if n == "mask-any" then "(i64.extend_i32_u (i32.ne " & bits & " (i32.const 0)))"
      else if n == "mask-all" then "(i64.extend_i32_u (i32.eq " & bits & " (i32.const 3)))"
      else if n == "mask-none" then "(i64.extend_i32_u (i32.eqz " & bits & "))"
      else "(call $cx_mask_count " & emit-wat-expr ctx m & ")"

  wat-emit-mask4-query : WasmCtx, Text, IRExpr -> Text
  wat-emit-mask4-query (ctx) (n) (m) =
   let bits = "(call $cx_mask4_bits " & emit-wat-expr ctx m & ")"
   in if n == "mask4-any" then "(i64.extend_i32_u (i32.ne " & bits & " (i32.const 0)))"
      else if n == "mask4-all" then "(i64.extend_i32_u (i32.eq " & bits & " (i32.const 15)))"
      else if n == "mask4-none" then "(i64.extend_i32_u (i32.eqz " & bits & "))"
      else "(call $cx_mask4_count " & emit-wat-expr ctx m & ")"

  wat-emit-vec-select : WasmCtx, List IRExpr -> Text
  wat-emit-vec-select (ctx) (args) =
   "(call $cx_vec_box (v128.bitselect (v128.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & ")) (v128.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 2) & ")) (v128.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & "))))"

  wat-emit-approx-eq : WasmCtx, IRExpr, IRExpr, Integer, Integer -> Text
  wat-emit-approx-eq (ctx) (l) (r) (depth) (tol) =
   let a = emit-wat-expr-at ctx l (depth + 1)
   in let b = emit-wat-expr-at ctx r (depth + 1)
   in if wat-is-real-f32 (ir-expr-type l)
      then "(call $__approx_eq32 " & a & " " & b & " (i32.const " & integer-to-text tol & "))"
      else "(call $__approx_eq " & a & " " & b & " (i64.const " & integer-to-text tol & "))"

  wat-is-real-f32 : CodexType -> Boolean
  wat-is-real-f32 (ty) =
   when ty
    is RealTy (w) (m) -> when w is RwF32 -> True is otherwise -> False
    is UnitTy (n) (inner) -> wat-is-real-f32 inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-is-real-f32 ret
    is otherwise -> False

  wat-f32-instr : IRBinaryOp -> Text
  wat-f32-instr (op) =
   when op
    is IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "f32.add"
    is IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "f32.sub"
    is IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "f32.mul"
    is otherwise -> "f32.div"

  wat-real-mode-fn : IRBinaryOp, Boolean -> Text
  wat-real-mode-fn (op) (f32) =
   when op
    is IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping ->
     if f32 then "$cx_real_trap32" else "$cx_real_trap64"
    is IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating ->
     if f32 then "$cx_real_sat32" else "$cx_real_sat64"
    is otherwise -> ""

  wat-emit-real-arith : WasmCtx, IRBinaryOp, IRExpr, IRExpr, Integer -> Text
  wat-emit-real-arith (ctx) (op) (l) (r) (depth) =
   let f32 = wat-is-real-f32 (ir-expr-type l)
   in let lf = wat-f64-in (emit-wat-expr-at ctx l (depth + 1))
   in let rf = wat-f64-in (emit-wat-expr-at ctx r (depth + 1))
   in let raw = if f32
      then "(f64.promote_f32 (" & wat-f32-instr op & " (f32.demote_f64 " & lf & ") (f32.demote_f64 " & rf & ")))"
      else "(" & wat-bin-instr op & " " & lf & " " & rf & ")"
   in let mode-fn = wat-real-mode-fn op f32
   in if text-length mode-fn == 0 then wat-f64-out raw
      else "(call " & mode-fn & " " & wat-f64-out raw & ")"

  wat-is-real-type : CodexType -> Boolean
  wat-is-real-type (ty) =
   when ty
    is RealTy (w) (m) -> True
    is UnitTy (n) (inner) -> wat-is-real-type inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-is-real-type ret
    is otherwise -> False

  wat-f64-in : Text -> Text
  wat-f64-in (x) = "(f64.reinterpret_i64 " & x & ")"

  wat-f64-out : Text -> Text
  wat-f64-out (x) = "(i64.reinterpret_f64 " & x & ")"

  wat-emit-print-line : WasmCtx, IRExpr -> Text
  wat-emit-print-line (ctx) (arg) =
   let ty = ir-expr-type arg
   in if wat-is-text-type ty then "(call $wasi_print_text " & emit-wat-expr ctx arg & ") (call $wasi_print_newline) (i64.const 0)"
   else "(call $wasi_print_i64 " & emit-wat-expr ctx arg & ") (call $wasi_print_newline) (i64.const 0)"

  wat-slot-in-ty : WasmCtx, CodexType, Text, Integer -> Integer
  wat-slot-in-ty (ctx) (ty) (field-name) (fallback) =
   let fs = wat-fields-of-ty ctx ty
   in if list-length fs == 0 then fallback
      else let k = find-record-field-index fs field-name 0
      in if (list-at fs k).name.value == field-name then k else fallback

  wat-slot-for-expr : WasmCtx, IRExpr, Text -> Integer
  wat-slot-for-expr (ctx) (rec) (field-name) =
   let named = wat-field-slot (ctx.type-defs) field-name
   in wat-slot-in-ty ctx (ir-expr-type rec) (wat-field-bare field-name) named

  wat-fields-of-ty : WasmCtx, CodexType -> List RecordField
  wat-fields-of-ty (ctx) (ty) =
   when ty
    is RecordTy (name) (args) (fields) ->
     if list-length fields > 0 then fields
     else record-fields-by-name (ctx.type-defs) (name.value) 0
    is ConstructedTy (name) (args) -> resolve-record-fields (ctx.type-defs) (name.value) 0
    is TypeCon (name) -> resolve-record-fields (ctx.type-defs) (name.value) 0
    is otherwise -> []

  wat-emit-record-set : WasmCtx, List IRExpr -> Text
  wat-emit-record-set (ctx) (args) =
   let rec-expr = list-at args 0
   in let field-expr = list-at args 1
   in let val-expr = list-at args 2
   in let field-name = when field-expr
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in let rec-ty = ir-expr-type rec-expr
   in let idx = wat-slot-for-expr ctx rec-expr field-name
   in let off = idx * 8
   in "(local.set $_rp " & emit-wat-expr ctx rec-expr & ") " &
      wat-guard-scratch ctx val-expr "$_rp" (emit-wat-expr ctx val-expr) &
      "(i64.store (i32.add (i32.wrap_i64 (local.get $_rp)) (i32.const " & integer-to-text off & ")) (local.get $_tv)) " &
      "(local.get $_rp)"

  wat-emit-show : WasmCtx, IRExpr -> Text
  wat-emit-show (ctx) (arg) =
   let ty = ir-expr-type arg
   in if wat-is-text-type ty then emit-wat-expr ctx arg
   else if wat-is-boolean-type ty then "(call $bool_to_text " & emit-wat-expr ctx arg & ")"
   else if wat-is-real-type ty then "(call $__f64_to_text " & emit-wat-expr ctx arg & ")"
   else "(call $i64_to_text " & emit-wat-expr ctx arg & ")"

  wat-is-boolean-type : CodexType -> Boolean
  wat-is-boolean-type (ty) =
   when ty
    is BooleanTy -> True
    is UnitTy (n) (inner) -> wat-is-boolean-type inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-is-boolean-type ret
    is otherwise -> False

  wat-addr-of : WasmCtx, List IRExpr -> Text
  wat-addr-of (ctx) (args) =
   "(i32.add (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ") (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & "))"

  wat-refuse-name : Text -> Text
  wat-refuse-name (n) =
   "(unreachable (; wasm plug: no form for " & n & " ;))"

  wat-no-such-thing : Text -> Boolean
  wat-no-such-thing (n) =
   n == "port-out-byte" |
   n == "port-in-byte" |
   n == "host-socket" |
   n == "prof-dump" |
   n == "prof-start"

  wat-try-builtin : WasmCtx, Text, List IRExpr -> Text
  wat-try-builtin (ctx) (n) (args) =
   if n == "__heap-restore" then "(block (result i64) (global.set $heap_ptr (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")) (i64.const 0))"
   else if n == "peek-byte" then "(i64.load8_u " & wat-addr-of ctx args & ")"
   else if n == "peek-qword" then "(i64.load " & wat-addr-of ctx args & ")"
   else if n == "poke-byte" then "(i64.store8 " & wat-addr-of ctx args & " " & emit-wat-expr ctx (list-at args 2) & ") (i64.const 0)"
   else if n == "poke-16" then "(i64.store16 " & wat-addr-of ctx args & " " & emit-wat-expr ctx (list-at args 2) & ") (i64.const 0)"
   else if n == "address-of" then emit-wat-expr ctx (list-at args 0)
   else if n == "__narrow" then emit-wat-expr ctx (list-at args 0)
   else if n == "variant-tag" then "(i64.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & "))"
   else if n == "min" then "(call $cx_min " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "__memset" then "(call $cx_memset " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ") (i64.const 0)"
   else if n == "__heap-advance" then "(block (result i64) (drop (call $bump_alloc (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & "))) (i64.const 0))"
   else if n == "__deck-set" then "(block (result i64) (global.set $deck_ptr (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")) (i64.const 0))"
   else if n == "__deck-alloc" then "(block (result i64) (call $__deck_enter) (i64.extend_i32_u (call $bump_alloc (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & "))) (call $__deck_exit))"
   else if n == "deck-record" & list-length args == 1 then "(block (result i64) (call $__deck_enter) " & emit-wat-expr ctx (list-at args 0) & " (call $__deck_exit))"
   else if n == "alloc-bytes" then "(i64.extend_i32_u (call $bump_alloc (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")))"
   else if n == "print-text" then "(call $wasi_print_text " & emit-wat-expr ctx (list-at args 0) & ") (i64.const 0)"
   else if n == "print-uni" then "(call $wasi_print_text " & emit-wat-expr ctx (list-at args 0) & ") (i64.const 0)"
   else if n == "write-binary" then "(call $write_binary " & emit-wat-expr ctx (list-at args 0) & ") (i64.const 0)"
   else if n == "write-binary-buf" then "(call $write_binary_buf " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ") (i64.const 0)"
   else if n == "char-code-at" then "(i64.load8_u (i32.add (i32.add (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ") (i32.const 4)) (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & ")))"
   else if n == "block-read-sector" then "(call $block_read_sector " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "block-write-sector" then "(call $block_write_sector " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "process-get-scope" | n == "process-get-network-scope" then "(call $process_scope_empty " & emit-wat-expr ctx (list-at args 0) & ")"
   else if wat-no-such-thing n then "(unreachable (; wasm plug: " & n & " has no form on this target ;))"
   else if n == "print-line-uni" then wat-emit-print-line ctx (list-at args 0)
   else if n == "print-line" then wat-emit-print-line ctx (list-at args 0)
   else if n == "print-error-uni" | n == "print-error" then wat-emit-print-line ctx (list-at args 0)
   else if n == "print-line-raw" then "(call $cx_print_text_raw " & emit-wat-expr ctx (list-at args 0) & ") (i64.const 0)"
   else if n == "abs" then "(call $cx_abs " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "max" then "(call $cx_max " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "show" then wat-emit-show ctx (list-at args 0)
   else if n == "integer-to-text" then "(call $i64_to_text " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "text-to-integer" then "(call $cx_text_to_integer " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "text-to-double-bits" then "(call $text_to_double " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "raw-bytes-to-text" then "(call $raw_bytes_to_text " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "read-serial-cce" then "(call $read_serial_cce " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "read-file-uni" then "(call $read_file_uni " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "read-file-raw" then "(call $read_file_raw " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "text-starts-with" then "(call $cx_text_starts_with " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "text-contains" then "(call $cx_text_contains " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "text-replace" then "(call $cx_text_replace " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "text-split" then "(call $cx_text_split " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "text-length" then "(i64.extend_i32_u (i32.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")))"
   else if n == "char-at" then "(call $char_at " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "char-to-text" then "(call $char_to_text " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "char-encode" then "(call $char_encode " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "substring" then "(call $substring " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "list-length" | n == "__list-len" then "(call $list_length " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "list-at" then "(call $list_at " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "list-push" | n == "list-snoc" then "(call $list_push " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "char-code" then emit-wat-expr ctx (list-at args 0)
   else if n == "code-to-char" then emit-wat-expr ctx (list-at args 0)
   else if n == "__list-head" then "(call $list_at " & emit-wat-expr ctx (list-at args 0) & " (i64.const 0))"
   else if n == "__list-tail" then "(call $cx_list_tail " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "is-digit" then "(call $__is_digit " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "is-letter" then "(call $__is_letter " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "is-whitespace" then "(call $__is_whitespace " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "negate" then if wat-is-real-type (ir-expr-type (list-at args 0)) then wat-f64-out ("(f64.neg " & wat-f64-in (emit-wat-expr ctx (list-at args 0)) & ")")
                              else "(i64.sub (i64.const 0) " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "int-mod" then "(call $codex_mod " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-and" then "(i64.and " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-or" then "(i64.or " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-xor" then "(i64.xor " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-shl" then "(i64.shl " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-shr" then "(i64.shr_s " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-shru" then "(i64.shr_u " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "bit-not" then "(i64.xor " & emit-wat-expr ctx (list-at args 0) & " (i64.const -1))"
   else if n == "process-exit" then "(unreachable)"
   else if n == "text-compare" then "(call $__text_compare " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "real-to-bits" | n == "bits-to-real" | n == "from-real-approx" then emit-wat-expr ctx (list-at args 0)
   else if n == "to-real-trapping" | n == "from-real-trapping" | n == "to-real-saturating" | n == "from-real-saturating" then emit-wat-expr ctx (list-at args 0)
   else if n == "to-real-approx-trapping" | n == "from-real-approx-trapping" | n == "to-real-approx-saturating" | n == "from-real-approx-saturating" then emit-wat-expr ctx (list-at args 0)
   else if n == "real-from-int" then wat-f64-out ("(f64.convert_i64_s " & emit-wat-expr ctx (list-at args 0) & ")")
   else if n == "real-approx-from-int" then wat-f64-out ("(f64.promote_f32 (f32.convert_i64_s " & emit-wat-expr ctx (list-at args 0) & "))")
   else if n == "real-to-int" | n == "real-approx-to-int" then "(call $cx_real_to_int " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "to-real-approx" then wat-f64-out ("(f64.promote_f32 (f32.demote_f64 " & wat-f64-in (emit-wat-expr ctx (list-at args 0)) & "))")
   else if wat-is-vec256-name n then wat-vec256-refuse n
   else if n == "vec-splat" then wat-emit-vec-splat ctx (list-at args 0) 2
   else if n == "vec4-splat" then wat-emit-vec-splat ctx (list-at args 0) 4
   else if n == "vec-extract" | n == "vec4-extract" then wat-emit-vec-extract ctx (list-at args 0) (list-at args 1)
   else if n == "vec-add" then wat-emit-vec-named-arith ctx ".add" args
   else if n == "vec-sub" then wat-emit-vec-named-arith ctx ".sub" args
   else if n == "vec-mul" then wat-emit-vec-named-arith ctx ".mul" args
   else if n == "vec-div" then wat-emit-vec-named-arith ctx ".div" args
   else if n == "vec-reduce-add" then wat-emit-vec-reduce ctx (list-at args 0)
   else if n == "vec-load-at" then "(call $cx_vec_box (v128.load (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")))"
   else if n == "vec-store-at" then "(call $cx_vec_store " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "vec-select" | n == "vec4-select" then wat-emit-vec-select ctx args
   else if n == "mask-any" | n == "mask-all" | n == "mask-none" | n == "mask-count" then wat-emit-mask-query ctx n (list-at args 0)
   else if n == "mask4-any" | n == "mask4-all" | n == "mask4-none" | n == "mask4-count" then wat-emit-mask4-query ctx n (list-at args 0)
   else if n == "vec4-reduce-add" then wat-emit-vec-reduce ctx (list-at args 0)
   else if n == "real-approx-to-bits" then "(i64.extend_i32_u (i32.reinterpret_f32 (f32.demote_f64 " & wat-f64-in (emit-wat-expr ctx (list-at args 0)) & ")))"
   else if n == "bits-to-real-approx" then wat-f64-out ("(f64.promote_f32 (f32.reinterpret_i32 (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")))")
   else if n == "blit-framebuf" then "(call $blit_framebuf (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ")) (i64.const 0)"
   else if n == "__buf-write-byte" then "(call $buf_write_byte " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "__buf-write-bytes" then "(call $buf_write_bytes " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "__buf-read-bytes" then "(call $buf_read_bytes " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "__list-with-capacity" then "(call $list_with_capacity " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "list-insert-at" then "(call $list_insert_at " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "__linked-list-empty" then "(i64.const 0)"
   else if n == "__linked-list-push" then "(call $ll_push " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & ")"
   else if n == "__linked-list-to-list" then "(call $ll_to_list " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "text-concat-list" then "(call $text_concat_list " & emit-wat-expr ctx (list-at args 0) & ")"
   else if n == "list-set-at" then "(call $list_set_at " & emit-wat-expr ctx (list-at args 0) & " " & emit-wat-expr ctx (list-at args 1) & " " & emit-wat-expr ctx (list-at args 2) & ")"
   else if n == "__record-set" then wat-emit-record-set ctx args
   else if n == "poke-32" then "(i32.store (i32.add (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ") (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & ")) (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 2) & ")) (i64.const 0)"
   else if n == "peek-32" then "(i64.extend_i32_u (i32.load (i32.add (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 0) & ") (i32.wrap_i64 " & emit-wat-expr ctx (list-at args 1) & "))))"
   else ""

Section: Tail Call Optimization

  is-self-tail-call : Text, IRExpr -> Boolean
  is-self-tail-call (fname) (e) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     let chain = collect-apply-chain e []
     in when chain.root
      is IrName (n) (ty2) (sp2) -> n == fname
      is otherwise -> False
    is IrIf (c) (t) (el) (ty) (sp) ->
     is-self-tail-call fname t | is-self-tail-call fname el
    is IrLet (n) (ty) (val) (body) (sp) ->
     is-self-tail-call fname body
    is IrMatch (scrut) (branches) (ty) (sp) ->
     is-self-tail-call-branches fname branches 0
    is IrAct (stmts) (ty) (sp) ->
     is-self-tail-call-last-exec fname stmts
    is otherwise -> False

  is-self-tail-call-branches : Text, List IRBranch, Integer -> Boolean
  is-self-tail-call-branches (fname) (bs) (i) =
   if i >= list-length bs then False
   else if is-self-tail-call fname ((list-at bs i).body) then True
   else is-self-tail-call-branches fname bs (i + 1)

  is-self-tail-call-last-exec : Text, List IRActStmt -> Boolean
  is-self-tail-call-last-exec (fname) (stmts) =
   if list-length stmts == 0 then False
   else when list-at stmts (list-length stmts - 1)
    is IrDoExec (e) (sp) -> is-self-tail-call fname e
    is otherwise -> False

  emit-tco-temp-decls : Integer, Integer -> Text
  emit-tco-temp-decls (i) (count) =
   if i >= count then ""
   else "(local $_tco_" & integer-to-text i & " i64) " & emit-tco-temp-decls (i + 1) count

  emit-tco-store-args : WasmCtx, List IRParam, List IRExpr, Integer -> Text
  emit-tco-store-args (ctx) (params) (args) (i) =
   if i >= list-length args then ""
   else "(local.set $_tco_" & integer-to-text i & " " & emit-tco-arg ctx params (list-at args i) i & ") " & emit-tco-store-args ctx params args (i + 1)

  emit-tco-arg : WasmCtx, List IRParam, IRExpr, Integer -> Text
  emit-tco-arg (ctx) (params) (arg) (i) =
   if i >= list-length params then emit-wat-expr ctx arg
   else if wip-listed (ctx.inplace) ((list-at params i).name) 0 == False then emit-wat-expr ctx arg
   else when arg
    is IrBinary (op) (l) (r) (ty) (sp) ->
     (when l
      is IrName (ln) (lt) (ls) ->
       if ln == (list-at params i).name & wip-is-append op then "(call $text_append_inplace " & emit-wat-expr ctx l & " " & emit-wat-expr ctx r & ")"
       else emit-wat-expr ctx arg
      is otherwise -> emit-wat-expr ctx arg)
    is otherwise -> emit-wat-expr ctx arg

  emit-tco-copy-params : List IRParam, Integer -> Text
  emit-tco-copy-params (params) (i) =
   if i >= list-length params then ""
   else "(local.set $" & wat-sanitize ((list-at params i).name) & " (local.get $_tco_" & integer-to-text i & ")) " & emit-tco-copy-params params (i + 1)

  emit-wat-expr-tco : WasmCtx, Text, List IRParam, IRExpr, Integer -> Text
  emit-wat-expr-tco (ctx) (fname) (params) (e) (depth) =
   if depth >= 256 then emit-wat-expr ctx e
   else when e
    is IrApply (f) (a) (ty) (sp) ->
     let chain = collect-apply-chain e []
     in when chain.root
      is IrName (n) (ty2) (sp2) ->
       if n == fname then
        emit-tco-store-args ctx params (chain.args) 0 & emit-tco-copy-params params 0 & "(br $tco_loop)"
       else emit-wat-tail-apply ctx e n (chain.args)
      is otherwise -> emit-wat-apply ctx e
    is IrIf (c) (t) (el) (ty) (sp) ->
     emit-wat-if-chain-tco ctx fname params e depth
    is IrLet (name) (ty) (val) (body) (sp) ->
     "(local.set $" & wat-sanitize name & " " & emit-wat-expr-at ctx val (depth + 1) & ") " & emit-wat-expr-tco ctx fname params body (depth + 1)
    is IrMatch (scrut) (branches) (ty) (sp) ->
     emit-wat-match-tco ctx fname params scrut branches depth
    is IrAct (stmts) (ty) (sp) ->
     emit-wat-act-stmts-tco ctx fname params stmts 0 depth
    is otherwise -> emit-wat-expr-at ctx e depth

  emit-wat-if-chain-tco : WasmCtx, Text, List IRParam, IRExpr, Integer -> Text
  emit-wat-if-chain-tco (ctx) (fname) (params) (e) (depth) =
   "(block $_i (result i64) " & emit-wat-if-arms-tco ctx fname params e depth & ")"

  emit-wat-if-arms-tco : WasmCtx, Text, List IRParam, IRExpr, Integer -> Text
  emit-wat-if-arms-tco (ctx) (fname) (params) (e) (depth) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     "(block $_c (br_if $_c (i32.eqz (i32.wrap_i64 " & emit-wat-expr-at ctx c (depth + 1) & "))) (br $_i " & emit-wat-expr-tco ctx fname params t (depth + 1) & ")) "
       & emit-wat-if-arms-tco ctx fname params el depth
    is otherwise -> emit-wat-expr-tco ctx fname params e (depth + 1)

  emit-wat-act-stmts-tco : WasmCtx, Text, List IRParam, List IRActStmt, Integer, Integer -> Text
  emit-wat-act-stmts-tco (ctx) (fname) (params) (stmts) (i) (depth) =
   if i == list-length stmts then "(i64.const 0)"
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> "(local.set $" & wat-sanitize name & " " & emit-wat-expr ctx val & ") "
    is IrDoExec (e) (sp) -> if is-last then emit-wat-expr-tco ctx fname params e (depth + 1) else "(drop " & emit-wat-expr ctx e & ") ") & (if is-last then "" else emit-wat-act-stmts-tco ctx fname params stmts (i + 1) depth)

 A wasm `return_call` runs in the caller's frame, so mutual tail recursion runs
 in constant stack; a browser's stack is fixed and only wasmtime takes a flag to
 grow it.

  emit-wat-tail-apply : WasmCtx, IRExpr, Text, List IRExpr -> Text
  emit-wat-tail-apply (ctx) (e) (n) (args) =
   let bi = wat-try-builtin ctx n args
   in if text-length bi > 0 then emit-wat-apply ctx e
   else if is-ctor-name (ctx.type-defs) n 0 then emit-wat-apply ctx e
   else if locals-contains (ctx.bound) (wat-sanitize n) then emit-wat-apply ctx e
   else let ar = lookup-arity (ctx.arities) n
   in if ar > 0 & list-length args == ar then
    "(return_call $" & wat-sanitize n & " " & emit-wat-apply-args ctx args 0 & ")"
   else emit-wat-apply ctx e

  emit-wat-match-tco : WasmCtx, Text, List IRParam, IRExpr, List IRBranch, Integer -> Text
  emit-wat-match-tco (ctx) (fname) (params) (scrut) (branches) (depth) =
   if list-length branches == 0 then "(unreachable)"
   else "(local.set " & wat-scrut ctx & " " & emit-wat-expr-at ctx scrut (depth + 1) & ") (block $_m (result i64) "
        & emit-wat-branches-tco ctx fname params branches 0 depth & "(unreachable))"

  emit-wat-branches-tco : WasmCtx, Text, List IRParam, List IRBranch, Integer, Integer -> Text
  emit-wat-branches-tco (ctx) (fname) (params) (bs) (i) (depth) =
   if i >= list-length bs then ""
   else let b = list-at bs i
   in let arm = emit-wat-arm-tco ctx fname params (b.pattern) (b.guard) (b.body) bs i depth
   in arm & emit-wat-branches-tco ctx fname params bs (i + 1) depth

  emit-wat-arm-tco : WasmCtx, Text, List IRParam, IRPat, IRExpr, IRExpr, List IRBranch, Integer, Integer -> Text
  emit-wat-arm-tco (ctx) (fname) (params) (pat) (guard) (bexpr) (bs) (i) (depth) =
   let body = emit-wat-expr-tco ctx fname params bexpr (depth + 1)
   in when pat
    is IrLitPat (text) (ty) (sp) ->
     let lit-test = wat-lit-pat-test ctx text ty
     in let cond = if wat-guard-trivial guard then lit-test
        else "(i32.and " & lit-test & " " & emit-wat-guard-test ctx guard & ")"
     in emit-wat-arm-block "" cond "" body
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-wat-ctor-arm-tco ctx name subs guard body bs i
    is IrVarPat (name) (ty) (sp) ->
     let bind = "(local.set $" & wat-sanitize name & " (local.get " & wat-scrut ctx & ")) "
     in emit-wat-arm-block bind (wat-arm-cond ctx guard) "" body
    is IrWildPat (sp) ->
     emit-wat-arm-block "" (wat-arm-cond ctx guard) "" body
    is IrVecPat (pats) (ty) (sp) ->
     let vcond = wat-emit-vec-pat-cond ctx pats ty
     in let cond = if wat-guard-trivial guard then vcond
        else "(i32.and " & vcond & " " & emit-wat-guard-test ctx guard & ")"
     in emit-wat-arm-block "" cond "" body

  emit-wat-ctor-arm-tco : WasmCtx, Text, List IRPat, IRExpr, Text, List IRBranch, Integer -> Text
  emit-wat-ctor-arm-tco (ctx) (name) (subs) (guard) (body) (bs) (i) =
   let tag = find-ctor-in-typedefs (ctx.type-defs) name 0
   in let bind-subs = emit-wat-bind-ctor-subs ctx subs 0
   in if (i == list-length bs - 1) & wat-guard-trivial guard & (wat-ctor-has-test-subs subs 0 == False) then
    emit-wat-arm-block "" "(i32.const 1)" bind-subs body
   else emit-wat-arm-block "" (wat-ctor-arm-cond ctx tag subs guard bind-subs) bind-subs body

Section: Effect Handlers

  wh-global : Text -> Text
  wh-global (op) = "$eff_" & wat-sanitize op

  wh-emit-op-call : WasmCtx, Text, List IRExpr -> Text
  wh-emit-op-call (ctx) (n) (args) =
   if list-length args /= wh-op-arity (ctx.eff-ops) n 0 then wat-refuse-name n
   else if list-length args == 0 then "(call $clo_apply1 (global.get " & wh-global n & ") (i64.const 0))"
   else wat-emit-indirect ctx args ("(global.get " & wh-global n & ")")

  wh-emit-handle : WasmCtx, IRExpr, List IRHandleClause, Integer -> Text
  wh-emit-handle (ctx) (body) (cs) (depth) =
   "(block (result i64) " & wh-emit-installs ctx cs 0 & "(global.set $eff_res " & emit-wat-expr-at ctx body (depth + 1) & ") " & wh-emit-restores cs (list-length cs) & "(global.get $eff_res))"

  wh-emit-installs : WasmCtx, List IRHandleClause, Integer -> Text
  wh-emit-installs (ctx) (cs) (i) =
   if i >= list-length cs then ""
   else let c = list-at cs i
   in "(call $eff_push (global.get " & wh-global (c.op-name) & ")) (global.set " & wh-global (c.op-name) & " " & emit-wat-expr ctx (c.body) & ") " & wh-emit-installs ctx cs (i + 1)

  wh-emit-restores : List IRHandleClause, Integer -> Text
  wh-emit-restores (cs) (i) =
   if i <= 0 then ""
   else "(global.set " & wh-global ((list-at cs (i - 1)).op-name) & " (call $eff_pop)) " & wh-emit-restores cs (i - 1)

  wh-runtime : List WhOp -> Text
  wh-runtime (ops) =
   if list-length ops == 0 then ""
   else "  (global $eff_top (mut i32) (i32.const 0))\n  (global $eff_res (mut i64) (i64.const 0))\n" & wh-op-globals ops 0 &
   "  (func $eff_push (param $v i64) (local $p i32)\n" &
   "    (local.set $p (call $bump_alloc (i32.const 12)))\n" &
   "    (i64.store (local.get $p) (local.get $v))\n" &
   "    (i32.store (i32.add (local.get $p) (i32.const 8)) (global.get $eff_top))\n" &
   "    (global.set $eff_top (local.get $p)))\n" &
   "  (func $eff_pop (result i64) (local $p i32)\n" &
   "    (local.set $p (global.get $eff_top))\n" &
   "    (global.set $eff_top (i32.load (i32.add (local.get $p) (i32.const 8))))\n" &
   "    (i64.load (local.get $p)))\n"

  wh-op-globals : List WhOp, Integer -> Text
  wh-op-globals (ops) (i) =
   if i >= list-length ops then ""
   else "  (global " & wh-global ((list-at ops i).op) & " (mut i64) (i64.const -1))\n" & wh-op-globals ops (i + 1)

Section: In-place Text Accumulators

 The port of x86-64's `inplace-accumulators` (`Emit/X86_64.codex`). A Text
 parameter qualifies when every self tail call passes it back as itself, a
 literal, or `acc & r` with `r` not mentioning it, and nothing else reads it,
 so the loop holds the only reference and extending it in place cannot change
 a value anyone else can see. `$text_own` keeps the caller's copy out of reach.

  wip-is-append : IRBinaryOp -> Boolean
  wip-is-append (op) =
   when op
    is IrAppendText -> True
    is otherwise -> False

  wip-clean : IRExpr, Text -> Integer
  wip-clean (e) (acc) = if wip-mentions e acc then 0 - 1 else 0

  wip-join : Integer, Integer -> Integer
  wip-join (a) (b) = if a < 0 | b < 0 then 0 - 1 else a + b

  wip-walk : IRExpr, Text, Text, Integer, Integer -> Integer
  wip-walk (e) (acc) (fname) (k) (np) =
   when e
    is IrName (n) (ty) (sp) -> 0
    is IrIf (c) (t) (el) (ty) (sp) ->
     wip-join (wip-clean c acc) (wip-join (wip-walk t acc fname k np) (wip-walk el acc fname k np))
    is IrLet (n) (ty) (v) (b) (sp) ->
     if n == acc then 0 - 1
     else wip-join (wip-clean v acc) (wip-walk b acc fname k np)
    is IrApply (f) (a) (ty) (sp) ->
     let chain = collect-apply-chain e []
     in (when chain.root
      is IrName (n) (t2) (s2) ->
       if n /= fname then wip-clean e acc
       else if list-length (chain.args) /= np then wip-clean e acc
       else wip-walk-args (chain.args) acc k 0 0
      is otherwise -> wip-clean e acc)
    is IrMatch (s) (bs) (ty) (sp) ->
     wip-join (wip-clean s acc) (wip-walk-branches bs acc fname k np 0 0)
    is otherwise -> wip-clean e acc

  wip-walk-branches : List IRBranch, Text, Text, Integer, Integer, Integer, Integer -> Integer
  wip-walk-branches (bs) (acc) (fname) (k) (np) (i) (total) =
   if total < 0 then total
   else if i >= list-length bs then total
   else let b = list-at bs i
   in if wip-pat-binds (b.pattern) acc then 0 - 1
   else let here = wip-join (wip-clean (b.guard) acc) (wip-walk (b.body) acc fname k np)
   in wip-walk-branches bs acc fname k np (i + 1) (wip-join total here)

  wip-walk-args : List IRExpr, Text, Integer, Integer, Integer -> Integer
  wip-walk-args (args) (acc) (k) (i) (total) =
   if total < 0 then total
   else if i >= list-length args then total
   else let arg = list-at args i
   in let here = if i /= k then wip-clean arg acc else wip-acc-arg arg acc
   in wip-walk-args args acc k (i + 1) (wip-join total here)

  wip-acc-arg : IRExpr, Text -> Integer
  wip-acc-arg (arg) (acc) =
   when arg
    is IrName (n) (ty) (sp) -> if n == acc then 0 else 0 - 1
    is IrTextLit (t) (sp) -> 0
    is IrBinary (op) (l) (r) (ty) (sp) ->
     (when l
      is IrName (ln) (lt) (ls) -> if wip-is-append op == False | ln /= acc | wip-mentions r acc then 0 - 1 else 1
      is otherwise -> 0 - 1)
    is otherwise -> 0 - 1

  wip-param-is-text : CodexType -> Boolean
  wip-param-is-text (ty) =
   when ty
    is TextTy -> True
    is otherwise -> False

  wip-accumulators : IRDef, Integer, List Text -> List Text
  wip-accumulators (def) (i) (found) =
   let params = def.params
   in if i >= list-length params then found
   else let p = list-at params i
   in let ok = wip-param-is-text (p.type-val) & wip-walk (def.body) (p.name) (def.name) i (list-length params) > 0
   in wip-accumulators def (i + 1) (if ok then list-push found (p.name) else found)

  emit-wip-guards : List Text, Integer -> Text
  emit-wip-guards (names) (i) =
   if i >= list-length names then ""
   else "(call $text_own (local.get $" & wat-sanitize (list-at names i) & ")) " & emit-wip-guards names (i + 1)

Section: Definition Emission

  emit-wat-def : WasmCtx, IRDef -> Text
  emit-wat-def (ctx) (d) =
   let name = wat-sanitize (d.name)
   in let all-locals = collect-locals-expr (d.body) (collect-locals-params (d.params) 0 [])
   in let locals = locals-minus-params all-locals (d.params) 0 []
   in let bound = collect-locals-params (d.params) 0 all-locals
   in let dctx = ctx-with ctx bound
   in if is-self-tail-call (d.name) (d.body) then
    let pc = list-length (d.params)
    in let tco-temps = emit-tco-temp-decls 0 pc
    in let local-text = emit-local-decls locals 0
    in let ip = wip-accumulators d 0 []
    in "  (func $" & name & " " & emit-wat-def-params (d.params) 0 & "(result i64) " & local-text & tco-temps & "\n    " & emit-wip-guards ip 0 & "(loop $tco_loop (result i64) " & emit-wat-expr-tco (ctx-with-inplace dctx ip) (d.name) (d.params) (d.body) 0 & "))\n"
   else let local-text = emit-local-decls locals 0
   in "  (func $" & name & " " & emit-wat-def-params (d.params) 0 & "(result i64) " & local-text & "\n    " & emit-wat-expr-tco dctx "" (d.params) (d.body) 0 & ")\n"

  emit-wat-def-params : List IRParam, Integer -> Text
  emit-wat-def-params (params) (i) =
   if i == list-length params then ""
   else "(param $" & wat-sanitize ((list-at params i).name) & " i64) " & emit-wat-def-params params (i + 1)

Section: WASI Runtime Helpers

 A WASI host supplies `wasi_snapshot_preview1` and nothing else, so an `env`
 import the host lacks fails instantiation (`unknown import:
 env::blit_framebuf` under wasmtime); the two `env` imports are emitted only
 when the program calls them.

  wat-runtime-header : Integer, Boolean, Boolean -> Text
  wat-runtime-header (heap-start) (needs-blit) (needs-key) =
   "(module\n" &
   "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n" &
   "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n" &
   (if needs-blit then "  (import \"env\" \"blit_framebuf\" (func $blit_framebuf (param i32)))\n" else "") &
   (if needs-key then "  (import \"env\" \"on_key\" (func $on_key_import (param i32) (result i32)))\n" else "") &
   "  (memory (export \"memory\") 256)\n" &
   "  (global $heap_ptr (mut i32) (i32.const " & integer-to-text heap-start & "))\n" &
   "  (global $heap_start i32 (i32.const " & integer-to-text heap-start & "))\n" &
   "  (global $deck_ptr (mut i32) (i32.const " & integer-to-text heap-start & "))\n" &
   "  (global $bivy_save (mut i32) (i32.const " & integer-to-text heap-start & "))\n" &
   "  (global $deck_depth (mut i32) (i32.const 0))\n" &
   "  (global $rd_len (mut i32) (i32.const 0))\n" &
   "  (global $rd_pos (mut i32) (i32.const 0))\n" &
   "  (global $disk_base (mut i32) (i32.const 0))\n" &
   "  (global $disk_size (mut i32) (i32.const 0))\n" &
   "  (func $__heap_reset (global.set $heap_ptr (global.get $heap_start)))\n" &
   "  (export \"__heap_reset\" (func $__heap_reset))\n" &
   "  (func $__deck_enter\n" &
   "    (if (i32.eqz (global.get $deck_depth)) (then\n" &
   "      (global.set $bivy_save (global.get $heap_ptr))\n" &
   "      (global.set $heap_ptr (global.get $deck_ptr))))\n" &
   "    (global.set $deck_depth (i32.add (global.get $deck_depth) (i32.const 1))))\n" &
   "  (func $__deck_exit\n" &
   "    (global.set $deck_depth (i32.sub (global.get $deck_depth) (i32.const 1)))\n" &
   "    (if (i32.eqz (global.get $deck_depth)) (then\n" &
   "      (global.set $deck_ptr (global.get $heap_ptr))\n" &
   "      (global.set $heap_ptr (global.get $bivy_save)))))\n" &
   wat-rt-ipow &
   wat-rt-int-trap &
   wat-rt-real-to-int &
   "  (func $codex_mod (param $a i64) (param $b i64) (result i64) (local $m i64) (local $r i64)\n" &
   "    (local.set $m (select (i64.sub (i64.const 0) (local.get $b)) (local.get $b) (i64.lt_s (local.get $b) (i64.const 0))))\n" &
   "    (local.set $r (i64.rem_s (local.get $a) (local.get $m)))\n" &
   "    (select (i64.add (local.get $r) (local.get $m)) (local.get $r) (i64.lt_s (local.get $r) (i64.const 0))))\n\n"

 `real-to-int` on x86-64 is `cvttsd2si`: truncate toward zero, and the integer
 indefinite INT64_MIN for a NaN, an infinity, or a value whose truncation does
 not fit. `i64.trunc_sat_f64_s` agrees on all of those except NaN (saturates
 to 0) and positive overflow (saturates to INT64_MAX).

 wasm has no overflow flag and no i128, so each check is on the result: add and
 sub overflow iff the result's sign differs from both operands (add) or the
 operands' signs differ and the result's sign differs from the left's (sub);
 mul checks the quotient, which cannot equal the multiplier after a wrap
 because the wrapped result is off by a multiple of 2^64 and the divisor is
 below 2^63.

  wat-rt-int-trap : Text =
   "  (func $cx_add_trap (param $a i64) (param $b i64) (result i64) (local $r i64)\n" &
   "    (local.set $r (i64.add (local.get $a) (local.get $b)))\n" &
   "    (if (i64.lt_s (i64.and (i64.xor (local.get $r) (local.get $a)) (i64.xor (local.get $r) (local.get $b))) (i64.const 0)) (then (unreachable)))\n" &
   "    (local.get $r))\n\n" &
   "  (func $cx_sub_trap (param $a i64) (param $b i64) (result i64) (local $r i64)\n" &
   "    (local.set $r (i64.sub (local.get $a) (local.get $b)))\n" &
   "    (if (i64.lt_s (i64.and (i64.xor (local.get $a) (local.get $b)) (i64.xor (local.get $a) (local.get $r))) (i64.const 0)) (then (unreachable)))\n" &
   "    (local.get $r))\n\n" &
   "  (func $cx_mul_trap (param $a i64) (param $b i64) (result i64) (local $r i64)\n" &
   "    (local.set $r (i64.mul (local.get $a) (local.get $b)))\n" &
   "    (if (i64.eqz (local.get $a)) (then (return (local.get $r))))\n" &
   "    (if (i64.eq (local.get $a) (i64.const -1))\n" &
   "      (then (if (i64.eq (local.get $b) (i64.const -9223372036854775808)) (then (unreachable))) (return (local.get $r))))\n" &
   "    (if (i64.ne (i64.div_s (local.get $r) (local.get $a)) (local.get $b)) (then (unreachable)))\n" &
   "    (local.get $r))\n\n"

  wat-rt-ipow : Text =
   "  (func $cx_ipow (param $b i64) (param $e i64) (result i64)\n" &
   "    (local $acc i64)\n" &
   "    (local.set $acc (i64.const 1))\n" &
   "    (if (i64.lt_s (local.get $e) (i64.const 0)) (then (return (i64.const 0))))\n" &
   "    (block $done (loop $pow\n" &
   "      (br_if $done (i64.eqz (local.get $e)))\n" &
   "      (local.set $acc (i64.mul (local.get $acc) (local.get $b)))\n" &
   "      (local.set $e (i64.sub (local.get $e) (i64.const 1)))\n" &
   "      (br $pow)))\n" &
   "    (local.get $acc))\n\n" &
   "  (func $cx_abs (param $x i64) (result i64)\n" &
   "    (if (i64.lt_s (local.get $x) (i64.const 0))\n" &
   "      (then (return (i64.sub (i64.const 0) (local.get $x)))))\n" &
   "    (local.get $x))\n\n" &
   "  (func $cx_max (param $a i64) (param $b i64) (result i64)\n" &
   "    (if (i64.ge_s (local.get $a) (local.get $b)) (then (return (local.get $a))))\n" &
   "    (local.get $b))\n\n" &
   "  (func $cx_print_text_raw (param $t i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $t)))\n" &
   "    (call $write_raw (i32.add (local.get $p) (i32.const 4)) (i32.load (local.get $p))))\n\n"

  wat-rt-real-to-int : Text =
   "  (func $cx_real_to_int (param $b i64) (result i64) (local $f f64)\n" &
   "    (local.set $f (f64.reinterpret_i64 (local.get $b)))\n" &
   "    (if (result i64) (f64.ne (local.get $f) (local.get $f))\n" &
   "      (then (i64.const -9223372036854775808))\n" &
   "      (else (if (result i64) (f64.ge (local.get $f) (f64.const 9223372036854775808))\n" &
   "        (then (i64.const -9223372036854775808))\n" &
   "        (else (i64.trunc_sat_f64_s (local.get $f)))))))\n\n"

 The declared 256 pages are 16 MB. The memory grows in 16 MB steps because
 V8's cost per `memory.grow` rises with the memory already held, so the COUNT
 of grows is what costs (measured 2026-08-31: 56,000 one-page grows to 3.5 GB,
 node 166.83 s against wasmtime 0.21 s; 1,000 grows of 16 pages to 1 GB, 0.38 s
 against 5.45 s for 16,000 of one). A fixed step rather than doubling, because
 doubling overshoots by up to 12.5 per cent near wasm32's 4 GiB ceiling.

  wasm-grow-step-pages : Integer = 256

  wat-rt-bump-alloc : Text =
   "  (func $grow_by (param $need i32) (param $have i32)\n" &
   "    (local $pages i32)\n" &
   "    (local.set $pages (i32.add\n" &
   "      (i32.div_u (i32.sub (local.get $need) (local.get $have)) (i32.const 65536))\n" &
   "      (i32.const 1)))\n" &
   "    (if (i32.lt_u (local.get $pages) (i32.const " & integer-to-text wasm-grow-step-pages & "))\n" &
   "      (then (local.set $pages (i32.const " & integer-to-text wasm-grow-step-pages & "))))\n" &
   "    (if (i32.eq (memory.grow (local.get $pages)) (i32.const -1)) (then (unreachable))))\n\n" &
   "  (func $bump_alloc (param $size i32) (result i32)\n" &
   "    (local $ptr i32) (local $need i32) (local $have i32)\n" &
   "    (local.set $ptr (global.get $heap_ptr))\n" &
   "    (local.set $need (i32.add (local.get $ptr) (local.get $size)))\n" &
   "    (local.set $have (i32.mul (memory.size) (i32.const 65536)))\n" &
   "    (if (i32.gt_u (local.get $need) (local.get $have))\n" &
   "      (then (call $grow_by (local.get $need) (local.get $have))))\n" &
   "    (global.set $heap_ptr (local.get $need))\n" &
   "    (local.get $ptr))\n\n"

  wat-rt-print-i64 : Text =
   "  (func $wasi_print_i64 (param $val i64)\n" &
   "    (local $abs i64) (local $neg i32) (local $buf i32) (local $pos i32) (local $digit i32) (local $len i32)\n" &
   "    (local.set $buf (call $bump_alloc (i32.const 24)))\n" &
   "    (local.set $pos (i32.add (local.get $buf) (i32.const 23)))\n" &
   "    (local.set $neg (i64.lt_s (local.get $val) (i64.const 0)))\n" &
   "    (if (local.get $neg)\n" &
   "      (then (local.set $abs (local.get $val)))\n" &
   "      (else (local.set $abs (i64.sub (i64.const 0) (local.get $val)))))\n" &
   "    (if (i64.eqz (local.get $abs))\n" &
   "      (then (i32.store8 (local.get $pos) (i32.const 48))\n" &
   "        (local.set $pos (i32.sub (local.get $pos) (i32.const 1))))\n" &
   "      (else (block $done (loop $digits\n" &
   "          (br_if $done (i64.eqz (local.get $abs)))\n" &
   "          (local.set $digit (i32.wrap_i64 (i64.sub (i64.const 0) (i64.rem_s (local.get $abs) (i64.const 10)))))\n" &
   "          (i32.store8 (local.get $pos) (i32.add (local.get $digit) (i32.const 48)))\n" &
   "          (local.set $pos (i32.sub (local.get $pos) (i32.const 1)))\n" &
   "          (local.set $abs (i64.div_s (local.get $abs) (i64.const 10)))\n" &
   "          (br $digits)))))\n" &
   "    (if (local.get $neg) (then\n" &
   "        (i32.store8 (local.get $pos) (i32.const 45))\n" &
   "        (local.set $pos (i32.sub (local.get $pos) (i32.const 1)))))\n" &
   "    (local.set $len (i32.sub (i32.add (local.get $buf) (i32.const 24)) (i32.add (local.get $pos) (i32.const 1))))\n" &
   "    (i32.store (i32.const 0) (i32.add (local.get $pos) (i32.const 1)))\n" &
   "    (i32.store (i32.const 4) (local.get $len))\n" &
   "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 16))))\n\n"

  wat-rt-print-misc : Integer, Integer, Integer -> Text
  wat-rt-print-misc (tab) (t2) (out) =
   "  (func $wasi_print_newline\n" &
   "    (i32.store8 (i32.const 20) (i32.const 10))\n" &
   "    (i32.store (i32.const 0) (i32.const 20))\n" &
   "    (i32.store (i32.const 4) (i32.const 1))\n" &
   "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 16))))\n\n" &
   "  (func $cce_flush (param $n i32)\n" &
   "    (if (local.get $n) (then\n" &
   "      (i32.store (i32.const 0) (i32.const " & integer-to-text out & "))\n" &
   "      (i32.store (i32.const 4) (local.get $n))\n" &
   "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 16))))))\n\n" &
   "  (func $cce_unicode (param $cc i32) (result i32)\n" &
   "    (local $u i32) (local $k i32) (local $e i32) (local $base i32) (local $sz i32)\n" &
   "    (if (i32.lt_u (local.get $cc) (i32.const " & integer-to-text cce-tab-entries & "))\n" &
   "      (then (return (i32.load16_u (i32.add (i32.const " & integer-to-text tab & ") (i32.shl (local.get $cc) (i32.const 1)))))))\n" &
   "    (local.set $u (i32.const 65533))\n" &
   "    (local.set $k (i32.const 0))\n" &
   "    (block $t2d (loop $t2c\n" &
   "      (br_if $t2d (i32.ge_u (local.get $k) (i32.const " & integer-to-text cce-tier2-block-count & ")))\n" &
   "      (local.set $e (i32.add (i32.const " & integer-to-text t2 & ") (i32.mul (local.get $k) (i32.const " & integer-to-text cce-t2-entry-bytes & "))))\n" &
   "      (local.set $base (i32.load (local.get $e)))\n" &
   "      (local.set $sz (i32.load (i32.add (local.get $e) (i32.const 4))))\n" &
