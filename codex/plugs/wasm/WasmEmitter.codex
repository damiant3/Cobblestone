  wat-emit-exports : List IRDef, Integer -> Text
  wat-emit-exports (defs) (i) =
   if i >= list-length defs then ""
   else let d = list-at defs i
   in let sn = wat-sanitize (d.name)
   in let needle = "|" & d.name & "|"
   in let ex = if text-contains wasm-export-list needle
               then "  (export \"" & sn & "\" (func $" & sn & "))\n"
               else ""
   in ex & wat-emit-exports defs (i + 1)

  wat-emit-entry : List IRDef -> Text
  wat-emit-entry (defs) = wat-emit-entry-loop defs 0 & wat-emit-exports defs 0

  wat-emit-entry-loop : List IRDef, Integer -> Text
  wat-emit-entry-loop (defs) (i) =
   if i >= list-length defs then ""
   else let d = list-at defs i
   in if d.name == opening-entry-point then
    if list-length (d.params) == 0 then
     let ret-type = strip-fun-args (d.type-val)
     in let print-fn = if wat-is-text-type ret-type then "$wasi_print_text" else "$wasi_print_i64"
     in let is-void = when ret-type
          is NothingTy -> True
          is VoidTy -> True
          is EffectfulTy (effs) (scopes) (r) -> when r is NothingTy -> True is VoidTy -> True is otherwise -> False
          is otherwise -> False
     in if is-void then
      "  (func $__start (drop (call $" & wat-sanitize opening-entry-point & ")))\n" &
      "  (export \"_start\" (func $__start))\n"
     else
      "  (func $__start\n" &
      "    (local $__r i64)\n" &
      "    (local.set $__r (call $" & wat-sanitize opening-entry-point & "))\n" &
      "    (call " & print-fn & " (local.get $__r))\n" &
      "    (call $wasi_print_newline))\n" &
      "  (export \"_start\" (func $__start))\n"
    else ""
   else wat-emit-entry-loop defs (i + 1)

