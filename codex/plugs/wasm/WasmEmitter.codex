   "      (i64.store (i32.add (local.get $dst) (i32.add (i32.const 16) (i32.mul (local.get $k) (i32.const 8))))\n" &
   "        (i64.load (i32.add (local.get $p) (i32.add (i32.const 8) (i32.mul (local.get $k) (i32.const 8))))))\n" &
   "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n" &
   "      (br $ibl)))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n"

 A buffer is a raw address in linear memory, which is what `alloc-bytes`
 hands back. Both writers return the offset PAST what they wrote, so a caller
 chains them without tracking a cursor; that return is the whole reason
 `__buf-write-byte` is not simply `poke-byte`.

 `__buf-read-bytes` costs 8 bytes of list per byte read, because its result
 type is `List Integer` and every value on this target is an i64. That is the
 8x blow-up `CLAUDE.md` names as a red flag, it is inherent to the builtin
 rather than to this implementation, and x86-64 pays it identically.

  wat-rt-buf : Text =
   "  (func $buf_write_byte (param $buf i64) (param $off i64) (param $b i64) (result i64)\n" &
   "    (i32.store8 (i32.add (i32.wrap_i64 (local.get $buf)) (i32.wrap_i64 (local.get $off))) (i32.wrap_i64 (local.get $b)))\n" &
   "    (i64.add (local.get $off) (i64.const 1)))\n\n" &
   "  (func $buf_write_bytes (param $buf i64) (param $off i64) (param $lst i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $k i32) (local $at i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $at (i32.add (i32.wrap_i64 (local.get $buf)) (i32.wrap_i64 (local.get $off))))\n" &
   "    (local.set $k (i32.const 0))\n" &
   "    (block $bwd (loop $bwl\n" &
   "      (br_if $bwd (i32.ge_s (local.get $k) (local.get $n)))\n" &
   "      (i32.store8 (i32.add (local.get $at) (local.get $k))\n" &
   "        (i32.wrap_i64 (i64.load (i32.add (local.get $p) (i32.add (i32.const 8) (i32.mul (local.get $k) (i32.const 8)))))))\n" &
   "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n" &
   "      (br $bwl)))\n" &
   "    (i64.add (local.get $off) (i64.extend_i32_u (local.get $n))))\n\n" &
   "  (func $buf_read_bytes (param $buf i64) (param $off i64) (param $count i64) (result i64)\n" &
   "    (local $src i32) (local $n i32) (local $dst i32) (local $k i32)\n" &
   "    (local.set $src (i32.add (i32.wrap_i64 (local.get $buf)) (i32.wrap_i64 (local.get $off))))\n" &
   "    (local.set $n (i32.wrap_i64 (local.get $count)))\n" &
   "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $n (i32.const 0))))\n" &
   "    (local.set $dst (call $bump_alloc (i32.add (i32.const 8) (i32.mul (local.get $n) (i32.const 8)))))\n" &
   "    (i32.store (local.get $dst) (local.get $n))\n" &
   "    (i32.store (i32.add (local.get $dst) (i32.const 4)) (local.get $n))\n" &
   "    (local.set $k (i32.const 0))\n" &
   "    (block $brd (loop $brl\n" &
   "      (br_if $brd (i32.ge_s (local.get $k) (local.get $n)))\n" &
   "      (i64.store (i32.add (local.get $dst) (i32.add (i32.const 8) (i32.mul (local.get $k) (i32.const 8))))\n" &
   "        (i64.load8_u (i32.add (local.get $src) (local.get $k))))\n" &
   "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n" &
   "      (br $brl)))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n"

 `fd_write` may write FEWER bytes than the iovec offers and report the count,
 which every other writer here drops because the text printer flushes at most
 240 bytes at a time. `write-binary-buf` hands over a whole artifact in one
 call, so `$write_raw` reads the count and loops (L-SHORT).

  wat-rt-write-binary : Text =
   "  (func $write_raw (param $at i32) (param $n i32)\n" &
   "    (local $w i32)\n" &
   "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return)))\n" &
   "    (block $wrd (loop $wrc\n" &
   "      (i32.store (i32.const 0) (local.get $at))\n" &
   "      (i32.store (i32.const 4) (local.get $n))\n" &
   "      (br_if $wrd (i32.ne (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 16)) (i32.const 0)))\n" &
   "      (local.set $w (i32.load (i32.const 16)))\n" &
   "      (br_if $wrd (i32.le_s (local.get $w) (i32.const 0)))\n" &
   "      (local.set $at (i32.add (local.get $at) (local.get $w)))\n" &
   "      (local.set $n (i32.sub (local.get $n) (local.get $w)))\n" &
   "      (br_if $wrd (i32.le_s (local.get $n) (i32.const 0)))\n" &
   "      (br $wrc))))\n\n" &
   "  (func $write_binary (param $lst i64)\n" &
   "    (local $p i32) (local $n i32) (local $dst i32) (local $i i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return)))\n" &
   "    (local.set $dst (call $bump_alloc (local.get $n)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $wbd (loop $wbc\n" &
   "      (br_if $wbd (i32.ge_s (local.get $i) (local.get $n)))\n" &
   "      (i32.store8 (i32.add (local.get $dst) (local.get $i))\n" &
   "        (i32.wrap_i64 (i64.load (i32.add (local.get $p) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 8)))))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $wbc)))\n" &
   "    (call $write_raw (local.get $dst) (local.get $n)))\n\n" &
   "  (func $write_binary_buf (param $buf i64) (param $off i64) (param $len i64)\n" &
   "    (call $write_raw (i32.add (i32.wrap_i64 (local.get $buf)) (i32.wrap_i64 (local.get $off)))\n" &
   "      (i32.wrap_i64 (local.get $len))))\n\n"

  wat-rt-text-search : Text =
   "  (func $cx_text_match_at (param $s i64) (param $sub i64) (param $at i32) (result i32)\n" &
   "    (local $ps i32) (local $pb i32) (local $ls i32) (local $lb i32) (local $k i32)\n" &
   "    (local.set $ps (i32.wrap_i64 (local.get $s)))\n" &
   "    (local.set $pb (i32.wrap_i64 (local.get $sub)))\n" &
   "    (local.set $ls (i32.load (local.get $ps)))\n" &
   "    (local.set $lb (i32.load (local.get $pb)))\n" &
   "    (if (i32.gt_s (i32.add (local.get $at) (local.get $lb)) (local.get $ls)) (then (return (i32.const 0))))\n" &
   "    (local.set $k (i32.const 0))\n" &
   "    (block $md (loop $mc\n" &
   "      (br_if $md (i32.ge_s (local.get $k) (local.get $lb)))\n" &
   "      (if (i32.ne\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $ps) (i32.const 4)) (i32.add (local.get $at) (local.get $k))))\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $pb) (i32.const 4)) (local.get $k))))\n" &
   "        (then (return (i32.const 0))))\n" &
   "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n" &
   "      (br $mc)))\n" &
   "    (i32.const 1))\n\n" &
   "  (func $cx_text_starts_with (param $s i64) (param $p i64) (result i64)\n" &
   "    (i64.extend_i32_u (call $cx_text_match_at (local.get $s) (local.get $p) (i32.const 0))))\n\n" &
   "  (func $cx_text_contains (param $s i64) (param $sub i64) (result i64)\n" &
   "    (local $ls i32) (local $lb i32) (local $i i32)\n" &
   "    (local.set $ls (i32.load (i32.wrap_i64 (local.get $s))))\n" &
   "    (local.set $lb (i32.load (i32.wrap_i64 (local.get $sub))))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $cd (loop $cc\n" &
   "      (br_if $cd (i32.gt_s (i32.add (local.get $i) (local.get $lb)) (local.get $ls)))\n" &
   "      (if (call $cx_text_match_at (local.get $s) (local.get $sub) (local.get $i)) (then (return (i64.const 1))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $cc)))\n" &
   "    (i64.const 0))\n\n" &
   "  (func $cx_text_to_integer (param $s i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $i i32) (local $neg i32) (local $c i32) (local $v i64)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $s)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (local.set $neg (i32.const 0))\n" &
   "    (local.set $v (i64.const 0))\n" &
   "    (if (i32.gt_s (local.get $n) (i32.const 0))\n" &
   "      (then (if (i32.eq (i32.load8_u (i32.add (local.get $p) (i32.const 4))) (i32.const " & integer-to-text cce-minus & "))\n" &
   "        (then (local.set $neg (i32.const 1)) (local.set $i (i32.const 1))))))\n" &
   "    (block $td (loop $tc\n" &
   "      (br_if $td (i32.ge_s (local.get $i) (local.get $n)))\n" &
   "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i))))\n" &
   "      (br_if $td (i32.lt_s (local.get $c) (i32.const " & integer-to-text cce-digit-zero & ")))\n" &
   "      (br_if $td (i32.gt_s (local.get $c) (i32.const " & integer-to-text (cce-digit-zero + 9) & ")))\n" &
   "      (local.set $v (i64.add (i64.mul (local.get $v) (i64.const 10)) (i64.extend_i32_u (i32.sub (local.get $c) (i32.const " & integer-to-text cce-digit-zero & ")))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $tc)))\n" &
   "    (if (result i64) (local.get $neg)\n" &
   "      (then (i64.sub (i64.const 0) (local.get $v)))\n" &
   "      (else (local.get $v))))\n\n" &
   "  (func $cx_text_replace (param $s i64) (param $a i64) (param $b i64) (result i64)\n" &
   "    (local $ps i32) (local $pb i32) (local $ls i32) (local $la i32) (local $lb i32)\n" &
   "    (local $i i32) (local $w i32) (local $k i32) (local $total i32) (local $out i32)\n" &
   "    (local.set $ps (i32.wrap_i64 (local.get $s)))\n" &
   "    (local.set $pb (i32.wrap_i64 (local.get $b)))\n" &
   "    (local.set $ls (i32.load (local.get $ps)))\n" &
   "    (local.set $la (i32.load (i32.wrap_i64 (local.get $a))))\n" &
   "    (local.set $lb (i32.load (local.get $pb)))\n" &
   "    (if (i32.eqz (local.get $la)) (then (return (local.get $s))))\n" &
   "    (local.set $total (i32.const 0))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $r1d (loop $r1c\n" &
   "      (br_if $r1d (i32.ge_s (local.get $i) (local.get $ls)))\n" &
   "      (if (call $cx_text_match_at (local.get $s) (local.get $a) (local.get $i))\n" &
   "        (then (local.set $total (i32.add (local.get $total) (local.get $lb)))\n" &
   "              (local.set $i (i32.add (local.get $i) (local.get $la))))\n" &
   "        (else (local.set $total (i32.add (local.get $total) (i32.const 1)))\n" &
   "              (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n" &
   "      (br $r1c)))\n" &
   "    (local.set $out (call $bump_alloc (i32.add (local.get $total) (i32.const 4))))\n" &
   "    (i32.store (local.get $out) (local.get $total))\n" &
   "    (local.set $w (i32.const 0))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $r2d (loop $r2c\n" &
   "      (br_if $r2d (i32.ge_s (local.get $i) (local.get $ls)))\n" &
   "      (if (call $cx_text_match_at (local.get $s) (local.get $a) (local.get $i))\n" &
   "        (then\n" &
   "          (local.set $k (i32.const 0))\n" &
   "          (block $r3d (loop $r3c\n" &
   "            (br_if $r3d (i32.ge_s (local.get $k) (local.get $lb)))\n" &
   "            (i32.store8 (i32.add (i32.add (local.get $out) (i32.const 4)) (local.get $w))\n" &
   "              (i32.load8_u (i32.add (i32.add (local.get $pb) (i32.const 4)) (local.get $k))))\n" &
   "            (local.set $w (i32.add (local.get $w) (i32.const 1)))\n" &
   "            (local.set $k (i32.add (local.get $k) (i32.const 1)))\n" &
   "            (br $r3c)))\n" &
   "          (local.set $i (i32.add (local.get $i) (local.get $la))))\n" &
   "        (else\n" &
   "          (i32.store8 (i32.add (i32.add (local.get $out) (i32.const 4)) (local.get $w))\n" &
   "            (i32.load8_u (i32.add (i32.add (local.get $ps) (i32.const 4)) (local.get $i))))\n" &
   "          (local.set $w (i32.add (local.get $w) (i32.const 1)))\n" &
   "          (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n" &
   "      (br $r2c)))\n" &
   "    (i64.extend_i32_u (local.get $out)))\n\n" &
   "  (func $cx_list_empty (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (call $bump_alloc (i32.const 8)))\n" &
   "    (i32.store (local.get $p) (i32.const 0))\n" &
   "    (i32.store (i32.add (local.get $p) (i32.const 4)) (i32.const 0))\n" &
   "    (i64.extend_i32_u (local.get $p)))\n\n" &
   "  (func $cx_text_split (param $s i64) (param $sep i64) (result i64)\n" &
   "    (local $ls i32) (local $lsep i32) (local $i i32) (local $start i32) (local $r i64)\n" &
   "    (local.set $ls (i32.load (i32.wrap_i64 (local.get $s))))\n" &
   "    (local.set $lsep (i32.load (i32.wrap_i64 (local.get $sep))))\n" &
   "    (local.set $r (call $cx_list_empty))\n" &
   "    (if (i32.eqz (local.get $lsep))\n" &
   "      (then (return (call $list_push (local.get $r) (local.get $s)))))\n" &
   "    (local.set $start (i32.const 0))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $sd (loop $sc\n" &
   "      (br_if $sd (i32.gt_s (i32.add (local.get $i) (local.get $lsep)) (local.get $ls)))\n" &
   "      (if (call $cx_text_match_at (local.get $s) (local.get $sep) (local.get $i))\n" &
   "        (then\n" &
   "          (local.set $r (call $list_push (local.get $r)\n" &
   "            (call $substring (local.get $s) (i64.extend_i32_u (local.get $start))\n" &
   "              (i64.extend_i32_u (i32.sub (local.get $i) (local.get $start))))))\n" &
   "          (local.set $i (i32.add (local.get $i) (local.get $lsep)))\n" &
   "          (local.set $start (local.get $i)))\n" &
   "        (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n" &
   "      (br $sc)))\n" &
   "    (call $list_push (local.get $r)\n" &
   "      (call $substring (local.get $s) (i64.extend_i32_u (local.get $start))\n" &
   "        (i64.extend_i32_u (i32.sub (local.get $ls) (local.get $start))))))\n\n"

 `min` and `__memset` take a helper each rather than being inlined, because
 an inline form would have to name each argument twice and the second
 mention would evaluate it a second time. A helper binds its parameters
 once, which is what the x86 arms achieve by storing to locals.

 A function VALUE is a table index while nothing is captured, which is what
 it has always been, and becomes a heap block the moment an application
 leaves it short. Bit 62 tells the two apart: a table index never sets it and
 a heap pointer is under 2^32, so the tag costs nothing and cannot collide.
 The block is `[i32 index][i32 captured count][i64 args...]`; the arity comes
 from the sidecar table rather than the block, so a bare index answers the
 same question a closure does.

  wat-rt-closure : Integer, Integer -> Text
  wat-rt-closure (arity-base) (max-arity) =
   "  (func $fn_arity (param $idx i32) (result i32)\n" &
   "    (i32.load8_u (i32.add (i32.const " & integer-to-text arity-base & ") (local.get $idx))))\n\n" &
   wat-emit-invokers max-arity 1 "" &
   "  (func $clo_invoke (param $clo i32) (param $idx i32) (param $ar i32) (result i64)\n" &
   wat-emit-invoke-dispatch max-arity 1 "" &
   "    (unreachable))\n\n" &
   "  (func $clo_apply1 (param $f i64) (param $a i64) (result i64)\n" &
   "    (local $ptr i32) (local $idx i32) (local $cnt i32) (local $ar i32)\n" &
   "    (local $new i32) (local $i i32)\n" &
   "    (if (i64.ne (i64.and (local.get $f) (i64.const 4611686018427387904)) (i64.const 0))\n" &
   "      (then\n" &
   "        (local.set $ptr (i32.wrap_i64 (i64.and (local.get $f) (i64.const 4611686018427387903))))\n" &
   "        (local.set $idx (i32.load (local.get $ptr)))\n" &
   "        (local.set $cnt (i32.load (i32.add (local.get $ptr) (i32.const 4)))))\n" &
   "      (else\n" &
   "        (local.set $ptr (i32.const 0))\n" &
   "        (local.set $idx (i32.wrap_i64 (local.get $f)))\n" &
   "        (local.set $cnt (i32.const 0))))\n" &
   "    (local.set $ar (call $fn_arity (local.get $idx)))\n" &
   "    (if (i32.and (i32.eqz (local.get $cnt)) (i32.eq (local.get $ar) (i32.const 1)))\n" &
   "      (then (return (call_indirect (type $fn1) (local.get $a) (local.get $idx)))))\n" &
   "    (local.set $new (call $bump_alloc\n" &
   "      (i32.add (i32.const 8) (i32.mul (i32.add (local.get $cnt) (i32.const 1)) (i32.const 8)))))\n" &
   "    (i32.store (local.get $new) (local.get $idx))\n" &
   "    (i32.store (i32.add (local.get $new) (i32.const 4)) (i32.add (local.get $cnt) (i32.const 1)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $cpd (loop $cpc\n" &
   "      (br_if $cpd (i32.ge_u (local.get $i) (local.get $cnt)))\n" &
   "      (i64.store (i32.add (i32.add (local.get $new) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))\n" &
   "        (i64.load (i32.add (i32.add (local.get $ptr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $cpc)))\n" &
   "    (i64.store (i32.add (i32.add (local.get $new) (i32.const 8)) (i32.mul (local.get $cnt) (i32.const 8)))\n" &
   "      (local.get $a))\n" &
   "    (if (i32.eq (i32.add (local.get $cnt) (i32.const 1)) (local.get $ar))\n" &
   "      (then (return (call $clo_invoke (local.get $new) (local.get $idx) (local.get $ar)))))\n" &
   "    (i64.or (i64.extend_i32_u (local.get $new)) (i64.const 4611686018427387904)))\n\n" &
   wat-emit-apply-fams max-arity 2 ""

 A bare table index applied to exactly its arity is the dominant dynamic
 shape: a comparator handed to a sort, a mapper handed to a walk. The
 one-argument chain spends a closure allocation per argument on it -- 16
 then 24 bytes for every two-argument comparator call, measured at thirty
 million allocations in one compile -- where x86's trampoline passes the
 saturating arguments in registers and allocates only on genuine
 under-application. Each family member takes the whole argument row, calls
 straight through the table when the callee is bare and the row saturates
 it, and otherwise falls back to the chain, which stays the single place
 closures are built.

  wat-emit-apply-fams : Integer, Integer, Text -> Text
  wat-emit-apply-fams (n) (i) (acc) =
   if i > n then acc
   else wat-emit-apply-fams n (i + 1) (acc &
    "  (func $clo_apply" & integer-to-text i & " (param $f i64)" & wat-apply-fam-params i 0 "" & " (result i64)\n" &
    "    (local $r i64)\n" &
    "    (if (i64.eqz (i64.and (local.get $f) (i64.const 4611686018427387904)))\n" &
    "      (then (if (i32.eq (call $fn_arity (i32.wrap_i64 (local.get $f))) (i32.const " & integer-to-text i & "))\n" &
    "        (then (return (call_indirect (type $fn" & integer-to-text i & ")" & wat-apply-fam-args i 0 "" & " (i32.wrap_i64 (local.get $f))))))))\n" &
    "    (local.set $r (call $clo_apply1 (local.get $f) (local.get $p0)))\n" &
    wat-apply-fam-chain i 1 "" &
    "    (local.get $r))\n\n")

  wat-apply-fam-params : Integer, Integer, Text -> Text
  wat-apply-fam-params (n) (i) (acc) =
   if i >= n then acc
   else wat-apply-fam-params n (i + 1) (acc & " (param $p" & integer-to-text i & " i64)")

  wat-apply-fam-args : Integer, Integer, Text -> Text
  wat-apply-fam-args (n) (i) (acc) =
   if i >= n then acc
   else wat-apply-fam-args n (i + 1) (acc & " (local.get $p" & integer-to-text i & ")")

  wat-apply-fam-chain : Integer, Integer, Text -> Text
  wat-apply-fam-chain (n) (i) (acc) =
   if i >= n then acc
   else wat-apply-fam-chain n (i + 1) (acc & "    (local.set $r (call $clo_apply1 (local.get $r) (local.get $p" & integer-to-text i & ")))\n")

  wat-emit-invokers : Integer, Integer, Text -> Text
  wat-emit-invokers (n) (i) (acc) =
   if i > n then acc
   else wat-emit-invokers n (i + 1) (acc &
    "  (func $invoke" & integer-to-text i & " (param $clo i32) (param $idx i32) (result i64)\n" &
    "    (call_indirect (type $fn" & integer-to-text i & ")" & wat-emit-invoke-args i 0 "" &
    " (local.get $idx)))\n\n")

  wat-emit-invoke-args : Integer, Integer, Text -> Text
  wat-emit-invoke-args (n) (i) (acc) =
   if i >= n then acc
   else wat-emit-invoke-args n (i + 1) (acc &
    " (i64.load (i32.add (local.get $clo) (i32.const " & integer-to-text (8 + i * 8) & ")))")

  wat-emit-invoke-dispatch : Integer, Integer, Text -> Text
  wat-emit-invoke-dispatch (n) (i) (acc) =
   if i > n then acc
   else wat-emit-invoke-dispatch n (i + 1) (acc &
    "    (if (i32.eq (local.get $ar) (i32.const " & integer-to-text i & "))\n" &
    "      (then (return (call $invoke" & integer-to-text i & " (local.get $clo) (local.get $idx)))))\n")

  wat-emit-arity-data : List ArityEntry, Integer, Integer, List Text -> Text
  wat-emit-arity-data (entries) (base) (i) (acc) =
   if i >= list-length entries then
    "  (data (i32.const " & integer-to-text base & ") \"" & text-concat-list acc & "\")\n"
   else let row = byte-to-hex ((list-at entries i).arity)
   in wat-emit-arity-data entries base (i + 1) (list-push acc row)

 One byte per `fd_read`, which is the shape the caller needs rather than the
 fast one: a line ends at a newline and reading ahead would swallow the
 bytes after it, with nowhere to put them back. `$read_line_raw` answers 0
 at end of input and a Text pointer otherwise, and an empty line is a Text
 of length 0, which is NOT the same answer. Bytes convert through the
 reverse table on the way in, so what lands in memory is CCE, matching what
 1.61 established for the way out.

 END OF INPUT DISCARDS A PARTIAL LINE, and that is bare metal's answer
 rather than a choice made here: measured against x86-64 on input whose last
 line carries no newline, the reference reports the three terminated lines
 and then end of input, dropping the tail. Returning the tail first is the
 more obliging reading and it disagrees with the oracle, which is the only
 standard this plug is held to.

  wat-rt-read-line : Integer, Integer -> Text
  wat-rt-read-line (rev-base) (scratch) =
   "  (func $read_byte (result i32) (local $b i32)\n" &
   "    (if (i32.ge_u (global.get $rd_pos) (global.get $rd_len)) (then\n" &
   "      (i32.store (i32.const 0) (i32.const " & integer-to-text scratch & "))\n" &
   "      (i32.store (i32.const 4) (i32.const " & integer-to-text cce-in-buf-bytes & "))\n" &
   "      (i32.store (i32.const 8) (i32.const 0))\n" &
   "      (if (i32.ne (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) (i32.const 0))\n" &
   "        (then (return (i32.const -1))))\n" &
   "      (global.set $rd_len (i32.load (i32.const 8)))\n" &
   "      (global.set $rd_pos (i32.const 0))\n" &
   "      (if (i32.eqz (global.get $rd_len)) (then (return (i32.const -1))))))\n" &
   "    (local.set $b (i32.load8_u (i32.add (i32.const " & integer-to-text scratch & ") (global.get $rd_pos))))\n" &
   "    (global.set $rd_pos (i32.add (global.get $rd_pos) (i32.const 1)))\n" &
   "    (local.get $b))\n\n" &
   "  (func $read_line_raw (result i64)\n" &
   "    (local $buf i32) (local $n i32) (local $b i32) (local $cap i32) (local $cc i32)\n" &
   "    (local.set $cap (i32.const 256))\n" &
   "    (local.set $buf (call $bump_alloc (i32.add (local.get $cap) (i32.const 4))))\n" &
   "    (local.set $n (i32.const 0))\n" &
   "    (block $rld (loop $rlc\n" &
   "      (local.set $b (call $read_byte))\n" &
   "      (br_if $rld (i32.lt_s (local.get $b) (i32.const 0)))\n" &
   "      (br_if $rld (i32.eq (local.get $b) (i32.const 10)))\n" &
   "      (if (i32.ne (local.get $b) (i32.const 13)) (then\n" &
   "        (local.set $cc (if (result i32) (i32.lt_u (local.get $b) (i32.const " & integer-to-text cce-rev-entries & "))\n" &
   "          (then (i32.load8_u (i32.add (i32.const " & integer-to-text rev-base & ") (local.get $b))))\n" &
   "          (else (i32.const 0))))\n" &
   "        (if (i32.ge_u (local.get $n) (local.get $cap)) (then\n" &
   "          (drop (call $bump_alloc (local.get $cap)))\n" &
   "          (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))))\n" &
   "        (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n)) (local.get $cc))\n" &
   "        (local.set $n (i32.add (local.get $n) (i32.const 1)))))\n" &
   "      (br $rlc)))\n" &
   "    (if (i32.lt_s (local.get $b) (i32.const 0)) (then (return (i64.const 0))))\n" &
   "    (i32.store (local.get $buf) (local.get $n))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n\n"

 `read-line-cce` and `read-serial-cce` are the RAW half of the family and
 they are not `read-line` with a different name. Measured against x86-64:
 `__read_line` converts each byte through the unicode-to-CCE table and ends
 the line on ASCII 10; `__read_line_cce` converts NOTHING and ends the line
 on CCE 1 (`X86_64Helpers.codex:1212`), because its caller is a wire that
 already speaks CCE. `__bare_metal_read_serial_cce` copies raw bytes until a
 NUL and is how every plug takes its whole input. Wiring the raw two to the
 converting one is wrong in both halves at once, and it is observable on the
 plainest input there is: on `hi` and a newline, bare metal's
 `read-line-cce` answers None, because it is still looking for a CCE 1 that
 ASCII text never contains.

 The scope pair beneath the disk: `fat16-scope-admits` consults
 `process-get-scope process-get-pid` on EVERY path resolution, so a
 target with no process table cannot read a volume at all. Here the
 module IS one process and the embedding page is the trust boundary, so
 the pid is 0 and the scope is the empty grant, which the scope code
 itself defines as "admits everything". Writes land in the SAME
 host-provided region -- the image is the host's own buffer handed in
 through `disk_reserve`, so a write mutates host-owned bytes and
 nothing beyond them; DISK mode's write-the-CDX-back tail (OUT.CDX and
 the re-read verdict) therefore completes in-tab exactly as it does on
 a stick. The status convention is x86's, not a boolean: 0 IS SUCCESS
 (`fat16-put-entry-and-write` tests `s == 0`), and an out-of-range
 write answers 1 and moves nothing. The first build of this function
 returned it inverted, and the symptom was exact: every byte of
 OUT.CDX on the image, the directory size right, and the verdict
 `DISK-OUT: FAILED 89323 of 89323` -- a landed write reported as a
 failure by its own status word.

 The virtual disk's HOST CONTRACT, for any embedder (the Prism page, a
 node bed): call the exported `disk_reserve(size)` BEFORE `_start`, copy
 the image bytes to the returned address, and re-fetch `memory.buffer`
 after the call, because the reserve may grow the memory and growing
 detaches the old buffer. Nothing else is required; a host that reserves
 nothing leaves `disk_size` 0, `block-sector-count` answers 0, and no
 volume mounts. The reserve goes through `$bump_alloc` so the region can
 never collide with the heap, and it is permanent for the instance, which
 is the x86 allocator's own contract. A sector read past `disk_size`
 answers a zeroed buffer rather than trapping, and 512 fresh bytes are
 bump-allocated per read exactly as the x86 `block-read-sector` does.
 The read-back half of the contract is the same region: writes land in
 it, so after `_start` the host slices `memory.buffer` at the reserved
 base to read anything the guest wrote (DISK mode's OUT.CDX included).
 Copy-in and read-back are one buffer; a host that forgets the second
 half ships a DISK mode that reports success while its artifact stays
 unread (fester's question at the stage-2 convergence, 2026-08-28).

  wat-rt-disk : Text =
   "  (func $process_scope_empty (param $pid i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (call $bump_alloc (i32.const 4)))\n" &
   "    (i32.store (local.get $p) (i32.const 0))\n" &
   "    (i64.extend_i32_u (local.get $p)))\n" &
   "  (func $disk_reserve (export \"disk_reserve\") (param $size i32) (result i32)\n" &
   "    (global.set $disk_base (call $bump_alloc (local.get $size)))\n" &
   "    (global.set $disk_size (local.get $size))\n" &
   "    (global.get $disk_base))\n" &
   "  (func $block_read_sector (param $lba i64) (result i64)\n" &
   "    (local $buf i32) (local $src i32) (local $i i32)\n" &
   "    (local.set $buf (call $bump_alloc (i32.const 512)))\n" &
   "    (block $oob\n" &
   "      (br_if $oob (i64.gt_u (i64.add (i64.mul (local.get $lba) (i64.const 512)) (i64.const 512)) (i64.extend_i32_u (global.get $disk_size))))\n" &
   "      (local.set $src (i32.add (global.get $disk_base) (i32.wrap_i64 (i64.mul (local.get $lba) (i64.const 512)))))\n" &
   "      (loop $cp\n" &
   "        (i64.store (i32.add (local.get $buf) (local.get $i)) (i64.load (i32.add (local.get $src) (local.get $i))))\n" &
   "        (local.set $i (i32.add (local.get $i) (i32.const 8)))\n" &
   "        (br_if $cp (i32.lt_u (local.get $i) (i32.const 512))))\n" &
   "      (return (i64.extend_i32_u (local.get $buf))))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (loop $zf\n" &
   "      (i64.store (i32.add (local.get $buf) (local.get $i)) (i64.const 0))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 8)))\n" &
   "      (br_if $zf (i32.lt_u (local.get $i) (i32.const 512))))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n" &
   "  (func $block_write_sector (param $lba i64) (param $buf i64) (result i64)\n" &
   "    (local $dst i32) (local $i i32)\n" &
   "    (block $oob\n" &
   "      (br_if $oob (i64.gt_u (i64.add (i64.mul (local.get $lba) (i64.const 512)) (i64.const 512)) (i64.extend_i32_u (global.get $disk_size))))\n" &
   "      (local.set $dst (i32.add (global.get $disk_base) (i32.wrap_i64 (i64.mul (local.get $lba) (i64.const 512)))))\n" &
   "      (loop $cp\n" &
   "        (i64.store (i32.add (local.get $dst) (local.get $i)) (i64.load (i32.add (i32.wrap_i64 (local.get $buf)) (local.get $i))))\n" &
   "        (local.set $i (i32.add (local.get $i) (i32.const 8)))\n" &
   "        (br_if $cp (i32.lt_u (local.get $i) (i32.const 512))))\n" &
   "      (return (i64.const 0)))\n" &
   "    (i64.const 1))\n\n"

 The 4096 below is a divergence x86 does not have: its `__read_line_cce`
 stores into the heap frontier byte by byte and sizes the allocation after
 the terminator, so a line there is as long as the line is. This runtime
 bump-allocates BEFORE reading, so a bound is structural, and bytes past it
 are dropped without a word. 256 truncated the evidence wire's `cdx-header`
 line (11 + 448 hex chars for 224 header bytes) to 122 parsed bytes, and the
 plug honestly answered "not a CDX" to a CDX (measured 2026-08-28; the x86
 reference answers present=y on the identical wire). 4096 clears every line
 the known raw-CCE wires carry by an order of magnitude. (Landed 20600 on
 red; restored here after a merge-down took main's pre-fix copy over it.)

  wat-rt-read-raw : Integer -> Text
  wat-rt-read-raw (cce-nl) =
   "  (func $read_line_cce_raw (result i64)\n" &
   "    (local $buf i32) (local $n i32) (local $b i32) (local $cap i32)\n" &
   "    (local.set $cap (i32.const 4096))\n" &
   "    (local.set $buf (call $bump_alloc (i32.add (local.get $cap) (i32.const 4))))\n" &
   "    (local.set $n (i32.const 0))\n" &
   "    (block $rcd (loop $rcc\n" &
   "      (local.set $b (call $read_byte))\n" &
   "      (br_if $rcd (i32.lt_s (local.get $b) (i32.const 0)))\n" &
   "      (br_if $rcd (i32.eqz (local.get $b)))\n" &
   "      (br_if $rcd (i32.eq (local.get $b) (i32.const " & integer-to-text cce-nl & ")))\n" &
   "      (if (i32.lt_s (local.get $n) (local.get $cap)) (then\n" &
   "        (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n)) (local.get $b))\n" &
   "        (local.set $n (i32.add (local.get $n) (i32.const 1)))))\n" &
   "      (br $rcc)))\n" &
   "    (if (i32.lt_s (local.get $b) (i32.const 0)) (then (return (i64.const 0))))\n" &
   "    (i32.store (local.get $buf) (local.get $n))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n\n" &
   "  (func $read_serial_cce (param $ignored i64) (result i64)\n" &
   "    (local $buf i32) (local $n i32) (local $b i32) (local $cap i32)\n" &
   "    (local.set $cap (i32.const 1048576))\n" &
   "    (local.set $buf (call $bump_alloc (i32.add (local.get $cap) (i32.const 4))))\n" &
   "    (local.set $n (i32.const 0))\n" &
   "    (block $rsd (loop $rsc\n" &
   "      (local.set $b (call $read_byte))\n" &
   "      (br_if $rsd (i32.lt_s (local.get $b) (i32.const 0)))\n" &
   "      (br_if $rsd (i32.eqz (local.get $b)))\n" &
   "      (if (i32.ge_u (local.get $n) (local.get $cap)) (then\n" &
   "        (drop (call $bump_alloc (local.get $cap)))\n" &
   "        (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))))\n" &
   "      (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n)) (local.get $b))\n" &
   "      (local.set $n (i32.add (local.get $n) (i32.const 1)))\n" &
   "      (br $rsc)))\n" &
   "    (i32.store (local.get $buf) (local.get $n))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n\n"

 `read-file-uni` READS THE WIRE. The name says file and the effect row says
 `FileSystem.Read`, but on x86-64 it compiles to
 `__bare_metal_read_serial` (`X86_64Builtins.codex:768`), which slurps the
 serial stream: terminate on NUL or EOT, skip CR, convert bytes under 128
 through the unicode-to-CCE table and pass the rest through. That is why
 `compile.ps1` writes the mode line and the whole source body into ONE
 input file, and why `dispatch-on-mode`'s `utf8-to-cce` afterwards is a
 no-op on ASCII: the conversion already happened here.

  wat-rt-read-file : Integer -> Text
  wat-rt-read-file (rev-base) =
   "  (func $read_file_uni (param $ignored i64) (result i64)\n" &
   "    (local $buf i32) (local $n i32) (local $b i32) (local $cap i32) (local $cc i32)\n" &
   "    (local.set $cap (i32.const 1048576))\n" &
   "    (local.set $buf (call $bump_alloc (i32.add (local.get $cap) (i32.const 4))))\n" &
   "    (local.set $n (i32.const 0))\n" &
   "    (block $rfd (loop $rfc\n" &
   "      (local.set $b (call $read_byte))\n" &
   "      (br_if $rfd (i32.lt_s (local.get $b) (i32.const 0)))\n" &
   "      (br_if $rfd (i32.eqz (local.get $b)))\n" &
   "      (br_if $rfd (i32.eq (local.get $b) (i32.const 4)))\n" &
   "      (if (i32.ne (local.get $b) (i32.const 13)) (then\n" &
   "        (local.set $cc (if (result i32) (i32.lt_u (local.get $b) (i32.const " & integer-to-text cce-rev-entries & "))\n" &
   "          (then (i32.load8_u (i32.add (i32.const " & integer-to-text rev-base & ") (local.get $b))))\n" &
   "          (else (local.get $b))))\n" &
   "        (if (i32.ge_u (local.get $n) (local.get $cap)) (then\n" &
   "          (drop (call $bump_alloc (local.get $cap)))\n" &
   "          (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))))\n" &
   "        (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n)) (local.get $cc))\n" &
   "        (local.set $n (i32.add (local.get $n) (i32.const 1)))))\n" &
   "      (br $rfc)))\n" &
   "    (i32.store (local.get $buf) (local.get $n))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n\n"

 `read-file-raw` MEANS SOMETHING WIDER HERE THAN ON BARE METAL, deliberately
 (Damian, 2026-08-27: a builtin means whatever it needs to mean to make sense
 for its environment). x86-64's `__bare_metal_read_serial_raw` ends the read
 at a NUL or an EOT and skips CR, because a serial ring has no end of input
 and a sentinel is the only terminator available to it. wasm's stdin has a
 real one, so this arm ends at EOF and at nothing else: every byte value
 including NUL arrives, which is the whole point, because `elf`, `pe` and
 `img` take a compiled payload rather than text. A subject that reads
 NUL-free input agrees with the reference on both arms; past the first NUL
 the two targets answer different questions and only this one can carry a
 binary.

 Chunked, unlike `$read_line_raw` beside it. That one reads a byte per
 `fd_read` because a line ends at a newline and reading ahead would swallow
 what follows with nowhere to put it back; a slurp to EOF has no such
 boundary, so it reads 64 KB straight into the destination and a 2 MB payload
 costs about 32 calls instead of two million. The buffer grows by bumping
 again: consecutive `$bump_alloc` calls with nothing allocated between them
 are contiguous, so the reservation simply extends. Nothing allocates inside
 any of these read loops, which is what makes that sound here and unsound in
 `$list_push`, where the same trick grew a list a CALLER still held.

  wat-rt-read-file-raw : Integer -> Text
  wat-rt-read-file-raw (in-base) =
   "  (func $read_file_raw (param $ignored i64) (result i64)\n" &
   "    (local $buf i32) (local $n i32) (local $cap i32) (local $got i32)\n" &
   "    (local.set $cap (i32.const 1048576))\n" &
   "    (local.set $buf (call $bump_alloc (i32.add (local.get $cap) (i32.const 4))))\n" &
   "    (local.set $n (i32.const 0))\n" &
   "    (local.set $got (i32.sub (global.get $rd_len) (global.get $rd_pos)))\n" &
   "    (block $rpd (loop $rpc\n" &
   "      (br_if $rpd (i32.eqz (local.get $got)))\n" &
   "      (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n))\n" &
   "        (i32.load8_u (i32.add (i32.const " & integer-to-text in-base & ") (global.get $rd_pos))))\n" &
   "      (global.set $rd_pos (i32.add (global.get $rd_pos) (i32.const 1)))\n" &
   "      (local.set $n (i32.add (local.get $n) (i32.const 1)))\n" &
   "      (local.set $got (i32.sub (local.get $got) (i32.const 1)))\n" &
   "      (br $rpc)))\n" &
   "    (block $rrd (loop $rrc\n" &
   "      (if (i32.lt_u (i32.sub (local.get $cap) (local.get $n)) (i32.const 65536)) (then\n" &
   "        (drop (call $bump_alloc (local.get $cap)))\n" &
   "        (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))))\n" &
   "      (i32.store (i32.const 0) (i32.add (i32.add (local.get $buf) (i32.const 4)) (local.get $n)))\n" &
   "      (i32.store (i32.const 4) (i32.const 65536))\n" &
   "      (br_if $rrd (i32.ne (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 16)) (i32.const 0)))\n" &
   "      (local.set $got (i32.load (i32.const 16)))\n" &
   "      (br_if $rrd (i32.eqz (local.get $got)))\n" &
   "      (local.set $n (i32.add (local.get $n) (local.get $got)))\n" &
   "      (br $rrc)))\n" &
   "    (i32.store (local.get $buf) (local.get $n))\n" &
   "    (i64.extend_i32_u (local.get $buf)))\n\n"

  wat-rt-raw-bytes-to-text : Text =
   "  (func $raw_bytes_to_text (param $lst i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $dst i32) (local $i i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $p (call $cx_list_base (local.get $lst)))\n" &
   "    (local.set $dst (call $bump_alloc (i32.add (local.get $n) (i32.const 4))))\n" &
   "    (i32.store (local.get $dst) (local.get $n))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $rbd (loop $rbc\n" &
   "      (br_if $rbd (i32.ge_s (local.get $i) (local.get $n)))\n" &
   "      (i32.store8 (i32.add (i32.add (local.get $dst) (i32.const 4)) (local.get $i))\n" &
   "        (i32.wrap_i64 (i64.load (i32.add (i32.add (local.get $p) (i32.const 8))\n" &
   "          (i32.mul (local.get $i) (i32.const 8))))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $rbc)))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n"

  wat-rt-text-to-double : Text =
   "  (func $text_to_double (param $s i64) (result i64)\n" &
   "    (local $p i32) (local $len i32) (local $i i32) (local $ch i32)\n" &
   "    (local $neg i32) (local $frac i32) (local $seen i32)\n" &
   "    (local $acc i64) (local $v f64) (local $pow f64)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $s)))\n" &
   "    (local.set $len (i32.load (local.get $p)))\n" &
   "    (if (i32.eqz (local.get $len)) (then (return (i64.const 0))))\n" &
   "    (local.set $p (i32.add (local.get $p) (i32.const 4)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (local.set $acc (i64.const 0))\n" &
   "    (local.set $neg (i32.const 0))\n" &
   "    (local.set $frac (i32.const 0))\n" &
   "    (local.set $seen (i32.const 0))\n" &
   "    (if (i32.eq (i32.load8_u (local.get $p)) (i32.const " & integer-to-text cce-minus & "))\n" &
   "      (then (local.set $neg (i32.const 1)) (local.set $i (i32.const 1))))\n" &
   "    (block $ttd (loop $ttc\n" &
   "      (br_if $ttd (i32.ge_s (local.get $i) (local.get $len)))\n" &
   "      (local.set $ch (i32.load8_u (i32.add (local.get $p) (local.get $i))))\n" &
   "      (if (i32.eq (local.get $ch) (i32.const " & integer-to-text cce-dot & "))\n" &
   "        (then (local.set $seen (i32.const 1)))\n" &
   "        (else\n" &
   "          (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 10))\n" &
   "            (i64.extend_i32_s (i32.sub (local.get $ch) (i32.const " & integer-to-text cce-digit-zero & ")))))\n" &
   "          (local.set $frac (i32.add (local.get $frac) (local.get $seen)))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $ttc)))\n" &
   "    (if (local.get $neg) (then (local.set $acc (i64.sub (i64.const 0) (local.get $acc)))))\n" &
   "    (local.set $v (f64.convert_i64_s (local.get $acc)))\n" &
   "    (if (local.get $frac) (then\n" &
   "      (local.set $pow (f64.const 1))\n" &
   "      (block $pwd (loop $pwc\n" &
   "        (br_if $pwd (i32.eqz (local.get $frac)))\n" &
   "        (local.set $pow (f64.mul (local.get $pow) (f64.const 10)))\n" &
   "        (local.set $frac (i32.sub (local.get $frac) (i32.const 1)))\n" &
   "        (br $pwc)))\n" &
   "      (local.set $v (f64.div (local.get $v) (local.get $pow)))))\n" &
   "    (i64.reinterpret_f64 (local.get $v)))\n\n"

  wat-rt-extra : Text =
   "  (func $__approx_eq (param $a i64) (param $b i64) (param $tol i64) (result i64)\n" &
   "    (local $m i64) (local $x i64) (local $y i64) (local $d i64)\n" &
   "    (local.set $x (local.get $a))\n" &
   "    (local.set $m (i64.shr_s (local.get $x) (i64.const 63)))\n" &
   "    (local.set $x (i64.sub (i64.xor (local.get $x) (i64.shr_u (local.get $m) (i64.const 1))) (local.get $m)))\n" &
   "    (local.set $y (local.get $b))\n" &
   "    (local.set $m (i64.shr_s (local.get $y) (i64.const 63)))\n" &
   "    (local.set $y (i64.sub (i64.xor (local.get $y) (i64.shr_u (local.get $m) (i64.const 1))) (local.get $m)))\n" &
   "    (local.set $d (i64.sub (local.get $x) (local.get $y)))\n" &
   "    (local.set $m (i64.shr_s (local.get $d) (i64.const 63)))\n" &
   "    (local.set $d (i64.sub (i64.xor (local.get $d) (local.get $m)) (local.get $m)))\n" &
   "    (i64.extend_i32_u (i64.le_u (local.get $d) (local.get $tol))))\n\n" &
   "  (func $__approx_eq32 (param $a i64) (param $b i64) (param $tol i32) (result i64)\n" &
   "    (local $m i32) (local $x i32) (local $y i32) (local $d i32)\n" &
   "    (local.set $x (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $a)))))\n" &
   "    (local.set $m (i32.shr_s (local.get $x) (i32.const 31)))\n" &
   "    (local.set $x (i32.sub (i32.xor (local.get $x) (i32.shr_u (local.get $m) (i32.const 1))) (local.get $m)))\n" &
   "    (local.set $y (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $b)))))\n" &
   "    (local.set $m (i32.shr_s (local.get $y) (i32.const 31)))\n" &
   "    (local.set $y (i32.sub (i32.xor (local.get $y) (i32.shr_u (local.get $m) (i32.const 1))) (local.get $m)))\n" &
   "    (local.set $d (i32.sub (local.get $x) (local.get $y)))\n" &
   "    (local.set $m (i32.shr_s (local.get $d) (i32.const 31)))\n" &
   "    (local.set $d (i32.sub (i32.xor (local.get $d) (local.get $m)) (local.get $m)))\n" &
   "    (i64.extend_i32_u (i32.le_u (local.get $d) (local.get $tol))))\n\n" &
   "  (func $cx_min (param $a i64) (param $b i64) (result i64)\n" &
   "    (select (local.get $a) (local.get $b) (i64.lt_s (local.get $a) (local.get $b))))\n\n" &
   "  (func $cx_memset (param $p i64) (param $v i64) (param $n i64)\n" &
   "    (local $i i32) (local $base i32) (local $len i32)\n" &
   "    (local.set $base (i32.wrap_i64 (local.get $p)))\n" &
   "    (local.set $len (i32.wrap_i64 (local.get $n)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $msd (loop $msc\n" &
   "      (br_if $msd (i32.ge_s (local.get $i) (local.get $len)))\n" &
   "      (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.wrap_i64 (local.get $v)))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $msc))))\n\n"

  wat-runtime-funcs : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  wat-runtime-funcs (tab) (t2) (out) (arity-base) (max-arity) (rev-base) (in-base) =
   wat-rt-read-line rev-base in-base & wat-rt-read-raw cce-newline & wat-rt-disk & wat-rt-read-file rev-base & wat-rt-read-file-raw in-base &
   wat-rt-bump-alloc & wat-rt-print-i64 & wat-rt-print-misc tab t2 out & wat-rt-text-append & wat-rt-i64-to-text & wat-rt-f64-to-text & wat-rt-list-ops & wat-rt-bool-text & wat-rt-vec & wat-rt-real-modes & wat-rt-list-tail & wat-rt-char-class & wat-rt-char-text & wat-rt-list-mutate & wat-rt-linked-list & wat-rt-list-insert & wat-rt-buf & wat-rt-write-binary & wat-rt-text-search & wat-rt-text-to-double & wat-rt-raw-bytes-to-text & wat-rt-closure arity-base max-arity & wat-rt-extra

Section: Chapter Emission

 Emission STREAMS, and the reason is a measured ceiling rather than taste.
 The heap is a bump allocator with no GC, so every allocation a definition
 makes while being emitted stays live until the function that made it
 returns. Building the whole module as one `Text` therefore holds the
 working set of EVERY definition at once, and the cost is not the output:
 measured 2026-08-24, 2.06 MB of IR produced about 2 MB of WAT and consumed
 over 3.1 GB of heap before dying OUT OF MEMORY, roughly 1,500 bytes of heap
 per byte of IR. The knee sat between 1.29 MB and 1.55 MB of IR, which is
 why the compiler's own 16.3 MB has never fitted.

 `emit-streaming-ir-defs` in the compiler's `opening.codex` is the same
 shape and the pattern is taken from it: mark the heap, emit ONE definition,
 print it, restore the mark. Only a scalar may cross the restore.

  wat-apply-head-is : IRExpr, Text -> Boolean
  wat-apply-head-is (e) (n) =
   when e
    is IrName (nm) (ty) (sp) -> nm == n
    is IrApply (f) (a) (ty) (sp) -> wat-apply-head-is f n
    is otherwise -> False

  wat-expr-calls-name : IRExpr, Text -> Boolean
  wat-expr-calls-name (e) (n) =
   when e
    is IrIntLit (v) (sp) -> False
    is IrNumLit (v) (sp) -> False
    is IrTextLit (s) (sp) -> False
    is IrBoolLit (bv) (sp) -> False
    is IrCharLit (cv) (sp) -> False
    is IrName (nm) (ty) (sp) -> False
    is IrBinary (op) (l) (r) (ty) (sp) -> wat-expr-calls-name l n | wat-expr-calls-name r n
    is IrNegate (operand) (nty) (sp) -> wat-expr-calls-name operand n
    is IrIf (c) (t) (el) (ty) (sp) -> wat-expr-calls-name c n | wat-expr-calls-name t n | wat-expr-calls-name el n
    is IrLet (name) (ty) (val) (body) (sp) -> wat-expr-calls-name val n | wat-expr-calls-name body n
    is IrApply (f) (a) (ty) (sp) -> wat-apply-head-is f n | wat-expr-calls-name f n | wat-expr-calls-name a n
    is IrLambda (params) (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrList (elems) (ty) (sp) -> wat-list-calls-name elems n 0
    is IrMatch (scrut) (branches) (ty) (sp) -> wat-expr-calls-name scrut n | wat-branches-call-name branches n 0
    is IrAct (stmts) (ty) (sp) -> wat-stmts-call-name stmts n 0
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> wat-expr-calls-name body n
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrRecord (name) (fields) (ty) (sp) -> wat-fields-call-name fields n 0
    is IrFieldAccess (rec) (field) (ty) (sp) -> wat-expr-calls-name rec n
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> wat-expr-calls-name rec n | wat-expr-calls-name val n
    is IrFork (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrAwait (task) (ty) (sp) -> wat-expr-calls-name task n
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> wat-stmts-call-name body n 0 | wat-stmts-call-name fb n 0 | wat-stmts-call-name fail-stmts n 0
    is IrError (msg) (ty) (sp) -> False

  wat-list-calls-name : List IRExpr, Text, Integer -> Boolean
  wat-list-calls-name (xs) (n) (i) =
   if i >= list-length xs then False
   else if wat-expr-calls-name (list-at xs i) n then True
   else wat-list-calls-name xs n (i + 1)

  wat-branches-call-name : List IRBranch, Text, Integer -> Boolean
  wat-branches-call-name (bs) (n) (i) =
   if i >= list-length bs then False
   else if wat-expr-calls-name ((list-at bs i).guard) n then True
   else if wat-expr-calls-name ((list-at bs i).body) n then True
   else wat-branches-call-name bs n (i + 1)

  wat-stmts-call-name : List IRActStmt, Text, Integer -> Boolean
  wat-stmts-call-name (ss) (n) (i) =
   if i >= list-length ss then False
   else let hit = when (list-at ss i)
    is IrDoBind (name) (ty) (val) (sp) -> wat-expr-calls-name val n
    is IrDoExec (e) (sp) -> wat-expr-calls-name e n
   in if hit then True else wat-stmts-call-name ss n (i + 1)

  wat-fields-call-name : List IRFieldVal, Text, Integer -> Boolean
  wat-fields-call-name (fs) (n) (i) =
   if i >= list-length fs then False
   else if wat-expr-calls-name ((list-at fs i).value) n then True
   else wat-fields-call-name fs n (i + 1)

 `$on_key_import` has no producer: no arm of this emitter emits it, so its
 flag is asked with the empty name and answers False without a walk. Whoever
 adds the `on-key` arm must replace `wasm-no-builtin` at the call site with
 the builtin's name, or the module calls an import it never declared.

  wasm-no-builtin : Text = ""

  wat-defs-call-name : List IRDef, Text, Integer -> Boolean
  wat-defs-call-name (defs) (n) (i) =
   if n == wasm-no-builtin then False
   else if i >= list-length defs then False
   else if wat-expr-calls-name ((list-at defs i).body) n then True
   else wat-defs-call-name defs n (i + 1)

  wasm-mention-any : List IRDef, Text, Text, Text, Text, Text -> Boolean
  wasm-mention-any (defs) (runtime) (types-text) (entry) (needle) (builtin) =
   if text-contains runtime needle then True
   else if text-contains types-text needle then True
   else if text-contains entry needle then True
   else wat-defs-call-name defs builtin 0

  wasm-stream-defs : WasmCtx, List IRDef, Integer -> [Console] Nothing
  wasm-stream-defs (ctx) (defs) (i) =
   if i >= list-length defs then print-uni ""
   else let h = __heap-save
   in let text = emit-wat-def ctx (list-at defs i)
   in act
    print-uni text
    print-uni "\n"
    let restored = __heap-restore h
    in wasm-stream-defs ctx defs (i + 1)
   end

 The pieces are printed in the order the single concatenation used to build
 them, and the trailing newline is the one `print-line-uni` used to append
 to the whole module, so the bytes on the wire are unchanged.

  emit-wasm-chapter-stream : IRChapter, List ATypeDef -> [Console] Nothing
  emit-wasm-chapter-stream (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let raw-strings = wat-seed-entry-strings (m.defs) type-defs (collect-strings-defs (m.defs) 0 [])
   in let strings = strtab-assign-offsets raw-strings 0 1024 []
   in let cce-tab-base = strtab-end-offset strings
   in let cce-t2-base = cce-tab-base + cce-tab-bytes
   in let cce-out-base = cce-t2-base + cce-tier2-block-count * cce-t2-entry-bytes
   in let cce-rev-base = cce-out-base + cce-out-buf-bytes
   in let cce-in-base = cce-rev-base + cce-rev-entries
   in let fnarity-base = cce-tab-base + cce-tables-bytes
   in let max-arity = wat-fn-type-ceiling arities
   in let heap-start = fnarity-base + list-length arities
   in let ctx = WasmCtx { arities = arities, strings = strings, type-defs = type-defs, bound = [], scrut-depth = 0 }
   in let runtime = wat-runtime-funcs cce-tab-base cce-t2-base cce-out-base fnarity-base max-arity cce-rev-base cce-in-base
   in let data-text = emit-data-sections strings 0
   in let types-text = emit-wat-type-defs type-defs 0 & wat-eq-funcs type-defs 0
   in let entry = wat-emit-entry ctx (m.defs)
   in let needs-blit = wasm-mention-any (m.defs) runtime types-text entry "$blit_framebuf" "blit-framebuf"
   in let needs-key = wasm-mention-any (m.defs) runtime types-text entry "$on_key_import" wasm-no-builtin
   in let header = wat-runtime-header heap-start needs-blit needs-key
   in act
    print-uni header
    print-uni (wat-emit-table arities)
    print-uni data-text
    print-uni (wat-emit-arity-data arities fnarity-base 0 [])
    wat-stream-cce-tables cce-tab-base cce-t2-base cce-rev-base
    print-uni runtime
    print-uni types-text
    print-uni "\n"
    wasm-stream-defs ctx (m.defs) 0
    print-uni entry
    print-uni ")\n"
    print-uni "\n"
   end

