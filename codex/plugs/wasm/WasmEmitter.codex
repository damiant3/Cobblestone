   "      (i32.store8 (i32.add (local.get $ptr) (i32.const 5)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $v) (i32.const 6)) (i32.const 63))))\n" &
   "      (i32.store8 (i32.add (local.get $ptr) (i32.const 6)) (i32.or (i32.const 128) (i32.and (local.get $v) (i32.const 63))))\n" &
   "      (return (i64.extend_i32_u (local.get $ptr)))))\n" &
   "    (local.set $v (i32.sub (local.get $c) (i32.const 67712)))\n" &
   "    (local.set $ptr (call $bump_alloc (i32.const 8)))\n" &
   "    (i32.store (local.get $ptr) (i32.const 4))\n" &
