   "    (local.set $sp (i32.wrap_i64 (local.get $s)))\n" &
   "    (local.set $st (i32.wrap_i64 (local.get $start)))\n" &
   "    (local.set $ln (i32.wrap_i64 (local.get $len)))\n" &
   "    (local.set $dst (call $bump_alloc (i32.add (local.get $ln) (i32.const 4))))\n" &
   "    (i32.store (local.get $dst) (local.get $ln))\n" &
   "    (local.set $idx (i32.const 0))\n" &
   "    (block $d (loop $c\n" &
   "      (br_if $d (i32.ge_s (local.get $idx) (local.get $ln)))\n" &
   "      (i32.store8 (i32.add (i32.add (local.get $dst) (i32.const 4)) (local.get $idx))\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $sp) (i32.const 4)) (i32.add (local.get $st) (local.get $idx)))))\n" &
   "      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))\n" &
   "      (br $c)))\n" &
