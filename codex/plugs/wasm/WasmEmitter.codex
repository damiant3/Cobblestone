  wat-rt-extra : Text =
   "  (func $__approx_eq (param $a i64) (param $b i64) (param $tol i64) (result i64)\n" &
   "    (local $m i64) (local $x i64) (local $y i64) (local $d i64)\n" &
   "    (local.set $x (local.get $a))\n" &
   "    (local.set $m (i64.shr_s (local.get $x) (i64.const 63)))\n" &
   "    (local.set $x (i64.sub (i64.xor (local.get $x) (i64.shr_u (local.get $m) (i64.const 1))) (local.get $m)))\n" &
   "    (local.set $y (local.get $b))\n" &
   "    (local.set $m (i64.shr_s (local.get $y) (i64.const 63)))\n" &
   "    (local.set $y (i64.sub (i64.xor (local.get $y) (i64.shr_u (local.get $m) (i64.const 1))) (local.get $m)))\n" &
   "    (local.set $d (i64.sub (local.get $x) (local.get $y)))\n" &
   "    (local.set $m (i64.shr_s (local.get $d) (i64.const 63)))\n" &
   "    (local.set $d (i64.sub (i64.xor (local.get $d) (local.get $m)) (local.get $m)))\n" &
   "    (i64.extend_i32_u (i64.le_u (local.get $d) (local.get $tol))))\n\n" &
   "  (func $__approx_eq32 (param $a i64) (param $b i64) (param $tol i32) (result i64)\n" &
   "    (local $m i32) (local $x i32) (local $y i32) (local $d i32)\n" &
   "    (local.set $x (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $a)))))\n" &
   "    (local.set $m (i32.shr_s (local.get $x) (i32.const 31)))\n" &
   "    (local.set $x (i32.sub (i32.xor (local.get $x) (i32.shr_u (local.get $m) (i32.const 1))) (local.get $m)))\n" &
   "    (local.set $y (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $b)))))\n" &
   "    (local.set $m (i32.shr_s (local.get $y) (i32.const 31)))\n" &
   "    (local.set $y (i32.sub (i32.xor (local.get $y) (i32.shr_u (local.get $m) (i32.const 1))) (local.get $m)))\n" &
   "    (local.set $d (i32.sub (local.get $x) (local.get $y)))\n" &
   "    (local.set $m (i32.shr_s (local.get $d) (i32.const 31)))\n" &
   "    (local.set $d (i32.sub (i32.xor (local.get $d) (local.get $m)) (local.get $m)))\n" &
   "    (i64.extend_i32_u (i32.le_u (local.get $d) (local.get $tol))))\n\n" &
   "  (func $cx_min (param $a i64) (param $b i64) (result i64)\n" &
   "    (select (local.get $a) (local.get $b) (i64.lt_s (local.get $a) (local.get $b))))\n\n" &
   "  (func $cx_memset (param $p i64) (param $v i64) (param $n i64)\n" &
   "    (local $i i32) (local $base i32) (local $len i32)\n" &
   "    (local.set $base (i32.wrap_i64 (local.get $p)))\n" &
   "    (local.set $len (i32.wrap_i64 (local.get $n)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $msd (loop $msc\n" &
   "      (br_if $msd (i32.ge_s (local.get $i) (local.get $len)))\n" &
   "      (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.wrap_i64 (local.get $v)))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $msc))))\n\n"

  wat-runtime-funcs : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  wat-runtime-funcs (tab) (t2) (out) (arity-base) (max-arity) (rev-base) (in-base) =
   wat-rt-read-line rev-base in-base & wat-rt-read-raw cce-newline & wat-rt-disk & wat-rt-read-file rev-base & wat-rt-read-file-raw in-base &
   wat-rt-bump-alloc & wat-rt-print-i64 & wat-rt-print-misc tab t2 out & wat-rt-text-append & wat-rt-text-append-inplace & wat-rt-i64-to-text & wat-rt-f64-to-text & wat-rt-f64-big-to-text & wat-rt-list-ops & wat-rt-bool-text & wat-rt-vec & wat-rt-real-modes & wat-rt-list-tail & wat-rt-char-class & wat-rt-char-text & wat-rt-list-mutate & wat-rt-linked-list & wat-rt-list-insert & wat-rt-buf & wat-rt-write-binary & wat-rt-text-search & wat-rt-text-to-double & wat-rt-raw-bytes-to-text & wat-rt-closure arity-base max-arity & wat-rt-extra

Section: Chapter Emission

 Emission STREAMS because the heap has no GC: building the whole module as one
 `Text` held about 1,500 bytes of heap per byte of IR (measured 2026-08-24:
 2.06 MB of IR died OUT OF MEMORY past 3.1 GB). Only a scalar may cross a
 definition's heap restore.

  wat-apply-head-is : IRExpr, Text -> Boolean
  wat-apply-head-is (e) (n) =
   when e
    is IrName (nm) (ty) (sp) -> nm == n
    is IrApply (f) (a) (ty) (sp) -> wat-apply-head-is f n
    is otherwise -> False

  wat-expr-calls-name : IRExpr, Text -> Boolean
  wat-expr-calls-name (e) (n) =
   when e
    is IrIntLit (v) (sp) -> False
    is IrNumLit (v) (sp) -> False
    is IrTextLit (s) (sp) -> False
    is IrBoolLit (bv) (sp) -> False
    is IrCharLit (cv) (sp) -> False
    is IrName (nm) (ty) (sp) -> False
    is IrBinary (op) (l) (r) (ty) (sp) -> wat-expr-calls-name l n | wat-expr-calls-name r n
    is IrNegate (operand) (nty) (sp) -> wat-expr-calls-name operand n
    is IrIf (c) (t) (el) (ty) (sp) -> wat-expr-calls-name c n | wat-expr-calls-name t n | wat-expr-calls-name el n
    is IrLet (name) (ty) (val) (body) (sp) -> wat-expr-calls-name val n | wat-expr-calls-name body n
    is IrApply (f) (a) (ty) (sp) -> wat-apply-head-is f n | wat-expr-calls-name f n | wat-expr-calls-name a n
    is IrLambda (params) (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrList (elems) (ty) (sp) -> wat-list-calls-name elems n 0
    is IrMatch (scrut) (branches) (ty) (sp) -> wat-expr-calls-name scrut n | wat-branches-call-name branches n 0
    is IrAct (stmts) (ty) (sp) -> wat-stmts-call-name stmts n 0
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> wat-expr-calls-name body n
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrRecord (name) (fields) (ty) (sp) -> wat-fields-call-name fields n 0
    is IrFieldAccess (rec) (field) (ty) (sp) -> wat-expr-calls-name rec n
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> wat-expr-calls-name rec n | wat-expr-calls-name val n
    is IrFork (body) (ty) (sp) -> wat-expr-calls-name body n
    is IrAwait (task) (ty) (sp) -> wat-expr-calls-name task n
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> wat-stmts-call-name body n 0 | wat-stmts-call-name fb n 0 | wat-stmts-call-name fail-stmts n 0
    is IrError (msg) (ty) (sp) -> False

  wat-list-calls-name : List IRExpr, Text, Integer -> Boolean
  wat-list-calls-name (xs) (n) (i) =
   if i >= list-length xs then False
   else if wat-expr-calls-name (list-at xs i) n then True
   else wat-list-calls-name xs n (i + 1)

  wat-branches-call-name : List IRBranch, Text, Integer -> Boolean
  wat-branches-call-name (bs) (n) (i) =
   if i >= list-length bs then False
   else if wat-expr-calls-name ((list-at bs i).guard) n then True
   else if wat-expr-calls-name ((list-at bs i).body) n then True
   else wat-branches-call-name bs n (i + 1)

  wat-stmts-call-name : List IRActStmt, Text, Integer -> Boolean
  wat-stmts-call-name (ss) (n) (i) =
   if i >= list-length ss then False
   else let hit = when (list-at ss i)
    is IrDoBind (name) (ty) (val) (sp) -> wat-expr-calls-name val n
    is IrDoExec (e) (sp) -> wat-expr-calls-name e n
   in if hit then True else wat-stmts-call-name ss n (i + 1)

  wat-fields-call-name : List IRFieldVal, Text, Integer -> Boolean
  wat-fields-call-name (fs) (n) (i) =
   if i >= list-length fs then False
   else if wat-expr-calls-name ((list-at fs i).value) n then True
   else wat-fields-call-name fs n (i + 1)

  wasm-no-builtin : Text = ""

  wat-defs-call-name : List IRDef, Text, Integer -> Boolean
  wat-defs-call-name (defs) (n) (i) =
   if n == wasm-no-builtin then False
   else if i >= list-length defs then False
   else if wat-expr-calls-name ((list-at defs i).body) n then True
   else wat-defs-call-name defs n (i + 1)

  wasm-mention-any : List IRDef, Text, Text, Text, Text, Text -> Boolean
  wasm-mention-any (defs) (runtime) (types-text) (entry) (needle) (builtin) =
   if text-contains runtime needle then True
   else if text-contains types-text needle then True
   else if text-contains entry needle then True
   else wat-defs-call-name defs builtin 0

  wasm-stream-defs : WasmCtx, List IRDef, List StringEntry, Integer -> [Console] Nothing
  wasm-stream-defs (ctx) (defs) (tables) (i) =
   if i >= list-length defs then print-uni ""
   else let h = __heap-save
   in let d = list-at defs i
   in let off = strtab-lookup tables (d.name) 0
   in let text = if off > 0 then "  (func $" & wat-sanitize (d.name) & " (result i64) (i64.const " & integer-to-text off & "))\n" else emit-wat-def ctx d
   in act
    print-uni text
    print-uni "\n"
    let restored = __heap-restore h
    in wasm-stream-defs ctx defs tables (i + 1)
   end

  wat-name-member : List Text, Text, Integer -> Boolean
  wat-name-member (ns) (n) (i) =
   if i >= list-length ns then False
   else if list-at ns i == n then True
   else wat-name-member ns n (i + 1)

  wat-shared-len : IRDef, List Text -> Integer
  wat-shared-len (d) (shared) =
   if wat-name-member shared (d.name) 0 == False then 0 - 1
   else when d.body
    is IrList (es) (ty) (sp) -> if cs-int-lits es 0 then list-length es else 0 - 1
    is otherwise -> 0 - 1

  wat-shared-tables : List IRDef, List Text, Integer, Integer, List StringEntry -> List StringEntry
  wat-shared-tables (defs) (shared) (i) (off) (acc) =
   if i >= list-length defs then acc
   else let n = wat-shared-len (list-at defs i) shared
   in if n < 0 then wat-shared-tables defs shared (i + 1) off acc
      else wat-shared-tables defs shared (i + 1) (off + 8 + n * 8) (list-push acc (StringEntry { value = (list-at defs i).name, offset = off }))

  wat-tables-end : List IRDef, List StringEntry, Integer -> Integer
  wat-tables-end (defs) (tables) (base) =
   if list-length tables == 0 then base
   else let last = list-at tables (list-length tables - 1)
   in last.offset + 8 + 8 * wat-def-list-len defs (last.value) 0

  wat-def-list-len : List IRDef, Text, Integer -> Integer
  wat-def-list-len (defs) (name) (i) =
   if i >= list-length defs then 0
   else if (list-at defs i).name == name then
    (when (list-at defs i).body
     is IrList (es) (ty) (sp) -> list-length es
     is otherwise -> 0)
   else wat-def-list-len defs name (i + 1)

  wat-table-data : List IRDef, List StringEntry, Integer, List Text -> Text
  wat-table-data (defs) (tables) (i) (acc) =
   if i >= list-length defs then text-concat-list acc
   else let d = list-at defs i
   in let off = strtab-lookup tables (d.name) 0
   in if off == 0 then wat-table-data defs tables (i + 1) acc
      else when d.body
       is IrList (es) (ty) (sp) -> wat-table-data defs tables (i + 1) (list-push acc ("  (data (i32.const " & integer-to-text off & ") \"" & i32-to-hex-bytes (list-length es) & i32-to-hex-bytes (list-length es) & wat-i64-words es 0 [] & "\")\n"))
       is otherwise -> wat-table-data defs tables (i + 1) acc

  wat-i64-words : List IRExpr, Integer, List Text -> Text
  wat-i64-words (es) (i) (acc) =
   if i >= list-length es then text-concat-list acc
   else when list-at es i
    is IrIntLit (v) (sp) -> wat-i64-words es (i + 1) (list-push acc (wat-i64-hex v 0 []))
    is otherwise -> wat-i64-words es (i + 1) (list-push acc (wat-i64-hex 0 0 []))

  wat-i64-hex : Integer, Integer, List Text -> Text
  wat-i64-hex (v) (k) (acc) =
   if k >= 8 then text-concat-list acc
   else wat-i64-hex v (k + 1) (list-push acc (byte-to-hex (bit-and (bit-shru v (k * 8)) 255)))

  emit-wasm-chapter-stream : IRChapter, List ATypeDef -> [Console] Nothing
  emit-wasm-chapter-stream (m0) (type-defs) =
   let lifted = wh-lift-defs (m0.defs) 0 [] [] []
   in let m = __record-set m0 "defs" (lifted.defs)
   in let arities = build-arity-map (m.defs) 0 []
   in let raw-strings = wat-seed-entry-strings (m.defs) type-defs (collect-strings-defs (m.defs) 0 [])
   in let strings = strtab-assign-offsets raw-strings 0 1024 []
   in let cce-tab-base = strtab-end-offset strings
   in let cce-t2-base = cce-tab-base + cce-tab-bytes
   in let cce-out-base = cce-t2-base + cce-tier2-block-count * cce-t2-entry-bytes
   in let cce-rev-base = cce-out-base + cce-out-buf-bytes
   in let cce-in-base = cce-rev-base + cce-rev-entries
   in let fnarity-base = cce-tab-base + cce-tables-bytes
   in let max-arity = wat-fn-type-ceiling arities
   in let arity-end = fnarity-base + list-length arities
   in let tables-base = if int-mod arity-end 8 == 0 then arity-end else arity-end + 8 - int-mod arity-end 8
   in let tables = wat-shared-tables (m.defs) (shared-const-names (m.defs)) 0 tables-base []
   in let heap-start = if list-length tables == 0 then arity-end else wat-tables-end (m.defs) tables tables-base
   in let ctx = WasmCtx { arities = arities, strings = strings, type-defs = type-defs, bound = [], scrut-depth = 0, inplace = [], eff-ops = lifted.ops }
   in let runtime = wat-runtime-funcs cce-tab-base cce-t2-base cce-out-base fnarity-base max-arity cce-rev-base cce-in-base
   in let data-text = emit-data-sections strings 0
   in let types-text = emit-wat-type-defs type-defs 0 & wat-eq-funcs type-defs 0
   in let entry = wat-emit-entry ctx (m.defs)
   in let needs-blit = wasm-mention-any (m.defs) runtime types-text entry "$blit_framebuf" "blit-framebuf"
   in let needs-key = wasm-mention-any (m.defs) runtime types-text entry "$on_key_import" wasm-no-builtin
   in let header = wat-runtime-header heap-start needs-blit needs-key
   in act
    print-uni header
    print-uni (wh-runtime (lifted.ops))
    print-uni (wat-emit-table arities)
    print-uni data-text
    print-uni (wat-emit-arity-data arities fnarity-base 0 [])
    print-uni (wat-table-data (m.defs) tables 0 [])
    wat-stream-cce-tables cce-tab-base cce-t2-base cce-rev-base
    print-uni runtime
    print-uni types-text
    print-uni "\n"
    wasm-stream-defs ctx (m.defs) tables 0
    print-uni entry
    print-uni ")\n"
    print-uni "\n"
   end

  wat-emit-exports : List IRDef -> Text
  wat-emit-exports (defs) =
   let declared = wat-declared-exports defs 0 (list-length defs)
   in if declared < 0 then ""
      else let d = list-at defs declared
      in if list-length (d.params) > 0 then "(wasm-exports-requires-text-literal)\n"
         else when d.body
          is IrTextLit (s) (sp) -> wat-exports-declared (wat-export-names s) 0
          is otherwise -> "(wasm-exports-requires-text-literal)\n"

  wat-exports-declared : List Text, Integer -> Text
  wat-exports-declared (names) (i) =
   if i >= list-length names then ""
   else let sn = wat-sanitize (list-at names i)
   in "  (export \"" & sn & "\" (func $" & sn & "))\n" & wat-exports-declared names (i + 1)

  wat-declared-exports : List IRDef, Integer, Integer -> Integer
  wat-declared-exports (defs) (i) (n) =
   if i == n then -1
   else let d = list-at defs i
   in if (d.name) == "wasm-exports" then i
      else wat-declared-exports defs (i + 1) n

  wat-export-names : Text -> List Text
  wat-export-names (s) = wat-export-names-loop s 0 (text-length s) [] []

  wat-export-names-loop : Text, Integer, Integer, List Text, List Text -> List Text
  wat-export-names-loop (s) (i) (len) (cur) (acc) =
   if i == len then wat-export-flush cur acc
   else let c = char-code-at s i
   in if c == char-code-at "|" 0
      then wat-export-names-loop s (i + 1) len [] (wat-export-flush cur acc)
      else wat-export-names-loop s (i + 1) len (list-push cur (char-to-text (code-to-char c))) acc

  wat-export-flush : List Text, List Text -> List Text
  wat-export-flush (cur) (acc) =
   if list-length cur == 0 then acc else list-push acc (text-concat-list cur)

  wat-entry-ret-type : List IRDef, Integer -> CodexType
  wat-entry-ret-type (defs) (i) =
   if i >= list-length defs then NothingTy
   else let d = list-at defs i
   in if d.name == opening-entry-point then
       (if list-length (d.params) == 0 then strip-fun-args (d.type-val) else NothingTy)
      else wat-entry-ret-type defs (i + 1)

  wat-entry-type-name : CodexType -> Text
  wat-entry-type-name (ty) =
   when ty
    is SumTy (n) (args) (ctors) -> n.value
    is ConstructedTy (n) (args) -> n.value
    is TypeCon (n) -> n.value
    is RecordTy (n) (args) (fields) -> n.value
    is UnitTy (n) (inner) -> wat-entry-type-name inner
    is EffectfulTy (effs) (scopes) (ret) -> wat-entry-type-name ret
    is otherwise -> ""

  wat-ctors-of : List ATypeDef, Text, Integer -> List AVariantCtorDef
  wat-ctors-of (tds) (name) (i) =
   if text-length name == 0 then []
   else if i >= list-length tds then []
   else when list-at tds i
    is AVariantTypeDef (n) (tp) (cs) (sp) -> if n.value == name then cs else wat-ctors-of tds name (i + 1)
    is otherwise -> wat-ctors-of tds name (i + 1)

  wat-seed-ctor-names : List AVariantCtorDef, Integer, List StringEntry -> List StringEntry
  wat-seed-ctor-names (cs) (i) (acc) =
   if i >= list-length cs then acc
   else wat-seed-ctor-names cs (i + 1) (strtab-add acc ((list-at cs i).name.value))

  wat-seed-entry-strings : List IRDef, List ATypeDef, List StringEntry -> List StringEntry
  wat-seed-entry-strings (defs) (tds) (acc) =
   let cs = wat-ctors-of tds (wat-entry-type-name (wat-entry-ret-type defs 0)) 0
   in if list-length cs == 0 then acc
      else wat-seed-ctor-names cs 0 (strtab-add acc " ")

  wat-head-is-real : Text -> Boolean
  wat-head-is-real (h) =
   h == "Real" | h == "real-approx" | h == "real-trapping" | h == "real-saturating"

  wat-entry-field-print : Text, Text -> Text
  wat-entry-field-print (head) (load) =
   if head == "Text" then "(call $wasi_print_text " & load & ")"
   else if wat-head-is-real head then "(call $wasi_print_text (call $__f64_to_text " & load & "))"
   else if head == "Boolean" then "(call $wasi_print_text (call $bool_to_text " & load & "))"
   else "(call $wasi_print_text (call $i64_to_text " & load & "))"

  wat-entry-ctor-fields : WasmCtx, List ATypeExpr, Integer -> Text
  wat-entry-ctor-fields (ctx) (fs) (i) =
   if i >= list-length fs then ""
   else let load = "(i64.load (i32.add (i32.wrap_i64 (local.get $__r)) (i32.const " & integer-to-text (8 + i * 8) & ")))"
   in "      (call $wasi_print_text " & wat-strtab-ref (ctx.strings) " " & ")\n" &
      "      " & wat-entry-field-print (wat-atype-head-name (list-at fs i)) load & "\n" &
      wat-entry-ctor-fields ctx fs (i + 1)

  wat-entry-ctor-arms : WasmCtx, List AVariantCtorDef, Integer -> Text
  wat-entry-ctor-arms (ctx) (cs) (i) =
   if i >= list-length cs then ""
   else let c = list-at cs i
   in "    (if (i64.eq (i64.load (i32.wrap_i64 (local.get $__r))) (i64.const " & integer-to-text i & ")) (then\n" &
      "      (call $wasi_print_text " & wat-strtab-ref (ctx.strings) (c.name.value) & ")\n" &
      wat-entry-ctor-fields ctx (c.fields) 0 &
      "    ))\n" &
      wat-entry-ctor-arms ctx cs (i + 1)

  wat-emit-entry : WasmCtx, List IRDef -> Text
  wat-emit-entry (ctx) (defs) = wat-emit-entry-loop ctx defs 0 & wat-emit-exports defs

  wat-emit-entry-loop : WasmCtx, List IRDef, Integer -> Text
  wat-emit-entry-loop (ctx) (defs) (i) =
   if i >= list-length defs then ""
   else let d = list-at defs i
   in if d.name == opening-entry-point then
    if list-length (d.params) == 0 then
     let ret-type = strip-fun-args (d.type-val)
     in let print-fn = if wat-is-text-type ret-type then "$wasi_print_text"
          else if wat-is-real-type ret-type then "$wasi_print_text"
          else "$wasi_print_i64"
     in let print-arg = if wat-is-real-type ret-type then "(call $__f64_to_text (local.get $__r))"
          else "(local.get $__r)"
     in let is-void = when ret-type
          is NothingTy -> True
          is ProofTy -> True
          is PropEqTy (pl) (pr) -> True
          is VoidTy -> True
          is UnitTy (n) (inner) -> True
          is EffectfulTy (effs) (scopes) (r) -> when r is NothingTy -> True is VoidTy -> True is UnitTy (n2) (inner2) -> True is otherwise -> False
          is otherwise -> False
     in let ctors = wat-ctors-of (ctx.type-defs) (wat-entry-type-name ret-type) 0
     in if is-void then
      "  (func $__start (drop (call $" & wat-sanitize opening-entry-point & ")))\n" &
      "  (export \"_start\" (func $__start))\n"
     else if list-length ctors > 0 then
      "  (func $__start\n" &
      "    (local $__r i64)\n" &
      "    (local.set $__r (call $" & wat-sanitize opening-entry-point & "))\n" &
      wat-entry-ctor-arms ctx ctors 0 &
      "    (call $wasi_print_newline))\n" &
      "  (export \"_start\" (func $__start))\n"
     else
      "  (func $__start\n" &
      "    (local $__r i64)\n" &
      "    (local.set $__r (call $" & wat-sanitize opening-entry-point & "))\n" &
      "    (call " & print-fn & " " & print-arg & ")\n" &
      "    (call $wasi_print_newline))\n" &
      "  (export \"_start\" (func $__start))\n"
    else ""
   else wat-emit-entry-loop ctx defs (i + 1)

Page 1
