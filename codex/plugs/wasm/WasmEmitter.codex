   "  (func $char_at (param $s i64) (param $idx i64) (result i64)\n" &
   "    (i64.extend_i32_u (i32.load8_u (i32.add (i32.add (i32.wrap_i64 (local.get $s)) (i32.const 4)) (i32.wrap_i64 (local.get $idx))))))\n\n" &
   "  (func $__text_compare (param $a i64) (param $b i64) (result i64)\n" &
   "    (local $pa i32) (local $pb i32) (local $la i32) (local $lb i32) (local $n i32) (local $i i32) (local $ca i32) (local $cb i32)\n" &
   "    (local.set $pa (i32.wrap_i64 (local.get $a)))\n" &
   "    (local.set $pb (i32.wrap_i64 (local.get $b)))\n" &
   "    (local.set $la (i32.load (local.get $pa)))\n" &
   "    (local.set $lb (i32.load (local.get $pb)))\n" &
   "    (local.set $n (local.get $la))\n" &
   "    (if (i32.lt_s (local.get $lb) (local.get $la)) (then (local.set $n (local.get $lb))))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $d (loop $c\n" &
   "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n" &
   "      (local.set $ca (i32.load8_u (i32.add (i32.add (local.get $pa) (i32.const 4)) (local.get $i))))\n" &
   "      (local.set $cb (i32.load8_u (i32.add (i32.add (local.get $pb) (i32.const 4)) (local.get $i))))\n" &
   "      (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i64.const -1))))\n" &
   "      (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i64.const 1))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $c)))\n" &
   "    (if (i32.lt_s (local.get $la) (local.get $lb)) (then (return (i64.const -1))))\n" &
   "    (if (i32.gt_s (local.get $la) (local.get $lb)) (then (return (i64.const 1))))\n" &
   "    (i64.const 0))\n\n" &
   "  (func $text_eq (param $a i64) (param $b i64) (result i64)\n" &
   "    (local $pa i32) (local $pb i32) (local $la i32) (local $idx i32)\n" &
   "    (local.set $pa (i32.wrap_i64 (local.get $a)))\n" &
   "    (local.set $pb (i32.wrap_i64 (local.get $b)))\n" &
   "    (if (i32.eq (local.get $pa) (local.get $pb)) (then (return (i64.const 1))))\n" &
   "    (local.set $la (i32.load (local.get $pa)))\n" &
   "    (if (i32.ne (local.get $la) (i32.load (local.get $pb))) (then (return (i64.const 0))))\n" &
   "    (local.set $idx (i32.const 0))\n" &
   "    (block $d (loop $c\n" &
   "      (br_if $d (i32.ge_s (local.get $idx) (local.get $la)))\n" &
   "      (if (i32.ne\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $pa) (i32.const 4)) (local.get $idx)))\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $pb) (i32.const 4)) (local.get $idx))))\n" &
   "        (then (return (i64.const 0))))\n" &
   "      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))\n" &
   "      (br $c)))\n" &
   "    (i64.const 1))\n\n" &
   "  (func $list_push (param $lst i64) (param $val i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $cap i32) (local $dst i32) (local $idx i32) (local $nc i32) (local $eb i32) (local $isv i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $cap (i32.load (i32.add (local.get $p) (i32.const 4))))\n" &
   "    (local.set $eb (call $cx_list_base (local.get $lst)))\n" &
   "    (local.set $isv (i32.eq (local.get $cap) (i32.const -1)))\n" &
   "    (if (local.get $isv) (then (local.set $cap (i32.const 0))))\n" &
   "    (if (i32.lt_s (local.get $n) (local.get $cap))\n" &
   "      (then\n" &
   "        (i64.store (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.mul (local.get $n) (i32.const 8))) (local.get $val))\n" &
   "        (i32.store (local.get $p) (i32.add (local.get $n) (i32.const 1)))\n" &
   "        (return (i64.extend_i32_u (local.get $p))))\n" &
   "      (else\n" &
   "        (local.set $nc (i32.mul (local.get $cap) (i32.const 2)))\n" &
   "        (if (i32.lt_s (local.get $nc) (i32.const 8)) (then (local.set $nc (i32.const 8))))\n" &
   "        (local.set $dst (call $bump_alloc (i32.add (i32.const 8) (i32.mul (local.get $nc) (i32.const 8)))))\n" &
   "        (i32.store (local.get $dst) (i32.add (local.get $n) (i32.const 1)))\n" &
   "        (i32.store (i32.add (local.get $dst) (i32.const 4)) (local.get $nc))\n" &
   "        (local.set $idx (i32.const 0))\n" &
   "        (block $d (loop $c\n" &
   "          (br_if $d (i32.ge_s (local.get $idx) (local.get $n)))\n" &
   "          (i64.store (i32.add (i32.add (local.get $dst) (i32.const 8)) (i32.mul (local.get $idx) (i32.const 8)))\n" &
   "            (i64.load (i32.add (i32.add (local.get $eb) (i32.const 8)) (i32.mul (local.get $idx) (i32.const 8)))))\n" &
   "          (local.set $idx (i32.add (local.get $idx) (i32.const 1)))\n" &
   "          (br $c)))\n" &
   "        (i64.store (i32.add (i32.add (local.get $dst) (i32.const 8)) (i32.mul (local.get $n) (i32.const 8))) (local.get $val))\n" &
   "        (return (i64.extend_i32_u (local.get $dst)))))\n" &
   "    (unreachable))\n\n"

  wat-rt-list-mutate : Text =
   "  (func $list_set_at (param $lst i64) (param $idx i64) (param $val i64) (result i64)\n" &
   "    (i64.store (i32.add (call $cx_list_base (local.get $lst)) (i32.add (i32.const 8) (i32.mul (i32.wrap_i64 (local.get $idx)) (i32.const 8)))) (local.get $val))\n" &
