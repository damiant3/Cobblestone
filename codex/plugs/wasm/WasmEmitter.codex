   "        (i64.load (i32.add (i32.add (local.get $pa) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $ca)))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $db (loop $cb\n" &
   "      (br_if $db (i32.ge_s (local.get $i) (local.get $nb)))\n" &
   "      (i64.store (i32.add (i32.add (local.get $dst) (i32.const 8)) (i32.mul (i32.add (local.get $na) (local.get $i)) (i32.const 8)))\n" &
   "        (i64.load (i32.add (i32.add (local.get $pb) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $cb)))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n" &
   "  (func $list_cons (param $val i64) (param $lst i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $dst i32) (local $i i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $p (call $cx_list_base (local.get $lst)))\n" &
   "    (local.set $dst (call $bump_alloc (i32.add (i32.const 8) (i32.mul (i32.add (local.get $n) (i32.const 1)) (i32.const 8)))))\n" &
   "    (i32.store (local.get $dst) (i32.add (local.get $n) (i32.const 1)))\n" &
   "    (i32.store (i32.add (local.get $dst) (i32.const 4)) (i32.add (local.get $n) (i32.const 1)))\n" &
   "    (i64.store (i32.add (local.get $dst) (i32.const 8)) (local.get $val))\n" &
   "    (local.set $i (i32.const 0))\n" &
   "    (block $dc (loop $cc\n" &
   "      (br_if $dc (i32.ge_s (local.get $i) (local.get $n)))\n" &
   "      (i64.store (i32.add (i32.add (local.get $dst) (i32.const 16)) (i32.mul (local.get $i) (i32.const 8)))\n" &
   "        (i64.load (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n" &
   "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n" &
   "      (br $cc)))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n"

 The bytes are read off the literals with `char-code`, which is what
 `wat-escape-data` does for the string table. A transcribed ASCII "True" is
 the wrong answer here: this plug's Text is CCE, `$wasi_print_text` decodes
 through the CCE tables on the way out, and 84 is not the CCE code point for
 `T`.

  wat-bool-text-stores : Text, Integer, Integer -> Text
  wat-bool-text-stores (s) (i) (len) =
   if i >= len then ""
   else "        (i32.store8 (i32.add (local.get $p) (i32.const " & integer-to-text (4 + i) & ")) (i32.const " & integer-to-text (char-code (char-at s i)) & "))\n" &
        wat-bool-text-stores s (i + 1) len

  wat-bool-text-arm : Text -> Text
  wat-bool-text-arm (s) =
   let len = text-length s
   in "        (local.set $p (call $bump_alloc (i32.const " & integer-to-text (4 + len) & ")))\n" &
      "        (i32.store (local.get $p) (i32.const " & integer-to-text len & "))\n" &
      wat-bool-text-stores s 0 len

  wat-rt-bool-text : Text =
   "  (func $bool_to_text (param $v i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (if (i64.eqz (local.get $v))\n" &
   "      (then\n" &
   wat-bool-text-arm "False" &
   "      )\n" &
   "      (else\n" &
   wat-bool-text-arm "True" &
   "      ))\n" &
   "    (i64.extend_i32_u (local.get $p)))\n\n"

 The bands are CCE code points and are the ones `emit-is-letter-builtin`
 (`X86_64Builtins.codex:382`) tests: letters are 13..64 and 97..127, two ranges
 because Tier 0 puts sixteen accented Latin letters and fifteen Cyrillic ones
 above the punctuation, and whitespace is 1..2. The digit band is derived from
 `cce-digit-zero` rather than written down twice.

 `__list-tail` is a VIEW, as it is on x86-64 (`X86_64ListHelpers.codex:3`), and
 for the same two reasons: O(1) so a `when xs is Cons` recursion is not
 quadratic, and aliasing, because a write through `list-set-at` on a view must
 land in the backing where every sibling view can see it. A copy is correct for
 every reader and wrong for that one, which is the half a green on
 `list-view-bounds` cannot see and `list-view-probe`'s `set=` line can.

 This plug's list is `[len i32][cap i32][elements]` with the pointer at the
 header, so the sentinel is the CAPACITY cell rather than x86-64's cell behind
 the pointer: capacity -1 means view, and the view's third cell holds a phantom
 pointer chosen so that phantom+8 is the view's first element, which is the
 displacement every element loop here already uses. `$cx_list_base` is the one
 selection, and a reader that indexes elements calls it instead of wrapping the
 pointer. A plain list never carries -1: the empty literal is 0, `$list_append`
 and `$list_cons` set capacity equal to length, and `$list_with_capacity`
 floors at 0.

 A reduction reads its operand four times, so it is a helper taking the POINTER
 rather than four copies of an expression that may allocate. The f32 sum comes
 back as a promoted f64 because that is how this plug carries an approximate
 real everywhere else.

  wat-rt-vec : Text =
   "  (func $cx_vec_box (param $v v128) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (call $bump_alloc (i32.const 16)))\n" &
   "    (v128.store (local.get $p) (local.get $v))\n" &
   "    (i64.extend_i32_u (local.get $p)))\n\n" &
   "  (func $cx_vec_store (param $addr i64) (param $v i64) (result i64)\n" &
   "    (v128.store (i32.wrap_i64 (local.get $addr)) (v128.load (i32.wrap_i64 (local.get $v))))\n" &
   "    (local.get $addr))\n\n" &
   "  (func $cx_mask_bits (param $m i64) (result i32)\n" &
   "    (i64x2.bitmask (v128.load (i32.wrap_i64 (local.get $m)))))\n\n" &
   "  (func $cx_mask_count (param $m i64) (result i64)\n" &
   "    (local $b i32)\n" &
   "    (local.set $b (call $cx_mask_bits (local.get $m)))\n" &
   "    (i64.extend_i32_u (i32.add (i32.and (local.get $b) (i32.const 1)) (i32.shr_u (local.get $b) (i32.const 1)))))\n\n" &
   "  (func $cx_vec_sum_f64x2 (param $v i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $v)))\n" &
   "    (i64.reinterpret_f64 (f64.add (f64.load (local.get $p)) (f64.load offset=8 (local.get $p)))))\n\n" &
   "  (func $cx_vec_sum_i64x2 (param $v i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $v)))\n" &
   "    (i64.add (i64.load (local.get $p)) (i64.load offset=8 (local.get $p))))\n\n" &
   "  (func $cx_vec_sum_f32x4 (param $v i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $v)))\n" &
   "    (i64.reinterpret_f64 (f64.promote_f32 (f32.add\n" &
   "      (f32.add (f32.load (local.get $p)) (f32.load offset=4 (local.get $p)))\n" &
   "      (f32.add (f32.load offset=8 (local.get $p)) (f32.load offset=12 (local.get $p)))))))\n\n" &
   "  (func $cx_vec_sum_i32x4 (param $v i64) (result i64)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $v)))\n" &
   "    (i64.extend_i32_s (i32.add\n" &
   "      (i32.add (i32.load (local.get $p)) (i32.load offset=4 (local.get $p)))\n" &
   "      (i32.add (i32.load offset=8 (local.get $p)) (i32.load offset=12 (local.get $p))))))\n\n"

  wat-rt-real-modes : Text =
   "  (func $cx_real_sat64 (param $b i64) (result i64)\n" &
   "    (if (i64.ne (i64.and (local.get $b) (i64.const 0x7ff0000000000000)) (i64.const 0x7ff0000000000000))\n" &
   "      (then (return (local.get $b))))\n" &
   "    (if (i64.ne (i64.and (local.get $b) (i64.const 0x000fffffffffffff)) (i64.const 0))\n" &
   "      (then (return (i64.const 0))))\n" &
   "    (i64.sub (local.get $b) (i64.const 1)))\n\n" &
   "  (func $cx_real_trap64 (param $b i64) (result i64)\n" &
   "    (if (i64.eq (i64.and (local.get $b) (i64.const 0x7ff0000000000000)) (i64.const 0x7ff0000000000000))\n" &
   "      (then (unreachable)))\n" &
   "    (local.get $b))\n\n" &
   "  (func $cx_real_sat32 (param $b i64) (result i64)\n" &
   "    (local $f i32)\n" &
   "    (local.set $f (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $b)))))\n" &
   "    (if (i32.ne (i32.and (local.get $f) (i32.const 0x7f800000)) (i32.const 0x7f800000))\n" &
   "      (then (return (local.get $b))))\n" &
   "    (if (i32.ne (i32.and (local.get $f) (i32.const 0x007fffff)) (i32.const 0))\n" &
   "      (then (return (i64.const 0))))\n" &
   "    (i64.reinterpret_f64 (f64.promote_f32 (f32.reinterpret_i32 (i32.sub (local.get $f) (i32.const 1))))))\n\n" &
   "  (func $cx_real_trap32 (param $b i64) (result i64)\n" &
   "    (local $f i32)\n" &
   "    (local.set $f (i32.reinterpret_f32 (f32.demote_f64 (f64.reinterpret_i64 (local.get $b)))))\n" &
   "    (if (i32.eq (i32.and (local.get $f) (i32.const 0x7f800000)) (i32.const 0x7f800000))\n" &
   "      (then (unreachable)))\n" &
   "    (local.get $b))\n\n"

  wat-rt-list-tail : Text =
   "  (func $cx_list_base (param $lst i64) (result i32)\n" &
   "    (local $p i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (if (i32.eq (i32.load (i32.add (local.get $p) (i32.const 4))) (i32.const -1))\n" &
   "      (then (return (i32.wrap_i64 (i64.load (i32.add (local.get $p) (i32.const 8)))))))\n" &
   "    (local.get $p))\n\n" &
   "  (func $cx_list_tail (param $lst i64) (result i64)\n" &
   "    (local $p i32) (local $n i32) (local $base i32) (local $dst i32)\n" &
   "    (local.set $p (i32.wrap_i64 (local.get $lst)))\n" &
   "    (local.set $n (i32.load (local.get $p)))\n" &
   "    (local.set $base (call $cx_list_base (local.get $lst)))\n" &
   "    (if (i32.gt_s (local.get $n) (i32.const 0))\n" &
   "      (then (local.set $n (i32.sub (local.get $n) (i32.const 1))))\n" &
   "      (else (local.set $n (i32.const 0))))\n" &
   "    (local.set $dst (call $bump_alloc (i32.const 16)))\n" &
   "    (i32.store (local.get $dst) (local.get $n))\n" &
   "    (i32.store (i32.add (local.get $dst) (i32.const 4)) (i32.const -1))\n" &
   "    (i64.store (i32.add (local.get $dst) (i32.const 8))\n" &
   "      (i64.extend_i32_u (i32.add (local.get $base) (i32.const 8))))\n" &
   "    (i64.extend_i32_u (local.get $dst)))\n\n"

  wat-rt-char-class : Text =
   "  (func $__is_digit (param $c i64) (result i64)\n" &
   "    (i64.extend_i32_u (i32.and\n" &
   "      (i64.ge_s (local.get $c) (i64.const " & integer-to-text cce-digit-zero & "))\n" &
   "      (i64.le_s (local.get $c) (i64.const " & integer-to-text (cce-digit-zero + 9) & ")))))\n\n" &
   "  (func $__is_letter (param $c i64) (result i64)\n" &
   "    (i64.extend_i32_u (i32.or\n" &
   "      (i32.and (i64.ge_s (local.get $c) (i64.const 13)) (i64.le_s (local.get $c) (i64.const 64)))\n" &
   "      (i32.and (i64.ge_s (local.get $c) (i64.const 97)) (i64.le_s (local.get $c) (i64.const 127))))))\n\n" &
   "  (func $__is_whitespace (param $c i64) (result i64)\n" &
   "    (i64.extend_i32_u (i32.and\n" &
   "      (i64.ge_s (local.get $c) (i64.const 1))\n" &
   "      (i64.le_s (local.get $c) (i64.const 2)))))\n\n"

  wat-rt-char-text : Text =
   "  (func $char_to_text (param $ch i64) (result i64)\n" &
   "    (local $ptr i32)\n" &
   "    (local.set $ptr (call $bump_alloc (i32.const 5)))\n" &
   "    (i32.store (local.get $ptr) (i32.const 1))\n" &
   "    (i32.store8 (i32.add (local.get $ptr) (i32.const 4)) (i32.wrap_i64 (local.get $ch)))\n" &
   "    (i64.extend_i32_u (local.get $ptr)))\n\n" &
   "  (func $char_encode (param $ch i64) (result i64)\n" &
   "    (local $c i32) (local $v i32) (local $ptr i32)\n" &
