   "        (local.set $end (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.mul (local.get $cap) (i32.const 8))))\n" &
   "        (local.set $delta (i32.mul (i32.sub (local.get $nc) (local.get $cap)) (i32.const 8)))\n" &
   "        (if (i32.eq (local.get $end) (global.get $heap_ptr))\n" &
   "          (then\n" &
   "            (drop (call $bump_alloc (local.get $delta)))\n" &
   "            (i32.store (i32.add (local.get $p) (i32.const 4)) (local.get $nc))\n" &
   "            (i64.store (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.mul (local.get $n) (i32.const 8))) (local.get $val))\n" &
   "            (i32.store (local.get $p) (i32.add (local.get $n) (i32.const 1)))\n" &
   "            (return (i64.extend_i32_u (local.get $p)))))\n" &
   "        (if (i32.eq (local.get $end) (global.get $deck_ptr))\n" &
