Chapter: Babbage Emitter

 Generates Analytical Engine operation cards from the IR.

Section: Keywords and Sanitization

  bab-header : Text
  bab-header =
   ". ---------------------------------------------------\n" &
   ". Analytical Engine program\n" &
   ". Generated by Codex compiler - Babbage backend\n" &
   ". ---------------------------------------------------\n" &
   ". Store columns 0-9: scratch registers\n" &
   ". Store columns 10+: program variables\n" &
   ". The Mill performs all arithmetic operations.\n" &
   ". ---------------------------------------------------\n\n"

  bab-format-col : Integer -> Text
  bab-format-col (n) =
   if n < 10 then "00" & integer-to-text n
   else if n < 100 then "0" & integer-to-text n
   else integer-to-text n

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  bab-leaf-chain : IRExpr, List IRExpr -> ApplyChain
  bab-leaf-chain (e) (acc) = ApplyChain { root = e, args = acc }

Section: Store Allocation

  BabState = record {
   next-store : Integer,
   store-map : List BabBinding,
   label-counter : Integer
  }

  BabBinding = record {
   name : Text,
   col : Integer
  }

  bab-initial-state : BabState
  bab-initial-state = BabState { next-store = 10, store-map = [], label-counter = 0 }

  bab-lookup-store : List BabBinding, Text -> Integer
  bab-lookup-store (bindings) (name) =
   bab-lookup-loop bindings name 0

  bab-lookup-loop : List BabBinding, Text, Integer -> Integer
  bab-lookup-loop (bindings) (name) (i) =
   if i == list-length bindings then -1
   else let b = list-at bindings i
   in if b.name == name then b.col
      else bab-lookup-loop bindings name (i + 1)

  BabAllocResult = record {
   col : Integer,
   state : BabState
  }

  bab-alloc : BabState, Text -> BabAllocResult
  bab-alloc (st) (name) =
   let existing = bab-lookup-store (st.store-map) name
   in if existing >= 0 then BabAllocResult { col = existing, state = st }
      else BabAllocResult {
       col = st.next-store,
       state = BabState {
        next-store = st.next-store + 1,
        store-map = list-snoc (st.store-map) (BabBinding { name = name, col = st.next-store }),
        label-counter = st.label-counter
       }
      }

  bab-next-label : BabState -> BabAllocResult
  bab-next-label (st) =
   BabAllocResult {
    col = st.label-counter,
    state = BabState {
     next-store = st.next-store,
     store-map = st.store-map,
     label-counter = st.label-counter + 1
    }
   }

Section: Type Definition Emission

  emit-bab-type-defs : List ATypeDef, Integer -> Text
  emit-bab-type-defs (tds) (i) =
   if i == list-length tds then ""
   else ". Type: " & bab-type-def-name (list-at tds i) & " (represented as Store columns)\n" & emit-bab-type-defs tds (i + 1)

  bab-type-def-name : ATypeDef -> Text
  bab-type-def-name (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) -> name.value
    is AVariantTypeDef (name) (tparams) (ctors) (s) -> name.value
    is AUnitTypeDef (name) (unitbase) (s) -> name.value

Section: Expression Emission

  BabEmitResult = record {
   text : Text,
   state : BabState
  }

  bab-emit-to-store : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-to-store (e) (target) (st) (arities) =
   when e
    is IrIntLit (n) (sp) -> BabEmitResult {
     text = "N" & bab-format-col n & "\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrNumLit (n) (sp) -> BabEmitResult {
     text = "N" & bab-format-col n & "\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrTextLit (s) (sp) -> BabEmitResult {
     text = ". text literal not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrBoolLit (b) (sp) -> BabEmitResult {
     text = "N" & bab-format-col (if b then 1 else 0) & "\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrCharLit (n) (sp) -> BabEmitResult {
     text = "N" & bab-format-col n & "\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrName (n) (ty) (sp) -> bab-emit-name-to-store n target st
    is IrBinary (op) (l) (r) (ty) (sp) -> bab-emit-binary-to-store op l r target st arities
    is IrNegate (operand) (nty) (sp) -> bab-emit-negate-to-store operand target st arities
    is IrIf (c) (t) (el) (ty) (sp) -> bab-emit-if-to-store c t el target st arities
    is IrLet (name) (ty) (val) (body) (sp) -> bab-emit-let-to-store name val body target st arities
    is IrApply (f) (a) (ty) (sp) -> bab-emit-apply-to-store e target st arities
    is IrLambda (ps) (body) (ty) (sp) -> BabEmitResult {
     text = ". lambda not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrList (es) (ty) (sp) -> bab-emit-list-to-store es target st arities
    is IrMatch (scrut) (branches) (ty) (sp) -> bab-emit-match-to-store scrut branches target st arities
    is IrAct (stmts) (ty) (sp) -> bab-emit-act-to-store stmts target st arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> bab-emit-to-store body target st arities
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> bab-emit-to-store body target st arities
    is IrRecord (rname) (fields) (ty) (sp) -> bab-emit-record-to-store fields target st arities
    is IrFieldAccess (rec) (field) (ty) (sp) -> bab-emit-to-store rec target st arities
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> BabEmitResult {
     text = ". field-store not supported on Analytical Engine\n",
     state = st
    }
    is IrFork (body) (ty) (sp) -> bab-emit-to-store body target st arities
    is IrAwait (task) (ty) (sp) -> bab-emit-to-store task target st arities
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> BabEmitResult {
     text = ". try not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrError (msg) (ty) (sp) -> BabEmitResult {
     text = ". error: " & msg & "\nN000\nS" & bab-format-col target & "\n",
     state = st
    }

  bab-emit-name-to-store : Text, Integer, BabState -> BabEmitResult
  bab-emit-name-to-store (n) (target) (st) =
   let src = bab-lookup-store (st.store-map) n
   in if src >= 0 then BabEmitResult {
    text = "L" & bab-format-col src & "\nS" & bab-format-col target & "\n",
    state = st
   }
   else BabEmitResult {
    text = "N000\nS" & bab-format-col target & "\n",
    state = st
   }

  bab-emit-binary-to-store : IRBinaryOp, IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-binary-to-store (op) (l) (r) (target) (st) (arities) =
   when op
    is IrAppendText -> BabEmitResult {
     text = ". append-text not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrAppendList -> BabEmitResult {
     text = ". append-list not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrConsList -> BabEmitResult {
     text = ". cons-list not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
     state = st
    }
    is IrPowInt -> bab-emit-pow-to-store l r target st arities
    is IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrRemInt -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAddNum | IrSubNum | IrMulNum | IrDivNum -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAddVec | IrSubVec | IrMulVec | IrDivVec -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating -> bab-emit-simple-binary-to-store op l r target st arities
    is IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq -> bab-emit-simple-binary-to-store op l r target st arities
    is IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> bab-emit-simple-binary-to-store op l r target st arities
    is IrApproxEq | IrApproxEqExact -> bab-emit-simple-binary-to-store op l r target st arities
    is IrAnd | IrOr -> bab-emit-simple-binary-to-store op l r target st arities

  bab-emit-simple-binary-to-store : IRBinaryOp, IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-simple-binary-to-store (op) (l) (r) (target) (st) (arities) =
   let la = bab-alloc st "_left"
   in let ra = bab-alloc (la.state) "_right"
   in let lr = bab-emit-to-store l (la.col) (ra.state) arities
   in let rr = bab-emit-to-store r (ra.col) (lr.state) arities
   in BabEmitResult {
    text = lr.text & rr.text & "L" & bab-format-col (la.col) & "\nL" & bab-format-col (ra.col) & "\n" & bab-bin-op-card op & "\nS" & bab-format-col target & "\n",
    state = rr.state
   }

  bab-emit-pow-to-store : IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-pow-to-store (base) (exp) (target) (st) (arities) =
   let ba = bab-alloc st "_pow_base"
   in let ea = bab-alloc (ba.state) "_pow_exp"
   in let ca = bab-alloc (ea.state) "_pow_count"
   in let br = bab-emit-to-store base (ba.col) (ca.state) arities
   in let er = bab-emit-to-store exp (ea.col) (br.state) arities
   in let l1r = bab-next-label (er.state)
   in let l2r = bab-next-label (l1r.state)
   in BabEmitResult {
    text = br.text & er.text &
     "N001\nS" & bab-format-col target & "\n" &
     "N001\nS" & bab-format-col (ca.col) & "\n" &
     "LABEL_" & integer-to-text (l1r.col) & ":\n" &
     "L" & bab-format-col (ca.col) & "\nL" & bab-format-col (ea.col) & "\n-\n" &
     "CF LABEL_" & integer-to-text (l2r.col) & "\n" &
     "L" & bab-format-col target & "\nL" & bab-format-col (ba.col) & "\n*\n" &
     "S" & bab-format-col target & "\n" &
     "L" & bab-format-col (ca.col) & "\nN001\n+\nS" & bab-format-col (ca.col) & "\n" &
     "CB LABEL_" & integer-to-text (l1r.col) & "\n" &
     "LABEL_" & integer-to-text (l2r.col) & ":\n",
    state = l2r.state
   }

  bab-emit-negate-to-store : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-negate-to-store (operand) (target) (st) (arities) =
   let na = bab-alloc st "_neg"
   in let nr = bab-emit-to-store operand (na.col) (na.state) arities
   in BabEmitResult {
    text = nr.text & "N000\nS" & bab-format-col target & "\nL" & bab-format-col target & "\nL" & bab-format-col (na.col) & "\n-\nS" & bab-format-col target & "\n",
    state = nr.state
   }

  bab-emit-if-to-store : IRExpr, IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-if-to-store (cond) (t) (el) (target) (st) (arities) =
   let ca = bab-alloc st "_if_cond"
   in let cr = bab-emit-to-store cond (ca.col) (ca.state) arities
   in let l1r = bab-next-label (cr.state)
   in let l2r = bab-next-label (l1r.state)
   in let tr = bab-emit-to-store t target (l2r.state) arities
   in let er = bab-emit-to-store el target (tr.state) arities
   in BabEmitResult {
    text = cr.text & "L" & bab-format-col (ca.col) & "\nCF LABEL_" & integer-to-text (l1r.col) & "\n" & tr.text & "CB LABEL_" & integer-to-text (l2r.col) & "\nLABEL_" & integer-to-text (l1r.col) & ":\n" & er.text & "LABEL_" & integer-to-text (l2r.col) & ":\n",
    state = er.state
   }

  bab-emit-let-to-store : Text, IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-let-to-store (name) (val) (body) (target) (st) (arities) =
   let la = bab-alloc st name
   in let vr = bab-emit-to-store val (la.col) (la.state) arities
   in bab-emit-to-store body target (vr.state) arities

  bab-emit-apply-to-store : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-apply-to-store (e) (target) (st) (arities) =
   let chain = collect-apply-chain e []
   in bab-emit-apply-root chain target st arities

  bab-emit-apply-root : ApplyChain, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-apply-root (chain) (target) (st) (arities) =
   when chain.root
    is IrName (n) (ty) (sp) -> bab-emit-apply-named n (chain.args) target st arities
    is IrLambda (ps) (body) (ty) (sp) -> bab-emit-to-store body target st arities
    is IrIntLit (v) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrNumLit (v) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrTextLit (v) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrBoolLit (v) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrCharLit (v) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrBinary (op) (l) (r) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrNegate (x) (nty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrIf (c) (t) (el) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrLet (name) (ty) (val) (body) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrApply (f) (a) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrList (es) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrMatch (sc) (bs) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrAct (ss) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrHandle (eff) (h) (cs) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrRecord (n) (fs) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrFieldAccess (r) (f) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrFieldStore (r) (f) (v) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrFork (body) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrAwait (task) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrTry (mx) (bd) (fb) (fs) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities
    is IrError (m) (ty) (sp) -> bab-emit-to-store (chain.root) target st arities

  bab-builtin-names : List Text
  bab-builtin-names = ["abs", "bit-and", "bit-not", "bit-or", "bit-xor",
   "int-mod", "max", "min", "negate", "print-line-uni", "show"]

  bab-bsearch-builtin : List Text, Text, Integer, Integer -> Integer
  bab-bsearch-builtin (names) (target) (lo) (hi) =
   if lo >= hi then -1
   else let mid = lo + (hi - lo) / 2
   in let cmp = text-compare target (list-at names mid)
   in if cmp == 0 then mid
      else if cmp < 0 then bab-bsearch-builtin names target lo mid
      else bab-bsearch-builtin names target (mid + 1) hi

  bab-emit-apply-named : Text, List IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-apply-named (n) (args) (target) (st) (arities) =
   let idx = bab-bsearch-builtin bab-builtin-names n 0 (list-length bab-builtin-names)
   in if idx >= 0 then bab-emit-builtin-by-idx idx args target st arities
      else bab-emit-call-def n args target st arities

  bab-emit-builtin-by-idx : Integer, List IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-by-idx (idx) (args) (target) (st) (arities) =
   if idx == 0 then bab-emit-builtin-abs (list-at args 0) target st arities
   else if idx == 1 then BabEmitResult {
    text = ". bit-and not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else if idx == 2 then BabEmitResult {
    text = ". bit-not not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else if idx == 3 then BabEmitResult {
    text = ". bit-or not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else if idx == 4 then BabEmitResult {
    text = ". bit-xor not supported on Analytical Engine\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else if idx == 5 then bab-emit-builtin-mod (list-at args 0) (list-at args 1) target st arities
   else if idx == 6 then bab-emit-builtin-max (list-at args 0) (list-at args 1) target st arities
   else if idx == 7 then bab-emit-builtin-min (list-at args 0) (list-at args 1) target st arities
   else if idx == 8 then bab-emit-builtin-negate (list-at args 0) target st arities
   else if idx == 9 then bab-emit-builtin-print (list-at args 0) target st arities
   else bab-emit-to-store (list-at args 0) target st arities

  bab-emit-call-def : Text, List IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-call-def (n) (args) (target) (st) (arities) =
   let ar = lookup-arity arities n
   in if ar < 0 then BabEmitResult {
    text = ". call to unknown function " & n & "\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else let arg-r = bab-emit-call-args args target st arities 0
   in BabEmitResult {
    text = ". call " & n & "\n" & arg-r.text & "N000\nS" & bab-format-col target & "\n",
    state = arg-r.state
   }

  bab-emit-call-args : List IRExpr, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-call-args (args) (target) (st) (arities) (i) =
   if i >= list-length args then BabEmitResult { text = "", state = st }
   else let aa = bab-alloc st ("_arg_" & integer-to-text i)
   in let ar = bab-emit-to-store (list-at args i) (aa.col) (aa.state) arities
   in let rest = bab-emit-call-args args target (ar.state) arities (i + 1)
   in BabEmitResult { text = ar.text & rest.text, state = rest.state }

  bab-emit-builtin-print : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-print (arg) (target) (st) (arities) =
   let pa = bab-alloc st "_print"
   in let pr = bab-emit-to-store arg (pa.col) (pa.state) arities
   in BabEmitResult {
    text = pr.text & "L" & bab-format-col (pa.col) & "\nP\n" &
     "N000\nS" & bab-format-col target & "\n",
    state = pr.state
   }

  bab-emit-builtin-negate : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-negate (arg) (target) (st) (arities) =
   let na = bab-alloc st "_negate"
   in let nr = bab-emit-to-store arg (na.col) (na.state) arities
   in BabEmitResult {
    text = nr.text & "N000\nL" & bab-format-col (na.col) & "\n-\nS" & bab-format-col target & "\n",
    state = nr.state
   }

  bab-emit-builtin-abs : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-abs (arg) (target) (st) (arities) =
   let aa = bab-alloc st "_abs"
   in let ar = bab-emit-to-store arg (aa.col) (aa.state) arities
   in let l1r = bab-next-label (ar.state)
   in let l2r = bab-next-label (l1r.state)
   in BabEmitResult {
    text = ar.text &
     "L" & bab-format-col (aa.col) & "\nS" & bab-format-col target & "\n" &
     "L" & bab-format-col (aa.col) & "\n" &
     "CF LABEL_" & integer-to-text (l1r.col) & "\n" &
     "CB LABEL_" & integer-to-text (l2r.col) & "\n" &
     "LABEL_" & integer-to-text (l1r.col) & ":\n" &
     "N000\nL" & bab-format-col (aa.col) & "\n-\nS" & bab-format-col target & "\n" &
     "LABEL_" & integer-to-text (l2r.col) & ":\n",
    state = l2r.state
   }

  bab-emit-builtin-min : IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-min (a) (b) (target) (st) (arities) =
   let la = bab-alloc st "_min_a"
   in let ra = bab-alloc (la.state) "_min_b"
   in let lr = bab-emit-to-store a (la.col) (ra.state) arities
   in let rr = bab-emit-to-store b (ra.col) (lr.state) arities
   in let l1r = bab-next-label (rr.state)
   in let l2r = bab-next-label (l1r.state)
   in BabEmitResult {
    text = lr.text & rr.text &
     "L" & bab-format-col (la.col) & "\nL" & bab-format-col (ra.col) & "\n-\n" &
     "CF LABEL_" & integer-to-text (l1r.col) & "\n" &
     "L" & bab-format-col (la.col) & "\nS" & bab-format-col target & "\n" &
     "CB LABEL_" & integer-to-text (l2r.col) & "\n" &
     "LABEL_" & integer-to-text (l1r.col) & ":\n" &
     "L" & bab-format-col (ra.col) & "\nS" & bab-format-col target & "\n" &
     "LABEL_" & integer-to-text (l2r.col) & ":\n",
    state = l2r.state
   }

  bab-emit-builtin-max : IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-builtin-max (a) (b) (target) (st) (arities) =
   let la = bab-alloc st "_max_a"
   in let ra = bab-alloc (la.state) "_max_b"
   in let lr = bab-emit-to-store a (la.col) (ra.state) arities
   in let rr = bab-emit-to-store b (ra.col) (lr.state) arities
   in let l1r = bab-next-label (rr.state)
   in let l2r = bab-next-label (l1r.state)
   in BabEmitResult {
    text = lr.text & rr.text &
     "L" & bab-format-col (la.col) & "\nL" & bab-format-col (ra.col) & "\n-\n" &
     "CF LABEL_" & integer-to-text (l1r.col) & "\n" &
     "L" & bab-format-col (ra.col) & "\nS" & bab-format-col target & "\n" &
     "CB LABEL_" & integer-to-text (l2r.col) & "\n" &
     "LABEL_" & integer-to-text (l1r.col) & ":\n" &
     "L" & bab-format-col (la.col) & "\nS" & bab-format-col target & "\n" &
     "LABEL_" & integer-to-text (l2r.col) & ":\n",
    state = l2r.state
   }

  bab-emit-builtin-mod : IRExpr, IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
 This is the TRUNCATING remainder -- a - (a / b) * b -- and int-mod's
 contract is the Euclidean one, which is never negative. Every other
 plug was corrected to Euclidean on 2026-07-22; this one was not, and
 the reason is a property of the target rather than an oversight.

 The correction needs "if the remainder came back negative, add the
 divisor's magnitude", and this emitter cannot express that test.
 `bab-bin-op-card` maps IrEq, IrNotEq, IrLt, IrGt, IrLtEq and IrGtEq
 ALL to the single `-` card, so a comparison here is a subtraction and
 nothing distinguishes "is negative" from "is zero". Writing the branch
 anyway would mean inventing a polarity for `CF` that no card in this
 file establishes, in a deck no machine executes.

 So the divergence is confined and written down: int-mod on this target
 answers the sign of the dividend, and is correct only where the
 dividend is non-negative. Giving the Analytical Engine real relational
 operators is the prerequisite, and it would fix every `if` in every
 emitted deck, not only this one.

  bab-emit-builtin-mod (a) (b) (target) (st) (arities) =
   let la = bab-alloc st "_mod_a"
   in let ra = bab-alloc (la.state) "_mod_b"
   in let qa = bab-alloc (ra.state) "_mod_q"
   in let lr = bab-emit-to-store a (la.col) (qa.state) arities
   in let rr = bab-emit-to-store b (ra.col) (lr.state) arities
   in BabEmitResult {
    text = lr.text & rr.text &
     "L" & bab-format-col (la.col) & "\nL" & bab-format-col (ra.col) & "\n/\n" &
     "S" & bab-format-col (qa.col) & "\n" &
     "L" & bab-format-col (qa.col) & "\nL" & bab-format-col (ra.col) & "\n*\n" &
     "S" & bab-format-col (qa.col) & "\n" &
     "L" & bab-format-col (la.col) & "\nL" & bab-format-col (qa.col) & "\n-\n" &
     "S" & bab-format-col target & "\n",
    state = rr.state
   }

  bab-bin-op-card : IRBinaryOp -> Text
  bab-bin-op-card (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrPowInt | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "%"
    is IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> "-"
    is IrApproxEq | IrApproxEqExact -> "-"
    is IrAnd -> "*"
    is IrOr | IrAppendText | IrAppendList | IrConsList -> "+"

Section: List, Match, Act, Record Emission

  bab-emit-list-to-store : List IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-list-to-store (es) (target) (st) (arities) =
   if list-length es == 0 then BabEmitResult {
    text = ". empty list\nN000\nS" & bab-format-col target & "\n",
    state = st
   }
   else bab-emit-list-elems es target st arities 0

  bab-emit-list-elems : List IRExpr, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-list-elems (es) (target) (st) (arities) (i) =
   if i >= list-length es then BabEmitResult { text = "", state = st }
   else let ea = bab-alloc st ("_list_" & integer-to-text i)
   in let er = bab-emit-to-store (list-at es i) (ea.col) (ea.state) arities
   in let rest = bab-emit-list-elems es target (er.state) arities (i + 1)
   in BabEmitResult {
    text = er.text & rest.text,
    state = rest.state
   }

  bab-emit-match-to-store : IRExpr, List IRBranch, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-match-to-store (scrut) (branches) (target) (st) (arities) =
   let sa = bab-alloc st "_match_scrut"
   in let sr = bab-emit-to-store scrut (sa.col) (sa.state) arities
   in let end-lr = bab-next-label (sr.state)
   in let arms = bab-emit-match-arms branches (sa.col) target (end-lr.state) arities (end-lr.col)
   in BabEmitResult {
    text = sr.text & arms.text & "LABEL_" & integer-to-text (end-lr.col) & ":\n",
    state = arms.state
   }

  bab-emit-match-arms : List IRBranch, Integer, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-match-arms (branches) (scrut-col) (target) (st) (arities) (end-label) =
   bab-emit-match-arms-loop branches scrut-col target st arities end-label 0

  bab-emit-match-arms-loop : List IRBranch, Integer, Integer, BabState, List ArityEntry, Integer, Integer -> BabEmitResult
  bab-emit-match-arms-loop (branches) (scrut-col) (target) (st) (arities) (end-label) (i) =
   if i >= list-length branches then BabEmitResult { text = "", state = st }
   else let b = list-at branches i
   in let is-last = i == list-length branches - 1
   in let arm = bab-emit-match-one-arm b scrut-col target st arities end-label is-last
   in let rest = bab-emit-match-arms-loop branches scrut-col target (arm.state) arities end-label (i + 1)
   in BabEmitResult { text = arm.text & rest.text, state = rest.state }

  bab-emit-match-one-arm : IRBranch, Integer, Integer, BabState, List ArityEntry, Integer, Boolean -> BabEmitResult
  bab-emit-match-one-arm (b) (scrut-col) (target) (st) (arities) (end-label) (is-last) =
   when b.pattern
    is IrWildPat (sp) -> bab-emit-to-store (b.body) target st arities
    is IrVarPat (name) (ty) (sp) ->
     let va = bab-alloc st name
     in let bind-text = "L" & bab-format-col scrut-col & "\nS" & bab-format-col (va.col) & "\n"
     in let body-r = bab-emit-to-store (b.body) target (va.state) arities
     in BabEmitResult {
      text = bind-text & body-r.text,
      state = body-r.state
     }
    is IrLitPat (val) (ty) (sp) ->
     let skip-lr = bab-next-label st
     in let body-r = bab-emit-to-store (b.body) target (skip-lr.state) arities
     in BabEmitResult {
      text = "L" & bab-format-col scrut-col & "\nN" & bab-format-col (bab-parse-lit-val val) & "\n-\n" &
       "CF LABEL_" & integer-to-text (skip-lr.col) & "\n" &
       body-r.text &
       "CB LABEL_" & integer-to-text end-label & "\n" &
       "LABEL_" & integer-to-text (skip-lr.col) & ":\n",
      state = body-r.state
     }
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-last then bab-emit-to-store (b.body) target st arities
     else let skip-lr = bab-next-label st
     in let body-r = bab-emit-to-store (b.body) target (skip-lr.state) arities
     in BabEmitResult {
      text = ". match ctor " & name & "\n" &
       body-r.text &
       "CB LABEL_" & integer-to-text end-label & "\n" &
       "LABEL_" & integer-to-text (skip-lr.col) & ":\n",
      state = body-r.state
     }
    is IrVecPat (pats) (ty) (sp) -> bab-emit-to-store (b.body) target st arities

  bab-parse-lit-val : Text -> Integer
  bab-parse-lit-val (s) =
   if s == "True" then 1
   else if s == "False" then 0
   else 0

  bab-emit-act-to-store : List IRActStmt, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-act-to-store (stmts) (target) (st) (arities) =
   bab-emit-act-stmts-loop stmts target st arities 0

  bab-emit-act-stmts-loop : List IRActStmt, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-act-stmts-loop (stmts) (target) (st) (arities) (i) =
   if i >= list-length stmts then BabEmitResult {
    text = "",
    state = st
   }
   else let s = list-at stmts i
   in let sa = bab-alloc st ("_act_" & integer-to-text i)
   in let sr = bab-emit-act-one-stmt s (sa.col) (sa.state) arities
   in let rest = bab-emit-act-stmts-loop stmts target (sr.state) arities (i + 1)
   in BabEmitResult {
    text = sr.text & rest.text,
    state = rest.state
   }

  bab-emit-act-one-stmt : IRActStmt, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-act-one-stmt (s) (target) (st) (arities) =
   when s
    is IrDoBind (name) (ty) (val) (sp) ->
     let ba = bab-alloc st name
     in bab-emit-to-store val (ba.col) (ba.state) arities
    is IrDoExec (e) (sp) -> bab-emit-to-store e target st arities

  bab-emit-record-to-store : List IRFieldVal, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-record-to-store (fields) (target) (st) (arities) =
   bab-emit-record-fields fields target st arities 0

  bab-emit-record-fields : List IRFieldVal, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-record-fields (fields) (target) (st) (arities) (i) =
   if i >= list-length fields then BabEmitResult { text = "", state = st }
   else let f = list-at fields i
   in let fa = bab-alloc st ("_field_" & f.name)
   in let fr = bab-emit-to-store (f.value) (fa.col) (fa.state) arities
   in let rest = bab-emit-record-fields fields target (fr.state) arities (i + 1)
   in BabEmitResult { text = fr.text & rest.text, state = rest.state }

Section: Tail Call Optimization

  bab-is-self-call : IRExpr, Text -> Boolean
  bab-is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in when chain.root
    is IrName (n) (ty) (sp) -> n == func-name
    is IrLambda (ps) (body) (ty) (sp) -> False
    is IrIntLit (v) (sp) -> False
    is IrNumLit (v) (sp) -> False
    is IrTextLit (v) (sp) -> False
    is IrBoolLit (v) (sp) -> False
    is IrCharLit (v) (sp) -> False
    is IrBinary (op) (l) (r) (ty) (sp) -> False
    is IrNegate (x) (nty) (sp) -> False
    is IrIf (c) (t) (el) (ty) (sp) -> False
    is IrLet (n) (ty) (v) (b) (sp) -> False
    is IrApply (f) (a) (ty) (sp) -> False
    is IrList (es) (ty) (sp) -> False
    is IrMatch (sc) (bs) (ty) (sp) -> False
    is IrAct (ss) (ty) (sp) -> False
    is IrHandle (eff) (h) (cs) (ty) (sp) -> False
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> False
    is IrRecord (n) (fs) (ty) (sp) -> False
    is IrFieldAccess (r) (f) (ty) (sp) -> False
    is IrFieldStore (r) (f) (v) (ty) (sp) -> False
    is IrFork (body) (ty) (sp) -> False
    is IrAwait (task) (ty) (sp) -> False
    is IrTry (mx) (bd) (fb) (fs) (ty) (sp) -> False
    is IrError (m) (ty) (sp) -> False

  bab-has-tail-call : IRExpr, Text -> Boolean
  bab-has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> bab-has-tail-call t func-name | bab-has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> bab-has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> bab-has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> bab-is-self-call e func-name
    is IrIntLit (v) (sp) -> False
    is IrNumLit (v) (sp) -> False
    is IrTextLit (v) (sp) -> False
    is IrBoolLit (v) (sp) -> False
    is IrCharLit (v) (sp) -> False
    is IrName (n) (ty) (sp) -> False
    is IrBinary (op) (l) (r) (ty) (sp) -> False
    is IrNegate (x) (nty) (sp) -> False
    is IrLambda (ps) (body) (ty) (sp) -> False
    is IrList (es) (ty) (sp) -> False
    is IrAct (ss) (ty) (sp) -> False
    is IrHandle (eff) (h) (cs) (ty) (sp) -> False
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> False
    is IrRecord (n) (fs) (ty) (sp) -> False
    is IrFieldAccess (r) (f) (ty) (sp) -> False
    is IrFieldStore (r) (f) (v) (ty) (sp) -> False
    is IrFork (body) (ty) (sp) -> False
    is IrAwait (task) (ty) (sp) -> False
    is IrTry (mx) (bd) (fb) (fs) (ty) (sp) -> False
    is IrError (m) (ty) (sp) -> False

  bab-has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  bab-has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if bab-has-tail-call (b.body) func-name then True
      else bab-has-tail-call-branches branches func-name (i + 1)

  bab-should-tco : IRDef -> Boolean
  bab-should-tco (d) =
   if list-length (d.params) == 0 then False
   else bab-has-tail-call (d.body) (d.name)

  bab-emit-tco-body : IRExpr, Text, List IRParam, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-tco-body (e) (func-name) (params) (result-col) (st) (arities) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     let ca = bab-alloc st "_tco_cond"
     in let cr = bab-emit-to-store c (ca.col) (ca.state) arities
     in let l1r = bab-next-label (cr.state)
     in let l2r = bab-next-label (l1r.state)
     in let tr = bab-emit-tco-body t func-name params result-col (l2r.state) arities
     in let er = bab-emit-tco-body el func-name params result-col (tr.state) arities
     in BabEmitResult {
      text = cr.text & "L" & bab-format-col (ca.col) & "\n" &
       "CF LABEL_" & integer-to-text (l1r.col) & "\n" &
       tr.text &
       "CB LABEL_" & integer-to-text (l2r.col) & "\n" &
       "LABEL_" & integer-to-text (l1r.col) & ":\n" &
       er.text &
       "LABEL_" & integer-to-text (l2r.col) & ":\n",
      state = er.state
     }
    is IrLet (lname) (ty) (val) (body) (sp) ->
     let la = bab-alloc st lname
     in let vr = bab-emit-to-store val (la.col) (la.state) arities
     in bab-emit-tco-body body func-name params result-col (vr.state) arities
    is IrMatch (scrut) (branches) (mty) (sp) ->
     let sa = bab-alloc st "_tco_match"
     in let sr = bab-emit-to-store scrut (sa.col) (sa.state) arities
     in let end-lr = bab-next-label (sr.state)
     in let arms = bab-emit-tco-match-arms branches func-name params result-col (sa.col) (end-lr.state) arities (end-lr.col)
     in BabEmitResult {
      text = sr.text & arms.text & "LABEL_" & integer-to-text (end-lr.col) & ":\n",
      state = arms.state
     }
    is IrApply (f) (a) (rty) (sp) ->
     if bab-is-self-call e func-name then bab-emit-tco-jump e func-name params st arities
     else let r = bab-emit-to-store e result-col st arities
     in BabEmitResult {
      text = r.text,
      state = r.state
     }
    is IrIntLit (v) (sp) -> bab-emit-to-store e result-col st arities
    is IrNumLit (v) (sp) -> bab-emit-to-store e result-col st arities
    is IrTextLit (v) (sp) -> bab-emit-to-store e result-col st arities
    is IrBoolLit (v) (sp) -> bab-emit-to-store e result-col st arities
    is IrCharLit (v) (sp) -> bab-emit-to-store e result-col st arities
    is IrName (n) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrBinary (op) (l) (r) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrNegate (x) (nty) (sp) -> bab-emit-to-store e result-col st arities
    is IrLambda (ps) (body) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrList (es) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrAct (ss) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrHandle (eff) (h) (cs) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrRecord (rn) (fs) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrFieldAccess (rec) (f) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrFieldStore (rec) (f) (v) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrFork (body) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrAwait (task) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrTry (mx) (bd) (fb) (fs) (ty) (sp) -> bab-emit-to-store e result-col st arities
    is IrError (m) (ty) (sp) -> bab-emit-to-store e result-col st arities

  bab-emit-tco-match-arms : List IRBranch, Text, List IRParam, Integer, Integer, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-tco-match-arms (branches) (func-name) (params) (result-col) (scrut-col) (st) (arities) (end-label) =
   bab-emit-tco-match-arms-loop branches func-name params result-col scrut-col st arities end-label 0

  bab-emit-tco-match-arms-loop : List IRBranch, Text, List IRParam, Integer, Integer, BabState, List ArityEntry, Integer, Integer -> BabEmitResult
  bab-emit-tco-match-arms-loop (branches) (func-name) (params) (result-col) (scrut-col) (st) (arities) (end-label) (i) =
   if i >= list-length branches then BabEmitResult { text = "", state = st }
   else let b = list-at branches i
   in let is-last = i == list-length branches - 1
   in let arm = bab-emit-tco-match-one-arm b func-name params result-col scrut-col st arities end-label is-last
   in let rest = bab-emit-tco-match-arms-loop branches func-name params result-col scrut-col (arm.state) arities end-label (i + 1)
   in BabEmitResult { text = arm.text & rest.text, state = rest.state }

  bab-emit-tco-match-one-arm : IRBranch, Text, List IRParam, Integer, Integer, BabState, List ArityEntry, Integer, Boolean -> BabEmitResult
  bab-emit-tco-match-one-arm (b) (func-name) (params) (result-col) (scrut-col) (st) (arities) (end-label) (is-last) =
   when b.pattern
    is IrWildPat (sp) -> bab-emit-tco-body (b.body) func-name params result-col st arities
    is IrVarPat (name) (ty) (sp) ->
     let va = bab-alloc st name
     in let bind-text = "L" & bab-format-col scrut-col & "\nS" & bab-format-col (va.col) & "\n"
     in let body-r = bab-emit-tco-body (b.body) func-name params result-col (va.state) arities
     in BabEmitResult {
      text = bind-text & body-r.text,
      state = body-r.state
     }
    is IrLitPat (val) (ty) (sp) ->
     let skip-lr = bab-next-label st
     in let body-r = bab-emit-tco-body (b.body) func-name params result-col (skip-lr.state) arities
     in BabEmitResult {
      text = "L" & bab-format-col scrut-col & "\nN" & bab-format-col (bab-parse-lit-val val) & "\n-\n" &
       "CF LABEL_" & integer-to-text (skip-lr.col) & "\n" &
       body-r.text &
       "CB LABEL_" & integer-to-text end-label & "\n" &
       "LABEL_" & integer-to-text (skip-lr.col) & ":\n",
      state = body-r.state
     }
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-last then bab-emit-tco-body (b.body) func-name params result-col st arities
     else let skip-lr = bab-next-label st
     in let body-r = bab-emit-tco-body (b.body) func-name params result-col (skip-lr.state) arities
     in BabEmitResult {
      text = ". match ctor " & name & "\n" &
       body-r.text &
       "CB LABEL_" & integer-to-text end-label & "\n" &
       "LABEL_" & integer-to-text (skip-lr.col) & ":\n",
      state = body-r.state
     }
    is IrVecPat (pats) (ty) (sp) -> bab-emit-tco-body (b.body) func-name params result-col st arities

  bab-emit-tco-jump : IRExpr, Text, List IRParam, BabState, List ArityEntry -> BabEmitResult
  bab-emit-tco-jump (e) (func-name) (params) (st) (arities) =
   let chain = collect-apply-chain e []
   in bab-emit-tco-move-args (chain.args) params st arities 0

  bab-emit-tco-move-args : List IRExpr, List IRParam, BabState, List ArityEntry, Integer -> BabEmitResult
  bab-emit-tco-move-args (args) (params) (st) (arities) (i) =
   if i >= list-length args then BabEmitResult { text = "CB TCO_LOOP\n", state = st }
   else if i >= list-length params then BabEmitResult { text = "CB TCO_LOOP\n", state = st }
   else let p = list-at params i
   in let pa = bab-lookup-store (st.store-map) (p.name)
   in let ta = bab-alloc st ("_tco_tmp_" & integer-to-text i)
   in let ar = bab-emit-to-store (list-at args i) (ta.col) (ta.state) arities
   in let rest = bab-emit-tco-move-args args params (ar.state) arities (i + 1)
   in BabEmitResult {
    text = ar.text & "L" & bab-format-col (ta.col) & "\nS" & bab-format-col pa & "\n" & rest.text,
    state = rest.state
   }

Section: Definition Emission

  bab-emit-def : IRDef, BabState, List ArityEntry -> BabEmitResult
  bab-emit-def (d) (st) (arities) =
   let header = ". === FUNCTION: " & d.name & " ===\n"
   in let st2 = bab-alloc-params (d.params) st 0
   in let ra = bab-alloc (st2.state) ("_result_" & d.name)
   in if bab-should-tco d then
    let body = bab-emit-tco-body (d.body) (d.name) (d.params) (ra.col) (ra.state) arities
    in BabEmitResult {
     text = header & st2.text & "TCO_LOOP:\n" & body.text &
      ". Result of " & d.name & " in Store column " & integer-to-text (ra.col) & "\n",
     state = body.state
    }
   else let body = bab-emit-to-store (d.body) (ra.col) (ra.state) arities
   in BabEmitResult {
    text = header & st2.text & body.text & ". Result of " & d.name & " in Store column " & integer-to-text (ra.col) & "\n",
    state = body.state
   }

  BabParamResult = record {
   text : Text,
   state : BabState
  }

  bab-alloc-params : List IRParam, BabState, Integer -> BabParamResult
  bab-alloc-params (params) (st) (i) =
   if i == list-length params then BabParamResult { text = "", state = st }
   else let p = list-at params i
   in let a = bab-alloc st (p.name)
   in let rest = bab-alloc-params params (a.state) (i + 1)
   in BabParamResult {
    text = ". Param '" & p.name & "' in Store column " & integer-to-text (a.col) & "\n" & rest.text,
    state = rest.state
   }

Section: Chapter Emission

  bab-find-opening : List IRDef, Integer -> Integer
  bab-find-opening (defs) (i) =
   if i == list-length defs then -1
   else if (list-at defs i).name == "opening" then i
   else bab-find-opening defs (i + 1)

  bab-emit-non-opening-defs : List IRDef, Integer, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-non-opening-defs (defs) (i) (opening-idx) (st) (arities) =
   if i == list-length defs then BabEmitResult { text = "", state = st }
   else if i == opening-idx then bab-emit-non-opening-defs defs (i + 1) opening-idx st arities
   else let r = bab-emit-def (list-at defs i) st arities
   in let rest = bab-emit-non-opening-defs defs (i + 1) opening-idx (r.state) arities
   in BabEmitResult { text = r.text & "\n" & rest.text, state = rest.state }

  bab-emit-opening-body : IRExpr, Integer, BabState, List ArityEntry -> BabEmitResult
  bab-emit-opening-body (e) (target) (st) (arities) =
   when e
    is IrAct (stmts) (ty) (sp) -> bab-emit-act-to-store stmts target st arities
    is IrIntLit (v) (sp) -> bab-emit-to-store e target st arities
    is IrNumLit (v) (sp) -> bab-emit-to-store e target st arities
    is IrTextLit (v) (sp) -> bab-emit-to-store e target st arities
    is IrBoolLit (v) (sp) -> bab-emit-to-store e target st arities
    is IrCharLit (v) (sp) -> bab-emit-to-store e target st arities
    is IrName (n) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrBinary (op) (l) (r) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrNegate (x) (nty) (sp) -> bab-emit-to-store e target st arities
    is IrIf (c) (t) (el) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrLet (name) (ty) (val) (body) (sp) -> bab-emit-to-store e target st arities
    is IrApply (f) (a) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrLambda (ps) (body) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrList (es) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrMatch (scrut) (branches) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrRecord (rname) (fields) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrFieldAccess (rec) (field) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrFieldStore (rec) (field) (v) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrFork (body) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrAwait (task) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrTry (mx) (bd) (fb) (fs) (ty) (sp) -> bab-emit-to-store e target st arities
    is IrError (msg) (ty) (sp) -> bab-emit-to-store e target st arities

  emit-babbage-chapter : IRChapter, List ATypeDef -> Text
  emit-babbage-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let opening-idx = bab-find-opening (m.defs) 0
   in let st = bab-initial-state
   in let defs-result = bab-emit-non-opening-defs (m.defs) 0 opening-idx st arities
   in let main-part = if opening-idx >= 0 then let main-r = bab-emit-opening-body (list-at (m.defs) opening-idx).body 0 (defs-result.state) arities
                      in ". === MAIN PROGRAM ===\n" & main-r.text & "\nP\nL000\n\nH\n"
                      else if list-length (m.defs) == 0 then ". === MAIN PROGRAM ===\n. All proofs verified. No computation required.\n\nH\n"
                      else ". === MAIN PROGRAM ===\n. No entry point. Chapter loaded.\n\nH\n"
   in bab-header & emit-bab-type-defs type-defs 0 & defs-result.text & main-part

