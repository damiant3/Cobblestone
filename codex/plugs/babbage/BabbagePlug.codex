 Entry point for the Babbage Analytical Engine emit-plug.

Section: Body

  opening : [Console, FileSystem] Nothing = act
   source <- read-file ""
   let parsed = parse-ir-chapter source
   in let bab-text = emit-babbage-chapter (parsed.chapter) (parsed.type-defs)
   in print-line bab-text
  end

