Chapter: Electron Emitter

Section: Sanitization

  el-sanitize : Text -> Text
  el-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  el-slash-pos : Text, Integer, Integer -> Integer
  el-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else el-slash-pos f (i + 1) len

  el-field : Text -> Text
  el-field (f) =
   let slash = el-slash-pos f 0 (text-length f)
   in if slash >= 0 then el-sanitize (substring f 0 slash)
      else el-sanitize f

  el-escape : Text -> Text
  el-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

  el-indent : Integer -> Text
  el-indent (n) =
   if n <= 0 then ""
   else "  " & el-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0 - 1
      else let e = list-at entries pos
      in if e.name == name then e.arity else 0 - 1

Section: Expression Emission

  emit-el-name : Text, List ArityEntry -> Text
  emit-el-name (n) (arities) =
   if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then el-sanitize n
   else let ar = lookup-arity arities n
   in if ar == 0 then el-sanitize n & "()"
      else if ar >= 2 then emit-el-partial-wrappers 0 ar & el-sanitize n & "(" & emit-el-partial-params 0 ar & ")"
      else el-sanitize n

  emit-el-lambda-params : List IRParam, Integer -> Text
  emit-el-lambda-params (params) (i) =
   if i == list-length params then ""
   else "(" & el-sanitize (list-at params i).name & ") => " & emit-el-lambda-params params (i + 1)

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

  prelude-arities : Text -> List ArityEntry
  prelude-arities (src) = prelude-scan (text-split src "function ") 1 []

  prelude-scan : List Text, Integer, List ArityEntry -> List ArityEntry
  prelude-scan (parts) (i) (acc) =
   if i >= list-length parts then acc
   else prelude-scan parts (i + 1) (sorted-insert-arity acc (prelude-entry (list-at parts i)))

  prelude-entry : Text -> ArityEntry
  prelude-entry (part) =
   let open = prelude-pos part "(" 0
   in let close = prelude-pos part ")" open
   in let params = substring part (open + 1) (close - open - 1)
   in ArityEntry { name = prelude-name (substring part 0 open), arity = __narrow (if text-length params == 0 then 0 else list-length (text-split params ",")), generic-count = 0 }

  prelude-pos : Text, Text, Integer -> Integer
  prelude-pos (s) (ch) (i) =
   if i >= text-length s then i
   else if char-to-text (char-at s i) == ch then i
   else prelude-pos s ch (i + 1)

  prelude-name : Text -> Text
  prelude-name (n) =
   if text-starts-with n "__" then n else text-replace n "_" "-"

  emit-el-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-el-expr (e) (arities) (indent) =
   when e
    is IrIntLit (n) (sp) -> show n
    is IrNumLit (n) (sp) -> show n
    is IrTextLit (s) (sp) -> "\"" & el-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> "String.fromCharCode(" & show n & ")"
    is IrName (n) (ty) (sp) -> emit-el-name n arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-el-binary op l r arities indent
    is IrNegate (x) (nty) (sp) -> "(-(" & emit-el-expr x arities indent & "))"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-el-expr c arities indent & " ? " & emit-el-expr t arities indent & " : " & emit-el-expr el arities indent & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(() => { const " & el-sanitize name & " = " & emit-el-expr val arities indent & "; return " & emit-el-expr body arities indent & "; })()"
    is IrApply (f) (a) (ty) (sp) -> emit-el-apply e arities indent
    is IrLambda (params) (body) (ty) (sp) -> if list-length params == 0 then "(() => " & emit-el-expr body arities indent & ")" else "(" & emit-el-lambda-params params 0 & emit-el-expr body arities indent & ")"
    is IrList (elems) (ty) (sp) -> "[" & emit-el-list-elems elems arities indent 0 & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-el-match scrut branches arities indent
    is IrAct (stmts) (ty) (sp) -> emit-el-act stmts arities indent
    is IrRecord (name) (fields) (ty) (sp) -> "{ _type: \"" & name & "\"" & emit-el-record-fields fields arities indent 0 & " }"
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-el-expr rec arities indent & "." & el-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(" & emit-el-expr rec arities indent & "." & el-field field & " = " & emit-el-expr val arities indent & ")"
    is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => " & emit-el-expr body arities indent & ")"
    is IrAwait (task) (ty) (sp) -> "(await " & emit-el-expr task arities indent & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-el-expr body arities indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-el-expr body arities indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-el-act body arities indent
    is IrError (msg) (ty) (sp) -> "(() => { throw new Error(\"" & el-escape msg & "\"); })()"

Section: Binary Operators

  emit-el-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-el-binary (op) (l) (r) (arities) (indent) =
   let lhs = emit-el-expr l arities indent
   in let rhs = emit-el-expr r arities indent
   in when op
    is IrAddInt | IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt | IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt -> "Math.trunc(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "(" & lhs & " % " & rhs & ")"
    is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
    is IrAddVec -> "(" & lhs & ".map((v,i) => v + " & rhs & "[i]))"
    is IrSubVec -> "(" & lhs & ".map((v,i) => v - " & rhs & "[i]))"
    is IrMulVec -> "(" & lhs & ".map((v,i) => v * " & rhs & "[i]))"
    is IrDivVec -> "(" & lhs & ".map((v,i) => v / " & rhs & "[i]))"
    is IrEq -> "(" & lhs & " === " & rhs & ")"
    is IrNotEq -> "(" & lhs & " !== " & rhs & ")"
    is IrLt | IrLtVec -> "(" & lhs & " < " & rhs & ")"
    is IrGt | IrGtVec -> "(" & lhs & " > " & rhs & ")"
    is IrLtEq | IrLtEqVec -> "(" & lhs & " <= " & rhs & ")"
    is IrGtEq | IrGtEqVec -> "(" & lhs & " >= " & rhs & ")"
    is IrApproxEq | IrApproxEqExact -> "(" & lhs & " === " & rhs & ")"
    is IrAnd -> "(" & lhs & " && " & rhs & ")"
    is IrOr -> "(" & lhs & " || " & rhs & ")"
    is IrAppendText -> "(" & lhs & " + " & rhs & ")"
    is IrAppendList -> "([..." & lhs & ", ..." & rhs & "])"
    is IrConsList -> "[" & lhs & ", ..." & rhs & "]"

Section: Apply and Helpers

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-el-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-el-apply (e) (arities) (indent) =
   let chain = collect-apply-chain e []
   in let func = emit-el-expr (chain.root) arities indent
   in when (chain.root)
    is IrName (n) (ty) (sp) ->
     if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then el-sanitize n & "(" & emit-el-apply-args (chain.args) arities indent 0 & ")"
     else let ar = lookup-arity arities n
     in if ar < 0 then el-sanitize n & emit-el-apply-rest (chain.args) arities indent 0
        else if ar == 0 then el-sanitize n & "()" & emit-el-apply-rest (chain.args) arities indent 0
        else emit-el-apply-split (el-sanitize n) (chain.args) ar arities indent
    is otherwise -> "(" & func & ")" & emit-el-apply-rest (chain.args) arities indent 0

  emit-el-apply-split : Text, List IRExpr, Integer, List ArityEntry, Integer -> Text
  emit-el-apply-split (func) (args) (ar) (arities) (indent) =
   if ar > 0 & list-length args > ar
   then func & "(" & emit-el-apply-args (list-take args ar) arities indent 0 & ")" & emit-el-apply-rest (list-drop args ar) arities indent 0
   else if ar > 0 & list-length args > 0 & list-length args < ar
   then emit-el-partial-wrappers 0 (ar - list-length args) & func & "(" & emit-el-apply-args args arities indent 0 & ", " & emit-el-partial-params 0 (ar - list-length args) & ")"
   else func & "(" & emit-el-apply-args args arities indent 0 & ")"

  emit-el-partial-wrappers : Integer, Integer -> Text
  emit-el-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & show i & "_) => " & emit-el-partial-wrappers (i + 1) count

  emit-el-partial-params : Integer, Integer -> Text
  emit-el-partial-params (i) (count) =
   if i == count then ""
   else (if i > 0 then ", " else "") & "_p" & show i & "_" & emit-el-partial-params (i + 1) count

  emit-el-apply-rest : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-el-apply-rest (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else "(" & emit-el-expr (list-at args i) arities indent & ")" & emit-el-apply-rest args arities indent (i + 1)

  emit-el-apply-args : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-el-apply-args (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-el-expr (list-at args i) arities indent & emit-el-apply-args args arities indent (i + 1)

  emit-el-params : List IRParam, Integer -> Text
  emit-el-params (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & el-sanitize (list-at params i).name & emit-el-params params (i + 1)

  emit-el-list-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-el-list-elems (elems) (arities) (indent) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-el-expr (list-at elems i) arities indent & emit-el-list-elems elems arities indent (i + 1)

  emit-el-record-fields : List IRFieldVal, List ArityEntry, Integer, Integer -> Text
  emit-el-record-fields (fields) (arities) (indent) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ", " & el-sanitize (f.name) & ": " & emit-el-expr (f.value) arities indent & emit-el-record-fields fields arities indent (i + 1)

Section: Match

  emit-el-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-el-match (scrut) (branches) (arities) (indent) =
   "(() => { const _s = " & emit-el-expr scrut arities indent & "; " & emit-el-branches branches arities indent 0 & " })()"

  emit-el-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-el-branches (branches) (arities) (indent) (i) =
   if i == list-length branches then "throw new Error('non-exhaustive match');"
   else let b = list-at branches i
   in let cond = emit-el-pat-cond (b.pattern) "_s"
   in let binds = emit-el-pat-binds (b.pattern) "_s"
   in let body = emit-el-expr (b.body) arities indent
   in let ret = if el-guard-trivial (b.guard) then "return " & body & "; "
                else "if (" & emit-el-expr (b.guard) arities indent & ") { return " & body & "; } "
   in "if (" & cond & ") { " & binds & ret & "} " & emit-el-branches branches arities indent (i + 1)

 A guarded arm must not chain with else: the guard needs the pattern
 bindings, which sit inside the block, so a failed guard has to fall OUT
 of the block and reach the next test.

  el-guard-trivial : IRExpr -> Boolean
  el-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  emit-el-pat-cond : IRPat, Text -> Text
  emit-el-pat-cond (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "true"
    is IrLitPat (text) (ty) (sp) -> scrut & " === " & text
    is IrCtorPat (name) (subs) (ty) (sp) -> scrut & "._tag === \"" & name & "\""
    is IrWildPat (sp) -> "true"
    is IrVecPat (pats) (ty) (sp) -> "true"

  emit-el-pat-binds : IRPat, Text -> Text
  emit-el-pat-binds (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "const " & el-sanitize name & " = " & scrut & "; "
    is IrLitPat (text) (ty) (sp) -> ""
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-el-ctor-binds subs scrut 0
    is IrWildPat (sp) -> ""
    is IrVecPat (pats) (ty) (sp) -> ""

  emit-el-ctor-binds : List IRPat, Text, Integer -> Text
  emit-el-ctor-binds (subs) (scrut) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in let access = scrut & "._" & show i
   in emit-el-pat-binds sub access & emit-el-ctor-binds subs scrut (i + 1)

Section: Act Blocks

  emit-el-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-el-act (stmts) (arities) (indent) =
   "(() => {\n" & emit-el-act-stmts stmts arities (indent + 1) 0 & el-indent indent & "})()"

  emit-el-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-el-act-stmts (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in when s
    is IrDoBind (name) (ty) (val) (sp) -> el-indent indent & "const " & el-sanitize name & " = " & emit-el-expr val arities indent & ";\n" & emit-el-act-stmts stmts arities indent (i + 1)
    is IrDoExec (e) (sp) ->
     if is-last then el-indent indent & "return " & emit-el-expr e arities indent & ";\n"
     else el-indent indent & emit-el-expr e arities indent & ";\n" & emit-el-act-stmts stmts arities indent (i + 1)

Section: Type Definitions

  emit-el-type-def : ATypeDef -> Text
  emit-el-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     "function " & el-sanitize (name.value) & "(fields) { return { _type: \"" & name.value & "\", ...fields }; }\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-el-variant-ctors ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-el-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-el-variant-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in let ctor-text = if n == 0 then "const " & el-sanitize (c.name.value) & " = { _tag: \"" & c.name.value & "\" };\n"
      else "function " & el-sanitize (c.name.value) & "(" & emit-el-ctor-params n 0 & ") { return { _tag: \"" & c.name.value & "\"" & emit-el-ctor-fields n 0 & " }; }\n"
   in ctor-text & emit-el-variant-ctors ctors (i + 1)

  emit-el-ctor-params : Integer, Integer -> Text
  emit-el-ctor-params (n) (i) =
   if i == n then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "_" & show i & emit-el-ctor-params n (i + 1)

  emit-el-ctor-fields : Integer, Integer -> Text
  emit-el-ctor-fields (n) (i) =
   if i == n then ""
   else ", _" & show i & ": _" & show i & emit-el-ctor-fields n (i + 1)

Section: Definition Emission

  emit-el-def : IRDef, List ArityEntry -> Text
  emit-el-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else let sname = el-sanitize (d.name)
   in if list-length (d.params) == 0
      then "function " & sname & "() {\n  return " & emit-el-expr (d.body) arities 1 & ";\n}\n\n"
      else "function " & sname & "(" & emit-el-params (d.params) 0 & ") {\n  return " & emit-el-expr (d.body) arities 1 & ";\n}\n\n"

  emit-el-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-el-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-el-def (list-at defs i) arities & emit-el-defs defs (i + 1) arities

  emit-el-type-defs : List ATypeDef, Integer -> Text
  emit-el-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-el-type-def (list-at tds i) & emit-el-type-defs tds (i + 1)

Section: Electron App Assembly

  emit-electron-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-electron-chapter (m) (meta) (type-defs) =
   let title = if meta.chapter-title == "" then "App" else meta.chapter-title
   in let builtins = "function __narrow(n) { return n; }\nfunction print_line_uni(s) { const el = document.createElement('div'); el.textContent = s; document.getElementById('app').appendChild(el); }\nfunction show(n) { return String(n); }\nfunction text_length(s) { return s.length; }\nfunction text_replace(s, a, b) { return a.length === 0 ? s : s.split(a).join(b); }\nfunction text_compare(a, b) { return a < b ? -1 : a > b ? 1 : 0; }\nfunction list_length(xs) { return xs.length; }\nfunction list_at(xs, i) { return xs[i]; }\nfunction integer_to_text(n) { return String(n); }\nfunction negate(n) { return -n; }\nfunction text_starts_with(s, p) { return s.startsWith(p); }\nfunction text_contains(s, sub) { return s.includes(sub); }\nfunction text_split(s, sep) { return sep.length === 0 ? [s] : s.split(sep); }\nfunction text_to_integer(s) { let t = String(s); let i = 0; let neg = false; if (t.charAt(0) === '-') { neg = true; i = 1; } let v = 0; while (i < t.length && t.charAt(i) >= '0' && t.charAt(i) <= '9') { v = v * 10 + (t.charCodeAt(i) - 48); i = i + 1; } return neg ? -v : v; }\function char_code(c) { return typeof c === 'string' ? c.charCodeAt(0) : c; }\nfunction char_at(s, i) { return s[i]; }\nfunction list_snoc(xs, v) { if (xs.length > 0) { xs.push(v); return xs; } return [v]; }\nfunction list_push(xs, v) { return list_snoc(xs, v); }\n\n"
   in let arities = build-arity-map (m.defs) 0 (prelude-arities builtins)
   in let types-text = emit-el-type-defs type-defs 0
   in let defs-text = emit-el-defs (m.defs) 0 arities
   in let renderer-js = builtins & types-text & defs-text & "try { opening(); } catch(e) { console.error(e); }\n"
   in let main-js = "const { app, BrowserWindow } = require('electron');\nfunction createWindow() {\n  const win = new BrowserWindow({ width: 800, height: 600, webPreferences: { nodeIntegration: true, contextIsolation: false } });\n  win.loadFile('index.html');\n}\napp.whenReady().then(createWindow);\napp.on('window-all-closed', () => { if (process.platform !== 'darwin') app.quit(); });\n"
   in let index-html = "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><title>" & el-escape title & "</title>\n<style>body { font-family: system-ui, sans-serif; padding: 1rem; background: #1a1a2e; color: #e0e0e0; }</style>\n</head>\n<body><div id=\"app\"></div>\n<script>\n" & renderer-js & "</script>\n</body>\n</html>\n"
   in "// === main.js ===\n" & main-js & "\n// === index.html ===\n" & index-html

Page 1
