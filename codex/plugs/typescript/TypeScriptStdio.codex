Chapter: TypeScriptStdio

Section: Body

  ts-stream-defs : List IRDef, Integer, Integer, List ArityEntry -> [Console] Nothing
  ts-stream-defs (defs) (i) (len) (arities) =
   if i >= len then print-uni ""
   else let h = __heap-save
   in let s = emit-ts-def (list-at defs i) arities
   in act
    print-uni s
    let r = __heap-restore h
    in ts-stream-defs defs (i + 1) len arities
   end

  plug-emit-ir-stream : Text -> [Console] Nothing
  plug-emit-ir-stream (ir-text) =
   let parsed = parse-ir-chapter ir-text
   in let m = parsed.chapter
   in let arities = build-arity-map (m.defs) 0 (prelude-arities ts-builtins-text)
   in act
    print-uni ts-builtins-text
    print-uni ("const __clamps: any = {\n" & ts-clamp-table (parsed.type-defs) 0 & "};\n\n")
    print-uni (emit-ts-type-defs (parsed.type-defs) 0)
    ts-stream-defs (m.defs) 0 (list-length (m.defs)) arities
    print-line-uni ts-entry-text
   end
