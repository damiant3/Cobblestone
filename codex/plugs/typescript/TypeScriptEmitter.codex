Chapter: TypeScript Emitter

Section: Sanitization

  ts-sanitize : Text -> Text
  ts-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  ts-slash-pos : Text, Integer, Integer -> Integer
  ts-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else ts-slash-pos f (i + 1) len

  ts-field : Text -> Text
  ts-field (f) =
   let slash = ts-slash-pos f 0 (text-length f)
   in if slash >= 0 then ts-sanitize (substring f 0 slash)
      else ts-sanitize f

  ts-escape : Text -> Text
  ts-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

  ts-indent : Integer -> Text
  ts-indent (n) =
   if n <= 0 then ""
   else "  " & ts-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0 - 1
      else let e = list-at entries pos
      in if e.name == name then e.arity else 0 - 1

Section: Expression Emission

  emit-ts-name : Text, List ArityEntry -> Text
  emit-ts-name (n) (arities) =
   if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then ts-sanitize n
   else let ar = lookup-arity arities n
   in if ar == 0 then ts-sanitize n & "()"
      else if ar >= 2 then emit-ts-partial-wrappers 0 ar & ts-sanitize n & "(" & emit-ts-partial-params 0 ar & ")"
      else ts-sanitize n

  emit-ts-lambda-params : List IRParam, Integer -> Text
  emit-ts-lambda-params (params) (i) =
   if i == list-length params then ""
   else "(" & ts-sanitize (list-at params i).name & ": any) => " & emit-ts-lambda-params params (i + 1)

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

  prelude-arities : Text -> List ArityEntry
  prelude-arities (src) = prelude-scan (text-split src "function ") 1 []

  prelude-scan : List Text, Integer, List ArityEntry -> List ArityEntry
  prelude-scan (parts) (i) (acc) =
   if i >= list-length parts then acc
   else prelude-scan parts (i + 1) (sorted-insert-arity acc (prelude-entry (list-at parts i)))

  prelude-entry : Text -> ArityEntry
  prelude-entry (part) =
   let open = prelude-pos part "(" 0
   in let close = prelude-pos part ")" open
   in let params = substring part (open + 1) (close - open - 1)
   in ArityEntry { name = prelude-name (substring part 0 open), arity = __narrow (if text-length params == 0 then 0 else list-length (text-split params ",")), generic-count = 0 }

  prelude-pos : Text, Text, Integer -> Integer
  prelude-pos (s) (ch) (i) =
   if i >= text-length s then i
   else if char-to-text (char-at s i) == ch then i
   else prelude-pos s ch (i + 1)

  prelude-name : Text -> Text
  prelude-name (n) =
   if text-starts-with n "__" then n else text-replace n "_" "-"

  emit-ts-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-ts-expr (e) (arities) (indent) =
   when e
    is IrIntLit (n) (sp) -> show n
    is IrNumLit (n) (sp) -> show n
    is IrTextLit (s) (sp) -> "\"" & ts-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> "String.fromCharCode(" & show n & ")"
    is IrName (n) (ty) (sp) -> emit-ts-name n arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-ts-binary op l r arities indent
    is IrNegate (x) (nty) (sp) -> "(-(" & emit-ts-expr x arities indent & "))"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-ts-expr c arities indent & " ? " & emit-ts-expr t arities indent & " : " & emit-ts-expr el arities indent & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(() => { const " & ts-sanitize name & " = " & emit-ts-expr val arities indent & "; return " & emit-ts-expr body arities indent & "; })()"
    is IrApply (f) (a) (ty) (sp) -> emit-ts-apply e arities indent
    is IrLambda (params) (body) (ty) (sp) -> if list-length params == 0 then "(() => " & emit-ts-expr body arities indent & ")" else "(" & emit-ts-lambda-params params 0 & emit-ts-expr body arities indent & ")"
    is IrList (elems) (ty) (sp) -> "[" & emit-ts-list-elems elems arities indent 0 & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-ts-match scrut branches arities indent
    is IrAct (stmts) (ty) (sp) -> emit-ts-act stmts arities indent
    is IrRecord (name) (fields) (ty) (sp) -> "{ _type: \"" & name & "\"" & emit-ts-record-fields fields name arities indent 0 & " }"
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-ts-expr rec arities indent & "." & ts-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(" & emit-ts-expr rec arities indent & "." & ts-field field & " = " & emit-ts-expr val arities indent & ")"
    is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => " & emit-ts-expr body arities indent & ")"
    is IrAwait (task) (ty) (sp) -> "(await " & emit-ts-expr task arities indent & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-ts-expr body arities indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-ts-expr body arities indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-ts-act body arities indent
    is IrError (msg) (ty) (sp) -> "(() => { throw new Error(\"" & ts-escape msg & "\"); })()"

Section: Binary Operators

  emit-ts-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-ts-binary (op) (l) (r) (arities) (indent) =
   let lhs = emit-ts-expr l arities indent
   in let rhs = emit-ts-expr r arities indent
   in when op
    is IrAddInt | IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt | IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt -> "Math.trunc(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "(" & lhs & " % " & rhs & ")"
    is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
    is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
    is IrAddVec -> "(" & lhs & ".map((v,i) => v + " & rhs & "[i]))"
    is IrSubVec -> "(" & lhs & ".map((v,i) => v - " & rhs & "[i]))"
    is IrMulVec -> "(" & lhs & ".map((v,i) => v * " & rhs & "[i]))"
    is IrDivVec -> "(" & lhs & ".map((v,i) => v / " & rhs & "[i]))"
    is IrEq -> "(" & lhs & " === " & rhs & ")"
    is IrNotEq -> "(" & lhs & " !== " & rhs & ")"
    is IrLt | IrLtVec -> "(" & lhs & " < " & rhs & ")"
    is IrGt | IrGtVec -> "(" & lhs & " > " & rhs & ")"
    is IrLtEq | IrLtEqVec -> "(" & lhs & " <= " & rhs & ")"
    is IrGtEq | IrGtEqVec -> "(" & lhs & " >= " & rhs & ")"
    is IrApproxEq | IrApproxEqExact -> "(" & lhs & " === " & rhs & ")"
    is IrAnd -> "(" & lhs & " && " & rhs & ")"
    is IrOr -> "(" & lhs & " || " & rhs & ")"
    is IrAppendText -> "(" & lhs & " + " & rhs & ")"
    is IrAppendList -> "([..." & lhs & ", ..." & rhs & "])"
    is IrConsList -> "[" & lhs & ", ..." & rhs & "]"

Section: Apply and Helpers

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-ts-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-ts-apply (e) (arities) (indent) =
   let chain = collect-apply-chain e []
   in let func = emit-ts-expr (chain.root) arities indent
   in when (chain.root)
    is IrName (n) (ty) (sp) ->
     if is-mktup-name n then "[" & emit-ts-apply-args (chain.args) arities indent 0 & "]"
     else if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then ts-sanitize n & "(" & emit-ts-apply-args (chain.args) arities indent 0 & ")"
     else let ar = lookup-arity arities n
     in if ar < 0 then ts-sanitize n & emit-ts-apply-rest (chain.args) arities indent 0
        else if ar == 0 then ts-sanitize n & "()" & emit-ts-apply-rest (chain.args) arities indent 0
        else emit-ts-apply-split (ts-sanitize n) (chain.args) ar arities indent
    is otherwise -> "(" & func & ")" & emit-ts-apply-rest (chain.args) arities indent 0

  emit-ts-apply-split : Text, List IRExpr, Integer, List ArityEntry, Integer -> Text
  emit-ts-apply-split (func) (args) (ar) (arities) (indent) =
   if ar > 0 & list-length args > ar
   then func & "(" & emit-ts-apply-args (list-take args ar) arities indent 0 & ")" & emit-ts-apply-rest (list-drop args ar) arities indent 0
   else if ar > 0 & list-length args > 0 & list-length args < ar
   then emit-ts-partial-wrappers 0 (ar - list-length args) & func & "(" & emit-ts-apply-args args arities indent 0 & ", " & emit-ts-partial-params 0 (ar - list-length args) & ")"
   else func & "(" & emit-ts-apply-args args arities indent 0 & ")"

  emit-ts-partial-wrappers : Integer, Integer -> Text
  emit-ts-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & show i & "_: any) => " & emit-ts-partial-wrappers (i + 1) count

  emit-ts-partial-params : Integer, Integer -> Text
  emit-ts-partial-params (i) (count) =
   if i == count then ""
   else (if i > 0 then ", " else "") & "_p" & show i & "_" & emit-ts-partial-params (i + 1) count

  emit-ts-apply-args : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-ts-apply-args (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-ts-expr (list-at args i) arities indent & emit-ts-apply-args args arities indent (i + 1)

  emit-ts-apply-rest : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-ts-apply-rest (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else "(" & emit-ts-expr (list-at args i) arities indent & ")" & emit-ts-apply-rest args arities indent (i + 1)

  emit-ts-params : List IRParam, Integer -> Text
  emit-ts-params (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & ts-sanitize (list-at params i).name & ": any" & emit-ts-params params (i + 1)

  emit-ts-list-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-ts-list-elems (elems) (arities) (indent) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-ts-expr (list-at elems i) arities indent & emit-ts-list-elems elems arities indent (i + 1)

  emit-ts-record-fields : List IRFieldVal, Text, List ArityEntry, Integer, Integer -> Text
  emit-ts-record-fields (fields) (rname) (arities) (indent) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ", " & ts-sanitize (f.name) & ": __cf(\"" & rname & "\", \"" & f.name & "\", " & emit-ts-expr (f.value) arities indent & ")" & emit-ts-record-fields fields rname arities indent (i + 1)

  ts-clamp-table : List ATypeDef, Integer -> Text
  ts-clamp-table (tds) (i) =
   if i >= list-length tds then ""
   else (when list-at tds i
    is ARecordTypeDef (dn) (tparams) (afields) (recmut) (sp) -> ts-clamp-rows (dn.value) (record-fields-by-name tds (dn.value) 0) 0
    is otherwise -> "") & ts-clamp-table tds (i + 1)

  ts-clamp-rows : Text, List RecordField, Integer -> Text
  ts-clamp-rows (rname) (rfields) (i) =
   if i >= list-length rfields then ""
   else let rf = list-at rfields i
   in (when rf.type-val
    is IntegerTy (lo) (hi) (mode) -> when mode
     is OvClamping -> "  \"" & rname & "." & rf.name.value & "\": [" & integer-to-text lo & ", " & integer-to-text hi & "],\n"
     is otherwise -> ""
    is otherwise -> "") & ts-clamp-rows rname rfields (i + 1)

Section: Match

  emit-ts-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-ts-match (scrut) (branches) (arities) (indent) =
   "(() => { const _s: any = " & emit-ts-expr scrut arities indent & "; " & emit-ts-branches branches arities indent 0 & " })()"

  emit-ts-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-ts-branches (branches) (arities) (indent) (i) =
   if i == list-length branches then "throw new Error('non-exhaustive match');"
   else let b = list-at branches i
   in let cond = emit-ts-pat-cond (b.pattern) "_s"
   in let binds = emit-ts-pat-binds (b.pattern) "_s"
   in let body = emit-ts-expr (b.body) arities indent
   in let taken = if ts-guard-trivial (b.guard) then "return " & body & "; "
      else "if (" & emit-ts-expr (b.guard) arities indent & ") { return " & body & "; } "
   in "if (" & cond & ") { " & binds & taken & "} " & emit-ts-branches branches arities indent (i + 1)

  ts-guard-trivial : IRExpr -> Boolean
  ts-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  emit-ts-pat-cond : IRPat, Text -> Text
  emit-ts-pat-cond (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "true"
    is IrLitPat (text) (ty) (sp) -> scrut & " === " & text
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then "Array.isArray(" & scrut & ")"
     else scrut & "._tag === \"" & name & "\""
    is IrWildPat (sp) -> "true"
    is IrVecPat (pats) (ty) (sp) -> "true"

  emit-ts-pat-binds : IRPat, Text -> Text
  emit-ts-pat-binds (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "const " & ts-sanitize name & ": any = " & scrut & "; "
    is IrLitPat (text) (ty) (sp) -> ""
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then emit-ts-tup-binds subs scrut 0
     else emit-ts-ctor-binds subs scrut 0
    is IrWildPat (sp) -> ""
    is IrVecPat (pats) (ty) (sp) -> ""

  emit-ts-ctor-binds : List IRPat, Text, Integer -> Text
  emit-ts-ctor-binds (subs) (scrut) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in let access = scrut & "._" & show i
   in emit-ts-pat-binds sub access & emit-ts-ctor-binds subs scrut (i + 1)

Section: Act Blocks

  emit-ts-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-ts-act (stmts) (arities) (indent) =
   "(() => {\n" & emit-ts-act-stmts stmts arities (indent + 1) 0 & ts-indent indent & "})()"

  emit-ts-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-ts-act-stmts (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in when s
    is IrDoBind (name) (ty) (val) (sp) -> ts-indent indent & "const " & ts-sanitize name & ": any = " & emit-ts-expr val arities indent & ";\n" & emit-ts-act-stmts stmts arities indent (i + 1)
    is IrDoExec (e) (sp) ->
     if is-last then ts-indent indent & "return " & emit-ts-expr e arities indent & ";\n"
     else ts-indent indent & emit-ts-expr e arities indent & ";\n" & emit-ts-act-stmts stmts arities indent (i + 1)

Section: Type Definitions

  emit-ts-type-def : ATypeDef -> Text
  emit-ts-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     "interface " & ts-sanitize (name.value) & " { _type: string; " & emit-ts-iface-fields fields 0 & "}\nfunction " & ts-sanitize (name.value) & "(fields: any): any { return { _type: \"" & name.value & "\", ...fields }; }\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else emit-ts-variant-type name ctors
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-ts-iface-fields : List ARecordFieldDef, Integer -> Text
  emit-ts-iface-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ts-sanitize (f.name.value) & ": any; " & emit-ts-iface-fields fields (i + 1)

  emit-ts-variant-type : Name, List AVariantCtorDef -> Text
  emit-ts-variant-type (name) (ctors) =
   "type " & ts-sanitize (name.value) & " = " & emit-ts-union-members ctors 0 & ";\n" & emit-ts-variant-ctors ctors 0

  emit-ts-union-members : List AVariantCtorDef, Integer -> Text
  emit-ts-union-members (ctors) (i) =
   if i == list-length ctors then (if i == 0 then "never" else "")
   else let c = list-at ctors i
   in let sep = if i > 0 then " | " else ""
   in sep & "{ _tag: \"" & c.name.value & "\" }" & emit-ts-union-members ctors (i + 1)

  emit-ts-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-ts-variant-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in let ctor-text = if n == 0 then "const " & ts-sanitize (c.name.value) & ": any = { _tag: \"" & c.name.value & "\" };\n"
      else "function " & ts-sanitize (c.name.value) & "(" & emit-ts-ctor-params n 0 & "): any { return { _tag: \"" & c.name.value & "\"" & emit-ts-ctor-fields n 0 & " }; }\n"
   in ctor-text & emit-ts-variant-ctors ctors (i + 1)

  emit-ts-ctor-params : Integer, Integer -> Text
  emit-ts-ctor-params (n) (i) =
   if i == n then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "_" & show i & ": any" & emit-ts-ctor-params n (i + 1)

  emit-ts-ctor-fields : Integer, Integer -> Text
  emit-ts-ctor-fields (n) (i) =
   if i == n then ""
   else ", _" & show i & ": _" & show i & emit-ts-ctor-fields n (i + 1)

Section: Definition Emission

  emit-ts-def : IRDef, List ArityEntry -> Text
  emit-ts-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else let sname = ts-sanitize (d.name)
   in if list-length (d.params) == 0
      then "function " & sname & "(): any {\n  return " & emit-ts-expr (d.body) arities 1 & ";\n}\n\n"
      else "function " & sname & "(" & emit-ts-params (d.params) 0 & "): any {\n  return " & emit-ts-expr (d.body) arities 1 & ";\n}\n\n"

  emit-ts-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-ts-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-ts-def (list-at defs i) arities & emit-ts-defs defs (i + 1) arities

  emit-ts-type-defs : List ATypeDef, Integer -> Text
  emit-ts-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-ts-type-def (list-at tds i) & emit-ts-type-defs tds (i + 1)

Section: TypeScript Module Assembly

  emit-typescript-chapter : IRChapter, List ATypeDef -> Text
  emit-typescript-chapter (m) (type-defs) =
   let builtins = "function __narrow(n: any): any { return n; }\nfunction print_line_uni(s: string): void { console.log(s); }\nfunction show(n: any): string { return String(n); }\nfunction text_length(s: string): number { return s.length; }\nfunction text_replace(s: string, a: string, b: string): string { return a.length === 0 ? s : s.split(a).join(b); }\nfunction text_compare(a: string, b: string): number { return a < b ? -1 : a > b ? 1 : 0; }\nfunction list_length(xs: any[]): number { return xs.length; }\nfunction list_at(xs: any[], i: number): any { return xs[i]; }\nfunction integer_to_text(n: number): string { return String(n); }\nfunction char_code(c: any): number { return typeof c === 'string' ? c.charCodeAt(0) : c; }\nfunction char_at(s: string, i: number): string { return s[i]; }\nfunction negate(n: number): number { return -n; }\nfunction __cf(t: string, f: string, v: any): any { const b = (__clamps as any)[t + \".\" + f]; return b === undefined ? v : (v < b[0] ? b[0] : (v > b[1] ? b[1] : v)); }\nfunction int_mod(a: number, b: number): number { const abs = b < 0 ? -b : b; const r = a % abs; return r < 0 ? r + abs : r; }\nfunction list_snoc(xs: any[], v: any): any[] { if (xs.length > 0) { xs.push(v); return xs; } return [v]; }\nfunction list_push(xs: any[], v: any): any[] { return list_snoc(xs, v); }\nfunction text_starts_with(s: string, p: string): boolean { return s.startsWith(p); }\nfunction text_contains(s: string, sub: string): boolean { return s.includes(sub); }\nfunction text_split(s: string, sep: string): string[] { return sep.length === 0 ? [s] : s.split(sep); }\nfunction text_to_integer(s: string): number { let t = String(s); let i = 0; let neg = false; if (t.charAt(0) === '-') { neg = true; i = 1; } let v = 0; while (i < t.length && t.charAt(i) >= '0' && t.charAt(i) <= '9') { v = v * 10 + (t.charCodeAt(i) - 48); i = i + 1; } return neg ? -v : v; }\n\n"
   in let arities = build-arity-map (m.defs) 0 (prelude-arities builtins)
   in let clamps = "const __clamps: any = {\n" & ts-clamp-table type-defs 0 & "};\n\n"
   in let types-text = clamps & emit-ts-type-defs type-defs 0
   in let defs-text = emit-ts-defs (m.defs) 0 arities
   in let entry = "// Entry: the program re-runs itself on a worker whose stack is 512 MB (plugs 1.14)\ndeclare const require: any; declare const __filename: string; declare const process: any;\nconst { Worker: _CxWorker, isMainThread: _cxIsMain } = require(\"worker_threads\");\nif (_cxIsMain) {\n  const _cxW = new _CxWorker(__filename, { resourceLimits: { stackSizeMb: 512 } });\n  _cxW.on(\"error\", (e: any) => { process.exitCode = 1; throw e; });\n  _cxW.on(\"exit\", (c: number) => { if (c !== 0) process.exitCode = c; });\n} else {\n  try { (opening as any)(); } catch(e) { console.error(e); }\n}\n"
   in builtins & types-text & defs-text & entry

  emit-ts-tup-binds : List IRPat, Text, Integer -> Text
  emit-ts-tup-binds (subs) (scrut) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in let access = scrut & "[" & show i & "]"
   in emit-ts-pat-binds sub access & emit-ts-tup-binds subs scrut (i + 1)

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

