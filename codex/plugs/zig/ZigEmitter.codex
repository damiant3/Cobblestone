  zig-p-cx-write-binary-buf = [ShakeLit "fn ", ShakeUse "cx_write_binary_buf", ShakeLit "(b: i64, off: i64, len: i64) void {\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + len);\n    const s: usize = @intCast(b + off);\n    ", ShakeUse "cx_write_all", ShakeLit "(", ShakeUse "cx_heap_mem", ShakeLit "[s .. s + @as(usize, @intCast(len))]);\n}\n"]

  zig-p-cx-vtag : List ShakeFrag
  zig-p-cx-vtag = [ShakeLit "// variant-tag is the constructor's 0-based declaration index: bare\n// metal loads word 0 of the variant block (emit-variant-tag-builtin) and\n// writes find-ctor-tag there, and a union(enum)'s tag is numbered the same\n// way by declaration order. Self-recursive variants are pointers here, so\n// the pointer case dereferences first.\nfn ", ShakeUse "cx_vtag", ShakeLit "(v: anytype) i64 {\n    return switch (@typeInfo(@TypeOf(v))) {\n        .pointer => @intCast(@intFromEnum(v.*)),\n        else => @intCast(@intFromEnum(v)),\n    };\n}\n"]

  zig-p-cx-buf-write-byte : List ShakeFrag
  zig-p-cx-buf-write-byte = [ShakeLit "fn ", ShakeUse "cx_buf_write_byte", ShakeLit "(b: i64, off: i64, v: i64) i64 {\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + 1);\n    ", ShakeUse "cx_heap_mem", ShakeLit "[@intCast(b + off)] = @intCast(@mod(v, 256));\n    return off + 1;\n}\n"]

  zig-p-cx-buf-write-bytes : List ShakeFrag
  zig-p-cx-buf-write-bytes = [ShakeLit "fn ", ShakeUse "cx_buf_write_bytes", ShakeLit "(b: i64, off: i64, vs: anytype) i64 {\n    const n: i64 = @intCast(vs.items.items.len);\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + n);\n    for (vs.items.items, 0..) |v, i| ", ShakeUse "cx_heap_mem", ShakeLit "[@as(usize, @intCast(b + off)) + i] = @intCast(@mod(v, 256));\n    return off + n;\n}\n"]

  zig-p-cx-peek-byte : List ShakeFrag
  zig-p-cx-peek-byte = [ShakeLit "fn ", ShakeUse "cx_peek_byte", ShakeLit "(b: i64, off: i64) i64 {\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + 1);\n    return ", ShakeUse "cx_heap_mem", ShakeLit "[@intCast(b + off)];\n}\n"]

  zig-p-cx-buf-read-bytes : List ShakeFrag
  zig-p-cx-buf-read-bytes = [ShakeLit "fn ", ShakeUse "cx_buf_read_bytes", ShakeLit "(b: i64, off: i64, n: i64) *", ShakeUse "CxList", ShakeLit "(i64) {\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + n);\n    const l = ", ShakeUse "cx_ll_empty", ShakeLit "(i64);\n    l.items.ensureTotalCapacity(", ShakeUse "cx_gpa", ShakeLit ", @intCast(n)) catch @panic(\"oom\");\n    var cx_j: i64 = 0;\n    while (cx_j < n) : (cx_j += 1) l.items.appendAssumeCapacity(", ShakeUse "cx_heap_mem", ShakeLit "[@as(usize, @intCast(b + off + cx_j))]);\n    return l;\n}\n"]

  zig-p-cx-shru : List ShakeFrag
  zig-p-cx-shru = [ShakeLit "fn ", ShakeUse "cx_shru", ShakeLit "(a: i64, b: i64) i64 {\n    return @bitCast(@as(u64, @bitCast(a)) >> @as(u6, @intCast(b & 63)));\n}\n"]

  zig-p-cx-mod : List ShakeFrag
  zig-p-cx-mod = [ShakeLit "// int-mod is Euclidean, so the result lands in [0, |b|) regardless of\n// either sign, where @rem takes the dividend's sign.\nfn ", ShakeUse "cx_mod", ShakeLit "(a: i64, b: i64) i64 {\n    const m = if (b < 0) -b else b;\n    const r = @rem(a, m);\n    return if (r < 0) r + m else r;\n}\n"]

  zig-p-cx-text-eq : List ShakeFrag
  zig-p-cx-text-eq = [ShakeLit "fn ", ShakeUse "cx_text_eq", ShakeLit "(a: []const u8, b: []const u8) bool {\n    return ", ShakeUse "std", ShakeLit ".mem.eql(u8, a, b);\n}\n"]

  zig-p-cx-is-letter : List ShakeFrag
  zig-p-cx-is-letter = [ShakeLit "// Classification is banded in CCE: 13..64 are the ASCII letters, 65..96\n// the punctuation between, 97..127 the accented Latin and Cyrillic\n// letters, 3..12 the digits -- the same two-band test bare metal's\n// emit-is-letter-builtin encodes.\nfn ", ShakeUse "cx_is_letter", ShakeLit "(c: i64) bool {\n    return (c >= 13 and c <= 64) or (c >= 97 and c <= 127);\n}\n"]

  zig-p-cx-is-digit : List ShakeFrag
  zig-p-cx-is-digit = [ShakeLit "fn ", ShakeUse "cx_is_digit", ShakeLit "(c: i64) bool {\n    return c >= 3 and c <= 12;\n}\n"]

  zig-p-cx-new : List ShakeFrag
  zig-p-cx-new = [ShakeLit "fn ", ShakeUse "cx_new", ShakeLit "(v: anytype) *@TypeOf(v) {\n    const p = ", ShakeUse "cx_gpa", ShakeLit ".create(@TypeOf(v)) catch @panic(\"oom\");\n    p.* = v;\n    return p;\n}\n"]

  zig-p-cx-concat : List ShakeFrag
  zig-p-cx-concat = [ShakeLit "// An accumulator loop appends to the frontier block, and the bytes\n// just past it are free. Growing there leaves every existing holder of\n// `a` seeing the same bytes -- text is immutable and nothing before\n// a.len is written -- so the loop costs n instead of n(n+1)/2. Bare\n// metal reaches the same asymptotics from the other side, statically:\n// is-inplace-append (X86_64.codex:2376) recognises a tail-recursive\n// accumulator parameter and calls __str_concat_inplace. That analysis\n// needs TCO state this emitter does not track, and it does not need to:\n// on a bump frontier the same question is one pointer comparison at run\n// time. Measured 2026-08-21 with findings/probe-memory-model.codex,\n// text accumulation at n = 64/128/256: 2080/8256/32896 bytes before\n// (exactly n(n+1)/2), 64/128/256 after, against bare metal 72/136/264.\n// No empty short-circuit. `a & \"\"` returning `a` is the finding-29 shape:\n// bare metal has no such case -- both emit-str-concat-fast-bump and\n// emit-str-concat-slow-alloc bump r10 unconditionally, so the result is\n// always a fresh block at the live cursor -- and an aliased return inside a\n// deck extent yields a value that looks decked and is not. Falling through\n// costs an empty allocation and buys the guarantee.\nfn ", ShakeUse "cx_concat", ShakeLit "(a: []const u8, b: []const u8) []const u8 {\n    if (a.len != 0) {\n        const cx_base = @intFromPtr(", ShakeUse "cx_heap_base", ShakeLit "());\n        const cx_ap = @intFromPtr(a.ptr);\n        if (cx_ap >= cx_base and cx_ap - cx_base + a.len == @as(usize, @intCast(", ShakeUse "cx_hp", ShakeLit "))) {\n            const cx_tail = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, b.len) catch @panic(\"oom\");\n            @memcpy(cx_tail, b);\n            return a.ptr[0 .. a.len + b.len];\n        }\n    }\n    return ", ShakeUse "std", ShakeLit ".mem.concat(", ShakeUse "cx_gpa", ShakeLit ", u8, &.{ a, b }) catch @panic(\"oom\");\n}\n"]

  zig-p-cx-text-starts-with : List ShakeFrag
  zig-p-cx-text-starts-with = [ShakeLit "fn ", ShakeUse "cx_text_starts_with", ShakeLit "(s: []const u8, p: []const u8) bool {\n    return ", ShakeUse "std", ShakeLit ".mem.startsWith(u8, s, p);\n}\n"]

