    ZigBuiltinEmitter { name = "max", emit = \args ctx d ty -> "@max(" & emit-zig-expr (list-at args 0) ctx (d + 1) & ", " & emit-zig-expr (list-at args 1) ctx (d + 1) & ")" },
    ZigBuiltinEmitter { name = "fail", emit = \args ctx d ty -> "@panic(" & emit-zig-expr (list-at args 0) ctx (d + 1) & ")" }
   ]

  lookup-zig-builtin : Text, List IRExpr, ZigCtx, Integer, CodexType -> Text
  lookup-zig-builtin (name) (args) (ctx) (d) (ty) =
   if lookup-arity (ctx.arities) name >= 0 & (zig-skip-def name == False) then ""
   else let len = list-length zig-builtin-emitters
   in let pos = bsearch-zig-builtin-pos zig-builtin-emitters name 0 len
   in if pos >= len then ""
      else let e = list-at zig-builtin-emitters pos
      in if e.name == name then e.emit args ctx d ty else ""

 A name the module itself defines is the module's: the user definition
 wins over any builtin of the same name, so interception yields before
 the table is consulted. The arity map is built from the unit's IRDefs,
 which makes it the module-defined test. The one exemption is paired
 with zig-skip-def: a definition deliberately not emitted has only its
 intercept to answer for it, so the intercept must not yield.

Section: Name Mapping

 A name the plug cannot place used to reach zig as itself, and zig said
 "use of undeclared identifier text_to_double_bits" -- true, unhelpful, and
 indistinguishable from a typo in the emitter. Three builtins the plug had
 never implemented arrived that way at once in the lower milestone, each
 reported as a mystery identifier rather than as the missing emitter it was.

 Everything a name can legitimately be is enumerable: a rename in scope, a
 local bound by an enclosing binder, an entry in the name map, a
 constructor, a definition in the chapter, or a builtin. Nothing else
 exists, so anything else is a gap in this plug and names itself.

 bound-names is what makes this decidable. Before captures it did not
 exist, and a bare name that was not a definition was assumed to be a
 closure-valued local, which is exactly the assumption that let an
 unimplemented builtin through as a call to a nonexistent closure.

  zig-is-builtin : Text -> Boolean
  zig-is-builtin (n) =
   let len = list-length zig-builtin-emitters
   in let pos = bsearch-zig-builtin-pos zig-builtin-emitters n 0 len
   in if pos >= len then False
      else (list-at zig-builtin-emitters pos).name == n

  zig-name-known : ZigCtx, Text -> Boolean
  zig-name-known (ctx) (n) =
   if text-length (zig-renamed ctx n) > 0 then True
   else if zig-in-texts (ctx.bound-names) n 0 then True
   else if text-length (zig-lookup-name zig-name-map n 0) > 0 then True
   else if zig-find-ctor (ctx.ctors) n 0 >= 0 then True
   else if lookup-arity (ctx.arities) n >= 0 then True
   else zig-is-builtin n

  zig-unknown-name : Text -> Text
  zig-unknown-name (n) =
   "@compileError(\"zig plug: no emitter for " & n & "\")"

  zig-refuse : Text -> Text
  zig-refuse (why) =
   "@compileError(\"zig plug: " & why & "\")"


  ZigNameEntry = record {
   codex-name : Text,
   zig-name : Text
  }

 __heap-save reads the bump frontier (cx_hp), which the buffer
 builtins and the object allocator share -- a buffer address minted by
 __heap-save must be one cx_buf_write_byte can dereference. The pointer boots at bare metal's own
 heap base (boot does mov r10, 6291456), because the absolute value is
 observable: the depot's arith-narrow-proven asserts __heap-save > 0 as a
 structural fact. The deck names call the prelude's real deck for the
 same reason -- deck position is observable, and the deck-*-contract
 subjects print it.

 The frontier moves on every allocation, as bare metal's does, and
 __heap-restore reclaims everything since the matching save -- one heap,
 one number. The divergence that remains and stays honest is the SIZES:
 a zig record is not a bare-metal record, so a subject that prints a
 frontier position taken after allocations prints a different number
 here and diverges in the dump the oracle diffs. Positions bracketed
 only by __heap-advance/__heap-restore deltas agree exactly, which is
 what the rungs exercise. The choice is checked, not assumed.

  zig-name-map : List ZigNameEntry =
   [ZigNameEntry { codex-name = "True", zig-name = "true" },
    ZigNameEntry { codex-name = "False", zig-name = "false" },
    ZigNameEntry { codex-name = "Nothing", zig-name = "null" },
    ZigNameEntry { codex-name = "__deck-pos", zig-name = "cx_deck_pos()" },
    ZigNameEntry { codex-name = "__heap-save", zig-name = "cx_heap_save()" },
    ZigNameEntry { codex-name = "__deck-enter", zig-name = "cx_deck_enter()" },
    ZigNameEntry { codex-name = "__deck-exit", zig-name = "cx_deck_exit()" }]

  zig-lookup-name : List ZigNameEntry, Text, Integer -> Text
  zig-lookup-name (entries) (name) (i) =
   if i >= list-length entries then ""
   else let e = list-at entries i
   in if e.codex-name == name then e.zig-name
      else zig-lookup-name entries name (i + 1)

 A bare IrName resolves in order: the literal map, then constructors
 (enum member or union init), then zero-arity defs (constants compile
 to nullary functions, so the reference must call), then plain names.

 A definition named but not called is a function VALUE, so it wraps into a
 closure with nothing captured -- the same shape a partial application
 produces, which is what keeps every function-typed position one type.

 The scan runs from the END so an inner lambda's binding wins over an
 outer one of the same name, which is what shadowing means. Appending with
 `&` rather than list-push is not a style choice: list-push writes in place
 under capacity and returns the same list, so pushing onto a list the
 caller still holds mutates it for every later caller. Done with list-push,
 these renames escaped their lambda and reached every definition emitted
 afterwards -- apat_span(p) emitted _lam3_p for its own parameter.

  zig-renamed : ZigCtx, Text -> Text
  zig-renamed (ctx) (n) =
   zig-renamed-scan ctx n (list-length (ctx.renamed-from) - 1)

  zig-renamed-scan : ZigCtx, Text, Integer -> Text
  zig-renamed-scan (ctx) (n) (i) =
   if i < 0 then ""
   else if list-at (ctx.renamed-from) i == n then list-at (ctx.renamed-to) i
   else zig-renamed-scan ctx n (i - 1)

  zig-lambda-param-name : Text, Integer -> Text
  zig-lambda-param-name (n) (d) = "_lam" & integer-to-text d & "_" & zig-raw-ident n

  zig-push-lambda-renames : ZigCtx, List IRParam, Integer, Integer -> ZigCtx
  zig-push-lambda-renames (ctx) (params) (d) (i) =
   if i >= list-length params then ctx
   else let p = list-at params i
   in let from = (ctx.renamed-from) & [p.name]
   in let to = (ctx.renamed-to) & [zig-lambda-param-name (p.name) d]
   in let ctx2 = ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = from,
    renamed-to = to,
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ctx.expected,
    bound-names = (ctx.bound-names) & [p.name],
    scope-tvars = ctx.scope-tvars
   }
   in zig-push-lambda-renames ctx2 params d (i + 1)

  emit-zig-name : Text, CodexType, ZigCtx, Integer -> Text
  emit-zig-name (n) (ty) (ctx) (d) =
   let renamed = zig-renamed ctx n
   in if text-length renamed > 0 then renamed
   else let mapped = zig-lookup-name zig-name-map n 0
   in if text-length mapped > 0 then mapped
   else let ci = zig-find-ctor (ctx.ctors) n 0
   in if ci >= 0 then
    let c = list-at (ctx.ctors) ci
    in if c.enum-like then zig-sanitize (c.type-name) & "." & zig-sanitize n
       else let boxed = zig-typedef-recursive ctx (c.type-name)
       in let base = if boxed then zig-sanitize (c.type-name) & "S" else zig-sanitize (c.type-name) & zig-ctor-type-args ty (ctx.scope-tvars)
       in if boxed then "cx_new(" & base & "{ ." & zig-sanitize n & " = {} })"
          else base & "{ ." & zig-sanitize n & " = {} }"
   else if lookup-arity (ctx.arities) n == 0
   then zig-sanitize n & "(" & zig-drop-trailing-sep (zig-call-type-args ctx n [] ty) & ")"
   else if lookup-arity (ctx.arities) n >= 1 & zig-fn-param-count ty >= 1
   then zig-closure-make n [] ctx d ty
   else if zig-name-known ctx n then zig-sanitize n
   else zig-unknown-name n

Section: Binary Operator Mapping

  zig-bin-op-symbol : IRBinaryOp -> Text
  zig-bin-op-symbol (op) =
   when op
    is IrAddInt -> "+%"
    is IrSubInt -> "-%"
    is IrMulInt -> "*%"
    is IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "%"
    is IrPowInt -> "**"
    is IrEq -> "=="
    is IrNotEq -> "!="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq | IrApproxEqExact -> "=="
    is IrAnd -> "and"
    is IrOr -> "or"
 The list operators have no symbol here on purpose: zig's ++ concatenates
 comptime-known arrays, not the runtime CxList a codex list becomes, so
 each has a runtime function and emit-zig-binary reaches it before this
 table. Naming a symbol they cannot use is how they got emitted as ++.

    is IrAppendText | IrAppendList | IrConsList -> "@compileError(\"list operator needs a runtime call\")"

  emit-zig-binary : IRBinaryOp, IRExpr, IRExpr, ZigCtx, Integer -> Text
  emit-zig-binary (op) (l) (r) (ctx) (d) =
   when op
    is IrAppendText -> "cx_concat(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrAppendList -> "cx_ll_concat(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrConsList -> "cx_ll_cons(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrDivInt -> "@divTrunc(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrRemInt -> "@rem(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrPowInt -> "cx_ipow(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
    is IrAnd -> "(" & emit-zig-expr l ctx (d + 1) & " and " & emit-zig-expr r ctx (d + 1) & ")"
    is IrOr -> "(" & emit-zig-expr l ctx (d + 1) & " or " & emit-zig-expr r ctx (d + 1) & ")"
    is IrEq ->
     if zig-is-text-type (zig-expr-type l) | zig-is-text-type (zig-expr-type r)
     then "cx_text_eq(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & ")"
     else "(" & emit-zig-expr l ctx (d + 1) & " == " & emit-zig-expr r ctx (d + 1) & ")"
    is IrNotEq ->
     if zig-is-text-type (zig-expr-type l) | zig-is-text-type (zig-expr-type r)
     then "(!cx_text_eq(" & emit-zig-expr l ctx (d + 1) & ", " & emit-zig-expr r ctx (d + 1) & "))"
     else "(" & emit-zig-expr l ctx (d + 1) & " != " & emit-zig-expr r ctx (d + 1) & ")"
    is otherwise -> "(" & emit-zig-expr l ctx (d + 1) & " " & zig-bin-op-symbol op & " " & emit-zig-expr r ctx (d + 1) & ")"

Section: Type Definition Emission

  emit-zig-type-defs : List ATypeDef, Integer -> Text
  emit-zig-type-defs (tds) (i) =
   text-concat-list (emit-zig-type-defs-loop tds i [])

  emit-zig-type-defs-loop : List ATypeDef, Integer, List Text -> List Text
  emit-zig-type-defs-loop (tds) (i) (acc) =
   if i == list-length tds then acc
   else emit-zig-type-defs-loop tds (i + 1) (list-push acc (emit-zig-type-def (list-at tds i)))

  emit-zig-type-def : ATypeDef -> Text
  emit-zig-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     emit-zig-record-type (name.value) fields tparams
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-zig-sum-type (name.value) ctors tparams
    is AUnitTypeDef (name) (unitbase) (s) ->
     "const " & zig-sanitize (name.value) & " = " & emit-zig-atype unitbase & ";\n\n"

 All-nullary variants become plain enums so tag comparison and member
 references work directly; any payload forces union(enum), with a
 tuple struct for multi-field constructors.

 A variant whose constructor payload holds the variant itself has no finite
 size in zig, so such a type becomes a pointer alias -- the same shape the
 mutable records already use here. Only a direct payload counts: a List of
 the type is a pointer already and does not force boxing.

  zig-atype-is-named : ATypeExpr, Text -> Boolean
  zig-atype-is-named (te) (n) =
   when te
    is ANamedType (nm) (s) -> nm.value == n
    is otherwise -> False

  zig-ctor-fields-self-ref : List ATypeExpr, Integer, Text -> Boolean
  zig-ctor-fields-self-ref (fs) (i) (n) =
   if i >= list-length fs then False
   else if zig-atype-is-named (list-at fs i) n then True
   else zig-ctor-fields-self-ref fs (i + 1) n

  zig-variant-self-recursive : Text, List AVariantCtorDef, Integer -> Boolean
  zig-variant-self-recursive (n) (ctors) (i) =
   if i >= list-length ctors then False
   else if zig-ctor-fields-self-ref ((list-at ctors i).fields) 0 n then True
   else zig-variant-self-recursive n ctors (i + 1)

  zig-typedef-recursive-loop : List ATypeDef, Integer, Text -> Boolean
  zig-typedef-recursive-loop (tds) (i) (n) =
   if i >= list-length tds then False
   else when (list-at tds i)
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if name.value == n then zig-variant-self-recursive n ctors 0
     else zig-typedef-recursive-loop tds (i + 1) n
    is otherwise -> zig-typedef-recursive-loop tds (i + 1) n

  zig-typedef-recursive : ZigCtx, Text -> Boolean
  zig-typedef-recursive (ctx) (n) = zig-typedef-recursive-loop (ctx.typedefs) 0 n

 Whether a scrutinee needs `.*` is a question about the type's NAME, so it
 asks the same way the exhaustiveness check does. Matching SumTy alone
 answered "" for a ConstructedTy naming the very same self-recursive type,
 and the two readings disagreed silently: emit-opening-result-print
 switched on a CodexType-typed field and got a switch on the pointer.

  zig-match-deref : ZigCtx, CodexType -> Text
  zig-match-deref (ctx) (ty) =
   if zig-typedef-recursive ctx (zig-type-name-of ty) then ".*" else ""

  emit-zig-sum-type : Text, List AVariantCtorDef, List Name -> Text
  emit-zig-sum-type (name) (ctors) (tparams) =
   if list-length tparams > 0
   then "fn " & zig-sanitize name & "(" & zig-tparam-params tparams 0 & ") type {\n    return union(enum) {\n"
      & emit-zig-union-ctors ctors 0 (list-length ctors) & "    };\n}\n\n"
   else if variant-all-nullary ctors 0
   then "const " & zig-sanitize name & " = enum {\n" & emit-zig-enum-ctors ctors 0 (list-length ctors) & "};\n\n"
   else if zig-variant-self-recursive name ctors 0
   then "const " & zig-sanitize name & "S = union(enum) {\n" & emit-zig-union-ctors ctors 0 (list-length ctors) & "};\n"
      & "const " & zig-sanitize name & " = *" & zig-sanitize name & "S;\n\n"
   else "const " & zig-sanitize name & " = union(enum) {\n" & emit-zig-union-ctors ctors 0 (list-length ctors) & "};\n\n"

  emit-zig-enum-ctors : List AVariantCtorDef, Integer, Integer -> Text
  emit-zig-enum-ctors (ctors) (i) (len) =
   if i == len then ""
   else let c = list-at ctors i
   in "    " & zig-sanitize (c.name.value) & ",\n" & emit-zig-enum-ctors ctors (i + 1) len

  emit-zig-union-ctors : List AVariantCtorDef, Integer, Integer -> Text
  emit-zig-union-ctors (ctors) (i) (len) =
   if i == len then ""
   else let c = list-at ctors i
   in let nf = list-length (c.fields)
   in let payload = if nf == 0 then "void"
      else if nf == 1 then emit-zig-atype (list-at (c.fields) 0)
      else "struct { " & emit-zig-ctor-payloads (c.fields) 0 & " }"
   in "    " & zig-sanitize (c.name.value) & ": " & payload & ",\n" & emit-zig-union-ctors ctors (i + 1) len

  emit-zig-ctor-payloads : List ATypeExpr, Integer -> Text
  emit-zig-ctor-payloads (fs) (i) =
   if i == list-length fs then ""
   else if i == list-length fs - 1 then emit-zig-atype (list-at fs i)
   else emit-zig-atype (list-at fs i) & ", " & emit-zig-ctor-payloads fs (i + 1)

 A record quantified over type variables becomes a function from types to
 a type, exactly as a variant does. emit-zig-sum-type learned this when
 generics went in; this did not, so SortPartition emitted as a plain
 struct holding a List of an undeclared `a`.

 EVERY record is a pointer to a heap struct, which is the one
 representation bare metal has: emit-record-set-builtin evaluates the
 record to a pointer, stores the field through it, and returns that
 same pointer -- there is no copy in it anywhere, and the C# plug's
 _Buf.rset mutates through a reference for the same reason. A value
 record diverges the moment a program reads a binding made before an
 update, which is exactly what the x86 back end does at
 X86_64Helpers 1539 and 457, and what cost 81 bytes of machine code
 in fibx.

 The `mutable` keyword therefore selects nothing here. It was the
 emitter's own invention that plain records could be zig values, and
 the two representations are collapsed back to the one the target
 uses. The declared struct takes the S suffix and the bare name is
 the pointer to it, generic or not.

  emit-zig-record-type : Text, List ARecordFieldDef, List Name -> Text
  emit-zig-record-type (name) (fields) (tparams) =
   if list-length tparams > 0
   then "fn " & zig-sanitize name & "S(" & zig-tparam-params tparams 0 & ") type {\n    return struct {\n"
      & emit-zig-record-fields fields 0 & "    };\n}\n"
      & "fn " & zig-sanitize name & "(" & zig-tparam-params tparams 0 & ") type {\n    return *"
      & zig-sanitize name & "S(" & zig-tparam-args tparams 0 & ");\n}\n\n"
   else "const " & zig-sanitize name & "S = struct {\n" & emit-zig-record-fields fields 0 & "};\n"
      & "const " & zig-sanitize name & " = *" & zig-sanitize name & "S;\n\n"

  zig-tparam-args : List Name, Integer -> Text
  zig-tparam-args (tparams) (i) =
   if i >= list-length tparams then ""
   else let one = zig-sanitize ((list-at tparams i).value)
   in if i == list-length tparams - 1 then one
      else one & ", " & zig-tparam-args tparams (i + 1)

  emit-zig-record-fields : List ARecordFieldDef, Integer -> Text
  emit-zig-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "    " & zig-sanitize (f.name.value) & ": " & emit-zig-atype (f.type-expr) & ",\n" & emit-zig-record-fields fields (i + 1)

Section: Expression Emission

 Depth increments on every recursive emit call, which both bounds
 runaway recursion and supplies the label for value blocks: nested
 blocks always sit at different depths, so `b<depth>` labels never
 collide along a nesting path.

 Every let in a chain costs a level, so the cap is a bound on how long a
 function's let chain may be, not on how tangled its expressions are.
 emit-common-interrupt-handler binds 336 in a row and was silently cut off
 at 256, which is why exceeding the cap now refuses by name: the emitted
 program is wrong either way, and a wrong answer that says so is worth more
 than a quiet `undefined`. Raise this when a subject earns it -- the
 evidence is a refusal naming the cap, never a mysterious diff.

  zig-max-depth : Integer = 1024

  zig-label : Integer -> Text
  zig-label (d) = "b" & integer-to-text d

 __seq lets exist only to sequence a field store; binding them as consts
 trips zig's unused-constant and shadowing errors, so they discard.

  zig-is-seq-name : Text -> Boolean
  zig-is-seq-name (n) =
   if text-length n < 5 then False
   else substring n 0 5 == "__seq"

 zig refuses any unused constant or capture, and the IR legitimately
 carries bindings nothing reads, so let and capture emission checks
 whether the body ever names the binding and discards when it does not.
 Shadowed rebinds count as occurrences, which errs toward keeping the
 const; a wrongly-kept const fails loudly as unused, never silently.

  zig-occurs : IRExpr, Text -> Boolean
  zig-occurs (e) (n) =
   when e
    is IrName (m) (ty) (sp) -> m == n
    is IrBinary (op) (l) (r) (ty) (sp) -> zig-occurs l n | zig-occurs r n
    is IrNegate (o) (ty) (sp) -> zig-occurs o n
    is IrIf (c) (t) (el) (ty) (sp) -> zig-occurs c n | zig-occurs t n | zig-occurs el n
    is IrLet (m) (ty) (v) (b) (sp) -> zig-occurs v n | zig-occurs b n
    is IrApply (f) (a) (ty) (sp) -> zig-occurs f n | zig-occurs a n
    is IrLambda (ps) (b) (ty) (sp) -> zig-occurs b n
    is IrList (es) (ty) (sp) -> zig-occurs-list es 0 n
    is IrMatch (s) (bs) (ty) (sp) -> zig-occurs s n | zig-occurs-branches bs 0 n
    is IrAct (ss) (ty) (sp) -> zig-occurs-stmts ss 0 n
    is IrTry (mx) (b) (fb) (fs) (ty) (sp) -> zig-occurs-stmts b 0 n | zig-occurs-stmts fb 0 n | zig-occurs-stmts fs 0 n
    is IrHandle (eff) (b) (cs) (ty) (sp) -> zig-occurs b n
    is IrWithTimeout (secs) (effs) (scopes) (b) (ty) (sp) -> zig-occurs b n
    is IrRecord (nm) (fs) (ty) (sp) -> zig-occurs-fields fs 0 n
    is IrFieldAccess (r) (f) (ty) (sp) -> zig-occurs r n
    is IrFieldStore (r) (f) (v) (ty) (sp) -> zig-occurs r n | zig-occurs v n
    is IrFork (b) (ty) (sp) -> zig-occurs b n
    is IrAwait (t) (ty) (sp) -> zig-occurs t n
    is otherwise -> False

  zig-occurs-list : List IRExpr, Integer, Text -> Boolean
  zig-occurs-list (es) (i) (n) =
   if i >= list-length es then False
   else zig-occurs (list-at es i) n | zig-occurs-list es (i + 1) n

 A branch's GUARD is part of the branch. Reading only the body answered
 "does not occur" for a name a guard mentions, and every caller of this
 uses the answer to decide whether to discard something -- so a name
 read only from a guard was discarded and then emitted, which zig calls
 a pointless discard, or was left out of a lambda's captures. An
 unguarded branch carries a True literal here, so this costs nothing on
 the common shape.

  zig-occurs-branches : List IRBranch, Integer, Text -> Boolean
  zig-occurs-branches (bs) (i) (n) =
   if i >= list-length bs then False
   else zig-occurs ((list-at bs i).guard) n | zig-occurs ((list-at bs i).body) n
      | zig-occurs-branches bs (i + 1) n

  zig-occurs-stmts : List IRActStmt, Integer, Text -> Boolean
  zig-occurs-stmts (ss) (i) (n) =
   if i >= list-length ss then False
   else (when (list-at ss i)
    is IrDoBind (m) (ty) (v) (sp) -> zig-occurs v n
    is IrDoExec (e) (sp) -> zig-occurs e n) | zig-occurs-stmts ss (i + 1) n

  zig-occurs-fields : List IRFieldVal, Integer, Text -> Boolean
  zig-occurs-fields (fs) (i) (n) =
   if i >= list-length fs then False
   else zig-occurs ((list-at fs i).value) n | zig-occurs-fields fs (i + 1) n

 A handled effect emits its body and NOTHING ELSE, which is right only
 while there are no clauses to run: a handle with clauses that emits just
 its body is a different program that compiles, the same trap IrVecPat set
 when an unimplemented pattern rendered as a catch-all. With clauses it
 refuses by name instead. This one is latent -- no subject in the ladder
 reaches an effect handler yet -- and it is written down now because the
 cost of finding it later is a wrong answer rather than an error.

 IrWithTimeout, IrFork and IrAwait below drop a timeout, a fork and a wait
 the same way. They are left alone deliberately: running the body inline is
 a defensible reading of each for a single-threaded target, where dropping
 a clause that was written to run is not.

  emit-zig-expr : IRExpr, ZigCtx, Integer -> Text
  emit-zig-expr (e) (ctx) (d) =
   if d >= zig-max-depth then zig-refuse ("expression nested past zig-max-depth (" & integer-to-text zig-max-depth & "); raise the cap")
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> "@as(f64, @bitCast(@as(i64, " & integer-to-text n & ")))"
    is IrTextLit (s) (sp) -> "\"" & zig-escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> emit-zig-name n ty ctx d
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-zig-binary op l r ctx d
    is IrNegate (operand) (nty) (sp) ->
     if zig-is-real-type nty then "(-" & emit-zig-expr operand ctx (d + 1) & ")"
     else "(-%" & emit-zig-expr operand ctx (d + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> zig-pin-lit t el ("(if (" & emit-zig-expr c ctx (d + 1) & ") " & emit-zig-if-branch t ty el (zig-expect ctx ty) d & " else " & emit-zig-if-branch el ty t (zig-expect ctx ty) d & ")")
    is IrLet (name) (ty) (val) (body) (sp) ->
     if zig-is-seq-name name then zig-label d & ": { _ = " & emit-zig-expr val ctx (d + 1) & "; break :" & zig-label d & " " & emit-zig-expr body ctx (d + 1) & "; }"
     else if zig-occurs body name then zig-label d & ": { const " & zig-bind-name ctx name d & zig-let-annot ty & " = " & emit-zig-expr val ctx (d + 1) & "; break :" & zig-label d & " " & emit-zig-expr body (zig-bind-push ctx name d) (d + 1) & "; }"
     else zig-label d & ": { _ = " & emit-zig-expr val ctx (d + 1) & "; break :" & zig-label d & " " & emit-zig-expr body ctx (d + 1) & "; }"
    is IrApply (f) (a) (ty) (sp) -> emit-zig-apply e ctx d
    is IrLambda (params) (body) (ty) (sp) -> zig-lambda-closure params body ty ctx d
    is IrList (elems) (ty) (sp) -> emit-zig-list elems ty ctx d
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-zig-match scrut branches ctx d ty zig-tail-none
    is IrAct (stmts) (ty) (sp) -> emit-zig-act stmts ctx d (zig-type-is-void ty)
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> if list-length clauses == 0 then emit-zig-expr body ctx (d + 1) else "@compileError(\"zig plug: effect handlers not supported\")"
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-zig-expr body ctx (d + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-zig-record name fields ctx d ty
    is IrFieldAccess (rec) (field) (ty) (sp) -> zig-field-receiver rec ctx d & "." & zig-field-name field
    is IrFieldStore (rec) (field) (val) (ty) (sp) ->
     let stored = zig-clamp-field-val ctx (zig-type-name-of (zig-expr-type rec)) (zig-plain-field-name field) (emit-zig-expr val ctx (d + 1))
     in zig-label d & ": { const _r = " & emit-zig-expr rec ctx (d + 1) & "; _r." & zig-field-name field & " = " & stored & "; break :" & zig-label d & " _r; }"
    is IrFork (body) (ty) (sp) -> emit-zig-expr body ctx (d + 1)
    is IrAwait (task) (ty) (sp) -> emit-zig-expr task ctx (d + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-zig-act body ctx d (zig-type-is-void ty)
    is IrError (msg) (ty) (sp) -> "@panic(\"" & zig-escape-text msg & "\")"

 Text is CCE bytes on bare metal, and the faithful port keeps it that
 way: every literal emits as raw hex escapes of its internal bytes, so
 the zig lexer sees byte-for-byte what the bare-metal lexer sees. The
 runtime decodes to UTF-8 only at the print boundary.

  zig-hex-digit : Integer -> Text
  zig-hex-digit (d) = substring "0123456789abcdef" d 1

 Escaping collects each 256-byte chunk's escapes in a list and joins once,
 and the chunks likewise -- the shape CSharpPlug's bytes-to-text uses, for
 the same reason. The obvious right-recursive `"\\x" & hi & lo & rest`
 copies the whole remaining tail at every byte, so escaping N bytes
 allocates about 2*N^2: 575 MB for a 17 KB literal, which fits, and 21 GB
 for a 102 KB one, which does not. That is what stopped the emitter on
 Parser.codex while ParserCore went through.

  zig-escape-text : Text -> Text
  zig-escape-text (s) =
   text-concat-list (zig-escape-chunks s 0 (text-length s) [])

  zig-escape-chunks : Text, Integer, Integer, List Text -> List Text
  zig-escape-chunks (s) (off) (total) (acc) =
   if off >= total then acc
   else let stop = if off + 256 > total then total else off + 256
   in let chunk = text-concat-list (zig-escape-chunk s off stop [])
   in zig-escape-chunks s stop total (list-push acc chunk)

  zig-escape-chunk : Text, Integer, Integer, List Text -> List Text
  zig-escape-chunk (s) (i) (stop) (acc) =
   if i >= stop then acc
   else let b = char-code-at s i
   in let esc = "\\x" & zig-hex-digit (bit-shr b 4) & zig-hex-digit (bit-and b 15)
   in zig-escape-chunk s (i + 1) stop (list-push acc esc)

Section: Lambda and List Helpers

 An if whose branches are number literals peer-resolves to comptime_int or
 comptime_float, and zig refuses to let a comptime-only value come out of a
 runtime branch: `(moved.dead + (if (dead.ok) 0 else 1))` is rejected even
 though the addition would have coerced it. Codex's Integer is i64 wherever
 it lands and its Real is f64, so the if names that type outright and peer
 resolution has a runtime type to agree on. Only a literal branch needs it;
 every other expression already carries a runtime type of its own.

  zig-is-int-lit : IRExpr -> Boolean
  zig-is-int-lit (e) =
   when e
    is IrIntLit (n) (sp) -> True
    is otherwise -> False

  zig-is-num-lit : IRExpr -> Boolean
  zig-is-num-lit (e) =
   when e
    is IrNumLit (n) (sp) -> True
    is otherwise -> False

  zig-pin-lit : IRExpr, IRExpr, Text -> Text
  zig-pin-lit (t) (el) (s) =
   if zig-is-int-lit t | zig-is-int-lit el then "@as(i64, " & s & ")"
   else if zig-is-num-lit t | zig-is-num-lit el then "@as(f64, " & s & ")"
   else s

 A synthesized lambda -- every `for` expression becomes one, since the
 desugarer rewrites `for` into map-list -- carries no useful type on its
 parameters, so reading p.type-val emits anyopaque, which zig refuses as a
 parameter type outright. The lambda's OWN type is the function type, so
 its spine has the answer; the parameter annotation is only the fallback.

 A lambda captures whatever enclosing locals its body names, and the plug
 has to build that environment by hand. Nothing lifts lambdas before the IR
 arrives, so `map-list (\a -> resolve-type-expr tdm a) args` reaches here
 still naming tdm, a parameter of the definition around it. Zig admits a
 comptime constant into a nested function and refuses a runtime value, so
 the capture is copied into the environment struct the closure already
 carries for partial application, and the body reads it back through the
 environment pointer.

 Each capture's field type is `@TypeOf` of the value, hoisted into a
 constant OUTSIDE the struct: the struct's own field types are read from
 within it, where the enclosing local is exactly what zig will not let us
 name. Naming the type would mean tracking a type for every local, and
 @TypeOf already knows.

  zig-push-bound : ZigCtx, Text -> ZigCtx
  zig-push-bound (ctx) (n) =
   ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = ctx.renamed-from,
    renamed-to = ctx.renamed-to,
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ctx.expected,
    bound-names = (ctx.bound-names) & [n],
    scope-tvars = ctx.scope-tvars
   }

 Zig forbids a local from shadowing a top-level declaration or an
 enclosing local, and codex allows both. Definition parameters already
 rename through zig-param-shadows; every other binder -- let, act bind,
 match capture, pattern unpack -- goes through zig-bind-name for its
 emitted spelling and zig-bind-push for the context its body sees. The
 renamed form is depth-suffixed, and depths differ along any nesting
 path, so renamed binders cannot collide with each other.

  zig-binder-shadows : ZigCtx, Text -> Boolean
  zig-binder-shadows (ctx) (n) =
   (zig-find-irdef (ctx.irdefs) 0 n >= 0) | zig-in-texts (ctx.bound-names) n 0

  zig-bind-name : ZigCtx, Text, Integer -> Text
  zig-bind-name (ctx) (n) (d) =
   if zig-binder-shadows ctx n then "_v" & integer-to-text d & "_" & zig-raw-ident n
   else zig-sanitize n

  zig-bind-push : ZigCtx, Text, Integer -> ZigCtx
  zig-bind-push (ctx) (n) (d) =
   let ctx1 = if zig-binder-shadows ctx n
    then zig-rename-to ctx n ("_v" & integer-to-text d & "_" & zig-raw-ident n)
    else ctx
   in zig-push-bound ctx1 n

  zig-push-bound-params : ZigCtx, List IRParam, Integer -> ZigCtx
  zig-push-bound-params (ctx) (params) (i) =
   if i >= list-length params then ctx
   else let ctx2 = zig-push-bound ctx ((list-at params i).name)
   in zig-push-bound-params ctx2 params (i + 1)

  zig-push-bound-pats : ZigCtx, List IRPat, Integer, Integer -> ZigCtx
  zig-push-bound-pats (ctx) (subs) (i) (d) =
   if i >= list-length subs then ctx
   else let b = zig-pat-binder (list-at subs i) i
   in let ctx2 = if b == "_" then ctx else zig-bind-push ctx b d
   in zig-push-bound-pats ctx2 subs (i + 1) d

 A bound name is a local by construction, so it resolves without the
 constructor and nullary-definition arms emit-zig-name has to consider.
 Going through those would let a local named like a builtin resolve to the
 builtin at the one place where being wrong is silent: the capture's
 initializer would read a different value than the body does.

  zig-local-ref : ZigCtx, Text -> Text
  zig-local-ref (ctx) (n) =
   let r = zig-renamed ctx n
   in if text-length r > 0 then r else zig-sanitize n

  zig-params-have : List IRParam, Text, Integer -> Boolean
  zig-params-have (params) (n) (i) =
   if i >= list-length params then False
   else if (list-at params i).name == n then True
   else zig-params-have params n (i + 1)

  zig-captures : ZigCtx, IRExpr, List IRParam, Integer, List Text -> List Text
  zig-captures (ctx) (body) (params) (i) (acc) =
   if i >= list-length (ctx.bound-names) then acc
   else let n = list-at (ctx.bound-names) i
   in let fresh = (zig-in-texts acc n 0 == False) & (zig-params-have params n 0 == False)
   in let acc2 = if zig-occurs body n & fresh then acc & [n] else acc
   in zig-captures ctx body params (i + 1) acc2

  zig-capture-type-decls : ZigCtx, List Text, Integer, Integer -> Text
  zig-capture-type-decls (ctx) (caps) (i) (d) =
   if i >= list-length caps then ""
   else "const _Cap" & integer-to-text d & "_" & integer-to-text i & " = @TypeOf("
    & zig-local-ref ctx (list-at caps i) & "); "
    & zig-capture-type-decls ctx caps (i + 1) d

  zig-capture-fields : List Text, Integer, Integer -> Text
  zig-capture-fields (caps) (i) (d) =
   if i >= list-length caps then ""
   else "c" & integer-to-text i & ": _Cap" & integer-to-text d & "_" & integer-to-text i & ", "
    & zig-capture-fields caps (i + 1) d

  zig-capture-inits : ZigCtx, List Text, Integer -> Text
  zig-capture-inits (ctx) (caps) (i) =
   if i >= list-length caps then ""
   else " .c" & integer-to-text i & " = " & zig-local-ref ctx (list-at caps i) & ","
    & zig-capture-inits ctx caps (i + 1)

  zig-push-capture-renames : ZigCtx, List Text, Integer, Text -> ZigCtx
  zig-push-capture-renames (ctx) (caps) (i) (ev) =
   if i >= list-length caps then ctx
   else let ctx2 = zig-rename-to ctx (list-at caps i) (ev & ".c" & integer-to-text i)
   in zig-push-capture-renames ctx2 caps (i + 1) ev

  zig-rename-to : ZigCtx, Text, Text -> ZigCtx
  zig-rename-to (ctx) (from) (to) =
   ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = (ctx.renamed-from) & [from],
    renamed-to = (ctx.renamed-to) & [to],
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ctx.expected,
    bound-names = ctx.bound-names,
    scope-tvars = ctx.scope-tvars
   }

  zig-lambda-param-types : List IRParam, Integer, CodexType, ZigCtx -> Text
  zig-lambda-param-types (params) (i) (ty) (ctx) =
   if i >= list-length params then ""
   else let one = zig-lambda-param-type ty i (list-at params i) ctx
   in if i == list-length params - 1 then one
      else one & ", " & zig-lambda-param-types params (i + 1) ty ctx

 The body continues the enclosing depth rather than restarting at 0. A
 lambda becomes a `fn` inside a struct inside a block, and a zig fn does not
 close over locals -- but zig's shadowing rules still read the whole lexical
 path, so a restart makes the body's `_p0`, `_r0` and `b0` collide with the
 arm capture, record temp and label of whatever scope the lambda sits in.
 Only a top-level def may emit its body at 0, because nothing encloses it.

  zig-lambda-closure : List IRParam, IRExpr, CodexType, ZigCtx, Integer -> Text
  zig-lambda-closure (params) (body) (ty) (ctx) (d) =
   let lbl = zig-label d
   in let env = "_Env" & integer-to-text d
   in let ev = "_e" & integer-to-text d
   in let cx = "_ctx" & integer-to-text d
   in let caps = zig-captures ctx body params 0 []
   in let ret = emit-zig-type (zig-peel-return ty (list-length params)) (ctx.scope-tvars)
   in let captured = zig-push-capture-renames ctx caps 0 ev
   in let inner = zig-push-lambda-renames captured params d 0
   in let unpack = if list-length caps == 0 then "_ = " & cx & "; "
      else "const " & ev & ": *@This() = @ptrCast(@alignCast(" & cx & ")); "
   in let discards = zig-lambda-unused-discards params body d 0
   in lbl & ": { " & zig-capture-type-decls ctx caps 0 d & "const " & env
    & " = struct { " & zig-capture-fields caps 0 d & "fn call(" & cx & ": *anyopaque, "
    & emit-zig-lambda-params params 0 ty d ctx & ") " & ret
    & " { " & unpack & discards & "return " & emit-zig-expr body inner (d + 1) & "; } }; break :"
    & lbl & " " & zig-closure-type (list-length params) (zig-lambda-param-types params 0 ty ctx) ret
    & "{ .ctx = cx_new(" & env & "{" & zig-capture-inits ctx caps 0 & "}), .call = &" & env & ".call }; }"

 Zig refuses an unused function parameter, and a codex lambda may
 legitimately ignore one -- the builtin table's `\s a -> f s` entries
 do. A parameter the body never names gets an explicit discard beside
 the environment unpack.

  zig-lambda-unused-discards : List IRParam, IRExpr, Integer, Integer -> Text
  zig-lambda-unused-discards (params) (body) (d) (i) =
   if i >= list-length params then ""
   else let p = list-at params i
   in let one = if zig-occurs body (p.name) then "" else "_ = " & zig-lambda-param-name (p.name) d & "; "
   in one & zig-lambda-unused-discards params body d (i + 1)

  zig-lambda-param-type : CodexType, Integer, IRParam, ZigCtx -> Text
  zig-lambda-param-type (ty) (i) (p) (ctx) =
   let fromty = zig-fn-nth-param (zig-subst-ctx ty ctx) i (ctx.scope-tvars)
   in if text-length fromty > 0 then fromty
      else emit-zig-type (zig-subst-ctx (p.type-val) ctx) (ctx.scope-tvars)

  zig-fn-nth-param : CodexType, Integer, List (Integer between 0 and 4294967295) -> Text
  zig-fn-nth-param (ty) (i) (scope) =
   when zig-fn-spine ty
    is FunTy (p) (fnrow) (r) -> if i == 0 then emit-zig-type p scope else zig-fn-nth-param r (i - 1) scope
    is otherwise -> ""

  emit-zig-lambda-params : List IRParam, Integer, CodexType, Integer, ZigCtx -> Text
  emit-zig-lambda-params (params) (i) (ty) (d) (ctx) =
   if i == list-length params then ""
   else let p = list-at params i
   in let one = zig-lambda-param-name (p.name) d & ": " & zig-lambda-param-type ty i p ctx
   in if i == list-length params - 1 then one
   else one & ", " & emit-zig-lambda-params params (i + 1) ty d ctx

 A literal with elements carries its own answer: the first element's type
 is what the list holds, and it needs no context at all. The annotation
 still wins when it is a real list type, since a list can hold something
 wider than its first element.

 The two arms of an if have one type, so an empty list in one of them can
 read it off the if itself, or failing that off the other arm. That is the
 fourth context an empty list can learn from, after a record field decl,
 a callee's parameter and a constructor payload.

  emit-zig-if-branch : IRExpr, CodexType, IRExpr, ZigCtx, Integer -> Text
  emit-zig-if-branch (b) (ity) (other) (ctx) (d) =
   if zig-is-empty-list b
   then let own = zig-ll-elem-opt ity (ctx.scope-tvars)
    in let elem = if text-length own > 0 then own else zig-ll-elem-opt (zig-expr-type other) (ctx.scope-tvars)
    in if text-length elem > 0 then "cx_ll_empty(" & elem & ")"
       else emit-zig-expr b ctx (d + 1)
   else emit-zig-expr b ctx (d + 1)

 IrList CARRIES ITS ELEMENT TYPE, NOT ITS OWN TYPE. IRChapter's
 `ir-expr-type` is the authority and says so: `is IrList (es) (t) (s)
 -> ListTy t`. This read it as the list type and peeled a level off,
 which is invisible for scalar elements -- peeling Integer answers
 nothing, and the first-element fallback beneath it is right -- and
 wrong by exactly one level for a list OF lists: `List (List Boolean)`
 emitted as a list of bool. Six rungs never built one.

  emit-zig-list : List IRExpr, CodexType, ZigCtx, Integer -> Text
  emit-zig-list (elems) (ty) (ctx) (d) =
   let annotated = zig-elem-annotation ty (ctx.scope-tvars)
   in let et = if text-length annotated > 0 then annotated
      else if list-length elems > 0 then emit-zig-type (zig-expr-type (list-at elems 0)) (ctx.scope-tvars)
      else let fromctx = zig-ll-elem-opt (ctx.expected) (ctx.scope-tvars)
       in if text-length fromctx > 0 then fromctx
          else "@compileError(\"zig plug: no element type for this empty list\")"
   in if list-length elems == 0 then "cx_ll_empty(" & et & ")"
      else "cx_ll_of(" & et & ", &[_]" & et & "{ " & emit-zig-list-elems elems 0 ctx d & " })"

  emit-zig-list-elems : List IRExpr, Integer, ZigCtx, Integer -> Text
  emit-zig-list-elems (elems) (i) (ctx) (d) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-zig-expr (list-at elems i) ctx (d + 1)
   else emit-zig-expr (list-at elems i) ctx (d + 1) & ", " & emit-zig-list-elems elems (i + 1) ctx d

Section: Record Emission

 An empty list stored into a record field reads its element type off the
 field's declaration. Both the literal `Rec { f = [] }` and the update
 `__record-set r "f" []` land here, and they used to disagree: only the
 literal looked the field up, so an update fell through to the no-context
 marker.

  zig-field-value-text : Text, Text, IRExpr, ZigCtx, Integer, CodexType -> Text
  zig-field-value-text (recname) (fieldname) (v) (ctx) (d) (rty) =
   let raw = (if zig-is-empty-list v == False then emit-zig-expr v ctx (d + 1)
      else let elem = zig-record-field-ll-elem ctx recname fieldname rty
      in if text-length elem > 0 then "cx_ll_empty(" & elem & ")"
         else emit-zig-expr v ctx (d + 1))
   in zig-clamp-field-val ctx recname fieldname raw

 A clamping bounded field saturates on every store, not only at
 construction: on bare metal, record literals, __record-set and field
 stores all reach emit-clamping-checked-store. The three emission sites
 here funnel through this lookup so they cannot drift apart.

  zig-clamp-field-val : ZigCtx, Text, Text, Text -> Text
  zig-clamp-field-val (ctx) (recname) (fieldname) (val-text) =
   zig-clamp-def-scan (ctx.typedefs) 0 recname fieldname val-text

  zig-clamp-def-scan : List ATypeDef, Integer, Text, Text, Text -> Text
  zig-clamp-def-scan (tds) (i) (recname) (fieldname) (val-text) =
   if i >= list-length tds then val-text
   else when (list-at tds i)
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     if name.value == recname then zig-clamp-field-scan fields 0 fieldname val-text
     else zig-clamp-def-scan tds (i + 1) recname fieldname val-text
    is otherwise -> zig-clamp-def-scan tds (i + 1) recname fieldname val-text

  zig-clamp-field-scan : List ARecordFieldDef, Integer, Text, Text -> Text
  zig-clamp-field-scan (fields) (i) (fieldname) (val-text) =
   if i >= list-length fields then val-text
   else let f = list-at fields i
   in if f.name.value == fieldname then zig-clamp-atype (f.type-expr) val-text
      else zig-clamp-field-scan fields (i + 1) fieldname val-text

  zig-clamp-atype : ATypeExpr, Text -> Text
  zig-clamp-atype (te) (val-text) =
   when te
    is ABoundedIntType (b) (lo) (hi) (mode) (s) ->
     when mode
      is OvClamping -> "std.math.clamp(" & val-text & ", " & integer-to-text lo & ", " & integer-to-text hi & ")"
      is otherwise -> val-text
    is otherwise -> val-text

 A record literal is a curly-suffix expression in zig's grammar and no
 suffix may follow it directly: Gauge{ .g = n }.g is a parse error where
 (Gauge{ .g = n }).g is not.

  zig-field-receiver : IRExpr, ZigCtx, Integer -> Text
  zig-field-receiver (rec) (ctx) (d) =
   when rec
    is IrRecord (n) (fs) (t) (s) -> "(" & emit-zig-expr rec ctx (d + 1) & ")"
    is otherwise -> emit-zig-expr rec ctx (d + 1)

  emit-zig-record : Text, List IRFieldVal, ZigCtx, Integer, CodexType -> Text
  emit-zig-record (name) (fields) (ctx) (d) (rty) =
   "cx_new(" & zig-sanitize name & "S" & zig-ctor-type-args rty (ctx.scope-tvars)
    & "{ " & emit-zig-record-vals name fields 0 ctx d rty & " })"

  emit-zig-record-vals : Text, List IRFieldVal, Integer, ZigCtx, Integer, CodexType -> Text
  emit-zig-record-vals (recname) (fields) (i) (ctx) (d) (rty) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in let val = zig-field-value-text recname (zig-plain-field-name (f.name)) (f.value) ctx d rty
   in sep & "." & zig-field-name (f.name) & " = " & val & emit-zig-record-vals recname fields (i + 1) ctx d rty

Section: Match Emission

 Codex allows a catch-all after every constructor has been named; zig
 rejects the else prong as unreachable once the switch is exhaustive. When
 the arms already cover the union the catch-all is dropped, which is
 semantics-preserving precisely because it cannot be reached. Miscounting
 costs a non-exhaustive-switch error rather than a wrong program.

  zig-type-name-of : CodexType -> Text
  zig-type-name-of (ty) =
   when ty
    is SumTy (n) (a) (c) -> n.value
    is RecordTy (n) (a) (f) -> n.value
    is ConstructedTy (n) (a) -> n.value
    is EffectfulTy (effs) (scopes) (inner) -> zig-type-name-of inner
    is otherwise -> ""

  zig-variant-ctor-count : List ATypeDef, Integer, Text -> Integer
  zig-variant-ctor-count (tds) (i) (name) =
   if i >= list-length tds then 0
   else when (list-at tds i)
    is AVariantTypeDef (nm) (tparams) (ctors) (s) ->
     if nm.value == name then list-length ctors
     else zig-variant-ctor-count tds (i + 1) name
    is otherwise -> zig-variant-ctor-count tds (i + 1) name

  zig-count-ctor-pats : List IRBranch, Integer -> Integer
  zig-count-ctor-pats (bs) (i) =
   if i >= list-length bs then 0
   else let inc = when ((list-at bs i).pattern)
     is IrCtorPat (name) (subs) (ty) (sp) -> 1
     is otherwise -> 0
   in inc + zig-count-ctor-pats bs (i + 1)

  zig-match-exhaustive : ZigCtx, CodexType, List IRBranch -> Boolean
  zig-match-exhaustive (ctx) (ty) (branches) =
   let n = zig-variant-ctor-count (ctx.typedefs) 0 (zig-type-name-of ty)
   in if n == 0 then False else zig-count-ctor-pats branches 0 >= n

 Every arm of a match has the match's type, so an empty list in one reads
 it off the match -- the fifth context an empty list can learn from, after
 a record field, a callee parameter, a constructor payload and an if arm.

  emit-zig-match : IRExpr, List IRBranch, ZigCtx, Integer, CodexType, ZigTail -> Text
  emit-zig-match (scrut) (branches) (ctx) (d) (mty0) (tl) =
   let mty = if text-length (zig-ll-elem-opt mty0 (ctx.scope-tvars)) > 0 then mty0
      else zig-arms-list-type branches 0 mty0 (ctx.scope-tvars)
   in let ex = zig-match-exhaustive ctx (zig-expr-type scrut) branches
   in if zig-branches-guarded branches 0 then emit-zig-match-chain scrut branches ctx d mty
   else zig-pin-lit-arms branches 0 ("switch (" & emit-zig-expr scrut ctx (d + 1) & zig-match-deref ctx (zig-expr-type scrut) & ") { " & emit-zig-match-arms branches 0 ctx d ex mty tl & " }")

 A zig `switch` prong refuses a value an earlier prong already names --
 `error: duplicate switch value`, an error rather than a warning. Codex permits
 the shape, because first-match-wins makes the later arm dead, and an
 or-pattern expands on the wire into one branch per alternative, so a source
 arm overlapping an earlier one arrives here as a second prong for the same
 value. The duplicate cannot fire on any target, so it is DROPPED rather than
 translated, which is the route the csharp plug took for CS8510.

 Only a trivially-guarded earlier arm shadows. A guarded arm can decline at
 runtime, which leaves the later prong reachable, and zig accepts that shape.

 `zig-pat-switch-value` answers "" for every pattern that is not a bare prong
 value -- a constructor carrying payloads binds names and is not a duplicate of
 anything, and a var or wildcard is the else arm. Two empty answers are
 therefore NOT equal for this purpose, which the emptiness test in
 `zig-arm-shadowed` is there to say.

  zig-pat-switch-value : IRPat -> Text
  zig-pat-switch-value (pat) =
   when pat
    is IrLitPat (text) (ty) (sp) -> zig-lit-pat-text text ty
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if list-length subs == 0 then "." & zig-sanitize name else ""
    is otherwise -> ""

  zig-arm-shadowed : List IRBranch, Integer, Text -> Boolean
  zig-arm-shadowed (branches) (j) (sv) =
   if sv == "" then False
   else if j <= 0 then False
   else let b = list-at branches (j - 1)
   in if (zig-guard-trivial (b.guard)) & (zig-pat-switch-value (b.pattern) == sv) then True
      else zig-arm-shadowed branches (j - 1) sv

  emit-zig-match-arms : List IRBranch, Integer, ZigCtx, Integer, Boolean, CodexType, ZigTail -> Text
  emit-zig-match-arms (branches) (i) (ctx) (d) (ex) (mty) (tl) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in if zig-arm-shadowed branches i (zig-pat-switch-value (b.pattern))
      then emit-zig-match-arms branches (i + 1) ctx d ex mty tl
   else emit-zig-match-arm (b.pattern) (b.body) (zig-expect ctx mty) d ex mty tl
      & emit-zig-match-arms branches (i + 1) ctx d ex mty tl

 Constructor arms bind payloads: one field binds by name directly; a
 tuple payload binds `_p<d>` and unpacks into consts inside a labeled
 block so the arm body sees its pattern variables.

 A match's own type is not always resolved -- here the switch is the else
 arm of an if, and the if carries the type. The arms are all the same type
 as each other, so an arm that is not an empty list answers for the ones
 that are. Same trick the if branches use on each other.

  zig-arms-list-type : List IRBranch, Integer, CodexType, List (Integer between 0 and 4294967295) -> CodexType
  zig-arms-list-type (branches) (i) (fallback) (scope) =
   if i >= list-length branches then fallback
   else let b = list-at branches i
   in if zig-is-empty-list (b.body) then zig-arms-list-type branches (i + 1) fallback scope
   else let t = zig-expr-type (b.body)
   in if text-length (zig-ll-elem-opt t scope) > 0 then t
      else zig-arms-list-type branches (i + 1) fallback scope

 EVERY arm's body goes through here, binders and catch-all included.
 Only the two binderless shapes did, so an empty list in an `else` arm
 or under a capture had no type to read and fell to the marker while
 its sibling arm three lines above was typed correctly.

  emit-zig-arm-body : IRExpr, CodexType, ZigCtx, Integer -> Text
  emit-zig-arm-body (body) (mty) (ctx) (d) =
   if zig-is-empty-list body
   then let elem = zig-ll-elem-opt mty (ctx.scope-tvars)
    in let elem2 = if text-length elem > 0 then elem else zig-ll-elem-opt (ctx.expected) (ctx.scope-tvars)
    in if text-length elem2 > 0 then "cx_ll_empty(" & elem2 & ")"
       else emit-zig-expr body ctx (d + 1)
   else emit-zig-expr body ctx (d + 1)

  zig-pat-is-catch-all : IRPat -> Boolean
  zig-pat-is-catch-all (pat) =
   when pat
    is IrVarPat (name) (ty) (sp) -> True
    is IrWildPat (sp) -> True
    is otherwise -> False

 An arm body is emitted one of two ways and the choice is the same for
 every arm shape, so it is a flag rather than a second arm emitter: a
 duplicate of this walk is exactly the sibling-mechanism drift the
 renamed-scan and subst-all pair already cost once. When the tail record
 is active the body is a statement block, and a self-call inside it
 continues the enclosing loop instead of returning a value.

  emit-zig-arm-body-tail : IRExpr, CodexType, ZigCtx, Integer, ZigTail -> Text
  emit-zig-arm-body-tail (body) (mty) (ctx) (d) (tl) =
   if zig-tail-active tl
   then "{ " & emit-zig-tail body ctx (d + 1) tl & " }"
   else emit-zig-arm-body body mty ctx d

 A prong that unpacks a tuple payload binds inside a labeled block, which
 is an expression; in tail form the same unpacking has to sit in a plain
 block instead, because `break` cannot carry a `continue` out of it.

  emit-zig-match-arm : IRPat, IRExpr, ZigCtx, Integer, Boolean, CodexType, ZigTail -> Text
  emit-zig-match-arm (pat) (body0) (ctx) (d) (ex) (mty) (tl) =
   let body = body0
   in if ex & zig-pat-is-catch-all pat then ""
   else when pat
    is IrLitPat (text) (ty) (sp) -> zig-lit-pat-text text ty & " => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let nsubs = list-length subs
     in if nsubs == 0 then "." & zig-sanitize name & " => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
     else if nsubs == 1 then
      let binder = zig-pat-binder (list-at subs 0) 0
      in if (binder == "_") | (zig-occurs body binder == False)
         then "." & zig-sanitize name & " => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
         else "." & zig-sanitize name & " => |" & zig-bind-name ctx binder d & "| " & emit-zig-arm-body-tail body mty (zig-bind-push ctx binder d) d tl & ", "
     else if zig-any-sub-occurs subs 0 body == False
     then "." & zig-sanitize name & " => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
     else if zig-tail-active tl
     then "." & zig-sanitize name & " => |_p" & integer-to-text d & "| { " & emit-zig-pat-unpack subs 0 d body ctx & emit-zig-tail body (zig-push-bound-pats ctx subs 0 d) (d + 1) tl & " }, "
     else "." & zig-sanitize name & " => |_p" & integer-to-text d & "| " & zig-label d & ": { " & emit-zig-pat-unpack subs 0 d body ctx & "break :" & zig-label d & " " & emit-zig-arm-body body mty (zig-push-bound-pats ctx subs 0 d) d & "; }, "
    is IrVarPat (name) (ty) (sp) -> "else => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
    is IrWildPat (sp) -> "else => " & emit-zig-arm-body-tail body mty ctx d tl & ", "
    is IrVecPat (pats) (ty) (sp) -> "@compileError(\"zig plug: vector patterns not supported\"), "

  zig-any-sub-occurs : List IRPat, Integer, IRExpr -> Boolean
  zig-any-sub-occurs (subs) (i) (body) =
   if i >= list-length subs then False
   else let binder = zig-pat-binder (list-at subs i) i
   in if (binder == "_") == False & zig-occurs body binder then True
      else zig-any-sub-occurs subs (i + 1) body

 The binder comes back as the IR spells it, not as zig spells it, because
 its first job is to be looked up in the IR by zig-occurs. Sanitizing here
 instead made every hyphenated binder invisible to that lookup -- `st-effs`
 was searched for as `st_effs`, never found, and its capture was dropped as
 unused, so the arm referred to a name it had not bound. Callers sanitize at
 the point of emission.

  zig-pat-binder : IRPat, Integer -> Text
  zig-pat-binder (p) (i) =
   when p
    is IrVarPat (name) (ty) (sp) -> name
    is otherwise -> "_"

  emit-zig-pat-unpack : List IRPat, Integer, Integer, IRExpr, ZigCtx -> Text
  emit-zig-pat-unpack (subs) (i) (d) (body) (ctx) =
   if i == list-length subs then ""
   else let binder = zig-pat-binder (list-at subs i) i
   in let line = if (binder == "_") | (zig-occurs body binder == False) then ""
      else "const " & zig-bind-name ctx binder d & " = _p" & integer-to-text d & "[" & integer-to-text i & "]; "
   in line & emit-zig-pat-unpack subs (i + 1) d body ctx

 A zig switch prong that matches fires; there is no fall-through to the
 next prong when a guard refuses, and two prongs on one constructor are a
 duplicate-value error. A guarded match is therefore a labeled block of
 if-statements ending in unreachable.

  zig-guard-trivial : IRExpr -> Boolean
  zig-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  zig-branches-guarded : List IRBranch, Integer -> Boolean
  zig-branches-guarded (bs) (i) =
   if i >= list-length bs then False
   else if zig-guard-trivial ((list-at bs i).guard) == False then True
   else zig-branches-guarded bs (i + 1)

  zig-occurs-either : IRExpr, IRExpr, Text -> Boolean
  zig-occurs-either (a) (b) (n) = zig-occurs a n | zig-occurs b n

  zig-chain-scrut : Integer -> Text
  zig-chain-scrut (d) = "_s" & integer-to-text d

  zig-chain-uses-scrut : List IRBranch, Integer -> Boolean
  zig-chain-uses-scrut (bs) (i) =
   if i >= list-length bs then False
   else let b = list-at bs i
   in let used = when (b.pattern)
     is IrVarPat (name) (ty) (sp) -> zig-occurs-either (b.body) (b.guard) name
     is IrWildPat (sp) -> False
     is otherwise -> True
   in used | zig-chain-uses-scrut bs (i + 1)

  zig-pin-lit-arms : List IRBranch, Integer, Text -> Text
  zig-pin-lit-arms (bs) (i) (s) =
   if i >= list-length bs then s
   else if zig-is-int-lit ((list-at bs i).body) then "@as(i64, " & s & ")"
   else if zig-is-num-lit ((list-at bs i).body) then "@as(f64, " & s & ")"
   else zig-pin-lit-arms bs (i + 1) s

  emit-zig-match-chain : IRExpr, List IRBranch, ZigCtx, Integer, CodexType -> Text
  emit-zig-match-chain (scrut) (branches) (ctx) (d) (mty) =
   let sv = zig-chain-scrut d
   in let discard = if zig-chain-uses-scrut branches 0 then "" else "_ = " & sv & "; "
   in zig-pin-lit-arms branches 0 (zig-label d & ": { const " & sv & " = " & emit-zig-expr scrut ctx (d + 1) & zig-match-deref ctx (zig-expr-type scrut) & "; " & discard
      & emit-zig-chain-arms branches 0 (zig-expect ctx mty) d mty sv & "}")

  emit-zig-chain-arms : List IRBranch, Integer, ZigCtx, Integer, CodexType, Text -> Text
  emit-zig-chain-arms (branches) (i) (ctx) (d) (mty) (sv) =
   if i >= list-length branches then "unreachable; "
   else let b = list-at branches i
   in let arm = emit-zig-chain-arm (b.pattern) (b.guard) (b.body) ctx d mty sv
   in if zig-pat-is-catch-all (b.pattern) & zig-guard-trivial (b.guard) then arm
      else arm & emit-zig-chain-arms branches (i + 1) ctx d mty sv

  emit-zig-chain-tail : IRExpr, IRExpr, ZigCtx, Integer, CodexType -> Text
  emit-zig-chain-tail (guard) (body) (ctx) (d) (mty) =
   let leave = "break :" & zig-label d & " " & emit-zig-arm-body body mty ctx d & "; "
   in if zig-guard-trivial guard then leave
      else "if (" & emit-zig-expr guard ctx (d + 1) & ") " & leave

  emit-zig-chain-arm : IRPat, IRExpr, IRExpr, ZigCtx, Integer, CodexType, Text -> Text
  emit-zig-chain-arm (pat) (guard) (body) (ctx) (d) (mty) (sv) =
   when pat
    is IrLitPat (text) (ty) (sp) -> "if (" & sv & " == " & zig-lit-pat-text text ty & ") { " & emit-zig-chain-tail guard body ctx d mty & "} "
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let nsubs = list-length subs
     in let test = "if (" & sv & " == ." & zig-sanitize name & ") { "
     in if nsubs == 0 then test & emit-zig-chain-tail guard body ctx d mty & "} "
     else if nsubs == 1 then
      let binder = zig-pat-binder (list-at subs 0) 0
      in if (binder == "_") | (zig-occurs-either body guard binder == False)
         then test & emit-zig-chain-tail guard body ctx d mty & "} "
         else test & "const " & zig-bind-name ctx binder d & " = " & sv & "." & zig-sanitize name & "; " & emit-zig-chain-tail guard body (zig-bind-push ctx binder d) d mty & "} "
     else if zig-any-sub-occurs-g subs 0 body guard == False
     then test & emit-zig-chain-tail guard body ctx d mty & "} "
     else test & "const _p" & integer-to-text d & " = " & sv & "." & zig-sanitize name & "; " & emit-zig-pat-unpack-g subs 0 d body guard ctx & emit-zig-chain-tail guard body (zig-push-bound-pats ctx subs 0 d) d mty & "} "
    is IrVarPat (name) (ty) (sp) ->
     if zig-occurs-either body guard name
     then "{ const " & zig-bind-name ctx name d & " = " & sv & "; " & emit-zig-chain-tail guard body (zig-bind-push ctx name d) d mty & "} "
     else "{ " & emit-zig-chain-tail guard body ctx d mty & "} "
    is IrWildPat (sp) -> "{ " & emit-zig-chain-tail guard body ctx d mty & "} "
    is IrVecPat (pats) (ty) (sp) -> "@compileError(\"zig plug: vector patterns not supported\"); "

  zig-any-sub-occurs-g : List IRPat, Integer, IRExpr, IRExpr -> Boolean
  zig-any-sub-occurs-g (subs) (i) (body) (guard) =
   if i >= list-length subs then False
   else let binder = zig-pat-binder (list-at subs i) i
   in if (binder == "_") == False & zig-occurs-either body guard binder then True
      else zig-any-sub-occurs-g subs (i + 1) body guard

  emit-zig-pat-unpack-g : List IRPat, Integer, Integer, IRExpr, IRExpr, ZigCtx -> Text
  emit-zig-pat-unpack-g (subs) (i) (d) (body) (guard) (ctx) =
   if i == list-length subs then ""
   else let binder = zig-pat-binder (list-at subs i) i
   in let line = if (binder == "_") | (zig-occurs-either body guard binder == False) then ""
      else "const " & zig-bind-name ctx binder d & " = _p" & integer-to-text d & "[" & integer-to-text i & "]; "
   in line & emit-zig-pat-unpack-g subs (i + 1) d body guard ctx

Section: Act Emission

 The block's value is its last executed statement. A void act ends with a
 bare break so the block types as void and `return <block>` works in
 a void function; a valued act breaks with the final statement's value, and
 only an act whose last statement binds (or an empty act) needs the
 trailing break.

  emit-zig-act : List IRActStmt, ZigCtx, Integer, Boolean -> Text
  emit-zig-act (stmts) (ctx) (d) (voidp) =
   let len = list-length stmts
   in let needs-tail = if len == 0 then True
      else when (list-at stmts (len - 1))
       is IrDoBind (name) (ty) (val) (sp) -> True
       is IrDoExec (e) (sp) -> False
   in let tail = if needs-tail then (if voidp then "break :" & zig-label d & "; " else "break :" & zig-label d & " undefined; ") else ""
   in zig-label d & ": { " & emit-zig-act-stmts stmts 0 ctx d voidp & tail & "}"

  emit-zig-act-stmts : List IRActStmt, Integer, ZigCtx, Integer, Boolean -> Text
  emit-zig-act-stmts (stmts) (i) (ctx) (d) (voidp) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in let rest = when s
    is IrDoBind (name) (ty) (val) (sp) -> if zig-is-seq-name name then ctx else zig-bind-push ctx name d
    is otherwise -> ctx
   in (when s
    is IrDoBind (name) (ty) (val) (sp) ->
     if zig-is-seq-name name then "_ = " & emit-zig-expr val ctx (d + 1) & "; "
     else "const " & zig-bind-name ctx name d & " = " & emit-zig-expr val ctx (d + 1) & "; "
    is IrDoExec (e) (sp) ->
     if is-last then (if voidp then "_ = " & emit-zig-expr e ctx (d + 1) & "; break :" & zig-label d & "; " else "break :" & zig-label d & " " & emit-zig-expr e ctx (d + 1) & "; ")
     else "_ = " & emit-zig-expr e ctx (d + 1) & "; ") & emit-zig-act-stmts stmts (i + 1) rest d voidp

Section: Apply Emission

 `deck-record` is intercepted by name, the same way x86-64 and C# do it:
 the source definition is the identity function, and codegen gives the
 call its meaning by bracketing the ARGUMENT's evaluation in deck enter
 and exit. The binding forces the argument to evaluate before the exit;
 its name carries the depth so nested intercepts do not shadow.

  emit-zig-apply : IRExpr, ZigCtx, Integer -> Text
  emit-zig-apply (e) (ctx) (d) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     if n == "deck-record" & list-length args == 1
     then zig-label d & ": { _ = cx_deck_enter(); const _dr" & integer-to-text d & " = " & emit-zig-expr (list-at args 0) ctx (d + 1) & "; _ = cx_deck_exit(); break :" & zig-label d & " _dr" & integer-to-text d & "; }"
     else let builtin = lookup-zig-builtin n args ctx d (zig-expr-type e)
     in if text-length builtin > 0 then builtin
     else let ci = zig-find-ctor (ctx.ctors) n 0
     in if ci >= 0 then emit-zig-ctor-apply (list-at (ctx.ctors) ci) args ctx d (zig-expr-type e)
     else let ar = lookup-arity (ctx.arities) n
     in if ar < 0 then (if zig-name-known ctx n then zig-closure-invoke (zig-local-ref ctx n) args ctx d else zig-unknown-name n)
        else if list-length args < ar then zig-closure-make n args ctx d (zig-expr-type e)
        else if list-length args > ar then zig-over-apply n args ar ctx d (zig-expr-type e)
        else let atys = zig-arg-types args 0 []
             in zig-sanitize n & "(" & zig-call-type-args ctx n atys (zig-expr-type e)
             & emit-zig-call-args n args (zig-call-ctx ctx n atys (zig-expr-type e)) d 0 & ")"
    is otherwise -> emit-zig-expr-curried e ctx d

 Codex applies partially: a 4-argument function called with 2 yields
 something callable with the remaining 2. Zig has no closures, so an
 undersaturated call becomes a struct capturing what was supplied plus a
 trampoline that takes the rest and calls through. The struct is declared
 inside the expression, so nothing hoists to the top level and each site
 stands alone.

 The remaining parameter types and the result come from the type of the
 partial application itself, which is exactly the function type left over.
 A name with no arity is not a definition, so it is a value already
 holding a closure, and applying it goes through the trampoline.

 Each variable is recovered from the first argument whose declared type
 mentions it, falling back to the result. map-list needs both routes: `a`
 comes from `List a` against the list passed, and `b` only from the result
 `List b`, because the lambda's own type is as unresolved as the parameter
 was. A variable no argument mentions emits anyopaque, which zig refuses
 loudly rather than inferring something wrong.

 A resolved type variable has to reach the arguments, not just the type
 argument list. A lambda handed to map-list carries the CALLEE's variable
 in its own type, and an empty list typed from the callee's declared
 parameter carries it too -- emitted as-is, both name a variable that does
 not exist in the caller. The call site already knows T36 is Token; these
 rewrite the argument's type before it is emitted so the emitter never
 sees a foreign variable.

 Substitution is what makes the emitted type CORRECT, and it stays here
 rather than becoming a binding table threaded through emit-zig-type: a
 rewritten type needs no cooperation from the code that renders it.

 What does travel with the type is the SCOPE -- which variables the site may
 name -- because no amount of substitution can be checked without it. That
 is a set, not a table, and it is read in one place; see zig-stray-tvar.

  zig-subst-tvar : CodexType, Integer, CodexType -> CodexType
  zig-subst-tvar (ty) (id) (with-ty) =
   when ty
    is TypeVar (vid) -> if vid == id then with-ty else ty
    is ListTy (elem) -> ListTy (zig-subst-tvar elem id with-ty)
    is LinkedListTy (elem) -> LinkedListTy (zig-subst-tvar elem id with-ty)
    is FunTy (p) (fnrow) (r) -> FunTy (zig-subst-tvar p id with-ty) fnrow (zig-subst-tvar r id with-ty)
    is EffectfulTy (e) (s) (inner) -> EffectfulTy e s (zig-subst-tvar inner id with-ty)
    is ForAllTy (fid) (inner) -> ForAllTy fid (zig-subst-tvar inner id with-ty)
    is ForAllEff (c) (inner) -> ForAllEff c (zig-subst-tvar inner id with-ty)
    is otherwise -> ty

  zig-subst-arg-type : CodexType, IRDef, List CodexType, CodexType, List Integer, Integer -> CodexType
  zig-subst-arg-type (ty) (d) (actuals) (resty) (ids) (i) =
   if i >= list-length ids then ty
   else let id = list-at ids i
   in let bound = zig-resolve-tvar-type id d actuals resty 0
   in zig-subst-arg-type (zig-subst-tvar ty id bound) d actuals resty ids (i + 1)

 Recovering one variable: walk the declared type and the type actually
 supplied in step, and answer with the type sitting where the variable
 sits. VoidTy means this pair does not mention it, and the caller tries
 the next one.

 zig-resolve-tvar answers with emitted text because the type argument list
 needs text. Substitution needs the TYPE, so the walk is SHARED and only
 the answer differs. It was two walks with the same shape and two
 sentinels, "" and VoidTy, until the fix below had to be written twice.

 The caller supplies the actual types rather than the argument
 EXPRESSIONS, because one caller has no expressions: a closure built over
 a generic callee knows its remaining parameter types from the function
 type it is standing in for, and nothing else.

 AN ANSWER THAT IS ITSELF A TYPE VARIABLE IS NOT A RESOLUTION. Taking one
 as an answer is what emitted `T23` into a scope holding no such name. A
 lifted lambda's parameter carries the variable it was HANDED -- the
 driver lifts lambdas after the resolve pass, and CSharpEmitter.codex says
 so above `is-lam-def`, where C# answers `dynamic` -- so matching
 map-list's declared `(a -> b)` against `__lam_0`'s `(tvar 23 -> Integer)`
 answered `a = tvar 23`. That is non-empty, so the scan stopped there and
 never read the list argument one place along, whose `List a` against
 `List Integer` is the answer that was wanted.

 A variable answer is kept only as a LAST RESORT rather than refused,
 because inside a generic definition it is the right answer: map-list's
 own body calls map-list-loop, and there `T23` is a comptime parameter
 that really is in scope. Concrete beats variable; variable beats nothing;
 nothing is the @compileError marker, which now fires where it could not
 before -- a variable answer used to look like success.

  zig-resolve-tvar-type : Integer, IRDef, List CodexType, CodexType, Integer -> CodexType
  zig-resolve-tvar-type (id) (d) (actuals) (resty) (i) =
   if i >= list-length (d.params) | i >= list-length actuals
   then zig-tvar-in-type id (zig-peel-return (d.type-val) (list-length (d.params))) resty
   else let found = zig-tvar-in-type id ((list-at (d.params) i).type-val) (list-at actuals i)
   in when found
      is VoidTy -> zig-resolve-tvar-type id d actuals resty (i + 1)
      is TypeVar (vid) ->
       let rest = zig-resolve-tvar-type id d actuals resty (i + 1)
       in zig-prefer-concrete found rest
      is otherwise -> found

  zig-prefer-concrete : CodexType, CodexType -> CodexType
  zig-prefer-concrete (fallback) (rest) =
   when rest
    is VoidTy -> fallback
    is TypeVar (vid) -> fallback
    is otherwise -> rest

  zig-arg-types : List IRExpr, Integer, List CodexType -> List CodexType
  zig-arg-types (args) (i) (acc) =
   if i >= list-length args then acc
   else zig-arg-types args (i + 1) (acc & [zig-expr-type (list-at args i)])

  zig-fn-param-type-list : CodexType -> List CodexType
  zig-fn-param-type-list (ty) =
   when zig-fn-spine ty
    is FunTy (p) (fnrow) (r) -> [p] & zig-fn-param-type-list r
    is otherwise -> []

  zig-tvar-in-type : Integer, CodexType, CodexType -> CodexType
  zig-tvar-in-type (id) (decl) (actual) =
   when decl
    is TypeVar (vid) -> if vid == id then actual else VoidTy
    is EffectfulTy (e) (s) (inner) -> zig-tvar-in-type id inner actual
    is ForAllTy (fid) (inner) -> zig-tvar-in-type id inner actual
    is ForAllEff (c) (inner) -> zig-tvar-in-type id inner actual
    is ListTy (elem) -> zig-tvar-in-elem-type id elem actual
    is LinkedListTy (elem) -> zig-tvar-in-elem-type id elem actual
    is FunTy (p) (fnrow) (r) -> zig-tvar-in-fun-type id p r actual
    is ConstructedTy (n) (a) -> zig-tvar-in-args id a (zig-type-arg-list actual) 0
    is SumTy (n) (a) (c) -> zig-tvar-in-args id a (zig-type-arg-list actual) 0
    is RecordTy (n) (a) (f) -> zig-tvar-in-args id a (zig-type-arg-list actual) 0
    is otherwise -> VoidTy

 The three arms above are the DECLARED types the subject writes. Without
 them this walk knew `List a`, `LinkedList a` and `a -> b` and answered
 VoidTy for every parameterised type a program declares for itself, so a
 variable inside `Step a` -- or `Iter a`, `Opt a`, a tuple, any record or
 sum -- could not be recovered from any position, and
 `zig-resolve-tvar` emitted its @compileError with the answer sitting one
 argument along in the type it had already been handed.

 One declaration reaches this walk under three different constructors: a
 name is a ConstructedTy until the checker rewrites it to the SumTy or
 RecordTy it denotes, and which one arrives depends on how far the type
 travelled. All three carry the same argument list, so all three descend
 the same way and `zig-type-arg-list` accepts any of them on the actual
 side.

 Matching is BY POSITION and does not compare names, which is sound for
 the reason CSharpEmitter.codex:534-541 gives about this same wire: the IR
 is well-typed, so the type supplied for a parameter is the type that
 parameter declares, and a mismatched pair cannot arrive here.

  zig-type-arg-list : CodexType -> List CodexType
  zig-type-arg-list (ty) =
   when ty
    is ConstructedTy (n) (a) -> a
    is SumTy (n) (a) (c) -> a
    is RecordTy (n) (a) (f) -> a
    is EffectfulTy (e) (s) (inner) -> zig-type-arg-list inner
    is otherwise -> []

  zig-tvar-in-args : Integer, List CodexType, List CodexType, Integer -> CodexType
  zig-tvar-in-args (id) (decls) (actuals) (i) =
   if i >= list-length decls | i >= list-length actuals then VoidTy
   else let found = zig-tvar-in-type id (list-at decls i) (list-at actuals i)
   in when found
      is VoidTy -> zig-tvar-in-args id decls actuals (i + 1)
      is otherwise -> found

  zig-tvar-in-elem-type : Integer, CodexType, CodexType -> CodexType
  zig-tvar-in-elem-type (id) (elem) (actual) =
   when actual
    is ListTy (ae) -> zig-tvar-in-type id elem ae
    is LinkedListTy (ae) -> zig-tvar-in-type id elem ae
    is EffectfulTy (e) (s) (inner) -> zig-tvar-in-elem-type id elem inner
    is otherwise -> VoidTy

  zig-tvar-in-fun-type : Integer, CodexType, CodexType, CodexType -> CodexType
  zig-tvar-in-fun-type (id) (p) (r) (actual) =
   when actual
    is FunTy (ap) (afnrow) (ar) ->
     let fromp = zig-tvar-in-type id p ap
     in when fromp
        is VoidTy -> zig-tvar-in-type id r ar
        is otherwise -> fromp
    is EffectfulTy (e) (s) (inner) -> zig-tvar-in-fun-type id p r inner
    is otherwise -> VoidTy

 Every construct that knows what type its children must have says so, and
 an empty list reads it. That is the whole mechanism: an empty list can
 never answer for itself, so instead of asking each site to look the answer
 up its own way, the site that knows tells the site that needs.

  zig-expect : ZigCtx, CodexType -> ZigCtx
  zig-expect (ctx) (ty) =
   ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = ctx.renamed-from,
    renamed-to = ctx.renamed-to,
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ty,
    bound-names = ctx.bound-names,
    scope-tvars = ctx.scope-tvars
   }

 Two map-list calls in one expression each bind map-list's OWN type
 variables, so the context ends up holding two bindings for the same id.
 Substituting from the front let the outer call's binding reach the inner
 lambda and type its parameter as the outer element type: the inner
 `for fld in c.fields` came out taking a SumCtor because the enclosing
 `for c in ctors` had already bound that variable. Bindings are appended as
 the walk descends, so the innermost is last, and the scan runs from the
 END -- the same shadowing rule, and the same answer, as the rename table.

  zig-subst-ctx : CodexType, ZigCtx -> CodexType
  zig-subst-ctx (ty) (ctx) =
   zig-subst-all ty ctx (list-length (ctx.tvar-ids) - 1)

  zig-subst-all : CodexType, ZigCtx, Integer -> CodexType
  zig-subst-all (ty) (ctx) (i) =
   if i < 0 then ty
   else let one = zig-subst-tvar ty (list-at (ctx.tvar-ids) i) (list-at (ctx.tvar-types) i)
   in zig-subst-all one ctx (i - 1)

  zig-bind-tvars : ZigCtx, IRDef, List (Integer between 0 and 4294967295), Integer, List CodexType, CodexType -> ZigCtx
  zig-bind-tvars (ctx) (d) (ids) (i) (actuals) (resty) =
   if i >= list-length ids then ctx
   else let id = list-at ids i
   in let bound = zig-resolve-tvar-type id d actuals resty 0
   in let ctx2 = ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = ctx.renamed-from,
    renamed-to = ctx.renamed-to,
    tvar-ids = (ctx.tvar-ids) & [id],
    tvar-types = (ctx.tvar-types) & [bound],
    expected = ctx.expected,
    bound-names = ctx.bound-names,
    scope-tvars = ctx.scope-tvars
   }
   in zig-bind-tvars ctx2 d ids (i + 1) actuals resty

  zig-call-ctx : ZigCtx, Text, List CodexType, CodexType -> ZigCtx
  zig-call-ctx (ctx) (n) (actuals) (resty) =
   let di = zig-find-irdef (ctx.irdefs) 0 n
   in if di < 0 then ctx
   else let d = list-at (ctx.irdefs) di
   in let ids = zig-def-tvar-ids d
   in if list-length ids == 0 then ctx
   else zig-bind-tvars ctx d ids 0 actuals resty

  zig-find-irdef : List IRDef, Integer, Text -> Integer
  zig-find-irdef (defs) (i) (n) =
   if i >= list-length defs then -1
   else if (list-at defs i).name == n then i
   else zig-find-irdef defs (i + 1) n

 zig-call-type-args separates with a trailing ", " because the value
 arguments follow it. A nullary callee has none, so the separator has to
 come back off.

  zig-drop-trailing-sep : Text -> Text
  zig-drop-trailing-sep (t) =
   if text-length t < 2 then t
   else if substring t (text-length t - 2) 2 == ", " then substring t 0 (text-length t - 2)
   else t

  zig-call-type-args : ZigCtx, Text, List CodexType, CodexType -> Text
  zig-call-type-args (ctx) (n) (actuals) (resty) =
   let di = zig-find-irdef (ctx.irdefs) 0 n
   in if di < 0 then ""
   else let d = list-at (ctx.irdefs) di
   in let ids = zig-def-tvar-ids d
   in if list-length ids == 0 then ""
   else zig-call-type-args-loop ctx d ids 0 actuals resty

  zig-call-type-args-loop : ZigCtx, IRDef, List (Integer between 0 and 4294967295), Integer, List CodexType, CodexType -> Text
  zig-call-type-args-loop (ctx) (d) (ids) (i) (actuals) (resty) =
   if i >= list-length ids then ""
   else let one = zig-resolve-tvar (list-at ids i) d actuals resty 0 (ctx.scope-tvars)
   in one & ", " & zig-call-type-args-loop ctx d ids (i + 1) actuals resty

 A variable no argument mentions used to come out anyopaque, on the
 reasoning that zig refuses anyopaque and so the gap could not pass
 silently. It cannot, but it also cannot explain itself: zig reports
 "opaque return type not allowed" against a CxFn1 instantiation and says
 nothing about which callee, which variable, or that a type argument is
 what went missing. Ten of these in one subject read as one mystery rather
 than ten facts. The marker names the callee and the variable instead.

  zig-resolve-tvar : Integer between 0 and 4294967295, IRDef, List CodexType, CodexType, Integer, List (Integer between 0 and 4294967295) -> Text
  zig-resolve-tvar (id) (d) (actuals) (resty) (i) (scope) =
   let found = zig-resolve-tvar-type id d actuals resty i
   in when found
      is VoidTy -> zig-tvar-refusal id (d.name)
      is otherwise -> emit-zig-type found scope

 A variable answer is kept as a last resort, and 1.84 gives the reason: inside
 a generic definition the variable IS the answer, because it is a comptime
 parameter that definition declares. At an emission site that declares
 NOTHING -- a closure's environment struct inside a non-generic function --
 the same answer is a name in a scope that has never heard of it, and zig
 reports `use of undeclared identifier` with nothing to say why.

 So the last resort is now conditional on the emission site actually
 declaring the variable. `scope-tvars` carries what `emit-zig-def` put in the
 signature as `comptime T<n>: type`, which is exactly the set that is legal
 to name in that body. When it is not in there the refusal fires instead, and
 the refusal is the same one that fires when nothing was recovered at all:
 the plug could not answer, and it says so rather than emitting a name.

 Found by `findings/probe-tvar-recovery.codex` case (g), which is the
 shape a fix for case (a) turned from a diagnostic into a build failure.

  zig-tvar-refusal : Integer, Text -> Text
  zig-tvar-refusal (id) (n) =
   "@compileError(\"zig plug: unresolved type variable T" & integer-to-text id & " of " & n & "\")"


  zig-drop-trailing-comma : Text -> Text
  zig-drop-trailing-comma (s) =
   if text-length s < 2 then s else substring s 0 (text-length s - 2)

  zig-closure-args : List IRExpr, ZigCtx, Integer, Integer -> Text
  zig-closure-args (args) (ctx) (d) (i) =
   if i == list-length args then ""
   else ", " & emit-zig-expr (list-at args i) ctx (d + 1) & zig-closure-args args ctx d (i + 1)

  zig-closure-invoke : Text, List IRExpr, ZigCtx, Integer -> Text
  zig-closure-invoke (f) (args) (ctx) (d) =
   f & ".call(" & f & ".ctx" & zig-closure-args args ctx d 0 & ")"

 An application may carry MORE arguments than the callee was emitted with,
 because a definition returning a function is emitted at its parameter
 count and the wire hands the whole curried chain over at once.
 DevelopersRulebook.md ("What the wire carries") names the three cases a
 plug that knows the arity owes: flat at that arity, under-applied with one
 arrow per missing parameter, and over-applied by applying the rest. This
 is the third. Until 2026-08-24 `args > ar` fell into the saturated branch
 and emitted every argument flat, which zig refuses outright -- see the
 ladder's finding 40.

 The remainder goes in ONE call, not one argument at a time. A function
 type of n arrows is emitted as a single CxFn<n> whose `call` takes all n
 together (zig-closure-type), so the callee's own return type absorbs the
 whole remainder by construction. The result is bound to a const first
 because `.call` names it twice.

 A GENERIC callee is refused rather than guessed. zig-call-type-args
 resolves a definition's type variables from the argument list and the
 RESULT type, and the result type here belongs to the whole chain rather
 than to the head call, so a variable appearing only in the return
 position would resolve against the wrong type. A marker names the gap; a
 plausible wrong type argument would not.

 take/drop are `codex/foreword/core/ListUtils.codex`, which this plug does
 not cite; riscv answered the same need with its own rv-list-take rather
 than reaching for it, so these follow that. The accumulator is a fresh
 literal per call, which is what makes list-push safe here -- it mutates,
 and an accumulator shared with a caller would leak.

  zig-list-take : List IRExpr, Integer -> List IRExpr
  zig-list-take (xs) (n) = zig-list-take-loop xs 0 n []

  zig-list-take-loop : List IRExpr, Integer, Integer, List IRExpr -> List IRExpr
  zig-list-take-loop (xs) (i) (n) (acc) =
   if i >= n then acc
   else zig-list-take-loop xs (i + 1) n (list-push acc (list-at xs i))

  zig-list-drop : List IRExpr, Integer -> List IRExpr
  zig-list-drop (xs) (n) = zig-list-drop-loop xs n []

  zig-list-drop-loop : List IRExpr, Integer, List IRExpr -> List IRExpr
  zig-list-drop-loop (xs) (i) (acc) =
   if i >= list-length xs then acc
   else zig-list-drop-loop xs (i + 1) (list-push acc (list-at xs i))

  zig-over-apply : Text, List IRExpr, Integer, ZigCtx, Integer, CodexType -> Text
  zig-over-apply (n) (args) (ar) (ctx) (d) (resty) =
   let di = zig-find-irdef (ctx.irdefs) 0 n
   in if di >= 0 & list-length (zig-def-tvar-ids (list-at (ctx.irdefs) di)) > 0
   then zig-refuse ("over-application of generic " & n)
   else let head = zig-list-take args ar
   in let rest = zig-list-drop args ar
   in let lbl = zig-label d
   in let o = "_o" & integer-to-text d
   in lbl & ": { const " & o & " = " & zig-sanitize n & "("
    & zig-call-type-args ctx n (zig-arg-types head 0 []) resty
    & emit-zig-call-args n head (zig-call-ctx ctx n (zig-arg-types head 0 []) resty) d 0 & "); break :"
    & lbl & " " & zig-closure-invoke o rest ctx d & "; }"

  zig-closure-fields : List IRExpr, ZigCtx, Integer -> Text
  zig-closure-fields (args) (ctx) (i) =
   if i == list-length args then ""
   else "a" & integer-to-text i & ": " & emit-zig-type (zig-expr-type (list-at args i)) (ctx.scope-tvars) & ", "
      & zig-closure-fields args ctx (i + 1)

  zig-closure-inits : List IRExpr, ZigCtx, Integer, Integer -> Text
  zig-closure-inits (args) (ctx) (d) (i) =
   if i == list-length args then ""
   else let one = ".a" & integer-to-text i & " = " & emit-zig-expr (list-at args i) ctx (d + 1)
   in if i == list-length args - 1 then one
      else one & ", " & zig-closure-inits args ctx d (i + 1)

  zig-closure-env-refs : Text, Integer, Integer -> Text
  zig-closure-env-refs (ev) (n) (i) =
   if i >= n then ""
   else ev & ".a" & integer-to-text i & ", " & zig-closure-env-refs ev n (i + 1)

  zig-closure-pass : Integer, Integer -> Text
  zig-closure-pass (n) (i) =
   if i >= n then ""
   else let one = "p" & integer-to-text i
   in if i == n - 1 then one else one & ", " & zig-closure-pass n (i + 1)

  zig-closure-params : CodexType, Integer, List (Integer between 0 and 4294967295) -> Text
  zig-closure-params (ty) (i) (scope) =
   when zig-fn-spine ty
    is FunTy (p) (fnrow) (r) ->
     let rest = zig-closure-params r (i + 1) scope
     in "p" & integer-to-text i & ": " & emit-zig-type p scope
      & (if text-length rest == 0 then "" else ", " & rest)
    is otherwise -> ""

 The wrapper's parameter count comes from the TYPE spine, and the callee
 is declared at its PARAMETER count. Those two disagree for a definition
 that returns a function -- `even-fn : Integer -> (Integer, Integer ->
 Integer)` has three arrows and one parameter -- so passing every wrapper
 parameter flat calls a one-ary definition with three arguments. That was
 finding 40's second site, and it is reached whenever such a definition is
 used as a VALUE rather than applied. The emitter already knew the two
 numbers could differ: zig-untrusted-return-note prints "type-val has N
 arrows for M params", and zig-def-return-trusted tests >= rather than ==.

 So only the first `ar - <supplied>` parameters go flat; the rest go
 through the returned closure in one call, for the same reason
 zig-over-apply does it that way. An unknown callee (ar < 0) keeps the old
 shape, which is what the closure-invoke path already handles.

  zig-closure-pass-tail : Integer, Integer -> Text
  zig-closure-pass-tail (i) (n) =
   if i >= n then "" else ", p" & integer-to-text i & zig-closure-pass-tail (i + 1) n

  zig-closure-call-body : Text, Integer, Text, Integer, Integer, Integer, Text -> Text
  zig-closure-call-body (n) (nargs) (ev) (flat) (rem) (d) (targs) =
   if flat >= rem
   then "return " & zig-sanitize n & "(" & targs & zig-closure-env-refs ev nargs 0
      & zig-closure-pass rem 0 & ");"
   else let w = "_w" & integer-to-text d
   in "const " & w & " = " & zig-sanitize n & "(" & targs & zig-closure-env-refs ev nargs 0
    & zig-closure-pass flat 0 & "); return " & w & ".call(" & w & ".ctx"
    & zig-closure-pass-tail flat rem & ");"

 A GENERIC callee has to be applied here too. The trampoline calls it by
 name, and a name is where an unapplied generic stops being visible: the
 def emitted `fn __lam_0(comptime T23: type, x: T23) i64` and the body
 emitted `__lam_0(p0)`, one argument against two, with nothing naming the
 type. Both halves of that came from the same place -- a lifted lambda's
 unresolved parameter -- and both are recovered the same way.

 The types to recover FROM are in two places, which is why this cannot
 just call the apply path's version: the arguments already supplied carry
 theirs, and the parameters the trampoline is about to take are named by
 the function type this closure stands in for. That type is read through
 the context first, because the enclosing call's own type arguments are
 what resolve it -- emit-zig-name handed it over raw and the tyvar
 travelled into the struct's parameter list and its CxFn type.

 The central guard in emit-zig-type would refuse each of this closure's
 stray positions on its own, and the environment struct's `call` takes its
 parameters and returns its result from the same type, so one closure would
 answer three times. The coarse refusal here is not a second policy -- it
 asks zig-stray-tvar the same question -- it is the largest unit that still
 names one gap, so the closure is refused WHOLE, once, in the place the
 value would have gone.

  zig-closure-make : Text, List IRExpr, ZigCtx, Integer, CodexType -> Text
  zig-closure-make (n) (args) (ctx) (d) (pty0) =
   let pty = zig-subst-ctx pty0 ctx
   in let stray = zig-stray-tvar pty (ctx.scope-tvars)
   in if stray >= 0 then zig-tvar-refusal stray n
   else let rem = zig-fn-param-count pty
   in let car = lookup-arity (ctx.arities) n
   in let flat = if car < 0 then rem else car - list-length args
   in let actuals = zig-arg-types args 0 [] & zig-fn-param-type-list pty
   in let targs = zig-call-type-args ctx n actuals (zig-fn-result pty)
   in let lbl = zig-label d
   in let env = "_Env" & integer-to-text d
   in let ev = "_e" & integer-to-text d
   in let ret = emit-zig-type (zig-fn-result pty) (ctx.scope-tvars)
   in let cx = "_ctx" & integer-to-text d
   in let unpack = if list-length args == 0 then "_ = " & cx & "; "
      else "const " & ev & ": *@This() = @ptrCast(@alignCast(" & cx & ")); "
   in lbl & ": { const " & env & " = struct { " & zig-closure-fields args ctx 0
    & "fn call(" & cx & ": *anyopaque, " & zig-closure-params pty 0 (ctx.scope-tvars) & ") " & ret
    & " { " & unpack & zig-closure-call-body n (list-length args) ev flat rem d targs & " } }; break :"
    & lbl & " " & zig-closure-type rem (zig-fn-param-types pty (ctx.scope-tvars)) ret
    & "{ .ctx = cx_new(" & env & "{ " & zig-closure-inits args ctx d 0 & " }), .call = &" & env & ".call }; }"

 A generic type emits as a function from types to a type, so constructing
 one names it applied: Tup2(A, B){ .MkTup2 = ... }. The arguments come from
 the type of the construction itself, which is the only place they are
 known -- the constructor map carries names and arity, not instantiations.
 A non-generic type has no arguments and this contributes nothing.

  zig-ctor-type-args : CodexType, List (Integer between 0 and 4294967295) -> Text
  zig-ctor-type-args (ty) (scope) =
   when ty
    is SumTy (n) (a) (c) -> zig-type-args a scope
    is RecordTy (n) (a) (f) -> zig-type-args a scope
    is ConstructedTy (n) (a) -> zig-type-args a scope
    is otherwise -> ""

  emit-zig-ctor-apply : ZigCtorEntry, List IRExpr, ZigCtx, Integer, CodexType -> Text
  emit-zig-ctor-apply (c) (args) (ctx) (d) (cty) =
   let tname = zig-sanitize (c.type-name)
   in let cname = zig-sanitize (c.ctor-name)
   in let boxed = zig-typedef-recursive ctx (c.type-name)
   in let base = if boxed then tname & "S" else tname & zig-ctor-type-args cty (ctx.scope-tvars)
   in let open = if boxed then "cx_new(" else ""
   in let close = if boxed then ")" else ""
   in if c.enum-like then tname & "." & cname
   else if list-length args == 0 then open & base & "{ ." & cname & " = {} }" & close
   else if list-length args == 1 then open & base & "{ ." & cname & " = " & emit-zig-ctor-args c args ctx d 0 cty & " }" & close
   else open & base & "{ ." & cname & " = .{ " & emit-zig-ctor-args c args ctx d 0 cty & " } }" & close

  emit-zig-call-args : Text, List IRExpr, ZigCtx, Integer, Integer -> Text
  emit-zig-call-args (fname) (args) (ctx) (d) (i) =
   if i == list-length args then ""
   else let a = list-at args i
   in let one = emit-zig-expr a (zig-expect ctx (zig-callee-param-type ctx fname i)) (d + 1)
   in if i == list-length args - 1 then one
      else one & ", " & emit-zig-call-args fname args ctx d (i + 1)

  emit-zig-apply-args : List IRExpr, ZigCtx, Integer, Integer -> Text
  emit-zig-apply-args (args) (ctx) (d) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-zig-expr (list-at args i) ctx (d + 1)
   else emit-zig-expr (list-at args i) ctx (d + 1) & ", " & emit-zig-apply-args args ctx d (i + 1)

 A constructor payload is the third place an empty list can learn what it
 holds, alongside a record field decl and a callee's parameter. The
 declared field type is on the variant's ctor, so the ctor being applied
 names it.

 A constructor payload's declared field type is an ATypeExpr rather than a
 CodexType, so the expectation is carried as text -- the one place the
 mechanism cannot use zig-expect and says why.

 A builtin argument is the fourth place an empty list can learn what it
 holds, and the first where the answer is not a declaration. `list-push []
 x` says nothing about the list and everything about x, so the element type
 comes off the SIBLING argument: whatever is being pushed is what the list
 holds. Three of these sit in lower-lazy, which builds a one-element
 parameter list and two field lists this way.

 Builtin emitters take their arguments as plain expressions with no
 expectation attached, which is why zig-expect cannot reach here. This
 helper is the narrow substitute -- it answers for one argument of one
 builtin from another argument of the same call, and it stays honest by
 refusing to guess: a sibling whose own type is unresolved falls through to
 the ordinary emission and the empty-list marker fires as before.

  zig-list-arg-text : List IRExpr, Integer, Integer, ZigCtx, Integer -> Text
  zig-list-arg-text (args) (li) (ei) (ctx) (d) =
   let a = list-at args li
   in if zig-is-empty-list a == False then emit-zig-expr a ctx (d + 1)
   else let elem = emit-zig-type (zig-expr-type (list-at args ei)) (ctx.scope-tvars)
   in if text-length elem > 0 & zig-is-unmapped elem == False
      then "cx_ll_empty(" & elem & ")"
      else emit-zig-expr a ctx (d + 1)

  emit-zig-ctor-arg : ZigCtorEntry, IRExpr, ZigCtx, Integer, Integer, CodexType -> Text
  emit-zig-ctor-arg (c) (a) (ctx) (d) (i) (cty) =
   if zig-is-empty-list a
   then let elem = zig-ctor-ll-elem ctx (c.type-name) (c.ctor-name) i cty
    in if text-length elem > 0 then "cx_ll_empty(" & elem & ")"
       else emit-zig-expr a ctx (d + 1)
   else emit-zig-expr a ctx (d + 1)

  zig-ctor-ll-elem : ZigCtx, Text, Text, Integer, CodexType -> Text
  zig-ctor-ll-elem (ctx) (tyname) (ctorname) (argi) (cty) =
   zig-ctor-ll-scan (ctx.typedefs) 0 tyname ctorname argi cty ctx

  zig-ctor-ll-scan : List ATypeDef, Integer, Text, Text, Integer, CodexType, ZigCtx -> Text
  zig-ctor-ll-scan (tds) (i) (tyname) (ctorname) (argi) (cty) (ctx) =
   if i >= list-length tds then ""
   else when (list-at tds i)
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if name.value == tyname then zig-ctor-field-scan ctors 0 ctorname argi tparams cty ctx
     else zig-ctor-ll-scan tds (i + 1) tyname ctorname argi cty ctx
    is otherwise -> zig-ctor-ll-scan tds (i + 1) tyname ctorname argi cty ctx

  zig-ctor-field-scan : List AVariantCtorDef, Integer, Text, Integer, List Name, CodexType, ZigCtx -> Text
  zig-ctor-field-scan (ctors) (i) (ctorname) (argi) (tparams) (cty) (ctx) =
   if i >= list-length ctors then ""
   else let c = list-at ctors i
   in if c.name.value == ctorname
      then (if argi >= list-length (c.fields) then ""
            else zig-atype-ll-elem (list-at (c.fields) argi) tparams cty ctx)
      else zig-ctor-field-scan ctors (i + 1) ctorname argi tparams cty ctx

  emit-zig-ctor-args : ZigCtorEntry, List IRExpr, ZigCtx, Integer, Integer, CodexType -> Text
  emit-zig-ctor-args (c) (args) (ctx) (d) (i) (cty) =
   if i == list-length args then ""
   else let a = list-at args i
   in let one = emit-zig-ctor-arg c a ctx d i cty
   in if i == list-length args - 1 then one
      else one & ", " & emit-zig-ctor-args c args ctx d (i + 1) cty

 An apply whose root is not a name applies a VALUE, and every function
 value in this emitter is a closure struct -- so it is invoked through
 the struct, not with zig's call syntax. `(e.emit) st args` was emitted
 as `e.emit(st)(args)` and zig answered that a CxFn2 is not a function.
 The root is bound once before the invoke: repeating a field access
 twice would read it twice, and nothing here promises that is free.

 The whole chain is applied at once, which is also what makes the
 arities line up: a CxFn2's call takes both arguments together, where
 the curried form asked for one and then called the result again.

  emit-zig-expr-curried : IRExpr, ZigCtx, Integer -> Text
  emit-zig-expr-curried (e) (ctx) (d) =
   let chain = collect-apply-chain e []
   in let args = chain.args
   in if list-length args == 0 then emit-zig-expr (chain.root) ctx (d + 1)
   else let fv = "_f" & integer-to-text d
   in zig-label d & ": { const " & fv & " = " & emit-zig-expr (chain.root) ctx (d + 1)
    & "; break :" & zig-label d & " " & fv & ".call(" & fv & ".ctx"
    & zig-closure-args args ctx d 0 & "); }"

Section: Tail Call Loops

 Bare metal tracks tail position and a self tail call there is a jump, so
 a `*-loop (xs) (i) (acc)` costs no stack at all. This arm called instead,
 and a Debug zig frame of a few hundred bytes times three million tokens
 is a stack the thread does not have: `zigemit` died in tokenize-collect
 on the 13 MB IR with 512 MB of stack, and with 2 GiB (finding 33).

 So a definition whose TAIL positions include a self-call of its own full
 arity becomes a loop: the parameters are copied into vars, the tail spine
 emits as statements, and a self tail call assigns the next arguments and
 continues. Every other call, including a self-call that is not in tail
 position, is untouched and stays a call.

 The transformation is an optimisation, so an unhandled shape is not a
 refusal: a tail position this walk does not descend into simply emits
 `return <expr>;` and whatever recursion is inside it stays recursion.
 That keeps the emitted program correct under every shape and makes the
 feature's reach a matter of how deep the spine walk goes, which is the
 honest thing for it to depend on.

  ZigTail = record {
   tail-name : Text,
   tail-arity : Integer,
   tail-vars : List Text
  }

  zig-tail-none : ZigTail
  zig-tail-none = ZigTail { tail-name = "", tail-arity = 0, tail-vars = [] }

  zig-tail-active : ZigTail -> Boolean
  zig-tail-active (t) = text-length (t.tail-name) > 0

 The loop's vars cannot be the parameters themselves: zig parameters are
 immutable, and zig forbids shadowing them, so the var takes a prefix and
 every mention of the parameter in the body is renamed to it through the
 same renamed-from/renamed-to table lambdas and shadowed parameters use.

  zig-tail-var : Text -> Text
  zig-tail-var (n) = "_tl_" & zig-raw-ident n

  zig-tail-var-names : List IRParam, Integer -> List Text
  zig-tail-var-names (params) (i) =
   if i >= list-length params then []
   else [zig-tail-var ((list-at params i).name)] & zig-tail-var-names params (i + 1)

  zig-tail-self-call : IRExpr, ZigTail -> Boolean
  zig-tail-self-call (e) (tl) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     let chain = collect-apply-chain e []
     in when chain.root
      is IrName (n) (nty) (nsp) -> n == (tl.tail-name) & list-length (chain.args) == (tl.tail-arity)
      is otherwise -> False
    is otherwise -> False

 A guarded match compiles to a chain of ifs ending in unreachable rather
 than a switch, and that chain is built as an expression; the spine stops
 there rather than growing a second statement form for it.

 An act block is on the spine, and its tail position is its last
 statement -- but only when that statement EXECUTES. emit-zig-act is the
 authority: a block whose last statement binds breaks with `undefined`,
 so it has no tail position at all and nothing may descend into it. An
 empty block has none either. Every walk below asks the same question in
 the same shape, and they have to agree: has-self decides whether the
 definition loops, arg-invariant decides which parameters get variables,
 occurs-outside decides which get discarded, and emit-zig-tail writes
 the code. A walk that descends where another does not produces a loop
 whose parameters were chosen for a different spine.

 The python plug already descends here; ours treated an act as a leaf,
 so every `*-loop` written as an act kept its frames.

  zig-tail-has-self : IRExpr, ZigTail -> Boolean
  zig-tail-has-self (e) (tl) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> zig-tail-has-self t tl | zig-tail-has-self el tl
    is IrLet (m) (ty) (v) (b) (sp) -> zig-tail-has-self b tl
    is IrMatch (s) (bs) (ty) (sp) ->
     if zig-branches-guarded bs 0 then False else zig-tail-has-self-branches bs 0 tl
    is IrAct (ss) (aty) (asp) ->
     if list-length ss == 0 then False
     else when (list-at ss (list-length ss - 1))
      is IrDoExec (last) (lsp) -> zig-tail-has-self last tl
      is otherwise -> False
    is IrApply (f) (a) (ty) (sp) -> zig-tail-self-call e tl
    is otherwise -> False

 A parameter every self tail call passes straight back needs no loop
 variable: it never changes, so the function's own parameter is already
 the right binding and assigning it would be a copy from itself. This
 matters beyond tidiness. Zig will not hold a bare function type in a
 var, and `sort-partition (xs) (cmp) (j) (hi) (i) (pv)` -- self
 tail-recursive in both branches, the compiler's own partition loop --
 passes `cmp`, `hi` and `pv` through unchanged at every call. Declining
 the whole definition because one parameter is a function left 10,000
 partition frames on the stack that the transformation existed to
 remove; keeping the invariant ones as parameters flattens it.

  zig-tail-arg-invariant : IRExpr, ZigTail, Integer, Text -> Boolean
  zig-tail-arg-invariant (e) (tl) (i) (nm) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     zig-tail-arg-invariant t tl i nm & zig-tail-arg-invariant el tl i nm
    is IrLet (m) (ty) (v) (b) (sp) -> zig-tail-arg-invariant b tl i nm
    is IrMatch (s) (bs) (ty) (sp) ->
     if zig-branches-guarded bs 0 then True
     else zig-tail-arg-invariant-branches bs 0 tl i nm
    is IrAct (ss) (aty) (asp) ->
     if list-length ss == 0 then True
     else when (list-at ss (list-length ss - 1))
      is IrDoExec (last) (lsp) -> zig-tail-arg-invariant last tl i nm
      is otherwise -> True
    is IrApply (f) (a) (ty) (sp) ->
     if zig-tail-self-call e tl == False then True
     else when (list-at ((collect-apply-chain e []).args) i)
      is IrName (n) (nty) (nsp) -> n == nm
      is otherwise -> False
    is otherwise -> True

  zig-tail-arg-invariant-branches : List IRBranch, Integer, ZigTail, Integer, Text -> Boolean
  zig-tail-arg-invariant-branches (bs) (k) (tl) (i) (nm) =
   if k >= list-length bs then True
   else if zig-tail-arg-invariant ((list-at bs k).body) tl i nm
        then zig-tail-arg-invariant-branches bs (k + 1) tl i nm
        else False

 An empty var name marks a parameter that stays a parameter.

 Whether an invariant parameter needs a discard is a narrower question
 than zig-occurs answers, and zig rejects both wrong answers: an unused
 parameter is an error, and so is discarding one that is used. The loop
 deletes exactly one class of occurrence -- the parameter standing as
 its OWN argument in a tail self call, which is not re-assigned and so
 is never emitted. Nothing else is dropped, because an invariant slot's
 argument is by definition that parameter's own name. So the question is
 whether the parameter appears anywhere but there.

  zig-tail-occurs-outside : IRExpr, Text, ZigTail, Integer -> Boolean
  zig-tail-occurs-outside (e) (nm) (tl) (i) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     zig-occurs c nm | zig-tail-occurs-outside t nm tl i | zig-tail-occurs-outside el nm tl i
    is IrLet (m) (mty) (v) (b) (sp) ->
     zig-occurs v nm | zig-tail-occurs-outside b nm tl i
    is IrMatch (scrut) (bs) (ty) (sp) ->
     if zig-branches-guarded bs 0 then zig-occurs e nm
     else zig-occurs scrut nm | zig-tail-occurs-outside-branches bs 0 nm tl i
    is IrAct (ss) (aty) (asp) ->
     if list-length ss == 0 then zig-occurs e nm
     else when (list-at ss (list-length ss - 1))
      is IrDoExec (last) (lsp) ->
       zig-occurs-stmts-init ss 0 nm | zig-tail-occurs-outside last nm tl i
      is otherwise -> zig-occurs e nm
    is IrApply (f) (a) (ty) (sp) ->
     if zig-tail-self-call e tl == False then zig-occurs e nm
     else zig-occurs-args ((collect-apply-chain e []).args) 0 nm i
    is otherwise -> zig-occurs e nm

 Every statement but the last runs before the tail position, so a name
 mentioned there is read outside it. Only the last statement continues
 the spine, and zig-occurs-stmts would fold it back in.

  zig-occurs-stmts-init : List IRActStmt, Integer, Text -> Boolean
  zig-occurs-stmts-init (ss) (i) (n) =
   if i >= list-length ss - 1 then False
   else (when (list-at ss i)
    is IrDoBind (m) (ty) (v) (sp) -> zig-occurs v n
    is IrDoExec (e) (sp) -> zig-occurs e n) | zig-occurs-stmts-init ss (i + 1) n

  zig-tail-occurs-outside-branches : List IRBranch, Integer, Text, ZigTail, Integer -> Boolean
  zig-tail-occurs-outside-branches (bs) (k) (nm) (tl) (i) =
   if k >= list-length bs then False
   else if zig-tail-occurs-outside ((list-at bs k).body) nm tl i then True
   else zig-tail-occurs-outside-branches bs (k + 1) nm tl i

  zig-occurs-args : List IRExpr, Integer, Text, Integer -> Boolean
  zig-occurs-args (args) (k) (nm) (i) =
   if k >= list-length args then False
   else if k == i then zig-occurs-args args (k + 1) nm i
   else if zig-occurs (list-at args k) nm then True
   else zig-occurs-args args (k + 1) nm i

  zig-tail-var-list : List IRParam, Integer, IRExpr, ZigTail -> List Text
  zig-tail-var-list (params) (i) (body) (probe) =
   if i >= list-length params then []
   else let nm = (list-at params i).name
   in let one = if zig-tail-arg-invariant body probe i nm then "" else zig-tail-var nm
   in [one] & zig-tail-var-list params (i + 1) body probe

  zig-tail-has-self-branches : List IRBranch, Integer, ZigTail -> Boolean
  zig-tail-has-self-branches (bs) (i) (tl) =
   if i >= list-length bs then False
   else if zig-tail-has-self ((list-at bs i).body) tl then True
   else zig-tail-has-self-branches bs (i + 1) tl

 A definition with no parameters has nothing to assign and cannot loop,
 and one whose name is not applied at full arity in any tail position
 gains nothing, so both keep the plain form.

 Zig will not hold a bare function type in a var -- it must be const or
 comptime -- so a function-typed parameter that CHANGES across the loop
 has no variable to be, and its definition keeps the plain form. One that
 never changes is not a problem at all: it stays the function's own
 parameter, which is already const.

  zig-tail-params-ok : List IRParam, Integer, List Text -> Boolean
  zig-tail-params-ok (params) (i) (vars) =
   if i >= list-length params then True
   else if text-length (list-at vars i) == 0 then zig-tail-params-ok params (i + 1) vars
   else when ((list-at params i).type-val)
    is FunTy (p) (fnrow) (r) -> False
    is otherwise -> zig-tail-params-ok params (i + 1) vars

  zig-tail-for : IRDef -> ZigTail
  zig-tail-for (d) =
   let n = list-length (d.params)
   in if n == 0 then zig-tail-none
   else let probe = ZigTail {
    tail-name = d.name,
    tail-arity = n,
    tail-vars = zig-tail-var-names (d.params) 0
   }
   in if zig-tail-has-self (d.body) probe == False then zig-tail-none
   else let vars = zig-tail-var-list (d.params) 0 (d.body) probe
   in if zig-tail-params-ok (d.params) 0 vars == False then zig-tail-none
      else ZigTail { tail-name = d.name, tail-arity = n, tail-vars = vars }

  zig-tail-return : IRExpr, ZigCtx, Integer -> Text
  zig-tail-return (e) (ctx) (d) = "return " & emit-zig-expr e ctx (d + 1) & ";"

 The arguments are evaluated into temporaries before any var is assigned,
 because an argument reads the parameters it is about to overwrite:
 `loop next (acc & [x]) i` assigning left to right would build the new
 accumulator out of the new list. The temporaries are named by depth, so
 two jump sites on one spine cannot collide.

  emit-zig-tail-temps : List IRExpr, ZigCtx, Integer, Integer, List Text -> Text
  emit-zig-tail-temps (args) (ctx) (d) (i) (vars) =
   if i >= list-length args then ""
   else if text-length (list-at vars i) == 0
        then emit-zig-tail-temps args ctx d (i + 1) vars
   else "const _tj" & integer-to-text d & "_" & integer-to-text i & " = "
      & emit-zig-expr (list-at args i) ctx (d + 1) & "; "
      & emit-zig-tail-temps args ctx d (i + 1) vars

  emit-zig-tail-assigns : List Text, Integer, Integer -> Text
  emit-zig-tail-assigns (vars) (d) (i) =
   if i >= list-length vars then ""
   else if text-length (list-at vars i) == 0
        then emit-zig-tail-assigns vars d (i + 1)
   else (list-at vars i) & " = _tj" & integer-to-text d & "_" & integer-to-text i & "; "
      & emit-zig-tail-assigns vars d (i + 1)

  emit-zig-tail-jump : IRExpr, ZigCtx, Integer, ZigTail -> Text
  emit-zig-tail-jump (e) (ctx) (d) (tl) =
   let chain = collect-apply-chain e []
   in "{ " & emit-zig-tail-temps (chain.args) ctx d 0 (tl.tail-vars)
    & emit-zig-tail-assigns (tl.tail-vars) d 0 & "continue; }"

 The statement form of the spine. Everything here has an expression twin
 in emit-zig-expr and must stay in step with it; what differs is only
 that a value is returned rather than broken out of a labeled block.

  emit-zig-tail : IRExpr, ZigCtx, Integer, ZigTail -> Text
  emit-zig-tail (e) (ctx) (d) (tl) =
   if d >= zig-max-depth then zig-refuse ("tail spine nested past zig-max-depth (" & integer-to-text zig-max-depth & "); raise the cap")
   else when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     "if (" & emit-zig-expr c ctx (d + 1) & ") { " & emit-zig-tail t ctx (d + 1) tl
      & " } else { " & emit-zig-tail el ctx (d + 1) tl & " }"
    is IrLet (name) (ty) (val) (body) (sp) ->
     if zig-is-seq-name name
     then "_ = " & emit-zig-expr val ctx (d + 1) & "; " & emit-zig-tail body ctx (d + 1) tl
     else if zig-occurs body name
     then "const " & zig-bind-name ctx name d & zig-let-annot ty & " = " & emit-zig-expr val ctx (d + 1) & "; "
        & emit-zig-tail body (zig-bind-push ctx name d) (d + 1) tl
     else "_ = " & emit-zig-expr val ctx (d + 1) & "; " & emit-zig-tail body ctx (d + 1) tl
    is IrMatch (scrut) (branches) (ty) (sp) ->
     if zig-branches-guarded branches 0 then zig-tail-return e ctx d
     else "switch (" & emit-zig-expr scrut ctx (d + 1) & zig-match-deref ctx (zig-expr-type scrut) & ") { "
        & emit-zig-match-arms branches 0 ctx d (zig-match-exhaustive ctx (zig-expr-type scrut) branches) ty tl & " }"
    is IrAct (ss) (aty) (asp) ->
     if list-length ss == 0 then zig-tail-return e ctx d
     else when (list-at ss (list-length ss - 1))
      is IrDoExec (last) (lsp) -> emit-zig-act-tail ss 0 ctx d tl
      is otherwise -> zig-tail-return e ctx d
    is IrApply (f) (a) (ty) (sp) ->
     if zig-tail-self-call e tl then emit-zig-tail-jump e ctx d tl else zig-tail-return e ctx d
    is otherwise -> zig-tail-return e ctx d

 The twin of emit-zig-act-stmts, and it differs in one statement: the
 last one, which emit-zig-act breaks out of the labeled block with and
 this continues the spine into. Everything before it is emitted
 identically, because a statement that is not last is not in tail
 position however the block ends.

 No label and no block are emitted around it. Nothing breaks with a
 value any more -- the last statement either jumps or returns -- and the
 IrLet arm above already emits its binding into the caller's block for
 the same reason. `continue` still names the enclosing while, which a
 labeled block would not have shadowed either.

  emit-zig-act-tail : List IRActStmt, Integer, ZigCtx, Integer, ZigTail -> Text
  emit-zig-act-tail (stmts) (i) (ctx) (d) (tl) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in let rest = when s
    is IrDoBind (name) (ty) (val) (sp) -> if zig-is-seq-name name then ctx else zig-bind-push ctx name d
    is otherwise -> ctx
   in (when s
    is IrDoBind (name) (ty) (val) (sp) ->
     if zig-is-seq-name name then "_ = " & emit-zig-expr val ctx (d + 1) & "; "
     else "const " & zig-bind-name ctx name d & " = " & emit-zig-expr val ctx (d + 1) & "; "
    is IrDoExec (e) (sp) ->
     if is-last then emit-zig-tail e ctx (d + 1) tl
     else "_ = " & emit-zig-expr e ctx (d + 1) & "; ") & emit-zig-act-tail stmts (i + 1) rest d tl

 Zig rejects a local nothing reads, and the IR carries parameters a body
 never mentions, so an unread var is discarded exactly as an unread
 parameter is. It is still assigned by every jump, which is what keeps
 zig from asking for a const instead.

 The var initialises from the name the PARAMETER is emitted under, not
 from the name the IR spells: a parameter that shadows a top-level
 definition has already been renamed by zig-push-param-renames, and
 reading the raw name here left the real parameter unused and named one
 that does not exist. zig-def-param-name is the one place that knows.

  emit-zig-tail-vars : List IRParam, Integer, IRExpr, ZigCtx, List Text, ZigTail -> Text
  emit-zig-tail-vars (params) (i) (body) (ctx) (vars) (tl) =
   if i >= list-length params then ""
   else let p = list-at params i
   in let v = list-at vars i
   in let line = if text-length v == 0
      then (if zig-tail-occurs-outside body (p.name) tl i then ""
            else "    _ = " & zig-def-param-name ctx (p.name) & ";\n")
      else "    var " & v & " = " & zig-def-param-name ctx (p.name) & ";\n"
         & (if zig-occurs body (p.name) then "" else "    _ = " & v & ";\n")
   in line & emit-zig-tail-vars params (i + 1) body ctx vars tl

  zig-push-tail-renames : ZigCtx, List IRParam, Integer, List Text -> ZigCtx
  zig-push-tail-renames (ctx) (params) (i) (vars) =
   if i >= list-length params then ctx
   else if text-length (list-at vars i) == 0
        then zig-push-tail-renames ctx params (i + 1) vars
   else let nm = (list-at params i).name
   in let ctx2 = ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = (ctx.renamed-from) & [nm],
    renamed-to = (ctx.renamed-to) & [list-at vars i],
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ctx.expected,
    bound-names = ctx.bound-names,
    scope-tvars = ctx.scope-tvars
   }
   in zig-push-tail-renames ctx2 params (i + 1) vars

Section: Definition Emission

 subj-deck-record is the bundler's rename of the compiler's deck-record
 region hint; calls pass through as the argument and the identity def
 itself is skipped rather than emitted as an unusable generic. Skipping
 the def obliges the intercept: lookup-zig-builtin's yield-to-module-
 definitions rule exempts exactly the names listed here, or every call
 site would name a definition that was never emitted.

  zig-skip-def : Text -> Boolean
  zig-skip-def (n) = n == "subj-deck-record"

 A definition's own type-val is not reliably populated -- map-list-loop's
 is unresolved, which is why it took no comptime parameters at all even
 though its parameters plainly use T38 and T39, and why its return type
 came out anyopaque. The parameters carry good types when the summary type
 does not, so both are collected.

 Peeling the return off type-val only works when type-val is populated.
 When it is not -- map-list-loop again -- the body's own type is what the
 definition actually returns, and it is the only source left.

 A type-val carrying FEWER arrows than the definition has parameters is
 not describing this definition, and peeling it cannot be trusted:
 zig-peel-return stops when it runs out of arrows and hands back whatever
 is left, so an unpopulated type-val peels to itself and an unpopulated
 VoidTy peels to a perfectly valid "void". The marker check below cannot
 see that, because void is a mapping rather than a gap -- sort-by emitted
 as returning void while its body returned a list, and zig caught it only
 because the body disagreed.

 The arrow count is the test. It is not a guess about what the type should
 have been: it is the observation that this type cannot be the type of a
 definition taking this many parameters, whereupon the body's own type is
 the answer, exactly as it is for an unmapped one.

 Taking the return type off the body is the right answer but a silent one,
 and how often it happens is worth knowing rather than guessing: sort-by
 was caught only because its body returned a list into a void signature,
 and a definition whose body really is void would have taken the wrong
 answer without a word. The note is a zig comment, so counting them costs
 nothing and cannot break a build.

  zig-untrusted-return-note : IRDef -> Text
  zig-untrusted-return-note (d) =
   if zig-def-return-trusted d then ""
   else "    // zig plug: return type from body; type-val has "
    & integer-to-text (zig-fn-param-count (d.type-val)) & " arrows for "
    & integer-to-text (list-length (d.params)) & " params\n"

  zig-def-return-trusted : IRDef -> Boolean
  zig-def-return-trusted (d) =
   zig-fn-param-count (d.type-val) >= list-length (d.params)

  zig-def-return-type : IRDef, List (Integer between 0 and 4294967295) -> CodexType
  zig-def-return-type (d) (scope) =
   if zig-def-return-trusted d == False then zig-expr-type (d.body)
   else let peeled = zig-peel-return (d.type-val) (list-length (d.params))
   in if zig-is-unmapped (emit-zig-type peeled scope) then zig-expr-type (d.body) else peeled

  zig-def-return-text : IRDef, List (Integer between 0 and 4294967295) -> Text
  zig-def-return-text (d) (scope) =
   if zig-def-return-trusted d == False then emit-zig-type (zig-expr-type (d.body)) scope
   else let peeled = emit-zig-type (zig-peel-return (d.type-val) (list-length (d.params))) scope
   in if zig-is-unmapped peeled then emit-zig-type (zig-expr-type (d.body)) scope else peeled

 The marker is the signal. Which codex type an unpopulated type-val holds
 is not something to guess at -- VoidTy was the guess and it was wrong --
 but "emit-zig-type could not map it" is exactly what the marker records.

  zig-is-unmapped : Text -> Boolean
  zig-is-unmapped (t) =
   if text-length t < 13 then False else substring t 0 13 == "@compileError"

  zig-def-tvar-ids : IRDef -> List (Integer between 0 and 4294967295)
  zig-def-tvar-ids (d) =
   zig-def-param-tvars (d.params) 0 (zig-tvar-ids (d.type-val) [])

  zig-def-param-tvars : List IRParam, Integer, List (Integer between 0 and 4294967295) -> List (Integer between 0 and 4294967295)
  zig-def-param-tvars (params) (i) (acc) =
   if i >= list-length params then acc
   else zig-def-param-tvars params (i + 1) (zig-tvar-ids ((list-at params i).type-val) acc)

 Zig forbids a parameter from shadowing a top-level declaration, and codex
 does not: NameResolver has a global `builtins` and build-all-names-scope
 takes a parameter called `builtins`. This is the same problem the lambda
 parameters had, one scope out, so it takes the same answer -- rename the
 parameter and carry the rename into the body.

 The collision is with definitions, which is what emit-zig-defs writes at
 the top level. Constructors and type names live there too, and a param
 colliding with one of those would need the same treatment; nothing has
 hit it yet, and the marker would not catch it because it is a name error
 rather than a type error.

  zig-param-shadows : ZigCtx, Text -> Boolean
  zig-param-shadows (ctx) (n) =
   zig-find-irdef (ctx.irdefs) 0 n >= 0

  zig-def-param-name : ZigCtx, Text -> Text
  zig-def-param-name (ctx) (n) =
   if zig-param-shadows ctx n then "_arg_" & zig-raw-ident n else zig-sanitize n

  zig-push-param-renames : ZigCtx, List IRParam, Integer -> ZigCtx
  zig-push-param-renames (ctx) (params) (i) =
   if i >= list-length params then ctx
   else let nm = (list-at params i).name
   in if zig-param-shadows ctx nm == False then zig-push-param-renames ctx params (i + 1)
   else let ctx2 = ZigCtx {
    arities = ctx.arities,
    ctors = ctx.ctors,
    typedefs = ctx.typedefs,
    irdefs = ctx.irdefs,
    renamed-from = (ctx.renamed-from) & [nm],
    renamed-to = (ctx.renamed-to) & ["_arg_" & zig-raw-ident nm],
    tvar-ids = ctx.tvar-ids,
    tvar-types = ctx.tvar-types,
    expected = ctx.expected,
    bound-names = ctx.bound-names,
    scope-tvars = ctx.scope-tvars
   }
   in zig-push-param-renames ctx2 params (i + 1)

  zig-comptime-params : List (Integer between 0 and 4294967295), Integer -> Text
  zig-comptime-params (ids) (i) =
   if i >= list-length ids then ""
   else "comptime T" & integer-to-text (list-at ids i) & ": type, "
      & zig-comptime-params ids (i + 1)

 The loop body's context takes BOTH renames, and the order is the whole
 of it. zig-push-tail-renames covers the parameters the loop reassigns
 and only those: an invariant slot is never assigned, so it gets no loop
 var and no rename, and a parameter of that kind whose name shadows a
 top-level definition then resolved to THE DEFINITION -- the loop read a
 global where the source read its own argument, silently. Composing
 zig-push-param-renames underneath restores the `_arg_` name for exactly
 those parameters, and the tail renames still win for the reassigned
 ones because zig-renamed-scan reads from the end. The non-loop branch
 below has always done this; the two branches now agree.

  emit-zig-def : IRDef, ZigCtx -> Text
  emit-zig-def (d) (ctx0) =
   if zig-skip-def (d.name) then ""
   else let name = zig-sanitize (d.name)
   in let tvars = zig-def-tvar-ids d
   in let comptimes = zig-comptime-params tvars 0
   in let ret = zig-def-return-text d tvars
   in let ctx = ZigCtx {
    arities = ctx0.arities,
    ctors = ctx0.ctors,
    typedefs = ctx0.typedefs,
    irdefs = ctx0.irdefs,
    renamed-from = ctx0.renamed-from,
    renamed-to = ctx0.renamed-to,
    tvar-ids = ctx0.tvar-ids,
    tvar-types = ctx0.tvar-types,
    expected = zig-def-return-type d tvars,
    bound-names = [],
    scope-tvars = tvars
   }
   in let params-text = emit-zig-def-params (d.params) 0 ctx
   in let all-params = if text-length params-text == 0
      then zig-drop-trailing-comma comptimes
      else comptimes & params-text
   in let tl = zig-tail-for d
   in let head = "fn " & name & "(" & all-params & ") " & ret & " {\n"
    & zig-untrusted-return-note d
    & zig-eval-quota (d.body)
   in if zig-tail-active tl
   then head
    & emit-zig-tail-vars (d.params) 0 (d.body) (zig-push-param-renames ctx (d.params) 0) (tl.tail-vars) tl
    & "    while (true) {\n        "
    & emit-zig-tail (d.body) (zig-push-bound-params (zig-push-tail-renames (zig-push-param-renames ctx (d.params) 0) (d.params) 0 (tl.tail-vars)) (d.params) 0) 0 tl
    & "\n    }\n}\n\n"
   else let body-text = emit-zig-expr (d.body) (zig-push-bound-params (zig-push-param-renames ctx (d.params) 0) (d.params) 0) 0
   in head
    & (if zig-body-refused body-text
       then emit-zig-all-param-discards (d.params) 0
       else emit-zig-param-discards (d.params) 0 (d.body))
    & "    return " & body-text & ";\n}\n\n"

 Zig evaluates an array literal's shape at comptime and gives up after
 1000 backwards branches. The builtins table is one literal of about
 two hundred records, each holding a closure, and it blows that quota;
 the failure is a compiler resource limit rather than anything about
 the program, and zig's own answer to it is @setEvalBranchQuota.

 The quota is raised in every definition holding a literal of 32
 elements or more, not in every definition: the statement is only
 meaningful where a comptime evaluation happens beneath it, and
 emitting it everywhere would put a line nothing reads in front of
 several thousand function bodies.

  zig-eval-quota-floor : Integer = 32

  zig-eval-quota : IRExpr -> Text
  zig-eval-quota (body) =
   if zig-max-list-len body < zig-eval-quota-floor then ""
   else "    @setEvalBranchQuota(1000000);\n"

 The walk mirrors zig-occurs: same nodes, same reason to visit them,
 and the same consequence for a node it forgets -- here a quota that
 stays default under a literal that needed it, which fails loudly at
 zig compile time.

 Both walks skipped a branch's GUARD, and both were fixed together for
 that reason: a 40-element literal in a guard was measured emitting no
 @setEvalBranchQuota while the identical literal one field over, in the
 branch's body, emitted one. Neither walk descends into an effect
 handler's clauses either, and that one is deliberate -- emit-zig-expr
 answers @compileError for any IrHandle carrying clauses, so nothing
 beneath one is ever emitted and there is nothing to count.

  zig-max2 : Integer, Integer -> Integer
  zig-max2 (a) (b) = if a >= b then a else b

  zig-max-list-len : IRExpr -> Integer
  zig-max-list-len (e) =
   when e
    is IrList (es) (ty) (sp) -> zig-max2 (list-length es) (zig-max-list-len-list es 0)
    is IrBinary (op) (l) (r) (ty) (sp) -> zig-max2 (zig-max-list-len l) (zig-max-list-len r)
    is IrNegate (o) (ty) (sp) -> zig-max-list-len o
    is IrIf (c) (t) (el) (ty) (sp) -> zig-max2 (zig-max-list-len c) (zig-max2 (zig-max-list-len t) (zig-max-list-len el))
    is IrLet (m) (ty) (v) (b) (sp) -> zig-max2 (zig-max-list-len v) (zig-max-list-len b)
    is IrApply (f) (a) (ty) (sp) -> zig-max2 (zig-max-list-len f) (zig-max-list-len a)
    is IrLambda (ps) (b) (ty) (sp) -> zig-max-list-len b
    is IrMatch (s) (bs) (ty) (sp) -> zig-max2 (zig-max-list-len s) (zig-max-list-len-branches bs 0)
    is IrAct (ss) (ty) (sp) -> zig-max-list-len-stmts ss 0
    is IrTry (mx) (b) (fb) (fs) (ty) (sp) -> zig-max2 (zig-max-list-len-stmts b 0) (zig-max2 (zig-max-list-len-stmts fb 0) (zig-max-list-len-stmts fs 0))
    is IrHandle (eff) (b) (cs) (ty) (sp) -> zig-max-list-len b
    is IrWithTimeout (secs) (effs) (scopes) (b) (ty) (sp) -> zig-max-list-len b
    is IrRecord (nm) (fs) (ty) (sp) -> zig-max-list-len-fields fs 0
    is IrFieldAccess (r) (f) (ty) (sp) -> zig-max-list-len r
    is IrFieldStore (r) (f) (v) (ty) (sp) -> zig-max2 (zig-max-list-len r) (zig-max-list-len v)
    is IrFork (b) (ty) (sp) -> zig-max-list-len b
    is IrAwait (t) (ty) (sp) -> zig-max-list-len t
    is otherwise -> 0

  zig-max-list-len-list : List IRExpr, Integer -> Integer
  zig-max-list-len-list (es) (i) =
   if i >= list-length es then 0
   else zig-max2 (zig-max-list-len (list-at es i)) (zig-max-list-len-list es (i + 1))

  zig-max-list-len-branches : List IRBranch, Integer -> Integer
  zig-max-list-len-branches (bs) (i) =
   if i >= list-length bs then 0
   else let b = list-at bs i
   in let here = zig-max2 (zig-max-list-len (b.guard)) (zig-max-list-len (b.body))
   in zig-max2 here (zig-max-list-len-branches bs (i + 1))

  zig-max-list-len-stmts : List IRActStmt, Integer -> Integer
  zig-max-list-len-stmts (ss) (i) =
   if i >= list-length ss then 0
   else zig-max2 (when (list-at ss i)
    is IrDoBind (m) (ty) (v) (sp) -> zig-max-list-len v
    is IrDoExec (x) (sp) -> zig-max-list-len x) (zig-max-list-len-stmts ss (i + 1))

  zig-max-list-len-fields : List IRFieldVal, Integer -> Integer
  zig-max-list-len-fields (fs) (i) =
   if i >= list-length fs then 0
   else zig-max2 (zig-max-list-len ((list-at fs i).value)) (zig-max-list-len-fields fs (i + 1))

 A parameter the body never mentions is a hard error in zig, not a warning,
 so a definition that ignores an argument needs the discard written out.
 The occurs check reads the IR, so the name is compared unsanitized.

 `emit-zig-param-discards` asks `zig-occurs` about the IR body, and that is
 the right question everywhere the emitter answers. Where it REFUSES it is
 the wrong one: the refusal replaces the expression that read the
 parameter, so the IR still uses it and the emitted zig does not. Zig then
 reports `unused function parameter` against the signature -- before it
 ever analyses the `@compileError` in the body -- and the plug's sentence
 is never printed. Finding 51, measured on three Roc ports and the probe
 matrix.

 So a refused body discards EVERY parameter. Not the ones a name search
 says are dead: `_ = x;` beside a live use is legal zig, and a substring
 test on parameter names is the word-boundary collision this tree has
 already been bitten by. Discarding all of them cannot misfire, and the
 first thing zig has left to analyse is the message.

  zig-body-refused : Text -> Boolean
  zig-body-refused (t) =
   text-contains t "zig plug: "

  emit-zig-all-param-discards : List IRParam, Integer -> Text
  emit-zig-all-param-discards (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in "    _ = " & zig-sanitize (p.name) & ";\n" & emit-zig-all-param-discards params (i + 1)

  emit-zig-param-discards : List IRParam, Integer, IRExpr -> Text
  emit-zig-param-discards (params) (i) (body) =
   if i == list-length params then ""
   else let p = list-at params i
   in let line = if zig-occurs body (p.name) then ""
      else "    _ = " & zig-sanitize (p.name) & ";\n"
   in line & emit-zig-param-discards params (i + 1) body

  emit-zig-def-params : List IRParam, Integer, ZigCtx -> Text
  emit-zig-def-params (params) (i) (ctx) =
   if i == list-length params then ""
   else let p = list-at params i
   in let one = zig-def-param-name ctx (p.name) & ": " & emit-zig-type (p.type-val) (ctx.scope-tvars)
   in if i == list-length params - 1 then one
   else one & ", " & emit-zig-def-params params (i + 1) ctx

 Assembling the output has the same hazard as escaping it: joining N pieces
 with a right-recursive `&` copies every piece it has not reached yet, so
 the cost is the output size times the number of definitions rather than
 the output size. Collect and join once.

  emit-zig-defs : List IRDef, Integer, ZigCtx -> Text
  emit-zig-defs (defs) (i) (ctx) =
   text-concat-list (emit-zig-defs-loop defs i ctx [])

  emit-zig-defs-loop : List IRDef, Integer, ZigCtx, List Text -> List Text
  emit-zig-defs-loop (defs) (i) (ctx) (acc) =
   if i == list-length defs then acc
   else emit-zig-defs-loop defs (i + 1) ctx (list-push acc (emit-zig-def (list-at defs i) ctx))

Section: Chapter Emission

 Codex is written to recurse rather than loop, and bare metal answers that
 with a multi-gigabyte arena. Zig gives a main thread 8 MB. That was not
 enough when this plug emitted a call for every self-recursion:
 scan-class-instance-defs recurses once per token, and Parser.codex at
 18,812 tokens overflowed and segfaulted. ReleaseFast does not rescue that
 shape, since the calls sit inside labelled block expressions.

 This is the same wall CSharpPlug hit, and this is its answer -- run the
 entry point on a thread with a big stack, reserved address space
 committed on demand. .NET gives its main thread 1 MB and overflows on a
 96-byte chapter, so the need is a property of the source rather than of
 large input.

 No cycle this note can name is what holds the stack up any more, and the
 three worth naming are settled, so the next reader does not re-derive
 them. The lexer's scan-token -> skip-prose-line -> scan-token pair is
 MUTUAL and no self-tail transformation reaches it -- but it is measured
 FLAT: 100,000 consecutive prose lines run in a 256 KB stack, so it is not
 the case to reason from. scan-class-instance-defs recurses once per token
 and every one of its recursive calls is in tail position, so this plug
 emits it as a loop. The parser's top-level scans DID drive the depth --
 2,393 nested scan-top-level frames on the 2.5 MB back-end unit -- and
 they now return their item rather than mutually tail-calling, so
 parse-top-level is a loop here as well. Two of its arms still leave that
 loop: an `effect` declaration goes out through parse-top-level-effect and
 a top-level `claim` through parse-claim-arm and parse-simple-claim, and
 each of those tail-calls parse-top-level back, which self-tail
 elimination does not reach. They cost a frame apiece and they are rare:
 eight effect declarations and no claims in that same 2.5 MB unit, three
 and none in the parser. A residue of eight frames is not what a 512 MB
 stack is for.

 That makes 512 MB a number whose stated mechanism is gone, and the answer
 to that is to measure before lowering it rather than to lower it. Only
 codexir has been bisected against real documents; zigemit and the other
 natives have their own recursion and are unmeasured, so what one input
 needs is known and what every input needs is not.

 512 MB matches the C# default deliberately. What is NOT matched is its
 CODEX_STACK_MB override: zig 0.16's environment API is mid-refactor
 (std.posix.getenv is gone, std.process.Environ.Block differs by platform
 and has no global on POSIX), and a knob is not worth version-fragile code
 in every emitted program. Rebuild to change it.

 Zig requires a thread entry to return `u8`, `noreturn`, `!noreturn`,
 `void` or `!void`, and `opening` is spawned directly. 40 corpus programs
 declare `opening` returning a VALUE and every one of them was refused
 inside `std/Thread.zig` before a line of the subject was analysed --
 the second-largest refusal class in the corpus. Finding 53.

 The value is the program's OUTPUT, not a status: `ble-att-encode` ends
 `in a + b + c + d + e` and its `.expected` holds `5`. So the shim prints
 it rather than discarding it; discarding would trade 40 loud refusals
 for 40 silent mismatches.

 It dispatches on the CODEX type, arm for arm against
 `emit-opening-result-print` (`Emit/X86_64Chapter.codex:222`), because
 that is the oracle. An earlier draft asked the plug's own
 `zig-def-return-text` instead, reasoning that the shim then could not
 disagree with the signature it calls. That reasoning was wrong twice
 over. The zig type text is LOSSY -- Boolean and Char both arrive as
 something that is not `void`, not `[]const u8` and not `f64`, so both
 fell to an integer print: a `Boolean` entry would have emitted
 `cx_show_int(opening())`, which is finding 50 rebuilt at a new site, and
 a `Character` entry would have printed a number where bare metal prints
 NOTHING. Agreeing with our own signature is worth nothing; agreeing with
 the oracle is the whole job.

 C# is not the authority here and the first draft wrongly cited it:
 `opening-call-text` DISCARDS the value of an effectful `opening`. Bare
 metal peels the effect and prints, and the depot agrees -- `gpu-ptx` and
 `gpu-doorbell` declare `opening : [Console] Integer` and their
 `.expected` files end with the bare `0` that print produces.

 Two arms refuse rather than guess. Real wants `cx_real_to_text`, which
 does not exist here (finding 50 has the account of why guessing is
 worse). Lists, records and sums are what bare metal prints through
 `emit-opening-print-sum`, and this plug has no equivalent; a marker that
 names the gap beats `cx_show_int` on a pointer.

 `UnitTy` calls without printing, and that is a divergence: bare metal
 recurses into the inner type and prints it. The cause is upstream of the
 entry -- `emit-zig-type` maps every unit to `void`, so the signature has
 already discarded the payload and there is nothing left to print. Finding
 17's territory, named here rather than papered over. No depot program
 declares a unit-typed `opening`.

  zig-main : Text, List IRDef -> Text
  zig-main (entry) (defs) =
   "fn cx_entry() void {\n"
   & zig-entry-call (zig-sanitize entry) (zig-entry-return-type defs 0)
   & "}\n\n"
   & "pub fn main() void {\n"
   & "    const stack_bytes: usize = 512 * 1024 * 1024;\n"
   & "    const t = std.Thread.spawn(.{ .stack_size = stack_bytes }, cx_entry, .{}) catch @panic(\"spawn\");\n"
   & "    t.join();\n}\n"

  zig-entry-return-type : List IRDef, Integer -> CodexType
  zig-entry-return-type (defs) (i) =
   if i >= list-length defs then NothingTy
   else let d = list-at defs i
   in if (d.name) == opening-entry-point then zig-def-return-type d (zig-def-tvar-ids d)
   else zig-entry-return-type defs (i + 1)

  zig-entry-call : Text, CodexType -> Text
  zig-entry-call (name) (ret) =
   when ret
    is EffectfulTy (effs) (scopes) (inner) -> zig-entry-call name inner
    is IntegerTy (lo) (hi) (mode) -> "    cx_print_line(cx_show_int(" & name & "()));\n"
    is TextTy -> "    cx_print_line(" & name & "());\n"
    is BooleanTy -> "    cx_print_line(" & zig-show-bool-text (name & "()") & ");\n"
    is RealTy (w) (m) -> "    " & zig-entry-real-refusal & ";\n"
    is CharTy -> "    _ = " & name & "();\n"
    is VoidTy -> "    " & name & "();\n"
    is NothingTy -> "    " & name & "();\n"
    is ProofTy -> "    " & name & "();\n"
    is PropEqTy (pl) (pr) -> "    " & name & "();\n"
    is UnitTy (n) (inner) -> zig-entry-call name inner
    is otherwise -> "    " & zig-entry-refusal & ";\n"

  zig-entry-real-refusal : Text
  zig-entry-real-refusal =
   "@compileError(\"zig plug: opening returns a Real and printing it needs __real_to_text, which this plug does not have\")"

  zig-entry-refusal : Text
  zig-entry-refusal =
   "@compileError(\"zig plug: opening returns a type this plug cannot print at the entry\")"

 The banner between the program and the prelude. It lives here rather than
 inside zig-prelude because placement is emit-zig-chapter's concern, and
 because build/check-zig-prelude-surface.ps1 derives the reserved-name list
 from zig-prelude and should not have to read past a comment to do it.

  zig-postlude-banner : Text =
   "\n"
   & "// ========================================================================\n"
   & "// THE PRELUDE. Everything ABOVE this line is the transpiled program.\n"
   & "//\n"
   & "// What follows is fixed runtime support, emitted into every file this plug\n"
   & "// produces and identical in all of them: the bump allocator and its heap,\n"
   & "// the list and text builtins, the CCE tables, the deck.\n"
   & "//\n"
   & "// It is at the BOTTOM so that the code you came to read is the first thing\n"
   & "// in the file, and so a diff between two emitted programs opens on what\n"
   & "// differs rather than on hundreds of identical lines. Zig does not order\n"
   & "// declarations at container scope, so this costs nothing.\n"
   & "// ========================================================================\n\n"

 The prelude, cut into selectable parts. Each is a `List ShakeFrag` from
 `Foreword chapter Shake`: `ShakeLit` is inert text, `ShakeUse` is text that is
 ALSO a dependency on another part -- two projections of one list, so a part's
 text and its edges cannot drift apart.

 NOTHING HERE IMPLEMENTS THE SELECTION. The closure, the ordering and the
 reporting live in `Shake`, which knows nothing about zig and is exercised by
 its own fixtures. This chapter supplies only the data and the roots.

 A part's own declaration site is a ShakeUse of itself; `shake-frag-uses`
 drops the self-edge, which keeps one rule here instead of two.

 GENERATED by the ladder's `shake_parts.py` and gated part by part:
 `shake-frag-text` of each list rebuilds its original chunk byte for byte. Do
 not hand-edit; edit the prelude source and regenerate.

  zig-p-std : List ShakeFrag
  zig-p-std = [ShakeLit "const ", ShakeUse "std", ShakeLit " = @import(\"std\");\n\n"]

  zig-p-cxfn1 : List ShakeFrag
  zig-p-cxfn1 = [ShakeLit "// cx_gpa and the heap it allocates from live beside the buffer\n// builtins below: one region, one bump frontier, bare metal's model.\n\nfn ", ShakeUse "CxFn1", ShakeLit "(comptime A: type, comptime R: type) type {\n    return struct { ctx: *anyopaque, call: *const fn (*anyopaque, A) R };\n}\n"]

  zig-p-cxfn2 : List ShakeFrag
  zig-p-cxfn2 = [ShakeLit "fn ", ShakeUse "CxFn2", ShakeLit "(comptime A: type, comptime B: type, comptime R: type) type {\n    return struct { ctx: *anyopaque, call: *const fn (*anyopaque, A, B) R };\n}\n"]

  zig-p-cxfn3 : List ShakeFrag
  zig-p-cxfn3 = [ShakeLit "fn ", ShakeUse "CxFn3", ShakeLit "(comptime A: type, comptime B: type, comptime C: type, comptime R: type) type {\n    return struct { ctx: *anyopaque, call: *const fn (*anyopaque, A, B, C) R };\n}\n"]

  zig-p-cxfn4 : List ShakeFrag
  zig-p-cxfn4 = [ShakeLit "fn ", ShakeUse "CxFn4", ShakeLit "(comptime A: type, comptime B: type, comptime C: type, comptime D: type, comptime R: type) type {\n    return struct { ctx: *anyopaque, call: *const fn (*anyopaque, A, B, C, D) R };\n}\n"]

  zig-p-cxlist : List ShakeFrag
  zig-p-cxlist = [ShakeLit "fn ", ShakeUse "CxList", ShakeLit "(comptime T: type) type {\n    return struct { items: ", ShakeUse "std", ShakeLit ".ArrayListUnmanaged(T) = .empty };\n}\n"]

  zig-p-cx-ll-empty : List ShakeFrag
  zig-p-cx-ll-empty = [ShakeLit "fn ", ShakeUse "cx_ll_empty", ShakeLit "(comptime T: type) *", ShakeUse "CxList", ShakeLit "(T) {\n    const cx_l = ", ShakeUse "cx_gpa", ShakeLit ".create(", ShakeUse "CxList", ShakeLit "(T)) catch @panic(\"oom\");\n    cx_l.* = .{};\n    return cx_l;\n}\n"]

  zig-p-cx-ll-push : List ShakeFrag
  zig-p-cx-ll-push = [ShakeLit "fn ", ShakeUse "cx_ll_push", ShakeLit "(l: anytype, v: anytype) @TypeOf(l) {\n    l.items.append(", ShakeUse "cx_gpa", ShakeLit ", v) catch @panic(\"oom\");\n    return l;\n}\n"]

  zig-p-cx-ll-of : List ShakeFrag
  zig-p-cx-ll-of = [ShakeLit "// Exact, not rounded. These three build most of what emission\n// allocates -- every instruction is a list literal (mov-rr is\n// [rex-w, 137, modrm]) and write-bytes concatenates one per byte of an\n// immediate -- and they all land on the DECK, which is a finite\n// reservation nothing reclaims until the phase ends. Growing through\n// std's geometric growCapacity asked for 17 slots to hold four, twice\n// per concat, and measured 2026-08-21 that cost 6,963,432 bytes of deck\n// on fibx: 9,392,656 bytes of emit-runtime-helpers where bare metal\n// spends at most 2,682,824. Bare metal allocates cap*8 + 16 once, from\n// __list_concat_many over all operands at their true total. Reserve the\n// true total and append without re-checking; cx_ll_push keeps geometric\n// growth on purpose, because it is the repeated-append path.\nfn ", ShakeUse "cx_ll_of", ShakeLit "(comptime T: type, vs: []const T) *", ShakeUse "CxList", ShakeLit "(T) {\n    const l = ", ShakeUse "cx_ll_empty", ShakeLit "(T);\n    l.items.ensureTotalCapacityPrecise(", ShakeUse "cx_gpa", ShakeLit ", vs.len) catch @panic(\"oom\");\n    l.items.appendSliceAssumeCapacity(vs);\n    return l;\n}\n"]

  zig-p-cx-ll-concat : List ShakeFrag
  zig-p-cx-ll-concat = [ShakeLit "fn ", ShakeUse "cx_ll_concat", ShakeLit "(a: anytype, b: @TypeOf(a)) @TypeOf(a) {\n    const c = ", ShakeUse "cx_new", ShakeLit "(@TypeOf(a.*){ .items = .empty });\n    c.items.ensureTotalCapacityPrecise(", ShakeUse "cx_gpa", ShakeLit ", a.items.items.len + b.items.items.len) catch @panic(\"oom\");\n    c.items.appendSliceAssumeCapacity(a.items.items);\n    c.items.appendSliceAssumeCapacity(b.items.items);\n    return c;\n}\n"]

  zig-p-cx-ll-cons : List ShakeFrag
  zig-p-cx-ll-cons = [ShakeLit "fn ", ShakeUse "cx_ll_cons", ShakeLit "(v: anytype, l: anytype) @TypeOf(l) {\n    const c = ", ShakeUse "cx_new", ShakeLit "(@TypeOf(l.*){ .items = .empty });\n    c.items.ensureTotalCapacityPrecise(", ShakeUse "cx_gpa", ShakeLit ", 1 + l.items.items.len) catch @panic(\"oom\");\n    c.items.appendAssumeCapacity(v);\n    c.items.appendSliceAssumeCapacity(l.items.items);\n    return c;\n}\n"]

  zig-p-cx-ll-insert-at : List ShakeFrag
  zig-p-cx-ll-insert-at = [ShakeLit "fn ", ShakeUse "cx_ll_insert_at", ShakeLit "(l: anytype, i: i64, v: anytype) @TypeOf(l) {\n    l.items.insert(", ShakeUse "cx_gpa", ShakeLit ", @intCast(i), v) catch @panic(\"oom\");\n    return l;\n}\n"]

  zig-p-cx-ll-with-capacity : List ShakeFrag
  zig-p-cx-ll-with-capacity = [ShakeLit "// The capacity is load-bearing, not a hint. The emit tables are\n// pre-sized to accum-capacity precisely so a push inside emit-all-defs'\n// per-definition save/restore bracket never reallocates: a reallocation\n// there lands in scratch the bracket reclaims, and the table's header\n// survives pointing at bytes the next definition overwrites. The\n// compiler says so itself, in the guard beside that bracket -- \"a push\n// past it reallocates into scratch that this loop reclaims, corrupting\n// the table\". Discarding n was survivable only while __heap-restore was\n// a no-op. Precise, not rounded: pre-allocated to accum-capacity is a\n// statement about a number.\nfn ", ShakeUse "cx_ll_with_capacity", ShakeLit "(comptime T: type, n: i64) *", ShakeUse "CxList", ShakeLit "(T) {\n    const l = ", ShakeUse "cx_ll_empty", ShakeLit "(T);\n    if (n > 0) l.items.ensureTotalCapacityPrecise(", ShakeUse "cx_gpa", ShakeLit ", @intCast(n)) catch @panic(\"oom\");\n    return l;\n}\n"]

  zig-p-cx-text-compare : List ShakeFrag
  zig-p-cx-text-compare = [ShakeLit "fn ", ShakeUse "cx_text_compare", ShakeLit "(a: []const u8, b: []const u8) i64 {\n    return switch (", ShakeUse "std", ShakeLit ".mem.order(u8, a, b)) { .lt => -1, .eq => 0, .gt => 1 };\n}\n"]

  zig-p-cx-text-to-double-bits : List ShakeFrag
  zig-p-cx-text-to-double-bits = [ShakeLit "// Mirrors bare metal's __text_to_double, not a correctly-rounded parse:\n// accumulate the digits as one wrapping integer, count places after the\n// dot, cvtsi2sd once, divide once by 10^frac built by repeated\n// multiplication. The bits land in IrNumLit, so they must match the seed's\n// exactly; a parser that rounds better is a parser that diverges.\nfn ", ShakeUse "cx_text_to_double_bits", ShakeLit "(s: []const u8) i64 {\n    if (s.len == 0) return 0;\n    var i: usize = 0;\n    var neg = false;\n    if (s[0] == 73) {\n        neg = true;\n        i = 1;\n    }\n    var acc: i64 = 0;\n    var frac: i64 = 0;\n    var dot: i64 = 0;\n    while (i < s.len) : (i += 1) {\n        const b = s[i];\n        if (b == 65) {\n            dot = 1;\n            continue;\n        }\n        acc = acc *% 10 +% (@as(i64, b) -% 3);\n        frac += dot;\n    }\n    if (neg) acc = -%acc;\n    var v: f64 = @floatFromInt(acc);\n    if (frac != 0) {\n        var p: f64 = 1.0;\n        var k = frac;\n        while (k != 0) : (k -= 1) p *= 10.0;\n        v /= p;\n    }\n    return @bitCast(v);\n}\n"]

  zig-p-cx-bits-to-real-approx : List ShakeFrag
  zig-p-cx-bits-to-real-approx = [ShakeLit "// real-f32 on bare metal is f32 bits in a general register (a movd\n// round-trip, emit-bits-to-real-approx-builtin); Real is f64 here, and\n// widening the named f32 value is exact.\nfn ", ShakeUse "cx_bits_to_real_approx", ShakeLit "(bits: i64) f64 {\n    return @floatCast(@as(f32, @bitCast(@as(u32, @truncate(@as(u64, @bitCast(bits)))))));\n}\n"]

  zig-p-cx-char-to-text : List ShakeFrag
  zig-p-cx-char-to-text = [ShakeLit "// A char is a CCE code and text is CCE, so making text from a char is\n// ONE raw byte, the way bare metal does: emit-char-to-text-builtin stores\n// the code with mov-store-byte, length 1, no framing, truncating silently\n// past 255. Byte-wise text rebuilds (ir-quote walks char-code-at /\n// code-to-char / char-to-text over every byte) rely on that identity to\n// pass CCE frame bytes through untouched; framing or converting here\n// corrupts the wire.\nfn ", ShakeUse "cx_char_to_text", ShakeLit "(c: i64) []const u8 {\n    const b = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, 1) catch @panic(\"oom\");\n    b[0] = @truncate(@as(u64, @bitCast(c)));\n    return b;\n}\n"]

  zig-p-cx-char-encode : List ShakeFrag
  zig-p-cx-char-encode = [ShakeLit "fn ", ShakeUse "cx_char_encode", ShakeLit "(c: i64) []const u8 {\n    const u = @as(u64, @bitCast(c));\n    if (u < 128) {\n        const b = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, 1) catch @panic(\"oom\");\n        b[0] = @truncate(u);\n        return b;\n    }\n    if (u < 2176) {\n        const v = u - 128;\n        const b = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, 2) catch @panic(\"oom\");\n        b[0] = @truncate(192 | (v >> 6));\n        b[1] = @truncate(128 | (v & 63));\n        return b;\n    }\n    if (u < 67712) {\n        const v = u - 2176;\n        const b = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, 3) catch @panic(\"oom\");\n        b[0] = @truncate(224 | (v >> 12));\n        b[1] = @truncate(128 | ((v >> 6) & 63));\n        b[2] = @truncate(128 | (v & 63));\n        return b;\n    }\n    const v = u - 67712;\n    const b = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, 4) catch @panic(\"oom\");\n    b[0] = @truncate(240 | (v >> 18));\n    b[1] = @truncate(128 | ((v >> 12) & 63));\n    b[2] = @truncate(128 | ((v >> 6) & 63));\n    b[3] = @truncate(128 | (v & 63));\n    return b;\n}\n"]

  zig-p-cx-list-len : List ShakeFrag
