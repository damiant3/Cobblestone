  zig-p-cx-utf8-to-cce : List ShakeFrag
  zig-p-cx-utf8-to-cce = [ShakeLit "// The I/O boundary. Codex text is CCE everywhere inside -- on bare metal\n// and here alike -- so these convert at the edge and nowhere else: bytes\n// arriving become CCE, bytes leaving are already what they are. std.fs in\n// 0.16 wants an Io the generated main has no reason to carry, so this uses\n// the raw syscalls.\nfn ", ShakeUse "cx_utf8_to_cce", ShakeLit "(bytes: []const u8) []const u8 {\n    var out: ", ShakeUse "std", ShakeLit ".ArrayListUnmanaged(u8) = .empty;\n    var i: usize = 0;\n    while (i < bytes.len) {\n        const n = ", ShakeUse "std", ShakeLit ".unicode.utf8ByteSequenceLength(bytes[i]) catch @panic(\"cx_utf8_to_cce: bad utf8\");\n        const cp = ", ShakeUse "std", ShakeLit ".unicode.utf8Decode(bytes[i..][0..n]) catch @panic(\"cx_utf8_to_cce: bad utf8\");\n        ", ShakeUse "cx_cce_frame", ShakeLit "(", ShakeUse "cx_cp_to_cce", ShakeLit "(cp), &out);\n        i += n;\n    }\n    return out.items;\n}\n"]

  zig-p-cx-read-file-uni : List ShakeFrag
  zig-p-cx-read-file-uni = [ShakeLit "fn ", ShakeUse "cx_read_file_uni", ShakeLit "(path_cce: []const u8) []const u8 {\n    const al = ", ShakeUse "cx_gpa", ShakeLit ";\n    const path = ", ShakeUse "cx_cce_to_utf8", ShakeLit "(path_cce);\n    const z = al.allocSentinel(u8, path.len, 0) catch @panic(\"oom\");\n    @memcpy(z, path);\n    const rc = ", ShakeUse "std", ShakeLit ".os.linux.openat(-100, z.ptr, .{ .ACCMODE = .RDONLY }, 0);\n    if (@as(isize, @bitCast(rc)) < 0) @panic(\"cx_read_file_uni: cannot open\");\n    const fd: i32 = @intCast(rc);\n    defer _ = ", ShakeUse "std", ShakeLit ".os.linux.close(fd);\n    var raw: ", ShakeUse "std", ShakeLit ".ArrayListUnmanaged(u8) = .empty;\n    var chunk: [65536]u8 = undefined;\n    while (true) {\n        const n = ", ShakeUse "std", ShakeLit ".os.linux.read(fd, &chunk, chunk.len);\n        if (@as(isize, @bitCast(n)) < 0) @panic(\"cx_read_file_uni: read failed\");\n        if (n == 0) break;\n        raw.appendSlice(al, chunk[0..n]) catch @panic(\"oom\");\n    }\n    return ", ShakeUse "cx_utf8_to_cce", ShakeLit "(raw.items);\n}\n"]

  zig-p-cx-write-all : List ShakeFrag
  zig-p-cx-write-all = [ShakeLit "fn ", ShakeUse "cx_write_all", ShakeLit "(bytes: []const u8) void {\n    var off: usize = 0;\n    while (off < bytes.len) {\n        const n = ", ShakeUse "std", ShakeLit ".os.linux.write(1, bytes.ptr + off, bytes.len - off);\n        if (@as(isize, @bitCast(n)) <= 0) @panic(\"cx_write_all: write failed\");\n        off += n;\n    }\n}\n"]

  zig-p-cx-write-binary : List ShakeFrag
  zig-p-cx-write-binary = [ShakeLit "fn ", ShakeUse "cx_write_binary", ShakeLit "(vs: anytype) void {\n    const al = ", ShakeUse "cx_gpa", ShakeLit ";\n    var out: ", ShakeUse "std", ShakeLit ".ArrayListUnmanaged(u8) = .empty;\n    for (vs.items.items) |v| out.append(al, @intCast(@mod(v, 256))) catch @panic(\"oom\");\n    ", ShakeUse "cx_write_all", ShakeLit "(out.items);\n}\n"]

