  zig-p-cx-text-dup : List ShakeFrag
  zig-p-cx-text-dup = [ShakeLit "// Traps rather than clamps, because bare metal traps: emit-substring-bounds\n// (Emit/X86_64Builtins.codex:666) emits three UD2s -- negative start,\n// negative length, and len past the end -- at a deliberate ruling, since a\n// clamp turns a program's bug into quietly wrong data and a safety guarantee\n// is never silently degraded. The unchecked version returned the whole of\n// the NEXT allocation verbatim. Note the third check subtracts rather than\n// adding: start + len can wrap, and the input that wraps it is the one an\n// attacker picks; s.len - cx_a cannot, because the guard above pins cx_a to\n// [0, s.len]. Finding 28.\n// Copies, because bare metal copies, and the difference is observable:\n// emit-substring-alloc bumps r10 -- the LIVE allocation register, which\n// inside a deck extent is the deck cursor -- so a substring taken between\n// __deck-enter and __deck-exit lands ON THE DECK and outlives a rewind of\n// the frontier. A slice of the argument cannot: it stays where the argument\n// was, and a value that looks decked and is not becomes a table full of\n// reclaimed bytes. Same reasoning for every piece of a split. Finding 29.\nfn ", ShakeUse "cx_text_dup", ShakeLit "(s: []const u8) []const u8 {\n    const cx_out = ", ShakeUse "cx_gpa", ShakeLit ".alloc(u8, s.len) catch @panic(\"oom\");\n    @memcpy(cx_out, s);\n    return cx_out;\n}\n"]

  zig-p-cx-substring : List ShakeFrag
  zig-p-cx-substring = [ShakeLit "fn ", ShakeUse "cx_substring", ShakeLit "(s: []const u8, start: i64, len: i64) []const u8 {\n    if (start < 0 or len < 0) @panic(\"cx substring: negative start or length\");\n    const cx_a: usize = @intCast(start);\n    if (cx_a > s.len or len > @as(i64, @intCast(s.len - cx_a))) @panic(\"cx substring: out of range\");\n    return ", ShakeUse "cx_text_dup", ShakeLit "(s[cx_a .. cx_a + @as(usize, @intCast(len))]);\n}\n"]

  zig-p-cx-ipow : List ShakeFrag
  zig-p-cx-ipow = [ShakeLit "fn ", ShakeUse "cx_ipow", ShakeLit "(a: i64, b: i64) i64 {\n    if (b < 0) return 0;\n    var cx_acc: i64 = 1;\n    var cx_base = a;\n    var cx_e = b;\n    while (cx_e > 0) {\n        if ((cx_e & 1) == 1) cx_acc = cx_acc *% cx_base;\n        cx_base = cx_base *% cx_base;\n        cx_e = cx_e >> 1;\n    }\n    return cx_acc;\n}\n"]

  zig-p-cx-shl : List ShakeFrag
  zig-p-cx-shl = [ShakeLit "fn ", ShakeUse "cx_shl", ShakeLit "(a: i64, b: i64) i64 {\n    return a << @as(u6, @intCast(b & 63));\n}\n"]

  zig-p-cx-shr : List ShakeFrag
  zig-p-cx-shr = [ShakeLit "fn ", ShakeUse "cx_shr", ShakeLit "(a: i64, b: i64) i64 {\n    return a >> @as(u6, @intCast(b & 63));\n}\n"]

  zig-p-cx-heap-reserve : List ShakeFrag
  zig-p-cx-heap-reserve = [ShakeLit "// ONE heap, bare metal's own model: records, lists, text, closures,\n// buffers and the emit workspace all come from a single bump frontier\n// (cx_hp), so __heap-restore reclaims everything allocated since the\n// matching __heap-save. On bare metal __alloc bumps the same pointer\n// the save/restore pair moves, and emit-all-defs brackets EVERY\n// definition in one -- emission costs the max over definitions there\n// and must not cost the sum here. The region is reserved once and\n// never moved: a reallocating region would dangle every pointer\n// handed out before the growth. page_allocator memory is lazily\n// faulted zero pages, so resident stays proportional to what is\n// touched, the zero-fill the guest does at boot comes free, and the\n// byte at index i IS address i. The reservation is finite on purpose:\n// the depot peeks absolute addresses (smp-* boards poll ~2.1 GB), and\n// an address outside the region must refuse with the address in the\n// message, not zero-fill its way up to it. The bump pointer boots at\n// bare metal's own heap base (boot does mov r10, 6291456): the\n// absolute value is observable -- the depot's arith-narrow-proven\n// asserts __heap-save > 0 as a structural fact. Addresses below the\n// base belong to the deck, which swaps cx_hp in and out below.\n// 4 GiB: bare metal's guest is 3 GB and compiles its largest subjects\n// inside it, and the hosted harnesses reserve 512 MB of that as deck;\n// finding 24 measured the fibx subject at 381 MB deck + ~1.2 GB main,\n// which the old 1.5 GiB could not hold. Reserving costs nothing resident\n// (lazily faulted, below); what bounds a runaway is the venue's cgroup\n// MemoryMax (the ladder's bounded_run), not this constant.\nconst ", ShakeUse "cx_heap_reserve", ShakeLit ": usize = 4096 * 1024 * 1024;\n"]

  zig-p-cx-heap-mem : List ShakeFrag
  zig-p-cx-heap-mem = [ShakeLit "var ", ShakeUse "cx_heap_mem", ShakeLit ": []u8 = &.{};\n"]

  zig-p-cx-hp : List ShakeFrag
  zig-p-cx-hp = [ShakeLit "var ", ShakeUse "cx_hp", ShakeLit ": i64 = 6291456;\n"]

  zig-p-cx-heap-base : List ShakeFrag
  zig-p-cx-heap-base = [ShakeLit "// rawAlloc, NOT Allocator.alloc. The wrapper memsets every allocation to\n// `undefined`, which in a Debug build is 0xAA -- so the whole reserved\n// region arrived filled with 170s instead of zeros, and the memset\n// touched the whole region, committing a reservation that is supposed to\n// stay resident in proportion to what is used. Bare metal reserves a\n// span the guest zero-filled at boot, so a fresh buffer reads as zero\n// there; measured 2026-08-21 with findings/probe-fresh-span.codex,\n// ours read 170 in every byte. rawAlloc hands back the pages the OS\n// gives, which are zero and faulted lazily.\nfn ", ShakeUse "cx_heap_base", ShakeLit "() [*]u8 {\n    if (", ShakeUse "cx_heap_mem", ShakeLit ".len == 0) {\n        const cx_pa = ", ShakeUse "std", ShakeLit ".heap.page_allocator;\n        const cx_p = cx_pa.rawAlloc(", ShakeUse "cx_heap_reserve", ShakeLit ", .fromByteUnits(4096), @returnAddress()) orelse @panic(\"cx heap: cannot reserve the region\");\n        ", ShakeUse "cx_heap_mem", ShakeLit " = cx_p[0..", ShakeUse "cx_heap_reserve", ShakeLit "];\n    }\n    return ", ShakeUse "cx_heap_mem", ShakeLit ".ptr;\n}\n"]

  zig-p-cx-buf-want : List ShakeFrag
  zig-p-cx-buf-want = [ShakeLit "fn ", ShakeUse "cx_buf_want", ShakeLit "(n: i64) void {\n    if (n < 0 or @as(usize, @intCast(n)) > ", ShakeUse "cx_heap_reserve", ShakeLit ") ", ShakeUse "std", ShakeLit ".debug.panic(\"cx heap: address {d} outside the {d}-byte region\", .{ n, ", ShakeUse "cx_heap_reserve", ShakeLit " });\n    _ = ", ShakeUse "cx_heap_base", ShakeLit "();\n}\n"]

  zig-p-cx-frontier-crosses : List ShakeFrag
  zig-p-cx-frontier-crosses = [ShakeLit "// The deck is a FINITE reservation and nothing else enforces it. The\n// program places it with __deck-set and then lifts the main frontier\n// clear of it with __heap-advance (emit-build reserves\n// defs*65536 + 25165824), so the parked main frontier sits exactly at\n// the deck's top: inside an extent, a deck allocation that reaches\n// cx_bivy has overrun its region and is about to write over main's live\n// objects. Outside an extent the deck's live bytes are\n// [cx_deck_base, cx_dptr), and main may not OVERLAP that span anywhere,\n// not merely cross its top: __heap-restore can park the frontier beneath\n// the deck, and a frontier climbing back from below tramples live deck\n// objects long before it straddles cx_dptr -- that is the path the\n// 2026-08-21 crash took, build_debug_map landing on the decked\n// CodegenState. In the standard emit-build shape main lives above the\n// deck, so base < cx_dptr never holds and the overlap test is silent.\n// Checking only the region ceiling lets the two cursors walk through\n// each other in silence -- measured 2026-08-21, fibx's deck ran 8613088\n// bytes past a 25362432-byte reservation and the wreckage surfaced as a\n// segfault in a hash function thousands of allocations later. Upstream knows this\n// failure shape: BuildSettings records that starving the floor crashes\n// on a garbage pointer instead of raising CDX9002, because deck-short-of\n// reads __deck-pos, which is frozen inside a phase-wide extent. resize\n// declines rather than panics, funnelling the crossing into the alloc\n// path so there is one refusal site.\nfn ", ShakeUse "cx_frontier_crosses", ShakeLit "(base: usize, len: usize) bool {\n    if (", ShakeUse "cx_nest", ShakeLit " > 0) {\n        if (", ShakeUse "cx_bivy", ShakeLit " <= 0) return false;\n        const o: usize = @intCast(", ShakeUse "cx_bivy", ShakeLit ");\n        return base < o and base + len > o;\n    }\n    if (", ShakeUse "cx_dptr", ShakeLit " <= 0) return false;\n    const top: usize = @intCast(", ShakeUse "cx_dptr", ShakeLit ");\n    const bot: usize = @intCast(", ShakeUse "cx_deck_base", ShakeLit ");\n    return base < top and base + len > bot;\n}\n"]

  zig-p-cx-bump-alloc : List ShakeFrag
  zig-p-cx-bump-alloc = [ShakeLit "fn ", ShakeUse "cx_bump_alloc", ShakeLit "(_: *anyopaque, len: usize, alignment: ", ShakeUse "std", ShakeLit ".mem.Alignment, _: usize) ?[*]u8 {\n    const base = alignment.forward(@intCast(", ShakeUse "cx_hp", ShakeLit "));\n    if (base + len > ", ShakeUse "cx_heap_reserve", ShakeLit ") ", ShakeUse "std", ShakeLit ".debug.panic(\"cx heap: exhausted at {d} + {d} of {d}\", .{ base, len, ", ShakeUse "cx_heap_reserve", ShakeLit " });\n    if (", ShakeUse "cx_frontier_crosses", ShakeLit "(base, len)) ", ShakeUse "std", ShakeLit ".debug.panic(\"cx heap: the two cursors met -- alloc at {d} + {d} crosses (hp={d} dptr={d} deck_base={d} bivy={d} nest={d})\", .{ base, len, ", ShakeUse "cx_hp", ShakeLit ", ", ShakeUse "cx_dptr", ShakeLit ", ", ShakeUse "cx_deck_base", ShakeLit ", ", ShakeUse "cx_bivy", ShakeLit ", ", ShakeUse "cx_nest", ShakeLit " });\n    ", ShakeUse "cx_hp", ShakeLit " = @intCast(base + len);\n    ", ShakeUse "cx_deck_armed", ShakeLit " = false;\n    if (", ShakeUse "cx_nest", ShakeLit " > 0 and ", ShakeUse "cx_hp", ShakeLit " > ", ShakeUse "cx_deck_hw", ShakeLit ") {\n        ", ShakeUse "cx_deck_hw", ShakeLit " = ", ShakeUse "cx_hp", ShakeLit ";\n        if (", ShakeUse "cx_deck_hw", ShakeLit " - ", ShakeUse "cx_deck_base", ShakeLit " > ", ShakeUse "cx_deck_best", ShakeLit ") ", ShakeUse "cx_deck_best", ShakeLit " = ", ShakeUse "cx_deck_hw", ShakeLit " - ", ShakeUse "cx_deck_base", ShakeLit ";\n        ", ShakeUse "cx_deck_report", ShakeLit "();\n    }\n    return ", ShakeUse "cx_heap_base", ShakeLit "() + base;\n}\n"]

  zig-p-cx-bump-resize : List ShakeFrag
  zig-p-cx-bump-resize = [ShakeLit "// In-place growth when the block is the topmost allocation is bare\n// metal's __list_snoc path 2 -- extend the frontier block, reallocate\n// only otherwise. The mirror, not an optimisation: a plug whose list\n// growth reallocates where bare metal extends allocates a different\n// amount for the same program. free rewinds only the topmost block,\n// the same rule from the other side.\nfn ", ShakeUse "cx_bump_resize", ShakeLit "(_: *anyopaque, memory: []u8, _: ", ShakeUse "std", ShakeLit ".mem.Alignment, new_len: usize, _: usize) bool {\n    const off = @intFromPtr(memory.ptr) - @intFromPtr(", ShakeUse "cx_heap_base", ShakeLit "());\n    if (off + memory.len == @as(usize, @intCast(", ShakeUse "cx_hp", ShakeLit "))) {\n        if (off + new_len > ", ShakeUse "cx_heap_reserve", ShakeLit ") return false;\n        if (", ShakeUse "cx_frontier_crosses", ShakeLit "(off, new_len)) return false;\n        ", ShakeUse "cx_hp", ShakeLit " = @intCast(off + new_len);\n        return true;\n    }\n    return new_len <= memory.len;\n}\n"]

  zig-p-cx-bump-remap : List ShakeFrag
  zig-p-cx-bump-remap = [ShakeLit "fn ", ShakeUse "cx_bump_remap", ShakeLit "(ctx: *anyopaque, memory: []u8, alignment: ", ShakeUse "std", ShakeLit ".mem.Alignment, new_len: usize, ra: usize) ?[*]u8 {\n    return if (", ShakeUse "cx_bump_resize", ShakeLit "(ctx, memory, alignment, new_len, ra)) memory.ptr else null;\n}\n"]

  zig-p-cx-bump-free : List ShakeFrag
  zig-p-cx-bump-free = [ShakeLit "fn ", ShakeUse "cx_bump_free", ShakeLit "(_: *anyopaque, memory: []u8, _: ", ShakeUse "std", ShakeLit ".mem.Alignment, _: usize) void {\n    const off = @intFromPtr(memory.ptr) - @intFromPtr(", ShakeUse "cx_heap_base", ShakeLit "());\n    if (off + memory.len == @as(usize, @intCast(", ShakeUse "cx_hp", ShakeLit "))) ", ShakeUse "cx_hp", ShakeLit " = @intCast(off);\n}\n"]

  zig-p-cx-heap-vtable : List ShakeFrag
  zig-p-cx-heap-vtable = [ShakeLit "const ", ShakeUse "cx_heap_vtable", ShakeLit " = ", ShakeUse "std", ShakeLit ".mem.Allocator.VTable{ .alloc = ", ShakeUse "cx_bump_alloc", ShakeLit ", .resize = ", ShakeUse "cx_bump_resize", ShakeLit ", .remap = ", ShakeUse "cx_bump_remap", ShakeLit ", .free = ", ShakeUse "cx_bump_free", ShakeLit " };\n"]

  zig-p-cx-gpa : List ShakeFrag
  zig-p-cx-gpa = [ShakeLit "const ", ShakeUse "cx_gpa", ShakeLit " = ", ShakeUse "std", ShakeLit ".mem.Allocator{ .ptr = undefined, .vtable = &", ShakeUse "cx_heap_vtable", ShakeLit " };\n"]

  zig-p-cx-heap-save : List ShakeFrag
  zig-p-cx-heap-save = [ShakeLit "fn ", ShakeUse "cx_heap_save", ShakeLit "() i64 {\n    return ", ShakeUse "cx_hp", ShakeLit ";\n}\n"]

  zig-p-cx-heap-advance : List ShakeFrag
  zig-p-cx-heap-advance = [ShakeLit "fn ", ShakeUse "cx_heap_advance", ShakeLit "(n: i64) i64 {\n    if (", ShakeUse "cx_deck_armed", ShakeLit ") {\n        ", ShakeUse "cx_deck_armed", ShakeLit " = false;\n        ", ShakeUse "cx_deck_top", ShakeLit " = ", ShakeUse "cx_hp", ShakeLit " + n;\n        ", ShakeUse "cx_hp", ShakeLit " += ", ShakeUse "cx_deck_slack", ShakeLit ";\n    }\n    ", ShakeUse "cx_hp", ShakeLit " += n;\n    return 0;\n}\n"]

  zig-p-cx-heap-restore : List ShakeFrag
  zig-p-cx-heap-restore = [ShakeLit "fn ", ShakeUse "cx_heap_restore", ShakeLit "(h: i64) i64 {\n    ", ShakeUse "cx_hp", ShakeLit " = h;\n    return 0;\n}\n"]

  zig-p-cx-peek-qword : List ShakeFrag
  zig-p-cx-peek-qword = [ShakeLit "// Wrapping, because bare metal does a single 64-bit load and every\n// bit pattern is a legal i64. Rebuilding the value with checked * and +\n// traps on any qword whose top byte sets the high bit -- that is, on\n// every NEGATIVE qword. Measured 2026-08-21 with\n// findings/probe-peek-qword.codex: bytes 00 00 00 00 00 00 00 FF answer\n// -72057594037927936 on bare metal and panic here.\nfn ", ShakeUse "cx_peek_qword", ShakeLit "(b: i64, off: i64) i64 {\n    ", ShakeUse "cx_buf_want", ShakeLit "(b + off + 8);\n    var cx_v: i64 = 0;\n    var cx_j: i64 = 7;\n    while (cx_j >= 0) : (cx_j -= 1) cx_v = cx_v *% 256 +% ", ShakeUse "cx_heap_mem", ShakeLit "[@as(usize, @intCast(b + off + cx_j))];\n    return cx_v;\n}\n"]

  zig-p-cx-address-of : List ShakeFrag
  zig-p-cx-address-of = [ShakeLit "// Bare metal's address-of is emit-identity-builtin: it returns the VALUE,\n// and since records, lists and texts are pointers there, the value IS the\n// address. Answering a constant 0 made every object identical to every other\n// one AND to null, and the compiler reads that as an answer: mode-ordinal and\n// real-width-ordinal short-circuit on `address-of m == 0`, so they returned 0\n// for every input, and copy-sx-text decides durability with `address-of t < b`,\n// so it always shared and never rematerialised -- into a region about to be\n// reclaimed. Finding 31.\n//\n// The 0 was justified by X86_64Compound's note that address-of \"silently\n// answers 0 on any target where it cannot be modelled: that cost the C# arm\n// every tag in this table\". That note describes the hazard as a cost, not a\n// licence, and this is not such a target -- one flat region and pointers into\n// it is exactly the shape bare metal has.\n//\n// HEAP-RELATIVE, not a host pointer: the answers are compared against\n// __heap-save values, which are offsets from cx_heap_base. A raw @intFromPtr\n// would order correctly among itself and be nonsense against those.\nfn ", ShakeUse "cx_address_of", ShakeLit "(v: anytype) i64 {\n    switch (@typeInfo(@TypeOf(v))) {\n        .int, .comptime_int => return @intCast(v),\n        .bool => return @intFromBool(v),\n        .pointer => |cx_pi| {\n            const cx_p = if (cx_pi.size == .slice) @intFromPtr(v.ptr) else @intFromPtr(v);\n            const cx_base = @intFromPtr(", ShakeUse "cx_heap_base", ShakeLit "());\n            return if (cx_p >= cx_base) @intCast(cx_p - cx_base) else 0;\n        },\n        else => @compileError(\"zig plug: no address-of for this type\"),\n    }\n}\n"]

  zig-p-cx-dptr : List ShakeFrag
  zig-p-cx-dptr = [ShakeLit "// The deck is the C# plug's rule (_Buf.deck_enter/deck_exit): the\n// outermost enter parks the bump pointer in the bivy and swaps the deck\n// pointer in; the outermost exit swaps back. Deck position is observable\n// (the depot's deck-*-contract subjects print it), so a no-op deck is a\n// wrong answer, not a simplification.\nvar ", ShakeUse "cx_dptr", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-bivy : List ShakeFrag
  zig-p-cx-bivy = [ShakeLit "var ", ShakeUse "cx_bivy", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-nest : List ShakeFrag
  zig-p-cx-nest = [ShakeLit "var ", ShakeUse "cx_nest", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-base : List ShakeFrag
  zig-p-cx-deck-base = [ShakeLit "// The deck high-water mark. `emit-build` reserves defs*65536+25165824 for\n// the deck and lifts the main frontier to exactly its top, so while an extent\n// is open the PARKED frontier (cx_bivy) IS the reservation ceiling and cx_hp is\n// the live deck cursor. Peak minus base is what the deck cost; ceiling minus\n// peak is what was left. Nothing else can report this -- the deck-pos cell is\n// frozen inside an extent, which is why upstream's own deck-short-of guard\n// cannot fire where exhaustion actually happens.\nvar ", ShakeUse "cx_deck_base", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-hw : List ShakeFrag
  zig-p-cx-deck-hw = [ShakeLit "var ", ShakeUse "cx_deck_hw", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-top : List ShakeFrag
  zig-p-cx-deck-top = [ShakeLit "var ", ShakeUse "cx_deck_top", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-best : List ShakeFrag
  zig-p-cx-deck-best = [ShakeLit "var ", ShakeUse "cx_deck_best", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-stride : List ShakeFrag
  zig-p-cx-deck-stride = [ShakeLit "var ", ShakeUse "cx_deck_stride", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-armed : List ShakeFrag
  zig-p-cx-deck-armed = [ShakeLit "var ", ShakeUse "cx_deck_armed", ShakeLit ": bool = false;\n"]

  zig-p-cx-deck-slack : List ShakeFrag
  zig-p-cx-deck-slack = [ShakeLit "// Measurement-only headroom, added to the lift that follows __deck-set so\n// the deck can run PAST its reservation without meeting the main frontier.\n// Zero in every normal build, and it must stay zero in anything banked: it\n// changes __deck-pos, which the depot can observe. The point of it is that the\n// guard fires at the FIRST crossing, and a first crossing tells you only that\n// demand exceeded the reservation -- the deficit it reports is bounded by one\n// allocation and is therefore always about zero. Slack lets the program finish\n// so the TRUE peak is knowable.\nconst ", ShakeUse "cx_deck_slack", ShakeLit ": i64 = 0;\n"]

  zig-p-cx-deck-report : List ShakeFrag
  zig-p-cx-deck-report = [ShakeLit "// STDOUT, never stderr. stderr carries the program's output and every\n// comparison in the ladder diffs it, so a measurement written there would\n// corrupt the thing being measured. Raw write syscall rather than\n// std.Io.File, which in 0.16 wants an Io instance. Only on a new peak, so the\n// lines are few and the last one is the answer.\nfn ", ShakeUse "cx_deck_report", ShakeLit "() void {\n    if (@import(\"builtin\").os.tag != .linux) return;\n    if (", ShakeUse "cx_deck_base", ShakeLit " == 0 or ", ShakeUse "cx_deck_top", ShakeLit " == 0) return;\n    const cx_used = ", ShakeUse "cx_deck_hw", ShakeLit " - ", ShakeUse "cx_deck_base", ShakeLit ";\n    if (cx_used - ", ShakeUse "cx_deck_stride", ShakeLit " < 1048576) return;\n    ", ShakeUse "cx_deck_stride", ShakeLit " = cx_used;\n    var cx_b: [224]u8 = undefined;\n    const cx_s = ", ShakeUse "std", ShakeLit ".fmt.bufPrint(&cx_b, \"CX-DECK used={d} reserved={d} headroom={d} base={d} peak={d} best={d}\\n\", .{ cx_used, ", ShakeUse "cx_deck_top", ShakeLit " - ", ShakeUse "cx_deck_base", ShakeLit ", ", ShakeUse "cx_deck_top", ShakeLit " - ", ShakeUse "cx_deck_hw", ShakeLit ", ", ShakeUse "cx_deck_base", ShakeLit ", ", ShakeUse "cx_deck_hw", ShakeLit ", ", ShakeUse "cx_deck_best", ShakeLit " }) catch return;\n    _ = ", ShakeUse "std", ShakeLit ".os.linux.write(1, cx_s.ptr, cx_s.len);\n}\n"]

  zig-p-cx-deck-enter : List ShakeFrag
  zig-p-cx-deck-enter = [ShakeLit "fn ", ShakeUse "cx_deck_enter", ShakeLit "() i64 {\n    if (", ShakeUse "cx_nest", ShakeLit " == 0) {\n        ", ShakeUse "cx_bivy", ShakeLit " = ", ShakeUse "cx_hp", ShakeLit ";\n        ", ShakeUse "cx_hp", ShakeLit " = ", ShakeUse "cx_dptr", ShakeLit ";\n    }\n    ", ShakeUse "cx_nest", ShakeLit " += 1;\n    return 0;\n}\n"]

  zig-p-cx-deck-exit : List ShakeFrag
  zig-p-cx-deck-exit = [ShakeLit "fn ", ShakeUse "cx_deck_exit", ShakeLit "() i64 {\n    ", ShakeUse "cx_nest", ShakeLit " -= 1;\n    if (", ShakeUse "cx_nest", ShakeLit " == 0) {\n        ", ShakeUse "cx_dptr", ShakeLit " = ", ShakeUse "cx_hp", ShakeLit ";\n        ", ShakeUse "cx_hp", ShakeLit " = ", ShakeUse "cx_bivy", ShakeLit ";\n        ", ShakeUse "cx_deck_report", ShakeLit "();\n    }\n    return 0;\n}\n"]

