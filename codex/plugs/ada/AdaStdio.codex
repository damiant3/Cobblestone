Chapter: AdaStdio

Section: Body

  ada-stream-defs : IRChapter, List ArityEntry, Integer, Integer, Integer -> [Console] Nothing
  ada-stream-defs (m) (arities) (entry-idx) (i) (len) =
   if i >= len then print-uni ""
   else let h = __heap-save
   in let s = emit-ada-chapter-stream-def m arities entry-idx i
   in act
    print-uni s
    let r = __heap-restore h
    in ada-stream-defs m arities entry-idx (i + 1) len
   end

  plug-emit-ir-stream : Text -> [Console] Nothing
  plug-emit-ir-stream (ir-text) =
   let parsed = parse-ir-chapter ir-text
   in let m = parsed.chapter
   in let arities = build-arity-map (m.defs) 0 []
   in let entry-idx = ada-find-entry (m.defs) 0
   in act
    print-uni (emit-ada-chapter-stream-head m (parsed.type-defs))
    ada-stream-defs m arities entry-idx 0 (list-length (m.defs))
    print-line-uni (emit-ada-chapter-stream-tail m (parsed.type-defs))
   end
