 Entry point for the Ada emit-plug.

Section: Body

  opening : [Console, FileSystem] Nothing = act
   source <- read-file ""
   let parsed = parse-ir-chapter source
   in let ada-text = emit-ada-chapter (parsed.chapter) (parsed.type-defs)
   in print-line ada-text
  end

