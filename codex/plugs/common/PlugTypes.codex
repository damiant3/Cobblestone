Chapter: Plug Types

Section: Emitter Helpers
  ApplyChain = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> ApplyChain
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> ApplyChain {
     root = e,
     args = acc
    }

  strip-fun-args : CodexType -> CodexType
  strip-fun-args (ty) =
   when ty
    is FunTy (p) (fnrow) (r) -> strip-fun-args r
    is ForAllTy (id) (body) -> strip-fun-args body
    is otherwise -> ty

Section: Plug Utilities

  deck-record : a -> a
  deck-record (x) = x

