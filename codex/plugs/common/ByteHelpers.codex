Chapter: Byte Helpers

Section: Primitives

  floor-div : Integer, Integer -> Integer
  floor-div (n) (d) =
   let q = n / d
   in let r = n - q * d
   in if r /= 0 & (r < 0) /= (d < 0) then q - 1 else q

  to-byte : Integer -> Integer
  to-byte (n) =
   int-mod n 256

Section: Writers

  write-bytes : Integer, Integer -> List Integer
  write-bytes (v) (n) =
   if n == 0 then []
   else [to-byte v] & write-bytes (floor-div v 256) (n - 1)

  write-i8 : Integer -> List Integer
  write-i8 (v) =
   [to-byte v]

  write-i16 : Integer -> List Integer
  write-i16 (v) =
   write-bytes v 2

  write-i32 : Integer -> List Integer
  write-i32 (v) =
   write-bytes v 4

  write-i64 : Integer -> List Integer
  write-i64 (v) =
   write-bytes v 8

Section: Readers

  read-i32-le : List Integer, Integer -> Integer
  read-i32-le (bs) (off) =
   list-at bs off
   + list-at bs (off + 1) * 256
   + list-at bs (off + 2) * 65536
   + list-at bs (off + 3) * 16777216

  read-i16-le : List Integer, Integer -> Integer
  read-i16-le (bs) (off) =
   list-at bs off
   + list-at bs (off + 1) * 256

Section: Padding

  pad-zeros : Integer -> List Integer
  pad-zeros (n) =
   pad-zeros-acc n []

  pad-zeros-acc : Integer, List Integer -> List Integer
  pad-zeros-acc (n) (acc) =
   if n <= 0 then acc
   else pad-zeros-acc (n - 1) (list-push acc 0)

Section: Alignment

  align-up : Integer, Integer -> Integer
  align-up (v) (a) =
   let r = int-mod v a
   in if r == 0 then v else v + a - r
