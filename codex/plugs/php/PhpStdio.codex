Chapter: PhpStdio

Section: Body

  php-stream-defs : List IRDef, Integer, Integer, List ArityEntry -> [Console] Nothing
  php-stream-defs (defs) (i) (len) (arities) =
   if i >= len then print-uni ""
   else let h = __heap-save
   in let s = emit-php-def (list-at defs i) arities
   in act
    print-uni s
    let r = __heap-restore h
    in php-stream-defs defs (i + 1) len arities
   end

  plug-emit-ir-stream : Text -> [Console] Nothing
  plug-emit-ir-stream (ir-text) =
   let parsed = parse-ir-chapter ir-text
   in let m = parsed.chapter
   in let arities = build-arity-map (m.defs) 0 []
   in act
    print-uni ("<?php\n\n" & php-text-builtins)
    print-uni (emit-php-type-defs (parsed.type-defs) 0)
    php-stream-defs (m.defs) 0 (list-length (m.defs)) arities
    print-line-uni (php-sanitize opening-entry-point & "();\n")
   end
