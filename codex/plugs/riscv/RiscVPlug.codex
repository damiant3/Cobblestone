 Plug entry. Connects to host TCP server on port 9100,
 receives IR text, runs the RISC-V code generator, sends
 machine code + metadata back in the wire format for
 chaining to ELF plugs.

Section: Network Config

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Helpers

  bytes-to-text-chunk : List Integer, Integer, Integer, List Text -> List Text
  bytes-to-text-chunk (bs) (i) (stop) (acc) =
   if i >= stop then acc
   else bytes-to-text-chunk bs (i + 1) stop (list-push acc (char-to-text (code-to-char (list-at bs i))))

  bytes-to-text-chunks : List Integer, Integer, Integer, List Text -> List Text
  bytes-to-text-chunks (bs) (off) (total) (acc) =
   if off >= total then acc
   else let stop = if off + 256 > total then total else off + 256
   in let chunk = text-concat-list (bytes-to-text-chunk bs off stop [])
   in bytes-to-text-chunks bs stop total (list-push acc chunk)

  bytes-to-text : List Integer, Integer, Integer -> Text
  bytes-to-text (bs) (off) (total) =
   text-concat-list (bytes-to-text-chunks bs off total [])

Section: Streaming Send

  spin-wait : Integer, Integer -> Integer
  spin-wait (i) (n) =
   if i >= n then 0
   else spin-wait (i + 1) n

  send-bytes-loop : TcpTransportState, List Integer, Integer, Integer -> TcpTransportState
  send-bytes-loop (ts) (bs) (off) (len) =
   if off >= len then ts
   else let stop = if off + 1400 > len then len else off + 1400
   in let chunk = slice-bytes bs off stop
   in let r = net-send (ts.session) chunk
   in let ts1 = TcpTransportState { session = r.session, recv-buf = ts.recv-buf, messages-sent = ts.messages-sent, messages-received = ts.messages-received }
   in let ts2 = flush-transport-outbox ts1
   in let w = spin-wait 0 10000000
   in send-bytes-loop ts2 bs stop len

  send-bytes : TcpTransportState, List Integer -> TcpTransportState
  send-bytes (ts) (bs) = send-bytes-loop ts bs 0 (list-length bs)

  slice-bytes : List Integer, Integer, Integer -> List Integer
  slice-bytes (bs) (start) (stop) =
   slice-bytes-loop bs start stop []

  slice-bytes-loop : List Integer, Integer, Integer, List Integer -> List Integer
  slice-bytes-loop (bs) (i) (stop) (acc) =
   if i >= stop then acc
   else slice-bytes-loop bs (i + 1) stop (list-push acc (list-at bs i))

Section: Drain

  drain-wait : TcpTransportState, Integer -> Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else let frame = ne2k-recv-frame
   in if list-length frame == 0 then drain-wait ts (tries + 1)
   else 0

Section: Body

  opening : [Console, FileSystem] Nothing = act
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9100 host-ip 1000
   in let ts = transport-new sess
   in let ts1 = net-io-connect ts
   in let recv = net-io-recv-loop ts1 0
   in if recv.has-message then
    let ir-text = bytes-to-text (recv.body) 0 (list-length (recv.body))
    in let tokens = tokenize ir-text
    in let tree = build-tree tokens
    in let xs = sexp-list tree
    in let type-defs = parse-atype-defs (walk-named-list xs "type-defs")
    in let parsed = walk-chapter tree
    in let chapter = parsed.chapter
    in let cg-state = rv-emit-module empty-rv-state chapter type-defs
    in let wire = rv-build-wire-output cg-state
    in let ts5 = send-bytes (recv.transport) wire
    in let ts6 = net-io-close ts5
    in let drained = drain-wait ts6 0
    in act print-line-uni ("OK riscv code=" & show (list-length (cg-state.code)) & " funcs=" & show (list-length (cg-state.func-names)) & " data=" & show (list-length (cg-state.data)) & " wire=" & show (list-length wire + drained - drained)) end
   else act print-line-uni "FAIL" end
  end

