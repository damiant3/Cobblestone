  write-i32-le : Integer -> List Integer
  write-i32-le (v) = [bit-and v 255, bit-and (bit-shru v 8) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 24) 255]

  write-i16-le : Integer -> List Integer
  write-i16-le (v) = [bit-and v 255, bit-and (bit-shru v 8) 255]

  text-to-ascii-bytes : Text -> List Integer
  text-to-ascii-bytes (s) = text-to-ascii-loop s 0 (text-length s) []

  text-to-ascii-loop : Text, Integer, Integer, List Integer -> List Integer
  text-to-ascii-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else text-to-ascii-loop s (i + 1) len (list-push acc (bit-and (char-code (char-at s i)) 255))

Section: WCET Output

  rv-print-wcet-reports : List Text, Integer -> [Console] Nothing
  rv-print-wcet-reports (reports) (i) = act
   if i >= list-length reports then print-line-uni ""
   else let line = list-at reports i
   in act
    print-line-uni line
    rv-print-wcet-reports reports (i + 1)
   end
  end

Section: Body

  dispatch : Text -> [Console, FileSystem] Nothing
  dispatch (mode) = act
    source <- read-file mode
    let parsed = parse-ir-chapter source
    in let cg-state = rv-emit-module empty-rv-state (parsed.chapter) (parsed.type-defs) (parsed.effect-op-names)
    in let written = rv-send-wire-output cg-state
    in let reports = cg-state.wcet-reports
    in if list-length reports > 0 then rv-print-wcet-reports reports 0
    else print-line-uni ""
  end

