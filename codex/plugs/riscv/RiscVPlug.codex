Chapter: RiscVPlug
  cites Foreword chapter Maybe

 Plug entry. Reads IR text from serial input (file-mapped by
 codex-vm), runs the RISC-V code generator, writes binary wire
 output to serial as raw bytes via UART port.

Section: Raw Output

  serial-data-port : Integer = 1016

  serial-write-byte : Integer -> Integer
  serial-write-byte (b) = port-out-byte serial-data-port b

  serial-write-loop : List Integer, Integer, Integer -> Integer
  serial-write-loop (bs) (i) (len) =
   if i >= len then len
   else let w = serial-write-byte (list-at bs i)
   in serial-write-loop bs (i + 1) len

  serial-write-bytes : List Integer -> Integer
  serial-write-bytes (bs) = serial-write-loop bs 0 (list-length bs)

  wire-buf-addr : Integer = #500000

  serial-write-buf-loop : Integer, Integer, Integer -> Integer
  serial-write-buf-loop (buf) (i) (len) =
   if i >= len then len
   else let b = peek-byte buf i
   in let w = serial-write-byte b
   in serial-write-buf-loop buf (i + 1) len

  rv-wire-length : RvState -> Integer
  rv-wire-length (st) =
   12 + st.code-pos + list-length (st.data) + rv-func-table-len (st.func-names) (st.func-offsets) 0 0

  rv-func-table-len : List Text, List Integer, Integer, Integer -> Integer
  rv-func-table-len (names) (offsets) (i) (acc) =
   if i >= list-length names then acc
   else rv-func-table-len names offsets (i + 1) (acc + 2 + text-length (list-at names i) + 4)

  rv-send-wire-output : RvState -> Integer
  rv-send-wire-output (st) =
   let code = __buf-read-bytes (st.code-buf) 0 (st.code-pos)
   in let data = st.data
   in let code-len = st.code-pos
   in let data-len = list-length data
   in let func-count = list-length (st.func-names)
   in let w1 = serial-write-bytes (write-i32-le code-len)
   in let w2 = serial-write-bytes (write-i32-le data-len)
   in let w3 = serial-write-bytes (write-i32-le func-count)
   in let w4 = serial-write-bytes code
   in let w5 = serial-write-bytes data
   in let w6 = serial-write-bytes (rv-build-func-table (st.func-names) (st.func-offsets) 0)
   in w1 + w2 + w3 + w4 + w5 + w6

Section: WCET Output

  rv-print-wcet-reports : List Text, Integer -> [Console] Nothing
  rv-print-wcet-reports (reports) (i) = act
   if i >= list-length reports then print-line-uni ""
   else let line = list-at reports i
   in act
    print-line-uni line
    rv-print-wcet-reports reports (i + 1)
   end
  end

Section: Function Name Manifest

 Emits the function table as Unicode text after the binary wire. The
 binary wire's own function table holds CCE-encoded names; print-line-uni
 converts CCE to Unicode at the I/O boundary, so this manifest gives the
 host tooling correct names without decoding CCE in PowerShell. The block
 is bounded by FUNCMAP-BEGIN/FUNCMAP-END and each row is the function's
 byte offset followed by its name. Wire parsers stop after the wire's own
 function table, so this trailing text is ignored by them.

  rv-print-func-manifest : RvState -> [Console] Nothing
  rv-print-func-manifest (st) = act
   print-line-uni "FUNCMAP-BEGIN"
   rv-print-func-rows (st.func-names) (st.func-offsets) 0
   print-line-uni "FUNCMAP-END"
  end

  rv-print-func-rows : List Text, List Integer, Integer -> [Console] Nothing
  rv-print-func-rows (names) (offsets) (i) = act
   if i >= list-length names then print-line-uni ""
   else let row = (show ((list-at offsets i) * 4)) & " " & (list-at names i)
   in act
    print-line-uni row
    rv-print-func-rows names offsets (i + 1)
   end
  end

Section: Body

  dispatch : Text -> [Console] Nothing
  dispatch (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in let cg-state = rv-emit-module empty-rv-state (parsed.chapter) (parsed.type-defs) (parsed.effect-op-names)
    in let written = rv-send-wire-output cg-state
    in act
     rv-print-func-manifest cg-state
     if list-length (cg-state.wcet-reports) > 0 then rv-print-wcet-reports (cg-state.wcet-reports) 0
     else print-line-uni ""
    end
  end

  dispatch-repl : Text -> [Console] Nothing
  dispatch-repl (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in let cg-state = rv-emit-module empty-rv-state (parsed.chapter) (parsed.type-defs) (parsed.effect-op-names)
    in let written = rv-send-wire-output cg-state
    in let reports = cg-state.wcet-reports
    in act
      rv-print-func-manifest cg-state
      if list-length reports > 0 then rv-print-wcet-reports reports 0
      else print-line-uni ""
      print-line-uni "WIRE-END"
      repl-loop
    end
  end

  repl-loop : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> if text-contains mode "repl" then dispatch-repl mode
        else dispatch mode
      is None -> print-line-uni "REPL-DONE"
  end

  opening : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> if text-contains mode "repl" then dispatch-repl mode
        else dispatch mode
      is None -> print-line-uni "no input"
  end

