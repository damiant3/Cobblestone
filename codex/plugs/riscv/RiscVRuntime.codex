   in let i = rv-rt-emit i (rv-sub rv-t0 rv-s2 rv-s3)
   in let i = rv-rt-emit i (rv-addi rv-t0 rv-t0 1)
   in let i = rv-rt-emit i (rv-mv rv-t1 rv-zero)
   in let outer = list-length i / 4
   in let outer-exit = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-mv rv-t2 rv-zero)
   in let inner = list-length i / 4
   in let inner-exit = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-add rv-t3 rv-t1 rv-t2)
   in let i = rv-rt-emit i (rv-add rv-t3 rv-s4 rv-t3)
