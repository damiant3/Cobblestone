   in let i = rv-rt-emit i (rv-slli rv-t0 rv-t0 31)
   in let i = rv-rt-emit i (rv-add addr-reg addr-reg rv-t0)
   in let done = list-length i / 4
   in rv-patch-insn-raw i skip-pos (rv-bne rv-t0 rv-zero ((done - skip-pos) * 4))

