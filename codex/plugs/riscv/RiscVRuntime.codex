   in let i = rv-rt-emit i (rv-addi rv-s1 rv-s1 16)
   in let i = rv-rt-emit i (rv-addi rv-t1 rv-zero 1)
   in let i = rv-rt-emit i (rv-sd rv-a0 rv-t1 0)
   in let i = rv-rt-emit i (rv-sb rv-a0 rv-t0 8)
   in rv-rt-emit i rv-ret

