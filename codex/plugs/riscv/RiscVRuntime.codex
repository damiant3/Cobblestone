   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in let i = rv-rt-emit i rv-ret
   in let i = rv-patch-insn-raw i too-short (rv-blt rv-t0 rv-t1 ((no-match-label - too-short) * 4))
   in let i = rv-patch-insn-raw i match-idx (rv-bge rv-t2 rv-t1 ((match-label - match-idx) * 4))
   in rv-patch-insn-raw i no-match (rv-bne rv-t5 rv-zero ((no-match-label - no-match) * 4))

Section: text-to-integer (a0=text -> integer, 0 if invalid)

  rv-rt-text-to-integer : List Integer
  rv-rt-text-to-integer =
