   in let i = rv-rt-emit i (rv-addi rv-t3 rv-t2 15)
   in let i = rv-rt-emit i (rv-srli rv-t3 rv-t3 3)
   in let i = rv-rt-emit i (rv-slli rv-t3 rv-t3 3)
