Section: Table Writer

  rv-write-table-loop : RvState, Integer, List Integer, Integer -> RvState
  rv-write-table-loop (st) (base-reg) (table) (i) =
   if i >= list-length table then st
   else let st1 = rv-emit-li st rv-t1 (list-at table i)
   in let st2 = rv-emit st1 (rv-sb base-reg rv-t1 i)
   in rv-write-table-loop st2 base-reg table (i + 1)

Section: Patching Helper

  rv-patch-insn-raw : List Integer, Integer, List Integer -> List Integer
  rv-patch-insn-raw (code) (insn-index) (new-bytes) =
   let byte-offset = insn-index * 4
   in rv-patch-raw-4 code byte-offset new-bytes 0 (list-length code) []

  rv-patch-raw-4 : List Integer, Integer, List Integer, Integer, Integer, List Integer -> List Integer
  rv-patch-raw-4 (code) (pos) (new-bytes) (i) (len) (acc) =
   if i >= len then acc
   else if i >= pos & i < pos + 4 then rv-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at new-bytes (i - pos)))
   else rv-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at code i))

