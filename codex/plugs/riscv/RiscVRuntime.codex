   in let i = rv-rt-emit i (rv-sub rv-t0 rv-s2 rv-s3)
   in let bne-len = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-a0 rv-a0 8)
   in let i = rv-rt-emit i (rv-addi rv-a1 rv-a1 8)
   in let i = rv-rt-emit i (rv-mv rv-s4 rv-a0)
   in let i = rv-rt-emit i (rv-mv rv-s5 rv-a1)
   in let i = rv-rt-emit i (rv-mv rv-t0 rv-zero)
   in let loop = list-length i / 4
   in let bge-done = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-add rv-t1 rv-s4 rv-t0)
   in let i = rv-rt-emit i (rv-lb rv-t1 rv-t1 0)
   in let i = rv-rt-emit i (rv-add rv-t2 rv-s5 rv-t0)
   in let i = rv-rt-emit i (rv-lb rv-t2 rv-t2 0)
   in let i = rv-rt-emit i (rv-sub rv-t3 rv-t1 rv-t2)
