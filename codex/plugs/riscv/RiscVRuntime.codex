Section: text-contains (a0=haystack, a1=needle -> 0 or 1)

  rv-rt-text-contains : List Integer
  rv-rt-text-contains =
   let i = []
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp (0 - 64))
   in let i = rv-rt-emit i (rv-sd rv-sp rv-ra 56)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s0 48)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s2 40)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s3 32)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s4 24)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s5 16)
   in let i = rv-rt-emit i (rv-mv rv-s0 rv-sp)
