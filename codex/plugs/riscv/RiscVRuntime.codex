Section: CCE to Unicode Lookup Table

  rv-cce-table-addr : Integer = #80080000
  rv-ascii-to-cce-table-addr : Integer = #80080100

  rv-build-ascii-to-cce : List Integer, Integer -> List Integer
  rv-build-ascii-to-cce (acc) (ascii) =
   if ascii >= 128 then acc
   else let cce = rv-find-cce-for-ascii ascii 0
   in rv-build-ascii-to-cce (list-push acc cce) (ascii + 1)

  rv-find-cce-for-ascii : Integer, Integer -> Integer
  rv-find-cce-for-ascii (ascii) (cce) =
   if cce >= list-length cce-to-unicode-table then 0
   else if list-at cce-to-unicode-table cce == ascii then cce
   else rv-find-cce-for-ascii ascii (cce + 1)

  rv-build-cce-table : List Integer, Integer -> List Integer
