   in let too-short = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-a0 rv-a0 8)
   in let i = rv-rt-emit i (rv-addi rv-a1 rv-a1 8)
   in let i = rv-rt-emit i (rv-mv rv-t2 rv-zero)
   in let loop = list-length i / 4
   in let match-idx = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-add rv-t3 rv-a0 rv-t2)
   in let i = rv-rt-emit i (rv-lb rv-t3 rv-t3 0)
   in let i = rv-rt-emit i (rv-add rv-t4 rv-a1 rv-t2)
   in let i = rv-rt-emit i (rv-lb rv-t4 rv-t4 0)
   in let i = rv-rt-emit i (rv-sub rv-t5 rv-t3 rv-t4)
   in let no-match = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-t2 rv-t2 1)
   in let i = rv-rt-emit i (rv-j ((loop - list-length i / 4) * 4))
   in let match-label = list-length i / 4
