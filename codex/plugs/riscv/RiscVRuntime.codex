   in let i = rv-rt-emit i (rv-addi rv-t2 rv-t2 1)
   in let i = rv-rt-emit i (rv-j ((inner - list-length i / 4) * 4))
   in let found-label = list-length i / 4
   in let i = rv-rt-emit i (rv-addi rv-a0 rv-zero 1)
   in let jmp-end = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let mismatch-label = list-length i / 4
   in let i = rv-rt-emit i (rv-addi rv-t1 rv-t1 1)
   in let i = rv-rt-emit i (rv-j ((outer - list-length i / 4) * 4))
   in let notfound-label = list-length i / 4
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in let end-label = list-length i / 4
   in let i = rv-rt-emit i (rv-ld rv-s5 rv-sp 16)
   in let i = rv-rt-emit i (rv-ld rv-s4 rv-sp 24)
   in let i = rv-rt-emit i (rv-ld rv-s3 rv-sp 32)
   in let i = rv-rt-emit i (rv-ld rv-s2 rv-sp 40)
   in let i = rv-rt-emit i (rv-ld rv-s0 rv-sp 48)
   in let i = rv-rt-emit i (rv-ld rv-ra rv-sp 56)
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp 64)
   in let i = rv-rt-emit i rv-ret
   in let i = rv-patch-insn-raw i outer-exit (rv-bge rv-t1 rv-t0 ((notfound-label - outer-exit) * 4))
   in let i = rv-patch-insn-raw i inner-exit (rv-bge rv-t2 rv-s3 ((found-label - inner-exit) * 4))
   in let i = rv-patch-insn-raw i mismatch (rv-bne rv-t5 rv-zero ((mismatch-label - mismatch) * 4))
   in rv-patch-insn-raw i jmp-end (rv-j ((end-label - jmp-end) * 4))

Section: text-starts-with (a0=text, a1=prefix -> 0 or 1)

  rv-rt-text-starts-with : List Integer
  rv-rt-text-starts-with =
   let i = []
