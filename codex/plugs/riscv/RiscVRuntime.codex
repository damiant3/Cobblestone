Chapter: RISC-V Runtime
  cites Foreword chapter RiscVEncoder

 Runtime helpers for RISC-V codegen. QEMU virt NS16550A UART
 at 0x10000000. Heap pointer in S1 (x9).

 Register plan for helpers (no caller/callee confusion):
   s0=fp  s1=heap  s2-s7=helper locals  s8-s11=codegen locals
   t0-t6=scratch (28-31 ARE t3-t6, do NOT use raw 28-31)
   a0-a7=args/return

Section: Helper Infrastructure

  rv-rt-emit : List Integer, List Integer -> List Integer
  rv-rt-emit (acc) (insn) = acc & insn

Section: __str_eq (with prologue)

  rv-rt-str-eq : List Integer
  rv-rt-str-eq =
   let i = []
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp (0 - 48))
   in let i = rv-rt-emit i (rv-sd rv-sp rv-ra 40)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s0 32)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s2 24)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s3 16)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s4 8)
   in let i = rv-rt-emit i (rv-mv rv-s0 rv-sp)
   in let i = rv-rt-emit i (rv-ld rv-s2 rv-a0 0)
   in let i = rv-rt-emit i (rv-ld rv-s3 rv-a1 0)
   in let i = rv-rt-emit i (rv-sub rv-t0 rv-s2 rv-s3)
   in let bne-len = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-a0 rv-a0 8)
   in let i = rv-rt-emit i (rv-addi rv-a1 rv-a1 8)
   in let i = rv-rt-emit i (rv-mv rv-s4 rv-a0)
   in let i = rv-rt-emit i (rv-mv rv-s5 rv-a1)
   in let i = rv-rt-emit i (rv-mv rv-t0 rv-zero)
   in let loop = list-length i / 4
   in let bge-done = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-add rv-t1 rv-s4 rv-t0)
   in let i = rv-rt-emit i (rv-lb rv-t1 rv-t1 0)
   in let i = rv-rt-emit i (rv-add rv-t2 rv-s5 rv-t0)
   in let i = rv-rt-emit i (rv-lb rv-t2 rv-t2 0)
   in let i = rv-rt-emit i (rv-sub rv-t3 rv-t1 rv-t2)
   in let bne-byte = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-t0 rv-t0 1)
   in let i = rv-rt-emit i (rv-j ((loop - list-length i / 4) * 4))
   in let equal-label = list-length i / 4
   in let i = rv-rt-emit i (rv-addi rv-a0 rv-zero 1)
   in let jmp-end1 = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let not-eq-label = list-length i / 4
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in let end-label = list-length i / 4
   in let i = rv-rt-emit i (rv-ld rv-s4 rv-sp 8)
   in let i = rv-rt-emit i (rv-ld rv-s3 rv-sp 16)
   in let i = rv-rt-emit i (rv-ld rv-s2 rv-sp 24)
   in let i = rv-rt-emit i (rv-ld rv-s0 rv-sp 32)
   in let i = rv-rt-emit i (rv-ld rv-ra rv-sp 40)
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp 48)
   in let i = rv-rt-emit i rv-ret
   in let i = rv-patch-insn-raw i bne-len (rv-bne rv-t0 rv-zero ((not-eq-label - bne-len) * 4))
   in let i = rv-patch-insn-raw i bge-done (rv-bge rv-t0 rv-s2 ((equal-label - bge-done) * 4))
   in let i = rv-patch-insn-raw i bne-byte (rv-bne rv-t3 rv-zero ((not-eq-label - bne-byte) * 4))
   in rv-patch-insn-raw i jmp-end1 (rv-j ((end-label - jmp-end1) * 4))

