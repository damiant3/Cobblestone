Section: Address Remap Helpers

  rv-remap-addr-insns : Integer -> List Integer
  rv-remap-addr-insns (addr-reg) =
   let skip-pos = 1
   in let i = []
   in let i = rv-rt-emit i (rv-srli rv-t0 addr-reg 24)
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-addi rv-t0 rv-zero 1)
   in let i = rv-rt-emit i (rv-slli rv-t0 rv-t0 31)
   in let i = rv-rt-emit i (rv-add addr-reg addr-reg rv-t0)
   in let done = list-length i / 4
   in rv-patch-insn-raw i skip-pos (rv-bne rv-t0 rv-zero ((done - skip-pos) * 4))

  rv-rt-peek-byte : List Integer
  rv-rt-peek-byte =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-lbu rv-a0 rv-a0 0)
   in rv-rt-emit i rv-ret

  rv-rt-poke-byte : List Integer
  rv-rt-poke-byte =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-sb rv-a0 rv-a2 0)
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in rv-rt-emit i rv-ret

 A halfword at an odd address may trap on a hart without misaligned-access
 support (the trap stub here has no dispatch, so it hangs); an even address
 takes the single lhu/sh a 16-bit device register needs, an odd one two byte
 accesses, little-endian, as the ARM64 twin does.

  rv-rt-peek-16 : List Integer
  rv-rt-peek-16 =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-andi rv-t0 rv-a0 1)
   in let i = rv-rt-emit i (rv-beq rv-t0 rv-zero 24)
   in let i = rv-rt-emit i (rv-lbu rv-t1 rv-a0 1)
   in let i = rv-rt-emit i (rv-lbu rv-a0 rv-a0 0)
   in let i = rv-rt-emit i (rv-slli rv-t1 rv-t1 8)
   in let i = rv-rt-emit i (rv-or rv-a0 rv-a0 rv-t1)
   in let i = rv-rt-emit i (rv-j 8)
   in let i = rv-rt-emit i (rv-lhu rv-a0 rv-a0 0)
   in rv-rt-emit i rv-ret

  rv-rt-poke-16 : List Integer
  rv-rt-poke-16 =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-andi rv-t0 rv-a0 1)
   in let i = rv-rt-emit i (rv-beq rv-t0 rv-zero 20)
   in let i = rv-rt-emit i (rv-sb rv-a0 rv-a2 0)
   in let i = rv-rt-emit i (rv-srli rv-t1 rv-a2 8)
   in let i = rv-rt-emit i (rv-sb rv-a0 rv-t1 1)
   in let i = rv-rt-emit i (rv-j 8)
   in let i = rv-rt-emit i (rv-sh rv-a0 rv-a2 0)
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in rv-rt-emit i rv-ret

  rv-lwu : Integer, Integer, Integer -> List Integer
  rv-lwu (rd) (rs1) (offset) = rv-i-type 3 rd 6 rs1 offset

  rv-rt-peek-32 : List Integer
  rv-rt-peek-32 =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-lwu rv-a0 rv-a0 0)
   in rv-rt-emit i rv-ret

  rv-rt-poke-32 : List Integer
  rv-rt-poke-32 =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-sw rv-a0 rv-a2 0)
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in rv-rt-emit i rv-ret

  rv-rt-peek-qword : List Integer
  rv-rt-peek-qword =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-ld rv-a0 rv-a0 0)
   in rv-rt-emit i rv-ret

  rv-rt-poke-qword : List Integer
  rv-rt-poke-qword =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-a0 rv-a0 rv-a1)
   in let i = i & rv-remap-addr-insns rv-a0
   in let i = rv-rt-emit i (rv-sd rv-a0 rv-a2 0)
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-zero)
   in rv-rt-emit i rv-ret

 tag-equal reads the constructor tag word at [p+0] of both variant values
 and answers their equality without touching a field. RV64 has no
 set-on-equal, so the difference is tested for non-zero and inverted.

  rv-rt-tag-equal : List Integer
  rv-rt-tag-equal =
   let i = []
   in let i = rv-rt-emit i (rv-ld rv-t0 rv-a0 0)
   in let i = rv-rt-emit i (rv-ld rv-t1 rv-a1 0)
   in let i = rv-rt-emit i (rv-xor rv-t0 rv-t0 rv-t1)
   in let i = rv-rt-emit i (rv-sltu rv-a0 rv-zero rv-t0)
   in let i = rv-rt-emit i (rv-xori rv-a0 rv-a0 1)
   in rv-rt-emit i rv-ret

Section: CCE to Unicode Lookup Table

  rv-cce-table-addr : Integer = #80080000
  rv-ascii-to-cce-table-addr : Integer = #80080100

  rv-build-ascii-to-cce : List Integer, Integer -> List Integer
  rv-build-ascii-to-cce (acc) (ascii) =
   if ascii >= 128 then acc
   else let cce = rv-find-cce-for-ascii ascii 0
   in rv-build-ascii-to-cce (list-push acc cce) (ascii + 1)

  rv-find-cce-for-ascii : Integer, Integer -> Integer
  rv-find-cce-for-ascii (ascii) (cce) =
   if cce >= list-length cce-to-unicode-table then 0
   else if list-at cce-to-unicode-table cce == ascii then cce
   else rv-find-cce-for-ascii ascii (cce + 1)

  rv-build-cce-table : List Integer, Integer -> List Integer
  rv-build-cce-table (acc) (i) =
   if i >= 256 then acc
   else let unicode = if i < list-length cce-to-unicode-table then list-at cce-to-unicode-table i else 63
   in rv-build-cce-table (list-push acc (bit-and unicode 255)) (i + 1)

Section: print-line-uni (NS16550A UART at 0x10000000 with CCE-to-Unicode)

  rv-rt-uart-base : Integer = #10000000

  rv-rt-print-line-uni : List Integer
  rv-rt-print-line-uni =
   let i = []
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp (0 - 64))
   in let i = rv-rt-emit i (rv-sd rv-sp rv-ra 56)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s0 48)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s2 40)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s3 32)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s4 24)
   in let i = rv-rt-emit i (rv-sd rv-sp rv-s5 16)
   in let i = rv-rt-emit i (rv-mv rv-s0 rv-sp)
   in let i = rv-rt-emit i (rv-mv rv-s2 rv-a0)
   in let i = rv-rt-emit i (rv-ld rv-s3 rv-s2 0)
   in let i = i & rv-li rv-s4 rv-rt-uart-base
   in let i = i & rv-li rv-s5 rv-cce-table-addr
   in let i = rv-rt-emit i (rv-mv rv-t0 rv-zero)
   in let loop = list-length i / 4
   in let exit = list-length i / 4
   in let i = rv-rt-emit i rv-nop
   in let i = rv-rt-emit i (rv-add rv-t1 rv-s2 rv-t0)
   in let i = rv-rt-emit i (rv-lb rv-t1 rv-t1 8)
   in let i = rv-rt-emit i (rv-add rv-t1 rv-s5 rv-t1)
   in let i = rv-rt-emit i (rv-lb rv-t1 rv-t1 0)
   in let i = rv-rt-emit i (rv-sb rv-s4 rv-t1 0)
   in let i = rv-rt-emit i (rv-addi rv-t0 rv-t0 1)
   in let i = rv-rt-emit i (rv-j ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = rv-rt-emit i (rv-addi rv-t0 rv-zero 10)
   in let i = rv-rt-emit i (rv-sb rv-s4 rv-t0 0)
   in let i = rv-rt-emit i (rv-ld rv-s5 rv-sp 16)
   in let i = rv-rt-emit i (rv-ld rv-s4 rv-sp 24)
   in let i = rv-rt-emit i (rv-ld rv-s3 rv-sp 32)
   in let i = rv-rt-emit i (rv-ld rv-s2 rv-sp 40)
   in let i = rv-rt-emit i (rv-ld rv-s0 rv-sp 48)
   in let i = rv-rt-emit i (rv-ld rv-ra rv-sp 56)
   in let i = rv-rt-emit i (rv-addi rv-sp rv-sp 64)
   in let i = rv-rt-emit i rv-ret
   in rv-patch-insn-raw i exit (rv-bge rv-t0 rv-s3 ((exit-label - exit) * 4))

Section: int-mod

 int-mod answers the NON-NEGATIVE residue, and rem does not: it keeps the
 sign of the dividend. x86-64's emit-int-mod-reg-locals adds the divisor's
 magnitude when idiv's remainder comes back negative; this helper stopped at
 the remainder, so int-mod (-7) 3 was -1 here and 2 there. Measured against
 codex/test/modprobe, and it is the whole of interval-exhaustive's failures on
 both cross lanes, all of them in mod, because iv-mod's transfer function is
 written for a non-negative result. The branch skips five instructions, so its
 offset is twenty bytes.

  rv-rt-int-mod : List Integer
  rv-rt-int-mod =
   let i = []
   in let i = i & rv-rem rv-a0 rv-a0 rv-a1
   in let i = i & rv-bge rv-a0 rv-zero 20
   in let i = i & rv-srai rv-t0 rv-a1 63
   in let i = i & rv-xor rv-t1 rv-a1 rv-t0
   in let i = i & rv-sub rv-t1 rv-t1 rv-t0
   in let i = i & rv-add rv-a0 rv-a0 rv-t1
   in i & rv-ret

