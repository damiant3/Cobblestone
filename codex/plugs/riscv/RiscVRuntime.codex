   rv-rem rv-a0 rv-a0 rv-a1 & rv-ret

Section: Builtin Helpers

  rv-rt-text-length : List Integer
  rv-rt-text-length =
   rv-ld rv-a0 rv-a0 0 & rv-ret

  rv-rt-list-at : List Integer
  rv-rt-list-at =
   let i = []
   in let i = rv-rt-emit i (rv-slli rv-t0 rv-a1 3)
   in let i = rv-rt-emit i (rv-add rv-t0 rv-a0 rv-t0)
   in let i = rv-rt-emit i (rv-ld rv-a0 rv-t0 8)
   in rv-rt-emit i rv-ret

  rv-rt-char-at : List Integer
  rv-rt-char-at =
   let i = []
   in let i = rv-rt-emit i (rv-add rv-t0 rv-a0 rv-a1)
   in let i = rv-rt-emit i (rv-lb rv-a0 rv-t0 8)
   in rv-rt-emit i rv-ret

  rv-rt-char-to-text : List Integer
  rv-rt-char-to-text =
   let i = []
   in let i = rv-rt-emit i (rv-mv rv-t0 rv-a0)
   in let i = rv-rt-emit i (rv-mv rv-a0 rv-s1)
   in let i = rv-rt-emit i (rv-addi rv-s1 rv-s1 16)
   in let i = rv-rt-emit i (rv-addi rv-t1 rv-zero 1)
   in let i = rv-rt-emit i (rv-sd rv-a0 rv-t1 0)
   in let i = rv-rt-emit i (rv-sb rv-a0 rv-t0 8)
   in rv-rt-emit i rv-ret

Section: Patching Helper

  rv-patch-insn-raw : List Integer, Integer, List Integer -> List Integer
  rv-patch-insn-raw (code) (insn-index) (new-bytes) =
   let byte-offset = insn-index * 4
   in rv-patch-raw-4 code byte-offset new-bytes 0 (list-length code) []

  rv-patch-raw-4 : List Integer, Integer, List Integer, Integer, Integer, List Integer -> List Integer
  rv-patch-raw-4 (code) (pos) (new-bytes) (i) (len) (acc) =
   if i >= len then acc
   else if i >= pos & i < pos + 4 then rv-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at new-bytes (i - pos)))
   else rv-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at code i))

Section: Emit All Runtime Helpers

  rv-emit-runtime : RvState -> RvState
  rv-emit-runtime (st) =
   let st1 = rv-record-func st "__start"
   in let st2 = rv-emit-li st1 rv-sp #84000000
   in let st3 = rv-emit-li st2 rv-s1 #80100000
   in let st4 = rv-add-call-patch st3 "opening"
   in let st5 = rv-emit st4 rv-nop
   in let st6 = rv-emit st5 rv-ebreak
   in let st7 = rv-record-func st6 "print-line-uni"
   in let st8 = rv-emit st7 rv-rt-print-line-uni
   in let st9 = rv-record-func st8 "__str_eq"
   in let st10 = rv-emit st9 rv-rt-str-eq
   in let st11 = rv-record-func st10 "__str_concat"
   in let st12 = rv-emit st11 rv-rt-str-concat
   in let st13 = rv-record-func st12 "__itoa"
   in let st14 = rv-emit st13 rv-rt-itoa
   in let st15 = rv-record-func st14 "__list_cons"
   in let st16 = rv-emit st15 rv-rt-list-cons
   in let st17 = rv-record-func st16 "__list_append"
   in let st18 = rv-emit st17 rv-rt-list-append
   in let st19 = rv-record-func st18 "__list_push"
   in let st20 = rv-emit st19 rv-rt-list-push
   in let st21 = rv-record-func st20 "__list_empty"
   in let st22 = rv-emit st21 rv-rt-list-empty
   in let st23 = rv-record-func st22 "integer-to-text"
   in let st24 = rv-emit st23 rv-rt-itoa
   in let st25 = rv-record-func st24 "text-length"
   in let st26 = rv-emit st25 rv-rt-text-length
   in let st27 = rv-record-func st26 "list-length"
   in let st28 = rv-emit st27 rv-rt-text-length
   in let st29 = rv-record-func st28 "list-at"
   in let st30 = rv-emit st29 rv-rt-list-at
   in let st31 = rv-record-func st30 "char-at"
   in let st32 = rv-emit st31 rv-rt-char-at
   in let st33 = rv-record-func st32 "char-code"
   in let st34 = rv-emit st33 rv-ret
   in let st35 = rv-record-func st34 "code-to-char"
   in let st36 = rv-emit st35 rv-ret
   in let st37 = rv-record-func st36 "char-to-text"
   in let st38 = rv-emit st37 rv-rt-char-to-text
   in let st39 = rv-record-func st38 "show"
   in let st40 = rv-emit st39 rv-rt-itoa
   in let st41 = rv-record-func st40 "int-mod"
   in let st42 = rv-emit st41 rv-rt-int-mod
   in let st43 = rv-record-func st42 "bit-and"
   in let st44 = rv-emit st43 (rv-and rv-a0 rv-a0 rv-a1 & rv-ret)
   in let st45 = rv-record-func st44 "bit-or"
   in let st46 = rv-emit st45 (rv-or rv-a0 rv-a0 rv-a1 & rv-ret)
   in let st47 = rv-record-func st46 "bit-xor"
   in let st48 = rv-emit st47 (rv-xor rv-a0 rv-a0 rv-a1 & rv-ret)
   in let st49 = rv-record-func st48 "bit-shl"
   in let st50 = rv-emit st49 (rv-sll rv-a0 rv-a0 rv-a1 & rv-ret)
   in let st51 = rv-record-func st50 "bit-shru"
   in rv-emit st51 (rv-srl rv-a0 rv-a0 rv-a1 & rv-ret)

