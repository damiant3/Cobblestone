Chapter: Scheme Emitter

Section: Keywords and Sanitization

  scm-keywords : List Text =
   ["and", "begin", "case", "cond", "define", "delay", "do", "else",
    "if", "lambda", "let", "letrec", "or", "quasiquote", "quote",
    "set!", "unquote", "syntax-rules", "define-syntax", "import",
    "include", "when", "unless", "guard", "define-record-type"]

  scm-is-keyword : Text, Integer -> Boolean
  scm-is-keyword (name) (i) =
   if i == list-length scm-keywords then False
   else if list-at scm-keywords i == name then True
   else scm-is-keyword name (i + 1)

  scm-sanitize : Text -> Text
  scm-sanitize (name) =
   let s = text-replace name "_" "-"
   in if scm-is-keyword s 0 then s & "-v"
      else s

 The IR spells a record field as `name/slot`. In a map-keyed target the
 slot lands INSIDE the key string, so the lookup misses silently rather
 than dividing; the key has to be the bare name.

  scm-slash-pos : Text, Integer, Integer -> Integer
  scm-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else scm-slash-pos f (i + 1) len

  scm-field : Text -> Text
  scm-field (f) =
   let slash = scm-slash-pos f 0 (text-length f)
   in if slash >= 0 then scm-sanitize (substring f 0 slash)
      else scm-sanitize f

  scm-escape : Text -> Text
  scm-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in text-replace s2 "\n" "\\n"

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Definition Emission

  emit-scm-type-defs : List ATypeDef, Integer -> Text
  emit-scm-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-scm-type-def (list-at tds i) & emit-scm-type-defs tds (i + 1)

  emit-scm-type-def : ATypeDef -> Text
  emit-scm-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     "(define (make-" & scm-sanitize (name.value) & " . args) (cons '" & scm-sanitize (name.value) & " args))\n" & emit-scm-record-accessors (name.value) fields 0 & "\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-scm-ctors ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-scm-record-accessors : Text, List ARecordFieldDef, Integer -> Text
  emit-scm-record-accessors (rname) (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "(define (" & scm-sanitize rname & "-" & scm-sanitize (f.name.value) & " r) (list-ref (cdr r) " & integer-to-text i & "))\n" & emit-scm-record-accessors rname fields (i + 1)

  emit-scm-ctors : List AVariantCtorDef, Integer -> Text
  emit-scm-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in "(define (make-" & scm-sanitize (c.name.value) & " . args) (cons '" & scm-sanitize (c.name.value) & " args))\n" & emit-scm-ctors ctors (i + 1)

Section: Expression Emission

  emit-scm-expr : IRExpr, List ArityEntry -> Text
  emit-scm-expr (e) (arities) = emit-scm-expr-at e arities 0

  emit-scm-expr-at : IRExpr, List ArityEntry, Integer -> Text
  emit-scm-expr-at (e) (arities) (depth) =
   if depth >= 256 then "'()"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> integer-to-text n & ".0"
    is IrTextLit (s) (sp) -> "\"" & scm-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "#t" else "#f"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> emit-scm-name n arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-scm-binary op l r arities
    is IrNegate (operand) (nty) (sp) -> "(- " & emit-scm-expr-at operand arities (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(if " & emit-scm-expr-at c arities (depth + 1) & " " & emit-scm-expr-at t arities (depth + 1) & " " & emit-scm-expr-at el arities (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(let ((" & scm-sanitize name & " " & emit-scm-expr-at val arities (depth + 1) & ")) " & emit-scm-expr-at body arities (depth + 1) & ")"
    is IrApply (f) (a) (ty) (sp) -> emit-scm-apply e arities
    is IrLambda (params) (body) (ty) (sp) -> "(lambda (" & emit-scm-lambda-params params 0 & ") " & emit-scm-expr body arities & ")"
    is IrList (elems) (ty) (sp) -> "(list " & emit-scm-list-elems elems 0 arities & ")"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-scm-match scrut branches arities depth
    is IrAct (stmts) (ty) (sp) -> emit-scm-act stmts arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-scm-expr-at body arities (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-scm-expr-at body arities (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> "(make-" & scm-sanitize name & " " & emit-scm-field-vals fields 0 arities & ")"
    is IrFieldAccess (rec) (field) (ty) (sp) -> "(cdr (assq '" & scm-field field & " (cdr " & emit-scm-expr-at rec arities (depth + 1) & ")))"
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "'()"
    is IrFork (body) (ty) (sp) -> emit-scm-expr-at body arities (depth + 1)
    is IrAwait (task) (ty) (sp) -> emit-scm-expr-at task arities (depth + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> "(guard (exn (#t " & emit-scm-act fb arities & ")) " & emit-scm-act body arities & ")"
    is IrError (msg) (ty) (sp) -> "(error \"" & scm-escape msg & "\")"

  emit-scm-name : Text, List ArityEntry -> Text
  emit-scm-name (n) (arities) =
   if n == "True" then "#t"
   else if n == "False" then "#f"
   else if n == "Nothing" then "'()"
   else let ar = lookup-arity arities n
   in if ar == 0 then "(" & scm-sanitize n & ")"
      else scm-sanitize n

  emit-scm-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  emit-scm-binary (op) (l) (r) (arities) =
   when op
    is IrAppendText -> "(string-append " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrAppendList -> "(append " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrConsList -> "(cons " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrDivInt -> "(quotient " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrRemInt -> "(remainder " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrEq | IrApproxEq | IrApproxEqExact -> "(equal? " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrNotEq -> "(not (equal? " & emit-scm-expr l arities & " " & emit-scm-expr r arities & "))"
    is IrAnd -> "(and " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrOr -> "(or " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrAddVec -> "(map + " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrSubVec -> "(map - " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrMulVec -> "(map * " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is IrDivVec -> "(map / " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"
    is otherwise -> "(" & scm-bin-op op & " " & emit-scm-expr l arities & " " & emit-scm-expr r arities & ")"

  scm-bin-op : IRBinaryOp -> Text
  scm-bin-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt -> "quotient"
    is IrRemInt -> "remainder"
    is IrPowInt -> "expt"
    is IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrEq | IrApproxEq | IrApproxEqExact -> "equal?"
    is IrNotEq -> "not-equal?"
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrAnd -> "and"
    is IrOr -> "or"
    is IrAppendText -> "string-append"
    is IrAppendList -> "append"
    is IrConsList -> "cons"

  emit-scm-lambda-params : List IRParam, Integer -> Text
  emit-scm-lambda-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then scm-sanitize ((list-at params i).name)
   else scm-sanitize ((list-at params i).name) & " " & emit-scm-lambda-params params (i + 1)

  emit-scm-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  emit-scm-list-elems (elems) (i) (arities) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-scm-expr (list-at elems i) arities
   else emit-scm-expr (list-at elems i) arities & " " & emit-scm-list-elems elems (i + 1) arities

  emit-scm-field-vals : List IRFieldVal, Integer, List ArityEntry -> Text
  emit-scm-field-vals (fields) (i) (arities) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then " " else ""
   in sep & emit-scm-expr (f.value) arities & emit-scm-field-vals fields (i + 1) arities

  emit-scm-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-scm-match (scrut) (branches) (arities) (depth) =
   "(let ((_s " & emit-scm-expr scrut arities & ")) " & emit-scm-match-body branches 0 arities depth & ")"

  emit-scm-match-body : List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-scm-match-body (branches) (i) (arities) (depth) =
   if i == list-length branches then "(error \"Non-exhaustive match\")"
   else let b = list-at branches i
   in emit-scm-match-arm (b.pattern) (b.guard) (b.body) branches i arities depth

 The rest of the match is the `if`'s else, so a guard goes in the TEST,
 inside the arm's own `let` so it can see the bindings, and behind the
 pattern test's short circuit because `(car _s)` on the wrong shape is an
 error.

  scm-guard-trivial : IRExpr -> Boolean
  scm-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  scm-ctor-test : Text, List IRPat, IRExpr, List ArityEntry -> Text
  scm-ctor-test (name) (subs) (guard) (arities) =
   if scm-guard-trivial guard then "(eq? (car _s) '" & name & ")"
   else "(and (eq? (car _s) '" & name & ") (let (" & emit-scm-ctor-bindings subs 0 & ") " & emit-scm-expr guard arities & "))"

  emit-scm-match-arm : IRPat, IRExpr, IRExpr, List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-scm-match-arm (pat) (guard) (body) (branches) (i) (arities) (depth) =
   when pat
    is IrLitPat (text) (ty) (sp) -> "(if " & (if scm-guard-trivial guard then "(equal? _s " & text & ")" else "(and (equal? _s " & text & ") " & emit-scm-expr guard arities & ")") & " " & emit-scm-expr body arities & " " & emit-scm-match-body branches (i + 1) arities depth & ")"
    is IrCtorPat (name) (subs) (ty) (sp) -> "(if " & scm-ctor-test (scm-sanitize name) subs guard arities & " " & emit-scm-ctor-bind subs body arities & " " & emit-scm-match-body branches (i + 1) arities depth & ")"
    is IrVarPat (name) (ty) (sp) ->
     if scm-guard-trivial guard then "(let ((" & scm-sanitize name & " _s)) " & emit-scm-expr body arities & ")"
     else "(if (let ((" & scm-sanitize name & " _s)) " & emit-scm-expr guard arities & ") (let ((" & scm-sanitize name & " _s)) " & emit-scm-expr body arities & ") " & emit-scm-match-body branches (i + 1) arities depth & ")"
    is IrWildPat (sp) ->
     if scm-guard-trivial guard then emit-scm-expr body arities
     else "(if " & emit-scm-expr guard arities & " " & emit-scm-expr body arities & " " & emit-scm-match-body branches (i + 1) arities depth & ")"
    is IrVecPat (pats) (ty) (sp) ->
     if scm-guard-trivial guard then emit-scm-expr body arities
     else "(if " & emit-scm-expr guard arities & " " & emit-scm-expr body arities & " " & emit-scm-match-body branches (i + 1) arities depth & ")"

  emit-scm-ctor-bind : List IRPat, IRExpr, List ArityEntry -> Text
  emit-scm-ctor-bind (subs) (body) (arities) =
   "(let (" & emit-scm-ctor-bindings subs 0 & ") " & emit-scm-expr body arities & ")"

  emit-scm-ctor-bindings : List IRPat, Integer -> Text
  emit-scm-ctor-bindings (subs) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in (when sub
    is IrVarPat (name) (ty) (sp) -> "(" & scm-sanitize name & " (list-ref (cdr _s) " & integer-to-text i & ")) "
    is otherwise -> "") & emit-scm-ctor-bindings subs (i + 1)

  emit-scm-act : List IRActStmt, List ArityEntry -> Text
  emit-scm-act (stmts) (arities) =
   "(begin " & emit-scm-act-stmts stmts 0 arities & ")"

  emit-scm-act-stmts : List IRActStmt, Integer, List ArityEntry -> Text
  emit-scm-act-stmts (stmts) (i) (arities) =
   if i == list-length stmts then "'()"
   else let s = list-at stmts i
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> "(define " & scm-sanitize name & " " & emit-scm-expr val arities & ") "
    is IrDoExec (e) (sp) -> emit-scm-expr e arities & " ") & (if i < list-length stmts - 1 then emit-scm-act-stmts stmts (i + 1) arities else "")

Section: Apply Emission

  emit-scm-apply : IRExpr, List ArityEntry -> Text
  emit-scm-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     let bi = scm-try-builtin n args arities
     in if text-length bi > 0 then bi
     else "(" & scm-sanitize n & " " & emit-scm-apply-args args arities 0 & ")"
    is otherwise -> "(" & emit-scm-expr root arities & " " & emit-scm-apply-args args arities 0 & ")"

  emit-scm-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-scm-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-scm-expr (list-at args i) arities
        else emit-scm-expr (list-at args i) arities & " " & emit-scm-apply-args args arities (i + 1)

  ScmBuiltinEntry = record {
   bname : Text,
   tag : Integer between 0 and 255
  }

  scm-builtin-table : List ScmBuiltinEntry =
   [ScmBuiltinEntry { bname = "abs",              tag = 1 },
   ScmBuiltinEntry { bname = "__narrow",         tag = 22 },
    ScmBuiltinEntry { bname = "char-at",           tag = 2 },
    ScmBuiltinEntry { bname = "char-code",         tag = 3 },
    ScmBuiltinEntry { bname = "char-to-text",      tag = 4 },
    ScmBuiltinEntry { bname = "int-mod",           tag = 5 },
    ScmBuiltinEntry { bname = "integer-to-text",   tag = 6 },
    ScmBuiltinEntry { bname = "list-at",           tag = 7 },
    ScmBuiltinEntry { bname = "list-length",       tag = 8 },
    ScmBuiltinEntry { bname = "max",               tag = 9 },
    ScmBuiltinEntry { bname = "min",               tag = 10 },
    ScmBuiltinEntry { bname = "negate",            tag = 11 },
    ScmBuiltinEntry { bname = "print-line-uni",    tag = 12 },
    ScmBuiltinEntry { bname = "process-exit",      tag = 13 },
    ScmBuiltinEntry { bname = "read-text",         tag = 14 },
    ScmBuiltinEntry { bname = "show",              tag = 15 },
    ScmBuiltinEntry { bname = "substring",         tag = 16 },
    ScmBuiltinEntry { bname = "text-compare",      tag = 17 },
    ScmBuiltinEntry { bname = "text-contains",     tag = 18 },
    ScmBuiltinEntry { bname = "text-length",       tag = 19 },
    ScmBuiltinEntry { bname = "text-to-integer",   tag = 20 },
    ScmBuiltinEntry { bname = "write-file",        tag = 21 }]

  find-scm-builtin : List ScmBuiltinEntry, Text, Integer -> Integer
  find-scm-builtin (tbl) (name) (i) =
   if i >= list-length tbl then -1
   else if (list-at tbl i).bname == name then (list-at tbl i).tag
   else find-scm-builtin tbl name (i + 1)

  scm-lookup-builtin : Text -> Integer
  scm-lookup-builtin (name) =
   find-scm-builtin scm-builtin-table name 0

  scm-try-builtin : Text, List IRExpr, List ArityEntry -> Text
  scm-try-builtin (n) (args) (arities) =
   let tag = scm-lookup-builtin n
   in if tag == 1 then "(abs " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 22 then emit-scm-expr (list-at args 0) arities
   else if tag == 2 then "(char->integer (string-ref " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & "))"
   else if tag == 3 then emit-scm-expr (list-at args 0) arities
   else if tag == 4 then "(string (integer->char " & emit-scm-expr (list-at args 0) arities & "))"
   else if tag == 5 then "(modulo " & emit-scm-expr (list-at args 0) arities & " (abs " & emit-scm-expr (list-at args 1) arities & "))"
   else if tag == 6 then "(number->string " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 7 then "(list-ref " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ")"
   else if tag == 8 then "(length " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 9 then "(max " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ")"
   else if tag == 10 then "(min " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ")"
   else if tag == 11 then "(- " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 12 then "(begin (display " & emit-scm-expr (list-at args 0) arities & ") (newline))"
   else if tag == 13 then "(exit " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 14 then "(call-with-input-file " & emit-scm-expr (list-at args 0) arities & " (lambda (p) (read-string #f p)))"
   else if tag == 15 then "(number->string " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 16 then "(substring " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & " (+ " & emit-scm-expr (list-at args 1) arities & " " & emit-scm-expr (list-at args 2) arities & "))"
   else if tag == 17 then "(if (string<? " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ") -1 (if (string=? " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ") 0 1))"
   else if tag == 18 then "(text-contains " & emit-scm-expr (list-at args 0) arities & " " & emit-scm-expr (list-at args 1) arities & ")"
   else if tag == 19 then "(string-length " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 20 then "(text-to-integer " & emit-scm-expr (list-at args 0) arities & ")"
   else if tag == 21 then "(call-with-output-file " & emit-scm-expr (list-at args 0) arities & " (lambda (p) (write-string " & emit-scm-expr (list-at args 1) arities & " p)))"
   else ""

Section: Definition Emission

  emit-scm-def : IRDef, List ArityEntry -> Text
  emit-scm-def (d) (arities) =
   let name = scm-sanitize (d.name)
   in "(define (" & name & " " & emit-scm-lambda-params (d.params) 0 & ") " & emit-scm-expr (d.body) arities & ")\n\n"

  emit-scm-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-scm-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-scm-def (list-at defs i) arities & emit-scm-defs defs (i + 1) arities

Section: Chapter Emission

  emit-scheme-chapter : IRChapter, List ATypeDef -> Text
  emit-scheme-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let header = "(import (scheme base) (scheme write) (scheme read))\n\n(define (list-snoc xs v) (append xs (list v)))\n(define (list-push xs v) (list-snoc xs v))\n\n" & scm-text-builtins
   in let types-text = emit-scm-type-defs type-defs 0
   in let defs-text = emit-scm-defs (m.defs) 0 arities
   in let entry = scm-emit-entry (m.defs)
   in header & types-text & defs-text & entry

 `(scheme base)` has string=?, string-length, substring and string-ref and
 no search or split at all, so these are written out rather than delegated.
 `string-contains` is SRFI-13 and was being emitted against an import that
 does not provide it, and `string->number` answers #f rather than a prefix
 or 0, which the caller then hands to number->string.

  scm-text-builtins : Text
  scm-text-builtins =
   "(define (text-starts-with s p)\n  (and (<= (string-length p) (string-length s))\n       (string=? (substring s 0 (string-length p)) p)))\n\n"
   & "(define (text-split s sep)\n  (if (= (string-length sep) 0)\n      (list s)\n      (let loop ((start 0) (i 0) (acc (list)))\n        (cond ((> i (- (string-length s) (string-length sep)))\n               (reverse (cons (substring s start (string-length s)) acc)))\n              ((string=? (substring s i (+ i (string-length sep))) sep)\n               (loop (+ i (string-length sep)) (+ i (string-length sep))\n                     (cons (substring s start i) acc)))\n              (else (loop start (+ i 1) acc))))))\n\n"
   & "(define (text-replace s old new)\n  (if (= (string-length old) 0)\n      s\n      (let loop ((i 0) (acc \"\"))\n        (cond ((>= i (string-length s)) acc)\n              ((and (<= (+ i (string-length old)) (string-length s))\n                    (string=? (substring s i (+ i (string-length old))) old))\n               (loop (+ i (string-length old)) (string-append acc new)))\n              (else (loop (+ i 1) (string-append acc (string (string-ref s i)))))))))\n\n"
   & "(define (text-contains s sub)\n  (let loop ((i 0))\n    (cond ((> (string-length sub) (- (string-length s) i)) (= (string-length sub) 0))\n          ((string=? (substring s i (+ i (string-length sub))) sub) #t)\n          (else (loop (+ i 1))))))\n\n"
   & "(define (text-to-integer s)\n  (let* ((n (string-length s))\n         (neg (and (> n 0) (char=? (string-ref s 0) #\\-))))\n    (let loop ((i (if neg 1 0)) (v 0))\n      (if (and (< i n) (char>=? (string-ref s i) #\\0) (char<=? (string-ref s i) #\\9))\n          (loop (+ i 1) (+ (* v 10) (- (char->integer (string-ref s i)) 48)))\n          (if neg (- v) v)))))\n\n"

  scm-emit-entry : List IRDef -> Text
  scm-emit-entry (defs) = scm-emit-entry-loop defs 0

  scm-emit-entry-loop : List IRDef, Integer -> Text
  scm-emit-entry-loop (defs) (i) =
   if i >= list-length defs then ""
   else let d = list-at defs i
   in if d.name == opening-entry-point then
    if list-length (d.params) == 0 then "(" & scm-sanitize opening-entry-point & ")\n" else ""
   else scm-emit-entry-loop defs (i + 1)

