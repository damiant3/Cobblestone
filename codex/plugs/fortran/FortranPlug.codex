 Entry point for the Fortran emit-plug.

Section: Body

  opening : [Console, FileSystem] Nothing = act
   source <- read-file ""
   let parsed = parse-ir-chapter source
   in let fort-text = emit-fortran-chapter (parsed.chapter) (parsed.type-defs)
   in print-line-uni fort-text
  end

