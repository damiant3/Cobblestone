Chapter: Fortran Emitter

Section: Keywords and Sanitization

  fort-keywords : List Text
  fort-keywords = ["program", "end", "function", "subroutine", "module", "use",
   "implicit", "integer", "real", "character", "logical", "complex",
   "type", "class", "if", "then", "else", "do", "while", "cycle",
   "exit", "return", "call", "print", "write", "read", "open",
   "close", "stop", "data", "parameter", "intent", "allocatable",
   "pointer", "target", "select", "case", "where", "forall",
   "block", "associate", "contains", "result", "recursive",
   "pure", "elemental", "abstract", "interface", "operator",
   "assignment", "sequence", "private", "public", "protected",
   "double", "precision", "kind", "len", "trim", "merge"]

  fort-is-keyword : Text, Integer -> Boolean
  fort-is-keyword (name) (i) =
   if i == list-length fort-keywords then False
   else if list-at fort-keywords i == name then True
   else fort-is-keyword name (i + 1)

  fort-sanitize : Text -> Text
  fort-sanitize (name) =
   let s = text-replace name "-" "_"
   in if fort-is-keyword s 0 then s & "_v"
      else s

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division. riscv resolves the slot and
 needs it; every source plug wants the name.

  fort-slash-pos : Text, Integer, Integer -> Integer
  fort-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else fort-slash-pos f (i + 1) len

  fort-field : Text -> Text
  fort-field (f) =
   let slash = fort-slash-pos f 0 (text-length f)
   in if slash >= 0 then fort-sanitize (substring f 0 slash)
      else fort-sanitize f

  fort-escape : Text -> Text
  fort-escape (s) = text-replace s "'" "''"

  fort-indent : Integer -> Text
  fort-indent (n) = fort-indent-loop n ""

  fort-indent-loop : Integer, Text -> Text
  fort-indent-loop (n) (acc) =
   if n <= 0 then acc
   else fort-indent-loop (n - 1) (acc & "  ")

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255,
   is-proc : Boolean,
   is-effect-fn : Boolean
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0,
    is-proc = if fort-is-effectful (d.type-val) then fort-result-is-nothing (d.type-val) (list-length (d.params)) else False,
    is-effect-fn = if fort-is-effectful (d.type-val) then fort-result-is-nothing (d.type-val) (list-length (d.params)) == False else False
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

  lookup-is-proc : List ArityEntry, Text -> Boolean
  lookup-is-proc (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then False
      else let e = list-at entries pos
      in if e.name == name then e.is-proc else False

  lookup-is-effect-fn : List ArityEntry, Text -> Boolean
  lookup-is-effect-fn (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then False
      else let e = list-at entries pos
      in if e.name == name then e.is-effect-fn else False

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Emission

 A derived type carries a `cx_` prefix because a variant constructor keeps the
 ctor's own name, and `Wrap = | Wrap (Integer)` is the commonest variant shape
 there is. Fortran forbids one name being both a derived type and a function in
 the same scoping unit, so one of the two has to move; the ctor cannot, since
 the call site emits a plain name and nothing there knows a ctor from a def.
 Codex type names are capitalised, so a lowercase prefix cannot collide.

  fort-type-name : Text -> Text
  fort-type-name (n) = "cx_" & fort-sanitize n

  fort-type : CodexType -> Text
  fort-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "integer(8)"
    is RealTy (w) (m) -> "real(8)"
    is TextTy -> "character(len=256)"
    is BooleanTy -> "logical"
    is CharTy -> "integer(8)"
    is VoidTy -> "integer(8)"
    is NothingTy -> "integer(8)"
    is ProofTy -> "integer(8)"
    is PropEqTy (pl) (pr) -> "integer(8)"
    is UnitTy (n) (inner) -> "integer(8)"
    is ErrorTy -> "integer(8)"
    is FunTy (p) (fnrow) (r) -> "type(cx_fun)"
    is ListTy (elem) -> fort-type elem
    is LinkedListTy (elem) -> fort-type elem
    is TypeVar (id) -> "integer(8)"
    is ForAllTy (id) (body) -> fort-type body
    is ForAllEff (id) (body) -> fort-type body
    is LinearTy (body) -> fort-type body
    is TypeApply (body) (tyarg) -> fort-type body
    is SumTy (name) (ty-args) (ctors) -> "type(" & fort-type-name (name.value) & ")"
    is RecordTy (name) (ty-args) (fields) -> "type(" & fort-type-name (name.value) & ")"
    is ConstructedTy (name) (args) -> "type(" & fort-type-name (name.value) & ")"
    is TypeCon (name) -> "type(" & fort-type-name (name.value) & ")"
    is VectorTy (vn) (vt) -> "integer(8)"
    is VectorMaskTy (vn) -> "integer(8)"
    is EffectfulTy (effects) (sc) (ret) -> fort-type ret

  fort-return-type : CodexType, Integer -> CodexType
  fort-return-type (ty) (n) =
   if n == 0 then fort-strip-forall ty
   else when fort-strip-forall ty
    is FunTy (p) (fnrow) (r) -> fort-return-type r (n - 1)
    is otherwise -> ty

  fort-is-list : CodexType -> Boolean
  fort-is-list (ty) =
   when ty
    is ListTy (elem) -> True
    is LinkedListTy (elem) -> True
    is ForAllTy (id) (body) -> fort-is-list body
    is ForAllEff (id) (body) -> fort-is-list body
    is LinearTy (body) -> fort-is-list body
    is TypeApply (body) (tyarg) -> fort-is-list body
    is EffectfulTy (effects) (sc) (ret) -> fort-is-list ret
    is otherwise -> False

  fort-decl-in : CodexType, Text -> Text
  fort-decl-in (ty) (n) =
   if fort-is-list ty then "    " & fort-type ty & ", dimension(:), intent(in) :: " & n & "\n"
   else "    " & fort-type ty & ", intent(in) :: " & n & "\n"

  fort-decl-var : CodexType, Text -> Text
  fort-decl-var (ty) (n) =
   if fort-is-list ty then "    " & fort-type ty & ", allocatable :: " & n & "(:)\n"
   else "    " & fort-type ty & " :: " & n & "\n"

  fort-strip-forall : CodexType -> CodexType
  fort-strip-forall (ty) =
   when ty
    is ForAllTy (id) (body) -> fort-strip-forall body
    is ForAllEff (id) (body) -> fort-strip-forall body
    is LinearTy (body) -> fort-strip-forall body
    is TypeApply (body) (tyarg) -> fort-strip-forall body
    is otherwise -> ty

Section: Type Definition Emission

  emit-fort-type-defs : List ATypeDef, Integer -> Text
  emit-fort-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-fort-type-def (list-at tds i) & "\n" & emit-fort-type-defs tds (i + 1)

  emit-fort-type-def : ATypeDef -> Text
  emit-fort-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     "  type :: " & fort-type-name (name.value) & "\n" & emit-fort-record-fields fields 0 & "  end type " & fort-type-name (name.value) & "\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-fort-variant-tags ctors 0 1 & "  type :: " & fort-type-name (name.value) & "\n    integer :: tag\n" & emit-fort-variant-fields tparams ctors 0 & "  end type " & fort-type-name (name.value) & "\n"
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-fort-record-fields : List ARecordFieldDef, Integer -> Text
  emit-fort-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let fn = fort-sanitize (f.name.value)
   in (if fort-atype-is-list (f.type-expr)
        then "    " & fort-atype (f.type-expr) & ", allocatable :: " & fn & "(:)\n"
        else "    " & fort-atype (f.type-expr) & " :: " & fn & "\n")
      & emit-fort-record-fields fields (i + 1)

 A field's Fortran type comes from the field's own declaration. `fort-type`
 cannot serve here: it maps a `CodexType`, and a record field carries an
 `ATypeExpr`, which is the syntax the chapter wrote rather than the resolved
 type. The two spellings are kept in step deliberately.

  fort-atype : ATypeExpr -> Text
  fort-atype (te) =
   when te
    is ANamedType (name) (s) -> fort-atype-name (name.value)
    is AAppType (base) (args) (s) ->
     if fort-atype-base-is-list base & list-length args > 0 then fort-atype (list-at args 0) else fort-atype base
    is AFunType (p) (r) (s) -> "type(cx_fun)"
    is AEffectType (effs) (scopes) (efftail) (r) (s) -> fort-atype r
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> fort-atype b
    is ALinearType (b) (s) -> fort-atype b
    is AConstrainedType (ctcls) (ctparam) (b) (s) -> fort-atype b
    is AForallType (fav) (favt) (b) (s) -> fort-atype b
    is APropEqType (b) (peright) (s) -> fort-atype b

  fort-atype-name : Text -> Text
  fort-atype-name (n) =
   if n == "Integer" then "integer(8)"
   else if n == "Real" then "real(8)"
   else if n == "Text" then "character(len=256)"
   else if n == "Boolean" then "logical"
   else if n == "Character" then "integer(8)"
   else "type(" & fort-type-name n & ")"

  fort-atype-base-is-list : ATypeExpr -> Boolean
  fort-atype-base-is-list (te) =
   when te
    is ANamedType (name) (s) -> name.value == "List" | name.value == "LinkedList"
    is otherwise -> False

  fort-atype-is-list : ATypeExpr -> Boolean
  fort-atype-is-list (te) =
   when te
    is AAppType (base) (args) (s) -> fort-atype-base-is-list base
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> fort-atype-is-list b
    is ALinearType (b) (s) -> fort-atype-is-list b
    is AConstrainedType (ctcls) (ctparam) (b) (s) -> fort-atype-is-list b
    is otherwise -> False

 A clamping bounded field saturates at its declared band. The band lives only
 in the type definition, and a Fortran structure constructor cannot run code,
 so each record gets a `mk_` function that applies the band on the way in.
 Calling it with component keywords also makes the call order-independent: the
 IR carries a construction's values in the order the SOURCE wrote them, which
 a positional constructor would silently mis-assign.

  emit-fort-record-ctors : List ATypeDef, Integer -> Text
  emit-fort-record-ctors (tds) (i) =
   if i == list-length tds then ""
   else emit-fort-record-ctor (list-at tds i) & emit-fort-record-ctors tds (i + 1)

  emit-fort-record-ctor : ATypeDef -> Text
  emit-fort-record-ctor (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     let n = fort-sanitize (name.value)
     in "  function mk_" & n & "(" & fort-ctor-params fields 0 & ") result(r)\n"
        & fort-ctor-decls fields 0
        & "    type(" & fort-type-name (name.value) & ") :: r\n"
        & fort-ctor-assigns fields 0
        & "  end function mk_" & n & "\n\n"
    is otherwise -> ""

 A variant constructor keeps the ctor's own name rather than a `mk_` prefix,
 because that is what the call site already emits: a construction arrives as an
 apply of a plain name and nothing here knows a ctor from a def.

 Constructors go into the arity map so `fort-emit-name` knows a nullary one is a
 CALL. Fortran reads a bare `Empty` as a procedure reference and would pass the
 procedure where a `type(cx_Shape)` is wanted; the parenthesised `Empty()` is
 the call. A ctor is not an IRDef, so `build-arity-map` never saw one.

  fort-add-ctor-arities : List ATypeDef, Integer, List ArityEntry -> List ArityEntry
  fort-add-ctor-arities (tds) (i) (acc) =
   if i == list-length tds then acc
   else let acc1 = when list-at tds i
        is AVariantTypeDef (nm) (tps) (cs) (sp) -> fort-add-ctor-list cs 0 acc
        is otherwise -> acc
   in fort-add-ctor-arities tds (i + 1) acc1

  fort-add-ctor-list : List AVariantCtorDef, Integer, List ArityEntry -> List ArityEntry
  fort-add-ctor-list (cs) (i) (acc) =
   if i >= list-length cs then acc
   else let c = list-at cs i
   in fort-add-ctor-list cs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = c.name.value,
    arity = __narrow (list-length (c.fields)),
    generic-count = 0,
    is-proc = False,
    is-effect-fn = False
   }))

  emit-fort-variant-ctors : List ATypeDef, Integer -> Text
  emit-fort-variant-ctors (tds) (i) =
   if i == list-length tds then ""
   else emit-fort-variant-ctors-of (list-at tds i) & emit-fort-variant-ctors tds (i + 1)

  emit-fort-variant-ctors-of : ATypeDef -> Text
  emit-fort-variant-ctors-of (td) =
   when td
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-fort-vctor-list tparams (fort-type-name (name.value)) ctors 0
    is otherwise -> ""

  emit-fort-vctor-list : List Name, Text, List AVariantCtorDef, Integer -> Text
  emit-fort-vctor-list (tps) (tyname) (ctors) (i) =
   if i == list-length ctors then ""
   else emit-fort-vctor tps (tyname) (list-at ctors i) & emit-fort-vctor-list tps tyname ctors (i + 1)

  emit-fort-vctor : List Name, Text, AVariantCtorDef -> Text
  emit-fort-vctor (tps) (tyname) (c) =
   let cn = fort-sanitize (c.name.value)
   in let fs = c.fields
   in "  function " & cn & "(" & fort-vctor-params cn fs 0 & ") result(r)\n"
      & fort-vctor-decls tps cn fs 0
      & "    type(" & tyname & ") :: r\n"
      & "    r%tag = TAG_" & cn & "\n"
      & fort-vctor-assigns tps cn fs 0
      & "  end function " & cn & "\n\n"

  fort-vctor-params : Text, List ATypeExpr, Integer -> Text
  fort-vctor-params (ctor) (fs) (i) =
   if i == list-length fs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "a" & integer-to-text i & fort-vctor-params ctor fs (i + 1)

  fort-vctor-decls : List Name, Text, List ATypeExpr, Integer -> Text
  fort-vctor-decls (tps) (ctor) (fs) (i) =
   if i == list-length fs then ""
   else let te = list-at fs i
   in let an = "a" & integer-to-text i
   in (if fort-atype-poly-is-list tps te
        then "    " & fort-atype-poly tps te & ", dimension(:), intent(in) :: " & an & "\n"
        else "    " & fort-atype-poly tps te & ", intent(in) :: " & an & "\n")
      & fort-vctor-decls tps ctor fs (i + 1)

  fort-vctor-assigns : List Name, Text, List ATypeExpr, Integer -> Text
  fort-vctor-assigns (tps) (ctor) (fs) (i) =
   if i == list-length fs then ""
   else "    r%" & fort-vctor-comp-name ctor i & " = " & fort-clamp-expr (list-at fs i) ("a" & integer-to-text i) & "\n"
      & fort-vctor-assigns tps ctor fs (i + 1)

  fort-ctor-params : List ARecordFieldDef, Integer -> Text
  fort-ctor-params (fs) (i) =
   if i == list-length fs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & fort-sanitize ((list-at fs i).name.value) & fort-ctor-params fs (i + 1)

  fort-ctor-decls : List ARecordFieldDef, Integer -> Text
  fort-ctor-decls (fs) (i) =
   if i == list-length fs then ""
   else let f = list-at fs i
   in let fn = fort-sanitize (f.name.value)
   in (if fort-atype-is-list (f.type-expr)
        then "    " & fort-atype (f.type-expr) & ", dimension(:), intent(in) :: " & fn & "\n"
        else "    " & fort-atype (f.type-expr) & ", intent(in) :: " & fn & "\n")
      & fort-ctor-decls fs (i + 1)

  fort-ctor-assigns : List ARecordFieldDef, Integer -> Text
  fort-ctor-assigns (fs) (i) =
   if i == list-length fs then ""
   else let f = list-at fs i
   in let fn = fort-sanitize (f.name.value)
   in "    r%" & fn & " = " & fort-clamp-expr (f.type-expr) fn & "\n" & fort-ctor-assigns fs (i + 1)

  fort-clamp-expr : ATypeExpr, Text -> Text
  fort-clamp-expr (te) (v) =
   when te
    is ABoundedIntType (base) (lo) (hi) (mode) (sp) ->
     if fort-ov-clamps mode
      then "min(max(" & v & ", " & integer-to-text lo & "_8), " & integer-to-text hi & "_8)"
      else v
    is otherwise -> v

  fort-ov-clamps : OverflowMode -> Boolean
  fort-ov-clamps (m) =
   when m
    is OvClamping -> True
    is otherwise -> False

  emit-fort-variant-tags : List AVariantCtorDef, Integer, Integer -> Text
  emit-fort-variant-tags (ctors) (i) (tag) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in "  integer, parameter :: TAG_" & fort-sanitize (c.name.value) & " = " & integer-to-text tag & "\n" & emit-fort-variant-tags ctors (i + 1) (tag + 1)

 A component PER CONSTRUCTOR, not a shared `field<i>` numbered to the widest
 constructor. Standard Fortran has no union: `equivalence` cannot overlay
 derived-type components and cannot carry an allocatable, so a slot shared by
 `Circle (Integer)` and `Named (Text)` has no single legal declared type and
 whichever one is emitted mis-declares the other. Per-constructor components
 cost space in exchange for each one carrying its own type.

  fort-vctor-comp-name : Text, Integer -> Text
  fort-vctor-comp-name (ctor) (i) = fort-sanitize ctor & "_f" & integer-to-text i

 A field whose type is one of the type def's own PARAMETERS has no Fortran
 type: Fortran has no generics, and `fort-atype` would answer `type(cx_a)` for
 the parameter `a`, a derived type nothing declares. Measured 2026-08-18 on
 `plug-oracle-arith`, whose foreword tuples `Tup2` through `Tup5` are all
 parameterised, so every subject meets this. Such a field keeps the old
 `integer(8)`, which is the wrong type but a type that exists; a real answer is
 `class(*), allocatable` plus a `select type` at every read, which this emitter
 has no machinery for.

  fort-is-tparam : List Name, Text, Integer -> Boolean
  fort-is-tparam (tps) (n) (i) =
   if i >= list-length tps then False
   else if (list-at tps i).value == n then True
   else fort-is-tparam tps n (i + 1)

  fort-atype-poly : List Name, ATypeExpr -> Text
  fort-atype-poly (tps) (te) =
   when te
    is ANamedType (name) (s) -> if fort-is-tparam tps (name.value) 0 then "integer(8)" else fort-atype te
    is otherwise -> fort-atype te

  fort-atype-poly-is-list : List Name, ATypeExpr -> Boolean
  fort-atype-poly-is-list (tps) (te) =
   when te
    is ANamedType (name) (s) -> if fort-is-tparam tps (name.value) 0 then False else fort-atype-is-list te
    is otherwise -> fort-atype-is-list te

  emit-fort-variant-fields : List Name, List AVariantCtorDef, Integer -> Text
  emit-fort-variant-fields (tps) (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in emit-fort-variant-ctor-fields tps (c.name.value) (c.fields) 0 & emit-fort-variant-fields tps ctors (i + 1)

  emit-fort-variant-ctor-fields : List Name, Text, List ATypeExpr, Integer -> Text
  emit-fort-variant-ctor-fields (tps) (ctor) (fs) (i) =
   if i == list-length fs then ""
   else let te = list-at fs i
   in let cn = fort-vctor-comp-name ctor i
   in (if fort-atype-poly-is-list tps te
        then "    " & fort-atype-poly tps te & ", allocatable :: " & cn & "(:)\n"
        else "    " & fort-atype-poly tps te & " :: " & cn & "\n")
      & emit-fort-variant-ctor-fields tps ctor fs (i + 1)

Section: Lambda Lifting

 Fortran has no closures, so a lambda that is CALLED becomes a module procedure
 taking its own parameters followed by every variable it captures, and the call
 site passes the captures.

 A lambda used as a VALUE is refused instead, and the refusal is the honest
 answer rather than a missing feature. `fort-type` maps `FunTy` to `integer(8)`,
 so there is nowhere to put a procedure: a let-bound lambda emits
 `f = <procedure>` into an integer and then calls the integer, and one passed to
 a higher-order definition arrives at an `integer(8), intent(in) :: f` dummy.
 Lifting alone cannot close either; that wants `procedure(iface)` dummies plus,
 for a CAPTURING lambda, a closure record of the kind `zig` carries as
 `CxFn1`..`CxFn4`. Emitting the lifted name into those positions would compile
 to nothing legal while looking correct, which is the failure this plug already
 records for the lambda hole.

 A free name is one the lambda's own parameters do not bind, that no enclosing
 `let`, `act` bind or pattern inside the lambda binds, and that is neither a
 chapter definition nor a builtin. The arity map holds the definitions and the
 variant constructors, which is why both are excluded by one lookup.

  FortCap = record {
   fc-name : Text,
   fc-ty : CodexType
  }

  FortLam = record {
   fl-key : Integer,
   fl-params : List IRParam,
   fl-caps : List FortCap,
   fl-body : IRExpr,
   fl-ty : CodexType
  }

 The procedure NAME and the capture list are both derivable from the lambda
 node alone, which is what keeps this out of every emitter's parameter list.
 The name is the span offset. The captures are the free names of the body
 against the lambda's OWN parameters: a name bound by an enclosing `let` is
 exactly what a capture is, so the enclosing scope does not enter the question.

  fort-lam-caps-of : List IRParam, IRExpr, List ArityEntry -> List FortCap
  fort-lam-caps-of (ps) (body) (arities) =
   fort-free body (fort-param-names ps 0 []) arities []

 The key is a hash of the lambda's own emitted text, NOT its span. Measured
 2026-08-18: every `IrLambda` reaching this plug carries `sp.start.offset` of
 zero, so a span key gave all five lambdas in the probe the same name and
 emitted five procedures called `cx_lam_0`. Two structurally identical lambdas
 now share one procedure, which is correct rather than a collision, and the
 definition emitter dedupes on the same key.

  fort-hash-text : Text, Integer, Integer -> Integer
  fort-hash-text (s) (i) (h) =
   if i >= text-length s then h
   else fort-hash-text s (i + 1) (int-mod (h * 31 + char-code (char-at s i)) 1000000007)

  fort-lam-key-of : List IRParam, IRExpr, List ArityEntry -> Integer
  fort-lam-key-of (ps) (body) (arities) =
   fort-hash-text (fort-lam-params-text ps 0 & "|" & fort-emit-expr-at body arities 0) 0 7

  fort-lam-params-text : List IRParam, Integer -> Text
  fort-lam-params-text (ps) (i) =
   if i >= list-length ps then ""
   else (list-at ps i).name & "," & fort-lam-params-text ps (i + 1)

  fort-lam-name : Integer -> Text
  fort-lam-name (i) = "cx_lam_" & integer-to-text i

 A function VALUE is a `cx_fun`: an id, how many arguments it still NEEDS,
 how many slots are already filled, four slots, and the result once it is
 fully applied. One record carries all three shapes Fortran cannot express
 on its own -- a lambda that escaped its call site, a definition passed as
 an argument, and a definition applied to fewer arguments than it takes --
 because at the point of application they differ only in what is already in
 the slots.

 `cx_apply` answers a `cx_fun` rather than a value, which is what lets a
 chain be partial in the middle: it fills the next slot and hands the
 record back while `need` is above one, and dispatches on the last
 argument. `cx_val` reads the result out, and it exists because Fortran has
 no component reference on a function result, so `cx_apply(...)%val` is not
 something that can be written.

 A lambda's captures fill the slots at CONSTRUCTION and a partial
 application's arguments fill them as they arrive, so one dispatch arm per
 id serves both: it reads slots 1 to n-1 and takes the final argument
 directly.

  fort-def-fun-id : Text -> Integer
  fort-def-fun-id (n) = fort-hash-text ("def|" & n) 0 7

  fort-emit-fun-value : List IRParam, IRExpr, List ArityEntry -> Text
  fort-emit-fun-value (ps) (body) (arities) =
   if list-length ps /= 1 then "cx_fun_multiparam_unsupported(" & fort-emit-expr body arities & ")"
   else let caps = fort-lam-caps-of ps body arities
   in "cx_fun(" & integer-to-text (fort-lam-key-of ps body arities) & ", 1_8, "
      & integer-to-text (list-length caps) & "_8, (/ integer(8) :: " & fort-cap-init caps 0 & " /), 0_8)"

  fort-cap-init : List FortCap, Integer -> Text
  fort-cap-init (cs) (i) =
   if i >= 4 then ""
   else (if i > 0 then ", " else "")
        & (if i < list-length cs then fort-sanitize ((list-at cs i).fc-name) else "0_8")
        & fort-cap-init cs (i + 1)

  fort-emit-partial : Text, Integer, List IRExpr, List ArityEntry -> Text
  fort-emit-partial (n) (ar) (args) (arities) =
   "cx_fun(" & integer-to-text (fort-def-fun-id n) & ", " & integer-to-text (ar - list-length args)
   & "_8, " & integer-to-text (list-length args) & "_8, (/ integer(8) :: "
   & fort-arg-slots args arities 0 & " /), 0_8)"

  fort-arg-slots : List IRExpr, List ArityEntry, Integer -> Text
  fort-arg-slots (args) (arities) (i) =
   if i >= 4 then ""
   else (if i > 0 then ", " else "")
        & (if i < list-length args then fort-emit-expr (list-at args i) arities else "0_8")
        & fort-arg-slots args arities (i + 1)

  fort-emit-apply-dispatch : List FortLam, List IRDef, List ArityEntry -> Text
  fort-emit-apply-dispatch (ls) (ds) (arities) =
   "  recursive function cx_apply(f, a) result(cx_apply_r)\n"
   & "    type(cx_fun), intent(in) :: f\n"
   & "    integer(8), intent(in) :: a\n"
   & "    type(cx_fun) :: cx_apply_r\n"
   & "    cx_apply_r = f\n"
   & "    if (f%need > 1_8) then\n"
   & "      cx_apply_r%n = f%n + 1_8\n"
   & "      cx_apply_r%cap(int(f%n) + 1) = a\n"
   & "      cx_apply_r%need = f%need - 1_8\n"
   & "      return\n"
   & "    end if\n"
   & "    cx_apply_r%need = 0_8\n"
   & "    select case (int(f%id))\n"
   & fort-dispatch-lams ls 0
   & fort-dispatch-defs ds 0
   & "    end select\n"
   & "  end function cx_apply\n\n"
   & "  recursive function cx_val(f) result(cx_val_r)\n"
   & "    type(cx_fun), intent(in) :: f\n"
   & "    integer(8) :: cx_val_r\n"
   & "    cx_val_r = f%val\n"
   & "  end function cx_val\n\n"

  fort-dispatch-lams : List FortLam, Integer -> Text
  fort-dispatch-lams (ls) (i) =
   if i >= list-length ls then ""
   else let l = list-at ls i
   in (if fort-lam-seen-before ls (l.fl-key) i 0 then ""
       else if list-length (l.fl-params) /= 1 then ""
       else "    case (" & integer-to-text (l.fl-key) & ")\n      cx_apply_r%val = "
            & fort-lam-name (l.fl-key) & "(a" & fort-dispatch-caps (l.fl-caps) 0 & ")\n")
      & fort-dispatch-lams ls (i + 1)

  fort-dispatch-caps : List FortCap, Integer -> Text
  fort-dispatch-caps (cs) (i) =
   if i >= list-length cs then ""
   else ", f%cap(" & integer-to-text (i + 1) & ")" & fort-dispatch-caps cs (i + 1)

  fort-dispatch-defs : List IRDef, Integer -> Text
  fort-dispatch-defs (ds) (i) =
   if i >= list-length ds then ""
   else let d = list-at ds i
   in (if list-length (d.params) == 0 then ""
       else if fort-type (fort-return-type (d.type-val) (list-length (d.params))) /= "integer(8)" then ""
       else if fort-params-all-int (d.params) 0 == False then ""
       else "    case (" & integer-to-text (fort-def-fun-id (d.name)) & ")\n      cx_apply_r%val = "
            & fort-sanitize (d.name) & "(" & fort-dispatch-def-args (list-length (d.params)) 0 & ")\n")
      & fort-dispatch-defs ds (i + 1)

  fort-params-all-int : List IRParam, Integer -> Boolean
  fort-params-all-int (ps) (i) =
   if i >= list-length ps then True
   else if fort-type ((list-at ps i).type-val) /= "integer(8)" then False
   else fort-params-all-int ps (i + 1)

  fort-dispatch-def-args : Integer, Integer -> Text
  fort-dispatch-def-args (ar) (i) =
   if i >= ar then ""
   else (if i > 0 then ", " else "")
        & (if i == ar - 1 then "a" else "f%cap(" & integer-to-text (i + 1) & ")")
        & fort-dispatch-def-args ar (i + 1)

  fort-cap-has : List FortCap, Text, Integer -> Boolean
  fort-cap-has (cs) (n) (i) =
   if i >= list-length cs then False
   else if (list-at cs i).fc-name == n then True
   else fort-cap-has cs n (i + 1)

  fort-name-bound : List Text, Text, Integer -> Boolean
  fort-name-bound (bs) (n) (i) =
   if i >= list-length bs then False
   else if list-at bs i == n then True
   else fort-name-bound bs n (i + 1)

  fort-is-builtin-name : Text, Integer -> Boolean
  fort-is-builtin-name (n) (i) =
   if i >= list-length fort-builtin-names then False
   else if list-at fort-builtin-names i == n then True
   else fort-is-builtin-name n (i + 1)

  fort-free : IRExpr, List Text, List ArityEntry, List FortCap -> List FortCap
  fort-free (e) (bound) (arities) (acc) =
   when e
    is IrName (n) (ty) (sp) ->
     if fort-name-bound bound n 0 then acc
     else if lookup-arity arities n >= 0 then acc
     else if fort-is-builtin-name n 0 then acc
     else if fort-cap-has acc n 0 then acc
     else acc & [FortCap { fc-name = n, fc-ty = ty }]
    is IrBinary (op) (l) (r) (ty) (sp) -> fort-free r bound arities (fort-free l bound arities acc)
    is IrNegate (o) (ty) (sp) -> fort-free o bound arities acc
    is IrIf (c) (t) (el) (ty) (sp) -> fort-free el bound arities (fort-free t bound arities (fort-free c bound arities acc))
    is IrLet (nm) (ty) (val) (body) (sp) -> fort-free body (bound & [nm]) arities (fort-free val bound arities acc)
    is IrApply (f) (a) (ty) (sp) -> fort-free a bound arities (fort-free f bound arities acc)
    is IrLambda (ps) (body) (ty) (sp) -> fort-free body (bound & fort-param-names ps 0 []) arities acc
    is IrList (xs) (ty) (sp) -> fort-free-list xs 0 bound arities acc
    is IrMatch (scrut) (brs) (ty) (sp) -> fort-free-branches brs 0 bound arities (fort-free scrut bound arities acc)
    is IrAct (stmts) (ty) (sp) -> fort-free-act stmts 0 bound arities acc
    is IrRecord (nm) (fs) (ty) (sp) -> fort-free-fields fs 0 bound arities acc
    is IrFieldAccess (rec) (fld) (ty) (sp) -> fort-free rec bound arities acc
    is IrFieldStore (rec) (fld) (v) (ty) (sp) -> fort-free v bound arities (fort-free rec bound arities acc)
    is IrHandle (eff) (b) (cl) (ty) (sp) -> fort-free b bound arities acc
    is IrWithTimeout (s) (ef) (sc) (b) (ty) (sp) -> fort-free b bound arities acc
    is IrFork (b) (ty) (sp) -> fort-free b bound arities acc
    is IrAwait (t) (ty) (sp) -> fort-free t bound arities acc
    is otherwise -> acc

  fort-param-names : List IRParam, Integer, List Text -> List Text
  fort-param-names (ps) (i) (acc) =
   if i >= list-length ps then acc
   else fort-param-names ps (i + 1) (acc & [(list-at ps i).name])

  fort-free-list : List IRExpr, Integer, List Text, List ArityEntry, List FortCap -> List FortCap
  fort-free-list (xs) (i) (bound) (arities) (acc) =
   if i >= list-length xs then acc
   else fort-free-list xs (i + 1) bound arities (fort-free (list-at xs i) bound arities acc)

  fort-free-fields : List IRFieldVal, Integer, List Text, List ArityEntry, List FortCap -> List FortCap
  fort-free-fields (fs) (i) (bound) (arities) (acc) =
   if i >= list-length fs then acc
   else fort-free-fields fs (i + 1) bound arities (fort-free ((list-at fs i).value) bound arities acc)

  fort-free-branches : List IRBranch, Integer, List Text, List ArityEntry, List FortCap -> List FortCap
  fort-free-branches (brs) (i) (bound) (arities) (acc) =
   if i >= list-length brs then acc
   else let b = list-at brs i
   in fort-free-branches brs (i + 1) bound arities (fort-free (b.body) (bound & fort-pat-names (b.pattern) []) arities acc)

  fort-pat-names : IRPat, List Text -> List Text
  fort-pat-names (p) (acc) =
   when p
    is IrVarPat (n) (ty) (sp) -> acc & [n]
    is IrCtorPat (n) (subs) (ty) (sp) -> fort-pat-name-list subs 0 acc
    is otherwise -> acc

  fort-pat-name-list : List IRPat, Integer, List Text -> List Text
  fort-pat-name-list (subs) (i) (acc) =
   if i >= list-length subs then acc
   else fort-pat-name-list subs (i + 1) (fort-pat-names (list-at subs i) acc)

  fort-free-act : List IRActStmt, Integer, List Text, List ArityEntry, List FortCap -> List FortCap
  fort-free-act (stmts) (i) (bound) (arities) (acc) =
   if i >= list-length stmts then acc
   else when list-at stmts i
    is IrDoBind (n) (ty) (v) (sp) -> fort-free-act stmts (i + 1) (bound & [n]) arities (fort-free v bound arities acc)
    is IrDoExec (x) (sp) -> fort-free-act stmts (i + 1) bound arities (fort-free x bound arities acc)

 Collection registers a lambda before descending into its body, so a lambda
 nested in a lambda takes the higher index.

  fort-collect-lams : IRExpr, List Text, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams (e) (bound) (arities) (acc) =
   when e
    is IrLambda (ps) (body) (ty) (sp) ->
     let inner-bound = bound & fort-param-names ps 0 []
     in let caps = fort-lam-caps-of ps body arities
     in let acc1 = acc & [FortLam {
      fl-key = fort-lam-key-of ps body arities,
      fl-params = ps,
      fl-caps = caps,
      fl-body = body,
      fl-ty = ty
     }]
     in fort-collect-lams body inner-bound arities acc1
    is IrBinary (op) (l) (r) (ty) (sp) -> fort-collect-lams r bound arities (fort-collect-lams l bound arities acc)
    is IrNegate (o) (ty) (sp) -> fort-collect-lams o bound arities acc
    is IrIf (c) (t) (el) (ty) (sp) -> fort-collect-lams el bound arities (fort-collect-lams t bound arities (fort-collect-lams c bound arities acc))
    is IrLet (nm) (ty) (val) (body) (sp) -> fort-collect-lams body (bound & [nm]) arities (fort-collect-lams val bound arities acc)
    is IrApply (f) (a) (ty) (sp) -> fort-collect-lams a bound arities (fort-collect-lams f bound arities acc)
    is IrList (xs) (ty) (sp) -> fort-collect-lams-list xs 0 bound arities acc
    is IrMatch (scrut) (brs) (ty) (sp) -> fort-collect-lams-branches brs 0 bound arities (fort-collect-lams scrut bound arities acc)
    is IrAct (stmts) (ty) (sp) -> fort-collect-lams-act stmts 0 bound arities acc
    is IrRecord (nm) (fs) (ty) (sp) -> fort-collect-lams-fields fs 0 bound arities acc
    is IrFieldAccess (rec) (fld) (ty) (sp) -> fort-collect-lams rec bound arities acc
    is IrFieldStore (rec) (fld) (v) (ty) (sp) -> fort-collect-lams v bound arities (fort-collect-lams rec bound arities acc)
    is IrHandle (eff) (b) (cl) (ty) (sp) -> fort-collect-lams b bound arities acc
    is IrWithTimeout (s) (ef) (sc) (b) (ty) (sp) -> fort-collect-lams b bound arities acc
    is IrFork (b) (ty) (sp) -> fort-collect-lams b bound arities acc
    is IrAwait (t) (ty) (sp) -> fort-collect-lams t bound arities acc
    is otherwise -> acc

  fort-collect-lams-list : List IRExpr, Integer, List Text, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams-list (xs) (i) (bound) (arities) (acc) =
   if i >= list-length xs then acc
   else fort-collect-lams-list xs (i + 1) bound arities (fort-collect-lams (list-at xs i) bound arities acc)

  fort-collect-lams-fields : List IRFieldVal, Integer, List Text, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams-fields (fs) (i) (bound) (arities) (acc) =
   if i >= list-length fs then acc
   else fort-collect-lams-fields fs (i + 1) bound arities (fort-collect-lams ((list-at fs i).value) bound arities acc)

  fort-collect-lams-branches : List IRBranch, Integer, List Text, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams-branches (brs) (i) (bound) (arities) (acc) =
   if i >= list-length brs then acc
   else let b = list-at brs i
   in fort-collect-lams-branches brs (i + 1) bound arities (fort-collect-lams (b.body) (bound & fort-pat-names (b.pattern) []) arities acc)

  fort-collect-lams-act : List IRActStmt, Integer, List Text, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams-act (stmts) (i) (bound) (arities) (acc) =
   if i >= list-length stmts then acc
   else when list-at stmts i
    is IrDoBind (n) (ty) (v) (sp) -> fort-collect-lams-act stmts (i + 1) (bound & [n]) arities (fort-collect-lams v bound arities acc)
    is IrDoExec (x) (sp) -> fort-collect-lams-act stmts (i + 1) bound arities (fort-collect-lams x bound arities acc)

  fort-collect-lams-defs : List IRDef, Integer, List ArityEntry, List FortLam -> List FortLam
  fort-collect-lams-defs (ds) (i) (arities) (acc) =
   if i >= list-length ds then acc
   else let d = list-at ds i
   in fort-collect-lams-defs ds (i + 1) arities (fort-collect-lams (d.body) (fort-param-names (d.params) 0 []) arities acc)

  fort-find-lam : List FortLam, Integer, Integer -> Integer
  fort-find-lam (ls) (key) (i) =
   if i >= list-length ls then -1
   else if (list-at ls i).fl-key == key then i
   else fort-find-lam ls key (i + 1)

  fort-emit-lam-defs : List FortLam, List ArityEntry, Integer -> Text
  fort-emit-lam-defs (ls) (arities) (i) =
   if i >= list-length ls then ""
   else if fort-lam-seen-before ls (list-at ls i).fl-key i 0 then fort-emit-lam-defs ls arities (i + 1)
   else fort-emit-lam-def (list-at ls i) arities & fort-emit-lam-defs ls arities (i + 1)

  fort-lam-seen-before : List FortLam, Integer, Integer, Integer -> Boolean
  fort-lam-seen-before (ls) (key) (upto) (i) =
   if i >= upto then False
   else if (list-at ls i).fl-key == key then True
   else fort-lam-seen-before ls key upto (i + 1)

  fort-emit-lam-def : FortLam, List ArityEntry -> Text
  fort-emit-lam-def (l) (arities) =
   let nm = fort-lam-name (l.fl-key)
   in let ps = l.fl-params
   in let cs = l.fl-caps
   in let rty = fort-return-type (l.fl-ty) (list-length ps)
   in "  recursive function " & nm & "(" & fort-lam-sig ps cs 0 & ") result(" & nm & "_r)\n"
      & fort-lam-param-decls ps 0
      & fort-lam-cap-decls cs 0
      & fort-decl-var rty (nm & "_r")
      & "    " & nm & "_r = " & fort-emit-expr-at (l.fl-body) arities 0 & "\n"
      & "  end function " & nm & "\n\n"

  fort-lam-sig : List IRParam, List FortCap, Integer -> Text
  fort-lam-sig (ps) (cs) (i) =
   if i < list-length ps then (if i > 0 then ", " else "") & fort-sanitize ((list-at ps i).name) & fort-lam-sig ps cs (i + 1)
   else fort-lam-cap-args cs 0 (list-length ps)

  fort-lam-param-decls : List IRParam, Integer -> Text
  fort-lam-param-decls (ps) (i) =
   if i >= list-length ps then ""
   else let p = list-at ps i
   in "    " & fort-type (p.type-val) & ", intent(in) :: " & fort-sanitize (p.name) & "\n" & fort-lam-param-decls ps (i + 1)

  fort-lam-cap-decls : List FortCap, Integer -> Text
  fort-lam-cap-decls (cs) (i) =
   if i >= list-length cs then ""
   else let c = list-at cs i
   in "    " & fort-type (c.fc-ty) & ", intent(in) :: " & fort-sanitize (c.fc-name) & "\n" & fort-lam-cap-decls cs (i + 1)

  fort-lam-cap-args : List FortCap, Integer, Integer -> Text
  fort-lam-cap-args (cs) (i) (n) =
   if i >= list-length cs then ""
   else (if i + n > 0 then ", " else "") & fort-sanitize ((list-at cs i).fc-name) & fort-lam-cap-args cs (i + 1) n

Section: Expression Emission

  fort-emit-expr : IRExpr, List ArityEntry -> Text
  fort-emit-expr (e) (arities) = fort-emit-expr-at e arities 0

  fort-emit-expr-at : IRExpr, List ArityEntry, Integer -> Text
  fort-emit-expr-at (e) (arities) (depth) =
   if depth >= 256 then "0"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n & "_8"
    is IrNumLit (n) (sp) -> integer-to-text n & ".0d0"
    is IrTextLit (s) (sp) -> "'" & fort-escape s & "'"
    is IrBoolLit (b) (sp) -> if b then ".true." else ".false."
    is IrCharLit (n) (sp) -> integer-to-text n & "_8"
    is IrName (n) (ty) (sp) -> fort-emit-name n ty arities
    is IrBinary (op) (l) (r) (ty) (sp) -> fort-emit-binary op l r arities depth
    is IrNegate (operand) (nty) (sp) -> "(-" & fort-emit-expr-at operand arities (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "merge(" & fort-emit-expr-at t arities (depth + 1) & ", " & fort-emit-expr-at el arities (depth + 1) & ", " & fort-emit-expr-at c arities (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> fort-emit-expr-at (fort-subst-expr body name val (depth + 1)) arities (depth + 1)
    is IrApply (f) (a) (ty) (sp) -> fort-emit-apply e arities
    is IrLambda (params) (body) (ty) (sp) ->
     fort-emit-fun-value params body arities
    is IrList (elems) (ty) (sp) -> fort-emit-list elems arities (fort-type ty)
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-emit-match scrut branches arities depth
    is IrAct (stmts) (ty) (sp) -> fort-emit-act-expr stmts arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> fort-emit-expr-at body arities (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> fort-emit-expr-at body arities (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> fort-emit-record name fields arities
    is IrFieldAccess (rec) (field) (ty) (sp) -> fort-emit-expr-at rec arities (depth + 1) & "%" & fort-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "0"
    is IrFork (body) (ty) (sp) -> fort-emit-expr-at body arities (depth + 1)
    is IrAwait (task) (ty) (sp) -> fort-emit-expr-at task arities (depth + 1)
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> "0"
    is IrError (msg) (ty) (sp) -> "0"
    is otherwise -> "0"

  fort-emit-name : Text, CodexType, List ArityEntry -> Text
  fort-emit-name (n) (ty) (arities) =
   if n == "True" then ".true."
   else if n == "False" then ".false."
   else if n == "Nothing" then "0"
   else let ar = lookup-arity arities n
   in if ar == 0 then fort-sanitize n & "()"
      else if ar >= 1 then "cx_fun(" & integer-to-text (fort-def-fun-id n) & ", " & integer-to-text ar & "_8, 0_8, (/ integer(8) :: 0_8, 0_8, 0_8, 0_8 /), 0_8)"
      else fort-sanitize n

  fort-emit-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-binary (op) (l) (r) (arities) (depth) =
   when op
    is IrAppendText -> "trim(" & fort-emit-expr-at l arities (depth + 1) & ") // trim(" & fort-emit-expr-at r arities (depth + 1) & ")"
    is IrPowInt -> "(" & fort-emit-expr-at l arities (depth + 1) & " ** " & fort-emit-expr-at r arities (depth + 1) & ")"
    is IrAppendList -> "fort_list_concat(" & fort-emit-expr-at l arities (depth + 1) & ", " & fort-emit-expr-at r arities (depth + 1) & ")"
    is IrConsList -> "fort_list_cons(" & fort-emit-expr-at l arities (depth + 1) & ", " & fort-emit-expr-at r arities (depth + 1) & ")"
    is otherwise -> "(" & fort-emit-expr-at l arities (depth + 1) & " " & fort-bin-op op & " " & fort-emit-expr-at r arities (depth + 1) & ")"

  fort-bin-op : IRBinaryOp -> Text
  fort-bin-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "mod"
    is IrEq -> "=="
    is IrNotEq -> "/="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq | IrApproxEqExact -> "=="
    is IrAnd -> ".and."
    is IrOr -> ".or."
    is otherwise -> "+"

  fort-emit-record : Text, List IRFieldVal, List ArityEntry -> Text
  fort-emit-record (name) (fields) (arities) =
   "mk_" & fort-sanitize name & "(" & fort-emit-record-args fields 0 arities & ")"

  fort-emit-record-args : List IRFieldVal, Integer, List ArityEntry -> Text
  fort-emit-record-args (fields) (i) (arities) =
   if i == list-length fields then ""
   else let sep = if i > 0 then ", " else ""
   in let f = list-at fields i
   in sep & fort-field (f.name) & " = " & fort-emit-expr (f.value) arities & fort-emit-record-args fields (i + 1) arities

  fort-emit-list : List IRExpr, List ArityEntry, Text -> Text
  fort-emit-list (elems) (arities) (ety) =
   if list-length elems == 0 then "(/ " & ety & " :: /)"
   else "(/ " & ety & " :: " & fort-emit-list-elems elems 0 arities & " /)"

  fort-emit-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  fort-emit-list-elems (elems) (i) (arities) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then fort-emit-expr (list-at elems i) arities
   else fort-emit-expr (list-at elems i) arities & ", " & fort-emit-list-elems elems (i + 1) arities

  fort-emit-act-expr : List IRActStmt, List ArityEntry -> Text
  fort-emit-act-expr (stmts) (arities) =
   if list-length stmts == 0 then "0"
   else let last = list-at stmts (list-length stmts - 1)
   in when last
    is IrDoExec (e) (sp) -> fort-emit-expr e arities
    is IrDoBind (name) (ty) (val) (sp) -> fort-emit-expr val arities

  fort-emit-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  fort-emit-match (scrut) (branches) (arities) (depth) =
   if list-length branches == 0 then "0"
   else fort-emit-match-merge branches scrut arities depth 0

 A binder is substituted by the component it stands for, exactly as a guard's
 is above, because `merge` is a FUNCTION: Fortran evaluates both arms before
 selecting, and there is no statement here to assign a binder in. Emitting the
 body unsubstituted declared the name and never assigned it, so the taken arm
 read uninitialised memory. Reading a component under another tag is defined,
 every constructor's components living in the one derived type, which is what
 makes the eager arm safe once the name resolves to a component.
  fort-emit-match-merge : List IRBranch, IRExpr, List ArityEntry, Integer, Integer -> Text
  fort-emit-match-merge (branches) (scrut) (arities) (depth) (i) =
   if i >= list-length branches - 1 then fort-emit-expr-at (fort-subst-pat (list-at branches i).pattern scrut (list-at branches i).body) arities (depth + 1)
   else let b = list-at branches i
   in "merge(" & fort-emit-expr-at (fort-subst-pat (b.pattern) scrut (b.body)) arities (depth + 1) & ", " & fort-emit-match-merge branches scrut arities depth (i + 1) & ", " & fort-emit-match-cond (b.pattern) scrut arities (depth + 1) & ")"

 A branch's sub-patterns are read out of the scrutinee's per-constructor
 components before the branch body runs. Nothing did this, so every name a
 `when` bound was undeclared and unassigned, and the module carries
 `implicit none`, so the emitted Fortran did not compile at all.

  fort-emit-pat-binds : IRPat, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-pat-binds (pat) (scrut) (arities) (indent) =
   when pat
    is IrVarPat (name) (ty) (sp) ->
     fort-indent indent & fort-sanitize name & " = " & fort-emit-expr-at scrut arities 0 & "\n"
    is IrCtorPat (name) (subs) (ty) (sp) ->
     fort-emit-sub-binds name subs 0 scrut arities indent
    is otherwise -> ""

  fort-emit-sub-binds : Text, List IRPat, Integer, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-sub-binds (ctor) (subs) (i) (scrut) (arities) (indent) =
   if i >= list-length subs then ""
   else let one = when list-at subs i
        is IrVarPat (nm) (ty) (sp) ->
         fort-indent indent & fort-sanitize nm & " = " & fort-emit-expr-at scrut arities 0 & "%" & fort-vctor-comp-name ctor i & "\n"
        is otherwise -> ""
   in one & fort-emit-sub-binds ctor subs (i + 1) scrut arities indent

  fort-emit-match-cond : IRPat, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-match-cond (pat) (scrut) (arities) (depth) =
   when pat
    is IrCtorPat (name) (subs) (ty) (sp) -> fort-emit-expr-at scrut arities depth & "%tag == TAG_" & fort-sanitize name
    is IrLitPat (text) (ty) (sp) -> fort-emit-expr-at scrut arities depth & fort-lit-pat-cmp text ty
    is otherwise -> ".true."

 Fortran compares logicals with `.eqv.` and spells its literals `.true.` and
 `.false.`, and a character literal carries its quotes. An integer literal is
 already Fortran as it stands.

  fort-lit-pat-cmp : Text, CodexType -> Text
  fort-lit-pat-cmp (text) (ty) =
   when ty
    is BooleanTy -> " .eqv. " & (if text == "True" then ".true." else ".false.")
    is TextTy -> " == '" & fort-escape text & "'"
    is otherwise -> " == " & text

  fort-guard-trivial : IRExpr -> Boolean
  fort-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

 A guard rides in the arm's own condition rather than inside the arm, so a
 failed guard falls to the else that is already there. The binders it names
 are not assigned until the arm body runs, so in the condition they are
 replaced by the component they stand for. Every constructor's components
 are declared in the one derived type, so reading one under another tag is
 defined and the `.and.` needs no short-circuit guarantee.

  fort-emit-branch-cond : IRBranch, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-branch-cond (b) (scrut) (arities) (depth) =
   let base = fort-emit-match-cond (b.pattern) scrut arities depth
   in if fort-guard-trivial (b.guard) then base
      else let g = fort-emit-expr-at (fort-subst-pat (b.pattern) scrut (b.guard)) arities depth
      in if base == ".true." then "(" & g & ")"
         else base & " .and. (" & g & ")"

  fort-subst-pat : IRPat, IRExpr, IRExpr -> IRExpr
  fort-subst-pat (pat) (scrut) (e) =
   when pat
    is IrCtorPat (name) (subs) (ty) (sp) -> fort-subst-fields subs name scrut e 0
    is IrVarPat (n) (ty) (sp) -> fort-subst-expr e n scrut 0
    is otherwise -> e

  fort-subst-fields : List IRPat, Text, IRExpr, IRExpr, Integer -> IRExpr
  fort-subst-fields (subs) (ctor) (scrut) (e) (i) =
   if i >= list-length subs then e
   else fort-subst-fields subs ctor scrut (when (list-at subs i)
     is IrVarPat (n) (ty) (sp) -> fort-subst-expr e n (IrFieldAccess scrut (fort-vctor-comp-name ctor i) ty sp) 0
     is otherwise -> e) (i + 1)

  fort-subst-expr : IRExpr, Text, IRExpr, Integer -> IRExpr
  fort-subst-expr (e) (n) (rep) (depth) =
   if depth >= 256 then e
   else when e
    is IrName (m) (ty) (sp) -> if m == n then rep else e
    is IrBinary (op) (l) (r) (ty) (sp) -> IrBinary op (fort-subst-expr l n rep (depth + 1)) (fort-subst-expr r n rep (depth + 1)) ty sp
    is IrNegate (o) (nty) (sp) -> IrNegate (fort-subst-expr o n rep (depth + 1)) nty sp
    is IrIf (c) (tb) (el) (ty) (sp) -> IrIf (fort-subst-expr c n rep (depth + 1)) (fort-subst-expr tb n rep (depth + 1)) (fort-subst-expr el n rep (depth + 1)) ty sp
    is IrLet (nm) (ty) (v) (b) (sp) -> IrLet nm ty (fort-subst-expr v n rep (depth + 1)) (if nm == n then b else fort-subst-expr b n rep (depth + 1)) sp
    is IrApply (f) (a) (ty) (sp) -> IrApply (fort-subst-expr f n rep (depth + 1)) (fort-subst-expr a n rep (depth + 1)) ty sp
    is IrMatch (sc) (bs) (ty) (sp) -> IrMatch (fort-subst-expr sc n rep (depth + 1)) (fort-subst-branches bs n rep (depth + 1) 0 []) ty sp
    is IrList (xs) (ty) (sp) -> IrList (fort-subst-exprs xs n rep (depth + 1) 0 []) ty sp
    is IrFieldAccess (r) (fld) (ty) (sp) -> IrFieldAccess (fort-subst-expr r n rep (depth + 1)) fld ty sp
    is IrFieldStore (r) (fld) (v) (ty) (sp) -> IrFieldStore (fort-subst-expr r n rep (depth + 1)) fld (fort-subst-expr v n rep (depth + 1)) ty sp
    is IrHandle (eff) (b) (cs) (ty) (sp) -> IrHandle eff (fort-subst-expr b n rep (depth + 1)) cs ty sp
    is IrWithTimeout (secs) (effs) (scopes) (b) (ty) (sp) -> IrWithTimeout secs effs scopes (fort-subst-expr b n rep (depth + 1)) ty sp
    is IrFork (b) (ty) (sp) -> IrFork (fort-subst-expr b n rep (depth + 1)) ty sp
    is IrAwait (tk) (ty) (sp) -> IrAwait (fort-subst-expr tk n rep (depth + 1)) ty sp
    is otherwise -> e

  fort-subst-exprs : List IRExpr, Text, IRExpr, Integer, Integer, List IRExpr -> List IRExpr
  fort-subst-exprs (xs) (n) (rep) (depth) (i) (acc) =
   if i >= list-length xs then acc
   else fort-subst-exprs xs n rep depth (i + 1) (list-push acc (fort-subst-expr (list-at xs i) n rep depth))

  fort-subst-branches : List IRBranch, Text, IRExpr, Integer, Integer, List IRBranch -> List IRBranch
  fort-subst-branches (bs) (n) (rep) (depth) (i) (acc) =
   if i >= list-length bs then acc
   else let b = list-at bs i
   in fort-subst-branches bs n rep depth (i + 1) (list-push acc (if fort-pat-binds (b.pattern) n then b
      else IRBranch { pattern = b.pattern, body = fort-subst-expr (b.body) n rep depth, guard = fort-subst-expr (b.guard) n rep depth, span = b.span, alt-group = b.alt-group }))

  fort-pat-binds : IRPat, Text -> Boolean
  fort-pat-binds (pat) (n) =
   when pat
    is IrVarPat (m) (ty) (sp) -> m == n
    is IrCtorPat (name) (subs) (ty) (sp) -> fort-subs-bind subs n 0
    is IrVecPat (subs) (ty) (sp) -> fort-subs-bind subs n 0
    is otherwise -> False

  fort-subs-bind : List IRPat, Text, Integer -> Boolean
  fort-subs-bind (subs) (n) (i) =
   if i >= list-length subs then False
   else if fort-pat-binds (list-at subs i) n then True
   else fort-subs-bind subs n (i + 1)

  fort-emit-apply : IRExpr, List ArityEntry -> Text
  fort-emit-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) -> fort-emit-apply-name n args arities (fort-apply-wants-value e)
    is IrLambda (ps) (body) (lty) (lsp) ->
     let caps = fort-lam-caps-of ps body arities
     in fort-lam-name (fort-lam-key-of ps body arities) & "("
        & fort-emit-apply-args args arities 0
        & fort-lam-cap-args caps 0 (list-length args) & ")"
    is otherwise -> fort-emit-expr root arities & "(" & fort-emit-apply-args args arities 0 & ")"

  fort-emit-apply-name : Text, List IRExpr, List ArityEntry, Boolean -> Text
  fort-emit-apply-name (n) (args) (arities) (wants-value) =
   let fort-bi = fort-try-builtin n args arities
   in if text-length fort-bi > 0 then fort-bi
   else let ar = lookup-arity arities n
   in if ar >= 1 then (if list-length args == ar
                       then fort-sanitize n & "(" & fort-emit-apply-args args arities 0 & ")"
                       else if list-length args < ar
                       then fort-emit-partial n ar args arities
                       else fort-wrap-value (fort-emit-apply-extra (fort-sanitize n & "(" & fort-emit-apply-args-upto args ar arities 0 & ")") args ar arities) wants-value)
      else if ar < 0 then (if list-length args == 0 then fort-sanitize n
                           else fort-wrap-value (fort-emit-apply-extra (fort-sanitize n) args 0 arities) wants-value)
      else fort-sanitize n & "(" & fort-emit-apply-args args arities 0 & ")"

 Three shapes, decided by the arity map. Exactly its arity is an ordinary
 call. FEWER is a partial application, which becomes a `cx_fun` carrying
 the arguments given so far. MORE is a curried application through a
 function value: the definition consumes its own arity and each remaining
 argument goes through `cx_apply`. A head with no arity at all is a
 parameter holding a `cx_fun`, so every argument goes that way.

 `cx_apply` answers a `cx_fun`, so a chain whose own result type is a
 value is read out with `cx_val`, and one that is still a function is left
 as the record it is. The IR node's type is what decides, which is the
 only place that knows.

  fort-apply-wants-value : IRExpr -> Boolean
  fort-apply-wants-value (e) =
   when e
    is IrApply (f) (a) (ty) (sp) -> fort-type ty /= "type(cx_fun)"
    is otherwise -> True

  fort-wrap-value : Text, Boolean -> Text
  fort-wrap-value (t) (wants-value) = if wants-value then "cx_val(" & t & ")" else t

  fort-emit-apply-args-upto : List IRExpr, Integer, List ArityEntry, Integer -> Text
  fort-emit-apply-args-upto (args) (n) (arities) (i) =
   if i >= n then ""
   else (if i > 0 then ", " else "") & fort-emit-expr (list-at args i) arities & fort-emit-apply-args-upto args n arities (i + 1)

  fort-emit-apply-extra : Text, List IRExpr, Integer, List ArityEntry -> Text
  fort-emit-apply-extra (acc) (args) (i) (arities) =
   if i >= list-length args then acc
   else fort-emit-apply-extra ("cx_apply(" & acc & ", " & fort-emit-expr (list-at args i) arities & ")") args (i + 1) arities

  fort-builtin-names : List Text
  fort-builtin-names = ["abs", "await", "bit-and", "bit-not", "bit-or",
   "bit-shl", "bit-shr", "bit-xor", "char-at", "char-code",
   "char-code-at", "char-to-text", "close-file", "code-to-char",
   "file-exists", "fork", "int-mod", "integer-to-text", "is-digit",
   "is-letter", "is-whitespace", "list-at", "list-insert-at",
   "list-length", "list-set-at", "list-snoc", "max", "min", "negate",
   "open-file", "print-error-uni", "print-line-uni", "process-exit",
   "read-text", "show", "substring", "text-compare", "text-concat-list",
   "text-contains", "text-length", "text-replace", "text-split",
   "text-starts-with", "text-to-integer", "write-file", "list-push",
   "bit-shru"]

  fort-find-builtin : List Text, Text, Integer -> Integer
  fort-find-builtin (names) (target) (i) =
   if i >= list-length names then -1
   else if list-at names i == target then i
   else fort-find-builtin names target (i + 1)

  fort-try-builtin : Text, List IRExpr, List ArityEntry -> Text
  fort-try-builtin (n) (args) (arities) =
   if n == "__narrow" then fort-emit-expr (list-at args 0) arities
   else let idx = fort-find-builtin fort-builtin-names n 0
   in if idx < 0 then ""
      else fort-emit-builtin-by-idx idx n args arities

  fort-emit-builtin-by-idx : Integer, Text, List IRExpr, List ArityEntry -> Text
  fort-emit-builtin-by-idx (idx) (n) (args) (arities) =
   if idx == 0 then "abs(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 1 then fort-emit-expr (list-at args 0) arities
   else if idx == 2 then "iand(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 3 then "not(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 4 then "ior(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 5 then "ishft(" & fort-emit-expr (list-at args 0) arities & ", int(" & fort-emit-expr (list-at args 1) arities & "))"
   else if idx == 6 then "shifta(" & fort-emit-expr (list-at args 0) arities & ", int(" & fort-emit-expr (list-at args 1) arities & "))"
   else if idx == 7 then "ieor(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 8 then "fort_char_code_at(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 9 then fort-emit-expr (list-at args 0) arities
   else if idx == 10 then "fort_char_code_at(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 11 then "achar(int(" & fort-emit-expr (list-at args 0) arities & "))"
   else if idx == 12 then "fort_close_file(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 13 then fort-emit-expr (list-at args 0) arities
   else if idx == 14 then "fort_file_exists(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 15 then fort-emit-expr (list-at args 0) arities
   else if idx == 16 then "modulo(" & fort-emit-expr (list-at args 0) arities & ", abs(" & fort-emit-expr (list-at args 1) arities & "))"
   else if idx == 17 then "fort_integer_to_text(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 18 then fort-emit-bi-is-digit args arities
   else if idx == 19 then fort-emit-bi-is-letter args arities
   else if idx == 20 then "(" & fort-emit-expr (list-at args 0) arities & " >= 1_8 .and. " & fort-emit-expr (list-at args 0) arities & " <= 2_8)"
   else if idx == 21 then "fort_list_at(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 22 then "fort_list_insert_at(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ", " & fort-emit-expr (list-at args 2) arities & ")"
   else if idx == 23 then "int(size(" & fort-emit-expr (list-at args 0) arities & "), 8)"
   else if idx == 24 then "fort_list_set_at(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ", " & fort-emit-expr (list-at args 2) arities & ")"
   else if idx == 25 then "fort_list_snoc(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 26 then "max(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 27 then "min(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 28 then "(-" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 29 then "fort_open_file(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 30 then "fort_print_error(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 31 then "fort_print_line(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 32 then "fort_process_exit(" & fort-emit-exit-code args arities & ")"
   else if idx == 33 then "fort_read_file(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 34 then fort-emit-bi-show args arities
   else if idx == 35 then fort-emit-bi-substring args arities
   else if idx == 36 then "fort_text_compare(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 37 then "fort_text_concat_list(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 38 then "(index(trim(" & fort-emit-expr (list-at args 0) arities & "), trim(" & fort-emit-expr (list-at args 1) arities & ")) > 0)"
   else if idx == 39 then "int(len_trim(" & fort-emit-expr (list-at args 0) arities & "), 8)"
   else if idx == 40 then "fort_text_replace(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ", " & fort-emit-expr (list-at args 2) arities & ")"
   else if idx == 41 then "fort_text_split(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 42 then "(index(trim(" & fort-emit-expr (list-at args 0) arities & "), trim(" & fort-emit-expr (list-at args 1) arities & ")) == 1)"
   else if idx == 43 then "fort_text_to_integer(" & fort-emit-expr (list-at args 0) arities & ")"
   else if idx == 44 then "fort_write_file(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 45 then "fort_list_snoc(" & fort-emit-expr (list-at args 0) arities & ", " & fort-emit-expr (list-at args 1) arities & ")"
   else if idx == 46 then "ishft(" & fort-emit-expr (list-at args 0) arities & ", -int(" & fort-emit-expr (list-at args 1) arities & "))"
   else "cx_UNSUPPORTED_builtin('" & n & "')"

 `ishft` is Fortran's LOGICAL shift, which is what `bit-shru` means, so the
 unsigned form is the one that maps directly. `bit-shr` is arithmetic and
 wants `shifta`, which keeps the sign bit; `ishft` on a negative operand
 answers a large positive number instead.

  fort-emit-exit-code : List IRExpr, List ArityEntry -> Text
  fort-emit-exit-code (args) (arities) =
   if list-length args == 0 then "0_8" else fort-emit-expr (list-at args 0) arities

  fort-emit-bi-show : List IRExpr, List ArityEntry -> Text
  fort-emit-bi-show (args) (arities) =
   "fort_integer_to_text(" & fort-emit-expr (list-at args 0) arities & ")"

  fort-emit-bi-substring : List IRExpr, List ArityEntry -> Text
  fort-emit-bi-substring (args) (arities) =
   let a0 = fort-emit-expr (list-at args 0) arities
   in let a1 = fort-emit-expr (list-at args 1) arities
   in let a2 = fort-emit-expr (list-at args 2) arities
   in "fort_substr(" & a0 & ", " & a1 & ", " & a2 & ")"

  fort-emit-bi-is-letter : List IRExpr, List ArityEntry -> Text
  fort-emit-bi-is-letter (args) (arities) =
   let a0 = fort-emit-expr (list-at args 0) arities
   in "((" & a0 & " >= 13_8 .and. " & a0 & " <= 64_8) .or. (" & a0 & " >= 97_8 .and. " & a0 & " <= 127_8))"

  fort-emit-bi-is-digit : List IRExpr, List ArityEntry -> Text
  fort-emit-bi-is-digit (args) (arities) =
   let a0 = fort-emit-expr (list-at args 0) arities
   in "(" & a0 & " >= 3_8 .and. " & a0 & " <= 12_8)"

  fort-emit-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  fort-emit-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then fort-emit-expr (list-at args i) arities
        else fort-emit-expr (list-at args i) arities & ", " & fort-emit-apply-args args arities (i + 1)

Section: Tail Call Optimization

  fort-is-self-call : IRExpr, Text -> Boolean
  fort-is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in when (chain.root)
    is IrName (n) (ty) (sp) -> n == func-name
    is otherwise -> False

  fort-has-tail-call : IRExpr, Text -> Boolean
  fort-has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> fort-has-tail-call t func-name | fort-has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> fort-has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> fort-is-self-call e func-name
    is otherwise -> False

  fort-has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  fort-has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else if fort-has-tail-call (list-at branches i).body func-name then True
   else fort-has-tail-call-branches branches func-name (i + 1)

  fort-should-tco : IRDef -> Boolean
  fort-should-tco (d) =
   if list-length (d.params) == 0 then False
   else fort-has-tail-call (d.body) (d.name)

  fort-emit-tco-def : IRDef, List ArityEntry -> Text
  fort-emit-tco-def (d) (arities) =
   let name = fort-sanitize (d.name)
   in let ret = fort-return-type (d.type-val) (list-length (d.params))
   in let res = name & "_r"
   in "recursive function " & name & "(" & fort-emit-tco-in-params (d.params) 0 & ") result(" & res & ")\n" & fort-emit-tco-in-decls (d.params) 0 & fort-decl-var ret res & fort-emit-tco-local-decls (d.params) 0 & (if list-length (d.params) <= 1 then "" else fort-emit-tco-temp-decls (d.params) 0) & fort-emit-tco-copy-in (d.params) 0 & "    do while (.true.)\n" & fort-emit-tco-body (d.body) (d.name) res (d.params) arities & "    end do\n  end function " & name & "\n"

  fort-emit-tco-in-params : List IRParam, Integer -> Text
  fort-emit-tco-in-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in let sep = if i > 0 then ", " else ""
   in sep & fort-sanitize (p.name) & "_in" & fort-emit-tco-in-params params (i + 1)

  fort-emit-tco-in-decls : List IRParam, Integer -> Text
  fort-emit-tco-in-decls (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in fort-decl-in (p.type-val) (fort-sanitize (p.name) & "_in") & fort-emit-tco-in-decls params (i + 1)

  fort-emit-tco-local-decls : List IRParam, Integer -> Text
  fort-emit-tco-local-decls (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in fort-decl-var (p.type-val) (fort-sanitize (p.name)) & fort-emit-tco-local-decls params (i + 1)

  fort-emit-tco-copy-in : List IRParam, Integer -> Text
  fort-emit-tco-copy-in (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in "    " & fort-sanitize (p.name) & " = " & fort-sanitize (p.name) & "_in\n" & fort-emit-tco-copy-in params (i + 1)

  fort-emit-tco-body : IRExpr, Text, Text, List IRParam, List ArityEntry -> Text
  fort-emit-tco-body (e) (func-name) (res) (params) (arities) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> "      if (" & fort-emit-expr c arities & ") then\n" & fort-emit-tco-body t func-name res params arities & "      else\n" & fort-emit-tco-body el func-name res params arities & "      end if\n"
    is IrLet (name) (ty) (val) (body) (sp) -> fort-emit-tco-body body func-name res params arities
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-emit-tco-match scrut branches func-name res params arities
    is IrApply (f) (a) (rty) (sp) ->
     if fort-is-self-call e func-name then fort-emit-tco-jump e params arities
     else "      " & res & " = " & fort-emit-expr e arities & "\n      return\n"
    is otherwise -> "      " & res & " = " & fort-emit-expr e arities & "\n      return\n"

  fort-emit-tco-match : IRExpr, List IRBranch, Text, Text, List IRParam, List ArityEntry -> Text
  fort-emit-tco-match (scrut) (branches) (func-name) (res) (params) (arities) =
   if list-length branches == 0 then "      " & res & " = 0\n      return\n"
   else fort-emit-tco-match-branches branches scrut func-name res params arities 0

  fort-emit-tco-match-branches : List IRBranch, IRExpr, Text, Text, List IRParam, List ArityEntry, Integer -> Text
  fort-emit-tco-match-branches (branches) (scrut) (func-name) (res) (params) (arities) (i) =
   if i >= list-length branches then ""
   else let b = list-at branches i
   in let is-last = i == list-length branches - 1
   in if is-last then (if fort-guard-trivial (b.guard)
        then fort-emit-pat-binds (b.pattern) scrut arities 3 & fort-emit-tco-body (b.body) func-name res params arities
        else "      if (" & fort-emit-branch-cond b scrut arities 0 & ") then\n" & fort-emit-pat-binds (b.pattern) scrut arities 4 & fort-emit-tco-body (b.body) func-name res params arities & "      end if\n")
   else "      if (" & fort-emit-branch-cond b scrut arities 0 & ") then\n" & fort-emit-pat-binds (b.pattern) scrut arities 4 & fort-emit-tco-body (b.body) func-name res params arities & "      else\n" & fort-emit-tco-match-branches branches scrut func-name res params arities (i + 1) & "      end if\n"

  fort-emit-tco-jump : IRExpr, List IRParam, List ArityEntry -> Text
  fort-emit-tco-jump (e) (params) (arities) =
   let chain = collect-apply-chain e []
   in if list-length params <= 1 then fort-emit-tco-assigns (chain.args) params arities 0 & "      cycle\n"
      else fort-emit-tco-temp-set (chain.args) params arities 0 & fort-emit-tco-temp-copy (chain.args) params 0 & "      cycle\n"

  fort-emit-tco-assigns : List IRExpr, List IRParam, List ArityEntry, Integer -> Text
  fort-emit-tco-assigns (args) (params) (arities) (i) =
   if i == list-length args then ""
   else if i >= list-length params then ""
   else let p = list-at params i
   in "      " & fort-sanitize (p.name) & " = " & fort-emit-expr (list-at args i) arities & "\n" & fort-emit-tco-assigns args params arities (i + 1)

  fort-emit-tco-temp-set : List IRExpr, List IRParam, List ArityEntry, Integer -> Text
  fort-emit-tco-temp-set (args) (params) (arities) (i) =
   if i == list-length args then ""
   else if i >= list-length params then ""
   else let p = list-at params i
   in "      " & fort-sanitize (p.name) & "_t = " & fort-emit-expr (list-at args i) arities & "\n" & fort-emit-tco-temp-set args params arities (i + 1)

  fort-emit-tco-temp-copy : List IRExpr, List IRParam, Integer -> Text
  fort-emit-tco-temp-copy (args) (params) (i) =
   if i == list-length args then ""
   else if i >= list-length params then ""
   else let p = list-at params i
   in "      " & fort-sanitize (p.name) & " = " & fort-sanitize (p.name) & "_t\n" & fort-emit-tco-temp-copy args params (i + 1)

  fort-emit-tco-temp-decls : List IRParam, Integer -> Text
  fort-emit-tco-temp-decls (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in fort-decl-var (p.type-val) (fort-sanitize (p.name) & "_t") & fort-emit-tco-temp-decls params (i + 1)

Section: Definition Emission

  fort-emit-def : IRDef, List ArityEntry -> Text
  fort-emit-def (d) (arities) =
   if fort-should-tco d then "  " & fort-emit-tco-def d arities
   else fort-emit-regular-def d arities

  fort-emit-regular-def : IRDef, List ArityEntry -> Text
  fort-emit-regular-def (d) (arities) =
   let name = fort-sanitize (d.name)
   in let is-proc = if fort-is-effectful (d.type-val) then fort-result-is-nothing (d.type-val) (list-length (d.params)) else False
   in if is-proc then fort-emit-subroutine d name arities
      else fort-emit-function d name arities
        & (if fort-is-effectful (d.type-val) then fort-emit-discard-wrapper d name else "")

  fort-emit-discard-wrapper : IRDef, Text -> Text
  fort-emit-discard-wrapper (d) (name) =
   let ret = fort-return-type (d.type-val) (list-length (d.params))
   in "  subroutine " & name & "_s(" & fort-emit-param-names (d.params) 0 & ")\n"
      & fort-emit-param-decls (d.params) 0
      & fort-decl-var ret (name & "_sv")
      & "    " & name & "_sv = " & name & "(" & fort-emit-param-names (d.params) 0 & ")\n"
      & "  end subroutine " & name & "_s\n"

  fort-effect-result : CodexType -> CodexType
  fort-effect-result (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> fort-effect-result ret
    is ForAllTy (id) (body) -> fort-effect-result body
    is ForAllEff (id) (body) -> fort-effect-result body
    is LinearTy (body) -> fort-effect-result body
    is otherwise -> ty

  fort-result-is-nothing : CodexType, Integer -> Boolean
  fort-result-is-nothing (ty) (n) =
   when fort-effect-result (fort-return-type ty n)
    is NothingTy -> True
    is otherwise -> False

  fort-is-effectful : CodexType -> Boolean
  fort-is-effectful (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> True
    is FunTy (p) (fnrow) (r) -> if list-length (fnrow.labels) > 0 then True else fort-is-effectful r
    is ForAllTy (id) (body) -> fort-is-effectful body
    is ForAllEff (id) (body) -> fort-is-effectful body
    is LinearTy (body) -> fort-is-effectful body
    is TypeApply (body) (tyarg) -> fort-is-effectful body
    is otherwise -> False

  fort-emit-subroutine : IRDef, Text, List ArityEntry -> Text
  fort-emit-subroutine (d) (name) (arities) =
   "  subroutine " & name & "(" & fort-emit-param-names (d.params) 0 & ")\n" & fort-emit-param-decls (d.params) 0 & fort-emit-let-decls (d.body) (d.params) "" & fort-emit-statement (d.body) arities 2 & "  end subroutine " & name & "\n"

  fort-emit-function : IRDef, Text, List ArityEntry -> Text
  fort-emit-function (d) (name) (arities) =
   let ret = fort-return-type (d.type-val) (list-length (d.params))
   in let res = name & "_r"
   in "  recursive function " & name & "(" & fort-emit-param-names (d.params) 0 & ") result(" & res & ")\n" & fort-emit-param-decls (d.params) 0 & fort-decl-var ret res & fort-emit-let-decls (d.body) (d.params) res & fort-emit-assign (d.body) res arities 2 & "  end function " & name & "\n"

 Fortran wants every local declared before the first executable statement, so
 the `let` bindings are collected up front. The accumulator is SEEDED with the
 parameters and the result name carrying empty text, which is what stops a
 `let` that shadows one of them from emitting a second declaration of a name
 Fortran has already been given.

  LetDecl = record {
   dname : Text,
   dtext : Text
  }

  fort-emit-let-decls : IRExpr, List IRParam, Text -> Text
  fort-emit-let-decls (body) (params) (fname) =
   let seed = fort-seed-let-decls params 0 [LetDecl { dname = fname, dtext = "" }]
   in fort-let-decl-text (fort-collect-lets body seed) 0

  fort-seed-let-decls : List IRParam, Integer, List LetDecl -> List LetDecl
  fort-seed-let-decls (params) (i) (acc) =
   if i == list-length params then acc
   else fort-seed-let-decls params (i + 1) (acc & [LetDecl {
    dname = fort-sanitize ((list-at params i).name),
    dtext = ""
   }])

  fort-collect-lets : IRExpr, List LetDecl -> List LetDecl
  fort-collect-lets (e) (acc) =
   when e
    is IrLet (name) (ty) (val) (body) (sp) ->
     let acc1 = if name == "__seq" then acc
                else fort-add-let acc (fort-sanitize name) (fort-decl-var ty (fort-sanitize name))
     in fort-collect-lets body (fort-collect-lets val acc1)
    is IrIf (c) (t) (el) (ty) (sp) -> fort-collect-lets el (fort-collect-lets t acc)
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-collect-lets-branches branches acc 0
    is IrAct (stmts) (ty) (sp) -> fort-collect-lets-act stmts acc 0
    is otherwise -> acc

  fort-collect-lets-act : List IRActStmt, List LetDecl, Integer -> List LetDecl
  fort-collect-lets-act (stmts) (acc) (i) =
   if i == list-length stmts then acc
   else when list-at stmts i
    is IrDoExec (e) (sp) -> fort-collect-lets-act stmts (fort-collect-lets e acc) (i + 1)
    is IrDoBind (name) (ty) (val) (sp) ->
     fort-collect-lets-act stmts (fort-add-let (fort-collect-lets val acc) (fort-sanitize name) (fort-decl-var ty (fort-sanitize name))) (i + 1)

  fort-collect-lets-branches : List IRBranch, List LetDecl, Integer -> List LetDecl
  fort-collect-lets-branches (branches) (acc) (i) =
   if i == list-length branches then acc
   else let b = list-at branches i
   in fort-collect-lets-branches branches (fort-collect-lets (b.body) (fort-collect-pat-decls (b.pattern) acc)) (i + 1)

 A pattern-bound name needs a declaration like any other local, and `IrVarPat`
 carries its own `CodexType`, so the ctor's field types are not consulted here.

  fort-collect-pat-decls : IRPat, List LetDecl -> List LetDecl
  fort-collect-pat-decls (pat) (acc) =
   when pat
    is IrVarPat (name) (ty) (sp) -> fort-add-let acc (fort-sanitize name) (fort-decl-var ty (fort-sanitize name))
    is IrCtorPat (name) (subs) (ty) (sp) -> fort-collect-pat-decl-list subs 0 acc
    is otherwise -> acc

  fort-collect-pat-decl-list : List IRPat, Integer, List LetDecl -> List LetDecl
  fort-collect-pat-decl-list (subs) (i) (acc) =
   if i >= list-length subs then acc
   else fort-collect-pat-decl-list subs (i + 1) (fort-collect-pat-decls (list-at subs i) acc)

  fort-add-let : List LetDecl, Text, Text -> List LetDecl
  fort-add-let (acc) (name) (text) =
   if fort-has-let acc name 0 then acc
   else acc & [LetDecl { dname = name, dtext = text }]

  fort-has-let : List LetDecl, Text, Integer -> Boolean
  fort-has-let (acc) (name) (i) =
   if i == list-length acc then False
   else if (list-at acc i).dname == name then True
   else fort-has-let acc name (i + 1)

  fort-let-decl-text : List LetDecl, Integer -> Text
  fort-let-decl-text (acc) (i) =
   if i == list-length acc then ""
   else (list-at acc i).dtext & fort-let-decl-text acc (i + 1)

  fort-emit-assign : IRExpr, Text, List ArityEntry, Integer -> Text
  fort-emit-assign (e) (target) (arities) (indent) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     fort-indent indent & "if (" & fort-emit-expr c arities & ") then\n"
      & fort-emit-assign t target arities (indent + 1)
      & fort-indent indent & "else\n"
      & fort-emit-assign el target arities (indent + 1)
      & fort-indent indent & "end if\n"
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-emit-assign-match scrut branches target arities indent 0
    is IrLet (name) (ty) (val) (body) (sp) ->
     fort-emit-let-stmt name val arities indent & fort-emit-assign body target arities indent
    is IrAct (stmts) (ty) (sp) -> fort-emit-assign-act stmts target arities indent 0
    is otherwise -> fort-indent indent & target & " = " & fort-emit-expr e arities & "\n"

  fort-emit-assign-act : List IRActStmt, Text, List ArityEntry, Integer, Integer -> Text
  fort-emit-assign-act (stmts) (target) (arities) (indent) (i) =
   if list-length stmts == 0 then ""
   else if i >= list-length stmts - 1
   then when list-at stmts i
     is IrDoExec (e) (sp) -> fort-emit-assign e target arities indent
     is IrDoBind (name) (ty) (val) (sp) ->
      fort-emit-act-stmt (list-at stmts i) arities indent
       & fort-indent indent & target & " = " & fort-sanitize name & "\n"
   else fort-emit-act-stmt (list-at stmts i) arities indent
    & fort-emit-assign-act stmts target arities indent (i + 1)

 A `let` whose value is a field store is the compiler's sequencing form: the
 source wrote a store where a value was expected, and the binding it invents
 is named `__seq` and never read. Fortran has no expression that stores, so
 the store becomes a statement and the invented binding is dropped.

  fort-emit-let-stmt : Text, IRExpr, List ArityEntry, Integer -> Text
  fort-emit-let-stmt (name) (val) (arities) (indent) =
   when val
    is IrFieldStore (rec) (field) (v) (sty) (ssp) ->
     fort-indent indent & fort-emit-expr rec arities & "%" & fort-field field & " = " & fort-emit-expr v arities & "\n"
      & (if name == "__seq" then ""
         else fort-indent indent & fort-sanitize name & " = " & fort-emit-expr rec arities & "\n")
    is otherwise ->
     if name == "__seq" then fort-emit-statement val arities indent
     else fort-indent indent & fort-sanitize name & " = " & fort-emit-expr val arities & "\n"

  fort-emit-assign-match : IRExpr, List IRBranch, Text, List ArityEntry, Integer, Integer -> Text
  fort-emit-assign-match (scrut) (branches) (target) (arities) (indent) (i) =
   if list-length branches == 0 then ""
   else if i >= list-length branches - 1
   then let bl = list-at branches i
        in (if fort-guard-trivial (bl.guard)
            then fort-emit-pat-binds (bl.pattern) scrut arities indent & fort-emit-assign (bl.body) target arities indent
            else fort-indent indent & "if (" & fort-emit-branch-cond bl scrut arities 0 & ") then\n"
                 & fort-emit-pat-binds (bl.pattern) scrut arities (indent + 1)
                 & fort-emit-assign (bl.body) target arities (indent + 1)
                 & fort-indent indent & "end if\n")
   else let b = list-at branches i
   in fort-indent indent & "if (" & fort-emit-branch-cond b scrut arities 0 & ") then\n"
       & fort-emit-pat-binds (b.pattern) scrut arities (indent + 1)
       & fort-emit-assign (b.body) target arities (indent + 1)
       & fort-indent indent & "else\n"
       & fort-emit-assign-match scrut branches target arities (indent + 1) (i + 1)
       & fort-indent indent & "end if\n"

  fort-emit-param-names : List IRParam, Integer -> Text
  fort-emit-param-names (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in let sep = if i > 0 then ", " else ""
   in sep & fort-sanitize (p.name) & fort-emit-param-names params (i + 1)

  fort-emit-param-decls : List IRParam, Integer -> Text
  fort-emit-param-decls (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in fort-decl-in (p.type-val) (fort-sanitize (p.name)) & fort-emit-param-decls params (i + 1)

  fort-emit-statement : IRExpr, List ArityEntry, Integer -> Text
  fort-emit-statement (e) (arities) (indent) =
   when e
    is IrAct (stmts) (ty) (sp) -> fort-emit-act-stmts stmts arities indent 0
    is IrIf (c) (t) (el) (ty) (sp) ->
     fort-indent indent & "if (" & fort-emit-expr c arities & ") then\n"
      & fort-emit-statement t arities (indent + 1)
      & fort-indent indent & "else\n"
      & fort-emit-statement el arities (indent + 1)
      & fort-indent indent & "end if\n"
    is IrMatch (scrut) (branches) (ty) (sp) -> fort-emit-stmt-match scrut branches arities indent 0
    is IrLet (name) (ty) (val) (body) (sp) ->
     fort-emit-let-stmt name val arities indent & fort-emit-statement body arities indent
    is otherwise -> fort-indent indent & fort-emit-call-or-expr e arities & "\n"

  fort-emit-stmt-match : IRExpr, List IRBranch, List ArityEntry, Integer, Integer -> Text
  fort-emit-stmt-match (scrut) (branches) (arities) (indent) (i) =
   if list-length branches == 0 then ""
   else if i >= list-length branches - 1
   then let bl = list-at branches i
        in (if fort-guard-trivial (bl.guard)
            then fort-emit-pat-binds (bl.pattern) scrut arities indent & fort-emit-statement (bl.body) arities indent
            else fort-indent indent & "if (" & fort-emit-branch-cond bl scrut arities 0 & ") then\n"
                 & fort-emit-pat-binds (bl.pattern) scrut arities (indent + 1)
                 & fort-emit-statement (bl.body) arities (indent + 1)
                 & fort-indent indent & "end if\n")
   else let b = list-at branches i
   in fort-indent indent & "if (" & fort-emit-branch-cond b scrut arities 0 & ") then\n"
       & fort-emit-pat-binds (b.pattern) scrut arities (indent + 1)
       & fort-emit-statement (b.body) arities (indent + 1)
       & fort-indent indent & "else\n"
       & fort-emit-stmt-match scrut branches arities (indent + 1) (i + 1)
       & fort-indent indent & "end if\n"

  fort-emit-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  fort-emit-act-stmts (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in fort-emit-act-stmt s arities indent & fort-emit-act-stmts stmts arities indent (i + 1)

  fort-emit-act-stmt : IRActStmt, List ArityEntry, Integer -> Text
  fort-emit-act-stmt (s) (arities) (indent) =
   when s
    is IrDoExec (e) (sp) -> fort-emit-statement e arities indent
    is IrDoBind (name) (ty) (val) (sp) -> fort-emit-assign val (fort-sanitize name) arities indent

  fort-emit-call-or-expr : IRExpr, List ArityEntry -> Text
  fort-emit-call-or-expr (e) (arities) =
   let sb = fort-stmt-builtin-text e arities
   in if text-length sb > 0 then sb
   else if fort-stmt-is-proc-call e arities then "call " & fort-emit-expr e arities
   else let dn = fort-stmt-discard-name e arities
   in if text-length dn > 0 then "call " & dn & "(" & fort-emit-apply-args (collect-apply-chain e []).args arities 0 & ")"
   else fort-emit-expr e arities

 Fortran has no expression statement, so a call whose result is thrown away
 has no form of its own: `call` wants a subroutine and a bare call is not a
 statement. Every effectful def that RETURNS something is emitted twice, as
 the function and as a `_s` subroutine that calls it and drops the answer,
 and a statement that discards calls the second.

  fort-stmt-discard-name : IRExpr, List ArityEntry -> Text
  fort-stmt-discard-name (e) (arities) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     when (collect-apply-chain e []).root
      is IrName (n) (nty) (nsp) -> if lookup-is-effect-fn arities n then fort-sanitize n & "_s" else ""
      is otherwise -> ""
    is otherwise -> ""

  fort-stmt-builtin-text : IRExpr, List ArityEntry -> Text
  fort-stmt-builtin-text (e) (arities) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     let chain = collect-apply-chain e []
     in when chain.root
      is IrName (n) (nty) (nsp) -> fort-stmt-builtin-by-name n (chain.args) arities
      is otherwise -> ""
    is otherwise -> ""

  fort-stmt-builtin-by-name : Text, List IRExpr, List ArityEntry -> Text
  fort-stmt-builtin-by-name (n) (args) (arities) =
   if n == "process-exit" then "stop"
   else if list-length args == 0 then ""
   else if n == "print-line-uni" then "print *, trim(" & fort-emit-expr (list-at args 0) arities & ")"
   else if n == "print-error-uni" then "write(0, '(A)') trim(" & fort-emit-expr (list-at args 0) arities & ")"
   else if n == "close-file" then "close(" & fort-emit-expr (list-at args 0) arities & ")"
   else ""

  fort-stmt-is-proc-call : IRExpr, List ArityEntry -> Boolean
  fort-stmt-is-proc-call (e) (arities) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     when (collect-apply-chain e []).root
      is IrName (n) (nty) (nsp) -> lookup-is-proc arities n
      is otherwise -> False
    is IrName (n) (nty) (nsp) -> lookup-is-proc arities n
    is otherwise -> False

Section: Runtime Prelude

  fort-prelude : Text =
   "module codex_fort_prelude\n  implicit none\n  integer, parameter :: FORT_TEXT_LEN = 256\n  interface fort_list_concat\n    module procedure fort_list_concat_i, fort_list_concat_t\n  end interface\n  interface fort_list_cons\n    module procedure fort_list_cons_i, fort_list_cons_t\n  end interface\n  interface fort_list_snoc\n    module procedure fort_list_snoc_i, fort_list_snoc_t\n  end interface\n  interface fort_list_set_at\n    module procedure fort_list_set_at_i, fort_list_set_at_t\n  end interface\n  interface fort_list_insert_at\n    module procedure fort_list_insert_at_i, fort_list_insert_at_t\n  end interface\n  interface fort_list_at\n    module procedure fort_list_at_i, fort_list_at_t\n  end interface\n  type :: cx_fun\n    integer(8) :: id = 0\n    integer(8) :: need = 0\n    integer(8) :: n = 0\n    integer(8) :: cap(4) = 0\n    integer(8) :: val = 0\n  end type cx_fun\ncontains\n"
   & "  function fort_list_at_i(xs, i) result(r)\n    integer(8), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i\n    integer(8) :: r\n    r = xs(int(i) + 1)\n  end function fort_list_at_i\n"
   & "  function fort_list_at_t(xs, i) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i\n    character(len=FORT_TEXT_LEN) :: r\n    r = xs(int(i) + 1)\n  end function fort_list_at_t\n"
   & "  function fort_char_code_at(s, i) result(r)\n    character(len=*), intent(in) :: s\n    integer(8), intent(in) :: i\n    integer(8) :: r\n    r = int(ichar(s(int(i)+1:int(i)+1)), 8)\n  end function fort_char_code_at\n"
   & "  function fort_substr(s, start, count) result(r)\n    character(len=*), intent(in) :: s\n    integer(8), intent(in) :: start\n    integer(8), intent(in) :: count\n    character(len=FORT_TEXT_LEN) :: r\n    r = s(int(start)+1:int(start)+int(count))\n  end function fort_substr\n"
   & "  function fort_list_concat_i(a, b) result(r)\n    integer(8), dimension(:), intent(in) :: a, b\n    integer(8), allocatable :: r(:)\n    integer :: na, nb\n    na = size(a)\n    nb = size(b)\n    allocate(r(na + nb))\n    if (na > 0) r(1:na) = a\n    if (nb > 0) r(na+1:na+nb) = b\n  end function fort_list_concat_i\n"
   & "  function fort_list_concat_t(a, b) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: a, b\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: na, nb\n    na = size(a)\n    nb = size(b)\n    allocate(r(na + nb))\n    if (na > 0) r(1:na) = a\n    if (nb > 0) r(na+1:na+nb) = b\n  end function fort_list_concat_t\n"
   & "  function fort_list_cons_i(v, xs) result(r)\n    integer(8), intent(in) :: v\n    integer(8), dimension(:), intent(in) :: xs\n    integer(8), allocatable :: r(:)\n    integer :: n\n    n = size(xs)\n    allocate(r(n + 1))\n    r(1) = v\n    if (n > 0) r(2:n+1) = xs\n  end function fort_list_cons_i\n"
   & "  function fort_list_cons_t(v, xs) result(r)\n    character(len=*), intent(in) :: v\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: n\n    n = size(xs)\n    allocate(r(n + 1))\n    r(1) = v\n    if (n > 0) r(2:n+1) = xs\n  end function fort_list_cons_t\n"
   & "  function fort_list_snoc_i(xs, v) result(r)\n    integer(8), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: v\n    integer(8), allocatable :: r(:)\n    integer :: n\n    n = size(xs)\n    allocate(r(n + 1))\n    if (n > 0) r(1:n) = xs\n    r(n + 1) = v\n  end function fort_list_snoc_i\n"
   & "  function fort_list_snoc_t(xs, v) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    character(len=*), intent(in) :: v\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: n\n    n = size(xs)\n    allocate(r(n + 1))\n    if (n > 0) r(1:n) = xs\n    r(n + 1) = v\n  end function fort_list_snoc_t\n"
   & "  function fort_list_set_at_i(xs, i, v) result(r)\n    integer(8), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i, v\n    integer(8), allocatable :: r(:)\n    integer :: n, p\n    n = size(xs)\n    p = int(i)\n    allocate(r(n))\n    if (n > 0) r = xs\n    if (p >= 0 .and. p < n) r(p + 1) = v\n  end function fort_list_set_at_i\n"
   & "  function fort_list_set_at_t(xs, i, v) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i\n    character(len=*), intent(in) :: v\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: n, p\n    n = size(xs)\n    p = int(i)\n    allocate(r(n))\n    if (n > 0) r = xs\n    if (p >= 0 .and. p < n) r(p + 1) = v\n  end function fort_list_set_at_t\n"
   & "  function fort_list_insert_at_i(xs, i, v) result(r)\n    integer(8), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i, v\n    integer(8), allocatable :: r(:)\n    integer :: n, p\n    n = size(xs)\n    p = int(i)\n    if (p < 0) p = 0\n    if (p > n) p = n\n    allocate(r(n + 1))\n    if (p > 0) r(1:p) = xs(1:p)\n    r(p + 1) = v\n    if (p < n) r(p+2:n+1) = xs(p+1:n)\n  end function fort_list_insert_at_i\n"
   & "  function fort_list_insert_at_t(xs, i, v) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    integer(8), intent(in) :: i\n    character(len=*), intent(in) :: v\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: n, p\n    n = size(xs)\n    p = int(i)\n    if (p < 0) p = 0\n    if (p > n) p = n\n    allocate(r(n + 1))\n    if (p > 0) r(1:p) = xs(1:p)\n    r(p + 1) = v\n    if (p < n) r(p+2:n+1) = xs(p+1:n)\n  end function fort_list_insert_at_t\n"
   & "  function fort_integer_to_text(n) result(r)\n    integer(8), intent(in) :: n\n    character(len=FORT_TEXT_LEN) :: r\n    r = ''\n    write(r, '(I0)') n\n  end function fort_integer_to_text\n"
   & "  function fort_text_to_integer(s) result(r)\n    character(len=*), intent(in) :: s\n    integer(8) :: r\n    integer :: i, n, d\n    logical :: neg\n    character(len=:), allocatable :: t\n    t = trim(s)\n    n = len(t)\n    r = 0_8\n    neg = .false.\n    i = 1\n    if (n >= 1) then\n      if (t(1:1) == '-') then\n        neg = .true.\n        i = 2\n      end if\n    end if\n    do while (i <= n)\n      d = iachar(t(i:i)) - 48\n      if (d < 0 .or. d > 9) exit\n      r = r * 10_8 + int(d, 8)\n      i = i + 1\n    end do\n    if (neg) r = -r\n  end function fort_text_to_integer\n"
   & "  function fort_text_compare(a, b) result(r)\n    character(len=*), intent(in) :: a, b\n    integer(8) :: r\n    if (llt(trim(a), trim(b))) then\n      r = -1_8\n    else if (lgt(trim(a), trim(b))) then\n      r = 1_8\n    else\n      r = 0_8\n    end if\n  end function fort_text_compare\n"
   & "  function fort_text_concat_list(xs) result(r)\n    character(len=FORT_TEXT_LEN), dimension(:), intent(in) :: xs\n    character(len=FORT_TEXT_LEN) :: r\n    integer :: i, p, l\n    r = ''\n    p = 0\n    do i = 1, size(xs)\n      l = len_trim(xs(i))\n      if (l > 0 .and. p + l <= FORT_TEXT_LEN) then\n        r(p+1:p+l) = xs(i)(1:l)\n        p = p + l\n      end if\n    end do\n  end function fort_text_concat_list\n"
   & "  function fort_text_replace(s, from, to) result(r)\n    character(len=*), intent(in) :: s, from, to\n    character(len=FORT_TEXT_LEN) :: r\n    integer :: i, n, lf, lt, p\n    r = ''\n    n = len_trim(s)\n    lf = len_trim(from)\n    lt = len_trim(to)\n    if (lf == 0) then\n      r = s\n      return\n    end if\n    i = 1\n    p = 0\n    do while (i <= n)\n      if (i + lf - 1 <= n .and. p + lt <= FORT_TEXT_LEN) then\n        if (s(i:i+lf-1) == from(1:lf)) then\n          if (lt > 0) r(p+1:p+lt) = to(1:lt)\n          p = p + lt\n          i = i + lf\n          cycle\n        end if\n      end if\n      if (p + 1 <= FORT_TEXT_LEN) then\n        r(p+1:p+1) = s(i:i)\n        p = p + 1\n      end if\n      i = i + 1\n    end do\n  end function fort_text_replace\n"
   & "  function fort_text_split(s, sep) result(r)\n    character(len=*), intent(in) :: s, sep\n    character(len=FORT_TEXT_LEN), allocatable :: r(:)\n    integer :: i, n, ls, cnt, k, start\n    n = len_trim(s)\n    ls = len_trim(sep)\n    if (ls == 0) then\n      allocate(r(1))\n      r(1) = s\n      return\n    end if\n    cnt = 1\n    i = 1\n    do while (i + ls - 1 <= n)\n      if (s(i:i+ls-1) == sep(1:ls)) then\n        cnt = cnt + 1\n        i = i + ls\n      else\n        i = i + 1\n      end if\n    end do\n    allocate(r(cnt))\n    r = ''\n    k = 1\n    start = 1\n    i = 1\n    do while (i + ls - 1 <= n)\n      if (s(i:i+ls-1) == sep(1:ls)) then\n        if (i > start) r(k) = s(start:i-1)\n        k = k + 1\n        i = i + ls\n        start = i\n      else\n        i = i + 1\n      end if\n    end do\n    if (start <= n) r(k) = s(start:n)\n  end function fort_text_split\n"
   & "  function fort_file_exists(path) result(r)\n    character(len=*), intent(in) :: path\n    logical :: r\n    inquire(file=trim(path), exist=r)\n  end function fort_file_exists\n"
   & "  function fort_open_file(path) result(r)\n    character(len=*), intent(in) :: path\n    integer(8) :: r\n    integer :: u, ios\n    open(newunit=u, file=trim(path), status='old', action='read', iostat=ios)\n    if (ios /= 0) then\n      r = -1_8\n    else\n      r = int(u, 8)\n    end if\n  end function fort_open_file\n"
   & "  function fort_read_file(path) result(r)\n    character(len=*), intent(in) :: path\n    character(len=FORT_TEXT_LEN) :: r\n    character(len=FORT_TEXT_LEN) :: line\n    integer :: u, ios, p, l\n    r = ''\n    p = 0\n    open(newunit=u, file=trim(path), status='old', action='read', iostat=ios)\n    if (ios /= 0) return\n    do\n      read(u, '(A)', iostat=ios) line\n      if (ios /= 0) exit\n      l = len_trim(line)\n      if (p + l + 1 > FORT_TEXT_LEN) exit\n      if (l > 0) r(p+1:p+l) = line(1:l)\n      p = p + l\n      r(p+1:p+1) = achar(10)\n      p = p + 1\n    end do\n    close(u)\n  end function fort_read_file\n"
   & "  function fort_write_file(path, content) result(r)\n    character(len=*), intent(in) :: path, content\n    integer(8) :: r\n    integer :: u, ios\n    r = 0_8\n    open(newunit=u, file=trim(path), status='replace', action='write', iostat=ios)\n    if (ios /= 0) then\n      r = -1_8\n      return\n    end if\n    write(u, '(A)') trim(content)\n    close(u)\n  end function fort_write_file\n"
   & "  function fort_print_line(s) result(r)\n    character(len=*), intent(in) :: s\n    integer(8) :: r\n    print *, trim(s)\n    r = 0_8\n  end function fort_print_line\n"
   & "  function fort_print_error(s) result(r)\n    character(len=*), intent(in) :: s\n    integer(8) :: r\n    write(0, '(A)') trim(s)\n    r = 0_8\n  end function fort_print_error\n"
   & "  function fort_close_file(u) result(r)\n    integer(8), intent(in) :: u\n    integer(8) :: r\n    close(int(u))\n    r = 0_8\n  end function fort_close_file\n"
   & "  function fort_process_exit(code) result(r)\n    integer(8), intent(in) :: code\n    integer(8) :: r\n    r = code\n    stop\n  end function fort_process_exit\n"
   & "end module codex_fort_prelude\n"

Section: Chapter Emission

  fort-needs-module : IRChapter -> Boolean
  fort-needs-module (m) =
   if list-length (m.defs) > 1 then True
   else if list-length (m.defs) == 1 then (list-at (m.defs) 0).name /= "opening"
   else False

  fort-find-opening : List IRDef, Integer -> Integer
  fort-find-opening (defs) (i) =
   if i == list-length defs then -1
   else if (list-at defs i).name == "opening" then i
   else fort-find-opening defs (i + 1)

  fort-emit-module-defs : List IRDef, List ArityEntry, Integer, Integer -> Text
  fort-emit-module-defs (defs) (arities) (i) (opening-idx) =
   if i == list-length defs then ""
   else if i == opening-idx then fort-emit-module-defs defs arities (i + 1) opening-idx
   else fort-emit-def (list-at defs i) arities & "\n" & fort-emit-module-defs defs arities (i + 1) opening-idx

  fort-emit-opening-body : IRDef, List ArityEntry -> Text
  fort-emit-opening-body (d) (arities) =
   let is-eff = fort-is-effectful (d.type-val)
   in if is-eff then fort-emit-let-decls (d.body) (d.params) "" & fort-emit-statement (d.body) arities 1
      else "  print *, " & fort-emit-expr (d.body) arities & "\n"

  emit-fortran-chapter : IRChapter, List ATypeDef -> Text
  emit-fortran-chapter (m) (type-defs) =
   let arities = fort-add-ctor-arities type-defs 0 (build-arity-map (m.defs) 0 [])
   in let mod-name = fort-sanitize (m.name.value)
   in let has-mod = fort-needs-module m
   in let opening-idx = fort-find-opening (m.defs) 0
   in let lams = fort-collect-lams-defs (m.defs) 0 arities []
   in let mod-part = if has-mod then "module codex_" & mod-name & "\n  use codex_fort_prelude\n  implicit none\n\n" & emit-fort-type-defs type-defs 0 & "contains\n\n" & emit-fort-record-ctors type-defs 0 & emit-fort-variant-ctors type-defs 0 & fort-emit-lam-defs lams arities 0 & fort-emit-apply-dispatch lams (m.defs) arities & fort-emit-module-defs (m.defs) arities 0 opening-idx & "end module codex_" & mod-name & "\n\n" else ""
   in let use-part = if has-mod then "  use codex_" & mod-name & "\n" else ""
   in let main-body = if opening-idx >= 0 then fort-emit-opening-body (list-at (m.defs) opening-idx) arities
                      else if list-length (m.defs) == 0 then "  print *, 'All proofs verified at compile time.'\n"
                      else ""
   in fort-prelude & "\n" & mod-part & "program main_program\n" & use-part & "  use codex_fort_prelude\n  implicit none\n" & main-body & "end program main_program\n"

