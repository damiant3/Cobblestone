Chapter: HtmlPlug

 Plug entry. Reads IR text from serial input (file-mapped by
 codex-vm), runs the HTML emitter, writes output to serial.
 No networking — uses read-file-uni which reads from the serial
 ring buffer and converts CCE to Unicode.

Section: Body

  dispatch : Text -> [Console, FileSystem] Nothing
  dispatch (mode) = act
    source <- read-file-uni mode
    let parsed = parse-ir-chapter source
    in let output = emit-html-chapter (parsed.chapter) (parsed.type-defs)
    in print-line-uni output
  end

  opening : [Console, FileSystem] Nothing = act
    mode-result <- read-line
    when mode-result
      is Just (mode) -> dispatch mode
      is None -> print-line-uni "no input"
  end