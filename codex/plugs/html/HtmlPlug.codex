Chapter: HtmlPlug
  cites Foreword chapter Maybe

 Plug entry. Reads IR text from serial input (file-mapped by
 codex-vm), runs the HTML emitter, writes output to serial.
 Input is native CCE (null-terminated). Output is Unicode
 (HTML for the browser via print-line-uni).

Section: Body

  dispatch : Text -> [Console] Nothing
  dispatch (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in let output = emit-html-chapter (parsed.chapter) (parsed.meta) (parsed.type-defs)
    in print-line-uni output
  end

  opening : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch mode
      is None -> print-line-uni "no input"
  end
