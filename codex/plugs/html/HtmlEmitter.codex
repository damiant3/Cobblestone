    & "function gpu_noise_bank_then(name,seed,n,kind,steps,progress,cb){n=Number(n);kind=Number(kind);steps=Number(steps);var w=null,url=null,timer=null,pollTimer=null,done=false,id=++_noiseSeq,expected=0;\n"
