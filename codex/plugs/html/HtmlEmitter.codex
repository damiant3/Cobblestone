  emit-dom-sd : Text
  emit-dom-sd =
    "function check_sd_status(x){fetch('/api/config').then(function(r){return r.json();}).then(function(d){"
    & "var dot=dom_get('sd-dot');var lbl=dom_get('sd-label');"
    & "if(dot)dot.style.background='#4caf50';if(lbl)lbl.textContent=(d.current_model||'SD').split('.')[0].substring(0,25);"
    & "}).catch(function(){var dot=dom_get('sd-dot');var lbl=dom_get('sd-label');"
    & "if(dot)dot.style.background='#f44336';if(lbl)lbl.textContent='SD offline';});return 0;}\n"
    & "function generate_image(url,body,cid){var card=dom_get(cid);"
    & "fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:body})"
