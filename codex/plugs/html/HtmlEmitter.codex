  emit-dom-state : Text
  emit-dom-state =
    "var _st={};function state_get(k){return _st[k]!==undefined?_st[k]:0;}function state_set(k,v){_st[k]=v;return v;}function state_get_text(k){return _st[k]||'';}function state_set_text(k,v){_st[k]=v;return v;}\n"

  emit-dom-events : Text
  emit-dom-events =
    "function dom_on_click(el,cb){if(!el)return el;el.addEventListener('click',function(){cb(el.id||'')});return el}\n"
    & "function dom_on_input(el,cb){if(!el)return el;el.addEventListener('input',function(){cb(el.value||'')});return el}\n"
    & "function dom_on_key(el,cb){if(!el)return el;el.addEventListener('keydown',function(e){cb(e.key)});return el}\n"
    & "function dom_click(el){if(el)el.click();return el}\n"
    & "function audio_on_position(el,cb){if(!el)return el;var events=['timeupdate','seeked','loadedmetadata','ended'];if(el._codexPosition)events.forEach(function(n){el.removeEventListener(n,el._codexPosition)});var f=function(){if(!el.isConnected)return;var d=el.duration,t=el.currentTime;cb(BigInt(Number.isFinite(d)&&d>0&&Number.isFinite(t)?Math.round(Math.max(0,Math.min(1,t/d))*1000):0))};el._codexPosition=f;events.forEach(function(n){el.addEventListener(n,f)});f();return el}\n"
    & "function audio_seek(el,position){if(!el)return el;var d=el.duration,p=Number(position);if(Number.isFinite(d)&&d>0&&Number.isFinite(p))el.currentTime=d*Math.max(0,Math.min(1000,p))/1000;return el}\n"
    & "function canvas_pixels(el,w,h,p){w=Number(w);h=Number(h);if(!el||w<1||h<1||w*h>1048576||p.length!==w*h)return el;if(el.width!==w)el.width=w;if(el.height!==h)el.height=h;var x=el.getContext('2d'),d=x.createImageData(w,h);for(var i=0;i<p.length;i++){var v=Number(p[i]);d.data[i*4]=v>>>16&255;d.data[i*4+1]=v>>>8&255;d.data[i*4+2]=v&255;d.data[i*4+3]=255}x.putImageData(d,0,0);return el}\n"
    & "function media_seek_ms(el,ms){if(!el)return el;if(el._codexSeek)el.removeEventListener('loadedmetadata',el._codexSeek);var seek=function(){if(Number.isFinite(el.duration)&&el.duration>0)el.currentTime=Math.max(0,Math.min(el.duration,Number(ms)/1000))};if(Number.isFinite(el.duration)&&el.duration>0)seek();else{el._codexSeek=seek;el.addEventListener('loadedmetadata',seek,{once:true})}return el}\n"
    & "function media_pause(el){if(el)el.pause();return el}\n"
    & "function media_play_then(el,cb){if(!el||!el.getAttribute('src')){cb('');return 0}el.play().then(function(){cb('')},function(e){cb(String(e.message||e))});return 0}\n"

  emit-dom-reactive : Text
  emit-dom-reactive =
    "var _renderFn=null;var _renderPending=false;\n"
    & "function set_render(fn){_renderFn=fn;return 0}\n"
    & "function request_render(x){if(_renderFn&&!_renderPending){"
    & "_renderPending=true;requestAnimationFrame(function(){"
    & "_renderPending=false;_renderFn(0)})}return 0}\n"
    & "function state_set_render(k,v){_st[k]=v;request_render(0);return v}\n"
    & "function state_set_text_render(k,v){_st[k]=v;request_render(0);return v}\n"

  emit-dom-dialog : Text
  emit-dom-dialog = emit-dom-dialog-a & emit-dom-dialog-b & emit-dom-dialog-c

  emit-dom-dialog-a : Text
  emit-dom-dialog-a =
    "function _dlg(t,m,bs,inp){var d=document.createElement('dialog');"
    & "d.className='wk-dialog';"
    & "d.innerHTML='<h3>'+t+'</h3><p>'+m+'</p>';"
    & "if(inp){var i=document.createElement('input');"
    & "i.id='dlg-input';i.className='wk-input';"
    & "i.placeholder=inp;d.appendChild(i)}\n"

  emit-dom-dialog-b : Text
  emit-dom-dialog-b =
    "var r=document.createElement('div');"
    & "r.className='wk-row';r.style.gap='8px';"
    & "r.style.justifyContent='flex-end';r.style.marginTop='12px';"
    & "bs.forEach(function(b){var btn=document.createElement('button');"
    & "btn.className='wk-btn';btn.textContent=b.text;"
    & "btn.addEventListener('click',function(){d.close(b.val)});"
    & "r.appendChild(btn)});"
    & "d.appendChild(r);document.body.appendChild(d);return d}\n"

  emit-dom-dialog-c : Text
  emit-dom-dialog-c =
    "function show_alert(t,m,cb){"
    & "var d=_dlg(t,m,[{text:'OK',val:'ok'}],null);"
    & "d.addEventListener('close',function(){d.remove();cb('ok')});"
    & "d.showModal();return 0}\n"
    & "function show_confirm(t,m,cb){"
    & "var d=_dlg(t,m,[{text:'Cancel',val:'cancel'},{text:'OK',val:'ok'}],null);"
    & "d.addEventListener('close',function(){d.remove();"
    & "cb(d.returnValue||'cancel')});d.showModal();return 0}\n"
    & "function show_prompt(t,m,p,cb){"
    & "var d=_dlg(t,m,[{text:'Cancel',val:'cancel'},{text:'OK',val:'ok'}],p);"
    & "d.addEventListener('close',function(){"
    & "var v=d.returnValue==='ok'?(d.querySelector('#dlg-input')||{}).value||'':'';"
    & "d.remove();cb(v)});d.showModal();return 0}\n"
    & "function close_dialog(x){var d=document.querySelector('dialog[open]');"
    & "if(d)d.close();return 0}\n"

  emit-dom-a11y : Text
  emit-dom-a11y =
    "function dom_set_aria(el,k,v){if(!el)return el;el.setAttribute('aria-'+k,v);return el}\n"
