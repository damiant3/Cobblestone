    & "var rn={RoleButton:'button',RoleTextbox:'textbox',RoleCheckbox:'checkbox',RoleRadio:'radio',RoleSlider:'slider',RoleMenu:'menu',RoleMenuItem:'menuitem',RoleDialog:'dialog',RoleAlert:'alert',RoleStatus:'status',RoleHeading:'heading',RoleList:'list',RoleListItem:'listitem',RoleLink:'link',RoleImage:'img'}[t];"
    & "if(rn)e.setAttribute('role',rn);if(t==='RoleHeading')e.setAttribute('aria-level',String(r._0));"
    & "if(a.ai_label)e.setAttribute('aria-label',a.ai_label);if(a.ai_description)e.setAttribute('aria-description',a.ai_description);"
    & "var lv=a.ai_live&&a.ai_live._tag;if(lv==='LivePolite')e.setAttribute('aria-live','polite');if(lv==='LiveAssertive')e.setAttribute('aria-live','assertive');"
    & "if(Number(a.ai_tab_index)>0)e.setAttribute('tabindex',String(a.ai_tab_index));if(a.ai_hidden)e.setAttribute('aria-hidden','true');"
    & "var x=a.ai_expanded;if(x&&x._tag==='Just')e.setAttribute('aria-expanded',x._0?'true':'false');"
    & "var c=a.ai_checked;if(c&&c._tag==='Just')e.setAttribute('aria-checked',c._0?'true':'false');"
    & "if(t==='RoleSlider'){e.setAttribute('aria-valuenow',String(a.ai_value_now));e.setAttribute('aria-valuemin',String(a.ai_value_min));e.setAttribute('aria-valuemax',String(a.ai_value_max))}return 0}\n"

  emit-dom-anim : Text
  emit-dom-anim = emit-dom-anim-setup & emit-dom-anim-fns

  emit-dom-anim-setup : Text
  emit-dom-anim-setup =
    "var _animCSS=false;function _ensureAnim(){if(_animCSS)return;"
    & "_animCSS=true;var s=document.createElement('style');"
    & "s.textContent='@keyframes wk-spin{to{transform:rotate(360deg)}}"
    & "@keyframes wk-pulse{0%,100%{opacity:1}50%{opacity:.4}}"
    & "@keyframes wk-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}';"
    & "document.head.appendChild(s)}\n"

  emit-dom-anim-fns : Text
  emit-dom-anim-fns =
    "function css_animate_spin(el,ms){_ensureAnim();"
    & "el.style.animation='wk-spin '+ms+'ms linear infinite';return el}\n"
    & "function css_animate_pulse(el,ms){_ensureAnim();"
    & "el.style.animation='wk-pulse '+ms+'ms ease-in-out infinite';return el}\n"
    & "function css_animate_bounce(el,ms){_ensureAnim();"
    & "el.style.animation='wk-bounce '+ms+'ms ease-in-out infinite';return el}\n"
    & "function css_transition(el,prop,ms){"
    & "el.style.transition=prop+' '+ms+'ms ease';return el}\n"

  emit-dom-persist : Text
  emit-dom-persist = emit-dom-persist-theme & emit-dom-persist-layout

  emit-dom-persist-theme : Text
  emit-dom-persist-theme =
    "function save_theme(n,th){try{localStorage.setItem('codex-theme-'+n,JSON.stringify(th))}catch(e){}return 0}\n"
    & "function load_theme(n){try{var s=localStorage.getItem('codex-theme-'+n);return s?JSON.parse(s):null}catch(e){return null}}\n"

  emit-dom-persist-layout : Text
  emit-dom-persist-layout =
