    & "if(img&&d.url){img.src=d.url;var hero=dom_get('hero-img');"
    & "if(hero){hero.src=d.url;hero.style.display='';var em=dom_get('hero-empty');if(em)em.style.display='none';}}"
    & "var sp=card.querySelector('.sp');if(sp)sp.style.display='none';}}).catch(function(){"
    & "if(card){var sp=card.querySelector('.sp');if(sp)sp.style.display='none';}});return 0;}\n"

  emit-dom-theme : Text
