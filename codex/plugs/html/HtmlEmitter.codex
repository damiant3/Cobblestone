    "function _c(n){n=Number(n);var r=(n>>16)&255,g=(n>>8)&255,b=n&255;return'#'+((1<<24)|(r<<16)|(g<<8)|b).toString(16).slice(1);}\n"
    & "function int_to_css_color(n){return _c(n);}\n"
    & "function _wsx(ws){var bs=[],bg='';var sh=ws.ws_shadow;if(sh&&sh.sh_enabled)bs.push(sh.sh_offset_x+'px '+sh.sh_offset_y+'px '+sh.sh_blur+'px '+_c(sh.sh_color));\n"
    & "var ab=ws.ws_accent_border;if(ab&&ab.ab_enabled&&ab.ab_width>0){var w=ab.ab_width,d=[[0,w],[-w,0],[0,-w]][Number(ab.ab_side)]||[w,0];bs.push('inset '+d[0]+'px '+d[1]+'px 0 0 '+_c(ab.ab_color));}\n"
    & "var gr=ws.ws_gradient;if(gr&&gr.gr_enabled)bg='linear-gradient('+(gr.gr_vertical?'to bottom':'to right')+','+_c(gr.gr_start_color)+','+_c(gr.gr_end_color)+')';return{bs:bs.join(','),bg:bg};}\n"
    & "function _ws(ws,sel){var s=sel+'{';if(ws.ws_bg)s+='background:'+_c(ws.ws_bg)+';';\n"
    & "if(ws.ws_fg)s+='color:'+_c(ws.ws_fg)+';';\n"
    & "var p=ws.ws_padding;if(p)s+='padding:'+p.edge_top+'px '+p.edge_right+'px '+p.edge_bottom+'px '+p.edge_left+'px;';\n"
    & "var m=ws.ws_margin;if(m)s+='margin:'+m.edge_top+'px '+m.edge_right+'px '+m.edge_bottom+'px '+m.edge_left+'px;';\n"
    & "var b=ws.ws_border;if(b&&b.bdr_top&&b.bdr_top.brd_width>0){\n"
    & "s+='border:'+b.bdr_top.brd_width+'px solid '+_c(b.bdr_top.brd_color)+';';\n"
    & "if(b.bdr_corner){if(b.bdr_corner._tag==='CornerRound')s+='border-radius:'+b.bdr_corner._0+'px;';\n"
    & "if(b.bdr_corner._tag==='CornerBevel')s+='border-radius:0;';}}\n"
    & "if(ws.ws_min_width>0)s+='min-width:'+ws.ws_min_width+'px;';\n"
    & "if(ws.ws_min_height>0)s+='min-height:'+ws.ws_min_height+'px;';var x=_wsx(ws);if(x.bg)s+='background:'+x.bg+';';if(x.bs)s+='box-shadow:'+x.bs+';';return s+'}';}\n"
    & "function _ss(ss,base){var s=_ws(ss.ss_normal,base);\n"
    & "s+=_ws(ss.ss_hover,base+':hover');s+=_ws(ss.ss_pressed,base+':active');\n"
    & "s+=_ws(ss.ss_disabled,base+':disabled');s+=_ws(ss.ss_focused,base+':focus');return s;}\n"
    & "function theme_to_css(th){var p=th.th_palette;var s=':root{';\n"
    & "s+='--bg:'+_c(p.pal_bg)+';--fg:'+_c(p.pal_fg)+';';\n"
    & "s+='--primary:'+_c(p.pal_primary)+';--secondary:'+_c(p.pal_secondary)+';';\n"
    & "s+='--accent:'+_c(p.pal_accent)+';--muted:'+_c(p.pal_muted)+';';\n"
    & "s+='--error:'+_c(p.pal_error)+';--success:'+_c(p.pal_success)+';';\n"
    & "s+='--warning:'+_c(p.pal_warning)+';--border:'+_c(p.pal_border)+';}';\n"
    & "s+='*{margin:0;padding:0;box-sizing:border-box}';\n"
    & "s+='body{background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}';\n"
    & "s+=_ss(th.th_panel,'.wk-panel');s+=_ss(th.th_button,'.wk-btn');\n"
    & "s+=_ss(th.th_label,'.wk-label');s+=_ss(th.th_input,'.wk-input');\n"
    & "s+=_ss(th.th_gauge,'.wk-gauge');s+=_ss(th.th_separator,'.wk-sep');\n"
    & "s+='.wk-row{display:flex;flex-direction:row}.wk-col{display:flex;flex-direction:column}';\n"
    & "return s;}\n"
    & "function inject_theme_css(th){var s=document.createElement('style');\n"
    & "s.textContent=theme_to_css(th);document.head.appendChild(s);return 0;}\n"

  emit-dom-widget : Text
  emit-dom-widget = emit-dom-widget-style & emit-dom-widget-create & emit-dom-widget-dim & emit-dom-widget-custom & emit-dom-widget-mount

  emit-dom-widget-dim : Text
  emit-dom-widget-dim =
    "function _wkDim(n,dim,sel){var k=n.wn_kind,tag=(k&&k._0)||'',ch=n.wn_children||[];"
    & "function lbl(i){var c=ch[i];if(!c)return '';var kk=c.wn_kind;return (kk&&kk._0!==undefined&&kk._0!==null)?kk._0:'';}"
    & "if(tag==='opt'){var p=document.createElement('span');var idx=n.wn_data;p.className=(idx===sel?'pip active':'pip');p.textContent=lbl(0);p.onclick=function(){if(_wkOnPick)_wkOnPick(dim,idx)};return p;}"
    & "if(tag==='optc'){var p=document.createElement('span');var idx=n.wn_data;p.className=(idx===sel?'pip active':'pip');p.textContent=lbl(0);p.style.borderLeft='4px solid '+lbl(1);p.onclick=function(){if(_wkOnPick)_wkOnPick(dim,idx)};return p;}"
    & "if(tag==='cat'){var w=document.createElement('div');w.className='cat';"
    & "var h=document.createElement('span');h.className='pip catpip';h.textContent=lbl(0);w.appendChild(h);"
    & "var pop=document.createElement('div');pop.className='catpop';"
    & "for(var i=1;i<ch.length;i++)pop.appendChild(_wkDim(ch[i],dim,sel));"
    & "w.appendChild(pop);return w;}"
    & "return document.createElement('span');}\n"

  emit-dom-widget-style : Text
  emit-dom-widget-style =
    "var _wkTheme=null,_wkOnPick=null,_wkOnClick=null,_wkOnInput=null;\n"
    & "function register_handlers(p,c){_wkOnPick=p;_wkOnClick=c;return 0}\n"
    & "function register_input_handler(f){_wkOnInput=f;return 0}\n"
    & "function _wkStyle(ws,el){if(!ws)return;"
    & "if(ws.ws_bg)el.style.background=_c(ws.ws_bg);var x=_wsx(ws);if(x.bg)el.style.background=x.bg;if(x.bs)el.style.boxShadow=x.bs;"
    & "if(ws.ws_fg)el.style.color=_c(ws.ws_fg);"
    & "var p=ws.ws_padding;if(p&&(p.edge_top||p.edge_right||p.edge_bottom||p.edge_left))"
    & "el.style.padding=p.edge_top+'px '+p.edge_right+'px '+p.edge_bottom+'px '+p.edge_left+'px';"
    & "var m=ws.ws_margin;if(m&&(m.edge_top||m.edge_right||m.edge_bottom||m.edge_left))"
    & "el.style.margin=m.edge_top+'px '+m.edge_right+'px '+m.edge_bottom+'px '+m.edge_left+'px';"
    & "var b=ws.ws_border;if(b&&b.bdr_top&&b.bdr_top.brd_width>0){"
    & "el.style.border=b.bdr_top.brd_width+'px solid '+_c(b.bdr_top.brd_color);"
    & "if(b.bdr_corner&&b.bdr_corner._tag==='CornerRound')el.style.borderRadius=b.bdr_corner._0+'px'}"
    & "if(ws.ws_min_width>0)el.style.minWidth=ws.ws_min_width+'px';"
    & "if(ws.ws_min_height>0)el.style.minHeight=ws.ws_min_height+'px'}\n"
    & "function _wkSS(tag,state){if(!_wkTheme||tag==='WkStack')return null;"
    & "var ss=tag==='WkPanel'?_wkTheme.th_panel:tag==='WkLabel'?_wkTheme.th_label:"
    & "tag==='WkButton'?_wkTheme.th_button:tag==='WkInput'?_wkTheme.th_input:"
    & "tag==='WkGauge'?_wkTheme.th_gauge:tag==='WkSeparator'?_wkTheme.th_separator:_wkTheme.th_panel;"
    & "if(!ss||tag==='WkScroll')return null;"
    & "return state===1?ss.ss_hover:state===2?ss.ss_pressed:"
    & "state===3?ss.ss_disabled:state===4?ss.ss_focused:ss.ss_normal}\n"
    & "function _wkStateOf(n){var f=Number(n.wn_flags||0);return f&16?3:f&4?2:f&2?1:f&1?4:0}\n"

  emit-dom-widget-create : Text
  emit-dom-widget-create =
    "function _wk(n){var k=n.wn_kind,el;"
    & "if(k._tag==='WkCustom')return _wkCustom(n,k._0||'');"
    & "if(k._tag==='WkPanel'||k._tag==='WkStack'||k._tag==='WkScroll')el=document.createElement('div');"
    & "else if(k._tag==='WkLabel'){el=document.createElement('span');if(k._0&&k._0.indexOf('&')>=0)el.innerHTML=k._0;else el.textContent=k._0}"
    & "else if(k._tag==='WkButton'){el=document.createElement('button');if(k._0&&k._0.indexOf('&')>=0)el.innerHTML=k._0;else el.textContent=k._0}"
    & "else if(k._tag==='WkInput'){el=document.createElement('input');el.value=k._0}"
    & "else if(k._tag==='WkGauge'){el=document.createElement('progress');el.value=Number(k._0);el.max=Number(k._1)}"
    & "else if(k._tag==='WkSeparator')el=document.createElement('hr');"
    & "else{el=document.createElement('div');el.dataset.custom=k._0||''}"
    & "if(n.wn_id)el.id=n.wn_id;"
    & "if(k._tag==='WkButton')el.addEventListener('click',function(e){e.stopPropagation();if(_wkOnClick)_wkOnClick(n.wn_id||'')});"
    & "if(k._tag==='WkInput')el.addEventListener('input',function(){if(_wkOnInput)_wkOnInput(n.wn_id||'',el.value)});"
    & "var t=k._tag;el.classList.add('wk-'+(t==='WkStack'?'stack':t==='WkScroll'?'scroll':t==='WkPanel'?'panel':t==='WkLabel'?'label':"
    & "t==='WkButton'?'btn':t==='WkInput'?'input':t==='WkGauge'?'gauge':t==='WkSeparator'?'sep':'panel'));"
    & "var d=n.wn_layout_dir;if(d){if(d._tag==='DirRow')el.classList.add('wk-row');"
    & "if(d._tag==='DirColumn')el.classList.add('wk-col')}"
    & "if(n.wn_gap>0)el.style.gap=n.wn_gap+'px';"
    & "el.style.flex=n.wn_flex>0?n.wn_flex+' 1 0px':'0 0 auto';"
    & "var st=_wkStateOf(n);"
    & "if(st===3&&el.disabled!==undefined)el.disabled=true;"
    & "var ws=_wkSS(t,st);if(ws)_wkStyle(ws,el);"
    & "el.style.boxSizing='border-box';"
    & "el.style.minWidth=Math.max(Number(n.wn_min_w||0),Number(ws&&ws.ws_min_width||0))+'px';"
    & "el.style.minHeight=Math.max(Number(n.wn_min_h||0),Number(ws&&ws.ws_min_height||0))+'px';"
    & "if(n.wn_max_w>0)el.style.maxWidth=n.wn_max_w+'px';if(n.wn_max_h>0)el.style.maxHeight=n.wn_max_h+'px';"
    & "var ch=n.wn_children||[];"
    & "for(var i=0;i<ch.length;i++){var ce=el.appendChild(_wk(ch[i]));if(t==='WkScroll')ce.style.flexShrink='0'}"
    & "if(t==='WkScroll'){el.style.overflow='hidden';el.dataset.wkScroll=String(k._0||0)}"
    & "return el}\n"
    & "function _wkScrollFix(r){var vs=r.querySelectorAll('[data-wk-scroll]');for(var i=0;i<vs.length;i++){var v=vs[i],o=Number(v.dataset.wkScroll);"
    & "if(v.classList.contains('wk-row'))v.scrollLeft=o;else v.scrollTop=o}return 0}\n"

  emit-dom-widget-custom : Text
  emit-dom-widget-custom =
    "function _wkCustom(n,tag){"
    & "var id=n.wn_id||'',st=n.wn_data||0,ch=n.wn_children||[];"
    & "function lbl(i){var c=ch[i];if(!c)return '';var kk=c.wn_kind;return (kk&&kk._0!==undefined&&kk._0!==null)?kk._0:'';}"
    & "if(tag.indexOf('box:')===0){var el=document.createElement('div');var cls=tag.slice(4);if(cls)el.className=cls;if(id)el.id=id;for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}"
    & "if(tag.indexOf('boxc:')===0){var el=document.createElement('div');var cls=tag.slice(5);if(cls)el.className=cls;if(id)el.id=id;el.style.cursor='pointer';el.addEventListener('click',function(e){e.stopPropagation();if(_wkOnClick)_wkOnClick(id)});for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}"
     & "if(tag.indexOf('link:')===0){var el=document.createElement('a');var rest=tag.slice(5);var bar=rest.indexOf('|');var cls='',hr=rest;if(bar>=0){cls=rest.slice(0,bar);hr=rest.slice(bar+1);}el.href=hr;if(cls)el.className=cls;if(id)el.id=id;for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}"
    & "if(tag==='h1'){var h=document.createElement('h1');h.textContent=lbl(0);return h;}"
    & "if(tag==='nav'){var nv=document.createElement('nav');nv.className='nv';"
    & "var pages=[['/item','item','Items'],['/character','character','Characters'],['/setting','setting','Settings'],['/card','card','Cards'],['/mine','mine','My Creations']];"
    & "for(var i=0;i<pages.length;i++){var a=document.createElement('a');a.href=pages[i][0];a.textContent=pages[i][2];if(id===pages[i][1])a.className='active';nv.appendChild(a);}"
    & "var sp=document.createElement('span');sp.style.flex='1';nv.appendChild(sp);"
    & "var sd=document.createElement('span');sd.className='sd';var dot=document.createElement('span');dot.id='sd-dot';dot.className='dot';"
    & "var lab=document.createElement('span');lab.id='sd-label';lab.textContent='checking...';"
    & "sd.appendChild(dot);sd.appendChild(document.createTextNode(' '));sd.appendChild(lab);nv.appendChild(sd);return nv;}"
    & "if(tag==='dim-picker'){var w=document.createElement('div');w.className='dim';"
    & "var pill=document.createElement('div');pill.className='dim-pill';pill.textContent=lbl(st)||'?';"
    & "var dd=document.createElement('div');dd.className='dd';"
    & "for(var i=0;i<ch.length;i++){(function(ix){var it=document.createElement('div');it.className=ix===st?'dd-item active':'dd-item';it.textContent=lbl(ix);it.onclick=function(){if(_wkOnPick)_wkOnPick(id,ix)};dd.appendChild(it);})(i);}"
    & "w.appendChild(pill);w.appendChild(dd);return w;}"
    & "if(tag==='prompt-field'){var w=document.createElement('div');w.className='prow';"
    & "var ta=document.createElement('textarea');ta.id='prompt';ta.placeholder=lbl(0);"
    & "var pc=document.createElement('div');pc.className='pc';var la=document.createElement('label');la.textContent='Seed';"
    & "var inp=document.createElement('input');inp.id='seed';inp.type='number';inp.value=st;"
    & "pc.appendChild(la);pc.appendChild(inp);w.appendChild(ta);w.appendChild(pc);return w;}"
    & "if(tag==='toolbar'){var w=document.createElement('div');w.className='tb';"
    & "for(var i=0;i<ch.length;i++){(function(c){var b=document.createElement('button');var kk=c.wn_kind;b.textContent=(kk&&kk._0)||'';b.className=_wkStateOf(c)===2?'btn primary':'btn';var bid=c.wn_id||'';b.onclick=function(){if(_wkOnClick)_wkOnClick(bid)};w.appendChild(b);})(ch[i]);}"
    & "return w;}"
    & "if(tag==='hero'){var w=document.createElement('div');w.className='hero';w.id='hero';"
    & "var img=document.createElement('img');img.id='hero-img';img.style.display='none';"
    & "img.onclick=function(){if(this.src&&this.src.indexOf('data:')<0){var lb=document.getElementById('lb');if(lb){lb.classList.add('on');var li=document.getElementById('lb-img');if(li)li.src=this.src;}}};"
    & "var emp=document.createElement('div');emp.className='he';emp.id='hero-empty';emp.textContent=lbl(0);"
    & "var meta=document.createElement('div');meta.id='hero-meta';meta.className='hm';"
    & "w.appendChild(img);w.appendChild(emp);w.appendChild(meta);return w;}"
    & "if(tag==='history'){var w=document.createElement('div');w.className='hist';"
    & "var h=document.createElement('h3');h.textContent='History';var hd=document.createElement('div');hd.id='history';"
    & "w.appendChild(h);w.appendChild(hd);return w;}"
    & "if(tag==='lightbox'){var w=document.createElement('div');w.className='lb';w.id='lb';"
    & "w.onclick=function(){this.classList.remove('on')};"
    & "var x=document.createElement('span');x.className='x';x.innerHTML='&times;';var img=document.createElement('img');img.id='lb-img';"
    & "w.appendChild(x);w.appendChild(img);return w;}"
    & "if(tag==='dimsel'){var w=document.createElement('span');w.className='dimw';"
    & "var hd=document.createElement('span');hd.className='pip head';hd.textContent=lbl(0);w.appendChild(hd);"
    & "var pop=document.createElement('div');pop.className='pop';"
    & "var f=(ch[1]&&ch[1].wn_kind&&ch[1].wn_kind._0)||'';pop.classList.add(f==='cat'?'pop-col':'pop-wrap');"
    & "for(var i=1;i<ch.length;i++)pop.appendChild(_wkDim(ch[i],id,st));"
    & "w.appendChild(pop);return w;}"
    & "if(tag==='prompt-only'){var ta=document.createElement('textarea');ta.id='prompt';ta.placeholder=lbl(0);return ta;}"
    & "if(tag==='btnbar'){var w=document.createElement('div');w.className='btnbar';"
    & "var g=document.createElement('button');g.className='btn primary';g.textContent='Generate';g.onclick=function(){if(_wkOnClick)_wkOnClick('gen')};"
    & "var s=document.createElement('input');s.id='seed';s.type='number';s.value=st;"
    & "var r=document.createElement('button');r.className='btn';r.textContent='Random';r.onclick=function(){if(_wkOnClick)_wkOnClick('rnd')};"
    & "w.appendChild(g);w.appendChild(s);w.appendChild(r);return w;}"
    & "if(tag==='btnbar-batch'){var w=document.createElement('div');w.className='btnbar';"
    & "var g=document.createElement('button');g.className='btn primary';g.textContent='Generate';g.onclick=function(){if(_wkOnClick)_wkOnClick('gen')};"
    & "var s=document.createElement('input');s.id='seed';s.type='number';s.value=st;"
    & "var b=document.createElement('button');b.className='btn';b.textContent='Batch All Rarities';b.onclick=function(){if(_wkOnClick)_wkOnClick('batch')};"
    & "var r=document.createElement('button');r.className='btn';r.textContent='Random';r.onclick=function(){if(_wkOnClick)_wkOnClick('rnd')};"
    & "w.appendChild(g);w.appendChild(s);w.appendChild(b);w.appendChild(r);return w;}"
    & emit-dom-widget-magic-a & emit-dom-widget-magic-b & emit-dom-widget-magic-c
    & "var el=document.createElement('div');el.dataset.custom=tag;if(id)el.id=id;for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}\n"

  emit-dom-widget-magic-a : Text
  emit-dom-widget-magic-a =
    "if(tag==='magic-nav'){var nv=document.createElement('div');nv.className='topbar';"
    & "var brand=document.createElement('div');brand.className='hdr-brand';brand.textContent='CodexMagic';"
    & "var right=document.createElement('div');right.className='hdr-right';"
    & "var pages=[['Game','/game.html'],['Collection','/collection.html'],['Store','/store.html'],['Queue','/queue.html'],['Market','/marketplace.html']];"
    & "for(var i=0;i<pages.length;i++){var a=document.createElement('a');a.href=pages[i][1];a.textContent=pages[i][0];if(location.pathname===pages[i][1])a.className='active';right.appendChild(a);}"
    & "if(st===1){var aa=document.createElement('a');aa.href='/admin.html';aa.textContent='Admin';if(location.pathname==='/admin.html')aa.className='active';right.appendChild(aa);}"
    & "nv.appendChild(brand);nv.appendChild(right);return nv;}"
    & "if(tag==='tab-bar'){var w=document.createElement('div');w.className='tab-bar';"
    & "for(var i=0;i<ch.length;i++)w.appendChild(_wk(ch[i]));return w;}"
    & "if(tag==='tab-btn'){var b=document.createElement('button');b.className='tab-btn'+(st===1?' active':'');"
    & "b.textContent=lbl(0);b.id=id;b.onclick=function(){if(_wkOnClick)_wkOnClick(id)};return b;}"
    & "if(tag==='tab-panel'){var p=document.createElement('div');p.className='tab-panel'+(st===1?' active':'');"
    & "p.id=id;for(var i=0;i<ch.length;i++)p.appendChild(_wk(ch[i]));return p;}"

  emit-dom-widget-magic-b : Text
  emit-dom-widget-magic-b =
    "if(tag==='stat-grid'){var g=document.createElement('div');g.className='stat-grid';g.id=id;"
    & "for(var i=0;i<ch.length;i++)g.appendChild(_wk(ch[i]));return g;}"
