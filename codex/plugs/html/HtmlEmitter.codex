Chapter: HTML Emitter
  cites Foreword chapter CCE

Section: Keywords and Sanitization

  html-sanitize : Text -> Text
  html-sanitize (name) =
    js-reserve-guard (text-replace (text-replace (text-replace (text-replace name "-" "_") "'" "") "@" "_at_") "#" "_h_")

  js-reserve-guard : Text -> Text
  js-reserve-guard (n) =
    if is-js-reserved n then n & "_" else n

  is-js-reserved : Text -> Boolean
  is-js-reserved (n) =
    if n == "new" then True
    else if n == "var" then True
    else if n == "const" then True
    else if n == "function" then True
    else if n == "return" then True
    else if n == "typeof" then True
    else if n == "void" then True
    else if n == "this" then True
    else if n == "switch" then True
    else if n == "case" then True
    else if n == "break" then True
    else if n == "continue" then True
    else if n == "default" then True
    else if n == "throw" then True
    else if n == "try" then True
    else if n == "catch" then True
    else if n == "finally" then True
    else if n == "delete" then True
    else if n == "do" then True
    else if n == "while" then True
    else if n == "for" then True
    else if n == "of" then True
    else if n == "yield" then True
    else if n == "await" then True
    else if n == "enum" then True
    else if n == "export" then True
    else if n == "import" then True
    else if n == "extends" then True
    else if n == "super" then True
    else if n == "static" then True
    else if n == "null" then True
    else if n == "undefined" then True
    else if n == "arguments" then True
    else if n == "eval" then True
    else False

  html-field : Text -> Text
  html-field (f) =
    let slash = html-slash-pos f 0 (text-length f)
    in if slash >= 0 then html-sanitize (substring f 0 slash)
    else html-sanitize f

  html-slash-pos : Text, Integer, Integer -> Integer
  html-slash-pos (f) (i) (len) =
    if i >= len then (-1)
    else if char-to-text (char-at f i) == "/" then i
    else html-slash-pos f (i + 1) len

  html-escape : Text -> Text
  html-escape (s) =
    let s1 = text-replace s "&" "&amp;"
    in let s2 = text-replace s1 "<" "&lt;"
    in let s3 = text-replace s2 ">" "&gt;"
    in let s4 = text-replace s3 "\"" "&quot;"
    in s4

  js-escape : Text -> Text
  js-escape (s) =
    let s1 = text-replace s "\\" "\\\\"
    in let s2 = text-replace s1 "\"" "\\\""
    in let s3 = text-replace s2 "\n" "\\n"
    in let s4 = text-replace s3 "'" "\\'"
    in text-replace s4 "</" "<\\/"

 The HTML parser ends an inline script at the first `</script`, inside a
 JavaScript string literal or not, so a program that prints one truncates
 its own page and the remainder parses as stray text. `<\/` is an identity
 escape in JavaScript and reads as `</` at runtime. This must stay AFTER the
 backslash rule above, or that rule doubles the backslash this one inserts.

  html-indent : Integer -> Text
  html-indent (n) =
    if n <= 0 then ""
    else "  " & html-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
    if lo >= hi then lo
    else let mid = lo + (hi - lo) / 2
    in let mid-name = (list-at entries mid).name
    in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
    else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
    let len = list-length xs
    in let pos = bsearch-arity-pos xs (e.name) 0 len
    in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
    if i == list-length defs then acc
    else let d = list-at defs i
    in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
     name = d.name,
     arity = __narrow (list-length (d.params)),
     generic-count = 0
    }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
    let len = list-length entries
    in let pos = bsearch-arity-pos entries name 0 len
    in if pos >= len then 0 - 1
    else let e = list-at entries pos
    in if e.name == name then e.arity else 0 - 1

  arity-hide : List ArityEntry, Text -> List ArityEntry
  arity-hide (es) (n) =
    if lookup-arity es n == 0 then arity-hide-copy es n 0 (list-length es) [] else es

  arity-hide-copy : List ArityEntry, Text, Integer, Integer, List ArityEntry -> List ArityEntry
  arity-hide-copy (es) (n) (i) (len) (acc) =
    if i >= len then acc
    else let e = list-at es i
    in if e.name == n then arity-hide-copy es n (i + 1) len acc
    else arity-hide-copy es n (i + 1) len (list-push acc e)

  arity-hide-params : List ArityEntry, List IRParam, Integer -> List ArityEntry
  arity-hide-params (es) (ps) (i) =
    if i >= list-length ps then es
    else arity-hide-params (arity-hide es (list-at ps i).name) ps (i + 1)

  arity-hide-pat : List ArityEntry, IRPat -> List ArityEntry
  arity-hide-pat (es) (p) =
    when p
     is IrVarPat (name) (ty) (sp) -> arity-hide es name
     is IrCtorPat (name) (subs) (ty) (sp) -> arity-hide-pats es subs 0
     is otherwise -> es

  arity-hide-pats : List ArityEntry, List IRPat, Integer -> List ArityEntry
  arity-hide-pats (es) (ps) (i) =
    if i >= list-length ps then es
    else arity-hide-pats (arity-hide-pat es (list-at ps i)) ps (i + 1)

Section: Type Emission

  emit-html-type : CodexType -> Text
  emit-html-type (ty) =
    when ty
     is IntegerTy (lo) (hi) (mode) -> "number"
     is RealTy (w) (m) -> "number"
     is TextTy -> "string"
     is BooleanTy -> "boolean"
     is CharTy -> "string"
     is VoidTy -> "void"
     is NothingTy -> "void"
     is ProofTy -> "void"
     is PropEqTy (pl) (pr) -> "void"
     is UnitTy (n) (inner) -> "void"
     is ErrorTy | NoExpectTy -> "any"
     is FunTy (p) (fnrow) (r) -> "Function"
     is ListTy (elem) -> "Array"
     is LinkedListTy (elem) -> "Array"
     is TypeVar (id) -> "any"
     is ForAllTy (id) (body) -> emit-html-type body
     is ForAllEff (id) (body) -> emit-html-type body
     is LinearTy (body) -> emit-html-type body
     is TypeApply (body) (tyarg) -> emit-html-type body
     is SumTy (name) (ty-args) (ctors) -> name.value
     is RecordTy (name) (args) (fields) -> name.value
     is ConstructedTy (name) (args) -> name.value
     is TypeCon (name) -> name.value
     is VectorTy (vn) (vt) -> "Array"
     is VectorMaskTy (vn) (ve) -> "Array"
     is SizedVecTy (sn) (st) -> "Array"
     is EffectfulTy (effs) (sc) (ret) -> emit-html-type ret

Section: JavaScript Expression Emission

  emit-js-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-js-expr (e) (arities) (indent) =
    when e
     is IrIntLit (n) (sp) -> show n & "n"
     is IrNumLit (n) (sp) -> "__real(" & show n & "n)"
     is IrTextLit (s) (sp) -> "\"" & js-escape s & "\""
     is IrBoolLit (b) (sp) -> if b then "true" else "false"
     is IrCharLit (n) (sp) -> "String.fromCodePoint(" & show (to-unicode n) & ")"
     is IrName (n) (ty) (sp) -> if lookup-arity arities n == 0 then
       html-sanitize n & "()"
     else html-sanitize n
     is IrBinary (op) (l) (r) (ty) (sp) -> emit-js-binary op l r ty arities indent
     is IrNegate (x) (nty) (sp) -> "(-(" & emit-js-expr x arities indent & "))"
     is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-js-expr c arities indent & " ? " & emit-js-expr t arities indent & " : " & emit-js-expr el arities indent & ")"
     is IrLet (name) (ty) (val) (body) (sp) -> emit-js-let name val body arities indent
     is IrApply (f) (a) (ty) (sp) -> emit-js-apply e arities indent
     is IrLambda (params) (body) (ty) (sp) -> emit-js-lambda params body arities indent
     is IrList (elems) (ty) (sp) -> "[" & emit-js-list-elems elems arities indent 0 & "]"
     is IrMatch (scrut) (branches) (ty) (sp) -> emit-js-match scrut branches arities indent
     is IrAct (stmts) (ty) (sp) -> emit-js-act stmts arities indent
     is IrRecord (name) (fields) (ty) (sp) -> emit-js-record name fields arities indent
     is IrFieldAccess (rec) (field) (ty) (sp) -> emit-js-expr rec arities indent & "." & html-field field
     is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(" & emit-js-expr rec arities indent & "." & html-field field & " = " & emit-js-expr val arities indent & ")"
     is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => " & emit-js-expr body arities indent & ")"
     is IrAwait (task) (ty) (sp) -> "(await " & emit-js-expr task arities indent & ")"
     is IrHandle (eff) (body) (clauses) (ty) (sp) -> "(console.warn('effect handler not supported in web target'), " & emit-js-expr body arities indent & ")"
     is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> "(console.warn('with-timeout not supported in web target'), " & emit-js-expr body arities indent & ")"
     is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-js-try max body fb fail arities indent
     is IrError (msg) (ty) (sp) -> "(() => { throw new Error(" & "\"" & js-escape msg & "\"" & "); })()"

Section: Binary Operators

 A Codex Integer is a BigInt here. `BigInt.asIntN(64, v)` is the truncation to
 the declared width: the wrapping band takes it as the answer, and the plain arm
 compares it against the unbounded result as the overflow test. The marker is
 what plug-oracle-test.ps1 reads as its REFUSED verdict.

  js-int-arith : Text, Text, Text, CodexType -> Text
  js-int-arith (sym) (lhs) (rhs) (ty) =
    if int-ty-wraps ty then "BigInt.asIntN(64, " & lhs & " " & sym & " " & rhs & ")"
    else
      "((_v) => { if (BigInt.asIntN(64, _v) !== _v) { throw new Error(\"CODEX_TRAP_integer_overflow\"); } return _v; })(" & lhs & " " & sym & " " & rhs & ")"

  emit-js-binary : IRBinaryOp, IRExpr, IRExpr, CodexType, List ArityEntry, Integer -> Text
  emit-js-binary (op) (l) (r) (ty) (arities) (indent) =
    let lhs = emit-js-expr l arities indent
    in let rhs = emit-js-expr r arities indent
    in when op
     is IrAddInt -> js-int-arith "+" lhs rhs ty
     is IrSubInt -> js-int-arith "-" lhs rhs ty
     is IrMulInt -> js-int-arith "*" lhs rhs ty
     is IrDivInt -> "(" & lhs & " / " & rhs & ")"
     is IrRemInt -> "(" & lhs & " % " & rhs & ")"
     is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
     is IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
     is IrSubNum | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
     is IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
     is IrDivNum | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
     is IrEq -> "(" & lhs & " === " & rhs & ")"
     is IrNotEq -> "(" & lhs & " !== " & rhs & ")"
     is IrLt | IrLtVec -> "(" & lhs & " < " & rhs & ")"
     is IrGt | IrGtVec -> "(" & lhs & " > " & rhs & ")"
     is IrLtEq | IrLtEqVec -> "(" & lhs & " <= " & rhs & ")"
     is IrGtEq | IrGtEqVec -> "(" & lhs & " >= " & rhs & ")"
     is IrApproxEq -> "(" & lhs & " === " & rhs & ")"
     is IrApproxEqExact -> "(" & lhs & " === " & rhs & ")"
     is IrAnd -> "(" & lhs & " && " & rhs & ")"
     is IrOr -> "(" & lhs & " || " & rhs & ")"
     is IrAppendText -> "(" & lhs & " + " & rhs & ")"
     is IrAppendList -> "(" & lhs & ".concat(" & rhs & "))"
     is IrConsList -> "[" & lhs & ", ..." & rhs & "]"
     is IrAddVec -> "(" & lhs & ".map((v,i) => v + " & rhs & "[i]))"
     is IrSubVec -> "(" & lhs & ".map((v,i) => v - " & rhs & "[i]))"
     is IrMulVec -> "(" & lhs & ".map((v,i) => v * " & rhs & "[i]))"
     is IrDivVec -> "(" & lhs & ".map((v,i) => v / " & rhs & "[i]))"

Section: Let Bindings

  emit-js-let : Text, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-js-let (name) (val) (body) (arities) (indent) =
    "(() => {\n" & html-indent (indent + 1) & "const " & html-sanitize name & " = " & emit-js-expr val arities (indent + 1) & ";\n" & emit-js-let-tail body (arity-hide arities name) (indent + 1) & html-indent indent & "})()"

  emit-js-let-tail : IRExpr, List ArityEntry, Integer -> Text
  emit-js-let-tail (body) (arities) (indent) =
    when body
     is IrLet (name) (ty) (val) (inner) (sp) -> html-indent indent & "const " & html-sanitize name & " = " & emit-js-expr val arities indent & ";\n" & emit-js-let-tail inner (arity-hide arities name) indent
     is otherwise -> html-indent indent & "return " & emit-js-expr body arities indent & ";\n"

Section: Apply

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
    when e
     is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
     is otherwise -> FlatApply { root = e, args = acc }

  emit-js-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-js-apply (e) (arities) (indent) =
    let chain = collect-apply-chain e []
    in when (chain.root)
     is IrName (n) (ty) (sp) -> if is-mktup-name n then
       "[" & emit-js-apply-args (chain.args) arities indent 0 & "]"
     else if n == "__record-set" & list-length (chain.args) == 3 then
       emit-js-record-set (chain.args) arities indent
     else let func = emit-js-expr (chain.root) arities indent
     in let args = emit-js-apply-args (chain.args) arities indent 0
     in let supplied = list-length (chain.args)
     in let ar = lookup-arity arities n
     in if ar > supplied & supplied > 0 then
       "__pa(" & func & ", " & integer-to-text ar & ", [" & args & "])"
     else if ar > 0 & supplied > ar then
       emit-html-curried (func & "(" & emit-js-apply-args-upto (chain.args) arities indent 0 ar & ")") (chain.args) arities indent ar
     else func & "(" & args & ")"
     is otherwise -> let func = emit-js-expr (chain.root) arities indent
     in let args = emit-js-apply-args (chain.args) arities indent 0
     in func & "(" & args & ")"

 The eta-wrap above covers a definition applied to FEWER arguments than it
 takes. This covers the other direction: a definition applied to MORE, where
 the surplus belongs to what the definition RETURNS and is applied one at a
 time.

  emit-html-curried : Text, List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-html-curried (base) (args) (arities) (indent) (i) =
    if i >= list-length args then base
    else let next = base & "(" & emit-js-expr (list-at args i) arities indent & ")"
    in emit-html-curried next args arities indent (i + 1)

  emit-js-apply-args-upto : List IRExpr, List ArityEntry, Integer, Integer, Integer -> Text
  emit-js-apply-args-upto (args) (arities) (indent) (i) (n) =
    if i >= n then ""
    else if i == n - 1 then emit-js-expr (list-at args i) arities indent
    else
      emit-js-expr (list-at args i) arities indent & ", " & emit-js-apply-args-upto args arities indent (i + 1) n

  emit-js-apply-args : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-js-apply-args (args) (arities) (indent) (i) =
    if i == list-length args then ""
    else let sep = if i > 0 then ", " else ""
    in sep & emit-js-expr (list-at args i) arities indent & emit-js-apply-args args arities indent (i + 1)

Section: Lambda

  emit-js-lambda : List IRParam, IRExpr, List ArityEntry, Integer -> Text
  emit-js-lambda (params) (body) (arities) (indent) =
    "(" & emit-js-param-names params 0 & ") => " & emit-js-expr body (arity-hide-params arities params 0) indent

  emit-js-param-names : List IRParam, Integer -> Text
  emit-js-param-names (params) (i) =
    if i == list-length params then ""
    else let sep = if i > 0 then ", " else ""
    in sep & html-sanitize (list-at params i).name & emit-js-param-names params (i + 1)

Section: List

  emit-js-list-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-js-list-elems (elems) (arities) (indent) (i) =
    if i == list-length elems then ""
    else let sep = if i > 0 then ", " else ""
    in sep & emit-js-expr (list-at elems i) arities indent & emit-js-list-elems elems arities indent (i + 1)

Section: Match

  emit-js-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-js-match (scrut) (branches) (arities) (indent) =
    let sv = emit-js-expr scrut arities indent
    in "(() => {\n" & html-indent (indent + 1) & "const _s = " & sv & ";\n" & emit-js-branches branches arities (indent + 1) 0 & html-indent indent & "})()"

  emit-js-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-js-branches (branches) (arities) (indent) (i) =
    if i == list-length branches then
      html-indent indent & "throw new Error('non-exhaustive match');\n"
    else let b = list-at branches i
    in let cond = emit-js-pattern-cond (b.pattern) "_s"
    in let binds = emit-js-pattern-binds (b.pattern) "_s" indent
    in let scope = arity-hide-pat arities (b.pattern)
    in let body = emit-js-expr (b.body) scope indent
    in let ret = if html-guard-trivial (b.guard)
                 then html-indent (indent + 1) & "return " & body & ";\n"
    else
      html-indent (indent + 1) & "if (" & emit-js-expr (b.guard) scope indent & ") { return " & body & "; }\n"
    in html-indent indent & "if (" & cond & ") {\n" & binds & ret & html-indent indent & "}\n" & emit-js-branches branches arities indent (i + 1)

 A guarded arm must not chain with else-if: the guard needs the pattern
 bindings, which sit inside the block, so a failed guard has to fall OUT of
 the block and reach the next test. Sequential ifs give that and an else-if
 chain cannot.

  html-lit-pat : Text, CodexType -> Text
  html-lit-pat (text) (ty) =
    when ty
     is IntegerTy (lo) (hi) (m) -> text & "n"
     is CharTy -> "String.fromCodePoint(" & show (to-unicode (text-to-integer text)) & ")"
     is BooleanTy -> if text == "True" then "true" else "false"
     is otherwise -> text

  html-guard-trivial : IRExpr -> Boolean
  html-guard-trivial (g) =
    when g
     is IrBoolLit (v) (sp) -> v
     is otherwise -> False

  emit-js-pattern-cond : IRPat, Text -> Text
  emit-js-pattern-cond (p) (scrut) =
    when p
     is IrVarPat (name) (ty) (sp) -> "true"
     is IrLitPat (text) (ty) (sp) -> scrut & " === " & html-lit-pat text ty
     is IrCtorPat (name) (subs) (ty) (sp) -> if is-mktup-name name then
       "true"
     else "(" & scrut & "._tag === \"" & name & "\" && " & text-concat-list (emit-js-subpattern-conds subs scrut 0 []) & ")"
     is IrWildPat (sp) -> "true"
     is IrVecPat (pats) (ty) (sp) -> "true"

  emit-js-subpattern-conds : List IRPat, Text, Integer, List Text -> List Text
  emit-js-subpattern-conds (subs) (scrut) (i) (acc) =
    if i >= list-length subs then list-push acc "true"
    else let cond = emit-js-pattern-cond (list-at subs i) (scrut & "._" & show i)
    in emit-js-subpattern-conds subs scrut (i + 1) (if cond == "true" then acc else list-push acc ("(" & cond & ") && "))

  emit-js-pattern-binds : IRPat, Text, Integer -> Text
  emit-js-pattern-binds (p) (scrut) (indent) =
    when p
     is IrVarPat (name) (ty) (sp) -> html-indent (indent + 1) & "const " & html-sanitize name & " = " & scrut & ";\n"
     is IrLitPat (text) (ty) (sp) -> ""
     is IrCtorPat (name) (subs) (ty) (sp) -> if is-mktup-name name then
       emit-js-tuple-binds subs scrut indent 0
     else emit-js-ctor-binds subs scrut indent 0
     is IrWildPat (sp) -> ""
     is IrVecPat (pats) (ty) (sp) -> ""

  emit-js-ctor-binds : List IRPat, Text, Integer, Integer -> Text
  emit-js-ctor-binds (subs) (scrut) (indent) (i) =
    if i == list-length subs then ""
    else let sub = list-at subs i
    in let field-access = scrut & "._" & show i
    in emit-js-pattern-binds sub field-access indent & emit-js-ctor-binds subs scrut indent (i + 1)

Section: Act Blocks

  emit-js-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-js-act (stmts) (arities) (indent) =
    "(() => {\n" & emit-js-act-stmts stmts arities (indent + 1) 0 & html-indent indent & "})()"

  emit-js-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-js-act-stmts (stmts) (arities) (indent) (i) =
    if i == list-length stmts then ""
    else let s = list-at stmts i
    in let rest = when s
      is IrDoBind (name) (ty) (val) (sp) -> arity-hide arities name
      is otherwise -> arities
    in emit-js-act-stmt s arities indent (i == list-length stmts - 1) & emit-js-act-stmts stmts rest indent (i + 1)

  emit-js-act-stmt : IRActStmt, List ArityEntry, Integer, Boolean -> Text
  emit-js-act-stmt (s) (arities) (indent) (is-last) =
    when s
     is IrDoBind (name) (ty) (val) (sp) -> html-indent indent & "const " & html-sanitize name & " = " & emit-js-expr val arities indent & ";\n"
     is IrDoExec (e) (sp) ->
      if is-last then html-indent indent & "return " & emit-js-expr e arities indent & ";\n"
      else html-indent indent & emit-js-expr e arities indent & ";\n"

Section: Records

  emit-js-record : Text, List IRFieldVal, List ArityEntry, Integer -> Text
  emit-js-record (name) (fields) (arities) (indent) =
    "{ _type: \"" & name & "\"" & emit-js-record-fields fields arities indent 0 & " }"

 `__record-set` writes through its target and returns that same record, as
 native Codex does (L-ALIAS); a copy loses the write when the result is discarded.

  emit-js-record-set : List IRExpr, List ArityEntry, Integer -> Text
  emit-js-record-set (args) (arities) (indent) =
    let field-name = when (list-at args 1)
     is IrTextLit (s) (sp) -> s
     is otherwise -> ""
    in "((_r) => { _r." & html-sanitize field-name & " = " & emit-js-expr (list-at args 2) arities indent & "; return _r; })(" & emit-js-expr (list-at args 0) arities indent & ")"

  emit-js-record-fields : List IRFieldVal, List ArityEntry, Integer, Integer -> Text
  emit-js-record-fields (fields) (arities) (indent) (i) =
    if i == list-length fields then ""
    else let f = list-at fields i
    in ", " & html-sanitize (f.name) & ": " & emit-js-expr (f.value) arities indent & emit-js-record-fields fields arities indent (i + 1)

Section: Try

  emit-js-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, List ArityEntry, Integer -> Text
  emit-js-try (max) (body) (fb) (fail) (arities) (indent) =
    "(() => {\n" & html-indent (indent + 1) & "for (let _try = 0; _try < " & show max & "; _try++) {\n" & html-indent (indent + 2) & "try {\n" & emit-js-act-stmts body arities (indent + 3) 0 & html-indent (indent + 2) & "} catch (_e) { continue; }\n" & html-indent (indent + 1) & "}\n" & emit-js-act-stmts fail arities (indent + 1) 0 & html-indent indent & "})()"

Section: Type Definitions

  emit-js-type-def : ATypeDef -> Text
  emit-js-type-def (td) =
    when td
     is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
      "function " & html-sanitize (name.value) & "(fields) { return { _type: \"" & name.value & "\", ...fields }; }\n"
     is AVariantTypeDef (name) (tparams) (ctors) (s) ->
      if is-tup-type (name.value) then ""
      else emit-js-variant-ctors ctors 0
     is AUnitTypeDef (name) (base) (s) -> ""

  emit-js-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-js-variant-ctors (ctors) (i) =
    if i == list-length ctors then ""
    else let c = list-at ctors i
    in emit-js-variant-ctor c & emit-js-variant-ctors ctors (i + 1)

  emit-js-variant-ctor : AVariantCtorDef -> Text
  emit-js-variant-ctor (c) =
    let n = list-length (c.fields)
    in if n == 0 then
      "const " & html-sanitize (c.name.value) & " = { _tag: \"" & c.name.value & "\" };\n"
    else
      "function " & html-sanitize (c.name.value) & "(" & emit-js-ctor-params n 0 & ") { return { _tag: \"" & c.name.value & "\"" & emit-js-ctor-fields n 0 & " }; }\n"

  emit-js-ctor-params : Integer, Integer -> Text
  emit-js-ctor-params (n) (i) =
    if i == n then ""
    else let sep = if i > 0 then ", " else ""
    in sep & "_" & show i & emit-js-ctor-params n (i + 1)

  emit-js-ctor-fields : Integer, Integer -> Text
  emit-js-ctor-fields (n) (i) =
    if i == n then ""
    else ", _" & show i & ": _" & show i & emit-js-ctor-fields n (i + 1)

Section: Definition Emission

  is-html-builtin : Text -> Boolean
  is-html-builtin (n) =
    if text-starts-with n "dom-" then True
    else if n == "random-int" then True
    else if n == "utf8-bytes-to-text" then True
    else if n == "text-to-unicode-bytes" then True
    else if n == "unicode-bytes-to-text" then True
    else if n == "fetch-json" then True
    else if n == "json-stringify" then True
    else if n == "json-parse-rows" then True
    else if n == "json-parse-obj" then True
    else if n == "json-obj-field" then True
    else if n == "url-encode" then True
    else if n == "download-text" then True
    else if n == "set-timeout" then True
    else if n == "local-storage-get" then True
    else if n == "local-storage-set" then True
    else if n == "generate-image" then True
    else if n == "check-sd-status" then True
    else if n == "mount-widget" then True
    else if n == "int-to-css-color" then True
    else if n == "mount-widget-themed" then True
    else if n == "mount-widget-into" then True
    else if n == "mount-overlays" then True
    else if n == "mount-svg" then True
    else if n == "svg-draw-cmds" then True
    else if n == "svg-label" then True
    else if n == "svg-fill-path" then True
    else if n == "svg-stroke-path" then True
    else if n == "register-handlers" then True
    else if n == "register-input-handler" then True
    else if n == "play-tone" then True
    else if n == "state-get" then True
    else if n == "state-set" then True
    else if n == "state-get-text" then True
    else if n == "state-set-text" then True
    else if n == "next-card-id" then True
    else if n == "theme-to-css" then True
    else if n == "inject-theme-css" then True
    else if n == "fetch-then" then True
    else if n == "fetch-get-then" then True
    else if n == "fetch-with-then" then True
    else if n == "page-data" then True
    else if n == "location-hash" then True
    else if n == "location-clear-hash" then True
    else if n == "on-hash-change" then True
    else if n == "uri-decode-component" then True
    else if n == "json-valid" then True
    else if n == "pick-file-text" then True
    else if n == "wasm-run-then" then True
    else if n == "gpu-probe-then" then True
    else if html-is-gpu-bridge n then True
    else if n == "dom-on-click" then True
    else if n == "audio-on-position" then True
    else if n == "audio-seek" then True
    else if n == "image-pixels-then" then True
    else if n == "texture-pixels-then" then True
    else if n == "canvas-pixels" then True
    else if n == "media-seek-ms" then True
    else if n == "media-pause" then True
    else if n == "media-play-then" then True
    else if n == "dom-on-input" then True
    else if n == "dom-on-key" then True
    else if n == "dom-click" then True
    else if n == "set-render" then True
    else if n == "state-set-render" then True
    else if n == "state-set-text-render" then True
    else if n == "request-render" then True
    else if n == "show-alert" then True
    else if n == "show-confirm" then True
    else if n == "show-prompt" then True
    else if n == "close-dialog" then True
    else if n == "dom-set-aria" then True
    else if n == "dom-set-role" then True
    else if n == "css-animate-spin" then True
    else if n == "css-animate-pulse" then True
    else if n == "css-animate-bounce" then True
    else if n == "css-transition" then True
    else if n == "save-theme" then True
    else if n == "load-theme" then True
    else if n == "save-layout" then True
    else if n == "load-layout" then True
    else False

  emit-js-def : IRDef, List ArityEntry, List Text -> Text
  emit-js-def (d) (arities) (tramp) =
    if text-length (d.name) == 0 then ""
    else if is-html-builtin (d.name) then ""
    else if d.chapter-slug == "Encode--Json" & d.name == "json-quote" & list-length (d.params) == 1 then
      "function json_quote(s) { return JSON.stringify(s); }\nfunction json_quote__tb(s) { return JSON.stringify(s); }\n"
    else let sname = html-sanitize (d.name)
    in let scope = arity-hide-params arities (d.params) 0
    in let n = list-length (d.params)
    in if n > 0 & html-text-in tramp (d.name) 0 then
      "function " & sname & "__tb(" & html-tail-args n 0 & ") {\n  while (true) {\n" & html-tail-binds (d.params) 0 & emit-js-tail (d.name) (d.params) (d.body) scope tramp 2 & "  }\n}\n"
       & "function " & sname & "(...a) {\n  let r = " & sname & "__tb(...a);\n  while (r instanceof __TC) { r = r.f(...r.a); }\n  return r;\n}\n\n"
    else if n > 0 & html-has-self-tail (d.name) n (d.body) then
      "function " & sname & "(" & html-tail-args n 0 & ") {\n  while (true) {\n" & html-tail-binds (d.params) 0 & emit-js-tail (d.name) (d.params) (d.body) scope [] 2 & "  }\n}\n\n"
    else
      "function " & sname & "(" & emit-js-param-names (d.params) 0 & ") {\n  return " & emit-js-expr (d.body) scope 1 & ";\n}\n\n"

  html-text-in : List Text, Text, Integer -> Boolean
  html-text-in (xs) (x) (i) =
    if i >= list-length xs then False
    else if list-at xs i == x then True
    else html-text-in xs x (i + 1)

  html-tramp-set : List IRDef, List ArityEntry, Integer, List Text -> List Text
  html-tramp-set (defs) (arities) (i) (acc) =
    if i >= list-length defs then acc
    else let d = list-at defs i
    in if list-length (d.params) > 0 & html-has-other-tail (d.name) (d.body) arities
       then html-tramp-set defs arities (i + 1) (list-push acc (d.name))
    else html-tramp-set defs arities (i + 1) acc

  html-has-other-tail : Text, IRExpr, List ArityEntry -> Boolean
  html-has-other-tail (name) (e) (arities) =
    when e
     is IrIf (c) (t) (el) (ty) (sp) -> html-has-other-tail name t arities | html-has-other-tail name el arities
     is IrLet (nm) (ty) (v) (b) (sp) -> html-has-other-tail name b arities
     is IrMatch (s) (bs) (ty) (sp) -> html-branches-other-tail name bs arities 0
     is IrApply (f) (a) (ty) (sp) -> html-is-def-call name e arities
     is otherwise -> False

  html-branches-other-tail : Text, List IRBranch, List ArityEntry, Integer -> Boolean
  html-branches-other-tail (name) (bs) (arities) (i) =
    if i >= list-length bs then False
    else if html-has-other-tail name ((list-at bs i).body) arities then True
    else html-branches-other-tail name bs arities (i + 1)

  html-is-def-call : Text, IRExpr, List ArityEntry -> Boolean
  html-is-def-call (name) (e) (arities) =
    let chain = collect-apply-chain e []
    in when (chain.root)
     is IrName (r) (ty) (sp) -> r /= name & is-html-builtin r == False & list-length (chain.args) > 0 & lookup-arity arities r == list-length (chain.args)
     is otherwise -> False

  html-tramp-root : List Text, IRExpr, List ArityEntry -> Text
  html-tramp-root (tramp) (e) (arities) =
    let chain = collect-apply-chain e []
    in when (chain.root)
     is IrName (r) (ty) (sp) -> if html-text-in tramp r 0 & list-length (chain.args) > 0 & lookup-arity arities r == list-length (chain.args) then
       r
     else ""
     is otherwise -> ""

  html-has-self-tail : Text, Integer, IRExpr -> Boolean
  html-has-self-tail (name) (n) (e) =
    when e
     is IrIf (c) (t) (el) (ty) (sp) -> html-has-self-tail name n t | html-has-self-tail name n el
     is IrLet (nm) (ty) (v) (b) (sp) -> if nm == name then False else html-has-self-tail name n b
     is IrMatch (s) (bs) (ty) (sp) -> html-branches-self-tail name n bs 0
     is IrApply (f) (a) (ty) (sp) -> html-is-self-call name n e
     is otherwise -> False

  html-branches-self-tail : Text, Integer, List IRBranch, Integer -> Boolean
  html-branches-self-tail (name) (n) (bs) (i) =
    if i >= list-length bs then False
    else if html-has-self-tail name n ((list-at bs i).body) then True
    else html-branches-self-tail name n bs (i + 1)

  html-is-self-call : Text, Integer, IRExpr -> Boolean
  html-is-self-call (name) (n) (e) =
    let chain = collect-apply-chain e []
    in when (chain.root)
     is IrName (r) (ty) (sp) -> r == name & list-length (chain.args) == n
     is otherwise -> False

  emit-js-tail : Text, List IRParam, IRExpr, List ArityEntry, List Text, Integer -> Text
  emit-js-tail (name) (params) (e) (arities) (tramp) (indent) =
    when e
     is IrIf (c) (t) (el) (ty) (sp) ->
      html-indent indent & "if (" & emit-js-expr c arities indent & ") {\n" & emit-js-tail name params t arities tramp (indent + 1)
      & html-indent indent & "} else {\n" & emit-js-tail name params el arities tramp (indent + 1) & html-indent indent & "}\n"
     is IrLet (nm) (ty) (v) (b) (sp) ->
      html-indent indent & "{\n" & html-indent (indent + 1) & "const " & html-sanitize nm & " = " & emit-js-expr v arities (indent + 1) & ";\n"
      & emit-js-tail name params b (arity-hide arities nm) tramp (indent + 1) & html-indent indent & "}\n"
     is IrMatch (scrut) (bs) (ty) (sp) ->
      html-indent indent & "{\n" & html-indent (indent + 1) & "const _s = " & emit-js-expr scrut arities (indent + 1) & ";\n"
      & emit-js-tail-branches name params bs arities tramp (indent + 1) 0 & html-indent indent & "}\n"
     is otherwise ->
      if html-is-self-call name (list-length params) e then
        emit-js-tail-jump params ((collect-apply-chain e []).args) arities indent
      else let target = html-tramp-root tramp e arities
      in if target /= "" then
        html-indent indent & "return new __TC(" & html-sanitize target & "__tb, [" & emit-js-apply-args ((collect-apply-chain e []).args) arities indent 0 & "]);\n"
      else html-indent indent & "return " & emit-js-expr e arities indent & ";\n"

  emit-js-tail-branches : Text, List IRParam, List IRBranch, List ArityEntry, List Text, Integer, Integer -> Text
  emit-js-tail-branches (name) (params) (bs) (arities) (tramp) (indent) (i) =
    if i >= list-length bs then html-indent indent & "throw new Error('non-exhaustive match');\n"
    else let b = list-at bs i
    in let scope = arity-hide-pat arities (b.pattern)
    in let body = emit-js-tail name params (b.body) scope tramp (indent + 2)
    in let inner = if html-guard-trivial (b.guard) then body
    else
      html-indent (indent + 1) & "if (" & emit-js-expr (b.guard) scope indent & ") {\n" & body & html-indent (indent + 1) & "}\n"
    in html-indent indent & "if (" & emit-js-pattern-cond (b.pattern) "_s" & ") {\n" & emit-js-pattern-binds (b.pattern) "_s" indent & inner & html-indent indent & "}\n"
     & emit-js-tail-branches name params bs arities tramp indent (i + 1)

  emit-js-tail-jump : List IRParam, List IRExpr, List ArityEntry, Integer -> Text
  emit-js-tail-jump (params) (args) (arities) (indent) =
    html-indent indent & "{\n" & emit-js-tail-temps args arities (indent + 1) 0 & emit-js-tail-assigns params (indent + 1) 0 & html-indent (indent + 1) & "continue;\n" & html-indent indent & "}\n"

  emit-js-tail-temps : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-js-tail-temps (args) (arities) (indent) (i) =
    if i >= list-length args then ""
    else
      html-indent indent & "const __tc" & integer-to-text i & " = " & emit-js-expr (list-at args i) arities indent & ";\n" & emit-js-tail-temps args arities indent (i + 1)

  emit-js-tail-assigns : List IRParam, Integer, Integer -> Text
  emit-js-tail-assigns (params) (indent) (i) =
    if i >= list-length params then ""
    else
      html-indent indent & "__a" & integer-to-text i & " = __tc" & integer-to-text i & ";\n" & emit-js-tail-assigns params indent (i + 1)

  html-tail-args : Integer, Integer -> Text
  html-tail-args (n) (i) =
    if i >= n then ""
    else (if i > 0 then ", " else "") & "__a" & integer-to-text i & html-tail-args n (i + 1)

  html-tail-binds : List IRParam, Integer -> Text
  html-tail-binds (params) (i) =
    if i >= list-length params then ""
    else
      "    const " & html-sanitize (list-at params i).name & " = __a" & integer-to-text i & ";\n" & html-tail-binds params (i + 1)

  emit-js-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-js-defs (defs) (i) (arities) =
    text-concat-list (emit-js-defs-acc defs i (list-length defs) arities (html-tramp-set defs arities 0 []) [])

  emit-js-defs-acc : List IRDef, Integer, Integer, List ArityEntry, List Text, List Text -> List Text
  emit-js-defs-acc (defs) (i) (len) (arities) (tramp) (acc) =
    if i >= len then acc
    else
      emit-js-defs-acc defs (i + 1) len arities tramp (list-push acc (emit-js-def (list-at defs i) arities tramp))

Section: HTML Page Assembly

  emit-html-page : Text, Text, Text -> Text
  emit-html-page (title) (css) (js) =
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" & html-escape title & "</title>\n  <style>\n" & css & "  </style>\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script>\n" & js & "  </script>\n</body>\n</html>\n"

  emit-default-css : Text
  emit-default-css =
    "    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    #app { display: contents; }\n"

Section: Chapter Emission

  opening-return-type : List IRDef -> CodexType
  opening-return-type (defs) =
    opening-return-type-loop defs 0 (list-length defs)

  opening-return-type-loop : List IRDef, Integer, Integer -> CodexType
  opening-return-type-loop (defs) (i) (len) =
    if i >= len then NothingTy
    else let d = list-at defs i
    in if d.name == "opening" then d.type-val
    else opening-return-type-loop defs (i + 1) len

  emit-html-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-html-chapter (m) (meta) (type-defs) =
    let arities = build-arity-map (m.defs) 0 []
    in let title = if meta.chapter-title == "" then "Codex App" else meta.chapter-title
    in let builtins = "function print_line_uni(s) { const el = document.createElement('div'); el.textContent = s; document.getElementById('app').appendChild(el); }\nfunction print_line(s) { print_line_uni(s); }\nfunction print_line_raw(s) { print_line_uni(s); }\nfunction show(n) { return typeof n === 'boolean' ? (n ? 'True' : 'False') : String(n); }\nfunction text_length(s) { return BigInt(s.length); }\nfunction text_replace(s, a, b) { return a.length === 0 ? s : s.split(a).join(b); }\nfunction text_split(s, sep) { return sep.length === 0 ? [s] : s.split(sep); }\nfunction text_to_integer(s) { let t = String(s); let i = 0; let neg = false; if (t.charAt(0) === '-') { neg = true; i = 1; } let v = 0n; while (i < t.length && t.charAt(i) >= '0' && t.charAt(i) <= '9') { v = v * 10n + BigInt(t.charCodeAt(i) - 48); i = i + 1; } return neg ? -v : v; }\nfunction text_compare(a, b) { return a < b ? -1n : a > b ? 1n : 0n; }\nfunction text_starts_with(s, p) { return s.startsWith(p); }\nfunction text_contains(s, sub) { return s.includes(sub); }\nfunction text_ends_with(s, suf) { return s.endsWith(suf); }\nfunction substring(s, start, len) { return s.slice(Number(start), Number(start) + Number(len)); }\nfunction char_to_text(c) { return c; }\nfunction char_code_at(s, i) { return BigInt(__u2c(s.codePointAt(Number(i)))); }\nfunction int_mod(a, b) { return a % b; }\nfunction list_snoc(xs, x) { xs.push(x); return xs; }\nfunction list_length(xs) { return BigInt(xs.length); }\nfunction list_at(xs, i) { return xs[Number(i)]; }\nfunction list_push(xs, x) { xs.push(x); return xs; }\nfunction list_set_at(xs, i, x) { const k = Number(i); if (k < 0 || k >= xs.length) { throw new Error(\"CODEX_TRAP_index_out_of_bounds\"); } xs[k] = x; return xs; }\nfunction integer_to_text(n) { return String(n); }\nfunction char_code(c) { return BigInt(typeof c === 'string' ? __u2c(c.codePointAt(0)) : c); }\nfunction code_to_char(cp) { return String.fromCodePoint(__c2u(Number(cp))); }\nfunction char_encode(c) { return c; }\nfunction text_concat_list(xs) { return xs.join(''); }\nfunction __list_with_capacity(n) { return []; }\nfunction char_at(s, i) { return s[Number(i)]; }\nfunction negate(n) { return -n; }\nfunction bit_xor(a,b){return (a^b);}\nfunction bit_and(a,b){return (a&b);}\nfunction bit_or(a,b){return (a|b);}\nfunction bit_shl(a,n){return BigInt.asIntN(64, a<<n);}\nfunction bit_shr(a,n){return (a>>n);}\nfunction bit_shru(a,n){return BigInt.asIntN(64, BigInt.asUintN(64, a)>>n);}\nfunction bit_not(a){return (~a);}\nfunction __narrow(n) { return n; }\nfunction __TC(f, a) { this.f = f; this.a = a; }\nfunction __real(b) { return new Float64Array(new BigInt64Array([b]).buffer)[0]; }\nfunction real_from_int(n) { return Number(n); }\nfunction real_to_int(x) { return BigInt(Math.trunc(x)); }\nfunction real_to_bits(x) { return new BigInt64Array(new Float64Array([x]).buffer)[0]; }\nfunction bits_to_real(b) { return __real(BigInt.asIntN(64, b)); }\nfunction text_to_double_bits(t) { return real_to_bits(parseFloat(t)); }\nfunction __pa(f, n, got) { return (...more) => { const all = got.concat(more); if (all.length < n) { return __pa(f, n, all); } const r = f(...all.slice(0, n)); return all.length > n && typeof r === 'function' ? r(...all.slice(n)) : r; }; }\n\n"
    in let types-text = emit-js-type-defs type-defs 0
    in let defs-text = emit-js-defs (m.defs) 0 arities
    in let entry = if lookup-arity arities "opening" >= 0 then
      "// Entry\ntry { opening(); } catch(e) { console.error(e); }\n"
    else "// Entry: this chapter declares no opening\n"
    in let dom-bi = emit-dom-builtins & (if html-uses-gpu-bridge (m.defs) 0 then emit-dom-gpu-bridge else "") & (if html-uses-byte-heap defs-text then emit-dom-byte-heap else "")
    in let wraps = "function __int(v) { return typeof v === 'number' ? BigInt(Math.trunc(v)) : v; }\n" & html-int-wraps (m.defs) 0 ""
    in let js = html-cce-runtime & builtins & dom-bi & wraps & types-text & defs-text & entry
    in emit-html-page title (emit-default-css) js

  html-cce-list : List Integer, Integer, Text -> Text
  html-cce-list (xs) (i) (acc) =
    if i >= list-length xs then acc
    else
      html-cce-list xs (i + 1) (if i == 0 then show (list-at xs i) else acc & "," & show (list-at xs i))

  html-cce-runtime : Text
  html-cce-runtime =
    "var __cce_t0=[" & html-cce-list cce-to-unicode-table 0 "" & "],__cce_t1=[" & html-cce-list cce-tier1-block-bases 0 "" & "],__cce_t2=[" & html-cce-list cce-tier2-block-table 0 "" & "];\n"
    & "function __c2u(cp){if(cp<0)return 65533;if(cp<128)return __cce_t0[cp];if(cp<2176){var v=cp-128;var b=v<256?0:v<384?1:v<512?2:v<640?3:v<768?4:v<896?5:v<1024?6:v<1152?7:v<1664?8:v<1920?9:v<2048?10:-1;if(b<0)return 65533;"
    & "var off=v<256?v:v<1152?(v-256)%128:v<1664?v-1152:v<1920?v-1664:v-1920;return __cce_t1[b*2]+off}"
    & "if(cp<67712){var base=2176;for(var k=0;k*2<__cce_t2.length;k++){var size=__cce_t2[k*2+1];if(cp>=base&&cp<base+size)return __cce_t2[k*2]+(cp-base);base+=size}}return 65533}\n"
    & "function __u2c(u){var t=__cce_t0.indexOf(u);if(t>=0)return t;for(var b=0;b*2<__cce_t1.length;b++){var base=__cce_t1[b*2],size=__cce_t1[b*2+1];if(u>=base&&u<base+size){var start=b==0?128:b<8?256+b*128:b==8?1280:b==9?1792:b==10?2048:-1;return start<0?-1:start+(u-base)}}"
    & "var cb=2176;for(var k=0;k*2<__cce_t2.length;k++){var tb=__cce_t2[k*2],ts=__cce_t2[k*2+1];if(u>=tb&&u<tb+ts)return cb+(u-tb);cb+=ts}return -1}\n"
    & html-cce-text-runtime

 A page's Text holds whole code points where native Text holds CCE's encoded
 bytes, so CCE.codex's conversions, which assemble those bytes one at a time,
 run here as JavaScript: a code point CCE has no place for is dropped, as
 natively, and a malformed UTF-8 sequence is dropped too (TextDecoder's
 U+FFFD has no CCE place).

  html-cce-text-runtime : Text
  html-cce-text-runtime =
    "function utf8_bytes_to_text(bs){var s=new TextDecoder().decode(new Uint8Array(bs.map(Number))),o='';for(var ch of s){if(__u2c(ch.codePointAt(0))>=0)o+=ch}return o}\n"
    & "function text_to_unicode_bytes(t){var o=[];for(var ch of t)o.push(BigInt(ch.codePointAt(0)));return o}\n"
    & "function unicode_bytes_to_text(us){var o='';for(var i=0;i<us.length;i++){var u=Number(us[i]);if(__u2c(u)>=0)o+=String.fromCodePoint(u)}return o}\n"

  html-result-type : CodexType, Integer -> CodexType
  html-result-type (t) (n) =
    when t
     is ForAllTy (id) (body) -> html-result-type body n
     is ForAllEff (id) (body) -> html-result-type body n
     is EffectfulTy (effs) (sc) (ret) -> html-result-type ret n
     is FunTy (p) (row) (r) -> if n <= 0 then t else html-result-type r (n - 1)
     is otherwise -> t

  html-is-int-ty : CodexType -> Boolean
  html-is-int-ty (t) =
    when t
     is IntegerTy (lo) (hi) (mode) -> True
     is otherwise -> False

  html-int-wraps : List IRDef, Integer, Text -> Text
  html-int-wraps (defs) (i) (acc) =
    if i >= list-length defs then acc
    else let d = list-at defs i
    in let n = list-length (d.params)
    in if n > 0 & is-html-builtin (d.name) & html-is-int-ty (html-result-type (d.type-val) n)
       then let s = html-sanitize (d.name)
       in html-int-wraps defs (i + 1) (acc & "if (typeof " & s & " === 'function') { " & s & " = ((f) => (...a) => __int(f(...a)))(" & s & "); }\n")
    else html-int-wraps defs (i + 1) acc

  emit-dom-builtins : Text
  emit-dom-builtins =
    emit-dom-core & emit-dom-ajax & emit-dom-host & emit-dom-wasm & emit-dom-gpu & emit-dom-state & emit-dom-events & emit-dom-reactive & emit-dom-dialog & emit-dom-a11y & emit-dom-anim & emit-dom-persist & emit-dom-sd & emit-dom-theme & emit-dom-widget & emit-dom-svg

  emit-dom-svg : Text
  emit-dom-svg =
    "function _svgEl(t,o){var e=document.createElementNS('http://www.w3.org/2000/svg',t);for(var k in o)e.setAttribute(k,String(o[k]));return e}\n"
    & "function _svgOf(id){var a=document.getElementById(id);return a?a.querySelector('svg'):null}\n"
    & "function mount_svg(id,w,h){var a=document.getElementById(id);if(!a)return 0;a.innerHTML='';a.appendChild(_svgEl('svg',{width:w,height:h,viewBox:'0 0 '+w+' '+h,role:'img'}));return 0}\n"
    & "function svg_label(id,t){var s=_svgOf(id);if(s&&t)s.setAttribute('aria-label',t);return 0}\n"
    & "function svg_draw_cmds(id,cs){var s=_svgOf(id);if(!s)return 0;for(var i=0;i<cs.length;i++){var c=cs[i],t=c._tag,e=null;"
    & "if(t==='DrawLine')e=_svgEl('line',{x1:c._0,y1:c._1,x2:c._2,y2:c._3,stroke:_c(c._4)});"
    & "else if(t==='DrawRect')e=_svgEl('rect',{x:c._0,y:c._1,width:c._2,height:c._3,fill:c._5?_c(c._4):'none',stroke:c._5?'none':_c(c._4)});"
    & "else if(t==='DrawText'){e=_svgEl('text',{x:c._0,y:c._1,fill:_c(c._3),'dominant-baseline':'hanging'});e.textContent=c._2}"
    & "else if(t==='DrawCircle')e=_svgEl('circle',{cx:c._0,cy:c._1,r:c._2,fill:_c(c._3)});"
    & "if(e)s.appendChild(e)}return 0}\n"
    & "function _vecD(p){var cs=p.vp_commands||[],n=Math.min(Number(p.vp_count),cs.length),d=[],x=0,y=0,sx=0,sy=0;"
    & "for(var i=0;i<n;i++){var c=cs[i],t=c._tag;"
    & "if(t==='PcMoveTo'){x=Number(c._0);y=Number(c._1);sx=x;sy=y;d.push('M'+x+' '+y)}"
    & "else if(t==='PcLineTo'){x=Number(c._0);y=Number(c._1);d.push('L'+x+' '+y)}"
    & "else if(t==='PcBezierTo'){x=Number(c._4);y=Number(c._5);d.push('C'+c._0+' '+c._1+' '+c._2+' '+c._3+' '+x+' '+y)}"
    & "else if(t==='PcArcTo'){var cx=Number(c._0),cy=Number(c._1),rx=Number(c._2),ry=Number(c._3),a=Number(c._4)/1000,a0=Math.atan2(y-cy,x-cx),k=Math.max(1,Math.ceil(Math.abs(a)/Math.PI));"
    & "for(var j=1;j<=k;j++){x=cx+rx*Math.cos(a0+a*j/k);y=cy+ry*Math.sin(a0+a*j/k);d.push('A'+rx+' '+ry+' 0 0 '+(a>0?1:0)+' '+x+' '+y)}}"
    & "else if(t==='PcClose'){x=sx;y=sy;d.push('Z')}}return d.join(' ')}\n"
    & "function svg_fill_path(id,p,col){var s=_svgOf(id);if(!s)return 0;s.appendChild(_svgEl('path',{d:_vecD(p),fill:_c(col),'fill-rule':'evenodd',stroke:'none'}));return 0}\n"
    & "function svg_stroke_path(id,p,w,col){var s=_svgOf(id);if(!s)return 0;s.appendChild(_svgEl('path',{d:_vecD(p),fill:'none',stroke:_c(col),'stroke-width':w,'stroke-linecap':'square','stroke-linejoin':'miter'}));return 0}\n"

  emit-dom-core : Text
  emit-dom-core =
    "function dom_get(id){return document.getElementById(id);}\n"
    & "function dom_create(tag){return document.createElement(tag);}\n"
    & "function dom_set_attr(el,k,v){if(!el)return el;el.setAttribute(k,v);return el;}\n"
    & "function dom_set_text(el,s){if(!el)return el;el.textContent=s;return el;}\n"
    & "function dom_set_html(el,s){if(!el)return el;el.innerHTML=s;return el;}\n"
    & "function dom_get_value(el){return el?el.value||'':'';}\n"
    & "function dom_set_value(el,v){if(!el)return el;el.value=v;return el;}\n"
    & "function dom_append(p,c){if(!p||!c)return p;p.appendChild(c);return p;}\n"
    & "function dom_prepend(p,c){if(!p||!c)return p;p.prepend(c);return p;}\n"
    & "function dom_remove(el){if(el&&el.parentNode)el.parentNode.removeChild(el);return el;}\n"
    & "function dom_add_class(el,c){if(!el)return el;el.classList.add(c);return el;}\n"
    & "function dom_remove_class(el,c){if(!el)return el;el.classList.remove(c);return el;}\n"
    & "function dom_set_style(el,k,v){if(!el)return el;el.style[k]=v;return el;}\n"
    & "function dom_on(el,ev,fn){if(!el)return el;el.addEventListener(ev,fn);return el;}\n"
    & "function dom_query(sel){return document.querySelector(sel);}\n"
    & "function dom_body(){return document.body;}\n"
    & "function random_int(lo,hi){lo=BigInt(lo);hi=BigInt(hi);var span=hi-lo+1n;if(span<=0n)throw new RangeError('random-int lower bound exceeds upper bound');if(span===1n)return lo;var bits=(span-1n).toString(2).length,words=Math.ceil(bits/32),mask=(1n<<BigInt(bits))-1n,r;do{r=0n;for(var i=0;i<words;i++)r=(r<<32n)|BigInt(Math.floor(Math.random()*4294967296));r&=mask}while(r>=span);return lo+r}\n"
    & "function set_timeout(fn,ms){return setTimeout(function(){fn(0n)},Number(ms));}\n"
    & "var _actx=null;function _audioctx(){if(!_actx){try{_actx=new (window.AudioContext||window.webkitAudioContext)()}catch(e){return null}}if(_actx.state==='suspended'){try{_actx.resume()}catch(e){}}return _actx}\n"
    & "function play_tone(freq,ms,wave){freq=Number(freq);ms=Number(ms);wave=Number(wave);try{var c=_audioctx();if(!c)return 0;var o=c.createOscillator();var g=c.createGain();o.type=wave===1?'triangle':wave===2?'square':wave===3?'sawtooth':'sine';o.frequency.value=freq;o.connect(g);g.connect(c.destination);var t=c.currentTime;var d=ms/1000;g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.25,t+0.01);g.gain.exponentialRampToValueAtTime(0.0001,t+d);o.start(t);o.stop(t+d+0.02)}catch(e){}return 0}\n"
    & "function local_storage_get(k){try{return localStorage.getItem(k)||'';}catch(e){return'';}}\n"
    & "function local_storage_set(k,v){try{localStorage.setItem(k,v);}catch(e){}return 0;}\n"
    & "var _cc=0;function next_card_id(x){_cc++;return 'c'+_cc;}\n"

  emit-dom-ajax : Text
  emit-dom-ajax =
    "function fetch_json(u,m,b){var o={method:m,headers:{'Content-Type':'application/json'}};if(b)o.body=b;return fetch(u,o).then(function(r){return r.json();});}\n"
    & "function json_stringify(v){return JSON.stringify(v);}\n"
    & "function json_parse_rows(s){return JSON.parse(s);}\n"
    & "function json_parse_obj(s){return JSON.parse(s);}\n"
    & "function json_obj_field(o,k){if(o==null)return '';var v=o[k];return v==null?'':typeof v==='object'?JSON.stringify(v):String(v);}\n"
    & "function url_encode(s){return encodeURIComponent(s);}\n"
    & "function download_text(c,f,m){var b=new Blob([c],{type:m});var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=f;a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},1000);return 0;}\n"
    & "function fetch_then(u,m,b,cb){var o={method:m,headers:{'Content-Type':'application/json'}};"
    & "if(b)o.body=b;fetch(u,o).then(function(r){return r.json()})"
    & ".then(function(d){return json_stringify(d)}).then(function(s){cb(s)}"
    & ",function(e){cb('{\"error\":\"'+e.message+'\"}')});return 0}\n"
    & "function fetch_get_then(u,cb){return fetch_then(u,'GET','',cb)}\n"

  emit-dom-host : Text
  emit-dom-host =
    "function page_data(k){var d=window.__DATA||{};var v=d[k];return v==null?'':typeof v==='string'?v:JSON.stringify(v);}\n"
    & "function location_hash(x){return location.hash||'';}\n"
    & "function location_clear_hash(x){try{history.replaceState(null,'',location.pathname+location.search)}catch(e){}return 0;}\n"
    & "function on_hash_change(cb){window.addEventListener('hashchange',function(){cb(location.hash||'')});return 0;}\n"
    & "function uri_decode_component(s){try{return decodeURIComponent(s)}catch(e){return ''}}\n"
    & "function json_valid(s){try{var v=JSON.parse(s);return v!==null&&typeof v==='object'}catch(e){return false}}\n"
    & "function fetch_with_then(u,m,h,b,cb){var o={method:m,mode:'cors',headers:{}};try{var hh=h?JSON.parse(h):{};for(var k in hh)o.headers[k]=hh[k]}catch(e){}"
    & "if(b)o.body=b;fetch(u,o).then(function(r){return r.text()}).then(function(s){cb(s)}"
    & ",function(e){cb(JSON.stringify({ok:false,err:String(e&&e.message||e)}))});return 0;}\n"
    & "function pick_file_text(a,cb){var i=document.createElement('input');i.type='file';i.accept=a;i.onchange=function(){var f=i.files&&i.files[0];if(!f)return;"
    & "if(f.size>65536){cb('');return}f.text().then(function(t){cb(t)})};i.click();return 0;}\n"

 A WASI program here gets exactly two calls, fd_write and fd_read, and reads its
 input as one NUL-terminated stream; that is the contract the compiler and the
 plugs built for the browser are built against.

  emit-dom-wasm : Text
  emit-dom-wasm =
    "var _wasmMods={};function _wasmBytes(n){if(!_wasmMods[n]){var s=(window.__DATA||{})[n];if(!s)throw new Error(n+' is not in this page');"
    & "var b=atob(s),u=new Uint8Array(b.length);for(var i=0;i<b.length;i++)u[i]=b.charCodeAt(i);_wasmMods[n]=u.buffer}return _wasmMods[n]}\n"
    & "function _wasiRun(bytes,input){var mem=null,pos=0,chunks=[],total=0;var imp={wasi_snapshot_preview1:{"
    & "fd_write:function(fd,iovs,n,outp){var v=new DataView(mem.buffer),t=0;for(var i=0;i<n;i++){var p=v.getUint32(iovs+i*8,true),l=v.getUint32(iovs+i*8+4,true);"
    & "chunks.push(new Uint8Array(mem.buffer.slice(p,p+l)));total+=l;t+=l}v.setUint32(outp,t,true);return 0},"
    & "fd_read:function(fd,iovs,n,outp){var v=new DataView(mem.buffer),t=0;for(var i=0;i<n;i++){var p=v.getUint32(iovs+i*8,true),l=v.getUint32(iovs+i*8+4,true);"
    & "var d=new Uint8Array(mem.buffer,p,l),k=0;while(k<l&&pos<input.length){d[k++]=input[pos++]}t+=k;if(k<l)break}v.setUint32(outp,t,true);return 0}}};"
    & "var inst=new WebAssembly.Instance(new WebAssembly.Module(bytes),imp);mem=inst.exports.memory;inst.exports._start();"
    & "var all=new Uint8Array(total),o=0;for(var c of chunks){all.set(c,o);o+=c.length}return all}\n"
    & "var _ww=null,_wseq=0,_wwait={};\n"
    & "function wasm_run_then(n,s,cb){var bytes;var e0=new TextEncoder().encode(s);var input=new Uint8Array(e0.length+1);input.set(e0);"
    & "try{bytes=_wasmBytes(n)}catch(e){cb('!WASM '+e.message);return 0}"
    & "var direct=function(){try{cb(new TextDecoder().decode(_wasiRun(bytes,input)))}catch(e){cb('!WASM '+(e&&e.message||e))}};"
    & "try{if(!_ww){_ww=new Worker(URL.createObjectURL(new Blob(['var _wasiRun='+_wasiRun.toString()+';onmessage=function(e){try{var o=_wasiRun(e.data.b,e.data.i);postMessage({id:e.data.id,ok:true,o:o},[o.buffer])}catch(x){postMessage({id:e.data.id,ok:false,e:String(x&&x.message||x)})}}'],{type:'text/javascript'})));"
    & "_ww.onmessage=function(e){var w=_wwait[e.data.id];delete _wwait[e.data.id];if(w)w(e.data)}}}catch(e){_ww=null}"
    & "if(!_ww){setTimeout(direct,0);return 0}"
    & "var id=++_wseq;_wwait[id]=function(d){if(d.ok)cb(new TextDecoder().decode(d.o));else if(/call stack|stack size/i.test(d.e))direct();else cb('!WASM '+d.e)};"
    & "_ww.postMessage({id:id,b:bytes,i:input});return 0}\n"

 WebGPU exposes no device memory size, so the probe reports what it can see:
 the adapter's identity, its buffer limits, shader-f16, and a timed f32 GEMM.
 The GEMM's inputs are integers in -2..2, so every sum of N products is exact
 in f32 in any order, and 64 sampled outputs are compared for equality with
 the host's own dot products; a GEMM that computes nothing reports bad
 samples rather than a fast time.

  emit-dom-gpu : Text
  emit-dom-gpu =
    "function _gpuGemm(d,ms,o){var N=1024,A=new Float32Array(N*N),B=new Float32Array(N*N);for(var k=0;k<N*N;k++){A[k]=((k*7)%5)-2;B[k]=((k*13)%5)-2}"
    & "var S=GPUBufferUsage.STORAGE;var mk=function(x){var b=d.createBuffer({size:x.byteLength,usage:S,mappedAtCreation:true});new Float32Array(b.getMappedRange()).set(x);b.unmap();return b};"
    & "var bA=mk(A),bB=mk(B),bC=d.createBuffer({size:N*N*4,usage:S|GPUBufferUsage.COPY_SRC}),bR=d.createBuffer({size:N*N*4,usage:GPUBufferUsage.MAP_READ|GPUBufferUsage.COPY_DST});"
    & "var code='@group(0) @binding(0) var<storage,read> a:array<f32>;@group(0) @binding(1) var<storage,read> b:array<f32>;@group(0) @binding(2) var<storage,read_write> c:array<f32>;"
    & "var<workgroup> ta:array<f32,256>;var<workgroup> tb:array<f32,256>;@compute @workgroup_size(16,16) fn main(@builtin(global_invocation_id) g:vec3<u32>,@builtin(local_invocation_id) l:vec3<u32>){"
    & "let n='+N+'u;var s=0.0;for(var t=0u;t<n;t=t+16u){ta[l.y*16u+l.x]=a[g.y*n+t+l.x];tb[l.y*16u+l.x]=b[(t+l.y)*n+g.x];workgroupBarrier();"
    & "for(var k=0u;k<16u;k=k+1u){s=s+ta[l.y*16u+k]*tb[k*16u+l.x];}workgroupBarrier();}c[g.y*n+g.x]=s;}';"
    & "var p=d.createComputePipeline({layout:'auto',compute:{module:d.createShaderModule({code:code}),entryPoint:'main'}});"
    & "var bg=d.createBindGroup({layout:p.getBindGroupLayout(0),entries:[{binding:0,resource:{buffer:bA}},{binding:1,resource:{buffer:bB}},{binding:2,resource:{buffer:bC}}]});"
    & "var run=function(){var e=d.createCommandEncoder(),c=e.beginComputePass();c.setPipeline(p);c.setBindGroup(0,bg);c.dispatchWorkgroups(N/16,N/16);c.end();d.queue.submit([e.finish()]);return d.queue.onSubmittedWorkDone()};"
    & "var t0=0,runs=0;var loop=function(){return run().then(function(){runs++;if(performance.now()-t0<ms&&runs<500)return loop()})};"
    & "return run().then(function(){t0=performance.now();return loop()}).then(function(){var sec=(performance.now()-t0)/1000;o.n=N;o.runs=runs;o.seconds=sec;o.gflops=2*N*N*N*runs/sec/1e9;"
    & "var e=d.createCommandEncoder();e.copyBufferToBuffer(bC,0,bR,0,N*N*4);d.queue.submit([e.finish()]);return bR.mapAsync(GPUMapMode.READ)}).then(function(){"
    & "var C=new Float32Array(bR.getMappedRange()),bad=0;for(var s=0;s<64;s++){var i=(s*9973)%N,j=(s*7919+s)%N,v=0;for(var k=0;k<N;k++)v+=A[i*N+k]*B[k*N+j];if(C[i*N+j]!==v)bad++}"
    & "o.checked=64;o.bad=bad;bR.unmap();d.destroy()})}\n"
    & "function gpu_probe_then(ms,cb){ms=Number(ms);var o={webgpu:!!(typeof navigator!=='undefined'&&navigator.gpu)};var fin=function(){cb(JSON.stringify(o))};"
    & "if(!o.webgpu){o.err='no-webgpu';fin();return 0}"
    & "navigator.gpu.requestAdapter({powerPreference:'high-performance'}).then(function(a){if(!a){o.err='no-adapter';return null}"
    & "var i=a.info||{};o.vendor=i.vendor||'';o.architecture=i.architecture||'';o.device=i.device||'';o.description=i.description||'';o.fallback=!!(a.isFallbackAdapter||i.isFallbackAdapter);"
    & "o.maxBufferSize=Number(a.limits.maxBufferSize);o.maxStorageBufferBindingSize=Number(a.limits.maxStorageBufferBindingSize);o.f16=a.features.has('shader-f16');"
    & "return a.requestDevice().then(function(d){return _gpuGemm(d,ms,o)})}).then(fin,function(e){o.err=String(e&&e.message||e);fin()});return 0}\n"

  html-uses-gpu-bridge : List IRDef, Integer -> Boolean
  html-uses-gpu-bridge (defs) (i) =
    if i >= list-length defs then False
    else if html-is-gpu-bridge ((list-at defs i).name) then True
    else html-uses-gpu-bridge defs (i + 1)

  html-uses-byte-heap : Text -> Boolean
  html-uses-byte-heap (js) = text-contains js "alloc_bytes(" | text-contains js "peek_byte(" | text-contains js "poke_byte(" | text-contains js "peek_32(" | text-contains js "poke_32(" | text-contains js "__memset(" | text-contains js "file_save_bytes_then("

 The byte heap behind alloc-bytes, peek and poke: one growable ArrayBuffer, an
 address being a byte offset into it from 16 (0 stays null); peek-32
 zero-extends, a poke answers 0 and __memset its address, as the C# plug's
 _Buf does.

  emit-dom-byte-heap : Text
  emit-dom-byte-heap =
    "var _hb=new ArrayBuffer(1048576),_hv=new DataView(_hb),_hu=new Uint8Array(_hb),_hp=16;\n"
    & "function _hgrow(n){if(n<=_hb.byteLength)return;var c=_hb.byteLength;while(c<n)c*=2;var b=new ArrayBuffer(c);new Uint8Array(b).set(_hu);_hb=b;_hv=new DataView(b);_hu=new Uint8Array(b)}\n"
    & "function alloc_bytes(n){var a=_hp;_hp=Math.ceil((_hp+Number(n))/8)*8;_hgrow(_hp);return BigInt(a)}\n"
    & "function peek_byte(b,o){return BigInt(_hu[Number(b)+Number(o)])}\n"
    & "function poke_byte(b,o,v){_hu[Number(b)+Number(o)]=Number(BigInt.asUintN(8,BigInt(v)));return 0n}\n"
    & "function peek_32(b,o){return BigInt(_hv.getUint32(Number(b)+Number(o),true))}\n"
    & "function poke_32(b,o,v){_hv.setUint32(Number(b)+Number(o),Number(BigInt.asUintN(32,BigInt(v))),true);return 0n}\n"
    & "function __memset(b,v,n){_hu.fill(Number(BigInt.asUintN(8,BigInt(v))),Number(b),Number(b)+Number(n));return b}\n"

  emit-dom-noise-bank : Text
  emit-dom-noise-bank =
    "var _noiseJobs=new Map(),_noiseSeq=0;\n"
