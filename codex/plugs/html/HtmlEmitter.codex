Chapter: HTML Emitter
  cites Codex chapter Text
  cites Codex chapter Characters
  cites Codex chapter Lists

 Generates HTML + CSS + JavaScript from the IR.

Section: Keywords and Sanitization

  html-sanitize : Text -> Text
  html-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

  html-escape : Text -> Text
  html-escape (s) =
   let s1 = text-replace s "&" "&amp;"
   in let s2 = text-replace s1 "<" "&lt;"
   in let s3 = text-replace s2 ">" "&gt;"
   in let s4 = text-replace s3 "\"" "&quot;"
   in s4

  js-escape : Text -> Text
  js-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in let s4 = text-replace s3 "'" "\\'"
   in s4

  html-indent : Integer -> Text
  html-indent (n) =
   if n <= 0 then ""
   else "  " & html-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = list-length (d.params),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then 0
      else let e = list-at entries pos
      in if e.name == name then e.arity else 0

Section: Type Emission

  emit-html-type : CodexType -> Text
  emit-html-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "number"
    is RealTy -> "number"
    is TextTy -> "string"
    is BooleanTy -> "boolean"
    is CharTy -> "string"
    is VoidTy -> "void"
    is NothingTy -> "void"
    is ErrorTy -> "any"
    is FunTy (p) (r) -> "Function"
    is ListTy (elem) -> "Array"
    is LinkedListTy (elem) -> "Array"
    is TypeVar (id) -> "any"
    is ForAllTy (id) (body) -> emit-html-type body
    is SumTy (name) (ty-args) (ctors) -> name.value
    is RecordTy (name) (args) (fields) -> name.value
    is ConstructedTy (name) (args) -> name.value
    is VectorTy (vn) (vt) -> "Array"
    is EffectfulTy (effs) (sc) (ret) -> emit-html-type ret

Section: JavaScript Expression Emission

  emit-js-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-js-expr (e) (arities) (indent) =
   when e
    is IrIntLit (n) (sp) -> show n
    is IrNumLit (n) (sp) -> show n
    is IrTextLit (s) (sp) -> "\"" & js-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> "String.fromCharCode(" & show n & ")"
    is IrName (n) (ty) (sp) -> html-sanitize n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-js-binary op l r arities indent
    is IrNegate (x) (sp) -> "(-(" & emit-js-expr x arities indent & "))"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-js-expr c arities indent & " ? " & emit-js-expr t arities indent & " : " & emit-js-expr el arities indent & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> emit-js-let name val body arities indent
    is IrApply (f) (a) (ty) (sp) -> emit-js-apply e arities indent
    is IrLambda (params) (body) (ty) (sp) -> emit-js-lambda params body arities indent
    is IrList (elems) (ty) (sp) -> "[" & emit-js-list-elems elems arities indent 0 & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-js-match scrut branches arities indent
    is IrAct (stmts) (ty) (sp) -> emit-js-act stmts arities indent
    is IrRecord (name) (fields) (ty) (sp) -> emit-js-record name fields arities indent
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-js-expr rec arities indent & "." & html-sanitize field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(" & emit-js-expr rec arities indent & "." & html-sanitize field & " = " & emit-js-expr val arities indent & ")"
    is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => " & emit-js-expr body arities indent & ")"
    is IrAwait (task) (ty) (sp) -> "(await " & emit-js-expr task arities indent & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> "(console.warn('effect handler not supported in web target'), " & emit-js-expr body arities indent & ")"
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> "(console.warn('with-timeout not supported in web target'), " & emit-js-expr body arities indent & ")"
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-js-try max body fb fail arities indent
    is IrError (msg) (ty) (sp) -> "(() => { throw new Error(" & "\"" & js-escape msg & "\"" & "); })()"

Section: Binary Operators

  emit-js-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-js-binary (op) (l) (r) (arities) (indent) =
   let lhs = emit-js-expr l arities indent
   in let rhs = emit-js-expr r arities indent
   in when op
    is IrAddInt -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt -> "Math.trunc(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "(" & lhs & " % " & rhs & ")"
    is IrPowInt -> "(" & lhs & " ** " & rhs & ")"
    is IrAddNum -> "(" & lhs & " + " & rhs & ")"
    is IrSubNum -> "(" & lhs & " - " & rhs & ")"
    is IrMulNum -> "(" & lhs & " * " & rhs & ")"
    is IrDivNum -> "(" & lhs & " / " & rhs & ")"
    is IrEq -> "(" & lhs & " === " & rhs & ")"
    is IrNotEq -> "(" & lhs & " !== " & rhs & ")"
    is IrLt -> "(" & lhs & " < " & rhs & ")"
    is IrGt -> "(" & lhs & " > " & rhs & ")"
    is IrLtEq -> "(" & lhs & " <= " & rhs & ")"
    is IrGtEq -> "(" & lhs & " >= " & rhs & ")"
    is IrApproxEq -> "(" & lhs & " === " & rhs & ")"
    is IrApproxEqExact -> "(" & lhs & " === " & rhs & ")"
    is IrAnd -> "(" & lhs & " && " & rhs & ")"
    is IrOr -> "(" & lhs & " || " & rhs & ")"
    is IrAppendText -> "(" & lhs & " + " & rhs & ")"
    is IrAppendList -> "(" & lhs & ".concat(" & rhs & "))"
    is IrConsList -> "[" & lhs & ", ..." & rhs & "]"
    is IrAddVec -> "(" & lhs & ".map((v,i) => v + " & rhs & "[i]))"
    is IrSubVec -> "(" & lhs & ".map((v,i) => v - " & rhs & "[i]))"
    is IrMulVec -> "(" & lhs & ".map((v,i) => v * " & rhs & "[i]))"
    is IrDivVec -> "(" & lhs & ".map((v,i) => v / " & rhs & "[i]))"

Section: Let Bindings

  emit-js-let : Text, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-js-let (name) (val) (body) (arities) (indent) =
   "(() => {\n" & html-indent (indent + 1) & "const " & html-sanitize name & " = " & emit-js-expr val arities (indent + 1) & ";\n" & emit-js-let-tail body arities (indent + 1) & html-indent indent & "})()"

  emit-js-let-tail : IRExpr, List ArityEntry, Integer -> Text
  emit-js-let-tail (body) (arities) (indent) =
   when body
    is IrLet (name) (ty) (val) (inner) (sp) -> html-indent indent & "const " & html-sanitize name & " = " & emit-js-expr val arities indent & ";\n" & emit-js-let-tail inner arities indent
    is otherwise -> html-indent indent & "return " & emit-js-expr body arities indent & ";\n"

Section: Apply

  FlatApply = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-js-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-js-apply (e) (arities) (indent) =
   let chain = collect-apply-chain e []
   in when (chain.root)
    is IrName (n) (ty) (sp) -> if is-mktup-name n then "[" & emit-js-apply-args (chain.args) arities indent 0 & "]"
     else let func = emit-js-expr (chain.root) arities indent
     in let args = emit-js-apply-args (chain.args) arities indent 0
     in func & "(" & args & ")"
    is otherwise -> let func = emit-js-expr (chain.root) arities indent
     in let args = emit-js-apply-args (chain.args) arities indent 0
     in func & "(" & args & ")"

  emit-js-apply-args : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-js-apply-args (args) (arities) (indent) (i) =
   if i == list-length args then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-js-expr (list-at args i) arities indent & emit-js-apply-args args arities indent (i + 1)

Section: Lambda

  emit-js-lambda : List IRParam, IRExpr, List ArityEntry, Integer -> Text
  emit-js-lambda (params) (body) (arities) (indent) =
   "(" & emit-js-param-names params 0 & ") => " & emit-js-expr body arities indent

  emit-js-param-names : List IRParam, Integer -> Text
  emit-js-param-names (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & html-sanitize (list-at params i).name & emit-js-param-names params (i + 1)

Section: List

  emit-js-list-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-js-list-elems (elems) (arities) (indent) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-js-expr (list-at elems i) arities indent & emit-js-list-elems elems arities indent (i + 1)

Section: Match

  emit-js-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-js-match (scrut) (branches) (arities) (indent) =
   let sv = emit-js-expr scrut arities indent
   in "(() => {\n" & html-indent (indent + 1) & "const _s = " & sv & ";\n" & emit-js-branches branches arities (indent + 1) 0 & html-indent indent & "})()"

  emit-js-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-js-branches (branches) (arities) (indent) (i) =
   if i == list-length branches then html-indent indent & "throw new Error('non-exhaustive match');\n"
   else let b = list-at branches i
   in let cond = emit-js-pattern-cond (b.pattern) "_s"
   in let binds = emit-js-pattern-binds (b.pattern) "_s" indent
   in let body = emit-js-expr (b.body) arities indent
   in let kw = if i == 0 then "if" else "else if"
   in html-indent indent & kw & " (" & cond & ") {\n" & binds & html-indent (indent + 1) & "return " & body & ";\n" & html-indent indent & "}\n" & emit-js-branches branches arities indent (i + 1)

  emit-js-pattern-cond : IRPat, Text -> Text
  emit-js-pattern-cond (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "true"
    is IrLitPat (text) (ty) (sp) -> scrut & " === " & text
    is IrCtorPat (name) (subs) (ty) (sp) -> if is-mktup-name name then "true" else scrut & "._tag === \"" & name & "\""
    is IrWildPat (sp) -> "true"

  emit-js-pattern-binds : IRPat, Text, Integer -> Text
  emit-js-pattern-binds (p) (scrut) (indent) =
   when p
    is IrVarPat (name) (ty) (sp) -> html-indent (indent + 1) & "const " & html-sanitize name & " = " & scrut & ";\n"
    is IrLitPat (text) (ty) (sp) -> ""
    is IrCtorPat (name) (subs) (ty) (sp) -> if is-mktup-name name then emit-js-tuple-binds subs scrut indent 0 else emit-js-ctor-binds subs scrut indent 0
    is IrWildPat (sp) -> ""

  emit-js-ctor-binds : List IRPat, Text, Integer, Integer -> Text
  emit-js-ctor-binds (subs) (scrut) (indent) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in let field-access = scrut & "._" & show i
   in emit-js-pattern-binds sub field-access indent & emit-js-ctor-binds subs scrut indent (i + 1)

Section: Act Blocks

  emit-js-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-js-act (stmts) (arities) (indent) =
   "(() => {\n" & emit-js-act-stmts stmts arities (indent + 1) 0 & html-indent indent & "})()"

  emit-js-act-stmts : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-js-act-stmts (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in emit-js-act-stmt s arities indent (i == list-length stmts - 1) & emit-js-act-stmts stmts arities indent (i + 1)

  emit-js-act-stmt : IRActStmt, List ArityEntry, Integer, Boolean -> Text
  emit-js-act-stmt (s) (arities) (indent) (is-last) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> html-indent indent & "const " & html-sanitize name & " = " & emit-js-expr val arities indent & ";\n"
    is IrDoExec (e) (sp) ->
     if is-last then html-indent indent & "return " & emit-js-expr e arities indent & ";\n"
     else html-indent indent & emit-js-expr e arities indent & ";\n"

Section: Records

  emit-js-record : Text, List IRFieldVal, List ArityEntry, Integer -> Text
  emit-js-record (name) (fields) (arities) (indent) =
   "{ _type: \"" & name & "\"" & emit-js-record-fields fields arities indent 0 & " }"

  emit-js-record-fields : List IRFieldVal, List ArityEntry, Integer, Integer -> Text
  emit-js-record-fields (fields) (arities) (indent) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ", " & html-sanitize (f.name) & ": " & emit-js-expr (f.value) arities indent & emit-js-record-fields fields arities indent (i + 1)

Section: Try

  emit-js-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, List ArityEntry, Integer -> Text
  emit-js-try (max) (body) (fb) (fail) (arities) (indent) =
   "(() => {\n" & html-indent (indent + 1) & "for (let _try = 0; _try < " & show max & "; _try++) {\n" & html-indent (indent + 2) & "try {\n" & emit-js-act-stmts body arities (indent + 3) 0 & html-indent (indent + 2) & "} catch (_e) { continue; }\n" & html-indent (indent + 1) & "}\n" & emit-js-act-stmts fail arities (indent + 1) 0 & html-indent indent & "})()"

Section: Type Definitions

  emit-js-type-def : ATypeDef -> Text
  emit-js-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     "function " & html-sanitize (name.value) & "(fields) { return { _type: \"" & name.value & "\", ...fields }; }\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else emit-js-variant-ctors ctors 0

  emit-js-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-js-variant-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in emit-js-variant-ctor c & emit-js-variant-ctors ctors (i + 1)

  emit-js-variant-ctor : AVariantCtorDef -> Text
  emit-js-variant-ctor (c) =
   let n = list-length (c.fields)
   in if n == 0 then "const " & html-sanitize (c.name.value) & " = { _tag: \"" & c.name.value & "\" };\n"
      else "function " & html-sanitize (c.name.value) & "(" & emit-js-ctor-params n 0 & ") { return { _tag: \"" & c.name.value & "\"" & emit-js-ctor-fields n 0 & " }; }\n"

  emit-js-ctor-params : Integer, Integer -> Text
  emit-js-ctor-params (n) (i) =
   if i == n then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "_" & show i & emit-js-ctor-params n (i + 1)

  emit-js-ctor-fields : Integer, Integer -> Text
  emit-js-ctor-fields (n) (i) =
   if i == n then ""
   else ", _" & show i & ": _" & show i & emit-js-ctor-fields n (i + 1)

Section: Definition Emission

  is-html-builtin : Text -> Boolean
  is-html-builtin (n) =
   if text-starts-with n "dom-" then True
   else if n == "random-int" then True
   else if n == "fetch-json" then True
   else if n == "json-stringify" then True
   else if n == "json-parse" then True
   else if n == "json-parse-obj" then True
   else if n == "json-obj-field" then True
   else if n == "url-encode" then True
   else if n == "download-text" then True
   else if n == "set-timeout" then True
   else if n == "local-storage-get" then True
   else if n == "local-storage-set" then True
   else if n == "generate-image" then True
   else if n == "check-sd-status" then True
   else if n == "mount-widget" then True
   else if n == "int-to-css-color" then True
   else if n == "mount-widget-themed" then True
   else if n == "mount-widget-into" then True
   else if n == "register-handlers" then True
   else if n == "state-get" then True
   else if n == "state-set" then True
   else if n == "state-get-text" then True
   else if n == "state-set-text" then True
   else if n == "next-card-id" then True
   else if n == "theme-to-css" then True
   else if n == "inject-theme-css" then True
   else if n == "fetch-then" then True
   else if n == "fetch-get-then" then True
   else if n == "dom-on-click" then True
   else if n == "dom-on-input" then True
   else if n == "dom-on-key" then True
   else if n == "set-render" then True
   else if n == "state-set-render" then True
   else if n == "state-set-text-render" then True
   else if n == "request-render" then True
   else if n == "show-alert" then True
   else if n == "show-confirm" then True
   else if n == "show-prompt" then True
   else if n == "close-dialog" then True
   else if n == "dom-set-aria" then True
   else if n == "dom-set-role" then True
   else if n == "css-animate-spin" then True
   else if n == "css-animate-pulse" then True
   else if n == "css-animate-bounce" then True
   else if n == "css-transition" then True
   else if n == "save-theme" then True
   else if n == "load-theme" then True
   else if n == "save-layout" then True
   else if n == "load-layout" then True
   else False

  emit-js-def : IRDef, List ArityEntry -> Text
  emit-js-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else if is-html-builtin (d.name) then ""
   else let sname = html-sanitize (d.name)
   in if list-length (d.params) == 0
      then "const " & sname & " = " & emit-js-expr (d.body) arities 0 & ";\n\n"
      else "function " & sname & "(" & emit-js-param-names (d.params) 0 & ") {\n  return " & emit-js-expr (d.body) arities 1 & ";\n}\n\n"

  emit-js-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-js-defs (defs) (i) (arities) =
   text-concat-list (emit-js-defs-acc defs i (list-length defs) arities [])

  emit-js-defs-acc : List IRDef, Integer, Integer, List ArityEntry, List Text -> List Text
  emit-js-defs-acc (defs) (i) (len) (arities) (acc) =
   if i >= len then acc
   else emit-js-defs-acc defs (i + 1) len arities (list-push acc (emit-js-def (list-at defs i) arities))

Section: HTML Page Assembly

  emit-html-page : Text, Text, Text -> Text
  emit-html-page (title) (css) (js) =
   "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" & html-escape title & "</title>\n  <style>\n" & css & "  </style>\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script>\n" & js & "  </script>\n</body>\n</html>\n"

  emit-default-css : Text
  emit-default-css =
   "    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    #app { display: contents; }\n"

Section: Chapter Emission

  opening-return-type : List IRDef -> CodexType
  opening-return-type (defs) =
   opening-return-type-loop defs 0 (list-length defs)

  opening-return-type-loop : List IRDef, Integer, Integer -> CodexType
  opening-return-type-loop (defs) (i) (len) =
   if i >= len then NothingTy
   else let d = list-at defs i
   in if d.name == "opening" then d.type-val
      else opening-return-type-loop defs (i + 1) len

  emit-html-chapter : IRChapter, List ATypeDef -> Text
  emit-html-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let title = if m.chapter-title == "" then "Codex App" else m.chapter-title
   in let builtins = "function print_line_uni(s) { const el = document.createElement('div'); el.textContent = s; document.getElementById('app').appendChild(el); }\nfunction print_line(s) { print_line_uni(s); }\nfunction show(n) { return String(n); }\nfunction text_length(s) { return s.length; }\nfunction text_replace(s, a, b) { return s.split(a).join(b); }\nfunction text_compare(a, b) { return a < b ? -1 : a > b ? 1 : 0; }\nfunction list_length(xs) { return xs.length; }\nfunction list_at(xs, i) { return xs[i]; }\nfunction list_push(xs, x) { return [...xs, x]; }\nfunction integer_to_text(n) { return String(n); }\nfunction char_code(c) { return c.charCodeAt ? c.charCodeAt(0) : c; }\nfunction char_at(s, i) { return s[i]; }\nfunction negate(n) { return -n; }\nfunction bit_xor(a,b){return (Math.trunc(a)^Math.trunc(b));}\nfunction bit_and(a,b){return (Math.trunc(a)&Math.trunc(b));}\nfunction bit_or(a,b){return (Math.trunc(a)|Math.trunc(b));}\nfunction bit_shl(a,n){return (Math.trunc(a)<<n);}\nfunction bit_shr(a,n){return (Math.trunc(a)>>n);}\nfunction bit_shru(a,n){return (Math.trunc(a)>>>n);}\nfunction bit_not(a){return (~Math.trunc(a));}\n\n"
   in let types-text = emit-js-type-defs type-defs 0
   in let defs-text = emit-js-defs (m.defs) 0 arities
   in let arity = lookup-arity arities "opening"
   in let entry = if arity > 0 then "// Entry\ntry { opening(); } catch(e) { console.error(e); }\n" else "// Entry: opening evaluated as const\n"
   in let dom-bi = emit-dom-builtins
   in let js = builtins & dom-bi & types-text & defs-text & entry
   in emit-html-page title (emit-default-css) js

  emit-dom-builtins : Text
  emit-dom-builtins =
   emit-dom-core & emit-dom-ajax & emit-dom-state & emit-dom-events & emit-dom-reactive & emit-dom-dialog & emit-dom-a11y & emit-dom-anim & emit-dom-persist & emit-dom-sd & emit-dom-theme & emit-dom-widget

  emit-dom-core : Text
  emit-dom-core =
   "function dom_get(id){return document.getElementById(id);}\n"
   & "function dom_create(tag){return document.createElement(tag);}\n"
   & "function dom_set_attr(el,k,v){el.setAttribute(k,v);return el;}\n"
   & "function dom_set_text(el,s){el.textContent=s;return el;}\n"
   & "function dom_set_html(el,s){el.innerHTML=s;return el;}\n"
   & "function dom_get_value(el){return el.value||'';}\n"
   & "function dom_set_value(el,v){el.value=v;return el;}\n"
   & "function dom_append(p,c){p.appendChild(c);return p;}\n"
   & "function dom_prepend(p,c){p.prepend(c);return p;}\n"
   & "function dom_remove(el){if(el.parentNode)el.parentNode.removeChild(el);return el;}\n"
   & "function dom_add_class(el,c){el.classList.add(c);return el;}\n"
   & "function dom_remove_class(el,c){el.classList.remove(c);return el;}\n"
   & "function dom_set_style(el,k,v){el.style[k]=v;return el;}\n"
   & "function dom_on(el,ev,fn){el.addEventListener(ev,fn);return el;}\n"
   & "function dom_query(sel){return document.querySelector(sel);}\n"
   & "function dom_body(){return document.body;}\n"
   & "function random_int(lo,hi){return lo+Math.floor(Math.random()*(hi-lo+1));}\n"
   & "function set_timeout(fn,ms){return setTimeout(fn,ms);}\n"
   & "var _actx=null;function _audioctx(){if(!_actx){try{_actx=new (window.AudioContext||window.webkitAudioContext)()}catch(e){return null}}if(_actx.state==='suspended'){try{_actx.resume()}catch(e){}}return _actx}\n"
   & "function play_tone(freq,ms,wave){try{var c=_audioctx();if(!c)return 0;var o=c.createOscillator();var g=c.createGain();o.type=wave===1?'triangle':wave===2?'square':wave===3?'sawtooth':'sine';o.frequency.value=freq;o.connect(g);g.connect(c.destination);var t=c.currentTime;var d=ms/1000;g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.25,t+0.01);g.gain.exponentialRampToValueAtTime(0.0001,t+d);o.start(t);o.stop(t+d+0.02)}catch(e){}return 0}\n"
   & "function local_storage_get(k){try{return localStorage.getItem(k)||'';}catch(e){return'';}}\n"
   & "function local_storage_set(k,v){try{localStorage.setItem(k,v);}catch(e){}return 0;}\n"
   & "var _cc=0;function next_card_id(x){_cc++;return 'c'+_cc;}\n"

  emit-dom-ajax : Text
  emit-dom-ajax =
   "function fetch_json(u,m,b){var o={method:m,headers:{'Content-Type':'application/json'}};if(b)o.body=b;return fetch(u,o).then(function(r){return r.json();});}\n"
   & "function json_stringify(v){return JSON.stringify(v);}\n"
   & "function json_parse(s){return JSON.parse(s);}\n"
   & "function json_parse_obj(s){return JSON.parse(s);}\n"
   & "function json_obj_field(o,k){if(o==null)return '';var v=o[k];return v==null?'':typeof v==='object'?JSON.stringify(v):String(v);}\n"
   & "function url_encode(s){return encodeURIComponent(s);}\n"
   & "function download_text(c,f,m){var b=new Blob([c],{type:m});var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=f;a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},1000);return 0;}\n"
   & "function fetch_then(u,m,b,cb){var o={method:m,headers:{'Content-Type':'application/json'}};"
   & "if(b)o.body=b;fetch(u,o).then(function(r){return r.json()})"
   & ".then(function(d){cb(json_stringify(d))})"
   & ".catch(function(e){cb('{\"error\":\"'+e.message+'\"}')});return 0}\n"
   & "function fetch_get_then(u,cb){return fetch_then(u,'GET','',cb)}\n"

  emit-dom-state : Text
  emit-dom-state =
   "var _st={};function state_get(k){return _st[k]!==undefined?_st[k]:0;}function state_set(k,v){_st[k]=v;return v;}function state_get_text(k){return _st[k]||'';}function state_set_text(k,v){_st[k]=v;return v;}\n"

  emit-dom-events : Text
  emit-dom-events =
   "function dom_on_click(el,cb){el.addEventListener('click',function(){cb(el.id||'')});return el}\n"
   & "function dom_on_input(el,cb){el.addEventListener('input',function(){cb(el.value||'')});return el}\n"
   & "function dom_on_key(el,cb){el.addEventListener('keydown',function(e){cb(e.key)});return el}\n"

  emit-dom-reactive : Text
  emit-dom-reactive =
   "var _renderFn=null;var _renderPending=false;\n"
   & "function set_render(fn){_renderFn=fn;return 0}\n"
   & "function request_render(x){if(_renderFn&&!_renderPending){"
   & "_renderPending=true;requestAnimationFrame(function(){"
   & "_renderPending=false;_renderFn(0)})}return 0}\n"
   & "function state_set_render(k,v){_st[k]=v;request_render(0);return v}\n"
   & "function state_set_text_render(k,v){_st[k]=v;request_render(0);return v}\n"

  emit-dom-dialog : Text
  emit-dom-dialog = emit-dom-dialog-a & emit-dom-dialog-b & emit-dom-dialog-c

  emit-dom-dialog-a : Text
  emit-dom-dialog-a =
   "function _dlg(t,m,bs,inp){var d=document.createElement('dialog');"
   & "d.className='wk-dialog';"
   & "d.innerHTML='<h3>'+t+'</h3><p>'+m+'</p>';"
   & "if(inp){var i=document.createElement('input');"
   & "i.id='dlg-input';i.className='wk-input';"
   & "i.placeholder=inp;d.appendChild(i)}\n"

  emit-dom-dialog-b : Text
  emit-dom-dialog-b =
   "var r=document.createElement('div');"
   & "r.className='wk-row';r.style.gap='8px';"
   & "r.style.justifyContent='flex-end';r.style.marginTop='12px';"
   & "bs.forEach(function(b){var btn=document.createElement('button');"
   & "btn.className='wk-btn';btn.textContent=b.text;"
   & "btn.addEventListener('click',function(){d.close(b.val)});"
   & "r.appendChild(btn)});"
   & "d.appendChild(r);document.body.appendChild(d);return d}\n"

  emit-dom-dialog-c : Text
  emit-dom-dialog-c =
   "function show_alert(t,m,cb){"
   & "var d=_dlg(t,m,[{text:'OK',val:'ok'}],null);"
   & "d.addEventListener('close',function(){d.remove();cb('ok')});"
   & "d.showModal();return 0}\n"
   & "function show_confirm(t,m,cb){"
   & "var d=_dlg(t,m,[{text:'Cancel',val:'cancel'},{text:'OK',val:'ok'}],null);"
   & "d.addEventListener('close',function(){d.remove();"
   & "cb(d.returnValue||'cancel')});d.showModal();return 0}\n"
   & "function show_prompt(t,m,p,cb){"
   & "var d=_dlg(t,m,[{text:'Cancel',val:'cancel'},{text:'OK',val:'ok'}],p);"
   & "d.addEventListener('close',function(){"
   & "var v=d.returnValue==='ok'?(d.querySelector('#dlg-input')||{}).value||'':'';"
   & "d.remove();cb(v)});d.showModal();return 0}\n"
   & "function close_dialog(x){var d=document.querySelector('dialog[open]');"
   & "if(d)d.close();return 0}\n"

  emit-dom-a11y : Text
  emit-dom-a11y =
   "function dom_set_aria(el,k,v){el.setAttribute('aria-'+k,v);return el}\n"
   & "function dom_set_role(el,r){el.setAttribute('role',r);return el}\n"

  emit-dom-anim : Text
  emit-dom-anim = emit-dom-anim-setup & emit-dom-anim-fns

  emit-dom-anim-setup : Text
  emit-dom-anim-setup =
   "var _animCSS=false;function _ensureAnim(){if(_animCSS)return;"
   & "_animCSS=true;var s=document.createElement('style');"
   & "s.textContent='@keyframes wk-spin{to{transform:rotate(360deg)}}"
   & "@keyframes wk-pulse{0%,100%{opacity:1}50%{opacity:.4}}"
   & "@keyframes wk-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}';"
   & "document.head.appendChild(s)}\n"

  emit-dom-anim-fns : Text
  emit-dom-anim-fns =
   "function css_animate_spin(el,ms){_ensureAnim();"
   & "el.style.animation='wk-spin '+ms+'ms linear infinite';return el}\n"
   & "function css_animate_pulse(el,ms){_ensureAnim();"
   & "el.style.animation='wk-pulse '+ms+'ms ease-in-out infinite';return el}\n"
   & "function css_animate_bounce(el,ms){_ensureAnim();"
   & "el.style.animation='wk-bounce '+ms+'ms ease-in-out infinite';return el}\n"
   & "function css_transition(el,prop,ms){"
   & "el.style.transition=prop+' '+ms+'ms ease';return el}\n"

  emit-dom-persist : Text
  emit-dom-persist = emit-dom-persist-theme & emit-dom-persist-layout

  emit-dom-persist-theme : Text
  emit-dom-persist-theme =
   "function save_theme(n,th){try{localStorage.setItem('codex-theme-'+n,JSON.stringify(th))}catch(e){}return 0}\n"
   & "function load_theme(n){try{var s=localStorage.getItem('codex-theme-'+n);return s?JSON.parse(s):null}catch(e){return null}}\n"

  emit-dom-persist-layout : Text
  emit-dom-persist-layout =
   "function save_layout(n,w){try{localStorage.setItem('codex-layout-'+n,JSON.stringify(w))}catch(e){}return 0}\n"
   & "function load_layout(n){try{var s=localStorage.getItem('codex-layout-'+n);return s?JSON.parse(s):null}catch(e){return null}}\n"

  emit-dom-sd : Text
  emit-dom-sd =
   "function check_sd_status(x){fetch('/api/config').then(function(r){return r.json();}).then(function(d){"
   & "var dot=dom_get('sd-dot');var lbl=dom_get('sd-label');"
   & "if(dot)dot.style.background='#4caf50';if(lbl)lbl.textContent=(d.current_model||'SD').split('.')[0].substring(0,25);"
   & "}).catch(function(){var dot=dom_get('sd-dot');var lbl=dom_get('sd-label');"
   & "if(dot)dot.style.background='#f44336';if(lbl)lbl.textContent='SD offline';});return 0;}\n"
   & "function generate_image(url,body,cid){var card=dom_get(cid);"
   & "fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:body})"
   & ".then(function(r){return r.json();}).then(function(d){if(card){var img=card.querySelector('img');"
   & "if(img&&d.url){img.src=d.url;var hero=dom_get('hero-img');"
   & "if(hero){hero.src=d.url;hero.style.display='';var em=dom_get('hero-empty');if(em)em.style.display='none';}}"
   & "var sp=card.querySelector('.sp');if(sp)sp.style.display='none';}}).catch(function(){"
   & "if(card){var sp=card.querySelector('.sp');if(sp)sp.style.display='none';}});return 0;}\n"

  emit-dom-theme : Text
  emit-dom-theme =
   "function _c(n){var r=(n>>16)&255,g=(n>>8)&255,b=n&255;return'#'+((1<<24)|(r<<16)|(g<<8)|b).toString(16).slice(1);}\n"
   & "function int_to_css_color(n){return _c(n);}\n"
   & "function _ws(ws,sel){var s=sel+'{';if(ws.ws_bg)s+='background:'+_c(ws.ws_bg)+';';\n"
   & "if(ws.ws_fg)s+='color:'+_c(ws.ws_fg)+';';\n"
   & "var p=ws.ws_padding;if(p)s+='padding:'+p.edge_top+'px '+p.edge_right+'px '+p.edge_bottom+'px '+p.edge_left+'px;';\n"
   & "var m=ws.ws_margin;if(m)s+='margin:'+m.edge_top+'px '+m.edge_right+'px '+m.edge_bottom+'px '+m.edge_left+'px;';\n"
   & "var b=ws.ws_border;if(b&&b.bdr_top&&b.bdr_top.brd_width>0){\n"
   & "s+='border:'+b.bdr_top.brd_width+'px solid '+_c(b.bdr_top.brd_color)+';';\n"
   & "if(b.bdr_corner){if(b.bdr_corner._tag==='CornerRound')s+='border-radius:'+b.bdr_corner._0+'px;';\n"
   & "if(b.bdr_corner._tag==='CornerBevel')s+='border-radius:0;';}}\n"
   & "if(ws.ws_min_width>0)s+='min-width:'+ws.ws_min_width+'px;';\n"
   & "if(ws.ws_min_height>0)s+='min-height:'+ws.ws_min_height+'px;';return s+'}';}\n"
   & "function _ss(ss,base){var s=_ws(ss.ss_normal,base);\n"
   & "s+=_ws(ss.ss_hover,base+':hover');s+=_ws(ss.ss_pressed,base+':active');\n"
   & "s+=_ws(ss.ss_disabled,base+':disabled');s+=_ws(ss.ss_focused,base+':focus');return s;}\n"
   & "function theme_to_css(th){var p=th.th_palette;var s=':root{';\n"
   & "s+='--bg:'+_c(p.pal_bg)+';--fg:'+_c(p.pal_fg)+';';\n"
   & "s+='--primary:'+_c(p.pal_primary)+';--secondary:'+_c(p.pal_secondary)+';';\n"
   & "s+='--accent:'+_c(p.pal_accent)+';--muted:'+_c(p.pal_muted)+';';\n"
   & "s+='--error:'+_c(p.pal_error)+';--success:'+_c(p.pal_success)+';';\n"
   & "s+='--warning:'+_c(p.pal_warning)+';--border:'+_c(p.pal_border)+';}';\n"
   & "s+='*{margin:0;padding:0;box-sizing:border-box}';\n"
   & "s+='body{background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}';\n"
   & "s+=_ss(th.th_panel,'.wk-panel');s+=_ss(th.th_button,'.wk-btn');\n"
   & "s+=_ss(th.th_label,'.wk-label');s+=_ss(th.th_input,'.wk-input');\n"
   & "s+=_ss(th.th_gauge,'.wk-gauge');s+=_ss(th.th_separator,'.wk-sep');\n"
   & "s+='.wk-row{display:flex;flex-direction:row}.wk-col{display:flex;flex-direction:column}';\n"
   & "return s;}\n"
   & "function inject_theme_css(th){var s=document.createElement('style');\n"
   & "s.textContent=theme_to_css(th);document.head.appendChild(s);return 0;}\n"

  emit-dom-widget : Text
  emit-dom-widget = emit-dom-widget-style & emit-dom-widget-create & emit-dom-widget-dim & emit-dom-widget-custom & emit-dom-widget-mount

  emit-dom-widget-dim : Text
  emit-dom-widget-dim =
   "function _wkDim(n,dim,sel){var k=n.wn_kind,tag=(k&&k._0)||'',ch=n.wn_children||[];"
   & "function lbl(i){var c=ch[i];if(!c)return '';var kk=c.wn_kind;return (kk&&kk._0!==undefined&&kk._0!==null)?kk._0:'';}"
   & "if(tag==='opt'){var p=document.createElement('span');var idx=n.wn_state;p.className=(idx===sel?'pip active':'pip');p.textContent=lbl(0);p.onclick=function(){if(_wkOnPick)_wkOnPick(dim,idx)};return p;}"
   & "if(tag==='optc'){var p=document.createElement('span');var idx=n.wn_state;p.className=(idx===sel?'pip active':'pip');p.textContent=lbl(0);p.style.borderLeft='4px solid '+lbl(1);p.onclick=function(){if(_wkOnPick)_wkOnPick(dim,idx)};return p;}"
   & "if(tag==='cat'){var w=document.createElement('div');w.className='cat';"
   & "var h=document.createElement('span');h.className='pip catpip';h.textContent=lbl(0);w.appendChild(h);"
   & "var pop=document.createElement('div');pop.className='catpop';"
   & "for(var i=1;i<ch.length;i++)pop.appendChild(_wkDim(ch[i],dim,sel));"
   & "w.appendChild(pop);return w;}"
   & "return document.createElement('span');}\n"

  emit-dom-widget-style : Text
  emit-dom-widget-style =
   "var _wkTheme=null,_wkOnPick=null,_wkOnClick=null,_wkOnInput=null;\n"
   & "function register_handlers(p,c){_wkOnPick=p;_wkOnClick=c;return 0}\n"
   & "function register_input_handler(f){_wkOnInput=f;return 0}\n"
   & "function _wkStyle(ws,el){if(!ws)return;"
   & "if(ws.ws_bg)el.style.background=_c(ws.ws_bg);"
   & "if(ws.ws_fg)el.style.color=_c(ws.ws_fg);"
   & "var p=ws.ws_padding;if(p&&(p.edge_top||p.edge_right||p.edge_bottom||p.edge_left))"
   & "el.style.padding=p.edge_top+'px '+p.edge_right+'px '+p.edge_bottom+'px '+p.edge_left+'px';"
   & "var m=ws.ws_margin;if(m&&(m.edge_top||m.edge_right||m.edge_bottom||m.edge_left))"
   & "el.style.margin=m.edge_top+'px '+m.edge_right+'px '+m.edge_bottom+'px '+m.edge_left+'px';"
   & "var b=ws.ws_border;if(b&&b.bdr_top&&b.bdr_top.brd_width>0){"
   & "el.style.border=b.bdr_top.brd_width+'px solid '+_c(b.bdr_top.brd_color);"
   & "if(b.bdr_corner&&b.bdr_corner._tag==='CornerRound')el.style.borderRadius=b.bdr_corner._0+'px'}"
   & "if(ws.ws_min_width>0)el.style.minWidth=ws.ws_min_width+'px';"
   & "if(ws.ws_min_height>0)el.style.minHeight=ws.ws_min_height+'px'}\n"
   & "function _wkSS(tag,state){if(!_wkTheme)return null;"
   & "var ss=tag==='WkPanel'?_wkTheme.th_panel:tag==='WkLabel'?_wkTheme.th_label:"
   & "tag==='WkButton'?_wkTheme.th_button:tag==='WkInput'?_wkTheme.th_input:"
   & "tag==='WkGauge'?_wkTheme.th_gauge:tag==='WkSeparator'?_wkTheme.th_separator:_wkTheme.th_panel;"
   & "if(!ss)return null;"
   & "return state===1?ss.ss_hover:state===2?ss.ss_pressed:"
   & "state===3?ss.ss_disabled:state===4?ss.ss_focused:ss.ss_normal}\n"

  emit-dom-widget-create : Text
  emit-dom-widget-create =
   "function _wk(n){var k=n.wn_kind,el;"
   & "if(k._tag==='WkCustom')return _wkCustom(n,k._0||'');"
   & "if(k._tag==='WkPanel')el=document.createElement('div');"
   & "else if(k._tag==='WkLabel'){el=document.createElement('span');if(k._0&&k._0.indexOf('&')>=0)el.innerHTML=k._0;else el.textContent=k._0}"
   & "else if(k._tag==='WkButton'){el=document.createElement('button');if(k._0&&k._0.indexOf('&')>=0)el.innerHTML=k._0;else el.textContent=k._0}"
   & "else if(k._tag==='WkInput'){el=document.createElement('input');el.value=k._0}"
   & "else if(k._tag==='WkGauge'){el=document.createElement('progress');el.value=k._0;el.max=k._1}"
   & "else if(k._tag==='WkSeparator')el=document.createElement('hr');"
   & "else{el=document.createElement('div');el.dataset.custom=k._0||''}"
   & "if(n.wn_id)el.id=n.wn_id;"
   & "if(k._tag==='WkButton')el.addEventListener('click',function(e){e.stopPropagation();if(_wkOnClick)_wkOnClick(n.wn_id||'')});"
   & "if(k._tag==='WkInput')el.addEventListener('input',function(){if(_wkOnInput)_wkOnInput(n.wn_id||'',el.value)});"
   & "var t=k._tag;el.classList.add('wk-'+(t==='WkPanel'?'panel':t==='WkLabel'?'label':"
   & "t==='WkButton'?'btn':t==='WkInput'?'input':t==='WkGauge'?'gauge':t==='WkSeparator'?'sep':'panel'));"
   & "var d=n.wn_layout_dir;if(d){if(d._tag==='DirRow')el.classList.add('wk-row');"
   & "if(d._tag==='DirColumn')el.classList.add('wk-col')}"
   & "if(n.wn_gap>0)el.style.gap=n.wn_gap+'px';"
   & "if(n.wn_flex>0)el.style.flex=n.wn_flex;"
   & "var st=n.wn_state||0;"
   & "if(st===3&&el.disabled!==undefined)el.disabled=true;"
   & "var ws=_wkSS(t,st);if(ws)_wkStyle(ws,el);"
   & "var ch=n.wn_children||[];"
   & "for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));"
   & "return el}\n"

  emit-dom-widget-custom : Text
  emit-dom-widget-custom =
   "function _wkCustom(n,tag){"
   & "var id=n.wn_id||'',st=n.wn_state||0,ch=n.wn_children||[];"
   & "function lbl(i){var c=ch[i];if(!c)return '';var kk=c.wn_kind;return (kk&&kk._0!==undefined&&kk._0!==null)?kk._0:'';}"
   & "if(tag.indexOf('box:')===0){var el=document.createElement('div');var cls=tag.slice(4);if(cls)el.className=cls;if(id)el.id=id;for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}"
   & "if(tag.indexOf('boxc:')===0){var el=document.createElement('div');var cls=tag.slice(5);if(cls)el.className=cls;if(id)el.id=id;el.style.cursor='pointer';el.addEventListener('click',function(e){e.stopPropagation();if(_wkOnClick)_wkOnClick(id)});for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}"
   & "if(tag==='h1'){var h=document.createElement('h1');h.textContent=lbl(0);return h;}"
   & "if(tag==='nav'){var nv=document.createElement('nav');nv.className='nv';"
   & "var pages=[['/item','item','Items'],['/character','character','Characters'],['/setting','setting','Settings'],['/card','card','Cards'],['/mine','mine','My Creations']];"
   & "for(var i=0;i<pages.length;i++){var a=document.createElement('a');a.href=pages[i][0];a.textContent=pages[i][2];if(id===pages[i][1])a.className='active';nv.appendChild(a);}"
   & "var sp=document.createElement('span');sp.style.flex='1';nv.appendChild(sp);"
   & "var sd=document.createElement('span');sd.className='sd';var dot=document.createElement('span');dot.id='sd-dot';dot.className='dot';"
   & "var lab=document.createElement('span');lab.id='sd-label';lab.textContent='checking...';"
   & "sd.appendChild(dot);sd.appendChild(document.createTextNode(' '));sd.appendChild(lab);nv.appendChild(sd);return nv;}"
   & "if(tag==='dim-picker'){var w=document.createElement('div');w.className='dim';"
   & "var pill=document.createElement('div');pill.className='dim-pill';pill.textContent=lbl(st)||'?';"
   & "var dd=document.createElement('div');dd.className='dd';"
   & "for(var i=0;i<ch.length;i++){(function(ix){var it=document.createElement('div');it.className=ix===st?'dd-item active':'dd-item';it.textContent=lbl(ix);it.onclick=function(){if(_wkOnPick)_wkOnPick(id,ix)};dd.appendChild(it);})(i);}"
   & "w.appendChild(pill);w.appendChild(dd);return w;}"
   & "if(tag==='prompt-field'){var w=document.createElement('div');w.className='prow';"
   & "var ta=document.createElement('textarea');ta.id='prompt';ta.placeholder=lbl(0);"
   & "var pc=document.createElement('div');pc.className='pc';var la=document.createElement('label');la.textContent='Seed';"
   & "var inp=document.createElement('input');inp.id='seed';inp.type='number';inp.value=st;"
   & "pc.appendChild(la);pc.appendChild(inp);w.appendChild(ta);w.appendChild(pc);return w;}"
   & "if(tag==='toolbar'){var w=document.createElement('div');w.className='tb';"
   & "for(var i=0;i<ch.length;i++){(function(c){var b=document.createElement('button');var kk=c.wn_kind;b.textContent=(kk&&kk._0)||'';b.className=c.wn_state===2?'btn primary':'btn';var bid=c.wn_id||'';b.onclick=function(){if(_wkOnClick)_wkOnClick(bid)};w.appendChild(b);})(ch[i]);}"
   & "return w;}"
   & "if(tag==='hero'){var w=document.createElement('div');w.className='hero';w.id='hero';"
   & "var img=document.createElement('img');img.id='hero-img';img.style.display='none';"
   & "img.onclick=function(){if(this.src&&this.src.indexOf('data:')<0){var lb=document.getElementById('lb');if(lb){lb.classList.add('on');var li=document.getElementById('lb-img');if(li)li.src=this.src;}}};"
   & "var emp=document.createElement('div');emp.className='he';emp.id='hero-empty';emp.textContent=lbl(0);"
   & "var meta=document.createElement('div');meta.id='hero-meta';meta.className='hm';"
   & "w.appendChild(img);w.appendChild(emp);w.appendChild(meta);return w;}"
   & "if(tag==='history'){var w=document.createElement('div');w.className='hist';"
   & "var h=document.createElement('h3');h.textContent='History';var hd=document.createElement('div');hd.id='history';"
   & "w.appendChild(h);w.appendChild(hd);return w;}"
   & "if(tag==='lightbox'){var w=document.createElement('div');w.className='lb';w.id='lb';"
   & "w.onclick=function(){this.classList.remove('on')};"
   & "var x=document.createElement('span');x.className='x';x.innerHTML='&times;';var img=document.createElement('img');img.id='lb-img';"
   & "w.appendChild(x);w.appendChild(img);return w;}"
   & "if(tag==='dimsel'){var w=document.createElement('span');w.className='dimw';"
   & "var hd=document.createElement('span');hd.className='pip head';hd.textContent=lbl(0);w.appendChild(hd);"
   & "var pop=document.createElement('div');pop.className='pop';"
   & "var f=(ch[1]&&ch[1].wn_kind&&ch[1].wn_kind._0)||'';pop.classList.add(f==='cat'?'pop-col':'pop-wrap');"
   & "for(var i=1;i<ch.length;i++)pop.appendChild(_wkDim(ch[i],id,st));"
   & "w.appendChild(pop);return w;}"
   & "if(tag==='prompt-only'){var ta=document.createElement('textarea');ta.id='prompt';ta.placeholder=lbl(0);return ta;}"
   & "if(tag==='btnbar'){var w=document.createElement('div');w.className='btnbar';"
   & "var g=document.createElement('button');g.className='btn primary';g.textContent='Generate';g.onclick=function(){if(_wkOnClick)_wkOnClick('gen')};"
   & "var s=document.createElement('input');s.id='seed';s.type='number';s.value=st;"
   & "var r=document.createElement('button');r.className='btn';r.textContent='Random';r.onclick=function(){if(_wkOnClick)_wkOnClick('rnd')};"
   & "w.appendChild(g);w.appendChild(s);w.appendChild(r);return w;}"
   & "if(tag==='btnbar-batch'){var w=document.createElement('div');w.className='btnbar';"
   & "var g=document.createElement('button');g.className='btn primary';g.textContent='Generate';g.onclick=function(){if(_wkOnClick)_wkOnClick('gen')};"
   & "var s=document.createElement('input');s.id='seed';s.type='number';s.value=st;"
   & "var b=document.createElement('button');b.className='btn';b.textContent='Batch All Rarities';b.onclick=function(){if(_wkOnClick)_wkOnClick('batch')};"
   & "var r=document.createElement('button');r.className='btn';r.textContent='Random';r.onclick=function(){if(_wkOnClick)_wkOnClick('rnd')};"
   & "w.appendChild(g);w.appendChild(s);w.appendChild(b);w.appendChild(r);return w;}"
   & emit-dom-widget-magic-a & emit-dom-widget-magic-b & emit-dom-widget-magic-c
   & "var el=document.createElement('div');el.dataset.custom=tag;if(id)el.id=id;for(var i=0;i<ch.length;i++)el.appendChild(_wk(ch[i]));return el;}\n"

  emit-dom-widget-magic-a : Text
  emit-dom-widget-magic-a =
   "if(tag==='magic-nav'){var nv=document.createElement('div');nv.className='topbar';"
   & "var brand=document.createElement('div');brand.className='hdr-brand';brand.textContent='CodexMagic';"
   & "var right=document.createElement('div');right.className='hdr-right';"
   & "var pages=[['Game','/game.html'],['Collection','/collection.html'],['Store','/store.html'],['Queue','/queue.html'],['Market','/marketplace.html']];"
   & "for(var i=0;i<pages.length;i++){var a=document.createElement('a');a.href=pages[i][1];a.textContent=pages[i][0];if(location.pathname===pages[i][1])a.className='active';right.appendChild(a);}"
   & "if(st===1){var aa=document.createElement('a');aa.href='/admin.html';aa.textContent='Admin';if(location.pathname==='/admin.html')aa.className='active';right.appendChild(aa);}"
   & "nv.appendChild(brand);nv.appendChild(right);return nv;}"
   & "if(tag==='tab-bar'){var w=document.createElement('div');w.className='tab-bar';"
   & "for(var i=0;i<ch.length;i++)w.appendChild(_wk(ch[i]));return w;}"
   & "if(tag==='tab-btn'){var b=document.createElement('button');b.className='tab-btn'+(st===1?' active':'');"
   & "b.textContent=lbl(0);b.id=id;b.onclick=function(){if(_wkOnClick)_wkOnClick(id)};return b;}"
   & "if(tag==='tab-panel'){var p=document.createElement('div');p.className='tab-panel'+(st===1?' active':'');"
   & "p.id=id;for(var i=0;i<ch.length;i++)p.appendChild(_wk(ch[i]));return p;}"

  emit-dom-widget-magic-b : Text
  emit-dom-widget-magic-b =
   "if(tag==='stat-grid'){var g=document.createElement('div');g.className='stat-grid';g.id=id;"
   & "for(var i=0;i<ch.length;i++)g.appendChild(_wk(ch[i]));return g;}"
   & "if(tag==='stat-card'){var c=document.createElement('div');c.className='stat-card';c.id=id;"
   & "for(var i=0;i<ch.length;i++)c.appendChild(_wk(ch[i]));return c;}"
   & "if(tag==='stat-val'){var s=document.createElement('div');s.className='stat-val';s.id=id;s.textContent=lbl(0);return s;}"
   & "if(tag==='stat-lbl'){var s=document.createElement('div');s.className='stat-lbl';s.id=id;s.textContent=lbl(0);return s;}"
   & "if(tag==='section-title'){var s=document.createElement('div');s.className='section-title';s.id=id;s.textContent=lbl(0);return s;}"
   & "if(tag==='msg'){var m=document.createElement('div');m.className='msg';m.id=id;return m;}"
   & "if(tag==='log-box'){var l=document.createElement('div');l.className='log-box';l.id=id;l.textContent='No entries yet.';return l;}"
   & "if(tag==='input'){var inp=document.createElement('input');inp.id=id;if(ch.length>1){inp.value=lbl(0);inp.placeholder=lbl(1)}else inp.placeholder=lbl(0);inp.addEventListener('input',function(){if(_wkOnInput)_wkOnInput(id,inp.value)});return inp;}"
   & "if(tag==='textarea'){var ta=document.createElement('textarea');ta.id=id;ta.value=lbl(0);if(ch.length>1)ta.placeholder=lbl(1);ta.addEventListener('input',function(){if(_wkOnInput)_wkOnInput(id,ta.value)});return ta;}"
   & "if(tag==='select'){var s=document.createElement('select');s.id=id;for(var i=0;i<ch.length;i++)s.appendChild(_wk(ch[i]));return s;}"
   & "if(tag==='option'){var o=document.createElement('option');o.value=id;o.textContent=lbl(0);return o;}"
   & "if(tag==='th'){var t=document.createElement('th');t.textContent=lbl(0);return t;}"
   & "if(tag==='thead'){var t=document.createElement('tr');for(var i=0;i<ch.length;i++)t.appendChild(_wk(ch[i]));return t;}"
   & "if(tag==='tbody'){var t=document.createElement('tbody');t.id=id;for(var i=0;i<ch.length;i++)t.appendChild(_wk(ch[i]));return t;}"
   & "if(tag==='color-swatch'){var s=document.createElement('div');s.className='color-swatch';s.id=id;s.style.background=lbl(1);var lb=document.createElement('span');lb.className='wk-lbl';lb.textContent=lbl(0);s.appendChild(lb);return s;}"

  emit-dom-widget-magic-c : Text
  emit-dom-widget-magic-c =
   "if(tag==='form-field'){var f=document.createElement('label');f.className='adm-form-field';"
   & "var lb=document.createElement('span');lb.textContent=lbl(0);f.appendChild(lb);"
   & "var inp=document.createElement('input');inp.id=id+'i';inp.placeholder=ch[1]?lbl(1):'';f.appendChild(inp);return f;}"
   & "if(tag.indexOf('badge ')===0){var b=document.createElement('span');b.className=tag;b.textContent=lbl(0);return b;}"
   & "if(tag==='balance'){var b=document.createElement('span');b.className='balance';b.id=id;b.textContent=lbl(0);return b;}"
   & "if(tag==='listing-price'){var p=document.createElement('div');p.className='listing-price';p.id=id;p.textContent=lbl(0);return p;}"
   & "if(tag==='listing-info'){var p=document.createElement('div');p.className='listing-card-info';p.id=id;p.textContent=lbl(0);return p;}"
   & "if(tag==='filter-bar'){var f=document.createElement('div');f.className='filter-bar';f.id=id;for(var i=0;i<ch.length;i++)f.appendChild(_wk(ch[i]));return f;}"

  emit-dom-widget-mount : Text
  emit-dom-widget-mount =
   "function mount_widget(n){var a=document.getElementById('app');a.innerHTML='';a.appendChild(_wk(n));return 0}\n"
   & "function mount_widget_themed(th,n){_wkTheme=th;return mount_widget(n)}\n"
   & "function mount_widget_into(id,n){var a=document.getElementById(id);if(!a)return 0;a.innerHTML='';var ch=n.wn_children||[];for(var i=0;i<ch.length;i++)a.appendChild(_wk(ch[i]));return 0}\n"

  is-builtin-type : Text -> Boolean
  is-builtin-type (n) =
   if n == "DomElement" then True
   else False

  emit-js-type-defs : List ATypeDef, Integer -> Text
  emit-js-type-defs (tds) (i) =
   text-concat-list (emit-js-type-defs-acc tds i (list-length tds) [])

  emit-js-type-defs-acc : List ATypeDef, Integer, Integer, List Text -> List Text
  emit-js-type-defs-acc (tds) (i) (len) (acc) =
   if i >= len then acc
   else let td = list-at tds i
   in let name = when td
     is ARecordTypeDef (nm) (tp) (fs) (sp) -> nm.value
     is AVariantTypeDef (nm) (tp) (cs) (sp) -> nm.value
   in if is-builtin-type name then emit-js-type-defs-acc tds (i + 1) len acc
   else emit-js-type-defs-acc tds (i + 1) len (list-push acc (emit-js-type-def td))

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

  emit-js-tuple-binds : List IRPat, Text, Integer, Integer -> Text
  emit-js-tuple-binds (subs) (scrut) (indent) (i) =
   if i >= list-length subs then ""
   else when (list-at subs i)
    is IrVarPat (name) (ty) (sp) -> html-indent (indent + 1) & "const " & html-sanitize name & " = " & scrut & "[" & integer-to-text i & "];\n" & emit-js-tuple-binds subs scrut indent (i + 1)
    is otherwise -> emit-js-tuple-binds subs scrut indent (i + 1)
