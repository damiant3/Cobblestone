Chapter: FrameHostArm
  cites WebApp chapter WebRuntime
  cites Foreword chapter StringUtils

  fh-serve : Text, (Text -> Integer) -> Integer
  fh-serve (body) (reply) = if text-starts-with body "done:" then (let shown = dom-set-text (dom-get "got") body in reply "ok")
    else reply ("pong:" & body)
  fh-child : Text -> Integer
  fh-child (html) = frame-mount "host" html
  opening : [Console] Integer
  opening = act
    a <- print-line-uni "frame host"
    let app = dom-get "app"
    in let host = dom-append app (dom-set-attr (dom-create "div") "id" "host")
    in let got = dom-append app (dom-set-attr (dom-create "div") "id" "got")
    in let served = frame-serve fh-serve
    in fetch-with-then "/child" "GET" "{}" "" fh-child
  end
