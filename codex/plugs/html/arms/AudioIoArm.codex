Chapter: AudioIoArm
  cites WebApp chapter WebGpu
  cites WebApp chapter WebRuntime

 We say:

  aio-read : Text -> Integer
  aio-read (r) = let a = state-set-text "read" r in state-set "done" 1

  aio-saved : Text -> Integer
  aio-saved (r) =
    let a = state-set-text "save" r
    in if text-contains r "\"ok\":true" then file-read-then (json-obj-field (json-parse-obj r) "name") 0 8 aio-read else state-set "done" 1

  aio-click : Text -> Integer
  aio-click (id) =
    let a = alloc-bytes 8
    in let b = poke-32 a 0 #0D41FF00
    in let c = poke-32 a 4 #0700C80A
    in let d = state-set "address" a
    in file-save-bytes-then "probe.bin" a 8 aio-saved

  opening : [Console] Integer
  opening = let c = dom-on-click (dom-query "html") aio-click in state-set "armed" 1
