Chapter: NestedCtorArm
  cites WebApp chapter WebRuntime
  cites Foreword chapter Maybe

  NpaLeaf =
    | NpaNumber (Integer)
    | NpaText (Text)

  npa-select : Maybe NpaLeaf -> Integer
  npa-select (v) = when v
    is Just (NpaNumber (7)) -> 70
    is Just (NpaNumber (n)) -> n
    is otherwise -> 0 - 1

  npa-deep : Maybe (Maybe NpaLeaf) -> Integer
  npa-deep (v) = when v
    is Just (Just (NpaNumber (n))) -> n
    is otherwise -> 0 - 1

  opening : [Console] Integer
  opening =
    let a = state-set "literal" (npa-select (Just (NpaNumber 7)))
    in let b = state-set "binding" (npa-select (Just (NpaNumber 9)))
    in let c = state-set "wrong-inner" (npa-select (Just (NpaText "refuse")))
    in let d = state-set "wrong-outer" (npa-select None)
    in let e = state-set "deep-binding" (npa-deep (Just (Just (NpaNumber 42))))
    in let f = state-set "deep-inner" (npa-deep (Just (Just (NpaText "refuse"))))
    in let g = state-set "deep-middle" (npa-deep (Just None))
    in state-set "done" 1
