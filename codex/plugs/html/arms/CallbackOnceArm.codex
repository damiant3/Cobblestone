Chapter: CallbackOnceArm
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebGpu

 We say:

Section: Reach

  opening : [Console] Integer
  opening =
    if page-data "run" == "" then state-set "armed" 1
    else cba-all 0

  cba-got : Text -> Integer
  cba-got (r) =
    let s = state-set-text "got" r
    in 0

  cba-all : Integer -> Integer
  cba-all (x) =
    let a = gpu-open-then cba-got
    in let b = fetch-then "u" "GET" "" cba-got
    in let c = fetch-with-then "u" "GET" "" "" cba-got
    in let d = gpu-buf-download-then 1 0 8 cba-got
    in let e = gpu-buf-upload-then 1 0 "f" 0 2 1 1 cba-got
    in let f = gpu-buf-show-then 1 1 1 "#c" cba-got
    in let g = file-save-bytes-then "f.bin" (alloc-bytes 8) 8 cba-got
    in let h = gpu-trim-then cba-got
    in let i = dir-open-then cba-got
    in let j = pick-file-then "" cba-got
    in let k = pick-dir-then "" cba-got
    in gpu-probe-then 0 cba-got
