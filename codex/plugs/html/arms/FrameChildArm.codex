Chapter: FrameChildArm
  cites WebApp chapter WebRuntime

  fc-done : Text -> Integer
  fc-done (reply) = 0
  fc-pong : Text -> Integer
  fc-pong (reply) = host-request-then ("done:" & reply) fc-done
  opening : [Console] Integer
  opening = act
    a <- print-line-uni "frame child"
    host-request-then "ping" fc-pong
  end
