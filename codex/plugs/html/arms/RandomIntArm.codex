Chapter: RandomIntArm
  cites WebApp chapter WebRuntime

  ria-check : Integer -> Integer
  ria-check (i) =
    if i >= 128 then 1
    else let seed = random-int 0 2147483646
    in let mask = bit-and seed #FFFFFFFF
    in let wide = random-int 9007199254740993 9007199254740999
    in let negative = random-int (0 - 9007199254740999) (0 - 9007199254740993)
    in if seed < 0 | seed > 2147483646 | mask /= seed | wide < 9007199254740993 | wide > 9007199254740999 | negative < 0 - 9007199254740999 | negative > 0 - 9007199254740993 then 0
    else ria-check (i + 1)

  opening : [Console] Integer
  opening =
    let large = state-set "large" (random-int 9007199254740993 9007199254740993)
    in let sample = state-set "sample" (random-int 0 2147483646)
    in let checked = state-set "checked" (ria-check 0)
    in state-set "done" 1
