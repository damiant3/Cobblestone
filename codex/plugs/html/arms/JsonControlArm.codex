Chapter: JsonControlArm
  cites Encode chapter Json
  cites WebApp chapter WebRuntime

  json-control-text : Text -> Text
  json-control-text (s) = json-emit (JsonStr s)

  json-control-object : Text, Text -> Text
  json-control-object (key) (value) = json-emit (JsonObject [json-pair key (JsonStr value)])

  opening : Integer
  opening =
    let a = state-set-text "quoted" (json-control-text (state-get-text "input"))
    in let b = state-set-text "object" (json-control-object (state-get-text "key") (state-get-text "input"))
    in 0