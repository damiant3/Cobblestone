Chapter: DialogArm
  cites WebApp chapter WebRuntime

  da-title : Text = "<img src=x onerror=alert(1)>"
  da-message : Text = "<b>bold</b> & <script>x()</script>"
  da-done : Text -> Integer
  da-done (answer) = 0
  opening : [Console] Integer
  opening = act
    a <- print-line-uni "DIALOG ARM"
    let b = show-alert da-title da-message da-done
    in show-prompt da-title da-message "<i>hint</i>" da-done
  end
