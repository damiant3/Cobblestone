Chapter: WidgetEntityArm
  cites WebApp chapter WebRuntime

  wea-hostile : Text = "<img src=x onerror=alert(1)> &times; &#x2713; &#8594; &bogus; &#xD800;"
  opening : [Console] Integer
  opening = act
    a <- print-line-uni "WIDGET ENTITY ARM"
    mount-widget (widget-panel "root" DirColumn 4 [widget-label "hostile-label" wea-hostile, widget-button "hostile-button" wea-hostile, widget-label "plain" "plain"])
  end
