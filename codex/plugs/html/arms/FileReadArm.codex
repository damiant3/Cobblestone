Chapter: FileReadArm
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebGpu

 The page codex/plugs/html/arms/file-read.mjs drives: three reads of a picked
 file through file-read-then, an interior range, a range running past the end,
 and one whose callback throws after counting itself.

 We say:

Section: Read

  opening : [Console] Integer
  opening =
    let c = dom-on-click (dom-query "html") fra-pick
    in state-set "armed" 1

  fra-pick : Text -> Integer
  fra-pick (id) = pick-file-then ".bin" fra-picked

  fra-picked : Text -> Integer
  fra-picked (r) =
    let f = state-set-text "file" (json-obj-field (json-parse-obj r) "name")
    in file-read-then (state-get-text "file") 5 300 fra-got-mid

  fra-got-mid : Text -> Integer
  fra-got-mid (r) =
    let s = state-set-text "mid" r
    in file-read-then (state-get-text "file") 900 200 fra-got-end

  fra-got-end : Text -> Integer
  fra-got-end (r) =
    let s = state-set-text "end" r
    in let t = state-set "calls" 0
    in file-read-then (state-get-text "file") 0 4 fra-throws

  fra-throws : Text -> Integer
  fra-throws (r) =
    let c = state-set "calls" (state-get "calls" + 1)
    in let d = state-set "done" 1
    in 1 / (state-get "calls" - 1)
