Chapter: WaveAnalyzeArm
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebGpu

  opening : [Console] Integer
  opening =
    let button = dom-set-attr (dom-set-text (dom-create "button") "Analyze") "id" "analyze"
    in let a = dom-append (dom-query "body") button
    in let b = dom-on-click button (\x -> audio-analyze-then "probe.wav" (\r -> (let a = state-set-text "analysis" r in state-set "done" 1)))
    in state-set "ready" 1
