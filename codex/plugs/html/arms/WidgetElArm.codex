Chapter: WidgetElArm
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebWidgets

  wel-hostile : Text = "<b onclick=alert(1)>bold?</b>"
  opening : [Console] Integer
  opening = act
    a <- print-line-uni "WIDGET EL ARM"
    mount-widget (widget-panel "root" DirColumn 4 [
      widget-el "a" "link" "href|javascript:alert(1)|onclick|alert(1)|OnMouseOver|alert(2)|title|kept &amp; decoded|data-x|1" [widget-text wel-hostile],
      widget-el "script" "s" "" [widget-text "alert(3)"],
      widget-el "img" "pic" "src|img/a.jpg|alt|an apple" []
    ])
  end
