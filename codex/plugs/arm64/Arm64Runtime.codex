   in let i = a64-rt-emit i (arm64-ldrb 14 13 0)
   in let after-lookup = list-length i / 4
   in let i = a64-patch-insn-raw i skip-lookup (arm64-b ((after-lookup - skip-lookup) * 4))
   in let i = a64-rt-emit i (arm64-add 11 21 10)
   in let i = a64-rt-emit i (arm64-strb 14 11 8)
   in let i = a64-rt-emit i (arm64-add-imm 10 10 1)
   in let i = a64-rt-emit i (arm64-b ((copy-loop - list-length i / 4) * 4))
   in let copy-done = list-length i / 4
   in let i = a64-patch-insn-raw i copy-exit (arm64-b-cond 10 ((copy-done - copy-exit) * 4))
   in let i = a64-rt-emit i (arm64-mov 0 21)
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp-post 29 30 31 64)
   in a64-rt-emit i arm64-ret

Section: Emit All Runtime Helpers

  a64-emit-runtime : A64State -> A64State
  a64-emit-runtime (st) =
   let vt = a64-rt-vector-table
   in let st0 = a64-emit-block st vt 0 (list-length vt)
   in let st1 = a64-record-func st0 "__start"
   in let cbnz-idx = st1.insn-count
   in let st1z = a64-emit st1 arm64-nop
   in let st1a = a64-emit st1z a64-rt-adr-x9-minus-0x800
   in let st1b0 = a64-emit st1a (arm64-msr sysreg-vbar-el1 9)
   in let st1b = a64-emit st1b0 (arm64-msr #7600 9)
   in let st1c = a64-emit-li st1b 10 a64-rt-pl011-base
   in let st1c0 = a64-emit-li st1c 11 0
   in let st1c1 = a64-emit st1c0 (arm64-str-w 11 10 48)
   in let st1d = a64-emit-li st1c1 11 96
   in let st1e0 = a64-emit st1d (arm64-str-w 11 10 44)
   in let st1e1 = a64-emit-li st1e0 11 769
   in let st1e = a64-emit st1e1 (arm64-str-w 11 10 48)
   in let st2 = a64-emit-li st1e 9 #48000000
   in let st3 = a64-emit st2 (arm64-mov 31 9)
   in let st3x = a64-emit-li st3 28 #40112000
   in let uefi-label = st3x.insn-count
   in let st3a = a64-emit-li st3x 10 a64-ascii-to-cce-table-addr
   in let a2c-table = a64-build-ascii-to-cce [] 0
   in let st3b = a64-write-table-loop st3a 10 a2c-table 0
   in let st3c = a64-emit-li st3b 10 a64-cce-to-unicode-table-addr
   in let c2u-table = a64-build-cce-to-unicode [] 0
   in let st3d = a64-write-table-loop st3c 10 c2u-table 0
   in let st3e = a64-patch-insn st3d cbnz-idx (arm64-cbnz 28 ((uefi-label - cbnz-idx) * 4))
   in let st5 = a64-emit-call-to st3e "opening"
   in let st6 = a64-emit st5 a64-rt-wfi
   in let st7 = a64-emit st6 (arm64-b (-4))
   in let st8 = a64-record-func st7 "print-line-uni"
   in let st8a = a64-record-func st8 "print-line"
   in let plu = a64-rt-print-line-uni
   in let st9 = a64-emit-block st8a plu 0 (list-length plu)
   in let st10 = a64-record-func st9 "__str_eq"
   in let seq = a64-rt-str-eq
