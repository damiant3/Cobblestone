Section: __list_cons

  a64-rt-list-cons : List Integer
  a64-rt-list-cons =
   let i = []
   in let i = a64-rt-emit i (arm64-add-imm 28 28 7)
   in let i = i & arm64-lsr-imm 28 28 3
   in let i = i & arm64-lsl-imm 28 28 3
   in let i = a64-rt-emit i (arm64-mov 15 0)
   in let i = a64-rt-emit i (arm64-mov 9 1)
   in let i = a64-rt-emit i (arm64-ldr 10 9 0)
