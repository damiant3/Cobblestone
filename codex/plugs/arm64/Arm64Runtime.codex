   let i = []
   in let i = a64-rt-emit i (arm64-stp 29 30 31 (0 - 64))
   in let i = a64-rt-emit i (arm64-sub-imm 31 31 64)
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-mov 29 31)
   in let i = a64-rt-emit i (arm64-mov 19 0)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 28 28 32)
   in let i = a64-rt-emit i (arm64-mov 20 0)
   in let i = i & arm64-movz 21 0 0
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-cmp 19 9)
   in let bge-pos = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-sub 19 9 19)
   in let i = a64-rt-emit i (arm64-add-imm 21 21 1)
   in let pos-label = list-length i / 4
   in let loop = list-length i / 4
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-cmp 19 9)
   in let beq-done = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 9 10 0
   in let i = a64-rt-emit i (arm64-sdiv 10 19 9)
   in let i = a64-rt-emit i (arm64-mul 11 10 9)
   in let i = a64-rt-emit i (arm64-sub 12 19 11)
   in let i = a64-rt-emit i (arm64-add-imm 12 12 48)
   in let i = a64-rt-emit i (arm64-add 9 20 21)
   in let i = a64-rt-emit i (arm64-strb 12 9 8)
   in let i = a64-rt-emit i (arm64-add-imm 21 21 1)
   in let i = a64-rt-emit i (arm64-mov 19 10)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let done-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-str 21 20 0)
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-sub-imm 10 21 1)
   in let rev-loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let rev-exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 11 20 9)
   in let i = a64-rt-emit i (arm64-ldrb 12 11 8)
   in let i = a64-rt-emit i (arm64-add 13 20 10)
   in let i = a64-rt-emit i (arm64-ldrb 14 13 8)
   in let i = a64-rt-emit i (arm64-strb 14 11 8)
   in let i = a64-rt-emit i (arm64-strb 12 13 8)
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-sub-imm 10 10 1)
   in let i = a64-rt-emit i (arm64-b ((rev-loop - list-length i / 4) * 4))
   in let rev-exit-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-mov 0 20)
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp 29 30 31 0)
   in let i = a64-rt-emit i (arm64-add-imm 31 31 64)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i bge-pos (arm64-b-cond 10 ((pos-label - bge-pos) * 4))
   in let i = a64-patch-insn-raw i beq-done (arm64-b-cond 0 ((done-label - beq-done) * 4))
   in a64-patch-insn-raw i rev-exit (arm64-b-cond 10 ((rev-exit-label - rev-exit) * 4))

