Chapter: Arm64 Runtime
  cites Foreword chapter Arm64Encoder

 Runtime helper functions emitted at the start of ARM64 codegen.
 Each returns the bytes of an ARM64 function body. The codegen
 records the function offset and appends the bytes.

 IMPORTANT: register 31 means SP in arm64-mov/arm64-add-imm (the
 instruction encoding aliases). To load zero, use arm64-movz rd 0 0
 instead of arm64-mov rd 31 (which loads SP, not XZR).

Section: Helper Infrastructure

  a64-rt-emit : List Integer, List Integer -> List Integer
  a64-rt-emit (acc) (insn) = acc & insn

Section: __str_eq

  a64-rt-str-eq : List Integer
  a64-rt-str-eq =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-ldr 10 1 0)
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let bne-len = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 0 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 1 1 8)
   in let i = i & arm64-movz 11 0 0
   in let loop-start = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 9)
   in let bge-idx = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 12 0 11)
   in let i = a64-rt-emit i (arm64-ldrb 12 12 0)
   in let i = a64-rt-emit i (arm64-add 13 1 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-cmp 12 13)
   in let bne-byte = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((loop-start - list-length i / 4) * 4))
   in let equal-label = list-length i / 4
   in let i = i & arm64-movz 0 1 0
   in let i = a64-rt-emit i arm64-ret
   in let not-eq-label = list-length i / 4
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i bne-len (arm64-b-cond 1 ((not-eq-label - bne-len) * 4))
   in let i = a64-patch-insn-raw i bge-idx (arm64-b-cond 10 ((equal-label - bge-idx) * 4))
   in a64-patch-insn-raw i bne-byte (arm64-b-cond 1 ((not-eq-label - bne-byte) * 4))

