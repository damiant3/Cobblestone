   in let i = a64-rt-emit i (arm64-add-imm 28 28 7)
   in let i = i & arm64-lsr-imm 28 28 3
   in let i = i & arm64-lsl-imm 28 28 3
   in let i = a64-rt-emit i (arm64-mov 9 0)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 28 28 16)
   in let i = i & arm64-movz 10 1 0
   in let i = a64-rt-emit i (arm64-str 10 0 0)
   in let i = a64-rt-emit i (arm64-strb 9 0 8)
   in a64-rt-emit i arm64-ret

Section: Patching Helper

  a64-patch-insn-raw : List Integer, Integer, List Integer -> List Integer
  a64-patch-insn-raw (code) (insn-index) (new-bytes) =
   let byte-offset = insn-index * 4
   in a64-patch-raw-4 code byte-offset new-bytes 0 (list-length code) []

  a64-patch-raw-4 : List Integer, Integer, List Integer, Integer, Integer, List Integer -> List Integer
  a64-patch-raw-4 (code) (pos) (new-bytes) (i) (len) (acc) =
   if i >= len then acc
   else if i >= pos & i < pos + 4 then a64-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at new-bytes (i - pos)))
   else a64-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at code i))

Section: Exception Vector Table

 Sixteen entries of 0x80 bytes each. Every one of them used to be the same
 `WFI + B .self`, which is why any ARM64 fault presented as a hang with no
 output rather than as something you could read: the CL 8221 regression was
 an undefined `hvc` trapping to entry 4, and it cost 238 tests before anyone
 could see what it was.

 The index tells you which exception it was: 0-3 are current EL with SP0,
 4-7 current EL with SPx (4 is the synchronous one an ordinary fault takes),
 8-11 lower EL running AArch64, 12-15 lower EL running AArch32.

  a64-rt-vt-entry-n : Integer -> List Integer
  a64-rt-vt-entry-n (idx) =
   let wfi = [31, 32, 3, 213]
   in let bself = [255, 255, 255, 23]
   in let pad = wfi & bself
   in arm64-movz 9 idx 0 & arm64-nop
   & pad & pad & pad & pad & pad & pad & pad & pad
   & pad & pad & pad & pad & pad & pad & pad

  a64-rt-vt-build : Integer, List Integer -> List Integer
  a64-rt-vt-build (i) (acc) =
   if i >= 16 then acc
   else a64-rt-vt-build (i + 1) (acc & a64-rt-vt-entry-n i)

  a64-rt-vector-table : List Integer
  a64-rt-vector-table = a64-rt-vt-build 0 []

  a64-rt-vt-branch-slot : Integer -> Integer
  a64-rt-vt-branch-slot (idx) = idx * 32 + 1

  a64-rt-adr-x9-minus-0x800 : List Integer = [9, 192, 255, 16]

Section: __start (QEMU virt boot stub)

  a64-rt-pl011-base : Integer = #09000000
  a64-rt-cpacr-el1 : Integer = #4082

  a64-rt-wfi : List Integer = [31, 32, 3, 213]

 SMP AP boot. Unlike RISC-V (where every hart auto-enters at reset), QEMU
 virt holds the secondaries in its PSCI implementation; core 0 must issue
 PSCI CPU_ON to start each one. The conduit is HVC on QEMU virt (proven by
 spike); the 64-bit CPU_ON function id is 0xC4000003. hvc #0 is 0xD4000002,
 little-endian [2, 0, 0, 212]. The AP marker cell is high in RAM
 (0x7E000000), 32 MiB under the boot stack top (0x80000000) and above the
 spawn pool [0x50000000, 0x70000000), which is why it moved from 0x60000000. Written only by a core that ran our guest code.

  a64-rt-hvc : List Integer = [2, 0, 0, 212]
  a64-rt-cpu-on-id : Integer = #C4000003
  a64-rt-ap-marker-addr : Integer = #7E000000

  a64-adr-bytes : Integer, Integer -> List Integer
  a64-adr-bytes (imm) (rd) =
   let w = bit-or (bit-or (bit-or #10000000 (bit-shl (bit-and imm 3) 29)) (bit-shl (bit-and (bit-shru imm 2) #7FFFF) 5)) rd
   in [bit-and w 255, bit-and (bit-shru w 8) 255, bit-and (bit-shru w 16) 255, bit-and (bit-shru w 24) 255]

Section: ASCII to CCE Reverse Table

  a64-build-ascii-to-cce : List Integer, Integer -> List Integer
  a64-build-ascii-to-cce (acc) (ascii) =
   if ascii >= 128 then acc
   else let cce = a64-find-cce-for-ascii ascii 0
   in a64-build-ascii-to-cce (list-push acc cce) (ascii + 1)

  a64-find-cce-for-ascii : Integer, Integer -> Integer
  a64-find-cce-for-ascii (ascii) (cce) =
   if cce >= list-length cce-to-unicode-table then 0
   else if list-at cce-to-unicode-table cce == ascii then cce
   else a64-find-cce-for-ascii ascii (cce + 1)

  a64-ascii-to-cce-table-addr : Integer = #40200000
  a64-cce-to-unicode-table-addr : Integer = #40201000

  a64-build-cce-to-unicode : List Integer, Integer -> List Integer
  a64-build-cce-to-unicode (acc) (cce) =
   if cce >= 128 then acc
   else let uni = if cce < list-length cce-to-unicode-table then list-at cce-to-unicode-table cce else 0
   in a64-build-cce-to-unicode (list-push acc uni) (cce + 1)

  a64-write-table-loop : A64State, Integer, List Integer, Integer -> A64State
  a64-write-table-loop (st) (base-reg) (table) (i) =
   if i >= list-length table then st
   else let st1 = a64-emit-li st a64-x11 (list-at table i)
   in let st2 = a64-emit st1 (arm64-strb a64-x11 base-reg i)
   in a64-write-table-loop st2 base-reg table (i + 1)

Section: print-line-uni (PL011 UART output)

  a64-rt-print-line-uni : List Integer
  a64-rt-print-line-uni =
   let i = []
   in let i = a64-rt-emit i (arm64-stp-pre 29 30 31 (0 - 80))
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-stp 23 24 31 48)
   in let i = a64-rt-emit i (arm64-mov 19 0)
   in let i = a64-rt-emit i (arm64-ldr 20 19 0)
   in let i = i & arm64-li 21 a64-rt-pl011-base
   in let i = i & arm64-li 24 a64-cce-to-unicode-table-addr
   in let i = i & arm64-movz 22 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 22 20)
   in let exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 23 19 22)
   in let i = a64-rt-emit i (arm64-ldrb 23 23 8)
   in let i = a64-rt-emit i (arm64-add 23 24 23)
   in let i = a64-rt-emit i (arm64-ldrb 23 23 0)
   in let i = a64-rt-emit i (arm64-str-w 23 21 0)
   in let i = a64-rt-emit i (arm64-add-imm 22 22 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = i & arm64-movz 9 10 0
   in let i = a64-rt-emit i (arm64-str-w 9 21 0)
   in let i = a64-rt-emit i (arm64-ldp 23 24 31 48)
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp-post 29 30 31 80)
   in let i = a64-rt-emit i arm64-ret
   in a64-patch-insn-raw i exit (arm64-b-cond 10 ((exit-label - exit) * 4))

Section: MMIO Helpers

  a64-rt-remap-addr : List Integer
  a64-rt-remap-addr =
   let i = []
   in let i = i & arm64-movz 9 #100 16
   in let i = i & arm64-cmp 0 9
   in let i = a64-rt-emit i (arm64-b-cond 2 12)
   in let i = i & arm64-movz 9 #4000 16
   in i & arm64-add 0 0 9

 On this target the device window is reached by the SAME instruction as
 ordinary memory, so `read-mmio-32` and `peek-32` are one block of code
 under two names and a `Device.Mmio` row on the gated name gates nothing:
 inlining the peek walks around it. x86-64 does not have this hole because
 its devices are on port I/O and `port-in-*`/`port-out-*` carry
 `Device.Port` by construction. The window therefore has to carry the
 authority here, exactly as the GPU command window does on x86-64
 (`emit-gpu-mem-guard`).

 The gated region is defined as EVERYTHING THAT IS NOT RAM, not as one
 device window, and the board file is why. `codex-arm64.repl` puts the GIC
 at #8000000 and the PL011 at #9000000, below the RAM base, and PCI ECAM at
 #4010000000, ABOVE it -- so a single "low addresses are devices" window
 would have left every PCI BAR and the whole virtio-pci surface ungated
 while reading as a closed gate. RAM on this plug's boards is the aperture
 [#40000000, #4000000000): it begins at the base `a64-rt-remap-addr` adds
 to a program-relative address, and nothing puts 256 GB of it there.

 Two unsigned compares answer the common case. `cap-device` is the bit any
 `Device` declaration grants -- `Device.Mmio` and `Device.Block` alike,
 through the `Device` row of `capability-table` -- so a driver that says
 what it does keeps working and a program that says nothing reads and
 writes its own memory as before and is answered -1 at a device.

  a64-cap-device : Integer = 16

  a64-mmio-window-base-hi : Integer = #100

  a64-ram-base-hi : Integer = #4000

  a64-ram-limit-hi32 : Integer = #40

  a64-rt-guarded-access : List Integer -> List Integer
  a64-rt-guarded-access (body) =
   let i = a64-rt-remap-addr & arm64-add 0 0 1
   in let i = i & arm64-movz 9 a64-ram-limit-hi32 32
   in let i = a64-rt-emit i (arm64-cmp 0 9)
   in let above-ram = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 9 a64-ram-base-hi 16
   in let i = a64-rt-emit i (arm64-cmp 0 9)
   in let is-ram = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 9 a64-mmio-window-base-hi 16
   in let i = a64-rt-emit i (arm64-cmp 0 9)
   in let below-window = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let gate-label = list-length i / 4
   in let i = a64-rt-check-capability i a64-cap-device
   in let cap-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let pass-label = list-length i / 4
   in let i = i & body
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in let i = a64-patch-insn-raw i above-ram (arm64-b-cond 2 ((gate-label - above-ram) * 4))
   in let i = a64-patch-insn-raw i is-ram (arm64-b-cond 2 ((pass-label - is-ram) * 4))
   in let i = a64-patch-insn-raw i below-window (arm64-b-cond 3 ((pass-label - below-window) * 4))
   in a64-patch-insn-raw i cap-deny (arm64-b-cond arm64-cond-eq ((fail-label - cap-deny) * 4))

  a64-rt-peek-byte : List Integer
  a64-rt-peek-byte =
   a64-rt-guarded-access (arm64-ldrb 0 0 0 & arm64-ret)

  a64-rt-poke-byte : List Integer
  a64-rt-poke-byte =
   a64-rt-guarded-access (arm64-strb 2 0 0 & arm64-dsb-sy & arm64-movz 0 0 0 & arm64-ret)

  arm64-ldrh-raw : Integer, Integer -> List Integer
  arm64-ldrh-raw (rt) (rn) =
   arm64-encode (bit-or (bit-or #79400000 (bit-shl rn 5)) rt)

  arm64-strh-raw : Integer, Integer -> List Integer
  arm64-strh-raw (rt) (rn) =
   arm64-encode (bit-or (bit-or #79000000 (bit-shl rn 5)) rt)

 A halfword at an odd address is an alignment fault here (the plug runs with
 the MMU off, so every access is Device-nGnRnE and ldrh/strh must be
 2-aligned; ESR 0x96000061 measured on the QEMU bed). An even address takes
 the single halfword access a 16-bit device register needs; an odd one is two
 byte accesses, little-endian.

  a64-rt-peek-16 : List Integer
  a64-rt-peek-16 =
   a64-rt-guarded-access (a64-rt-peek-16-body)

  a64-rt-peek-16-body : List Integer
  a64-rt-peek-16-body =
   let i = []
   in let i = i & arm64-movz 9 1 0
   in let i = i & arm64-and 9 0 9
   in let i = i & arm64-cbz 9 24
   in let i = i & arm64-ldrb 9 0 1
   in let i = i & arm64-ldrb 0 0 0
   in let i = i & arm64-lsl-imm 9 9 8
   in let i = i & arm64-or 0 0 9
   in let i = i & arm64-b 8
   in let i = i & arm64-ldrh-raw 0 0
   in i & arm64-ret

  a64-rt-poke-16 : List Integer
  a64-rt-poke-16 =
   a64-rt-guarded-access (a64-rt-poke-16-body)

  a64-rt-poke-16-body : List Integer
  a64-rt-poke-16-body =
   let i = []
   in let i = i & arm64-movz 9 1 0
   in let i = i & arm64-and 9 0 9
   in let i = i & arm64-cbz 9 20
   in let i = i & arm64-strb 2 0 0
   in let i = i & arm64-lsr-imm 9 2 8
   in let i = i & arm64-strb 9 0 1
   in let i = i & arm64-b 8
   in let i = i & arm64-strh-raw 2 0
   in i & arm64-dsb-sy & arm64-movz 0 0 0 & arm64-ret

  a64-rt-peek-32 : List Integer
  a64-rt-peek-32 =
   a64-rt-guarded-access (arm64-ldr-w 0 0 0 & arm64-ret)

  a64-rt-poke-32 : List Integer
  a64-rt-poke-32 =
   a64-rt-guarded-access (arm64-str-w 2 0 0 & arm64-dsb-sy & arm64-movz 0 0 0 & arm64-ret)

  a64-rt-peek-qword : List Integer
  a64-rt-peek-qword =
   a64-rt-guarded-access (arm64-ldr 0 0 0 & arm64-ret)

  a64-rt-poke-qword : List Integer
  a64-rt-poke-qword =
   a64-rt-guarded-access (arm64-str 2 0 0 & arm64-movz 0 0 0 & arm64-ret)

  a64-rt-tag-equal : List Integer
  a64-rt-tag-equal =
   arm64-ldr 2 0 0 & arm64-ldr 3 1 0 & arm64-cmp 2 3
    & [(bit-and #9A9F17E0 255), (bit-and (bit-shru #9A9F17E0 8) 255), (bit-and (bit-shru #9A9F17E0 16) 255), (bit-and (bit-shru #9A9F17E0 24) 255)]
    & arm64-ret

Section: Buffer Helpers

  a64-rt-buf-write-byte : List Integer
  a64-rt-buf-write-byte =
   arm64-add 0 0 1 & arm64-strb 2 0 0 & arm64-movz 0 0 0 & arm64-ret

  a64-rt-buf-read-bytes : List Integer
  a64-rt-buf-read-bytes =
   let i = []
   in let i = a64-rt-emit i (arm64-add 9 0 1)
   in let i = a64-rt-emit i (arm64-mov 10 2)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-str 10 0 0)
   in let i = a64-rt-emit i (arm64-add-imm 11 0 8)
   in let i = i & arm64-movz 12 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 12 10)
   in let exit-idx = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 13 9 12)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-mov 14 12)
   in let i = i & arm64-lsl-imm 14 14 3
   in let i = a64-rt-emit i (arm64-add 14 11 14)
   in let i = a64-rt-emit i (arm64-str 13 14 0)
   in let i = a64-rt-emit i (arm64-add-imm 12 12 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-mov 14 10)
   in let i = i & arm64-lsl-imm 14 14 3
   in let i = a64-rt-emit i (arm64-add-imm 14 14 8)
   in let i = a64-rt-emit i (arm64-add 28 28 14)
   in a64-patch-insn-raw i exit-idx (arm64-b-cond 10 ((exit-label - exit-idx) * 4))

  a64-rt-buf-write-bytes : List Integer
  a64-rt-buf-write-bytes =
   let i = []
   in let i = a64-rt-emit i (arm64-add 9 0 1)
   in let i = a64-rt-emit i (arm64-ldr 10 2 0)
   in let i = i & arm64-movz 11 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 10)
   in let exit-idx = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-mov 12 11)
   in let i = i & arm64-lsl-imm 12 12 3
   in let i = a64-rt-emit i (arm64-add 12 2 12)
   in let i = a64-rt-emit i (arm64-ldr 12 12 8)
   in let i = a64-rt-emit i (arm64-add 13 9 11)
   in let i = a64-rt-emit i (arm64-strb 12 13 0)
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-add 0 1 10)
   in let i = a64-rt-emit i (arm64-mov 0 0)
   in let i = a64-rt-emit i arm64-ret
   in a64-patch-insn-raw i exit-idx (arm64-b-cond 10 ((exit-label - exit-idx) * 4))

Section: Heap Management Helpers

  a64-rt-heap-save : List Integer
  a64-rt-heap-save =
   arm64-mov 0 28 & arm64-ret

  a64-rt-heap-restore : List Integer
  a64-rt-heap-restore =
   arm64-mov 28 0 & arm64-movz 0 0 0 & arm64-ret

  a64-rt-heap-advance : List Integer
  a64-rt-heap-advance =
   arm64-add 28 28 0 & arm64-movz 0 0 0 & arm64-ret

  a64-rt-alloc-bytes : List Integer
  a64-rt-alloc-bytes =
   arm64-mov 9 0 & arm64-mov 0 28 & arm64-add 28 28 9 & arm64-ret

Section: list-set-at (a0=list, a1=index, a2=value -> the same list)

 Writes the slot and returns the list it was given, which is the
 semantics the Developer's Guide states and `__list_set_at` on x86-64
 implements in five instructions. Element i lives at [list + 8 + i*8],
 so the whole operation is a shift, an add, a store and a return; x0
 already holds the list, so nothing needs to move into place.

  a64-rt-list-set-at : List Integer
  a64-rt-list-set-at =
   let i = []
   in let i = i & arm64-lsl-imm 1 1 3
   in let i = a64-rt-emit i (arm64-add 1 0 1)
   in let i = a64-rt-emit i (arm64-str 2 1 8)
   in a64-rt-emit i arm64-ret

Section: list-insert-at (a0=list, a1=index, a2=value -> new list)

  a64-rt-list-insert-at : List Integer
  a64-rt-list-insert-at =
   let i = []
   in let i = a64-rt-emit i (arm64-stp-pre 29 30 31 (0 - 64))
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-mov 19 0)
   in let i = a64-rt-emit i (arm64-mov 20 1)
   in let i = a64-rt-emit i (arm64-mov 21 2)
   in let i = a64-rt-emit i (arm64-ldr 22 19 0)
   in let i = a64-rt-emit i (arm64-add-imm 9 22 1)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 10 9 1)
   in let i = i & arm64-lsl-imm 10 10 3
   in let i = a64-rt-emit i (arm64-add 28 28 10)
   in let i = a64-rt-emit i (arm64-str 9 0 0)
   in let i = i & arm64-movz 9 0 0
   in let loop1 = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 9 20)
   in let exit1 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-lsl-imm 10 9 3
   in let i = a64-rt-emit i (arm64-add 11 19 10)
   in let i = a64-rt-emit i (arm64-ldr 12 11 8)
   in let i = a64-rt-emit i (arm64-add 11 0 10)
   in let i = a64-rt-emit i (arm64-str 12 11 8)
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-b ((loop1 - list-length i / 4) * 4))
   in let exit1-label = list-length i / 4
   in let i = i & arm64-lsl-imm 10 20 3
   in let i = a64-rt-emit i (arm64-add 11 0 10)
   in let i = a64-rt-emit i (arm64-str 21 11 8)
   in let i = a64-rt-emit i (arm64-mov 9 20)
   in let loop2 = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 9 22)
   in let exit2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-lsl-imm 10 9 3
   in let i = a64-rt-emit i (arm64-add 11 19 10)
   in let i = a64-rt-emit i (arm64-ldr 12 11 8)
   in let i = a64-rt-emit i (arm64-add-imm 13 9 1)
   in let i = i & arm64-lsl-imm 13 13 3
   in let i = a64-rt-emit i (arm64-add 11 0 13)
   in let i = a64-rt-emit i (arm64-str 12 11 8)
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-b ((loop2 - list-length i / 4) * 4))
   in let exit2-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp-post 29 30 31 64)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i exit1 (arm64-b-cond 10 ((exit1-label - exit1) * 4))
   in a64-patch-insn-raw i exit2 (arm64-b-cond 10 ((exit2-label - exit2) * 4))

Section: substring (a0=text, a1=start, a2=length -> new text)

  a64-rt-substring : List Integer
  a64-rt-substring =
   let i = []
   in let i = a64-rt-emit i (arm64-mov 9 0)
   in let i = a64-rt-emit i (arm64-mov 10 1)
   in let i = a64-rt-emit i (arm64-mov 11 2)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 12 11 15)
   in let i = i & arm64-lsr-imm 12 12 3
   in let i = i & arm64-lsl-imm 12 12 3
   in let i = a64-rt-emit i (arm64-add 28 28 12)
   in let i = a64-rt-emit i (arm64-str 11 0 0)
   in let i = a64-rt-emit i (arm64-add 12 9 10)
   in let i = a64-rt-emit i (arm64-add-imm 12 12 8)
   in let i = i & arm64-movz 13 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 13 11)
   in let exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 14 12 13)
   in let i = a64-rt-emit i (arm64-ldrb 14 14 0)
   in let i = a64-rt-emit i (arm64-add 15 0 13)
   in let i = a64-rt-emit i (arm64-strb 14 15 8)
   in let i = a64-rt-emit i (arm64-add-imm 13 13 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = a64-rt-emit i arm64-ret
   in a64-patch-insn-raw i exit (arm64-b-cond 10 ((exit-label - exit) * 4))

Section: text-contains (a0=haystack, a1=needle -> 0 or 1)

  a64-rt-text-contains : List Integer
  a64-rt-text-contains =
   let i = []
   in let i = a64-rt-emit i (arm64-stp-pre 29 30 31 (0 - 64))
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldr 19 0 0)
   in let i = a64-rt-emit i (arm64-ldr 20 1 0)
   in let i = a64-rt-emit i (arm64-add-imm 21 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 22 1 8)
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-sub 10 19 20)
   in let i = a64-rt-emit i (arm64-add-imm 10 10 1)
   in let outer = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let outer-exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 11 0 0
   in let inner = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 20)
   in let inner-exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 12 9 11)
   in let i = a64-rt-emit i (arm64-add 12 21 12)
   in let i = a64-rt-emit i (arm64-ldrb 12 12 0)
   in let i = a64-rt-emit i (arm64-add 13 22 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-cmp 12 13)
   in let mismatch = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((inner - list-length i / 4) * 4))
   in let found-label = list-length i / 4
   in let i = i & arm64-movz 0 1 0
   in let jmp-end = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let mismatch-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-b ((outer - list-length i / 4) * 4))
   in let notfound-label = list-length i / 4
   in let i = i & arm64-movz 0 0 0
   in let end-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp-post 29 30 31 64)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i outer-exit (arm64-b-cond 10 ((notfound-label - outer-exit) * 4))
   in let i = a64-patch-insn-raw i inner-exit (arm64-b-cond 10 ((found-label - inner-exit) * 4))
   in let i = a64-patch-insn-raw i mismatch (arm64-b-cond 1 ((mismatch-label - mismatch) * 4))
   in a64-patch-insn-raw i jmp-end (arm64-b ((end-label - jmp-end) * 4))

Section: text-starts-with (a0=text, a1=prefix -> 0 or 1)

  a64-rt-text-starts-with : List Integer
  a64-rt-text-starts-with =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-ldr 10 1 0)
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let too-short = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 0 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 1 1 8)
   in let i = i & arm64-movz 11 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 10)
   in let match-label-idx = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 12 0 11)
   in let i = a64-rt-emit i (arm64-ldrb 12 12 0)
   in let i = a64-rt-emit i (arm64-add 13 1 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-cmp 12 13)
   in let no-match = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let match-label = list-length i / 4
   in let i = i & arm64-movz 0 1 0
   in let i = a64-rt-emit i arm64-ret
   in let no-match-label = list-length i / 4
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i too-short (arm64-b-cond 11 ((no-match-label - too-short) * 4))
   in let i = a64-patch-insn-raw i match-label-idx (arm64-b-cond 10 ((match-label - match-label-idx) * 4))
   in a64-patch-insn-raw i no-match (arm64-b-cond 1 ((no-match-label - no-match) * 4))

Section: text-to-integer (a0=text -> integer, 0 if invalid)

  a64-rt-text-to-integer : List Integer
  a64-rt-text-to-integer =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-add-imm 10 0 8)
   in let i = i & arm64-movz 0 0 0
   in let i = i & arm64-movz 11 0 0
   in let i = i & arm64-movz 12 0 0
   in let i = a64-rt-emit i (arm64-add 13 10 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = i & arm64-movz 14 73 0
   in let i = a64-rt-emit i (arm64-cmp 13 14)
   in let not-neg = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 12 1 0
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let not-neg-label = list-length i / 4
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 9)
   in let exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 13 10 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-sub-imm 13 13 3)
   in let i = a64-rt-emit i (arm64-cmp-imm 13 9)
   in let non-digit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 14 10 0
   in let i = a64-rt-emit i (arm64-mul 0 0 14)
   in let i = a64-rt-emit i (arm64-add 0 0 13)
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-cbz 12 8)
   in let i = a64-rt-emit i (arm64-neg 0 0)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i not-neg (arm64-b-cond 1 ((not-neg-label - not-neg) * 4))
   in let i = a64-patch-insn-raw i non-digit (arm64-b-cond 8 ((exit-label - non-digit) * 4))
   in a64-patch-insn-raw i exit (arm64-b-cond 10 ((exit-label - exit) * 4))

Section: text-compare (a0=text-a, a1=text-b -> -1/0/1)

  a64-rt-text-compare : List Integer
  a64-rt-text-compare =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-ldr 10 1 0)
   in let i = a64-rt-emit i (arm64-add-imm 0 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 1 1 8)
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let i = a64-rt-emit i (arm64-csel 11 9 10 11)
   in let i = i & arm64-movz 12 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 12 11)
   in let exit-cmp = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 13 0 12)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-add 14 1 12)
   in let i = a64-rt-emit i (arm64-ldrb 14 14 0)
   in let i = a64-rt-emit i (arm64-cmp 13 14)
   in let bne-diff = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 12 12 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let diff-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-sub 0 13 14)
   in let i = a64-rt-emit i arm64-ret
   in let equal-len-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-sub 0 9 10)
