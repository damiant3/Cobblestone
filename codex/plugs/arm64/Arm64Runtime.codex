   in let i = a64-rt-emit i (arm64-cmp 11 9)
   in let copy2-exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 12 10 11)
   in let i = a64-rt-emit i (arm64-ldrb 12 12 0)
   in let i = a64-rt-emit i (arm64-add 13 0 11)
   in let i = a64-rt-emit i (arm64-strb 12 13 8)
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((copy2 - list-length i / 4) * 4))
   in let copy2-done = list-length i / 4
   in let i = a64-rt-emit i (arm64-ldr 9 26 0)
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-str 9 26 0)
   in let i = i & arm64-lsl-imm 10 9 3
   in let i = a64-rt-emit i (arm64-add 10 25 10)
   in let i = a64-rt-emit i (arm64-str 0 10 0)
   in let i = a64-rt-emit i (arm64-mov 0 25)
   in let i = a64-rt-emit i (arm64-ldp 25 26 31 64)
   in let i = a64-rt-emit i (arm64-ldp 23 24 31 48)
