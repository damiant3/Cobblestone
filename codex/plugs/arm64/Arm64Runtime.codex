Section: Boot Tail

 The multi-core shape asks PSCI to start core 1 at the AP stub below,
 through an `hvc #0` whose immediate is patched to the stub's offset. That
 instruction is only legal where PSCI answers it. QEMU virt does; the
 committed Renode board does not, so the guest never reaches `opening` and
 the UART stays silent for the whole run. That is what shipping this
 sequence unconditionally cost: not the SMP test, but every other ARM64
 program on Renode.

  a64-emit-smp-boot : A64State -> A64State
  a64-emit-smp-boot (st) =
   let adr-idx = st.insn-count
   in let st4a = a64-emit st arm64-nop
   in let st4b = a64-emit-li st4a 0 a64-rt-cpu-on-id
   in let st4c = a64-emit-li st4b 1 1
   in let st4d = a64-emit-li st4c 3 0
   in let st4e = a64-emit st4d a64-rt-hvc
   in let st5 = a64-emit-call-to st4e "opening"
   in let st6 = a64-emit st5 a64-rt-wfi
   in let st7 = a64-emit st6 (arm64-b (-4))
   in let ap-idx = st7.insn-count
   in let st7a = a64-emit-li st7 1 a64-rt-ap-marker-addr
   in let st7b = a64-emit-li st7a 2 1
   in let st7c = a64-emit st7b (arm64-str-w 2 1 0)
   in let st7d = a64-emit st7c a64-rt-wfi
   in let st7e = a64-emit st7d (arm64-b (-4))
   in a64-patch-insn st7e adr-idx (a64-adr-bytes ((ap-idx - adr-idx) * 4) 2)

  a64-emit-uni-boot : A64State -> A64State
  a64-emit-uni-boot (st) =
   let st5 = a64-emit-call-to st "opening"
   in let st6 = a64-emit st5 a64-rt-wfi
   in a64-emit st6 (arm64-b (-4))

Section: Fault Handler

   !A64FAULT V=4 ESR=0000000002000000 ELR=0000000040200018 FAR=0000000000000000

 x19 keeps the index because the character writer clobbers x9. x10 is the
 UART, x11 the value being printed, x12-x14 the hex loop.

  a64-rt-fault-putc : List Integer, Integer -> List Integer
  a64-rt-fault-putc (i) (c) =
   let i = a64-rt-emit i (arm64-movz 9 c 0)
   in a64-rt-emit i (arm64-str-w 9 10 0)

  a64-rt-fault-puts : List Integer, List Integer, Integer -> List Integer
  a64-rt-fault-puts (i) (cs) (n) =
   if n >= list-length cs then i
   else a64-rt-fault-puts (a64-rt-fault-putc i (list-at cs n)) cs (n + 1)

 Print register `src` as hex, most significant nibble first, starting at bit
 `start-shift`. Pass 60 for a full 16-nibble register and 0 for a single
 nibble.

  a64-rt-fault-hex : List Integer, Integer, Integer -> List Integer
  a64-rt-fault-hex (i) (src) (start-shift) =
   let i = a64-rt-emit i (arm64-movz 12 start-shift 0)
   in let i = a64-rt-emit i (arm64-movz 14 15 0)
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-lsr 13 src 12)
   in let i = a64-rt-emit i (arm64-and 13 13 14)
   in let i = a64-rt-emit i (arm64-cmp-imm 13 10)
   in let lt-slot = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 13 13 55)
   in let skip-slot = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let digit = list-length i / 4
   in let i = a64-rt-emit i (arm64-add-imm 13 13 48)
   in let store = list-length i / 4
   in let i = a64-rt-emit i (arm64-str-w 13 10 0)
   in let i = a64-rt-emit i (arm64-cmp-imm 12 0)
   in let done-slot = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-sub-imm 12 12 4)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let done = list-length i / 4
   in let i = a64-patch-insn-raw i lt-slot (arm64-b-cond arm64-cond-lt ((digit - lt-slot) * 4))
   in let i = a64-patch-insn-raw i skip-slot (arm64-b ((store - skip-slot) * 4))
   in a64-patch-insn-raw i done-slot (arm64-b-cond arm64-cond-eq ((done - done-slot) * 4))

 ESR, ELR and FAR are banked per exception level, and we do not get to
 assume which one we are at: QEMU virt enters at EL1, and the committed
 Renode board enters at EL3 (it declares `supportsTwoSecurityStates` and
 wires an EL3 timer). Reading the EL1 copy at EL3 answers about a level the
 fault did not happen at. So read the EL once into x20 and dispatch.

  a64-rt-fault-mrs-el : List Integer, Integer, Integer -> List Integer
  a64-rt-fault-mrs-el (i) (dst) (base) =
   let i = a64-rt-emit i (arm64-cmp-imm 20 3)
   in let e3 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-cmp-imm 20 2)
   in let e2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-mrs dst base)
   in let d1 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let l2 = list-length i / 4
   in let i = a64-rt-emit i (arm64-mrs dst (base + #2000))
   in let d2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let l3 = list-length i / 4
   in let i = a64-rt-emit i (arm64-mrs dst (base + #3000))
   in let done = list-length i / 4
   in let i = a64-patch-insn-raw i e3 (arm64-b-cond arm64-cond-eq ((l3 - e3) * 4))
   in let i = a64-patch-insn-raw i e2 (arm64-b-cond arm64-cond-eq ((l2 - e2) * 4))
   in let i = a64-patch-insn-raw i d1 (arm64-b ((done - d1) * 4))
   in a64-patch-insn-raw i d2 (arm64-b ((done - d2) * 4))

  a64-rt-fault-handler : List Integer
  a64-rt-fault-handler =
   let i = a64-rt-emit [] (arm64-mov 19 9)
   in let i = i & arm64-li 10 a64-rt-pl011-base
   in let i = a64-rt-emit i (arm64-mrs 20 sysreg-currentel)
   in let i = a64-rt-emit i (arm64-lsr-imm 20 20 2)
   in let i = a64-rt-emit i (arm64-movz 21 3 0)
   in let i = a64-rt-emit i (arm64-and 20 20 21)
   in let i = a64-rt-fault-puts i [33, 65, 54, 52, 70, 65, 85, 76, 84, 32, 86, 61] 0
   in let i = a64-rt-fault-hex i 19 0
   in let i = a64-rt-fault-puts i [32, 69, 76, 61] 0
   in let i = a64-rt-fault-hex i 20 0
   in let i = a64-rt-fault-puts i [32, 69, 83, 82, 61] 0
   in let i = a64-rt-fault-mrs-el i 11 sysreg-esr-el1
   in let i = a64-rt-fault-hex i 11 60
   in let i = a64-rt-fault-puts i [32, 69, 76, 82, 61] 0
   in let i = a64-rt-fault-mrs-el i 11 sysreg-elr-el1
   in let i = a64-rt-fault-hex i 11 60
   in let i = a64-rt-fault-puts i [32, 70, 65, 82, 61] 0
   in let i = a64-rt-fault-mrs-el i 11 sysreg-far-el1
   in let i = a64-rt-fault-hex i 11 60
   in let i = a64-rt-fault-putc i 10
   in let i = a64-rt-emit i a64-rt-wfi
   in a64-rt-emit i (arm64-b (-4))

  a64-rt-write-vbar-current-el : List Integer
  a64-rt-write-vbar-current-el =
   let i = a64-rt-emit [] (arm64-mrs 11 sysreg-currentel)
   in let i = a64-rt-emit i (arm64-lsr-imm 11 11 2)
   in let i = a64-rt-emit i (arm64-movz 12 3 0)
   in let i = a64-rt-emit i (arm64-and 11 11 12)
   in let i = a64-rt-emit i (arm64-cmp-imm 11 3)
   in let e3 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-cmp-imm 11 2)
   in let e2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-msr sysreg-vbar-el1 9)
   in let d1 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let l2 = list-length i / 4
   in let i = a64-rt-emit i (arm64-msr sysreg-vbar-el2 9)
   in let d2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let l3 = list-length i / 4
   in let i = a64-rt-emit i (arm64-msr sysreg-vbar-el3 9)
   in let done = list-length i / 4
   in let i = a64-patch-insn-raw i e3 (arm64-b-cond arm64-cond-eq ((l3 - e3) * 4))
   in let i = a64-patch-insn-raw i e2 (arm64-b-cond arm64-cond-eq ((l2 - e2) * 4))
   in let i = a64-patch-insn-raw i d1 (arm64-b ((done - d1) * 4))
   in a64-patch-insn-raw i d2 (arm64-b ((done - d2) * 4))

  a64-rt-patch-vectors : A64State, Integer, Integer -> A64State
  a64-rt-patch-vectors (st) (handler) (idx) =
   if idx >= 16 then st
   else let slot = a64-rt-vt-branch-slot idx
    in a64-rt-patch-vectors (a64-patch-insn st slot (arm64-b ((handler - slot) * 4))) handler (idx + 1)

Section: Process Table

 The table sits at the mirror of x86-64's `proc-table-base` 20480: the
 MMIO helpers below map every address under 16 MiB onto RAM at #40000000
 (`a64-rt-remap-addr`), which is how a test written against the x86-64
 map reads this table by its x86-64 address. The ELF loads at #40100000
 and grows upward with the program, so nothing else can be placed above
 it at a fixed address; [#40005000, #40006010) holds sixteen entries, a
 boot-time zero where the current-process cell used to be, then an
 eight-byte zero that is the empty text a refused scope read answers. The
 running pid is a function of the stack pointer, as on x86-64
 (`emit-slot-from-addr`): a stack inside the spawn pool names its slot,
 any other stack is proc 0. The entry layout is x86-64's by offset
 (`X86_64Boot.codex` "Process Table Layout": 256-byte entries, network
 scope at 24, exit status at 32, capability word at 56, filesystem scope
 at 64), so a library predicate that reads these cells reads the same
 shape on both targets. Bit 14 is Foreword Capability's
 `cap-capability-admin`, the bit x86-64 demands of the CALLER before it
 will restrict a word or store a scope. State words as x86-64: free 0,
 ready 1, running 2, blocked 3.

  a64-proc-table-base : Integer = #40005000
  a64-current-proc-addr : Integer = #40006000
  a64-heap-start : Integer = #40202000
  a64-proc-entry-shift : Integer = 8
  a64-proc-net-scope-offset : Integer = 24
  a64-proc-cap-offset : Integer = 56
  a64-proc-scope-offset : Integer = 64
  a64-proc-cap-admin-bit : Integer = 14
  a64-proc-empty-text-addr : Integer = #40006008
  a64-proc-table-qwords : Integer = 514
  a64-proc-state-running : Integer = 2
  a64-spawn-pool-base : Integer = #50000000
  a64-spawn-pool-span : Integer = #20000000
  a64-spawn-slot-region-shift : Integer = 25

  a64-rt-current-slot-in-x9 : List Integer -> List Integer
  a64-rt-current-slot-in-x9 (i) =
   let i = a64-rt-emit i (arm64-mov 9 31)
   in let i = i & arm64-li 10 a64-spawn-pool-base
   in let i = a64-rt-emit i (arm64-sub 9 9 10)
   in let i = i & arm64-li 10 a64-spawn-pool-span
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let outside = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-lsr-imm 9 9 a64-spawn-slot-region-shift)
   in let done = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let zero-label = list-length i / 4
   in let i = i & arm64-movz 9 0 0
   in let end-label = list-length i / 4
   in let i = a64-patch-insn-raw i outside (arm64-b-cond 2 ((zero-label - outside) * 4))
   in a64-patch-insn-raw i done (arm64-b ((end-label - done) * 4))

  a64-rt-proc-entry-in-x0 : List Integer -> List Integer
  a64-rt-proc-entry-in-x0 (i) =
   let i = a64-rt-emit i (arm64-lsl-imm 0 0 a64-proc-entry-shift)
   in let i = i & arm64-li 9 a64-proc-table-base
   in a64-rt-emit i (arm64-add 0 0 9)

  a64-rt-proc-caller-cap-in-x9 : List Integer -> List Integer
  a64-rt-proc-caller-cap-in-x9 (i) =
   let i = a64-rt-current-slot-in-x9 i
   in let i = a64-rt-emit i (arm64-lsl-imm 9 9 a64-proc-entry-shift)
   in let i = i & arm64-li 10 a64-proc-table-base
   in let i = a64-rt-emit i (arm64-add 9 9 10)
   in a64-rt-emit i (arm64-ldr 9 9 a64-proc-cap-offset)

  a64-rt-proc-fail-minus-one : List Integer -> List Integer
  a64-rt-proc-fail-minus-one (i) =
   let i = i & arm64-li 0 (0 - 1)
   in a64-rt-emit i arm64-ret

  a64-rt-proc-fail-empty-text : List Integer -> List Integer
  a64-rt-proc-fail-empty-text (i) =
   let i = i & arm64-li 0 a64-proc-empty-text-addr
   in a64-rt-emit i arm64-ret

  a64-rt-process-get-pid : List Integer
  a64-rt-process-get-pid =
   let i = a64-rt-current-slot-in-x9 []
   in let i = a64-rt-emit i (arm64-mov 0 9)
   in a64-rt-emit i arm64-ret

  a64-rt-process-get-cap : List Integer
  a64-rt-process-get-cap =
   let i = a64-rt-emit [] (arm64-cmp-imm 0 16)
   in let range-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-proc-entry-in-x0 i
   in let i = a64-rt-emit i (arm64-ldr 0 0 a64-proc-cap-offset)
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in a64-patch-insn-raw i range-deny (arm64-b-cond arm64-cond-ge ((fail-label - range-deny) * 4))

  a64-rt-process-get-scope-at : Integer -> List Integer
  a64-rt-process-get-scope-at (offset) =
   let i = a64-rt-emit [] (arm64-cmp-imm 0 16)
   in let range-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-proc-entry-in-x0 i
   in let i = a64-rt-emit i (arm64-ldr 0 0 offset)
   in let null-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-empty-text i
   in let i = a64-patch-insn-raw i range-deny (arm64-b-cond arm64-cond-ge ((fail-label - range-deny) * 4))
   in a64-patch-insn-raw i null-deny (arm64-cbz 0 ((fail-label - null-deny) * 4))

  a64-rt-process-set-scope-at : Integer -> List Integer
  a64-rt-process-set-scope-at (offset) =
   let i = a64-rt-proc-caller-cap-in-x9 []
   in let i = i & arm64-li 10 (bit-shl 1 a64-proc-cap-admin-bit)
   in let i = a64-rt-emit i (arm64-tst 9 10)
   in let cap-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-cmp-imm 0 16)
   in let range-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-proc-entry-in-x0 i
   in let i = a64-rt-emit i (arm64-str 1 0 offset)
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in let i = a64-patch-insn-raw i cap-deny (arm64-b-cond arm64-cond-eq ((fail-label - cap-deny) * 4))
   in a64-patch-insn-raw i range-deny (arm64-b-cond arm64-cond-ge ((fail-label - range-deny) * 4))

  a64-rt-process-restrict-cap : List Integer
  a64-rt-process-restrict-cap =
   let i = a64-rt-proc-caller-cap-in-x9 []
   in let i = i & arm64-li 10 (bit-shl 1 a64-proc-cap-admin-bit)
   in let i = a64-rt-emit i (arm64-tst 9 10)
   in let cap-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-cmp-imm 0 16)
   in let range-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-proc-entry-in-x0 i
   in let i = a64-rt-emit i (arm64-ldr 9 0 a64-proc-cap-offset)
   in let i = i & arm64-movz 10 1 0
   in let i = a64-rt-emit i (arm64-lsl 10 10 1)
   in let i = i & arm64-li 11 (0 - 1)
   in let i = a64-rt-emit i (arm64-xor 10 10 11)
   in let i = a64-rt-emit i (arm64-and 9 9 10)
   in let i = a64-rt-emit i (arm64-str 9 0 a64-proc-cap-offset)
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in let i = a64-patch-insn-raw i cap-deny (arm64-b-cond arm64-cond-eq ((fail-label - cap-deny) * 4))
   in a64-patch-insn-raw i range-deny (arm64-b-cond arm64-cond-ge ((fail-label - range-deny) * 4))

  a64-emit-proc-table-init : A64State -> A64State
  a64-emit-proc-table-init (st) =
   let st1 = a64-emit-li st 10 a64-proc-table-base
   in let st2 = a64-emit-li st1 11 a64-proc-table-qwords
   in let st3 = a64-emit st2 (arm64-movz 9 0 0)
   in let loop = st3.insn-count
   in let st4 = a64-emit st3 (arm64-str 9 10 0)
   in let st5 = a64-emit st4 (arm64-add-imm 10 10 8)
   in let st6 = a64-emit st5 (arm64-sub-imm 11 11 1)
   in let st7 = a64-emit st6 (arm64-cbnz 11 ((loop - st6.insn-count) * 4))
   in let st8 = a64-emit-li st7 10 a64-proc-table-base
   in let st9 = a64-emit st8 (arm64-movz 9 a64-proc-state-running 0)
   in let st10 = a64-emit st9 (arm64-str 9 10 0)
   in let st11 = a64-emit-li st10 10 a64-fs-elevated-addr
   in a64-emit st11 (arm64-str 31 10 0)

Section: Capability Gates

 The analog of x86-64's emit-check-capability (X86_64Boot.codex): the
 caller's capability word against one bit, leaving the flags for the
 caller's own branch. Z set means denied; the caller patches a b.eq to its
 refusal. x86-64 gates the network family INLINE in each helper
 (X86_64IPCHelpers.codex net-status, net-get-hwaddr, net-send-raw,
 net-recv-raw) and every refusal answers -1; the same four are gated here
 with the same answer. ARM64 has no NIC, so the admitted answers are what
 x86-64 answers with no NIC present: status 0, hwaddr byte 0, send 0,
 recv 0.

  a64-cap-network-read : Integer = 8
  a64-cap-network-write : Integer = 9

  a64-rt-check-capability : List Integer, Integer -> List Integer
  a64-rt-check-capability (i) (bit) =
   let i = a64-rt-proc-caller-cap-in-x9 i
   in let i = i & arm64-li 10 (bit-shl 1 bit)
   in a64-rt-emit i (arm64-tst 9 10)

  a64-rt-gated-zero : Integer -> List Integer
  a64-rt-gated-zero (bit) =
   let i = a64-rt-check-capability [] bit
   in let cap-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in a64-patch-insn-raw i cap-deny (arm64-b-cond arm64-cond-eq ((fail-label - cap-deny) * 4))

  a64-rt-net-get-hwaddr : List Integer
  a64-rt-net-get-hwaddr =
   let i = a64-rt-check-capability [] a64-cap-network-read
   in let cap-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-cmp-imm 0 6)
   in let range-deny = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let fail-label = list-length i / 4
   in let i = a64-rt-proc-fail-minus-one i
   in let i = a64-patch-insn-raw i cap-deny (arm64-b-cond arm64-cond-eq ((fail-label - cap-deny) * 4))
   in a64-patch-insn-raw i range-deny (arm64-b-cond arm64-cond-ge ((fail-label - range-deny) * 4))

Section: Block device helpers

 These are the first routines IN THIS CHAPTER that call a Codex function
 in the program rather than doing their own work. Every other helper here
 is self-contained machine code.

 **The mechanism was already there and an earlier version of this
 paragraph said it was not.** `a64-add-call-patch`
 (`Arm64CodeGen.codex:269`) records an `A64CallPatch` at the current
 instruction, and `__opening_print` in `Arm64CodeGen3.codex` already used
 it. What was true is narrower and was measured over the wrong scope: no
 routine in THIS file had ever done it, so a grep of this file for
 `arm64-bl` and `call-patches` came back empty and got read as "the plug
 cannot do this".

 `a64-emit-call-to` is a two-line wrapper: record the patch, then emit the
 placeholder it names. The target is looked up in the same table
 (`a64-find-func-offset` searches the runtime funcs AND the program's own
 functions), so `vb-capacity-auto` resolves because the program reached
 `Foreword chapter VirtioBlk`. **A program that does not gets the standing
 unresolved-call warning naming `vb-capacity-auto`**, which is the honest
 outcome: the builtin is present and its driver is not.

 The block builtins are deliberately NOT `a64-rt-gated-zero` stubs like
 the net helpers. A stub would silence the unresolved-call warnings and
 return a defined value, which makes a disk path that cannot work look
 like one that does.

 Slot geometry is QEMU virt's: virtio-mmio at 0x0a000000, 0x200 apart, 32
 slots. It is the machine's property and it is passed as arguments, so the
 driver chapter stays free of it.

  a64-vblk-mmio-base : Integer = #0A000000
  a64-vblk-mmio-stride : Integer = #200
  a64-vblk-mmio-slots : Integer = 32

 The rings need a fixed, page-aligned home the device can write into, and
 it must not collide with anything. Measured 2026-08-16, the whole fixed
 map on this lane is `#40000010` (try-fail flag), `#40000080` (load base)
 and `#40005000`..`#40006010` (process table and its neighbours), with the
 ELF at `#40100000` growing upward and the stack descending from
 `#80000000`. `#40010000` is clear of all of it and leaves 12,292 bytes of
 rings plus the cached device word inside one 16 KB span. It sits BELOW
 the heap rather than above it, so `a64-heap-start` does not move and the
 process table is untouched.

 Added to that map since: the effect-op slot table at
 `#40020000`..`#40022000` (`a64-effect-op-table-base`,
 `a64-effect-op-slots` in `Arm64CodeGen3.codex`), moved off the ELF load
 base where it had room for only 16 slots, and the three deck cells
 below. The next free span is `#40022018`..`#40100000`.

 The deck needs no region, which is the thing the plugs-backlog 1.33 row
 got wrong and the reason it was sized as an allocator. A deck is a
 WATERMARK inside the same bump heap, not a second arena: `build` saves
 the heap position, records it with `__deck-set`, and advances past the
 reservation, and `phase-compact` is `__heap-restore (__deck-pos)`, so
 everything below the mark survives a compaction and everything above it
 is reclaimed. All the state that takes is three cells, and x28 is this
 lane's allocation pointer the way R10 is x86-64's.

  a64-deck-pos-addr : Integer = #40022000
  a64-deck-bound-counter-addr : Integer = #40022008
  a64-bivy-save-addr : Integer = #40022010

  a64-vblk-ring-base : Integer = #40010000

  a64-emit-call-to : A64State, Text -> A64State
  a64-emit-call-to (st) (name) =
   let st1 = a64-add-call-patch st name
   in a64-emit st1 arm64-nop

 A frame is needed because this routine is not a leaf: the callee clobbers
 x30 and returning into a clobbered link register is a jump into the
 callee. Sixteen bytes is under the 4095 the immediate forms mask at.

  a64-svc-block-read : Integer = 10
  a64-svc-block-write : Integer = 11
  a64-svc-block-count : Integer = 12
  a64-cap-block-device : Integer = 10
  a64-fs-elevated-addr : Integer = #40008D88

  a64-emit-svc-stub : A64State, Text, Integer -> A64State
  a64-emit-svc-stub (st) (name) (n) =
   let st1 = a64-record-func st name
   in let st2 = a64-emit st1 (arm64-svc n)
   in a64-emit st2 arm64-ret

 The helpers are emitted only when the DRIVER is in the program, and that
 is what lets an unresolved call be a hard failure rather than a warning.
 They call `vb-capacity-auto`, `vb-read-auto` and `vb-write-auto`, which a
 program that never declares `Device.Block` correctly eliminates, so
 emitting them unconditionally put three unresolved calls in EVERY compile
 on this lane. A check that fires on every subject cannot be turned into a
 refusal, and allow-listing the `vb-` names would have excused exactly the
 calls that matter in a program that does declare the capability.

 The three `__block_*_body` CALLS in `a64-emit-sync-handler` are gated on the
 same answer, because they would otherwise be three more unresolved calls of
 their own. The dispatch around them is not gated; the reason is beside it.

  a64-emit-block-helpers : A64State -> A64State
  a64-emit-block-helpers (st) =
   if ((st.extra).has-block-driver) == False then st
   else let sta = a64-emit-svc-stub st "block-sector-count" a64-svc-block-count
   in let stb = a64-emit-svc-stub sta "block-read-sector" a64-svc-block-read
   in let stc = a64-emit-svc-stub stb "block-write-sector" a64-svc-block-write
   in let st1 = a64-record-func stc "__block_count_body"
   in let st2 = a64-emit st1 (arm64-sub-imm a64-sp a64-sp 16)
   in let st3 = a64-emit st2 (arm64-stp a64-fp a64-lr a64-sp 0)
   in let st4 = a64-emit-li st3 0 a64-vblk-mmio-base
   in let st5 = a64-emit-li st4 1 a64-vblk-mmio-stride
   in let st6 = a64-emit-li st5 2 a64-vblk-mmio-slots
   in let st7 = a64-emit-call-to st6 "vb-capacity-auto"
   in let st8 = a64-emit st7 (arm64-ldp a64-fp a64-lr a64-sp 0)
   in let st9 = a64-emit st8 (arm64-add-imm a64-sp a64-sp 16)
   in let st10 = a64-emit st9 arm64-ret
   in a64-emit-block-read st10

 The buffer is bump-allocated from the heap frontier in x28 and its
 address is the answer, which is x86-64's contract for this builtin
 (`emit-block-read-sector-helper`: it takes r10, advances it by 512, reads
 into the old value and returns it). A caller holds the returned pointer,
 so the 512 bytes must not be handed out again.

 x19 is callee-saved and holds that pointer across the call, so it is
 saved and restored. The incoming sector arrives in x0 and has to move to
 x4 BEFORE the argument registers are loaded, or loading x0 destroys it.

  a64-emit-block-read : A64State -> A64State
  a64-emit-block-read (st) =
   let st1 = a64-record-func st "__block_read_body"
   in let st2 = a64-emit st1 (arm64-sub-imm a64-sp a64-sp 32)
   in let st3 = a64-emit st2 (arm64-stp a64-fp a64-lr a64-sp 0)
   in let st4 = a64-emit st3 (arm64-stp a64-x19 a64-x19 a64-sp 16)
   in let st5 = a64-emit st4 (arm64-mov 4 0)
   in let st6 = a64-emit st5 (arm64-mov a64-x19 28)
   in let st7 = a64-emit st6 (arm64-add-imm 28 28 512)
   in let st8 = a64-emit st7 (arm64-mov 5 a64-x19)
   in let st9 = a64-emit-li st8 0 a64-vblk-mmio-base
   in let st10 = a64-emit-li st9 1 a64-vblk-mmio-stride
   in let st11 = a64-emit-li st10 2 a64-vblk-mmio-slots
   in let st12 = a64-emit-li st11 3 a64-vblk-ring-base
   in let st13 = a64-emit-call-to st12 "vb-read-auto"
   in let st14 = a64-emit st13 (arm64-mov 0 a64-x19)
   in let st15 = a64-emit st14 (arm64-ldp a64-x19 a64-x19 a64-sp 16)
   in let st16 = a64-emit st15 (arm64-ldp a64-fp a64-lr a64-sp 0)
   in let st17 = a64-emit st16 (arm64-add-imm a64-sp a64-sp 32)
   in let st18 = a64-emit st17 arm64-ret
   in a64-emit-block-write st18

 The write takes the buffer from its CALLER rather than allocating one, so
 there is no x19 to preserve. Both incoming arguments move up before the
 argument registers are loaded, for the same reason as the read: loading
 x0 first destroys the sector.

 **`block-write-sector` answers 0 for SUCCESS.** That is x86-64's
 contract, and it is not a convention this lane may choose: x86-64's
 helper ends `li reg-rax 0` unconditionally
 (`X86_64Helpers.codex:emit-block-write-sector-helper`), and `Fat16` reads
 it that way -- `fat16-claim-cluster` does `if w == 0 then c else 0`, so a
 non-zero answer means the cluster was NOT claimed. The driver keeps 1 for
 success internally, like every other `vb-` entry point, and the
 translation happens here because here is the contract boundary. Measured
 2026-08-16: returning the driver's 1 straight through made `fs-layer`
 report `<write failed>` with every sector write actually succeeding on
 the device.

 The `sub` maps 1 to 0 and 0 to -1, so success answers 0 and failure
 answers something that is not 0, which is all either side asks.

  a64-emit-block-write : A64State -> A64State
  a64-emit-block-write (st) =
   let st1 = a64-record-func st "__block_write_body"
   in let st2 = a64-emit st1 (arm64-sub-imm a64-sp a64-sp 16)
   in let st3 = a64-emit st2 (arm64-stp a64-fp a64-lr a64-sp 0)
   in let st4 = a64-emit st3 (arm64-mov 5 1)
   in let st5 = a64-emit st4 (arm64-mov 4 0)
   in let st6 = a64-emit-li st5 0 a64-vblk-mmio-base
   in let st7 = a64-emit-li st6 1 a64-vblk-mmio-stride
   in let st8 = a64-emit-li st7 2 a64-vblk-mmio-slots
   in let st9 = a64-emit-li st8 3 a64-vblk-ring-base
   in let st10 = a64-emit-call-to st9 "vb-write-auto"
   in let st10a = a64-emit st10 (arm64-sub-imm 0 0 1)
   in let st11 = a64-emit st10a (arm64-ldp a64-fp a64-lr a64-sp 0)
   in let st12 = a64-emit st11 (arm64-add-imm a64-sp a64-sp 16)
   in a64-emit st12 arm64-ret

Section: FileSystem servicer

 The capability bits are Foreword Capability's own, and the refusal
 answers are x86-64's: the empty text for a read, False for a write
 (`X86_64Helpers.codex`, `emit-fs-read-servicer-helper`). x86-64 also
 brackets each call with its `fs-elevated` cell, which is the token its
 block-device SYSCALL checks before admitting a caller without the
 capability. This lane has no such syscall -- `block-read-sector` and
 `block-write-sector` are emitted helpers calling the driver directly --
 so there is no second gate to open and no cell to set.

  a64-cap-filesystem-read : Integer = 6
  a64-cap-filesystem-write : Integer = 7

  a64-emit-fs-servicers : A64State -> A64State
  a64-emit-fs-servicers (st) =
   if a64-find-effect-op-addr ((st.extra).effect-op-addrs) "read-text" 0 < 0 then st
   else let st1 = a64-emit-fs-read-servicer st
   in a64-emit-fs-write-servicer st1

  a64-emit-fs-read-servicer : A64State -> A64State
  a64-emit-fs-read-servicer (st) =
   let st0 = a64-record-func st "__fs-read-servicer"
   in let cc = a64-rt-check-capability [] a64-cap-filesystem-read
   in let st1 = a64-emit-block st0 cc 0 (list-length cc)
   in let deny-idx = st1.insn-count
   in let st2 = a64-emit st1 arm64-nop
   in let st3 = a64-emit st2 (arm64-sub-imm a64-sp a64-sp 16)
   in let st4 = a64-emit st3 (arm64-stp a64-fp a64-lr a64-sp 0)
   in let st4a = a64-emit-li st4 9 a64-fs-elevated-addr
   in let st4b = a64-emit st4a (arm64-movz 10 1 0)
   in let st4c = a64-emit st4b (arm64-str 10 9 0)
   in let st5 = a64-emit-call-to st4c "fat16-servicer-read"
   in let st5a = a64-emit-li st5 9 a64-fs-elevated-addr
   in let st5b = a64-emit st5a (arm64-str 31 9 0)
   in let st6 = a64-emit st5b (arm64-ldp a64-fp a64-lr a64-sp 0)
   in let st7 = a64-emit st6 (arm64-add-imm a64-sp a64-sp 16)
   in let st8 = a64-emit st7 arm64-ret
   in let deny = st8.insn-count
   in let lit = a64-emit-text-lit st8 ""
   in let st9 = a64-emit (lit.state) (arm64-mov a64-x0 (lit.reg))
   in let st10 = a64-emit st9 arm64-ret
   in a64-patch-insn st10 deny-idx (arm64-b-cond arm64-cond-eq ((deny - deny-idx) * 4))

  a64-emit-fs-write-servicer : A64State -> A64State
  a64-emit-fs-write-servicer (st) =
   let st0 = a64-record-func st "__fs-write-servicer"
   in let cc = a64-rt-check-capability [] a64-cap-filesystem-write
   in let st1 = a64-emit-block st0 cc 0 (list-length cc)
   in let deny-idx = st1.insn-count
   in let st2 = a64-emit st1 arm64-nop
   in let st3 = a64-emit st2 (arm64-sub-imm a64-sp a64-sp 16)
   in let st4 = a64-emit st3 (arm64-stp a64-fp a64-lr a64-sp 0)
   in let st4a = a64-emit-li st4 9 a64-fs-elevated-addr
   in let st4b = a64-emit st4a (arm64-movz 10 1 0)
   in let st4c = a64-emit st4b (arm64-str 10 9 0)
   in let st5 = a64-emit-call-to st4c "fat16-servicer-write"
   in let st5a = a64-emit-li st5 9 a64-fs-elevated-addr
   in let st5b = a64-emit st5a (arm64-str 31 9 0)
   in let st6 = a64-emit st5b (arm64-ldp a64-fp a64-lr a64-sp 0)
   in let st7 = a64-emit st6 (arm64-add-imm a64-sp a64-sp 16)
   in let st8 = a64-emit st7 arm64-ret
   in let deny = st8.insn-count
   in let st9 = a64-emit st8 (arm64-movz a64-x0 0 0)
   in let st10 = a64-emit st9 arm64-ret
   in a64-patch-insn st10 deny-idx (arm64-b-cond arm64-cond-eq ((deny - deny-idx) * 4))

 The install, run once at boot. A slot on this lane holds the handler's
 CODE address and `a64-emit-effect-op-call` dereferences it exactly once
 (`ldr` then `blr`); `a64-unwrap-clause-lambda` puts an `adr` of the
 handler body there, not a closure pointer, which is where this differs
 from x86-64's slot to closure to code. Writing a closure here instead
 branches to the closure and faults on its first word.

  a64-emit-seed-fs-handler : A64State, Text, Text -> A64State
  a64-emit-seed-fs-handler (st) (op-name) (stub-name) =
   let eoa = a64-find-effect-op-addr ((st.extra).effect-op-addrs) op-name 0
   in if eoa < 0 then st
   else let st1 = a64-emit-load-func-addr st 9 stub-name
   in let st2 = a64-emit-li st1 11 eoa
   in a64-emit st2 (arm64-str 9 11 0)

  a64-emit-seed-fs-handlers : A64State -> A64State
  a64-emit-seed-fs-handlers (st) =
   let st1 = a64-emit-seed-fs-handler st "read-text" "__fs-read-servicer"
   in a64-emit-seed-fs-handler st1 "write-file" "__fs-write-servicer"

  a64-emit-net-helpers : A64State -> A64State
  a64-emit-net-helpers (st) =
   let st1 = a64-record-func st "net-status"
   in let f1 = a64-rt-gated-zero a64-cap-network-read in let st2 = a64-emit-block st1 f1 0 (list-length f1)
   in let st3 = a64-record-func st2 "net-recv-raw"
   in let f3 = a64-rt-gated-zero a64-cap-network-read in let st4 = a64-emit-block st3 f3 0 (list-length f3)
   in let st5 = a64-record-func st4 "net-send-raw"
   in let f5 = a64-rt-gated-zero a64-cap-network-write in let st6 = a64-emit-block st5 f5 0 (list-length f5)
   in let st7 = a64-record-func st6 "net-get-hwaddr"
   in let f7 = a64-rt-net-get-hwaddr in a64-emit-block st7 f7 0 (list-length f7)

  a64-emit-or-into-cell : A64State, Integer, Integer -> A64State
  a64-emit-or-into-cell (st) (addr) (mask) =
   let st1 = a64-emit-li st 9 addr
   in let st2 = a64-emit st1 (arm64-ldr 10 9 0)
   in let st3 = a64-emit-li st2 11 mask
   in let st4 = a64-emit st3 (arm64-or 10 10 11)
   in a64-emit st4 (arm64-str 10 9 0)

  a64-emit-store-scope : A64State, Integer, Text -> A64State
  a64-emit-store-scope (st) (addr) (scope) =
   let saved-nt = st.next-temp
   in let lit = a64-emit-text-lit st scope
   in let st1 = a64-emit-li (lit.state) 9 addr
   in let st2 = a64-emit st1 (arm64-str (lit.reg) 9 0)
   in __record-set st2 "next-temp" saved-nt

  a64-emit-boot-grant : A64State -> A64State
  a64-emit-boot-grant (st) =
   let mask = (st.extra).boot-cap-mask
   in let cap0 = a64-proc-table-base + a64-proc-cap-offset
   in let st1 = if mask == 0 then st else a64-emit-or-into-cell st cap0 mask
   in let st2 = a64-emit-store-scope st1 (a64-proc-table-base + a64-proc-scope-offset) ((st.extra).boot-fs-scope)
   in let st3 = a64-emit-store-scope st2 (a64-proc-table-base + a64-proc-net-scope-offset) ((st.extra).boot-net-scope)
   in a64-emit-or-into-cell st3 (a64-proc-table-base + 256 + a64-proc-cap-offset) 1

  a64-emit-proc-helpers : A64State -> A64State
  a64-emit-proc-helpers (st) =
   let st1 = a64-record-func st "process-get-pid"
   in let f1 = a64-rt-process-get-pid in let st2 = a64-emit-block st1 f1 0 (list-length f1)
   in let st3 = a64-record-func st2 "process-get-cap"
   in let f3 = a64-rt-process-get-cap in let st4 = a64-emit-block st3 f3 0 (list-length f3)
   in let st5 = a64-record-func st4 "process-get-scope"
   in let f5 = a64-rt-process-get-scope-at a64-proc-scope-offset in let st6 = a64-emit-block st5 f5 0 (list-length f5)
   in let st7 = a64-record-func st6 "process-get-network-scope"
   in let f7 = a64-rt-process-get-scope-at a64-proc-net-scope-offset in let st8 = a64-emit-block st7 f7 0 (list-length f7)
   in let st9 = a64-record-func st8 "process-set-scope"
   in let f9 = a64-rt-process-set-scope-at a64-proc-scope-offset in let st10 = a64-emit-block st9 f9 0 (list-length f9)
   in let st11 = a64-record-func st10 "process-set-network-scope"
   in let f11 = a64-rt-process-set-scope-at a64-proc-net-scope-offset in let st12 = a64-emit-block st11 f11 0 (list-length f11)
   in let st13 = a64-record-func st12 "process-restrict-cap"
   in let f13 = a64-rt-process-restrict-cap in a64-emit-block st13 f13 0 (list-length f13)

Section: SVC dispatch (the synchronous vector slot)

 x86-64 reaches the block family only through `syscall` 10-13
 (`X86_64Boot.codex` `emit-syscall-handler`), so the capability check
 runs on every entry; the block builtins here are `svc #n` stubs into
 vector slot 4 (current EL, SPx, synchronous), which dispatches on the
 SVC immediate read back from ESR (EC #15 = SVC from AArch64, ISS low 16
 bits = imm16) and falls to the fault handler for any other synchronous
 exception. The gate is x86-64's `emit-block-elev-gate`: the caller's
 word holds `cap-block-device`, OR the fs-elevated cell (36232 mirrored
 at #40008D88) is non-zero, which only the FileSystem servicers set,
 inline, around their fat16 calls. No vector on this lane ever enables
 an interrupt (all sixteen slots are the fault handler), so ELR/SPSR are
 not saved across the driver call.

  a64-svc-ec : Integer = 21

 Only the three body CALLS are gated on the driver, not the dispatch around
 them (red, 2026-08-18). Short-circuiting the whole handler was tried first
 and it is the worse shape: `arm64-svc` is emitted in exactly one place today
 (`a64-emit-svc-stub`, the block stubs), so it was safe, but it made a working
 SVC conditional on the program happening to carry a block driver, and the
 next author to add an SVC on this lane would have had it swallowed by the
 fault handler with nothing to read. Gated here, the dispatch keeps working
 and a block request with no driver answers -1, which is what the capability
 refusal a few instructions above already answers.

  a64-emit-body-call : A64State, Text -> A64State
  a64-emit-body-call (st) (name) =
   if ((st.extra).has-block-driver) == False then a64-emit-li st 0 (0 - 1)
   else a64-emit-call-to st name

  a64-emit-sync-handler : A64State, Integer -> A64State
  a64-emit-sync-handler (st) (fault-idx) =
   let st1 = a64-emit st (arm64-stp-pre 29 30 31 (0 - 48))
   in let st2 = a64-emit st1 (arm64-stp 19 20 31 16)
   in let st3 = a64-emit st2 (arm64-stp 21 22 31 32)
   in let st4 = a64-emit st3 (arm64-mrs 20 sysreg-currentel)
   in let st5 = a64-emit st4 (arm64-lsr-imm 20 20 2)
   in let st6 = a64-emit st5 (arm64-movz 21 3 0)
   in let st7 = a64-emit st6 (arm64-and 20 20 21)
   in let esr = a64-rt-fault-mrs-el [] 11 sysreg-esr-el1
   in let st8 = a64-emit-block st7 esr 0 (list-length esr)
   in let st9 = a64-emit st8 (arm64-lsr-imm 12 11 26)
   in let st10 = a64-emit st9 (arm64-cmp-imm 12 a64-svc-ec)
   in let not-svc-idx = st10.insn-count
   in let st11 = a64-emit st10 arm64-nop
   in let st12 = a64-emit st11 (arm64-movz 13 65535 0)
   in let st13 = a64-emit st12 (arm64-and 12 11 13)
   in let cc = a64-rt-check-capability [] a64-cap-block-device
   in let st14 = a64-emit-block st13 cc 0 (list-length cc)
   in let has-cap-idx = st14.insn-count
   in let st15 = a64-emit st14 arm64-nop
   in let st16 = a64-emit-li st15 10 a64-fs-elevated-addr
   in let st17 = a64-emit st16 (arm64-ldr 10 10 0)
   in let elev-idx = st17.insn-count
   in let st18 = a64-emit st17 arm64-nop
   in let deny = st18.insn-count
   in let st19 = a64-emit-li st18 0 (0 - 1)
   in let deny-done-idx = st19.insn-count
   in let st20 = a64-emit st19 arm64-nop
   in let proceed = st20.insn-count
   in let st21 = a64-emit st20 (arm64-cmp-imm 12 a64-svc-block-read)
   in let is-read-idx = st21.insn-count
   in let st22 = a64-emit st21 arm64-nop
   in let st23 = a64-emit st22 (arm64-cmp-imm 12 a64-svc-block-write)
   in let is-write-idx = st23.insn-count
   in let st24 = a64-emit st23 arm64-nop
   in let st25 = a64-emit st24 (arm64-cmp-imm 12 a64-svc-block-count)
   in let is-count-idx = st25.insn-count
   in let st26 = a64-emit st25 arm64-nop
   in let st27 = a64-emit st26 (arm64-b ((deny - st26.insn-count) * 4))
   in let do-read = st27.insn-count
   in let st28 = a64-emit-body-call st27 "__block_read_body"
   in let read-done-idx = st28.insn-count
   in let st29 = a64-emit st28 arm64-nop
   in let do-write = st29.insn-count
   in let st30 = a64-emit-body-call st29 "__block_write_body"
   in let write-done-idx = st30.insn-count
   in let st31 = a64-emit st30 arm64-nop
   in let do-count = st31.insn-count
   in let st32 = a64-emit-body-call st31 "__block_count_body"
   in let done = st32.insn-count
   in let st33 = a64-emit st32 (arm64-ldp 21 22 31 32)
   in let st34 = a64-emit st33 (arm64-ldp 19 20 31 16)
   in let st35 = a64-emit st34 (arm64-ldp-post 29 30 31 48)
   in let st36 = a64-emit st35 arm64-eret
   in let not-svc = st36.insn-count
   in let st37 = a64-emit st36 (arm64-ldp 21 22 31 32)
   in let st38 = a64-emit st37 (arm64-ldp 19 20 31 16)
   in let st39 = a64-emit st38 (arm64-ldp-post 29 30 31 48)
   in let st40 = a64-emit st39 (arm64-b ((fault-idx - st39.insn-count) * 4))
   in let st41 = a64-patch-insn st40 not-svc-idx (arm64-b-cond 1 ((not-svc - not-svc-idx) * 4))
   in let st42 = a64-patch-insn st41 has-cap-idx (arm64-b-cond 1 ((proceed - has-cap-idx) * 4))
   in let st43 = a64-patch-insn st42 elev-idx (arm64-cbnz 10 ((proceed - elev-idx) * 4))
   in let st44 = a64-patch-insn st43 deny-done-idx (arm64-b ((done - deny-done-idx) * 4))
   in let st45 = a64-patch-insn st44 is-read-idx (arm64-b-cond arm64-cond-eq ((do-read - is-read-idx) * 4))
   in let st46 = a64-patch-insn st45 is-write-idx (arm64-b-cond arm64-cond-eq ((do-write - is-write-idx) * 4))
   in let st47 = a64-patch-insn st46 is-count-idx (arm64-b-cond arm64-cond-eq ((do-count - is-count-idx) * 4))
   in let st48 = a64-patch-insn st47 read-done-idx (arm64-b ((done - read-done-idx) * 4))
   in a64-patch-insn st48 write-done-idx (arm64-b ((done - write-done-idx) * 4))

Section: Process Lifecycle

 The cooperative half of x86-64's model (X86_64ProcessHelpers.codex): the
 parent never switches to a child it spawns; a switch happens only at
 process-wait, process-yield or an exit, and there is no timer here to add
 the preemptive half. Saved context is the callee-saved set at a call
 boundary and nothing else: sp at 72, x28 (the heap pointer) at 80, x19..x24
 at 88..128, the resume address at 160, the delivered status (x0 on resume)
 at 176, x25..x27 and x29 at 184..208. A child's region is
 pool + (slot << 25): heap from its base, stack top 2 MiB above it, the
 carve `__spawn_pool_carve` makes for a plain spawn. A closure is called the
 way a64-emit-closure-call calls it: pointer in x11, code word at [x11],
 argument in x0.

  a64-proc-state-ready : Integer = 1
  a64-proc-state-blocked : Integer = 3
  a64-proc-cap-process-create-bit : Integer = 12
  a64-proc-saved-sp-offset : Integer = 72
  a64-proc-saved-heap-offset : Integer = 80
  a64-proc-closure-offset : Integer = 136
  a64-proc-resume-offset : Integer = 160
  a64-proc-saved-x0-offset : Integer = 176
  a64-proc-exit-status-offset : Integer = 32
  a64-proc-blocked-on-offset : Integer = 248
  a64-spawn-plain-region-bytes : Integer = #200000

  a64-emit-slot-entry : A64State, Integer, Integer, Integer -> A64State
  a64-emit-slot-entry (st) (slot-reg) (dst) (scratch) =
   let st1 = a64-emit st (arm64-lsl-imm dst slot-reg a64-proc-entry-shift)
   in let st2 = a64-emit-li st1 scratch a64-proc-table-base
   in a64-emit st2 (arm64-add dst dst scratch)

  a64-emit-current-entry : A64State, Integer -> A64State
  a64-emit-current-entry (st) (dst) =
   let cs = a64-rt-current-slot-in-x9 []
   in let st1 = a64-emit-block st cs 0 (list-length cs)
   in a64-emit-slot-entry st1 9 dst 16

  a64-emit-save-context : A64State, Integer -> A64State
  a64-emit-save-context (st) (entry) =
   let st1 = a64-emit st (arm64-mov 9 31)
   in let st2 = a64-emit st1 (arm64-str 9 entry a64-proc-saved-sp-offset)
   in let st3 = a64-emit st2 (arm64-str 28 entry a64-proc-saved-heap-offset)
   in let st4 = a64-emit st3 (arm64-str 19 entry 88)
   in let st5 = a64-emit st4 (arm64-str 20 entry 96)
   in let st6 = a64-emit st5 (arm64-str 21 entry 104)
   in let st7 = a64-emit st6 (arm64-str 22 entry 112)
   in let st8 = a64-emit st7 (arm64-str 23 entry 120)
   in let st9 = a64-emit st8 (arm64-str 24 entry 128)
   in let st10 = a64-emit st9 (arm64-str 30 entry a64-proc-resume-offset)
   in let st11 = a64-emit st10 (arm64-str 25 entry 184)
   in let st12 = a64-emit st11 (arm64-str 26 entry 192)
   in let st13 = a64-emit st12 (arm64-str 27 entry 200)
   in let st14 = a64-emit st13 (arm64-str 29 entry 208)
   in let st15 = a64-emit st14 (arm64-movz 9 0 0)
   in a64-emit st15 (arm64-str 9 entry a64-proc-saved-x0-offset)

  a64-emit-process-resume : A64State -> A64State
  a64-emit-process-resume (st) =
   let st0 = a64-record-func st "__process_resume"
   in let st1 = a64-emit st0 (arm64-ldr 19 11 88)
   in let st2 = a64-emit st1 (arm64-ldr 20 11 96)
   in let st3 = a64-emit st2 (arm64-ldr 21 11 104)
   in let st4 = a64-emit st3 (arm64-ldr 22 11 112)
   in let st5 = a64-emit st4 (arm64-ldr 23 11 120)
   in let st6 = a64-emit st5 (arm64-ldr 24 11 128)
   in let st7 = a64-emit st6 (arm64-ldr 25 11 184)
   in let st8 = a64-emit st7 (arm64-ldr 26 11 192)
   in let st9 = a64-emit st8 (arm64-ldr 27 11 200)
   in let st10 = a64-emit st9 (arm64-ldr 29 11 208)
   in let st11 = a64-emit st10 (arm64-ldr 28 11 a64-proc-saved-heap-offset)
   in let st12 = a64-emit st11 (arm64-ldr 30 11 a64-proc-resume-offset)
   in let st13 = a64-emit st12 (arm64-ldr 0 11 a64-proc-saved-x0-offset)
   in let st14 = a64-emit st13 (arm64-ldr 9 11 a64-proc-saved-sp-offset)
   in let st15 = a64-emit st14 (arm64-mov 31 9)
   in a64-emit st15 arm64-ret

  a64-emit-idle-dispatch : A64State -> A64State
  a64-emit-idle-dispatch (st) =
   let st0 = a64-record-func st "__idle_dispatch"
   in let scan-top = st0.insn-count
   in let st1 = a64-emit st0 (arm64-movz 10 0 0)
   in let loop = st1.insn-count
   in let st2 = a64-emit-slot-entry st1 10 11 12
   in let st3 = a64-emit st2 (arm64-ldr 12 11 0)
   in let st4 = a64-emit st3 (arm64-cmp-imm 12 a64-proc-state-ready)
   in let found-idx = st4.insn-count
   in let st5 = a64-emit st4 arm64-nop
   in let st6 = a64-emit st5 (arm64-add-imm 10 10 1)
   in let st7 = a64-emit st6 (arm64-cmp-imm 10 16)
   in let st8 = a64-emit st7 (arm64-b-cond arm64-cond-lt ((loop - st7.insn-count) * 4))
   in let st9 = a64-emit st8 a64-rt-wfi
   in let st10 = a64-emit st9 (arm64-b ((scan-top - st9.insn-count) * 4))
   in let found = st10.insn-count
   in let st11 = a64-emit st10 (arm64-movz 12 a64-proc-state-running 0)
   in let st12 = a64-emit st11 (arm64-str 12 11 0)
   in let st13 = a64-emit-call-to st12 "__process_resume"
   in a64-patch-insn st13 found-idx (arm64-b-cond arm64-cond-eq ((found - found-idx) * 4))

  a64-emit-proc-entry : A64State -> A64State
  a64-emit-proc-entry (st) =
   let st0 = a64-record-func st "__proc_entry"
   in let st1 = a64-emit-current-entry st0 13
   in let st2 = a64-emit st1 (arm64-ldr 11 13 a64-proc-closure-offset)
   in let st3 = a64-emit st2 (arm64-movz 0 0 0)
   in let st4 = a64-emit st3 (arm64-ldr 9 11 0)
   in let st5 = a64-emit st4 (arm64-blr 9)
   in let st6 = a64-emit-current-entry st5 13
   in let st7 = a64-emit st6 (arm64-str 0 13 a64-proc-exit-status-offset)
   in a64-emit-call-to st7 "process-exit-self"

  a64-emit-process-exit-self : A64State -> A64State
  a64-emit-process-exit-self (st) =
   let st0 = a64-record-func st "process-exit-self"
   in let st1 = a64-emit-current-entry st0 13
   in let st2 = a64-emit st1 (arm64-mov 12 9)
   in let st3 = a64-emit st2 (arm64-movz 14 0 0)
   in let st4 = a64-emit st3 (arm64-str 14 13 0)
   in let st5 = a64-emit st4 (arm64-ldr 15 13 a64-proc-exit-status-offset)
   in let st6 = a64-emit st5 (arm64-movz 10 0 0)
   in let loop = st6.insn-count
   in let st7 = a64-emit-slot-entry st6 10 11 14
   in let st8 = a64-emit st7 (arm64-ldr 14 11 0)
   in let st9 = a64-emit st8 (arm64-cmp-imm 14 a64-proc-state-blocked)
   in let skip1 = st9.insn-count
   in let st10 = a64-emit st9 arm64-nop
   in let st11 = a64-emit st10 (arm64-ldr 14 11 a64-proc-blocked-on-offset)
   in let st12 = a64-emit st11 (arm64-cmp 14 12)
   in let skip2 = st12.insn-count
   in let st13 = a64-emit st12 arm64-nop
   in let st14 = a64-emit st13 (arm64-str 15 11 a64-proc-saved-x0-offset)
   in let st15 = a64-emit st14 (arm64-movz 14 a64-proc-state-ready 0)
   in let st16 = a64-emit st15 (arm64-str 14 11 0)
   in let next = st16.insn-count
   in let st17 = a64-emit st16 (arm64-add-imm 10 10 1)
   in let st18 = a64-emit st17 (arm64-cmp-imm 10 16)
   in let st19 = a64-emit st18 (arm64-b-cond arm64-cond-lt ((loop - st18.insn-count) * 4))
   in let st20 = a64-emit-call-to st19 "__idle_dispatch"
   in let st21 = a64-patch-insn st20 skip1 (arm64-b-cond arm64-cond-ne ((next - skip1) * 4))
   in a64-patch-insn st21 skip2 (arm64-b-cond arm64-cond-ne ((next - skip2) * 4))

  a64-emit-process-exit : A64State -> A64State
  a64-emit-process-exit (st) =
   let st0 = a64-record-func st "process-exit"
   in let st1 = a64-emit st0 (arm64-mov 12 0)
   in let st2 = a64-emit-current-entry st1 13
   in let st3 = a64-emit st2 (arm64-str 12 13 a64-proc-exit-status-offset)
   in a64-emit-call-to st3 "process-exit-self"

  a64-emit-process-wait : A64State -> A64State
  a64-emit-process-wait (st) =
   let st0 = a64-record-func st "process-wait"
   in let st1 = a64-emit st0 (arm64-mov 12 0)
   in let st2 = a64-emit st1 (arm64-cmp-imm 12 16)
   in let range-idx = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in let st4 = a64-emit-slot-entry st3 12 13 9
   in let st5 = a64-emit st4 (arm64-ldr 14 13 0)
   in let dead1-idx = st5.insn-count
   in let st6 = a64-emit st5 arm64-nop
   in let st7 = a64-emit-current-entry st6 11
   in let st8 = a64-emit-save-context st7 11
   in let st9 = a64-emit st8 (arm64-str 12 11 a64-proc-blocked-on-offset)
   in let st10 = a64-emit st9 (arm64-movz 14 a64-proc-state-blocked 0)
   in let st11 = a64-emit st10 (arm64-str 14 11 0)
   in let st12 = a64-emit st11 (arm64-ldr 14 13 0)
   in let rescue-idx = st12.insn-count
   in let st13 = a64-emit st12 arm64-nop
   in let st14 = a64-emit-call-to st13 "__idle_dispatch"
   in let rescue = st14.insn-count
   in let st15 = a64-emit st14 (arm64-movz 14 a64-proc-state-running 0)
   in let st16 = a64-emit st15 (arm64-str 14 11 0)
   in let dead = st16.insn-count
   in let st17 = a64-emit st16 (arm64-ldr 0 13 a64-proc-exit-status-offset)
   in let st18 = a64-emit st17 arm64-ret
   in let fail = st18.insn-count
   in let st19 = a64-emit-li st18 0 (0 - 1)
   in let st20 = a64-emit st19 arm64-ret
   in let st21 = a64-patch-insn st20 range-idx (arm64-b-cond arm64-cond-ge ((fail - range-idx) * 4))
   in let st22 = a64-patch-insn st21 dead1-idx (arm64-cbz 14 ((dead - dead1-idx) * 4))
   in a64-patch-insn st22 rescue-idx (arm64-cbz 14 ((rescue - rescue-idx) * 4))

  a64-emit-process-yield : A64State -> A64State
  a64-emit-process-yield (st) =
   let st0 = a64-record-func st "process-yield"
   in let st1 = a64-emit-current-entry st0 11
   in let st2 = a64-emit st1 (arm64-mov 12 9)
   in let st3 = a64-emit st2 (arm64-mov 10 9)
   in let loop = st3.insn-count
   in let st4 = a64-emit st3 (arm64-add-imm 10 10 1)
   in let st5 = a64-emit st4 (arm64-cmp-imm 10 16)
   in let wrap-idx = st5.insn-count
   in let st6 = a64-emit st5 arm64-nop
   in let cont = st6.insn-count
   in let st7 = a64-emit st6 (arm64-cmp 10 12)
   in let none-idx = st7.insn-count
   in let st8 = a64-emit st7 arm64-nop
   in let st9 = a64-emit-slot-entry st8 10 13 14
   in let st10 = a64-emit st9 (arm64-ldr 14 13 0)
   in let st11 = a64-emit st10 (arm64-cmp-imm 14 a64-proc-state-ready)
   in let st12 = a64-emit st11 (arm64-b-cond arm64-cond-ne ((loop - st11.insn-count) * 4))
   in let st13 = a64-emit-save-context st12 11
   in let st14 = a64-emit st13 (arm64-movz 14 a64-proc-state-ready 0)
   in let st15 = a64-emit st14 (arm64-str 14 11 0)
   in let st16 = a64-emit st15 (arm64-movz 14 a64-proc-state-running 0)
   in let st17 = a64-emit st16 (arm64-str 14 13 0)
   in let st18 = a64-emit st17 (arm64-mov 11 13)
   in let st19 = a64-emit-call-to st18 "__process_resume"
   in let wrap = st19.insn-count
   in let st20 = a64-emit st19 (arm64-movz 10 0 0)
   in let st21 = a64-emit st20 (arm64-b ((cont - st20.insn-count) * 4))
   in let none = st21.insn-count
   in let st22 = a64-emit st21 (arm64-movz 0 0 0)
   in let st23 = a64-emit st22 arm64-ret
   in let st24 = a64-patch-insn st23 wrap-idx (arm64-b-cond arm64-cond-ge ((wrap - wrap-idx) * 4))
   in a64-patch-insn st24 none-idx (arm64-b-cond arm64-cond-eq ((none - none-idx) * 4))

  a64-spawn-heap-stack-bytes : Integer = #100000
  a64-spawn-slot-region-bytes : Integer = #2000000

  a64-emit-region-bytes-in-x15 : A64State, Boolean -> A64EmitResult
  a64-emit-region-bytes-in-x15 (st) (with-heap) =
   if with-heap then
    let st1 = a64-emit-li st 15 a64-spawn-heap-stack-bytes
    in let st2 = a64-emit st1 (arm64-add 15 1 15)
    in let st3 = a64-emit-li st2 9 a64-spawn-slot-region-bytes
    in let st4 = a64-emit st3 (arm64-cmp 15 9)
    in let size-idx = st4.insn-count
    in A64EmitResult { state = a64-emit st4 arm64-nop, reg = size-idx }
   else A64EmitResult { state = a64-emit-li st 15 a64-spawn-plain-region-bytes, reg = 0 - 1 }

  a64-emit-process-spawn : A64State -> A64State
  a64-emit-process-spawn (st) =
   let st1 = a64-emit-process-spawn-named st "process-spawn" False
   in a64-emit-process-spawn-named st1 "process-spawn-with-heap" True

  a64-emit-process-spawn-named : A64State, Text, Boolean -> A64State
  a64-emit-process-spawn-named (st) (name) (with-heap) =
   let st0 = a64-record-func st name
   in let st1 = a64-emit st0 (arm64-mov 11 0)
   in let cc = a64-rt-check-capability [] a64-proc-cap-process-create-bit
   in let st2 = a64-emit-block st1 cc 0 (list-length cc)
   in let deny-idx = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in let st4 = a64-emit st3 (arm64-movz 12 1 0)
   in let loop = st4.insn-count
   in let st5 = a64-emit st4 (arm64-cmp-imm 12 16)
   in let full-idx = st5.insn-count
   in let st6 = a64-emit st5 arm64-nop
   in let st7 = a64-emit-slot-entry st6 12 13 14
   in let st8 = a64-emit st7 (arm64-ldr 14 13 0)
   in let found-idx = st8.insn-count
   in let st9 = a64-emit st8 arm64-nop
   in let st10 = a64-emit st9 (arm64-add-imm 12 12 1)
   in let st11 = a64-emit st10 (arm64-b ((loop - st10.insn-count) * 4))
   in let found = st11.insn-count
   in let st12 = a64-emit st11 (arm64-lsl-imm 14 12 a64-spawn-slot-region-shift)
   in let st13 = a64-emit-li st12 15 a64-spawn-pool-base
   in let st14 = a64-emit st13 (arm64-add 14 14 15)
   in let st15 = a64-emit st14 (arm64-str 14 13 a64-proc-saved-heap-offset)
   in let rb = a64-emit-region-bytes-in-x15 st15 with-heap
   in let size-idx = rb.reg
   in let st17 = a64-emit (rb.state) (arm64-add 15 14 15)
   in let st18 = a64-emit st17 (arm64-str 15 13 a64-proc-saved-sp-offset)
   in let st19 = a64-emit st18 (arm64-str 11 13 a64-proc-closure-offset)
   in let st20 = a64-emit-load-func-addr st19 15 "__proc_entry"
   in let st21 = a64-emit st20 (arm64-str 15 13 a64-proc-resume-offset)
   in let st22 = a64-emit-current-entry st21 10
   in let st23 = a64-emit-copy-cell st22 10 13 a64-proc-cap-offset
   in let st24 = a64-emit-copy-cell st23 10 13 a64-proc-scope-offset
   in let st25 = a64-emit-copy-cell st24 10 13 a64-proc-net-scope-offset
   in let st26 = a64-emit st25 (arm64-movz 14 0 0)
   in let st27 = a64-emit-zero-cells st26 13 14 [32, 88, 96, 104, 112, 120, 128, 176, 184, 192, 200, 208, 248] 0
   in let st28 = a64-emit st27 (arm64-movz 14 a64-proc-state-ready 0)
   in let st29 = a64-emit st28 (arm64-str 14 13 0)
   in let st30 = a64-emit st29 (arm64-mov 0 12)
   in let st31 = a64-emit st30 arm64-ret
   in let fail = st31.insn-count
   in let st32 = a64-emit-li st31 0 (0 - 1)
   in let st33 = a64-emit st32 arm64-ret
   in let st33s = if size-idx < 0 then st33 else a64-patch-insn st33 size-idx (arm64-b-cond 8 ((fail - size-idx) * 4))
   in let st34 = a64-patch-insn st33s deny-idx (arm64-b-cond arm64-cond-eq ((fail - deny-idx) * 4))
   in let st35 = a64-patch-insn st34 full-idx (arm64-b-cond arm64-cond-ge ((fail - full-idx) * 4))
   in a64-patch-insn st35 found-idx (arm64-cbz 14 ((found - found-idx) * 4))

  a64-emit-copy-cell : A64State, Integer, Integer, Integer -> A64State
  a64-emit-copy-cell (st) (src) (dst) (offset) =
   let st1 = a64-emit st (arm64-ldr 9 src offset)
   in a64-emit st1 (arm64-str 9 dst offset)

  a64-emit-zero-cells : A64State, Integer, Integer, List Integer, Integer -> A64State
  a64-emit-zero-cells (st) (entry) (zero-reg) (offsets) (i) =
   if i >= list-length offsets then st
   else a64-emit-zero-cells (a64-emit st (arm64-str zero-reg entry (list-at offsets i))) entry zero-reg offsets (i + 1)

  a64-emit-lifecycle-helpers : A64State -> A64State
  a64-emit-lifecycle-helpers (st) =
   let st1 = a64-emit-process-resume st
   in let st2 = a64-emit-idle-dispatch st1
   in let st3 = a64-emit-proc-entry st2
   in let st4 = a64-emit-process-exit-self st3
   in let st5 = a64-emit-process-exit st4
   in let st6 = a64-emit-process-wait st5
   in let st7 = a64-emit-process-yield st6
   in a64-emit-process-spawn st7

Section: Emit All Runtime Helpers

  a64-emit-runtime : A64State -> A64State
  a64-emit-runtime (st) =
   let vt = a64-rt-vector-table
   in let st0 = a64-emit-block st vt 0 (list-length vt)
   in let st1 = a64-record-func st0 "__start"
   in let cbnz-idx = st1.insn-count
   in let st1z = a64-emit st1 arm64-nop
   in let st1a = a64-emit st1z a64-rt-adr-x9-minus-0x800
   in let wv = a64-rt-write-vbar-current-el
   in let st1b = a64-emit-block st1a wv 0 (list-length wv)
   in let st1b1 = a64-emit-li st1b 9 #300000
   in let st1b2 = a64-emit st1b1 (arm64-msr a64-rt-cpacr-el1 9)
   in let st1b3 = a64-emit-block st1b2 arm64-isb 0 4
   in let st1c = a64-emit-li st1b3 10 a64-rt-pl011-base
   in let st1c0 = a64-emit-li st1c 11 0
   in let st1c1 = a64-emit st1c0 (arm64-str-w 11 10 48)
   in let st1d = a64-emit-li st1c1 11 96
   in let st1e0 = a64-emit st1d (arm64-str-w 11 10 44)
   in let st1e1 = a64-emit-li st1e0 11 769
   in let st1e = a64-emit st1e1 (arm64-str-w 11 10 48)
   in let st2 = a64-emit-li st1e 9 #80000000
   in let st3 = a64-emit st2 (arm64-mov 31 9)
   in let st3x = a64-emit-li st3 28 a64-heap-start
   in let uefi-label = st3x.insn-count
   in let st3a = a64-emit-li st3x 10 a64-ascii-to-cce-table-addr
   in let a2c-table = a64-build-ascii-to-cce [] 0
   in let st3b = a64-write-table-loop st3a 10 a2c-table 0
   in let st3c = a64-emit-li st3b 10 a64-cce-to-unicode-table-addr
   in let c2u-table = a64-build-cce-to-unicode [] 0
   in let st3d0 = a64-write-table-loop st3c 10 c2u-table 0
   in let st3d1 = a64-emit-proc-table-init st3d0
   in let st3d = a64-emit-boot-grant st3d1
   in let st3e = a64-patch-insn st3d cbnz-idx (arm64-cbnz 28 ((uefi-label - cbnz-idx) * 4))
   in let st3f = a64-emit-seed-fs-handlers st3e
   in let st7f = if (st.extra).smp-boot then a64-emit-smp-boot st3f else a64-emit-uni-boot st3f
   in let st8 = a64-record-func st7f "print-line-uni"
   in let st8a = a64-record-func st8 "print-line"
   in let plu = a64-rt-print-line-uni
   in let st9 = a64-emit-block st8a plu 0 (list-length plu)
   in let st10 = a64-record-func st9 "__str_eq"
   in let seq = a64-rt-str-eq
   in let st11 = a64-emit-block st10 seq 0 (list-length seq)
   in let st11a = a64-record-func st11 "__int_pow"
   in let ipw = a64-rt-int-pow
   in let st11b = a64-emit-block st11a ipw 0 (list-length ipw)
   in let st12 = a64-record-func st11b "__str_concat"
   in let scc = a64-rt-str-concat
   in let st13 = a64-emit-block st12 scc 0 (list-length scc)
   in let st14 = a64-record-func st13 "__itoa"
   in let ita = a64-rt-itoa
   in let st15 = a64-emit-block st14 ita 0 (list-length ita)
   in let st15a = a64-record-func st15 "__real_to_text"
   in let rtt = a64-rt-real-to-text
   in let st15b = a64-emit-block st15a rtt 0 (list-length rtt)
   in let st16 = a64-record-func st15b "list-cons"
   in let f16 = a64-rt-list-cons in let st17 = a64-emit-block st16 f16 0 (list-length f16)
   in let st18 = a64-record-func st17 "list-append"
   in let f18 = a64-rt-list-append in let st19 = a64-emit-block st18 f18 0 (list-length f18)
   in let st20 = a64-record-func st19 "list-push"
   in let f20 = a64-rt-list-push in let st21 = a64-emit-block st20 f20 0 (list-length f20)
   in let st22 = a64-record-func st21 "list-empty"
   in let f22 = a64-rt-list-empty in let st23 = a64-emit-block st22 f22 0 (list-length f22)
   in let st24 = a64-record-func st23 "integer-to-text"
   in let f24 = a64-rt-itoa in let st25 = a64-emit-block st24 f24 0 (list-length f24)
   in let st26 = a64-record-func st25 "text-length"
   in let f26 = a64-rt-text-length in let st27 = a64-emit-block st26 f26 0 (list-length f26)
   in let st28 = a64-record-func st27 "list-length"
   in let f28 = a64-rt-text-length in let st29 = a64-emit-block st28 f28 0 (list-length f28)
   in let st30 = a64-record-func st29 "list-at"
   in let f30 = a64-rt-list-at in let st31 = a64-emit-block st30 f30 0 (list-length f30)
   in let st32 = a64-record-func st31 "char-at"
   in let f32 = a64-rt-char-at in let st33 = a64-emit-block st32 f32 0 (list-length f32)
   in let st34 = a64-record-func st33 "char-code"
   in let st35 = a64-emit st34 arm64-ret
   in let st36 = a64-record-func st35 "code-to-char"
   in let st37 = a64-emit st36 arm64-ret
   in let st38 = a64-record-func st37 "char-to-text"
   in let f38 = a64-rt-char-to-text in let st39 = a64-emit-block st38 f38 0 (list-length f38)
   in let st40 = a64-record-func st39 "show"
   in let f40 = a64-rt-itoa in let st41 = a64-emit-block st40 f40 0 (list-length f40)
   in let st42 = a64-record-func st41 "int-mod"
   in let f42 = a64-rt-int-mod in let st43 = a64-emit-block st42 f42 0 (list-length f42)
   in let st44 = a64-record-func st43 "bit-and"
   in let f44 = arm64-and 0 0 1 & arm64-ret in let st45 = a64-emit-block st44 f44 0 (list-length f44)
   in let st46 = a64-record-func st45 "bit-or"
   in let f46 = arm64-or 0 0 1 & arm64-ret in let st47 = a64-emit-block st46 f46 0 (list-length f46)
   in let st48 = a64-record-func st47 "bit-xor"
   in let f48 = arm64-xor 0 0 1 & arm64-ret in let st49 = a64-emit-block st48 f48 0 (list-length f48)
   in let st50 = a64-record-func st49 "bit-shl"
   in let f50 = arm64-lsl 0 0 1 & arm64-ret in let st51 = a64-emit-block st50 f50 0 (list-length f50)
   in let st52 = a64-record-func st51 "bit-shru"
   in let f52 = arm64-lsr 0 0 1 & arm64-ret in let st53 = a64-emit-block st52 f52 0 (list-length f52)
   in let st54 = a64-record-func st53 "peek-byte"
   in let st54m = a64-record-func st54 "read-mmio"
   in let f54 = a64-rt-peek-byte in let st55 = a64-emit-block st54m f54 0 (list-length f54)
   in let st56 = a64-record-func st55 "poke-byte"
   in let st56m = a64-record-func st56 "poke-mmio"
   in let f56 = a64-rt-poke-byte in let st57 = a64-emit-block st56m f56 0 (list-length f56)
   in let st57a = a64-record-func st57 "peek-16"
   in let f57a = a64-rt-peek-16 in let st57b = a64-emit-block st57a f57a 0 (list-length f57a)
   in let st57c = a64-record-func st57b "poke-16"
   in let f57c = a64-rt-poke-16 in let st57d = a64-emit-block st57c f57c 0 (list-length f57c)
   in let st58 = a64-record-func st57d "peek-32"
   in let st58m = a64-record-func st58 "read-mmio-32"
   in let f58 = a64-rt-peek-32 in let st59 = a64-emit-block st58m f58 0 (list-length f58)
   in let st60 = a64-record-func st59 "poke-32"
   in let st60m = a64-record-func st60 "poke-mmio-32"
   in let f60 = a64-rt-poke-32 in let st61 = a64-emit-block st60m f60 0 (list-length f60)
   in let st62 = a64-record-func st61 "peek-qword"
   in let f62 = a64-rt-peek-qword in let st63 = a64-emit-block st62 f62 0 (list-length f62)
   in let st64 = a64-record-func st63 "poke-qword"
   in let f64 = a64-rt-poke-qword in let st65 = a64-emit-block st64 f64 0 (list-length f64)
   in let st65a = a64-record-func st65 "tag-equal"
   in let f65a = a64-rt-tag-equal in let st65b = a64-emit-block st65a f65a 0 (list-length f65a)
   in let st66 = a64-record-func st65b "__buf-write-byte"
   in let f66 = a64-rt-buf-write-byte in let st67 = a64-emit-block st66 f66 0 (list-length f66)
   in let st68 = a64-record-func st67 "__buf-read-bytes"
   in let f68 = a64-rt-buf-read-bytes in let st69 = a64-emit-block st68 f68 0 (list-length f68)
   in let st70 = a64-record-func st69 "__buf-write-bytes"
   in let f70 = a64-rt-buf-write-bytes in let st71 = a64-emit-block st70 f70 0 (list-length f70)
   in let st72 = a64-record-func st71 "__heap-save"
   in let f72 = a64-rt-heap-save in let st73 = a64-emit-block st72 f72 0 (list-length f72)
   in let st74 = a64-record-func st73 "__heap-restore"
   in let f74 = a64-rt-heap-restore in let st75 = a64-emit-block st74 f74 0 (list-length f74)
   in let st76 = a64-record-func st75 "__heap-advance"
   in let f76 = a64-rt-heap-advance in let st77 = a64-emit-block st76 f76 0 (list-length f76)
   in let st78 = a64-record-func st77 "alloc-bytes"
   in let f78 = a64-rt-alloc-bytes in let st79 = a64-emit-block st78 f78 0 (list-length f78)
   in let st80 = a64-record-func st79 "memset"
   in let f80 = a64-rt-memset in let st81 = a64-emit-block st80 f80 0 (list-length f80)
   in let st82 = a64-record-func st81 "dsb"
   in let f82 = a64-rt-dsb in let st83 = a64-emit-block st82 f82 0 (list-length f82)
   in let st84 = a64-record-func st83 "dmb"
   in let f84 = a64-rt-dmb in let st85 = a64-emit-block st84 f84 0 (list-length f84)
   in let st86 = a64-record-func st85 "isb"
   in let f86 = a64-rt-isb in let st87 = a64-emit-block st86 f86 0 (list-length f86)
   in let st88 = a64-record-func st87 "read-sctlr-el1"
   in let f88 = a64-rt-read-sctlr-el1 in let st89 = a64-emit-block st88 f88 0 (list-length f88)
   in let st90 = a64-record-func st89 "write-sctlr-el1"
   in let f90 = a64-rt-write-sctlr-el1 in let st91 = a64-emit-block st90 f90 0 (list-length f90)
   in let st92 = a64-record-func st91 "write-ttbr0-el1"
   in let f92 = a64-rt-write-ttbr0-el1 in let st93 = a64-emit-block st92 f92 0 (list-length f92)
   in let st94 = a64-record-func st93 "write-tcr-el1"
   in let f94 = a64-rt-write-tcr-el1 in let st95 = a64-emit-block st94 f94 0 (list-length f94)
   in let st96 = a64-record-func st95 "write-mair-el1"
   in let f96 = a64-rt-write-mair-el1 in let st97 = a64-emit-block st96 f96 0 (list-length f96)
   in let st98 = a64-record-func st97 "write-vbar-el1"
   in let f98 = a64-rt-write-vbar-el1 in let st99 = a64-emit-block st98 f98 0 (list-length f98)
   in let st100 = a64-record-func st99 "read-cntfrq-el0"
   in let f100 = a64-rt-read-cntfrq-el0 in let st101 = a64-emit-block st100 f100 0 (list-length f100)
   in let st102 = a64-record-func st101 "write-cntp-tval-el0"
   in let f102 = a64-rt-write-cntp-tval-el0 in let st103 = a64-emit-block st102 f102 0 (list-length f102)
   in let st104 = a64-record-func st103 "write-cntp-ctl-el0"
   in let f104 = a64-rt-write-cntp-ctl-el0 in let st105 = a64-emit-block st104 f104 0 (list-length f104)
   in let st106 = a64-record-func st105 "write-icc-pmr-el1"
   in let f106 = a64-rt-write-icc-pmr-el1 in let st107 = a64-emit-block st106 f106 0 (list-length f106)
   in let st108 = a64-record-func st107 "write-icc-igrpen1-el1"
   in let f108 = a64-rt-write-icc-igrpen1-el1 in let st109 = a64-emit-block st108 f108 0 (list-length f108)
   in let st110 = a64-record-func st109 "read-icc-iar1-el1"
   in let f110 = a64-rt-read-icc-iar1-el1 in let st111 = a64-emit-block st110 f110 0 (list-length f110)
   in let st112 = a64-record-func st111 "write-icc-eoir1-el1"
   in let f112 = a64-rt-write-icc-eoir1-el1 in let st113 = a64-emit-block st112 f112 0 (list-length f112)
   in let st114 = a64-record-func st113 "read-currentel"
   in let f114 = a64-rt-read-currentel in let st115 = a64-emit-block st114 f114 0 (list-length f114)
   in let st116 = a64-record-func st115 "read-daif"
