   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp-post 29 30 31 96)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i outer-exit (arm64-b-cond 10 ((outer-done - outer-exit) * 4))
   in let i = a64-patch-insn-raw i empty-sep (arm64-cbz 22 ((mismatch-label - empty-sep) * 4))
   in let i = a64-patch-insn-raw i overhang (arm64-b-cond 12 ((mismatch-label - overhang) * 4))
