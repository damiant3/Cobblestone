Chapter: Arm64 Runtime
  cites Foreword chapter Arm64Encoder

 Runtime helper functions emitted at the start of ARM64 codegen.
 Each returns the bytes of an ARM64 function body. The codegen
 records the function offset and appends the bytes.

 IMPORTANT: register 31 means SP in arm64-mov/arm64-add-imm (the
 instruction encoding aliases). To load zero, use arm64-movz rd 0 0
 instead of arm64-mov rd 31 (which loads SP, not XZR).

Section: Helper Infrastructure

  a64-rt-emit : List Integer, List Integer -> List Integer
  a64-rt-emit (acc) (insn) = acc & insn

Section: __str_eq

  a64-rt-str-eq : List Integer
  a64-rt-str-eq =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-ldr 10 1 0)
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let bne-len = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 0 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 1 1 8)
   in let i = i & arm64-movz 11 0 0
   in let loop-start = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 11 9)
   in let bge-idx = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 12 0 11)
   in let i = a64-rt-emit i (arm64-ldrb 12 12 0)
   in let i = a64-rt-emit i (arm64-add 13 1 11)
   in let i = a64-rt-emit i (arm64-ldrb 13 13 0)
   in let i = a64-rt-emit i (arm64-cmp 12 13)
   in let bne-byte = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add-imm 11 11 1)
   in let i = a64-rt-emit i (arm64-b ((loop-start - list-length i / 4) * 4))
   in let equal-label = list-length i / 4
   in let i = i & arm64-movz 0 1 0
   in let i = a64-rt-emit i arm64-ret
   in let not-eq-label = list-length i / 4
   in let i = i & arm64-movz 0 0 0
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i bne-len (arm64-b-cond 1 ((not-eq-label - bne-len) * 4))
   in let i = a64-patch-insn-raw i bge-idx (arm64-b-cond 10 ((equal-label - bge-idx) * 4))
   in a64-patch-insn-raw i bne-byte (arm64-b-cond 1 ((not-eq-label - bne-byte) * 4))

Section: __str_concat

  a64-rt-str-concat : List Integer
  a64-rt-str-concat =
   let i = []
   in let i = a64-rt-emit i (arm64-ldr 9 0 0)
   in let i = a64-rt-emit i (arm64-ldr 10 1 0)
   in let i = a64-rt-emit i (arm64-mov 13 0)
   in let i = a64-rt-emit i (arm64-mov 14 1)
   in let i = a64-rt-emit i (arm64-add 15 9 10)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 11 15 15)
   in let i = i & arm64-lsr-imm 11 11 3
   in let i = i & arm64-lsl-imm 11 11 3
   in let i = a64-rt-emit i (arm64-add 28 28 11)
   in let i = a64-rt-emit i (arm64-str 15 0 0)
   in let i = a64-rt-emit i (arm64-add-imm 11 0 8)
   in let i = a64-rt-emit i (arm64-add-imm 12 13 8)
   in let i = i & arm64-movz 2 0 0
   in let loop1 = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 2 9)
   in let exit1 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 3 12 2)
   in let i = a64-rt-emit i (arm64-ldrb 3 3 0)
   in let i = a64-rt-emit i (arm64-add 4 11 2)
   in let i = a64-rt-emit i (arm64-strb 3 4 0)
   in let i = a64-rt-emit i (arm64-add-imm 2 2 1)
   in let i = a64-rt-emit i (arm64-b ((loop1 - list-length i / 4) * 4))
   in let exit1-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-add 11 11 9)
   in let i = a64-rt-emit i (arm64-add-imm 12 14 8)
   in let i = i & arm64-movz 2 0 0
   in let loop2 = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 2 10)
   in let exit2 = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 3 12 2)
   in let i = a64-rt-emit i (arm64-ldrb 3 3 0)
   in let i = a64-rt-emit i (arm64-add 4 11 2)
   in let i = a64-rt-emit i (arm64-strb 3 4 0)
   in let i = a64-rt-emit i (arm64-add-imm 2 2 1)
   in let i = a64-rt-emit i (arm64-b ((loop2 - list-length i / 4) * 4))
   in let exit2-label = list-length i / 4
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i exit1 (arm64-b-cond 10 ((exit1-label - exit1) * 4))
   in a64-patch-insn-raw i exit2 (arm64-b-cond 10 ((exit2-label - exit2) * 4))

Section: __itoa

  a64-rt-itoa : List Integer
  a64-rt-itoa =
   let i = []
   in let i = a64-rt-emit i (arm64-stp 29 30 31 (0 - 64))
   in let i = a64-rt-emit i (arm64-sub-imm 31 31 64)
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-mov 29 31)
   in let i = a64-rt-emit i (arm64-mov 19 0)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 28 28 32)
   in let i = a64-rt-emit i (arm64-mov 20 0)
   in let i = i & arm64-movz 21 0 0
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-cmp 19 9)
   in let bge-pos = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-sub 19 9 19)
   in let i = a64-rt-emit i (arm64-add-imm 21 21 1)
   in let pos-label = list-length i / 4
   in let loop = list-length i / 4
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-cmp 19 9)
   in let beq-done = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = i & arm64-movz 9 10 0
   in let i = a64-rt-emit i (arm64-sdiv 10 19 9)
   in let i = a64-rt-emit i (arm64-mul 11 10 9)
   in let i = a64-rt-emit i (arm64-sub 12 19 11)
   in let i = a64-rt-emit i (arm64-add-imm 12 12 48)
   in let i = a64-rt-emit i (arm64-add 9 20 21)
   in let i = a64-rt-emit i (arm64-strb 12 9 8)
   in let i = a64-rt-emit i (arm64-add-imm 21 21 1)
   in let i = a64-rt-emit i (arm64-mov 19 10)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let done-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-str 21 20 0)
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-sub-imm 10 21 1)
   in let rev-loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 9 10)
   in let rev-exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 11 20 9)
   in let i = a64-rt-emit i (arm64-ldrb 12 11 8)
   in let i = a64-rt-emit i (arm64-add 13 20 10)
   in let i = a64-rt-emit i (arm64-ldrb 14 13 8)
   in let i = a64-rt-emit i (arm64-strb 14 11 8)
   in let i = a64-rt-emit i (arm64-strb 12 13 8)
   in let i = a64-rt-emit i (arm64-add-imm 9 9 1)
   in let i = a64-rt-emit i (arm64-sub-imm 10 10 1)
   in let i = a64-rt-emit i (arm64-b ((rev-loop - list-length i / 4) * 4))
   in let rev-exit-label = list-length i / 4
   in let i = a64-rt-emit i (arm64-mov 0 20)
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp 29 30 31 0)
   in let i = a64-rt-emit i (arm64-add-imm 31 31 64)
   in let i = a64-rt-emit i arm64-ret
   in let i = a64-patch-insn-raw i bge-pos (arm64-b-cond 10 ((pos-label - bge-pos) * 4))
   in let i = a64-patch-insn-raw i beq-done (arm64-b-cond 0 ((done-label - beq-done) * 4))
   in a64-patch-insn-raw i rev-exit (arm64-b-cond 10 ((rev-exit-label - rev-exit) * 4))

