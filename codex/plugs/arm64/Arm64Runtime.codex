Section: __list_empty

  a64-rt-list-empty : List Integer
  a64-rt-list-empty =
   let i = []
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = i & arm64-movz 9 0 0
   in let i = a64-rt-emit i (arm64-str 9 28 0)
   in let i = a64-rt-emit i (arm64-add-imm 28 28 8)
   in a64-rt-emit i arm64-ret

