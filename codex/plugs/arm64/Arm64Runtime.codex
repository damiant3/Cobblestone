  a64-rt-read-sctlr-el1 = arm64-mrs 0 sysreg-sctlr-el1 & arm64-ret

  a64-rt-write-sctlr-el1 : List Integer
  a64-rt-write-sctlr-el1 = arm64-msr sysreg-sctlr-el1 0 & arm64-isb & arm64-ret

