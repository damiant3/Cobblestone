Section: Builtin Helpers

  a64-rt-text-length : List Integer
  a64-rt-text-length =
   arm64-ldr 0 0 0 & arm64-ret

  a64-rt-list-at : List Integer
  a64-rt-list-at =
   let i = []
   in let i = a64-rt-emit i (arm64-add 9 1 1)
   in let i = a64-rt-emit i (arm64-add 9 9 9)
   in let i = a64-rt-emit i (arm64-add 9 9 9)
   in let i = a64-rt-emit i (arm64-add 9 0 9)
   in let i = a64-rt-emit i (arm64-ldr 0 9 8)
   in a64-rt-emit i arm64-ret

  a64-rt-char-at : List Integer
  a64-rt-char-at =
   let i = []
   in let i = a64-rt-emit i (arm64-add 9 0 1)
   in let i = a64-rt-emit i (arm64-ldrb 0 9 8)
   in a64-rt-emit i arm64-ret

  a64-rt-char-to-text : List Integer
  a64-rt-char-to-text =
   let i = []
   in let i = a64-rt-emit i (arm64-mov 9 0)
   in let i = a64-rt-emit i (arm64-mov 0 28)
   in let i = a64-rt-emit i (arm64-add-imm 28 28 16)
   in let i = i & arm64-movz 10 1 0
   in let i = a64-rt-emit i (arm64-str 10 0 0)
   in let i = a64-rt-emit i (arm64-strb 9 0 8)
   in a64-rt-emit i arm64-ret

Section: Patching Helper

  a64-patch-insn-raw : List Integer, Integer, List Integer -> List Integer
  a64-patch-insn-raw (code) (insn-index) (new-bytes) =
   let byte-offset = insn-index * 4
   in a64-patch-raw-4 code byte-offset new-bytes 0 (list-length code) []

  a64-patch-raw-4 : List Integer, Integer, List Integer, Integer, Integer, List Integer -> List Integer
  a64-patch-raw-4 (code) (pos) (new-bytes) (i) (len) (acc) =
   if i >= len then acc
   else if i >= pos & i < pos + 4 then a64-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at new-bytes (i - pos)))
   else a64-patch-raw-4 code pos new-bytes (i + 1) len (list-push acc (list-at code i))

Section: __start (QEMU virt boot stub)

  a64-rt-pl011-base : Integer = #09000000

  a64-rt-wfi : List Integer = [31, 32, 0, 212]

Section: print-line-uni (PL011 UART output)

  a64-rt-print-line-uni : List Integer
  a64-rt-print-line-uni =
   let i = []
   in let i = a64-rt-emit i (arm64-stp 29 30 31 (0 - 80))
   in let i = a64-rt-emit i (arm64-sub-imm 31 31 80)
   in let i = a64-rt-emit i (arm64-stp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-stp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-stp 23 23 31 48)
   in let i = a64-rt-emit i (arm64-mov 19 0)
   in let i = a64-rt-emit i (arm64-ldr 20 19 0)
   in let i = i & arm64-li 21 a64-rt-pl011-base
   in let i = i & arm64-movz 22 0 0
   in let loop = list-length i / 4
   in let i = a64-rt-emit i (arm64-cmp 22 20)
   in let exit = list-length i / 4
   in let i = a64-rt-emit i arm64-nop
   in let i = a64-rt-emit i (arm64-add 23 19 22)
   in let i = a64-rt-emit i (arm64-ldrb 23 23 8)
   in let i = a64-rt-emit i (arm64-str 23 21 0)
   in let i = a64-rt-emit i (arm64-add-imm 22 22 1)
   in let i = a64-rt-emit i (arm64-b ((loop - list-length i / 4) * 4))
   in let exit-label = list-length i / 4
   in let i = i & arm64-movz 23 10 0
   in let i = a64-rt-emit i (arm64-str 23 21 0)
   in let i = a64-rt-emit i (arm64-ldp 23 23 31 48)
   in let i = a64-rt-emit i (arm64-ldp 21 22 31 32)
   in let i = a64-rt-emit i (arm64-ldp 19 20 31 16)
   in let i = a64-rt-emit i (arm64-ldp 29 30 31 0)
   in let i = a64-rt-emit i (arm64-add-imm 31 31 80)
   in let i = a64-rt-emit i arm64-ret
   in a64-patch-insn-raw i exit (arm64-b-cond 10 ((exit-label - exit) * 4))

Section: Emit All Runtime Helpers

  a64-emit-runtime : A64State -> A64State
  a64-emit-runtime (st) =
   let st1 = a64-record-func st "__start"
   in let st2 = a64-emit-li st1 9 #48000000
   in let st3 = a64-emit st2 (arm64-mov 31 9)
   in let st4 = a64-emit-li st3 28 #40100000
   in let st5 = a64-add-call-patch st4 "opening"
   in let st6 = a64-emit st5 arm64-nop
   in let st7 = a64-emit st6 a64-rt-wfi
   in let st8 = a64-record-func st7 "print-line-uni"
   in let st9 = a64-emit st8 a64-rt-print-line-uni
   in let st10 = a64-record-func st9 "__str_eq"
   in let st11 = a64-emit st10 a64-rt-str-eq
   in let st12 = a64-record-func st11 "__str_concat"
   in let st13 = a64-emit st12 a64-rt-str-concat
   in let st14 = a64-record-func st13 "__itoa"
   in let st15 = a64-emit st14 a64-rt-itoa
   in let st16 = a64-record-func st15 "__list_cons"
   in let st17 = a64-emit st16 a64-rt-list-cons
   in let st18 = a64-record-func st17 "__list_append"
   in let st19 = a64-emit st18 a64-rt-list-append
   in let st20 = a64-record-func st19 "__list_push"
   in let st21 = a64-emit st20 a64-rt-list-push
   in let st22 = a64-record-func st21 "__list_empty"
   in let st23 = a64-emit st22 a64-rt-list-empty
   in let st24 = a64-record-func st23 "integer-to-text"
