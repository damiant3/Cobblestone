Chapter: Arm64Plug
  cites Foreword chapter Maybe

 Plug entry. Reads IR text from serial input (file-mapped by
 codex-vm), runs the ARM64 code generator, writes binary wire
 output to serial as raw bytes via UART port.

Section: Raw Output

  serial-data-port : Integer = 1016

  serial-write-byte : Integer -> Integer
  serial-write-byte (b) = port-out-byte serial-data-port b

  serial-write-loop : List Integer, Integer, Integer -> Integer
  serial-write-loop (bs) (i) (len) =
   if i >= len then len
   else let w = serial-write-byte (list-at bs i)
   in serial-write-loop bs (i + 1) len

  serial-write-bytes : List Integer -> Integer
  serial-write-bytes (bs) = serial-write-loop bs 0 (list-length bs)

Section: Body

  dispatch : Text -> [Console, FileSystem] Nothing
  dispatch (mode) = act
    source <- read-file mode
    let parsed = parse-ir-chapter source
    in let cg-state = a64-emit-module empty-a64-state (parsed.chapter) (parsed.type-defs)
    in let wire = a64-build-wire-output cg-state
    in let written = serial-write-bytes wire
    in print-line-uni ""
  end

  opening : [Console, FileSystem] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch mode
      is None -> print-line-uni "no input"
  end

