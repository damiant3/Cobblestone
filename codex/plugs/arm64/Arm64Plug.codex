  opening : [Console, FileSystem] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> if text-contains mode "repl" then dispatch-repl mode
        else dispatch mode
      is None -> print-line-uni "no input"
  end

