Chapter: Arm64 Code Generator

Section: Control Flow

 Negating a Real is not negating its bits. Both emission paths have to ask
 this, so it is asked in one place: the targeted path used to assume integer
 and two's-complemented the operand register, which turned 2.5 into
 0xBFFC000000000000, or -1.75. real-negate is the guard.

  a64-negate-is-real : IRExpr -> Boolean
  a64-negate-is-real (operand) =
   when ir-expr-type operand
    is RealTy (w) (m) -> True
    is otherwise -> False

  a64-emit-negate : A64State, IRExpr -> A64EmitResult
  a64-emit-negate (st) (operand) =
   let opr = a64-emit-expr st operand
   in if a64-negate-is-real operand then
    let tr = a64-alloc-temp (opr.state)
    in let zero-r = a64-alloc-temp (tr.state)
    in let st1 = a64-emit-li (zero-r.state) (zero-r.reg) 0
    in let st2 = a64-emit st1 (arm64-fmov-to-fp 0 (zero-r.reg))
    in let st3 = a64-emit st2 (arm64-fmov-to-fp 1 (opr.reg))
    in let st4 = a64-emit st3 (arm64-fsub-d 0 0 1)
    in A64EmitResult { state = a64-emit st4 (arm64-fmov-from-fp (tr.reg) 0), reg = tr.reg }
   else let tr = a64-alloc-temp (opr.state)
   in A64EmitResult {
    state = a64-emit (tr.state) (arm64-neg (tr.reg) (opr.reg)),
    reg = tr.reg
   }

  a64-emit-bit-not : A64State, IRExpr -> A64EmitResult
  a64-emit-bit-not (st) (arg) =
   let vr = a64-emit-expr st arg
   in let mask-r = a64-alloc-temp (vr.state)
   in let st1 = a64-emit-li (mask-r.state) (mask-r.reg) (0 - 1)
   in let tr = a64-alloc-temp st1
   in A64EmitResult {
    state = a64-emit (tr.state) (arm64-xor (tr.reg) (vr.reg) (mask-r.reg)),
    reg = tr.reg
   }

  a64-emit-bit-binop : A64State, List IRExpr, Integer -> A64EmitResult
  a64-emit-bit-binop (st) (args) (op) =
   let lr = a64-emit-expr st (list-at args 0)
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) (list-at args 1)
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let tr = a64-alloc-temp (ll.state)
   in A64EmitResult {
    state = a64-emit (tr.state) (if op == 0 then arm64-and (tr.reg) (ll.reg) (rr.reg) else if op == 1 then arm64-or (tr.reg) (ll.reg) (rr.reg) else arm64-xor (tr.reg) (ll.reg) (rr.reg)),
    reg = tr.reg
   }

  a64-emit-bit-shift : A64State, List IRExpr, Boolean -> A64EmitResult
  a64-emit-bit-shift (st) (args) (is-arith) =
   let lr = a64-emit-expr st (list-at args 0)
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) (list-at args 1)
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let tr = a64-alloc-temp (ll.state)
   in A64EmitResult {
    state = a64-emit (tr.state) (if is-arith then arm64-asr (tr.reg) (ll.reg) (rr.reg) else arm64-lsr (tr.reg) (ll.reg) (rr.reg)),
    reg = tr.reg
   }

  a64-emit-bit-shl : A64State, List IRExpr -> A64EmitResult
  a64-emit-bit-shl (st) (args) =
   let lr = a64-emit-expr st (list-at args 0)
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) (list-at args 1)
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let tr = a64-alloc-temp (ll.state)
   in A64EmitResult {
    state = a64-emit (tr.state) (arm64-lsl (tr.reg) (ll.reg) (rr.reg)),
    reg = tr.reg
   }

  a64-emit-is-char-class : A64State, IRExpr, Integer, Integer -> A64EmitResult
  a64-emit-is-char-class (st) (arg) (lo) (hi) =
   let vr = a64-emit-expr st arg
   in let tr = a64-alloc-temp (vr.state)
   in let lo-r = a64-alloc-temp (tr.state)
   in let st1 = a64-emit-li (lo-r.state) (lo-r.reg) lo
   in let st2 = a64-emit st1 (arm64-sub (tr.reg) (vr.reg) (lo-r.reg))
   in let hi-r = a64-alloc-temp st2
   in let st3 = a64-emit-li (hi-r.state) (hi-r.reg) (hi - lo + 1)
   in let result-r = a64-alloc-temp st3
   in let st4 = a64-emit (result-r.state) (arm64-cmp (tr.reg) (hi-r.reg))
   in let st5 = a64-emit st4 (arm64-csinc (result-r.reg) a64-xzr a64-xzr 2)
   in A64EmitResult { state = st5, reg = result-r.reg }

 A letter is TWO bands, because CCE's punctuation sits between them: 13..64
 is the ASCII lower and upper, 65..96 the punctuation and symbols, and
 97..127 the sixteen accented Latin letters and fifteen Cyrillic ones. One
 band cannot express that, which is why is-letter needs this and is-digit
 does not.

 The operand is read by the two subtracts and never again, and that ordering
 is load-bearing rather than tidy. `a64-alloc-temp` rotates a pool of FOUR
 registers, so a fourth allocation after the operand's own would be handed
 the operand's register back; three temps is the budget that keeps the
 result from landing on top of a value still to be read. The immediate
 compare is what buys the third slot, since the band width never needs a
 register of its own.

  a64-emit-is-char-class2 : A64State, IRExpr, Integer, Integer, Integer, Integer -> A64EmitResult
  a64-emit-is-char-class2 (st) (arg) (lo1) (hi1) (lo2) (hi2) =
   let vr = a64-emit-expr st arg
   in let t1 = a64-alloc-temp (vr.state)
   in let t2 = a64-alloc-temp (t1.state)
   in let st1 = a64-emit (t2.state) (arm64-sub-imm (t1.reg) (vr.reg) lo1)
   in let st2 = a64-emit st1 (arm64-sub-imm (t2.reg) (vr.reg) lo2)
   in let rr = a64-alloc-temp st2
   in let st3 = a64-emit (rr.state) (arm64-cmp-imm (t1.reg) (hi1 - lo1 + 1))
   in let st4 = a64-emit st3 (arm64-csinc (rr.reg) a64-xzr a64-xzr 2)
   in let st5 = a64-emit st4 (arm64-cmp-imm (t2.reg) (hi2 - lo2 + 1))
   in let st6 = a64-emit st5 (arm64-csinc (t1.reg) a64-xzr a64-xzr 2)
   in A64EmitResult { state = a64-emit st6 (arm64-or (rr.reg) (rr.reg) (t1.reg)), reg = rr.reg }

  a64-emit-abs : A64State, IRExpr -> A64EmitResult
  a64-emit-abs (st) (arg) =
   let vr = a64-emit-expr st arg
   in let tr = a64-alloc-temp (vr.state)
   in let st1 = a64-emit (tr.state) (arm64-cmp (vr.reg) a64-xzr)
   in let st2 = a64-emit st1 (arm64-neg (tr.reg) (vr.reg))
   in A64EmitResult {
    state = a64-emit st2 (arm64-csel (tr.reg) (tr.reg) (vr.reg) 11),
    reg = tr.reg
   }

  a64-emit-min-max : A64State, List IRExpr, Boolean -> A64EmitResult
  a64-emit-min-max (st) (args) (is-max) =
   let lr = a64-emit-expr st (list-at args 0)
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) (list-at args 1)
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let tr = a64-alloc-temp (ll.state)
   in let st1 = a64-emit (tr.state) (arm64-cmp (ll.reg) (rr.reg))
   in let cc = if is-max then 12 else 11
   in A64EmitResult {
    state = a64-emit st1 (arm64-csel (tr.reg) (ll.reg) (rr.reg) cc),
    reg = tr.reg
   }

  a64-set-tail-pos : A64State, Boolean -> A64State
  a64-set-tail-pos (st) (v) =
   __record-set st "tco" (__record-set (st.tco) "in-tail-pos" v)

  a64-is-cmp-op : IRBinaryOp -> Boolean
  a64-is-cmp-op (op) =
   when op
    is IrEq -> True
    is IrNotEq -> True
    is IrLt -> True
    is IrGt -> True
    is IrLtEq -> True
    is IrGtEq -> True
    is IrApproxEq -> True
    is IrApproxEqExact -> True
    is otherwise -> False

  a64-invert-cmp : IRBinaryOp -> Integer
  a64-invert-cmp (op) =
   when op
    is IrEq -> 1
    is IrNotEq -> 0
    is IrLt -> 10
    is IrGt -> 13
    is IrLtEq -> 12
    is IrGtEq -> 11
    is IrApproxEq -> 1
    is IrApproxEqExact -> 1
    is otherwise -> 1

  a64-emit-if-cmp : A64State, Boolean, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cmp (st) (saved-tail) (op) (left) (right) (th) (el) =
   let imm-val = a64-small-imm right
   in if imm-val > 0 then a64-emit-if-cmp-imm st saved-tail op left (imm-val - 1) th el
   else a64-emit-if-cmp-reg st saved-tail op left right th el

  a64-emit-if-cmp-imm : A64State, Boolean, IRBinaryOp, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cmp-imm (st) (saved-tail) (op) (left) (imm) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let lr = a64-emit-expr st0 left
   in let st2 = a64-emit (lr.state) (arm64-cmp-imm (lr.reg) imm)
   in let cond-index = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in if a64-is-tco-else st saved-tail el then
    let tr = a64-emit-expr (a64-set-tail-pos st3 saved-tail) th
    in let jmp-end-index = tr.state.insn-count
    in let st4 = a64-emit (tr.state) arm64-nop
    in let else-start = st4.insn-count
    in let er = a64-emit-expr (a64-set-tail-pos st4 saved-tail) el
    in let st-unified = if er.reg == tr.reg then er.state
     else a64-emit (er.state) (arm64-mov (tr.reg) (er.reg))
    in let end-index = st-unified.insn-count
    in let st5 = a64-patch-insn st-unified cond-index (arm64-b-cond (a64-invert-cmp op) ((else-start - cond-index) * 4))
    in let st6 = if a64-can-elide-jmp-end st5 jmp-end-index th then st5
     else a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
    in A64EmitResult { state = st6, reg = tr.reg }
   else let result-loc = a64-alloc-local st3
   in let branch-base = result-loc.state.next-local
   in let tr = a64-emit-expr (a64-set-tail-pos (result-loc.state) saved-tail) th
   in let st4 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st4.insn-count
   in let st5 = a64-emit (__record-set st4 "next-local" branch-base) arm64-nop
   in let else-start = st5.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st5 saved-tail) el
   in let st6 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st6.insn-count
   in let st7 = a64-patch-insn (__record-set st6 "next-local" branch-base) cond-index (arm64-b-cond (a64-invert-cmp op) ((else-start - cond-index) * 4))
   in let st8 = a64-patch-insn st7 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st8 (result-loc.reg)

  a64-emit-if-cmp-reg : A64State, Boolean, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cmp-reg (st) (saved-tail) (op) (left) (right) (th) (el) =
   let pre-nl = st.next-local
   in let st0 = a64-set-tail-pos st False
   in let lr = a64-emit-expr st0 left
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) right
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let st2 = a64-emit (ll.state) (arm64-cmp (ll.reg) (rr.reg))
   in let st2a = __record-set st2 "next-local" pre-nl
   in let result-loc = a64-alloc-local st2a
   in let branch-base = result-loc.state.next-local
   in let cond-index = result-loc.state.insn-count
   in let st3 = a64-emit (result-loc.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st3 saved-tail) th
   in let st4 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st4.insn-count
   in let st5 = a64-emit (__record-set st4 "next-local" branch-base) arm64-nop
   in let else-start = st5.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st5 saved-tail) el
   in let st6 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st6.insn-count
   in let st7 = a64-patch-insn (__record-set st6 "next-local" branch-base) cond-index (arm64-b-cond (a64-invert-cmp op) ((else-start - cond-index) * 4))
   in let st8 = a64-patch-insn st7 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st8 (result-loc.reg)

  a64-emit-if-val : A64State, Boolean, IRExpr, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-val (st) (saved-tail) (cond) (th) (el) =
   let cr = a64-emit-expr (a64-set-tail-pos st False) cond
   in let result-loc = a64-alloc-local (cr.state)
   in let branch-base = result-loc.state.next-local
   in let cbz-index = result-loc.state.insn-count
   in let st1 = a64-emit (result-loc.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st1 saved-tail) th
   in let st2 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st3 saved-tail) el
   in let st4 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) cbz-index (arm64-cbz (cr.reg) ((else-start - cbz-index) * 4))
   in let st6 = a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st6 (result-loc.reg)

  a64-is-zero-lit : IRExpr -> Boolean
  a64-is-zero-lit (e) =
   when e
    is IrIntLit (v) (s) -> v == 0
    is _ -> False

  a64-is-tco-else : A64State, Boolean, IRExpr -> Boolean
  a64-is-tco-else (st) (saved-tail) (el) =
   if saved-tail then if st.tco.active then a64-has-tail-call el (st.tco.current-func) else False
   else False

  a64-emit-if-cbz : A64State, Boolean, IRExpr, Boolean, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cbz (st) (saved-tail) (expr) (use-cbnz) (th) (el) =
   if a64-is-tco-else st saved-tail el then a64-emit-if-cbz-tco st saved-tail expr use-cbnz th el
   else a64-emit-if-cbz-full st saved-tail expr use-cbnz th el

  a64-emit-if-cbz-tco : A64State, Boolean, IRExpr, Boolean, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cbz-tco (st) (saved-tail) (expr) (use-cbnz) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let cbz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st1 saved-tail) th
   in let jmp-end-index = tr.state.insn-count
   in let st2 = a64-emit (tr.state) arm64-nop
   in let else-start = st2.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st2 saved-tail) el
   in let st-unified = if er.reg == tr.reg then er.state
    else a64-emit (er.state) (arm64-mov (tr.reg) (er.reg))
   in let end-index = st-unified.insn-count
   in let branch = if use-cbnz then arm64-cbnz (vr.reg) ((else-start - cbz-index) * 4)
    else arm64-cbz (vr.reg) ((else-start - cbz-index) * 4)
   in let st3 = a64-patch-insn st-unified cbz-index branch
   in let st4 = if a64-can-elide-jmp-end st3 jmp-end-index th then st3
    else a64-patch-insn st3 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in A64EmitResult { state = st4, reg = tr.reg }

  a64-emit-if-cbz-full : A64State, Boolean, IRExpr, Boolean, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-cbz-full (st) (saved-tail) (expr) (use-cbnz) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let result-loc = a64-alloc-local (vr.state)
   in let branch-base = result-loc.state.next-local
   in let cbz-index = result-loc.state.insn-count
   in let st1 = a64-emit (result-loc.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st1 saved-tail) th
   in let st2 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st3 saved-tail) el
   in let st4 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st4.insn-count
   in let branch = if use-cbnz then arm64-cbnz (vr.reg) ((else-start - cbz-index) * 4)
    else arm64-cbz (vr.reg) ((else-start - cbz-index) * 4)
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) cbz-index branch
   in let st6 = a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st6 (result-loc.reg)

  a64-emit-if : A64State, IRExpr, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if (st) (cond) (th) (el) =
   let saved-tail = st.tco.in-tail-pos
   in when cond
    is IrBinary (op) (left) (right) (ty) (s) ->
     if a64-is-text-type (ir-expr-type left) then a64-emit-if-val st saved-tail cond th el
     else if a64-real-cmp-kind (ir-expr-type left) > 0 then a64-emit-if-val st saved-tail cond th el
     else if a64-is-zero-lit right then
      when op
       is IrEq -> if a64-is-rem-2 left then a64-emit-if-tbnz st saved-tail (a64-rem-2-operand left) 0 th el
        else a64-emit-if-cbz st saved-tail left True th el
       is IrNotEq -> if a64-is-rem-2 left then a64-emit-if-tbz st saved-tail (a64-rem-2-operand left) 0 th el
        else a64-emit-if-cbz st saved-tail left False th el
       is _ -> a64-emit-if-cmp st saved-tail op left right th el
     else if a64-is-cmp-op op then a64-emit-if-cmp st saved-tail op left right th el
     else a64-emit-if-val st saved-tail cond th el
    is _ -> a64-emit-if-val st saved-tail cond th el

  a64-is-rem-2 : IRExpr -> Boolean
  a64-is-rem-2 (e) =
   when e
    is IrBinary (op) (l) (r) (t) (s) ->
     when op
      is IrRemInt -> when r is IrIntLit (v) (s2) -> v == 2 is otherwise -> False
      is otherwise -> False
    is IrApply (f) (a) (t) (s) ->
     when a
      is IrIntLit (v) (s2) ->
       if v == 2 then when f
        is IrApply (f2) (a2) (t2) (s2) ->
         when f2
          is IrName (n) (nt) (ns) -> n == "math-mod" | n == "int-mod"
          is _ -> False
        is _ -> False
       else False
      is _ -> False
    is otherwise -> False

  a64-rem-2-operand : IRExpr -> IRExpr
  a64-rem-2-operand (e) =
   when e
    is IrBinary (op) (l) (r) (t) (s) -> l
    is IrApply (f) (a) (t) (s) ->
     when f
      is IrApply (f2) (a2) (t2) (s2) -> a2
      is _ -> e
    is otherwise -> e

  arm64-tbz : Integer, Integer, Integer -> List Integer
  arm64-tbz (rt) (bit) (offset) =
   let imm14 = bit-and (offset / 4) #3FFF
   in arm64-encode (bit-or (bit-or (bit-or #36000000 (bit-shl bit 19)) (bit-shl imm14 5)) rt)

  arm64-tbnz : Integer, Integer, Integer -> List Integer
  arm64-tbnz (rt) (bit) (offset) =
   let imm14 = bit-and (offset / 4) #3FFF
   in arm64-encode (bit-or (bit-or (bit-or #37000000 (bit-shl bit 19)) (bit-shl imm14 5)) rt)

  a64-emit-if-tbz : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbz (st) (saved-tail) (expr) (bit) (th) (el) =
   if a64-is-tco-else st saved-tail el then a64-emit-if-tbz-tco st saved-tail expr bit th el
   else a64-emit-if-tbz-full st saved-tail expr bit th el

  a64-emit-if-tbnz : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbnz (st) (saved-tail) (expr) (bit) (th) (el) =
   if a64-is-tco-else st saved-tail el then a64-emit-if-tbnz-tco st saved-tail expr bit th el
   else a64-emit-if-tbnz-full st saved-tail expr bit th el

  a64-emit-if-tbz-full : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbz-full (st) (saved-tail) (expr) (bit) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let result-loc = a64-alloc-local (vr.state)
   in let branch-base = result-loc.state.next-local
   in let tbz-index = result-loc.state.insn-count
   in let st1 = a64-emit (result-loc.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st1 saved-tail) th
   in let st2 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st3 saved-tail) el
   in let st4 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) tbz-index (arm64-tbz (vr.reg) bit ((else-start - tbz-index) * 4))
   in let st6 = a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st6 (result-loc.reg)

  a64-emit-if-tbnz-full : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbnz-full (st) (saved-tail) (expr) (bit) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let result-loc = a64-alloc-local (vr.state)
   in let branch-base = result-loc.state.next-local
   in let tbnz-index = result-loc.state.insn-count
   in let st1 = a64-emit (result-loc.state) arm64-nop
   in let tr = a64-emit-expr (a64-set-tail-pos st1 saved-tail) th
   in let st2 = a64-store-local (tr.state) (result-loc.reg) (tr.reg)
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let er = a64-emit-expr (a64-set-tail-pos st3 saved-tail) el
   in let st4 = a64-store-local (er.state) (result-loc.reg) (er.reg)
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) tbnz-index (arm64-tbnz (vr.reg) bit ((else-start - tbnz-index) * 4))
   in let st6 = a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st6 (result-loc.reg)

  a64-emit-if-tbz-tco : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbz-tco (st) (saved-tail) (expr) (bit) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let tbz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let tr = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th a64-x0
   in let jmp-end-index = tr.insn-count
   in let st2 = a64-emit tr arm64-nop
   in let else-start = st2.insn-count
   in let er = a64-emit-expr-to (a64-set-tail-pos st2 saved-tail) el a64-x0
   in let end-index = er.insn-count
   in let st3 = a64-patch-insn er tbz-index (arm64-tbz (vr.reg) bit ((else-start - tbz-index) * 4))
   in let st4 = if a64-can-elide-jmp-end st3 jmp-end-index th then st3
    else a64-patch-insn st3 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in A64EmitResult { state = st4, reg = a64-x0 }

  a64-emit-if-tbnz-tco : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr -> A64EmitResult
  a64-emit-if-tbnz-tco (st) (saved-tail) (expr) (bit) (th) (el) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let tbnz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let tr = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th a64-x0
   in let jmp-end-index = tr.insn-count
   in let st2 = a64-emit tr arm64-nop
   in let else-start = st2.insn-count
   in let er = a64-emit-expr-to (a64-set-tail-pos st2 saved-tail) el a64-x0
   in let end-index = er.insn-count
   in let st3 = a64-patch-insn er tbnz-index (arm64-tbnz (vr.reg) bit ((else-start - tbnz-index) * 4))
   in let st4 = if a64-can-elide-jmp-end st3 jmp-end-index th then st3
    else a64-patch-insn st3 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in A64EmitResult { state = st4, reg = a64-x0 }

  a64-let-value-is-simple : IRExpr -> Boolean
  a64-let-value-is-simple (e) =
   when e
    is IrBinary (op) (l) (r) (t) (s) -> a64-is-simple-arith op
    is IrNegate (x) (nty) (s) -> True
    is otherwise -> False

  a64-emit-let : A64State, Text, IRExpr, IRExpr -> A64EmitResult
  a64-emit-let (st) (name) (value) (body) =
   let saved-len = list-length (st.locals)
   in let br = a64-emit-let-bound st name value body
   in A64EmitResult {
    state = a64-restore-locals (br.state) saved-len,
    reg = br.reg
   }

  a64-emit-let-bound : A64State, Text, IRExpr, IRExpr -> A64EmitResult
  a64-emit-let-bound (st) (name) (value) (body) =
   let saved-tail = st.tco.in-tail-pos
   in if a64-let-value-is-simple value then
    let loc = a64-alloc-local (a64-set-tail-pos st False)
    in if loc.reg < a64-spill-base then
     let st1 = a64-emit-expr-to (loc.state) value (loc.reg)
     in let st2 = a64-bind-local st1 name (loc.reg)
     in a64-emit-expr (a64-set-tail-pos st2 saved-tail) body
    else let vr = a64-emit-expr (loc.state) value
    in let st1 = a64-store-local (vr.state) (loc.reg) (vr.reg)
    in let st2 = a64-bind-local st1 name (loc.reg)
    in a64-emit-expr (a64-set-tail-pos st2 saved-tail) body
   else let vr = a64-emit-expr (a64-set-tail-pos st False) value
   in if a64-is-stable-reg (vr.reg) then
    let st1 = a64-bind-local (vr.state) name (vr.reg)
    in a64-emit-expr (a64-set-tail-pos st1 saved-tail) body
   else let loc = a64-alloc-local (vr.state)
   in let st1 = a64-store-local (loc.state) (loc.reg) (vr.reg)
   in let st2 = a64-bind-local st1 name (loc.reg)
   in a64-emit-expr (a64-set-tail-pos st2 saved-tail) body

Section: Targeted Expression Emission

  a64-is-simple-arith : IRBinaryOp -> Boolean
  a64-is-simple-arith (op) =
   when op
    is IrAddInt -> True
    is IrSubInt -> True
    is IrMulInt -> True
    is IrDivInt -> True
    is IrRemInt -> True
    is otherwise -> False

  a64-emit-expr-to : A64State, IRExpr, Integer -> A64State
  a64-emit-expr-to (st) (expr) (target) =
   when expr
    is IrIntLit (value) (s) -> a64-emit-li st target value
    is IrBoolLit (value) (s) -> a64-emit-li st target (if value then 1 else 0)
    is IrCharLit (value) (s) -> a64-emit-li st target value
    is IrNumLit (value) (s) -> a64-emit-li st target value
    is IrName (name) (ty) (s) ->
     let r = a64-lookup-local (st.locals) name 0
     in if r < 0 then
      let er = a64-emit-name st name ty
      in if er.reg == target then er.state
      else a64-emit (er.state) (arm64-mov target (er.reg))
     else if r == target then st
     else if r < a64-spill-base then a64-emit st (arm64-mov target r)
     else a64-emit st (arm64-ldr target a64-sp ((r - a64-spill-base) * 8 + 96))
    is IrBinary (op) (left) (right) (ty) (s) ->
     if a64-is-simple-arith op then a64-emit-binary-targeted st op left right target
     else let er = a64-emit-expr st expr
     in if er.reg == target then er.state
     else a64-emit (er.state) (arm64-mov target (er.reg))
    is IrNegate (operand) (nty) (s) ->
     if a64-negate-is-real operand then
      let nr = a64-emit-negate st operand
      in if nr.reg == target then nr.state
      else a64-emit (nr.state) (arm64-mov target (nr.reg))
     else let opr = a64-emit-expr st operand
     in a64-emit (opr.state) (arm64-sub target a64-xzr (opr.reg))
    is IrIf (cond) (th) (el) (ty) (s) ->
     a64-emit-if-targeted st cond th el target
    is otherwise ->
     let er = a64-emit-expr st expr
     in if er.reg == target then er.state
     else a64-emit (er.state) (arm64-mov target (er.reg))

  a64-mul-shift-amount : IRExpr -> Integer
  a64-mul-shift-amount (e) =
   when e
    is IrIntLit (v) (s) ->
     if v == 2 then 1 else if v == 4 then 2 else if v == 8 then 3
     else if v == 16 then 4 else if v == 32 then 5 else if v == 64 then 6
     else 0
    is otherwise -> 0

  a64-is-mul-by-3 : IRExpr, IRExpr -> Boolean
  a64-is-mul-by-3 (left) (right) =
   when left
    is IrIntLit (v) (s) -> v == 3
    is otherwise -> when right
     is IrIntLit (v) (s) -> v == 3
     is otherwise -> False

  a64-mul-by-3-operand : IRExpr, IRExpr -> IRExpr
  a64-mul-by-3-operand (left) (right) =
   when left
    is IrIntLit (v) (s) -> right
    is otherwise -> left

  arm64-add-shifted : Integer, Integer, Integer, Integer -> List Integer
  arm64-add-shifted (rd) (rn) (rm) (shift) =
   arm64-encode (bit-or (bit-or (bit-or (bit-or #8B000000 (bit-shl rm 16)) (bit-shl shift 10)) (bit-shl rn 5)) rd)

  a64-emit-binary-targeted : A64State, IRBinaryOp, IRExpr, IRExpr, Integer -> A64State
  a64-emit-binary-targeted (st) (op) (left) (right) (target) =
   let mul-shift = when op is IrMulInt -> a64-mul-shift-amount right is otherwise -> 0
   in if mul-shift > 0 then
    let lr = a64-emit-expr st left
    in a64-emit (lr.state) (arm64-lsl-imm target (lr.reg) mul-shift)
   else let mul-shift-l = when op is IrMulInt -> a64-mul-shift-amount left is otherwise -> 0
   in if mul-shift-l > 0 then
    let rr = a64-emit-expr st right
    in a64-emit (rr.state) (arm64-lsl-imm target (rr.reg) mul-shift-l)
   else if when op is IrMulInt -> a64-is-mul-by-3 left right is otherwise -> False then
    let operand = a64-mul-by-3-operand left right
    in let opr = a64-emit-expr st operand
    in a64-emit (opr.state) (arm64-add-shifted target (opr.reg) (opr.reg) 1)
   else let imm-val = a64-small-imm right
   in if imm-val > 0 then
    if a64-is-imm-eligible op then a64-emit-binary-imm-targeted st op left (imm-val - 1) target
    else a64-emit-binary-reg-targeted st op left right target
   else a64-emit-binary-reg-targeted st op left right target

  a64-emit-binary-imm-targeted : A64State, IRBinaryOp, IRExpr, Integer, Integer -> A64State
  a64-emit-binary-imm-targeted (st) (op) (left) (imm) (target) =
   let lr = a64-emit-expr st left
   in when op
    is IrAddInt -> a64-emit (lr.state) (arm64-add-imm target (lr.reg) imm)
    is IrSubInt -> a64-emit (lr.state) (arm64-sub-imm target (lr.reg) imm)
    is otherwise -> a64-emit (lr.state) (arm64-add-imm target (lr.reg) 0)

  a64-emit-binary-reg-targeted : A64State, IRBinaryOp, IRExpr, IRExpr, Integer -> A64State
  a64-emit-binary-reg-targeted (st) (op) (left) (right) (target) =
   let lr = a64-emit-expr st left
   in let pre-save-nl = lr.state.next-local
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) right
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let st2 = __record-set (ll.state) "next-local" pre-save-nl
   in when op
    is IrAddInt -> a64-emit st2 (arm64-add target (ll.reg) (rr.reg))
    is IrSubInt -> a64-emit st2 (arm64-sub target (ll.reg) (rr.reg))
    is IrMulInt -> a64-emit st2 (arm64-mul target (ll.reg) (rr.reg))
    is IrDivInt -> a64-emit st2 (arm64-sdiv target (ll.reg) (rr.reg))
    is IrRemInt ->
     let st3 = a64-emit st2 (arm64-sdiv target (ll.reg) (rr.reg))
     in a64-emit st3 (arm64-msub target target (rr.reg) (ll.reg))
    is otherwise -> a64-emit st2 (arm64-add target (ll.reg) (rr.reg))

  a64-emit-let-targeted : A64State, Text, IRExpr, IRExpr, Integer -> A64State
  a64-emit-let-targeted (st) (name) (value) (body) (target) =
   let saved-len = list-length (st.locals)
   in a64-restore-locals (a64-emit-let-targeted-bound st name value body target) saved-len

  a64-emit-let-targeted-bound : A64State, Text, IRExpr, IRExpr, Integer -> A64State
  a64-emit-let-targeted-bound (st) (name) (value) (body) (target) =
   let saved-tail = st.tco.in-tail-pos
   in let st0 = a64-set-tail-pos st False
   in if a64-result-is-stable value then
    let vr = a64-emit-expr st0 value
    in let st1 = a64-bind-local (vr.state) name (vr.reg)
    in a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) body target
   else let loc = a64-alloc-local st0
   in let st1 = a64-emit-expr-to (loc.state) value (loc.reg)
   in let st2 = a64-bind-local st1 name (loc.reg)
   in a64-emit-expr-to (a64-set-tail-pos st2 saved-tail) body target

  a64-emit-if-targeted : A64State, IRExpr, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-targeted (st) (cond) (th) (el) (target) =
   let saved-tail = st.tco.in-tail-pos
   in when cond
    is IrBinary (op) (left) (right) (ty) (s) ->
     if a64-is-text-type (ir-expr-type left) then a64-emit-if-val-targeted st saved-tail cond th el target
     else if a64-real-cmp-kind (ir-expr-type left) > 0 then a64-emit-if-val-targeted st saved-tail cond th el target
     else if a64-is-zero-lit right then
      when op
       is IrEq -> if a64-is-rem-2 left then a64-emit-if-tbnz-targeted st saved-tail (a64-rem-2-operand left) 0 th el target
        else a64-emit-if-cbz-targeted st saved-tail left True th el target
       is IrNotEq -> if a64-is-rem-2 left then a64-emit-if-tbz-targeted st saved-tail (a64-rem-2-operand left) 0 th el target
        else a64-emit-if-cbz-targeted st saved-tail left False th el target
       is _ -> a64-emit-if-cmp-targeted st saved-tail op left right th el target
     else if a64-is-cmp-op op then a64-emit-if-cmp-targeted st saved-tail op left right th el target
     else a64-emit-if-val-targeted st saved-tail cond th el target
    is _ -> a64-emit-if-val-targeted st saved-tail cond th el target

  a64-emit-if-cmp-targeted : A64State, Boolean, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-cmp-targeted (st) (saved-tail) (op) (left) (right) (th) (el) (target) =
   let imm-val = a64-small-imm right
   in if imm-val > 0 then a64-emit-if-cmp-imm-targeted st saved-tail op left (imm-val - 1) th el target
   else a64-emit-if-cmp-reg-targeted st saved-tail op left right th el target

  a64-emit-if-cmp-imm-targeted : A64State, Boolean, IRBinaryOp, IRExpr, Integer, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-cmp-imm-targeted (st) (saved-tail) (op) (left) (imm) (th) (el) (target) =
   let st0 = a64-set-tail-pos st False
   in let lr = a64-emit-expr st0 left
   in let st2 = a64-emit (lr.state) (arm64-cmp-imm (lr.reg) imm)
   in let cond-index = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in let branch-base = st3.next-local
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) th target
   in let jmp-end-index = st4.insn-count
   in let st5 = a64-emit (__record-set st4 "next-local" branch-base) arm64-nop
   in let else-start = st5.insn-count
   in let st6 = a64-emit-expr-to (a64-set-tail-pos st5 saved-tail) el target
   in let end-index = st6.insn-count
   in let st7 = a64-patch-insn (__record-set st6 "next-local" branch-base) cond-index (arm64-b-cond (a64-invert-cmp op) ((else-start - cond-index) * 4))
   in if a64-can-elide-jmp-end st7 jmp-end-index th then st7
   else a64-patch-insn st7 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-if-cmp-reg-targeted : A64State, Boolean, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-cmp-reg-targeted (st) (saved-tail) (op) (left) (right) (th) (el) (target) =
   let pre-nl = st.next-local
   in let st0 = a64-set-tail-pos st False
   in let lr = a64-emit-expr st0 left
   in let saved = a64-save-if-needed (lr.state) (lr.reg)
   in let rr = a64-emit-expr (saved.state) right
   in let ll = a64-reload-if-needed (rr.state) (saved.reg)
   in let st2 = a64-emit (ll.state) (arm64-cmp (ll.reg) (rr.reg))
   in let st2a = __record-set st2 "next-local" pre-nl
   in let cond-index = st2a.insn-count
   in let st3 = a64-emit st2a arm64-nop
   in let branch-base = st3.next-local
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) th target
   in let jmp-end-index = st4.insn-count
   in let st5 = a64-emit (__record-set st4 "next-local" branch-base) arm64-nop
   in let else-start = st5.insn-count
   in let st6 = a64-emit-expr-to (a64-set-tail-pos st5 saved-tail) el target
   in let end-index = st6.insn-count
   in let st7 = a64-patch-insn (__record-set st6 "next-local" branch-base) cond-index (arm64-b-cond (a64-invert-cmp op) ((else-start - cond-index) * 4))
   in if a64-can-elide-jmp-end st7 jmp-end-index th then st7
   else a64-patch-insn st7 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-if-cbz-targeted : A64State, Boolean, IRExpr, Boolean, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-cbz-targeted (st) (saved-tail) (expr) (use-cbnz) (th) (el) (target) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let cbz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let branch-base = st1.next-local
   in let st2 = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th target
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) el target
   in let end-index = st4.insn-count
   in let branch = if use-cbnz then arm64-cbnz (vr.reg) ((else-start - cbz-index) * 4)
    else arm64-cbz (vr.reg) ((else-start - cbz-index) * 4)
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) cbz-index branch
   in if a64-can-elide-jmp-end st5 jmp-end-index th then st5
   else a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-if-val-targeted : A64State, Boolean, IRExpr, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-val-targeted (st) (saved-tail) (cond) (th) (el) (target) =
   let cr = a64-emit-expr (a64-set-tail-pos st False) cond
   in let cbz-index = cr.state.insn-count
   in let st1 = a64-emit (cr.state) arm64-nop
   in let branch-base = st1.next-local
   in let st2 = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th target
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) el target
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) cbz-index (arm64-cbz (cr.reg) ((else-start - cbz-index) * 4))
   in if a64-can-elide-jmp-end st5 jmp-end-index th then st5
   else a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-if-tbnz-targeted : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-tbnz-targeted (st) (saved-tail) (expr) (bit) (th) (el) (target) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let tbnz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let branch-base = st1.next-local
   in let st2 = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th target
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) el target
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) tbnz-index (arm64-tbnz (vr.reg) bit ((else-start - tbnz-index) * 4))
   in if a64-can-elide-jmp-end st5 jmp-end-index th then st5
   else a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-if-tbz-targeted : A64State, Boolean, IRExpr, Integer, IRExpr, IRExpr, Integer -> A64State
  a64-emit-if-tbz-targeted (st) (saved-tail) (expr) (bit) (th) (el) (target) =
   let st0 = a64-set-tail-pos st False
   in let vr = a64-emit-expr st0 expr
   in let tbz-index = vr.state.insn-count
   in let st1 = a64-emit (vr.state) arm64-nop
   in let branch-base = st1.next-local
   in let st2 = a64-emit-expr-to (a64-set-tail-pos st1 saved-tail) th target
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit (__record-set st2 "next-local" branch-base) arm64-nop
   in let else-start = st3.insn-count
   in let st4 = a64-emit-expr-to (a64-set-tail-pos st3 saved-tail) el target
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn (__record-set st4 "next-local" branch-base) tbz-index (arm64-tbz (vr.reg) bit ((else-start - tbz-index) * 4))
   in if a64-can-elide-jmp-end st5 jmp-end-index th then st5
   else a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))

  a64-emit-act : A64State, List IRActStmt -> A64EmitResult
  a64-emit-act (st) (stmts) =
   a64-emit-act-loop st stmts 0 a64-xzr

  a64-emit-act-loop : A64State, List IRActStmt, Integer, Integer -> A64EmitResult
  a64-emit-act-loop (st) (stmts) (i) (last-reg) =
   if i >= list-length stmts then A64EmitResult { state = st, reg = last-reg }
   else let saved-next-local = st.next-local
   in let saved-next-temp = st.next-temp
   in when list-at stmts i
    is IrDoExec (expr) (s) ->
     let er = a64-emit-expr st expr
     in let st1 = __record-set (er.state) "next-temp" saved-next-temp
     in a64-emit-act-loop st1 stmts (i + 1) (er.reg)
    is IrDoBind (name) (ty) (expr) (s) ->
     let er = a64-emit-expr st expr
     in let loc = a64-alloc-local (er.state)
     in let st1 = a64-store-local (loc.state) (loc.reg) (er.reg)
     in let st2 = a64-bind-local st1 name (loc.reg)
     in a64-emit-act-loop st2 stmts (i + 1) (loc.reg)

  a64-emit-fail : A64State, List IRExpr -> A64EmitResult
  a64-emit-fail (st) (args) =
   let msg-r = a64-emit-expr (a64-set-tail-pos st False) (list-at args 0)
   in let tr = a64-alloc-temp (msg-r.state)
   in let st1 = a64-emit-li (tr.state) a64-x9 a64-try-fail-flag-addr
   in let st2 = a64-emit-li st1 a64-x10 1
   in let st3 = a64-emit st2 (arm64-str a64-x10 a64-x9 0)
   in let st4 = a64-emit-li st3 (tr.reg) 0
   in A64EmitResult { state = st4, reg = tr.reg }

  a64-try-check-flag : A64State, Integer -> A64State
  a64-try-check-flag (st) (body-failed-idx) =
   let st1 = a64-emit-li st a64-x9 a64-try-fail-flag-addr
   in let st2 = a64-emit st1 (arm64-ldr a64-x9 a64-x9 0)
   in let cbnz-idx = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in a64-patch-insn st3 cbnz-idx (arm64-cbnz a64-x9 ((body-failed-idx - cbnz-idx) * 4))

  a64-try-clear-flag : A64State -> A64State
  a64-try-clear-flag (st) =
   let st1 = a64-emit-li st a64-x9 a64-try-fail-flag-addr
   in let st2 = a64-emit-li st1 a64-x10 0
   in a64-emit st2 (arm64-str a64-x10 a64-x9 0)

  a64-emit-try-body-stmts : A64State, List IRActStmt, Integer, Integer, Integer -> A64EmitResult
  a64-emit-try-body-stmts (st) (stmts) (i) (len) (body-failed-idx) =
   if i == len then A64EmitResult { state = st, reg = a64-x0 }
   else when list-at stmts i
    is IrDoBind (name) (ty) (expr) (s) ->
     let er = a64-emit-expr (a64-set-tail-pos st False) expr
     in let loc = a64-alloc-local (er.state)
     in let st1 = a64-store-local (loc.state) (loc.reg) (er.reg)
     in let st2 = a64-bind-local st1 name (loc.reg)
     in let st3 = a64-try-check-flag st2 body-failed-idx
     in a64-emit-try-body-stmts st3 stmts (i + 1) len body-failed-idx
    is IrDoExec (expr) (s) ->
     let r = a64-emit-expr (a64-set-tail-pos st False) expr
     in let st1 = a64-try-check-flag (r.state) body-failed-idx
     in if i == len - 1 then A64EmitResult { state = st1, reg = r.reg }
     else a64-emit-try-body-stmts st1 stmts (i + 1) len body-failed-idx

  a64-emit-try : A64State, Integer, List IRActStmt, List IRActStmt, List IRActStmt -> A64EmitResult
  a64-emit-try (st) (max) (body) (fb) (fail) =
   let counter-loc = a64-alloc-local st
   in let st1 = a64-emit-li (counter-loc.state) a64-x0 0
   in let st2 = a64-store-local st1 (counter-loc.reg) a64-x0
   in let heap-loc = a64-alloc-local st2
   in let st3 = a64-emit (heap-loc.state) (arm64-mov a64-x0 a64-heap-reg)
   in let st4 = a64-store-local st3 (heap-loc.reg) a64-x0
   in let retry-idx = st4.insn-count
   in let st5 = a64-try-clear-flag st4
   in let ld-heap = a64-load-local st5 (heap-loc.reg)
   in let st6 = a64-emit (ld-heap.state) (arm64-mov a64-heap-reg (ld-heap.reg))
   in let jmp-over-idx = st6.insn-count
   in let st7 = a64-emit st6 arm64-nop
   in let body-failed-idx = st7.insn-count
   in let ld-ctr = a64-load-local st7 (counter-loc.reg)
   in let st8 = a64-emit (ld-ctr.state) (arm64-add-imm (ld-ctr.reg) (ld-ctr.reg) 1)
   in let st9 = a64-store-local st8 (counter-loc.reg) (ld-ctr.reg)
   in let ld-ctr2 = a64-load-local st9 (counter-loc.reg)
   in let st10 = a64-emit (ld-ctr2.state) (arm64-cmp-imm (ld-ctr2.reg) max)
   in let blt-retry-idx = st10.insn-count
   in let st11 = a64-emit st10 arm64-nop
   in let jmp-exhaust-idx = st11.insn-count
   in let st12 = a64-emit st11 arm64-nop
   in let body-start-idx = st12.insn-count
   in let st13 = a64-patch-insn st12 jmp-over-idx (arm64-b ((body-start-idx - jmp-over-idx) * 4))
   in let st14 = a64-patch-insn st13 blt-retry-idx (arm64-b-cond 11 ((retry-idx - blt-retry-idx) * 4))
   in let try-locals = list-length (st14.locals)
   in let body-result = a64-emit-try-body-stmts st14 body 0 (list-length body) body-failed-idx
   in let jmp-success-idx = (body-result.state).insn-count
   in let st15 = a64-emit (a64-restore-locals (body-result.state) try-locals) arm64-nop
   in let exhaust-idx = st15.insn-count
   in let st16 = a64-patch-insn st15 jmp-exhaust-idx (arm64-b ((exhaust-idx - jmp-exhaust-idx) * 4))
   in let st-fb = if list-length fb > 0
     then let fb-clear = a64-try-clear-flag st16
       in let fb-result = a64-emit-act-loop fb-clear fb 0 a64-xzr
       in let st-fc = a64-emit-li (a64-restore-locals (fb-result.state) try-locals) a64-x9 a64-try-fail-flag-addr
       in let st-fl = a64-emit st-fc (arm64-ldr a64-x9 a64-x9 0)
       in let cbnz-fail-idx = st-fl.insn-count
       in let st-fj = a64-emit st-fl arm64-nop
       in A64EmitResult { state = st-fj, reg = fb-result.reg }
     else A64EmitResult { state = st16, reg = a64-x0 }
   in let jmp-end-fb-idx = (st-fb.state).insn-count
   in let st17 = a64-emit (st-fb.state) arm64-nop
   in let st-fail = if list-length fail > 0
     then let fail-idx = st17.insn-count
       in let st-pfb = if list-length fb > 0 then a64-patch-insn st17 (jmp-end-fb-idx - 1) (arm64-cbnz a64-x9 ((fail-idx - (jmp-end-fb-idx - 1)) * 4)) else st17
       in let fail-clear = a64-try-clear-flag st-pfb
       in let fail-result = a64-emit-act-loop fail-clear fail 0 a64-xzr
       in A64EmitResult { state = a64-restore-locals (fail-result.state) try-locals, reg = fail-result.reg }
     else st-fb
   in let end-idx = (st-fail.state).insn-count
   in let st18 = a64-patch-insn (st-fail.state) jmp-success-idx (arm64-b ((end-idx - jmp-success-idx) * 4))
   in let st19 = a64-patch-insn st18 jmp-end-fb-idx (arm64-b ((end-idx - jmp-end-fb-idx) * 4))
   in A64EmitResult { state = st19, reg = st-fail.reg }

  a64-known-arity : Text -> Integer
  a64-known-arity (name) =
   if name == "list-at" then 2
   else if name == "list-push" then 2
   else if name == "list-set-at" then 3
   else if name == "list-insert-at" then 3
   else if name == "list-cons" then 2
   else if name == "list-append" then 2
   else if name == "par-map" then 2
   else if name == "par-filter" then 2
   else if name == "par-reduce" then 3
   else if name == "math-mod" then 2
   else if name == "int-mod" then 2
   else if name == "par-zip-with" then 3
   else 0

  a64-take-args : List IRExpr, Integer, Integer, List IRExpr -> List IRExpr
  a64-take-args (args) (i) (n) (acc) =
   if i >= n then acc
   else a64-take-args args (i + 1) n (list-push acc (list-at args i))

  a64-drop-args : List IRExpr, Integer, List IRExpr -> List IRExpr
  a64-drop-args (args) (i) (acc) =
   if i >= list-length args then acc
   else a64-drop-args args (i + 1) (list-push acc (list-at args i))

  a64-emit-oversaturated-call : A64State, Text, List IRExpr, Integer -> A64EmitResult
  a64-emit-oversaturated-call (st) (name) (args) (arity) =
   let fn-args = a64-take-args args 0 arity []
   in let extra-args = a64-drop-args args arity []
   in let fr = a64-emit-direct-call st name fn-args
   in a64-emit-closure-call-from-reg (fr.state) (fr.reg) extra-args

Section: Apply

 The ops `a64-emit-seed-fs-handlers` installs a default handler for at
 boot. Their slots are written before `opening` runs, so routing them
 through the handler table is not the `blr 0` that the guard on the bare
 name path exists to prevent, and a program that declares no handler of
 its own still gets a serviced read.

  a64-op-has-default-handler : Text -> Boolean
  a64-op-has-default-handler (name) =
   if name == "read-text" then True else name == "write-file"

  a64-emit-apply : A64State, IRExpr, CodexType -> A64EmitResult
  a64-emit-apply (st) (expr) (ty) =
   let chain = collect-apply-chain expr []
   in let func = chain.root
   in let args = chain.args
   in when func
    is IrName (name) (fty) (s) ->
     if st.tco.active & st.tco.in-tail-pos & name == st.tco.current-func
     then a64-emit-tail-call st args
     else let st-nt = a64-set-tail-pos st False
     in if ((st.extra).deck-record-intrinsic) & name == "deck-record" & list-length args == 1
      then a64-emit-deck-record-wrapper st-nt (list-at args 0)
     else if name == "vec-splat" & list-length args == 1
      then a64-emit-vec-splat st-nt (list-at args 0) ty
     else if name == "show" & list-length args == 1
      then when a64-strip-unit-ty (ir-expr-type (list-at args 0))
       is BooleanTy -> a64-emit-show-bool st-nt (list-at args 0)
       is TextTy -> a64-emit-expr st-nt (list-at args 0)
       is CharTy -> a64-emit-single-arg-call st-nt "char-to-text" (list-at args 0)
       is RealTy (rw) (rm) ->
        if is-width-f32 rw then a64-emit-show-real-approx st-nt (list-at args 0)
        else a64-emit-single-arg-call st-nt "__real_to_text" (list-at args 0)
       is ListTy (et) -> a64-emit-text-lit st-nt "<list>"
       is RecordTy (rn) (ra) (rf) -> a64-emit-text-lit st-nt "<record>"
       is otherwise -> a64-emit-single-arg-call st-nt "integer-to-text" (list-at args 0)
     else if name == "math-mod" & list-length args == 2 then a64-emit-int-mod st-nt (list-at args 0) (list-at args 1)
     else if name == "int-mod" & list-length args == 2 then a64-emit-int-mod st-nt (list-at args 0) (list-at args 1)
     else let eff-addrs = (st.extra).effect-op-addrs
     in let local-reg = a64-lookup-local (st.locals) name 0
     in if local-reg >= 0 then
      let func-arity = a64-find-func-arity (st-nt.func-names) (st-nt.func-arities) name 0
      in if func-arity > 0 & list-length args > func-arity then a64-emit-closure-over-apply st-nt local-reg args func-arity
      else a64-emit-closure-call st-nt local-reg args
     else let known-arity = a64-known-arity name
      in if known-arity > 0 & list-length args > known-arity
      then a64-emit-oversaturated-call st-nt name args known-arity
      else if known-arity > 0 & list-length args == known-arity
      then a64-emit-direct-call st-nt name args
      else when ty
       is SumTy (sname) (targs) (ctors) ->
        let tag = a64-resolve-ctor-tag st ty name
        in if tag >= 0 then a64-emit-sum-ctor st-nt args tag
        else a64-emit-direct-call st-nt name args
       is ConstructedTy (tname) (targs) ->
        let tag = a64-find-ctor-in-type-defs ((st.extra).type-defs) (tname.value) name 0
        in if tag >= 0 then if list-length args == 0 then a64-emit-nullary-ctor st-nt tag
          else a64-emit-sum-ctor st-nt args tag
        else a64-emit-direct-call st-nt name args
       is FunTy (pt) (fnrow) (rt) -> a64-emit-partial-application st-nt name args (list-length args + 1 + a64-type-arity rt)
       is otherwise ->
        let eoa = a64-find-effect-op-addr ((st-nt.extra).effect-op-addrs) name 0
        in let handler-name = "__handler_" & name
        in let has-handler = a64-find-func-offset (st-nt.func-names) (st-nt.func-offsets) handler-name 0
        in if eoa >= 0 & (has-handler >= 0 | a64-op-has-default-handler name) then a64-emit-effect-op-call st-nt eoa args
        else if has-handler >= 0 then a64-emit-direct-call st-nt handler-name args
        else a64-emit-direct-call st-nt name args
    is otherwise ->
     let fr = a64-emit-expr (a64-set-tail-pos st False) func
     in a64-emit-closure-call-from-reg st (fr.reg) args

  a64-emit-record-set-builtin : A64State, List IRExpr -> A64EmitResult
  a64-emit-record-set-builtin (st) (args) =
   let rr = a64-emit-expr st (list-at args 0)
   in let rl = a64-alloc-local (rr.state)
   in let st1 = a64-store-local (rl.state) (rl.reg) (rr.reg)
   in let field-name = when list-at args 1
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in let field-index = a64-find-field-index-st st (ir-expr-type (list-at args 0)) field-name
   in let safe-index = if field-index >= 0 then field-index else 0
   in let vr = a64-emit-expr st1 (list-at args 2)
   in let lr = a64-load-local (vr.state) (rl.reg)
   in let st2 = a64-emit (lr.state) (arm64-str (vr.reg) (lr.reg) (safe-index * 8))
   in A64EmitResult { state = st2, reg = lr.reg }

  a64-collect-ir-names : IRExpr, List Text -> List Text
  a64-collect-ir-names (expr) (acc) =
   when expr
    is IrName (n) (ty) (s) -> if a64-text-in-list n acc 0 then acc else list-push acc n
    is IrApply (f) (a) (ty) (s) -> a64-collect-ir-names a (a64-collect-ir-names f acc)
    is IrBinary (op) (l) (r) (ty) (s) -> a64-collect-ir-names r (a64-collect-ir-names l acc)
    is IrLet (n) (t) (v) (b) (s) -> a64-collect-ir-names b (a64-collect-ir-names v acc)
    is IrIf (c) (th) (el) (t) (s) -> a64-collect-ir-names el (a64-collect-ir-names th (a64-collect-ir-names c acc))
    is IrLambda (p) (b) (t) (s) -> a64-collect-ir-names b acc
    is IrMatch (sc) (bs) (t) (s) -> a64-collect-ir-names sc acc
    is IrFieldAccess (rec) (f) (t) (s) -> a64-collect-ir-names rec acc
    is IrFieldStore (rec) (f) (v) (t) (s) -> a64-collect-ir-names v (a64-collect-ir-names rec acc)
    is IrRecord (n) (fields) (t) (s) -> a64-collect-ir-names-fields fields 0 acc
    is otherwise -> acc

  a64-collect-ir-names-fields : List IRFieldVal, Integer, List Text -> List Text
  a64-collect-ir-names-fields (fields) (i) (acc) =
   if i >= list-length fields then acc
   else a64-collect-ir-names-fields fields (i + 1) (a64-collect-ir-names ((list-at fields i).value) acc)

  a64-text-in-list : Text, List Text, Integer -> Boolean
  a64-text-in-list (t) (xs) (i) =
   if i >= list-length xs then False
   else if list-at xs i == t then True
   else a64-text-in-list t xs (i + 1)

  a64-param-names-loop : List IRParam, Integer, List Text -> List Text
  a64-param-names-loop (params) (i) (acc) =
   if i >= list-length params then acc
   else a64-param-names-loop params (i + 1) (list-push acc (list-at params i).name)

  a64-find-captures-loop : List Text, Integer, List A64Local, List Text, List A64Local -> List A64Local
  a64-find-captures-loop (free-names) (i) (outer-locals) (param-names) (acc) =
   if i >= list-length free-names then acc
   else let name = list-at free-names i
   in if a64-text-in-list name param-names 0 then a64-find-captures-loop free-names (i + 1) outer-locals param-names acc
   else let reg = a64-lookup-local outer-locals name 0
   in if reg >= 0 then a64-find-captures-loop free-names (i + 1) outer-locals param-names (list-push acc (A64Local { name = name, reg = __narrow reg }))
   else a64-find-captures-loop free-names (i + 1) outer-locals param-names acc

  a64-emit-lambda : A64State, List IRParam, IRExpr -> A64EmitResult
  a64-emit-lambda (st) (params) (body) =
   let free-names = a64-collect-ir-names body []
   in let pnames = a64-param-names-loop params 0 []
   in let captures = a64-find-captures-loop free-names 0 (st.locals) pnames []
   in let num-captures = list-length captures
   in if num-captures > 0 then a64-emit-lambda-with-captures st params body captures
   else a64-emit-lambda-simple st params body

  a64-emit-lambda-simple : A64State, List IRParam, IRExpr -> A64EmitResult
  a64-emit-lambda-simple (st) (params) (body) =
   let jmp-over-index = st.insn-count
   in let st1 = a64-emit st arm64-nop
   in let saved-locals = st1.locals
   in let saved-nl = st1.next-local
   in let saved-nt = st1.next-temp
   in let saved-spill = st1.spill-count
   in let st2 = __record-set (__record-set st1 "locals" []) "next-local" a64-x19
   in let st3 = __record-set (__record-set st2 "next-temp" a64-x12) "spill-count" 0
   in let prologue-idx = st3.insn-count
   in let st3a = a64-emit-prologue st3 5
   in let st4 = a64-bind-params st3a params 0
   in let er = a64-emit-expr st4 body
   in let st5 = if er.reg == a64-x0 then er.state
    else a64-emit (er.state) (arm64-mov a64-x0 (er.reg))
   in let frame-size = a64-compute-frame-size (st5.spill-count)
   in let st5a = a64-patch-frame-at st5 prologue-idx frame-size
   in let st6 = a64-emit-epilogue st5a frame-size 5
   in let after-body = st6.insn-count
   in let st7 = a64-patch-insn st6 jmp-over-index (arm64-b ((after-body - jmp-over-index) * 4))
   in let st8 = __record-set (__record-set (__record-set (__record-set st7 "locals" saved-locals) "next-local" saved-nl) "next-temp" saved-nt) "spill-count" saved-spill
   in let num-params = list-length params
   in let ptr-r = a64-alloc-temp st8
   in let st9 = a64-emit (ptr-r.state) (arm64-mov (ptr-r.reg) a64-heap-reg)
   in let st10 = a64-emit st9 (arm64-add-imm a64-heap-reg a64-heap-reg 16)
   in let ptr-loc = a64-alloc-local st10
   in let st11 = a64-store-local (ptr-loc.state) (ptr-loc.reg) (ptr-r.reg)
   in let adr-offset = ((jmp-over-index + 1) - st11.insn-count) * 4
   in let st12 = a64-emit st11 (a64-encode-adr-signed a64-x9 adr-offset)
   in let pl = a64-load-local st12 (ptr-loc.reg)
   in let st13 = a64-emit (pl.state) (arm64-str a64-x9 (pl.reg) 0)
   in let arity-r = a64-alloc-temp st13
   in let st14 = a64-emit-li (arity-r.state) (arity-r.reg) num-params
   in let pl2 = a64-load-local st14 (ptr-loc.reg)
   in let st15 = a64-emit (pl2.state) (arm64-str (arity-r.reg) (pl2.reg) 8)
   in a64-load-local st15 (ptr-loc.reg)

  a64-emit-lambda-with-captures : A64State, List IRParam, IRExpr, List A64Local -> A64EmitResult
  a64-emit-lambda-with-captures (st) (params) (body) (captures) =
   let num-captures = list-length captures
   in let num-params = list-length params
   in let saved-locals = st.locals
   in let saved-nl = st.next-local
   in let saved-nt = st.next-temp
   in let saved-spill = st.spill-count
   in let jmp-over-index = st.insn-count
   in let st1 = a64-emit st arm64-nop
   in let tramp-index = st1.insn-count
   in let st2 = a64-tramp-shift-args st1 7 num-captures
   in let st3 = a64-tramp-load-captures st2 0 num-captures
   in let func-index = st3.insn-count
   in let st3a = __record-set (__record-set st3 "locals" []) "next-local" a64-x19
   in let st3b = __record-set (__record-set st3a "next-temp" a64-x12) "spill-count" 0
   in let prologue-idx = st3b.insn-count
   in let st3c = a64-emit-prologue st3b 5
   in let st4 = a64-bind-capture-params st3c captures 0
   in let st4a = a64-bind-params-at st4 params 0 num-captures
   in let er = a64-emit-expr st4a body
   in let st5 = if er.reg == a64-x0 then er.state
    else a64-emit (er.state) (arm64-mov a64-x0 (er.reg))
   in let frame-size = a64-compute-frame-size (st5.spill-count)
   in let st5a = a64-patch-frame-at st5 prologue-idx frame-size
   in let st6 = a64-emit-epilogue st5a frame-size 5
   in let after-body = st6.insn-count
   in let st7 = a64-patch-insn st6 jmp-over-index (arm64-b ((after-body - jmp-over-index) * 4))
   in let st8 = __record-set (__record-set (__record-set (__record-set st7 "locals" saved-locals) "next-local" saved-nl) "next-temp" saved-nt) "spill-count" saved-spill
   in let closure-size = (2 + num-captures) * 8
   in let ptr-r = a64-alloc-temp st8
   in let st9 = a64-emit (ptr-r.state) (arm64-mov (ptr-r.reg) a64-heap-reg)
   in let st10 = a64-emit st9 (arm64-add-imm a64-heap-reg a64-heap-reg closure-size)
   in let ptr-loc = a64-alloc-local st10
   in let st11 = a64-store-local (ptr-loc.state) (ptr-loc.reg) (ptr-r.reg)
   in let adr-offset = (tramp-index - st11.insn-count) * 4
   in let st12 = a64-emit st11 (a64-encode-adr-signed a64-x9 adr-offset)
   in let pl = a64-load-local st12 (ptr-loc.reg)
   in let st13 = a64-emit (pl.state) (arm64-str a64-x9 (pl.reg) 0)
   in let arity-r = a64-alloc-temp st13
   in let st13a = a64-emit-li (arity-r.state) (arity-r.reg) (list-length params)
   in let pl1a = a64-load-local st13a (ptr-loc.reg)
   in let st13b = a64-emit (pl1a.state) (arm64-str (arity-r.reg) (pl1a.reg) 8)
   in let st14 = a64-emit-lambda-store-captures st13b captures (ptr-loc.reg) 0
   in a64-load-local st14 (ptr-loc.reg)

  a64-emit-lambda-store-captures : A64State, List A64Local, Integer, Integer -> A64State
  a64-emit-lambda-store-captures (st) (captures) (ptr-local) (i) =
   if i >= list-length captures then st
   else let cap = list-at captures i
   in let vr = a64-load-local st (cap.reg)
   in let pr = a64-load-local (vr.state) ptr-local
   in let st1 = a64-emit (pr.state) (arm64-str (vr.reg) (pr.reg) (16 + i * 8))
   in a64-emit-lambda-store-captures st1 captures ptr-local (i + 1)

  a64-emit-show-bool : A64State, IRExpr -> A64EmitResult
  a64-emit-show-bool (st) (arg) =
   let vr = a64-emit-expr st arg
   in let cbz-index = (vr.state).insn-count
   in let st1 = a64-emit (vr.state) (arm64-cbz (vr.reg) 0)
   in let true-r = a64-emit-text-lit st1 "True"
   in let loc = a64-alloc-local (true-r.state)
   in let st2 = a64-store-local (loc.state) (loc.reg) (true-r.reg)
   in let jmp-end-index = st2.insn-count
   in let st3 = a64-emit st2 (arm64-b 0)
   in let else-start = st3.insn-count
   in let false-r = a64-emit-text-lit st3 "False"
   in let st4 = a64-store-local (false-r.state) (loc.reg) (false-r.reg)
   in let end-index = st4.insn-count
   in let st5 = a64-patch-insn st4 cbz-index (arm64-cbz (vr.reg) ((else-start - cbz-index) * 4))
   in let st6 = a64-patch-insn st5 jmp-end-index (arm64-b ((end-index - jmp-end-index) * 4))
   in a64-load-local st6 (loc.reg)

  a64-emit-single-arg-call : A64State, Text, IRExpr -> A64EmitResult
  a64-emit-single-arg-call (st) (name) (arg) =
   let st1 = a64-emit-expr-to st arg a64-x0
   in let st2 = a64-emit-call-to st1 name
   in A64EmitResult { state = st2, reg = a64-x0 }

  a64-emit-trivial-args : A64State, List IRExpr, List Integer, Integer -> A64State
  a64-emit-trivial-args (st) (args) (locals) (i) =
   if i >= list-length locals then st
   else if i >= 8 then st
   else if list-at locals i >= 0 then a64-emit-trivial-args st args locals (i + 1)
   else let st1 = a64-emit-expr-to st (list-at args i) (a64-x0 + i)
   in a64-emit-trivial-args st1 args locals (i + 1)

  a64-add-shadow-warning : A64State, Text -> A64State
  a64-add-shadow-warning (st) (msg) =
   __record-set st "extra" (__record-set (st.extra) "wcet-reports" (list-push ((st.extra).wcet-reports) msg))

  a64-emit-unsupported-read : A64State, Text -> A64EmitResult
  a64-emit-unsupported-read (st) (name) =
   let msg = "[UNSUPPORTED] " & name & ": arm64 has no filesystem, and a read cannot be served"
   in a64-emit-empty-text (a64-add-shadow-warning st msg)

 Port I/O is the same refusal for a different reason. The port builtins
 are the x86 IN and OUT instructions, and gpu-in / gpu-out /
 gpu-mem-read / gpu-mem-write are the codex-vm GPU behind them; a
 Renode board has neither the instruction nor the device, and neither
 is wanted here (decided 2026-07-23). Before this arm
 existed these calls fell through to the unresolved-call hole: a port
 write silently did nothing and a port read answered whatever was in
 the result register, which is how cap-block-denied printed a heap
 address where a refusal sentinel belongs. The arms match on the name
 alone, no arity gate, so a partial application refuses too.
 codex/test/cross-port-refused pins that the refusal fires.

  a64-emit-unsupported-port : A64State, Text -> A64EmitResult
  a64-emit-unsupported-port (st) (name) =
   let msg = "[UNSUPPORTED] " & name & ": x86 port I/O and the codex-vm gpu do not exist on this target (refused by design)"
   in a64-emit-int-lit (a64-add-shadow-warning st msg) 0

 The x86 CPU-state builtins, refused for the same reason and named
 separately because the reason is a different one to state. A control
 register and CPUID are x86 architecture, not devices: AArch64 has system
 registers reached through MRS and an ID register space that answers
 different questions entirely, so there is no honest translation and no
 value worth inventing. A refusal here is what stops a call to a symbol
 this runtime has never heard of, which is how the list intrinsics failed
 silently on this lane until main 11280.

  a64-emit-unsupported-cpu : A64State, Text -> A64EmitResult
  a64-emit-unsupported-cpu (st) (name) =
   let msg = "[UNSUPPORTED] " & name & ": x86 control registers and CPUID do not exist on this target (refused by design)"
   in a64-emit-int-lit (a64-add-shadow-warning st msg) 0

 Before this arm they fell through the dispatch tail to a plain call to
 an undefined symbol. Measured on codex/test/list-pattern: the compile
 reported OK and every line of the program then faulted
 (!A64FAULT ESR=0x02000000, an illegal instruction). That is worse than
 the port hole it resembles, because a length that answers garbage
 selects the wrong arm and the whole match is decided by it.

  a64-emit-unsupported-list : A64State, Text -> A64EmitResult
  a64-emit-unsupported-list (st) (name) =
   let msg = "[UNSUPPORTED] " & name & ": builtin-List pattern matching is not implemented on arm64 (refused rather than miscompiled)"
   in a64-emit-int-lit (a64-add-shadow-warning st msg) 0

 UEFI boot services are x86 firmware reached through the system table, and
 uefi-read-key reads the PS/2 key cell that the IRQ1 handler fills from
 port 0x60. Neither the table nor the port exists on this target, so there
 is no value to invent: an idle 0 would be indistinguishable from a real
 read and would make a keyboard test pass by construction.

  a64-emit-unsupported-firmware : A64State, Text -> A64EmitResult
  a64-emit-unsupported-firmware (st) (name) =
   let msg = "[UNSUPPORTED] " & name & ": x86 UEFI firmware and the PS/2 key cell do not exist on this target (refused by design)"
   in a64-emit-int-lit (a64-add-shadow-warning st msg) 0

 The subjects are the names emitted AFTER the runtime, and the set they are
 checked against is the names the runtime itself recorded. Both come from
 `func-names`, split at `runtime-funcs`, which `a64-emit-module` already
 stores as the length of that list the moment `a64-emit-runtime` returns.
 Nothing is written down twice, so a helper added to `Arm64Runtime` is
 covered the day it is added.

 It used to ask `a64-is-known-builtin`, a hand-written chain of 126 string
 equalities. Measured 2026-08-16: the runtime registers 104 names and 85 of
 them were absent from that chain, including `peek-16`, `poke-16` and every
 MMIO, process and system-register accessor, so the overlap was 19 of 104.
 `VirtioPci` defining `poke-16` in Codex left the correct `strh` helper
 unreachable and drew no warning at all, while the same build printed twelve
 warnings -- and every one of those twelve was the check reading the
 RUNTIME's own registrations back out of `func-names` and reporting them as
 user code. Starting at `runtime-funcs` is what makes a hit mean something.

 A record FIELD sharing a helper's name cannot reach here, so nothing
 excludes it: `func-names` holds emitted functions, and a field is never
 one. That trap belongs to a source-text census, not to this check.

  a64-name-in-prefix : List Text, Integer, Integer, Text -> Integer
  a64-name-in-prefix (names) (i) (limit) (want) =
   if i >= limit then 0
   else if list-at names i == want then 1
   else a64-name-in-prefix names (i + 1) limit want

  a64-check-builtin-collisions : A64State, List Text, Integer -> A64State
  a64-check-builtin-collisions (st) (names) (i) =
   let rt = (st.extra).runtime-funcs
   in a64-check-collisions-loop st names (if i < rt then rt else i) rt

  a64-check-collisions-loop : A64State, List Text, Integer, Integer -> A64State
  a64-check-collisions-loop (st) (names) (i) (rt) =
   if i >= list-length names then st
   else let name = list-at names i
   in if a64-name-in-prefix names 0 rt name == 1
    then let warn = "[WARN] user function '" & name & "' shadows the ARM64 runtime helper of the same name; the helper is unreachable"
    in a64-check-collisions-loop (a64-add-shadow-warning st warn) names (i + 1) rt
    else a64-check-collisions-loop st names (i + 1) rt

  a64-emit-user-fn-call : A64State, Text, List IRExpr -> A64EmitResult
  a64-emit-user-fn-call (st) (name) (args) =
   if list-length args == 1 then a64-emit-single-arg-call st name (list-at args 0)
   else let saved-nl = st.next-local
   in let saved = a64-save-args st args 0 []
   in let num-stack-args = if list-length args > 8 then list-length args - 8 else 0
   in let stack-size = if num-stack-args > 0 then a64-align-16 (num-stack-args * 8) else 0
   in let st1 = a64-move-args-to-regs (saved.state) (saved.locals) 0
   in let st2 = a64-emit-trivial-args st1 args (saved.locals) 0
   in let st2a = a64-push-stack-args-pre st2 (saved.locals) 8 (list-length args) stack-size
   in let st3 = a64-emit-call-to st2a name
   in let st3a = if stack-size > 0 then a64-emit st3 (arm64-add-imm a64-sp a64-sp stack-size) else st3
   in let st4 = __record-set st3a "next-local" saved-nl
   in A64EmitResult { state = st4, reg = a64-x0 }

 This is the helper-versus-arm precedence table and nothing else: a name here
 that the runtime registers is called by NAME (its runtime helper), a registered
 name absent from it takes the emitter's arm. It is hand-written and it is
 load-bearing, measured 2026-08-17: deriving it as "every registered name" put
 eight arm64 bed answers wrong (goose-encode faulted, heap-frame-reclaim 43 to
 15), because arms that had never run went live. It is NOT the shadow list any
 more: whether a USER def wins is decided by `func-names` past `runtime-funcs`,
 below, and by `a64-check-builtin-collisions`.

  a64-helper-by-name : Text -> Integer
  a64-helper-by-name (name) =
   if name == "__narrow" then 1
   else if name == "address-of" then 1
   else if name == "__record-set" then 1
   else if name == "Refl" then 1
   else if name == "assume" then 1
   else if name == "sym" then 1
   else if name == "trans" then 1
   else if name == "cong" then 1
   else if name == "list-snoc" then 1
   else if name == "negate" then 1
   else if name == "abs" then 1
   else if name == "min" then 1
   else if name == "max" then 1
   else if name == "math-mod" then 1
   else if name == "fail" then 1
   else if name == "force" then 1
   else if name == "freeze" then 1
   else if name == "bit-not" then 1
   else if name == "bit-and" then 1
   else if name == "bit-or" then 1
   else if name == "bit-xor" then 1
   else if name == "bit-shr" then 1
   else if name == "bit-shl" then 1
   else if name == "bit-shru" then 1
   else if name == "print-line-raw" then 1
   else if name == "print-uni" then 1
   else if name == "print-error" then 1
   else if name == "print-error-uni" then 1
   else if name == "print-line" then 1
   else if name == "char-code-at" then 1
   else if name == "is-digit" then 1
   else if name == "is-letter" then 1
   else if name == "is-whitespace" then 1
   else if name == "char-code" then 1
   else if name == "code-to-char" then 1
   else if name == "integer-to-text" then 1
   else if name == "real-from-int" then 1
   else if name == "real-to-int" then 1
   else if name == "real-approx-from-int" then 1
   else if name == "real-approx-to-int" then 1
   else if name == "real-to-bits" then 1
   else if name == "bits-to-real" then 1
   else if name == "real-approx-to-bits" then 1
   else if name == "bits-to-real-approx" then 1
   else if name == "to-real-approx" then 1
   else if name == "from-real-approx" then 1
   else if name == "to-real-trapping" then 1
   else if name == "from-real-trapping" then 1
   else if name == "to-real-saturating" then 1
   else if name == "from-real-saturating" then 1
   else if name == "text-to-double-bits" then 1
   else if name == "suggested-vector-width" then 1
   else if name == "vec-extract" then 1
   else if name == "vec-reduce-add" then 1
   else if name == "vec-select" then 1
   else if name == "memory-fence" then 1
   else if name == "atomic-load" then 1
   else if name == "atomic-store" then 1
   else if name == "atomic-cas" then 1
   else if name == "atomic-add" then 1
   else if name == "atomic-exchange" then 1
   else if name == "run-state" then 1
   else if name == "set-state" then 1
   else if name == "get-state" then 1
   else if name == "__linked-list-empty" then 1
   else if name == "__linked-list-push" then 1
   else if name == "__linked-list-to-list" then 1
   else if name == "get-args" then 1
   else if name == "current-dir" then 1
   else if name == "file-exists" then 1
   else if name == "__memset" then 1
   else if name == "text-concat-list" then 1
   else if name == "__deck-pos" then 1
   else if name == "__deck-set" then 1
   else if name == "__deck-alloc" then 1
   else if name == "__deck-enter" then 1
   else if name == "__deck-exit" then 1
   else if name == "__list-with-capacity" then 1
   else if name == "vec-empty" then 1
   else if name == "vec-length" then 1
   else if name == "vec-head" then 1
   else if name == "vec-cons" then 1
   else if name == "vec-singleton" then 1
   else if name == "write-binary" then 1
   else if name == "read-line" then 1
   else if name == "read-line-cce" then 1
   else if name == "read-file" then 1
   else if name == "read-file-raw" then 1
   else if name == "read-file-uni" then 1
   else if name == "read-serial-cce" then 1
   else if name == "prof-start" then 1
   else if name == "prof-dump" then 1
   else if name == "__self-type-defs" then 1
   else if name == "uefi-read-file" then 1
   else if name == "port-in-byte" then 1
   else if name == "port-out-byte" then 1
   else if name == "port-in-16" then 1
   else if name == "port-out-16" then 1
   else if name == "port-in-32" then 1
   else if name == "port-out-32" then 1
   else if name == "gpu-in" then 1
   else if name == "gpu-out" then 1
   else if name == "gpu-mem-read" then 1
   else if name == "gpu-mem-write" then 1
   else if name == "text-replace" then 3
   else if name == "text-split" then 2
   else if name == "__buf-write-byte" then 3
   else if name == "__buf-read-bytes" then 3
   else if name == "__buf-write-bytes" then 3
   else if name == "chan-text-send" then 2
   else if name == "chan-text-recv" then 1
   else if name == "s-new" then 1
   else if name == "s-close" then 1
   else if name == "s-send" then 2
   else if name == "s-recv" then 1
   else if name == "s-recv-value" then 1
   else if name == "mask-any" then 1
   else if name == "mask-all" then 1
   else if name == "mask-none" then 1
   else if name == "mask-count" then 1
   else if name == "text-to-unicode-bytes" then 1
   else if name == "unicode-bytes-to-text" then 1
   else if name == "vec4-splat" then 1
   else if name == "vec4-extract" then 1
   else 0

  a64-emit-deck-pos : A64State -> A64EmitResult
  a64-emit-deck-pos (st) =
   let ar = a64-alloc-temp st
   in let st1 = a64-emit-li (ar.state) (ar.reg) a64-deck-pos-addr
   in let vr = a64-alloc-temp st1
   in A64EmitResult {
    state = a64-emit (vr.state) (arm64-ldr (vr.reg) (ar.reg) 0),
    reg = vr.reg
   }

  a64-emit-deck-set : A64State, IRExpr -> A64EmitResult
  a64-emit-deck-set (st) (arg) =
   let r = a64-emit-expr st arg
   in let ar = a64-alloc-temp (r.state)
   in let st1 = a64-emit-li (ar.state) (ar.reg) a64-deck-pos-addr
   in a64-emit-int-lit (a64-emit st1 (arm64-str (r.reg) (ar.reg) 0)) 0

  a64-emit-deck-alloc : A64State, IRExpr -> A64EmitResult
  a64-emit-deck-alloc (st) (arg) =
   let r = a64-emit-expr st arg
   in let ar = a64-alloc-temp (r.state)
   in let st1 = a64-emit-li (ar.state) (ar.reg) a64-deck-pos-addr
   in let pr = a64-alloc-temp st1
   in let st2 = a64-emit (pr.state) (arm64-ldr (pr.reg) (ar.reg) 0)
   in let nr = a64-alloc-temp st2
   in let st3 = a64-emit (nr.state) (arm64-add (nr.reg) (pr.reg) (r.reg))
   in A64EmitResult {
    state = a64-emit st3 (arm64-str (nr.reg) (ar.reg) 0),
    reg = pr.reg
   }

  a64-emit-deck-enter : A64State -> A64EmitResult
  a64-emit-deck-enter (st) =
   let cr = a64-alloc-temp st
   in let st1 = a64-emit-li (cr.state) (cr.reg) a64-deck-bound-counter-addr
   in let ov = a64-alloc-temp st1
   in let st2 = a64-emit (ov.state) (arm64-ldr (ov.reg) (cr.reg) 0)
   in let nv = a64-alloc-temp st2
   in let st3 = a64-emit (nv.state) (arm64-add-imm (nv.reg) (ov.reg) 1)
   in let st4 = a64-emit st3 (arm64-str (nv.reg) (cr.reg) 0)
   in let skip-index = st4.insn-count
   in let st5 = a64-emit st4 arm64-nop
   in let br = a64-alloc-temp st5
   in let st6 = a64-emit-li (br.state) (br.reg) a64-bivy-save-addr
   in let st7 = a64-emit st6 (arm64-str a64-heap-reg (br.reg) 0)
   in let dr = a64-alloc-temp st7
   in let st8 = a64-emit-li (dr.state) (dr.reg) a64-deck-pos-addr
   in let st9 = a64-emit st8 (arm64-ldr a64-heap-reg (dr.reg) 0)
   in let skip-label = st9.insn-count
   in a64-emit-int-lit (a64-patch-insn st9 skip-index (arm64-cbnz (ov.reg) ((skip-label - skip-index) * 4))) 0

  a64-emit-deck-exit : A64State -> A64EmitResult
  a64-emit-deck-exit (st) =
   let cr = a64-alloc-temp st
   in let st1 = a64-emit-li (cr.state) (cr.reg) a64-deck-bound-counter-addr
   in let cv = a64-alloc-temp st1
   in let st2 = a64-emit (cv.state) (arm64-ldr (cv.reg) (cr.reg) 0)
   in let st3 = a64-emit st2 (arm64-sub-imm (cv.reg) (cv.reg) 1)
   in let st4 = a64-emit st3 (arm64-str (cv.reg) (cr.reg) 0)
   in let skip-index = st4.insn-count
   in let st5 = a64-emit st4 arm64-nop
   in let dr = a64-alloc-temp st5
   in let st6 = a64-emit-li (dr.state) (dr.reg) a64-deck-pos-addr
   in let st7 = a64-emit st6 (arm64-str a64-heap-reg (dr.reg) 0)
   in let br = a64-alloc-temp st7
   in let st8 = a64-emit-li (br.state) (br.reg) a64-bivy-save-addr
   in let st9 = a64-emit st8 (arm64-ldr a64-heap-reg (br.reg) 0)
   in let skip-label = st9.insn-count
   in a64-emit-int-lit (a64-patch-insn st9 skip-index (arm64-cbnz (cv.reg) ((skip-label - skip-index) * 4))) 0

  a64-emit-deck-record-wrapper : A64State, IRExpr -> A64EmitResult
  a64-emit-deck-record-wrapper (st) (arg) =
   let enter = a64-emit-deck-enter st
   in let r = a64-emit-expr (a64-set-tail-pos (enter.state) False) arg
   in let sl = a64-alloc-local (r.state)
   in let st1 = a64-store-local (sl.state) (sl.reg) (r.reg)
   in let ex = a64-emit-deck-exit st1
   in a64-load-local (ex.state) (sl.reg)

  a64-emit-direct-call : A64State, Text, List IRExpr -> A64EmitResult
  a64-emit-direct-call (st) (name) (args) =
   let user-def = a64-find-name-index (st.func-names) name ((st.extra).runtime-funcs)
   in let helper = if user-def >= 0 then 0 - 1 else if a64-helper-by-name name == 1 then a64-find-func-offset (st.func-names) (st.func-offsets) name 0 else 0 - 1
   in if (user-def >= 0 | helper >= 0) & a64-is-inline-here name (list-length args) == False then a64-emit-user-fn-call st name args
   else if name == "__narrow" & list-length args == 1 then a64-emit-expr st (list-at args 0)
   else if name == "address-of" & list-length args == 1 then a64-emit-address-of st (list-at args 0)
   else if name == "__record-set" & list-length args == 3 then a64-emit-record-set-builtin st args
   else if name == "Refl" then a64-emit-int-lit st 0
   else if name == "assume" then a64-emit-int-lit st 0
   else if name == "sym" then a64-emit-int-lit st 0
   else if name == "trans" then a64-emit-int-lit st 0
   else if name == "cong" then a64-emit-int-lit st 0
   else if name == "list-snoc" & list-length args == 2 then a64-emit-direct-call st "list-push" args
   else if name == "negate" & list-length args == 1 then a64-emit-negate st (list-at args 0)
   else if name == "abs" & list-length args == 1 then a64-emit-abs st (list-at args 0)
   else if name == "min" & list-length args == 2 then a64-emit-min-max st args False
   else if name == "max" & list-length args == 2 then a64-emit-min-max st args True
   else if name == "math-mod" & list-length args == 2 then a64-emit-int-mod st (list-at args 0) (list-at args 1)
   else if name == "int-mod" & list-length args == 2 then a64-emit-int-mod st (list-at args 0) (list-at args 1)
   else if name == "fail" & list-length args == 1 then a64-emit-fail st args
   else if name == "force" & list-length args == 1 then a64-emit-force st (list-at args 0)
   else if name == "freeze" & list-length args == 1 then a64-emit-expr st (list-at args 0)
   else if name == "bit-not" & list-length args == 1 then a64-emit-bit-not st (list-at args 0)
   else if name == "bit-and" & list-length args == 2 then a64-emit-bit-binop st args 0
