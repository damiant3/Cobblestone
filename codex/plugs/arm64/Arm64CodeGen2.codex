  a64-align-16 : Integer -> Integer
  a64-align-16 (n) = if int-mod n 16 == 0 then n else n + 16 - int-mod n 16

  A64PreloadResult = record {
   state : A64State,
   preloaded : List Integer
  }

  a64-preload-stack-args : A64State, List Integer, Integer, Integer, List Integer -> A64PreloadResult
  a64-preload-stack-args (st) (locals) (i) (len) (acc) =
   if i >= len then A64PreloadResult { state = st, preloaded = acc }
   else let lr = a64-load-local st (list-at locals i)
   in let tr = a64-alloc-temp (lr.state)
   in let st1 = a64-emit (tr.state) (arm64-mov (tr.reg) (lr.reg))
   in a64-preload-stack-args st1 locals (i + 1) len (list-push acc (tr.reg))

  a64-store-preloaded-stack-args : A64State, List Integer, Integer -> A64State
  a64-store-preloaded-stack-args (st) (regs) (slot) =
   if slot >= list-length regs then st
   else let st1 = a64-emit st (arm64-str (list-at regs slot) a64-sp (slot * 8))
   in a64-store-preloaded-stack-args st1 regs (slot + 1)

  a64-push-stack-args-pre : A64State, List Integer, Integer, Integer, Integer -> A64State
  a64-push-stack-args-pre (st) (locals) (i) (len) (stack-size) =
   if stack-size <= 0 then st
   else let st0 = a64-load-stack-args-to-scratch st locals i len 0
   in let st1 = a64-emit st0 (arm64-sub-imm a64-sp a64-sp stack-size)
   in a64-store-scratch-to-stack st1 (len - i) 0

  a64-load-stack-args-to-scratch : A64State, List Integer, Integer, Integer, Integer -> A64State
  a64-load-stack-args-to-scratch (st) (locals) (i) (len) (slot) =
   if i >= len then st
   else let lr = a64-load-local st (list-at locals i)
   in let scratch = a64-x10 + slot
   in let st1 = a64-emit (lr.state) (arm64-mov scratch (lr.reg))
   in a64-load-stack-args-to-scratch st1 locals (i + 1) len (slot + 1)

  a64-store-scratch-to-stack : A64State, Integer, Integer -> A64State
  a64-store-scratch-to-stack (st) (count) (slot) =
   if slot >= count then st
   else let st1 = a64-emit st (arm64-str (a64-x10 + slot) a64-sp (slot * 8))
   in a64-store-scratch-to-stack st1 count (slot + 1)

  a64-push-stack-args : A64State, List Integer, Integer, Integer, Integer -> A64State
  a64-push-stack-args (st) (locals) (i) (len) (slot) =
   if i >= len then st
   else let lr = a64-load-local st (list-at locals i)
   in let st1 = a64-emit (lr.state) (arm64-str (lr.reg) a64-sp (slot * 8))
   in a64-push-stack-args st1 locals (i + 1) len (slot + 1)

  a64-emit-closure-call : A64State, Integer, List IRExpr -> A64EmitResult
  a64-emit-closure-call (st) (closure-local) (args) =
   if list-length args > 1 then a64-emit-closure-call-with-arity-check st closure-local args
   else let saved-nl = st.next-local
   in let saved = a64-save-args st args 0 []
   in let st1 = a64-move-args-to-regs (saved.state) (saved.locals) 0
   in let cl = a64-load-local st1 closure-local
   in let st2 = a64-emit (cl.state) (arm64-mov a64-x11 (cl.reg))
   in let st3 = a64-emit st2 (arm64-ldr a64-x9 a64-x11 0)
   in let st4 = a64-emit st3 (arm64-blr a64-x9)
   in let st5 = __record-set st4 "next-local" saved-nl
   in A64EmitResult { state = st5, reg = a64-x0 }

  a64-emit-closure-call-with-arity-check : A64State, Integer, List IRExpr -> A64EmitResult
  a64-emit-closure-call-with-arity-check (st) (closure-local) (args) =
   let num-args = list-length args
   in let cl0 = a64-load-local st closure-local
   in let st0 = a64-emit (cl0.state) (arm64-ldr a64-x10 (cl0.reg) 8)
   in let st1 = a64-emit-li st0 a64-x9 num-args
   in let st2 = a64-emit st1 (arm64-cmp a64-x10 a64-x9)
   in let bge-idx = st2.insn-count
   in let st3 = a64-emit st2 arm64-nop
   in let over-result = a64-emit-closure-over-apply st3 closure-local args 1
   in let jmp-end-idx = (over-result.state).insn-count
   in let st4 = a64-emit (over-result.state) arm64-nop
   in let direct-start = st4.insn-count
   in let direct = a64-emit-closure-call-direct st4 closure-local args
   in let done-label = (direct.state).insn-count
   in let st5 = a64-patch-insn (direct.state) bge-idx (arm64-b-cond 10 ((direct-start - bge-idx) * 4))
   in let st6 = a64-patch-insn st5 jmp-end-idx (arm64-b ((done-label - jmp-end-idx) * 4))
   in let result-loc = a64-alloc-local st6
   in let st7 = if over-result.reg == direct.reg then a64-store-local (result-loc.state) (result-loc.reg) (direct.reg)
    else a64-store-local (result-loc.state) (result-loc.reg) a64-x0
   in a64-load-local st7 (result-loc.reg)

  a64-emit-closure-call-direct : A64State, Integer, List IRExpr -> A64EmitResult
  a64-emit-closure-call-direct (st) (closure-local) (args) =
   let saved-nl = st.next-local
   in let saved = a64-save-args st args 0 []
   in let st1 = a64-move-args-to-regs (saved.state) (saved.locals) 0
   in let cl = a64-load-local st1 closure-local
   in let st2 = a64-emit (cl.state) (arm64-mov a64-x11 (cl.reg))
   in let st3 = a64-emit st2 (arm64-ldr a64-x9 a64-x11 0)
   in let st4 = a64-emit st3 (arm64-blr a64-x9)
   in let st5 = __record-set st4 "next-local" saved-nl
   in A64EmitResult { state = st5, reg = a64-x0 }

  a64-emit-chained-closure-call : A64State, Integer, List IRExpr, Integer -> A64EmitResult
  a64-emit-chained-closure-call (st) (closure-local) (args) (i) =
   if i >= list-length args then a64-load-local st closure-local
   else let cr = a64-emit-closure-call st closure-local [list-at args i]
   in if i + 1 >= list-length args then cr
   else let saved = a64-alloc-local (cr.state)
   in let st1 = a64-store-local (saved.state) (saved.reg) (cr.reg)
   in a64-emit-chained-closure-call st1 (saved.reg) args (i + 1)

  a64-emit-closure-over-apply : A64State, Integer, List IRExpr, Integer -> A64EmitResult
  a64-emit-closure-over-apply (st) (closure-local) (args) (arity) =
   let first-args = a64-take-args args 0 arity []
   in let cr = a64-emit-closure-call st closure-local first-args
   in a64-emit-over-apply-extras (cr.state) (cr.reg) args arity (list-length args)

  a64-emit-over-apply-extras : A64State, Integer, List IRExpr, Integer, Integer -> A64EmitResult
  a64-emit-over-apply-extras (st) (closure-reg) (args) (i) (len) =
   if i >= len then A64EmitResult { state = st, reg = closure-reg }
   else let cl-loc = a64-alloc-local st
   in let st0 = a64-store-local (cl-loc.state) (cl-loc.reg) closure-reg
   in let er = a64-emit-expr st0 (list-at args i)
   in let arg-loc = a64-alloc-local (er.state)
   in let st1 = a64-store-local (arg-loc.state) (arg-loc.reg) (er.reg)
   in let cl = a64-load-local st1 (cl-loc.reg)
   in let st2 = a64-emit (cl.state) (arm64-mov a64-x11 (cl.reg))
   in let st3 = a64-emit st2 (arm64-ldr a64-x9 a64-x11 0)
   in let al = a64-load-local st3 (arg-loc.reg)
   in let st4 = a64-emit (al.state) (arm64-mov a64-x0 (al.reg))
   in let st5 = a64-emit st4 (arm64-blr a64-x9)
   in a64-emit-over-apply-extras st5 a64-x0 args (i + 1) len

  a64-emit-closure-call-from-reg : A64State, Integer, List IRExpr -> A64EmitResult
  a64-emit-closure-call-from-reg (st) (closure-reg) (args) =
   let saved-nl = st.next-local
   in let cl-loc = a64-alloc-local st
   in let st0 = a64-store-local (cl-loc.state) (cl-loc.reg) closure-reg
   in let saved = a64-save-args st0 args 0 []
   in let st1 = a64-move-args-to-regs (saved.state) (saved.locals) 0
   in let cl = a64-load-local st1 (cl-loc.reg)
   in let st2 = a64-emit (cl.state) (arm64-mov a64-x11 (cl.reg))
   in let st3 = a64-emit st2 (arm64-ldr a64-x9 a64-x11 0)
   in let st4 = a64-emit st3 (arm64-blr a64-x9)
   in let st5 = __record-set st4 "next-local" saved-nl
   in A64EmitResult { state = st5, reg = a64-x0 }

  A64SavedArgs = record {
   state : A64State,
   locals : List Integer
  }

  a64-arg-is-trivial : IRExpr -> Boolean
  a64-arg-is-trivial (e) = False

  a64-save-args : A64State, List IRExpr, Integer, List Integer -> A64SavedArgs
  a64-save-args (st) (args) (i) (acc) =
   if i >= list-length args then A64SavedArgs { state = st, locals = acc }
   else if a64-arg-is-trivial (list-at args i) then a64-save-args st args (i + 1) (list-push acc (0 - 1))
   else let er = a64-emit-expr st (list-at args i)
   in let loc = a64-alloc-local (er.state)
   in let st1 = a64-store-local (loc.state) (loc.reg) (er.reg)
   in a64-save-args st1 args (i + 1) (list-push acc (loc.reg))

  a64-move-args-to-regs : A64State, List Integer, Integer -> A64State
  a64-move-args-to-regs (st) (locals) (i) =
   if i >= list-length locals then st
   else if i >= 8 then st
   else if list-at locals i < 0 then a64-move-args-to-regs st locals (i + 1)
   else let lr = a64-load-local st (list-at locals i)
   in let st1 = if lr.reg == a64-x0 + i then lr.state
    else a64-emit (lr.state) (arm64-mov (a64-x0 + i) (lr.reg))
   in a64-move-args-to-regs st1 locals (i + 1)

Section: Partial Application

  a64-tramp-shift-args : A64State, Integer, Integer -> A64State
  a64-tramp-shift-args (st) (i) (num-captures) =
   if i < 0 then st
   else if i + num-captures < 8 then a64-tramp-shift-args (a64-emit st (arm64-mov (a64-x0 + i + num-captures) (a64-x0 + i))) (i - 1) num-captures
   else a64-tramp-shift-args st (i - 1) num-captures

  a64-tramp-load-captures : A64State, Integer, Integer -> A64State
  a64-tramp-load-captures (st) (i) (num-captures) =
   if i >= num-captures then st
   else if i < 8 then a64-tramp-load-captures (a64-emit st (arm64-ldr (a64-x0 + i) a64-x11 (16 + i * 8))) (i + 1) num-captures
   else st

  a64-store-closure-captures : A64State, List Integer, Integer, Integer -> A64State
  a64-store-closure-captures (st) (cap-locals) (ptr-local) (i) =
   if i >= list-length cap-locals then st
   else let vr = a64-load-local st (list-at cap-locals i)
   in let pr = a64-load-local (vr.state) ptr-local
   in let st1 = a64-emit (pr.state) (arm64-str (vr.reg) (pr.reg) (16 + i * 8))
   in a64-store-closure-captures st1 cap-locals ptr-local (i + 1)

  a64-encode-adr-signed : Integer, Integer -> List Integer
  a64-encode-adr-signed (rd) (offset) =
   let o = if offset < 0 then offset + #200000 else offset
   in let immlo = bit-and o 3
   in let immhi = bit-and (bit-shru o 2) #7FFFF
   in let w = bit-or (bit-or (bit-or #10000000 rd) (bit-shl immlo 29)) (bit-shl immhi 5)
   in [bit-and w 255, bit-and (bit-shru w 8) 255, bit-and (bit-shru w 16) 255, bit-and (bit-shru w 24) 255]

  a64-emit-partial-application : A64State, Text, List IRExpr, Integer -> A64EmitResult
  a64-emit-partial-application (st) (func-name) (captured-args) (type-arity) =
   let saved = a64-save-args-all st captured-args 0 []
   in let num-captures = list-length captured-args
   in if num-captures == 0 then a64-emit-zero-capture-closure (saved.state) func-name type-arity
   else let jmp-over-index = saved.state.insn-count
   in let st1 = a64-emit (saved.state) arm64-nop
   in let tramp-index = st1.insn-count
   in let st2 = a64-tramp-shift-args st1 7 num-captures
   in let st3 = a64-tramp-load-captures st2 0 num-captures
   in let st4 = a64-emit-load-func-addr st3 a64-x9 func-name
   in let st5 = a64-emit st4 (arm64-br a64-x9)
   in let st6 = a64-patch-insn st5 jmp-over-index (arm64-b ((st5.insn-count - jmp-over-index) * 4))
   in let effective-arity = if type-arity > num-captures then type-arity - num-captures else 1
   in let closure-size = (2 + num-captures) * 8
   in let ptr-r = a64-alloc-temp st6
   in let st7 = a64-emit (ptr-r.state) (arm64-mov (ptr-r.reg) a64-heap-reg)
   in let st8 = a64-emit st7 (arm64-add-imm a64-heap-reg a64-heap-reg closure-size)
   in let ptr-loc = a64-alloc-local st8
   in let st9 = a64-store-local (ptr-loc.state) (ptr-loc.reg) (ptr-r.reg)
   in let adr-offset = (tramp-index - st9.insn-count) * 4
   in let st10 = a64-emit st9 (a64-encode-adr-signed a64-x9 adr-offset)
   in let pl = a64-load-local st10 (ptr-loc.reg)
   in let st11 = a64-emit (pl.state) (arm64-str a64-x9 (pl.reg) 0)
   in let arity-r = a64-alloc-temp st11
   in let st11a = a64-emit-li (arity-r.state) (arity-r.reg) effective-arity
   in let pl1 = a64-load-local st11a (ptr-loc.reg)
   in let st11b = a64-emit (pl1.state) (arm64-str (arity-r.reg) (pl1.reg) 8)
   in let st12 = a64-store-closure-captures st11b (saved.locals) (ptr-loc.reg) 0
   in a64-load-local st12 (ptr-loc.reg)

  a64-emit-zero-capture-closure : A64State, Text, Integer -> A64EmitResult
  a64-emit-zero-capture-closure (st) (func-name) (type-arity) =
   let target-arity = if type-arity > 0 then type-arity else a64-find-func-arity (st.func-names) (st.func-arities) func-name 0
   in let ptr-r = a64-alloc-temp st
   in let st1 = a64-emit (ptr-r.state) (arm64-mov (ptr-r.reg) a64-heap-reg)
   in let st2 = a64-emit st1 (arm64-add-imm a64-heap-reg a64-heap-reg 16)
   in let ptr-loc = a64-alloc-local st2
   in let st3 = a64-store-local (ptr-loc.state) (ptr-loc.reg) (ptr-r.reg)
   in let st4 = a64-emit-load-func-addr st3 a64-x9 func-name
   in let pl = a64-load-local st4 (ptr-loc.reg)
   in let st5 = a64-emit (pl.state) (arm64-str a64-x9 (pl.reg) 0)
   in let arity-r = a64-alloc-temp st5
   in let st5a = a64-emit-li (arity-r.state) (arity-r.reg) (if target-arity > 0 then target-arity else 1)
   in let pl2 = a64-load-local st5a (ptr-loc.reg)
   in let st5b = a64-emit (pl2.state) (arm64-str (arity-r.reg) (pl2.reg) 8)
   in a64-load-local st5b (ptr-loc.reg)

Section: Field Layout

  a64-field-byte-width : CodexType -> Integer
  a64-field-byte-width (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) ->
     if lo >= 0 then
      if hi <= 255 then 1
      else if hi <= 65535 then 2
      else if hi <= 4294967295 then 4
      else 8
     else
      if lo >= (0 - 128) & hi <= 127 then 1
      else if lo >= (0 - 32768) & hi <= 32767 then 2
      else if lo >= (0 - 2147483648) & hi <= 2147483647 then 4
      else 8
    is BooleanTy -> 1
    is UnitTy (n) (inner) -> a64-field-byte-width inner
    is otherwise -> 8

  a64-field-byte-signed : CodexType -> Boolean
  a64-field-byte-signed (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> lo < 0
    is UnitTy (n) (inner) -> a64-field-byte-signed inner
    is otherwise -> False

  a64-width-prefix : Integer -> Text
  a64-width-prefix (w) =
   if w == 8 then "1-"
   else if w == 4 then "2-"
   else if w == 2 then "3-"
   else "4-"

  a64-field-sort-key : RecordField -> Text
  a64-field-sort-key (f) =
   a64-width-prefix (a64-field-byte-width (f.type-val)) & (f.name.value)

  a64-find-target-type : List RecordField, Text, Integer -> CodexType
  a64-find-target-type (fields) (target) (i) =
   if i == list-length fields then ErrorTy
   else let f = list-at fields i
   in if f.name.value == target then f.type-val
   else a64-find-target-type fields target (i + 1)

  a64-accumulate-offset-width-sort : List RecordField, Text, Integer, Integer, Integer -> Integer
  a64-accumulate-offset-width-sort (fields) (target-name) (target-w) (i) (acc) =
   if i == list-length fields then acc
   else let f = list-at fields i
   in let f-w = a64-field-byte-width (f.type-val)
   in if f-w > target-w
      then a64-accumulate-offset-width-sort fields target-name target-w (i + 1) (acc + f-w)
      else if f-w == target-w & text-compare (f.name.value) target-name < 0
      then a64-accumulate-offset-width-sort fields target-name target-w (i + 1) (acc + f-w)
      else a64-accumulate-offset-width-sort fields target-name target-w (i + 1) acc

  A64FieldOffset = record {
   offset : Integer,
   width : Integer,
   signed : Boolean
  }

  a64-cce-byte-offset : List RecordField, Text -> A64FieldOffset
  a64-cce-byte-offset (fields) (target) =
   let target-ty = a64-find-target-type fields target 0
   in let target-w = a64-field-byte-width target-ty
   in let offset = a64-accumulate-offset-width-sort fields target target-w 0 0
   in A64FieldOffset { offset = offset, width = target-w, signed = a64-field-byte-signed target-ty }

  a64-record-byte-size : List RecordField, Integer, Integer -> Integer
  a64-record-byte-size (fields) (i) (acc) =
   if i >= list-length fields then (acc + 7) / 8 * 8
   else a64-record-byte-size fields (i + 1) (acc + a64-field-byte-width ((list-at fields i).type-val))

  a64-emit-narrow-store : A64State, Integer, Integer, Integer, Integer -> A64State
  a64-emit-narrow-store (st) (val-reg) (ptr-reg) (offset) (width) =
   if width == 1 then a64-emit st (arm64-strb val-reg ptr-reg offset)
   else if width == 2 then a64-emit st (arm64-str-w val-reg ptr-reg offset)
   else if width == 4 then a64-emit st (arm64-str-w val-reg ptr-reg offset)
   else a64-emit st (arm64-str val-reg ptr-reg offset)

  a64-emit-narrow-load : A64State, Integer, Integer, Integer, Integer, Boolean -> A64EmitResult
  a64-emit-narrow-load (st) (dst-reg) (ptr-reg) (offset) (width) (signed) =
   if width == 1 then A64EmitResult { state = a64-emit st (arm64-ldrb dst-reg ptr-reg offset), reg = dst-reg }
   else if width == 2 then A64EmitResult { state = a64-emit st (arm64-ldr-w dst-reg ptr-reg offset), reg = dst-reg }
   else if width == 4 then A64EmitResult { state = a64-emit st (arm64-ldr-w dst-reg ptr-reg offset), reg = dst-reg }
   else A64EmitResult { state = a64-emit st (arm64-ldr dst-reg ptr-reg offset), reg = dst-reg }

  a64-resolve-record-fields : A64State, CodexType -> List RecordField
  a64-resolve-record-fields (st) (ty) =
   when ty
    is RecordTy (rn) (tvars) (fields) ->
     if list-length fields > 0 then fields
     else a64-find-record-fields-in-defs ((st.extra).type-defs) (rn.value) 0
    is ConstructedTy (tname) (args) -> a64-find-record-fields-in-defs ((st.extra).type-defs) (tname.value) 0
    is TypeCon (tname) -> a64-find-record-fields-in-defs ((st.extra).type-defs) (tname.value) 0
    is otherwise -> []

  a64-find-record-fields-in-defs : List ATypeDef, Text, Integer -> List RecordField
  a64-find-record-fields-in-defs (defs) (name) (i) =
   if i >= list-length defs then []
   else when list-at defs i
    is ARecordTypeDef (dn) (tparams) (afields) (recmut) (sp) ->
     if dn.value == name then a64-afields-to-rfields afields 0
     else a64-find-record-fields-in-defs defs name (i + 1)
    is otherwise -> a64-find-record-fields-in-defs defs name (i + 1)

  a64-afields-to-rfields : List ARecordFieldDef, Integer -> List RecordField
  a64-afields-to-rfields (afields) (i) =
   if i >= list-length afields then []
   else let af = list-at afields i
   in let rty = a64-atype-to-codex-type (af.type-expr)
   in list-push (a64-afields-to-rfields afields (i + 1)) (RecordField { name = af.name, type-val = rty })

  a64-atype-to-codex-type : ATypeExpr -> CodexType
  a64-atype-to-codex-type (at) = atype-to-codex-type at

