Chapter: Python Emitter
  cites Foreword chapter Sort

Section: Keywords and Sanitization

  py-keywords : List Text =
   ["and", "as", "assert", "async", "await",
    "break", "class", "continue", "def", "del",
    "elif", "else", "except", "finally", "for",
    "from", "global", "if", "import", "in",
    "is", "lambda", "nonlocal", "not", "or",
    "pass", "raise", "return", "try", "type",
    "while", "with", "yield",
    "True", "False", "None"]

  is-py-keyword-loop : List Text, Text, Integer, Integer -> Boolean
  is-py-keyword-loop (kws) (name) (i) (len) =
   if i == len then False
   else if list-at kws i == name then True
   else is-py-keyword-loop kws name (i + 1) len

  is-py-keyword : Text -> Boolean
  is-py-keyword (name) = is-py-keyword-loop py-keywords name 0 (list-length py-keywords)

  py-sanitize : Text -> Text
  py-sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-py-keyword s then "_" & s
      else s

  py-slash-pos : Text, Integer, Integer -> Integer
  py-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else py-slash-pos f (i + 1) len

  py-field : Text -> Text
  py-field (f) =
   let slash = py-slash-pos f 0 (text-length f)
   in if slash >= 0 then py-sanitize (substring f 0 slash)
      else py-sanitize f

  py-escape-text : Text -> Text
  py-escape-text (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in let s3 = text-replace s2 "\n" "\\n"
   in s3

  py-indent : Integer -> Text
  py-indent (n) =
   if n <= 0 then ""
   else "    " & py-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  PyCtx = record {
   arities : List ArityEntry,
   type-defs : List ATypeDef
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Definition Emission

  emit-py-type-defs : List ATypeDef, Integer -> Text
  emit-py-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-py-type-def (list-at tds i) & emit-py-type-defs tds (i + 1)

  emit-py-type-def : ATypeDef -> Text
  emit-py-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     emit-py-record-type (name.value) fields recmut
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else emit-py-sum-type ctors
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-py-sum-type : List AVariantCtorDef -> Text
  emit-py-sum-type (ctors) =
   emit-py-sum-type-loop ctors 0 (list-length ctors)

  emit-py-sum-type-loop : List AVariantCtorDef, Integer, Integer -> Text
  emit-py-sum-type-loop (ctors) (i) (len) =
   if i == len then ""
   else let c = list-at ctors i
   in emit-py-ctor c & emit-py-sum-type-loop ctors (i + 1) len

  emit-py-ctor : AVariantCtorDef -> Text
  emit-py-ctor (c) =
   let name = py-sanitize (c.name.value)
   in if list-length (c.fields) == 0 then
    "@dataclass(frozen=True)\nclass " & name & ":\n    tag: str = \"" & c.name.value & "\"\n\n"
   else
    "@dataclass(frozen=True)\nclass " & name & ":\n" & emit-py-ctor-fields (c.fields) 0 & "    tag: str = \"" & c.name.value & "\"\n\n"

  emit-py-ctor-fields : List ATypeExpr, Integer -> Text
  emit-py-ctor-fields (fields) (i) =
   if i == list-length fields then ""
   else "    field" & integer-to-text i & ": Any = None\n" & emit-py-ctor-fields fields (i + 1)

  emit-py-record-type : Text, List ARecordFieldDef, Boolean -> Text
  emit-py-record-type (name) (fields) (recmut) =
   let sname = py-sanitize name
   in let deco = if recmut then "@dataclass\n" else "@dataclass(frozen=True)\n"
   in if list-length fields == 0 then
    deco & "class " & sname & ":\n    pass\n\n"
   else
    deco & "class " & sname & ":\n" & emit-py-record-fields fields 0 & "\n"

  emit-py-record-fields : List ARecordFieldDef, Integer -> Text
  emit-py-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "    " & py-sanitize (f.name.value) & ": Any = None\n" & emit-py-record-fields fields (i + 1)

Section: Expression Emission

  py-max-depth : Integer = 256

  emit-py-expr : IRExpr, PyCtx -> Text
  emit-py-expr (e) (ctx) = emit-py-expr-at e ctx 0

  emit-py-expr-at : IRExpr, PyCtx, Integer -> Text
  emit-py-expr-at (e) (ctx) (depth) =
   if depth >= py-max-depth then "None"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> "struct.unpack('=d', struct.pack('=q', " & integer-to-text n & "))[0]"
    is IrTextLit (s) (sp) -> "\"" & py-escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "True" else "False"
    is IrCharLit (n) (sp) -> "chr(" & integer-to-text n & ")"
    is IrName (n) (ty) (sp) -> emit-py-name n ty ctx
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-py-binary op l r ctx
    is IrNegate (operand) (nty) (sp) -> "(-" & emit-py-expr-at operand ctx (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-py-expr-at t ctx (depth + 1) & " if " & emit-py-expr-at c ctx (depth + 1) & " else " & emit-py-expr-at el ctx (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> emit-py-let name val body ctx
    is IrApply (f) (a) (ty) (sp) -> emit-py-apply e ctx
    is IrLambda (params) (body) (ty) (sp) -> emit-py-lambda params body ctx
    is IrList (elems) (ty) (sp) -> emit-py-list elems ctx
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-py-match scrut branches ctx
    is IrAct (stmts) (ty) (sp) -> emit-py-act stmts ctx
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-py-handle body clauses ctx depth
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-py-expr-at body ctx (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-py-record name fields ty ctx
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-py-expr-at rec ctx (depth + 1) & "." & py-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(lambda _r: (setattr(_r, '" & py-field field & "', " & emit-py-expr-at val ctx (depth + 1) & "), _r)[-1])(" & emit-py-expr-at rec ctx (depth + 1) & ")"
    is IrFork (body) (ty) (sp) -> "__import__('concurrent.futures').ThreadPoolExecutor().submit(lambda: (" & emit-py-expr-at body ctx (depth + 1) & ")(None))"
    is IrAwait (task) (ty) (sp) -> "(" & emit-py-expr-at task ctx (depth + 1) & ").result()"
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-py-try max body fb fail-stmts ctx
    is IrError (msg) (ty) (sp) -> "(lambda: (_ for _ in ()).throw(Exception(\"" & py-escape-text msg & "\")))()"

  emit-py-name : Text, CodexType, PyCtx -> Text
  emit-py-name (n) (ty) (ctx) =
   if n == "read-line" then "input()"
   else if n == "show" then "str"
   else if n == "negate" then "(lambda x: -x)"
   else if n == "True" then "True"
   else if n == "False" then "False"
   else if n == "Nothing" then "None"
   else if n == "get-state" then "_py_state[0]"
   else if is-py-builtin-name n then py-sanitize n
   else if text-length n > 0 then
    if is-upper-letter (char-code (char-at n 0)) then py-sanitize n & "()"
    else let ar = lookup-arity (ctx.arities) n
    in if ar == 0 then py-sanitize n & "()"
       else py-sanitize n
   else py-sanitize n

  emit-py-binary : IRBinaryOp, IRExpr, IRExpr, PyCtx -> Text
  emit-py-binary (op) (l) (r) (ctx) =
   when op
    is IrAppendText -> "(" & emit-py-expr l ctx & " + " & emit-py-expr r ctx & ")"
    is IrAppendList -> "(" & emit-py-expr l ctx & " + " & emit-py-expr r ctx & ")"
    is IrConsList -> "[" & emit-py-expr l ctx & "] + " & emit-py-expr r ctx
    is IrPowInt -> "(" & emit-py-expr l ctx & " ** " & emit-py-expr r ctx & ")"
    is IrDivInt -> "((lambda _a, _b: (abs(_a) // abs(_b)) * (1 if (_a >= 0) == (_b >= 0) else -1))(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & "))"
    is IrRemInt -> "((lambda _a, _b: (abs(_a) % abs(_b)) * (1 if _a >= 0 else -1))(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & "))"
    is IrAnd -> "(" & emit-py-expr l ctx & " and " & emit-py-expr r ctx & ")"
    is IrOr -> "(" & emit-py-expr l ctx & " or " & emit-py-expr r ctx & ")"
    is IrAddVec -> "[a + b for a, b in zip(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & ")]"
    is IrSubVec -> "[a - b for a, b in zip(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & ")]"
    is IrMulVec -> "[a * b for a, b in zip(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & ")]"
    is IrDivVec -> "[a / b for a, b in zip(" & emit-py-expr l ctx & ", " & emit-py-expr r ctx & ")]"
    is otherwise -> "(" & emit-py-expr l ctx & " " & py-bin-op-symbol op & " " & emit-py-expr r ctx & ")"

  py-bin-op-symbol : IRBinaryOp -> Text
  py-bin-op-symbol (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt -> "//"
    is IrRemInt -> "%"
    is IrPowInt -> "**"
    is IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrEq -> "=="
    is IrNotEq -> "!="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq -> "=="
    is IrApproxEqExact -> "=="
    is IrAnd -> "and"
    is IrOr -> "or"
    is IrAppendText -> "+"
    is IrAppendList -> "+"
    is IrConsList -> "+"

  emit-py-let : Text, IRExpr, IRExpr, PyCtx -> Text
  emit-py-let (name) (val) (body) (ctx) =
   "(lambda " & py-sanitize name & ": " & emit-py-expr body ctx & ")(" & emit-py-expr val ctx & ")"

  emit-py-lambda : List IRParam, IRExpr, PyCtx -> Text
  emit-py-lambda (params) (body) (ctx) =
   if list-length params == 0 then "(lambda: " & emit-py-expr body ctx & ")"
   else "(lambda " & emit-py-lambda-params params 0 & ": " & emit-py-expr body ctx & ")"

  emit-py-lambda-params : List IRParam, Integer -> Text
  emit-py-lambda-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then py-sanitize ((list-at params i).name)
   else py-sanitize ((list-at params i).name) & ", " & emit-py-lambda-params params (i + 1)

  emit-py-list : List IRExpr, PyCtx -> Text
  emit-py-list (elems) (ctx) =
   "[" & emit-py-list-elems elems 0 ctx & "]"

  emit-py-list-elems : List IRExpr, Integer, PyCtx -> Text
  emit-py-list-elems (elems) (i) (ctx) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-py-expr (list-at elems i) ctx
   else emit-py-expr (list-at elems i) ctx & ", " & emit-py-list-elems elems (i + 1) ctx

 A clamping bounded field saturates at its declared band. Python stores
 whatever it is given, so the saturation has to be emitted here from the
 field's declared type or it is silently lost.

  py-lookup-rec-field-ty : List RecordField, Text, Integer -> CodexType
  py-lookup-rec-field-ty (fields) (name) (i) =
   if i == list-length fields then ErrorTy
   else let f = list-at fields i
   in if f.name.value == name then f.type-val
      else py-lookup-rec-field-ty fields name (i + 1)

  py-resolve-rec-fields : PyCtx, Name, List RecordField -> List RecordField
  py-resolve-rec-fields (ctx) (rn) (rf) =
   if list-length rf > 0 then rf
   else record-fields-by-name (ctx.type-defs) (rn.value) 0

  py-clamp-field-val : PyCtx, CodexType, Text, Text -> Text
  py-clamp-field-val (ctx) (rec-ty) (field-name) (val-text) =
   when rec-ty
    is RecordTy (rn) (ra) (rf) ->
     let ft = py-lookup-rec-field-ty (py-resolve-rec-fields ctx rn rf) field-name 0
     in when ft
      is IntegerTy (lo) (hi) (mode) ->
       when mode
        is OvClamping -> "max(" & integer-to-text lo & ", min(" & integer-to-text hi & ", " & val-text & "))"
        is otherwise -> val-text
      is otherwise -> val-text
    is otherwise -> val-text

  emit-py-record : Text, List IRFieldVal, CodexType, PyCtx -> Text
  emit-py-record (name) (fields) (ty) (ctx) =
   py-sanitize name & "(" & emit-py-record-field-vals fields 0 ty ctx & ")"

  emit-py-record-field-vals : List IRFieldVal, Integer, CodexType, PyCtx -> Text
  emit-py-record-field-vals (fields) (i) (rec-ty) (ctx) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let val-text = emit-py-expr (f.value) ctx
   in let clamped = py-clamp-field-val ctx rec-ty (f.name) val-text
   in py-sanitize (f.name) & "=" & clamped & (if i < list-length fields - 1 then ", " else "") & emit-py-record-field-vals fields (i + 1) rec-ty ctx

  emit-py-match : IRExpr, List IRBranch, PyCtx -> Text
  emit-py-match (scrut) (branches) (ctx) =
   "(lambda _s: " & emit-py-match-body branches 0 ctx 0 & ")(" & emit-py-expr scrut ctx & ")"

  emit-py-match-body : List IRBranch, Integer, PyCtx, Integer -> Text
  emit-py-match-body (branches) (i) (ctx) (opens) =
   if i == list-length branches then " else (_ for _ in ()).throw(Exception(\"Non-exhaustive match\"))" & emit-py-close-parens opens
   else let b = list-at branches i
   in emit-py-match-arm (b.pattern) (b.body) branches i ctx opens

  emit-py-match-arm : IRPat, IRExpr, List IRBranch, Integer, PyCtx, Integer -> Text
  emit-py-match-arm (pat) (body) (branches) (i) (ctx) (opens) =
   when pat
    is IrLitPat (text) (ty) (sp) ->
     let prefix = if i > 0 then " else " else ""
     in prefix & "(" & emit-py-expr body ctx & " if _s == " & text & emit-py-match-body branches (i + 1) ctx (opens + 1)
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let prefix = if i > 0 then " else " else ""
     in prefix & "(" & emit-py-ctor-pat-body subs "_s" body ctx & " if isinstance(_s, " & py-sanitize name & ")" & emit-py-match-body branches (i + 1) ctx (opens + 1)
    is IrVarPat (name) (ty) (sp) ->
     let prefix = if i > 0 then " else " else ""
     in prefix & "(lambda " & py-sanitize name & ": " & emit-py-expr body ctx & ")(_s)" & emit-py-close-parens opens
    is IrWildPat (sp) ->
     let prefix = if i > 0 then " else " else ""
     in prefix & emit-py-expr body ctx & emit-py-close-parens opens
    is IrVecPat (pats) (ty) (sp) ->
     let prefix = if i > 0 then " else " else ""
     in prefix & emit-py-expr body ctx & emit-py-close-parens opens

  emit-py-close-parens : Integer -> Text
  emit-py-close-parens (n) =
   if n <= 0 then ""
   else ")" & emit-py-close-parens (n - 1)

  emit-py-ctor-pat-body : List IRPat, Text, IRExpr, PyCtx -> Text
  emit-py-ctor-pat-body (subs) (binding) (body) (ctx) =
   let var-bindings = collect-py-var-bindings subs binding 0
   in if list-length var-bindings == 0 then emit-py-expr body ctx
      else "(lambda " & emit-py-binding-names var-bindings 0 & ": " & emit-py-expr body ctx & ")(" & emit-py-binding-accesses var-bindings 0 & ")"

  PyVarBinding = record {
   name : Text,
   access : Text
  }

  collect-py-var-bindings : List IRPat, Text, Integer -> List PyVarBinding
  collect-py-var-bindings (subs) (binding) (i) =
   if i == list-length subs then []
   else let sub = list-at subs i
   in let rest = collect-py-var-bindings subs binding (i + 1)
   in when sub
    is IrVarPat (name) (ty) (sp) -> [PyVarBinding { name = name, access = binding & ".field" & integer-to-text i }] & rest
    is otherwise -> rest

  emit-py-binding-names : List PyVarBinding, Integer -> Text
  emit-py-binding-names (bindings) (i) =
   if i == list-length bindings then ""
   else if i == list-length bindings - 1 then py-sanitize ((list-at bindings i).name)
   else py-sanitize ((list-at bindings i).name) & ", " & emit-py-binding-names bindings (i + 1)

  emit-py-binding-accesses : List PyVarBinding, Integer -> Text
  emit-py-binding-accesses (bindings) (i) =
   if i == list-length bindings then ""
   else if i == list-length bindings - 1 then (list-at bindings i).access
   else (list-at bindings i).access & ", " & emit-py-binding-accesses bindings (i + 1)

  emit-py-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, PyCtx -> Text
  emit-py-try (max) (body) (fb) (fail-stmts) (ctx) =
   let body-text = emit-py-act body ctx
   in let fb-text = emit-py-act fb ctx
   in let fail-text = emit-py-act fail-stmts ctx
   in "(lambda _b=(lambda: " & body-text & "), _fb=(lambda: " & fb-text & "), _fx=(lambda: " & fail-text & "): (lambda _ns: (exec('_r=None\\nfor _ in range(" & integer-to-text max & "):\\n    try:\\n        _r=_b()\\n        break\\n    except:\\n        pass\\nelse:\\n    try:\\n        _r=_fb()\\n    except:\\n        _r=_fx()',_ns),_ns[\"_r\"])[-1])({\"_b\":_b,\"_fb\":_fb,\"_fx\":_fx}))()"

  emit-py-act : List IRActStmt, PyCtx -> Text
  emit-py-act (stmts) (ctx) =
   if py-act-has-binds stmts 0 then
    "(lambda: (" & emit-py-act-bind-chain stmts 0 ctx & "))()"
   else
    "(lambda: [" & emit-py-act-elems stmts 0 ctx & "][-1])()"

  py-act-has-binds : List IRActStmt, Integer -> Boolean
  py-act-has-binds (stmts) (i) =
   if i == list-length stmts then False
   else let s = list-at stmts i
   in when s
    is IrDoBind (name) (ty) (val) (sp) -> True
    is IrDoExec (e) (sp) -> py-act-has-binds stmts (i + 1)

  emit-py-act-bind-chain : List IRActStmt, Integer, PyCtx -> Text
  emit-py-act-bind-chain (stmts) (i) (ctx) =
   if i == list-length stmts then "None"
   else let s = list-at stmts i
   in if i == list-length stmts - 1 then
    when s
     is IrDoBind (name) (ty) (val) (sp) -> "(lambda " & py-sanitize name & ": " & py-sanitize name & ")(" & emit-py-expr val ctx & ")"
     is IrDoExec (e) (sp) -> emit-py-expr e ctx
   else when s
    is IrDoBind (name) (ty) (val) (sp) -> "(lambda " & py-sanitize name & ": " & emit-py-act-bind-chain stmts (i + 1) ctx & ")(" & emit-py-expr val ctx & ")"
    is IrDoExec (e) (sp) -> "[" & emit-py-expr e ctx & ", " & emit-py-act-bind-chain stmts (i + 1) ctx & "][-1]"

  emit-py-act-elems : List IRActStmt, Integer, PyCtx -> Text
  emit-py-act-elems (stmts) (i) (ctx) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let elem = when s
    is IrDoBind (name) (ty) (val) (sp) -> emit-py-expr val ctx
    is IrDoExec (e) (sp) -> emit-py-expr e ctx
   in if i == list-length stmts - 1 then elem
      else elem & ", " & emit-py-act-elems stmts (i + 1) ctx

  emit-py-handle : IRExpr, List IRHandleClause, PyCtx, Integer -> Text
  emit-py-handle (body) (clauses) (ctx) (depth) =
   if list-length clauses == 0 then emit-py-expr-at body ctx (depth + 1)
   else "(lambda: (" & emit-py-handle-clauses clauses ctx depth & emit-py-expr-at body ctx (depth + 1) & "))()"

  emit-py-handle-clauses : List IRHandleClause, PyCtx, Integer -> Text
  emit-py-handle-clauses (clauses) (ctx) (depth) =
   emit-py-handle-clauses-loop clauses 0 ctx depth

  emit-py-handle-clauses-loop : List IRHandleClause, Integer, PyCtx, Integer -> Text
  emit-py-handle-clauses-loop (clauses) (i) (ctx) (depth) =
   if i == list-length clauses then ""
   else let c = list-at clauses i
   in let body-expr = emit-py-unwrap-clause-lambda (c.body) (list-length (c.params))
   in "(lambda " & py-sanitize (c.resume-name) & ": " & emit-py-expr-at body-expr ctx (depth + 1) & "), " & emit-py-handle-clauses-loop clauses (i + 1) ctx depth

  emit-py-unwrap-clause-lambda : IRExpr, Integer -> IRExpr
  emit-py-unwrap-clause-lambda (e) (n) =
   if n == 0 then e
   else when e
    is IrLambda (ps) (b) (t) (s) -> b
    is otherwise -> e

Section: Builtin Dispatch

  PyBuiltinEmitter = record {
   name : Text,
   emit : List IRExpr, PyCtx -> Text
  }

  bsearch-py-emitter-pos : List PyBuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-py-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-py-emitter-pos entries name lo mid
      else bsearch-py-emitter-pos entries name (mid + 1) hi

  sort-py-emitters : List PyBuiltinEmitter -> List PyBuiltinEmitter
  sort-py-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

 The character predicates test CCE BANDS and must never be handed to a
 Python character function. Codex text is CCE, which numbers its code
 points by frequency: the letter a is 15 and the digits are 3..12, so
 `chr(15).isalpha()` asks Python about a control character and answers
 False. These three emitted exactly that until 2026-07-28, and the
 measured result was worse than a few wrong letters: is-digit and
 is-whitespace answered False for EVERY input, because no CCE code in
 their range is a Unicode digit or space.

 The bands are 1..2 whitespace, 3..12 digit, and 13..64 or 97..127
 letter. The letter band has a hole because CCE's punctuation sits at
 65..96, between the two halves.

  py-builtin-emitters : List PyBuiltinEmitter = sort-py-emitters [
   PyBuiltinEmitter { name = "__narrow", emit = \args ctx -> emit-py-expr (list-at args 0) ctx },
   PyBuiltinEmitter { name = "show", emit = \args ctx -> "str(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "negate", emit = \args ctx -> "(-" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "print-line-uni", emit = \args ctx -> "print(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "print-error-uni", emit = \args ctx -> "__import__('sys').stderr.write(" & emit-py-expr (list-at args 0) ctx & " + \"\\n\")" },
   PyBuiltinEmitter { name = "text-length", emit = \args ctx -> "len(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "is-letter", emit = \args ctx -> "(13 <= " & emit-py-expr (list-at args 0) ctx & " <= 64 or 97 <= " & emit-py-expr (list-at args 0) ctx & " <= 127)" },
   PyBuiltinEmitter { name = "is-digit", emit = \args ctx -> "(3 <= " & emit-py-expr (list-at args 0) ctx & " <= 12)" },
   PyBuiltinEmitter { name = "is-whitespace", emit = \args ctx -> "(1 <= " & emit-py-expr (list-at args 0) ctx & " <= 2)" },
   PyBuiltinEmitter { name = "text-to-integer", emit = \args ctx -> "int(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "integer-to-text", emit = \args ctx -> "str(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "char-code", emit = \args ctx -> emit-py-expr (list-at args 0) ctx },
   PyBuiltinEmitter { name = "code-to-char", emit = \args ctx -> emit-py-expr (list-at args 0) ctx },
   PyBuiltinEmitter { name = "char-to-text", emit = \args ctx -> "chr(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "list-length", emit = \args ctx -> "len(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "char-at", emit = \args ctx -> "ord(" & emit-py-expr (list-at args 0) ctx & "[" & emit-py-expr (list-at args 1) ctx & "])" },
   PyBuiltinEmitter { name = "char-code-at", emit = \args ctx -> "ord(" & emit-py-expr (list-at args 0) ctx & "[" & emit-py-expr (list-at args 1) ctx & "])" },
   PyBuiltinEmitter { name = "substring", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & "[" & emit-py-expr (list-at args 1) ctx & ":" & emit-py-expr (list-at args 1) ctx & " + " & emit-py-expr (list-at args 2) ctx & "]" },
   PyBuiltinEmitter { name = "list-at", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & "[" & emit-py-expr (list-at args 1) ctx & "]" },
   PyBuiltinEmitter { name = "list-insert-at", emit = \args ctx -> "(lambda _l, _i, _v: (_l.insert(_i, _v), _l)[1])(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ", " & emit-py-expr (list-at args 2) ctx & ")" },
   PyBuiltinEmitter { name = "list-set-at", emit = \args ctx -> "(lambda _l, _i, _v: (_l.__setitem__(_i, _v), _l)[1])(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ", " & emit-py-expr (list-at args 2) ctx & ")" },
   PyBuiltinEmitter { name = "list-snoc", emit = \args ctx -> "_cx_lpush(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "list-push", emit = \args ctx -> "_cx_lpush(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "text-compare", emit = \args ctx -> "(0 if " & emit-py-expr (list-at args 0) ctx & " == " & emit-py-expr (list-at args 1) ctx & " else (-1 if " & emit-py-expr (list-at args 0) ctx & " < " & emit-py-expr (list-at args 1) ctx & " else 1))" },
   PyBuiltinEmitter { name = "text-replace", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & ".replace(" & emit-py-expr (list-at args 1) ctx & ", " & emit-py-expr (list-at args 2) ctx & ")" },
   PyBuiltinEmitter { name = "text-concat-list", emit = \args ctx -> "\"\".join(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "text-split", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & ".split(" & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "text-contains", emit = \args ctx -> "(" & emit-py-expr (list-at args 1) ctx & " in " & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "text-starts-with", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & ".startswith(" & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "open-file", emit = \args ctx -> "open(" & emit-py-expr (list-at args 0) ctx & ", 'r')" },
   PyBuiltinEmitter { name = "read-all", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & ".read()" },
   PyBuiltinEmitter { name = "close-file", emit = \args ctx -> emit-py-expr (list-at args 0) ctx & ".close()" },
   PyBuiltinEmitter { name = "read-text", emit = \args ctx -> "open(" & emit-py-expr (list-at args 0) ctx & ", 'r').read()" },
   PyBuiltinEmitter { name = "write-file", emit = \args ctx -> "open(" & emit-py-expr (list-at args 0) ctx & ", 'w').write(" & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "file-exists", emit = \args ctx -> "__import__('os').path.exists(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "list-files", emit = \args ctx -> "__import__('glob').glob(__import__('os').path.join(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & "))" },
   PyBuiltinEmitter { name = "list-directories", emit = \args ctx -> "[d for d in __import__('os').listdir(" & emit-py-expr (list-at args 0) ctx & ") if __import__('os').path.isdir(__import__('os').path.join(" & emit-py-expr (list-at args 0) ctx & ", d))]" },
   PyBuiltinEmitter { name = "create-directory", emit = \args ctx -> "__import__('os').makedirs(" & emit-py-expr (list-at args 0) ctx & ", exist_ok=True)" },
   PyBuiltinEmitter { name = "path-combine", emit = \args ctx -> "__import__('os').path.join(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "path-filename", emit = \args ctx -> "__import__('os').path.basename(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "get-args", emit = \args ctx -> "__import__('sys').argv" },
   PyBuiltinEmitter { name = "get-env", emit = \args ctx -> "__import__('os').environ.get(" & emit-py-expr (list-at args 0) ctx & ", \"\")" },
   PyBuiltinEmitter { name = "current-dir", emit = \args ctx -> "__import__('os').getcwd()" },
   PyBuiltinEmitter { name = "run-process", emit = \args ctx -> "__import__('subprocess').check_output(" & emit-py-expr (list-at args 0) ctx & " + \" \" + " & emit-py-expr (list-at args 1) ctx & ", shell=True, text=True)" },
   PyBuiltinEmitter { name = "process-exit", emit = \args ctx -> "__import__('sys').exit(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "write-binary", emit = \args ctx -> "__import__('sys').stdout.buffer.write(bytes(" & emit-py-expr (list-at args 0) ctx & "))" },
   PyBuiltinEmitter { name = "write-binary-file", emit = \args ctx -> "open(" & emit-py-expr (list-at args 0) ctx & ", 'wb').write(bytes(" & emit-py-expr (list-at args 1) ctx & "))" },
   PyBuiltinEmitter { name = "fork", emit = \args ctx -> "__import__('concurrent.futures').ThreadPoolExecutor().submit(lambda: (" & emit-py-expr (list-at args 0) ctx & ")(None))" },
   PyBuiltinEmitter { name = "await", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & ").result()" },
   PyBuiltinEmitter { name = "par", emit = \args ctx -> "list(__import__('concurrent.futures').ThreadPoolExecutor().map(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & "))" },
   PyBuiltinEmitter { name = "race", emit = \args ctx -> "next(iter(__import__('concurrent.futures').as_completed([__import__('concurrent.futures').ThreadPoolExecutor().submit(lambda t=_t_: _t_(None)) for _t_ in " & emit-py-expr (list-at args 0) ctx & "]))).result()" },
   PyBuiltinEmitter { name = "bit-and", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & " & " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "bit-or", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & " | " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "bit-xor", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & " ^ " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "bit-shl", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & " << " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "bit-shr", emit = \args ctx -> "(" & emit-py-expr (list-at args 0) ctx & " >> " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "bit-not", emit = \args ctx -> "(~" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "int-mod", emit = \args ctx -> "((lambda _a, _b: _a % abs(_b))(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & "))" },
   PyBuiltinEmitter { name = "min", emit = \args ctx -> "min(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "max", emit = \args ctx -> "max(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "abs", emit = \args ctx -> "abs(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "read-line", emit = \args ctx -> "input()" },
   PyBuiltinEmitter { name = "__record-set", emit = \args ctx -> emit-py-record-set args ctx },
   PyBuiltinEmitter { name = "get-state", emit = \args ctx -> "_py_state[0]" },
   PyBuiltinEmitter { name = "set-state", emit = \args ctx -> "(lambda _v: (_py_state.__setitem__(0, _v), _v)[1])(" & emit-py-expr (list-at args 0) ctx & ")" },
   PyBuiltinEmitter { name = "run-state", emit = \args ctx -> emit-py-run-state args ctx },
   PyBuiltinEmitter { name = "__linked-list-empty", emit = \args ctx -> "[]" },
   PyBuiltinEmitter { name = "__linked-list-push", emit = \args ctx -> "_cx_lpush(" & emit-py-expr (list-at args 0) ctx & ", " & emit-py-expr (list-at args 1) ctx & ")" },
   PyBuiltinEmitter { name = "__linked-list-to-list", emit = \args ctx -> emit-py-expr (list-at args 0) ctx },
   PyBuiltinEmitter { name = "text-to-double-bits", emit = \args ctx -> "__import__('struct').unpack('q', __import__('struct').pack('d', float(" & emit-py-expr (list-at args 0) ctx & ")))[0]" },
   PyBuiltinEmitter { name = "run-process-full", emit = \args ctx -> emit-py-run-process-full args ctx },
   PyBuiltinEmitter { name = "__heap-save", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__heap-restore", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__heap-advance", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__deck-pos", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__deck-set", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__deck-alloc", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__deck-enter", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__deck-exit", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__list-with-capacity", emit = \args ctx -> "[]" },
   PyBuiltinEmitter { name = "__buf-write-byte", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__buf-write-bytes", emit = \args ctx -> "0" },
   PyBuiltinEmitter { name = "__buf-read-bytes", emit = \args ctx -> "[]" }
  ]

  is-py-builtin-name : Text -> Boolean
  is-py-builtin-name (n) =
   let len = list-length py-builtin-emitters
   in let pos = bsearch-py-emitter-pos py-builtin-emitters n 0 len
   in if pos >= len then False
      else (list-at py-builtin-emitters pos).name == n

  emit-py-builtin : Text, List IRExpr, PyCtx -> Text
  emit-py-builtin (n) (args) (ctx) =
   let len = list-length py-builtin-emitters
   in let pos = bsearch-py-emitter-pos py-builtin-emitters n 0 len
   in if pos >= len then ""
      else let entry = list-at py-builtin-emitters pos
      in if entry.name == n then entry.emit args ctx
         else ""

  emit-py-record-set : List IRExpr, PyCtx -> Text
  emit-py-record-set (args) (ctx) =
   let field-name = when (list-at args 1)
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in "__import__('dataclasses').replace(" & emit-py-expr (list-at args 0) ctx & ", " & py-sanitize field-name & "=" & emit-py-expr (list-at args 2) ctx & ")"

  emit-py-run-state : List IRExpr, PyCtx -> Text
  emit-py-run-state (args) (ctx) =
   let init = emit-py-expr (list-at args 0) ctx
   in let body = emit-py-expr (list-at args 1) ctx
   in "(lambda: (lambda _saved: (_py_state.__setitem__(0, " & init & "), (lambda _r: (_py_state.__setitem__(0, _saved), _r)[1])(" & body & "))[1])(_py_state[0]))()"

  emit-py-run-process-full : List IRExpr, PyCtx -> Text
  emit-py-run-process-full (args) (ctx) =
   let a0 = emit-py-expr (list-at args 0) ctx
   in let a1 = emit-py-expr (list-at args 1) ctx
   in "(lambda: (lambda _r: ProcessResult(stdout=_r.stdout, stderr=_r.stderr, exit_code=_r.returncode))(__import__('subprocess').run(" & a0 & " + \" \" + " & a1 & ", shell=True, capture_output=True, text=True)))()"

Section: Apply Emission

  emit-py-apply-args : List IRExpr, PyCtx, Integer -> Text
  emit-py-apply-args (args) (ctx) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-py-expr (list-at args i) ctx
        else emit-py-expr (list-at args i) ctx & ", " & emit-py-apply-args args ctx (i + 1)

  emit-py-apply : IRExpr, PyCtx -> Text
  emit-py-apply (e) (ctx) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     if is-py-builtin-name n then emit-py-builtin n args ctx
     else if is-mktup-name n then "(" & emit-py-apply-args args ctx 0 & (if list-length args == 1 then ",)" else ")")
     else if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then py-sanitize n & "(" & emit-py-apply-args args ctx 0 & ")"
     else let ar = lookup-arity (ctx.arities) n
     in if ar > 1 & list-length args == ar then py-sanitize n & "(" & emit-py-apply-args args ctx 0 & ")"
        else emit-py-expr-curried e ctx
    is otherwise -> emit-py-expr-curried e ctx

  emit-py-expr-curried : IRExpr, PyCtx -> Text
  emit-py-expr-curried (e) (ctx) =
   when e
    is IrApply (f) (a) (ty) (sp) -> emit-py-expr f ctx & "(" & emit-py-expr a ctx & ")"
    is otherwise -> emit-py-expr e ctx

Section: Tail Call Optimization

  is-self-call : IRExpr, Text -> Boolean
  is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in is-self-call-root (chain.root) func-name

  is-self-call-root : IRExpr, Text -> Boolean
  is-self-call-root (e) (func-name) =
   when e
    is IrName (n) (ty) (sp) -> n == func-name
    is otherwise -> False

  has-tail-call : IRExpr, Text -> Boolean
  has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> has-tail-call t func-name | has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> is-self-call e func-name
    is IrAct (stmts) (ty) (sp) -> has-tail-call-act stmts func-name
    is otherwise -> False

  has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if has-tail-call (b.body) func-name then True
      else has-tail-call-branches branches func-name (i + 1)

  has-tail-call-act : List IRActStmt, Text -> Boolean
  has-tail-call-act (stmts) (func-name) =
   let len = list-length stmts
   in if len == 0 then False
    else let last = list-at stmts (len - 1)
     in when last
      is IrDoExec (e) (sp) -> has-tail-call e func-name
      is otherwise -> False

  should-tco : IRDef -> Boolean
  should-tco (d) =
   if list-length (d.params) == 0 then False
   else has-tail-call (d.body) (d.name)

  emit-py-tco-body : IRExpr, Text, List IRParam, PyCtx, Integer -> Text
  emit-py-tco-body (e) (func-name) (params) (ctx) (indent) =
   let pad = py-indent indent
   in when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     pad & "if " & emit-py-expr c ctx & ":\n" & emit-py-tco-body t func-name params ctx (indent + 1) & pad & "else:\n" & emit-py-tco-body el func-name params ctx (indent + 1)
    is IrLet (name) (ty) (val) (body) (sp) ->
     pad & py-sanitize name & " = " & emit-py-expr val ctx & "\n" & emit-py-tco-body body func-name params ctx indent
    is IrMatch (scrut) (branches) (ty) (sp) ->
     emit-py-tco-match scrut branches func-name params ctx indent
    is IrApply (f) (a) (rty) (sp) ->
     if is-self-call e func-name then emit-py-tco-jump e params ctx indent
     else pad & "return " & emit-py-expr e ctx & "\n"
    is IrAct (stmts) (ty) (sp) ->
     emit-py-tco-act stmts func-name params ctx indent
    is otherwise ->
     pad & "return " & emit-py-expr e ctx & "\n"

  emit-py-tco-jump : IRExpr, List IRParam, PyCtx, Integer -> Text
  emit-py-tco-jump (e) (params) (ctx) (indent) =
   let pad = py-indent indent
   in let chain = collect-apply-chain e []
   in let args = chain.args
   in emit-py-tco-temps args ctx indent 0 & emit-py-tco-assign params indent 0 & pad & "continue\n"

  emit-py-tco-temps : List IRExpr, PyCtx, Integer, Integer -> Text
  emit-py-tco-temps (args) (ctx) (indent) (i) =
   if i == list-length args then ""
   else let pad = py-indent indent
   in pad & "_tco_" & integer-to-text i & " = " & emit-py-expr (list-at args i) ctx & "\n" & emit-py-tco-temps args ctx indent (i + 1)

  emit-py-tco-assign : List IRParam, Integer, Integer -> Text
  emit-py-tco-assign (params) (indent) (i) =
   if i == list-length params then ""
   else let pad = py-indent indent
   in pad & py-sanitize ((list-at params i).name) & " = _tco_" & integer-to-text i & "\n" & emit-py-tco-assign params indent (i + 1)

  emit-py-tco-match : IRExpr, List IRBranch, Text, List IRParam, PyCtx, Integer -> Text
  emit-py-tco-match (scrut) (branches) (func-name) (params) (ctx) (indent) =
   let pad = py-indent indent
   in pad & "_tco_s = " & emit-py-expr scrut ctx & "\n" & emit-py-tco-match-branches branches func-name params ctx indent 0 True

  emit-py-tco-match-branches : List IRBranch, Text, List IRParam, PyCtx, Integer, Integer, Boolean -> Text
  emit-py-tco-match-branches (branches) (func-name) (params) (ctx) (indent) (i) (is-first) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in emit-py-tco-match-branch (b.pattern) (b.body) func-name params ctx indent is-first & emit-py-tco-match-branches branches func-name params ctx indent (i + 1) False

  emit-py-tco-match-branch : IRPat, IRExpr, Text, List IRParam, PyCtx, Integer, Boolean -> Text
  emit-py-tco-match-branch (pat) (body) (func-name) (params) (ctx) (indent) (is-first) =
   let pad = py-indent indent
   in when pat
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let keyword = if is-first then "if" else "elif"
     in pad & keyword & " isinstance(_tco_s, " & py-sanitize name & "):\n" & emit-py-tco-ctor-bindings subs indent 0 & emit-py-tco-body body func-name params ctx (indent + 1)
    is IrLitPat (text) (ty) (sp) ->
     let keyword = if is-first then "if" else "elif"
     in pad & keyword & " _tco_s == " & text & ":\n" & emit-py-tco-body body func-name params ctx (indent + 1)
    is IrVarPat (name) (ty) (sp) ->
     pad & "else:\n" & py-indent (indent + 1) & py-sanitize name & " = _tco_s\n" & emit-py-tco-body body func-name params ctx (indent + 1)
    is IrWildPat (sp) ->
     pad & "else:\n" & emit-py-tco-body body func-name params ctx (indent + 1)
    is IrVecPat (pats) (ty) (sp) ->
     pad & "else:\n" & emit-py-tco-body body func-name params ctx (indent + 1)

  emit-py-tco-ctor-bindings : List IRPat, Integer, Integer -> Text
  emit-py-tco-ctor-bindings (subs) (indent) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in emit-py-tco-ctor-binding sub indent i & emit-py-tco-ctor-bindings subs indent (i + 1)

  emit-py-tco-ctor-binding : IRPat, Integer, Integer -> Text
  emit-py-tco-ctor-binding (sub) (indent) (i) =
   when sub
    is IrVarPat (name) (ty) (sp) -> py-indent (indent + 1) & py-sanitize name & " = _tco_s.field" & integer-to-text i & "\n"
    is otherwise -> ""

  emit-py-tco-act : List IRActStmt, Text, List IRParam, PyCtx, Integer -> Text
  emit-py-tco-act (stmts) (func-name) (params) (ctx) (indent) =
   emit-py-tco-act-loop stmts func-name params ctx indent 0 (list-length stmts)

  emit-py-tco-act-loop : List IRActStmt, Text, List IRParam, PyCtx, Integer, Integer, Integer -> Text
  emit-py-tco-act-loop (stmts) (func-name) (params) (ctx) (indent) (i) (len) =
   if i == len then ""
   else let s = list-at stmts i
   in let is-last = i == len - 1
   in let pad = py-indent indent
   in if is-last then when s
     is IrDoExec (e) (sp) -> emit-py-tco-body e func-name params ctx indent
     is IrDoBind (name) (ty) (val) (sp) -> pad & py-sanitize name & " = " & emit-py-expr val ctx & "\n"
    else (when s
     is IrDoBind (name) (ty) (val) (sp) -> pad & py-sanitize name & " = " & emit-py-expr val ctx & "\n"
     is IrDoExec (e) (sp) -> pad & emit-py-expr e ctx & "\n") & emit-py-tco-act-loop stmts func-name params ctx indent (i + 1) len

Section: Definition Emission

  emit-py-def : IRDef, PyCtx -> Text
  emit-py-def (d) (ctx) =
   if should-tco d then emit-py-tco-def d ctx
   else emit-py-normal-def d ctx

  emit-py-normal-def : IRDef, PyCtx -> Text
  emit-py-normal-def (d) (ctx) =
   let name = py-sanitize (d.name)
   in let params-text = emit-py-def-params (d.params) 0
   in let is-effectful = is-effectful-type (d.type-val)
   in if is-effectful then
    "def " & name & "(" & params-text & "):\n" & emit-py-statement (d.body) ctx 1 & "\n"
   else
    "def " & name & "(" & params-text & "):\n    return " & emit-py-expr (d.body) ctx & "\n\n"

  emit-py-tco-def : IRDef, PyCtx -> Text
  emit-py-tco-def (d) (ctx) =
   let name = py-sanitize (d.name)
   in let params-text = emit-py-def-params (d.params) 0
   in "def " & name & "(" & params-text & "):\n    while True:\n" & emit-py-tco-body (d.body) (d.name) (d.params) ctx 2 & "\n"

  emit-py-def-params : List IRParam, Integer -> Text
  emit-py-def-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then py-sanitize ((list-at params i).name)
   else py-sanitize ((list-at params i).name) & ", " & emit-py-def-params params (i + 1)

  is-effectful-type : CodexType -> Boolean
  is-effectful-type (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> True
    is FunTy (p) (fnrow) (r) -> is-effectful-type r
    is ForAllTy (id) (body) -> is-effectful-type body
    is ForAllEff (id) (body) -> is-effectful-type body
    is LinearTy (body) -> is-effectful-type body
    is TypeApply (body) (tyarg) -> is-effectful-type body
    is otherwise -> False

  emit-py-statement : IRExpr, PyCtx, Integer -> Text
  emit-py-statement (e) (ctx) (indent) =
   let pad = py-indent indent
   in when e
    is IrAct (stmts) (ty) (sp) -> emit-py-act-stmts stmts ctx indent
    is IrIf (c) (t) (el) (ty) (sp) ->
     pad & "if " & emit-py-expr c ctx & ":\n" & emit-py-statement t ctx (indent + 1) & pad & "else:\n" & emit-py-statement el ctx (indent + 1)
    is IrLet (name) (ty) (val) (body) (sp) ->
     pad & py-sanitize name & " = " & emit-py-expr val ctx & "\n" & emit-py-statement body ctx indent
    is IrMatch (scrut) (branches) (ty) (sp) ->
     emit-py-stmt-match scrut branches ctx indent
    is otherwise -> pad & emit-py-expr e ctx & "\n"

  emit-py-stmt-match : IRExpr, List IRBranch, PyCtx, Integer -> Text
  emit-py-stmt-match (scrut) (branches) (ctx) (indent) =
   let pad = py-indent indent
   in pad & "_sm = " & emit-py-expr scrut ctx & "\n" & emit-py-stmt-match-branches branches ctx indent 0 True

  emit-py-stmt-match-branches : List IRBranch, PyCtx, Integer, Integer, Boolean -> Text
  emit-py-stmt-match-branches (branches) (ctx) (indent) (i) (is-first) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in emit-py-stmt-match-branch (b.pattern) (b.body) ctx indent is-first & emit-py-stmt-match-branches branches ctx indent (i + 1) False

  emit-py-stmt-match-branch : IRPat, IRExpr, PyCtx, Integer, Boolean -> Text
  emit-py-stmt-match-branch (pat) (body) (ctx) (indent) (is-first) =
   let pad = py-indent indent
   in when pat
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let keyword = if is-first then "if" else "elif"
     in pad & keyword & " isinstance(_sm, " & py-sanitize name & "):\n" & emit-py-stmt-ctor-bindings subs indent 0 & emit-py-statement body ctx (indent + 1)
    is IrLitPat (text) (ty) (sp) ->
     let keyword = if is-first then "if" else "elif"
     in pad & keyword & " _sm == " & text & ":\n" & emit-py-statement body ctx (indent + 1)
    is IrVarPat (name) (ty) (sp) ->
     pad & "else:\n" & py-indent (indent + 1) & py-sanitize name & " = _sm\n" & emit-py-statement body ctx (indent + 1)
    is IrWildPat (sp) ->
     pad & "else:\n" & emit-py-statement body ctx (indent + 1)
    is IrVecPat (pats) (ty) (sp) ->
     pad & "else:\n" & emit-py-statement body ctx (indent + 1)

  emit-py-stmt-ctor-bindings : List IRPat, Integer, Integer -> Text
  emit-py-stmt-ctor-bindings (subs) (indent) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in (when sub
    is IrVarPat (name) (ty) (sp) -> py-indent (indent + 1) & py-sanitize name & " = _sm.field" & integer-to-text i & "\n"
    is otherwise -> "") & emit-py-stmt-ctor-bindings subs indent (i + 1)

  emit-py-act-stmts : List IRActStmt, PyCtx, Integer -> Text
  emit-py-act-stmts (stmts) (ctx) (indent) =
   emit-py-act-stmts-loop stmts ctx indent 0 (list-length stmts)

  emit-py-act-stmts-loop : List IRActStmt, PyCtx, Integer, Integer, Integer -> Text
  emit-py-act-stmts-loop (stmts) (ctx) (indent) (i) (len) =
   if i == len then ""
   else let s = list-at stmts i
   in let pad = py-indent indent
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> pad & py-sanitize name & " = " & emit-py-expr val ctx & "\n"
    is IrDoExec (e) (sp) ->
     if i == len - 1 then emit-py-statement e ctx indent
     else pad & emit-py-expr e ctx & "\n") & emit-py-act-stmts-loop stmts ctx indent (i + 1) len

Section: Chapter Emission

  strip-fun-args : CodexType -> CodexType
  strip-fun-args (ty) =
   when ty
    is FunTy (p) (fnrow) (r) -> strip-fun-args r
    is ForAllTy (id) (body) -> strip-fun-args body
    is ForAllEff (id) (body) -> strip-fun-args body
    is LinearTy (body) -> strip-fun-args body
    is TypeApply (body) (tyarg) -> strip-fun-args body
    is otherwise -> ty

  peel-effectful-ty : CodexType -> CodexType
  peel-effectful-ty (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> peel-effectful-ty ret
    is otherwise -> ty

  opening-return-type : List IRDef -> CodexType
  opening-return-type (defs) = opening-return-loop defs 0

  opening-return-loop : List IRDef, Integer -> CodexType
  opening-return-loop (defs) (i) =
   if i >= list-length defs then NothingTy
   else let d = list-at defs i
   in if d.name == opening-entry-point then peel-effectful-ty (strip-fun-args (d.type-val))
      else opening-return-loop defs (i + 1)

  opening-has-params : List IRDef -> Boolean
  opening-has-params (defs) = opening-has-params-loop defs 0

  opening-has-params-loop : List IRDef, Integer -> Boolean
  opening-has-params-loop (defs) (i) =
   if i >= list-length defs then True
   else let d = list-at defs i
   in if d.name == opening-entry-point then list-length (d.params) > 0
      else opening-has-params-loop defs (i + 1)

 CPython bounds recursion with a COUNTER, `sys.setrecursionlimit`, whose
 default is 1000, and not with the size of a stack. Codex source recurses
 deeply and mutually -- the compiler's own lexer cycles scan-token ->
 skip-prose-line -> scan-token, which no self-TCO pass can flatten -- so a
 program that answers correctly on bare metal raises RecursionError here at
 depth 1000. Measured: the counter is the whole fix on 3.11, which stopped
 consuming C stack for Python-to-Python calls, and a 512 MB thread with the
 default counter still dies. threading.stack_size(512MB) is REFUSED on
 Windows CPython, so the csharp plug's constant cannot be ported literally.

  py-recursion-limit : Text =
   "import sys\nsys.setrecursionlimit(1000000)\n"

  py-emit-entry : CodexType, Boolean -> Text
  py-emit-entry (ret-ty) (has-params) =
   if has-params then ""
   else py-recursion-limit & py-emit-entry-call ret-ty

  py-emit-entry-call : CodexType -> Text
  py-emit-entry-call (ret-ty) =
   when ret-ty
    is EffectfulTy (effs) (sc) (inner) -> py-sanitize opening-entry-point & "()\n"
    is NothingTy -> py-sanitize opening-entry-point & "()\n"
    is ProofTy -> py-sanitize opening-entry-point & "()\n"
    is PropEqTy (pl) (pr) -> py-sanitize opening-entry-point & "()\n"
    is VoidTy -> py-sanitize opening-entry-point & "()\n"
    is UnitTy (n) (inner) -> py-sanitize opening-entry-point & "()\n"
    is otherwise -> "print(" & py-sanitize opening-entry-point & "())\n"

  emit-python-chapter : IRChapter, List ATypeDef -> Text
  emit-python-chapter (m) (type-defs) =
   let ctx = PyCtx { arities = build-arity-map (m.defs) 0 [], type-defs = type-defs }
   in let header = "from dataclasses import dataclass\nfrom typing import Any\nimport struct\n\n_py_state = [0]\n\ndef _cx_lpush(_l, _v):\n    if _l:\n        _l.append(_v)\n        return _l\n    return [_v]\n\n"
   in let types-text = emit-py-type-defs type-defs 0
   in let defs-text = emit-py-defs (m.defs) 0 ctx
   in let ret-ty = opening-return-type (m.defs)
   in let has-params = opening-has-params (m.defs)
   in let entry = py-emit-entry ret-ty has-params
   in header & types-text & defs-text & entry

  emit-py-defs : List IRDef, Integer, PyCtx -> Text
  emit-py-defs (defs) (i) (ctx) =
   if i == list-length defs then ""
   else emit-py-def (list-at defs i) ctx & emit-py-defs defs (i + 1) ctx

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

