   in let j = wf-indent 2 & "[System.Runtime.InteropServices.DllImport(\"nvcuda\")] static extern int cuLaunchKernel(IntPtr f, int gx, int gy, int gz, int bx, int by, int bz, int sh, IntPtr st, IntPtr[] a, IntPtr e);\n"
   in let k = wf-indent 2 & "[System.Runtime.InteropServices.DllImport(\"nvcuda\")] static extern int cuCtxSynchronize();\n"
   in let l = wf-indent 2 & "[System.Runtime.InteropServices.DllImport(\"nvcuda\")] static extern int cuDeviceGetName(byte[] n, int len, int d);\n"
   in let grp1 = a & b & c & d & e & f
   in let grp2 = g & h & i & j & k & l
   in grp1 & grp2 & "\n"

  wf-bi-cuda-init : Text
  wf-bi-cuda-init =
   let sig = wf-indent 2 & "static bool gpu_init() {\n"
   in let body1 = wf-indent 3 & "try {\n"
   in let body2 = wf-indent 4 & "if (cuInit(0) != 0) { _cudaError = \"cuInit failed\"; return false; }\n"
   in let body3 = wf-indent 4 & "if (cuDeviceGet(out int dev, 0) != 0) { _cudaError = \"no device\"; return false; }\n"
   in let body4 = wf-indent 4 & "if (cuCtxCreate_v2(out _cudaCtx, 0, dev) != 0) { _cudaError = \"ctx failed\"; return false; }\n"
   in let body5 = wf-indent 4 & "var nameBuf = new byte[256]; cuDeviceGetName(nameBuf, 256, dev);\n"
   in let body6 = wf-indent 4 & "var devName = System.Text.Encoding.ASCII.GetString(nameBuf).TrimEnd('\\0');\n"
   in let body7 = wf-indent 4 & "_cudaError = \"GPU: \" + devName; _cudaReady = true; return true;\n"
   in let body8 = wf-indent 3 & "} catch (Exception ex) { _cudaError = \"no CUDA: \" + ex.Message; return false; }\n"
   in let close = wf-indent 2 & "}\n"
   in sig & body1 & body2 & body3 & body4 & body5 & body6 & body7 & body8 & close

  wf-bi-cuda-module : Text
  wf-bi-cuda-module =
   let sig = wf-indent 2 & "static bool gpu_load_ptx(dynamic path) {\n"
   in let body1 = wf-indent 3 & "if (!_cudaReady) { _cudaError = \"GPU not initialized\"; return false; }\n"
   in let body2 = wf-indent 3 & "var ptxText = System.IO.File.ReadAllText((string)path);\n"
   in let body3 = wf-indent 3 & "var ptxBytes = System.Text.Encoding.ASCII.GetBytes(ptxText + \"\\0\");\n"
   in let body4 = wf-indent 3 & "var rc = cuModuleLoadData(out _cudaModule, ptxBytes);\n"
   in let body5 = wf-indent 3 & "if (rc != 0) { _cudaError = \"module load failed: \" + rc; return false; }\n"
   in let body6 = wf-indent 3 & "_cudaError = \"PTX loaded\"; return true;\n"
   in let close = wf-indent 2 & "}\n"
   in sig & body1 & body2 & body3 & body4 & body5 & body6 & close

  wf-bi-cuda-mem : Text
  wf-bi-cuda-mem =
   let alloc = wf-indent 2 & "static long gpu_alloc(dynamic count) {\n" & wf-indent 3 & "if (!_cudaReady) return 0;\n" & wf-indent 3 & "cuMemAlloc_v2(out IntPtr ptr, (long)count * 8);\n" & wf-indent 3 & "return (long)ptr;\n" & wf-indent 2 & "}\n"
   in let free = wf-indent 2 & "static void gpu_free(dynamic ptr) { if (_cudaReady) cuMemFree_v2((IntPtr)(long)ptr); }\n"
   in let todev = wf-indent 2 & "static void gpu_copy_to(dynamic dstPtr, dynamic hostArr) {\n" & wf-indent 3 & "var arr = (long[])hostArr; cuMemcpyHtoD_v2((IntPtr)(long)dstPtr, arr, arr.Length * 8);\n" & wf-indent 2 & "}\n"
   in let tohost = wf-indent 2 & "static long[] gpu_copy_from(dynamic srcPtr, dynamic count) {\n" & wf-indent 3 & "var arr = new long[(int)(long)count]; cuMemcpyDtoH_v2(arr, (IntPtr)(long)srcPtr, (long)count * 8);\n" & wf-indent 3 & "return arr;\n" & wf-indent 2 & "}\n"
   in alloc & free & todev & tohost

  wf-bi-cuda-launch : Text
  wf-bi-cuda-launch =
   let sig = wf-indent 2 & "static bool gpu_launch(dynamic kernelName, dynamic gridSize, dynamic blockSize, dynamic args) {\n"
   in let body1 = wf-indent 3 & "if (!_cudaReady || _cudaModule == IntPtr.Zero) return false;\n"
   in let body2 = wf-indent 3 & "var rc = cuModuleGetFunction(out IntPtr func, _cudaModule, (string)kernelName);\n"
   in let body3 = wf-indent 3 & "if (rc != 0) { _cudaError = \"kernel not found: \" + (string)kernelName; return false; }\n"
   in let body4 = wf-indent 3 & "var argList = (List<dynamic>)args;\n"
   in let body5 = wf-indent 3 & "var argBuf = new long[argList.Count];\n"
   in let body6 = wf-indent 3 & "for (int i = 0; i < argList.Count; i++) argBuf[i] = (long)argList[i];\n"
   in let body7 = wf-indent 3 & "var handle = System.Runtime.InteropServices.GCHandle.Alloc(argBuf, System.Runtime.InteropServices.GCHandleType.Pinned);\n"
   in let body8 = wf-indent 3 & "var basePtr = handle.AddrOfPinnedObject();\n"
   in let body9 = wf-indent 3 & "var ptrs = new IntPtr[argBuf.Length];\n"
   in let body10 = wf-indent 3 & "for (int i = 0; i < argBuf.Length; i++) ptrs[i] = basePtr + i * 8;\n"
   in let body11 = wf-indent 3 & "rc = cuLaunchKernel(func, (int)(long)gridSize, 1, 1, (int)(long)blockSize, 1, 1, 0, IntPtr.Zero, ptrs, IntPtr.Zero);\n"
   in let body12 = wf-indent 3 & "handle.Free();\n"
   in let body13 = wf-indent 3 & "if (rc != 0) { _cudaError = \"launch failed: \" + rc; return false; }\n"
   in let body14 = wf-indent 3 & "return true;\n"
   in let close = wf-indent 2 & "}\n"
   in let grp1 = sig & body1 & body2 & body3 & body4 & body5 & body6
   in let grp2 = body7 & body8 & body9 & body10 & body11 & body12 & body13 & body14 & close
   in grp1 & grp2

  wf-bi-cuda-util : Text
  wf-bi-cuda-util =
   let sync = wf-indent 2 & "static void gpu_sync() { if (_cudaReady) cuCtxSynchronize(); }\n"
   in let avail = wf-indent 2 & "static bool gpu_available() { return _cudaReady; }\n"
   in let err = wf-indent 2 & "static string gpu_error() { return _cudaError; }\n"
   in sync & avail & err

  wf-bi-cuda : Text
  wf-bi-cuda =
   let state = wf-bi-cuda-state & wf-bi-cuda-imports
   in let api = wf-bi-cuda-init & wf-bi-cuda-module & wf-bi-cuda-mem
   in let launch = wf-bi-cuda-launch & wf-bi-cuda-util
   in state & api & launch & "\n"

  wf-builtins : Text
  wf-builtins =
   let core = wf-bi-fields & wf-bi-io & wf-bi-conv
   in let data = wf-bi-text & wf-bi-char & wf-bi-bit & wf-bi-math
   in let col = wf-bi-list & wf-bi-state
   in let dom = wf-bi-dom & wf-bi-dom-create & wf-bi-dom-attr & wf-bi-dom-style & wf-bi-dom-events & wf-bi-dom-class & wf-bi-color
   in let ui = wf-bi-dialog & wf-bi-widget-mount & wf-bi-render & wf-bi-theme
   in let extra = wf-bi-json & wf-bi-util & wf-bi-stubs & wf-bi-cuda
   in core & data & col & dom & ui & extra & "\n"

Section: WinForms Assembly

  wf-constructor : Text -> Text
  wf-constructor (title) =
   let hdr = wf-indent 2 & "public MainForm()\n" & wf-indent 2 & "{\n"
   in let setup = wf-indent 3 & "Text = \"" & title & "\";\n" & wf-indent 3 & "Size = new Size(900, 700);\n"
   in let init-form = wf-indent 3 & "_form = this;\n"
   in let try-open = wf-indent 3 & "dynamic result = null;\n" & wf-indent 3 & "try { result = opening; } catch (Exception ex) { _output.Add(\"ERROR: \" + ex.Message); }\n"
   in let widget-branch = wf-indent 3 & "if (result is Dictionary<string,dynamic> rd && rd.ContainsKey(\"wn-kind\")) {\n" & wf-indent 4 & "var root = build_widget(result);\n" & wf-indent 4 & "root.Dock = DockStyle.Fill;\n" & wf-indent 4 & "Controls.Add(root);\n" & wf-indent 3 & "}"
   in let text-branch = " else {\n" & wf-indent 4 & "var tb = new TextBox { Multiline = true, ReadOnly = true, Dock = DockStyle.Fill, ScrollBars = ScrollBars.Vertical, Font = new Font(\"Courier New\", 10) };\n" & wf-indent 4 & "tb.Text = string.Join(Environment.NewLine, _output);\n" & wf-indent 4 & "Controls.Add(tb);\n" & wf-indent 3 & "}\n"
   in let close = wf-indent 2 & "}\n\n"
   in hdr & setup & init-form & try-open & widget-branch & text-branch & close

  wf-main-method : Text
  wf-main-method =
   let attr = wf-indent 2 & "[STAThread]\n"
   in let sig = wf-indent 2 & "static void Main()\n" & wf-indent 2 & "{\n"
   in let body = wf-indent 3 & "Application.EnableVisualStyles();\n" & wf-indent 3 & "Application.Run(new MainForm());\n"
   in let close = wf-indent 2 & "}\n"
   in attr & sig & body & close

  emit-winforms-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-winforms-chapter (m) (meta) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let title = if meta.chapter-title == "" then "CodexApp" else wf-sanitize (meta.chapter-title)
   in let header = "using System;\nusing System.Collections.Generic;\nusing System.Drawing;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Windows.Forms;\nusing System.Text.Json;\n\nnamespace " & title & "\n{\n    public class MainForm : Form\n    {\n"
   in let types-text = emit-wf-type-defs type-defs 0
   in let defs-text = emit-wf-defs (m.defs) 0 arities
   in let body = wf-builtins & types-text & defs-text
   in let controls = wf-widget-builder & wf-constructor title
   in let tail = wf-main-method & "    }\n}\n"
   in header & body & controls & tail
