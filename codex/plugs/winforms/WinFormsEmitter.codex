Chapter: WinForms Emitter

Section: Sanitization

  wf-sanitize : Text -> Text
  wf-sanitize (name) =
   text-replace (text-replace name "-" "_") "'" ""

  wf-escape : Text -> Text
  wf-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in text-replace s2 "\n" "\\n"

  wf-indent : Integer -> Text
  wf-indent (n) =
   if n <= 0 then ""
   else "    " & wf-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in if text-compare name (list-at entries mid).name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   list-insert-at xs (bsearch-arity-pos xs (e.name) 0 (list-length xs)) e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry { name = d.name, arity = __narrow (list-length (d.params)), generic-count = 0 }))

Section: Expression Emission

  emit-wf-expr : IRExpr, List ArityEntry, Integer -> Text
  emit-wf-expr (e) (arities) (indent) =
   when e
    is IrIntLit (n) (sp) -> show n & "L"
    is IrNumLit (n) (sp) -> "BitConverter.Int64BitsToDouble(" & show n & "L)"
    is IrTextLit (s) (sp) -> "\"" & wf-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> "((char)" & show n & ")"
    is IrName (n) (ty) (sp) -> wf-sanitize n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-wf-binary op l r arities indent
    is IrNegate (x) (nty) (sp) -> "(-(" & emit-wf-expr x arities indent & "))"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-wf-expr c arities indent & " ? " & emit-wf-expr t arities indent & " : " & emit-wf-expr el arities indent & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "((Func<dynamic>)(() => { dynamic " & wf-sanitize name & " = " & emit-wf-expr val arities indent & "; return " & emit-wf-expr body arities indent & "; }))()"
    is IrApply (f) (a) (ty) (sp) -> emit-wf-apply e arities indent
    is IrLambda (params) (body) (ty) (sp) -> "((Func<" & wf-lam-func-type (list-length params) 0 & ">)((" & emit-wf-params params 0 & ") => " & emit-wf-expr body arities indent & "))"
    is IrList (elems) (ty) (sp) -> "new List<dynamic> { " & emit-wf-elems elems arities indent 0 & " }"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-wf-match scrut branches arities indent
    is IrAct (stmts) (ty) (sp) -> emit-wf-act stmts arities indent
    is IrRecord (name) (fields) (ty) (sp) -> "new Dictionary<string,dynamic> { [\"_type\"] = \"" & name & "\"" & emit-wf-rec-fields fields arities indent 0 & " }"
    is IrFieldAccess (rec) (field) (ty) (sp) -> "((" & emit-wf-expr rec arities indent & ")[\"" & wf-field field & "\"])"
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "((" & emit-wf-expr rec arities indent & ")[\"" & wf-field field & "\"] = " & emit-wf-expr val arities indent & ")"
    is IrFork (body) (ty) (sp) -> "Task.Run(() => " & emit-wf-expr body arities indent & ")"
    is IrAwait (task) (ty) (sp) -> "(await " & emit-wf-expr task arities indent & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-wf-expr body arities indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-wf-expr body arities indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-wf-act body arities indent
    is IrError (msg) (ty) (sp) -> "throw new Exception(\"" & wf-escape msg & "\")"

  emit-wf-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, Integer -> Text
  emit-wf-binary (op) (l) (r) (arities) (indent) =
   let lhs = emit-wf-expr l arities indent
   in let rhs = emit-wf-expr r arities indent
   in when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "(" & lhs & " + " & rhs & ")"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "(" & lhs & " - " & rhs & ")"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "(" & lhs & " * " & rhs & ")"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "(" & lhs & " / " & rhs & ")"
    is IrRemInt -> "(" & lhs & " % " & rhs & ")"
    is IrPowInt -> "((long)Math.Pow(" & lhs & ", " & rhs & "))"
    is IrEq -> "object.Equals(" & lhs & ", " & rhs & ")"
    is IrNotEq -> "!object.Equals(" & lhs & ", " & rhs & ")"
    is IrLt | IrLtVec -> "(((IComparable)" & lhs & ").CompareTo(" & rhs & ") < 0)"
    is IrGt | IrGtVec -> "(((IComparable)" & lhs & ").CompareTo(" & rhs & ") > 0)"
    is IrLtEq | IrLtEqVec -> "(((IComparable)" & lhs & ").CompareTo(" & rhs & ") <= 0)"
    is IrGtEq | IrGtEqVec -> "(((IComparable)" & lhs & ").CompareTo(" & rhs & ") >= 0)"
    is IrApproxEq -> "object.Equals(" & lhs & ", " & rhs & ")"
    is IrApproxEqExact -> "object.Equals(" & lhs & ", " & rhs & ")"
    is IrAnd -> "(" & lhs & " && " & rhs & ")"
    is IrOr -> "(" & lhs & " || " & rhs & ")"
    is IrAppendText -> "(\"\" + " & lhs & " + " & rhs & ")"
    is IrAppendList -> "((List<dynamic>)" & lhs & ").Concat((List<dynamic>)" & rhs & ").ToList()"
    is IrConsList -> "new List<dynamic> { " & lhs & " }.Concat((List<dynamic>)" & rhs & ").ToList()"

  FlatApply = record { root : IRExpr, args : List IRExpr }

  collect-apply-chain : IRExpr, List IRExpr -> FlatApply
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> FlatApply { root = e, args = acc }

  emit-wf-apply : IRExpr, List ArityEntry, Integer -> Text
  emit-wf-apply (e) (arities) (indent) =
   let chain = collect-apply-chain e []
   in emit-wf-expr (chain.root) arities indent & "(" & emit-wf-elems (chain.args) arities indent 0 & ")"

  wf-lam-func-type : Integer, Integer -> Text
  wf-lam-func-type (n) (i) =
   if i > n then "" else (if i > 0 then ", " else "") & "dynamic" & wf-lam-func-type n (i + 1)

  emit-wf-params : List IRParam, Integer -> Text
  emit-wf-params (params) (i) =
   if i == list-length params then ""
   else let sep = if i > 0 then ", " else ""
   in sep & "dynamic " & wf-sanitize (list-at params i).name & emit-wf-params params (i + 1)

  emit-wf-elems : List IRExpr, List ArityEntry, Integer, Integer -> Text
  emit-wf-elems (elems) (arities) (indent) (i) =
   if i == list-length elems then ""
   else let sep = if i > 0 then ", " else ""
   in sep & emit-wf-expr (list-at elems i) arities indent & emit-wf-elems elems arities indent (i + 1)

 The IR spells a record field as `name/slot`. The construction side above
 writes the field name RAW into the map key, so the read side must strip
 the slot and sanitize nothing, or the two keys stop matching and the
 lookup misses in silence.

  wf-slash-pos : Text, Integer, Integer -> Integer
  wf-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else wf-slash-pos f (i + 1) len

  wf-field : Text -> Text
  wf-field (f) =
   let slash = wf-slash-pos f 0 (text-length f)
   in if slash >= 0 then substring f 0 slash
      else f

  emit-wf-rec-fields : List IRFieldVal, List ArityEntry, Integer, Integer -> Text
  emit-wf-rec-fields (fields) (arities) (indent) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in ", [\"" & f.name & "\"] = " & emit-wf-expr (f.value) arities indent & emit-wf-rec-fields fields arities indent (i + 1)

  emit-wf-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-wf-match (scrut) (branches) (arities) (indent) =
   "((Func<dynamic>)(() => { dynamic _s = " & emit-wf-expr scrut arities indent & "; " & emit-wf-branches branches arities indent 0 & "throw new Exception(\"match\"); }))()"

  emit-wf-branches : List IRBranch, List ArityEntry, Integer, Integer -> Text
  emit-wf-branches (branches) (arities) (indent) (i) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in let cond = emit-wf-pat-cond (b.pattern) "_s"
   in let binds = emit-wf-pat-binds (b.pattern) "_s"
   in "if (" & cond & ") { " & binds & "return " & emit-wf-expr (b.body) arities indent & "; } " & emit-wf-branches branches arities indent (i + 1)

  emit-wf-pat-cond : IRPat, Text -> Text
  emit-wf-pat-cond (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "true"
    is IrLitPat (text) (ty) (sp) -> "object.Equals(" & scrut & ", (dynamic)" & text & ")"
    is IrCtorPat (name) (subs) (ty) (sp) -> "(string)" & scrut & "[\"_tag\"] == \"" & name & "\""
    is IrWildPat (sp) -> "true"
    is IrVecPat (pats) (ty) (sp) -> "true"

  emit-wf-pat-binds : IRPat, Text -> Text
  emit-wf-pat-binds (p) (scrut) =
   when p
    is IrVarPat (name) (ty) (sp) -> "dynamic " & wf-sanitize name & " = " & scrut & "; "
    is IrLitPat (text) (ty) (sp) -> ""
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-wf-ctor-binds subs scrut 0
    is IrWildPat (sp) -> ""
    is IrVecPat (pats) (ty) (sp) -> ""

  emit-wf-ctor-binds : List IRPat, Text, Integer -> Text
  emit-wf-ctor-binds (subs) (scrut) (i) =
   if i == list-length subs then ""
   else emit-wf-pat-binds (list-at subs i) (scrut & "[\"_" & show i & "\"]") & emit-wf-ctor-binds subs scrut (i + 1)

  emit-wf-act : List IRActStmt, List ArityEntry, Integer -> Text
  emit-wf-act (stmts) (arities) (indent) =
   "((Func<dynamic>)(() => { " & emit-wf-act-loop stmts arities indent 0 & " }))()"

  emit-wf-act-loop : List IRActStmt, List ArityEntry, Integer, Integer -> Text
  emit-wf-act-loop (stmts) (arities) (indent) (i) =
   if i == list-length stmts then ""
   else let s = list-at stmts i
   in let is-last = i == list-length stmts - 1
   in when s
    is IrDoBind (name) (ty) (val) (sp) -> "dynamic " & wf-sanitize name & " = " & emit-wf-expr val arities indent & "; " & emit-wf-act-loop stmts arities indent (i + 1)
    is IrDoExec (e) (sp) -> if is-last then "return " & emit-wf-expr e arities indent & "; " else emit-wf-expr e arities indent & "; " & emit-wf-act-loop stmts arities indent (i + 1)

Section: Type and Definition Emission

  emit-wf-type-def : ATypeDef -> Text
  emit-wf-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) -> ""
    is AVariantTypeDef (name) (tparams) (ctors) (s) -> emit-wf-var-ctors ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-wf-var-ctors : List AVariantCtorDef, Integer -> Text
  emit-wf-var-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in let t = if n == 0 then wf-indent 2 & "static readonly Dictionary<string,dynamic> " & wf-sanitize (c.name.value) & " = new() { [\"_tag\"] = \"" & c.name.value & "\" };\n"
      else wf-indent 2 & "static Dictionary<string,dynamic> " & wf-sanitize (c.name.value) & "(" & emit-wf-ctor-p n 0 & ") => new() { [\"_tag\"] = \"" & c.name.value & "\"" & emit-wf-ctor-f n 0 & " };\n"
   in t & emit-wf-var-ctors ctors (i + 1)

  emit-wf-ctor-p : Integer, Integer -> Text
  emit-wf-ctor-p (n) (i) =
   if i == n then "" else let sep = if i > 0 then ", " else "" in sep & "dynamic _" & show i & emit-wf-ctor-p n (i + 1)

  emit-wf-ctor-f : Integer, Integer -> Text
  emit-wf-ctor-f (n) (i) =
   if i == n then "" else ", [\"_" & show i & "\"] = _" & show i & emit-wf-ctor-f n (i + 1)

  emit-wf-def : IRDef, List ArityEntry -> Text
  emit-wf-def (d) (arities) =
   if text-length (d.name) == 0 then ""
   else let sname = wf-sanitize (d.name)
   in if list-length (d.params) == 0
      then wf-indent 2 & "static dynamic " & sname & " = " & emit-wf-expr (d.body) arities 2 & ";\n\n"
      else wf-indent 2 & "static dynamic " & sname & "(" & emit-wf-params (d.params) 0 & ") {\n" & wf-indent 3 & "return " & emit-wf-expr (d.body) arities 3 & ";\n" & wf-indent 2 & "}\n\n"

  emit-wf-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-wf-defs (defs) (i) (arities) =
   if i == list-length defs then "" else emit-wf-def (list-at defs i) arities & emit-wf-defs defs (i + 1) arities

  emit-wf-type-defs : List ATypeDef, Integer -> Text
  emit-wf-type-defs (tds) (i) =
   if i == list-length tds then "" else emit-wf-type-def (list-at tds i) & emit-wf-type-defs tds (i + 1)

Section: Widget Mapping

  WidgetCase = record {
   wc-tag : Text,
   wc-body : Text
  }

  wf-case-label : WidgetCase
  wf-case-label = WidgetCase {
   wc-tag = "WkLabel",
   wc-body = wf-indent 5 & "var lbl = new Label { Text = (string)kind[\"_0\"], AutoSize = true, Padding = new Padding(4) };\n" & wf-indent 5 & "return lbl;\n"
  }

  wf-case-button : WidgetCase
  wf-case-button = WidgetCase {
   wc-tag = "WkButton",
   wc-body = let line1 = wf-indent 5 & "var btn = new Button { Text = (string)kind[\"_0\"], AutoSize = true, Padding = new Padding(8, 4, 8, 4) };\n"
    in let line2 = wf-indent 5 & "var id = d.ContainsKey(\"wn-id\") ? (string)d[\"wn-id\"] : \"\";\n"
    in let line3 = wf-indent 5 & "btn.Click += (s, e) => { _output.Add(\"click:\" + id); };\n"
    in let line4 = wf-indent 5 & "return btn;\n"
    in line1 & line2 & line3 & line4
  }

  wf-case-gauge : WidgetCase
  wf-case-gauge = WidgetCase {
   wc-tag = "WkGauge",
   wc-body = let line1 = wf-indent 5 & "var val = (int)(long)kind[\"_0\"]; var max = (int)(long)kind[\"_1\"];\n"
    in let line2 = wf-indent 5 & "if (max < 1) max = 1000;\n"
    in let line3 = wf-indent 5 & "var tb = new TrackBar { Minimum = 0, Maximum = max, Value = Math.Min(val, max), TickFrequency = max/10, Width = 200 };\n"
    in let line4 = wf-indent 5 & "return tb;\n"
    in line1 & line2 & line3 & line4
  }

  wf-case-input : WidgetCase
  wf-case-input = WidgetCase {
   wc-tag = "WkInput",
   wc-body = wf-indent 5 & "var txt = new TextBox { Text = (string)kind[\"_0\"], Width = 300 };\n" & wf-indent 5 & "return txt;\n"
  }

  wf-case-separator : WidgetCase
  wf-case-separator = WidgetCase {
   wc-tag = "WkSeparator",
   wc-body = wf-indent 5 & "var sep = new Label { Height = 2, BackColor = Color.Gray, Dock = DockStyle.Top };\n" & wf-indent 5 & "return sep;\n"
  }

  wf-panel-body : Text
  wf-panel-body =
   let line1 = wf-indent 5 & "var dir = d.ContainsKey(\"wn-layout-dir\") ? d[\"wn-layout-dir\"] : null;\n"
   in let line2 = wf-indent 5 & "bool isCol = dir != null && ((Dictionary<string,dynamic>)dir)[\"_tag\"] == \"DirColumn\";\n"
   in let line3 = wf-indent 5 & "var panel = new FlowLayoutPanel { FlowDirection = isCol ? FlowDirection.TopDown : FlowDirection.LeftToRight, AutoSize = true, WrapContents = false, Padding = new Padding(4) };\n"
   in let line4 = wf-indent 5 & "if (d.ContainsKey(\"wn-children\")) {\n"
   in let line5 = wf-indent 6 & "var kids = (List<dynamic>)d[\"wn-children\"];\n"
   in let line6 = wf-indent 6 & "foreach (var kid in kids) panel.Controls.Add(build_widget(kid));\n"
   in let line7 = wf-indent 5 & "}\n" & wf-indent 5 & "return panel;\n"
   in line1 & line2 & line3 & line4 & line5 & line6 & line7

  wf-widget-cases : List WidgetCase
  wf-widget-cases = [wf-case-label, wf-case-button, wf-case-gauge, wf-case-input, wf-case-separator]

  emit-wf-switch-case : WidgetCase, Integer -> Text
  emit-wf-switch-case (wc) (indent) =
   wf-indent indent & "case \"" & wc.wc-tag & "\": {\n" & wc.wc-body & wf-indent indent & "}\n"

  emit-wf-switch-cases : List WidgetCase, Integer, Integer -> Text
  emit-wf-switch-cases (cases) (indent) (i) =
   if i == list-length cases then wf-indent indent & "case \"WkPanel\": default: {\n" & wf-panel-body & wf-indent indent & "}\n"
   else emit-wf-switch-case (list-at cases i) indent & emit-wf-switch-cases cases indent (i + 1)

  wf-widget-builder : Text
  wf-widget-builder =
   let sig = wf-indent 2 & "static Control build_widget(dynamic node) {\n"
   in let guard = wf-indent 3 & "if (node == null) return new Panel();\n"
   in let unpack = wf-indent 3 & "var d = (Dictionary<string,dynamic>)node;\n" & wf-indent 3 & "var kind = (Dictionary<string,dynamic>)d[\"wn-kind\"];\n" & wf-indent 3 & "var tag = (string)kind[\"_tag\"];\n"
   in let switch-open = wf-indent 3 & "switch (tag) {\n"
   in let switch-body = emit-wf-switch-cases wf-widget-cases 4 0
   in let switch-close = wf-indent 3 & "}\n"
   in let close = wf-indent 2 & "}\n\n"
   in sig & guard & unpack & switch-open & switch-body & switch-close & close

Section: Builtin Definitions

  wf-bi-fields : Text
  wf-bi-fields =
   let f1 = wf-indent 2 & "static readonly List<string> _output = new();\n"
   in let f2 = wf-indent 2 & "static readonly Dictionary<string, dynamic> _state = new();\n"
   in let f3 = wf-indent 2 & "static readonly Dictionary<string, Control> _controls = new();\n"
   in let f4 = wf-indent 2 & "static Form _form;\n"
   in let f5 = wf-indent 2 & "static Action _renderCallback;\n"
   in let f6 = wf-indent 2 & "static long _nextId = 1;\n"
   in f1 & f2 & f3 & f4 & f5 & f6 & "\n"

  wf-bi-io : Text
  wf-bi-io =
   let p1 = wf-indent 2 & "static void print_line_uni(dynamic s) { _output.Add(s?.ToString() ?? \"\"); }\n"
   in let p2 = wf-indent 2 & "static void print_line(dynamic s) { print_line_uni(s); }\n"
   in let p3 = wf-indent 2 & "static string read_line() { return Microsoft.VisualBasic.Interaction.InputBox(\"Input\", \"Read Line\", \"\"); }\n"
   in p1 & p2 & p3

  wf-bi-conv : Text
  wf-bi-conv =
   let c1 = wf-indent 2 & "static string show(dynamic n) { return n?.ToString() ?? \"\"; }\n"
   in let c2 = wf-indent 2 & "static string integer_to_text(long n) { return n.ToString(); }\n"
   in let c3 = wf-indent 2 & "static long negate(long n) { return -n; }\n"
   in let c4 = wf-indent 2 & "static long text_to_int(dynamic s) { return long.TryParse((string)s, out var v) ? v : 0L; }\n"
   in let c5 = wf-indent 2 & "static long real_to_int(dynamic d) { return (long)(double)d; }\n"
   in let c6 = wf-indent 2 & "static double int_to_real(dynamic n) { return (double)(long)n; }\n"
   in c1 & c2 & c3 & c4 & c5 & c6

  wf-bi-text : Text
  wf-bi-text =
   let t1 = wf-indent 2 & "static long text_length(dynamic s) { return ((string)s).Length; }\n"
   in let t2 = wf-indent 2 & "static string text_replace(dynamic s, dynamic a, dynamic b) { var o = (string)a; return o.Length == 0 ? (string)s : ((string)s).Replace(o, (string)b); }\n"
   in let t3 = wf-indent 2 & "static long text_compare(dynamic a, dynamic b) { return string.Compare((string)a, (string)b, StringComparison.Ordinal); }\n"
   in let t4 = wf-indent 2 & "static bool text_contains(dynamic s, dynamic sub) { return ((string)s).Contains((string)sub); }\n"
   in let t5 = wf-indent 2 & "static bool text_starts_with(dynamic s, dynamic pre) { return ((string)s).StartsWith((string)pre); }\n"
   in let t6 = wf-indent 2 & "static bool text_ends_with(dynamic s, dynamic suf) { return ((string)s).EndsWith((string)suf); }\n"
   in let t7 = wf-indent 2 & "static string text_trim(dynamic s) { return ((string)s).Trim(); }\n"
   in let t8 = wf-indent 2 & "static string text_to_lower(dynamic s) { return ((string)s).ToLowerInvariant(); }\n"
   in let t9 = wf-indent 2 & "static string text_to_upper(dynamic s) { return ((string)s).ToUpperInvariant(); }\n"
   in let t10 = wf-indent 2 & "static long text_index_of(dynamic s, dynamic sub) { return ((string)s).IndexOf((string)sub); }\n"
   in let t11 = wf-indent 2 & "static string text_slice(dynamic s, dynamic start, dynamic end_) { var str = (string)s; return str.Substring((int)(long)start, (int)((long)end_ - (long)start)); }\n"
   in let t12 = wf-indent 2 & "static string text_substring(dynamic s, dynamic start, dynamic len) { return ((string)s).Substring((int)(long)start, (int)(long)len); }\n"
   in let grp1 = t1 & t2 & t3 & t4 & t5 & t6
   in let grp2 = t7 & t8 & t9 & t10 & t11 & t12
   in let t13 = wf-indent 2 & "static List<dynamic> text_split(dynamic s, dynamic sep) { return ((string)s).Split(new[]{ (string)sep }, StringSplitOptions.None).Cast<dynamic>().ToList(); }\n"
   in let t14 = wf-indent 2 & "static string text_join(dynamic sep, dynamic parts) { return string.Join((string)sep, ((List<dynamic>)parts).Select(x => x?.ToString() ?? \"\")); }\n"
   in let t15 = wf-indent 2 & "static long text_to_integer(dynamic s) { var t = (string)s; int i = 0; bool neg = false; if (t.Length > 0 && t[0] == '-') { neg = true; i = 1; } long v = 0; while (i < t.Length && t[i] >= '0' && t[i] <= '9') { v = v * 10 + (t[i] - '0'); i++; } return neg ? -v : v; }\n"
   in grp1 & grp2 & t13 & t14 & t15

  wf-bi-char : Text
  wf-bi-char =
