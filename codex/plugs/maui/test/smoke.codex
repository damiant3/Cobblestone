Chapter: MauiSmoke
  cites UI chapter Widget
  cites UI chapter Theme
  cites UI chapter Layout

Section: Runtime Stubs

  state-get : Text -> Integer
  state-get (k) = 0
  state-set : Text, Integer -> Integer
  state-set (k) (v) = v
  state-get-text : Text -> Text
  state-get-text (k) = ""
  state-set-text : Text, Text -> Text
  state-set-text (k) (v) = v
  mount-widget : WidgetNode -> Integer
  mount-widget (n) = 0
  mount-widget-themed : Theme, WidgetNode -> Integer
  mount-widget-themed (th) (n) = 0
  mount-widget-into : Text, WidgetNode -> Integer
  mount-widget-into (id) (n) = 0
  register-handlers : (Text, Integer -> Integer), (Text -> Integer) -> Integer
  register-handlers (on-pick) (on-click) = 0
  set-render : (Integer -> Integer) -> Integer
  set-render (fn) = 0
  request-render : Integer -> Integer
  request-render (x) = 0
  state-set-render : Text, Integer -> Integer
  state-set-render (k) (v) = v
  state-set-text-render : Text, Text -> Text
  state-set-text-render (k) (v) = v
  show-alert : Text, Text, (Text -> Integer) -> Integer
  show-alert (title) (msg) (cb) = 0
  show-confirm : Text, Text, (Text -> Integer) -> Integer
  show-confirm (title) (msg) (cb) = 0
  close-dialog : Integer -> Integer
  close-dialog (x) = 0
  inject-theme-css : Theme -> Integer
  inject-theme-css (th) = 0
  int-to-css-color : Integer -> Text
  int-to-css-color (n) = ""

Section: State Keys

  sk-count : Text = "count"
  sk-name : Text = "name"

Section: Render

  render : Integer -> Integer
  render (x) =
   let count = state-get sk-count
   in let name = state-get-text sk-name
   in let greeting = if text-length name > 0 then "Hello, " & name & "!" else "Hello, World!"
   in let tree = widget-panel "root" DirColumn 12 [
     widget-label "title" "Codex MAUI Smoke Test",
     widget-separator "sep1",
     widget-panel "greeting-row" DirRow 8 [
       widget-label "greet" greeting,
       widget-gauge "counter" count 20
     ],
     widget-panel "btn-row" DirRow 8 [
       widget-button "inc" "+1",
       widget-button "dec" "-1",
       widget-button "reset" "Reset"
     ],
     widget-input "name-input" "Enter your name" 0,
     widget-separator "sep2",
     widget-panel "status-row" DirColumn 4 [
       widget-label "count-lbl" ("Count: " & show count),
       widget-label "theme-lbl" "Theme: terminal",
       widget-label "features-lbl" "Panel | Label | Button | Gauge | Separator | Input"
     ]
   ]
   in let m = mount-widget-themed theme-terminal tree
   in 0

Section: Event Handlers

  on-pick : Text, Integer -> Integer
  on-pick (group) (idx) =
   state-set-render group idx

  on-click : Text -> Integer
  on-click (id) =
   if id == "inc" then state-set-render sk-count (state-get sk-count + 1)
   else if id == "dec" then state-set-render sk-count (state-get sk-count - 1)
   else if id == "reset" then state-set-render sk-count 0
   else 0

Section: Entry

  opening : [Console] Nothing = act
    let s1 = state-set sk-count 0
    in let s2 = state-set-text sk-name ""
    in let s3 = set-render (render)
    in let h = register-handlers (on-pick) (on-click)
    in let r = render 0
    in print-line "MAUI smoke test initialized"
  end
