Chapter: RecheckBounds
  cites Recheck chapter RecheckCore

Section: Ranges

  RcRange = record {
   rr-lo : Integer,
   rr-hi : Integer,
   rr-known : Boolean
  }

  rc-range : Integer, Integer -> RcRange
  rc-range (lo) (hi) = RcRange { rr-lo = lo, rr-hi = hi, rr-known = True }

 This is a module-level record and so allocates on every MENTION rather
 than once, which this tree measures at the same cost as rebuilding it in
 the loop. Left that way knowingly: there is no cheaper form for a record
 value short of threading one through every derivation, the record is
 three fields, and the derivation is fuel-capped per slot. The
 list-constant form of this trap is the one that matters, and that one is
 fixed in RecheckWellFormed rather than annotated.

  rc-range-unknown : RcRange
  rc-range-unknown = RcRange { rr-lo = 0, rr-hi = 0, rr-known = False }

  rc-derive-guard : Integer = 2147483647

  rc-range-small : RcRange -> Boolean
  rc-range-small (r) =
   if r.rr-known == False then False
   else r.rr-lo > (0 - rc-derive-guard) & r.rr-hi < rc-derive-guard

  rc-min : Integer, Integer -> Integer
  rc-min (a) (b) = if a < b then a else b

  rc-max : Integer, Integer -> Integer
  rc-max (a) (b) = if a > b then a else b

  rc-min4 : Integer, Integer, Integer, Integer -> Integer
  rc-min4 (a) (b) (c) (d) = rc-min (rc-min a b) (rc-min c d)

  rc-max4 : Integer, Integer, Integer, Integer -> Integer
  rc-max4 (a) (b) (c) (d) = rc-max (rc-max a b) (rc-max c d)

  rc-range-union : RcRange, RcRange -> RcRange
  rc-range-union (a) (b) =
   if a.rr-known == False | b.rr-known == False then rc-range-unknown
   else rc-range (rc-min (a.rr-lo) (b.rr-lo)) (rc-max (a.rr-hi) (b.rr-hi))

  rc-range-within : RcRange, Integer, Integer -> Boolean
  rc-range-within (r) (lo) (hi) = lo <= r.rr-lo & r.rr-hi <= hi

Section: Let Bindings

  RcBind = record {
   rb-name : Text,
   rb-range : RcRange
  }

  rc-bind-lookup : List RcBind, Text, Integer -> RcRange
  rc-bind-lookup (bs) (n) (i) =
   if i < 0 then rc-range-unknown
   else let b = list-at bs i
   in if b.rb-name == n then b.rb-range else rc-bind-lookup bs n (i - 1)

  rc-bind-push : List RcBind, Text, RcRange -> List RcBind
  rc-bind-push (env) (n) (r) =
   if r.rr-known == False then env
   else list-push env (RcBind { rb-name = n, rb-range = r })

Section: Bounded Slots

  rc-i64-max : Integer = 9223372036854775807
  rc-i64-min : Integer = 0 - 9223372036854775807 - 1

  rc-is-bounded-int : CodexType -> Boolean
  rc-is-bounded-int (t) =
   when t
    is IntegerTy (lo) (hi) (m) -> lo > rc-i64-min | hi < rc-i64-max
    is otherwise -> False

  rc-int-lo : CodexType -> Integer
  rc-int-lo (t) = when t is IntegerTy (lo) (hi) (m) -> lo is otherwise -> rc-i64-min

  rc-int-hi : CodexType -> Integer
  rc-int-hi (t) = when t is IntegerTy (lo) (hi) (m) -> hi is otherwise -> rc-i64-max

  rc-ty-range : CodexType -> RcRange
  rc-ty-range (t) =
   when t
    is IntegerTy (lo) (hi) (m) -> rc-range lo hi
    is otherwise -> rc-range-unknown

Section: Module Constants

 A name bound at module level to an integer literal is a row the guide's
 Static Bounds Prover table publishes and the compiler proves. It cannot be
 read off the name's declared type, which is a plain Integer and so carries
 the full i64 band; only the defining chapter says 3003.

 The table is a separate argument rather than the initial let environment
 because a let PUSHES onto that environment during a derivation, and with
 the table in it every push would copy the whole table. It is consulted
 after a let binding and after a bounded declared type, so it never
 overrides a more local answer.

 A constant whose name is ever a PARAMETER is dropped when the table is
 built. A parameter and a module constant are both an IrName on the wire
 with nothing to tell them apart, so a shared name would hand a parameter
 the constant's range, and a checker that derives a wrong range is worse
 than one that abstains. Dropping it once per chapter costs nothing per
 definition and fails in the safe direction: the constant stops being
 derivable rather than being believed in the wrong place.

  rc-name-in-params : List IRParam, Text, Integer -> Boolean
  rc-name-in-params (ps) (n) (i) =
   if i < 0 then False
   else if ((list-at ps i).name) == n then True
   else rc-name-in-params ps n (i - 1)

  rc-name-any-param : List IRDef, Text, Integer, Integer -> Boolean
  rc-name-any-param (ds) (n) (i) (len) =
   if i >= len then False
   else let d = list-at ds i
   in if rc-name-in-params (d.params) n (list-length (d.params) - 1) then True
   else rc-name-any-param ds n (i + 1) len

  rc-const-of-def : IRDef -> RcRange
  rc-const-of-def (d) =
   if list-length (d.params) > 0 then rc-range-unknown
   else when (d.body)
    is IrIntLit (v) (sp) -> rc-range v v
    is otherwise -> rc-range-unknown

  rc-consts-of : List IRDef, Integer, Integer, List RcBind -> List RcBind
  rc-consts-of (ds) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in let r = rc-const-of-def d
   in if r.rr-known == False then rc-consts-of ds (i + 1) len acc
   else if rc-name-any-param ds (d.name) 0 len then rc-consts-of ds (i + 1) len acc
   else rc-consts-of ds (i + 1) len (list-push acc (RcBind { rb-name = d.name, rb-range = r }))

  rc-const-lookup : List RcBind, Text -> RcRange
  rc-const-lookup (cs) (n) = rc-bind-lookup cs n (list-length cs - 1)

Section: Derivation

  rc-is-named : IRExpr, Text -> Boolean
  rc-is-named (f) (nm) =
   when f
    is IrName (n) (t) (sp) -> n == nm
    is otherwise -> False

  rc-is-narrow-call : IRExpr -> Boolean
  rc-is-narrow-call (x) =
   when x
    is IrApply (f) (a) (t) (sp) -> rc-is-narrow-name f
    is otherwise -> False

  rc-is-narrow-name : IRExpr -> Boolean
  rc-is-narrow-name (f) = rc-is-named f "__narrow"

  rc-derive : List RcBind, List RcBind, IRExpr, Integer -> RcRange
  rc-derive (cs) (env) (x) (fuel) =
   if fuel <= 0 then rc-range-unknown
   else when x
    is IrIntLit (v) (sp) -> rc-range v v
    is IrName (n) (t) (sp) -> rc-derive-name cs env n t
    is IrNegate (v) (t) (sp) -> rc-derive-negate (rc-derive cs env v (fuel - 1))
    is IrIf (c) (a) (b) (t) (sp) -> rc-range-union (rc-derive cs env a (fuel - 1)) (rc-derive cs env b (fuel - 1))
    is IrLet (n) (t) (v) (b) (sp) -> rc-derive cs (rc-bind-push env n (rc-derive cs env v (fuel - 1))) b (fuel - 1)
    is IrMatch (s) (bs) (t) (sp) -> rc-derive-arms cs env bs 0 (list-length bs) (fuel - 1)
    is IrFieldAccess (r) (f) (t) (sp) -> rc-ty-range t
    is IrApply (f) (a) (t) (sp) -> rc-derive-apply cs env x f a t (fuel - 1)
    is IrBinary (o) (l) (r) (t) (sp) -> rc-derive-binary o (rc-derive cs env l (fuel - 1)) (rc-derive cs env r (fuel - 1))
    is otherwise -> rc-range-unknown

  rc-derive-name : List RcBind, List RcBind, Text, CodexType -> RcRange
  rc-derive-name (cs) (env) (n) (t) =
   let b = rc-bind-lookup env n (list-length env - 1)
   in if b.rr-known then b
   else if rc-is-nullary-heap-builtin n then rc-heap-quantity-range
   else if rc-is-bounded-int t then rc-ty-range t
   else rc-const-lookup cs n

 A `when` is the match form of an `if` and carries the same rule, the union
 of the arms. An arm whose own range is unknown makes the union unknown,
 which `rc-range-union` already does, and a match with no arms answers
 unknown rather than an empty union.

  rc-derive-arms : List RcBind, List RcBind, List IRBranch, Integer, Integer, Integer -> RcRange
  rc-derive-arms (cs) (env) (bs) (i) (len) (fuel) =
   if i >= len then rc-range-unknown
   else if i == len - 1 then rc-derive cs env ((list-at bs i).body) fuel
   else rc-range-union (rc-derive cs env ((list-at bs i).body) fuel) (rc-derive-arms cs env bs (i + 1) len fuel)

 Five builtins carry a range their SIGNATURE does not: all five are declared
 to return a plain Integer, and the bound is a structural fact about
 heap-backed quantities in a 3 GB-RAM design rather than anything in the
 type. Published in the guide's Static Bounds Prover table; the compiler
 holds the same five in `builtin-return-range`. Two are nullary and reach
 the derivation as a bare name, the other three as an application.

  rc-heap-quantity-range : RcRange
  rc-heap-quantity-range = rc-range 0 4294967295

  rc-is-nullary-heap-builtin : Text -> Boolean
  rc-is-nullary-heap-builtin (n) = n == "__heap-save" | n == "__deck-pos"

  rc-is-applied-heap-builtin : Text -> Boolean
  rc-is-applied-heap-builtin (n) =
   n == "list-length" | n == "text-length" | n == "__buf-write-bytes"

  rc-applied-builtin-range : IRExpr -> RcRange
  rc-applied-builtin-range (f) =
   when f
    is IrName (n) (t) (sp) -> if rc-is-applied-heap-builtin n then rc-heap-quantity-range else rc-range-unknown
    is otherwise -> rc-range-unknown

  rc-derive-negate : RcRange -> RcRange
  rc-derive-negate (r) =
   if r.rr-known == False then rc-range-unknown
   else rc-range (0 - r.rr-hi) (0 - r.rr-lo)

  rc-derive-apply : List RcBind, List RcBind, IRExpr, IRExpr, IRExpr, CodexType, Integer -> RcRange
  rc-derive-apply (cs) (env) (whole) (f) (a) (t) (fuel) =
   if rc-is-narrow-name f then rc-derive cs env a fuel
   else if rc-is-int-mod-partial f then rc-derive-int-mod (rc-derive cs env a fuel)
   else let br = rc-applied-builtin-range f
   in if br.rr-known then br
   else rc-ty-range t

  rc-is-int-mod-partial : IRExpr -> Boolean
  rc-is-int-mod-partial (f) =
   when f
    is IrApply (g) (x) (gt) (sp) -> rc-is-named g "int-mod"
    is otherwise -> False

  rc-derive-int-mod : RcRange -> RcRange
  rc-derive-int-mod (d) =
   if d.rr-known == False then rc-range-unknown
   else if d.rr-lo <= 0 then rc-range-unknown
   else rc-range 0 (d.rr-hi - 1)

  rc-derive-binary : IRBinaryOp, RcRange, RcRange -> RcRange
  rc-derive-binary (op) (a) (b) =
   if rc-range-small a == False | rc-range-small b == False then rc-range-unknown
   else when op
    is IrAddInt -> rc-range (a.rr-lo + b.rr-lo) (a.rr-hi + b.rr-hi)
    is IrSubInt -> rc-range (a.rr-lo - b.rr-hi) (a.rr-hi - b.rr-lo)
    is IrMulInt -> rc-derive-mul a b
    is IrDivInt -> rc-derive-div a b
    is IrRemInt -> rc-derive-rem b
    is otherwise -> rc-range-unknown

 Multiplication of signed bands is not monotone in either endpoint, so all
 four corner products are taken rather than the lo-lo and hi-hi pair the
 non-negative case would allow.

  rc-derive-mul : RcRange, RcRange -> RcRange
  rc-derive-mul (a) (b) =
   let p1 = a.rr-lo * b.rr-lo
   in let p2 = a.rr-lo * b.rr-hi
   in let p3 = a.rr-hi * b.rr-lo
   in let p4 = a.rr-hi * b.rr-hi
   in rc-range (rc-min4 p1 p2 p3 p4) (rc-max4 p1 p2 p3 p4)

 Integer division truncates toward zero, which is monotone in both operands
 only while the dividend is non-negative and the divisor is strictly
 positive. Outside that quadrant the endpoints do not bound the quotient
 and a divisor band spanning zero admits a division by zero, so the answer
 is unknown rather than a wider band. Those are the preconditions the
 guide's Static Bounds Prover table states for this row.

  rc-derive-div : RcRange, RcRange -> RcRange
  rc-derive-div (a) (b) =
   if a.rr-lo < 0 | b.rr-lo <= 0 then rc-range-unknown
   else rc-range (a.rr-lo / b.rr-hi) (a.rr-hi / b.rr-lo)

 A truncating remainder takes the sign of the dividend and is bounded by
 the divisor's magnitude, so without knowing the dividend's sign the safe
 band is symmetric.

  rc-derive-rem : RcRange -> RcRange
  rc-derive-rem (b) =
   let m = rc-max (rc-abs (b.rr-lo)) (rc-abs (b.rr-hi))
   in if m <= 0 then rc-range-unknown
   else rc-range (0 - (m - 1)) (m - 1)

  rc-abs : Integer -> Integer
  rc-abs (n) = if n < 0 then 0 - n else n

Section: The Narrowing Sites

  rc-bnd-expr : RcWalk, List RcBind, Text, IRExpr -> RcWalk
  rc-bnd-expr (w) (cs) (d) (x) =
   if rc-dry w then w
   else rc-bnd-go (rc-burn w) cs d x

  rc-bnd-go : RcWalk, List RcBind, Text, IRExpr -> RcWalk
  rc-bnd-go (w) (cs) (d) (x) =
   when x
    is IrApply (f) (a) (t) (sp) -> rc-bnd-apply w cs d f a
    is IrBinary (o) (l) (r) (t) (sp) -> rc-bnd-expr (rc-bnd-expr w cs d l) cs d r
    is IrNegate (v) (t) (sp) -> rc-bnd-expr w cs d v
    is IrIf (c) (a) (b) (t) (sp) -> rc-bnd-expr (rc-bnd-expr (rc-bnd-expr w cs d c) cs d a) cs d b
    is IrLet (n) (t) (v) (b) (sp) -> rc-bnd-expr (rc-bnd-expr w cs d v) cs d b
    is IrLambda (ps) (b) (t) (sp) -> rc-bnd-expr w (rc-consts-minus cs ps) d b
    is IrList (es) (t) (sp) -> rc-bnd-list w cs d es 0 (list-length es)
    is IrMatch (s) (bs) (t) (sp) -> rc-bnd-branches (rc-bnd-expr w cs d s) cs d bs 0 (list-length bs)
    is IrAct (ss) (t) (sp) -> rc-bnd-stmts w cs d ss 0 (list-length ss)
    is IrFieldAccess (r) (f) (t) (sp) -> rc-bnd-expr w cs d r
    is IrFieldStore (r) (f) (v) (t) (sp) -> rc-bnd-expr (rc-bnd-expr w cs d r) cs d v
    is IrRecord (n) (fs) (t) (sp) -> rc-bnd-fieldvals w cs d fs 0 (list-length fs)
    is IrFork (b) (t) (sp) -> rc-bnd-expr w cs d b
    is IrAwait (b) (t) (sp) -> rc-bnd-expr w cs d b
    is otherwise -> w

 A lambda binder shadows a module constant the same way a parameter does,
 and the chapter-level filter cannot see it. The common answer is that no
 binder collides, and then the table is handed on unchanged with nothing
 allocated.

  rc-consts-minus : List RcBind, List IRParam -> List RcBind
  rc-consts-minus (cs) (ps) =
   if rc-consts-collide cs ps 0 (list-length cs) then rc-consts-filter cs ps 0 (list-length cs) []
   else cs

  rc-consts-collide : List RcBind, List IRParam, Integer, Integer -> Boolean
  rc-consts-collide (cs) (ps) (i) (len) =
   if i >= len then False
   else if rc-name-in-params ps ((list-at cs i).rb-name) (list-length ps - 1) then True
   else rc-consts-collide cs ps (i + 1) len

  rc-consts-filter : List RcBind, List IRParam, Integer, Integer, List RcBind -> List RcBind
  rc-consts-filter (cs) (ps) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at cs i
   in if rc-name-in-params ps (b.rb-name) (list-length ps - 1)
      then rc-consts-filter cs ps (i + 1) len acc
      else rc-consts-filter cs ps (i + 1) len (list-push acc b)

  rc-bnd-list : RcWalk, List RcBind, Text, List IRExpr, Integer, Integer -> RcWalk
  rc-bnd-list (w) (cs) (d) (xs) (i) (len) =
   if i >= len then w
   else rc-bnd-list (rc-bnd-expr w cs d (list-at xs i)) cs d xs (i + 1) len

  rc-bnd-fieldvals : RcWalk, List RcBind, Text, List IRFieldVal, Integer, Integer -> RcWalk
  rc-bnd-fieldvals (w) (cs) (d) (fs) (i) (len) =
   if i >= len then w
   else rc-bnd-fieldvals (rc-bnd-expr w cs d ((list-at fs i).value)) cs d fs (i + 1) len

  rc-bnd-branches : RcWalk, List RcBind, Text, List IRBranch, Integer, Integer -> RcWalk
  rc-bnd-branches (w) (cs) (d) (bs) (i) (len) =
   if i >= len then w
   else rc-bnd-branches (rc-bnd-expr w cs d ((list-at bs i).body)) cs d bs (i + 1) len

  rc-bnd-stmts : RcWalk, List RcBind, Text, List IRActStmt, Integer, Integer -> RcWalk
  rc-bnd-stmts (w) (cs) (d) (ss) (i) (len) =
   if i >= len then w
   else rc-bnd-stmts (rc-bnd-expr w cs d (ir-act-stmt-expr (list-at ss i))) cs d ss (i + 1) len

  rc-bnd-apply : RcWalk, List RcBind, Text, IRExpr, IRExpr -> RcWalk
  rc-bnd-apply (w) (cs) (d) (f) (a) =
   let w1 = rc-bnd-expr (rc-bnd-expr w cs d f) cs d a
   in rc-bnd-param-check w1 cs d f a

  rc-bnd-param-check : RcWalk, List RcBind, Text, IRExpr, IRExpr -> RcWalk
  rc-bnd-param-check (w) (cs) (d) (f) (a) =
   when f
    is IrName (n) (ft) (sp) -> rc-bnd-against-fun w cs d n ft a
    is otherwise -> w

  rc-bnd-against-fun : RcWalk, List RcBind, Text, Text, CodexType, IRExpr -> RcWalk
  rc-bnd-against-fun (w) (cs) (d) (n) (ft) (a) =
   when ft
    is FunTy (p) (row) (r) -> rc-bnd-slot w cs d ("parameter of " & n) p a
    is otherwise -> w

  rc-bnd-slot : RcWalk, List RcBind, Text, Text, CodexType, IRExpr -> RcWalk
  rc-bnd-slot (w) (cs) (d) (site) (slot) (a) =
   if rc-is-bounded-int slot == False then w
   else if rc-is-narrow-call a then w
   else rc-bnd-verdict w d site (rc-int-lo slot) (rc-int-hi slot) (rc-derive cs [] a 400)

  rc-bnd-verdict : RcWalk, Text, Text, Integer, Integer, RcRange -> RcWalk
  rc-bnd-verdict (w) (d) (site) (lo) (hi) (r) =
   if r.rr-known == False
   then rc-add w (rc-finding d RcUnsupported "bounds-underived" ("could not derive a range for the value reaching the " & site))
   else if rc-range-within r lo hi then w
   else rc-add w (rc-finding d RcDisagree "bounds-exceeded" ("value reaching the " & site & " has derived range " & show (r.rr-lo) & ".." & show (r.rr-hi) & " which does not fit the declared " & show lo & ".." & show hi))

Section: Definition Walk

  rc-bnd-return-ty : CodexType, Integer -> CodexType
  rc-bnd-return-ty (t) (fuel) =
   if fuel <= 0 then t
   else when t
    is FunTy (p) (row) (r) -> rc-bnd-return-ty r (fuel - 1)
    is EffectfulTy (e) (s) (r) -> rc-bnd-return-ty r (fuel - 1)
    is otherwise -> t

  rc-bnd-def : RcWalk, List RcBind, IRDef -> RcWalk
  rc-bnd-def (w) (cs) (d) =
   let w1 = rc-bnd-expr w cs (d.name) (d.body)
   in let ret = rc-bnd-return-ty (d.type-val) 32
   in if rc-is-bounded-int ret == False then w1
   else if rc-is-narrow-call (d.body) then w1
   else rc-bnd-verdict w1 (d.name) "declared return type" (rc-int-lo ret) (rc-int-hi ret) (rc-derive cs [] (d.body) 400)

  rc-bnd-chapter : IRChapter, Integer -> RcWalk
  rc-bnd-chapter (ch) (fuel) =
   let cs = rc-consts-of (ch.defs) 0 (list-length (ch.defs)) []
   in rc-bnd-defs (rc-walk-new fuel) cs (ch.defs) 0 (list-length (ch.defs))

  rc-bnd-defs : RcWalk, List RcBind, List IRDef, Integer, Integer -> RcWalk
  rc-bnd-defs (w) (cs) (ds) (i) (len) =
   if i >= len then w
   else rc-bnd-defs (rc-bnd-def w cs (list-at ds i)) cs ds (i + 1) len

