Chapter: RecheckWellFormed
  cites Recheck chapter RecheckCore
  cites Recheck chapter RecheckBuiltins

 This is the stage that would have caught the shape of Lean kernel bug
 14576: a declaration accepted carrying an argument nothing ever checked.

Section: Environment

  RcEnv = record {
   re-locals : List Text,
   re-defs : List Text,
   re-ctors : List Text,
   re-def-name : Text,
   re-typedefs : List ATypeDef,
   re-builtins : List Text,
   re-poly : List RcPolyDef
  }

  rc-env-bind : RcEnv, Text -> RcEnv
  rc-env-bind (e) (n) =
    RcEnv {
      re-locals = list-push (e.re-locals) n,
      re-defs = e.re-defs,
      re-ctors = e.re-ctors,
      re-def-name = e.re-def-name,
      re-typedefs = e.re-typedefs,
      re-builtins = e.re-builtins,
      re-poly = e.re-poly
    }

  rc-env-bind-all : RcEnv, List Text, Integer, Integer -> RcEnv
  rc-env-bind-all (e) (ns) (i) (len) =
    if i >= len then e
    else rc-env-bind-all (rc-env-bind e (list-at ns i)) ns (i + 1) len

  rc-text-member : List Text, Text, Integer, Integer -> Boolean
  rc-text-member (xs) (t) (i) (len) =
    if i >= len then False
    else if list-at xs i == t then True
    else rc-text-member xs t (i + 1) len

  rc-in : List Text, Text -> Boolean
  rc-in (xs) (t) = rc-text-member xs t 0 (list-length xs)

 The builtin names are a FIELD rather than a mention of the list constant,
 and that is not style. A top-level list definition is a recipe, not
 storage: every mention re-materialises the whole list, measured elsewhere
 in this tree at 98.4 MB of heap for 100000 reads of a 121-element
 constant against 1 KB for the same list threaded as a parameter. Name
 resolution runs once per name node in every body, so mentioning the
 259-element table there rebuilt it once per name, permanently, on a heap
 with no collector. It is bound once per chapter and threaded.

  rc-is-intrinsic : Text -> Boolean
  rc-is-intrinsic (n) =
    if text-length n < 2 then False
    else char-code-at n 0 == char-code-at "_" 0 & char-code-at n 1 == char-code-at "_" 0

  rc-resolves : RcEnv, Text -> Boolean
  rc-resolves (e) (n) =
    if rc-in (e.re-locals) n then True
    else if rc-in (e.re-defs) n then True
    else if rc-in (e.re-ctors) n then True
    else if rc-is-intrinsic n then True
    else rc-in (e.re-builtins) n

Section: Node Types

  RcTyOf =
    | RcTyKnown (CodexType)
    | RcTyNone

 The five literal forms carry no CodexType on the wire, so a literal's type
 cannot be read off the IR. `docs/DevelopersGuide.md` "Integer literals"
 gives an integer literal the plain `Integer` type, NOT the range `[n, n]`,
 and settles the bound question separately and by VALUE: a literal handed to
 a bounded parameter is admitted when the value is in range and is CDX2050
 when it is not. `IrNumLit` has no published rule fixing its width or mode.

 The two are different questions and they are answered in different stages.
 `[n, n]` is the literal's VALUE and it belongs to `RecheckBounds`, where
 `rc-derive` uses exactly that. Reading it as the literal's TYPE here is
 what produced this checker's first three disagreements, all of them false:
 it made `(0, x)` declared `(Integer, Integer)` fix the tuple's element type
 to `[0, 0]`, which invariance then refused.

  rc-expr-ty : IRExpr -> RcTyOf
  rc-expr-ty (x) =
    when x
     is IrIntLit (v) (sp) -> RcTyKnown (IntegerTy rc-wf-i64-min rc-wf-i64-max OvError)
     is IrTextLit (v) (sp) -> RcTyKnown TextTy
     is IrBoolLit (v) (sp) -> RcTyKnown BooleanTy
     is IrCharLit (v) (sp) -> RcTyKnown CharTy
     is IrLet (n) (t) (v) (b) (sp) -> rc-expr-ty b
     is IrWithTimeout (ms) (a) (b) (body) (t) (sp) -> RcTyKnown t
     is IrTry (k) (a) (b) (c) (t) (sp) -> RcTyKnown t
     is IrName (n) (t) (sp) -> RcTyKnown t
     is IrBinary (o) (l) (r) (t) (sp) -> RcTyKnown t
     is IrNegate (v) (t) (sp) -> RcTyKnown t
     is IrIf (c) (a) (b) (t) (sp) -> RcTyKnown t
     is IrApply (f) (a) (t) (sp) -> RcTyKnown t
     is IrLambda (ps) (b) (t) (sp) -> RcTyKnown t
     is IrList (es) (t) (sp) -> RcTyKnown (ListTy t)
     is IrMatch (s) (bs) (t) (sp) -> RcTyKnown t
     is IrAct (ss) (t) (sp) -> RcTyKnown t
     is IrHandle (e) (h) (cs) (t) (sp) -> RcTyKnown t
     is IrRecord (n) (fs) (t) (sp) -> RcTyKnown t
     is IrFieldAccess (r) (f) (t) (sp) -> RcTyKnown t
     is IrFieldStore (r) (f) (v) (t) (sp) -> RcTyKnown t
     is IrFork (b) (t) (sp) -> RcTyKnown t
     is IrAwait (b) (t) (sp) -> RcTyKnown t
     is IrError (m) (t) (sp) -> RcTyKnown t
     is otherwise -> RcTyNone

  rc-cmp-tyof : CodexType, RcTyOf -> TyCmp
  rc-cmp-tyof (want) (got) =
    when got
     is RcTyKnown (t) -> rc-ty-eq want t
     is RcTyNone -> TyUnknown

  rc-fits-tyof : CodexType, RcTyOf -> TyCmp
  rc-fits-tyof (want) (got) =
    when got
     is RcTyKnown (t) -> rc-ty-fits t want
     is RcTyNone -> TyUnknown

Section: Constructor Lookup

  rc-find-ctor-fields : List SumCtor, Text, Integer, Integer -> List CodexType
  rc-find-ctor-fields (cs) (name) (i) (len) =
    if i >= len then []
    else let c = list-at cs i
    in if (c.name).value == name then c.fields
    else rc-find-ctor-fields cs name (i + 1) len

  rc-has-ctor : List SumCtor, Text, Integer, Integer -> Boolean
  rc-has-ctor (cs) (name) (i) (len) =
    if i >= len then False
    else if ((list-at cs i).name).value == name then True
    else rc-has-ctor cs name (i + 1) len

Section: Pattern Walk

  rc-pat-names : IRPat, List Text -> List Text
  rc-pat-names (p) (acc) =
    when p
     is IrVarPat (n) (t) (sp) -> list-push acc n
     is IrCtorPat (n) (subs) (t) (sp) -> rc-pat-names-list subs 0 (list-length subs) acc
     is IrVecPat (subs) (t) (sp) -> rc-pat-names-list subs 0 (list-length subs) acc
     is otherwise -> acc

  rc-pat-names-list : List IRPat, Integer, Integer, List Text -> List Text
  rc-pat-names-list (ps) (i) (len) (acc) =
    if i >= len then acc
    else rc-pat-names-list ps (i + 1) len (rc-pat-names (list-at ps i) acc)

  rc-pat-ty : IRPat -> RcTyOf
  rc-pat-ty (p) =
    when p
     is IrVarPat (n) (t) (sp) -> RcTyKnown t
     is IrCtorPat (n) (subs) (t) (sp) -> RcTyKnown t
     is IrVecPat (subs) (t) (sp) -> RcTyKnown t
     is otherwise -> RcTyNone

  rc-check-pat : RcWalk, RcEnv, IRPat -> RcWalk
  rc-check-pat (w) (e) (p) =
    if rc-dry w then w
    else when p
     is IrCtorPat (n) (subs) (t) (sp) -> rc-check-ctor-pat (rc-burn w) e n subs t
     is otherwise -> rc-burn w

  rc-pat-binds-nothing : IRPat -> Boolean
  rc-pat-binds-nothing (p) =
    when p
     is IrWildPat (sp) -> True
     is otherwise -> False

  rc-check-ctor-pat : RcWalk, RcEnv, Text, List IRPat, CodexType -> RcWalk
  rc-check-ctor-pat (w) (e) (n) (subs) (t) =
    when t
     is SumTy (sn) (args) (ctors) ->
      if list-length ctors == 0 then rc-check-ctor-pat-ctd w e n subs (sn.value) args
      else rc-check-ctor-pat-sum w e n subs ctors
     is ConstructedTy (cn) (args) -> rc-check-ctor-pat-ctd w e n subs (cn.value) args
     is otherwise ->
      rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-pat-scrutinee" ("constructor pattern " & n & " over a scrutinee that is neither a sum nor a named type"))

  rc-find-variant : List ATypeDef, Text, Integer, Integer -> List AVariantCtorDef
  rc-find-variant (tds) (name) (i) (len) =
    if i >= len then []
    else when list-at tds i
     is AVariantTypeDef (tn) (tps) (ctors) (sp) -> if tn.value == name then
       ctors
     else rc-find-variant tds name (i + 1) len
     is otherwise -> rc-find-variant tds name (i + 1) len

  rc-variant-tparams : List ATypeDef, Text, Integer, Integer -> List Name
  rc-variant-tparams (tds) (name) (i) (len) =
    if i >= len then []
    else when list-at tds i
     is AVariantTypeDef (tn) (tps) (ctors) (sp) -> if tn.value == name then
       tps
     else rc-variant-tparams tds name (i + 1) len
     is otherwise -> rc-variant-tparams tds name (i + 1) len

  rc-avariant-has : List AVariantCtorDef, Text, Integer, Integer -> Boolean
  rc-avariant-has (cs) (n) (i) (len) =
    if i >= len then False
    else if ((list-at cs i).name).value == n then True
    else rc-avariant-has cs n (i + 1) len

  rc-avariant-fields : List AVariantCtorDef, Text, Integer, Integer -> List ATypeExpr
  rc-avariant-fields (cs) (n) (i) (len) =
    if i >= len then []
    else if ((list-at cs i).name).value == n then (list-at cs i).fields
    else rc-avariant-fields cs n (i + 1) len

  rc-check-ctor-pat-ctd : RcWalk, RcEnv, Text, List IRPat, Text, List CodexType -> RcWalk
  rc-check-ctor-pat-ctd (w) (e) (n) (subs) (tyname) (args) =
    let ctors = rc-find-variant (e.re-typedefs) tyname 0 (list-length (e.re-typedefs))
    in if list-length ctors == 0 then
      rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-pat-scrutinee" ("constructor pattern " & n & " over " & tyname & ", whose declaration is not on this wire"))
    else if rc-avariant-has ctors n 0 (list-length ctors) == False then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-pat-unknown" (n & " is not a constructor of " & tyname))
    else let fields = rc-avariant-fields ctors n 0 (list-length ctors)
    in if list-length fields /= list-length subs then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-pat-arity" (n & " of " & tyname & " declares " & show (list-length fields) & " fields, pattern binds " & show (list-length subs)))
    else
      rc-check-ctd-fields w e n subs fields (rc-variant-tparams (e.re-typedefs) tyname 0 (list-length (e.re-typedefs))) args 0 (list-length subs)

  rc-check-ctd-fields : RcWalk, RcEnv, Text, List IRPat, List ATypeExpr, List Name, List CodexType, Integer, Integer -> RcWalk
  rc-check-ctd-fields (w) (e) (n) (subs) (fields) (tps) (args) (i) (len) =
    if i >= len then w
    else if rc-pat-binds-nothing (list-at subs i) then
      rc-check-ctd-fields w e n subs fields tps args (i + 1) len
    else let want = rc-subst-field (list-at fields i) tps args
    in let w2 = rc-ctd-field-verdict w e n i want (rc-pat-ty (list-at subs i))
    in rc-check-ctd-fields w2 e n subs fields tps args (i + 1) len

  rc-subst-field : ATypeExpr, List Name, List CodexType -> RcTyOf
  rc-subst-field (f) (tps) (args) =
    when f
     is ANamedType (nm) (sp) -> rc-named-field (nm.value) tps args
     is ALinearType (inner) (sp) -> rc-subst-field inner tps args
     is ABoundedIntType (base) (lo) (hi) (mode) (sp) -> RcTyKnown (IntegerTy lo hi mode)
     is AAppType (head) (as) (sp) -> rc-app-field head as tps args
     is otherwise -> RcTyNone

  rc-named-field : Text, List Name, List CodexType -> RcTyOf
  rc-named-field (nm) (tps) (args) =
    when rc-subst-name nm tps args 0 (list-length tps)
     is RcTyKnown (t) -> RcTyKnown t
     is RcTyNone -> rc-concrete-named nm

  rc-concrete-named : Text -> RcTyOf
  rc-concrete-named (nm) =
    if nm == "Text" then RcTyKnown TextTy
    else if nm == "Boolean" then RcTyKnown BooleanTy
    else if nm == "Char" then RcTyKnown CharTy
    else if nm == "Nothing" then RcTyKnown NothingTy
    else if nm == "Integer" then RcTyKnown (IntegerTy rc-wf-i64-min rc-wf-i64-max OvError)
    else if nm == "Real" then RcTyKnown real-f64
    else if nm == "real" then RcTyKnown (RealTy RwF64 RmDefault)
    else if nm == "real-approx" then RcTyKnown (RealTy RwF32 RmDefault)
    else if nm == "real-trapping" then RcTyKnown (RealTy RwF64 RmTrapping)
    else if nm == "real-saturating" then RcTyKnown (RealTy RwF64 RmSaturating)
    else if nm == "real-approx-trapping" then RcTyKnown (RealTy RwF32 RmTrapping)
    else if nm == "real-approx-saturating" then RcTyKnown (RealTy RwF32 RmSaturating)
    else RcTyKnown (ConstructedTy (Name { value = nm }) [])

  rc-wf-i64-max : Integer = 9223372036854775807
  rc-wf-i64-min : Integer = 0 - 9223372036854775807 - 1

  rc-app-field : ATypeExpr, List ATypeExpr, List Name, List CodexType -> RcTyOf
  rc-app-field (head) (as) (tps) (args) =
    when head
     is ANamedType (nm) (sp) -> rc-app-named (nm.value) as tps args
     is otherwise -> RcTyNone

  rc-app-named : Text, List ATypeExpr, List Name, List CodexType -> RcTyOf
  rc-app-named (nm) (as) (tps) (args) =
    if nm == "Real" then rc-real-quals as 0 RwF64 RmDefault True
    else if rc-all-resolve as tps args 0 (list-length as) == False then RcTyNone
    else if nm == "List" then
      (if list-length as == 1 then RcTyKnown (ListTy (rc-field-ty (list-at as 0) tps args)) else RcTyNone)
    else
      RcTyKnown (ConstructedTy (Name { value = nm }) (rc-subst-fields as tps args 0 (list-length as) []))

 A Real's width and mode arrive as APPLICATION ARGUMENTS, not as a distinct
 node: `Real approximate` is spelled the way `List a` is, and the words are
 recognised only by `resolve-real-quals` in the compiler's type checker. Read
 without this, `Real approximate` resolves to a ConstructedTy over a made-up
 `approximate` type and compares unequal against the structural `RealTy RwF32`,
 which is a DISAGREE that says the program is wrong when only the reader was.
 A word that is not a recognised qualifier answers RcTyNone rather than a
 guess, so an unfamiliar spelling is reported as unsupported instead of as a
 disagreement.

  rc-real-quals : List ATypeExpr, Integer, RealWidth, RealMode, Boolean -> RcTyOf
  rc-real-quals (as) (i) (w) (m) (all-quals) =
    if list-length as == 0 then RcTyKnown real-f64
    else if i >= list-length as then (if all-quals then RcTyKnown (RealTy w m) else RcTyNone)
    else let word = when (list-at as i) is ANamedType (n) (s) -> n.value is otherwise -> ""
    in if word == "approximate" then rc-real-quals as (i + 1) RwF32 m all-quals
    else if word == "trapping" then rc-real-quals as (i + 1) w RmTrapping all-quals
    else if word == "saturating" then rc-real-quals as (i + 1) w RmSaturating all-quals
    else rc-real-quals as (i + 1) w m False

  rc-all-resolve : List ATypeExpr, List Name, List CodexType, Integer, Integer -> Boolean
  rc-all-resolve (as) (tps) (args) (i) (len) =
    if i >= len then True
    else when rc-subst-field (list-at as i) tps args
     is RcTyNone -> False
     is RcTyKnown (t) -> rc-all-resolve as tps args (i + 1) len

  rc-field-ty : ATypeExpr, List Name, List CodexType -> CodexType
  rc-field-ty (f) (tps) (args) =
    when rc-subst-field f tps args
     is RcTyKnown (t) -> t
     is RcTyNone -> ErrorTy

  rc-subst-fields : List ATypeExpr, List Name, List CodexType, Integer, Integer, List CodexType -> List CodexType
  rc-subst-fields (as) (tps) (args) (i) (len) (acc) =
    if i >= len then acc
    else
      rc-subst-fields as tps args (i + 1) len (list-push acc (rc-field-ty (list-at as i) tps args))

  rc-subst-name : Text, List Name, List CodexType, Integer, Integer -> RcTyOf
  rc-subst-name (nm) (tps) (args) (i) (len) =
    if i >= len then RcTyNone
    else if ((list-at tps i).value) == nm then
      (if i < list-length args then RcTyKnown (list-at args i) else RcTyNone)
    else rc-subst-name nm tps args (i + 1) len

  rc-ctd-field-verdict : RcWalk, RcEnv, Text, Integer, RcTyOf, RcTyOf -> RcWalk
  rc-ctd-field-verdict (w) (e) (n) (i) (want) (got) =
    when want
     is RcTyNone -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-pat-field-type" ("sub-pattern " & show i & " of " & n & " has a field type this wire cannot resolve"))
     is RcTyKnown (wt) -> rc-pat-field-verdict w e n i (rc-cmp-tyof wt got)

  rc-check-ctor-pat-sum : RcWalk, RcEnv, Text, List IRPat, List SumCtor -> RcWalk
  rc-check-ctor-pat-sum (w) (e) (n) (subs) (ctors) =
    if rc-has-ctor ctors n 0 (list-length ctors) == False then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-pat-unknown" (n & " is not a constructor of the scrutinee's own sum type"))
    else let fields = rc-find-ctor-fields ctors n 0 (list-length ctors)
    in if list-length fields /= list-length subs then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-pat-arity" (n & " declares " & show (list-length fields) & " fields, pattern binds " & show (list-length subs)))
    else rc-check-pat-fields w e n subs fields 0 (list-length subs)

  rc-check-pat-fields : RcWalk, RcEnv, Text, List IRPat, List CodexType, Integer, Integer -> RcWalk
  rc-check-pat-fields (w) (e) (n) (subs) (fields) (i) (len) =
    if i >= len then w
    else if rc-pat-binds-nothing (list-at subs i) then
      rc-check-pat-fields w e n subs fields (i + 1) len
    else let cmp = rc-cmp-tyof (list-at fields i) (rc-pat-ty (list-at subs i))
    in let w2 = rc-pat-field-verdict w e n i cmp
    in rc-check-pat-fields w2 e n subs fields (i + 1) len

  rc-pat-field-verdict : RcWalk, RcEnv, Text, Integer, TyCmp -> RcWalk
  rc-pat-field-verdict (w) (e) (n) (i) (cmp) =
    when cmp
     is TyEq -> w
     is TyNeq -> rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-pat-field-type" ("sub-pattern " & show i & " of " & n & " does not bind at the field type the constructor declares"))
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-pat-field-type" ("sub-pattern " & show i & " of " & n & " has an undecided field type"))

Section: Expression Walk

  rc-check-expr : RcWalk, RcEnv, IRExpr -> RcWalk
  rc-check-expr (w) (e) (x) =
    if rc-dry w then w
    else rc-check-expr-go (rc-burn w) e x

  rc-check-expr-go : RcWalk, RcEnv, IRExpr -> RcWalk
  rc-check-expr-go (w) (e) (x) =
    when x
     is IrName (n) (t) (sp) -> rc-check-ctor-ref (rc-check-name w e n) e n t
     is IrApply (f) (a) (t) (sp) -> rc-check-apply w e f a t
     is IrBinary (o) (l) (r) (t) (sp) -> rc-check-expr (rc-check-expr w e l) e r
     is IrNegate (v) (t) (sp) -> rc-check-expr w e v
     is IrIf (c) (a) (b) (t) (sp) -> rc-check-expr (rc-check-expr (rc-check-expr w e c) e a) e b
     is IrLet (n) (t) (v) (b) (sp) -> rc-check-expr (rc-check-expr w e v) (rc-env-bind e n) b
     is IrLambda (ps) (b) (t) (sp) -> rc-check-expr w (rc-env-bind-all e (rc-param-names ps 0 (list-length ps) []) 0 (list-length ps)) b
     is IrList (es) (t) (sp) -> rc-check-expr-list w e es 0 (list-length es)
     is IrMatch (s) (bs) (t) (sp) -> rc-check-branches (rc-check-expr w e s) e bs 0 (list-length bs)
     is IrAct (ss) (t) (sp) -> rc-check-stmts w e ss 0 (list-length ss)
     is IrFieldAccess (r) (f) (t) (sp) -> rc-check-expr w e r
     is IrFieldStore (r) (f) (v) (t) (sp) -> rc-check-expr (rc-check-expr w e r) e v
     is IrRecord (n) (fs) (t) (sp) -> rc-check-fieldvals w e fs 0 (list-length fs)
     is IrFork (b) (t) (sp) -> rc-check-expr w e b
     is IrAwait (b) (t) (sp) -> rc-check-expr w e b
     is IrHandle (ef) (h) (cs) (t) (sp) -> rc-check-expr w e h
     is IrWithTimeout (s) (ef) (sc) (b) (t) (sp) -> rc-check-expr w e b
     is IrTry (m) (b) (fb) (fl) (t) (sp) -> rc-check-stmts (rc-check-stmts (rc-check-stmts w e b 0 (list-length b)) e fb 0 (list-length fb)) e fl 0 (list-length fl)
     is otherwise -> w

  rc-param-names : List IRParam, Integer, Integer, List Text -> List Text
  rc-param-names (ps) (i) (len) (acc) =
    if i >= len then acc
    else rc-param-names ps (i + 1) len (list-push acc ((list-at ps i).name))

  rc-check-name : RcWalk, RcEnv, Text -> RcWalk
  rc-check-name (w) (e) (n) =
    if rc-resolves e n then w
    else
      rc-add w (rc-finding (e.re-def-name) RcDisagree "unbound-name" ("no definition, parameter, binding, constructor or builtin binds " & n))

 A constructor reference carries a function type of its own, and the sum
 type that function returns declares the same constructor's field types.
 Those are two statements of one fact, made in two places on the wire, so
 they can be held against each other without consulting anything else.
 A constructor typed to accept a payload its own sum does not declare is
 the shape of Lean kernel bug 14576.

  rc-curried-params : CodexType, List CodexType, Integer -> List CodexType
  rc-curried-params (t) (acc) (fuel) =
    if fuel <= 0 then acc
    else when t
     is FunTy (p) (row) (r) -> rc-curried-params r (list-push acc p) (fuel - 1)
     is otherwise -> acc

  rc-curried-result : CodexType, Integer -> CodexType
  rc-curried-result (t) (fuel) =
    if fuel <= 0 then t
    else when t
     is FunTy (p) (row) (r) -> rc-curried-result r (fuel - 1)
     is otherwise -> t

  rc-check-ctor-ref : RcWalk, RcEnv, Text, CodexType -> RcWalk
  rc-check-ctor-ref (w) (e) (n) (t) =
    if rc-in (e.re-ctors) n == False then w
    else let res = rc-curried-result t 32
    in when res
     is SumTy (sn) (args) (ctors) ->
      if list-length ctors == 0 then rc-check-ctor-ref-ctd w e n t (sn.value) args
      else rc-check-ctor-ref-sum w e n t ctors
     is otherwise -> w

  rc-check-ctor-ref-sum : RcWalk, RcEnv, Text, CodexType, List SumCtor -> RcWalk
  rc-check-ctor-ref-sum (w) (e) (n) (t) (ctors) =
    if rc-has-ctor ctors n 0 (list-length ctors) == False then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-ref-unknown" (n & " is typed as building a sum type that does not declare it"))
    else let want = rc-find-ctor-fields ctors n 0 (list-length ctors)
    in let got = rc-curried-params t [] 32
    in if list-length want /= list-length got then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-ref-arity" (n & " is typed to take " & show (list-length got) & " payloads, its sum declares " & show (list-length want)))
    else rc-ctor-ref-verdict w e n (rc-ty-eq-list want got)

  rc-check-ctor-ref-ctd : RcWalk, RcEnv, Text, CodexType, Text, List CodexType -> RcWalk
  rc-check-ctor-ref-ctd (w) (e) (n) (t) (tyname) (args) =
    let ctors = rc-find-variant (e.re-typedefs) tyname 0 (list-length (e.re-typedefs))
    in if list-length ctors == 0 then
      rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-ref-scrutinee" (n & " is typed as building " & tyname & ", whose declaration is not on this wire"))
    else if rc-avariant-has ctors n 0 (list-length ctors) == False then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-ref-unknown" (n & " is typed as building a sum type that does not declare it"))
    else
      rc-check-ctor-ref-fields w e n t (rc-avariant-fields ctors n 0 (list-length ctors)) (rc-variant-tparams (e.re-typedefs) tyname 0 (list-length (e.re-typedefs))) args

  rc-check-ctor-ref-fields : RcWalk, RcEnv, Text, CodexType, List ATypeExpr, List Name, List CodexType -> RcWalk
  rc-check-ctor-ref-fields (w) (e) (n) (t) (fields) (tps) (args) =
    let got = rc-curried-params t [] 32
    in if list-length fields /= list-length got then
      rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-ref-arity" (n & " is typed to take " & show (list-length got) & " payloads, its sum declares " & show (list-length fields)))
    else if rc-all-resolve fields tps args 0 (list-length fields) == False then
      rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-ref-payload-type" (n & " has a payload type this wire cannot resolve"))
    else
      rc-ctor-ref-verdict w e n (rc-ty-eq-list (rc-subst-fields fields tps args 0 (list-length fields) []) got)

  rc-ctor-ref-verdict : RcWalk, RcEnv, Text, TyCmp -> RcWalk
  rc-ctor-ref-verdict (w) (e) (n) (cmp) =
    when cmp
     is TyEq -> w
     is TyNeq -> rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-ref-payload-type" (n & " is typed to accept a payload its own sum type does not declare"))
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-ref-payload-type" (n & " has an undecided payload type"))

  rc-check-apply : RcWalk, RcEnv, IRExpr, IRExpr, CodexType -> RcWalk
  rc-check-apply (w) (e) (f) (a) (t) =
    let w1 = rc-check-expr w e f
    in let w2 = rc-check-expr w1 e a
    in let w3 = rc-check-ctor-inst w2 e f a t
    in let w4 = rc-check-poly-inst w3 e f a t
    in rc-check-apply-types w4 e (rc-expr-ty f) a t

 The same derivation for a call of a polymorphic definition: at the node
 that supplies its last parameter, each declared parameter is matched
 against its argument (and a lambda argument's body), and the declared
 type so substituted must equal the type published on the head. A head
 published at a type variable is a call inside a polymorphic body: the
 caller's variables are rigid there, so each is rewritten as a named type
 of its own (`%tv` and its id) on the argument and published sides, and
 the callee's declared variables bind to those as to any concrete type.

  RcPolyDef = record {
    pd-name : Text,
    pd-ty : CodexType,
    pd-arity : Integer
  }

  rc-poly-defs : List IRDef, Integer, Integer, List RcPolyDef -> List RcPolyDef
  rc-poly-defs (ds) (i) (len) (acc) =
    if i >= len then acc
    else let d = list-at ds i
    in if rc-has-tvar (d.type-val) rc-subst-fuel then
      rc-poly-defs ds (i + 1) len (list-push acc (RcPolyDef { pd-name = d.name, pd-ty = rc-strip-forall (d.type-val) 32, pd-arity = list-length (d.params) }))
    else rc-poly-defs ds (i + 1) len acc

  rc-strip-forall : CodexType, Integer -> CodexType
  rc-strip-forall (t) (fuel) =
    if fuel <= 0 then t
    else when t
     is ForAllTy (i) (b) -> rc-strip-forall b (fuel - 1)
     is ForAllEff (i) (b) -> rc-strip-forall b (fuel - 1)
     is otherwise -> t

  rc-find-poly : List RcPolyDef, Text, Integer, Integer -> Integer
  rc-find-poly (ps) (n) (i) (len) =
    if i >= len then (-1)
    else if (list-at ps i).pd-name == n then i
    else rc-find-poly ps n (i + 1) len

  rc-spine-head-ty : IRExpr, Integer -> RcTyOf
  rc-spine-head-ty (f) (fuel) =
    if fuel <= 0 then RcTyNone
    else when f
     is IrName (n) (t) (sp) -> RcTyKnown t
     is IrApply (g) (x) (t) (sp) -> rc-spine-head-ty g (fuel - 1)
     is otherwise -> RcTyNone

  rc-head-has-tvar : RcTyOf -> Boolean
  rc-head-has-tvar (h) =
    when h
     is RcTyNone -> True
     is RcTyKnown (t) -> rc-has-tvar t rc-subst-fuel

  rc-check-poly-inst : RcWalk, RcEnv, IRExpr, IRExpr, CodexType -> RcWalk
  rc-check-poly-inst (w) (e) (f) (a) (t) =
    let k = rc-find-poly (e.re-poly) (rc-spine-head f 32) 0 (list-length (e.re-poly))
    in if k < 0 then w
    else let pd = list-at (e.re-poly) k
    in let s = rc-ctor-spine f [a] 32
    in if list-length (s.cs-args) /= pd.pd-arity then w
    else if rc-head-has-tvar (rc-spine-head-ty f 32) then rc-check-poly-rigid w e pd s (rc-spine-head-ty f 32)
    else rc-poly-inst-verdict w e (pd.pd-name) (pd.pd-ty) (rc-spine-head-ty f 32) (rc-poly-bind (rc-curried-params (pd.pd-ty) [] 32) (s.cs-args) 0 (pd.pd-arity) [])

  rc-check-poly-rigid : RcWalk, RcEnv, RcPolyDef, RcCtorSpine, RcTyOf -> RcWalk
  rc-check-poly-rigid (w) (e) (pd) (s) (published) =
    when published
     is RcTyNone -> w
     is RcTyKnown (pt) ->
      let rb = rc-rigid-binds-args (s.cs-args) 0 (list-length (s.cs-args)) (rc-rigid-binds pt [] rc-subst-fuel)
      in let r = rc-poly-bind-rigid (rc-curried-params (pd.pd-ty) [] 32) (s.cs-args) 0 (pd.pd-arity) [] rb
      in rc-poly-inst-verdict w e (pd.pd-name) (pd.pd-ty) (RcTyKnown (rc-subst pt rb rc-subst-fuel)) r

  rc-rigid-binds : CodexType, List RcTvBind, Integer -> List RcTvBind
  rc-rigid-binds (ty) (acc) (fuel) =
    if fuel <= 0 then acc
    else when ty
     is TypeVar (id) -> if rc-tvb-has acc id 0 (list-length acc) then acc else list-push acc (RcTvBind { tvb-id = id, tvb-ty = ConstructedTy (Name { value = "%tv" & show id }) [], tvb-n = 1 })
     is ListTy (x) -> rc-rigid-binds x acc (fuel - 1)
     is LinkedListTy (x) -> rc-rigid-binds x acc (fuel - 1)
     is FunTy (p) (row) (r) -> rc-rigid-binds r (rc-rigid-binds p acc (fuel - 1)) (fuel - 1)
     is ConstructedTy (n) (args) -> rc-rigid-binds-list args 0 (list-length args) acc (fuel - 1)
     is SumTy (n) (args) (cs) -> rc-rigid-binds-list args 0 (list-length args) acc (fuel - 1)
     is RecordTy (n) (args) (fs) -> rc-rigid-binds-list args 0 (list-length args) acc (fuel - 1)
     is otherwise -> acc

  rc-rigid-binds-list : List CodexType, Integer, Integer, List RcTvBind, Integer -> List RcTvBind
  rc-rigid-binds-list (xs) (i) (len) (acc) (fuel) =
    if i >= len then acc
    else rc-rigid-binds-list xs (i + 1) len (rc-rigid-binds (list-at xs i) acc fuel) fuel

  rc-rigid-binds-args : List IRExpr, Integer, Integer, List RcTvBind -> List RcTvBind
  rc-rigid-binds-args (args) (i) (len) (acc) =
    if i >= len then acc
    else when rc-expr-ty (list-at args i)
     is RcTyNone -> rc-rigid-binds-args args (i + 1) len acc
     is RcTyKnown (at) -> rc-rigid-binds-args args (i + 1) len (rc-rigid-binds at acc rc-subst-fuel)

  rc-poly-bind-rigid : List CodexType, List IRExpr, Integer, Integer, List RcTvBind, List RcTvBind -> RcSubst
  rc-poly-bind-rigid (ps) (args) (i) (len) (bs) (rb) =
    if i >= len then RcSubOk bs
    else if i >= list-length ps then RcSubUnknown
    else let x = list-at args i
    in if rc-wf-is-int-lit x | rc-wf-is-narrow-call x then rc-poly-bind-rigid ps args (i + 1) len bs rb
    else when rc-expr-ty x
     is RcTyNone -> rc-poly-bind-rigid ps args (i + 1) len bs rb
     is RcTyKnown (at) -> rc-poly-rigid-step ps args i len rb (rc-match (list-at ps i) (rc-subst at rb rc-subst-fuel) bs rc-subst-fuel)

  rc-poly-rigid-step : List CodexType, List IRExpr, Integer, Integer, List RcTvBind, RcSubst -> RcSubst
  rc-poly-rigid-step (ps) (args) (i) (len) (rb) (r) =
    when r
     is RcSubOk (bs2) -> rc-poly-bind-rigid ps args (i + 1) len bs2 rb
     is RcSubConflict -> RcSubConflict
     is RcSubUnknown -> RcSubUnknown

  rc-poly-bind : List CodexType, List IRExpr, Integer, Integer, List RcTvBind -> RcSubst
  rc-poly-bind (ps) (args) (i) (len) (bs) =
    if i >= len then RcSubOk bs
    else if i >= list-length ps then RcSubUnknown
    else let x = list-at args i
    in if rc-wf-is-int-lit x | rc-wf-is-narrow-call x then rc-poly-bind ps args (i + 1) len bs
    else rc-poly-bind-step ps args i len (rc-spine-witness (list-at ps i) x bs)

  rc-poly-bind-step : List CodexType, List IRExpr, Integer, Integer, RcSubst -> RcSubst
  rc-poly-bind-step (ps) (args) (i) (len) (r) =
    when r
     is RcSubOk (bs2) -> rc-poly-bind ps args (i + 1) len bs2
     is RcSubConflict -> RcSubConflict
     is RcSubUnknown -> RcSubUnknown

  rc-poly-inst-verdict : RcWalk, RcEnv, Text, CodexType, RcTyOf, RcSubst -> RcWalk
  rc-poly-inst-verdict (w) (e) (n) (declared) (published) (r) =
    when r
     is RcSubConflict -> rc-add w (rc-finding (e.re-def-name) RcDisagree "poly-instantiation" (n & " is called with arguments that require one type variable to be two types"))
     is RcSubUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "poly-instantiation-undecided" (n & " has an argument this checker cannot match against its declared parameter"))
     is RcSubOk (bs) -> rc-poly-inst-pub w e n (rc-subst declared bs rc-subst-fuel) published

  rc-poly-inst-pub : RcWalk, RcEnv, Text, CodexType, RcTyOf -> RcWalk
  rc-poly-inst-pub (w) (e) (n) (derived) (published) =
    when published
     is RcTyNone -> w
     is RcTyKnown (pt) -> if rc-has-tvar pt rc-subst-fuel then w else rc-poly-inst-cmp w e n (rc-ty-eq derived pt)

  rc-poly-inst-cmp : RcWalk, RcEnv, Text, TyCmp -> RcWalk
  rc-poly-inst-cmp (w) (e) (n) (c) =
    when c
     is TyEq -> w
     is TyNeq -> rc-add w (rc-finding (e.re-def-name) RcDisagree "poly-instantiation" (n & " is published at an instantiation its own arguments do not give"))
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "poly-instantiation-undecided" (n & " has an instantiation this checker cannot hold against its arguments"))

 The compiler publishes a constructor application's type arguments in the
 site's result; this derives them again from the arguments. A field
 declared as a bare type parameter binds that parameter to its argument's
 recorded type, and the published type argument must equal it (type
 arguments are invariant). Integer literals and `__narrow` results are
 admitted by value, which `RecheckBounds` decides, so they bind nothing.

  RcCtorSpine = record {
    cs-head : Text,
    cs-args : List IRExpr
  }

  rc-spine-head : IRExpr, Integer -> Text
  rc-spine-head (f) (fuel) =
    if fuel <= 0 then ""
    else when f
     is IrName (n) (t) (sp) -> n
     is IrApply (g) (x) (t) (sp) -> rc-spine-head g (fuel - 1)
     is otherwise -> ""

  rc-ctor-spine : IRExpr, List IRExpr, Integer -> RcCtorSpine
  rc-ctor-spine (f) (args) (fuel) =
    if fuel <= 0 then RcCtorSpine { cs-head = "", cs-args = args }
    else when f
     is IrName (n) (t) (sp) -> RcCtorSpine { cs-head = n, cs-args = args }
     is IrApply (g) (x) (t) (sp) -> rc-ctor-spine g ([x] & args) (fuel - 1)
     is otherwise -> RcCtorSpine { cs-head = "", cs-args = args }

  rc-check-ctor-inst : RcWalk, RcEnv, IRExpr, IRExpr, CodexType -> RcWalk
  rc-check-ctor-inst (w) (e) (f) (a) (t) =
    if rc-in (e.re-ctors) (rc-spine-head f 32) == False then w
    else let s = rc-ctor-spine f [a] 32
    in when t
     is SumTy (sn) (targs) (cs) -> rc-check-ctor-inst-ty w e s (sn.value) targs
     is ConstructedTy (cn) (targs) -> rc-check-ctor-inst-ty w e s (cn.value) targs
     is otherwise -> w

  rc-check-ctor-inst-ty : RcWalk, RcEnv, RcCtorSpine, Text, List CodexType -> RcWalk
  rc-check-ctor-inst-ty (w) (e) (s) (tyname) (targs) =
    let tds = e.re-typedefs
    in let tps = rc-variant-tparams tds tyname 0 (list-length tds)
    in let ctors = rc-find-variant tds tyname 0 (list-length tds)
    in let fields = rc-avariant-fields ctors (s.cs-head) 0 (list-length ctors)
    in if list-length tps == 0 then w
    else if list-length tps /= list-length targs then w
    else if list-length fields /= list-length (s.cs-args) then w
    else rc-ctor-inst-fields w e (s.cs-head) fields tps targs (s.cs-args) 0 (list-length fields)

  rc-ctor-inst-fields : RcWalk, RcEnv, Text, List ATypeExpr, List Name, List CodexType, List IRExpr, Integer, Integer -> RcWalk
  rc-ctor-inst-fields (w) (e) (n) (fields) (tps) (targs) (args) (i) (len) =
    if i >= len then w
    else let j = rc-field-tparam (list-at fields i) tps
    in let x = list-at args i
    in let w2 = if j < 0 then w
      else if rc-wf-is-int-lit x | rc-wf-is-narrow-call x then w
      else rc-ctor-inst-verdict w e n (list-at targs j) (rc-expr-ty x)
    in rc-ctor-inst-fields w2 e n fields tps targs args (i + 1) len

  rc-field-tparam : ATypeExpr, List Name -> Integer
  rc-field-tparam (f) (tps) =
    when f
     is ANamedType (nm) (sp) -> rc-name-index tps (nm.value) 0 (list-length tps)
     is otherwise -> (-1)

  rc-name-index : List Name, Text, Integer, Integer -> Integer
  rc-name-index (tps) (nm) (i) (len) =
    if i >= len then (-1)
    else if (list-at tps i).value == nm then i
    else rc-name-index tps nm (i + 1) len

  rc-ctor-inst-verdict : RcWalk, RcEnv, Text, CodexType, RcTyOf -> RcWalk
  rc-ctor-inst-verdict (w) (e) (n) (published) (got) =
    when got
     is RcTyNone -> w
     is RcTyKnown (at) -> rc-ctor-inst-cmp w e n (rc-ty-eq published at)

  rc-ctor-inst-cmp : RcWalk, RcEnv, Text, TyCmp -> RcWalk
  rc-ctor-inst-cmp (w) (e) (n) (c) =
    when c
     is TyEq -> w
     is TyNeq -> rc-add w (rc-finding (e.re-def-name) RcDisagree "ctor-instantiation" (n & " is published at a type argument that its own argument does not have"))
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported "ctor-instantiation-undecided" (n & " has a type argument this checker cannot hold against its argument"))

  rc-check-apply-types : RcWalk, RcEnv, RcTyOf, IRExpr, CodexType -> RcWalk
  rc-check-apply-types (w) (e) (ft) (a) (t) =
    when ft
     is RcTyNone -> w
     is RcTyKnown (fty) -> rc-check-apply-fun w e fty a t

  rc-check-apply-fun : RcWalk, RcEnv, CodexType, IRExpr, CodexType -> RcWalk
  rc-check-apply-fun (w) (e) (fty) (a) (t) =
    when fty
     is FunTy (p) (row) (r) -> rc-check-apply-parts w e p r a t
     is otherwise ->
      if rc-ty-opaque fty then w
      else
        rc-add w (rc-finding (e.re-def-name) RcDisagree "apply-non-function" "the callee's type is not a function type")

Section: Spine Scoped Substitution

 The compiler publishes every call site's instantiation (2026-10-20), so
 this substitution decides only a site that arrives uninstantiated, and
 no arm in `kill-rate.ps1` reaches it. Type-variable ids belong to the
 callee's signature and repeat at every call site, so a map keyed by tvar
 id may not outlive one spine; no binding is taken from the parameter the
 spine's result flows into.

 Fuel of 24: a spine longer than that answers unknown rather than recursing.

  rc-spine-fuel : Integer = 24

  rc-spine-soft : RcSubst, List RcTvBind -> RcSubst
  rc-spine-soft (s) (bs) =
    when s
     is RcSubOk (bs2) -> RcSubOk bs2
     is RcSubConflict -> RcSubConflict
     is RcSubUnknown -> RcSubOk bs

 A curried call is nested applies, so the callee's recorded type at each node
 supplies that node's parameter and no head-type peeling is needed. Walking
 inward first accumulates across the spine, which is what would let one
 variable acquire two witnesses.

  rc-spine-bind : IRExpr, List RcTvBind, Integer -> RcSubst
  rc-spine-bind (x) (bs) (fuel) =
    if fuel <= 0 then RcSubUnknown
    else when x
     is IrApply (f) (a) (t) (sp) -> rc-spine-node f a bs (fuel - 1)
     is otherwise -> RcSubOk bs

  rc-spine-node : IRExpr, IRExpr, List RcTvBind, Integer -> RcSubst
  rc-spine-node (f) (a) (bs) (fuel) =
    when rc-spine-bind f bs fuel
     is RcSubOk (bs1) -> rc-spine-pair (rc-expr-ty f) a bs1
     is RcSubConflict -> RcSubConflict
     is RcSubUnknown -> RcSubUnknown

  rc-spine-pair : RcTyOf, IRExpr, List RcTvBind -> RcSubst
  rc-spine-pair (ft) (a) (bs) =
    when ft
     is RcTyNone -> RcSubOk bs
     is RcTyKnown (fty) -> rc-spine-param fty a bs

  rc-spine-param : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-param (fty) (a) (bs) =
    when fty
     is FunTy (p) (row) (r) -> rc-spine-witness p a bs
     is otherwise -> RcSubOk bs

  rc-spine-witness : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-witness (p) (a) (bs) =
    when rc-spine-arg p a bs
     is RcSubOk (bs2) -> rc-spine-lambda p a bs2
     is RcSubConflict -> RcSubConflict
     is RcSubUnknown -> RcSubUnknown

  rc-spine-arg : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-arg (p) (a) (bs) =
    when rc-expr-ty a
     is RcTyNone -> RcSubOk bs
     is RcTyKnown (at) -> rc-spine-soft (rc-match p at bs rc-subst-fuel) bs

  rc-spine-lambda : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-lambda (p) (a) (bs) =
    when a
     is IrLambda (ps) (b) (t) (sp) -> rc-spine-lambda-ret p b bs
     is otherwise -> RcSubOk bs

  rc-spine-lambda-ret : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-lambda-ret (p) (b) (bs) =
    when p
     is FunTy (pp) (row) (pr) -> rc-spine-body pr b bs
     is otherwise -> RcSubOk bs

  rc-spine-body : CodexType, IRExpr, List RcTvBind -> RcSubst
  rc-spine-body (pr) (b) (bs) =
    when rc-body-ty b rc-spine-fuel
     is RcTyNone -> RcSubOk bs
     is RcTyKnown (bt) -> rc-spine-soft (rc-match pr bt bs rc-subst-fuel) bs

 Another wire fact: a lambda body that is an `if` or a `when` is recorded as
 the bare `(tvar 73)` while every arm beneath carries a concrete type. That
 is the four sites in `IR/Lowering.codex` the spine walk alone cannot decide.

 The arms must AGREE for the descent to answer. Taking one arm where another
 contradicts it would assert a return the lambda does not have, and a wrong
 binding manufactures a false disagreement. `tvar-spine-branch-arms` is the
 arm that fails if this stops deciding.

  rc-body-ty : IRExpr, Integer -> RcTyOf
  rc-body-ty (b) (fuel) =
    if fuel <= 0 then RcTyNone
    else when rc-expr-ty b
     is RcTyNone -> RcTyNone
     is RcTyKnown (bt) -> rc-body-ty-known b bt fuel

  rc-body-ty-known : IRExpr, CodexType, Integer -> RcTyOf
  rc-body-ty-known (b) (bt) (fuel) =
    if rc-ty-opaque bt == False then RcTyKnown bt else rc-body-arms b (fuel - 1)

  rc-body-arms : IRExpr, Integer -> RcTyOf
  rc-body-arms (b) (fuel) =
    when b
     is IrIf (c) (x) (y) (t) (sp) -> rc-body-agree (rc-body-ty x fuel) (rc-body-ty y fuel)
     is IrMatch (s) (bs) (t) (sp) -> rc-body-branches bs 0 (list-length bs) RcTyNone fuel
     is otherwise -> RcTyNone

  rc-body-branches : List IRBranch, Integer, Integer, RcTyOf, Integer -> RcTyOf
  rc-body-branches (bs) (i) (len) (acc) (fuel) =
    if i >= len then acc
    else
      rc-body-branches bs (i + 1) len (rc-body-join acc (rc-body-ty ((list-at bs i).body) fuel) i) fuel

  rc-body-join : RcTyOf, RcTyOf, Integer -> RcTyOf
  rc-body-join (acc) (here) (i) = if i == 0 then here else rc-body-agree acc here

  rc-body-agree : RcTyOf, RcTyOf -> RcTyOf
  rc-body-agree (p) (q) =
    when p
     is RcTyNone -> RcTyNone
     is RcTyKnown (a) -> rc-body-agree-with a q

  rc-body-agree-with : CodexType, RcTyOf -> RcTyOf
  rc-body-agree-with (a) (q) =
    when q
     is RcTyNone -> RcTyNone
     is RcTyKnown (b) -> rc-body-agree-cmp a (rc-ty-eq a b)

  rc-body-agree-cmp : CodexType, TyCmp -> RcTyOf
  rc-body-agree-cmp (a) (c) =
    when c
     is TyEq -> RcTyKnown a
     is otherwise -> RcTyNone

 The early exit is load-bearing rather than ornamental, for the reason
 recorded against `rc-subst`: this runs at every application in the payload
 and almost every one is monomorphic, so building a spine map for a recorded
 type that mentions no variable would allocate a walk per call across 4820
 definitions on a heap with no collector.

  rc-arg-spine : IRExpr -> RcSubst
  rc-arg-spine (a) =
    when a
     is IrApply (f) (aa) (t) (sp) -> rc-arg-spine-tv a t
     is otherwise -> RcSubOk []

  rc-arg-spine-tv : IRExpr, CodexType -> RcSubst
  rc-arg-spine-tv (a) (t) =
    if rc-has-tvar t rc-subst-fuel then rc-spine-bind a [] rc-spine-fuel else RcSubOk []

  rc-arg-improved : IRExpr, List RcTvBind -> RcTyOf
  rc-arg-improved (a) (bs) =
    when rc-expr-ty a
     is RcTyNone -> RcTyNone
     is RcTyKnown (at) -> RcTyKnown (rc-subst at bs rc-subst-fuel)

  rc-arg-supplied : IRExpr, List RcTvBind -> Integer
  rc-arg-supplied (a) (bs) =
    when rc-expr-ty a
     is RcTyNone -> 0
     is RcTyKnown (at) -> rc-min-witness at bs 0 rc-subst-fuel

 The callee's declared parameter and return may carry type variables. The
 guide's "Type Variables" rule fixes them by matching the parameter against
 the argument, so that match runs first and both verdicts are taken against
 the SUBSTITUTED types. When the match cannot answer, p and r are used
 unchanged and the verdicts abstain exactly as before -- a partial answer
 must never read as a total one.

  rc-check-apply-parts : RcWalk, RcEnv, CodexType, CodexType, IRExpr, CodexType -> RcWalk
  rc-check-apply-parts (w) (e) (p) (r) (a) (t) =
    rc-check-apply-spine w e p r a t (rc-arg-spine a)

 A conflict inside the ARGUMENT's own spine is one type variable of that
 application required to be two types at once. It surfaces here rather than
 at the spine's own nodes because a per-node match starts from an empty map
 and can never hold two witnesses at the same time.

  rc-check-apply-spine : RcWalk, RcEnv, CodexType, CodexType, IRExpr, CodexType, RcSubst -> RcWalk
  rc-check-apply-spine (w) (e) (p) (r) (a) (t) (sp) =
    when sp
     is RcSubConflict -> rc-add w (rc-finding (e.re-def-name) RcDisagree "apply-tvar-inconsistent" "one type variable of the argument's own application is required to be two different types")
     is RcSubUnknown -> rc-check-apply-parts2 w e p r a t (rc-expr-ty a)
     is RcSubOk (bs) -> rc-check-apply-improved w e p r a t bs

  rc-check-apply-improved : RcWalk, RcEnv, CodexType, CodexType, IRExpr, CodexType, List RcTvBind -> RcWalk
  rc-check-apply-improved (w) (e) (p) (r) (a) (t) (bs) =
    let n = rc-arg-supplied a bs
    in let w1 = if n <= 0 then w else rc-note-improved w (n == 1)
    in rc-check-apply-parts2 w1 e p r a t (rc-arg-improved a bs)

  rc-check-apply-parts2 : RcWalk, RcEnv, CodexType, CodexType, IRExpr, CodexType, RcTyOf -> RcWalk
  rc-check-apply-parts2 (w) (e) (p) (r) (a) (t) (at) =
    when rc-apply-subst p at
     is RcSubOk (bs) -> rc-check-apply-decided w e (rc-subst p bs rc-subst-fuel) (rc-subst r bs rc-subst-fuel) a at t
     is RcSubConflict -> rc-add w (rc-finding (e.re-def-name) RcDisagree "apply-tvar-inconsistent" "one type variable of the callee is required to be two different types by this application")
     is RcSubUnknown -> rc-check-apply-decided w e p r a at t

  rc-apply-subst : CodexType, RcTyOf -> RcSubst
  rc-apply-subst (p) (g) =
    when g
     is RcTyNone -> RcSubUnknown
     is RcTyKnown (at) -> rc-match p at [] rc-subst-fuel

  rc-check-apply-decided : RcWalk, RcEnv, CodexType, CodexType, IRExpr, RcTyOf, CodexType -> RcWalk
  rc-check-apply-decided (w) (e) (p) (r) (a) (at) (t) =
    let w1 = if rc-wf-narrow-into-int p a | rc-wf-lit-into-int p a | rc-wf-int-bounds-deferred p at then
      w
    else
      rc-apply-arg-verdict w e (rc-fits-tyof p at) (rc-wf-int-into-int p at) (rc-arg-undecided-kind p at)
    in rc-apply-result-verdict w1 e (rc-ty-fits r t) (rc-result-undecided-kind r t)

  rc-arg-undecided-kind : CodexType, RcTyOf -> Text
  rc-arg-undecided-kind (p) (g) =
    when g
     is RcTyNone -> "apply-arg-undecided-no-wire-type"
     is RcTyKnown (at) ->
      if rc-ty-opaque p then "apply-arg-undecided-opaque-param-" & rc-ty-opaque-kind p
      else if rc-ty-opaque at then "apply-arg-undecided-opaque-arg-" & rc-ty-opaque-kind at
      else if rc-has-nominal-widening at p then "apply-arg-undecided-nested-variance"
      else "apply-arg-undecided-nested-" & rc-why at p

  rc-result-undecided-kind : CodexType, CodexType -> Text
  rc-result-undecided-kind (r) (t) =
    if rc-ty-opaque r then "apply-result-undecided-opaque-declared-" & rc-ty-opaque-kind r
    else if rc-ty-opaque t then "apply-result-undecided-opaque-site-" & rc-ty-opaque-kind t
    else if rc-has-nominal-widening r t then "apply-result-undecided-nested-variance"
    else "apply-result-undecided-nested-" & rc-why r t

  rc-wf-narrow-into-int : CodexType, IRExpr -> Boolean
  rc-wf-narrow-into-int (p) (a) = rc-wf-is-int-ty p & rc-wf-is-narrow-call a

 An integer literal reaching an integer parameter is admitted by its VALUE
 against the parameter's bound, which is CDX2050 and is decided in
 `RecheckBounds`. Its plain `Integer` type does not fit a bounded parameter
 and never will, so judging it here would report an abstention on every
 `narrow 5` in the tree for a question another stage answers.

  rc-wf-lit-into-int : CodexType, IRExpr -> Boolean
  rc-wf-lit-into-int (p) (a) = rc-wf-is-int-ty p & rc-wf-is-int-lit a

  rc-wf-is-int-lit : IRExpr -> Boolean
  rc-wf-is-int-lit (x) =
    when x
     is IrIntLit (v) (sp) -> True
     is otherwise -> False

 These two take the argument's type rather than the argument, because the
 type they must judge is the IMPROVED one: reading it back off the expression
 would consult the uninstantiated recorded type and route a decided pair to
 the wrong stage.

  rc-wf-int-into-int : CodexType, RcTyOf -> Boolean
  rc-wf-int-into-int (p) (at) = rc-wf-is-int-ty p & rc-wf-tyof-is-int at

 An integer argument reaching an integer parameter is admitted by its PROVEN
 RANGE against the parameter's declared range, never by the two types being
 equal, and that is decided in `RecheckBounds`. Published as
 `docs/DevelopersGuide.md` "What a bounded parameter admits", measured: the
 same field declared 0..1000 is refused at a 0..255 parameter directly and
 admitted through `int-mod ... 100`, so the declared type cannot be what
 decides it. The refusal is CDX2051 from the bounds prover and never CDX2001
 from the type checker.

 This is the same division `rc-wf-lit-into-int` already makes one case up,
 generalised from a literal to any integer argument, and for the same reason:
 judging it here reports an abstention on a site the type comparison was
 never the right instrument for.

 The OVERFLOW MODE does not qualify this, and it did for a day. It was
 excluded on the ground that the compiler compares mode nowhere, so a
 difference was an unruled gap worth keeping a record of. Measured since:
 mode is not part of type identity at all, published as
 `docs/DevelopersGuide.md` "Overflow mode is not part of type identity".
 Qualifying the deferral on it sends a mode-differing pair down the type
 comparison instead of to the bounds stage, which is the wrong stage for it
 and resurrects this whole class for exactly those pairs.

  rc-wf-int-bounds-deferred : CodexType, RcTyOf -> Boolean
  rc-wf-int-bounds-deferred (p) (at) = rc-wf-int-into-int p at

  rc-wf-tyof-is-int : RcTyOf -> Boolean
  rc-wf-tyof-is-int (g) =
    when g
     is RcTyKnown (t) -> rc-wf-is-int-ty t
     is RcTyNone -> False

  rc-wf-is-int-ty : CodexType -> Boolean
  rc-wf-is-int-ty (t) =
    when t
     is IntegerTy (lo) (hi) (m) -> True
     is otherwise -> False

  rc-wf-is-narrow-call : IRExpr -> Boolean
  rc-wf-is-narrow-call (x) =
    when x
     is IrApply (f) (a) (t) (sp) -> rc-wf-is-narrow-name f
     is otherwise -> False

  rc-wf-is-narrow-name : IRExpr -> Boolean
  rc-wf-is-narrow-name (f) =
    when f
     is IrName (n) (t) (sp) -> n == "__narrow"
     is otherwise -> False

  rc-apply-arg-verdict : RcWalk, RcEnv, TyCmp, Boolean, Text -> RcWalk
  rc-apply-arg-verdict (w) (e) (cmp) (int-into-int) (undecided-kind) =
    when cmp
     is TyEq -> w
     is TyNeq -> if int-into-int then
       rc-add w (rc-finding (e.re-def-name) RcUnsupported "apply-arg-int-bounds" "an integer argument reaches an integer parameter declared with different bounds; whether the value fits is the bounds checker's question, and this checker has no published rule for a narrowing the compiler proved statically")
     else
       rc-add w (rc-finding (e.re-def-name) RcDisagree "apply-arg-type" "the argument's type is not the parameter type the callee's own type declares")
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported undecided-kind "the argument's type against the parameter type is a comparison this checker cannot decide")

  rc-apply-result-verdict : RcWalk, RcEnv, TyCmp, Text -> RcWalk
  rc-apply-result-verdict (w) (e) (cmp) (undecided-kind) =
    when cmp
     is TyEq -> w
     is TyNeq -> rc-add w (rc-finding (e.re-def-name) RcDisagree "apply-result-type" "the application's result type is not the callee's declared return type")
     is TyUnknown -> rc-add w (rc-finding (e.re-def-name) RcUnsupported undecided-kind "the application's result type against the callee's declared return type is a comparison this checker cannot decide")

  rc-check-expr-list : RcWalk, RcEnv, List IRExpr, Integer, Integer -> RcWalk
  rc-check-expr-list (w) (e) (xs) (i) (len) =
    if i >= len then w
    else rc-check-expr-list (rc-check-expr w e (list-at xs i)) e xs (i + 1) len

  rc-check-fieldvals : RcWalk, RcEnv, List IRFieldVal, Integer, Integer -> RcWalk
  rc-check-fieldvals (w) (e) (fs) (i) (len) =
    if i >= len then w
    else rc-check-fieldvals (rc-check-expr w e ((list-at fs i).value)) e fs (i + 1) len

  rc-check-branches : RcWalk, RcEnv, List IRBranch, Integer, Integer -> RcWalk
  rc-check-branches (w) (e) (bs) (i) (len) =
    if i >= len then w
    else let b = list-at bs i
    in let names = rc-pat-names (b.pattern) []
    in let e2 = rc-env-bind-all e names 0 (list-length names)
    in let w1 = rc-check-pat w e (b.pattern)
    in let w2 = rc-check-expr w1 e2 (b.body)
    in rc-check-branches w2 e bs (i + 1) len

  rc-check-stmts : RcWalk, RcEnv, List IRActStmt, Integer, Integer -> RcWalk
  rc-check-stmts (w) (e) (ss) (i) (len) =
    if i >= len then w
    else when list-at ss i
     is IrDoBind (n) (t) (v) (sp) -> rc-check-stmts (rc-check-expr w e v) (rc-env-bind e n) ss (i + 1) len
     is IrDoExec (v) (sp) -> rc-check-stmts (rc-check-expr w e v) e ss (i + 1) len

Section: Definition Walk

  rc-check-def : RcWalk, List Text, List Text, List ATypeDef, List Text, List RcPolyDef, IRDef -> RcWalk
  rc-check-def (w) (defs) (ctors) (tds) (bs) (poly) (d) =
    let base = RcEnv {
      re-locals = [],
      re-defs = defs,
      re-ctors = ctors,
      re-def-name = d.name,
      re-typedefs = tds,
      re-builtins = bs,
      re-poly = poly
    }
    in let ps = rc-param-names (d.params) 0 (list-length (d.params)) []
    in let e = rc-env-bind-all base ps 0 (list-length ps)
    in rc-check-expr w e (d.body)

  rc-def-names : List IRDef, Integer, Integer, List Text -> List Text
  rc-def-names (ds) (i) (len) (acc) =
    if i >= len then acc
    else rc-def-names ds (i + 1) len (list-push acc ((list-at ds i).name))

  rc-check-chapter : IRChapter, List Text, List ATypeDef, Integer -> RcWalk
  rc-check-chapter (ch) (ctors) (tds) (fuel) =
    let ds = ch.defs
    in let names = rc-def-names ds 0 (list-length ds) []
    in let bs = recheck-builtin-names
    in let poly = rc-poly-defs ds 0 (list-length ds) []
    in rc-check-defs (rc-walk-new fuel) names ctors tds bs poly ds 0 (list-length ds)

  rc-check-defs : RcWalk, List Text, List Text, List ATypeDef, List Text, List RcPolyDef, List IRDef, Integer, Integer -> RcWalk
  rc-check-defs (w) (defs) (ctors) (tds) (bs) (poly) (ds) (i) (len) =
    if i >= len then w
    else
      rc-check-defs (rc-check-def w defs ctors tds bs poly (list-at ds i)) defs ctors tds bs poly ds (i + 1) len

Page 1
