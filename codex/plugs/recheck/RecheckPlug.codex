Section: Helpers

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Per Definition Verdicts

  rc-def-has : List RcFinding, Text, RcVerdict, Integer, Integer -> Boolean
  rc-def-has (fs) (d) (v) (i) (len) =
   if i >= len then False
   else let f = list-at fs i
   in if f.rf-def == d & rc-verdict-atom (f.rf-verdict) == rc-verdict-atom v then True
   else rc-def-has fs d v (i + 1) len

  rc-def-verdict : List RcFinding, Text -> RcVerdict
  rc-def-verdict (fs) (d) =
   let len = list-length fs
   in if rc-def-has fs d RcDisagree 0 len then RcDisagree
   else if rc-def-has fs d RcUnsupported 0 len then RcUnsupported
   else RcAgree

  RcTally = record {
   rt-agree : Integer,
   rt-disagree : Integer,
   rt-unsupported : Integer
  }

  rc-tally : List IRDef, List RcFinding, Integer, Integer, RcTally -> RcTally
  rc-tally (ds) (fs) (i) (len) (acc) =
   if i >= len then acc
   else let v = rc-def-verdict fs ((list-at ds i).name)
   in rc-tally ds fs (i + 1) len (rc-tally-add acc v)

  rc-tally-add : RcTally, RcVerdict -> RcTally
  rc-tally-add (t) (v) =
   when v
    is RcAgree -> RcTally { rt-agree = t.rt-agree + 1, rt-disagree = t.rt-disagree, rt-unsupported = t.rt-unsupported }
    is RcDisagree -> RcTally { rt-agree = t.rt-agree, rt-disagree = t.rt-disagree + 1, rt-unsupported = t.rt-unsupported }
    is RcUnsupported -> RcTally { rt-agree = t.rt-agree, rt-disagree = t.rt-disagree, rt-unsupported = t.rt-unsupported + 1 }

Section: Report

  rc-render-findings : List RcFinding, Integer, Integer, Text -> Text
  rc-render-findings (fs) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fs i
   in let line = rc-verdict-atom (f.rf-verdict) & " " & f.rf-def & " [" & f.rf-kind & "] " & f.rf-detail & "\n"
   in rc-render-findings fs (i + 1) len (acc & line)

  rc-render-stage : IRChapter, RcWalk, Text -> Text
  rc-render-stage (ch) (w) (stage) =
   let fs = w.rw-findings
   in let zero = RcTally { rt-agree = 0, rt-disagree = 0, rt-unsupported = 0 }
   in let t = rc-tally (ch.defs) fs 0 (list-length (ch.defs)) zero
   in let head = "RECHECK stage=" & stage & "\n"
   in let body = rc-render-findings fs 0 (list-length fs) ""
   in let fuel = if w.rw-fuel <= 0 then "FUEL-EXHAUSTED yes stage=" & stage & "\n" else ""
   in let sum = "STAGE " & stage & " DEFS " & show (list-length (ch.defs)) & " AGREE " & show (t.rt-agree) & " DISAGREE " & show (t.rt-disagree) & " UNSUPPORTED " & show (t.rt-unsupported) & " IMPROVED " & show (w.rw-improved) & " SINGLE-WITNESS " & show (w.rw-1w) & "\n"
   in head & body & fuel & sum

  rc-render : IRChapter, RcWalk, RcWalk, RcWalk -> Text
  rc-render (ch) (w1) (w2) (w3) =
   rc-render-stage ch w1 "1" & rc-render-stage ch w2 "2" & rc-render-stage ch w3 "3"

Section: Body

  rc-all-ctors : ParsedIR -> List Text
  rc-all-ctors (p) = ((p.meta).ctor-names) & (p.effect-op-names)

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   let sess = net-session-new local-mac local-ip gateway-ip 49152 9134 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let ir-text = bytes-to-text (recv.body) 0 (list-length (recv.body))
     in let parsed = parse-ir-chapter ir-text
     in let w = rc-check-chapter (parsed.chapter) (rc-all-ctors parsed) (parsed.type-defs) 40000000
     in let wb = rc-bnd-chapter (parsed.chapter) 40000000
     in let we = rc-eff-chapter (parsed.chapter) ((parsed.meta).ground-effects) 40000000
     in let report = rc-render (parsed.chapter) w wb we
     in act
      sent <- net-io-send-text-checked (recv.transport) report
      ts3 <- net-io-close (sent.ns-transport)
      if sent.ns-complete then print-line-uni "OK"
      else print-line-uni ("TRUNCATED sent=" & show (sent.ns-sent) & " of " & show (text-length report))
     end
    else print-line-uni "FAIL"
   end

