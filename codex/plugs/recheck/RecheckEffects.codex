Chapter: RecheckEffects
  cites Recheck chapter RecheckCore

Section: Effect Rows

  rc-names-to-labels : List Name, Integer, Integer, List EffectLabel -> List EffectLabel
  rc-names-to-labels (ns) (i) (len) (acc) =
   if i >= len then acc
   else rc-names-to-labels ns (i + 1) len (list-push acc (EffectLabel { name = list-at ns i, scope = "" }))

  rc-eff-labels : CodexType -> List EffectLabel
  rc-eff-labels (t) = rc-eff-labels-deep t [] 32

  rc-eff-labels-deep : CodexType, List EffectLabel, Integer -> List EffectLabel
  rc-eff-labels-deep (t) (acc) (fuel) =
   if fuel <= 0 then acc
   else when t
    is FunTy (p) (row) (r) -> rc-eff-labels-deep r (rc-append-labels acc (row.labels) 0 (list-length (row.labels))) (fuel - 1)
    is EffectfulTy (effs) (sc) (r) -> rc-names-to-labels effs 0 (list-length effs) acc
    is otherwise -> acc

  rc-append-labels : List EffectLabel, List EffectLabel, Integer, Integer -> List EffectLabel
  rc-append-labels (acc) (xs) (i) (len) =
   if i >= len then acc
   else rc-append-labels (list-push acc (list-at xs i)) xs (i + 1) len

  rc-chars-eq : Text, Text, Integer, Integer -> Boolean
  rc-chars-eq (a) (b) (i) (len) =
   if i >= len then True
   else if char-code-at a i /= char-code-at b i then False
   else rc-chars-eq a b (i + 1) len

  rc-prefix-dot : Text, Text -> Boolean
  rc-prefix-dot (d) (e) =
   let dl = text-length d
   in if text-length e <= dl then False
   else if char-code-at e dl /= char-code-at "." 0 then False
   else rc-chars-eq d e 0 dl

  rc-eff-covered : List EffectLabel, Text -> Boolean
  rc-eff-covered (declared) (n) =
   rc-eff-covered-loop declared n 0 (list-length declared)

  rc-eff-covered-loop : List EffectLabel, Text, Integer, Integer -> Boolean
  rc-eff-covered-loop (ls) (n) (i) (len) =
   if i >= len then False
   else let d = ((list-at ls i).name).value
   in if d == n then True
   else if rc-prefix-dot d n then True
   else rc-eff-covered-loop ls n (i + 1) len

Section: Linear Use Counting

  rc-count-name : IRExpr, Text, Integer -> Integer
  rc-count-name (x) (n) (fuel) =
   if fuel <= 0 then 0
   else when x
    is IrName (m) (t) (sp) -> if m == n then 1 else 0
    is IrBinary (o) (l) (r) (t) (sp) -> rc-count-name l n (fuel - 1) + rc-count-name r n (fuel - 1)
    is IrNegate (v) (t) (sp) -> rc-count-name v n (fuel - 1)
    is IrIf (c) (a) (b) (t) (sp) -> rc-count-name c n (fuel - 1) + rc-count-branch a b n (fuel - 1)
    is IrLet (m) (t) (v) (b) (sp) -> if m == n then rc-count-name v n (fuel - 1) else rc-count-name v n (fuel - 1) + rc-count-name b n (fuel - 1)
    is IrApply (f) (a) (t) (sp) -> rc-count-name f n (fuel - 1) + rc-count-name a n (fuel - 1)
    is IrLambda (ps) (b) (t) (sp) -> rc-count-name b n (fuel - 1)
    is IrList (es) (t) (sp) -> rc-count-list es n (fuel - 1) 0 (list-length es)
    is IrMatch (s) (bs) (t) (sp) -> rc-count-name s n (fuel - 1) + rc-count-branches bs n (fuel - 1) 0 (list-length bs)
    is IrAct (ss) (t) (sp) -> rc-count-stmts ss n (fuel - 1) 0 (list-length ss)
    is IrFieldAccess (r) (f) (t) (sp) -> rc-count-name r n (fuel - 1)
    is IrFieldStore (r) (f) (v) (t) (sp) -> rc-count-name r n (fuel - 1) + rc-count-name v n (fuel - 1)
    is IrRecord (m) (fs) (t) (sp) -> rc-count-fieldvals fs n (fuel - 1) 0 (list-length fs)
    is IrFork (b) (t) (sp) -> rc-count-name b n (fuel - 1)
    is IrAwait (b) (t) (sp) -> rc-count-name b n (fuel - 1)
    is otherwise -> 0

  rc-count-branch : IRExpr, IRExpr, Text, Integer -> Integer
  rc-count-branch (a) (b) (n) (fuel) =
   let ca = rc-count-name a n fuel
   in let cb = rc-count-name b n fuel
   in if ca > cb then ca else cb

  rc-count-list : List IRExpr, Text, Integer, Integer, Integer -> Integer
  rc-count-list (xs) (n) (fuel) (i) (len) =
   if i >= len then 0
   else rc-count-name (list-at xs i) n fuel + rc-count-list xs n fuel (i + 1) len

  rc-count-fieldvals : List IRFieldVal, Text, Integer, Integer, Integer -> Integer
  rc-count-fieldvals (fs) (n) (fuel) (i) (len) =
   if i >= len then 0
   else rc-count-name ((list-at fs i).value) n fuel + rc-count-fieldvals fs n fuel (i + 1) len

  rc-count-stmts : List IRActStmt, Text, Integer, Integer, Integer -> Integer
  rc-count-stmts (ss) (n) (fuel) (i) (len) =
   if i >= len then 0
   else rc-count-name (ir-act-stmt-expr (list-at ss i)) n fuel + rc-count-stmts ss n fuel (i + 1) len

  rc-count-branches : List IRBranch, Text, Integer, Integer, Integer -> Integer
  rc-count-branches (bs) (n) (fuel) (i) (len) =
   if i >= len then 0
   else let here = rc-count-name ((list-at bs i).body) n fuel
   in let rest = rc-count-branches bs n fuel (i + 1) len
   in if here > rest then here else rest

Section: Grounded Effects

  rc-ground-sep : Text, Integer, Integer -> Integer
  rc-ground-sep (s) (i) (len) =
   if i >= len then 0 - 1
   else if char-code-at s i == char-code-at "\n" 0 then i
   else rc-ground-sep s (i + 1) len

  rc-ground-labels : List Text, Text, Integer, Integer, List EffectLabel -> List EffectLabel
  rc-ground-labels (gs) (slug) (i) (len) (acc) =
   if i >= len then acc
   else rc-ground-labels gs slug (i + 1) len (rc-ground-one (list-at gs i) slug acc)

  rc-ground-one : Text, Text, List EffectLabel -> List EffectLabel
  rc-ground-one (e) (slug) (acc) =
   let p = rc-ground-sep e 0 (text-length e)
   in if p < 0 then acc
   else if substring e 0 p /= slug then acc
   else list-push acc (EffectLabel { name = Name { value = substring e (p + 1) (text-length e - p - 1) }, scope = "" })

Section: The Checks

  rc-eff-check-def : RcWalk, List Text, IRDef -> RcWalk
  rc-eff-check-def (w) (ground-tbl) (d) =
   let declared = rc-ground-labels ground-tbl (d.chapter-slug) 0 (list-length ground-tbl) (rc-eff-labels (d.type-val))
   in let w1 = rc-eff-walk w (d.name) declared (d.body)
   in rc-lin-check-def w1 d

  rc-eff-walk : RcWalk, Text, List EffectLabel, IRExpr -> RcWalk
  rc-eff-walk (w) (d) (declared) (x) =
   if rc-dry w then w
   else rc-eff-go (rc-burn w) d declared x

  rc-eff-go : RcWalk, Text, List EffectLabel, IRExpr -> RcWalk
  rc-eff-go (w) (d) (declared) (x) =
   when x
    is IrName (n) (t) (sp) -> rc-eff-name-check w d declared n t
    is IrApply (f) (a) (t) (sp) -> rc-eff-walk (rc-eff-walk w d declared f) d declared a
    is IrBinary (o) (l) (r) (t) (sp) -> rc-eff-walk (rc-eff-walk w d declared l) d declared r
    is IrNegate (v) (t) (sp) -> rc-eff-walk w d declared v
    is IrIf (c) (a) (b) (t) (sp) -> rc-eff-walk (rc-eff-walk (rc-eff-walk w d declared c) d declared a) d declared b
    is IrLet (n) (t) (v) (b) (sp) -> rc-eff-walk (rc-eff-walk w d declared v) d declared b
    is IrLambda (ps) (b) (t) (sp) -> rc-eff-walk w d declared b
    is IrList (es) (t) (sp) -> rc-eff-list w d declared es 0 (list-length es)
    is IrMatch (s) (bs) (t) (sp) -> rc-eff-branches (rc-eff-walk w d declared s) d declared bs 0 (list-length bs)
    is IrAct (ss) (t) (sp) -> rc-eff-stmts w d declared ss 0 (list-length ss)
    is IrFieldAccess (r) (f) (t) (sp) -> rc-eff-walk w d declared r
    is IrFieldStore (r) (f) (v) (t) (sp) -> rc-eff-walk (rc-eff-walk w d declared r) d declared v
    is IrRecord (n) (fs) (t) (sp) -> rc-eff-fieldvals w d declared fs 0 (list-length fs)
    is IrFork (b) (t) (sp) -> rc-eff-walk w d declared b
    is IrAwait (b) (t) (sp) -> rc-eff-walk w d declared b
    is otherwise -> w

  rc-eff-list : RcWalk, Text, List EffectLabel, List IRExpr, Integer, Integer -> RcWalk
  rc-eff-list (w) (d) (dec) (xs) (i) (len) =
   if i >= len then w
   else rc-eff-list (rc-eff-walk w d dec (list-at xs i)) d dec xs (i + 1) len

  rc-eff-fieldvals : RcWalk, Text, List EffectLabel, List IRFieldVal, Integer, Integer -> RcWalk
  rc-eff-fieldvals (w) (d) (dec) (fs) (i) (len) =
   if i >= len then w
   else rc-eff-fieldvals (rc-eff-walk w d dec ((list-at fs i).value)) d dec fs (i + 1) len

  rc-eff-branches : RcWalk, Text, List EffectLabel, List IRBranch, Integer, Integer -> RcWalk
  rc-eff-branches (w) (d) (dec) (bs) (i) (len) =
   if i >= len then w
   else rc-eff-branches (rc-eff-walk w d dec ((list-at bs i).body)) d dec bs (i + 1) len

  rc-eff-stmts : RcWalk, Text, List EffectLabel, List IRActStmt, Integer, Integer -> RcWalk
  rc-eff-stmts (w) (d) (dec) (ss) (i) (len) =
   if i >= len then w
   else rc-eff-stmts (rc-eff-walk w d dec (ir-act-stmt-expr (list-at ss i))) d dec ss (i + 1) len

  rc-eff-name-check : RcWalk, Text, List EffectLabel, Text, CodexType -> RcWalk
  rc-eff-name-check (w) (d) (declared) (n) (t) =
   let used = rc-eff-labels t
   in rc-eff-each w d declared n used 0 (list-length used)

  rc-eff-each : RcWalk, Text, List EffectLabel, Text, List EffectLabel, Integer, Integer -> RcWalk
  rc-eff-each (w) (d) (declared) (n) (used) (i) (len) =
   if i >= len then w
   else let e = ((list-at used i).name).value
   in let w2 = rc-eff-one w d declared n e
   in rc-eff-each w2 d declared n used (i + 1) len

  rc-eff-one : RcWalk, Text, List EffectLabel, Text, Text -> RcWalk
  rc-eff-one (w) (d) (declared) (n) (e) =
   if rc-eff-covered declared e then w
   else rc-add w (rc-finding d RcDisagree "effect-undeclared" (n & " performs " & e & " and the calling signature does not declare it"))

Section: Linear Checks

  rc-lin-check-def : RcWalk, IRDef -> RcWalk
  rc-lin-check-def (w) (d) =
   rc-lin-each w d (d.unique-params) 0 (list-length (d.unique-params))

  rc-lin-each : RcWalk, IRDef, List Text, Integer, Integer -> RcWalk
  rc-lin-each (w) (d) (ns) (i) (len) =
   if i >= len then w
   else let n = list-at ns i
   in let c = rc-count-name (d.body) n 4000
   in let w2 = rc-lin-verdict w (d.name) n c
   in rc-lin-each w2 d ns (i + 1) len

  rc-lin-verdict : RcWalk, Text, Text, Integer -> RcWalk
  rc-lin-verdict (w) (d) (n) (c) =
   if c == 1 then w
   else if c == 0 then rc-add w (rc-finding d RcDisagree "linear-unused" ("linear parameter " & n & " is never used, which is a leak"))
   else rc-add w (rc-finding d RcDisagree "linear-reused" ("linear parameter " & n & " is used " & show c & " times on some path and must be used exactly once"))

Section: Chapter

  rc-eff-chapter : IRChapter, List Text, Integer -> RcWalk
  rc-eff-chapter (ch) (ground-tbl) (fuel) =
   rc-eff-defs (rc-walk-new fuel) ground-tbl (ch.defs) 0 (list-length (ch.defs))

  rc-eff-defs : RcWalk, List Text, List IRDef, Integer, Integer -> RcWalk
  rc-eff-defs (w) (ground-tbl) (ds) (i) (len) =
   if i >= len then w
   else rc-eff-defs (rc-eff-check-def w ground-tbl (list-at ds i)) ground-tbl ds (i + 1) len

