Chapter: RustPlug
  cites Net chapter NetIO
  cites Net chapter NetworkStack
  cites Net chapter TcpTransport
  cites Kernel chapter Ne2k
  cites Foreword chapter CCE

Section: Helpers

  local-mac : List Integer = [82, 84, 0, 18, 52, 86]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  host-ip : List Integer = [127, 0, 0, 1]

Section: Drain

  drain-wait : TcpTransportState, Integer -> [Network.Read] Integer
  drain-wait (ts) (tries) =
   if tries > 5000000 then 0
   else act
    frame <- ne2k-recv-frame
    if list-length frame == 0 then drain-wait ts (tries + 1)
    else 0
   end

Section: Body

 The SENDER decides whether this plug stays alive, in the tag byte that rides
 ahead of the IR. Tag 1 is one payload and exit, which is what
 build/plug-run.ps1 sends. Tag 3 means another payload may follow: reply,
 close, and connect again. A plug that decided for itself to wait made every
 one-shot caller pay for the wait, 1129 ms to 3230 ms when it was measured
 that way round. Each iteration takes its own source port because a client
 cannot reuse one it has just closed, and serve-max is a fuel so a host that
 stops answering cannot make this spin.

  serve-max : Integer = 64

  plug-tag-serve-again : Integer = 3

  serve-once : Integer -> [Console, FileSystem, Network.Read, Network.Write] Integer
  serve-once (i) =
   let sess = net-session-new local-mac local-ip gateway-ip (49152 + i) 9136 host-ip 1000
   in let ts = transport-new sess
   in act
    ts1 <- net-io-connect ts
    recv <- net-io-recv-loop ts1 0
    if recv.has-message then
     let ir-text = bytes-to-text (recv.body) 0 (list-length (recv.body))
     in let parsed = parse-ir-chapter ir-text
     in let m = parsed.chapter
     in let rs-output = emit-rs-chapter m (parsed.type-defs)
     in act
      sent <- net-io-send-text-checked (recv.transport) rs-output
      ts6 <- net-io-close (sent.ns-transport)
      drained <- drain-wait ts6 0
      if sent.ns-complete then act
        (print-line-uni ("OK defs=" & show (list-length (m.defs) + drained - drained)))
        (if recv.tag == plug-tag-serve-again then 1 else 0)
      end
      else act
        (print-line-uni ("TRUNCATED sent=" & show (sent.ns-sent) & " of " & show (text-length rs-output) & " defs=" & show (list-length (m.defs) + drained - drained)))
        0
      end
     end
    else act
      (print-line-uni "FAIL")
      0
    end
   end

  serve-loop : Integer -> [Console, FileSystem, Network.Read, Network.Write] Nothing
  serve-loop (i) =
   if i >= serve-max then print-line-uni ("SERVED " & show i)
   else act
    again <- serve-once i
    if again == 1 then serve-loop (i + 1)
    else print-line-uni ("SERVED " & show (i + 1))
   end

  opening : [Console, FileSystem, Network.Read, Network.Write] Nothing =
   serve-loop 0
