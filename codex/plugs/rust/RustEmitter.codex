Chapter: Rust Emitter
  cites Foreword chapter RankedTextSet
  cites Foreword chapter Sort
  cites Foreword chapter CCE

Section: Keywords and Sanitization

  rs-keywords : RankedTextSet
  rs-keywords =
   ranked-text-from-list ["fn", "let", "mut", "pub", "struct", "enum",
    "impl", "trait", "type", "use", "mod", "crate", "self", "super",
    "where", "match", "if", "else", "for", "while", "loop", "break",
    "continue", "return", "move", "ref", "as", "in", "true", "false",
    "const", "static", "unsafe", "extern", "async", "await", "dyn",
    "abstract", "become", "box", "do", "final", "macro", "override",
    "priv", "try", "typeof", "virtual", "yield"]

  is-rs-keyword : Text -> Boolean
  is-rs-keyword (n) = ranked-text-has rs-keywords n

  rs-sanitize : Text -> Text
  rs-sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-rs-keyword s then "r#" & s else s

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division in every target that has one.
 riscv resolves the slot and needs it; every source plug wants the name.

  rs-slash-pos : Text, Integer, Integer -> Integer
  rs-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else rs-slash-pos f (i + 1) len

  rs-field : Text -> Text
  rs-field (f) =
   let slash = rs-slash-pos f 0 (text-length f)
   in if slash >= 0 then rs-sanitize (substring f 0 slash)
      else rs-sanitize f

Section: Type Mapping

  rs-type : CodexType -> Text
  rs-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "i64"
    is RealTy (w) (m) -> "f64"
    is TextTy -> "String"
    is BooleanTy -> "bool"
    is CharTy -> "i64"
    is VoidTy -> "()"
    is NothingTy -> "()"
    is ProofTy -> "()"
    is PropEqTy (pl) (pr) -> "()"
    is UnitTy (n) (inner) -> "()"
    is ErrorTy | NoExpectTy -> "Box<dyn std::any::Any>"
    is FunTy (p) (fnrow) (r) -> "Box<dyn Fn(" & rs-type p & ") -> " & rs-type r & ">"
    is ListTy (elem) -> "Vec<" & rs-type elem & ">"
    is LinkedListTy (elem) -> "Vec<" & rs-type elem & ">"
    is TypeVar (id) -> "Box<dyn std::any::Any>"
    is ForAllTy (id) (body) -> rs-type body
    is ForAllEff (id) (body) -> rs-type body
    is LinearTy (body) -> rs-type body
    is TypeApply (body) (tyarg) -> rs-type body
    is SumTy (name) (ty-args) (ctors) -> rs-sanitize (name.value)
    is RecordTy (name) (ty-args) (fields) -> rs-sanitize (name.value)
    is ConstructedTy (name) (args) -> rs-sanitize (name.value)
    is TypeCon (name) -> rs-sanitize (name.value)
    is VectorTy (vn) (vt) -> "Vec<" & rs-type vt & ">"
    is VectorMaskTy (vn) -> "Vec<bool>"
    is EffectfulTy (effects) (sc) (ret) -> rs-type ret

Section: Constructor-to-Enum Map

  CtorEnumEntry = record {
   ctor-name : Text,
   enum-name : Text
  }

  bsearch-ctor-pos : List CtorEnumEntry, Text, Integer, Integer -> Integer
  bsearch-ctor-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).ctor-name
   in if text-compare name mid-name <= 0 then bsearch-ctor-pos entries name lo mid
      else bsearch-ctor-pos entries name (mid + 1) hi

  sorted-insert-ctor : List CtorEnumEntry, CtorEnumEntry -> List CtorEnumEntry
  sorted-insert-ctor (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-ctor-pos xs (e.ctor-name) 0 len
   in list-insert-at xs pos e

  build-ctor-enum-map : List ATypeDef, Integer, List CtorEnumEntry -> List CtorEnumEntry
  build-ctor-enum-map (tds) (i) (acc) =
   if i == list-length tds then acc
   else let td = list-at tds i
   in build-ctor-enum-map tds (i + 1) (build-ctor-enum-from-td td acc)

  build-ctor-enum-from-td : ATypeDef, List CtorEnumEntry -> List CtorEnumEntry
  build-ctor-enum-from-td (td) (acc) =
   when td
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     build-ctor-enum-from-ctors ctors (name.value) acc 0
    is otherwise -> acc

  build-ctor-enum-from-ctors : List AVariantCtorDef, Text, List CtorEnumEntry, Integer -> List CtorEnumEntry
  build-ctor-enum-from-ctors (ctors) (enum-name) (acc) (i) =
   if i == list-length ctors then acc
   else let c = list-at ctors i
   in build-ctor-enum-from-ctors ctors enum-name (sorted-insert-ctor acc (CtorEnumEntry { ctor-name = c.name.value, enum-name = enum-name })) (i + 1)

  lookup-ctor-enum : List CtorEnumEntry, Text -> Text
  lookup-ctor-enum (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-ctor-pos entries name 0 len
   in if pos >= len then ""
      else let e = list-at entries pos
      in if e.ctor-name == name then e.enum-name else ""

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Escape Helpers

  rs-hex-digit : Integer -> Text
  rs-hex-digit (n) =
   if n < 10 then integer-to-text n
   else if n == 10 then "a"
   else if n == 11 then "b"
   else if n == 12 then "c"
   else if n == 13 then "d"
   else if n == 14 then "e"
   else if n == 15 then "f"
   else "?"

  rs-hex-n : Integer -> Text
  rs-hex-n (n) =
   if n < 16 then rs-hex-digit n
   else rs-hex-n (n / 16) & rs-hex-digit (n - n / 16 * 16)

  rs-escape-cce-char : Integer -> Text
  rs-escape-cce-char (c) =
   let uni = to-unicode c
   in "\\u{" & rs-hex-n uni & "}"

  rs-escape-text-loop : Text, Integer, Integer, List Text -> List Text
  rs-escape-text-loop (s) (i) (len) (acc) =
   if i == len then acc
   else rs-escape-text-loop s (i + 1) len (list-push acc (rs-escape-cce-char (char-code (char-at s i))))

  rs-escape-text : Text -> Text
  rs-escape-text (s) =
   text-concat-list (rs-escape-text-loop s 0 (text-length s) [])

Section: Type Definition Emission

  emit-rs-type-defs : List ATypeDef, Integer -> Text
  emit-rs-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-rs-type-def (list-at tds i) & "\n" & emit-rs-type-defs tds (i + 1)

  emit-rs-type-def : ATypeDef -> Text
  emit-rs-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     "#[derive(Debug, Clone, PartialEq)]\nstruct " & rs-sanitize (name.value) & " {\n" & emit-rs-record-fields fields 0 & "}\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else "#[derive(Debug, Clone, PartialEq)]\nenum " & rs-sanitize (name.value) & " {\n" & emit-rs-variant-ctors ctors 0 & "}\n"
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-rs-record-fields : List ARecordFieldDef, Integer -> Text
  emit-rs-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "    " & rs-sanitize (f.name.value) & ": " & emit-rs-atype-expr (f.type-expr) & ",\n" & emit-rs-record-fields fields (i + 1)

  emit-rs-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-rs-variant-ctors (ctors) (i) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in if list-length (c.fields) == 0 then "    " & rs-sanitize (c.name.value) & ",\n" & emit-rs-variant-ctors ctors (i + 1)
      else "    " & rs-sanitize (c.name.value) & "(" & emit-rs-ctor-field-types (c.fields) 0 & "),\n" & emit-rs-variant-ctors ctors (i + 1)

  emit-rs-ctor-field-types : List ATypeExpr, Integer -> Text
  emit-rs-ctor-field-types (fields) (i) =
   if i == list-length fields then ""
   else emit-rs-atype-expr (list-at fields i) & (if i < list-length fields - 1 then ", " else "") & emit-rs-ctor-field-types fields (i + 1)

  emit-rs-atype-expr : ATypeExpr -> Text
  emit-rs-atype-expr (te) =
   when te
    is ANamedType (name) (s) -> rs-atype-name (name.value)
    is AFunType (p) (r) (s) -> "Box<dyn Fn(" & emit-rs-atype-expr p & ") -> " & emit-rs-atype-expr r & ">"
    is AAppType (base) (args) (s) -> emit-rs-atype-expr base
    is AEffectType (effs) (scopes) (efftail) (r) (s) -> emit-rs-atype-expr r
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> emit-rs-atype-expr b
    is ALinearType (b) (s) -> emit-rs-atype-expr b
    is AConstrainedType (ctcls) (ctparam) (b) (s) -> emit-rs-atype-expr b
    is AForallType (fav) (favt) (b) (s) -> emit-rs-atype-expr b
    is APropEqType (b) (peright) (s) -> emit-rs-atype-expr b

  is-rs-real-atom : Text -> Boolean
  is-rs-real-atom (n) =
   n == "real" | n == "real-approx" | n == "real-trapping" | n == "real-saturating"
   | n == "real-approx-trapping" | n == "real-approx-saturating"

  rs-atype-name : Text -> Text
  rs-atype-name (n) =
   if n == "Integer" then "i64"
   else if n == "Real" then "f64"
   else if is-rs-real-atom n then "f64"
   else if n == "Text" then "String"
   else if n == "Boolean" then "bool"
   else if n == "List" then "Vec"
   else if n == "LinkedList" then "Vec"
   else rs-sanitize n

Section: Tail Call Optimization

  is-self-call : IRExpr, Text -> Boolean
  is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in is-self-call-root (chain.root) func-name

  is-self-call-root : IRExpr, Text -> Boolean
  is-self-call-root (e) (func-name) =
   when e
    is IrName (n) (ty) (sp) -> n == func-name
    is otherwise -> False

  has-tail-call : IRExpr, Text -> Boolean
  has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> has-tail-call t func-name | has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> is-self-call e func-name
    is IrAct (stmts) (ty) (sp) -> has-tail-call-act stmts func-name
    is otherwise -> False

  has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if has-tail-call (b.body) func-name then True
      else has-tail-call-branches branches func-name (i + 1)

  has-tail-call-act : List IRActStmt, Text -> Boolean
  has-tail-call-act (stmts) (func-name) =
   let len = list-length stmts
   in if len == 0 then False
    else let last = list-at stmts (len - 1)
     in when last
      is IrDoExec (e) (sp) -> has-tail-call e func-name
      is otherwise -> False

  should-tco : IRDef -> Boolean
  should-tco (d) =
   if list-length (d.params) == 0 then False
   else has-tail-call (d.body) (d.name)

Section: Expression Emission

  max-rs-depth : Integer = 256

  emit-rs-expr : IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-expr (e) (arities) (ctor-map) = emit-rs-expr-at e arities ctor-map 0

  emit-rs-expr-at : IRExpr, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-expr-at (e) (arities) (ctor-map) (depth) =
   if depth >= max-rs-depth then "todo!()"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n & "_i64"
    is IrNumLit (n) (sp) -> "f64::from_bits(" & integer-to-text n & "_u64)"
    is IrTextLit (s) (sp) -> "\"" & rs-escape-text s & "\".to_string()"
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n & "_i64"
    is IrName (n) (ty) (sp) -> emit-rs-name n ty arities ctor-map
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-rs-binary op l r ty arities ctor-map
    is IrNegate (operand) (nty) (sp) -> "(-" & emit-rs-expr-at operand arities ctor-map (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "if " & emit-rs-expr-at c arities ctor-map (depth + 1) & " { " & emit-rs-expr-at t arities ctor-map (depth + 1) & " } else { " & emit-rs-expr-at el arities ctor-map (depth + 1) & " }"
    is IrLet (name) (ty) (val) (body) (sp) -> "{ let " & rs-sanitize name & " = " & emit-rs-expr-at val arities ctor-map (depth + 1) & "; " & emit-rs-expr-at body arities ctor-map (depth + 1) & " }"
    is IrApply (f) (a) (ty) (sp) -> emit-rs-apply e arities ctor-map
    is IrLambda (params) (body) (ty) (sp) -> emit-rs-lambda params body arities ctor-map
    is IrList (elems) (ty) (sp) -> emit-rs-list elems arities ctor-map
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-rs-match scrut branches arities ctor-map
    is IrAct (stmts) (ty) (sp) -> emit-rs-act stmts ty arities ctor-map
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-rs-handle body clauses ty arities ctor-map depth
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-rs-expr-at body arities ctor-map (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> emit-rs-record name fields arities ctor-map
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-rs-expr-at rec arities ctor-map (depth + 1) & "." & rs-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "{ let mut _r = " & emit-rs-expr-at rec arities ctor-map (depth + 1) & "; _r." & rs-field field & " = " & emit-rs-expr-at val arities ctor-map (depth + 1) & "; _r }"
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-rs-try max body fb fail-stmts ty arities ctor-map depth
    is IrFork (body) (ty) (sp) -> "std::thread::spawn(move || (" & emit-rs-expr-at body arities ctor-map (depth + 1) & ")(()))"
    is IrAwait (task) (ty) (sp) -> "(" & emit-rs-expr-at task arities ctor-map (depth + 1) & ").join().unwrap()"
    is IrError (msg) (ty) (sp) -> "panic!(\"" & msg & "\")"
    is otherwise -> "todo!(/* unhandled IR node */)"

  emit-rs-name : Text, CodexType, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-name (n) (ty) (arities) (ctor-map) =
   if n == "read-line" then "{ let mut s = String::new(); std::io::stdin().read_line(&mut s).unwrap(); s.trim().to_string() }"
   else if n == "show" then "|x: i64| format!(\"{}\", x)"
   else if n == "negate" then "|x: i64| -x"
   else if n == "get-state" then "unsafe { _CODEX_STATE }"
   else if text-length n > 0 then if is-upper-letter (char-code (char-at n 0)) then if is-fn-type ty then rs-sanitize n
    else let parent = lookup-ctor-enum ctor-map n
     in if text-length parent > 0 then rs-sanitize parent & "::" & rs-sanitize n
        else rs-sanitize n
   else let ar = lookup-arity arities n
    in if ar == 0 then rs-sanitize n & "()"
    else rs-sanitize n
   else rs-sanitize n

  is-fn-type : CodexType -> Boolean
  is-fn-type (ty) =
   when ty
    is FunTy (p) (fnrow) (r) -> True
    is ForAllTy (id) (body) -> is-fn-type body
    is ForAllEff (id) (body) -> is-fn-type body
    is LinearTy (body) -> is-fn-type body
    is TypeApply (body) (tyarg) -> is-fn-type body
    is otherwise -> False

Section: Builtin Dispatch

  RsBuiltinEmitter = record {
   name : Text,
   emit : List IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  }

  bsearch-rs-emitter-pos : List RsBuiltinEmitter, Text, Integer, Integer -> Integer
  bsearch-rs-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-rs-emitter-pos entries name lo mid
      else bsearch-rs-emitter-pos entries name (mid + 1) hi

  sort-rs-emitters : List RsBuiltinEmitter -> List RsBuiltinEmitter
  sort-rs-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

 The character predicates test CCE BANDS and must never be handed to
 `char::is_alphabetic` or its siblings. Codex text is CCE, which numbers
 its code points by frequency: the letter a is 15, and `char::from_u32(15)`
 is a control character, so the predicate answers False. The bands are
 1..2 whitespace, 3..12 digit, and 13..64 or 97..127 letter, the hole
 being CCE's punctuation at 65..96.

  rs-builtin-emitters : List RsBuiltinEmitter = sort-rs-emitters [
   RsBuiltinEmitter { name = "show", emit = \args arities cm -> "format!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "negate", emit = \args arities cm -> "(-" & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "print-line", emit = \args arities cm -> "println!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "print-line-raw", emit = \args arities cm -> "println!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "print-line-uni", emit = \args arities cm -> "println!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "print-error", emit = \args arities cm -> "eprintln!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "print-error-uni", emit = \args arities cm -> "eprintln!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "fail", emit = \args arities cm -> "panic!(\"{}\", " & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "text-length", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".len() as i64" },
   RsBuiltinEmitter { name = "is-letter", emit = \args arities cm -> "matches!(" & emit-rs-expr (list-at args 0) arities cm & ", 13..=64 | 97..=127)" },
   RsBuiltinEmitter { name = "is-digit", emit = \args arities cm -> "matches!(" & emit-rs-expr (list-at args 0) arities cm & ", 3..=12)" },
   RsBuiltinEmitter { name = "is-whitespace", emit = \args arities cm -> "matches!(" & emit-rs-expr (list-at args 0) arities cm & ", 1..=2)" },
   RsBuiltinEmitter { name = "text-to-integer", emit = \args arities cm -> "_cx_text_to_integer(&" & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "integer-to-text", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".to_string()" },
   RsBuiltinEmitter { name = "char-code", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm },
   RsBuiltinEmitter { name = "code-to-char", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm },
   RsBuiltinEmitter { name = "char-to-text", emit = \args arities cm -> "String::from(char::from_u32(" & emit-rs-expr (list-at args 0) arities cm & " as u32).unwrap())" },
   RsBuiltinEmitter { name = "char-at", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".chars().nth(" & emit-rs-expr (list-at args 1) arities cm & " as usize).unwrap() as i64" },
   RsBuiltinEmitter { name = "char-code-at", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".chars().nth(" & emit-rs-expr (list-at args 1) arities cm & " as usize).unwrap() as i64" },
   RsBuiltinEmitter { name = "substring", emit = \args arities cm -> "{ let s = & " & emit-rs-expr (list-at args 0) arities cm & "; s.chars().skip(" & emit-rs-expr (list-at args 1) arities cm & " as usize).take(" & emit-rs-expr (list-at args 2) arities cm & " as usize).collect::<String>() }" },
   RsBuiltinEmitter { name = "list-length", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".len() as i64" },
   RsBuiltinEmitter { name = "list-at", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & "[" & emit-rs-expr (list-at args 1) arities cm & " as usize].clone()" },
   RsBuiltinEmitter { name = "list-snoc", emit = \args arities cm -> "{ let mut v = " & emit-rs-expr (list-at args 0) arities cm & ".clone(); v.push(" & emit-rs-expr (list-at args 1) arities cm & "); v }" },
   RsBuiltinEmitter { name = "list-push", emit = \args arities cm -> "{ let mut v = " & emit-rs-expr (list-at args 0) arities cm & ".clone(); v.push(" & emit-rs-expr (list-at args 1) arities cm & "); v }" },
   RsBuiltinEmitter { name = "list-append", emit = \args arities cm -> "{ let mut v = " & emit-rs-expr (list-at args 0) arities cm & ".clone(); v.extend(" & emit-rs-expr (list-at args 1) arities cm & ".iter().cloned()); v }" },
   RsBuiltinEmitter { name = "list-cons", emit = \args arities cm -> "{ let mut v = vec![" & emit-rs-expr (list-at args 0) arities cm & "]; v.extend(" & emit-rs-expr (list-at args 1) arities cm & ".iter().cloned()); v }" },
   RsBuiltinEmitter { name = "list-insert-at", emit = \args arities cm -> "{ let mut v = " & emit-rs-expr (list-at args 0) arities cm & ".clone(); v.insert(" & emit-rs-expr (list-at args 1) arities cm & " as usize, " & emit-rs-expr (list-at args 2) arities cm & "); v }" },
   RsBuiltinEmitter { name = "list-set-at", emit = \args arities cm -> "{ let mut v = " & emit-rs-expr (list-at args 0) arities cm & ".clone(); v[" & emit-rs-expr (list-at args 1) arities cm & " as usize] = " & emit-rs-expr (list-at args 2) arities cm & "; v }" },
   RsBuiltinEmitter { name = "map", emit = \args arities cm -> "{ let _f = " & emit-rs-expr (list-at args 0) arities cm & "; " & emit-rs-expr (list-at args 1) arities cm & ".iter().map(|_x| _f(_x.clone())).collect::<Vec<_>>() }" },
   RsBuiltinEmitter { name = "__narrow", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm },
   RsBuiltinEmitter { name = "text-compare", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".cmp(&" & emit-rs-expr (list-at args 1) arities cm & ") as i64" },
   RsBuiltinEmitter { name = "text-replace", emit = \args arities cm -> "_cx_text_replace(&" & emit-rs-expr (list-at args 0) arities cm & ", &" & emit-rs-expr (list-at args 1) arities cm & ", &" & emit-rs-expr (list-at args 2) arities cm & ")" },
   RsBuiltinEmitter { name = "text-concat-list", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".concat()" },
   RsBuiltinEmitter { name = "text-split", emit = \args arities cm -> "_cx_text_split(&" & emit-rs-expr (list-at args 0) arities cm & ", &" & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "text-contains", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".contains(&*" & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "text-starts-with", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".starts_with(&*" & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "open-file", emit = \args arities cm -> "std::fs::File::open(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap()" },
   RsBuiltinEmitter { name = "read-all", emit = \args arities cm -> "{ use std::io::Read; let mut s = String::new(); " & emit-rs-expr (list-at args 0) arities cm & ".read_to_string(&mut s).unwrap(); s }" },
   RsBuiltinEmitter { name = "close-file", emit = \args arities cm -> "drop(" & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "read-text", emit = \args arities cm -> "std::fs::read_to_string(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap()" },
   RsBuiltinEmitter { name = "write-file", emit = \args arities cm -> "std::fs::write(" & emit-rs-expr (list-at args 0) arities cm & ", " & emit-rs-expr (list-at args 1) arities cm & ").unwrap()" },
   RsBuiltinEmitter { name = "file-exists", emit = \args arities cm -> "std::path::Path::new(&" & emit-rs-expr (list-at args 0) arities cm & ").exists()" },
   RsBuiltinEmitter { name = "read-line", emit = \args arities cm -> "{ let mut s = String::new(); std::io::stdin().read_line(&mut s).unwrap(); s.trim().to_string() }" },
   RsBuiltinEmitter { name = "get-args", emit = \args arities cm -> "std::env::args().collect::<Vec<String>>()" },
   RsBuiltinEmitter { name = "current-dir", emit = \args arities cm -> "std::env::current_dir().unwrap().to_string_lossy().to_string()" },
   RsBuiltinEmitter { name = "get-env", emit = \args arities cm -> "std::env::var(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap_or_default()" },
   RsBuiltinEmitter { name = "process-exit", emit = \args arities cm -> "std::process::exit(" & emit-rs-expr (list-at args 0) arities cm & " as i32)" },
   RsBuiltinEmitter { name = "bit-and", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & " & " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "bit-or", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & " | " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "bit-xor", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & " ^ " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "bit-shl", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & " << " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "bit-shr", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & " >> " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "bit-not", emit = \args arities cm -> "(!" & emit-rs-expr (list-at args 0) arities cm & ")" },
   RsBuiltinEmitter { name = "int-mod", emit = \args arities cm -> "{ let a = " & emit-rs-expr (list-at args 0) arities cm & "; let b = " & emit-rs-expr (list-at args 1) arities cm & "; let abs_b = b.abs(); let r = a % abs_b; if r < 0 { r + abs_b } else { r } }" },
   RsBuiltinEmitter { name = "min", emit = \args arities cm -> "std::cmp::min(" & emit-rs-expr (list-at args 0) arities cm & ", " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "max", emit = \args arities cm -> "std::cmp::max(" & emit-rs-expr (list-at args 0) arities cm & ", " & emit-rs-expr (list-at args 1) arities cm & ")" },
   RsBuiltinEmitter { name = "abs", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".abs()" },
   RsBuiltinEmitter { name = "run-process", emit = \args arities cm -> "{ let _out = std::process::Command::new(" & emit-rs-expr (list-at args 0) arities cm & ").args(" & emit-rs-expr (list-at args 1) arities cm & ".split_whitespace()).output().unwrap(); String::from_utf8_lossy(&_out.stdout).to_string() }" },
   RsBuiltinEmitter { name = "run-process-full", emit = \args arities cm -> "{ let _out = std::process::Command::new(" & emit-rs-expr (list-at args 0) arities cm & ").args(" & emit-rs-expr (list-at args 1) arities cm & ".split_whitespace()).output().unwrap(); ProcessResult { stdout: String::from_utf8_lossy(&_out.stdout).to_string(), stderr: String::from_utf8_lossy(&_out.stderr).to_string(), exit_code: _out.status.code().unwrap_or(0) as i64 } }" },
   RsBuiltinEmitter { name = "fork", emit = \args arities cm -> "std::thread::spawn(move || (" & emit-rs-expr (list-at args 0) arities cm & ")(()))" },
   RsBuiltinEmitter { name = "await", emit = \args arities cm -> "(" & emit-rs-expr (list-at args 0) arities cm & ").join().unwrap()" },
   RsBuiltinEmitter { name = "par", emit = \args arities cm -> "{ let _f = " & emit-rs-expr (list-at args 0) arities cm & "; let _xs = " & emit-rs-expr (list-at args 1) arities cm & "; let _handles: Vec<_> = _xs.into_iter().map(|_x| { let _ff = _f.clone(); std::thread::spawn(move || _ff(_x)) }).collect(); _handles.into_iter().map(|h| h.join().unwrap()).collect::<Vec<_>>() }" },
   RsBuiltinEmitter { name = "race", emit = \args arities cm -> "{ let _tasks = " & emit-rs-expr (list-at args 0) arities cm & "; let _handles: Vec<_> = _tasks.into_iter().map(|_t| std::thread::spawn(move || _t(()))).collect(); _handles.into_iter().next().unwrap().join().unwrap() }" },
   RsBuiltinEmitter { name = "__record-set", emit = \args arities cm -> emit-rs-record-set args arities cm },
   RsBuiltinEmitter { name = "__linked-list-empty", emit = \args arities cm -> "vec![]" },
   RsBuiltinEmitter { name = "__linked-list-push", emit = \args arities cm -> "{ let mut _ll = " & emit-rs-expr (list-at args 0) arities cm & "; _ll.push(" & emit-rs-expr (list-at args 1) arities cm & "); _ll }" },
   RsBuiltinEmitter { name = "__linked-list-to-list", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm },
   RsBuiltinEmitter { name = "set-state", emit = \args arities cm -> "unsafe { _CODEX_STATE = " & emit-rs-expr (list-at args 0) arities cm & " }" },
   RsBuiltinEmitter { name = "get-state", emit = \args arities cm -> "unsafe { _CODEX_STATE }" },
   RsBuiltinEmitter { name = "run-state", emit = \args arities cm -> "{ let _saved = unsafe { _CODEX_STATE }; unsafe { _CODEX_STATE = " & emit-rs-expr (list-at args 0) arities cm & " }; let _result = " & emit-rs-expr (list-at args 1) arities cm & "; unsafe { _CODEX_STATE = _saved }; _result }" },
   RsBuiltinEmitter { name = "write-binary", emit = \args arities cm -> "{ use std::io::Write; let _bl = " & emit-rs-expr (list-at args 0) arities cm & "; let _bytes: Vec<u8> = _bl.iter().map(|b| *b as u8).collect(); std::io::stdout().write_all(&_bytes).unwrap(); std::io::stdout().flush().unwrap(); }" },
   RsBuiltinEmitter { name = "write-binary-file", emit = \args arities cm -> "{ let _bl = " & emit-rs-expr (list-at args 1) arities cm & "; let _bytes: Vec<u8> = _bl.iter().map(|b| *b as u8).collect(); std::fs::write(" & emit-rs-expr (list-at args 0) arities cm & ", &_bytes).unwrap(); }" },
   RsBuiltinEmitter { name = "list-files", emit = \args arities cm -> "std::fs::read_dir(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap().filter_map(|e| e.ok()).map(|e| e.path().to_string_lossy().to_string()).filter(|p| p.ends_with(&*" & emit-rs-expr (list-at args 1) arities cm & ")).collect::<Vec<String>>()" },
   RsBuiltinEmitter { name = "list-directories", emit = \args arities cm -> "std::fs::read_dir(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap().filter_map(|e| e.ok()).filter(|e| e.path().is_dir()).map(|e| e.path().to_string_lossy().to_string()).collect::<Vec<String>>()" },
   RsBuiltinEmitter { name = "create-directory", emit = \args arities cm -> "{ std::fs::create_dir_all(" & emit-rs-expr (list-at args 0) arities cm & ").unwrap(); }" },
   RsBuiltinEmitter { name = "path-combine", emit = \args arities cm -> "std::path::Path::new(&" & emit-rs-expr (list-at args 0) arities cm & ").join(&" & emit-rs-expr (list-at args 1) arities cm & ").to_string_lossy().to_string()" },
   RsBuiltinEmitter { name = "path-filename", emit = \args arities cm -> "std::path::Path::new(&" & emit-rs-expr (list-at args 0) arities cm & ").file_name().unwrap_or_default().to_string_lossy().to_string()" },
   RsBuiltinEmitter { name = "text-to-double-bits", emit = \args arities cm -> emit-rs-expr (list-at args 0) arities cm & ".parse::<f64>().unwrap().to_bits() as i64" }
  ]

  is-rs-builtin-name : Text -> Boolean
  is-rs-builtin-name (n) =
   let len = list-length rs-builtin-emitters
   in let pos = bsearch-rs-emitter-pos rs-builtin-emitters n 0 len
   in if pos >= len then False
      else (list-at rs-builtin-emitters pos).name == n

  emit-rs-builtin : Text, List IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-builtin (n) (args) (arities) (ctor-map) =
   let len = list-length rs-builtin-emitters
   in let pos = bsearch-rs-emitter-pos rs-builtin-emitters n 0 len
   in if pos >= len then ""
      else let entry = list-at rs-builtin-emitters pos
      in if entry.name == n then entry.emit args arities ctor-map
         else ""

  emit-rs-handle : IRExpr, List IRHandleClause, CodexType, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-handle (body) (clauses) (ty) (arities) (ctor-map) (depth) =
   "{ " & emit-rs-handle-clauses clauses arities ctor-map (depth + 1) & emit-rs-expr-at body arities ctor-map (depth + 1) & " }"

  emit-rs-handle-clauses : List IRHandleClause, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-handle-clauses (clauses) (arities) (ctor-map) (depth) =
   emit-rs-handle-clauses-loop clauses 0 arities ctor-map depth

  emit-rs-handle-clauses-loop : List IRHandleClause, Integer, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-handle-clauses-loop (clauses) (i) (arities) (ctor-map) (depth) =
   if i == list-length clauses then ""
   else let c = list-at clauses i
   in let unwrapped = rs-unwrap-clause-lambda (c.body) (list-length (c.params))
   in "let " & rs-sanitize (c.op-name) & " = |" & rs-sanitize (c.resume-name) & ": Box<dyn Fn(i64) -> i64>| { " & emit-rs-expr-at unwrapped arities ctor-map (depth + 1) & " }; " & emit-rs-handle-clauses-loop clauses (i + 1) arities ctor-map depth

  rs-unwrap-clause-lambda : IRExpr, Integer -> IRExpr
  rs-unwrap-clause-lambda (e) (n) =
   if n == 0 then e
   else when e
    is IrLambda (ps) (b) (t) (s) -> b
    is otherwise -> e

  emit-rs-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, CodexType, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-try (max) (body) (fb) (fail-stmts) (ty) (arities) (ctor-map) (depth) =
   let body-text = emit-rs-act body ty arities ctor-map
   in let fb-text = emit-rs-act fb ty arities ctor-map
   in let fail-text = emit-rs-act fail-stmts ty arities ctor-map
   in "{ let mut _try_ok = false; let mut _try_result = Default::default(); for _try_i in 0.." & integer-to-text max & " { match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| " & body-text & ")) { Ok(v) => { _try_result = v; _try_ok = true; break; } Err(_) => {} } } if _try_ok { _try_result } else { match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| " & fb-text & ")) { Ok(v) => v, Err(_) => " & fail-text & " } } }"

  emit-rs-record-set : List IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-record-set (args) (arities) (ctor-map) =
   let field-name = when (list-at args 1)
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in "{ let mut _r = " & emit-rs-expr (list-at args 0) arities ctor-map & ".clone(); _r." & rs-sanitize field-name & " = " & emit-rs-expr (list-at args 2) arities ctor-map & "; _r }"

Section: Apply Emission

  emit-rs-apply-args : List IRExpr, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-apply-args (args) (arities) (ctor-map) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-rs-expr (list-at args i) arities ctor-map
        else emit-rs-expr (list-at args i) arities ctor-map & ", " & emit-rs-apply-args args arities ctor-map (i + 1)

  emit-rs-apply : IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-apply (e) (arities) (ctor-map) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
      is IrName (n) (ty) (sp) ->
       if is-rs-builtin-name n then emit-rs-builtin n args arities ctor-map
       else if is-mktup-name n then "(" & emit-rs-apply-args args arities ctor-map 0 & ")"
       else if text-length n > 0 then if is-upper-letter (char-code (char-at n 0)) then emit-rs-ctor-apply n args arities ctor-map
       else let ar = lookup-arity arities n
       in if ar > 1 then if list-length args == ar then rs-sanitize n & "(" & emit-rs-apply-args args arities ctor-map 0 & ")"
          else emit-rs-expr-curried e arities ctor-map
       else emit-rs-expr-curried e arities ctor-map
       else emit-rs-expr-curried e arities ctor-map
      is otherwise -> emit-rs-expr-curried e arities ctor-map

  emit-rs-ctor-apply : Text, List IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-ctor-apply (name) (args) (arities) (ctor-map) =
   let parent = lookup-ctor-enum ctor-map name
   in let prefix = if text-length parent > 0 then rs-sanitize parent & "::" & rs-sanitize name else rs-sanitize name
   in prefix & "(" & emit-rs-apply-args args arities ctor-map 0 & ")"

  emit-rs-expr-curried : IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-expr-curried (e) (arities) (ctor-map) =
   let chain = collect-apply-chain e []
   in emit-rs-expr (chain.root) arities ctor-map & emit-rs-curried-args (chain.args) arities ctor-map 0

  emit-rs-curried-args : List IRExpr, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-curried-args (args) (arities) (ctor-map) (i) =
   if i == list-length args then ""
   else "(" & emit-rs-expr (list-at args i) arities ctor-map & ")" & emit-rs-curried-args args arities ctor-map (i + 1)

Section: Binary Emission

  emit-rs-bin-op : IRBinaryOp -> Text
  emit-rs-bin-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "%"
    is IrPowInt -> "^"
    is IrEq -> "=="
    is IrNotEq -> "!="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq | IrApproxEqExact -> "=="
    is IrAnd -> "&&"
    is IrOr -> "||"
    is IrAppendText | IrAppendList | IrConsList -> "+"

  emit-rs-binary : IRBinaryOp, IRExpr, IRExpr, CodexType, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-binary (op) (l) (r) (ty) (arities) (ctor-map) =
   when op
    is IrAppendText -> "format!(\"{}{}\", " & emit-rs-expr l arities ctor-map & ", " & emit-rs-expr r arities ctor-map & ")"
    is IrAppendList -> "{ let mut v = " & emit-rs-expr l arities ctor-map & ".clone(); v.extend(" & emit-rs-expr r arities ctor-map & ".iter().cloned()); v }"
    is IrConsList -> "{ let mut v = vec![" & emit-rs-expr l arities ctor-map & "]; v.extend(" & emit-rs-expr r arities ctor-map & ".iter().cloned()); v }"
    is IrPowInt -> emit-rs-expr l arities ctor-map & ".pow(" & emit-rs-expr r arities ctor-map & " as u32)"
    is otherwise -> "(" & emit-rs-expr l arities ctor-map & " " & emit-rs-bin-op op & " " & emit-rs-expr r arities ctor-map & ")"

Section: Lambda Emission

  emit-rs-lambda : List IRParam, IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-lambda (params) (body) (arities) (ctor-map) =
   if list-length params == 0 then "|| " & emit-rs-expr body arities ctor-map
   else "|" & emit-rs-lambda-params params 0 (list-length params) & "| " & emit-rs-expr body arities ctor-map

  emit-rs-lambda-params : List IRParam, Integer, Integer -> Text
  emit-rs-lambda-params (params) (i) (len) =
   if i == len then ""
   else let p = list-at params i
   in rs-sanitize (p.name) & ": " & rs-type (p.type-val) & (if i < len - 1 then ", " else "") & emit-rs-lambda-params params (i + 1) len

Section: List Emission

  emit-rs-list : List IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-list (elems) (arities) (ctor-map) =
   if list-length elems == 0 then "vec![]"
   else "vec![" & emit-rs-list-elems elems 0 arities ctor-map & "]"

  emit-rs-list-elems : List IRExpr, Integer, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-list-elems (elems) (i) (arities) (ctor-map) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-rs-expr (list-at elems i) arities ctor-map
   else emit-rs-expr (list-at elems i) arities ctor-map & ", " & emit-rs-list-elems elems (i + 1) arities ctor-map

Section: Match Emission

  emit-rs-match : IRExpr, List IRBranch, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-match (scrut) (branches) (arities) (ctor-map) =
   "match " & emit-rs-expr scrut arities ctor-map & " { " & emit-rs-match-arms branches 0 arities ctor-map & "}"

  emit-rs-match-arms : List IRBranch, Integer, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-match-arms (branches) (i) (arities) (ctor-map) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in emit-rs-pattern (b.pattern) ctor-map & rs-guard-clause (b.guard) arities ctor-map & " => " & emit-rs-expr (b.body) arities ctor-map & ", " & emit-rs-match-arms branches (i + 1) arities ctor-map

 Rust carries the guard itself: `pat if g =>` falls through to the next arm
 when the guard refuses, which is the semantics being lost, so nothing here
 is restructured.

  rs-guard-trivial : IRExpr -> Boolean
  rs-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  rs-guard-clause : IRExpr, List ArityEntry, List CtorEnumEntry -> Text
  rs-guard-clause (guard) (arities) (ctor-map) =
   if rs-guard-trivial guard then "" else " if " & emit-rs-expr guard arities ctor-map

  emit-rs-pattern : IRPat, List CtorEnumEntry -> Text
  emit-rs-pattern (p) (ctor-map) =
   when p
    is IrVarPat (name) (ty) (sp) -> rs-sanitize name
    is IrLitPat (text) (ty) (sp) -> emit-rs-lit-pat text ty
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then "(" & emit-rs-sub-patterns subs ctor-map 0 & ")"
     else let parent = lookup-ctor-enum ctor-map name
     in let prefix = if text-length parent > 0 then rs-sanitize parent & "::" & rs-sanitize name else rs-sanitize name
     in if list-length subs == 0 then prefix
        else prefix & "(" & emit-rs-sub-patterns subs ctor-map 0 & ")"
    is IrWildPat (sp) -> "_"
    is IrVecPat (pats) (ty) (sp) -> "_"

  emit-rs-lit-pat : Text, CodexType -> Text
  emit-rs-lit-pat (text) (ty) =
   when ty
    is BooleanTy -> text
    is IntegerTy (lo) (hi) (mode) -> text & "_i64"
    is TextTy -> "\"" & text & "\""
    is otherwise -> text

  emit-rs-sub-patterns : List IRPat, List CtorEnumEntry, Integer -> Text
  emit-rs-sub-patterns (subs) (ctor-map) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in emit-rs-sub-pattern sub ctor-map & (if i < list-length subs - 1 then ", " else "") & emit-rs-sub-patterns subs ctor-map (i + 1)

  emit-rs-sub-pattern : IRPat, List CtorEnumEntry -> Text
  emit-rs-sub-pattern (p) (ctor-map) =
   when p
    is IrVarPat (name) (ty) (sp) -> rs-sanitize name
    is IrCtorPat (name) (subs) (ty) (sp) -> emit-rs-pattern p ctor-map
    is IrWildPat (sp) -> "_"
    is IrLitPat (text) (ty) (sp) -> emit-rs-lit-pat text ty
    is IrVecPat (pats) (ty) (sp) -> "_"

Section: Act Emission

  emit-rs-act : List IRActStmt, CodexType, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-act (stmts) (ty) (arities) (ctor-map) =
   let actual-ty = when ty
    is EffectfulTy (effs) (sc) (ret) -> ret
    is otherwise -> ty
   in let len = list-length stmts
   in "{ " & emit-rs-act-stmts stmts 0 len (rs-act-needs-return actual-ty) arities ctor-map & " }"

  rs-act-needs-return : CodexType -> Boolean
  rs-act-needs-return (ty) =
   when ty
    is VoidTy -> False
    is NothingTy -> False
    is ProofTy -> False
    is PropEqTy (pl) (pr) -> False
    is otherwise -> True

  emit-rs-act-stmts : List IRActStmt, Integer, Integer, Boolean, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-act-stmts (stmts) (i) (len) (needs-return) (arities) (ctor-map) =
   if i == len then ""
   else let s = list-at stmts i
   in let is-last = i == len - 1
   in emit-rs-act-stmt s is-last needs-return arities ctor-map & " " & emit-rs-act-stmts stmts (i + 1) len needs-return arities ctor-map

  emit-rs-act-stmt : IRActStmt, Boolean, Boolean, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-act-stmt (s) (is-last) (needs-return) (arities) (ctor-map) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> "let " & rs-sanitize name & " = " & emit-rs-expr val arities ctor-map & ";"
    is IrDoExec (e) (sp) ->
     if is-last then if needs-return then emit-rs-expr e arities ctor-map
                     else emit-rs-expr e arities ctor-map & ";"
     else emit-rs-expr e arities ctor-map & ";"

Section: Record Emission

  emit-rs-record : Text, List IRFieldVal, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-record (name) (fields) (arities) (ctor-map) =
   rs-sanitize name & " { " & emit-rs-record-field-vals fields 0 arities ctor-map & " }"

  emit-rs-record-field-vals : List IRFieldVal, Integer, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-record-field-vals (fields) (i) (arities) (ctor-map) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in rs-sanitize (f.name) & ": " & emit-rs-expr (f.value) arities ctor-map & (if i < list-length fields - 1 then ", " else "") & emit-rs-record-field-vals fields (i + 1) arities ctor-map

Section: TCO Definition Emission

  emit-rs-tco-def : IRDef, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-tco-def (d) (arities) (ctor-map) =
   let ret = get-rs-return-type (d.type-val) (list-length (d.params))
   in let name = if d.name == opening-entry-point then "codex_main" else rs-sanitize (d.name)
   in "fn " & name & "(" & emit-rs-tco-params (d.params) 0 & ") -> " & rs-type ret & " {\n    loop {\n" & emit-rs-tco-body (d.body) (d.name) (d.params) arities ctor-map 0 & "    }\n}\n"

  emit-rs-tco-params : List IRParam, Integer -> Text
  emit-rs-tco-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in "mut " & rs-sanitize (p.name) & ": " & rs-type (p.type-val) & (if i < list-length params - 1 then ", " else "") & emit-rs-tco-params params (i + 1)

  emit-rs-tco-body : IRExpr, Text, List IRParam, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-tco-body (e) (func-name) (params) (arities) (ctor-map) (depth) =
   let pad = rs-pad (depth + 2)
   in when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     pad & "if " & emit-rs-expr c arities ctor-map & " {\n" & emit-rs-tco-body t func-name params arities ctor-map (depth + 1) & pad & "} else {\n" & emit-rs-tco-body el func-name params arities ctor-map (depth + 1) & pad & "}\n"
    is IrLet (name) (ty) (val) (body) (sp) ->
     pad & "let " & rs-sanitize name & " = " & emit-rs-expr val arities ctor-map & ";\n" & emit-rs-tco-body body func-name params arities ctor-map depth
    is IrMatch (scrut) (branches) (ty) (sp) ->
     pad & "match " & emit-rs-expr scrut arities ctor-map & " {\n" & emit-rs-tco-match-arms branches func-name params arities ctor-map (depth + 1) & pad & "}\n"
    is IrApply (f) (a) (ty) (sp) ->
     if is-self-call e func-name then emit-rs-tco-jump e params arities ctor-map pad
     else pad & "return " & emit-rs-expr e arities ctor-map & ";\n"
    is IrAct (stmts) (ty) (sp) ->
     emit-rs-tco-act stmts func-name params arities ctor-map depth
    is otherwise -> pad & "return " & emit-rs-expr e arities ctor-map & ";\n"

  emit-rs-tco-match-arms : List IRBranch, Text, List IRParam, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-tco-match-arms (branches) (func-name) (params) (arities) (ctor-map) (depth) =
   if list-length branches == 0 then ""
   else emit-rs-tco-match-arms-loop branches func-name params arities ctor-map depth 0

  emit-rs-tco-match-arms-loop : List IRBranch, Text, List IRParam, List ArityEntry, List CtorEnumEntry, Integer, Integer -> Text
  emit-rs-tco-match-arms-loop (branches) (func-name) (params) (arities) (ctor-map) (depth) (i) =
   if i == list-length branches then ""
   else let b = list-at branches i
   in let pad = rs-pad (depth + 2)
   in pad & emit-rs-pattern (b.pattern) ctor-map & " => {\n" & emit-rs-tco-body (b.body) func-name params arities ctor-map (depth + 1) & pad & "}\n" & emit-rs-tco-match-arms-loop branches func-name params arities ctor-map depth (i + 1)

  emit-rs-tco-act : List IRActStmt, Text, List IRParam, List ArityEntry, List CtorEnumEntry, Integer -> Text
  emit-rs-tco-act (stmts) (func-name) (params) (arities) (ctor-map) (depth) =
   emit-rs-tco-act-loop stmts func-name params arities ctor-map depth 0 (list-length stmts)

  emit-rs-tco-act-loop : List IRActStmt, Text, List IRParam, List ArityEntry, List CtorEnumEntry, Integer, Integer, Integer -> Text
  emit-rs-tco-act-loop (stmts) (func-name) (params) (arities) (ctor-map) (depth) (i) (len) =
   let pad = rs-pad (depth + 2)
   in if i == len then ""
   else let s = list-at stmts i
   in let is-last = i == len - 1
   in if is-last then when s
     is IrDoExec (e) (sp) -> emit-rs-tco-body e func-name params arities ctor-map depth
     is IrDoBind (name) (ty) (val) (sp) -> pad & "let " & rs-sanitize name & " = " & emit-rs-expr val arities ctor-map & ";\n"
    else when s
     is IrDoBind (name) (ty) (val) (sp) -> pad & "let " & rs-sanitize name & " = " & emit-rs-expr val arities ctor-map & ";\n" & emit-rs-tco-act-loop stmts func-name params arities ctor-map depth (i + 1) len
     is IrDoExec (e) (sp) -> pad & emit-rs-expr e arities ctor-map & ";\n" & emit-rs-tco-act-loop stmts func-name params arities ctor-map depth (i + 1) len

  emit-rs-tco-jump : IRExpr, List IRParam, List ArityEntry, List CtorEnumEntry, Text -> Text
  emit-rs-tco-jump (e) (params) (arities) (ctor-map) (pad) =
   let chain = collect-apply-chain e []
   in emit-rs-tco-temps (chain.args) params arities ctor-map pad 0 & emit-rs-tco-assigns params pad 0 & pad & "continue;\n"

  emit-rs-tco-temps : List IRExpr, List IRParam, List ArityEntry, List CtorEnumEntry, Text, Integer -> Text
  emit-rs-tco-temps (args) (params) (arities) (ctor-map) (pad) (i) =
   if i == list-length args then ""
   else pad & "let _tco_" & integer-to-text i & " = " & emit-rs-expr (list-at args i) arities ctor-map & ";\n" & emit-rs-tco-temps args params arities ctor-map pad (i + 1)

  emit-rs-tco-assigns : List IRParam, Text, Integer -> Text
  emit-rs-tco-assigns (params) (pad) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in pad & rs-sanitize (p.name) & " = _tco_" & integer-to-text i & ";\n" & emit-rs-tco-assigns params pad (i + 1)

  rs-pad : Integer -> Text
  rs-pad (n) = rs-pad-loop n 0 ""

  rs-pad-loop : Integer, Integer, Text -> Text
  rs-pad-loop (n) (i) (acc) =
   if i >= n then acc
   else rs-pad-loop n (i + 1) (acc & "    ")

Section: Definition Emission

  get-rs-return-type : CodexType, Integer -> CodexType
  get-rs-return-type (ty) (n) =
   if n == 0 then rs-strip-forall ty
   else when rs-strip-forall ty
    is FunTy (p) (fnrow) (r) -> get-rs-return-type r (n - 1)
    is otherwise -> ty

  rs-strip-forall : CodexType -> CodexType
  rs-strip-forall (ty) =
   when ty
    is ForAllTy (id) (body) -> rs-strip-forall body
    is ForAllEff (id) (body) -> rs-strip-forall body
    is LinearTy (body) -> rs-strip-forall body
    is TypeApply (body) (tyarg) -> rs-strip-forall body
    is otherwise -> ty

  emit-rs-def : IRDef, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-def (d) (arities) (ctor-map) =
   if should-tco d then emit-rs-tco-def d arities ctor-map
   else let ret = get-rs-return-type (d.type-val) (list-length (d.params))
   in let name = if d.name == opening-entry-point then "codex_main" else rs-sanitize (d.name)
   in "fn " & name & "(" & emit-rs-def-params (d.params) 0 & ") -> " & rs-type ret & " {\n    " & emit-rs-expr (d.body) arities ctor-map & "\n}\n"

  emit-rs-def-params : List IRParam, Integer -> Text
  emit-rs-def-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in rs-sanitize (p.name) & ": " & rs-type (p.type-val) & (if i < list-length params - 1 then ", " else "") & emit-rs-def-params params (i + 1)

Section: Chapter Emission

  rs-opening-return-type : List IRDef -> CodexType
  rs-opening-return-type (defs) = rs-opening-return-loop defs 0

  rs-opening-return-loop : List IRDef, Integer -> CodexType
  rs-opening-return-loop (defs) (i) =
   if i >= list-length defs then NothingTy
   else let d = list-at defs i in
     if d.name == opening-entry-point then rs-strip-fun-args (d.type-val)
     else rs-opening-return-loop defs (i + 1)

  rs-strip-fun-args : CodexType -> CodexType
  rs-strip-fun-args (ty) =
   when ty
    is FunTy (p) (fnrow) (r) -> rs-strip-fun-args r
    is ForAllTy (id) (body) -> rs-strip-fun-args body
    is ForAllEff (id) (body) -> rs-strip-fun-args body
    is LinearTy (body) -> rs-strip-fun-args body
    is TypeApply (body) (tyarg) -> rs-strip-fun-args body
    is EffectfulTy (effs) (sc) (ret) -> ret
    is otherwise -> ty

  rs-is-effectful : CodexType -> Boolean
  rs-is-effectful (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> True
    is VoidTy -> True
    is NothingTy -> True
    is ProofTy -> True
    is PropEqTy (pl) (pr) -> True
    is otherwise -> False

  emit-rs-entry-point : CodexType -> Text
  emit-rs-entry-point (ret-ty) =
   if rs-is-effectful ret-ty then "fn main() {\n    std::thread::Builder::new().name(\"codex-main\".into()).stack_size(512 * 1024 * 1024).spawn(|| codex_main()).unwrap().join().unwrap();\n}\n"
   else "fn main() {\n    std::thread::Builder::new().name(\"codex-main\".into()).stack_size(512 * 1024 * 1024).spawn(|| println!(\"{:?}\", codex_main())).unwrap().join().unwrap();\n}\n"

  emit-rs-defs-list : List IRDef, Integer, List ArityEntry, List CtorEnumEntry -> Text
  emit-rs-defs-list (defs) (i) (arities) (ctor-map) =
   if i == list-length defs then ""
   else emit-rs-def (list-at defs i) arities ctor-map & "\n" & emit-rs-defs-list defs (i + 1) arities ctor-map

  has-opening : List IRDef, Integer -> Boolean
  has-opening (defs) (i) =
   if i >= list-length defs then False
   else if (list-at defs i).name == opening-entry-point then list-length ((list-at defs i).params) == 0
   else has-opening defs (i + 1)

  emit-rs-chapter : IRChapter, List ATypeDef -> Text
  emit-rs-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let ctor-map = build-ctor-enum-map type-defs 0 []
   in let header = "#![allow(non_snake_case, unused_variables, dead_code, unused_mut, unreachable_patterns, unused_imports)]\n\nstatic mut _CODEX_STATE: i64 = 0;\n\n" & rs-text-builtins
   in let type-text = emit-rs-type-defs type-defs 0
   in let defs-text = emit-rs-defs-list (m.defs) 0 arities ctor-map
   in let entry = if has-opening (m.defs) 0 then emit-rs-entry-point (rs-opening-return-type (m.defs))
      else "fn main() {\n    println!(\"Chapter loaded.\");\n}\n"
   in header & type-text & defs-text & entry

 `str::replace` with an empty pattern inserts the replacement between every
 character, `str::split` on an empty pattern yields an empty field either
 side of every character, and `parse` followed by `unwrap` PANICS on
 anything that is not wholly numeric. Codex answers the string unchanged,
 one field, and a leading-digit prefix or 0.

  rs-text-builtins : Text
  rs-text-builtins =
   "fn _cx_text_replace(s: &str, a: &str, b: &str) -> String {\n    if a.is_empty() { return s.to_string(); }\n    s.replace(a, b)\n}\n\n"
   & "fn _cx_text_split(s: &str, sep: &str) -> Vec<String> {\n    if sep.is_empty() { return vec![s.to_string()]; }\n    s.split(sep).map(|x| x.to_string()).collect::<Vec<String>>()\n}\n\n"
   & "fn _cx_text_to_integer(s: &str) -> i64 {\n    let bs = s.as_bytes();\n    let mut i: usize = 0;\n    let mut neg = false;\n    if !bs.is_empty() && bs[0] == b'-' { neg = true; i = 1; }\n    let mut v: i64 = 0;\n    while i < bs.len() && bs[i] >= b'0' && bs[i] <= b'9' {\n        v = v * 10 + (bs[i] - b'0') as i64;\n        i += 1;\n    }\n    if neg { -v } else { v }\n}\n\n"

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

Page 1
