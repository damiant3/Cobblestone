Chapter: Julia Emitter
  cites Codex chapter Text
  cites Codex chapter Characters
  cites Codex chapter Lists
  cites Foreword chapter Sort

 Generates Julia source code from the IR.

Section: Keywords and Sanitization

  jl-keywords : List Text =
   ["begin", "break", "catch", "const", "continue", "do", "else",
    "elseif", "end", "export", "false", "finally", "for", "function",
    "global", "if", "import", "in", "let", "local", "macro", "module",
    "mutable", "quote", "return", "struct", "throw", "true", "try",
    "type", "using", "while", "abstract", "primitive"]

  jl-is-keyword : Text, Integer -> Boolean
  jl-is-keyword (name) (i) =
   if i == list-length jl-keywords then False
   else if list-at jl-keywords i == name then True
   else jl-is-keyword name (i + 1)

  jl-sanitize : Text -> Text
  jl-sanitize (name) =
   let s = text-replace name "-" "_"
   in if jl-is-keyword s then s & "_v"
      else s

  jl-escape : Text -> Text
  jl-escape (s) =
   let s1 = text-replace s "\\" "\\\\"
   in let s2 = text-replace s1 "\"" "\\\""
   in text-replace s2 "\n" "\\n"

  jl-indent : Integer -> Text
  jl-indent (n) = if n <= 0 then "" else "    " & jl-indent (n - 1)

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = list-length (d.params),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Type Definition Emission

  emit-jl-type-defs : List ATypeDef, Integer -> Text
  emit-jl-type-defs (tds) (i) =
   if i == list-length tds then ""
   else emit-jl-type-def (list-at tds i) & emit-jl-type-defs tds (i + 1)

  emit-jl-type-def : ATypeDef -> Text
  emit-jl-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (s) ->
     "struct " & jl-sanitize (name.value) & "\n" & emit-jl-record-fields fields 0 & "end\n\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     "abstract type " & jl-sanitize (name.value) & " end\n" & emit-jl-ctors ctors 0 (name.value) & "\n"

  emit-jl-record-fields : List ARecordFieldDef, Integer -> Text
  emit-jl-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in "    " & jl-sanitize (f.name.value) & "::Any\n" & emit-jl-record-fields fields (i + 1)

  emit-jl-ctors : List AVariantCtorDef, Integer, Text -> Text
  emit-jl-ctors (ctors) (i) (parent) =
   if i == list-length ctors then ""
   else let c = list-at ctors i
   in "struct " & jl-sanitize (c.name.value) & " <: " & jl-sanitize parent & "\n" & emit-jl-ctor-fields (c.fields) 0 & "end\n" & emit-jl-ctors ctors (i + 1) parent

  emit-jl-ctor-fields : List ATypeExpr, Integer -> Text
  emit-jl-ctor-fields (fields) (i) =
   if i == list-length fields then ""
   else "    field" & integer-to-text i & "::Any\n" & emit-jl-ctor-fields fields (i + 1)

Section: Expression Emission

  emit-jl-expr : IRExpr, List ArityEntry -> Text
  emit-jl-expr (e) (arities) = emit-jl-expr-at e arities 0

  emit-jl-expr-at : IRExpr, List ArityEntry, Integer -> Text
  emit-jl-expr-at (e) (arities) (depth) =
   if depth >= 256 then "nothing"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> "reinterpret(Float64, Int64(" & integer-to-text n & "))"
    is IrTextLit (s) (sp) -> "\"" & jl-escape s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n
    is IrName (n) (ty) (sp) -> emit-jl-name n arities
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-jl-binary op l r arities
    is IrNegate (operand) (sp) -> "(-" & emit-jl-expr-at operand arities (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-jl-expr-at c arities (depth + 1) & " ? " & emit-jl-expr-at t arities (depth + 1) & " : " & emit-jl-expr-at el arities (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> "(let " & jl-sanitize name & " = " & emit-jl-expr-at val arities (depth + 1) & "; " & emit-jl-expr-at body arities (depth + 1) & " end)"
    is IrApply (f) (a) (ty) (sp) -> emit-jl-apply e arities
    is IrLambda (params) (body) (ty) (sp) -> "((" & emit-jl-lambda-params params 0 & ") -> " & emit-jl-expr body arities & ")"
    is IrList (elems) (ty) (sp) -> "Any[" & emit-jl-list-elems elems 0 arities & "]"
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-jl-match scrut branches arities depth
    is IrAct (stmts) (ty) (sp) -> emit-jl-act stmts arities
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-jl-expr-at body arities (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-jl-expr-at body arities (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> jl-sanitize name & "(" & emit-jl-field-vals fields 0 arities & ")"
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-jl-expr-at rec arities (depth + 1) & "." & jl-sanitize field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "(let _r = " & emit-jl-expr-at rec arities (depth + 1) & "; setfield!(_r, :" & jl-sanitize field & ", " & emit-jl-expr-at val arities (depth + 1) & "); _r end)"
    is IrFork (body) (ty) (sp) -> "Threads.@spawn " & emit-jl-expr-at body arities (depth + 1)
    is IrAwait (task) (ty) (sp) -> "fetch(" & emit-jl-expr-at task arities (depth + 1) & ")"
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> "(try; " & emit-jl-act body arities & "; catch; " & emit-jl-act fb arities & " end)"
    is IrError (msg) (ty) (sp) -> "error(\"" & jl-escape msg & "\")"

  emit-jl-name : Text, List ArityEntry -> Text
  emit-jl-name (n) (arities) =
   if n == "True" then "true"
   else if n == "False" then "false"
   else if n == "Nothing" then "nothing"
   else let ar = lookup-arity arities n
   in if ar == 0 then jl-sanitize n & "()"
      else jl-sanitize n

  emit-jl-binary : IRBinaryOp, IRExpr, IRExpr, List ArityEntry -> Text
  emit-jl-binary (op) (l) (r) (arities) =
   when op
    is IrAppendText -> "(" & emit-jl-expr l arities & " * " & emit-jl-expr r arities & ")"
    is IrAppendList -> "vcat(" & emit-jl-expr l arities & ", " & emit-jl-expr r arities & ")"
    is IrConsList -> "vcat(Any[" & emit-jl-expr l arities & "], " & emit-jl-expr r arities & ")"
    is IrDivInt -> "div(" & emit-jl-expr l arities & ", " & emit-jl-expr r arities & ")"
    is IrAnd -> "(" & emit-jl-expr l arities & " && " & emit-jl-expr r arities & ")"
    is IrOr -> "(" & emit-jl-expr l arities & " || " & emit-jl-expr r arities & ")"
    is otherwise -> "(" & emit-jl-expr l arities & " " & jl-bin-op op & " " & emit-jl-expr r arities & ")"

  jl-bin-op : IRBinaryOp -> Text
  jl-bin-op (op) =
   when op
    is IrAddInt -> "+"  is IrSubInt -> "-"  is IrMulInt -> "*"  is IrDivInt -> "div"
    is IrPowInt -> "^"  is IrAddNum -> "+"  is IrSubNum -> "-"  is IrMulNum -> "*"
    is IrDivNum -> "/"  is IrEq -> "=="  is IrNotEq -> "!="
    is IrLt -> "<"  is IrGt -> ">"  is IrLtEq -> "<="  is IrGtEq -> ">="
    is IrAnd -> "&&"  is IrOr -> "||"  is IrAppendText -> "*"
    is IrAppendList -> "+"  is IrConsList -> "+"

  emit-jl-lambda-params : List IRParam, Integer -> Text
  emit-jl-lambda-params (params) (i) =
   if i == list-length params then ""
   else if i == list-length params - 1 then jl-sanitize ((list-at params i).name)
   else jl-sanitize ((list-at params i).name) & ", " & emit-jl-lambda-params params (i + 1)

  emit-jl-list-elems : List IRExpr, Integer, List ArityEntry -> Text
  emit-jl-list-elems (elems) (i) (arities) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then emit-jl-expr (list-at elems i) arities
   else emit-jl-expr (list-at elems i) arities & ", " & emit-jl-list-elems elems (i + 1) arities

  emit-jl-field-vals : List IRFieldVal, Integer, List ArityEntry -> Text
  emit-jl-field-vals (fields) (i) (arities) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let sep = if i > 0 then ", " else ""
   in sep & emit-jl-expr (f.value) arities & emit-jl-field-vals fields (i + 1) arities

  emit-jl-match : IRExpr, List IRBranch, List ArityEntry, Integer -> Text
  emit-jl-match (scrut) (branches) (arities) (depth) =
   "(let _s = " & emit-jl-expr scrut arities & "; " & emit-jl-match-body branches 0 arities depth & " end)"

  emit-jl-match-body : List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-jl-match-body (branches) (i) (arities) (depth) =
   if i == list-length branches then "error(\"Non-exhaustive match\")"
   else let b = list-at branches i
   in emit-jl-match-arm (b.pattern) (b.body) branches i arities depth

  emit-jl-match-arm : IRPat, IRExpr, List IRBranch, Integer, List ArityEntry, Integer -> Text
  emit-jl-match-arm (pat) (body) (branches) (i) (arities) (depth) =
   when pat
    is IrLitPat (text) (ty) (sp) -> "(_s == " & text & " ? " & emit-jl-expr body arities & " : " & emit-jl-match-body branches (i + 1) arities depth & ")"
    is IrCtorPat (name) (subs) (ty) (sp) -> "(isa(_s, " & jl-sanitize name & ") ? " & emit-jl-ctor-bind subs body arities & " : " & emit-jl-match-body branches (i + 1) arities depth & ")"
    is IrVarPat (name) (ty) (sp) -> "(let " & jl-sanitize name & " = _s; " & emit-jl-expr body arities & " end)"
    is IrWildPat (sp) -> emit-jl-expr body arities

  emit-jl-ctor-bind : List IRPat, IRExpr, List ArityEntry -> Text
  emit-jl-ctor-bind (subs) (body) (arities) =
   "(let " & emit-jl-ctor-bindings subs 0 & "; " & emit-jl-expr body arities & " end)"

  emit-jl-ctor-bindings : List IRPat, Integer -> Text
  emit-jl-ctor-bindings (subs) (i) =
   if i == list-length subs then "nothing"
   else let sub = list-at subs i
   in (when sub
    is IrVarPat (name) (ty) (sp) -> jl-sanitize name & " = _s.field" & integer-to-text i
    is otherwise -> "_" & integer-to-text i & " = nothing") & "; " & emit-jl-ctor-bindings subs (i + 1)

  emit-jl-act : List IRActStmt, List ArityEntry -> Text
  emit-jl-act (stmts) (arities) =
   "(begin; " & emit-jl-act-stmts stmts 0 arities & " end)"

  emit-jl-act-stmts : List IRActStmt, Integer, List ArityEntry -> Text
  emit-jl-act-stmts (stmts) (i) (arities) =
   if i == list-length stmts then "nothing"
   else let s = list-at stmts i
   in (when s
    is IrDoBind (name) (ty) (val) (sp) -> jl-sanitize name & " = " & emit-jl-expr val arities
    is IrDoExec (e) (sp) -> emit-jl-expr e arities) & "; " & (if i < list-length stmts - 1 then emit-jl-act-stmts stmts (i + 1) arities else "")

Section: Apply Emission

  emit-jl-apply : IRExpr, List ArityEntry -> Text
  emit-jl-apply (e) (arities) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) ->
     let bi = jl-try-builtin n args arities
     in if text-length bi > 0 then bi
     else jl-sanitize n & "(" & emit-jl-apply-args args arities 0 & ")"
    is otherwise -> emit-jl-expr root arities & "(" & emit-jl-apply-args args arities 0 & ")"

  emit-jl-apply-args : List IRExpr, List ArityEntry, Integer -> Text
  emit-jl-apply-args (args) (arities) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then emit-jl-expr (list-at args i) arities
        else emit-jl-expr (list-at args i) arities & ", " & emit-jl-apply-args args arities (i + 1)

  jl-try-builtin : Text, List IRExpr, List ArityEntry -> Text
  jl-try-builtin (n) (args) (arities) =
   if n == "print-line-uni" then "println(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "show" then "string(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "integer-to-text" then "string(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "text-to-integer" then "parse(Int64, " & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "text-length" then "length(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "list-length" then "length(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "list-at" then emit-jl-expr (list-at args 0) arities & "[" & emit-jl-expr (list-at args 1) arities & " + 1]"
   else if n == "char-at" then "Int64(codepoint(" & emit-jl-expr (list-at args 0) arities & "[" & emit-jl-expr (list-at args 1) arities & " + 1]))"
   else if n == "char-code" then emit-jl-expr (list-at args 0) arities
   else if n == "code-to-char" then emit-jl-expr (list-at args 0) arities
   else if n == "char-to-text" then "string(Char(" & emit-jl-expr (list-at args 0) arities & "))"
   else if n == "substring" then emit-jl-expr (list-at args 0) arities & "[" & emit-jl-expr (list-at args 1) arities & "+1:" & emit-jl-expr (list-at args 1) arities & "+" & emit-jl-expr (list-at args 2) arities & "]"
   else if n == "text-compare" then "cmp(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "text-replace" then "replace(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & " => " & emit-jl-expr (list-at args 2) arities & ")"
   else if n == "text-contains" then "occursin(" & emit-jl-expr (list-at args 1) arities & ", " & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "text-starts-with" then "startswith(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "read-file" then "read(" & emit-jl-expr (list-at args 0) arities & ", String)"
   else if n == "write-file" then "write(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "file-exists" then "isfile(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "process-exit" then "exit(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "int-mod" then "mod(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "bit-and" then "(" & emit-jl-expr (list-at args 0) arities & " & " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "bit-or" then "(" & emit-jl-expr (list-at args 0) arities & " | " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "bit-xor" then "xor(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "bit-shl" then "(" & emit-jl-expr (list-at args 0) arities & " << " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "bit-shr" then "(" & emit-jl-expr (list-at args 0) arities & " >> " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "min" then "min(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "max" then "max(" & emit-jl-expr (list-at args 0) arities & ", " & emit-jl-expr (list-at args 1) arities & ")"
   else if n == "abs" then "abs(" & emit-jl-expr (list-at args 0) arities & ")"
   else if n == "negate" then "(-" & emit-jl-expr (list-at args 0) arities & ")"
   else ""

Section: Definition Emission

  emit-jl-def : IRDef, List ArityEntry -> Text
  emit-jl-def (d) (arities) =
   let name = jl-sanitize (d.name)
   in "function " & name & "(" & emit-jl-lambda-params (d.params) 0 & ")\n    " & emit-jl-expr (d.body) arities & "\nend\n\n"

  emit-jl-defs : List IRDef, Integer, List ArityEntry -> Text
  emit-jl-defs (defs) (i) (arities) =
   if i == list-length defs then ""
   else emit-jl-def (list-at defs i) arities & emit-jl-defs defs (i + 1) arities

Section: Chapter Emission

  emit-julia-chapter : IRChapter, List ATypeDef -> Text
  emit-julia-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let types-text = emit-jl-type-defs type-defs 0
   in let defs-text = emit-jl-defs (m.defs) 0 arities
   in let entry = jl-emit-entry (m.defs)
   in types-text & defs-text & entry

  jl-emit-entry : List IRDef -> Text
  jl-emit-entry (defs) =
   jl-emit-entry-loop defs 0

  jl-emit-entry-loop : List IRDef, Integer -> Text
  jl-emit-entry-loop (defs) (i) =
   if i >= list-length defs then ""
   else let d = list-at defs i
   in if d.name == opening-entry-point then
    if list-length (d.params) == 0 then jl-sanitize opening-entry-point & "()\n" else ""
   else jl-emit-entry-loop defs (i + 1)

