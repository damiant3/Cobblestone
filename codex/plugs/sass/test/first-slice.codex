Chapter: SassFirstSlice
  cites Gpu chapter DeviceEffect

Section: Kernels

  gpu-scale-add : Integer, Integer, Integer -> [Device] Integer
  gpu-scale-add (xs) (out) (n) = act
   tid <- thread-idx-x
   if tid < n then scale-add-one xs out tid
   else 0
  end

  scale-add-one : Integer, Integer, Integer -> [Device] Integer
  scale-add-one (xs) (out) (tid) = act
   x <- device-load xs tid
   device-store out tid (x * 4 + 1)
  end

  gpu-global-index : Integer -> [Device] Integer
  gpu-global-index (out) = act
   tid <- thread-idx-x
   blk <- block-idx-x
   let gid = blk * 256 + tid
   in device-store out gid (gid - 1)
  end

  gpu-nested : Integer, Integer -> [Device] Integer
  gpu-nested (out) (n) = act
   tid <- thread-idx-x
   dim <- block-dim-x
   if tid < n then (if tid == 0 then device-store out tid dim else device-store out tid (tid - 1))
   else 0
  end

  gpu-refuse-recursion : Integer, Integer -> [Device] Integer
  gpu-refuse-recursion (out) (n) = act
   tid <- thread-idx-x
   device-store out tid (count-down n)
  end

  count-down : Integer -> [Device] Integer
  count-down (n) = if n < 1 then 0 else count-down (n - 1)

  gpu-refuse-multiply : Integer, Integer -> [Device] Integer
  gpu-refuse-multiply (out) (k) = act
   tid <- thread-idx-x
   device-store out tid (tid * k)
  end
