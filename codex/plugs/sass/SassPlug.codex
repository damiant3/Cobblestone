Chapter: SassPlug
  cites Foreword chapter Maybe

Section: Body

  dispatch : Text -> [Console] Nothing
  dispatch (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in print-line-uni (emit-sass-chapter (parsed.chapter))
  end

  opening : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch mode
      is None -> print-line-uni "no input"
  end
