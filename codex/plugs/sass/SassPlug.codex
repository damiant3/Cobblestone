Chapter: SassPlug
  cites Foreword chapter Maybe

Section: Body

  dispatch : Text, Text -> [Console] Nothing
  dispatch (sm) (mode) = act
    source <- read-serial-cce mode
    let parsed = parse-ir-chapter source
    in print-line-uni (if sm == "SM89" then emit-sass89-chapter (parsed.chapter) else emit-sass-chapter (parsed.chapter))
  end

  dispatch-sm : Text -> [Console] Nothing
  dispatch-sm (sm) = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> dispatch sm mode
      is None -> print-line-uni "no input"
  end

  opening : [Console] Nothing = act
    mode-result <- read-line-cce
    when mode-result
      is Just (mode) -> if mode == "SM89" then dispatch-sm mode else dispatch "SM52" mode
      is None -> print-line-uni "no input"
  end
