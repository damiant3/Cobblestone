Chapter: JavaScript Emitter
  cites Foreword chapter RankedTextSet
  cites Foreword chapter CCE

Section: Keywords and Sanitization

  js-keywords : RankedTextSet
  js-keywords =
   ranked-text-from-list ["abstract", "arguments", "async", "await",
    "break", "case", "catch", "class", "const", "continue",
    "debugger", "default", "delete", "do", "else",
    "export", "extends", "false", "finally", "for",
    "function", "if", "import", "in", "instanceof",
    "let", "new", "null", "of", "return",
    "super", "switch", "this", "throw", "true",
    "try", "typeof", "undefined", "var", "void",
    "while", "with", "yield"]

  is-js-keyword : Text -> Boolean
  is-js-keyword (n) = ranked-text-has js-keywords n

  js-sanitize : Text -> Text
  js-sanitize (name) =
   let s = text-replace name "-" "_"
   in if is-js-keyword s then "_" & s
      else s

  js-slash-pos : Text , Integer , Integer -> Integer
  js-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else js-slash-pos f (i + 1) len

  js-field : Text -> Text
  js-field (f) =
   let slash = js-slash-pos f 0 (text-length f)
   in if slash >= 0 then js-sanitize (substring f 0 slash)
      else js-sanitize f

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255
  }

  JsCtx = record {
   arities : List ArityEntry,
   type-defs : List ATypeDef
  }

  bsearch-arity-pos : List ArityEntry , Text , Integer , Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry , ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef , Integer , List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0
   }))

  lookup-arity : List ArityEntry , Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: Escape Helpers

  js-hex-digit : Integer -> Text
  js-hex-digit (n) =
   if n == 0 then "0"
   else if n == 1 then "1"
   else if n == 2 then "2"
   else if n == 3 then "3"
   else if n == 4 then "4"
   else if n == 5 then "5"
   else if n == 6 then "6"
   else if n == 7 then "7"
   else if n == 8 then "8"
   else if n == 9 then "9"
   else if n == 10 then "a"
   else if n == 11 then "b"
   else if n == 12 then "c"
   else if n == 13 then "d"
   else if n == 14 then "e"
   else if n == 15 then "f"
   else "?"

  js-hex-n : Integer -> Text
  js-hex-n (n) =
   if n < 16 then js-hex-digit n
   else js-hex-n (n / 16) & js-hex-digit (n - n / 16 * 16)

  js-hex4-padded : Integer -> Text
  js-hex4-padded (n) =
   let raw = js-hex-n n
   in let len = text-length raw
   in if len >= 4 then raw
   else if len == 3 then "0" & raw
   else if len == 2 then "00" & raw
   else if len == 1 then "000" & raw
   else "0000"

  js-escape-cce-char : Integer -> Text
  js-escape-cce-char (c) =
   let uni = to-unicode c
   in "\\u" & js-hex4-padded uni

  js-escape-text-loop : Text , Integer , Integer , List Text -> List Text
  js-escape-text-loop (s) (i) (len) (acc) =
   if i == len then acc
   else js-escape-text-loop s (i + 1) len (list-snoc acc (js-escape-cce-char (char-code (char-at s i))))

  js-escape-text : Text -> Text
  js-escape-text (s) =
   text-concat-list (js-escape-text-loop s 0 (text-length s) [])

Section: Type Definition Emission

  js-emit-type-defs : List ATypeDef , Integer -> Text
  js-emit-type-defs (tds) (i) =
   if i == list-length tds then ""
   else js-emit-type-def (list-at tds i) & js-emit-type-defs tds (i + 1)

  js-emit-type-def : ATypeDef -> Text
  js-emit-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     js-emit-record-type (name.value) fields 0 recmut
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if is-tup-type (name.value) then ""
     else js-emit-variant-type ctors 0
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  js-emit-record-type : Text , List ARecordFieldDef , Integer , Boolean -> Text
  js-emit-record-type (name) (fields) (i) (recmut) =
   let open = if recmut then "return ({ " else "return Object.freeze({ "
   in let close = if recmut then " });" else " });"
   in "function " & js-sanitize name & "(" & js-emit-record-params fields 0 & ") { " & open & js-emit-record-fields fields 0 & close & " }\n"

  js-emit-record-params : List ARecordFieldDef , Integer -> Text
  js-emit-record-params (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in js-sanitize (f.name.value) & (if i < list-length fields - 1 then ", " else "") & js-emit-record-params fields (i + 1)

  js-emit-record-fields : List ARecordFieldDef , Integer -> Text
  js-emit-record-fields (fields) (i) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let n = js-sanitize (f.name.value)
   in n & ": " & n & (if i < list-length fields - 1 then ", " else "") & js-emit-record-fields fields (i + 1)

  js-emit-variant-type : List AVariantCtorDef , Integer -> Text
  js-emit-variant-type (ctors) (i) =
   if i == list-length ctors then "\n"
   else js-emit-variant-ctor (list-at ctors i) & js-emit-variant-type ctors (i + 1)

  js-emit-variant-ctor : AVariantCtorDef -> Text
  js-emit-variant-ctor (c) =
   if list-length (c.fields) == 0 then "function " & js-sanitize (c.name.value) & "() { return Object.freeze({ tag: \"" & c.name.value & "\" }); }\n"
   else "function " & js-sanitize (c.name.value) & "(" & js-emit-ctor-params (c.fields) 0 & ") { return Object.freeze({ tag: \"" & c.name.value & "\", " & js-emit-ctor-field-list (c.fields) 0 & " }); }\n"

  js-emit-ctor-params : List ATypeExpr , Integer -> Text
  js-emit-ctor-params (fields) (i) =
   if i == list-length fields then ""
   else "field" & integer-to-text i & (if i < list-length fields - 1 then ", " else "") & js-emit-ctor-params fields (i + 1)

  js-emit-ctor-field-list : List ATypeExpr , Integer -> Text
  js-emit-ctor-field-list (fields) (i) =
   if i == list-length fields then ""
   else "field" & integer-to-text i & ": field" & integer-to-text i & (if i < list-length fields - 1 then ", " else "") & js-emit-ctor-field-list fields (i + 1)

Section: Expression Emission

  js-max-emit-depth : Integer = 256

  js-emit-expr : IRExpr , JsCtx -> Text
  js-emit-expr (e) (ctx) = js-emit-expr-at e ctx 0

  js-emit-expr-at : IRExpr , JsCtx , Integer -> Text
  js-emit-expr-at (e) (ctx) (depth) =
   if depth >= js-max-emit-depth then "undefined"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n & "n"
    is IrNumLit (n) (sp) -> "Number(BigInt.asIntN(64, " & integer-to-text n & "n))"
    is IrTextLit (s) (sp) -> "\"" & js-escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "true" else "false"
    is IrCharLit (n) (sp) -> integer-to-text n & "n"
    is IrName (n) (ty) (sp) -> js-emit-name n ty ctx
    is IrBinary (op) (l) (r) (ty) (sp) -> js-emit-binary op l r ctx
    is IrNegate (operand) (nty) (sp) -> "(-" & js-emit-expr-at operand ctx (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & js-emit-expr-at c ctx (depth + 1) & " ? " & js-emit-expr-at t ctx (depth + 1) & " : " & js-emit-expr-at el ctx (depth + 1) & ")"
    is IrLet (name) (ty) (val) (body) (sp) -> js-emit-let name val body ctx
    is IrApply (f) (a) (ty) (sp) -> js-emit-apply e ctx
    is IrLambda (params) (body) (ty) (sp) -> js-emit-lambda params body ctx
    is IrList (elems) (ty) (sp) -> js-emit-list elems ctx
    is IrMatch (scrut) (branches) (ty) (sp) -> js-emit-match scrut branches ctx
    is IrAct (stmts) (ty) (sp) -> js-emit-act stmts ctx
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> js-emit-expr-at body ctx (depth + 1)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> js-emit-expr-at body ctx (depth + 1)
    is IrRecord (name) (fields) (ty) (sp) -> js-emit-record name fields ty ctx
    is IrFieldAccess (rec) (field) (ty) (sp) -> js-emit-expr-at rec ctx (depth + 1) & "." & js-field field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> "((_r, _v) => (_r." & js-field field & " = _v, _r))(" & js-emit-expr-at rec ctx (depth + 1) & ", " & js-emit-expr-at val ctx (depth + 1) & ")"
    is IrFork (body) (ty) (sp) -> "Promise.resolve().then(() => (" & js-emit-expr-at body ctx (depth + 1) & ")(null))"
    is IrAwait (task) (ty) (sp) -> "(await " & js-emit-expr-at task ctx (depth + 1) & ")"
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> emit-js-try max body fb fail-stmts ctx
    is IrError (msg) (ty) (sp) -> "(() => { throw new Error(\"" & js-escape-text msg & "\"); })()"

  js-emit-name : Text , CodexType , JsCtx -> Text
  js-emit-name (n) (ty) (ctx) =
   if n == "read-line" then "(require('readline-sync').question(''))"
   else if n == "show" then "String"
   else if n == "negate" then "((x) => -x)"
   else if n == "get-state" then "_js_state_value"
   else if n == "__heap-save" then "0n"
   else if n == "__deck-pos" then "0n"
   else if n == "__deck-enter" then "0n"
   else if n == "__deck-exit" then "0n"
   else if n == "__linked-list-empty" then "[]"
   else if n == "get-args" then "process.argv"
   else if n == "current-dir" then "process.cwd()"
   else if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then js-emit-name-upper n ty ctx
   else let ar = lookup-arity (ctx.arities) n
   in if ar == 0 then js-sanitize n & "()"
      else if ar >= 2 then js-emit-partial-wrappers 0 ar & js-sanitize n & "(" & js-emit-partial-params 0 ar & ")"
      else js-sanitize n

  js-emit-name-upper : Text , CodexType , JsCtx -> Text
  js-emit-name-upper (n) (ty) (ctx) =
   when ty
    is FunTy (p) (fnrow) (r) -> js-sanitize n
    is otherwise -> js-sanitize n & "()"

  js-emit-partial-params : Integer , Integer -> Text
  js-emit-partial-params (i) (count) =
   if i == count then ""
   else if i == count - 1 then "_p" & integer-to-text i & "_"
        else "_p" & integer-to-text i & "_" & ", " & js-emit-partial-params (i + 1) count

  js-emit-partial-wrappers : Integer , Integer -> Text
  js-emit-partial-wrappers (i) (count) =
   if i == count then ""
   else "(_p" & integer-to-text i & "_) => " & js-emit-partial-wrappers (i + 1) count

  js-emit-binary : IRBinaryOp , IRExpr , IRExpr , JsCtx -> Text
  js-emit-binary (op) (l) (r) (ctx) =
   when op
    is IrAppendText -> "(" & js-emit-expr l ctx & " + " & js-emit-expr r ctx & ")"
    is IrAppendList -> "[..." & js-emit-expr l ctx & ", ..." & js-emit-expr r ctx & "]"
    is IrConsList -> "[" & js-emit-expr l ctx & ", ..." & js-emit-expr r ctx & "]"
    is IrPowInt -> "(" & js-emit-expr l ctx & " ** " & js-emit-expr r ctx & ")"
    is IrAddVec -> "(" & js-emit-expr l ctx & ".map((v,i) => v + " & js-emit-expr r ctx & "[i]))"
    is IrSubVec -> "(" & js-emit-expr l ctx & ".map((v,i) => v - " & js-emit-expr r ctx & "[i]))"
    is IrMulVec -> "(" & js-emit-expr l ctx & ".map((v,i) => v * " & js-emit-expr r ctx & "[i]))"
    is IrDivVec -> "(" & js-emit-expr l ctx & ".map((v,i) => v / " & js-emit-expr r ctx & "[i]))"
    is otherwise -> "(" & js-emit-expr l ctx & " " & js-emit-bin-op op & " " & js-emit-expr r ctx & ")"

  js-emit-bin-op : IRBinaryOp -> Text
  js-emit-bin-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "+"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "-"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "*"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "/"
    is IrRemInt -> "%"
    is IrPowInt -> "**"
    is IrEq -> "==="
    is IrNotEq -> "!=="
    is IrLt | IrLtVec -> "<"
    is IrGt | IrGtVec -> ">"
    is IrLtEq | IrLtEqVec -> "<="
    is IrGtEq | IrGtEqVec -> ">="
    is IrApproxEq -> "==="
    is IrApproxEqExact -> "==="
    is IrAnd -> "&&"
    is IrOr -> "||"
    is IrAppendText -> "+"
    is IrAppendList -> "+"
    is IrConsList -> "+"

  js-emit-let : Text , IRExpr , IRExpr , JsCtx -> Text
  js-emit-let (name) (val) (body) (ctx) =
   "((" & js-sanitize name & ") => " & js-emit-expr body ctx & ")(" & js-emit-expr val ctx & ")"

  js-emit-lambda : List IRParam , IRExpr , JsCtx -> Text
  js-emit-lambda (params) (body) (ctx) =
   if list-length params == 0 then "(() => " & js-emit-expr body ctx & ")"
   else "(" & js-emit-lambda-params params 0 (list-length params) & js-emit-expr body ctx & ")"

  js-emit-lambda-params : List IRParam , Integer , Integer -> Text
  js-emit-lambda-params (params) (i) (len) =
   if i == len then ""
   else let p = list-at params i
   in "(" & js-sanitize (p.name) & ") => " & js-emit-lambda-params params (i + 1) len

  js-emit-list : List IRExpr , JsCtx -> Text
  js-emit-list (elems) (ctx) =
   "[" & js-emit-list-elems elems 0 ctx & "]"

  js-emit-list-elems : List IRExpr , Integer , JsCtx -> Text
  js-emit-list-elems (elems) (i) (ctx) =
   if i == list-length elems then ""
   else if i == list-length elems - 1 then js-emit-expr (list-at elems i) ctx
   else js-emit-expr (list-at elems i) ctx & ", " & js-emit-list-elems elems (i + 1) ctx

 A clamping bounded field saturates at its declared band. JavaScript stores
 whatever it is given, so the saturation has to be emitted here from the
 field's declared type or it is silently lost. The bounds are BigInt
 literals because every integer this plug emits is a BigInt.

  js-lookup-rec-field-ty : List RecordField , Text , Integer -> CodexType
  js-lookup-rec-field-ty (fields) (name) (i) =
   if i == list-length fields then ErrorTy
   else let f = list-at fields i
   in if f.name.value == name then f.type-val
      else js-lookup-rec-field-ty fields name (i + 1)

  js-resolve-rec-fields : JsCtx , Name , List RecordField -> List RecordField
  js-resolve-rec-fields (ctx) (rn) (rf) =
   if list-length rf > 0 then rf
   else record-fields-by-name (ctx.type-defs) (rn.value) 0

  js-clamp-field-val : JsCtx , CodexType , Text , Text -> Text
  js-clamp-field-val (ctx) (rec-ty) (field-name) (val-text) =
   when rec-ty
    is RecordTy (rn) (ra) (rf) ->
     let ft = js-lookup-rec-field-ty (js-resolve-rec-fields ctx rn rf) field-name 0
     in when ft
      is IntegerTy (lo) (hi) (mode) ->
       when mode
        is OvClamping -> "((_v) => _v < " & integer-to-text lo & "n ? " & integer-to-text lo & "n : (_v > " & integer-to-text hi & "n ? " & integer-to-text hi & "n : _v))(" & val-text & ")"
        is otherwise -> val-text
      is otherwise -> val-text
    is otherwise -> val-text

  js-emit-record : Text , List IRFieldVal , CodexType , JsCtx -> Text
  js-emit-record (name) (fields) (ty) (ctx) =
   js-sanitize name & "(" & js-emit-record-args fields 0 ty ctx & ")"

  js-emit-record-args : List IRFieldVal , Integer , CodexType , JsCtx -> Text
  js-emit-record-args (fields) (i) (rec-ty) (ctx) =
   if i == list-length fields then ""
   else let f = list-at fields i
   in let val-text = js-emit-expr (f.value) ctx
   in let clamped = js-clamp-field-val ctx rec-ty (f.name) val-text
   in clamped & (if i < list-length fields - 1 then ", " else "") & js-emit-record-args fields (i + 1) rec-ty ctx

  js-emit-apply-args : List IRExpr , JsCtx , Integer -> Text
  js-emit-apply-args (args) (ctx) (i) =
   if i == list-length args then ""
   else if i == list-length args - 1 then js-emit-expr (list-at args i) ctx
        else js-emit-expr (list-at args i) ctx & ", " & js-emit-apply-args args ctx (i + 1)

  js-emit-match : IRExpr , List IRBranch , JsCtx -> Text
  js-emit-match (scrut) (branches) (ctx) =
   "((_s) => " & js-emit-match-branches branches ctx 0 0 & ")(" & js-emit-expr scrut ctx & ")"

  js-emit-match-branches : List IRBranch , JsCtx , Integer , Integer -> Text
  js-emit-match-branches (branches) (ctx) (i) (opens) =
   if i == list-length branches then " : (() => { throw new Error(\"Non-exhaustive match\"); })()" & js-close-parens opens
   else let b = list-at branches i
   in js-emit-match-branch b branches ctx i opens

 An integer is a BigInt in the emitted source, and `0n === 0` is false in
 JavaScript, so a literal pattern must carry the suffix its scrutinee has.

  js-lit-pat-text : Text , CodexType -> Text
  js-lit-pat-text (text) (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> text & "n"
    is otherwise -> text

  js-guard-trivial : IRExpr -> Boolean
  js-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  js-emit-match-branch : IRBranch , List IRBranch , JsCtx , Integer , Integer -> Text
  js-emit-match-branch (b) (branches) (ctx) (i) (opens) =
   when b.pattern
    is IrLitPat (text) (ty) (sp) ->
     let sep = if i > 0 then " : " else ""
     in let g = if js-guard-trivial (b.guard) then "" else " && (" & js-emit-expr (b.guard) ctx & ")"
     in sep & "(_s === " & js-lit-pat-text text ty & g & " ? " & js-emit-expr (b.body) ctx & js-emit-match-branches branches ctx (i + 1) (opens + 1)
    is IrCtorPat (name) (subs) (ty) (sp) ->
     let sep = if i > 0 then " : " else ""
     in if is-mktup-name name then
      let tup-body = "(() => { const [" & js-emit-tuple-pat-names subs 0 & "] = _s; return " & js-emit-expr (b.body) ctx & "; })()"
      in if js-guard-trivial (b.guard) then sep & "(" & tup-body & ")" & js-emit-match-branches branches ctx (i + 1) opens
         else sep & "((() => { const [" & js-emit-tuple-pat-names subs 0 & "] = _s; return " & js-emit-expr (b.guard) ctx & "; })() ? " & tup-body & js-emit-match-branches branches ctx (i + 1) (opens + 1)
     else let g = if js-guard-trivial (b.guard) then "" else " && " & js-emit-ctor-pattern-body subs (b.guard) ctx 0
     in sep & "(_s.tag === \"" & name & "\"" & g & " ? " & js-emit-ctor-pattern-body subs (b.body) ctx 0 & js-emit-match-branches branches ctx (i + 1) (opens + 1)
    is IrVarPat (name) (ty) (sp) ->
     let sep = if i > 0 then " : " else ""
     in let bound = "((" & js-sanitize name & ") => " & js-emit-expr (b.body) ctx & ")(_s)"
     in if js-guard-trivial (b.guard) then sep & bound & js-close-parens opens
        else sep & "(((" & js-sanitize name & ") => " & js-emit-expr (b.guard) ctx & ")(_s) ? " & bound & js-emit-match-branches branches ctx (i + 1) (opens + 1)
    is IrWildPat (sp) ->
     let sep = if i > 0 then " : " else ""
     in if js-guard-trivial (b.guard) then sep & js-emit-expr (b.body) ctx & js-close-parens opens
        else sep & "((" & js-emit-expr (b.guard) ctx & ") ? " & js-emit-expr (b.body) ctx & js-emit-match-branches branches ctx (i + 1) (opens + 1)
    is IrVecPat (pats) (ty) (sp) ->
     let sep = if i > 0 then " : " else ""
     in if js-guard-trivial (b.guard) then sep & js-emit-expr (b.body) ctx & js-close-parens opens
        else sep & "((" & js-emit-expr (b.guard) ctx & ") ? " & js-emit-expr (b.body) ctx & js-emit-match-branches branches ctx (i + 1) (opens + 1)

  js-emit-ctor-pattern-body : List IRPat , IRExpr , JsCtx , Integer -> Text
  js-emit-ctor-pattern-body (subs) (body) (ctx) (i) =
   let bindings = js-collect-ctor-bindings subs 0
   in if list-length bindings == 0 then js-emit-expr body ctx
      else "(() => { " & js-emit-ctor-binding-stmts bindings 0 & "return " & js-emit-expr body ctx & "; })()"

  CtorBinding = record {
   var-name : Text,
   field-index : Integer
  }

  js-collect-ctor-bindings : List IRPat , Integer -> List CtorBinding
  js-collect-ctor-bindings (subs) (i) =
   if i == list-length subs then []
   else when list-at subs i
    is IrVarPat (name) (ty) (sp) -> [CtorBinding { var-name = name, field-index = i }] & js-collect-ctor-bindings subs (i + 1)
    is otherwise -> js-collect-ctor-bindings subs (i + 1)

  js-emit-ctor-binding-stmts : List CtorBinding , Integer -> Text
  js-emit-ctor-binding-stmts (bindings) (i) =
   if i == list-length bindings then ""
   else let b = list-at bindings i
   in "const " & js-sanitize (b.var-name) & " = _s.field" & integer-to-text (b.field-index) & "; " & js-emit-ctor-binding-stmts bindings (i + 1)

  js-close-parens : Integer -> Text
  js-close-parens (n) =
   if n == 0 then ""
   else ")" & js-close-parens (n - 1)

  emit-js-try : Integer , List IRActStmt , List IRActStmt , List IRActStmt , JsCtx -> Text
  emit-js-try (max) (body) (fb) (fail-stmts) (ctx) =
   let body-text = js-emit-act body ctx
   in let fb-text = js-emit-act fb ctx
   in let fail-text = js-emit-act fail-stmts ctx
   in "(() => { let _try_ok = false; let _try_result; for (let _try_i = 0; _try_i < " & integer-to-text max & "; _try_i++) { try { _try_result = " & body-text & "; _try_ok = true; break; } catch (_e) {} } if (_try_ok) return _try_result; try { return " & fb-text & "; } catch (_e) { return " & fail-text & "; } })()"

  js-emit-act : List IRActStmt , JsCtx -> Text
  js-emit-act (stmts) (ctx) =
   "(() => {\n" & js-emit-act-stmts stmts 0 (list-length stmts) ctx & "})()"

  js-emit-act-stmts : List IRActStmt , Integer , Integer , JsCtx -> Text
  js-emit-act-stmts (stmts) (i) (len) (ctx) =
   if i == len then ""
   else let s = list-at stmts i
   in js-emit-act-stmt s ctx & js-emit-act-stmts stmts (i + 1) len ctx

  js-emit-act-stmt : IRActStmt , JsCtx -> Text
  js-emit-act-stmt (s) (ctx) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> "    const " & js-sanitize name & " = " & js-emit-expr val ctx & ";\n"
    is IrDoExec (e) (sp) -> "    " & js-emit-expr e ctx & ";\n"

  js-emit-apply : IRExpr , JsCtx -> Text
  js-emit-apply (e) (ctx) =
   let chain = collect-apply-chain e []
   in let root = chain.root
   in let args = chain.args
   in when root
    is IrName (n) (ty) (sp) -> js-emit-apply-named n ty args ctx e
    is otherwise -> js-emit-expr-curried e ctx

  js-emit-apply-named : Text , CodexType , List IRExpr , JsCtx , IRExpr -> Text
  js-emit-apply-named (n) (ty) (args) (ctx) (original) =
   let builtin-result = js-try-builtin n args ctx
   in if text-length builtin-result > 0 then builtin-result
   else if is-mktup-name n then "[" & js-emit-apply-args args ctx 0 & "]"
   else if text-length n > 0 & is-upper-letter (char-code (char-at n 0)) then js-sanitize n & "(" & js-emit-apply-args args ctx 0 & ")"
   else let ar = lookup-arity (ctx.arities) n
   in if ar > 1 & list-length args == ar then js-sanitize n & "(" & js-emit-apply-args args ctx 0 & ")"
      else if ar > 1 & list-length args < ar then let remaining = ar - list-length args
        in js-emit-partial-wrappers 0 remaining & js-sanitize n & "(" & js-emit-apply-args args ctx 0 & ", " & js-emit-partial-params 0 remaining & ")"
      else js-emit-expr-curried original ctx

  js-emit-expr-curried : IRExpr , JsCtx -> Text
  js-emit-expr-curried (e) (ctx) =
   when e
    is IrApply (f) (a) (ty) (sp) -> js-emit-expr f ctx & "(" & js-emit-expr a ctx & ")"
    is otherwise -> js-emit-expr e ctx

 The character predicates test CCE BANDS and must never be handed to a
 JavaScript regular expression over `String.fromCharCode`. Codex text is
 CCE, which numbers its code points by frequency: the letter a is 15, and
 character 15 is a control character, so `/^[a-zA-Z]/` answers false. The
 bands are 1..2 whitespace, 3..12 digit, and 13..64 or 97..127 letter,
 the hole being CCE's punctuation at 65..96.

 Each is an arrow applied immediately so the operand appears once. The
 two-band letter test would otherwise repeat its argument four times, and
 the argument is an arbitrary expression.

  js-try-builtin : Text , List IRExpr , JsCtx -> Text
  js-try-builtin (n) (args) (ctx) =
   if n == "__narrow" then js-emit-expr (list-at args 0) ctx
   else if n == "show" then "String(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "negate" then "(-" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "print-line-uni" then "console.log(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "print-error-uni" then "console.error(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "text-length" then "BigInt(" & js-emit-expr (list-at args 0) ctx & ".length)"
   else if n == "char-to-text" then "String.fromCharCode(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "char-encode" then "((c)=>{c=Number(c);if(c<128)return String.fromCharCode(c);if(c<2176){const v=c-128;return String.fromCharCode(192|(v>>6),128|(v&63));}if(c<67712){const v=c-2176;return String.fromCharCode(224|(v>>12),128|((v>>6)&63),128|(v&63));}const v=c-67712;return String.fromCharCode(240|(v>>18),128|((v>>12)&63),128|((v>>6)&63),128|(v&63));})(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "is-letter" then "((c)=>(c>=13&&c<=64)||(c>=97&&c<=127))(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "is-digit" then "((c)=>c>=3&&c<=12)(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "is-whitespace" then "((c)=>c>=1&&c<=2)(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "text-to-integer" then "_cx_text_to_integer(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "integer-to-text" then "String(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "char-code" then js-emit-expr (list-at args 0) ctx
   else if n == "code-to-char" then js-emit-expr (list-at args 0) ctx
   else if n == "char-code-at" then "BigInt(" & js-emit-expr (list-at args 0) ctx & ".charCodeAt(Number(" & js-emit-expr (list-at args 1) ctx & ")))"
   else if n == "list-length" then "BigInt(" & js-emit-expr (list-at args 0) ctx & ".length)"
   else if n == "open-file" then "require('fs').readFileSync(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "read-all" then js-emit-expr (list-at args 0) ctx & ".toString()"
   else if n == "close-file" then "undefined"
   else if n == "read-text" then "require('fs').readFileSync(" & js-emit-expr (list-at args 0) ctx & ", 'utf8')"
   else if n == "write-file" & list-length args == 2 then "require('fs').writeFileSync(" & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "file-exists" & list-length args == 1 then "require('fs').existsSync(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "char-at" & list-length args == 2 then "BigInt(" & js-emit-expr (list-at args 0) ctx & ".charCodeAt(Number(" & js-emit-expr (list-at args 1) ctx & ")))"
   else if n == "substring" & list-length args == 3 then js-emit-expr (list-at args 0) ctx & ".substring(Number(" & js-emit-expr (list-at args 1) ctx & "), Number(" & js-emit-expr (list-at args 1) ctx & " + " & js-emit-expr (list-at args 2) ctx & "))"
   else if n == "list-at" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & "[Number(" & js-emit-expr (list-at args 1) ctx & ")]"
   else if (n == "list-snoc" | n == "list-push") & list-length args == 2 then "[..." & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & "]"
   else if n == "list-insert-at" & list-length args == 3 then "(() => { const _l = [...(" & js-emit-expr (list-at args 0) ctx & ")]; _l.splice(Number(" & js-emit-expr (list-at args 1) ctx & "), 0, " & js-emit-expr (list-at args 2) ctx & "); return _l; })()"
   else if n == "list-set-at" & list-length args == 3 then "(() => { const _l = [...(" & js-emit-expr (list-at args 0) ctx & ")]; _l[Number(" & js-emit-expr (list-at args 1) ctx & ")] = " & js-emit-expr (list-at args 2) ctx & "; return _l; })()"
   else if n == "text-replace" & list-length args == 3 then "_cx_text_replace(" & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & ", " & js-emit-expr (list-at args 2) ctx & ")"
   else if n == "text-compare" & list-length args == 2 then "BigInt(" & js-emit-expr (list-at args 0) ctx & " < " & js-emit-expr (list-at args 1) ctx & " ? -1 : " & js-emit-expr (list-at args 0) ctx & " > " & js-emit-expr (list-at args 1) ctx & " ? 1 : 0)"
   else if n == "text-concat-list" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".join(\"\")"
   else if n == "text-split" & list-length args == 2 then "_cx_text_split(" & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "text-contains" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".includes(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "text-starts-with" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".startsWith(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-and" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & " & " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-or" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & " | " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-xor" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & " ^ " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-shl" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & " << " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-shr" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & " >> " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "bit-not" & list-length args == 1 then "(~" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "int-mod" & list-length args == 2 then "(((_a, _b) => { const _abs = _b < 0n ? -_b : _b; const _r = _a % _abs; return _r < 0n ? _r + _abs : _r; })(" & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & "))"
   else if n == "min" & list-length args == 2 then "((" & js-emit-expr (list-at args 0) ctx & ") < (" & js-emit-expr (list-at args 1) ctx & ") ? (" & js-emit-expr (list-at args 0) ctx & ") : (" & js-emit-expr (list-at args 1) ctx & "))"
   else if n == "max" & list-length args == 2 then "((" & js-emit-expr (list-at args 0) ctx & ") > (" & js-emit-expr (list-at args 1) ctx & ") ? (" & js-emit-expr (list-at args 0) ctx & ") : (" & js-emit-expr (list-at args 1) ctx & "))"
   else if n == "abs" & list-length args == 1 then "((" & js-emit-expr (list-at args 0) ctx & ") < 0n ? -(" & js-emit-expr (list-at args 0) ctx & ") : (" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "fork" & list-length args == 1 then "Promise.resolve().then(() => (" & js-emit-expr (list-at args 0) ctx & ")(null))"
   else if n == "await" & list-length args == 1 then "(await " & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "par" & list-length args == 2 then "await Promise.all(" & js-emit-expr (list-at args 1) ctx & ".map(_x_ => Promise.resolve().then(() => (" & js-emit-expr (list-at args 0) ctx & ")(_x_))))"
   else if n == "race" & list-length args == 1 then "await Promise.race(" & js-emit-expr (list-at args 0) ctx & ".map(_t_ => Promise.resolve().then(() => _t_(null))))"
   else if n == "process-exit" & list-length args == 1 then "process.exit(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "get-args" then "process.argv"
   else if n == "current-dir" then "process.cwd()"
   else if n == "get-env" & list-length args == 1 then "(process.env[" & js-emit-expr (list-at args 0) ctx & "] || \"\")"
   else if n == "write-binary" & list-length args == 1 then "(() => { const _bl = " & js-emit-expr (list-at args 0) ctx & "; process.stdout.write(Buffer.from(_bl.map(Number))); })()"
   else if n == "__record-set" & list-length args == 3 then js-emit-record-set args ctx
   else if n == "text-ends-with" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".endsWith(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "text-to-double-bits" & list-length args == 1 then "(() => { const _buf = new ArrayBuffer(8); new Float64Array(_buf)[0] = parseFloat(" & js-emit-expr (list-at args 0) ctx & "); return new DataView(_buf).getBigInt64(0, true); })()"
   else if n == "list-files" & list-length args == 2 then "require('fs').readdirSync(" & js-emit-expr (list-at args 0) ctx & ").filter(_f => _f.match(new RegExp(" & js-emit-expr (list-at args 1) ctx & ".replaceAll('*', '.*').replaceAll('?', '.'))))"
   else if n == "list-directories" & list-length args == 1 then "require('fs').readdirSync(" & js-emit-expr (list-at args 0) ctx & ", { withFileTypes: true }).filter(_d => _d.isDirectory()).map(_d => _d.name)"
   else if n == "write-binary-file" & list-length args == 2 then "(() => { const _bl = " & js-emit-expr (list-at args 1) ctx & "; require('fs').writeFileSync(" & js-emit-expr (list-at args 0) ctx & ", Buffer.from(_bl.map(Number))); })()"
   else if n == "create-directory" & list-length args == 1 then "require('fs').mkdirSync(" & js-emit-expr (list-at args 0) ctx & ", { recursive: true })"
   else if n == "path-combine" & list-length args == 2 then "require('path').join(" & js-emit-expr (list-at args 0) ctx & ", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "path-filename" & list-length args == 1 then "require('path').basename(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "run-process" & list-length args == 2 then "require('child_process').execSync(" & js-emit-expr (list-at args 0) ctx & " + ' ' + " & js-emit-expr (list-at args 1) ctx & ", { encoding: 'utf8' })"
   else if n == "run-process-full" & list-length args == 2 then "(() => { try { const _o = require('child_process').execSync(" & js-emit-expr (list-at args 0) ctx & " + ' ' + " & js-emit-expr (list-at args 1) ctx & ", { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }); return ProcessResult(_o, '', 0n); } catch(_e) { return ProcessResult(_e.stdout || '', _e.stderr || '', BigInt(_e.status || 1)); } })()"
   else if n == "set-state" & list-length args == 1 then "(_js_state_value = " & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "get-state" then "_js_state_value"
   else if n == "run-state" & list-length args == 2 then "(() => { const _saved = _js_state_value; _js_state_value = " & js-emit-expr (list-at args 0) ctx & "; try { return (" & js-emit-expr (list-at args 1) ctx & "); } finally { _js_state_value = _saved; } })()"
   else if n == "__linked-list-empty" then "[]"
   else if n == "__linked-list-push" & list-length args == 2 then "(() => { const _ll = " & js-emit-expr (list-at args 0) ctx & "; _ll.push(" & js-emit-expr (list-at args 1) ctx & "); return _ll; })()"
   else if n == "__linked-list-to-list" & list-length args == 1 then js-emit-expr (list-at args 0) ctx
   else if n == "__heap-save" then "0n"
   else if n == "__heap-restore" & list-length args == 1 then "0n"
   else if n == "__heap-advance" & list-length args == 1 then "0n"
   else if n == "__deck-pos" then "0n"
   else if n == "__deck-set" & list-length args == 1 then "0n"
   else if n == "__deck-alloc" & list-length args == 1 then "0n"
   else if n == "__deck-enter" then "0n"
   else if n == "__deck-exit" then "0n"
   else if n == "__list-with-capacity" & list-length args == 1 then "[]"
   else if n == "__buf-write-byte" & list-length args == 3 then "0n"
   else if n == "__buf-write-bytes" & list-length args == 3 then "0n"
   else if n == "__buf-read-bytes" & list-length args == 3 then "[]"
   else if n == "dom-get-by-id" & list-length args == 1 then "document.getElementById(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "dom-query" & list-length args == 1 then "document.querySelector(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "dom-query-all" & list-length args == 1 then "Array.from(document.querySelectorAll(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "dom-create" & list-length args == 1 then "document.createElement(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "dom-set-text" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & ".textContent = " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-set-html" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & ".innerHTML = " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-get-text" & list-length args == 1 then "(" & js-emit-expr (list-at args 0) ctx & ".textContent || \"\")"
   else if n == "dom-append" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".appendChild(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-remove" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".remove()"
   else if n == "dom-set-attr" & list-length args == 3 then js-emit-expr (list-at args 0) ctx & ".setAttribute(" & js-emit-expr (list-at args 1) ctx & ", " & js-emit-expr (list-at args 2) ctx & ")"
   else if n == "dom-get-attr" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & ".getAttribute(" & js-emit-expr (list-at args 1) ctx & ") || \"\")"
   else if n == "dom-set-style" & list-length args == 3 then "(" & js-emit-expr (list-at args 0) ctx & ".style[" & js-emit-expr (list-at args 1) ctx & "] = " & js-emit-expr (list-at args 2) ctx & ")"
   else if n == "dom-add-class" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".classList.add(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-remove-class" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".classList.remove(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-toggle-class" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".classList.toggle(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-has-class" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".classList.contains(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-closest" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".closest(" & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-dataset-get" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & ".dataset[" & js-emit-expr (list-at args 1) ctx & "] || \"\")"
   else if n == "dom-on-click" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".addEventListener(\"click\", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-on-change" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".addEventListener(\"change\", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-on-input" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".addEventListener(\"input\", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-on-key" & list-length args == 2 then js-emit-expr (list-at args 0) ctx & ".addEventListener(\"keydown\", " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-body" then "document.body"
   else if n == "dom-get-value" & list-length args == 1 then "(" & js-emit-expr (list-at args 0) ctx & ".value || \"\")"
   else if n == "dom-set-value" & list-length args == 2 then "(" & js-emit-expr (list-at args 0) ctx & ".value = " & js-emit-expr (list-at args 1) ctx & ")"
   else if n == "dom-prevent-default" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".preventDefault()"
   else if n == "dom-stop-propagation" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".stopPropagation()"
   else if n == "dom-event-target" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".target"
   else if n == "dom-event-key" & list-length args == 1 then js-emit-expr (list-at args 0) ctx & ".key"
   else if n == "set-timeout" & list-length args == 2 then "setTimeout(" & js-emit-expr (list-at args 0) ctx & ", Number(" & js-emit-expr (list-at args 1) ctx & "))"
   else if n == "set-interval" & list-length args == 2 then "setInterval(" & js-emit-expr (list-at args 0) ctx & ", Number(" & js-emit-expr (list-at args 1) ctx & "))"
   else if n == "clear-interval" & list-length args == 1 then "clearInterval(Number(" & js-emit-expr (list-at args 0) ctx & "))"
   else if n == "json-parse" & list-length args == 1 then "JSON.parse(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "json-stringify" & list-length args == 1 then "JSON.stringify(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "console-log" & list-length args == 1 then "console.log(" & js-emit-expr (list-at args 0) ctx & ")"
   else if n == "dom-not-null" & list-length args == 1 then "(" & js-emit-expr (list-at args 0) ctx & " != null)"
   else if n == "dom-document" then "document"
   else if n == "dom-window" then "window"
   else ""

  js-emit-record-set : List IRExpr , JsCtx -> Text
  js-emit-record-set (args) (ctx) =
   let field-name = when (list-at args 1)
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in "Object.freeze({ ..." & js-emit-expr (list-at args 0) ctx & ", " & js-sanitize field-name & ": " & js-emit-expr (list-at args 2) ctx & " })"

Section: Tail Call Optimization

  js-is-self-call : IRExpr , Text -> Boolean
  js-is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in js-is-self-call-root (chain.root) func-name

  js-is-self-call-root : IRExpr , Text -> Boolean
  js-is-self-call-root (e) (func-name) =
   when e
    is IrName (n) (ty) (sp) -> n == func-name
    is otherwise -> False

  js-has-tail-call : IRExpr , Text -> Boolean
  js-has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> js-has-tail-call t func-name | js-has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> js-has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> js-has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> js-is-self-call e func-name
    is IrAct (stmts) (ty) (sp) -> js-has-tail-call-act stmts func-name
    is otherwise -> False

  js-has-tail-call-branches : List IRBranch , Text , Integer -> Boolean
  js-has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if js-has-tail-call (b.body) func-name then True
      else js-has-tail-call-branches branches func-name (i + 1)

  js-has-tail-call-act : List IRActStmt , Text -> Boolean
  js-has-tail-call-act (stmts) (func-name) =
   let len = list-length stmts
   in if len == 0 then False
    else let last = list-at stmts (len - 1)
     in when last
      is IrDoExec (e) (sp) -> js-has-tail-call e func-name
      is otherwise -> False

  js-should-tco : IRDef -> Boolean
  js-should-tco (d) =
   if list-length (d.params) == 0 then False
   else js-has-tail-call (d.body) (d.name)

Section: Definition Emission

  js-is-effectful : IRDef -> Boolean
  js-is-effectful (d) =
   when d.type-val
    is EffectfulTy (effs) (sc) (inner) -> True
    is otherwise -> js-is-effectful-from-params (d.type-val) (list-length (d.params))

  js-is-effectful-from-params : CodexType , Integer -> Boolean
  js-is-effectful-from-params (ty) (n) =
   if n == 0 then when ty
    is EffectfulTy (effs) (sc) (inner) -> True
    is otherwise -> False
   else when ty
    is FunTy (p) (fnrow) (r) -> js-is-effectful-from-params r (n - 1)
    is ForAllTy (id) (body) -> js-is-effectful-from-params body n
    is ForAllEff (id) (body) -> js-is-effectful-from-params body n
    is LinearTy (body) -> js-is-effectful-from-params body n
    is TypeApply (body) (tyarg) -> js-is-effectful-from-params body n
    is otherwise -> False

  js-emit-def : IRDef , JsCtx -> Text
  js-emit-def (d) (ctx) =
   if js-should-tco d then js-emit-tco-def d ctx
   else js-emit-normal-def d ctx

  js-emit-normal-def : IRDef , JsCtx -> Text
  js-emit-normal-def (d) (ctx) =
   let effectful = js-is-effectful d
   in "function " & js-sanitize (d.name) & "(" & js-emit-def-params (d.params) 0 & ") {\n" & (if effectful then "    " & js-emit-expr (d.body) ctx & ";\n" else "    return " & js-emit-expr (d.body) ctx & ";\n") & "}\n"

  js-emit-def-params : List IRParam , Integer -> Text
  js-emit-def-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in js-sanitize (p.name) & (if i < list-length params - 1 then ", " else "") & js-emit-def-params params (i + 1)

  js-emit-tco-def : IRDef , JsCtx -> Text
  js-emit-tco-def (d) (ctx) =
   "function " & js-sanitize (d.name) & "(" & js-emit-def-params (d.params) 0 & ") {\n    while (true) {\n" & js-emit-tco-body (d.body) (d.name) (d.params) ctx 0 & "    }\n}\n"

  js-emit-tco-body : IRExpr , Text , List IRParam , JsCtx , Integer -> Text
  js-emit-tco-body (e) (func-name) (params) (ctx) (depth) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     "        if (" & js-emit-expr c ctx & ") {\n" & js-emit-tco-body t func-name params ctx depth & "        } else {\n" & js-emit-tco-body el func-name params ctx depth & "        }\n"
    is IrLet (name) (ty) (val) (body) (sp) ->
     "        const " & js-sanitize name & " = " & js-emit-expr val ctx & ";\n" & js-emit-tco-body body func-name params ctx depth
    is IrMatch (scrut) (branches) (ty) (sp) ->
     js-emit-tco-match scrut branches func-name params ctx depth
    is IrApply (f) (a) (rty) (sp) ->
     if js-is-self-call e func-name then js-emit-tco-jump e params ctx
     else "        return " & js-emit-expr e ctx & ";\n"
    is IrAct (stmts) (ty) (sp) -> js-emit-tco-act stmts func-name params ctx depth
    is otherwise -> "        return " & js-emit-expr e ctx & ";\n"

  js-emit-tco-match : IRExpr , List IRBranch , Text , List IRParam , JsCtx , Integer -> Text
  js-emit-tco-match (scrut) (branches) (func-name) (params) (ctx) (depth) =
   let s-var = js-tco-scrut-var depth
   in "        const " & s-var & " = " & js-emit-expr scrut ctx & ";\n" & js-emit-tco-match-branches branches func-name params ctx 0 True depth

  js-tco-scrut-var : Integer -> Text
  js-tco-scrut-var (depth) =
   if depth == 0 then "_tco_s" else "_tco_s" & integer-to-text depth

  js-emit-tco-match-branches : List IRBranch , Text , List IRParam , JsCtx , Integer , Boolean , Integer -> Text
  js-emit-tco-match-branches (branches) (func-name) (params) (ctx) (i) (is-first) (depth) =
   if i == list-length branches then
    (if js-tco-has-open-catch-all branches 0 then ""
     else "        else { throw new Error(\"Non-exhaustive match\"); }\n")
   else let b = list-at branches i
   in js-emit-tco-match-branch b func-name params ctx i is-first depth & js-emit-tco-match-branches branches func-name params ctx (i + 1) False depth

  js-tco-has-open-catch-all : List IRBranch , Integer -> Boolean
  js-tco-has-open-catch-all (branches) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if js-guard-trivial (b.guard) & js-tco-pat-catch-all (b.pattern) then True
      else js-tco-has-open-catch-all branches (i + 1)

  js-tco-pat-catch-all : IRPat -> Boolean
  js-tco-pat-catch-all (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> True
    is IrWildPat (sp) -> True
    is IrVecPat (pats) (ty) (sp) -> True
    is otherwise -> False

  js-emit-tco-match-branch : IRBranch , Text , List IRParam , JsCtx , Integer , Boolean , Integer -> Text
  js-emit-tco-match-branch (b) (func-name) (params) (ctx) (idx) (is-first) (depth) =
   let s-var = js-tco-scrut-var depth
   in when b.pattern
    is IrWildPat (sp) ->
     if js-guard-trivial (b.guard) then "        {\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
     else "        " & (if is-first then "if" else "else if") & " (" & js-emit-expr (b.guard) ctx & ") {\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
    is IrVecPat (pats) (ty) (sp) ->
     if js-guard-trivial (b.guard) then "        {\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
     else "        " & (if is-first then "if" else "else if") & " (" & js-emit-expr (b.guard) ctx & ") {\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
    is IrVarPat (name) (ty) (sp) ->
     if js-guard-trivial (b.guard) then "        {\n            const " & js-sanitize name & " = " & s-var & ";\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
     else "        " & (if is-first then "if" else "else if") & " (((" & js-sanitize name & ") => " & js-emit-expr (b.guard) ctx & ")(" & s-var & ")) {\n            const " & js-sanitize name & " = " & s-var & ";\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
    is IrCtorPat (name) (subs) (ty) (sp) ->
     if is-mktup-name name then "        {\n            const [" & js-emit-tuple-pat-names subs 0 & "] = " & s-var & ";\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
     else let keyword = if is-first then "if" else "else if"
     in let g = if js-guard-trivial (b.guard) then ""
        else " && (() => {\n" & js-emit-tco-ctor-bindings subs s-var 0 & "            return " & js-emit-expr (b.guard) ctx & ";\n        })()"
     in "        " & keyword & " (" & s-var & ".tag === \"" & name & "\"" & g & ") {\n" & js-emit-tco-ctor-bindings subs s-var 0 & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"
    is IrLitPat (text) (ty) (sp) ->
     let keyword = if is-first then "if" else "else if"
     in let g = if js-guard-trivial (b.guard) then "" else " && (" & js-emit-expr (b.guard) ctx & ")"
     in "        " & keyword & " (" & s-var & " === " & js-lit-pat-text text ty & g & ") {\n" & js-emit-tco-body (b.body) func-name params ctx (depth + 1) & "        }\n"

  js-emit-tco-ctor-bindings : List IRPat , Text , Integer -> Text
  js-emit-tco-ctor-bindings (subs) (match-var) (i) =
   if i == list-length subs then ""
   else let sub = list-at subs i
   in js-emit-tco-ctor-binding sub match-var i & js-emit-tco-ctor-bindings subs match-var (i + 1)

  js-emit-tco-ctor-binding : IRPat , Text , Integer -> Text
  js-emit-tco-ctor-binding (sub) (match-var) (i) =
   when sub
    is IrVarPat (name) (ty) (sp) -> "            const " & js-sanitize name & " = " & match-var & ".field" & integer-to-text i & ";\n"
    is otherwise -> ""

  js-emit-tco-jump : IRExpr , List IRParam , JsCtx -> Text
  js-emit-tco-jump (e) (params) (ctx) =
   let chain = collect-apply-chain e []
   in js-emit-tco-temps (chain.args) params ctx 0 & js-emit-tco-assigns params 0 & "        continue;\n"

  js-emit-tco-temps : List IRExpr , List IRParam , JsCtx , Integer -> Text
  js-emit-tco-temps (args) (params) (ctx) (i) =
   if i == list-length args then ""
   else "        const _tco_" & integer-to-text i & " = " & js-emit-expr (list-at args i) ctx & ";\n" & js-emit-tco-temps args params ctx (i + 1)

  js-emit-tco-assigns : List IRParam , Integer -> Text
  js-emit-tco-assigns (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in "        " & js-sanitize (p.name) & " = _tco_" & integer-to-text i & ";\n" & js-emit-tco-assigns params (i + 1)

  js-emit-tco-act : List IRActStmt , Text , List IRParam , JsCtx , Integer -> Text
  js-emit-tco-act (stmts) (func-name) (params) (ctx) (depth) =
   js-emit-tco-act-stmts stmts func-name params ctx depth 0 (list-length stmts)

  js-emit-tco-act-stmts : List IRActStmt , Text , List IRParam , JsCtx , Integer , Integer , Integer -> Text
  js-emit-tco-act-stmts (stmts) (func-name) (params) (ctx) (depth) (i) (len) =
   if i == len then "        return;\n"
   else let s = list-at stmts i
   in let is-last = i == len - 1
   in if is-last then when s
     is IrDoExec (e) (sp) -> js-emit-tco-body e func-name params ctx depth
     is IrDoBind (name) (ty) (val) (sp) -> "        const " & js-sanitize name & " = " & js-emit-expr val ctx & ";\n        return;\n"
    else js-emit-tco-act-stmt s ctx & js-emit-tco-act-stmts stmts func-name params ctx depth (i + 1) len

  js-emit-tco-act-stmt : IRActStmt , JsCtx -> Text
  js-emit-tco-act-stmt (s) (ctx) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> "        const " & js-sanitize name & " = " & js-emit-expr val ctx & ";\n"
    is IrDoExec (e) (sp) -> "        " & js-emit-expr e ctx & ";\n"

Section: Chapter Emission

  js-strip-fun-args : CodexType -> CodexType
  js-strip-fun-args (ty) =
   when ty
    is FunTy (p) (fnrow) (r) -> js-strip-fun-args r
    is ForAllTy (id) (body) -> js-strip-fun-args body
    is ForAllEff (id) (body) -> js-strip-fun-args body
    is LinearTy (body) -> js-strip-fun-args body
    is TypeApply (body) (tyarg) -> js-strip-fun-args body
    is otherwise -> ty

  js-opening-return-type : List IRDef -> CodexType
  js-opening-return-type (defs) = js-opening-return-loop defs 0

  js-opening-return-loop : List IRDef , Integer -> CodexType
  js-opening-return-loop (defs) (i) =
   if i >= list-length defs then NothingTy
   else let d = list-at defs i in
     if d.name == "opening" then js-strip-fun-args (d.type-val)
     else js-opening-return-loop defs (i + 1)

 Codex source recurses deeply and MUTUALLY -- the compiler's own lexer cycles
 scan-token -> skip-prose-line -> scan-token, which no self-tail-call pass can
 flatten -- and node's main-thread stack cannot take it. Measured: 100,000
 mutual frames raise RangeError on the main thread and complete on a worker
 given 512 MB, the same constant the csharp and zig plugs use. node's
 --stack-size is a process flag that emitted source cannot set, but
 worker_threads takes resourceLimits.stackSizeMb, which it can.

 The worker re-runs THIS file, so the module must be re-entrant: everything
 above is definitions, and only the entry call is guarded by isMainThread. An
 error inside the worker is re-raised on the main thread rather than swallowed,
 which a bare `new Worker` would do.

  js-worker-wrap : Text -> Text
  js-worker-wrap (call) =
   text-concat-list [
   "const { Worker: _CxWorker, isMainThread: _cxIsMain } = require(\"worker_threads\");\n",
   "if (_cxIsMain) {\n",
   "  const _cxW = new _CxWorker(__filename, { resourceLimits: { stackSizeMb: 512 } });\n",
   "  _cxW.on(\"error\", (e) => { process.exitCode = 1; throw e; });\n",
   "  _cxW.on(\"exit\", (c) => { if (c !== 0) process.exitCode = c; });\n",
   "} else {\n",
   "  ", call,
   "}\n"]

  js-emit-entry : CodexType -> Text
  js-emit-entry (ret-ty) = js-worker-wrap (js-entry-call ret-ty)

  js-entry-call : CodexType -> Text
  js-entry-call (ret-ty) = when ret-ty
    is EffectfulTy (effs) (sc) (inner) -> js-sanitize "opening" & "();\n"
    is NothingTy -> js-sanitize "opening" & "();\n"
    is ProofTy -> js-sanitize "opening" & "();\n"
    is PropEqTy (pl) (pr) -> js-sanitize "opening" & "();\n"
    is VoidTy -> js-sanitize "opening" & "();\n"
    is UnitTy (n) (inner) -> js-sanitize "opening" & "();\n"
    is otherwise -> "console.log(" & js-sanitize "opening" & "());\n"

  js-emit-defs-loop : List IRDef , Integer , Integer , JsCtx -> Text
  js-emit-defs-loop (defs) (i) (len) (ctx) =
   if i == len then ""
   else js-emit-def (list-at defs i) ctx & "\n" & js-emit-defs-loop defs (i + 1) len ctx

  emit-javascript-chapter : IRChapter , List ATypeDef -> Text
  emit-javascript-chapter (m) (type-defs) =
   let ctx = JsCtx { arities = build-arity-map (m.defs) 0 [], type-defs = type-defs }
   in let header = "\"use strict\";\nlet _js_state_value = 0n;\nfunction _cx_text_replace(s, a, b) { return a.length === 0 ? s : s.split(a).join(b); }\nfunction _cx_text_split(s, sep) { return sep.length === 0 ? [s] : s.split(sep); }\nfunction _cx_text_to_integer(s) { let t = String(s); let i = 0; let neg = false; if (t.charAt(0) === '-') { neg = true; i = 1; } let v = 0n; while (i < t.length && t.charAt(i) >= '0' && t.charAt(i) <= '9') { v = v * 10n + BigInt(t.charCodeAt(i) - 48); i = i + 1; } return neg ? -v : v; }\n\n"
   in let types = js-emit-type-defs type-defs 0
   in let defs = js-emit-defs-loop (m.defs) 0 (list-length (m.defs)) ctx
   in let entry = js-emit-entry (js-opening-return-type (m.defs))
   in header & types & defs & entry

  is-mktup-name : Text -> Boolean
  is-mktup-name (n) =
   n == "MkTup2" | n == "MkTup3" | n == "MkTup4" | n == "MkTup5"

  is-tup-type : Text -> Boolean
  is-tup-type (n) =
   n == "Tup2" | n == "Tup3" | n == "Tup4" | n == "Tup5"

  js-emit-tuple-pat-names : List IRPat, Integer -> Text
  js-emit-tuple-pat-names (subs) (i) =
   if i >= list-length subs then ""
   else let sep = if i > 0 then ", " else ""
   in when (list-at subs i)
    is IrVarPat (name) (ty) (sp) -> sep & js-sanitize name & js-emit-tuple-pat-names subs (i + 1)
    is IrWildPat (sp) -> sep & "_" & js-emit-tuple-pat-names subs (i + 1)
    is IrVecPat (pats) (ty) (sp) -> sep & "_" & js-emit-tuple-pat-names subs (i + 1)
    is otherwise -> sep & "_" & js-emit-tuple-pat-names subs (i + 1)

