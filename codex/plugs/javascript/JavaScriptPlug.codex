 Entry point for the JavaScript emit-plug.

Section: Body

  opening : [Console, FileSystem] Nothing = act
   source <- read-file ""
   let parsed = parse-ir-chapter source
   in let js-text = emit-javascript-chapter (parsed.chapter) (parsed.type-defs)
   in print-line js-text
  end

