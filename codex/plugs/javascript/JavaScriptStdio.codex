Chapter: JavaScriptStdio

Section: Body

  js-stream-defs : List IRDef, Integer, Integer, JsCtx -> [Console] Nothing
  js-stream-defs (defs) (i) (len) (ctx) =
   if i >= len then print-uni ""
   else let h = __heap-save
   in let s = js-emit-def (list-at defs i) ctx
   in act
    print-uni s
    print-uni "\n"
    let r = __heap-restore h
    in js-stream-defs defs (i + 1) len ctx
   end

  plug-emit-ir-stream : Text -> [Console] Nothing
  plug-emit-ir-stream (ir-text) =
   let parsed = parse-ir-chapter ir-text
   in let m = parsed.chapter
   in let ctx = JsCtx { arities = build-arity-map (m.defs) 0 [], type-defs = parsed.type-defs }
   in act
    print-uni js-emit-header
    print-uni (js-emit-type-defs (parsed.type-defs) 0)
    js-stream-defs (m.defs) 0 (list-length (m.defs)) ctx
    print-line-uni (js-emit-entry (js-opening-return-type (m.defs)))
   end