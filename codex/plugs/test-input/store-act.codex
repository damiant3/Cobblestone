Chapter: StoreAct

  mutable Cell = record {
    ca : Integer,
    cb : Integer
  }

  bump : Integer -> Integer
  bump (n) = act
    let c = Cell { ca = 0, cb = 0 }
    in act
      c.ca = n
      c.cb = c.ca + 1
      c.cb
    end
  end

  opening : [Console] Nothing = act
   print-line-uni ("bump: " & show (bump 41))
  end