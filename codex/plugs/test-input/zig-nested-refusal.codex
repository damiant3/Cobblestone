Chapter: ZigNestedRefusal

Section: Functions
  value : Integer = 11

  refuse-live : Integer, Integer -> [Device.Port] Integer
  refuse-live (n) (spare) = act
   byte <- port-in-byte 1
   n + byte
  end

  refuse-shadow : Integer -> [Device.Port] Integer
  refuse-shadow (value) = act
   byte <- port-in-byte 1
   value + byte
  end

  opening : [Console, Device.Port] Nothing = act
   a <- refuse-live 7 9
   b <- refuse-shadow value
   print-line-uni (show (a + b))
  end
