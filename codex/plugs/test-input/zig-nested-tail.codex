Chapter: ZigNestedTail
  cites Foreword chapter Console

Section: Types
  Item = | Empty | Number (Integer)
  Box = | Boxed (Item)

Section: Functions
  loop : Box, Integer, Integer -> Integer
  loop (box) (n) (sum) =
   if n <= 0 then sum
   else when box
    is Boxed (Number (value)) -> loop box (n - 1) (sum + value)
    is otherwise -> loop box (n - 1) (sum + 1)

  opening : [Console] Nothing = act
   print-line-uni (show (loop (Boxed (Number 3)) 100000 0))
   print-line-uni (show (loop (Boxed Empty) 100000 0))
  end
