Chapter: MatchNestedPattern

Section: Types

  Res (a) (e) =
   | Ok (a)
   | Err (e)

  Pair =
   | Two (Integer) (Integer)
   | One (Integer)

  Logic =
   | LTrue
   | LFalse
   | And (Logic) (Logic)
   | Or (Logic) (Logic)
   | Not (Logic)

  Branch =
   | Leaf (Integer)
   | Join (Branch) (Branch)
   | Empty

Section: Functions

  describe : Res (Res Integer Text) Integer -> Integer
  describe (v) =
   when v
    is Ok (Ok (n)) -> n
    is Ok (Err (t)) -> 0 - text-length t
    is Err (code) -> code * 10

  deep : Res (Res (Res Integer Integer) Integer) Integer -> Integer
  deep (v) =
   when v
    is Ok (Ok (Ok (n))) -> n
    is Ok (Ok (Err (m))) -> m * 2
    is Ok (Err (k)) -> k * 3
    is Err (j) -> j * 4

  pairs : Res Pair Integer -> Integer
  pairs (v) =
   when v
    is Ok (Two (a) (b)) -> a * 100 + b
    is Ok (One (a)) -> a
    is Err (e) -> 0 - e

  lit : Res Integer Integer -> Text
  lit (v) =
   when v
    is Ok (0) -> "zero"
    is Ok (n) -> "some " & show n
    is Err (e) -> "err"

  greet : Text -> Text
  greet (t) =
   when t
    is "hi" -> "greeting"
    is otherwise -> "word " & t

  word : Res Text Integer -> Text
  word (v) =
   when v
    is Ok ("hi") -> "greeting"
    is Ok (t) -> "word " & t
    is Err (e) -> "err"

  shape : Logic -> Text
  shape (v) =
   when v
    is And (Or (LTrue) (LFalse)) (Not (LFalse)) -> "ok"
    is And (a) (Not (LTrue)) -> "not-true"
    is otherwise -> "bad"

  siblings : Branch -> Integer
  siblings (v) =
   when v
    is Join (Leaf (a)) (Leaf (0)) -> a * 1000
    is Join (Leaf (a)) (Leaf (b)) -> a * 100 + b
    is otherwise -> 0 - 1

  guarded : Res (Res Integer Text) Integer -> Integer
  guarded (v) =
   when v
    is Ok (Ok (n)) when 100 / n > 0 -> n
    is Ok (Ok (n)) -> n * 2
    is Ok (Err (t)) -> 0 - text-length t
    is Err (code) -> code * 10

  nontail : Res (Res Integer Text) Integer -> Integer
  nontail (v) =
   100 + (when v
    is Ok (Ok (n)) -> n
    is Ok (Err (t)) -> 0 - text-length t
    is Err (code) -> code)

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni (show (describe (Ok (Ok 7))))
   print-line-uni (show (describe (Ok (Err "xyz"))))
   print-line-uni (show (describe (Err 4)))
   print-line-uni (show (deep (Ok (Ok (Ok 1)))))
   print-line-uni (show (deep (Ok (Ok (Err 2)))))
   print-line-uni (show (deep (Ok (Err 3))))
   print-line-uni (show (deep (Err 4)))
   print-line-uni (show (pairs (Ok (Two 3 4))))
   print-line-uni (show (pairs (Ok (One 9))))
   print-line-uni (show (pairs (Err 5)))
   print-line-uni (lit (Ok 0))
   print-line-uni (lit (Ok 3))
   print-line-uni (lit (Err 1))
   print-line-uni (greet "hi")
   print-line-uni (greet "yo")
   print-line-uni (word (Ok "hi"))
   print-line-uni (word (Ok "yo"))
   print-line-uni (shape (And (Or LTrue LFalse) (Not LFalse)))
   print-line-uni (shape (And (Or LTrue LTrue) (Not LFalse)))
   print-line-uni (shape (And LTrue (Not LTrue)))
   print-line-uni (shape (And (Or LTrue LFalse) (Not LTrue)))
   print-line-uni (shape LTrue)
   print-line-uni (word (Err 3))
   print-line-uni (show (siblings (Join (Leaf 3) (Leaf 4))))
   print-line-uni (show (siblings (Join (Leaf 5) (Leaf 0))))
   print-line-uni (show (siblings (Join (Leaf 3) Empty)))
   print-line-uni (show (guarded (Ok (Err "abc"))))
   print-line-uni (show (guarded (Ok (Ok 7))))
   print-line-uni (show (guarded (Ok (Ok (0 - 7)))))
   print-line-uni (show (nontail (Ok (Ok 7))))
   print-line-uni (show (nontail (Ok (Err "abc"))))
  end
