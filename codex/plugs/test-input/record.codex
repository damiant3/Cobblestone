Chapter: RecordSmoke

  Point = record {
    px : Integer,
    py : Integer,
    label : Text
  }

  make-point : Integer, Integer -> Point
  make-point (x) (y) = Point { px = x, py = y, label = "p" }

  point-sum : Point -> Integer
  point-sum (p) = p.px + p.py

  opening : [Console] Nothing = act
   let p = make-point 3 4
   in act
    print-line-uni (show (point-sum p))
    print-line-uni (p.label)
    print-line-uni (show (list-length [p, make-point 1 2]))
   end
  end
