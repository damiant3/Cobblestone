Chapter: Lambda

 Tests higher-order functions, closures, partial application.

  apply-fn : (Integer -> Integer), Integer -> Integer
  apply-fn (f) (x) = f x

  double : Integer -> Integer
  double (x) = x * 2

  make-adder : Integer -> (Integer -> Integer)
  make-adder (n) = \x -> x + n

  lambda-map : (Integer -> Integer), List Integer, Integer, List Integer -> List Integer
  lambda-map (f) (xs) (i) (acc) =
   if i == list-length xs then acc
   else lambda-map f xs (i + 1) (list-push acc (f (list-at xs i)))

  opening : [Console] Nothing = act
   print-line-uni ("apply: " & show (apply-fn double 21))
   print-line-uni ("adder: " & show ((make-adder 10) 32))
   let mapped = lambda-map double [1, 2, 3] 0 []
   in print-line-uni ("map len: " & show (list-length mapped))
   print-line-uni ("lambda: " & show ((\x -> x + 100) 5))
  end
