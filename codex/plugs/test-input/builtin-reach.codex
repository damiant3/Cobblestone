Chapter: BuiltinReach

 Reachability probe for the transpiler plugs' builtin lookup. Like
 `cce-bands`, this chapter deliberately CITES NOTHING: a chapter that
 cites a foreword chapter resolves that chapter's definition and is
 transpiled as ordinary user code, which tests nothing about an
 emitter's builtin table.

 Several plugs looked a builtin up with a BINARY search over a
 hand-written list. A binary search requires the list to be ordered by
 the comparison it searches with, and those two disagreed: the lists
 are written alphabetically while `text-compare` orders by CCE code
 point, and CCE numbers letters by frequency. Names past the first
 inversion were unreachable, and an unreachable builtin does not fail
 loudly -- it falls through to the ordinary apply path and emits a call
 to a function the target language has never heard of.

 So this file's value is one line per builtin in the emitted text. A
 name the plug recognises appears in that language's spelling; a name
 it missed appears as a bare call to the Codex name. Diffing the
 emitted output across a change to the lookup is what turns "how many
 builtins are reachable" into a measurement rather than a simulation.

 The names are spread deliberately across the alphabet, because the
 defect makes a CONTIGUOUS tail unreachable rather than a scattered
 few. File and process builtins (`open-file`, `read-text`,
 `write-file`, `file-exists`, `process-exit`, `fork`, `await`) are NOT
 covered here: they carry effects this chapter does not take, and the
 lookup they go through is the same one.

Section: Arithmetic and bits

  br-abs : Integer -> Integer
  br-abs (n) = abs n

  br-min-max : Integer, Integer -> Integer
  br-min-max (a) (b) = min a b + max a b

  br-negate : Integer -> Integer
  br-negate (n) = negate n

  br-int-mod : Integer, Integer -> Integer
  br-int-mod (a) (b) = int-mod a b

  br-bit-and : Integer, Integer -> Integer
  br-bit-and (a) (b) = bit-and a b

  br-bit-or : Integer, Integer -> Integer
  br-bit-or (a) (b) = bit-or a b

  br-bit-xor : Integer, Integer -> Integer
  br-bit-xor (a) (b) = bit-xor a b

  br-bit-not : Integer -> Integer
  br-bit-not (n) = bit-not n

  br-bit-shl : Integer, Integer -> Integer
  br-bit-shl (a) (b) = bit-shl a b

  br-bit-shr : Integer, Integer -> Integer
  br-bit-shr (a) (b) = bit-shr a b

Section: Characters

  br-char-at : Text, Integer -> Text
  br-char-at (s) (i) = char-to-text (char-at s i)

  br-char-code : Text -> Integer
  br-char-code (s) = char-code (char-at s 0)

  br-char-code-at : Text, Integer -> Integer
  br-char-code-at (s) (i) = char-code-at s i

  br-code-to-char : Integer -> Text
  br-code-to-char (n) = char-to-text (code-to-char n)

  br-is-digit : Integer -> Text
  br-is-digit (n) = if is-digit (code-to-char n) then "T" else "F"

  br-is-letter : Integer -> Text
  br-is-letter (n) = if is-letter (code-to-char n) then "T" else "F"

  br-is-whitespace : Integer -> Text
  br-is-whitespace (n) = if is-whitespace (code-to-char n) then "T" else "F"

Section: Text

  br-text-length : Text -> Integer
  br-text-length (s) = text-length s

  br-substring : Text -> Text
  br-substring (s) = substring s 0 2

  br-text-compare : Text, Text -> Integer
  br-text-compare (a) (b) = text-compare a b

  br-text-contains : Text, Text -> Text
  br-text-contains (a) (b) = if text-contains a b then "T" else "F"

  br-text-starts-with : Text, Text -> Text
  br-text-starts-with (a) (b) = if text-starts-with a b then "T" else "F"

  br-text-replace : Text, Text, Text -> Text
  br-text-replace (s) (a) (b) = text-replace s a b

  br-text-split : Text, Text -> Integer
  br-text-split (s) (sep) = list-length (text-split s sep)

  br-text-concat-list : List Text -> Text
  br-text-concat-list (xs) = text-concat-list xs

  br-text-to-integer : Text -> Integer
  br-text-to-integer (s) = text-to-integer s

  br-integer-to-text : Integer -> Text
  br-integer-to-text (n) = integer-to-text n

  br-show : Integer -> Text
  br-show (n) = show n

Section: Lists

  br-list-length : List Integer -> Integer
  br-list-length (xs) = list-length xs

  br-list-at : List Integer, Integer -> Integer
  br-list-at (xs) (i) = list-at xs i

  br-list-snoc : List Integer, Integer -> Integer
  br-list-snoc (xs) (v) = list-length (list-snoc xs v)

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("abs=" & show (br-abs (0 - 7)))
   print-line-uni ("minmax=" & show (br-min-max 3 9))
   print-line-uni ("negate=" & show (br-negate 5))
   print-line-uni ("intmod=" & show (br-int-mod 7 3))
   print-line-uni ("bitand=" & show (br-bit-and 12 10))
   print-line-uni ("bitor=" & show (br-bit-or 12 10))
   print-line-uni ("bitxor=" & show (br-bit-xor 12 10))
   print-line-uni ("bitnot=" & show (br-bit-not 12))
   print-line-uni ("bitshl=" & show (br-bit-shl 1 4))
   print-line-uni ("bitshr=" & show (br-bit-shr 16 2))
   print-line-uni ("charat=" & br-char-at "abc" 1)
   print-line-uni ("charcode=" & show (br-char-code "abc"))
   print-line-uni ("charcodeat=" & show (br-char-code-at "abc" 1))
   print-line-uni ("codetochar=" & br-code-to-char 15)
   print-line-uni ("isdigit=" & br-is-digit 3)
   print-line-uni ("isletter=" & br-is-letter 15)
   print-line-uni ("iswhitespace=" & br-is-whitespace 1)
   print-line-uni ("textlength=" & show (br-text-length "abcd"))
   print-line-uni ("substring=" & br-substring "abcd")
   print-line-uni ("textcompare=" & show (br-text-compare "a" "b"))
   print-line-uni ("textcontains=" & br-text-contains "abcd" "bc")
   print-line-uni ("textstartswith=" & br-text-starts-with "abcd" "ab")
   print-line-uni ("textreplace=" & br-text-replace "abcd" "bc" "X")
   print-line-uni ("textsplit=" & show (br-text-split "a b c" " "))
   print-line-uni ("textconcatlist=" & br-text-concat-list ["a", "b"])
   print-line-uni ("texttointeger=" & show (br-text-to-integer "42"))
   print-line-uni ("integertotext=" & br-integer-to-text 42)
   print-line-uni ("show=" & br-show 42)
   print-line-uni ("listlength=" & show (br-list-length [1, 2, 3]))
   print-line-uni ("listat=" & show (br-list-at [1, 2, 3] 1))
   print-line-uni ("listsnoc=" & show (br-list-snoc [1, 2] 3))
  end

