Chapter: Partial

  add3 : Integer, Integer, Integer -> Integer
  add3 (a) (b) (c) = a + b + c

  opening : [Console] Nothing = act
   let g = add3 1 2
   in print-line-uni ("partial: " & show (g 39))
   let h = add3 10
   in print-line-uni ("partial2: " & show ((h 20) 12))
   print-line-uni ("full: " & show (add3 1 2 3))
  end