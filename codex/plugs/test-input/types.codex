Chapter: Types

Section: Records

  Point = record {
   x : Integer,
   y : Integer
  }

  point-sum : Point -> Integer
  point-sum (p) = p.x + p.y

Section: Variants

  Shape =
   | Circle (Integer)
   | Rect (Integer) (Integer)

  area : Shape -> Integer
  area (s) = when s
   is Circle (r) -> r * r * 3
   is Rect (w) (h) -> w * h

Section: Lists

  sum-list : List Integer -> Integer
  sum-list (xs) =
   if list-length xs == 0 then 0
   else list-at xs 0 + sum-list (list-push [] 0)

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("point: " & show (point-sum (Point { x = 3, y = 4 })))
   print-line-uni ("circle: " & show (area (Circle 5)))
   print-line-uni ("rect: " & show (area (Rect 3 4)))
   print-line-uni ("list: " & show (list-length [1, 2, 3]))
   print-line-uni ("if: " & show (if 1 == 1 then 42 else 0))
   print-line-uni ("let: " & show (let x = 10 in x + 5))
  end
