Chapter: CrossArchTest

Section: Helpers

  greeting : Text -> Text
  greeting (name) = "Hello, " & name & "!"

  factorial : Integer -> Integer
  factorial (n) = if n <= 1 then 1 else n * factorial (n - 1)

  fizzbuzz : Integer -> Text
  fizzbuzz (n) =
   if int-mod n 15 == 0 then "FizzBuzz"
   else if int-mod n 3 == 0 then "Fizz"
   else if int-mod n 5 == 0 then "Buzz"
   else show n

  count-down : Integer -> Text
  count-down (n) =
   if n <= 0 then "done"
   else show n & " " & count-down (n - 1)

Section: Body

  opening : [Console] Nothing = act
   print-line-uni (greeting "World")
   print-line-uni (greeting "Codex")
   print-line-uni ("2+3=" & show (2 + 3))
   print-line-uni ("10*7=" & show (10 * 7))
   print-line-uni ("fact5=" & show (factorial 5))
   print-line-uni (fizzbuzz 15)
   print-line-uni (fizzbuzz 9)
   print-line-uni (fizzbuzz 10)
   print-line-uni (fizzbuzz 7)
   print-line-uni (count-down 3)
  end

