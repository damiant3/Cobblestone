Chapter: ZigRefusalDead
  grounds Device.Port
Section: Body
  dead-direct : Integer -> Integer
  dead-direct (n) = port-in-byte n
  dead-sequence : Integer -> Integer
  dead-sequence (n) =
   let selected = port-out-byte 112 n
   in port-in-byte 113
  conditional : Integer -> Integer
  conditional (n) = if hosted-kind /= 0 then n else port-in-byte n
  conditional-sequence : Integer -> Integer
  conditional-sequence (n) =
   let xs = [n]
   in let changed = list-set-at xs 0 (n + 1)
   in if hosted-kind /= 0 then list-at xs 0 else dead-sequence n
  opening : [Console] Nothing = act
   print-line-uni (show (if hosted-kind /= 0 then 7 else dead-direct 113))
   print-line-uni (show (conditional 8))
   print-line-uni (show (conditional-sequence 9))
  end
