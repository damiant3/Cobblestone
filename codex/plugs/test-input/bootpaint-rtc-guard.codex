Chapter: BootPaintRtcGuard
  cites Codex chapter BootPaint
Section: Body
  opening : [Console] Nothing = act
   print-line-uni (show (bp-rtc-seconds 0))
   print-line-uni (bp-rtc-date-text 0)
   if hosted-kind /= 0 then print-line-uni "hosted" else act
    old-magic <- peek-qword bp-cell 0
    old-base <- peek-qword bp-cell 16
    bp-poke64 (bp-cell + 16) 1
    bp-poke64 bp-cell bp-magic
    print-line-uni (show (bp-armed 0))
    print-line-uni (show (bp-rtc-seconds 0))
    print-line-uni (bp-rtc-date-text 0)
    bp-poke64 (bp-cell + 16) old-base
    bp-poke64 bp-cell old-magic
    print-line-uni (show (bp-rtc-seconds 0))
    print-line-uni (bp-rtc-date-text 0)
   end
  end
