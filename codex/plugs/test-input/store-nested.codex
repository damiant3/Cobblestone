Chapter: StoreNested

  mutable Inner = record {
    ca : Integer
  }

  mutable Outer = record {
    inner : Inner,
    tag : Integer
  }

  poke : Integer -> Integer
  poke (n) =
    let o = Outer { inner = Inner { ca = 0 }, tag = 7 }
    in o.inner.ca = n
    in o.inner.ca + o.tag

  opening : [Console] Nothing = act
   print-line-uni ("poke: " & show (poke 35))
  end