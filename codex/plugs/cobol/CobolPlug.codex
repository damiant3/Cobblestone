 Entry point for the COBOL emit-plug.

Section: Body

  opening : [Console, FileSystem] Nothing = act
   source <- read-file ""
   let parsed = parse-ir-chapter source
   in let cobol-text = emit-cobol-chapter (parsed.chapter) (parsed.type-defs)
   in print-line-uni cobol-text
  end

