Chapter: COBOL Emitter

Section: Keywords and Sanitization

  cobol-sanitize : Text -> Text
  cobol-sanitize (name) = text-replace name "-" "_"

  cobol-upper : Text -> Text
  cobol-upper (s) = cobol-upper-loop s 0 (text-length s) []

  cobol-upper-loop : Text, Integer, Integer, List Text -> Text
  cobol-upper-loop (s) (i) (len) (acc) =
   if i >= len then text-concat-list acc
   else let c = char-code-at s i
   in let lower-e = char-code 'e'
   in let lower-z = char-code 'z'
   in let upper-e = char-code 'E'
   in if c >= lower-e then if c <= lower-z then cobol-upper-loop s (i + 1) len (list-snoc acc (char-to-text (code-to-char (c - lower-e + upper-e))))
                                            else cobol-upper-loop s (i + 1) len (list-snoc acc (char-to-text (code-to-char c)))
   else cobol-upper-loop s (i + 1) len (list-snoc acc (char-to-text (code-to-char c)))

  cobol-name : Text -> Text
  cobol-name (name) = cobol-upper (cobol-sanitize name)

 The IR spells a record field as `name/slot`, so a field name reaches the
 emitter as `a/0` and reads as a division. riscv resolves the slot and
 needs it; every source plug wants the name.

  cobol-slash-pos : Text, Integer, Integer -> Integer
  cobol-slash-pos (f) (i) (len) =
   if i >= len then (-1)
   else if char-to-text (char-at f i) == "/" then i
   else cobol-slash-pos f (i + 1) len

  cobol-field : Text -> Text
  cobol-field (f) =
   let slash = cobol-slash-pos f 0 (text-length f)
   in if slash >= 0 then cobol-name (substring f 0 slash)
      else cobol-name f

  cobol-escape-text : Text -> Text
  cobol-escape-text (s) = text-replace s "\"" "\"\""

Section: Arity Map

  ArityEntry = record {
   name : Text,
   arity : Integer between 0 and 255,
   generic-count : Integer between 0 and 255,
   param-names : List Text
  }

  bsearch-arity-pos : List ArityEntry, Text, Integer, Integer -> Integer
  bsearch-arity-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-arity-pos entries name lo mid
      else bsearch-arity-pos entries name (mid + 1) hi

  sorted-insert-arity : List ArityEntry, ArityEntry -> List ArityEntry
  sorted-insert-arity (xs) (e) =
   let len = list-length xs
   in let pos = bsearch-arity-pos xs (e.name) 0 len
   in list-insert-at xs pos e

  build-arity-map : List IRDef, Integer, List ArityEntry -> List ArityEntry
  build-arity-map (defs) (i) (acc) =
   if i == list-length defs then acc
   else let d = list-at defs i
   in build-arity-map defs (i + 1) (sorted-insert-arity acc (ArityEntry {
    name = d.name,
    arity = __narrow (list-length (d.params)),
    generic-count = 0,
    param-names = cobol-param-names (d.params) 0 []
   }))

  cobol-param-names : List IRParam, Integer, List Text -> List Text
  cobol-param-names (ps) (i) (acc) =
   if i >= list-length ps then acc
   else cobol-param-names ps (i + 1) (list-snoc acc (cobol-name ((list-at ps i).name)))

  lookup-param-names : List ArityEntry, Text -> List Text
  lookup-param-names (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then []
      else let e = list-at entries pos
      in if e.name == name then e.param-names else []

  lookup-arity : List ArityEntry, Text -> Integer
  lookup-arity (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-arity-pos entries name 0 len
   in if pos >= len then -1
      else let e = list-at entries pos
      in if e.name == name then e.arity else -1

Section: Apply Chain

  is-upper-letter : Integer -> Boolean
  is-upper-letter (code) =
   if code >= char-code 'E' then code <= char-code 'Z'
   else False

Section: PIC Clause and Type Helpers

  cobol-pic : CodexType -> Text
  cobol-pic (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "PIC S9(18)"
    is RealTy (w) (m) -> "PIC S9(18)"
    is TextTy -> "PIC X(256)"
    is BooleanTy -> "PIC 9(1)"
    is CharTy -> "PIC S9(18)"
    is VoidTy -> "PIC S9(18)"
    is NothingTy -> "PIC S9(18)"
    is ProofTy -> "PIC S9(18)"
    is PropEqTy (pl) (pr) -> "PIC S9(18)"
    is UnitTy (n) (inner) -> "PIC S9(18)"
    is ForAllTy (id) (body) -> cobol-pic body
    is ForAllEff (id) (body) -> cobol-pic body
    is LinearTy (body) -> cobol-pic body
    is TypeApply (body) (tyarg) -> cobol-pic body
    is EffectfulTy (effs) (sc) (ret) -> cobol-pic ret
    is otherwise -> "PIC S9(18)"

 A text is a group item, a length and a data item under one name. A group
 MOVE between two of them is an alphanumeric copy of identical layouts, so
 assignment stays one statement, and the live characters are `-D(1:-L)`.

 COBOL forbids a reference modification of length zero, so every read of the
 slice is guarded by its length rather than emitted bare, and a concatenation
 uses STRING WITH POINTER so an empty operand contributes nothing instead of
 raising.

  cobol-is-text-ty : CodexType -> Boolean
  cobol-is-text-ty (ty) =
   when cobol-strip-forall ty
    is TextTy -> True
    is EffectfulTy (effs) (sc) (ret) -> cobol-is-text-ty ret
    is otherwise -> False

  cobol-is-text-expr : IRExpr -> Boolean
  cobol-is-text-expr (e) = cobol-is-text-ty (ir-expr-type e)

  cobol-decl-text : Text -> Text
  cobol-decl-text (name) =
   "       01 " & name & ".\n" &
   "         05 " & name & "-L      PIC S9(18).\n" &
   "         05 " & name & "-D      PIC X(256)."

 A list is the same length-carrying group as text, with a TABLE in place of the
 character field. `OCCURS` is COBOL's only array and it is fixed at compile
 time, so the capacity is a constant and every write is bounded against it: a
 subscript past the OCCURS is undefined behaviour in COBOL, not a trap.

  cobol-list-cap : Integer = 256

  cobol-decl-list : Text -> Text
  cobol-decl-list (name) =
   "       01 " & name & ".\n" &
   "         05 " & name & "-L      PIC S9(18).\n" &
   "         05 " & name & "-D      PIC S9(18) OCCURS " & integer-to-text cobol-list-cap & " TIMES."

 A list of TEXT needs its own shape, because the element is itself a
 length-carrying pair rather than one numeric field. The table is nested: each
 occurrence has its own `-EL` and `-ED`, so an element is
 `<v>-ED(i)(1:<v>-EL(i))`. The capacity is smaller than the numeric list's
 because each slot costs 256 characters plus its length.

  cobol-text-list-cap : Integer = 64

  cobol-decl-list-text : Text -> Text
  cobol-decl-list-text (name) =
   "       01 " & name & ".\n" &
   "         05 " & name & "-L      PIC S9(18).\n" &
   "         05 " & name & "-E      OCCURS " & integer-to-text cobol-text-list-cap & " TIMES.\n" &
   "           10 " & name & "-EL      PIC S9(18).\n" &
   "           10 " & name & "-ED      PIC X(256)."

  cobol-list-elem-is-text : CodexType -> Boolean
  cobol-list-elem-is-text (ty) =
   when cobol-strip-forall ty
    is ListTy (elem) -> cobol-is-text-ty elem
    is LinkedListTy (elem) -> cobol-is-text-ty elem
    is EffectfulTy (effs) (sc) (ret) -> cobol-list-elem-is-text ret
    is otherwise -> False

  cobol-is-list-ty : CodexType -> Boolean
  cobol-is-list-ty (ty) =
   when cobol-strip-forall ty
    is ListTy (elem) -> True
    is LinkedListTy (elem) -> True
    is EffectfulTy (effs) (sc) (ret) -> cobol-is-list-ty ret
    is otherwise -> False

  cobol-is-list-expr : IRExpr -> Boolean
  cobol-is-list-expr (e) = cobol-is-list-ty (ir-expr-type e)

  cobol-decl-pic : Text, Text -> Text
  cobol-decl-pic (name) (pic) = "       01 " & name & "       " & pic & "."

  cobol-decl : List ATypeDef, Text, CodexType -> Text
  cobol-decl (tds) (name) (ty) =
   if cobol-is-text-ty ty then cobol-decl-text name
   else if cobol-is-list-ty ty then (if cobol-list-elem-is-text ty then cobol-decl-list-text name else cobol-decl-list name)
   else if list-length (cobol-ctors-of tds ty) > 0 then cobol-decl-sum name (cobol-max-ctor-fields (cobol-ctors-of tds ty) 0 0)
   else cobol-decl-pic name (cobol-pic ty)

 A group MOVE between two identically laid out group items is an alphanumeric
 copy, which is what lets a variant be passed and assigned in one statement,
 so every value of a type is sized to its widest constructor.

 The wire spells a variant type as its NAME alone -- `(sum "Shape" (args))`
 carries no constructor list -- so the layout and the tag have to be looked up
 in the chapter's own type declarations.

  cobol-sum-name : CodexType -> Text
  cobol-sum-name (ty) =
   when cobol-strip-forall ty
    is SumTy (n) (targs) (ctors) -> n.value
    is EffectfulTy (effs) (sc) (ret) -> cobol-sum-name ret
    is otherwise -> ""

  cobol-find-variant : List ATypeDef, Text, Integer -> List AVariantCtorDef
  cobol-find-variant (tds) (target) (i) =
   if i >= list-length tds then []
   else let td = list-at tds i
   in when td
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     if name.value == target then ctors else cobol-find-variant tds target (i + 1)
    is otherwise -> cobol-find-variant tds target (i + 1)

  cobol-ctors-of : List ATypeDef, CodexType -> List AVariantCtorDef
  cobol-ctors-of (tds) (ty) =
   let n = cobol-sum-name ty
   in if text-length n == 0 then [] else cobol-find-variant tds n 0

  cobol-ctor-index : List AVariantCtorDef, Text, Integer -> Integer
  cobol-ctor-index (ctors) (target) (i) =
   if i >= list-length ctors then -1
   else let c = list-at ctors i
   in if (c.name).value == target then i
      else cobol-ctor-index ctors target (i + 1)

  cobol-decl-sum : Text, Integer -> Text
  cobol-decl-sum (name) (count) =
   "       01 " & name & ".\n" &
   "         05 " & name & "-TAG    PIC 9(2)." &
   cobol-sum-field-lines name count 0

  cobol-sum-field-lines : Text, Integer, Integer -> Text
  cobol-sum-field-lines (name) (count) (i) =
   if i >= count then ""
   else "\n         05 " & name & "-F" & integer-to-text i & "     PIC S9(18)." & cobol-sum-field-lines name count (i + 1)

  cobol-slice : Text -> Text
  cobol-slice (v) = v & "-D(1:" & v & "-L)"

Section: Emission State

  CobolBind = record {
   cb-src : Text,
   cb-dst : Text
  }

  CobolState = record {
   var-counter : Integer,
   working-storage : List Text,
   current-func : Text,
   env : List CobolBind,
   tdefs : List ATypeDef
  }

  cobol-alloc-var : CobolState, Text -> CobolAllocResult
  cobol-alloc-var (st) (hint) =
   let next = st.var-counter + 1
   in let prefix = if text-length (st.current-func) > 0 then st.current-func else "WS"
   in let vname = prefix & "-" & hint & "-" & integer-to-text next
   in CobolAllocResult {
    name = vname,
    state = CobolState {
     var-counter = next,
     working-storage = st.working-storage,
     current-func = st.current-func,
     env = st.env,
     tdefs = st.tdefs
    }
   }

  CobolAllocResult = record {
   name : Text,
   state : CobolState
  }

  cobol-add-ws : CobolState, Text -> CobolState
  cobol-add-ws (st) (line) =
   CobolState {
    var-counter = st.var-counter,
    working-storage = list-snoc (st.working-storage) line,
    current-func = st.current-func,
    env = st.env,
    tdefs = st.tdefs
   }

  cobol-set-func : CobolState, Text -> CobolState
  cobol-set-func (st) (f) =
   CobolState {
    var-counter = st.var-counter,
    working-storage = st.working-storage,
    current-func = f,
    env = st.env,
    tdefs = st.tdefs
   }

  cobol-set-tdefs : CobolState, List ATypeDef -> CobolState
  cobol-set-tdefs (st) (tds) =
   CobolState {
    var-counter = st.var-counter,
    working-storage = st.working-storage,
    current-func = st.current-func,
    env = st.env,
    tdefs = tds
   }

  cobol-initial-state : CobolState
  cobol-initial-state = CobolState {
   var-counter = 0,
   working-storage = [],
   current-func = "",
   env = [],
   tdefs = []
  }

Section: The Name Environment

 A binding is looked up from the END so a later one shadows an earlier one,
 and a let restores the depth it found rather than the list it found: an
 in-place extension of the backing array makes the saved LIST unreliable
 where the saved LENGTH is not.

  cobol-set-env : CobolState, List CobolBind -> CobolState
  cobol-set-env (st) (e) =
   CobolState {
    var-counter = st.var-counter,
    working-storage = st.working-storage,
    current-func = st.current-func,
    env = e,
    tdefs = st.tdefs
   }

  cobol-env-bind : CobolState, Text, Text -> CobolState
  cobol-env-bind (st) (src) (dst) =
   cobol-set-env st (list-snoc (st.env) (CobolBind { cb-src = src, cb-dst = dst }))

  cobol-env-lookup : List CobolBind, Text, Integer -> Text
  cobol-env-lookup (env) (n) (i) =
   if i < 0 then ""
   else if (list-at env i).cb-src == n then (list-at env i).cb-dst
   else cobol-env-lookup env n (i - 1)

  cobol-env-find : CobolState, Text -> Text
  cobol-env-find (st) (n) =
   let depth = list-length (st.env)
   in cobol-env-lookup (st.env) n (depth - 1)

  cobol-env-take : List CobolBind, Integer, Integer, List CobolBind -> List CobolBind
  cobol-env-take (env) (n) (i) (acc) =
   if i >= n then acc
   else cobol-env-take env n (i + 1) (list-snoc acc (list-at env i))

  cobol-env-restore : CobolState, Integer -> CobolState
  cobol-env-restore (st) (depth) =
   cobol-set-env st (cobol-env-take (st.env) depth 0 [])

  cobol-bind-params : List IRParam, Text, CobolState, Integer -> CobolState
  cobol-bind-params (ps) (fname) (st) (i) =
   if i >= list-length ps then st
   else let p = list-at ps i
   in cobol-bind-params ps fname (cobol-env-bind st (p.name) ("WS-" & fname & "-" & cobol-name (p.name))) (i + 1)

Section: Type Definition Emission

  emit-cobol-type-defs : List ATypeDef, Integer -> Text
  emit-cobol-type-defs (tds) (i) =
   if i >= list-length tds then ""
   else emit-cobol-type-def (list-at tds i) & emit-cobol-type-defs tds (i + 1)

  emit-cobol-type-def : ATypeDef -> Text
  emit-cobol-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (recmut) (s) ->
     let n = cobol-name (name.value)
     in "       01 WS-" & n & ".\n" & emit-cobol-rec-fields n fields 0
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     emit-cobol-sum-type (name.value) ctors
    is AUnitTypeDef (name) (unitbase) (s) -> ""

  emit-cobol-rec-fields : Text, List ARecordFieldDef, Integer -> Text
  emit-cobol-rec-fields (parent) (fields) (i) =
   if i >= list-length fields then ""
   else let f = list-at fields i
   in let fn = cobol-name (f.name.value)
   in let full = "WS-" & parent & "-" & fn
   in let pic = emit-cobol-atype-pic (f.type-expr)
   in let decl = if pic == "PIC X(256)"
                 then "         05 " & full & ".\n" &
                      "           10 " & full & "-L      PIC S9(18).\n" &
                      "           10 " & full & "-D      PIC X(256).\n"
                 else "         05 " & full & " " & pic & ".\n"
   in decl & emit-cobol-rec-fields parent fields (i + 1)

  emit-cobol-atype-pic : ATypeExpr -> Text
  emit-cobol-atype-pic (te) =
   when te
    is ANamedType (name) (s) -> cobol-when-pic-name (name.value)
    is AFunType (p) (r) (s) -> "PIC S9(18)"
    is AAppType (base) (args) (s) -> emit-cobol-atype-pic base
    is AEffectType (effs) (scopes) (efftail) (r) (s) -> emit-cobol-atype-pic r
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> emit-cobol-atype-pic b
    is ALinearType (b) (s) -> emit-cobol-atype-pic b
    is AConstrainedType (ctcls) (ctparam) (b) (s) -> emit-cobol-atype-pic b
    is AForallType (fav) (favt) (b) (s) -> emit-cobol-atype-pic b
    is APropEqType (b) (peright) (s) -> emit-cobol-atype-pic b

  cobol-when-pic-name : Text -> Text
  cobol-when-pic-name (n) =
   if n == "Integer" then "PIC S9(18)"
   else if n == "Real" then "PIC S9(18)"
   else if n == "Text" then "PIC X(256)"
   else if n == "Boolean" then "PIC 9(1)"
   else "PIC S9(18)"

  emit-cobol-sum-type : Text, List AVariantCtorDef -> Text
  emit-cobol-sum-type (base-name) (ctors) =
   let n = cobol-name base-name
   in let max-fields = cobol-max-ctor-fields ctors 0 0
   in cobol-decl-sum ("WS-" & n) max-fields & "\n" &
      emit-cobol-sum-tags ctors 1

  cobol-max-ctor-fields : List AVariantCtorDef, Integer, Integer -> Integer
  cobol-max-ctor-fields (ctors) (i) (mx) =
   if i >= list-length ctors then mx
   else let c = list-at ctors i
   in let n = list-length (c.fields)
   in if n > mx then cobol-max-ctor-fields ctors (i + 1) n
      else cobol-max-ctor-fields ctors (i + 1) mx

  emit-cobol-sum-tags : List AVariantCtorDef, Integer -> Text
  emit-cobol-sum-tags (ctors) (tag-num) =
   if tag-num > list-length ctors then ""
   else let c = list-at ctors (tag-num - 1)
   in let cn = cobol-name (c.name.value)
   in "       01 TAG-" & cn & "      PIC 9(2) VALUE " & integer-to-text tag-num & ".\n" & emit-cobol-sum-tags ctors (tag-num + 1)

Section: Expression Emission

  CobolExprResult = record {
   var-name : Text,
   code : Text,
   state : CobolState
  }

  emit-cobol-expr-to-var : IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-expr-to-var (e) (arities) (st) =
   when e
    is IrIntLit (n) (sp) -> CobolExprResult { var-name = integer-to-text n, code = "", state = st }
    is IrBoolLit (b) (sp) -> CobolExprResult { var-name = if b then "1" else "0", code = "", state = st }
    is IrTextLit (s) (sp) -> emit-cobol-text-lit s st
    is IrNumLit (n) (sp) -> CobolExprResult { var-name = integer-to-text n, code = "", state = st }
    is IrCharLit (n) (sp) -> CobolExprResult { var-name = integer-to-text n, code = "", state = st }
    is IrName (n) (ty) (sp) -> emit-cobol-name-var n ty st
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-cobol-binary-var op l r arities st
    is IrNegate (operand) (nty) (sp) -> emit-cobol-negate-var operand arities st
    is IrIf (c) (t) (el) (ty) (sp) -> emit-cobol-if-var c t el arities st
    is IrLet (name) (ty) (val) (body) (sp) -> emit-cobol-let-var name ty val body arities st
    is IrApply (f) (a) (ty) (sp) -> emit-cobol-apply-var e arities st
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-cobol-match-var scrut branches ty arities st
    is IrRecord (rname) (fields) (ty) (sp) -> emit-cobol-record-var rname fields arities st
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-cobol-field-var rec field arities st
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> emit-cobol-field-var rec field arities st
    is IrAct (stmts) (ty) (sp) -> emit-cobol-act-expr stmts arities st
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-cobol-expr-to-var body arities st
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-cobol-expr-to-var body arities st
    is IrFork (body) (ty) (sp) -> emit-cobol-expr-to-var body arities st
    is IrAwait (task) (ty) (sp) -> emit-cobol-expr-to-var task arities st
    is IrLambda (params) (body) (ty) (sp) ->
     let alloc = cobol-alloc-var st "LAMBDA"
     in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
     in CobolExprResult {
      var-name = alloc.name,
      code = "           DISPLAY \"COBOL: lambda not supported\"\n" &
       "           MOVE 0 TO " & alloc.name & "\n",
      state = st2
     }
    is IrList (elems) (ty) (sp) -> emit-cobol-list-var elems arities st
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) -> CobolExprResult { var-name = "0", code = "           CONTINUE\n", state = st }
    is IrError (msg) (ty) (sp) -> CobolExprResult { var-name = "0", code = "", state = st }

  emit-cobol-text-lit : Text, CobolState -> CobolExprResult
  emit-cobol-text-lit (s) (st) =
   let alloc = cobol-alloc-var st "LIT"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-text (alloc.name))
   in let n = text-length s
   in let data = if n == 0 then "           MOVE SPACES TO " & alloc.name & "-D\n"
                 else "           MOVE \"" & cobol-escape-text s & "\" TO " & alloc.name & "-D\n"
   in CobolExprResult {
    var-name = alloc.name,
    code = "           MOVE " & integer-to-text n & " TO " & alloc.name & "-L\n" & data,
    state = st2
   }

  emit-cobol-name-var : Text, CodexType, CobolState -> CobolExprResult
  emit-cobol-name-var (n) (ty) (st) =
   if n == "True" then CobolExprResult { var-name = "1", code = "", state = st }
   else if n == "False" then CobolExprResult { var-name = "0", code = "", state = st }
   else if n == "Nothing" then CobolExprResult { var-name = "0", code = "", state = st }
   else let bound = cobol-env-find st n
   in if text-length bound > 0 then CobolExprResult { var-name = bound, code = "", state = st }
      else if cobol-ctor-index (cobol-ctors-of (st.tdefs) ty) n 0 >= 0 then emit-cobol-ctor-var n [] ty [] st
      else CobolExprResult { var-name = "WS-" & cobol-name n, code = "", state = st }

  emit-cobol-ctor-var : Text, List IRExpr, CodexType, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-ctor-var (cn) (args) (ty) (arities) (st) =
   let count = cobol-max-ctor-fields (cobol-ctors-of (st.tdefs) ty) 0 0
   in let alloc = cobol-alloc-var st (cobol-name cn)
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-sum (alloc.name) count)
   in let moves = emit-cobol-ctor-moves args (alloc.name) arities st2 0
   in CobolExprResult {
    var-name = alloc.name,
    code = moves.code & "           MOVE TAG-" & cobol-name cn & " TO " & alloc.name & "-TAG\n",
    state = moves.state
   }

  emit-cobol-ctor-moves : List IRExpr, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-ctor-moves (args) (dst) (arities) (st) (i) =
   if i >= list-length args then CobolMoveResult { code = "", state = st }
   else let a = emit-cobol-expr-to-var (list-at args i) arities st
   in let rest = emit-cobol-ctor-moves args dst arities (a.state) (i + 1)
   in CobolMoveResult {
    code = a.code & "           MOVE " & a.var-name & " TO " & dst & "-F" & integer-to-text i & "\n" & rest.code,
    state = rest.state
   }

  emit-cobol-negate-var : IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-negate-var (operand) (arities) (st) =
   let inner = emit-cobol-expr-to-var operand arities st
   in let alloc = cobol-alloc-var (inner.state) "NEG"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = inner.code & "           MULTIPLY " & inner.var-name & " BY -1 GIVING " & alloc.name & "\n",
    state = st2
   }

  emit-cobol-binary-var : IRBinaryOp, IRExpr, IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-binary-var (op) (l) (r) (arities) (st) =
   let left = emit-cobol-expr-to-var l arities st
   in let right = emit-cobol-expr-to-var r arities (left.state)
   in let alloc = cobol-alloc-var (right.state) (cobol-bin-hint op)
   in let decl = if cobol-bin-is-text op then cobol-decl-text (alloc.name)
                 else if cobol-bin-is-list op then cobol-decl-list (alloc.name)
                 else cobol-decl-pic (alloc.name) (cobol-bin-pic op)
   in let st2 = cobol-add-ws (alloc.state) decl
   in let stmt = emit-cobol-bin-stmt op (left.var-name) (right.var-name) (alloc.name) (cobol-is-text-expr l)
   in CobolExprResult {
    var-name = alloc.name,
    code = left.code & right.code & stmt,
    state = st2
   }

  cobol-bin-is-text : IRBinaryOp -> Boolean
  cobol-bin-is-text (op) =
   when op
    is IrAppendText -> True
    is otherwise -> False

  cobol-bin-is-list : IRBinaryOp -> Boolean
  cobol-bin-is-list (op) =
   when op
    is IrAppendList | IrConsList -> True
    is otherwise -> False

  cobol-bin-pic : IRBinaryOp -> Text
  cobol-bin-pic (op) =
   when op
    is IrAppendText -> "PIC X(256)"
    is IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> "PIC 9(1)"
    is IrApproxEq | IrApproxEqExact -> "PIC 9(1)"
    is IrAnd | IrOr -> "PIC 9(1)"
    is IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrRemInt | IrPowInt -> "PIC S9(18)"
    is IrAddNum | IrSubNum | IrMulNum | IrDivNum -> "PIC S9(18)"
    is IrAddVec | IrSubVec | IrMulVec | IrDivVec -> "PIC S9(18)"
    is IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox -> "PIC S9(18)"
    is IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping -> "PIC S9(18)"
    is IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating -> "PIC S9(18)"
    is IrAppendList | IrConsList -> "PIC S9(18)"

  cobol-bin-hint : IRBinaryOp -> Text
  cobol-bin-hint (op) =
   when op
    is IrAddInt | IrAddNum | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "SUM"
    is IrSubInt | IrSubNum | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "DIFF"
    is IrMulInt | IrMulNum | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "PROD"
    is IrDivInt | IrDivNum | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "QUOT"
    is IrRemInt -> "REM"
    is IrPowInt -> "POW"
    is IrEq | IrNotEq -> "EQ"
    is IrApproxEq -> "AEQ"
    is IrApproxEqExact -> "AEQX"
    is IrLt | IrGt | IrLtEq | IrGtEq | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> "CMP"
    is IrAnd -> "LAND"
    is IrOr -> "LOR"
    is IrAppendText -> "CONCAT"
    is IrAppendList -> "LCAT"
    is IrConsList -> "LCONS"

  emit-cobol-bin-stmt : IRBinaryOp, Text, Text, Text, Boolean -> Text
  emit-cobol-bin-stmt (op) (lv) (rv) (result) (ltext) =
   when op
    is IrAddInt | IrAddVec | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating -> "           ADD " & lv & " " & rv & " GIVING " & result & "\n"
    is IrSubInt | IrSubVec | IrSubRealApprox | IrSubRealTrapping | IrSubRealSaturating -> "           SUBTRACT " & rv & " FROM " & lv & " GIVING " & result & "\n"
    is IrMulInt | IrMulVec | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating -> "           MULTIPLY " & lv & " BY " & rv & " GIVING " & result & "\n"
    is IrDivInt | IrDivVec | IrDivRealApprox | IrDivRealTrapping | IrDivRealSaturating -> "           DIVIDE " & lv & " BY " & rv & " GIVING " & result & "\n"
    is IrRemInt -> "           DIVIDE " & lv & " BY " & rv & " GIVING TEMP-QUOT REMAINDER " & result & "\n"
    is IrPowInt -> "           COMPUTE " & result & " = " & lv & " ** " & rv & "\n"
    is IrAddNum -> "           ADD " & lv & " " & rv & " GIVING " & result & "\n"
    is IrSubNum -> "           SUBTRACT " & rv & " FROM " & lv & " GIVING " & result & "\n"
    is IrMulNum -> "           MULTIPLY " & lv & " BY " & rv & " GIVING " & result & "\n"
    is IrDivNum -> "           DIVIDE " & lv & " BY " & rv & " GIVING " & result & "\n"
    is IrEq -> if ltext then emit-cobol-text-eq-stmt lv rv result "1" "0"
               else emit-cobol-cmp-stmt lv "=" rv result
    is IrNotEq -> if ltext then emit-cobol-text-eq-stmt lv rv result "0" "1"
                  else emit-cobol-cmp-stmt lv "NOT =" rv result
    is IrLt | IrLtVec -> emit-cobol-cmp-stmt (cobol-cmp-operand lv ltext) "<" (cobol-cmp-operand rv ltext) result
    is IrGt | IrGtVec -> emit-cobol-cmp-stmt (cobol-cmp-operand lv ltext) ">" (cobol-cmp-operand rv ltext) result
    is IrLtEq | IrLtEqVec -> emit-cobol-cmp-stmt (cobol-cmp-operand lv ltext) "<=" (cobol-cmp-operand rv ltext) result
    is IrGtEq | IrGtEqVec -> emit-cobol-cmp-stmt (cobol-cmp-operand lv ltext) ">=" (cobol-cmp-operand rv ltext) result
    is IrApproxEq -> emit-cobol-cmp-stmt lv "=" rv result
    is IrApproxEqExact -> emit-cobol-cmp-stmt lv "=" rv result
    is IrAnd ->
     "           IF " & lv & " NOT = 0\n" &
     "             IF " & rv & " NOT = 0\n" &
     "               MOVE 1 TO " & result & "\n" &
     "             ELSE\n" &
     "               MOVE 0 TO " & result & "\n" &
     "             END-IF\n" &
     "           ELSE\n" &
     "             MOVE 0 TO " & result & "\n" &
     "           END-IF\n"
    is IrOr ->
     "           IF " & lv & " NOT = 0\n" &
     "             MOVE 1 TO " & result & "\n" &
     "           ELSE\n" &
     "             IF " & rv & " NOT = 0\n" &
     "               MOVE 1 TO " & result & "\n" &
     "             ELSE\n" &
     "               MOVE 0 TO " & result & "\n" &
     "             END-IF\n" &
     "           END-IF\n"
    is IrAppendText ->
     "           MOVE SPACES TO " & result & "-D\n" &
     "           MOVE 1 TO WS-STRPTR\n" &
     "           IF " & lv & "-L > 0\n" &
     "             STRING " & cobol-slice lv & " DELIMITED BY SIZE\n" &
     "                  INTO " & result & "-D WITH POINTER WS-STRPTR\n" &
     "           END-IF\n" &
     "           IF " & rv & "-L > 0\n" &
     "             STRING " & cobol-slice rv & " DELIMITED BY SIZE\n" &
     "                  INTO " & result & "-D WITH POINTER WS-STRPTR\n" &
     "           END-IF\n" &
     "           COMPUTE " & result & "-L = " & lv & "-L + " & rv & "-L\n"
    is IrAppendList ->
     "           MOVE 0 TO " & result & "-L\n" &
     "           PERFORM VARYING WS-LIDX FROM 1 BY 1 UNTIL WS-LIDX > " & lv & "-L\n" &
     "             IF " & result & "-L < " & integer-to-text cobol-list-cap & "\n" &
     "               ADD 1 TO " & result & "-L\n" &
     "               MOVE " & lv & "-D(WS-LIDX) TO " & result & "-D(" & result & "-L)\n" &
     "             END-IF\n" &
     "           END-PERFORM\n" &
     "           PERFORM VARYING WS-LIDX FROM 1 BY 1 UNTIL WS-LIDX > " & rv & "-L\n" &
     "             IF " & result & "-L < " & integer-to-text cobol-list-cap & "\n" &
     "               ADD 1 TO " & result & "-L\n" &
     "               MOVE " & rv & "-D(WS-LIDX) TO " & result & "-D(" & result & "-L)\n" &
     "             END-IF\n" &
     "           END-PERFORM\n"
    is IrConsList ->
     "           MOVE 1 TO " & result & "-L\n" &
     "           MOVE " & lv & " TO " & result & "-D(1)\n" &
     "           PERFORM VARYING WS-LIDX FROM 1 BY 1 UNTIL WS-LIDX > " & rv & "-L\n" &
     "             IF " & result & "-L < " & integer-to-text cobol-list-cap & "\n" &
     "               ADD 1 TO " & result & "-L\n" &
     "               MOVE " & rv & "-D(WS-LIDX) TO " & result & "-D(" & result & "-L)\n" &
     "             END-IF\n" &
     "           END-PERFORM\n"

  cobol-cmp-operand : Text, Boolean -> Text
  cobol-cmp-operand (v) (is-text) = if is-text then v & "-D" else v

 Two alphanumeric operands of unequal size compare as if the shorter were
 padded with spaces, so a text ending in a space would equal one that does
 not. The lengths are compared first and the characters only after.

  emit-cobol-text-eq-stmt : Text, Text, Text, Text, Text -> Text
  emit-cobol-text-eq-stmt (lv) (rv) (result) (on-eq) (on-ne) =
   "           IF " & lv & "-L NOT = " & rv & "-L\n" &
   "             MOVE " & on-ne & " TO " & result & "\n" &
   "           ELSE\n" &
   "             IF " & lv & "-L = 0\n" &
   "               MOVE " & on-eq & " TO " & result & "\n" &
   "             ELSE\n" &
   "               IF " & cobol-slice lv & " = " & cobol-slice rv & "\n" &
   "                 MOVE " & on-eq & " TO " & result & "\n" &
   "               ELSE\n" &
   "                 MOVE " & on-ne & " TO " & result & "\n" &
   "               END-IF\n" &
   "             END-IF\n" &
   "           END-IF\n"

  emit-cobol-cmp-stmt : Text, Text, Text, Text -> Text
  emit-cobol-cmp-stmt (lv) (cmp-op) (rv) (result) =
   "           IF " & lv & " " & cmp-op & " " & rv & "\n" &
   "             MOVE 1 TO " & result & "\n" &
   "           ELSE\n" &
   "             MOVE 0 TO " & result & "\n" &
   "           END-IF\n"

  emit-cobol-if-var : IRExpr, IRExpr, IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-if-var (c) (t) (el) (arities) (st) =
   let cond = emit-cobol-expr-to-var c arities st
   in let alloc = cobol-alloc-var (cond.state) "BRANCH"
   in let decl = if cobol-is-text-expr t then cobol-decl-text (alloc.name)
                 else cobol-decl-pic (alloc.name) "PIC S9(18)"
   in let st2 = cobol-add-ws (alloc.state) decl
   in let then-r = emit-cobol-expr-to-var t arities st2
   in let else-r = emit-cobol-expr-to-var el arities (then-r.state)
   in CobolExprResult {
    var-name = alloc.name,
    code = cond.code & "           IF " & cond.var-name & " NOT = 0\n" &
     then-r.code & "             MOVE " & then-r.var-name & " TO " & alloc.name & "\n" &
     "           ELSE\n" &
     else-r.code & "             MOVE " & else-r.var-name & " TO " & alloc.name & "\n" &
     "           END-IF\n",
    state = else-r.state
   }

  emit-cobol-let-var : Text, CodexType, IRExpr, IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-let-var (name) (ty) (val) (body) (arities) (st) =
   let val-r = emit-cobol-expr-to-var val arities st
   in let alloc = cobol-alloc-var (val-r.state) (cobol-name name)
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl (st.tdefs) (alloc.name) ty)
   in let depth = list-length (st2.env)
   in let body-r = emit-cobol-expr-to-var body arities (cobol-env-bind st2 name (alloc.name))
   in CobolExprResult {
    var-name = body-r.var-name,
    code = val-r.code & "           MOVE " & val-r.var-name & " TO " & alloc.name & "\n" & body-r.code,
    state = cobol-env-restore (body-r.state) depth
   }

  emit-cobol-apply-var : IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-apply-var (e) (arities) (st) =
   let chain = collect-apply-chain e []
   in when chain.root
    is IrName (n) (ty) (sp) -> emit-cobol-apply-named n (chain.args) (ir-expr-type e) arities st
    is otherwise -> let fallback = emit-cobol-expr-to-var (list-at (chain.args) 0) arities st
     in CobolExprResult { var-name = fallback.var-name, code = fallback.code, state = fallback.state }

  cobol-builtin-names : List Text
  cobol-builtin-names = ["abs", "bit-and", "bit-or", "bit-xor", "char-at",
   "int-mod", "integer-to-text", "is-digit", "is-letter", "max", "min",
   "negate", "print-line-uni", "process-exit", "read-text", "show",
   "substring", "text-length", "text-to-integer", "write-file",
   "text-starts-with", "text-contains", "text-replace", "text-split",
   "list-at", "list-length", "list-push", "list-snoc"]

  cobol-find-builtin : List Text, Text, Integer -> Integer
  cobol-find-builtin (names) (target) (i) =
   if i >= list-length names then -1
   else if list-at names i == target then i
   else cobol-find-builtin names target (i + 1)

  emit-cobol-apply-named : Text, List IRExpr, CodexType, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-apply-named (n) (args) (ty) (arities) (st) =
   let idx = cobol-find-builtin cobol-builtin-names n 0
   in if idx >= 0 then emit-cobol-builtin-by-idx idx n args arities st
      else if cobol-ctor-index (cobol-ctors-of (st.tdefs) ty) n 0 >= 0 then emit-cobol-ctor-var n args ty arities st
      else emit-cobol-call-def n args arities st

  emit-cobol-builtin-by-idx : Integer, Text, List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-by-idx (idx) (n) (args) (arities) (st) =
   if idx == 0 then emit-cobol-builtin-abs args arities st
   else if idx == 1 then emit-cobol-builtin-bit-stub "bit-and" args arities st
   else if idx == 2 then emit-cobol-builtin-bit-stub "bit-or" args arities st
   else if idx == 3 then emit-cobol-builtin-bit-stub "bit-xor" args arities st
   else if idx == 4 then emit-cobol-builtin-char-at args arities st
   else if idx == 5 then emit-cobol-builtin-int-mod args arities st
   else if idx == 6 then emit-cobol-builtin-show args arities st
   else if idx == 7 then emit-cobol-builtin-is-digit args arities st
   else if idx == 8 then emit-cobol-builtin-is-letter args arities st
   else if idx == 9 then emit-cobol-builtin-max args arities st
   else if idx == 10 then emit-cobol-builtin-min args arities st
   else if idx == 11 then emit-cobol-negate-var (list-at args 0) arities st
   else if idx == 12 then emit-cobol-display args arities st
   else if idx == 13 then emit-cobol-builtin-process-exit args arities st
   else if idx == 14 then emit-cobol-builtin-read-file args arities st
   else if idx == 15 then emit-cobol-builtin-show args arities st
   else if idx == 16 then emit-cobol-builtin-substring args arities st
   else if idx == 17 then emit-cobol-builtin-text-length args arities st
   else if idx == 18 then emit-cobol-builtin-text-to-integer args arities st
   else if idx == 19 then emit-cobol-builtin-write-file args arities st
   else if idx == 20 then emit-cobol-builtin-text-starts-with args arities st
   else if idx == 21 then emit-cobol-builtin-text-contains args arities st
   else if idx == 22 then emit-cobol-builtin-text-replace args arities st
   else if idx == 23 then emit-cobol-builtin-text-split args arities st
   else if idx == 24 then emit-cobol-builtin-list-at args arities st
   else if idx == 25 then emit-cobol-builtin-list-length args arities st
   else if idx == 26 then emit-cobol-builtin-list-append args arities st
   else if idx == 27 then emit-cobol-builtin-list-append args arities st
   else emit-cobol-builtin-bit-stub n args arities st

 `list-at` is one-based in COBOL and zero-based in Codex, which is the defect
 the pascal plug shipped for every list read it ever emitted, so the `+ 1` is
 here rather than left to a caller.

 An empty separator answers a one-element list holding the whole string, and a
 TRAILING separator leaves a final empty field, both of which Codex specifies
 and both of which are where a library `split` usually differs. The scan is
 explicit for that reason and because COBOL's `UNSTRING` cannot express either.

  emit-cobol-builtin-text-split : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-split (args) (arities) (st) =
   let s = emit-cobol-expr-to-var (list-at args 0) arities st
   in let sep = emit-cobol-expr-to-var (list-at args 1) arities (s.state)
   in let alloc = cobol-alloc-var (sep.state) "SPL"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-list-text (alloc.name))
   in let i = cobol-alloc-var st2 "SPI"
   in let st3 = cobol-add-ws (i.state) (cobol-decl-pic (i.name) "PIC S9(18)")
   in let start = cobol-alloc-var st3 "SPS"
   in let st4 = cobol-add-ws (start.state) (cobol-decl-pic (start.name) "PIC S9(18)")
   in let n = alloc.name
   in let sv = s.var-name
   in let pv = sep.var-name
   in CobolExprResult {
    var-name = n,
    code = s.code & sep.code &
     "           MOVE 0 TO " & n & "-L\n" &
     "           IF " & pv & "-L = 0\n" &
     "             MOVE 1 TO " & n & "-L\n" &
     "             MOVE " & sv & "-L TO " & n & "-EL(1)\n" &
     "             MOVE " & sv & "-D TO " & n & "-ED(1)\n" &
     "           ELSE\n" &
     "             MOVE 1 TO " & start.name & "\n" &
     "             MOVE 1 TO " & i.name & "\n" &
     "             PERFORM UNTIL " & i.name & " > " & sv & "-L - " & pv & "-L + 1\n" &
     "               IF " & sv & "-D(" & i.name & ":" & pv & "-L) = " & cobol-slice pv & "\n" &
     "                 ADD 1 TO " & n & "-L\n" &
     "                 IF " & n & "-L <= " & integer-to-text cobol-text-list-cap & "\n" &
     "                   MOVE " & i.name & " - " & start.name & " TO " & n & "-EL(" & n & "-L)\n" &
     "                   MOVE SPACES TO " & n & "-ED(" & n & "-L)\n" &
     "                   IF " & i.name & " > " & start.name & "\n" &
     "                     MOVE " & sv & "-D(" & start.name & ":" & i.name & " - " & start.name & ") TO " & n & "-ED(" & n & "-L)\n" &
     "                   END-IF\n" &
     "                 END-IF\n" &
     "                 COMPUTE " & i.name & " = " & i.name & " + " & pv & "-L\n" &
     "                 MOVE " & i.name & " TO " & start.name & "\n" &
     "               ELSE\n" &
     "                 ADD 1 TO " & i.name & "\n" &
     "               END-IF\n" &
     "             END-PERFORM\n" &
     "             ADD 1 TO " & n & "-L\n" &
     "             IF " & n & "-L <= " & integer-to-text cobol-text-list-cap & "\n" &
     "               MOVE " & sv & "-L - " & start.name & " + 1 TO " & n & "-EL(" & n & "-L)\n" &
     "               MOVE SPACES TO " & n & "-ED(" & n & "-L)\n" &
     "               IF " & sv & "-L >= " & start.name & "\n" &
     "                 MOVE " & sv & "-D(" & start.name & ":" & sv & "-L - " & start.name & " + 1) TO " & n & "-ED(" & n & "-L)\n" &
     "               END-IF\n" &
     "             END-IF\n" &
     "           END-IF\n",
    state = st4
   }

  emit-cobol-builtin-list-at : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-at (args) (arities) (st) =
   if cobol-list-elem-is-text (ir-expr-type (list-at args 0))
   then emit-cobol-builtin-list-at-text args arities st
   else emit-cobol-builtin-list-at-int args arities st

 Reading a TEXT element copies its length and characters into a text group of
 its own, so everything downstream sees the ordinary `-L` and `-D` pair rather
 than a subscripted one.

  emit-cobol-builtin-list-at-text : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-at-text (args) (arities) (st) =
   let xs = emit-cobol-expr-to-var (list-at args 0) arities st
   in let ix = emit-cobol-expr-to-var (list-at args 1) arities (xs.state)
   in let alloc = cobol-alloc-var (ix.state) "LATT"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-text (alloc.name))
   in let sub = cobol-alloc-var st2 "LIXT"
   in let st3 = cobol-add-ws (sub.state) (cobol-decl-pic (sub.name) "PIC S9(18)")
   in CobolExprResult {
    var-name = alloc.name,
    code = xs.code & ix.code &
     "           COMPUTE " & sub.name & " = " & ix.var-name & " + 1\n" &
     "           MOVE 0 TO " & alloc.name & "-L\n" &
     "           MOVE SPACES TO " & alloc.name & "-D\n" &
     "           IF " & sub.name & " >= 1 AND " & sub.name & " <= " & xs.var-name & "-L\n" &
     "             MOVE " & xs.var-name & "-EL(" & sub.name & ") TO " & alloc.name & "-L\n" &
     "             MOVE " & xs.var-name & "-ED(" & sub.name & ") TO " & alloc.name & "-D\n" &
     "           END-IF\n",
    state = st3
   }

  emit-cobol-builtin-list-at-int : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-at-int (args) (arities) (st) =
   let xs = emit-cobol-expr-to-var (list-at args 0) arities st
   in let ix = emit-cobol-expr-to-var (list-at args 1) arities (xs.state)
   in let alloc = cobol-alloc-var (ix.state) "LAT"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-pic (alloc.name) "PIC S9(18)")
   in let sub = cobol-alloc-var st2 "LIX"
   in let st3 = cobol-add-ws (sub.state) (cobol-decl-pic (sub.name) "PIC S9(18)")
   in CobolExprResult {
    var-name = alloc.name,
    code = xs.code & ix.code &
     "           COMPUTE " & sub.name & " = " & ix.var-name & " + 1\n" &
     "           IF " & sub.name & " < 1 OR " & sub.name & " > " & xs.var-name & "-L\n" &
     "             MOVE 0 TO " & alloc.name & "\n" &
     "           ELSE\n" &
     "             MOVE " & xs.var-name & "-D(" & sub.name & ") TO " & alloc.name & "\n" &
     "           END-IF\n",
    state = st3
   }

  emit-cobol-builtin-list-length : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-length (args) (arities) (st) =
   let xs = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (xs.state) "LLEN"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-pic (alloc.name) "PIC S9(18)")
   in CobolExprResult {
    var-name = alloc.name,
    code = xs.code & "           MOVE " & xs.var-name & "-L TO " & alloc.name & "\n",
    state = st2
   }

 `list-push` and `list-snoc` both COPY. `__list_snoc` on bare metal stores in
 place only when the backing array has spare capacity and otherwise copies, and
 an unconditional in-place append is the defect plugs-backlog 1.7 names: a copy
 is always correct, and a fixed OCCURS table has no capacity notion to exploit.

  emit-cobol-builtin-list-append : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-append (args) (arities) (st) =
   if cobol-list-elem-is-text (ir-expr-type (list-at args 0))
   then emit-cobol-builtin-bit-stub "append to a list of text" args arities st
   else emit-cobol-builtin-list-append-int args arities st

  emit-cobol-builtin-list-append-int : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-list-append-int (args) (arities) (st) =
   let xs = emit-cobol-expr-to-var (list-at args 0) arities st
   in let v = emit-cobol-expr-to-var (list-at args 1) arities (xs.state)
   in let alloc = cobol-alloc-var (v.state) "LAPP"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-list (alloc.name))
   in let ctr = cobol-alloc-var st2 "LCTR"
   in let st3 = cobol-add-ws (ctr.state) (cobol-decl-pic (ctr.name) "PIC S9(18)")
   in CobolExprResult {
    var-name = alloc.name,
    code = xs.code & v.code &
     "           MOVE " & xs.var-name & "-L TO " & alloc.name & "-L\n" &
     "           PERFORM VARYING " & ctr.name & " FROM 1 BY 1 UNTIL " & ctr.name & " > " & xs.var-name & "-L\n" &
     "             MOVE " & xs.var-name & "-D(" & ctr.name & ") TO " & alloc.name & "-D(" & ctr.name & ")\n" &
     "           END-PERFORM\n" &
     "           IF " & alloc.name & "-L < " & integer-to-text cobol-list-cap & "\n" &
     "             ADD 1 TO " & alloc.name & "-L\n" &
     "             MOVE " & v.var-name & " TO " & alloc.name & "-D(" & alloc.name & "-L)\n" &
     "           END-IF\n",
    state = st3
   }

  emit-cobol-display : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-display (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let stmt = if cobol-is-text-expr (list-at args 0)
                 then "           IF " & arg-r.var-name & "-L > 0\n" &
                      "             DISPLAY " & cobol-slice (arg-r.var-name) & "\n" &
                      "           ELSE\n" &
                      "             DISPLAY SPACE\n" &
                      "           END-IF\n"
                 else "           DISPLAY " & arg-r.var-name & "\n"
   in CobolExprResult {
    var-name = "0",
    code = arg-r.code & stmt,
    state = arg-r.state
   }

  emit-cobol-builtin-show : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-show (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in if cobol-is-text-expr (list-at args 0) then arg-r
   else let alloc = cobol-alloc-var (arg-r.state) "SHOW"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-text (alloc.name))
   in let ed = cobol-alloc-var st2 "SHOWE"
   in let st3 = cobol-add-ws (ed.state) (cobol-decl-pic (ed.name) "PIC -(18)9")
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code &
     "           MOVE " & arg-r.var-name & " TO " & ed.name & "\n" &
     "           MOVE FUNCTION TRIM(" & ed.name & ") TO " & alloc.name & "-D\n" &
     "           COMPUTE " & alloc.name & "-L = FUNCTION LENGTH(FUNCTION TRIM(" & ed.name & "))\n",
    state = st3
   }

  cobol-len-into : Text, Text -> Text
  cobol-len-into (src) (dst) =
   "           MOVE " & src & "-L TO " & dst & "\n"

 Text arriving from OUTSIDE the representation carries no length, and
 `FUNCTION TRIM` of an all-space item is one space rather than none, which is
 why the empty case is tested separately. A read of a record ending in a
 space still comes back short; the file arms are stubs and this is their
 limit, not the representation's.

  cobol-len-trimmed : Text, Text -> Text
  cobol-len-trimmed (src) (dst) =
   "           IF " & src & " = SPACES\n" &
   "             MOVE 0 TO " & dst & "\n" &
   "           ELSE\n" &
   "             COMPUTE " & dst & " = FUNCTION LENGTH(FUNCTION TRIM(" & src & " TRAILING))\n" &
   "           END-IF\n"

  emit-cobol-builtin-text-length : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-length (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in CobolExprResult {
    var-name = arg-r.var-name & "-L",
    code = arg-r.code,
    state = arg-r.state
   }

  emit-cobol-builtin-text-starts-with : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-starts-with (args) (arities) (st) =
   let s-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let p-r = emit-cobol-expr-to-var (list-at args 1) arities (s-r.state)
   in let a-res = cobol-alloc-var (p-r.state) "SWRES"
   in let st1 = cobol-add-ws (a-res.state) ("       01 " & a-res.name & "       PIC 9(1).")
   in let a-pl = cobol-alloc-var st1 "SWPL"
   in let st2 = cobol-add-ws (a-pl.state) ("       01 " & a-pl.name & "       PIC S9(18).")
   in let a-sl = cobol-alloc-var st2 "SWSL"
   in let st3 = cobol-add-ws (a-sl.state) ("       01 " & a-sl.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = a-res.name,
    code = s-r.code & p-r.code &
     cobol-len-into (p-r.var-name) (a-pl.name) &
     cobol-len-into (s-r.var-name) (a-sl.name) &
     "           IF " & a-pl.name & " = 0\n" &
     "             MOVE 1 TO " & a-res.name & "\n" &
     "           ELSE\n" &
     "             IF " & a-pl.name & " > " & a-sl.name & "\n" &
     "               MOVE 0 TO " & a-res.name & "\n" &
     "             ELSE\n" &
     "               IF " & s-r.var-name & "-D(1:" & a-pl.name & ") = " & p-r.var-name & "-D(1:" & a-pl.name & ")\n" &
     "                 MOVE 1 TO " & a-res.name & "\n" &
     "               ELSE\n" &
     "                 MOVE 0 TO " & a-res.name & "\n" &
     "               END-IF\n" &
     "             END-IF\n" &
     "           END-IF\n",
    state = st3
   }

  emit-cobol-builtin-text-contains : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-contains (args) (arities) (st) =
   let s-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let sub-r = emit-cobol-expr-to-var (list-at args 1) arities (s-r.state)
   in let a-res = cobol-alloc-var (sub-r.state) "CTRES"
   in let st1 = cobol-add-ws (a-res.state) ("       01 " & a-res.name & "       PIC 9(1).")
   in let a-bl = cobol-alloc-var st1 "CTBL"
   in let st2 = cobol-add-ws (a-bl.state) ("       01 " & a-bl.name & "       PIC S9(18).")
   in let a-ct = cobol-alloc-var st2 "CTTAL"
   in let st3 = cobol-add-ws (a-ct.state) ("       01 " & a-ct.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = a-res.name,
    code = s-r.code & sub-r.code &
     cobol-len-into (sub-r.var-name) (a-bl.name) &
     "           IF " & a-bl.name & " = 0\n" &
     "             MOVE 1 TO " & a-res.name & "\n" &
     "           ELSE\n" &
     "             MOVE 0 TO " & a-ct.name & "\n" &
     "             INSPECT " & s-r.var-name & "-D TALLYING " & a-ct.name & " FOR ALL " & sub-r.var-name & "-D(1:" & a-bl.name & ")\n" &
     "             IF " & a-ct.name & " > 0\n" &
     "               MOVE 1 TO " & a-res.name & "\n" &
     "             ELSE\n" &
     "               MOVE 0 TO " & a-res.name & "\n" &
     "             END-IF\n" &
     "           END-IF\n",
    state = st3
   }

 Measured through the seed compiler 2026-08-18 rather than read off
 `__str_replace`: an empty needle answers the subject unchanged, needle and
 replacement are both literal, and every NON-OVERLAPPING occurrence is
 replaced left to right, advancing by the needle length ("aaaa" with "aa"
 for "b" is "bb", not "b").

 `INSPECT ... REPLACING` cannot serve: it requires the two operands to be
 the same length. The scan is written out instead. Both appends are bounded
 against the 256-byte data item because a reference modification past the
 item's size is not diagnosed by every COBOL.

  emit-cobol-builtin-text-replace : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-replace (args) (arities) (st) =
   let s-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let o-r = emit-cobol-expr-to-var (list-at args 1) arities (s-r.state)
   in let n-r = emit-cobol-expr-to-var (list-at args 2) arities (o-r.state)
   in let a-res = cobol-alloc-var (n-r.state) "RPRES"
   in let st1 = cobol-add-ws (a-res.state) (cobol-decl-text (a-res.name))
   in let a-i = cobol-alloc-var st1 "RPI"
   in let st2 = cobol-add-ws (a-i.state) (cobol-decl-pic (a-i.name) "PIC S9(18)")
   in let a-o = cobol-alloc-var st2 "RPOUT"
   in let st3 = cobol-add-ws (a-o.state) (cobol-decl-pic (a-o.name) "PIC S9(18)")
   in let s = s-r.var-name
   in let o = o-r.var-name
   in let n = n-r.var-name
   in CobolExprResult {
    var-name = a-res.name,
    code = s-r.code & o-r.code & n-r.code &
     "           IF " & o & "-L = 0\n" &
     "             MOVE " & s & " TO " & a-res.name & "\n" &
     "           ELSE\n" &
     "             MOVE SPACES TO " & a-res.name & "-D\n" &
     "             MOVE 0 TO " & a-res.name & "-L\n" &
     "             MOVE 1 TO " & a-i.name & "\n" &
     "             PERFORM UNTIL " & a-i.name & " > " & s & "-L\n" &
     "               COMPUTE " & a-o.name & " = " & a-res.name & "-L + 1\n" &
     "               IF " & a-i.name & " + " & o & "-L - 1 > " & s & "-L\n" &
     cobol-replace-copy-one s a-i.name a-res.name a-o.name &
     "               ELSE\n" &
     "                 IF " & s & "-D(" & a-i.name & ":" & o & "-L) = " & cobol-slice o & "\n" &
     "                   IF " & n & "-L > 0 AND " & a-o.name & " + " & n & "-L - 1 <= 256\n" &
     "                     MOVE " & cobol-slice n & " TO " & a-res.name & "-D(" & a-o.name & ":" & n & "-L)\n" &
     "                   END-IF\n" &
     "                   COMPUTE " & a-res.name & "-L = " & a-res.name & "-L + " & n & "-L\n" &
     "                   COMPUTE " & a-i.name & " = " & a-i.name & " + " & o & "-L\n" &
     "                 ELSE\n" &
     cobol-replace-copy-one s a-i.name a-res.name a-o.name &
     "                 END-IF\n" &
     "               END-IF\n" &
     "             END-PERFORM\n" &
     "             IF " & a-res.name & "-L > 256\n" &
     "               MOVE 256 TO " & a-res.name & "-L\n" &
     "             END-IF\n" &
     "           END-IF\n",
    state = st3
   }

  cobol-replace-copy-one : Text, Text, Text, Text -> Text
  cobol-replace-copy-one (s) (i) (res) (out) =
   "                 IF " & out & " <= 256\n" &
   "                   MOVE " & s & "-D(" & i & ":1) TO " & res & "-D(" & out & ":1)\n" &
   "                 END-IF\n" &
   "                 COMPUTE " & res & "-L = " & res & "-L + 1\n" &
   "                 ADD 1 TO " & i & "\n"

  emit-cobol-builtin-char-at : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-char-at (args) (arities) (st) =
   let str-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let idx-r = emit-cobol-expr-to-var (list-at args 1) arities (str-r.state)
   in let alloc = cobol-alloc-var (idx-r.state) "CHAT"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC X(1).")
   in let alloc2 = cobol-alloc-var st2 "CIDX"
   in let st3 = cobol-add-ws (alloc2.state) ("       01 " & alloc2.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = str-r.code & idx-r.code & "           ADD 1 TO " & idx-r.var-name & " GIVING " & alloc2.name & "\n" &
     "           MOVE " & str-r.var-name & "-D(" & alloc2.name & ":1) TO " & alloc.name & "\n",
    state = st3
   }

  emit-cobol-builtin-substring : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-substring (args) (arities) (st) =
   let str-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let start-r = emit-cobol-expr-to-var (list-at args 1) arities (str-r.state)
   in let len-r = emit-cobol-expr-to-var (list-at args 2) arities (start-r.state)
   in let alloc = cobol-alloc-var (len-r.state) "SUB"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-text (alloc.name))
   in let alloc2 = cobol-alloc-var st2 "SPOS"
   in let st3 = cobol-add-ws (alloc2.state) (cobol-decl-pic (alloc2.name) "PIC S9(18)")
   in let alloc3 = cobol-alloc-var st3 "SLEN"
   in let st4 = cobol-add-ws (alloc3.state) (cobol-decl-pic (alloc3.name) "PIC S9(18)")
   in CobolExprResult {
    var-name = alloc.name,
    code = str-r.code & start-r.code & len-r.code &
     "           ADD 1 TO " & start-r.var-name & " GIVING " & alloc2.name & "\n" &
     "           MOVE " & len-r.var-name & " TO " & alloc3.name & "\n" &
     "           IF " & alloc2.name & " + " & alloc3.name & " - 1 > " & str-r.var-name & "-L\n" &
     "             COMPUTE " & alloc3.name & " = " & str-r.var-name & "-L - " & alloc2.name & " + 1\n" &
     "           END-IF\n" &
     "           IF " & alloc3.name & " < 0\n" &
     "             MOVE 0 TO " & alloc3.name & "\n" &
     "           END-IF\n" &
     "           MOVE SPACES TO " & alloc.name & "-D\n" &
     "           IF " & alloc3.name & " > 0\n" &
     "             MOVE " & str-r.var-name & "-D(" & alloc2.name & ":" & alloc3.name & ") TO " & alloc.name & "-D\n" &
     "           END-IF\n" &
     "           MOVE " & alloc3.name & " TO " & alloc.name & "-L\n",
    state = st4
   }

 `FUNCTION NUMVAL` is implementation-defined on anything that is not wholly
 numeric, where `parse-decimal` is not: an optional leading minus, then
 digits UNTIL THE FIRST NON-DIGIT, and 0 when there are none. Written out so
 the answer does not depend on which COBOL is compiling it. `FUNCTION ORD`
 answers the collating position, which is the byte value plus one, so the
 digit conversion subtracts 49 rather than 48.

  emit-cobol-builtin-text-to-integer : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-text-to-integer (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (arg-r.state) "NUMV"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in let a-i = cobol-alloc-var st2 "NVI"
   in let st3 = cobol-add-ws (a-i.state) ("       01 " & a-i.name & "       PIC S9(18).")
   in let a-n = cobol-alloc-var st3 "NVNEG"
   in let st4 = cobol-add-ws (a-n.state) ("       01 " & a-n.name & "       PIC 9(1).")
   in let a-l = cobol-alloc-var st4 "NVLEN"
   in let st5 = cobol-add-ws (a-l.state) ("       01 " & a-l.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code &
     cobol-len-into (arg-r.var-name) (a-l.name) &
     "           MOVE 0 TO " & alloc.name & "\n" &
     "           MOVE 0 TO " & a-n.name & "\n" &
     "           MOVE 1 TO " & a-i.name & "\n" &
     "           IF " & a-l.name & " > 0 AND " & arg-r.var-name & "-D(1:1) = \"-\"\n" &
     "             MOVE 1 TO " & a-n.name & "\n" &
     "             MOVE 2 TO " & a-i.name & "\n" &
     "           END-IF\n" &
     "           PERFORM UNTIL " & a-i.name & " > " & a-l.name & "\n" &
     "             IF " & arg-r.var-name & "-D(" & a-i.name & ":1) >= \"0\" AND " & arg-r.var-name & "-D(" & a-i.name & ":1) <= \"9\"\n" &
     "               COMPUTE " & alloc.name & " = " & alloc.name & " * 10 + (FUNCTION ORD(" & arg-r.var-name & "-D(" & a-i.name & ":1)) - 49)\n" &
     "               ADD 1 TO " & a-i.name & "\n" &
     "             ELSE\n" &
     "               EXIT PERFORM\n" &
     "             END-IF\n" &
     "           END-PERFORM\n" &
     "           IF " & a-n.name & " = 1\n" &
     "             COMPUTE " & alloc.name & " = 0 - " & alloc.name & "\n" &
     "           END-IF\n",
    state = st5
   }

  emit-cobol-builtin-abs : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-abs (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (arg-r.state) "ABS"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code & "           COMPUTE " & alloc.name & " = FUNCTION ABS(" & arg-r.var-name & ")\n",
    state = st2
   }

  emit-cobol-builtin-min : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-min (args) (arities) (st) =
   let a-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let b-r = emit-cobol-expr-to-var (list-at args 1) arities (a-r.state)
   in let alloc = cobol-alloc-var (b-r.state) "MIN"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = a-r.code & b-r.code & "           COMPUTE " & alloc.name & " = FUNCTION MIN(" & a-r.var-name & " " & b-r.var-name & ")\n",
    state = st2
   }

  emit-cobol-builtin-max : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-max (args) (arities) (st) =
   let a-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let b-r = emit-cobol-expr-to-var (list-at args 1) arities (a-r.state)
   in let alloc = cobol-alloc-var (b-r.state) "MAX"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = a-r.code & b-r.code & "           COMPUTE " & alloc.name & " = FUNCTION MAX(" & a-r.var-name & " " & b-r.var-name & ")\n",
    state = st2
   }

  emit-cobol-builtin-int-mod : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-int-mod (args) (arities) (st) =
   let a-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let b-r = emit-cobol-expr-to-var (list-at args 1) arities (a-r.state)
   in let alloc = cobol-alloc-var (b-r.state) "MOD"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = a-r.code & b-r.code & "           COMPUTE " & alloc.name & " = FUNCTION MOD(" & a-r.var-name & " FUNCTION ABS(" & b-r.var-name & "))\n",
    state = st2
   }

 The character predicates test CCE BANDS: 1..2 whitespace, 3..12 digit,
 13..64 or 97..127 letter, the hole being CCE's punctuation at 65..96.

 Both of these ran `FUNCTION ORD` over the operand and compared against
 66..91 and 98..123, which is ASCII with COBOL's one-based ordinal added.
 Two things were wrong with that. The bands were ASCII rather than CCE,
 and the operand is already an INTEGER here -- a Char reaches this
 emitter as a numeric literal or a numeric working-storage item, so ORD
 was being applied to a number. Comparing the value directly is both
 correct and one variable cheaper.

  emit-cobol-builtin-is-letter : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-is-letter (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (arg-r.state) "ISLT"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC 9(1).")
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code &
     "           IF (" & arg-r.var-name & " >= 13 AND " & arg-r.var-name & " <= 64)\n" &
     "              OR (" & arg-r.var-name & " >= 97 AND " & arg-r.var-name & " <= 127)\n" &
     "             MOVE 1 TO " & alloc.name & "\n" &
     "           ELSE\n" &
     "             MOVE 0 TO " & alloc.name & "\n" &
     "           END-IF\n",
    state = st2
   }

  emit-cobol-builtin-is-digit : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-is-digit (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (arg-r.state) "ISDI"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC 9(1).")
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code &
     "           IF " & arg-r.var-name & " >= 3 AND " & arg-r.var-name & " <= 12\n" &
     "             MOVE 1 TO " & alloc.name & "\n" &
     "           ELSE\n" &
     "             MOVE 0 TO " & alloc.name & "\n" &
     "           END-IF\n",
    state = st2
   }

  emit-cobol-builtin-read-file : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-read-file (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let alloc = cobol-alloc-var (arg-r.state) "RFILE"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-text (alloc.name))
   in CobolExprResult {
    var-name = alloc.name,
    code = arg-r.code & "           OPEN INPUT " & arg-r.var-name & "\n" &
     "           READ " & arg-r.var-name & " INTO " & alloc.name & "-D\n" &
     "           CLOSE " & arg-r.var-name & "\n" &
     cobol-len-trimmed (alloc.name & "-D") (alloc.name & "-L"),
    state = st2
   }

  emit-cobol-builtin-write-file : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-write-file (args) (arities) (st) =
   let path-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in let data-r = emit-cobol-expr-to-var (list-at args 1) arities (path-r.state)
   in CobolExprResult {
    var-name = "0",
    code = path-r.code & data-r.code & "           OPEN OUTPUT " & path-r.var-name & "\n" &
     "           WRITE " & data-r.var-name & "-D\n" &
     "           CLOSE " & path-r.var-name & "\n",
    state = data-r.state
   }

  emit-cobol-builtin-process-exit : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-process-exit (args) (arities) (st) =
   let arg-r = emit-cobol-expr-to-var (list-at args 0) arities st
   in CobolExprResult {
    var-name = "0",
    code = arg-r.code & "           MOVE " & arg-r.var-name & " TO RETURN-CODE\n           STOP RUN\n",
    state = arg-r.state
   }

  emit-cobol-builtin-bit-stub : Text, List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-builtin-bit-stub (op-name) (args) (arities) (st) =
   let alloc = cobol-alloc-var st "BIT"
   in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       PIC S9(18).")
   in CobolExprResult {
    var-name = alloc.name,
    code = "           DISPLAY \"COBOL: " & op-name & " not supported\"\n" &
     "           MOVE 0 TO " & alloc.name & "\n",
    state = st2
   }

  emit-cobol-call-def : Text, List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-call-def (n) (args) (arities) (st) =
   let ar = lookup-arity arities n
   in if ar < 0 then let fallback = emit-cobol-expr-to-var (list-at args 0) arities st
      in CobolExprResult { var-name = fallback.var-name, code = fallback.code, state = fallback.state }
   else let name = cobol-name n
   in let result = emit-cobol-move-args args name (lookup-param-names arities n) arities st 0
   in CobolExprResult {
    var-name = "WS-" & name & "-RET",
    code = result.code & "           PERFORM " & name & "-PARA\n",
    state = result.state
   }

  CobolMoveResult = record {
   code : Text,
   state : CobolState
  }

  emit-cobol-move-args : List IRExpr, Text, List Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-move-args (args) (func-name) (pnames) (arities) (st) (i) =
   if i >= list-length args then CobolMoveResult { code = "", state = st }
   else let arg-r = emit-cobol-expr-to-var (list-at args i) arities st
   in let slot = if i < list-length pnames then "WS-" & func-name & "-" & list-at pnames i
                 else "WS-" & func-name & "-ARG" & integer-to-text i
   in let rest = emit-cobol-move-args args func-name pnames arities (arg-r.state) (i + 1)
   in CobolMoveResult {
    code = arg-r.code & "           MOVE " & arg-r.var-name & " TO " & slot & "\n" & rest.code,
    state = rest.state
   }

  emit-cobol-match-var : IRExpr, List IRBranch, CodexType, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-match-var (scrut) (branches) (ty) (arities) (st) =
   let scrut-r = emit-cobol-expr-to-var scrut arities st
   in let alloc = cobol-alloc-var (scrut-r.state) "MATCH"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl (st.tdefs) (alloc.name) ty)
   in if cobol-match-plain branches 0
      then let arms = emit-cobol-match-arms branches (alloc.name) (scrut-r.var-name) arities st2
      in CobolExprResult {
       var-name = alloc.name,
       code = scrut-r.code & "           EVALUATE " & cobol-match-subject branches (scrut-r.var-name) 0 & "\n" &
        arms.code & "           END-EVALUATE\n",
       state = arms.state
      }
      else emit-cobol-match-chain branches (alloc.name) (scrut-r.var-name) (scrut-r.code) arities st2

 An EVALUATE prong cannot fall through and its WHEN takes a value rather than a
 condition, so a prong can carry neither a guard nor the statements a guard
 needs to compute one. A guarded match is emitted as a chain instead: one IF
 per arm, gated on a flag so that arms after the first match are skipped
 without nesting each remaining arm inside the previous arm's ELSE.

  cobol-guard-trivial : IRExpr -> Boolean
  cobol-guard-trivial (g) =
   when g
    is IrBoolLit (v) (sp) -> v
    is otherwise -> False

  cobol-match-plain : List IRBranch, Integer -> Boolean
  cobol-match-plain (branches) (i) =
   if i >= list-length branches then True
   else let b = list-at branches i
   in if cobol-guard-trivial (b.guard) then cobol-match-plain branches (i + 1)
      else False

  cobol-pat-cond : IRPat, Text -> Text
  cobol-pat-cond (pat) (scrut-var) =
   when pat
    is IrCtorPat (name) (subs) (ty) (sp) -> scrut-var & "-TAG = TAG-" & cobol-name name
    is IrLitPat (text) (ty) (sp) -> scrut-var & " = " & text
    is otherwise -> ""

  emit-cobol-match-chain : List IRBranch, Text, Text, Text, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-match-chain (branches) (result-var) (scrut-var) (scrut-code) (arities) (st) =
   let flag = cobol-alloc-var st "MATCHED"
   in let st2 = cobol-add-ws (flag.state) (cobol-decl-pic (flag.name) "PIC 9(1)")
   in let arms = emit-cobol-chain-arms branches result-var scrut-var (flag.name) arities st2 0
   in CobolExprResult {
    var-name = result-var,
    code = scrut-code & "           MOVE 0 TO " & flag.name & "\n" & arms.code,
    state = arms.state
   }

  emit-cobol-chain-arms : List IRBranch, Text, Text, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-chain-arms (branches) (result-var) (scrut-var) (flag) (arities) (st) (i) =
   if i >= list-length branches then CobolMoveResult { code = "", state = st }
   else let b = list-at branches i
   in let depth = list-length (st.env)
   in let bound = cobol-bind-pat (b.pattern) scrut-var st
   in let guard-r = emit-cobol-expr-to-var (b.guard) arities bound
   in let body-r = emit-cobol-expr-to-var (b.body) arities (guard-r.state)
   in let taken = body-r.code & "               MOVE " & body-r.var-name & " TO " & result-var & "\n" &
                  "               MOVE 1 TO " & flag & "\n"
   in let guarded = if cobol-guard-trivial (b.guard) then taken
                    else guard-r.code & "             IF " & guard-r.var-name & " NOT = 0\n" &
                         taken & "             END-IF\n"
   in let cond = cobol-pat-cond (b.pattern) scrut-var
   in let tested = if text-length cond == 0 then guarded
                   else "             IF " & cond & "\n" & guarded & "             END-IF\n"
   in let rest = emit-cobol-chain-arms branches result-var scrut-var flag arities (cobol-env-restore (body-r.state) depth) (i + 1)
   in CobolMoveResult {
    code = "           IF " & flag & " = 0\n" & tested & "           END-IF\n" & rest.code,
    state = rest.state
   }

  cobol-match-subject : List IRBranch, Text, Integer -> Text
  cobol-match-subject (branches) (scrut-var) (i) =
   if i >= list-length branches then scrut-var
   else let b = list-at branches i
   in when b.pattern
    is IrCtorPat (name) (subs) (ty) (sp) -> scrut-var & "-TAG"
    is otherwise -> cobol-match-subject branches scrut-var (i + 1)

  emit-cobol-match-arms : List IRBranch, Text, Text, List ArityEntry, CobolState -> CobolMoveResult
  emit-cobol-match-arms (branches) (result-var) (scrut-var) (arities) (st) =
   emit-cobol-match-arms-loop branches result-var scrut-var arities st 0

  emit-cobol-match-arms-loop : List IRBranch, Text, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-match-arms-loop (branches) (result-var) (scrut-var) (arities) (st) (i) =
   if i >= list-length branches then CobolMoveResult { code = "", state = st }
   else let b = list-at branches i
   in let arm = emit-cobol-match-one-arm b result-var scrut-var arities st
   in let rest = emit-cobol-match-arms-loop branches result-var scrut-var arities (arm.state) (i + 1)
   in CobolMoveResult { code = arm.code & rest.code, state = rest.state }

  cobol-bind-ctor-subs : List IRPat, Text, CobolState, Integer -> CobolState
  cobol-bind-ctor-subs (subs) (scrut-var) (st) (i) =
   if i >= list-length subs then st
   else let s = list-at subs i
   in let st2 = when s
    is IrVarPat (vname) (ty) (sp) -> cobol-env-bind st vname (scrut-var & "-F" & integer-to-text i)
    is otherwise -> st
   in cobol-bind-ctor-subs subs scrut-var st2 (i + 1)

  cobol-bind-pat : IRPat, Text, CobolState -> CobolState
  cobol-bind-pat (pat) (scrut-var) (st) =
   when pat
    is IrCtorPat (name) (subs) (ty) (sp) -> cobol-bind-ctor-subs subs scrut-var st 0
    is IrVarPat (vname) (ty) (sp) -> cobol-env-bind st vname scrut-var
    is otherwise -> st

  CobolArmResult = record {
   code : Text,
   state : CobolState
  }

  emit-cobol-match-one-arm : IRBranch, Text, Text, List ArityEntry, CobolState -> CobolArmResult
  emit-cobol-match-one-arm (b) (result-var) (scrut-var) (arities) (st) =
   let label = when b.pattern
    is IrCtorPat (name) (subs) (ty) (sp) -> "             WHEN TAG-" & cobol-name name & "\n"
    is IrWildPat (sp) -> "             WHEN OTHER\n"
    is IrVecPat (pats) (ty) (sp) -> "             WHEN OTHER\n"
    is IrVarPat (vname) (ty) (sp) -> "             WHEN OTHER\n"
    is IrLitPat (text) (ty) (sp) -> "             WHEN " & text & "\n"
   in let depth = list-length (st.env)
   in let body-r = emit-cobol-expr-to-var (b.body) arities (cobol-bind-pat (b.pattern) scrut-var st)
   in CobolArmResult {
    code = label & body-r.code & "               MOVE " & body-r.var-name & " TO " & result-var & "\n",
    state = cobol-env-restore (body-r.state) depth
   }

  emit-cobol-record-var : Text, List IRFieldVal, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-record-var (rname) (fields) (arities) (st) =
   let rec-name = cobol-name rname
   in let result-var = "WS-" & rec-name
   in let moves = emit-cobol-record-moves fields rec-name arities st 0
   in CobolExprResult {
    var-name = result-var,
    code = moves.code,
    state = moves.state
   }

  emit-cobol-record-moves : List IRFieldVal, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-record-moves (fields) (rec-name) (arities) (st) (i) =
   if i >= list-length fields then CobolMoveResult { code = "", state = st }
   else let f = list-at fields i
   in let val-r = emit-cobol-expr-to-var (f.value) arities st
   in let fn = cobol-name (f.name)
   in let rest = emit-cobol-record-moves fields rec-name arities (val-r.state) (i + 1)
   in CobolMoveResult {
    code = val-r.code & "           MOVE " & val-r.var-name & " TO WS-" & rec-name & "-" & fn & "\n" & rest.code,
    state = rest.state
   }

  emit-cobol-field-var : IRExpr, Text, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-field-var (rec) (field) (arities) (st) =
   let rec-r = emit-cobol-expr-to-var rec arities st
   in let fn = cobol-field field
   in CobolExprResult {
    var-name = rec-r.var-name & "-" & fn,
    code = rec-r.code,
    state = rec-r.state
   }

 A literal fills the table and sets the length. It used to move each element
 into a scalar of its own and answer the LAST one, or `0` for an empty list, so
 `lit-len [10,20,30,40]` returned 0 where Codex answers 4 and the four MOVEs
 went nowhere.

  emit-cobol-list-var : List IRExpr, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-list-var (elems) (arities) (st) =
   let n = list-length elems
   in let alloc = cobol-alloc-var st "LIST"
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl-list (alloc.name))
   in let moves = emit-cobol-list-moves elems arities st2 0 (alloc.name)
   in CobolExprResult {
    var-name = alloc.name,
    code = moves.code & "           MOVE " & integer-to-text (if n > cobol-list-cap then cobol-list-cap else n) & " TO " & alloc.name & "-L\n",
    state = moves.state
   }

  emit-cobol-list-moves : List IRExpr, List ArityEntry, CobolState, Integer, Text -> CobolExprResult
  emit-cobol-list-moves (elems) (arities) (st) (i) (dst) =
   if i >= list-length elems then CobolExprResult { var-name = dst, code = "", state = st }
   else if i >= cobol-list-cap then CobolExprResult { var-name = dst, code = "", state = st }
   else let elem-r = emit-cobol-expr-to-var (list-at elems i) arities st
   in let rest = emit-cobol-list-moves elems arities (elem-r.state) (i + 1) dst
   in CobolExprResult {
    var-name = dst,
    code = elem-r.code & "           MOVE " & elem-r.var-name & " TO " & dst & "-D(" & integer-to-text (i + 1) & ")\n" & rest.code,
    state = rest.state
   }

  emit-cobol-act-expr : List IRActStmt, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-act-expr (stmts) (arities) (st) =
   emit-cobol-act-expr-loop stmts arities st 0

  emit-cobol-act-expr-loop : List IRActStmt, List ArityEntry, CobolState, Integer -> CobolExprResult
  emit-cobol-act-expr-loop (stmts) (arities) (st) (i) =
   if i >= list-length stmts then CobolExprResult { var-name = "0", code = "", state = st }
   else let s = list-at stmts i
   in let r = emit-cobol-act-stmt-expr s arities st
   in let rest = emit-cobol-act-expr-loop stmts arities (r.state) (i + 1)
   in CobolExprResult {
    var-name = if i == list-length stmts - 1 then r.var-name else rest.var-name,
    code = r.code & rest.code,
    state = rest.state
   }

  emit-cobol-act-stmt-expr : IRActStmt, List ArityEntry, CobolState -> CobolExprResult
  emit-cobol-act-stmt-expr (s) (arities) (st) =
   when s
    is IrDoExec (e) (sp) -> emit-cobol-expr-to-var e arities st
    is IrDoBind (name) (ty) (val) (sp) ->
     let val-r = emit-cobol-expr-to-var val arities st
     in let alloc = cobol-alloc-var (val-r.state) (cobol-name name)
     in let pic = cobol-pic ty
     in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       " & pic & ".")
     in CobolExprResult {
      var-name = alloc.name,
      code = val-r.code & "           MOVE " & val-r.var-name & " TO " & alloc.name & "\n",
      state = cobol-env-bind st2 name (alloc.name)
     }

Section: Tail Call Optimization

  cobol-is-self-call : IRExpr, Text -> Boolean
  cobol-is-self-call (e) (func-name) =
   let chain = collect-apply-chain e []
   in when chain.root
    is IrName (n) (ty) (sp) -> n == func-name
    is otherwise -> False

  cobol-has-tail-call : IRExpr, Text -> Boolean
  cobol-has-tail-call (e) (func-name) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> cobol-has-tail-call t func-name | cobol-has-tail-call el func-name
    is IrLet (name) (ty) (val) (body) (sp) -> cobol-has-tail-call body func-name
    is IrMatch (scrut) (branches) (ty) (sp) -> cobol-has-tail-call-branches branches func-name 0
    is IrApply (f) (a) (ty) (sp) -> cobol-is-self-call e func-name
    is otherwise -> False

  cobol-has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  cobol-has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if cobol-has-tail-call (b.body) func-name then True
      else cobol-has-tail-call-branches branches func-name (i + 1)

  cobol-should-tco : IRDef -> Boolean
  cobol-should-tco (d) =
   if list-length (d.params) == 0 then False
   else cobol-has-tail-call (d.body) (d.name)

  emit-cobol-tco-body : IRExpr, Text, List IRParam, List ArityEntry, CobolState -> CobolMoveResult
  emit-cobol-tco-body (e) (func-name) (params) (arities) (st) =
   let name = cobol-name func-name
   in when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     let cond = emit-cobol-expr-to-var c arities st
     in let then-r = emit-cobol-tco-body t func-name params arities (cond.state)
     in let else-r = emit-cobol-tco-body el func-name params arities (then-r.state)
     in CobolMoveResult {
      code = cond.code & "           IF " & cond.var-name & " NOT = 0\n" &
       then-r.code & "           ELSE\n" &
       else-r.code & "           END-IF\n",
      state = else-r.state
     }
    is IrLet (lname) (ty) (val) (body) (sp) ->
     let val-r = emit-cobol-expr-to-var val arities st
     in let alloc = cobol-alloc-var (val-r.state) (cobol-name lname)
     in let pic = cobol-pic ty
     in let st2 = cobol-add-ws (alloc.state) ("       01 " & alloc.name & "       " & pic & ".")
     in let depth = list-length (st2.env)
     in let body-r = emit-cobol-tco-body body func-name params arities (cobol-env-bind st2 lname (alloc.name))
     in CobolMoveResult {
      code = val-r.code & "           MOVE " & val-r.var-name & " TO " & alloc.name & "\n" & body-r.code,
      state = cobol-env-restore (body-r.state) depth
     }
    is IrMatch (scrut) (branches) (ty) (sp) ->
     let scrut-r = emit-cobol-expr-to-var scrut arities st
     in if cobol-match-plain branches 0
        then let arms = emit-cobol-tco-match-arms branches func-name params (scrut-r.var-name) arities (scrut-r.state) 0
        in CobolMoveResult {
         code = scrut-r.code & "           EVALUATE " & cobol-match-subject branches (scrut-r.var-name) 0 & "\n" &
          arms.code & "           END-EVALUATE\n",
         state = arms.state
        }
        else let flag = cobol-alloc-var (scrut-r.state) "TMATCHED"
        in let stf = cobol-add-ws (flag.state) (cobol-decl-pic (flag.name) "PIC 9(1)")
        in let arms = emit-cobol-tco-chain-arms branches func-name params (scrut-r.var-name) (flag.name) arities stf 0
        in CobolMoveResult {
         code = scrut-r.code & "           MOVE 0 TO " & flag.name & "\n" & arms.code,
         state = arms.state
        }
    is IrApply (f) (a) (rty) (sp) ->
     if cobol-is-self-call e func-name then emit-cobol-tco-jump e func-name params arities st
     else let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrBinary (op) (l) (r) (ty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrIntLit (n) (sp) ->
     CobolMoveResult {
      code = "           MOVE " & integer-to-text n & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrBoolLit (b) (sp) ->
     CobolMoveResult {
      code = "           MOVE " & (if b then "1" else "0") & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrTextLit (s) (sp) ->
     CobolMoveResult {
      code = "           MOVE \"" & cobol-escape-text s & "\" TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrNumLit (n) (sp) ->
     CobolMoveResult {
      code = "           MOVE " & integer-to-text n & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrCharLit (n) (sp) ->
     CobolMoveResult {
      code = "           MOVE " & integer-to-text n & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrName (n) (ty) (sp) ->
     let name-r = emit-cobol-name-var n ty st
     in CobolMoveResult {
      code = name-r.code & "           MOVE " & name-r.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = name-r.state
     }
    is IrNegate (operand) (nty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrRecord (rname) (fields) (ty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrFieldAccess (rec) (field) (ty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrFieldStore (rec) (field) (val) (ty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrTry (max) (body) (fb) (fail-stmts) (ty) (sp) ->
     CobolMoveResult {
      code = "           MOVE 0 TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrAct (stmts) (ty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrHandle (eff) (body) (clauses) (ty) (sp) ->
     emit-cobol-tco-body body func-name params arities st
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) ->
     emit-cobol-tco-body body func-name params arities st
    is IrFork (body) (ty) (sp) ->
     emit-cobol-tco-body body func-name params arities st
    is IrAwait (task) (ty) (sp) ->
     let res = emit-cobol-expr-to-var task arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrLambda (lparams) (lbody) (lty) (sp) ->
     CobolMoveResult {
      code = "           DISPLAY \"COBOL: lambda not supported\"\n" &
       "           MOVE 0 TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }
    is IrList (elems) (lty) (sp) ->
     let res = emit-cobol-expr-to-var e arities st
     in CobolMoveResult {
      code = res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = res.state
     }
    is IrError (msg) (ty) (sp) ->
     CobolMoveResult {
      code = "           MOVE 0 TO WS-" & name & "-RET\n" &
       "           GO TO " & name & "-END\n",
      state = st
     }

  emit-cobol-tco-match-arms : List IRBranch, Text, List IRParam, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-tco-match-arms (branches) (func-name) (params) (scrut-var) (arities) (st) (i) =
   if i >= list-length branches then CobolMoveResult { code = "", state = st }
   else let b = list-at branches i
   in let label = when b.pattern
    is IrCtorPat (pname) (subs) (ty) (sp) -> "             WHEN TAG-" & cobol-name pname & "\n"
    is IrWildPat (sp) -> "             WHEN OTHER\n"
    is IrVecPat (pats) (ty) (sp) -> "             WHEN OTHER\n"
    is IrVarPat (vname) (ty) (sp) -> "             WHEN OTHER\n"
    is IrLitPat (text) (ty) (sp) -> "             WHEN " & text & "\n"
   in let depth = list-length (st.env)
   in let body-r = emit-cobol-tco-body (b.body) func-name params arities (cobol-bind-pat (b.pattern) scrut-var st)
   in let rest = emit-cobol-tco-match-arms branches func-name params scrut-var arities (cobol-env-restore (body-r.state) depth) (i + 1)
   in CobolMoveResult { code = label & body-r.code & rest.code, state = rest.state }

 A tail-position arm leaves the paragraph by a GO TO, so the flag is not what
 stops the next arm running; it is what stops an arm whose body does NOT jump
 from falling into the next arm's test.

  emit-cobol-tco-chain-arms : List IRBranch, Text, List IRParam, Text, Text, List ArityEntry, CobolState, Integer -> CobolMoveResult
  emit-cobol-tco-chain-arms (branches) (func-name) (params) (scrut-var) (flag) (arities) (st) (i) =
   if i >= list-length branches then CobolMoveResult { code = "", state = st }
   else let b = list-at branches i
   in let depth = list-length (st.env)
   in let bound = cobol-bind-pat (b.pattern) scrut-var st
   in let guard-r = emit-cobol-expr-to-var (b.guard) arities bound
   in let body-r = emit-cobol-tco-body (b.body) func-name params arities (guard-r.state)
   in let taken = body-r.code & "               MOVE 1 TO " & flag & "\n"
   in let guarded = if cobol-guard-trivial (b.guard) then taken
                    else guard-r.code & "             IF " & guard-r.var-name & " NOT = 0\n" &
                         taken & "             END-IF\n"
   in let cond = cobol-pat-cond (b.pattern) scrut-var
   in let tested = if text-length cond == 0 then guarded
                   else "             IF " & cond & "\n" & guarded & "             END-IF\n"
   in let rest = emit-cobol-tco-chain-arms branches func-name params scrut-var flag arities (cobol-env-restore (body-r.state) depth) (i + 1)
   in CobolMoveResult {
    code = "           IF " & flag & " = 0\n" & tested & "           END-IF\n" & rest.code,
    state = rest.state
   }

  emit-cobol-tco-jump : IRExpr, Text, List IRParam, List ArityEntry, CobolState -> CobolMoveResult
  emit-cobol-tco-jump (e) (func-name) (params) (arities) (st) =
   let chain = collect-apply-chain e []
   in let name = cobol-name func-name
   in let ev = emit-cobol-tco-eval-args (chain.args) params name arities st 0
   in CobolMoveResult {
    code = ev.ta-code & ev.ta-commit & "           GO TO " & name & "-LOOP\n",
    state = ev.ta-state
   }

  CobolTcoArgs = record {
   ta-code : Text,
   ta-commit : Text,
   ta-state : CobolState
  }

 A tail call assigns the parameters of the loop it jumps back to, so an
 argument written early is visible to an argument emitted after it. Every
 argument lands in its own temporary first and the slots are committed
 together.

  emit-cobol-tco-eval-args : List IRExpr, List IRParam, Text, List ArityEntry, CobolState, Integer -> CobolTcoArgs
  emit-cobol-tco-eval-args (args) (params) (name) (arities) (st) (i) =
   if i >= list-length args then CobolTcoArgs { ta-code = "", ta-commit = "", ta-state = st }
   else if i >= list-length params then CobolTcoArgs { ta-code = "", ta-commit = "", ta-state = st }
   else let p = list-at params i
   in let pname = cobol-name (p.name)
   in let arg-r = emit-cobol-expr-to-var (list-at args i) arities st
   in let alloc = cobol-alloc-var (arg-r.state) ("TCOARG" & integer-to-text i)
   in let st2 = cobol-add-ws (alloc.state) (cobol-decl (st.tdefs) (alloc.name) (p.type-val))
   in let rest = emit-cobol-tco-eval-args args params name arities st2 (i + 1)
   in CobolTcoArgs {
    ta-code = arg-r.code & "           MOVE " & arg-r.var-name & " TO " & alloc.name & "\n" & rest.ta-code,
    ta-commit = "           MOVE " & alloc.name & " TO WS-" & name & "-" & pname & "\n" & rest.ta-commit,
    ta-state = rest.ta-state
   }

Section: Definition Emission

  emit-cobol-def-storage : IRDef, List ATypeDef -> Text
  emit-cobol-def-storage (d) (tds) =
   let name = cobol-name (d.name)
   in emit-cobol-param-storage (d.params) name tds 0 & cobol-decl tds ("WS-" & name & "-RET") (cobol-def-ret-type d) & "\n"

  cobol-def-ret-type : IRDef -> CodexType
  cobol-def-ret-type (d) =
   cobol-get-return-type (d.type-val) (list-length (d.params))

  cobol-get-return-type : CodexType, Integer -> CodexType
  cobol-get-return-type (ty) (n) =
   if n == 0 then cobol-strip-forall ty
   else when cobol-strip-forall ty
    is FunTy (p) (fnrow) (r) -> cobol-get-return-type r (n - 1)
    is otherwise -> ty

  cobol-strip-forall : CodexType -> CodexType
  cobol-strip-forall (ty) =
   when ty
    is ForAllTy (id) (body) -> cobol-strip-forall body
    is ForAllEff (id) (body) -> cobol-strip-forall body
    is LinearTy (body) -> cobol-strip-forall body
    is TypeApply (body) (tyarg) -> cobol-strip-forall body
    is otherwise -> ty

  emit-cobol-param-storage : List IRParam, Text, List ATypeDef, Integer -> Text
  emit-cobol-param-storage (params) (func-name) (tds) (i) =
   if i >= list-length params then ""
   else let p = list-at params i
   in let pname = cobol-name (p.name)
   in cobol-decl tds ("WS-" & func-name & "-" & pname) (p.type-val) & "\n" & emit-cobol-param-storage params func-name tds (i + 1)

  emit-cobol-def-paragraph : IRDef, List ArityEntry, CobolState -> CobolDefResult
  emit-cobol-def-paragraph (d) (arities) (st) =
   let name = cobol-name (d.name)
   in let st2 = cobol-bind-params (d.params) name (cobol-set-func st ("WS-" & name)) 0
   in if cobol-should-tco d then emit-cobol-tco-paragraph d arities st2
      else let res = emit-cobol-expr-to-var (d.body) arities st2
      in let st3 = cobol-set-env (cobol-set-func (res.state) "") []
      in CobolDefResult {
       code = "       " & name & "-PARA.\n" &
        res.code & "           MOVE " & res.var-name & " TO WS-" & name & "-RET\n\n",
       state = st3
      }

  CobolDefResult = record {
   code : Text,
   state : CobolState
  }

  emit-cobol-tco-paragraph : IRDef, List ArityEntry, CobolState -> CobolDefResult
  emit-cobol-tco-paragraph (d) (arities) (st) =
   let name = cobol-name (d.name)
   in let body-r = emit-cobol-tco-body (d.body) (d.name) (d.params) arities st
   in let st2 = cobol-set-env (cobol-set-func (body-r.state) "") []
   in CobolDefResult {
    code = "       " & name & "-PARA.\n" &
     "       " & name & "-LOOP.\n" &
     body-r.code & "       " & name & "-END.\n\n",
    state = st2
   }

Section: Chapter Emission

  cobol-opening-entry-point : Text
  cobol-opening-entry-point = "opening"

  cobol-find-entry : List IRDef, Integer -> Integer
  cobol-find-entry (defs) (i) =
   if i >= list-length defs then -1
   else let d = list-at defs i
   in if d.name == cobol-opening-entry-point then if list-length (d.params) == 0 then i
                                                   else cobol-find-entry defs (i + 1)
      else cobol-find-entry defs (i + 1)

  emit-cobol-all-defs : List IRDef, List ArityEntry, CobolState, Integer, Integer -> CobolDefResult
  emit-cobol-all-defs (defs) (arities) (st) (i) (entry-idx) =
   if i >= list-length defs then CobolDefResult { code = "", state = st }
   else if i == entry-idx then emit-cobol-all-defs defs arities st (i + 1) entry-idx
   else let d = list-at defs i
   in let r = emit-cobol-def-paragraph d arities st
   in let rest = emit-cobol-all-defs defs arities (r.state) (i + 1) entry-idx
   in CobolDefResult { code = r.code & rest.code, state = rest.state }

  emit-cobol-def-storage-all : List IRDef, List ATypeDef, Integer, Integer -> Text
  emit-cobol-def-storage-all (defs) (tds) (i) (entry-idx) =
   if i >= list-length defs then ""
   else if i == entry-idx then emit-cobol-def-storage-all defs tds (i + 1) entry-idx
   else emit-cobol-def-storage (list-at defs i) tds & emit-cobol-def-storage-all defs tds (i + 1) entry-idx

  cobol-is-effectful : CodexType -> Boolean
  cobol-is-effectful (ty) =
   when ty
    is EffectfulTy (effs) (sc) (ret) -> True
    is FunTy (p) (fnrow) (r) -> cobol-is-effectful r
    is ForAllTy (id) (body) -> cobol-is-effectful body
    is ForAllEff (id) (body) -> cobol-is-effectful body
    is LinearTy (body) -> cobol-is-effectful body
    is TypeApply (body) (tyarg) -> cobol-is-effectful body
    is otherwise -> False

  emit-cobol-entry : List IRDef, Integer, List ArityEntry, CobolState -> CobolDefResult
  emit-cobol-entry (defs) (entry-idx) (arities) (st) =
   if entry-idx < 0 then
    if list-length defs == 0 then CobolDefResult {
     code = "           DISPLAY \"All proofs verified at compile time.\"\n",
     state = st
    }
    else CobolDefResult { code = "", state = st }
   else let d = list-at defs entry-idx
   in let is-eff = cobol-is-effectful (d.type-val)
   in if is-eff then emit-cobol-act-entry (d.body) arities st
      else let res = emit-cobol-expr-to-var (d.body) arities st
      in CobolDefResult {
       code = res.code & "           DISPLAY " & res.var-name & "\n",
       state = res.state
      }

  emit-cobol-act-entry : IRExpr, List ArityEntry, CobolState -> CobolDefResult
  emit-cobol-act-entry (e) (arities) (st) =
   when e
    is IrAct (stmts) (ty) (sp) -> emit-cobol-act-stmts stmts arities st 0
    is otherwise -> let res = emit-cobol-expr-to-var e arities st
     in CobolDefResult { code = res.code, state = res.state }

  emit-cobol-act-stmts : List IRActStmt, List ArityEntry, CobolState, Integer -> CobolDefResult
  emit-cobol-act-stmts (stmts) (arities) (st) (i) =
   if i >= list-length stmts then CobolDefResult { code = "", state = st }
   else let s = list-at stmts i
   in let r = emit-cobol-act-stmt-top s arities st
   in let rest = emit-cobol-act-stmts stmts arities (r.state) (i + 1)
   in CobolDefResult { code = r.code & rest.code, state = rest.state }

  emit-cobol-act-stmt-top : IRActStmt, List ArityEntry, CobolState -> CobolDefResult
  emit-cobol-act-stmt-top (s) (arities) (st) =
   when s
    is IrDoExec (e) (sp) -> let res = emit-cobol-expr-to-var e arities st
     in CobolDefResult { code = res.code, state = res.state }
    is IrDoBind (name) (ty) (val) (sp) ->
     let res = emit-cobol-expr-to-var val arities st
     in let alloc = cobol-alloc-var (res.state) (cobol-name name)
     in let st2 = cobol-add-ws (alloc.state) (cobol-decl (st.tdefs) (alloc.name) ty)
     in CobolDefResult {
      code = res.code & "           MOVE " & res.var-name & " TO " & alloc.name & "\n",
      state = cobol-env-bind st2 name (alloc.name)
     }

  emit-cobol-ws-lines : List Text, Integer -> Text
  emit-cobol-ws-lines (lines) (i) =
   if i >= list-length lines then ""
   else list-at lines i & "\n" & emit-cobol-ws-lines lines (i + 1)

  emit-cobol-chapter : IRChapter, List ATypeDef -> Text
  emit-cobol-chapter (m) (type-defs) =
   let arities = build-arity-map (m.defs) 0 []
   in let program-id = cobol-name (m.name.value)
   in let entry-idx = cobol-find-entry (m.defs) 0
   in let st = cobol-set-tdefs cobol-initial-state type-defs
   in let defs-r = emit-cobol-all-defs (m.defs) arities st 0 entry-idx
   in let entry-r = emit-cobol-entry (m.defs) entry-idx arities (defs-r.state)
   in "       IDENTIFICATION DIVISION.\n" &
      "       PROGRAM-ID. " & program-id & ".\n\n" &
      "       DATA DIVISION.\n" &
      "       WORKING-STORAGE SECTION.\n" &
      emit-cobol-type-defs type-defs 0 &
      emit-cobol-def-storage-all (m.defs) type-defs 0 entry-idx & "       01 WS-RESULT         PIC S9(18).\n" &
      "       01 WS-TEMP           PIC S9(18).\n" &
      "       01 WS-STRPTR         PIC S9(18).\n" &
   "       01 WS-LIDX           PIC S9(18).\n" &
      "       01 WS-TEXT-RESULT.\n" &
      "         05 WS-TEXT-RESULT-L      PIC S9(18).\n" &
      "         05 WS-TEXT-RESULT-D      PIC X(256).\n" &
      emit-cobol-ws-lines (entry-r.state).working-storage 0 & "\n       PROCEDURE DIVISION.\n" &
      defs-r.code & "       MAIN-LOGIC.\n" &
      entry-r.code & "           STOP RUN.\n\n"

Page 1
