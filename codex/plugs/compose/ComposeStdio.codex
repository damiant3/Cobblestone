Chapter: ComposeStdio

Section: Body

  compose-stream-defs : IRChapter, List ArityEntry, Integer, Integer -> [Console] Nothing
  compose-stream-defs (m) (v) (i) (len) =
   if i >= len then print-uni ""
   else let h = __heap-save
   in let s = emit-compose-chapter-stream-def m v i
   in act
    print-uni s
    let r = __heap-restore h
    in compose-stream-defs m v (i + 1) len
   end

  plug-emit-ir-stream : Text -> [Console] Nothing
  plug-emit-ir-stream (ir-text) =
   let parsed = parse-ir-chapter ir-text
   in let m = parsed.chapter
   in let v = emit-compose-chapter-stream-env (parsed.chapter) (parsed.meta) (parsed.type-defs)
   in act
    print-uni (emit-compose-chapter-stream-head (parsed.chapter) (parsed.meta) (parsed.type-defs))
    compose-stream-defs m v 0 (list-length (m.defs))
    print-line-uni (emit-compose-chapter-stream-tail (parsed.chapter) (parsed.meta) (parsed.type-defs))
   end
