 We say:

Section: G01 -- Preamble and Compile Failure Reporter

  g01-head : List ShellCmd = [ScComment "On success, prints only a story. On failure, prints technical details.", ScComment "Phases: clean -> source -> CDX build -> sign -> canary -> jonquil ->", ScComment "        sem-equiv -> text fixed point -> CDX fixed point -> battery ->", ScComment "        oracles -> plugs -> generators -> decks -> app sweep.", ScBlank, ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScBlank, ScAssign "Repo" (SeRaw "(Resolve-Path (Join-Path $PSScriptRoot '..')).Path"), ScAssign "OutDir" (SeRaw "Join-Path $PSScriptRoot 'output'"), ScAssign "SeedCdx" (SeRaw "Join-Path $Repo 'seed\\Codex.cdx'"), ScAssign "SutCdx" (SeRaw "Join-Path $OutDir 'Sut.cdx'"), ScAssign "CodexSrc" (SeRaw "Join-Path $OutDir 'Codex.codex'"), ScAssign "Concat" (SeRaw "Join-Path $PSScriptRoot 'concat-codex-self.ps1'"), ScAssign "Compile" (SeRaw "Join-Path $PSScriptRoot 'compile.ps1'"), ScAssign "BuildLog" (SeRaw "Join-Path $OutDir 'build.log'"), ScBlank]

  g01-tail : List ShellCmd = [ScComment "A compile log ENDS in hundreds of `info CDX4010: bounds proven` lines, so", ScComment "its tail is the one slice guaranteed to say nothing about why a build", ScComment "failed. Show the lines that decide the build, and keep the log: on", ScComment "2026-07-28 a red cdx-build printed ten blank lines and deleted its only", ScComment "evidence, and reconstructing what it had already known cost an hour.", ScRaw "function Show-CompileFailure {", ScRaw "    param([string]$LogFile, [string]$Kept)", ScRaw "    $diag = @()", ScRaw "    if (Test-Path $LogFile) {", ScRaw "        $diag = @(Get-Content $LogFile | Where-Object { $_ -match 'error CDX|CODEGEN-ERRORS|CODEGEN-HALTED' } | Select-Object -First 15)", ScRaw "    }", ScRaw "    if ($diag.Count -gt 0) {", ScRaw "        $diag | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    } else {", ScRaw "        $tail = @()", ScRaw "        if (Test-Path $LogFile) { $tail = @(Get-Content $LogFile | Select-Object -Last 10) }", ScRaw "        if ($tail.Count -eq 0) {", ScRaw "            Write-Host '  the compile log is EMPTY: the compiler produced no output at all.'", ScRaw "            Write-Host '  That points at the VM or the machine (memory, a killed process)'", ScRaw "            Write-Host '  rather than at a rejected program, which would have left a'", ScRaw "            Write-Host '  diagnostic here. Re-run the same compile by hand before assuming'", ScRaw "            Write-Host '  the source is at fault.'", ScRaw "        } else {", ScRaw "            Write-Host '  no diagnostic in the log. Its last 10 lines:'", ScRaw "            $tail | ForEach-Object { Write-Host \"  $_\" }", ScRaw "        }", ScRaw "    }", ScRaw "    if ((Test-Path $LogFile) -and $Kept) {", ScRaw "        Copy-Item -Force $LogFile $Kept -ErrorAction SilentlyContinue", ScRaw "        Write-Host \"  full log kept at: $Kept\"", ScRaw "    }", ScRaw "}"]

  g01 : List ShellCmd = g01-head & g01b & g01-tail

Section: G01b -- The Internal Gate's Smart Coverage

 Lifted from the hand edit red made at main 15621 so the generator emits it
 again and the drift closes. Written one constructor per line rather than
 appended to G01's wall, which is the style
 `docs/Designs/Active/Build/ShellDslReadability.md` argues for: the block has a
 name that says what it is, and the emitted script is byte-identical either
 way, which `check-generated-scripts` proves rather than asserts.

 The body is ScRaw throughout and that is not laziness here. A PowerShell
 ordered hashtable literal, a generic HashSet construction and a `$(if ...)`
 subexpression are the cmdlet-and-pipeline residue the catalog measures at
 25.9 per cent, and no constructor above expresses them. It converts when that
 tier is designed, not before.

  g01b-notes : List ShellCmd =
    [ ScComment "Smart coverage for the internal gate. The CORE phases (clean, source-concat,"
    , ScComment "the pre-build guards, cdx-build, sign, canary, the text round-trip, the CDX"
    , ScComment "fixed point, test-bvt, oracles) always run: they are what certify the seed is"
    , ScComment "a byte-identical self-fixed-point that boots. The regression phases below run"
    , ScComment "only when a file they depend on changed in THIS workspace; skipped ones are"
    , ScComment "caught by the next full gate. Mapping, by what actually feeds each phase:"
    , ScComment "  jonquil / vm-differential  <- codex/compiler   (codegen and the DDC witness)"
    , ScComment "  plug-*                      <- codex/plugs or codex/compiler (codegen feeds plugs)"
    , ScComment "  gen-scripts / deck-headroom <- codex/build or build (the generators + their quire)"
    , ScComment "  app-sweep                   <- apps or codex/compiler (the compiler builds the apps)"
    ]

  g01b-detect : List ShellCmd =
    [ ScRaw "$SkipPhases = [System.Collections.Generic.HashSet[string]]::new()"
    , ScRaw "if ($Internal) {"
    , ScRaw "    $changed = @()"
    , ScRaw "    try { $changed = @(p4 opened 2>$null | ForEach-Object { (($_ -split '#')[0]) -replace '^//[^/]+/[^/]+/','' } | Where-Object { $_ }) } catch { }"
    , ScRaw "    $tCompiler = [bool]($changed | Where-Object { $_ -match '^codex/compiler/' })"
    , ScRaw "    $tPlugs    = [bool]($changed | Where-Object { $_ -match '^codex/plugs/' })"
    , ScRaw "    $tBuild    = [bool]($changed | Where-Object { $_ -match '^(codex/build/|build/)' })"
    , ScRaw "    $tApps     = [bool]($changed | Where-Object { $_ -match '^apps/' })"
    ]

  g01b-map : List ShellCmd =
    [ ScRaw "    $runPhase = [ordered]@{"
    , ScRaw "        'jonquil'         = $tCompiler"
    , ScRaw "        'plug-binary'     = ($tPlugs -or $tCompiler)"
    , ScRaw "        'cross-smoke'     = ($tPlugs -or $tCompiler)"
    , ScRaw "        'plug-smoke'      = ($tPlugs -or $tCompiler)"
    , ScRaw "        'gen-scripts'     = $tBuild"
    , ScRaw "        'vm-differential' = $tCompiler"
    , ScRaw "        'deck-headroom'   = $tBuild"
    , ScRaw "        'app-sweep'       = ($tApps -or $tCompiler)"
    , ScRaw "    }"
    ]

  g01b-report : List ShellCmd =
    [ ScRaw "    foreach ($k in $runPhase.Keys) { if (-not $runPhase[$k]) { [void]$SkipPhases.Add($k) } }"
    , ScRaw "    $ran = @($runPhase.Keys | Where-Object { $runPhase[$_] })"
    , ScRaw "    Write-Host ('  [internal gate] changed here: ' + $(if ($changed.Count) { ($changed | Sort-Object -Unique) -join ', ' } else { 'nothing opened' }))"
    , ScRaw "    Write-Host ('  [internal gate] core + BVT always, plus: ' + $(if ($ran.Count) { ($ran -join ', ') } else { '(nothing implicated)' }))"
    , ScRaw "    Write-Host ('  [internal gate] deferred to the next full gate: ' + $(if ($SkipPhases.Count) { (@($SkipPhases) | Sort-Object) -join ', ' } else { '(none)' }))"
    , ScRaw "}"
    , ScBlank
    ]

  g01b : List ShellCmd = g01b-notes & g01b-detect & g01b-map & g01b-report

Section: G02 -- Build Helpers

  g02 : List ShellCmd = [ScRaw "function Invoke-BuildCdx {", ScRaw "    param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$MemMB = 3072)", ScRaw "    $logFile = [System.IO.Path]::GetTempFileName()", ScRaw "    $tmpOut = Join-Path (Split-Path $Output) 'build_cdx_tmp.cdx'", ScRaw "    $stage0 = Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx'", ScRaw "    New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "    if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $Compile -Src $InputFile -Out $tmpOut -Log $logFile -Repl -MemMB $MemMB 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScRaw "    $ok = $LASTEXITCODE -eq 0", ScRaw "    if (-not $ok) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host 'FAIL: CDX build failed'", ScRaw "        Show-CompileFailure -LogFile $logFile -Kept (Join-Path (Split-Path $Output) 'build-cdx-fail.log')", ScRaw "    } else {", ScRaw "        Move-Item -Force $tmpOut $Output", ScRaw "        # compile.ps1 writes the symbol map to a <out>.map sidecar for every CDX", ScRaw "        # compile, -Repl included, since main 15088. Carry it with the binary it", ScRaw "        # describes, or it stays under the tmp name and the next build overwrites", ScRaw "        # the map of the compiler that just shipped.", ScRaw "        $tmpMap = [System.IO.Path]::ChangeExtension($tmpOut, '.map')", ScRaw "        if (Test-Path $tmpMap) {", ScRaw "            Move-Item -Force $tmpMap ([System.IO.Path]::ChangeExtension($Output, '.map'))", ScRaw "        }", ScRaw "    }", ScRaw "    Remove-Item -Force $logFile, $tmpOut, ([System.IO.Path]::ChangeExtension($tmpOut, '.map')) -ErrorAction SilentlyContinue", ScRaw "    return $ok", ScRaw "}", ScBlank, ScRaw "function Invoke-BuildText {", ScRaw "    param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$TextMemMB = 3072)", ScRaw "    $logFile = [System.IO.Path]::GetTempFileName()", ScRaw "    $tmpOut = Join-Path (Split-Path $Output) 'build_text_tmp.codex'", ScRaw "    $stage0 = Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx'", ScRaw "    New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "    if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }", ScRaw "", ScRaw "    $inputFile2 = [System.IO.Path]::GetTempFileName()", ScRaw "    $outputFile = [System.IO.Path]::GetTempFileName()", ScRaw "    $stderrFile = [System.IO.Path]::GetTempFileName()", ScRaw "    try {", ScRaw "        $srcBytes = Normalize-TripleNewlines ([System.IO.File]::ReadAllBytes($InputFile))", ScRaw "        $sb = [System.Text.StringBuilder]::new($srcBytes.Length + 100)", ScRaw "        [void]$sb.Append(\"TEXT`n\")", ScRaw "        [void]$sb.Append([System.Text.Encoding]::UTF8.GetString($srcBytes))", ScRaw "        [void]$sb.Append([char]4)", ScRaw "        [System.IO.File]::WriteAllText($inputFile2, $sb.ToString(), [System.Text.UTF8Encoding]::new($false))", ScRaw "", ScRaw "        $vmBin = Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'", ScRaw "        $vmArgs = @('-kernel', $stage0, '-input', $inputFile2, '-output', $outputFile, '-mem', \"$TextMemMB\", '-headless')", ScRaw "        $proc = Start-Process -FilePath $vmBin -ArgumentList $vmArgs -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile", ScRaw "        $proc.WaitForExit(600000)", ScRaw "        if (-not $proc.HasExited) {", ScRaw "            Stop-VmGraceful -ProcessId $proc.Id", ScRaw "            Write-Host ''; Write-Host 'FAIL: TEXT build timed out'; return $false", ScRaw "        }", ScRaw "", ScRaw "        if (-not (Test-Path $outputFile) -or (Get-Item $outputFile).Length -eq 0) {", ScRaw "            Write-Host ''; Write-Host 'FAIL: TEXT build produced no output'", ScRaw "            if (Test-Path $stderrFile) { Get-Content $stderrFile | Select-Object -Last 5 | ForEach-Object { Write-Host \"  $_\" } }", ScRaw "            return $false", ScRaw "        }", ScRaw "", ScRaw "        $raw = [System.IO.File]::ReadAllText($outputFile) -replace \"`r\", '' -replace \"^\\x01\", ''", ScRaw "        $lines = $raw -split \"`n\"", ScRaw "        $textLines = [System.Collections.Generic.List[string]]::new()", ScRaw "        $halted = $false", ScRaw "        foreach ($rl in $lines) {", ScRaw "            if ($rl.StartsWith('CODEGEN-HALTED') -or $rl.StartsWith('CODEGEN-ERRORS')) { $halted = $true; break }", ScRaw "            if (-not $rl.StartsWith('WD:') -and -not $rl.StartsWith('HEAP:') -and -not $rl.StartsWith('STACK:')) { $textLines.Add($rl) }", ScRaw "        }", ScRaw "        if ($halted) {", ScRaw "            Write-Host ''; Write-Host 'FAIL: TEXT build halted with errors'; return $false", ScRaw "        }", ScRaw "        [System.IO.File]::WriteAllText($Output, ($textLines -join \"`n\"))", ScRaw "        return $true", ScRaw "    } finally {", ScRaw "        Remove-Item -Force $inputFile2, $outputFile, $stderrFile -ErrorAction SilentlyContinue", ScRaw "    }", ScRaw "}", ScBlank, ScComment "The CDX header embeds the compiler's own SHA-256 over the binary", ScComment "content (text + padding + rodata) at bytes 8-39. This is the", ScComment "canonical content identity: the sign step signs exactly these bytes,", ScComment "and the header offsets, debug map, and deterministic signature are", ScComment "all derived from this content. Comparing it gives an apples-to-apples", ScComment "fixed-point test regardless of whether either side is signed.", ScRaw "function Get-CdxContentHash {", ScRaw "    param([string]$Path)", ScRaw "    $bytes = [System.IO.File]::ReadAllBytes($Path)", ScRaw "    return (($bytes[8..39]) | ForEach-Object { $_.ToString('x2') }) -join ''", ScRaw "}", ScBlank, ScComment "===================================================================", ScRaw "$buildTimer = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "$phaseTimings = [ordered]@{}", ScRaw "function Measure-Phase([string]$Name, [scriptblock]$Block) {", ScRaw "    if ($script:SkipPhases -and $script:SkipPhases.Contains($Name)) {", ScRaw "        Write-Host \"  phase '$Name' skipped (internal gate; not implicated by this change)\"", ScRaw "        return", ScRaw "    }", ScRaw "    $sw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "    & $Block", ScRaw "    $sw.Stop()", ScRaw "    $script:phaseTimings[$Name] = $sw.Elapsed", ScRaw "}"]

Section: G03 -- Clean and Source Concat

  g03 : List ShellCmd = [ScEcho (SeLit "The day is warm, yet there is a cooling breeze."), ScBlank, ScComment "-- clean", ScRaw "Measure-Phase 'clean' {", ScRaw "    $buildOut = Join-Path $Repo 'build-output'", ScRaw "    if (Test-Path $buildOut) { Remove-Item -Recurse -Force $buildOut }", ScRaw "    if (Test-Path $OutDir) {", ScRaw "        $stamp = (Get-Date).ToString('yyyyMMdd-HHmmss')", ScRaw "        $archive = Join-Path $PSScriptRoot \"output-$stamp\"", ScRaw "        Rename-Item $OutDir $archive", ScRaw "    }", ScRaw "    New-Item -ItemType Directory -Force -Path $OutDir | Out-Null", ScRaw "    Get-ChildItem $Repo -Recurse -Depth 3 -Include '*.bak','*.tmp','*.snap' -File -ErrorAction SilentlyContinue |", ScRaw "        Where-Object { $_.FullName -notmatch '\\\\\\.git\\\\' } |", ScRaw "        Remove-Item -Force -ErrorAction SilentlyContinue", ScRaw "}", ScBlank, ScComment "-- source", ScRaw "Measure-Phase 'source-concat' {", ScRaw "    if (-not (Test-Path -PathType Leaf $SeedCdx)) { Write-Host \"FAIL: $SeedCdx missing\"; exit 1 }", ScRaw "    if (-not (Test-Path -PathType Leaf $Concat))  { Write-Host \"FAIL: $Concat missing\"; exit 1 }", ScRaw "    & pwsh -NoProfile -File $Concat -CodexDir (Join-Path $Repo 'codex\\compiler') -OutFile $CodexSrc", ScRaw "    if (-not (Test-Path -PathType Leaf $CodexSrc)) { Write-Host 'FAIL: source concat produced no file'; exit 1 }", ScRaw "", ScRaw "    # Guard against untracked-source pollution. concat-codex-self globs", ScRaw "    # *.codex under codex/compiler/, so an untracked stray there (e.g.", ScRaw "    # leftover WIP) is silently baked into the seed, producing a binary that", ScRaw "    # does not match the depot source and is not reproducible. Scope the", ScRaw "    # check to codex/compiler/ ONLY -- plug build-output dirs (codex/plugs/*/", ScRaw "    # build-output/*.codex) hold legitimate untracked artifacts the concat", ScRaw "    # never reads. Match the reconcile ACTION (\" - ... add\"), not \"add\"", ScRaw "    # anywhere, so editing a tracked file like list-add.codex does not", ScRaw "    # false-trip. (A real stray, DeckCopy.codex, cost a detour 2026-05-29.)", ScRaw "    try {", ScRaw "        $stray = @(p4 reconcile -n codex/compiler/... 2>$null |", ScRaw "            Where-Object { $_ -match '\\.codex' -and $_ -match ' - .*\\badd\\b' })", ScRaw "        if ($stray.Count -gt 0) {", ScRaw "            Write-Host ''", ScRaw "            Write-Host 'FAIL: untracked .codex file(s) under codex/compiler/ would be baked into the seed:'", ScRaw "            $stray | ForEach-Object { Write-Host \"  $_\" }", ScRaw "            Write-Host '  p4 add them (so the seed is reproducible) or remove them, then rebuild.'", ScRaw "            exit 1", ScRaw "        }", ScRaw "    } catch {", ScRaw "        Write-Host '  (note: p4 reconcile unavailable; skipped untracked-source guard)'", ScRaw "    }", ScRaw "}", ScBlank, ScComment "Check if source constants match the seed -- warn if they differ.", ScAssign "chkConst" (SeRaw "Join-Path $PSScriptRoot 'check-constants.ps1'"), ScRaw "if (Test-Path $chkConst) {", ScRaw "    & pwsh -NoProfile -File $chkConst 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "}"]

Section: G04 -- The Pre-Build Guards

  g04 : List ShellCmd = [ScComment "The boot cap-bit table (compiler) and the verified-load cap-bit table (OS", ScComment "loader) were two hand-written expansions of one name->bit map, and a drift", ScComment "granted a binary different authority by which door it entered. They are one", ScComment "table now -- codex/foreword/core/Capability.codex, cited by both quires --", ScComment "so check-cap-tables.ps1 had nothing left to compare and is deleted with the", ScComment "in-compiler guard (check-cap-vocab-coherent) that had the same fate.", ScBlank, ScComment "The foreword `effect <Name> where` declarations are the one part of the", ScComment "capability model that cannot be derived from the shared table: a declaration", ScComment "is a syntax form, not data, and no table can emit one. So this guard is", ScComment "permanent, not interim. Nothing in a compile can do its job either -- an", ScComment "arbitrary user compile does not include all the foreword effect modules, so", ScComment "an in-compiler check cannot see them all. The intended asymmetry is listed", ScComment "in the script.", ScAssign "chkEffVocab" (SeRaw "Join-Path $PSScriptRoot 'check-effect-vocab.ps1'"), ScRaw "if (Test-Path $chkEffVocab) {", ScRaw "    & pwsh -NoProfile -File $chkEffVocab 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: foreword effects and capability vocabulary have drifted -- add the counterpart or record the exception in check-effect-vocab.ps1'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "A builtin name used to live in three hand-maintained lists across two", ScComment "quires, and check-builtin-tables.ps1 reconciled them here. It carries one", ScComment "row now (codex/compiler/Types/Builtins.codex: name, type, emitter), and", ScComment "resolve / route / emit are all projections of it, so there is nothing left", ScComment "for a build-time guard to compare. Script and check are both deleted.", ScBlank, ScComment "The gate compiles what is ON DISK, so the workspace has to be what the", ScComment "agent thinks it is before any of the rest of this means anything.", ScComment "", ScComment "Two failures put a wrong workspace under a green gate, both of them", ScComment "documented in the agent Perforce process notes since 2026-07-13, and both of", ScComment "them hit again on 2026-07-21 by an agent who had read neither. That is the", ScComment "point: this check does not exist because the traps are subtle, it exists", ScComment "because DOCUMENTING them did not stop them. `p4 unshelve` leaves files at the", ScComment "revision they were shelved at and does not schedule the resolve, so `p4", ScComment "resolve -n` says \"nothing to resolve\" and means it while your copy is missing", ScComment "every revision submitted since; and an add whose file is already on disk is", ScComment "refused with \"Can't clobber writable file\" and silently dropped from the", ScComment "changelist, which is how four tests were lost while they were named as", ScComment "pinned.", ScComment "", ScComment "Neither is a conflict, a stale revision the eye can see, or an unresolved", ScComment "file, so nothing in the normal flow reports either one. Running the check by", ScComment "hand was the plan and the plan failed twice; the gate runs it now.", ScComment "", ScComment "Skipped without Perforce (fresh clone, public mirror) -- there is no", ScComment "workspace to be wrong.", ScAssign "chkP4" (SeRaw "Join-Path $PSScriptRoot 'p4-stale-check.ps1'"), ScRaw "if ((Test-Path $chkP4) -and (Get-Command p4 -ErrorAction SilentlyContinue) -and", ScRaw "    (Test-Path (Join-Path $Repo '.p4config'))) {", ScRaw "    & pwsh -NoProfile -File $chkP4 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: the workspace does not match the depot -- the gate would compile the wrong source'", ScRaw "        Write-Host '      Fix it with the two commands the check printed. Do not resolve with -ay.'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "A sidecar is resolved next to its .codex, so one in the wrong directory", ScComment "configures nothing while reading like a decision -- diagnostic-boot's", ScComment "\"blocks waiting for keyboard input\" skip lived a directory above the test,", ScComment "applied to nothing, and was quoted as a real skip in ExaminersAssay for", ScComment "months. Nothing else can see this: a sidecar that names no test is exactly", ScComment "the file no compile and no battery ever opens.", ScAssign "chkSidecars" (SeRaw "Join-Path $PSScriptRoot 'check-sidecars.ps1'"), ScRaw "if (Test-Path $chkSidecars) {", ScRaw "    & pwsh -NoProfile -File $chkSidecars 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: a test sidecar names no test'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "The diagnostic catalogue (CdxCodes.codex) is read by nobody in the compiler", ScComment "-- cdx-lookup has no caller and whole-program DCE prunes the whole table --", ScComment "so a code raised with no row, or a row whose Name drifted from its constant,", ScComment "is invisible by construction. This reads the catalogue and the raise sites", ScComment "and fails the build when they disagree. It found 13 undocumented codes on", ScComment "its first run.", ScAssign "chkCdx" (SeRaw "Join-Path $PSScriptRoot 'check-cdx-registry.ps1'"), ScRaw "if (Test-Path $chkCdx) {", ScRaw "    & pwsh -NoProfile -File $chkCdx 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: the diagnostic catalogue disagrees with the code that raises it'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "The fact store's partition type GUID is written by three producers -- the", ScComment "reader in Foreword chapter Gpt, the IMG plug, and build/build-img.ps1 -- and", ScComment "a disagreement is silent: the stick carries one type, the guest looks for", ScComment "another, and the store refuses every write while reporting nothing.", ScAssign "chkFactsGuid" (SeRaw "Join-Path $PSScriptRoot 'check-facts-guid.ps1'"), ScRaw "if (Test-Path $chkFactsGuid) {", ScRaw "    & pwsh -NoProfile -File $chkFactsGuid 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: the fact-store partition type GUID disagrees across writers'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "Counts in the docs go stale, and \"never carry a count forward\" is written in", ScComment "three places and enforced in none. check-doc-counts.ps1 is the reader; on a", ScComment "clean tree it found six false claims, one of them wrong by thirty tests.", ScComment "", ScComment "OPT-IN, and deliberately so. Turning it on for everyone is a decision about", ScComment "everyone's gate. It is on when either is true:", ScComment "  $env:CODEX_CHECK_DOC_COUNTS = '1'      per run", ScComment "  a file named .doc-counts in the repo root   per agent, per workspace", ScComment "The second is what makes an A/B arm: one workspace carries the file, another", ScComment "does not, and the difference is visible in what comes out.", ScAssign "chkCounts" (SeRaw "Join-Path $PSScriptRoot 'check-doc-counts.ps1'"), ScAssign "countsOn" (SeRaw "($env:CODEX_CHECK_DOC_COUNTS -eq '1') -or (Test-Path (Join-Path $Repo '.doc-counts'))"), ScRaw "if ($countsOn -and (Test-Path $chkCounts)) {", ScRaw "    & pwsh -NoProfile -File $chkCounts -Quiet 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: a doc states a count the tree no longer produces'", ScRaw "        Write-Host '      Run build/check-doc-counts.ps1 for the per-claim table.'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "IRTextParser calls itself the inverse of IRTextEmitter and is not: the", ScComment "emitter can write forms the parser reads as a plausible DEFAULT rather than", ScComment "an error. x86-64 never crosses this wire, so no x86 test and no fixed point", ScComment "can fail on a divergence -- ir-expr-type on IrNegate answered -(-2.5) as 1.7", ScComment "on ARM64 and RISC-V for exactly that reason. Three known holes are recorded", ScComment "in build/plug-wire-baseline.txt; this fails the build on a fourth.", ScAssign "chkWire" (SeRaw "Join-Path $PSScriptRoot 'check-plug-types.ps1'"), ScRaw "if (Test-Path $chkWire) {", ScRaw "    & pwsh -NoProfile -File $chkWire 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host 'FAIL: the IR text wire lost a form between emitter and plug parser'", ScRaw "        exit 1", ScRaw "    }", ScRaw "}"]

Section: G05 -- CDX Build and Sign

  g05 : List ShellCmd = [ScEcho (SeLit "The latest in a series of personal crises seems insurmountable."), ScEcho (SeLit "You are being pulled apart in all directions."), ScEcho (SeLit ""), ScBlank, ScComment "-- CDX build", ScRaw "Measure-Phase 'cdx-build' {", ScRaw "    if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SeedCdx -Output $SutCdx)) { exit 1 }", ScRaw "}", ScBlank, ScEcho (SeLit "Yet this afternoon walk in the countryside slowly brings relaxation"), ScEcho (SeLit "to your harried mind. The soil and strain of modern high-tech living"), ScEcho (SeLit "begins to wash off in layers."), ScEcho (SeLit ""), ScBlank, ScComment "-- sign", ScCopy (SeVar "SutCdx") (SeRaw "(Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx')"), ScBlank, ScRaw "Measure-Phase 'sign' {", ScAssign "SigningKey" (SeLit "D:\\Projects\\signing.key"), ScRaw "if (Test-Path -PathType Leaf $SigningKey) {", ScRaw "    $compileScript = Join-Path $PSScriptRoot 'compile.ps1'", ScRaw "    $runScript = Join-Path $PSScriptRoot 'test-run.ps1'", ScRaw "    $cdxRaw = [System.IO.File]::ReadAllBytes($SutCdx)", ScRaw "    $keyBytes = [System.IO.File]::ReadAllBytes($SigningKey)", ScRaw "    $hashBytes = $cdxRaw[8..39]", ScRaw "    $keyList = ($keyBytes | ForEach-Object { $_.ToString() }) -join ', '", ScRaw "    $hashList = ($hashBytes | ForEach-Object { $_.ToString() }) -join ', '", ScRaw "    $signSrc = Join-Path $OutDir 'cdx-sign-inline.codex'", ScRaw "    $signSrcText = @\"", ScRaw "Chapter: CdxSignInline", ScRaw "  cites Foreword chapter Console", ScRaw "  cites Foreword chapter Ed25519", ScRaw "  cites Foreword chapter Sha512", ScRaw "Section: Helpers", ScRaw "  bytes-to-csv : List Integer, Integer, Integer, Text -> Text", ScRaw "  bytes-to-csv (bs) (i) (len) (acc) =", ScRaw "    if i >= len then acc", ScRaw "    else let sep = if i == 0 then \"\" else \",\"", ScRaw "    in bytes-to-csv bs (i + 1) len (acc & sep & show (list-at bs i))", ScRaw "Section: Body", ScRaw "  opening : [Console] Nothing = act", ScRaw "    let key = [$keyList]", ScRaw "    in let hash = [$hashList]", ScRaw "    in let pub = ed25519-public-key key", ScRaw "    in let sig = ed25519-sign key pub hash", ScRaw "    in act", ScRaw "      print-line-uni (bytes-to-csv pub 0 32 \"\")", ScRaw "      print-line-uni (bytes-to-csv sig 0 64 \"\")", ScRaw "    end", ScRaw "  end", ScRaw "\"@", ScRaw "    [System.IO.File]::WriteAllText($signSrc, $signSrcText)", ScRaw "    $signCdx = Join-Path $OutDir 'cdx-sign.cdx'", ScRaw "    $signLog = Join-Path $OutDir 'cdx-sign.log'", ScRaw "    $signOut = Join-Path $OutDir 'cdx-sign.out'", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $compileScript -Src $signSrc -Out $signCdx -Log $signLog 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScRaw "    if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: sign tool compile failed'; Get-Content $signLog -TotalCount 10 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }; exit 1 }", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $runScript -Kernel $signCdx -OutFile $signOut 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScRaw "    if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: sign tool run failed'; exit 1 }", ScRaw "    $signRaw = [System.IO.File]::ReadAllText($signOut)", ScRaw "    $signClean = $signRaw -replace '[^\\x20-\\x7E\\r\\n]', ''", ScRaw "    $signLines = $signClean -split \"`n\" | Where-Object { $_.Trim() -match '^\\d' }", ScRaw "    $pubBytes = $signLines[0].Split(',') | Where-Object { $_.Trim() -ne '' } | ForEach-Object { [byte]([int]$_.Trim()) }", ScRaw "    $sigBytes = $signLines[1].Split(',') | Where-Object { $_.Trim() -ne '' } | ForEach-Object { [byte]([int]$_.Trim()) }", ScRaw "    if ($pubBytes.Count -ne 32 -or $sigBytes.Count -ne 64) { Write-Host \"FAIL: bad sign output (pub=$($pubBytes.Count) sig=$($sigBytes.Count))\"; exit 1 }", ScRaw "    for ($i = 0; $i -lt 32; $i++) { $cdxRaw[40 + $i] = $pubBytes[$i] }", ScRaw "    for ($i = 0; $i -lt 64; $i++) { $cdxRaw[72 + $i] = $sigBytes[$i] }", ScRaw "    [System.IO.File]::WriteAllBytes($SutCdx, $cdxRaw)", ScRaw "}", ScRaw "}"]

Section: G06 -- Canary and Jonquil

  g06 : List ShellCmd = [ScEcho (SeLit "That willow tree near the stream looks comfortable and inviting."), ScBlank, ScComment "-- canary", ScRaw "Measure-Phase 'canary' {", ScRaw "$canarySrc      = Join-Path $Repo 'codex\\test\\factorial.codex'", ScRaw "$canaryExpected = Join-Path $Repo 'codex\\test\\factorial.expected'", ScRaw "$canaryCdx      = Join-Path $OutDir 'canary-factorial.cdx'", ScRaw "$canaryLog      = Join-Path $OutDir 'canary-compile.log'", ScRaw "$canaryOut      = Join-Path $OutDir 'canary-run.out'", ScRaw "if (-not (Test-Path -PathType Leaf $canarySrc))      { Write-Host \"FAIL: $canarySrc missing\"; exit 1 }", ScRaw "if (-not (Test-Path -PathType Leaf $canaryExpected)) { Write-Host \"FAIL: $canaryExpected missing\"; exit 1 }", ScRaw "$compileScript = Join-Path $PSScriptRoot 'compile.ps1'", ScRaw "$runScript     = Join-Path $PSScriptRoot 'test-run.ps1'", ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $compileScript -Src $canarySrc -Out $canaryCdx -Log $canaryLog 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScRaw "if ($LASTEXITCODE -ne 0) {", ScRaw "    Write-Host 'FAIL: canary compile -- SUT cannot compile factorial.codex'", ScRaw "    Get-Content $canaryLog -TotalCount 20 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    exit 1", ScRaw "}", ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $runScript -Kernel $canaryCdx -OutFile $canaryOut 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScRaw "$expectedBytes = if (Test-Path $canaryExpected) { ([System.IO.File]::ReadAllText($canaryExpected) -replace \"`r\",'').TrimEnd() } else { '' }", ScRaw "$actualBytes   = if (Test-Path $canaryOut)      { ([System.IO.File]::ReadAllText($canaryOut) -replace \"`r\",'').TrimEnd() }    else { '' }", ScRaw "if ($expectedBytes -ne $actualBytes) {", ScRaw "    Write-Host 'FAIL: canary output mismatch'", ScRaw "    Write-Host \"  expected: $($expectedBytes.Trim())\"", ScRaw "    Write-Host \"  got:      $($actualBytes.Trim())\"", ScRaw "    exit 1", ScRaw "}", ScRaw "}", ScBlank, ScEcho (SeLit "You settle beneath it and the buzz of dragonflies and the whisper"), ScEcho (SeLit "of the willow's swaying branches bring a deep peace."), ScEcho (SeLit ""), ScBlank, ScComment "-- the jonquil: IR quine visibility check. The trusting-trust defense holds", ScComment "because a payload that survives the diverse rebuild must reach the readable", ScComment "IR and is therefore visible as text. This enforces that: emit the certified", ScComment "compiler's own IR and fail if any def re-emits itself (the DDC-QUINE-ARM", ScComment "construction). Tripwire only, not the DDC witness; see build/jonquil.ps1.", ScRaw "Measure-Phase 'jonquil' {", ScRaw "    $jonquilScript = Join-Path $PSScriptRoot 'jonquil.ps1'", ScRaw "    & pwsh -NoProfile -File $jonquilScript -Kernel $SutCdx -Src $CodexSrc -WorkDir (Join-Path $OutDir 'quine-check')", ScRaw "    if ($LASTEXITCODE -ne 0) { exit 1 }", ScRaw "}"]

Section: G07 -- Size Check and Text Stages

  g07 : List ShellCmd = [ScComment "-- size sanity check", ScAssign "seedSize" (SeProperty (SeRaw "(Get-Item $SeedCdx)") "Length"), ScAssign "sutSize" (SeProperty (SeRaw "(Get-Item $SutCdx)") "Length"), ScRaw "$drift = [math]::Abs($sutSize - $seedSize)", ScRaw "$maxDrift = [int]($seedSize * 0.05)", ScRaw "if ($drift -gt $maxDrift) {", ScRaw "    Write-Host \"FAIL: SUT size drifted too far from seed\"", ScRaw "    Write-Host \"  seed: $seedSize bytes  SUT: $sutSize bytes  drift: $drift (max $maxDrift)\"", ScRaw "    exit 1", ScRaw "}", ScBlank, ScAssign "textStage1" (SeRaw "Join-Path $OutDir 'stage1.codex'"), ScAssign "textStage2" (SeRaw "Join-Path $OutDir 'stage2.codex'"), ScBlank, ScEcho (SeLit "Searching inward for tranquility and happiness, you close your eyes."), ScRaw "Measure-Phase 'text-stage1' {", ScRaw "    if (-not (Invoke-BuildText -InputFile $CodexSrc -Kernel $SutCdx -Output $textStage1)) { exit 1 }", ScRaw "}", ScBlank, ScRaw "Measure-Phase 'sem-equiv' {", ScRaw "    $semEquivScript = Join-Path $PSScriptRoot 'compare-codex-semantic.ps1'", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host 'FAIL: semantic equivalence -- stage1 does not match source'", ScRaw "        & pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScEcho (SeLit "A high-pitched cascading sound like crystal wind-chimes impinges"), ScEcho (SeLit "on your floating awareness."), ScEcho (SeLit ""), ScBlank, ScRaw "Measure-Phase 'text-stage2' {", ScRaw "    if (-not (Invoke-BuildText -InputFile $textStage1 -Kernel $SutCdx -Output $textStage2)) { exit 1 }", ScRaw "}", ScBlank, ScRaw "Measure-Phase 'text-fixedpoint' {", ScRaw "    $th1 = (Get-FileHash -Algorithm SHA256 $textStage1).Hash", ScRaw "    $th2 = (Get-FileHash -Algorithm SHA256 $textStage2).Hash", ScRaw "    if ($th1 -ne $th2) {", ScRaw "        Write-Host 'FAIL: text round-trip -- stage1 !== stage2'", ScRaw "        Write-Host \"  stage1: $((Get-Item $textStage1).Length) bytes  $th1\"", ScRaw "        Write-Host \"  stage2: $((Get-Item $textStage2).Length) bytes  $th2\"", ScRaw "        exit 1", ScRaw "    }", ScRaw "}"]

Section: G08 -- CDX Stages and BVT

  g08 : List ShellCmd = [ScEcho (SeLit "As you open your eyes, you see a shimmering blueness rise from the ground."), ScEcho (SeLit ""), ScBlank, ScAssign "cdxStage1" (SeRaw "Join-Path $OutDir 'stage1.cdx'"), ScAssign "cdxStage2" (SeRaw "Join-Path $OutDir 'stage2.cdx'"), ScAssign "testKernel" (SeVar "cdxStage1"), ScBlank, ScEcho (SeLit "It is difficult to look at the blueness directly. The sound seems"), ScEcho (SeLit "to be emanating from this glowing portal."), ScRaw "Measure-Phase 'cdx-stage1' {", ScRaw "    if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SutCdx -Output $cdxStage1)) { exit 1 }", ScRaw "}", ScBlank, ScRaw "Measure-Phase 'cdx-fixedpoint' {", ScRaw "    $sutHash = Get-CdxContentHash $SutCdx", ScRaw "    $ch1 = Get-CdxContentHash $cdxStage1", ScRaw "    if ($sutHash -eq $ch1) {", ScRaw "        Write-Host '(SUT === stage1 -- hard fixed point in one pass)'", ScRaw "    } else {", ScRaw "        if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $cdxStage1 -Output $cdxStage2)) { exit 1 }", ScRaw "        $ch2 = Get-CdxContentHash $cdxStage2", ScRaw "        if ($ch1 -ne $ch2) {", ScRaw "            Write-Host 'FAIL: CDX fixed point -- stage1 !== stage2'", ScRaw "            Write-Host \"  stage1: $((Get-Item $cdxStage1).Length) bytes  $ch1\"", ScRaw "            Write-Host \"  stage2: $((Get-Item $cdxStage2).Length) bytes  $ch2\"", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScEcho (SeLit "Light seems to bend and distort around it, while the sound waves"), ScEcho (SeLit "become so intense, they appear to become visible."), ScEcho (SeLit ""), ScBlank, ScCopy (SeVar "cdxStage1") (SeRaw "(Join-Path $OutDir 'NewSeed.cdx')"), ScBlank, ScEcho (SeLit "The portal hangs there for a moment; then with the rush of an"), ScEcho (SeLit "imploding vacuum, it sinks into the ground."), ScBlank, ScRaw "Measure-Phase 'test-bvt' {", ScRaw "    $bvtScript = Join-Path $PSScriptRoot 'bvt.ps1'", ScRaw "    $testOut = Join-Path $OutDir 'test-results.txt'", ScRaw "    & pwsh -NoProfile -File $bvtScript -CodexCdx $testKernel -Jobs 8 > $testOut 2>&1", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host 'FAIL: BVT'", ScRaw "        Get-Content $testOut | ForEach-Object { Write-Host \"  $_\" }", ScRaw "        exit 1", ScRaw "    }", ScRaw "}"]

Section: G09 -- Oracles, Plugs and Cross-Arch

  g09 : List ShellCmd = [ScComment "-- the differential oracles: operator correctness against the HOST. The", ScComment "fixed point cannot see an operator that is uniformly wrong, because it", ScComment "only requires the compiler to agree with itself -- which is how Real", ScComment "ordering shipped inverted for three months. Damian's call 2026-07-27:", ScComment "the pin goes wherever it helps, and the gate is where every codegen", ScComment "change passes. Cost measured at 2s + 1s against a 170s gate. The", ScComment "collections stay author-owned (reek: oracle-scalar, blu: oracle-vector", ScComment "and oracle-cce -- cce joined 2026-07-28 once G1 closed and every gap", ScComment "carried a verdict, 1485/1516 with 31 in ruled gaps, 0 unexplained);", ScComment "this leg only runs them against the just-proven fixed point.", ScRaw "Measure-Phase 'oracles' {", ScRaw "    foreach ($o in 'oracle-scalar', 'oracle-vector', 'oracle-cce') {", ScRaw "        $olog = Join-Path $OutDir \"$o-results.txt\"", ScRaw "        & pwsh -NoProfile -File (Join-Path $PSScriptRoot \"$o.ps1\") -Kernel $testKernel > $olog 2>&1", ScRaw "        if ($LASTEXITCODE -ne 0) {", ScRaw "            Write-Host ''", ScRaw "            Write-Host \"FAIL: $o disagrees with the host\"", ScRaw "            Get-Content $olog | Select-Object -Last 20 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- binary backend plugs: must build clean with the just-proven compiler.", ScComment "Native code-emitting backends only (riscv/arm64/t3isa/elf/pe/img). The", ScComment "transpiler/text plugs are secondary outputs and are NOT gated here. Plug", ScComment "CDX is untracked build-output, so without this gate a compiler tightening", ScComment "silently dark-ships every backend until someone rebuilds one by hand.", ScComment "", ScComment "t3isa emits balanced-ternary words for a 27-trit machine and belongs here", ScComment "for the same reason as the rest. Only its BUILD is gated: its own gate", ScComment "needs an external emulator that lives on one machine, and nothing here", ScComment "reaches that.", ScRaw "Measure-Phase 'plug-binary' {", ScRaw "    Copy-Item -Force $SutCdx (Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx')", ScRaw "    $binaryBackends = @('riscv','arm64','t3isa','elf','pe','img')", ScRaw "    $plugFail = @()", ScRaw "    foreach ($bp in $binaryBackends) {", ScRaw "        $bs = Join-Path $Repo \"codex\\plugs\\$bp\\build.ps1\"", ScRaw "        if (-not (Test-Path $bs)) { $plugFail += \"$bp(no-build.ps1)\"; continue }", ScRaw "        & pwsh -NoProfile -File $bs *> $null", ScRaw "        $cdx = Join-Path $Repo \"codex\\plugs\\$bp\\build-output\\$bp-plug.cdx\"", ScRaw "        $blog = Join-Path $Repo \"codex\\plugs\\$bp\\build-output\\build.log\"", ScRaw "        $bad = -not (Test-Path $cdx)", ScRaw "        if ((Test-Path $blog) -and (Select-String -Path $blog -Pattern 'CODEGEN-ERRORS|error CDX' -Quiet)) { $bad = $true }", ScRaw "        if ($bad) { $plugFail += $bp }", ScRaw "    }", ScRaw "    if ($plugFail.Count -gt 0) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host \"FAIL: binary plug build -- $($plugFail -join ', ')\"", ScRaw "        foreach ($bp in $plugFail) {", ScRaw "            $blog = Join-Path $Repo \"codex\\plugs\\$bp\\build-output\\build.log\"", ScRaw "            if (Test-Path $blog) { Get-Content $blog | Select-String 'error CDX|CODEGEN-ERRORS' | Select-Object -First 3 | ForEach-Object { Write-Host \"  ${bp}: $($_.Line.Trim())\" } }", ScRaw "        }", ScRaw "        exit 1", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- cross-arch execution: the binary leg above proves the arm64 and riscv", ScComment "plugs BUILD, and nothing ran a byte of what they emit. That is how CL 8221", ScComment "put a PSCI call in every ARM64 program's __start, killed the whole ARM64", ScComment "lane on the committed Renode board, and stayed green here for weeks while", ScComment "238 tests failed silently. One program per architecture,", ScComment "booted for real. Not the battery -- build/test-cross-batch.ps1 is that, and", ScComment "it stays out-of-band.", ScRaw "Measure-Phase 'cross-smoke' {", ScRaw "    $chkCross = Join-Path $PSScriptRoot 'check-cross-smoke.ps1'", ScRaw "    if (Test-Path $chkCross) {", ScRaw "        & pwsh -NoProfile -File $chkCross 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "        if ($LASTEXITCODE -ne 0) {", ScRaw "            Write-Host 'FAIL: a cross-arch backend stopped executing correctly'", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- transpiler plug smoke: a representative subset must RUN end-to-end", ScComment "(SUT IR -> framed TCP wire -> plug VM -> non-empty target text). The binary", ScComment "leg above proves plugs BUILD; this proves the wire protocol and plug runtime", ScComment "stay alive -- the class that dark-shipped when 20 run.ps1 senders went", ScComment "unframed (CL 7372). Missing plug CDX builds once and caches; a failing run", ScComment "gets one rebuild-and-retry (stale binary after IR drift), then fails loudly.", ScRaw "Measure-Phase 'plug-smoke' {", ScRaw "    $smokePlugs = @('typescript', 'python', 'rust', 'ptx')", ScRaw "    $smokeSrcs = @('hello', 'record')", ScRaw "    $smokeDir = Join-Path $OutDir 'plug-smoke'", ScRaw "    New-Item -ItemType Directory -Force -Path $smokeDir | Out-Null", ScRaw "    # A plug binary is only as fresh as the last hand run of its build.ps1, and", ScRaw "    # 37 of 38 faulted on a record after common/IRTextParser.codex moved while", ScRaw "    # this phase rebuilt only a MISSING binary (plugs-backlog 1.11). Rebuild", ScRaw "    # when the CDX is older than any source the bundle is made from.", ScRaw "    $smokeDeps = @(Get-ChildItem (Join-Path $Repo 'codex\\plugs\\common') -Filter *.codex)", ScRaw "    foreach ($decl in @('codex\\compiler\\Core\\Name.codex', 'codex\\compiler\\Core\\SourceText.codex', 'codex\\compiler\\Types\\CodexType.codex', 'codex\\compiler\\Ast\\AstNodes.codex', 'codex\\compiler\\IR\\IRChapter.codex')) {", ScRaw "        $smokeDeps += Get-Item (Join-Path $Repo $decl)", ScRaw "    }", ScRaw "    $smokeFail = @()", ScRaw "    foreach ($sp in $smokePlugs) {", ScRaw "        $spBuild = Join-Path $Repo \"codex\\plugs\\$sp\\build.ps1\"", ScRaw "        $spCdx   = Join-Path $Repo \"codex\\plugs\\$sp\\build-output\\$sp-plug.cdx\"", ScRaw "        $spLog   = Join-Path $smokeDir \"$sp-smoke.log\"", ScRaw "        $spNewest = ($smokeDeps + @(Get-ChildItem (Join-Path $Repo \"codex\\plugs\\$sp\") -Filter *.codex) | ForEach-Object { $_.LastWriteTimeUtc } | Sort-Object -Descending | Select-Object -First 1)", ScRaw "        if (-not (Test-Path $spCdx) -or (Get-Item $spCdx).LastWriteTimeUtc -lt $spNewest) { & pwsh -NoProfile -File $spBuild *> $spLog }", ScRaw "        foreach ($si in $smokeSrcs) {", ScRaw "            $smokeSrc = Join-Path $Repo \"codex\\plugs\\test-input\\$si.codex\"", ScRaw "            $spOut = Join-Path $smokeDir \"$sp-$si.out\"", ScRaw "            $ok = $false", ScRaw "            foreach ($attempt in 1..2) {", ScRaw "                Remove-Item -Force $spOut -ErrorAction SilentlyContinue", ScRaw "                & pwsh -NoProfile -File (Join-Path $Repo \"codex\\plugs\\$sp\\run.ps1\") -Src $smokeSrc -Out $spOut *>> $spLog", ScRaw "                if ($LASTEXITCODE -eq 0 -and (Test-Path $spOut) -and (Get-Item $spOut).Length -gt 0) { $ok = $true; break }", ScRaw "                if ($attempt -eq 1) { & pwsh -NoProfile -File $spBuild *>> $spLog }", ScRaw "            }", ScRaw "            if (-not $ok) { $smokeFail += \"$sp/$si\" }", ScRaw "        }", ScRaw "    }", ScRaw "    if ($smokeFail.Count -gt 0) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host \"FAIL: plug smoke -- $($smokeFail -join ', ') (run.ps1 nonzero or empty output)\"", ScRaw "        foreach ($sp in $smokeFail) {", ScRaw "            $spLog = Join-Path $smokeDir \"$sp-smoke.log\"", ScRaw "            if (Test-Path $spLog) { Get-Content $spLog | Select-Object -Last 5 | ForEach-Object { Write-Host \"  ${sp}: $_\" } }", ScRaw "        }", ScRaw "        exit 1", ScRaw "    }", ScRaw "}"]

Section: G10 -- Generators, Decks, App Sweep and Closing

  g10 : List ShellCmd = [ScComment "-- the Shell DSL generators: codex/build/*Script.codex compile with the", ScComment "just-proven compiler and emit the scripts the build itself runs on. Nothing", ScComment "observed that. The deck-short miscompile emitted CORRUPT generator output", ScComment "from a clean compile, and it sat silent because no gate ever compared a", ScComment "generator against the script beside it; the corruption was found by eye.", ScComment "This leg is that comparison, and it also catches the quieter half: an", ScComment "emitter answers `# <unknown-cmd>` for a node it does not handle instead of", ScComment "failing, so a node added to ShellTypes and forgotten in BashEmit produces a", ScComment "script that is wrong rather than missing.", ScComment "", ScComment "26 of 42 generators were already behind their shipped script when this", ScComment "became a gate, and porting each drift back by hand is a campaign. Those are", ScComment "recorded in build/generated-scripts-baseline.txt and do not fail the build.", ScComment "A compile failure, an empty emission, an unhandled-node stub, and any drift", ScComment "that is not in that file do. Cost measured 2026-08-06: 61s.", ScRaw "Measure-Phase 'gen-scripts' {", ScRaw "    $chkGen = Join-Path $PSScriptRoot 'check-generated-scripts.ps1'", ScRaw "    if (Test-Path $chkGen) {", ScRaw "        & pwsh -NoProfile -File $chkGen 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "        if ($LASTEXITCODE -ne 0) {", ScRaw "            Write-Host 'FAIL: a Shell DSL generator is broken or has newly drifted from the script it emits'", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- two independent VM hosts, one source, compared byte for byte. This is a", ScComment "TRUST check, not a correctness one: QEMU is a third-party binary whose", ScComment "Authenticode signature cannot discriminate a good build from a hostile one,", ScComment "because the publisher's signing certificate expired 2023-09-12 and the", ScComment "binaries are still signed with it. Verification returns the same failure in", ScComment "both worlds and there is nothing left to revoke, so the signature carries no", ScComment "information. Two hosts that share no code agreeing on the output does carry", ScComment "some. It skips silently on a machine with only one host, which is the normal", ScComment "case away from this one. 6s.", ScRaw "Measure-Phase 'vm-differential' {", ScRaw "    $chkDiff = Join-Path $PSScriptRoot 'check-vm-differential.ps1'", ScRaw "    if (Test-Path $chkDiff) {", ScRaw "        & pwsh -NoProfile -File $chkDiff 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "        if ($LASTEXITCODE -ne 0) {", ScRaw "            Write-Host 'FAIL: the two VM hosts disagree on the compiler output'", ScRaw "            Write-Host '      Detail: pwsh build/check-vm-differential.ps1'", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- deck headroom. These 47 units are every one in the tree under 2.0x margin;", ScComment "the next tightest is 2.13x, in codex/foreword, which this does not cover.", ScComment "1.25 trips codex/build at 52 points and the compiler's own unit at 80, about", ScComment "20 per cent above each one's current requirement. Rationale, corpus numbers", ScComment "and the cost of raising the floor are in ProportionalDecks.md.", ScComment "", ScComment "It runs HERE because it needs the compiler this run built and must not touch", ScComment "build-output\\bare-metal\\Codex.cdx: by this point SUT === seed is proven, and", ScComment "app-sweep below clobbers the bare-metal copy. 23s over 47 units.", ScRaw "Measure-Phase 'deck-headroom' {", ScRaw "    $chkDeck = Join-Path $PSScriptRoot 'deck-headroom.ps1'", ScRaw "    if (Test-Path $chkDeck) {", ScRaw "        # -Fresh: the script serves cached logs without it.", ScRaw "        & pwsh -NoProfile -File $chkDeck -Quire 'codex\\build' -WithSelf -MinMargin 1.25 `", ScRaw "              -Tag 'gate' -Top 5 -Jobs 8 -Fresh 2>&1 |", ScRaw "            Where-Object { $_ -match 'FAIL|^\\s+margin\\s+\\d|OK, tightest' } |", ScRaw "            ForEach-Object { Write-Host \"  $_\" }", ScRaw "        if ($LASTEXITCODE -ne 0) {", ScRaw "            Write-Host 'FAIL: a unit has grown into its deck reservation'", ScRaw "            Write-Host '      Detail: pwsh build/deck-headroom.ps1 -Quire codex\\build -WithSelf -Fresh'", ScRaw "            exit 1", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScComment "-- the apps are the extended pin on the compiler: 267 entry chapters", ScComment "against build/app-sweep-baseline.txt, which names the units known not to", ScComment "compile and the reason. Anything dirty and not in that file is a compiler", ScComment "or foreword regression. The script existed with -Check and was invoked by", ScComment "NOTHING, so it caught nothing: the cons-typed-as-its-element miscompile", ScComment "(main 13839) turned RadioStationMain dirty the day CL 13483 landed and", ScComment "sat a full day unobserved.", ScComment "", ScComment "It runs LAST and sweeps with -Kernel $SutCdx, the compiler this run built.", ScComment "It used to let the sweep default to seed\\Codex.cdx, which inside a gate is", ScComment "the OLD compiler whenever the change moved the seed: main 16020 (a new", ScComment "keyword) passed a 270-unit sweep here and broke apps/radio on main.", ScComment "Cost measured 2026-08-06: 191s of a 517s gate.", ScRaw "Measure-Phase 'app-sweep' {", ScRaw "    $sweep = Join-Path $PSScriptRoot 'sweep-app-classes.ps1'", ScRaw "    if (Test-Path $sweep) {", ScRaw "        $swOut = @(& pwsh -NoProfile -File $sweep -Check -Jobs 8 -Kernel $SutCdx 2>&1 | ForEach-Object { \"$_\" })", ScRaw "        $code = $LASTEXITCODE", ScRaw "        if ($code -ne 0) {", ScRaw "            Write-Host ''", ScRaw "            Write-Host 'FAIL: an app entry chapter regressed against build\\app-sweep-baseline.txt'", ScRaw "            $swOut | Select-Object -Last 20 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "            Write-Host '  per-unit detail: test-output\\clssweep\\_per-unit.csv'", ScRaw "            exit 1", ScRaw "        }", ScRaw "        $swOut | Where-Object { $_ -match 'units:|CHECK|elapsed:' } | ForEach-Object { Write-Host \"  $_\" }", ScRaw "    }", ScRaw "}", ScBlank, ScEcho (SeLit "Something remains suspended in mid-air for a moment before falling"), ScEcho (SeLit "to earth with a heavy thud."), ScEcho (SeLit ""), ScBlank, ScEcho (SeLit "Somewhat shaken by this vision, you rise to your feet to investigate."), ScEcho (SeLit "A crude circle of stones surrounds the spot where the portal appeared."), ScEcho (SeLit "There is something glinting in the grass."), ScEcho (SeLit ""), ScEcho (SeLit "You pick it up. It is a compiler."), ScEcho (SeLit "It is completely self-contained and needs no other tools to function."), ScEcho (SeRaw "'On the handle is inscribed: \"CODEX\".'"), ScEcho (SeLit ""), ScBlank, ScRaw "$buildTimer.Stop()", ScEcho (SeLit "-- Phase Timings ----------------------------------"), ScRaw "$maxName = ($phaseTimings.Keys | ForEach-Object { $_.Length } | Measure-Object -Maximum).Maximum", ScRaw "foreach ($kv in $phaseTimings.GetEnumerator()) {", ScRaw "    $secs = $kv.Value.TotalSeconds", ScRaw "    $pad = $kv.Key.PadRight($maxName)", ScRaw "    Write-Host (\"  {0}  {1,7:N1}s\" -f $pad, $secs)", ScRaw "}", ScRaw "Write-Host (\"  {0}  {1,7:N1}s\" -f 'TOTAL'.PadRight($maxName), $buildTimer.Elapsed.TotalSeconds)", ScEcho (SeLit ""), ScBlank, ScComment "Update constants hash to match the new seed.", ScRaw "if (Test-Path $chkConst) {", ScRaw "    & pwsh -NoProfile -File $chkConst -Update 2>&1 | ForEach-Object { Write-Host \"  $_\" }", ScRaw "}", ScBlank, ScExit (SeInt 0)]

Section: Assembly

  build-body : List ShellCmd = [ScSequence g01, ScBlank, ScSequence g02, ScBlank, ScSequence g03, ScBlank, ScSequence g04, ScBlank, ScSequence g05, ScBlank, ScSequence g06, ScBlank, ScSequence g07, ScBlank, ScSequence g08, ScBlank, ScSequence g09, ScBlank, ScSequence g10]


  internal-doc : List Text =
    [ "Non-public \"internal\" gate (Damian, 2026-08-16). Always proves the seed"
    , "is a byte-identical self-fixed-point that boots; runs a regression phase"
    , "ONLY when a file it depends on changed in this workspace. Everything else"
    , "is caught by the next full gate. A public/release build passes no"
    , "-Internal and runs every phase."
    ]

  build-params : List ShellParam = [sh-doc internal-doc (sh-switch "Internal")]

  build-script : ShellScript = sh-script "build" "full compiler build, verification, and test." build-params build-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell build-script)
  end

