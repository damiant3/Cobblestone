Chapter: BuildScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit


Section: G01 -- Preamble and Compile Failure Reporter

  g01-head : List ShellCmd =
    [ ScRaw "if ($PlanOnly -and -not $Internal) { Write-Host 'REFUSED: -PlanOnly prints the -Internal phase map; pass -Internal with it.'; exit 2 }"
    , ScComment "On success, prints only a story. On failure, prints technical details."
    , ScComment "Phases: clean -> source -> CDX build -> sign -> canary -> jonquil ->"
    , ScComment "        sem-equiv -> text fixed point -> CDX fixed point -> battery ->"
    , ScComment "        oracles -> refusals -> generators -> decks -> app sweep."
    , ScBlank
    , ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1"))
    , ScBlank
    , ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit "..")))
    , ScAssign "OutDir" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "output"]))
    , ScAssign "SeedCdx" (SeBare (SePathJoinN [SeVar "Repo", SeLit "seed\\Codex.cdx"]))
    , ScAssign "SutCdx" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "Sut.cdx"]))
    , ScAssign "CodexSrc" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "Codex.codex"]))
    , ScAssign "Concat" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "concat-codex-self.ps1"]))
    , ScAssign "Compile" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "compile.ps1"]))
    , ScAssign "BuildLog" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "build.log"]))
    , ScBlank
    ]

  g01-tail : List ShellCmd =
    [ ScComment "A compile log ENDS in hundreds of `info CDX4010: bounds proven` lines, so"
    , ScComment "its tail is the one slice guaranteed to say nothing about why a build"
    , ScComment "failed. Show the lines that decide the build, and keep the log: on"
    , ScComment "2026-07-28 a red cdx-build printed ten blank lines and deleted its only"
    , ScComment "evidence, and reconstructing what it had already known cost an hour."
    , ScFunctionBlock "Show-CompileFailure" g01-tail-show-compile-failure
    ]

  g01-tail-show-compile-failure : List ShellCmd =
    [ ScRaw "param([string]$LogFile, [string]$Kept)"
    , ScRaw "$diag = @()"
    , ScIf (SeBare (SePathExists (SeVar "LogFile"))) g01-tail-test-log-file []
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "diag") "Count") ((SeInt 0)))) [ScRaw "$diag | ForEach-Object { Write-Host \"  $_\" }"] g01-tail-block
    , ScIf (SeBare (SeAnd (SePathExists (SeVar "LogFile")) (SeVar "Kept"))) g01-tail-test-log-file-kept []
    ]

  g01-tail-test-log-file : List ShellCmd =
    [ ScRaw "$diag = @(Get-Content $LogFile | Where-Object { $_ -match 'error CDX|CODEGEN-ERRORS|CODEGEN-HALTED' } | Select-Object -First 15)"
    ]

  g01-tail-block : List ShellCmd =
    [ ScRaw "$tail = @()"
    , ScRaw "if (Test-Path $LogFile) { $tail = @(Get-Content $LogFile | Select-Object -Last 10) }"
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "tail") "Count") ((SeInt 0)))) g01-tail-tail-count g01-tail-block-2
    ]

  g01-tail-tail-count : List ShellCmd =
    [ ScEcho (SeLit "  the compile log is EMPTY: the compiler produced no output at all.")
    , ScEcho (SeLit "  That points at the VM or the machine (memory, a killed process)")
    , ScEcho (SeLit "  rather than at a rejected program, which would have left a")
    , ScEcho (SeLit "  diagnostic here. Re-run the same compile by hand before assuming")
    , ScEcho (SeLit "  the source is at fault.")
    ]

  g01-tail-block-2 : List ShellCmd =
    [ ScEcho (SeLit "  no diagnostic in the log. Its last 10 lines:")
    , ScRaw "$tail | ForEach-Object { Write-Host \"  $_\" }"
    ]

  g01-tail-test-log-file-kept : List ShellCmd =
    [ ScRaw "Copy-Item -Force $LogFile $Kept -ErrorAction SilentlyContinue"
    , ScEcho (SeText "  full log kept at: $Kept")
    ]

  g01-body : List ShellCmd = g01-head & g01b & g01-tail

Section: G01b -- The Internal Gate's Smart Coverage


  g01b-notes : List ShellCmd =
    [ ScComment "Smart coverage for the internal gate. The CORE phases (clean, source-concat,"
    , ScComment "the pre-build guards, cdx-build, sign, canary, the CDX"
    , ScComment "fixed point, test-bvt, test-compile, oracles, check-errors) always run: they are what certify the seed is"
    , ScComment "a byte-identical self-fixed-point that boots. The regression phases below run"
    , ScComment "only when a file they depend on changed in THIS workspace; skipped ones are"
    , ScComment "caught by the next full gate. Mapping, by what actually feeds each phase:"
    , ScComment "  jonquil                     <- codex/compiler (codegen) or build/jonquil.ps1"
, ScComment "  vm-differential             <- codex/compiler or codex/build or build:"
, ScComment "    codegen is its SUBJECT, but its INSTRUMENT is two VM hosts and which"
, ScComment "    host runs is decided in build/vm-config.ps1. Keyed on the subject alone"
, ScComment "    it went silently stale: reek 19219 changed host selection and this phase"
, ScComment "    skipped as not implicated (L-INSTRUMENT). A trigger must cover the files"
, ScComment "    that can change a phase's ANSWER, not only the ones it is about."
    , ScComment "  gen-scripts / deck-headroom <- codex/build or build or codex/compiler:"
, ScComment "    both are COMPILED answers, not static ones. gen-scripts compiles every"
, ScComment "    generator with the current kernel and diffs the emitted text, and"
, ScComment "    deck-headroom's per-unit `used` comes from running the compiler while"
, ScComment "    its per-point divisor is demand-check-floor in Core/BuildSettings.codex."
, ScComment "    Measured: that constant went 648 to 704 MB at reek 19178 and every"
, ScComment "    build-quire unit moved (cdxtope 52 of 64 to 48). Keyed on $tBuild alone"
, ScComment "    a pure compiler change skips the phase that would see it. ~1 change in"
, ScComment "    50 on main is compiler-without-build, so this costs 31 s and 63 s that"
, ScComment "    rarely."
    , ScComment "  app-sweep                   <- apps or codex/compiler (the compiler builds the apps),"
, ScComment "    or its runner: build/sweep-app-classes.ps1, sweep-classes.ps1, app-sweep-baseline.txt"
, ScComment "  run-list                    <- tools/codex-vm.c or .exe, or build/check-run-list.ps1:"
, ScComment "    a per-file trigger, which the audit above calls the precise fix and"
, ScComment "    declined for the six existing phases only because widening them to"
, ScComment "    $tBuild fires 11 times in 50. This phase costs 5.7 s, so precision is"
, ScComment "    affordable here: its subject is the -run-list supervisor in codex-vm and"
, ScComment "    its instrument is that script, and no codegen change can move its answer"
, ScComment "    because every arm compares two runs of the SAME kernels."
, ScComment "  uefi-conout                 <- codex/compiler, codex/test, or tools/codex-vm.c or .exe:"
, ScComment "    its instrument is codex-vm's -conout capture."
    , ScComment "  text-stage2 / text-fixedpoint <- the front end and the text printer"
    , ScComment "  text-stage1 / sem-equiv     <- WHENEVER THE CORE RUNS (Damian, 2026-09-02)."
    , ScComment "    The trigger was $tSemantic, and its residue was the rest of the compiler:"
    , ScComment "    a chapter outside Syntax/Ast/CodexEmitter/TextFormat/SourceText/opening/"
    , ScComment "    Lowering can break semantic equivalence and no -Internal run could see it"
    , ScComment "    (L-NOGATE). $coreRuns is the set that can move the compiler binary, so it"
    , ScComment "    is also the set that can move this answer; text-stage1 rides with it"
    , ScComment "    because sem-equiv consumes the stage1.codex only it produces. Measured"
    , ScComment "    2026-09-02: text-stage1 34.5 s, sem-equiv 59.6 s. A run with the core"
    , ScComment "    deferred changes neither side, so it is not made to pay the 96 s."
    , ScComment "test-compile is NOT in that map. It is never skipped, only scoped: with"
    , ScComment "-Internal it compiles the test chapters that CITE a chapter changed here"
    , ScComment "(11 chapters and 12s for a GopComposite change), and the full gate compiles"
    , ScComment "all 1,400 (1,202s at 4 ways). red's ruling 2026-08-20 on the measured cost.", ScComment "test-run is not in the map either, for the same reason: it RUNS the ones", ScComment "test-compile selected that carry an .expected, and an empty cited set costs", ScComment "nothing. Compiling a chapter is not running it, and only running it can see", ScComment "a program that emits clean IR and answers the wrong values (L-NOGATE)."
    , ScComment "The text leg is conditional as of 2026-08-20 (Damian). Measured at head"
    , ScComment "18157: the four text phases cost 99.4s of a 644.1s gate and the CDX fixed"
    , ScComment "point that certifies the shipped artifact costs 25.5s. Their unique subject"
    , ScComment "is the .codex printer, which no codegen change can move: cdx-stage1 parses"
    , ScComment "the same source, so what the text leg alone proves is that Emit/CodexEmitter"
    , ScComment "round-trips it. The residual class is a chapter outside the file set below"
    , ScComment "written with a construct the printer mishandles; that is caught by the next"
    , ScComment "full gate rather than at the CL, and it is the trade this switch makes."
    ]

  g01b-detect : List ShellCmd =
    [ ScRaw "$SkipPhases = [System.Collections.Generic.HashSet[string]]::new()"
    , ScAssign "tCompiler" (SeBool False)
    , ScAssign "coreRuns" (SeBool True)
    , ScRaw "if ($Internal) {"
    , ScRaw "    $changed = @()"
    , ScRaw "    try { $changed = @(p4 opened 2>$null | ForEach-Object { (($_ -split '#')[0]) -replace '^//[^/]+/[^/]+/','' } | Where-Object { $_ }) } catch { }"
    , ScIndent [ScAssign "stream" (SeLit "")]
    , ScRaw "    try { $stream = ((p4 client -o 2>$null | Where-Object { $_ -match '^Stream:' }) -replace '^Stream:\\s*', '').Trim() } catch { }"
    , ScIndent [ScIf (SeBare (SeAnd (SeVar "stream") (SeBare (SeStringNeq (SeVar "stream") (SeLit "//Codex/main"))))) g01b-detect-stream []]
    , ScIndent [ScComment "SOURCE, not the directory: codex/compiler holds 64 .codex and one"]
    , ScIndent [ScComment "prose register that every lane edits, and matching the directory made a"]
    , ScIndent [ScComment "docs-only CL pay all eight compiler phases (Build.md). A non-source file"]
    , ScIndent [ScComment "that DOES decide an answer keeps its own trigger, as app-sweep-baseline does."]
    , ScRaw "    $tCompiler = [bool]($changed | Where-Object { $_ -match '^codex/compiler/.*\\.codex$' })"
    , ScRaw "    $tBuild    = [bool]($changed | Where-Object { $_ -match '^(codex/build/|build/)' })"
    , ScRaw "    $tApps     = [bool]($changed | Where-Object { $_ -match '^apps/' })"
    , ScRaw "    $tFrontEnd = [bool]($changed | Where-Object { $_ -match '^codex/compiler/(Syntax|Ast)/' -or $_ -match '^codex/compiler/Emit/CodexEmitter\\.codex$' -or $_ -match '^codex/compiler/Core/(TextFormat|SourceText)\\.codex$' })"
    , ScRaw "    $tVm       = [bool]($changed | Where-Object { $_ -match '^tools/codex-vm\\.(c|exe)$' -or $_ -match '^build/check-run-list\\.ps1$' })"
    , ScRaw "    $tJonquilRun = [bool]($changed | Where-Object { $_ -match '^build/jonquil\\.ps1$' })"
    , ScRaw "    $tSweepRun   = [bool]($changed | Where-Object { $_ -match '^build/(sweep-app-classes|sweep-classes)\\.ps1$' -or $_ -match '^build/app-sweep-baseline\\.txt$' })"
    , ScIndent [ScComment "A gate runs only the steps the change can affect (Damian, 2026-09-02)."]
    , ScIndent [ScComment "$tKernel is the set that can move the COMPILER BINARY, so it is what"]
    , ScIndent [ScComment "decides whether the fixed-point core is worth running at all. Wide on"]
    , ScIndent [ScComment "the foreword on purpose: most foreword chapters are not in the compiler"]
    , ScIndent [ScComment "unit (measured, Foreword--Fat32 is absent and Foreword--Fat16 present),"]
    , ScIndent [ScComment "and a trigger too wide costs time where one too narrow ships a"]
    , ScIndent [ScComment "miscompile. The two errors are not the same size."]
    , ScRaw "    $tForeword = [bool]($changed | Where-Object { $_ -match '^codex/foreword/' })"
    , ScRaw "    $tSeed     = [bool]($changed | Where-Object { $_ -match '^seed/' })"
    , ScRaw "    $tKernel   = [bool]($tCompiler -or $tForeword -or $tSeed -or $tBuild)"
    , ScIndent [ScComment "The BVT's SUBJECTS are codex/test chapters, hardcoded in bvt.ps1, so a"]
    , ScIndent [ScComment "test-only CL that skipped it would skip the phase grading the file it"]
    , ScIndent [ScComment "changed. Wider than that list on purpose: reading the list from here"]
    , ScIndent [ScComment "couples the two scripts, and 30 s on a test CL is the cheaper error."]
    , ScRaw "    $tTest     = [bool]($changed | Where-Object { $_ -match '^codex/test/' })"
    ]

  g01b-detect-stream : List ShellCmd =
    [ ScRaw "$ahead = @()"
    , ScRaw "try { $ahead = @(p4 diff2 -q '//Codex/main/...' ($stream + '/...') 2>$null | Where-Object { $_ -match '^==== ' } | ForEach-Object { $m = [regex]::Match($_, '//[^/\\s]+/[^/\\s]+/([^#\\s]+)'); if ($m.Success) { $m.Groups[1].Value } } | Where-Object { $_ }) } catch { }"
    , ScComment "p4 diff2 reports a file that differs in EITHER DIRECTION, so a"
    , ScComment "stream that is BEHIND main reads another lane's landed files as its"
    , ScComment "own change. Measured 2026-09-02 with NOTHING opened: 'changed here'"
    , ScComment "named three files main was ahead on, one of them under build/, and"
    , ScComment "the whole fixed-point core ran for another lane's work."
    , ScComment "SUBTRACTING what a merge-down would bring was the first repair and it"
    , ScComment "is WRONG: a code arc gates once at the end, so a stream CL is not"
    , ScComment "gated at submit, and a file changed on BOTH sides would be dropped"
    , ScComment "along with the lane's own change (root, 2026-09-02). Refuse instead."
    , ScComment "Merging down before a gate was already the rule and had no runner,"
    , ScComment "which is L-BODY's shape; after the merge the union is exact and there"
    , ScComment "is no edge left to reason about."
    , ScRaw "$incoming = @()"
    , ScRaw "try { $incoming = @(p4 merge -n -S $stream -r 2>$null | ForEach-Object { $m = [regex]::Match($_, '^//[^/\\s]+/[^/\\s]+/([^#\\s]+)'); if ($m.Success) { $m.Groups[1].Value } } | Where-Object { $_ }) } catch { }"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "incoming") "Count") ((SeInt 0)))) g01b-detect-if-incoming-count []
    , ScRaw "$changed += @($ahead)"
    ]

  g01b-detect-if-incoming-count : List ShellCmd =
    [ ScRaw "Write-Host ('  REFUSED: this stream is BEHIND main by ' + $incoming.Count + ' file(s), so the gate cannot tell your change from another lane''s.') -ForegroundColor Red"
    , ScRaw "Write-Host ('    ' + (($incoming | Select-Object -First 5) -join ', '))"
    , ScEcho (SeLit "    Merge down first. The scope is p4 opened UNION diff2, and diff2 reports a file that differs in EITHER direction.")
    , ScExit (SeInt 1)
    ]

  g01b-map : List ShellCmd =
    [ ScIndent [ScComment "run-list is here for its SUBJECTS, not its answer: its five kernels are"]
    , ScIndent [ScComment "core outputs, and its arms compare two runs of the SAME kernels, so a"]
    , ScIndent [ScComment "stale one moves both sides equally but an ABSENT one refuses. The core"]
    , ScIndent [ScComment "runs to produce inputs, which is a dependency and not a check."]
    , ScRaw "    $coreRuns = [bool]($tKernel -or $tVm)"
    , ScIndent [ScRaw "$runPhase = [ordered]@{"]
    , ScIndent [ScIndent g01b-map-run-phase-ordered]
    , ScIndent [ScRaw "}"]
    ]

  g01b-map-run-phase-ordered : List ShellCmd =
    [ ScRaw "'clean'           = $coreRuns"
    , ScRaw "'source-concat'   = $coreRuns"
    , ScRaw "'cdx-build'       = $coreRuns"
    , ScRaw "'sign'            = $coreRuns"
    , ScRaw "'canary'          = $coreRuns"
    , ScRaw "'cdx-stage1'      = $coreRuns"
    , ScRaw "'cdx-fixedpoint'  = $coreRuns"
    , ScRaw "'test-bvt'        = ($tKernel -or $tTest)"
    , ScRaw "'oracles'         = ($tKernel -or $tTest)"
    , ScRaw "'check-errors'    = ($tKernel -or $tTest)"
    , ScRaw "'jonquil'         = ($tCompiler -or $tJonquilRun)"
    , ScRaw "'gen-scripts'     = ($tBuild -or $tCompiler)"
    , ScRaw "'vm-differential' = ($tCompiler -or $tBuild)"
    , ScRaw "'deck-headroom'   = ($tBuild -or $tCompiler)"
    , ScRaw "'app-sweep'       = ($tApps -or $tCompiler -or $tSweepRun)"
    , ScRaw "'run-list'        = $tVm"
    , ScRaw "'uefi-conout'     = ($tCompiler -or $tTest -or $tVm)"
    , ScRaw "'text-stage1'     = $coreRuns"
    , ScRaw "'sem-equiv'       = $coreRuns"
    , ScRaw "'text-stage2'     = $tFrontEnd"
    , ScRaw "'text-fixedpoint' = $tFrontEnd"
    ]

  g01b-report : List ShellCmd =
    [ ScRaw "    foreach ($k in $runPhase.Keys) { if (-not $runPhase[$k]) { [void]$SkipPhases.Add($k) } }"
    , ScRaw "    $ran = @($runPhase.Keys | Where-Object { $runPhase[$_] })"
    , ScRaw "    Write-Host ('  [internal gate] changed here: ' + $(if ($changed.Count) { ($changed | Sort-Object -Unique) -join ', ' } else { 'nothing opened' }))"
    , ScRaw "    Write-Host ('  [internal gate] running: ' + $(if ($ran.Count) { ($ran -join ', ') } else { '(nothing implicated)' }))"
    , ScRaw "    Write-Host ('  [internal gate] deferred to the next full gate: ' + $(if ($SkipPhases.Count) { (@($SkipPhases) | Sort-Object) -join ', ' } else { '(none)' }))"
    , ScRaw "    if ($PlanOnly) { Write-Host '  [internal gate] -PlanOnly: nothing run.'; exit 0 }"
    , ScIndent [ScComment "THE LINE A CL DESCRIPTION MAY QUOTE. A deferred core does not run"]
    , ScIndent [ScComment "SUT === stage1, so a run that skipped it cannot claim the fixed point"]
    , ScIndent [ScComment "and must say what it DID grade with instead. Printing the truthful"]
    , ScIndent [ScComment "claim here is what stops six agents pasting a proof their run never"]
    , ScIndent [ScComment "produced; the alternative was asking them to remember."]
    , ScIndent [ScIf (SeBare (SeNot (SeVar "coreRuns"))) g01b-report-if-not-core-runs []]
    , ScRaw "}"
    , ScBlank
    ]

  g01b-report-if-not-core-runs : List ShellCmd =
    [ ScRaw "$seedHash = (Get-FileHash $SeedCdx -Algorithm SHA256).Hash"
    , ScComment "A locally built seed is not the compiler of record, and grading"
    , ScComment "against one is the stale-kernel wrong answer wearing another hat."
    , ScComment "Silent when p4 cannot answer: this must not turn a gate red for"
    , ScComment "being offline, only for being wrong."
    , ScRaw "$depotSeed = Join-Path ([System.IO.Path]::GetTempPath()) ('depot-seed-' + [System.Guid]::NewGuid().ToString('N') + '.cdx')"
    , ScAssign "depotHash" (SeLit "")
    , ScRaw "try { & p4 print -q -o $depotSeed '//Codex/main/seed/Codex.cdx' 2>$null | Out-Null; if (Test-Path $depotSeed) { $depotHash = (Get-FileHash $depotSeed -Algorithm SHA256).Hash } } catch { }"
    , ScRaw "Remove-Item -Force $depotSeed -ErrorAction SilentlyContinue"
    , ScIf (SeBare (SeAnd (SeVar "depotHash") (SeBare (SeStringNeq (SeVar "depotHash") (SeVar "seedHash"))))) g01b-report-depot-hash-seed []
    , ScAssign "SutCdx" (SeVar "SeedCdx")
    , ScRaw "Write-Host ('  [internal gate] core SKIPPED; graded with depot seed ' + $seedHash.Substring(0,16))"
    ]

  g01b-report-depot-hash-seed : List ShellCmd =
    [ ScRaw "Write-Host '  REFUSED: the core is deferred, so this run grades with seed\\Codex.cdx -- and that file is NOT the depot seed.' -ForegroundColor Red"
    , ScRaw "Write-Host ('    workspace ' + $seedHash.Substring(0,16) + '   depot ' + $depotHash.Substring(0,16))"
    , ScEcho (SeLit "    Sync the seed, or make a change that runs the core.")
    , ScExit (SeInt 1)
    ]

  g01b : List ShellCmd = g01b-notes & g01b-detect & g01b-map & g01b-report

Section: G02 -- Build Helpers

  g02-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "Invoke-BuildCdx" g02-invoke-build-cdx
    , ScBlank
    , ScFunctionBlock "Invoke-BuildText" g02-invoke-build-text
    , ScBlank
    , ScComment "The CDX header embeds the compiler's own SHA-256 over the binary"
    , ScComment "content (text + padding + rodata) at bytes 8-39. This is the"
    , ScComment "canonical content identity: the sign step signs exactly these bytes,"
    , ScComment "and the header offsets, debug map, and deterministic signature are"
    , ScComment "all derived from this content. Comparing it gives an apples-to-apples"
    , ScComment "fixed-point test regardless of whether either side is signed."
    , ScFunctionBlock "Get-CdxContentHash" g02-get-cdx-content-hash
    , ScBlank
    , ScComment "==================================================================="
    , ScRaw "$buildTimer = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScRaw "$phaseTimings = [ordered]@{}"
    , ScRaw "function Measure-Phase([string]$Name, [scriptblock]$Block) {"
    , ScIndent g02-measure-phase-string-name
    , ScRaw "}"
    ]

  g02-invoke-build-cdx : List ShellCmd =
    [ ScRaw "param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$MemMB = 3072)"
    , ScTempFile "logFile"
    , ScRaw "$tmpOut = Join-Path (Split-Path $Output) 'build_cdx_tmp.cdx'"
    , ScAssign "stage0" (SeBare (SePathJoinN [SeVar "Repo", SeLit "build-output\\bare-metal\\Codex.cdx"]))
    , ScRaw "New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null"
    , ScRaw "if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }"
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $Compile -Src $InputFile -Out $tmpOut -Log $logFile -Repl -MemMB $MemMB 2>&1 | Out-Null"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScRaw "$ok = $LASTEXITCODE -eq 0"
    , ScIf (SeBare (SeNot (SeVar "ok"))) g02-if-not-ok g02-if-not-ok-else
    , ScComment "RETAINED, by Damian's ruling 14 (2026-08-18): warnings do not gate"
    , ScComment "the build, they are AUDITED AT THE RELEASE GATE, and an audit needs"
    , ScComment "something to read. This log was written and then deleted on success,"
    , ScComment "so the only copy of a correct CDX2064 naming a live miscompilation"
    , ScComment "was discarded on every green build (issue 70, X86_64Boot 3216)."
    , ScIf (SeBare (SePathExists (SeVar "logFile"))) g02-test-log-file []
    , ScRaw "Remove-Item -Force $logFile, $tmpOut, ([System.IO.Path]::ChangeExtension($tmpOut, '.map')) -ErrorAction SilentlyContinue"
    , ScReturn (SeVar "ok")
    ]

  g02-if-not-ok : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "FAIL: CDX build failed")
    , ScRaw "Show-CompileFailure -LogFile $logFile -Kept (Join-Path (Split-Path $Output) 'build-cdx-fail.log')"
    ]

  g02-if-not-ok-else : List ShellCmd =
    [ ScRaw "Move-Item -Force $tmpOut $Output"
    , ScComment "compile.ps1 writes the symbol map to a <out>.map sidecar for every CDX"
    , ScComment "compile, -Repl included, since main 15088. Carry it with the binary it"
    , ScComment "describes, or it stays under the tmp name and the next build overwrites"
    , ScComment "the map of the compiler that just shipped."
    , ScRaw "$tmpMap = [System.IO.Path]::ChangeExtension($tmpOut, '.map')"
    , ScIf (SeBare (SePathExists (SeVar "tmpMap"))) g02-test-tmp-map []
    ]

  g02-test-tmp-map : List ShellCmd =
    [ ScRaw "Move-Item -Force $tmpMap ([System.IO.Path]::ChangeExtension($Output, '.map'))"
    ]

  g02-test-log-file : List ShellCmd =
    [ ScComment "info is not warning or error. The audit surface (ruling 14) is"
    , ScComment "warnings and errors, and 980 of this log's 1008 lines were"
    , ScComment "'info CDX4010: bounds proven', which is the compiler reporting a"
    , ScComment "SUCCESS. Splitting them is what makes the diag log readable; the"
    , ScComment "two files are lossless between them."
    , ScRaw "$all = @(Get-Content $logFile)"
    , ScRaw "[System.IO.File]::WriteAllLines([System.IO.Path]::ChangeExtension($Output, '.info.log'), @($all | Where-Object { $_ -match '(^| )(info|hint|deprecated) CDX' }))"
    , ScRaw "[System.IO.File]::WriteAllLines([System.IO.Path]::ChangeExtension($Output, '.diag.log'), @($all | Where-Object { $_ -notmatch '(^| )(info|hint|deprecated) CDX' }))"
    ]

  g02-invoke-build-text : List ShellCmd =
    [ ScRaw "param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$TextMemMB = 3072)"
    , ScTempFile "logFile"
    , ScRaw "$tmpOut = Join-Path (Split-Path $Output) 'build_text_tmp.codex'"
    , ScAssign "stage0" (SeBare (SePathJoinN [SeVar "Repo", SeLit "build-output\\bare-metal\\Codex.cdx"]))
    , ScRaw "New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null"
    , ScRaw "if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }"
    , ScBlank
    , ScTempFile "inputFile2"
    , ScTempFile "outputFile"
    , ScTempFile "stderrFile"
    , ScTry g02-try-body [] g02-try-body-finally
    ]

  g02-try-body : List ShellCmd =
    [ ScRaw "$srcBytes = Normalize-TripleNewlines ([System.IO.File]::ReadAllBytes($InputFile))"
    , ScRaw "$sb = [System.Text.StringBuilder]::new($srcBytes.Length + 100)"
    , ScRaw "[void]$sb.Append(\"TEXT`n\")"
    , ScRaw "[void]$sb.Append([System.Text.Encoding]::UTF8.GetString($srcBytes))"
    , ScRaw "[void]$sb.Append([char]4)"
    , ScRaw "[System.IO.File]::WriteAllText($inputFile2, $sb.ToString(), [System.Text.UTF8Encoding]::new($false))"
    , ScBlank
    , ScRaw "$vmBin = Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'"
    , ScRaw "$vmArgs = @('-kernel', $stage0, '-input', $inputFile2, '-output', $outputFile, '-mem', \"$TextMemMB\", '-headless')"
    , ScRaw "$proc = Start-Process -FilePath $vmBin -ArgumentList $vmArgs -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile"
    , ScRaw "$proc.WaitForExit(600000)"
    , ScIf (SeBare (SeNot (SeProperty (SeVar "proc") "HasExited"))) g02-not-proc-has-exited []
    , ScBlank
    , ScRaw "if (-not (Test-Path $outputFile) -or (Get-Item $outputFile).Length -eq 0) {"
    , ScIndent g02-not-test-output-file
    , ScRaw "}"
    , ScBlank
    , ScRaw "$raw = [System.IO.File]::ReadAllText($outputFile) -replace \"`r\", ''"
    , ScRaw "$lines = $raw -split \"`n\""
    , ScRaw "$textLines = [System.Collections.Generic.List[string]]::new()"
    , ScAssign "halted" (SeVar "false")
    , ScAssign "textHwm" (SeInt 0)
    , ScForEach "rl" (SeVar "lines") g02-each-lines
    , ScRaw "$script:LastTextHwm = $textHwm"
    , ScIf (SeVar "halted") g02-if-halted []
    , ScRaw "[System.IO.File]::WriteAllText($Output, ($textLines -join \"`n\"))"
    , ScReturn (SeVar "true")
    ]

  g02-not-proc-has-exited : List ShellCmd =
    [ ScRaw "Stop-VmGraceful -ProcessId $proc.Id"
    , ScRaw "Write-Host ''; Write-Host 'FAIL: TEXT build timed out'; return $false"
    ]

  g02-not-test-output-file : List ShellCmd =
    [ ScRaw "Write-Host ''; Write-Host 'FAIL: TEXT build produced no output'"
    , ScRaw "if (Test-Path $stderrFile) { Get-Content $stderrFile | Select-Object -Last 5 | ForEach-Object { Write-Host \"  $_\" } }"
    , ScReturn (SeVar "false")
    ]

  g02-each-lines : List ShellCmd =
    [ ScRaw "if ($rl.StartsWith('CODEGEN-HALTED') -or $rl.StartsWith('CODEGEN-ERRORS')) { $halted = $true; break }"
    , ScRaw "if ($rl.StartsWith('WD:PHASE-')) { $ci = $rl.LastIndexOf(':'); if ($ci -gt 0) { $pv = [int64]0; if ([int64]::TryParse($rl.Substring($ci + 1), [ref]$pv) -and $pv -gt $textHwm) { $textHwm = $pv } } }"
    , ScRaw "if (-not $rl.StartsWith('WD:') -and -not $rl.StartsWith('HEAP:') -and -not $rl.StartsWith('STACK:')) { $textLines.Add($rl) }"
    ]

  g02-if-halted : List ShellCmd =
    [ ScRaw "Write-Host ''; Write-Host 'FAIL: TEXT build halted with errors'; return $false"
    ]

  g02-try-body-finally : List ShellCmd =
    [ ScRaw "Remove-Item -Force $inputFile2, $outputFile, $stderrFile -ErrorAction SilentlyContinue"
    ]

  g02-get-cdx-content-hash : List ShellCmd =
    [ ScRaw "param([string]$Path)"
    , ScReadBytes "bytes" (SeVar "Path")
    , ScRaw "return (($bytes[8..39]) | ForEach-Object { $_.ToString('x2') }) -join ''"
    ]

  g02-measure-phase-string-name : List ShellCmd =
    [ ScRaw "if ($script:SkipPhases -and $script:SkipPhases.Contains($Name)) {"
    , ScIndent g02-script-skip-phases-name
    , ScRaw "}"
    , ScRaw "$sw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScRaw "& $Block"
    , ScRaw "$sw.Stop()"
    , ScRaw "$script:phaseTimings[$Name] = $sw.Elapsed"
    ]

  g02-script-skip-phases-name : List ShellCmd =
    [ ScEcho (SeText "  phase '$Name' skipped (internal gate; not implicated by this change)")
    , ScRaw "return"
    ]

Section: G03 -- Clean and Source Concat

  g03-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "The day is warm, yet there is a cooling breeze.")
    , ScBlank
    , ScComment "-- clean"
    , ScBlockCall "Measure-Phase" [SeLit "clean"] g03-measure-phase
    , ScBlank
    , ScComment "-- source"
    , ScBlockCall "Measure-Phase" [SeLit "source-concat"] g03-measure-phase-2
    , ScBlank
    , ScComment "Check if source constants match the seed -- warn if they differ."
    , ScAssign "chkConst" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-constants.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkConst"))) g03-test-chk-const []
    ]

  g03-measure-phase : List ShellCmd =
    [ ScAssign "buildOut" (SeBare (SePathJoinN [SeVar "Repo", SeLit "build-output"]))
    , ScComment "the diffusion-* model-root junctions the GPU tests read (OperatorsManual, -gpu-files) are made once per box, so they survive"
    , ScRaw "if (Test-Path $buildOut) { Get-ChildItem $buildOut -Force | Where-Object { -not ($_.Name -like 'diffusion-*' -and $_.LinkType -eq 'Junction') } | Remove-Item -Recurse -Force }"
    , ScIf (SeBare (SePathExists (SeVar "OutDir"))) g03-test-out-dir []
    , ScRaw "New-Item -ItemType Directory -Force -Path $OutDir | Out-Null"
    , ScRaw "Get-ChildItem $Repo -Recurse -Depth 3 -Include '*.bak','*.tmp','*.snap' -File -ErrorAction SilentlyContinue |"
    , ScRaw "    Where-Object { $_.FullName -notmatch '\\\\\\.git\\\\' } |"
    , ScRaw "    Remove-Item -Force -ErrorAction SilentlyContinue"
    ]

  g03-test-out-dir : List ShellCmd =
    [ ScRaw "$stamp = (Get-Date).ToString('yyyyMMdd-HHmmss')"
    , ScAssign "archive" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeText "output-$stamp"]))
    , ScRaw "Rename-Item $OutDir $archive"
    ]

  g03-measure-phase-2 : List ShellCmd =
    [ ScRaw "if (-not (Test-Path -PathType Leaf $SeedCdx)) { Write-Host \"FAIL: $SeedCdx missing\"; exit 1 }"
    , ScRaw "if (-not (Test-Path -PathType Leaf $Concat))  { Write-Host \"FAIL: $Concat missing\"; exit 1 }"
    , ScRaw "& pwsh -NoProfile -File $Concat -CodexDir (Join-Path $Repo 'codex\\compiler') -OutFile $CodexSrc"
    , ScRaw "if (-not (Test-Path -PathType Leaf $CodexSrc)) { Write-Host 'FAIL: source concat produced no file'; exit 1 }"
    , ScBlank
    , ScComment "Guard against untracked-source pollution. concat-codex-self globs"
    , ScComment "*.codex under codex/compiler/, so an untracked stray there (e.g."
    , ScComment "leftover WIP) is silently baked into the seed, producing a binary that"
    , ScComment "does not match the depot source and is not reproducible. Scope the"
    , ScComment "check to codex/compiler/ ONLY -- plug build-output dirs (codex/plugs/*/"
    , ScComment "build-output/*.codex) hold legitimate untracked artifacts the concat"
    , ScComment "never reads. Match the reconcile ACTION (\" - ... add\"), not \"add\""
    , ScComment "anywhere, so editing a tracked file like list-add.codex does not"
    , ScComment "false-trip. (A real stray, DeckCopy.codex, cost a detour 2026-05-29.)"
    , ScTry g03-try-body g03-try-body-catch []
    ]

  g03-try-body : List ShellCmd =
    [ ScRaw "$stray = @(p4 reconcile -n codex/compiler/... 2>$null |"
    , ScRaw "    Where-Object { $_ -match '\\.codex' -and $_ -match ' - .*\\badd\\b' })"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "stray") "Count") ((SeInt 0)))) g03-stray-count []
    ]

  g03-stray-count : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "FAIL: untracked .codex file(s) under codex/compiler/ would be baked into the seed:")
    , ScRaw "$stray | ForEach-Object { Write-Host \"  $_\" }"
    , ScEcho (SeLit "  p4 add them (so the seed is reproducible) or remove them, then rebuild.")
    , ScExit (SeInt 1)
    ]

  g03-try-body-catch : List ShellCmd =
    [ ScEcho (SeLit "  (note: p4 reconcile unavailable; skipped untracked-source guard)")
    ]

  g03-test-chk-const : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkConst 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    ]

Section: G04 -- The Pre-Build Guards

  tools-gate : List ShellCmd = [sh-raw "& pwsh -NoProfile -File $chkTools 2>&1 | ForEach-Object { Write-Host \"  $_\" }", sh-if (SeNot (SeExitCodeEq 0)) [sh-echo (msg "FAIL: a tool under tools/ is named by no build script, so nothing compiles it."), sh-exit 1] []]

  degenerate-gate : List ShellCmd = [sh-raw "& pwsh -NoProfile -File $chkDegenerate 2>&1 | ForEach-Object { Write-Host \"  $_\" }", sh-if (SeNot (SeExitCodeEq 0)) [sh-echo (msg "FAIL: a foreword trust decision has no registered degenerate arm, waiver or owned gap"), sh-exit 1] []]

  shell-raw-gate : List ShellCmd = [sh-raw "& pwsh -NoProfile -File $chkShellRaw 2>&1 | ForEach-Object { Write-Host \"  $_\" }", sh-if (SeNot (SeExitCodeEq 0)) [sh-echo (msg "FAIL: the raw-shell-text record moved; run build/check-shell-raw.ps1 for the rows."), sh-exit 1] []]

  pipe-verdict-gate : List ShellCmd = [sh-raw "& pwsh -NoProfile -File $chkPipeVerdicts 2>&1 | ForEach-Object { Write-Host \"  $_\" }", sh-if (SeNot (SeExitCodeEq 0)) [sh-echo (msg "FAIL: a pipeline stage declares an exit code its script never exits, or exits one no stage declares."), sh-exit 1] []]

  annotation-gate : List ShellCmd = [sh-raw "& pwsh -NoProfile -File $chkAnnTargets 2>&1 | ForEach-Object { Write-Host \"  $_\" }", sh-if (SeNot (SeExitCodeEq 0)) [sh-echo (msg "FAIL: an annotation names a function its chapter does not define, or a sidecar mirrors no chapter."), sh-exit 1] []]

  g04-body : List ShellCmd =
    [ ScBlank
    , ScComment "The boot cap-bit table (compiler) and the verified-load cap-bit table (OS"
    , ScComment "loader) were two hand-written expansions of one name->bit map, and a drift"
    , ScComment "granted a binary different authority by which door it entered. They are one"
    , ScComment "table now -- codex/foreword/core/Capability.codex, cited by both quires --"
    , ScComment "so check-cap-tables.ps1 had nothing left to compare and is deleted with the"
    , ScComment "in-compiler guard (check-cap-vocab-coherent) that had the same fate."
    , ScBlank
    , ScComment "The foreword `effect <Name> where` declarations are the one part of the"
    , ScComment "capability model that cannot be derived from the shared table: a declaration"
    , ScComment "is a syntax form, not data, and no table can emit one. So this guard is"
    , ScComment "permanent, not interim. Nothing in a compile can do its job either -- an"
    , ScComment "arbitrary user compile does not include all the foreword effect modules, so"
    , ScComment "an in-compiler check cannot see them all. The intended asymmetry is listed"
    , ScComment "in the script."
    , ScAssign "chkEffVocab" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-effect-vocab.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkEffVocab"))) g04-test-chk-eff-vocab []
    , ScBlank
    , ScComment "A builtin name used to live in three hand-maintained lists across two"
    , ScComment "quires, and check-builtin-tables.ps1 reconciled them here. It carries one"
    , ScComment "row now (codex/compiler/Types/Builtins.codex: name, type, emitter), and"
    , ScComment "resolve / route / emit are all projections of it, so there is nothing left"
    , ScComment "for a build-time guard to compare. Script and check are both deleted."
    , ScBlank
    , ScComment "The gate compiles what is ON DISK, so the workspace has to be what the"
    , ScComment "agent thinks it is before any of the rest of this means anything."
    , ScComment ""
    , ScComment "Two failures put a wrong workspace under a green gate, both of them"
    , ScComment "documented in the agent Perforce process notes since 2026-07-13, and both of"
    , ScComment "them hit again on 2026-07-21 by an agent who had read neither. That is the"
    , ScComment "point: this check does not exist because the traps are subtle, it exists"
    , ScComment "because DOCUMENTING them did not stop them. `p4 unshelve` leaves files at the"
    , ScComment "revision they were shelved at and does not schedule the resolve, so `p4"
    , ScComment "resolve -n` says \"nothing to resolve\" and means it while your copy is missing"
    , ScComment "every revision submitted since; and an add whose file is already on disk is"
    , ScComment "refused with \"Can't clobber writable file\" and silently dropped from the"
    , ScComment "changelist, which is how four tests were lost while they were named as"
    , ScComment "pinned."
    , ScComment ""
    , ScComment "Neither is a conflict, a stale revision the eye can see, or an unresolved"
    , ScComment "file, so nothing in the normal flow reports either one. Running the check by"
    , ScComment "hand was the plan and the plan failed twice; the gate runs it now."
    , ScComment ""
    , ScComment "Skipped without Perforce (fresh clone, public mirror) -- there is no"
    , ScComment "workspace to be wrong."
    , ScAssign "chkP4" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "p4-stale-check.ps1"]))
    , ScRaw "if ((Test-Path $chkP4) -and (Get-Command p4 -ErrorAction SilentlyContinue) -and"
    , ScRaw "    (Test-Path (Join-Path $Repo '.p4config'))) {"
    , ScRaw "    & pwsh -NoProfile -File $chkP4 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIndent [ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the workspace does not match the depot -- the gate would compile the wrong source"), ScEcho (SeLit "      Fix it with the two commands the check printed. Do not resolve with -ay."), ScExit (SeInt 1)] []]
    , ScRaw "}"
    , ScBlank
    , ScComment "A sidecar is resolved next to its .codex, so one in the wrong directory"
    , ScComment "configures nothing while reading like a decision -- diagnostic-boot's"
    , ScComment "\"blocks waiting for keyboard input\" skip lived a directory above the test,"
    , ScComment "applied to nothing, and was quoted as a real skip in ExaminersAssay for"
    , ScComment "months. Nothing else can see this: a sidecar that names no test is exactly"
    , ScComment "the file no compile and no battery ever opens."
    , ScAssign "chkSidecars" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-sidecars.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkSidecars"))) g04-test-chk-sidecars []
    , ScBlank
    , set "chkDegenerate" (join-path [SeScriptRoot, sh-lit "checks/degenerate-arms.ps1"])
    , sh-when (SeFileExists (var "chkDegenerate")) degenerate-gate
    , ScBlank
    , ScComment "The diagnostic catalogue (CdxCodes.codex) is read by nobody in the compiler"
    , ScComment "-- cdx-lookup has no caller and whole-program DCE prunes the whole table --"
    , ScComment "so a code raised with no row, or a row whose Name drifted from its constant,"
    , ScComment "is invisible by construction. This reads the catalogue and the raise sites"
    , ScComment "and fails the build when they disagree. It found 13 undocumented codes on"
    , ScComment "its first run."
    , ScAssign "chkCdx" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-cdx-registry.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkCdx"))) g04-test-chk-cdx []
    , ScBlank
    , ScComment "The fact store's partition type GUID is written by three producers -- the"
    , ScComment "reader in Foreword chapter Gpt, the IMG plug, and build/build-img.ps1 -- and"
    , ScComment "a disagreement is silent: the stick carries one type, the guest looks for"
    , ScComment "another, and the store refuses every write while reporting nothing."
    , ScAssign "chkFactsGuid" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-facts-guid.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkFactsGuid"))) g04-test-chk-facts-guid []
    , ScBlank
    , ScComment "Counts in the docs go stale, and \"never carry a count forward\" is written in"
    , ScComment "three places and enforced in none. check-doc-counts.ps1 is the reader; on a"
    , ScComment "clean tree it found six false claims, one of them wrong by thirty tests."
    , ScComment ""
    , ScComment "UNCONDITIONAL since 2026-08-21 (red's ruling). It was opt-in behind an env"
    , ScComment "var or a .doc-counts file, and a runner nobody has to invoke is L-BODY's"
    , ScComment "shape rather than a gate: main published a seed SHA-256, MD5, content-hash"
    , ScComment "prefix and byte count for an artifact it no longer carried, across two seed"
    , ScComment "moves in one day, and nothing observed it because no workspace happened to"
    , ScComment "carry the file. Measured 2026-08-21: 63 claims, mean 0.52 s over three runs."
    , ScAssign "chkCounts" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-doc-counts.ps1"]))
    , ScComment "NOT on -Internal (Damian, 2026-09-02): counts drift again before any"
    , ScComment "release, so paying 0.5 s per CL to hold them exact between releases buys"
    , ScComment "nothing and it was holding the build token. The FULL gate still runs it,"
    , ScComment "which is the gate a release passes through."
    , ScComment "WARNS, does not fail (Damian, 2026-09-07): a doc count carries the date it"
    , ScComment "was measured and is corrected when its doc is next touched, not as an"
    , ScComment "errand that holds a gate or a release."
    , ScIf (SeBare (SeAnd (SeNot (SeVar "Internal")) (SePathExists (SeVar "chkCounts")))) g04-not-internal-test-chk []
    , ScBlank
    , ScComment "A DUPLICATE ID FAILS, where a doc count only warns, and the difference is"
    , ScComment "not severity but decidability. A count carries the date it was measured and"
    , ScComment "drifts honestly as the tree moves; a duplicate id is mechanical and is wrong"
    , ScComment "the moment it is written. An id is what a CL, a review or another register"
    , ScComment "CITES, so two rows sharing one make every citation ambiguous, and the"
    , ScComment "ambiguity is invisible at the citing end. Measured by reek 2026-09-07:"
    , ScComment "plugs-backlog carried two 2.10 rows and two 2.11 rows; a CL deleting 2.10\","
    , ScBlank
    , ScComment "claimed 2.30 and 2.31, so a resolve silently discarded a lane's row."
    , ScComment ""
    , ScComment "It runs on every gate, not just the full one: it reads text, starts no"
    , ScComment "guest, and cost 0.6 s over 45 registers when it was wired."
    , ScAssign "chkIds" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-backlog-ids.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkIds"))) g04-test-chk-ids []
    , ScBlank
    , ScComment "An annotation names its subject by function name; this fails one whose"
    , ScComment "chapter no longer defines it. Text only, no guest."
    , set "chkAnnTargets" (join-path [SeScriptRoot, sh-lit "check-annotation-targets.ps1"])
    , sh-when (SeFileExists (var "chkAnnTargets")) annotation-gate
    , ScBlank
    , ScComment "ScRaw and SeRaw pass raw shell text through the ShellCmd tree. Both were"
    , ScComment "marked DEPRECATED in ShellTypes prose on 2026-08-16 and the count then ROSE"
    , ScComment "from 5,504 to 7,273 in three weeks, because prose is not a runner. This is"
    , ScComment "the ratchet: it fails a rise, and it fails a fall that leaves the record"
    , ScComment "high, since a baseline left high after a conversion lets the raw node come"
    , ScComment "straight back. Text only, starts no guest, reads 58 files."
    , ScComment ""
    , ScComment "The block below is itself written in the vocabulary rather than in ScRaw,"
    , ScComment "which is the campaign's own method applied to its own wiring: one raw node"
    , ScComment "for the pipeline, which has no constructor, against the eight the sibling"
    , ScComment "checks above each spend (ShellDslReadability.md)."
    , set "chkShellRaw" (join-path [SeScriptRoot, sh-lit "check-shell-raw.ps1"])
    , sh-when (SeFileExists (var "chkShellRaw")) shell-raw-gate
    , ScBlank
    , ScComment "A verdict that states the WRONG exit code is worse than no verdict: a reader"
    , ScComment "trusts it and no run contradicts it. Two generators shipped PoExit 1 for"
    , ScComment "scripts that exit 2, 4, 5 and 6 and never 1. This reads the generator rather"
    , ScComment "than the emitted script, because a census of exit over PowerShell text is not"
    , ScComment "decidable: exit appears in prose and a real code can reach it through a"
    , ScComment "variable. An exit inside a raw payload is unreadable to the model and is"
    , ScComment "reported rather than failed, so the arm covers 31 of the 57 generators and"
    , ScComment "grows as check-shell-raw shrinks the payloads."
    , set "chkPipeVerdicts" (join-path [SeScriptRoot, sh-lit "check-pipe-verdicts.ps1"])
    , sh-when (SeFileExists (var "chkPipeVerdicts")) pipe-verdict-gate
    , ScBlank
    , ScComment "A TOOL NOTHING COMPILES IS ALREADY BROKEN AND HAS NOT BEEN TOLD YET."
    , ScComment "tools/ota-fetch.codex sat at head with two CDX2001 type errors because"
    , ScComment "Lwm2mFirmware's signatures moved under it, and no gate saw it because no"
    , ScComment "gate compiles a tool. This is the half of that question decidable without a"
    , ScComment "guest: every tools/*.codex must be NAMED by some build script. It is not a"
    , ScComment "compile check and check-tools.ps1 says so in its own header, because a green"
    , ScComment "line here means referenced and nothing more -- ota-fetch WAS named, by a"
    , ScComment "script that wants a real socket and that no gate runs. Text only, no guest,"
    , ScComment "14 tools against 60 scripts."
    , set "chkTools" (join-path [SeScriptRoot, sh-lit "check-tools.ps1"])
    , sh-when (SeFileExists (var "chkTools")) tools-gate
    , ScBlank
    , ScComment "Same class and beside it for the same reason: the CHAPTER half of a cite is"
    , ScComment "checked by the host resolver and the parenthesised NAME half is checked by"
    , ScComment "nobody, so a typo or a renamed definition reads as a declaration and is"
    , ScComment "decoration. It is mechanical rather than a count, which is what makes it a"
    , ScComment "refusal rather than a warning. Measured before it was wired (fester,"
    , ScComment "2026-09-07): 67 of 11,902 cite lines carry a name list, 121 names, 121"
    , ScComment "resolve, 2 s over the tree and no guest. It found nothing, which is the"
    , ScComment "point; the arm that says it can still fail is `-SelfTest`, and `-File` on a"
    , ScComment "chapter with an invented name refuses."
    , ScAssign "chkCites" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-cite-names.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkCites"))) g04-test-chk-cites []
    , ScBlank
    , ScComment "Same class again, and the third of the cluster. The registry's bounded"
    , ScComment "fixed rows are correct only by inspection of code no registry row covers:"
    , ScComment "bs-alloc is keyed by builtin NAME and the allocation happens a level below"
    , ScComment "it, in a shared core (emit-vec-arith-core) or a runtime helper that has no"
    , ScComment "row and never will (__list_tail). A row that stops being true ACCEPTS a"
    , ScComment "bounded fixed promise it cannot keep, where unknown would have refused, and"
    , ScComment "no arm in the tree can see it: the arms compile programs, and a per-call"
    , ScComment "allocation that starts following an input still compiles."
    , ScComment ""
    , ScComment "Two rules, because the first is only as wide as the spellings it knows: an"
    , ScComment "allocation site in a pinned body must take an immediate, AND the pinned"
    , ScComment "bodies are digested so any edit reds. Controlled by sabotaging a site with"
    , ScComment "an allocation spelled a way the first rule does not know: it stayed silent"
    , ScComment "and the digest caught it alone."
    , ScComment ""
    , ScComment "Text only, starts no guest. Measured 0.6 s mean over three runs, 2026-09-07,"
    , ScComment "which is check-backlog-ids' own figure. Cleared for every gate by red."
    , ScAssign "chkAlloc" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-builtin-alloc.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkAlloc"))) g04-test-chk-alloc []
    , ScBlank
    , ScComment "IRTextParser calls itself the inverse of IRTextEmitter and is not: the"
    , ScComment "emitter can write forms the parser reads as a plausible DEFAULT rather than"
    , ScComment "an error. x86-64 never crosses this wire, so no x86 test and no fixed point"
    , ScComment "can fail on a divergence -- ir-expr-type on IrNegate answered -(-2.5) as 1.7"
    , ScComment "on ARM64 and RISC-V for exactly that reason. Three known holes are recorded"
    , ScComment "in build/plug-wire-baseline.txt; this fails the build on a fourth."
    , ScAssign "chkWire" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-plug-types.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkWire"))) g04-test-chk-wire []
    ]

  g04-test-chk-eff-vocab : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkEffVocab 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: foreword effects and capability vocabulary have drifted -- add the counterpart or record the exception in check-effect-vocab.ps1"), ScExit (SeInt 1)] []
    ]

  g04-test-chk-sidecars : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkSidecars 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a test sidecar names no test"), ScExit (SeInt 1)] []
    ]

  g04-test-chk-cdx : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkCdx 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the diagnostic catalogue disagrees with the code that raises it"), ScExit (SeInt 1)] []
    ]

  g04-test-chk-facts-guid : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkFactsGuid 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the fact-store partition type GUID disagrees across writers"), ScExit (SeInt 1)] []
    ]

  g04-not-internal-test-chk : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkCounts -Quiet 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "WARN: a doc states a count the tree no longer produces; fix it when that doc is next edited."), ScEcho (SeLit "      Run build/check-doc-counts.ps1 for the per-claim table.")] []
    ]

  g04-test-chk-ids : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkIds 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a register gives two rows the same id; a citation to it cannot resolve."), ScExit (SeInt 1)] []
    ]

  g04-test-chk-cites : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkCites 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a cites line names a definition its chapter does not have."), ScExit (SeInt 1)] []
    ]

  g04-test-chk-alloc : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkAlloc 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the evidence behind a bounded fixed row moved; re-measure it against CostModel.md 5.1, then re-pin."), ScExit (SeInt 1)] []
    ]

  g04-test-chk-wire : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkWire 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the IR text wire lost a form between emitter and plug parser"), ScExit (SeInt 1)] []
    ]

Section: G05 -- CDX Build and Sign

  g05-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "The latest in a series of personal crises seems insurmountable.")
    , ScEcho (SeLit "You are being pulled apart in all directions.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScComment "-- CDX build"
    , ScBlockCall "Measure-Phase" [SeLit "cdx-build"] g05-measure-phase
    , ScBlank
    , ScEcho (SeLit "Yet this afternoon walk in the countryside slowly brings relaxation")
    , ScEcho (SeLit "to your harried mind. The soil and strain of modern high-tech living")
    , ScEcho (SeLit "begins to wash off in layers.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScComment "-- sign"
    , ScRaw "if ($coreRuns) { Copy-Item -Force $SutCdx (Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx') }"
    , ScBlank
    , ScRaw "Measure-Phase 'sign' {"
    , ScComment "The signer moved to build/sign-seed.ps1 so a LANE can run it: CLAUDE.md asks"
    , ScComment "for the signer over a candidate before a seed CL lands, and while this phase"
    , ScComment "was inline there was nothing to run but the whole gate. The key location stays"
    , ScComment "declared HERE and is read from here, so the tree keeps one occurrence of it."
    , ScAssign "SigningKey" (SeLit "D:\\Projects\\signing.key")
    , ScIf (SeBare (SeFileExists (SeVar "SigningKey"))) g05-if-test-type-signing-key []
    , ScRaw "}"
    ]

  g05-measure-phase : List ShellCmd =
    [ ScRaw "if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SeedCdx -Output $SutCdx)) { exit 1 }"
    ]

  g05-if-test-type-signing-key : List ShellCmd =
    [ ScAssign "signScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "sign-seed.ps1"]))
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $signScript -Cdx $SutCdx -WorkDir $OutDir 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScRaw "if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: sign'; exit 1 }"
    ]

Section: G06 -- Canary and Jonquil

  g06-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "That willow tree near the stream looks comfortable and inviting.")
    , ScBlank
    , ScComment "-- canary"
    , ScRaw "Measure-Phase 'canary' {"
    , ScRaw "$canarySrc      = Join-Path $Repo 'codex\\test\\factorial.codex'"
    , ScAssign "canaryExpected" (SeBare (SePathJoinN [SeVar "Repo", SeLit "codex\\test\\factorial.expected"]))
    , ScRaw "$canaryCdx      = Join-Path $OutDir 'canary-factorial.cdx'"
    , ScRaw "$canaryLog      = Join-Path $OutDir 'canary-compile.log'"
    , ScRaw "$canaryOut      = Join-Path $OutDir 'canary-run.out'"
    , ScRaw "if (-not (Test-Path -PathType Leaf $canarySrc))      { Write-Host \"FAIL: $canarySrc missing\"; exit 1 }"
    , ScIfLine (SeBare (SeNot (SeFileExists (SeVar "canaryExpected")))) [ScEcho (SeText "FAIL: $canaryExpected missing"), ScExit (SeInt 1)] []
    , ScAssign "compileScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "compile.ps1"]))
    , ScRaw "$runScript     = Join-Path $PSScriptRoot 'test-run.ps1'"
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $compileScript -Src $canarySrc -Out $canaryCdx -Log $canaryLog 2>&1 | Out-Null"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) g06-if-lastexitcode []
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $runScript -Kernel $canaryCdx -OutFile $canaryOut 2>&1 | Out-Null"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScRaw "$expectedBytes = if (Test-Path $canaryExpected) { ([System.IO.File]::ReadAllText($canaryExpected) -replace \"`r\",'').TrimEnd() } else { '' }"
    , ScRaw "$actualBytes   = if (Test-Path $canaryOut)      { ([System.IO.File]::ReadAllText($canaryOut) -replace \"`r\",'').TrimEnd() }    else { '' }"
    , ScIf (SeBare (SeStringNeq (SeVar "expectedBytes") (SeVar "actualBytes"))) g06-if-expected-bytes-actual []
    , ScRaw "}"
    , ScBlank
    , ScEcho (SeLit "You settle beneath it and the buzz of dragonflies and the whisper")
    , ScEcho (SeLit "of the willow's swaying branches bring a deep peace.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScComment "-- the jonquil: IR quine visibility check. The trusting-trust defense holds"
    , ScComment "because a payload that survives the diverse rebuild must reach the readable"
    , ScComment "IR and is therefore visible as text. This enforces that: emit the certified"
    , ScComment "compiler's own IR and fail if any def re-emits itself (the DDC-QUINE-ARM"
    , ScComment "construction). Tripwire only, not the DDC witness; see build/jonquil.ps1."
    , ScBlockCall "Measure-Phase" [SeLit "jonquil"] g06-measure-phase
    ]

  g06-if-lastexitcode : List ShellCmd =
    [ ScEcho (SeLit "FAIL: canary compile -- SUT cannot compile factorial.codex")
    , ScRaw "Get-Content $canaryLog -TotalCount 20 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }"
    , ScExit (SeInt 1)
    ]

  g06-if-expected-bytes-actual : List ShellCmd =
    [ ScEcho (SeLit "FAIL: canary output mismatch")
    , ScEcho (SeText "  expected: $($expectedBytes.Trim())")
    , ScEcho (SeText "  got:      $($actualBytes.Trim())")
    , ScExit (SeInt 1)
    ]

  g06-measure-phase : List ShellCmd =
    [ ScAssign "jonquilScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "jonquil.ps1"]))
    , ScRaw "& pwsh -NoProfile -File $jonquilScript -Kernel $SutCdx -Src $CodexSrc -WorkDir (Join-Path $OutDir 'quine-check')"
    , ScRaw "if ($LASTEXITCODE -ne 0) { exit 1 }"
    ]

Section: G07 -- Size Check and Text Stages

  g07-body : List ShellCmd =
    [ ScBlank
    , ScComment "-- size sanity check"
    , ScAssign "seedSize" (SeProperty (SeRaw "(Get-Item $SeedCdx)") "Length")
    , ScAssign "sutSize" (SeProperty (SeRaw "(Get-Item $SutCdx)") "Length")
    , ScRaw "$drift = [math]::Abs($sutSize - $seedSize)"
    , ScRaw "$maxDrift = [int]($seedSize * 0.05)"
    , ScIf (SeBare (SeAnd (SeVar "coreRuns") (SeBare (SeIntGt (SeVar "drift") (SeVar "maxDrift"))))) g07-core-runs-drift-max []
    , ScBlank
    , ScAssign "textStage1" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "stage1.codex"]))
    , ScAssign "textStage2" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "stage2.codex"]))
    , ScBlank
    , ScEcho (SeLit "Searching inward for tranquility and happiness, you close your eyes.")
    , ScBlockCall "Measure-Phase" [SeLit "text-stage1"] g07-measure-phase
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "sem-equiv"] g07-measure-phase-2
    , ScBlank
    , ScEcho (SeLit "A high-pitched cascading sound like crystal wind-chimes impinges")
    , ScEcho (SeLit "on your floating awareness.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "text-stage2"] g07-measure-phase-3
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "text-fixedpoint"] g07-measure-phase-4
    ]

  g07-core-runs-drift-max : List ShellCmd =
    [ ScEcho (SeText "FAIL: SUT size drifted too far from seed")
    , ScEcho (SeText "  seed: $seedSize bytes  SUT: $sutSize bytes  drift: $drift (max $maxDrift)")
    , ScExit (SeInt 1)
    ]

  g07-measure-phase : List ShellCmd =
    [ ScRaw "if (-not (Invoke-BuildText -InputFile $CodexSrc -Kernel $SutCdx -Output $textStage1)) { exit 1 }"
    , ScRaw "$tHwm = $script:LastTextHwm"
    , ScIf (SeBare (SeIntLe (SeVar "tHwm") (SeInt 0))) [ScEcho (SeLit ""), ScEcho (SeLit "FAIL: text-stage1 emitted no WD:PHASE telemetry, so the memory contract was NOT measured"), ScEcho (SeLit "      A contract that cannot be read is not a contract. Fix the reader, do not skip the check."), ScExit (SeInt 1)] []
    , ScRaw "Write-Host (\"  text-stage1 heap hwm {0:N0} bytes ({1} MB) against the 2 GB contract\" -f $tHwm, [int]($tHwm / 1MB))"
    , ScIf (SeBare (SeIntGt (SeVar "tHwm") (SeInt 2147483648))) g07-if-t-hwm []
    ]

  g07-if-t-hwm : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScRaw "Write-Host (\"FAIL: the text-mode self-compile peaked at {0:N0} bytes, past the 2 GB memory contract\" -f $tHwm)"
    , ScEcho (SeLit "      CurrentPlan, THE COMPILER MEMORY CONTRACT: a self-compile needing more is a DEFECT to fix,")
    , ScEcho (SeLit "      never a reason to grow the guests.")
    , ScExit (SeInt 1)
    ]

  g07-measure-phase-2 : List ShellCmd =
    [ ScAssign "semEquivScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "compare-codex-semantic.ps1"]))
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1 2>&1 | Out-Null"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) g07-if-lastexitcode []
    ]

  g07-if-lastexitcode : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "FAIL: semantic equivalence -- stage1 does not match source")
    , ScRaw "& pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1"
    , ScExit (SeInt 1)
    ]

  g07-measure-phase-3 : List ShellCmd =
    [ ScRaw "if (-not (Invoke-BuildText -InputFile $textStage1 -Kernel $SutCdx -Output $textStage2)) { exit 1 }"
    ]

  g07-measure-phase-4 : List ShellCmd =
    [ ScRaw "$th1 = (Get-FileHash -Algorithm SHA256 $textStage1).Hash"
    , ScRaw "$th2 = (Get-FileHash -Algorithm SHA256 $textStage2).Hash"
    , ScIf (SeBare (SeStringNeq (SeVar "th1") (SeVar "th2"))) [ScEcho (SeLit "FAIL: text round-trip -- stage1 !== stage2"), ScEcho (SeText "  stage1: $((Get-Item $textStage1).Length) bytes  $th1"), ScEcho (SeText "  stage2: $((Get-Item $textStage2).Length) bytes  $th2"), ScExit (SeInt 1)] []
    ]

Section: G08 -- CDX Stages and BVT

  g08-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "As you open your eyes, you see a shimmering blueness rise from the ground.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScAssign "cdxStage1" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "stage1.cdx"]))
    , ScAssign "cdxStage2" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "stage2.cdx"]))
    , ScComment "The kernel every later phase grades with. A deferred core leaves"
    , ScComment "stage1.cdx holding WHATEVER THE LAST RUN LEFT, which is the -Kernel trap"
    , ScComment "CLAUDE.md names: it once reported ~80 of 84 chapters compiling where the"
    , ScComment "truth was ~55. The skipped path is pointed at the seed of record instead,"
    , ScComment "never at a build output."
    , ScRaw "$testKernel = if ($coreRuns) { $cdxStage1 } else { $SeedCdx }"
    , ScBlank
    , ScEcho (SeLit "It is difficult to look at the blueness directly. The sound seems")
    , ScEcho (SeLit "to be emanating from this glowing portal.")
    , ScBlockCall "Measure-Phase" [SeLit "cdx-stage1"] g08-measure-phase
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "cdx-fixedpoint"] g08-measure-phase-2
    , ScBlank
    , ScComment "The warnings ratchet reads the STAGE-3 log, which is this candidate"
    , ScComment "compiling the compiler's own source; a stage-2 log is the SEED doing"
    , ScComment "that and grades no change in this tree (check-compiler-warnings.ps1's"
    , ScComment "own header). Nothing invoked the ratchet until here, so the CDX2064"
    , ScComment "that named a live miscompilation was reported on every build and"
    , ScComment "read by nobody, which is L-BODY."
    , ScBlockCall "Measure-Phase" [SeLit "compiler-warnings"] g08-measure-phase-3
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "cdx-exports"] g08-measure-phase-4
    , ScBlank
    , ScEcho (SeLit "Light seems to bend and distort around it, while the sound waves")
    , ScEcho (SeLit "become so intense, they appear to become visible.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScRaw "if ($coreRuns) { Copy-Item -Force $cdxStage1 (Join-Path $OutDir 'NewSeed.cdx') }"
    , ScBlank
    , ScComment "build/install-seed.ps1 reads THIS run's verdict rather than a log grepped"
    , ScComment "by name, which is the substitution that put a non-fixed-point seed on main"
    , ScComment "(21215, L-BODY). Written on every run: a deferred core names no fixed point"
    , ScComment "and install-seed refuses on that."
    , ScAssign "verdictFile" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "seed-verdict.txt"]))
    , ScIf (SeVar "coreRuns") g08-if-core-runs-3 g08-if-core-runs-3-else
    , ScBlank
    , ScEcho (SeLit "The portal hangs there for a moment; then with the rush of an")
    , ScEcho (SeLit "imploding vacuum, it sinks into the ground.")
    , ScBlank
    , ScBlockCall "Measure-Phase" [SeLit "test-bvt"] g08-measure-phase-5
    ]

  g08-measure-phase : List ShellCmd =
    [ ScRaw "if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SutCdx -Output $cdxStage1)) { exit 1 }"
    ]

  g08-measure-phase-2 : List ShellCmd =
    [ ScRaw "$sutHash = Get-CdxContentHash $SutCdx"
    , ScRaw "$ch1 = Get-CdxContentHash $cdxStage1"
    , ScIf (SeBare (SeIntEq (SeVar "sutHash") (SeVar "ch1"))) g08-if-sut-hash-ch1 g08-if-sut-hash-ch1-else
    ]

  g08-if-sut-hash-ch1 : List ShellCmd =
    [ ScRaw "$script:seedVerdict = 'one-pass'"
    , ScEcho (SeLit "(SUT === stage1 -- hard fixed point in one pass)")
    ]

  g08-if-sut-hash-ch1-else : List ShellCmd =
    [ ScRaw "if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $cdxStage1 -Output $cdxStage2)) { exit 1 }"
    , ScRaw "$ch2 = Get-CdxContentHash $cdxStage2"
    , ScIf (SeBare (SeIntEq (SeVar "ch1") (SeVar "ch2"))) g08-if-ch1-ch2 []
    , ScIf (SeBare (SeStringNeq (SeVar "ch1") (SeVar "ch2"))) [ScEcho (SeLit "FAIL: CDX fixed point -- stage1 !== stage2"), ScEcho (SeText "  stage1: $((Get-Item $cdxStage1).Length) bytes  $ch1"), ScEcho (SeText "  stage2: $((Get-Item $cdxStage2).Length) bytes  $ch2"), ScExit (SeInt 1)] []
    ]

  g08-if-ch1-ch2 : List ShellCmd =
    [ ScRaw "$script:seedVerdict = 'two-pass'"
    , ScEcho (SeLit "(SUT !== stage1 -- CONVERGED ON THE SECOND PASS, stage1 === stage2)")
    , ScEcho (SeLit "  The fixed point is STAGE1. build\\output\\Sut.cdx is the PRE-CONVERGENCE")
    , ScEcho (SeLit "  binary and installing it as the seed ships a compiler that does not")
    , ScEcho (SeLit "  reproduce itself (PerforceProcess 4.3a, P-STAGE2). Converge first:")
    , ScEcho (SeLit "  install build\\output\\NewSeed.cdx, re-run this gate, THEN install Sut.")
    ]

  g08-measure-phase-3 : List ShellCmd =
    [ ScIf (SeVar "coreRuns") g08-if-core-runs g08-if-core-runs-else
    ]

  g08-if-core-runs : List ShellCmd =
    [ ScRaw "$warnLog = [System.IO.Path]::ChangeExtension($cdxStage1, '.diag.log')"
    , ScAssign "warnScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-compiler-warnings.ps1"]))
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $warnScript -Log $warnLog 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit ""), ScEcho (SeLit "FAIL: compiler warnings -- the ratchet refused the stage-3 log"), ScExit (SeInt 1)] []
    ]

  g08-if-core-runs-else : List ShellCmd =
    [ ScEcho (SeLit "  compiler-warnings skipped: the core did not run, so stage1.diag.log belongs to an earlier build")
    ]

  g08-measure-phase-4 : List ShellCmd =
    [ ScIf (SeVar "coreRuns") g08-if-core-runs-2 g08-if-core-runs-2-else
    ]

  g08-if-core-runs-2 : List ShellCmd =
    [ ScAssign "exportDir" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "cdx-exports"]))
    , ScRaw "if (Test-Path $exportDir) { Remove-Item -Recurse -Force $exportDir }"
    , ScAssign "exportScript" (SeBare (SePathJoinN [SeVar "Repo", SeLit "codex", SeLit "test", SeLit "cdx-export-check.ps1"]))
    , ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'"
    , ScRaw "& pwsh -NoProfile -File $exportScript -Kernel $cdxStage1 -WorkDir $exportDir 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScAssign "ErrorActionPreference" (SeVar "prev")
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit ""), ScEcho (SeLit "FAIL: declared exports -- cdx-export-check refused the stage-3 compiler"), ScExit (SeInt 1)] []
    ]

  g08-if-core-runs-2-else : List ShellCmd =
    [ ScEcho (SeLit "  cdx-exports skipped: the core did not run, so there is no stage-3 compiler to grade")
    ]

  g08-if-core-runs-3 : List ShellCmd =
    [ ScRaw "$verdictArtifact = if ($script:seedVerdict -eq 'one-pass') { $SutCdx } else { Join-Path $OutDir 'NewSeed.cdx' }"
    , ScRaw "$verdictHash = (Get-FileHash -Algorithm SHA256 $verdictArtifact).Hash"
    , ScRaw "Set-Content -LiteralPath $verdictFile -Encoding ascii -Value \"$script:seedVerdict $(Split-Path -Leaf $verdictArtifact) $verdictHash\""
    ]

  g08-if-core-runs-3-else : List ShellCmd =
    [ ScRaw "Set-Content -LiteralPath $verdictFile -Encoding ascii -Value 'core-skipped none -'"
    ]

  g08-measure-phase-5 : List ShellCmd =
    [ ScAssign "bvtScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "bvt.ps1"]))
    , ScAssign "testOut" (SeBare (SePathJoinN [SeVar "OutDir", SeLit "test-results.txt"]))
    , ScRaw "& pwsh -NoProfile -File $bvtScript -CodexCdx $testKernel -Jobs 16 > $testOut 2>&1"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) g08-if-lastexitcode []
    ]

  g08-if-lastexitcode : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "FAIL: BVT")
    , ScRaw "Get-Content $testOut | ForEach-Object { Write-Host \"  $_\" }"
    , ScExit (SeInt 1)
    ]

Section: G09 -- Oracles, Plugs and Cross-Arch

  g09-body : List ShellCmd =
    [ ScBlank
    , ScComment "-- the differential oracles: operator correctness against the HOST. The"
    , ScComment "fixed point cannot see an operator that is uniformly wrong, because it"
    , ScComment "only requires the compiler to agree with itself -- which is how Real"
    , ScComment "ordering shipped inverted for three months. Damian's call 2026-07-27:"
    , ScComment "the pin goes wherever it helps, and the gate is where every codegen"
    , ScComment "change passes. Cost measured at 2s + 1s against a 170s gate. The"
    , ScComment "collections stay author-owned (reek: oracle-scalar, blu: oracle-vector"
    , ScComment "and oracle-cce -- cce joined 2026-07-28 once G1 closed and every gap"
    , ScComment "carried a verdict, 1485/1516 with 31 in ruled gaps, 0 unexplained);"
    , ScComment "this leg only runs them against the just-proven fixed point."
    , ScBlockCall "Measure-Phase" [SeLit "oracles"] g09-measure-phase
    , ScBlank
    , ScComment "-- the refusal set: every test under codex/test/errors must still be"
    , ScComment "REFUSED, and with the codes it declares. 203 tests assert a rejection, and"
    , ScComment "until 2026-08-17 the gate ran the thirteen that bvt.ps1 names. The rest were"
    , ScComment "reachable only from build/test.ps1, which is the battery and refuses to run"
    , ScComment "without Damian, so a refusal that stopped happening was caught by nothing an"
    , ScComment "agent is allowed to run. bounded-exceeded reached main green in Update 45"
    , ScComment "with its premise dead: COMPILER-8 made its accumulator extend in place, the"
    , ScComment "declaration it exists to watch fail held instead, and it compiled clean."
    , ScComment ""
    , ScComment "The set is derived from the directory, never listed -- a hand-maintained"
    , ScComment "list is how thirteen came to stand for a hundred and seventy-six. It always"
    , ScComment "runs, like the BVT and the oracles, because the diagnostic path is what a"
    , ScComment "codegen or foreword change moves without moving any other phase. Measured"
    , ScComment "23.4s over 203 refusals at -Jobs 8 (L-COUNT)."
    , ScBlockCall "Measure-Phase" [SeLit "check-errors"] g09-measure-phase-2
    , ScBlank
    , ScComment "-- codex-vm -run-list: the supervisor that the BVT runs every test through."
    , ScComment "Its gating was HALF. bvt.ps1 drives every BVT test through -run-list, so a"
    , ScComment "regression on the HAPPY path already turns this gate red without any of"
    , ScComment "this. What nothing ran is the REFUSAL and ISOLATION half -- a corrupt kernel"
    , ScComment "not taking its neighbours, the wall budget stopping one line alone, drop"
    , ScComment "attribution, a nested list refused -- and those can rot unseen (L-NOGATE)."
    , ScComment ""
    , ScComment "All five arms run rather than only those four: the whole script is 5.7 s in the gate"
    , ScComment "measured 2026-08-25, and a switch to select four of five is machinery to"
    , ScComment "manage three seconds (L-LESS). It REFUSES rather than skips when a kernel it"
    , ScComment "needs is missing, which is why it sits after the oracles: canary, cdx-sign"
    , ScComment "and Sut all exist by here."
    , ScBlockCall "Measure-Phase" [SeLit "run-list"] g09-measure-phase-3
    , ScBlank
    , ScComment "-- the test chapters themselves. No gate phase compiled anything under"
    , ScComment "codex/test until 2026-08-20, so a test chapter that stopped compiling was"
    , ScComment "UNRUNNABLE and every other instrument stayed green over it: the suite stops"
    , ScComment "asking and reports what a suite that asks and agrees reports"
    , ScComment "(L-CAPABILITY-LOST). It cost three times before anything measured it --"
    , ScComment "widget-tone missed by a signature change TWICE, val's 18220 fixing six"
    , ScComment "gop-composite siblings and missing the one directory over, and"
    , ScComment "cost/accumulator-corpus uncompiled since 08-16 because its only runner is"
    , ScComment "invoked by nothing."
    , ScComment ""
    , ScComment "Never skipped, only SCOPED. -Internal compiles the chapters that CITE what"
    , ScComment "changed here; the full gate compiles all of them. Measured: 11 chapters and"
    , ScComment "12s for a GopComposite change, against 1,202s at 4 ways for all 1,400."
    , ScComment ""
    , ScComment "A COMPILER CHANGE IS THE EXCEPTION AND TAKES THE FULL CORPUS (red's ruling"
    , ScComment "2026-08-25, widening reek's proposal from Emit/ to the whole compiler)."
    , ScComment "Cite-scoping assumes a change reaches the chapters that CITE it. Nothing"
    , ScComment "cites the compiler: it is global by construction, so the scoped set is"
    , ScComment "chosen by a relation the subject does not participate in. Main 19551"
    , ScComment "shipped a seed that self-verified, passed the BVT, the oracles and 203"
    , ScComment "refusals, and could not compile the desk -- test-compile had run ONE"
    , ScComment "chapter of 1447 and the corpus was the only witness there was. ~115s on"
    , ScComment "compiler CLs, against a fleet pin measured in hours."
    , ScBlockCall "Measure-Phase" [SeLit "test-compile"] g09-measure-phase-4
    , ScBlank
    , ScComment "COMPILING A TEST IS NOT RUNNING IT, and until now the gate only compiled."
    , ScComment "A change that made lazy-smoke emit clean IR and answer heap addresses where"
    , ScComment "values were expected passed both instruments and blocked a release"
    , ScComment "(L-NOGATE). This RUNS the chapters test-compile just selected -- the ones"
    , ScComment "whose source cites a chapter this CL changed -- and grades them against"
    , ScComment "their .expected. A TEST RUNS WHEN IT IS LIKELY TO FAIL: the cited set is"
    , ScComment "empty on most CLs and this phase costs nothing there."
    , ScComment ""
    , ScComment "bvt.ps1 is the runner because the grading is already in it: the .expected"
    , ScComment "filter, the sidecars, and the strict-prefix arithmetic that tells a"
    , ScComment "TRUNCATED capture from a miscompile (L-SHORT). The subject list is READ"
    , ScComment "from check-test-compile.ps1 rather than re-derived, so there is one selector"
    , ScComment "and not two that can disagree."
    , ScBlockCall "Measure-Phase" [SeLit "test-run"] g09-measure-phase-5
    ]

  g09-measure-phase : List ShellCmd =
    [ ScRaw "foreach ($o in 'oracle-scalar', 'oracle-vector', 'oracle-cce') {"
    , ScIndent g09-o
    , ScRaw "}"
    ]

  g09-o : List ShellCmd =
    [ ScAssign "olog" (SeBare (SePathJoinN [SeVar "OutDir", SeText "$o-results.txt"]))
    , ScRaw "& pwsh -NoProfile -File (Join-Path $PSScriptRoot \"$o.ps1\") -Kernel $testKernel > $olog 2>&1"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) g09-if-lastexitcode []
    ]

  g09-if-lastexitcode : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeText "FAIL: $o disagrees with the host")
    , ScRaw "Get-Content $olog | Select-Object -Last 20 | ForEach-Object { Write-Host \"  $_\" }"
    , ScExit (SeInt 1)
    ]

  g09-measure-phase-2 : List ShellCmd =
    [ ScAssign "chkErrors" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-errors.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkErrors"))) g09-test-chk-errors []
    ]

  g09-test-chk-errors : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkErrors -Kernel $testKernel -Jobs 16 2>&1 | ForEach-Object { Write-Host \"$_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a program the compiler must refuse was not refused as declared"), ScExit (SeInt 1)] []
    ]

  g09-measure-phase-3 : List ShellCmd =
    [ ScAssign "chkRunList" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-run-list.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkRunList"))) g09-test-chk-run-list []
    ]

  g09-test-chk-run-list : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkRunList 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: codex-vm -run-list did not isolate a failing line from its neighbours"), ScExit (SeInt 1)] []
    ]

  g09-measure-phase-4 : List ShellCmd =
    [ ScAssign "chkTest" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-test-compile.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkTest"))) g09-test-chk []
    ]

  g09-test-chk : List ShellCmd =
    [ ScRaw "$tcArgs = @('-Kernel', $testKernel)"
    , ScRaw "if ((-not $Internal) -or $tCompiler) { $tcArgs += '-Full' }"
    , ScRaw "& pwsh -NoProfile -File $chkTest @tcArgs 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a chapter under codex/test does not compile"), ScExit (SeInt 1)] []
    ]

  g09-measure-phase-5 : List ShellCmd =
    [ ScAssign "subjectList" (SeBare (SePathJoinN [SeVar "Repo", SeLit "build-output\\test-compile-subjects.txt"]))
    , ScRaw "$cited = @()"
    , ScIf (SeBare (SePathExists (SeVar "subjectList"))) g09-test-subject-list []
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "cited") "Count") ((SeInt 0)))) g09-cited-count g09-block
    ]

  g09-test-subject-list : List ShellCmd =
    [ ScRaw "$cited = @(Get-Content $subjectList | Where-Object { $_ } |"
    , ScRaw "           Where-Object { Test-Path ($_ -replace '\\.codex$', '.expected') })"
    ]

  g09-cited-count : List ShellCmd =
    [ ScEcho (SeLit "  test-run: OK (no cited chapter carries an .expected)")
    ]

  g09-block : List ShellCmd =
    [ ScAssign "bvtScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "bvt.ps1"]))
    , ScRaw "& pwsh -NoProfile -File $bvtScript -CodexCdx $testKernel -Jobs 16 -SubjectsFile $subjectList 2>&1 |"
    , ScRaw "    ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a cited test chapter RAN and disagreed with its .expected"), ScEcho (SeLit "      Compiling it clean is not the same claim; read the per-test lines above."), ScExit (SeInt 1)] []
    ]

Section: G10 -- Generators, Decks, App Sweep and Closing

  g10-body : List ShellCmd =
    [ ScBlank
    , ScComment "-- the Shell DSL generators: codex/build/*Script.codex compile with the"
    , ScComment "just-proven compiler and emit the scripts the build itself runs on. Nothing"
    , ScComment "observed that. The deck-short miscompile emitted CORRUPT generator output"
    , ScComment "from a clean compile, and it sat silent because no gate ever compared a"
    , ScComment "generator against the script beside it; the corruption was found by eye."
    , ScComment "This leg is that comparison, and it also catches the quieter half: an"
    , ScComment "emitter answers `# <unknown-cmd>` for a node it does not handle instead of"
    , ScComment "failing, so a node added to ShellTypes and forgotten in BashEmit produces a"
    , ScComment "script that is wrong rather than missing."
    , ScComment ""
    , ScComment "26 of 42 generators were already behind their shipped script when this"
    , ScComment "became a gate, and porting each drift back by hand is a campaign. Those are"
    , ScComment "recorded in build/generated-scripts-baseline.txt and do not fail the build."
    , ScComment "A compile failure, an empty emission, an unhandled-node stub, and any drift"
    , ScComment "that is not in that file do. Cost measured 2026-08-06: 61s."
    , ScBlockCall "Measure-Phase" [SeLit "gen-scripts"] g10-measure-phase
    , ScBlank
    , ScComment "-- two independent VM hosts, one source, compared byte for byte. This is a"
    , ScComment "TRUST check, not a correctness one: QEMU is a third-party binary whose"
    , ScComment "Authenticode signature cannot discriminate a good build from a hostile one,"
    , ScComment "because the publisher's signing certificate expired 2023-09-12 and the"
    , ScComment "binaries are still signed with it. Verification returns the same failure in"
    , ScComment "both worlds and there is nothing left to revoke, so the signature carries no"
    , ScComment "information. Two hosts that share no code agreeing on the output does carry"
    , ScComment "some. It skips silently on a machine with only one host, which is the normal"
    , ScComment "case away from this one. 6s."
    , ScBlockCall "Measure-Phase" [SeLit "vm-differential"] g10-measure-phase-2
    , ScBlank
    , ScComment "-- the UEFI print helpers. No sidecar can ask for -uefi, so __uefi_print and"
    , ScComment "__uefi_print_no_nl are graded here and nowhere else (COMPILER-22). 5s."
    , ScBlockCall "Measure-Phase" [SeLit "uefi-conout"] g10-measure-phase-3
    , ScBlank
    , ScComment "-- deck headroom. These 47 units are every one in the tree under 2.0x margin;"
    , ScComment "the next tightest is 2.13x, in codex/foreword, which this does not cover."
    , ScComment "1.25 trips codex/build at 52 points and the compiler's own unit at 80, about"
    , ScComment "20 per cent above each one's current requirement. Rationale, corpus numbers"
    , ScComment "and the cost of raising the floor are in ProportionalDecks.md."
    , ScComment ""
    , ScComment "It runs HERE because it needs the compiler this run built and must not touch"
    , ScComment "build-output\\bare-metal\\Codex.cdx: by this point SUT === seed is proven, and"
    , ScComment "app-sweep below clobbers the bare-metal copy. 23s over 47 units."
    , ScRaw "Measure-Phase 'deck-headroom' {"
    , ScIndent [ScAssign "chkDeck" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "deck-headroom.ps1"]))]
    , ScRaw "    if (Test-Path $chkDeck) {"
    , ScIndent [ScIndent [ScComment "-Fresh: the script serves cached logs without it."]]
    , ScRaw "        $dkOut = @(& pwsh -NoProfile -File $chkDeck -Quire 'codex\\build' -WithSelf -MinMargin 1.25 `"
    , ScRaw "              -Tag 'gate' -Top 5 -Jobs 16 -Fresh 2>&1 | ForEach-Object { \"$_\" })"
    , ScIndent [ScIndent [ScAssign "dkCode" (SeVar "LASTEXITCODE")]]
    , ScComment "A filter at the pipe keeps the COUNT and discards the SHAPE: the unit names"
    , ScComment "print as two spaces and a path and match no alternative, so every failure"
    , ScComment "here named a number of units and never which ones. On failure print it whole."
    , ScRaw "        if ($dkCode -ne 0) { $dkOut | ForEach-Object { Write-Host \"  $_\" } }"
    , ScRaw "        else { $dkOut | Where-Object { $_ -match '^\\s+margin\\s+\\d|OK, tightest' } | ForEach-Object { Write-Host \"  $_\" } }"
    , ScIndent [ScIndent [ScIf (SeBare (SeStringNeq (SeVar "dkCode") (SeInt 0))) [ScEcho (SeLit "FAIL: a unit has grown into its deck reservation"), ScEcho (SeLit "      Detail: pwsh build/deck-headroom.ps1 -Quire codex\\build -WithSelf -Fresh"), ScExit (SeInt 1)] []]]
    , ScRaw "    }"
    , ScRaw "}"
    , ScBlank
    , ScComment "-- the apps are the extended pin on the compiler: 267 entry chapters"
    , ScComment "against build/app-sweep-baseline.txt, which names the units known not to"
    , ScComment "compile and the reason. Anything dirty and not in that file is a compiler"
    , ScComment "or foreword regression. The script existed with -Check and was invoked by"
    , ScComment "NOTHING, so it caught nothing: the cons-typed-as-its-element miscompile"
    , ScComment "(main 13839) turned RadioStationMain dirty the day CL 13483 landed and"
    , ScComment "sat a full day unobserved."
    , ScComment ""
    , ScComment "It runs LAST and sweeps with -Kernel $SutCdx, the compiler this run built."
    , ScComment "It used to let the sweep default to seed\\Codex.cdx, which inside a gate is"
    , ScComment "the OLD compiler whenever the change moved the seed: main 16020 (a new"
    , ScComment "keyword) passed a 270-unit sweep here and broke apps/radio on main."
    , ScComment "Cost measured 2026-08-06: 191s of a 517s gate."
    , ScBlockCall "Measure-Phase" [SeLit "app-sweep"] g10-measure-phase-4
    , ScBlank
    , ScEcho (SeLit "Something remains suspended in mid-air for a moment before falling")
    , ScEcho (SeLit "to earth with a heavy thud.")
    , ScEcho (SeLit "")
    , ScBlank
    , ScEcho (SeLit "Somewhat shaken by this vision, you rise to your feet to investigate.")
    , ScEcho (SeLit "A crude circle of stones surrounds the spot where the portal appeared.")
    , ScEcho (SeLit "There is something glinting in the grass.")
    , ScEcho (SeLit "")
    , ScEcho (SeLit "You pick it up. It is a compiler.")
    , ScEcho (SeLit "It is completely self-contained and needs no other tools to function.")
    , ScEcho (SeRaw "'On the handle is inscribed: \"CODEX\".'")
    , ScEcho (SeLit "")
    , ScBlank
    , ScRaw "$buildTimer.Stop()"
    , ScEcho (SeLit "-- Phase Timings ----------------------------------")
    , ScRaw "$maxName = ($phaseTimings.Keys | ForEach-Object { $_.Length } | Measure-Object -Maximum).Maximum"
    , ScRaw "foreach ($kv in $phaseTimings.GetEnumerator()) {"
    , ScIndent g10-kv-phase-timings-get
    , ScRaw "}"
    , ScRaw "Write-Host (\"  {0}  {1,7:N1}s\" -f 'TOTAL'.PadRight($maxName), $buildTimer.Elapsed.TotalSeconds)"
    , ScEcho (SeLit "")
    , ScBlank
    , ScComment "Update constants hash to match the new seed."
    , ScIf (SeBare (SePathExists (SeVar "chkConst"))) g10-test-chk-const []
    , ScBlank
    , ScExit (SeInt 0)
    ]

  g10-measure-phase : List ShellCmd =
    [ ScAssign "chkGen" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-generated-scripts.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkGen"))) g10-test-chk-gen []
    ]

  g10-test-chk-gen : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkGen 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a Shell DSL generator is broken or has newly drifted from the script it emits"), ScExit (SeInt 1)] []
    ]

  g10-measure-phase-2 : List ShellCmd =
    [ ScAssign "chkDiff" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "check-vm-differential.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "chkDiff"))) g10-test-chk-diff []
    ]

  g10-test-chk-diff : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkDiff 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: the two VM hosts disagree on the compiler output"), ScEcho (SeLit "      Detail: pwsh build/check-vm-differential.ps1"), ScExit (SeInt 1)] []
    ]

  g10-measure-phase-3 : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File (Join-Path $PSScriptRoot 'test-uefi-conout.ps1') -Kernel $SutCdx 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    , ScIf (SeBare (SeStringNeq (SeVar "LASTEXITCODE") (SeInt 0))) [ScEcho (SeLit "FAIL: a UEFI ConOut print does not match its .expected"), ScEcho (SeLit "      Detail: pwsh build/test-uefi-conout.ps1 -Kernel build\\output\\Sut.cdx"), ScExit (SeInt 1)] []
    ]

  g10-measure-phase-4 : List ShellCmd =
    [ ScAssign "sweep" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "sweep-app-classes.ps1"]))
    , ScIf (SeBare (SePathExists (SeVar "sweep"))) g10-test-sweep []
    ]

  g10-test-sweep : List ShellCmd =
    [ ScComment "-Internal sweeps a strided 30 of the 270; the release gate sweeps all"
    , ScComment "of them. 151.7s of the 644.1s gate measured at head 18157, and a"
    , ScComment "compiler regression usually moves a class of construct rather than one"
    , ScComment "unit, so the stride keeps most of the signal. What it cannot see waits"
    , ScComment "for the full sweep, which is the trade this makes."
    , ScComment "A COMPILER change keeps the STRIDE and an apps change takes the"
    , ScComment "CITE-SCOPED set (Damian, 2026-09-02). Nothing cites the compiler --"
    , ScComment "it is global by construction -- so a scoped set on a compiler CL is"
    , ScComment "chosen by a relation the subject does not participate in, comes out"
    , ScComment "EMPTY, and reads as green. That is red's ruling for test-compile's"
    , ScComment "full corpus, one phase over."
    , ScComment "@(...) around the if, not $(...): $(...) UNWRAPS a one-element array to"
    , ScComment "its element, so the -CiteScoped branch became the STRING '-CiteScoped'"
    , ScComment "and @sweepArgs splatted it per character, binding -TimeoutSec from 'C'"
    , ScComment "(67). Every apps-only CL's app-sweep was red from 21659 until this."
    , ScComment "The compiler branch has two elements and stayed an array, which is why"
    , ScComment "only half the phase was broken."
    , ScRaw "$sweepArgs = @()"
    , ScRaw "if ($Internal) { $sweepArgs = @(if ($tCompiler) { @('-Sample', '30') } else { @('-CiteScoped') }) }"
    , ScRaw "$swOut = @(& pwsh -NoProfile -File $sweep -Check -Jobs 16 -Kernel $SutCdx @sweepArgs 2>&1 | ForEach-Object { \"$_\" })"
    , ScAssign "code" (SeVar "LASTEXITCODE")
    , ScIf (SeBare (SeStringNeq (SeVar "code") (SeInt 0))) g10-if-code []
    , ScRaw "$swOut | Where-Object { $_ -match 'units:|CHECK|elapsed:' } | ForEach-Object { Write-Host \"  $_\" }"
    ]

  g10-if-code : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "FAIL: an app entry chapter regressed against build\\app-sweep-baseline.txt")
    , ScRaw "$swOut | Select-Object -Last 20 | ForEach-Object { Write-Host \"  $_\" }"
    , ScEcho (SeLit "  per-unit detail: test-output\\clssweep\\_per-unit.csv")
    , ScExit (SeInt 1)
    ]

  g10-kv-phase-timings-get : List ShellCmd =
    [ ScRaw "$secs = $kv.Value.TotalSeconds"
    , ScRaw "$pad = $kv.Key.PadRight($maxName)"
    , ScRaw "Write-Host (\"  {0}  {1,7:N1}s\" -f $pad, $secs)"
    ]

  g10-test-chk-const : List ShellCmd =
    [ ScRaw "& pwsh -NoProfile -File $chkConst -Update 2>&1 | ForEach-Object { Write-Host \"  $_\" }"
    ]

Section: Parameters

  internal-doc : List Text =
    [ "Non-public \"internal\" gate (Damian, 2026-08-16). Always proves the seed"
    , "is a byte-identical self-fixed-point that boots; runs a regression phase"
    , "ONLY when a file it depends on changed in this workspace. Everything else"
    , "is caught by the next full gate. A public/release build passes no"
    , "-Internal and runs every phase."
    ]

  planonly-doc : List Text =
    [ "With -Internal: print the phase map for the changed set and exit before"
    , "any phase, compile or guest. The only way to test a trigger while the"
    , "-Internal gate itself is not run (R-GATE)."
    ]

  build-params : List ShellParam = [sh-doc internal-doc (sh-switch "Internal"), sh-doc planonly-doc (sh-switch "PlanOnly")]

Section: The stages


  g01 : PipeStage = PipeStage { ps-name = "preamble and compile failure reporter", ps-why = "strict mode, the working directory, and the reporter every later phase routes a compile failure through", ps-in = ["Internal"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = g01-body }

  g02 : PipeStage = PipeStage { ps-name = "build helpers", ps-why = "Invoke-BuildCdx and the rest, defined once for the eight phases that call them", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = g02-body }

  g03 : PipeStage = PipeStage { ps-name = "clean and source concat", ps-why = "a clean output tree and the whole compiler concatenated into the single unit the build compiles", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the tree could not be cleaned or the concatenated source could not be assembled, so nothing downstream is compiling what the depot holds"], ps-body = g03-body }

  g04 : PipeStage = PipeStage { ps-name = "the pre-build guards", ps-why = "the checks that must pass BEFORE a compiler is built, the cap-bit tables among them, because a guard run afterwards is a guard on the wrong artifact", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "a pre-build guard refused; the source disagrees with itself and no compiler should be built from it"], ps-body = g04-body }

  g05 : PipeStage = PipeStage { ps-name = "cdx build and sign", ps-why = "compile the concatenated source to CDX and sign it", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the CDX did not build, or the signing step failed, which is a build-script defect rather than a source defect"], ps-body = g05-body }

  g06 : PipeStage = PipeStage { ps-name = "canary and jonquil", ps-why = "the two smallest programs that exercise the new compiler end to end before anything expensive runs on it", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the freshly built compiler failed on a program small enough that the failure is in the compiler, not the subject"], ps-body = g06-body }

  g07 : PipeStage = PipeStage { ps-name = "size check and text stages", ps-why = "the seed size sanity bound, then semantic equivalence of text mode", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the seed is outside its size bound, or a text stage disagreed, so the compiler does not reproduce its own text"], ps-body = g07-body }

  g08 : PipeStage = PipeStage { ps-name = "cdx stages and bvt", ps-why = "the fixed point proper, stage 2 against stage 3, and then the BVT over the candidate", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the compiler is not a fixed point of itself, or the BVT went red on the candidate"], ps-body = g08-body }

  g09 : PipeStage = PipeStage { ps-name = "oracles and test runs", ps-why = "operator correctness against the host, then the test chapters compiled and run", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "an oracle disagreed with the host, or a test chapter did not compile or answer its .expected"], ps-body = g09-body }

  g10 : PipeStage = PipeStage { ps-name = "generators, decks, app sweep and closing", ps-why = "the Shell DSL generators still emit the scripts shipped beside them, the decks hold, and every application still compiles", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "a generator drifted from the script it emits, a deck failed, or an application stopped compiling", PoExit 0 "every phase passed: the compiler is a signed byte-identical fixed point of itself and the whole corpus still builds"], ps-body = g10-body }

Section: Assembly

  build-pipe : Pipeline = Pipeline { pl-name = "build", pl-doc = "full compiler build, verification, and test.", pl-params = build-params, pl-stages = [PsStage g01, PsStage g02, PsStage g03, PsStage g04, PsStage g05, PsStage g06, PsStage g07, PsStage g08, PsStage g09, PsStage g10] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell build-pipe))
  end

