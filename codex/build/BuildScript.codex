Section: B01 -- Preamble

  b01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScBlank, ScAssign "Repo" (SeRaw "(Resolve-Path (Join-Path $PSScriptRoot '..')).Path"), ScAssign "OutDir" (SeRaw "Join-Path $PSScriptRoot 'output'"), ScAssign "SeedCdx" (SeRaw "Join-Path $Repo 'seed\\Codex.cdx'"), ScAssign "SutCdx" (SeRaw "Join-Path $OutDir 'Sut.cdx'"), ScAssign "CodexSrc" (SeRaw "Join-Path $OutDir 'Codex.codex'"), ScAssign "Concat" (SeRaw "Join-Path $PSScriptRoot 'concat-codex-self.ps1'"), ScAssign "Compile" (SeRaw "Join-Path $PSScriptRoot 'compile.ps1'"), ScAssign "BuildLog" (SeRaw "Join-Path $OutDir 'build.log'")]

Section: B02 -- Helper Functions

  b02 : List ShellCmd = [ScRaw "function Invoke-BuildCdx {", ScRaw "    param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$MemMB = 3072)", ScRaw "    $logFile = [System.IO.Path]::GetTempFileName()", ScRaw "    $tmpOut = Join-Path (Split-Path $Output) 'build_cdx_tmp.cdx'", ScRaw "    $stage0 = Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx'", ScRaw "    New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "    if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $Compile -Src $InputFile -Out $tmpOut -Log $logFile -Repl -MemMB $MemMB 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScRaw "    $ok = $LASTEXITCODE -eq 0", ScIf (SeNot (SeVar "ok")) [ScEcho (SeLit ""), ScEcho (SeLit "FAIL: CDX build failed"), ScRaw "Get-Content $logFile -ErrorAction SilentlyContinue | Select-Object -Last 10 | ForEach-Object { Write-Host \"  $_\" }"] [ScRaw "Move-Item -Force $tmpOut $Output"], ScRaw "    Remove-Item -Force $logFile, $tmpOut -ErrorAction SilentlyContinue", ScRaw "    return $ok", ScRaw "}"]

  b02b : List ShellCmd = [ScRaw "function Invoke-BuildText {", ScRaw "    param([string]$InputFile, [string]$Kernel, [string]$Output, [int]$TextMemMB = 3072)", ScRaw "    $logFile = [System.IO.Path]::GetTempFileName()", ScRaw "    $tmpOut = Join-Path (Split-Path $Output) 'build_text_tmp.codex'", ScRaw "    $stage0 = Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx'", ScRaw "    New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "    if ($Kernel -ne $stage0) { Copy-Item -Force $Kernel $stage0 }", ScRaw "    $inputFile2 = [System.IO.Path]::GetTempFileName(); $outputFile = [System.IO.Path]::GetTempFileName(); $stderrFile = [System.IO.Path]::GetTempFileName()", ScRaw "    try {", ScRaw "        $srcBytes = Normalize-TripleNewlines ([System.IO.File]::ReadAllBytes($InputFile))", ScRaw "        $sb = [System.Text.StringBuilder]::new($srcBytes.Length + 100)", ScRaw "        [void]$sb.Append(\"TEXT`n\"); [void]$sb.Append([System.Text.Encoding]::UTF8.GetString($srcBytes)); [void]$sb.Append([char]4)", ScRaw "        [System.IO.File]::WriteAllText($inputFile2, $sb.ToString(), [System.Text.UTF8Encoding]::new($false))", ScRaw "        $vmBin = Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'", ScRaw "        $vmArgs = @('-kernel', $stage0, '-input', $inputFile2, '-output', $outputFile, '-mem', \"$TextMemMB\", '-headless')", ScRaw "        $proc = Start-Process -FilePath $vmBin -ArgumentList $vmArgs -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile", ScRaw "        $proc.WaitForExit(600000)", ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) [ScRaw "Stop-VmGraceful -ProcessId $proc.Id", ScEcho (SeLit "FAIL: TEXT build timed out"), ScRaw "return $false"] [], ScRaw "        if (-not (Test-Path $outputFile) -or (Get-Item $outputFile).Length -eq 0) { Write-Host 'FAIL: TEXT build produced no output'; return $false }", ScRaw "        $raw = [System.IO.File]::ReadAllText($outputFile) -replace \"`r\", '' -replace \"^\\x01\", ''", ScRaw "        $lines = $raw -split \"`n\"", ScRaw "        $textLines = [System.Collections.Generic.List[string]]::new(); $halted = $false", ScRaw "        foreach ($rl in $lines) { if ($rl.StartsWith('CODEGEN-HALTED') -or $rl.StartsWith('CODEGEN-ERRORS')) { $halted = $true; break }; if (-not $rl.StartsWith('WD:') -and -not $rl.StartsWith('HEAP:') -and -not $rl.StartsWith('STACK:')) { $textLines.Add($rl) } }", ScIf (SeVar "halted") [ScEcho (SeLit "FAIL: TEXT build halted with errors"), ScRaw "return $false"] [], ScRaw "        [System.IO.File]::WriteAllText($Output, ($textLines -join \"`n\"))", ScRaw "        return $true", ScRaw "    } finally { Remove-Item -Force $inputFile2, $outputFile, $stderrFile -ErrorAction SilentlyContinue }", ScRaw "}"]

  b02c : List ShellCmd = [ScRaw "function Get-CdxContentHash { param([string]$Path); $bytes = [System.IO.File]::ReadAllBytes($Path); return (($bytes[8..39]) | ForEach-Object { $_.ToString('x2') }) -join '' }", ScBlank, ScRaw "$buildTimer = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "$phaseTimings = [ordered]@{}", ScRaw "function Measure-Phase([string]$Name, [scriptblock]$Block) { $sw = [System.Diagnostics.Stopwatch]::StartNew(); & $Block; $sw.Stop(); $script:phaseTimings[$Name] = $sw.Elapsed }"]

Section: B03 -- Clean Phase

  b03 : List ShellCmd = [ScEcho (SeLit "The day is warm, yet there is a cooling breeze."), ScBlank, ScRaw "Measure-Phase 'clean' {", ScAssign "buildOut" (SeRaw "Join-Path $Repo 'build-output'"), ScIf (SeDirExists (SeVar "buildOut")) [ScRaw "Remove-Item -Recurse -Force $buildOut"] [], ScIf (SeDirExists (SeVar "OutDir")) [ScRaw "$stamp = (Get-Date).ToString('yyyyMMdd-HHmmss')", ScRaw "Rename-Item $OutDir (Join-Path $PSScriptRoot \"output-$stamp\")"] [], ScMkdir (SeVar "OutDir"), ScRaw "Get-ChildItem $Repo -Recurse -Depth 3 -Include '*.bak','*.tmp','*.snap' -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch '\\\\\\. git\\\\' } | Remove-Item -Force -ErrorAction SilentlyContinue", ScRaw "}"]

Section: B04 -- Source Concat

  b04 : List ShellCmd = [ScRaw "Measure-Phase 'source-concat' {", ScIf (SeNot (SeFileExists (SeVar "SeedCdx"))) [ScEcho (SeRaw "\"FAIL: $SeedCdx missing\""), ScExit (SeInt 1)] [], ScIf (SeNot (SeFileExists (SeVar "Concat"))) [ScEcho (SeRaw "\"FAIL: $Concat missing\""), ScExit (SeInt 1)] [], ScRaw "& pwsh -NoProfile -File $Concat -CodexDir (Join-Path $Repo 'codex\\compiler') -OutFile $CodexSrc", ScIf (SeNot (SeFileExists (SeVar "CodexSrc"))) [ScEcho (SeLit "FAIL: source concat produced no file"), ScExit (SeInt 1)] [], ScRaw "try { $stray = @(p4 reconcile -n codex/compiler/... 2>$null | Where-Object { $_ -match '\\.codex' -and $_ -match ' - .*\\badd\\b' }); if ($stray.Count -gt 0) { Write-Host ''; Write-Host 'FAIL: untracked .codex file(s) under codex/compiler/'; $stray | ForEach-Object { Write-Host \"  $_\" }; exit 1 } } catch { Write-Host '  (note: p4 reconcile unavailable; skipped untracked-source guard)' }", ScRaw "}", ScBlank, ScAssign "chkConst" (SeRaw "Join-Path $PSScriptRoot 'check-constants.ps1'"), ScIf (SeFileExists (SeVar "chkConst")) [ScRaw "& pwsh -NoProfile -File $chkConst 2>&1 | ForEach-Object { Write-Host \"  $_\" }"] []]

Section: B05 -- CDX Build

  b05 : List ShellCmd = [ScEcho (SeLit "The latest in a series of personal crises seems insurmountable."), ScEcho (SeLit "You are being pulled apart in all directions."), ScEcho (SeLit ""), ScBlank, ScRaw "Measure-Phase 'cdx-build' { if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SeedCdx -Output $SutCdx)) { exit 1 } }", ScBlank, ScEcho (SeLit "Yet this afternoon walk in the countryside slowly brings relaxation"), ScEcho (SeLit "to your harried mind. The soil and strain of modern high-tech living"), ScEcho (SeLit "begins to wash off in layers."), ScEcho (SeLit "")]

Section: B06 -- Sign

  b06 : List ShellCmd = [ScCopy (SeVar "SutCdx") (SeRaw "Join-Path $Repo 'build-output\\bare-metal\\Codex.cdx'"), ScBlank, ScRaw "Measure-Phase 'sign' {", ScAssign "SigningKey" (SeLit "D:\\Projects\\signing.key"), ScIf (SeFileExists (SeVar "SigningKey")) [ScRaw "$compileScript = Join-Path $PSScriptRoot 'compile.ps1'; $runScript = Join-Path $PSScriptRoot 'test-run.ps1'", ScReadBytes "cdxRaw" (SeVar "SutCdx"), ScReadBytes "keyBytes" (SeVar "SigningKey"), ScRaw "$hashBytes = $cdxRaw[8..39]", ScRaw "$keyList = ($keyBytes | ForEach-Object { $_.ToString() }) -join ', '", ScRaw "$hashList = ($hashBytes | ForEach-Object { $_.ToString() }) -join ', '", ScRaw "$signSrc = Join-Path $OutDir 'cdx-sign-inline.codex'", ScRaw "$signSrcText = \"Chapter: CdxSignInline`n  cites Foreword chapter Console`n  cites Foreword chapter Ed25519`n  cites Foreword chapter Sha512`nSection: Helpers`n  bytes-to-csv : List Integer, Integer, Integer, Text -> Text`n  bytes-to-csv (bs) (i) (len) (acc) =`n    if i >= len then acc`n    else let sep = if i == 0 then `\"`\" else `\",`\"`n    in bytes-to-csv bs (i + 1) len (acc & sep & show (list-at bs i))`nSection: Body`n  opening : [Console] Nothing = act`n    let key = [$keyList]`n    in let hash = [$hashList]`n    in let pub = ed25519-public-key key`n    in let sig = ed25519-sign key pub hash`n    in act`n      print-line-uni (bytes-to-csv pub 0 32 `\"`\")  `n      print-line-uni (bytes-to-csv sig 0 64 `\"`\")  `n    end`n  end\"", ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "signSrc", SeVar "signSrcText"], ScRaw "$signCdx = Join-Path $OutDir 'cdx-sign.cdx'; $signLog = Join-Path $OutDir 'cdx-sign.log'; $signOut = Join-Path $OutDir 'cdx-sign.out'", ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $compileScript -Src $signSrc -Out $signCdx -Log $signLog 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScIf (SeNot (SeExitCodeEq 0)) [ScEcho (SeLit "FAIL: sign tool compile failed"), ScExit (SeInt 1)] [], ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $runScript -Kernel $signCdx -OutFile $signOut 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScIf (SeNot (SeExitCodeEq 0)) [ScEcho (SeLit "FAIL: sign tool run failed"), ScExit (SeInt 1)] [], ScRaw "$signRaw = [System.IO.File]::ReadAllText($signOut); $signClean = $signRaw -replace '[^\\x20-\\x7E\\r\\n]', ''", ScRaw "$signLines = $signClean -split \"`n\" | Where-Object { $_.Trim() -match '^\\d' }", ScRaw "$pubBytes = $signLines[0].Split(',') | Where-Object { $_.Trim() -ne '' } | ForEach-Object { [byte]([int]$_.Trim()) }", ScRaw "$sigBytes = $signLines[1].Split(',') | Where-Object { $_.Trim() -ne '' } | ForEach-Object { [byte]([int]$_.Trim()) }", ScIf (SeOr (SeRaw "$pubBytes.Count -ne 32") (SeRaw "$sigBytes.Count -ne 64")) [ScEcho (SeRaw "\"FAIL: bad sign output (pub=$($pubBytes.Count) sig=$($sigBytes.Count))\""), ScExit (SeInt 1)] [], ScRaw "for ($i = 0; $i -lt 32; $i++) { $cdxRaw[40 + $i] = $pubBytes[$i] }", ScRaw "for ($i = 0; $i -lt 64; $i++) { $cdxRaw[72 + $i] = $sigBytes[$i] }", ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "SutCdx", SeVar "cdxRaw"]] [], ScRaw "}"]

Section: B07 -- Canary

  b07 : List ShellCmd = [ScEcho (SeLit "That willow tree near the stream looks comfortable and inviting."), ScBlank, ScRaw "Measure-Phase 'canary' {", ScAssign "canarySrc" (SeRaw "Join-Path $Repo 'codex\\test\\factorial.codex'"), ScAssign "canaryExpected" (SeRaw "Join-Path $Repo 'codex\\test\\factorial.expected'"), ScAssign "canaryCdx" (SeRaw "Join-Path $OutDir 'canary-factorial.cdx'"), ScAssign "canaryLog" (SeRaw "Join-Path $OutDir 'canary-compile.log'"), ScAssign "canaryOut" (SeRaw "Join-Path $OutDir 'canary-run.out'"), ScIf (SeNot (SeFileExists (SeVar "canarySrc"))) [ScEcho (SeRaw "\"FAIL: $canarySrc missing\""), ScExit (SeInt 1)] [], ScIf (SeNot (SeFileExists (SeVar "canaryExpected"))) [ScEcho (SeRaw "\"FAIL: $canaryExpected missing\""), ScExit (SeInt 1)] [], ScRaw "$compileScript = Join-Path $PSScriptRoot 'compile.ps1'; $runScript = Join-Path $PSScriptRoot 'test-run.ps1'", ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $compileScript -Src $canarySrc -Out $canaryCdx -Log $canaryLog 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScIf (SeNot (SeExitCodeEq 0)) [ScEcho (SeLit "FAIL: canary compile -- SUT cannot compile factorial.codex"), ScRaw "Get-Content $canaryLog -TotalCount 20 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }", ScExit (SeInt 1)] [], ScRaw "$prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "& pwsh -NoProfile -File $runScript -Kernel $canaryCdx -OutFile $canaryOut 2>&1 | Out-Null", ScRaw "$ErrorActionPreference = $prev", ScRaw "$expectedBytes = if (Test-Path $canaryExpected) { ([System.IO.File]::ReadAllText($canaryExpected) -replace \"`r\",'').TrimEnd() } else { '' }", ScRaw "$actualBytes = if (Test-Path $canaryOut) { ([System.IO.File]::ReadAllText($canaryOut) -replace \"`r\",'').TrimEnd() } else { '' }", ScIf (SeStringNeq (SeVar "expectedBytes") (SeVar "actualBytes")) [ScEcho (SeLit "FAIL: canary output mismatch"), ScEcho (SeRaw "\"  expected: $($expectedBytes.Trim())\""), ScEcho (SeRaw "\"  got:      $($actualBytes.Trim())\""), ScExit (SeInt 1)] [], ScRaw "}"]

Section: B08 -- Size Check + Text Stages

  b08 : List ShellCmd = [ScEcho (SeLit "You settle beneath it and the buzz of dragonflies and the whisper"), ScEcho (SeLit "of the willow's swaying branches bring a deep peace."), ScEcho (SeLit ""), ScBlank, ScAssign "seedSize" (SeProperty (SeRaw "(Get-Item $SeedCdx)") "Length"), ScAssign "sutSize" (SeProperty (SeRaw "(Get-Item $SutCdx)") "Length"), ScRaw "$drift = [math]::Abs($sutSize - $seedSize); $maxDrift = [int]($seedSize * 0.05)", ScIf (SeRaw "$drift -gt $maxDrift") [ScEcho (SeLit "FAIL: SUT size drifted too far from seed"), ScEcho (SeRaw "\"  seed: $seedSize bytes  SUT: $sutSize bytes  drift: $drift (max $maxDrift)\""), ScExit (SeInt 1)] [], ScBlank, ScAssign "textStage1" (SeRaw "Join-Path $OutDir 'stage1.codex'"), ScAssign "textStage2" (SeRaw "Join-Path $OutDir 'stage2.codex'")]

  b08b : List ShellCmd = [ScEcho (SeLit "Searching inward for tranquility and happiness, you close your eyes."), ScRaw "Measure-Phase 'text-stage1' { if (-not (Invoke-BuildText -InputFile $CodexSrc -Kernel $SutCdx -Output $textStage1)) { exit 1 } }", ScBlank, ScRaw "Measure-Phase 'sem-equiv' {", ScRaw "    $semEquivScript = Join-Path $PSScriptRoot 'compare-codex-semantic.ps1'", ScRaw "    $prev = $ErrorActionPreference; $ErrorActionPreference = 'Continue'", ScRaw "    & pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1 2>&1 | Out-Null", ScRaw "    $ErrorActionPreference = $prev", ScIf (SeNot (SeExitCodeEq 0)) [ScEcho (SeLit "FAIL: semantic equivalence -- stage1 does not match source"), ScRaw "& pwsh -NoProfile -File $semEquivScript -Source $CodexSrc -Stage1 $textStage1", ScExit (SeInt 1)] [], ScRaw "}", ScBlank, ScEcho (SeLit "A high-pitched cascading sound like crystal wind-chimes impinges"), ScEcho (SeLit "on your floating awareness."), ScEcho (SeLit "")]

  b08c : List ShellCmd = [ScRaw "Measure-Phase 'text-stage2' { if (-not (Invoke-BuildText -InputFile $textStage1 -Kernel $SutCdx -Output $textStage2)) { exit 1 } }", ScBlank, ScRaw "Measure-Phase 'text-fixedpoint' {", ScHashFile "SHA256" "th1" (SeVar "textStage1"), ScHashFile "SHA256" "th2" (SeVar "textStage2"), ScIf (SeStringNeq (SeVar "th1") (SeVar "th2")) [ScEcho (SeLit "FAIL: text round-trip -- stage1 !== stage2"), ScEcho (SeRaw "\"  stage1: $((Get-Item $textStage1).Length) bytes  $th1\""), ScEcho (SeRaw "\"  stage2: $((Get-Item $textStage2).Length) bytes  $th2\""), ScExit (SeInt 1)] [], ScRaw "}"]

Section: B09 -- CDX Stages + Fixed Point

  b09 : List ShellCmd = [ScEcho (SeLit "As you open your eyes, you see a shimmering blueness rise from the ground."), ScEcho (SeLit ""), ScBlank, ScAssign "cdxStage1" (SeRaw "Join-Path $OutDir 'stage1.cdx'"), ScAssign "cdxStage2" (SeRaw "Join-Path $OutDir 'stage2.cdx'"), ScAssign "testKernel" (SeVar "cdxStage1"), ScBlank, ScEcho (SeLit "It is difficult to look at the blueness directly. The sound seems"), ScEcho (SeLit "to be emanating from this glowing portal."), ScRaw "Measure-Phase 'cdx-stage1' { if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $SutCdx -Output $cdxStage1)) { exit 1 } }", ScBlank, ScRaw "Measure-Phase 'cdx-fixedpoint' {", ScRaw "    $sutHash = Get-CdxContentHash $SutCdx; $ch1 = Get-CdxContentHash $cdxStage1", ScIf (SeStringEq (SeVar "sutHash") (SeVar "ch1")) [ScEcho (SeLit "(SUT === stage1 -- hard fixed point in one pass)")] [ScRaw "if (-not (Invoke-BuildCdx -InputFile $CodexSrc -Kernel $cdxStage1 -Output $cdxStage2)) { exit 1 }", ScRaw "$ch2 = Get-CdxContentHash $cdxStage2", ScIf (SeStringNeq (SeVar "ch1") (SeVar "ch2")) [ScEcho (SeLit "FAIL: CDX fixed point -- stage1 !== stage2"), ScExit (SeInt 1)] []], ScRaw "}"]

Section: B10 -- BVT + Closing

  b10 : List ShellCmd = [ScEcho (SeLit "Light seems to bend and distort around it, while the sound waves"), ScEcho (SeLit "become so intense, they appear to become visible."), ScEcho (SeLit ""), ScBlank, ScCopy (SeVar "cdxStage1") (SeRaw "Join-Path $OutDir 'NewSeed.cdx'"), ScBlank, ScEcho (SeLit "The portal hangs there for a moment; then with the rush of an"), ScEcho (SeLit "imploding vacuum, it sinks into the ground."), ScBlank, ScRaw "Measure-Phase 'test-bvt' {", ScRaw "    $bvtScript = Join-Path $PSScriptRoot 'bvt.ps1'; $testOut = Join-Path $OutDir 'test-results.txt'", ScRaw "    & pwsh -NoProfile -File $bvtScript -CodexCdx $testKernel -Jobs 4 > $testOut 2>&1", ScIf (SeNot (SeExitCodeEq 0)) [ScEcho (SeLit "FAIL: BVT"), ScRaw "Get-Content $testOut | ForEach-Object { Write-Host \"  $_\" }", ScExit (SeInt 1)] [], ScRaw "}"]

  b10b : List ShellCmd = [ScEcho (SeLit "Something remains suspended in mid-air for a moment before falling"), ScEcho (SeLit "to earth with a heavy thud."), ScEcho (SeLit ""), ScEcho (SeLit "Somewhat shaken by this vision, you rise to your feet to investigate."), ScEcho (SeLit "A crude circle of stones surrounds the spot where the portal appeared."), ScEcho (SeLit "There is something glinting in the grass."), ScEcho (SeLit ""), ScEcho (SeLit "You pick it up. It is a compiler."), ScEcho (SeLit "It is completely self-contained and needs no other tools to function."), ScEcho (SeLit "On the handle is inscribed: \"CODEX\"."), ScEcho (SeLit ""), ScBlank, ScRaw "$buildTimer.Stop()", ScEcho (SeLit "-- Phase Timings ----------------------------------"), ScRaw "$maxName = ($phaseTimings.Keys | ForEach-Object { $_.Length } | Measure-Object -Maximum).Maximum", ScForEach "kv" (SeRaw "$phaseTimings.GetEnumerator()") [ScRaw "$secs = $kv.Value.TotalSeconds; $pad = $kv.Key.PadRight($maxName)", ScRaw "Write-Host (\"  {0}  {1,7:N1}s\" -f $pad, $secs)"], ScRaw "Write-Host (\"  {0}  {1,7:N1}s\" -f 'TOTAL'.PadRight($maxName), $buildTimer.Elapsed.TotalSeconds)", ScEcho (SeLit ""), ScBlank, ScIf (SeFileExists (SeVar "chkConst")) [ScRaw "& pwsh -NoProfile -File $chkConst -Update 2>&1 | ForEach-Object { Write-Host \"  $_\" }"] [], ScBlank, ScExit (SeInt 0)]

Section: Assembly

  build-body : List ShellCmd = [ScSequence b01, ScBlank, ScSequence b02, ScBlank, ScSequence b02b, ScBlank, ScSequence b02c, ScBlank, ScSequence b03, ScBlank, ScSequence b04, ScBlank, ScSequence b05, ScBlank, ScSequence b06, ScBlank, ScSequence b07, ScBlank, ScSequence b08, ScBlank, ScSequence b08b, ScBlank, ScSequence b08c, ScBlank, ScSequence b09, ScBlank, ScSequence b10, ScBlank, ScSequence b10b]

  build-script : ShellScript = sh-script "build" "Full compiler build, verification, and test" [] build-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell build-script)
  end

