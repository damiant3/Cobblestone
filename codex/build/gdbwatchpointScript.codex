 We say:

Section: Parameters

  gdb-wp-params : List ShellParam = [sh-param "Src" SptString, sh-param-default "Watch" SptString (SeLit ""), sh-param-default "Break" SptString (SeLit ""), sh-param-default "ReadWatch" SptString (SeLit ""), sh-param-default "Accel" SptString (SeLit "tcg"), sh-param-default "TimeoutSec" SptInt (SeInt 300), sh-param-default "Kernel" SptString (SeLit "")]

Section: S01 -- Preamble

  s01 : List ShellCmd =
    let missing-kernel = [ScWriteError (SeRaw "\"MISSING: $Kernel\""), ScExit (SeInt 2)]
    in let no-mode = [ScWriteError (SeLit "Specify -Watch, -Break, or -ReadWatch with an address"), ScExit (SeInt 2)]
    in let whpx-watch = [ScWriteError (SeLit "WHPX does not support watchpoints. Use -Accel tcg or use -Break instead."), ScExit (SeInt 2)]
    in let no-gdb = [ScWriteError (SeLit "gdb not found in WSL. Install: sudo apt install gdb"), ScExit (SeInt 2)]
    in let bad-accel = [ScWriteError (SeLit "-Accel must be 'tcg' or 'whpx'"), ScExit (SeInt 2)]
    in [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRaw "Set-Location (Join-Path $PSScriptRoot '..')", ScRaw "[Environment]::CurrentDirectory = (Get-Location).Path", ScRaw "$env:USE_QEMU = '1'", ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScBlank, ScIf (SeNot (SeVar "Kernel")) [ScAssign "Kernel" (SeLit "build-output\\bare-metal\\Codex.cdx")] [], ScIf (SeNot (SeFileExists (SeVar "Kernel"))) missing-kernel [], ScIf (SeAnd (SeNot (SeStringEq (SeVar "Accel") (SeLit "tcg"))) (SeNot (SeStringEq (SeVar "Accel") (SeLit "whpx")))) bad-accel [], ScIf (SeAnd (SeAnd (SeNot (SeVar "Watch")) (SeNot (SeVar "Break"))) (SeNot (SeVar "ReadWatch"))) no-mode [], ScIf (SeAnd (SeStringEq (SeVar "Accel") (SeLit "whpx")) (SeOr (SeVar "Watch") (SeVar "ReadWatch"))) whpx-watch [], ScBlank, ScRaw "$gdbCheck = wsl -- which gdb 2>&1", ScIf (SeExitCodeEq 0 |> SeNot) no-gdb []]

Section: S02 -- Setup

  s02 : List ShellCmd =
    let build-bp = [ScRaw "$bpCmd = if ($Watch) { \"watch *(unsigned long long *)$addr\" } elseif ($ReadWatch) { \"rwatch *(unsigned long long *)$addr\" } else { \"hbreak *$addr\" }"]
    in [ScReadBytes "srcBytes" (SeVar "Src"), ScRaw "$addr = if ($Watch) { $Watch } elseif ($Break) { $Break } else { $ReadWatch }", ScBlank, ScComment "Build GDB command string", ScSequence build-bp]

Section: S03 -- GDB Script File

  s03 : List ShellCmd =
    let gdb-content = [ScRaw "$gdbContent = @\"\nset architecture i386:x86-64\ntarget remote localhost:1234\nset pagination off\nset confirm off\n$bpCmd\ncontinue\nprintf \"\"\\n=== STOPPED at %s ===\\n\"\", \"\"$bpCmd\"\"\nprintf \"\"RIP=%#lx RAX=%#lx RBX=%#lx RCX=%#lx\\n\"\", `$rip, `$rax, `$rbx, `$rcx\nprintf \"\"RDX=%#lx RSI=%#lx RDI=%#lx RBP=%#lx\\n\"\", `$rdx, `$rsi, `$rdi, `$rbp\nprintf \"\"R8=%#lx R9=%#lx R10=%#lx R11=%#lx\\n\"\", `$r8, `$r9, `$r10, `$r11\nprintf \"\"R12=%#lx R13=%#lx R14=%#lx R15=%#lx\\n\"\", `$r12, `$r13, `$r14, `$r15\nprintf \"\"RSP=%#lx\\n\"\", `$rsp\nprintf \"\"\\nDisassembly around RIP:\\n\"\"\nx/3i `$rip-16\nprintf \"\"----->\\n\"\"\nx/5i `$rip\nprintf \"\"\\nValue at watched address:\\n\"\"\nx/2gx $($addr)\nprintf \"\"\\nStack (8 slots):\\n\"\"\nx/8gx `$rsp\nprintf \"\"\\nBacktrace (RBP chain, 4 frames):\\n\"\"\nx/2gx `$rbp\nset `$_f1 = *(unsigned long long *)`$rbp\nx/2gx `$_f1\nkill\nquit\n\"@"]
    in [ScAssign "gdbFile" (SeRaw "Join-Path $env:TEMP \"codex-gdb-$PID.gdb\""), ScSequence gdb-content, ScSetContent (SeVar "gdbFile") (SeVar "gdbContent"), ScBlank, ScRaw "$wslGdbPath = $gdbFile -replace '^([A-Z]):', { '/mnt/' + $_.Groups[1].Value.ToLower() } -replace '\\\\', '/'", ScAssign "gdbOut" (SeRaw "Join-Path $env:TEMP \"codex-gdb-$PID.out\""), ScAssign "gdbErr" (SeRaw "Join-Path $env:TEMP \"codex-gdb-$PID.err\"")]

Section: S04 -- Launch QEMU

  s04 : List ShellCmd =
    let start-fail = [ScWriteError (SeLit "QEMU failed to start"), ScExit (SeInt 3)]
    in [ScRaw "$savedAccel = $script:FallbackAccelFlags", ScRaw "$script:FallbackAccelFlags = @('-accel', $Accel)", ScEcho (SeRaw "\"[1/4] Starting QEMU ($Accel mode) with GDB stub on :1234...\""), ScRaw "$run = Start-VmRun -Kernel $Kernel -ConnectTimeoutSec 30 -MemMB 3072 -ExtraArgs @('-gdb', 'tcp::1234', '-S')", ScRaw "$script:FallbackAccelFlags = $savedAccel", ScIf (SeNot (SeVar "run")) start-fail [], ScEcho (SeRaw "\"  PID=$($run.Process.Id)\"")]

Section: S05 -- Launch GDB

  s05 : List ShellCmd = [ScEcho (SeRaw "\"[2/4] Launching GDB ($bpCmd)...\""), ScRaw "$gdbProc = Start-Process -FilePath 'wsl' -ArgumentList @('--', 'timeout', \"$TimeoutSec\", '/usr/bin/gdb', '-batch', '-nx', '-x', $wslGdbPath) -PassThru -WindowStyle Hidden -RedirectStandardOutput $gdbOut -RedirectStandardError $gdbErr", ScRaw "Start-Sleep -Seconds 3"]

Section: S06 -- Wait for READY and Send Source

  s06 : List ShellCmd =
    let no-ready = [ScEcho (SeLit "READY not received within 120s."), ScEcho (SeLit "GDB output so far:"), ScIf (SeFileExists (SeVar "gdbOut")) [ScRaw "Get-Content $gdbOut | Select-Object -First 10"] [], ScExit (SeInt 4)]
    in [ScEcho (SeLit "[3/4] Waiting for READY..."), ScAssign "conn" (SeProperty (SeVar "run") "Conn"), ScIf (SeNot (SeRaw "Read-VmReady -Conn $conn -TimeoutSec 120")) no-ready [], ScBlank, ScComment "Send source bytes over TCP serial", ScRaw "$stream = $conn.Data.GetStream()", ScRaw "$hdr = [System.Text.Encoding]::UTF8.GetBytes(\"CDX`n\")", ScRaw "$stream.Write($hdr, 0, $hdr.Length)", ScRaw "$stream.Write($srcBytes, 0, $srcBytes.Length)", ScRaw "$stream.WriteByte(4)", ScRaw "$stream.Flush()", ScEcho (SeRaw "\"  Source sent ($($srcBytes.Length) bytes)\"")]

Section: S07 -- Wait for Hit

  s07 : List ShellCmd =
    let serial-check = [ScIf (SeRaw "$null -ne $line") [ScIf (SeOr (SeOr (SeStartsWith (SeVar "line") (SeLit "!EXC")) (SeStartsWith (SeVar "line") (SeLit "SIZE:"))) (SeStartsWith (SeVar "line") (SeLit "CODEGEN-"))) [ScEcho (SeRaw "\"SERIAL: $line\""), ScBreak] []] []]
    in let kill-gdb = [ScEcho (SeLit "GDB timed out - killing."), ScRaw "Stop-Process -Id $gdbProc.Id -Force -ErrorAction SilentlyContinue"]
    in [ScEcho (SeLit "[4/4] Waiting for watchpoint/breakpoint hit..."), ScRaw "$deadline = (Get-Date).AddSeconds($TimeoutSec)", ScLabeledWhile "wp_wait" (SeRaw "(Get-Date) -lt $deadline") [ScIf (SeProperty (SeVar "gdbProc") "HasExited") [ScBreak] [], ScRaw "$line = Read-StreamLine -Stream $stream -TimeoutSec 2", ScSequence serial-check], ScRaw "Start-Sleep -Seconds 2", ScIf (SeNot (SeProperty (SeVar "gdbProc") "HasExited")) kill-gdb []]

Section: S08 -- Report

  s08 : List ShellCmd =
    let stderr-out = [ScEcho (SeLit ""), ScEcho (SeLit "GDB STDERR:"), ScRaw "Write-Host $errTxt"]
    in [ScEcho (SeLit ""), ScEcho (SeLit "==========================================="), ScEcho (SeLit " GDB OUTPUT"), ScEcho (SeLit "==========================================="), ScIf (SeFileExists (SeVar "gdbOut")) [ScRaw "Get-Content $gdbOut"] [], ScRaw "$errTxt = if (Test-Path $gdbErr) { Get-Content $gdbErr -Raw } else { '' }", ScIf (SeAnd (SeRaw "$errTxt.Trim()") (SeNot (SeMatch (SeVar "errTxt") "^warning:"))) stderr-out []]

Section: S09 -- Cleanup

  s09 : List ShellCmd = [ScIf (SeVar "run") [ScRaw "Close-Vm -Conn $run.Conn -Process $run.Process"] [], ScRaw "Remove-Item -Force $gdbFile, $gdbOut, $gdbErr -ErrorAction SilentlyContinue"]

Section: Assembly

  gdb-wp-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScTry [ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08] [] s09]

  gdb-wp-script : ShellScript = sh-script "gdb-watchpoint" "Memory watchpoint / breakpoint debugger for bare-metal Codex via QEMU + GDB" gdb-wp-params gdb-wp-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell gdb-wp-script)
  end

