Chapter: MeasureSurveyScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  ms-params : List ShellParam = [sh-param "Src" SptString, sh-param-default "MemMB" SptInt (SeInt 3072), sh-param-default "Survey" SptString (SeLit ""), sh-param-default "Kernel" SptString (SeLit "")]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SeRaw "(Resolve-Path (Join-Path $PSScriptRoot '..')).Path"), ScRaw "Push-Location $Repo", ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'quire-map.ps1')"), ScRaw "$citePat = New-CitePattern -ExtraQuires @('Codex')"]

Section: S02 -- Index Codex Compiler Chapters

  s02 : List ShellCmd = [ScBlank, ScAssign "codexIndex" SeHashLiteral, ScForEach "f" (SeRaw "Get-ChildItem (Join-Path $Repo 'codex\\compiler') -Recurse -Filter *.codex") [ScForEach "l" (SeRaw "[System.IO.File]::ReadAllLines($f.FullName)") [ScIf (SeMatch (SeVar "l") "^Chapter:\\s*(.+?)\\s*$") [ScRaw "$codexIndex[$matches[1].Trim()] = $f.FullName", ScBreak] []]]]

Section: S03 -- Resolve Cites

  s03 : List ShellCmd = [ScDotNetCallAssign "srcLines" "System.IO.File" "ReadAllLines" [SeVar "Src"], ScAssign "seedSeen" SeHashLiteral, ScForEach "line" (SeVar "srcLines") [ScIf (SeMatch (SeVar "line") "^Chapter:\\s*(\\w+)--(.+?)\\s*$") [ScRaw "$seedSeen[\"$($matches[1])::$($matches[2])\"] = $true"] []], ScAssign "ordered" (SeRaw "Resolve-CiteOrder -RootLines $srcLines -Repo $Repo -Pattern $citePat -SeedSeen $seedSeen -OnMissing skip -PathOverride { param($quire, $name) if ($quire -eq 'Codex') { $codexIndex[$name] } else { $null } }")]

Section: S04 -- Build Input

  s04-body-build : List ShellCmd = [ScDotNetCallAssign "bodySb" "System.Text.StringBuilder" "new" [SeInt 2097152], ScForEach "l" (SeRaw "Format-CiteChapters -Ordered $ordered") [ScRaw "[void]$bodySb.Append($l + \"`n\")"], ScForEach "line" (SeVar "srcLines") [ScRaw "[void]$bodySb.Append($line + \"`n\")"], ScAssign "body" (SeMethodCall (SeVar "bodySb") "ToString" [])]

  s04 : List ShellCmd = [ScDotNetCallAssign "sb" "System.Text.StringBuilder" "new" [SeInt 2097152], ScAssign "mode" (SeLit "TEXT"), ScIf (SeVar "Survey") [ScAssign "mode" (SeRaw "\"$mode survey=$Survey\"")] [], ScRaw "[void]$sb.Append(\"$mode`n\")", ScSequence s04-body-build, ScRaw "[void]$sb.Append($body)", ScRaw "[void]$sb.Append([char]4)"]

Section: S05 -- Density Metrics

  s05 : List ShellCmd = [ScAssign "S" (SeProperty (SeVar "body") "Length"), ScAssign "records" (SeRaw "([regex]::Matches($body, '=\\s*(mutable\\s+)?record\\s*\\{')).Count"), ScAssign "variants" (SeRaw "([regex]::Matches($body, '(?m)^\\s+\\|\\s')).Count"), ScAssign "fields" (SeRaw "([regex]::Matches($body, '(?m)^\\s+[a-z][\\w-]*\\s*:\\s')).Count"), ScAssign "arrows" (SeRaw "([regex]::Matches($body, '->')).Count"), ScAssign "whens" (SeRaw "([regex]::Matches($body, '(?m)\\bwhen\\b')).Count")]

Section: S06 -- VM Run

  s06 : List ShellCmd = [ScAssign "vm" (SeRaw "Join-Path $Repo 'tools\\codex-vm.exe'"), ScTempFile "inFile", ScTempFile "outFile", ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "inFile", SeMethodCall (SeVar "sb") "ToString" [], SeRaw "[System.Text.UTF8Encoding]::new($false)"], ScAssign "kern" (SeRaw "if ($Kernel) { $Kernel } else { Join-Path $Repo 'seed\\Codex.cdx' }"), ScRaw "& $vm -kernel $kern -input $inFile -output $outFile -mem $MemMB -headless 2>&1 | Out-Null", ScDotNetCallAssign "o" "System.IO.File" "ReadAllText" [SeVar "outFile"], ScDelete (SeVar "inFile"), ScDelete (SeVar "outFile"), ScRaw "Pop-Location"]

Section: S07 -- Report

  s07-parse : List ShellCmd = [ScIf (SeMatch (SeVar "_") "WD:PM-(\\w+):deck-origin=(\\d+),deck-end=(\\d+),deck-usage=(\\d+),bivy-hwm=(\\d+),bivy-usage=(\\d+)") [ScRaw "$phase=$matches[1]; $du=[long]$matches[4]; $bu=[long]$matches[6]", ScRaw "Write-Host (\"  {0,-8} deck-usage={1,12:N0}  bivy-usage={2,12:N0}  deck/S={3,7:N1}  bivy/S={4,7:N1}\" -f $phase,$du,$bu,($du/$S),($bu/$S))"] []]

  s07 : List ShellCmd = [ScAssign "name" (SeStaticCall "System.IO.Path" "GetFileNameWithoutExtension" [SeVar "Src"]), ScRaw "Write-Host (\"WORKLOAD={0}  S={1}  records={2}  variant-ctors={3}  fields={4}  arrows={5}  whens={6}\" -f $name,$S,$records,$variants,$fields,$arrows,$whens)", ScAssign "halted" (SeRaw "$o -match 'CODEGEN-HALTED|CDX9002|Deck overflow'"), ScIf (SeVar "halted") [ScRaw "Write-Host \"  *** HALTED/OVERFLOW (survey too low or compile error) ***\""] [], ScForEach "_" (SeRaw "$o -split \"`n\" | Where-Object { $_ -match 'WD:PM-' }") s07-parse]

Section: Assembly

  ms-body : List ShellCmd = [ScSequence s01, ScSequence s02, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07]

  ms-script : ShellScript = sh-script "measure-survey" "Profile per-phase deck usage for a workload to inform survey heuristics" ms-params ms-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell ms-script)
  end

