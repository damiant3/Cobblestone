 We say:

Section: Parameters

  test-params : List ShellParam = [sh-param-optional "CodexCdx" SptString, sh-param-default "Jobs" SptInt (SeInt 4), sh-switch "ErrorsOnly", sh-switch "NoErrors", sh-switch "Apps", sh-switch "FW", sh-switch "All", sh-switch "Lib", sh-switch "Slow", sh-switch "Fatal", sh-param-default "Tier" SptStringArray (SeRaw "@()"), sh-param-optional "ApprovedBy" SptString, sh-switch "AllowStaleKernel"]

Section: T01 -- Usage, the Approval Gate and Preamble

  t01 : List ShellCmd = [ScComment "Phase 1: batch-compile all non-skipped tests through persistent VM", ScComment "          instances (one per job slot, repl-loop reuse).", ScComment "Phase 2: run compiled tests that have .expected files (individual VM", ScComment "          per test, parallel).", ScComment "", ScComment "Usage:", ScComment "  build/test.ps1 [-CodexCdx FP] [-Jobs N] [-ErrorsOnly | -NoErrors]", ScComment "  build/test.ps1 -Tier lang          # codex\\test + codex\\test\\ops + codex\\test\\errors (the default)", ScComment "  build/test.ps1 -Tier lib           # codex\\test\\lib", ScComment "  build/test.ps1 -Tier fw            # codex\\test\\forewords", ScComment "  build/test.ps1 -Tier apps          # codex\\test\\apps", ScComment "  build/test.ps1 -Tier hardware      # machine-sidecar tests from every dir", ScComment "  build/test.ps1 -Tier traps         # the safety set: bounds, trap and fault", ScComment "                                     # demos that assert the guest DIES. A", ScComment "                                     # filter over .fatal from every dir, and", ScComment "                                     # it implies -Fatal", ScComment "  build/test.ps1 -Tier slow          # a filter over .slow; implies -Slow", ScComment "                                     # (.smp/.vmargs/.disk/.disk2/.keys)", ScComment "  build/test.ps1 -Tier oracles       # oracle-scalar/-vector/-cce, the", ScComment "                                     # author-owned differential collections", ScComment "  build/test.ps1 -Tier all           # every tier above INCLUDING oracles", ScComment "  build/test.ps1 -Tier lib,apps      # tiers combine", ScComment "  build/test.ps1 -All                # lang+lib+fw+apps+oracles", ScComment "  build/test.ps1 -All -Slow          # include slow tests too", ScComment "  build/test.ps1 -Fatal              # include fatal tests (GPF/exception demos)", ScComment "", ScComment "Legacy switches (-Apps/-FW/-Lib/-All) map onto tiers. -Fuzz was removed", ScComment "2026-07-27: codex\\test\\fuzz never existed. Every run writes", ScComment "test-output\\_results\\_rollup.txt and a delta against the previous run", ScComment "(test-output\\last-run.json): newly red, fixed, added, removed.", ScComment "", ScComment "Every run requires -ApprovedBy damian. The battery is run by Damian or", ScComment "with his per-run go-ahead, never on an agent's initiative -- see", ScComment "CLAUDE.md rule 1. The gate below is deliberate; do not work around it.", ScComment "", ScComment "Sidecars (all optional, presence-driven):", ScComment "  codex*.test\\foo.expected  -- compile must SUCCEED, runtime output must match", ScComment "  codex*.test\\foo.failing   -- compile must FAIL with listed CDX error codes.", ScComment "                              A line may also be `CDX2031@33:5`, which pins", ScComment "                              the reported line:column as well as the code.", ScComment "                              Use it whenever the test exists BECAUSE of a", ScComment "                              position: a bare code cannot fail on a lost", ScComment "                              one, since a 0,0 span prints no prefix at all.", ScComment "  codex*.test\\foo.diag      -- compile must SUCCEED and emit each listed CDX", ScComment "                              code at any severity (warning/info/error). One", ScComment "                              code per line; bare number or CDX-prefixed. Use", ScComment "                              with .expected to also check runtime output.", ScComment "  codex*.test\\foo.disk-src  -- first line names ANOTHER test; that test's", ScComment "                              freshly compiled CDX is attached as this", ScComment "                              test's disk. A .disk names a file and is", ScComment "                              therefore frozen, which is no use to a test", ScComment "                              that pins what the CURRENT compiler emits.", ScComment "  codex*.test\\foo.skip      -- skipped entirely (first line = reason)", ScComment "  codex*.test\\foo.slow      -- skipped unless -Slow is passed (first line = reason)", ScComment "  codex*.test\\foo.fatal     -- skipped unless -Fatal is passed (kills VM at runtime)", ScComment "", ScComment "Exit status: 0 iff every sample ends in its expected bucket.", ScBlank, ScSetStrictMode, ScSetErrorStop, ScRaw "if ($ApprovedBy -ne 'damian') {", ScRaw "    Write-Host ''", ScRaw "    Write-Host 'REFUSED: the full battery runs only with explicit human approval.' -ForegroundColor Red", ScRaw "    Write-Host ''", ScRaw "    Write-Host 'Agent: this is not part of your verification loop, and passing the'", ScRaw "    Write-Host 'approval flag without Damian saying so in THIS session is a lie.'", ScRaw "    Write-Host 'Verify your change with:'", ScRaw "    Write-Host '    build/build.ps1                                  # the standing gate'", ScRaw "    Write-Host '    build/compile.ps1 -Src <t> -Out <o> -Log <log>   # one test'", ScRaw "    Write-Host ''", ScRaw "    Write-Host 'If you believe this change warrants a battery run, tell Damian why'", ScRaw "    Write-Host 'in one sentence and stop. He runs it, or hands you the command.'", ScRaw "    Write-Host ''", ScRaw "    exit 1", ScRaw "}", ScBlank, ScRaw "Set-Location (Join-Path $PSScriptRoot '..')", ScRaw "[Environment]::CurrentDirectory = (Get-Location).Path", ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScRaw "$Scope = if ($ErrorsOnly) { 'errors' } elseif ($NoErrors) { 'positive' } else { 'both' }", ScRaw "$OutRoot     = 'test-output'", ScRaw "$ResultsDir  = Join-Path $OutRoot '_results'", ScRaw "New-Item -ItemType Directory -Force -Path $OutRoot | Out-Null", ScRaw "if (Test-Path $ResultsDir) { Remove-Item -Recurse -Force $ResultsDir }", ScRaw "New-Item -ItemType Directory -Force -Path $ResultsDir | Out-Null", ScBlank, ScRaw "$TestLog = Join-Path $OutRoot 'test.log'", ScRaw "Set-Content -Path $TestLog -Value '' -Encoding UTF8", ScRaw "$env:CODEX_SWEEP_LOG = (Resolve-Path $TestLog).Path"]

Section: T02 -- Tiers and Test Gathering

  t02 : List ShellCmd = [ScComment "===========================================================================", ScComment "Tiers. Named subsets so -All stops being the only word for \"more\". The", ScComment "legacy switches map onto them; -ErrorsOnly/-NoErrors still narrow the lang", ScComment "tier. `hardware` is a FILTER over every directory (tests that carry a", ScComment "machine sidecar), not a directory of its own. `oracles` invokes the", ScComment "author-owned differential collections (reek's oracle-scalar, blu's", ScComment "oracle-vector) and reports their verdicts. Damian's call 2026-07-27: the", ScComment "pin goes wherever it helps, so the oracles run in -All and in the gate", ScComment "(build.ps1) as well -- measured at 2s + 1s, they cost nothing worth", ScComment "counting. The collections stay author-owned.", ScComment "", ScComment "`codex\\test\\ops` is the operator-correctness-by-operand-type axis, part", ScComment "of the lang tier: pins for operators that were right on the operand types", ScComment "somebody tested and wrong on one nobody did (the Real-comparison class),", ScComment "organized by axis rather than by feature, plus the axis smoke bundles.", ScComment "===========================================================================", ScRaw "$tiers = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)", ScRaw "foreach ($t in $Tier) { [void]$tiers.Add($t.Trim()) }", ScRaw "if ($Apps) { [void]$tiers.Add('apps') }", ScRaw "if ($FW)   { [void]$tiers.Add('fw') }", ScRaw "if ($Lib)  { [void]$tiers.Add('lib') }", ScRaw "if ($All)  { foreach ($t in 'lang', 'lib', 'fw', 'apps', 'oracles') { [void]$tiers.Add($t) } }", ScRaw "if ($tiers.Contains('all')) {", ScRaw "    foreach ($t in 'lang', 'lib', 'fw', 'apps', 'oracles') { [void]$tiers.Add($t) }", ScRaw "    [void]$tiers.Remove('all')", ScRaw "}", ScRaw "$known = @('lang', 'lib', 'fw', 'apps', 'hardware', 'oracles', 'traps', 'slow')", ScRaw "foreach ($t in $tiers) {", ScRaw "    if ($t -notin $known) { Write-Host \"unknown tier '$t' (known: $($known -join ', '))\" -ForegroundColor Red; exit 1 }", ScRaw "}", ScBlank, ScComment "A tier that selects tests and then skips them is worse than no tier: it", ScComment "reports coverage it did not run. `traps` and `slow` therefore IMPLY their", ScComment "switch, so `-Tier traps` cannot land in the pre-filter and be filed SKIPPED.", ScRaw "$runFatal = $Fatal.IsPresent -or $tiers.Contains('traps')", ScRaw "$runSlow  = $Slow.IsPresent  -or $tiers.Contains('slow')", ScComment "A bare invocation runs the language tier: the battery's subject is the", ScComment "compiler. An explicit tier list is taken at its word -- `-Tier oracles`", ScComment "alone runs the collections and no tests.", ScRaw "if ($tiers.Count -eq 0) { [void]$tiers.Add('lang') }", ScBlank, ScRaw "$machineSidecars = @('.smp', '.vmargs', '.disk', '.disk2', '.keys')", ScRaw "function Test-MachineSidecar {", ScRaw "    param([string]$Src)", ScRaw "    $dir = [System.IO.Path]::GetDirectoryName($Src)", ScRaw "    $name = [System.IO.Path]::GetFileNameWithoutExtension($Src)", ScRaw "    foreach ($ext in $script:machineSidecars) {", ScRaw "        if (Test-Path -PathType Leaf (Join-Path $dir \"$name$ext\")) { return $true }", ScRaw "    }", ScRaw "    return $false", ScRaw "}", ScBlank, ScRaw "$allDirs = @('codex\\test', 'codex\\test\\ops', 'codex\\test\\errors', 'codex\\test\\apps', 'codex\\test\\forewords', 'codex\\test\\lib')", ScRaw "$seen = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)", ScRaw "$tests = [System.Collections.Generic.List[string]]::new()", ScRaw "$tierDirs = [System.Collections.Generic.List[string]]::new()", ScRaw "if ($tiers.Contains('lang')) {", ScRaw "    if ($Scope -ne 'errors')   { $tierDirs.Add('codex\\test'); $tierDirs.Add('codex\\test\\ops') }", ScRaw "    if ($Scope -ne 'positive') { $tierDirs.Add('codex\\test\\errors') }", ScRaw "}", ScRaw "if ($tiers.Contains('apps')) { $tierDirs.Add('codex\\test\\apps') }", ScRaw "if ($tiers.Contains('fw'))   { $tierDirs.Add('codex\\test\\forewords') }", ScRaw "if ($tiers.Contains('lib'))  { $tierDirs.Add('codex\\test\\lib') }", ScRaw "foreach ($d in $tierDirs) {", ScRaw "    Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {", ScRaw "        if ($seen.Add($_.FullName)) { $tests.Add($_.FullName) }", ScRaw "    }", ScRaw "}", ScRaw "if ($tiers.Contains('hardware')) {", ScRaw "    foreach ($d in $allDirs) {", ScRaw "        Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {", ScRaw "            if ((Test-MachineSidecar $_.FullName) -and $seen.Add($_.FullName)) { $tests.Add($_.FullName) }", ScRaw "        }", ScRaw "    }", ScRaw "}", ScComment "`traps` and `slow` are FILTERS over every directory, like `hardware`, not", ScComment "directories of their own: these tests live among their neighbours and are", ScComment "identified by a sidecar. `traps` is the safety set -- the bounds, trap and", ScComment "fault demos that assert the guest DIES.", ScRaw "foreach ($pair in @(@{ Tier = 'traps'; Ext = '.fatal' }, @{ Tier = 'slow'; Ext = '.slow' })) {", ScRaw "    if (-not $tiers.Contains($pair.Tier)) { continue }", ScRaw "    foreach ($d in $allDirs) {", ScRaw "        Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {", ScRaw "            $sc = Join-Path $_.DirectoryName ([System.IO.Path]::GetFileNameWithoutExtension($_.Name) + $pair.Ext)", ScRaw "            if ((Test-Path -PathType Leaf $sc) -and $seen.Add($_.FullName)) { $tests.Add($_.FullName) }", ScRaw "        }", ScRaw "    }", ScRaw "}"]

Section: T03 -- Kernel Provenance and Pre-filter

  t03 : List ShellCmd = [ScComment "--- Which compiler is on trial, and is it the one you think? ---------------", ScComment "", ScComment "The battery compiles every sample with build-output\\bare-metal\\Codex.cdx.", ScComment "Nothing used to state which compiler that was, or check it: the digest was", ScComment "computed at the END and written to the rollup as stage0=..., compared", ScComment "against nothing. On 2026-08-03 a release battery ran a whole tree against a", ScComment "kernel left behind by an earlier -CodexCdx run -- a compiler six days and", ScComment "two seeds stale -- and reported 11 failures that were all the antique", ScComment "compiler missing features the tests use. The run cost 12 minutes and nearly", ScComment "blocked a release on defects that did not exist.", ScComment "", ScComment "So: name the kernel up front, and refuse to run one whose provenance is", ScComment "unknown. Legitimate kernels are the depot seed (a fresh workspace) or the", ScComment "last build's signed output (the normal edit-build-test loop). Anything else", ScComment "is a leftover, and -CodexCdx is how you ask for one on purpose.", ScRaw "$stage0 = Join-Path (Resolve-Path .).Path 'build-output\\bare-metal\\Codex.cdx'", ScRaw "$kernelBackup = \"$stage0.prebattery\"", ScRaw "$script:RestoreKernel = $false", ScBlank, ScRaw "function Get-Digest([string]$p) {", ScRaw "    if ($p -and (Test-Path $p)) { return (Get-FileHash -Algorithm SHA256 $p).Hash }", ScRaw "    return $null", ScRaw "}", ScBlank, ScRaw "$seedDigest = Get-Digest 'seed\\Codex.cdx'", ScRaw "$sutDigest  = Get-Digest 'build\\output\\Sut.cdx'", ScBlank, ScRaw "if ($CodexCdx) {", ScRaw "    if (-not (Test-Path $CodexCdx)) { Write-Host \"REFUSED: -CodexCdx '$CodexCdx' does not exist.\"; exit 2 }", ScRaw "    New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "    # Put the working kernel back afterwards. This script used to leave the", ScRaw "    # substitute installed, which is how the stale kernel above was born.", ScRaw "    if (Test-Path $stage0) { Copy-Item -Force $stage0 $kernelBackup; $script:RestoreKernel = $true }", ScRaw "    Copy-Item -Force $CodexCdx $stage0", ScRaw "    Write-Host \"battery compiler: EXPLICIT -CodexCdx $CodexCdx\"", ScRaw "    Write-Host \"                  $((Get-Digest $stage0).Substring(0,16))  $((Get-Item $stage0).Length) bytes\"", ScRaw "    if ($script:RestoreKernel) { Write-Host \"                  (working kernel saved; restored when the run ends)\" }", ScRaw "} else {", ScRaw "    if (-not (Test-Path $stage0)) {", ScRaw "        if (-not $seedDigest) { Write-Host \"REFUSED: no battery kernel and no seed\\Codex.cdx to install from. Run build\\build.ps1.\"; exit 2 }", ScRaw "        New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null", ScRaw "        Copy-Item -Force 'seed\\Codex.cdx' $stage0", ScRaw "        Write-Host \"battery compiler: installed from seed (no kernel present)\"", ScRaw "    }", ScRaw "    $kDigest = Get-Digest $stage0", ScRaw "    $origin = if ($kDigest -eq $sutDigest) { 'last build (build\\output\\Sut.cdx)' }", ScRaw "              elseif ($kDigest -eq $seedDigest) { 'depot seed (seed\\Codex.cdx)' }", ScRaw "              else { $null }", ScRaw "    if (-not $origin) {", ScRaw "        Write-Host ''", ScRaw "        Write-Host '=== REFUSED: the battery kernel has unknown provenance ==='", ScRaw "        Write-Host \"  kernel : $($kDigest.Substring(0,16))  $((Get-Item $stage0).Length) bytes  $((Get-Item $stage0).LastWriteTime)\"", ScRaw "        Write-Host \"  seed   : $(if ($seedDigest) { $seedDigest.Substring(0,16) } else { '<missing>' })\"", ScRaw "        Write-Host \"  Sut    : $(if ($sutDigest)  { $sutDigest.Substring(0,16)  } else { '<none -- no build in this workspace>' })\"", ScRaw "        Write-Host ''", ScRaw "        Write-Host '  It matches neither the depot seed nor the last build, so it is a'", ScRaw "        Write-Host '  leftover -- usually a compiler an earlier -CodexCdx run installed.'", ScRaw "        Write-Host '  A battery against it tests that compiler, not this tree, and its'", ScRaw "        Write-Host '  failures are fiction.'", ScRaw "        Write-Host ''", ScRaw "        Write-Host '  Fix (pick one):'", ScRaw "        Write-Host '    build\\build.ps1                     # build this tree, then re-run'", ScRaw "        Write-Host '    Copy-Item -Force seed\\Codex.cdx build-output\\bare-metal\\Codex.cdx'", ScRaw "        Write-Host '    build\\test.ps1 -CodexCdx <path> ... # if you meant to test another compiler'", ScRaw "        Write-Host '    build\\test.ps1 -AllowStaleKernel ... # you know exactly what this is'", ScRaw "        Write-Host ''", ScRaw "        if (-not $AllowStaleKernel) { exit 2 }", ScRaw "        Write-Host '  -AllowStaleKernel given: proceeding anyway.'", ScRaw "    } else {", ScRaw "        Write-Host \"battery compiler: $($kDigest.Substring(0,16))  $((Get-Item $stage0).Length) bytes  <- $origin\"", ScRaw "    }", ScRaw "}", ScBlank, ScRaw "function Restore-Kernel {", ScRaw "    if ($script:RestoreKernel -and (Test-Path $kernelBackup)) {", ScRaw "        Copy-Item -Force $kernelBackup $stage0", ScRaw "        Remove-Item -Force $kernelBackup", ScRaw "        Write-Host \"battery compiler: working kernel restored ($((Get-Digest $stage0).Substring(0,16)))\"", ScRaw "    }", ScRaw "}", ScBlank, ScComment "===========================================================================", ScComment "Pre-filter: handle skips, partition into compile lists", ScComment "===========================================================================", ScRaw "$toCompile = [System.Collections.Generic.List[string]]::new()", ScRaw "$srcDirOf = @{}", ScRaw "$catOf = @{}", ScRaw "foreach ($src in $tests) {", ScRaw "    $name = [System.IO.Path]::GetFileNameWithoutExtension($src)", ScRaw "    $dir  = [System.IO.Path]::GetDirectoryName($src)", ScRaw "    $srcDirOf[$name] = $dir", ScRaw "    $leaf = Split-Path -Leaf $dir", ScRaw "    $catOf[$name] = if ($leaf -eq 'test') { 'root' } else { $leaf }", ScRaw "    $skipFile = Join-Path $dir \"$name.skip\"", ScRaw "    $slowFile = Join-Path $dir \"$name.slow\"", ScRaw "    if (Test-Path -PathType Leaf $skipFile) {", ScRaw "        $reason = (Get-Content -TotalCount 1 $skipFile)", ScRaw "        $resultFile = Join-Path $ResultsDir $name", ScRaw "        \"SKIPPED`t$name`t$reason\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "    } elseif (-not $runSlow -and (Test-Path -PathType Leaf $slowFile)) {", ScRaw "        $reason = (Get-Content -TotalCount 1 $slowFile)", ScRaw "        $resultFile = Join-Path $ResultsDir $name", ScRaw "        \"SKIPPED`t$name`t(slow) $reason\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "    } elseif (-not $runFatal -and (Test-Path -PathType Leaf (Join-Path $dir \"$name.fatal\"))) {", ScRaw "        $reason = (Get-Content -TotalCount 1 (Join-Path $dir \"$name.fatal\"))", ScRaw "        $resultFile = Join-Path $ResultsDir $name", ScRaw "        \"SKIPPED`t$name`t(fatal) $reason\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "    } else {", ScRaw "        $toCompile.Add($src)", ScRaw "    }", ScRaw "}", ScBlank, ScComment "Sort lightest-first: tests with fewer cites compile smaller source concats", ScComment "and consume less heap, so the batch VM gets through more tests before", ScComment "exhausting the 3GB arena.", ScRaw "$toCompile = @($toCompile | Sort-Object {", ScRaw "    $m = Select-String -Path $_ -Pattern '^\\s*cites' -ErrorAction SilentlyContinue", ScRaw "    if ($m) { @($m).Count } else { 0 }", ScRaw "})", ScBlank, ScRaw "# Each batch slot boots one guest, so concurrent guests IS $Jobs. Trim to what\n# the box holds before the deal below, which sizes its lists from $Jobs.\n#\n# A BATCH GUEST IS NOT A SINGLE-COMPILE GUEST and the difference is the whole\n# defect this argument fixes. One VM here compiles the slot's whole share in\n# ONE session, so its arena accumulates: measured 2026-08-28, 60 chapters\n# peaked at 234 MB, 200 at 1,007 MB, and one realistic slot of a 4-way deal\n# (416 chapters, 874 KB of source) at 2,134 MB. The default 1100 is the\n# SINGLE-unit figure, right for deck-headroom and for phase 2 below, where\n# every test gets a fresh VM. Budgeting a batch at it admitted four slots\n# needing ~8.5 GB on a box with ~6.5 GB free, and val's full gate died with\n# 1,110 tests reporting \"VM died EARLIER in the batch\".\n#\n# The first measurement that set 1100 sampled THIRTY chapters and generalised;\n# it read 1,098 MB only because those thirty were the largest by file size, so\n# a wrong number came out of a fixture whose shape was wrong twice over\n# (L-CONSTRUCT). Re-measure by sampling codex-vm's WorkingSet64 across a full\n# slot, never a subset (L-COUNT).", ScRaw "$Jobs = Get-VmAdmittedSlots -Slots $Jobs -GuestMB 2200 -What 'phase 1 batch compile'", ScRaw "Write-Host \"Tests: $($tests.Count) total, $($tests.Count - $toCompile.Count) skipped, $($toCompile.Count) to compile ($Jobs batch slots)\""]

Section: T04 -- Phase 1 Batch Compile and Crash Containment

  t04 : List ShellCmd = [ScComment "===========================================================================", ScComment "Phase 1: Batch compile -- one VM per job slot", ScComment "===========================================================================", ScRaw "$batchDir = Join-Path $OutRoot '_batches'", ScRaw "if (Test-Path $batchDir) { Remove-Item -Recurse -Force $batchDir }", ScRaw "New-Item -ItemType Directory -Force -Path $batchDir | Out-Null", ScBlank, ScRaw "$listFiles = @()", ScRaw "$writers = @()", ScRaw "for ($j = 0; $j -lt $Jobs; $j++) {", ScRaw "    $lf = Join-Path $batchDir \"batch-$j.txt\"", ScRaw "    $listFiles += $lf", ScRaw "    $writers += [System.IO.StreamWriter]::new($lf, $false, [System.Text.UTF8Encoding]::new($false))", ScRaw "}", ScComment "Dealt by the LAST run's measured unit size (.src-bytes under $OutRoot, which", ScComment "survives between runs), heaviest first onto the lightest batch, rather than", ScComment "$i % $Jobs. Measured 2026-08-20 at -Jobs 8: round-robin put 11.0 to 17.4 MB", ScComment "into the eight batches and their VMs ran 20 to 62 s; size-dealt, 14.2 MB each.", ScComment "A test with no reading goes to the batch with the fewest members (by load it", ScComment "would pile every new test onto one batch: measured, 110 of them on one slot),", ScComment "so a tree with no readings at all deals exactly as round-robin did. Heavy-first", ScComment "order is pinned by the original index, because Sort-Object -Descending reverses", ScComment "tied order and the control came out balanced but not round-robin. Each batch", ScComment "keeps the lightest-first order from above.", ScRaw "$weightOf = @{}", ScRaw "$indexOf = @{}", ScRaw "for ($i = 0; $i -lt $toCompile.Count; $i++) {", ScRaw "    $src = $toCompile[$i]", ScRaw "    $indexOf[$src] = $i", ScRaw "    $n = [System.IO.Path]::GetFileNameWithoutExtension($src)", ScRaw "    $sbF = Join-Path (Join-Path $OutRoot $n) '.src-bytes'", ScRaw "    $w = 0L", ScRaw "    if (Test-Path -PathType Leaf $sbF) {", ScRaw "        $sbText = (Get-Content -TotalCount 1 $sbF -ErrorAction SilentlyContinue)", ScRaw "        if ($sbText -and ($sbText.Trim() -match '^\\d+$')) { $w = [long]$sbText.Trim() }", ScRaw "    }", ScRaw "    $weightOf[$src] = $w", ScRaw "}", ScRaw "$slotOf = @{}", ScRaw "$slotLoad = New-Object 'long[]' $Jobs", ScRaw "$slotCount = New-Object 'int[]' $Jobs", ScRaw "$byWeight = @($toCompile | Sort-Object @{ Expression = { $weightOf[$_] }; Descending = $true }, @{ Expression = { $indexOf[$_] }; Descending = $false })", ScRaw "foreach ($src in $byWeight) {", ScRaw "    $k = 0", ScRaw "    if ($weightOf[$src] -gt 0) {", ScRaw "        for ($s = 1; $s -lt $Jobs; $s++) {", ScRaw "            if ($slotLoad[$s] -lt $slotLoad[$k] -or ($slotLoad[$s] -eq $slotLoad[$k] -and $slotCount[$s] -lt $slotCount[$k])) { $k = $s }", ScRaw "        }", ScRaw "    } else {", ScRaw "        for ($s = 1; $s -lt $Jobs; $s++) {", ScRaw "            if ($slotCount[$s] -lt $slotCount[$k] -or ($slotCount[$s] -eq $slotCount[$k] -and $slotLoad[$s] -lt $slotLoad[$k])) { $k = $s }", ScRaw "        }", ScRaw "    }", ScRaw "    $slotOf[$src] = $k", ScRaw "    $slotLoad[$k] += $weightOf[$src]", ScRaw "    $slotCount[$k] += 1", ScRaw "}", ScRaw "foreach ($src in $toCompile) { $writers[$slotOf[$src]].WriteLine($src) }", ScRaw "foreach ($w in $writers) { $w.Close() }", ScBlank, ScRaw "$compileScript = Join-Path $PSScriptRoot 'test-compile-batch.ps1'", ScRaw "$phase1Sw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "$compileProcs = @()", ScComment "The batch child's stderr is where test-compile-batch.ps1 reports a dropped", ScComment "or short stream (DROPPED / BATCH INVALIDATED). Start-Process gave it a", ScComment "hidden console, so that report was written where nobody could ever read it:", ScComment "the Update 52 misattribution shipped 26 false reds with the one line naming", ScComment "the cause discarded. Captured on the SYSTEM temp (a redirect is one write", ScComment "per stderr line and D: pays ~7.5 ms each), moved into _batches after.", ScRaw "$compileErrs = @()", ScRaw "for ($j = 0; $j -lt $Jobs; $j++) {", ScRaw "    $lf = $listFiles[$j]", ScRaw "    if ((Get-Item $lf).Length -eq 0) { continue }", ScRaw "    $pcore = ($j + 1) % 8", ScRaw "    $be = [System.IO.Path]::GetTempFileName()", ScRaw "    $proc = Start-Process -FilePath 'pwsh' -ArgumentList @(", ScRaw "        '-NoProfile', '-File', $compileScript,", ScRaw "        '-ListFile', $lf,", ScRaw "        '-OutRoot', $OutRoot,", ScRaw "        '-PCore', $pcore", ScRaw "    ) -PassThru -WindowStyle Hidden -RedirectStandardError $be", ScRaw "    $compileProcs += $proc", ScRaw "    $compileErrs += @{ Err = $be; Name = \"batch-$j\" }", ScRaw "    Write-Host \"  batch $j started (pid $($proc.Id), pcore $pcore)\"", ScRaw "}", ScBlank, ScRaw "Write-Host \"Waiting for $($compileProcs.Count) compile batches...\"", ScRaw "foreach ($proc in $compileProcs) {", ScRaw "    $proc.WaitForExit(1800000) | Out-Null", ScRaw "    if (-not $proc.HasExited) {", ScRaw "        Write-Host \"  batch pid $($proc.Id) timed out -- killing\" -ForegroundColor Yellow", ScRaw "        try { Stop-Process -Id $proc.Id -Force -ErrorAction Stop } catch {}", ScRaw "    }", ScRaw "}", ScRaw "foreach ($c in $compileErrs) {", ScRaw "    if (-not (Test-Path -PathType Leaf $c.Err)) { continue }", ScRaw "    $t = [System.IO.File]::ReadAllText($c.Err)", ScRaw "    Move-Item -Force $c.Err (Join-Path $batchDir \"$($c.Name).err\")", ScRaw "    if ($t -match 'DROPPED|BATCH INVALIDATED') { Write-Host \"  $($c.Name): $($t.Trim())\" -ForegroundColor Yellow }", ScRaw "}", ScRaw "$phase1Sw.Stop()", ScRaw "Write-Host \"Phase 1 (compile) complete in $([int]($phase1Sw.ElapsedMilliseconds/1000))s.\"", ScRaw "$retrySw = [System.Diagnostics.Stopwatch]::StartNew()", ScBlank, ScComment "===========================================================================", ScComment "Phase 1a: Contain batch-VM crashes.", ScComment "", ScComment "Exit 99 means the VM died before this test ran. A death also poisons the", ScComment "results BEFORE it in the same session: the batch REPL carries state across", ScComment "compiles, and a corrupted session reports phantom diagnostics (exit 7) or", ScComment "crashes (exit 4) the test does not produce standalone. See", ScComment "battery-triage-2026-07-23.", ScComment "", ScComment "The old design answered any death by re-running EVERY non-clean result", ScComment "standalone and sequentially: 683 tests and 479 s on the 2026-07-27", ScComment "baseline. Now, per round: the test that killed the VM (exit 4 with a !EXC", ScComment "dump in its build.log) gets one standalone compile, which is", ScComment "authoritative -- it can overturn a false failure but never manufacture a", ScComment "pass, because a genuine failure fails standalone too. Every OTHER", ScComment "non-clean result (4, 7, 99) from a batch that suffered a death is", ScComment "re-batched into fresh batch VMs, where a clean session either reproduces", ScComment "the failure or clears it. Rounds repeat until a round has no death (its", ScComment "results are then real, the prior behaviour for clean runs); after the", ScComment "round cap, whatever is left falls back to standalone.", ScComment "===========================================================================", ScRaw "$compileScript2 = Join-Path $PSScriptRoot 'compile.ps1'", ScRaw "$srcOf = @{}", ScRaw "foreach ($src in $toCompile) { $srcOf[[System.IO.Path]::GetFileNameWithoutExtension($src)] = $src }", ScRaw "$confirmed = @{}", ScBlank, ScRaw "function Get-BatchExit {", ScRaw "    param([string]$Name)", ScRaw "    $ef = Join-Path (Join-Path $OutRoot $Name) '.exitcode'", ScRaw "    if (Test-Path $ef) { (Get-Content -TotalCount 1 $ef).Trim() } else { '99' }", ScRaw "}", ScBlank, ScRaw "function Test-CrashDump {", ScRaw "    param([string]$Name)", ScRaw "    $log = Join-Path (Join-Path $OutRoot $Name) 'build.log'", ScRaw "    (Test-Path -PathType Leaf $log) -and (Select-String -Path $log -Pattern '!EXC' -SimpleMatch -Quiet)", ScRaw "}", ScBlank, ScRaw "function Invoke-StandaloneRetry {", ScRaw "    param([string]$Name)", ScRaw "    $src = $srcOf[$Name]", ScRaw "    $out = Join-Path $OutRoot $Name", ScRaw "    New-Item -ItemType Directory -Force -Path $out | Out-Null", ScRaw "    # The retry has to compile the test the way the batch would have: the", ScRaw "    # .flags sidecar rides along, or every .flags test becomes a false", ScRaw "    # failure at once (foreword-all-compile without decks=150, prose-anchor", ScRaw "    # without prose).", ScRaw "    $flagsFile = Join-Path ([System.IO.Path]::GetDirectoryName($src)) \"$Name.flags\"", ScRaw "    $rawFlags = if (Test-Path -PathType Leaf $flagsFile) { (Get-Content -TotalCount 1 $flagsFile).Trim() } else { '' }", ScRaw "    $retryArgs = @('-NoProfile', '-File', $compileScript2, '-Src', $src,", ScRaw "        '-Out', (Join-Path $out \"$Name.cdx\"), '-Log', (Join-Path $out 'build.log'))", ScRaw "    if ($rawFlags) { $retryArgs += @('-RawFlags', $rawFlags) }", ScRaw "    $p = Start-Process -FilePath 'pwsh' -ArgumentList $retryArgs -PassThru -WindowStyle Hidden", ScRaw "    $p.WaitForExit(120000) | Out-Null", ScRaw "    if (-not $p.HasExited) { try { Stop-Process -Id $p.Id -Force } catch {} }", ScRaw "    $retryExit = if ($p.HasExited) { $p.ExitCode } else { 4 }", ScRaw "    \"$retryExit\" | Set-Content -Path (Join-Path $out '.exitcode') -Encoding UTF8", ScRaw "    Write-Host \"  standalone $Name`: exit $retryExit\"", ScRaw "}", ScBlank, ScComment "Splits a death-batch's survivors across fresh batch VMs and returns the", ScComment "new membership (array of name arrays) for the next round's death analysis.", ScRaw "function Invoke-RebatchRound {", ScRaw "    param([string[]]$Names, [int]$RoundNum)", ScRaw "    $slots = [Math]::Max(1, [Math]::Min($Jobs, [int][Math]::Ceiling($Names.Count / 20.0)))", ScRaw "    $lists = @(); $rbWriters = @(); $membership = @()", ScRaw "    for ($k = 0; $k -lt $slots; $k++) {", ScRaw "        $lf = Join-Path $batchDir \"rebatch-$RoundNum-$k.txt\"", ScRaw "        $lists += $lf", ScRaw "        $rbWriters += [System.IO.StreamWriter]::new($lf, $false, [System.Text.UTF8Encoding]::new($false))", ScRaw "        $membership += ,@()", ScRaw "    }", ScRaw "    for ($i = 0; $i -lt $Names.Count; $i++) {", ScRaw "        $k = $i % $slots", ScRaw "        $rbWriters[$k].WriteLine($srcOf[$Names[$i]])", ScRaw "        $membership[$k] += $Names[$i]", ScRaw "    }", ScRaw "    foreach ($w in $rbWriters) { $w.Close() }", ScRaw "    $procs = @()", ScRaw "    $rbErrs = @()", ScRaw "    for ($k = 0; $k -lt $slots; $k++) {", ScRaw "        $be = [System.IO.Path]::GetTempFileName()", ScRaw "        $procs += Start-Process -FilePath 'pwsh' -ArgumentList @(", ScRaw "            '-NoProfile', '-File', $compileScript,", ScRaw "            '-ListFile', $lists[$k], '-OutRoot', $OutRoot, '-PCore', (($k + 1) % 8)", ScRaw "        ) -PassThru -WindowStyle Hidden -RedirectStandardError $be", ScRaw "        $rbErrs += @{ Err = $be; Name = \"rebatch-$RoundNum-$k\" }", ScRaw "    }", ScRaw "    foreach ($proc in $procs) {", ScRaw "        $proc.WaitForExit(1800000) | Out-Null", ScRaw "        if (-not $proc.HasExited) { try { Stop-Process -Id $proc.Id -Force -ErrorAction Stop } catch {} }", ScRaw "    }", ScRaw "    foreach ($c in $rbErrs) {", ScRaw "        if (-not (Test-Path -PathType Leaf $c.Err)) { continue }", ScRaw "        $t = [System.IO.File]::ReadAllText($c.Err)", ScRaw "        Move-Item -Force $c.Err (Join-Path $batchDir \"$($c.Name).err\")", ScRaw "        if ($t -match 'DROPPED|BATCH INVALIDATED') { Write-Host \"  $($c.Name): $($t.Trim())\" -ForegroundColor Yellow }", ScRaw "    }", ScRaw "    return ,$membership", ScRaw "}", ScBlank, ScComment "Which batches suffered a death, and what inside them needs what.", ScRaw "function Get-DeathRetrySets {", ScRaw "    param([object[]]$Batches)", ScRaw "    $crashers = [System.Collections.Generic.List[string]]::new()", ScRaw "    $rebatch  = [System.Collections.Generic.List[string]]::new()", ScRaw "    foreach ($members in $Batches) {", ScRaw "        $dead = $false", ScRaw "        foreach ($m in $members) {", ScRaw "            $e = Get-BatchExit $m", ScRaw "            if ($e -eq '99' -or ($e -eq '4' -and (Test-CrashDump $m))) { $dead = $true; break }", ScRaw "        }", ScRaw "        if (-not $dead) { continue }", ScRaw "        foreach ($m in $members) {", ScRaw "            if ($confirmed.ContainsKey($m)) { continue }", ScRaw "            $e = Get-BatchExit $m", ScRaw "            if ($e -eq '4' -and (Test-CrashDump $m)) { $crashers.Add($m) }", ScRaw "            elseif ($e -in '4', '7', '99') { $rebatch.Add($m) }", ScRaw "        }", ScRaw "    }", ScRaw "    @{ Crashers = $crashers; Rebatch = $rebatch }", ScRaw "}", ScBlank, ScRaw "$batches = @()", ScRaw "foreach ($lf in $listFiles) {", ScRaw "    $members = @(Get-Content $lf | Where-Object { $_.Trim() -ne '' } |", ScRaw "        ForEach-Object { [System.IO.Path]::GetFileNameWithoutExtension($_) })", ScRaw "    if ($members.Count -gt 0) { $batches += ,$members }", ScRaw "}", ScBlank, ScRaw "$roundCap = 5", ScRaw "$round = 0", ScRaw "while ($true) {", ScRaw "    $sets = Get-DeathRetrySets -Batches $batches", ScRaw "    foreach ($name in $sets.Crashers) {", ScRaw "        if ($confirmed.ContainsKey($name)) { continue }", ScRaw "        Write-Host \"  batch-killer $name -- confirming standalone\"", ScRaw "        Invoke-StandaloneRetry $name", ScRaw "        $confirmed[$name] = $true", ScRaw "    }", ScRaw "    if ($sets.Rebatch.Count -eq 0) { break }", ScRaw "    $round++", ScRaw "    if ($round -gt $roundCap) {", ScRaw "        Write-Host \"Phase 1a: round cap reached; $($sets.Rebatch.Count) tests fall back to standalone...\"", ScRaw "        foreach ($name in $sets.Rebatch) { Invoke-StandaloneRetry $name }", ScRaw "        break", ScRaw "    }", ScRaw "    Write-Host \"Phase 1a round ${round}: re-batching $($sets.Rebatch.Count) tests from death-batches...\"", ScRaw "    $batches = Invoke-RebatchRound -Names $sets.Rebatch -RoundNum $round", ScRaw "}", ScBlank, ScComment "A deck overflow (CDX9002) reported from a batch session can be the", ScComment "session's cumulative arena state rather than the test's own demand:", ScComment "foreword-all-compile hit LOWER's deck floor in a shared VM (2026-07-27)", ScComment "and compiles clean standalone with the same flags and seed. Batch deck", ScComment "overflows are therefore always confirmed standalone -- they are rare,", ScComment "and a genuine one fails standalone too.", ScRaw "foreach ($src in $toCompile) {", ScRaw "    $name = [System.IO.Path]::GetFileNameWithoutExtension($src)", ScRaw "    if ($confirmed.ContainsKey($name)) { continue }", ScRaw "    $ef = Join-Path (Join-Path $OutRoot $name) '.exitcode'", ScRaw "    if ((Test-Path $ef) -and ((Get-Content -TotalCount 1 $ef).Trim() -eq '7')) {", ScRaw "        $log = Join-Path (Join-Path $OutRoot $name) 'build.log'", ScRaw "        if ((Test-Path -PathType Leaf $log) -and (Select-String -Path $log -Pattern 'CDX9002' -SimpleMatch -Quiet)) {", ScRaw "            Write-Host \"  deck overflow in batch: $name -- confirming standalone\"", ScRaw "            Invoke-StandaloneRetry $name", ScRaw "        }", ScRaw "    }", ScRaw "}", ScBlank, ScRaw "$retrySw.Stop()"]

Section: T05 -- Classify and Phase 2 Run

  t05 : List ShellCmd = [ScComment "===========================================================================", ScComment "Phase 1b: Classify compile results", ScComment "===========================================================================", ScRaw "$needsRun = [System.Collections.Generic.List[hashtable]]::new()", ScRaw "foreach ($src in $toCompile) {", ScRaw "    $name = [System.IO.Path]::GetFileNameWithoutExtension($src)", ScRaw "    $dir  = [System.IO.Path]::GetDirectoryName($src)", ScRaw "    $out  = Join-Path $OutRoot $name", ScRaw "    $resultFile = Join-Path $ResultsDir $name", ScRaw "    $failingFile  = Join-Path $dir \"$name.failing\"", ScRaw "    $expectedFile = Join-Path $dir \"$name.expected\"", ScRaw "    $stdinFile    = Join-Path $dir \"$name.stdin\"", ScRaw "    # .keys holds a scancode timeline (`t:scancode` per line, t = ms since", ScRaw "    # boot). .stdin reaches the serial ring; this reaches the PS/2 key cell,", ScRaw "    # which is the only path a keyboard read can see.", ScRaw "    $keysFile     = Join-Path $dir \"$name.keys\"", ScRaw "    $diskFile     = Join-Path $dir \"$name.disk\"", ScRaw "    # .disk-src names another test whose FRESHLY COMPILED cdx becomes this", ScRaw "    # test's disk. A .disk is a file that was built at some other time by", ScRaw "    # some other compiler, which is exactly what a pin on the current", ScRaw "    # compiler's output cannot use: the manifest-scope pin sat skipped with a", ScRaw "    # shell script beside it for want of this one line.", ScRaw "    $diskSrcFile  = Join-Path $dir \"$name.disk-src\"", ScRaw "    # .disk2 is a SECOND image, attached as the primary channel's slave. A test", ScRaw "    # whose subject is which drive it reached needs two, and with one image", ScRaw "    # behind every position a working drive-select and a missing one produce", ScRaw "    # identical output -- which is how block-select came to do nothing for as", ScRaw "    # long as it did.", ScRaw "    $disk2File    = Join-Path $dir \"$name.disk2\"", ScRaw "    # .smp holds a core count: the test is booted with -smp N.", ScRaw "    $smpFile      = Join-Path $dir \"$name.smp\"", ScRaw "    # .vmargs holds extra codex-vm flags, for a test whose subject is the", ScRaw "    # machine rather than the program -- a bus topology, an absent device.", ScRaw "    $vmArgsFile   = Join-Path $dir \"$name.vmargs\"", ScRaw "    $log = Join-Path $out 'build.log'", ScRaw "    $bin = Join-Path $out \"$name.cdx\"", ScRaw "    $exitFile = Join-Path $out '.exitcode'", ScRaw "", ScRaw "    $exitCode = if (Test-Path $exitFile) { (Get-Content -TotalCount 1 $exitFile).Trim() } else { '99' }", ScRaw "    $compileOk = ($exitCode -eq '0')", ScRaw "", ScRaw "    if (Test-Path -PathType Leaf $failingFile) {", ScRaw "        if ($compileOk) {", ScRaw "            \"FAIL_EXPECTED_BUT_COMPILED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            continue", ScRaw "        }", ScRaw "        $codesOk = $true", ScRaw "        $logText = if (Test-Path $log) { Get-Content -Raw -Path $log } else { '' }", ScRaw "        # A bare `CDX2031` checks only that the code fired. `CDX2031@33:5`", ScRaw "        # also pins WHERE, which a bare code cannot: a diagnostic reported at", ScRaw "        # a synthetic 0,0 span prints with no line:column prefix at all, so a", ScRaw "        # code-only check passes against a compiler that lost the position", ScRaw "        # entirely. That is what the act-block span defect looked", ScRaw "        # like, and it is why a test written for a position needs a form that", ScRaw "        # can fail on one.", ScRaw "        foreach ($code in (Get-Content $failingFile)) {", ScRaw "            $code = $code.Trim()", ScRaw "            if (-not $code) { continue }", ScRaw "            if ($code -match '^(?<c>(CDX)?\\d+)@(?<l>\\d+):(?<col>\\d+)$') {", ScRaw "                $c = $matches['c'] -replace '^CDX', ''", ScRaw "                $pat = \"\\b$($matches['l']):$($matches['col']):\\s*error (CDX)?0*$c\\b\"", ScRaw "                if ($logText -notmatch $pat) { $codesOk = $false; break }", ScRaw "            } elseif ($logText -notmatch \"error (CDX)?0*$code\\b\") { $codesOk = $false; break }", ScRaw "        }", ScRaw "        if ($codesOk) {", ScRaw "            \"PASS_FAILING`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        } else {", ScRaw "            \"FAIL_WRONG_DIAGNOSTIC`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        }", ScRaw "        continue", ScRaw "    }", ScRaw "", ScRaw "    if (-not $compileOk) {", ScRaw "        \"FAIL_COMPILE`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        continue", ScRaw "    }", ScRaw "", ScRaw "    $diagFile = Join-Path $dir \"$name.diag\"", ScRaw "    if (Test-Path -PathType Leaf $diagFile) {", ScRaw "        $codesOk = $true", ScRaw "        $missing = ''", ScRaw "        $logText = if (Test-Path $log) { Get-Content -Raw -Path $log } else { '' }", ScRaw "        foreach ($code in (Get-Content $diagFile)) {", ScRaw "            $code = ($code.Trim() -replace '^CDX','')", ScRaw "            if (-not $code) { continue }", ScRaw "            if ($logText -notmatch \"(error|warning|info|hint|deprecated) (CDX)?0*$code\\b\") { $codesOk = $false; $missing = $code; break }", ScRaw "        }", ScRaw "        if (-not $codesOk) {", ScRaw "            \"FAIL_MISSING_DIAGNOSTIC`t$name`tCDX$missing not emitted\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            continue", ScRaw "        }", ScRaw "        if (-not (Test-Path -PathType Leaf $expectedFile)) {", ScRaw "            \"PASS_DIAG`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            continue", ScRaw "        }", ScRaw "    }", ScRaw "", ScRaw "    # A .fatal test asserts that the guest DIES, and it deliberately carries no", ScRaw "    # .expected: the !EXC dump's RIP moves with every codegen change, so a", ScRaw "    # byte-compare would be brittle. That is why this arm must come BEFORE the", ScRaw "    # no-expected arm below. Without it every one of them lands in", ScRaw "    # PASS_UNVERIFIED -- compiled, never run, and counted as a pass. Measured", ScRaw "    # 2026-07-28: all 15 were in that state, so -Fatal added 15 to the pass", ScRaw "    # column and executed none of them. A green that cannot fail reads as", ScRaw "    # coverage, which is strictly worse than the skip it replaced.", ScRaw "    $fatalFile = Join-Path $dir \"$name.fatal\"", ScRaw "    if ((Test-Path -PathType Leaf $fatalFile) -and $runFatal) {", ScRaw "        # An optional second line `exc: NN` pins WHICH fault. It matters: a", ScRaw "        # bounds check that fired traps with UD2 (06), while one that was", ScRaw "        # removed reads a wild pointer and page-faults, and \"it died\" alone", ScRaw "        # cannot tell those apart.", ScRaw "        $expectExc = ''", ScRaw "        foreach ($l in @(Get-Content $fatalFile)) {", ScRaw "            if ($l -match '^\\s*exc:\\s*([0-9A-Fa-f]{1,2})\\s*$') { $expectExc = $matches[1].ToUpper(); break }", ScRaw "        }", ScRaw "        $needsRun.Add(@{", ScRaw "            Name = $name; Bin = $bin; Expected = ''; Fatal = $true; ExpectExc = $expectExc", ScRaw "            Stdin = $stdinFile; Keys = $keysFile; Disk = $diskFile; Smp = 0", ScRaw "            Disk2 = $disk2File; VmArgs = $vmArgsFile", ScRaw "        })", ScRaw "        continue", ScRaw "    }", ScRaw "", ScRaw "    if (-not (Test-Path -PathType Leaf $expectedFile)) {", ScRaw "        \"PASS_UNVERIFIED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        continue", ScRaw "    }", ScRaw "", ScRaw "    $smpCores = 0", ScRaw "    if (Test-Path -PathType Leaf $smpFile) {", ScRaw "        $smpCores = [int]((Get-Content -TotalCount 1 $smpFile).Trim())", ScRaw "    }", ScRaw "", ScRaw "    if (Test-Path -PathType Leaf $diskSrcFile) {", ScRaw "        $peer = (Get-Content -TotalCount 1 $diskSrcFile).Trim()", ScRaw "        $peerBin = Join-Path (Join-Path $OutRoot $peer) \"$peer.cdx\"", ScRaw "        if (-not (Test-Path -PathType Leaf $peerBin)) {", ScRaw "            \"FAIL_DISK_SOURCE`t$name`t$peer produced no cdx\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            continue", ScRaw "        }", ScRaw "        $diskFile = $peerBin", ScRaw "    }", ScRaw "", ScRaw "    $needsRun.Add(@{", ScRaw "        Name = $name; Bin = $bin; Expected = $expectedFile;", ScRaw "        Stdin = $stdinFile; Keys = $keysFile; Disk = $diskFile; Smp = $smpCores", ScRaw "        Disk2 = $disk2File", ScRaw "        VmArgs = $vmArgsFile", ScRaw "    })", ScRaw "}", ScBlank, ScComment "===========================================================================", ScComment "Phase 2: Run tests with .expected files. One codex-vm -run-list supervisor", ScComment "per job slot, a FRESH codex-vm child per test, so the cold boot a single run", ScComment "proves is unchanged (OperatorsManual \"Batch mode: -run-list\"). Measured", ScComment "2026-08-22 at -Jobs 8: a pwsh child per test cost 575 ms of which codex-vm", ScComment "itself was 74 ms, and 1,313 runs spent 151 s here. Under CODEX_VM_HOST=qemu", ScComment "the per-test test-run.ps1 path stays, because -run-list is codex-vm's.", ScComment "===========================================================================", ScRaw "if ($needsRun.Count -gt 0) {", ScRaw "    $fatalCount = @($needsRun | Where-Object { $_.ContainsKey('Fatal') -and $_.Fatal }).Count", ScRaw "    # Re-asked rather than reused from phase 1: that was minutes ago and the\n    # box is shared. A -run-list supervisor holds one guest at a time, so\n    # concurrent guests is again $Jobs.", ScRaw "    $Jobs = Get-VmAdmittedSlots -Slots $Jobs -What 'phase 2 run'", ScRaw "    $runLabel = \"Phase 2: running $($needsRun.Count) tests\"", ScRaw "    if ($fatalCount -gt 0) { $runLabel += \" ($fatalCount judged on the fault, not on .expected)\" }", ScRaw "    Write-Host \"$runLabel, $Jobs parallel...\"", ScBlank, ScRaw "    # ANY UNCAUGHT THROW HERE ENDS THE WHOLE BATTERY, not one test.", ScRaw "    # WaitForExit returns before Windows releases a redirected handle,", ScRaw "    # so a bare read of an output can land on a locked file while", ScRaw "    # ErrorActionPreference is Stop. test-cross-batch.ps1 lost 457 tests", ScRaw "    # to exactly that and stranded five guests at 115,597 CPU-seconds,", ScRaw "    # because the harness that dies is also the thing enforcing every", ScRaw "    # child ceiling. Unreadable reads as empty, which fails toward a", ScRaw "    # reported failure rather than a silent pass.", ScRaw "    function Read-LogShared([string]$path) {", ScRaw "        for ($ri = 0; $ri -lt 5; $ri++) {", ScRaw "            try {", ScRaw "                $fs = [System.IO.FileStream]::new($path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)", ScRaw "                try { $sr = [System.IO.StreamReader]::new($fs); return $sr.ReadToEnd() } finally { $fs.Dispose() }", ScRaw "            } catch { Start-Sleep -Milliseconds 100 }", ScRaw "        }", ScRaw "        return ''", ScRaw "    }", ScBlank, ScRaw "    # The verdict on one test from what its run left behind: $RunOk and $Why", ScRaw "    # from the supervisor's END line, the raw capture filtered exactly as", ScRaw "    # test-run.ps1 filtered it (CR and a leading SOH stripped, HEAP:/WD:/STACK:", ScRaw "    # telemetry dropped, trailing blank lines cut) into runtime.actual.", ScRaw "    function Write-RunVerdict($t, [bool]$RunOk, [string]$Why) {", ScRaw "        $name = $t.Name", ScRaw "        $out = Join-Path $OutRoot $name", ScRaw "        $resultFile = Join-Path $ResultsDir $name", ScRaw "        $actual = Join-Path $out 'runtime.actual'", ScRaw "        $txt = ''", ScRaw "        if ($RunOk) {", ScRaw "            if ((-not (Test-Path -PathType Leaf $t.Raw)) -or (Get-Item $t.Raw).Length -eq 0) {", ScRaw "                $RunOk = $false; $Why = 'no output'", ScRaw "            } else {", ScRaw "                $raw = (Read-LogShared $t.Raw) -replace \"`r\", '' -replace \"^\\x01\", ''", ScRaw "                $kept = [System.Collections.Generic.List[string]]::new()", ScRaw "                foreach ($l in ($raw -split \"`n\")) {", ScRaw "                    if ($l.StartsWith('HEAP:') -or $l.StartsWith('WD:') -or $l.StartsWith('STACK:')) { continue }", ScRaw "                    [void]$kept.Add($l)", ScRaw "                }", ScRaw "                while ($kept.Count -gt 0 -and $kept[$kept.Count - 1] -eq '') { $kept.RemoveAt($kept.Count - 1) }", ScRaw "                $txt = if ($kept.Count -gt 0) { ($kept -join \"`n\") + \"`n\" } else { '' }", ScRaw "            }", ScRaw "        }", ScRaw "        [System.IO.File]::WriteAllText($actual, $txt, [System.Text.UTF8Encoding]::new($false))", ScRaw "        # A fatal test is judged on the fault, not on a byte-compare.", ScRaw "        # ContainsKey rather than a property read: the other entries in", ScRaw "        # $needsRun do not carry this key.", ScRaw "        if ($t.ContainsKey('Fatal') -and $t.Fatal) {", ScRaw "            if ($txt -match '!EXC=([0-9A-Fa-f]{1,2})') {", ScRaw "                $got = $matches[1].ToUpper()", ScRaw "                if ($t.ExpectExc -and ($got -ne $t.ExpectExc)) {", ScRaw "                    \"FAIL_FATAL_EXC`t$name`tfaulted with EXC=$got, expected EXC=$($t.ExpectExc)\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "                } else {", ScRaw "                    \"PASS_FATAL`t$name`tEXC=$got\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "                }", ScRaw "            } elseif ((-not $RunOk) -or $txt -eq '') {", ScRaw "                # No output at all is not survival and must not be read as", ScRaw "                # one: it is a hang, a wall-budget kill, or a VM that died", ScRaw "                # without printing. Say so rather than guessing.", ScRaw "                \"FAIL_RUNTIME`t$name`tno output, so the fault could not be observed\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            } else {", ScRaw "                # THE CASE THIS TIER EXISTS FOR. The program ran to", ScRaw "                # completion where it was supposed to die, which is what a", ScRaw "                # bounds check that stopped firing looks like.", ScRaw "                \"FAIL_FATAL_SURVIVED`t$name`tran to completion without faulting\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            }", ScRaw "            return", ScRaw "        }", ScRaw "        if (-not $RunOk) {", ScRaw "            \"FAIL_RUNTIME`t$name`t$Why\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "            return", ScRaw "        }", ScRaw "        $expectedBytes = (Read-LogShared $t.Expected) -replace \"`r\", ''", ScRaw "        if ($expectedBytes -eq $txt) {", ScRaw "            \"PASS_EXPECTED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        } else {", ScRaw "            \"FAIL_OUTPUT`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8", ScRaw "        }", ScRaw "    }", ScBlank, ScRaw "    $phase2Sw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "    if ($env:CODEX_VM_HOST -eq 'qemu') {", ScRaw "        $runWorker = {", ScRaw "            $t = $_", ScRaw "            $runScript = Join-Path $using:PSScriptRoot 'test-run.ps1'", ScRaw "            $out = Join-Path $using:OutRoot $t.Name", ScRaw "            $t.Raw = Join-Path $out 'runtime.raw'", ScRaw "            $runArgs = @('-NoProfile', '-File', $runScript, '-Kernel', $t.Bin, '-OutFile', $t.Raw)", ScRaw "            if (Test-Path -PathType Leaf $t.Stdin)  { $runArgs += @('-StdinFile', $t.Stdin) }", ScRaw "            if (Test-Path -PathType Leaf $t.Keys)   { $runArgs += @('-KeysFile', $t.Keys) }", ScRaw "            if (Test-Path -PathType Leaf $t.Disk)   { $runArgs += @('-DiskFile', $t.Disk) }", ScRaw "            if (Test-Path -PathType Leaf $t.Disk2)  { $runArgs += @('-Disk2File', $t.Disk2) }", ScRaw "            if ($t.Smp -gt 1)                       { $runArgs += @('-Smp', $t.Smp) }", ScRaw "            if (Test-Path -PathType Leaf $t.VmArgs) { $runArgs += @('-VmArgsFile', $t.VmArgs) }", ScRaw "            $runSw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "            & pwsh @runArgs", ScRaw "            $runSw.Stop()", ScRaw "            \"$($runSw.ElapsedMilliseconds)\" | Set-Content -Path (Join-Path $out '.run-ms') -Encoding UTF8", ScRaw "            $t.RunOk = ($LASTEXITCODE -eq 0)", ScRaw "            $t.Why = 'run failed'", ScRaw "        }", ScRaw "        $needsRun | ForEach-Object -Parallel $runWorker -ThrottleLimit $Jobs", ScRaw "        foreach ($t in $needsRun) { Write-RunVerdict $t $t.RunOk $t.Why }", ScRaw "    } else {", ScRaw "        $runDir = Join-Path $OutRoot '_runs'", ScRaw "        if (Test-Path $runDir) { Remove-Item -Recurse -Force $runDir }", ScRaw "        New-Item -ItemType Directory -Force -Path $runDir | Out-Null", ScBlank, ScRaw "        # Dealt by the last run's .run-ms, heaviest first onto the lightest", ScRaw "        # slot, the rule phase 1 uses for .src-bytes: a test with no reading", ScRaw "        # goes to the slot with the fewest members. The few multi-second", ScRaw "        # network tests are what this balances; the rest run in ~80 ms.", ScRaw "        $runWeight = @{}", ScRaw "        $runIndex = @{}", ScRaw "        for ($i = 0; $i -lt $needsRun.Count; $i++) {", ScRaw "            $t = $needsRun[$i]", ScRaw "            $runIndex[$t.Name] = $i", ScRaw "            $w = 0L", ScRaw "            $rmF = Join-Path (Join-Path $OutRoot $t.Name) '.run-ms'", ScRaw "            if (Test-Path -PathType Leaf $rmF) {", ScRaw "                $rmText = (Get-Content -TotalCount 1 $rmF -ErrorAction SilentlyContinue)", ScRaw "                if ($rmText -and ($rmText.Trim() -match '^\\d+$')) { $w = [long]$rmText.Trim() }", ScRaw "            }", ScRaw "            $runWeight[$t.Name] = $w", ScRaw "        }", ScRaw "        $slotLoad = New-Object 'long[]' $Jobs", ScRaw "        $slotCount = New-Object 'int[]' $Jobs", ScRaw "        $slotMembers = @{}", ScRaw "        for ($s = 0; $s -lt $Jobs; $s++) { $slotMembers[$s] = [System.Collections.Generic.List[hashtable]]::new() }", ScRaw "        $byRun = @($needsRun | Sort-Object @{ Expression = { $runWeight[$_.Name] }; Descending = $true }, @{ Expression = { $runIndex[$_.Name] }; Descending = $false })", ScRaw "        foreach ($t in $byRun) {", ScRaw "            $k = 0", ScRaw "            if ($runWeight[$t.Name] -gt 0) {", ScRaw "                for ($s = 1; $s -lt $Jobs; $s++) {", ScRaw "                    if ($slotLoad[$s] -lt $slotLoad[$k] -or ($slotLoad[$s] -eq $slotLoad[$k] -and $slotCount[$s] -lt $slotCount[$k])) { $k = $s }", ScRaw "                }", ScRaw "            } else {", ScRaw "                for ($s = 1; $s -lt $Jobs; $s++) {", ScRaw "                    if ($slotCount[$s] -lt $slotCount[$k] -or ($slotCount[$s] -eq $slotCount[$k] -and $slotLoad[$s] -lt $slotLoad[$k])) { $k = $s }", ScRaw "                }", ScRaw "            }", ScRaw "            $slotMembers[$k].Add($t)", ScRaw "            $slotLoad[$k] += $runWeight[$t.Name]", ScRaw "            $slotCount[$k] += 1", ScRaw "        }", ScBlank, ScRaw "        # Every token double-quoted: that is what -run-list's splitter takes,", ScRaw "        # and it is what keeps a path with a space in one piece.", ScRaw "        function Format-RunLine([string[]]$Tokens) { return ($Tokens | ForEach-Object { '\"' + $_ + '\"' }) -join ' ' }", ScBlank, ScRaw "        # The sidecar preparation test-run.ps1 did stays with the caller: a", ScRaw "        # depot .disk is read-only after sync and codex-vm flushes writes", ScRaw "        # durably, so each image is copied to a writable temp for its run.", ScRaw "        $tempFiles = [System.Collections.Generic.List[string]]::new()", ScRaw "        $slotLists = @{}", ScRaw "        $slotErrs = @{}", ScRaw "        for ($s = 0; $s -lt $Jobs; $s++) {", ScRaw "            $lines = [System.Collections.Generic.List[string]]::new()", ScRaw "            foreach ($t in $slotMembers[$s]) {", ScRaw "                $out = Join-Path $OutRoot $t.Name", ScRaw "                $t.Raw = Join-Path $out 'runtime.raw'", ScRaw "                if (Test-Path $t.Raw) { Remove-Item -Force $t.Raw }", ScRaw "                $tokens = @('-kernel', $t.Bin, '-output', $t.Raw, '-mem', '3072', '-headless')", ScRaw "                if (Test-Path -PathType Leaf $t.Stdin) { $tokens += @('-input', $t.Stdin) }", ScRaw "                if (Test-Path -PathType Leaf $t.Keys)  { $tokens += @('-keys-file', $t.Keys) }", ScRaw "                if (Test-Path -PathType Leaf $t.Disk) {", ScRaw "                    $diskWork = [System.IO.Path]::GetTempFileName()", ScRaw "                    $tempFiles.Add($diskWork)", ScRaw "                    [System.IO.File]::WriteAllBytes($diskWork, [System.IO.File]::ReadAllBytes($t.Disk))", ScRaw "                    $tokens += @('-disk', $diskWork)", ScRaw "                }", ScRaw "                if (Test-Path -PathType Leaf $t.Disk2) {", ScRaw "                    $disk2Work = [System.IO.Path]::GetTempFileName()", ScRaw "                    $tempFiles.Add($disk2Work)", ScRaw "                    [System.IO.File]::WriteAllBytes($disk2Work, [System.IO.File]::ReadAllBytes($t.Disk2))", ScRaw "                    $tokens += @('-disk2', $disk2Work)", ScRaw "                }", ScRaw "                if ($t.Smp -gt 1) { $tokens += @('-smp', \"$($t.Smp)\") }", ScRaw "                if (Test-Path -PathType Leaf $t.VmArgs) {", ScRaw "                    foreach ($line in (Get-Content $t.VmArgs)) {", ScRaw "                        $line = $line.Trim()", ScRaw "                        if (-not $line -or $line.StartsWith('#')) { continue }", ScRaw "                        $tokens += ($line -split '\\s+')", ScRaw "                    }", ScRaw "                }", ScRaw "                [void]$lines.Add((Format-RunLine $tokens))", ScRaw "            }", ScRaw "            $slotLists[$s] = Join-Path $runDir \"run-$s.txt\"", ScRaw "            # The supervisor's stderr is captured on the SYSTEM temp and moved", ScRaw "            # into _runs afterwards. Measured 2026-08-22: the same eight", ScRaw "            # supervisors took 2.6 s with the redirect file on C: and 12.3 to", ScRaw "            # 12.7 s with it anywhere on D:, repo or not; a redirect is one", ScRaw "            # write per stderr line and D: pays ~7.5 ms for each. test-run.ps1", ScRaw "            # and the batch compiler only ever escaped this because", ScRaw "            # GetTempFileName() lands on C:.", ScRaw "            $slotErrs[$s] = [System.IO.Path]::GetTempFileName()", ScRaw "            [System.IO.File]::WriteAllLines($slotLists[$s], $lines, [System.Text.UTF8Encoding]::new($false))", ScRaw "        }", ScBlank, ScRaw "        $vmBin = Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'", ScRaw "        $supervisors = @{}", ScRaw "        for ($s = 0; $s -lt $Jobs; $s++) {", ScRaw "            if ($slotMembers[$s].Count -eq 0) { continue }", ScRaw "            $sa = @{ FilePath = $vmBin; ArgumentList = @('-run-list', $slotLists[$s]); PassThru = $true; RedirectStandardError = $slotErrs[$s] }", ScRaw "            if ($IsWindows) { $sa.WindowStyle = 'Hidden' }", ScRaw "            $supervisors[$s] = Start-Process @sa", ScRaw "        }", ScRaw "        foreach ($s in $supervisors.Keys) { $supervisors[$s].WaitForExit() }", ScBlank, ScRaw "        # One END line per list line, attributed by its [i/N] index rather", ScRaw "        # than by position, so a line the supervisor could not even report", ScRaw "        # reads as NOEND on its own test and shifts nothing onto a neighbour.", ScRaw "        foreach ($s in $slotMembers.Keys) {", ScRaw "            $members = $slotMembers[$s]", ScRaw "            if ($members.Count -eq 0) { continue }", ScRaw "            $endOf = @{}", ScRaw "            $errText = if (Test-Path -PathType Leaf $slotErrs[$s]) { Read-LogShared $slotErrs[$s] } else { '' }", ScRaw "            if (Test-Path -PathType Leaf $slotErrs[$s]) { Move-Item -Force $slotErrs[$s] (Join-Path $runDir \"run-$s.err\") }", ScRaw "            foreach ($l in ($errText -split \"`n\")) {", ScRaw "                if ($l -match 'RUN-LIST END \\[(\\d+)/\\d+\\] .* exit=(\\S+) output=(-?\\d+) dropped=(\\d+) ms=(\\d+)') {", ScRaw "                    $endOf[[int]$matches[1]] = @{ Exit = $matches[2]; Dropped = [long]$matches[4]; Ms = $matches[5] }", ScRaw "                }", ScRaw "            }", ScRaw "            for ($i = 0; $i -lt $members.Count; $i++) {", ScRaw "                $t = $members[$i]", ScRaw "                $out = Join-Path $OutRoot $t.Name", ScRaw "                $runOk = $true", ScRaw "                $why = ''", ScRaw "                if (-not $endOf.ContainsKey($i + 1)) {", ScRaw "                    $runOk = $false; $why = 'the -run-list supervisor reported no END line for this test'", ScRaw "                } else {", ScRaw "                    $e = $endOf[$i + 1]", ScRaw "                    \"$($e.Ms)\" | Set-Content -Path (Join-Path $out '.run-ms') -Encoding UTF8", ScRaw "                    if ($e.Exit -eq 'TIMEOUT') { $runOk = $false; $why = 'wall budget exceeded' }", ScRaw "                    elseif ($e.Exit -eq 'SPAWNFAIL') { $runOk = $false; $why = 'codex-vm could not be spawned for this test' }", ScRaw "                    elseif ($e.Dropped -gt 0) { $runOk = $false; $why = \"codex-vm dropped $($e.Dropped) guest serial bytes: the capture is SHORT and any comparison against it is meaningless\" }", ScRaw "                }", ScRaw "                Write-RunVerdict $t $runOk $why", ScRaw "            }", ScRaw "        }", ScRaw "        foreach ($f in $tempFiles) { Remove-Item -Force $f -ErrorAction SilentlyContinue }", ScRaw "    }", ScRaw "    $phase2Sw.Stop()", ScRaw "    Write-Host \"Phase 2 (run) complete in $([int]($phase2Sw.ElapsedMilliseconds/1000))s.\"", ScRaw "} else {", ScRaw "    $phase2Sw = $null", ScRaw "    Write-Host \"Phase 2 (run) complete.\"", ScRaw "}"]

Section: T06 -- Oracles, Aggregate, Rollup and Exit

  t06 : List ShellCmd = [ScComment "===========================================================================", ScComment "Oracles tier: the author-owned differential collections, invoked and", ScComment "reported here, never gated. reek owns oracle-scalar, blu owns", ScComment "oracle-vector; this harness only runs them and carries their verdicts", ScComment "into the rollup and the exit code.", ScComment "===========================================================================", ScRaw "$oracleResults = @()", ScRaw "if ($tiers.Contains('oracles')) {", ScRaw "    $stage0Path = Join-Path (Resolve-Path .).Path 'build-output\\bare-metal\\Codex.cdx'", ScRaw "    foreach ($o in 'oracle-scalar', 'oracle-vector', 'oracle-cce') {", ScRaw "        $oscript = Join-Path $PSScriptRoot \"$o.ps1\"", ScRaw "        if (-not (Test-Path -PathType Leaf $oscript)) {", ScRaw "            $oracleResults += [pscustomobject]@{ Name = $o; Ok = $false; Seconds = 0; Note = 'script missing' }", ScRaw "            continue", ScRaw "        }", ScRaw "        Write-Host \"Oracle: $o...\"", ScRaw "        $osw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "        $olog = Join-Path $OutRoot \"_oracle-$o.log\"", ScRaw "        & pwsh -NoProfile -File $oscript -Kernel $stage0Path *> $olog", ScRaw "        $osw.Stop()", ScRaw "        $ok = ($LASTEXITCODE -eq 0)", ScRaw "        $tail = @(Get-Content $olog -Tail 1 -ErrorAction SilentlyContinue) -join ''", ScRaw "        $oracleResults += [pscustomobject]@{ Name = $o; Ok = $ok; Seconds = [int]($osw.ElapsedMilliseconds / 1000); Note = $tail }", ScRaw "        Write-Host \"  $o : $(if ($ok) { 'PASS' } else { 'FAIL' }) ($([int]($osw.ElapsedMilliseconds / 1000))s)  $tail\"", ScRaw "    }", ScRaw "}", ScBlank, ScComment "===========================================================================", ScComment "Aggregate results", ScComment "===========================================================================", ScRaw "$buckets = @{", ScRaw "    PASS_EXPECTED = @(); PASS_UNVERIFIED = @(); PASS_FAILING = @(); PASS_DIAG = @(); PASS_FATAL = @()", ScRaw "    SKIPPED = @(); FAIL_COMPILE = @(); FAIL_RUNTIME = @()", ScRaw "    FAIL_OUTPUT = @(); FAIL_EXPECTED_BUT_COMPILED = @(); FAIL_WRONG_DIAGNOSTIC = @(); FAIL_MISSING_DIAGNOSTIC = @()", ScRaw "    FAIL_DISK_SOURCE = @(); FAIL_FATAL_SURVIVED = @(); FAIL_FATAL_EXC = @()", ScRaw "}", ScRaw "$statusOf = @{}", ScRaw "foreach ($f in Get-ChildItem -File $ResultsDir) {", ScRaw "    if ($f.Name -like '_*') { continue }", ScRaw "    $line = Get-Content -TotalCount 1 $f.FullName", ScRaw "    if (-not $line) { continue }", ScRaw "    $parts = $line -split \"`t\", 3", ScRaw "    $status = $parts[0]; $name = $parts[1]; $detail = if ($parts.Count -ge 3) { $parts[2] } else { '' }", ScRaw "    $statusOf[$name] = $status", ScRaw "    if (-not $buckets.ContainsKey($status)) {", ScRaw "        Write-Host \"unknown result status '$status' for $name\" -ForegroundColor Yellow", ScRaw "        continue", ScRaw "    }", ScRaw "    if ($status -in 'SKIPPED','FAIL_RUNTIME','FAIL_DISK_SOURCE','PASS_FATAL','FAIL_FATAL_SURVIVED','FAIL_FATAL_EXC') {", ScRaw "        $buckets[$status] += \"$name`: $detail\"", ScRaw "    } else {", ScRaw "        $buckets[$status] += $name", ScRaw "    }", ScRaw "}", ScBlank, ScComment "Census instrumentation: one row per test with whatever timings exist.", ScComment "Compile time inside a batch is not observable per test (the VM output file", ScComment "flushes on exit), so src-bytes stands in as the compile-cost proxy; run-ms", ScComment "is exact. Batch wall times are in the sweep log (batch-done ... wallms=).", ScRaw "$timingsFile = Join-Path $ResultsDir '_timings.tsv'", ScRaw "$timingRows = [System.Collections.Generic.List[string]]::new()", ScRaw "$timingRows.Add(\"name`tstatus`tsrc_bytes`trun_ms\")", ScRaw "foreach ($f in Get-ChildItem -File $ResultsDir) {", ScRaw "    if ($f.Name -like '_*') { continue }", ScRaw "    $line = Get-Content -TotalCount 1 $f.FullName", ScRaw "    if (-not $line) { continue }", ScRaw "    $p = $line -split \"`t\", 3", ScRaw "    $out = Join-Path $OutRoot $f.Name", ScRaw "    $sb = ''; $rm = ''", ScRaw "    $sbF = Join-Path $out '.src-bytes'; if (Test-Path $sbF) { $sb = (Get-Content -TotalCount 1 $sbF).Trim() }", ScRaw "    $rmF = Join-Path $out '.run-ms';    if (Test-Path $rmF) { $rm = (Get-Content -TotalCount 1 $rmF).Trim() }", ScRaw "    $timingRows.Add(\"$($f.Name)`t$($p[0])`t$sb`t$rm\")", ScRaw "}", ScRaw "[System.IO.File]::WriteAllLines($timingsFile, $timingRows, [System.Text.UTF8Encoding]::new($false))", ScRaw "$phaseSummary = \"phase1_compile_s=$([int]($phase1Sw.ElapsedMilliseconds/1000)) retry_s=$([int]($retrySw.ElapsedMilliseconds/1000))\"", ScRaw "if ($null -ne $phase2Sw) { $phaseSummary += \" phase2_run_s=$([int]($phase2Sw.ElapsedMilliseconds/1000))\" }", ScRaw "Write-Host $phaseSummary", ScRaw "Add-Content -Path $timingsFile -Value \"# $phaseSummary\"", ScBlank, ScRaw "$total = ($buckets.Values | ForEach-Object { $_.Count } | Measure-Object -Sum).Sum", ScRaw "$passed = $buckets.PASS_EXPECTED.Count + $buckets.PASS_FAILING.Count + $buckets.PASS_UNVERIFIED.Count `", ScRaw "        + $buckets.PASS_DIAG.Count + $buckets.PASS_FATAL.Count", ScRaw "$unexpected = $buckets.FAIL_COMPILE.Count + $buckets.FAIL_EXPECTED_BUT_COMPILED.Count `", ScRaw "            + $buckets.FAIL_WRONG_DIAGNOSTIC.Count + $buckets.FAIL_OUTPUT.Count + $buckets.FAIL_RUNTIME.Count `", ScRaw "            + $buckets.FAIL_MISSING_DIAGNOSTIC.Count + $buckets.FAIL_DISK_SOURCE.Count `", ScRaw "            + $buckets.FAIL_FATAL_SURVIVED.Count + $buckets.FAIL_FATAL_EXC.Count", ScBlank, ScRaw "Write-Host \"total=$total  pass=$passed  fail=$unexpected  skip=$($buckets.SKIPPED.Count)\"", ScBlank, ScComment "===========================================================================", ScComment "Rollup and run-over-run delta. The rollup is one file a reader can act on", ScComment "without excavating 600 lines; the delta makes a regression read as a diff.", ScComment "test-output\\last-run.json survives across runs (only _results is wiped).", ScComment "===========================================================================", ScRaw "$expectedOwners = $null", ScRaw "function Get-FailHint {", ScRaw "    param([string]$Name, [string]$Status)", ScRaw "    $out = Join-Path $OutRoot $Name", ScRaw "    if ($Status -eq 'FAIL_OUTPUT') {", ScRaw "        $dir = $srcDirOf[$Name]", ScRaw "        if (-not $dir) { return '' }", ScRaw "        # LENGTH BEFORE CONTENT (L-SHORT). A truncated artifact and a wrong one", ScRaw "        # are the same colour on a verdict line, and the line walk below reports", ScRaw "        # the first differing line either way -- which reads as codegen. Seven", ScRaw "        # poison subjects went red at Update 48 with ideas-test holding 204 bytes", ScRaw "        # of a 2,199-byte output and the compiler byte-identical; a re-run cleared", ScRaw "        # all seven. The normalisation is the SAME one the FAIL_OUTPUT verdict was", ScRaw "        # decided with (CR stripped from expected only), so this cannot disagree", ScRaw "        # with it -- comparing raw file bytes here would report SHORT for every", ScRaw "        # CRLF/LF pair and be worse than the gap it closes.", ScRaw "        # Read-LogShared is defined INSIDE $runWorker and is not in scope here,", ScRaw "        # so this reads the two files directly. Same text either way: the worker", ScRaw "        # only needs the sharing retry because it reads while other jobs write.", ScRaw "        #", ScRaw "        # A bare length difference does NOT prove truncation -- most ordinary", ScRaw "        # wrong-output reds differ in length too, so reporting every one of them", ScRaw "        # as SHORT would train the reader to ignore the word. A STRICT PREFIX", ScRaw "        # does prove it: that is what a capture cut off mid-stream looks like and", ScRaw "        # a miscompile has no reason to produce it. The two are reported as", ScRaw "        # different claims, and the same-length case says nothing at all and", ScRaw "        # falls through to the line walk untouched.", ScRaw "        $efile = Join-Path $dir \"$Name.expected\"", ScRaw "        $afile = Join-Path $out 'runtime.actual'", ScRaw "        $etxt = if (Test-Path -PathType Leaf $efile) { ([System.IO.File]::ReadAllText($efile)) -replace \"`r\", '' } else { '' }", ScRaw "        $atxt = if (Test-Path -PathType Leaf $afile) { [System.IO.File]::ReadAllText($afile) } else { '' }", ScRaw "        # MISATTRIBUTION BEFORE LENGTH. An actual that is byte-for-byte", ScRaw "        # ANOTHER test's expected is not a wrong answer but a misfiled one:", ScRaw "        # the batch stream lost a block and every later block ran under the", ScRaw "        # wrong name (ExaminersAssay \"The batch stream can lose bytes\"; 26", ScRaw "        # such reds at the Update 52 battery read as codegen for an evening).", ScRaw "        # A foreign output usually differs in length too, so the length", ScRaw "        # claims below would bury this one. The owner map is built once, on", ScRaw "        # the first FAIL_OUTPUT hint; a green run never pays for it.", ScRaw "        if ($null -eq $script:expectedOwners) {", ScRaw "            $script:expectedOwners = @{}", ScRaw "            foreach ($n2 in $srcDirOf.Keys) {", ScRaw "                $ef2 = Join-Path $srcDirOf[$n2] \"$n2.expected\"", ScRaw "                if (Test-Path -PathType Leaf $ef2) {", ScRaw "                    $k2 = ([System.IO.File]::ReadAllText($ef2)) -replace \"`r\", ''", ScRaw "                    if (-not $script:expectedOwners.ContainsKey($k2)) { $script:expectedOwners[$k2] = [System.Collections.Generic.List[string]]::new() }", ScRaw "                    $script:expectedOwners[$k2].Add($n2)", ScRaw "                }", ScRaw "            }", ScRaw "        }", ScRaw "        if ($atxt -and $script:expectedOwners.ContainsKey($atxt)) {", ScRaw "            $owners = @($script:expectedOwners[$atxt] | Where-Object { $_ -ne $Name } | Sort-Object)", ScRaw "            if ($owners.Count -gt 0) {", ScRaw "                return \"HOLDS the expected output of $($owners -join ' / ') byte-for-byte -- batch misattribution, not codegen (ExaminersAssay: the batch stream can lose bytes); re-run\"", ScRaw "            }", ScRaw "        }", ScRaw "        if ($etxt.Length -ne $atxt.Length) {", ScRaw "            $lim = [Math]::Min($etxt.Length, $atxt.Length)", ScRaw "            $off = 0", ScRaw "            while ($off -lt $lim -and $etxt[$off] -eq $atxt[$off]) { $off++ }", ScRaw "            if ($atxt.Length -lt $etxt.Length -and $off -eq $atxt.Length) {", ScRaw "                return \"TRUNCATED: actual $($atxt.Length) chars is a strict PREFIX of the expected $($etxt.Length) -- the capture is SHORT, not wrong; re-run before reading this as codegen (L-SHORT)\"", ScRaw "            }", ScRaw "            return \"LENGTHS DIFFER: actual $($atxt.Length) chars, expected $($etxt.Length), first difference at offset $off -- not a prefix, so this is a content difference and the line below is the one to read (L-SHORT)\"", ScRaw "        }", ScRaw "        $e = @(@(Get-Content (Join-Path $dir \"$Name.expected\") -ErrorAction SilentlyContinue) -replace \"`r\", '')", ScRaw "        $a = @(Get-Content (Join-Path $out 'runtime.actual') -ErrorAction SilentlyContinue)", ScRaw "        $n = [Math]::Max($e.Count, $a.Count)", ScRaw "        for ($i = 0; $i -lt $n; $i++) {", ScRaw "            $el = if ($i -lt $e.Count) { $e[$i] } else { '<absent>' }", ScRaw "            $al = if ($i -lt $a.Count) { $a[$i] } else { '<absent>' }", ScRaw "            if ($el -cne $al) { return \"line $($i + 1): expected [$el] actual [$al]\" }", ScRaw "        }", ScRaw "        return ''", ScRaw "    }", ScRaw "    if ($Status -in 'FAIL_COMPILE', 'FAIL_WRONG_DIAGNOSTIC', 'FAIL_EXPECTED_BUT_COMPILED', 'FAIL_MISSING_DIAGNOSTIC') {", ScRaw "        $log = Join-Path $out 'build.log'", ScRaw "        if (Test-Path -PathType Leaf $log) {", ScRaw "            $hit = Select-String -Path $log -Pattern 'error (CDX)?\\d+' | Select-Object -First 1", ScRaw "            if ($hit) { return $hit.Line.Trim() }", ScRaw "        }", ScRaw "    }", ScRaw "    return ''", ScRaw "}", ScBlank, ScRaw "$seedStamp = if (Test-Path 'build-output\\bare-metal\\Codex.cdx') { (Get-FileHash -Algorithm SHA256 'build-output\\bare-metal\\Codex.cdx').Hash.Substring(0, 16) } else { 'unknown' }", ScRaw "$tierLabel = (@($tiers) | Sort-Object) -join ','", ScRaw "$runStamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'", ScBlank, ScRaw "$prevFile = Join-Path $OutRoot 'last-run.json'", ScRaw "$prev = @{}", ScRaw "$prevStamp = ''", ScRaw "$prevTiers = ''", ScRaw "if (Test-Path -PathType Leaf $prevFile) {", ScRaw "    try {", ScRaw "        $pj = Get-Content $prevFile -Raw | ConvertFrom-Json", ScRaw "        $prevStamp = \"$($pj.stamp)\"", ScRaw "        $prevTiers = \"$($pj.tiers)\"", ScRaw "        foreach ($p in $pj.status.PSObject.Properties) { $prev[$p.Name] = \"$($p.Value)\" }", ScRaw "    } catch { $prev = @{} }", ScRaw "}", ScBlank, ScRaw "$newlyRed = [System.Collections.Generic.List[string]]::new()", ScRaw "$fixedNow = [System.Collections.Generic.List[string]]::new()", ScRaw "$addedRed = [System.Collections.Generic.List[string]]::new()", ScRaw "$addedCount = 0", ScRaw "foreach ($n in $statusOf.Keys) {", ScRaw "    $now = $statusOf[$n]", ScRaw "    if (-not $prev.ContainsKey($n)) {", ScRaw "        $addedCount++", ScRaw "        if ($now -like 'FAIL_*') { $addedRed.Add(\"$n ($now)\") }", ScRaw "        continue", ScRaw "    }", ScRaw "    $was = $prev[$n]", ScRaw "    if ($now -like 'FAIL_*' -and $was -notlike 'FAIL_*') { $newlyRed.Add(\"$n ($was -> $now)\") }", ScRaw "    elseif ($now -notlike 'FAIL_*' -and $was -like 'FAIL_*') { $fixedNow.Add(\"$n ($was -> $now)\") }", ScRaw "}", ScComment "Removed means DELETED FROM THE TREE, not merely outside this run's tiers:", ScComment "a lib-only run must not report the whole apps tier as gone.", ScRaw "$existingNames = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)", ScRaw "foreach ($d in $allDirs) {", ScRaw "    Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {", ScRaw "        [void]$existingNames.Add([System.IO.Path]::GetFileNameWithoutExtension($_.Name))", ScRaw "    }", ScRaw "}", ScRaw "$removed = [System.Collections.Generic.List[string]]::new()", ScRaw "foreach ($n in $prev.Keys) {", ScRaw "    if (-not $statusOf.ContainsKey($n) -and -not $existingNames.Contains($n)) { $removed.Add($n) }", ScRaw "}", ScBlank, ScRaw "$roll = [System.Collections.Generic.List[string]]::new()", ScRaw "$roll.Add(\"battery rollup  $runStamp  stage0=$seedStamp  tiers=$tierLabel\")", ScRaw "$roll.Add(\"total=$total  pass=$passed  fail=$unexpected  skip=$($buckets.SKIPPED.Count)\")", ScRaw "$roll.Add('')", ScRaw "$roll.Add(\"category      pass  fail  skip\")", ScRaw "$catStats = @{}", ScRaw "foreach ($n in $statusOf.Keys) {", ScRaw "    $c = if ($catOf.ContainsKey($n)) { $catOf[$n] } else { '?' }", ScRaw "    if (-not $catStats.ContainsKey($c)) { $catStats[$c] = @{ pass = 0; fail = 0; skip = 0 } }", ScRaw "    $s = $statusOf[$n]", ScRaw "    if ($s -like 'FAIL_*') { $catStats[$c].fail++ }", ScRaw "    elseif ($s -eq 'SKIPPED') { $catStats[$c].skip++ }", ScRaw "    else { $catStats[$c].pass++ }", ScRaw "}", ScRaw "foreach ($c in ($catStats.Keys | Sort-Object)) {", ScRaw "    $roll.Add((\"{0,-12}  {1,4}  {2,4}  {3,4}\" -f $c, $catStats[$c].pass, $catStats[$c].fail, $catStats[$c].skip))", ScRaw "}", ScRaw "$roll.Add('')", ScRaw "$roll.Add('slowest 10 (run phase, ms):')", ScRaw "# Not $slow: that is the [switch]$Slow parameter, and PowerShell variable", ScRaw "# names are case-insensitive.", ScRaw "$slowRows = [System.Collections.Generic.List[object]]::new()", ScRaw "foreach ($n in $statusOf.Keys) {", ScRaw "    $rmF = Join-Path (Join-Path $OutRoot $n) '.run-ms'", ScRaw "    if (Test-Path -PathType Leaf $rmF) {", ScRaw "        $ms = 0", ScRaw "        if ([int]::TryParse((Get-Content -TotalCount 1 $rmF).Trim(), [ref]$ms)) { $slowRows.Add([pscustomobject]@{ Name = $n; Ms = $ms }) }", ScRaw "    }", ScRaw "}", ScRaw "foreach ($s in ($slowRows | Sort-Object -Property Ms -Descending | Select-Object -First 10)) {", ScRaw "    $roll.Add((\"  {0,7}  {1}\" -f $s.Ms, $s.Name))", ScRaw "}", ScRaw "$failNames = @($statusOf.Keys | Where-Object { $statusOf[$_] -like 'FAIL_*' } | Sort-Object)", ScRaw "if ($failNames.Count -gt 0) {", ScRaw "    $roll.Add('')", ScRaw "    $roll.Add('failures:')", ScRaw "    foreach ($n in $failNames) {", ScRaw "        $hint = Get-FailHint -Name $n -Status $statusOf[$n]", ScRaw "        $roll.Add(\"  $n  $($statusOf[$n])$(if ($hint) { \"  -- $hint\" })\")", ScRaw "    }", ScRaw "}", ScRaw "foreach ($or in $oracleResults) {", ScRaw "    $roll.Add(\"oracle $($or.Name): $(if ($or.Ok) { 'PASS' } else { 'FAIL' }) ($($or.Seconds)s)  $($or.Note)\")", ScRaw "}", ScRaw "$roll.Add('')", ScRaw "if ($prev.Count -gt 0) {", ScRaw "    $roll.Add(\"delta vs previous run ($prevStamp, tiers=$prevTiers):\")", ScRaw "    $roll.Add(\"  newly red: $($newlyRed.Count)$(if ($newlyRed.Count) { '  ' + (($newlyRed | Select-Object -First 20) -join '; ') })\")", ScRaw "    $roll.Add(\"  fixed:     $($fixedNow.Count)$(if ($fixedNow.Count) { '  ' + (($fixedNow | Select-Object -First 20) -join '; ') })\")", ScRaw "    $roll.Add(\"  new tests: $addedCount$(if ($addedRed.Count) { '  RED AMONG THEM: ' + ($addedRed -join '; ') })\")", ScRaw "    $roll.Add(\"  removed:   $($removed.Count)$(if ($removed.Count) { '  ' + (($removed | Select-Object -First 20) -join '; ') })\")", ScRaw "} else {", ScRaw "    $roll.Add('delta: no previous run recorded (first rollup)')", ScRaw "}", ScRaw "[System.IO.File]::WriteAllLines((Join-Path $ResultsDir '_rollup.txt'), $roll, [System.Text.UTF8Encoding]::new($false))", ScRaw "foreach ($l in ($roll | Select-Object -Skip ($roll.Count - [Math]::Min(6, $roll.Count)))) { Write-Host $l }", ScBlank, ScComment "Persist this run for the next delta. A tier subset only re-records the", ScComment "tests it ran; statuses from other tiers carry forward untouched, and only", ScComment "a test deleted from the tree drops out of the carried state.", ScRaw "$carried = @{}", ScRaw "foreach ($k in $prev.Keys) { if ($existingNames.Contains($k)) { $carried[$k] = $prev[$k] } }", ScRaw "foreach ($k in $statusOf.Keys) { $carried[$k] = $statusOf[$k] }", ScRaw "@{ stamp = $runStamp; stage0 = $seedStamp; tiers = $tierLabel; status = $carried } |", ScRaw "    ConvertTo-Json -Depth 4 | Set-Content -Path $prevFile -Encoding UTF8", ScBlank, ScRaw "$oracleFails = @($oracleResults | Where-Object { -not $_.Ok }).Count", ScRaw "if ($unexpected -gt 0 -or $oracleFails -gt 0) {", ScRaw "    function Show-Failures { param([string]$Label, [object[]]$Items); if ($Items.Count -gt 0) { Write-Host \"${Label}:\"; foreach ($i in $Items) { Write-Host \"  $i\" } } }", ScRaw "    Show-Failures 'compile failed'              $buckets.FAIL_COMPILE", ScRaw "    Show-Failures 'expected error but compiled' $buckets.FAIL_EXPECTED_BUT_COMPILED", ScRaw "    Show-Failures 'wrong diagnostic'            $buckets.FAIL_WRONG_DIAGNOSTIC", ScRaw "    Show-Failures 'missing diagnostic'          $buckets.FAIL_MISSING_DIAGNOSTIC", ScRaw "    Show-Failures 'output mismatch'             $buckets.FAIL_OUTPUT", ScRaw "    Show-Failures 'runtime error'               $buckets.FAIL_RUNTIME", ScRaw "    Show-Failures 'disk source missing'         $buckets.FAIL_DISK_SOURCE", ScRaw "    Show-Failures 'oracle collections'          @($oracleResults | Where-Object { -not $_.Ok } | ForEach-Object { $_.Name })", ScRaw "    Restore-Kernel", ScRaw "    exit 1", ScRaw "}", ScRaw "Restore-Kernel", ScExit (SeInt 0)]

Section: Assembly

  test-body : List ShellCmd = [ScSequence t01, ScBlank, ScSequence t02, ScBlank, ScSequence t03, ScBlank, ScSequence t04, ScBlank, ScSequence t05, ScBlank, ScSequence t06]


  test-script : ShellScript = sh-script "test" "Compiler acceptance test harness -- batch mode." test-params test-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell test-script)
  end

