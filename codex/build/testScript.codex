Chapter: TestScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Disk Source Size Oracle

  test-capture-disk-size : List ShellCmd =
    let missing = SeNot (SeMethodCall (SeVar "srcOf") "ContainsKey" [SeVar "peer"])
    in let failed = SeStringNeq (SeCall "Get-BatchExit" [SeVar "peer"]) (SeLit "0")
    in let refused = ScThrow (SeLit "Disk source did not compile in this run")
    in let guard = ScIf (SeOr missing failed) [refused] []
    in let save = ScAssign "diskSourceBytes" (SeCall "Get-CdxContentExtent" [SeVar "peerBin"])
    in let read = ScAssign "oracleExpected" (SeFileText (SeVar "expectedFile"))
    in let uses = SeMethodCall (SeVar "oracleExpected") "Contains" [SeLit "{{disk-source-content-bytes}}"]
    in [ScIndent [ScIndent [read, ScIf uses [guard, save] []]]]

  test-resolve-disk-size : List ShellCmd =
    let marker = SeLit "{{disk-source-content-bytes}}"
    in let has = SeMethodCall (SeVar "expectedBytes") "Contains" [marker]
    in let bytes = SeProperty (SeVar "t") "DiskSourceBytes"
    in let refused = ScThrow (SeLit "Expected disk-source-content-bytes requires a freshly compiled .disk-src")
    in let guard = ScIf (SeIntLt bytes (SeInt 0)) [refused] []
    in let invariant = SeStaticProp "Globalization.CultureInfo" "InvariantCulture"
    in let number = SeMethodCall bytes "ToString" [invariant]
    in let replace = ScAssign "expectedBytes" (SeMethodCall (SeVar "expectedBytes") "Replace" [marker, number])
    in [ScIndent [ScIndent [ScIf has [guard, replace] []]]]

Section: Parameters

  test-params : List ShellParam = [sh-param-optional "CodexCdx" SptString, sh-param-default "Jobs" SptInt (SeInt 16), sh-switch "ErrorsOnly", sh-switch "NoErrors", sh-switch "Apps", sh-switch "FW", sh-switch "All", sh-switch "Lib", sh-switch "Slow", sh-switch "Fatal", sh-param-default "Tier" SptStringArray (SeArrayLiteral []), sh-param-default "Battery" SptStringArray (SeArrayLiteral []), sh-switch "ListSubjects", sh-param-optional "ApprovedBy" SptString, sh-switch "AllowStaleKernel"]

Section: The artifacts, declared before they are spelled

  tests-art : PipeArtifact = PipeArtifact { pa-name = "tests", pa-kind = PkValue, pa-expr = SeVar "tests", pa-from = None }

  stage0-art : PipeArtifact = PipeArtifact { pa-name = "stage0", pa-kind = PkFile, pa-expr = SeVar "stage0", pa-from = None }

  seed-digest-art : PipeArtifact = PipeArtifact { pa-name = "seedDigest", pa-kind = PkText, pa-expr = SeVar "seedDigest", pa-from = None }

Section: T01 -- Usage, the Approval Gate and Preamble

  t01-body : List ShellCmd =
    [ ScComment "Phase 1: batch-compile all non-skipped tests through persistent VM"
    , ScComment "          instances (one per job slot, repl-loop reuse)."
    , ScComment "Phase 2: run compiled tests that have .expected files (individual VM"
    , ScComment "          per test, parallel)."
    , ScComment ""
    , ScComment "Usage:"
    , ScComment "  build/test.ps1 [-CodexCdx FP] [-Jobs N] [-ErrorsOnly | -NoErrors]"
    , ScComment "  build/test.ps1 -Tier lang          # codex\\test + codex\\test\\ops + codex\\test\\errors (the default)"
    , ScComment "  build/test.ps1 -Tier lib           # codex\\test\\lib"
    , ScComment "  build/test.ps1 -Tier fw            # codex\\test\\forewords"
    , ScComment "  build/test.ps1 -Tier apps          # codex\\test\\apps"
    , ScComment "  build/test.ps1 -Tier hardware      # machine-sidecar tests from every dir"
    , ScComment "  build/test.ps1 -Tier traps         # the safety set: bounds, trap and fault"
    , ScComment "                                     # demos that assert the guest DIES. A"
    , ScComment "                                     # filter over .fatal from every dir, and"
    , ScComment "                                     # it implies -Fatal"
    , ScComment "  build/test.ps1 -Tier slow          # a filter over .slow; implies -Slow"
    , ScComment "                                     # (.smp/.vmargs/.disk/.disk2/.keys)"
    , ScComment "  build/test.ps1 -Tier oracles       # oracle-scalar/-vector/-cce, the"
    , ScComment "                                     # author-owned differential collections"
    , ScComment "  build/test.ps1 -Tier all           # every tier above INCLUDING oracles"
    , ScComment "  build/test.ps1 -Tier lib,apps      # tiers combine"
    , ScComment "  build/test.ps1 -Battery kernel     # every chapter a kernel change can"
    , ScComment "                                     # break, wherever it lives. Batteries"
    , ScComment "                                     # are named for COVERAGE and combine:"
    , ScComment "                                     # -Battery kernel,apps. Membership is"
    , ScComment "                                     # derived by check-battery-coverage.ps1"
    , ScComment "                                     # from .covers then cites, never a list."
    , ScComment "                                     # A BATTERY IS NOT THE TIER OF THE SAME"
    , ScComment "                                     # NAME: `-Tier apps` is the 472 chapters"
    , ScComment "                                     # in codex\\test\\apps, `-Battery apps` is"
    , ScComment "                                     # the 226 that cite an apps chapter from"
    , ScComment "                                     # anywhere. compiler and plugs are named"
    , ScComment "                                     # batteries that select NO chapters and"
    , ScComment "                                     # are refused here with a pointer to the"
    , ScComment "                                     # harnesses that do cover them."
    , ScComment "  build/test.ps1 -All                # lang+lib+fw+apps+oracles"
    , ScComment "  build/test.ps1 -All -Slow          # include slow tests too"
    , ScComment "  build/test.ps1 -Fatal              # include fatal tests (GPF/exception demos)"
    , ScComment ""
    , ScComment "Legacy switches (-Apps/-FW/-Lib/-All) map onto tiers. -Fuzz was removed"
    , ScComment "2026-07-27: codex\\test\\fuzz never existed. Every run writes"
    , ScComment "test-output\\_results\\_rollup.txt and a delta against the previous run"
    , ScComment "(test-output\\last-run.json): newly red, fixed, added, removed."
    , ScComment ""
    , ScComment "Every run requires -ApprovedBy damian. The battery is run by Damian or"
    , ScComment "with his per-run go-ahead, never on an agent's initiative -- see"
    , ScComment "CLAUDE.md rule 1. The gate below is deliberate; do not work around it."
    , ScComment ""
    , ScComment "Sidecars (all optional, presence-driven):"
    , ScComment "  codex*.test\\foo.expected  -- compile must SUCCEED, runtime output must match"
    , ScComment "  codex*.test\\foo.failing   -- compile must FAIL with listed CDX error codes."
    , ScComment "                              A line may also be `CDX2031@33:5`, which pins"
    , ScComment "                              the reported line:column as well as the code."
    , ScComment "                              Use it whenever the test exists BECAUSE of a"
    , ScComment "                              position: a bare code cannot fail on a lost"
    , ScComment "                              one, since a 0,0 span prints no prefix at all."
    , ScComment "  codex*.test\\foo.diag      -- compile must SUCCEED and emit each listed CDX"
    , ScComment "                              code at any severity (warning/info/error). One"
    , ScComment "                              code per line; bare number or CDX-prefixed. Use"
    , ScComment "                              with .expected to also check runtime output."
    , ScComment "  codex*.test\\foo.disk-src  -- first line names ANOTHER test; that test's"
    , ScComment "                              freshly compiled CDX is attached as this"
    , ScComment "                              test's disk. A .disk names a file and is"
    , ScComment "                              therefore frozen, which is no use to a test"
    , ScComment "                              that pins what the CURRENT compiler emits."
    , ScComment "  codex*.test\\foo.skip      -- skipped entirely (first line = reason)"
    , ScComment "  codex*.test\\foo.slow      -- skipped unless -Slow is passed (first line = reason)"
    , ScComment "  codex*.test\\foo.fatal     -- skipped unless -Fatal is passed (kills VM at runtime)"
    , ScComment ""
    , ScComment "Exit status: 0 iff every sample ends in its expected bucket."
    , ScBlank
    , ScSetStrictMode
    , ScSetErrorStop
    , ScComment "A named -Battery set is what a lane runs against its OWN change, so it does"
    , ScComment "not need Damian's approval (his intent, via root 2026-09-07); the gate stays"
    , ScComment "on everything else. The exemption is deliberately narrow: it holds only when"
    , ScComment "-Battery is the ONLY selector, so -Battery kernel -All is still the full"
    , ScComment "battery and still refused. Batteries start guests like any other run, so the"
    , ScComment "box is still asked of the commander per run."
    , ScRaw "$batteryOnly = ($Battery.Count -gt 0) -and ($Tier.Count -eq 0) -and"
    , ScRaw "               -not $All -and -not $Apps -and -not $FW -and -not $Lib"
    , ScComment "-ListSubjects prints the selection and exits before any guest, so it is"
    , ScComment "outside the gate for the same reason the exemption exists at all."
    , ScIf (SeBare (SeAnd (SeBare (SeAnd (SeBare (SeNot (SeVar "batteryOnly"))) (SeBare (SeNot (SeVar "ListSubjects"))))) (SeBare (SeStringNeq (SeVar "ApprovedBy") (SeLit "damian"))))) t01-not-battery-only-list []
    , ScBlank
    , ScRaw "Set-Location (Join-Path $PSScriptRoot '..')"
    , ScRaw "[Environment]::CurrentDirectory = (Get-Location).Path"
    , ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1"))
    , ScRaw "$Scope = if ($ErrorsOnly) { 'errors' } elseif ($NoErrors) { 'positive' } else { 'both' }"
    , ScRaw "$OutRoot     = 'test-output'"
    , ScRaw "$ResultsDir  = Join-Path $OutRoot '_results'"
    , ScRaw "New-Item -ItemType Directory -Force -Path $OutRoot | Out-Null"
    , ScRaw "if (Test-Path $ResultsDir) { Remove-Item -Recurse -Force $ResultsDir }"
    , ScRaw "New-Item -ItemType Directory -Force -Path $ResultsDir | Out-Null"
    , ScBlank
    , ScAssign "TestLog" (SeBare (SePathJoinN [SeVar "OutRoot", SeLit "test.log"]))
    , ScRaw "Set-Content -Path $TestLog -Value '' -Encoding UTF8"
    , ScRaw "$env:CODEX_SWEEP_LOG = (Resolve-Path $TestLog).Path"
    ]

  t01-not-battery-only-list : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScRaw "Write-Host 'REFUSED: the full battery runs only with explicit human approval.' -ForegroundColor Red"
    , ScEcho (SeLit "")
    , ScEcho (SeLit "Agent: this is not part of your verification loop, and passing the")
    , ScEcho (SeLit "approval flag without Damian saying so in THIS session is a lie.")
    , ScEcho (SeLit "Verify your change with:")
    , ScEcho (SeLit "    build/test.ps1 -Battery kernel                   # only what this change can break")
    , ScEcho (SeLit "    build/compile.ps1 -Src <t> -Out <o> -Log <log>   # one test")
    , ScEcho (SeLit "")
    , ScEcho (SeLit "If you believe this change warrants a battery run, tell Damian why")
    , ScEcho (SeLit "in one sentence and stop. He runs it, or hands you the command.")
    , ScEcho (SeLit "")
    , ScExit (SeInt 1)
    ]

Section: T02 -- Tiers and Test Gathering

  t02-body : List ShellCmd =
    [ ScBlank
    , ScComment "==========================================================================="
    , ScComment "Tiers. Named subsets so -All stops being the only word for \"more\". The"
    , ScComment "legacy switches map onto them; -ErrorsOnly/-NoErrors still narrow the lang"
    , ScComment "tier. `hardware` is a FILTER over every directory (tests that carry a"
    , ScComment "machine sidecar), not a directory of its own. `oracles` invokes the"
    , ScComment "author-owned differential collections (reek's oracle-scalar, blu's"
    , ScComment "oracle-vector) and reports their verdicts. Damian's call 2026-07-27: the"
    , ScComment "pin goes wherever it helps, so the oracles run in -All and in the gate"
    , ScComment "(build.ps1) as well -- measured at 2s + 1s, they cost nothing worth"
    , ScComment "counting. The collections stay author-owned."
    , ScComment ""
    , ScComment "`codex\\test\\ops` is the operator-correctness-by-operand-type axis, part"
    , ScComment "of the lang tier: pins for operators that were right on the operand types"
    , ScComment "somebody tested and wrong on one nobody did (the Real-comparison class),"
    , ScComment "organized by axis rather than by feature, plus the axis smoke bundles."
    , ScComment "==========================================================================="
    , ScRaw "$tiers = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)"
    , ScRaw "foreach ($t in $Tier) { [void]$tiers.Add($t.Trim()) }"
    , ScRaw "if ($Apps) { [void]$tiers.Add('apps') }"
    , ScRaw "if ($FW)   { [void]$tiers.Add('fw') }"
    , ScRaw "if ($Lib)  { [void]$tiers.Add('lib') }"
    , ScRaw "if ($All)  { foreach ($t in 'lang', 'lib', 'fw', 'apps', 'oracles') { [void]$tiers.Add($t) } }"
    , ScRaw "if ($tiers.Contains('all')) {"
    , ScIndent t02-tiers
    , ScRaw "}"
    , ScRaw "$known = @('lang', 'lib', 'fw', 'apps', 'hardware', 'oracles', 'traps', 'slow')"
    , ScForEach "t" (SeVar "tiers") t02-each-tiers
    , ScBlank
    , ScComment "A tier that selects tests and then skips them is worse than no tier: it"
    , ScComment "reports coverage it did not run. `traps` and `slow` therefore IMPLY their"
    , ScComment "switch, so `-Tier traps` cannot land in the pre-filter and be filed SKIPPED."
    , ScRaw "$runFatal = $Fatal.IsPresent -or $tiers.Contains('traps')"
    , ScRaw "$runSlow  = $Slow.IsPresent  -or $tiers.Contains('slow')"
    , ScComment "A bare invocation runs the language tier: the battery's subject is the"
    , ScComment "compiler. An explicit tier list is taken at its word -- `-Tier oracles`"
    , ScComment "alone runs the collections and no tests."
    , ScComment ""
    , ScComment "-Battery counts as an explicit selection, so it SUPPRESSES this default"
    , ScComment "instead of adding to it. Measured the hard way 2026-09-07: without this"
    , ScComment "clause `-Battery board` ran the whole lang tier, because lang had already"
    , ScComment "swept codex\\test and codex\\test\\errors where all 13 board chapters live,"
    , ScComment "every one was therefore already in $seen, and the battery added nothing."
    , ScComment "It reported \"0 chapter(s) added\" and ran 882 tests over 320 s. A selector"
    , ScComment "that silently widens to everything is worse than one that selects nothing."
    , ScRaw "if ($tiers.Count -eq 0 -and $Battery.Count -eq 0) { [void]$tiers.Add('lang') }"
    , ScBlank
    , ScRaw "$machineSidecars = @('.smp', '.vmargs', '.disk', '.disk2', '.disk-mint', '.disk2-mint', '.keys', '.qemu-x86', '.vm-guests')"
    , ScFunctionBlock "Test-MachineSidecar" t02-test-machine-sidecar
    , ScComment "A .disk-mint or .disk2-mint recipe names how build/mint-test-disk.ps1 builds"
    , ScComment "the image into build-output; the depot carries no image for such a test."
    , ScFunctionBlock "Resolve-MintedDisk" t02-resolve-minted-disk
    , ScBlank
    , ScRaw "$allDirs = @('codex\\test', 'codex\\test\\ops', 'codex\\test\\errors', 'codex\\test\\apps', 'codex\\test\\forewords', 'codex\\test\\lib', 'codex\\test\\cost', 'codex\\test\\ui', 'codex\\test\\examples')"
    , ScRaw "$seen = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)"
    , ScRaw "$tests = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$tierDirs = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "if ($tiers.Contains('lang')) {"
    , ScIndent t02-tiers-2
    , ScRaw "}"
    , ScRaw "if ($tiers.Contains('apps')) { $tierDirs.Add('codex\\test\\apps') }"
    , ScComment "cost, ui and examples were reachable by NO tier and so by no -All until"
    , ScComment "2026-09-07: this list is consulted non-recursively, so a subdirectory nobody"
    , ScComment "added here is invisible however many chapters it holds. They join `fw`"
    , ScComment "because that is what they ARE, by the classifier rather than by taste: all"
    , ScComment "thirteen cite foreword chapters and land in the foreword battery, and"
    , ScComment "giveup-beats-fuel lands in kernel as well."
    , ScRaw "if ($tiers.Contains('fw'))   { $tierDirs.Add('codex\\test\\forewords'); $tierDirs.Add('codex\\test\\cost'); $tierDirs.Add('codex\\test\\ui'); $tierDirs.Add('codex\\test\\examples') }"
    , ScRaw "if ($tiers.Contains('lib'))  { $tierDirs.Add('codex\\test\\lib') }"
    , ScForEach "d" (SeVar "tierDirs") t02-each-tier-dirs
    , ScRaw "if ($tiers.Contains('hardware')) {"
    , ScIndent [ScForEach "d" (SeVar "allDirs") t02-each-all-dirs]
    , ScRaw "}"
    , ScComment "Batteries are named for what a change can BREAK, so membership is derived"
    , ScComment "from the cite graph by check-battery-coverage.ps1 rather than from a"
    , ScComment "directory or a list here. Two selectors for one question drift, and the one"
    , ScComment "that drifts short reports a green over tests it never chose (L-DENOM)."
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "Battery") "Count") ((SeInt 0)))) t02-battery-count []
    , ScComment "`traps` and `slow` are FILTERS over every directory, like `hardware`, not"
    , ScComment "directories of their own: these tests live among their neighbours and are"
    , ScComment "identified by a sidecar. `traps` is the safety set -- the bounds, trap and"
    , ScComment "fault demos that assert the guest DIES."
    , ScRaw "foreach ($pair in @(@{ Tier = 'traps'; Ext = '.fatal' }, @{ Tier = 'slow'; Ext = '.slow' })) {"
    , ScIndent t02-pair-tier-ext
    , ScRaw "}"
    , ScBlank
    , ScComment "Ask the SELECTOR for its set, never the directory: a count is not a corpus,"
    , ScComment "and a selector that quietly widens or narrows cannot be caught by reading"
    , ScComment "the total (L-DENOM). This exits before any guest, so the selection is"
    , ScComment "checkable without the box -- which is what the 2026-09-07 `-Battery board`"
    , ScComment "overrun cost 320 s and 625 boots to discover."
    , ScIf (SeVar "ListSubjects") t02-if-list-subjects []
    ]

  t02-tiers : List ShellCmd =
    [ ScRaw "foreach ($t in 'lang', 'lib', 'fw', 'apps', 'oracles') { [void]$tiers.Add($t) }"
    , ScRaw "[void]$tiers.Remove('all')"
    ]

  t02-each-tiers : List ShellCmd =
    [ ScRaw "if ($t -notin $known) { Write-Host \"unknown tier '$t' (known: $($known -join ', '))\" -ForegroundColor Red; exit 1 }"
    ]

  t02-test-machine-sidecar : List ShellCmd =
    [ ScRaw "param([string]$Src)"
    , ScRaw "$dir = [System.IO.Path]::GetDirectoryName($Src)"
    , ScRaw "$name = [System.IO.Path]::GetFileNameWithoutExtension($Src)"
    , ScForEach "ext" (SeVar "script:machineSidecars") t02-ext-script-machine-sidecars
    , ScReturn (SeVar "false")
    ]

  t02-ext-script-machine-sidecars : List ShellCmd =
    [ ScRaw "if (Test-Path -PathType Leaf (Join-Path $dir \"$name$ext\")) { return $true }"
    ]

  t02-resolve-minted-disk : List ShellCmd =
    [ ScRaw "param([string]$Path)"
    , ScRaw "if ((Test-Path -PathType Leaf $Path) -or -not (Test-Path -PathType Leaf \"$Path-mint\")) { return @{ Path = $Path; Refused = '' } }"
    , ScRaw "$minted = @(& pwsh -NoProfile -File (Join-Path $PSScriptRoot 'mint-test-disk.ps1') -Recipe \"$Path-mint\")"
    , ScRaw "if ($LASTEXITCODE -eq 0) { return @{ Path = $minted[-1]; Refused = '' } }"
    , ScRaw "return @{ Path = $Path; Refused = \"$($minted[-1])\" }"
    ]

  t02-tiers-2 : List ShellCmd =
    [ ScRaw "if ($Scope -ne 'errors')   { $tierDirs.Add('codex\\test'); $tierDirs.Add('codex\\test\\ops') }"
    , ScRaw "if ($Scope -ne 'positive') { $tierDirs.Add('codex\\test\\errors') }"
    ]

  t02-each-tier-dirs : List ShellCmd =
    [ ScRaw "Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {"
    , ScIndent t02-get-child-item-file
    , ScRaw "}"
    ]

  t02-get-child-item-file : List ShellCmd =
    [ ScRaw "if ($seen.Add($_.FullName)) { $tests.Add($_.FullName) }"
    ]

  t02-each-all-dirs : List ShellCmd =
    [ ScRaw "Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {"
    , ScIndent t02-get-child-item-file-2
    , ScRaw "}"
    ]

  t02-get-child-item-file-2 : List ShellCmd =
    [ ScRaw "if ((Test-MachineSidecar $_.FullName) -and $seen.Add($_.FullName)) { $tests.Add($_.FullName) }"
    ]

  t02-battery-count : List ShellCmd =
    [ ScRaw "$phaseOnly = @('plugs')"
    , ScRaw "$corpus = @('foreword', 'kernel', 'board', 'apps', 'compiler')"
    , ScForEach "b" (SeVar "Battery") t02-each-battery
    ]

  t02-each-battery : List ShellCmd =
    [ ScRaw "$n = $b.Trim().ToLower()"
    , ScComment "A battery that selects nothing and runs green is the failure the"
    , ScComment "whole scheme exists to avoid, so a battery with no corpus says so"
    , ScComment "rather than passing (L-BAILVALUE). Only `plugs` is in that position"
    , ScComment "now: nothing under codex/test cites a plug."
    , ScComment ""
    , ScComment "`compiler` WAS refused here in the words \"nothing under codex\\test"
    , ScComment "cites the compiler\", which is true about cites and false about blast"
    , ScComment "radius: a chapter reaches the compiler through builtins, and a"
    , ScComment "builtin carries no cite. Red ruled on 2026-09-07 that it takes the"
    , ScComment "corpus, membership by `.covers` under the rule \"cites nothing and"
    , ScComment "carries a machine sidecar\", and the refusal had to go in the same CL"
    , ScComment "or the two selectors would disagree (L-DENOM)."
    , ScRaw "if ($n -in $phaseOnly) {"
    , ScIndent t02-n-phase-only
    , ScRaw "}"
    , ScRaw "if ($n -notin $corpus) {"
    , ScIndent t02-n-notin-corpus
    , ScRaw "}"
    , ScRaw "$listed = & (Join-Path $PSScriptRoot 'check-battery-coverage.ps1') -List $n"
    , ScAssign "picked" (SeInt 0)
    , ScAssign "listedCodex" (SeInt 0)
    , ScForEach "line" (SeVar "listed") t02-each-listed
    , ScComment "A battery that adds nothing has not \"run clean\", it has not run."
    , ScComment "The guard was keyed on `$picked -eq 0 -and $listedCodex -eq 0` and"
    , ScComment "that conjunction is why the 2026-09-07 run escaped it: the"
    , ScComment "classifier listed 13 and the battery added 0, so the guard passed"
    , ScComment "and the default tier ran instead. When -Battery is the only"
    , ScComment "selector, $picked alone is the question. With a tier alongside,"
    , ScComment "zero is legitimate: the tier may already hold every member."
    , ScIf (SeBare (SeAnd (SeVar "batteryOnly") (SeBare (SeIntEq (SeVar "picked") ((SeInt 0)))))) t02-battery-only-picked []
    , ScEcho (SeText "-Battery ${n}: $picked chapter(s), of $listedCodex the classifier listed")
    ]

  t02-n-phase-only : List ShellCmd =
    [ ScRaw "Write-Host \"-Battery $n selects no test chapter: nothing under codex\\test cites $n.\" -ForegroundColor Red"
    , ScEcho (SeText "  no gate runs a plug output (Damian, 2026-10-31): run that plug's own harness by hand.")
    , ScExit (SeInt 1)
    ]

  t02-n-notin-corpus : List ShellCmd =
    [ ScRaw "Write-Host \"unknown battery '$b' (known: $(($corpus + $phaseOnly) -join ', '))\" -ForegroundColor Red"
    , ScExit (SeInt 1)
    ]

  t02-each-listed : List ShellCmd =
    [ ScRaw "$rel = (\"$line\".Trim() -replace '/', '\\')"
    , ScRaw "if (-not $rel.EndsWith('.codex')) { continue }"
    , ScIncrement "listedCodex"
    , ScRaw "if (-not (Test-Path -PathType Leaf $rel)) { continue }"
    , ScComment "Only the directories this harness knows how to run: the"
    , ScComment "classifier walks all of codex\\test and the runner does not."
    , ScRaw "if ([System.IO.Path]::GetDirectoryName($rel) -notin $allDirs) { continue }"
    , ScRaw "$full = (Resolve-Path -LiteralPath $rel).Path"
    , ScRaw "if ($seen.Add($full)) { $tests.Add($full); $picked++ }"
    ]

  t02-battery-only-picked : List ShellCmd =
    [ ScRaw "Write-Host \"FAIL: -Battery $n selected no chapters ($listedCodex listed by check-battery-coverage.ps1).\" -ForegroundColor Red"
    , ScEcho (SeText "  a battery that selects nothing must not run, and must never fall through to another set.")
    , ScExit (SeInt 1)
    ]

  t02-pair-tier-ext : List ShellCmd =
    [ ScRaw "if (-not $tiers.Contains($pair.Tier)) { continue }"
    , ScForEach "d" (SeVar "allDirs") t02-each-all-dirs-2
    ]

  t02-each-all-dirs-2 : List ShellCmd =
    [ ScRaw "Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {"
    , ScIndent t02-get-child-item-file-3
    , ScRaw "}"
    ]

  t02-get-child-item-file-3 : List ShellCmd =
    [ ScRaw "$sc = Join-Path $_.DirectoryName ([System.IO.Path]::GetFileNameWithoutExtension($_.Name) + $pair.Ext)"
    , ScRaw "if ((Test-Path -PathType Leaf $sc) -and $seen.Add($_.FullName)) { $tests.Add($_.FullName) }"
    ]

  t02-if-list-subjects : List ShellCmd =
    [ ScEcho (SeText "selected $($tests.Count) subject(s) from tiers [$(($tiers | Sort-Object) -join ',')] batteries [$(($Battery | Sort-Object) -join ',')]")
    , ScRaw "$tests | Sort-Object | ForEach-Object { Write-Output $_.Substring((Get-Location).Path.Length + 1) }"
    , ScExit (SeInt 0)
    ]

Section: T03 -- Kernel Provenance and Pre-filter

  t03-body : List ShellCmd =
    [ ScBlank
    , ScComment "--- Which compiler is on trial, and is it the one you think? ---------------"
    , ScComment ""
    , ScComment "The battery compiles every sample with build-output\\bare-metal\\Codex.cdx."
    , ScComment "Nothing used to state which compiler that was, or check it: the digest was"
    , ScComment "computed at the END and written to the rollup as stage0=..., compared"
    , ScComment "against nothing. On 2026-08-03 a release battery ran a whole tree against a"
    , ScComment "kernel left behind by an earlier -CodexCdx run -- a compiler six days and"
    , ScComment "two seeds stale -- and reported 11 failures that were all the antique"
    , ScComment "compiler missing features the tests use. The run cost 12 minutes and nearly"
    , ScComment "blocked a release on defects that did not exist."
    , ScComment ""
    , ScComment "So: name the kernel up front, and refuse to run one whose provenance is"
    , ScComment "unknown. Legitimate kernels are the depot seed (a fresh workspace) or the"
    , ScComment "last build's signed output (the normal edit-build-test loop). Anything else"
    , ScComment "is a leftover, and -CodexCdx is how you ask for one on purpose."
    , ScRaw "$stage0 = Join-Path (Resolve-Path .).Path 'build-output\\bare-metal\\Codex.cdx'"
    , ScAssign "kernelBackup" (SeText "$stage0.prebattery")
    , ScAssign "script:RestoreKernel" (SeBool False)
    , ScBlank
    , ScFunction "Get-Digest" [sh-param "p" SptString] t03-get-digest-string-p
    , ScBlank
    , ScRaw "$seedDigest = Get-Digest 'seed\\Codex.cdx'"
    , ScRaw "$sutDigest  = Get-Digest 'build\\output\\Sut.cdx'"
    , ScBlank
    , ScIf (SeVar "CodexCdx") t03-if-codex-cdx t03-if-codex-cdx-else
    , ScBlank
    , ScFunctionBlock "Restore-Kernel" t03-restore-kernel
    , ScBlank
    , ScComment "==========================================================================="
    , ScComment "Pre-filter: handle skips, partition into compile lists"
    , ScComment "==========================================================================="
    , ScRaw "$toCompile = [System.Collections.Generic.List[string]]::new()"
    , ScAssign "srcDirOf" (SeHashLiteral)
    , ScAssign "catOf" (SeHashLiteral)
    , ScForEach "src" (SeVar "tests") t03-each-tests
    , ScBlank
    , ScComment "Sort lightest-first: tests with fewer cites compile smaller source concats"
    , ScComment "and consume less heap, so the batch VM gets through more tests before"
    , ScComment "exhausting the 3GB arena."
    , ScRaw "$toCompile = @($toCompile | Sort-Object {"
    , ScIndent t03-to-compile-sort
    , ScRaw "})"
    , ScBlank
    , ScComment "Each batch slot boots one guest, so concurrent guests IS $Jobs. Trim to what\n# the box holds before the deal below, which sizes its lists from $Jobs.\n#\n# A BATCH GUEST IS NOT A SINGLE-COMPILE GUEST and the difference is the whole\n# defect this argument fixes. One VM here compiles the slot's whole share in\n# ONE session, so its arena accumulates: measured 2026-08-28, 60 chapters\n# peaked at 234 MB, 200 at 1,007 MB, and one realistic slot of a 4-way deal\n# (416 chapters, 874 KB of source) at 2,134 MB. The default 1100 is the\n# SINGLE-unit figure, right for deck-headroom and for phase 2 below, where\n# every test gets a fresh VM. Budgeting a batch at it admitted four slots\n# needing ~8.5 GB on a box with ~6.5 GB free, and val's full gate died with\n# 1,110 tests reporting \"VM died EARLIER in the batch\".\n#\n# The first measurement that set 1100 sampled THIRTY chapters and generalised;\n# it read 1,098 MB only because those thirty were the largest by file size, so\n# a wrong number came out of a fixture whose shape was wrong twice over\n# (L-CONSTRUCT). Re-measure by sampling codex-vm's WorkingSet64 across a full\n# slot, never a subset (L-COUNT)."
    , ScRaw "$Jobs = Get-VmAdmittedSlots -Slots $Jobs -GuestMB 2200 -What 'phase 1 batch compile'"
    , ScEcho (SeText "Tests: $($tests.Count) total, $($tests.Count - $toCompile.Count) skipped, $($toCompile.Count) to compile ($Jobs batch slots)")
    , ScComment "A model root a test's .vmargs names must exist, or its guest refuses to start and prints nothing."
    , ScRunArgs (SePathJoinN [SeVar "PSScriptRoot", SeLit "diffusion-roots.ps1"]) [SaNamed "Subjects" (SeVar "toCompile")]
    , ScIf (SeBare (SeNot (SeExitCodeEq 0))) [ScEcho (SeLit "ERROR: battery refused: a diffusion model root a test names is missing (above)"), ScExit (SeInt 1)] []
    ]

  t03-get-digest-string-p : List ShellCmd =
    [ ScRaw "if ($p -and (Test-Path $p)) { return (Get-FileHash -Algorithm SHA256 $p).Hash }"
    , ScReturn (SeVar "null")
    ]

  t03-if-codex-cdx : List ShellCmd =
    [ ScRaw "if (-not (Test-Path $CodexCdx)) { Write-Host \"REFUSED: -CodexCdx '$CodexCdx' does not exist.\"; exit 2 }"
    , ScRaw "New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null"
    , ScComment "Put the working kernel back afterwards. This script used to leave the"
    , ScComment "substitute installed, which is how the stale kernel above was born."
    , ScRaw "if (Test-Path $stage0) { Copy-Item -Force $stage0 $kernelBackup; $script:RestoreKernel = $true }"
    , ScRaw "Copy-Item -Force $CodexCdx $stage0"
    , ScEcho (SeText "battery compiler: EXPLICIT -CodexCdx $CodexCdx")
    , ScEcho (SeText "                  $((Get-Digest $stage0).Substring(0,16))  $((Get-Item $stage0).Length) bytes")
    , ScRaw "if ($script:RestoreKernel) { Write-Host \"                  (working kernel saved; restored when the run ends)\" }"
    ]

  t03-if-codex-cdx-else : List ShellCmd =
    [ ScIf (SeBare (SeNot (SePathExists (SeVar "stage0")))) t03-not-test-stage0 []
    , ScRaw "$kDigest = Get-Digest $stage0"
    , ScRaw "$origin = if ($kDigest -eq $sutDigest) { 'last build (build\\output\\Sut.cdx)' }"
    , ScRaw "          elseif ($kDigest -eq $seedDigest) { 'depot seed (seed\\Codex.cdx)' }"
    , ScRaw "          else { $null }"
    , ScIf (SeBare (SeNot (SeVar "origin"))) t03-if-not-origin t03-if-not-origin-else
    ]

  t03-not-test-stage0 : List ShellCmd =
    [ ScRaw "if (-not $seedDigest) { Write-Host \"REFUSED: no battery kernel and no seed\\Codex.cdx to install from. Run build\\build.ps1.\"; exit 2 }"
    , ScRaw "New-Item -ItemType Directory -Force -Path (Split-Path $stage0) | Out-Null"
    , ScRaw "Copy-Item -Force 'seed\\Codex.cdx' $stage0"
    , ScEcho (SeText "battery compiler: installed from seed (no kernel present)")
    ]

  t03-if-not-origin : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "=== REFUSED: the battery kernel has unknown provenance ===")
    , ScEcho (SeText "  kernel : $($kDigest.Substring(0,16))  $((Get-Item $stage0).Length) bytes  $((Get-Item $stage0).LastWriteTime)")
    , ScEcho (SeText "  seed   : $(if ($seedDigest) { $seedDigest.Substring(0,16) } else { '<missing>' })")
    , ScEcho (SeText "  Sut    : $(if ($sutDigest)  { $sutDigest.Substring(0,16)  } else { '<none -- no build in this workspace>' })")
    , ScEcho (SeLit "")
    , ScEcho (SeLit "  It matches neither the depot seed nor the last build, so it is a")
    , ScEcho (SeLit "  leftover -- usually a compiler an earlier -CodexCdx run installed.")
    , ScEcho (SeLit "  A battery against it tests that compiler, not this tree, and its")
    , ScEcho (SeLit "  failures are fiction.")
    , ScEcho (SeLit "")
    , ScEcho (SeLit "  Fix (pick one):")
    , ScEcho (SeLit "    build\\build.ps1                     # build this tree, then re-run")
    , ScEcho (SeLit "    Copy-Item -Force seed\\Codex.cdx build-output\\bare-metal\\Codex.cdx")
    , ScEcho (SeLit "    build\\test.ps1 -CodexCdx <path> ... # if you meant to test another compiler")
    , ScEcho (SeLit "    build\\test.ps1 -AllowStaleKernel ... # you know exactly what this is")
    , ScEcho (SeLit "")
    , ScRaw "if (-not $AllowStaleKernel) { exit 2 }"
    , ScEcho (SeLit "  -AllowStaleKernel given: proceeding anyway.")
    ]

  t03-if-not-origin-else : List ShellCmd =
    [ ScEcho (SeText "battery compiler: $($kDigest.Substring(0,16))  $((Get-Item $stage0).Length) bytes  <- $origin")
    ]

  t03-restore-kernel : List ShellCmd =
    [ ScIf (SeBare (SeAnd (SeVar "script:RestoreKernel") (SePathExists (SeVar "kernelBackup")))) t03-script-restore-kernel-test []
    ]

  t03-script-restore-kernel-test : List ShellCmd =
    [ ScRaw "Copy-Item -Force $kernelBackup $stage0"
    , ScRaw "Remove-Item -Force $kernelBackup"
    , ScEcho (SeText "battery compiler: working kernel restored ($((Get-Digest $stage0).Substring(0,16)))")
    ]

  t03-each-tests : List ShellCmd =
    [ ScRaw "$name = [System.IO.Path]::GetFileNameWithoutExtension($src)"
    , ScRaw "$dir  = [System.IO.Path]::GetDirectoryName($src)"
    , ScRaw "$srcDirOf[$name] = $dir"
    , ScRaw "$leaf = Split-Path -Leaf $dir"
    , ScRaw "$catOf[$name] = if ($leaf -eq 'test') { 'root' } else { $leaf }"
    , ScAssign "skipFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.skip"]))
    , ScAssign "slowFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.slow"]))
    , ScRaw "if (Test-Path -PathType Leaf $skipFile) {"
    , ScIndent t03-test-type-skip-file
    , ScRaw "} elseif ((Test-Path -PathType Leaf (Join-Path $dir \"$name.arch-only\")) -and -not (@(Get-Content (Join-Path $dir \"$name.arch-only\") | ForEach-Object { $_.Trim() }) -contains 'x86-64')) {"
    , ScIndent t03-test-type-join-dir
    , ScRaw "} elseif (-not $runSlow -and (Test-Path -PathType Leaf $slowFile)) {"
    , ScIndent t03-not-run-slow-test
    , ScRaw "} elseif (-not $runFatal -and (Test-Path -PathType Leaf (Join-Path $dir \"$name.fatal\"))) {"
    , ScIndent t03-not-run-fatal-test
    , ScRaw "} else {"
    , ScIndent [ScRaw "$toCompile.Add($src)"]
    , ScRaw "}"
    ]

  t03-test-type-skip-file : List ShellCmd =
    [ ScRaw "$reason = (Get-Content -TotalCount 1 $skipFile)"
    , ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))
    , ScRaw "\"SKIPPED`t$name`t$reason\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t03-test-type-join-dir : List ShellCmd =
    [ ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))
    , ScRaw "\"SKIPPED`t$name`t(arch-only) $((Get-Content (Join-Path $dir \"$name.arch-only\")) -join ' ')\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t03-not-run-slow-test : List ShellCmd =
    [ ScRaw "$reason = (Get-Content -TotalCount 1 $slowFile)"
    , ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))
    , ScRaw "\"SKIPPED`t$name`t(slow) $reason\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t03-not-run-fatal-test : List ShellCmd =
    [ ScRaw "$reason = (Get-Content -TotalCount 1 (Join-Path $dir \"$name.fatal\"))"
    , ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))
    , ScRaw "\"SKIPPED`t$name`t(fatal) $reason\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t03-to-compile-sort : List ShellCmd =
    [ ScRaw "$m = Select-String -Path $_ -Pattern '^\\s*cites' -ErrorAction SilentlyContinue"
    , ScRaw "if ($m) { @($m).Count } else { 0 }"
    ]

Section: T04 -- Phase 1 Batch Compile and Crash Containment

  t04-body : List ShellCmd =
    [ ScBlank
    , ScComment "==========================================================================="
    , ScComment "Phase 1: Batch compile -- one VM per job slot"
    , ScComment "==========================================================================="
    , ScAssign "batchDir" (SeBare (SePathJoinN [SeVar "OutRoot", SeLit "_batches"]))
    , ScRaw "if (Test-Path $batchDir) { Remove-Item -Recurse -Force $batchDir }"
    , ScRaw "New-Item -ItemType Directory -Force -Path $batchDir | Out-Null"
    , ScBlank
    , ScAssign "listFiles" (SeArrayLiteral [])
    , ScAssign "writers" (SeArrayLiteral [])
    , ScForLoop "j" (SeInt 0) (SeBare (SeIntLt (SeVar "j") (SeVar "Jobs"))) (SePostIncrement "j") t04-j-jobs
    , ScComment "Dealt by the LAST run's measured unit size (.src-bytes under $OutRoot, which"
    , ScComment "survives between runs), heaviest first onto the lightest batch, rather than"
    , ScComment "$i % $Jobs. Measured 2026-08-20 at -Jobs 8: round-robin put 11.0 to 17.4 MB"
    , ScComment "into the eight batches and their VMs ran 20 to 62 s; size-dealt, 14.2 MB each."
    , ScComment "A test with no reading goes to the batch with the fewest members (by load it"
    , ScComment "would pile every new test onto one batch: measured, 110 of them on one slot),"
    , ScComment "so a tree with no readings at all deals exactly as round-robin did. Heavy-first"
    , ScComment "order is pinned by the original index, because Sort-Object -Descending reverses"
    , ScComment "tied order and the control came out balanced but not round-robin. Each batch"
    , ScComment "keeps the lightest-first order from above."
    , ScAssign "weightOf" (SeHashLiteral)
    , ScAssign "indexOf" (SeHashLiteral)
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "toCompile") "Count"))) (SePostIncrement "i") t04-i-to-compile-count
    , ScAssign "slotOf" (SeHashLiteral)
    , ScRaw "$slotLoad = New-Object 'long[]' $Jobs"
    , ScRaw "$slotCount = New-Object 'int[]' $Jobs"
    , ScRaw "$byWeight = @($toCompile | Sort-Object @{ Expression = { $weightOf[$_] }; Descending = $true }, @{ Expression = { $indexOf[$_] }; Descending = $false })"
    , ScForEach "src" (SeVar "byWeight") t04-each-by-weight
    , ScRaw "foreach ($src in $toCompile) { $writers[$slotOf[$src]].WriteLine($src) }"
    , ScRaw "foreach ($w in $writers) { $w.Close() }"
    , ScBlank
    , ScAssign "compileScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "test-compile-batch.ps1"]))
    , ScRaw "$phase1Sw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScAssign "compileProcs" (SeArrayLiteral [])
    , ScComment "The batch child's stderr is where test-compile-batch.ps1 reports a dropped"
    , ScComment "or short stream (DROPPED / BATCH INVALIDATED). Start-Process gave it a"
    , ScComment "hidden console, so that report was written where nobody could ever read it:"
    , ScComment "the Update 52 misattribution shipped 26 false reds with the one line naming"
    , ScComment "the cause discarded. Captured on the SYSTEM temp (a redirect is one write"
    , ScComment "per stderr line and D: pays ~7.5 ms each), moved into _batches after."
    , ScAssign "compileErrs" (SeArrayLiteral [])
    , ScForLoop "j" (SeInt 0) (SeBare (SeIntLt (SeVar "j") (SeVar "Jobs"))) (SePostIncrement "j") t04-j-jobs-2
    , ScBlank
    , ScEcho (SeText "Waiting for $($compileProcs.Count) compile batches...")
    , ScForEach "proc" (SeVar "compileProcs") t04-each-compile-procs
    , ScForEach "c" (SeVar "compileErrs") t04-each-compile-errs
    , ScRaw "$phase1Sw.Stop()"
    , ScEcho (SeText "Phase 1 (compile) complete in $([int]($phase1Sw.ElapsedMilliseconds/1000))s.")
    , ScRaw "$retrySw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScBlank
    , ScComment "==========================================================================="
    , ScComment "Phase 1a: Contain batch-VM crashes."
    , ScComment ""
    , ScComment "Exit 99 means the VM died before this test ran. A death also poisons the"
    , ScComment "results BEFORE it in the same session: the batch REPL carries state across"
    , ScComment "compiles, and a corrupted session reports phantom diagnostics (exit 7) or"
    , ScComment "crashes (exit 4) the test does not produce standalone. See"
    , ScComment "battery-triage-2026-07-23."
    , ScComment ""
    , ScComment "The old design answered any death by re-running EVERY non-clean result"
    , ScComment "standalone and sequentially: 683 tests and 479 s on the 2026-07-27"
    , ScComment "baseline. Now, per round: the test that killed the VM (exit 4 with a !EXC"
    , ScComment "dump in its build.log) gets one standalone compile, which is"
    , ScComment "authoritative -- it can overturn a false failure but never manufacture a"
    , ScComment "pass, because a genuine failure fails standalone too. Every OTHER"
    , ScComment "non-clean result (4, 7, 99) from a batch that suffered a death is"
    , ScComment "re-batched into fresh batch VMs, where a clean session either reproduces"
    , ScComment "the failure or clears it. Rounds repeat until a round has no death (its"
    , ScComment "results are then real, the prior behaviour for clean runs); after the"
    , ScComment "round cap, whatever is left falls back to standalone."
    , ScComment "==========================================================================="
    , ScAssign "compileScript2" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "compile.ps1"]))
    , ScAssign "srcOf" (SeHashLiteral)
    , ScRaw "foreach ($src in $toCompile) { $srcOf[[System.IO.Path]::GetFileNameWithoutExtension($src)] = $src }"
    , ScAssign "confirmed" (SeHashLiteral)
    , ScBlank
    , ScFunctionBlock "Get-BatchExit" t04-get-batch-exit
    , ScBlank
    , ScFunctionBlock "Test-CrashDump" t04-test-crash-dump
    , ScBlank
    , ScFunctionBlock "Invoke-StandaloneRetry" t04-invoke-standalone-retry
    , ScBlank
    , ScComment "Splits a death-batch's survivors across fresh batch VMs and returns the"
    , ScComment "new membership (array of name arrays) for the next round's death analysis."
    , ScFunctionBlock "Invoke-RebatchRound" t04-invoke-rebatch-round
    , ScBlank
    , ScComment "Which batches suffered a death, and what inside them needs what."
    , ScFunctionBlock "Get-DeathRetrySets" t04-get-death-retry-sets
    , ScBlank
    , ScAssign "batches" (SeArrayLiteral [])
    , ScForEach "lf" (SeVar "listFiles") t04-each-list-files
    , ScBlank
    , ScAssign "roundCap" (SeInt 5)
    , ScAssign "round" (SeInt 0)
    , ScWhile (SeVar "true") t04-while
    , ScBlank
    , ScComment "A deck overflow (CDX9002) reported from a batch session can be the"
    , ScComment "session's cumulative arena state rather than the test's own demand:"
    , ScComment "foreword-all-compile hit LOWER's deck floor in a shared VM (2026-07-27)"
    , ScComment "and compiles clean standalone with the same flags and seed. Batch deck"
    , ScComment "overflows are therefore always confirmed standalone -- they are rare,"
    , ScComment "and a genuine one fails standalone too."
    , ScForEach "src" (SeVar "toCompile") t04-each-to-compile
    , ScBlank
    , ScRaw "$retrySw.Stop()"
    ]

  t04-j-jobs : List ShellCmd =
    [ ScAssign "lf" (SeBare (SePathJoinN [SeVar "batchDir", SeText "batch-$j.txt"]))
    , ScRaw "$listFiles += $lf"
    , ScRaw "$writers += [System.IO.StreamWriter]::new($lf, $false, [System.Text.UTF8Encoding]::new($false))"
    ]

  t04-i-to-compile-count : List ShellCmd =
    [ ScRaw "$src = $toCompile[$i]"
    , ScRaw "$indexOf[$src] = $i"
    , ScRaw "$n = [System.IO.Path]::GetFileNameWithoutExtension($src)"
    , ScRaw "$sbF = Join-Path (Join-Path $OutRoot $n) '.src-bytes'"
    , ScRaw "$w = 0L"
    , ScIf (SeBare (SeFileExists (SeVar "sbF"))) t04-if-test-type-sb-f []
    , ScRaw "$weightOf[$src] = $w"
    ]

  t04-if-test-type-sb-f : List ShellCmd =
    [ ScRaw "$sbText = (Get-Content -TotalCount 1 $sbF -ErrorAction SilentlyContinue)"
    , ScRaw "if ($sbText -and ($sbText.Trim() -match '^\\d+$')) { $w = [long]$sbText.Trim() }"
    ]

  t04-each-by-weight : List ShellCmd =
    [ ScAssign "k" (SeInt 0)
    , ScIf (SeBare (SeIntGt (SeIndex (SeVar "weightOf") (SeVar "src")) ((SeInt 0)))) t04-weight-of-src t04-block
    , ScRaw "$slotOf[$src] = $k"
    , ScRaw "$slotLoad[$k] += $weightOf[$src]"
    , ScRaw "$slotCount[$k] += 1"
    ]

  t04-weight-of-src : List ShellCmd =
    [ ScForLoop "s" (SeInt 1) (SeBare (SeIntLt (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t04-s-jobs
    ]

  t04-s-jobs : List ShellCmd =
    [ ScRaw "if ($slotLoad[$s] -lt $slotLoad[$k] -or ($slotLoad[$s] -eq $slotLoad[$k] -and $slotCount[$s] -lt $slotCount[$k])) { $k = $s }"
    ]

  t04-block : List ShellCmd =
    [ ScForLoop "s" (SeInt 1) (SeBare (SeIntLt (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t04-s-jobs-2
    ]

  t04-s-jobs-2 : List ShellCmd =
    [ ScRaw "if ($slotCount[$s] -lt $slotCount[$k] -or ($slotCount[$s] -eq $slotCount[$k] -and $slotLoad[$s] -lt $slotLoad[$k])) { $k = $s }"
    ]

  t04-j-jobs-2 : List ShellCmd =
    [ ScRaw "$lf = $listFiles[$j]"
    , ScRaw "if ((Get-Item $lf).Length -eq 0) { continue }"
    , ScRaw "$pcore = ($j + 1) % 8"
    , ScTempFile "be"
    , ScRaw "$proc = Start-Process -FilePath 'pwsh' -ArgumentList @("
    , ScRaw "    '-NoProfile', '-File', $compileScript,"
    , ScRaw "    '-ListFile', $lf,"
    , ScRaw "    '-OutRoot', $OutRoot,"
    , ScRaw "    '-PCore', $pcore"
    , ScRaw ") -PassThru -WindowStyle Hidden -RedirectStandardError $be"
    , ScRaw "$compileProcs += $proc"
    , ScRaw "$compileErrs += @{ Err = $be; Name = \"batch-$j\" }"
    , ScEcho (SeText "  batch $j started (pid $($proc.Id), pcore $pcore)")
    ]

  t04-each-compile-procs : List ShellCmd =
    [ ScRaw "$proc.WaitForExit(1800000) | Out-Null"
    , ScIf (SeBare (SeNot (SeProperty (SeVar "proc") "HasExited"))) t04-not-proc-has-exited []
    ]

  t04-not-proc-has-exited : List ShellCmd =
    [ ScRaw "Write-Host \"  batch pid $($proc.Id) timed out -- killing\" -ForegroundColor Yellow"
    , ScRaw "try { Stop-Process -Id $proc.Id -Force -ErrorAction Stop } catch {}"
    ]

  t04-each-compile-errs : List ShellCmd =
    [ ScRaw "if (-not (Test-Path -PathType Leaf $c.Err)) { continue }"
    , ScRaw "$t = [System.IO.File]::ReadAllText($c.Err)"
    , ScRaw "Move-Item -Force $c.Err (Join-Path $batchDir \"$($c.Name).err\")"
    , ScRaw "if ($t -match 'DROPPED|BATCH INVALIDATED') { Write-Host \"  $($c.Name): $($t.Trim())\" -ForegroundColor Yellow }"
    ]

  t04-get-batch-exit : List ShellCmd =
    [ ScRaw "param([string]$Name)"
    , ScRaw "$ef = Join-Path (Join-Path $OutRoot $Name) '.exitcode'"
    , ScRaw "if (Test-Path $ef) { (Get-Content -TotalCount 1 $ef).Trim() } else { '99' }"
    ]

  t04-test-crash-dump : List ShellCmd =
    [ ScRaw "param([string]$Name)"
    , ScRaw "$log = Join-Path (Join-Path $OutRoot $Name) 'build.log'"
    , ScRaw "(Test-Path -PathType Leaf $log) -and (Select-String -Path $log -Pattern '!EXC' -SimpleMatch -Quiet)"
    ]

  t04-invoke-standalone-retry : List ShellCmd =
    [ ScRaw "param([string]$Name)"
    , ScRaw "$src = $srcOf[$Name]"
    , ScAssign "out" (SeBare (SePathJoinN [SeVar "OutRoot", SeVar "Name"]))
    , ScRaw "New-Item -ItemType Directory -Force -Path $out | Out-Null"
    , ScComment "The retry has to compile the test the way the batch would have: the"
    , ScComment ".flags sidecar rides along, or every .flags test becomes a false"
    , ScComment "failure at once (foreword-all-compile without decks=150, prose-anchor"
    , ScComment "without prose)."
    , ScRaw "$flagsFile = Join-Path ([System.IO.Path]::GetDirectoryName($src)) \"$Name.flags\""
    , ScRaw "$rawFlags = if (Test-Path -PathType Leaf $flagsFile) { (Get-Content -TotalCount 1 $flagsFile).Trim() } else { '' }"
    , ScRaw "$retryArgs = @('-NoProfile', '-File', $compileScript2, '-Src', $src,"
    , ScRaw "    '-Out', (Join-Path $out \"$Name.cdx\"), '-Log', (Join-Path $out 'build.log'))"
    , ScRaw "if ($rawFlags) { $retryArgs += @('-RawFlags', $rawFlags) }"
    , ScRaw "$p = Start-Process -FilePath 'pwsh' -ArgumentList $retryArgs -PassThru -WindowStyle Hidden"
    , ScRaw "$p.WaitForExit(120000) | Out-Null"
    , ScRaw "if (-not $p.HasExited) { try { Stop-Process -Id $p.Id -Force } catch {} }"
    , ScRaw "$retryExit = if ($p.HasExited) { $p.ExitCode } else { 4 }"
    , ScRaw "\"$retryExit\" | Set-Content -Path (Join-Path $out '.exitcode') -Encoding UTF8"
    , ScRaw "Write-Host \"  standalone $Name`: exit $retryExit\""
    ]

  t04-invoke-rebatch-round : List ShellCmd =
    [ ScRaw "param([string[]]$Names, [int]$RoundNum)"
    , ScRaw "$slots = [Math]::Max(1, [Math]::Min($Jobs, [int][Math]::Ceiling($Names.Count / 20.0)))"
    , ScRaw "$lists = @(); $rbWriters = @(); $membership = @()"
    , ScForLoop "k" (SeInt 0) (SeBare (SeIntLt (SeVar "k") (SeVar "slots"))) (SePostIncrement "k") t04-k-slots
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "Names") "Count"))) (SePostIncrement "i") t04-i-names-count
    , ScRaw "foreach ($w in $rbWriters) { $w.Close() }"
    , ScRaw "$procs = @()"
    , ScRaw "$rbErrs = @()"
    , ScForLoop "k" (SeInt 0) (SeBare (SeIntLt (SeVar "k") (SeVar "slots"))) (SePostIncrement "k") t04-k-slots-2
    , ScForEach "proc" (SeVar "procs") t04-each-procs
    , ScForEach "c" (SeVar "rbErrs") t04-each-rb-errs
    , ScRaw "return ,$membership"
    ]

  t04-k-slots : List ShellCmd =
    [ ScAssign "lf" (SeBare (SePathJoinN [SeVar "batchDir", SeText "rebatch-$RoundNum-$k.txt"]))
    , ScRaw "$lists += $lf"
    , ScRaw "$rbWriters += [System.IO.StreamWriter]::new($lf, $false, [System.Text.UTF8Encoding]::new($false))"
    , ScRaw "$membership += ,@()"
    ]

  t04-i-names-count : List ShellCmd =
    [ ScRaw "$k = $i % $slots"
    , ScRaw "$rbWriters[$k].WriteLine($srcOf[$Names[$i]])"
    , ScRaw "$membership[$k] += $Names[$i]"
    ]

  t04-k-slots-2 : List ShellCmd =
    [ ScTempFile "be"
    , ScRaw "$procs += Start-Process -FilePath 'pwsh' -ArgumentList @("
    , ScRaw "    '-NoProfile', '-File', $compileScript,"
    , ScRaw "    '-ListFile', $lists[$k], '-OutRoot', $OutRoot, '-PCore', (($k + 1) % 8)"
    , ScRaw ") -PassThru -WindowStyle Hidden -RedirectStandardError $be"
    , ScRaw "$rbErrs += @{ Err = $be; Name = \"rebatch-$RoundNum-$k\" }"
    ]

  t04-each-procs : List ShellCmd =
    [ ScRaw "$proc.WaitForExit(1800000) | Out-Null"
    , ScRaw "if (-not $proc.HasExited) { try { Stop-Process -Id $proc.Id -Force -ErrorAction Stop } catch {} }"
    ]

  t04-each-rb-errs : List ShellCmd =
    [ ScRaw "if (-not (Test-Path -PathType Leaf $c.Err)) { continue }"
    , ScRaw "$t = [System.IO.File]::ReadAllText($c.Err)"
    , ScRaw "Move-Item -Force $c.Err (Join-Path $batchDir \"$($c.Name).err\")"
    , ScRaw "if ($t -match 'DROPPED|BATCH INVALIDATED') { Write-Host \"  $($c.Name): $($t.Trim())\" -ForegroundColor Yellow }"
    ]

  t04-get-death-retry-sets : List ShellCmd =
    [ ScRaw "param([object[]]$Batches)"
    , ScRaw "$crashers = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$rebatch  = [System.Collections.Generic.List[string]]::new()"
    , ScForEach "members" (SeVar "Batches") t04-each-batches
    , ScRaw "@{ Crashers = $crashers; Rebatch = $rebatch }"
    ]

  t04-each-batches : List ShellCmd =
    [ ScAssign "dead" (SeVar "false")
    , ScForEach "m" (SeVar "members") t04-each-members
    , ScRaw "if (-not $dead) { continue }"
    , ScForEach "m" (SeVar "members") t04-each-members-2
    ]

  t04-each-members : List ShellCmd =
    [ ScRaw "$e = Get-BatchExit $m"
    , ScRaw "if ($e -eq '99' -or ($e -eq '4' -and (Test-CrashDump $m))) { $dead = $true; break }"
    ]

  t04-each-members-2 : List ShellCmd =
    [ ScRaw "if ($confirmed.ContainsKey($m)) { continue }"
    , ScRaw "$e = Get-BatchExit $m"
    , ScRaw "if ($e -eq '4' -and (Test-CrashDump $m)) { $crashers.Add($m) }"
    , ScRaw "elseif ($e -in '4', '7', '99') { $rebatch.Add($m) }"
    ]

  t04-each-list-files : List ShellCmd =
    [ ScRaw "$members = @(Get-Content $lf | Where-Object { $_.Trim() -ne '' } |"
    , ScRaw "    ForEach-Object { [System.IO.Path]::GetFileNameWithoutExtension($_) })"
    , ScRaw "if ($members.Count -gt 0) { $batches += ,$members }"
    ]

  t04-while : List ShellCmd =
    [ ScRaw "$sets = Get-DeathRetrySets -Batches $batches"
    , ScForEach "name" (SeProperty (SeVar "sets") "Crashers") t04-name-sets-crashers
    , ScRaw "if ($sets.Rebatch.Count -eq 0) { break }"
    , ScIncrement "round"
    , ScIf (SeBare (SeIntGt (SeVar "round") (SeVar "roundCap"))) t04-if-round-cap []
    , ScEcho (SeText "Phase 1a round ${round}: re-batching $($sets.Rebatch.Count) tests from death-batches...")
    , ScRaw "$batches = Invoke-RebatchRound -Names $sets.Rebatch -RoundNum $round"
    ]

  t04-name-sets-crashers : List ShellCmd =
    [ ScRaw "if ($confirmed.ContainsKey($name)) { continue }"
    , ScEcho (SeText "  batch-killer $name -- confirming standalone")
    , ScRaw "Invoke-StandaloneRetry $name"
    , ScRaw "$confirmed[$name] = $true"
    ]

  t04-if-round-cap : List ShellCmd =
    [ ScEcho (SeText "Phase 1a: round cap reached; $($sets.Rebatch.Count) tests fall back to standalone...")
    , ScRaw "foreach ($name in $sets.Rebatch) { Invoke-StandaloneRetry $name }"
    , ScBreak
    ]

  t04-each-to-compile : List ShellCmd =
    [ ScRaw "$name = [System.IO.Path]::GetFileNameWithoutExtension($src)"
    , ScRaw "if ($confirmed.ContainsKey($name)) { continue }"
    , ScRaw "$ef = Join-Path (Join-Path $OutRoot $name) '.exitcode'"
    , ScRaw "if ((Test-Path $ef) -and ((Get-Content -TotalCount 1 $ef).Trim() -eq '7')) {"
    , ScIndent t04-test-ef-get-content
    , ScRaw "}"
    ]

  t04-test-ef-get-content : List ShellCmd =
    [ ScRaw "$log = Join-Path (Join-Path $OutRoot $name) 'build.log'"
    , ScRaw "if ((Test-Path -PathType Leaf $log) -and (Select-String -Path $log -Pattern 'CDX9002' -SimpleMatch -Quiet)) {"
    , ScIndent t04-test-type-log-select
    , ScRaw "}"
    ]

  t04-test-type-log-select : List ShellCmd =
    [ ScEcho (SeText "  deck overflow in batch: $name -- confirming standalone")
    , ScRaw "Invoke-StandaloneRetry $name"
    ]

Section: T05 -- Classify and Phase 2 Run

  t05-body : List ShellCmd =
    [ ScBlank
    , ScComment "==========================================================================="
    , ScComment "Phase 1b: Classify compile results"
    , ScComment "==========================================================================="
    , ScRaw "$needsRun = [System.Collections.Generic.List[hashtable]]::new()"
    , ScRaw "foreach ($src in $toCompile) {"
    , ScRaw "    $name = [System.IO.Path]::GetFileNameWithoutExtension($src)"
    , ScRaw "    $dir  = [System.IO.Path]::GetDirectoryName($src)"
    , ScRaw "    $out  = Join-Path $OutRoot $name"
    , ScIndent [ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))]
    , ScRaw "    $failingFile  = Join-Path $dir \"$name.failing\""
    , ScIndent [ScAssign "expectedFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.expected"]))]
    , ScRaw "    $stdinFile    = Join-Path $dir \"$name.stdin\""
    , ScIndent [ScComment ".keys holds a scancode timeline (`t:scancode` per line, t = ms since"]
    , ScIndent [ScComment "boot). .stdin reaches the serial ring; this reaches the PS/2 key cell,"]
    , ScIndent [ScComment "which is the only path a keyboard read can see."]
    , ScRaw "    $keysFile     = Join-Path $dir \"$name.keys\""
    , ScRaw "    $diskFile     = Join-Path $dir \"$name.disk\""
    , ScIndent [ScComment ".disk-src names another test whose FRESHLY COMPILED cdx becomes this"]
    , ScIndent [ScComment "test's disk. A .disk is a file that was built at some other time by"]
    , ScIndent [ScComment "some other compiler, which is exactly what a pin on the current"]
    , ScIndent [ScComment "compiler's output cannot use: the manifest-scope pin sat skipped with a"]
    , ScIndent [ScComment "shell script beside it for want of this one line."]
    , ScRaw "    $diskSrcFile  = Join-Path $dir \"$name.disk-src\""
    , ScIndent [ScComment ".disk2 is a SECOND image, attached as the primary channel's slave. A test"]
    , ScIndent [ScComment "whose subject is which drive it reached needs two, and with one image"]
    , ScIndent [ScComment "behind every position a working drive-select and a missing one produce"]
    , ScIndent [ScComment "identical output -- which is how block-select came to do nothing for as"]
    , ScIndent [ScComment "long as it did."]
    , ScRaw "    $disk2File    = Join-Path $dir \"$name.disk2\""
    , ScIndent [ScComment ".smp holds a core count: the test is booted with -smp N."]
    , ScRaw "    $smpFile      = Join-Path $dir \"$name.smp\""
    , ScIndent [ScComment ".vmargs holds extra codex-vm flags, for a test whose subject is the"]
    , ScIndent [ScComment "machine rather than the program -- a bus topology, an absent device."]
    , ScRaw "    $vmArgsFile   = Join-Path $dir \"$name.vmargs\""
    , ScIndent [ScComment ".wall holds a run budget in whole seconds above codex-vm's 60 s default."]
    , ScRaw "    $wallFile     = Join-Path $dir \"$name.wall\""
    , ScIndent [ScAssign "log" (SeBare (SePathJoinN [SeVar "out", SeLit "build.log"]))]
    , ScIndent [ScAssign "bin" (SeBare (SePathJoinN [SeVar "out", SeText "$name.cdx"]))]
    , ScIndent [ScAssign "exitFile" (SeBare (SePathJoinN [SeVar "out", SeLit ".exitcode"]))]
    , ScBlank
    , ScRaw "    $exitCode = if (Test-Path $exitFile) { (Get-Content -TotalCount 1 $exitFile).Trim() } else { '99' }"
    , ScRaw "    $compileOk = ($exitCode -eq '0')"
    , ScBlank
    , ScIndent [ScIf (SeBare (SeFileExists (SeVar "failingFile"))) t05-if-test-type-failing-file []]
    , ScBlank
    , ScIndent [ScIf (SeBare (SeNot (SeVar "compileOk"))) t05-if-not-compile-ok []]
    , ScBlank
    , ScRaw "    $mintMaster = Resolve-MintedDisk $diskFile"
    , ScRaw "    $mintSlave = Resolve-MintedDisk $disk2File"
    , ScIndent [ScIf (SeBare (SeOr (SeProperty (SeVar "mintMaster") "Refused") (SeProperty (SeVar "mintSlave") "Refused"))) t05-mint-master-refused-slave []]
    , ScRaw "    $diskFile = $mintMaster.Path"
    , ScRaw "    $disk2File = $mintSlave.Path"
    , ScBlank
    , ScIndent [ScAssign "diagFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.diag"]))]
    , ScIndent [ScIf (SeBare (SeFileExists (SeVar "diagFile"))) t05-if-test-type-diag-file []]
    , ScBlank
    , ScIndent [ScComment "A .fatal test asserts that the guest DIES, and it deliberately carries no"]
    , ScIndent [ScComment ".expected: the !EXC dump's RIP moves with every codegen change, so a"]
    , ScIndent [ScComment "byte-compare would be brittle. That is why this arm must come BEFORE the"]
    , ScIndent [ScComment "no-expected arm below. Without it every one of them lands in"]
    , ScIndent [ScComment "PASS_UNVERIFIED -- compiled, never run, and counted as a pass. Measured"]
    , ScIndent [ScComment "2026-07-28: all 15 were in that state, so -Fatal added 15 to the pass"]
    , ScIndent [ScComment "column and executed none of them. A green that cannot fail reads as"]
    , ScIndent [ScComment "coverage, which is strictly worse than the skip it replaced."]
    , ScIndent [ScAssign "fatalFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.fatal"]))]
    , ScIndent [ScIf (SeBare (SeAnd (SeFileExists (SeVar "fatalFile")) (SeVar "runFatal"))) t05-test-type-fatal-file []]
    , ScBlank
    , ScIndent [ScIf (SeBare (SeNot (SeFileExists (SeVar "expectedFile")))) t05-if-not-test-type-expected-2 []]
    , ScBlank
    , ScIndent [ScAssign "smpCores" (SeInt 0)]
    , ScIndent [ScIf (SeBare (SeFileExists (SeVar "smpFile"))) t05-if-test-type-smp-file []]
    , ScBlank
    , ScIndent [ScAssign "diskSourceBytes" (SeInt (0 - 1))]
    , ScRaw "    if (Test-Path -PathType Leaf $diskSrcFile) {"
    , ScRaw "        $peer = (Get-Content -TotalCount 1 $diskSrcFile).Trim()"
    , ScRaw "        $peerBin = Join-Path (Join-Path $OutRoot $peer) \"$peer.cdx\""
    , ScIndent [ScIndent [ScIf (SeBare (SeNot (SeFileExists (SeVar "peerBin")))) t05-if-not-test-type-peer []]]
    , ScSequence test-capture-disk-size
    , ScIndent [ScIndent [ScAssign "diskFile" (SeVar "peerBin")]]
    , ScRaw "    }"
    , ScBlank
    , ScIndent [ScRaw "$needsRun.Add(@{"]
    , ScIndent [ScIndent t05-needs-run-add-2]
    , ScIndent [ScRaw "})"]
    , ScRaw "}"
    , ScBlank
    , ScComment "==========================================================================="
    , ScComment "Phase 2: Run tests with .expected files. One codex-vm -run-list supervisor"
    , ScComment "per job slot, a FRESH codex-vm child per test, so the cold boot a single run"
    , ScComment "proves is unchanged (OperatorsManual \"Batch mode: -run-list\"). Measured"
    , ScComment "2026-08-22 at -Jobs 8: a pwsh child per test cost 575 ms of which codex-vm"
    , ScComment "itself was 74 ms, and 1,313 runs spent 151 s here. Under CODEX_VM_HOST=qemu"
    , ScComment "the per-test test-run.ps1 path stays, because -run-list is codex-vm's."
    , ScComment "==========================================================================="
    , ScRaw "if ($needsRun.Count -gt 0) {"
    , ScRaw "    $fatalCount = @($needsRun | Where-Object { $_.ContainsKey('Fatal') -and $_.Fatal }).Count"
    , ScIndent [ScComment "Re-asked rather than reused from phase 1: that was minutes ago and the\n    # box is shared. A -run-list supervisor holds one guest at a time, so\n    # concurrent guests is again $Jobs."]
    , ScRaw "    $Jobs = Get-VmAdmittedSlots -Slots $Jobs -What 'phase 2 run'"
    , ScRaw "    $runLabel = \"Phase 2: running $($needsRun.Count) tests\""
    , ScRaw "    if ($fatalCount -gt 0) { $runLabel += \" ($fatalCount judged on the fault, not on .expected)\" }"
    , ScIndent [ScEcho (SeText "$runLabel, $Jobs parallel...")]
    , ScBlank
    , ScIndent [ScComment "ANY UNCAUGHT THROW HERE ENDS THE WHOLE BATTERY, not one test."]
    , ScIndent [ScComment "WaitForExit returns before Windows releases a redirected handle,"]
    , ScIndent [ScComment "so a bare read of an output can land on a locked file while"]
    , ScIndent [ScComment "ErrorActionPreference is Stop. test-cross-batch.ps1 lost 457 tests"]
    , ScIndent [ScComment "to exactly that and stranded five guests at 115,597 CPU-seconds,"]
    , ScIndent [ScComment "because the harness that dies is also the thing enforcing every"]
    , ScIndent [ScComment "child ceiling. Unreadable reads as empty, which fails toward a"]
    , ScIndent [ScComment "reported failure rather than a silent pass."]
    , ScIndent [ScFunction "Read-LogShared" [sh-param "path" SptString] t05-read-log-shared-string]
    , ScBlank
    , ScIndent [ScComment "The verdict on one test from what its run left behind: $RunOk and $Why"]
    , ScIndent [ScComment "from the supervisor's END line, the raw capture filtered exactly as"]
    , ScIndent [ScComment "test-run.ps1 filtered it (CR stripped, HEAP:/WD:/STACK:"]
    , ScIndent [ScComment "telemetry dropped, trailing blank lines cut) into runtime.actual."]
    , ScRaw "    function Write-RunVerdict($t, [bool]$RunOk, [string]$Why) {"
    , ScRaw "        $name = $t.Name"
    , ScIndent [ScIndent [ScAssign "out" (SeBare (SePathJoinN [SeVar "OutRoot", SeVar "name"]))]]
    , ScIndent [ScIndent [ScAssign "resultFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeVar "name"]))]]
    , ScIndent [ScIndent [ScAssign "actual" (SeBare (SePathJoinN [SeVar "out", SeLit "runtime.actual"]))]]
    , ScIndent [ScIndent [ScAssign "txt" (SeLit "")]]
    , ScIndent [ScIndent [ScIf (SeVar "RunOk") t05-if-run-ok []]]
    , ScRaw "        [System.IO.File]::WriteAllText($actual, $txt, [System.Text.UTF8Encoding]::new($false))"
    , ScIndent [ScIndent [ScComment "A fatal test is judged on the fault, not on a byte-compare."]]
    , ScIndent [ScIndent [ScComment "ContainsKey rather than a property read: the other entries in"]]
    , ScIndent [ScIndent [ScComment "$needsRun do not carry this key."]]
    , ScIndent [ScIndent [ScRaw "if ($t.ContainsKey('Fatal') -and $t.Fatal) {"]]
    , ScIndent [ScIndent [ScIndent t05-t-key-fatal]]
    , ScIndent [ScIndent [ScRaw "}"]]
    , ScIndent [ScIndent [ScIf (SeBare (SeNot (SeVar "RunOk"))) t05-if-not-run-ok []]]
    , ScRaw "        $expectedBytes = (Read-LogShared $t.Expected) -replace \"`r\", ''"
    , ScSequence test-resolve-disk-size
    , ScIndent [ScIndent [ScRaw "if ([string]::Equals($expectedBytes, $txt, [StringComparison]::Ordinal)) {"]]
    , ScIndent [ScIndent [ScIndent t05-string-equals-expected-bytes]]
    , ScIndent [ScIndent [ScRaw "} else {"]]
    , ScIndent [ScIndent [ScIndent t05-block-5]]
    , ScIndent [ScIndent [ScRaw "}"]]
    , ScRaw "    }"
    , ScBlank
    , ScRaw "    $phase2Sw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScIndent [ScComment "A .qemu-x86 test needs a device codex-vm does not emulate (virtio-pci):"]
    , ScIndent [ScComment "build/test-qemu-x86.ps1 boots it under QEMU once per arm, one test at a time."]
    , ScRaw "    $qemuX86Runs = @($needsRun | Where-Object { $_.ContainsKey('QemuX86') -and (Test-Path -PathType Leaf $_.QemuX86) })"
    , ScRaw "    foreach ($t in $qemuX86Runs) {"
    , ScRaw "        [void]$needsRun.Remove($t)"
    , ScRaw "        $t.Raw = Join-Path (Join-Path $OutRoot $t.Name) 'runtime.raw'"
    , ScRaw "        & pwsh -NoProfile -File (Join-Path $PSScriptRoot 'test-qemu-x86.ps1') -Kernel $t.Bin -OutFile $t.Raw -ArmsFile $t.QemuX86 -DiskFile $t.Disk"
    , ScRaw "        Write-RunVerdict $t ($LASTEXITCODE -eq 0) 'QEMU arm failed (build/test-qemu-x86.ps1)'"
    , ScRaw "    }"
    , ScIndent [ScComment "A .vm-guests test boots several codex-vm guests on one shared -ivshmem file:"]
    , ScIndent [ScComment "build/test-vm-guests.ps1 runs them as its sidecar orders, one test at a time."]
    , ScRaw "    $vmGuestRuns = @($needsRun | Where-Object { $_.ContainsKey('VmGuests') -and (Test-Path -PathType Leaf $_.VmGuests) })"
    , ScRaw "    foreach ($t in $vmGuestRuns) {"
    , ScRaw "        [void]$needsRun.Remove($t)"
    , ScRaw "        $t.Raw = Join-Path (Join-Path $OutRoot $t.Name) 'runtime.raw'"
    , ScRaw "        & pwsh -NoProfile -File (Join-Path $PSScriptRoot 'test-vm-guests.ps1') -Kernel $t.Bin -OutFile $t.Raw -GuestsFile $t.VmGuests"
    , ScRaw "        Write-RunVerdict $t ($LASTEXITCODE -eq 0) 'a guest did not finish (build/test-vm-guests.ps1)'"
    , ScRaw "    }"
    , ScRaw "    if ($needsRun.Count -gt 0) {"
    , ScIndent [ScIndent [ScIf (SeBare (SeStringEq ((SeEnvVar "CODEX_VM_HOST")) (SeLit "qemu"))) t05-env-codex-vm-host t05-block-6]]
    , ScRaw "    }"
    , ScRaw "    $phase2Sw.Stop()"
    , ScIndent [ScEcho (SeText "Phase 2 (run) complete in $([int]($phase2Sw.ElapsedMilliseconds/1000))s.")]
    , ScRaw "} else {"
    , ScIndent [ScAssign "phase2Sw" (SeVar "null")]
    , ScIndent [ScEcho (SeText "Phase 2 (run) complete.")]
    , ScRaw "}"
    ]

  t05-if-test-type-failing-file : List ShellCmd =
    [ ScIf (SeVar "compileOk") t05-if-compile-ok []
    , ScAssign "codesOk" (SeVar "true")
    , ScRaw "$logText = if (Test-Path $log) { Get-Content -Raw -Path $log } else { '' }"
    , ScComment "A bare `CDX2031` checks only that the code fired. `CDX2031@33:5`"
    , ScComment "also pins WHERE, which a bare code cannot: a diagnostic reported at"
    , ScComment "a synthetic 0,0 span prints with no line:column prefix at all, so a"
    , ScComment "code-only check passes against a compiler that lost the position"
    , ScComment "entirely. That is what the act-block span defect looked"
    , ScComment "like, and it is why a test written for a position needs a form that"
    , ScComment "can fail on one."
    , ScRaw "foreach ($code in (Get-Content $failingFile)) {"
    , ScIndent t05-code-get-content-failing
    , ScRaw "}"
    , ScAssign "messageFile" (SeBare (SePathJoinN [SeVar "dir", SeText "$name.message"]))
    , ScIf (SeBare (SeAnd (SeVar "codesOk") (SeFileExists (SeVar "messageFile")))) t05-codes-ok-test-type []
    , ScIf (SeVar "codesOk") t05-if-codes-ok t05-if-codes-ok-else
    , ScContinue
    ]

  t05-if-compile-ok : List ShellCmd =
    [ ScRaw "\"FAIL_EXPECTED_BUT_COMPILED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-code-get-content-failing : List ShellCmd =
    [ ScRaw "$code = $code.Trim()"
    , ScIfLine (SeBare (SeNot (SeVar "code"))) [ScContinue] []
    , ScRaw "if ($code -match '^(?<c>(CDX)?\\d+)@(?<l>\\d+):(?<col>\\d+)$') {"
    , ScIndent t05-code
    , ScRaw "} elseif ($logText -notmatch \"error (CDX)?0*$code\\b\") { $codesOk = $false; break }"
    ]

  t05-code : List ShellCmd =
    [ ScRaw "$c = $matches['c'] -replace '^CDX', ''"
    , ScRaw "$pat = \"\\b$($matches['l']):$($matches['col']):\\s*error (CDX)?0*$c\\b\""
    , ScRaw "if ($logText -notmatch $pat) { $codesOk = $false; break }"
    ]

  t05-codes-ok-test-type : List ShellCmd =
    [ ScRaw "foreach ($note in (Get-Content $messageFile)) {"
    , ScIndent t05-note-get-content-message
    , ScRaw "}"
    ]

  t05-note-get-content-message : List ShellCmd =
    [ ScRaw "if ($note.Trim() -and -not $logText.Contains($note.Trim())) { $codesOk = $false; break }"
    ]

  t05-if-codes-ok : List ShellCmd =
    [ ScRaw "\"PASS_FAILING`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-if-codes-ok-else : List ShellCmd =
    [ ScRaw "\"FAIL_WRONG_DIAGNOSTIC`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-if-not-compile-ok : List ShellCmd =
    [ ScRaw "\"FAIL_COMPILE`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-mint-master-refused-slave : List ShellCmd =
    [ ScRaw "\"FAIL_DISK_SOURCE`t$name`t$($mintMaster.Refused)$($mintSlave.Refused)\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-if-test-type-diag-file : List ShellCmd =
    [ ScAssign "codesOk" (SeVar "true")
    , ScAssign "missing" (SeLit "")
    , ScRaw "$logText = if (Test-Path $log) { Get-Content -Raw -Path $log } else { '' }"
    , ScRaw "foreach ($code in (Get-Content $diagFile)) {"
    , ScIndent t05-code-get-content-diag
    , ScRaw "}"
    , ScIf (SeBare (SeNot (SeVar "codesOk"))) t05-if-not-codes-ok []
    , ScIf (SeBare (SeNot (SeFileExists (SeVar "expectedFile")))) t05-if-not-test-type-expected []
    ]

  t05-code-get-content-diag : List ShellCmd =
    [ ScRaw "$code = ($code.Trim() -replace '^CDX','')"
    , ScRaw "if (-not $code) { continue }"
    , ScRaw "if ($logText -notmatch \"(error|warning|info|hint|deprecated) (CDX)?0*$code\\b\") { $codesOk = $false; $missing = $code; break }"
    ]

  t05-if-not-codes-ok : List ShellCmd =
    [ ScRaw "\"FAIL_MISSING_DIAGNOSTIC`t$name`tCDX$missing not emitted\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-if-not-test-type-expected : List ShellCmd =
    [ ScRaw "\"PASS_DIAG`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-test-type-fatal-file : List ShellCmd =
    [ ScComment "An optional second line `exc: NN` pins WHICH fault. It matters: a"
    , ScComment "bounds check that fired traps with UD2 (06), while one that was"
    , ScComment "removed reads a wild pointer and page-faults, and \"it died\" alone"
    , ScComment "cannot tell those apart."
    , ScAssign "expectExc" (SeLit "")
    , ScRaw "foreach ($l in @(Get-Content $fatalFile)) {"
    , ScIndent t05-l-get-content-fatal
    , ScRaw "}"
    , ScRaw "$needsRun.Add(@{"
    , ScIndent t05-needs-run-add
    , ScRaw "})"
    , ScContinue
    ]

  t05-l-get-content-fatal : List ShellCmd =
    [ ScRaw "if ($l -match '^\\s*exc:\\s*([0-9A-Fa-f]{1,2})\\s*$') { $expectExc = $matches[1].ToUpper(); break }"
    ]

  t05-needs-run-add : List ShellCmd =
    [ ScRaw "Name = $name; Bin = $bin; Expected = ''; Fatal = $true; ExpectExc = $expectExc"
    , ScRaw "Stdin = $stdinFile; Keys = $keysFile; Disk = $diskFile; Smp = 0"
    , ScRaw "Disk2 = $disk2File; VmArgs = $vmArgsFile; Wall = $wallFile"
    ]

  t05-if-not-test-type-expected-2 : List ShellCmd =
    [ ScRaw "\"PASS_UNVERIFIED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-if-test-type-smp-file : List ShellCmd =
    [ ScRaw "$smpCores = [int]((Get-Content -TotalCount 1 $smpFile).Trim())"
    ]

  t05-if-not-test-type-peer : List ShellCmd =
    [ ScRaw "\"FAIL_DISK_SOURCE`t$name`t$peer produced no cdx\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScContinue
    ]

  t05-needs-run-add-2 : List ShellCmd =
    [ ScRaw "Name = $name; Bin = $bin; Expected = $expectedFile;"
    , ScRaw "Stdin = $stdinFile; Keys = $keysFile; Disk = $diskFile; Smp = $smpCores; DiskSourceBytes = $diskSourceBytes"
    , ScRaw "Disk2 = $disk2File"
    , ScRaw "VmArgs = $vmArgsFile"
    , ScRaw "Wall = $wallFile"
    , ScRaw "QemuX86 = (Join-Path $dir \"$name.qemu-x86\")"
    , ScRaw "VmGuests = (Join-Path $dir \"$name.vm-guests\")"
    ]

  t05-read-log-shared-string : List ShellCmd =
    [ ScForLoop "ri" (SeInt 0) (SeBare (SeIntLt (SeVar "ri") ((SeInt 5)))) (SePostIncrement "ri") t05-ri
    , ScReturn (SeLit "")
    ]

  t05-ri : List ShellCmd =
    [ ScRaw "try {"
    , ScIndent t05-block
    , ScRaw "} catch { Start-Sleep -Milliseconds 100 }"
    ]

  t05-block : List ShellCmd =
    [ ScRaw "$fs = [System.IO.FileStream]::new($path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)"
    , ScRaw "try { $sr = [System.IO.StreamReader]::new($fs); return $sr.ReadToEnd() } finally { $fs.Dispose() }"
    ]

  t05-if-run-ok : List ShellCmd =
    [ ScRaw "if ((-not (Test-Path -PathType Leaf $t.Raw)) -or (Get-Item $t.Raw).Length -eq 0) {"
    , ScIndent [ScRaw "$RunOk = $false; $Why = 'no output'"]
    , ScRaw "} else {"
    , ScIndent t05-block-2
    , ScRaw "}"
    ]

  t05-block-2 : List ShellCmd =
    [ ScRaw "$raw = (Read-LogShared $t.Raw) -replace \"`r\", ''"
    , ScRaw "$kept = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "foreach ($l in ($raw -split \"`n\")) {"
    , ScIndent t05-l-split
    , ScRaw "}"
    , ScRaw "while ($kept.Count -gt 0 -and $kept[$kept.Count - 1] -eq '') { $kept.RemoveAt($kept.Count - 1) }"
    , ScRaw "$txt = if ($kept.Count -gt 0) { ($kept -join \"`n\") + \"`n\" } else { '' }"
    ]

  t05-l-split : List ShellCmd =
    [ ScRaw "if ($l.StartsWith('HEAP:') -or $l.StartsWith('WD:') -or $l.StartsWith('STACK:')) { continue }"
    , ScRaw "[void]$kept.Add($l)"
    ]

  t05-t-key-fatal : List ShellCmd =
    [ ScRaw "if ($txt -match '!EXC=([0-9A-Fa-f]{1,2})') {"
    , ScIndent t05-txt
    , ScRaw "} elseif ((-not $RunOk) -or $txt -eq '') {"
    , ScIndent t05-not-run-ok-txt
    , ScRaw "} else {"
    , ScIndent t05-block-4
    , ScRaw "}"
    , ScRaw "return"
    ]

  t05-txt : List ShellCmd =
    [ ScRaw "$got = $matches[1].ToUpper()"
    , ScIf (SeBare (SeAnd (SeProperty (SeVar "t") "ExpectExc") (SeStringNeq (SeVar "got") (SeProperty (SeVar "t") "ExpectExc")))) t05-t-expect-exc-got t05-block-3
    ]

  t05-t-expect-exc-got : List ShellCmd =
    [ ScRaw "\"FAIL_FATAL_EXC`t$name`tfaulted with EXC=$got, expected EXC=$($t.ExpectExc)\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-block-3 : List ShellCmd =
    [ ScRaw "\"PASS_FATAL`t$name`tEXC=$got\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-not-run-ok-txt : List ShellCmd =
    [ ScComment "No output at all is not survival and must not be read as"
    , ScComment "one: it is a hang, a wall-budget kill, or a VM that died"
    , ScComment "without printing. Say so rather than guessing."
    , ScRaw "\"FAIL_RUNTIME`t$name`tno output, so the fault could not be observed\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-block-4 : List ShellCmd =
    [ ScComment "THE CASE THIS TIER EXISTS FOR. The program ran to"
    , ScComment "completion where it was supposed to die, which is what a"
    , ScComment "bounds check that stopped firing looks like."
    , ScRaw "\"FAIL_FATAL_SURVIVED`t$name`tran to completion without faulting\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-if-not-run-ok : List ShellCmd =
    [ ScRaw "\"FAIL_RUNTIME`t$name`t$Why\" | Set-Content -Path $resultFile -Encoding UTF8"
    , ScRaw "return"
    ]

  t05-string-equals-expected-bytes : List ShellCmd =
    [ ScRaw "\"PASS_EXPECTED`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-block-5 : List ShellCmd =
    [ ScRaw "\"FAIL_OUTPUT`t$name`t\" | Set-Content -Path $resultFile -Encoding UTF8"
    ]

  t05-env-codex-vm-host : List ShellCmd =
    [ ScRaw "$runWorker = {"
    , ScIndent t05-run-worker
    , ScRaw "}"
    , ScRaw "$needsRun | ForEach-Object -Parallel $runWorker -ThrottleLimit $Jobs"
    , ScRaw "foreach ($t in $needsRun) { Write-RunVerdict $t $t.RunOk $t.Why }"
    ]

  t05-run-worker : List ShellCmd =
    [ ScAssign "t" (SeVar "_")
    , ScRaw "$runScript = Join-Path $using:PSScriptRoot 'test-run.ps1'"
    , ScRaw "$out = Join-Path $using:OutRoot $t.Name"
    , ScRaw "$t.Raw = Join-Path $out 'runtime.raw'"
    , ScRaw "$runArgs = @('-NoProfile', '-File', $runScript, '-Kernel', $t.Bin, '-OutFile', $t.Raw)"
    , ScRaw "if (Test-Path -PathType Leaf $t.Stdin)  { $runArgs += @('-StdinFile', $t.Stdin) }"
    , ScRaw "if (Test-Path -PathType Leaf $t.Keys)   { $runArgs += @('-KeysFile', $t.Keys) }"
    , ScRaw "if (Test-Path -PathType Leaf $t.Disk)   { $runArgs += @('-DiskFile', $t.Disk) }"
    , ScRaw "if (Test-Path -PathType Leaf $t.Disk2)  { $runArgs += @('-Disk2File', $t.Disk2) }"
    , ScRaw "if ($t.Smp -gt 1)                       { $runArgs += @('-Smp', $t.Smp) }"
    , ScRaw "if (Test-Path -PathType Leaf $t.VmArgs) { $runArgs += @('-VmArgsFile', $t.VmArgs) }"
    , ScRaw "$runSw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScRaw "& pwsh @runArgs"
    , ScRaw "$runSw.Stop()"
    , ScRaw "\"$($runSw.ElapsedMilliseconds)\" | Set-Content -Path (Join-Path $out '.run-ms') -Encoding UTF8"
    , ScRaw "$t.RunOk = ($LASTEXITCODE -eq 0)"
    , ScRaw "$t.Why = 'run failed'"
    ]

  t05-block-6 : List ShellCmd =
    [ ScAssign "runDir" (SeBare (SePathJoinN [SeVar "OutRoot", SeLit "_runs"]))
    , ScRaw "if (Test-Path $runDir) { Remove-Item -Recurse -Force $runDir }"
    , ScRaw "New-Item -ItemType Directory -Force -Path $runDir | Out-Null"
    , ScBlank
    , ScComment "Dealt by the last run's .run-ms, heaviest first onto the lightest"
    , ScComment "slot, the rule phase 1 uses for .src-bytes: a test with no reading"
    , ScComment "goes to the slot with the fewest members. The few multi-second"
    , ScComment "network tests are what this balances; the rest run in ~80 ms."
    , ScRaw "$runWeight = @{}"
    , ScRaw "$runIndex = @{}"
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "needsRun") "Count"))) (SePostIncrement "i") t05-i-needs-run-count
    , ScRaw "$slotLoad = New-Object 'long[]' $Jobs"
    , ScRaw "$slotCount = New-Object 'int[]' $Jobs"
    , ScRaw "$slotMembers = @{}"
    , ScRaw "for ($s = 0; $s -le $Jobs; $s++) { $slotMembers[$s] = [System.Collections.Generic.List[hashtable]]::new() }"
    , ScRaw "$byRun = @($needsRun | Sort-Object @{ Expression = { $runWeight[$_.Name] }; Descending = $true }, @{ Expression = { $runIndex[$_.Name] }; Descending = $false })"
    , ScComment "A .wall subject (COMPILER-123) goes to the extra slot $Jobs, one guest"
    , ScComment "at a time, whose supervisor gets the largest budget, as bvt.ps1 does."
    , ScAssign "longWall" (SeInt 0)
    , ScForEach "t" (SeVar "byRun") t05-each-by-run
    , ScBlank
    , ScComment "Every token double-quoted: that is what -run-list's splitter takes,"
    , ScComment "and it is what keeps a path with a space in one piece."
    , ScRaw "function Format-RunLine([string[]]$Tokens) { return ($Tokens | ForEach-Object { '\"' + $_ + '\"' }) -join ' ' }"
    , ScBlank
    , ScComment "The sidecar preparation test-run.ps1 did stays with the caller: a"
    , ScComment "depot .disk is read-only after sync and codex-vm flushes writes"
    , ScComment "durably, so each image is copied to a writable temp for its run."
    , ScRaw "$tempFiles = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$slotLists = @{}"
    , ScRaw "$slotErrs = @{}"
    , ScForLoop "s" (SeInt 0) (SeBare (SeIntLe (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t05-s-jobs-3
    , ScBlank
    , ScRaw "$vmBin = Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'"
    , ScRaw "$supervisors = @{}"
    , ScForLoop "s" (SeInt 0) (SeBare (SeIntLe (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t05-s-jobs-4
    , ScRaw "foreach ($s in $supervisors.Keys) { $supervisors[$s].WaitForExit() }"
    , ScBlank
    , ScComment "One END line per list line, attributed by its [i/N] index rather"
    , ScComment "than by position, so a line the supervisor could not even report"
    , ScComment "reads as NOEND on its own test and shifts nothing onto a neighbour."
    , ScForEach "s" (SeProperty (SeVar "slotMembers") "Keys") t05-s-slot-members-keys
    , ScRaw "foreach ($f in $tempFiles) { Remove-Item -Force $f -ErrorAction SilentlyContinue }"
    ]

  t05-i-needs-run-count : List ShellCmd =
    [ ScRaw "$t = $needsRun[$i]"
    , ScRaw "$runIndex[$t.Name] = $i"
    , ScRaw "$w = 0L"
    , ScRaw "$rmF = Join-Path (Join-Path $OutRoot $t.Name) '.run-ms'"
    , ScIf (SeBare (SeFileExists (SeVar "rmF"))) t05-if-test-type-rm-f []
    , ScRaw "$runWeight[$t.Name] = $w"
    ]

  t05-if-test-type-rm-f : List ShellCmd =
    [ ScRaw "$rmText = (Get-Content -TotalCount 1 $rmF -ErrorAction SilentlyContinue)"
    , ScRaw "if ($rmText -and ($rmText.Trim() -match '^\\d+$')) { $w = [long]$rmText.Trim() }"
    ]

  t05-each-by-run : List ShellCmd =
    [ ScIf (SeBare (SeFileExists (SeProperty (SeVar "t") "Wall"))) t05-test-type-t-wall []
    , ScComment "A -gpu-files subject reads a multi-GB checkpoint off the model disk and misses its budget beside"
    , ScComment "another such read (Update 71: 35.3 s alone cold, 5.4 s two at once warm), so it joins slot $Jobs too."
    , ScRaw "if ((Test-Path -PathType Leaf $t.VmArgs) -and @(Get-Content -LiteralPath $t.VmArgs | Where-Object { $_.TrimStart().StartsWith('-gpu-files') }).Count -gt 0) {"
    , ScIndent [ScRaw "$slotMembers[$Jobs].Add($t)", ScContinue]
    , ScRaw "}"
    , ScAssign "k" (SeInt 0)
    , ScIf (SeBare (SeIntGt (SeIndex (SeVar "runWeight") (SeProperty (SeVar "t") "Name")) ((SeInt 0)))) t05-run-weight-t-name t05-block-7
    , ScRaw "$slotMembers[$k].Add($t)"
    , ScRaw "$slotLoad[$k] += $runWeight[$t.Name]"
    , ScRaw "$slotCount[$k] += 1"
    ]

  t05-test-type-t-wall : List ShellCmd =
    [ ScAssign "wallSec" (SeInt 0)
    , ScRaw "$wallText = (Get-Content -TotalCount 1 $t.Wall).Trim()"
    , ScRaw "if (-not [int]::TryParse($wallText, [ref]$wallSec) -or $wallSec -le 60 -or $wallSec -gt 600) {"
    , ScIndent t05-not-int-parse-wall
    , ScRaw "}"
    , ScRaw "$slotMembers[$Jobs].Add($t)"
    , ScIfLine (SeBare (SeIntGt (SeVar "wallSec") (SeVar "longWall"))) [ScAssign "longWall" (SeVar "wallSec")] []
    , ScContinue
    ]

  t05-not-int-parse-wall : List ShellCmd =
    [ ScRaw "throw \"$($t.Wall) must hold whole seconds above 60 and at most 600 on its first line, not '$wallText'\""
    ]

  t05-run-weight-t-name : List ShellCmd =
    [ ScForLoop "s" (SeInt 1) (SeBare (SeIntLt (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t05-s-jobs
    ]

  t05-s-jobs : List ShellCmd =
    [ ScRaw "if ($slotLoad[$s] -lt $slotLoad[$k] -or ($slotLoad[$s] -eq $slotLoad[$k] -and $slotCount[$s] -lt $slotCount[$k])) { $k = $s }"
    ]

  t05-block-7 : List ShellCmd =
    [ ScForLoop "s" (SeInt 1) (SeBare (SeIntLt (SeVar "s") (SeVar "Jobs"))) (SePostIncrement "s") t05-s-jobs-2
    ]

  t05-s-jobs-2 : List ShellCmd =
    [ ScRaw "if ($slotCount[$s] -lt $slotCount[$k] -or ($slotCount[$s] -eq $slotCount[$k] -and $slotLoad[$s] -lt $slotLoad[$k])) { $k = $s }"
    ]

  t05-s-jobs-3 : List ShellCmd =
    [ ScRaw "$lines = [System.Collections.Generic.List[string]]::new()"
    , ScForEach "t" (SeIndex (SeVar "slotMembers") (SeVar "s")) t05-t-slot-members-s
    , ScRaw "$slotLists[$s] = Join-Path $runDir \"run-$s.txt\""
    , ScComment "The supervisor's stderr is captured on the SYSTEM temp and moved"
    , ScComment "into _runs afterwards. Measured 2026-08-22: the same eight"
    , ScComment "supervisors took 2.6 s with the redirect file on C: and 12.3 to"
    , ScComment "12.7 s with it anywhere on D:, repo or not; a redirect is one"
    , ScComment "write per stderr line and D: pays ~7.5 ms for each. test-run.ps1"
    , ScComment "and the batch compiler only ever escaped this because"
    , ScComment "GetTempFileName() lands on C:."
    , ScRaw "$slotErrs[$s] = [System.IO.Path]::GetTempFileName()"
    , ScRaw "[System.IO.File]::WriteAllLines($slotLists[$s], $lines, [System.Text.UTF8Encoding]::new($false))"
    ]

  t05-t-slot-members-s : List ShellCmd =
    [ ScRaw "$out = Join-Path $OutRoot $t.Name"
    , ScRaw "$t.Raw = Join-Path $out 'runtime.raw'"
    , ScRaw "if (Test-Path $t.Raw) { Remove-Item -Force $t.Raw }"
    , ScRaw "$tokens = @('-kernel', $t.Bin, '-output', $t.Raw, '-mem', '3072', '-headless')"
    , ScRaw "if (Test-Path -PathType Leaf $t.Stdin) { $tokens += @('-input', $t.Stdin) }"
    , ScRaw "if (Test-Path -PathType Leaf $t.Keys)  { $tokens += @('-keys-file', $t.Keys) }"
    , ScIf (SeBare (SeFileExists (SeProperty (SeVar "t") "Disk"))) t05-test-type-t-disk []
    , ScIf (SeBare (SeFileExists (SeProperty (SeVar "t") "Disk2"))) t05-test-type-t-disk2 []
    , ScRaw "if ($t.Smp -gt 1) { $tokens += @('-smp', \"$($t.Smp)\") }"
    , ScIf (SeBare (SeFileExists (SeProperty (SeVar "t") "VmArgs"))) t05-test-type-t-vm-2 []
    , ScRaw "[void]$lines.Add((Format-RunLine $tokens))"
    ]

  t05-test-type-t-disk : List ShellCmd =
    [ ScTempFile "diskWork"
    , ScRaw "$tempFiles.Add($diskWork)"
    , ScRaw "[System.IO.File]::WriteAllBytes($diskWork, [System.IO.File]::ReadAllBytes($t.Disk))"
    , ScRaw "$tokens += @('-disk', $diskWork)"
    ]

  t05-test-type-t-disk2 : List ShellCmd =
    [ ScTempFile "disk2Work"
    , ScRaw "$tempFiles.Add($disk2Work)"
    , ScRaw "[System.IO.File]::WriteAllBytes($disk2Work, [System.IO.File]::ReadAllBytes($t.Disk2))"
    , ScRaw "$tokens += @('-disk2', $disk2Work)"
    ]

  t05-test-type-t-vm-2 : List ShellCmd =
    [ ScRaw "foreach ($line in (Get-Content $t.VmArgs)) {"
    , ScIndent t05-line-get-content-t
    , ScRaw "}"
    ]

  t05-line-get-content-t : List ShellCmd =
    [ ScRaw "$line = $line.Trim()"
    , ScRaw "if (-not $line -or $line.StartsWith('#')) { continue }"
    , ScRaw "$tokens += ($line -split '\\s+')"
    ]

  t05-s-jobs-4 : List ShellCmd =
    [ ScRaw "if ($slotMembers[$s].Count -eq 0) { continue }"
    , ScRaw "$listArgs = @('-run-list', $slotLists[$s])"
    , ScRaw "if ($s -eq $Jobs -and $longWall -gt 0) { $listArgs += @('-run-list-wall', \"$($longWall * 1000)\") }"
    , ScRaw "$sa = @{ FilePath = $vmBin; ArgumentList = $listArgs; PassThru = $true; RedirectStandardError = $slotErrs[$s] }"
    , ScRaw "if ($IsWindows) { $sa.WindowStyle = 'Hidden' }"
    , ScRaw "$supervisors[$s] = Start-Process @sa"
    ]

  t05-s-slot-members-keys : List ShellCmd =
    [ ScRaw "$members = $slotMembers[$s]"
    , ScIfLine (SeBare (SeIntEq (SeProperty (SeVar "members") "Count") ((SeInt 0)))) [ScContinue] []
    , ScRaw "$endOf = @{}"
    , ScRaw "$errText = if (Test-Path -PathType Leaf $slotErrs[$s]) { Read-LogShared $slotErrs[$s] } else { '' }"
    , ScRaw "if (Test-Path -PathType Leaf $slotErrs[$s]) { Move-Item -Force $slotErrs[$s] (Join-Path $runDir \"run-$s.err\") }"
    , ScRaw "foreach ($l in ($errText -split \"`n\")) {"
    , ScIndent t05-l-err-text-split
    , ScRaw "}"
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "members") "Count"))) (SePostIncrement "i") t05-i-members-count
    ]

  t05-l-err-text-split : List ShellCmd =
    [ ScIf (SeBare (SeMatch (SeVar "l") "RUN-LIST END \\[(\\d+)/\\d+\\] .* exit=(\\S+) output=(-?\\d+) dropped=(\\d+) ms=(\\d+)")) t05-if-l []
    ]

  t05-if-l : List ShellCmd =
    [ ScRaw "$endOf[[int]$matches[1]] = @{ Exit = $matches[2]; Dropped = [long]$matches[4]; Ms = $matches[5] }"
    ]

  t05-i-members-count : List ShellCmd =
    [ ScRaw "$t = $members[$i]"
    , ScRaw "$out = Join-Path $OutRoot $t.Name"
    , ScAssign "runOk" (SeVar "true")
    , ScAssign "why" (SeLit "")
    , ScRaw "if (-not $endOf.ContainsKey($i + 1)) {"
    , ScIndent t05-not-end-of-key
    , ScRaw "} else {"
    , ScIndent t05-block-8
    , ScRaw "}"
    , ScRaw "Write-RunVerdict $t $runOk $why"
    ]

  t05-not-end-of-key : List ShellCmd =
    [ ScRaw "$runOk = $false; $why = 'the -run-list supervisor reported no END line for this test'"
    ]

  t05-block-8 : List ShellCmd =
    [ ScRaw "$e = $endOf[$i + 1]"
    , ScRaw "\"$($e.Ms)\" | Set-Content -Path (Join-Path $out '.run-ms') -Encoding UTF8"
    , ScRaw "if ($e.Exit -eq 'TIMEOUT') { $runOk = $false; $why = 'wall budget exceeded' }"
    , ScRaw "elseif ($e.Exit -eq 'SPAWNFAIL') { $runOk = $false; $why = 'codex-vm could not be spawned for this test' }"
    , ScRaw "elseif ($e.Dropped -gt 0) { $runOk = $false; $why = \"codex-vm dropped $($e.Dropped) guest serial bytes: the capture is SHORT and any comparison against it is meaningless\" }"
    ]

Section: T06 -- Oracles, Aggregate, Rollup and Exit

  t06-body : List ShellCmd =
    [ ScBlank
    , ScComment "==========================================================================="
    , ScComment "Oracles tier: the author-owned differential collections, invoked and"
    , ScComment "reported here, never gated. reek owns oracle-scalar, blu owns"
    , ScComment "oracle-vector; this harness only runs them and carries their verdicts"
    , ScComment "into the rollup and the exit code."
    , ScComment "==========================================================================="
    , ScAssign "oracleResults" (SeArrayLiteral [])
    , ScRaw "if ($tiers.Contains('oracles')) {"
    , ScIndent t06-tiers
    , ScRaw "}"
    , ScBlank
    , ScComment "==========================================================================="
    , ScComment "Aggregate results"
    , ScComment "==========================================================================="
    , ScRaw "$buckets = @{"
    , ScIndent t06-buckets
    , ScRaw "}"
    , ScAssign "statusOf" (SeHashLiteral)
    , ScRaw "foreach ($f in Get-ChildItem -File $ResultsDir) {"
    , ScIndent t06-f-get-child-item
    , ScRaw "}"
    , ScBlank
    , ScComment "Census instrumentation: one row per test with whatever timings exist."
    , ScComment "Compile time inside a batch is not observable per test (the VM output file"
    , ScComment "flushes on exit), so src-bytes stands in as the compile-cost proxy; run-ms"
    , ScComment "is exact. Batch wall times are in the sweep log (batch-done ... wallms=)."
    , ScAssign "timingsFile" (SeBare (SePathJoinN [SeVar "ResultsDir", SeLit "_timings.tsv"]))
    , ScRaw "$timingRows = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$timingRows.Add(\"name`tstatus`tsrc_bytes`trun_ms\")"
    , ScRaw "foreach ($f in Get-ChildItem -File $ResultsDir) {"
    , ScIndent t06-f-get-child-item-2
    , ScRaw "}"
    , ScRaw "[System.IO.File]::WriteAllLines($timingsFile, $timingRows, [System.Text.UTF8Encoding]::new($false))"
    , ScAssign "phaseSummary" (SeText "phase1_compile_s=$([int]($phase1Sw.ElapsedMilliseconds/1000)) retry_s=$([int]($retrySw.ElapsedMilliseconds/1000))")
    , ScRaw "if ($null -ne $phase2Sw) { $phaseSummary += \" phase2_run_s=$([int]($phase2Sw.ElapsedMilliseconds/1000))\" }"
    , ScEcho (SeVar "phaseSummary")
    , ScRaw "Add-Content -Path $timingsFile -Value \"# $phaseSummary\""
    , ScBlank
    , ScRaw "$total = ($buckets.Values | ForEach-Object { $_.Count } | Measure-Object -Sum).Sum"
    , ScRaw "$passed = $buckets.PASS_EXPECTED.Count + $buckets.PASS_FAILING.Count + $buckets.PASS_UNVERIFIED.Count `"
    , ScRaw "        + $buckets.PASS_DIAG.Count + $buckets.PASS_FATAL.Count"
    , ScRaw "$unexpected = $buckets.FAIL_COMPILE.Count + $buckets.FAIL_EXPECTED_BUT_COMPILED.Count `"
    , ScRaw "            + $buckets.FAIL_WRONG_DIAGNOSTIC.Count + $buckets.FAIL_OUTPUT.Count + $buckets.FAIL_RUNTIME.Count `"
    , ScRaw "            + $buckets.FAIL_MISSING_DIAGNOSTIC.Count + $buckets.FAIL_DISK_SOURCE.Count `"
    , ScRaw "            + $buckets.FAIL_FATAL_SURVIVED.Count + $buckets.FAIL_FATAL_EXC.Count"
    , ScBlank
    , ScEcho (SeText "total=$total  pass=$passed  fail=$unexpected  skip=$($buckets.SKIPPED.Count)")
    , ScBlank
    , ScComment "==========================================================================="
    , ScComment "Rollup and run-over-run delta. The rollup is one file a reader can act on"
    , ScComment "without excavating 600 lines; the delta makes a regression read as a diff."
    , ScComment "test-output\\last-run.json survives across runs (only _results is wiped)."
    , ScComment "==========================================================================="
    , ScAssign "expectedOwners" (SeVar "null")
    , ScFunctionBlock "Get-FailHint" t06-get-fail-hint
    , ScBlank
    , ScRaw "$seedStamp = if (Test-Path 'build-output\\bare-metal\\Codex.cdx') { (Get-FileHash -Algorithm SHA256 'build-output\\bare-metal\\Codex.cdx').Hash.Substring(0, 16) } else { 'unknown' }"
    , ScRaw "$tierLabel = (@($tiers) | Sort-Object) -join ','"
    , ScRaw "$runStamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'"
    , ScBlank
    , ScAssign "prevFile" (SeBare (SePathJoinN [SeVar "OutRoot", SeLit "last-run.json"]))
    , ScAssign "prev" (SeHashLiteral)
    , ScAssign "prevStamp" (SeLit "")
    , ScAssign "prevTiers" (SeLit "")
    , ScIf (SeBare (SeFileExists (SeVar "prevFile"))) t06-if-test-type-prev-file []
    , ScBlank
    , ScRaw "$newlyRed = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$fixedNow = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$addedRed = [System.Collections.Generic.List[string]]::new()"
    , ScAssign "addedCount" (SeInt 0)
    , ScForEach "n" (SeProperty (SeVar "statusOf") "Keys") t06-n-status-of-keys
    , ScComment "Removed means DELETED FROM THE TREE, not merely outside this run's tiers:"
    , ScComment "a lib-only run must not report the whole apps tier as gone."
    , ScRaw "$existingNames = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)"
    , ScForEach "d" (SeVar "allDirs") t06-each-all-dirs
    , ScRaw "$removed = [System.Collections.Generic.List[string]]::new()"
    , ScForEach "n" (SeProperty (SeVar "prev") "Keys") t06-n-prev-keys
    , ScBlank
    , ScRaw "$roll = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$roll.Add(\"battery rollup  $runStamp  stage0=$seedStamp  tiers=$tierLabel\")"
    , ScRaw "$roll.Add(\"total=$total  pass=$passed  fail=$unexpected  skip=$($buckets.SKIPPED.Count)\")"
    , ScRaw "$roll.Add('')"
    , ScRaw "$roll.Add(\"category      pass  fail  skip\")"
    , ScAssign "catStats" (SeHashLiteral)
    , ScForEach "n" (SeProperty (SeVar "statusOf") "Keys") t06-n-status-of-keys-2
    , ScRaw "foreach ($c in ($catStats.Keys | Sort-Object)) {"
    , ScIndent t06-c-cat-stats-keys
    , ScRaw "}"
    , ScRaw "$roll.Add('')"
    , ScRaw "$roll.Add('slowest 10 (run phase, ms):')"
    , ScComment "Not $slow: that is the [switch]$Slow parameter, and PowerShell variable"
    , ScComment "names are case-insensitive."
    , ScRaw "$slowRows = [System.Collections.Generic.List[object]]::new()"
    , ScForEach "n" (SeProperty (SeVar "statusOf") "Keys") t06-n-status-of-keys-3
    , ScRaw "foreach ($s in ($slowRows | Sort-Object -Property Ms -Descending | Select-Object -First 10)) {"
    , ScIndent [ScRaw "$roll.Add((\"  {0,7}  {1}\" -f $s.Ms, $s.Name))"]
    , ScRaw "}"
    , ScRaw "$failNames = @($statusOf.Keys | Where-Object { $statusOf[$_] -like 'FAIL_*' } | Sort-Object)"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "failNames") "Count") ((SeInt 0)))) t06-fail-names-count []
    , ScForEach "or" (SeVar "oracleResults") t06-each-oracle-results
    , ScRaw "$roll.Add('')"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "prev") "Count") ((SeInt 0)))) t06-prev-count t06-block-3
    , ScRaw "[System.IO.File]::WriteAllLines((Join-Path $ResultsDir '_rollup.txt'), $roll, [System.Text.UTF8Encoding]::new($false))"
    , ScRaw "foreach ($l in ($roll | Select-Object -Skip ($roll.Count - [Math]::Min(6, $roll.Count)))) { Write-Host $l }"
    , ScBlank
    , ScComment "Persist this run for the next delta. A tier subset only re-records the"
    , ScComment "tests it ran; statuses from other tiers carry forward untouched, and only"
    , ScComment "a test deleted from the tree drops out of the carried state."
    , ScAssign "carried" (SeHashLiteral)
    , ScRaw "foreach ($k in $prev.Keys) { if ($existingNames.Contains($k)) { $carried[$k] = $prev[$k] } }"
    , ScRaw "foreach ($k in $statusOf.Keys) { $carried[$k] = $statusOf[$k] }"
    , ScRaw "@{ stamp = $runStamp; stage0 = $seedStamp; tiers = $tierLabel; status = $carried } |"
    , ScRaw "    ConvertTo-Json -Depth 4 | Set-Content -Path $prevFile -Encoding UTF8"
    , ScBlank
    , ScRaw "$oracleFails = @($oracleResults | Where-Object { -not $_.Ok }).Count"
    , ScIf (SeBare (SeOr (SeBare (SeIntGt (SeVar "unexpected") ((SeInt 0)))) (SeBare (SeIntGt (SeVar "oracleFails") ((SeInt 0)))))) t06-unexpected-oracle-fails []
    , ScRaw "Restore-Kernel"
    , ScExit (SeInt 0)
    ]

  t06-tiers : List ShellCmd =
    [ ScRaw "$stage0Path = Join-Path (Resolve-Path .).Path 'build-output\\bare-metal\\Codex.cdx'"
    , ScRaw "foreach ($o in 'oracle-scalar', 'oracle-vector', 'oracle-cce') {"
    , ScIndent t06-o
    , ScRaw "}"
    ]

  t06-o : List ShellCmd =
    [ ScAssign "oscript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeText "$o.ps1"]))
    , ScIf (SeBare (SeNot (SeFileExists (SeVar "oscript")))) t06-if-not-test-type-oscript []
    , ScEcho (SeText "Oracle: $o...")
    , ScRaw "$osw = [System.Diagnostics.Stopwatch]::StartNew()"
    , ScAssign "olog" (SeBare (SePathJoinN [SeVar "OutRoot", SeText "_oracle-$o.log"]))
    , ScRaw "& pwsh -NoProfile -File $oscript -Kernel $stage0Path *> $olog"
    , ScRaw "$osw.Stop()"
    , ScRaw "$ok = ($LASTEXITCODE -eq 0)"
    , ScRaw "$tail = @(Get-Content $olog -Tail 1 -ErrorAction SilentlyContinue) -join ''"
    , ScRaw "$oracleResults += [pscustomobject]@{ Name = $o; Ok = $ok; Seconds = [int]($osw.ElapsedMilliseconds / 1000); Note = $tail }"
    , ScEcho (SeText "  $o : $(if ($ok) { 'PASS' } else { 'FAIL' }) ($([int]($osw.ElapsedMilliseconds / 1000))s)  $tail")
    ]

  t06-if-not-test-type-oscript : List ShellCmd =
    [ ScRaw "$oracleResults += [pscustomobject]@{ Name = $o; Ok = $false; Seconds = 0; Note = 'script missing' }"
    , ScContinue
    ]

  t06-buckets : List ShellCmd =
    [ ScRaw "PASS_EXPECTED = @(); PASS_UNVERIFIED = @(); PASS_FAILING = @(); PASS_DIAG = @(); PASS_FATAL = @()"
    , ScRaw "SKIPPED = @(); FAIL_COMPILE = @(); FAIL_RUNTIME = @()"
    , ScRaw "FAIL_OUTPUT = @(); FAIL_EXPECTED_BUT_COMPILED = @(); FAIL_WRONG_DIAGNOSTIC = @(); FAIL_MISSING_DIAGNOSTIC = @()"
    , ScRaw "FAIL_DISK_SOURCE = @(); FAIL_FATAL_SURVIVED = @(); FAIL_FATAL_EXC = @()"
    ]

  t06-f-get-child-item : List ShellCmd =
    [ ScRaw "if ($f.Name -like '_*') { continue }"
    , ScRaw "$line = Get-Content -TotalCount 1 $f.FullName"
    , ScIfLine (SeBare (SeNot (SeVar "line"))) [ScContinue] []
    , ScRaw "$parts = $line -split \"`t\", 3"
    , ScRaw "$status = $parts[0]; $name = $parts[1]; $detail = if ($parts.Count -ge 3) { $parts[2] } else { '' }"
    , ScRaw "$statusOf[$name] = $status"
    , ScRaw "if (-not $buckets.ContainsKey($status)) {"
    , ScIndent t06-not-buckets-key-status
    , ScRaw "}"
    , ScRaw "if ($status -in 'SKIPPED','FAIL_RUNTIME','FAIL_DISK_SOURCE','PASS_FATAL','FAIL_FATAL_SURVIVED','FAIL_FATAL_EXC') {"
    , ScIndent [ScRaw "$buckets[$status] += \"$name`: $detail\""]
    , ScRaw "} else {"
    , ScIndent [ScRaw "$buckets[$status] += $name"]
    , ScRaw "}"
    ]

  t06-not-buckets-key-status : List ShellCmd =
    [ ScRaw "Write-Host \"unknown result status '$status' for $name\" -ForegroundColor Yellow"
    , ScContinue
    ]

  t06-f-get-child-item-2 : List ShellCmd =
    [ ScRaw "if ($f.Name -like '_*') { continue }"
    , ScRaw "$line = Get-Content -TotalCount 1 $f.FullName"
    , ScRaw "if (-not $line) { continue }"
    , ScRaw "$p = $line -split \"`t\", 3"
    , ScRaw "$out = Join-Path $OutRoot $f.Name"
    , ScRaw "$sb = ''; $rm = ''"
    , ScRaw "$sbF = Join-Path $out '.src-bytes'; if (Test-Path $sbF) { $sb = (Get-Content -TotalCount 1 $sbF).Trim() }"
    , ScRaw "$rmF = Join-Path $out '.run-ms';    if (Test-Path $rmF) { $rm = (Get-Content -TotalCount 1 $rmF).Trim() }"
    , ScRaw "$timingRows.Add(\"$($f.Name)`t$($p[0])`t$sb`t$rm\")"
    ]

  t06-get-fail-hint : List ShellCmd =
    [ ScRaw "param([string]$Name, [string]$Status)"
    , ScAssign "out" (SeBare (SePathJoinN [SeVar "OutRoot", SeVar "Name"]))
    , ScIf (SeBare (SeIntEq (SeVar "Status") (SeLit "FAIL_OUTPUT"))) t06-if-status []
    , ScRaw "if ($Status -in 'FAIL_COMPILE', 'FAIL_WRONG_DIAGNOSTIC', 'FAIL_EXPECTED_BUT_COMPILED', 'FAIL_MISSING_DIAGNOSTIC') {"
    , ScIndent t06-status-2
    , ScRaw "}"
    , ScReturn (SeLit "")
    ]

  t06-if-status : List ShellCmd =
    [ ScRaw "$dir = $srcDirOf[$Name]"
    , ScIfLine (SeBare (SeNot (SeVar "dir"))) [ScReturn (SeLit "")] []
    , ScComment "LENGTH BEFORE CONTENT (L-SHORT). A truncated artifact and a wrong one"
    , ScComment "are the same colour on a verdict line, and the line walk below reports"
    , ScComment "the first differing line either way -- which reads as codegen. Seven"
    , ScComment "poison subjects went red at Update 48 with ideas-test holding 204 bytes"
    , ScComment "of a 2,199-byte output and the compiler byte-identical; a re-run cleared"
    , ScComment "all seven. The normalisation is the SAME one the FAIL_OUTPUT verdict was"
    , ScComment "decided with (CR stripped from expected only), so this cannot disagree"
    , ScComment "with it -- comparing raw file bytes here would report SHORT for every"
    , ScComment "CRLF/LF pair and be worse than the gap it closes."
    , ScComment "Read-LogShared is defined INSIDE $runWorker and is not in scope here,"
    , ScComment "so this reads the two files directly. Same text either way: the worker"
    , ScComment "only needs the sharing retry because it reads while other jobs write."
    , ScComment ""
    , ScComment "A bare length difference does NOT prove truncation -- most ordinary"
    , ScComment "wrong-output reds differ in length too, so reporting every one of them"
    , ScComment "as SHORT would train the reader to ignore the word. A STRICT PREFIX"
    , ScComment "does prove it: that is what a capture cut off mid-stream looks like and"
    , ScComment "a miscompile has no reason to produce it. The two are reported as"
    , ScComment "different claims, and the same-length case says nothing at all and"
    , ScComment "falls through to the line walk untouched."
    , ScAssign "efile" (SeBare (SePathJoinN [SeVar "dir", SeText "$Name.expected"]))
    , ScAssign "afile" (SeBare (SePathJoinN [SeVar "out", SeLit "runtime.actual"]))
    , ScRaw "$etxt = if (Test-Path -PathType Leaf $efile) { ([System.IO.File]::ReadAllText($efile)) -replace \"`r\", '' } else { '' }"
    , ScRaw "$atxt = if (Test-Path -PathType Leaf $afile) { [System.IO.File]::ReadAllText($afile) } else { '' }"
    , ScComment "MISATTRIBUTION BEFORE LENGTH. An actual that is byte-for-byte"
    , ScComment "ANOTHER test's expected is not a wrong answer but a misfiled one:"
    , ScComment "the batch stream lost a block and every later block ran under the"
    , ScComment "wrong name (ExaminersAssay \"The batch stream can lose bytes\"; 26"
    , ScComment "such reds at the Update 52 battery read as codegen for an evening)."
    , ScComment "A foreign output usually differs in length too, so the length"
    , ScComment "claims below would bury this one. The owner map is built once, on"
    , ScComment "the first FAIL_OUTPUT hint; a green run never pays for it."
    , ScIf (SeBare (SeIntEq (SeVar "null") (SeVar "script:expectedOwners"))) t06-script-expected-owners []
    , ScRaw "if ($atxt -and $script:expectedOwners.ContainsKey($atxt)) {"
    , ScIndent t06-atxt-script-expected-owners
    , ScRaw "}"
    , ScIf (SeBare (SeStringNeq (SeProperty (SeVar "etxt") "Length") (SeProperty (SeVar "atxt") "Length"))) t06-etxt-length-atxt []
    , ScRaw "$e = @(@(Get-Content (Join-Path $dir \"$Name.expected\") -ErrorAction SilentlyContinue) -replace \"`r\", '')"
    , ScRaw "$a = @(Get-Content (Join-Path $out 'runtime.actual') -ErrorAction SilentlyContinue)"
    , ScRaw "$n = [Math]::Max($e.Count, $a.Count)"
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeVar "n"))) (SePostIncrement "i") t06-i-n
    , ScReturn (SeLit "")
    ]

  t06-script-expected-owners : List ShellCmd =
    [ ScRaw "$script:expectedOwners = @{}"
    , ScForEach "n2" (SeProperty (SeVar "srcDirOf") "Keys") t06-n2-src-dir-of
    ]

  t06-n2-src-dir-of : List ShellCmd =
    [ ScRaw "$ef2 = Join-Path $srcDirOf[$n2] \"$n2.expected\""
    , ScIf (SeBare (SeFileExists (SeVar "ef2"))) t06-if-test-type-ef2 []
    ]

  t06-if-test-type-ef2 : List ShellCmd =
    [ ScRaw "$k2 = ([System.IO.File]::ReadAllText($ef2)) -replace \"`r\", ''"
    , ScRaw "if (-not $script:expectedOwners.ContainsKey($k2)) { $script:expectedOwners[$k2] = [System.Collections.Generic.List[string]]::new() }"
    , ScRaw "$script:expectedOwners[$k2].Add($n2)"
    ]

  t06-atxt-script-expected-owners : List ShellCmd =
    [ ScRaw "$owners = @($script:expectedOwners[$atxt] | Where-Object { $_ -ne $Name } | Sort-Object)"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "owners") "Count") ((SeInt 0)))) t06-owners-count []
    ]

  t06-owners-count : List ShellCmd =
    [ ScRaw "return \"HOLDS the expected output of $($owners -join ' / ') byte-for-byte -- batch misattribution, not codegen (ExaminersAssay: the batch stream can lose bytes); re-run\""
    ]

  t06-etxt-length-atxt : List ShellCmd =
    [ ScRaw "$lim = [Math]::Min($etxt.Length, $atxt.Length)"
    , ScAssign "off" (SeInt 0)
    , ScRaw "while ($off -lt $lim -and $etxt[$off] -eq $atxt[$off]) { $off++ }"
    , ScIf (SeBare (SeAnd (SeBare (SeIntLt (SeProperty (SeVar "atxt") "Length") (SeProperty (SeVar "etxt") "Length"))) (SeBare (SeIntEq (SeVar "off") (SeProperty (SeVar "atxt") "Length"))))) t06-atxt-length-etxt-off []
    , ScRaw "return \"LENGTHS DIFFER: actual $($atxt.Length) chars, expected $($etxt.Length), first difference at offset $off -- not a prefix, so this is a content difference and the line below is the one to read (L-SHORT)\""
    ]

  t06-atxt-length-etxt-off : List ShellCmd =
    [ ScRaw "return \"TRUNCATED: actual $($atxt.Length) chars is a strict PREFIX of the expected $($etxt.Length) -- the capture is SHORT, not wrong; re-run before reading this as codegen (L-SHORT)\""
    ]

  t06-i-n : List ShellCmd =
    [ ScRaw "$el = if ($i -lt $e.Count) { $e[$i] } else { '<absent>' }"
    , ScRaw "$al = if ($i -lt $a.Count) { $a[$i] } else { '<absent>' }"
    , ScRaw "if ($el -cne $al) { return \"line $($i + 1): expected [$el] actual [$al]\" }"
    ]

  t06-status-2 : List ShellCmd =
    [ ScAssign "log" (SeBare (SePathJoinN [SeVar "out", SeLit "build.log"]))
    , ScIf (SeBare (SeFileExists (SeVar "log"))) t06-if-test-type-log []
    ]

  t06-if-test-type-log : List ShellCmd =
    [ ScRaw "$hit = Select-String -Path $log -Pattern 'error (CDX)?\\d+' | Select-Object -First 1"
    , ScRaw "if ($hit) { return $hit.Line.Trim() }"
    ]

  t06-if-test-type-prev-file : List ShellCmd =
    [ ScRaw "try {"
    , ScIndent t06-block-2
    , ScRaw "} catch { $prev = @{} }"
    ]

  t06-block-2 : List ShellCmd =
    [ ScRaw "$pj = Get-Content $prevFile -Raw | ConvertFrom-Json"
    , ScRaw "$prevStamp = \"$($pj.stamp)\""
    , ScRaw "$prevTiers = \"$($pj.tiers)\""
    , ScRaw "foreach ($p in $pj.status.PSObject.Properties) { $prev[$p.Name] = \"$($p.Value)\" }"
    ]

  t06-n-status-of-keys : List ShellCmd =
    [ ScRaw "$now = $statusOf[$n]"
    , ScRaw "if (-not $prev.ContainsKey($n)) {"
    , ScIndent t06-not-prev-key-n
    , ScRaw "}"
    , ScRaw "$was = $prev[$n]"
    , ScRaw "if ($now -like 'FAIL_*' -and $was -notlike 'FAIL_*') { $newlyRed.Add(\"$n ($was -> $now)\") }"
    , ScRaw "elseif ($now -notlike 'FAIL_*' -and $was -like 'FAIL_*') { $fixedNow.Add(\"$n ($was -> $now)\") }"
    ]

  t06-not-prev-key-n : List ShellCmd =
    [ ScIncrement "addedCount"
    , ScRaw "if ($now -like 'FAIL_*') { $addedRed.Add(\"$n ($now)\") }"
    , ScContinue
    ]

  t06-each-all-dirs : List ShellCmd =
    [ ScRaw "Get-ChildItem -Path \"$d\\*.codex\" -File -ErrorAction SilentlyContinue | ForEach-Object {"
    , ScIndent t06-get-child-item-file
    , ScRaw "}"
    ]

  t06-get-child-item-file : List ShellCmd =
    [ ScRaw "[void]$existingNames.Add([System.IO.Path]::GetFileNameWithoutExtension($_.Name))"
    ]

  t06-n-prev-keys : List ShellCmd =
    [ ScRaw "if (-not $statusOf.ContainsKey($n) -and -not $existingNames.Contains($n)) { $removed.Add($n) }"
    ]

  t06-n-status-of-keys-2 : List ShellCmd =
    [ ScRaw "$c = if ($catOf.ContainsKey($n)) { $catOf[$n] } else { '?' }"
    , ScRaw "if (-not $catStats.ContainsKey($c)) { $catStats[$c] = @{ pass = 0; fail = 0; skip = 0 } }"
    , ScRaw "$s = $statusOf[$n]"
    , ScRaw "if ($s -like 'FAIL_*') { $catStats[$c].fail++ }"
    , ScRaw "elseif ($s -eq 'SKIPPED') { $catStats[$c].skip++ }"
    , ScRaw "else { $catStats[$c].pass++ }"
    ]

  t06-c-cat-stats-keys : List ShellCmd =
    [ ScRaw "$roll.Add((\"{0,-12}  {1,4}  {2,4}  {3,4}\" -f $c, $catStats[$c].pass, $catStats[$c].fail, $catStats[$c].skip))"
    ]

  t06-n-status-of-keys-3 : List ShellCmd =
    [ ScRaw "$rmF = Join-Path (Join-Path $OutRoot $n) '.run-ms'"
    , ScIf (SeBare (SeFileExists (SeVar "rmF"))) t06-if-test-type-rm-f []
    ]

  t06-if-test-type-rm-f : List ShellCmd =
    [ ScAssign "ms" (SeInt 0)
    , ScRaw "if ([int]::TryParse((Get-Content -TotalCount 1 $rmF).Trim(), [ref]$ms)) { $slowRows.Add([pscustomobject]@{ Name = $n; Ms = $ms }) }"
    ]

  t06-fail-names-count : List ShellCmd =
    [ ScRaw "$roll.Add('')"
    , ScRaw "$roll.Add('failures:')"
    , ScForEach "n" (SeVar "failNames") t06-each-fail-names
    ]

  t06-each-fail-names : List ShellCmd =
    [ ScRaw "$hint = Get-FailHint -Name $n -Status $statusOf[$n]"
    , ScRaw "$roll.Add(\"  $n  $($statusOf[$n])$(if ($hint) { \"  -- $hint\" })\")"
    ]

  t06-each-oracle-results : List ShellCmd =
    [ ScRaw "$roll.Add(\"oracle $($or.Name): $(if ($or.Ok) { 'PASS' } else { 'FAIL' }) ($($or.Seconds)s)  $($or.Note)\")"
    ]

  t06-prev-count : List ShellCmd =
    [ ScRaw "$roll.Add(\"delta vs previous run ($prevStamp, tiers=$prevTiers):\")"
    , ScRaw "$roll.Add(\"  newly red: $($newlyRed.Count)$(if ($newlyRed.Count) { '  ' + (($newlyRed | Select-Object -First 20) -join '; ') })\")"
    , ScRaw "$roll.Add(\"  fixed:     $($fixedNow.Count)$(if ($fixedNow.Count) { '  ' + (($fixedNow | Select-Object -First 20) -join '; ') })\")"
    , ScRaw "$roll.Add(\"  new tests: $addedCount$(if ($addedRed.Count) { '  RED AMONG THEM: ' + ($addedRed -join '; ') })\")"
    , ScRaw "$roll.Add(\"  removed:   $($removed.Count)$(if ($removed.Count) { '  ' + (($removed | Select-Object -First 20) -join '; ') })\")"
    ]

  t06-block-3 : List ShellCmd =
    [ ScRaw "$roll.Add('delta: no previous run recorded (first rollup)')"
    ]

  t06-unexpected-oracle-fails : List ShellCmd =
    [ ScRaw "function Show-Failures { param([string]$Label, [object[]]$Items); if ($Items.Count -gt 0) { Write-Host \"${Label}:\"; foreach ($i in $Items) { Write-Host \"  $i\" } } }"
    , ScRaw "Show-Failures 'compile failed'              $buckets.FAIL_COMPILE"
    , ScRaw "Show-Failures 'expected error but compiled' $buckets.FAIL_EXPECTED_BUT_COMPILED"
    , ScRaw "Show-Failures 'wrong diagnostic'            $buckets.FAIL_WRONG_DIAGNOSTIC"
    , ScRaw "Show-Failures 'missing diagnostic'          $buckets.FAIL_MISSING_DIAGNOSTIC"
    , ScRaw "Show-Failures 'output mismatch'             $buckets.FAIL_OUTPUT"
    , ScRaw "Show-Failures 'runtime error'               $buckets.FAIL_RUNTIME"
    , ScRaw "Show-Failures 'disk source missing'         $buckets.FAIL_DISK_SOURCE"
    , ScRaw "Show-Failures 'oracle collections'          @($oracleResults | Where-Object { -not $_.Ok } | ForEach-Object { $_.Name })"
    , ScRaw "Restore-Kernel"
    , ScExit (SeInt 1)
    ]

Section: The stages

  t01 : PipeStage = PipeStage { ps-name = "usage, the approval gate and preamble", ps-why = "the battery is Damian's tool, so the script refuses to run without his approval, and that refusal is deliberate", ps-in = ["ApprovedBy"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "no approval was given, so the battery did not run; a lane that believes a battery is warranted says so in one sentence and stops"], ps-body = t01-body }

  t02 : PipeStage = PipeStage { ps-name = "tiers and test gathering", ps-why = "resolve the tier and battery selectors into the subject list, refusing every way a selector can silently select the wrong set", ps-in = ["Tier", "Battery", "ListSubjects"], ps-out = [tests-art], ps-needs = [], ps-verdict = [PoExit 1 "an unknown tier was named", PoExit 1 "a battery no codex/test chapter cites was named", PoExit 1 "an unknown battery was named", PoExit 1 "a battery selected nothing, which must refuse rather than fall through to another set", PoExit 0 "-ListSubjects printed the selected subjects and ran none of them"], ps-body = t02-body }

  t03 : PipeStage = PipeStage { ps-name = "kernel provenance and pre-filter", ps-why = "which compiler is on trial, and is it the one you think; a battery over a stale kernel is a statement about yesterday", ps-in = ["CodexCdx", "AllowStaleKernel"], ps-out = [stage0-art, seed-digest-art], ps-needs = [], ps-verdict = [PoExit 2 "the path given to -CodexCdx does not exist", PoExit 2 "there is no battery kernel and no seed to install one from", PoExit 2 "the installed kernel is stale and -AllowStaleKernel was not given"], ps-body = t03-body }

  t04 : PipeStage = PipeStage { ps-name = "phase 1 batch compile and crash containment", ps-why = "the batch REPL carries state across compiles, so one corrupted session reports phantom diagnostics for every test after it; a killed VM re-runs its round standalone rather than being believed", ps-in = ["tests", "Jobs", "stage0"], ps-out = [], ps-needs = [PrKernel (SeVar "stage0")], ps-verdict = [], ps-body = t04-body }

  t05 : PipeStage = PipeStage { ps-name = "classify and phase 2 run", ps-why = "split the compiled subjects by what each one asserts, then run the ones whose claim is about behaviour rather than diagnostics", ps-in = ["tests", "Jobs"], ps-out = [], ps-needs = [PrKernel (SeVar "stage0")], ps-verdict = [], ps-body = t05-body }

  t06 : PipeStage = PipeStage { ps-name = "oracles, aggregate, rollup and exit", ps-why = "the oracle collections, the tally across every phase, and the kernel put back the way it was found", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "at least one subject or oracle collection failed, and each failing name is printed above", PoExit 0 "every selected subject and every oracle collection passed"], ps-body = t06-body }

Section: Assembly

  test-pipe : Pipeline = Pipeline { pl-name = "test", pl-doc = "Compiler acceptance test harness -- batch mode.", pl-params = test-params, pl-stages = [PsStage t01, PsStage t02, PsStage t03, PsStage t04, PsStage t05, PsStage t06] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell test-pipe))
  end

