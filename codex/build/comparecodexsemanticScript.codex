Chapter: CompareCodexSemanticScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  sem-params : List ShellParam = [sh-param "Source" SptString, sh-param "Stage1" SptString, sh-param-default "Show" SptString (SeLit "")]

Section: S01 -- Preamble

  s01-body : List ShellCmd =
    [ScSetStrictMode, ScSetErrorStop, ScBlank,
     ScAssign "sourceText" (SeRaw "[System.IO.File]::ReadAllText($Source).Replace(\"`r`n\", \"`n\")"),
     ScAssign "stage1Text" (SeRaw "[System.IO.File]::ReadAllText($Stage1).Replace(\"`r`n\", \"`n\")")]

Section: S02 -- SemDef Class

  s02-body : List ShellCmd =
    [ ScBlank
    , ScRaw "class SemDef {"
    , ScIndent s02-class-sem-def
    , ScRaw "}"
    ]

  s02-class-sem-def : List ShellCmd =
    [ ScRaw "[string]$Name"
    , ScRaw "[string]$Chapter"
    , ScRaw "[string]$Sig"
    , ScRaw "[string]$Body"
    , ScRaw "[int]$LineNo"
    , ScRaw "[bool]$IsType"
    , ScRaw "SemDef([string]$n, [string]$ch, [string]$s, [string]$b, [int]$l, [bool]$t) {"
    , ScIndent s02-sem-def-string-n
    , ScRaw "}"
    ]

  s02-sem-def-string-n : List ShellCmd =
    [ ScRaw "$this.Name = $n; $this.Chapter = $ch; $this.Sig = $s; $this.Body = $b; $this.LineNo = $l; $this.IsType = $t"
    ]

Section: S02b -- Canonicalize-TypeName

  s02b-body : List ShellCmd =
    [ ScBlank
    , ScFunction "Canonicalize-TypeName" [sh-param "n" SptString] s02b-canonicalize-type-name-string
    ]

  s02b-canonicalize-type-name-string : List ShellCmd =
    [ ScRaw "$parts = @(($n -replace '[()]', ' ') -split '\\s+' | Where-Object { $_ -ne '' })"
    , ScRaw "if ($parts.Count -le 1) { return $n }"
    , ScRaw "$head = $parts[0]"
    , ScRaw "$params = @($parts[1..($parts.Count - 1)] | ForEach-Object { \"($_)\" })"
    , ScRaw "return \"$head $($params -join ' ')\""
    ]

Section: S03 -- Parse-OneDef Function

  s03-body : List ShellCmd =
    [ ScBlank
    , ScFunction "Parse-OneDef" [sh-param "lines" SptStringArray, sh-param "start" SptInt, sh-param "chapter" SptString] s03-parse-one-def-string
    ]

  s03-parse-one-def-string : List ShellCmd =
    [ ScRaw "$firstLine = $lines[$start]"
    , ScRaw "$isType = [char]::IsUpper($firstLine[0])"
    , ScRaw "$name = ''; $sig = ''"
    , ScIf (SeVar "isType") s03-if-type s03-if-type-else
    , ScRaw "$bodyLines = [System.Text.StringBuilder]::new()"
    , ScRaw "if ($isType) { [void]$bodyLines.AppendLine($lines[$start]) }"
    , ScRaw "elseif ($inlineBody) { [void]$bodyLines.AppendLine(\"$name = $inlineBody\") }"
    , ScRaw "$sigEnd = $start + 1"
    , ScRaw "while (-not $isType -and -not $inlineBody -and $sig.TrimEnd() -match '(->|,)$' -and $sigEnd -lt $lines.Count -and $lines[$sigEnd].Length -gt 0 -and [char]::IsWhiteSpace($lines[$sigEnd][0])) {"
    , ScIndent s03-not-type-inline-body
    , ScRaw "}"
    , ScAssign "j" (SeVar "sigEnd")
    , ScWhile (SeBare (SeIntLt (SeVar "j") (SeProperty (SeVar "lines") "Count"))) s03-j-lines-count
    , ScRaw "$def = [SemDef]::new($name, $chapter, $sig, $bodyLines.ToString().TrimEnd(), ($start + 1), $isType)"
    , ScRaw "return @($def, $j)"
    ]

  s03-if-type : List ShellCmd =
    [ ScRaw "$eqPos = $firstLine.IndexOf(' =')"
    , ScRaw "if ($eqPos -lt 0) { return @($null, ($start + 1)) }"
    , ScRaw "$name = Canonicalize-TypeName $firstLine.Substring(0, $eqPos).Trim()"
    ]

  s03-if-type-else : List ShellCmd =
    [ ScRaw "$colonPos = $firstLine.IndexOf(' : ')"
    , ScRaw "if ($colonPos -lt 0) { return @($null, ($start + 1)) }"
    , ScRaw "$name = $firstLine.Substring(0, $colonPos)"
    , ScRaw "$sig = $firstLine.Substring($colonPos + 3)"
    , ScRaw "$inlineEq = $sig.IndexOf(' = ')"
    , ScAssign "inlineBody" (SeVar "null")
    , ScIf (SeBare (SeIntGe (SeVar "inlineEq") (SeInt 0))) s03-if-inline []
    ]

  s03-if-inline : List ShellCmd =
    [ ScRaw "$inlineBody = $sig.Substring($inlineEq + 3)"
    , ScRaw "$sig = $sig.Substring(0, $inlineEq)"
    ]

  s03-not-type-inline-body : List ShellCmd =
    [ ScRaw "$sig = $sig.TrimEnd() + ' ' + $lines[$sigEnd].Trim()"
    , ScIncrement "sigEnd"
    ]

  s03-j-lines-count : List ShellCmd =
    [ ScRaw "$ln = $lines[$j]"
    , ScIfLine (SeBare (SeMatch (SeVar "ln") "^(HEAP|STACK):\\d+")) [ScIncrement "j", ScContinue] []
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "ln") "Length") ((SeInt 0)))) s03-ln-length []
    , ScRaw "if ($ln.Length -gt 0 -and [char]::IsLetter($ln[0])) {"
    , ScIndent s03-ln-length-char-letter
    , ScRaw "}"
    , ScRaw "if ($ln.Length -gt 0 -and ([char]::IsWhiteSpace($ln[0]) -or $ln[0] -in '|','}',']',')')) {"
    , ScIndent [ScRaw "[void]$bodyLines.AppendLine($ln); $j++; continue"]
    , ScRaw "}"
    , ScBreak
    ]

  s03-ln-length : List ShellCmd =
    [ ScRaw "$peek = $j + 1"
    , ScRaw "while ($peek -lt $lines.Count -and $lines[$peek].Length -eq 0) { $peek++ }"
    , ScIfLine (SeBare (SeIntGe (SeVar "peek") (SeProperty (SeVar "lines") "Count"))) [ScBreak] []
    , ScRaw "if ($lines[$peek].Length -gt 0 -and -not [char]::IsWhiteSpace($lines[$peek][0])) {"
    , ScIndent s03-lines-peek-length-not
    , ScRaw "}"
    , ScRaw "[void]$bodyLines.AppendLine()"
    , ScRaw "$j++; continue"
    ]

  s03-lines-peek-length-not : List ShellCmd =
    [ ScRaw "if (-not $isType -and $lines[$peek].StartsWith($name) -and ($lines[$peek].Length -eq $name.Length -or $lines[$peek][$name.Length] -eq ' ' -or $lines[$peek][$name.Length] -eq '(')) { [void]$bodyLines.AppendLine(); $j++; continue }"
    , ScRaw "if ($lines[$peek][0] -in '}',']',')') { [void]$bodyLines.AppendLine(); $j++; continue }"
    , ScRaw "if ($lines[$peek] -eq 'end' -or $lines[$peek] -eq 'qed') { [void]$bodyLines.AppendLine(); $j++; continue }"
    , ScBreak
    ]

  s03-ln-length-char-letter : List ShellCmd =
    [ ScRaw "if (-not $isType -and $ln.StartsWith($name) -and ($ln.Length -eq $name.Length -or $ln[$name.Length] -eq ' ' -or $ln[$name.Length] -eq '(')) {"
    , ScIndent [ScRaw "[void]$bodyLines.AppendLine($ln); $j++; continue"]
    , ScRaw "}"
    , ScIf (SeBare (SeOr (SeBare (SeStringEq (SeVar "ln") (SeLit "end"))) (SeBare (SeStringEq (SeVar "ln") (SeLit "qed"))))) [ScRaw "[void]$bodyLines.AppendLine($ln); $j++; continue"] []
    , ScRaw "$looksLikeSig = $ln.Contains(' : ')"
    , ScRaw "$looksLikeType = [char]::IsUpper($ln[0]) -and $ln.Contains(' =')"
    , ScIf (SeBare (SeAnd (SeBare (SeAnd (SeVar "isType") (SeBare (SeNot (SeVar "looksLikeSig"))))) (SeBare (SeNot (SeVar "looksLikeType"))))) [ScRaw "[void]$bodyLines.AppendLine($ln); $j++; continue"] []
    , ScBreak
    ]

Section: S04 -- Parse-Stage0 Function

  s04-body : List ShellCmd =
    [ ScBlank
    , ScFunction "Parse-Stage0" [sh-param "text" SptString] s04-parse-stage0-string-text
    ]

  s04-parse-stage0-string-text : List ShellCmd =
    [ ScRaw "$chapters = [ordered]@{}"
    , ScRaw "$slugs = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "$rawLines = $text.Split(\"`n\")"
    , ScAssign "currentSlug" (SeLit "")
    , ScAssign "i" (SeInt 0)
    , ScWhile (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "rawLines") "Count"))) s04-i-lines-count
    , ScRaw "return @($chapters, $slugs)"
    ]

  s04-i-lines-count : List ShellCmd =
    [ ScRaw "$raw = $rawLines[$i]"
    , ScRaw "if ($raw.StartsWith('Chapter: ')) {"
    , ScIndent s04-starts-with
    , ScRaw "}"
    , ScRaw "if ($raw.StartsWith('Section: ') -or $raw.StartsWith('Page ')) { $i++; continue }"
    , ScIfLine (SeBare (SeAnd (SeBare (SeAnd (SeBare (SeIntGe (SeProperty (SeVar "raw") "Length") ((SeInt 1)))) (SeBare (SeStringEq (SeIndex (SeVar "raw") ((SeInt 0))) (SeLit " "))))) (SeOr (SeBare (SeIntLt (SeProperty (SeVar "raw") "Length") ((SeInt 2)))) (SeBare (SeStringNeq (SeIndex (SeVar "raw") ((SeInt 1))) (SeLit " ")))))) [ScIncrement "i", ScContinue] []
    , ScIf (SeBare (SeAnd (SeBare (SeAnd (SeBare (SeIntGe (SeProperty (SeVar "raw") "Length") ((SeInt 2)))) (SeBare (SeStringEq (SeIndex (SeVar "raw") ((SeInt 0))) (SeLit " "))))) (SeBare (SeStringEq (SeIndex (SeVar "raw") ((SeInt 1))) (SeLit " "))))) s04-length []
    , ScRaw "if ($raw.Length -gt 0 -and [char]::IsLetter($raw[0])) {"
    , ScIndent s04-length-char-letter
    , ScRaw "}"
    , ScIncrement "i"
    ]

  s04-starts-with : List ShellCmd =
    [ ScRaw "$chName = $raw.Substring(9).Trim()"
    , ScRaw "$currentSlug = $chName.ToLowerInvariant().Replace(' ', '-')"
    , ScRaw "if (-not $slugs.Contains($currentSlug)) { $slugs.Add($currentSlug) }"
    , ScRaw "if (-not $chapters.Contains($currentSlug)) { $chapters[$currentSlug] = [System.Collections.Generic.List[object]]::new() }"
    , ScRaw "$i++; continue"
    ]

  s04-length : List ShellCmd =
    [ ScRaw "$dedented = $raw.Substring(2)"
    , ScRaw "if ($dedented.StartsWith('cites ') -or $dedented.StartsWith('import ')) { $i++; continue }"
    , ScRaw "if ($dedented.Length -gt 0 -and [char]::IsLetter($dedented[0])) {"
    , ScIndent s04-dedented-length-char-letter
    , ScRaw "}"
    ]

  s04-dedented-length-char-letter : List ShellCmd =
    [ ScRaw "$defLines = [System.Collections.Generic.List[string]]::new()"
    , ScWhile (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "rawLines") "Count"))) s04-i-lines-count-2
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "defLines") "Count") ((SeInt 0)))) s04-def-lines-count []
    , ScContinue
    ]

  s04-i-lines-count-2 : List ShellCmd =
    [ ScRaw "$r = $rawLines[$i]"
    , ScIf (SeBare (SeAnd (SeBare (SeAnd (SeBare (SeIntGe (SeProperty (SeVar "r") "Length") ((SeInt 2)))) (SeBare (SeStringEq (SeIndex (SeVar "r") ((SeInt 0))) (SeLit " "))))) (SeBare (SeStringEq (SeIndex (SeVar "r") ((SeInt 1))) (SeLit " "))))) [ScRaw "$defLines.Add($r.Substring(2)); $i++; continue"] []
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "r") "Length") ((SeInt 0)))) s04-r-length-2 []
    , ScBreak
    ]

  s04-r-length-2 : List ShellCmd =
    [ ScRaw "$pk = $i + 1"
    , ScRaw "while ($pk -lt $rawLines.Count -and $rawLines[$pk].Length -eq 0) { $pk++ }"
    , ScRaw "if ($pk -ge $rawLines.Count) { break }"
    , ScRaw "$nx = $rawLines[$pk]"
    , ScIf (SeBare (SeAnd (SeBare (SeAnd (SeBare (SeIntGe (SeProperty (SeVar "nx") "Length") ((SeInt 2)))) (SeBare (SeStringEq (SeIndex (SeVar "nx") ((SeInt 0))) (SeLit " "))))) (SeBare (SeStringEq (SeIndex (SeVar "nx") ((SeInt 1))) (SeLit " "))))) s04-nx-length []
    , ScBreak
    ]

  s04-nx-length : List ShellCmd =
    [ ScRaw "$nxD = $nx.Substring(2)"
    , ScRaw "$isNewDef = $nxD.Length -gt 0 -and -not [char]::IsWhiteSpace($nxD[0]) -and ($nxD.Contains(' : ') -or [char]::IsUpper($nxD[0]))"
    , ScIf (SeBare (SeNot (SeVar "isNewDef"))) [ScRaw "$defLines.Add(''); $i++; continue"] []
    ]

  s04-def-lines-count : List ShellCmd =
    [ ScRaw "$arr = $defLines.ToArray()"
    , ScRaw "$r = Parse-OneDef $arr 0 $currentSlug"
    , ScRaw "if ($r[0] -and $chapters.Contains($currentSlug)) { $chapters[$currentSlug].Add($r[0]) }"
    ]

  s04-length-char-letter : List ShellCmd =
    [ ScRaw "$r = Parse-OneDef $rawLines $i $currentSlug"
    , ScRaw "if ($r[0] -and $chapters.Contains($currentSlug)) { $chapters[$currentSlug].Add($r[0]) }"
    , ScRaw "$i = $r[1]; continue"
    ]

Section: S05 -- Parse-Stage1 Function

  s05-body : List ShellCmd =
    [ ScBlank
    , ScFunction "Parse-Stage1" [sh-param "text" SptString] s05-parse-stage1-string-text
    ]

  s05-parse-stage1-string-text : List ShellCmd =
    [ ScRaw "$defs = [System.Collections.Generic.List[object]]::new()"
    , ScRaw "$lines = $text.Split(\"`n\")"
    , ScAssign "i" (SeInt 0)
    , ScWhile (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "lines") "Count"))) s05-i-lines-count
    , ScReturn (SeVar "defs")
    ]

  s05-i-lines-count : List ShellCmd =
    [ ScRaw "$ln = $lines[$i]"
    , ScIfLine (SeBare (SeMatch (SeVar "ln") "^(HEAP|STACK):\\d+")) [ScIncrement "i", ScContinue] []
    , ScRaw "if ($ln.Length -gt 0 -and [char]::IsLetter($ln[0])) {"
    , ScIndent s05-ln-length-char-letter
    , ScRaw "} else { $i++ }"
    ]

  s05-ln-length-char-letter : List ShellCmd =
    [ ScRaw "$r = Parse-OneDef $lines $i ''"
    , ScRaw "if ($r[0]) { $defs.Add($r[0]) }"
    , ScRaw "$i = $r[1]"
    ]

Section: S06 -- Demangle Functions

  s06-body : List ShellCmd =
    [ ScBlank
    , ScFunction "Demangle-Name" [sh-param "name" SptString, sh-param "slugsSorted" SptStringArray] s06-demangle-name-string-slugs
    , ScBlank
    , ScFunction "Demangle-Names" [sh-param "body" SptString, sh-param "slugsSorted" SptStringArray] s06-demangle-names-string-body
    ]

  s06-demangle-name-string-slugs : List ShellCmd =
    [ ScForEach "slug" (SeVar "slugsSorted") s06-each-slugs-sorted
    , ScReturn (SeVar "null")
    ]

  s06-each-slugs-sorted : List ShellCmd =
    [ ScRaw "$prefix = \"${slug}_\""
    , ScRaw "if ($name.StartsWith($prefix) -and $name.Length -gt $prefix.Length) {"
    , ScIndent [ScRaw "return @($slug, $name.Substring($prefix.Length))"]
    , ScRaw "}"
    ]

  s06-demangle-names-string-body : List ShellCmd =
    [ ScAssign "text" (SeVar "body")
    , ScForEach "slug" (SeVar "slugsSorted") s06-each-slugs-sorted-2
    , ScReturn (SeVar "text")
    ]

  s06-each-slugs-sorted-2 : List ShellCmd =
    [ ScRaw "$prefix = [regex]::Escape(\"${slug}_\")"
    , ScRaw "$text = [regex]::Replace($text, \"(?<![a-zA-Z0-9_-])${prefix}([a-z])\", '$1')"
    ]

Section: S07 -- Operator Precedence Helpers

  s07-body : List ShellCmd =
    [ ScBlank
    , ScRaw "$script:scopeKws = @('if','when','let','act','match','lambda','\\','handle','fork','await','trying')"
    , ScRaw "$script:nonAtomKws = @('let','in','act','end','qed','match','when','is','if','then','else','lambda','handle','fork','await','of','where','with')"
    , ScBlank
    , ScFunction "Get-OpPrec" [sh-param "tok" SptString] s07-get-op-prec-string
    , ScBlank
    , ScFunction "Is-AtomToken" [sh-param "tok" SptString] s07-atom-token-string-tok
    ]

  s07-get-op-prec-string : List ShellCmd =
    [ ScRaw "switch ($tok) {"
    , ScIndent s07-switch-tok
    , ScRaw "}"
    ]

  s07-switch-tok : List ShellCmd =
    [ ScRaw "'||' { return 1 } '|' { return 2 } '&' { return 3 }"
    , ScRaw "'==' { return 4 } '/=' { return 4 } '<' { return 4 } '>' { return 4 } '<=' { return 4 } '>=' { return 4 }"
    , ScRaw "'::' { return 5 }"
    , ScRaw "'+' { return 6 } '-' { return 6 }"
    , ScRaw "'*' { return 7 } '/' { return 7 } '%' { return 7 }"
    , ScRaw "'^' { return 8 }"
    , ScRaw "'.' { return 20 }"
    , ScRaw "default { return 0 }"
    ]

  s07-atom-token-string-tok : List ShellCmd =
    [ ScRaw "if (-not $tok) { return $false }"
    , ScRaw "$c = $tok[0]"
    , ScRaw "if ($c -eq '\"' -or $c -eq \"'\") { return $true }"
    , ScRaw "if (-not ([char]::IsLetterOrDigit($c) -or $c -eq '_')) { return $false }"
    , ScRaw "return $tok -notin $script:nonAtomKws"
    ]

Section: S08 -- Find-MatchingClose and Strip-RedundantParens

  s08-body : List ShellCmd =
    [ ScBlank
    , ScRaw "function Find-MatchingClose([System.Collections.Generic.List[string]]$tokens, [int]$openIdx) {"
    , ScIndent s08-find-matching-close-system
    , ScRaw "}"
    , ScBlank
    , ScRaw "function Strip-RedundantParens([System.Collections.Generic.List[string]]$tokens) {"
    , ScIndent s08-strip-redundant-parens-system
    , ScRaw "}"
    ]

  s08-find-matching-close-system : List ShellCmd =
    [ ScAssign "depth" (SeInt 1)
    , ScRaw "for ($j = $openIdx + 1; $j -lt $tokens.Count; $j++) {"
    , ScIndent s08-j-open-idx-tokens
    , ScRaw "}"
    , ScReturn (SeInt -1)
    ]

  s08-j-open-idx-tokens : List ShellCmd =
    [ ScRaw "if ($tokens[$j] -in '(','[','{') { $depth++ }"
    , ScRaw "elseif ($tokens[$j] -in ')',']','}') {"
    , ScIndent s08-tokens-j
    , ScRaw "}"
    ]

  s08-tokens-j : List ShellCmd =
    [ ScDecrement "depth"
    , ScRaw "if ($depth -eq 0) { return $(if ($tokens[$j] -eq ')') { $j } else { -1 }) }"
    ]

  s08-strip-redundant-parens-system : List ShellCmd =
    [ ScAssign "AppPrec" (SeInt 10)
    , ScAssign "changed" (SeVar "true")
    , ScWhile (SeVar "changed") s08-while-changed
    ]

  s08-while-changed : List ShellCmd =
    [ ScAssign "changed" (SeVar "false")
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "tokens") "Count"))) (SePostIncrement "i") s08-i-tokens-count
    ]

  s08-i-tokens-count : List ShellCmd =
    [ ScIfLine (SeBare (SeStringNeq (SeIndex (SeVar "tokens") (SeVar "i")) (SeLit "("))) [ScContinue] []
    , ScRaw "$close = Find-MatchingClose $tokens $i"
    , ScIfLine (SeBare (SeIntLt (SeVar "close") ((SeInt 0)))) [ScBreak] []
    , ScRaw "$innerLen = $close - $i - 1"
    , ScRaw "if ($innerLen -le 0) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    , ScRaw "if ($innerLen -eq 1) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    , ScRaw "if ($tokens[$i+1] -eq '[') {"
    , ScIndent s08-tokens-i
    , ScRaw "}"
    , ScRaw "$first = $tokens[$i + 1]"
    , ScRaw "if ($first -in $script:scopeKws) {"
    , ScIndent s08-first-script-scope-kws
    , ScRaw "}"
    , ScRaw "$innerOps = [System.Collections.Generic.List[object]]::new()"
    , ScRaw "$depth2 = 0; $afterOp = $false"
    , ScRaw "for ($k = $i + 1; $k -lt $close; $k++) {"
    , ScIndent s08-k-i-close-2
    , ScRaw "}"
    , ScRaw "$prev = if ($i -gt 0) { $tokens[$i - 1] } else { $null }"
    , ScRaw "$next = if ($close -lt $tokens.Count - 1) { $tokens[$close + 1] } else { $null }"
    , ScRaw "$lp = if ($prev) { $p = Get-OpPrec $prev; if ($p -gt 0) { $p } elseif ($prev -in ')',']','}') { $AppPrec } elseif (Is-AtomToken $prev) { $AppPrec } else { 0 } } else { 0 }"
    , ScRaw "$rp = if ($next) { $p = Get-OpPrec $next; if ($p -gt 0) { $p } elseif ($next -in '(','[','{') { $AppPrec } elseif (Is-AtomToken $next) { $AppPrec } else { 0 } } else { 0 }"
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "innerOps") "Count") ((SeInt 0)))) s08-inner-ops-count s08-block
    ]

  s08-tokens-i : List ShellCmd =
    [ ScRaw "$bracketClose = Find-MatchingClose $tokens $i"
    , ScRaw "$depth3 = 0; $allBracketed = $true"
    , ScRaw "for ($k = $i+1; $k -lt $close; $k++) {"
    , ScIndent s08-k-i-close
    , ScRaw "}"
    , ScRaw "if ($allBracketed) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    ]

  s08-k-i-close : List ShellCmd =
    [ ScRaw "if ($tokens[$k] -eq '[') { $depth3++ } elseif ($tokens[$k] -eq ']') { $depth3-- }"
    , ScRaw "if ($depth3 -eq 0 -and $k -lt $close - 1) { $allBracketed = $false; break }"
    ]

  s08-first-script-scope-kws : List ShellCmd =
    [ ScRaw "$nextTok = if ($close -lt $tokens.Count - 1) { $tokens[$close + 1] } else { $null }"
    , ScRaw "$rp = if ($nextTok) { $p = Get-OpPrec $nextTok; if ($p -gt 0) { $p } elseif (Is-AtomToken $nextTok) { $AppPrec } else { 0 } } else { 0 }"
    , ScRaw "if ($rp -eq 0) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    , ScContinue
    ]

  s08-k-i-close-2 : List ShellCmd =
    [ ScRaw "if ($tokens[$k] -in '(','[','{') { $depth2++; $afterOp = $false; continue }"
    , ScRaw "if ($tokens[$k] -in ')',']','}') { $depth2--; $afterOp = $true; continue }"
    , ScRaw "if ($depth2 -gt 0) { continue }"
    , ScRaw "$opP = Get-OpPrec $tokens[$k]"
    , ScRaw "if ($opP -gt 0 -and $afterOp) { $innerOps.Add(@($tokens[$k], $opP)); $afterOp = $false }"
    , ScRaw "elseif ($opP -eq 0) { $afterOp = $true }"
    ]

  s08-inner-ops-count : List ShellCmd =
    [ ScRaw "$leftOK = $lp -lt $AppPrec -or $lp -eq 0"
    , ScRaw "$rightOK = $rp -le $AppPrec -or $rp -eq 0"
    , ScRaw "if ($leftOK -and $rightOK) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    ]

  s08-block : List ShellCmd =
    [ ScRaw "$precL = $innerOps[0][1]; $opL = $innerOps[0][0]"
    , ScRaw "$precR = $innerOps[-1][1]; $opR = $innerOps[-1][0]"
    , ScRaw "$isLAssocL = $opL -ne '^' -and $opL -ne '::'"
    , ScRaw "$isLAssocR = $opR -ne '^' -and $opR -ne '::'"
    , ScRaw "$leftOK = $lp -eq 0 -or $lp -lt $precL -or ($lp -eq $precL -and $isLAssocL)"
    , ScRaw "$rightOK = $rp -eq 0 -or $rp -lt $precR -or ($rp -eq $precR -and $isLAssocR)"
    , ScRaw "if ($leftOK -and $rightOK) { $tokens.RemoveAt($close); $tokens.RemoveAt($i); $changed = $true; break }"
    ]

Section: S09 -- Normalize and Collapse Functions

  s09-body : List ShellCmd =
    [ ScBlank
    , ScRaw "function Normalize-OpAliases([System.Collections.Generic.List[string]]$tokens) {"
    , ScIndent s09-normalize-op-aliases-system
    , ScRaw "}"
    , ScBlank
    , ScFunction "Collapse-Whitespace" [sh-param "text" SptString] s09-collapse-whitespace-string-text
    , ScBlank
    , ScFunction "Alpha-NormalizeTypeVars" [sh-param "sig" SptString] s09-alpha-normalize-type-vars
    ]

  s09-normalize-op-aliases-system : List ShellCmd =
    [ ScRaw "for ($i = $tokens.Count - 2; $i -ge 0; $i--) {"
    , ScIndent s09-i-tokens-count
    , ScRaw "}"
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "tokens") "Count"))) (SePostIncrement "i") s09-i-tokens-count-2
    , ScRaw "for ($i = $tokens.Count - 2; $i -ge 0; $i--) {"
    , ScIndent s09-i-tokens-count-3
    , ScRaw "}"
    , ScRaw "for ($i = $tokens.Count - 2; $i -ge 0; $i--) {"
    , ScIndent s09-i-tokens-count-4
    , ScRaw "}"
    ]

  s09-i-tokens-count : List ShellCmd =
    [ ScRaw "if ($tokens[$i] -ne 'not') { continue }"
    , ScRaw "$e = $i + 1"
    , ScRaw "if ($tokens[$e] -eq '(') { $e = Find-MatchingClose $tokens $e; if ($e -lt 0) { continue } }"
    , ScRaw "elseif (Is-AtomToken $tokens[$e]) { while ($e + 2 -lt $tokens.Count -and $tokens[$e + 1] -eq '.' -and (Is-AtomToken $tokens[$e + 2])) { $e += 2 } }"
    , ScRaw "else { continue }"
    , ScRaw "$tokens.RemoveAt($i); $tokens.Insert($e, 'False'); $tokens.Insert($e, '='); $tokens.Insert($e, '=')"
    ]

  s09-i-tokens-count-2 : List ShellCmd =
    [ ScRaw "if ($tokens[$i] -eq ',' -and $i + 1 -lt $tokens.Count -and $tokens[$i+1].Length -gt 0 -and [char]::IsUpper($tokens[$i+1][0])) { $tokens[$i] = '->' }"
    ]

  s09-i-tokens-count-3 : List ShellCmd =
    [ ScRaw "if ($tokens[$i] -eq '#' -and $tokens[$i+1] -match '^[0-9A-Fa-f_]+$') {"
    , ScIndent s09-tokens-i
    , ScRaw "}"
    ]

  s09-tokens-i : List ShellCmd =
    [ ScRaw "$hex = $tokens[$i+1] -replace '_',''"
    , ScRaw "$u = [System.Convert]::ToUInt64($hex, 16)"
    , ScRaw "$v = [System.BitConverter]::ToInt64([System.BitConverter]::GetBytes($u), 0)"
    , ScIf (SeBare (SeIntGe (SeVar "v") (SeInt 0))) [ScRaw "$tokens.RemoveAt($i+1); $tokens[$i] = \"$v\""] s09-if-v-else
    ]

  s09-if-v-else : List ShellCmd =
    [ ScRaw "$tokens[$i] = '('; $tokens[$i+1] = '-'; $tokens.Insert($i+2, \"$(-([System.Numerics.BigInteger]$v))\"); $tokens.Insert($i+3, ')')"
    ]

  s09-i-tokens-count-4 : List ShellCmd =
    [ ScRaw "if ($tokens[$i] -eq '__linked-list-empty' -and $tokens[$i+1] -eq '0') {"
    , ScIndent s09-tokens-i-2
    , ScRaw "}"
    ]

  s09-tokens-i-2 : List ShellCmd =
    [ ScRaw "if ($i -gt 0 -and $i + 2 -lt $tokens.Count -and $tokens[$i-1] -eq '(' -and $tokens[$i+2] -eq ')') {"
    , ScIndent s09-i-tokens-count-5
    , ScRaw "} else {"
    , ScIndent [ScRaw "$tokens[$i] = '['; $tokens[$i+1] = ']'"]
    , ScRaw "}"
    ]

  s09-i-tokens-count-5 : List ShellCmd =
    [ ScRaw "$tokens.RemoveAt($i+2); $tokens.RemoveAt($i+1); $tokens.RemoveAt($i); $tokens[$i-1] = '['; $tokens.Insert($i, ']')"
    ]

  s09-collapse-whitespace-string-text : List ShellCmd =
    [ ScRaw "$tokens = [System.Collections.Generic.List[string]]::new()"
    , ScRaw "foreach ($m in [regex]::Matches($text, '[a-zA-Z0-9_][a-zA-Z0-9_\\-]*|\"(?:\\\\.|[^\"\\\\])*\"|''(?:\\\\.|[^''\\\\])*''|::|->|<-|<=|>=|/=|&&|\\|\\||\\S')) {"
    , ScIndent [ScRaw "$tokens.Add($m.Value)"]
    , ScRaw "}"
    , ScRaw "Normalize-OpAliases $tokens"
    , ScRaw "Strip-RedundantParens $tokens"
    , ScRaw "return ($tokens -join ' ').Trim()"
    ]

  s09-alpha-normalize-type-vars : List ShellCmd =
    [ ScRaw "$varMap = @{}"
    , ScAssign "nextIdx" (SeInt 0)
    , ScRaw "$knownTypes = @('in','if','of','is','act','end','qed')"
    , ScRaw "$tokens = [regex]::Matches($sig, '\\b([a-z]\\d*)\\b|.')"
    , ScRaw "$sb = [System.Text.StringBuilder]::new()"
    , ScForEach "tok" (SeVar "tokens") s09-each-tokens
    , ScRaw "return $sb.ToString()"
    ]

  s09-each-tokens : List ShellCmd =
    [ ScRaw "$full = $tok.Value"
    , ScRaw "if ($full.Length -eq 1 -and [char]::IsLower($full[0]) -and $full -notin $knownTypes) {"
    , ScIndent s09-full-length-char-lower
    , ScRaw "} elseif ($full -match '^[a-z]\\d+$' -and $full -notin $knownTypes) {"
    , ScIndent s09-full-notin-known-types
    , ScRaw "} else {"
    , ScIndent [ScRaw "[void]$sb.Append($full)"]
    , ScRaw "}"
    ]

  s09-full-length-char-lower : List ShellCmd =
    [ ScRaw "if (-not $varMap.ContainsKey($full)) { $varMap[$full] = \"t$nextIdx\"; $nextIdx++ }"
    , ScRaw "[void]$sb.Append($varMap[$full])"
    ]

  s09-full-notin-known-types : List ShellCmd =
    [ ScRaw "if (-not $varMap.ContainsKey($full)) { $varMap[$full] = \"t$nextIdx\"; $nextIdx++ }"
    , ScRaw "[void]$sb.Append($varMap[$full])"
    ]

Section: S10 -- Parse Phase

  s10-body : List ShellCmd =
    [ ScBlank
    , ScComment "Parse"
    , ScAssign "r0" (SeRaw "Parse-Stage0 $sourceText")
    , ScAssign "s0Chapters" (SeRaw "$r0[0]")
    , ScAssign "slugs" (SeRaw "$r0[1]")
    , ScAssign "slugsSorted" (SeRaw "$slugs.ToArray() | Sort-Object { $_.Length } -Descending")
    , ScBlank
    , ScForEach "ch" (SeArrayLiteral [SeProperty (SeVar "s0Chapters") "Keys"]) s10-ch-s0-chapters-keys
    , ScBlank
    , ScAssign "s1Defs" (SeAsArray (SeRaw "Parse-Stage1 $stage1Text"))
    ]

  s10-ch-s0-chapters-keys : List ShellCmd =
    [ ScRaw "$defs = $s0Chapters[$ch]"
    , ScForLoop "di" (SeInt 0) (SeBare (SeIntLt (SeVar "di") (SeProperty (SeVar "defs") "Count"))) (SePostIncrement "di") s10-di-defs-count
    ]

  s10-di-defs-count : List ShellCmd =
    [ ScRaw "$dm = Demangle-Name $defs[$di].Name $slugsSorted"
    , ScRaw "if ($dm -and $dm[0] -eq $ch) { $defs[$di].Name = $dm[1] }"
    ]

Section: S11 -- Match Phase

  s11-body : List ShellCmd =
    [ ScBlank
    , ScComment "Build collision set"
    , ScAssign "nameToChapters" SeHashLiteral
    , ScForEach "ch" (SeProperty (SeVar "s0Chapters") "Keys") s11-ch-s0-chapters-keys
    , ScAssign "colliding" (SeRaw "@($nameToChapters.Keys | Where-Object { $nameToChapters[$_].Count -gt 1 })")
    , ScBlank
    , ScComment "Assign chapters to stage1 defs"
    , ScAssign "nameToChapter" SeHashLiteral
    , ScForEach "ch" (SeProperty (SeVar "s0Chapters") "Keys") s11-ch-s0-chapters-keys-2
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeProperty (SeVar "s1Defs") "Count"))) (SePostIncrement "i") s11-i-s1-defs-count
    , ScBlank
    , ScComment "Match"
    , ScAssign "s1ByKey" SeHashLiteral
    , ScForEach "d" (SeVar "s1Defs") s11-each-s1-defs
    , ScBlank
    , ScDotNetCallAssign "matched" "System.Collections.Generic.List[object]" "new" []
    , ScDotNetCallAssign "dropped" "System.Collections.Generic.List[object]" "new" []
    , ScAssign "s0Keys" SeHashLiteral
    , ScForEach "ch" (SeProperty (SeVar "s0Chapters") "Keys") s11-ch-s0-chapters-keys-3
    , ScAssign "extra" (SeRaw "@($s1Defs | Where-Object { -not $s0Keys.ContainsKey(\"$($_.Chapter)|$($_.Name)\") })")
    ]

  s11-ch-s0-chapters-keys : List ShellCmd =
    [ ScForEach "d" (SeIndex (SeVar "s0Chapters") (SeVar "ch")) s11-d-s0-chapters-ch
    ]

  s11-d-s0-chapters-ch : List ShellCmd =
    [ ScRaw "if (-not $nameToChapters.ContainsKey($d.Name)) { $nameToChapters[$d.Name] = @() }"
    , ScRaw "$nameToChapters[$d.Name] += $ch"
    ]

  s11-ch-s0-chapters-keys-2 : List ShellCmd =
    [ ScForEach "d" (SeIndex (SeVar "s0Chapters") (SeVar "ch")) s11-d-s0-chapters-ch-2
    ]

  s11-d-s0-chapters-ch-2 : List ShellCmd =
    [ ScRaw "if ($d.Name -notin $colliding -and -not $nameToChapter.ContainsKey($d.Name)) {"
    , ScIndent [ScRaw "$nameToChapter[$d.Name] = $ch"]
    , ScRaw "}"
    ]

  s11-i-s1-defs-count : List ShellCmd =
    [ ScRaw "$d = $s1Defs[$i]"
    , ScRaw "$dm = Demangle-Name $d.Name $slugsSorted"
    , ScRaw "if ($dm) { $d.Name = $dm[1]; $d.Chapter = $dm[0] }"
    , ScRaw "elseif ($nameToChapter.ContainsKey($d.Name)) { $d.Chapter = $nameToChapter[$d.Name] }"
    , ScRaw "else { $d.Chapter = '?' }"
    ]

  s11-each-s1-defs : List ShellCmd =
    [ ScRaw "$key = \"$($d.Chapter)|$($d.Name)\""
    , ScRaw "if (-not $s1ByKey.ContainsKey($key)) { $s1ByKey[$key] = $d }"
    ]

  s11-ch-s0-chapters-keys-3 : List ShellCmd =
    [ ScForEach "s0" (SeIndex (SeVar "s0Chapters") (SeVar "ch")) s11-s0-chapters-ch
    ]

  s11-s0-chapters-ch : List ShellCmd =
    [ ScRaw "$key = \"$ch|$($s0.Name)\""
    , ScRaw "$s0Keys[$key] = $true"
    , ScRaw "if ($s1ByKey.ContainsKey($key)) { $matched.Add(@($s0, $s1ByKey[$key])) }"
    , ScRaw "else { $dropped.Add($s0) }"
    ]

Section: S12 -- Resolve Colliding Defs

  s12-body : List ShellCmd =
    [ ScBlank
    , ScComment "Resolve colliding defs by body/sig match"
    , ScAssign "extraByName" SeHashLiteral
    , ScForEach "d" (SeVar "extra") s12-each-extra
    , ScDotNetCallAssign "resolvedExtra" "System.Collections.Generic.HashSet[object]" "new" []
    , ScAssign "resolvedDropped" (SeArrayLiteral [])
    , ScForEach "s0" (SeVar "dropped") s12-each-dropped
    , ScDotNetCallAssign "dropped" "System.Collections.Generic.List[object]" "new" [SeRaw "@($dropped | Where-Object { $_ -notin $resolvedDropped })"]
    , ScAssign "extra" (SeRaw "@($extra | Where-Object { -not $resolvedExtra.Contains($_) })")
    ]

  s12-each-extra : List ShellCmd =
    [ ScRaw "if ($d.Chapter -ne '?') { continue }"
    , ScRaw "if (-not $extraByName.ContainsKey($d.Name)) { $extraByName[$d.Name] = [System.Collections.Generic.List[object]]::new() }"
    , ScRaw "$extraByName[$d.Name].Add($d)"
    ]

  s12-each-dropped : List ShellCmd =
    [ ScRaw "if (-not $extraByName.ContainsKey($s0.Name)) { continue }"
    , ScRaw "$body0 = Collapse-Whitespace (Demangle-Names $s0.Body $slugsSorted)"
    , ScAssign "bestMatch" (SeVar "null")
    , ScForEach "s1" (SeIndex (SeVar "extraByName") (SeProperty (SeVar "s0") "Name")) s12-s1-extra-by-name
    , ScIf (SeBare (SeNot (SeVar "bestMatch"))) s12-if-not-best []
    , ScIf (SeVar "bestMatch") s12-if-best []
    ]

  s12-s1-extra-by-name : List ShellCmd =
    [ ScRaw "if ($resolvedExtra.Contains($s1)) { continue }"
    , ScRaw "$body1 = Collapse-Whitespace (Demangle-Names $s1.Body $slugsSorted)"
    , ScRaw "if ($body0 -eq $body1) { $bestMatch = $s1; break }"
    ]

  s12-if-not-best : List ShellCmd =
    [ ScRaw "$sig0 = Alpha-NormalizeTypeVars $s0.Sig"
    , ScForEach "s1" (SeIndex (SeVar "extraByName") (SeProperty (SeVar "s0") "Name")) s12-s1-extra-by-name-2
    ]

  s12-s1-extra-by-name-2 : List ShellCmd =
    [ ScRaw "if ($resolvedExtra.Contains($s1)) { continue }"
    , ScRaw "if ($sig0 -eq (Alpha-NormalizeTypeVars $s1.Sig)) { $bestMatch = $s1; break }"
    ]

  s12-if-best : List ShellCmd =
    [ ScRaw "$bestMatch.Chapter = $s0.Chapter"
    , ScRaw "$matched.Add(@($s0, $bestMatch))"
    , ScRaw "$resolvedDropped += $s0"
    , ScRaw "[void]$resolvedExtra.Add($bestMatch)"
    ]

Section: S13 -- Compare Phase

  s13-body : List ShellCmd =
    [ ScBlank
    , ScComment "Compare"
    , ScRaw "$bodyMatches = 0; $bodyMismatches = 0; $emptyBodies = 0"
    , ScRaw "$sigMatches = 0; $sigMismatches = 0"
    , ScDotNetCallAssign "bodyMismatchList" "System.Collections.Generic.List[string]" "new" []
    , ScDotNetCallAssign "emptyBodyList" "System.Collections.Generic.List[string]" "new" []
    , ScBlank
    , ScForEach "pair" (SeVar "matched") s13-each-matched
    ]

  s13-each-matched : List ShellCmd =
    [ ScRaw "$s0 = $pair[0]; $s1 = $pair[1]"
    , ScRaw "$normSig0 = Alpha-NormalizeTypeVars ($s0.Sig -replace ',\\s*', ' -> ')"
    , ScRaw "$normSig1 = Alpha-NormalizeTypeVars ($s1.Sig -replace ',\\s*', ' -> ')"
    , ScIfLine (SeBare (SeIntEq (SeVar "normSig0") (SeVar "normSig1"))) [ScIncrement "sigMatches"] [ScIncrement "sigMismatches"]
    , ScBlank
    , ScRaw "$b0 = Collapse-Whitespace (Demangle-Names $s0.Body $slugsSorted)"
    , ScRaw "$b1 = Collapse-Whitespace (Demangle-Names $s1.Body $slugsSorted)"
    , ScIfLine (SeBare (SeIntEq (SeVar "b0") (SeVar "b1"))) [ScIncrement "bodyMatches"] []
    , ScRaw "elseif ($b0.Length -eq 0) {"
    , ScIndent s13-b0-length
    , ScRaw "}"
    , ScRaw "else {"
    , ScIndent s13-block
    , ScRaw "}"
    ]

  s13-b0-length : List ShellCmd =
    [ ScIncrement "emptyBodies"
    , ScRaw "$emptyBodyList.Add(\"$($s0.Chapter): $($s0.Name) (line $($s0.LineNo))\")"
    ]

  s13-block : List ShellCmd =
    [ ScIncrement "bodyMismatches"
    , ScRaw "$bodyMismatchList.Add(\"$($s0.Chapter): $($s0.Name)\")"
    , ScRaw "if ($Show -and ($s0.Name -eq $Show -or \"$($s0.Chapter): $($s0.Name)\" -eq $Show)) {"
    , ScIndent s13-show-s0-name
    , ScRaw "}"
    ]

  s13-show-s0-name : List ShellCmd =
    [ ScRaw "$t0 = $b0 -split ' '; $t1 = $b1 -split ' '"
    , ScRaw "$lim = [Math]::Min($t0.Count, $t1.Count); $d = -1"
    , ScRaw "for ($k = 0; $k -lt $lim; $k++) { if ($t0[$k] -ne $t1[$k]) { $d = $k; break } }"
    , ScRaw "if ($d -lt 0) { $d = $lim }"
    , ScEcho (SeText "--- $($s0.Chapter): $($s0.Name) ---")
    , ScEcho (SeText "first differing token: $d  (source $($t0.Count) tokens, stage1 $($t1.Count))")
    , ScRaw "$lo = [Math]::Max(0, $d - 8)"
    , ScEcho (SeText "  source: $(($t0[$lo..([Math]::Min($t0.Count - 1, $d + 8))]) -join ' ')")
    , ScEcho (SeText "  stage1: $(($t1[$lo..([Math]::Min($t1.Count - 1, $d + 8))]) -join ' ')")
    ]

Section: S14 -- Verdict

  s14-body : List ShellCmd =
    let show-dropped = [ScEcho (SeLit "Dropped:"), ScForEach "d" (SeVar "dropped") [ScEcho (SeText "  $($d.Chapter): $($d.Name) (line $($d.LineNo))")]]
    in let show-mismatches = [ScEcho (SeLit "Body mismatches:"), ScForEach "m" (SeVar "bodyMismatchList") [ScEcho (SeText "  $m")]]
    in let show-empty = [ScEcho (SeLit "Empty source bodies (this script's own parser captured no body for the definition; not a compiler mismatch):"), ScForEach "m" (SeVar "emptyBodyList") [ScEcho (SeText "  $m")]]
    in let count-defs = [ScAssign "totalS0" (SeInt 0), ScForEach "k" (SeAsArray (SeProperty (SeVar "s0Chapters") "Keys")) [ScRaw "$totalS0 += @($s0Chapters[$k]).Count"]]
    in let fail-body = [ScSequence count-defs, ScEcho (SeLit "=== Semantic Equivalence FAIL ==="), ScEcho (SeText "Source: $totalS0 defs  Stage1: $($s1Defs.Count) defs  Matched: $($matched.Count)"), ScEcho (SeText "Dropped: $($dropped.Count)  Body mismatches: $bodyMismatches  Empty source bodies: $emptyBodies"), ScIf (SeBare (SeIntGt (SeProperty (SeVar "dropped") "Count") (SeInt 0))) show-dropped [], ScIf (SeBare (SeIntGt (SeProperty (SeVar "bodyMismatchList") "Count") (SeInt 0))) show-mismatches [], ScIf (SeBare (SeIntGt (SeProperty (SeVar "emptyBodyList") "Count") (SeInt 0))) show-empty []]
    in [ScBlank, ScComment "Verdict", ScAssign "pass" (SeRaw "$dropped.Count -eq 0 -and $bodyMismatches -eq 0 -and $emptyBodies -eq 0"), ScBlank, ScIf (SeNot (SeVar "pass")) fail-body [], ScBlank, ScRaw "exit $(if ($pass) { 0 } else { 1 })"]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "strict mode and the two texts being compared", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "the semdef class", ps-why = "one definition's identity, signature and body, which is the unit the whole comparison is over", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s02b : PipeStage = PipeStage { ps-name = "canonicalize-typename", ps-why = "two spellings of one type must compare equal, or every definition using either looks changed", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02b-body }

  s03 : PipeStage = PipeStage { ps-name = "parse-onedef", ps-why = "one definition out of a chapter, shared by both sides of the comparison", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "parse-stage0", ps-why = "read the SOURCE side, which is the text a person wrote", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "parse-stage1", ps-why = "read the EMITTED side, which the compiler produced and which is mangled and reordered", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "demangle names", ps-why = "the emitter's names carry chapter slugs the source's do not, so nothing matches until they are undone", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  s07 : PipeStage = PipeStage { ps-name = "operator precedence helpers", ps-why = "the scope keywords a body's structure is read by", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s07-body }

  s08 : PipeStage = PipeStage { ps-name = "find-matchingclose and strip-redundantparens", ps-why = "parenthesisation the emitter adds and the source omits is not a semantic difference, and treating it as one drowns the real ones", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s08-body }

  s09 : PipeStage = PipeStage { ps-name = "normalize and collapse", ps-why = "operator aliases folded to one spelling on both sides", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s09-body }

  s10 : PipeStage = PipeStage { ps-name = "parse phase", ps-why = "both sides read into SemDefs", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s10-body }

  s11 : PipeStage = PipeStage { ps-name = "match phase", ps-why = "pair each source definition with its emitted counterpart, and collect the names that pair ambiguously", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s11-body }

  s12 : PipeStage = PipeStage { ps-name = "resolve colliding defs", ps-why = "an ambiguous name is settled by body and signature rather than left as a difference, because a collision is a limitation of the matcher and not a finding about the compiler", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s12-body }

  s13 : PipeStage = PipeStage { ps-name = "compare phase", ps-why = "the paired bodies against each other", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s13-body }

  s14 : PipeStage = PipeStage { ps-name = "verdict", ps-why = "the run passes only when NOTHING was dropped and nothing differs; a dropped definition is a definition the comparison never looked at, which is a hole and not a pass", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s14-body }

  sem-pipe : Pipeline = Pipeline { pl-name = "compare-codex-semantic", pl-doc = "Semantic equivalence check between source Codex and stage1 emitter output", pl-params = sem-params, pl-stages = [PsStage s01, PsStage s02, PsStage s02b, PsStage s03, PsStage s04, PsStage s05, PsStage s06, PsStage s07, PsStage s08, PsStage s09, PsStage s10, PsStage s11, PsStage s12, PsStage s13, PsStage s14] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell sem-pipe))
  end

Page 1
