Chapter: LintUnusedCitesScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  lint-params : List ShellParam = [sh-param-optional "Src" SptString, sh-switch "All"]

Section: S01 -- Preamble

  cite-pattern : Text = "^\\s*cites\\s+(\\w+)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_-]*)"

  def-pattern : Text = "^\\s{2}(\\S+)\\s*[:=(|]"

  type-def-pattern : Text = "^\\s{2}([A-Z][A-Za-z0-9]*)\\s*[=(]"

  prose-pattern : Text = "^ [^ ]"

  ctor-pattern : Text = "^\\s+\\|\\s*([A-Z][A-Za-z0-9_-]*)"

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScRunDot (SePathJoin SeScriptRoot (SeLit "quire-map.ps1")), ScBlank, ScAssign "CitePat" (SeLit cite-pattern), ScAssign "DefPat" (SeLit def-pattern), ScAssign "TypeDefPat" (SeLit type-def-pattern), ScAssign "ProsePat" (SeLit prose-pattern), ScAssign "CtorPat" (SeLit ctor-pattern)]

Section: S02 -- Get-ChapterDefs

  add-match : ShellCmd = ScDiscard (SeMethodCall (SeVar "names") "Add" [SeIndex (SeVar "matches") (SeInt 1)])

  defs-loop : List ShellCmd = [ScIf (SeMatchExpr (SeVar "line") (SeVar "DefPat")) [add-match] [], ScIf (SeMatchExpr (SeVar "line") (SeVar "TypeDefPat")) [add-match] [], ScIf (SeMatchExpr (SeVar "line") (SeVar "CtorPat")) [add-match] []]

  defs-body : List ShellCmd = [ScAssign "names" (SeStaticCall "System.Collections.Generic.HashSet[string]" "new" []), ScForEach "line" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "Path"]) defs-loop, ScReturn (SeVar "names")]

  s02 : List ShellCmd = [ScFunction "Get-ChapterDefs" [sh-param-optional "Path" SptString] defs-body]

Section: S03 -- The Code-Only Text

  code-loop : List ShellCmd = [ScIf (SeMatchExpr (SeVar "line") (SeVar "ProsePat")) [ScContinue] [], ScIf (SeMatchExpr (SeVar "line") (SeVar "CitePat")) [ScContinue] [], ScDiscard (SeMethodCall (SeVar "code") "AppendLine" [SeVar "line"])]

  code-text : List ShellCmd = [ScAssign "lines" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "FilePath"]), ScAssign "code" (SeStaticCall "System.Text.StringBuilder" "new" []), ScForEach "line" (SeVar "lines") code-loop, ScAssign "body" (SeMethodCall (SeVar "code") "ToString" [])]

Section: S04 -- Lint-File

  rel-path : ShellExpr = SeSubstringFrom (SeVar "FilePath") (SeAdd (SeTextLength (SeVar "Repo")) (SeInt 1))

  lint-prelude : List ShellCmd = [ScAssign "relPath" (SeVar "FilePath"), ScIf (SeStartsWith (SeVar "FilePath") (SeVar "Repo")) [ScAssign "relPath" rel-path] [], ScAssign "warnings" (SeInt 0), ScAssign "lineNum" (SeInt 0)]

  used-loop : List ShellCmd = [ScIf (SeIntLt (SeTextLength (SeVar "name")) (SeInt 2)) [ScContinue] [], ScIf (SeMethodCall (SeVar "body") "Contains" [SeVar "name"]) [ScAssign "used" (SeBool True), ScBreak] []]

  cited-path : ShellExpr = SePathJoin (SeVar "Repo") (SePathJoin (SeVar "dir") (SeConcat (SeVar "chapter") (SeLit ".codex")))

  w1 : ShellExpr = SeConcat (SeConcat (SeLit "  ") (SeVar "relPath")) (SeLit ":")

  w2 : ShellExpr = SeConcat (SeConcat w1 (SeVar "lineNum")) (SeLit ": unused cite: ")

  w3 : ShellExpr = SeConcat (SeConcat w2 (SeVar "quire")) (SeLit " chapter ")

  w4 : ShellExpr = SeConcat (SeConcat w3 (SeVar "chapter")) (SeLit " (")

  warn-message : ShellExpr = SeConcat (SeConcat w4 (SeVar "defCount")) (SeLit " defs, none referenced)")

  unused-test : ShellExpr = SeAnd (SeNot (SeVar "used")) (SeIntGt (SeVar "defCount") (SeInt 0))

  cite-body : List ShellCmd = [ScAssign "quire" (SeIndex (SeVar "matches") (SeInt 1)), ScAssign "chapter" (SeIndex (SeVar "matches") (SeInt 2)), ScAssign "dir" (SeIndex (SeVar "QuireDirs") (SeVar "quire")), ScIf (SeNot (SeVar "dir")) [ScContinue] [], ScAssign "citedPath" cited-path, ScIf (SeNot (SeFileExists (SeVar "citedPath"))) [ScContinue] [], ScAssign "defs" (SeCall "Get-ChapterDefs" [SeVar "citedPath"]), ScAssign "used" (SeBool False), ScForEach "name" (SeVar "defs") used-loop, ScAssign "defCount" (SeCount (SeVar "defs")), ScIf unused-test [ScEcho warn-message, ScIncrement "warnings"] []]

  scan-loop : List ShellCmd = [ScIncrement "lineNum", ScIf (SeMatchExpr (SeVar "line") (SeVar "CitePat")) cite-body []]

  lint-body-cmds : List ShellCmd = [ScSequence code-text, ScSequence lint-prelude, ScForEach "line" (SeVar "lines") scan-loop, ScReturn (SeVar "warnings")]

  s04 : List ShellCmd = [ScFunction "Lint-File" [sh-param-optional "FilePath" SptString] lint-body-cmds]

Section: S05 -- Main

  scan-dirs : ShellExpr = SeArrayLiteral [SeLit "codex\\compiler", SeLit "codex\\foreword", SeLit "codex\\os", SeLit "codex\\plugs", SeLit "apps"]

  single-mode : ShellCmd = ScIf (SeVar "Src") [ScAssign "totalWarnings" (SeCall "Lint-File" [SePathResolve (SeVar "Src")]), ScAssign "filesChecked" (SeInt 1)] []

  gather-loop : List ShellCmd = [ScAssign "fullDir" (SePathJoin (SeVar "Repo") (SeVar "dir")), ScIf (SeDirExists (SeVar "fullDir")) [ScIncrementBy "files" (SeListFiles (SeVar "fullDir") "*.codex" True)] []]

  lint-loop : List ShellCmd = [ScAssign "w" (SeCall "Lint-File" [SeProperty (SeVar "f") "FullName"]), ScIncrementBy "totalWarnings" (SeVar "w"), ScIncrement "filesChecked"]

  all-body : List ShellCmd = [ScAssign "files" (SeArrayLiteral []), ScForEach "dir" scan-dirs gather-loop, ScForEach "f" (SeVar "files") lint-loop]

  all-mode : ShellCmd = ScIf (SeAnd (SeNot (SeVar "Src")) (SeVar "All")) all-body []

  summary-head : ShellExpr = SeConcat (SeConcat (SeLit "Checked ") (SeVar "filesChecked")) (SeLit " files, ")

  summary : ShellExpr = SeConcat (SeConcat summary-head (SeVar "totalWarnings")) (SeLit " unused cites found.")

  s05 : List ShellCmd = [ScAssign "totalWarnings" (SeInt 0), ScAssign "filesChecked" (SeInt 0), ScBlank, single-mode, all-mode, ScBlank, ScEcho summary]

Section: Assembly

  lint-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  lint-script : ShellScript = sh-script "lint-unused-cites" "Detect unused cites in Codex source files" lint-params lint-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell lint-script)
  end

