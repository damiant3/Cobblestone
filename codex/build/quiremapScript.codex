     ScRaw "}"]

Section: S02 -- Cite patterns

  s02 : List ShellCmd =
    [ScRaw "function New-CitePattern {",
     ScRaw "    # Alternation sorted longest-first so 'Games' wins over 'Game'.",
     ScRaw "    #",
     ScRaw "    # This pattern is generated from the KEYS of $QuireDirs, so a cite to an",
     ScRaw "    # unregistered quire does not match it, is never walked, and is never",
     ScRaw "    # resolved: the chapter is silently left out of the unit and the author gets",
     ScRaw "    # a cascade of CDX3002 at every USE SITE and never once at the cite. That is",
     ScRaw "    # what $StrictCitePat below exists to stop, and it is what Resolve-CiteOrder",
     ScRaw "    # now uses by default.",
     ScRaw "    #",
     ScRaw "    # The two bundlers this was kept for no longer carry their own copies:",
     ScRaw "    # concat-codex-self.ps1 and plug-build-lib.ps1 both take $StrictCitePat",
     ScRaw "    # and $QuireDirs from here, so NOTHING in the tree calls",
     ScRaw "    # this any more. It is kept only as the explicit way to ask for the old",
     ScRaw "    # blind-to-unregistered behaviour, and there is no good reason to.",
     ScRaw "    # Where a bundler must admit fewer quires than the registry holds, that",
     ScRaw "    # is policy and belongs at its own call site as a filter over these keys",
     ScRaw "    # -- concat-codex-self's $libQuireNames is the worked example -- not as a",
     ScRaw "    # second pattern that reads the same text a different way.",
     ScRaw "    param([string[]]$ExtraQuires = @())",
     ScRaw "    $names = @($QuireDirs.Keys) + $ExtraQuires",
     ScRaw "    $alt = ($names | Sort-Object -Descending { $_.Length }) -join '|'",
     ScRaw "    return \"^\\s*cites\\s+($alt)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_-]*)\"",
     ScRaw "}",
     ScBlank,
     ScComment "The strict pattern takes the quire as any identifier rather than an",
     ScComment "alternation of the registered keys, which is the whole point: a cite naming a",
     ScComment "quire nobody registered now MATCHES, is walked, and fails loudly instead of",
     ScComment "vanishing. Three shapes it has to accept that the lenient one cannot:",
     ScComment "",
     ScComment "  cites Foreword chapter Sha256                     plain",
     ScComment "  cites Codex chapter Build Settings                a name with a SPACE",
     ScComment "  cites Codex chapter Build Settings (max-depth)    ...and a trailing note",
     ScComment "",
     ScComment "Real headers include 'AST Nodes', 'Build Settings' and 'Diagnostic Bag', and",
     ScComment "the convention annotates a cite with the definition it wanted. The lenient",
     ScComment "name capture stops at the space and reads that last line as name 'Build'.",
     ScRaw "$StrictCitePat = '^\\s*cites\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_ -]*?)\\s*(?:\\(.*)?$'",
     ScBlank,
     ScRaw "$CitePat = New-CitePattern"]

Section: S03 -- Cite key and presence seed

  s03 : List ShellCmd =
    [ScRaw "function Get-CiteKey {",
     ScRaw "    # Cites name a chapter two different ways and both are in the tree:",
     ScRaw "    # 'cites Common chapter ByteHelpers' is the FILE's name, while",
     ScRaw "    # 'cites Codex chapter Build Settings' is the HEADER's. The file is",
     ScRaw "    # ByteHelpers.codex holding 'Chapter: Byte Helpers', so neither form is",
     ScRaw "    # wrong and no lookup keyed on one of them finds the other. Comparing with",
     ScRaw "    # the spaces removed is what makes the two forms the same key.",
     ScRaw "    param([string]$Name)",
     ScRaw "    return ($Name -replace '\\s', '').ToLowerInvariant()",
     ScRaw "}",
     ScBlank,
     ScRaw "function Get-PresentChapterNames {",
     ScRaw "    # The presence seed, keyed on the bare chapter name.",
     ScRaw "    #",
     ScRaw "    # A cite is satisfied two ways, not one: the chapter is RESOLVED through the",
     ScRaw "    # registry, or it is already PRESENT in the unit because a bundler globbed",
     ScRaw "    # the directory it lives in and renamed its header to <Dir>--<Name>. The",
     ScRaw "    # compiler's own source is assembled that way -- concat-codex-self.ps1 globs",
     ScRaw "    # codex/compiler -- so 'cites Codex chapter Build Settings' is answered by",
     ScRaw "    # 'Chapter: Core--Build Settings' sitting in the same unit, and the registry",
     ScRaw "    # has no entry for 'Codex' at all and should not.",
     ScRaw "    #",
     ScRaw "    # This keys on the NAME and not on quire::name, which is the reason the",
     ScRaw "    # existing SeedSeen cannot do the job: concat renames by DIRECTORY (Core--)",
     ScRaw "    # while the cite names a QUIRE (Codex), so the two never share a key.",
     ScRaw "    param([string[]]$Lines)",
     ScRaw "    $present = @{}",
     ScRaw "    foreach ($l in $Lines) {",
     ScRaw "        if ($l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "            $full = $matches[1]",
     ScRaw "            $present[(Get-CiteKey $full)] = $true",
     ScRaw "            # 'Core--Build Settings' also answers to 'Build Settings'.",
     ScRaw "            $sep = $full.IndexOf('--')",
     ScRaw "            if ($sep -ge 0) { $present[(Get-CiteKey $full.Substring($sep + 2))] = $true }",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    return $present",
     ScRaw "}"]

Section: S04 -- Resolve-CiteOrder function

  s04 : List ShellCmd =
    [ScRaw "function Resolve-CiteOrder {",
     ScRaw "    # DFS post-order over the cite graph: a chapter's dependencies always",
     ScRaw "    # precede it in the returned list. BFS+Reverse is NOT a topological",
     ScRaw "    # order (CL 3644) -- do not reintroduce it.",
     ScRaw "    # Returns a list of @{ Quire; Name; Path; Lines }.",
     ScRaw "    param(",
     ScRaw "        [Parameter(Mandatory=$true)] [AllowEmptyString()] [AllowEmptyCollection()] [string[]]$RootLines,",
     ScRaw "        [string]$Repo = '.',",
     ScRaw "        [string]$Pattern = '',",
     ScRaw "        [hashtable]$SeedSeen = $null,",
     ScRaw "        [string[]]$ExcludeQuires = @(),",
     ScRaw "        [scriptblock]$PathOverride = $null,",
     ScRaw "        [hashtable]$PresentNames = @{},",
     ScRaw "        [ValidateSet('throw','skip')] [string]$OnMissing = 'throw'",
     ScRaw "    )",
     ScRaw "    if (-not $Pattern) { $Pattern = $StrictCitePat }",
     ScRaw "    $visited = @{}",
     ScRaw "    $visiting = @{}",
     ScRaw "    if ($SeedSeen) { foreach ($k in $SeedSeen.Keys) { $visited[$k] = $true } }",
     ScRaw "    # Chapters already in the unit satisfy a cite by being there. Seeded from",
     ScRaw "    # the root lines themselves, so a caller that bundles before it resolves",
     ScRaw "    # (the plugs, concat) needs no new argument and cannot forget to pass one.",
     ScRaw "    $present = Get-PresentChapterNames -Lines $RootLines",
     ScRaw "    foreach ($k in @($PresentNames.Keys)) { $present[(Get-CiteKey $k)] = $true }",
     ScRaw "    $excluded = @{}",
     ScRaw "    foreach ($q in $ExcludeQuires) { $excluded[$q] = $true }",
     ScRaw "    $ordered = [System.Collections.Generic.List[hashtable]]::new()",
     ScRaw "    $walk = $null",
     ScRaw "    $walk = {",
     ScRaw "        param([string]$quire, [string]$name)",
     ScRaw "        if ($excluded[$quire]) { return }",
     ScRaw "        $key = \"${quire}::${name}\"",
     ScRaw "        if ($visited[$key] -or $visiting[$key]) { return }",
     ScRaw "        $visiting[$key] = $true",
     ScRaw "        $path = $null",
     ScRaw "        if ($PathOverride) { $path = & $PathOverride $quire $name }",
     ScRaw "        if (-not $path) {",
     ScRaw "            $dir = $QuireDirs[$quire]",
     ScRaw "            if ($dir) { $path = Join-Path $Repo (Join-Path $dir \"$name.codex\") }",
     ScRaw "        }",
     ScRaw "        if (-not $path -or -not (Test-Path -PathType Leaf $path)) {",
     ScRaw "            $visiting.Remove($key)",
     ScRaw "            # Already in the unit: satisfied, and there is nothing to walk.",
     ScRaw "            if ($present[(Get-CiteKey $name)]) { $visited[$key] = $true; return }",
     ScRaw "            if ($OnMissing -eq 'skip') { $visited[$key] = $true; return }",
     ScRaw "            $why = if ($QuireDirs[$quire]) {",
     ScRaw "                \"quire '$quire' is registered as '$($QuireDirs[$quire])' but has no chapter '$name' (expected $path)\"",
     ScRaw "            } else {",
     ScRaw "                \"quire '$quire' is not registered in build/quire-map.ps1, and no chapter '$name' is present in the unit\"",
     ScRaw "            }",
     ScRaw "            throw \"Unresolvable cite: $quire chapter '$name' -- $why\"",
     ScRaw "        }",
     ScRaw "        $chLines = [System.IO.File]::ReadAllLines($path)",
     ScRaw "        foreach ($l in $chLines) {",
     ScRaw "            if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }",
     ScRaw "        }",
     ScRaw "        $visiting.Remove($key)",
     ScRaw "        $visited[$key] = $true",
     ScRaw "        $ordered.Add(@{ Quire = $quire; Name = $name; Path = $path; Lines = $chLines })",
     ScRaw "    }",
     ScRaw "    # The sugars' own dependencies, walked whether or not the source cites",
     ScRaw "    # them. `for x in xs -> ...` desugars to a call to `map-list`",
     ScRaw "    # (Foreword ListUtils) and a tuple literal or pattern to `MkTup<N>`",
     ScRaw "    # (Foreword Tuple). Both are names the DESUGARER writes, not the author,",
     ScRaw "    # so requiring the author to cite them made the language's own syntax",
     ScRaw "    # conditional on a line nobody could know to write: `for` without the",
     ScRaw "    # cite failed with `CDX3002: Undefined name: map-list`, and a tuple with",
     ScRaw "    # `CDX2002: Unknown name: MkTup2`.",
     ScRaw "    #",
     ScRaw "    # Unconditional rather than \"only if the source uses the sugar\" because",
     ScRaw "    # detecting use means parsing sugar with a regex, and getting that wrong",
     ScRaw "    # fails the same way this did. The two chapters are 141 lines and cite",
     ScRaw "    # nothing, so there is no cascade -- the cost is a fixed 5 KB per unit.",
     ScRaw "    #",
     ScRaw "    # A chapter that defines its own `map-list` still wins inside itself:",
     ScRaw "    # ChapterScoper mangles both sides of a collision per chapter, so a",
     ScRaw "    # mention resolves to its own chapter's. That is the same rule the register",
     ScRaw "    # 2.15 settled for builtins, and it is why this is safe to do for every",
     ScRaw "    # unit rather than only for units that would otherwise fail. It does",
     ScRaw "    # raise CDX3006 (a warning) where a unit now carries two definitions of",
     ScRaw "    # a name; `$present` and `$excluded` are both honoured, so a unit that",
     ScRaw "    # already bundles these chapters, or excludes the Foreword quire, is",
     ScRaw "    # untouched.",
     ScRaw "    foreach ($impl in @(@('Foreword','ListUtils'), @('Foreword','Tuple'))) {",
     ScRaw "        & $walk $impl[0] $impl[1]",
     ScRaw "    }",
     ScRaw "    foreach ($l in $RootLines) {",
     ScRaw "        if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }",
     ScRaw "    }",
     ScRaw "    return ,$ordered",
     ScRaw "}"]

Section: S05 -- Diagnostic line mapping

  s05 : List ShellCmd =
    [ScRaw "function Get-DiagRegions {",
     ScRaw "    # Maps a unit line number back to the file it came from.",
     ScRaw "    #",
     ScRaw "    # The compiler numbers diagnostics against the assembled UNIT -- every",
     ScRaw "    # cited chapter, then the source -- so a source line is reported at",
     ScRaw "    # (prelude + its own line). Every position a user sees in a file that",
     ScRaw "    # cites anything is wrong by however many lines its dependencies run to;",
     ScRaw "    # a cite-less file was right only by accident, because its unit was",
     ScRaw "    # itself. Measured: an error on line 11 of a file citing one foreword",
     ScRaw "    # chapter reported as 214:5.",
     ScRaw "    #",
     ScRaw "    # Both assemblers must map back or only one of them tells the truth --",
     ScRaw "    # compile.ps1 for a single compile and test-compile-batch.ps1 for the",
     ScRaw "    # battery, which builds its own unit and writes its own build.log. That",
     ScRaw "    # is why this lives here rather than in either of them.",
     ScRaw "    #",
     ScRaw "    # Format-CiteChapters replaces a chapter's `Chapter:` line one-for-one",
     ScRaw "    # and appends two blank lines, so an entry occupies Lines.Count + 2.",
     ScRaw "    param([Parameter(Mandatory=$true)] $Ordered, [Parameter(Mandatory=$true)] [string]$SrcPath)",
     ScRaw "    $regions = [System.Collections.Generic.List[hashtable]]::new()",
     ScRaw "    $cum = 0",
     ScRaw "    foreach ($entry in $Ordered) {",
     ScRaw "        $n = $entry.Lines.Count + 2",
     ScRaw "        [void]$regions.Add(@{ Start = $cum + 1; End = $cum + $n; File = $entry.Path })",
     ScRaw "        $cum += $n",
     ScRaw "    }",
     ScRaw "    [void]$regions.Add(@{ Start = $cum + 1; End = [int]::MaxValue; File = $SrcPath })",
     ScRaw "    return ,$regions",
     ScRaw "}",
     ScBlank,
     ScRaw "function Convert-DiagLine {",
     ScRaw "    # `<unit-line>:<col>: ...` becomes `<file>:<file-line>:<col>: ...`.",
     ScRaw "    # Anything without a position prefix passes through untouched, so",
     ScRaw "    # protocol lines (SIZE:, HEAP:, !EXC, MAP:) are unaffected.",
     ScRaw "    param([string]$Line, $Regions)",
     ScRaw "    if ($Regions -and $Line -match '^(\\d+):(\\d+):(.*)$') {",
     ScRaw "        $ul = [int]$matches[1]; $col = $matches[2]; $rest = $matches[3]",
     ScRaw "        foreach ($r in $Regions) {",
     ScRaw "            if ($ul -ge $r.Start -and $ul -le $r.End) {",
     ScRaw "                return \"$($r.File):$($ul - $r.Start + 1):${col}:$rest\"",
     ScRaw "            }",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    return $Line",
     ScRaw "}"]

Section: S06 -- Format-CiteChapters function

  s06 : List ShellCmd =
    [ScRaw "function Format-CiteChapters {",
     ScRaw "    # Renders resolved chapters as concatenation-ready lines, renaming",
     ScRaw "    # each header to `Chapter: Quire--Name` to avoid collisions.",
     ScRaw "    param([Parameter(Mandatory=$true)] $Ordered)",
     ScRaw "    $out = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($entry in $Ordered) {",
     ScRaw "        $renamed = $false",
     ScRaw "        foreach ($l in $entry.Lines) {",
     ScRaw "            if ((-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "                $out.Add(\"Chapter: $($entry.Quire)--$($matches[1])\")",
     ScRaw "                $renamed = $true",
     ScRaw "            } else { $out.Add($l) }",
     ScRaw "        }",
     ScRaw "        $out.Add(''); $out.Add('')",
     ScRaw "    }",
     ScRaw "    return ,$out",
     ScRaw "}"]

Section: Assembly

  quiremap-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06]

  quiremap-script : ShellScript = sh-script "quire-map" "Single quire registry and cite resolver" [] quiremap-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell quiremap-script)
  end

