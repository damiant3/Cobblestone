Chapter: QuireMapScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

 We say:

Section: S01 -- QuireDirs hashtable

  s01-body : List ShellCmd =
    [ScComment "The single quire registry and cite resolver. Dot-source this file;",
     ScComment "never copy the map. Every script that resolves",
     ScComment "  cites <Quire> chapter <Name>",
     ScComment "(bundlers, compile, test batch, plug builds, linters) must take",
     ScComment "$QuireDirs and $CitePat from here.",
     ScComment "Add new quires HERE and nowhere else. Paths are repo-relative.",
     ScBlank,
     ScRaw "$QuireDirs = @{",
     ScRaw "    'Foreword' = 'codex\\foreword\\core'; 'Kernel' = 'codex\\os\\kernel'; 'OS' = 'codex\\os\\core'",
     ScRaw "    'Works' = 'apps\\works'; 'Trust' = 'codex\\os\\trust'; 'Net' = 'codex\\os\\net'",
     ScRaw "    'Verify' = 'codex\\os\\verify'; 'Replay' = 'codex\\os\\replay'; 'Sched' = 'codex\\os\\sched'",
     ScIndent [ScComment "Wflow, not Workflow: 'Workflow' is apps\\workflow, a different quire. The"],
     ScIndent [ScComment "cites have always said Wflow; what was missing was this line, so every"],
     ScIndent [ScComment "chapter they name was silently left out of the unit and the author got"],
     ScIndent [ScComment "CDX3002 at the use sites instead."],
     ScRaw "    'Wflow' = 'codex\\workflow'; 'Tracker' = 'codex\\tracker'",
     ScRaw "    'Observe' = 'codex\\os\\observe'; 'Game' = 'codex\\foreword\\game'",
     ScRaw "    'Signal' = 'codex\\foreword\\signal'; 'Compress' = 'codex\\foreword\\compress'",
     ScRaw "    'Encode' = 'codex\\foreword\\encode'; 'Math' = 'codex\\foreword\\math'",
     ScRaw "    'Sim' = 'codex\\foreword\\sim'; 'AI' = 'codex\\foreword\\ai'",
     ScRaw "    'Engine' = 'codex\\foreword\\engine'",
     ScRaw "    'Punctual' = 'codex\\foreword\\punctual'",
     ScRaw "    'Gpu' = 'codex\\foreword\\gpu'; 'Shell' = 'codex\\foreword\\shell'",
     ScRaw "    'UI' = 'codex\\foreword\\ui'; 'Dev' = 'codex\\os\\dev'",
     ScRaw "    'Magic' = 'apps\\games\\magic'; 'Games' = 'apps\\games\\classic'",
     ScRaw "    'Spark' = 'apps\\spark'; 'Data' = 'apps\\data'",
     ScRaw "    'Sheets' = 'apps\\sheets'",
     ScRaw "    'Prism' = 'apps\\prism'; 'Valheim' = 'apps\\modbuilder\\mods\\valheim'",
     ScRaw "    'ModBuilder' = 'apps\\modbuilder\\native'",
     ScRaw "    'Csharp' = 'codex\\plugs\\csharp'",
     ScRaw "    'Pe' = 'codex\\plugs\\pe'",
     ScRaw "    'Sass' = 'codex\\plugs\\sass'",
     ScRaw "    'WaDemo' = 'apps\\wademo'",
     ScRaw "    'Diffusion' = 'apps\\diffusion'",
     ScRaw "    'Explorer' = 'apps\\explorer'; 'FontExplorer' = 'apps\\fontexplorer'",
     ScRaw "    'CodexMagic' = 'apps\\games\\codexmagic'",
     ScRaw "    'Mathbook' = 'apps\\mathbook'",
     ScRaw "    'Cvmm' = 'apps\\cvmm'",
     ScRaw "    'Nettool' = 'apps\\nettool'",
     ScRaw "    'Browser' = 'apps\\browser'",
     ScRaw "    'FileShare' = 'apps\\fileshare'",
     ScRaw "    'Chat' = 'apps\\chat'",
     ScRaw "    'Designer' = 'apps\\designer'",
     ScRaw "    'Diagram' = 'apps\\diagram'",
     ScRaw "    'Secrets' = 'apps\\secrets'",
     ScRaw "    'MobileApp' = 'apps\\codexmagic-mobile'",
     ScRaw "    'Starmap' = 'apps\\starmap'",
     ScRaw "    'Globe' = 'apps\\globe'",
     ScRaw "    'Safari' = 'apps\\safari\\port'",
     ScRaw "    'Judge' = 'apps\\safari\\judge'",
     ScRaw "    'Gold' = 'apps\\safari\\gold'",
     ScRaw "    'Radio' = 'apps\\radio'",
     ScRaw "    'Mail' = 'apps\\mail'",
     ScRaw "    'Music' = 'apps\\music'",
     ScRaw "    'Photos' = 'apps\\photos'",
     ScRaw "    'Notes' = 'apps\\notes'",
     ScRaw "    'Tasks' = 'apps\\tasks'",
     ScRaw "    'Weather' = 'apps\\weather'",
     ScRaw "    'Calendar' = 'apps\\calendar'",
     ScRaw "    'Maps' = 'apps\\maps'",
     ScRaw "    'News' = 'apps\\news'",
     ScRaw "    'Podcasts' = 'apps\\podcasts'",
     ScRaw "    'Books' = 'apps\\books'",
     ScRaw "    'Recorder' = 'apps\\recorder'",
     ScRaw "    'Capture' = 'apps\\capture'",
     ScRaw "    'Publisher' = 'apps\\publisher'",
     ScRaw "    'ImageTools' = 'apps\\imagetools'",
     ScRaw "    'Fitness' = 'apps\\fitness'",
     ScRaw "    'Pomodoro' = 'apps\\pomodoro'",
     ScRaw "    'Piano' = 'apps\\piano'",
     ScRaw "    'Markets' = 'apps\\markets'",
     ScRaw "    'FishTank' = 'apps\\fishtank'",
     ScRaw "    'Helm' = 'apps\\helm'",
     ScRaw "    'Colophon' = 'apps\\colophon'",
     ScRaw "    'WebApp' = 'apps\\webapp'",
     ScRaw "    'ERP' = 'apps\\erp'",
     ScRaw "    'Vision' = 'apps\\vision'",
     ScRaw "    'Collab' = 'apps\\collab'",
     ScRaw "    'Services' = 'apps\\services'; 'Accounts' = 'apps\\services\\accounts'",
     ScRaw "    'Market' = 'apps\\market'",
     ScRaw "    'Workflow' = 'apps\\workflow'",
     ScRaw "    'Site' = 'apps\\site'",
     ScRaw "    'Lens' = 'apps\\lens'",
     ScRaw "    'Boards' = 'codex\\boards'",
     ScRaw "    'Product' = 'codex\\product'",
    ScRaw "    'Build' = 'codex\\build'",
     ScRaw "    'Mesh' = 'apps\\edgemesh'",
     ScRaw "    'Water' = 'shaders\\water'",
     ScRaw "    'Clouds' = 'shaders\\clouds'",
     ScRaw "    'Terrain' = 'shaders\\terrain'",
     ScRaw "    'Reflect' = 'shaders\\reflect'",
     ScRaw "    'Guios' = 'apps\\guios'",
     ScRaw "    'C64' = 'apps\\c64'",
     ScRaw "    'Ideas' = 'apps\\ideas'",
     ScIndent [ScComment "'Circuits' is the Core sub-quire. The chapters at the circuits ROOT"],
     ScIndent [ScComment "(CanvasModel, CircuitsTheme, CircuitsUI, ViewState, ...) are the app"],
     ScIndent [ScComment "shell and had no quire at all, so opening.codex could not cite them"],
     ScIndent [ScComment "and every name they define reported CDX3002 at the use site."],
     ScRaw "    'CircuitsApp' = 'apps\\circuits'",
     ScRaw "    'Circuits' = 'apps\\circuits\\Core'",
     ScRaw "    'CircuitsSch' = 'apps\\circuits\\SchematicEditor'",
     ScRaw "    'CircuitsSym' = 'apps\\circuits\\SymbolEditor'",
     ScRaw "    'CircuitsSim' = 'apps\\circuits\\Simulator'",
     ScRaw "    'CircuitsPcb' = 'apps\\circuits\\PcbEditor'",
     ScRaw "    'CircuitsFp' = 'apps\\circuits\\FootprintEditor'",
     ScRaw "    'CircuitsBv' = 'apps\\circuits\\BoardViewer'",
     ScRaw "    'CircuitsMfg' = 'apps\\circuits\\Manufacturing'",
     ScIndent [ScComment "The diagnostic ladder and its stage chapters (DiagnosticStick.md):"],
     ScIndent [ScComment "a stage is a chapter under build\\boot\\diag cited as Diag chapter X."],
     ScRaw "    'Diag' = 'build\\boot\\diag'",
    ScRaw "}",
    ScSetIndex "QuireDirs" (SeLit "Accp") (SeLit "apps\\accp"),
    ScSetIndex "QuireDirs" (SeLit "Uoaix") (SeLit "apps\\uoaix"),
    ScBlank,
    ScComment "A QUIRE IS A DIRECTORY OR A MANIFEST. A directory quire resolves a cite to",
    ScComment "<dir>\\<chapter name>.codex, one file per chapter, which every quire above",
    ScComment "keeps exactly. The compiler cannot be reached that way and is the tree's only",
    ScComment "exception: 24 of its 65 files carry a base name different from their Chapter:",
    ScComment "line, and four chapters span several files each, X86-64 Code Generator over",
    ScComment "fourteen. It is also only ever consumed WHOLE and in one order, so there is",
    ScComment "nothing a per-chapter path would buy. A cite of any chapter in a manifest",
    ScComment "quire therefore pulls the entire ordered unit the manifest names, once,",
    ScComment "minus that unit's own entry chapter, which a consumer supplies itself.",
    ScComment "build/compiler-order.txt is that order and refuses to drift from the",
    ScComment "directory it describes.",
    ScRaw "$QuireManifests = @{",
    ScRaw "    'Codex' = 'build\\compiler-order.txt'",
    ScRaw "    'Emit' = 'build\\compiler-order.txt'",
    ScRaw "    'Semantics' = 'build\\compiler-order.txt'",
    ScRaw "}"]

Section: S02 -- Cite patterns

  s02-body : List ShellCmd =
    [ScBlank, ScRaw "function New-CitePattern {",
     ScIndent [ScComment "Alternation sorted longest-first so 'Games' wins over 'Game'."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "This pattern is generated from the KEYS of $QuireDirs, so a cite to an"],
     ScIndent [ScComment "unregistered quire does not match it, is never walked, and is never"],
     ScIndent [ScComment "resolved: the chapter is silently left out of the unit and the author gets"],
     ScIndent [ScComment "a cascade of CDX3002 at every USE SITE and never once at the cite. That is"],
     ScIndent [ScComment "what $StrictCitePat below exists to stop, and it is what Resolve-CiteOrder"],
     ScIndent [ScComment "now uses by default."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "The two bundlers this was kept for no longer carry their own copies:"],
     ScIndent [ScComment "concat-codex-self.ps1 and plug-build-lib.ps1 both take $StrictCitePat"],
     ScIndent [ScComment "and $QuireDirs from here, so NOTHING in the tree calls"],
     ScIndent [ScComment "this any more. It is kept only as the explicit way to ask for the old"],
     ScIndent [ScComment "blind-to-unregistered behaviour, and there is no good reason to."],
     ScIndent [ScComment "Where a bundler must admit fewer quires than the registry holds, that"],
     ScIndent [ScComment "is policy and belongs at its own call site as a filter over these keys"],
     ScIndent [ScComment "-- concat-codex-self's $libQuireNames is the worked example -- not as a"],
     ScIndent [ScComment "second pattern that reads the same text a different way."],
     ScRaw "    param([string[]]$ExtraQuires = @())",
     ScRaw "    $names = @($QuireDirs.Keys) + @($QuireManifests.Keys) + $ExtraQuires",
     ScRaw "    $alt = ($names | Sort-Object -Descending { $_.Length }) -join '|'",
     ScRaw "    return \"^\\s*cites\\s+($alt)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_-]*)\"",
     ScRaw "}",
     ScBlank,
     ScComment "The strict pattern takes the quire as any identifier rather than an",
     ScComment "alternation of the registered keys, which is the whole point: a cite naming a",
     ScComment "quire nobody registered now MATCHES, is walked, and fails loudly instead of",
     ScComment "vanishing. Three shapes it has to accept that the lenient one cannot:",
     ScComment "",
     ScComment "  cites Foreword chapter Sha256                     plain",
     ScComment "  cites Codex chapter Build Settings                a name with a SPACE",
     ScComment "  cites Codex chapter Build Settings (max-depth)    ...and a trailing note",
     ScComment "",
     ScComment "Real headers include 'AST Nodes', 'Build Settings' and 'Diagnostic Bag', and",
     ScComment "the convention annotates a cite with the definition it wanted. The lenient",
     ScComment "name capture stops at the space and reads that last line as name 'Build'.",
     ScRaw "$StrictCitePat = '^\\s*cites\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_ -]*?)\\s*(?:\\(.*)?$'",
     ScBlank,
     ScRaw "$CitePat = New-CitePattern"]

Section: S03 -- Cite key and presence seed

  s03-body : List ShellCmd =
    [ScBlank, ScRaw "function Get-CiteKey {",
     ScIndent [ScComment "Cites name a chapter two different ways and both are in the tree:"],
     ScIndent [ScComment "'cites Common chapter ByteHelpers' is the FILE's name, while"],
     ScIndent [ScComment "'cites Codex chapter Build Settings' is the HEADER's. The file is"],
     ScIndent [ScComment "ByteHelpers.codex holding 'Chapter: Byte Helpers', so neither form is"],
     ScIndent [ScComment "wrong and no lookup keyed on one of them finds the other. Comparing with"],
     ScIndent [ScComment "the spaces removed is what makes the two forms the same key."],
     ScRaw "    param([string]$Name)",
     ScRaw "    return ($Name -replace '\\s', '').ToLowerInvariant()",
     ScRaw "}",
     ScBlank,
     ScRaw "function Get-PresentChapterNames {",
     ScIndent [ScComment "The presence seed, keyed on the bare chapter name."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "A cite is satisfied two ways, not one: the chapter is RESOLVED through the"],
     ScIndent [ScComment "registry, or it is already PRESENT in the unit because a bundler globbed"],
     ScIndent [ScComment "the directory it lives in and renamed its header to <Dir>--<Name>. The"],
     ScIndent [ScComment "compiler's own source is assembled that way -- concat-codex-self.ps1 globs"],
     ScIndent [ScComment "codex/compiler -- so 'cites Codex chapter Build Settings' is answered by"],
     ScIndent [ScComment "'Chapter: Core--Build Settings' sitting in the same unit, and the registry"],
     ScIndent [ScComment "has no entry for 'Codex' at all and should not."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "This keys on the NAME and not on quire::name, which is the reason the"],
     ScIndent [ScComment "existing SeedSeen cannot do the job: concat renames by DIRECTORY (Core--)"],
     ScIndent [ScComment "while the cite names a QUIRE (Codex), so the two never share a key."],
     ScRaw "    param([string[]]$Lines)",
     ScRaw "    $present = @{}",
     ScRaw "    foreach ($l in $Lines) {",
     ScRaw "        if ($l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "            $full = $matches[1]",
     ScRaw "            $present[(Get-CiteKey $full)] = $true",
     ScIndent [ScIndent [ScIndent [ScComment "'Core--Build Settings' also answers to 'Build Settings'."]]],
     ScRaw "            $sep = $full.IndexOf('--')",
     ScRaw "            if ($sep -ge 0) { $present[(Get-CiteKey $full.Substring($sep + 2))] = $true }",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    return $present",
     ScRaw "}"]

Section: S04 -- Resolve-CiteOrder function

  s04-body : List ShellCmd =
    [ScBlank, ScRaw "function Resolve-CiteOrder {",
     ScIndent [ScComment "DFS post-order over the cite graph: a chapter's dependencies always"],
     ScIndent [ScComment "precede it in the returned list. BFS+Reverse is NOT a topological"],
     ScIndent [ScComment "order (CL 3644) -- do not reintroduce it."],
     ScIndent [ScComment "Returns a list of @{ Quire; Name; Path; Lines }."],
     ScRaw "    param(",
     ScRaw "        [Parameter(Mandatory=$true)] [AllowEmptyString()] [AllowEmptyCollection()] [string[]]$RootLines,",
     ScRaw "        [string]$Repo = '.',",
     ScRaw "        [string]$Pattern = '',",
     ScRaw "        [hashtable]$SeedSeen = $null,",
     ScRaw "        [string[]]$ExcludeQuires = @(),",
     ScRaw "        [scriptblock]$PathOverride = $null,",
     ScRaw "        [hashtable]$PresentNames = @{},",
     ScRaw "        [ValidateSet('throw','skip')] [string]$OnMissing = 'throw'",
     ScRaw "    )",
     ScRaw "    if (-not $Pattern) { $Pattern = $StrictCitePat }",
     ScRaw "    $visited = @{}",
     ScRaw "    $visiting = @{}",
     ScRaw "    if ($SeedSeen) { foreach ($k in $SeedSeen.Keys) { $visited[$k] = $true } }",
     ScIndent [ScComment "Chapters already in the unit satisfy a cite by being there. Seeded from"],
     ScIndent [ScComment "the root lines themselves, so a caller that bundles before it resolves"],
     ScIndent [ScComment "(the plugs, concat) needs no new argument and cannot forget to pass one."],
     ScRaw "    $present = Get-PresentChapterNames -Lines $RootLines",
     ScRaw "    foreach ($k in @($PresentNames.Keys)) { $present[(Get-CiteKey $k)] = $true }",
     ScRaw "    $excluded = @{}",
     ScRaw "    foreach ($q in $ExcludeQuires) { $excluded[$q] = $true }",
     ScRaw "    $ordered = [System.Collections.Generic.List[hashtable]]::new()",
     ScRaw "    $walk = $null",
     ScRaw "    $walk = {",
     ScRaw "        param([string]$quire, [string]$name)",
     ScRaw "        if ($excluded[$quire]) { return }",
     ScRaw "        $key = \"${quire}::${name}\"",
     ScRaw "        if ($visited[$key] -or $visiting[$key]) { return }",
     ScRaw "        $visiting[$key] = $true",
    ScRaw "        if ($QuireManifests[$quire]) {",
    ScIndent [ScIndent [ScIndent [ScComment "Already in the unit satisfies the cite, exactly as it does on the"]]],     ScIndent [ScIndent [ScIndent [ScComment "per-chapter path below. Without this a re-resolve of an ALREADY"]]],     ScIndent [ScIndent [ScIndent [ScComment "BUNDLED source adds the whole unit a second time, which is what"]]],     ScIndent [ScIndent [ScIndent [ScComment "compile.ps1 does to every bundle it is handed."]]],     ScRaw "            if ($present[(Get-CiteKey $name)]) { $visiting.Remove($key); $visited[$key] = $true; return }",
    ScIndent [ScIndent [ScIndent [ScComment "A QUIRE IS A DIRECTORY OR A MANIFEST. The compiler is only ever"]]],
    ScIndent [ScIndent [ScIndent [ScComment "consumed whole and in one order, and it is the one place in the"]]],
    ScIndent [ScIndent [ScIndent [ScComment "tree where <dir>\\<chapter name>.codex does not name its file: 24 of"]]],
    ScIndent [ScIndent [ScIndent [ScComment "its files carry a base name different from their Chapter: line and"]]],
    ScIndent [ScIndent [ScIndent [ScComment "four chapters span several files each, so no per-chapter path can"]]],
    ScIndent [ScIndent [ScIndent [ScComment "reach it. A cite of any chapter in a manifest quire therefore pulls"]]],
    ScIndent [ScIndent [ScIndent [ScComment "the whole ordered unit the manifest names, once."]]],
    ScRaw "            $unitMf = Join-Path $Repo $QuireManifests[$quire]",
    ScRaw "            if (-not (Test-Path -PathType Leaf $unitMf)) { throw \"Unresolvable cite: $quire chapter '$name' -- quire '$quire' is registered as manifest '$($QuireManifests[$quire])', which does not exist\" }",
    ScRaw "            $unitRows = @(Get-Content $unitMf | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' -and (-not $_.StartsWith('#')) })",
    ScRaw "            if ($unitRows.Count -eq 0) { throw \"Unresolvable cite: $quire chapter '$name' -- manifest '$($QuireManifests[$quire])' names no files\" }",
    ScRaw "            $unitRoot = Split-Path $unitRows[0] -Parent",
    ScRaw "            foreach ($r in $unitRows) { while (-not $r.StartsWith($unitRoot + '\\')) { $unitRoot = Split-Path $unitRoot -Parent } }",
    ScRaw "            $unitLines = [System.Collections.Generic.List[string]]::new()",
    ScRaw "            foreach ($rel in $unitRows) {",
    ScRaw "                $uf = Join-Path $Repo $rel",
    ScRaw "                if (-not (Test-Path -PathType Leaf $uf)) { throw \"Unresolvable cite: $quire chapter '$name' -- manifest '$($QuireManifests[$quire])' has a row with no file: $rel\" }",
    ScRaw "                $ul = [System.IO.File]::ReadAllLines($uf)",
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "THE UNIT'S OWN ENTRY CHAPTER IS LEFT OUT. A consumer supplies its"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "own `opening`, two in one unit collide (CDX3001), and that is"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "exactly why the entry point was split into a chapter of its own:"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "holding it apart is what makes the rest of the unit bundlable."]]]],
    ScRaw "                if (@($ul | Where-Object { $_ -match '^\\s+opening\\s*:' }).Count -gt 0) { continue }",
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "NO QUIRE PREFIX INSIDE THE UNIT. concat-codex-self stamps"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "<dir>--<chapter> because it merges several quires into one unit and"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "needs them apart. Here the unit is one manifest whose 48 chapter"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "names are already distinct, and prefixing actively breaks the"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "consumer: the compiler cites Codex chapter Phase Allocator while"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "that file sits in Core\\, so a directory prefix makes the cite and"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "the chapter line disagree and a re-resolve of the bundled source"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "pulls the whole unit again. Every manifest quire is marked visited"]]]],
    ScIndent [ScIndent [ScIndent [ScIndent [ScComment "for each chapter, so a cite reaches it under any of their names."]]]],
    ScRaw "                $ustamped = $false",
    ScRaw "                foreach ($ul1 in $ul) {",
    ScRaw "                    if ((-not $ustamped) -and $ul1 -match '^Chapter:\\s*(.+?)\\s*$') {",
    ScRaw "                        foreach ($mq in @($QuireManifests.Keys)) { $visited[\"${mq}::$($matches[1])\"] = $true }",
    ScRaw "                        $ustamped = $true",
    ScRaw "                    }",
    ScRaw "                    $unitLines.Add($ul1)",
    ScRaw "                }",
    ScRaw "                $unitLines.Add('')",
    ScRaw "                $unitLines.Add('')",
    ScRaw "            }",
    ScIndent [ScIndent [ScIndent [ScComment "The unit's own cites into OTHER quires still have to be walked,"]]],
    ScIndent [ScIndent [ScIndent [ScComment "and walked BEFORE the unit is added so they precede it: the compiler"]]],
    ScIndent [ScIndent [ScIndent [ScComment "cites Foreword and Math chapters, which concat-codex-self preloads"]]],
    ScIndent [ScIndent [ScIndent [ScComment "for its own build and which no consumer would otherwise get. Cites"]]],
    ScIndent [ScIndent [ScIndent [ScComment "back into this same unit are already marked visited above, so they"]]],
    ScIndent [ScIndent [ScIndent [ScComment "return at once rather than recursing."]]],
    ScRaw "            foreach ($ul2 in $unitLines) {",
    ScRaw "                if ($ul2 -match $Pattern) { & $walk $matches[1] $matches[2] }",
    ScRaw "            }",
    ScRaw "            $visiting.Remove($key)",
    ScRaw "            $visited[$key] = $true",
    ScRaw "            $ordered.Add(@{ Quire = $quire; Name = $name; Path = $unitMf; Lines = $unitLines.ToArray() })",
    ScRaw "            return",
    ScRaw "        }",
     ScRaw "        $path = $null",
     ScRaw "        if ($PathOverride) { $path = & $PathOverride $quire $name }",
     ScRaw "        if (-not $path) {",
     ScRaw "            $dir = $QuireDirs[$quire]",
     ScRaw "            if ($dir) { $path = Join-Path $Repo (Join-Path $dir \"$name.codex\") }",
     ScRaw "        }",
     ScRaw "        if (-not $path -or -not (Test-Path -PathType Leaf $path)) {",
     ScRaw "            $visiting.Remove($key)",
     ScIndent [ScIndent [ScIndent [ScComment "Already in the unit: satisfied, and there is nothing to walk."]]],
     ScRaw "            if ($present[(Get-CiteKey $name)]) { $visited[$key] = $true; return }",
     ScRaw "            if ($OnMissing -eq 'skip') { $visited[$key] = $true; return }",
     ScRaw "            $why = if ($QuireDirs[$quire]) {",
     ScRaw "                \"quire '$quire' is registered as '$($QuireDirs[$quire])' but has no chapter '$name' (expected $path)\"",
     ScRaw "            } else {",
     ScRaw "                \"quire '$quire' is not registered in build/quire-map.ps1, and no chapter '$name' is present in the unit\"",
     ScRaw "            }",
     ScRaw "            throw \"Unresolvable cite: $quire chapter '$name' -- $why\"",
     ScRaw "        }",
     ScRaw "        $chLines = [System.IO.File]::ReadAllLines($path)",
     ScRaw "        foreach ($l in $chLines) {",
     ScRaw "            if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }",
     ScRaw "        }",
     ScRaw "        $visiting.Remove($key)",
     ScRaw "        $visited[$key] = $true",
     ScRaw "        $ordered.Add(@{ Quire = $quire; Name = $name; Path = $path; Lines = $chLines })",
     ScRaw "    }",
     ScIndent [ScComment "The sugars' own dependencies, walked whether or not the source cites"],
     ScIndent [ScComment "them. `for x in xs -> ...` desugars to a call to `map-list`"],
     ScIndent [ScComment "(Foreword ListUtils) and a tuple literal or pattern to `MkTup<N>`"],
     ScIndent [ScComment "(Foreword Tuple). Both are names the DESUGARER writes, not the author,"],
     ScIndent [ScComment "so requiring the author to cite them made the language's own syntax"],
     ScIndent [ScComment "conditional on a line nobody could know to write: `for` without the"],
     ScIndent [ScComment "cite failed with `CDX3002: Undefined name: map-list`, and a tuple with"],
     ScIndent [ScComment "`CDX2002: Unknown name: MkTup2`."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "Unconditional rather than \"only if the source uses the sugar\" because"],
     ScIndent [ScComment "detecting use means parsing sugar with a regex, and getting that wrong"],
     ScIndent [ScComment "fails the same way this did. The two chapters are 141 lines and cite"],
     ScIndent [ScComment "nothing, so there is no cascade -- the cost is a fixed 5 KB per unit."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "A chapter that defines its own `map-list` still wins inside itself:"],
     ScIndent [ScComment "ChapterScoper mangles both sides of a collision per chapter, so a"],
     ScIndent [ScComment "mention resolves to its own chapter's. That is the same rule the register"],
     ScIndent [ScComment "2.15 settled for builtins, and it is why this is safe to do for every"],
     ScIndent [ScComment "unit rather than only for units that would otherwise fail. It does"],
     ScIndent [ScComment "raise CDX3006 (a warning) where a unit now carries two definitions of"],
     ScIndent [ScComment "a name; `$present` and `$excluded` are both honoured, so a unit that"],
     ScIndent [ScComment "already bundles these chapters, or excludes the Foreword quire, is"],
     ScIndent [ScComment "untouched."],
     ScRaw "    foreach ($impl in @(@('Foreword','ListUtils'), @('Foreword','Tuple'))) {",
     ScRaw "        & $walk $impl[0] $impl[1]",
     ScRaw "    }",
     ScRaw "    foreach ($l in $RootLines) {",
     ScRaw "        if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }",
     ScRaw "    }",
     ScRaw "    return ,$ordered",
     ScRaw "}"]

Section: S05 -- Diagnostic line mapping

  s05-body : List ShellCmd =
    [ScBlank, ScRaw "function Get-DiagRegions {",
     ScIndent [ScComment "Maps a unit line number back to the file it came from."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "The compiler numbers diagnostics against the assembled UNIT -- every"],
     ScIndent [ScComment "cited chapter, then the source -- so a source line is reported at"],
     ScIndent [ScComment "(prelude + its own line). Every position a user sees in a file that"],
     ScIndent [ScComment "cites anything is wrong by however many lines its dependencies run to;"],
     ScIndent [ScComment "a cite-less file was right only by accident, because its unit was"],
     ScIndent [ScComment "itself. Measured: an error on line 11 of a file citing one foreword"],
     ScIndent [ScComment "chapter reported as 214:5."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "Both assemblers must map back or only one of them tells the truth --"],
     ScIndent [ScComment "compile.ps1 for a single compile and test-compile-batch.ps1 for the"],
     ScIndent [ScComment "battery, which builds its own unit and writes its own build.log. That"],
     ScIndent [ScComment "is why this lives here rather than in either of them."],
     ScIndent [ScComment ""],
     ScIndent [ScComment "Format-CiteChapters replaces a chapter's `Chapter:` line one-for-one"],
     ScIndent [ScComment "and appends two blank lines, so an entry occupies Lines.Count + 2."],
     ScRaw "    param([Parameter(Mandatory=$true)] $Ordered, [Parameter(Mandatory=$true)] [string]$SrcPath)",
     ScRaw "    $regions = [System.Collections.Generic.List[hashtable]]::new()",
     ScRaw "    $cum = 0",
     ScRaw "    foreach ($entry in $Ordered) {",
     ScRaw "        $n = $entry.Lines.Count + 2",
     ScRaw "        [void]$regions.Add(@{ Start = $cum + 1; End = $cum + $n; File = $entry.Path })",
     ScRaw "        $cum += $n",
     ScRaw "    }",
     ScRaw "    [void]$regions.Add(@{ Start = $cum + 1; End = [int]::MaxValue; File = $SrcPath })",
     ScRaw "    return ,$regions",
     ScRaw "}",
     ScBlank,
     ScRaw "function Convert-DiagLine {",
     ScIndent [ScComment "`<unit-line>:<col>: ...` becomes `<file>:<file-line>:<col>: ...`."],
     ScIndent [ScComment "Anything without a position prefix passes through untouched, so"],
     ScIndent [ScComment "protocol lines (SIZE:, HEAP:, !EXC, MAP:) are unaffected."],
     ScRaw "    param([string]$Line, $Regions)",
     ScRaw "    if ($Regions -and $Line -match '^(\\d+):(\\d+):(.*)$') {",
     ScRaw "        $ul = [int]$matches[1]; $col = $matches[2]; $rest = $matches[3]",
     ScRaw "        foreach ($r in $Regions) {",
     ScRaw "            if ($ul -ge $r.Start -and $ul -le $r.End) {",
     ScRaw "                return \"$($r.File):$($ul - $r.Start + 1):${col}:$rest\"",
     ScRaw "            }",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    return $Line",
     ScRaw "}"]

Section: S06 -- Format-CiteChapters function

  s06-body : List ShellCmd =
    [ScBlank, ScRaw "function Format-CiteChapters {",
     ScIndent [ScComment "Renders resolved chapters as concatenation-ready lines, renaming"],
     ScIndent [ScComment "each header to `Chapter: Quire--Name` to avoid collisions."],
     ScRaw "    param([Parameter(Mandatory=$true)] $Ordered)",
     ScRaw "    $out = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($entry in $Ordered) {",
     ScRaw "        $renamed = $false",
     ScRaw "        foreach ($l in $entry.Lines) {",
     ScRaw "            if ((-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "                $out.Add(\"Chapter: $($entry.Quire)--$($matches[1])\")",
     ScRaw "                $renamed = $true",
     ScRaw "            } else { $out.Add($l) }",
     ScRaw "        }",
     ScRaw "        $out.Add(''); $out.Add('')",
     ScRaw "    }",
     ScRaw "    return ,$out",
     ScRaw "}"]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "the quire registry", ps-why = "the one table mapping a quire to its directory; every cite resolution in the tree reads this and nothing else", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "cite patterns", ps-why = "the regex a cite line is recognised by, built once so callers cannot each spell a slightly different one", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "cite key and presence seed", ps-why = "the identity a chapter is deduplicated by across the whole resolution", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "resolve-citeorder", ps-why = "the transitive cite closure in dependency order, which decides what a compilation unit actually contains", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "diagnostic line mapping", ps-why = "map a line in the concatenated unit back to the chapter and line a reader can open", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "format-citechapters", ps-why = "render a resolved order for a caller to print", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  quiremap-pipe : Pipeline = Pipeline { pl-name = "quire-map", pl-doc = "Single quire registry and cite resolver", pl-params = [], pl-stages = [PsStage s01, PsStage s02, PsStage s03, PsStage s04, PsStage s05, PsStage s06] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell quiremap-pipe))
  end

