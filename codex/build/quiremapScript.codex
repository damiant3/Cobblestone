Chapter: QuireMapScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: S01 -- QuireDirs hashtable

  s01-body : List ShellCmd =
    [ ScComment "The single quire registry and cite resolver. Dot-source this file;"
    , ScComment "never copy the map. Every script that resolves"
    , ScComment "  cites <Quire> chapter <Name>"
    , ScComment "(bundlers, compile, test batch, plug builds, linters) must take"
    , ScComment "$QuireDirs and $CitePat from here."
    , ScComment "Add new quires HERE and nowhere else. Paths are repo-relative."
    , ScBlank
    , ScRaw "$QuireDirs = @{"
    , ScIndent s01-quire-dirs
    , ScRaw "}"
    , ScSetIndex "QuireDirs" (SeLit "Accp") (SeLit "apps\\accp")
    , ScSetIndex "QuireDirs" (SeLit "Uoaix") (SeLit "apps\\uoaix")
    , ScBlank
    , ScComment "A QUIRE IS A DIRECTORY OR A MANIFEST. A directory quire resolves a cite to"
    , ScComment "<dir>\\<chapter name>.codex, one file per chapter, which every quire above"
    , ScComment "keeps exactly. The compiler cannot be reached that way and is the tree's only"
    , ScComment "exception: 24 of its 65 files carry a base name different from their Chapter:"
    , ScComment "line, and four chapters span several files each, X86-64 Code Generator over"
    , ScComment "fourteen. It is also only ever consumed WHOLE and in one order, so there is"
    , ScComment "nothing a per-chapter path would buy. A cite of any chapter in a manifest"
    , ScComment "quire therefore pulls the entire ordered unit the manifest names, once,"
    , ScComment "minus that unit's own entry chapter, which a consumer supplies itself."
    , ScComment "build/compiler-order.txt is that order and refuses to drift from the"
    , ScComment "directory it describes."
    , ScRaw "$QuireManifests = @{"
    , ScIndent s01-quire-manifests
    , ScRaw "}"
    ]

  s01-quire-dirs : List ShellCmd =
    [ ScRaw "'Foreword' = 'codex\\foreword\\core'; 'Kernel' = 'codex\\os\\kernel'; 'OS' = 'codex\\os\\core'"
    , ScRaw "'Works' = 'apps\\works'; 'Trust' = 'codex\\os\\trust'; 'Net' = 'codex\\os\\net'"
    , ScRaw "'Verify' = 'codex\\os\\verify'; 'Replay' = 'codex\\os\\replay'; 'Sched' = 'codex\\os\\sched'"
    , ScComment "Wflow, not Workflow: 'Workflow' is apps\\workflow, a different quire. The"
    , ScComment "cites have always said Wflow; what was missing was this line, so every"
    , ScComment "chapter they name was silently left out of the unit and the author got"
    , ScComment "CDX3002 at the use sites instead."
    , ScRaw "'Wflow' = 'codex\\workflow'; 'Tracker' = 'codex\\tracker'"
    , ScRaw "'Observe' = 'codex\\os\\observe'; 'Game' = 'codex\\foreword\\game'"
    , ScRaw "'Signal' = 'codex\\foreword\\signal'; 'Compress' = 'codex\\foreword\\compress'"
    , ScRaw "'Encode' = 'codex\\foreword\\encode'; 'Math' = 'codex\\foreword\\math'"
    , ScRaw "'Sim' = 'codex\\foreword\\sim'; 'AI' = 'codex\\foreword\\ai'"
    , ScRaw "'Engine' = 'codex\\foreword\\engine'"
    , ScRaw "'Punctual' = 'codex\\foreword\\punctual'"
    , ScRaw "'Gpu' = 'codex\\foreword\\gpu'; 'Shell' = 'codex\\foreword\\shell'"
    , ScRaw "'UI' = 'codex\\foreword\\ui'; 'Dev' = 'codex\\os\\dev'"
    , ScRaw "'Magic' = 'apps\\games\\magic'; 'Games' = 'apps\\games\\classic'"
    , ScRaw "'Spark' = 'apps\\spark'; 'Data' = 'apps\\data'"
    , ScRaw "'Sheets' = 'apps\\sheets'"
    , ScRaw "'Prism' = 'apps\\prism'; 'Valheim' = 'apps\\modbuilder\\mods\\valheim'"
    , ScRaw "'ModBuilder' = 'apps\\modbuilder\\native'"
    , ScRaw "'Csharp' = 'codex\\plugs\\csharp'"
    , ScRaw "'Pe' = 'codex\\plugs\\pe'"
    , ScRaw "'Sass' = 'codex\\plugs\\sass'"
    , ScRaw "'WaDemo' = 'apps\\wademo'"
    , ScRaw "'Diffusion' = 'apps\\diffusion'"
    , ScRaw "'AssetForge' = 'apps\\assetforge'"
    , ScRaw "'Explorer' = 'apps\\explorer'; 'FontExplorer' = 'apps\\fontexplorer'"
    , ScRaw "'CodexMagic' = 'apps\\games\\codexmagic'"
    , ScRaw "'Mathbook' = 'apps\\mathbook'"
    , ScRaw "'Cvmm' = 'apps\\cvmm'"
    , ScRaw "'Nettool' = 'apps\\nettool'"
    , ScRaw "'Browser' = 'apps\\browser'"
    , ScRaw "'FileShare' = 'apps\\fileshare'"
    , ScRaw "'Chat' = 'apps\\chat'"
    , ScRaw "'Designer' = 'apps\\designer'"
    , ScRaw "'Diagram' = 'apps\\diagram'"
    , ScRaw "'Secrets' = 'apps\\secrets'"
    , ScRaw "'MobileApp' = 'apps\\codexmagic-mobile'"
    , ScRaw "'Starmap' = 'apps\\starmap'"
    , ScRaw "'Globe' = 'apps\\globe'"
    , ScRaw "'Safari' = 'apps\\safari\\port'"
    , ScRaw "'Judge' = 'apps\\safari\\judge'"
    , ScRaw "'Gold' = 'apps\\safari\\gold'"
    , ScRaw "'Radio' = 'apps\\radio'"
    , ScRaw "'Mail' = 'apps\\mail'"
    , ScRaw "'Music' = 'apps\\music'"
    , ScRaw "'Photos' = 'apps\\photos'"
    , ScRaw "'Notes' = 'apps\\notes'"
    , ScRaw "'Tasks' = 'apps\\tasks'"
    , ScRaw "'Weather' = 'apps\\weather'"
    , ScRaw "'Calendar' = 'apps\\calendar'"
    , ScRaw "'Maps' = 'apps\\maps'"
    , ScRaw "'News' = 'apps\\news'"
    , ScRaw "'Podcasts' = 'apps\\podcasts'"
    , ScRaw "'Books' = 'apps\\books'"
    , ScRaw "'Recorder' = 'apps\\recorder'"
    , ScRaw "'Capture' = 'apps\\capture'"
    , ScRaw "'Publisher' = 'apps\\publisher'"
    , ScRaw "'ImageTools' = 'apps\\imagetools'"
    , ScRaw "'Fitness' = 'apps\\fitness'"
    , ScRaw "'Pomodoro' = 'apps\\pomodoro'"
    , ScRaw "'Piano' = 'apps\\piano'"
    , ScRaw "'Markets' = 'apps\\markets'"
    , ScRaw "'FishTank' = 'apps\\fishtank'"
    , ScRaw "'Helm' = 'apps\\helm'"
    , ScRaw "'Colophon' = 'apps\\colophon'"
    , ScRaw "'WebApp' = 'apps\\webapp'"
    , ScRaw "'ERP' = 'apps\\erp'"
    , ScRaw "'Vision' = 'apps\\vision'"
    , ScRaw "'Collab' = 'apps\\collab'"
    , ScRaw "'Services' = 'apps\\services'; 'Accounts' = 'apps\\services\\accounts'"
    , ScRaw "'Market' = 'apps\\market'"
    , ScRaw "'Workflow' = 'apps\\workflow'"
    , ScRaw "'Site' = 'apps\\site'"
    , ScRaw "'Lens' = 'apps\\lens'"
    , ScRaw "'Boards' = 'codex\\boards'"
    , ScRaw "'Product' = 'codex\\product'"
    , ScRaw "'Build' = 'codex\\build'"
    , ScRaw "'Mesh' = 'apps\\edgemesh'"
    , ScRaw "'Water' = 'shaders\\water'"
    , ScRaw "'Clouds' = 'shaders\\clouds'"
    , ScRaw "'Terrain' = 'shaders\\terrain'"
    , ScRaw "'Reflect' = 'shaders\\reflect'"
    , ScRaw "'Guios' = 'apps\\guios'"
    , ScRaw "'C64' = 'apps\\c64'"
    , ScRaw "'Ideas' = 'apps\\ideas'"
    , ScComment "'Circuits' is the Core sub-quire. The chapters at the circuits ROOT"
    , ScComment "(CanvasModel, CircuitsTheme, CircuitsUI, ViewState, ...) are the app"
    , ScComment "shell and had no quire at all, so opening.codex could not cite them"
    , ScComment "and every name they define reported CDX3002 at the use site."
    , ScRaw "'CircuitsApp' = 'apps\\circuits'"
    , ScRaw "'Circuits' = 'apps\\circuits\\Core'"
    , ScRaw "'CircuitsSch' = 'apps\\circuits\\SchematicEditor'"
    , ScRaw "'CircuitsSym' = 'apps\\circuits\\SymbolEditor'"
    , ScRaw "'CircuitsSim' = 'apps\\circuits\\Simulator'"
    , ScRaw "'CircuitsPcb' = 'apps\\circuits\\PcbEditor'"
    , ScRaw "'CircuitsFp' = 'apps\\circuits\\FootprintEditor'"
    , ScRaw "'CircuitsBv' = 'apps\\circuits\\BoardViewer'"
    , ScRaw "'CircuitsMfg' = 'apps\\circuits\\Manufacturing'"
    , ScComment "The diagnostic ladder and its stage chapters (DiagnosticStick.md):"
    , ScComment "a stage is a chapter under build\\boot\\diag cited as Diag chapter X."
    , ScRaw "'Diag' = 'build\\boot\\diag'"
    ]

  s01-quire-manifests : List ShellCmd =
    [ ScRaw "'Codex' = 'build\\compiler-order.txt'"
    , ScRaw "'Emit' = 'build\\compiler-order.txt'"
    , ScRaw "'Semantics' = 'build\\compiler-order.txt'"
    ]

Section: S02 -- Cite patterns

  s02-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "New-CitePattern" s02-new-cite-pattern
    , ScBlank
    , ScComment "The strict pattern takes the quire as any identifier rather than an"
    , ScComment "alternation of the registered keys, which is the whole point: a cite naming a"
    , ScComment "quire nobody registered now MATCHES, is walked, and fails loudly instead of"
    , ScComment "vanishing. Three shapes it has to accept that the lenient one cannot:"
    , ScComment ""
    , ScComment "  cites Foreword chapter Sha256                     plain"
    , ScComment "  cites Codex chapter Build Settings                a name with a SPACE"
    , ScComment "  cites Codex chapter Build Settings (max-depth)    ...and a trailing note"
    , ScComment ""
    , ScComment "Real headers include 'AST Nodes', 'Build Settings' and 'Diagnostic Bag', and"
    , ScComment "the convention annotates a cite with the definition it wanted. The lenient"
    , ScComment "name capture stops at the space and reads that last line as name 'Build'."
    , ScAssign "StrictCitePat" (SeLit "^\\s*cites\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_ -]*?)\\s*(?:\\(.*)?$")
    , ScBlank
    , ScRaw "$CitePat = New-CitePattern"
    ]

  s02-new-cite-pattern : List ShellCmd =
    [ ScComment "Alternation sorted longest-first so 'Games' wins over 'Game'."
    , ScComment ""
    , ScComment "This pattern is generated from the KEYS of $QuireDirs, so a cite to an"
    , ScComment "unregistered quire does not match it, is never walked, and is never"
    , ScComment "resolved: the chapter is silently left out of the unit and the author gets"
    , ScComment "a cascade of CDX3002 at every USE SITE and never once at the cite. That is"
    , ScComment "what $StrictCitePat below exists to stop, and it is what Resolve-CiteOrder"
    , ScComment "now uses by default."
    , ScComment ""
    , ScComment "The two bundlers this was kept for no longer carry their own copies:"
    , ScComment "concat-codex-self.ps1 and plug-build-lib.ps1 both take $StrictCitePat"
    , ScComment "and $QuireDirs from here, so NOTHING in the tree calls"
    , ScComment "this any more. It is kept only as the explicit way to ask for the old"
    , ScComment "blind-to-unregistered behaviour, and there is no good reason to."
    , ScComment "Where a bundler must admit fewer quires than the registry holds, that"
    , ScComment "is policy and belongs at its own call site as a filter over these keys"
    , ScComment "-- concat-codex-self's $libQuireNames is the worked example -- not as a"
    , ScComment "second pattern that reads the same text a different way."
    , ScRaw "param([string[]]$ExtraQuires = @())"
    , ScRaw "$names = @($QuireDirs.Keys) + @($QuireManifests.Keys) + $ExtraQuires"
    , ScRaw "$alt = ($names | Sort-Object -Descending { $_.Length }) -join '|'"
    , ScRaw "return \"^\\s*cites\\s+($alt)\\s+chapter\\s+([A-Za-z_][A-Za-z0-9_-]*)\""
    ]

Section: S03 -- Cite key and presence seed

  s03-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "Get-CiteKey" s03-get-cite-key
    , ScBlank
    , ScFunctionBlock "Get-PresentChapterNames" s03-get-present-chapter-names
    ]

  s03-get-cite-key : List ShellCmd =
    [ ScComment "Cites name a chapter two different ways and both are in the tree:"
    , ScComment "'cites Common chapter ByteHelpers' is the FILE's name, while"
    , ScComment "'cites Codex chapter Build Settings' is the HEADER's. The file is"
    , ScComment "ByteHelpers.codex holding 'Chapter: Byte Helpers', so neither form is"
    , ScComment "wrong and no lookup keyed on one of them finds the other. Comparing with"
    , ScComment "the spaces removed is what makes the two forms the same key."
    , ScRaw "param([string]$Name)"
    , ScRaw "return ($Name -replace '\\s', '').ToLowerInvariant()"
    ]

  s03-get-present-chapter-names : List ShellCmd =
    [ ScComment "The presence seed, keyed on the bare chapter name."
    , ScComment ""
    , ScComment "A cite is satisfied two ways, not one: the chapter is RESOLVED through the"
    , ScComment "registry, or it is already PRESENT in the unit because a bundler globbed"
    , ScComment "the directory it lives in and renamed its header to <Dir>--<Name>. The"
    , ScComment "compiler's own source is assembled that way -- concat-codex-self.ps1 globs"
    , ScComment "codex/compiler -- so 'cites Codex chapter Build Settings' is answered by"
    , ScComment "'Chapter: Core--Build Settings' sitting in the same unit, and the registry"
    , ScComment "has no entry for 'Codex' at all and should not."
    , ScComment ""
    , ScComment "This keys on the NAME and not on quire::name, which is the reason the"
    , ScComment "existing SeedSeen cannot do the job: concat renames by DIRECTORY (Core--)"
    , ScComment "while the cite names a QUIRE (Codex), so the two never share a key."
    , ScRaw "param([string[]]$Lines)"
    , ScRaw "$present = @{}"
    , ScForEach "l" (SeVar "Lines") s03-each-lines
    , ScReturn (SeVar "present")
    ]

  s03-each-lines : List ShellCmd =
    [ ScIf (SeBare (SeMatch (SeVar "l") "^Chapter:\\s*(.+?)\\s*$")) s03-if-l []
    ]

  s03-if-l : List ShellCmd =
    [ ScRaw "$full = $matches[1]"
    , ScRaw "$present[(Get-CiteKey $full)] = $true"
    , ScComment "'Core--Build Settings' also answers to 'Build Settings'."
    , ScRaw "$sep = $full.IndexOf('--')"
    , ScRaw "if ($sep -ge 0) { $present[(Get-CiteKey $full.Substring($sep + 2))] = $true }"
    ]

Section: S04 -- Resolve-CiteOrder function

  s04-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "Resolve-CiteOrder" s04-resolve-cite-order
    ]

  s04-resolve-cite-order : List ShellCmd =
    [ ScComment "DFS post-order over the cite graph: a chapter's dependencies always"
    , ScComment "precede it in the returned list. BFS+Reverse is NOT a topological"
    , ScComment "order (CL 3644) -- do not reintroduce it."
    , ScComment "Returns a list of @{ Quire; Name; Path; Lines }."
    , ScRaw "param("
    , ScRaw "    [Parameter(Mandatory=$true)] [AllowEmptyString()] [AllowEmptyCollection()] [string[]]$RootLines,"
    , ScRaw "    [string]$Repo = '.',"
    , ScRaw "    [string]$Pattern = '',"
    , ScRaw "    [hashtable]$SeedSeen = $null,"
    , ScRaw "    [string[]]$ExcludeQuires = @(),"
    , ScRaw "    [scriptblock]$PathOverride = $null,"
    , ScRaw "    [hashtable]$PresentNames = @{},"
    , ScRaw "    [ValidateSet('throw','skip')] [string]$OnMissing = 'throw'"
    , ScRaw ")"
    , ScIfLine (SeBare (SeNot (SeVar "Pattern"))) [ScAssign "Pattern" (SeVar "StrictCitePat")] []
    , ScRaw "$visited = @{}"
    , ScRaw "$visiting = @{}"
    , ScRaw "if ($SeedSeen) { foreach ($k in $SeedSeen.Keys) { $visited[$k] = $true } }"
    , ScComment "Chapters already in the unit satisfy a cite by being there. Seeded from"
    , ScComment "the root lines themselves, so a caller that bundles before it resolves"
    , ScComment "(the plugs, concat) needs no new argument and cannot forget to pass one."
    , ScRaw "$present = Get-PresentChapterNames -Lines $RootLines"
    , ScRaw "foreach ($k in @($PresentNames.Keys)) { $present[(Get-CiteKey $k)] = $true }"
    , ScRaw "$excluded = @{}"
    , ScRaw "foreach ($q in $ExcludeQuires) { $excluded[$q] = $true }"
    , ScRaw "$ordered = [System.Collections.Generic.List[hashtable]]::new()"
    , ScAssign "walk" (SeVar "null")
    , ScRaw "$walk = {"
    , ScIndent s04-walk
    , ScRaw "}"
    , ScComment "The sugars' own dependencies, walked whether or not the source cites"
    , ScComment "them. `for x in xs -> ...` desugars to a call to `map-list`"
    , ScComment "(Foreword ListUtils) and a tuple literal or pattern to `MkTup<N>`"
    , ScComment "(Foreword Tuple). Both are names the DESUGARER writes, not the author,"
    , ScComment "so requiring the author to cite them made the language's own syntax"
    , ScComment "conditional on a line nobody could know to write: `for` without the"
    , ScComment "cite failed with `CDX3002: Undefined name: map-list`, and a tuple with"
    , ScComment "`CDX2002: Unknown name: MkTup2`."
    , ScComment ""
    , ScComment "Unconditional rather than \"only if the source uses the sugar\" because"
    , ScComment "detecting use means parsing sugar with a regex, and getting that wrong"
    , ScComment "fails the same way this did. The two chapters are 141 lines and cite"
    , ScComment "nothing, so there is no cascade -- the cost is a fixed 5 KB per unit."
    , ScComment ""
    , ScComment "A chapter that defines its own `map-list` still wins inside itself:"
    , ScComment "ChapterScoper mangles both sides of a collision per chapter, so a"
    , ScComment "mention resolves to its own chapter's. That is the same rule the register"
    , ScComment "2.15 settled for builtins, and it is why this is safe to do for every"
    , ScComment "unit rather than only for units that would otherwise fail. It does"
    , ScComment "raise CDX3006 (a warning) where a unit now carries two definitions of"
    , ScComment "a name; `$present` and `$excluded` are both honoured, so a unit that"
    , ScComment "already bundles these chapters, or excludes the Foreword quire, is"
    , ScComment "untouched."
    , ScRaw "foreach ($impl in @(@('Foreword','ListUtils'), @('Foreword','Tuple'))) {"
    , ScIndent [ScRaw "& $walk $impl[0] $impl[1]"]
    , ScRaw "}"
    , ScForEach "l" (SeVar "RootLines") s04-each-root-lines
    , ScRaw "return ,$ordered"
    ]

  s04-walk : List ShellCmd =
    [ ScRaw "param([string]$quire, [string]$name)"
    , ScRaw "if ($excluded[$quire]) { return }"
    , ScRaw "$key = \"${quire}::${name}\""
    , ScRaw "if ($visited[$key] -or $visiting[$key]) { return }"
    , ScRaw "$visiting[$key] = $true"
    , ScIf (SeIndex (SeVar "QuireManifests") (SeVar "quire")) s04-quire-manifests []
    , ScAssign "path" (SeVar "null")
    , ScRaw "if ($PathOverride) { $path = & $PathOverride $quire $name }"
    , ScIf (SeBare (SeNot (SeVar "path"))) s04-if-not []
    , ScIf (SeBare (SeOr (SeBare (SeNot (SeVar "path"))) (SeBare (SeNot (SeFileExists (SeVar "path")))))) s04-not-test-type []
    , ScRaw "$chLines = [System.IO.File]::ReadAllLines($path)"
    , ScForEach "l" (SeVar "chLines") s04-each-ch-lines
    , ScRaw "$visiting.Remove($key)"
    , ScRaw "$visited[$key] = $true"
    , ScRaw "$ordered.Add(@{ Quire = $quire; Name = $name; Path = $path; Lines = $chLines })"
    ]

  s04-quire-manifests : List ShellCmd =
    [ ScComment "Already in the unit satisfies the cite, exactly as it does on the"
    , ScComment "per-chapter path below. Without this a re-resolve of an ALREADY"
    , ScComment "BUNDLED source adds the whole unit a second time, which is what"
    , ScComment "compile.ps1 does to every bundle it is handed."
    , ScRaw "if ($present[(Get-CiteKey $name)]) { $visiting.Remove($key); $visited[$key] = $true; return }"
    , ScComment "A QUIRE IS A DIRECTORY OR A MANIFEST. The compiler is only ever"
    , ScComment "consumed whole and in one order, and it is the one place in the"
    , ScComment "tree where <dir>\\<chapter name>.codex does not name its file: 24 of"
    , ScComment "its files carry a base name different from their Chapter: line and"
    , ScComment "four chapters span several files each, so no per-chapter path can"
    , ScComment "reach it. A cite of any chapter in a manifest quire therefore pulls"
    , ScComment "the whole ordered unit the manifest names, once."
    , ScRaw "$unitMf = Join-Path $Repo $QuireManifests[$quire]"
    , ScRaw "if (-not (Test-Path -PathType Leaf $unitMf)) { throw \"Unresolvable cite: $quire chapter '$name' -- quire '$quire' is registered as manifest '$($QuireManifests[$quire])', which does not exist\" }"
    , ScRaw "$unitRows = @(Get-Content $unitMf | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' -and (-not $_.StartsWith('#')) })"
    , ScRaw "if ($unitRows.Count -eq 0) { throw \"Unresolvable cite: $quire chapter '$name' -- manifest '$($QuireManifests[$quire])' names no files\" }"
    , ScRaw "$unitRoot = Split-Path $unitRows[0] -Parent"
    , ScRaw "foreach ($r in $unitRows) { while (-not $r.StartsWith($unitRoot + '\\')) { $unitRoot = Split-Path $unitRoot -Parent } }"
    , ScRaw "$unitLines = [System.Collections.Generic.List[string]]::new()"
    , ScForEach "rel" (SeVar "unitRows") s04-each-unit-rows
    , ScComment "The unit's own cites into OTHER quires still have to be walked,"
    , ScComment "and walked BEFORE the unit is added so they precede it: the compiler"
    , ScComment "cites Foreword and Math chapters, which concat-codex-self preloads"
    , ScComment "for its own build and which no consumer would otherwise get. Cites"
    , ScComment "back into this same unit are already marked visited above, so they"
    , ScComment "return at once rather than recursing."
    , ScForEach "ul2" (SeVar "unitLines") s04-each-unit-lines
    , ScRaw "$visiting.Remove($key)"
    , ScRaw "$visited[$key] = $true"
    , ScRaw "$ordered.Add(@{ Quire = $quire; Name = $name; Path = $unitMf; Lines = $unitLines.ToArray() })"
    , ScRaw "return"
    ]

  s04-each-unit-rows : List ShellCmd =
    [ ScAssign "uf" (SeBare (SePathJoinN [SeVar "Repo", SeVar "rel"]))
    , ScRaw "if (-not (Test-Path -PathType Leaf $uf)) { throw \"Unresolvable cite: $quire chapter '$name' -- manifest '$($QuireManifests[$quire])' has a row with no file: $rel\" }"
    , ScRaw "$ul = [System.IO.File]::ReadAllLines($uf)"
    , ScComment "THE UNIT'S OWN ENTRY CHAPTER IS LEFT OUT. A consumer supplies its"
    , ScComment "own `opening`, two in one unit collide (CDX3001), and that is"
    , ScComment "exactly why the entry point was split into a chapter of its own:"
    , ScComment "holding it apart is what makes the rest of the unit bundlable."
    , ScRaw "if (@($ul | Where-Object { $_ -match '^\\s+opening\\s*:' }).Count -gt 0) { continue }"
    , ScComment "NO QUIRE PREFIX INSIDE THE UNIT. concat-codex-self stamps"
    , ScComment "<dir>--<chapter> because it merges several quires into one unit and"
    , ScComment "needs them apart. Here the unit is one manifest whose 48 chapter"
    , ScComment "names are already distinct, and prefixing actively breaks the"
    , ScComment "consumer: the compiler cites Codex chapter Phase Allocator while"
    , ScComment "that file sits in Core\\, so a directory prefix makes the cite and"
    , ScComment "the chapter line disagree and a re-resolve of the bundled source"
    , ScComment "pulls the whole unit again. Every manifest quire is marked visited"
    , ScComment "for each chapter, so a cite reaches it under any of their names."
    , ScAssign "ustamped" (SeVar "false")
    , ScForEach "ul1" (SeVar "ul") s04-each-ul
    , ScRaw "$unitLines.Add('')"
    , ScRaw "$unitLines.Add('')"
    ]

  s04-each-ul : List ShellCmd =
    [ ScIf (SeBare (SeAnd (SeNot (SeVar "ustamped")) (SeBare (SeMatch (SeVar "ul1") "^Chapter:\\s*(.+?)\\s*$")))) s04-not-ustamped-ul1 []
    , ScRaw "$unitLines.Add($ul1)"
    ]

  s04-not-ustamped-ul1 : List ShellCmd =
    [ ScRaw "foreach ($mq in @($QuireManifests.Keys)) { $visited[\"${mq}::$($matches[1])\"] = $true }"
    , ScAssign "ustamped" (SeVar "true")
    ]

  s04-each-unit-lines : List ShellCmd =
    [ ScRaw "if ($ul2 -match $Pattern) { & $walk $matches[1] $matches[2] }"
    ]

  s04-if-not : List ShellCmd =
    [ ScRaw "$dir = $QuireDirs[$quire]"
    , ScRaw "if ($dir) { $path = Join-Path $Repo (Join-Path $dir \"$name.codex\") }"
    ]

  s04-not-test-type : List ShellCmd =
    [ ScRaw "$visiting.Remove($key)"
    , ScComment "Already in the unit: satisfied, and there is nothing to walk."
    , ScRaw "if ($present[(Get-CiteKey $name)]) { $visited[$key] = $true; return }"
    , ScRaw "if ($OnMissing -eq 'skip') { $visited[$key] = $true; return }"
    , ScRaw "$why = if ($QuireDirs[$quire]) {"
    , ScIndent s04-why-quire-dirs
    , ScRaw "} else {"
    , ScIndent s04-block
    , ScRaw "}"
    , ScRaw "throw \"Unresolvable cite: $quire chapter '$name' -- $why\""
    ]

  s04-why-quire-dirs : List ShellCmd =
    [ ScRaw "\"quire '$quire' is registered as '$($QuireDirs[$quire])' but has no chapter '$name' (expected $path)\""
    ]

  s04-block : List ShellCmd =
    [ ScRaw "\"quire '$quire' is not registered in build/quire-map.ps1, and no chapter '$name' is present in the unit\""
    ]

  s04-each-ch-lines : List ShellCmd =
    [ ScRaw "if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }"
    ]

  s04-each-root-lines : List ShellCmd =
    [ ScRaw "if ($l -match $Pattern) { & $walk $matches[1] $matches[2] }"
    ]

Section: S05 -- Diagnostic line mapping

  s05-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "Get-DiagRegions" s05-get-diag-regions
    , ScBlank
    , ScFunctionBlock "Convert-DiagLine" s05-convert-diag-line
    ]

  s05-get-diag-regions : List ShellCmd =
    [ ScComment "Maps a unit line number back to the file it came from."
    , ScComment ""
    , ScComment "The compiler numbers diagnostics against the assembled UNIT -- every"
    , ScComment "cited chapter, then the source -- so a source line is reported at"
    , ScComment "(prelude + its own line). Every position a user sees in a file that"
    , ScComment "cites anything is wrong by however many lines its dependencies run to;"
    , ScComment "a cite-less file was right only by accident, because its unit was"
    , ScComment "itself. Measured: an error on line 11 of a file citing one foreword"
    , ScComment "chapter reported as 214:5."
    , ScComment ""
    , ScComment "Both assemblers must map back or only one of them tells the truth --"
    , ScComment "compile.ps1 for a single compile and test-compile-batch.ps1 for the"
    , ScComment "battery, which builds its own unit and writes its own build.log. That"
    , ScComment "is why this lives here rather than in either of them."
    , ScComment ""
    , ScComment "Format-CiteChapters replaces a chapter's `Chapter:` line one-for-one"
    , ScComment "and appends two blank lines, so an entry occupies Lines.Count + 2."
    , ScRaw "param([Parameter(Mandatory=$true)] $Ordered, [Parameter(Mandatory=$true)] [string]$SrcPath)"
    , ScRaw "$regions = [System.Collections.Generic.List[hashtable]]::new()"
    , ScAssign "cum" (SeInt 0)
    , ScForEach "entry" (SeVar "Ordered") s05-each-ordered
    , ScRaw "[void]$regions.Add(@{ Start = $cum + 1; End = [int]::MaxValue; File = $SrcPath })"
    , ScRaw "return ,$regions"
    ]

  s05-each-ordered : List ShellCmd =
    [ ScRaw "$n = $entry.Lines.Count + 2"
    , ScRaw "[void]$regions.Add(@{ Start = $cum + 1; End = $cum + $n; File = $entry.Path })"
    , ScRaw "$cum += $n"
    ]

  s05-convert-diag-line : List ShellCmd =
    [ ScComment "`<unit-line>:<col>: ...` becomes `<file>:<file-line>:<col>: ...`."
    , ScComment "Anything without a position prefix passes through untouched, so"
    , ScComment "protocol lines (SIZE:, HEAP:, !EXC, MAP:) are unaffected."
    , ScRaw "param([string]$Line, $Regions)"
    , ScIf (SeBare (SeAnd (SeVar "Regions") (SeBare (SeMatch (SeVar "Line") "^(\\d+):(\\d+):(.*)$")))) s05-regions-line []
    , ScReturn (SeVar "Line")
    ]

  s05-regions-line : List ShellCmd =
    [ ScRaw "$ul = [int]$matches[1]; $col = $matches[2]; $rest = $matches[3]"
    , ScForEach "r" (SeVar "Regions") s05-each-regions
    ]

  s05-each-regions : List ShellCmd =
    [ ScIf (SeBare (SeAnd (SeBare (SeIntGe (SeVar "ul") (SeProperty (SeVar "r") "Start"))) (SeBare (SeIntLe (SeVar "ul") (SeProperty (SeVar "r") "End"))))) s05-ul-r-start-end []
    ]

  s05-ul-r-start-end : List ShellCmd =
    [ ScRaw "return \"$($r.File):$($ul - $r.Start + 1):${col}:$rest\""
    ]

Section: S06 -- Format-CiteChapters function

  s06-body : List ShellCmd =
    [ ScBlank
    , ScFunctionBlock "Format-CiteChapters" s06-format-cite-chapters
    ]

  s06-format-cite-chapters : List ShellCmd =
    [ ScComment "Renders resolved chapters as concatenation-ready lines, renaming"
    , ScComment "each header to `Chapter: Quire--Name` to avoid collisions."
    , ScRaw "param([Parameter(Mandatory=$true)] $Ordered)"
    , ScRaw "$out = [System.Collections.Generic.List[string]]::new()"
    , ScForEach "entry" (SeVar "Ordered") s06-each-ordered
    , ScRaw "return ,$out"
    ]

  s06-each-ordered : List ShellCmd =
    [ ScAssign "renamed" (SeVar "false")
    , ScForEach "l" (SeProperty (SeVar "entry") "Lines") s06-l-entry-lines
    , ScRaw "$out.Add(''); $out.Add('')"
    ]

  s06-l-entry-lines : List ShellCmd =
    [ ScRaw "if ((-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {"
    , ScIndent s06-not-renamed-l
    , ScRaw "} else { $out.Add($l) }"
    ]

  s06-not-renamed-l : List ShellCmd =
    [ ScRaw "$out.Add(\"Chapter: $($entry.Quire)--$($matches[1])\")"
    , ScAssign "renamed" (SeVar "true")
    ]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "the quire registry", ps-why = "the one table mapping a quire to its directory; every cite resolution in the tree reads this and nothing else", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "cite patterns", ps-why = "the regex a cite line is recognised by, built once so callers cannot each spell a slightly different one", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "cite key and presence seed", ps-why = "the identity a chapter is deduplicated by across the whole resolution", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "resolve-citeorder", ps-why = "the transitive cite closure in dependency order, which decides what a compilation unit actually contains", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "diagnostic line mapping", ps-why = "map a line in the concatenated unit back to the chapter and line a reader can open", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "format-citechapters", ps-why = "render a resolved order for a caller to print", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  quiremap-pipe : Pipeline = Pipeline { pl-name = "quire-map", pl-doc = "Single quire registry and cite resolver", pl-params = [], pl-stages = [PsStage s01, PsStage s02, PsStage s03, PsStage s04, PsStage s05, PsStage s06] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell quiremap-pipe))
  end

