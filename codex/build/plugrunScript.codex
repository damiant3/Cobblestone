Chapter: PlugRunScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  plugrun-params : List ShellParam =
    [ sh-param "IrInput" SptString
    , sh-param "Out" SptString
    , sh-param-default "PlugCdx" SptString (SeLit "")
    , sh-param-default "MemMB" SptInt (SeInt 2048)
    , sh-param-default "TimeoutSec" SptInt (SeInt 120)
    , sh-param-default "Port" SptInt (SeInt 9100)
    ]

Section: S01 -- Preamble

  s01-body : List ShellCmd =
    [ ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1"))
    , ScBlank
    , ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit "..")))
    , ScIf (SeNot (SeFileExists (SeVar "IrInput"))) [ScWriteError (SeText "MISSING IR input: $IrInput"), ScExit (SeInt 2)] []
    , ScIf (SeNot (SeVar "PlugCdx")) [ScAssign "PlugCdx" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "build-output\\plug.cdx"]))] []
    , ScIf (SeNot (SeFileExists (SeVar "PlugCdx"))) [ScWriteError (SeText "MISSING plug CDX: $PlugCdx"), ScExit (SeInt 2)] []
    ]

Section: S02 -- Read IR input

  s02-body : List ShellCmd =
    [ ScBlank
    , ScReadBytes "irBytes" (SeVar "IrInput")
    , ScEcho (SeText "[plug-run] IR input: $($irBytes.Length) bytes")
    , ScEcho (SeText "[plug-run] Plug: $PlugCdx")
    , ScBlank
    , ScBlank
    , ScComment "The finally block reads $proc, and under Set-StrictMode an unset name THROWS."
    , ScComment "It was always assigned before anything could fail until the host became a"
    , ScComment "choice; a missing VM binary now makes Start-Process throw first, and the"
    , ScComment "StrictMode error about $proc buried the real cause."
    , ScComment "$stderrFile, $consoleFile and $listener are the same class one throw earlier:"
    , ScComment "a port still held from the previous subject makes $listener.Start() throw"
    , ScComment "before any of the three is assigned, and the finally's reference then masks"
    , ScComment "the port error as \"variable cannot be retrieved\" (gate, 2026-08-27, three"
    , ScComment "plugs reported \"produced nothing\" on their second subject)."
    , ScAssign "proc" (SeVar "null")
    , ScAssign "stderrFile" (SeVar "null")
    , ScAssign "consoleFile" (SeVar "null")
    , ScAssign "listener" (SeVar "null")
    ]

Section: S03 -- Start TCP listener

  s03-body : List ShellCmd =
    [ ScAssign "hostPort" (SeVar "Port")
    , ScForLoop "pa" (SeInt 0) (SeBare (SeIntLt (SeVar "pa") (SeInt 8))) (SePostIncrement "pa") s03-try-port
    , ScRaw "if (-not $listener) { [Console]::Error.WriteLine(\"FAIL: no host port for this plug run. Under codex-vm eight Get-VmPort ports were taken; under QEMU the plug's own port $Port is fixed and another run holds it (L-SHARED).\"); exit 7 }"
    , ScEcho (SeText "[plug-run] Listening on TCP $hostPort (the guest dials $Port)")
    ]

  s03-try-port : List ShellCmd =
    [ ScRaw "$tryPort = if ($script:UseCodexVm) { Get-VmPort -Attempt $pa } else { $Port }"
    , ScDotNetCallAssign "listener" "System.Net.Sockets.TcpListener" "new" [SeBare (SeStaticProp "System.Net.IPAddress" "Loopback"), SeVar "tryPort"]
    , ScRaw "try { $listener.Start(); $hostPort = $tryPort; break } catch { $listener = $null; if (-not $script:UseCodexVm) { break } }"
    ]

Section: S04 -- Boot VM

  s04-body : List ShellCmd =
    [ ScBlank
    , ScTempFile "stderrFile"
    , ScTempFile "consoleFile"
    , ScComment "The host choice lives in Start-PlugVm (vm-config), not here: eighteen other"
    , ScComment "runners need the same selection and a copy in each is a copy to drift."
    , ScAssign "proc" (SeBare (SeCallArgs "Start-PlugVm" start-plug-vm-args))
    , ScEcho (SeText "[plug-run] VM PID $($proc.Id)")
    ]

  start-plug-vm-args : List ShellArg =
    [ SaNamed "Kernel" (SeVar "PlugCdx")
    , SaNamed "ConsoleFile" (SeVar "consoleFile")
    , SaNamed "StderrFile" (SeVar "stderrFile")
    , SaNamed "MemMB" (SeVar "MemMB")
    , SaNamed "GuestPort" (SeVar "Port")
    , SaNamed "HostPort" (SeVar "hostPort")
    ]

Section: S05 -- Wait for TCP connection

  s05-body : List ShellCmd =
    [ ScBlank
    , ScAssign "deadline" (SeMethodCall utc-now "AddSeconds" [SeInt 60])
    , ScLabeledWhile "wait_conn" (SeNot (SeMethodCall (SeVar "listener") "Pending" [])) s05-wait-once
    , ScAssign "client" (SeMethodCall (SeVar "listener") "AcceptTcpClient" [])
    , ScAssign "stream" (SeMethodCall (SeVar "client") "GetStream" [])
    , ScCallMethod (SeVar "listener") "Stop" []
    , ScEcho (SeLit "[plug-run] Connected")
    ]

  utc-now : ShellExpr = SeBare (SeStaticProp "DateTime" "UtcNow")

  s05-wait-once : List ShellCmd =
    [ ScIf (SeProperty (SeVar "proc") "HasExited") s05-vm-died []
    , ScIf (SeBare (SeIntGt utc-now (SeVar "deadline"))) [ScWriteError (SeLit "FAIL: plug did not connect within 60s"), ScExit (SeInt 5)] []
    , ScSleepMs (SeInt 100)
    ]

  s05-vm-died : List ShellCmd =
    [ ScRaw "$stderr = if (Test-Path $stderrFile) { Get-Content $stderrFile -Raw } else { '' }"
    , ScWriteError (SeText "FAIL: VM exited before connecting. stderr: $stderr")
    , ScExit (SeInt 4)
    ]

Section: S06 -- Send IR

  s06-body : List ShellCmd =
    [ ScBlank
    , ScAssign "msgLen" (SeBare (SeAdd (SeProperty (SeVar "irBytes") "Length") (SeInt 1)))
    , ScDotNetCallAssign "hdr" "BitConverter" "GetBytes" [SeCast "int" (SeVar "msgLen")]
    , ScCallMethod (SeVar "stream") "Write" [SeVar "hdr", SeInt 0, SeInt 4]
    , ScCallMethod (SeVar "stream") "WriteByte" [SeInt 1]
    , ScAssign "chunkSize" (SeInt 4096)
    , ScAssign "off" (SeInt 0)
    , ScLabeledWhile "send_loop" (SeBare (SeIntLt (SeVar "off") (SeProperty (SeVar "irBytes") "Length"))) s06-send-chunk
    , ScEcho (SeText "[plug-run] Sent $($irBytes.Length) bytes")
    ]

  s06-send-chunk : List ShellCmd =
    [ ScDotNetCallAssign "n" "Math" "Min" [SeVar "chunkSize", SeBare (SeSub (SeProperty (SeVar "irBytes") "Length") (SeVar "off"))]
    , ScCallMethod (SeVar "stream") "Write" [SeVar "irBytes", SeVar "off", SeVar "n"]
    , ScCallMethod (SeVar "stream") "Flush" []
    , ScIncrementBy "off" (SeVar "n")
    , ScIf (SeBare (SeIntLt (SeVar "off") (SeProperty (SeVar "irBytes") "Length"))) [ScSleepMs (SeInt 20)] []
    ]

Section: S07 -- Receive output

  s07-body : List ShellCmd =
    [ ScBlank
    , ScRaw "$stream.ReadTimeout = $TimeoutSec * 1000"
    , ScComment "A per-byte accumulate here cost 116.77 s for a 16 MB image against"
    , ScComment "0.02 s for the bulk write, measured 2026-08-18 over the shipped shape."
    , ScComment "The cost is the 16,777,216 interpreter iterations, not the transport."
    , ScDotNetCallAssign "allBytes" "System.IO.MemoryStream" "new" [SeInt 65536]
    , ScDotNetCallAssign "readBuf" "byte[]" "new" [SeInt 8192]
    , ScAssign "recvAborted" (SeBool False)
    , ScAssign "recvError" (SeLit "")
    , ScTry [ScLabeledWhile "recv_loop" (SeBool True) s07-read-once] s07-recv-aborted []
    , ScCallMethod (SeVar "client") "Close" []
    ]

  s07-read-once : List ShellCmd =
    [ ScAssign "n" (SeMethodCall (SeVar "stream") "Read" [SeVar "readBuf", SeInt 0, SeProperty (SeVar "readBuf") "Length"])
    , ScIf (SeBare (SeIntLe (SeVar "n") (SeInt 0))) [ScBreak] []
    , ScCallMethod (SeVar "allBytes") "Write" [SeVar "readBuf", SeInt 0, SeVar "n"]
    ]

  s07-recv-aborted : List ShellCmd =
    [ ScComment "A read timeout and a connection reset are NOT a clean end of stream,"
    , ScComment "and this catch used to say they were: the partial buffer was written"
    , ScComment "out and the script reported OK. Record which path ended the loop so a"
    , ScComment "caller can tell a complete transfer from a truncated one."
    , ScAssign "recvAborted" (SeBool True)
    , ScAssign "recvError" (SeProperty (SeProperty SeErrorText "Exception") "Message")
    ]

Section: S08 -- Write output

  s08-body : List ShellCmd =
    [ ScBlank
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "allBytes") "Length") (SeInt 0))) s08-no-output []
    , ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "Out", SeMethodCall (SeVar "allBytes") "ToArray" []]
    , ScComment "codex-vm dumps its output ring to -output ON EXIT, so grepping before the"
    , ScComment "VM has gone reads a file the guest console has not reached yet. Measured"
    , ScComment "2026-08-17: 1 byte before the wait, the guest's line only after it."
    , ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) [ScCallMethod (SeVar "proc") "WaitForExit" [SeInt 20000]] []
    , ScComment "codex-vm reports a dropped serial byte on STDERR, not on the guest"
    , ScComment "console it is dropping from. It runs first because a short console"
    , ScComment "makes every check below it read clean for the wrong reason."
    , ScAssign "dropHit" (SeArrayLiteral [])
    , ScRaw "if (Test-Path $stderrFile) { $dropHit = @(Select-String -Path $stderrFile -Pattern 'output buffer growth failed') }"
    , ScIf (hit "dropHit") [ScWriteError (SeText "FAIL: codex-vm dropped guest serial bytes, so the captured console is SHORT and no verdict read from it can be trusted -- $($dropHit[0].Line.Trim())"), ScExit (SeInt 10)] []
    , ScComment "A guest that dies mid-emission is never REFUSED, so it prints no"
    , ScComment "TRUNCATED line and closes cleanly enough that recvAborted stays false."
    , ScComment "Its own death line is the only witness."
    , ScAssign "deathHit" (SeArrayLiteral [])
    , ScRaw "if (Test-Path $consoleFile) { $deathHit = @(Select-String -Path $consoleFile -Pattern 'OUT OF MEMORY|!EXC=') }"
    , ScIf (hit "deathHit") [ScWriteError (SeText "FAIL: the plug guest died mid-run, so the output is a prefix and not an answer -- $($deathHit[0].Line.Trim()). Wrote $($allBytes.Length) bytes to $Out."), ScExit (SeInt 9)] []
    , ScAssign "truncHit" (SeArrayLiteral [])
    , ScRaw "if (Test-Path $consoleFile) { $truncHit = @(Select-String -Path $consoleFile -Pattern 'TRUNCATED sent=') }"
    , ScIf (hit "truncHit") [ScWriteError (SeText "FAIL: the plug could not send its whole output -- $($truncHit[0].Line.Trim())"), ScExit (SeInt 7)] []
    , ScIf (SeVar "recvAborted") [ScWriteError (SeText "FAIL: the receive ended by exception, not by end of stream -- $recvError. Wrote $($allBytes.Length) bytes and cannot tell whether that is all of them."), ScExit (SeInt 8)] []
    , ScEcho (SeText "[plug-run] OK: $Out ($($allBytes.Length) bytes)")
    ]

  hit : Text -> ShellExpr
  hit (name) = SeBare (SeIntGt (SeProperty (SeVar name) "Count") (SeInt 0))

  s08-no-output : List ShellCmd =
    [ ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) [ScCallMethod (SeVar "proc") "WaitForExit" [SeInt 5000]] []
    , ScRaw "$stderr = if (Test-Path $stderrFile) { Get-Content $stderrFile -Raw } else { '' }"
    , ScRaw "$console = if (Test-Path $consoleFile) { Get-Content $consoleFile -Raw } else { '' }"
    , ScWriteError (SeText "FAIL: plug produced no output. stderr: $stderr guest console: $console")
    , ScExit (SeInt 6)
    ]

Section: S09 -- Cleanup

  s09-body : List ShellCmd =
    [ ScIf (SeAnd (SeVar "proc") (SeNot (SeProperty (SeVar "proc") "HasExited"))) [ScRaw "Stop-VmGraceful -ProcessId $proc.Id"] []
    , ScRaw "if ($stderrFile) { Remove-Item -Force $stderrFile -ErrorAction SilentlyContinue }"
    , ScRaw "if ($consoleFile) { Remove-Item -Force $consoleFile -ErrorAction SilentlyContinue }"
    , ScRaw "try { if ($listener) { $listener.Stop() } } catch {}"
    ]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "resolve the repository and refuse a missing plug or IR input before a guest is started", ps-in = ["PlugCdx", "IrInput"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 2 "the plug CDX or the IR input named on the command line is not on disk"], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "read the IR and pre-null the cleanup names", ps-why = "the handler reads $proc, $stderrFile, $consoleFile and $listener, and under StrictMode an unset name THROWS, which masks the real error one throw earlier; the four are therefore assigned before anything that can fail", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "open the listener", ps-why = "the guest dials the host, so the listener accepts before the guest boots", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "boot the guest", ps-why = "starts codex-vm on the plug CDX, capturing stderr and console to temporary files", ps-in = [], ps-out = [], ps-needs = [PrGuests 1, PrKernel (SeVar "PlugCdx")], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "wait for the connection", ps-why = "distinguishes a guest that EXITED from one that never connected, because the two have different causes and the same symptom", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 4 "the guest DIED before it connected", PoExit 5 "the guest was still alive and had not connected when the wait ran out"], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "send the IR as one framed message", ps-why = "one frame with its length ahead of it, because the plug reads a length then that many bytes", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  s07 : PipeStage = PipeStage { ps-name = "receive the output", ps-why = "reads the reply under a timeout", ps-in = ["TimeoutSec"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s07-body }

  s08 : PipeStage = PipeStage { ps-name = "unframe the reply and write it", ps-why = "an empty reply is a guest that produced nothing, reported as such rather than written as an empty output", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 6 "the guest connected and sent no output at all", PoExit 7 "the reply was TRUNCATED: fewer bytes arrived than its own frame length promised", PoExit 8 "the guest reported an abort rather than a result", PoExit 9 "the guest DIED during the exchange", PoExit 10 "the serial transport dropped bytes, so the reply cannot be trusted even though one arrived"], ps-body = s08-body }

  s09 : PipeStage = PipeStage { ps-name = "cleanup", ps-why = "stops the guest, closes the listener and removes the captures HOWEVER the six stages above ended, which is why it is the group's handler", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s09-body }

  plugrun-pipe : Pipeline = Pipeline { pl-name = "plug-run", pl-doc = "Boot a plug CDX in a VM and send pre-compiled IR over TCP to produce output", pl-params = plugrun-params, pl-stages = [PsStage s01, PsStage s02, PsGroup None None (Just s09) [PsStage s03, PsStage s04, PsStage s05, PsStage s06, PsStage s07, PsStage s08]] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell plugrun-pipe))
  end

