Chapter: ExtractAnnotationsScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

 We say:

 THE TWENTY-FOURTH GENERATOR ON THE PIPELINE MODEL (PipelineModel.md). The
 emitted script is byte-identical to the one that shipped before the migration.

 THIS SCRIPT SPELLS NO `ScExit`, so every `ps-verdict` below is empty as a
 measurement rather than an omission. It is phase one of two and mutates
 nothing, therefore reporting rather than refusing is the design; the refusal
 belongs to `apply-annotations`, which rejects any block whose source has moved.

 THE REPORT HEADER STATES L-FALSIF IN THE SCRIPT'S OWN WORDS: it never proposes
 DELETE, because a keyword classifier deciding whether prose explains our own
 code would be an instrument that cannot fail. DELETE is a word only the
 auditor writes. That sentence is emitted into every report, which is the right
 place for it, and the stage below now carries the same fact where a reader of
 the pipeline can see it.

Section: Parameters

  extract-params : List ShellParam = [sh-param-optional "Src" SptString, sh-switch "All", sh-param-optional "Out" SptString]

Section: Patterns

  spec-pattern : Text = "(?i)(datasheet|data sheet|spec[a-z]*|section [0-9]|rfc ?[0-9]|ieee|802\\.|uefi|xhci|ehci|acpi|smbios|dwarf|\\belf\\b|pe32|jpeg|utf-?8|unicode|protocol|the standard|per the|requires that|must be set|must be zero|reserved|register|wire format|byte order|endian|errata|vendor|opcode)"

  magic-pattern : Text = "(#[0-9A-Fa-f]{2,}|0x[0-9A-Fa-f]+|\\b[0-9]{3,}\\b)"

  perf-pattern : Text = "(?i)(constant.time|work factor|attacker|timing attack|crackab|side.channel|throughput|hot path|cache line|(?<![a-z])heap|allocation|fuel cap|blow.?up|quadratic|amortis|amortiz)"

  hazard-pattern : Text = "(?i)(do not|does not|never |must not|cannot |silently|beware|hazard|footgun|breaks |trap\\b|careful|wrong |fails |refuses)"

  invariant-pattern : Text = "(?i)(invariant|always |guarantee|must hold|holds |precondition|postcondition|assumes )"

  measured-pattern : Text = "(?i)(measured|20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]|\\bCL [0-9]+)"

  docref-pattern : Text = "(docs/|BACKLOG|CLAUDE\\.md|\\.md\\b)"

Section: The pipeline, declared before it is spelled

 EVERY PATTERN IS AN ARTIFACT, because the two function stages below consume
 them by name and nothing else does. Deleting one from the table makes its
 reference emit `UNRESOLVED:` and reds the drift check, which is what stops the
 declarations being comments.

  ea-pat : Text -> PipeArtifact
  ea-pat (n) = PipeArtifact { pa-name = n, pa-kind = PkText, pa-expr = SeVar n, pa-from = None }

  repo-art : PipeArtifact = PipeArtifact { pa-name = "Repo", pa-kind = PkDir, pa-expr = SeVar "Repo", pa-from = Just (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))) }

  report-art : PipeArtifact = PipeArtifact { pa-name = "report", pa-kind = PkValue, pa-expr = SeVar "report", pa-from = None }

  ea-arts : List PipeArtifact = [repo-art, report-art, ea-pat "ProsePat", ea-pat "DefPat", ea-pat "TypePat", ea-pat "SectionPat", ea-pat "ChapterPat", ea-pat "SayWePat", ea-pat "SpecPat", ea-pat "MagicPat", ea-pat "PerfPat", ea-pat "HazardPat", ea-pat "InvarPat", ea-pat "MeasPat", ea-pat "DocRefPat"]

Section: S01 -- Preamble

  s01-body : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScBlank, ScAssign "ProsePat" (SeLit "^ [^ ]"), ScAssign "DefPat" (SeLit "^\\s{2}(\\S+)\\s*[:=(|]"), ScAssign "TypePat" (SeLit "^\\s{2}([A-Z][A-Za-z0-9]*)\\s*[=(]"), ScAssign "SectionPat" (SeLit "^Section:\\s*(.+?)\\s*$"), ScAssign "ChapterPat" (SeLit "^Chapter:\\s*(.+?)\\s*$"), ScAssign "SayWePat" (SeLit "^ We say:\\s*$"), ScAssign "SpecPat" (SeLit spec-pattern), ScAssign "MagicPat" (SeLit magic-pattern), ScAssign "PerfPat" (SeLit perf-pattern), ScAssign "HazardPat" (SeLit hazard-pattern), ScAssign "InvarPat" (SeLit invariant-pattern), ScAssign "MeasPat" (SeLit measured-pattern), ScAssign "DocRefPat" (SeLit docref-pattern), ScBlank, ScIf (SeNot (SeVar "Out")) [ScAssign "Out" (SePathJoin (SeVar "Repo") (SeLit "docs\\Reports\\AnnotationExtract.txt"))] [ScAssign "Out" (SeStaticCall "System.IO.Path" "GetFullPath" [SeVar "Out"])], ScAssign "report" (SeStaticCall "System.Text.StringBuilder" "new" []), ScAssign "script:blockCount" (SeInt 0), ScAssign "script:keepCount" (SeInt 0), ScAssign "script:annotateCount" (SeInt 0), ScAssign "script:proseLines" (SeInt 0), ScAssign "script:sayWeCount" (SeInt 0), ScAssign "script:filesWithProse" (SeInt 0), ScAssign "script:filesScanned" (SeInt 0)]

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "the thirteen patterns the classifier runs on, the report accumulator and the seven counters", ps-in = ["Out"], ps-out = [repo-art, report-art], ps-needs = [], ps-verdict = [], ps-body = s01-body }

Section: S02 -- Classify-Block

  sig-test : Text, Text -> ShellCmd
  sig-test (pat) (name) = ScIf (SeMatchExpr (SeVar "Text") (pipe-ref ea-arts extract-params pat)) [ScDiscard (SeMethodCall (SeVar "sig") "Add" [SeLit name])] []

  has-sig : Text -> ShellExpr
  has-sig (name) = SeContains (SeVar "sig") (SeLit name)

  s02-body : List ShellCmd = [ScBlank, ScFunction "Classify-Block" [sh-param-optional "Text" SptString] [ScAssign "sig" (SeStaticCall "System.Collections.Generic.List[string]" "new" []), sig-test "SpecPat" "spec", sig-test "MagicPat" "magic", sig-test "PerfPat" "perf", sig-test "HazardPat" "hazard", sig-test "InvarPat" "invariant", sig-test "MeasPat" "measured", sig-test "DocRefPat" "docref", ScAssign "verdict" (SeIfElse (has-sig "spec") (SeLit "KEEP") (SeIfElse (has-sig "perf") (SeLit "KEEP") (SeIfElse (has-sig "magic") (SeLit "KEEP") (SeIfElse (has-sig "hazard") (SeLit "ANNOTATE warning") (SeIfElse (has-sig "invariant") (SeLit "ANNOTATE invariant") (SeIfElse (has-sig "measured") (SeLit "ANNOTATE discovery") (SeLit "ANNOTATE rationale"))))))), ScAssign "sigs" (SeIfElse (SeIntEq (SeCount (SeVar "sig")) (SeInt 0)) (SeLit "none") (SeJoin (SeVar "sig") (SeLit ","))), ScReturn (SeConcat (SeConcat (SeVar "verdict") (SeLit "|")) (SeVar "sigs"))]]

  s02 : PipeStage = PipeStage { ps-name = "classify one block", ps-why = "seven signals decide KEEP or ANNOTATE, and DELETE is never proposed because a keyword classifier answering that question could not fail", ps-in = ["SpecPat", "MagicPat", "PerfPat", "HazardPat", "InvarPat", "MeasPat", "DocRefPat"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

Section: S03 -- Scan-File

  target-cmds : List ShellCmd = [ScAssign "target" (SeConcat (SeLit "chapter:") (SeVar "chapter")), ScAssign "j" (SeVar "blockEnd"), ScWhile (SeAnd (SeIntLt (SeVar "j") (SeVar "n")) (SeStringEq (SeTrim (SeIndex (SeVar "lines") (SeVar "j"))) (SeLit ""))) [ScIncrement "j"], ScIf (SeIntLt (SeVar "j") (SeVar "n")) [ScAssign "nl" (SeIndex (SeVar "lines") (SeVar "j")), ScIf (SeMatchExpr (SeVar "nl") (SeVar "SectionPat")) [ScAssign "target" (SeConcat (SeLit "section:") (SeIndex (SeVar "matches") (SeInt 1)))] [ScIf (SeMatchExpr (SeVar "nl") (SeVar "TypePat")) [ScAssign "target" (SeConcat (SeLit "type:") (SeIndex (SeVar "matches") (SeInt 1)))] [ScIf (SeMatchExpr (SeVar "nl") (SeVar "DefPat")) [ScAssign "target" (SeConcat (SeLit "function:") (SeIndex (SeVar "matches") (SeInt 1)))] []]]] [], ScAssign "k" (SeSub (SeVar "blockStart") (SeInt 1)), ScWhile (SeAnd (SeIntGe (SeVar "k") (SeInt 0)) (SeStringEq (SeTrim (SeIndex (SeVar "lines") (SeVar "k"))) (SeLit ""))) [ScDecrement "k"], ScIf (SeIntGe (SeVar "k") (SeInt 0)) [ScIf (SeMatchExpr (SeIndex (SeVar "lines") (SeVar "k")) (SeVar "SectionPat")) [ScAssign "target" (SeConcat (SeLit "section:") (SeIndex (SeVar "matches") (SeInt 1)))] []] [], ScIf (SeNot (SeVar "seenSection")) [ScAssign "target" (SeConcat (SeLit "chapter:") (SeVar "chapter"))] []]

  head-line : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeLit "@@ ") (SeVar "rel")) (SeLit " | ")) (SeAdd (SeVar "blockStart") (SeInt 1))) (SeLit "-")) (SeVar "blockEnd")) (SeLit " | ")) (SeVar "target")) (SeLit " | ")) (SeVar "verdict")) (SeConcat (SeLit " | ") (SeVar "sigs"))

  emit-cmds : List ShellCmd = [ScAssign "cls" (SeCall "Classify-Block" [SeJoin (SeVar "buf") (SeLit " ")]), ScAssign "parts" (SeSplit (SeVar "cls") "\\|"), ScAssign "verdict" (SeIndex (SeVar "parts") (SeInt 0)), ScAssign "sigs" (SeIndex (SeVar "parts") (SeInt 1)), ScSequence target-cmds, ScDiscard (SeMethodCall (SeVar "report") "AppendLine" [head-line]), ScForEach "bl" (SeVar "buf") [ScDiscard (SeMethodCall (SeVar "report") "AppendLine" [SeConcat (SeLit "> ") (SeVar "bl")])], ScDiscard (SeMethodCall (SeVar "report") "AppendLine" [SeLit ""]), ScIncrement "script:blockCount", ScIncrement "found", ScIncrementBy "script:proseLines" (SeCount (SeVar "buf")), ScIf (SeStringEq (SeVar "verdict") (SeLit "KEEP")) [ScIncrement "script:keepCount"] [ScIncrement "script:annotateCount"]]

  s03-body : List ShellCmd = [ScBlank, ScFunction "Scan-File" [sh-param-optional "Path" SptString] [ScAssign "lines" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "Path"]), ScAssign "n" (SeCount (SeVar "lines")), ScAssign "rel" (SeVar "Path"), ScIf (SeStartsWith (SeVar "Path") (SeVar "Repo")) [ScAssign "rel" (SeSubstringFrom (SeVar "Path") (SeAdd (SeTextLength (SeVar "Repo")) (SeInt 1)))] [], ScAssign "chapter" (SeLit ""), ScAssign "seenSection" (SeBool False), ScAssign "i" (SeInt 0), ScAssign "found" (SeInt 0), ScWhile (SeIntLt (SeVar "i") (SeVar "n")) [ScAssign "line" (SeIndex (SeVar "lines") (SeVar "i")), ScIf (SeMatchExpr (SeVar "line") (SeVar "ChapterPat")) [ScAssign "chapter" (SeIndex (SeVar "matches") (SeInt 1)), ScIncrement "i", ScContinue] [], ScIf (SeMatchExpr (SeVar "line") (SeVar "SectionPat")) [ScAssign "seenSection" (SeBool True), ScIncrement "i", ScContinue] [], ScIf (SeMatchExpr (SeVar "line") (SeVar "ProsePat")) [ScAssign "blockStart" (SeVar "i"), ScAssign "buf" (SeStaticCall "System.Collections.Generic.List[string]" "new" []), ScWhile (SeAnd (SeIntLt (SeVar "i") (SeVar "n")) (SeMatchExpr (SeIndex (SeVar "lines") (SeVar "i")) (SeVar "ProsePat"))) [ScDiscard (SeMethodCall (SeVar "buf") "Add" [SeIndex (SeVar "lines") (SeVar "i")]), ScIncrement "i"], ScAssign "blockEnd" (SeVar "i"), ScIf (SeAnd (SeIntEq (SeCount (SeVar "buf")) (SeInt 1)) (SeMatchExpr (SeIndex (SeVar "buf") (SeInt 0)) (SeVar "SayWePat"))) [ScIncrement "script:sayWeCount"] emit-cmds, ScContinue] [], ScIncrement "i"], ScIncrement "script:filesScanned", ScIf (SeIntGt (SeVar "found") (SeInt 0)) [ScIncrement "script:filesWithProse"] []]]

  s03 : PipeStage = PipeStage { ps-name = "scan one chapter", ps-why = "gather each run of column-2 prose into a block, name what it sits above, and classify it; a lone We say: marker is counted and not reported", ps-in = ["Repo", "ProsePat", "ChapterPat", "SectionPat", "SayWePat", "DefPat", "TypePat", "report"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

Section: S04 -- Main

  report-header : ShellExpr = SeLines [SeLit "# Annotation extraction report -- phase 1 of 2. READ ONLY; nothing was mutated.", SeLit "#", SeLit "# Edit the VERDICT field on each @@ header, then run build/apply-annotations.ps1.", SeLit "#   KEEP              leave the prose in the source", SeLit "#   ANNOTATE <kind>   move it to annotations/<path>.json and cut it from the source", SeLit "#   DELETE            cut it from the source and keep nothing", SeLit "#", SeLit "# This tool NEVER proposes DELETE. Whether a block explains our own code is", SeLit "# a judgement, and a keyword classifier answering it would be an instrument", SeLit "# that cannot fail. DELETE is a word only the auditor writes.", SeLit "#", SeLit "# kinds: invariant rationale warning discussion discovery todo doctrine", SeLit "# Body lines below each header are VERBATIM source. apply-annotations refuses", SeLit "# any block whose source no longer matches, so a stale report is a refusal", SeLit "# rather than a corruption. Do not reflow them.", SeLit ""]

  counts-line : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeLit "# scanned ") (SeVar "script:filesScanned")) (SeLit " chapters, ")) (SeVar "script:filesWithProse")) (SeLit " with prose; ")) (SeVar "script:blockCount")) (SeConcat (SeConcat (SeLit " blocks, ") (SeVar "script:proseLines")) (SeLit " prose lines"))

  verdict-line : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeLit "# proposed ") (SeVar "script:keepCount")) (SeLit " KEEP, ")) (SeVar "script:annotateCount")) (SeLit " ANNOTATE, 0 DELETE; ")) (SeConcat (SeVar "script:sayWeCount") (SeLit " We say: markers excluded"))

  s04-body : List ShellCmd = [ScBlank, ScIf (SeVar "Src") [ScDiscard (SeCall "Scan-File" [SePathResolve (SeVar "Src")])] [], ScIf (SeAnd (SeNot (SeVar "Src")) (SeVar "All")) [ScAssign "files" (SeArrayLiteral []), ScForEach "dir" (SeArrayLiteral [SeLit "codex", SeLit "apps"]) [ScAssign "fullDir" (SePathJoin (SeVar "Repo") (SeVar "dir")), ScIf (SeDirExists (SeVar "fullDir")) [ScIncrementBy "files" (SeListFiles (SeVar "fullDir") "*.codex" True)] []], ScForEach "f" (SeVar "files") [ScDiscard (SeCall "Scan-File" [SeProperty (SeVar "f") "FullName"])]] [], ScBlank, ScMkdir (SePathParent (SeVar "Out")), ScSetContent (SeVar "Out") (SeLines [report-header, counts-line, verdict-line, SeLit "", SeMethodCall (SeVar "report") "ToString" []]), ScEcho (SeConcat (SeLit "report: ") (SeVar "Out")), ScEcho counts-line, ScEcho verdict-line]

  s04 : PipeStage = PipeStage { ps-name = "main", ps-why = "scan one source or every chapter under codex and apps, then write the report; nothing is mutated and nothing is refused, which is what makes this phase one of two", ps-in = ["Src", "All", "Repo", "Out", "report"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

Section: Assembly

  ea-pipe : Pipeline = Pipeline { pl-name = "extract-annotations", pl-doc = "Cut column-2 prose into blocks, name each block target, propose a verdict, write the audit report", pl-params = extract-params, pl-stages = [s01, s02, s03, s04] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell ea-pipe))
  end

