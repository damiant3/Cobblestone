Chapter: TestDiskBootScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  test-disk-boot-params : List ShellParam = [sh-param-default "Img" SptString (SeRaw "(Join-Path $PSScriptRoot '..\\build-output\\Codex.img')"), sh-param-default "TimeoutSec" SptInt (SeInt 60)]

Section: S01 -- Preamble

  s01 : List ShellCmd =
    let missing = [ScRaw "throw \"Image not found: $Img\""]
    in [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScBlank, ScIf (SeNot (SeFileExists (SeVar "Img"))) missing [], ScRaw "Write-Host 'Disk boot test' -ForegroundColor Cyan"]

Section: S02 -- CodexVm Launch

  s02 : List ShellCmd =
    let cvfail = [ScRaw "Write-Host 'FAIL: codex-vm did not start' -ForegroundColor Red", ScExit (SeInt 1)]
    in [ScRaw "$run = Start-CodexVmRun -Kernel $Img -ConnectTimeoutSec 30 -MemMB 3072", ScIf (SeNot (SeVar "run")) cvfail [], ScAssign "conn" (SeProperty (SeVar "run") "Conn"), ScAssign "proc" (SeProperty (SeVar "run") "Process"), ScAssign "stdoutFile" (SeProperty (SeVar "run") "StdoutFile"), ScAssign "stderrFile" (SeProperty (SeVar "run") "StderrFile")]

Section: S03 -- QEMU Launch

  s03-args : List ShellCmd = [ScAssign "qemuArgs" (SeRaw "@('-accel','tcg','-cpu','max','-machine','kernel-irqchip=off','-drive',\"file=$Img,format=raw,if=ide\",'-chardev',(Get-VmChardevData -Port $dataPort),'-chardev',(Get-VmChardevCtrl -Port $ctrlPort),'-serial','chardev:ch0','-serial','chardev:ch1','-device','isa-debug-exit,iobase=0xf4,iosize=0x04','-netdev','user,id=net0','-device','ne2k_isa,netdev=net0,irq=9,iobase=0x300,mac=52:54:00:12:34:56','-display','none','-no-reboot','-m','2048')")]

  s03-start : List ShellCmd =
    let early-exit = [ScRaw "Write-Host \"QEMU exited immediately (code $($proc.ExitCode))\" -ForegroundColor Red", ScRaw "Get-Content $stderrFile | Write-Host -ForegroundColor Red", ScExit (SeInt 1)]
    in let no-connect = [ScRaw "Write-Host 'FAIL: could not connect to QEMU serial ports' -ForegroundColor Red", ScRaw "Stop-VmGraceful -ProcessId $proc.Id", ScExit (SeInt 1)]
    in [ScTempFile "stdoutFile", ScTempFile "stderrFile", ScRaw "$proc = Start-Process -FilePath $script:FallbackVmBin -ArgumentList $qemuArgs -PassThru -WindowStyle Hidden -RedirectStandardOutput $stdoutFile -RedirectStandardError $stderrFile", ScRaw "Start-Sleep -Milliseconds 2000", ScIf (SeProperty (SeVar "proc") "HasExited") early-exit [], ScRaw "$conn = Connect-Vm -DataPort $dataPort -CtrlPort $ctrlPort -TimeoutSec 30", ScIf (SeNot (SeVar "conn")) no-connect []]

  s03 : List ShellCmd =
    let qemu-body = [ScRaw "$dataPort = Get-VmPort", ScAssign "ctrlPort" (SeRaw "$dataPort + 1"), ScRaw "Write-Host \"  QEMU mode: ports $dataPort/$ctrlPort\" -ForegroundColor Gray", ScSequence s03-args, ScSequence s03-start]
    in [ScIf (SeVar "script:UseCodexVm") [ScSequence s02] qemu-body]

Section: S04 -- Wait for READY

  s04 : List ShellCmd = [ScRaw "Write-Host \"PID=$($proc.Id), waiting for READY...\" -ForegroundColor Gray", ScAssign "stream" (SeMethodCall (SeProperty (SeVar "conn") "Ctrl") "GetStream" []), ScAssign "ready" (SeRaw "$false"), ScForLoop "i" (SeInt 0) (SeRaw "$i -lt 20") (SeRaw "$i++") [ScRaw "$line = Read-StreamLine -Stream $stream -TimeoutSec $TimeoutSec", ScIf (SeRaw "$null -eq $line") [ScBreak] [], ScRaw "Write-Host \"  CTRL: $line\" -ForegroundColor Gray", ScIf (SeStartsWith (SeVar "line") (SeLit "READY")) [ScAssign "ready" (SeRaw "$true"), ScBreak] []]]

Section: S05 -- Result

  s05 : List ShellCmd =
    let fail-body = [ScRaw "Write-Host 'FAIL: no READY received' -ForegroundColor Red", ScRaw "Close-Vm -Conn $conn -Process $proc", ScRaw "Remove-Item -Force $stdoutFile, $stderrFile -ErrorAction SilentlyContinue", ScExit (SeInt 1)]
    in [ScIf (SeVar "ready") [ScRaw "Write-Host 'SUCCESS: Kernel booted from disk image!' -ForegroundColor Green"] fail-body]

Section: S06 -- Cleanup

  s06 : List ShellCmd = [ScRaw "Close-Vm -Conn $conn -Process $proc", ScRaw "Remove-Item -Force $stdoutFile, $stderrFile -ErrorAction SilentlyContinue"]

Section: Assembly

  test-disk-boot-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06]

  test-disk-boot-script : ShellScript = sh-script "test-disk-boot" "Boot a disk image and verify READY signal" test-disk-boot-params test-disk-boot-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell test-disk-boot-script)
  end

