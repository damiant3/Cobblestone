Chapter: RunPlugChainScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  plugchain-params : List ShellParam = [sh-param "InFile" SptString, sh-param "Output" SptString, sh-param "Plugs" SptStringArray, sh-param-default "MemMB" SptInt (SeInt 4096), sh-param-default "TimeoutSec" SptInt (SeInt 120)]

Section: S01 -- Preamble

  s01 : List ShellCmd =
    let fail = [ScRaw "[Console]::Error.WriteLine(\"MISSING: $InFile\")", ScExit (SeInt 2)]
    in [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "RunPlug" (SeRaw "Join-Path $PSScriptRoot 'run-plug.ps1'"), ScBlank, ScIf (SeNot (SeFileExists (SeVar "InFile"))) fail []]

Section: S02 -- Validate plugs

  s02 : List ShellCmd =
    let plug-fail = [ScRaw "[Console]::Error.WriteLine(\"MISSING plug CDX: $plug\")", ScExit (SeInt 2)]
    in [ScForEach "plug" (SeVar "Plugs") [ScIf (SeNot (SeFileExists (SeVar "plug"))) plug-fail []]]

Section: S03 -- Stage loop

  s03-dest : List ShellCmd =
    let last-dest = [ScAssign "dest" (SeVar "Output")]
    in let temp-dest = [ScDotNetCallAssign "dest" "System.IO.Path" "GetTempFileName" [], ScRaw "$temps += $dest"]
    in [ScAssign "isLast" (SeRaw "($i -eq ($Plugs.Count - 1))"), ScIf (SeVar "isLast") last-dest temp-dest]

  s03-run : List ShellCmd =
    let stage-fail = [ScRaw "[Console]::Error.WriteLine(\"FAIL: stage $($i + 1) ($($Plugs[$i])) exited $LASTEXITCODE\")", ScRaw "$temps | ForEach-Object { Remove-Item $_ -Force -ErrorAction SilentlyContinue }", ScExit (SeRaw "$LASTEXITCODE")]
    in [ScRaw "Write-Host \"[chain] stage $($i + 1)/$($Plugs.Count): $($Plugs[$i])\"", ScRaw "& pwsh -NoProfile -File $RunPlug -Plug $Plugs[$i] -InFile $stage -Output $dest -MemMB $MemMB -TimeoutSec $TimeoutSec", ScIf (SeRaw "$LASTEXITCODE -ne 0") stage-fail []]

  s03 : List ShellCmd = [ScAssign "stage" (SeVar "InFile"), ScAssign "temps" (SeRaw "@()"), ScForLoop "i" (SeInt 0) (SeRaw "$i -lt $Plugs.Count") (SeRaw "$i++") [ScSequence s03-dest, ScBlank, ScSequence s03-run, ScBlank, ScAssign "stage" (SeVar "dest")]]

Section: S04 -- Write final output

  s04 : List ShellCmd = [ScRaw "$temps | ForEach-Object { Remove-Item $_ -Force -ErrorAction SilentlyContinue }", ScRaw "Write-Host \"[chain] OK: $Output ($((Get-Item $Output).Length) bytes)\"", ScExit (SeInt 0)]

Section: Assembly

  plugchain-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04]

  plugchain-script : ShellScript = sh-script "run-plug-chain" "Run a chain of plug CDXs sequentially piping output from each to the next" plugchain-params plugchain-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell plugchain-script)
  end

