Chapter: PlugBuildScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 Generates a plug build.ps1 template.
 The generated PS1 accepts -PlugName and -Chapters parameters,
 dots plug-build-lib.ps1, and calls Build-TranspilerPlug.
 Compile with: -Survey "lower-mul:500000"

 We say:

Section: Parameters

  plugbuild-params : List ShellParam = []

Section: S01 -- Script Header

  s01 : List ShellCmd = [ScComment "Build plugs/<PlugName>/build-output/<PlugName>-plug.cdx", ScRaw "[CmdletBinding()]", ScRaw "param(", ScRaw "  [Parameter(Mandatory)][string]$PlugName,", ScRaw "  [Parameter(Mandatory)][string[]]$Chapters,", ScRaw "  [switch]$Force", ScRaw ")"]

Section: S02 -- Preamble

  s02 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop]

Section: S03 -- Dot-source Library

  s03 : List ShellCmd = [ScRunDot (SeRaw "(Join-Path $PSScriptRoot '..' 'plugs' 'common' 'plug-build-lib.ps1')")]

Section: S04 -- Build Invocation

  s04 : List ShellCmd = [ScAssign "plugDir" (SeRaw "Join-Path $PSScriptRoot '..' 'plugs' $PlugName"), ScIf (SeNot (SeFileExists (SeVar "plugDir"))) [ScWriteError (SeRaw "\"MISSING plug directory: $plugDir\""), ScExit (SeInt 2)] [], ScRaw "Build-TranspilerPlug -PlugDir $plugDir -PlugName $PlugName -Chapters $Chapters"]

Section: Assembly

  plugbuild-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04]

  plugbuild-script : ShellScript = sh-script "plug-build" "Build a transpiler plug CDX from name and chapter list" plugbuild-params plugbuild-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell plugbuild-script)
  end

