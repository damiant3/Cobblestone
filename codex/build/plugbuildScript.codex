Chapter: PlugBuildScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  plugbuild-params : List ShellParam = [sh-param "PlugName" SptString, sh-param "Chapters" SptStringArray, sh-param-optional "Force" SptSwitch]

Section: S01 -- Script Header

  s01 : List ShellCmd = [ScComment "Build plugs/<PlugName>/build-output/<PlugName>-plug.cdx"]

Section: S02 -- Preamble

  s02 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop]

Section: S03 -- Dot-source Library

  s03 : List ShellCmd = [ScRunDot (SeRaw "(Join-Path $PSScriptRoot '..' 'codex' 'plugs' 'common' 'plug-build-lib.ps1')")]

Section: S04 -- Build Invocation

  s04 : List ShellCmd = [ScAssign "plugDir" (SeRaw "Join-Path $PSScriptRoot '..' 'codex' 'plugs' $PlugName"), ScIf (SeNot (SeRaw "(Test-Path -PathType Container $plugDir)")) [ScWriteError (SeRaw "\"MISSING plug directory: $plugDir\""), ScExit (SeInt 2)] [], ScRaw "Build-TranspilerPlug -PlugDir $plugDir -PlugName $PlugName -Chapters $Chapters"]

Section: Assembly

  plugbuild-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04]

  plugbuild-script : ShellScript = sh-script "plug-build" "Build a transpiler plug CDX from name and chapter list" plugbuild-params plugbuild-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell plugbuild-script)
  end

