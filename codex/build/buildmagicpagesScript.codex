Chapter: BuildMagicPagesScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  magic-params : List ShellParam = [sh-param-default "Pages" SptStringArray (SeArrayLiteral [])]

Section: S01 -- Paths

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScAssign "BundleScript" (SePathJoin (SeVar "Repo") (SeLit "build\\bundle-app.ps1")), ScAssign "HtmlRunScript" (SePathJoin (SeVar "Repo") (SeLit "codex\\plugs\\html\\run.ps1")), ScAssign "AppDir" (SePathJoin (SeVar "Repo") (SeLit "apps\\games\\codexmagic")), ScAssign "WebDir" (SePathJoin (SeVar "AppDir") (SeLit "web")), ScAssign "OutDir" (SePathJoin (SeVar "WebDir") (SeLit "build-output")), ScMkdir (SeVar "OutDir")]

Section: S02 -- Default Page List

  discovered : ShellExpr = SePipe (SeListFiles (SeVar "AppDir") "*Page.codex" False) [StMap (SeProperty SeItem "BaseName")]

  s02 : List ShellCmd = [ScIf (SeIntEq (SeProperty (SeVar "Pages") "Count") (SeInt 0)) [ScAssign "Pages" discovered] []]

Section: S03 -- Per-page Paths

  html-name : ShellExpr = SeConcat (SeToLower (SeReplace (SeVar "page") "Page$" (SeLit ""))) (SeLit ".html")

  page-paths : List ShellCmd = [ScAssign "src" (SePathJoin (SeVar "AppDir") (SeConcat (SeVar "page") (SeLit ".codex"))), ScAssign "bundled" (SePathJoin (SeVar "OutDir") (SeConcat (SeVar "page") (SeLit "-bundle.codex"))), ScAssign "htmlOut" (SePathJoin (SeVar "WebDir") html-name)]

Section: S04 -- Bundle and Compile

  skip-message : ShellExpr = SeConcat (SeConcat (SeLit "SKIP: ") (SeVar "src")) (SeLit " not found")

  tag : ShellExpr = SeConcat (SeConcat (SeLit "[") (SeVar "page")) (SeLit "] ")

  bundle-args : List ShellArg = [SaSwitch "NoProfile", SaNamed "File" (SeVar "BundleScript"), SaNamed "Src" (SeVar "src"), SaNamed "Out" (SeVar "bundled")]

  html-args : List ShellArg = [SaSwitch "NoProfile", SaNamed "File" (SeVar "HtmlRunScript"), SaNamed "Src" (SeVar "bundled"), SaNamed "Out" (SeVar "htmlOut")]

  bundle-failed : List ShellCmd = [ScEchoStyled (SeConcat tag (SeLit "FAIL: bundle")) ClBrightRed True, ScContinue]

  html-failed : List ShellCmd = [ScEchoStyled (SeConcat tag (SeLit "FAIL: HTML generation")) ClBrightRed True, ScContinue]

  s04 : List ShellCmd = [ScEchoStyled (SeConcat tag (SeLit "bundling...")) ClBrightCyan True, ScRunArgs (SeLit "pwsh") bundle-args, ScIf (SeNot (SeExitCodeEq 0)) bundle-failed [], ScBlank, ScEchoStyled (SeConcat tag (SeLit "compiling to HTML...")) ClBrightCyan True, ScRunArgs (SeLit "pwsh") html-args, ScIf (SeNot (SeExitCodeEq 0)) html-failed []]

Section: S05 -- Inject Shared Assets

  css-link : Text = "<link rel=\"stylesheet\" href=\"/magic.css\">"

  magic-js : Text = "<script src=\"/magic.js\"></script>"

  card-js : Text = "<script src=\"/card-render.js\"></script>"

  auth-boot : Text = "<script>document.addEventListener(\"DOMContentLoaded\",function(){if(typeof ensureAccount===\"function\")ensureAccount()});</script>"

  build-inject : List ShellCmd = [ScAssign "inject" (SeLit css-link), ScIncrementBy "inject" (SeLit magic-js), ScIncrementBy "inject" (SeLit card-js)]

  head-repl : ShellExpr = SeConcat (SeVar "inject") (SeLit "</head>")

  body-repl : ShellExpr = SeConcat (SeLit auth-boot) (SeLit "</body>")

  utf8 : ShellExpr = SeStaticProp "System.Text.Encoding" "UTF8"

  ok-message : ShellExpr = SeConcat (SeConcat tag (SeLit "OK: ")) (SeVar "htmlOut")

  s05 : List ShellCmd = [ScDotNetCallAssign "html" "System.IO.File" "ReadAllText" [SeVar "htmlOut"], ScSequence build-inject, ScAssign "html" (SeReplace (SeVar "html") "</head>" head-repl), ScAssign "html" (SeReplace (SeVar "html") "</body>" body-repl), ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "htmlOut", SeVar "html", utf8], ScEchoStyled ok-message ClBrightGreen True]

Section: Assembly

  page-body : List ShellCmd = [ScSequence page-paths, ScIf (SeNot (SeFileExists (SeVar "src"))) [ScEchoStyled skip-message ClBrightYellow True, ScContinue] [], ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  magic-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScForEach "page" (SeVar "Pages") page-body]

  magic-script : ShellScript = sh-script "build-magic-pages" "Build CodexMagic web pages from .codex sources through the HTML plug" magic-params magic-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell magic-script)
  end

