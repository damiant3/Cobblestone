Chapter: BuildAppsScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  buildapps-params : List ShellParam = [sh-param-default "Only" SptStringArray (SeArrayLiteral [])]

Section: The pipeline, declared before it is spelled

  repo-art : PipeArtifact = PipeArtifact { pa-name = "Repo", pa-kind = PkDir, pa-expr = SeVar "Repo", pa-from = Just (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))) }

  bundle-script-art : PipeArtifact = PipeArtifact { pa-name = "BundleScript", pa-kind = PkFile, pa-expr = SeVar "BundleScript", pa-from = Just (SeBare (SePathJoinN [SeVar "Repo", SeLit "build\\bundle-app.ps1"])) }

  html-run-art : PipeArtifact = PipeArtifact { pa-name = "HtmlRunScript", pa-kind = PkFile, pa-expr = SeVar "HtmlRunScript", pa-from = Just (SeBare (SePathJoinN [SeVar "Repo", SeLit "codex\\plugs\\html\\run.ps1"])) }

  plug-cdx-art : PipeArtifact = PipeArtifact { pa-name = "PlugCdx", pa-kind = PkFile, pa-expr = SeVar "PlugCdx", pa-from = Just (SeBare (SePathJoinN [SeVar "Repo", SeLit "codex\\plugs\\html\\build-output\\html-plug.cdx"])) }

  skip-art : PipeArtifact = PipeArtifact { pa-name = "Skip", pa-kind = PkValue, pa-expr = SeVar "Skip", pa-from = Just SeHashLiteral }

  apps-art : PipeArtifact = PipeArtifact { pa-name = "apps", pa-kind = PkValue, pa-expr = SeVar "apps", pa-from = Just (SeArrayLiteral []) }

  failed-art : PipeArtifact = PipeArtifact { pa-name = "failed", pa-kind = PkValue, pa-expr = SeVar "failed", pa-from = Just (SeInt 0) }

  ba-arts : List PipeArtifact = [repo-art, bundle-script-art, html-run-art, plug-cdx-art, skip-art, apps-art, failed-art]

Section: S01 -- Preamble

  s01-body : List ShellCmd =
    [ ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , pipe-produce repo-art
    , pipe-produce bundle-script-art
    , pipe-produce html-run-art
    , pipe-produce plug-cdx-art
    ]

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "name the repository root, the bundler, the html plug runner and the plug binary", ps-in = [], ps-out = [repo-art, bundle-script-art, html-run-art, plug-cdx-art], ps-needs = [], ps-verdict = [], ps-body = s01-body }

Section: S02 -- Skip Table

  s02-body : List ShellCmd =
    [ ScBlank
    , ScComment "Known-bad apps excluded from the build"
    , pipe-produce skip-art
    ]

  s02 : PipeStage = PipeStage { ps-name = "skip table", ps-why = "apps excluded from the build, empty at head", ps-in = [], ps-out = [skip-art], ps-needs = [], ps-verdict = [], ps-body = s02-body }

Section: S03 -- Discover Apps

  s03-body : List ShellCmd =
    [ ScBlank
    , pipe-produce apps-art
    , ScForEach "html" (SeBare (SeCall "Get-ChildItem" [SePathJoin (SeVar "Repo") (SeLit "apps\\*\\web\\*.html")])) s03-one-page
    ]

  s03-one-page : List ShellCmd =
    [ ScAssign "base" (SeProperty (SeVar "html") "BaseName")
    , ScAssign "appDir" (SeProperty (SeProperty (SeVar "html") "Directory") "Parent")
    , ScRaw "$pages = @(Get-ChildItem (Join-Path $appDir.FullName '*Page.codex') | Where-Object { ($_.BaseName -replace 'WebPage$|Page$','').ToLower() -eq $base })"
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "pages") "Count") (SeInt 1))) [ScAssign "pages" (SeAsArray (SeBare (SePipe (SeVar "pages") [StWhere web-page-only])))] []
    , ScIf (SeBare (SeStringNeq (SeProperty (SeVar "pages") "Count") (SeInt 1))) [ScRaw "Write-Warning \"skip $($html.FullName): no unique Page chapter\"", ScContinue] []
    , ScIf (SeMethodCall (SeVar "Skip") "ContainsKey" [SeVar "base"]) [ScRaw "Write-Warning \"skip ${base}: $($Skip[$base])\"", ScContinue] []
    , ScAppend "apps" (SeRecord [SfField "Name" (SeVar "base"), SfField "Src" (SeProperty (SeIndex (SeVar "pages") (SeInt 0)) "FullName"), SfField "Out" (SeProperty (SeVar "html") "FullName")])
    ]

  web-page-only : ShellExpr = SeBare (SeMatch (SeProperty SeItem "BaseName") "WebPage$")

  s03 : PipeStage = PipeStage { ps-name = "discover apps", ps-why = "pair each shipped page with the one Page chapter that produces it, warning past any that is ambiguous", ps-in = ["Repo", "Skip"], ps-out = [apps-art], ps-needs = [], ps-verdict = [], ps-body = s03-body }

Section: S04 -- Filter and Validate

  s04-body : List ShellCmd =
    [ ScBlank
    , ScIf (SeBare (SeIntGt (SeProperty (SeVar "Only") "Count") (SeInt 0))) [ScAssign "apps" (SeAsArray (SeBare (SePipe (SeVar "apps") [StWhere (SeBare (SeContains (SeVar "Only") (SeProperty SeItem "Name")))])))] []
    , ScIf (SeBare (SeIntEq (SeProperty (SeVar "apps") "Count") (SeInt 0))) [ScRaw "Write-Error 'no apps discovered'; exit 2"] []
    , ScEcho (SeText "discovered $($apps.Count) apps: $(($apps | ForEach-Object { $_.Name }) -join ', ')")
    ]

  s04 : PipeStage = PipeStage { ps-name = "filter and validate", ps-why = "narrow to -Only when given, and refuse rather than report success over an empty set", ps-in = ["apps", "Only"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 2 "no app survived discovery and -Only filtering, so there was nothing to build; spelled inside a raw payload"], ps-body = s04-body }

Section: S05 -- Ensure Plug

  s05-body : List ShellCmd =
    [ ScBlank
    , ScIf (SeNot (SeFileExists (SeVar "PlugCdx"))) s05-rebuild []
    ]

  s05-rebuild : List ShellCmd =
    [ ScEchoStyled (SeLit "[build-apps] html plug missing; rebuilding...") ClBrightYellow True
    , ScRaw "& pwsh -NoProfile -File (Join-Path $Repo 'codex\\plugs\\html\\build.ps1')"
    , ScIf (SeOr (SeBare (SeStringNeq SeLastExit (SeInt 0))) (SeNot (SeFileExists (pipe-ref ba-arts buildapps-params "PlugCdx")))) [ScRaw "Write-Error 'html plug rebuild failed'; exit 3"] []
    ]

  s05 : PipeStage = PipeStage { ps-name = "ensure plug", ps-why = "rebuild the html plug if its binary is absent, because every app below is compiled through it", ps-in = ["PlugCdx", "Repo"], ps-out = [], ps-needs = [PrGuests 1], ps-verdict = [PoExit 3 "the html plug binary was missing and rebuilding it did not produce one; spelled inside a raw payload"], ps-body = s05-body }

Section: S06 -- Build Loop

  s06-body : List ShellCmd =
    [ ScBlank
    , pipe-produce failed-art
    , ScForEach "app" (pipe-ref ba-arts buildapps-params "apps") s06-one-app
    ]

  s06-one-app : List ShellCmd =
    [ ScAssign "bundleDir" (SeBare (SePathJoinN [SeVar "Repo", SeText "build-output\\apps\\$($app.Name)"]))
    , ScMkdir (SeVar "bundleDir")
    , ScAssign "bundled" (SeBare (SePathJoinN [SeVar "bundleDir", SeText "$($app.Name)-bundle.codex"]))
    , ScAssign "rendered" (SeBare (SePathJoinN [SeVar "bundleDir", SeText "$($app.Name)-rendered.html"]))
    , ScBlank
    , ScEchoStyled (SeText "[$($app.Name)] bundling...") ClBrightCyan True
    , ScRaw "& pwsh -NoProfile -File $BundleScript -Src $app.Src -Out $bundled"
    , ScIf (SeBare (SeStringNeq SeLastExit (SeInt 0))) (app-failed "bundle") []
    , ScBlank
    , ScEchoStyled (SeText "[$($app.Name)] compiling...") ClBrightCyan True
    , ScRaw "& pwsh -NoProfile -File $HtmlRunScript -Src $bundled -Out $rendered"
    , ScIf (SeBare (SeStringNeq SeLastExit (SeInt 0))) (app-failed "compile") []
    , ScBlank
    , ScRaw "$new = [System.IO.File]::ReadAllText($rendered) -replace \"`r`n\",\"`n\" -replace \"`n\",\"`r`n\""
    , ScRaw "$cur = if (Test-Path $app.Out) { [System.IO.File]::ReadAllText($app.Out) } else { '' }"
    , ScIf (SeStringEq (SeVar "new") (SeVar "cur")) [ScEchoStyled (SeText "[$($app.Name)] unchanged") ClBrightBlack True, ScContinue] []
    , ScIf page-read-only s06-open-for-edit []
    , ScDotNetCall "System.IO.File" "WriteAllText" [SeProperty (SeVar "app") "Out", SeVar "new", SeBare (SeStaticCall "System.Text.UTF8Encoding" "new" [SeBool False])]
    , ScEchoStyled (SeText "[$($app.Name)] OK: $($app.Out)") ClBrightGreen True
    ]

  app-failed : Text -> List ShellCmd
  app-failed (what) = [ScEchoStyled (SeText ("[$($app.Name)] FAIL: " & what)) ClBrightRed True, ScIncrement "failed", ScContinue]

  page-read-only : ShellExpr = SeProperty (SeCall "Get-Item" [SeProperty (SeVar "app") "Out"]) "IsReadOnly"

  s06-open-for-edit : List ShellCmd =
    [ ScRaw "& p4 edit $app.Out | Out-Null"
    , ScIf page-read-only (app-failed "p4 edit (still read-only)") []
    ]

  s06 : PipeStage = PipeStage { ps-name = "build loop", ps-why = "bundle each app, render it through the html plug, and write the page back only when it changed", ps-in = ["apps", "BundleScript", "HtmlRunScript", "Repo"], ps-out = [failed-art], ps-needs = [PrGuests 1], ps-verdict = [], ps-body = s06-body }

Section: S07 -- Summary

  s07-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "")
    , ScIf (SeBare (SeIntGt (SeVar "failed") (SeInt 0))) [ScEchoStyled (SeText "$failed app(s) failed") ClBrightRed True, ScExit (SeInt 1)] [ScEchoStyled (SeText "All $($apps.Count) apps built") ClBrightGreen True]
    ]

  s07 : PipeStage = PipeStage { ps-name = "summary", ps-why = "refuse if any app failed to bundle, compile or write", ps-in = ["failed", "apps"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "at least one app failed to bundle, to compile, or to be opened for edit"], ps-body = s07-body }

Section: Assembly

  ba-pipe : Pipeline = Pipeline { pl-name = "build-apps", pl-doc = "Build all standalone app pages through the HTML plug", pl-params = buildapps-params, pl-stages = [PsStage s01, PsStage s02, PsStage s03, PsStage s04, PsStage s05, PsStage s06, PsStage s07] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell ba-pipe))
  end

Page 1
