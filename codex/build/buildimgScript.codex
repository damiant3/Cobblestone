 We say:

Section: Parameters

  buildimg-params : List ShellParam = [sh-param "PeInput" SptString, sh-param "Out" SptString, sh-param-default "Source" SptString (SeLit ""), ShellParam { sp-name = "Font", sp-type = SptString, sp-mandatory = False, sp-default = Just (SeLit ""), sp-choices = [], sp-doc = ["A TrueType font, written to the ESP root as CMUNSS.TTF. The desktop", "loads it through its own FAT driver post-EBS (H4c)."], sp-attrs = [] }, ShellParam { sp-name = "Seed", sp-type = SptString, sp-mandatory = False, sp-default = Just (SeLit ""), sp-choices = [], sp-doc = ["The CDX seed, written to the ESP root as CODEX.CDX. The booted payload", "reads it back with its own drivers and verifies it (WakeCeremony)."], sp-attrs = [] }, ShellParam { sp-name = "Agent", sp-type = SptString, sp-mandatory = False, sp-default = Just (SeLit ""), sp-choices = [], sp-doc = ["A bundled agent: the GGUF model and its signed manifest, written to the", "ESP root as AGENT.GGU and AGENT.MAN. Produced by", "`build/make-agent-bundle.ps1`; verified in the guest by", "`apps/works/AgentBundle.codex`. Both or neither -- a model with no", "manifest is unverifiable and a manifest with no model names nothing."], sp-attrs = [] }, sh-param-default "AgentManifest" SptString (SeLit ""), ShellParam { sp-name = "Identity", sp-type = SptString, sp-mandatory = False, sp-default = Just (SeLit ""), sp-choices = [], sp-doc = ["An existing identity, written to the ESP root as IDENTITY.DAT. A stick", "WITHOUT this file boots into the first-boot wizard rather than the desk,", "so a freshly built image costs a passphrase, an entropy screen and a", "keygen before anything can be tested. Passing an identity that was", "generated on the target machine skips all of it.", "", "The key inside is the whole trust story, so this is deliberately opt-in", "and deliberately not defaulted to any path: an identity must be created", "on the machine that carries it, and an image built with a key generated", "in the bed puts a bed-generated key on the flown stick. Reuse one that", "came off the target, or leave this empty and walk the wizard."], sp-attrs = [] }, ShellParam { sp-name = "SourceDir", sp-type = SptString, sp-mandatory = False, sp-default = Just (SeLit ""), sp-choices = [], sp-doc = ["A directory of .codex chapters, written INDIVIDUALLY into an SRC", "subdirectory of the ESP. -Source puts the whole tree on as one", "concatenated file, which is what the compiler reads and what no person", "can edit; this puts the chapters on as themselves. Both, not either:", "the concat is the build input and these are the editable copies."], sp-attrs = [] }, ShellParam { sp-name = "Extra", sp-type = SptStringArray, sp-mandatory = False, sp-default = Just (SeRaw "@()"), sp-choices = [], sp-doc = ["Extra files for the ESP root, each 'NAME.EXT=path' with an 8.3 name;", "several may share one argument separated by ';' (pwsh -File hands a", "comma list to a [string[]] as ONE element). The diagnostic image carries", "DIAG.ID and DIAG.CFG this way. Written after the named optional files", "above, before SRC/ and the label."], sp-attrs = [] }, sh-param-default "TotalSectors" SptInt (SeInt 16384), ShellParam { sp-name = "Fat32", sp-type = SptSwitch, sp-mandatory = False, sp-default = None, sp-choices = [], sp-doc = ["Format the ESP as FAT32 instead of FAT16 -- the layout every vendor", "stick and every volume past 2 GB actually carries. A REAL FAT32 volume", "needs >= 65525 clusters (UEFI classifies by cluster count, the CL 7289", "lesson), so -TotalSectors must be >= ~70000 (34 MB)."], sp-attrs = [] }]

Section: P01

  p01 : List ShellCmd = [ScRaw "#", ScRaw "# Layout:", ScRaw "#   Sector 0:     Protective MBR", ScRaw "#   Sector 1:     GPT header", ScRaw "#   Sectors 2-33: GPT entries (2 partitions)", ScRaw "#   Sector 2048+: FAT ESP", ScRaw "#     EFI/BOOT/BOOTX64.EFI  (the PE)", ScRaw "#     SOURCE.SRC             (compiler source, if provided)", ScRaw "#   Top of medium: the Codex fact store partition", ScRaw "#   Last 33 sectors: backup GPT (entry array, then header AT the last sector)", ScRaw "#", ScRaw "# The second partition is why a booted stick can remember anything. DiskFacts", ScRaw "# addresses its sectors relative to a partition of type", ScRaw "# C0DE1A11-FAC7-4C0D-9E75-C0DEC0DE5EED, and on a disk that carries a partition", ScRaw "# table and no such partition it refuses to write at all -- because writing", ScRaw "# where it used to write ate the GPT. An image with one partition therefore", ScRaw "# produces a stick whose dev console reports \"0 disk facts\" forever.", ScRaw "#", ScRaw "# Usage: build-img.ps1 -PeInput <file.efi> -Out <file.img> [-Source <file>] [-TotalSectors 16384]", ScBlank, ScRaw "Set-StrictMode -Version Latest", ScRaw "$ErrorActionPreference = 'Stop'", ScRaw "trap { Write-Host \"ERROR at line $($_.InvocationInfo.ScriptLineNumber): $_\"; throw $_ }", ScBlank, ScRaw "$SectorSize = 512", ScRaw "$PartStart  = 2048", ScRaw "$LastUsable = $TotalSectors - 34            # backup entry array starts at -33", ScBlank, ScRaw "# The fact store takes an eighth of the medium off the top, capped at 128 MB", ScRaw "# and floored at 1 MB; the ESP takes the rest. These three numbers are the", ScRaw "# same policy codex/plugs/img/GptWriter.codex applies, and the two writers", ScRaw "# must agree -- a stick built by one and read by a guest that believes the", ScRaw "# other finds its store in the wrong place.", ScRaw "$FactsSectors = [Math]::Min(262144, [Math]::Max(2048, [int]($TotalSectors / 8)))", ScRaw "$FactsEnd     = $LastUsable", ScRaw "$FactsStart   = $FactsEnd - $FactsSectors + 1", ScRaw "$PartSectors  = $FactsStart - $PartStart    # the ESP, stopping below the store", ScRaw "$ImageSize    = $TotalSectors * $SectorSize", ScBlank, ScRaw "if ($PartSectors -le 0) {", ScRaw "    throw \"-TotalSectors $TotalSectors leaves no room for an ESP once the $FactsSectors-sector fact store is reserved\"", ScRaw "}", ScBlank, ScRaw "$pe = [System.IO.File]::ReadAllBytes($PeInput)", ScRaw "if ($Source -and (Test-Path $Source)) { $srcBytes = [System.IO.File]::ReadAllBytes($Source) } else { $srcBytes = [byte[]]::new(0) }", ScRaw "if ($Seed -and (Test-Path $Seed)) { $seedBytes = [System.IO.File]::ReadAllBytes($Seed) } else { $seedBytes = [byte[]]::new(0) }", ScRaw "if ($Font -and (Test-Path $Font)) { $fontBytes = [System.IO.File]::ReadAllBytes($Font) } else { $fontBytes = [byte[]]::new(0) }", ScRaw "if ($Agent -and (Test-Path $Agent)) { $agentBytes = [System.IO.File]::ReadAllBytes($Agent) } else { $agentBytes = [byte[]]::new(0) }", ScRaw "if ($AgentManifest -and (Test-Path $AgentManifest)) { $manBytes = [System.IO.File]::ReadAllBytes($AgentManifest) } else { $manBytes = [byte[]]::new(0) }", ScRaw "if (($agentBytes.Length -gt 0) -ne ($manBytes.Length -gt 0)) {", ScRaw "    throw \"-Agent and -AgentManifest go together: a model with no manifest cannot be verified, and a manifest with no model names nothing.\"", ScRaw "}", ScRaw "# A missing -Identity is a hard error rather than an empty byte array, unlike", ScRaw "# every optional input above. Falling back silently would produce an image that", ScRaw "# looks right, builds clean, and boots into the wizard the caller passed this"]

Section: P02

  p02 : List ShellCmd = [ScRaw "# flag to avoid -- and the caller finds out at the machine, after a flash.", ScRaw "if ($Identity) {", ScRaw "    if (-not (Test-Path -PathType Leaf $Identity)) { throw \"-Identity file not found: $Identity\" }", ScRaw "    $identBytes = [System.IO.File]::ReadAllBytes($Identity)", ScRaw "    if ($identBytes.Length -eq 0) { throw \"-Identity file is empty: $Identity\" }", ScRaw "} else { $identBytes = [byte[]]::new(0) }", ScRaw "$extraFiles = @()", ScRaw "foreach ($e in ($Extra -join ';').Split(';', [StringSplitOptions]::RemoveEmptyEntries)) {", ScRaw "    $eq = $e.IndexOf('=')", ScRaw "    if ($eq -lt 1) { throw \"-Extra entry must be NAME.EXT=path: $e\" }", ScRaw "    $ename = $e.Substring(0, $eq).ToUpper()", ScRaw "    $epath = $e.Substring($eq + 1)", ScRaw "    if ($ename -notmatch '^[A-Z0-9_]{1,8}(\\.[A-Z0-9_]{1,3})?$') { throw \"-Extra name is not 8.3: $ename\" }", ScRaw "    if (-not (Test-Path -PathType Leaf $epath)) { throw \"-Extra file not found: $epath\" }", ScRaw "    $eparts = $ename.Split('.')", ScRaw "    $eshort = $eparts[0].PadRight(8) + $(if ($eparts.Count -gt 1) { $eparts[1].PadRight(3) } else { '   ' })", ScRaw "    $extraFiles += ,@($eshort, [System.IO.File]::ReadAllBytes($epath))", ScRaw "}", ScBlank, ScRaw "Write-Host \"[build-img] PE=$($pe.Length) bytes  Source=$($srcBytes.Length) bytes  Seed=$($seedBytes.Length) bytes  Agent=$($agentBytes.Length) bytes  Image=$($ImageSize / 1MB) MB\"", ScRaw "if ($identBytes.Length -gt 0) {", ScRaw "    Write-Host \"[build-img] IDENTITY.DAT=$($identBytes.Length) bytes from $Identity -- skips the FIRST-BOOT WIZARD (keygen, entropy, confirm)\"", ScRaw "} else {", ScRaw "    Write-Host \"[build-img] no -Identity: this image runs the FIRST-BOOT WIZARD before the desk\"", ScRaw "}", ScRaw "Write-Host \"[build-img] ESP LBA $PartStart..$($PartStart + $PartSectors - 1) ($([math]::Round($PartSectors * $SectorSize / 1MB, 1)) MB)  facts LBA $FactsStart..$FactsEnd ($([math]::Round($FactsSectors * $SectorSize / 1MB, 1)) MB)\"", ScRaw "$payloadBytes = $pe.Length + $srcBytes.Length + $seedBytes.Length + $agentBytes.Length + $manBytes.Length", ScRaw "if ($payloadBytes -gt ($PartSectors * $SectorSize * 0.9)) {", ScRaw "    throw \"payload $payloadBytes bytes does not fit in $($PartSectors * $SectorSize); raise -TotalSectors\"", ScRaw "}", ScBlank, ScRaw "$img = New-Object byte[] $ImageSize", ScBlank, ScRaw "function W8($off, $v) { $img[$off] = [byte]$v }", ScRaw "function W16($off, $v) { [BitConverter]::GetBytes([ushort]$v).CopyTo($img, $off) }", ScRaw "function W32($off, $v) { [BitConverter]::GetBytes([int]$v).CopyTo($img, $off) }", ScRaw "function W64($off, $v) { [BitConverter]::GetBytes([ulong]$v).CopyTo($img, $off) }", ScRaw "function WBytes($off, $bs) { [Array]::Copy($bs, 0, $img, $off, $bs.Length) }", ScRaw "function WStr($off, $s, $len) {", ScRaw "    $b = [System.Text.Encoding]::ASCII.GetBytes($s)", ScRaw "    $n = [Math]::Min($b.Length, $len)", ScRaw "    [Array]::Copy($b, 0, $img, $off, $n)", ScRaw "}", ScBlank, ScRaw "# --- Protective MBR (sector 0) ---", ScRaw "W32 0x1B8 0xC0DEC0DE # MBR disk signature: nonzero, or Windows stamps its own", ScRaw "                     # random one into the live disk on enumeration", ScRaw "W8 0x1BE 0x00       # Status: inactive", ScRaw "W8 0x1C2 0xEE       # Type: GPT protective", ScRaw "W32 0x1C6 1          # LBA start", ScRaw "W32 0x1CA ($TotalSectors - 1)  # LBA size", ScRaw "W16 0x1FE 0xAA55    # Boot signature", ScBlank, ScRaw "# --- GPT Header (sector 1) ---", ScRaw "$gptOff = $SectorSize", ScRaw "WStr $gptOff \"EFI PART\" 8", ScRaw "W32 ($gptOff + 8) 0x00010000   # Revision 1.0", ScRaw "W32 ($gptOff + 12) 92          # Header size", ScRaw "W32 ($gptOff + 16) 0           # CRC32 (filled later)", ScRaw "W32 ($gptOff + 20) 0           # Reserved", ScRaw "W64 ($gptOff + 24) 1           # MyLBA", ScRaw "W64 ($gptOff + 32) ($TotalSectors - 1) # AlternateLBA", ScRaw "# 128 ENTRIES AND FirstUsableLBA 34, BECAUSE ANYTHING ELSE INVITES WINDOWS TO", ScRaw "# \"REPAIR\" THE TABLE, AND ITS REPAIR LEAVES THE DISK UNBOOTABLE.", ScRaw "#", ScRaw "# UEFI reserves a MINIMUM of 16,384 bytes for the partition entry array: 128", ScRaw "# entries of 128 bytes, LBA 2 through 33, with FirstUsableLBA at 34. This"]

Section: P03

  p03 : List ShellCmd = [ScRaw "# header used to declare NumberOfPartitionEntries=2 (a 256-byte array) while", ScRaw "# putting FirstUsableLBA at 2048, and the tail already reserved the full 33", ScRaw "# sectors -- LastUsableLBA is TotalSectors-34 immediately below -- so the image", ScRaw "# was internally inconsistent: it reserved room for 128 entries at the back and", ScRaw "# claimed 2 at the front.", ScRaw "#", ScRaw "# Measured 2026-07-29: Windows repairs that table on sight, and its repair is", ScRaw "# not cosmetic. PartitionEntryLBA is moved to sit immediately below", ScRaw "# FirstUsableLBA (2 -> 2047), LastUsableLBA is moved to sit immediately below", ScRaw "# the backup array (-34 -> -2), the backup array is moved to TotalSectors-2,", ScRaw "# and the header CRCs are recomputed while the array CRC is left stale. Both", ScRaw "# GPTs then fail validation, the good array is orphaned at LBA 2, and Windows", ScRaw "# itself reports the disk as MBR. Firmware sees no partitions, which is the", ScRaw "# \"firmware never lists the stick\" failure in HardwareSitting section 3b.", ScRaw "#", ScRaw "# The trigger is any partition-table re-read, and a raw write is one: AutoPlay", ScRaw "# fires DURING the flash and the repair races the flasher, which is how", ScRaw "# flash-usb's own fixup readback caught LBA 1 changing under it. Three", ScRaw "# hypotheses were tested and killed first -- physical reinsertion, the", ScRaw "# deterministic disk GUID, and disabling automount with mountvol /N -- so this", ScRaw "# is what is left, and it is the one that matches what the repair changes.", ScRaw "#", ScRaw "# Rufus writes bootable sticks on this same Windows and they survive, which is", ScRaw "# the existence proof that the behaviour is ours to avoid rather than Windows's", ScRaw "# to be endured. Give it a conforming table and it has nothing to normalise.", ScRaw "W64 ($gptOff + 40) 34          # FirstUsableLBA, immediately after the array", ScRaw "W64 ($gptOff + 48) ($TotalSectors - 34) # LastUsableLBA", ScRaw "# Disk GUID: deterministic so the .img reproduces byte for byte and a recorded", ScRaw "# digest means something. flash-usb randomises it on the MEDIUM at flash time.", ScRaw "WBytes ($gptOff + 56) ([byte[]]@(0xC0,0xDE,0xC0,0xDE,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0A,0x0B,0x0C))", ScRaw "W64 ($gptOff + 72) 2           # PartitionEntryLBA", ScRaw "W32 ($gptOff + 80) 128         # NumberOfPartitionEntries (UEFI 16 KB minimum)", ScRaw "W32 ($gptOff + 84) 128         # SizeOfPartitionEntry", ScRaw "W32 ($gptOff + 88) 0           # PartitionEntryArrayCRC32 (filled later)", ScBlank, ScRaw "# --- GPT Partition Entry 0: the ESP (sector 2) ---", ScRaw "$peOff = 2 * $SectorSize", ScRaw "# EFI System Partition GUID: C12A7328-F81F-11D2-BA4B-00A0C93EC93B", ScRaw "WBytes $peOff ([byte[]]@(0x28,0x73,0x2A,0xC1,0x1F,0xF8,0xD2,0x11,0xBA,0x4B,0x00,0xA0,0xC9,0x3E,0xC9,0x3B))", ScRaw "# Unique partition GUID", ScRaw "WBytes ($peOff + 16) ([byte[]]@(0xAA,0xBB,0xCC,0xDD,0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xAA,0xBB,0xCC))", ScRaw "W64 ($peOff + 32) $PartStart", ScRaw "W64 ($peOff + 40) ($PartStart + $PartSectors - 1)", ScRaw "W64 ($peOff + 48) 0           # Attributes", ScRaw "# Partition name: \"EFI System\" in UTF-16LE", ScRaw "$pName = [System.Text.Encoding]::Unicode.GetBytes(\"EFI System\")", ScRaw "WBytes ($peOff + 56) $pName", ScBlank, ScRaw "# --- GPT Partition Entry 1: the Codex fact store ---", ScRaw "# Type C0DE1A11-FAC7-4C0D-9E75-C0DEC0DE5EED, mixed-endian on the medium. This", ScRaw "# is the same 16 bytes as gpt-codex-facts-guid in codex/foreword/core/Gpt.codex", ScRaw "# and in codex/plugs/img/GptWriter.codex; all three must agree.", ScRaw "$fsOff = $peOff + 128", ScRaw "WBytes $fsOff ([byte[]]@(0x11,0x1A,0xDE,0xC0,0xC7,0xFA,0x0D,0x4C,0x9E,0x75,0xC0,0xDE,0xC0,0xDE,0x5E,0xED))", ScRaw "WBytes ($fsOff + 16) ([byte[]]@(0xAA,0xBB,0xCC,0xDD,0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xAA,0xBB,0xCD))"]

Section: P04

  p04 : List ShellCmd = [ScRaw "W64 ($fsOff + 32) $FactsStart", ScRaw "W64 ($fsOff + 40) $FactsEnd", ScRaw "W64 ($fsOff + 48) 0           # Attributes", ScRaw "$fName = [System.Text.Encoding]::Unicode.GetBytes(\"Codex Facts\")", ScRaw "WBytes ($fsOff + 56) $fName", ScBlank, ScRaw "# --- CRC32 for partition entries ---", ScRaw "function Crc32($data, $off, $len) {", ScRaw "    [long]$crc = 0xFFFFFFFF", ScRaw "    for ($i = 0; $i -lt $len; $i++) {", ScRaw "        $crc = $crc -bxor $data[$off + $i]", ScRaw "        for ($j = 0; $j -lt 8; $j++) {", ScRaw "            if ($crc -band 1) { $crc = (($crc -shr 1) -band 0x7FFFFFFF) -bxor 0xEDB88320 }", ScRaw "            else { $crc = ($crc -shr 1) -band 0x7FFFFFFF }", ScRaw "        }", ScRaw "    }", ScRaw "    return ($crc -bxor 0xFFFFFFFF) -band 0xFFFFFFFF", ScRaw "}", ScBlank, ScRaw "# The CRC covers NumberOfPartitionEntries * SizeOfPartitionEntry, which is now", ScRaw "# the full 16,384-byte reservation and not just the two populated entries. The", ScRaw "# figure has to match the header fields above or firmware rejects the table;", ScRaw "# the unused entries are zero and are part of the covered range.", ScRaw "$entryArrayBytes = 128 * 128", ScRaw "$entryCrc = Crc32 $img (2 * $SectorSize) $entryArrayBytes", ScRaw "W32 ($gptOff + 88) $entryCrc", ScBlank, ScRaw "# GPT header CRC (bytes 0-91 of header, with CRC field zeroed)", ScRaw "$hdrCrc = Crc32 $img $gptOff 92", ScRaw "W32 ($gptOff + 16) $hdrCrc", ScBlank, ScRaw "# --- Backup GPT (spec-required; the primary's AlternateLBA already points at", ScRaw "# the last sector). Entry array just below the backup header, header AT the", ScRaw "# image's last sector. Firmware that validates the backup (Dell) refuses the", ScRaw "# disk without this; Windows \"repairs\" any image that omits it on insertion.", ScRaw "$bakArrLba = $TotalSectors - 33", ScRaw "[Array]::Copy($img, 2 * $SectorSize, $img, $bakArrLba * $SectorSize, $entryArrayBytes)", ScRaw "$bakHdrOff = ($TotalSectors - 1) * $SectorSize", ScRaw "[Array]::Copy($img, $gptOff, $img, $bakHdrOff, 92)", ScRaw "W32 ($bakHdrOff + 16) 0                 # CRC32 (recomputed below)", ScRaw "W64 ($bakHdrOff + 24) ($TotalSectors - 1)  # MyLBA", ScRaw "W64 ($bakHdrOff + 32) 1                 # AlternateLBA -> primary", ScRaw "W64 ($bakHdrOff + 72) $bakArrLba        # PartitionEntryLBA", ScRaw "$bakCrc = Crc32 $img $bakHdrOff 92", ScRaw "W32 ($bakHdrOff + 16) $bakCrc", ScBlank, ScRaw "# --- FAT Partition (FAT16 default, FAT32 with -Fat32) ---", ScRaw "$fatBase = $PartStart * $SectorSize", ScRaw "$bytesPerSector = 512", ScRaw "$numFats = 2", ScBlank, ScRaw "if ($Fat32) {", ScRaw "    # A REAL FAT32 volume has >= 65525 clusters -- UEFI classifies by cluster", ScRaw "    # count (the FAT12/16 mislabel lesson, CL 7289), so a smaller volume", ScRaw "    # formatted \"FAT32\" reads back as something else on real firmware."]

Section: P05

  p05 : List ShellCmd = [ScRaw "    $reservedSectors = 32", ScRaw "    $rootDirSectors = 0", ScRaw "    $sectorsPerCluster = 0", ScRaw "    foreach ($try in 1,2,4,8,16,32,64) {", ScRaw "        $fs = [int][Math]::Ceiling((($PartSectors / $try) + 2) * 4 / 512)", ScRaw "        $data = $PartSectors - ($reservedSectors + $numFats * $fs)", ScRaw "        $cl = [int][Math]::Floor($data / $try)", ScRaw "        if ($cl -ge 65525 -and $cl -le 1000000) { $sectorsPerCluster = $try; break }", ScRaw "    }", ScRaw "    if ($sectorsPerCluster -eq 0) { throw \"FAT32 needs 65525..1000000 clusters; raise -TotalSectors (>= ~70000 sectors / 34 MB).\" }", ScRaw "    $fatSectors = [int][Math]::Ceiling((($PartSectors / $sectorsPerCluster) + 2) * 4 / 512)", ScRaw "    $dataSector0 = $reservedSectors + $numFats * $fatSectors", ScRaw "    $dataClusters = [int][Math]::Floor(($PartSectors - $dataSector0) / $sectorsPerCluster)", ScRaw "    Write-Host \"[build-img] FAT32: spc=$sectorsPerCluster clusters=$dataClusters (must be >= 65525)\"", ScRaw "    if ($dataClusters -lt 65525) { throw \"FAT32 needs >= 65525 clusters; got $dataClusters. Raise -TotalSectors.\" }", ScBlank, ScRaw "    WBytes $fatBase ([byte[]]@(0xEB, 0x58, 0x90))  # Jump + NOP (FAT32 jump target)", ScRaw "    WStr ($fatBase + 3) \"CODEX   \" 8", ScRaw "    W16 ($fatBase + 11) $bytesPerSector", ScRaw "    W8  ($fatBase + 13) $sectorsPerCluster", ScRaw "    W16 ($fatBase + 14) $reservedSectors", ScRaw "    W8  ($fatBase + 16) $numFats", ScRaw "    W16 ($fatBase + 17) 0                          # RootEntCnt: none, root is a chain", ScRaw "    W16 ($fatBase + 19) 0                          # TotalSectors16", ScRaw "    W8  ($fatBase + 21) 0xF8                       # Media type", ScRaw "    W16 ($fatBase + 22) 0                          # FATSz16: zero marks FAT32", ScRaw "    W16 ($fatBase + 24) 63", ScRaw "    W16 ($fatBase + 26) 255", ScRaw "    W32 ($fatBase + 28) $PartStart                 # HiddenSectors", ScRaw "    W32 ($fatBase + 32) $PartSectors               # TotalSectors32", ScRaw "    W32 ($fatBase + 36) $fatSectors                # FATSz32", ScRaw "    W16 ($fatBase + 40) 0                          # ExtFlags: mirrored FATs", ScRaw "    W16 ($fatBase + 42) 0                          # FSVer", ScRaw "    W32 ($fatBase + 44) 2                          # RootClus", ScRaw "    W16 ($fatBase + 48) 1                          # FSInfo sector", ScRaw "    W16 ($fatBase + 50) 6                          # Backup boot sector", ScRaw "    W8  ($fatBase + 64) 0x80                       # DriveNumber", ScRaw "    W8  ($fatBase + 66) 0x29                       # Extended boot sig", ScRaw "    W32 ($fatBase + 67) 0xC0DEC0DE                 # Volume serial", ScRaw "    WStr ($fatBase + 71) \"CODEX      \" 11", ScRaw "    WStr ($fatBase + 82) \"FAT32   \" 8", ScRaw "    W16 ($fatBase + 510) 0xAA55", ScBlank, ScRaw "    # FSInfo (sector 1): lead/struc signatures, free count and next-free", ScRaw "    # left \"unknown\" -- the hints are advisory by spec.", ScRaw "    $fsiOff = $fatBase + 512", ScRaw "    W32 $fsiOff 0x41615252", ScRaw "    W32 ($fsiOff + 484) 0x61417272", ScRaw "    W32 ($fsiOff + 488) (-1)", ScRaw "    W32 ($fsiOff + 492) (-1)", ScRaw "    W16 ($fsiOff + 510) 0xAA55", ScRaw "} else {", ScRaw "    $reservedSectors = 1", ScRaw "    $rootEntries = 512", ScRaw "    $rootDirSectors = [int][Math]::Ceiling($rootEntries * 32 / $bytesPerSector)"]

Section: P06

  p06 : List ShellCmd = [ScBlank, ScRaw "    # Choose sectors-per-cluster so the cluster count lands SOLIDLY in the FAT16", ScRaw "    # range (4085..65524). UEFI firmware determines FAT type by cluster count, not", ScRaw "    # by the \"FAT16\" label string -- an 8 MB image at spc=4 yields ~3560 clusters,", ScRaw "    # which the spec classifies as FAT12; the firmware then reads our 16-bit FAT as", ScRaw "    # 12-bit, misfollows every chain, and reports \"no boot device.\" Pick the", ScRaw "    # smallest power-of-two spc that keeps clusters <= 60000 (margin under 65524),", ScRaw "    # which also maximizes clusters to stay well above the 4085 FAT12 boundary.", ScRaw "    $sectorsPerCluster = 1", ScRaw "    foreach ($try in 1,2,4,8,16,32,64) {", ScRaw "        $fs = [int][Math]::Ceiling(($PartSectors / $try + 2) / 256)", ScRaw "        $data = $PartSectors - ($reservedSectors + $numFats * $fs + $rootDirSectors)", ScRaw "        $cl = [int][Math]::Floor($data / $try)", ScRaw "        if ($cl -le 60000) { $sectorsPerCluster = $try; break }", ScRaw "    }", ScRaw "    $fatSectors = [int][Math]::Ceiling(($PartSectors / $sectorsPerCluster + 2) / 256)", ScRaw "    $dataSector0 = $reservedSectors + $numFats * $fatSectors + $rootDirSectors", ScRaw "    $dataClusters = [int][Math]::Floor(($PartSectors - $dataSector0) / $sectorsPerCluster)", ScRaw "    Write-Host \"[build-img] FAT16: spc=$sectorsPerCluster clusters=$dataClusters (must be 4085..65524)\"", ScRaw "    if ($dataClusters -lt 4085) { throw \"FAT16 needs >= 4085 clusters; got $dataClusters (image too small). Increase TotalSectors.\" }", ScRaw "    if ($dataClusters -gt 65524) { throw \"FAT16 allows <= 65524 clusters; got $dataClusters. Raise spc cap.\" }", ScBlank, ScRaw "    # BPB (BIOS Parameter Block)", ScRaw "    WBytes $fatBase ([byte[]]@(0xEB, 0x3C, 0x90))  # Jump + NOP", ScRaw "    WStr ($fatBase + 3) \"CODEX   \" 8               # OEM name", ScRaw "    W16 ($fatBase + 11) $bytesPerSector", ScRaw "    W8  ($fatBase + 13) $sectorsPerCluster", ScRaw "    W16 ($fatBase + 14) $reservedSectors", ScRaw "    W8  ($fatBase + 16) $numFats", ScRaw "    W16 ($fatBase + 17) $rootEntries", ScRaw "    W16 ($fatBase + 19) 0                           # TotalSectors16 (0 = use 32-bit)", ScRaw "    W8  ($fatBase + 21) 0xF8                        # Media type", ScRaw "    W16 ($fatBase + 22) $fatSectors", ScRaw "    W16 ($fatBase + 24) 63                          # SectorsPerTrack", ScRaw "    W16 ($fatBase + 26) 255                         # NumHeads", ScRaw "    W32 ($fatBase + 28) $PartStart                  # HiddenSectors", ScRaw "    W32 ($fatBase + 32) $PartSectors                # TotalSectors32", ScRaw "    W8  ($fatBase + 36) 0x80                        # DriveNumber", ScRaw "    W8  ($fatBase + 38) 0x29                        # Extended boot sig", ScRaw "    W32 ($fatBase + 39) 0xC0DEC0DE                  # Volume serial", ScRaw "    WStr ($fatBase + 43) \"CODEX      \" 11           # Volume label", ScRaw "    WStr ($fatBase + 54) \"FAT16   \" 8               # FS type", ScRaw "    W16 ($fatBase + 510) 0xAA55                     # Boot signature", ScRaw "}", ScBlank, ScRaw "# FAT tables", ScRaw "$fat1Off = $fatBase + $reservedSectors * $bytesPerSector", ScRaw "$fat2Off = $fat1Off + $fatSectors * $bytesPerSector", ScBlank, ScRaw "# One FAT entry in BOTH copies, at the volume's width. FAT32 entries keep", ScRaw "# the reserved top nibble zero.", ScRaw "$EOC = if ($Fat32) { 0x0FFFFFFF } else { 0xFFFF }", ScRaw "function Set-Fat($cluster, $value) {", ScRaw "    if ($Fat32) {", ScRaw "        [BitConverter]::GetBytes([uint32]$value).CopyTo($img, $fat1Off + $cluster * 4)"]

Section: P07

  p07 : List ShellCmd = [ScRaw "        [BitConverter]::GetBytes([uint32]$value).CopyTo($img, $fat2Off + $cluster * 4)", ScRaw "    } else {", ScRaw "        [BitConverter]::GetBytes([ushort]$value).CopyTo($img, $fat1Off + $cluster * 2)", ScRaw "        [BitConverter]::GetBytes([ushort]$value).CopyTo($img, $fat2Off + $cluster * 2)", ScRaw "    }", ScRaw "}", ScBlank, ScRaw "# FAT entries: cluster 0 = media, cluster 1 = end-of-chain marker", ScRaw "if ($Fat32) {", ScRaw "    Set-Fat 0 0x0FFFFFF8", ScRaw "    Set-Fat 1 0x0FFFFFFF", ScRaw "    Set-Fat 2 $EOC          # root directory: one cluster", ScRaw "} else {", ScRaw "    Set-Fat 0 0xFFF8", ScRaw "    Set-Fat 1 0xFFFF", ScRaw "}", ScBlank, ScRaw "# Root directory: FAT16 has a fixed region after the FATs; FAT32's root is", ScRaw "# cluster 2, the first data cluster.", ScRaw "$dataOff = $fatBase + $dataSector0 * $bytesPerSector", ScRaw "$rootOff = if ($Fat32) { $dataOff } else { $fat2Off + $fatSectors * $bytesPerSector }", ScBlank, ScRaw "# Create EFI directory entry in root. The cluster's high word always lands", ScRaw "# at offset 20 -- zero on FAT16, load-bearing on FAT32.", ScRaw "function Add-DirEntry($dirOff, $idx, $name, $attr, $cluster, $size) {", ScRaw "    $eOff = $dirOff + $idx * 32", ScRaw "    WStr $eOff $name 11", ScRaw "    W8 ($eOff + 11) $attr", ScRaw "    W16 ($eOff + 20) ($cluster -shr 16)", ScRaw "    W16 ($eOff + 26) ($cluster -band 0xFFFF)", ScRaw "    W32 ($eOff + 28) $size", ScRaw "}", ScBlank, ScRaw "# Helper: allocate clusters for a file, write to FAT", ScRaw "$nextCluster = if ($Fat32) { 3 } else { 2 }", ScRaw "function Alloc-File([byte[]]$fileData) {", ScRaw "    $clustSz = $sectorsPerCluster * $bytesPerSector", ScRaw "    $fileLen = $fileData.Length", ScRaw "    $numClusters = [int][Math]::Ceiling($fileLen / $clustSz)", ScRaw "    $startCluster = $script:nextCluster", ScRaw "    for ($c = 0; $c -lt $numClusters; $c++) {", ScRaw "        $cn = $startCluster + $c", ScRaw "        $fatEntry = if ($c -eq $numClusters - 1) { $EOC } else { $cn + 1 }", ScRaw "        Set-Fat $cn $fatEntry", ScRaw "        $fileOff = $dataOff + ($cn - 2) * $clustSz", ScRaw "        $srcOff = $c * $clustSz", ScRaw "        $chunkLen = [Math]::Min($fileLen - $srcOff, $clustSz)", ScRaw "        [Array]::Copy($fileData, $srcOff, $img, $fileOff, $chunkLen)", ScRaw "    }", ScRaw "    $script:nextCluster += $numClusters", ScRaw "    return $startCluster", ScRaw "}", ScBlank, ScRaw "# Create EFI directory (subdirectory)", ScRaw "$efiCluster = $script:nextCluster"]

Section: P08

  p08 : List ShellCmd = [ScRaw "$script:nextCluster++", ScRaw "$clustSz = $sectorsPerCluster * $bytesPerSector", ScRaw "$efiDirOff = $dataOff + ($efiCluster - 2) * $clustSz", ScRaw "# FAT: EFI dir is 1 cluster, end-of-chain", ScRaw "Set-Fat $efiCluster $EOC", ScRaw "# . and .. entries", ScRaw "Add-DirEntry $efiDirOff 0 \".          \" 0x10 $efiCluster 0", ScRaw "Add-DirEntry $efiDirOff 1 \"..         \" 0x10 0 0", ScBlank, ScRaw "# Create BOOT subdirectory inside EFI", ScRaw "$bootCluster = $script:nextCluster", ScRaw "$script:nextCluster++", ScRaw "$bootDirOff = $dataOff + ($bootCluster - 2) * $clustSz", ScRaw "Set-Fat $bootCluster $EOC", ScRaw "Add-DirEntry $bootDirOff 0 \".          \" 0x10 $bootCluster 0", ScRaw "Add-DirEntry $bootDirOff 1 \"..         \" 0x10 $efiCluster 0", ScBlank, ScRaw "# Add BOOT entry to EFI dir", ScRaw "Add-DirEntry $efiDirOff 2 \"BOOT       \" 0x10 $bootCluster 0", ScBlank, ScRaw "# Write BOOTX64.EFI into BOOT directory", ScRaw "$peFileCluster = Alloc-File $pe", ScRaw "Add-DirEntry $bootDirOff 2 \"BOOTX64 EFI\" 0x20 $peFileCluster $pe.Length", ScBlank, ScRaw "# Add EFI entry to root directory", ScRaw "Add-DirEntry $rootOff 0 \"EFI        \" 0x10 $efiCluster 0", ScBlank, ScRaw "# Write SOURCE.SRC and CODEX.CDX if provided, then the volume label. Root", ScRaw "# entries are indexed in order, so each optional file shifts the label.", ScRaw "$rootIdx = 1", ScRaw "if ($srcBytes.Length -gt 0) {", ScRaw "    $srcCluster = Alloc-File $srcBytes", ScRaw "    Add-DirEntry $rootOff $rootIdx \"SOURCE  SRC\" 0x20 $srcCluster $srcBytes.Length", ScRaw "    $rootIdx++", ScRaw "}", ScRaw "if ($seedBytes.Length -gt 0) {", ScRaw "    $seedCluster = Alloc-File $seedBytes", ScRaw "    Add-DirEntry $rootOff $rootIdx \"CODEX   CDX\" 0x20 $seedCluster $seedBytes.Length", ScRaw "    $rootIdx++", ScRaw "}", ScRaw "if ($fontBytes.Length -gt 0) {", ScRaw "    $fontCluster = Alloc-File $fontBytes", ScRaw "    Add-DirEntry $rootOff $rootIdx \"CMUNSS  TTF\" 0x20 $fontCluster $fontBytes.Length", ScRaw "    $rootIdx++", ScRaw "}", ScRaw "if ($agentBytes.Length -gt 0) {", ScRaw "    $agentCluster = Alloc-File $agentBytes", ScRaw "    Add-DirEntry $rootOff $rootIdx \"AGENT   GGU\" 0x20 $agentCluster $agentBytes.Length", ScRaw "    $rootIdx++", ScRaw "    $manCluster = Alloc-File $manBytes", ScRaw "    Add-DirEntry $rootOff $rootIdx \"AGENT   MAN\" 0x20 $manCluster $manBytes.Length", ScRaw "    $rootIdx++", ScRaw "}", ScRaw "if ($identBytes.Length -gt 0) {", ScRaw "    $identCluster = Alloc-File $identBytes"]

Section: P09

  p09 : List ShellCmd = [ScRaw "    Add-DirEntry $rootOff $rootIdx \"IDENTITYDAT\" 0x20 $identCluster $identBytes.Length", ScRaw "    $rootIdx++", ScRaw "}", ScRaw "foreach ($ef in $extraFiles) {", ScRaw "    $efCluster = if ($ef[1].Length -gt 0) { Alloc-File $ef[1] } else { 0 }", ScRaw "    Add-DirEntry $rootOff $rootIdx $ef[0] 0x20 $efCluster $ef[1].Length", ScRaw "    $rootIdx++", ScRaw "}", ScBlank, ScRaw "# The chapters as individual files, in SRC/.", ScRaw "#", ScRaw "# A FAT short name is eight characters and three, uppercase, with no dot", ScRaw "# stored, so `X86_64CodeGen.codex` cannot survive as itself. It becomes", ScRaw "# X86_64CO.COD, and the mangling is lossy and collides: six pairs of chapters", ScRaw "# in codex/compiler share their first eight characters. Collisions take a", ScRaw "# digit in the last position, and SRC/INDEX.TXT carries every short name", ScRaw "# against the path it came from, so the stick explains its own naming without", ScRaw "# anyone consulting this script.", ScRaw "#", ScRaw "# The extension is COD and deliberately not CDX: CDX is the seed binary at the", ScRaw "# root, and a source file wearing that extension would be the one confusion", ScRaw "# worth avoiding on a medium whose whole point is to be self-explaining.", ScRaw "if ($SourceDir -and (Test-Path $SourceDir)) {", ScRaw "    $chapters = @(Get-ChildItem -Path $SourceDir -Recurse -Filter *.codex -File | Sort-Object FullName)", ScRaw "    if ($chapters.Count -gt 0) {", ScRaw "        $taken = @{}", ScRaw "        $shorts = @()", ScRaw "        $indexLines = @()", ScRaw "        foreach ($ch in $chapters) {", ScRaw "            $stem = ($ch.BaseName.ToUpper() -replace '[^A-Z0-9]', '_')", ScRaw "            if ($stem.Length -gt 8) { $stem = $stem.Substring(0, 8) }", ScRaw "            $stem = $stem.PadRight(8)", ScRaw "            if ($taken.ContainsKey($stem)) {", ScRaw "                $n = $taken[$stem]", ScRaw "                $taken[$stem] = $n + 1", ScRaw "                $stem = $stem.Substring(0, 7) + ([string]$n)", ScRaw "            } else {", ScRaw "                $taken[$stem] = 1", ScRaw "            }", ScRaw "            $shorts += $stem", ScRaw "            $rel = $ch.FullName.Substring((Resolve-Path $SourceDir).Path.Length).TrimStart('\\', '/')", ScRaw "            $indexLines += ($stem.Trim() + '.COD  ' + ($rel -replace '\\\\', '/'))", ScRaw "        }", ScRaw "        $indexBytes = [System.Text.Encoding]::ASCII.GetBytes(($indexLines -join \"`n\") + \"`n\")", ScBlank, ScRaw "        # The directory is allocated first and in one run, so its clusters are", ScRaw "        # contiguous and one flat offset addresses every entry. The bump", ScRaw "        # allocator is what makes that true; it stops being true the moment", ScRaw "        # anything else allocates in the middle.", ScRaw "        $srcEntries = 2 + $chapters.Count + 1", ScRaw "        $srcDirClusters = [int][Math]::Ceiling(($srcEntries * 32) / $clustSz)", ScRaw "        $srcDirCluster = $script:nextCluster", ScRaw "        for ($c = 0; $c -lt $srcDirClusters; $c++) {", ScRaw "            $cn = $srcDirCluster + $c", ScRaw "            Set-Fat $cn $(if ($c -eq $srcDirClusters - 1) { $EOC } else { $cn + 1 })", ScRaw "        }", ScRaw "        $script:nextCluster += $srcDirClusters", ScRaw "        $srcDirOff = $dataOff + ($srcDirCluster - 2) * $clustSz", ScBlank, ScRaw "        Add-DirEntry $srcDirOff 0 \".          \" 0x10 $srcDirCluster 0"]

Section: P10

  p10 : List ShellCmd = [ScRaw "        Add-DirEntry $srcDirOff 1 \"..         \" 0x10 0 0", ScRaw "        $sIdx = 2", ScRaw "        for ($i = 0; $i -lt $chapters.Count; $i++) {", ScRaw "            $bytes = [System.IO.File]::ReadAllBytes($chapters[$i].FullName)", ScRaw "            $cl = Alloc-File $bytes", ScRaw "            Add-DirEntry $srcDirOff $sIdx ($shorts[$i] + 'COD') 0x20 $cl $bytes.Length", ScRaw "            $sIdx++", ScRaw "        }", ScRaw "        $idxCl = Alloc-File $indexBytes", ScRaw "        Add-DirEntry $srcDirOff $sIdx \"INDEX   TXT\" 0x20 $idxCl $indexBytes.Length", ScBlank, ScRaw "        Add-DirEntry $rootOff $rootIdx \"SRC        \" 0x10 $srcDirCluster 0", ScRaw "        $rootIdx++", ScRaw "        Write-Host \"[build-img] SRC/ holds $($chapters.Count) chapters as files, $(($chapters | Measure-Object Length -Sum).Sum) bytes, plus INDEX.TXT\"", ScRaw "    }", ScRaw "}", ScBlank, ScRaw "# Volume label entry in root", ScRaw "Add-DirEntry $rootOff $rootIdx \"CODEX      \" 0x08 0 0", ScBlank, ScRaw "# FAT32 keeps a backup of the boot sector and FSInfo at sectors 6 and 7,", ScRaw "# where the BPB's BkBootSec field points recovery tools.", ScRaw "if ($Fat32) {", ScRaw "    [Array]::Copy($img, $fatBase, $img, $fatBase + 6 * 512, 512)", ScRaw "    [Array]::Copy($img, $fatBase + 512, $img, $fatBase + 7 * 512, 512)", ScRaw "}", ScBlank, ScRaw "[System.IO.File]::WriteAllBytes($Out, $img)", ScRaw "Write-Host \"[build-img] OK: $Out ($($img.Length / 1MB) MB, PE=$($pe.Length) src=$($srcBytes.Length) seed=$($seedBytes.Length))\""]

Section: Assembly

  buildimg-body : List ShellCmd = [ScSequence p01, ScSequence p02, ScSequence p03, ScSequence p04, ScSequence p05, ScSequence p06, ScSequence p07, ScSequence p08, ScSequence p09, ScSequence p10]

  buildimg-script : ShellScript = sh-script "build-img" "Build a bootable GPT FAT16 disk image from a PE and optional source." buildimg-params buildimg-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell buildimg-script)
  end

