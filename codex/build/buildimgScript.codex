Chapter: BuildImgScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 Generates build-img.ps1 -- builds a bootable GPT FAT16 disk image from a PE and optional source.
 Compile with: -Survey "lower-mul:500000"

 We say:

Section: Parameters

  buildimg-params : List ShellParam = [sh-param "PeInput" SptString, sh-param "Out" SptString, sh-param-default "Source" SptString (SeLit ""), sh-param-default "TotalSectors" SptInt (SeInt 16384)]

Section: S01 -- Preamble and Constants

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScRaw "trap { Write-Host \"ERROR at line $($_.InvocationInfo.ScriptLineNumber): $_\"; throw $_ }", ScBlank, ScAssign "SectorSize" (SeInt 512), ScAssign "PartStart" (SeInt 2048), ScAssign "PartSectors" (SeRaw "$TotalSectors - $PartStart - 33"), ScAssign "ImageSize" (SeRaw "$TotalSectors * $SectorSize")]

Section: S02 -- Read Inputs

  s02 : List ShellCmd = [ScReadBytes "pe" (SeVar "PeInput"), ScIf (SeAnd (SeVar "Source") (SeFileExists (SeVar "Source"))) [ScReadBytes "srcBytes" (SeVar "Source")] [ScRaw "$srcBytes = [byte[]]::new(0)"], ScBlank, ScEcho (SeRaw "\"[build-img] PE=$($pe.Length) bytes  Source=$($srcBytes.Length) bytes  Image=$($ImageSize / 1MB) MB\""), ScBlank, ScRaw "$img = New-Object byte[] $ImageSize"]

Section: S03 -- Helper Functions

  s03 : List ShellCmd = [ScRaw "function W8($off, $v) { $img[$off] = [byte]$v }", ScRaw "function W16($off, $v) { [BitConverter]::GetBytes([ushort]$v).CopyTo($img, $off) }", ScRaw "function W32($off, $v) { [BitConverter]::GetBytes([int]$v).CopyTo($img, $off) }", ScRaw "function W64($off, $v) { [BitConverter]::GetBytes([ulong]$v).CopyTo($img, $off) }", ScRaw "function WBytes($off, $bs) { [Array]::Copy($bs, 0, $img, $off, $bs.Length) }", ScRaw "function WStr($off, $s, $len) { $b = [System.Text.Encoding]::ASCII.GetBytes($s); $n = [Math]::Min($b.Length, $len); [Array]::Copy($b, 0, $img, $off, $n) }"]

Section: S04 -- Protective MBR

  s04 : List ShellCmd = [ScComment "Protective MBR (sector 0)", ScRaw "W8 0x1BE 0x00", ScRaw "W8 0x1C2 0xEE", ScRaw "W32 0x1C6 1", ScRaw "W32 0x1CA ($TotalSectors - 1)", ScRaw "W16 0x1FE 0xAA55"]

Section: S05 -- GPT Header

  s05 : List ShellCmd = [ScComment "GPT Header (sector 1)", ScAssign "gptOff" (SeVar "SectorSize"), ScRaw "WStr $gptOff 'EFI PART' 8", ScRaw "W32 ($gptOff + 8) 0x00010000", ScRaw "W32 ($gptOff + 12) 92", ScRaw "W32 ($gptOff + 16) 0", ScRaw "W32 ($gptOff + 20) 0", ScRaw "W64 ($gptOff + 24) 1", ScRaw "W64 ($gptOff + 32) ($TotalSectors - 1)", ScRaw "W64 ($gptOff + 40) $PartStart", ScRaw "W64 ($gptOff + 48) ($TotalSectors - 34)", ScRaw "WBytes ($gptOff + 56) ([byte[]]@(0xC0,0xDE,0xC0,0xDE,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0A,0x0B,0x0C))", ScRaw "W64 ($gptOff + 72) 2", ScRaw "W32 ($gptOff + 80) 1", ScRaw "W32 ($gptOff + 84) 128", ScRaw "W32 ($gptOff + 88) 0"]

Section: S06 -- GPT Partition Entry

  s06 : List ShellCmd = [ScComment "GPT Partition Entry (sector 2)", ScAssign "peOff" (SeRaw "2 * $SectorSize"), ScRaw "WBytes $peOff ([byte[]]@(0x28,0x73,0x2A,0xC1,0x1F,0xF8,0xD2,0x11,0xBA,0x4B,0x00,0xA0,0xC9,0x3E,0xC9,0x3B))", ScRaw "WBytes ($peOff + 16) ([byte[]]@(0xAA,0xBB,0xCC,0xDD,0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xAA,0xBB,0xCC))", ScRaw "W64 ($peOff + 32) $PartStart", ScRaw "W64 ($peOff + 40) ($PartStart + $PartSectors - 1)", ScRaw "W64 ($peOff + 48) 0", ScRaw "$pName = [System.Text.Encoding]::Unicode.GetBytes('EFI System')", ScRaw "WBytes ($peOff + 56) $pName"]

Section: S07 -- CRC32 and Header Checksums

  s07 : List ShellCmd = [ScComment "CRC32 for partition entries and header", ScRaw "function Crc32($data, $off, $len) { [long]$crc = 0xFFFFFFFF; for ($i = 0; $i -lt $len; $i++) { $crc = $crc -bxor $data[$off + $i]; for ($j = 0; $j -lt 8; $j++) { if ($crc -band 1) { $crc = (($crc -shr 1) -band 0x7FFFFFFF) -bxor 0xEDB88320 } else { $crc = ($crc -shr 1) -band 0x7FFFFFFF } } }; return ($crc -bxor 0xFFFFFFFF) -band 0xFFFFFFFF }", ScBlank, ScAssign "entryCrc" (SeRaw "Crc32 $img (2 * $SectorSize) 128"), ScRaw "W32 ($gptOff + 88) $entryCrc", ScBlank, ScAssign "hdrCrc" (SeRaw "Crc32 $img $gptOff 92"), ScRaw "W32 ($gptOff + 16) $hdrCrc"]

Section: S08 -- FAT16 BPB

  s08 : List ShellCmd = [ScComment "FAT16 Partition -- BPB", ScAssign "fatBase" (SeRaw "$PartStart * $SectorSize"), ScAssign "bytesPerSector" (SeInt 512), ScAssign "sectorsPerCluster" (SeInt 4), ScAssign "reservedSectors" (SeInt 1), ScAssign "numFats" (SeInt 2), ScAssign "rootEntries" (SeInt 512), ScAssign "rootDirSectors" (SeRaw "[int][Math]::Ceiling($rootEntries * 32 / $bytesPerSector)"), ScAssign "fatSectors" (SeRaw "[int][Math]::Ceiling(($PartSectors / $sectorsPerCluster + 2) / 256)"), ScAssign "dataSector0" (SeRaw "$reservedSectors + $numFats * $fatSectors + $rootDirSectors"), ScBlank, ScRaw "WBytes $fatBase ([byte[]]@(0xEB, 0x3C, 0x90))", ScRaw "WStr ($fatBase + 3) 'CODEX   ' 8", ScRaw "W16 ($fatBase + 11) $bytesPerSector", ScRaw "W8  ($fatBase + 13) $sectorsPerCluster", ScRaw "W16 ($fatBase + 14) $reservedSectors", ScRaw "W8  ($fatBase + 16) $numFats"]

Section: S09 -- FAT16 BPB continued

  s09 : List ShellCmd = [ScRaw "W16 ($fatBase + 17) $rootEntries", ScRaw "W16 ($fatBase + 19) 0", ScRaw "W8  ($fatBase + 21) 0xF8", ScRaw "W16 ($fatBase + 22) $fatSectors", ScRaw "W16 ($fatBase + 24) 63", ScRaw "W16 ($fatBase + 26) 255", ScRaw "W32 ($fatBase + 28) $PartStart", ScRaw "W32 ($fatBase + 32) $PartSectors", ScRaw "W8  ($fatBase + 36) 0x80", ScRaw "W8  ($fatBase + 38) 0x29", ScRaw "W32 ($fatBase + 39) 0xC0DEC0DE", ScRaw "WStr ($fatBase + 43) 'CODEX      ' 11", ScRaw "WStr ($fatBase + 54) 'FAT16   ' 8", ScRaw "W16 ($fatBase + 510) 0xAA55"]

Section: S10 -- FAT Tables and Root Dir Setup

  s10 : List ShellCmd = [ScComment "FAT tables and root directory", ScAssign "fat1Off" (SeRaw "$fatBase + $reservedSectors * $bytesPerSector"), ScAssign "fat2Off" (SeRaw "$fat1Off + $fatSectors * $bytesPerSector"), ScBlank, ScRaw "W16 $fat1Off 0xFFF8", ScRaw "W16 ($fat1Off + 2) 0xFFFF", ScBlank, ScAssign "rootOff" (SeRaw "$fat2Off + $fatSectors * $bytesPerSector"), ScAssign "dataOff" (SeRaw "$fatBase + $dataSector0 * $bytesPerSector")]

Section: S11 -- Directory and File Helpers

  s11 : List ShellCmd = [ScRaw "function Add-DirEntry($dirOff, $idx, $name, $attr, $cluster, $size) { $eOff = $dirOff + $idx * 32; WStr $eOff $name 11; W8 ($eOff + 11) $attr; W16 ($eOff + 26) $cluster; W32 ($eOff + 28) $size }", ScBlank, ScAssign "nextCluster" (SeInt 2), ScRaw "function Alloc-File([byte[]]$fileData) { $clustSz = $sectorsPerCluster * $bytesPerSector; $fileLen = $fileData.Length; $numClusters = [int][Math]::Ceiling($fileLen / $clustSz); $startCluster = $script:nextCluster; for ($c = 0; $c -lt $numClusters; $c++) { $cn = $startCluster + $c; $fatEntry = if ($c -eq $numClusters - 1) { [ushort]0xFFFF } else { [ushort]($cn + 1) }; [BitConverter]::GetBytes($fatEntry).CopyTo($img, $fat1Off + $cn * 2); [BitConverter]::GetBytes($fatEntry).CopyTo($img, $fat2Off + $cn * 2); $fileOff = $dataOff + ($cn - 2) * $clustSz; $srcOff = $c * $clustSz; $chunkLen = [Math]::Min($fileLen - $srcOff, $clustSz); [Array]::Copy($fileData, $srcOff, $img, $fileOff, $chunkLen) }; $script:nextCluster += $numClusters; return $startCluster }"]

Section: S12 -- EFI and BOOT Directories

  s12 : List ShellCmd = [ScComment "Create EFI and BOOT subdirectories", ScAssign "efiCluster" (SeVar "nextCluster"), ScRaw "$script:nextCluster++", ScAssign "clustSz" (SeRaw "$sectorsPerCluster * $bytesPerSector"), ScAssign "efiDirOff" (SeRaw "$dataOff + ($efiCluster - 2) * $clustSz"), ScRaw "W16 ($fat1Off + $efiCluster * 2) 0xFFFF", ScRaw "W16 ($fat2Off + $efiCluster * 2) 0xFFFF", ScRaw "Add-DirEntry $efiDirOff 0 '.          ' 0x10 $efiCluster 0", ScRaw "Add-DirEntry $efiDirOff 1 '..         ' 0x10 0 0", ScBlank, ScAssign "bootCluster" (SeVar "nextCluster"), ScRaw "$script:nextCluster++", ScAssign "bootDirOff" (SeRaw "$dataOff + ($bootCluster - 2) * $clustSz"), ScRaw "W16 ($fat1Off + $bootCluster * 2) 0xFFFF", ScRaw "W16 ($fat2Off + $bootCluster * 2) 0xFFFF", ScRaw "Add-DirEntry $bootDirOff 0 '.          ' 0x10 $bootCluster 0", ScRaw "Add-DirEntry $bootDirOff 1 '..         ' 0x10 $efiCluster 0"]

Section: S13 -- Write Files to Image

  s13 : List ShellCmd = [ScComment "Write BOOT entry, PE file, EFI entry, and optional source", ScRaw "Add-DirEntry $efiDirOff 2 'BOOT       ' 0x10 $bootCluster 0", ScBlank, ScAssign "peFileCluster" (SeRaw "Alloc-File $pe"), ScRaw "Add-DirEntry $bootDirOff 2 'BOOTX64 EFI' 0x20 $peFileCluster $pe.Length", ScBlank, ScRaw "Add-DirEntry $rootOff 0 'EFI        ' 0x10 $efiCluster 0", ScBlank, ScIf (SeRaw "$srcBytes.Length -gt 0") [ScAssign "srcCluster" (SeRaw "Alloc-File $srcBytes"), ScRaw "Add-DirEntry $rootOff 1 'SOURCE  SRC' 0x20 $srcCluster $srcBytes.Length"] [], ScBlank, ScRaw "Add-DirEntry $rootOff ($(if ($srcBytes.Length -gt 0) { 2 } else { 1 })) 'CODEX      ' 0x08 0 0"]

Section: S14 -- Write Output

  s14 : List ShellCmd = [ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "Out", SeVar "img"], ScEcho (SeRaw "\"[build-img] OK: $Out ($($img.Length / 1MB) MB, PE=$($pe.Length) src=$($srcBytes.Length))\"")]

Section: Assembly

  buildimg-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08, ScBlank, ScSequence s09, ScBlank, ScSequence s10, ScBlank, ScSequence s11, ScBlank, ScSequence s12, ScBlank, ScSequence s13, ScBlank, ScSequence s14]

  buildimg-script : ShellScript = sh-script "build-img" "Build a bootable GPT FAT16 disk image from a PE and optional source" buildimg-params buildimg-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell buildimg-script)
  end

