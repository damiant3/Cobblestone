Chapter: ScanSourceFactsScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 Generates scan-source-facts.ps1 from the Shell DSL.
 Scans the source tree for .codex files, computes SHA-256 hashes,
 and outputs a SourceDefinition manifest (pipe-delimited).
 Format: sha256-hex|relative-path|quire-name|chapter-name
 Compile with: -Survey "lower-mul:500000"

 We say:

Section: Parameters

  ssf-params : List ShellParam = [sh-param-default "Root" SptString (SeLit ""), sh-param-default "OutFile" SptString (SeLit ""), sh-switch "IncludeTests"]

Section: S01 -- Preamble and defaults

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScIf (SeNot (SeVar "Root")) [ScAssign "Root" (SeRaw "(Resolve-Path (Join-Path $PSScriptRoot '..')).Path")] [], ScAssign "Root" (SeRaw "(Resolve-Path $Root).Path")]

Section: S02 -- Helper functions

  s02 : List ShellCmd = [ScRaw "function Is-Excluded { param([string]$RelPath); foreach ($part in $RelPath.Split('/')) { if ($part -eq 'old' -or $part -eq 'build-output' -or $part -eq 'test-output' -or $part -eq 'test-input' -or $part -eq 'output' -or $part -eq 'Done') { return $true }; if ($part -match '^output-\\d{8}') { return $true } }; return $false }", ScBlank, ScRaw "function Capitalize { param([string]$s); if ($s.Length -eq 0) { return $s }; return $s.Substring(0,1).ToUpper() + $s.Substring(1) }", ScBlank, ScRaw "function Get-QuireName { param([string]$RelPath); $parts = $RelPath.Split('/'); if ($parts[0] -eq 'codex' -and $parts.Count -ge 3) { if ($parts[1] -eq 'foreword') { if ($parts[2] -eq 'core') { return 'Foreword' }; return Capitalize $parts[2] }; if ($parts[1] -eq 'compiler') { return 'Codex' }; if ($parts[1] -eq 'os') { return Capitalize $parts[2] }; if ($parts[1] -eq 'plugs') { return Capitalize $parts[2] }; if ($parts[1] -eq 'test') { return 'Test' }; if ($parts[1] -eq 'boards') { return 'Boards' }; if ($parts[1] -eq 'build') { return 'Build' } }; if ($parts[0] -eq 'apps' -and $parts.Count -ge 3) { $parentDir = [System.IO.Path]::GetDirectoryName($RelPath).Replace('\\', '/'); $leaf = ($parentDir -split '/')[-1]; if ($leaf -eq 'pages' -or $leaf -eq 'tests' -or $leaf -eq 'web') { $leaf = ($parentDir -split '/')[-2] }; return Capitalize $leaf }; $parent = Split-Path (Split-Path $RelPath) -Leaf; if ($parent) { return Capitalize $parent }; return 'Unknown' }"]

Section: S03 -- Enumerate files

  s03 : List ShellCmd = [ScAssign "chapterPat" (SeLit "^\\s*Chapter:\\s*(.+?)\\s*$"), ScRaw "$files = Get-ChildItem -Path $Root -Recurse -Filter '*.codex' -File | Where-Object { $rel = $_.FullName.Substring($Root.Length + 1).Replace('\\', '/'); if (Is-Excluded $rel) { return $false }; if ($rel -like 'docs/*') { return $false }; if (-not $IncludeTests -and $rel -like 'codex/test/*') { return $false }; return $true }", ScDotNetCallAssign "manifest" "System.Collections.Generic.List[string]" "new" []]

Section: S04 -- Build manifest

  s04 : List ShellCmd = [ScForEach "f" (SeVar "files") [ScAssign "relPath" (SeRaw "$f.FullName.Substring($Root.Length + 1).Replace('\\', '/')"), ScAssign "hash" (SeRaw "(Get-FileHash -Algorithm SHA256 $f.FullName).Hash.ToLower()"), ScAssign "quire" (SeRaw "Get-QuireName $relPath"), ScAssign "chapter" (SeLit ""), ScRaw "$head = Get-Content -TotalCount 5 $f.FullName -ErrorAction SilentlyContinue", ScIf (SeVar "head") [ScForEach "line" (SeVar "head") [ScIf (SeMatch (SeVar "line") "$chapterPat") [ScAssign "chapter" (SeRaw "$matches[1]"), ScBreak] []]] [], ScIf (SeNot (SeVar "chapter")) [ScAssign "chapter" (SeRaw "[System.IO.Path]::GetFileNameWithoutExtension($f.Name)")] [], ScRaw "[void]$manifest.Add(\"$hash|$relPath|$quire|$chapter\")"], ScRaw "$manifest.Sort()"]

Section: S05 -- Output

  s05 : List ShellCmd =
    let write-file = [ScRaw "$dir = Split-Path $OutFile -Parent", ScIf (SeAnd (SeVar "dir") (SeNot (SeDirExists (SeVar "dir")))) [ScMkdir (SeVar "dir")] [], ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "OutFile", SeRaw "($manifest -join \"`n\") + \"`n\"", SeRaw "[System.Text.UTF8Encoding]::new($false)"], ScEcho (SeRaw "\"$($manifest.Count) source definitions written to $OutFile\"")]
    in let write-stdout = [ScForEach "m" (SeVar "manifest") [ScEcho (SeVar "m")]]
    in [ScIf (SeVar "OutFile") write-file write-stdout]

Section: Assembly

  ssf-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  ssf-script : ShellScript = sh-script "scan-source-facts" "Scan source tree for .codex files and output a SourceDefinition manifest" ssf-params ssf-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell ssf-script)
  end

