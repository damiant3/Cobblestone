Chapter: TestDiskPersistenceScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 Generates test-disk-persistence.ps1 from the Shell DSL.
 Tests disk fact persistence: init, load, read, multi-write, multi-load.
 Compile with: -Survey "lower-mul:500000"

 We say:

Section: Parameters

  tdp-params : List ShellParam = [sh-param-default "PCore" SptInt (SeInt 1), sh-param-default "MaxRetries" SptInt (SeInt 5)]

Section: S01 -- Preamble and paths

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "root" (SeRaw "Split-Path $PSScriptRoot -Parent"), ScAssign "buildDir" (SeRaw "Join-Path $root 'build-output\\bare-metal'"), ScAssign "diskDir" (SeRaw "Join-Path $root 'build-output\\disk'"), ScAssign "diskImg" (SeRaw "Join-Path $diskDir 'persist-test.img'"), ScAssign "runDisk" (SeRaw "Join-Path $PSScriptRoot 'run-with-disk.ps1'"), ScAssign "compile" (SeRaw "Join-Path $PSScriptRoot 'compile.ps1'"), ScBlank, ScIf (SeNot (SeDirExists (SeVar "diskDir"))) [ScMkdir (SeVar "diskDir")] []]

Section: S02 -- Compile-Sample function

  s02 : List ShellCmd = [ScRaw "function Compile-Sample($src, $out) {", ScRaw "    $log = \"$out.log\"", ScRaw "    & pwsh -File $compile -Src $src -Out $out -Log $log -PCore $PCore", ScRaw "    if ($LASTEXITCODE -ne 0) {", ScRaw "        Write-Host \"FAIL: compile $src (exit $LASTEXITCODE)\"", ScRaw "        if (Test-Path $log) { Get-Content $log | Write-Host }", ScRaw "        exit 1", ScRaw "    }", ScRaw "}"]

Section: S03 -- Run-Phase function

  s03 : List ShellCmd = [ScRaw "function Run-Phase($kernel, $expect, $label) {", ScRaw "    for ($try = 1; $try -le $MaxRetries; $try++) {", ScRaw "        $out = & pwsh -File $runDisk -Kernel $kernel -Disk $diskImg -TimeoutSec 30 -PCore $PCore 2>&1", ScRaw "        $text = ($out | Out-String).Trim()", ScRaw "        if ($text -eq $expect) {", ScRaw "            Write-Host \"  $label : PASS (attempt $try)\"", ScRaw "            return", ScRaw "        }", ScRaw "    }", ScRaw "    Write-Host \"  $label : FAIL (expected '$expect', got '$text' after $MaxRetries attempts)\"", ScRaw "    exit 1", ScRaw "}"]

Section: S04 -- Fresh-Disk function

  s04 : List ShellCmd = [ScRaw "function Fresh-Disk { [System.IO.File]::WriteAllBytes($diskImg, [byte[]]::new(1048576)) }"]

Section: S05 -- Sample list

  s05-names : List ShellExpr = [SeLit "disk-facts-init", SeLit "disk-facts-load", SeLit "disk-facts-read", SeLit "disk-facts-multi", SeLit "disk-facts-multi-load"]

  s05 : List ShellCmd = [ScAssign "samples" (SeArrayLiteral s05-names)]

Section: S06 -- Compile all samples

  s06 : List ShellCmd = [ScForEach "s" (SeVar "samples") [ScAssign "bin" (SeRaw "Join-Path $buildDir \"$s.cdx\""), ScEcho (SeRaw "\"Compiling $s...\""), ScRaw "Compile-Sample (Join-Path $root \"codex\\test\\$s.codex\") $bin"]]

Section: S07 -- Test 1 single-fact roundtrip

  s07 : List ShellCmd = [ScEcho (SeLit ""), ScEcho (SeLit "=== Test 1: single-fact roundtrip ==="), ScRaw "Fresh-Disk", ScRaw "Run-Phase (Join-Path $buildDir 'disk-facts-init.cdx') '1' 'init + write'", ScRaw "Run-Phase (Join-Path $buildDir 'disk-facts-load.cdx') '1' 'load count'", ScRaw "Run-Phase (Join-Path $buildDir 'disk-facts-read.cdx') 'hello' 'load content'"]

Section: S08 -- Test 2 multi-fact roundtrip

  s08 : List ShellCmd = [ScEcho (SeLit ""), ScEcho (SeLit "=== Test 2: multi-fact roundtrip ==="), ScRaw "Fresh-Disk", ScRaw "Run-Phase (Join-Path $buildDir 'disk-facts-multi.cdx') '3' 'write 3 facts'", ScRaw "Run-Phase (Join-Path $buildDir 'disk-facts-multi-load.cdx') '3 alpha beta gamma' 'load all 3'"]

Section: S09 -- Final pass and cleanup

  s09 : List ShellCmd = [ScEcho (SeLit ""), ScEcho (SeLit "PASS: all disk persistence tests verified"), ScRaw "Remove-Item -Force $diskImg -ErrorAction SilentlyContinue", ScExit (SeInt 0)]

Section: Assembly

  tdp-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08, ScBlank, ScSequence s09]

  tdp-script : ShellScript = sh-script "test-disk-persistence" "Test disk fact persistence: init, load, read, multi-write, multi-load" tdp-params tdp-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell tdp-script)
  end

