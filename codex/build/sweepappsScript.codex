Chapter: SweepAppsScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  sweep-params : List ShellParam = [sh-param-default "Dir" SptString (SeLit "games"), sh-param-default "Jobs" SptInt (SeInt 4), sh-param-default "TimeoutSec" SptInt (SeInt 60)]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScSetLocation (SeVar "Repo")]

Section: S02 -- Stage0 Setup

  s02 : List ShellCmd = [ScAssign "CompileScript" (SePathJoin SeScriptRoot (SeLit "compile.ps1")), ScAssign "stage0" (SePathJoin (SeVar "Repo") (SeLit "build-output\\bare-metal\\Codex.cdx")), ScAssign "seedCdx" (SePathJoin (SeVar "Repo") (SeLit "seed\\Codex.cdx")), ScMkdir (SePathParent (SeVar "stage0")), ScCopy (SeVar "seedCdx") (SeVar "stage0")]

Section: S03 -- Output Directory

  s03 : List ShellCmd = [ScAssign "outDir" (SePathJoin (SeVar "Repo") (SeConcat (SeLit "build-output\\sweep-") (SeVar "Dir"))), ScIf (SeDirExists (SeVar "outDir")) [ScDeleteTree (SeVar "outDir")] [], ScMkdir (SeVar "outDir")]

Section: S04 -- Discover Files

  apps-dir : ShellExpr = SePathJoin (SeVar "Repo") (SeConcat (SeLit "apps\\") (SeVar "Dir"))

  s04 : List ShellCmd = [ScAssign "files" (SeAsArray (SePipe (SeListFiles apps-dir "*.codex" True) [StSortBy "FullName"])), ScEcho (SeConcat (SeConcat (SeConcat (SeLit "Sweep: ") (SeCount (SeVar "files"))) (SeLit " files under apps/")) (SeVar "Dir"))]

Section: S05 -- Counters

  s05 : List ShellCmd = [ScAssign "pass" (SeInt 0), ScAssign "diag" (SeInt 0), ScAssign "crash" (SeInt 0), ScAssign "timeout" (SeInt 0), ScAssign "crashes" (SeArrayLiteral [])]

Section: S06 -- Sweep Loop

  proc-exit : ShellExpr = SeProperty (SeVar "proc") "ExitCode"

  s06-timeout : List ShellCmd = [ScStopProcess (SeProperty (SeVar "proc") "Id"), ScEchoStyled (SeConcat (SeLit "  TIMEOUT  ") (SeVar "rel")) ClBrightRed True, ScIncrement "timeout", ScAppend "crashes" (SeConcat (SeConcat (SeLit "TIMEOUT") SeTab) (SeVar "rel")), ScContinue]

  crash-label : ShellExpr = SeConcat (SeConcat (SeLit "CRASH(") proc-exit) (SeLit ")")

  s06-crash : List ShellCmd = [ScEchoStyled (SeConcat (SeConcat crash-label (SeLit "  ")) (SeVar "rel")) ClBrightRed True, ScIncrement "crash", ScAppend "crashes" (SeConcat (SeConcat crash-label SeTab) (SeVar "rel"))]

  s06-exit-check : List ShellCmd = [ScIf (SeIntEq proc-exit (SeInt 0)) [ScIncrement "pass"] [ScIf (SeIntEq proc-exit (SeInt 4)) [ScIncrement "diag"] s06-crash]]

  compile-args : List ShellExpr = [SeLit "-NoProfile", SeLit "-File", SeVar "CompileScript", SeLit "-Src", SeProperty (SeVar "f") "FullName", SeLit "-Out", SeVar "cdxOut", SeLit "-Log", SeVar "logOut"]

  s06-body : List ShellCmd = [ScAssign "name" (SeProperty (SeVar "f") "BaseName"), ScAssign "rel" (SeSubstringFrom (SeProperty (SeVar "f") "FullName") (SeAdd (SeTextLength (SeVar "Repo")) (SeInt 1))), ScAssign "cdxOut" (SePathJoin (SeVar "outDir") (SeConcat (SeVar "name") (SeLit ".cdx"))), ScAssign "logOut" (SePathJoin (SeVar "outDir") (SeConcat (SeVar "name") (SeLit ".log"))), ScBlank, sh-start-process-stderr "proc" (SeLit "pwsh") compile-args (SePathJoin (SeVar "outDir") (SeConcat (SeVar "name") (SeLit ".stderr"))), ScAssign "exited" (SeMethodCall (SeVar "proc") "WaitForExit" [SeMul (SeVar "TimeoutSec") (SeInt 1000)]), ScIf (SeNot (SeVar "exited")) s06-timeout [], ScBlank, ScSequence s06-exit-check]

  s06 : List ShellCmd = [ScForEach "f" (SeVar "files") s06-body]

Section: S07 -- Summary

  s07-crashes : List ShellCmd = [ScEcho (SeLit "Crashes/timeouts:"), ScForEach "c" (SeVar "crashes") [ScEcho (SeConcat (SeLit "  ") (SeVar "c"))]]

  results-line : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeConcat (SeLit "Results: ") (SeCount (SeVar "files"))) (SeLit " files, ")) (SeVar "pass")) (SeLit " compiled, ")) (SeVar "diag")) (SeLit " diagnostic-halt, ")) (SeVar "crash")) (SeLit " crash")

  s07 : List ShellCmd = [ScEcho (SeLit ""), ScEcho (SeConcat (SeConcat (SeConcat results-line (SeLit ", ")) (SeVar "timeout")) (SeLit " timeout")), ScIf (SeIntGt (SeCount (SeVar "crashes")) (SeInt 0)) s07-crashes [], ScExit (SeAdd (SeVar "crash") (SeVar "timeout"))]

Section: Assembly

  sweep-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07]

  sweep-script : ShellScript = sh-script "sweep-apps" "Compile every .codex under apps/ to verify no compiler crashes" sweep-params sweep-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell sweep-script)
  end

