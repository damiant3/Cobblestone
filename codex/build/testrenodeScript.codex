Chapter: TestRenodeScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 Renode reads a .resc script rather than command-line arguments, so this
 writes one to a temporary file and points Renode at it. Every path in that
 file is rewritten to forward slashes because the .resc parser treats a
 backslash as an escape, which is a detail of a format we do not own.

 We say:

Section: Parameters

  renode-params : List ShellParam = [sh-param-choice "Arch" ["arm64", "riscv64"], sh-param "Elf" SptString, sh-param "OutFile" SptString, sh-param-default "TimeoutSec" SptInt (SeInt 10)]

Section: S01 -- Locate Renode And The Board

  missing-renode : Text = "MISSING: Renode (install to C:\\Renode or set CODEX_RENODE_HOME)"

  board-path : ShellExpr = SePathJoin (SeVar "Repo") (SeConcat (SeConcat (SeLit "tools\\renode\\codex\\codex-") (SeVar "Arch")) (SeLit ".repl"))

  missing-board : ShellExpr = SeConcat (SeLit "MISSING: board ") (SeVar "boardRepl")

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScRunDot (SePathJoin SeScriptRoot (SeLit "renode-config.ps1")), ScAssign "RenodeExe" (SeCallArgs "Get-RenodeExe" [SaNamed "Repo" (SeVar "Repo")]), ScIf (SeNot (SeVar "RenodeExe")) [ScWriteError (SeLit missing-renode), ScExit (SeInt 2)] [], ScBlank, ScAssign "boardRepl" board-path, ScIf (SeNot (SeFileExists (SeVar "boardRepl"))) [ScWriteError missing-board, ScExit (SeInt 2)] []]

Section: S02 -- Paths For The Script File

  to-slashes : ShellExpr -> ShellExpr
  to-slashes (p) = SeReplace p "\\\\" (SeLit "/")

  guid-8 : ShellExpr = SeSubstring (SeMethodCall (SeStaticCall "guid" "NewGuid" []) "ToString" [SeLit "N"]) 0 8

  uart-name : ShellExpr = SeConcat (SeConcat (SeLit "renode-uart-") guid-8) (SeLit ".log")

  uart-path : ShellExpr = SePathJoin (SeStaticCall "System.IO.Path" "GetTempPath" []) uart-name

  s02 : List ShellCmd = [ScAssign "elfPath" (to-slashes (SePathResolve (SeVar "Elf"))), ScAssign "boardPath" (to-slashes (SePathResolve (SeVar "boardRepl"))), ScAssign "uartLog" (to-slashes uart-path)]

Section: S03 -- The Renode Script

  resc-lines : List ShellExpr = [SeLit "mach create \"codex\"", SeConcat (SeLit "machine LoadPlatformDescription @") (SeVar "boardPath"), SeConcat (SeLit "sysbus LoadELF @") (SeVar "elfPath"), SeConcat (SeConcat (SeLit "uart0 CreateFileBackend @") (SeVar "uartLog")) (SeLit " true"), SeLit "start", SeConcat (SeLit "sleep ") (SeVar "TimeoutSec"), SeLit "quit"]

  s03 : List ShellCmd = [ScAssign "rescContent" (SeLines resc-lines), ScAssign "rescFile" (to-slashes (SeStaticCall "System.IO.Path" "GetTempFileName" [])), ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "rescFile", SeVar "rescContent"]]

Section: S04 -- Run Renode

  renode-args : List ShellExpr = [SeLit "--disable-xwt", SeLit "--console", SeLit "-e", SeConcat (SeLit "include @") (SeVar "rescFile")]

  renode-spec : ShellProcessSpec = ShellProcessSpec { sp-executable = SeVar "RenodeExe", sp-arguments = renode-args, sp-result-var = "proc", sp-stdout-file = Just (SeVar "stdoutFile"), sp-stderr-file = Just (SeStaticCall "System.IO.Path" "GetTempFileName" []), sp-hidden = True, sp-passthru = True }

  wall-timeout : ShellExpr = SeMul (SeAdd (SeVar "TimeoutSec") (SeInt 15)) (SeInt 1000)

  s04 : List ShellCmd = [ScTempFile "stdoutFile", ScStartProcess renode-spec, ScBlank, ScAssign "wallTimeout" wall-timeout, ScWaitProcessFor "proc" (SeVar "wallTimeout"), ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) [ScStopProcess (SeProperty (SeVar "proc") "Id")] [], ScBlank, ScSleepMs (SeInt 500)]

Section: S05 -- Read The UART Log

  first-line : ShellExpr = SeReplace (SePipe (SeSplit (SeVar "content") "\\n") [StTake 1]) "\\r" (SeLit "")

  found-message : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeLit "[renode] ") (SeVar "Arch")) (SeLit ": ")) (SeConcat (SeProperty (SeVar "lines") "Length") (SeLit " chars -- "))) (SeVar "lines")

  empty-message : ShellExpr = SeConcat (SeConcat (SeLit "[renode] ") (SeVar "Arch")) (SeLit ": no UART output")

  found-branch : List ShellCmd = [ScDotNetCallAssign "content" "System.IO.File" "ReadAllText" [SeVar "uartLog"], ScAssign "lines" first-line, ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "OutFile", SeConcat (SeVar "lines") SeNewline], ScEcho found-message, ScDelete (SeVar "uartLog")]

  empty-branch : List ShellCmd = [ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "OutFile", SeLit ""], ScEcho empty-message]

  s05 : List ShellCmd = [ScIf (SeFileExists (SeVar "uartLog")) found-branch empty-branch, ScBlank, ScDelete (SeVar "rescFile"), ScDelete (SeVar "stdoutFile"), ScExit (SeInt 0)]

Section: Assembly

  renode-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  renode-script : ShellScript = sh-script "test-renode" "Run a Codex ELF binary under Renode, capture UART output" renode-params renode-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell renode-script)
  end

