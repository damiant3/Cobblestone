Chapter: ComplianceReportScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  report-params : List ShellParam = [sh-param-default "PCore" SptInt (SeInt 1)]

Section: S01 -- Paths

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "compile" (SePathJoin SeScriptRoot (SeLit "compile.ps1")), ScAssign "run" (SePathJoin SeScriptRoot (SeLit "test-run.ps1")), ScAssign "src" (SePathJoin SeScriptRoot (SeLit "compliance-report.codex")), ScAssign "outDir" (SePathJoin SeScriptRoot (SeLit "output")), ScAssign "cdx" (SePathJoin (SeVar "outDir") (SeLit "compliance-report.cdx")), ScAssign "log" (SePathJoin (SeVar "outDir") (SeLit "compliance-report.log")), ScAssign "report" (SePathJoin (SeVar "outDir") (SeLit "compliance-evidence.txt"))]

Section: S02 -- Output Directory

  s02 : List ShellCmd = [ScIf (SeNot (SeDirExists (SeVar "outDir"))) [ScMkdir (SeVar "outDir")] []]

Section: S03 -- Compile

  compile-args : List ShellArg = [SaNamed "Src" (SeVar "src"), SaNamed "Out" (SeVar "cdx"), SaNamed "Log" (SeVar "log"), SaNamed "PCore" (SeVar "PCore")]

  compile-failed : List ShellCmd = [ScEcho (SeLit "FAIL: compliance report compilation failed"), ScIf (SeFileExists (SeVar "log")) [ScPrintFile (SeVar "log")] [], ScExit (SeInt 1)]

  s03 : List ShellCmd = [ScEcho (SeLit "Compiling compliance report generator..."), ScRunArgs (SeVar "compile") compile-args, ScIf (SeNot (SeExitCodeEq 0)) compile-failed []]

Section: S04 -- Run

  run-args : List ShellArg = [SaNamed "Kernel" (SeVar "cdx"), SaNamed "OutFile" (SeVar "report"), SaNamed "PCore" (SeVar "PCore")]

  run-failed : List ShellCmd = [ScEcho (SeLit "FAIL: compliance report execution failed"), ScExit (SeInt 1)]

  s04 : List ShellCmd = [ScEcho (SeLit "Running compliance report..."), ScRunArgs (SeVar "run") run-args, ScIf (SeNot (SeExitCodeEq 0)) run-failed []]

Section: S05 -- Report

  done-head : ShellExpr = SeConcat (SeLit "Compliance evidence report generated: ") (SeVar "report")

  done-message : ShellExpr = SeConcat (SeConcat done-head (SeLit " (")) (SeConcat (SeVar "lines") (SeLit " lines)"))

  s05 : List ShellCmd = [ScAssign "lines" (SeFileNonEmptyLineCount (SeVar "report")), ScEcho done-message, ScEcho (SeLit ""), ScPrintFile (SeVar "report")]

Section: Assembly

  report-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  report-script : ShellScript = sh-script "compliance-report" "Generate compliance evidence report" report-params report-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell report-script)
  end

