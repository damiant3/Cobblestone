Chapter: ProfileHistogramScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  ph-params : List ShellParam = [sh-param "ProfFile" SptString, sh-param-default "MapFile" SptString (SeLit ""), sh-param-default "Top" SptInt (SeInt 40)]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScIf (SeNot (SeVar "MapFile")) [ScAssign "MapFile" (SeStaticCall "System.IO.Path" "ChangeExtension" [SeVar "ProfFile", SeLit ".map"])] [], ScIf (SeNot (SeFileExists (SeVar "MapFile"))) [ScWriteError (SeConcat (SeLit "Symbol map not found: ") (SeVar "MapFile")), ScExit (SeInt 1)] [], ScIf (SeNot (SeFileExists (SeVar "ProfFile"))) [ScWriteError (SeConcat (SeLit "Profile file not found: ") (SeVar "ProfFile")), ScExit (SeInt 1)] []]

Section: S02 -- Parse map file

  map-row : ShellExpr = SeCast "PSCustomObject" (SeRecord [SfField "Addr" (SeVar "addr"), SfField "Size" (SeVar "size"), SfField "Name" (SeVar "name")])

  s02-take : List ShellCmd = [ScAssign "addr" (SeStaticCall "Convert" "ToInt64" [SeIndex (SeVar "matches") (SeInt 1), SeInt 16]), ScAssign "size" (SeStaticCall "Convert" "ToInt32" [SeIndex (SeVar "matches") (SeInt 2)]), ScAssign "name" (SeTrim (SeIndex (SeVar "matches") (SeInt 3))), ScAppend "map" map-row]

  s02 : List ShellCmd = [ScAssign "map" (SeArrayLiteral []), ScForEach "line" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "MapFile"]) [ScIf (SeMatch (SeVar "line") "^(0x[0-9a-fA-F]+)\\s+(\\d+)\\s+(.+)$") s02-take []], ScAssign "map" (SePipe (SeVar "map") [StSortBy "Addr"])]

Section: S03 -- Resolve function

  slot : ShellExpr = SeIndex (SeVar "map") (SeVar "i")

  covers-rip : ShellExpr = SeAnd (SeIntLe (SeProperty slot "Addr") (SeVar "rip")) (SeIntGt (SeAdd (SeProperty slot "Addr") (SeProperty slot "Size")) (SeVar "rip"))

  s03-scan : List ShellCmd = [ScAssign "i" (SeSub (SeProperty (SeVar "map") "Length") (SeInt 1)), ScWhile (SeIntGe (SeVar "i") (SeInt 0)) [ScIf covers-rip [ScReturn (SeProperty slot "Name")] [], ScDecrement "i"], ScReturn (SeLit "<unknown>")]

  s03 : List ShellCmd = [ScFunction "Resolve-Addr" [sh-param "rip" SptLong] s03-scan]

Section: S04 -- Read profile and tally

  s04-tally : List ShellCmd = [ScAssign "hex" (SeTrim (SeVar "line")), ScIf (SeIntEq (SeTextLength (SeVar "hex")) (SeInt 0)) [ScContinue] [], ScAssign "rip" (SeStaticCall "Convert" "ToInt64" [SeVar "hex", SeInt 16]), ScAssign "func" (SeCall "Resolve-Addr" [SeVar "rip"]), ScIf (SeMethodCall (SeVar "tally") "ContainsKey" [SeVar "func"]) [ScSetIndex "tally" (SeVar "func") (SeAdd (SeIndex (SeVar "tally") (SeVar "func")) (SeInt 1))] [ScSetIndex "tally" (SeVar "func") (SeInt 1)]]

  s04 : List ShellCmd = [ScDotNetCallAssign "profLines" "System.IO.File" "ReadAllLines" [SeVar "ProfFile"], ScAssign "totalSamples" (SeProperty (SeVar "profLines") "Length"), ScIf (SeIntEq (SeVar "totalSamples") (SeInt 0)) [ScEcho (SeLit "No samples in profile."), ScExit (SeInt 0)] [], ScAssign "tally" SeHashLiteral, ScForEach "line" (SeVar "profLines") s04-tally]

Section: S05 -- Sort and print histogram

  bar-width : ShellExpr = SeVar "barWidth"

  row-format : ShellExpr = SeConcat (SeConcat (SeLit "{0,7} {1,5:F1}%  {2,-") bar-width) (SeLit "} {3}")

  head-format : ShellExpr = SeConcat (SeConcat (SeLit "{0,7} {1,6}  {2,-") bar-width) (SeLit "} {3}")

  s05-header : List ShellCmd = [ScAssign "sorted" (SePipe (SeMethodCall (SeVar "tally") "GetEnumerator" []) [StSortDesc "Value"]), ScAssign "barWidth" (SeInt 40), ScEcho (SeLit ""), ScEcho (SeFormat (SeLit "Profiler Histogram -- {0:N0} samples, {1:N0} unique functions") [SeVar "totalSamples", SeProperty (SeVar "tally") "Count"]), ScEcho (SeLit ""), ScEcho (SeFormat head-format [SeLit "Samples", SeLit "%", SeLit "", SeLit "Function"]), ScEcho (SeFormat head-format [SeLit "-------", SeLit "------", SeMul (SeLit "-") bar-width, SeLit "--------"])]

  entry-value : ShellExpr = SeProperty (SeVar "entry") "Value"

  bar-fraction : ShellExpr = SeMul (SeDiv entry-value (SeVar "totalSamples")) bar-width

  s05-row : List ShellCmd = [ScAssign "pct" (SeMul (SeDiv entry-value (SeVar "totalSamples")) (SeInt 100)), ScAssign "barLen" (SeStaticCall "Math" "Max" [SeInt 1, SeStaticCall "Math" "Round" [bar-fraction]]), ScAssign "bar" (SeMul (SeLit "#") (SeStaticCall "Math" "Min" [SeVar "barLen", bar-width])), ScEcho (SeFormat row-format [entry-value, SeVar "pct", SeVar "bar", SeProperty (SeVar "entry") "Key"]), ScIncrement "shown"]

  s05-loop : List ShellCmd = [ScAssign "shown" (SeInt 0), ScAssign "otherSamples" (SeInt 0), ScForEach "entry" (SeVar "sorted") [ScIf (SeIntGe (SeVar "shown") (SeVar "Top")) [ScIncrementBy "otherSamples" entry-value, ScContinue] [], ScSequence s05-row]]

  more-label : ShellExpr = SeConcat (SeConcat (SeLit "... (") (SeSub (SeProperty (SeVar "tally") "Count") (SeVar "Top"))) (SeLit " more)")

  s05-tail : List ShellCmd = [ScIf (SeIntGt (SeVar "otherSamples") (SeInt 0)) [ScAssign "pct" (SeMul (SeDiv (SeVar "otherSamples") (SeVar "totalSamples")) (SeInt 100)), ScEcho (SeFormat row-format [SeVar "otherSamples", SeVar "pct", SeLit "", more-label])] [], ScEcho (SeLit "")]

  s05 : List ShellCmd = [ScSequence s05-header, ScSequence s05-loop, ScSequence s05-tail]

Section: Assembly

  ph-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05]

  ph-script : ShellScript = sh-script "profile-histogram" "Resolve profiler RIP addresses and print frequency histogram" ph-params ph-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell ph-script)
  end

