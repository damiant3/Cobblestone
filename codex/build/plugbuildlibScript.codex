Chapter: PlugBuildLibScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

 We say:

Section: S01 -- Preamble and registry

  s01-body : List ShellCmd =
    [ScComment "Common plug build library. Source this from plug build scripts.",
     ScComment "Provides: Resolve-PlugForewords, Build-PlugCdx, Add-PlugChapter,",
     ScComment "          Bundle-PlugSource, Build-TranspilerPlug",
     ScBlank,
     ScRaw "$script:PlugBuildRepo = (Resolve-Path (Join-Path $PSScriptRoot '..' '..' '..')).Path",
     ScRaw ". (Join-Path $script:PlugBuildRepo 'build' 'vm-config.ps1')",
    ScRaw ". (Join-Path $script:PlugBuildRepo 'build' 'plug-source-digest.ps1')",
     ScBlank,
     ScComment "The registry and the pattern come from build/quire-map.ps1. This used to",
     ScComment "DERIVE a quire table by globbing codex\\foreword, codex\\os, apps and",
     ScComment "apps\\games and capitalising each directory name, which is worse than a",
     ScComment "copy: a copy can be compared, a derivation quietly answers a different",
     ScComment "question. It could not see any quire outside those four roots, so",
     ScComment "Wflow (codex\\workflow), Boards (codex\\boards) and Tracker",
     ScComment "(codex\\tracker) did not exist here at all, and it invented names the",
     ScComment "registry does not use for anything whose directory name happened to",
     ScComment "differ. A plug citing one of those got MISSING and exit 3 for a chapter",
     ScComment "that is registered and present.",
     ScRaw ". (Join-Path $script:PlugBuildRepo 'build' 'quire-map.ps1')",
     ScRaw "$script:QuireDirs = $QuireDirs",
     ScRaw "$script:CitePat = $StrictCitePat",
     ScComment "Every file the assembler reads, so Bundle-PlugSource can record them.",
     ScRaw "$script:PlugInputs = [System.Collections.Generic.List[string]]::new()"]

Section: S02 -- Add-PlugChapter

  s02-body : List ShellCmd =
    [ScBlank, ScRaw "function Add-PlugChapter {",
     ScRaw "    param(",
     ScRaw "        [System.Collections.Generic.List[string]]$Lines,",
     ScRaw "        [string]$Path,",
     ScRaw "        [string[]]$StripCites = @(),",
     ScRaw "        [string]$Quire = '',",
     ScRaw "        [string[]]$DropSections = @()",
     ScRaw "    )",
     ScIndent [ScComment "DropSections lets a compiler chapter be bundled for its DECLARATIONS while"],
     ScIndent [ScComment "leaving behind a section the plug cannot compile. Only one section needs it"],
     ScIndent [ScComment "today: AST Nodes' \"Deck Copies\", whose leaf copiers (copy-sx-text and"],
     ScIndent [ScComment "friends) live in SyntaxNodes, a chapter of 66 CST declarations the plug"],
     ScIndent [ScComment "never touches. Dropping that one section is what keeps SyntaxNodes out of"],
     ScIndent [ScComment "the bundle. A renamed section fails the build loudly (the declarations it"],
     ScIndent [ScComment "guarded go missing); it cannot rot silently."],
     ScIndent [ScComment "Prefix the chapter name with the plug's quire (e.g. Riscv--RiscVPlug)."],
     ScIndent [ScComment "Mirrors Resolve-PlugForewords' prefixing."],
     ScRaw "    $renamed = $false",
     ScRaw "    $dropping = $false",
     ScRaw "    $script:PlugInputs.Add($Path)",
     ScRaw "    foreach ($l in [System.IO.File]::ReadAllLines($Path)) {",
     ScRaw "        if ($l -match '^Section:\\s*(.+?)\\s*$') {",
     ScRaw "            $dropping = $DropSections -contains $matches[1]",
     ScRaw "        }",
     ScRaw "        if ($dropping) { continue }",
     ScRaw "        $skip = $false",
     ScRaw "        foreach ($sc in $StripCites) { if ($l -match \"cites.*$sc\") { $skip = $true } }",
     ScRaw "        if ($skip) { continue }",
     ScRaw "        if ($Quire -and (-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "            $Lines.Add(\"Chapter: $Quire--$($matches[1])\")",
     ScRaw "            $renamed = $true",
     ScRaw "        } else {",
     ScRaw "            $Lines.Add($l)",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    $Lines.Add(''); $Lines.Add('')",
     ScRaw "}"]

Section: S03 -- Resolve-PlugForewords

  s03-body : List ShellCmd =
    [ScBlank, ScRaw "function Resolve-PlugForewords {",
     ScRaw "    param([System.Collections.Generic.List[string]]$Lines)",
     ScRaw "    $visiting = @{}",
     ScRaw "    $visited  = @{}",
     ScRaw "    $ordered  = [System.Collections.Generic.List[hashtable]]::new()",
     ScIndent [ScComment "A cite is satisfied two ways, and the second one is why the strict"],
     ScIndent [ScComment "pattern needs this: the chapter is RESOLVED through the registry, or it"],
     ScIndent [ScComment "is already PRESENT because Add-PlugChapter bundled it. Every plug"],
     ScIndent [ScComment "codegen chapter says `cites Plug chapter Plug Types`, and there is no"],
     ScIndent [ScComment "quire named Plug -- PlugTypes.codex is added directly. The old lenient"],
     ScIndent [ScComment "pattern was built from a derived key list that had no Plug either, so"],
     ScIndent [ScComment "that cite never matched and was skipped by accident rather than by"],
     ScIndent [ScComment "rule. Same rule as Resolve-CiteOrder's, same helper."],
     ScRaw "    $present = Get-PresentChapterNames -Lines $Lines",
     ScRaw "    function Resolve-PlugCite([string]$quire, [string]$name) {",
     ScRaw "        $key = \"${quire}::${name}\"",
     ScRaw "        if ($visited[$key]) { return }",
     ScRaw "        if ($visiting[$key]) { return }",
     ScRaw "        $visiting[$key] = $true",
     ScIndent [ScIndent [ScComment "Presence is asked FIRST: asked only after the registry fails, a chapter"]],
     ScIndent [ScIndent [ScComment "both present and resolvable is bundled twice (CDX3006 per definition)."]],
     ScRaw "        if ($present[(Get-CiteKey $name)]) { [void]$visiting.Remove($key); $visited[$key] = $true; return }",
     ScRaw "        $dir = $script:QuireDirs[$quire]",
     ScRaw "        $fwPath = if ($dir) { Join-Path $script:PlugBuildRepo (Join-Path $dir \"$name.codex\") } else { $null }",
     ScRaw "        if ((-not $fwPath) -or (-not (Test-Path -PathType Leaf $fwPath))) {",
     ScRaw "            [void]$visiting.Remove($key)",
     ScRaw "            $why = if ($dir) { \"expected $fwPath\" } else { \"quire '$quire' is not registered in build/quire-map.ps1, and no chapter '$name' is present in the unit\" }",
     ScRaw "            [Console]::Error.WriteLine(\"MISSING: cited $quire chapter '$name' ($why)\")",
     ScRaw "            exit 3",
     ScRaw "        }",
     ScRaw "        foreach ($l in [System.IO.File]::ReadAllLines($fwPath)) {",
     ScRaw "            if ($l -match $script:CitePat) { Resolve-PlugCite $matches[1] $matches[2] }",
     ScRaw "        }",
     ScRaw "        [void]$visiting.Remove($key)",
     ScRaw "        $visited[$key] = $true",
     ScRaw "        [void]$ordered.Add(@{ Quire = $quire; Name = $name; Path = $fwPath })",
     ScRaw "    }"]

  s03b-body : List ShellCmd =
    [ScRaw "    foreach ($l in $Lines) {",
     ScRaw "        if ($l -match $script:CitePat) { Resolve-PlugCite $matches[1] $matches[2] }",
     ScRaw "    }",
     ScRaw "    $preLines = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($entry in $ordered) {",
     ScRaw "        $script:PlugInputs.Add($entry.Path)",
     ScRaw "        $renamed = $false",
     ScRaw "        foreach ($l in [System.IO.File]::ReadAllLines($entry.Path)) {",
     ScRaw "            if ((-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "                [void]$preLines.Add(\"Chapter: $($entry.Quire)--$($matches[1])\")",
     ScRaw "                $renamed = $true",
     ScRaw "            } else { [void]$preLines.Add($l) }",
     ScRaw "        }",
     ScRaw "        [void]$preLines.Add(''); [void]$preLines.Add('')",
     ScRaw "    }",
     ScRaw "    return ,$preLines",
     ScRaw "}"]

Section: S04 -- Bundle-PlugSource

  s04-body : List ShellCmd =
    [ScBlank, ScRaw "function Bundle-PlugSource {", ScRaw "    param(", ScRaw "        [System.Collections.Generic.List[string]]$PreLines,", ScRaw "        [System.Collections.Generic.List[string]]$Lines,", ScRaw "        [string]$BundleSrc,", ScRaw "        [string]$PlugName", ScRaw "    )", ScRaw "    $body = (($PreLines + $Lines) -join \"`n\") + \"`n\"", ScRaw "    [System.IO.File]::WriteAllText($BundleSrc, $body, [System.Text.UTF8Encoding]::new($false))", ScIndent [ScComment "The manifest of every source this bundle was assembled from. deck-headroom"], ScIndent [ScComment "re-hashes it to tell a stale bundle from a restamped one; mtime cannot,"], ScIndent [ScComment "because p4 sync -f touches every tracked file."], ScRaw "    $plugDir = Split-Path (Split-Path $BundleSrc -Parent) -Parent", ScRaw "    Write-PlugSourceManifest -BundleSrc $BundleSrc -PlugDir $plugDir -Inputs $script:PlugInputs.ToArray()", ScRaw "    $script:PlugInputs.Clear()", ScRaw "    Write-Host \"[$PlugName] bundled $($PreLines.Count + $Lines.Count) lines, $($body.Length) bytes\"", ScRaw "}"]

Section: S05 -- Build-PlugCdx

  s05-body : List ShellCmd =
    [ScBlank, ScRaw "function Build-PlugCdx {",
     ScRaw "    param(",
     ScRaw "        [string]$BundleSrc,",
     ScRaw "        [string]$OutFile,",
     ScRaw "        [string]$LogFile,",
     ScRaw "        [string]$PlugName,",
     ScRaw "        [string]$Survey = '',",
     ScIndent [ScIndent [ScComment "Deck scale for this bundle; 0 leaves the length derivation alone."]],
     ScIndent [ScIndent [ScComment "scaled-floor is linear in source length and CHECK is not, so a"]],
     ScIndent [ScIndent [ScComment "dense bundle can sit at zero margin and refuse the next definition"]],
     ScIndent [ScIndent [ScComment "added to it with CDX9002. Deck scale is a reservation and not an"]],
     ScIndent [ScIndent [ScComment "input to codegen: measured 2026-08-27 the arm64 plug is"]],
     ScIndent [ScIndent [ScComment "byte-identical at -Decks 120 and 140, so raising it cannot move"]],
     ScIndent [ScIndent [ScComment "the artifact it produces."]],
     ScRaw "        [int]$Decks = 0",
     ScRaw "    )",
     ScRaw "    $compileScript = Join-Path $script:PlugBuildRepo 'build' 'compile.ps1'",
     ScRaw "    $compileArgs = @('-NoProfile', '-File', $compileScript, '-Src', $BundleSrc, '-Out', $OutFile, '-Log', $LogFile, '-Kernel', (Join-Path $script:PlugBuildRepo 'seed' 'Codex.cdx'))",
     ScRaw "    if ($Decks -ne 0) { $compileArgs += @('-Decks', $Decks) }",
     ScRaw "    & pwsh @compileArgs 2>&1 | Out-Null",
     ScRaw "    if ($LASTEXITCODE -ne 0) {",
     ScRaw "        [Console]::Error.WriteLine(\"FAIL: compile errors; see $LogFile\")",
     ScRaw "        Get-Content $LogFile -ErrorAction SilentlyContinue | Select-Object -First 10 | ForEach-Object { [Console]::Error.WriteLine(\"  $_\") }",
     ScRaw "        exit 5",
     ScRaw "    }",
     ScRaw "    $sz = (Get-Item $OutFile).Length",
     ScRaw "    Write-Host \"[$PlugName] OK: $OutFile ($sz bytes)\"",
     ScRaw "}"]

Section: S06 -- Build-TranspilerPlug

  s06-body : List ShellCmd =
    [ScBlank, ScRaw "function Build-TranspilerPlug {",
     ScRaw "    param(",
     ScRaw "        [string]$PlugDir,",
     ScRaw "        [string]$PlugName,",
     ScRaw "        [string[]]$Chapters,",
     ScRaw "        [string]$Survey = '',",
     ScIndent [ScIndent [ScComment "Bundle the compiler's LIR so a native backend can lower to it plug-side"]],
     ScIndent [ScIndent [ScComment "(the retarget's Route A). Off by default: the transpiler plugs emit"]],
     ScIndent [ScIndent [ScComment "high-level source and have no use for registers, so they should not"]],
     ScIndent [ScIndent [ScComment "carry 147 KB of allocator. Lir cites Build Settings and IR Chapter and"]],
     ScIndent [ScIndent [ScComment "LirTargets cites Lir; all three end up in this one unit, so those cites"]],
     ScIndent [ScIndent [ScComment "are stripped rather than resolved."]],
     ScRaw "        [switch]$WithLir,",
     ScIndent [ScIndent [ScComment "Chapters under codex/plugs/common bundled AFTER IRTextParser and"]],
     ScIndent [ScIndent [ScComment "BEFORE the plug's own: shared helpers a lane opts into by name"]],
     ScIndent [ScIndent [ScComment "(PlugManifest for the boot grant), so a second native lane picks"]],
     ScIndent [ScIndent [ScComment "up the same derivation instead of a copy."]],
     ScRaw "        [string[]]$CommonChapters = @(),",
     ScIndent [ScIndent [ScComment "Compiler chapters under codex/compiler bundled after the IR"]],
     ScIndent [ScIndent [ScComment "declarations, for a plug that runs a compiler analysis over its own"]],
     ScIndent [ScIndent [ScComment "IRDefs (the zig plug takes IR\\ConstShare, COMPILER-86 stage 3). Each"]],
     ScIndent [ScIndent [ScComment "must cite nothing outside the declaration chapters above."]],
     ScRaw "        [string[]]$CompilerChapters = @(),",
     ScRaw "        [int]$Decks = 0",
     ScRaw "    )",
     ScRaw "    $outDir    = Join-Path $PlugDir 'build-output'",
     ScRaw "    $outFile   = Join-Path $outDir \"$PlugName-plug.cdx\"",
     ScRaw "    $bundleSrc = Join-Path $outDir 'plug-source.codex'",
     ScRaw "    $logFile   = Join-Path $outDir 'build.log'",
     ScRaw "    New-Item -ItemType Directory -Force -Path $outDir | Out-Null",
     ScBlank,
     ScIndent [ScComment "Namespace every chapter in the bundle under the plug's own quire."],
     ScRaw "    $plugQuire = $PlugName.Substring(0,1).ToUpper() + $PlugName.Substring(1)",
     ScBlank,
     ScIndent [ScComment "The plug reads the compiler's own declaration chapters. There is one"],
     ScIndent [ScComment "declaration of Name, SourceSpan, CodexType, the AST nodes and the IR"],
     ScIndent [ScComment "nodes in the tree, and this is it -- the plug used to carry a second,"],
     ScIndent [ScComment "hand-maintained copy that nothing checked and no compile could see,"],
     ScIndent [ScComment "because the two never meet in one unit. Four bundle whole; AST Nodes"],
     ScIndent [ScComment "drops Deck Copies (see Add-PlugChapter)."],
     ScRaw "    $lines = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($decl in @('codex\\compiler\\Core\\Name.codex',",
     ScRaw "                        'codex\\compiler\\Core\\SourceText.codex',",
     ScRaw "                        'codex\\compiler\\Types\\CodexType.codex',",
     ScRaw "                        'codex\\compiler\\Ast\\AstNodes.codex',",
     ScRaw "                        'codex\\compiler\\IR\\IRChapter.codex')) {",
     ScRaw "        $drop = if ($decl -like '*AstNodes.codex') { @('Deck Copies') } else { @() }",
     ScIndent [ScIndent [ScComment "Plug Types supplies the deck-record these chapters cite Phase Allocator"]],
     ScIndent [ScIndent [ScComment "for, and Deck Copies is the only section of AST Nodes that uses Syntax"]],
     ScIndent [ScIndent [ScComment "Nodes. The cite lines leave the bundle, or compile.ps1's re-resolve"]],
     ScIndent [ScIndent [ScComment "pulls the whole compiler in for them."]],
     ScRaw "        $strip = @('Phase Allocator')",
     ScRaw "        if ($decl -like '*AstNodes.codex') { $strip += 'Syntax Nodes' }",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo $decl) -Quire $plugQuire -DropSections $drop -StripCites $strip",
     ScRaw "    }"]

  s06b-body : List ShellCmd =
    [ScRaw "    if ($WithLir) {",
     ScIndent [ScIndent [ScComment "CodexTypeHelpers owns hw-width-bytes / -signed / bounds-to-hw-width and"]],
     ScIndent [ScIndent [ScComment "Token owns pat-lit-to-integer; the lowering calls all four. Both cite"]],
     ScIndent [ScIndent [ScComment "nothing beyond the declaration chapters, which is what makes Route A"]],
     ScIndent [ScIndent [ScComment "affordable -- they come in as leaves rather than dragging the Types or"]],
     ScIndent [ScIndent [ScComment "Syntax quire behind them."]],
     ScRaw "        foreach ($lir in @('codex\\compiler\\Core\\BuildSettings.codex',",
     ScRaw "                           'codex\\compiler\\Types\\CodexTypeHelpers.codex',",
     ScRaw "                           'codex\\compiler\\Syntax\\Token.codex',",
     ScRaw "                           'codex\\compiler\\IR\\Lir.codex',",
     ScRaw "                           'codex\\compiler\\IR\\LirTargets.codex')) {",
     ScRaw "            Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo $lir) -Quire $plugQuire -StripCites @('Build Settings', 'IR Chapter', 'chapter Lir', 'Phase Allocator')",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    foreach ($cc in $CompilerChapters) {",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo \"codex\\compiler\\$cc.codex\") -Quire $plugQuire",
     ScRaw "    }",
     ScRaw "    Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo 'codex\\plugs\\common\\PlugTypes.codex') -Quire $plugQuire",
     ScRaw "    Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo 'codex\\plugs\\common\\IRTextParser.codex') -Quire $plugQuire",
     ScRaw "    foreach ($cc in $CommonChapters) {",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo \"codex\\plugs\\common\\$cc.codex\") -Quire $plugQuire",
     ScRaw "    }",
     ScRaw "    foreach ($ch in $Chapters) {",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $PlugDir \"$ch.codex\") -Quire $plugQuire",
     ScRaw "    }",
     ScBlank,
     ScRaw "    $preLines = Resolve-PlugForewords $lines",
     ScRaw "    Bundle-PlugSource -PreLines $preLines -Lines $lines -BundleSrc $bundleSrc -PlugName \"$PlugName-plug\"",
     ScRaw "    Build-PlugCdx -BundleSrc $bundleSrc -OutFile $outFile -LogFile $logFile -PlugName \"$PlugName-plug\" -Survey $Survey -Decks $Decks",
     ScRaw "}"]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble and registry", ps-why = "the header a plug build script sources, and the registry every later function reads", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 3 "the plug registry could not be read, so no plug can be resolved"], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "add-plugchapter", ps-why = "append one chapter to a plug's source list", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "resolve-plugforewords", ps-why = "the foreword chapters a plug's cites pull in, resolved transitively", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 3 "a cited foreword chapter could not be resolved, so the bundle would compile against a chapter that is not there"], ps-body = s03-body }

  s03b : PipeStage = PipeStage { ps-name = "resolve-plugforewords, the scan", ps-why = "the line loop of the previous function, split out because the shipped script carries no blank between the two and the model must not add one", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03b-body }

  s04 : PipeStage = PipeStage { ps-name = "bundle-plugsource", ps-why = "the resolved chapters concatenated into the single unit a plug compiles as", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "build-plugcdx", ps-why = "compile a bundled plug to CDX", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 5 "the plug bundle failed to compile"], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "build-transpilerplug", ps-why = "the transpiler-plug variant, which takes IR rather than source", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  s06b : PipeStage = PipeStage { ps-name = "build-transpilerplug, the lir arm", ps-why = "the -WithLir branch of the previous function, split out for the same no-blank reason as s03b", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06b-body }

  lib-pipe : Pipeline = Pipeline { pl-name = "plug-build-lib", pl-doc = "Common plug build library -- shared functions for plug build scripts", pl-params = [], pl-stages = [PsStage s01, PsStage s02, PsStage s03, PsStage s03b, PsStage s04, PsStage s05, PsStage s06, PsStage s06b] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell lib-pipe))
  end

Page 1
