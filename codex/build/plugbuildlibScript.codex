Chapter: PlugBuildLibScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: S01 -- Preamble and registry

  s01 : List ShellCmd =
    [ScRaw "# Common plug build library. Source this from plug build scripts.",
     ScRaw "# Provides: Resolve-PlugForewords, Build-PlugCdx, Add-PlugChapter,",
     ScRaw "#           Bundle-PlugSource, Build-TranspilerPlug",
     ScBlank,
     ScRaw "$script:PlugBuildRepo = (Resolve-Path (Join-Path $PSScriptRoot '..' '..' '..')).Path",
     ScRaw ". (Join-Path $script:PlugBuildRepo 'build' 'vm-config.ps1')",
     ScBlank,
     ScRaw "# The registry and the pattern come from build/quire-map.ps1. This used to",
     ScRaw "# DERIVE a quire table by globbing codex\\foreword, codex\\os, apps and",
     ScRaw "# apps\\games and capitalising each directory name, which is worse than a",
     ScRaw "# copy: a copy can be compared, a derivation quietly answers a different",
     ScRaw "# question. It could not see any quire outside those four roots, so",
     ScRaw "# Wflow (codex\\workflow), Boards (codex\\boards) and Tracker",
     ScRaw "# (codex\\tracker) did not exist here at all, and it invented names the",
     ScRaw "# registry does not use for anything whose directory name happened to",
     ScRaw "# differ. A plug citing one of those got MISSING and exit 3 for a chapter",
     ScRaw "# that is registered and present.",
     ScRaw ". (Join-Path $script:PlugBuildRepo 'build' 'quire-map.ps1')",
     ScRaw "$script:QuireDirs = $QuireDirs",
     ScRaw "$script:CitePat = $StrictCitePat"]

Section: S02 -- Add-PlugChapter

  s02 : List ShellCmd =
    [ScRaw "function Add-PlugChapter {",
     ScRaw "    param(",
     ScRaw "        [System.Collections.Generic.List[string]]$Lines,",
     ScRaw "        [string]$Path,",
     ScRaw "        [string[]]$StripCites = @(),",
     ScRaw "        [string]$Quire = '',",
     ScRaw "        [string[]]$DropSections = @()",
     ScRaw "    )",
     ScRaw "    # DropSections lets a compiler chapter be bundled for its DECLARATIONS while",
     ScRaw "    # leaving behind a section the plug cannot compile. Only one section needs it",
     ScRaw "    # today: AST Nodes' \"Deck Copies\", whose leaf copiers (copy-sx-text and",
     ScRaw "    # friends) live in SyntaxNodes, a chapter of 66 CST declarations the plug",
     ScRaw "    # never touches. Dropping that one section is what keeps SyntaxNodes out of",
     ScRaw "    # the bundle. A renamed section fails the build loudly (the declarations it",
     ScRaw "    # guarded go missing); it cannot rot silently.",
     ScRaw "    # Prefix the chapter name with the plug's quire (e.g. Riscv--RiscVPlug).",
     ScRaw "    # Mirrors Resolve-PlugForewords' prefixing.",
     ScRaw "    $renamed = $false",
     ScRaw "    $dropping = $false",
     ScRaw "    foreach ($l in [System.IO.File]::ReadAllLines($Path)) {",
     ScRaw "        if ($l -match '^Section:\\s*(.+?)\\s*$') {",
     ScRaw "            $dropping = $DropSections -contains $matches[1]",
     ScRaw "        }",
     ScRaw "        if ($dropping) { continue }",
     ScRaw "        $skip = $false",
     ScRaw "        foreach ($sc in $StripCites) { if ($l -match \"cites.*$sc\") { $skip = $true } }",
     ScRaw "        if ($skip) { continue }",
     ScRaw "        if ($Quire -and (-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "            $Lines.Add(\"Chapter: $Quire--$($matches[1])\")",
     ScRaw "            $renamed = $true",
     ScRaw "        } else {",
     ScRaw "            $Lines.Add($l)",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    $Lines.Add(''); $Lines.Add('')",
     ScRaw "}"]

Section: S03 -- Resolve-PlugForewords

  s03 : List ShellCmd =
    [ScRaw "function Resolve-PlugForewords {",
     ScRaw "    param([System.Collections.Generic.List[string]]$Lines)",
     ScRaw "    $visiting = @{}",
     ScRaw "    $visited  = @{}",
     ScRaw "    $ordered  = [System.Collections.Generic.List[hashtable]]::new()",
     ScRaw "    # A cite is satisfied two ways, and the second one is why the strict",
     ScRaw "    # pattern needs this: the chapter is RESOLVED through the registry, or it",
     ScRaw "    # is already PRESENT because Add-PlugChapter bundled it. Every plug",
     ScRaw "    # codegen chapter says `cites Plug chapter Plug Types`, and there is no",
     ScRaw "    # quire named Plug -- PlugTypes.codex is added directly. The old lenient",
     ScRaw "    # pattern was built from a derived key list that had no Plug either, so",
     ScRaw "    # that cite never matched and was skipped by accident rather than by",
     ScRaw "    # rule. Same rule as Resolve-CiteOrder's, same helper.",
     ScRaw "    $present = Get-PresentChapterNames -Lines $Lines",
     ScRaw "    function Resolve-PlugCite([string]$quire, [string]$name) {",
     ScRaw "        $key = \"${quire}::${name}\"",
     ScRaw "        if ($visited[$key]) { return }",
     ScRaw "        if ($visiting[$key]) { return }",
     ScRaw "        $visiting[$key] = $true",
     ScRaw "        # Presence is asked FIRST: asked only after the registry fails, a chapter",
     ScRaw "        # both present and resolvable is bundled twice (CDX3006 per definition).",
     ScRaw "        if ($present[(Get-CiteKey $name)]) { [void]$visiting.Remove($key); $visited[$key] = $true; return }",
     ScRaw "        $dir = $script:QuireDirs[$quire]",
     ScRaw "        $fwPath = if ($dir) { Join-Path $script:PlugBuildRepo (Join-Path $dir \"$name.codex\") } else { $null }",
     ScRaw "        if ((-not $fwPath) -or (-not (Test-Path -PathType Leaf $fwPath))) {",
     ScRaw "            [void]$visiting.Remove($key)",
     ScRaw "            $why = if ($dir) { \"expected $fwPath\" } else { \"quire '$quire' is not registered in build/quire-map.ps1, and no chapter '$name' is present in the unit\" }",
     ScRaw "            [Console]::Error.WriteLine(\"MISSING: cited $quire chapter '$name' ($why)\")",
     ScRaw "            exit 3",
     ScRaw "        }",
     ScRaw "        foreach ($l in [System.IO.File]::ReadAllLines($fwPath)) {",
     ScRaw "            if ($l -match $script:CitePat) { Resolve-PlugCite $matches[1] $matches[2] }",
     ScRaw "        }",
     ScRaw "        [void]$visiting.Remove($key)",
     ScRaw "        $visited[$key] = $true",
     ScRaw "        [void]$ordered.Add(@{ Quire = $quire; Name = $name; Path = $fwPath })",
     ScRaw "    }"]

  s03b : List ShellCmd =
    [ScRaw "    foreach ($l in $Lines) {",
     ScRaw "        if ($l -match $script:CitePat) { Resolve-PlugCite $matches[1] $matches[2] }",
     ScRaw "    }",
     ScRaw "    $preLines = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($entry in $ordered) {",
     ScRaw "        $renamed = $false",
     ScRaw "        foreach ($l in [System.IO.File]::ReadAllLines($entry.Path)) {",
     ScRaw "            if ((-not $renamed) -and $l -match '^Chapter:\\s*(.+?)\\s*$') {",
     ScRaw "                [void]$preLines.Add(\"Chapter: $($entry.Quire)--$($matches[1])\")",
     ScRaw "                $renamed = $true",
     ScRaw "            } else { [void]$preLines.Add($l) }",
     ScRaw "        }",
     ScRaw "        [void]$preLines.Add(''); [void]$preLines.Add('')",
     ScRaw "    }",
     ScRaw "    return ,$preLines",
     ScRaw "}"]

Section: S04 -- Bundle-PlugSource

  s04 : List ShellCmd =
    [ScRaw "function Bundle-PlugSource {", ScRaw "    param(", ScRaw "        [System.Collections.Generic.List[string]]$PreLines,", ScRaw "        [System.Collections.Generic.List[string]]$Lines,", ScRaw "        [string]$BundleSrc,", ScRaw "        [string]$PlugName", ScRaw "    )", ScRaw "    $body = (($PreLines + $Lines) -join \"`n\") + \"`n\"", ScRaw "    [System.IO.File]::WriteAllText($BundleSrc, $body, [System.Text.UTF8Encoding]::new($false))", ScRaw "    Write-Host \"[$PlugName] bundled $($PreLines.Count + $Lines.Count) lines, $($body.Length) bytes\"", ScRaw "}"]

Section: S05 -- Build-PlugCdx

  s05 : List ShellCmd =
    [ScRaw "function Build-PlugCdx {",
     ScRaw "    param(",
     ScRaw "        [string]$BundleSrc,",
     ScRaw "        [string]$OutFile,",
     ScRaw "        [string]$LogFile,",
     ScRaw "        [string]$PlugName,",
     ScRaw "        [string]$Survey = '',",
     ScRaw "        # Deck scale for this bundle; 0 leaves the length derivation alone.",
     ScRaw "        # scaled-floor is linear in source length and CHECK is not, so a",
     ScRaw "        # dense bundle can sit at zero margin and refuse the next definition",
     ScRaw "        # added to it with CDX9002. Deck scale is a reservation and not an",
     ScRaw "        # input to codegen: measured 2026-08-27 the arm64 plug is",
     ScRaw "        # byte-identical at -Decks 120 and 140, so raising it cannot move",
     ScRaw "        # the artifact it produces.",
     ScRaw "        [int]$Decks = 0",
     ScRaw "    )",
     ScRaw "    $compileScript = Join-Path $script:PlugBuildRepo 'build' 'compile.ps1'",
     ScRaw "    $compileArgs = @('-NoProfile', '-File', $compileScript, '-Src', $BundleSrc, '-Out', $OutFile, '-Log', $LogFile, '-Kernel', (Join-Path $script:PlugBuildRepo 'seed' 'Codex.cdx'))",
     ScRaw "    if ($Decks -ne 0) { $compileArgs += @('-Decks', $Decks) }",
     ScRaw "    & pwsh @compileArgs 2>&1 | Out-Null",
     ScRaw "    if ($LASTEXITCODE -ne 0) {",
     ScRaw "        [Console]::Error.WriteLine(\"FAIL: compile errors; see $LogFile\")",
     ScRaw "        Get-Content $LogFile -ErrorAction SilentlyContinue | Select-Object -First 10 | ForEach-Object { [Console]::Error.WriteLine(\"  $_\") }",
     ScRaw "        exit 5",
     ScRaw "    }",
     ScRaw "    $sz = (Get-Item $OutFile).Length",
     ScRaw "    Write-Host \"[$PlugName] OK: $OutFile ($sz bytes)\"",
     ScRaw "}"]

Section: S06 -- Build-TranspilerPlug

  s06 : List ShellCmd =
    [ScRaw "function Build-TranspilerPlug {",
     ScRaw "    param(",
     ScRaw "        [string]$PlugDir,",
     ScRaw "        [string]$PlugName,",
     ScRaw "        [string[]]$Chapters,",
     ScRaw "        [string]$Survey = '',",
     ScRaw "        # Bundle the compiler's LIR so a native backend can lower to it plug-side",
     ScRaw "        # (the retarget's Route A). Off by default: the transpiler plugs emit",
     ScRaw "        # high-level source and have no use for registers, so they should not",
     ScRaw "        # carry 147 KB of allocator. Lir cites Build Settings and IR Chapter and",
     ScRaw "        # LirTargets cites Lir; all three end up in this one unit, so those cites",
     ScRaw "        # are stripped rather than resolved.",
     ScRaw "        [switch]$WithLir,",
     ScRaw "        # Chapters under codex/plugs/common bundled AFTER IRTextParser and",
     ScRaw "        # BEFORE the plug's own: shared helpers a lane opts into by name",
     ScRaw "        # (PlugManifest for the boot grant), so a second native lane picks",
     ScRaw "        # up the same derivation instead of a copy.",
     ScRaw "        [string[]]$CommonChapters = @(),",
     ScRaw "        [int]$Decks = 0",
     ScRaw "    )",
     ScRaw "    $outDir    = Join-Path $PlugDir 'build-output'",
     ScRaw "    $outFile   = Join-Path $outDir \"$PlugName-plug.cdx\"",
     ScRaw "    $bundleSrc = Join-Path $outDir 'plug-source.codex'",
     ScRaw "    $logFile   = Join-Path $outDir 'build.log'",
     ScRaw "    New-Item -ItemType Directory -Force -Path $outDir | Out-Null",
     ScBlank,
     ScRaw "    # Namespace every chapter in the bundle under the plug's own quire.",
     ScRaw "    $plugQuire = $PlugName.Substring(0,1).ToUpper() + $PlugName.Substring(1)",
     ScBlank,
     ScRaw "    # The plug reads the compiler's own declaration chapters. There is one",
     ScRaw "    # declaration of Name, SourceSpan, CodexType, the AST nodes and the IR",
     ScRaw "    # nodes in the tree, and this is it -- the plug used to carry a second,",
     ScRaw "    # hand-maintained copy that nothing checked and no compile could see,",
     ScRaw "    # because the two never meet in one unit. Four bundle whole; AST Nodes",
     ScRaw "    # drops Deck Copies (see Add-PlugChapter).",
     ScRaw "    $lines = [System.Collections.Generic.List[string]]::new()",
     ScRaw "    foreach ($decl in @('codex\\compiler\\Core\\Name.codex',",
     ScRaw "                        'codex\\compiler\\Core\\SourceText.codex',",
     ScRaw "                        'codex\\compiler\\Types\\CodexType.codex',",
     ScRaw "                        'codex\\compiler\\Ast\\AstNodes.codex',",
     ScRaw "                        'codex\\compiler\\IR\\IRChapter.codex')) {",
     ScRaw "        $drop = if ($decl -like '*AstNodes.codex') { @('Deck Copies') } else { @() }",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo $decl) -Quire $plugQuire -DropSections $drop",
     ScRaw "    }"]

  s06b : List ShellCmd =
    [ScRaw "    if ($WithLir) {",
     ScRaw "        # CodexTypeHelpers owns hw-width-bytes / -signed / bounds-to-hw-width and",
     ScRaw "        # Token owns pat-lit-to-integer; the lowering calls all four. Both cite",
     ScRaw "        # nothing, which is what makes Route A affordable -- they come in as",
     ScRaw "        # leaves rather than dragging the Types or Syntax quire behind them.",
     ScRaw "        foreach ($lir in @('codex\\compiler\\Core\\BuildSettings.codex',",
     ScRaw "                           'codex\\compiler\\Types\\CodexTypeHelpers.codex',",
     ScRaw "                           'codex\\compiler\\Syntax\\Token.codex',",
     ScRaw "                           'codex\\compiler\\IR\\Lir.codex',",
     ScRaw "                           'codex\\compiler\\IR\\LirTargets.codex')) {",
     ScRaw "            Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo $lir) -Quire $plugQuire -StripCites @('Build Settings', 'IR Chapter', 'chapter Lir')",
     ScRaw "        }",
     ScRaw "    }",
     ScRaw "    Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo 'codex\\plugs\\common\\PlugTypes.codex') -Quire $plugQuire",
     ScRaw "    Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo 'codex\\plugs\\common\\IRTextParser.codex') -Quire $plugQuire",
     ScRaw "    foreach ($cc in $CommonChapters) {",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $script:PlugBuildRepo \"codex\\plugs\\common\\$cc.codex\") -Quire $plugQuire",
     ScRaw "    }",
     ScRaw "    foreach ($ch in $Chapters) {",
     ScRaw "        Add-PlugChapter -Lines $lines -Path (Join-Path $PlugDir \"$ch.codex\") -Quire $plugQuire",
     ScRaw "    }",
     ScBlank,
     ScRaw "    $preLines = Resolve-PlugForewords $lines",
     ScRaw "    Bundle-PlugSource -PreLines $preLines -Lines $lines -BundleSrc $bundleSrc -PlugName \"$PlugName-plug\"",
     ScRaw "    Build-PlugCdx -BundleSrc $bundleSrc -OutFile $outFile -LogFile $logFile -PlugName \"$PlugName-plug\" -Survey $Survey -Decks $Decks",
     ScRaw "}"]

Section: Assembly

  lib-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScSequence s03b, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScSequence s06b]

  lib-script : ShellScript = sh-script "plug-build-lib" "Common plug build library -- shared functions for plug build scripts" [] lib-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell lib-script)
  end

