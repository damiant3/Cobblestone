Chapter: BuildExplorerPagesScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  explorerpages-params : List ShellParam = []

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScAssign "OutDir" (SeLit "D:\\Projects\\CodexMagic\\explorer\\pages"), ScMkdir (SeVar "OutDir"), ScBlank, ScRunDot (SePathJoin (SeVar "Repo") (SeLit "build\\vm-config.ps1"))]

Section: S02 -- Page Table

  page-entry : Text, Text -> ShellExpr
  page-entry (name) (cdx) = SeRecord [SfField "Name" (SeLit name), SfField "Cdx" (SeLit cdx)]

  s02 : List ShellCmd = [ScAssign "pages" (SeArrayLiteral [page-entry "card" "build-output\\carddesigner.cdx", page-entry "item" "build-output\\item-designer.cdx", page-entry "character" "build-output\\characterdesigner.cdx", page-entry "setting" "build-output\\settingdesigner.cdx", page-entry "voice" "build-output\\voicestudio.cdx"])]

Section: S03 -- Build Loop

  page-name : ShellExpr = SeProperty (SeVar "page") "Name"

  skip-message : ShellExpr = SeConcat (SeConcat (SeConcat (SeLit "SKIP ") page-name) (SeLit ": CDX not found at ")) (SeVar "cdx")

  s03-skip : List ShellCmd = [ScEchoStyled skip-message ClBrightYellow True, ScContinue]

  tmp-name : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeLit "explorer-") page-name) (SeLit "-")) (SeVar "PID")) (SeLit ".txt")

  s03-run : List ShellCmd = [ScEchoStyled (SeConcat (SeConcat (SeLit "Running ") page-name) (SeLit "...")) ClBrightCyan False, ScAssign "tmpOut" (SePathJoin (SeEnvVar "TEMP") tmp-name), ScRunArgsDropErr (SeLit "pwsh") [SaSwitch "NoProfile", SaNamed "File" (SePathJoin (SeVar "Repo") (SeLit "build\\test-run.ps1")), SaNamed "Kernel" (SeVar "cdx"), SaNamed "OutFile" (SeVar "tmpOut")]]

  ok-message : ShellExpr = SeConcat (SeConcat (SeLit " OK (") (SeTextLength (SeVar "content"))) (SeLit " bytes)")

  s03-have-content : List ShellCmd = [ScSetContent (SeVar "htmlOut") (SeVar "content"), ScEchoStyled ok-message ClBrightGreen True]

  s03-check-content : List ShellCmd = [ScAssign "content" (SeFileText (SeVar "tmpOut")), ScIf (SeAnd (SeVar "content") (SeIntGt (SeTextLength (SeVar "content")) (SeInt 100))) s03-have-content [ScEchoStyled (SeLit " EMPTY output") ClBrightYellow True], ScDelete (SeVar "tmpOut")]

  s03-no-output : List ShellCmd = [ScEchoStyled (SeLit " NO output file") ClBrightRed True]

  s03 : List ShellCmd = [ScForEach "page" (SeVar "pages") [ScAssign "cdx" (SePathJoin (SeVar "Repo") (SeProperty (SeVar "page") "Cdx")), ScAssign "htmlOut" (SePathJoin (SeVar "OutDir") (SeConcat page-name (SeLit ".html"))), ScIf (SeNot (SeFileExists (SeVar "cdx"))) s03-skip [], ScSequence s03-run, ScIf (SeFileExists (SeVar "tmpOut")) s03-check-content s03-no-output]]

Section: S04 -- Summary

  listing-line : ShellExpr = SeConcat (SeConcat (SeConcat (SeConcat (SeLit "  ") (SeProperty SeItem "Name")) (SeLit " (")) (SeProperty SeItem "Length")) (SeLit " bytes)")

  s04 : List ShellCmd = [ScEcho (SeLit ""), ScEchoStyled (SeConcat (SeLit "Pages built in ") (SeVar "OutDir")) ClBrightGreen True, ScPipeDo (SeListFiles (SeVar "OutDir") "*.html" False) [] [ScEcho listing-line]]

Section: Assembly

  explorerpages-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04]

  explorerpages-script : ShellScript = sh-script "build-explorer-pages" "Build explorer HTML pages from compiled CDX binaries" explorerpages-params explorerpages-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell explorerpages-script)
  end

