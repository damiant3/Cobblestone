Chapter: BootArm64Script

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  boot-arm64-timeout-doc : List Text = ["Bound the QEMU run so this script can be an ARM. 0, the default, keeps", "the interactive behaviour exactly: a foreground -nographic console with no", "deadline, which is what a person driving it by hand wants. Any positive", "value launches QEMU monitored, kills it at the deadline, sends the UART to", "a file, and REPORTS whether it exited on its own or was killed."]

  boot-arm64-port-doc : List Text = ["Override the derived host-forward port. 0 derives it from the workspace", "name, and a port already held is a refusal rather than a silent hop."]

  boot-arm64-params : List ShellParam = [sh-param "Src" SptString, sh-switch "NoBoot", sh-param-default "MemMB" SptInt (SeInt 4096), sh-doc boot-arm64-timeout-doc (sh-param-default "TimeoutSec" SptInt (SeInt 0)), sh-doc boot-arm64-port-doc (sh-param-default "HostPort" SptInt (SeInt 0))]

Section: S00 -- Usage

  s00 : List ShellCmd =
    [ScComment "Pipeline: source.codex -> IR -> ARM64 codegen -> PE plug (mode 2) -> GPT disk -> QEMU",
     ScComment "",
     ScComment "Usage:",
     ScComment "  build/boot-arm64.ps1 -Src <source.codex>",
     ScComment "  build/boot-arm64.ps1 -Src <source.codex> -NoBoot   # build only, no QEMU",
     ScComment "",
     ScComment "Prerequisites:",
     ScComment "  - ARM64 plug built:  codex/plugs/arm64/build.ps1",
     ScComment "  - PE plug built:     codex/plugs/pe/build.ps1"]

Section: S01 -- Preamble

  s01 : List ShellCmd =
    let fail-arm = [ScRaw "throw \"ARM64 plug not built. Run: codex/plugs/arm64/build.ps1\""]
    in let fail-pe = [ScRaw "throw \"PE plug not built. Run: codex/plugs/pe/build.ps1\""]
    in [ScSetStrictMode, ScSetErrorStop, ScRaw "trap { Write-Host \"ERROR at line $($_.InvocationInfo.ScriptLineNumber): $_\"; throw $_ }", ScBlank, ScAssign "Repo" (SeRaw "(Resolve-Path (Join-Path $PSScriptRoot '..')).Path"), ScRunDot (SeRaw "(Join-Path $Repo 'build' 'vm-config.ps1')"), ScBlank, ScAssign "OutDir" (SeRaw "Join-Path $Repo 'build' 'arm64-output'"), ScMkdir (SeVar "OutDir"), ScBlank, ScAssign "Arm64PlugCdx" (SeRaw "Join-Path $Repo 'codex\\plugs\\arm64\\build-output\\arm64-plug.cdx'"), ScAssign "PePlugCdx" (SeRaw "Join-Path $Repo 'codex\\plugs\\pe\\build-output\\pe-plug.cdx'"), ScAssign "QemuBin" (SeLit "D:\\Program Files\\qemu\\qemu-system-aarch64.exe"), ScAssign "UefiFw" (SeLit "D:\\Program Files\\qemu\\share\\edk2-aarch64-code.fd"), ScBlank, ScIf (SeNot (SeFileExists (SeVar "Arm64PlugCdx"))) fail-arm [], ScIf (SeNot (SeFileExists (SeVar "PePlugCdx"))) fail-pe []]

Section: S02 -- Phase 1 Compile IR

  s02 : List ShellCmd =
    let fail-ir = [ScRaw "throw \"IR compile failed (exit $LASTEXITCODE); see $LogFile\""]
    in [ScComment "--- Phase 1: Compile source to IR ---", ScAssign "IrFile" (SeRaw "Join-Path $OutDir 'arm64.ir'"), ScAssign "LogFile" (SeRaw "Join-Path $OutDir 'compile-ir.log'"), ScEcho (SeText "[boot-arm64] Phase 1: Compiling $Src to IR..."), ScRaw "& pwsh -NoProfile -File (Join-Path $Repo 'build' 'compile.ps1') -Src $Src -Out $IrFile -Log $LogFile -IrCce -MemMB $MemMB", ScIf (SeNot (SeExitCodeEq 0)) fail-ir []]

Section: S03 -- Phase 2 ARM64 Codegen

  s03 : List ShellCmd =
    let fail-cg = [ScRaw "throw \"ARM64 codegen failed (exit $LASTEXITCODE)\""]
    in [ScComment "--- Phase 2: ARM64 codegen via plug ---", ScAssign "WireFile" (SeRaw "Join-Path $OutDir 'arm64.wire.bin'"), ScEcho (SeLit "[boot-arm64] Phase 2: ARM64 codegen..."), ScRaw "& pwsh -NoProfile -File (Join-Path $Repo 'codex\\plugs\\arm64\\run.ps1') -IrInput $IrFile -Out $WireFile", ScIf (SeNot (SeExitCodeEq 0)) fail-cg []]

Section: S04 -- Phase 3 PE Plug

  s04-wire-clean : List ShellCmd = [ScComment "Skip serial preamble (find wire header)", ScReadBytes "wireBytes" (SeVar "WireFile"), ScRaw "$wireOff = 0", ScRaw "for ($wi = 0; $wi -lt [Math]::Min(64, $wireBytes.Length - 12); $wi++) { $cl = [BitConverter]::ToInt32($wireBytes, $wi); $dl = [BitConverter]::ToInt32($wireBytes, $wi + 4); $fc = [BitConverter]::ToInt32($wireBytes, $wi + 8); if ($cl -gt 0 -and $cl -lt 1000000 -and $dl -ge 0 -and $dl -lt 100000 -and $fc -gt 0 -and $fc -lt 10000) { $wireOff = $wi; break } }", ScRaw "$cleanWire = New-Object byte[] ($wireBytes.Length - $wireOff)", ScRaw "[Array]::Copy($wireBytes, $wireOff, $cleanWire, 0, $cleanWire.Length)"]

  s04-payload : List ShellCmd = [ScComment "Build payload: [mode=2] [wire bytes]", ScRaw "$payload = New-Object byte[] (1 + $cleanWire.Length)", ScRaw "$payload[0] = 2", ScRaw "[Array]::Copy($cleanWire, 0, $payload, 1, $cleanWire.Length)"]

  s04-tcp-send : List ShellCmd = [ScComment "Start TCP listener", ScAssign "plugPort" (SeInt 9128), ScRaw "$listener = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Loopback, $plugPort)", ScRaw "$listener.Start()", ScTempFile "stderrFile", ScRaw "$proc = Start-Process -FilePath $script:CodexVmBin -ArgumentList @('-kernel', $PePlugCdx, '-mem', '3072', '-headless') -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile", ScRaw "$deadline = [DateTime]::UtcNow.AddSeconds(30)", ScRaw "while (-not $listener.Pending()) { if ([DateTime]::UtcNow -gt $deadline) { throw 'PE plug did not connect within 30s' }; Start-Sleep -Milliseconds 50 }", ScRaw "$tcpClient = $listener.AcceptTcpClient()", ScRaw "$tcpStream = $tcpClient.GetStream()", ScRaw "$listener.Stop()", ScEcho (SeText "[boot-arm64] PE plug connected, sending $($payload.Length) bytes...")]

  s04-tcp-xfer : List ShellCmd = [ScComment "Send framed message (tag=4)", ScRaw "$msgLen = $payload.Length + 1", ScRaw "$tcpStream.Write([BitConverter]::GetBytes([int]$msgLen), 0, 4)", ScRaw "$tcpStream.WriteByte(4)", ScRaw "$tcpStream.Write($payload, 0, $payload.Length)", ScRaw "$tcpStream.Flush()", ScRaw "$tcpStream.ReadTimeout = 60000", ScRaw "$allBytes = [System.Collections.Generic.List[byte]]::new(65536)", ScRaw "$readBuf = [byte[]]::new(8192)", ScRaw "try { while ($true) { $n = $tcpStream.Read($readBuf, 0, $readBuf.Length); if ($n -le 0) { break }; for ($bi = 0; $bi -lt $n; $bi++) { $allBytes.Add($readBuf[$bi]) } } } catch {}", ScIf (SeRaw "$allBytes.Count -lt 512") [ScRaw "throw \"PE output too small ($($allBytes.Count) bytes)\""] []]

  s04-pe-fix : List ShellCmd = [ScComment "Fix inflated PE headers from plug bug with large binaries", ScRaw "$peArr = $allBytes.ToArray()", ScRaw "$maxExpected = $cleanWire.Length * 4", ScIf (SeRaw "$allBytes.Count -gt $maxExpected") [ScEcho (SeText "[boot-arm64] PE inflated ($($allBytes.Count) > $maxExpected), fixing headers..."), ScRaw "$stubEnd = 512; for ($si = 512; $si -lt [Math]::Min($peArr.Length, 4096); $si += 4) { if ($peArr[$si] -eq $cleanWire[12] -and $peArr[$si+1] -eq $cleanWire[13] -and $peArr[$si+2] -eq $cleanWire[14] -and $peArr[$si+3] -eq $cleanWire[15]) { $stubEnd = $si; break } }", ScRaw "$stubSize = $stubEnd - 512; $codeLen = [BitConverter]::ToInt32($cleanWire, 0); $dataLen = [BitConverter]::ToInt32($cleanWire, 4); $totalCode = $stubSize + $codeLen + $dataLen", ScRaw "$codeRaw = (($totalCode + 511) -band (-bnot 511)); $codeSec = (($totalCode + 4095) -band (-bnot 4095)); $relocRva = 4096 + $codeSec; $imageSize = (($relocRva + 4096 + 4095) -band (-bnot 4095))", ScRaw "[BitConverter]::GetBytes([int]$codeRaw).CopyTo($peArr, 128 + 28); [BitConverter]::GetBytes([int]$imageSize).CopyTo($peArr, 128 + 80)", ScRaw "$secOff = 128 + 24 + 240; [BitConverter]::GetBytes([int]$totalCode).CopyTo($peArr, $secOff + 8); [BitConverter]::GetBytes([int]$codeRaw).CopyTo($peArr, $secOff + 16)", ScRaw "$sec2Off = $secOff + 40; [BitConverter]::GetBytes([int]$relocRva).CopyTo($peArr, $sec2Off + 12); [BitConverter]::GetBytes([int]($codeRaw + 512)).CopyTo($peArr, $sec2Off + 20)", ScRaw "[BitConverter]::GetBytes([int]$relocRva).CopyTo($peArr, 128 + 24 + 152)", ScRaw "$fixedSize = 512 + $codeRaw + 512; $fixedPe = New-Object byte[] $fixedSize; $copyLen = [Math]::Min(512 + $totalCode, $peArr.Length); [Array]::Copy($peArr, 0, $fixedPe, 0, $copyLen)", ScRaw "$fixedPe[$codeRaw + 512 + 4] = 8; $peArr = $fixedPe", ScEcho (SeText "[boot-arm64] Fixed: stub=$stubSize code=$codeLen data=$dataLen total=$totalCode pe=$fixedSize")] []]

  s04-pe-write : List ShellCmd = [ScAssign "PeFile" (SeRaw "Join-Path $OutDir 'BOOTAA64.EFI'"), ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "PeFile", SeVar "peArr"], ScEcho (SeText "[boot-arm64] PE: $PeFile ($($peArr.Length) bytes)"), ScRaw "$tcpClient.Close()"]

  s04-cleanup : List ShellCmd = [ScIf (SeAnd (SeVar "proc") (SeNot (SeProperty (SeVar "proc") "HasExited"))) [ScRaw "Stop-VmGraceful -ProcessId $proc.Id"] [], ScDelete (SeVar "stderrFile")]

  s04 : List ShellCmd = [ScEcho (SeLit "[boot-arm64] Phase 3: Building ARM64 PE via plug (mode 2)..."), ScSequence s04-wire-clean, ScSequence s04-payload, ScTry [ScSequence s04-tcp-send, ScSequence s04-tcp-xfer, ScSequence s04-pe-fix, ScSequence s04-pe-write] [] s04-cleanup]

Section: S05 -- Phase 4 GPT Disk Image

  s05 : List ShellCmd =
    let fail-img = [ScRaw "throw \"Disk image build failed (exit $LASTEXITCODE)\""]
    in [ScComment "--- Phase 4: Build GPT disk image ---", ScAssign "ImgFile" (SeRaw "Join-Path $OutDir 'codex-arm64.img'"), ScEcho (SeLit "[boot-arm64] Phase 4: Building GPT disk image..."), ScRaw "& pwsh -NoProfile -File (Join-Path $Repo 'build' 'build-arm64-img.ps1') -PeInput $PeFile -Out $ImgFile", ScIf (SeNot (SeExitCodeEq 0)) fail-img []]

Section: S06 -- NoBoot Exit

  s06 : List ShellCmd = [ScIf (SeVar "NoBoot") [ScEcho (SeText "[boot-arm64] Done (NoBoot). Image: $ImgFile"), ScExit (SeInt 0)] []]

Section: S07 -- Phase 5 QEMU Boot

  s07 : List ShellCmd = [ScComment "--- Phase 5: Boot in QEMU ---", ScEcho (SeLit "[boot-arm64] Phase 5: Booting in QEMU aarch64..."), ScIf (SeIntLt (SeVar "TimeoutSec") (SeInt 1)) [ScEcho (SeLit "[boot-arm64] UART output on serial console. Press Ctrl+C to stop.")] [], ScComment "Create varstore if it does not exist (64 MB, zeroed)", ScAssign "VarStore" (SeRaw "Join-Path $OutDir 'efi-varstore.img'"), ScIf (SeNot (SeFileExists (SeVar "VarStore"))) [ScRaw "$fs = [System.IO.File]::Create($VarStore); $fs.SetLength(64 * 1024 * 1024); $fs.Close()", ScEcho (SeText "[boot-arm64] Created EFI varstore: $VarStore")] [], ScBlank, ScComment "The hostfwd was a fixed 8080. Two agents booting arm64 on this box forwarded", ScComment "the same host port, so whichever guest bound it first answered the other", ScComment "agent's requests -- the same class as the fixed monitor port that", ScComment "build/boot/test-ovmf.ps1 derives per workspace for exactly this reason", ScComment "(L-SHARED). Derived here in 18080..18279 from the workspace name.", ScComment "", ScComment "A HELD port is a REFUSAL rather than a hop to the next free number. A run", ScComment "that quietly moves its port answers on an address the caller was never told,", ScComment "which is the same failure one step later.", ScRaw "$fwdPort = $HostPort", ScRaw "if ($fwdPort -eq 0) {", ScRaw "    $tag = (Split-Path $Repo -Leaf) -replace '[^A-Za-z0-9]',''", ScRaw "    $portHash = 0", ScRaw "    foreach ($ch in $tag.ToCharArray()) { $portHash = ($portHash * 31 + [int]$ch) % 200 }", ScRaw "    $fwdPort = 18080 + $portHash", ScRaw "    $held = @(Get-NetTCPConnection -LocalPort $fwdPort -State Listen -ErrorAction SilentlyContinue)", ScRaw "    if ($held.Count -gt 0) {", ScRaw "        throw \"hostfwd port $fwdPort (workspace '$tag') is already listening, PID $($held[0].OwningProcess). An arm64 boot from THIS workspace is still alive; refusing to start, because its guest would answer requests meant for this run.\"", ScRaw "    }", ScRaw "}", ScRaw "Write-Host \"[boot-arm64] hostfwd tcp::$fwdPort -> guest :80\"", ScComment "The firmware path contains a space, and Start-Process does not re-quote a", ScComment "space inside a single argument token, so a -drive whose file= sits under", ScComment "'Program Files' reaches QEMU split and it dies on 'Could not open D:\\Program'.", ScComment "The foreground `& $exe @args` call quotes per element and never met this; the", ScComment "-TimeoutSec path below uses Start-Process and does. Copy to a space-free", ScComment "path, which is what build/boot/test-ovmf.ps1 already does for the same reason.", ScRaw "$FwCopy = Join-Path $env:TEMP (\"arm64-code-\" + ((Split-Path $Repo -Leaf) -replace '[^A-Za-z0-9]','') + \".fd\")", ScRaw "if ((-not (Test-Path $FwCopy)) -or (Get-Item $FwCopy).Length -ne (Get-Item $UefiFw).Length) { Copy-Item -Force $UefiFw $FwCopy }", ScRaw "$qemuArgs = @('-machine', 'virt,gic-version=3', '-cpu', 'cortex-a72', '-m', '1024', '-drive', \"if=pflash,format=raw,file=$FwCopy,readonly=on\", '-drive', \"if=pflash,format=raw,file=$VarStore\", '-drive', \"file=$ImgFile,format=raw,if=virtio\", '-device', 'virtio-net-pci,netdev=net0,mac=52:54:00:12:34:56', '-netdev', \"user,id=net0,hostfwd=tcp::$fwdPort-:80\")", ScRaw "if ($TimeoutSec -le 0) {", ScRaw "    & $QemuBin @($qemuArgs + '-nographic')", ScRaw "} else {", ScRaw "    # A bounded run has to be READABLE or the bound buys nothing: -nographic", ScRaw "    # puts the UART on a stdout that Start-Process discards, so serial goes to", ScRaw "    # a file and the path is printed.", ScRaw "    $SerialLog = Join-Path $OutDir 'arm64-serial.log'", ScRaw "    Remove-Item $SerialLog -Force -ErrorAction SilentlyContinue", ScRaw "    $qproc = Start-Process -FilePath $QemuBin -ArgumentList @($qemuArgs + @('-display', 'none', '-serial', \"file:$SerialLog\")) -PassThru -WindowStyle Hidden", ScRaw "    Write-Host \"[boot-arm64] QEMU pid $($qproc.Id), deadline ${TimeoutSec}s, serial -> $SerialLog\"", ScRaw "    $qproc.WaitForExit($TimeoutSec * 1000)", ScRaw "    if ($qproc.HasExited) {", ScRaw "        Write-Host \"[boot-arm64] QEMU exited on its own, code $($qproc.ExitCode)\"", ScRaw "    } else {", ScRaw "        Stop-Process -Id $qproc.Id -Force -ErrorAction SilentlyContinue", ScRaw "        # An unfinished run is not a verdict, so the report says which this was.", ScRaw "        Write-Host \"[boot-arm64] TIMEOUT at ${TimeoutSec}s: QEMU was killed and the run did NOT finish. Treat the serial log as a partial.\"", ScRaw "    }", ScRaw "}"]

Section: Assembly

  boot-arm64-body : List ShellCmd = [ScSequence s00, ScBlank, ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07]

  boot-arm64-script : ShellScript = sh-script "boot-arm64" "End-to-end ARM64 UEFI boot pipeline" boot-arm64-params boot-arm64-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell boot-arm64-script)
  end

