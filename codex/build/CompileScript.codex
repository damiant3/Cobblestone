 We say:

Section: Parameters

  compile-params : List ShellParam = [sh-param "Src" SptString, sh-param "Out" SptString, sh-param "Log" SptString, sh-param-default "PCore" SptInt (SeInt 1), sh-param-default "MemMB" SptInt (SeInt 3072), sh-switch "MemNoCap", sh-param-default "TimeoutSec" SptInt (SeInt 600), sh-switch "IrUni", sh-switch "IrCce", sh-switch "Text", sh-switch "Measure", sh-switch "Prose", sh-switch "Repl", sh-switch "Poison", sh-switch "PoisonCompact", sh-switch "DebugMode", sh-switch "Profile", sh-switch "Trace", sh-switch "EscapeCheck", sh-switch "Uefi", sh-switch "Pet", sh-param-optional "Break" SptString, sh-attrs ["ValidateRange(0, 10000)"] (sh-param-default "Decks" SptInt (SeInt 0)),sh-param-default "RawFlags" SptString (SeLit ""), sh-param-default "Passes" SptString (SeLit ""), sh-param-default "Survey" SptString (SeLit ""), sh-param-default "Kernel" SptString (SeLit ""), sh-param-default "DiskFile" SptString (SeLit ""), sh-param-default "Peer" SptString (SeLit ""), sh-param-default "Registry" SptString (SeLit "")]

Section: S01 -- Preamble

  s01-kernel : List ShellCmd =
    let given = [set "Stage0" (var "Kernel"), need-file (var "Stage0") 2 (msg "MISSING: $Stage0 - the -Kernel you asked for is not there")]
    in let defaulted = [set "Stage0" (SeRaw "Join-Path 'build-output' 'bare-metal' 'Codex.cdx'"), need-file (var "Stage0") 2 (msg "MISSING: $Stage0 - run build.ps1 first, or pass -Kernel seed\\Codex.cdx")]
    in [if-set "Kernel" given defaulted]

  s01-drift : List ShellCmd =
    let differs = [sh-error (msg "NOTE: this kernel is NOT seed\\Codex.cdx [$seedHash]. It is whatever build.ps1 last left in build-output. Pass -Kernel to choose.")]
    in let check = [set "seedHash" (SeRaw "(Get-FileHash -Algorithm SHA256 $seedPath).Hash.Substring(0, 16)"), ScIf (SeStringNeq (var "seedHash") (var "kernelHash")) differs []]
    in [ScIf (SeNot (var "Kernel")) [set "seedPath" (SeRaw "Join-Path (Split-Path $PSScriptRoot) 'seed' 'Codex.cdx'"), ScIf (SeFileExists (var "seedPath")) check []] []]

  s01-body : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, sh-dot (join-path [SeScriptRoot, sh-lit "vm-config.ps1"]), sh-dot (join-path [SeScriptRoot, sh-lit "work-wire.ps1"]), ScBlank, ScSequence s01-kernel, set "kernelHash" (SeRaw "(Get-FileHash -Algorithm SHA256 $Stage0).Hash.Substring(0, 16)"), sh-error (msg "kernel: $Stage0 [$kernelHash]"), ScBlank, ScSequence s01-drift]

Section: S02 -- Break

  s02-inner : List ShellCmd =
    let found = [ScDotNetCallAssign "Stage0Copy" "System.IO.Path" "GetTempFileName" [], ScDotNetCall "System.IO.File" "Copy" [var "Stage0", var "Stage0Copy", SeRaw "$true"], ScSetWritable (var "Stage0Copy"), ScReadBytes "cdxBytes" (var "Stage0Copy"), set "origByte" (SeIndex (var "cdxBytes") (var "breakAddr")), ScRaw "$cdxBytes[$breakAddr] = 0xCC", ScDotNetCall "System.IO.File" "WriteAllBytes" [var "Stage0Copy", var "cdxBytes"], set "Stage0" (var "Stage0Copy"), sh-error (msg "BREAK: patched INT3 at $Break (0x$(($breakAddr - 224 + 0x100000).ToString('X')), orig=0x$($origByte.ToString('X2')))")]
    in let not-found = [sh-error (msg "BREAK: function '$Break' not found in map")]
    in [set "symAddr" (SeCallArgs "Resolve-Name" [SaNamed "Name" (var "Break"), SaNamed "Kernel" (var "Stage0")]), set "breakAddr" (SeIfElse (SeIntGt (var "symAddr") (SeInt 0)) (SeRaw "$symAddr - 0x100000 + 224") (SeInt (-1))), ScIf (SeIntGe (var "breakAddr") (SeInt 224)) found not-found]

  s02-body : List ShellCmd = [ScBlank, if-set "Break" s02-inner [], ScBlank, ScBlank, set "inputFile" (SeRaw "$null"), set "outputFile" (SeRaw "$null"), set "stderrFile" (SeRaw "$null"), ScBlank, sh-dot (join-path [SeScriptRoot, sh-lit "quire-map.ps1"])]

Section: S03 -- Resolve

  s03-body : List ShellCmd =
    let warn = [sh-error (msg "WARNING: compile.ps1 resolved $($unbundled.Count) chapter(s) not in bundled source:"), ScForEach "extra" (var "unbundled") [sh-error (msg "  $($extra.Quire)::$($extra.Name) ($($extra.Path))")], ScWriteError (SeLit "These chapters are cited by bundled code but missing from the app build script."), ScWriteError (SeLit "Add them to the build script's chapter list, or remove the cites.")]
    in [set "seedSeen" SeHashLiteral, set "embeddedPat" (SeLit "^Chapter:\\s*(\\w+)--(.+?)\\s*$"), ScDotNetCallAssign "srcLines" "System.IO.File" "ReadAllLines" [var "Src"], ScForEach "line" (var "srcLines") [ScIf (SeMatchExpr (var "line") (var "embeddedPat")) [ScRaw "$seedSeen[\"$($matches[1])::$($matches[2])\"] = $true"] []], ScTry [set "ordered" (SeRaw "Resolve-CiteOrder -RootLines $srcLines -Repo (Split-Path $PSScriptRoot) -SeedSeen $seedSeen")] [ScSetContent (var "Log") (SeRaw "\"error 3010: $($_.Exception.Message)\""), ScExit (SeInt 8)] [], set "implicitNames" (SeArrayLiteral [SeLit "ListUtils", SeLit "Tuple"]), ScRaw "$unbundled = @($ordered | Where-Object { -not ($_.Quire -eq 'Foreword' -and $implicitNames -contains $_.Name) })", ScIf (SeAnd (SeRaw "$unbundled.Count -gt 0") (SeRaw "$seedSeen.Count -gt 0")) warn []]

Section: S04 -- Mode

 The store flag and the -disk argument are two halves of one thing: the flag
 tells the compiler a fact-store disk is present, the argument gives codex-vm
 the image. Neither alone works.

  s04-disk : List ShellCmd = [need-file (var "DiskFile") 2 (msg "MISSING: -DiskFile $DiskFile is not there"), set "baseMode" (SeRaw "\"$baseMode store\"")]

  s04-body : List ShellCmd = [ScBlank, ScRaw "$baseMode = if ($Measure) { \"MEASURE\" } elseif ($Text) { \"TEXT\" } elseif ($IrUni) { \"IR-UNI\" } elseif ($IrCce) { \"IR-CCE\" } else { \"CDX\" }", if-set "Prose" [set "baseMode" (SeRaw "\"$baseMode prose\"")] [], if-set "Repl" [set "baseMode" (SeRaw "\"$baseMode repl\"")] [], ScIf (SeStartsWith (var "baseMode") (SeLit "CDX")) [set "baseMode" (SeRaw "\"$baseMode map\"")] [], if-set "Poison" [set "baseMode" (SeRaw "\"$baseMode poison\"")] [], if-set "PoisonCompact" [set "baseMode" (SeRaw "\"$baseMode poison-compact\"")] [], if-set "DebugMode" [set "baseMode" (SeRaw "\"$baseMode debug\"")] [], if-set "Profile" [set "baseMode" (SeRaw "\"$baseMode profile\"")] [], ScIf (SeRaw "$Decks -ne 0") [set "baseMode" (SeRaw "\"$baseMode decks=$Decks\"")] [], if-set "Passes" [set "baseMode" (SeRaw "\"$baseMode passes=$Passes\"")] [], if-set "RawFlags" [set "baseMode" (SeRaw "\"$baseMode $RawFlags\"")] [], if-set "Trace" [set "baseMode" (SeRaw "\"$baseMode trace\"")] [], if-set "EscapeCheck" [set "baseMode" (SeRaw "\"$baseMode escape-check\"")] [], if-set "Uefi" [set "baseMode" (SeRaw "\"$baseMode uefi\"")] [], if-set "Pet" [set "baseMode" (SeRaw "\"$baseMode pet\"")] [], if-set "DiskFile" s04-disk []]

  s04-peer-body : List ShellCmd = [ScBlank, if-set "Peer" [set "srcLines" (SeCallArgs "Add-PeerWorks" [SaNamed "Lines" (var "srcLines"), SaNamed "Peer" (var "Peer")])] [if-set "Registry" [set "srcLines" (SeCallArgs "Add-PeerWorks" [SaNamed "Lines" (var "srcLines"), SaNamed "Registry" (var "Registry")])] []]]

Section: S05 -- Input

  s05-body : List ShellCmd = [ScBlank, ScRaw "$script:DiagRegions = Get-DiagRegions -Ordered $ordered -SrcPath $Src", ScComment "Streamed, not built. The StringBuilder held the whole unit, ToString copied it, the mode-line interpolation copied it a third time and WriteAllText encoded a fourth, all while srcLines stayed live. Same defect as the batch driver at 21043 and concat-codex-self at 21098, one copy worse. Same bytes: the mode line, a newline, every cite line with a newline, every source line with a newline, then the EOT.", ScTempFile "inputFile", ScRaw "$bodyWriter = [System.IO.StreamWriter]::new($inputFile, $false, [System.Text.UTF8Encoding]::new($false))", ScRaw "$bodyWriter.Write($baseMode)", ScRaw "$bodyWriter.Write(\"`n\")", ScForEach "l" (SeCallArgs "Format-CiteChapters" [SaNamed "Ordered" (var "ordered")]) [ScRaw "$bodyWriter.Write($l)", ScRaw "$bodyWriter.Write(\"`n\")"], ScForEach "line" (var "srcLines") [ScRaw "$bodyWriter.Write($line)", ScRaw "$bodyWriter.Write(\"`n\")"], ScRaw "$bodyWriter.Write([char]4)", ScRaw "$bodyWriter.Dispose()", ScTempFile "outputFile", ScTempFile "stderrFile", ScBlank, ScBlank, set "vmBin" (SeRaw "Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'"), set "curMem" (var "MemMB"), set "attempt" (SeInt 0), set "maxAttempts" (SeInt 2)]

Section: S06 -- VM Launch

  s06-body : List ShellCmd =
    let timeout = [ScRaw "Stop-VmGraceful -ProcessId $proc.Id", ScSetContent (var "Log") (SeLit "FAIL: VM timed out"), ScExit (SeInt 3)]
    in let retry = [sh-error (msg "  compile: no output with ${curMem}MB, retrying with 3072MB"), set "curMem" (SeInt 3072), ScContinueLabel "compile_loop"]
    in let no-out = [ScSetContent (var "Log") (SeLit "FAIL: no output"), ScIf (SeFileExists (var "stderrFile")) [ScAddContent (var "Log") (SeRaw "(Get-Content $stderrFile -Raw)")] [], ScExit (SeInt 4)]
    in let codex-vm-arm = [set "vmArgs" (SeArrayLiteral [SeLit "-kernel", var "Stage0", SeLit "-input", var "inputFile", SeLit "-output", var "outputFile", SeLit "-mem", SeRaw "\"$curMem\"", SeLit "-headless"]), if-set "MemNoCap" [ScAppend "vmArgs" (SeLit "-mem-nocap")] [], if-set "DiskFile" [ScAppend "vmArgs" (SeArrayLiteral [SeLit "-disk", var "DiskFile"])] [], ScRaw "$proc = Start-Process -FilePath $vmBin -ArgumentList $vmArgs -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile", ScRaw "$proc.WaitForExit($TimeoutSec * 1000)", ScIf (SeNot (SeProperty (var "proc") "HasExited")) timeout []]
    in let fail-qemu = [ScSetContent (var "Log") (SeLit "FAIL: VM timed out"), ScExit (SeInt 3)]
    in let qemu-arm = [ScRaw "# No codex-vm on this host: the QEMU fallback serves the same", ScRaw "# -input/-output contract over the serial wire, and the parsing", ScRaw "# below cannot tell the difference. (-MemNoCap needs no translation:", ScRaw "# the 3040 MB cap is codex-vm's, and the 0xFE8 cell the QEMU path", ScRaw "# seeds already carries the real -m value.)", ScRaw "$ok = Invoke-VmCompileFallback -Kernel $Stage0 -InputFile $inputFile -OutputFile $outputFile -MemMB $curMem -TimeoutSec $TimeoutSec -DiskFile $DiskFile", ScIf (SeNot (var "ok")) fail-qemu []]
    in [ScRaw "$attempt++", ScIf (SeFileExists (var "outputFile")) [ScDotNetCall "System.IO.File" "WriteAllBytes" [var "outputFile", SeRaw "[byte[]]::new(0)"]] [], ScIf (SeRaw "$script:UseCodexVm") codex-vm-arm qemu-arm, ScIf (SeOr (SeNot (SeFileExists (var "outputFile"))) (SeRaw "(Get-Item $outputFile).Length -eq 0")) [ScIf (SeAnd (SeRaw "$attempt -lt $maxAttempts") (SeIntLt (var "curMem") (SeInt 3072))) retry no-out] []]

Section: S07 -- Parse

  s07-halted : List ShellCmd = [ScDotNetCallAssign "errLines" "System.Collections.Generic.List[string]" "new" [], ScRaw "[void]$errLines.Add($line)", ScRaw "for ($k = $i + 1; $k -lt $outLines.Count; $k++) { $el = $outLines[$k].TrimEnd(\"`r\"); if ($el -and -not $el.StartsWith('WD:') -and -not $el.StartsWith('HEAP:') -and -not $el.StartsWith('STACK:')) { [void]$errLines.Add($el) } }", ScForEach "el" (var "errLines") [ScAddContent (var "Log") (SeCall "Remap-Diag" [var "el"])], ScExit (SeInt 4)]

  s07-exc : List ShellCmd =
    let retry = [set "prevMem" (var "curMem"), set "curMem" (SeInt 8192), sh-error (msg "  compile: crash with ${prevMem}MB, retrying with ${curMem}MB"), set "hitExc" (SeRaw "$true"), ScBreak]
    in [ScAddContent (var "Log") (var "line"), set "report" (SeCallArgs "Format-CrashReport" [SaNamed "ExcLines" (SeAsArray (var "line")), SaNamed "Kernel" (var "Stage0")]), ScForEach "r" (var "report") [ScAddContent (var "Log") (var "r"), sh-error (msg "  $r")], ScIf (SeAnd (SeRaw "$attempt -lt $maxAttempts") (SeIntLt (var "curMem") (SeInt 8192))) retry [ScExit (SeInt 4)]]

  s07-body : List ShellCmd = [ScBlank, ScReadBytes "outBytes" (var "outputFile"), set "outText" (SeStaticCall "System.Text.Encoding" "UTF8.GetString" [var "outBytes"]), ScRaw "$outLines = $outText -split \"`n\"", ScFunction "Remap-Diag" [sh-param "l" SptString] [ScReturn (SeCallArgs "Convert-DiagLine" [SaNamed "Line" (var "l"), SaNamed "Regions" (SeRaw "$script:DiagRegions")])], ScSetContent (var "Log") (SeLit ""), ScRaw "$binSize = 0; $binStart = -1; $hitExc = $false", ScForLoop "i" (SeInt 0) (SeRaw "$i -lt $outLines.Count") (SeRaw "$i++") [set "line" (SeMethodCall (SeIndex (var "outLines") (var "i")) "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeStartsWith (var "line") (SeLit "SIZE:")) [ScIf (SeMatch (SeMethodCall (var "line") "Substring" [SeInt 5]) "^\\d+") [set "binSize" (SeRaw "[int]$matches[0]")] [], set "binStart" (SeRaw "$i + 1"), ScBreak] [], ScIf (SeOr (SeStartsWith (var "line") (SeLit "CODEGEN-HALTED")) (SeStartsWith (var "line") (SeLit "CODEGEN-ERRORS"))) s07-halted [], ScIf (SeStartsWith (var "line") (SeLit "!EXC")) s07-exc [], ScIf (SeAnd (var "line") (SeNot (SeStartsWith (var "line") (SeLit "WD:")))) [ScAddContent (var "Log") (SeCall "Remap-Diag" [var "line"])] []]]

Section: S08 -- Binary Extract

 emit-ir-cce and emit-text both take __heap-save either side of the emit and
 print the marks after the payload, where the payload-end scan uses the line's
 prefix as a terminator and nothing then reads it. Log them: the frontier
 across the emit has been measured and transmitted all along and thrown away
 on arrival, which is why a question about what the IR emitter costs had no
 instrument.

  s08-marks : List ShellCmd = [ScForEach "tl" (var "tailLines") [set "t" (SeMethodCall (var "tl") "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeOr (SeOr (SeStartsWith (var "t") (SeLit "WD:")) (SeStartsWith (var "t") (SeLit "HEAP:"))) (SeStartsWith (var "t") (SeLit "STACK:"))) [ScAddContent (var "Log") (var "t")] []]]

  s08-tail : List ShellCmd = [set "tailText" (SeStaticCall "System.Text.Encoding" "UTF8.GetString" [var "outBytes", var "tailStart", SeRaw "$outBytes.Length - $tailStart"]), ScRaw "$tailLines = $tailText -split \"`n\"", ScSequence s08-marks, ScDotNetCallAssign "mapFile" "System.IO.Path" "ChangeExtension" [var "Out", SeLit ".map"], set "inMap" (SeRaw "$false"), ScDotNetCallAssign "mapLines" "System.Collections.Generic.List[string]" "new" [], ScRaw "[void]$mapLines.Add('# Codex Symbol Map'); [void]$mapLines.Add('# Address         Size  Name')", ScDotNetCallAssign "profFile" "System.IO.Path" "ChangeExtension" [var "Out", SeLit ".prof"], ScRaw "$inProf = $false; $profCount = 0", ScDotNetCallAssign "profLines" "System.Collections.Generic.List[string]" "new" [], ScForEach "tl" (var "tailLines") [set "tl" (SeMethodCall (var "tl") "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeStartsWith (var "tl") (SeLit "MAP:")) [set "inMap" (SeRaw "$true"), ScContinue] [], ScIf (SeStartsWith (var "tl") (SeLit "MAP-END")) [set "inMap" (SeRaw "$false"), ScContinue] [], ScIf (SeAnd (var "inMap") (SeStartsWith (var "tl") (SeLit "0x"))) [ScRaw "[void]$mapLines.Add($tl)"] [], ScIf (SeStartsWith (var "tl") (SeLit "PROF:")) [ScIf (SeNot (var "inProf")) [set "inProf" (SeRaw "$true"), ScIf (SeMatch (SeMethodCall (var "tl") "Substring" [SeInt 5]) "^\\d+") [set "profCount" (SeRaw "[int]$matches[0]")] []] [ScRaw "[void]$profLines.Add($tl.Substring(5))"]] []], ScIf (SeRaw "$mapLines.Count -gt 2") [ScDotNetCall "System.IO.File" "WriteAllLines" [var "mapFile", var "mapLines", SeRaw "[System.Text.UTF8Encoding]::new($false)"]] [], ScIf (SeRaw "$profLines.Count -gt 0") [ScDotNetCall "System.IO.File" "WriteAllLines" [var "profFile", var "profLines", SeRaw "[System.Text.UTF8Encoding]::new($false)"], sh-error (msg "  profile: $($profLines.Count) samples -> $profFile")] []]

  s08-body : List ShellCmd =
    let write-bin = [ScRaw "$binBytes = New-Object byte[] $actSize", ScRaw "[Array]::Copy($outBytes, $sizeLineEnd, $binBytes, 0, $actSize)", ScDotNetCall "System.IO.File" "WriteAllBytes" [var "Out", var "binBytes"], set "tailStart" (var "binEnd"), ScIf (SeIntLt (var "tailStart") (SeProperty (var "outBytes") "Length")) s08-tail [], ScExit (SeInt 0)]
    in let size-fail = [ScRaw "Add-Content -Path $Log -Value \"Binary size mismatch: the SIZE: line declared $binSize byte(s), the stream carried $actSize after it, out of $($outBytes.Length) total\" -Encoding UTF8", ScExit (SeInt 5)]
    in let scan = [ScRaw "for ($j = $sizeLineEnd; $j -lt $outBytes.Length; $j++) { if ($outBytes[$j] -eq 10) { $afterNl = $j + 1; if ($afterNl + 3 -le $outBytes.Length) { $tag = [System.Text.Encoding]::ASCII.GetString($outBytes, $afterNl, [Math]::Min(5, $outBytes.Length - $afterNl)); if ($tag.StartsWith('WD:') -or $tag.StartsWith('HEAP:') -or $tag.StartsWith('STACK:')) { $binEnd = $j + 1; break } } } }"]
    in [ScBlank, ScIf (SeRaw "$binStart -ge 0") [ScRaw "$sizeLineEnd = 0; $nlCount = 0", ScForLoop "j" (SeInt 0) (SeRaw "$j -lt $outBytes.Length") (SeRaw "$j++") [ScIf (SeRaw "$outBytes[$j] -eq 10") [ScRaw "$nlCount++; if ($nlCount -eq $binStart) { $sizeLineEnd = $j + 1; break }"] []], set "binEnd" (SeProperty (var "outBytes") "Length"), ScIf (SeAnd (SeRaw "$binSize -gt 0") (SeRaw "($sizeLineEnd + $binSize) -le $outBytes.Length")) [set "binEnd" (SeRaw "$sizeLineEnd + $binSize")] scan, set "actSize" (SeRaw "$binEnd - $sizeLineEnd"), ScRaw "            # A DROP MEANS THE CAPTURE IS NOT WHAT THE GUEST PRODUCED, so the", ScRaw "            # bytes after the SIZE: line are not the program's binary and must", ScRaw "            # not be written. codex-vm reports a loss on stderr in the canonical", ScRaw "            # wording that test-run.ps1 and test-compile-batch.ps1 already key", ScRaw "            # on, and this script read that file in its two FAILURE branches", ScRaw "            # only (no output; output but no SIZE: line) and deleted it in the", ScRaw "            # finally. So on the path that SUCCEEDS the report went to a temp", ScRaw "            # file nobody opened, and a lost byte shipped a SHORT .cdx at exit 0", ScRaw "            # with no diagnostic anywhere -- a correct detector firing into a", ScRaw "            # closed channel (L-UNHEARD). Measured 2026-09-07 with", ScRaw "            # CODEX_VM_FAIL_GROW_AT: 3,995 bytes written where the control wrote", ScRaw "            # 93,248, exit 0, silent. Refusing here is L-UNHEARD's own repair:", ScRaw "            # route the signal into a state something already acts on.", ScRaw "            if ((Test-Path -PathType Leaf $stderrFile)) {", ScRaw "                $dropLines = @(Get-Content $stderrFile -ErrorAction SilentlyContinue |", ScRaw "                               Where-Object { $_ -match ' guest serial byte\\(s\\) DROPPED' })", ScRaw "                if ($dropLines.Count -gt 0) {", ScRaw "                    Add-Content -Path $Log -Value 'FAIL: codex-vm dropped guest serial bytes, so the capture is SHORT and what follows the SIZE: line is not the whole binary.' -Encoding UTF8", ScRaw "                    foreach ($dl in $dropLines) { Add-Content -Path $Log -Value \"  $dl\" -Encoding UTF8 }", ScRaw "                    exit 6", ScRaw "                }", ScRaw "            }", ScIf (SeRaw "$actSize -gt 0") write-bin size-fail] [], if-set "hitExc" [ScContinueLabel "compile_loop"] [], ScRaw "# Output, but nothing that ends the scan: no SIZE:, no CODEGEN-*, no\n        # !EXC. The log above holds only what survived the WD: filter, so when\n        # the VM died early it reads exactly like a SUCCESSFUL compile and the\n        # exit code is the only thing that disagrees. Both things that would\n        # answer it were being discarded: codex-vm's stderr, which carries\n        # `Output: N bytes` and any `SERIAL: ... DROPPED`, and the raw output.\n        Add-Content -Path $Log -Value 'FAIL: the VM produced output but no SIZE: line, no CODEGEN-HALTED or CODEGEN-ERRORS, and no !EXC, so there is neither a binary nor a diagnostic to report.' -Encoding UTF8\n        Add-Content -Path $Log -Value \"  output: $($outBytes.Length) byte(s) in $($outLines.Count) line(s)\" -Encoding UTF8\n        if ((Test-Path -PathType Leaf $stderrFile)) {\n            # The TAIL: the lines that answer this are the last ones. Bounded\n            # because a repeated device failure prints per occurrence, which\n            # put 29,610 bytes through here in one measured run.\n            $errLinesAll = @(Get-Content $stderrFile -ErrorAction SilentlyContinue)\n            if ($errLinesAll.Count -gt 0) {\n                $errFrom = [Math]::Max(0, $errLinesAll.Count - 40)\n                $hdr = if ($errFrom -gt 0) { \"  codex-vm stderr, last 40 of $($errLinesAll.Count) line(s):\" } else { \"  codex-vm stderr:\" }\n                Add-Content -Path $Log -Value $hdr -Encoding UTF8\n                for ($i = $errFrom; $i -lt $errLinesAll.Count; $i++) {\n                    Add-Content -Path $Log -Value \"    $($errLinesAll[$i])\" -Encoding UTF8\n                }\n            }\n        }\n        $keepFrom = [Math]::Max(0, $outLines.Count - 40)\n        Add-Content -Path $Log -Value \"  last $($outLines.Count - $keepFrom) output line(s), WD:/HEAP:/STACK: included:\" -Encoding UTF8\n        for ($i = $keepFrom; $i -lt $outLines.Count; $i++) {\n            $ol = $outLines[$i].TrimEnd(\"`r\")\n            if ($ol.Length -gt 200) { $ol = $ol.Substring(0, 200) + ' ...(truncated)' }\n            Add-Content -Path $Log -Value \"    $ol\" -Encoding UTF8\n        }", ScExit (SeInt 4)]

Section: S09 -- Cleanup

  s09-body : List ShellCmd = [if-set "inputFile" [ScDelete (var "inputFile")] [], if-set "outputFile" [ScDelete (var "outputFile")] [], if-set "stderrFile" [ScDelete (var "stderrFile")] []]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "strict mode, the repository root and the compile paths", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "the break option, the cleanup names and the quire map", ps-why = "the handler deletes inputFile, outputFile and stderrFile, and under StrictMode an unset name throws, so the three are assigned before anything that can fail; quire-map.ps1 is dot-sourced here because the resolver it defines is read by the stages inside the group", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "resolve the source and its cites", ps-why = "assembles the unit to be compiled, following the cite closure through the quire map", ps-in = ["Src"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 8 "the cite order could not be resolved, which is diagnostic 3010 written to the log; nothing was compiled"], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "the compile mode", ps-why = "picks the pass pipeline from the flags, which is what decides whether the output is CDX, text or IR", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s04-peer : PipeStage = PipeStage { ps-name = "the peer source", ps-why = "a second source compiled beside the first, for the differential arms", ps-in = ["Peer"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-peer-body }

  s05 : PipeStage = PipeStage { ps-name = "the diagnostic regions and the retry names", ps-why = "reads the xdiag regions, then names the guest binary and the memory, attempt and attempt-cap the retry loop below reads; those four are set ONCE and must not be reset per attempt", ps-in = ["MemMB"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "run the compiler in a guest", ps-why = "boots the kernel on the assembled unit; the attempt counter and the truncation of a stale output are the first statements of the attempt, which is why they sit at this stage's head rather than in the group", ps-in = [], ps-out = [], ps-needs = [PrGuests 1, PrDriven RkMemoryMb (SeVar "curMem"), PrKernel (SeVar "Kernel")], ps-verdict = [PoExit 3 "the guest did not finish within its wait, on codex-vm or on the QEMU fallback", PoExit 4 "the guest ran and produced no output, and the attempt is retried with more memory only while an attempt remains"], ps-body = s06-body }

  s07 : PipeStage = PipeStage { ps-name = "parse the guest's output", ps-why = "reads the SIZE line and the diagnostics, and decides whether this attempt asks for another with more memory", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 4 "the guest halted, or raised an exception the parse recognised, and its output is in the log"], ps-body = s07-body }

  s08 : PipeStage = PipeStage { ps-name = "extract the binary", ps-why = "writes the bytes after the SIZE line as the output, which is the artifact the caller asked for", ps-in = ["Out"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 5 "the SIZE line disagrees with the bytes that followed it, so the binary is not written", PoExit 4 "no usable binary was produced, and the guest output is logged truncated to two hundred characters a line", PoExit 0 "the bytes after the SIZE line were written as the requested output"], ps-body = s08-body }

  s09 : PipeStage = PipeStage { ps-name = "cleanup", ps-why = "removes the assembled input, the stale output and the stderr capture HOWEVER the stages inside the group ended, which is why it is the group's handler", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s09-body }

  compile-pipe : Pipeline = Pipeline { pl-name = "compile", pl-doc = "Compile a single .codex source file to CDX, TEXT, or IR", pl-params = compile-params, pl-stages = [PsStage s01, PsStage s02, PsGroup None None (Just s09) [PsStage s03, PsStage s04, PsStage s04-peer, PsStage s05, PsGroup (Just (PrWhileLabeled "compile_loop" (SeIntLt (var "attempt") (var "maxAttempts")))) None None [PsStage s06, PsStage s07, PsStage s08]]] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell compile-pipe))
  end

