  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  compile-params : List ShellParam = [sh-param "Src" SptString, sh-param "Out" SptString, sh-param "Log" SptString, sh-param-default "PCore" SptInt (SeInt 1), sh-param-default "MemMB" SptInt (SeInt 3072), sh-switch "MemNoCap", sh-param-default "TimeoutSec" SptInt (SeInt 600), sh-switch "IrUni", sh-switch "IrCce", sh-switch "Text", sh-switch "Measure", sh-switch "Prose", sh-switch "Repl", sh-switch "Poison", sh-switch "PoisonCompact", sh-switch "DebugMode", sh-switch "Profile", sh-switch "Trace", sh-switch "EscapeCheck", sh-switch "Uefi", sh-switch "Pet", sh-param-optional "Break" SptString, sh-attrs ["ValidateRange(0, 10000)"] (sh-param-default "Decks" SptInt (SeInt 0)),sh-param-default "RawFlags" SptString (SeLit ""), sh-param-default "Passes" SptString (SeLit ""), sh-param-default "Survey" SptString (SeLit ""), sh-param-default "Kernel" SptString (SeLit ""), sh-param-default "DiskFile" SptString (SeLit ""), sh-param-default "Peer" SptString (SeLit ""), sh-param-default "Registry" SptString (SeLit "")]

Section: S01 -- Preamble

  s01-kernel : List ShellCmd =
    let given = [ScAssign "Stage0" (SeVar "Kernel"), ScIf (SeNot (SeFileExists (SeVar "Stage0"))) [ScWriteError (SeRaw "\"MISSING: $Stage0 - the -Kernel you asked for is not there\""), ScExit (SeInt 2)] []]
    in let defaulted = [ScAssign "Stage0" (SeRaw "Join-Path 'build-output' 'bare-metal' 'Codex.cdx'"), ScIf (SeNot (SeFileExists (SeVar "Stage0"))) [ScWriteError (SeRaw "\"MISSING: $Stage0 - run build.ps1 first, or pass -Kernel seed\\Codex.cdx\""), ScExit (SeInt 2)] []]
    in [ScIf (SeVar "Kernel") given defaulted]

  s01-drift : List ShellCmd =
    let differs = [ScWriteError (SeRaw "\"NOTE: this kernel is NOT seed\\Codex.cdx [$seedHash]. It is whatever build.ps1 last left in build-output. Pass -Kernel to choose.\"")]
    in let check = [ScAssign "seedHash" (SeRaw "(Get-FileHash -Algorithm SHA256 $seedPath).Hash.Substring(0, 16)"), ScIf (SeStringNeq (SeVar "seedHash") (SeVar "kernelHash")) differs []]
    in [ScIf (SeNot (SeVar "Kernel")) [ScAssign "seedPath" (SeRaw "Join-Path (Split-Path $PSScriptRoot) 'seed' 'Codex.cdx'"), ScIf (SeFileExists (SeVar "seedPath")) check []] []]

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')"), ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'work-wire.ps1')"), ScBlank, ScSequence s01-kernel, ScAssign "kernelHash" (SeRaw "(Get-FileHash -Algorithm SHA256 $Stage0).Hash.Substring(0, 16)"), ScWriteError (SeRaw "\"kernel: $Stage0 [$kernelHash]\""), ScBlank, ScSequence s01-drift]

Section: S02 -- Break

  s02-inner : List ShellCmd =
    let found = [ScDotNetCallAssign "Stage0Copy" "System.IO.Path" "GetTempFileName" [], ScDotNetCall "System.IO.File" "Copy" [SeVar "Stage0", SeVar "Stage0Copy", SeRaw "$true"], ScSetWritable (SeVar "Stage0Copy"), ScReadBytes "cdxBytes" (SeVar "Stage0Copy"), ScAssign "origByte" (SeIndex (SeVar "cdxBytes") (SeVar "breakAddr")), ScRaw "$cdxBytes[$breakAddr] = 0xCC", ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "Stage0Copy", SeVar "cdxBytes"], ScAssign "Stage0" (SeVar "Stage0Copy"), ScWriteError (SeRaw "\"BREAK: patched INT3 at $Break (0x$(($breakAddr - 224 + 0x100000).ToString('X')), orig=0x$($origByte.ToString('X2')))\"")]
    in let not-found = [ScWriteError (SeRaw "\"BREAK: function '$Break' not found in map\"")]
    in [ScAssign "symAddr" (SeCallArgs "Resolve-Name" [SaNamed "Name" (SeVar "Break"), SaNamed "Kernel" (SeVar "Stage0")]), ScAssign "breakAddr" (SeIfElse (SeIntGt (SeVar "symAddr") (SeInt 0)) (SeRaw "$symAddr - 0x100000 + 224") (SeInt (-1))), ScIf (SeIntGe (SeVar "breakAddr") (SeInt 224)) found not-found]

  s02 : List ShellCmd = [ScIf (SeVar "Break") s02-inner []]

Section: S03 -- Resolve

  s03 : List ShellCmd =
    let warn = [ScWriteError (SeRaw "\"WARNING: compile.ps1 resolved $($unbundled.Count) chapter(s) not in bundled source:\""), ScForEach "extra" (SeVar "unbundled") [ScWriteError (SeRaw "\"  $($extra.Quire)::$($extra.Name) ($($extra.Path))\"")], ScWriteError (SeLit "These chapters are cited by bundled code but missing from the app build script."), ScWriteError (SeLit "Add them to the build script's chapter list, or remove the cites.")]
    in [ScAssign "seedSeen" SeHashLiteral, ScAssign "embeddedPat" (SeLit "^Chapter:\\s*(\\w+)--(.+?)\\s*$"), ScDotNetCallAssign "srcLines" "System.IO.File" "ReadAllLines" [SeVar "Src"], ScForEach "line" (SeVar "srcLines") [ScIf (SeMatchExpr (SeVar "line") (SeVar "embeddedPat")) [ScRaw "$seedSeen[\"$($matches[1])::$($matches[2])\"] = $true"] []], ScTry [ScAssign "ordered" (SeRaw "Resolve-CiteOrder -RootLines $srcLines -Repo '.' -SeedSeen $seedSeen")] [ScSetContent (SeVar "Log") (SeRaw "\"error 3010: $($_.Exception.Message)\""), ScExit (SeInt 8)] [], ScAssign "implicitNames" (SeArrayLiteral [SeLit "ListUtils", SeLit "Tuple"]), ScRaw "$unbundled = @($ordered | Where-Object { -not ($_.Quire -eq 'Foreword' -and $implicitNames -contains $_.Name) })", ScIf (SeAnd (SeRaw "$unbundled.Count -gt 0") (SeRaw "$seedSeen.Count -gt 0")) warn []]

Section: S04 -- Mode

 The store flag and the -disk argument are two halves of one thing: the flag
 tells the compiler a fact-store disk is present, the argument gives codex-vm
 the image. Neither alone works.

  s04-disk : List ShellCmd = [ScIf (SeNot (SeFileExists (SeVar "DiskFile"))) [ScWriteError (SeRaw "\"MISSING: -DiskFile $DiskFile is not there\""), ScExit (SeInt 2)] [], ScAssign "baseMode" (SeRaw "\"$baseMode store\"")]

  s04 : List ShellCmd = [ScRaw "$baseMode = if ($Measure) { \"MEASURE\" } elseif ($Text) { \"TEXT\" } elseif ($IrUni) { \"IR-UNI\" } elseif ($IrCce) { \"IR-CCE\" } else { \"CDX\" }", ScIf (SeVar "Prose") [ScAssign "baseMode" (SeRaw "\"$baseMode prose\"")] [], ScIf (SeVar "Repl") [ScAssign "baseMode" (SeRaw "\"$baseMode repl\"")] [], ScIf (SeAnd (SeNot (SeVar "Repl")) (SeStartsWith (SeVar "baseMode") (SeLit "CDX"))) [ScAssign "baseMode" (SeRaw "\"$baseMode map\"")] [], ScIf (SeVar "Poison") [ScAssign "baseMode" (SeRaw "\"$baseMode poison\"")] [], ScIf (SeVar "PoisonCompact") [ScAssign "baseMode" (SeRaw "\"$baseMode poison-compact\"")] [], ScIf (SeVar "DebugMode") [ScAssign "baseMode" (SeRaw "\"$baseMode debug\"")] [], ScIf (SeVar "Profile") [ScAssign "baseMode" (SeRaw "\"$baseMode profile\"")] [], ScIf (SeRaw "$Decks -ne 0") [ScAssign "baseMode" (SeRaw "\"$baseMode decks=$Decks\"")] [], ScIf (SeVar "Passes") [ScAssign "baseMode" (SeRaw "\"$baseMode passes=$Passes\"")] [], ScIf (SeVar "RawFlags") [ScAssign "baseMode" (SeRaw "\"$baseMode $RawFlags\"")] [], ScIf (SeVar "Trace") [ScAssign "baseMode" (SeRaw "\"$baseMode trace\"")] [], ScIf (SeVar "EscapeCheck") [ScAssign "baseMode" (SeRaw "\"$baseMode escape-check\"")] [], ScIf (SeVar "Uefi") [ScAssign "baseMode" (SeRaw "\"$baseMode uefi\"")] [], ScIf (SeVar "Pet") [ScAssign "baseMode" (SeRaw "\"$baseMode pet\"")] [], ScIf (SeVar "DiskFile") s04-disk []]

  s04-peer : List ShellCmd = [ScIf (SeVar "Peer") [ScAssign "srcLines" (SeCallArgs "Add-PeerWorks" [SaNamed "Lines" (SeVar "srcLines"), SaNamed "Peer" (SeVar "Peer")])] [ScIf (SeVar "Registry") [ScAssign "srcLines" (SeCallArgs "Add-PeerWorks" [SaNamed "Lines" (SeVar "srcLines"), SaNamed "Registry" (SeVar "Registry")])] []]]

Section: S05 -- Input

  s05 : List ShellCmd = [ScRaw "$script:DiagRegions = Get-DiagRegions -Ordered $ordered -SrcPath $Src", ScAssign "bodyBuilder" (SeStaticCall "System.Text.StringBuilder" "new" [SeInt 524288]), ScForEach "l" (SeCallArgs "Format-CiteChapters" [SaNamed "Ordered" (SeVar "ordered")]) [ScRaw "[void]$bodyBuilder.Append($l + \"`n\")"], ScForEach "line" (SeVar "srcLines") [ScRaw "[void]$bodyBuilder.Append($line + \"`n\")"], ScRaw "[void]$bodyBuilder.Append([char]4)", ScAssign "bodyText" (SeMethodCall (SeVar "bodyBuilder") "ToString" []), ScTempFile "inputFile", ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "inputFile", SeRaw "\"$baseMode`n$bodyText\"", SeRaw "[System.Text.UTF8Encoding]::new($false)"], ScTempFile "outputFile", ScTempFile "stderrFile"]

Section: S06 -- VM Launch

  s06 : List ShellCmd =
    let timeout = [ScRaw "Stop-VmGraceful -ProcessId $proc.Id", ScSetContent (SeVar "Log") (SeLit "FAIL: VM timed out"), ScExit (SeInt 3)]
    in let retry = [ScWriteError (SeRaw "\"  compile: no output with ${curMem}MB, retrying with 3072MB\""), ScAssign "curMem" (SeInt 3072), ScContinueLabel "compile_loop"]
    in let no-out = [ScSetContent (SeVar "Log") (SeLit "FAIL: no output"), ScIf (SeFileExists (SeVar "stderrFile")) [ScAddContent (SeVar "Log") (SeRaw "(Get-Content $stderrFile -Raw)")] [], ScExit (SeInt 4)]
    in let codex-vm-arm = [ScAssign "vmArgs" (SeArrayLiteral [SeLit "-kernel", SeVar "Stage0", SeLit "-input", SeVar "inputFile", SeLit "-output", SeVar "outputFile", SeLit "-mem", SeRaw "\"$curMem\"", SeLit "-headless"]), ScIf (SeVar "MemNoCap") [ScAppend "vmArgs" (SeLit "-mem-nocap")] [], ScIf (SeVar "DiskFile") [ScAppend "vmArgs" (SeArrayLiteral [SeLit "-disk", SeVar "DiskFile"])] [], ScRaw "$proc = Start-Process -FilePath $vmBin -ArgumentList $vmArgs -PassThru -WindowStyle Hidden -RedirectStandardError $stderrFile", ScRaw "$proc.WaitForExit($TimeoutSec * 1000)", ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) timeout []]
    in let fail-qemu = [ScSetContent (SeVar "Log") (SeLit "FAIL: VM timed out"), ScExit (SeInt 3)]
    in let qemu-arm = [ScRaw "# No codex-vm on this host: the QEMU fallback serves the same", ScRaw "# -input/-output contract over the serial wire, and the parsing", ScRaw "# below cannot tell the difference. (-MemNoCap needs no translation:", ScRaw "# the 3040 MB cap is codex-vm's, and the 0xFE8 cell the QEMU path", ScRaw "# seeds already carries the real -m value.)", ScRaw "$ok = Invoke-VmCompileFallback -Kernel $Stage0 -InputFile $inputFile -OutputFile $outputFile -MemMB $curMem -TimeoutSec $TimeoutSec -DiskFile $DiskFile", ScIf (SeNot (SeVar "ok")) fail-qemu []]
    in [ScIf (SeRaw "$script:UseCodexVm") codex-vm-arm qemu-arm, ScIf (SeOr (SeNot (SeFileExists (SeVar "outputFile"))) (SeRaw "(Get-Item $outputFile).Length -eq 0")) [ScIf (SeAnd (SeRaw "$attempt -lt $maxAttempts") (SeIntLt (SeVar "curMem") (SeInt 3072))) retry no-out] []]

Section: S07 -- Parse

  s07-halted : List ShellCmd = [ScDotNetCallAssign "errLines" "System.Collections.Generic.List[string]" "new" [], ScRaw "[void]$errLines.Add($line)", ScRaw "for ($k = $i + 1; $k -lt $outLines.Count; $k++) { $el = $outLines[$k].TrimEnd(\"`r\"); if ($el -and -not $el.StartsWith('WD:') -and -not $el.StartsWith('HEAP:') -and -not $el.StartsWith('STACK:')) { [void]$errLines.Add($el) } }", ScForEach "el" (SeVar "errLines") [ScAddContent (SeVar "Log") (SeCall "Remap-Diag" [SeVar "el"])], ScExit (SeInt 4)]

  s07-exc : List ShellCmd =
    let retry = [ScAssign "prevMem" (SeVar "curMem"), ScAssign "curMem" (SeInt 8192), ScWriteError (SeRaw "\"  compile: crash with ${prevMem}MB, retrying with ${curMem}MB\""), ScAssign "hitExc" (SeRaw "$true"), ScBreak]
    in [ScAddContent (SeVar "Log") (SeVar "line"), ScAssign "report" (SeCallArgs "Format-CrashReport" [SaNamed "ExcLines" (SeAsArray (SeVar "line")), SaNamed "Kernel" (SeVar "Stage0")]), ScForEach "r" (SeVar "report") [ScAddContent (SeVar "Log") (SeVar "r"), ScWriteError (SeRaw "\"  $r\"")], ScIf (SeAnd (SeRaw "$attempt -lt $maxAttempts") (SeIntLt (SeVar "curMem") (SeInt 8192))) retry [ScExit (SeInt 4)]]

  s07 : List ShellCmd = [ScReadBytes "outBytes" (SeVar "outputFile"), ScAssign "outText" (SeStaticCall "System.Text.Encoding" "UTF8.GetString" [SeVar "outBytes"]), ScRaw "$outLines = $outText -split \"`n\"", ScFunction "Remap-Diag" [sh-param "l" SptString] [ScReturn (SeCallArgs "Convert-DiagLine" [SaNamed "Line" (SeVar "l"), SaNamed "Regions" (SeRaw "$script:DiagRegions")])], ScSetContent (SeVar "Log") (SeLit ""), ScRaw "$binSize = 0; $binStart = -1; $hitExc = $false", ScForLoop "i" (SeInt 0) (SeRaw "$i -lt $outLines.Count") (SeRaw "$i++") [ScAssign "line" (SeMethodCall (SeIndex (SeVar "outLines") (SeVar "i")) "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeStartsWith (SeVar "line") (SeLit "SIZE:")) [ScIf (SeMatch (SeMethodCall (SeVar "line") "Substring" [SeInt 5]) "^\\d+") [ScAssign "binSize" (SeRaw "[int]$matches[0]")] [], ScAssign "binStart" (SeRaw "$i + 1"), ScBreak] [], ScIf (SeOr (SeStartsWith (SeVar "line") (SeLit "CODEGEN-HALTED")) (SeStartsWith (SeVar "line") (SeLit "CODEGEN-ERRORS"))) s07-halted [], ScIf (SeStartsWith (SeVar "line") (SeLit "!EXC")) s07-exc [], ScIf (SeAnd (SeVar "line") (SeNot (SeStartsWith (SeVar "line") (SeLit "WD:")))) [ScAddContent (SeVar "Log") (SeCall "Remap-Diag" [SeVar "line"])] []]]

Section: S08 -- Binary Extract

 emit-ir-cce and emit-text both take __heap-save either side of the emit and
 print the marks after the payload, where the payload-end scan uses the line's
 prefix as a terminator and nothing then reads it. Log them: the frontier
 across the emit has been measured and transmitted all along and thrown away
 on arrival, which is why a question about what the IR emitter costs had no
 instrument.

  s08-marks : List ShellCmd = [ScForEach "tl" (SeVar "tailLines") [ScAssign "t" (SeMethodCall (SeVar "tl") "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeOr (SeOr (SeStartsWith (SeVar "t") (SeLit "WD:")) (SeStartsWith (SeVar "t") (SeLit "HEAP:"))) (SeStartsWith (SeVar "t") (SeLit "STACK:"))) [ScAddContent (SeVar "Log") (SeVar "t")] []]]

  s08-tail : List ShellCmd = [ScAssign "tailText" (SeStaticCall "System.Text.Encoding" "UTF8.GetString" [SeVar "outBytes", SeVar "tailStart", SeRaw "$outBytes.Length - $tailStart"]), ScRaw "$tailLines = $tailText -split \"`n\"", ScSequence s08-marks, ScDotNetCallAssign "mapFile" "System.IO.Path" "ChangeExtension" [SeVar "Out", SeLit ".map"], ScAssign "inMap" (SeRaw "$false"), ScDotNetCallAssign "mapLines" "System.Collections.Generic.List[string]" "new" [], ScRaw "[void]$mapLines.Add('# Codex Symbol Map'); [void]$mapLines.Add('# Address         Size  Name')", ScDotNetCallAssign "profFile" "System.IO.Path" "ChangeExtension" [SeVar "Out", SeLit ".prof"], ScRaw "$inProf = $false; $profCount = 0", ScDotNetCallAssign "profLines" "System.Collections.Generic.List[string]" "new" [], ScForEach "tl" (SeVar "tailLines") [ScAssign "tl" (SeMethodCall (SeVar "tl") "TrimEnd" [SeRaw "\"`r\""]), ScIf (SeStartsWith (SeVar "tl") (SeLit "MAP:")) [ScAssign "inMap" (SeRaw "$true"), ScContinue] [], ScIf (SeStartsWith (SeVar "tl") (SeLit "MAP-END")) [ScAssign "inMap" (SeRaw "$false"), ScContinue] [], ScIf (SeAnd (SeVar "inMap") (SeStartsWith (SeVar "tl") (SeLit "0x"))) [ScRaw "[void]$mapLines.Add($tl)"] [], ScIf (SeStartsWith (SeVar "tl") (SeLit "PROF:")) [ScIf (SeNot (SeVar "inProf")) [ScAssign "inProf" (SeRaw "$true"), ScIf (SeMatch (SeMethodCall (SeVar "tl") "Substring" [SeInt 5]) "^\\d+") [ScAssign "profCount" (SeRaw "[int]$matches[0]")] []] [ScRaw "[void]$profLines.Add($tl.Substring(5))"]] []], ScIf (SeRaw "$mapLines.Count -gt 2") [ScDotNetCall "System.IO.File" "WriteAllLines" [SeVar "mapFile", SeVar "mapLines", SeRaw "[System.Text.UTF8Encoding]::new($false)"]] [], ScIf (SeRaw "$profLines.Count -gt 0") [ScDotNetCall "System.IO.File" "WriteAllLines" [SeVar "profFile", SeVar "profLines", SeRaw "[System.Text.UTF8Encoding]::new($false)"], ScWriteError (SeRaw "\"  profile: $($profLines.Count) samples -> $profFile\"")] []]

  s08 : List ShellCmd =
    let write-bin = [ScRaw "$binBytes = New-Object byte[] $actSize", ScRaw "[Array]::Copy($outBytes, $sizeLineEnd, $binBytes, 0, $actSize)", ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "Out", SeVar "binBytes"], ScAssign "tailStart" (SeVar "binEnd"), ScIf (SeIntLt (SeVar "tailStart") (SeProperty (SeVar "outBytes") "Length")) s08-tail [], ScExit (SeInt 0)]
    in let size-fail = [ScAddContent (SeVar "Log") (SeLit "Binary size mismatch"), ScExit (SeInt 5)]
    in let scan = [ScRaw "for ($j = $sizeLineEnd; $j -lt $outBytes.Length; $j++) { if ($outBytes[$j] -eq 10) { $afterNl = $j + 1; if ($afterNl + 3 -le $outBytes.Length) { $tag = [System.Text.Encoding]::ASCII.GetString($outBytes, $afterNl, [Math]::Min(5, $outBytes.Length - $afterNl)); if ($tag.StartsWith('WD:') -or $tag.StartsWith('HEAP:') -or $tag.StartsWith('STACK:')) { $binEnd = $j + 1; break } } } }"]
    in [ScIf (SeRaw "$binStart -ge 0") [ScRaw "$sizeLineEnd = 0; $nlCount = 0", ScForLoop "j" (SeInt 0) (SeRaw "$j -lt $outBytes.Length") (SeRaw "$j++") [ScIf (SeRaw "$outBytes[$j] -eq 10") [ScRaw "$nlCount++; if ($nlCount -eq $binStart) { $sizeLineEnd = $j + 1; break }"] []], ScAssign "binEnd" (SeProperty (SeVar "outBytes") "Length"), ScIf (SeAnd (SeRaw "$binSize -gt 0") (SeRaw "($sizeLineEnd + $binSize) -le $outBytes.Length")) [ScAssign "binEnd" (SeRaw "$sizeLineEnd + $binSize")] scan, ScAssign "actSize" (SeRaw "$binEnd - $sizeLineEnd"), ScIf (SeRaw "$actSize -gt 0") write-bin size-fail] [], ScIf (SeVar "hitExc") [ScContinueLabel "compile_loop"] [], ScExit (SeInt 4)]

Section: S09 -- Cleanup

  s09 : List ShellCmd = [ScIf (SeVar "inputFile") [ScDelete (SeVar "inputFile")] [], ScIf (SeVar "outputFile") [ScDelete (SeVar "outputFile")] [], ScIf (SeVar "stderrFile") [ScDelete (SeVar "stderrFile")] []]

Section: Assembly

  compile-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScAssign "inputFile" (SeRaw "$null"), ScAssign "outputFile" (SeRaw "$null"), ScAssign "stderrFile" (SeRaw "$null"), ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'quire-map.ps1')"), ScBlank, ScTry [ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s04-peer, ScBlank, ScSequence s05, ScBlank, ScAssign "vmBin" (SeRaw "Join-Path (Split-Path $PSScriptRoot) 'tools\\codex-vm.exe'"), ScAssign "curMem" (SeVar "MemMB"), ScAssign "attempt" (SeInt 0), ScAssign "maxAttempts" (SeInt 2), ScLabeledWhile "compile_loop" (SeIntLt (SeVar "attempt") (SeVar "maxAttempts")) [ScRaw "$attempt++", ScIf (SeFileExists (SeVar "outputFile")) [ScDotNetCall "System.IO.File" "WriteAllBytes" [SeVar "outputFile", SeRaw "[byte[]]::new(0)"]] [], ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08]] [] s09]

  compile-script : ShellScript = sh-script "compile" "Compile a single .codex source file to CDX, TEXT, or IR" compile-params compile-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell compile-script)
  end

