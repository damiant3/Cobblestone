Chapter: TestExceptionHandlerScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  exc-params : List ShellParam = [sh-param-default "CodexCdx" SptString (SeLit "")]

Section: S01 -- Directories

  s01-body : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1")), ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScIf (SeNot (SeVar "CodexCdx")) [ScAssign "CodexCdx" (SePathJoin (SeVar "Repo") (SeLit "seed\\Codex.cdx"))] [], ScAssign "compile" (SePathJoin SeScriptRoot (SeLit "compile.ps1")), ScAssign "outDir" (SePathJoin (SeVar "Repo") (SeLit "build-output\\exc-test")), ScIf (SeDirExists (SeVar "outDir")) [ScDeleteTree (SeVar "outDir")] [], ScMkdir (SeVar "outDir"), ScBlank, ScAssign "stage0Dir" (SePathJoin (SeVar "Repo") (SeLit "build-output\\bare-metal")), ScMkdir (SeVar "stage0Dir"), ScCopy (SeVar "CodexCdx") (SePathJoin (SeVar "stage0Dir") (SeLit "Codex.cdx"))]

Section: S02 -- The Sample Table

  exc-pattern : Text = "!EXC="

  sample-div-zero : ShellExpr = SeRecord [SfField "Name" (SeLit "exc-div-zero"), SfField "Pattern" (SeLit exc-pattern), SfField "NeedStack" (SeBool True)]

  sample-null-read : ShellExpr = SeRecord [SfField "Name" (SeLit "exc-null-read"), SfField "Pattern" (SeLit exc-pattern), SfField "NeedStack" (SeBool True)]

  sample-gpf : ShellExpr = SeRecord [SfField "Name" (SeLit "exc-gpf"), SfField "Pattern" (SeLit exc-pattern), SfField "NeedStack" (SeBool True)]

  sample-deep : ShellExpr = SeRecord [SfField "Name" (SeLit "exc-deep-frames"), SfField "Pattern" (SeLit exc-pattern), SfField "NeedStack" (SeBool True), SfField "NeedFrames" (SeInt 3)]

  sample-stack-heap : ShellExpr = SeRecord [SfField "Name" (SeLit "exc-stack-heap"), SfField "Pattern" (SeLit "!EXC=08"), SfField "NeedStack" (SeBool False), SfField "TimeoutSec" (SeInt 90)]

  s02-body : List ShellCmd = [ScBlank, ScAssign "samples" (SeArrayLiteral [sample-div-zero, sample-null-read, sample-gpf, sample-deep, sample-stack-heap]), ScBlank, ScAssign "pass" (SeInt 0), ScAssign "fail" (SeInt 0), ScBlank]

Section: S03 -- Compile One Sample

  sample-name : ShellExpr = SeProperty (SeVar "s") "Name"

  compile-args : List ShellArg = [SaSwitch "NoProfile", SaNamed "File" (SeVar "compile"), SaNamed "Src" (SeVar "src"), SaNamed "Out" (SeVar "cdx"), SaNamed "Log" (SeVar "log")]

  compile-failed : List ShellCmd = [ScEcho (SeLit "FAIL (compile)"), ScIncrement "fail", ScContinue]

  s03-body : List ShellCmd = [ScAssign "src" (SePathJoin (SeVar "Repo") (SeConcat (SeConcat (SeLit "codex\\test\\") sample-name) (SeLit ".codex"))), ScAssign "cdx" (SePathJoin (SeVar "outDir") (SeConcat sample-name (SeLit ".cdx"))), ScAssign "log" (SePathJoin (SeVar "outDir") (SeConcat sample-name (SeLit ".log"))), ScBlank, ScEchoPartial (SeConcat sample-name (SeLit ": ")), ScRunArgs (SeLit "pwsh") compile-args, ScIf (SeNot (SeExitCodeEq 0)) compile-failed []]

Section: S04 -- Boot It

  budget : ShellExpr = SeIfElse (SeHasField (SeVar "s") "TimeoutSec") (SeProperty (SeVar "s") "TimeoutSec") (SeInt 45)

 `-serial` and `-timeout` were in this list and codex-vm parses neither, in
 any revision. The budget was never the guest's: Wait-Process below is what
 enforces it, and it still does. Dropping them changes no behaviour, which is
 the point -- a flag that does nothing looked exactly like one that works.

  vm-args : List ShellExpr = [SeLit "-kernel", SeVar "cdx", SeLit "-mem", SeLit "3072"]

  vm-spec : ShellProcessSpec = ShellProcessSpec { sp-executable = SeVar "script:CodexVmBin", sp-arguments = vm-args, sp-result-var = "proc", sp-stdout-file = Just (SeVar "so"), sp-stderr-file = Just (SeVar "se"), sp-hidden = True, sp-passthru = True }

  gather-stream : List ShellCmd = [ScAssign "t" (SeFileText (SeVar "f")), ScIf (SeVar "t") [ScIncrementBy "output" (SeVar "t")] []]

  s04-body : List ShellCmd = [ScBlank, ScAssign "so" (SePathJoin (SeVar "outDir") (SeConcat sample-name (SeLit ".stdout"))), ScAssign "se" (SePathJoin (SeVar "outDir") (SeConcat sample-name (SeLit ".stderr"))), ScAssign "budget" budget, ScStartProcess vm-spec, ScWaitProcessSec "proc" (SeAdd (SeVar "budget") (SeInt 30)), ScIf (SeNot (SeProperty (SeVar "proc") "HasExited")) [ScStopProcess (SeProperty (SeVar "proc") "Id")] [], ScBlank, ScAssign "output" (SeLit ""), ScForEach "f" (SeArrayLiteral [SeVar "so", SeVar "se"]) gather-stream, ScDelete (SeVar "so"), ScDelete (SeVar "se"), ScDotNetCall "System.IO.File" "WriteAllText" [SePathJoin (SeVar "outDir") (SeConcat sample-name (SeLit ".out")), SeVar "output"]]

Section: S05 -- Judge It

  dump-lines : ShellExpr = SeCount (SePipe (SeSplit (SeVar "output") "\\n") [StWhere (SeMatch SeItem "^S\\[")])

  frame-lines : ShellExpr = SeCount (SePipe (SeSplit (SeVar "output") "\\n") [StWhere (SeMatch SeItem "^F\\[")])

  need-frames : ShellExpr = SeIfElse (SeHasField (SeVar "s") "NeedFrames") (SeProperty (SeVar "s") "NeedFrames") (SeInt 0)

  stack-ok : ShellExpr = SeIfElse (SeProperty (SeVar "s") "NeedStack") (SeIntGt (SeVar "dumpLines") (SeInt 13)) (SeBool True)

  verdict-tail : ShellExpr = SeConcat (SeConcat (SeLit " stack=") (SeVar "dumpLines")) (SeConcat (SeLit " frames=") (SeVar "frameLines"))

  pass-message : ShellExpr = SeConcat (SeConcat (SeLit "PASS (pattern=") (SeVar "hasPattern")) (SeConcat verdict-tail (SeLit ")"))

  fail-tail : ShellExpr = SeConcat (SeConcat (SeLit " need=") (SeVar "needFrames")) (SeLit ")")

  fail-message : ShellExpr = SeConcat (SeConcat (SeLit "FAIL (pattern=") (SeVar "hasPattern")) (SeConcat verdict-tail fail-tail)

  clip-length : ShellExpr = SeStaticCall "math" "Min" [SeInt 200, SeProperty (SeVar "output") "Length"]

  fail-detail : ShellExpr = SeConcat (SeLit "  output: ") (SeSubstringLen (SeVar "output") (SeInt 0) clip-length)

  passed : ShellExpr = SeAnd (SeAnd (SeVar "hasPattern") (SeVar "stackOk")) (SeVar "framesOk")

  s05-body : List ShellCmd = [ScBlank, ScAssign "hasPattern" (SeMethodCall (SeVar "output") "Contains" [SeProperty (SeVar "s") "Pattern"]), ScAssign "dumpLines" dump-lines, ScAssign "stackOk" stack-ok, ScAssign "frameLines" frame-lines, ScAssign "needFrames" need-frames, ScAssign "framesOk" (SeNot (SeIntLt (SeVar "frameLines") (SeVar "needFrames"))), ScBlank, ScIf passed [ScEcho pass-message, ScIncrement "pass"] [ScEcho fail-message, ScEcho fail-detail, ScIncrement "fail"]]

Section: Assembly

  summary : ShellExpr = SeConcat (SeConcat (SeLit "Exception handler tests: pass=") (SeVar "pass")) (SeConcat (SeLit " fail=") (SeVar "fail"))

  s06-body : List ShellCmd = [ScBlank, ScEcho (SeLit ""), ScEcho summary, ScIf (SeIntGt (SeVar "fail") (SeInt 0)) [ScExit (SeInt 1)] [], ScExit (SeInt 0)]

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "strict mode, the repository root and the output directory", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "the sample table", ps-why = "names each exception subject with the pattern its output must carry, and zeroes the pass and fail counters", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "compile one sample", ps-why = "builds the subject for one row of the table", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "run one sample", ps-why = "boots the subject and captures what the exception handler printed", ps-in = [], ps-out = [], ps-needs = [PrGuests 1], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "grade one sample", ps-why = "asserts the captured output carries the pattern the table names for that row, and counts the result", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "the summary and the verdict", ps-why = "runs ONCE after the table is exhausted, which is why it is a stage after the group rather than the group's last step", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "at least one exception subject printed output the table's pattern does not match", PoExit 0 "every subject in the table printed the output its row names"], ps-body = s06-body }

  exc-pipe : Pipeline = Pipeline { pl-name = "test-exception-handler", pl-doc = "Test the bare-metal exception handler output", pl-params = exc-params, pl-stages = [PsStage s01, PsStage s02, PsGroup (Just (PrForEach "s" (SeVar "samples"))) None None [PsStage s03, PsStage s04, PsStage s05], PsStage s06] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell exc-pipe))
  end

