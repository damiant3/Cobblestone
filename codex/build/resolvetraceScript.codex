Chapter: ResolveTraceScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  resolve-trace-params : List ShellParam =
    [ sh-param "TraceFile" SptString
    , sh-param-default "MapFile" SptString (SeLit "")
    ]

Section: The pipeline, declared before it is spelled

  map-art : PipeArtifact = PipeArtifact { pa-name = "map", pa-kind = PkValue, pa-expr = SeVar "map", pa-from = Just (SeArrayLiteral []) }

  entries-art : PipeArtifact = PipeArtifact { pa-name = "entries", pa-kind = PkValue, pa-expr = SeVar "entries", pa-from = None }

  phase-art : PipeArtifact = PipeArtifact { pa-name = "phase", pa-kind = PkText, pa-expr = SeVar "phase", pa-from = Just (SeLit "init") }

  summary-art : PipeArtifact = PipeArtifact { pa-name = "summary", pa-kind = PkValue, pa-expr = SeVar "summary", pa-from = Just SeHashLiteral }

  phase-total-art : PipeArtifact = PipeArtifact { pa-name = "phaseTotal", pa-kind = PkValue, pa-expr = SeVar "phaseTotal", pa-from = Just SeHashLiteral }

  total-allocs-art : PipeArtifact = PipeArtifact { pa-name = "totalAllocs", pa-kind = PkValue, pa-expr = SeVar "totalAllocs", pa-from = Just (SeInt 0) }

  total-bytes-art : PipeArtifact = PipeArtifact { pa-name = "totalBytes", pa-kind = PkValue, pa-expr = SeVar "totalBytes", pa-from = None }

  rt-arts : List PipeArtifact = [map-art, entries-art, phase-art, summary-art, phase-total-art, total-allocs-art, total-bytes-art]

Section: S01 -- Preamble and validation

  s01-body : List ShellCmd =
    [ ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , ScIf (SeNot (pipe-ref rt-arts resolve-trace-params "MapFile")) [ScAssign "MapFile" map-beside-trace] []
    , ScIf (SeNot (SeFileExists (pipe-ref rt-arts resolve-trace-params "MapFile"))) [ScRaw "Write-Error \"Symbol map not found: $MapFile\"", ScExit (SeInt 1)] []
    , ScIf (SeNot (SeFileExists (pipe-ref rt-arts resolve-trace-params "TraceFile"))) [ScRaw "Write-Error \"Trace file not found: $TraceFile\"", ScExit (SeInt 1)] []
    ]

  map-beside-trace : ShellExpr = SeStaticCall "System.IO.Path" "ChangeExtension" [pipe-ref rt-arts resolve-trace-params "TraceFile", SeLit ".map"]

  s01 : PipeStage = PipeStage { ps-name = "preamble and validation", ps-why = "default the symbol map beside the trace, and refuse before reading either file", ps-in = ["TraceFile", "MapFile"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the symbol map named by -MapFile, or defaulted beside the trace, does not exist", PoExit 1 "the file named by -TraceFile does not exist"], ps-body = s01-body }

Section: S02 -- Parse symbol map

  s02-body : List ShellCmd =
    [ ScBlank
    , pipe-produce map-art
    , ScForEach "line" (SeBare (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "MapFile"])) [ScIf (SeMatch (SeVar "line") "^(0x[0-9a-fA-F]+)\\s+(\\d+)\\s+(.+)$") s02-symbol []]
    , ScAssign "map" (SeBare (SePipe (SeVar "map") [StSortBy "Addr"]))
    ]

  s02-symbol : List ShellCmd =
    [ ScDotNetCallAssign "addr" "Convert" "ToInt64" [SeIndex (SeVar "matches") (SeInt 1), SeInt 16]
    , ScAssign "size" (SeCast "int" (SeIndex (SeVar "matches") (SeInt 2)))
    , ScAssign "name" (SeTrim (SeIndex (SeVar "matches") (SeInt 3)))
    , ScAppend "map" (SeCast "PSCustomObject" (SeRecord [SfField "Addr" (SeVar "addr"), SfField "Size" (SeVar "size"), SfField "Name" (SeVar "name")]))
    ]

  s02 : PipeStage = PipeStage { ps-name = "parse symbol map", ps-why = "address, size and name per symbol, sorted by address for the lookup below", ps-in = ["MapFile"], ps-out = [map-art], ps-needs = [], ps-verdict = [], ps-body = s02-body }

Section: S03 -- Resolve-Addr function

  s03-body : List ShellCmd =
    [ ScBlank
    , ScRaw "function Resolve-Addr([long]$rip) { for ($i = $map.Length - 1; $i -ge 0; $i--) { if ($map[$i].Addr -le $rip -and ($map[$i].Addr + $map[$i].Size) -gt $rip) { $off = $rip - $map[$i].Addr; return \"$($map[$i].Name)+0x$($off.ToString('X'))\" } } return \"0x$($rip.ToString('X'))\" }"
    ]

  s03 : PipeStage = PipeStage { ps-name = "resolve-addr", ps-why = "the address to symbol lookup the accumulation stage calls, answering a bare hex address when nothing contains it", ps-in = ["map"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

Section: S04 -- Parse trace entries

  s04-body : List ShellCmd =
    [ ScBlank
    , ScDotNetCallAssign "entries" "System.Collections.Generic.List[long[]]" "new" []
    , ScAssign "firstLine" (SeTrim (SeFileFirstLine (SeVar "TraceFile")))
    , ScIf (SeStartsWith (SeVar "firstLine") (SeLit "T:")) [ScSequence s04-text] [ScSequence s04-binary]
    ]

  s04-text : List ShellCmd =
    [ ScForEach "line" (SeBare (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "TraceFile"])) [ScIf (SeMatch (SeVar "line") "^T:([0-9a-fA-F]+):([0-9a-fA-F]+)$") [ScCallMethod (SeVar "entries") "Add" [text-entry]] []]
    ]

  text-entry : ShellExpr = SeArrayLiteral [SeBare (SeStaticCall "Convert" "ToInt64" [SeIndex (SeVar "matches") (SeInt 1), SeInt 16]), SeBare (SeStaticCall "Convert" "ToInt64" [SeIndex (SeVar "matches") (SeInt 2), SeInt 16])]

  s04-binary : List ShellCmd =
    [ ScReadBytes "bytes" (pipe-ref rt-arts resolve-trace-params "TraceFile")
    , ScIf (SeIntLt (SeProperty (SeVar "bytes") "Length") (SeInt 8)) [ScRaw "Write-Error \"Trace file too small\"; exit 1"] []
    , ScDotNetCallAssign "count" "BitConverter" "ToInt64" [SeVar "bytes", SeInt 0]
    , ScIf (SeRaw "$bytes.Length -lt 8 + $count * 16") s04-truncated []
    , ScForLoop "i" (SeInt 0) (SeBare (SeIntLt (SeVar "i") (SeVar "count"))) (SePostIncrement "i") s04-binary-entry
    ]

  s04-truncated : List ShellCmd =
    [ ScRaw "Write-Warning \"Trace file truncated\""
    , ScDotNetCallAssign "count" "Math" "Floor" [SeBare (SeDiv (SeSub (SeProperty (SeVar "bytes") "Length") (SeInt 8)) (SeInt 16))]
    ]

  s04-binary-entry : List ShellCmd =
    [ ScRaw "$off = 8 + $i * 16"
    , ScCallMethod (SeVar "entries") "Add" [binary-entry]
    ]

  binary-entry : ShellExpr = SeArrayLiteral [SeBare (SeStaticCall "BitConverter" "ToInt64" [SeVar "bytes", SeVar "off"]), SeBare (SeStaticCall "BitConverter" "ToInt64" [SeVar "bytes", SeBare (SeAdd (SeVar "off") (SeInt 8))])]

  s04 : PipeStage = PipeStage { ps-name = "parse trace entries", ps-why = "read the trace in whichever of its two formats the first line says it is", ps-in = ["TraceFile"], ps-out = [entries-art], ps-needs = [], ps-verdict = [PoExit 1 "the binary trace carries fewer than the eight bytes its own count header needs; spelled inside a raw payload, so no walk of this stage's body finds it"], ps-body = s04-body }

Section: S05 -- Accumulate per-phase per-function stats

  s05-body : List ShellCmd =
    [ ScBlank
    , ScRaw "$phaseNames = @{ 1='lex'; 2='parse'; 3='desugar'; 4='scope'; 5='check'; 6='lower'; 7='emit' }"
    , pipe-produce phase-art
    , pipe-produce summary-art
    , pipe-produce phase-total-art
    , pipe-produce total-allocs-art
    , ScAssign "totalBytes" (SeCast "long" (SeInt 0))
    , ScForEach "e" (pipe-ref rt-arts resolve-trace-params "entries") s05-one-entry
    ]

  s05-one-entry : List ShellCmd =
    [ ScAssign "size" (SeIndex (SeVar "e") (SeInt 0))
    , ScAssign "rip" (SeIndex (SeVar "e") (SeInt 1))
    , ScSequence s05-phase-marker
    , ScSequence s05-charge
    ]

  s05-phase-marker : List ShellCmd =
    [ ScIf (SeAnd (SeBare (SeIntEq (SeVar "size") (SeInt 0))) (SeMethodCall (SeVar "phaseNames") "ContainsKey" [SeCast "int" (SeVar "rip")])) [ScAssign "phase" (SeIndex (SeVar "phaseNames") (SeCast "int" (SeVar "rip"))), ScContinue] []
    ]

  s05-charge : List ShellCmd =
    [ ScAssign "func" (SeBare (SeCall "Resolve-Addr" [SeVar "rip"]))
    , ScAssign "key" (SeText "$phase|$func")
    , ScIf (SeNot (SeMethodCall (SeVar "summary") "ContainsKey" [SeVar "key"])) [ScRaw "$summary[$key] = [PSCustomObject]@{ Phase=$phase; Func=$func; Count=0; Bytes=[long]0 }"] []
    , ScRaw "$summary[$key].Count++"
    , ScRaw "$summary[$key].Bytes += $size"
    , ScIf (SeNot (SeMethodCall (SeVar "phaseTotal") "ContainsKey" [SeVar "phase"])) [ScRaw "$phaseTotal[$phase] = [PSCustomObject]@{ Count=0; Bytes=[long]0 }"] []
    , ScRaw "$phaseTotal[$phase].Count++"
    , ScRaw "$phaseTotal[$phase].Bytes += $size"
    , ScIncrement "totalAllocs"
    , ScIncrementBy "totalBytes" (SeVar "size")
    ]

  s05 : PipeStage = PipeStage { ps-name = "accumulate stats", ps-why = "a zero-size entry names the phase; every other entry is one allocation charged to a phase and a function", ps-in = ["entries", "map"], ps-out = [phase-art, summary-art, phase-total-art, total-allocs-art, total-bytes-art], ps-needs = [], ps-verdict = [], ps-body = s05-body }

Section: S06 -- Output report

  s06-body : List ShellCmd =
    [ ScBlank
    , ScSequence s06-header
    , ScSequence s06-detail
    , ScSequence s06-phase-totals
    , ScSequence s06-totals
    ]

  row-format : ShellExpr = SeText "{0,-12} {1,-40} {2,8} {3,12}"

  s06-header : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeFormat row-format [SeLit "Phase", SeLit "Function", SeLit "Count", SeLit "Total Bytes"])
    , ScEcho (SeFormat row-format [SeLit "-----", SeLit "--------", SeLit "-----", SeLit "-----------"])
    ]

  s06-detail : List ShellCmd =
    [ ScRaw "$sorted = $summary.Values | Sort-Object { $_.Phase }, { -$_.Bytes }"
    , ScForEach "entry" (SeVar "sorted") [ScEcho (SeFormat row-format [SeProperty (SeVar "entry") "Phase", SeProperty (SeVar "entry") "Func", SeProperty (SeVar "entry") "Count", SeMethodCall (SeProperty (SeVar "entry") "Bytes") "ToString" [SeLit "N0"]])]
    ]

  s06-phase-totals : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScEcho (SeLit "--- Phase Totals ---")
    , ScForEach "p" (SePipe (SeProperty (SeVar "phaseTotal") "Keys") [StSort]) s06-one-phase
    ]

  s06-one-phase : List ShellCmd =
    [ ScAssign "pt" (SeIndex (SeVar "phaseTotal") (SeVar "p"))
    , ScRaw "Write-Host (\"{0,-12} {1,8} allocs  {2,12} bytes ({3:F1} MB)\" -f $p, $pt.Count, $pt.Bytes.ToString('N0'), ($pt.Bytes / 1048576.0))"
    ]

  s06-totals : List ShellCmd =
    [ ScEcho (SeLit "")
    , ScRaw "Write-Host (\"TOTAL: {0:N0} allocations, {1:N0} bytes ({2:F1} MB)\" -f $totalAllocs, $totalBytes, ($totalBytes / 1048576.0))"
    ]

  s06 : PipeStage = PipeStage { ps-name = "output report", ps-why = "one line per phase and function, then the per-phase and overall totals", ps-in = ["summary", "phaseTotal", "totalAllocs", "totalBytes"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

Section: Assembly

  rt-pipe : Pipeline = Pipeline { pl-name = "resolve-trace", pl-doc = "Resolve allocation trace addresses to symbol names", pl-params = resolve-trace-params, pl-stages = [PsStage s01, PsStage s02, PsStage s03, PsStage s04, PsStage s05, PsStage s06] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell rt-pipe))
  end

