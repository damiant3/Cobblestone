 We say:

Section: Parameters

  batch-params : List ShellParam = [sh-param "ListFile" SptString, sh-param "OutRoot" SptString, sh-param-default "Kernel" SptString (SeLit ""), sh-param-default "PCore" SptInt (SeInt 1)]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScRaw "Set-Location (Join-Path $PSScriptRoot '..')", ScRaw "[Environment]::CurrentDirectory = (Get-Location).Path", ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')")]

Section: S02 -- Read Source List

  s02 : List ShellCmd = [ScRaw "$sources = @(Get-Content -Path $ListFile | Where-Object { $_.Trim() -ne '' })", ScRaw "if ($sources.Count -eq 0) { exit 0 }", ScRaw "$resolveSw = [System.Diagnostics.Stopwatch]::StartNew()", ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'quire-map.ps1')")]

Section: S03 -- Resolve-Source Function

 The resolved unit carries its diagnostic regions alongside its text. A
 batch assembles its own compiler unit and writes its own build.log, so the
 remap from unit line back to source file has to happen here; nothing
 downstream holds the region table.

  s03 : List ShellCmd = [ScRaw "# Resolution is split from emission so the batch input never exists as one\n# resident string. It used to be built in a StringBuilder and then written\n# with ToString(), which holds the WHOLE batch twice at the write; measured\n# 2026-09-01 on 400 chapters, driver live heap went 7 MB before this loop to\n# 101 MB after, and peak working set was 711 MB. Each chapter is now written\n# through and only that chapter is in hand. Resolve-CiteOrder can throw, so\n# ordering happens BEFORE anything is written and a failed chapter emits\n# nothing.\nfunction Resolve-Order {\n    param([string]$SrcPath)\n    $lines = [System.IO.File]::ReadAllLines($SrcPath)\n    $seedSeen = @{}; $embPat = '^Chapter:\\s*(\\w+)--(.+?)\\s*$'\n    foreach ($l in $lines) {\n        if ($l -match $embPat) { $seedSeen[\"$($matches[1])::$($matches[2])\"] = $true }\n    }\n    try {\n        $ordered = Resolve-CiteOrder -RootLines $lines -Repo '.' -SeedSeen $seedSeen\n    } catch {\n        return $null\n    }\n    return @{ Lines = $lines; Ordered = $ordered }\n}"]

Section: S04 -- Build Combined REPL Input

 The mode line is plain CDX. A per-request repl flag embeds a REPL loop in
 the TEST binary, which hangs every test that consumes stdin, and the map
 flag streams the whole symbol map over serial once per test. The batch
 session loops because the SEED is repl-built, not because each request
 asks for it.

  s04-loop-body : List ShellCmd = [ScRaw "$name = [System.IO.Path]::GetFileNameWithoutExtension($sources[$i])", ScRaw "$testOut = Join-Path $OutRoot $name", ScRaw "New-Item -ItemType Directory -Force -Path $testOut | Out-Null", ScRaw "$resolved = Resolve-Order $sources[$i]", ScRaw "if ($null -eq $resolved) {\n    \"8\" | Set-Content -Path (Join-Path $testOut '.exitcode') -Encoding UTF8\n    \"error 3010: foreword resolution failed\" | Set-Content -Path (Join-Path $testOut 'build.log') -Encoding UTF8\n    continue\n}", ScRaw "$testNames.Add($name)", ScRaw "# The regions ride along so build.log can name the file and the file's own\n# line. This assembler builds its own unit and writes its own log, so it\n# has to map back itself -- compile.ps1 doing it is not enough, and the\n# battery is the path that matters for a `.failing` position pin.", ScRaw "$regionsByName[$name] = Get-DiagRegions -Ordered $resolved.Ordered -SrcPath $sources[$i]", ScRaw "$flagsFile = Join-Path ([System.IO.Path]::GetDirectoryName($sources[$i])) \"$name.flags\"", ScRaw "$extraFlags = if (Test-Path -PathType Leaf $flagsFile) { ' ' + (Get-Content -TotalCount 1 $flagsFile).Trim() } else { '' }", ScRaw "# Plain CDX: the batch session loops because the SEED is repl-built.\n# A per-request 'repl' flag would embed a REPL loop in the TEST binary\n# (hangs stdin-consuming tests); the 'map' flag would stream the full\n# symbol map over serial per test (the battery-wide map tax). Test\n# binaries get Exit mode and halt cleanly on their own.", ScRaw "$inputWriter.Write(\"CDX$extraFlags`n\")", ScRaw "$srcChars = 0", ScRaw "foreach ($l in (Format-CiteChapters -Ordered $resolved.Ordered)) { $inputWriter.Write($l); $inputWriter.Write(\"`n\"); $srcChars += $l.Length + 1 }", ScRaw "foreach ($l in $resolved.Lines) { $inputWriter.Write($l); $inputWriter.Write(\"`n\"); $srcChars += $l.Length + 1 }", ScRaw "$inputWriter.Write([char]4)", ScRaw "# Census instrumentation: the resolved concat size is the best host-side\n# proxy for a test's compile cost inside a batch (the VM's output file\n# flushes on exit, so per-test wall time is not observable from here).", ScRaw "\"$srcChars\" | Set-Content -Path (Join-Path $testOut '.src-bytes') -Encoding UTF8"]

  s04 : List ShellCmd = [ScRaw "$regionsByName = @{}", ScBlank, ScRaw "# Build combined REPL input, streamed straight to the file so the batch is\n# never resident. The mode line is written only after ordering succeeds, so a\n# chapter that fails resolution emits nothing, exactly as the buffered\n# version did by skipping the appends.", ScTempFile "inputFile", ScRaw "$inputWriter = [System.IO.StreamWriter]::new($inputFile, $false, [System.Text.UTF8Encoding]::new($false))", ScRaw "$testNames = [System.Collections.Generic.List[string]]::new()", ScForLoop "i" (SeInt 0) (SeRaw "$i -lt $sources.Count") (SeRaw "$i++") s04-loop-body, ScRaw "$inputWriter.Dispose()", ScRaw "if ($testNames.Count -eq 0) { Remove-Item $inputFile -Force -ErrorAction SilentlyContinue; exit 0 }"]

Section: S05 -- Write Input and Launch VM

  s05 : List ShellCmd = [ScTempFile "outputFile", ScTempFile "stderrFile", ScRaw "# -Kernel is what the CALLER decided to grade with. Without it this script read", ScRaw "# build-output\\bare-metal\\Codex.cdx and nothing else, so check-test-compile.ps1", ScRaw "# printed \"kernel: <seed> [digest]\" and then compiled with whatever the last run", ScRaw "# had left there -- a printed claim nothing could contradict (L-FALSIF). On a", ScRaw "# gate whose core RAN the two agree by luck, so it was invisible until a", ScRaw "# core-SKIPPED gate: val, main ~21736, graded with depot seed E0042890 while", ScRaw "# this compiled under BE8B04B5 from an 07:18 run, and three foreword subjects", ScRaw "# went red CDX1073 that a seed copy cleared.", ScRaw "# The default stays build-output because build/test.ps1 stages exactly that file", ScRaw "# on purpose and passes no kernel.", ScAssign "Stage0" (SeRaw "if ($Kernel) { (Resolve-Path $Kernel).Path } else { Join-Path (Split-Path $PSScriptRoot) 'build-output\\bare-metal\\Codex.cdx' }"), ScRaw "if (-not (Test-Path -PathType Leaf $Stage0)) { Write-Error \"MISSING: $Stage0\"; exit 2 }", ScRaw "# Printed from the file actually handed to codex-vm, so the line cannot drift", ScRaw "# from the kernel in use the way the caller's line did.", ScRaw "Write-Host \"batch kernel: $Stage0 [$((Get-FileHash -Algorithm SHA256 $Stage0).Hash.Substring(0,16))]\"", ScBlank, ScRaw "$resolveSw.Stop()", ScRaw "$batchSw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "$startArgs = @{\n    FilePath = $script:CodexVmBin\n    ArgumentList = @('-kernel', $Stage0, '-input', $inputFile, '-output', $outputFile, '-mem', '3072', '-headless')\n    PassThru = $true; RedirectStandardError = $stderrFile\n}", ScComment "-WindowStyle throws on non-Windows editions of pwsh.", ScRaw "if ($IsWindows) { $startArgs.WindowStyle = 'Hidden' }", ScRaw "$proc = Start-Process @startArgs", ScRaw "$proc.WaitForExit(1800000)", ScRaw "if (-not $proc.HasExited) { Stop-VmGraceful -ProcessId $proc.Id }", ScRaw "$batchSw.Stop()", ScRaw "$parseSw = [System.Diagnostics.Stopwatch]::StartNew()"]

Section: S05b -- Read the VM's stderr

 codex-vm reports a short capture on stderr and this script redirected it to
 a temp file that S11 deleted unread, so `stderrFile` had three uses -- create,
 redirect, delete -- and no reader. That is why the loss documented in
 `ExaminersAssay.md` ("The batch stream can lose bytes") has never been
 attributable to a layer.

 It matters more here than in test-run. A dropped blit loses one CONTIGUOUS
 block, and S09 below assigns blocks to test names by sequence with no way to
 notice a missing one, so a single silent drop files every later block under
 the wrong test's name -- which is what was measured at test 178 of batch-0.

 This warns AND invalidates. An exit code would be discarded (`test.ps1`
 launches this script with Start-Process and never reads it), so the drop is
 answered through the one channel test.ps1 does read: S10b below sets every
 member's `.exitcode` to 99, which hands the whole batch to phase 1a's
 re-batch machinery. The warning line still matters -- test.ps1 captures this
 script's stderr into `_batches/*.err`, which is where the loss finally
 becomes attributable to a layer instead of vanishing with a hidden window.

  s05b : List ShellCmd =
    let dropped = [ScWriteError (SeLit "codex-vm dropped guest serial bytes: this batch's capture is SHORT, and every block after the loss is filed under the WRONG test name"), ScWriteError (SeVar "vmErr"), ScRaw "$batchDropped = $true"]
    in [ScRaw "$batchDropped = $false", ScIf (SeFileExists (SeVar "stderrFile")) [ScDotNetCallAssign "vmErr" "System.IO.File" "ReadAllText" [SeVar "stderrFile"], ScIf (SeMatch (SeVar "vmErr") "DROPPED") dropped []] []]

Section: S06 -- Read Output Bytes

 The Latin-1 shadow string is the whole point of this section. A crashed
 batch loses its binary framing, so the remainder of the output is walked as
 lines; a per-byte PowerShell scan turned that into 17 to 23 minutes on a
 single crashed batch. Latin-1 maps chars to bytes one for one, so a
 position in the shadow is a byte position and IndexOf runs natively.

  s06 : List ShellCmd = [ScRaw "# Parse output: text lines interleaved with binary CDX blocks. Newlines and\n# markers are found by native byte scans, not a PowerShell byte loop: when a\n# batch VM dies mid-binary the framing is lost and the remainder of the output\n# is walked as \"lines\", which the per-byte loop turned into 17-23 MINUTES on a\n# crashed batch (census 2026-07-27). [Array]::IndexOf does the skipping\n# natively, so only newline candidates reach PowerShell.\n# A Latin-1 shadow STRING of the whole capture served this until 2026-09-01.\n# It cost 2 bytes per captured byte on top of the byte[], a .NET string being\n# UTF-16: 240 MB of managed heap on a 120 MB capture, per driver, per parallel\n# slot. Byte scanning costs 0.378 s against the shadow's 0.019 s on a full\n# 120 MB pass that finds nothing, so about 1.9 s per driver at worst across\n# the five markers. Memory was the binding constraint, not time.", ScComment "Assigned DIRECTLY, never as `$raw = if (...) { ReadAllBytes } else { ... }`:", ScComment "a statement's result goes through the pipeline, which unrolls a byte[] into", ScComment "an Object[] of boxed bytes, and every GetString/Array.Copy below then", ScComment "re-converts the whole buffer. Measured 2026-08-22: 183 ms per call on a", ScComment "2.9 MB capture, quadratic in the batch (96 tests 130 s, 193 tests 450 s).", ScRaw "$raw = [byte[]]::new(0)", ScRaw "if (Test-Path $outputFile) { $raw = [System.IO.File]::ReadAllBytes($outputFile) }", ScRaw "$pos = 0; $testIdx = 0"]

Section: S07 -- NextLine and SkipBytes Functions

  s07 : List ShellCmd = [ScRaw "function NextLine {\n    if ($script:pos -ge $raw.Length) { return $null }\n    $start = $script:pos\n    $nl = [Array]::IndexOf($raw, [byte]10, $start)\n    $end = if ($nl -lt 0) { $raw.Length } else { $nl }\n    $script:pos = if ($nl -lt 0) { $raw.Length } else { $nl + 1 }\n    $len = $end - $start\n    if ($len -gt 0 -and $raw[$start + $len - 1] -eq 13) { $len-- }\n    if ($len -le 0) { return '' }\n    return [System.Text.Encoding]::UTF8.GetString($raw, $start, $len)\n}", ScBlank, ScRaw "function SkipBytes { param([int]$n); $script:pos = [Math]::Min($script:pos + $n, $raw.Length) }"]

Section: S08 -- Log Span and Marker Search

  s08 : List ShellCmd = [ScRaw "$vmDead = $false", ScRaw "$LogCap = 2000", ScBlank, ScRaw "# Decode a [Start,End) byte span into kept log lines: UTF-8, CR stripped,\n# empty and WD:/HEAP: telemetry dropped, capped. The cap matters on a dead\n# batch, where a span is misframed binary rather than a log.", ScRaw "function Add-LogSpan {\n    param($Lines, [int]$Start, [int]$End)\n    if ($End -le $Start) { return }\n    $text = [System.Text.Encoding]::UTF8.GetString($raw, $Start, $End - $Start)\n    foreach ($l in $text.Split(\"`n\")) {\n        if ($l.EndsWith(\"`r\")) { $l = $l.Substring(0, $l.Length - 1) }\n        if (-not $l) { continue }\n        if ($l.StartsWith('WD:') -or $l.StartsWith('HEAP:')) { continue }\n        if ($Lines.Count -lt $script:LogCap) { $Lines.Add($l) }\n        else { $Lines.Add('(build.log truncated by harness at 2000 lines)'); return }\n    }\n}", ScBlank, ScRaw "# Next newline-preceded occurrence of a marker at or after From, or -1.\n# Ordinal: the default IndexOf(string) is culture-sensitive and an order\n# of magnitude slower over megabytes. The anchored-at-pos case (a marker\n# standing exactly at the current position, e.g. directly after a skipped\n# binary block with no separating newline) is handled by the caller, not\n# here -- position 0 included.", ScRaw "function Test-MarkerAtPos {\n    param([int]$At, [string]$Marker)\n    $mb = [System.Text.Encoding]::ASCII.GetBytes($Marker)\n    if ($At + $mb.Length -gt $raw.Length) { return $false }\n    for ($k = 0; $k -lt $mb.Length; $k++) { if ($raw[$At + $k] -ne $mb[$k]) { return $false } }\n    return $true\n}", ScBlank, ScRaw "function Get-NextMarkerAt {\n    param([string]$Marker, [int]$From)\n    $mb = [System.Text.Encoding]::ASCII.GetBytes($Marker)\n    $ml = $mb.Length\n    $i = [Math]::Max(0, $From - 1)\n    while ($true) {\n        $nl = [Array]::IndexOf($raw, [byte]10, $i)\n        if ($nl -lt 0 -or $nl + 1 + $ml -gt $raw.Length) { return -1 }\n        $ok = $true\n        for ($k = 0; $k -lt $ml; $k++) { if ($raw[$nl + 1 + $k] -ne $mb[$k]) { $ok = $false; break } }\n        if ($ok) { return $nl + 1 }\n        $i = $nl + 1\n    }\n}"]

Section: S09 -- Parse Per-Test Output

 The marker memo is what keeps a crashed batch cheap. Between two markers on
 a dead batch the stream is megabytes of binary, and a per-line walk over it
 burned 865 seconds of host CPU per crash even with fast line-finding. Each
 marker's search is monotonic, so the whole output is scanned once per
 marker for the entire batch rather than once per test.

  s09 : List ShellCmd = [ScRaw "# One native marker search per test instead of a per-line walk. A test's\n# region ends at the next protocol marker standing at a line start: SIZE:\n# (binary follows, success), CODEGEN-HALTED/CODEGEN-ERRORS (diagnostics,\n# exit 7), !EXC (VM death), STACK: (compiler stack report, failure). The\n# lines before the marker are the test's log. On a dead batch the stream\n# between markers is megabytes of binary; IndexOf skips it natively, where\n# the per-line walk (a PowerShell function call per garbage line) burned\n# 865 s of host CPU per crashed batch even with fast line-finding. The\n# memo keeps each marker's search monotonic: one pass over the output per\n# marker for the whole batch, not per test. -2 = not yet searched, -1 =\n# no occurrence remains.", ScRaw "$markerList = @('SIZE:', 'CODEGEN-HALTED', 'CODEGEN-ERRORS', '!EXC', 'STACK:')", ScRaw "$markerMemo = @{}", ScRaw "foreach ($m in $markerList) { $markerMemo[$m] = -2 }", ScBlank, ScRaw "while ($testIdx -lt $testNames.Count -and $pos -lt $raw.Length -and -not $vmDead) {\n    $name = $testNames[$testIdx]\n    $testOut = Join-Path $OutRoot $name\n    $logLines = [System.Collections.Generic.List[string]]::new()\n    $exitCode = '4'\n\n    # A marker standing exactly at $pos wins outright: $pos is always a\n    # logical line start (position 0, after a consumed line, or after a\n    # skipped binary block), and no later occurrence can beat it. The\n    # memoized newline-preceded search cannot see this case, because the\n    # byte before $pos may be the tail of a binary block, not a newline.\n    # Substring + -ceq, NOT [string]::CompareOrdinal(a, i, b, j, len):\n    # PowerShell's binding of that 5-argument static ran at ~2 s per call\n    # (measured 2026-07-27), which put 214 of a 214 s profile in this loop.\n    $mkAt = -1; $mkKind = $null\n    foreach ($m in $markerList) {\n        if (Test-MarkerAtPos $pos $m) { $mkAt = $pos; $mkKind = $m; break }\n    }\n    if ($null -eq $mkKind) {\n        foreach ($m in $markerList) {\n            $at = $markerMemo[$m]\n            if ($at -ne -1 -and $at -lt $pos) {\n                $at = Get-NextMarkerAt $m $pos\n                $markerMemo[$m] = $at\n            }\n            if ($at -ge 0 -and ($mkAt -lt 0 -or $at -lt $mkAt)) { $mkAt = $at; $mkKind = $m }\n        }\n    }\n\n    if ($null -eq $mkKind) {\n        # Stream ended with no terminator for this test: keep what there is.\n        Add-LogSpan $logLines $pos $raw.Length\n        $pos = $raw.Length\n    } else {\n        Add-LogSpan $logLines $pos $mkAt\n        $pos = $mkAt\n        $line = NextLine\n        if ($mkKind -eq 'SIZE:') {\n            $binSize = 0\n            if ($line.Substring(5) -match '^\\d+') { $binSize = [int]$matches[0] }\n            if ($binSize -gt 0 -and $pos + $binSize -le $raw.Length) {\n                $binBytes = New-Object byte[] $binSize\n                [Array]::Copy($raw, $pos, $binBytes, 0, $binSize)\n                [System.IO.File]::WriteAllBytes((Join-Path $testOut \"$name.cdx\"), $binBytes)\n                SkipBytes $binSize\n                $exitCode = '0'\n            }\n        }\n        elseif ($mkKind -eq 'CODEGEN-HALTED' -or $mkKind -eq 'CODEGEN-ERRORS') {\n            $logLines.Add($line)\n            $close = Get-NextMarkerAt 'CODEGEN-HALTED' $pos\n            $markerMemo['CODEGEN-HALTED'] = $close\n            if ($close -ge 0) {\n                Add-LogSpan $logLines $pos $close\n                $pos = $close\n                $logLines.Add((NextLine))\n            } else {\n                Add-LogSpan $logLines $pos $raw.Length\n                $pos = $raw.Length\n            }\n            $exitCode = '7'\n        }\n        elseif ($mkKind -eq '!EXC') {\n            # The VM is gone. Keep the dump on the test that crashed -- the\n            # register/stack lines are its diagnostic, not the next test's\n            # output -- and stop attributing anything after it. The dump is\n            # under a hundred lines; 64 KB bounds it comfortably.\n            $logLines.Add($line)\n            Add-LogSpan $logLines $pos ([Math]::Min($pos + 65536, $raw.Length))\n            $exitCode = '4'; $vmDead = $true\n        }\n        # STACK: needs nothing more: the marker line is consumed and dropped,\n        # the log span before it is kept, and the exit stays 4.\n    }\n\n    $mapped = [System.Collections.Generic.List[string]]::new($logLines.Count)\n    foreach ($l in $logLines) { $mapped.Add((Convert-DiagLine -Line $l -Regions $regionsByName[$name])) }\n    [System.IO.File]::WriteAllLines((Join-Path $testOut 'build.log'), $mapped, [System.Text.UTF8Encoding]::new($false))\n    $exitCode | Set-Content -Path (Join-Path $testOut '.exitcode') -Encoding UTF8\n    $testIdx++\n}", ScBlank, ScRaw "$shortStream = ($testIdx -lt $testNames.Count) -and -not $vmDead"]

Section: S10 -- Backfill Unreached Tests

  s10 : List ShellCmd = [ScRaw "while ($testIdx -lt $testNames.Count) {\n    $name = $testNames[$testIdx]; $testOut = Join-Path $OutRoot $name\n    New-Item -ItemType Directory -Force -Path $testOut | Out-Null\n    \"99\" | Set-Content -Path (Join-Path $testOut '.exitcode') -Encoding UTF8\n    \"FAIL: VM died before this test\" | Set-Content -Path (Join-Path $testOut 'build.log') -Encoding UTF8\n    $testIdx++\n}"]

Section: S10b -- Invalidate an Unattributable Batch

 Attribution in S09 is positional: block N goes to name N, and nothing on
 the wire says which test a block belongs to. A lost block therefore files
 every later block under the wrong name, and the loss is visible only as
 the dropped-bytes report or as a stream that ends short of its test
 count. Measured twice: `ExaminersAssay.md` "The batch stream can lose
 bytes" (2026-08-16, batch-0 test 178, three shifted binaries under
 foreign names), and the Update 52 battery (2026-08-27, 26 false
 FAIL_OUTPUT reds confined to two death-batches, each actual another
 test's output whole). Both times the shifted members held exit 0 and were
 KEPT while only the tail's 99s were re-batched, so the false reds reached
 the rollup and one cost a release run.

 So either signal invalidates the WHOLE batch: 99 on every member hands
 all of them to phase 1a, where a clean session either reproduces each
 result or clears it. A crash (`!EXC`) without a drop keeps the current
 attribution -- the framing is intact up to the dump, and the crasher's
 standalone confirm depends on its exit staying 4.

  s10b : List ShellCmd = [ScRaw "if ($batchDropped -or $shortStream) {\n    $why = if ($batchDropped) { 'codex-vm dropped serial bytes' } else { 'the output stream ended before every test had a block' }\n    [Console]::Error.WriteLine(\"BATCH INVALIDATED: $why -- positional attribution cannot be trusted; all $($testNames.Count) members set to exit 99 for re-batch\")\n    foreach ($name in $testNames) {\n        $testOut = Join-Path $OutRoot $name\n        \"99\" | Set-Content -Path (Join-Path $testOut '.exitcode') -Encoding UTF8\n        Add-Content -Path (Join-Path $testOut 'build.log') -Value \"BATCH INVALIDATED: $why -- re-batched\" -Encoding UTF8\n    }\n}"]

Section: S11 -- Cleanup

  s11 : List ShellCmd = [ScRaw "$parseSw.Stop()", ScRaw "Remove-Item -Force $inputFile, $outputFile, $stderrFile -ErrorAction SilentlyContinue", ScRaw "Write-SweepLog \"batch-done pcore=$PCore compiled=$($sources.Count) resolvems=$($resolveSw.ElapsedMilliseconds) vmms=$($batchSw.ElapsedMilliseconds) parsems=$($parseSw.ElapsedMilliseconds)\""]

Section: Assembly

  batch-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s05b, ScBlank, ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08, ScBlank, ScSequence s09, ScBlank, ScSequence s10, ScBlank, ScSequence s10b, ScBlank, ScSequence s11]

  batch-script : ShellScript = sh-script "test-compile-batch" "Batch compiler -- boots one VM in REPL mode and feeds all test sources sequentially. One VM boot for the entire batch" batch-params batch-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell batch-script)
  end

