Chapter: RunWithDiskScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  rwd-params : List ShellParam = [sh-param "Kernel" SptString, sh-param "Disk" SptString, sh-param-default "OutFile" SptString (SeLit ""), sh-param-default "TimeoutSec" SptInt (SeInt 30), sh-param-default "PCore" SptInt (SeInt 1)]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRunDot (SeRaw "(Join-Path $PSScriptRoot 'vm-config.ps1')")]

Section: S02 -- Start VM with disk

  s02 : List ShellCmd =
    let fail-start = [ScWriteError (SeLit "FAIL: VM did not start with disk"), ScExit (SeInt 1)]
    in [ScRaw "$run = Start-VmRun -Kernel $Kernel -ConnectTimeoutSec 30 -MemMB 3072 -PCore $PCore -ExtraArgs @('-drive', \"file=$Disk,format=raw,if=ide,index=0\")", ScIf (SeNot (SeVar "run")) fail-start []]

Section: S03 -- Wait for READY

  s03 : List ShellCmd =
    let fail-ready = [ScWriteError (SeLit "FAIL: READY not received"), ScExit (SeInt 1)]
    in [ScIf (SeNot (SeRaw "Read-VmReady -Conn $run.Conn -TimeoutSec 30")) fail-ready []]

Section: S04 -- Read lines from stream

  s04 : List ShellCmd = [ScRaw "$stream = $run.Conn.Data.GetStream()", ScDotNetCallAssign "lines" "System.Collections.Generic.List[string]" "new" [], ScRaw "$deadline = (Get-Date).AddSeconds($TimeoutSec)", ScLabeledWhile "read_loop" (SeRaw "(Get-Date) -lt $deadline") [ScRaw "$remaining = [int][math]::Max(1, ($deadline - (Get-Date)).TotalSeconds)", ScRaw "$line = Read-StreamLine -Stream $stream -TimeoutSec $remaining", ScIf (SeRaw "$null -eq $line") [ScBreak] [], ScIf (SeOr (SeStartsWith (SeVar "line") (SeLit "HEAP:")) (SeStartsWith (SeVar "line") (SeLit "STACK:"))) [ScBreak] [], ScIf (SeStartsWith (SeVar "line") (SeLit "WD:")) [ScWriteError (SeRaw "\">>> $line\"")] [ScRaw "[void]$lines.Add($line)"]]]

Section: S05 -- Write output

  s05 : List ShellCmd = [ScRaw "$text = if ($lines.Count -gt 0) { ($lines -join \"`n\") + \"`n\" } else { '' }", ScIf (SeVar "OutFile") [ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "OutFile", SeVar "text", SeRaw "[System.Text.UTF8Encoding]::new($false)"]] [ScRaw "[Console]::Out.Write($text)"], ScExit (SeInt 0)]

Section: S06 -- Cleanup

  s06 : List ShellCmd = [ScRaw "Close-Vm -Conn $run.Conn -Process $run.Process", ScRaw "Remove-Item -Force $run.StdoutFile, $run.StderrFile -ErrorAction SilentlyContinue"]

Section: Assembly

  rwd-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScTry [ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05] [] s06]

  rwd-script : ShellScript = sh-script "run-with-disk" "Run a bare-metal CDX/ELF kernel with an IDE disk image attached" rwd-params rwd-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell rwd-script)
  end

