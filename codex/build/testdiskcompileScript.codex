Chapter: TestDiskCompileScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  tdc-params : List ShellParam =
    [ sh-param-default "DiskPath" SptString (SeLit "")
    , sh-param-default "SampleSrc" SptString (SeLit "codex\\test\\field-range-proven.codex")
    , sh-param-default "Expected" SptString (SeLit "12")
    , sh-param-default "PCore" SptInt (SeInt 1)
    , sh-param-default "Kernel" SptString (SeLit "")
    ]

Section: S01 -- Preamble

  s01-body : List ShellCmd =
    [ ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1"))
    , ScBlank
    , ScComment "The 8.3 name codex/plugs/img/run.ps1 folds a source to, so this test names"
    , ScComment "the file the image actually carries whatever SampleSrc is."
    , ScIf (SeBare (SeNot (SeVar "DiskPath"))) disk-path-8dot3 []
    , ScBlank
    , ScAssign "root" (SeBare (SePathParent SeScriptRoot))
    , ScComment "The compiler under test, at both the host compile and the DISK guest:"
    , ScComment "build-output\\bare-metal holds whichever compiler ran last."
    , ScIf (SeNot (SeVar "Kernel")) [ScAssign "Kernel" (SePathJoin (SeVar "root") (SeLit "seed\\Codex.cdx"))] []
    , ScAssign "outDir" (SeBare (SePathJoinN [SeVar "root", SeLit "build-output\\disk-compile-test"]))
    , ScIf (SeNot (SeDirExists (SeVar "outDir"))) [ScMkdir (SeVar "outDir")] []
    , ScAssign "compile" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "compile.ps1"]))
    , ScAssign "runScript" (SeBare (SePathJoinN [SeVar "PSScriptRoot", SeLit "test-run.ps1"]))
    , ScEchoStyled (SeLit "=== DISK compile test ===") ClBrightCyan True
    ]

  disk-path-8dot3 : List ShellCmd =
    [ ScRaw "$n83 = ([System.IO.Path]::GetFileNameWithoutExtension($SampleSrc)).ToUpperInvariant() -replace '[^A-Z0-9_\\-]', '_'"
    , ScRaw "$e83 = ([System.IO.Path]::GetExtension($SampleSrc).TrimStart('.')).ToUpperInvariant() -replace '[^A-Z0-9_\\-]', '_'"
    , ScRaw "if ($n83.Length -gt 8) { $n83 = $n83.Substring(0, 8) }"
    , ScRaw "if ($e83.Length -gt 3) { $e83 = $e83.Substring(0, 3) }"
    , ScRaw "$DiskPath = if ($e83) { \"$n83.$e83\" } else { $n83 }"
    ]

Section: S01b -- FAT16 extraction helper

 FAT16 is not our format, so the offsets are the spec's: BPB bytes-per-sector
 at 11, sectors-per-cluster at 13, reserved at 14, FAT count at 16, root
 entries at 17, sectors-per-FAT at 22, and the 0x55AA signature at 510. A
 directory entry is 32 bytes, first byte 0xE5 meaning deleted and attribute
 0x0F at offset 11 meaning a long-name fragment; cluster is at 26 and size at
 28. A chain ends at or above 0xFFF8. The partition is at LBA 2048, which the
 signature check refuses loudly rather than guessing at.

  s01b-body : List ShellCmd =
    [ ScBlank
    , ScRaw "function Read-Exact {\n    param($Stream, [byte[]]$Buffer, [int]$Offset, [int]$Length)\n    $n = 0\n    while ($n -lt $Length) {\n        $r = $Stream.Read($Buffer, ($Offset + $n), ($Length - $n))\n        if ($r -le 0) { break }\n        $n += $r\n    }\n    return $n\n}\n\n\nfunction Export-Fat16File {\n    param([string]$Image, [string]$Name, [string]$Out)\n    # Stop-VmGraceful's Stop-Process returns before the guest's handles are\n    # gone, so a plain OpenRead here loses a race that reads on the verdict\n    # line exactly like a DISK-mode failure. Retry, then say which it was.\n    $fs = $null\n    for ($try = 0; ($try -lt 40) -and ($null -eq $fs); $try++) {\n        try { $fs = [System.IO.File]::OpenRead($Image) } catch { Start-Sleep -Milliseconds 250 }\n    }\n    if ($null -eq $fs) { throw \"FAT16: $Image was still held 10s after the VM closed; the guest did not release it\" }\n    try {\n        $bpb = New-Object byte[] 512\n        $fs.Seek((2048 * 512), 'Begin') | Out-Null\n        if ((Read-Exact -Stream $fs -Buffer $bpb -Offset 0 -Length 512) -ne 512) { throw 'FAT16: cannot read the BPB at LBA 2048' }\n        if (($bpb[510] -ne 85) -or ($bpb[511] -ne 170)) { throw 'FAT16: no boot signature at LBA 2048' }\n        $bps = [BitConverter]::ToUInt16($bpb, 11)\n        $spc = $bpb[13]\n        $rsvd = [BitConverter]::ToUInt16($bpb, 14)\n        $nfat = $bpb[16]\n        $rent = [BitConverter]::ToUInt16($bpb, 17)\n        $spf = [BitConverter]::ToUInt16($bpb, 22)\n        if (($bps -le 0) -or ($spc -le 0) -or ($spf -le 0) -or ($nfat -le 0)) { throw \"FAT16: implausible BPB bps=$bps spc=$spc spf=$spf nfat=$nfat\" }\n        $fatSec = 2048 + $rsvd\n        $rootSec = $fatSec + ($nfat * $spf)\n        $rootSecs = [int][Math]::Ceiling(($rent * 32) / $bps)\n        $dataSec = $rootSec + $rootSecs\n        $rd = New-Object byte[] ($rootSecs * $bps)\n        $fs.Seek(($rootSec * $bps), 'Begin') | Out-Null\n        if ((Read-Exact -Stream $fs -Buffer $rd -Offset 0 -Length $rd.Length) -ne $rd.Length) { throw 'FAT16: short read of the root directory' }\n        $clus = 0\n        $size = 0\n        for ($e = 0; $e -lt $rent; $e++) {\n            $o = $e * 32\n            if ($rd[$o] -eq 0) { break }\n            if (($rd[$o] -eq 229) -or ($rd[$o + 11] -eq 15)) { continue }\n            if ([System.Text.Encoding]::ASCII.GetString($rd, $o, 11) -eq $Name) {\n                $clus = [BitConverter]::ToUInt16($rd, $o + 26)\n                $size = [BitConverter]::ToUInt32($rd, $o + 28)\n                break\n            }\n        }\n        if ($clus -lt 2) { throw \"FAT16: $Name is not in the root directory\" }\n        $fat = New-Object byte[] ($spf * $bps)\n        $fs.Seek(($fatSec * $bps), 'Begin') | Out-Null\n        if ((Read-Exact -Stream $fs -Buffer $fat -Offset 0 -Length $fat.Length) -ne $fat.Length) { throw 'FAT16: short read of the FAT' }\n        $bytes = New-Object byte[] $size\n        $got = 0\n        $cl = $clus\n        while ((($got -lt $size) -and ($cl -ge 2)) -and ($cl -lt 65528)) {\n            $take = [Math]::Min(($spc * $bps), ($size - $got))\n            $fs.Seek((($dataSec + ($cl - 2) * $spc) * $bps), 'Begin') | Out-Null\n            if ((Read-Exact -Stream $fs -Buffer $bytes -Offset $got -Length $take) -ne $take) { throw \"FAT16: short read in $Name at cluster $cl\" }\n            $got += $take\n            $cl = [BitConverter]::ToUInt16($fat, $cl * 2)\n        }\n        if ($got -ne $size) { throw \"FAT16: $Name chain yielded $got of $size bytes\" }\n        [System.IO.File]::WriteAllBytes($Out, $bytes)\n        return $size\n    } finally {\n        $fs.Close()\n    }\n}"
    ]

Section: S02 -- Step 1a: Compile source to CDX

  s02-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 1a: Compile source to CDX...")
    , ScAssign "imgOut" (SeBare (SePathJoinN [SeVar "outDir", SeLit "disk-test.img"]))
    , ScAssign "cdxOut" (SeBare (SePathJoinN [SeVar "outDir", SeLit "disk-test.cdx"]))
    , ScAssign "cdxLog" (SeBare (SePathJoinN [SeVar "outDir", SeLit "cdx-build.log"]))
    , ScRaw "& pwsh -NoProfile -File $compile -Src $SampleSrc -Out $cdxOut -Log $cdxLog -PCore $PCore -Kernel $Kernel"
    , ScIf (failed-or-missing "cdxOut") cdx-failed []
    ]

  failed-or-missing : Text -> ShellExpr
  failed-or-missing (out) = SeOr (SeBare (SeStringNeq SeLastExit (SeInt 0))) (SeNot (SeFileExists (SeVar out)))

  cdx-failed : List ShellCmd =
    [ ScEchoStyled (SeLit "FAIL: CDX compile failed") ClBrightRed True
    , ScIf (SeFileExists (SeVar "cdxLog")) [ScRaw "Get-Content $cdxLog | Write-Host"] []
    , ScExit (SeInt 1)
    ]

Section: S03 -- Step 1b: CDX to PE via plug

  s03-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 1b: CDX -> PE via plug...")
    , ScAssign "peOut" (SeBare (SePathJoinN [SeVar "outDir", SeLit "disk-test.efi"]))
    , ScAssign "pePlug" (SeBare (SePathJoinN [SeVar "root", SeLit "codex\\plugs\\pe\\run.ps1"]))
    , ScRaw "& pwsh -NoProfile -File $pePlug -CdxInput $cdxOut -Out $peOut"
    , ScIf (failed-or-missing "peOut") [ScEcho (SeLit "FAIL: PE plug failed"), ScExit (SeInt 1)] []
    ]

Section: S04 -- Step 1c: PE + CDX to FAT16 IMG via plug

  s04-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 1c: PE + CDX -> FAT16 IMG via plug...")
    , ScAssign "imgPlug" (SeBare (SePathJoinN [SeVar "root", SeLit "codex\\plugs\\img\\run.ps1"]))
    , ScRaw "& pwsh -NoProfile -File $imgPlug -PeInput $peOut -CdxInput $cdxOut -Out $imgOut -Fat16 -Source $SampleSrc"
    , ScIf (failed-or-missing "imgOut") [ScEcho (SeLit "FAIL: IMG plug failed"), ScExit (SeInt 1)] []
    , ScEcho (SeText "  IMG: $((Get-Item $imgOut).Length) bytes")
    ]

Section: S05 -- Step 2: Boot compiler with IMG as IDE disk

  s05-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 2: DISK compile...")
    , ScAssign "Stage0" (SeVar "Kernel")
    , ScIf (SeNot (SeFileExists (SeVar "Stage0"))) [ScEcho (SeText "FAIL: no compiler CDX at $Stage0"), ScExit (SeInt 1)] []
    , ScAssign "diskArgs" (SeArrayLiteral [SeLit "-drive", SeText "file=$imgOut,format=raw,if=ide,index=0"])
    , ScAssign "run" (SeBare (SeCallArgs "Start-VmRun" start-vm-args))
    , ScIf (SeNot (SeVar "run")) [ScEcho (SeLit "FAIL: VM did not start"), ScExit (SeInt 1)] []
    , ScBlank
    ]

  start-vm-args : List ShellArg =
    [ SaNamed "Kernel" (SeVar "Stage0")
    , SaNamed "ConnectTimeoutSec" (SeInt 10)
    , SaNamed "MemMB" (SeInt 3072)
    , SaNamed "PCore" (SeVar "PCore")
    , SaNamed "ExtraArgs" (SeVar "diskArgs")
    ]

Section: S05b -- Inside the VM's lifetime

  s05b-body : List ShellCmd =
    [ ScIf (SeNot (SeCallArgs "Read-VmReady" [SaNamed "Conn" (SeProperty (SeVar "run") "Conn"), SaNamed "TimeoutSec" (SeInt 30)])) [ScEcho (SeLit "FAIL: no READY"), ScExit (SeInt 1)] []
    ]

Section: S06 -- Send DISK mode commands and read response

  s06-body : List ShellCmd =
    [ ScBlank
    , ScAssign "stream" (SeMethodCall (SeProperty (SeProperty (SeVar "run") "Conn") "Data") "GetStream" [])
    , ScRaw "$hdr = [System.Text.Encoding]::UTF8.GetBytes(\"DISK`n\")"
    , ScCallMethod (SeVar "stream") "Write" [SeVar "hdr", SeInt 0, SeProperty (SeVar "hdr") "Length"]
    , ScRaw "$path = [System.Text.Encoding]::UTF8.GetBytes($DiskPath + \"`n\")"
    , ScCallMethod (SeVar "stream") "Write" [SeVar "path", SeInt 0, SeProperty (SeVar "path") "Length"]
    , ScCallMethod (SeVar "stream") "Flush" []
    , ScAssign "binSize" (SeInt 0)
    , ScAssign "status" (SeLit "")
    , ScAssign "logLines" (SeArrayLiteral [])
    ]

Section: S07 -- Read lines until DISK-OUT: or CODEGEN-HALTED

  s07-body : List ShellCmd =
    [ ScBlank
    , ScLabeledWhile "read_loop" (SeBool True) read-one-line
    ]

  read-one-line : List ShellCmd =
    [ ScAssign "line" (SeBare (SeCallArgs "Read-StreamLine" [SaNamed "Stream" (SeVar "stream"), SaNamed "TimeoutSec" (SeInt 120)]))
    , ScIf (SeBare (SeStringEq (SeVar "null") (SeVar "line"))) [ScBreak] []
    , ScAppend "logLines" (SeVar "line")
    , ScIf (SeStartsWith (SeVar "line") (SeLit "SIZE:")) on-size []
    , ScIf (SeStartsWith (SeVar "line") (SeLit "DISK-OUT:")) [ScAssign "status" (SeLit "disk-out"), ScBreak] []
    , ScIf (SeStartsWith (SeVar "line") (SeLit "CODEGEN-HALTED")) [ScAssign "status" (SeLit "error"), ScBreak] []
    , ScIf (SeStartsWith (SeVar "line") (SeLit "CODEGEN-ERRORS")) [ScAssign "status" (SeLit "error")] []
    , ScIf (SeBare (SeIntGe (SeProperty (SeVar "logLines") "Count") (SeInt 400))) [ScBreak] []
    ]

  on-size : List ShellCmd =
    [ ScIf (SeMatch (SeVar "line") "^\\D*(\\d+)") [ScAssign "binSize" (SeCast "int" (SeIndex (SeVar "matches") (SeInt 1)))] []
    , ScAssign "status" (SeLit "size")
    ]

Section: S08 -- Validate the compile

  s08-body : List ShellCmd =
    [ ScBlank
    , ScIf (SeOr (SeStringNeq (SeVar "status") (SeLit "disk-out")) (SeBare (SeIntLe (SeVar "binSize") (SeInt 0)))) disk-compile-failed []
    , ScEcho (SeText "  Compiled: $binSize bytes")
    , ScForEach "ll" (SeVar "logLines") [ScIf (SeStartsWith (SeVar "ll") (SeLit "DISK-OUT:")) [ScEcho (SeText "  $ll")] []]
    ]

  disk-compile-failed : List ShellCmd =
    [ ScEchoStyled (SeText "FAIL: DISK compile failed (status=$status)") ClBrightRed True
    , ScForEach "ll" (SeVar "logLines") [ScEcho (SeText "  $ll")]
    , ScExit (SeInt 1)
    ]

Section: S09 -- Cleanup VM

  s09-body : List ShellCmd = [ScRaw "Close-Vm -Conn $run.Conn -Process $run.Process"]

Section: S08b -- Step 2b: Extract OUT.CDX from the image

  s08b-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 2b: Extract OUT.CDX from the image...")
    , ScAssign "cdxOut" (SeBare (SePathJoinN [SeVar "outDir", SeLit "disk-compiled.cdx"]))
    , ScAssign "extracted" (SeBare (SeCallArgs "Export-Fat16File" [SaNamed "Image" (SeVar "imgOut"), SaNamed "Name" (SeLit "OUT     CDX"), SaNamed "Out" (SeVar "cdxOut")]))
    , ScIf (SeBare (SeStringNeq (SeVar "extracted") (SeVar "binSize"))) [ScEchoStyled (SeText "FAIL: OUT.CDX is $extracted bytes, the guest declared $binSize") ClBrightRed True, ScExit (SeInt 1)] []
    , ScEcho (SeText "  Written: $cdxOut ($extracted bytes)")
    ]

Section: S10 -- Step 3: Boot compiled CDX and check output

  s10-body : List ShellCmd =
    [ ScBlank
    , ScEcho (SeLit "Step 3: Run compiled CDX...")
    , ScAssign "actual" (SeBare (SePathJoinN [SeVar "outDir", SeLit "runtime.actual"]))
    , ScRaw "& pwsh -NoProfile -File $runScript -Kernel $cdxOut -OutFile $actual -PCore $PCore"
    , ScIf (SeBare (SeStringNeq SeLastExit (SeInt 0))) [ScEcho (SeLit "FAIL: runtime failed"), ScExit (SeInt 1)] []
    , ScRaw "$output = if (Test-Path $actual) { (Get-Content -Raw $actual).TrimEnd() } else { '' }"
    , ScEcho (SeText "  Output: '$output'")
    , ScEcho (SeText "  Expected: '$Expected'")
    , ScIf (SeStringEq (SeVar "output") (SeVar "Expected")) [ScEchoStyled (SeLit "PASS: DISK compile mode works") ClBrightGreen True] [ScEchoStyled (SeLit "FAIL: output mismatch") ClBrightRed True, ScExit (SeInt 1)]
    ]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "strict mode, the repository root and the paths", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s01b : PipeStage = PipeStage { ps-name = "the FAT export helper", ps-why = "defines Export-FatFile, which the later stages call to read a file back off the disk image", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01b-body }

  s02 : PipeStage = PipeStage { ps-name = "the subject list", ps-why = "names the sources to be compiled from the disk", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the CDX under test could not be built"], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "build the disk image", ps-why = "writes the subjects into a FAT image, because this harness compiles from the DISK rather than over the wire", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the PE could not be built from the CDX"], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "the guest command line", ps-why = "assembles the codex-vm arguments with the image attached", ps-in = ["Kernel"], ps-out = [], ps-needs = [PrKernel (SeVar "Kernel")], ps-verdict = [PoExit 1 "the disk image could not be built"], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "boot the guest", ps-why = "starts the guest and refuses when it does not come up, before the exchange below is attempted", ps-in = [], ps-out = [], ps-needs = [PrGuests 1], ps-verdict = [PoExit 1 "stage0 is absent, or the guest did not come up"], ps-body = s05-body }

  s05b : PipeStage = PipeStage { ps-name = "open the connection", ps-why = "takes the guest's stream for the exchange", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "the guest never reported ready on its connection"], ps-body = s05b-body }

  s06 : PipeStage = PipeStage { ps-name = "drive the compiles", ps-why = "asks the guest to compile each subject from the attached disk", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s06-body }

  s07 : PipeStage = PipeStage { ps-name = "read the results", ps-why = "reads what the guest reported for each subject", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s07-body }

  s08 : PipeStage = PipeStage { ps-name = "export the artifacts", ps-why = "reads the produced binaries back off the image through Export-FatFile", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "a subject failed to compile from the attached disk"], ps-body = s08-body }

  s09 : PipeStage = PipeStage { ps-name = "cleanup", ps-why = "closes the guest and its connection HOWEVER the four stages above ended, which is why it is the group's handler", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s09-body }

  s08b : PipeStage = PipeStage { ps-name = "compare the artifacts", ps-why = "runs AFTER the guest is gone, comparing what the disk compile produced against the reference, which is why it is a stage after the group and not inside it", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "an exported artifact disagrees in SIZE with the reference"], ps-body = s08b-body }

  s10 : PipeStage = PipeStage { ps-name = "the verdict", ps-why = "reports the per-subject results and sets the exit code", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "a subject did not run, or its output does not match the reference"], ps-body = s10-body }

  tdc-pipe : Pipeline = Pipeline { pl-name = "test-disk-compile", pl-doc = "Test DISK compile mode end-to-end", pl-params = tdc-params, pl-stages = [PsStage s01, PsStage s01b, PsStage s02, PsStage s03, PsStage s04, PsStage s05, PsGroup None None (Just s09) [PsStage s05b, PsStage s06, PsStage s07, PsStage s08], PsStage s08b, PsStage s10] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell tdc-pipe))
  end

Page 1
