Chapter: CheckAppsScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  ca-params : List ShellParam = []

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScComment "Pages not produced by the widget pipeline", ScAssign "Skip" (SeArrayLiteral [])]

Section: S02 -- Invariant Table

  invariant : Text, Text -> ShellField
  invariant (name) (pattern) = SfField name (SeLit pattern)

  s02 : List ShellCmd = [ScComment "name -> regex the page must match", ScAssign "Invariants" (SeOrderedMap [invariant "html-shell" "(?s)^<!(DOCTYPE|doctype) html", invariant "click-dispatch" "_wkOnClick", invariant "state-runtime" "function state_get\\(", invariant "render-loop" "function set_render\\(|_render", invariant "handler-binding" "register_handlers\\(", invariant "theme-css" "function theme_to_css\\(", invariant "audio-runtime" "function play_tone\\(", invariant "input-channel" "register_input_handler|function _wkOnInput|on-input"])]

Section: S03 -- Scan Loop

  app-dir : ShellExpr = SeProperty (SeProperty (SeProperty (SeVar "html") "Directory") "Parent") "FullName"

  page-stem : ShellExpr = SeToLower (SeReplace (SeProperty SeItem "BaseName") "WebPage$|Page$" (SeLit ""))

  s03-pages : ShellExpr = SeAsArray (SePipe (SeListFiles app-dir "*Page.codex" False) [StWhere (SeStringEq page-stem (SeVar "base"))])

  s03-report : List ShellCmd = [ScIf (SeIntGt (SeCount (SeVar "bad")) (SeInt 0)) [ScEchoStyled (SeFormat (SeLit "FAIL {0,-12} {1}") [SeVar "base", SeJoin (SeVar "bad") (SeLit ", ")]) ClBrightRed True, ScIncrement "failed"] [ScEchoStyled (SeFormat (SeLit "ok   {0}") [SeVar "base"]) ClBrightGreen True]]

  s03-endings : List ShellCmd = [ScAssign "lf" (SeCount (SeStaticCall "regex" "Matches" [SeVar "txt", SeNewline])), ScAssign "crlf" (SeCount (SeStaticCall "regex" "Matches" [SeVar "txt", SeCrLf])), ScIf (SeStringNeq (SeVar "lf") (SeVar "crlf")) [ScAppend "bad" (SeLit "crlf-endings")] []]

  s03-inner : List ShellCmd = [ScAssign "base" (SeProperty (SeVar "html") "BaseName"), ScComment "only check artifacts produced by the HTML plug pipeline", ScAssign "pages" s03-pages, ScIf (SeIntEq (SeCount (SeVar "pages")) (SeInt 0)) [ScContinue] [], ScIf (SeContains (SeVar "Skip") (SeVar "base")) [ScContinue] [], ScAssign "txt" (SeStaticCall "System.IO.File" "ReadAllText" [SeProperty (SeVar "html") "FullName"]), ScAssign "bad" (SeArrayLiteral []), ScForEach "k" (SeProperty (SeVar "Invariants") "Keys") [ScIf (SeNot (SeMatchExpr (SeVar "txt") (SeIndex (SeVar "Invariants") (SeVar "k")))) [ScAppend "bad" (SeVar "k")] []], ScSequence s03-endings, ScIncrement "checked", ScSequence s03-report]

  s03 : List ShellCmd = [ScAssign "failed" (SeInt 0), ScAssign "checked" (SeInt 0), ScForEach "html" (SeListGlob (SePathJoin (SeVar "Repo") (SeLit "apps\\*\\web\\*.html"))) s03-inner]

Section: S04 -- Summary

  s04-fail : List ShellCmd = [ScEchoStyled (SeConcat (SeConcat (SeConcat (SeVar "failed") (SeLit " of ")) (SeVar "checked")) (SeLit " pages violate invariants")) ClBrightRed True, ScExit (SeInt 1)]

  s04-pass : List ShellCmd = [ScEchoStyled (SeConcat (SeConcat (SeLit "all ") (SeVar "checked")) (SeLit " pages carry the shared runtime")) ClBrightGreen True]

  s04 : List ShellCmd = [ScEcho (SeLit ""), ScIf (SeIntGt (SeVar "failed") (SeInt 0)) s04-fail s04-pass]

Section: Assembly

  ca-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04]

  ca-script : ShellScript = sh-script "check-apps" "Assert runtime invariants across every generated app page" ca-params ca-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell ca-script)
  end

