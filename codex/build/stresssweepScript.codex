Chapter: StressSweepScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  stress-params : List ShellParam = [sh-param-default "Jobs" SptInt (SeInt 8), sh-switch "Pin", sh-switch "ContinueOnFailure", sh-param-default "LogPath" SptString (SeLit "build-output\\stress-sweep.log"), sh-param-optional "ApprovedBy" SptString]

Section: S01 -- Preamble

  s01-body : List ShellCmd = [ScSetStrictMode, ScSetErrorContinue, ScSetLocation (SePathJoin SeScriptRoot (SeLit ".."))]

Section: S02 -- Setup

  stamp-format : Text = "yyyy-MM-dd HH:mm:ss"

  banner-tail : ShellExpr = SeConcat (SeLit " at ") (SeConcat (SeFormatTime SeNow stamp-format) (SeLit " ==="))

  start-banner : ShellExpr = SeConcat (SeConcat (SeLit "=== stress-sweep start jobs=") (SeVar "Jobs")) banner-tail

  s02-body : List ShellCmd = [ScBlank, ScAssign "sweepScript" (SePathJoin SeScriptRoot (SeLit "test.ps1")), ScMkdir (SePathParent (SeVar "LogPath")), ScSetContent (SeVar "LogPath") start-banner, ScBlank, ScBlank, ScAssign "iter" (SeInt 0)]

Section: S03 -- Iteration Start

  iter-label : ShellExpr = SeConcat (SeConcat (SeLit "[iter ") (SeVar "iter")) (SeLit "] ")

  s03-body : List ShellCmd = [ScIncrement "iter", ScAssign "start" SeNow, ScAddContent (SeVar "LogPath") (SeConcat iter-label (SeConcat (SeLit "start ") (SeFormatTime (SeVar "start") "HH:mm:ss")))]

Section: S04 -- Run Test

  sweep-args : ShellExpr =
    SeArrayLiteral [SeLit "-NoProfile", SeLit "-File", SeVar "sweepScript", SeLit "-Jobs", SeVar "Jobs", SeLit "-ApprovedBy", SeVar "ApprovedBy"]

  s04-try-body : List ShellCmd = [ScAssign "sweepArgs" sweep-args, ScIf (SeVar "Pin") [ScAppend "sweepArgs" (SeLit "-Pin")] [], ScRunCapture (SeLit "pwsh") "sweepArgs" (SeVar "tmp"), ScAssign "exit" SeLastExit, ScAssign "tail" (SeTailJoin (SeVar "tmp") 6 (SeLit " | "))]

  s04-catch : List ShellCmd = [ScAssign "exit" (SeInt (0 - 1)), ScAssign "tail" (SeConcat (SeLit "exception: ") SeErrorText)]

  s04-finally : List ShellCmd = [ScDelete (SeVar "tmp")]

  s04-body : List ShellCmd = [ScBlank, ScTempFile "tmp", ScTry s04-try-body s04-catch s04-finally]

Section: S05 -- Log Result

  dur-part : ShellExpr = SeConcat (SeConcat (SeLit " dur=") (SeVar "dur")) (SeConcat (SeLit "s tail=") (SeVar "tail"))

  result-line : ShellExpr = SeConcat (SeConcat (SeLit "end exit=") (SeVar "exit")) dur-part

  s05-body : List ShellCmd = [ScBlank, ScAssign "dur" (SeElapsedSeconds (SeVar "start")), ScAddContent (SeVar "LogPath") (SeConcat iter-label result-line)]

Section: S06 -- Check Failure

  failed-prefix : ShellExpr = SeConcat (SeLit "FAILED exit=") (SeVar "exit")

  s06-continue-branch : List ShellCmd = [ScAddContent (SeVar "LogPath") (SeConcat iter-label (SeConcat failed-prefix (SeLit " -- continuing (-ContinueOnFailure)")))]

  s06-stop-branch : List ShellCmd = [ScAddContent (SeVar "LogPath") (SeConcat iter-label (SeConcat failed-prefix (SeLit " -- stopping"))), ScExit (SeInt 1)]

  s06-body : List ShellCmd = [ScBlank, ScIf (SeNot (SeIntEq (SeVar "exit") (SeInt 0))) [ScIf (SeVar "ContinueOnFailure") s06-continue-branch s06-stop-branch] []]

Section: Assembly

  s01 : PipeStage = PipeStage { ps-name = "preamble", ps-why = "strict mode, and the working directory the sweep is run from", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s01-body }

  s02 : PipeStage = PipeStage { ps-name = "the sweep target and the log", ps-why = "names test.ps1 as the thing being re-run and opens the log the loop appends to; the iteration counter is zeroed here because it must not be reset once per pass", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s02-body }

  s03 : PipeStage = PipeStage { ps-name = "start one iteration", ps-why = "counts the pass and stamps its start time into the log", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s03-body }

  s04 : PipeStage = PipeStage { ps-name = "run the sweep", ps-why = "runs test.ps1 with the requested job count and captures its output; its own try/finally is inside the stage because it guards one command rather than a span of stages", ps-in = ["Jobs"], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s04-body }

  s05 : PipeStage = PipeStage { ps-name = "record the pass", ps-why = "writes the elapsed time and the exit code of that pass into the log", ps-in = [], ps-out = [], ps-needs = [], ps-verdict = [], ps-body = s05-body }

  s06 : PipeStage = PipeStage { ps-name = "decide whether to continue", ps-why = "a failing pass stops the loop unless -ContinueOnFailure was given, which is the whole point of a stress loop: it runs until something breaks", ps-in = ["ContinueOnFailure"], ps-out = [], ps-needs = [], ps-verdict = [PoExit 1 "a pass failed and -ContinueOnFailure was not given, which is the loop finding what it was run to find"], ps-body = s06-body }

  stress-pipe : Pipeline = Pipeline { pl-name = "stress-sweep", pl-doc = "Stress loop: re-run test.ps1 -Jobs N until killed or test fails", pl-params = stress-params, pl-stages = [PsStage s01, PsStage s02, PsGroup (Just (PrWhileLabeled "stress_loop" (SeBool True))) None None [PsStage s03, PsStage s04, PsStage s05, PsStage s06]] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell stress-pipe))
  end

