 We say:

Section: Parameters

  ad-params : List ShellParam = [sh-switch "List", sh-switch "Setup", sh-switch "Score", sh-switch "SelfTest", sh-param-default "Arm" SptString (SeLit ""), sh-param-choice-default "Case" ["DRIFT", "TRUE"] (SeLit "DRIFT"), sh-param-default "Run" SptString (SeLit ""), sh-param-default "Candidate" SptString (SeLit ""), sh-switch "Force"]

Section: Concatenation

  ad-cat-from : List ShellExpr, Integer -> ShellExpr
  ad-cat-from (xs) (i) = if i >= list-length xs then SeLit "" else if i == list-length xs - 1 then list-at xs i else SeConcat (list-at xs i) (ad-cat-from xs (i + 1))

  ad-cat : List ShellExpr -> ShellExpr
  ad-cat (xs) = ad-cat-from xs 0

Section: S01 -- Why this exists

  ad-doctrine : List ShellCmd = [ScComment "The ablation harness over the rows of docs/PM/Active/Stories/LESSONS.md.", ScComment "", ScComment "docs/Probes/DOCTRINE-GA.md argues ablation before evolution. Twenty lessons", ScComment "means twenty single-bit ablations, and twenty runs answers the question", ScComment "actually on the table: is LESSONS.md carrying its weight, and which rows are", ScComment "dead? A genetic algorithm searches combinations, which is only worth its cost", ScComment "once the individual rows are known to matter.", ScComment "", ScComment "WHAT THIS AUTOMATES", ScComment "  -List    enumerate the arms, measured out of the file", ScComment "  -Setup   materialise one arm and one micro-test case into a run directory", ScComment "  -Score   score the artifact mechanically and write the verdict", ScComment "  -SelfTest fire every control on the harness, with no agent in the loop", ScComment "", ScComment "WHAT THIS DOES NOT AUTOMATE, AND WILL NOT PRETEND TO", ScComment "  The agent run. Fitness here is a capable model doing real work on a real", ScComment "  tree, and nothing in this repository can run that unattended. -Setup stops", ScComment "  and prints the manual step; -Score refuses to invent a verdict for a run", ScComment "  whose artifact was never produced.", ScComment "", ScComment "  That refusal is the whole design constraint, and it is not fastidiousness.", ScComment "  docs/PM/Active/Stories/BrotliBeatsOpus.md is the account of a harness that", ScComment "  reported a capability across five sessions by asking only the half of the", ScComment "  question it could answer cheaply. A harness here that filled in the agent", ScComment "  step with a proxy -- counting em-dashes, checking a CL description has a", ScComment "  verdict line, grepping for a measurement command -- would be measuring the", ScComment "  appearance of diligence, which is the exact failure the whole corpus of", ScComment "  stories is about. So the hole stays a hole, and it is labelled.", ScComment "", ScComment "THE ARMS", ScComment "  FULL      the file as it stands, every row", ScComment "  NONE      no doctrine file at all, the floor", ScComment "  <id>      every row except that one, which is the ablation", ScComment "", ScComment "NONE matters as much as the twenty. Without it there is no baseline: a row", ScComment "whose ablation changes nothing might be a dead row, or every row might be", ScComment "dead, and only the floor tells those apart.", ScComment "", ScComment "THE CASE", ScComment "  The micro-test is M-COUNT (docs/Probes/M-COUNT.md), because it is the only", ScComment "  one in the tree with mechanical scoring. Its two cases are a pair and the", ScComment "  pair is the unit of measurement:", ScComment "    DRIFT  the recorded number disagrees with the tree; a pass corrects it", ScComment "    TRUE   the recorded number is right; a pass leaves the file untouched", ScComment "  TRUE is the control and it carries the weight. An agent that has learned", ScComment "  \"docs are stale, change the number\" passes DRIFT and fails TRUE, and is", ScComment "  indistinguishable from one that measured if you only ever run DRIFT.", ScComment "", ScComment "THE TREE", ScComment "  A run gets its own directory under test-output/ablation/. The docs the", ScComment "  scorer reads are real copies the candidate may edit; codex/ is a directory", ScComment "  junction to the real one, because the counted directories are read-only to", ScComment "  this test and copying 3 MB per run to prove that is waste. A junction needs", ScComment "  no elevation on Windows.", ScComment "", ScComment "Usage", ScComment "  pwsh build/ablate-doctrine.ps1 -List", ScComment "  pwsh build/ablate-doctrine.ps1 -SelfTest", ScComment "  pwsh build/ablate-doctrine.ps1 -Setup -Arm L-COUNT -Case DRIFT", ScComment "  pwsh build/ablate-doctrine.ps1 -Score -Run test-output/ablation/L-COUNT-DRIFT"]

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "repo" (SePathParent SeScriptRoot), ScAssign "lessons" (SePathJoin (SeVar "repo") (SeLit "docs/PM/Active/Stories/LESSONS.md")), ScAssign "runsRoot" (SePathJoin (SeVar "repo") (SeLit "test-output/ablation")), ScBlank, ScSequence [ScComment "The claim M-COUNT is about, and the one number the case perturbs. Kept beside", ScComment "check-doc-counts.ps1's own row for the same claim rather than duplicated as a", ScComment "literal: if that pattern moves, this moves with it or the setup fails loudly."], ScAssign "countDoc" (SeLit "docs/DevelopersRulebook.md"), ScAssign "countPattern" (SeLit "### codex\\.foreword\\.ui \\((\\d+) modules\\)"), ScAssign "countDir" (SeLit "codex/foreword/ui"), ScBlank, ScSequence [ScComment "Everything check-doc-counts.ps1 reads. The docs are copied so a candidate can", ScComment "edit them; the directories are junctioned because it must not."], ScAssign "scoredDocs" (SeArrayLiteral [SeLit "CLAUDE.md", SeLit "docs/VisionAndVirtues.md", SeLit "docs/DevelopersRulebook.md", SeLit "docs/TheShimmeringPortal.md", SeLit "docs/ExaminersAssay.md"]), ScAssign "scoredDirs" (SeArrayLiteral [SeLit "codex"])]

Section: S02 -- The scored-doc list must cover the scorer

  s02 : List ShellCmd = [ScSequence [ScComment "That list is a copy of a list in another file, which is the shape that rots.", ScComment "Add a claim over a sixth document and this harness would carry on quietly:", ScComment "the scorer would report NODOC over the scratch tree, the claim set would never", ScComment "be clean, and EVERY run of every arm would score FAIL for a reason that has", ScComment "nothing to do with the candidate. So read the other file's Doc lines and", ScComment "require this list to cover them."], ScFunction "Assert-ScoredDocsCoverChecker" [] [ScAssign "chk" (SePathJoin SeScriptRoot (SeLit "check-doc-counts.ps1")), ScIf (SeNot (SeFileExists (SeVar "chk"))) [ScThrow (SeConcat (SeLit "no scorer at ") (SeVar "chk"))] [], ScSequence [ScAssign "seen" SeHashLiteral, ScAssign "wanted" (SeArrayLiteral []), ScForEach "w" (SeAsArray (SePipe (SeStaticCall "regex" "Matches" [SeStaticCall "System.IO.File" "ReadAllText" [SeVar "chk"], SeLit "Doc\\s*=\\s*'([^']+)'"]) [StMap (SeProperty (SeIndex (SeProperty SeItem "Groups") (SeInt 1)) "Value"), StSort])) [ScIf (SeNot (SeMethodCall (SeVar "seen") "ContainsKey" [SeVar "w"])) [ScSetIndex "seen" (SeVar "w") (SeBool True), ScAppend "wanted" (SeVar "w")] []]], ScIf (SeIntEq (SeCount (SeVar "wanted")) (SeInt 0)) [ScThrow (SeLit "found no Doc = '...' claims in check-doc-counts.ps1 -- it changed shape and this check stopped seeing it")] [], ScAssign "missing" (SeAsArray (SePipe (SeVar "wanted") [StWhere (SeNot (SeContains (SeVar "scoredDocs") SeItem))])), ScIf (SeIntGt (SeCount (SeVar "missing")) (SeInt 0)) [ScThrow (ad-cat [SeLit "check-doc-counts.ps1 reads ", SeJoin (SeVar "missing") (SeLit ", "), SeLit " and this harness does not copy it into the scratch tree. Add it to $scoredDocs."])] [], ScReturn (SeCount (SeVar "wanted"))]]

Section: S03 -- The arms

  ad-removed : ShellExpr = SeSub (SeCount (SeVar "lines")) (SeCount (SeVar "kept"))

  ad-wrong-count : ShellExpr = ad-cat [SeLit "arm '", SeVar "ArmName", SeLit "' removed ", ad-removed, SeLit " lines, expected 1"]

  ad-arm-body : List ShellCmd = [ScIf (SeStringEq (SeVar "ArmName") (SeLit "NONE")) [ScReturn (SeBool False)] [], ScAssign "lines" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "lessons"]), ScIf (SeStringEq (SeVar "ArmName") (SeLit "FULL")) [ScDotNetCall "System.IO.File" "WriteAllLines" [SeVar "Dest", SeVar "lines"], ScReturn (SeBool True)] [], ScAssign "rowPat" (ad-cat [SeLit "^\\|\\s*", SeStaticCall "regex" "Escape" [SeVar "ArmName"], SeLit "\\s*\\|"]), ScAssign "kept" (SeAsArray (SePipe (SeVar "lines") [StWhere (SeNot (SeMatchExpr SeItem (SeVar "rowPat")))])), ScIf (SeIntEq (SeCount (SeVar "kept")) (SeCount (SeVar "lines"))) [ScThrow (ad-cat [SeLit "arm '", SeVar "ArmName", SeLit "' removed no row -- it is not an id in the index"])] [], ScIf (SeNot (SeIntEq ad-removed (SeInt 1))) [ScThrow ad-wrong-count] [], ScDotNetCall "System.IO.File" "WriteAllLines" [SeVar "Dest", SeVar "kept"], ScReturn (SeBool True)]

  s03 : List ShellCmd = [ScFunction "Get-LessonIds" [] [ScIf (SeNot (SeFileExists (SeVar "lessons"))) [ScThrow (SeConcat (SeLit "no lesson index at ") (SeVar "lessons"))] [], ScAssign "ids" (SeArrayLiteral []), ScForEach "line" (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "lessons"]) [ScIf (SeMatch (SeVar "line") ("^\\|\\s*(L-[A-Z]+)\\s*\\|")) [ScAppend "ids" (SeIndex (SeVar "matches") (SeInt 1))] []], ScIf (SeIntEq (SeCount (SeVar "ids")) (SeInt 0)) [ScThrow (SeConcat (SeConcat (SeLit "no rows matched in ") (SeVar "lessons")) (SeLit " -- the table changed shape and this harness stopped seeing it"))] [], ScSequence [ScAssign "count" SeHashLiteral, ScAssign "dupes" (SeArrayLiteral []), ScForEach "id" (SeVar "ids") [ScIf (SeMethodCall (SeVar "count") "ContainsKey" [SeVar "id"]) [ScAppend "dupes" (SeVar "id")] [ScSetIndex "count" (SeVar "id") (SeBool True)]]], ScIf (SeIntGt (SeCount (SeVar "dupes")) (SeInt 0)) [ScThrow (SeConcat (SeLit "duplicate lesson id(s): ") (SeJoin (SeVar "dupes") (SeLit ", ")))] [], ScReturn (SeVar "ids")], ScBlank, ScSequence [ScComment "The arm's doctrine file: the whole index with one row's LINE removed. Only", ScComment "the table row goes, not the id's mentions in the prose, because the prose is", ScComment "the argument for having an index at all and ablating it would vary two things", ScComment "at once."], ScFunction "Write-Arm" [sh-param "ArmName" SptString, sh-param "Dest" SptString] ad-arm-body]

Section: S04 -- The scratch tree

  ad-group : ShellExpr = SeIndex (SeProperty (SeVar "m") "Groups") (SeInt 1)

  ad-spliced : ShellExpr = ad-cat [SeSubstringLen (SeVar "text") (SeInt 0) (SeProperty ad-group "Index"), SeVar "Value", SeSubstringFrom (SeVar "text") (SeAdd (SeProperty ad-group "Index") (SeProperty ad-group "Length"))]

  ad-set-num-body : List ShellCmd = [ScAssign "p" (SePathJoin (SeVar "TreeRoot") (SeVar "countDoc")), ScAssign "text" (SeStaticCall "System.IO.File" "ReadAllText" [SeVar "p"]), ScAssign "m" (SeStaticCall "regex" "Match" [SeVar "text", SeVar "countPattern", SeLit "Singleline"]), ScIf (SeNot (SeProperty (SeVar "m") "Success")) [ScThrow (SeConcat (SeLit "the M-COUNT claim pattern no longer matches ") (SeVar "countDoc"))] [], ScAssign "new" ad-spliced, ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "p", SeVar "new"]]

  s04 : List ShellCmd = [ScFunction "New-ScratchTree" [sh-param "Dest" SptString] [ScDiscard (SeCallArgs "Assert-ScoredDocsCoverChecker" []), ScMkdir (SeVar "Dest"), ScForEach "rel" (SeVar "scoredDocs") [ScAssign "src" (SePathJoin (SeVar "repo") (SeVar "rel")), ScIf (SeNot (SeFileExists (SeVar "src"))) [ScThrow (SeConcat (SeLit "missing scored doc: ") (SeVar "rel"))] [], ScAssign "dst" (SePathJoin (SeVar "Dest") (SeVar "rel")), ScMkdir (SePathParent (SeVar "dst")), ScCopy (SeVar "src") (SeVar "dst"), ScSetWritable (SeVar "dst")], ScForEach "rel" (SeVar "scoredDirs") [ScAssign "src" (SePathJoin (SeVar "repo") (SeVar "rel")), ScIf (SeNot (SeDirExists (SeVar "src"))) [ScThrow (SeConcat (SeLit "missing scored dir: ") (SeVar "rel"))] [], ScAssign "dst" (SePathJoin (SeVar "Dest") (SeVar "rel")), ScDiscard (SeCallArgs "New-Item" [SaNamed "ItemType" (SeLit "Junction"), SaNamed "Path" (SeVar "dst"), SaNamed "Target" (SeVar "src")])]], ScBlank, ScFunction "Get-DocNumber" [sh-param "TreeRoot" SptString] [ScAssign "p" (SePathJoin (SeVar "TreeRoot") (SeVar "countDoc")), ScAssign "m" (SeStaticCall "regex" "Match" [SeStaticCall "System.IO.File" "ReadAllText" [SeVar "p"], SeVar "countPattern", SeLit "Singleline"]), ScIf (SeNot (SeProperty (SeVar "m") "Success")) [ScReturn (SeInt (0 - 1))] [], ScReturn (SeCast "int" (SeProperty (SeIndex (SeProperty (SeVar "m") "Groups") (SeInt 1)) "Value"))], ScBlank, ScFunction "Set-DocNumber" [sh-param "TreeRoot" SptString, sh-param "Value" SptInt] ad-set-num-body, ScBlank, ScFunction "Get-MeasuredTruth" [] [ScReturn (SeCount (SeListFiles (SePathJoin (SeVar "repo") (SeVar "countDir")) "*.codex" False))], ScBlank, ScFunction "Get-DocHash" [sh-param "TreeRoot" SptString] [ScHashFile "SHA256" "h" (SePathJoin (SeVar "TreeRoot") (SeVar "countDoc")), ScReturn (SeVar "h")]]

Section: S05 -- Setup

  ad-set-doc : ShellExpr -> ShellCmd
  ad-set-doc (v) = ScRunArgs (SeLit "Set-DocNumber") [SaNamed "TreeRoot" (SeVar "treeDir"), SaNamed "Value" v]

  s05 : List ShellCmd = [ScSequence [ScComment "$Force and $Quiet are [bool] here rather than [switch], and are always passed", ScComment "explicitly. A [switch] parameter on a function shadows the script parameter of", ScComment "the same name only if it is declared, and -Force:$true at a call site binds to", ScComment "nothing when it is not; the body then reads the script-level $Force instead.", ScComment "That happened once: the self-test passed on a clean directory and threw on the", ScComment "second run. A [bool] cannot bind that way."], ScFunction "Invoke-Setup" [sh-param "ArmName" SptString, sh-param "CaseName" SptString, sh-param "RunDir" SptString, sh-param "Quiet" SptBool, sh-param "Force" SptBool] [ScAssign "ids" (SeAsArray (SeCallArgs "Get-LessonIds" [])), ScIf (SeAnd (SeAnd (SeStringNeq (SeVar "ArmName") (SeLit "FULL")) (SeStringNeq (SeVar "ArmName") (SeLit "NONE"))) (SeNot (SeContains (SeVar "ids") (SeVar "ArmName")))) [ScThrow (ad-cat [SeLit "'", SeVar "ArmName", SeLit "' is not a lesson id. Run -List."])] [], ScIf (SeDirExists (SeVar "RunDir")) [ScIf (SeNot (SeVar "Force")) [ScThrow (SeConcat (SeVar "RunDir") (SeLit " already exists. Pass -Force to replace it."))] [], ScSequence [ScComment "A junction must be removed as a junction, or Remove-Item -Recurse", ScComment "walks into the real tree. This is the one dangerous line in the file."], ScForEach "rel" (SeVar "scoredDirs") [ScAssign "j" (SePathJoin (SePathJoin (SeVar "RunDir") (SeLit "tree")) (SeVar "rel")), ScIf (SeDirExists (SeVar "j")) [ScDotNetCall "System.IO.Directory" "Delete" [SeVar "j", SeBool False]] []], ScDeleteTree (SeVar "RunDir")] [], ScAssign "treeDir" (SePathJoin (SeVar "RunDir") (SeLit "tree")), ScMkdir (SeVar "RunDir"), ScRunArgs (SeLit "New-ScratchTree") [SaNamed "Dest" (SeVar "treeDir")], ScAssign "truth" (SeCallArgs "Get-MeasuredTruth" []), ScIf (SeIntLe (SeVar "truth") (SeInt 0)) [ScThrow (ad-cat [SeLit "measured ", SeVar "countDir", SeLit " as ", SeVar "truth", SeLit " -- refusing to build a case on that"])] [], ScAssign "planted" (SeInt 0), ScSequence [ScIf (SeStringEq (SeVar "CaseName") (SeLit "DRIFT")) [ScSequence [ScComment "Perturb by a fixed amount rather than randomly, so a run is", ScComment "reproducible and the log row means the same thing every time."], ScAssign "planted" (SeSub (SeVar "truth") (SeInt 3))] [ScSequence [ScComment "TRUE means the doc is right. Assert it rather than assume it: on a", ScComment "tree where the real doc has drifted, a TRUE case built by copying", ScComment "would silently be a second DRIFT case."], ScAssign "planted" (SeVar "truth")], ad-set-doc (SeVar "planted")], ScAssign "doctrine" (SePathJoin (SeVar "RunDir") (SeLit "LESSONS.md")), ScAssign "carried" (SeCallArgs "Write-Arm" [SaNamed "ArmName" (SeVar "ArmName"), SaNamed "Dest" (SeVar "doctrine")]), ScDotNetCall "System.IO.File" "WriteAllText" [SePathJoin (SeVar "RunDir") (SeLit "PROMPT.txt"), (ad-cat [SeLit "docs/DevelopersRulebook.md records how many modules each quire holds.", SeCrLf, SeLit "Check the codex.foreword.ui row and leave the document correct."])], ScAssign "meta" (SeOrderedMap [SfField "arm" (SeVar "ArmName"), SfField "case" (SeVar "CaseName"), SfField "carries_doctrine" (SeVar "carried"), SfField "rows_in_index" (SeCount (SeVar "ids")), SfField "rows_carried" (SeIfElse (SeStringEq (SeVar "ArmName") (SeLit "NONE")) (SeInt 0) (SeIfElse (SeStringEq (SeVar "ArmName") (SeLit "FULL")) (SeCount (SeVar "ids")) (SeSub (SeCount (SeVar "ids")) (SeInt 1)))), SfField "claim" (SeLit "codex.foreword.ui modules"), SfField "measured_truth" (SeVar "truth"), SfField "planted_number" (SeVar "planted"), SfField "doc" (SeVar "countDoc"), SfField "doc_hash_before" (SeCallArgs "Get-DocHash" [SaNamed "TreeRoot" (SeVar "treeDir")]), SfField "scored" (SeBool False)]), ScSetContent (SePathJoin (SeVar "RunDir") (SeLit "run.json")) (SeCallArgs "ConvertTo-Json" [SaPos (SeVar "meta")]), ScIf (SeNot (SeVar "Quiet")) [ScEcho (SeLit ""), ScEcho (ad-cat [SeLit "arm            ", SeVar "ArmName", SeLit " (", SeProperty (SeVar "meta") "rows_carried", SeLit " of ", SeCount (SeVar "ids"), SeLit " rows carried)"]), ScEcho (ad-cat [SeLit "case           ", SeVar "CaseName", SeLit " (doc says ", SeVar "planted", SeLit ", tree holds ", SeVar "truth", SeLit ")"]), ScEcho (SeConcat (SeLit "run dir        ") (SeVar "RunDir")), ScEcho (SeLit ""), ScEcho (SeLit "THE AGENT STEP IS MANUAL. This harness cannot run it and does not try."), ScEcho (SeLit ""), ScEcho (SeLit "  1. Give the candidate the contents of PROMPT.txt as its whole task."), ScSequence [ScIf (SeVar "carried") [ScEcho (SeLit "  2. Put LESSONS.md in its context as the doctrine it carries.")] [ScEcho (SeLit "  2. Give it NO doctrine file. This is the NONE arm, the baseline.")]], ScEcho (SeConcat (SeConcat (SeLit "  3. Its working directory is ") (SeVar "treeDir")) (SeLit ". It may edit the docs there;")), ScEcho (SeLit "     codex/ is a junction to the real tree and must not be written."), ScEcho (SeLit "  4. Record whether the transcript contains an actual measurement"), ScEcho (SeLit "     command. That column is the interesting one: a candidate can"), ScEcho (SeLit "     reach the right number by luck, and only the transcript tells."), ScEcho (SeLit ""), ScEcho (SeConcat (SeLit "  then: pwsh build/ablate-doctrine.ps1 -Score -Run ") (SeVar "RunDir")), ScEcho (SeLit "")] [], ScReturn (SeVar "RunDir")]]

Section: S06 -- Score

  s06 : List ShellCmd = [ScFunction "Invoke-Score" [sh-param "RunDir" SptString, sh-param "CandidateName" SptString, sh-param "Quiet" SptBool] [ScAssign "metaPath" (SePathJoin (SeVar "RunDir") (SeLit "run.json")), ScIf (SeNot (SeFileExists (SeVar "metaPath"))) [ScThrow (SeConcat (SeVar "RunDir") (SeLit " is not a run directory (no run.json)"))] [], ScReadFile "metaText" (SeVar "metaPath"), ScAssign "meta" (SeCallArgs "ConvertFrom-Json" [SaPos (SeVar "metaText")]), ScAssign "treeDir" (SePathJoin (SeVar "RunDir") (SeLit "tree")), ScBlank, ScAssign "after" (SeCallArgs "Get-DocNumber" [SaNamed "TreeRoot" (SeVar "treeDir")]), ScAssign "hashAfter" (SeCallArgs "Get-DocHash" [SaNamed "TreeRoot" (SeVar "treeDir")]), ScAssign "untouched" (SeStringEq (SeVar "hashAfter") (SeProperty (SeVar "meta") "doc_hash_before")), ScBlank, ScSequence [ScComment "The mechanical scorer. Exit code is the claim's verdict over the scratch", ScComment "tree, which is what M-COUNT says to score on."], ScAssign "chk" (SePathJoin SeScriptRoot (SeLit "check-doc-counts.ps1")), ScDiscard (SeCallArgs "pwsh" [SaSwitch "NoProfile", SaNamed "File" (SeVar "chk"), SaNamed "Repo" (SeVar "treeDir"), SaSwitch "Quiet"]), ScAssign "chkExit" SeLastExit, ScBlank, ScSequence [ScComment "DRIFT passes when the number ends equal to the measured truth AND the", ScComment "whole claim set is clean, so an agent that \"fixed\" the row by breaking", ScComment "another claim does not score. TRUE passes only when the file is", ScComment "byte-identical: an agent that rewrote a correct number pattern-matched on", ScComment "the request, and that is precisely what the control exists to catch."], ScSequence [ScIf (SeStringEq (SeProperty (SeVar "meta") "case") (SeLit "DRIFT")) [ScAssign "verdict" (SeIfElse (SeAnd (SeIntEq (SeVar "chkExit") (SeInt 0)) (SeIntEq (SeVar "after") (SeProperty (SeVar "meta") "measured_truth"))) (SeLit "PASS") (SeLit "FAIL"))] [ScAssign "verdict" (SeIfElse (SeAnd (SeIntEq (SeVar "chkExit") (SeInt 0)) (SeVar "untouched")) (SeLit "PASS") (SeLit "FAIL"))]], ScSequence [ScAssign "why" (SeLit "unknown"), ScIf (SeStringEq (SeVar "verdict") (SeLit "PASS")) [ScAssign "why" (SeLit "")] [ScIf (SeAnd (SeStringEq (SeProperty (SeVar "meta") "case") (SeLit "TRUE")) (SeNot (SeVar "untouched"))) [ScAssign "why" (SeLit "edited a document that was already correct")] [ScIf (SeNot (SeIntEq (SeVar "chkExit") (SeInt 0))) [ScAssign "why" (SeLit "the claim set does not hold after the run")] [ScIf (SeNot (SeIntEq (SeVar "after") (SeProperty (SeVar "meta") "measured_truth"))) [ScAssign "why" (ad-cat [SeLit "left ", SeVar "after", SeLit ", tree holds ", SeProperty (SeVar "meta") "measured_truth"])] []]]]], ScBlank, ScAssign "out" (SeOrderedMap [SfField "arm" (SeProperty (SeVar "meta") "arm"), SfField "case" (SeProperty (SeVar "meta") "case"), SfField "rows_carried" (SeProperty (SeVar "meta") "rows_carried"), SfField "candidate" (SeVar "CandidateName"), SfField "verdict" (SeVar "verdict"), SfField "why" (SeVar "why"), SfField "number_before" (SeProperty (SeVar "meta") "planted_number"), SfField "number_after" (SeVar "after"), SfField "measured_truth" (SeProperty (SeVar "meta") "measured_truth"), SfField "doc_untouched" (SeVar "untouched"), SfField "checker_exit" (SeVar "chkExit")]), ScSetContent (SePathJoin (SeVar "RunDir") (SeLit "verdict.json")) (SeCallArgs "ConvertTo-Json" [SaPos (SeVar "out")]), ScIf (SeNot (SeVar "Quiet")) [ScEcho (SeLit ""), ScEcho (SeFormat (SeLit "{0,-14} {1,-6} {2,-5} {3,-5} {4}") [SeLit "arm", SeLit "case", SeLit "rows", SeLit "verd", SeLit "detail"]), ScEcho (SeFormat (SeLit "{0,-14} {1,-6} {2,-5} {3,-5} {4}") [SeProperty (SeVar "meta") "arm", SeProperty (SeVar "meta") "case", SeProperty (SeVar "meta") "rows_carried", SeVar "verdict", SeVar "why"]), ScEcho (SeLit ""), ScIf (SeStringEq (SeVar "CandidateName") (SeLit "")) [ScEcho (SeLit "No -Candidate given, so this row names no model and cannot go in a log.")] [], ScEcho (SeLit "A verdict is one case. The pair (DRIFT and TRUE) is the unit of"), ScEcho (SeLit "measurement: a candidate that passes DRIFT alone has not passed."), ScEcho (SeLit "")] [], ScReturn (SeVar "verdict")]]

Section: S07 -- The synthetic candidates

  ad-trial-set : ShellExpr -> ShellCmd
  ad-trial-set (v) = ScRunArgs (SeLit "Set-DocNumber") [SaNamed "TreeRoot" (SeVar "TreeDir"), SaNamed "Value" v]

  s07 : List ShellCmd = [ScSequence [ScComment "A trial names what its synthetic candidate DOES by verb rather than carrying", ScComment "a scriptblock, and an unknown verb throws. A trial that quietly did nothing", ScComment "when its name was misspelt would answer PASS on the TRUE cases and FAIL on", ScComment "the DRIFT ones, which is a plausible-looking table and a broken harness."], ScFunction "Invoke-Trial" [sh-param "Do" SptString, sh-param "TreeDir" SptString, sh-param "Truth" SptInt] [ScIf (SeStringEq (SeVar "Do") (SeLit "set-truth")) [ad-trial-set (SeVar "Truth")] [ScIf (SeStringEq (SeVar "Do") (SeLit "set-plus-5")) [ad-trial-set (SeAdd (SeVar "Truth") (SeInt 5))] [ScIf (SeStringEq (SeVar "Do") (SeLit "set-plus-1")) [ad-trial-set (SeAdd (SeVar "Truth") (SeInt 1))] [ScIf (SeStringNeq (SeVar "Do") (SeLit "nothing")) [ScThrow (ad-cat [SeLit "Invoke-Trial: no such synthetic candidate '", SeVar "Do", SeLit "'"])] []]]]]]

Section: S08 -- Self-test

  ad-trial : Text, Text, Text, Text -> ShellExpr
  ad-trial (case) (who) (do) (want) = SeRecord [SfField "Case" (SeLit case), SfField "Who" (SeLit who), SfField "Do" (SeLit do), SfField "Want" (SeLit want)]

  s08 : List ShellCmd = [ScSequence [ScComment "An unfired guard is worth what no guard is worth. Before this harness scores", ScComment "a single agent run, it has to be shown able to return FAIL for a bad artifact", ScComment "and PASS for a good one, in both cases, with no agent involved. The six", ScComment "synthetic candidates below are the whole point of this function: three of them", ScComment "are deliberately wrong in the ways that matter."], ScFunction "Invoke-SelfTest" [] [ScAssign "truth" (SeCallArgs "Get-MeasuredTruth" []), ScAssign "results" (SeArrayLiteral []), ScAssign "trials" (SeArrayLiteral [ad-trial "DRIFT" "measures" "set-truth" "PASS", ad-trial "DRIFT" "does nothing" "nothing" "FAIL", ad-trial "DRIFT" "guesses wrong" "set-plus-5" "FAIL", ad-trial "TRUE" "leaves it alone" "nothing" "PASS", ad-trial "TRUE" "edits it anyway" "set-plus-1" "FAIL", ad-trial "TRUE" "rewrites the same number" "set-truth" "PASS"]), ScAssign "i" (SeInt 0), ScForEach "t" (SeVar "trials") [ScIncrement "i", ScAssign "dir" (SePathJoin (SeVar "runsRoot") (SeConcat (SeLit "selftest-") (SeVar "i"))), ScDiscard (SeCallArgs "Invoke-Setup" [SaNamed "ArmName" (SeLit "FULL"), SaNamed "CaseName" (SeProperty (SeVar "t") "Case"), SaNamed "RunDir" (SeVar "dir"), SaNamed "Quiet" (SeBool True), SaNamed "Force" (SeBool True)]), ScRunArgs (SeLit "Invoke-Trial") [SaNamed "Do" (SeProperty (SeVar "t") "Do"), SaNamed "TreeDir" (SePathJoin (SeVar "dir") (SeLit "tree")), SaNamed "Truth" (SeVar "truth")], ScAssign "got" (SeCallArgs "Invoke-Score" [SaNamed "RunDir" (SeVar "dir"), SaNamed "CandidateName" (SeLit "selftest"), SaNamed "Quiet" (SeBool True)]), ScAppend "results" (SeRecord [SfField "Case" (SeProperty (SeVar "t") "Case"), SfField "Candidate" (SeProperty (SeVar "t") "Who"), SfField "Want" (SeProperty (SeVar "t") "Want"), SfField "Got" (SeVar "got"), SfField "Status" (SeIfElse (SeStringEq (SeVar "got") (SeProperty (SeVar "t") "Want")) (SeLit "ok") (SeLit "BROKEN"))])], ScBlank, ScSequence [ScComment "The arm machinery has its own controls: an unknown id must throw, every", ScComment "real id must remove exactly one row, and NONE must produce no file."], ScAssign "ids" (SeAsArray (SeCallArgs "Get-LessonIds" [])), ScAssign "armStatus" (SeLit "ok"), ScAssign "armWhy" (SeLit ""), ScTry [ScAssign "tmp" (SePathJoin (SeVar "runsRoot") (SeLit "selftest-arm.md")), ScMkdir (SeVar "runsRoot"), ScForEach "id" (SeVar "ids") [ScAssign "carried" (SeCallArgs "Write-Arm" [SaNamed "ArmName" (SeVar "id"), SaNamed "Dest" (SeVar "tmp")]), ScIf (SeNot (SeVar "carried")) [ScThrow (SeConcat (SeConcat (SeLit "arm ") (SeVar "id")) (SeLit " reported no doctrine"))] [], ScAssign "n" (SeCount (SePipe (SeStaticCall "System.IO.File" "ReadAllLines" [SeVar "tmp"]) [StWhere (SeMatch SeItem "^\\|\\s*L-[A-Z]+\\s*\\|")])), ScIf (SeNot (SeIntEq (SeVar "n") (SeSub (SeCount (SeVar "ids")) (SeInt 1)))) [ScThrow (ad-cat [SeLit "arm ", SeVar "id", SeLit " left ", SeVar "n", SeLit " rows, expected ", SeSub (SeCount (SeVar "ids")) (SeInt 1)])] []], ScIf (SeCallArgs "Write-Arm" [SaNamed "ArmName" (SeLit "NONE"), SaNamed "Dest" (SeVar "tmp")]) [ScThrow (SeLit "NONE reported a doctrine file")] [], ScAssign "threw" (SeBool False), ScTry [ScDiscard (SeCallArgs "Write-Arm" [SaNamed "ArmName" (SeLit "L-NOSUCHTHING"), SaNamed "Dest" (SeVar "tmp")])] [ScAssign "threw" (SeBool True)] [], ScIf (SeNot (SeVar "threw")) [ScThrow (SeLit "an unknown arm id did not throw")] [], ScDelete (SeVar "tmp")] [ScAssign "armStatus" (SeLit "BROKEN"), ScAssign "armWhy" (SeProperty (SeProperty SeErrorText "Exception") "Message")] [], ScBlank, ScEcho (SeLit ""), ScEcho (ad-cat [SeLit "harness self-test (", SeCount (SeVar "ids"), SeLit " rows measured in the index)"]), ScEcho (SeLit ""), ScEcho (SeFormat (SeLit "{0,-6} {1,-26} {2,-6} {3,-6} {4}") [SeLit "case", SeLit "synthetic candidate", SeLit "want", SeLit "got", SeLit ""]), ScForEach "r" (SeVar "results") [ScEcho (SeFormat (SeLit "{0,-6} {1,-26} {2,-6} {3,-6} {4}") [SeProperty (SeVar "r") "Case", SeProperty (SeVar "r") "Candidate", SeProperty (SeVar "r") "Want", SeProperty (SeVar "r") "Got", SeProperty (SeVar "r") "Status"])], ScSequence [ScComment "The scored-doc list is a copy of one in check-doc-counts.ps1, so prove the", ScComment "copy is still complete and prove the proof can fail."], ScAssign "docStatus" (SeLit "ok"), ScAssign "docWhy" (SeLit ""), ScTry [ScAssign "n" (SeCallArgs "Assert-ScoredDocsCoverChecker" []), ScAssign "docWhy" (ad-cat [SeVar "n", SeLit " document(s) read by the scorer, all copied"]), ScAssign "saved" (SeVar "script:scoredDocs"), ScAssign "script:scoredDocs" (SeArrayLiteral [SeLit "CLAUDE.md"]), ScAssign "threw" (SeBool False), ScTry [ScDiscard (SeCallArgs "Assert-ScoredDocsCoverChecker" [])] [ScAssign "threw" (SeBool True)] [], ScAssign "script:scoredDocs" (SeVar "saved"), ScIf (SeNot (SeVar "threw")) [ScThrow (SeLit "a deliberately short doc list did not throw")] []] [ScAssign "docStatus" (SeLit "BROKEN"), ScAssign "docWhy" (SeProperty (SeProperty SeErrorText "Exception") "Message")] [], ScBlank, ScEcho (SeLit ""), ScEcho (ad-cat [SeLit "arm machinery:   ", SeVar "armStatus", SeLit " ", SeVar "armWhy"]), ScEcho (ad-cat [SeLit "scored-doc list: ", SeVar "docStatus", SeLit " ", SeVar "docWhy"]), ScEcho (SeLit ""), ScBlank, ScAssign "broken" (SeCount (SePipe (SeVar "results") [StWhere (SeStringNeq (SeProperty SeItem "Status") (SeLit "ok"))])), ScIf (SeStringNeq (SeVar "armStatus") (SeLit "ok")) [ScIncrement "broken"] [], ScIf (SeStringNeq (SeVar "docStatus") (SeLit "ok")) [ScIncrement "broken"] [], ScIf (SeIntGt (SeVar "broken") (SeInt 0)) [ScEcho (ad-cat [SeLit "FAIL: ", SeVar "broken", SeLit " control(s) did not answer as required. This harness cannot be trusted to score."]), ScExit (SeInt 1)] [], ScEcho (SeLit "harness self-test ok: it returns PASS for a good artifact and FAIL for"), ScEcho (SeLit "a bad one, in both cases, and the arm machinery refuses a bad id."), ScEcho (SeLit ""), ScEcho (SeLit "This says the SCORER works. It says nothing about any candidate, and"), ScEcho (SeLit "no ablation has been run: the agent step is manual and unstarted."), ScExit (SeInt 0)]]

Section: S09 -- Main

  s09 : List ShellCmd = [ScIf (SeVar "List") [ScAssign "ids" (SeAsArray (SeCallArgs "Get-LessonIds" [])), ScEcho (SeLit ""), ScEcho (SeConcat (SeLit "arms over ") (SeVar "lessons")), ScEcho (SeLit ""), ScEcho (SeLit "  FULL           every row, the ceiling"), ScEcho (SeLit "  NONE           no doctrine at all, the floor"), ScForEach "id" (SeVar "ids") [ScEcho (SeFormat (SeLit "  {0,-14} every row except this one") [SeVar "id"])], ScSequence [ScEcho (SeLit ""), ScEcho (ad-cat [SeCount (SeVar "ids"), SeLit " rows measured, so ", SeAdd (SeCount (SeVar "ids")) (SeInt 2), SeLit " arms, and each arm needs both cases:"]), ScEcho (ad-cat [SeMul (SeAdd (SeCount (SeVar "ids")) (SeInt 2)) (SeInt 2), SeLit " agent runs for one pass. Fitness is stochastic, so a verdict"]), ScEcho (SeLit "that has to separate close rows needs repeats on top of that."), ScEcho (SeLit ""), ScEcho (SeLit "Nothing here runs an agent. -Setup builds a run; you drive the candidate."), ScExit (SeInt 0)]] [], ScBlank, ScIf (SeVar "SelfTest") [ScRunArgs (SeLit "Invoke-SelfTest") []] [], ScBlank, ScIf (SeVar "Setup") [ScIf (SeStringEq (SeVar "Arm") (SeLit "")) [ScThrow (SeLit "pass -Arm <id|FULL|NONE>. Run -List for the arms.")] [], ScAssign "dir" (SeIfElse (SeStringNeq (SeVar "Run") (SeLit "")) (SeVar "Run") (SePathJoin (SeVar "runsRoot") (SeConcat (SeConcat (SeVar "Arm") (SeLit "-")) (SeVar "Case")))), ScDiscard (SeCallArgs "Invoke-Setup" [SaNamed "ArmName" (SeVar "Arm"), SaNamed "CaseName" (SeVar "Case"), SaNamed "RunDir" (SeVar "dir"), SaNamed "Quiet" (SeBool False), SaNamed "Force" (SeVar "Force")]), ScExit (SeInt 0)] [], ScBlank, ScIf (SeVar "Score") [ScIf (SeStringEq (SeVar "Run") (SeLit "")) [ScThrow (SeLit "pass -Run <run directory>")] [], ScAssign "v" (SeCallArgs "Invoke-Score" [SaNamed "RunDir" (SeVar "Run"), SaNamed "CandidateName" (SeVar "Candidate"), SaNamed "Quiet" (SeBool False)]), ScExit (SeIfElse (SeStringEq (SeVar "v") (SeLit "PASS")) (SeInt 0) (SeInt 1))] [], ScBlank, ScEcho (SeLit "pass one of -List, -SelfTest, -Setup or -Score. See the header of this file."), ScExit (SeInt 2)]

Section: Assembly

  ad-full : List ShellCmd = [ScSequence ad-doctrine, ScBlank, ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScBlank, ScSequence s06, ScBlank, ScSequence s07, ScBlank, ScSequence s08, ScBlank, ScSequence s09]

  ad-script : ShellScript = sh-script "ablate-doctrine" "The ablation harness over the rows of docs/PM/Active/Stories/LESSONS.md." ad-params ad-full

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell ad-script)
  end

