Chapter: BundleAppScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  bundle-params : List ShellParam = [sh-param "Src" SptString, sh-param "Out" SptString]

Section: S01 -- Preamble

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit ".."))), ScRunDot (SePathJoin SeScriptRoot (SeLit "quire-map.ps1"))]

Section: S02 -- Read Source

  s02 : List ShellCmd = [ScBlank, ScAssign "srcPath" (SePathResolve (SeVar "Src")), ScDotNetCallAssign "rootLines" "System.IO.File" "ReadAllLines" [SeVar "srcPath"]]

Section: S03 -- Resolve Cite Order

  resolve-call : ShellExpr = SeCallArgs "Resolve-CiteOrder" [SaNamed "RootLines" (SeVar "rootLines"), SaNamed "Repo" (SeVar "Repo")]

  missing-message : ShellExpr = SeConcat (SeLit "MISSING: ") (SeProperty (SeProperty SeErrorText "Exception") "Message")

  s03 : List ShellCmd = [ScBlank, ScTry [ScAssign "ordered" resolve-call] [ScWriteError missing-message, ScExit (SeInt 3)] []]

Section: S04 -- Build Output

  format-call : ShellExpr = SeCallArgs "Format-CiteChapters" [SaNamed "Ordered" (SeVar "ordered")]

  s04 : List ShellCmd = [ScAssign "lines" format-call, ScBlank, ScForEach "l" (SeVar "rootLines") [ScCallMethod (SeVar "lines") "Add" [SeVar "l"]], ScCallMethod (SeVar "lines") "Add" [SeLit ""]]

Section: S05 -- Write Output

  body-text : ShellExpr = SeConcat (SeJoin (SeVar "lines") SeNewline) SeNewline

  write-args : List ShellExpr = [SeVar "Out", SeVar "body", SeStaticCall "System.Text.UTF8Encoding" "new" [SeBool False]]

  count-part : ShellExpr = SeConcat (SeConcat (SeLit "[bundle-app] ") (SeProperty (SeVar "ordered") "Count")) (SeLit " dependencies + root -> ")

  size-part : ShellExpr = SeConcat (SeConcat (SeLit " (") (SeProperty (SeVar "body") "Length")) (SeLit " bytes)")

  done-message : ShellExpr = SeConcat (SeConcat count-part (SeVar "Out")) size-part

  s05 : List ShellCmd = [ScBlank, ScAssign "body" body-text, ScDotNetCall "System.IO.File" "WriteAllText" write-args, ScEcho done-message]

Section: Assembly

  bundle-body : List ShellCmd = [ScSequence s01, ScSequence s02, ScSequence s03, ScBlank, ScSequence s04, ScSequence s05]

  bundle-script : ShellScript = sh-script "bundle-app" "Bundle a Codex application source file with all its transitive cited dependencies into a single .codex file" bundle-params bundle-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell bundle-script)
  end

