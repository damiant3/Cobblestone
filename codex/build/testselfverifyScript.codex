Chapter: TestSelfVerifyScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter PowerShellEmit

 We say:

Section: Parameters

  default-seed : ShellExpr = SePathJoin SeScriptRoot (SeLit "..\\seed\\Codex.cdx")

  selfverify-params : List ShellParam = [sh-param-default "Seed" SptString default-seed, sh-param-default "PCore" SptInt (SeInt 1)]

Section: S01 -- Read The Seed

  seed-message : ShellExpr = SeConcat (SeConcat (SeConcat (SeLit "Seed: ") (SeVar "Seed")) (SeConcat (SeLit " (") (SeVar "seedLen"))) (SeLit " bytes)")

  missing-seed : ShellExpr = SeConcat (SeLit "Seed not found: ") (SeVar "Seed")

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScAssign "compile" (SePathJoin SeScriptRoot (SeLit "compile.ps1")), ScAssign "run" (SePathJoin SeScriptRoot (SeLit "test-run.ps1")), ScBlank, ScIf (SeNot (SeFileExists (SeVar "Seed"))) [ScThrow missing-seed] [], ScReadBytes "seedBytes" (SePathResolve (SeVar "Seed")), ScAssign "seedLen" (SeProperty (SeVar "seedBytes") "Length"), ScEcho seed-message]

Section: S02 -- Header Bytes

 The CDX header is the first 224 bytes and the program is handed it as a
 literal list, which is why it is rendered here as decimal text rather than
 read by the program itself: the program under test must not depend on file
 IO to answer a question about a file.

  header-literal : ShellExpr = SeJoin (SePipe (SeVar "headerBytes") [StMap (SeMethodCall SeItem "ToString" [])]) (SeLit ",")

  s02 : List ShellCmd = [ScAssign "headerBytes" (SeSlice (SeVar "seedBytes") 0 223), ScAssign "headerLiteral" header-literal]

Section: S03 -- The Generated Program

  header-line : ShellExpr = SeConcat (SeConcat (SeLit "    let header = [") (SeVar "headerLiteral")) (SeLit "]")

  size-line : ShellExpr = SeConcat (SeConcat (SeLit "      print-line-uni (\"SIZE: ") (SeVar "seedLen")) (SeLit "\")")

  program-lines : List ShellExpr = [SeLit "Chapter: SelfVerifySeed", SeLit "  cites Verify chapter CdxBinary", SeLit "  cites Foreword chapter Ed25519", SeLit "  cites Foreword chapter Sha256", SeLit "  cites Foreword chapter Sha512", SeLit "  cites Foreword chapter Maybe", SeLit "", SeLit "Section: Body", SeLit "", SeLit "  opening : [Console] Nothing = act", header-line, SeLit "    in let magic-ok = cdx-verify-magic header", SeLit "    in let pub-key = list-slice header 40 72", SeLit "    in let sig = list-slice header 72 136", SeLit "    in let content-hash = cdx-read-content-hash header", SeLit "    in let sig-valid = ed25519-verify pub-key content-hash sig", SeLit "    in let has-author = list-at header 40 + list-at header 41 + list-at header 42 + list-at header 43", SeLit "    in act", size-line, SeLit "      print-line-uni (\"MAGIC: \" & show magic-ok)", SeLit "      print-line-uni (\"SIGNATURE: \" & show sig-valid)", SeLit "      print-line-uni (\"AUTHOR-KEY-PRESENT: \" & show (has-author > 0))", SeLit "      if magic-ok then if sig-valid then", SeLit "        print-line-uni \"THE SEED VERIFIES ITSELF\"", SeLit "      else print-line-uni \"SIGNATURE INVALID\"", SeLit "      else print-line-uni \"BAD MAGIC\"", SeLit "    end", SeLit "  end"]

  s03 : List ShellCmd = [ScAssign "src" (SeLines program-lines)]

Section: S04 -- Temporary Files

  temp-with : Text -> ShellExpr
  temp-with (suffix) = SeConcat (SeStaticCall "System.IO.Path" "GetTempFileName" []) (SeLit suffix)

  generated-message : ShellExpr = SeConcat (SeConcat (SeLit "Generated source: ") (SeProperty (SeStaticCall "System.IO.File" "ReadAllBytes" [SeVar "tmpSrc"]) "Length")) (SeLit " bytes")

  s04 : List ShellCmd = [ScAssign "tmpSrc" (temp-with ".codex"), ScAssign "tmpCdx" (temp-with ".cdx"), ScAssign "tmpLog" (temp-with ".log"), ScAssign "tmpOut" (temp-with ".out"), ScBlank, ScDotNetCall "System.IO.File" "WriteAllText" [SeVar "tmpSrc", SeVar "src"], ScEcho generated-message]

Section: S05 -- Compile And Run

  compile-args : List ShellArg = [SaNamed "File" (SeVar "compile"), SaNamed "Src" (SeVar "tmpSrc"), SaNamed "Out" (SeVar "tmpCdx"), SaNamed "Log" (SeVar "tmpLog"), SaNamed "PCore" (SeVar "PCore")]

  run-args : List ShellArg = [SaNamed "File" (SeVar "run"), SaNamed "Kernel" (SeVar "tmpCdx"), SaNamed "OutFile" (SeVar "tmpOut")]

  compile-failed : List ShellCmd = [ScEchoStyled (SeLit "COMPILE FAILED") ClBrightRed True, ScPrintFile (SeVar "tmpLog"), ScExit (SeInt 1)]

  run-failed : List ShellCmd = [ScEchoStyled (SeLit "RUN FAILED") ClBrightRed True, ScExit (SeInt 1)]

  s05 : List ShellCmd = [ScEchoStyled (SeLit "Compiling...") ClBrightCyan True, ScRunArgs (SeLit "pwsh") compile-args, ScIf (SeNot (SeExitCodeEq 0)) compile-failed [], ScBlank, ScEchoStyled (SeLit "Running...") ClBrightCyan True, ScRunArgs (SeLit "pwsh") run-args, ScIf (SeNot (SeExitCodeEq 0)) run-failed []]

Section: S06 -- Output

  s06 : List ShellCmd = [ScBlank, ScPrintFile (SeVar "tmpOut")]

Section: Assembly

  selfverify-body : List ShellCmd = [ScSequence s01, ScBlank, ScSequence s02, ScBlank, ScSequence s03, ScBlank, ScSequence s04, ScBlank, ScSequence s05, ScSequence s06]

  selfverify-script : ShellScript = sh-script "test-self-verify" "Compile and run a self-verification program that checks the seed CDX" selfverify-params selfverify-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell selfverify-script)
  end

