Section: Parameters

Section: Concatenation

  ccd-cat-from : List ShellExpr, Integer -> ShellExpr
  ccd-cat-from (xs) (i) = if i >= list-length xs then SeLit "" else if i == list-length xs - 1 then list-at xs i else SeConcat (list-at xs i) (ccd-cat-from xs (i + 1))

  ccd-cat : List ShellExpr -> ShellExpr
  ccd-cat (xs) = ccd-cat-from xs 0

Section: S01 -- Why this exists

Section: S02 -- Counting .codex files and lines

  ccd-rel-path : ShellExpr = SePathJoin (SeVar "treeRoot") (SeVar "Rel")

  ccd-file-body : List ShellCmd = [ScAssign "p" ccd-rel-path, ScIf (SeNot (SeDirExists (SeVar "p"))) [ScReturn (SeInt (0 - 1))] [], ScIf (SeVar "Recurse") [ScReturn (SeCount (SeListFiles (SeVar "p") "*.codex" True))] [], ScReturn (SeCount (SeListFiles (SeVar "p") "*.codex" False))]

  ccd-line-body : List ShellCmd = [ScAssign "p" ccd-rel-path, ScIf (SeNot (SeDirExists (SeVar "p"))) [ScReturn (SeInt (0 - 1))] [], ScAssign "n" (SeInt 0), ScForEach "f" (SeListFiles (SeVar "p") "*.codex" True) [ScIncrementBy "n" (SeCount (SeStaticCall "System.IO.File" "ReadAllLines" [SeProperty (SeVar "f") "FullName"]))], ScReturn (SeVar "n")]

  s02 : List ShellCmd = [ScFunction "Get-CodexFileCount" [sh-param "Rel" SptString, sh-param "Recurse" SptBool] ccd-file-body, ScBlank, ScFunction "Get-CodexLineCount" [sh-param "Rel" SptString] ccd-line-body]

Section: S03 -- Counting plugs

  ccd-plug-dirs : ShellExpr = SeStaticCall "System.IO.Directory" "GetDirectories" [SeVar "p"]

  ccd-has-build : ShellExpr = SeFileExists (SePathJoin (SeVar "d") (SeLit "build.ps1"))

  ccd-plugs-body : List ShellCmd = [ScAssign "p" (SePathJoin (SeVar "treeRoot") (SeLit "codex/plugs")), ScIf (SeNot (SeDirExists (SeVar "p"))) [ScReturn (SeInt (0 - 1))] [], ScAssign "n" (SeInt 0), ScForEach "d" ccd-plug-dirs [ScIf ccd-has-build [ScIncrement "n"] []], ScReturn (SeVar "n")]

  ccd-plug-one : List ShellCmd = [ScIf (SeNot ccd-has-build) [ScContinue] [], ScForEach "f" (SeListFiles (SeVar "d") "*.codex" True) [ScIf (SeMatch (SeProperty (SeVar "f") "FullName") "[\\\\/](build-output|test)[\\\\/]") [ScContinue] [], ScIncrement "n"]]

  ccd-plugmod-body : List ShellCmd = [ScAssign "p" (SePathJoin (SeVar "treeRoot") (SeLit "codex/plugs")), ScIf (SeNot (SeDirExists (SeVar "p"))) [ScReturn (SeInt (0 - 1))] [], ScAssign "n" (SeInt 0), ScForEach "d" ccd-plug-dirs ccd-plug-one, ScReturn (SeVar "n")]

  s03 : List ShellCmd = [ScFunction "Get-PlugCount" [] ccd-plugs-body, ScBlank, ScSequence [ScComment "Source only. Counting build-output/ made this claim depend on local build", ScComment "state: the same depot revision measured 191 in a dev workspace and 147 in", ScComment "the main one, because a plug's generated plug-source.codex is a .codex file", ScComment "too. A claim whose value moves with what you last built is not a claim, and", ScComment "-Repo against a second tree is what caught it."], ScFunction "Get-PlugModuleCount" [] ccd-plugmod-body]

