Chapter: CheckVmDifferentialScript

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter ShellBuild
  cites Shell chapter Pipeline
  cites Shell chapter PowerShellEmit

Section: Parameters

  vmdiff-params : List ShellParam =
    [ sh-param-default "Src" SptString (SeLit "")
    , sh-param-default "Kernel" SptString (SeLit "")
    , sh-switch "Quiet"
    ]

Section: S01 -- Body

  s01 : List ShellCmd =
    [ ScSetStrictMode
    , ScSetErrorStop
    , ScBlank
    , ScComment "Why this check exists, and it is trust rather than correctness."
    , ScComment ""
    , ScComment "QEMU is a third-party binary and its Authenticode signature cannot tell a"
    , ScComment "good build from a hostile one. The publisher's signing certificate expired"
    , ScComment "2023-09-12 and the binaries are still signed with it, so verification"
    , ScComment "returns the same failure whether or not that key is still in the"
    , ScComment "publisher's hands. Revocation is the mechanism that would normally carry"
    , ScComment "the news, and there is nothing left to revoke. A check that answers"
    , ScComment "identically in both worlds carries no information."
    , ScComment ""
    , ScComment "Two independent VM hosts agreeing on the output byte for byte does carry"
    , ScComment "information. codex-vm is ours and QEMU is theirs; they share no code, no"
    , ScComment "accelerator and no author. A QEMU altered to corrupt compiler output has to"
    , ScComment "reproduce the exact bytes our own hypervisor produces from the same source"
    , ScComment "on the same machine."
    , ScComment ""
    , ScComment "This is not a proof. It is one sample, and it does not catch an attacker"
    , ScComment "who corrupts only a seed rebuild. It is an assertion with a runner, which"
    , ScComment "is more than the certificate has ever been."
    , ScComment ""
    , ScComment "Exit 0 on match, and 0 on a skip: a machine with only one host is the"
    , ScComment "normal case, not a failure. Exit 1 on a byte mismatch, which is the whole"
    , ScComment "reason the script exists."
    , ScBlank
    , ScAssign "Repo" (SePathResolve (SePathJoin SeScriptRoot (SeLit "..")))
    , ScRunDot (SePathJoin SeScriptRoot (SeLit "vm-config.ps1"))
    , ScBlank
    , ScRaw "if (-not $Src) { $Src = Join-Path $Repo 'codex' 'test' 'act-let-scope.codex' }"
    , ScRaw "if (-not $Kernel) { $Kernel = Join-Path $Repo 'seed' 'Codex.cdx' }"
    , ScBlank
    , ScComment "Host discovery in vm-config honours CODEX_VM_HOST, which this script sets"
    , ScComment "per arm. Ask the filesystem instead so the skip decision is about what is"
    , ScComment "installed rather than about how the last caller was configured."
    , ScAssign "codexVmPresent" (SeBare (SeFileExists (SePathJoinN [SeVar "Repo", SeLit "tools", SeLit "codex-vm.exe"])))
    , ScAssign "qemuPresent" (SeCast "bool" (SeVar "script:FallbackVmBin"))
    , ScBlank
    , ScIf (SeBare (SeOr (SeBare (SeNot (SeVar "codexVmPresent"))) (SeBare (SeNot (SeVar "qemuPresent"))))) vmdiff-skip []
    , ScBlank
    , ScAssign "work" (SeBare (SePathJoinN [SeStaticCall "System.IO.Path" "GetTempPath" [], SeText "vmdiff-$PID"]))
    , ScRaw "New-Item -ItemType Directory -Force -Path $work | Out-Null"
    , ScAssign "compile" (SeBare (SePathJoinN [SeScriptRoot, SeLit "compile.ps1"]))
    , ScBlank
    , ScComment "The QEMU arm runs FIRST, deliberately. It is the arm that can hang, and"
    , ScComment "paying for the trusted compile before discovering that is waste."
    , ScFunctionBlock "Invoke-Arm" vmdiff-arm
    , ScBlank
    , ScComment "RETRY ONCE, AND ONLY FOR AN ARM THAT PRODUCED NO BINARY (red, ruled"
    , ScComment "2026-08-31). A host that fell over is worth one more attempt. Two hosts"
    , ScComment "that DISAGREE are never retried: a mismatch is the finding this check"
    , ScComment "exists to report, and retrying it would launder a real disagreement into"
    , ScComment "a pass on the second roll."
    , ScFunctionBlock "Invoke-ArmOnceRetried" vmdiff-retried
    , ScBlank
    , ScAssign "qemu" (SeBare (SeCallArgs "Invoke-ArmOnceRetried" [SaNamed "Name" (SeLit "qemu"), SaNamed "HostVal" (SeLit "qemu")]))
    , ScIf (SeBare (SeNot (SeProperty (SeVar "qemu") "Ok"))) vmdiff-qemu-failed []
    , ScBlank
    , ScAssign "cvm" (SeBare (SeCallArgs "Invoke-ArmOnceRetried" [SaNamed "Name" (SeLit "codexvm"), SaNamed "HostVal" (SeLit "")]))
    , ScIf (SeBare (SeNot (SeProperty (SeVar "cvm") "Ok"))) vmdiff-cvm-failed []
    , ScBlank
    , ScIf (SeBare (SeStringNeq (SeProperty (SeVar "qemu") "Cdx") (SeProperty (SeVar "cvm") "Cdx"))) vmdiff-cdx-mismatch []
    , ScBlank
    , ScIf (SeBare (SeStringNeq (SeProperty (SeVar "qemu") "Map") (SeProperty (SeVar "cvm") "Map"))) vmdiff-map-mismatch []
    , ScBlank
    , ScRaw "Remove-Item -Recurse -Force $work -ErrorAction SilentlyContinue"
    , ScIf (SeBare (SeNot (SeVar "Quiet"))) [ScEcho (SeText "  vm-differential: OK (both hosts agree, $($qemu.Cdx.Substring(0, 16)), qemu $($qemu.Seconds)s / codex-vm $($cvm.Seconds)s)")] []
    , ScExit (SeInt 0)
    ]

  vmdiff-skip : List ShellCmd =
    [ ScRaw "$missing = if (-not $codexVmPresent) { 'codex-vm' } else { 'qemu' }"
    , ScIf (SeBare (SeNot (SeVar "Quiet"))) [ScEcho (SeText "  vm-differential: SKIP (only one VM host on this machine; $missing missing)")] []
    , ScExit (SeInt 0)
    ]

  vmdiff-arm : List ShellCmd =
    [ ScRaw "param([string]$Name, [string]$HostVal)"
    , ScAssign "cdx" (SeBare (SePathJoinN [SeVar "work", SeText "$Name.cdx"]))
    , ScAssign "log" (SeBare (SePathJoinN [SeVar "work", SeText "$Name.log"]))
    , ScAssign "prev" (SeEnvVar "CODEX_VM_HOST")
    , ScAssign "env:CODEX_VM_HOST" (SeVar "HostVal")
    , ScTry vmdiff-arm-compile [] [ScAssign "env:CODEX_VM_HOST" (SeVar "prev")]
    , ScIf (SeBare (SeOr (SeBare (SeStringNeq (SeVar "code") ((SeInt 0)))) (SeBare (SeNot (SeFileExists (SeVar "cdx")))))) vmdiff-arm-if-code-not-test-type []
    , ScRaw "return @{"
    , ScIndent vmdiff-arm-return
    , ScRaw "}"
    ]

  vmdiff-arm-if-code-not-test-type : List ShellCmd =
    [ ScReturn (SeRecord [SfField "Ok" (SeBool False), SfField "Name" (SeVar "Name"), SfField "Code" (SeVar "code")])
    ]

  vmdiff-arm-return : List ShellCmd =
    [ ScRaw "Ok = $true"
    , ScRaw "Name = $Name"
    , ScRaw "Cdx = (Get-FileHash $cdx -Algorithm SHA256).Hash"
    , ScRaw "Map = if (Test-Path \"$cdx.map\") { (Get-FileHash \"$cdx.map\" -Algorithm SHA256).Hash } else { '' }"
    , ScRaw "Seconds = [int]$sw.Elapsed.TotalSeconds"
    ]

  vmdiff-arm-compile : List ShellCmd =
    [ ScDotNetCallAssign "sw" "System.Diagnostics.Stopwatch" "StartNew" []
    , ScRaw "& pwsh -NoProfile -File $compile -Src $Src -Out $cdx -Log $log -Kernel $Kernel *> $null"
    , ScAssign "code" SeLastExit
    , ScCallMethod (SeVar "sw") "Stop" []
    ]

  vmdiff-retried : List ShellCmd =
    [ ScRaw "param([string]$Name, [string]$HostVal)"
    , ScAssign "first" (SeBare (SeCallArgs "Invoke-Arm" [SaNamed "Name" (SeVar "Name"), SaNamed "HostVal" (SeVar "HostVal")]))
    , ScRaw "if ($first.Ok) { return $first }"
    , ScEcho (SeText "  vm-differential: the $Name arm produced no binary (exit $($first.Code)), retrying once")
    , ScReturn (SeBare (SeCallArgs "Invoke-Arm" [SaNamed "Name" (SeVar "Name"), SaNamed "HostVal" (SeVar "HostVal")]))
    ]

  vmdiff-qemu-failed : List ShellCmd =
    [ ScEcho (SeText "  vm-differential: FAIL (the qemu arm did not produce a binary, exit $($qemu.Code))")
    , ScEcho (SeText "      Detail: CODEX_VM_HOST=qemu pwsh build/compile.ps1 -Src $Src -Out out.cdx -Log out.log -Kernel $Kernel")
    , ScExit (SeInt 1)
    ]

  vmdiff-cvm-failed : List ShellCmd =
    [ ScEcho (SeText "  vm-differential: FAIL (the codex-vm arm did not produce a binary, exit $($cvm.Code))")
    , ScExit (SeInt 1)
    ]

  vmdiff-cdx-mismatch : List ShellCmd =
    [ ScEcho (SeLit "  vm-differential: MISMATCH -- the two VM hosts disagree on the compiler output")
    , ScEcho (SeText "      source:  $Src")
    , ScEcho (SeText "      kernel:  $Kernel")
    , ScEcho (SeText "      qemu:    $($qemu.Cdx)  [$($script:FallbackVmBin)]")
    , ScEcho (SeText "      codexvm: $($cvm.Cdx)")
    , ScEcho (SeLit "      One of these two hosts is not running the program it was given. Keep")
    , ScEcho (SeText "      the artifacts in $work and do not delete them.")
    , ScExit (SeInt 1)
    ]

  vmdiff-map-mismatch : List ShellCmd =
    [ ScEcho (SeLit "  vm-differential: MISMATCH -- binaries agree but the .map sidecars differ")
    , ScEcho (SeText "      qemu:    $($qemu.Map)")
    , ScEcho (SeText "      codexvm: $($cvm.Map)")
    , ScExit (SeInt 1)
    ]

Section: The one stage

  vmdiff-stage : PipeStage = PipeStage { ps-name = "compile through both hosts and compare", ps-why = "two independent VM hosts agreeing byte for byte carries information that an expired Authenticode signature cannot; one sample, not a proof", ps-in = ["Src", "Kernel", "Quiet"], ps-out = [], ps-needs = [PrGuests 1, PrKernel (SeVar "Kernel")], ps-verdict = [PoExit 0 "only one VM host is installed on this machine, so the check SKIPPED and reported success; a zero that means the check did not run", PoExit 1 "the qemu arm produced no binary, twice", PoExit 1 "the codex-vm arm produced no binary, twice", PoExit 1 "the two hosts disagree on the compiler output; one of them is not running the program it was given, and the artifacts are kept", PoExit 1 "the binaries agree and the .map sidecars do not", PoExit 0 "both hosts produced the same bytes"], ps-body = s01 }

Section: Assembly

  vmdiff-pipe : Pipeline = Pipeline { pl-name = "check-vm-differential", pl-doc = "Compile one source through BOTH VM hosts and compare the bytes", pl-params = vmdiff-params, pl-stages = [PsStage vmdiff-stage] }

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell (pipeline-to-shell vmdiff-pipe))
  end

