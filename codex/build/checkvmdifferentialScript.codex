 We say:

Section: Parameters

  vmdiff-params : List ShellParam = [sh-param-default "Src" SptString (SeLit ""), sh-param-default "Kernel" SptString (SeLit ""), sh-switch "Quiet"]

Section: S01 -- Body

  s01 : List ShellCmd = [ScSetStrictMode, ScSetErrorStop, ScBlank, ScRaw "# Why this check exists, and it is trust rather than correctness.", ScRaw "#", ScRaw "# QEMU is a third-party binary and its Authenticode signature cannot tell a", ScRaw "# good build from a hostile one. The publisher's signing certificate expired", ScRaw "# 2023-09-12 and the binaries are still signed with it, so verification", ScRaw "# returns the same failure whether or not that key is still in the", ScRaw "# publisher's hands. Revocation is the mechanism that would normally carry", ScRaw "# the news, and there is nothing left to revoke. A check that answers", ScRaw "# identically in both worlds carries no information.", ScRaw "#", ScRaw "# Two independent VM hosts agreeing on the output byte for byte does carry", ScRaw "# information. codex-vm is ours and QEMU is theirs; they share no code, no", ScRaw "# accelerator and no author. A QEMU altered to corrupt compiler output has to", ScRaw "# reproduce the exact bytes our own hypervisor produces from the same source", ScRaw "# on the same machine.", ScRaw "#", ScRaw "# This is not a proof. It is one sample, and it does not catch an attacker", ScRaw "# who corrupts only a seed rebuild. It is an assertion with a runner, which", ScRaw "# is more than the certificate has ever been.", ScRaw "#", ScRaw "# Exit 0 on match, and 0 on a skip: a machine with only one host is the", ScRaw "# normal case, not a failure. Exit 1 on a byte mismatch, which is the whole", ScRaw "# reason the script exists.", ScBlank, ScRaw "$Repo = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path", ScRaw ". (Join-Path $PSScriptRoot 'vm-config.ps1')", ScBlank, ScRaw "if (-not $Src) { $Src = Join-Path $Repo 'codex' 'test' 'act-let-scope.codex' }", ScRaw "if (-not $Kernel) { $Kernel = Join-Path $Repo 'seed' 'Codex.cdx' }", ScBlank, ScRaw "# Host discovery in vm-config honours CODEX_VM_HOST, which this script sets", ScRaw "# per arm. Ask the filesystem instead so the skip decision is about what is", ScRaw "# installed rather than about how the last caller was configured.", ScRaw "$codexVmPresent = Test-Path -PathType Leaf (Join-Path $Repo 'tools' 'codex-vm.exe')", ScRaw "$qemuPresent = [bool]$script:FallbackVmBin", ScBlank, ScRaw "if (-not $codexVmPresent -or -not $qemuPresent) {", ScRaw "    $missing = if (-not $codexVmPresent) { 'codex-vm' } else { 'qemu' }", ScRaw "    if (-not $Quiet) {", ScRaw "        Write-Host \"  vm-differential: SKIP (only one VM host on this machine; $missing missing)\"", ScRaw "    }", ScRaw "    exit 0", ScRaw "}", ScBlank, ScRaw "$work = Join-Path ([System.IO.Path]::GetTempPath()) \"vmdiff-$PID\"", ScRaw "New-Item -ItemType Directory -Force -Path $work | Out-Null", ScRaw "$compile = Join-Path $PSScriptRoot 'compile.ps1'", ScBlank, ScRaw "# The QEMU arm runs FIRST, deliberately. It is the arm that can hang, and", ScRaw "# paying for the trusted compile before discovering that is waste.", ScRaw "function Invoke-Arm {", ScRaw "    param([string]$Name, [string]$HostVal)", ScRaw "    $cdx = Join-Path $work \"$Name.cdx\"", ScRaw "    $log = Join-Path $work \"$Name.log\"", ScRaw "    $prev = $env:CODEX_VM_HOST", ScRaw "    $env:CODEX_VM_HOST = $HostVal", ScRaw "    try {", ScRaw "        $sw = [System.Diagnostics.Stopwatch]::StartNew()", ScRaw "        & pwsh -NoProfile -File $compile -Src $Src -Out $cdx -Log $log -Kernel $Kernel *> $null", ScRaw "        $code = $LASTEXITCODE", ScRaw "        $sw.Stop()", ScRaw "    } finally {", ScRaw "        $env:CODEX_VM_HOST = $prev", ScRaw "    }", ScRaw "    if ($code -ne 0 -or -not (Test-Path -PathType Leaf $cdx)) {", ScRaw "        return @{ Ok = $false; Name = $Name; Code = $code }", ScRaw "    }", ScRaw "    return @{", ScRaw "        Ok = $true", ScRaw "        Name = $Name", ScRaw "        Cdx = (Get-FileHash $cdx -Algorithm SHA256).Hash", ScRaw "        Map = if (Test-Path \"$cdx.map\") { (Get-FileHash \"$cdx.map\" -Algorithm SHA256).Hash } else { '' }", ScRaw "        Seconds = [int]$sw.Elapsed.TotalSeconds", ScRaw "    }", ScRaw "}", ScBlank, ScRaw "$qemu = Invoke-Arm -Name 'qemu' -HostVal 'qemu'", ScRaw "if (-not $qemu.Ok) {", ScRaw "    Write-Host \"  vm-differential: FAIL (the qemu arm did not produce a binary, exit $($qemu.Code))\"", ScRaw "    Write-Host \"      Detail: CODEX_VM_HOST=qemu pwsh build/compile.ps1 -Src $Src -Out out.cdx -Log out.log -Kernel $Kernel\"", ScRaw "    exit 1", ScRaw "}", ScBlank, ScRaw "$cvm = Invoke-Arm -Name 'codexvm' -HostVal ''", ScRaw "if (-not $cvm.Ok) {", ScRaw "    Write-Host \"  vm-differential: FAIL (the codex-vm arm did not produce a binary, exit $($cvm.Code))\"", ScRaw "    exit 1", ScRaw "}", ScBlank, ScRaw "if ($qemu.Cdx -ne $cvm.Cdx) {", ScRaw "    Write-Host '  vm-differential: MISMATCH -- the two VM hosts disagree on the compiler output'", ScRaw "    Write-Host \"      source:  $Src\"", ScRaw "    Write-Host \"      kernel:  $Kernel\"", ScRaw "    Write-Host \"      qemu:    $($qemu.Cdx)  [$($script:FallbackVmBin)]\"", ScRaw "    Write-Host \"      codexvm: $($cvm.Cdx)\"", ScRaw "    Write-Host '      One of these two hosts is not running the program it was given. Keep'", ScRaw "    Write-Host \"      the artifacts in $work and do not delete them.\"", ScRaw "    exit 1", ScRaw "}", ScBlank, ScRaw "if ($qemu.Map -ne $cvm.Map) {", ScRaw "    Write-Host '  vm-differential: MISMATCH -- binaries agree but the .map sidecars differ'", ScRaw "    Write-Host \"      qemu:    $($qemu.Map)\"", ScRaw "    Write-Host \"      codexvm: $($cvm.Map)\"", ScRaw "    exit 1", ScRaw "}", ScBlank, ScRaw "Remove-Item -Recurse -Force $work -ErrorAction SilentlyContinue", ScRaw "if (-not $Quiet) {", ScRaw "    Write-Host \"  vm-differential: OK (both hosts agree, $($qemu.Cdx.Substring(0, 16)), qemu $($qemu.Seconds)s / codex-vm $($cvm.Seconds)s)\"", ScRaw "}", ScRaw "exit 0"]

Section: Assembly

  vmdiff-body : List ShellCmd = [ScSequence s01]

  vmdiff-script : ShellScript = sh-script "check-vm-differential" "Compile one source through BOTH VM hosts and compare the bytes" vmdiff-params vmdiff-body

  opening : [Console] Nothing = act
    print-line-uni (emit-powershell vmdiff-script)
  end

