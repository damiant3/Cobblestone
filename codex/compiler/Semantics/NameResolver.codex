Chapter: Name Resolution
  cites Codex chapter Phase Allocator (deck-record, deck-short-of)
  cites Codex chapter Build Settings (max-recursion-depth, demand-scope-guard-band)

Section: Scope
 A scope is two lists. `names` is the chapter-level set -- top-level
 defs + ctors + builtins -- built once before resolving expressions
 and never mutated per-def. `locals` is the per-def set -- function
 params, `let` bindings, lambda params, pattern vars. Splitting them
 prevents the big `names` list (~2000 entries in self-host) from being
 cloned on every local binding via `list-insert-at`: without the split,
 each def's first `scope-add` fell off heap-top and allocated a fresh
 16 KB copy. With locals on their own list, the main `names` is never
 touched after chapter-scope construction.

  mutable Scope = record {
   names : SkipListText,
   locals : SkipListText,
   chapter-renames : List RenameEntry
  }

  empty-scope : Scope = Scope { names = skip-list-text-empty, locals = skip-list-text-empty, chapter-renames = [] }

  scope-has : Scope, Text -> Boolean
  scope-has (sc) (name) =
   if skip-list-text-has (sc.locals) name then True
   else let resolved = rename-lookup (sc.chapter-renames) name
   in skip-list-text-has (sc.names) resolved

  scope-add : Scope, Text -> Scope
  scope-add (sc) (name) =
   let __seq = sc.names = skip-list-text-insert (sc.names) name
   in sc

  scope-add-local : Scope, Text -> Scope
  scope-add-local (sc) (name) =
   let __seq = sc.locals = skip-list-text-insert (sc.locals) name
   in sc

  scope-fork : Scope -> Scope
  scope-fork (sc) =
   Scope { names = sc.names, locals = skip-list-text-clone (sc.locals), chapter-renames = sc.chapter-renames }

Section: Built-in Names

  builtin-names : List Text
  builtin-names = let bs = builtins in builtin-names-from bs 0 (list-length bs) []

Section: Name Classification
  is-type-name : Text -> Boolean
  is-type-name (name) =
   if text-length name == 0 then False
   else is-letter (char-at name 0) & is-upper-char (char-at name 0)

  is-upper-char : Char -> Boolean
  is-upper-char (c) =
   let code = char-code c
   in code >= char-code 'E' & code <= char-code 'Z'

Section: Resolution Result
  ResolveResult = record {
   bag : DiagnosticBag,
   top-level-names : SkipListText,
   type-names : SkipListText,
   ctor-names : List Text
  }

Section: Scope Results
  ResolveScopeResult = record {
   scope : Scope,
   errors : List Diagnostic
  }

  PatResult = record {
   scope : Scope,
   seen : SkipListText,
   errors : List Diagnostic
  }

Section: Collect Names
  collect-top-level-names : List ADef, Integer, Integer, SkipListText, List Diagnostic -> CollectResult
  collect-top-level-names (defs) (i) (len) (acc) (errs) =
   if i == len then deck-record (CollectResult {
    names = acc,
    errors = errs
   })
   else let def = list-at defs i
   in let name = def.name.value
   in if skip-list-text-has acc name
      then collect-top-level-names defs (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate definition: " & name) (def.span)])
      else collect-top-level-names defs (i + 1) len (skip-list-text-insert acc name) errs

  CollectResult = record {
   names : SkipListText,
   errors : List Diagnostic
  }

  collect-ctor-names : List ATypeDef, Integer, Integer, SkipListText, SkipListText, List Diagnostic -> CtorCollectResult
  collect-ctor-names (type-defs) (i) (len) (type-acc) (ctor-acc) (errs) =
   if i == len then deck-record (CtorCollectResult {
    type-names = type-acc,
    ctor-names = ctor-acc,
    errors = errs
   })
   else let td = list-at type-defs i
   in when td
     is AVariantTypeDef (name) (params) (ctors) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in let ctor-result = collect-variant-ctors ctors 0 (list-length ctors) ctor-acc (dup-check.errors)
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) (ctor-result.ctor-acc) (ctor-result.errors)
     is ARecordTypeDef (name) (params) (fields) (is-mut) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) ctor-acc (dup-check.errors)
     is AUnitTypeDef (name) (base) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in let unit-ctor-acc = skip-list-text-insert ctor-acc (name.value)
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) unit-ctor-acc (dup-check.errors)

  CtorCollectResult = record {
   type-names : SkipListText,
   ctor-names : SkipListText,
   errors : List Diagnostic
  }

  count-typecheck-units : List ATypeDef, Integer, Integer, Integer -> Integer
  count-typecheck-units (tds) (i) (n) (acc) =
   if i == n then acc
   else let td = list-at tds i
   in let c = when td
      is AVariantTypeDef (name) (params) (ctors) (s) -> list-length ctors
      is ARecordTypeDef (name) (params) (fields) (is-mut) (s) -> 1
      is AUnitTypeDef (name) (base) (s) -> 1
   in count-typecheck-units tds (i + 1) n (acc + c)

  TypeNameDupResult = record {
   type-acc : SkipListText,
   errors : List Diagnostic
  }

  check-type-name-dup : SkipListText, Text, SourceSpan, List Diagnostic -> TypeNameDupResult
  check-type-name-dup (type-acc) (name) (span) (errs) =
   if skip-list-text-has type-acc name then deck-record (TypeNameDupResult {
    type-acc = type-acc,
    errors = errs & [make-error cdx-duplicate-definition ("Duplicate type definition: '" & name & "' is already defined") span]
   })
   else deck-record (TypeNameDupResult {
    type-acc = skip-list-text-insert type-acc name,
    errors = errs
   })

  VariantCtorResult = record {
   ctor-acc : SkipListText,
   errors : List Diagnostic
  }

  collect-variant-ctors : List AVariantCtorDef, Integer, Integer, SkipListText, List Diagnostic -> VariantCtorResult
  collect-variant-ctors (ctors) (i) (len) (acc) (errs) =
   if i == len then deck-record (VariantCtorResult { ctor-acc = acc, errors = errs })
   else let c = list-at ctors i
   in let name = c.name.value
   in if skip-list-text-has acc name
      then collect-variant-ctors ctors (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate constructor: '" & name & "' is already defined") (c.span)])
      else collect-variant-ctors ctors (i + 1) len (skip-list-text-insert acc name) errs

Section: Collect Effect Op Names
  EffectOpCollectResult = record {
   op-names : SkipListText,
   errors : List Diagnostic
  }

  collect-effect-op-names : List AEffectDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
  collect-effect-op-names (effs) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
   if i == len then deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })
   else let eff = list-at effs i
   in let after = collect-ops-of-effect (eff.ops) top-names ctor-names 0 (list-length (eff.ops)) op-acc errs
   in collect-effect-op-names effs top-names ctor-names (i + 1) len (after.op-names) (after.errors)

  collect-ops-of-effect : List AEffectOpDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
  collect-ops-of-effect (ops) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
   if i == len then deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })
   else let op = list-at ops i
   in let name = op.name.value
   in let op-is-dup = skip-list-text-has op-acc name
   in let collides = op-is-dup | skip-list-text-has top-names name | skip-list-text-has ctor-names name
   in let new-acc = if op-is-dup then op-acc else skip-list-text-insert op-acc name
   in let new-errs = if collides then errs & [make-error cdx-duplicate-definition ("Effect operation '" & name & "' conflicts with existing name") (op.span)] else errs
   in collect-ops-of-effect ops top-names ctor-names (i + 1) len new-acc new-errs

Section: Build Initial Scope
  build-all-names-scope : SkipListText, SkipListText, List Text -> Scope
  build-all-names-scope (top-names) (ctor-names) (builtins) =
   let top-list = skip-list-text-to-list top-names
   in let sc = add-names-to-scope empty-scope top-list 0 (list-length top-list)
   in let ctor-list = skip-list-text-to-list ctor-names
   in let sc2 = add-names-to-scope sc ctor-list 0 (list-length ctor-list)
   in add-names-to-scope sc2 builtins 0 (list-length builtins)

  add-names-to-scope : Scope, List Text, Integer, Integer -> Scope
  add-names-to-scope (sc) (names) (i) (len) =
   if i == len then sc
   else add-names-to-scope (scope-add sc (list-at names i)) names (i + 1) len

Section: Resolve Expressions
  resolve-expr : Scope, AExpr -> List Diagnostic
  resolve-expr (sc) (expr) = resolve-expr-at sc expr 0

  resolve-expr-at : Scope, AExpr, Integer -> List Diagnostic
  resolve-expr-at (sc) (expr) (depth) =
   if depth >= max-recursion-depth then [make-error cdx-resource-exhausted ("compiler resource exhausted in name-resolver.resolve-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)]
   else when expr
    is ALitExpr (val) (kind) (s) -> []
    is ANameExpr (name) (s) ->
     if scope-has sc (name.value) | is-type-name (name.value) then []
     else [make-error cdx-undefined-name ("Undefined name: " & name.value) s]
    is ABinaryExpr (left) (op) (right) (s) ->
     resolve-expr-at sc left (depth + 1) & resolve-expr-at sc right (depth + 1)
    is AUnaryExpr (operand) (s) -> resolve-expr-at sc operand (depth + 1)
    is AApplyExpr (func) (arg) (s) ->
     resolve-expr-at sc func (depth + 1) & resolve-expr-at sc arg (depth + 1)
    is AIfExpr (cond) (then-e) (else-e) (s) ->
     resolve-expr-at sc cond (depth + 1) & resolve-expr-at sc then-e (depth + 1) & resolve-expr-at sc else-e (depth + 1)
    is ALetExpr (bindings) (body) (s) ->
     resolve-let (scope-fork sc) bindings body
    is ALambdaExpr (params) (body) (s) ->
     let param-result = add-lambda-params sc params 0 (list-length params) s skip-list-text-empty []
     in param-result.errors & resolve-expr-at (param-result.scope) body (depth + 1)
    is AMatchExpr (scrutinee) (arms) (s) ->
     resolve-expr-at sc scrutinee (depth + 1) & resolve-match-arms sc arms 0 (list-length arms) []
    is AListExpr (elems) (s) ->
     resolve-list-elems sc elems 0 (list-length elems) []
    is ARecordExpr (name) (fields) (s) ->
     resolve-record-fields sc fields 0 (list-length fields) []
    is AFieldAccess (obj) (field) (s) -> resolve-expr-at sc obj (depth + 1)
    is AActExpr (stmts) (s) -> resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []
    is AHandleExpr (eff) (body) (clauses) (s) ->
     resolve-expr-at sc body (depth + 1) & resolve-handle-clauses sc clauses 0 (list-length clauses) []
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) ->
     resolve-expr-at sc body (depth + 1)
    is ATryExpr (max) (body) (fb) (fail) (s) ->
     resolve-try-region sc body & resolve-try-region sc fb & resolve-try-region sc fail
    is AFieldAssignExpr (rec) (field) (val) (s) ->
     resolve-expr-at sc rec (depth + 1) & resolve-expr-at sc val (depth + 1)
    is ALazyExpr (inner) (s) -> resolve-expr-at sc inner (depth + 1)
    is AErrorExpr (msg) (s) -> []
    is AInductionExpr (scrut) (arms) (s) ->
     let sc2 = when scrut is ANameExpr (nm) (ss) -> scope-add-local (scope-fork sc) (nm.value) is otherwise -> sc
     in resolve-match-arms sc2 arms 0 (list-length arms) []

  resolve-try-region : Scope, List AActStmt -> List Diagnostic
  resolve-try-region (sc) (stmts) =
   resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []

  resolve-handle-clauses : Scope, List AHandleClause, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-handle-clauses (sc) (clauses) (i) (len) (errs) =
   if i == len then errs
   else let c = list-at clauses i
   in let clause-scope = scope-fork sc
   in let sc2 = scope-add-local clause-scope (c.resume-name.value)
   in let resume-seen = skip-list-text-insert skip-list-text-empty (c.resume-name.value)
   in let param-result = scope-add-clause-params sc2 (c.params) 0 (list-length (c.params)) (c.span) resume-seen []
   in let clause-errs = resolve-expr (param-result.scope) (c.body)
   in resolve-handle-clauses sc clauses (i + 1) len (errs & param-result.errors & clause-errs)

  scope-add-clause-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
  scope-add-clause-params (sc) (ps) (i) (len) (clause-span) (seen) (errs) =
   if i >= len then deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let name = (list-at ps i).value
   in if skip-list-text-has seen name
      then scope-add-clause-params sc ps (i + 1) len clause-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") clause-span])
      else scope-add-clause-params (scope-add-local sc name) ps (i + 1) len clause-span (skip-list-text-insert seen name) errs

Section: Resolve Let

  resolve-let-binds : Scope, List ALetBind, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-let-binds (sc) (bindings) (i) (len) (seen) (errs) =
   if i == len then errs
   else let b = list-at bindings i
   in let name = b.name.value
   in let bind-errs = resolve-expr sc (b.value)
   in let dup-errs = if skip-list-text-has seen name then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name & "'") (b.span)] else []
   in let sc2 = scope-add-local sc name
   in resolve-let-binds sc2 bindings (i + 1) len (skip-list-text-insert seen name) (errs & bind-errs & dup-errs)

  resolve-let : Scope, List ALetBind, AExpr -> List Diagnostic
  resolve-let (sc) (bindings) (body) =
   let bind-errs = resolve-let-binds sc bindings 0 (list-length bindings) skip-list-text-empty []
   in bind-errs & resolve-expr sc body

Section: Resolve Lambda Parameters
  add-lambda-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
  add-lambda-params (sc) (params) (i) (len) (lam-span) (seen) (errs) =
   if i == len then deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let name = (list-at params i).value
   in if skip-list-text-has seen name
      then add-lambda-params sc params (i + 1) len lam-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") lam-span])
      else add-lambda-params (scope-add-local sc name) params (i + 1) len lam-span (skip-list-text-insert seen name) errs

Section: Resolve Match Arms
  resolve-match-arms : Scope, List AMatchArm, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-match-arms (sc) (arms) (i) (len) (errs) =
   if i == len then errs
   else let arm = list-at arms i
   in let arm-scope = scope-fork sc
   in let pat-result = collect-pattern-names arm-scope (arm.pattern)
   in let guard-errs = resolve-expr (pat-result.scope) (arm.guard)
   in let arm-errs = resolve-expr (pat-result.scope) (arm.body)
   in resolve-match-arms sc arms (i + 1) len (errs & pat-result.errors & guard-errs & arm-errs)

  collect-pattern-names : Scope, APat -> ResolveScopeResult
  collect-pattern-names (sc) (pat) =
   let pr = collect-pattern-names-at sc pat 0 skip-list-text-empty []
   in deck-record (ResolveScopeResult { scope = pr.scope, errors = pr.errors })

  collect-pattern-names-at : Scope, APat, Integer, SkipListText, List Diagnostic -> PatResult
  collect-pattern-names-at (sc) (pat) (depth) (seen) (errs) =
   if depth >= max-recursion-depth then deck-record (PatResult { scope = sc, seen = seen, errors = errs })
   else when pat
    is AVarPat (name) (s) ->
     if skip-list-text-has seen (name.value)
     then deck-record (PatResult { scope = sc, seen = seen, errors = errs & [make-error cdx-duplicate-definition ("Duplicate pattern variable: '" & name.value & "'") s] })
     else deck-record (PatResult { scope = scope-add-local sc (name.value), seen = skip-list-text-insert seen (name.value), errors = errs })
    is ACtorPat (name) (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs
    is AVecPat (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs
    is ALitPat (val) (kind) (s) | AWildPat (s) -> deck-record (PatResult { scope = sc, seen = seen, errors = errs })

  collect-ctor-pat-names : Scope, List APat, Integer, Integer, Integer, SkipListText, List Diagnostic -> PatResult
  collect-ctor-pat-names (sc) (subs) (i) (len) (depth) (seen) (errs) =
   if i == len then deck-record (PatResult { scope = sc, seen = seen, errors = errs })
   else let sub = list-at subs i
   in let result = collect-pattern-names-at sc sub depth seen errs
   in collect-ctor-pat-names (result.scope) subs (i + 1) len depth (result.seen) (result.errors)

Section: Resolve List Elements
  resolve-list-elems : Scope, List AExpr, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-list-elems (sc) (elems) (i) (len) (errs) =
   if i == len then errs
   else let errs2 = resolve-expr sc (list-at elems i)
   in resolve-list-elems sc elems (i + 1) len (errs & errs2)

Section: Resolve Record Fields
  resolve-record-fields : Scope, List AFieldExpr, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-record-fields (sc) (fields) (i) (len) (errs) =
   if i == len then errs
   else let f = list-at fields i
   in let errs2 = resolve-expr sc (f.value)
   in resolve-record-fields sc fields (i + 1) len (errs & errs2)

Section: Resolve Act Statements
  resolve-act-stmts : Scope, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-act-stmts (sc) (stmts) (i) (len) (seen) (errs) =
   if i == len then errs
   else let stmt = list-at stmts i
   in when stmt
     is AActExprStmt (e) (s) ->
      when e
       is ALetExpr (binds) (lbody) (ls) -> resolve-act-let sc binds lbody stmts i len seen errs
       is otherwise ->
        let errs2 = resolve-expr sc e
        in resolve-act-stmts sc stmts (i + 1) len seen (errs & errs2)
     is AActBindStmt (name) (e) (s) ->
      let errs2 = resolve-expr sc e
   in let dup-errs = if skip-list-text-has seen (name.value) then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name.value & "'") s] else []
   in let sc2 = scope-add-local sc (name.value)
   in resolve-act-stmts sc2 stmts (i + 1) len (skip-list-text-insert seen (name.value)) (errs & errs2 & dup-errs)

  resolve-act-let : Scope, List ALetBind, AExpr, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-act-let (sc) (binds) (body) (stmts) (i) (len) (seen) (errs) =
   let bind-errs = resolve-let-binds sc binds 0 (list-length binds) skip-list-text-empty []
   in when body
    is ALetExpr (binds2) (body2) (ls2) -> resolve-act-let sc binds2 body2 stmts i len seen (errs & bind-errs)
    is otherwise ->
     let body-errs = resolve-expr sc body
     in resolve-act-stmts sc stmts (i + 1) len seen (errs & bind-errs & body-errs)

Section: Resolve All Definitions

 The ceiling is the SCOPE deck reservation's top, and this loop checks it
 because it is the phase's bulk deck writer -- not through its own records
 but through resolve-expr's pattern path, whose per-pattern-variable
 deck-record wraps the scope and seen skiplist inserts, so every insert
 node lands on the deck: measured 2026-07-21, 53.3 MB of the SCOPE deck's
 56.3 is written under this walk, against 0.3 MB for scope-adefs-ll.
 Guarding only scope-adefs-ll left this walk free to grow through a
 starved reservation into the bivy that holds the scope's own skiplists,
 and the compile died in a divide error inside advance-while-less instead
 of raising CDX9002. A def's resolve writes kilobytes, so a per-definition
 check against an 8 MB band cannot be outrun. The stop returns the
 diagnostics collected so far; compile-desugar-and-scope reads
 deck-short-of again after the walk and raises CDX9002 from there.

  resolve-all-defs : Scope, List ADef, Integer, Integer, List Diagnostic, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, Integer -> List Diagnostic
  resolve-all-defs (sc) (defs) (i) (len) (errs) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-chapter-rn) (ceiling) =
   if i == len then errs
   else if deck-short-of ceiling demand-scope-guard-band then errs
   else let def = list-at defs i
   in let chapter-rn = if def.chapter-slug == cur-slug then cur-chapter-rn
      else apply-cite-overrides (build-chapter-rename-map colliding assignments (def.chapter-slug)) citations colliding assignments slug-cache (def.chapter-slug) 0
   in let fresh-scope = Scope { names = sc.names, locals = skip-list-text-empty, chapter-renames = chapter-rn }
   in let param-result = add-def-params fresh-scope (def.params) 0 (list-length (def.params)) []
   in let body-scope = add-forall-binders (param-result.scope) def
   in let errs2 = resolve-expr body-scope (def.body)
   in resolve-all-defs sc defs (i + 1) len (errs & param-result.errors & errs2) colliding assignments citations slug-cache (def.chapter-slug) chapter-rn ceiling

  add-forall-binders : Scope, ADef -> Scope
  add-forall-binders (sc) (def) =
   if list-length (def.declared-type) == 0 then sc
   else add-forall-binder-names sc (list-at (def.declared-type) 0)

  add-forall-binder-names : Scope, ATypeExpr -> Scope
  add-forall-binder-names (sc) (t) =
   when t
    is AForallType (v) (vt) (p) (s) -> add-forall-binder-names (scope-add-local sc (v.value)) p
    is otherwise -> sc

  add-def-params : Scope, List AParam, Integer, Integer, List Diagnostic -> ResolveScopeResult
  add-def-params (sc) (params) (i) (len) (errs) =
   if i == len then deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let p = list-at params i
   in let name = p.name.value
   in if skip-list-text-has (sc.locals) name
      then add-def-params sc params (i + 1) len (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") (p.span)])
      else add-def-params (scope-add-local sc name) params (i + 1) len errs

Section: Resolve Chapter
  resolve-chapter : AChapter, SkipListText, List ChapterAssignment, Integer -> ResolveResult
  resolve-chapter (mod) (colliding) (assignments) (ceiling) =
   resolve-chapter-with-citations mod [] colliding assignments ceiling

  resolve-chapter-with-citations : AChapter, List ResolveResult, SkipListText, List ChapterAssignment, Integer -> ResolveResult
  resolve-chapter-with-citations (mod) (imported) (colliding) (assignments) (ceiling) =
   let top = collect-top-level-names (mod.defs) 0 (list-length (mod.defs)) skip-list-text-empty []
   in let ctors = collect-ctor-names (mod.type-defs) 0 (list-length (mod.type-defs)) skip-list-text-empty skip-list-text-empty []
   in let effect-ops = collect-effect-op-names (mod.effect-defs) (top.names) (ctors.ctor-names) 0 (list-length (mod.effect-defs)) skip-list-text-empty []
   in let cited-names = collect-cited-names imported 0 (list-length imported) skip-list-text-empty
   in let class-method-names = collect-class-method-names-nr (mod.class-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty
   in let dict-placeholder-names = collect-dict-placeholder-names-nr (mod.class-defs) (mod.instance-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty
   in let all-top = skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-clone (top.names)) (effect-ops.op-names)) cited-names) class-method-names) dict-placeholder-names
   in let sc = build-all-names-scope all-top (ctors.ctor-names) builtin-names
   in let slug-cache = for a in assignments -> cite-key (a.chapter-slug)
   in let expr-errs = resolve-all-defs sc (mod.defs) 0 (list-length (mod.defs)) [] colliding assignments (mod.citations) slug-cache "" [] ceiling
   in let ctor-list = deck-record (skip-list-text-to-list (ctors.ctor-names))
   in deck-record (ResolveResult {
     bag = deck-record (bag-from-list (top.errors & ctors.errors & effect-ops.errors & expr-errs)),
     top-level-names = top.names,
     type-names = ctors.type-names,
     ctor-names = ctor-list
    })

  collect-cited-names : List ResolveResult, Integer, Integer, SkipListText -> SkipListText
  collect-cited-names (results) (i) (len) (acc) =
   if i == len then acc
   else let r = list-at results i
   in let acc2 = skip-list-text-union acc (r.top-level-names)
   in let acc3 = skip-list-text-union acc2 (skip-list-text-from-list (r.ctor-names))
   in collect-cited-names results (i + 1) len acc3

  collect-class-method-names-nr : List AClassDef, Integer, Integer, SkipListText -> SkipListText
  collect-class-method-names-nr (cds) (i) (len) (acc) =
   if i == len then acc
   else let cd = list-at cds i
   in collect-class-method-names-nr cds (i + 1) len (add-class-method-names-nr (cd.methods) 0 (list-length (cd.methods)) acc)

  add-class-method-names-nr : List AEffectOpDef, Integer, Integer, SkipListText -> SkipListText
  add-class-method-names-nr (ops) (i) (len) (acc) =
   if i == len then acc
   else let op = list-at ops i
   in add-class-method-names-nr ops (i + 1) len (skip-list-text-insert acc (op.name.value))

  collect-dict-placeholder-names-nr : List AClassDef, List AInstanceDef, Integer, Integer, SkipListText -> SkipListText
  collect-dict-placeholder-names-nr (cds) (ids) (i) (len) (acc) =
   if i == len then acc
   else let cd = list-at cds i
   in let ic = count-instances-nr ids (cd.name.value) 0 (list-length ids) 0
   in if ic > 1
    then collect-dict-placeholder-names-nr cds ids (i + 1) len (skip-list-text-insert acc ("__dict-of-" & (cd.name.value)))
    else collect-dict-placeholder-names-nr cds ids (i + 1) len acc

  count-instances-nr : List AInstanceDef, Text, Integer, Integer, Integer -> Integer
  count-instances-nr (ids) (cname) (i) (len) (acc) =
   if i == len then acc
   else let id = list-at ids i
   in count-instances-nr ids cname (i + 1) len (if (id.class-name.value) == cname then acc + 1 else acc)

