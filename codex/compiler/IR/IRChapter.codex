Chapter: IR Chapter

Section: IR Expressions
  IRBinaryOp =
   | IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrPowInt | IrRemInt
   | IrAddNum | IrSubNum | IrMulNum | IrDivNum
   | IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox
   | IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping
   | IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating
   | IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq
   | IrAnd | IrOr
   | IrAppendText | IrAppendList
   | IrConsList
   | IrApproxEq
   | IrApproxEqExact
   | IrAddVec | IrSubVec | IrMulVec | IrDivVec
   | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec

  IRExpr =
   | IrIntLit (Integer) (SourceSpan)
   | IrNumLit (Integer) (SourceSpan)
   | IrTextLit (Text) (SourceSpan)
   | IrBoolLit (Boolean) (SourceSpan)
   | IrCharLit (Integer) (SourceSpan)
   | IrName (Text) (CodexType) (SourceSpan)
   | IrBinary (IRBinaryOp) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrNegate (IRExpr) (CodexType) (SourceSpan)
   | IrIf (IRExpr) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrLet (Text) (CodexType) (IRExpr) (IRExpr) (SourceSpan)
   | IrApply (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrLambda (List IRParam) (IRExpr) (CodexType) (SourceSpan)
   | IrList (List IRExpr) (CodexType) (SourceSpan)
   | IrMatch (IRExpr) (List IRBranch) (CodexType) (SourceSpan)
   | IrAct (List IRActStmt) (CodexType) (SourceSpan)
   | IrHandle (Text) (IRExpr) (List IRHandleClause) (CodexType) (SourceSpan)
   | IrWithTimeout (Integer) (List Text) (List Text) (IRExpr) (CodexType) (SourceSpan)
   | IrRecord (Text) (List IRFieldVal) (CodexType) (SourceSpan)
   | IrFieldAccess (IRExpr) (Text) (CodexType) (SourceSpan)
   | IrFork (IRExpr) (CodexType) (SourceSpan)
   | IrAwait (IRExpr) (CodexType) (SourceSpan)
   | IrTry (Integer) (List IRActStmt) (List IRActStmt) (List IRActStmt) (CodexType) (SourceSpan)
   | IrFieldStore (IRExpr) (Text) (IRExpr) (CodexType) (SourceSpan)
   | IrError (Text) (CodexType) (SourceSpan)

  IRParam = record {
   name : Text,
   type-val : CodexType,
   span : SourceSpan
  }

  IRBranch = record {
   pattern : IRPat,
   body : IRExpr,
   guard : IRExpr,
   span : SourceSpan,
   alt-group : Integer
  }

  IRPat =
   | IrVarPat (Text) (CodexType) (SourceSpan)
   | IrLitPat (Text) (CodexType) (SourceSpan)
   | IrCtorPat (Text) (List IRPat) (CodexType) (SourceSpan)
   | IrWildPat (SourceSpan)
   | IrVecPat (List IRPat) (CodexType) (SourceSpan)

  IRActStmt =
   | IrDoBind (Text) (CodexType) (IRExpr) (SourceSpan)
   | IrDoExec (IRExpr) (SourceSpan)

  ir-act-stmt-expr : IRActStmt -> IRExpr
  ir-act-stmt-expr (s) =
   when s
    is IrDoBind (n) (t) (v) (sp) ->
     let result = v
     in result
    is IrDoExec (v) (sp) -> v

  IRHandleClause = record {
   op-name : Text,
   params : List Text,
   resume-name : Text,
   body : IRExpr,
   span : SourceSpan
  }

  IRFieldVal = record {
   name : Text,
   value : IRExpr,
   span : SourceSpan
  }

Section: IR Definitions
  IRDef = record {
   name : Text,
   params : List IRParam,
   type-val : CodexType,
   body : IRExpr,
   chapter-slug : Text,
   is-punctual : Boolean,
   wcet-budget : Integer,
   unique-params : List Text,
   span : SourceSpan
  }

  IRChapter = record {
   name : Name,
   defs : List IRDef,
   effect-op-names : List Text,
   span : SourceSpan
  }

  ProseTransition =
   | PtNone
   | PtWeSay
   | PtThisIsWritten

  ProseTemplate =
   | PtNoTemplate
   | PtRecordTemplate (Text)
   | PtVariantTemplate (Text)
   | PtFunctionTemplate (Text)
   | PtConstraintTemplate
   | PtProofTemplate
   | PtProcedureTemplate
   | PtQuantifiedTemplate

  ProseBlock = record {
   text : Text,
   transition : ProseTransition,
   template : ProseTemplate,
   anchor : Text,
   offset : Integer
  }

 These four are declared here rather than in Syntax chapter
 SyntaxNodes, where the parser that builds them lives, because the
 plug bundle takes this chapter's declarations and not that one's.
 A plug that cannot name ProseBlock cannot read the pblocks form the
 text emitter writes, and the field it leaves empty is indistinguishable
 from a chapter that carried no prose.

  AnnotationNode = record {
   kind : Text,
   target : Text,
   body : Text
  }

  IRTextMeta = record {
   chapter-title : Text,
   prose : Text,
   section-titles : List Text,
   ctor-names : List Text,
   prose-blocks : List ProseBlock,
   annotations : List AnnotationNode,
   ground-effects : List Text
  }

 ground-effects carries the chapter's grounds table onto the text wire as
 the type checker holds it: one "slug\neffect" entry per grounded effect.
 A chapter grounds the hardware effects it is the SOURCE of and its bodies
 may then perform exactly those without declaring them, which means a
 reader of the IR text sees a signature performing an effect it does not
 declare and has no way to tell that from a violation. It had no way at
 all before 2026-08-04: the rule was enforced by the compiler and absent
 from the artifact, so an independent checker reported every grounded call
 in the tree.

Section: IR Expression Type
  ir-expr-type : IRExpr -> CodexType
  ir-expr-type (e) =
   when e
    is IrIntLit (v) (s) -> int-ty-default
    is IrNumLit (v) (s) -> real-f64
    is IrTextLit (v) (s) -> TextTy
    is IrBoolLit (v) (s) -> BooleanTy
    is IrCharLit (v) (s) -> CharTy
    is IrName (n) (t) (s) | IrBinary (op) (l) (r) (t) (s) -> t
    is IrNegate (x) (t) (s) -> t
    is IrIf (c) (th) (el) (t) (s) -> t
    is IrLet (n) (t) (v) (b) (s) -> ir-expr-type b
    is IrApply (f) (a) (t) (s) | IrLambda (ps) (b) (t) (s) -> t
    is IrList (es) (t) (s) -> ListTy t
    is IrMatch (sc) (bs) (t) (s) | IrAct (ss) (t) (s) | IrHandle (eff) (h) (cs) (t) (s) | IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) | IrRecord (n) (fs) (t) (s) | IrFieldAccess (r) (f) (t) (s) | IrFork (body) (t) (s) | IrAwait (task) (t) (s) | IrTry (max) (body) (fb) (fail) (t) (s) | IrFieldStore (r) (f) (v) (t) (s) | IrError (m) (t) (s) -> t

  set-ir-expr-type : IRExpr, CodexType -> IRExpr
  set-ir-expr-type (e) (new-ty) =
   when e
    is IrName (n) (t) (s) -> deck-record (IrName n new-ty s)
    is IrApply (f) (a) (t) (s) -> deck-record (IrApply f a new-ty s)
    is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n new-ty v b s)
    is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf c th el new-ty s)
    is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch sc bs new-ty s)
    is IrAct (ss) (t) (s) -> deck-record (IrAct ss new-ty s)
    is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n fs new-ty s)
    is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess r f new-ty s)
    is otherwise -> e

  ir-expr-span : IRExpr -> SourceSpan
  ir-expr-span (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) | IrName (n) (t) (s) | IrBinary (op) (l) (r) (t) (s) | IrNegate (x) (nt) (s) | IrIf (c) (th) (el) (t) (s) | IrLet (n) (t) (v) (b) (s) | IrApply (f) (a) (t) (s) | IrLambda (ps) (b) (t) (s) | IrList (es) (t) (s) | IrMatch (sc) (bs) (t) (s) | IrAct (ss) (t) (s) | IrHandle (eff) (h) (cs) (t) (s) | IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) | IrRecord (n) (fs) (t) (s) | IrFieldAccess (r) (f) (t) (s) | IrFork (body) (t) (s) | IrAwait (task) (t) (s) | IrTry (max) (body) (fb) (fail) (t) (s) | IrFieldStore (r) (f) (v) (t) (s) | IrError (m) (t) (s) -> s

