Chapter: LambdaLifting
  cites Codex chapter Lists
  cites Codex chapter Text
  cites Foreword chapter Sort

 Rewrites every IrLambda in the IR tree into an IrName reference to
 a synthesized top-level IRDef, with any free variables partially
 applied. Runs after lowering, before x86-64 emission.

Section: Types
  LiftCtx = record {
   reserved : SkipListText,
   counter : Integer between 0 and 4294967295,
   lifted : List IRDef
  }

  LiftExprResult = record {
   ctx : LiftCtx,
   expr : IRExpr
  }

  LiftExprsResult = record {
   ctx : LiftCtx,
   exprs : List IRExpr
  }

  LiftFieldsResult = record {
   ctx : LiftCtx,
   fields : List IRFieldVal
  }

  LiftBranchesResult = record {
   ctx : LiftCtx,
   branches : List IRBranch
  }

  LiftActStmtsResult = record {
   ctx : LiftCtx,
   stmts : List IRActStmt
  }

  LiftDefsResult = record {
   ctx : LiftCtx,
   defs : List IRDef
  }

  FreeVar = record {
   name : Text,
   type-val : CodexType
  }

  GenNameResult = record {
   ctx : LiftCtx,
   name : Text
  }

Section: Entry Point
  lift-lambdas : IRChapter -> IRChapter
  lift-lambdas (chapter) =
   let reserved = collect-reserved-names (chapter.defs) 0 (list-length (chapter.defs)) skip-list-text-empty
   in let ctx0 = LiftCtx { reserved = reserved, counter = 0, lifted = [] }
   in let res = lift-defs ctx0 (chapter.defs) 0 (list-length (chapter.defs)) []
   in __record-set chapter "defs" ((res.defs) & (res.ctx.lifted))

  collect-reserved-names : List IRDef, Integer, Integer, SkipListText -> SkipListText
  collect-reserved-names (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in collect-reserved-names defs (i + 1) len (skip-list-text-insert acc (d.name))

  params-to-names : List IRParam, Integer, Integer, SkipListText -> SkipListText
  params-to-names (params) (i) (len) (acc) =
   if i >= len then acc
   else let p = list-at params i
   in params-to-names params (i + 1) len (skip-list-text-insert acc (p.name))

  lift-defs : LiftCtx, List IRDef, Integer, Integer, List IRDef -> LiftDefsResult
  lift-defs (ctx) (defs) (i) (len) (acc) =
   if i >= len then LiftDefsResult { ctx = ctx, defs = acc }
   else let d = list-at defs i
   in let absorbed = absorb-outer-lambdas d
   in let enclosing = params-to-names (absorbed.params) 0 (list-length (absorbed.params)) skip-list-text-empty
   in let body-res = lift-expr ctx enclosing (absorbed.body)
   in let new-def = deck-record (IRDef {
    name = absorbed.name,
    params = absorbed.params,
    type-val = absorbed.type-val,
    body = body-res.expr,
    chapter-slug = absorbed.chapter-slug,
    span = absorbed.span
   })
   in lift-defs (body-res.ctx) defs (i + 1) len (list-push acc new-def)

  absorb-outer-lambdas : IRDef -> IRDef
  absorb-outer-lambdas (d) =
   when d.body
    is IrLambda (lps) (lbody) (lty) (lsp) ->
     let extended-params = (d.params) & lps
     in let merged = deck-record (IRDef {
      name = d.name,
      params = extended-params,
      type-val = d.type-val,
      body = lbody,
      chapter-slug = d.chapter-slug,
      span = d.span
     })
     in absorb-outer-lambdas merged
    is otherwise -> d

Section: Expression Walker
  lift-expr : LiftCtx, SkipListText, IRExpr -> LiftExprResult
  lift-expr (ctx) (enclosing) (e) =
   when e
    is IrIntLit (v) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrNumLit (v) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrTextLit (v) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrBoolLit (v) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrCharLit (v) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrName (n) (t) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrError (m) (t) (s) -> LiftExprResult { ctx = ctx, expr = e }
    is IrLambda (ps) (b) (t) (s) -> lift-one-lambda ctx enclosing ps b t s
    is IrBinary (op) (l) (r) (t) (s) ->
     let l-res = lift-expr ctx enclosing l
     in let r-res = lift-expr (l-res.ctx) enclosing r
     in LiftExprResult { ctx = r-res.ctx, expr = deck-record (IrBinary op (l-res.expr) (r-res.expr) t s) }
    is IrNegate (x) (s) ->
     let x-res = lift-expr ctx enclosing x
     in LiftExprResult { ctx = x-res.ctx, expr = deck-record (IrNegate (x-res.expr) s) }
    is IrIf (c) (th) (el) (t) (s) ->
     let c-res = lift-expr ctx enclosing c
     in let th-res = lift-expr (c-res.ctx) enclosing th
     in let el-res = lift-expr (th-res.ctx) enclosing el
     in LiftExprResult { ctx = el-res.ctx, expr = deck-record (IrIf (c-res.expr) (th-res.expr) (el-res.expr) t s) }
    is IrLet (n) (t) (v) (b) (s) ->
     let v-res = lift-expr ctx enclosing v
     in let b-enclosing = skip-list-text-insert enclosing n
     in let b-res = lift-expr (v-res.ctx) b-enclosing b
     in LiftExprResult { ctx = b-res.ctx, expr = deck-record (IrLet n t (v-res.expr) (b-res.expr) s) }
    is IrApply (f) (a) (t) (s) ->
     let f-res = lift-expr ctx enclosing f
     in let a-res = lift-expr (f-res.ctx) enclosing a
     in LiftExprResult { ctx = a-res.ctx, expr = deck-record (IrApply (f-res.expr) (a-res.expr) t s) }
    is IrList (es) (t) (s) ->
     let es-res = lift-exprs ctx enclosing es 0 (list-length es) []
     in LiftExprResult { ctx = es-res.ctx, expr = deck-record (IrList (es-res.exprs) t s) }
    is IrMatch (sc) (bs) (t) (s) ->
     let sc-res = lift-expr ctx enclosing sc
     in let bs-res = lift-branches (sc-res.ctx) enclosing bs 0 (list-length bs) []
     in LiftExprResult { ctx = bs-res.ctx, expr = deck-record (IrMatch (sc-res.expr) (bs-res.branches) t s) }
    is IrAct (ss) (t) (s) ->
     let ss-res = lift-act-stmts ctx enclosing ss 0 (list-length ss) []
     in LiftExprResult { ctx = ss-res.ctx, expr = deck-record (IrAct (ss-res.stmts) t s) }
    is IrRecord (n) (fs) (t) (s) ->
     let fs-res = lift-fields ctx enclosing fs 0 (list-length fs) []
     in LiftExprResult { ctx = fs-res.ctx, expr = deck-record (IrRecord n (fs-res.fields) t s) }
    is IrFieldAccess (r) (f) (t) (s) ->
     let r-res = lift-expr ctx enclosing r
     in LiftExprResult { ctx = r-res.ctx, expr = deck-record (IrFieldAccess (r-res.expr) f t s) }
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let r-res = lift-expr ctx enclosing r
     in let v-res = lift-expr (r-res.ctx) enclosing v
     in LiftExprResult { ctx = v-res.ctx, expr = deck-record (IrFieldStore (r-res.expr) f (v-res.expr) t s) }
    is IrFork (body) (t) (s) ->
     let b-res = lift-expr ctx enclosing body
     in LiftExprResult { ctx = b-res.ctx, expr = deck-record (IrFork (b-res.expr) t s) }
    is IrAwait (task) (t) (s) ->
     let t-res = lift-expr ctx enclosing task
     in LiftExprResult { ctx = t-res.ctx, expr = deck-record (IrAwait (t-res.expr) t s) }
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let h-res = lift-expr ctx enclosing h
     in let clause-enclosing = add-clause-names-to-enclosing cs enclosing
     in let cs-res = lift-handle-clauses (h-res.ctx) clause-enclosing cs 0 (list-length cs) []
     in LiftExprResult { ctx = cs-res.ctx, expr = deck-record (IrHandle eff (h-res.expr) (cs-res.clauses) t s) }
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) ->
     let b-res = lift-expr ctx enclosing body
     in LiftExprResult { ctx = b-res.ctx, expr = deck-record (IrWithTimeout secs effs scopes (b-res.expr) t s) }
    is IrTry (max) (body) (fb) (fail) (t) (s) ->
     let body-res = lift-act-stmts ctx enclosing body 0 (list-length body) []
     in let fb-res = lift-act-stmts (body-res.ctx) enclosing fb 0 (list-length fb) []
     in let fail-res = lift-act-stmts (fb-res.ctx) enclosing fail 0 (list-length fail) []
     in LiftExprResult { ctx = fail-res.ctx, expr = deck-record (IrTry max (body-res.stmts) (fb-res.stmts) (fail-res.stmts) t s) }

  lift-exprs : LiftCtx, SkipListText, List IRExpr, Integer, Integer, List IRExpr -> LiftExprsResult
  lift-exprs (ctx) (enclosing) (es) (i) (len) (acc) =
   if i >= len then LiftExprsResult { ctx = ctx, exprs = acc }
   else let r = lift-expr ctx enclosing (list-at es i)
   in lift-exprs (r.ctx) enclosing es (i + 1) len (list-push acc (r.expr))

  lift-branches : LiftCtx, SkipListText, List IRBranch, Integer, Integer, List IRBranch -> LiftBranchesResult
  lift-branches (ctx) (enclosing) (bs) (i) (len) (acc) =
   if i >= len then LiftBranchesResult { ctx = ctx, branches = acc }
   else let b = list-at bs i
   in let branch-enclosing = collect-pattern-names (b.pattern) enclosing
   in let body-res = lift-expr ctx branch-enclosing (b.body)
   in let new-b = deck-record (IRBranch {
    pattern = b.pattern,
    body = body-res.expr,
    span = b.span
   })
   in lift-branches (body-res.ctx) enclosing bs (i + 1) len (list-push acc new-b)

  lift-fields : LiftCtx, SkipListText, List IRFieldVal, Integer, Integer, List IRFieldVal -> LiftFieldsResult
  lift-fields (ctx) (enclosing) (fs) (i) (len) (acc) =
   if i >= len then LiftFieldsResult { ctx = ctx, fields = acc }
   else let f = list-at fs i
   in let v-res = lift-expr ctx enclosing (f.value)
   in let new-f = deck-record (IRFieldVal {
    name = f.name,
    value = v-res.expr,
    span = f.span
   })
   in lift-fields (v-res.ctx) enclosing fs (i + 1) len (list-push acc new-f)

  lift-act-stmts : LiftCtx, SkipListText, List IRActStmt, Integer, Integer, List IRActStmt -> LiftActStmtsResult
  lift-act-stmts (ctx) (enclosing) (ss) (i) (len) (acc) =
   if i >= len then LiftActStmtsResult { ctx = ctx, stmts = acc }
   else let s = list-at ss i
   in when s
    is IrDoBind (n) (t) (v) (sp) ->
     let v-res = lift-expr ctx enclosing v
     in let new-enclosing = skip-list-text-insert enclosing n
     in lift-act-stmts (v-res.ctx) new-enclosing ss (i + 1) len (list-push acc (deck-record (IrDoBind n t (v-res.expr) sp)))
    is IrDoExec (v) (sp) ->
     let v-res = lift-expr ctx enclosing v
     in lift-act-stmts (v-res.ctx) enclosing ss (i + 1) len (list-push acc (deck-record (IrDoExec (v-res.expr) sp)))

  LiftClausesResult = record {
   ctx : LiftCtx,
   clauses : List IRHandleClause
  }

  lift-handle-clauses : LiftCtx, SkipListText, List IRHandleClause, Integer, Integer, List IRHandleClause -> LiftClausesResult
  lift-handle-clauses (ctx) (enclosing) (cs) (i) (len) (acc) =
   if i >= len then LiftClausesResult { ctx = ctx, clauses = acc }
   else let c = list-at cs i
   in let clause-enc = skip-list-text-insert enclosing (c.resume-name)
   in let body-res = lift-expr ctx clause-enc (c.body)
   in let new-c = deck-record (IRHandleClause {
    op-name = c.op-name,
    params = c.params,
    resume-name = c.resume-name,
    body = body-res.expr,
    span = c.span
   })
   in lift-handle-clauses (body-res.ctx) enclosing cs (i + 1) len (list-push acc new-c)

  add-clause-names-to-enclosing : List IRHandleClause, SkipListText -> SkipListText
  add-clause-names-to-enclosing (cs) (enc) =
   add-clause-names-loop cs 0 (list-length cs) enc

  add-clause-names-loop : List IRHandleClause, Integer, Integer, SkipListText -> SkipListText
  add-clause-names-loop (cs) (i) (len) (enc) =
   if i >= len then enc
   else let c = list-at cs i
   in let enc1 = skip-list-text-insert enc (c.op-name)
   in let enc2 = skip-list-text-insert enc1 (c.resume-name)
   in add-clause-names-loop cs (i + 1) len enc2

Section: Pattern Variables
  collect-pattern-names : IRPat, SkipListText -> SkipListText
  collect-pattern-names (p) (acc) =
   when p
    is IrVarPat (n) (t) (s) -> skip-list-text-insert acc n
    is IrLitPat (v) (t) (s) -> acc
    is IrWildPat (s) -> acc
    is IrCtorPat (n) (subs) (t) (s) -> collect-pattern-name-list subs 0 (list-length subs) acc

  collect-pattern-name-list : List IRPat, Integer, Integer, SkipListText -> SkipListText
  collect-pattern-name-list (ps) (i) (len) (acc) =
   if i >= len then acc
   else collect-pattern-name-list ps (i + 1) len (collect-pattern-names (list-at ps i) acc)

Section: Lift Single Lambda
  lift-one-lambda : LiftCtx, SkipListText, List IRParam, IRExpr, CodexType, SourceSpan -> LiftExprResult
  lift-one-lambda (ctx) (enclosing) (ps) (body) (ty) (sp) =
   when body
    is IrLambda (inner-ps) (inner-body) (inner-ty) (inner-sp) ->
     lift-one-lambda ctx enclosing (ps & inner-ps) inner-body ty sp
    is otherwise ->
   let body-enclosing = params-to-names ps 0 (list-length ps) enclosing
   in let body-res = lift-expr ctx body-enclosing body
   in let param-names = params-to-names ps 0 (list-length ps) skip-list-text-empty
   in let sorted-free = collect-free-vars (body-res.expr) param-names enclosing []
   in let name-result = gen-unique-name (body-res.ctx) "__lam"
   in let ret-ty = infer-lambda-return-ty ty (list-length ps)
   in let lifted-params = build-lifted-params sorted-free ps
   in let lifted-ty = build-function-ty lifted-params 0 (list-length lifted-params) ret-ty
   in let lifted-def = deck-record (IRDef {
    name = name-result.name,
    params = lifted-params,
    type-val = lifted-ty,
    body = body-res.expr,
    chapter-slug = "",
    span = sp
   })
   in let ctx1 = __record-set (name-result.ctx) "lifted" (list-push ((name-result.ctx).lifted) lifted-def)
   in let replacement = build-partial-app (name-result.name) lifted-ty sorted-free 0 (list-length sorted-free) sp
   in LiftExprResult { ctx = ctx1, expr = replacement }

  gen-unique-name : LiftCtx, Text -> GenNameResult
  gen-unique-name (ctx) (base) =
   gen-unique-name-loop ctx base (ctx.counter)

  gen-unique-name-loop : LiftCtx, Text, Integer -> GenNameResult
  gen-unique-name-loop (ctx) (base) (i) =
   let candidate = base & "_" & integer-to-text i
   in if skip-list-text-has (ctx.reserved) candidate then gen-unique-name-loop ctx base (i + 1)
      else let ctx1 = __record-set ctx "reserved" (skip-list-text-insert (ctx.reserved) candidate)
      in let ctx2 = __record-set ctx1 "counter" (i + 1)
      in GenNameResult { ctx = ctx2, name = candidate }

  build-lifted-params : List FreeVar, List IRParam -> List IRParam
  build-lifted-params (captures) (lam-params) =
   let cap-params = free-vars-to-params captures 0 (list-length captures) []
   in cap-params & lam-params

  free-vars-to-params : List FreeVar, Integer, Integer, List IRParam -> List IRParam
  free-vars-to-params (fvs) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fvs i
   in free-vars-to-params fvs (i + 1) len (list-push acc (deck-record (IRParam {
    name = f.name,
    type-val = f.type-val,
    span = synthetic-span
   })))

  build-function-ty : List IRParam, Integer, Integer, CodexType -> CodexType
  build-function-ty (params) (i) (len) (ret) =
   if i >= len then ret
   else let p = list-at params i
   in FunTy (p.type-val) (build-function-ty params (i + 1) len ret)

  infer-lambda-return-ty : CodexType, Integer -> CodexType
  infer-lambda-return-ty (ty) (n-params) =
   if n-params == 0 then ty
   else when ty
    is FunTy (pt) (rt) -> infer-lambda-return-ty rt (n-params - 1)
    is otherwise -> ty

  build-partial-app : Text, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
  build-partial-app (name) (fn-ty) (captures) (i) (len) (sp) =
   build-partial-app-loop (deck-record (IrName name fn-ty sp)) fn-ty captures 0 len sp

  build-partial-app-loop : IRExpr, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
  build-partial-app-loop (acc) (acc-ty) (captures) (i) (len) (sp) =
   if i >= len then acc
   else let c = list-at captures i
   in let next-ty = when acc-ty
    is FunTy (pt) (rt) -> rt
    is otherwise -> acc-ty
   in let new-acc = deck-record (IrApply acc (deck-record (IrName (c.name) (c.type-val) sp)) next-ty sp)
   in build-partial-app-loop new-acc next-ty captures (i + 1) len sp

Section: Free Variable Collection
  collect-free-vars : IRExpr, SkipListText, SkipListText, List FreeVar -> List FreeVar
  collect-free-vars (e) (local-bound) (capturable) (acc) =
   when e
    is IrName (n) (t) (s) ->
     if (skip-list-text-has capturable n) & (skip-list-text-has local-bound n == False) & (free-var-has acc n == False)
      then let fv-pos = bsearch-freevar-pos acc n 0 (list-length acc)
      in list-insert-at acc fv-pos (FreeVar { name = n, type-val = t })
      else acc
    is IrIntLit (v) (s) -> acc
    is IrNumLit (v) (s) -> acc
    is IrTextLit (v) (s) -> acc
    is IrBoolLit (v) (s) -> acc
    is IrCharLit (v) (s) -> acc
    is IrError (m) (t) (s) -> acc
    is IrLambda (ps) (b) (t) (s) ->
     let inner-bound = params-to-names ps 0 (list-length ps) local-bound
     in collect-free-vars b inner-bound capturable acc
    is IrApply (f) (a) (t) (s) ->
     let acc1 = collect-free-vars f local-bound capturable acc
     in collect-free-vars a local-bound capturable acc1
    is IrBinary (op) (l) (r) (t) (s) ->
     let acc1 = collect-free-vars l local-bound capturable acc
     in collect-free-vars r local-bound capturable acc1
    is IrNegate (x) (s) -> collect-free-vars x local-bound capturable acc
    is IrIf (c) (th) (el) (t) (s) ->
     let acc1 = collect-free-vars c local-bound capturable acc
     in let acc2 = collect-free-vars th local-bound capturable acc1
     in collect-free-vars el local-bound capturable acc2
    is IrLet (n) (t) (v) (b) (s) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in let new-bound = skip-list-text-insert local-bound n
     in collect-free-vars b new-bound capturable acc1
    is IrMatch (sc) (bs) (t) (s) ->
     let acc1 = collect-free-vars sc local-bound capturable acc
     in collect-free-vars-branches bs local-bound capturable 0 (list-length bs) acc1
    is IrList (es) (t) (s) -> collect-free-vars-list es local-bound capturable 0 (list-length es) acc
    is IrRecord (n) (fs) (t) (s) -> collect-free-vars-fields fs local-bound capturable 0 (list-length fs) acc
    is IrFieldAccess (r) (f) (t) (s) -> collect-free-vars r local-bound capturable acc
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let acc1 = collect-free-vars r local-bound capturable acc
     in collect-free-vars v local-bound capturable acc1
    is IrAct (ss) (t) (s) -> collect-free-vars-act-stmts ss local-bound capturable 0 (list-length ss) acc
    is IrFork (b) (t) (s) -> collect-free-vars b local-bound capturable acc
    is IrAwait (t2) (t) (s) -> collect-free-vars t2 local-bound capturable acc
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let acc1 = collect-free-vars h local-bound capturable acc
     in collect-free-vars-clauses cs local-bound capturable acc1 0 (list-length cs)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> collect-free-vars body local-bound capturable acc
    is IrTry (max) (body) (fb) (fail) (t) (s) ->
     let acc1 = collect-free-vars-act-stmts body local-bound capturable 0 (list-length body) acc
     in let acc2 = collect-free-vars-act-stmts fb local-bound capturable 0 (list-length fb) acc1
     in collect-free-vars-act-stmts fail local-bound capturable 0 (list-length fail) acc2

  bsearch-freevar-pos : List FreeVar, Text, Integer, Integer -> Integer
  bsearch-freevar-pos (xs) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in if text-compare name (list-at xs mid).name <= 0 then bsearch-freevar-pos xs name lo mid
      else bsearch-freevar-pos xs name (mid + 1) hi

  free-var-has : List FreeVar, Text -> Boolean
  free-var-has (xs) (name) =
   let len = list-length xs
   in let pos = bsearch-freevar-pos xs name 0 len
   in if pos >= len then False
      else (list-at xs pos).name == name

  collect-free-vars-list : List IRExpr, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-list (es) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else collect-free-vars-list es local-bound capturable (i + 1) len (collect-free-vars (list-at es i) local-bound capturable acc)

  collect-free-vars-branches : List IRBranch, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-branches (bs) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at bs i
   in let branch-bound = collect-pattern-names (b.pattern) local-bound
   in let acc1 = collect-free-vars (b.body) branch-bound capturable acc
   in collect-free-vars-branches bs local-bound capturable (i + 1) len acc1

  collect-free-vars-fields : List IRFieldVal, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-fields (fs) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fs i
   in collect-free-vars-fields fs local-bound capturable (i + 1) len (collect-free-vars (f.value) local-bound capturable acc)

  collect-free-vars-act-stmts : List IRActStmt, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-act-stmts (ss) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let s = list-at ss i
   in when s
    is IrDoBind (n) (t) (v) (sp) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in let new-bound = skip-list-text-insert local-bound n
     in collect-free-vars-act-stmts ss new-bound capturable (i + 1) len acc1
    is IrDoExec (v) (sp) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in collect-free-vars-act-stmts ss local-bound capturable (i + 1) len acc1

  collect-free-vars-clauses : List IRHandleClause, SkipListText, SkipListText, List FreeVar, Integer, Integer -> List FreeVar
  collect-free-vars-clauses (cs) (local-bound) (capturable) (acc) (i) (len) =
   if i >= len then acc
   else let c = list-at cs i
   in let clause-bound = skip-list-text-insert local-bound (c.resume-name)
   in let clause-cap = skip-list-text-insert capturable (c.resume-name)
   in let acc1 = collect-free-vars (c.body) clause-bound clause-cap acc
   in collect-free-vars-clauses cs local-bound capturable acc1 (i + 1) len

