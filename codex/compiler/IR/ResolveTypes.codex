Chapter: Resolve Types

 Resolves ConstructedTy nodes in the IR to their concrete RecordTy or
 SumTy forms using a sorted list of TypeBindings. Runs after lowering,
 before emission.

Section: Type Resolution

  strip-fun-args-resolve : CodexType -> CodexType
  strip-fun-args-resolve (ty) =
   when ty
    is FunTy (p) (r) -> strip-fun-args-resolve r
    is otherwise -> ty

  resolve-ty-deep : List TypeBinding, CodexType -> CodexType
  resolve-ty-deep (tdefs) (ty) =
   when ty
    is ConstructedTy (cname) (cargs) ->
     if list-length cargs > 0 then deck-record (ConstructedTy cname (resolve-ty-list tdefs cargs 0 (list-length cargs) []))
     else let raw = lookup-type-bsearch tdefs (cname.value)
     in when raw
      is RecordTy (rn) (ra) (rf) -> raw
      is SumTy (sn) (sa) (sc) -> raw
      is FunTy (p) (r) -> strip-fun-args-resolve r
      is otherwise -> deck-record (ConstructedTy cname [])
    is FunTy (p) (r) -> deck-record (FunTy (resolve-ty-deep tdefs p) (resolve-ty-deep tdefs r))
    is ListTy (e) -> deck-record (ListTy (resolve-ty-deep tdefs e))
    is LinkedListTy (e) -> deck-record (LinkedListTy (resolve-ty-deep tdefs e))
    is ForAllTy (id) (body) -> deck-record (ForAllTy id (resolve-ty-deep tdefs body))
    is EffectfulTy (effs) (sc) (ret) -> deck-record (EffectfulTy effs sc (resolve-ty-deep tdefs ret))
    is otherwise -> ty

  resolve-ty-list : List TypeBinding, List CodexType, Integer, Integer, List CodexType -> List CodexType
  resolve-ty-list (tdefs) (tys) (i) (len) (acc) =
   if i == len then acc
   else resolve-ty-list tdefs tys (i + 1) len (list-push acc (resolve-ty-deep tdefs (list-at tys i)))

Section: IR Rewrite

  rewrite-ir-pat : List TypeBinding, IRPat -> IRPat
  rewrite-ir-pat (tdefs) (p) =
   when p
    is IrVarPat (name) (t) (s) -> deck-record (IrVarPat name (resolve-ty-deep tdefs t) s)
    is IrLitPat (v) (t) (s) -> deck-record (IrLitPat v (resolve-ty-deep tdefs t) s)
    is IrCtorPat (name) (subs) (t) (s) -> deck-record (IrCtorPat name (rewrite-ir-pat-list tdefs subs 0 (list-length subs) []) (resolve-ty-deep tdefs t) s)
    is IrWildPat (s) -> p

  rewrite-ir-pat-list : List TypeBinding, List IRPat, Integer, Integer, List IRPat -> List IRPat
  rewrite-ir-pat-list (tdefs) (ps) (i) (len) (acc) =
   if i == len then acc
   else rewrite-ir-pat-list tdefs ps (i + 1) len (list-push acc (rewrite-ir-pat tdefs (list-at ps i)))

  rewrite-ir-expr : List TypeBinding, IRExpr -> IRExpr
  rewrite-ir-expr (tdefs) (e) =
   when e
    is IrIntLit (v) (s) -> e
    is IrNumLit (v) (s) -> e
    is IrTextLit (v) (s) -> e
    is IrBoolLit (v) (s) -> e
    is IrCharLit (v) (s) -> e
    is IrName (n) (t) (s) -> deck-record (IrName n (resolve-ty-deep tdefs t) s)
    is IrBinary (op) (l) (r) (t) (s) -> deck-record (IrBinary op (rewrite-ir-expr tdefs l) (rewrite-ir-expr tdefs r) (resolve-ty-deep tdefs t) s)
    is IrNegate (x) (s) -> deck-record (IrNegate (rewrite-ir-expr tdefs x) s)
    is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf (rewrite-ir-expr tdefs c) (rewrite-ir-expr tdefs th) (rewrite-ir-expr tdefs el) (resolve-ty-deep tdefs t) s)
    is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) (rewrite-ir-expr tdefs b) s)
    is IrApply (f) (a) (t) (s) -> deck-record (IrApply (rewrite-ir-expr tdefs f) (rewrite-ir-expr tdefs a) (resolve-ty-deep tdefs t) s)
    is IrLambda (ps) (b) (t) (s) -> deck-record (IrLambda (rewrite-ir-params tdefs ps 0 (list-length ps) []) (rewrite-ir-expr tdefs b) (resolve-ty-deep tdefs t) s)
    is IrList (es) (t) (s) -> deck-record (IrList (rewrite-ir-expr-list tdefs es 0 (list-length es) []) (resolve-ty-deep tdefs t) s)
    is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch (rewrite-ir-expr tdefs sc) (rewrite-ir-branches tdefs bs 0 (list-length bs) []) (resolve-ty-deep tdefs t) s)
    is IrAct (ss) (t) (s) -> deck-record (IrAct (rewrite-ir-act-stmts tdefs ss 0 (list-length ss) []) (resolve-ty-deep tdefs t) s)
    is IrHandle (eff) (h) (cs) (t) (s) -> deck-record (IrHandle eff (rewrite-ir-expr tdefs h) (rewrite-ir-handle-clauses tdefs cs 0 (list-length cs) []) (resolve-ty-deep tdefs t) s)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> deck-record (IrWithTimeout secs effs scopes (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
    is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n (rewrite-ir-record-fields tdefs fs 0 (list-length fs) []) (resolve-ty-deep tdefs t) s)
    is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess (rewrite-ir-expr tdefs r) f (resolve-ty-deep tdefs t) s)
    is IrFieldStore (r) (f) (v) (t) (s) -> deck-record (IrFieldStore (rewrite-ir-expr tdefs r) f (rewrite-ir-expr tdefs v) (resolve-ty-deep tdefs t) s)
    is IrFork (body) (t) (s) -> deck-record (IrFork (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
    is IrAwait (task) (t) (s) -> deck-record (IrAwait (rewrite-ir-expr tdefs task) (resolve-ty-deep tdefs t) s)
    is IrTry (max) (body) (fb) (fail) (t) (s) -> deck-record (IrTry max (rewrite-ir-act-stmts tdefs body 0 (list-length body) []) (rewrite-ir-act-stmts tdefs fb 0 (list-length fb) []) (rewrite-ir-act-stmts tdefs fail 0 (list-length fail) []) (resolve-ty-deep tdefs t) s)
    is IrError (m) (t) (s) -> deck-record (IrError m (resolve-ty-deep tdefs t) s)

  rewrite-ir-expr-list : List TypeBinding, List IRExpr, Integer, Integer, List IRExpr -> List IRExpr
  rewrite-ir-expr-list (tdefs) (es) (i) (len) (acc) =
   if i == len then acc
   else rewrite-ir-expr-list tdefs es (i + 1) len (list-push acc (rewrite-ir-expr tdefs (list-at es i)))

  rewrite-ir-params : List TypeBinding, List IRParam, Integer, Integer, List IRParam -> List IRParam
  rewrite-ir-params (tdefs) (ps) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at ps i
   in rewrite-ir-params tdefs ps (i + 1) len (list-push acc (deck-record (IRParam {
    name = p.name,
    type-val = resolve-ty-deep tdefs (p.type-val),
    span = p.span
   })))

  rewrite-ir-branches : List TypeBinding, List IRBranch, Integer, Integer, List IRBranch -> List IRBranch
  rewrite-ir-branches (tdefs) (bs) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at bs i
   in rewrite-ir-branches tdefs bs (i + 1) len (list-push acc (deck-record (IRBranch {
    pattern = rewrite-ir-pat tdefs (b.pattern),
    body = rewrite-ir-expr tdefs (b.body),
    span = b.span
   })))

  rewrite-ir-act-stmts : List TypeBinding, List IRActStmt, Integer, Integer, List IRActStmt -> List IRActStmt
  rewrite-ir-act-stmts (tdefs) (ss) (i) (len) (acc) =
   if i == len then acc
   else let s = list-at ss i
   in let ns = when s
    is IrDoBind (n) (t) (v) (sp) -> deck-record (IrDoBind n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) sp)
    is IrDoExec (v) (sp) -> deck-record (IrDoExec (rewrite-ir-expr tdefs v) sp)
   in rewrite-ir-act-stmts tdefs ss (i + 1) len (list-push acc ns)

  rewrite-ir-handle-clauses : List TypeBinding, List IRHandleClause, Integer, Integer, List IRHandleClause -> List IRHandleClause
  rewrite-ir-handle-clauses (tdefs) (cs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at cs i
   in rewrite-ir-handle-clauses tdefs cs (i + 1) len (list-push acc (deck-record (IRHandleClause {
    op-name = c.op-name,
    params = c.params,
    resume-name = c.resume-name,
    body = rewrite-ir-expr tdefs (c.body),
    span = c.span
   })))

  rewrite-ir-record-fields : List TypeBinding, List IRFieldVal, Integer, Integer, List IRFieldVal -> List IRFieldVal
  rewrite-ir-record-fields (tdefs) (fs) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fs i
   in rewrite-ir-record-fields tdefs fs (i + 1) len (list-push acc (deck-record (IRFieldVal {
    name = f.name,
    value = rewrite-ir-expr tdefs (f.value),
    span = f.span
   })))

Section: Definition Rewrite

  rewrite-ir-def : List TypeBinding, IRDef -> IRDef
  rewrite-ir-def (tdefs) (d) =
   deck-record (IRDef {
    name = d.name,
    params = rewrite-ir-params tdefs (d.params) 0 (list-length (d.params)) [],
    type-val = resolve-ty-deep tdefs (d.type-val),
    body = rewrite-ir-expr tdefs (d.body),
    chapter-slug = d.chapter-slug,
    span = d.span
   })

  rewrite-ir-defs : List TypeBinding, List IRDef, Integer, Integer, List IRDef -> List IRDef
  rewrite-ir-defs (tdefs) (defs) (i) (len) (acc) =
   if i == len then acc
   else rewrite-ir-defs tdefs defs (i + 1) len (list-push acc (rewrite-ir-def tdefs (list-at defs i)))
