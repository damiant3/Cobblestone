Chapter: Resolve Types
  cites Codex chapter Lowering (lookup-type-bsearch)
  cites Codex chapter Phase Allocator (deck-record)
  cites Codex chapter Codex Types (int-ty-default)
  cites Codex chapter CodexType Tree (codex-type-fold-children)
  cites Codex chapter X86-64 Code Generator (eq-helper-name-inst)

Section: Resolution Scope

  ResolveVars =
   | RvEmpty
   | RvPresent
   | RvBranch (ResolveVars) (ResolveVars)

  ResolveScope = record {
   types : List TypeBinding,
   vars : ResolveVars
  }

 Type-variable ids are unsigned 32-bit values. A fixed-depth radix set
 bounds lookup and persistent insertion by 32 steps, independent of the
 number of generic parameters; repeated occurrences allocate no new nodes.

  resolve-var-has : ResolveVars, Integer, Integer -> Boolean
  resolve-var-has (vars) (id) (bit) =
   when vars
    is RvEmpty -> False
    is RvPresent -> True
    is RvBranch (left) (right) ->
     if bit-and (bit-shru id bit) 1 == 0
     then resolve-var-has left id (bit - 1)
     else resolve-var-has right id (bit - 1)

  resolve-var-add : ResolveVars, Integer -> ResolveVars
  resolve-var-add (vars) (id) =
   if resolve-var-has vars id 31 then vars
   else resolve-var-add-at vars id 31

  resolve-var-add-at : ResolveVars, Integer, Integer -> ResolveVars
  resolve-var-add-at (vars) (id) (bit) =
   if bit < 0 then RvPresent
   else let left = when vars is RvBranch (l) (r) -> l is otherwise -> RvEmpty
   in let right = when vars is RvBranch (l) (r) -> r is otherwise -> RvEmpty
   in if bit-and (bit-shru id bit) 1 == 0
      then deck-record (RvBranch (resolve-var-add-at left id (bit - 1)) right)
      else deck-record (RvBranch left (resolve-var-add-at right id (bit - 1)))

  resolve-keep-vars : CodexType, ResolveVars -> ResolveVars
  resolve-keep-vars (ty) (vars) =
   when ty
    is TypeVar (id) -> resolve-var-add vars id
    is ForAllTy (id) (body) -> resolve-keep-vars body (resolve-var-add vars id)
    is UnitTy (name) (inner) -> resolve-keep-vars inner vars
    is otherwise -> codex-type-fold-children resolve-keep-vars ty vars

Section: Type Resolution

  strip-fun-args-resolve : CodexType -> CodexType
  strip-fun-args-resolve (ty) =
   when ty
    is FunTy (p) (row) (r) -> strip-fun-args-resolve r
    is otherwise -> ty

  resolve-ty-deep : ResolveScope, CodexType -> CodexType
  resolve-ty-deep (scope) (ty) =
   when ty
    is TypeVar (id) -> if resolve-var-has (scope.vars) id 31 then ty else int-ty-default
    is ConstructedTy (cname) (cargs) ->
     if list-length cargs > 0 then deck-record (ConstructedTy cname (for a in cargs -> resolve-ty-deep scope a))
     else let raw = lookup-type-bsearch (scope.types) (cname.value)
     in when raw
      is RecordTy (rn) (ra) (rf) | SumTy (sn) (sa) (sc) -> raw
      is FunTy (p) (row) (r) -> strip-fun-args-resolve r
      is otherwise -> deck-record (ConstructedTy cname [])
    is FunTy (p) (row) (r) -> deck-record (FunTy (resolve-ty-deep scope p) row (resolve-ty-deep scope r))
    is ListTy (e) -> deck-record (ListTy (resolve-ty-deep scope e))
    is LinkedListTy (e) -> deck-record (LinkedListTy (resolve-ty-deep scope e))
    is ForAllTy (id) (body) ->
     let inner = deck-record (ResolveScope { types = scope.types, vars = resolve-var-add (scope.vars) id })
     in deck-record (ForAllTy id (resolve-ty-deep inner body))
    is ForAllEff (id) (body) -> deck-record (ForAllEff id (resolve-ty-deep scope body))
    is EffectfulTy (effs) (sc) (ret) -> deck-record (EffectfulTy effs sc (resolve-ty-deep scope ret))
    is UnitTy (n) (inner) -> deck-record (UnitTy n (resolve-ty-deep scope inner))
    is VectorTy (vn) (vt) -> deck-record (VectorTy vn (resolve-ty-deep scope vt))
    is VectorMaskTy (n) (me) -> deck-record (VectorMaskTy n (resolve-ty-deep scope me))
    is TypeApply (tf) (ta) -> let rf = resolve-ty-deep scope tf in let ra = resolve-ty-deep scope ta in when rf is TypeCon (rn) -> if rn.value == "List" then deck-record (ListTy ra) else deck-record (ConstructedTy rn [ra]) is otherwise -> deck-record (TypeApply rf ra)
    is TypeCon (n) -> ty
    is LinearTy (linner) -> resolve-ty-deep scope linner
    is otherwise -> ty

Section: IR Rewrite

 An instantiated equality helper's name carries its actuals, and lowering
 spells them BEFORE this pass closes a leftover variable to `int-ty-default`:
 `[] == []` was named `__eq_List@#N` while the backend minted the helper from
 the closed argument type, `__eq_List@Integer`, and the call was CDX2040.
 The actuals are respelled here from the resolved parameter type, which is the
 type the backend's collector names the helper from.

  eq-inst-rename : Text, CodexType -> Text
  eq-inst-rename (n) (t) =
   if text-starts-with n "__eq_" == False then n
   else let at = eq-inst-at n 5 (text-length n)
   in if at < 0 then n
   else when t
    is FunTy (p) (row) (r) -> eq-helper-name-inst (substring n 5 (at - 5)) (eq-site-actuals (strip-unit-ty p))
    is otherwise -> n

  eq-inst-at : Text, Integer, Integer -> Integer
  eq-inst-at (n) (i) (len) =
   if i >= len then 0 - 1
   else if char-code (char-at n i) == char-code (char-at "@" 0) then i
   else eq-inst-at n (i + 1) len

  rewrite-ir-pat : ResolveScope, IRPat -> IRPat
  rewrite-ir-pat (scope) (p) =
   when p
    is IrVarPat (name) (t) (s) -> deck-record (IrVarPat name (resolve-ty-deep scope t) s)
    is IrLitPat (v) (t) (s) -> deck-record (IrLitPat v (resolve-ty-deep scope t) s)
    is IrCtorPat (name) (subs) (t) (s) -> deck-record (IrCtorPat name (for p2 in subs -> rewrite-ir-pat scope p2) (resolve-ty-deep scope t) s)
    is IrWildPat (s) -> p
    is IrVecPat (subs) (t) (s) -> deck-record (IrVecPat (for p2 in subs -> rewrite-ir-pat scope p2) (resolve-ty-deep scope t) s)

  rewrite-ir-expr : ResolveScope, IRExpr -> IRExpr
  rewrite-ir-expr (scope) (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> e
    is IrName (n) (t) (s) -> let rt = resolve-ty-deep scope t in deck-record (IrName (eq-inst-rename n rt) rt s)
    is IrBinary (op) (l) (r) (t) (s) -> deck-record (IrBinary op (rewrite-ir-expr scope l) (rewrite-ir-expr scope r) (resolve-ty-deep scope t) s)
    is IrNegate (x) (t) (s) -> deck-record (IrNegate (rewrite-ir-expr scope x) (resolve-ty-deep scope t) s)
    is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf (rewrite-ir-expr scope c) (rewrite-ir-expr scope th) (rewrite-ir-expr scope el) (resolve-ty-deep scope t) s)
    is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n (resolve-ty-deep scope t) (rewrite-ir-expr scope v) (rewrite-ir-expr scope b) s)
    is IrApply (f) (a) (t) (s) -> deck-record (IrApply (rewrite-ir-expr scope f) (rewrite-ir-expr scope a) (resolve-ty-deep scope t) s)
    is IrLambda (ps) (b) (t) (s) -> deck-record (IrLambda (for p in ps -> deck-record (IRParam { name = p.name, type-val = resolve-ty-deep scope (p.type-val), span = p.span })) (rewrite-ir-expr scope b) (resolve-ty-deep scope t) s)
    is IrList (es) (t) (s) -> deck-record (IrList (for x in es -> rewrite-ir-expr scope x) (resolve-ty-deep scope t) s)
    is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch (rewrite-ir-expr scope sc) (for b in bs -> deck-record (IRBranch { pattern = rewrite-ir-pat scope (b.pattern), body = rewrite-ir-expr scope (b.body), guard = rewrite-ir-expr scope (b.guard), span = b.span, alt-group = b.alt-group })) (resolve-ty-deep scope t) s)
    is IrAct (ss) (t) (s) -> deck-record (IrAct (rewrite-ir-act-stmts scope ss) (resolve-ty-deep scope t) s)
    is IrHandle (eff) (h) (cs) (t) (s) -> deck-record (IrHandle eff (rewrite-ir-expr scope h) (for c in cs -> deck-record (IRHandleClause { op-name = c.op-name, params = c.params, resume-name = c.resume-name, body = rewrite-ir-expr scope (c.body), span = c.span })) (resolve-ty-deep scope t) s)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> deck-record (IrWithTimeout secs effs scopes (rewrite-ir-expr scope body) (resolve-ty-deep scope t) s)
    is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n (for f in fs -> deck-record (IRFieldVal { name = f.name, value = rewrite-ir-expr scope (f.value), span = f.span })) (resolve-ty-deep scope t) s)
    is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess (rewrite-ir-expr scope r) f (resolve-ty-deep scope t) s)
    is IrFieldStore (r) (f) (v) (t) (s) -> deck-record (IrFieldStore (rewrite-ir-expr scope r) f (rewrite-ir-expr scope v) (resolve-ty-deep scope t) s)
    is IrFork (body) (t) (s) -> deck-record (IrFork (rewrite-ir-expr scope body) (resolve-ty-deep scope t) s)
    is IrAwait (task) (t) (s) -> deck-record (IrAwait (rewrite-ir-expr scope task) (resolve-ty-deep scope t) s)
    is IrTry (max) (body) (fb) (fail) (t) (s) -> deck-record (IrTry max (rewrite-ir-act-stmts scope body) (rewrite-ir-act-stmts scope fb) (rewrite-ir-act-stmts scope fail) (resolve-ty-deep scope t) s)
    is IrError (m) (t) (s) -> deck-record (IrError m (resolve-ty-deep scope t) s)

  rewrite-ir-act-stmts : ResolveScope, List IRActStmt -> List IRActStmt
  rewrite-ir-act-stmts (scope) (ss) =
   for stmt in ss -> when stmt
    is IrDoBind (n) (t) (v) (sp) -> deck-record (IrDoBind n (resolve-ty-deep scope t) (rewrite-ir-expr scope v) sp)
    is IrDoExec (v) (sp) -> deck-record (IrDoExec (rewrite-ir-expr scope v) sp)

Section: Definition Rewrite

  rewrite-ir-def : List TypeBinding, IRDef -> IRDef
  rewrite-ir-def (tdefs) (d) =
   let vars = resolve-keep-vars (d.type-val) RvEmpty
   in let scope = deck-record (ResolveScope { types = tdefs, vars = vars })
   in deck-record (IRDef {
    name = d.name,
    params = for p in (d.params) -> deck-record (IRParam { name = p.name, type-val = resolve-ty-deep scope (p.type-val), span = p.span }),
    type-val = resolve-ty-deep scope (d.type-val),
    body = rewrite-ir-expr scope (d.body),
    chapter-slug = d.chapter-slug,
    is-punctual = d.is-punctual,
    wcet-budget = d.wcet-budget,
    unique-params = d.unique-params,
    span = d.span
   })

 The ceiling is the RESOLVE deck reservation's top, checked per
 definition because this loop is where the phase writes the deck in
 bulk: one rewritten type tree per definition. Measured 2026-07-21 on
 the 2.81 MB selfhost with deck-pos probes, this walk writes 20,029,096
 bytes of the RESOLVE deck's 20,370,712, against 161,112 for
 build-type-def-map and 180,504 for sort-bindings -- so guarding those
 two instead would have bought 1.7 per cent of the phase, which is the
 mistake the SCOPE guard made on its first attempt.

 A definition's rewrite writes kilobytes against an 8 MB band, so a
 per-definition check cannot be outrun. The stop returns the
 definitions rewritten so far; compile-frontend-cdx reads deck-short-of
 again after the walk and raises CDX9002 from there.

  rewrite-ir-defs : List TypeBinding, List IRDef, Integer -> List IRDef
  rewrite-ir-defs (tdefs) (defs) (ceiling) =
   rewrite-ir-defs-acc tdefs defs 0 (list-length defs) [] ceiling

  rewrite-ir-defs-acc : List TypeBinding, List IRDef, Integer, Integer, List IRDef, Integer -> List IRDef
  rewrite-ir-defs-acc (tdefs) (defs) (i) (len) (acc) (ceiling) =
   if i == len then acc
   else if deck-bound-short-of ceiling demand-resolve-guard-band then acc
   else rewrite-ir-defs-acc tdefs defs (i + 1) len (list-push acc (rewrite-ir-def tdefs (list-at defs i))) ceiling
