Chapter: X86-64 Code Generator

 List runtime helpers emitted into every x86-64-bare binary: cons,
 append, snoc, insert-at, set-at, tail, and concat-many.

Section: List Views

 A tail view is the O(1) answer to taking a flat list apart
 structurally. A plain list is [capacity][length][e0][e1]... with the
 pointer at the length cell; its tail cannot be a pointer into the
 same block, because the cell before any element holds another
 element, not a header. A view is a three-cell record
 [capacity = -1][length][q] where q is a PHANTOM list pointer: the
 backing block's element k-1 slot address, chosen so that q+8 is the
 view's first element -- exactly the shape every element loop already
 assumes of a plain list pointer. One selection therefore adapts any
 reader: load the capacity cell at [p-8]; negative means view, and
 the phantom base at [p+8] replaces p; everything downstream keeps
 its +8 displacements unchanged.

 The sentinel is sound because no plain list has negative capacity
 (the empty literal has capacity zero, cons and snoc floor theirs at
 four), and every in-place mutation path is unreachable for a view
 by arithmetic: len >= -1 always routes snoc and insert-at to their
 copy paths, cap - lenA >= lenB never holds for cap = -1, and the
 frontier-extend test p + (cap+1)*8 == allocator-pos compares p
 against a position strictly past the view's own three cells. A view
 read back through any copying operation produces a plain list; a
 write through list-set-at lands in the backing, which is the same
 aliasing contract list-set-at already documents for plain lists.

 emit-list-eff-base appends the four-instruction selection: preg is
 the register holding the list pointer and is REPLACED by the
 effective base (phantom q for a view, unchanged for a plain list);
 scratch is clobbered. Call it only after every header read of preg
 is done, because afterwards preg no longer points at a header.

  emit-list-eff-base : CodegenState, Integer, Integer -> CodegenState
  emit-list-eff-base (st) (preg) (scratch) =
    let st1 = st-append-code st (mov-load scratch preg (-8))
   in let st2 = st-append-code st1 (cmp-ri scratch 0)
   in let plain-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (mov-load preg preg 8)
   in patch-jcc-at st4 plain-pos (st4.code-len)

Section: __list_tail

 rdi = list. Returns a view whose length is one less (floored at
 zero) and whose phantom base is the caller's effective base plus
 eight, which skips exactly one element whether the input was plain
 or itself a view. Allocates three cells from R10; inside a
 deck-record extent R10 is the deck, the same rule every list
 literal follows.

  emit-list-tail : CodegenState -> CodegenState
  emit-list-tail (st) =
    let st0 = record-func-offset st "__list_tail"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (sub-ri reg-rcx 1)
   in let st3 = st-append-code st2 (cmp-ri reg-rcx 0)
   in let len-ok-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (li reg-rcx 0)
   in let st6 = patch-jcc-at st5 len-ok-pos (st5.code-len)
   in let st7 = emit-list-eff-base st6 reg-rdi reg-rax
   in let st8 = st-append-code st7 (add-ri reg-rdi 8)
   in let st9 = st-append-code st8 (li reg-rax 0)
   in let st10 = st-append-code st9 (sub-ri reg-rax 1)
   in let st11 = st-append-code st10 (mov-store reg-r10 reg-rax 0)
   in let st12 = st-append-code st11 (add-ri reg-r10 8)
   in let st13 = st-append-code st12 (mov-rr reg-rax reg-r10)
   in let st14 = st-append-code st13 (mov-store reg-rax reg-rcx 0)
   in let st15 = st-append-code st14 (mov-store reg-rax reg-rdi 8)
   in let st16 = st-append-code st15 (add-ri reg-r10 16)
   in st-append-code st16 x86-ret

Section: __list_cons
  emit-list-cons-alloc : CodegenState -> CodegenState
  emit-list-cons-alloc (st) =
    let st0 = record-func-offset st "__list_cons"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rsi 0)
   in let st1b = emit-list-eff-base st1 reg-rsi reg-rax
   in let st2 = st-append-code st1b (mov-rr reg-rdx reg-rcx)
   in let st3 = st-append-code st2 (add-ri reg-rdx 1)
   in let st4 = st-append-code st3 (mov-rr reg-r11 reg-rdx)
   in let st5 = st-append-code st4 (shl-ri reg-r11 1)
   in let st6 = st-append-code st5 (cmp-ri reg-r11 4)
   in let cap-ok-pos = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-ge 0)
   in let st8 = st-append-code st7 (li reg-r11 4)
   in let st9 = patch-jcc-at st8 cap-ok-pos (st8.code-len)
   in let st10 = st-append-code st9 (mov-store reg-r10 reg-r11 0)
   in let st11 = st-append-code st10 (add-ri reg-r10 8)
   in let st12 = st-append-code st11 (mov-rr reg-rax reg-r10)
   in let st13 = st-append-code st12 (add-ri reg-r11 1)
   in let st14 = st-append-code st13 (shl-ri reg-r11 3)
   in let st15 = st-append-code st14 (add-rr reg-r10 reg-r11)
   in let st16 = st-append-code st15 (mov-store reg-rax reg-rdx 0)
   in st-append-code st16 (mov-store reg-rax reg-rdi 8)

  emit-list-cons-copy : CodegenState -> CodegenState
  emit-list-cons-copy (st) =
    let st0 = st-append-code st (shl-ri reg-rcx 3)
   in let st1 = st-append-code st0 (li reg-r11 0)
   in let loop-top = st1.code-len
   in let st2 = st-append-code st1 (cmp-rr reg-r11 reg-rcx)
   in let exit-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (mov-rr reg-rdx reg-rsi)
   in let st5 = st-append-code st4 (add-rr reg-rdx reg-r11)
   in let st6 = st-append-code st5 (mov-load reg-rdx reg-rdx 8)
   in let st7 = st-append-code st6 (mov-rr reg-rdi reg-rax)
   in let st8 = st-append-code st7 (add-rr reg-rdi reg-r11)
   in let st9 = st-append-code st8 (mov-store reg-rdi reg-rdx 16)
   in let st10 = st-append-code st9 (add-ri reg-r11 8)
   in let st11 = st-append-code st10 (jmp (loop-top - (st10.code-len + 5)))
   in let st12 = patch-jcc-at st11 exit-pos (st11.code-len)
   in st-append-code st12 x86-ret

  emit-list-cons : CodegenState -> CodegenState
  emit-list-cons (st) =
    let st0 = emit-list-cons-alloc st
   in emit-list-cons-copy st0

Section: __list_append
  emit-list-append-prologue : CodegenState -> HelpResult1
  emit-list-append-prologue (st) =
    let st0 = record-func-offset st "__list_append"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (mov-load reg-rdx reg-rsi 0)
   in let st3 = st-append-code st2 (mov-load reg-r11 reg-rdi (-8))
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-r11)
   in let st5 = st-append-code st4 (sub-rr reg-rax reg-rcx)
   in let st6 = st-append-code st5 (cmp-rr reg-rax reg-rdx)
   in let p2-pos = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-l 0)
   in HelpResult1 { cg = st7, p1 = p2-pos }

  emit-list-append-path1 : CodegenState -> CodegenState
  emit-list-append-path1 (st) =
    let st0 = st-append-code st (mov-rr reg-rax reg-rcx)
   in let st1 = st-append-code st0 (shl-ri reg-rax 3)
   in let st2 = st-append-code st1 (add-rr reg-rax reg-rdi)
   in let st3 = st-append-code st2 (mov-rr reg-r11 reg-rsi)
   in let st3b = emit-list-eff-base st3 reg-r11 reg-rcx
   in let st4 = st-append-code st3b (cmp-ri reg-rdx 0)
   in let skip-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-e 0)
   in let loop-pos = st5.code-len
   in let st6 = st-append-code st5 (mov-load reg-rcx reg-r11 8)
   in let st7 = st-append-code st6 (mov-store reg-rax reg-rcx 8)
   in let st8 = st-append-code st7 (add-ri reg-rax 8)
   in let st9 = st-append-code st8 (add-ri reg-r11 8)
   in let st10 = st-append-code st9 (sub-ri reg-rdx 1)
   in let st11 = st-append-code st10 (jcc cc-ne (loop-pos - (st10.code-len + 6)))
   in let st12 = patch-jcc-at st11 skip-pos (st11.code-len)
   in let st13 = st-append-code st12 (mov-load reg-rcx reg-rdi 0)
   in let st14 = st-append-code st13 (mov-load reg-rdx reg-rsi 0)
   in let st15 = st-append-code st14 (add-rr reg-rcx reg-rdx)
   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)
   in let st17 = st-append-code st16 (mov-rr reg-rax reg-rdi)
   in st-append-code st17 x86-ret

  emit-list-append-path2-alloc : CodegenState, Integer -> CodegenState
  emit-list-append-path2-alloc (st) (p2-pos) =
    let st0 = patch-jcc-at st p2-pos (st.code-len)
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rsi)
   in let st6 = st-append-code st5 (mov-load reg-rcx reg-rbx 0)
   in let st7 = st-append-code st6 (mov-load reg-rdx reg-r12 0)
   in let st8 = st-append-code st7 (mov-rr reg-r13 reg-rcx)
   in let st9 = st-append-code st8 (add-rr reg-r13 reg-rdx)
   in let st10 = st-append-code st9 (mov-rr reg-rax reg-r13)
   in let st11 = st-append-code st10 (shl-ri reg-rax 1)
   in let st12 = st-append-code st11 (cmp-ri reg-rax 4)
   in let cap-ok-pos = st12.code-len
   in let st13 = st-append-code st12 (jcc cc-ge 0)
   in let st14 = st-append-code st13 (li reg-rax 4)
   in let st15 = patch-jcc-at st14 cap-ok-pos (st14.code-len)
   in let st16 = st-append-code st15 (mov-store reg-r10 reg-rax 0)
   in let st17 = st-append-code st16 (add-ri reg-r10 8)
   in let st18 = st-append-code st17 (mov-rr reg-rsi reg-r10)
   in let st19 = st-append-code st18 (mov-rr reg-r11 reg-rax)
   in let st20 = st-append-code st19 (add-ri reg-r11 1)
   in let st21 = st-append-code st20 (shl-ri reg-r11 3)
   in let st22 = st-append-code st21 (add-rr reg-r10 reg-r11)
   in st-append-code st22 (mov-store reg-rsi reg-r13 0)

  emit-list-append-path2-copy-a : CodegenState -> CodegenState
  emit-list-append-path2-copy-a (st) =
    let st0a = st-append-code st (mov-rr reg-rax reg-rbx)
   in let st0 = emit-list-eff-base st0a reg-rax reg-r11
   in let st1 = st-append-code st0 (mov-rr reg-rdi reg-rsi)
   in let st2 = st-append-code st1 (cmp-ri reg-rcx 0)
   in let skip-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-e 0)
   in let loop-pos = st3.code-len
   in let st4 = st-append-code st3 (mov-load reg-r11 reg-rax 8)
   in let st5 = st-append-code st4 (mov-store reg-rdi reg-r11 8)
   in let st6 = st-append-code st5 (add-ri reg-rax 8)
   in let st7 = st-append-code st6 (add-ri reg-rdi 8)
   in let st8 = st-append-code st7 (sub-ri reg-rcx 1)
   in let st9 = st-append-code st8 (jcc cc-ne (loop-pos - (st8.code-len + 6)))
   in patch-jcc-at st9 skip-pos (st9.code-len)

  emit-list-append-path2-copy-b : CodegenState -> CodegenState
  emit-list-append-path2-copy-b (st) =
    let st0a = st-append-code st (mov-rr reg-rax reg-r12)
   in let st0 = emit-list-eff-base st0a reg-rax reg-r11
   in let st1 = st-append-code st0 (cmp-ri reg-rdx 0)
   in let skip-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let loop-pos = st2.code-len
   in let st3 = st-append-code st2 (mov-load reg-r11 reg-rax 8)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-r11 8)
   in let st5 = st-append-code st4 (add-ri reg-rax 8)
   in let st6 = st-append-code st5 (add-ri reg-rdi 8)
   in let st7 = st-append-code st6 (sub-ri reg-rdx 1)
   in let st8 = st-append-code st7 (jcc cc-ne (loop-pos - (st7.code-len + 6)))
   in let st9 = patch-jcc-at st8 skip-pos (st8.code-len)
   in let st10 = st-append-code st9 (mov-rr reg-rax reg-rsi)
   in let st11 = st-append-code st10 (pop-r reg-r13)
   in let st12 = st-append-code st11 (pop-r reg-r12)
   in let st13 = st-append-code st12 (pop-r reg-rbx)
   in st-append-code st13 x86-ret

  emit-list-append : CodegenState -> CodegenState
  emit-list-append (st) =
    let h = emit-list-append-prologue st
   in let st1 = emit-list-append-path1 (h.cg)
   in let st2 = emit-list-append-path2-alloc st1 (h.p1)
   in let st3 = emit-list-append-path2-copy-a st2
   in emit-list-append-path2-copy-b st3

Section: __list_snoc
  emit-list-push-path1 : CodegenState -> HelpResult1
  emit-list-push-path1 (st) =
    let st0 = record-func-offset st "__list_snoc"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (mov-load reg-rdx reg-rdi (-8))
   in let st3 = st-append-code st2 (cmp-rr reg-rcx reg-rdx)
   in let path2-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-rr reg-rax reg-rcx)
   in let st6 = st-append-code st5 (shl-ri reg-rax 3)
   in let st7 = st-append-code st6 (add-rr reg-rax reg-rdi)
   in let st8 = st-append-code st7 (mov-store reg-rax reg-rsi 8)
   in let st9 = st-append-code st8 (add-ri reg-rcx 1)
   in let st10 = st-append-code st9 (mov-store reg-rdi reg-rcx 0)
   in let st11 = st-append-code st10 (mov-rr reg-rax reg-rdi)
   in let st12 = st-append-code st11 x86-ret
   in HelpResult1 {
    cg = st12,
    p1 = path2-pos
   }

  emit-list-push-path2 : CodegenState, Integer -> HelpResult1
  emit-list-push-path2 (st) (path2-pos) =
    let st0 = patch-jcc-at st path2-pos (st.code-len)
   in let st1 = st-append-code st0 (mov-rr reg-rax reg-rdx)
   in let st2 = st-append-code st1 (add-ri reg-rax 1)
   in let st3 = st-append-code st2 (shl-ri reg-rax 3)
   in let st4 = st-append-code st3 (add-rr reg-rax reg-rdi)
   in let st5 = st-append-code st4 (cmp-rr reg-rax reg-r10)
   in let heap-grow-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let st6a = st-append-code st6 (li reg-r11 deck-pos-addr)
   in let st6b = st-append-code st6a (mov-load reg-r11 reg-r11 0)
   in let st6c = st-append-code st6b (cmp-rr reg-rax reg-r11)
   in let path3-pos = st6c.code-len
   in let st6d = st-append-code st6c (jcc cc-ne 0)
   in let d1 = st-append-code st6d (mov-rr reg-rax reg-rdx)
   in let d2 = st-append-code d1 (shl-ri reg-rax 1)
   in let d3 = st-append-code d2 (cmp-ri reg-rax 4)
   in let dcap-pos = d3.code-len
   in let d4 = st-append-code d3 (jcc cc-ge 0)
   in let d5 = st-append-code d4 (li reg-rax 4)
   in let d6 = patch-jcc-at d5 dcap-pos (d5.code-len)
   in let d7 = st-append-code d6 (mov-store reg-rdi reg-rax (-8))
   in let d8 = st-append-code d7 (sub-rr reg-rax reg-rdx)
   in let d9 = st-append-code d8 (shl-ri reg-rax 3)
   in let d10 = st-append-code d9 (push-r reg-rax)
   in let d11 = st-append-code d10 (li reg-r11 deck-pos-addr)
   in let d12 = st-append-code d11 (mov-load reg-rax reg-r11 0)
   in let d13 = st-append-code d12 (pop-r reg-r11)
   in let d14 = st-append-code d13 (add-rr reg-rax reg-r11)
   in let d15 = st-append-code d14 (li reg-r11 deck-pos-addr)
   in let d16 = st-append-code d15 (mov-store reg-r11 reg-rax 0)
   in let d17 = st-append-code d16 (mov-rr reg-rax reg-rcx)
   in let d18 = st-append-code d17 (shl-ri reg-rax 3)
   in let to-store-pos = d18.code-len
   in let d19 = st-append-code d18 (jmp 0)
   in let h0 = patch-jcc-at d19 heap-grow-pos (d19.code-len)
   in let h1 = st-append-code h0 (mov-rr reg-rax reg-rdx)
   in let h2 = st-append-code h1 (shl-ri reg-rax 1)
   in let h3 = st-append-code h2 (cmp-ri reg-rax 4)
   in let hcap-pos = h3.code-len
   in let h4 = st-append-code h3 (jcc cc-ge 0)
   in let h5 = st-append-code h4 (li reg-rax 4)
   in let h6 = patch-jcc-at h5 hcap-pos (h5.code-len)
   in let h7 = st-append-code h6 (mov-store reg-rdi reg-rax (-8))
   in let h8 = st-append-code h7 (sub-rr reg-rax reg-rdx)
   in let h9 = st-append-code h8 (shl-ri reg-rax 3)
   in let h10 = st-append-code h9 (add-rr reg-r10 reg-rax)
   in let h11 = st-append-code h10 (mov-rr reg-rax reg-rcx)
   in let h12 = st-append-code h11 (shl-ri reg-rax 3)
   in let h13 = patch-jmp-at h12 to-store-pos (h12.code-len)
   in HelpResult1 {
    cg = h13,
    p1 = path3-pos
   }

  emit-list-push-path2-store : CodegenState -> CodegenState
  emit-list-push-path2-store (st) =
    let st0 = st-append-code st (add-rr reg-rax reg-rdi)
   in let st1 = st-append-code st0 (mov-store reg-rax reg-rsi 8)
   in let st2 = st-append-code st1 (add-ri reg-rcx 1)
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rcx 0)
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-rdi)
   in st-append-code st4 x86-ret

  emit-list-push-path3-alloc : CodegenState, Integer -> CodegenState
  emit-list-push-path3-alloc (st) (path3-pos) =
    let st0 = patch-jcc-at st path3-pos (st.code-len)
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rsi)
   in let st6 = st-append-code st5 (mov-rr reg-r13 reg-rcx)
   in let st7 = st-append-code st6 (shl-ri reg-r13 1)
   in let st8 = st-append-code st7 (cmp-ri reg-r13 4)
   in let cap-ok2-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ge 0)
   in let st10 = st-append-code st9 (li reg-r13 4)
   in let st11 = patch-jcc-at st10 cap-ok2-pos (st10.code-len)
   in let st12 = st-append-code st11 (mov-store reg-r10 reg-r13 0)
   in let st13 = st-append-code st12 (add-ri reg-r10 8)
   in let st14 = st-append-code st13 (mov-rr reg-rax reg-r10)
   in let st15 = st-append-code st14 (mov-rr reg-rdx reg-r13)
   in let st16 = st-append-code st15 (add-ri reg-rdx 1)
   in let st17 = st-append-code st16 (shl-ri reg-rdx 3)
   in st-append-code st17 (add-rr reg-r10 reg-rdx)

  emit-list-push-path3-copy : CodegenState -> CodegenState
  emit-list-push-path3-copy (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (mov-rr reg-rdx reg-rcx)
   in let st2 = st-append-code st1 (add-ri reg-rdx 1)
   in let st3 = st-append-code st2 (mov-store reg-rax reg-rdx 0)
   in let st3b = emit-list-eff-base st3 reg-rbx reg-rdx
   in let st4 = st-append-code st3b (li reg-r11 0)
   in let copy-loop = st4.code-len
   in let st5 = st-append-code st4 (cmp-rr reg-r11 reg-rcx)
   in let copy-done-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mov-rr reg-rdx reg-r11)
   in let st8 = st-append-code st7 (shl-ri reg-rdx 3)
   in let st9 = st-append-code st8 (mov-rr reg-rsi reg-rbx)
   in let st10 = st-append-code st9 (add-rr reg-rsi reg-rdx)
   in let st11 = st-append-code st10 (mov-load reg-rsi reg-rsi 8)
   in let st12 = st-append-code st11 (mov-rr reg-rdi reg-rax)
   in let st13 = st-append-code st12 (add-rr reg-rdi reg-rdx)
   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rsi 8)
   in let st15 = st-append-code st14 (add-ri reg-r11 1)
   in let st16 = st-append-code st15 (jmp (copy-loop - (st15.code-len + 5)))
   in patch-jcc-at st16 copy-done-pos (st16.code-len)

  emit-list-push-path3-finish : CodegenState -> CodegenState
  emit-list-push-path3-finish (st) =
    let st0 = st-append-code st (mov-rr reg-rdx reg-rcx)
   in let st1 = st-append-code st0 (shl-ri reg-rdx 3)
   in let st2 = st-append-code st1 (mov-rr reg-rdi reg-rax)
   in let st3 = st-append-code st2 (add-rr reg-rdi reg-rdx)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-r12 8)
   in let st5 = st-append-code st4 (pop-r reg-r13)
   in let st6 = st-append-code st5 (pop-r reg-r12)
   in let st7 = st-append-code st6 (pop-r reg-rbx)
   in st-append-code st7 x86-ret

  emit-list-push : CodegenState -> CodegenState
  emit-list-push (st) =
    let p1 = emit-list-push-path1 st
   in let p2 = emit-list-push-path2 (p1.cg) (p1.p1)
   in let st0 = emit-list-push-path2-store (p2.cg)
   in let st1 = emit-list-push-path3-alloc st0 (p2.p1)
   in let st2 = emit-list-push-path3-copy st1
   in emit-list-push-path3-finish st2

Section: __deck_list_snoc

 Phase-discipline twin of __list_snoc that allocates from the deck
 pointer instead of the bivy bump pointer R10. The body mirrors
 __list_snoc; the only differences are (a) the prologue saves R14
 and loads deck-pos into it, (b) every R10 reference in the alloc
 paths is replaced with R14, and (c) every return is preceded by
 writing R14 back to the deck-pos cell and restoring R14 from the
 stack. R10 (bivy) is untouched throughout, so a snoc that fires
 path-3 leaves the bivy bump pointer where it was — only the deck
 grows. emit-apply for `list-push` dispatches here when
 st.deck-bound is True at the call site.

  emit-deck-snoc-prologue : CodegenState -> CodegenState
  emit-deck-snoc-prologue (st) =
    let st0 = record-func-offset st "__deck_list_snoc"
   in let st1 = st-append-code st0 (push-r reg-r14)
   in let st2 = st-append-code st1 (li reg-r11 deck-pos-addr)
   in st-append-code st2 (mov-load reg-r14 reg-r11 0)

  emit-deck-snoc-tail : CodegenState -> CodegenState
  emit-deck-snoc-tail (st) =
    let st1 = st-append-code st (li reg-r11 deck-pos-addr)
   in let st2 = st-append-code st1 (mov-store reg-r11 reg-r14 0)
   in let st3 = st-append-code st2 (pop-r reg-r14)
   in st-append-code st3 x86-ret

  emit-deck-snoc-path1 : CodegenState -> HelpResult1
  emit-deck-snoc-path1 (st) =
    let st1 = st-append-code st (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (mov-load reg-rdx reg-rdi (-8))
   in let st3 = st-append-code st2 (cmp-rr reg-rcx reg-rdx)
   in let path2-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-rr reg-rax reg-rcx)
   in let st6 = st-append-code st5 (shl-ri reg-rax 3)
   in let st7 = st-append-code st6 (add-rr reg-rax reg-rdi)
   in let st8 = st-append-code st7 (mov-store reg-rax reg-rsi 8)
   in let st9 = st-append-code st8 (add-ri reg-rcx 1)
   in let st10 = st-append-code st9 (mov-store reg-rdi reg-rcx 0)
   in let st11 = st-append-code st10 (mov-rr reg-rax reg-rdi)
   in let st12 = emit-deck-snoc-tail st11
   in HelpResult1 {
    cg = st12,
    p1 = path2-pos
   }

  emit-deck-snoc-path2 : CodegenState, Integer -> HelpResult1
  emit-deck-snoc-path2 (st) (path2-pos) =
    let st0 = patch-jcc-at st path2-pos (st.code-len)
   in let st1 = st-append-code st0 (mov-rr reg-rax reg-rdx)
   in let st2 = st-append-code st1 (add-ri reg-rax 1)
   in let st3 = st-append-code st2 (shl-ri reg-rax 3)
   in let st4 = st-append-code st3 (add-rr reg-rax reg-rdi)
   in let st5 = st-append-code st4 (cmp-rr reg-rax reg-r14)
   in let path3-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ne 0)
   in let st7 = st-append-code st6 (mov-rr reg-rax reg-rdx)
   in let st8 = st-append-code st7 (shl-ri reg-rax 1)
   in let st9 = st-append-code st8 (cmp-ri reg-rax 4)
   in let cap-ok-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-ge 0)
   in let st11 = st-append-code st10 (li reg-rax 4)
   in let st12 = patch-jcc-at st11 cap-ok-pos (st11.code-len)
   in let st13 = st-append-code st12 (mov-store reg-rdi reg-rax (-8))
   in let st14 = st-append-code st13 (sub-rr reg-rax reg-rdx)
   in let st15 = st-append-code st14 (shl-ri reg-rax 3)
   in let st16 = st-append-code st15 (add-rr reg-r14 reg-rax)
   in let st17 = st-append-code st16 (mov-rr reg-rax reg-rcx)
   in let st18 = st-append-code st17 (shl-ri reg-rax 3)
   in HelpResult1 {
    cg = st18,
    p1 = path3-pos
   }

  emit-deck-snoc-path2-store : CodegenState -> CodegenState
  emit-deck-snoc-path2-store (st) =
    let st0 = st-append-code st (add-rr reg-rax reg-rdi)
   in let st1 = st-append-code st0 (mov-store reg-rax reg-rsi 8)
   in let st2 = st-append-code st1 (add-ri reg-rcx 1)
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rcx 0)
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-rdi)
   in emit-deck-snoc-tail st4

  emit-deck-snoc-path3-alloc : CodegenState, Integer -> CodegenState
  emit-deck-snoc-path3-alloc (st) (path3-pos) =
    let st0 = patch-jcc-at st path3-pos (st.code-len)
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rsi)
   in let st6 = st-append-code st5 (mov-rr reg-r13 reg-rcx)
   in let st7 = st-append-code st6 (shl-ri reg-r13 1)
   in let st8 = st-append-code st7 (cmp-ri reg-r13 4)
   in let cap-ok2-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ge 0)
   in let st10 = st-append-code st9 (li reg-r13 4)
   in let st11 = patch-jcc-at st10 cap-ok2-pos (st10.code-len)
   in let st12 = st-append-code st11 (mov-store reg-r14 reg-r13 0)
   in let st13 = st-append-code st12 (add-ri reg-r14 8)
   in let st14 = st-append-code st13 (mov-rr reg-rax reg-r14)
   in let st15 = st-append-code st14 (mov-rr reg-rdx reg-r13)
   in let st16 = st-append-code st15 (add-ri reg-rdx 1)
   in let st17 = st-append-code st16 (shl-ri reg-rdx 3)
   in st-append-code st17 (add-rr reg-r14 reg-rdx)

  emit-deck-snoc-path3-copy : CodegenState -> CodegenState
  emit-deck-snoc-path3-copy (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (mov-rr reg-rdx reg-rcx)
   in let st2 = st-append-code st1 (add-ri reg-rdx 1)
   in let st3 = st-append-code st2 (mov-store reg-rax reg-rdx 0)
   in let st3b = emit-list-eff-base st3 reg-rbx reg-rdx
   in let st4 = st-append-code st3b (li reg-r11 0)
   in let copy-loop = st4.code-len
   in let st5 = st-append-code st4 (cmp-rr reg-r11 reg-rcx)
   in let copy-done-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mov-rr reg-rdx reg-r11)
   in let st8 = st-append-code st7 (shl-ri reg-rdx 3)
   in let st9 = st-append-code st8 (mov-rr reg-rsi reg-rbx)
   in let st10 = st-append-code st9 (add-rr reg-rsi reg-rdx)
   in let st11 = st-append-code st10 (mov-load reg-rsi reg-rsi 8)
   in let st12 = st-append-code st11 (mov-rr reg-rdi reg-rax)
   in let st13 = st-append-code st12 (add-rr reg-rdi reg-rdx)
   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rsi 8)
   in let st15 = st-append-code st14 (add-ri reg-r11 1)
   in let st16 = st-append-code st15 (jmp (copy-loop - (st15.code-len + 5)))
   in patch-jcc-at st16 copy-done-pos (st16.code-len)

  emit-deck-snoc-path3-finish : CodegenState -> CodegenState
  emit-deck-snoc-path3-finish (st) =
    let st0 = st-append-code st (mov-rr reg-rdx reg-rcx)
   in let st1 = st-append-code st0 (shl-ri reg-rdx 3)
   in let st2 = st-append-code st1 (mov-rr reg-rdi reg-rax)
   in let st3 = st-append-code st2 (add-rr reg-rdi reg-rdx)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-r12 8)
   in let st5 = st-append-code st4 (pop-r reg-r13)
   in let st6 = st-append-code st5 (pop-r reg-r12)
   in let st7 = st-append-code st6 (pop-r reg-rbx)
   in emit-deck-snoc-tail st7

  emit-deck-list-push : CodegenState -> CodegenState
  emit-deck-list-push (st) =
    let st-pro = emit-deck-snoc-prologue st
   in let p1 = emit-deck-snoc-path1 st-pro
   in let p2 = emit-deck-snoc-path2 (p1.cg) (p1.p1)
   in let st0 = emit-deck-snoc-path2-store (p2.cg)
   in let st1 = emit-deck-snoc-path3-alloc st0 (p2.p1)
   in let st2 = emit-deck-snoc-path3-copy st1
   in emit-deck-snoc-path3-finish st2

Section: __deck_list_append

 Phase-discipline twin of __list_append. Always allocates a fresh
 result list in the deck region (via R14-saved deck-pos cell) and
 copies a then b into it. The bivy in-place fast path from
 __list_append is intentionally dropped: when a is in bivy and the
 bivy is about to be struck, an in-place extend would dangle; when
 a is in deck, copy-realloc is correct. emit-binary-op for
 IrAppendList dispatches here when st.deck-bound is True at the
 call site.

  emit-deck-list-append-prologue : CodegenState -> CodegenState
  emit-deck-list-append-prologue (st) =
    let st0 = record-func-offset st "__deck_list_append"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (push-r reg-r14)
   in let st5 = st-append-code st4 (li reg-r11 deck-pos-addr)
   in let st6 = st-append-code st5 (mov-load reg-r14 reg-r11 0)
   in let st7 = st-append-code st6 (mov-rr reg-rbx reg-rdi)
   in let st8 = st-append-code st7 (mov-rr reg-r12 reg-rsi)
   in let st9 = st-append-code st8 (mov-load reg-rcx reg-rbx 0)
   in let st10 = st-append-code st9 (mov-load reg-rdx reg-r12 0)
   in let st11 = st-append-code st10 (mov-rr reg-r13 reg-rcx)
   in let st12 = st-append-code st11 (add-rr reg-r13 reg-rdx)
   in let st13 = st-append-code st12 (mov-rr reg-rax reg-r13)
   in let st14 = st-append-code st13 (shl-ri reg-rax 1)
   in let st15 = st-append-code st14 (cmp-ri reg-rax 4)
   in let cap-ok-pos = st15.code-len
   in let st16 = st-append-code st15 (jcc cc-ge 0)
   in let st17 = st-append-code st16 (li reg-rax 4)
   in let st18 = patch-jcc-at st17 cap-ok-pos (st17.code-len)
   in let st19 = st-append-code st18 (mov-store reg-r14 reg-rax 0)
   in let st20 = st-append-code st19 (add-ri reg-r14 8)
   in let st21 = st-append-code st20 (mov-rr reg-rsi reg-r14)
   in let st22 = st-append-code st21 (mov-rr reg-r11 reg-rax)
   in let st23 = st-append-code st22 (add-ri reg-r11 1)
   in let st24 = st-append-code st23 (shl-ri reg-r11 3)
   in let st25 = st-append-code st24 (add-rr reg-r14 reg-r11)
   in st-append-code st25 (mov-store reg-rsi reg-r13 0)

  emit-deck-list-append-copy-a : CodegenState -> CodegenState
  emit-deck-list-append-copy-a (st) =
    let st0a = st-append-code st (mov-rr reg-rax reg-rbx)
   in let st0 = emit-list-eff-base st0a reg-rax reg-r11
   in let st1 = st-append-code st0 (mov-rr reg-rdi reg-rsi)
   in let st2 = st-append-code st1 (cmp-ri reg-rcx 0)
   in let skip-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-e 0)
   in let loop-pos = st3.code-len
   in let st4 = st-append-code st3 (mov-load reg-r11 reg-rax 8)
   in let st5 = st-append-code st4 (mov-store reg-rdi reg-r11 8)
   in let st6 = st-append-code st5 (add-ri reg-rax 8)
   in let st7 = st-append-code st6 (add-ri reg-rdi 8)
   in let st8 = st-append-code st7 (sub-ri reg-rcx 1)
   in let st9 = st-append-code st8 (jcc cc-ne (loop-pos - (st8.code-len + 6)))
   in patch-jcc-at st9 skip-pos (st9.code-len)

  emit-deck-list-append-copy-b : CodegenState -> CodegenState
  emit-deck-list-append-copy-b (st) =
    let st0a = st-append-code st (mov-rr reg-rax reg-r12)
   in let st0 = emit-list-eff-base st0a reg-rax reg-r11
   in let st1 = st-append-code st0 (cmp-ri reg-rdx 0)
   in let skip-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let loop-pos = st2.code-len
   in let st3 = st-append-code st2 (mov-load reg-r11 reg-rax 8)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-r11 8)
   in let st5 = st-append-code st4 (add-ri reg-rax 8)
   in let st6 = st-append-code st5 (add-ri reg-rdi 8)
   in let st7 = st-append-code st6 (sub-ri reg-rdx 1)
   in let st8 = st-append-code st7 (jcc cc-ne (loop-pos - (st7.code-len + 6)))
   in let st9 = patch-jcc-at st8 skip-pos (st8.code-len)
   in let st10 = st-append-code st9 (mov-rr reg-rax reg-rsi)
   in let st11 = st-append-code st10 (li reg-r11 deck-pos-addr)
   in let st12 = st-append-code st11 (mov-store reg-r11 reg-r14 0)
   in let st13 = st-append-code st12 (pop-r reg-r14)
   in let st14 = st-append-code st13 (pop-r reg-r13)
   in let st15 = st-append-code st14 (pop-r reg-r12)
   in let st16 = st-append-code st15 (pop-r reg-rbx)
   in st-append-code st16 x86-ret

  emit-deck-list-append : CodegenState -> CodegenState
  emit-deck-list-append (st) =
    let st0 = emit-deck-list-append-prologue st
   in let st1 = emit-deck-list-append-copy-a st0
   in emit-deck-list-append-copy-b st1

