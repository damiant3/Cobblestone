Section: __list_set_at

 The write goes through the effective base so a view stores into its
 backing, and the function still returns the view it was handed --
 the same in-place-and-return-receiver contract plain lists get. The
 selection runs on a copy in rcx because rdi must survive to be the
 return value.

  emit-list-set-at : CodegenState -> CodegenState
  emit-list-set-at (st) =
    let st0 = record-func-offset st "__list_set_at"
   in let st0a = st-append-code st0 (mov-rr reg-rcx reg-rdi)
   in let st0b = emit-list-eff-base st0a reg-rcx reg-rax
   in let st1 = st-append-code st0b (shl-ri reg-rsi 3)
   in let st2 = st-append-code st1 (add-rr reg-rsi reg-rcx)
   in let st3 = st-append-code st2 (mov-store reg-rsi reg-rdx 8)
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-rdi)
   in st-append-code st4 x86-ret

