Chapter: X86-64 Code Generator

Section: Function Emission
  emit-sub-rsp-imm32 : Integer -> List Integer
  emit-sub-rsp-imm32 (imm) =
   [72, 129, 236] & write-i32 imm

  emit-prologue : CodegenState -> CodegenState
  emit-prologue (st) =
   let st1 = if st.omit-frame-pointer then st-append-code st (push-r reg-rbx & push-r reg-r12 & push-r reg-r13 & push-r reg-r14)
   else st-append-code st (push-r reg-rbp & mov-rr reg-rbp reg-rsp & push-r reg-rbx & push-r reg-r12 & push-r reg-r13 & push-r reg-r14)
   in let st-hwm = if st1.trace-alloc then
    let st2 = st-append-code st1 (li reg-r11 (st-cell st1 stack-min-rsp-addr))
    in let st3 = st-append-code st2 (mov-load reg-r11 reg-r11 0)
    in let st4 = st-append-code st3 (cmp-rr reg-rsp reg-r11)
    in let skip-pos = st4.code-len
    in let st5 = st-append-code st4 (jcc cc-ae 0)
    in let st6 = st-append-code st5 (li reg-r11 (st-cell st5 stack-min-rsp-addr))
    in let st7 = st-append-code st6 (mov-store reg-r11 reg-rsp 0)
    in patch-jcc-at st7 skip-pos (st7.code-len)
   else st1
   in let st10a = if st-hwm.stack-guard then
    let st9 = st-append-code st-hwm (cmp-rr reg-rsp reg-r10)
    in let check-pos = st9.code-len
    in let st10 = st-append-code st9 (jcc cc-b 0)
    in let so-c = list-push (st10.stack-overflow-checks) check-pos
    in __record-set st10 "stack-overflow-checks" so-c
   else st-hwm
   in when st10a.watchdog-mode
    is WatchdogPet -> emit-call-to st10a "__pet_watchdog"
    is otherwise -> st10a

  emit-epilogue : CodegenState -> CodegenState
  emit-epilogue (st) =
   let used = if st.peak-local > 4 then 4 else st.peak-local
   in if st.omit-frame-pointer then
    let unused = 4 - used
    in let frame = align-16 (st.peak-spill * 8 + unused * 8)
    in let st1 = if frame > 0 then st-append-code st (add-ri reg-rsp frame) else st
    in let st2 = if used >= 4 then st-append-code st1 (pop-r reg-r14) else st1
    in let st3 = if used >= 3 then st-append-code st2 (pop-r reg-r13) else st2
    in let st4 = if used >= 2 then st-append-code st3 (pop-r reg-r12) else st3
    in let st5 = if used >= 1 then st-append-code st4 (pop-r reg-rbx) else st4
    in st-append-code st5 x86-ret
   else let lea-off = 0 - (used * 8)
   in let st1 = st-append-code st (lea reg-rsp reg-rbp lea-off)
   in let st2 = if used >= 4 then st-append-code st1 (pop-r reg-r14) else st1
   in let st3 = if used >= 3 then st-append-code st2 (pop-r reg-r13) else st2
   in let st4 = if used >= 2 then st-append-code st3 (pop-r reg-r12) else st3
   in let st5 = if used >= 1 then st-append-code st4 (pop-r reg-rbx) else st4
   in st-append-code st5 (pop-r reg-rbp & x86-ret)

  bind-params : CodegenState, List IRParam, Integer -> CodegenState
  bind-params (st) (params) (i) =
   if i == list-length params then st
   else let p = list-at params i
   in let loc = alloc-local st
   in let st1 = if i < 6 then store-local (loc.state) (loc.reg) (list-at arg-regs i)
   else let stack-offset = 16 + (i - 6) * 8
   in let tmp = alloc-temp (loc.state)
   in store-local (st-append-code (tmp.state) (mov-load (tmp.reg) reg-rbp stack-offset)) (loc.reg) (tmp.reg)
   in bind-params (add-local st1 (p.name) (loc.reg)) params (i + 1)

  collect-noalias-slots : CodegenState, List Text, Integer, List Integer -> List Integer
  collect-noalias-slots (st) (names) (i) (acc) =
   if i == list-length names then acc
   else let slot = lookup-local (st.locals) (list-at names i)
   in collect-noalias-slots st names (i + 1) (if slot >= 0 then list-push acc slot else acc)

  bind-noalias-slots : CodegenState, IRDef -> CodegenState
  bind-noalias-slots (st) (def) =
   if list-length (def.unique-params) == 0 then st
   else __record-set st "noalias-slots" (collect-noalias-slots st (def.unique-params) 0 [])

  is-self-call : IRExpr, Text -> Boolean
  is-self-call (expr) (func-name) =
   when expr
    is IrApply (f) (a) (t) (sp) -> is-self-call f func-name
    is IrName (n) (t) (sp) -> n == func-name
    is otherwise -> False

  has-tail-call : IRExpr, Text -> Boolean
  has-tail-call (expr) (func-name) =
   when expr
    is IrIf (c) (th) (el) (t) (sp) -> has-tail-call th func-name | has-tail-call el func-name
    is IrLet (n) (t) (v) (b) (sp) -> has-tail-call b func-name
    is IrMatch (s) (bs) (t) (sp) -> has-tail-call-branches bs func-name 0
    is IrApply (f) (a) (t) (sp) -> is-self-call expr func-name
    is IrAct (stmts) (t) (sp) -> has-tail-call-act stmts func-name
    is IrTry (max) (body) (fb) (fail) (t) (sp) | otherwise -> False

  has-tail-call-act : List IRActStmt, Text -> Boolean
  has-tail-call-act (stmts) (func-name) =
   let len = list-length stmts
   in if len == 0 then False
    else let last = list-at stmts (len - 1)
     in when last
      is IrDoExec (e) (sp) -> has-tail-call e func-name
      is otherwise -> False

  has-tail-call-branches : List IRBranch, Text, Integer -> Boolean
  has-tail-call-branches (branches) (func-name) (i) =
   if i == list-length branches then False
   else let b = list-at branches i
   in if has-tail-call (b.body) func-name then True
      else has-tail-call-branches branches func-name (i + 1)

  should-tco : IRDef -> Boolean
  should-tco (def) =
   if list-length (def.params) > 0 then has-tail-call (def.body) (def.name)
   else False

  ip-mentions : IRExpr, Text -> Boolean
  ip-mentions (e) (nm) =
   when e
    is IrIntLit (v) (sp) | IrNumLit (v) (sp) | IrBoolLit (v) (sp) | IrCharLit (v) (sp) -> False
    is IrTextLit (t) (sp) -> False
    is IrError (m) (ty) (sp) -> False
    is IrName (n) (ty) (sp) -> n == nm
    is IrNegate (x) (ty) (sp) -> ip-mentions x nm
    is IrBinary (op) (l) (r) (ty) (sp) -> ip-mentions l nm | ip-mentions r nm
    is IrIf (c) (t) (el) (ty) (sp) -> ip-mentions c nm | ip-mentions t nm | ip-mentions el nm
    is IrLet (n) (ty) (v) (b) (sp) -> n == nm | ip-mentions v nm | ip-mentions b nm
    is IrApply (f) (a) (ty) (sp) -> ip-mentions f nm | ip-mentions a nm
    is IrLambda (ps) (b) (ty) (sp) -> ip-params-bind ps nm 0 | ip-mentions b nm
    is IrList (es) (ty) (sp) -> ip-mentions-list es nm 0
    is IrMatch (s) (bs) (ty) (sp) -> ip-mentions s nm | ip-mentions-branches bs nm 0
    is IrAct (stmts) (ty) (sp) -> ip-mentions-stmts stmts nm 0
    is IrRecord (n) (fs) (ty) (sp) -> ip-mentions-fields fs nm 0
    is IrFieldAccess (r) (f) (ty) (sp) -> ip-mentions r nm
    is IrFieldStore (r) (f) (v) (ty) (sp) -> ip-mentions r nm | ip-mentions v nm
    is otherwise -> True

  ip-params-bind : List IRParam, Text, Integer -> Boolean
  ip-params-bind (ps) (nm) (i) =
   if i >= list-length ps then False
   else if (list-at ps i).name == nm then True
   else ip-params-bind ps nm (i + 1)

  ip-mentions-list : List IRExpr, Text, Integer -> Boolean
  ip-mentions-list (es) (nm) (i) =
   if i >= list-length es then False
   else if ip-mentions (list-at es i) nm then True
   else ip-mentions-list es nm (i + 1)

  ip-mentions-fields : List IRFieldVal, Text, Integer -> Boolean
  ip-mentions-fields (fs) (nm) (i) =
   if i >= list-length fs then False
   else if ip-mentions ((list-at fs i).value) nm then True
   else ip-mentions-fields fs nm (i + 1)

  ip-mentions-stmts : List IRActStmt, Text, Integer -> Boolean
  ip-mentions-stmts (stmts) (nm) (i) =
   if i >= list-length stmts then False
   else let hit = (when list-at stmts i
     is IrDoBind (n) (t) (v) (sp) -> n == nm | ip-mentions v nm
     is IrDoExec (v) (sp) -> ip-mentions v nm)
   in if hit then True else ip-mentions-stmts stmts nm (i + 1)

  ip-pat-binds : IRPat, Text -> Boolean
  ip-pat-binds (p) (nm) =
   when p
    is IrVarPat (n) (ty) (sp) -> n == nm
    is IrCtorPat (c) (subs) (ty) (sp) -> ip-pats-bind subs nm 0
    is IrVecPat (subs) (ty) (sp) -> ip-pats-bind subs nm 0
    is otherwise -> False

  ip-pats-bind : List IRPat, Text, Integer -> Boolean
  ip-pats-bind (ps) (nm) (i) =
   if i >= list-length ps then False
   else if ip-pat-binds (list-at ps i) nm then True
   else ip-pats-bind ps nm (i + 1)

  ip-mentions-branches : List IRBranch, Text, Integer -> Boolean
  ip-mentions-branches (bs) (nm) (i) =
   if i >= list-length bs then False
   else let b = list-at bs i
   in if ip-pat-binds (b.pattern) nm | ip-mentions (b.guard) nm | ip-mentions (b.body) nm then True
   else ip-mentions-branches bs nm (i + 1)

  ip-clean : IRExpr, Text -> Integer
  ip-clean (e) (acc) = if ip-mentions e acc then 0 - 1 else 0

  ip-join : Integer, Integer -> Integer
  ip-join (a) (b) = if a < 0 | b < 0 then 0 - 1 else a + b

  ip-walk : IRExpr, Boolean, Text, Text, Integer, Integer -> Integer
  ip-walk (e) (tail) (acc) (fname) (k) (np) =
   when e
    is IrName (n) (ty) (sp) -> if n /= acc | tail then 0 else 0 - 1
    is IrIf (c) (t) (el) (ty) (sp) ->
     ip-join (ip-clean c acc) (ip-join (ip-walk t tail acc fname k np) (ip-walk el tail acc fname k np))
    is IrLet (n) (ty) (v) (b) (sp) ->
     if n == acc then 0 - 1
     else ip-join (ip-clean v acc) (ip-walk b tail acc fname k np)
    is IrApply (f) (a) (ty) (sp) ->
     if tail & is-self-call e fname then
      let args = flatten-tail-args e []
      in if list-length args /= np then ip-clean e acc
      else ip-walk-args args acc k 0 0
     else ip-clean e acc
    is IrMatch (s) (bs) (ty) (sp) ->
     ip-join (ip-clean s acc) (ip-walk-branches bs tail acc fname k np 0 0)
    is otherwise -> ip-clean e acc

  ip-walk-branches : List IRBranch, Boolean, Text, Text, Integer, Integer, Integer, Integer -> Integer
  ip-walk-branches (bs) (tail) (acc) (fname) (k) (np) (i) (total) =
   if total < 0 then total
   else if i >= list-length bs then total
   else let b = list-at bs i
   in if ip-pat-binds (b.pattern) acc then 0 - 1
   else let here = ip-join (ip-clean (b.guard) acc) (ip-walk (b.body) tail acc fname k np)
   in ip-walk-branches bs tail acc fname k np (i + 1) (ip-join total here)

  ip-walk-args : List IRExpr, Text, Integer, Integer, Integer -> Integer
  ip-walk-args (args) (acc) (k) (i) (total) =
   if total < 0 then total
   else if i >= list-length args then total
   else let arg = list-at args i
   in let here = if i /= k then ip-clean arg acc else ip-acc-arg arg acc
   in ip-walk-args args acc k (i + 1) (ip-join total here)

  ip-acc-arg : IRExpr, Text -> Integer
  ip-acc-arg (arg) (acc) =
   when arg
    is IrName (n) (ty) (sp) -> if n == acc then 0 else 0 - 1
    is IrTextLit (t) (sp) -> 0
    is IrBinary (op) (l) (r) (ty) (sp) -> ip-acc-append op l r acc
    is otherwise -> 0 - 1

  ip-acc-append : IRBinaryOp, IRExpr, IRExpr, Text -> Integer
  ip-acc-append (op) (l) (r) (acc) =
   when op
    is IrAppendText ->
     (when l
      is IrName (ln) (lt) (ls) -> if ln /= acc then 0 - 1 else if ip-mentions r acc then 0 - 1 else 1
      is otherwise -> 0 - 1)
    is otherwise -> 0 - 1

  ip-param-is-text : CodexType -> Boolean
  ip-param-is-text (ty) =
   when ty
    is TextTy -> True
    is otherwise -> False

  inplace-accumulators : IRDef, Integer, List Text -> List Text
  inplace-accumulators (def) (i) (found) =
   let params = def.params
   in if i >= list-length params then found
   else let p = list-at params i
   in let ok = ip-param-is-text (p.type-val) & ip-walk (def.body) True (p.name) (def.name) i (list-length params) > 0
   in inplace-accumulators def (i + 1) (if ok then list-push found (p.name) else found)

  emit-inplace-entry-guards : CodegenState, List Text, Integer -> CodegenState
  emit-inplace-entry-guards (st) (names) (i) =
   if i >= list-length names then st
   else let loaded = load-local st (lookup-local (st.locals) (list-at names i))
   in let st1 = st-append-code (loaded.state) (mov-rr reg-rdi (loaded.reg))
   in emit-inplace-entry-guards (emit-call-to st1 "__str_own") names (i + 1)

  st-set-tail-pos : CodegenState, Boolean -> CodegenState
  st-set-tail-pos (st) (v) =
   __record-set st "tco" (__record-set (st.tco) "in-tail-pos" v)

  TcoAllocResult = record {
   alloc-state : CodegenState,
   alloc-locals : List Integer
  }

  pre-alloc-tco-temps : CodegenState, Integer, Integer, List Integer -> TcoAllocResult
  pre-alloc-tco-temps (st) (i) (count) (acc) =
   if i == count then TcoAllocResult {
    alloc-state = st,
    alloc-locals = acc
  }
   else let loc = alloc-local st
   in pre-alloc-tco-temps (loc.state) (i + 1) count (list-push acc (loc.reg))

  collect-param-locals : List LocalBinding, List IRParam, Integer, List Integer -> List Integer
  collect-param-locals (bindings) (params) (i) (acc) =
   if i == list-length params then acc
   else let p = list-at params i
   in let slot = lookup-local bindings (p.name)
   in collect-param-locals bindings params (i + 1) (list-push acc slot)

  nop-push-2 : CodegenState, Integer -> CodegenState
  nop-push-2 (st) (pos) =
   let r1 = __buf-write-byte (st.workspace.code-buffer) pos 102
   in let r2 = __buf-write-byte (st.workspace.code-buffer) (pos + 1) 144
   in st

  nop-push-1 : CodegenState, Integer -> CodegenState
  nop-push-1 (st) (pos) =
   let r1 = __buf-write-byte (st.workspace.code-buffer) pos 144
   in st

  nop-sub-rsp : CodegenState, Integer -> CodegenState
  nop-sub-rsp (st) (pos) =
   let r1 = __buf-write-byte (st.workspace.code-buffer) pos 15
   in let r2 = __buf-write-byte (st.workspace.code-buffer) (pos + 1) 31
   in let r3 = __buf-write-byte (st.workspace.code-buffer) (pos + 2) 68
   in let r4 = __buf-write-byte (st.workspace.code-buffer) (pos + 3) 36
   in let r5 = __buf-write-byte (st.workspace.code-buffer) (pos + 4) 0
   in let r6 = __buf-write-byte (st.workspace.code-buffer) (pos + 5) 102
   in let r7 = __buf-write-byte (st.workspace.code-buffer) (pos + 6) 144
   in st

  nop-push-4 : CodegenState, Integer -> CodegenState
  nop-push-4 (st) (pos) =
   let r1 = __buf-write-byte (st.workspace.code-buffer) pos 15
   in let r2 = __buf-write-byte (st.workspace.code-buffer) (pos + 1) 31
   in let r3 = __buf-write-byte (st.workspace.code-buffer) (pos + 2) 64
   in let r4 = __buf-write-byte (st.workspace.code-buffer) (pos + 3) 0
   in st

  nop-unused-pushes : CodegenState, Integer, Integer, Boolean -> CodegenState
  nop-unused-pushes (st) (func-start) (used) (ofp) =
   let base = if ofp then func-start else func-start + 4
   in if used <= 2 then
    let st1 = if used < 2 then nop-push-2 st (base + 1) else st
    in let st2 = if used < 1 then nop-push-1 st1 base else st1
    in nop-push-4 st2 (base + 3)
   else let st1 = if used < 4 then nop-push-2 st (base + 5) else st
   in if used < 3 then nop-push-2 st1 (base + 3) else st1

 Minimal emission, two tiers. A function that needs at most four
 register locals (no spills) and whose every construct emits through
 an alloc-free path pays almost none of the frame ceremony: it pushes
 exactly the callee-saved registers it will use, binds its
 parameters, and runs -- no frame pointer, no frame-size placeholder,
 no NOP padding, and an epilogue of matching pops plus ret. A pure
 leaf (no call instructions at all) also skips the stack guard,
 which is sound because a call-free function cannot grow the stack
 past its own fixed pushes -- tail self-recursion is a jmp. A
 near-leaf (calls present, still spill-free) keeps the guard: the
 guard chain through recursive calls is exactly what detects
 heap-stack collision. Call sites in near-leaves are restricted to
 the two alloc-free argument paths, and TCO temps are pre-allocated
 only when some tail site is not fully direct. Eligibility is a
 whitelist mirror of the alloc-free emission paths: literals, bound
 names, integer arithmetic and ordered comparisons (staged operands
 allocate nothing), destination-driven if, one local per let and per
 short-circuit operator, and tail self-calls whose shuffle plan is
 fully direct so the TCO temps are never allocated. Anything else --
 applies, ctor references, text or structural equality, matches,
 records, effects -- disqualifies. Names must be distinct binders so
 the name-based pre-scan and the slot-based site emission agree. If
 emission ever allocates past the prediction, spills, or appends a
 call patch, the function is reported as a CDX error rather than
 emitted silently wrong: the gates go red instead of the binary.

  leaf-name-index : List Text, Text, Integer -> Integer
  leaf-name-index (xs) (n) (i) =
   if i == list-length xs then 0 - 1
   else if list-at xs i == n then i
   else leaf-name-index xs n (i + 1)

  leaf-direct-tail-arg : IRExpr, List Text, Text -> Boolean
  leaf-direct-tail-arg (arg) (binders) (target-pname) =
   when arg
    is IrIntLit (v) (sp) | IrBoolLit (v) (sp) | IrCharLit (v) (sp) -> True
    is IrName (n) (ty) (sp) -> leaf-name-index binders n 0 >= 0
    is IrBinary (op) (left) (right) (ty) (sp) ->
     (when left
      is IrName (ln) (lt) (ls) ->
       if leaf-name-index binders ln 0 < 0 then False
       else (when right
        is IrIntLit (v) (s) ->
         (when op
          is IrAddInt -> bound-fits-i32 v
          is IrSubInt -> bound-fits-i32 v & bound-fits-i32 (0 - v)
          is IrMulInt -> bound-fits-i32 v
          is otherwise -> False)
        is IrName (rn) (rt) (rs) ->
         if leaf-name-index binders rn 0 < 0 then False
         else if is-tco-binop op == False then False
         else if rn == target-pname then is-commutative-tco-op op
         else True
        is otherwise -> False)
      is otherwise -> False)
    is otherwise -> False

  leaf-arg-reads : IRExpr, List Text, List Integer -> List Integer
  leaf-arg-reads (arg) (pnames) (acc) =
   when arg
    is IrName (n) (ty) (sp) ->
     let i = leaf-name-index pnames n 0
     in if i >= 0 then list-push acc i else acc
    is IrBinary (op) (left) (right) (ty) (sp) ->
     let acc1 = (when left
      is IrName (ln) (lt) (ls) ->
       let i = leaf-name-index pnames ln 0
       in if i >= 0 then list-push acc i else acc
      is otherwise -> acc)
     in (when right
      is IrName (rn) (rt) (rs) ->
       let j = leaf-name-index pnames rn 0
       in if j >= 0 then list-push acc1 j else acc1
      is otherwise -> acc1)
    is otherwise -> acc

  leaf-order-pick : List IRExpr, List Text, List Integer, Integer -> Integer
  leaf-order-pick (args) (pnames) (picked) (i) =
   if i == list-length args then 0 - 1
   else if tco-list-contains picked i 0 == False
         & leaf-order-blocked args pnames picked i 0 == False
        then i
   else leaf-order-pick args pnames picked (i + 1)

  leaf-order-blocked : List IRExpr, List Text, List Integer, Integer, Integer -> Boolean
  leaf-order-blocked (args) (pnames) (picked) (i) (j) =
   if j == list-length args then False
   else if j /= i
         & tco-list-contains picked j 0 == False
         & tco-list-contains (leaf-arg-reads (list-at args j) pnames []) i 0
        then True
   else leaf-order-blocked args pnames picked i (j + 1)

  leaf-order-ok : List IRExpr, List Text, List Integer, Integer -> Boolean
  leaf-order-ok (args) (pnames) (picked) (fuel) =
   if list-length picked == list-length args then True
   else if fuel == 0 then False
   else let pick = leaf-order-pick args pnames picked 0
   in if pick < 0 then False
   else leaf-order-ok args pnames (list-push picked pick) (fuel - 1)

  leaf-tail-call-ok : IRExpr, List Text, List Text -> Boolean
  leaf-tail-call-ok (e) (binders) (pnames) =
   let args = flatten-tail-args e []
   in if list-length args /= list-length pnames then False
   else if leaf-tail-args-direct args binders pnames 0 == False then False
   else leaf-order-ok args pnames [] (list-length args + 1)

  tco-max-complex : IRExpr, Text, List Text, Integer -> Integer
  tco-max-complex (e) (fname) (pnames) (best) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     tco-max-complex el fname pnames (tco-max-complex t fname pnames best)
    is IrLet (n) (ty) (v) (b) (sp) -> tco-max-complex b fname pnames best
    is IrMatch (s) (bs) (t) (sp) -> tco-max-complex-branches bs fname pnames best 0
    is IrAct (stmts) (t) (sp) -> tco-max-complex-act stmts fname pnames best
    is IrApply (f) (a) (ty) (sp) ->
     if is-self-call e fname then
      let args = flatten-tail-args e []
      in let n = list-length args
      in if n /= list-length pnames then if n > best then n else best
      else let d = leaf-tail-args-direct args pnames pnames 0
      in let c = if d then 0 else n - tco-direct-count-leaf args pnames pnames 0 0
      in let ct = if c <= 1 then 0 else c
      in if ct > best then ct else best
     else best
    is otherwise -> best

  tco-max-complex-branches : List IRBranch, Text, List Text, Integer, Integer -> Integer
  tco-max-complex-branches (branches) (fname) (pnames) (best) (i) =
   if i == list-length branches then best
   else let b = list-at branches i
   in tco-max-complex-branches branches fname pnames (tco-max-complex (b.body) fname pnames best) (i + 1)

  tco-max-complex-act : List IRActStmt, Text, List Text, Integer -> Integer
  tco-max-complex-act (stmts) (fname) (pnames) (best) =
   let len = list-length stmts
   in if len == 0 then best
   else when list-at stmts (len - 1)
    is IrDoExec (e) (sp) -> tco-max-complex e fname pnames best
    is otherwise -> best

  tco-direct-count-leaf : List IRExpr, List Text, List Text, Integer, Integer -> Integer
  tco-direct-count-leaf (args) (binders) (pnames) (i) (acc) =
   if i == list-length args then acc
   else if leaf-direct-tail-arg (list-at args i) binders (list-at pnames i)
        then tco-direct-count-leaf args binders pnames (i + 1) (acc + 1)
   else tco-direct-count-leaf args binders pnames (i + 1) acc

  tco-result-conflicts : Integer, List Integer, Integer -> Boolean
  tco-result-conflicts (r) (pls) (i) =
   if i == list-length pls then False
   else if list-at pls i == r then True
   else tco-result-conflicts r pls (i + 1)

  tco-find-complex : CodegenState, List IRExpr, List Integer, Integer -> Integer
  tco-find-complex (st) (args) (param-locals) (i) =
   if i == list-length args then 0 - 1
   else if is-direct-tail-arg st (list-at args i) (list-at param-locals i) then tco-find-complex st args param-locals (i + 1)
   else i

  emit-tail-single-safe : CodegenState, EmitResult, List IRExpr, List Integer, List Integer, Integer -> CodegenState
  emit-tail-single-safe (st) (er) (args) (param-locals) (order) (ci) =
   let st-d = emit-direct-tail-moves (er.state) args param-locals order 0
   in store-local st-d (list-at param-locals ci) (er.reg)

  emit-tail-single-conflict : CodegenState, EmitResult, List IRExpr, List Integer, List Integer, Integer -> CodegenState
  emit-tail-single-conflict (st) (er) (args) (param-locals) (order) (ci) =
   let loc = alloc-local (er.state)
   in let st-s = store-local (loc.state) (loc.reg) (er.reg)
   in let st-d = emit-direct-tail-moves st-s args param-locals order 0
   in let loaded = load-local st-d (loc.reg)
   in store-local (loaded.state) (list-at param-locals ci) (loaded.reg)

  tco-count-complex : CodegenState, List IRExpr, List Integer, Integer, Integer -> Integer
  tco-count-complex (st) (args) (param-locals) (i) (acc) =
   if i == list-length args then acc
   else if is-direct-tail-arg st (list-at args i) (list-at param-locals i) then tco-count-complex st args param-locals (i + 1) acc
   else tco-count-complex st args param-locals (i + 1) (acc + 1)

 The identity comprehension is load-bearing and must not be removed.
 temps arrives as st.tco.temp-locals, a field of the caller's long-lived
 state, and __list_snoc extends its argument in place whenever that
 argument is the topmost allocation. Growing the caller's list would hand
 the next tail call in the same function the spill slots this one just
 took. The comprehension builds its accumulator from an empty literal of
 its own, so what tco-grow-temps pushes onto is linearly owned by
 construction rather than by allocation order.

  tco-ensure-temps : CodegenState, List Integer, Integer -> TcoAllocResult
  tco-ensure-temps (st) (temps) (needed) =
   if list-length temps >= needed then TcoAllocResult { alloc-state = st, alloc-locals = temps }
   else tco-grow-temps st (for r in temps -> r) needed

  tco-grow-temps : CodegenState, List Integer, Integer -> TcoAllocResult
  tco-grow-temps (st) (temps) (needed) =
   if list-length temps >= needed then TcoAllocResult { alloc-state = st, alloc-locals = temps }
   else let loc = alloc-local st
   in tco-grow-temps (loc.state) (list-push temps (loc.reg)) needed

  emit-tail-call-general-shuffle : CodegenState, List IRExpr, List Integer, List Integer, List Integer -> CodegenState
  emit-tail-call-general-shuffle (st) (args) (temp-locals) (param-locals) (order) =
   let needed = tco-count-complex st args param-locals 0 0
   in let ensured = tco-ensure-temps st temp-locals needed
   in let st-c = eval-complex-tail-args (ensured.alloc-state) args (ensured.alloc-locals) param-locals 0 0
   in let st-d = emit-direct-tail-moves st-c args param-locals order 0
   in copy-complex-temps st-d args (ensured.alloc-locals) param-locals 0 0

 The one complex argument is evaluated before any parameter is
 written, so its value has to survive the direct moves that follow.
 Two things can destroy it. It can sit in a register that IS one of
 the parameters, which tco-result-conflicts answers. Or it can sit in
 a load-local scratch register -- and every direct argument that
 reads a spilled local takes one, from a rotation of three, so the
 third such load hands the register straight back while the value is
 still live.

 A value in a temp register is still safe -- the direct shapes write
 only their target parameter and a scratch -- so the staging store
 and reload is paid only where it is load-bearing.

  tco-scratch-member : Integer, Integer -> Boolean
  tco-scratch-member (r) (i) =
   if i == load-local-scratch-count then False
   else if load-local-scratch-for i == r then True
   else tco-scratch-member r (i + 1)

  tco-result-is-scratch : Integer -> Boolean
  tco-result-is-scratch (r) = tco-scratch-member r 0

  emit-tail-single-complex : CodegenState, List IRExpr, List Integer, List Integer, Integer -> CodegenState
  emit-tail-single-complex (st) (args) (param-locals) (order) (ci) =
   let er = emit-expr (st-set-tail-pos st False) (list-at args ci)
   in if tco-result-conflicts (er.reg) param-locals 0 | tco-result-is-scratch (er.reg)
      then emit-tail-single-conflict st er args param-locals order ci
   else emit-tail-single-safe st er args param-locals order ci

  leaf-tail-args-direct : List IRExpr, List Text, List Text, Integer -> Boolean
  leaf-tail-args-direct (args) (binders) (pnames) (i) =
   if i == list-length args then True
   else if leaf-direct-tail-arg (list-at args i) binders (list-at pnames i)
        then leaf-tail-args-direct args binders pnames (i + 1)
   else False

 A let binds its body through emit-let, which emits that body via
 emit-expr (value position) rather than the target-threading
 emit-to-local. When the body is an if, the value-mode emitter parks
 the comparison's left operand and the if's result in two anonymous
 locals that the plain let count does not see. leaf-walk charges those
 two so the minimal-leaf local prediction stays accurate and a shape
 that overflows the four register locals is routed to the standard
 emitter instead of mispredicting.

  leaf-body-is-if : IRExpr -> Boolean
  leaf-body-is-if (e) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) -> True
    is IrLet (n) (ty) (v) (b) (sp) -> leaf-body-is-if b
    is otherwise -> False

  leaf-walk : CodegenState, IRExpr, Boolean, Boolean, List Text, Text, List Text, Integer -> Integer
  leaf-walk (st) (e) (tail) (dest) (binders) (fname) (pnames) (lets) =
   if lets < 0 then lets
   else when e
    is IrIntLit (v) (sp) | IrNumLit (v) (sp) | IrBoolLit (v) (sp) | IrCharLit (v) (sp) -> lets
    is IrName (n) (ty) (sp) -> if leaf-name-index binders n 0 >= 0 then lets else 0 - 1
    is IrNegate (x) (ty) (sp) -> leaf-walk st x False False binders fname pnames lets
    is IrBinary (op) (l) (r) (ty) (sp) ->
     (when op
      is IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrRemInt | IrLt | IrGt | IrLtEq | IrGtEq ->
       leaf-walk st r False False binders fname pnames (leaf-walk st l False False binders fname pnames lets)
      is IrEq | IrNotEq ->
       if is-fusable-int-comparison st op l
       then leaf-walk st r False False binders fname pnames (leaf-walk st l False False binders fname pnames lets)
       else 0 - 1
      is IrAnd | IrOr ->
       leaf-walk st r False False binders fname pnames (leaf-walk st l False False binders fname pnames (lets + 1))
      is otherwise -> 0 - 1)
    is IrIf (c) (t) (el) (ty) (sp) ->
     if dest == False then 0 - 1
     else leaf-walk st el tail dest binders fname pnames (leaf-walk st t tail dest binders fname pnames (leaf-walk st c False False binders fname pnames lets))
    is IrLet (n) (ty) (v) (b) (sp) ->
     if leaf-name-index binders n 0 >= 0 then 0 - 1
     else let vw = leaf-walk st v False True binders fname pnames (lets + 1)
     in if vw < 0 then 0 - 1
     else leaf-walk st b tail dest (list-push binders n) fname pnames (vw + (if leaf-body-is-if b then 2 else 0))
    is IrApply (f) (a) (ty) (sp) ->
     if tail then
      if is-self-call e fname then
       let targs = flatten-tail-args e []
       in if list-length targs /= list-length pnames then 0 - 1
          else leaf-walk-tail-args st targs binders fname pnames lets 0
      else leaf-call st e ty binders fname pnames lets
     else leaf-call st e ty binders fname pnames lets
    is otherwise -> 0 - 1

 A call site is alloc-free in exactly two shapes: one argument (the
 argument is emitted straight into RDI through the destination-driven
 path, so any eligible expression works there), or two to four
 arguments that are all names bound to register locals (the
 emit-args-to-regs path: bare moves). The root must be a plain global
 function applied at exactly its arity -- not a local closure, not a
 builtin (builtin emitters park in locals), not an effect operation,
 not deck-record, not a constructor (those miss the arity table), and
 not a call whose result is a function (the partial-application path
 allocates a closure).

  leaf-apply-root : IRExpr -> Text
  leaf-apply-root (e) =
   when e
    is IrApply (f) (a) (ty) (sp) -> leaf-apply-root f
    is IrName (n) (ty) (sp) -> n
    is otherwise -> ""

  leaf-call : CodegenState, IRExpr, CodexType, List Text, Text, List Text, Integer -> Integer
  leaf-call (st) (e) (ty) (binders) (fname) (pnames) (lets) =
   let root = leaf-apply-root e
   in if root == "" then 0 - 1
   else if root == "deck-record" then 0 - 1
   else if leaf-name-index binders root 0 >= 0 then 0 - 1
   else if is-builtin (st.builtin-names) root then 0 - 1
   else if find-effect-op-addr (st.effect-op-addrs) root 0 (list-length (st.effect-op-addrs)) >= 0 then 0 - 1
   else let args = flatten-tail-args e []
   in let nargs = list-length args
   in if lookup-x86-arity (st.user-arities) root /= nargs then 0 - 1
   else if leaf-result-is-fun st ty then 0 - 1
   else if nargs == 1 then leaf-walk st (list-at args 0) False True binders fname pnames lets
   else if nargs <= 4 then
    if leaf-args-all-bound args binders 0 then lets else 0 - 1
   else 0 - 1

  leaf-result-is-fun : CodegenState, CodexType -> Boolean
  leaf-result-is-fun (st) (ty) =
   when resolve-constructed-ty st ty
    is FunTy (p) (row) (r) -> True
    is otherwise -> False

  leaf-arg-is-bound : IRExpr, List Text -> Boolean
  leaf-arg-is-bound (a) (binders) =
   when a
    is IrName (n) (ty) (sp) -> leaf-name-index binders n 0 >= 0
    is IrIntLit (v) (sp) -> True
    is IrBoolLit (v) (sp) -> True
    is IrBinary (op) (left) (right) (ty) (sp) ->
     when op
      is IrAddInt | IrSubInt ->
       when left
        is IrName (ln) (lt) (ls) ->
         if leaf-name-index binders ln 0 >= 0 then
          when right
           is IrIntLit (v) (s) -> True
           is otherwise -> False
         else False
        is otherwise -> False
      is otherwise -> False
    is otherwise -> False

  leaf-args-all-bound : List IRExpr, List Text, Integer -> Boolean
  leaf-args-all-bound (args) (binders) (i) =
   if i == list-length args then True
   else if leaf-arg-is-bound (list-at args i) binders then leaf-args-all-bound args binders (i + 1)
   else False

  leaf-walk-tail-args : CodegenState, List IRExpr, List Text, Text, List Text, Integer, Integer -> Integer
  leaf-walk-tail-args (st) (args) (binders) (fname) (pnames) (lets) (i) =
   if lets < 0 then lets
   else if i == list-length args then lets
   else leaf-walk-tail-args st args binders fname pnames (leaf-walk st (list-at args i) False False binders fname pnames lets) (i + 1)

  leaf-has-call : IRExpr, Boolean, Text -> Boolean
  leaf-has-call (e) (tail) (fname) =
   when e
    is IrApply (f) (a) (ty) (sp) ->
     if tail then
      if is-self-call e fname then leaf-args-have-call (flatten-tail-args e []) fname 0
      else True
     else True
    is IrNegate (x) (ty) (sp) -> leaf-has-call x False fname
    is IrBinary (op) (l) (r) (ty) (sp) -> if leaf-has-call l False fname then True else leaf-has-call r False fname
    is IrIf (c) (t) (el) (ty) (sp) -> if leaf-has-call c False fname then True else if leaf-has-call t tail fname then True else leaf-has-call el tail fname
    is IrLet (n) (ty) (v) (b) (sp) -> if leaf-has-call v False fname then True else leaf-has-call b tail fname
    is otherwise -> False

  leaf-args-have-call : List IRExpr, Text, Integer -> Boolean
  leaf-args-have-call (args) (fname) (i) =
   if i == list-length args then False
   else if leaf-has-call (list-at args i) False fname then True
   else leaf-args-have-call args fname (i + 1)

  leaf-tails-all-direct : IRExpr, Boolean, Text, List Text -> Boolean
  leaf-tails-all-direct (e) (tail) (fname) (pnames) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     if leaf-tails-all-direct t tail fname pnames then leaf-tails-all-direct el tail fname pnames else False
    is IrLet (n) (ty) (v) (b) (sp) -> leaf-tails-all-direct b tail fname pnames
    is IrApply (f) (a) (ty) (sp) ->
     if tail then
      if is-self-call e fname then leaf-tail-call-ok e pnames pnames else True
     else True
    is otherwise -> True

  tails-all-direct : IRExpr, Boolean, Text, List Text -> Boolean
  tails-all-direct (e) (tail) (fname) (pnames) =
   when e
    is IrIf (c) (t) (el) (ty) (sp) ->
     if tails-all-direct t tail fname pnames then tails-all-direct el tail fname pnames else False
    is IrLet (n) (ty) (v) (b) (sp) -> tails-all-direct b tail fname pnames
    is IrMatch (s) (bs) (t) (sp) -> tails-all-direct-branches bs fname pnames 0
    is IrAct (stmts) (t) (sp) -> tails-all-direct-act stmts fname pnames
    is IrApply (f) (a) (ty) (sp) ->
     if tail then
      if is-self-call e fname then leaf-tail-call-ok e pnames pnames else True
     else True
    is otherwise -> True

  tails-all-direct-branches : List IRBranch, Text, List Text, Integer -> Boolean
  tails-all-direct-branches (branches) (fname) (pnames) (i) =
   if i == list-length branches then True
   else let b = list-at branches i
   in if tails-all-direct (b.body) True fname pnames then tails-all-direct-branches branches fname pnames (i + 1) else False

  tails-all-direct-act : List IRActStmt, Text, List Text -> Boolean
  tails-all-direct-act (stmts) (fname) (pnames) =
   let len = list-length stmts
   in if len == 0 then True
   else when list-at stmts (len - 1)
    is IrDoExec (e) (sp) -> tails-all-direct e True fname pnames
    is otherwise -> True

  LeafProfile = record {
   lp-ok : Boolean,
   lp-locals : Integer between 0 and 65535,
   lp-has-calls : Boolean,
   lp-temps : Integer between 0 and 65535
  }

  leaf-profile-fail : LeafProfile
  leaf-profile-fail = LeafProfile { lp-ok = False, lp-locals = 0, lp-has-calls = False, lp-temps = 0 }

  leaf-profile : CodegenState, IRDef -> LeafProfile
  leaf-profile (st) (def) =
   let blocked = st.trace-alloc | st.omit-frame-pointer
   in let wd-blocked = (when st.watchdog-mode
    is WatchdogPet -> True
    is otherwise -> False)
   in if blocked | wd-blocked then leaf-profile-fail
   else let pnames = for p in (def.params) -> p.name
   in let lets = leaf-walk st (def.body) True True pnames (def.name) pnames 0
   in if lets < 0 then leaf-profile-fail
   else let temps = if should-tco def then
       if tails-all-direct (def.body) True (def.name) pnames then 0
       else tco-max-complex (def.body) (def.name) pnames 0
      else 0
   in let total = list-length pnames + lets + temps
   in LeafProfile {
    lp-ok = total <= 4,
    lp-locals = __narrow total,
    lp-has-calls = leaf-has-call (def.body) True (def.name),
    lp-temps = __narrow temps
   }

  emit-minimal-pushes : CodegenState, Integer, Integer -> CodegenState
  emit-minimal-pushes (st) (n) (i) =
   if i == n then st
   else emit-minimal-pushes (st-append-code st (push-r (list-at local-regs i))) n (i + 1)

  emit-minimal-pops : CodegenState, Integer -> CodegenState
  emit-minimal-pops (st) (i) =
   if i == 0 then st
   else emit-minimal-pops (st-append-code st (pop-r (list-at local-regs (i - 1)))) (i - 1)

  emit-minimal-guard : CodegenState -> CodegenState
  emit-minimal-guard (st) =
   if st.stack-guard then
    let st9 = st-append-code st (cmp-rr reg-rsp reg-r10)
    in let check-pos = st9.code-len
    in let st10 = st-append-code st9 (jcc cc-b 0)
    in __record-set st10 "stack-overflow-checks" (list-push (st10.stack-overflow-checks) check-pos)
   else st

  take-arg-regs : Integer, Integer, List Integer -> List Integer
  take-arg-regs (n) (i) (acc) =
   if i == n then acc
   else take-arg-regs n (i + 1) (list-push acc (list-at arg-regs i))

 A pure leaf owes no callee-saved save, so its locals can live in
 caller-saved argument registers: no push/pop, and each parameter binds
 to the register it arrives in (an identity store the emitter drops).
 Restricted to one or two parameters whose locals are exactly the
 parameters (no let-locals, no spill): the chosen registers RDI/RSI
 dodge the RAX/RDX that idiv/imul clobber, the R8/R9/R15 binary staging
 slots, the heap R10, and R11 -- so no body construct can alias a local.
 The temp rotation carves these out (active-temp-regs). Wider partitions
 (more params, let-locals) are a later increment.

  leaf-arg-reg-ok : IRDef, LeafProfile -> Boolean
  leaf-arg-reg-ok (def) (prof) =
   let np = list-length (def.params)
   in if prof.lp-has-calls then False
   else if np < 1 then False
   else if np > 2 then False
   else if prof.lp-locals /= np then False
   else should-tco def

  MinimalAttempt = record {
   ma-state : CodegenState,
   ma-mispredict : Boolean
  }

  emit-function-minimal : CodegenState, IRDef, LeafProfile -> MinimalAttempt
  emit-function-minimal (st1a) (def) (prof) =
   let use-arg-regs = leaf-arg-reg-ok def prof
   in let st1 = if use-arg-regs then __record-set st1a "func-local-regs" (take-arg-regs (list-length (def.params)) 0 []) else st1a
   in let cp-before = list-length (st1.cp-offsets)
   in let nlocals = prof.lp-locals
   in let st2 = if use-arg-regs then st1 else emit-minimal-pushes st1 nlocals 0
   in let st2g = if prof.lp-has-calls then emit-minimal-guard st2 else st2
   in let st2h = emit-param-guards st2g (def.params) 0
   in let st3p = bind-params st2h (def.params) 0
   in let st3 = bind-noalias-slots st3p def
   in let st4 = if should-tco def then
       let tco-alloc = if prof.lp-temps > 0 then pre-alloc-tco-temps st3 0 prof.lp-temps []
        else TcoAllocResult { alloc-state = st3, alloc-locals = [] }
       in let st-a = tco-alloc.alloc-state
       in __record-set st-a "tco" (TcoState {
       active = True,
       in-tail-pos = True,
       loop-top = st-a.code-len,
       param-locals = collect-param-locals (st-a.locals) (def.params) 0 [],
       temp-locals = tco-alloc.alloc-locals,
       current-func = def.name,
       saved-next-local = st-a.next-local,
       saved-next-temp = st-a.next-temp,
       inplace-params = []
      })
    else st3
   in let st5 = emit-to-local st4 (def.body) reg-rax (st4.tco.in-tail-pos)
   in let call-broke = if prof.lp-has-calls then False else list-length (st5.cp-offsets) > cp-before
   in let mispredict = st5.peak-local > nlocals | st5.peak-spill > 0 | call-broke
   in let st6g = emit-return-guard st5 def
   in let st7 = if use-arg-regs then st6g else emit-minimal-pops st6g nlocals
   in MinimalAttempt { ma-state = st-append-code st7 x86-ret, ma-mispredict = mispredict }

 leaf-profile is a heuristic, and a heuristic is allowed to be wrong. It
 sizes the minimal frame before the body is emitted, so it has to predict
 the emitter's own temp use; it has twice guessed low (an argument
 permutation needs a staging temp, and a nested argument expression needs
 more than one temp per complex argument), and each time the emitter
 overran the frame the profile had promised.

 That overrun used to be a codegen halt, which made a wrong guess reject
 valid Codex. Emission is cheap and rare here, so the mispredict is now a
 retry: the minimal bytes are abandoned where they lie, the offset entry
 is re-pointed past them, and the definition is emitted again through the
 standard path. Every future under-count is a missed optimization rather
 than a refusal to compile. Do not restore the error -- teaching the
 profile to count permutations and depth is worth doing on top of this,
 never instead of it.

  emit-function : CodegenState, IRDef -> CodegenState
  emit-function (st) (def) =
   let sel = lir-emit-try st def
   in if sel.handled then sel.state
   else let st0 = reset-func-state st (def.name)
   in let prof = leaf-profile st0 def
   in if prof.lp-ok then
     let attempt = emit-function-minimal st0 def prof
     in if attempt.ma-mispredict
      then emit-function-standard (reset-func-scratch (repoint-func-offset (attempt.ma-state))) def
      else attempt.ma-state
   else emit-function-standard st0 def

  emit-function-standard : CodegenState, IRDef -> CodegenState
  emit-function-standard (st1) (def) =
   let func-start = st1.code-len
   in let st2 = emit-prologue st1
   in let frame-patch-pos = st2.code-len
   in let st3 = st-append-code st2 (emit-sub-rsp-imm32 0)
   in let st3g = emit-param-guards st3 (def.params) 0
   in let st4p = bind-params st3g (def.params) 0
   in let st4 = bind-noalias-slots st4p def
   in let is-tco = should-tco def
   in let pnames = for p in (def.params) -> p.name
   in let needs-temps = if is-tco & list-length (def.params) <= 4 then tails-all-direct (def.body) True (def.name) pnames == False else is-tco
   in let temp-count = if needs-temps then tco-max-complex (def.body) (def.name) pnames 0 else 0
   in let ip-names = if is-tco & st4.omit-frame-pointer == False then inplace-accumulators def 0 [] else []
   in let st4i = emit-inplace-entry-guards st4 ip-names 0
   in let st5 = if is-tco then let tco-alloc = if temp-count > 0 then pre-alloc-tco-temps st4i 0 temp-count []
    else TcoAllocResult { alloc-state = st4i, alloc-locals = [] }
   in let st-a = tco-alloc.alloc-state
   in let p-locals = collect-param-locals (st-a.locals) (def.params) 0 []
   in let loop-top-pos = st-a.code-len
   in let st-b = when st-a.watchdog-mode
    is WatchdogPet -> emit-call-to st-a "__pet_watchdog"
    is otherwise -> st-a
   in __record-set st-b "tco" (TcoState {
       active = True,
       in-tail-pos = True,
       loop-top = loop-top-pos,
       param-locals = p-locals,
       temp-locals = tco-alloc.alloc-locals,
       current-func = def.name,
       saved-next-local = st-b.next-local,
       saved-next-temp = st-b.next-temp,
       inplace-params = ip-names
      })
    else st4i
   in let st6 = emit-to-local st5 (def.body) reg-rax (st5.tco.in-tail-pos)
   in let st6g = emit-return-guard st6 def
   in let st7 = emit-epilogue st6g
   in let used = if st7.peak-local > 4 then 4 else st7.peak-local
   in let unused = 4 - used
   in let frame-size = align-16 (st7.peak-spill * 8 + unused * 8)
   in let st8 = if frame-size == 0 then nop-sub-rsp st7 frame-patch-pos
   else st-add-deferred-patch st7 (make-i32-patch (frame-patch-pos + 3) frame-size)
   in nop-unused-pushes st8 func-start used (st7.omit-frame-pointer)

 Bounded signatures, stage B. A
 bounded parameter is a refined position enforced Eiffel-style at the
 callee entry: each bounded parameter is range-checked in the
 prologue, on the register it arrives in, before the body runs. An
 out-of-range argument traps (UD2) - the same trap a bounded field
 store emits. The guards run before bind-params, while arg-regs still
 hold the incoming arguments (the prologue's callee-saved pushes do
 not touch them). Only OvError bounds narrower than the full i64
 range are guarded; a plain Integer parameter costs nothing.

  emit-param-guards : CodegenState, List IRParam, Integer -> CodegenState
  emit-param-guards (st) (params) (i) =
   if i >= list-length params then st
   else let p = list-at params i
   in emit-param-guards (emit-one-param-guard st (p.type-val) i) params (i + 1)

  emit-one-param-guard : CodegenState, CodexType, Integer -> CodegenState
  emit-one-param-guard (st) (ty) (i) =
   when ty
    is IntegerTy (lo) (hi) (mode) ->
     when mode
      is OvError ->
       if lo <= i64-min & hi >= i64-max then st
       else if i < 6 then emit-range-trap st (list-at arg-regs i) lo hi
       else let tmp = alloc-temp st
            in let st1 = st-append-code (tmp.state) (mov-load (tmp.reg) reg-rbp (16 + (i - 6) * 8))
            in emit-range-trap st1 (tmp.reg) lo hi
      is otherwise -> st
    is otherwise -> st

 A range trap: cmp against the upper bound and trap if greater, then
 against the lower bound and trap if less. The same two conditional
 traps a bounded field store uses (emit-error-checked-store), minus
 the store - a parameter or return value stays a full register, so
 only its range is checked, not its storage width.

  emit-range-trap : CodegenState, Integer, Integer, Integer -> CodegenState
  emit-range-trap (st) (reg) (lo) (hi) =
   emit-error-bound-trap (emit-error-bound-trap st reg hi 14) reg lo 13

 The postcondition: a bounded return is range-checked on the result
 register before the epilogue, unless the body statically proves the
 result within the bound (value-fits-field, the emit prover's
 interval elision - the same one a bounded field store uses, giving
 the exact static/dynamic correspondence at the single return site).

  emit-return-guard : CodegenState, IRDef -> CodegenState
  emit-return-guard (st) (def) =
   when return-bound-of (def.type-val) (list-length (def.params))
    is IntegerTy (lo) (hi) (mode) ->
     when mode
      is OvError ->
       if lo <= i64-min & hi >= i64-max then st
       else if value-fits-field (st.range-env) (def.body) (deck-record (IntegerTy lo hi mode))
            then st-add-info st cdx-bounds-proven "bounds proven: return check elided" (def.span)
            else emit-range-trap st reg-rax lo hi
      is otherwise -> st
    is otherwise -> st

  return-bound-of : CodexType, Integer -> CodexType
  return-bound-of (ty) (n) =
   if n <= 0 then ty
   else when ty
    is FunTy (p) (row) (r) -> return-bound-of r (n - 1)
    is ForAllTy (id) (b) -> return-bound-of b n
    is ForAllEff (id) (b) -> return-bound-of b n
    is otherwise -> ty

 The eleven accumulators are sized once, on the emit deck, and pushed in
 place: list-push writes into the reservation and allocates nothing while
 the list stays under capacity. Past capacity a push does what any push
 does -- it doubles and reallocates -- and the new backing lands in the
 per-function bivy, which emit-all-defs reclaims with __heap-restore the
 moment the function is done. The accumulator then points at reclaimed
 memory and the table is silently corrupted.

  accum-at-capacity : CodegenState -> Boolean
  accum-at-capacity (st) =
   list-length (st.cp-offsets) >= accum-capacity * 4
   | list-length (st.cp-targets) >= accum-capacity * 4
   | list-length (st.fo-names) >= accum-capacity
   | list-length (st.fo-offsets) >= accum-capacity
   | list-length (st.fa-offsets) >= accum-capacity
   | list-length (st.fa-targets) >= accum-capacity
   | list-length (st.rf-poffsets) >= accum-capacity * 2
   | list-length (st.rf-roffsets) >= accum-capacity * 2
   | list-length (st.da-poffsets) >= accum-capacity
   | list-length (st.da-offsets) >= accum-capacity
   | list-length (st.stack-overflow-checks) >= accum-capacity

  is-proof-type : CodexType -> Boolean
  is-proof-type (ty) =
   when ty
    is ProofTy | PropEqTy (a) (b) -> True
    is otherwise -> False

  is-proof-def : IRDef -> Boolean
  is-proof-def (d) = is-proof-return (d.type-val)

  is-proof-return : CodexType -> Boolean
  is-proof-return (ty) =
   if is-proof-type ty then True
   else when ty
    is FunTy (p) (row) (r) -> is-proof-return r
    is otherwise -> False

 The proof definitions are therefore put BACK into the pruned chapter,
 here, on the way to the emitter. Rooting them in the prune instead would
 have been wrong: the flood would follow what a proof body references and
 resurrect all of it, growing every binary that carries a proof. This
 restores the definitions without reaching anything through them, and
 emit-all-defs still writes no code for one.

 The proof list is collected from the WHOLE chapter and it must be
 collected BEFORE the prune runs, which is why this is two functions and
 the caller holds the intermediate. Reading the whole chapter afterwards
 gets the pruned defs back instead: the prune sets the field with
 __record-set, so the chapter the caller still has a name for is the
 pruned one, and the proofs are already gone from it.

  keep-proof-defs : List IRDef, List IRDef, Integer -> List IRDef
  keep-proof-defs (acc) (all) (i) =
   if i == list-length all then acc
   else let d = list-at all i
   in if is-proof-def d then keep-proof-defs (list-push acc d) all (i + 1)
   else keep-proof-defs acc all (i + 1)

  ir-chapter-with-proofs : IRChapter, List IRDef -> IRChapter
  ir-chapter-with-proofs (pruned) (proofs) =
   __record-set pruned "defs" ((pruned.defs) & proofs)

  emit-all-defs : CodegenState, List IRDef, Integer -> CodegenState
  emit-all-defs (st) (defs) (i) =
   if i == list-length defs then st
   else if is-proof-def (list-at defs i) then let erased = list-at defs i
    in let st1 = st-add-info st cdx-claim-recognized ("proof '" & erased.name & "' erased (compile-time only)") (erased.span)
    in emit-all-defs st1 defs (i + 1)
   else if accum-at-capacity st then st-add-error st cdx-accum-overflow ("emitter accumulator full at definition '" & (list-at defs i).name & "': the emit tables are pre-allocated to accum-capacity and a push past it reallocates into scratch that this loop reclaims, corrupting the table. Raise accum-capacity in BuildSettings and rebuild the seed.") ((list-at defs i).span)
   else let def = list-at defs i
   in let h = __heap-save
   in let func-st = emit-function st def
   in let new-code-len = func-st.code-len
   in let new-data-len = func-st.data-len
   in let new-emit-work = func-st.emit-work
   in let func-start = list-at (func-st.fo-offsets) (list-length (func-st.fo-offsets) - 1)
   in let wcet-insns = if def.is-punctual then x86-count-insns (func-st.workspace.code-buffer) func-start new-code-len else 0
   in let restored = __heap-restore h
   in let next-st = deck-record (codegen-carry-forward st new-code-len new-data-len new-emit-work)
   in let wcet-st = if def.is-punctual then emit-wcet-check next-st def wcet-insns else next-st
   in emit-all-defs wcet-st defs (i + 1)

  emit-wcet-check : CodegenState, IRDef, Integer -> CodegenState
  emit-wcet-check (st) (def) (insn-count) =
   if insn-count < 0 then st-add-warning st cdx-rt-wcet-opaque ("[WCET] punctual '" & def.name & "': instruction count unavailable (undecodable byte at body offset " & show (-insn-count - 1) & "; extend X86_64InsnCount)") (def.span)
   else let budget = if def.wcet-budget > 0 then def.wcet-budget else 256
   in let st2 = st-add-info st cdx-rt-wcet-report ("[WCET] punctual '" & def.name & "': " & show insn-count & " instructions (" & show (insn-count * 100 / budget) & "% of budget " & show budget & ")") (def.span)
   in if insn-count > budget then st-add-warning st2 cdx-rt-wcet-exceeded ("[WCET] punctual '" & def.name & "' exceeds budget: " & show insn-count & " / " & show budget & " instructions") (def.span)
   else st2

 Only an EXPLICIT budget is reported. A wcet-budget of zero means the
 author declared none and emit-wcet-check substitutes the default 256;
 that is nobody's claim, so a pruned punctual without a budget is
 ordinary dead code and says nothing.

 This runs INSIDE the emit deck extent, and that placement is the whole
 correctness of it rather than a convenience. Raised from the caller, in
 the window between the frontend's phase-compact and emit-build's own
 reservation, the bag's allocation lands on top of live bivy values,
 because a compact leaves deck-pos and the bivy frontier equal. The emit
 deck is reserved above them, so a warning raised here cannot collide.
 The account is in opening.codex at compile-to-cdx-with-exit-mode.

  emit-wcet-unchecked : CodegenState, List IRDef, Integer -> CodegenState
  emit-wcet-unchecked (st) (ds) (i) =
   if i >= list-length ds then st
   else let d = list-at ds i
   in emit-wcet-unchecked (st-add-warning st cdx-rt-wcet-unchecked ("[WCET] punctual '" & d.name & "' declares budget " & show (d.wcet-budget) & " but emits no body, so the budget is unchecked") (d.span)) ds (i + 1)

Section: Local Variable Management
  lookup-local : List LocalBinding, Text -> Integer
  lookup-local (bindings) (name) =
   lookup-local-loop bindings name 0 (list-length bindings)

  lookup-local-loop : List LocalBinding, Text, Integer, Integer -> Integer
  lookup-local-loop (bindings) (name) (i) (len) =
   if i == len then -1
   else let b = list-at bindings i
   in if b.name == name then b.slot
      else lookup-local-loop bindings name (i + 1) len

  add-local : CodegenState, Text, Integer -> CodegenState
  add-local (st) (name) (slot) =
   __record-set st "locals" ([LocalBinding {
     name = name,
     slot = __narrow slot
    }] & (st.locals))

 add-local prepends and lookup-local takes the first match, so a lexical
 scope is exactly a PREFIX of st.locals: entering one adds bindings to
 the front, leaving one drops them again. Nothing popped before, so a
 binding introduced inside a let body or a match arm kept shadowing the
 outer binding of the same name for the rest of the function, and the
 stale slot still held the inner value - a silent miscompile.
 restore-locals reverts only the locals field: code, next-local,
 peak-local, spill-count and the patch tables are threaded forward, as
 they must be.

  restore-locals : CodegenState, List LocalBinding -> CodegenState
  restore-locals (st) (saved) =
   __record-set st "locals" saved

Section: Expression Emission
  emit-fc-barrier : EmitResult -> EmitResult
  emit-fc-barrier (r) =
   EmitResult {
    state = fc-flush (r.state),
    reg = r.reg
   }

  emit-expr : CodegenState, IRExpr -> EmitResult
  emit-expr (st) (expr) =
   if emit-fuel-exhausted st then EmitResult {
    state = emit-fuel-error st,
    reg = reg-rax
   }
   else emit-expr-dispatch (emit-fuel-bump st) expr

  emit-expr-dispatch : CodegenState, IRExpr -> EmitResult
  emit-expr-dispatch (st) (expr) =
   when expr
    is IrIntLit (value) (sp) | IrNumLit (value) (sp) -> emit-int-lit st value
    is IrBoolLit (value) (sp) -> emit-int-lit st (if value then 1 else 0)
    is IrCharLit (value) (sp) -> emit-int-lit st value
    is IrTextLit (value) (sp) -> emit-text-lit st value
    is IrNegate (operand) (ty) (sp) -> emit-negate st operand
    is IrError (msg) (ty) (sp) -> emit-int-lit (st-add-error st cdx-ir-error msg sp) 0
    is IrName (name) (ty) (sp) -> emit-name st name ty
    is IrLet (name) (ty) (value) (body) (sp) -> emit-let st name value body
    is IrBinary (op) (left) (right) (ty) (sp) -> emit-binary st op left right
    is IrIf (cond) (then-e) (else-e) (ty) (sp) -> emit-if st cond then-e else-e
    is IrApply (func) (arg) (ty) (sp) -> emit-apply st func arg ty
    is IrRecord (rname) (fields) (ty) (sp) -> emit-record st fields ty
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-field-access st rec field
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> emit-field-store st rec field val
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-match st scrut branches
    is IrList (elems) (ty) (sp) -> emit-list st elems
    is IrAct (stmts) (ty) (sp) ->
     let act-locals = st.locals
     in let act-r = emit-act-stmts st stmts 0 (list-length stmts)
     in EmitResult {
      state = restore-locals (act-r.state) act-locals,
      reg = act-r.reg
     }
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-fc-barrier (emit-with-timeout (fc-flush st) secs body)
    is IrFork (body) (ty) (sp) -> emit-fc-barrier (emit-fork (fc-flush st) body sp)
    is IrAwait (task) (ty) (sp) -> emit-fc-barrier (emit-await (fc-flush st) task)
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-fc-barrier (emit-handle (fc-flush st) eff body clauses ty)
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-fc-barrier (emit-try (fc-flush st) max body fb fail)
    is IrLambda (params) (body) (ty) (sp) -> EmitResult {
     state = st-add-error st cdx-ir-error "IrLambda survived lambda lifting" sp,
     reg = reg-rax
    }
    is otherwise -> EmitResult {
     state = st,
     reg = reg-rax
    }

  emit-field-store : CodegenState, IRExpr, Text, IRExpr -> EmitResult
  emit-field-store (st) (rec-expr) (field-name) (val-expr) =
   let fresh-slot = fresh-base-slot st rec-expr
   in let rec-result = emit-expr (st-set-tail-pos st False) rec-expr
   in let rec-loc = alloc-local (rec-result.state)
   in let st1 = store-local (rec-loc.state) (rec-loc.reg) (rec-result.reg)
   in let rec-ty = resolve-constructed-ty st (ir-expr-type rec-expr)
   in let val-result = emit-expr st1 val-expr
   in let loaded = load-local (val-result.state) (rec-loc.reg)
   in when rec-ty
    is RecordTy (rname) (rargs) (rfields) ->
     let fot = cce-byte-offset-and-type rfields field-name
     in let st-na = noalias-note (loaded.state) rec-expr "field store"
     in EmitResult {
      state = fc-store-barrier (emit-narrow-store-proven st-na (fot.type-val) (loaded.reg) (val-result.reg) (fot.offset) val-expr) fresh-slot (ir-expr-span rec-expr),
      reg = loaded.reg
     }
    is otherwise ->
     let st-err = st-add-error (loaded.state) cdx-ir-error ("field-store: unresolved type for field '" & field-name & "'") (ir-expr-span rec-expr)
     in EmitResult {
      state = st-append-code st-err [15, 11],
      reg = loaded.reg
     }

  emit-fork : CodegenState, IRExpr, SourceSpan -> EmitResult
  emit-fork (st) (body) (sp) =
   let body-result = emit-expr (st-set-tail-pos st False) body
   in let cl-loc = alloc-local (body-result.state)
   in let st0 = store-local (cl-loc.state) (cl-loc.reg) (body-result.reg)
   in let st1 = emit-fork-init-main st0
   in let desc-loc = alloc-local st1
   in let stk-loc = alloc-local (desc-loc.state)
   in let fh = alloc-temp (stk-loc.state)
   in let fa0 = st-append-code (fh.state) (li (fh.reg) fork-free-head-addr)
   in let fv = alloc-temp fa0
   in let fa1 = st-append-code (fv.state) (mov-load (fv.reg) (fh.reg) 0)
   in let fa2 = st-append-code fa1 (cmp-ri (fv.reg) 0)
   in let no-free = fa2.code-len
   in let fa3 = st-append-code fa2 (jcc cc-e 0)
   in let fnx = alloc-temp fa3
   in let fa4 = st-append-code (fnx.state) (mov-load (fnx.reg) (fv.reg) 24)
   in let fa5 = st-append-code fa4 (mov-store (fh.reg) (fnx.reg) 0)
   in let fa6 = store-local fa5 (desc-loc.reg) (fv.reg)
   in let fsb = alloc-temp fa6
   in let fa7 = st-append-code (fsb.state) (mov-rr (fsb.reg) (fv.reg))
   in let fa8 = st-append-code fa7 (add-ri (fsb.reg) task-desc-size)
   in let fa9 = store-local fa8 (stk-loc.reg) (fsb.reg)
   in let skip-alloc = fa9.code-len
   in let fa10 = st-append-code fa9 (jmp 0)
   in let bump-start = fa10.code-len
   in let fa11 = patch-jcc-at fa10 no-free bump-start
   in let r10-save = alloc-local fa11
   in let st1a = st-append-code (r10-save.state) (mov-rr reg-rax reg-r10)
   in let st1b = store-local st1a (r10-save.reg) reg-rax
   in let st1c = st-append-code st1b (li reg-r11 fork-pool-cursor-addr)
   in let st1d = st-append-code st1c (mov-load reg-r10 reg-r11 0)
   in let desc-alloc = emit-bivy-alloc st1d task-desc-size
   in let ba0 = store-local (desc-alloc.state) (desc-loc.reg) reg-rax
   in let stk-alloc = emit-bivy-alloc ba0 task-stack-size
   in let ba1 = store-local (stk-alloc.state) (stk-loc.reg) reg-rax
   in let st-pool = st-append-code ba1 (li reg-r11 fork-pool-cursor-addr)
   in let st-pool2 = st-append-code st-pool (mov-store reg-r11 reg-r10 0)
   in let r10-ld = load-local st-pool2 (r10-save.reg)
   in let st-restore = st-append-code (r10-ld.state) (mov-rr reg-r10 (r10-ld.reg))
   in let st-merge = patch-jmp-at st-restore skip-alloc (st-restore.code-len)
   in let z = alloc-temp st-merge
   in let st2 = st-append-code (z.state) (li (z.reg) 0)
   in let dl1 = load-local st2 (desc-loc.reg)
   in let st3 = st-append-code (dl1.state) (mov-store (dl1.reg) (z.reg) 0)
   in let st4 = st-append-code st3 (mov-store (dl1.reg) (z.reg) 16)
   in let st5 = st-append-code st4 (mov-store (dl1.reg) (z.reg) 24)
   in let st6 = st-append-code st5 (mov-store (dl1.reg) (z.reg) 56)
   in let stk-ld = load-local st6 (stk-loc.reg)
   in let dl2 = load-local (stk-ld.state) (desc-loc.reg)
   in let st7 = st-append-code (dl2.state) (mov-store (dl2.reg) (stk-ld.reg) 32)
   in let cl-ld = load-local st7 (cl-loc.reg)
   in let dl3 = load-local (cl-ld.state) (desc-loc.reg)
   in let st8 = st-append-code (dl3.state) (mov-store (dl3.reg) (cl-ld.reg) 48)
   in let stk-ld2 = load-local st8 (stk-loc.reg)
   in let top = alloc-temp (stk-ld2.state)
   in let st9 = st-append-code (top.state) (mov-rr (top.reg) (stk-ld2.reg))
   in let st10 = st-append-code st9 (add-ri (top.reg) task-stack-size)
   in let entry-tmp = alloc-temp st10
   in let st11 = emit-load-func-addr (entry-tmp.state) (entry-tmp.reg) "__task_entry"
   in let st12 = st-append-code st11 (mov-store (top.reg) (entry-tmp.reg) (0 - 8))
   in let zt = alloc-temp st12
   in let st13 = st-append-code (zt.state) (li (zt.reg) 0)
   in let st14 = st-append-code st13 (mov-store (top.reg) (zt.reg) (0 - 16))
   in let st15 = st-append-code st14 (mov-store (top.reg) (zt.reg) (0 - 24))
   in let st16 = st-append-code st15 (mov-store (top.reg) (zt.reg) (0 - 32))
   in let st17 = st-append-code st16 (mov-store (top.reg) (zt.reg) (0 - 40))
   in let st18 = st-append-code st17 (mov-store (top.reg) (zt.reg) (0 - 48))
   in let st19 = st-append-code st18 (mov-store (top.reg) (zt.reg) (0 - 56))
   in let dl4 = load-local st19 (desc-loc.reg)
   in let sp-tmp = alloc-temp (dl4.state)
   in let st20 = st-append-code (sp-tmp.state) (mov-rr (sp-tmp.reg) (top.reg))
   in let st21 = st-append-code st20 (add-ri (sp-tmp.reg) (0 - 56))
   in let st22 = st-append-code st21 (mov-store (dl4.reg) (sp-tmp.reg) 8)
   in let rh = alloc-temp st22
   in let st23 = st-append-code (rh.state) (li (rh.reg) sched-ready-head-addr)
   in let nx = alloc-temp st23
   in let st24 = st-append-code (nx.state) (mov-load (nx.reg) (rh.reg) 0)
   in let dl5 = load-local st24 (desc-loc.reg)
   in let st25 = st-append-code (dl5.state) (mov-store (dl5.reg) (nx.reg) 24)
   in let st26 = st-append-code st25 (mov-store (rh.reg) (dl5.reg) 0)
   in load-local st26 (desc-loc.reg)

  emit-fork-init-main : CodegenState -> CodegenState
  emit-fork-init-main (st) =
   let chk = alloc-temp st
   in let st1 = st-append-code (chk.state) (li (chk.reg) sched-current-task-addr)
   in let v = alloc-temp st1
   in let st2 = st-append-code (v.state) (mov-load (v.reg) (chk.reg) 0)
   in let st3 = st-append-code st2 (cmp-ri (v.reg) 0)
   in let skip-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let md = alloc-temp st4
   in let st5 = st-append-code (md.state) (mov-rr (md.reg) reg-r10)
   in let st6 = heap-bump-imm st5 task-desc-size
   in let s1 = alloc-temp st6
   in let st7 = st-append-code (s1.state) (li (s1.reg) 1)
   in let st8 = st-append-code st7 (mov-store (md.reg) (s1.reg) 0)
   in let st8b = st-append-code st8 (mov-store (md.reg) reg-r10 32)
   in let st9 = st-append-code st8b (li (s1.reg) sched-current-task-addr)
   in let st10 = st-append-code st9 (mov-store (s1.reg) (md.reg) 0)
   in let st10a = st-append-code st10 (li (s1.reg) fork-pool-cursor-addr)
   in let st10b = st-append-code st10a (mov-store (s1.reg) reg-r10 0)
   in let st10c = heap-bump-imm st10b fork-pool-reservation
   in patch-jcc-at st10c skip-pos (st10c.code-len)

  emit-await : CodegenState, IRExpr -> EmitResult
  emit-await (st) (task-expr) =
   let task-result = emit-expr (st-set-tail-pos st False) task-expr
   in let tl = alloc-local (task-result.state)
   in let st1 = store-local (tl.state) (tl.reg) (task-result.reg)
   in let ld1 = load-local st1 (tl.reg)
   in let sc = alloc-temp (ld1.state)
   in let st2 = st-append-code (sc.state) (mov-load (sc.reg) (ld1.reg) 0)
   in let st3 = st-append-code st2 (cmp-ri (sc.reg) 3)
   in let done-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let cm = alloc-temp st4
   in let st5 = st-append-code (cm.state) (li (cm.reg) sched-current-task-addr)
   in let st6 = st-append-code st5 (mov-load (cm.reg) (cm.reg) 0)
   in let bl = alloc-temp st6
   in let st7 = st-append-code (bl.state) (li (bl.reg) 2)
   in let st8 = st-append-code st7 (mov-store (cm.reg) (bl.reg) 0)
   in let ld2 = load-local st8 (tl.reg)
   in let st9 = st-append-code (ld2.state) (mov-store (ld2.reg) (cm.reg) 56)
   in let st10 = emit-call-to st9 "__task_yield"
   in let st11 = patch-jcc-at st10 done-pos (st10.code-len)
   in let ld3 = load-local st11 (tl.reg)
   in let rd = alloc-temp (ld3.state)
   in let st12 = st-append-code (rd.state) (mov-load (rd.reg) (ld3.reg) 16)
   in let ld4 = load-local st12 (tl.reg)
   in let fh = alloc-temp (ld4.state)
   in let st13 = st-append-code (fh.state) (li (fh.reg) fork-free-head-addr)
   in let old-head = alloc-temp st13
   in let st14 = st-append-code (old-head.state) (mov-load (old-head.reg) (fh.reg) 0)
   in let st15 = st-append-code st14 (mov-store (ld4.reg) (old-head.reg) 24)
   in let st16 = st-append-code st15 (mov-store (fh.reg) (ld4.reg) 0)
   in EmitResult { state = st16, reg = rd.reg }

  emit-handle : CodegenState, Text, IRExpr, List IRHandleClause, CodexType -> EmitResult
  emit-handle (st) (eff) (body) (clauses) (ty) =
   let st-save = emit-push-handler-slots st clauses 0 (list-length clauses)
   in let st1 = emit-handle-clauses st-save clauses 0
   in let body-result = emit-expr (st-set-tail-pos st1 False) body
   in let save-result = alloc-local (body-result.state)
   in let st-sr = store-local (save-result.state) (save-result.reg) (body-result.reg)
   in let st-pop = emit-pop-handler-slots st-sr clauses (list-length clauses)
   in load-local st-pop (save-result.reg)

  emit-push-handler-slots : CodegenState, List IRHandleClause, Integer, Integer -> CodegenState
  emit-push-handler-slots (st) (clauses) (i) (len) =
   if i >= len then st
   else let c = list-at clauses i
   in let eoa = find-effect-op-addr (st.effect-op-addrs) (c.op-name) 0 (list-length (st.effect-op-addrs))
   in if eoa >= 0 then let st1 = st-append-code st (li reg-r11 eoa)
     in let st2 = st-append-code st1 (mov-load reg-rax reg-r11 0)
     in let st3 = st-append-code st2 (push-r reg-rax)
     in emit-push-handler-slots st3 clauses (i + 1) len
      else emit-push-handler-slots st clauses (i + 1) len

  emit-pop-handler-slots : CodegenState, List IRHandleClause, Integer -> CodegenState
  emit-pop-handler-slots (st) (clauses) (i) =
   if i <= 0 then st
   else let c = list-at clauses (i - 1)
   in let eoa = find-effect-op-addr (st.effect-op-addrs) (c.op-name) 0 (list-length (st.effect-op-addrs))
   in if eoa >= 0 then let st1 = st-append-code st (pop-r reg-rax)
     in let st2 = st-append-code st1 (li reg-r11 eoa)
     in let st3 = st-append-code st2 (mov-store reg-r11 reg-rax 0)
     in emit-pop-handler-slots st3 clauses (i - 1)
      else emit-pop-handler-slots st clauses (i - 1)

  emit-handle-clauses : CodegenState, List IRHandleClause, Integer -> CodegenState
  emit-handle-clauses (st) (clauses) (i) =
   if i == list-length clauses then st
   else let c = list-at clauses i
   in let st1 = emit-handle-one-clause st c
   in emit-handle-clauses st1 clauses (i + 1)

 `op-name` is added AFTER the body ON PURPOSE and must survive: the
 handled expression reads the handler slot through it, and a multi-op
 handler needs every earlier op still bound when its body runs. So the
 restore goes BETWEEN the two. Each clause's saved prefix already carries
 the op-names of the clauses before it, which is what keeps multi-op and
 nested handlers working.

  emit-handle-one-clause : CodegenState, IRHandleClause -> CodegenState
  emit-handle-one-clause (st) (clause) =
   let clause-locals = st.locals
   in let resume-loc = alloc-local st
   in let op-loc = alloc-local (resume-loc.state)
   in let jmp-over = op-loc.state.code-len
   in let st1 = st-append-code (op-loc.state) (jmp 0)
   in let resume-tramp = st1.code-len
   in let st2 = st-append-code st1 (mov-rr reg-rax reg-rdi & x86-ret-drop 8)
   in let st3 = patch-jmp-at st2 jmp-over (st2.code-len)
   in let addr-loc = alloc-local st3
   in let st4 = emit-load-known-func-offset (addr-loc.state) reg-rax resume-tramp
   in let st4b = store-local st4 (addr-loc.reg) reg-rax
   in let rt-alloc = emit-bivy-alloc st4b 8
   in let addr-ld = load-local (rt-alloc.state) (addr-loc.reg)
   in let rt-ld = load-local (addr-ld.state) (rt-alloc.ptr-loc)
   in let st5 = st-append-code (rt-ld.state) (mov-store (rt-ld.reg) (addr-ld.reg) 0)
   in let st6 = store-local st5 (resume-loc.reg) (rt-ld.reg)
   in let st7 = add-local st6 (clause.resume-name) (resume-loc.reg)
   in let result = emit-expr (st-set-tail-pos st7 False) (clause.body)
   in let st8 = store-local (result.state) (op-loc.reg) (result.reg)
   in let st9 = emit-store-to-handler-table st8 (clause.op-name) (result.reg)
   in add-local (restore-locals st9 clause-locals) (clause.op-name) (op-loc.reg)

  emit-store-to-handler-table : CodegenState, Text, Integer -> CodegenState
  emit-store-to-handler-table (st0) (op-name) (val-reg) =
   let st = eo-note-handled st0 op-name
   in let eoa = find-effect-op-addr (st.effect-op-addrs) op-name 0 (list-length (st.effect-op-addrs))
   in if eoa >= 0 then let tmp = alloc-local st
     in let st1 = store-local (tmp.state) (tmp.reg) val-reg
     in let st2 = st-append-code st1 (li reg-r11 eoa)
     in let ld = load-local st2 (tmp.reg)
     in st-append-code (ld.state) (mov-store reg-r11 (ld.reg) 0)
      else st

  emit-with-timeout : CodegenState, Integer, IRExpr -> EmitResult
  emit-with-timeout (st) (secs) (body) =
   let expiry-ticks = secs * ticks-per-second
   in let st1 = st-append-code st (li reg-rdi tick-count-addr)
   in let st2 = st-append-code st1 (mov-load reg-rdi reg-rdi 0)
   in let st3 = st-append-code st2 (add-ri reg-rdi expiry-ticks)
   in let st4 = st-append-code st3 (li reg-rsi cap-expiry-addr)
   in let st5 = st-append-code st4 (mov-store reg-rsi reg-rdi 0)
   in let body-result = emit-expr (st-set-tail-pos st5 False) body
   in let st6 = st-append-code (body-result.state) (push-r (body-result.reg))
   in let st7 = st-append-code st6 (li reg-rdi cap-expiry-addr)
   in let st8 = st-append-code st7 (li reg-rsi 0)
   in let st9 = st-append-code st8 (mov-store reg-rdi reg-rsi 0)
   in let st10 = st-append-code st9 (pop-r (body-result.reg))
   in EmitResult { state = st10, reg = body-result.reg }

  emit-act-stmts : CodegenState, List IRActStmt, Integer, Integer -> EmitResult
  emit-act-stmts (st) (stmts) (i) (len) =
   if i == len then EmitResult { state = st, reg = reg-rax }
   else let s = list-at stmts i
    in let saved-tail = st.tco.in-tail-pos
    in when s
     is IrDoBind (name) (ty) (val) (sp) ->
      let val-result = emit-expr (st-set-tail-pos st False) val
      in let loc = alloc-local (val-result.state)
       in let st1 = store-local (loc.state) (loc.reg) (val-result.reg)
        in let st2 = add-local st1 name (loc.reg)
         in emit-act-stmts (st-set-tail-pos st2 saved-tail) stmts (i + 1) len
     is IrDoExec (e) (sp) ->
      if i == len - 1 then emit-expr st e
      else let r = emit-expr (st-set-tail-pos st False) e
       in emit-act-stmts (st-set-tail-pos (r.state) saved-tail) stmts (i + 1) len

  emit-try-check-flag : CodegenState, Integer -> CodegenState
  emit-try-check-flag (st) (body-failed-pos) =
   let st1 = st-append-code st (li reg-rdi (st-cell st try-fail-flag-addr) & mov-load reg-rsi reg-rdi 0 & cmp-ri reg-rsi 0)
   in st-append-code st1 (jcc cc-ne (body-failed-pos - (st1.code-len + 6)))

  emit-try-body-stmts : CodegenState, List IRActStmt, Integer, Integer, Integer -> EmitResult
  emit-try-body-stmts (st) (stmts) (i) (len) (body-failed-pos) =
   if i == len then EmitResult { state = st, reg = reg-rax }
   else let s = list-at stmts i
    in when s
     is IrDoBind (name) (ty) (val) (sp) ->
      let val-result = emit-expr (st-set-tail-pos st False) val
      in let loc = alloc-local (val-result.state)
       in let st1 = store-local (loc.state) (loc.reg) (val-result.reg)
        in let st2 = add-local st1 name (loc.reg)
         in let st3 = emit-try-check-flag st2 body-failed-pos
         in emit-try-body-stmts st3 stmts (i + 1) len body-failed-pos
     is IrDoExec (e) (sp) ->
      let r = emit-expr (st-set-tail-pos st False) e
      in let st1 = emit-try-check-flag (r.state) body-failed-pos
      in if i == len - 1 then EmitResult { state = st1, reg = r.reg }
      else emit-try-body-stmts st1 stmts (i + 1) len body-failed-pos

 The body is the sharp one. It re-runs from `retry-pos` on every attempt,
 so its slot holds whichever attempt failed last -- there is no single
 value a later reader could correctly be given.

  emit-try : CodegenState, Integer, List IRActStmt, List IRActStmt, List IRActStmt -> EmitResult
  emit-try (st) (max) (body) (fb) (fail) =
   let counter-loc = alloc-local st
   in let st1 = st-append-code (counter-loc.state) (li reg-rax 0)
   in let st2 = store-local st1 (counter-loc.reg) reg-rax
   in let heap-loc = alloc-local st2
   in let st3 = st-append-code (heap-loc.state) (mov-rr reg-rax reg-r10)
   in let st4 = store-local st3 (heap-loc.reg) reg-rax
   in let retry-pos = st4.code-len
   in let st5 = st-append-code st4 (li reg-rdi (st-cell st4 try-fail-flag-addr) & li reg-rsi 0 & mov-store reg-rdi reg-rsi 0)
   in let ld-heap = load-local st5 (heap-loc.reg)
   in let st6 = st-append-code (ld-heap.state) (mov-rr reg-r10 (ld-heap.reg))
   in let jmp-over-pos = st6.code-len
   in let st7 = st-append-code st6 (jmp 0)
   in let body-failed-pos = st7.code-len
   in let ld-ctr = load-local st7 (counter-loc.reg)
   in let st8 = st-append-code (ld-ctr.state) (add-ri (ld-ctr.reg) 1)
   in let st9 = store-local st8 (counter-loc.reg) (ld-ctr.reg)
   in let ld-ctr2 = load-local st9 (counter-loc.reg)
   in let st10 = st-append-code (ld-ctr2.state) (cmp-ri (ld-ctr2.reg) max)
   in let jl-retry-pos = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-l (retry-pos - (st10.code-len + 6)))
   in let jmp-exhaust-pos = st11.code-len
   in let st12 = st-append-code st11 (jmp 0)
   in let body-start-pos = st12.code-len
   in let st13 = patch-jmp-at st12 jmp-over-pos body-start-pos
   in let try-locals = st13.locals
   in let body-result = emit-try-body-stmts st13 body 0 (list-length body) body-failed-pos
   in let jmp-success-pos = (body-result.state).code-len
   in let st14 = st-append-code (restore-locals (body-result.state) try-locals) (jmp 0)
   in let exhaust-pos = st14.code-len
   in let st15 = patch-jmp-at st14 jmp-exhaust-pos exhaust-pos
   in let st-fb = if list-length fb > 0
     then let fb-clear = st-append-code st15 (li reg-rdi (st-cell st15 try-fail-flag-addr) & li reg-rsi 0 & mov-store reg-rdi reg-rsi 0)
       in let fb-result = emit-act-stmts (st-set-tail-pos fb-clear False) fb 0 (list-length fb)
       in let fb-flag = st-append-code (restore-locals (fb-result.state) try-locals) (li reg-rdi (st-cell (fb-result.state) try-fail-flag-addr) & mov-load reg-rsi reg-rdi 0 & cmp-ri reg-rsi 0)
       in let jne-fail-pos = fb-flag.code-len
       in let fb-done = st-append-code fb-flag (jcc cc-ne 0)
       in EmitResult { state = fb-done, reg = fb-result.reg }
     else EmitResult { state = st15, reg = reg-rax }
   in let jmp-end-fb-pos = (st-fb.state).code-len
   in let st16 = st-append-code (st-fb.state) (jmp 0)
   in let st-fail = if list-length fail > 0
     then let fail-pos = st16.code-len
       in let st-pfb = if list-length fb > 0 then patch-jcc-at st16 (jmp-end-fb-pos - 6) fail-pos else st16
       in let fail-clear = st-append-code st-pfb (li reg-rdi (st-cell st-pfb try-fail-flag-addr) & li reg-rsi 0 & mov-store reg-rdi reg-rsi 0)
       in let fail-result = emit-act-stmts (st-set-tail-pos fail-clear False) fail 0 (list-length fail)
       in EmitResult { state = restore-locals (fail-result.state) try-locals, reg = fail-result.reg }
     else st-fb
   in let end-pos = (st-fail.state).code-len
   in let st17 = patch-jmp-at (st-fail.state) jmp-success-pos end-pos
   in let st18 = patch-jmp-at st17 jmp-end-fb-pos end-pos
   in EmitResult { state = st18, reg = st-fail.reg }

 The RAX eviction below is load-bearing and must not be dropped as redundant.
 This writes RAX with a hardcoded mov-ri64 BEFORE it calls alloc-temp, and
 alloc-temp only evicts the register it hands out -- so without the eviction the
 field cache goes on claiming that some earlier field access is still live in
 RAX, which this instruction has just destroyed. A later read of that same field
 in the same expression then hits the stale entry and uses RAX, which now holds
 the address of this string literal.

  emit-text-lit : CodegenState, Text -> EmitResult
  emit-text-lit (st) (value) =
   let len = text-length value
   in let rodata-off = st.data-len
   in let str-bytes = append-text-bytes (write-i64 len) value 0 len
   in let padded = pad-to-8 str-bytes
   in let new-data-len = __buf-write-bytes (st.workspace.data-buffer) (st.data-len) padded
   in let st1 = __record-set st "data-len" new-data-len
   in let fixup = RodataFixup {
    patch-offset = st1.code-len + 2,
    rodata-offset = rodata-off
   }
   in let st2 = st-append-code (fc-evict-reg st1 reg-rax) (mov-ri64 reg-rax 0)
   in let rf-p = list-push (st2.rf-poffsets) (fixup.patch-offset)
   in let rf-r = list-push (st2.rf-roffsets) (fixup.rodata-offset)
   in let st3 = __record-set (__record-set st2 "rf-poffsets" rf-p) "rf-roffsets" rf-r
   in let rd = alloc-temp st3
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  append-text-bytes : List Integer, Text, Integer, Integer -> List Integer
  append-text-bytes (acc) (s) (i) (len) =
   if i == len then acc
   else append-text-bytes (list-push acc (char-code-at s i)) s (i + 1) len

  pad-to-8 : List Integer -> List Integer
  pad-to-8 (xs) =
   let rem = int-mod (list-length xs) 8
   in if rem == 0 then xs
    else pad-to-8 (list-push xs 0)

 A real is negated by FLIPPING ITS SIGN BIT, which is bit 31 for an f32 and
 bit 63 for an f64. The value is already in a general register as raw bits at
 this point, so the flip is an xor there and never reaches an xmm.

 This used to emit `0 - x` as `subsd`, which is wrong twice. It is the DOUBLE
 subtract whatever the width, so an f32 was negated as though its bit pattern
 were an f64; and `0 - x` is not negation even at the right width, because
 IEEE 754 says 0 - (+0) is +0 while the negation of +0 is -0.

  emit-negate : CodegenState, IRExpr -> EmitResult
  emit-negate (st) (operand) =
   let op-ty = ir-expr-type operand
   in let r = emit-expr (st-set-tail-pos st False) operand
   in let rd = alloc-temp (r.state)
   in if is-real-type op-ty then
    let m = alloc-temp (rd.state)
    in let st1 = st-append-code (m.state) (mov-rr (rd.reg) (r.reg))
    in let st2 = st-append-code st1 (mov-ri64 (m.reg) (if is-real-f32 op-ty then bit-shl 1 31 else bit-shl 1 63))
    in EmitResult {
     state = st-append-code st2 (xor-rr64 (rd.reg) (m.reg)),
     reg = rd.reg
    }
   else let st1 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in EmitResult {
   state = st-append-code st1 (neg-r (rd.reg)),
   reg = rd.reg
  }

 The unit wrapper is stripped first, the same strip and for the same
 reason as `emit-eq-op` and `emit-ord-comparison`. Without it a unit
 type misses the arm its inner type is entitled to and falls to the
 `otherwise` arm, which is `__itoa` -- so `show` prints the machine
 representation rather than the value. Measured on the seed before this
 change, against an unwrapped control on every row:

   unit Text     "abcd"  ->  1132612              the pointer, as decimal
   unit Boolean  True    ->  1                    the raw tag
   unit Real     2.5     ->  4612811918334230528  0x4004000000000000

 `unit Integer` was already correct, which is exactly what made this
 cheap to miss: the one row anybody would spot-check is the one row
 where `otherwise` is the right destination.

  emit-show-builtin : CodegenState, List IRExpr -> EmitResult
  emit-show-builtin (st) (args) =
   let arg = list-at args 0
   in let resolved = strip-unit-ty (resolve-to-sum-with-defs st (ir-expr-type arg))
   in if is-real-f32 resolved then emit-show-real-approx st args
   else if is-real-type resolved then emit-helper-call-1 st args "__real_to_text"
   else when resolved
    is TextTy -> emit-expr (st-set-tail-pos st False) arg
    is BooleanTy -> emit-show-bool st arg
    is otherwise -> emit-helper-call-1 st args "__itoa"

  emit-show-real-approx : CodegenState, List IRExpr -> EmitResult
  emit-show-real-approx (st) (args) =
   let val = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (val.state)
   in let st1 = st-append-code (rd.state) (movq-to-xmm 0 (val.reg) & cvtss2sd-xmm 0 0 & movq-from-xmm (rd.reg) 0)
   in let st2 = st-append-code st1 (mov-rr reg-rdi (rd.reg))
   in let st3 = emit-call-to st2 "__real_to_text"
   in let tmp = alloc-temp st3
   in EmitResult {
    state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
    reg = tmp.reg
   }

  emit-show-bool : CodegenState, IRExpr -> EmitResult
  emit-show-bool (st) (arg) =
   let val-result = emit-expr (st-set-tail-pos st False) arg
   in let st1 = st-append-code (val-result.state) (test-rr (val-result.reg) (val-result.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let true-result = emit-text-lit st2 "True"
   in let result-loc = alloc-local (true-result.state)
   in let st3 = store-local (result-loc.state) (result-loc.reg) (true-result.reg)
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let false-result = emit-text-lit st5 "False"
   in let st6 = store-local (false-result.state) (result-loc.reg) (false-result.reg)
   in let st7 = patch-jmp-at st6 jmp-end-pos (st6.code-len)
   in load-local st7 (result-loc.reg)

 THIS TRANSFORM ASSUMES THE SIGN BIT IS THE REGISTER'S TOP BIT, which is
 the whole reason it needed a width. It maps an IEEE bit pattern to a
 monotonic signed ordinal so that a ULP distance is a subtraction, and it
 does that by broadcasting the sign with `sar 63`. An f32 sits zero-extended
 in the low half, so its sign lives at bit 31, `sar 63` always read zero,
 and every single-precision value was treated as positive.

 Measured 2026-07-28, before the fix: `-0.0` and `+0.0` as `Real
 approximate` compared UNEQUAL under both `~` and `~0`, and the identical
 f64 pair compared equal. Anything straddling zero was wrong the same way.

 Shifting the pattern up by 32 puts the single's sign where the transform
 expects it; shifting the ordinal back down afterwards restores ULP units,
 so the four-ULP tolerance stays the number 4 at both widths rather than
 becoming a second width-dependent constant.

  float-to-ordinal : Integer, Integer -> List Integer
  float-to-ordinal (val) (tmp) = float-to-ordinal-sized val tmp False

  float-to-ordinal-sized : Integer, Integer, Boolean -> List Integer
  float-to-ordinal-sized (val) (tmp) (f32) =
   (if f32 then shl-ri val 32 else [])
   & mov-rr tmp val
   & sar-ri tmp 63
   & push-r tmp
   & shr-ri tmp 1
   & xor-rr64 val tmp
   & pop-r tmp
   & sub-rr val tmp
   & (if f32 then sar-ri val 32 else [])

  emit-approx-eq : CodegenState, Integer, Integer, Boolean -> EmitResult
  emit-approx-eq (st) (l-reg) (r-reg) (f32) =
   let rd = alloc-temp st
   in let t1 = alloc-temp (rd.state)
   in EmitResult {
   state = st-append-code (t1.state) (
    mov-rr (rd.reg) l-reg
    & float-to-ordinal-sized (rd.reg) (t1.reg) f32
    & push-r (rd.reg)
    & mov-rr (rd.reg) r-reg
    & float-to-ordinal-sized (rd.reg) (t1.reg) f32
    & mov-rr (t1.reg) (rd.reg)
    & pop-r (rd.reg)
    & sub-rr (rd.reg) (t1.reg)
    & mov-rr (t1.reg) (rd.reg)
    & sar-ri (t1.reg) 63
    & xor-rr64 (rd.reg) (t1.reg)
    & sub-rr (rd.reg) (t1.reg)
    & cmp-ri (rd.reg) 4
    & setcc cc-be (rd.reg)
    & movzx-byte-self (rd.reg)
   ),
   reg = rd.reg
  }

  emit-approx-eq-exact : CodegenState, Integer, Integer, Boolean -> EmitResult
  emit-approx-eq-exact (st) (l-reg) (r-reg) (f32) =
   let rd = alloc-temp st
   in let t1 = alloc-temp (rd.state)
   in EmitResult {
   state = st-append-code (t1.state) (
    mov-rr (rd.reg) l-reg
    & float-to-ordinal-sized (rd.reg) (t1.reg) f32
    & push-r (rd.reg)
    & mov-rr (rd.reg) r-reg
    & float-to-ordinal-sized (rd.reg) (t1.reg) f32
    & mov-rr (t1.reg) (rd.reg)
    & pop-r (rd.reg)
    & sub-rr (rd.reg) (t1.reg)
    & mov-rr (t1.reg) (rd.reg)
    & sar-ri (t1.reg) 63
    & xor-rr64 (rd.reg) (t1.reg)
    & sub-rr (rd.reg) (t1.reg)
    & cmp-ri (rd.reg) 0
    & setcc cc-be (rd.reg)
    & movzx-byte-self (rd.reg)
   ),
   reg = rd.reg
  }

  emit-num-arith : CodegenState, Integer, Integer, Integer -> EmitResult
  emit-num-arith (st) (l-reg) (r-reg) (sse-op) =
   let rd = alloc-temp st
   in EmitResult {
   state = st-append-code (rd.state) (
    movq-to-xmm 0 l-reg
    & movq-to-xmm 1 r-reg
    & [242, 15, sse-op, modrm 3 0 1]
    & movq-from-xmm (rd.reg) 0
   ),
   reg = rd.reg
  }

  emit-real-approx-arith : CodegenState, Integer, Integer, List Integer -> EmitResult
  emit-real-approx-arith (st) (l-reg) (r-reg) (sse-insn) =
   let rd = alloc-temp st
   in EmitResult {
   state = st-append-code (rd.state) (
    movq-to-xmm 0 l-reg
    & movq-to-xmm 1 r-reg
    & sse-insn
    & movq-from-xmm (rd.reg) 0
   ),
   reg = rd.reg
  }

 `Real trapping` and `Real saturating` both have to answer the question
 "is this result outside the finite range", and one test answers it for
 both. Shift the sign bit off, shift the mantissa off, and what is left is
 the eleven-bit exponent; it reads 2047 for exactly the infinities and the
 NaNs and for nothing else. That needs no 64-bit constant and so no extra
 register beyond one scratch, which matters because these sequences are
 emitted inline at every arithmetic site.

 The scratch is a second temp, and it is only ever touched AFTER both
 operands have been moved into xmm0 and xmm1. That ordering is the whole
 safety argument: `alloc-temp` rotates a six-register pool and can hand back
 a register an operand still lives in, so a scratch used before the operands
 are consumed would destroy one of them.

 THE FOUR CONSTANTS BELOW ARE THE WHOLE WIDTH DIFFERENCE, and each is
 derived rather than chosen. `0xF2` prefixes a scalar DOUBLE SSE op and
 `0xF3` a scalar SINGLE one. A double is sign(1) exponent(11) mantissa(52),
 so shifting the sign off and the mantissa down leaves the exponent in
 `shl 1, shr 53` and all ones is 2047. A single is sign(1) exponent(8)
 mantissa(23) living in the LOW 32 BITS of the register, so the same
 extraction is `shl 33, shr 56` and all ones is 255.

 That the single sits in the low half and the upper half is zero is an
 invariant this emitter already maintains: `movq-to-xmm` zeroes bits
 127:64, `addss` and its siblings write only bits 31:0, and
 `movq-from-xmm` brings the pair back, so an f32 held in a general
 register is always zero-extended. The saturating clamp below depends on
 it -- `sub 1` on a 64-bit register would borrow from the upper half if
 anything lived there.

  real-exp-shl : Boolean -> Integer
  real-exp-shl (f32) = if f32 then 33 else 1

  real-exp-shr : Boolean -> Integer
  real-exp-shr (f32) = if f32 then 56 else 53

  real-exp-ones : Boolean -> Integer
  real-exp-ones (f32) = if f32 then 255 else 2047

  real-sse-prefix : Boolean -> Integer
  real-sse-prefix (f32) = if f32 then 243 else 242

 The mantissa test tells an infinity from a NaN, both of which carry an
 all-ones exponent. Shifting sign and exponent off leaves the mantissa,
 which is zero for an infinity: 1 + 11 = 12 for a double, and for a single
 the 23 mantissa bits end at bit 22, so 64 - 23 = 41.

  real-mant-shl : Boolean -> Integer
  real-mant-shl (f32) = if f32 then 41 else 12

  real-arith-is-f32 : CodegenState, CodexType -> Boolean
  real-arith-is-f32 (st) (ty) = is-real-f32 (strip-unit-ty (resolve-to-sum-with-defs st ty))

  emit-real-trapping-arith : CodegenState, Integer, Integer, Integer, Boolean -> EmitResult
  emit-real-trapping-arith (st) (l-reg) (r-reg) (sse-op) (f32) =
   let rd = alloc-temp st
   in let sc = alloc-temp (rd.state)
   in let ud2 = [15, 11]
   in EmitResult {
   state = st-append-code (sc.state) (
    movq-to-xmm 0 l-reg
    & movq-to-xmm 1 r-reg
    & [real-sse-prefix f32, 15, sse-op, modrm 3 0 1]
    & movq-from-xmm (rd.reg) 0
    & mov-rr (sc.reg) (rd.reg)
    & shl-ri (sc.reg) (real-exp-shl f32)
    & shr-ri (sc.reg) (real-exp-shr f32)
    & cmp-ri (sc.reg) (real-exp-ones f32)
    & jcc cc-ne (list-length ud2)
    & ud2
   ),
   reg = rd.reg
  }

 Saturating clamps an infinite result to the largest finite magnitude of the
 same sign, and it does that by DECREMENTING the bit pattern. Positive
 infinity is `7FF0000000000000` and one less is `7FEFFFFFFFFFFFFF`, which is
 the largest finite double; negative infinity is `FFF0000000000000` and one
 less is `FFEFFFFFFFFFFFFF`, the most negative. The sign is carried for free
 because the decrement never reaches the sign bit.

 A NaN answers zero, which is what this emitter already did and is not part
 of what was broken. It is kept deliberately rather than revisited: the
 documented contract for this mode is about the range, the existing
 `nan-safe` assertion depends on the zero, and choosing a different NaN
 answer is a language decision rather than a repair.

  emit-real-saturating-arith : CodegenState, Integer, Integer, Integer, Boolean -> EmitResult
  emit-real-saturating-arith (st) (l-reg) (r-reg) (sse-op) (f32) =
   let rd = alloc-temp st
   in let sc = alloc-temp (rd.state)
   in let mant = mov-rr (sc.reg) (rd.reg) & shl-ri (sc.reg) (real-mant-shl f32) & test-rr (sc.reg) (sc.reg)
   in let clamp = sub-ri (rd.reg) 1
   in let zero = xor-rr (rd.reg) (rd.reg)
   in let skip-zero = jmp (list-length zero)
   in let to-nan = jcc cc-ne (list-length clamp + list-length skip-zero)
   in let to-done = jcc cc-ne (list-length mant + list-length to-nan + list-length clamp + list-length skip-zero + list-length zero)
   in EmitResult {
   state = st-append-code (sc.state) (
    movq-to-xmm 0 l-reg
    & movq-to-xmm 1 r-reg
    & [real-sse-prefix f32, 15, sse-op, modrm 3 0 1]
    & movq-from-xmm (rd.reg) 0
    & mov-rr (sc.reg) (rd.reg)
    & shl-ri (sc.reg) (real-exp-shl f32)
    & shr-ri (sc.reg) (real-exp-shr f32)
    & cmp-ri (sc.reg) (real-exp-ones f32)
    & to-done
    & mant
    & to-nan
    & clamp
    & skip-zero
    & zero
   ),
   reg = rd.reg
  }

  emit-fp-comparison : CodegenState, Integer, Integer, Integer, List Integer -> EmitResult
  emit-fp-comparison (st) (cc) (l-reg) (r-reg) (cmp-insn) =
   let rd = alloc-temp st
   in EmitResult {
   state = st-append-code (rd.state) (
    movq-to-xmm 0 l-reg
    & movq-to-xmm 1 r-reg
    & cmp-insn
    & setcc cc (rd.reg)
    & movzx-byte-self (rd.reg)
   ),
   reg = rd.reg
  }

  emit-num-comparison : CodegenState, Integer, Integer, Integer -> EmitResult
  emit-num-comparison (st) (cc) (l-reg) (r-reg) =
   emit-fp-comparison st cc l-reg r-reg (ucomisd-xmm 0 1)

 A float compare is not an integer compare, and the condition codes are not
 the integer ones. `ucomisd` and `ucomiss` report their result in CF and ZF
 exactly as an UNSIGNED compare does, so the Real path takes above/below and
 never less/greater. Taking less/greater is what the four ordering operators
 did for the life of the backend: they were emitted as a SIGNED integer
 compare of the two IEEE-754 bit patterns, which is right for two
 non-negatives and right for mixed signs, because a double's sign bit lands
 where the integer sign bit lands, and reversed for two negatives.

 `<` and `<=` are emitted as the REVERSED `>` and `>=` rather than as below
 and below-or-equal. Both orderings answer the same for ordered operands; they
 differ on NaN, which sets CF and ZF together, so below would answer True. The
 reversed form answers False for all four, which is what IEEE-754 requires of
 every ordered comparison against NaN.

  emit-fp-ord : CodegenState, IRBinaryOp, Integer, Integer, List Integer -> EmitResult
  emit-fp-ord (st) (op) (l-reg) (r-reg) (cmp-insn) =
   when op
    is IrGt -> emit-fp-comparison st cc-a l-reg r-reg cmp-insn
    is IrGtEq -> emit-fp-comparison st cc-ae l-reg r-reg cmp-insn
    is IrLt -> emit-fp-comparison st cc-a r-reg l-reg cmp-insn
    is otherwise -> emit-fp-comparison st cc-ae r-reg l-reg cmp-insn

 A Text or character operand is REFUSED here rather than emitted, and the
 checker refusing it first is what makes this a guard rather than the fix.
 On Text the two registers hold ADDRESSES, so `cmp` answers in allocation
 order: two separately built copies of "a" compared unequal, and one of them
 was less than the other. That is wrong on every input, with no fault and no
 other diagnostic, which is the same shape as the integer comparator on
 Reals that CDX9010 exists to stop.

 The reason to keep a guard behind a checker refusal at all is CDX9010's own
 history: the refusal covers the operator the author wrote, and the guard
 covers a future dispatch path that reaches the comparator some other way.
 That is exactly how `unit Real` was caught after the checker had been
 taught about Real.

  emit-ord-comparison : CodegenState, IRBinaryOp, Integer, Integer, CodexType -> EmitResult
  emit-ord-comparison (st) (op) (l-reg) (r-reg) (operand-ty) =
   let resolved = strip-unit-ty (resolve-to-sum-with-defs st operand-ty)
   in if is-real-type resolved
    then emit-fp-ord st op l-reg r-reg (if is-real-f32 resolved then ucomiss-xmm 0 1 else ucomisd-xmm 0 1)
   else when resolved
    is TextTy | CharTy ->
     let st0 = st-add-error st cdx-order-compare-on-text "The ordering comparator was handed a Text or character operand. On Text a machine cmp compares ADDRESSES, so the answer follows allocation order rather than content; the build halts rather than emit it. Use text-collate for alphabetical order, text-compare for code-point order, or compare char-code c as an Integer." synthetic-span
     in emit-comparison st0 (comparison-op-cc op) l-reg r-reg operand-ty
    is otherwise -> emit-comparison st (comparison-op-cc op) l-reg r-reg operand-ty

  emit-int-lit : CodegenState, Integer -> EmitResult
  emit-int-lit (st) (value) =
   let tmp = alloc-temp st
   in EmitResult {
   state = st-append-code (tmp.state) (li (tmp.reg) value),
   reg = tmp.reg
  }

  emit-to-local : CodegenState, IRExpr, Integer, Boolean -> CodegenState
  emit-to-local (st0) (expr) (target) (in-tail) =
   let st = fs-remove (fc-evict-slot (fc-evict-reg st0 target) target) target
   in when expr
    is IrIntLit (v) (sp) | IrNumLit (v) (sp) | IrCharLit (v) (sp) ->
     if target < spill-base then let st1 = st-append-code st (li target v)
     in __record-set st1 "next-temp" (st1.next-temp + 1)
     else let t = emit-int-lit st v in store-local (t.state) target (t.reg)
    is IrBoolLit (v) (sp) ->
     let iv = if v then 1 else 0
     in if target < spill-base then let st1 = st-append-code st (li target iv)
     in __record-set st1 "next-temp" (st1.next-temp + 1)
     else let t = emit-int-lit st iv in store-local (t.state) target (t.reg)
    is IrIf (cond) (then-e) (else-e) (ty) (sp) ->
     emit-if-to-local st cond then-e else-e target in-tail
    is IrBinary (op) (left) (right) (ty) (sp) ->
     if target < spill-base then
      when right
       is IrIntLit (v) (s) ->
        if v >= (0 - 2147483648) & v <= 2147483647 then
         when op
          is IrAddInt ->
           let l = emit-expr (st-set-tail-pos st False) left
           in let st1 = st-append-code (l.state) (lea target (l.reg) v)
           in __record-set st1 "next-temp" (st1.next-temp + 1)
          is IrSubInt ->
           let l = emit-expr (st-set-tail-pos st False) left
           in let st1 = st-append-code (l.state) (lea target (l.reg) (0 - v))
           in __record-set st1 "next-temp" (st1.next-temp + 1)
          is otherwise ->
           let r = emit-expr (st-set-tail-pos st in-tail) expr
           in store-local (r.state) target (r.reg)
        else let r = emit-expr (st-set-tail-pos st in-tail) expr
        in store-local (r.state) target (r.reg)
       is otherwise ->
        let r = emit-expr (st-set-tail-pos st in-tail) expr
        in store-local (r.state) target (r.reg)
     else let r = emit-expr (st-set-tail-pos st in-tail) expr
     in store-local (r.state) target (r.reg)
    is otherwise ->
     let r = emit-expr (st-set-tail-pos st in-tail) expr
     in store-local (r.state) target (r.reg)

  last-was-jmp : CodegenState -> Boolean
  last-was-jmp (st) =
   if st.code-len < 5 then False
   else st.last-jmp-end == st.code-len

  tail-is-join : IRExpr -> Boolean
  tail-is-join (e) =
   when e
    is IrLet (n) (lty) (v) (body) (sp) -> tail-is-join body
    is IrApply (f) (a) (ty) (sp) -> False
    is IrName (nm) (ty) (sp) -> False
    is IrIntLit (iv) (sp) -> False
    is IrNumLit (nv) (sp) -> False
    is IrTextLit (tv) (sp) -> False
    is IrBoolLit (bv) (sp) -> False
    is IrCharLit (cv) (sp) -> False
    is IrBinary (op) (l) (r) (ty) (sp) -> False
    is IrNegate (o) (ty) (sp) -> False
    is IrFieldAccess (r) (f) (ty) (sp) -> False
    is IrRecord (rn) (fs) (ty) (sp) -> False
    is IrList (es) (ty) (sp) -> False
    is IrLambda (ps) (b) (ty) (sp) -> False
    is IrFieldStore (r) (f) (sv) (ty) (sp) -> False
    is IrError (m) (ty) (sp) -> False
    is otherwise -> True

  emit-jmp-end : CodegenState -> CodegenState
  emit-jmp-end (st) =
   if last-was-jmp st then st
   else st-append-code st (jmp 0)

  emit-if-to-local : CodegenState, IRExpr, IRExpr, IRExpr, Integer, Boolean -> CodegenState
  emit-if-to-local (st) (cond) (then-e) (else-e) (target) (in-tail) =
   when cond
    is IrBinary (op) (left) (right) (ty) (sp) ->
     if is-fusable-int-comparison st op left then
      when right
       is IrIntLit (v) (s) ->
        if v >= (0 - 2147483648) & v <= 2147483647
        then if v == 0 & is-rem-pow2-pattern st left then emit-if-to-local-test-mask st op left then-e else-e target in-tail
        else let saved-tail = st.tco.in-tail-pos
        in let l = emit-expr (st-set-tail-pos st False) left
        in let inv-cc = invert-cc (comparison-op-cc op)
        in let st3 = st-append-code (l.state) (cmp-ri-or-test (l.reg) v)
        in let jcc-false-pos = st3.code-len
        in let st4 = st-append-code st3 (jcc inv-cc 0)
        in let st5 = emit-to-local st4 then-e target in-tail
        in if last-was-jmp st5 & (tail-is-join then-e == False) then
         let st6 = patch-jcc-at st5 jcc-false-pos (st5.code-len)
         in emit-to-local st6 else-e target in-tail
        else let jmp-end-pos = st5.code-len
        in let st6 = st-append-code st5 (jmp 0)
        in let st7 = patch-jcc-at st6 jcc-false-pos (st6.code-len)
        in let st8 = emit-to-local st7 else-e target in-tail
        in patch-jmp-at st8 jmp-end-pos (st8.code-len)
        else emit-if-to-local-fused-rr st op left right then-e else-e target in-tail
       is otherwise -> emit-if-to-local-fused-rr st op left right then-e else-e target in-tail
     else emit-if-to-local-generic st cond then-e else-e target in-tail
    is otherwise -> emit-if-to-local-generic st cond then-e else-e target in-tail

  is-rem-pow2-pattern : CodegenState, IRExpr -> Boolean
  is-rem-pow2-pattern (st) (expr) =
   when expr
    is IrBinary (op) (base) (divisor) (ty) (sp) ->
     when op
      is IrRemInt ->
       when divisor
        is IrIntLit (dv) (ds) -> dv > 0 & bit-and dv (dv - 1) == 0 & if-to-local-left-reg st base >= 0
        is otherwise -> False
      is otherwise -> False
    is otherwise -> False

  emit-if-to-local-test-mask : CodegenState, IRBinaryOp, IRExpr, IRExpr, IRExpr, Integer, Boolean -> CodegenState
  emit-if-to-local-test-mask (st) (op) (rem-expr) (then-e) (else-e) (target) (in-tail) =
   when rem-expr
    is IrBinary (rem-op) (base) (divisor) (ty) (sp) ->
     when divisor
      is IrIntLit (dv) (ds) ->
       let base-reg = if-to-local-left-reg st base
       in let mask = dv - 1
       in let inv-cc = invert-cc (comparison-op-cc op)
       in let st3 = st-append-code st (test-ri base-reg mask)
       in let jcc-false-pos = st3.code-len
       in let st4 = st-append-code st3 (jcc inv-cc 0)
       in let st5 = emit-to-local st4 then-e target in-tail
       in if last-was-jmp st5 & (tail-is-join then-e == False) then
        let st6 = patch-jcc-at st5 jcc-false-pos (st5.code-len)
        in emit-to-local st6 else-e target in-tail
       else let jmp-end-pos = st5.code-len
       in let st6 = st-append-code st5 (jmp 0)
       in let st7 = patch-jcc-at st6 jcc-false-pos (st6.code-len)
       in let st8 = emit-to-local st7 else-e target in-tail
       in patch-jmp-at st8 jmp-end-pos (st8.code-len)
      is otherwise -> emit-if-to-local-generic st (IrBinary op rem-expr (IrIntLit 0 (ir-expr-span rem-expr)) (ir-expr-type rem-expr) (ir-expr-span rem-expr)) then-e else-e target in-tail
    is otherwise -> emit-if-to-local-generic st (IrBinary op rem-expr (IrIntLit 0 (ir-expr-span rem-expr)) (ir-expr-type rem-expr) (ir-expr-span rem-expr)) then-e else-e target in-tail

  if-to-local-left-reg : CodegenState, IRExpr -> Integer
  if-to-local-left-reg (st) (left) =
   when left
    is IrName (n) (ty) (sp) ->
     let slot = lookup-local (st.locals) n
     in if slot >= 0 & slot < spill-base then slot else 0 - 1
    is otherwise -> 0 - 1

  emit-if-to-local-fused-rr : CodegenState, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr, Integer, Boolean -> CodegenState
  emit-if-to-local-fused-rr (st) (op) (cmp-left) (cmp-right) (then-e) (else-e) (target) (in-tail) =
   let l-reg = if-to-local-left-reg st cmp-left
   in let r-reg = if-to-local-left-reg st cmp-right
   in if l-reg >= 0 & r-reg >= 0 then
    let inv-cc = invert-cc (comparison-op-cc op)
    in let st3 = st-append-code st (cmp-rr l-reg r-reg)
    in let jcc-false-pos = st3.code-len
    in let st4 = st-append-code st3 (jcc inv-cc 0)
    in let st5 = emit-to-local st4 then-e target in-tail
    in if last-was-jmp st5 & (tail-is-join then-e == False) then
     let st6 = patch-jcc-at st5 jcc-false-pos (st5.code-len)
     in emit-to-local st6 else-e target in-tail
    else let jmp-end-pos = st5.code-len
    in let st6 = st-append-code st5 (jmp 0)
    in let st7 = patch-jcc-at st6 jcc-false-pos (st6.code-len)
    in let st8 = emit-to-local st7 else-e target in-tail
    in patch-jmp-at st8 jmp-end-pos (st8.code-len)
   else emit-if-to-local-generic st (IrBinary op cmp-left cmp-right (ir-expr-type cmp-left) (ir-expr-span cmp-left)) then-e else-e target in-tail

  emit-if-to-local-generic : CodegenState, IRExpr, IRExpr, IRExpr, Integer, Boolean -> CodegenState
  emit-if-to-local-generic (st) (cond) (then-e) (else-e) (target) (in-tail) =
   let cond-result = emit-expr (st-set-tail-pos st False) cond
   in let st1 = st-append-code (cond-result.state) (test-rr (cond-result.reg) (cond-result.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = emit-to-local st2 then-e target in-tail
   in if last-was-jmp st3 & (tail-is-join then-e == False) then
    let st4 = patch-jcc-at st3 je-false-pos (st3.code-len)
    in emit-to-local st4 else-e target in-tail
   else let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let st6 = emit-to-local st5 else-e target in-tail
   in patch-jmp-at st6 jmp-end-pos (st6.code-len)

  find-ctor-tag : List SumCtor, Text, Integer -> Integer
  find-ctor-tag (ctors) (name) (i) =
   if i == list-length ctors then -1
   else let c = list-at ctors i
   in if c.name.value == name then i
      else find-ctor-tag ctors name (i + 1)

  emit-name : CodegenState, Text, CodexType -> EmitResult
  emit-name (st) (name) (ty) =
   let slot = lookup-local (st.locals) name
   in if slot >= 0 then load-local (fs-remove st slot) slot
      else if is-builtin (st.builtin-names) name then emit-name-nonlocal st name ty
      else if lookup-x86-arity (st.user-arities) name >= 0 then emit-name-nonlocal st name ty
      else let eoa = find-effect-op-addr (st.effect-op-addrs) name 0 (list-length (st.effect-op-addrs))
      in if eoa >= 0 then emit-load-from-handler-table (eo-note-read st name) eoa
         else emit-name-nonlocal st name ty

  find-effect-op-addr : List EffectOpAddr, Text, Integer, Integer -> Integer
  find-effect-op-addr (addrs) (name) (i) (len) =
   if i >= len then 0 - 1
   else let a = list-at addrs i
   in if a.name == name then a.addr
      else find-effect-op-addr addrs name (i + 1) len

  emit-load-from-handler-table : CodegenState, Integer -> EmitResult
  emit-load-from-handler-table (st0) (addr) =
   let st = fc-evict-reg (fc-evict-reg st0 reg-rax) reg-r11
   in let st1 = st-append-code st (li reg-r11 addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-r11 0)
   in EmitResult { state = st2, reg = reg-rax }

  emit-name-nonlocal : CodegenState, Text, CodexType -> EmitResult
  emit-name-nonlocal (st) (name) (ty) =
   if name == "__heap-save" then emit-heap-save-builtin st
   else if name == "__self-type-defs" then emit-self-type-defs-builtin st
   else if name == "__deck-pos" then emit-deck-pos-builtin st
   else if name == "__deck-enter" then emit-deck-enter-builtin st
   else if name == "__deck-exit" then emit-deck-exit-builtin st
   else if name == "get-state" then emit-get-state-builtin st
   else let resolved = resolve-to-sum-with-defs st ty
   in when resolved
    is SumTy (sname) (args) (ctors) ->
     let tag = find-ctor-tag ctors name 0
     in if tag >= 0 then emit-nullary-ctor st tag
        else emit-name-as-call st name
    is FunTy (pt) (row) (rt) -> emit-partial-application st name [] (1 + fun-type-arity rt)
    is otherwise -> if has-nullary-x86-builtin-emitter st name then emit-builtin st name []
                    else emit-name-as-call st name

  resolve-to-sum : CodexType -> CodexType
  resolve-to-sum (ty) =
   when ty
    is SumTy (sn) (args) (cs) -> ty
    is EffectfulTy (effs) (sc) (ret) -> resolve-to-sum ret
    is otherwise -> ty

  resolve-to-sum-with-defs : CodegenState, CodexType -> CodexType
  resolve-to-sum-with-defs (st) (ty) =
   let resolved = resolve-constructed-ty st ty
   in when resolved
    is SumTy (sn) (args) (cs) -> resolved
    is EffectfulTy (effs) (sc) (ret) -> resolve-to-sum-with-defs st ret
    is otherwise -> resolved

  emit-nullary-ctor : CodegenState, Integer -> EmitResult
  emit-nullary-ctor (st) (tag) =
   let alloc = emit-bivy-alloc st 8
   in let tag-tmp = alloc-temp (alloc.state)
   in let st4 = st-append-code (tag-tmp.state) (li (tag-tmp.reg) tag)
   in let ptr-load = load-local st4 (alloc.ptr-loc)
   in let st5 = st-append-code (ptr-load.state) (mov-store (ptr-load.reg) (tag-tmp.reg) 0)
   in load-local st5 (alloc.ptr-loc)

  emit-name-as-call : CodegenState, Text -> EmitResult
  emit-name-as-call (st) (name) =
   if name == "read-line" then emit-read-line-builtin st
   else if name == "read-line-cce" then emit-read-line-cce-builtin st
   else let st1 = emit-call-to st name
   in let tmp = alloc-temp st1
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  value-is-fresh-alloc : IRExpr -> Boolean
  value-is-fresh-alloc (e) =
   when e
    is IrRecord (n) (fs) (t) (s) -> True
    is IrList (es) (t) (s) -> True
    is otherwise -> False

 The range environment is saved and restored exactly like the locals
 beside it, and for the same reason: the binding is in scope for the body
 and for nothing after it. The value's range is proved in the OUTER
 environment (`saved-range`), because that is where the value is
 evaluated -- binding first and then proving would let a shadowing let see
 itself. This is what carries a bound from where it is proved to where it
 is used, so a narrow-store or a return guard inside the body can elide a
 check the checker had already discharged.

  emit-let : CodegenState, Text, IRExpr, IRExpr -> EmitResult
  emit-let (st) (name) (value) (body) =
   let saved-tail = st.tco.in-tail-pos
   in let saved-locals = st.locals
   in let saved-range = st.range-env
   in let loc = alloc-local st
   in let keep = (loc.state).next-local
   in let st1 = emit-to-local (loc.state) value (loc.reg) False
   in let st1r = __record-set st1 "next-local" keep
   in let st2 = add-local st1r name (loc.reg)
   in let st3 = if value-is-fresh-alloc value then fs-add st2 (loc.reg) else st2
   in let st3r = __record-set st3 "range-env" (range-env-bind saved-range name (ir-expr-proven-range saved-range value))
   in let r = emit-expr (st-set-tail-pos st3r saved-tail) body
   in EmitResult {
    state = __record-set (restore-locals (r.state) saved-locals) "range-env" saved-range,
    reg = r.reg
   }

  is-append-list-op : IRBinaryOp -> Boolean
  is-append-list-op (op) =
   when op
    is IrAppendList -> True
    is otherwise -> False

  flatten-append-chain : IRExpr, List IRExpr -> List IRExpr
  flatten-append-chain (e) (acc) =
   when e
    is IrBinary (op) (l) (r) (ty) (sp) ->
     if is-append-list-op op then flatten-append-chain l (flatten-append-chain r acc)
     else [e] & acc
    is otherwise -> [e] & acc

  emit-concat-many-eval : CodegenState, List IRExpr, Integer, Integer, List Integer -> ConcatManyEval
  emit-concat-many-eval (st) (exprs) (i) (n) (locals) =
   if i >= n then ConcatManyEval { state = st, locals = locals }
   else let r = emit-expr (st-set-tail-pos st False) (list-at exprs i)
   in let loc = alloc-local (r.state)
   in let st1 = store-local (loc.state) (loc.reg) (r.reg)
   in emit-concat-many-eval st1 exprs (i + 1) n (list-push locals (loc.reg))

  ConcatManyEval = record {
   state : CodegenState,
   locals : List Integer
  }

  emit-concat-many-store-ptrs : CodegenState, List Integer, Integer, Integer, Integer -> CodegenState
  emit-concat-many-store-ptrs (st) (locals) (i) (n) (arr-reg) =
   if i >= n then st
   else let loaded = load-local st (list-at locals i)
   in let st1 = st-append-code (loaded.state) (mov-store arr-reg (loaded.reg) (i * 8))
   in emit-concat-many-store-ptrs st1 locals (i + 1) n arr-reg

  emit-concat-many : CodegenState, List IRExpr -> EmitResult
  emit-concat-many (st) (exprs) =
   let n = list-length exprs
   in let eval = emit-concat-many-eval st exprs 0 n []
   in let st1 = eval.state
   in let arr = alloc-temp st1
   in let st2 = st-append-code (arr.state) (mov-rr (arr.reg) reg-r10)
   in let st3 = heap-bump-imm st2 (n * 8)
   in let st4 = emit-concat-many-store-ptrs st3 (eval.locals) 0 n (arr.reg)
   in let st5 = st-append-code st4 (mov-rr reg-rdi (arr.reg))
   in let st6 = st-append-code st5 (li reg-rsi n)
   in let st7 = emit-call-to st6 "__list_concat_many"
   in let rd = alloc-temp st7
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  is-and-op : IRBinaryOp -> Boolean
  is-and-op (op) =
   when op
    is IrAnd -> True
    is otherwise -> False

  is-or-op : IRBinaryOp -> Boolean
  is-or-op (op) =
   when op
    is IrOr -> True
    is otherwise -> False

  emit-short-circuit-and : CodegenState, IRExpr, IRExpr -> EmitResult
  emit-short-circuit-and (st) (left) (right) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let st1 = st-append-code (l.state) (test-rr (l.reg) (l.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let r = emit-expr st2 right
   in let result-loc = alloc-local (r.state)
   in let st3 = store-local (result-loc.state) (result-loc.reg) (r.reg)
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let st6 = if result-loc.reg < spill-base then st-append-code st5 (li (result-loc.reg) 0)
   else let false-lit = emit-int-lit st5 0 in store-local (false-lit.state) (result-loc.reg) (false-lit.reg)
   in let st7 = patch-jmp-at st6 jmp-end-pos (st6.code-len)
   in load-local st7 (result-loc.reg)

  emit-short-circuit-or : CodegenState, IRExpr, IRExpr -> EmitResult
  emit-short-circuit-or (st) (left) (right) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let st1 = st-append-code (l.state) (test-rr (l.reg) (l.reg))
   in let jne-true-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let r = emit-expr st2 right
   in let result-loc = alloc-local (r.state)
   in let st3 = store-local (result-loc.state) (result-loc.reg) (r.reg)
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 jne-true-pos (st4.code-len)
   in let st6 = if result-loc.reg < spill-base then st-append-code st5 (li (result-loc.reg) 1)
   else let true-lit = emit-int-lit st5 1 in store-local (true-lit.state) (result-loc.reg) (true-lit.reg)
   in let st7 = patch-jmp-at st6 jmp-end-pos (st6.code-len)
   in load-local st7 (result-loc.reg)

  is-inplace-append : CodegenState, IRBinaryOp, IRExpr -> Boolean
  is-inplace-append (st) (op) (left) =
   when op
    is IrAppendText ->
     (when left
      is IrName (n) (ty) (sp) -> st.tco.active & st.omit-frame-pointer == False & ip-name-listed (st.tco.inplace-params) n 0
      is otherwise -> False)
    is otherwise -> False

  ip-name-listed : List Text, Text, Integer -> Boolean
  ip-name-listed (names) (n) (i) =
   if i >= list-length names then False
   else if list-at names i == n then True
   else ip-name-listed names n (i + 1)

  emit-inplace-append : CodegenState, IRExpr, IRExpr -> EmitResult
  emit-inplace-append (st) (left) (right) =
   let r = emit-expr (st-set-tail-pos st False) right
   in let st1 = st-append-code (r.state) (mov-rr reg-r9 (r.reg))
   in let st2 = emit-operand-to st1 left reg-r8
   in emit-helper-call-2-regs st2 reg-r8 reg-r9 "__str_concat_inplace"

  emit-binary : CodegenState, IRBinaryOp, IRExpr, IRExpr -> EmitResult
  emit-binary (st) (op) (left) (right) =
   if is-inplace-append st op left then emit-inplace-append st left right
   else if is-append-list-op op then emit-append-list st left right
   else if is-and-op op then emit-short-circuit-and st left right
   else if is-or-op op then emit-short-circuit-or st left right
   else when right
    is IrIntLit (v) (s) ->
     if v >= (0 - 2147483648) & v <= 2147483647 then
      when op
       is IrAddInt -> emit-binary-add-imm st left v
       is IrSubInt -> emit-binary-sub-imm st left v
       is IrMulInt -> emit-binary-mul-imm st left v
       is IrDivInt -> if v > 0 & bit-and v (v - 1) == 0 & pow2-dividend-nonneg (st.range-env) left then emit-binary-div-pow2 st left v
        else emit-binary-or-standard st op left right
       is IrRemInt -> if v > 0 & bit-and v (v - 1) == 0 & pow2-dividend-nonneg (st.range-env) left then emit-binary-rem-pow2 st left v
        else emit-binary-or-standard st op left right
       is otherwise -> if is-fusable-int-comparison st op left then emit-binary-cmp-imm st op left v
        else emit-binary-or-standard st op left right
     else emit-binary-or-standard st op left right
    is IrName (n) (ty) (sp) ->
     let slot = lookup-local (st.locals) n
     in if slot >= 0 & slot < spill-base then
      when left
       is IrIntLit (lv) (ls) ->
        if lv >= (0 - 2147483648) & lv <= 2147483647 then
         when op
          is IrMulInt -> emit-binary-mul-imm st right lv
          is IrAddInt -> emit-binary-add-imm st right lv
          is otherwise -> emit-binary-reg-right st op left slot right
        else emit-binary-reg-right st op left slot right
       is otherwise -> emit-binary-reg-right st op left slot right
     else emit-binary-or-standard st op left right
    is otherwise ->
     when left
      is IrName (ln) (lty) (lsp) ->
       let lslot = lookup-local (st.locals) ln
       in if lslot >= 0 & lslot < spill-base then emit-binary-reg-left st op left lslot lty right
       else emit-binary-or-standard st op left right
      is otherwise -> emit-binary-or-standard st op left right

 Staged binary emission. The standard path parks both operands in
 alloc-locals, which are anonymous and never released: each binary
 node permanently consumes local slots, and past four slots every
 later binding in the function cascades to stack spills. The staged
 path stages the operands through R8 and R9 instead -- the two
 registers the allocator never assigns -- and parks at most one
 value, transiently, on the machine stack. A simple operand (a
 literal, or a name bound to a local) is materialized directly into
 its staging register after the complex sibling has been evaluated;
 materialization is a single li or mov that cannot trap or observe
 anything, so the reorder is semantically invisible. When both
 operands are complex the left result is pushed, the right is
 evaluated, captured into R9 before the pop so a right result that
 happens to sit in R8 (a load-local scratch return) is not clobbered,
 and the left popped into R8. The (R8, R9) pair then feeds
 emit-binary-op, which is the same consumer the standard path hands
 its load-local scratch registers to: every op sequence consumes its
 operand registers in its first instructions, and the helper-call ops
 move to RDI/RSI before calling, so nothing requires R8/R9 to survive
 a call. The staged path allocates no locals -- next-local,
 spill-count, and the frame are untouched by binary expressions.
 With omit-frame-pointer the transient push would shift the
 RSP-relative spill offsets read inside the right operand's emission,
 so that mode keeps the standard path.

  emit-binary-or-standard : CodegenState, IRBinaryOp, IRExpr, IRExpr -> EmitResult
  emit-binary-or-standard (st) (op) (left) (right) =
   if st.omit-frame-pointer then emit-binary-standard st op left right
   else emit-binary-staged st op left right

  is-staged-operand : CodegenState, IRExpr -> Boolean
  is-staged-operand (st) (e) =
   when e
    is IrIntLit (v) (sp) | IrBoolLit (v) (sp) | IrCharLit (v) (sp) -> True
    is IrName (n) (ty) (sp) -> lookup-local (st.locals) n >= 0
    is otherwise -> False

  emit-operand-to : CodegenState, IRExpr, Integer -> CodegenState
  emit-operand-to (st) (e) (scratch) =
   when e
    is IrIntLit (v) (sp) -> st-append-code st (li scratch v)
    is IrBoolLit (v) (sp) -> st-append-code st (li scratch (if v then 1 else 0))
    is IrCharLit (v) (sp) -> st-append-code st (li scratch v)
    is IrName (n) (ty) (sp) ->
     let slot = lookup-local (st.locals) n
     in if slot < spill-base then st-append-code st (mov-rr scratch slot)
     else st-append-code st (mov-load scratch reg-rbp (-((slot - spill-base + 1) * 8 + 32)))
    is otherwise -> st

  emit-binary-staged : CodegenState, IRBinaryOp, IRExpr, IRExpr -> EmitResult
  emit-binary-staged (st) (op) (left) (right) =
   let operand-ty = ir-expr-type left
   in if is-staged-operand st left then
       if is-staged-operand st right then
        let st1 = emit-operand-to st left reg-r8
        in let st2 = emit-operand-to st1 right reg-r9
        in emit-binary-op st2 op reg-r8 reg-r9 operand-ty
       else
        let r = emit-expr (st-set-tail-pos st False) right
        in let st1 = st-append-code (r.state) (mov-rr reg-r9 (r.reg))
        in let st2 = emit-operand-to st1 left reg-r8
        in emit-binary-op st2 op reg-r8 reg-r9 operand-ty
      else if is-staged-operand st right then
       let l = emit-expr (st-set-tail-pos st False) left
       in let st1 = st-append-code (l.state) (mov-rr reg-r8 (l.reg))
       in let st2 = emit-operand-to st1 right reg-r9
       in emit-binary-op st2 op reg-r8 reg-r9 operand-ty
      else
       let l = emit-expr (st-set-tail-pos st False) left
       in let st1 = st-append-code (l.state) (push-r (l.reg))
       in let r = emit-expr st1 right
       in when op
        is IrAddInt ->
         let pop-reg = if r.reg == reg-r8 then reg-r9 else reg-r8
         in let st2 = st-append-code (fc-evict-reg (r.state) (r.reg)) (pop-r pop-reg & add-rr (r.reg) pop-reg)
         in EmitResult { state = __record-set st2 "next-temp" (st2.next-temp + 1), reg = r.reg }
        is IrMulInt ->
         let pop-reg = if r.reg == reg-r8 then reg-r9 else reg-r8
         in let st2 = st-append-code (fc-evict-reg (r.state) (r.reg)) (pop-r pop-reg & imul-rr (r.reg) pop-reg)
         in EmitResult { state = __record-set st2 "next-temp" (st2.next-temp + 1), reg = r.reg }
        is otherwise ->
         let st2 = st-append-code (r.state) (mov-rr reg-r9 (r.reg))
         in let st3 = st-append-code st2 (pop-r reg-r8)
         in emit-binary-op st3 op reg-r8 reg-r9 operand-ty

  emit-binary-add-imm : CodegenState, IRExpr, Integer -> EmitResult
  emit-binary-add-imm (st) (left) (imm) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let rd = alloc-temp (l.state)
   in if rd.reg /= l.reg then EmitResult { state = st-append-code (rd.state) (lea (rd.reg) (l.reg) imm), reg = rd.reg }
   else EmitResult { state = st-append-code (rd.state) (add-ri (rd.reg) imm), reg = rd.reg }

  emit-binary-sub-imm : CodegenState, IRExpr, Integer -> EmitResult
  emit-binary-sub-imm (st) (left) (imm) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let rd = alloc-temp (l.state)
   in if rd.reg /= l.reg then EmitResult { state = st-append-code (rd.state) (lea (rd.reg) (l.reg) (0 - imm)), reg = rd.reg }
   else EmitResult { state = st-append-code (rd.state) (sub-ri (rd.reg) imm), reg = rd.reg }

  emit-binary-mul-imm : CodegenState, IRExpr, Integer -> EmitResult
  emit-binary-mul-imm (st) (left) (imm) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let rd = alloc-temp (l.state)
   in EmitResult { state = st-append-code (rd.state) (imul-rri (rd.reg) (l.reg) imm), reg = rd.reg }

  int-log2 : Integer -> Integer
  int-log2 (v) = if v <= 1 then 0 else 1 + int-log2 (bit-shru v 1)

  emit-binary-div-pow2 : CodegenState, IRExpr, Integer -> EmitResult
  emit-binary-div-pow2 (st) (left) (divisor) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let rd = alloc-temp (l.state)
   in let shift = int-log2 divisor
   in EmitResult { state = st-append-code (rd.state) (mov-rr (rd.reg) (l.reg) & sar-ri (rd.reg) shift), reg = rd.reg }

  emit-binary-rem-pow2 : CodegenState, IRExpr, Integer -> EmitResult
  emit-binary-rem-pow2 (st) (left) (divisor) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let rd = alloc-temp (l.state)
   in EmitResult { state = st-append-code (rd.state) (mov-rr (rd.reg) (l.reg) & and-ri (rd.reg) (divisor - 1)), reg = rd.reg }

  cmp-ri-or-test : Integer, Integer -> List Integer
  cmp-ri-or-test (rd) (imm) =
   if imm == 0 then test-rr rd rd else cmp-ri rd imm

  emit-binary-cmp-imm : CodegenState, IRBinaryOp, IRExpr, Integer -> EmitResult
  emit-binary-cmp-imm (st) (op) (left) (imm) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let cc = comparison-op-cc op
   in let rd = alloc-temp (l.state)
   in EmitResult { state = st-append-code (rd.state) (cmp-ri-or-test (l.reg) imm & setcc cc (rd.reg) & movzx-byte-self (rd.reg)), reg = rd.reg }

  is-safe-for-reg-right : CodegenState, IRBinaryOp, IRExpr -> Boolean
  is-safe-for-reg-right (st) (op) (left) =
   when op
    is IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrRemInt | IrAddNum | IrSubNum | IrMulNum | IrDivNum | IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox | IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping | IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating | IrAddVec | IrSubVec | IrMulVec | IrDivVec | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec | IrAppendText | IrConsList | IrLt | IrGt | IrLtEq | IrGtEq | IrApproxEq | IrApproxEqExact -> True
    is IrEq | IrNotEq -> is-fusable-int-comparison st op left
    is otherwise -> False

 The mirror of the reg-left fold. Here the complex operand is on the
 left, so its result lands in the destination and the op need not be
 commutative: add/sub/mul of left with the register-local right become
 OP l.reg, right-reg, with left in the dest. The guard is stricter than
 reg-left because left may be an IrName bound to a local (a - b with
 both local), in which case l.reg is a live callee-saved register the
 standard path must not clobber -- is-temp-reg restricts the fold to
 the dead-temp case, where l.reg holds a complex result.

  emit-reg-right-inplace : CodegenState, IRBinaryOp, Integer, Integer -> EmitResult
  emit-reg-right-inplace (st) (op) (l-reg) (right-reg) =
   let st2 = st-append-code (fc-evict-reg st l-reg) (inplace-int-op op l-reg right-reg)
   in EmitResult { state = __record-set st2 "next-temp" (st2.next-temp + 1), reg = __narrow l-reg }

  emit-binary-reg-right : CodegenState, IRBinaryOp, IRExpr, Integer, IRExpr -> EmitResult
  emit-binary-reg-right (st) (op) (left) (right-reg) (right) =
   if is-safe-for-reg-right st op left then
    let l = emit-expr (st-set-tail-pos st False) left
    in if is-reg-right-inplace-op op & is-temp-reg (l.reg)
       then emit-reg-right-inplace (l.state) op (l.reg) right-reg
       else emit-binary-op (l.state) op (l.reg) right-reg (ir-expr-type left)
   else emit-binary-or-standard st op left right

  is-safe-for-reg-left : CodegenState, IRBinaryOp, IRExpr -> Boolean
  is-safe-for-reg-left (st) (op) (right) =
   when op
    is IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrRemInt | IrAddNum | IrSubNum | IrMulNum | IrDivNum | IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox | IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping | IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating | IrAddVec | IrSubVec | IrMulVec | IrDivVec | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec | IrLt | IrGt | IrLtEq | IrGtEq -> True
    is IrEq | IrNotEq -> is-fusable-int-comparison st op right
    is otherwise -> False

  is-commutative-int-op : IRBinaryOp -> Boolean
  is-commutative-int-op (op) =
   when op
    is IrAddInt | IrMulInt -> True
    is otherwise -> False

  is-reg-right-inplace-op : IRBinaryOp -> Boolean
  is-reg-right-inplace-op (op) =
   when op
    is IrAddInt | IrSubInt | IrMulInt -> True
    is otherwise -> False

  is-temp-reg : Integer -> Boolean
  is-temp-reg (r) =
   when r
    is 0 | 1 | 2 | 6 | 7 | 11 -> True
    is otherwise -> False

  inplace-int-op : IRBinaryOp, Integer, Integer -> List Integer
  inplace-int-op (op) (dest) (src) =
   when op
    is IrMulInt -> imul-rr dest src
    is IrSubInt -> sub-rr dest src
    is otherwise -> add-rr dest src

 On the reg-left path the right operand is always complex (a literal
 or register-local right is handled earlier in emit-binary), so its
 result rides in a dead temp register, while left-reg is a
 callee-saved local the op only reads. For a commutative integer op
 the dead temp can be the destination directly: OP r.reg, left-reg
 computes right OP n, which equals n OP right, with the result already
 in r.reg. That drops the mov rd, l-reg the standard emit-binary-op
 prepends -- and, when r.reg is the function's return register, the
 trailing move too (fact's n * fact(n-1): 3 insns to 1). The
 next-temp bump mirrors emit-binary-staged's in-place add/mul: the
 returned r.reg must be retained past the rotation. Non-commutative
 and non-integer ops keep the emit-binary-op path.

  emit-binary-reg-left : CodegenState, IRBinaryOp, IRExpr, Integer, CodexType, IRExpr -> EmitResult
  emit-binary-reg-left (st) (op) (left) (left-reg) (lty) (right) =
   if is-commutative-int-op op then
    let r = emit-expr (st-set-tail-pos st False) right
    in let st2 = st-append-code (fc-evict-reg (r.state) (r.reg)) (inplace-int-op op (r.reg) left-reg)
    in EmitResult { state = __record-set st2 "next-temp" (st2.next-temp + 1), reg = r.reg }
   else if is-safe-for-reg-left st op right then
    let r = emit-expr (st-set-tail-pos st False) right
    in emit-binary-op (r.state) op left-reg (r.reg) lty
   else emit-binary-or-standard st op left right

  emit-append-list : CodegenState, IRExpr, IRExpr -> EmitResult
  emit-append-list (st) (left) (right) =
   let chain = flatten-append-chain left [right]
   in emit-concat-many st chain

  emit-binary-standard : CodegenState, IRBinaryOp, IRExpr, IRExpr -> EmitResult
  emit-binary-standard (st) (op) (left) (right) =
   let l = emit-expr (st-set-tail-pos st False) left
   in let l-loc = alloc-local (l.state)
   in let st1 = store-local (l-loc.state) (l-loc.reg) (l.reg)
   in let r = emit-expr st1 right
   in when right
    is IrIntLit (v) (s) ->
     let l-load = load-local (r.state) (l-loc.reg)
     in when op
      is IrAddInt -> EmitResult { state = st-append-code (l-load.state) (add-rr (l-load.reg) (r.reg)), reg = l-load.reg }
      is IrSubInt -> EmitResult { state = st-append-code (l-load.state) (sub-rr (l-load.reg) (r.reg)), reg = l-load.reg }
      is IrMulInt -> EmitResult { state = st-append-code (l-load.state) (imul-rr (l-load.reg) (r.reg)), reg = l-load.reg }
      is otherwise ->
       let r-loc = alloc-local (r.state)
       in let st2 = store-local (r-loc.state) (r-loc.reg) (r.reg)
       in let l-load2 = load-local st2 (l-loc.reg)
       in let r-load = load-local (l-load2.state) (r-loc.reg)
       in let operand-ty = ir-expr-type left
       in emit-binary-op (r-load.state) op (l-load2.reg) (r-load.reg) operand-ty
    is otherwise ->
     let r-loc = alloc-local (r.state)
     in let st2 = store-local (r-loc.state) (r-loc.reg) (r.reg)
     in let l-load = load-local st2 (l-loc.reg)
     in let r-load = load-local (l-load.state) (r-loc.reg)
     in let operand-ty = ir-expr-type left
     in emit-binary-op (r-load.state) op (l-load.reg) (r-load.reg) operand-ty

 The destination temp must avoid r-reg: the register ops write rd
 before reading r-reg (mov rd, l-reg destroys a colliding right
 operand, and rd + rd doubles the left). Colliding with l-reg is
 harmless -- the mov becomes a self-move. A call result rides in
 a rotation register, so any caller whose right operand contains a
 call can collide; geometry-test's perimeter accumulator caught
 this when emit-binary-reg-left passed a register local as l-reg.

  is-int-vector : CodexType -> Boolean
  is-int-vector (ty) =
   when ty
    is VectorTy (n) (t) -> when t
     is IntegerTy (lo) (hi) (m) -> True
     is otherwise -> False
    is otherwise -> False

  is-f32-vector : CodexType -> Boolean
  is-f32-vector (ty) =
   when ty
    is VectorTy (n) (t) -> is-real-f32 t
    is otherwise -> False

  emit-vec-op : CodegenState, Integer, Integer, CodexType, List Integer, List Integer, List Integer -> EmitResult
  emit-vec-op (st) (l-reg) (r-reg) (operand-ty) (f64-insn) (int-insn) (f32-insn) =
   let insn = if is-f32-vector operand-ty then f32-insn else if is-int-vector operand-ty then int-insn else f64-insn
   in let st1 = st-append-code st (movupd-load 0 l-reg 0 & movupd-load 1 r-reg 0 & insn)
   in let alloc = emit-bivy-alloc st1 16
   in let p1 = load-local (alloc.state) (alloc.ptr-loc)
   in let st2 = st-append-code (p1.state) (movupd-store (p1.reg) 0 0)
   in let result = load-local st2 (alloc.ptr-loc)
   in EmitResult { state = result.state, reg = result.reg }

  emit-binary-op : CodegenState, IRBinaryOp, Integer, Integer, CodexType -> EmitResult
  emit-binary-op (st) (op) (l-reg) (r-reg) (operand-ty) =
   let rd = alloc-temp-avoiding st r-reg
   in when op
    is IrAddInt -> EmitResult {
     state = st-append-code (rd.state) (mov-rr (rd.reg) l-reg & add-rr (rd.reg) r-reg),
     reg = rd.reg
    }
    is IrSubInt -> EmitResult {
     state = st-append-code (rd.state) (mov-rr (rd.reg) l-reg & sub-rr (rd.reg) r-reg),
     reg = rd.reg
    }
    is IrMulInt -> EmitResult {
     state = st-append-code (rd.state) (mov-rr (rd.reg) l-reg & imul-rr (rd.reg) r-reg),
     reg = rd.reg
    }
    is IrDivInt -> let div-reg = if r-reg == reg-rdx then reg-r11
      else if r-reg == reg-rax then reg-r11 else r-reg
     in let save = if r-reg == reg-rdx then mov-rr reg-r11 reg-rdx
      else if r-reg == reg-rax then mov-rr reg-r11 reg-rax else []
     in let st-ev = fc-evict-reg (fc-evict-reg (fc-evict-reg (rd.state) reg-rax) reg-rdx) reg-r11
     in EmitResult {
     state = st-append-code st-ev (save & mov-rr reg-rax l-reg & cqo & idiv-r div-reg & mov-rr (rd.reg) reg-rax),
     reg = rd.reg
    }
    is IrRemInt -> let div-reg = if r-reg == reg-rdx then reg-r11
      else if r-reg == reg-rax then reg-r11 else r-reg
     in let save = if r-reg == reg-rdx then mov-rr reg-r11 reg-rdx
      else if r-reg == reg-rax then mov-rr reg-r11 reg-rax else []
     in let st-ev = fc-evict-reg (fc-evict-reg (fc-evict-reg (rd.state) reg-rax) reg-rdx) reg-r11
     in EmitResult {
     state = st-append-code st-ev (save & mov-rr reg-rax l-reg & cqo & idiv-r div-reg),
     reg = reg-rdx
    }
    is IrAddNum -> emit-num-arith st l-reg r-reg 88
    is IrSubNum -> emit-num-arith st l-reg r-reg 92
    is IrMulNum -> emit-num-arith st l-reg r-reg 89
    is IrDivNum -> emit-num-arith st l-reg r-reg 94
    is IrAddRealApprox -> emit-real-approx-arith st l-reg r-reg (addss-xmm 0 1)
    is IrSubRealApprox -> emit-real-approx-arith st l-reg r-reg (subss-xmm 0 1)
    is IrMulRealApprox -> emit-real-approx-arith st l-reg r-reg (mulss-xmm 0 1)
    is IrDivRealApprox -> emit-real-approx-arith st l-reg r-reg (divss-xmm 0 1)
    is IrAddRealTrapping -> emit-real-trapping-arith st l-reg r-reg 88 (real-arith-is-f32 st operand-ty)
    is IrSubRealTrapping -> emit-real-trapping-arith st l-reg r-reg 92 (real-arith-is-f32 st operand-ty)
    is IrMulRealTrapping -> emit-real-trapping-arith st l-reg r-reg 89 (real-arith-is-f32 st operand-ty)
    is IrDivRealTrapping -> emit-real-trapping-arith st l-reg r-reg 94 (real-arith-is-f32 st operand-ty)
    is IrAddRealSaturating -> emit-real-saturating-arith st l-reg r-reg 88 (real-arith-is-f32 st operand-ty)
    is IrSubRealSaturating -> emit-real-saturating-arith st l-reg r-reg 92 (real-arith-is-f32 st operand-ty)
    is IrMulRealSaturating -> emit-real-saturating-arith st l-reg r-reg 89 (real-arith-is-f32 st operand-ty)
    is IrDivRealSaturating -> emit-real-saturating-arith st l-reg r-reg 94 (real-arith-is-f32 st operand-ty)
    is IrAddVec -> emit-vec-op st l-reg r-reg operand-ty (addpd-xmm 0 1) (paddq-xmm 0 1) (addps-xmm 0 1)
    is IrSubVec -> emit-vec-op st l-reg r-reg operand-ty (subpd-xmm 0 1) (psubq-xmm 0 1) (subps-xmm 0 1)
    is IrMulVec -> emit-vec-op st l-reg r-reg operand-ty (mulpd-xmm 0 1) (mulpd-xmm 0 1) (mulps-xmm 0 1)
    is IrDivVec -> emit-vec-op st l-reg r-reg operand-ty (divpd-xmm 0 1) (divpd-xmm 0 1) (divps-xmm 0 1)
    is IrLtVec -> emit-vec-op st l-reg r-reg operand-ty (cmppd-xmm 0 1 1) (cmppd-xmm 0 1 1) (cmpps-xmm 0 1 1)
    is IrLtEqVec -> emit-vec-op st l-reg r-reg operand-ty (cmppd-xmm 0 1 2) (cmppd-xmm 0 1 2) (cmpps-xmm 0 1 2)
    is IrGtVec -> emit-vec-op st l-reg r-reg operand-ty (cmppd-xmm 0 1 6) (cmppd-xmm 0 1 6) (cmpps-xmm 0 1 6)
    is IrGtEqVec -> emit-vec-op st l-reg r-reg operand-ty (cmppd-xmm 0 1 5) (cmppd-xmm 0 1 5) (cmpps-xmm 0 1 5)
    is IrApproxEq -> emit-approx-eq st l-reg r-reg (real-arith-is-f32 st operand-ty)
    is IrApproxEqExact -> emit-approx-eq-exact st l-reg r-reg (real-arith-is-f32 st operand-ty)
    is IrEq -> emit-eq-op st l-reg r-reg operand-ty
    is IrNotEq -> emit-neq-op st l-reg r-reg operand-ty
    is IrLt | IrGt | IrLtEq | IrGtEq -> emit-ord-comparison st op l-reg r-reg operand-ty
    is IrAnd -> EmitResult {
     state = st-append-code (rd.state) (mov-rr (rd.reg) l-reg & and-rr (rd.reg) r-reg),
     reg = rd.reg
    }
    is IrOr -> EmitResult {
     state = st-append-code (rd.state) (mov-rr (rd.reg) l-reg & or-rr (rd.reg) r-reg),
     reg = rd.reg
    }
    is IrAppendText -> emit-helper-call-2-regs st l-reg r-reg "__str_concat"
    is IrAppendList -> emit-helper-call-2-regs st l-reg r-reg "__list_append"
    is IrConsList -> emit-helper-call-2-regs st l-reg r-reg "__list_cons"
    is IrPowInt -> emit-pow-op st l-reg r-reg operand-ty
    is otherwise -> EmitResult {
     state = st,
     reg = reg-rax
    }

 Integer exponentiation is that helper, square-and-multiply, base in RDI and
 exponent in RSI.

 A floating operand is REFUSED rather than emitted. There is no
 floating-point exponentiation routine in the runtime, and handing two
 IEEE-754 bit patterns to an integer square-and-multiply computes nothing at
 all -- the same shape as the integer comparator on Reals that `CDX9010`
 exists to stop, and the same shape as `unit Real` arithmetic reaching the
 integer adder. Silently degrading is what this project's virtues forbid, so
 the build halts and says what to do instead.

  emit-pow-op : CodegenState, Integer, Integer, CodexType -> EmitResult
  emit-pow-op (st) (l-reg) (r-reg) (operand-ty) =
   when strip-unit-ty (resolve-to-sum-with-defs st operand-ty)
    is RealTy (rw) (rm) ->
     EmitResult {
      state = st-add-error st cdx-pow-on-float "The exponentiation operator was given a floating-point operand, and the only exponentiation routine in the runtime is the integer one. Raising two IEEE-754 bit patterns by square-and-multiply computes nothing; the build halts rather than emit it. Multiply explicitly, or convert with real-to-int if an integer power is what was meant." synthetic-span,
      reg = __narrow l-reg
     }
    is otherwise -> emit-helper-call-2-regs st l-reg r-reg "__ipow"

  emit-helper-call-2-regs : CodegenState, Integer, Integer, Text -> EmitResult
  emit-helper-call-2-regs (st) (l-reg) (r-reg) (name) =
   let st1 = st-append-code st (mov-rr reg-rdi l-reg & mov-rr reg-rsi r-reg)
   in let st2 = emit-call-to st1 name
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  eq-empty-type-args : List CodexType
  eq-empty-type-args = []

 That is not a hypothetical. Measured 2026-07-28 against seed 55D4240B
 with `Name = unit Text`: `Name "abcd" == Name "abcd"` answered False --
 two identical literals, no append involved, no diagnostic. The controls
 are what make it precise: plain Text equality is correct in both
 directions, and `unit Integer` equality is correct in both directions,
 because Integer equality IS the word compare this arm falls back to and
 the missing strip costs it nothing. It costs Text everything.

  eq-rec-fuel : Integer = 64

  eq-seen-has : List Text, Text, Integer -> Boolean
  eq-seen-has (xs) (n) (i) =
   if i >= list-length xs then False
   else if list-at xs i == n then True
   else eq-seen-has xs n (i + 1)

  eq-ty-reaches : CodegenState, CodexType, Text, List Text, Integer -> Boolean
  eq-ty-reaches (st) (ty) (target) (seen) (fuel) =
   if fuel <= 0 then True
   else when strip-unit-ty (resolve-to-sum-with-defs st ty)
    is SumTy (sn) (args) (cs) ->
     if sn.value == target then True
     else if eq-seen-has seen (sn.value) 0 then False
     else eq-ctors-reach st cs target (list-push seen (sn.value)) fuel 0 (list-length cs)
    is otherwise -> False

  eq-ctors-reach : CodegenState, List SumCtor, Text, List Text, Integer, Integer, Integer -> Boolean
  eq-ctors-reach (st) (cs) (target) (seen) (fuel) (i) (len) =
   if i == len then False
   else let c = list-at cs i
   in if eq-fields-reach st (c.fields) target seen fuel 0 (list-length (c.fields)) then True
   else eq-ctors-reach st cs target seen fuel (i + 1) len

  eq-fields-reach : CodegenState, List CodexType, Text, List Text, Integer, Integer, Integer -> Boolean
  eq-fields-reach (st) (fs) (target) (seen) (fuel) (i) (len) =
   if i == len then False
   else if eq-ty-reaches st (list-at fs i) target seen (fuel - 1) then True
   else eq-fields-reach st fs target seen fuel (i + 1) len

  eq-sum-is-recursive : CodegenState, Text, List SumCtor -> Boolean
  eq-sum-is-recursive (st) (sn) (cs) =
   eq-ctors-reach st cs sn [sn] eq-rec-fuel 0 (list-length cs)

 A field at the sum's own type is compared by CALLING a synthesised helper
 rather than by inlining another field compare, because inlining is what has
 no correct bound: any depth limit compares only part of the value. The
 helper's own `==` on that field reaches this same arm and emits a call to
 itself, so the recursion happens at RUNTIME where the data terminates it.
 `eq-helper-defs` below builds one helper per recursive sum the program
 actually compares, and X86_64Chapter appends them to the definition list.

 The name is deck-recorded, and that is load-bearing rather than tidy.
 emit-call-to stores the TARGET NAME in cp-targets, which emit-all-defs
 carries across a per-function __heap-restore; every other caller hands it
 a string LITERAL, which lives in the constant pool and cannot be reclaimed.
 This is the first COMPUTED target, so without the deck the concatenation
 is allocated on the per-function bivy, freed the moment the function is
 done, and the patch pass reads a name out of reclaimed heap. Measured
 2026-08-27: it surfaced as `CDX2040: Unresolved call to` followed by
 mojibake, and with the helper emitted as well it crashed the compiler.

  eq-helper-name : Text -> Text
  eq-helper-name (sn) = deck-record ("__eq_" & sn)

  emit-eq-op : CodegenState, Integer, Integer, CodexType -> EmitResult
  emit-eq-op (st) (l-reg) (r-reg) (ty) =
   let resolved = strip-unit-ty (resolve-to-sum-with-defs st ty)
   in when resolved
    is TextTy -> emit-helper-call-2-regs st l-reg r-reg "__str_eq"
    is RealTy (rw) (rm) -> emit-num-comparison st cc-e l-reg r-reg
    is SumTy (sn) (args) (cs) ->
     if eq-sum-is-recursive st (sn.value) cs
     then emit-helper-call-2-regs st l-reg r-reg (eq-helper-name (sn.value))
     else let type-args = (when ty
      is ConstructedTy (cn) (ca) -> ca
      is otherwise -> eq-empty-type-args)
     in emit-sum-structural-eq st l-reg r-reg cs type-args
    is otherwise -> emit-comparison st cc-e l-reg r-reg ty

  emit-neq-op : CodegenState, Integer, Integer, CodexType -> EmitResult
  emit-neq-op (st) (l-reg) (r-reg) (ty) =
   let resolved = strip-unit-ty (resolve-to-sum-with-defs st ty)
   in when resolved
    is TextTy ->
     let eq-result = emit-helper-call-2-regs st l-reg r-reg "__str_eq"
     in let rd = alloc-temp (eq-result.state)
     in EmitResult {
      state = st-append-code (rd.state) (cmp-ri (eq-result.reg) 0 & setcc cc-e (rd.reg) & movzx-byte-self (rd.reg)),
      reg = rd.reg
     }
    is RealTy (rw) (rm) -> emit-num-comparison st cc-ne l-reg r-reg
    is SumTy (sn) (args) (cs) ->
     let eq-result = (if eq-sum-is-recursive st (sn.value) cs
      then emit-helper-call-2-regs st l-reg r-reg (eq-helper-name (sn.value))
      else let type-args = (when ty
       is ConstructedTy (cn) (ca) -> ca
       is otherwise -> eq-empty-type-args)
      in emit-sum-structural-eq st l-reg r-reg cs type-args)
     in let rd = alloc-temp (eq-result.state)
     in EmitResult {
      state = st-append-code (rd.state) (cmp-ri (eq-result.reg) 0 & setcc cc-e (rd.reg) & movzx-byte-self (rd.reg)),
      reg = rd.reg
     }
    is otherwise -> emit-comparison st cc-ne l-reg r-reg ty

  SumEqAccum = record {
   state : CodegenState,
   ne-jumps : List Integer,
   eq-jumps : List Integer
  }

  emit-sum-structural-eq : CodegenState, Integer, Integer, List SumCtor, List CodexType -> EmitResult
  emit-sum-structural-eq (st) (l-reg) (r-reg) (ctors) (type-args) =
   if all-ctors-nullary ctors 0 (list-length ctors)
   then emit-sum-tag-eq st l-reg r-reg
   else emit-sum-full-eq st l-reg r-reg ctors type-args

  all-ctors-nullary : List SumCtor, Integer, Integer -> Boolean
  all-ctors-nullary (cs) (i) (len) =
   if i == len then True
   else if list-length (list-at cs i).fields > 0 then False
   else all-ctors-nullary cs (i + 1) len

  emit-sum-tag-eq : CodegenState, Integer, Integer -> EmitResult
  emit-sum-tag-eq (st) (l-reg) (r-reg) =
   let l-tag = alloc-temp st
   in let st1 = st-append-code (l-tag.state) (mov-load (l-tag.reg) l-reg 0)
   in let r-tag = alloc-temp st1
   in let st2 = st-append-code (r-tag.state) (mov-load (r-tag.reg) r-reg 0)
   in emit-comparison st2 cc-e (l-tag.reg) (r-tag.reg) int-ty-default

  subst-field-type : CodexType, List CodexType -> CodexType
  subst-field-type (ty) (args) =
   when ty
    is TypeVar (id) -> if id < list-length args then list-at args id else ty
    is otherwise -> ty

  emit-sum-full-eq : CodegenState, Integer, Integer, List SumCtor, List CodexType -> EmitResult
  emit-sum-full-eq (st) (l-reg) (r-reg) (ctors) (type-args) =
   let l-loc = alloc-local st
   in let st0 = store-local (l-loc.state) (l-loc.reg) l-reg
   in let r-loc = alloc-local st0
   in let st1 = store-local (r-loc.state) (r-loc.reg) r-reg
   in let l-ld = load-local st1 (l-loc.reg)
   in let l-tag = alloc-temp (l-ld.state)
   in let st2 = st-append-code (l-tag.state) (mov-load (l-tag.reg) (l-ld.reg) 0)
   in let r-ld = load-local st2 (r-loc.reg)
   in let r-tag = alloc-temp (r-ld.state)
   in let st3 = st-append-code (r-tag.state) (mov-load (r-tag.reg) (r-ld.reg) 0)
   in let st4 = st-append-code st3 (cmp-rr (l-tag.reg) (r-tag.reg))
   in let tags-ne-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-ne 0)
   in let tag-loc = alloc-local st5
   in let st6 = store-local (tag-loc.state) (tag-loc.reg) (l-tag.reg)
   in let dispatch = emit-sum-ctor-eq-dispatch st6 ctors type-args (l-loc.reg) (r-loc.reg) (tag-loc.reg) 0 (list-length ctors) [] []
   in let rd = alloc-temp (dispatch.state)
   in let st7 = patch-eq-jumps (rd.state) (dispatch.eq-jumps) 0
   in let st8 = st-append-code st7 (li (rd.reg) 1)
   in let done-jmp-pos = st8.code-len
   in let st9 = st-append-code st8 (jmp 0)
   in let st10 = patch-jcc-at st9 tags-ne-pos (st9.code-len)
   in let st11 = patch-ne-jumps st10 (dispatch.ne-jumps) 0
   in let st12 = st-append-code st11 (li (rd.reg) 0)
   in let st13 = patch-jmp-at st12 done-jmp-pos (st12.code-len)
   in EmitResult { state = st13, reg = rd.reg }

  emit-sum-ctor-eq-dispatch : CodegenState, List SumCtor, List CodexType, Integer, Integer, Integer, Integer, Integer, List Integer, List Integer -> SumEqAccum
  emit-sum-ctor-eq-dispatch (st) (ctors) (type-args) (l-loc) (r-loc) (tag-loc) (i) (len) (ne-acc) (eq-acc) =
   if i == len then SumEqAccum { state = st, ne-jumps = ne-acc, eq-jumps = eq-acc }
   else let c = list-at ctors i
   in let fc = list-length (c.fields)
   in if fc == 0 then emit-sum-ctor-eq-dispatch st ctors type-args l-loc r-loc tag-loc (i + 1) len ne-acc eq-acc
   else let tag-ld = load-local st tag-loc
   in let st1 = st-append-code (tag-ld.state) (cmp-ri (tag-ld.reg) i)
   in let skip-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let field-result = emit-sum-fields-eq st2 (c.fields) type-args l-loc r-loc 0 fc ne-acc
   in let eq-jmp-pos = (field-result.state).code-len
   in let st3 = st-append-code (field-result.state) (jmp 0)
   in let st4 = patch-jcc-at st3 skip-pos (st3.code-len)
   in emit-sum-ctor-eq-dispatch st4 ctors type-args l-loc r-loc tag-loc (i + 1) len (field-result.ne-jumps) (list-push eq-acc eq-jmp-pos)

  emit-sum-fields-eq : CodegenState, List CodexType, List CodexType, Integer, Integer, Integer, Integer, List Integer -> SumEqAccum
  emit-sum-fields-eq (st) (fields) (type-args) (l-loc) (r-loc) (i) (len) (ne-acc) =
   if i == len then SumEqAccum { state = st, ne-jumps = ne-acc, eq-jumps = [] }
   else let decl-ty = list-at fields i
   in let field-ty = subst-field-type decl-ty type-args
   in let offset = sum-ctor-field-offset fields i
   in let fw = field-byte-width decl-ty
   in let fsigned = field-byte-signed decl-ty
   in let l-ld = load-local st l-loc
   in let l-field = alloc-temp (l-ld.state)
   in let st1 = st-append-code (l-field.state) (emit-narrow-load fw fsigned (l-field.reg) (l-ld.reg) offset)
   in let r-ld = load-local st1 r-loc
   in let r-field = alloc-temp (r-ld.state)
   in let st2 = st-append-code (r-field.state) (emit-narrow-load fw fsigned (r-field.reg) (r-ld.reg) offset)
   in let eq-result = emit-eq-op st2 (l-field.reg) (r-field.reg) field-ty
   in let st3 = st-append-code (eq-result.state) (cmp-ri (eq-result.reg) 0)
   in let ne-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in emit-sum-fields-eq st4 fields type-args l-loc r-loc (i + 1) len (list-push ne-acc ne-pos)

  patch-ne-jumps : CodegenState, List Integer, Integer -> CodegenState
  patch-ne-jumps (st) (patches) (i) =
   if i == list-length patches then st
   else patch-ne-jumps (patch-jcc-at st (list-at patches i) (st.code-len)) patches (i + 1)

  patch-eq-jumps : CodegenState, List Integer, Integer -> CodegenState
  patch-eq-jumps (st) (patches) (i) =
   if i == list-length patches then st
   else patch-eq-jumps (patch-jmp-at st (list-at patches i) (st.code-len)) patches (i + 1)

Section: Recursive Structural Equality Helpers

 A helper is an ordinary two-parameter definition emitted through
 emit-all-defs, so it inherits the standard frame, and the SysV argument
 registers it binds are the same rdi and rsi emit-helper-call-2-regs loads.
 That is why no calling-convention code appears here.

 A field declared at a TYPE PARAMETER is compared by POINTER, which is what
 the inlining path already does when the comparison site carries no type
 arguments to substitute, and what the wasm plug does. It is not exact
 structural equality for a generic recursive sum instantiated at Text; that
 shape refused to compile at all before this, so it is a new answer rather
 than a changed one.

  EqHelperReq = record {
   eq-sum-name : Text,
   eq-sum-ty : CodexType,
   eq-sum-ctors : List SumCtor
  }

  eq-req-has : List EqHelperReq, Text, Integer -> Boolean
  eq-req-has (xs) (n) (i) =
   if i >= list-length xs then False
   else if ((list-at xs i).eq-sum-name) == n then True
   else eq-req-has xs n (i + 1)

 A comparison at a NON-recursive sum still descends: emit-sum-fields-eq calls
 emit-eq-op again on each field, so a non-recursive sum holding a recursive
 one reaches the helper arm too and needs that helper synthesised. Following
 only the eq SITES misses it, and the miss is a call to a function nobody
 emitted. So the walk mirrors the inliner exactly -- push a req at a
 recursive sum and stop, descend through a non-recursive one -- and the
 descent terminates because non-recursive means it cannot reach itself.
 The fuel is the same bound eq-sum-is-recursive carries and exists for a
 malformed type graph, not for this walk.

  eq-note-site : CodegenState, CodexType, List EqHelperReq, Integer -> List EqHelperReq
  eq-note-site (st) (ty) (acc) (fuel) =
   if fuel <= 0 then acc
   else let resolved = strip-unit-ty (resolve-to-sum-with-defs st ty)
   in when resolved
    is SumTy (sn) (args) (cs) ->
     if eq-sum-is-recursive st (sn.value) cs
     then (if eq-req-has acc (sn.value) 0 then acc
      else list-push acc (deck-record (EqHelperReq {
        eq-sum-name = sn.value,
        eq-sum-ty = resolved,
        eq-sum-ctors = cs
       })))
     else eq-site-ctors st cs 0 acc (fuel - 1)
    is otherwise -> acc

  eq-site-ctors : CodegenState, List SumCtor, Integer, List EqHelperReq, Integer -> List EqHelperReq
  eq-site-ctors (st) (cs) (i) (acc) (fuel) =
   if i >= list-length cs then acc
   else eq-site-ctors st cs (i + 1) (eq-site-fields st ((list-at cs i).fields) 0 acc fuel) fuel

  eq-site-fields : CodegenState, List CodexType, Integer, List EqHelperReq, Integer -> List EqHelperReq
  eq-site-fields (st) (fs) (i) (acc) (fuel) =
   if i >= list-length fs then acc
   else eq-site-fields st fs (i + 1) (eq-note-site st (list-at fs i) acc fuel) fuel

  eq-note-type : CodegenState, CodexType, List EqHelperReq -> List EqHelperReq
  eq-note-type (st) (ty) (acc) = eq-note-site st ty acc eq-rec-fuel

  eq-op-is-equality : IRBinaryOp -> Boolean
  eq-op-is-equality (op) =
   when op
    is IrEq | IrNotEq -> True
    is otherwise -> False

  eq-collect-expr : CodegenState, IRExpr, List EqHelperReq -> List EqHelperReq
  eq-collect-expr (st) (e) (acc) =
   when e
    is IrIntLit (n) (sp) | IrNumLit (n) (sp) -> acc
    is IrTextLit (s) (sp) -> acc
    is IrBoolLit (b) (sp) | IrCharLit (c) (sp) -> acc
    is IrName (n) (ty) (sp) -> acc
    is IrError (m) (ty) (sp) -> acc
    is IrBinary (op) (l) (r) (ty) (sp) ->
     let noted = if eq-op-is-equality op then eq-note-type st (ir-expr-type l) acc else acc
     in eq-collect-expr st r (eq-collect-expr st l noted)
    is IrNegate (x) (ty) (sp) -> eq-collect-expr st x acc
    is IrIf (c) (t) (el) (ty) (sp) -> eq-collect-expr st el (eq-collect-expr st t (eq-collect-expr st c acc))
    is IrLet (n) (ty) (v) (b) (sp) -> eq-collect-expr st b (eq-collect-expr st v acc)
    is IrApply (f) (a) (ty) (sp) -> eq-collect-expr st a (eq-collect-expr st f acc)
    is IrLambda (ps) (body) (ty) (sp) -> eq-collect-expr st body acc
    is IrList (es) (ty) (sp) -> eq-collect-expr-list st es 0 acc
    is IrMatch (sc) (bs) (ty) (sp) -> eq-collect-branches st bs 0 (eq-collect-expr st sc acc)
    is IrAct (ss) (ty) (sp) -> eq-collect-stmts st ss 0 acc
    is IrHandle (eff) (h) (cs) (ty) (sp) -> eq-collect-clauses st cs 0 (eq-collect-expr st h acc)
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> eq-collect-expr st body acc
    is IrRecord (n) (fs) (ty) (sp) -> eq-collect-fields st fs 0 acc
    is IrFieldAccess (r) (f) (ty) (sp) -> eq-collect-expr st r acc
    is IrFieldStore (r) (f) (v) (ty) (sp) -> eq-collect-expr st v (eq-collect-expr st r acc)
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> eq-collect-stmts st fail 0 (eq-collect-stmts st fb 0 (eq-collect-stmts st body 0 acc))
    is IrFork (b) (ty) (sp) -> eq-collect-expr st b acc
    is IrAwait (t) (ty) (sp) -> eq-collect-expr st t acc

  eq-collect-expr-list : CodegenState, List IRExpr, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-expr-list (st) (xs) (i) (acc) =
   if i >= list-length xs then acc
   else eq-collect-expr-list st xs (i + 1) (eq-collect-expr st (list-at xs i) acc)

  eq-collect-branches : CodegenState, List IRBranch, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-branches (st) (xs) (i) (acc) =
   if i >= list-length xs then acc
   else let b = list-at xs i
   in eq-collect-branches st xs (i + 1) (eq-collect-expr st (b.guard) (eq-collect-expr st (b.body) acc))

  eq-collect-clauses : CodegenState, List IRHandleClause, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-clauses (st) (xs) (i) (acc) =
   if i >= list-length xs then acc
   else eq-collect-clauses st xs (i + 1) (eq-collect-expr st ((list-at xs i).body) acc)

  eq-collect-fields : CodegenState, List IRFieldVal, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-fields (st) (xs) (i) (acc) =
   if i >= list-length xs then acc
   else eq-collect-fields st xs (i + 1) (eq-collect-expr st ((list-at xs i).value) acc)

  eq-collect-stmts : CodegenState, List IRActStmt, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-stmts (st) (xs) (i) (acc) =
   if i >= list-length xs then acc
   else eq-collect-stmts st xs (i + 1) (eq-collect-expr st (ir-act-stmt-expr (list-at xs i)) acc)

  eq-collect-defs : CodegenState, List IRDef, Integer, List EqHelperReq -> List EqHelperReq
  eq-collect-defs (st) (ds) (i) (acc) =
   if i >= list-length ds then acc
   else eq-collect-defs st ds (i + 1) (eq-collect-expr st ((list-at ds i).body) acc)

 The closure is a worklist and not a recursion: a helper's own body compares
 the fields of its constructors, and a field at ANOTHER recursive sum needs
 that sum's helper too. Indexing forward over a list that grows as it is
 walked visits every entry appended by an earlier one, and eq-req-has keeps
 it finite by refusing a duplicate, so mutual recursion terminates.

  eq-close-reqs : CodegenState, List EqHelperReq, Integer -> List EqHelperReq
  eq-close-reqs (st) (reqs) (i) =
   if i >= list-length reqs then reqs
   else eq-close-reqs st (eq-site-ctors st ((list-at reqs i).eq-sum-ctors) 0 reqs eq-rec-fuel) (i + 1)

  eq-helper-var : Text, Integer -> Text
  eq-helper-var (prefix) (i) = prefix & show i

  eq-helper-field-pats : List CodexType, Text, Integer, Integer, List IRPat -> List IRPat
  eq-helper-field-pats (fs) (prefix) (i) (n) (acc) =
   if i >= n then acc
   else eq-helper-field-pats fs prefix (i + 1) n (list-push acc (deck-record (IrVarPat (eq-helper-var prefix i) (list-at fs i) synthetic-span)))

  eq-helper-true : IRExpr
  eq-helper-true = deck-record (IrBoolLit True synthetic-span)

  eq-helper-field-conj : List CodexType, Integer, Integer -> IRExpr
  eq-helper-field-conj (fs) (i) (n) =
   if i >= n then eq-helper-true
   else let fty = list-at fs i
   in let lhs = deck-record (IrName (eq-helper-var "__eqx" i) fty synthetic-span)
   in let rhs = deck-record (IrName (eq-helper-var "__eqy" i) fty synthetic-span)
   in let one = deck-record (IrBinary IrEq lhs rhs BooleanTy synthetic-span)
   in if i + 1 >= n then one
   else deck-record (IrBinary IrAnd one (eq-helper-field-conj fs (i + 1) n) BooleanTy synthetic-span)

  eq-helper-inner : Text, List CodexType, CodexType -> IRExpr
  eq-helper-inner (cn) (fs) (sty) =
   deck-record (IrMatch (deck-record (IrName "__eqb" sty synthetic-span)) [
     deck-record (IRBranch {
      pattern = deck-record (IrCtorPat cn (eq-helper-field-pats fs "__eqy" 0 (list-length fs) []) sty synthetic-span),
      body = eq-helper-field-conj fs 0 (list-length fs),
      guard = eq-helper-true,
      span = synthetic-span,
      alt-group = 0 - 1
     }),
     deck-record (IRBranch {
      pattern = deck-record (IrWildPat synthetic-span),
      body = deck-record (IrBoolLit False synthetic-span),
      guard = eq-helper-true,
      span = synthetic-span,
      alt-group = 0 - 1
     })
    ] BooleanTy synthetic-span)

  eq-helper-outer-branches : List SumCtor, CodexType, Integer, Integer, List IRBranch -> List IRBranch
  eq-helper-outer-branches (cs) (sty) (i) (n) (acc) =
   if i >= n then acc
   else let c = list-at cs i
   in let cn = (c.name).value
   in let fs = c.fields
   in eq-helper-outer-branches cs sty (i + 1) n (list-push acc (deck-record (IRBranch {
     pattern = deck-record (IrCtorPat cn (eq-helper-field-pats fs "__eqx" 0 (list-length fs) []) sty synthetic-span),
     body = eq-helper-inner cn fs sty,
     guard = eq-helper-true,
     span = synthetic-span,
     alt-group = 0 - 1
    })))

  eq-helper-def : EqHelperReq -> IRDef
  eq-helper-def (req) =
   let sty = req.eq-sum-ty
   in let cs = req.eq-sum-ctors
   in deck-record (IRDef {
    name = eq-helper-name (req.eq-sum-name),
    params = [
      deck-record (IRParam { name = "__eqa", type-val = sty, span = synthetic-span }),
      deck-record (IRParam { name = "__eqb", type-val = sty, span = synthetic-span })
     ],
    type-val = BooleanTy,
    body = deck-record (IrMatch (deck-record (IrName "__eqa" sty synthetic-span)) (eq-helper-outer-branches cs sty 0 (list-length cs) []) BooleanTy synthetic-span),
    chapter-slug = "",
    is-punctual = False,
    wcet-budget = 0,
    unique-params = [],
    span = synthetic-span
   })

  eq-helper-defs-acc : List EqHelperReq, Integer, List IRDef -> List IRDef
  eq-helper-defs-acc (reqs) (i) (acc) =
   if i >= list-length reqs then acc
   else eq-helper-defs-acc reqs (i + 1) (list-push acc (eq-helper-def (list-at reqs i)))

  eq-helper-defs : CodegenState, List IRDef -> List IRDef
  eq-helper-defs (st) (ds) =
   eq-helper-defs-acc (eq-close-reqs st (eq-collect-defs st ds 0 []) 0) 0 []

 `cmp` orders IEEE-754 bit patterns correctly for two non-negatives and for
 mixed signs, and reverses for two negatives. Every caller here is expected to
 have dispatched floating operands away already, so this refuses one rather
 than emitting a compare that is wrong for a quarter of the operand plane.
 The type is a parameter and not an inference: a caller that cannot say what it
 is comparing has no business reaching the integer path.

 It answers True for records, lists and sums on purpose. `emit-eq-op`'s
 fallthrough compares those by POINTER and means to; only the float case is a
 wrong answer rather than a different question.

  cmp-answers-operand : CodegenState, CodexType -> Boolean
  cmp-answers-operand (st) (ty) =
   if is-real-type (strip-unit-ty (resolve-to-sum-with-defs st ty)) then False else True

  emit-comparison : CodegenState, Integer, Integer, Integer, CodexType -> EmitResult
  emit-comparison (st) (cc) (l-reg) (r-reg) (operand-ty) =
   let st0 = if cmp-answers-operand st operand-ty then st
    else st-add-error st cdx-int-compare-on-float "The integer comparison emitter was handed a floating-point operand. A machine cmp reverses on two negative IEEE-754 bit patterns, so this would be wrong for a quarter of the operand plane with no fault and no other diagnostic; the build halts rather than emit it. Dispatch the operand through emit-ord-comparison." synthetic-span
   in let rd = alloc-temp st0
   in EmitResult {
   state = st-append-code (rd.state) (cmp-rr l-reg r-reg & setcc cc (rd.reg) & movzx-byte-self (rd.reg)),
   reg = rd.reg
  }

  invert-cc : Integer -> Integer
  invert-cc (cc) =
   if cc == cc-e then cc-ne
   else if cc == cc-ne then cc-e
   else if cc == cc-l then cc-ge
   else if cc == cc-ge then cc-l
   else if cc == cc-le then cc-g
   else if cc == cc-g then cc-le
   else cc-ne

  comparison-op-cc : IRBinaryOp -> Integer
  comparison-op-cc (op) =
   when op
    is IrEq -> cc-e
    is IrNotEq -> cc-ne
    is IrLt -> cc-l
    is IrGt -> cc-g
    is IrLtEq -> cc-le
    is IrGtEq -> cc-ge
    is otherwise -> 0 - 1

  is-fusable-int-comparison : CodegenState, IRBinaryOp, IRExpr -> Boolean
  is-fusable-int-comparison (st) (op) (left) =
   let cc = comparison-op-cc op
   in if cc == 0 - 1 then False
   else when op
    is IrLt | IrGt | IrLtEq | IrGtEq | IrEq | IrNotEq ->
     let operand-ty = resolve-to-sum-with-defs st (ir-expr-type left)
     in when operand-ty
      is IntegerTy (lo) (hi) (mode) | BooleanTy | CharTy -> True
      is UnitTy (n) (inner) -> when inner
       is IntegerTy (lo2) (hi2) (m2) | BooleanTy | CharTy -> True
       is otherwise -> False
      is otherwise -> False
    is otherwise -> False

  emit-if-fused : CodegenState, IRBinaryOp, IRExpr, IRExpr, IRExpr, IRExpr -> EmitResult
  emit-if-fused (st) (op) (cmp-left) (cmp-right) (then-e) (else-e) =
   let saved-tail = st.tco.in-tail-pos
   in let l = emit-expr (st-set-tail-pos st False) cmp-left
   in let l-loc = alloc-local (l.state)
   in let st1 = store-local (l-loc.state) (l-loc.reg) (l.reg)
   in let r = emit-expr st1 cmp-right
   in let l-load = load-local (r.state) (l-loc.reg)
   in let inv-cc = invert-cc (comparison-op-cc op)
   in let st3 = st-append-code (l-load.state) (cmp-rr (l-load.reg) (r.reg))
   in let jcc-false-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc inv-cc 0)
   in let result-loc = alloc-local st4
   in let st5 = emit-to-local (result-loc.state) then-e (result-loc.reg) saved-tail
   in let jmp-end-pos = st5.code-len
   in let st6 = st-append-code st5 (jmp 0)
   in let st7 = patch-jcc-at st6 jcc-false-pos (st6.code-len)
   in let st8 = emit-to-local st7 else-e (result-loc.reg) saved-tail
   in let st9 = patch-jmp-at st8 jmp-end-pos (st8.code-len)
   in load-local st9 (result-loc.reg)

  emit-if-fused-imm : CodegenState, IRBinaryOp, IRExpr, Integer, IRExpr, IRExpr -> EmitResult
  emit-if-fused-imm (st) (op) (cmp-left) (imm) (then-e) (else-e) =
   let saved-tail = st.tco.in-tail-pos
   in let l = emit-expr (st-set-tail-pos st False) cmp-left
   in let inv-cc = invert-cc (comparison-op-cc op)
   in let st3 = st-append-code (l.state) (cmp-ri-or-test (l.reg) imm)
   in let jcc-false-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc inv-cc 0)
   in let result-loc = alloc-local st4
   in let st5 = emit-to-local (result-loc.state) then-e (result-loc.reg) saved-tail
   in let jmp-end-pos = st5.code-len
   in let st6 = st-append-code st5 (jmp 0)
   in let st7 = patch-jcc-at st6 jcc-false-pos (st6.code-len)
   in let st8 = emit-to-local st7 else-e (result-loc.reg) saved-tail
   in let st9 = patch-jmp-at st8 jmp-end-pos (st8.code-len)
   in load-local st9 (result-loc.reg)

  emit-if : CodegenState, IRExpr, IRExpr, IRExpr -> EmitResult
  emit-if (st) (cond) (then-e) (else-e) =
   when cond
    is IrBinary (op) (left) (right) (ty) (sp) ->
     if is-fusable-int-comparison st op left then
      when right
       is IrIntLit (v) (s) ->
        if v >= (0 - 2147483648) & v <= 2147483647
        then emit-if-fused-imm st op left v then-e else-e
        else emit-if-fused st op left right then-e else-e
       is otherwise -> emit-if-fused st op left right then-e else-e
     else emit-if-generic st cond then-e else-e
    is otherwise -> emit-if-generic st cond then-e else-e

  emit-if-generic : CodegenState, IRExpr, IRExpr, IRExpr -> EmitResult
  emit-if-generic (st) (cond) (then-e) (else-e) =
   let saved-tail = st.tco.in-tail-pos
   in let cond-result = emit-expr (st-set-tail-pos st False) cond
   in let st1 = st-append-code (cond-result.state) (test-rr (cond-result.reg) (cond-result.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let result-loc = alloc-local st2
   in let st3 = emit-to-local (result-loc.state) then-e (result-loc.reg) saved-tail
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let st6 = emit-to-local st5 else-e (result-loc.reg) saved-tail
   in let st7 = patch-jmp-at st6 jmp-end-pos (st6.code-len)
   in load-local st7 (result-loc.reg)

Section: Call Emission
  emit-call-to : CodegenState, Text -> CodegenState
  emit-call-to (st0) (target) =
   let st = fc-flush st0
   in let patch-pos = st.code-len
   in let st1 = st-append-code st (x86-call 0)
   in let cp-o = list-push (st1.cp-offsets) patch-pos
   in let cp-t = list-push (st1.cp-targets) target
   in let st2 = __record-set st1 "cp-offsets" cp-o
   in __record-set st2 "cp-targets" cp-t

  emit-jmp-to : CodegenState, Text -> CodegenState
  emit-jmp-to (st0) (target) =
   let st = fc-flush st0
   in let patch-pos = st.code-len
   in let st1 = st-append-code st (jmp 0)
   in let cp-o = list-push (st1.cp-offsets) patch-pos
   in let cp-t = list-push (st1.cp-targets) target
   in let st2 = __record-set st1 "cp-offsets" cp-o
   in __record-set st2 "cp-targets" cp-t

