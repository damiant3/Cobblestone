Section: PIT and PIC Initialization
  emit-pit-init : CodegenState -> CodegenState
  emit-pit-init (st) =
   let st1 = emit-out-byte st 67 52
   in let st2 = emit-out-byte st1 64 0
   in emit-out-byte st2 64 0

  emit-pic-init : CodegenState -> CodegenState
  emit-pic-init (st) =
   let st1 = emit-out-byte st 32 17
   in let st2 = emit-out-byte st1 160 17
   in let st3 = emit-out-byte st2 33 32
   in let st4 = emit-out-byte st3 161 40
   in let st5 = emit-out-byte st4 33 4
   in let st6 = emit-out-byte st5 161 2
   in let st7 = emit-out-byte st6 33 1
   in let st8 = emit-out-byte st7 161 1
   in let st9 = emit-out-byte st8 33 236
   in emit-out-byte st9 161 255

Section: CPU Exception Dump
  emit-print-hex-nibble-rdi : CodegenState -> CodegenState
  emit-print-hex-nibble-rdi (st) =
   let st1 = st-append-code st (and-ri reg-rdi 15)
   in let st2 = st-append-code st1 (cmp-ri reg-rdi 10)
   in let jge-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (add-ri reg-rdi 48)
   in let jmp-pos = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 jge-pos (st5.code-len)
   in let st7 = st-append-code st6 (add-ri reg-rdi 87)
   in let st8 = patch-jmp-at st7 jmp-pos (st7.code-len)
   in emit-serial-send-rdi st8

  emit-print-hex-qword-rdi-loop : CodegenState, Integer -> CodegenState
  emit-print-hex-qword-rdi-loop (st) (nibble-idx) =
   if nibble-idx < 0 then st
   else let st1 = st-append-code st (push-r reg-rdi)
   in let shift = nibble-idx * 4
   in let st2 = if shift == 0 then st1 else st-append-code st1 (shr-ri reg-rdi shift)
   in let st3 = emit-print-hex-nibble-rdi st2
   in let st4 = st-append-code st3 (pop-r reg-rdi)
   in emit-print-hex-qword-rdi-loop st4 (nibble-idx - 1)

  emit-print-hex-qword-rdi : CodegenState -> CodegenState
  emit-print-hex-qword-rdi (st) =
   emit-print-hex-qword-rdi-loop st 15

  emit-print-hex-byte-rdi : CodegenState -> CodegenState
  emit-print-hex-byte-rdi (st) =
   let st1 = st-append-code st (push-r reg-rdi)
   in let st2 = st-append-code st1 (shr-ri reg-rdi 4)
   in let st3 = emit-print-hex-nibble-rdi st2
   in let st4 = st-append-code st3 (pop-r reg-rdi)
   in emit-print-hex-nibble-rdi st4

  emit-cpu-exception-dump : CodegenState -> CodegenState
  emit-cpu-exception-dump (st) =
   let st0a = st-append-code st (mov-rr reg-r11 reg-rsp)
   in let st0a1 = st-append-code st0a (li reg-rdi ram-size-addr)
   in let st0b = st-append-code st0a1 (mov-load reg-rsp reg-rdi 0)
   in let st0b1 = st-append-code st0b (push-r reg-rbp)
   in let st0c = st-append-code st0b1 (mov-rr reg-rbp reg-rsp)
   in let st0d = st-append-code st0c (push-r reg-r15)
   in let st0 = st-append-code st0d (mov-rr reg-rdi reg-rax)
   in let st1 = emit-serial-wait-and-send st0 33
   in let st2 = emit-serial-wait-and-send st1 69
   in let st3 = emit-serial-wait-and-send st2 88
   in let st4 = emit-serial-wait-and-send st3 67
   in let st5 = emit-serial-wait-and-send st4 61
   in let st6 = emit-print-hex-byte-rdi st5
   in let st7 = emit-serial-wait-and-send st6 32
   in let st8 = emit-serial-wait-and-send st7 82
   in let st9 = emit-serial-wait-and-send st8 73
   in let st10 = emit-serial-wait-and-send st9 80
   in let st11 = emit-serial-wait-and-send st10 61
   in let st12 = st-append-code st11 (mov-load reg-rdi reg-r11 40)
   in let st13 = emit-print-hex-qword-rdi st12
   in let st13a = emit-serial-wait-and-send st13 32
   in let st13b = emit-serial-wait-and-send st13a 82
   in let st13c = emit-serial-wait-and-send st13b 66
   in let st13d = emit-serial-wait-and-send st13c 88
   in let st13e = emit-serial-wait-and-send st13d 61
   in let st13f = st-append-code st13e (mov-rr reg-rdi reg-rbx)
   in let st13g = emit-print-hex-qword-rdi st13f
   in let st13h = emit-serial-wait-and-send st13g 32
   in let st13i = emit-serial-wait-and-send st13h 82
   in let st13j = emit-serial-wait-and-send st13i 49
   in let st13k = emit-serial-wait-and-send st13j 50
   in let st13l = emit-serial-wait-and-send st13k 61
   in let st13m = st-append-code st13l (mov-rr reg-rdi reg-r12)
   in let st13n = emit-print-hex-qword-rdi st13m
   in let st13o = emit-serial-wait-and-send st13n 32
   in let st13p = emit-serial-wait-and-send st13o 82
   in let st13q = emit-serial-wait-and-send st13p 49
   in let st13r = emit-serial-wait-and-send st13q 51
   in let st13s = emit-serial-wait-and-send st13r 61
   in let st13t = st-append-code st13s (mov-rr reg-rdi reg-r13)
   in let st13u = emit-print-hex-qword-rdi st13t
   in let st13v = emit-serial-wait-and-send st13u 32
   in let st13w = emit-serial-wait-and-send st13v 82
   in let st13x = emit-serial-wait-and-send st13w 49
   in let st13y = emit-serial-wait-and-send st13x 52
   in let st13z = emit-serial-wait-and-send st13y 61
   in let st13aa = st-append-code st13z (mov-rr reg-rdi reg-r14)
   in let st13ab = emit-print-hex-qword-rdi st13aa
   in let st13ac = emit-serial-wait-and-send st13ab 32
   in let st13ad = emit-serial-wait-and-send st13ac 82
   in let st13ae = emit-serial-wait-and-send st13ad 49
   in let st13af = emit-serial-wait-and-send st13ae 48
   in let st13ag = emit-serial-wait-and-send st13af 61
   in let st13ah = st-append-code st13ag (mov-rr reg-rdi reg-r10)
   in let st13ai = emit-print-hex-qword-rdi st13ah
   in let st13aj = emit-serial-wait-and-send st13ai 32
   in let st13ak = emit-serial-wait-and-send st13aj 82
   in let st13al = emit-serial-wait-and-send st13ak 68
   in let st13am = emit-serial-wait-and-send st13al 73
   in let st13an = emit-serial-wait-and-send st13am 61
   in let st13ao = st-append-code st13an (mov-load reg-rdi reg-r11 0)
   in let st13ap = emit-print-hex-qword-rdi st13ao
   in let st13aq = emit-serial-wait-and-send st13ap 32
   in let st13ar = emit-serial-wait-and-send st13aq 82
   in let st13as = emit-serial-wait-and-send st13ar 83
   in let st13at = emit-serial-wait-and-send st13as 73
   in let st13au = emit-serial-wait-and-send st13at 61
   in let st13av = st-append-code st13au (mov-load reg-rdi reg-r11 8)
   in let st13aw = emit-print-hex-qword-rdi st13av
   in let st13ax = emit-serial-wait-and-send st13aw 32
   in let st13ay = emit-serial-wait-and-send st13ax 67
   in let st13az = emit-serial-wait-and-send st13ay 97
   in let st13ba = emit-serial-wait-and-send st13az 108
   in let st13bb = emit-serial-wait-and-send st13ba 108
   in let st13bc = emit-serial-wait-and-send st13bb 82
   in let st13bd = emit-serial-wait-and-send st13bc 61
   in let st13be = st-append-code st13bd (mov-load reg-rdi reg-r11 64)
   in let st13bf = emit-print-hex-qword-rdi st13be
   in let st-cr2a = emit-serial-wait-and-send st13bf 32
   in let st-cr2b = emit-serial-wait-and-send st-cr2a 67
   in let st-cr2c = emit-serial-wait-and-send st-cr2b 82
   in let st-cr2d = emit-serial-wait-and-send st-cr2c 50
   in let st-cr2e = emit-serial-wait-and-send st-cr2d 61
   in let st-cr2f = st-append-code st-cr2e [15, 32, 215]
   in let st-cr2g = emit-print-hex-qword-rdi st-cr2f
   in let st-r15a = emit-serial-wait-and-send st-cr2g 32
   in let st-r15b = emit-serial-wait-and-send st-r15a 82
   in let st-r15c = emit-serial-wait-and-send st-r15b 49
   in let st-r15d = emit-serial-wait-and-send st-r15c 53
   in let st-r15e = emit-serial-wait-and-send st-r15d 61
   in let st-r15f = st-append-code st-r15e (mov-load reg-rdi reg-rbp (-8))
   in let st-r15g = emit-print-hex-qword-rdi st-r15f
   in let st-rbpa = emit-serial-wait-and-send st-r15g 32
   in let st-rbpb = emit-serial-wait-and-send st-rbpa 82
   in let st-rbpc = emit-serial-wait-and-send st-rbpb 66
   in let st-rbpd = emit-serial-wait-and-send st-rbpc 80
   in let st-rbpe = emit-serial-wait-and-send st-rbpd 61
   in let st-rbpf = st-append-code st-rbpe (mov-load reg-rdi reg-rbp 0)
   in let st-rbpg = emit-print-hex-qword-rdi st-rbpf
   in let st14 = emit-serial-wait-and-send st-rbpg 10
   in let st14a = emit-exc-stack-dump st14
   in let st14w = emit-exc-frame-walk st14a
   in let st14b = emit-serial-drain-delay st14w
   in let st15 = st-append-code st14b cli
   in let halt-pos = st15.code-len
   in let st16 = st-append-code st15 hlt
   in st-append-code st16 (jmp (halt-pos - (st16.code-len + 5)))

Section: Exception Stack Dump

  emit-exc-stack-dump : CodegenState -> CodegenState
  emit-exc-stack-dump (st) =
   let st0 = st-append-code st (mov-rr reg-rbx reg-r11)
   in let st1 = st-append-code st0 (li reg-rcx 16)
   in let st2 = st-append-code st1 (xor-rr reg-rsi reg-rsi)
   in let loop-top = st2.code-len
   in let st3 = emit-serial-wait-and-send st2 83
   in let st4 = emit-serial-wait-and-send st3 91
   in let st5 = st-append-code st4 (mov-rr reg-rdi reg-rsi)
   in let st6 = emit-print-hex-qword-rdi st5
   in let st7 = emit-serial-wait-and-send st6 93
   in let st8 = emit-serial-wait-and-send st7 61
   in let st9 = st-append-code st8 (mov-rr reg-rdi reg-rsi)
   in let st10 = st-append-code st9 (add-rr reg-rdi reg-rbx)
   in let st11 = st-append-code st10 (mov-load reg-rdi reg-rdi 0)
   in let st12 = emit-print-hex-qword-rdi st11
   in let st13 = emit-serial-wait-and-send st12 10
   in let st14 = st-append-code st13 (add-ri reg-rsi 8)
   in let st15 = st-append-code st14 (sub-ri reg-rcx 1)
   in let cur = st15.code-len
   in st-append-code st15 (jcc cc-ne (loop-top - (cur + 6)))

Section: Exception Frame Walk

 The frame chain, walked exactly, printed as F[n]= lines. The S[] dump
 above cannot distinguish a return address from a saved register or a
 stale slot, so the host filters it by asking which values resolve to a
 symbol, and any integer that lands inside a function's byte range
 passes. This walk answers the same question without guessing: every
 address it prints is the return slot of a frame reached by following
 the chain, so a value that fails to resolve is evidence the chain
 broke rather than noise to be dropped.

 It walks RBP because RBP is trustworthy here. emit-prologue pushes RBP
 and sets it to RSP for every standard-tier function, and
 omit-frame-pointer is initialized False with nothing in the tree
 setting it True. The frameless minimal-leaf tier never touches RBP at
 all, which makes a frameless activation MISSING from the chain rather
 than corrupting it: its caller's RBP is still what RBP holds, so the
 walk resumes correctly one frame out, and RIP already names the
 function that faulted. A fault between push rbp and mov rbp,rsp has
 the same shape and the same harmless outcome. If omit-frame-pointer is
 ever turned on, this walk degrades to skipping those frames, not to
 printing wrong ones.

 Four of the five exits keep a walk inside a fault handler from itself
 faulting: a zero link, a misaligned link, a link whose frame would
 reach past the top of RAM, and a link that does not strictly increase.
 The last is the one that matters, because the stack grows down, so a
 chain that fails to climb is a corrupted or self-referential frame and
 would otherwise spin until the depth budget ran out. A nested fault
 here would be a double fault and then a triple fault, which is a dead
 machine and an empty serial log, so these are load-bearing rather than
 decorative. The fifth exit, a zero return address, is not a safety
 check but the ordinary end of the chain at the outermost frame; it is
 tested before anything is printed so the terminator does not appear as
 a frame whose address resolves to nothing.

 One limit worth stating because it looks like a bug when first seen.
 The handler switches RSP to the top of RAM, which is also where the
 boot stack lives, so it pushes over the shallowest frames of whatever
 faulted. A fault raised directly out of opening therefore has its one
 frame trampled before the walk can read it. Faults that happen a few
 calls down, which is every fault worth debugging, sit far below
 anything the handler touches. codex/test/exc-deep-frames.codex is the
 sample that exercises a real chain for this reason.

  emit-exc-frame-walk : CodegenState -> CodegenState
  emit-exc-frame-walk (st) =
   let st0 = st-append-code st (mov-load reg-rbx reg-rbp 0)
   in let st1 = st-append-code st0 (li reg-rcx 16)
   in let st2 = st-append-code st1 (xor-rr reg-rsi reg-rsi)
   in let loop-top = st2.code-len
   in let v0 = st-append-code st2 (test-rr reg-rbx reg-rbx)
   in let j-zero = v0.code-len
   in let v1 = st-append-code v0 (jcc cc-e 0)
   in let v2 = st-append-code v1 (mov-rr reg-rdi reg-rbx)
   in let v3 = st-append-code v2 (and-ri reg-rdi 7)
   in let j-align = v3.code-len
   in let v4 = st-append-code v3 (jcc cc-ne 0)
   in let v5 = st-append-code v4 (li reg-rdi ram-size-addr)
   in let v6 = st-append-code v5 (mov-load reg-rdi reg-rdi 0)
   in let v7 = st-append-code v6 (sub-ri reg-rdi 16)
   in let v8 = st-append-code v7 (cmp-rr reg-rbx reg-rdi)
   in let j-high = v8.code-len
   in let v9 = st-append-code v8 (jcc cc-a 0)
   in let r0 = st-append-code v9 (mov-load reg-rdi reg-rbx 8)
   in let r1 = st-append-code r0 (test-rr reg-rdi reg-rdi)
   in let j-noret = r1.code-len
   in let r2 = st-append-code r1 (jcc cc-e 0)
   in let p0 = emit-serial-wait-and-send r2 70
   in let p1 = emit-serial-wait-and-send p0 91
   in let p2 = st-append-code p1 (mov-rr reg-rdi reg-rsi)
   in let p3 = emit-print-hex-byte-rdi p2
   in let p4 = emit-serial-wait-and-send p3 93
   in let p5 = emit-serial-wait-and-send p4 61
   in let p6 = st-append-code p5 (mov-load reg-rdi reg-rbx 8)
   in let p7 = emit-print-hex-qword-rdi p6
   in let p8 = emit-serial-wait-and-send p7 10
   in let a0 = st-append-code p8 (mov-load reg-rdi reg-rbx 0)
   in let a1 = st-append-code a0 (cmp-rr reg-rdi reg-rbx)
   in let j-nonmono = a1.code-len
   in let a2 = st-append-code a1 (jcc cc-be 0)
   in let a3 = st-append-code a2 (mov-rr reg-rbx reg-rdi)
   in let a4 = st-append-code a3 (add-ri reg-rsi 1)
   in let a5 = st-append-code a4 (sub-ri reg-rcx 1)
   in let cur = a5.code-len
   in let a6 = st-append-code a5 (jcc cc-ne (loop-top - (cur + 6)))
   in let done-pos = a6.code-len
   in let f1 = patch-jcc-at a6 j-zero done-pos
   in let f2 = patch-jcc-at f1 j-align done-pos
   in let f3 = patch-jcc-at f2 j-high done-pos
   in let f4 = patch-jcc-at f3 j-noret done-pos
   in patch-jcc-at f4 j-nonmono done-pos

Section: Serial Drain Delay

  emit-serial-drain-delay : CodegenState -> CodegenState
  emit-serial-drain-delay (st) =
   let wait-top = st.code-len
   in let st1 = st-append-code st (li reg-rdx 1021)
   in let st2 = st-append-code st1 [236]
   in let st3 = st-append-code st2 [168, 32]
   in let jnz-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (jmp (wait-top - (st4.code-len + 5)))
   in patch-jcc-at st5 jnz-pos (st5.code-len)

Section: Watchdog Timer Check

 Emitted into the timer ISR when the target is bare-metal. Compares R10
 (live heap pointer) and saved-RIP at [rsp+40] to snapshots stored at
 wd-last-heap-addr / wd-last-rip-addr. If either moved (RIP delta > 4 KB
 window), snapshot and reset the stale-tick counter. If neither moved,
 increment stale-tick and compare to threshold; panic if exceeded.

  emit-watchdog-ring-write : CodegenState -> CodegenState
  emit-watchdog-ring-write (st) =
   let st1 = st-append-code st (li reg-rdi wd-ring-head-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rdi 0)
   in let st3 = st-append-code st2 (and-ri reg-rax 3)
   in let st4 = st-append-code st3 (shl-ri reg-rax 5)
   in let st5 = st-append-code st4 (li reg-rsi wd-ring-buf-addr)
   in let st6 = st-append-code st5 (add-rr reg-rsi reg-rax)
   in let st7 = st-append-code st6 (mov-store reg-rsi reg-rcx 0)
   in let st8 = st-append-code st7 (mov-load reg-rdx reg-rsp 64)
   in let st9 = st-append-code st8 (mov-store reg-rsi reg-rdx 8)
   in let st10 = st-append-code st9 (mov-store reg-rsi reg-r10 16)
   in let st11 = st-append-code st10 (mov-load reg-rdx reg-rdi 0)
   in let st12 = st-append-code st11 (add-ri reg-rdx 1)
   in st-append-code st12 (mov-store reg-rdi reg-rdx 0)

  emit-watchdog-progress-dispatch : CodegenState -> CodegenState
  emit-watchdog-progress-dispatch (st) =
   let st1 = st-append-code st (cmp-ri reg-rax wd-tier1-threshold)
   in let tier1-skip-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let st3 = emit-call-to st2 "__watchdog_tier1"
   in let st4 = patch-jcc-at st3 tier1-skip-pos (st3.code-len)
   in let st5 = st-append-code st4 (cmp-ri reg-rax wd-tier2-threshold)
   in let tier2-skip-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ne 0)
   in let st7 = emit-call-to st6 "__watchdog_tier2"
   in let st8 = patch-jcc-at st7 tier2-skip-pos (st7.code-len)
   in let st9 = st-append-code st8 (cmp-ri reg-rax wd-stale-threshold-progress)
   in let tier3-skip-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-b 0)
   in let st11 = emit-call-to st10 "__watchdog_panic"
   in patch-jcc-at st11 tier3-skip-pos (st11.code-len)

  emit-watchdog-pet-dispatch : CodegenState -> CodegenState
  emit-watchdog-pet-dispatch (st) =
   let st1 = st-append-code st (cmp-ri reg-rax wd-stale-threshold-pet)
   in let skip-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-b 0)
   in let st3 = emit-call-to st2 "__watchdog_panic"
   in patch-jcc-at st3 skip-pos (st3.code-len)

  emit-watchdog-timer-check : CodegenState -> CodegenState
  emit-watchdog-timer-check (st) =
   let st0 = st-append-code st (mov-load reg-rcx reg-rsp 40)
   in let st2 = st-append-code st0 (li reg-rdi wd-last-heap-addr)
   in let st3 = st-append-code st2 (mov-load reg-rdx reg-rdi 0)
   in let st4 = st-append-code st3 (cmp-rr reg-r10 reg-rdx)
   in let heap-same-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-e 0)
   in let st6 = st-append-code st5 (mov-store reg-rdi reg-r10 0)
   in let st7 = st-append-code st6 (li reg-rdi wd-last-rip-addr)
   in let st8 = st-append-code st7 (mov-store reg-rdi reg-rcx 0)
   in let st9 = st-append-code st8 (li reg-rdi wd-stale-tick-addr)
   in let st10 = st-append-code st9 (li reg-rax 0)
   in let st11 = st-append-code st10 (mov-store reg-rdi reg-rax 0)
   in let doneA-pos = st11.code-len
   in let st12 = st-append-code st11 (jmp 0)
   in let st13 = patch-jcc-at st12 heap-same-pos (st12.code-len)
   in let st14 = st-append-code st13 (li reg-rdi wd-last-rip-addr)
   in let st15 = st-append-code st14 (mov-load reg-rdx reg-rdi 0)
   in let st16 = st-append-code st15 (mov-rr reg-rax reg-rcx)
   in let st17 = st-append-code st16 (sub-rr reg-rax reg-rdx)
   in let st18 = st-append-code st17 (mov-rr reg-rdx reg-rax)
   in let st19 = st-append-code st18 (sar-ri reg-rdx 63)
   in let st20 = st-append-code st19 (xor-rr reg-rax reg-rdx)
   in let st21 = st-append-code st20 (sub-rr reg-rax reg-rdx)
   in let st22 = st-append-code st21 (cmp-ri reg-rax 4096)
   in let rip-same-pos = st22.code-len
   in let st23 = st-append-code st22 (jcc cc-be 0)
   in let st24 = st-append-code st23 (mov-store reg-rdi reg-rcx 0)
   in let st25 = st-append-code st24 (li reg-rdi wd-stale-tick-addr)
   in let st26 = st-append-code st25 (li reg-rax 0)
   in let st27 = st-append-code st26 (mov-store reg-rdi reg-rax 0)
   in let doneB-pos = st27.code-len
   in let st28 = st-append-code st27 (jmp 0)
   in let st29 = patch-jcc-at st28 rip-same-pos (st28.code-len)
   in let st-ring = emit-watchdog-ring-write st29
   in let st30 = st-append-code st-ring (li reg-rdi wd-stale-tick-addr)
   in let st31 = st-append-code st30 (mov-load reg-rax reg-rdi 0)
   in let st32 = st-append-code st31 (add-ri reg-rax 1)
   in let st33 = st-append-code st32 (mov-store reg-rdi reg-rax 0)
   in let st-dispatch = when st33.watchdog-mode
     is WatchdogPet -> emit-watchdog-pet-dispatch st33
     is otherwise -> emit-watchdog-progress-dispatch st33
   in let st-final1 = patch-jmp-at st-dispatch doneA-pos (st-dispatch.code-len)
   in patch-jmp-at st-final1 doneB-pos (st-final1.code-len)

Section: Page Fault Handler

 Demand paging. Heap-range page-directory entries boot not-present; the
 first touch of a 2 MB page raises #PF (vector 14). This handler maps
 the identity 2 MB frame and resumes the faulting instruction. Only a
 not-present fault may grow: the vector-14 stub preserves the CPU error
 code, and a fault with the present bit set (a protection or
 reserved-bit violation) is a real bug, so the handler normalizes the
 frame and falls through to the exception dump. Normalizing restores
 RAX to 14 as its last act, because the dump reports the vector from
 live RAX and this handler has already spent that register: the
 error-code test leaves it holding the present bit, and the range
 tests leave it holding CR2 shifted down by 21. Without the restore
 every page fault reaching the dump announces itself as vector 00 or
 01, and the host report then names it a divide error and suppresses
 CR2, which it shows for vector 14 alone. That is the one field a
 page fault is worth reading, and it was suppressed by the report's
 own correctness check. The mapped entry
 carries NX (bit 63) because everything above the code boundary was NX
 in the boot mapping and demand pages must match. Each mapping
 increments the touched-page counter, the honest physical-consumption
 metric (the R10 high-water mark reports floor reservations). Invariant:
 a stack must never point into a not-present page, because the CPU
 cannot deliver the #PF frame onto the faulting stack (double fault).
 The boot stack lives above the demand range; spawned processes carve
 their stacks from the heap, so every spawn helper pre-touches its
 stack pages before the child runs.

 The guard page is the 2 MB page immediately below the boot stack's reserve,
 at index (ram-pages - demand-stack-reserve-pages - 1), left unmapped so that
 any of the 58 inline frontier bumps across the emitters faults on first touch
 instead of writing over the stack. It is tested BEFORE the lo/hi range tests
 and not after: at 3 GB the guard index is 1487, which is above
 demand-heap-hi-page, so the range test would send it to the exception dump and
 the arm below would never run. Placing it after the range tests leaves a guard
 that works only on small-RAM configurations, which is the configuration nobody
 runs.

 It routes to __out_of_memory rather than to the dump because the dump prints
 from the current stack, and the case this exists to catch is the stack having
 just been written over. __out_of_memory reloads RSP from ram-size-addr before
 printing, so it survives that.

 The stack case is not symmetric: a stack that grows DOWN into the guard page
 cannot take a #PF at all, because the CPU cannot deliver the fault frame onto
 the faulting stack. That is a double fault, delivered on the TSS IST1 stack,
 and it produces an !EXC dump rather than the OUT OF MEMORY line.

  demand-heap-lo-page : Integer = 6291456 / 2097152

  demand-heap-hi-page : Integer = 2147483648 / 2097152

  demand-fault-count-addr : Integer = 30688
  serial-primed-magic-addr : Integer = 30696
  serial-primed-magic : Integer = 1347573316

  emit-pagefault-handler : CodegenState -> CodegenState
  emit-pagefault-handler (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 14)
   in let j-notpf = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let ec0 = st-append-code st2 (mov-load reg-rax reg-rsp 40)
   in let ec1 = st-append-code ec0 (and-ri reg-rax 1)
   in let j-prot = ec1.code-len
   in let ec2 = st-append-code ec1 (jcc cc-ne 0)
   in let st3 = st-append-code ec2 [15, 32, 208]
   in let st4 = st-append-code st3 (mov-rr reg-rcx reg-rax)
   in let st5 = st-append-code st4 (shr-ri reg-rax 21)
   in let gp0 = st-append-code st5 (li reg-rdi ram-size-addr)
   in let gp1 = st-append-code gp0 (mov-load reg-rdx reg-rdi 0)
   in let gp2 = st-append-code gp1 (shr-ri reg-rdx 21)
   in let gp3 = st-append-code gp2 (sub-ri reg-rdx (demand-stack-reserve-pages + 1))
   in let gp4 = st-append-code gp3 (cmp-rr reg-rax reg-rdx)
   in let gp-pos = gp4.code-len
   in let gp5 = st-append-code gp4 (jcc cc-e 0)
   in let gp6 = __record-set gp5 "stack-overflow-checks" (list-push (gp5.stack-overflow-checks) gp-pos)
   in let st6 = st-append-code gp6 (cmp-ri reg-rax demand-heap-lo-page)
   in let j-lo = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-b 0)
   in let st8 = st-append-code st7 (cmp-ri reg-rax demand-heap-hi-page)
   in let j-hi = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ae 0)
   in let st10 = st-append-code st9 (shl-ri reg-rax 3)
   in let st11 = st-append-code st10 (add-ri reg-rax (32768 + 8192))
   in let st12 = st-append-code st11 (mov-rr reg-rdx reg-rax)
   in let st13 = st-append-code st12 (shr-ri reg-rcx 21)
   in let st14 = st-append-code st13 (shl-ri reg-rcx 21)
   in let st15 = st-append-code st14 (li reg-rax 131)
   in let st16 = st-append-code st15 (or-rr reg-rcx reg-rax)
   in let nx0 = st-append-code st16 (li reg-rax 1)
   in let nx1 = st-append-code nx0 (shl-ri reg-rax 63)
   in let nx2 = st-append-code nx1 (or-rr reg-rcx reg-rax)
   in let st20 = st-append-code nx2 (mov-store reg-rdx reg-rcx 0)
   in let ct0 = st-append-code st20 (li reg-rdx demand-fault-count-addr)
   in let ct1 = st-append-code ct0 (mov-load reg-rax reg-rdx 0)
   in let ct2 = st-append-code ct1 (add-ri reg-rax 1)
   in let ct3 = st-append-code ct2 (mov-store reg-rdx reg-rax 0)
   in let st21 = st-append-code ct3 [15, 32, 208]
   in let st22 = st-append-code st21 [15, 1, 56]
   in let st23 = st-append-code st22 (pop-r reg-rdi)
   in let st24 = st-append-code st23 (pop-r reg-rsi)
   in let st25 = st-append-code st24 (pop-r reg-rdx)
   in let st26 = st-append-code st25 (pop-r reg-rcx)
   in let st27 = st-append-code st26 (pop-r reg-rax)
   in let st27a = st-append-code st27 (add-ri reg-rsp 8)
   in let st28 = st-append-code st27a iretq
   in let fix-pos = st28.code-len
   in let fx1 = st-append-code st28 (mov-load reg-rax reg-rsp 32)
   in let fx2 = st-append-code fx1 (mov-store reg-rsp reg-rax 40)
   in let fx3 = st-append-code fx2 (mov-load reg-rax reg-rsp 24)
   in let fx4 = st-append-code fx3 (mov-store reg-rsp reg-rax 32)
   in let fx5 = st-append-code fx4 (mov-load reg-rax reg-rsp 16)
   in let fx6 = st-append-code fx5 (mov-store reg-rsp reg-rax 24)
   in let fx7 = st-append-code fx6 (mov-load reg-rax reg-rsp 8)
   in let fx8 = st-append-code fx7 (mov-store reg-rsp reg-rax 16)
   in let fx9 = st-append-code fx8 (mov-load reg-rax reg-rsp 0)
   in let fx10 = st-append-code fx9 (mov-store reg-rsp reg-rax 8)
   in let fx11 = st-append-code fx10 (add-ri reg-rsp 8)
   in let fx12 = st-append-code fx11 (li reg-rax 14)
   in let dump-pos = fx12.code-len
   in let st29 = patch-jcc-at fx12 j-notpf dump-pos
   in let st30 = patch-jcc-at st29 j-prot fix-pos
   in let st31 = patch-jcc-at st30 j-lo fix-pos
   in patch-jcc-at st31 j-hi fix-pos

 Boot-time unmap of the demand range. Clears the runtime PD entries for
 heap pages [demand-heap-lo-page, top) so the first touch of each 2 MB
 page faults into the handler above. The top is computed from the
 actual RAM size the host wrote to the ram-size cell, capped at
 demand-heap-hi-page, minus a 32-page (64 MB) reserve that keeps the
 top of RAM present for the boot stack -- the stack must never point
 into a not-present page. With 3 GB of RAM the computed top equals the
 cap and behavior is unchanged; with 2 GB or less the reserve is what
 makes the machine bootable at all. If the reserve consumes the whole
 range (tiny RAM), nothing is cleared and the arena stays flat.

  demand-stack-reserve-pages : Integer = 32

  emit-demand-unmap : CodegenState -> CodegenState
  emit-demand-unmap (st) =
   let up0a = st-append-code st (li reg-rdi ram-size-addr)
   in let up0b = st-append-code up0a (mov-load reg-rcx reg-rdi 0)
   in let up0c = st-append-code up0b (shr-ri reg-rcx 21)
   in let up0d = st-append-code up0c (sub-ri reg-rcx demand-stack-reserve-pages)
   in let up0e = st-append-code up0d (cmp-ri reg-rcx demand-heap-hi-page)
   in let j-nocap = up0e.code-len
   in let up0f = st-append-code up0e (jcc cc-le 0)
   in let up0g = st-append-code up0f (li reg-rcx demand-heap-hi-page)
   in let nocap-pos = up0g.code-len
   in let up0h = patch-jcc-at up0g j-nocap nocap-pos
   in let up0i = st-append-code up0h (sub-ri reg-rcx demand-heap-lo-page)
   in let up0j = st-append-code up0i (cmp-ri reg-rcx 0)
   in let j-empty = up0j.code-len
   in let up0k = st-append-code up0j (jcc cc-le 0)
   in let up0 = st-append-code up0k (li reg-rdi (32768 + 8192 + demand-heap-lo-page * 8))
   in let up2 = st-append-code up0 (li reg-rax 0)
   in let up-top = up2.code-len
   in let up3 = st-append-code up2 (mov-store reg-rdi reg-rax 0)
   in let up4 = st-append-code up3 (add-ri reg-rdi 8)
   in let up5 = st-append-code up4 (sub-ri reg-rcx 1)
   in let up-cur = up5.code-len
   in let up6 = st-append-code up5 (jcc cc-ne (up-top - (up-cur + 6)))
   in let up7 = patch-jcc-at up6 j-empty (up6.code-len)
   in let g0 = st-append-code up7 (li reg-rdi ram-size-addr)
   in let g1 = st-append-code g0 (mov-load reg-rcx reg-rdi 0)
   in let g2 = st-append-code g1 (shr-ri reg-rcx 21)
   in let g3 = st-append-code g2 (sub-ri reg-rcx (demand-stack-reserve-pages + 1))
   in let gb0 = st-append-code g3 (mov-rr reg-rax reg-rcx)
   in let gb1 = st-append-code gb0 (shl-ri reg-rax 21)
   in let gb2 = st-append-code gb1 (li reg-rdi guard-page-base-addr)
   in let gb3 = st-append-code gb2 (mov-store reg-rdi reg-rax 0)
   in let g4 = st-append-code gb3 (shl-ri reg-rcx 3)
   in let g5 = st-append-code g4 (add-ri reg-rcx (32768 + 8192))
   in let g6 = st-append-code g5 (li reg-rax 0)
   in st-append-code g6 (mov-store reg-rcx reg-rax 0)

 Spawn-stack pre-touch. A spawned process carves its stack from the
 parent's heap frontier, inside the demand range; the child's first
 push must not fault, so the parent touches every 2 MB page the stack
 spans before the child runs. The touch points unroll at emit time
 from the stack size, so growing proc-spawn-stack-size past 2 MB
 cannot silently skip the middle pages. Expects RSI = stack top;
 clobbers RAX.

  emit-spawn-stack-pretouch : CodegenState -> CodegenState
  emit-spawn-stack-pretouch (st) =
   emit-spawn-pretouch-at st 8

  emit-spawn-pretouch-at : CodegenState, Integer -> CodegenState
  emit-spawn-pretouch-at (st) (off) =
   if off >= proc-spawn-stack-size - 16
   then let s1 = st-append-code st (mov-rr reg-rax reg-rsi)
    in let s2 = st-append-code s1 (sub-ri reg-rax (proc-spawn-stack-size - 16))
    in st-append-code s2 (mov-store reg-rax reg-rax 0)
   else let s1 = st-append-code st (mov-rr reg-rax reg-rsi)
    in let s2 = st-append-code s1 (sub-ri reg-rax off)
    in let s3 = st-append-code s2 (mov-store reg-rax reg-rax 0)
    in emit-spawn-pretouch-at s3 (off + 2097152)

Section: Which Process Is Running

 The running process is a function of the stack pointer. It is not
 stored anywhere.

 Every spawned process runs on a stack inside its own slot-indexed
 region -- spawn-pool-base + slot * spawn-slot-region-size -- so the
 slot index is recoverable from a stack address by arithmetic alone:
 subtract the pool base, and the region shift is the slot. An address
 outside the pool belongs to proc 0, the program the machine booted,
 whose stack is the boot stack at the top of RAM.

 emit-load-current-proc reads it from the live RSP. emit-slot-from-addr
 takes an address already in the destination register -- the interrupt
 handler needs the INTERRUPTED stack pointer, off the interrupt frame,
 not the one it is running the handler on.

 Clobbers the destination register and nothing else.

  emit-load-current-proc : CodegenState, Integer -> CodegenState
  emit-load-current-proc (st) (dest) =
   let st1 = st-append-code st (mov-rr dest reg-rsp)
   in emit-slot-from-addr st1 dest

  emit-slot-from-addr : CodegenState, Integer -> CodegenState
  emit-slot-from-addr (st) (dest) =
   let st1 = st-append-code st (sub-ri dest spawn-pool-base)
   in let st2 = st-append-code st1 (cmp-ri dest spawn-pool-span)
   in let outside-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ae 0)
   in let st4 = st-append-code st3 (shr-ri dest spawn-slot-region-shift)
   in let done-pos = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let zero-pos = st5.code-len
   in let st6 = st-append-code st5 (xor-rr dest dest)
   in let st7 = patch-jcc-at st6 outside-pos zero-pos
   in patch-jmp-at st7 done-pos (st7.code-len)

Section: Common Interrupt Handler

 Preemption claims first and publishes second, for the reason set out over
 process-yield in X86_64ProcessHelpers: a process a core is standing in
 must never be advertised as READY, or an application processor will claim
 it and both cores will run it. So the interrupted process is left RUNNING
 across the scan, and is marked READY only once a replacement has actually
 been won with a CMPXCHG. Losing that race is not an error -- it means
 another core took the candidate -- and the handler simply keeps running
 what it interrupted for another tick.

 The publish is itself a CMPXCHG, RUNNING -> READY, and not a plain store.
 The scan sits below the max-ticks check, which may have already marked
 this process a ZOMBIE; a plain store would resurrect it.

 A trap worth naming, because it cost a hang: RCX holds &proc[current] for
 the context save, and then the STARVE CHECK CLOBBERS IT (sv1 loads the
 starve counter into RCX). Anything below that point which wants
 &proc[current] must rebuild it from RDI, which does survive -- the
 original code reloaded it for exactly this reason, and reusing the stale
 RCX writes the state word to whatever the starve counter happened to be.

 Two clocks arrive here, not one. Vector 32 is the PIT, which is delivered
 to the boot processor alone; vector 48 is an application processor's own
 local APIC timer. They run the same scheduling path -- the path was always
 per-core-safe, deriving the running process from the interrupted stack
 pointer and claiming its replacement with a CMPXCHG -- and they differ only
 in which chip is told the interrupt is over. See emit-timer-eoi.

 The tick count is incremented with a LOCKED add, because it is no longer
 the boot processor alone that increments it. A plain load-add-store from
 several cores loses ticks: two cores read the same value and both write
 back one more than it, and the clock silently runs slow.

 A core with no work parks on its own idle stack in __idle_dispatch with
 its timer armed, so a tick can arrive while it is standing on no process.
 emit-slot-from-addr answers slot 0 for any address outside the spawn pool,
 and an idle stack is one such address -- so the handler would take the
 idle core for proc 0 and preempt the booted program out from under the
 boot processor. The guard is a band check on the interrupted stack pointer
 before any process is touched: an RSP inside [ap-stacks-base, ap-stacks-base
 + smp-max-cores * ap-stack-size) belongs to an idle stack, so the handler
 acknowledges the clock and returns without scheduling. Proc 0's own boot
 stack is far above this band, so a genuine tick on proc 0 is unaffected.

 A second guard, and it closes a real deadlock. A process exiting runs
 process-exit ON ITS OWN STACK: it marks its slot FREE and then walks a wake
 loop marking every waiter that blocked on it READY. It is still executing,
 with interrupts on, so a timer tick can land between the FREE store and the
 end of the wake loop. Without a guard the handler derives the running slot
 from the interrupted stack pointer -- the exiting process -- saves its
 context, fails to publish it (the RUNNING->READY cmpxchg does not match a
 FREE slot) and switches to a replacement, ABANDONING the wake loop. Any
 waiter it had not yet reached is never woken and blocks forever. This is a
 lost-wakeup deadlock that showed as a rare hang of a parent waiting on many
 children, and it is timing-sensitive enough that adding a
 single host thread hid it. So: if the running slot is already FREE, the
 process is mid-exit and there is nothing to preempt -- acknowledge the clock
 and return, and let it finish its wake loop.

 A third guard, in the candidate scans themselves: slot 0 is the booted
 program, it owns the boot stack and the main heap, and only the boot
 processor may run it. __idle_dispatch already refuses it to an application
 processor by starting each core's scan at its own id, but the preempt scan
 walks every slot from 0 for every core -- so an AP whose current process is
 preemptible could preempt-CLAIM slot 0 the moment proc 0 goes READY (a
 parent woken by a child's exit) and strand it RUNNING-but-frozen on a core
 that is not its own. Both scans (priority-preference and starvation-relief)
 therefore skip slot 0 when the claiming core's id is not zero, so a
 non-zero core never selects proc 0 as a preemption target and proc 0 stays
 the boot processor's to schedule.

  emit-common-interrupt-handler : CodegenState -> CodegenState
  emit-common-interrupt-handler (st) =
   let st-rec = record-func-offset st "__interrupt_common"
   in let st1 = st-append-code st-rec (push-r reg-rcx)
   in let st2 = st-append-code st1 (push-r reg-rdx)
   in let st3 = st-append-code st2 (push-r reg-rsi)
   in let st4 = st-append-code st3 (push-r reg-rdi)
   in let st5 = st-append-code st4 [15, 182, 192]
   in let st6 = st-append-code st5 (cmp-ri reg-rax 32)
   in let exc-jcc = st6.code-len
   in let st6a = st-append-code st6 (jcc cc-b 0)
   in let is-timer = st6a.code-len
   in let st6b = st-append-code st6a (jcc cc-e 0)
   in let st6c = st-append-code st6b (cmp-ri reg-rax lapic-timer-vector)
   in let not-timer = st6c.code-len
   in let st7 = st-append-code st6c (jcc cc-ne 0)
   in let st7t = patch-jcc-at st7 is-timer (st7.code-len)
   in let st8 = st-append-code st7t (li reg-rdi tick-count-addr)
   in let st9 = st-append-code st8 (li reg-rsi 1)
   in let st11 = st-append-code st9 (lock-xadd-mem reg-rsi reg-rdi 0)
   in let pr0 = st-append-code st11 (li reg-rdi prof-enabled-addr)
   in let pr1 = st-append-code pr0 (mov-load reg-rdi reg-rdi 0)
   in let pr2 = st-append-code pr1 (test-rr reg-rdi reg-rdi)
   in let prof-skip = pr2.code-len
   in let pr3 = st-append-code pr2 (jcc cc-e 0)
   in let pr4 = st-append-code pr3 (li reg-rdi prof-cursor-addr)
   in let pr5 = st-append-code pr4 (mov-load reg-rsi reg-rdi 0)
   in let pr6 = st-append-code pr5 (cmp-ri reg-rsi prof-max-samples)
   in let prof-full = pr6.code-len
   in let pr7 = st-append-code pr6 (jcc cc-ge 0)
   in let pr8 = st-append-code pr7 (mov-load reg-rcx reg-rsp 40)
   in let pr9 = st-append-code pr8 (li reg-rdx prof-buf-addr)
   in let pr10 = st-append-code pr9 (mov-rr reg-rax reg-rsi)
   in let pr11 = st-append-code pr10 (shl-ri reg-rax 3)
   in let pr12 = st-append-code pr11 (add-rr reg-rdx reg-rax)
   in let pr13 = st-append-code pr12 (mov-store reg-rdx reg-rcx 0)
   in let pr14 = st-append-code pr13 (add-ri reg-rsi 1)
   in let pr15 = st-append-code pr14 (mov-store reg-rdi reg-rsi 0)
   in let pr16 = patch-jcc-at pr15 prof-skip (pr15.code-len)
   in let pr17 = patch-jcc-at pr16 prof-full (pr16.code-len)
   in let st11-wd = emit-watchdog-timer-check pr17
   in let st11-y0 = st-append-code st11-wd (li reg-rdi sched-current-task-addr)
   in let st11-y1 = st-append-code st11-y0 (mov-load reg-rdi reg-rdi 0)
   in let st11-y2 = st-append-code st11-y1 (cmp-ri reg-rdi 0)
   in let yf-skip = st11-y2.code-len
   in let st11-y3 = st-append-code st11-y2 (jcc cc-e 0)
   in let st11-y4 = st-append-code st11-y3 (li reg-rdi sched-yield-flag-addr)
   in let st11-y5 = st-append-code st11-y4 (li reg-rsi 1)
   in let st11-y6 = st-append-code st11-y5 (mov-store reg-rdi reg-rsi 0)
   in let st11-y7 = patch-jcc-at st11-y6 yf-skip (st11-y6.code-len)
   in let sp0 = st-append-code st11-y7 (mov-load reg-rdi reg-rsp 64)
   in let ig0 = st-append-code sp0 (mov-rr reg-rax reg-rdi)
   in let ig1 = st-append-code ig0 (sub-ri reg-rax ap-stacks-base)
   in let ig2 = st-append-code ig1 (cmp-ri reg-rax (smp-max-cores * ap-stack-size))
   in let idle-skip-pos = ig2.code-len
   in let ig3 = st-append-code ig2 (jcc cc-b 0)
   in let sp1 = emit-slot-from-addr ig3 reg-rdi
   in let sp2 = st-append-code sp1 (mov-rr reg-rcx reg-rdi)
   in let sp3 = st-append-code sp2 (shl-ri reg-rcx 8)
   in let sp4 = st-append-code sp3 (add-ri reg-rcx proc-table-base)
   in let sp4p = emit-ap-preempt-count sp4
   in let fg0 = st-append-code sp4p (mov-load reg-rsi reg-rcx 0)
   in let fg1 = st-append-code fg0 (cmp-ri reg-rsi proc-state-free)
   in let free-skip = fg1.code-len
   in let fg2 = st-append-code fg1 (jcc cc-e 0)
   in let sp5 = st-append-code fg2 (mov-load reg-rsi reg-rcx proc-slice-offset)
   in let sp6 = st-append-code sp5 (test-rr reg-rsi reg-rsi)
   in let no-pre1 = sp6.code-len
   in let sp7 = st-append-code sp6 (jcc cc-e 0)
   in let sp8 = st-append-code sp7 (sub-ri reg-rsi 1)
   in let sp9 = st-append-code sp8 (mov-store reg-rcx reg-rsi proc-slice-offset)
   in let sp10 = st-append-code sp9 (test-rr reg-rsi reg-rsi)
   in let no-pre2 = sp10.code-len
   in let sp11 = st-append-code sp10 (jcc cc-ne 0)
   in let sp12 = st-append-code sp11 (mov-store reg-rcx reg-rbx proc-saved-rbx-offset)
   in let sp13 = st-append-code sp12 (mov-store reg-rcx reg-rbp proc-saved-rbp-offset)
   in let sp14 = st-append-code sp13 (mov-store reg-rcx reg-r8 proc-saved-r8-offset)
   in let sp15 = st-append-code sp14 (mov-store reg-rcx reg-r9 proc-saved-r9-offset)
   in let sp16 = st-append-code sp15 (mov-store reg-rcx reg-r10 proc-saved-r10-offset)
   in let sp17 = st-append-code sp16 (mov-store reg-rcx reg-r11 proc-saved-r11-offset)
   in let sp18 = st-append-code sp17 (mov-store reg-rcx reg-r12 proc-saved-r12-offset)
   in let sp19 = st-append-code sp18 (mov-store reg-rcx reg-r13 proc-saved-r13-offset)
   in let sp20 = st-append-code sp19 (mov-store reg-rcx reg-r14 proc-saved-r14-offset)
   in let sp21 = st-append-code sp20 (mov-store reg-rcx reg-r15 proc-saved-r15-offset)
   in let sp22 = st-append-code sp21 (mov-load reg-rsi reg-rsp 0)
   in let sp23 = st-append-code sp22 (mov-store reg-rcx reg-rsi proc-saved-rdi-offset)
   in let sp24 = st-append-code sp23 (mov-load reg-rsi reg-rsp 8)
   in let sp25 = st-append-code sp24 (mov-store reg-rcx reg-rsi proc-saved-rsi-offset)
   in let sp26 = st-append-code sp25 (mov-load reg-rsi reg-rsp 16)
   in let sp27 = st-append-code sp26 (mov-store reg-rcx reg-rsi proc-saved-rdx-offset)
   in let sp28 = st-append-code sp27 (mov-load reg-rsi reg-rsp 24)
   in let sp29 = st-append-code sp28 (mov-store reg-rcx reg-rsi proc-saved-rcx-offset)
   in let sp30 = st-append-code sp29 (mov-load reg-rsi reg-rsp 32)
   in let sp31 = st-append-code sp30 (mov-store reg-rcx reg-rsi proc-saved-rax-offset)
   in let sp32 = st-append-code sp31 (mov-load reg-rsi reg-rsp 40)
   in let sp33 = st-append-code sp32 (mov-store reg-rcx reg-rsi proc-saved-rip-offset)
   in let sp34 = st-append-code sp33 (mov-load reg-rsi reg-rsp 56)
   in let sp35 = st-append-code sp34 (mov-store reg-rcx reg-rsi proc-saved-rflags-offset)
   in let sp36 = st-append-code sp35 (mov-load reg-rsi reg-rsp 64)
   in let sp37 = st-append-code sp36 (mov-store reg-rcx reg-rsi proc-saved-rsp-offset)
   in let sq0 = st-append-code sp37 (mov-load reg-rsi reg-rcx proc-max-ticks-offset)
   in let sq1 = st-append-code sq0 (test-rr reg-rsi reg-rsi)
   in let sq-unlim = sq1.code-len
   in let sq2 = st-append-code sq1 (jcc cc-e 0)
   in let sq3 = st-append-code sq2 (sub-ri reg-rsi 1)
   in let sq4 = st-append-code sq3 (mov-store reg-rcx reg-rsi proc-max-ticks-offset)
