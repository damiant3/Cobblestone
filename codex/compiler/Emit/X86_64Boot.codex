Section: ISR Stubs
  IsrStubResult = record {
   state : CodegenState,
   first-stub-vaddr : Integer between 0 and 4294967295
  }

  has-error-code : Integer -> Boolean
  has-error-code (vec) =
   if vec == 8 then True
   else if vec == 10 then True
   else if vec == 11 then True
   else if vec == 12 then True
   else if vec == 13 then True
   else if vec == 14 then True
   else if vec == 17 then True
   else if vec == 21 then True
   else if vec == 29 then True
   else if vec == 30 then True
   else False

  emit-isr-stub : CodegenState, Integer, Integer -> CodegenState
  emit-isr-stub (st) (vec) (common-handler-offset) =
   let st1 = if vec == 14 then st-append-code st [15, 31, 64, 0]
             else if has-error-code vec then st-append-code st (add-ri reg-rsp 8)
             else st-append-code st [15, 31, 64, 0]
   in let st2 = st-append-code st1 (push-r reg-rax)
   in let st3 = st-append-code st2 [176, vec]
   in let rel = common-handler-offset - (st3.code-len + 5)
   in st-append-code st3 (jmp rel)

  emit-isr-stubs-loop : CodegenState, Integer, Integer -> CodegenState
  emit-isr-stubs-loop (st) (vec) (common-handler-offset) =
   if vec == 256 then st
   else emit-isr-stubs-loop (emit-isr-stub st vec common-handler-offset) (vec + 1) common-handler-offset

  emit-isr-stubs : CodegenState -> IsrStubResult
  emit-isr-stubs (st) =
   let common-handler-offset = st.code-len
   in let st1 = emit-common-interrupt-handler st
   in let first-stub-offset = st1.code-len
   in let st1r = record-func-offset st1 "__isr_stubs"
   in let st2 = emit-isr-stubs-loop st1r 0 common-handler-offset
   in IsrStubResult {
    state = st2,
    first-stub-vaddr = __narrow (bare-metal-load-addr + first-stub-offset)
  }

Section: IDT Construction
  emit-idt-entries : CodegenState, Integer -> CodegenState
  emit-idt-entries (st) (first-stub-vaddr) =
   let st1 = st-append-code st (li reg-rcx 256)
   in let st2 = st-append-code st1 (li reg-rdi idt-base)
   in let st3 = st-append-code st2 (li reg-rsi first-stub-vaddr)
   in let loop-top = st3.code-len
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-rsi)
   in let st5 = st-append-code st4 (and-ri reg-rax 65535)
   in let st6 = st-append-code st5 (add-ri reg-rax 524288)
   in let st7 = st-append-code st6 (mov-store reg-rdi reg-rax 0)
   in let st8 = st-append-code st7 (mov-rr reg-rax reg-rsi)
   in let st9 = st-append-code st8 (shr-ri reg-rax 16)
   in let st10 = st-append-code st9 (shl-ri reg-rax 16)
   in let st11 = st-append-code st10 (add-ri reg-rax 36352)
   in let st12 = st-append-code st11 (mov-store reg-rdi reg-rax 4)
   in let st13 = st-append-code st12 (li reg-rax 0)
   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rax 8)
   in let st15 = st-append-code st14 (add-ri reg-rdi 16)
   in let st16 = st-append-code st15 (add-ri reg-rsi 12)
   in let st17 = st-append-code st16 (sub-ri reg-rcx 1)
   in let jcc-pos = st17.code-len
   in let st18 = st-append-code st17 (jcc cc-ne 0)
   in patch-jcc-at st18 jcc-pos loop-top

Section: Interrupt Setup
  emit-load-idt : CodegenState -> CodegenState
  emit-load-idt (st) =
   let st2 = st-append-code st (sub-ri reg-rsp 16)
   in let idtr-low = int-mod (256 * 16 - 1) 65536 + idt-base * 65536
   in let st3 = st-append-code st2 (li reg-rax idtr-low)
   in let st4 = st-append-code st3 (mov-store reg-rsp reg-rax 0)
   in let st5 = st-append-code st4 (li reg-rax 0)
   in let st6 = st-append-code st5 (mov-store reg-rsp reg-rax 8)
   in let st7 = st-append-code st6 (mov-rr reg-rdi reg-rsp)
   in let st8 = st-append-code st7 lidt-rdi
   in st-append-code st8 (add-ri reg-rsp 16)

 A double fault on a bad stack is a silent triple fault unless the CPU
 has a known-good emergency stack to deliver it on. This installs a
 64-bit TSS whose IST1 points at a small always-present low-memory
 stack, loads a runtime GDT that carries the TSS descriptor alongside
 the same code and data descriptors the trampoline GDT established,
 and marks IDT entry 8 with IST1. Every stack-invariant violation (a
 push into a not-present demand page) then produces the standard
 exception dump instead of a hang.

 The task register is per-core, and so a TSS cannot be shared: two cores
 loading one TSS would fight over its busy bit and hand each other the
 same emergency stack. The GDT therefore carries one TSS descriptor per
 core, the TSS array holds one aligned entry per core, and each core's
 IST1 points at a stack of its own. A core's descriptor sits at selector
 gdt-tss-sel-base + core * 16, which is the number the boot processor and
 each application processor load into their own task register.

  gdt64-base : Integer = 75776

  tss-base : Integer = 77824

  tss-stride : Integer = 128

  gdt-tss-sel-base : Integer = 24

  gdt64-limit : Integer = 279

 Sixteen 2 KB emergency stacks in always-present low memory, spanning
 [0x15000, 0x1D000) -- clear of the GDT and TSS array below and of the AP
 idle stacks at 0x20000 above. A core's IST1 is the TOP of its stack, so
 core i takes the region ending at ist-stacks-base + (i + 1) * ist-stack-size.

  ist-stacks-base : Integer = 86016

  ist-stack-size : Integer = 2048

 Each core reads its task register back with str, after loading it, and
 stores what the CPU actually accepted here -- eight bytes per core, just
 above the TSS array. A descriptor the processor rejects and one it takes
 are indistinguishable from the outside, and a core whose TR is zero has
 no emergency stack and will still vanish on a double fault. This is what
 lets a test assert the thing that matters rather than the thing that was
 written down. Read by codex/test/smp-tss.codex.

  ap-tr-report-addr : Integer = 79872

 The single emergency stack the UEFI runtime-init path installs. That path
 builds its own one-TSS GDT at the same base and is single-core, so it
 keeps the old arrangement; the two never coexist.

  df-ist-stack-top : Integer = 83968

 The TSS descriptor for a core, as a 64-bit GDT entry: limit 103, the
 base split across bits 16-39 and 56-63, and access byte 0x89 (present,
 available 64-bit TSS). The high half of the descriptor is zero for every
 address we place a TSS at.

  tss-desc-low : Integer -> Integer
  tss-desc-low (i) =
   let base = tss-base + i * tss-stride
   in 103
    + bit-and base 65535 * 65536
    + bit-and (bit-shru base 16) 255 * 4294967296
    + 137 * 1099511627776
    + bit-and (bit-shru base 24) 255 * 72057594037927936

  emit-tss-descriptors : CodegenState, Integer -> CodegenState
  emit-tss-descriptors (st) (i) =
   if i >= smp-max-cores then st
   else let st1 = st-append-code st (li reg-rax (tss-desc-low i))
   in let st2 = st-append-code st1 (mov-store reg-rdi reg-rax (gdt-tss-sel-base + i * 16))
   in let st3 = st-append-code st2 (li reg-rax 0)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-rax (gdt-tss-sel-base + i * 16 + 8))
   in emit-tss-descriptors st4 (i + 1)

  emit-tss-ists : CodegenState, Integer -> CodegenState
  emit-tss-ists (st) (i) =
   if i >= smp-max-cores then st
   else let st1 = st-append-code st (li reg-rdi (tss-base + i * tss-stride))
   in let st2 = st-append-code st1 (li reg-rax (ist-stacks-base + (i + 1) * ist-stack-size))
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 36)
   in emit-tss-ists st3 (i + 1)

  emit-load-tss : CodegenState -> CodegenState
  emit-load-tss (st) =
   let g0 = st-append-code st (li reg-rdi gdt64-base)
   in let g1 = st-append-code g0 (li reg-rax 0)
   in let g2 = st-append-code g1 (mov-store reg-rdi reg-rax 0)
   in let g3 = st-append-code g2 (li reg-rax #00AF9A000000FFFF)
   in let g4 = st-append-code g3 (mov-store reg-rdi reg-rax 8)
   in let g5 = st-append-code g4 (li reg-rax #00CF92000000FFFF)
   in let g6 = st-append-code g5 (mov-store reg-rdi reg-rax 16)
   in let gd = emit-tss-descriptors g6 0
   in let t0 = emit-zero-region gd tss-base (smp-max-cores * tss-stride / 8)
   in let tz = emit-zero-region t0 ap-tr-report-addr smp-max-cores
   in let t3 = emit-tss-ists tz 0
   in let r0 = st-append-code t3 (sub-ri reg-rsp 16)
   in let r1 = st-append-code r0 (li reg-rax (gdt64-limit + gdt64-base * 65536))
   in let r2 = st-append-code r1 (mov-store reg-rsp reg-rax 0)
   in let r3 = st-append-code r2 (li reg-rax 0)
   in let r4 = st-append-code r3 (mov-store reg-rsp reg-rax 8)
   in let r5 = st-append-code r4 (mov-rr reg-rdi reg-rsp)
   in let r6 = st-append-code r5 [15, 1, 23]
   in let r7 = st-append-code r6 (add-ri reg-rsp 16)
   in let r8 = st-append-code r7 (li reg-rax gdt-tss-sel-base)
   in let r9 = st-append-code r8 [15, 0, 216]
   in let b0 = st-append-code r9 (li reg-rax 0)
   in let b1 = st-append-code b0 [15, 0, 200]
   in let b2 = st-append-code b1 (li reg-rdi ap-tr-report-addr)
   in let b3 = st-append-code b2 (mov-store reg-rdi reg-rax 0)
   in let i0 = st-append-code b3 (li reg-rdi (idt-base + 8 * 16 + 4))
   in let i1 = st-append-code i0 (li reg-rax 1)
   in st-append-code i1 (mov-store-byte reg-rdi reg-rax 0)

  emit-vga-progress : CodegenState, Integer, Integer -> CodegenState
  emit-vga-progress (st) (pos) (ascii) =
   let st1 = st-append-code st (li reg-rdi (753664 + pos * 2))
   in let st2 = st-append-code st1 (li reg-rax (3840 + ascii))
   in st-append-code st2 (mov-store reg-rdi reg-rax 0)

  emit-lapic-disable : CodegenState -> CodegenState
  emit-lapic-disable (st) =
   let st1 = st-append-code st (li reg-rdx 1296)
   in let st1a = st-append-code st1 (xor-rr reg-rax reg-rax)
   in let st2 = st-append-code st1a [236]
   in let st3 = st-append-code st2 (cmp-ri reg-rax 255)
   in let skip-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (li reg-rcx 27)
   in let st6 = st-append-code st5 [15, 50]
   in let st7 = st-append-code st6 (and-ri reg-rax (-2049))
   in let st8 = st-append-code st7 [15, 48]
   in patch-jcc-at st8 skip-pos (st8.code-len)

 Every i8042 wait is fuel-bounded and the whole init is skipped when
 the status port reads 0xFF -- the floating-bus signature of a machine
 with no PS/2 controller at all, which is most machines made in the
 last decade. An unbounded status-bit wait on such a machine spins
 forever: with nothing driving the bus, port 0x64 reads all-ones and
 both OBF and IBF look permanently set. The keyboard on those machines
 is USB (GopUsbKbd); this init must cost them a single port read.

  kbd-wait-fuel : Integer = 65536

  emit-kbd-wait-ibf : CodegenState -> CodegenState
  emit-kbd-wait-ibf (st) =
   let f0 = st-append-code st (li reg-rcx kbd-wait-fuel)
   in let wait-top = f0.code-len
   in let st1 = st-append-code f0 (li reg-rdx 100)
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 [168, 2]
   in let done-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let st5 = st-append-code st4 [72, 255, 201]
   in let st6 = st-append-code st5 (jcc cc-ne (wait-top - (st5.code-len + 6)))
   in patch-jcc-at st6 done-pos (st6.code-len)

  emit-kbd-init : CodegenState -> CodegenState
  emit-kbd-init (st) =
   let p0 = st-append-code st (xor-rr reg-rax reg-rax)
   in let p1 = st-append-code p0 (li reg-rdx 100)
   in let p2 = st-append-code p1 in-al-dx
   in let p3 = st-append-code p2 (cmp-ri reg-rax 255)
   in let skip-pos = p3.code-len
   in let p4 = st-append-code p3 (jcc cc-e 0)
   in let f0 = st-append-code p4 (li reg-rcx kbd-wait-fuel)
   in let flush-top = f0.code-len
   in let f1 = st-append-code f0 (li reg-rdx 100)
   in let f2 = st-append-code f1 in-al-dx
   in let f3 = st-append-code f2 [168, 1]
   in let flush-done = f3.code-len
   in let f4 = st-append-code f3 (jcc cc-e 0)
   in let f5 = st-append-code f4 (li reg-rdx 96)
   in let f6 = st-append-code f5 in-al-dx
   in let f6a = st-append-code f6 [72, 255, 201]
   in let f7 = st-append-code f6a (jcc cc-ne (flush-top - (f6a.code-len + 6)))
   in let f8 = patch-jcc-at f7 flush-done (f7.code-len)
   in let k1 = emit-kbd-wait-ibf f8
   in let k2 = emit-out-byte k1 100 174
   in let k3 = emit-kbd-wait-ibf k2
   in let k4 = emit-out-byte k3 100 96
   in let k5 = emit-kbd-wait-ibf k4
   in let k6 = emit-out-byte k5 96 101
   in let k7 = emit-kbd-wait-ibf k6
   in let k8 = emit-out-byte k7 96 244
   in patch-jcc-at k8 skip-pos (k8.code-len)

  emit-interrupt-setup : CodegenState -> CodegenState
  emit-interrupt-setup (st) =
   let st-d0 = emit-vga-progress st 4 49
   in let st0 = emit-lapic-disable st-d0
   in let st-d1 = emit-vga-progress st0 5 50
   in let st0a = emit-pit-init st-d1
   in let st-d2 = emit-vga-progress st0a 6 51
   in let st1 = emit-pic-init st-d2
   in let st-d3 = emit-vga-progress st1 7 52
   in let st1a = emit-kbd-init st-d3
   in let st-d4 = emit-vga-progress st1a 8 53
   in let st10 = st-append-code st-d4 (li reg-rdi tick-count-addr)
   in let st11 = st-append-code st10 (li reg-rax 0)
   in let st12 = st-append-code st11 (mov-store reg-rdi reg-rax 0)
   in let st13 = st-append-code st12 (li reg-rdi key-buffer-addr)
   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rax 0)
   in let st15 = st-append-code st14 (li reg-rdi arena-base-addr)
   in let st18 = st-append-code st15 (mov-store reg-rdi reg-rax 0)
   in let st19 = st-append-code st18 (li reg-rdi wd-stale-tick-addr)
   in let st20 = st-append-code st19 (mov-store reg-rdi reg-rax 0)
   in let st21 = st-append-code st20 (li reg-rdi wd-last-heap-addr)
   in let st22 = st-append-code st21 (mov-store reg-rdi reg-rax 0)
   in let st23 = st-append-code st22 (li reg-rdi wd-last-rip-addr)
   in let st24 = st-append-code st23 (mov-store reg-rdi reg-rax 0)
   in let st25 = st-append-code st24 (li reg-rdi wd-ring-head-addr)
   in let st26 = st-append-code st25 (mov-store reg-rdi reg-rax 0)
   in let st27 = st-append-code st26 (li reg-rdi cap-expiry-addr)
   in let st28 = st-append-code st27 (mov-store reg-rdi reg-rax 0)
   in st-append-code st28 sti

Section: Runtime Init Builtin

 The Option A boot stub keeps the firmware GDT, never installs an IDT,
 and jumps straight to opening. On that path there are no ticks, no
 keyboard interrupts, no exception dumps, and no syscalls. The
 runtime-init builtin lets the payload install the same runtime spine
 the normal boot path gets inside emit-start: a GDT with code at
 selector 8 (the selector every IDT entry references), a CS reload
 through a far return, the TSS with the double-fault emergency stack,
 the IDT, the syscall MSRs, and the PIC/PIT/keyboard setup ending in
 sti. The compiler source never calls runtime-init, so the helper's
 presence cannot perturb the self-host fixed point. The scheduler and
 profiler cells the timer ISR reads every tick are zeroed before sti:
 firmware leaves arbitrary bytes in low memory, and a garbage process
 table would send the preemption path through a wild context restore.
 The far-return sequence is hand-emitted as fixed-width bytes (a
 10-byte mov rax imm64, push, retfq) so the return vaddr is a fixed
 13 bytes past the measurement point regardless of immediate width.

  emit-runtime-init-fn : CodegenState, Integer, Integer, Integer -> CodegenState
  emit-runtime-init-fn (st) (first-stub-vaddr) (syscall-handler-offset) (grant-mask) =
   let st0 = record-func-offset st "runtime-init"
   in let c0 = st-append-code st0 cli
   in let g0 = st-append-code c0 (li reg-rdi gdt64-base)
   in let g1 = st-append-code g0 (li reg-rax 0)
   in let g2 = st-append-code g1 (mov-store reg-rdi reg-rax 0)
   in let g3 = st-append-code g2 (li reg-rax #00AF9A000000FFFF)
   in let g4 = st-append-code g3 (mov-store reg-rdi reg-rax 8)
   in let g5 = st-append-code g4 (li reg-rax #00CF92000000FFFF)
   in let g6 = st-append-code g5 (mov-store reg-rdi reg-rax 16)
   in let g7 = st-append-code g6 (li reg-rax #0000890130000067)
   in let g8 = st-append-code g7 (mov-store reg-rdi reg-rax 24)
   in let g9 = st-append-code g8 (li reg-rax 0)
   in let g10 = st-append-code g9 (mov-store reg-rdi reg-rax 32)
   in let r0 = st-append-code g10 (sub-ri reg-rsp 16)
   in let r1 = st-append-code r0 (li reg-rax (39 + gdt64-base * 65536))
   in let r2 = st-append-code r1 (mov-store reg-rsp reg-rax 0)
   in let r3 = st-append-code r2 (li reg-rax 0)
   in let r4 = st-append-code r3 (mov-store reg-rsp reg-rax 8)
   in let r5 = st-append-code r4 (mov-rr reg-rdi reg-rsp)
   in let r6 = st-append-code r5 [15, 1, 23]
   in let r7 = st-append-code r6 (add-ri reg-rsp 16)
   in let f0 = st-append-code r7 (li reg-rax 8)
   in let f1 = st-append-code f0 (push-r reg-rax)
   in let after = bare-metal-load-addr + f1.code-len + 13
   in let b0 = bit-and after 255
   in let b1 = bit-and (bit-shru after 8) 255
   in let b2 = bit-and (bit-shru after 16) 255
   in let b3 = bit-and (bit-shru after 24) 255
   in let f2 = st-append-code f1 [72, 184, b0, b1, b2, b3, 0, 0, 0, 0]
   in let f3 = st-append-code f2 (push-r reg-rax)
   in let f4 = st-append-code f3 [72, 203]
   in let d0 = st-append-code f4 [102, 184, 16, 0]
   in let d1 = st-append-code d0 [142, 216]
   in let d2 = st-append-code d1 [142, 192]
   in let d3 = st-append-code d2 [142, 208]
   in let d4 = st-append-code d3 [142, 224]
   in let d5 = st-append-code d4 [142, 232]
   in let t0 = emit-zero-region d5 tss-base 13
   in let t1 = st-append-code t0 (li reg-rdi tss-base)
   in let t2 = st-append-code t1 (li reg-rax df-ist-stack-top)
   in let t3 = st-append-code t2 (mov-store reg-rdi reg-rax 36)
   in let t4 = st-append-code t3 (li reg-rax 24)
   in let t5 = st-append-code t4 [15, 0, 216]
   in let i0 = emit-idt-entries t5 first-stub-vaddr
   in let i1 = emit-load-idt i0
   in let i2 = st-append-code i1 (li reg-rdi (idt-base + 8 * 16 + 4))
   in let i3 = st-append-code i2 (li reg-rax 1)
   in let i4 = st-append-code i3 (mov-store-byte reg-rdi reg-rax 0)
   in let m0 = emit-write-msr i4 3221225601 (8 * 4294967296)
   in let m1 = emit-write-msr m0 3221225602 (bare-metal-load-addr + syscall-handler-offset)
   in let m2 = emit-write-msr m1 3221225604 512
   in let m3 = st-append-code m2 (li reg-rcx 3221225600)
   in let m4 = st-append-code m3 [15, 50]
   in let m5 = st-append-code m4 ([72, 13] & write-i32 efer-sce-nxe)
   in let m6 = st-append-code m5 [15, 48]
   in let z0 = emit-zero-region m6 proc-table-base 512
   in let p0a = st-append-code z0 (li reg-rdi proc-table-base)
   in let p0b = st-append-code p0a (li reg-rax proc-state-running)
   in let p0c = st-append-code p0b (mov-store reg-rdi reg-rax 0)
   in let cg = if grant-mask == 0 then p0c else emit-grant-cap-mask p0c 0 grant-mask
   in let z1 = st-append-code cg (li reg-rax 0)
   in let z4 = st-append-code z1 (li reg-rdi sched-ready-head-addr)
   in let z5 = st-append-code z4 (mov-store reg-rdi reg-rax 0)
   in let z6 = st-append-code z5 (li reg-rdi sched-current-task-addr)
   in let z7 = st-append-code z6 (mov-store reg-rdi reg-rax 0)
   in let z8 = st-append-code z7 (li reg-rdi sched-yield-flag-addr)
   in let z9 = st-append-code z8 (mov-store reg-rdi reg-rax 0)
   in let z10 = st-append-code z9 (li reg-rdi starve-counter-addr)
   in let z11 = st-append-code z10 (mov-store reg-rdi reg-rax 0)
   in let z12 = st-append-code z11 (li reg-rdi prof-enabled-addr)
   in let z13 = st-append-code z12 (mov-store reg-rdi reg-rax 0)
   in let z14 = st-append-code z13 (li reg-rdi prof-cursor-addr)
   in let z15 = st-append-code z14 (mov-store reg-rdi reg-rax 0)
   in let s0 = emit-interrupt-setup z15
   in let e0 = st-append-code s0 (li reg-rax 0)
   in st-append-code e0 [195]

Section: SMP Initialization

  emit-lapic-enable : CodegenState -> CodegenState
  emit-lapic-enable (st) =
   let st1 = st-append-code st (li reg-rcx 27)
   in let st2 = st-append-code st1 [15, 50]
   in let st3 = st-append-code st2 (or-ri reg-rax 2048)
   in st-append-code st3 [15, 48]

  emit-lapic-write : CodegenState, Integer, Integer -> CodegenState
  emit-lapic-write (st) (reg-offset) (value) =
   let st1 = st-append-code st (li reg-rdi (lapic-base + reg-offset))
   in let st2 = st-append-code st1 (li reg-rax value)
   in st-append-code st2 (mov-store-32 reg-rdi reg-rax 0)

  emit-lapic-read : CodegenState, Integer -> CodegenState
  emit-lapic-read (st) (reg-offset) =
   let st1 = st-append-code st (li reg-rdi (lapic-base + reg-offset))
   in st-append-code st1 (mov-load reg-rax reg-rdi 0)

 A wake to every other core, so a processor parked on `hlt` in
 __idle_dispatch rises to rescan the moment work is published rather than
 waiting out its next timer tick. It is a fixed-delivery inter-processor
 interrupt on the timer vector with the "all excluding self" shorthand, so
 a woken core takes it exactly as it takes its own timer -- and the
 idle-stack guard in the common handler drops it without touching a
 process, which is all a parked core needs before it falls through to its
 scan. A core that is not parked takes one harmless spurious tick. Sent
 after a process is published READY (spawn) and after a waiter is unblocked
 (exit). Clobbers RDI and RAX, like emit-lapic-write; call it where both
 are dead.

  emit-wake-ipi : CodegenState -> CodegenState
  emit-wake-ipi (st) =
   let st1 = emit-lapic-write st lapic-icr-hi-reg 0
   in emit-lapic-write st1 lapic-icr-lo-reg icr-wake-all-but-self

 The end of a scheduling interrupt, acknowledged to whichever chip raised
 it. The boot processor's clock is the PIT, which arrives through the 8259
 and is acknowledged there; an application processor's clock is its own
 local APIC timer, and is acknowledged to the local APIC. Sending the wrong
 one leaves the raising chip believing the interrupt is still in service,
 and it never delivers another -- a core preempted exactly once and never
 again, which looks like a scheduler that simply stopped.

 The vector is still on the stack where the per-vector stub pushed it: the
 handler has pushed four registers over it and nothing else, so it sits at
 [rsp+32] on both the switching and the non-switching path. RDI and RAX are
 dead at both call sites; RSI is not, and is not touched here, because the
 switching path is on its way to __process_resume with the process in it.

  emit-timer-eoi : CodegenState -> CodegenState
  emit-timer-eoi (st) =
   let st1 = st-append-code st (mov-load reg-rax reg-rsp 32)
   in let st2 = st-append-code st1 (cmp-ri reg-rax lapic-timer-vector)
   in let pic-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ne 0)
   in let st4 = emit-lapic-write st3 lapic-eoi-reg 0
   in let done-pos = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 pic-pos (st5.code-len)
   in let st7 = emit-out-byte st6 32 32
   in patch-jmp-at st7 done-pos (st7.code-len)

 RCX already holds the address of the running process here. RAX and RDX are
 dead; RDI holds the slot index and the scan below still needs it.

 Evidence that a device interrupt was taken, written at the point in
 __interrupt_common where the vector has been established as neither the
 PIT's nor the local timer's. RAX holds the vector and the comparisons
 below still need it, so it is left alone; RCX, RDX, RSI and RDI were all
 pushed on entry and are free scratch here.

 The count is incremented with a locked add because more than one core
 reaches this path. The last-vector store is a plain one: two device
 interrupts racing to record different vectors is not a case worth a lock,
 and a test that programs one line reads back that line.

 This is the whole cost of the mechanism -- five instructions on a path
 that runs only for device interrupts. The timer vectors branch away
 before reaching it, so the tick, which is the only frequent interrupt
 here, pays nothing.

  emit-devint-record : CodegenState -> CodegenState
  emit-devint-record (st) =
   let st1 = st-append-code st (li reg-rdi devint-last-vec-addr)
   in let st2 = st-append-code st1 (mov-store reg-rdi reg-rax 0)
   in let st3 = st-append-code st2 (li reg-rdi devint-count-addr)
   in let st4 = st-append-code st3 (li reg-rsi 1)
   in st-append-code st4 (lock-xadd-mem reg-rsi reg-rdi 0)

  emit-ap-preempt-count : CodegenState -> CodegenState
  emit-ap-preempt-count (st) =
   let st1 = st-append-code st (mov-load reg-rdx reg-rcx proc-core-offset)
   in let st2 = st-append-code st1 (test-rr reg-rdx reg-rdx)
   in let skip-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-e 0)
   in let st4 = st-append-code st3 (li reg-rdx ap-preempt-count-addr)
   in let st5 = st-append-code st4 (li reg-rax 1)
   in let st6 = st-append-code st5 (lock-xadd-mem reg-rax reg-rdx 0)
   in patch-jcc-at st6 skip-pos (st6.code-len)

 The order matters. The local APIC is enabled first (the MSR bit, which is
 per-core), then its spurious vector, then the timer is programmed, and
 only then are interrupts unmasked. Raising IF before there is a handler
 path for the vector would take the interrupt into whatever the IDT
 happened to hold.

  emit-ap-timer-init : CodegenState -> CodegenState
  emit-ap-timer-init (st) =
   let st1 = emit-lapic-enable st
   in let st2 = emit-lapic-write st1 lapic-sivr-reg lapic-sivr-enable
   in let st3 = emit-lapic-write st2 lapic-timer-div-reg lapic-timer-divide-16
   in let st4 = emit-lapic-write st3 lapic-lvt-timer-reg (lapic-timer-vector + lapic-timer-periodic)
   in let st5 = emit-lapic-write st4 lapic-timer-init-reg lapic-timer-count
   in st-append-code st5 sti

  emit-busy-wait-cycles : CodegenState, Integer -> CodegenState
  emit-busy-wait-cycles (st) (count) =
   let st1 = st-append-code st (li reg-rcx count)
   in let loop-top = st1.code-len
   in let st2 = st-append-code st1 x86-pause
   in let st3 = st-append-code st2 (sub-ri reg-rcx 1)
   in st-append-code st3 (jcc cc-ne (loop-top - (st3.code-len + 6)))

 A start-up IPI does not hand a core an address. It hands it a page
 number, and the core begins executing at the first byte of that page in
 REAL MODE -- 16-bit, no paging, no long mode, segment bases in hardware
 registers, and a GDT it has never heard of. Everything the boot processor
 spent its own startup arranging has to be arranged again, by the core
 itself, out of bytes that were copied into the low megabyte before the
 IPI was sent. That is what this is: one hundred and seventy-seven bytes
 that carry a core from reset state to the 64-bit AP entry.

 It is laid out with its data first so the offsets that matter are
 literals rather than the sum of however many instructions happen to
 precede them. Offset 0 is a two-byte jump over the data to the 16-bit
 code at 40; offset 2 is the GDT pseudo-descriptor lgdt reads, limit then
 base; offset 8 is the GDT itself, null then 32-bit code then data then
 64-bit code; offset 40 is the 16-bit code, which loads the GDT, sets
 CR0.PE and far jumps to 32-bit; offset 68 is the 32-bit code, which sets
 PAE, CR3, EFER.LME and CR0.PG and far jumps to 64-bit; and offset 134 is
 the 64-bit code, which takes a core id and jumps to the AP entry.

 It carries its OWN GDT rather than borrowing the runtime one, because the
 runtime GDT has no 32-bit code descriptor -- it has a 64-bit code
 descriptor, a data descriptor, and sixteen TSS descriptors, and the
 protected-mode step needs a segment the runtime never has any use for.
 The AP entry reloads the runtime GDT for itself a few instructions later;
 the descriptor caches carry the trampoline's flat code and data across
 that lgdt untouched, because nothing reloads a segment register between
 the two.

 EFER gets NXE as well as LME, and forgetting it is a page fault rather
 than a missing feature: the runtime page tables set bit 63 on every entry
 above the code boundary, and with NXE clear bit 63 is a RESERVED bit, so
 the first instruction after paging comes on faults on a reserved-bit
 violation. The boot processor is given NXE by the firmware path; an
 application processor has to ask for it.

 The two far jumps are the only reason the layout is fixed: their targets
 are absolute addresses, computed here from ap-trampoline-addr, and they
 are wrong by exactly as much as any byte count above them is wrong.

 Offsets 0..39. A two-byte jump over the data (rel8 38, measured from the
 byte after it, so 2 + 38 = 40), then the six-byte pseudo-descriptor lgdt
 reads, then four descriptors: null, 64-bit code, data, 32-bit code. The
 GDT base is ap-trampoline-addr + 8, so selector 8 is the 64-bit code
 segment, 16 the data segment and 24 the 32-bit code segment.

 That ordering is not cosmetic and it is the one thing here that will bite
 anyone who rearranges this table. The selectors an application processor
 is still holding when it leaves the trampoline have to mean the same
 things in the RUNTIME GDT it is about to load, because a segment register
 is only reloaded from a descriptor table when something reloads it -- and
 the first thing that does is the iretq at the end of the first interrupt
 the core takes, which restores CS and SS from the frame the CPU pushed.
 The runtime GDT is null, 64-bit code, data, then sixteen TSS descriptors.
 Put the 32-bit code segment at selector 8, as the natural reading order
 suggests, and the core runs perfectly until its first timer tick and then
 general-protection-faults on the way back out, because selector 24 in the
 runtime table is a TSS and a TSS is not a code segment. The 32-bit
 descriptor goes last precisely because it is the one that is dead by
 then.

  ap-tramp-data : List Integer
  ap-tramp-data = [235, 38] & write-i16 31 & write-i32 (ap-trampoline-addr + 8) & write-i64 0 & write-i64 #00AF9A000000FFFF & write-i64 #00CF92000000FFFF & write-i64 #00CF9A000000FFFF

 Offsets 40..67, sixteen-bit. cli; xor ax, ax; mov ds, ax so the absolute
 lgdt operand below is measured from linear zero; lgdt [ap-trampoline-addr
 + 2]; mov eax, cr0; or eax, 1 (the 0x66 prefix is what makes that a
 32-bit operand in a 16-bit segment); mov cr0, eax; and a 32-bit far jump
 to selector 24, the 32-bit code segment, at offset 68.

  ap-tramp-code16 : List Integer
  ap-tramp-code16 = [250, 49, 192, 142, 216, 15, 1, 22] & write-i16 (ap-trampoline-addr + 2) & [15, 32, 192, 102, 131, 200, 1, 15, 34, 192, 102, 234] & write-i32 (ap-trampoline-addr + 68) & write-i16 24

 Offsets 68..133, thirty-two-bit. Load the data selector into every
 segment register; set CR4 to PAE, OSFXSR and OSXMMEXCPT (0x620); point
 CR3 at the runtime PML4 at 0x8000, which the boot processor built before
 it sent the IPI; read EFER and set LME and NXE (0x900); set CR0.PG and
 CR0.MP, which activates long mode with a 32-bit code segment still
 selected; and far jump to selector 8 at offset 134, which is the step
 that actually enters 64-bit mode.

 Every one of those constants is the boot processor's, taken from
 tramp-enable-long-mode in X86_64IO, and the two that look like padding
 are not. OSFXSR is what makes SSE legal: without it the first packed
 instruction in the first process an application processor resumes is an
 invalid-opcode fault, which is what this omission actually produced --
 the cores checked in, armed their timers, and then died one at a time on
 real work while the check-in count still read three. NXE is what makes
 bit 63 of a page-table entry mean "no execute" instead of "reserved", and
 the runtime tables set it above the code boundary, so without NXE the
 first instruction executed after paging comes on is a reserved-bit page
 fault.

  ap-tramp-code32 : List Integer
  ap-tramp-code32 = [184] & write-i32 16 & [142, 216, 142, 192, 142, 208, 142, 224, 142, 232, 15, 32, 224, 13] & write-i32 1568 & [15, 34, 224, 184] & write-i32 32768 & [15, 34, 216, 185] & write-i32 3221225600 & [15, 50, 13] & write-i32 2304 & [15, 48, 15, 32, 192, 13] & write-i32 2147483650 & [15, 34, 192, 234] & write-i32 (ap-trampoline-addr + 134) & write-i16 8

 Offsets 134..176, sixty-four-bit. Reload the segment registers under the
 new mode; take a core id with a locked exchange-add on ap-id-next-addr,
 which leaves the old value in EAX and is the whole of this core's
 identity; move it to EDI, where the AP entry expects it; and jump to that
 entry, whose absolute address was known when this blob was assembled.

  ap-tramp-code64 : Integer -> List Integer
  ap-tramp-code64 (entry) = [184] & write-i32 16 & [142, 216, 142, 192, 142, 208, 142, 224, 142, 232, 184] & write-i32 1 & [240, 15, 193, 4, 37] & write-i32 ap-id-next-addr & [137, 199, 72, 184] & write-i64 entry & [255, 224]

  ap-tramp-blob : Integer -> List Integer
  ap-tramp-blob (entry) = ap-tramp-data & ap-tramp-code16 & ap-tramp-code32 & ap-tramp-code64 entry

  ap-tramp-size : Integer = list-length (ap-tramp-blob 0)

  emit-smp-write-stacks : CodegenState, Integer -> CodegenState
  emit-smp-write-stacks (st) (i) =
   if i >= smp-max-cores then st
   else let stack-addr = ap-stacks-base + i * ap-stack-size
   in let st1 = st-append-code st (li reg-rax stack-addr)
   in let st2 = st-append-code st1 (li reg-rdi (ap-stack-table-addr + i * 8))
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 0)
   in emit-smp-write-stacks st3 (i + 1)

 The boot processor copies the real-mode trampoline into the page the
 start-up vector names, seeds the core-id counter, publishes the per-core
 stack table, sends INIT and two start-up IPIs, and then waits for every
 application processor to count itself in. Each AP comes up in real mode
 inside the trampoline, climbs to long mode, takes a core id, claims its
 stack from the table by that index, loads the runtime GDT, the runtime
 IDT and its own task register -- it starts on a GDT of the trampoline's
 own making, which carries no TSS, and a core with no task register cannot
 be handed a fault -- adds itself to the ready count with a locked add,
 and goes to look for work.

 It goes to __idle_dispatch -- the same place the boot processor goes when
 it runs out of work -- with its core id already in R15, which is where
 that routine expects it. From there an application processor is not a
 special case: it claims a READY process out of the table and runs it,
 exactly as core 0 does. The only asymmetry is that it may not claim slot
 0, because slot 0 is the program the machine booted.

 It is already standing on its own idle stack here, so it has nothing to
 get off before it starts scanning. That is not true of a core arriving
 from process-exit or process-wait, and that is the whole reason
 __idle_dispatch switches stacks before it does anything else.

 The wait spins on pause rather than halting. A halted processor is woken
 by an interrupt, and nothing here sends one -- the APs report in by
 writing memory, which wakes nobody. The loop used to halt, and only ever
 came back because codex-vm reached in from the host and rewrote the
 BSP's instruction pointer to shove it past the loop. It no longer does,
 so the loop has to be able to make progress on its own.

  emit-smp-init : CodegenState -> CodegenState
  emit-smp-init (st) =
   let g0 = st-append-code st (li reg-rdi ap-core-count-addr)
   in let g1 = st-append-code g0 (mov-load reg-rax reg-rdi 0)
   in let g2 = st-append-code g1 (cmp-ri reg-rax 1)
   in let skip-pos = g2.code-len
   in let g3 = st-append-code g2 (jcc cc-be 0)
   in let st0 = st-append-code g3 (li reg-rax 0)
   in let st1 = st-append-code st0 (li reg-rdi ap-ready-count-addr)
   in let st2 = st-append-code st1 (mov-store reg-rdi reg-rax 0)
   in let st5 = emit-smp-write-stacks st2 1
   in let bsp-skip-pos = st5.code-len
   in let st5a = st-append-code st5 (jmp 0)
   in let ap-entry-pos = st5a.code-len
   in let ap0 = st-append-code st5a (mov-rr reg-r15 reg-rdi)
   in let ap1 = st-append-code ap0 (mov-rr reg-rax reg-rdi)
   in let ap2 = st-append-code ap1 (shl-ri reg-rax 3)
   in let ap3 = st-append-code ap2 (li reg-rdi ap-stack-table-addr)
   in let ap4 = st-append-code ap3 (add-rr reg-rdi reg-rax)
   in let ap5 = st-append-code ap4 (mov-load reg-rax reg-rdi 0)
   in let ap6 = st-append-code ap5 (add-ri reg-rax ap-stack-size)
   in let ap7 = st-append-code ap6 (mov-rr reg-rsp reg-rax)
   in let ap8 = st-append-code ap7 (mov-rr reg-rbp reg-rsp)
   in let tr0 = st-append-code ap8 (sub-ri reg-rsp 16)
   in let tr1 = st-append-code tr0 (li reg-rax (gdt64-limit + gdt64-base * 65536))
   in let tr2 = st-append-code tr1 (mov-store reg-rsp reg-rax 0)
   in let tr3 = st-append-code tr2 (li reg-rax 0)
   in let tr4 = st-append-code tr3 (mov-store reg-rsp reg-rax 8)
   in let tr5 = st-append-code tr4 (mov-rr reg-rdi reg-rsp)
   in let tr6 = st-append-code tr5 [15, 1, 23]
   in let tr7 = st-append-code tr6 (add-ri reg-rsp 16)
   in let tr7i = emit-load-idt tr7
   in let tr8 = st-append-code tr7i (mov-rr reg-rax reg-r15)
   in let tr9 = st-append-code tr8 (shl-ri reg-rax 4)
   in let tr10 = st-append-code tr9 (add-ri reg-rax gdt-tss-sel-base)
   in let tr11 = st-append-code tr10 [15, 0, 216]
   in let rp0 = st-append-code tr11 (li reg-rax 0)
   in let rp1 = st-append-code rp0 [15, 0, 200]
   in let rp2 = st-append-code rp1 (mov-rr reg-rdx reg-r15)
   in let rp3 = st-append-code rp2 (shl-ri reg-rdx 3)
   in let rp4 = st-append-code rp3 (li reg-rdi ap-tr-report-addr)
   in let rp5 = st-append-code rp4 (add-rr reg-rdi reg-rdx)
   in let rp6 = st-append-code rp5 (mov-store reg-rdi reg-rax 0)
   in let ap9 = st-append-code rp6 (li reg-rdi ap-ready-count-addr)
   in let ap10 = st-append-code ap9 (li reg-rax 1)
   in let ap11 = st-append-code ap10 (lock-xadd-mem reg-rax reg-rdi 0)
   in let ap12 = emit-ap-timer-init ap11
   in let ap13 = emit-jmp-to ap12 "__idle_dispatch"
   in let st5b = patch-jmp-at ap13 bsp-skip-pos (ap13.code-len)
   in let blob-skip-pos = st5b.code-len
   in let sb0 = st-append-code st5b (jmp 0)
   in let tramp-pos = sb0.code-len
   in let sb1 = st-append-code sb0 (ap-tramp-blob (bare-metal-load-addr + ap-entry-pos))
   in let sb2 = patch-jmp-at sb1 blob-skip-pos (sb1.code-len)
   in let id0 = st-append-code sb2 (li reg-rdi ap-id-next-addr)
   in let id1 = st-append-code id0 (li reg-rax 1)
   in let id2 = st-append-code id1 (mov-store reg-rdi reg-rax 0)
   in let cp0 = st-append-code id2 (li reg-rsi (bare-metal-load-addr + tramp-pos))
   in let cp1 = st-append-code cp0 (li reg-rdi ap-trampoline-addr)
   in let cp2 = st-append-code cp1 (li reg-rcx ap-tramp-size)
   in let cp3 = st-append-code cp2 cld
   in let cp4 = st-append-code cp3 rep-movsb
   in let ipi0 = emit-lapic-enable cp4
   in let ipi1 = emit-lapic-write ipi0 lapic-sivr-reg lapic-sivr-enable
   in let ipi2 = emit-lapic-write ipi1 lapic-icr-hi-reg 0
   in let ipi3 = emit-lapic-write ipi2 lapic-icr-lo-reg icr-init-all-but-self
   in let ipi4 = emit-busy-wait-cycles ipi3 smp-init-delay-cycles
   in let ipi5 = emit-lapic-write ipi4 lapic-icr-lo-reg icr-sipi-all-but-self
   in let ipi6 = emit-busy-wait-cycles ipi5 smp-sipi-delay-cycles
   in let ipi7 = emit-lapic-write ipi6 lapic-icr-lo-reg icr-sipi-all-but-self
   in let w0 = st-append-code ipi7 (li reg-rdi ap-core-count-addr)
   in let w1 = st-append-code w0 (mov-load reg-rbx reg-rdi 0)
   in let w2 = st-append-code w1 (sub-ri reg-rbx 1)
   in let w3 = st-append-code w2 (li reg-rcx smp-wait-fuel)
   in let wait-top = w3.code-len
   in let w4 = st-append-code w3 (li reg-rdi ap-ready-count-addr)
   in let w5 = st-append-code w4 (mov-load reg-rax reg-rdi 0)
   in let w6 = st-append-code w5 (cmp-rr reg-rax reg-rbx)
   in let all-in-pos = w6.code-len
   in let w7 = st-append-code w6 (jcc cc-ae 0)
   in let w8 = st-append-code w7 (sub-ri reg-rcx 1)
   in let gave-up-pos = w8.code-len
   in let w9 = st-append-code w8 (jcc cc-e 0)
   in let w10 = st-append-code w9 x86-pause
   in let w11 = st-append-code w10 (jmp (wait-top - (w10.code-len + 5)))
   in let w12 = patch-jcc-at w11 all-in-pos (w11.code-len)
   in let w13 = patch-jcc-at w12 gave-up-pos (w11.code-len)
   in patch-jcc-at w13 skip-pos (w13.code-len)

Section: Process Management
  emit-zero-region : CodegenState, Integer, Integer -> CodegenState
  emit-zero-region (st) (addr) (qwords) =
   let st1 = st-append-code st (li reg-rdi addr)
   in let st2 = st-append-code st1 (li reg-rcx qwords)
   in let st3 = st-append-code st2 (li reg-rax 0)
   in st-append-code st3 [243, 72, 171]

  emit-pd-entries : CodegenState, Integer, Integer, Boolean, Boolean -> CodegenState
  emit-pd-entries (st) (i) (n) (nx) (pcd) =
   let count = n - i
   in if count <= 0 then st
   else let phys-start = i * 2097152
   in let flags = if pcd then 147 else 131
   in let st1 = st-append-code st (li reg-rax (phys-start + flags))
   in let st2 = if nx
     then let st1a = st-append-code st1 (li reg-r11 1)
       in let st1b = st-append-code st1a (shl-ri reg-r11 63)
       in st-append-code st1b (or-rr reg-rax reg-r11)
     else st1
   in let st3 = st-append-code st2 (li reg-rcx count)
   in let loop-start = st3.code-len
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-rax 0)
   in let st5 = st-append-code st4 (add-ri reg-rdi 8)
   in let st6 = st-append-code st5 (add-ri reg-rax 2097152)
   in let st7 = st-append-code st6 (sub-ri reg-rcx 1)
   in let cur = st7.code-len
   in st-append-code st7 (jcc cc-ne (loop-start - (cur + 6)))

  emit-pdpt-entries : CodegenState, Integer, Integer, Integer -> CodegenState
  emit-pdpt-entries (st) (pdpt-addr) (pml4-addr) (i) =
   if i >= bare-metal-total-pd-count then st
   else let st1 = st-append-code st (li reg-rdi (pdpt-addr + i * 8))
    in let st2 = st-append-code st1 (li reg-rax (pml4-addr + 8192 + i * 4096 + 3))
    in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 0)
    in emit-pdpt-entries st3 pdpt-addr pml4-addr (i + 1)

 The device directory maps the gigabyte above RAM identity, present and
 read-write, with NX set on every entry -- nothing up there is code -- and
 with PCD set, which is the bit that matters and was missing until
 2026-08-02.

 The flag words are 131 (0x83) and 147 (0x93): bit 0 present, bit 1
 writable, bit 7 the 2 MB page-size bit, and in 147 additionally bit 4,
 PCD, cache-disable. Intel SDM 3A 4.5: a page mapped with PCD clear is
 write-back cacheable, so the processor may satisfy a read from cache and
 may hold a write there. That is correct for RAM and wrong for everything
 this directory covers, because the gigabyte above RAM identity is MMIO:
 device registers whose value changes underneath the processor, and on a
 UEFI boot the linear framebuffer, which a display controller scans out of
 memory independently of our caches.

 Both failures were observed on the ASUS TUF before the bit was set. The
 framebuffer at 0xC0000000 -- the first address in this directory --
 rendered with rows missing and stale content persisting, while the
 geometry the payload computed was measured correct and identical to a bed
 that renders it perfectly. A cached MMIO mapping is also a mechanism by
 which a driver polling a status register reads a value that cannot
 change.

 No emulator we own can observe either one: codex-vm's framebuffer is host
 RAM read coherently, and WHP traps MMIO regardless of the cache
 attributes the guest asked for.

  emit-fill-device-pd : CodegenState, Integer -> CodegenState
  emit-fill-device-pd (st) (pml4-addr) =
   let pd-addr = pml4-addr + 8192 + bare-metal-device-pd-index * 4096
   in let st1 = st-append-code st (li reg-rdi pd-addr)
   in emit-pd-entries st1 bare-metal-device-page-start bare-metal-device-page-end True True

  emit-fill-pds : CodegenState, Integer, Integer -> CodegenState
  emit-fill-pds (st) (pml4-addr) (i) =
   if i >= bare-metal-pd-count then st
   else let pd-addr = pml4-addr + 8192 + i * 4096
    in let page-start = i * 512
    in let page-end = if (i + 1) * 512 > bare-metal-page-count then bare-metal-page-count else (i + 1) * 512
    in let code-end = if bare-metal-nx-boundary < page-start then page-start
      else if bare-metal-nx-boundary > page-end then page-end
      else bare-metal-nx-boundary
    in let st1 = st-append-code st (li reg-rdi pd-addr)
    in let st2 = emit-pd-entries st1 page-start code-end False False
    in let nx-start-offset = (code-end - page-start) * 8
    in let st3 = if code-end < page-end
      then let st2a = st-append-code st2 (li reg-rdi (pd-addr + nx-start-offset))
        in emit-pd-entries st2a code-end page-end True False
      else st2
    in emit-fill-pds st3 pml4-addr (i + 1)

  emit-build-process-page-tables : CodegenState, Integer, Integer -> CodegenState
  emit-build-process-page-tables (st) (pml4-addr) (heap-phys) =
   let zero-qwords = (2 + bare-metal-total-pd-count) * 512
   in let st1 = emit-zero-region st pml4-addr zero-qwords
   in let st2 = st-append-code st1 (li reg-rdi pml4-addr)
   in let st3 = st-append-code st2 (li reg-rax (pml4-addr + 4096 + 3))
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-rax 0)
   in let pdpt-addr = pml4-addr + 4096
   in let st5 = emit-pdpt-entries st4 pdpt-addr pml4-addr 0
   in let st6 = emit-fill-pds st5 pml4-addr 0
   in emit-fill-device-pd st6 pml4-addr

  emit-create-process : CodegenState, Integer, Integer, Integer, Integer -> CodegenState
  emit-create-process (st) (proc-index) (state-val) (cr3-val) (heap-base) =
   let entry-addr = proc-table-base + proc-index * proc-entry-size
   in let st1 = st-append-code st (li reg-rdi entry-addr)
   in let st2 = st-append-code st1 (li reg-rax state-val)
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 0)
   in let st4 = st-append-code st3 (li reg-rdi (entry-addr + 16))
   in let st5 = st-append-code st4 (li reg-rax cr3-val)
   in let st6 = st-append-code st5 (mov-store reg-rdi reg-rax 0)
   in let st7 = st-append-code st6 (li reg-rdi (entry-addr + 40))
   in let st8 = st-append-code st7 (li reg-rax heap-base)
   in let st9 = st-append-code st8 (mov-store reg-rdi reg-rax 0)
   in let st10 = st-append-code st9 (li reg-rdi (entry-addr + 48))
   in st-append-code st10 (mov-store reg-rdi reg-rax 0)

 Proc 0 starts RUNNING, because it is running.

 Pinned by codex/test/proc-state-running.codex.

 Proc 0's affinity is the boot processor, and the field used to say the
 opposite. It held -1, which in every other slot means "any core", while
 three separate guards elsewhere made sure no other core could ever have
 it: __idle_dispatch starts each core's scan at its own id and wraps to 1,
 so an application processor never reaches slot 0; and both preemption
 scans skip slot 0 outright when the claiming core is not the boot
 processor. So the declared policy and the enforced policy disagreed, and
 the register recorded the declaration -- proc-0 migration was written
 down as permitted-but-unproven when it was in fact forbidden in three
 places and could not happen.

 It is forbidden for a reason, and the reason is the boot stack. Slot 0
 owns the stack the machine booted on and the main heap; the guards were
 added deliberately, each with its own account of the corruption it
 prevents. The field now says what the machine does, which costs nothing
 -- on the boot processor the affinity test compares 0 against core 0 and
 passes exactly as the -1 wildcard did, and on every other core slot 0 was
 already unreachable -- and it removes a value that reads as a licence
 nothing honours.

 Pinned by codex/test/smp-proc0-pinned.codex, which reads the core stamp
 out of slot 0 after a multi-core run and requires it to still be the boot
 processor, with the application processors demonstrably busy at the time.

  emit-process-setup : CodegenState -> CodegenState
  emit-process-setup (st) =
   let st1 = emit-zero-region st proc-table-base (16 * proc-entry-size / 8)
   in let st1a = emit-zero-region st1 chan-table-base (chan-max-channels * chan-entry-size / 8)
   in let st1b = emit-zero-region st1a identity-table-base (16 * identity-entry-size / 8 + 4)
   in let st1c = emit-device-seed-init st1b
   in let st1d = emit-zero-region st1c identity-key-addr 6
   in let st1e = emit-ata-active-init st1d
   in let apd0 = st-append-code st1e (li reg-rdi ap-dispatch-count-addr)
   in let apd1 = st-append-code apd0 (li reg-rax 0)
   in let apd2 = st-append-code apd1 (mov-store reg-rdi reg-rax 0)
   in let app0 = st-append-code apd2 (li reg-rdi ap-preempt-count-addr)
   in let app1 = st-append-code app0 (li reg-rax 0)
   in let app2 = st-append-code app1 (mov-store reg-rdi reg-rax 0)
   in let dvc0 = st-append-code app2 (li reg-rdi devint-count-addr)
   in let dvc1 = st-append-code dvc0 (li reg-rax 0)
   in let dvc2 = st-append-code dvc1 (mov-store reg-rdi reg-rax 0)
   in let dvv0 = st-append-code dvc2 (li reg-rdi devint-last-vec-addr)
   in let dvv1 = st-append-code dvv0 (li reg-rax 0)
   in let dvv2 = st-append-code dvv1 (mov-store reg-rdi reg-rax 0)
   in let saff0 = st-append-code dvv2 (li reg-rdi spawn-affinity-addr)
   in let saff1 = st-append-code saff0 (li reg-rax (-1))
   in let saff2 = st-append-code saff1 (mov-store reg-rdi reg-rax 0)
   in let slt0 = st-append-code saff2 (li reg-rdi slice-table-addr)
   in let slt1 = st-append-code slt0 (li reg-rax 0)
   in let slt2 = st-append-code slt1 (mov-store reg-rdi reg-rax 0)
   in let slt3 = st-append-code slt2 (li reg-rax proc-slice-system)
   in let slt4 = st-append-code slt3 (mov-store reg-rdi reg-rax 8)
   in let slt5 = st-append-code slt4 (li reg-rax proc-slice-normal)
   in let slt6 = st-append-code slt5 (mov-store reg-rdi reg-rax 16)
   in let slt7 = st-append-code slt6 (li reg-rax proc-slice-background)
   in let slt8 = st-append-code slt7 (mov-store reg-rdi reg-rax 24)
   in let st5 = emit-build-process-page-tables slt8 32768 6291456
   in let st5u = emit-demand-unmap st5
   in let st6 = emit-create-process st5u 0 proc-state-running 32768 6291456
   in let p0aff0 = st-append-code st6 (li reg-rdi (proc-table-base + proc-affinity-offset))
   in let p0aff1 = st-append-code p0aff0 (li reg-rax 0)
   in let p0aff2 = st-append-code p0aff1 (mov-store reg-rdi reg-rax 0)
   in let st7 = st-append-code p0aff2 (li reg-rax 32768)
   in let st8 = st-append-code st7 [15, 34, 216]
   in st-append-code st8 (li reg-r10 6291456)

Section: Device Seed
  emit-device-seed-init : CodegenState -> CodegenState
  emit-device-seed-init (st) =
   let st0 = st-append-code st (li reg-rdi device-seed-addr)
   in let st1 = emit-rdrand-store st0 0
   in let st2 = emit-rdrand-store st1 8
   in let st3 = emit-rdrand-store st2 16
   in emit-rdrand-store st3 24

  emit-rdrand-store : CodegenState, Integer -> CodegenState
  emit-rdrand-store (st) (offset) =
   let retry = st.code-len
   in let st1 = st-append-code st [72, 15, 199, 240]
   in let st2 = st-append-code st1 (jcc cc-ae (retry - (st1.code-len + 6)))
   in st-append-code st2 (mov-store reg-rdi reg-rax offset)

Section: Capabilities

 emit-grant-cap-mask writes a whole capability mask in one or-store --
 the boot path grants proc 0 exactly the mask derived from the
 binary's own manifest (stage 4 of the capability wiring: authority
 comes from the declared effect rows, not a grant-all list).

  emit-grant-cap-mask : CodegenState, Integer, Integer -> CodegenState
  emit-grant-cap-mask (st) (proc-index) (mask) =
   let cap-addr = proc-table-base + proc-index * proc-entry-size + proc-cap-offset
   in let st1 = st-append-code st (li reg-rdi cap-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rdi 0)
   in let st3 = st-append-code st2 (or-ri reg-rax mask)
   in st-append-code st3 (mov-store reg-rdi reg-rax 0)

  emit-grant-capability : CodegenState, Integer, Integer -> CodegenState
  emit-grant-capability (st) (proc-index) (cap-bit) =
   let cap-addr = proc-table-base + proc-index * proc-entry-size + proc-cap-offset
   in let st1 = st-append-code st (li reg-rdi cap-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rdi 0)
   in let bit-mask = shl-1 cap-bit
   in let st3 = st-append-code st2 (or-ri reg-rax bit-mask)
   in st-append-code st3 (mov-store reg-rdi reg-rax 0)

  emit-revoke-capability : CodegenState, Integer, Integer -> CodegenState
  emit-revoke-capability (st) (proc-index) (cap-bit) =
   let cap-addr = proc-table-base + proc-index * proc-entry-size + proc-cap-offset
   in let st1 = st-append-code st (li reg-rdi cap-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rdi 0)
   in let inv-mask = bit-xor (shl-1 cap-bit) (0 - 1)
   in let st3 = st-append-code st2 (and-ri reg-rax inv-mask)
   in st-append-code st3 (mov-store reg-rdi reg-rax 0)

  shl-1 : Integer -> Integer
  shl-1 (n) =
   if n == 0 then 1
   else 2 * shl-1 (n - 1)

  emit-boot-probe-factstore : CodegenState -> CodegenState
  emit-boot-probe-factstore (st) =
   let st0 = st-append-code st (li reg-rdi boot-factstore-addr)
   in let st1 = st-append-code st0 (xor-rr reg-rax reg-rax)
   in let st2 = st-append-code st1 (mov-store reg-rdi reg-rax 0)
   in let st3 = st-append-code st2 (li reg-rdi ata-sector-count-addr)
   in let st4 = st-append-code st3 (mov-load reg-rax reg-rdi 0)
   in let st5 = st-append-code st4 (test-rr reg-rax reg-rax)
   in let no-disk = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let st7 = emit-ata-read-sector-zero st6
   in let st8 = st-append-code st7 (li reg-rdi ata-identify-buf-addr)
   in let st9 = st-append-code st8 (movzx-byte reg-rax reg-rdi 0)
   in let st10 = st-append-code st9 (cmp-ri reg-rax 50)
   in let no-magic = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-ne 0)
   in let st12 = st-append-code st11 (movzx-byte reg-rax reg-rdi 1)
   in let st13 = st-append-code st12 (cmp-ri reg-rax 42)
   in let nm1 = st13.code-len
   in let st14 = st-append-code st13 (jcc cc-ne 0)
   in let st15 = st-append-code st14 (movzx-byte reg-rax reg-rdi 2)
   in let st16 = st-append-code st15 (cmp-ri reg-rax 48)
   in let nm2 = st16.code-len
   in let st17 = st-append-code st16 (jcc cc-ne 0)
   in let st18 = st-append-code st17 (movzx-byte reg-rax reg-rdi 3)
   in let st19 = st-append-code st18 (cmp-ri reg-rax 39)
   in let nm3 = st19.code-len
   in let st20 = st-append-code st19 (jcc cc-ne 0)
   in let st21 = st-append-code st20 (movzx-byte reg-rax reg-rdi 4)
   in let st22 = st-append-code st21 (cmp-ri reg-rax 62)
   in let nm4 = st22.code-len
   in let st23 = st-append-code st22 (jcc cc-ne 0)
   in let st24 = st-append-code st23 (movzx-byte reg-rax reg-rdi 5)
   in let st25 = st-append-code st24 (cmp-ri reg-rax 54)
   in let nm5 = st25.code-len
   in let st26 = st-append-code st25 (jcc cc-ne 0)
   in let st27 = st-append-code st26 (movzx-byte reg-rax reg-rdi 6)
   in let st28 = st-append-code st27 (cmp-ri reg-rax 45)
   in let nm6 = st28.code-len
   in let st29 = st-append-code st28 (jcc cc-ne 0)
   in let st30 = st-append-code st29 (movzx-byte reg-rax reg-rdi 7)
   in let st31 = st-append-code st30 (cmp-ri reg-rax 4)
   in let nm7 = st31.code-len
   in let st32 = st-append-code st31 (jcc cc-ne 0)
   in let st33 = st-append-code st32 (li reg-rdi boot-factstore-addr)
   in let st34 = st-append-code st33 (li reg-rax 1)
   in let st35 = st-append-code st34 (mov-store reg-rdi reg-rax 0)
   in let done-pos = st35.code-len
   in let st36 = patch-jcc-at st35 no-disk done-pos
   in let st37 = patch-jcc-at st36 no-magic done-pos
   in let st38 = patch-jcc-at st37 nm1 done-pos
   in let st39 = patch-jcc-at st38 nm2 done-pos
   in let st40 = patch-jcc-at st39 nm3 done-pos
   in let st41 = patch-jcc-at st40 nm4 done-pos
   in let st42 = patch-jcc-at st41 nm5 done-pos
   in let st43 = patch-jcc-at st42 nm6 done-pos
   in patch-jcc-at st43 nm7 done-pos

  emit-ata-read-sector-zero : CodegenState -> CodegenState
  emit-ata-read-sector-zero (st) =
   let st1 = st-append-code st (li reg-rax 0)
   in let st2 = emit-ata-port st1 ata-off-sector-count
   in let st3 = st-append-code st2 (li reg-rax 1)
   in let st4 = st-append-code st3 out-dx-al
   in let st5 = emit-ata-port st4 ata-off-lba-low
   in let st6 = st-append-code st5 (li reg-rax 0)
   in let st7 = st-append-code st6 out-dx-al
   in let st8 = emit-ata-port st7 ata-off-lba-mid
   in let st9 = st-append-code st8 out-dx-al
   in let st10 = emit-ata-port st9 ata-off-lba-high
   in let st11 = st-append-code st10 out-dx-al
   in let st12 = emit-ata-port st11 ata-off-drive-head
   in let st13 = emit-ata-select-al st12
   in let st14 = st-append-code st13 out-dx-al
   in let st15 = st-append-code st14 (li reg-rax ata-read-cmd)
   in let st16 = emit-ata-port st15 ata-off-status
   in let st17 = st-append-code st16 out-dx-al
   in let st18 = emit-ata-wait-drq st17
   in let st19 = st-append-code st18 (li reg-rdi ata-identify-buf-addr)
   in let st20 = emit-ata-port st19 0
   in let st21 = st-append-code st20 (li reg-rcx 256)
   in let st22 = st-append-code st21 [252]
   in st-append-code st22 rep-insw

Section: MSR and Syscall
  emit-write-msr : CodegenState, Integer, Integer -> CodegenState
  emit-write-msr (st) (msr-addr) (value) =
   let low32 = int-mod value 4294967296
   in let high32 = value / 4294967296
   in let st1 = st-append-code st (li reg-rcx msr-addr)
   in let st2 = st-append-code st1 (li reg-rax low32)
   in let st3 = st-append-code st2 (li reg-rdx high32)
   in st-append-code st3 [15, 48]

  SyscallResult = record {
   state : CodegenState,
   handler-offset : Integer between 0 and 4294967295
  }

  CheckExpiryResult = record {
   state : CodegenState,
   deny-offset : Integer between 0 and 4294967295
  }

 The GPU rasterizer is reached through I/O ports 0x400-0x417 and
 through nothing else: gr-flush, gr-clear and the texture and asset
 chain in the apps are all port-out-32 / port-in-32 to that window.
 It is therefore the window, not the builtin, that carries the GPU
 authority. emit-gpu-port-guard tests cap-gpu-compute when and only
 when the port in RDI falls inside it; every other port -- the PCI
 config pair at 0xCF8/0xCFC, and every byte-width driver port -- runs
 the check-free path, so the drivers are untouched.

 Gating the builtin wholesale was the obvious move and it is wrong:
 the drivers live in effect-exempt quires (Kernel, Dev, Os, Net,
 Boards), so they touch ports without declaring Device.Port and their
 programs never earn cap-device. xhci-discover-test, nic-ping and
 vga-terminal-demo declare only [Console] and drive real hardware.
 A blanket port gate denies all three. Ranging the check on the GPU
 window is what lets the gate exist at all.

 RDI (port) and RSI (value) are preserved: the guard reads the cap
 word through RAX, which both port helpers overwrite afterwards.

  gpu-port-lo : Integer = 1024
  gpu-port-hi : Integer = 1047

  emit-gpu-port-guard : CodegenState -> CheckExpiryResult
  emit-gpu-port-guard (st) =
   let st1 = st-append-code st (cmp-ri reg-rdi gpu-port-lo)
   in let below = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-l 0)
   in let st3 = st-append-code st2 (cmp-ri reg-rdi gpu-port-hi)
   in let beyond = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-g 0)
   in let st6 = emit-load-current-proc st4 reg-rax
   in let st7 = st-append-code st6 (shl-ri reg-rax 8)
   in let st8 = st-append-code st7 (add-ri reg-rax proc-table-base)
   in let st9 = st-append-code st8 (mov-load reg-rax reg-rax proc-cap-offset)
   in let st10 = st-append-code st9 (and-ri reg-rax (shl-1 cap-gpu-compute))
   in let st11 = st-append-code st10 (test-rr reg-rax reg-rax)
   in let deny = st11.code-len
   in let st12 = st-append-code st11 (jcc cc-e 0)
   in let pass = st12.code-len
   in let st13 = patch-jcc-at st12 below pass
   in let st14 = patch-jcc-at st13 beyond pass
   in CheckExpiryResult { state = st14, deny-offset = deny }

 GPU memory is the same argument as the GPU ports, one level down. The
 rasterizer's command buffer is at 0xBE000000 and its depth buffer at
 0xBE800000, and every writer of them -- GpuRender, and the apps that
 compose their own command buffers -- reaches them with poke-32 and
 peek-32. So the window carries the authority, and emit-gpu-mem-guard
 tests cap-gpu-memory when and only when the effective address falls
 inside it. gpu-mem-write and gpu-mem-read are the typed surface over
 the same two helpers, exactly as gpu-out and gpu-in are over the port
 pair: the row is what makes the requirement visible at compile time
 rather than at the refusal.

 The GOP framebuffer at 0xBF000000 is deliberately OUTSIDE the window.
 It is the display, not the GPU, and every widget and text-mode app
 writes it directly; gating it would deny the whole desk to earn
 nothing.

 This guard is shaped for a hot path and the port guard is not, which
 is the only reason the two do not read alike. port-out-32 runs when a
 program talks to a device, which is rare. peek-32 and poke-32 are the
 compiler's own memo-table primitives -- some two dozen sites in
 Unifier.codex -- so they run on every unification of a self-compile,
 and a bounds pair built from two movabs immediates would tax all of
 that to police a window the compiler never touches. The window is one
 aligned 16 MB page, so the test is its top byte: shift right by 24 and
 compare with 0xBE. Three cheap ALU ops on a perfectly-predicted
 branch, no memory read, and the capability word is only fetched by a
 caller that is actually inside the window.

  gpu-mem-page : Integer = 190

  emit-gpu-mem-guard : CodegenState -> CheckExpiryResult
  emit-gpu-mem-guard (st) =
   let st1 = st-append-code st (mov-rr reg-rax reg-rdi)
   in let st2 = st-append-code st1 (shr-ri reg-rax 24)
   in let st3 = st-append-code st2 (cmp-ri reg-rax gpu-mem-page)
   in let outside = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = emit-load-current-proc st4 reg-rax
   in let st6 = st-append-code st5 (shl-ri reg-rax 8)
   in let st7 = st-append-code st6 (add-ri reg-rax proc-table-base)
   in let st8 = st-append-code st7 (mov-load reg-rax reg-rax proc-cap-offset)
   in let st9 = st-append-code st8 (and-ri reg-rax (shl-1 cap-gpu-memory))
   in let st10 = st-append-code st9 (test-rr reg-rax reg-rax)
   in let deny = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-e 0)
   in let pass = st11.code-len
   in let st12 = patch-jcc-at st11 outside pass
   in CheckExpiryResult { state = st12, deny-offset = deny }

  emit-check-expiry : CodegenState -> CheckExpiryResult
  emit-check-expiry (st) =
   let st1 = st-append-code st (push-r reg-rdi)
   in let st2 = st-append-code st1 (push-r reg-rsi)
   in let st3 = st-append-code st2 (li reg-rdi cap-expiry-addr)
   in let st4 = st-append-code st3 (mov-load reg-rdi reg-rdi 0)
   in let st5 = st-append-code st4 (test-rr reg-rdi reg-rdi)
   in let no-expiry-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let st7 = st-append-code st6 (li reg-rsi tick-count-addr)
   in let st8 = st-append-code st7 (mov-load reg-rsi reg-rsi 0)
   in let st9 = st-append-code st8 (cmp-rr reg-rsi reg-rdi)
   in let expired-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-ae 0)
   in let st11 = patch-jcc-at st10 no-expiry-pos (st10.code-len)
   in let st12 = st-append-code st11 (pop-r reg-rsi)
   in let st13 = st-append-code st12 (pop-r reg-rdi)
   in CheckExpiryResult { state = st13, deny-offset = expired-pos }

  emit-check-capability : CodegenState, Integer -> CodegenState
  emit-check-capability (st) (cap-bit) =
   let st1 = st-append-code st (push-r reg-rcx)
   in let st2 = st-append-code st1 (push-r reg-r11)
   in let st4 = emit-load-current-proc st2 reg-r11
   in let st5 = st-append-code st4 (li reg-rcx proc-entry-size)
   in let st6 = st-append-code st5 (imul-rr reg-rcx reg-r11)
   in let st7 = st-append-code st6 (add-ri reg-rcx proc-table-base)
   in let st8 = st-append-code st7 (add-ri reg-rcx proc-cap-offset)
   in let st9 = st-append-code st8 (mov-load reg-rcx reg-rcx 0)
   in let st10 = st-append-code st9 [72, 15, 186, 225, cap-bit]
   in let st11 = st-append-code st10 (pop-r reg-r11)
   in st-append-code st11 (pop-r reg-rcx)

  emit-syscall-handler : CodegenState -> SyscallResult
  emit-syscall-handler (st) =
   let handler-offset = st.code-len
   in let st-rec = record-func-offset st "__syscall_handler"
   in let st1 = st-append-code st-rec (push-r reg-rcx)
   in let st2 = st-append-code st1 (push-r reg-r11)
   in let st3 = st-append-code st2 (cmp-ri reg-rax 1)
   in let not-write = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (mov-rr reg-rdx reg-rdi)
   in let st6 = emit-check-capability st5 cap-console-write
   in let no-write-cap = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-ae 0)
   in let expiry = emit-check-expiry st7
   in let st8 = st-append-code (expiry.state) (mov-rr reg-rax reg-rdx)
   in let st9 = st-append-code st8 (li reg-rdx 1016)
   in let st10 = st-append-code st9 out-dx-al
   in let st10a = patch-jcc-at st10 no-write-cap (st10.code-len)
   in let st11 = patch-jcc-at st10a (expiry.deny-offset) (st10a.code-len)
   in let st12 = st-append-code st11 (li reg-rax 0)
   in let write-done = st12.code-len
   in let st13 = st-append-code st12 (jmp 0)
   in let st14 = patch-jcc-at st13 not-write (st13.code-len)
   in let st15 = st-append-code st14 (cmp-ri reg-rax 2)
   in let not-read-key = st15.code-len
   in let st16 = st-append-code st15 (jcc cc-ne 0)
   in let st16a = emit-check-capability st16 cap-console-read
   in let no-read-cap = st16a.code-len
   in let st16b = st-append-code st16a (jcc cc-ae 0)
   in let st17 = st-append-code st16b (li reg-rdi key-buffer-addr)
   in let st18 = st-append-code st17 (mov-load reg-rax reg-rdi 0)
   in let read-done = st18.code-len
   in let st19 = st-append-code st18 (jmp 0)
   in let st19a = patch-jcc-at st19 no-read-cap (st19.code-len)
   in let st20 = patch-jcc-at st19a not-read-key (st19a.code-len)
   in let st21 = st-append-code st20 (cmp-ri reg-rax 3)
   in let not-get-ticks = st21.code-len
   in let st22 = st-append-code st21 (jcc cc-ne 0)
   in let st23 = st-append-code st22 (li reg-rdi tick-count-addr)
   in let st24 = st-append-code st23 (mov-load reg-rax reg-rdi 0)
   in let ticks-done = st24.code-len
   in let st25 = st-append-code st24 (jmp 0)
   in let st26 = patch-jcc-at st25 not-get-ticks (st25.code-len)
   in let st-br = emit-block-read-syscall st26
   in let st-bw = emit-block-write-syscall (st-br.state)
   in let st-bsc = emit-block-sector-count-syscall (st-bw.state)
   in let st-bsel = emit-block-select-syscall (st-bsc.state)
   in let st-kl = emit-key-load-syscall (st-bsel.state)
   in let st-kz = emit-key-zero-syscall (st-kl.state)
   in let st-ks = emit-key-status-syscall (st-kz.state)
   in let st27 = st-append-code (st-ks.state) (li reg-rax (-1))
   in let common-exit = st27.code-len
   in let st27a = patch-jmp-at st27 (st-br.done-jmp) common-exit
   in let st27b = patch-jmp-at st27a (st-bw.done-jmp) common-exit
   in let st27c = patch-jmp-at st27b (st-bsc.done-jmp) common-exit
   in let st27c2 = patch-jmp-at st27c (st-bsel.done-jmp) common-exit
   in let st27d = patch-jmp-at st27c2 (st-kl.done-jmp) common-exit
   in let st27e = patch-jmp-at st27d (st-kz.done-jmp) common-exit
   in let st27f = patch-jmp-at st27e (st-ks.done-jmp) common-exit
   in let st28 = patch-jmp-at st27f write-done common-exit
   in let st29 = patch-jmp-at st28 read-done common-exit
   in let st30 = patch-jmp-at st29 ticks-done common-exit
   in let st31 = st-append-code st30 (pop-r reg-r11)
   in let st32 = st-append-code st31 (pop-r reg-rcx)
   in let st33 = st-append-code st32 (push-r reg-r11)
   in let st34 = st-append-code st33 [157]
   in let st35 = st-append-code st34 [255, 225]
   in SyscallResult {
    state = st35,
    handler-offset = handler-offset
  }

  BlockSyscallResult = record {
   state : CodegenState,
   done-jmp : Integer between 0 and 4294967295
  }

 Every block syscall (10 read, 11 write, 12 sector count, 13 select)
 consults the capability word before touching the device: a process
 without the block-device bit branches to the handler's not-match
 target, falls through the dispatch chain unmatched, and returns -1
 from the common exit -- the device is never driven.

 The block-authority gate widens the plain cap-block-device test so that a
 syscall also proceeds when the fs-elevated cell is non-zero -- the
 filesystem servicer driving the disk for a process that carries only
 FileSystem.Read. The returned deny-offset is the jcc the
 caller patches to its shared no-cap exit; it fires only when BOTH the bit
 is clear AND fs-elevated is zero. rax is free here (it held the syscall
 number, overwritten by the disk code below), and emit-check-capability
 preserves rcx/r11 and never touches rdi/rsi, so the live LBA and buffer
 arguments survive the gate.

  emit-block-elev-gate : CodegenState -> CheckExpiryResult
  emit-block-elev-gate (st) =
   let stc = emit-check-capability st cap-block-device
   in let to-elev = stc.code-len
   in let st1 = st-append-code stc (jcc cc-ae 0)
   in let to-proceed = st1.code-len
   in let st2 = st-append-code st1 (jmp 0)
   in let elev = st2.code-len
   in let st3 = st-append-code st2 (li reg-rax fs-elevated-addr)
   in let st4 = st-append-code st3 (mov-load reg-rax reg-rax 0)
   in let st5 = st-append-code st4 (test-rr reg-rax reg-rax)
   in let deny = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let proceed = st6.code-len
   in let st7 = patch-jcc-at st6 to-elev elev
   in let st8 = patch-jmp-at st7 to-proceed proceed
   in CheckExpiryResult { state = st8, deny-offset = deny }

  emit-block-read-syscall : CodegenState -> BlockSyscallResult
  emit-block-read-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 10)
   in let not-block-read = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-block-elev-gate st2
   in let no-block-cap = stc.deny-offset
   in let st2a = stc.state
   in let st3 = st-append-code st2a (push-r reg-rsi)
   in let st4 = st-append-code st3 (push-r reg-rcx)
   in let st5 = emit-ata-setup-lba st4
   in let st6 = st-append-code st5 (li reg-rax ata-read-cmd)
   in let st7 = emit-ata-port st6 ata-off-status
   in let st8 = st-append-code st7 out-dx-al
   in let st9 = emit-ata-wait-drq st8
   in let st10 = st-append-code st9 (pop-r reg-rcx)
   in let st11 = st-append-code st10 (pop-r reg-rdi)
   in let st12 = emit-ata-port st11 0
   in let st13 = st-append-code st12 (li reg-rcx 256)
   in let st13a = st-append-code st13 [252]
   in let st14 = st-append-code st13a rep-insw
   in let st15 = st-append-code st14 (li reg-rax 0)
   in let done = st15.code-len
   in let st16 = st-append-code st15 (jmp 0)
   in let st17 = patch-jcc-at st16 not-block-read (st16.code-len)
   in let st18 = patch-jcc-at st17 no-block-cap (st17.code-len)
   in BlockSyscallResult { state = st18, done-jmp = done }

  emit-block-write-syscall : CodegenState -> BlockSyscallResult
  emit-block-write-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 11)
   in let not-block-write = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-block-elev-gate st2
   in let no-block-cap = stc.deny-offset
   in let st2a = stc.state
   in let st3 = st-append-code st2a (push-r reg-rsi)
   in let st4 = st-append-code st3 (push-r reg-rcx)
   in let st5 = emit-ata-setup-lba st4
   in let st6 = st-append-code st5 (li reg-rax ata-write-cmd)
   in let st7 = emit-ata-port st6 ata-off-status
   in let st8 = st-append-code st7 out-dx-al
   in let st9 = emit-ata-wait-drq st8
   in let st10 = st-append-code st9 (pop-r reg-rcx)
   in let st11 = st-append-code st10 (pop-r reg-rsi)
   in let st12 = emit-ata-port st11 0
   in let st13 = st-append-code st12 (li reg-rcx 256)
   in let st13b = st-append-code st13 [252]
   in let st14 = st-append-code st13b rep-outsw
   in let st14a = emit-ata-400ns-delay st14
   in let st14b = emit-ata-wait-ready st14a
   in let st14c = st-append-code st14b (li reg-rax ata-flush-cmd)
   in let st14d = emit-ata-port st14c ata-off-status
   in let st14e = st-append-code st14d out-dx-al
   in let st15 = emit-ata-wait-ready (emit-ata-400ns-delay st14e)
   in let st19 = st-append-code st15 (li reg-rax 0)
   in let done = st19.code-len
   in let st20 = st-append-code st19 (jmp 0)
   in let st21 = patch-jcc-at st20 not-block-write (st20.code-len)
   in let st22 = patch-jcc-at st21 no-block-cap (st21.code-len)
   in BlockSyscallResult { state = st22, done-jmp = done }

  emit-block-sector-count-syscall : CodegenState -> BlockSyscallResult
  emit-block-sector-count-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 12)
   in let not-block-sector-count = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-block-elev-gate st2
   in let no-block-cap = stc.deny-offset
   in let st2a = stc.state
   in let st3 = st-append-code st2a (li reg-rdi ata-sector-count-addr)
   in let st4 = st-append-code st3 (mov-load reg-rax reg-rdi 0)
   in let done = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 not-block-sector-count (st5.code-len)
   in let st7 = patch-jcc-at st6 no-block-cap (st6.code-len)
   in BlockSyscallResult { state = st7, done-jmp = done }

  emit-ata-active-init : CodegenState -> CodegenState
  emit-ata-active-init (st) =
   let st1 = st-append-code st (li reg-rdi ata-active-drive-addr)
   in let st2 = st-append-code st1 (li reg-rax 0)
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 0)
   in let st4 = st-append-code st3 (li reg-rdi ata-active-base-addr)
   in let st5 = st-append-code st4 (li reg-rax ata-data-port)
   in let st6 = st-append-code st5 (mov-store reg-rdi reg-rax 0)
   in let st7 = st-append-code st6 (li reg-rdi ata-active-ctrl-addr)
   in let st8 = st-append-code st7 (li reg-rax ata-control-port)
   in let st9 = st-append-code st8 (mov-store reg-rdi reg-rax 0)
   in let st10 = st-append-code st9 (li reg-rdi ata-active-select-addr)
   in let st11 = st-append-code st10 (li reg-rax 224)
   in st-append-code st11 (mov-store reg-rdi reg-rax 0)

  emit-block-select-syscall : CodegenState -> BlockSyscallResult
  emit-block-select-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 13)
   in let not-block-select = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-block-elev-gate st2
   in let no-block-cap = stc.deny-offset
   in let st2a = stc.state
   in let st3 = st-append-code st2a (push-r reg-rdi)
   in let st4 = st-append-code st3 (li reg-rsi ata-active-drive-addr)
   in let st5 = st-append-code st4 (mov-store reg-rsi reg-rdi 0)
   in let st6 = st-append-code st5 (mov-rr reg-rax reg-rdi)
   in let st7 = st-append-code st6 (and-ri reg-rax 1)
   in let st9 = st-append-code st7 (shl-ri reg-rax 4)
   in let st10 = st-append-code st9 (add-ri reg-rax 224)
   in let st11 = st-append-code st10 (li reg-rsi ata-active-select-addr)
   in let st12 = st-append-code st11 (mov-store reg-rsi reg-rax 0)
   in let st13 = st-append-code st12 (pop-r reg-rdi)
   in let st14 = st-append-code st13 (mov-rr reg-rax reg-rdi)
   in let st15 = st-append-code st14 [72, 193, 232, 1]
   in let st16 = st-append-code st15 (test-rr reg-rax reg-rax)
   in let primary = st16.code-len
   in let st17 = st-append-code st16 (jcc cc-e 0)
   in let st18 = st-append-code st17 (li reg-rax 368)
   in let st19 = st-append-code st18 (li reg-rcx 886)
   in let sec-done = st19.code-len
   in let st20 = st-append-code st19 (jmp 0)
   in let st21 = patch-jcc-at st20 primary (st20.code-len)
   in let st22 = st-append-code st21 (li reg-rax ata-data-port)
   in let st23 = st-append-code st22 (li reg-rcx ata-control-port)
   in let st24 = patch-jmp-at st23 sec-done (st23.code-len)
   in let st25 = st-append-code st24 (li reg-rsi ata-active-base-addr)
   in let st26 = st-append-code st25 (mov-store reg-rsi reg-rax 0)
   in let st27 = st-append-code st26 (li reg-rsi ata-active-ctrl-addr)
   in let st28 = st-append-code st27 (mov-store reg-rsi reg-rcx 0)
   in let st28a = emit-ata-detect-identify st28
   in let st29 = st-append-code st28a (li reg-rax 0)
   in let done = st29.code-len
   in let st30 = st-append-code st29 (jmp 0)
   in let st31 = patch-jcc-at st30 not-block-select (st30.code-len)
   in let st32 = patch-jcc-at st31 no-block-cap (st31.code-len)
   in BlockSyscallResult { state = st32, done-jmp = done }

 The key syscalls (15 load, 16 zero, 18 status) guard the pinned
 identity key the same way the block syscalls guard the disk: the
 capability word is consulted before the key region is touched, and
 a process without the identity bit falls through the dispatch chain
 to the -1 return.

  emit-key-load-syscall : CodegenState -> BlockSyscallResult
  emit-key-load-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 15)
   in let not-key-load = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-check-capability st2 cap-identity
   in let no-identity-cap = stc.code-len
   in let st2a = st-append-code stc (jcc cc-ae 0)
   in let st3 = st-append-code st2a (push-r reg-rcx)
   in let st4 = st-append-code st3 (push-r reg-rsi)
   in let st5 = st-append-code st4 (mov-rr reg-rsi reg-rdi)
   in let st6 = st-append-code st5 (li reg-rdi identity-key-addr)
   in let st7 = st-append-code st6 (li reg-rcx 4)
   in let st8 = st-append-code st7 [252]
   in let st9 = st-append-code st8 [243, 72, 165]
   in let st10 = st-append-code st9 (pop-r reg-rsi)
   in let st11 = st-append-code st10 (pop-r reg-rcx)
   in let st12 = st-append-code st11 (li reg-rdi identity-key-loaded-addr)
   in let st13 = st-append-code st12 (li reg-rax 1)
   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rax 0)
   in let st15 = st-append-code st14 (li reg-rax 0)
   in let done = st15.code-len
   in let st16 = st-append-code st15 (jmp 0)
   in let st17 = patch-jcc-at st16 not-key-load (st16.code-len)
   in let st18 = patch-jcc-at st17 no-identity-cap (st17.code-len)
   in BlockSyscallResult { state = st18, done-jmp = done }

  emit-key-zero-syscall : CodegenState -> BlockSyscallResult
  emit-key-zero-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 16)
   in let not-key-zero = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-check-capability st2 cap-identity
   in let no-identity-cap = stc.code-len
   in let st2a = st-append-code stc (jcc cc-ae 0)
   in let st3 = st-append-code st2a (li reg-rdi identity-key-addr)
   in let st4 = st-append-code st3 (li reg-rax 0)
   in let st5 = st-append-code st4 (mov-store reg-rdi reg-rax 0)
   in let st6 = st-append-code st5 (mov-store reg-rdi reg-rax 8)
   in let st7 = st-append-code st6 (mov-store reg-rdi reg-rax 16)
   in let st8 = st-append-code st7 (mov-store reg-rdi reg-rax 24)
   in let st9 = st-append-code st8 (li reg-rdi identity-key-loaded-addr)
   in let st10 = st-append-code st9 (mov-store reg-rdi reg-rax 0)
   in let st11 = st-append-code st10 (li reg-rdi identity-lock-tick-addr)
   in let st12 = st-append-code st11 (mov-store reg-rdi reg-rax 0)
   in let done = st12.code-len
   in let st13 = st-append-code st12 (jmp 0)
   in let st14 = patch-jcc-at st13 not-key-zero (st13.code-len)
   in let st15 = patch-jcc-at st14 no-identity-cap (st14.code-len)
   in BlockSyscallResult { state = st15, done-jmp = done }

  emit-key-status-syscall : CodegenState -> BlockSyscallResult
  emit-key-status-syscall (st) =
   let st1 = st-append-code st (cmp-ri reg-rax 18)
   in let not-key-status = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let stc = emit-check-capability st2 cap-identity
   in let no-identity-cap = stc.code-len
   in let st2a = st-append-code stc (jcc cc-ae 0)
   in let st3 = st-append-code st2a (li reg-rdi identity-key-loaded-addr)
   in let st4 = st-append-code st3 (mov-load reg-rax reg-rdi 0)
   in let done = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 not-key-status (st5.code-len)
   in let st7 = patch-jcc-at st6 no-identity-cap (st6.code-len)
   in BlockSyscallResult { state = st7, done-jmp = done }

  ata-control-port : Integer = 1014

 Every port below is reached through the ACTIVE drive's base rather than through
 the primary channel's literal address, and the drive is selected with the
 active select byte rather than a hardcoded master.

  emit-ata-port : CodegenState, Integer -> CodegenState
  emit-ata-port (st) (off) =
   let st1 = st-append-code st (li reg-rdx ata-active-base-addr)
   in let st2 = st-append-code st1 (mov-load reg-rdx reg-rdx 0)
   in if off == 0 then st2 else st-append-code st2 (add-ri reg-rdx off)

  emit-ata-ctrl-port : CodegenState -> CodegenState
  emit-ata-ctrl-port (st) =
   let st1 = st-append-code st (li reg-rdx ata-active-ctrl-addr)
   in st-append-code st1 (mov-load reg-rdx reg-rdx 0)

  emit-ata-select-al : CodegenState -> CodegenState
  emit-ata-select-al (st) =
   let st1 = st-append-code st (li reg-rax ata-active-select-addr)
   in st-append-code st1 (mov-load reg-rax reg-rax 0)

  ata-off-sector-count : Integer = 2
  ata-off-lba-low : Integer = 3
  ata-off-lba-mid : Integer = 4
  ata-off-lba-high : Integer = 5
  ata-off-drive-head : Integer = 6
  ata-off-status : Integer = 7

  emit-ata-soft-reset : CodegenState -> CodegenState
  emit-ata-soft-reset (st) =
   let st1 = emit-ata-ctrl-port st
   in let st2 = st-append-code st1 (li reg-rax 4)
   in let st3 = st-append-code st2 out-dx-al
   in let st4 = emit-ata-400ns-delay st3
   in let st5 = emit-ata-ctrl-port st4
   in let st6 = st-append-code st5 (li reg-rax 2)
   in let st7 = st-append-code st6 out-dx-al
   in emit-ata-400ns-delay st7

  emit-ata-setup-lba : CodegenState -> CodegenState
  emit-ata-setup-lba (st) =
   let st1 = emit-ata-wait-ready st
   in let st2 = emit-ata-port st1 ata-off-drive-head
   in let st3 = emit-ata-select-al st2
   in let st4 = st-append-code st3 out-dx-al
   in let st5 = emit-ata-400ns-delay st4
   in let st6 = emit-ata-wait-ready st5
   in let st7 = emit-ata-port st6 ata-off-sector-count
   in let st8 = st-append-code st7 (li reg-rax 1)
   in let st9 = st-append-code st8 out-dx-al
   in let st10 = emit-ata-port st9 ata-off-lba-low
   in let st11 = st-append-code st10 (mov-rr reg-rax reg-rdi)
   in let st12 = st-append-code st11 out-dx-al
   in let st13 = emit-ata-port st12 ata-off-lba-mid
   in let st14 = st-append-code st13 (mov-rr reg-rax reg-rdi)
   in let st15 = st-append-code st14 [72, 193, 232, 8]
   in let st16 = st-append-code st15 out-dx-al
   in let st17 = emit-ata-port st16 ata-off-lba-high
   in let st18 = st-append-code st17 (mov-rr reg-rax reg-rdi)
   in let st19 = st-append-code st18 [72, 193, 232, 16]
   in st-append-code st19 out-dx-al

  emit-ata-400ns-delay : CodegenState -> CodegenState
  emit-ata-400ns-delay (st) =
   let st1 = emit-ata-ctrl-port st
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 in-al-dx
   in let st4 = st-append-code st3 in-al-dx
   in st-append-code st4 in-al-dx

  emit-ata-wait-ready : CodegenState -> CodegenState
  emit-ata-wait-ready (st) =
   let loop-top = st.code-len
   in let st1 = emit-ata-port st ata-off-status
   in let st2 = st-append-code st1 in-al-dx
   in let stg1 = st-append-code st2 [60, ata-status-floating]
   in let float-pos = stg1.code-len
   in let stg2 = st-append-code stg1 (jcc cc-e 0)
   in let stg3 = st-append-code stg2 [60, ata-status-empty]
   in let empty-pos = stg3.code-len
   in let stg4 = st-append-code stg3 (jcc cc-e 0)
   in let st3 = st-append-code stg4 [168, ata-status-bsy]
   in let bsy-jcc = st3.code-len
   in let st4 = patch-jcc-at (st-append-code st3 (jcc cc-ne 0)) bsy-jcc loop-top
   in let ste1 = st-append-code st4 [168, ata-status-err]
   in let err-pos = ste1.code-len
   in let ste2 = st-append-code ste1 (jcc cc-ne 0)
   in let st5 = st-append-code ste2 [168, ata-status-drdy]
   in let rdy-jcc = st5.code-len
   in let st6 = patch-jcc-at (st-append-code st5 (jcc cc-e 0)) rdy-jcc loop-top
   in let endp = st6.code-len
   in let st7 = patch-jcc-at st6 float-pos endp
   in let st8 = patch-jcc-at st7 empty-pos endp
   in patch-jcc-at st8 err-pos endp

  emit-ata-wait-drq : CodegenState -> CodegenState
  emit-ata-wait-drq (st) =
   let st1 = emit-ata-400ns-delay st
   in let loop-top = st1.code-len
   in let st2 = emit-ata-port st1 ata-off-status
   in let st3 = st-append-code st2 in-al-dx
   in let stg1 = st-append-code st3 [60, ata-status-floating]
   in let float-pos = stg1.code-len
   in let stg2 = st-append-code stg1 (jcc cc-e 0)
   in let stg3 = st-append-code stg2 [60, ata-status-empty]
   in let empty-pos = stg3.code-len
   in let stg4 = st-append-code stg3 (jcc cc-e 0)
   in let st4 = st-append-code stg4 [168, ata-status-bsy]
   in let bsy-jcc = st4.code-len
   in let st5 = patch-jcc-at (st-append-code st4 (jcc cc-ne 0)) bsy-jcc loop-top
   in let ste1 = st-append-code st5 [168, ata-status-err]
   in let err-pos = ste1.code-len
   in let ste2 = st-append-code ste1 (jcc cc-ne 0)
   in let st6 = st-append-code ste2 [168, ata-status-drq]
   in let drq-jcc = st6.code-len
   in let st7 = patch-jcc-at (st-append-code st6 (jcc cc-e 0)) drq-jcc loop-top
   in let endp = st7.code-len
   in let st8 = patch-jcc-at st7 float-pos endp
   in let st9 = patch-jcc-at st8 empty-pos endp
   in patch-jcc-at st9 err-pos endp

  emit-ata-spin-delay : CodegenState, Integer -> CodegenState
  emit-ata-spin-delay (st) (count) =
   let st1 = st-append-code st (li reg-rcx count)
   in let loop-top = st1.code-len
   in let st2 = emit-ata-ctrl-port st1
   in let st3 = st-append-code st2 in-al-dx
   in let st4 = st-append-code st3 (sub-ri reg-rcx 1)
   in let loop-jcc = st4.code-len
   in patch-jcc-at (st-append-code st4 (jcc cc-ne 0)) loop-jcc loop-top

  emit-ata-wait-bsy-clear-bounded : CodegenState -> CodegenState
  emit-ata-wait-bsy-clear-bounded (st) =
   let st0 = st-append-code st (li reg-rcx 1000000)
   in let stf1 = emit-ata-ctrl-port st0
   in let stf2 = st-append-code stf1 in-al-dx
   in let stf3 = st-append-code stf2 [60, ata-status-floating]
   in let float-pos = stf3.code-len
   in let stf4 = st-append-code stf3 (jcc cc-e 0)
   in let stf5 = st-append-code stf4 [60, ata-status-empty]
   in let empty-pos = stf5.code-len
   in let stf6 = st-append-code stf5 (jcc cc-e 0)
   in let loop-top = stf6.code-len
   in let st1 = emit-ata-ctrl-port stf6
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 [168, ata-status-bsy]
   in let done-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let st5 = st-append-code st4 (sub-ri reg-rcx 1)
   in let loop-jcc = st5.code-len
   in let st6 = patch-jcc-at (st-append-code st5 (jcc cc-ne 0)) loop-jcc loop-top
   in let endp = st6.code-len
   in let st7 = patch-jcc-at st6 done-pos endp
   in let st8 = patch-jcc-at st7 float-pos endp
   in patch-jcc-at st8 empty-pos endp

  emit-ata-wait-ready-bounded : CodegenState -> CodegenState
  emit-ata-wait-ready-bounded (st) =
   let st0 = st-append-code st (li reg-rcx 1000000)
   in let stf1 = emit-ata-ctrl-port st0
   in let stf2 = st-append-code stf1 in-al-dx
   in let stf3 = st-append-code stf2 [60, ata-status-floating]
   in let float-pos = stf3.code-len
   in let stf4 = st-append-code stf3 (jcc cc-e 0)
   in let stf5 = st-append-code stf4 [60, ata-status-empty]
   in let empty-pos = stf5.code-len
   in let stf6 = st-append-code stf5 (jcc cc-e 0)
   in let loop-top = stf6.code-len
   in let st1 = emit-ata-ctrl-port stf6
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 [168, ata-status-bsy]
   in let bsy-set-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 [168, ata-status-drdy]
   in let drdy-set-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ne 0)
   in let dec-pos = st6.code-len
   in let st7 = st-append-code st6 (sub-ri reg-rcx 1)
   in let loop-jcc = st7.code-len
   in let st8 = st-append-code st7 (jcc cc-ne 0)
   in let st9 = patch-jcc-at st8 loop-jcc loop-top
   in let st10 = patch-jcc-at st9 bsy-set-pos dec-pos
   in let endp = st10.code-len
   in let st11 = patch-jcc-at st10 drdy-set-pos endp
   in let st12 = patch-jcc-at st11 float-pos endp
   in patch-jcc-at st12 empty-pos endp

  emit-ata-init : CodegenState -> CodegenState
  emit-ata-init (st) =
   let st-z1 = st-append-code st (li reg-rdi ata-sector-count-addr)
   in let st-z2 = st-append-code st-z1 (li reg-rax 0)
   in let st-z3 = st-append-code st-z2 (mov-store reg-rdi reg-rax 0)
   in if st.vm-profile.skip-ata-bring-up then st-z3
   else emit-ata-bring-up st-z3

 Bring-up is a channel reset followed by a detect. Only the reset is a
 once-per-boot thing: it is a soft reset of the whole channel, so re-running it
 on every drive change would clear the other drive's state mid-operation. The
 detect is what block-select needs and it is factored out for that.

  emit-ata-bring-up : CodegenState -> CodegenState
  emit-ata-bring-up (st-z3) =
   let st-r1 = emit-ata-ctrl-port st-z3
   in let st-r2 = st-append-code st-r1 (li reg-rax 4)
   in let st-r3 = st-append-code st-r2 out-dx-al
   in let st-r4 = emit-ata-spin-delay st-r3 100
   in let st-r5 = emit-ata-ctrl-port st-r4
   in let st-r6 = st-append-code st-r5 (li reg-rax 2)
   in let st-r7 = st-append-code st-r6 out-dx-al
   in let st-r8 = emit-ata-spin-delay st-r7 100
   in let st-r9 = emit-ata-wait-bsy-clear-bounded st-r8
   in emit-ata-detect-identify st-r9

 Detect the ACTIVE drive and record ITS sector count. The count is zeroed first,
 so a position with nothing behind it reports zero rather than inheriting the
 last drive's geometry. That inheritance is what made block-sector-count answer
 drive 0's size for every drive, and dm-exec-install would have written a GPT
 sized for the source onto the target.

  emit-ata-detect-identify : CodegenState -> CodegenState
  emit-ata-detect-identify (st-in) =
   let st-c1 = st-append-code st-in (li reg-rdi ata-sector-count-addr)
   in let st-c2 = st-append-code st-c1 (li reg-rax 0)
   in let st-c3 = st-append-code st-c2 (mov-store reg-rdi reg-rax 0)
   in let st1 = emit-ata-port st-c3 ata-off-drive-head
   in let st2 = emit-ata-select-al st1
   in let st3 = st-append-code st2 out-dx-al
   in let st4 = emit-ata-400ns-delay st3
   in let st-mid = emit-ata-port st4 ata-off-lba-mid
   in let st-mid1 = st-append-code st-mid in-al-dx
   in let st-mid2 = st-append-code st-mid1 (cmp-ri reg-rax 0)
   in let no-drive-sig = st-mid2.code-len
   in let st-mid3 = st-append-code st-mid2 (jcc cc-ne 0)
   in let st-hi = emit-ata-port st-mid3 ata-off-lba-high
   in let st-hi1 = st-append-code st-hi in-al-dx
   in let st-hi2 = st-append-code st-hi1 (cmp-ri reg-rax 0)
   in let no-drive-sig2 = st-hi2.code-len
   in let st-hi3 = st-append-code st-hi2 (jcc cc-ne 0)
   in let st5 = emit-ata-port st-hi3 ata-off-status
   in let st6 = st-append-code st5 in-al-dx
   in let st7 = st-append-code st6 (cmp-ri reg-rax 0)
   in let no-drive-1 = st7.code-len
   in let st8 = st-append-code st7 (jcc cc-e 0)
   in let st9 = st-append-code st8 (cmp-ri reg-rax 255)
   in let no-drive-2 = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-e 0)
   in let st11 = emit-ata-wait-ready-bounded st10
   in let st12 = emit-ata-port st11 ata-off-status
   in let st13 = st-append-code st12 (li reg-rax ata-identify-cmd)
   in let st14 = st-append-code st13 out-dx-al
   in let st14a = emit-ata-400ns-delay st14
   in let st14b = emit-ata-wait-bsy-clear-bounded st14a
   in let st14c = emit-ata-port st14b ata-off-status
   in let st14d = st-append-code st14c in-al-dx
   in let st14e = st-append-code st14d [168, ata-status-err]
   in let no-drive-err = st14e.code-len
   in let st14f = st-append-code st14e (jcc cc-ne 0)
   in let st14g = st-append-code st14f [168, ata-status-drq]
   in let no-drive-drq = st14g.code-len
   in let st14h = st-append-code st14g (jcc cc-e 0)
   in let st16 = emit-ata-port st14h 0
   in let st17 = st-append-code st16 (li reg-rcx 256)
   in let st18 = st-append-code st17 (li reg-rdi ata-identify-buf-addr)
   in let st19 = st-append-code st18 [252]
   in let st20 = st-append-code st19 rep-insw
   in let st21 = st-append-code st20 (li reg-rdi (ata-identify-buf-addr + 120))
   in let st22 = st-append-code st21 (mov-load-u32 reg-rax reg-rdi 0)
   in let st23 = st-append-code st22 (li reg-rdi ata-sector-count-addr)
   in let st24 = st-append-code st23 (mov-store reg-rdi reg-rax 0)
   in let done = st24.code-len
   in let st-p1 = patch-jcc-at st24 no-drive-sig done
   in let st-p2 = patch-jcc-at st-p1 no-drive-sig2 done
   in let st-p3 = patch-jcc-at st-p2 no-drive-1 done
   in let st-p4 = patch-jcc-at st-p3 no-drive-2 done
   in let st-p5 = patch-jcc-at st-p4 no-drive-err done
   in patch-jcc-at st-p5 no-drive-drq done

  emit-nic-init : CodegenState -> CodegenState
  emit-nic-init (st) =
   let st0 = st-append-code st (li reg-rdi nic-present-addr)
   in let st1 = st-append-code st0 (xor-rr reg-rax reg-rax)
   in let st2 = st-append-code st1 (mov-store reg-rdi reg-rax 0)
   in let st3 = st-append-code st2 (li reg-rdx ne2k-reset-port)
   in let st4 = st-append-code st3 in-al-dx
   in let st5 = st-append-code st4 out-dx-al
   in let st6 = st-append-code st5 (li reg-rcx 1000000)
   in let wait-top = st6.code-len
   in let st7 = st-append-code st6 (li reg-rdx ne2k-isr-port)
   in let st8 = st-append-code st7 in-al-dx
   in let st9 = st-append-code st8 [168, 128]
   in let rst-found = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-ne 0)
   in let st11 = st-append-code st10 (sub-ri reg-rcx 1)
   in let wait-jcc = st11.code-len
   in let st12 = patch-jcc-at (st-append-code st11 (jcc cc-ne 0)) wait-jcc wait-top
   in let no-nic = st12.code-len
   in let st13 = st-append-code st12 (jmp 0)
   in let st14 = patch-jcc-at st13 rst-found (st13.code-len)
   in let st15 = st-append-code st14 (li reg-rdx ne2k-isr-port)
   in let st16 = st-append-code st15 (li reg-rax 255)
   in let st17 = st-append-code st16 out-dx-al
   in let st17a = st-append-code st17 (li reg-rdx ne2k-isr-port)
   in let st17b = st-append-code st17a in-al-dx
   in let st17c = st-append-code st17b (cmp-ri reg-rax 255)
   in let phantom = st17c.code-len
   in let st17d = st-append-code st17c (jcc cc-e 0)
   in let st18 = st-append-code st17d (li reg-rdx ne2k-cr-port)
   in let st19 = st-append-code st18 (li reg-rax 33)
   in let st20 = st-append-code st19 out-dx-al
   in let st21 = st-append-code st20 (li reg-rdx ne2k-dcr-port)
   in let st22 = st-append-code st21 (li reg-rax 73)
   in let st23 = st-append-code st22 out-dx-al
   in let st24 = st-append-code st23 (li reg-rdx ne2k-rbcr0-port)
   in let st25 = st-append-code st24 (xor-rr reg-rax reg-rax)
   in let st26 = st-append-code st25 out-dx-al
   in let st27 = st-append-code st26 (li reg-rdx ne2k-rbcr1-port)
   in let st28 = st-append-code st27 out-dx-al
   in let st29 = st-append-code st28 (li reg-rdx ne2k-rcr-port)
   in let st30 = st-append-code st29 (li reg-rax 4)
   in let st31 = st-append-code st30 out-dx-al
   in let st32 = st-append-code st31 (li reg-rdx ne2k-tcr-port)
   in let st33 = st-append-code st32 (li reg-rax 2)
   in let st34 = st-append-code st33 out-dx-al
   in let st35 = st-append-code st34 (li reg-rdx ne2k-pstart-port)
   in let st36 = st-append-code st35 (li reg-rax ne2k-page-start)
   in let st37 = st-append-code st36 out-dx-al
   in let st38 = st-append-code st37 (li reg-rdx ne2k-pstop-port)
   in let st39 = st-append-code st38 (li reg-rax ne2k-page-stop)
   in let st40 = st-append-code st39 out-dx-al
   in let st41 = st-append-code st40 (li reg-rdx ne2k-bnry-port)
   in let st42 = st-append-code st41 (li reg-rax ne2k-page-start)
   in let st43 = st-append-code st42 out-dx-al
   in let st44 = st-append-code st43 (li reg-rdx ne2k-imr-port)
   in let st45 = st-append-code st44 (xor-rr reg-rax reg-rax)
   in let st46 = st-append-code st45 out-dx-al
   in let st47 = st-append-code st46 (li reg-rdx ne2k-rsar0-port)
   in let st48 = st-append-code st47 (xor-rr reg-rax reg-rax)
   in let st49 = st-append-code st48 out-dx-al
   in let st50 = st-append-code st49 (li reg-rdx ne2k-rsar1-port)
   in let st51 = st-append-code st50 out-dx-al
   in let st52 = st-append-code st51 (li reg-rdx ne2k-rbcr0-port)
   in let st53 = st-append-code st52 (li reg-rax 32)
   in let st54 = st-append-code st53 out-dx-al
   in let st55 = st-append-code st54 (li reg-rdx ne2k-rbcr1-port)
   in let st56 = st-append-code st55 (xor-rr reg-rax reg-rax)
   in let st57 = st-append-code st56 out-dx-al
   in let st58 = st-append-code st57 (li reg-rdx ne2k-cr-port)
   in let st59 = st-append-code st58 (li reg-rax 10)
   in let st60 = st-append-code st59 out-dx-al
   in let st61 = st-append-code st60 (li reg-rdi nic-mac-addr)
   in let st62 = st-append-code st61 (li reg-rdx ne2k-data-port)
   in let st63 = st-append-code st62 in-ax-dx
   in let st65 = st-append-code st63 (mov-store-byte reg-rdi reg-rax 0)
   in let st66 = st-append-code st65 in-ax-dx
   in let st69 = st-append-code st66 (mov-store-byte reg-rdi reg-rax 1)
   in let st70 = st-append-code st69 in-ax-dx
   in let st73 = st-append-code st70 (mov-store-byte reg-rdi reg-rax 2)
   in let st74 = st-append-code st73 in-ax-dx
   in let st77 = st-append-code st74 (mov-store-byte reg-rdi reg-rax 3)
   in let st78 = st-append-code st77 in-ax-dx
   in let st81 = st-append-code st78 (mov-store-byte reg-rdi reg-rax 4)
   in let st82 = st-append-code st81 in-ax-dx
   in let st85 = st-append-code st82 (mov-store-byte reg-rdi reg-rax 5)
   in let st86 = st-append-code st85 (li reg-rdx ne2k-isr-port)
   in let st87 = st-append-code st86 (li reg-rax 64)
   in let st88 = st-append-code st87 out-dx-al
   in let st89 = st-append-code st88 (li reg-rdx ne2k-cr-port)
   in let st90 = st-append-code st89 (li reg-rax 97)
   in let st91 = st-append-code st90 out-dx-al
   in let st92 = st-append-code st91 (li reg-rdx (ne2k-base-port + 7))
   in let st93 = st-append-code st92 (li reg-rax ne2k-page-start)
   in let st94 = st-append-code st93 out-dx-al
   in let st95 = st-append-code st94 (li reg-rdx ne2k-cr-port)
   in let st96 = st-append-code st95 (li reg-rax 34)
   in let st97 = st-append-code st96 out-dx-al
   in let st98 = st-append-code st97 (li reg-rdx ne2k-tcr-port)
   in let st99 = st-append-code st98 (xor-rr reg-rax reg-rax)
   in let st100 = st-append-code st99 out-dx-al
   in let st101 = st-append-code st100 (li reg-rdi nic-present-addr)
   in let st102 = st-append-code st101 (li reg-rax 1)
   in let st103 = st-append-code st102 (mov-store reg-rdi reg-rax 0)
   in let done = st103.code-len
   in let st104 = patch-jmp-at st103 no-nic done
   in patch-jcc-at st104 phantom done

  emit-wait-for-tick : CodegenState -> CodegenState
  emit-wait-for-tick (st) =
   let loop-top = st.code-len
   in let st1 = st-append-code st hlt
   in let st2 = st-append-code st1 (li reg-rdi tick-count-addr)
   in let st3 = st-append-code st2 (mov-load reg-rax reg-rdi 0)
   in let st4 = st-append-code st3 (cmp-ri reg-rax 0)
   in let tick-jcc = st4.code-len
   in patch-jcc-at (st-append-code st4 (jcc cc-e 0)) tick-jcc loop-top

Section: Heap High-Water Mark
  emit-update-heap-hwm : CodegenState -> CodegenState
  emit-update-heap-hwm (st) =
   let st1 = st-append-code st (push-r reg-r11)
   in let st2 = st-append-code st1 (li reg-r11 heap-hwm-addr)
   in let st3 = st-append-code st2 (push-r reg-rax)
   in let st4 = st-append-code st3 (mov-load reg-rax reg-r11 0)
   in let st5 = st-append-code st4 (cmp-rr reg-r10 reg-rax)
   in let skip-update = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-le 0)
   in let st7 = st-append-code st6 (mov-store reg-r11 reg-r10 0)
   in let st8 = patch-jcc-at st7 skip-update (st7.code-len)
   in let st9 = st-append-code st8 (pop-r reg-rax)
   in st-append-code st9 (pop-r reg-r11)

