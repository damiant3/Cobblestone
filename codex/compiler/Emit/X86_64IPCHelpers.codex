  emit-process-get-network-scope-helper : CodegenState -> CodegenState

  emit-process-get-network-scope-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "process-get-network-scope"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

