   in let st7 = st-append-code st6 x86-ret

   in let fail-pos = st7.code-len

   in let st8 = st-append-code st7 (li reg-rax (0 - 1))

   in let st9 = st-append-code st8 x86-ret

   in let st10 = patch-jcc-at st9 cap-deny fail-pos

