  emit-process-kill-helper : CodegenState -> CodegenState

  emit-process-kill-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "process-kill"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (push-r reg-rbx)

   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rdi)

   in let st4 = emit-load-current-proc st2 reg-rax

   in let st5 = st-append-code st4 (shl-ri reg-rax 8)

   in let st6 = st-append-code st5 (add-ri reg-rax proc-table-base)

   in let st7 = st-append-code st6 (mov-load reg-rax reg-rax proc-cap-offset)

   in let st8 = st-append-code st7 (and-ri reg-rax (shl-1 cap-capability-admin))

   in let st9 = st-append-code st8 (test-rr reg-rax reg-rax)

   in let deny-jmp = st9.code-len

   in let st10 = st-append-code st9 (jcc cc-e 0)

   in let st11 = st-append-code st10 (cmp-ri reg-rbx 16)

   in let range-deny = st11.code-len

   in let st12 = st-append-code st11 (jcc cc-ge 0)

   in let st14 = emit-load-current-proc st12 reg-rax

   in let st15 = st-append-code st14 (cmp-rr reg-rbx reg-rax)

   in let self-deny = st15.code-len

   in let st16 = st-append-code st15 (jcc cc-e 0)

   in let st17 = st-append-code st16 (mov-rr reg-rdx reg-rbx)

   in let st18 = st-append-code st17 (shl-ri reg-rdx 8)

   in let st19 = st-append-code st18 (add-ri reg-rdx proc-table-base)

   in let st20 = st-append-code st19 (li reg-rax proc-state-zombie)

   in let st21 = st-append-code st20 (mov-store reg-rdx reg-rax 0)

   in let st22 = st-append-code st21 (xor-rr reg-rcx reg-rcx)

   in let wake-top = st22.code-len

   in let st23 = st-append-code st22 (cmp-ri reg-rcx 16)

   in let wake-done = st23.code-len

   in let st24 = st-append-code st23 (jcc cc-ge 0)

   in let st25 = st-append-code st24 (mov-rr reg-rsi reg-rcx)

   in let st26 = st-append-code st25 (shl-ri reg-rsi 8)

   in let st27 = st-append-code st26 (add-ri reg-rsi proc-table-base)

   in let st28 = st-append-code st27 (mov-load reg-rax reg-rsi 0)

   in let st29 = st-append-code st28 (cmp-ri reg-rax proc-state-blocked)

   in let wake-skip = st29.code-len

   in let st30 = st-append-code st29 (jcc cc-ne 0)

   in let st31 = st-append-code st30 (mov-load reg-rax reg-rsi proc-blocked-on-offset)

   in let st32 = st-append-code st31 (cmp-rr reg-rax reg-rbx)

   in let wake-nomatch = st32.code-len

   in let st33 = st-append-code st32 (jcc cc-ne 0)

   in let st34 = st-append-code st33 (li reg-rax proc-state-ready)

   in let st35 = st-append-code st34 (mov-store reg-rsi reg-rax 0)

   in let wake-next = st35.code-len

   in let st36 = st-append-code st35 (add-ri reg-rcx 1)

   in let st37 = st-append-code st36 (jmp (wake-top - (st36.code-len + 5)))

   in let st38 = patch-jcc-at st37 wake-skip wake-next

   in let st39 = patch-jcc-at st38 wake-nomatch wake-next

   in let st40 = patch-jcc-at st39 wake-done (st39.code-len)

   in let st41 = st-append-code st40 (xor-rr reg-rax reg-rax)

   in let st42 = st-append-code st41 (pop-r reg-rbx)

   in let st43 = st-append-code st42 x86-ret

   in let fail-pos = st43.code-len

   in let st44 = st-append-code st43 (li reg-rax (0 - 1))

   in let st45 = st-append-code st44 (pop-r reg-rbx)

   in let st46 = st-append-code st45 x86-ret

   in let st47 = patch-jcc-at st46 deny-jmp fail-pos

   in let st48 = patch-jcc-at st47 range-deny fail-pos

   in patch-jcc-at st48 self-deny fail-pos

  emit-process-set-scope-helper : CodegenState -> CodegenState

  emit-process-set-scope-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "process-set-scope"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let c1 = emit-load-current-proc st0 reg-rcx

   in let c2 = st-append-code c1 (shl-ri reg-rcx 8)

   in let c3 = st-append-code c2 (add-ri reg-rcx proc-table-base)

   in let c4 = st-append-code c3 (mov-load reg-rcx reg-rcx proc-cap-offset)

   in let c5 = st-append-code c4 (and-ri reg-rcx (shl-1 cap-capability-admin))

   in let c6 = st-append-code c5 (test-rr reg-rcx reg-rcx)

   in let cap-deny = c6.code-len

   in let c7 = st-append-code c6 (jcc cc-e 0)

   in let st1 = st-append-code c7 (cmp-ri reg-rdi 16)

   in let range-deny = st1.code-len

   in let st2 = st-append-code st1 (jcc cc-ge 0)

   in let st3 = st-append-code st2 (shl-ri reg-rdi 8)

   in let st4 = st-append-code st3 (add-ri reg-rdi proc-table-base)

   in let st5 = st-append-code st4 (mov-store reg-rdi reg-rsi proc-scope-offset)

