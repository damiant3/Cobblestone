Chapter: X86-64 Code Generator

Section: IPC and Network Helpers

  emit-ipc-cap-check : CodegenState, Integer -> CheckExpiryResult

  emit-ipc-cap-check (st) (deny-placeholder) =

   let st2 = emit-load-current-proc st reg-rax

   in let st3 = st-append-code st2 (shl-ri reg-rax 8)

   in let st4 = st-append-code st3 (add-ri reg-rax proc-table-base)

   in let st5 = st-append-code st4 (mov-load reg-rax reg-rax proc-cap-offset)

   in let st6 = st-append-code st5 (and-ri reg-rax (shl-1 cap-ipc))

   in let st7 = st-append-code st6 (test-rr reg-rax reg-rax)

   in let deny-off = st7.code-len

   in let st8 = st-append-code st7 (jcc cc-e 0)

   in CheckExpiryResult { state = st8, deny-offset = deny-off }

  emit-chan-addr-from-rdi : CodegenState -> CodegenState

  emit-chan-addr-from-rdi (st) =

   let st1 = st-append-code st (mov-rr reg-rdx reg-rdi)

   in let st2 = st-append-code st1 (shl-ri reg-rdx 7)

   in st-append-code st2 (add-ri reg-rdx chan-table-base)

  emit-chan-create-helper : CodegenState -> CodegenState

  emit-chan-create-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "chan-kern-create"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (push-r reg-rbx)

   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rdi)

   in let chk = emit-ipc-cap-check st2 0

   in let st3 = chk.state

   in let st4 = st-append-code st3 (xor-rr reg-rcx reg-rcx)

   in let scan-top = st4.code-len

   in let st5 = st-append-code st4 (cmp-ri reg-rcx chan-max-channels)

   in let no-slot = st5.code-len

   in let st6 = st-append-code st5 (jcc cc-ge 0)

   in let st7 = st-append-code st6 (mov-rr reg-rdx reg-rcx)

   in let st8 = st-append-code st7 (shl-ri reg-rdx 7)

   in let st9 = st-append-code st8 (add-ri reg-rdx chan-table-base)

   in let st10 = st-append-code st9 (mov-load reg-rax reg-rdx chan-state-offset)

   in let st11 = st-append-code st10 (test-rr reg-rax reg-rax)

   in let found-jmp = st11.code-len

   in let st12 = st-append-code st11 (jcc cc-e 0)

   in let st13 = st-append-code st12 (add-ri reg-rcx 1)

   in let st14 = st-append-code st13 (jmp scan-top)

   in let found-pos = st14.code-len

   in let st15 = patch-jcc-at st14 found-jmp found-pos

   in let st16 = st-append-code st15 (li reg-rax chan-state-open)

   in let st17 = st-append-code st16 (mov-store reg-rdx reg-rax chan-state-offset)

   in let st18 = st-append-code st17 (cmp-ri reg-rbx chan-max-slots)

   in let cap-ok = st18.code-len

   in let st18a = st-append-code st18 (jcc cc-le 0)

   in let st18b = st-append-code st18a (li reg-rbx chan-max-slots)

   in let st18c = patch-jcc-at st18b cap-ok (st18b.code-len)

   in let st19 = st-append-code st18c (mov-store reg-rdx reg-rbx chan-capacity-offset)

   in let st20 = st-append-code st19 (xor-rr reg-rax reg-rax)

   in let st21 = st-append-code st20 (mov-store reg-rdx reg-rax chan-count-offset)

   in let st22 = st-append-code st21 (mov-store reg-rdx reg-rax chan-write-pos-offset)

   in let st23 = st-append-code st22 (mov-store reg-rdx reg-rax chan-read-pos-offset)

   in let st25 = emit-load-current-proc st23 reg-rax

   in let st26 = st-append-code st25 (mov-store reg-rdx reg-rax chan-owner-offset)

   in let st27 = st-append-code st26 (mov-rr reg-rax reg-rcx)

   in let st28 = st-append-code st27 (pop-r reg-rbx)

   in let st29 = st-append-code st28 x86-ret

   in let fail-pos = st29.code-len

   in let st30 = st-append-code st29 (li reg-rax (0 - 1))

   in let st31 = st-append-code st30 (pop-r reg-rbx)

   in let st32 = st-append-code st31 x86-ret

   in let st33 = patch-jcc-at st32 (chk.deny-offset) fail-pos

   in patch-jcc-at st33 no-slot fail-pos

  emit-chan-send-helper : CodegenState -> CodegenState

  emit-chan-send-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "chan-kern-send"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (push-r reg-rbx)

   in let st2 = st-append-code st1 (push-r reg-r12)

   in let st3 = st-append-code st2 (mov-rr reg-rbx reg-rdi)

   in let st4 = st-append-code st3 (mov-rr reg-r12 reg-rsi)

   in let chk = emit-ipc-cap-check st4 0

   in let st5 = chk.state

   in let st6 = st-append-code st5 (cmp-ri reg-rbx chan-max-channels)

   in let range-deny = st6.code-len

   in let st7 = st-append-code st6 (jcc cc-ge 0)

   in let st8 = st-append-code st7 (mov-rr reg-rdi reg-rbx)

   in let st8a = emit-chan-addr-from-rdi st8

   in let st9 = st-append-code st8a (mov-load reg-rax reg-rdx chan-state-offset)

   in let st10 = st-append-code st9 (cmp-ri reg-rax chan-state-open)

   in let not-open = st10.code-len

   in let st11 = st-append-code st10 (jcc cc-ne 0)

   in let st12 = st-append-code st11 (mov-load reg-rax reg-rdx chan-count-offset)

   in let st13 = st-append-code st12 (mov-load reg-rcx reg-rdx chan-capacity-offset)

   in let st14 = st-append-code st13 (cmp-rr reg-rax reg-rcx)

   in let full-deny = st14.code-len

   in let st15 = st-append-code st14 (jcc cc-ge 0)

   in let st16 = st-append-code st15 (mov-load reg-rcx reg-rdx chan-write-pos-offset)

   in let st17 = st-append-code st16 (shl-ri reg-rcx 3)

   in let st18 = st-append-code st17 (add-ri reg-rcx chan-buffer-offset)

   in let st19 = st-append-code st18 (add-rr reg-rcx reg-rdx)

   in let st20 = st-append-code st19 (mov-store reg-rcx reg-r12 0)

   in let st21 = st-append-code st20 (mov-load reg-rcx reg-rdx chan-write-pos-offset)

   in let st22 = st-append-code st21 (add-ri reg-rcx 1)

   in let st23 = st-append-code st22 (cmp-ri reg-rcx chan-max-slots)

   in let no-wrap = st23.code-len

   in let st24 = st-append-code st23 (jcc cc-l 0)

   in let st25 = st-append-code st24 (xor-rr reg-rcx reg-rcx)

   in let wrap-done = st25.code-len

   in let st26 = patch-jcc-at st25 no-wrap wrap-done

   in let st27 = st-append-code st26 (mov-store reg-rdx reg-rcx chan-write-pos-offset)

   in let st28 = st-append-code st27 (add-ri reg-rax 1)

   in let st29 = st-append-code st28 (mov-store reg-rdx reg-rax chan-count-offset)

   in let st30 = st-append-code st29 (xor-rr reg-rax reg-rax)

   in let st31 = st-append-code st30 (pop-r reg-r12)

   in let st32 = st-append-code st31 (pop-r reg-rbx)

   in let st33 = st-append-code st32 x86-ret

   in let fail-pos = st33.code-len

   in let st34 = st-append-code st33 (li reg-rax (0 - 1))

   in let st35 = st-append-code st34 (pop-r reg-r12)

   in let st36 = st-append-code st35 (pop-r reg-rbx)

   in let st37 = st-append-code st36 x86-ret

   in let st38 = patch-jcc-at st37 (chk.deny-offset) fail-pos

   in let st39 = patch-jcc-at st38 range-deny fail-pos

   in let st40 = patch-jcc-at st39 not-open fail-pos

   in patch-jcc-at st40 full-deny fail-pos

  emit-chan-recv-helper : CodegenState -> CodegenState

  emit-chan-recv-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "chan-kern-recv"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (push-r reg-rbx)

   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rdi)

   in let chk = emit-ipc-cap-check st2 0

   in let st3 = chk.state

   in let st4 = st-append-code st3 (cmp-ri reg-rbx chan-max-channels)

   in let range-deny = st4.code-len

   in let st5 = st-append-code st4 (jcc cc-ge 0)

   in let st6 = st-append-code st5 (mov-rr reg-rdi reg-rbx)

   in let st7 = emit-chan-addr-from-rdi st6

   in let st8 = st-append-code st7 (mov-load reg-rax reg-rdx chan-state-offset)

   in let st9 = st-append-code st8 (test-rr reg-rax reg-rax)

   in let not-active = st9.code-len

   in let st10 = st-append-code st9 (jcc cc-e 0)

   in let st11 = st-append-code st10 (mov-load reg-rax reg-rdx chan-count-offset)

   in let st12 = st-append-code st11 (test-rr reg-rax reg-rax)

   in let empty-deny = st12.code-len

   in let st13 = st-append-code st12 (jcc cc-e 0)

   in let st14 = st-append-code st13 (mov-load reg-rcx reg-rdx chan-read-pos-offset)

   in let st15 = st-append-code st14 (shl-ri reg-rcx 3)

   in let st16 = st-append-code st15 (add-ri reg-rcx chan-buffer-offset)

   in let st17 = st-append-code st16 (add-rr reg-rcx reg-rdx)

   in let st18 = st-append-code st17 (mov-load reg-rbx reg-rcx 0)

   in let st19 = st-append-code st18 (mov-load reg-rcx reg-rdx chan-read-pos-offset)

   in let st20 = st-append-code st19 (add-ri reg-rcx 1)

   in let st21 = st-append-code st20 (cmp-ri reg-rcx chan-max-slots)

   in let no-wrap = st21.code-len

   in let st22 = st-append-code st21 (jcc cc-l 0)

   in let st23 = st-append-code st22 (xor-rr reg-rcx reg-rcx)

   in let wrap-done = st23.code-len

   in let st24 = patch-jcc-at st23 no-wrap wrap-done

   in let st25 = st-append-code st24 (mov-store reg-rdx reg-rcx chan-read-pos-offset)

   in let st26 = st-append-code st25 (sub-ri reg-rax 1)

   in let st27 = st-append-code st26 (mov-store reg-rdx reg-rax chan-count-offset)

   in let st28 = st-append-code st27 (mov-rr reg-rax reg-rbx)

   in let st29 = st-append-code st28 (pop-r reg-rbx)

   in let st30 = st-append-code st29 x86-ret

   in let fail-pos = st30.code-len

   in let st31 = st-append-code st30 (li reg-rax (0 - 1))

   in let st32 = st-append-code st31 (pop-r reg-rbx)

   in let st33 = st-append-code st32 x86-ret

   in let st34 = patch-jcc-at st33 (chk.deny-offset) fail-pos

   in let st35 = patch-jcc-at st34 range-deny fail-pos

   in let st36 = patch-jcc-at st35 not-active fail-pos

   in patch-jcc-at st36 empty-deny fail-pos

  emit-chan-close-helper : CodegenState -> CodegenState

  emit-chan-close-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "chan-kern-close"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let chk = emit-ipc-cap-check st0 0

   in let st1 = chk.state

   in let st2 = st-append-code st1 (push-r reg-rbx)

   in let st3 = st-append-code st2 (mov-rr reg-rbx reg-rdi)

   in let st4 = st-append-code st3 (cmp-ri reg-rbx chan-max-channels)

   in let range-deny = st4.code-len

