   reg = rd.reg
  }

  emit-read-serial-cce-builtin : CodegenState, List IRExpr -> EmitResult
  emit-read-serial-cce-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 "__bare_metal_read_serial_cce"
   in let rd = alloc-temp st2
   in EmitResult {
