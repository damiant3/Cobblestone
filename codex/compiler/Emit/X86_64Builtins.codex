Chapter: X86-64 Code Generator
  cites Foreword chapter Sort

Section: Builtin Detection

 Two things decide a builtin's fate. This list routes the call to
 emit-builtin; x86-builtin-emitters says how to emit it. Until 2026-07-16
 they were two hand-maintained literals holding the same 143 names, written
 out twice and agreeing only by inspection. A name here with no emitter
 raised CDX2042 at a distance from whoever asked for it. An emitter with no
 name here was unreachable, because is-builtin would never say yes.

 No drift is expressible now, and there is no longer a second literal for
 one to open up against. This list is DERIVED from the emitter table, so
 being routed IS having an emitter, which is what routing was always
 supposed to mean; and the emitter table is itself derived from the one
 table in Types chapter Builtins, whose rows carry the name, the type and
 the emitter together. build/check-builtin-tables.ps1 checked the last of
 these relations and is deleted, because a relation between two columns of
 one row is not a relation any more.

 The emitters live over there and are named from here, which is the reverse
 of the usual direction and worth saying plainly: Emit sorts before Types in
 the concatenated unit, so `builtins` is a forward reference from this
 chapter. That already worked before this change, and still does in both
 directions: capability-vocabulary in Types is a projection of a foreword
 table, and boot-cap-mask-for in the X86-64 Chapter reads the same one --
 so nothing here depends on a new property of the unit.

 Names are kept in a SkipListText, sorted by the same text-compare that
 skip-list-text-has uses. They arrive already ordered, since
 x86-builtin-emitters sorts itself for its own bsearch, and
 skip-list-text-from-list sorts on insert regardless. The walk binds the
 emitter table once: x86-builtin-emitters is a zero-parameter definition and
 every mention of one is emitted as a call, so naming it twice would build
 and sort the whole table twice. It runs where a CodegenState is built, not
 per is-builtin call.

  x86-emitter-names : List BuiltinX86Emitter, Integer, Integer, List Text -> List Text
  x86-emitter-names (es) (i) (len) (acc) =
   if i >= len then acc
   else x86-emitter-names es (i + 1) len (list-push acc ((list-at es i).name))

  sorted-builtin-names : SkipListText
  sorted-builtin-names =
   let es = x86-builtin-emitters
   in skip-list-text-from-list (x86-emitter-names es 0 (list-length es) [])

  is-builtin : SkipListText, Text -> Boolean
  is-builtin (names) (name) =
   skip-list-text-has names name

Section: Builtin Emission
  emit-helper-call-0 : CodegenState, List IRExpr, Text -> EmitResult
  emit-helper-call-0 (st) (args) (helper) =
   let st1 = emit-call-to st helper
   in let tmp = alloc-temp st1
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-helper-call-1 : CodegenState, List IRExpr, Text -> EmitResult
  emit-helper-call-1 (st) (args) (helper) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 helper
   in let tmp = alloc-temp st2
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-helper-call-2 : CodegenState, List IRExpr, Text -> EmitResult
  emit-helper-call-2 (st) (args) (helper) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loaded = load-local (r1.state) (loc.reg)
   in let st2 = st-append-code (loaded.state) (mov-rr reg-rsi (r1.reg))
   in let st3 = st-append-code st2 (mov-rr reg-rdi (loaded.reg))
   in let st4 = emit-call-to st3 helper
   in let tmp = alloc-temp st4
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-helper-call-3 : CodegenState, List IRExpr, Text -> EmitResult
  emit-helper-call-3 (st) (args) (helper) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let r2 = emit-expr st2 (list-at args 2)
   in let st3 = st-append-code (r2.state) (mov-rr reg-rdx (r2.reg))
   in let ld1 = load-local st3 (loc1.reg)
   in let st4 = st-append-code (ld1.state) (mov-rr reg-rsi (ld1.reg))
   in let ld0 = load-local st4 (loc0.reg)
   in let st5 = st-append-code (ld0.state) (mov-rr reg-rdi (ld0.reg))
   in let st6 = emit-call-to st5 helper
   in let tmp = alloc-temp st6
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-text-length-builtin : CodegenState, List IRExpr -> EmitResult
  emit-text-length-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let tmp = alloc-temp (r.state)
   in EmitResult {
   state = st-append-code (tmp.state) (mov-load (tmp.reg) (r.reg) 0),
   reg = tmp.reg
  }

  emit-list-length-builtin : CodegenState, List IRExpr -> EmitResult
  emit-list-length-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let tmp = alloc-temp (r.state)
   in EmitResult {
   state = st-append-code (tmp.state) (mov-load (tmp.reg) (r.reg) 0),
   reg = tmp.reg
  }

 list-at is view-aware: the capacity cell at [p-8] is negative for a
 tail view, whose [p+8] holds a phantom base shaped exactly like a
 plain list pointer (see Section: List Views in the list helpers).
 Both paths finish with the same +8-displacement load, therefore the
 branch only selects which base the scaled index is added to.

  emit-list-at-builtin : CodegenState, List IRExpr -> EmitResult
  emit-list-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let list-loaded = load-local (r1.state) (loc.reg)
   in let addr = alloc-temp (list-loaded.state)
   in let st2 = st-append-code (addr.state) (mov-rr (addr.reg) (r1.reg))
   in let st3 = st-append-code st2 (shl-ri (addr.reg) 3)
   in let cap = alloc-temp st3
   in let st4 = st-append-code (cap.state) (mov-load (cap.reg) (list-loaded.reg) (-8))
   in let st5 = st-append-code st4 (cmp-ri (cap.reg) 0)
   in let plain-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mov-load (cap.reg) (list-loaded.reg) 8)
   in let st8 = st-append-code st7 (add-rr (addr.reg) (cap.reg))
   in let over-pos = st8.code-len
   in let st9 = st-append-code st8 (jmp 0)
   in let st10 = patch-jcc-at st9 plain-pos (st9.code-len)
   in let st11 = st-append-code st10 (add-rr (addr.reg) (list-loaded.reg))
   in let st12 = patch-jmp-at st11 over-pos (st11.code-len)
   in let rd = alloc-temp st12
   in EmitResult {
   state = st-append-code (rd.state) (mov-load (rd.reg) (addr.reg) 8),
   reg = rd.reg
  }

 tag-equal reads the constructor tag word at [p+0] of both variant
 values -- the same cell every IrCtorPat test loads -- and answers
 their equality without touching a field. One comparison on bare
 metal, which is the whole reason the builtin exists; the arguments
 must be variant values, which the ForAll type in the registry cannot
 say, and the row's prose there says it instead.

  emit-tag-equal-builtin : CodegenState, List IRExpr -> EmitResult
  emit-tag-equal-builtin (st) (args) =
   let a-r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let a-loc = alloc-local (a-r.state)
   in let st1 = store-local (a-loc.state) (a-loc.reg) (a-r.reg)
   in let b-r = emit-expr st1 (list-at args 1)
   in let b-tag = alloc-temp (b-r.state)
   in let st2 = st-append-code (b-tag.state) (mov-load (b-tag.reg) (b-r.reg) 0)
   in let a-load = load-local st2 (a-loc.reg)
   in let a-tag = alloc-temp (a-load.state)
   in let st3 = st-append-code (a-tag.state) (mov-load (a-tag.reg) (a-load.reg) 0)
   in let st4 = st-append-code st3 (cmp-rr (a-tag.reg) (b-tag.reg))
   in let rd = alloc-temp st4
   in EmitResult {
    state = st-append-code (st-append-code (rd.state) (setcc cc-e (rd.reg))) (movzx-byte-self (rd.reg)),
    reg = rd.reg
   }

  emit-list-head-builtin : CodegenState, List IRExpr -> EmitResult
  emit-list-head-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let eff = alloc-temp (r.state)
   in let st1 = st-append-code (eff.state) (mov-rr (eff.reg) (r.reg))
   in let cap = alloc-temp st1
   in let st2 = st-append-code (cap.state) (mov-load (cap.reg) (r.reg) (-8))
   in let st3 = st-append-code st2 (cmp-ri (cap.reg) 0)
   in let plain-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-load (eff.reg) (r.reg) 8)
   in let st6 = patch-jcc-at st5 plain-pos (st5.code-len)
   in let rd = alloc-temp st6
   in EmitResult {
   state = st-append-code (rd.state) (mov-load (rd.reg) (eff.reg) 8),
   reg = rd.reg
  }

  emit-vec-empty-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-empty-builtin (st) (args) =
   let rd = alloc-temp st
   in EmitResult { state = st-append-code (rd.state) (li (rd.reg) 0), reg = rd.reg }

  emit-vec-head-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-head-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in EmitResult { state = st-append-code (rd.state) (mov-load (rd.reg) (r.reg) 8), reg = rd.reg }

  emit-vec-singleton-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-singleton-builtin (st) (args) = emit-helper-call-1 st args "__list_snoc_new"

  emit-session-new-builtin : CodegenState, List IRExpr -> EmitResult
  emit-session-new-builtin (st) (args) = emit-helper-call-0 st args "chan-kern-create"

  emit-char-at-builtin : CodegenState, List IRExpr -> EmitResult
  emit-char-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let str-loaded = load-local (r1.state) (loc.reg)
   in let rd = alloc-temp (str-loaded.state)
   in let st2 = st-append-code (rd.state) (mov-rr (rd.reg) (r1.reg))
   in let st3 = st-append-code st2 (add-rr (rd.reg) (str-loaded.reg))
   in let st4 = st-append-code st3 (movzx-byte (rd.reg) (rd.reg) 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-char-code-at-builtin : CodegenState, List IRExpr -> EmitResult
  emit-char-code-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let text-loaded = load-local (r1.state) (loc.reg)
   in let rd = alloc-temp-avoiding (text-loaded.state) (r1.reg)
   in let st2 = st-append-code (rd.state) (mov-rr (rd.reg) (text-loaded.reg))
   in let st3 = st-append-code st2 (add-rr (rd.reg) (r1.reg))
   in let st4 = st-append-code st3 (movzx-byte (rd.reg) (rd.reg) 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-char-to-text-builtin : CodegenState, List IRExpr -> EmitResult
  emit-char-to-text-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r.state)
   in let st1 = store-local (loc.state) (loc.reg) (r.reg)
   in let alloc = emit-bivy-alloc st1 16
   in let st5 = st-append-code (alloc.state) (li reg-r11 1)
   in let ptr-loaded = load-local st5 (alloc.ptr-loc)
   in let st6 = st-append-code (ptr-loaded.state) (mov-store (ptr-loaded.reg) reg-r11 0)
   in let code-loaded = load-local st6 (loc.reg)
   in let ptr-loaded2 = load-local (code-loaded.state) (alloc.ptr-loc)
   in let st7 = st-append-code (ptr-loaded2.state) (mov-store-byte (ptr-loaded2.reg) (code-loaded.reg) 8)
   in let result = load-local st7 (alloc.ptr-loc)
   in EmitResult {
   state = result.state,
   reg = result.reg
  }

  emit-is-letter-builtin : CodegenState, List IRExpr -> EmitResult
  emit-is-letter-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-code st0 (sub-ri (rd.reg) 13)
   in let st2 = st-append-code st1 (cmp-ri (rd.reg) 51)
   in let st3 = st-append-code st2 (setcc cc-be (rd.reg))
   in let st4 = st-append-code st3 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-is-digit-builtin : CodegenState, List IRExpr -> EmitResult
  emit-is-digit-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-code st0 (sub-ri (rd.reg) 3)
   in let st2 = st-append-code st1 (cmp-ri (rd.reg) 9)
   in let st3 = st-append-code st2 (setcc cc-be (rd.reg))
   in let st4 = st-append-code st3 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-is-whitespace-builtin : CodegenState, List IRExpr -> EmitResult
  emit-is-whitespace-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-code st0 (cmp-ri (rd.reg) 2)
   in let st2 = st-append-code st1 (setcc cc-be (rd.reg))
   in let st3 = st-append-code st2 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st3,
   reg = rd.reg
  }

  emit-negate-builtin : CodegenState, List IRExpr -> EmitResult
  emit-negate-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st2 = st-append-code st1 (neg-r (rd.reg))
   in EmitResult {
   state = st2,
   reg = rd.reg
  }

  emit-narrow-builtin : CodegenState, List IRExpr -> EmitResult
  emit-narrow-builtin (st) (args) =
   emit-expr st (list-at args 0)

  emit-proof-builtin : CodegenState, List IRExpr -> EmitResult
  emit-proof-builtin (st) (args) =
   emit-int-lit st 0

  emit-force-builtin : CodegenState, List IRExpr -> EmitResult
  emit-force-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let closure-loc = alloc-local (r.state)
   in let st1 = store-local (closure-loc.state) (closure-loc.reg) (r.reg)
   in let cl = load-local st1 (closure-loc.reg)
   in let st2 = st-append-code (cl.state) (mov-rr reg-r11 (cl.reg))
   in let st3 = st-append-code st2 (mov-load reg-rax reg-r11 0)
   in let st4 = st-append-code st3 (mov-rr reg-r15 reg-r11)
   in let st5 = st-append-code st4 (li reg-rdi 0)
   in let st6 = st-append-code st5 [255, 208]
   in let tmp = alloc-temp st6
   in EmitResult {
   state = st-append-code (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-abs-builtin : CodegenState, List IRExpr -> EmitResult
  emit-abs-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-code (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st2 = st-append-code st1 (test-rr (rd.reg) (rd.reg))
   in let jge-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (neg-r (rd.reg))
   in let st5 = patch-jcc-at st4 jge-pos (st4.code-len)
   in EmitResult {
    state = st5,
    reg = rd.reg
   }

  emit-min-builtin : CodegenState, List IRExpr -> EmitResult
  emit-min-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp-avoiding (ld0.state) (r1.reg)
   in let st2 = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg))
   in let st3 = st-append-code st2 (cmp-rr (rd.reg) (r1.reg))
   in let jle-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-le 0)
   in let st5 = st-append-code st4 (mov-rr (rd.reg) (r1.reg))
   in let st6 = patch-jcc-at st5 jle-pos (st5.code-len)
   in EmitResult {
    state = st6,
    reg = rd.reg
   }

  emit-max-builtin : CodegenState, List IRExpr -> EmitResult
  emit-max-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp-avoiding (ld0.state) (r1.reg)
   in let st2 = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg))
   in let st3 = st-append-code st2 (cmp-rr (rd.reg) (r1.reg))
   in let jge-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-rr (rd.reg) (r1.reg))
   in let st6 = patch-jcc-at st5 jge-pos (st5.code-len)
   in EmitResult {
    state = st6,
    reg = rd.reg
   }

  emit-int-mod-reg-locals : CodegenState, Integer, Integer -> EmitResult
  emit-int-mod-reg-locals (st) (a-reg) (b-reg) =
   let st1 = st-append-code st (mov-rr reg-rax a-reg)
   in let st2 = st-append-code st1 cqo
   in let st3 = st-append-code st2 (idiv-r b-reg)
   in let rd = alloc-temp st3
   in let st4 = st-append-code (rd.state) (mov-rr (rd.reg) reg-rdx)
   in let st5 = st-append-code st4 (test-rr (rd.reg) (rd.reg))
   in let jge-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let rc = alloc-temp st6
   in let st7 = st-append-code (rc.state) (mov-rr (rc.reg) b-reg)
   in let sm = alloc-temp st7
   in let st8 = st-append-code (sm.state) (mov-rr (sm.reg) (rc.reg))
   in let st9 = st-append-code st8 (sar-ri (sm.reg) 63)
   in let st10 = st-append-code st9 (xor-rr (rc.reg) (sm.reg))
   in let st11 = st-append-code st10 (sub-rr (rc.reg) (sm.reg))
   in let st12 = st-append-code st11 (add-rr (rd.reg) (rc.reg))
   in let st13 = patch-jcc-at st12 jge-pos (st12.code-len)
   in EmitResult {
    state = st13,
    reg = rd.reg
   }

  emit-int-mod-builtin : CodegenState, List IRExpr -> EmitResult
  emit-int-mod-builtin (st) (args) =
   let a = list-at args 0
   in let b = list-at args 1
   in when a
    is IrName (an) (at) (asp) ->
     let a-slot = lookup-local (st.locals) an
     in when b
      is IrName (bn) (bt) (bsp) ->
       let b-slot = lookup-local (st.locals) bn
       in if a-slot >= 0 & a-slot < spill-base & b-slot >= 0 & b-slot < spill-base then emit-int-mod-reg-locals st a-slot b-slot
       else emit-int-mod-standard st args
      is otherwise -> emit-int-mod-standard st args
    is otherwise -> emit-int-mod-standard st args

  emit-int-mod-standard : CodegenState, List IRExpr -> EmitResult
  emit-int-mod-standard (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let ld0 = load-local st2 (loc0.reg)
   in let st3 = st-append-code (ld0.state) (mov-rr reg-rax (ld0.reg))
   in let st4 = st-append-code st3 cqo
   in let ld1 = load-local st4 (loc1.reg)
   in let st5 = st-append-code (ld1.state) (idiv-r (ld1.reg))
   in let rd = alloc-temp st5
   in let st6 = st-append-code (rd.state) (mov-rr (rd.reg) reg-rdx)
   in let st7 = st-append-code st6 (test-rr (rd.reg) (rd.reg))
   in let jge-pos = st7.code-len
   in let st8 = st-append-code st7 (jcc cc-ge 0)
   in let rc = alloc-temp st8
   in let ld1b = load-local (rc.state) (loc1.reg)
   in let st9 = st-append-code (ld1b.state) (mov-rr (rc.reg) (ld1b.reg))
   in let sm = alloc-temp st9
   in let st10 = st-append-code (sm.state) (mov-rr (sm.reg) (rc.reg))
   in let st11 = st-append-code st10 (sar-ri (sm.reg) 63)
   in let st12 = st-append-code st11 (xor-rr (rc.reg) (sm.reg))
   in let st13 = st-append-code st12 (sub-rr (rc.reg) (sm.reg))
   in let st14 = st-append-code st13 (add-rr (rd.reg) (rc.reg))
   in let st15 = patch-jcc-at st14 jge-pos (st14.code-len)
   in EmitResult {
    state = st15,
    reg = rd.reg
   }

 int-rem is int-mod without the correction. idiv leaves the truncated
 remainder in RDX already -- sign of the dividend, magnitude below the
 divisor's -- and that is exactly what int-rem answers, so these two
 functions are their int-mod siblings stopped at the mov out of RDX.
 The branch the siblings continue into is what makes int-mod Euclidean:
 it adds the divisor's absolute value when the remainder came back
 negative. Deleting that branch is the whole difference between the two
 builtins, and it is why int-rem pairs with `/` where int-mod does not.

 Keep the pair together. If the register discipline around idiv changes
 in one of these, it changes in both -- the clobber is RAX and RDX
 either way, and the reg-locals fast path exists for the same reason in
 each.

 These are NOT the path a saturated `int-rem a b` takes. That call is
 rewritten at lowering into `IrBinary IrRemInt` (`lower-int-rem-apply`),
 which is what lets the node reach the plugs and what gets it the
 power-of-two strength reduction and the LIR selector for free. What is
 left here is the call that lowering does not rewrite, which is the
 partial application `int-rem x`: the rewrite fires only on the
 two-argument apply. Both forms were measured against
 `codex/test/int-rem` -- these functions carried the whole pin before
 the lowering rewrite existed, which is why they are known good rather
 than merely plausible.

  emit-int-rem-reg-locals : CodegenState, Integer, Integer -> EmitResult
  emit-int-rem-reg-locals (st) (a-reg) (b-reg) =
   let st1 = st-append-code st (mov-rr reg-rax a-reg)
   in let st2 = st-append-code st1 cqo
   in let st3 = st-append-code st2 (idiv-r b-reg)
   in let rd = alloc-temp st3
   in let st4 = st-append-code (rd.state) (mov-rr (rd.reg) reg-rdx)
   in EmitResult {
    state = st4,
    reg = rd.reg
   }

  emit-int-rem-builtin : CodegenState, List IRExpr -> EmitResult
  emit-int-rem-builtin (st) (args) =
   let a = list-at args 0
   in let b = list-at args 1
   in when a
    is IrName (an) (at) (asp) ->
     let a-slot = lookup-local (st.locals) an
     in when b
      is IrName (bn) (bt) (bsp) ->
       let b-slot = lookup-local (st.locals) bn
       in if a-slot >= 0 & a-slot < spill-base & b-slot >= 0 & b-slot < spill-base then emit-int-rem-reg-locals st a-slot b-slot
       else emit-int-rem-standard st args
      is otherwise -> emit-int-rem-standard st args
    is otherwise -> emit-int-rem-standard st args

  emit-int-rem-standard : CodegenState, List IRExpr -> EmitResult
  emit-int-rem-standard (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let ld0 = load-local st2 (loc0.reg)
   in let st3 = st-append-code (ld0.state) (mov-rr reg-rax (ld0.reg))
   in let st4 = st-append-code st3 cqo
   in let ld1 = load-local st4 (loc1.reg)
   in let st5 = st-append-code (ld1.state) (idiv-r (ld1.reg))
   in let rd = alloc-temp st5
   in let st6 = st-append-code (rd.state) (mov-rr (rd.reg) reg-rdx)
   in EmitResult {
    state = st6,
    reg = rd.reg
   }

  emit-get-args-builtin : CodegenState -> EmitResult
  emit-get-args-builtin (st) =
    let rd = alloc-temp st
   in let st1 = st-append-code (rd.state) (li reg-r11 0)
   in let st2 = st-append-code st1 (mov-store reg-r10 reg-r11 0)
   in let st3 = st-append-code st2 (add-ri reg-r10 8)
   in let st4 = st-append-code st3 (mov-rr (rd.reg) reg-r10)
   in let st5 = st-append-code st4 (mov-store reg-r10 reg-r11 0)
   in let st6 = st-append-code st5 (add-ri reg-r10 8)
   in EmitResult {
   state = st6,
   reg = rd.reg
  }

  emit-current-dir-builtin : CodegenState -> EmitResult
  emit-current-dir-builtin (st) =
    let rd = alloc-temp st
   in let st1 = st-append-code (rd.state) (mov-rr (rd.reg) reg-r10)
   in let st2 = st-append-code st1 (li reg-r11 0)
   in let st3 = st-append-code st2 (mov-store reg-r10 reg-r11 0)
   in let st4 = st-append-code st3 (add-ri reg-r10 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-substring-alloc : CodegenState, Integer, Integer, Integer -> CodegenState
  emit-substring-alloc (st) (str-loc) (start-loc) (len-loc) =
    let len-loaded = load-local st len-loc
   in let st0 = st-append-code (len-loaded.state) (mov-rr reg-r11 (len-loaded.reg))
   in let st1 = st-append-code st0 (add-ri reg-r11 15)
   in let st2 = st-append-code st1 (and-ri reg-r11 (-8))
   in st-append-code st2 (add-rr reg-r10 reg-r11)

  emit-substring-copy : CodegenState, Integer, Integer, Integer, Integer -> CodegenState
  emit-substring-copy (st) (str-loc) (start-loc) (len-loc) (ptr-loc) =
    let st0 = st-append-code st (li reg-r11 0)
   in let sub-loop = st0.code-len
   in let len-ld = load-local st0 len-loc
   in let st1 = st-append-code (len-ld.state) (cmp-rr reg-r11 (len-ld.reg))
   in let sub-exit-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let src-ld = load-local st2 str-loc
   in let start-ld = load-local (src-ld.state) start-loc
   in let st3 = st-append-code (start-ld.state) (mov-rr reg-rsi (src-ld.reg))
   in let st4 = st-append-code st3 (add-rr reg-rsi (start-ld.reg))
   in let st5 = st-append-code st4 (add-rr reg-rsi reg-r11)
   in let st6 = st-append-code st5 (movzx-byte reg-rsi reg-rsi 8)
   in let ptr-ld = load-local st6 ptr-loc
   in let st7 = st-append-code (ptr-ld.state) (mov-rr reg-rdx (ptr-ld.reg))
   in let st8 = st-append-code st7 (add-rr reg-rdx reg-r11)
   in let st9 = st-append-code st8 (mov-store-byte reg-rdx reg-rsi 8)
   in let st10 = st-append-code st9 (add-ri reg-r11 1)
   in let st11 = st-append-code st10 (jmp (sub-loop - (st10.code-len + 5)))
   in patch-jcc-at st11 sub-exit-pos (st11.code-len)

  emit-substring-builtin : CodegenState, List IRExpr -> EmitResult
  emit-substring-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let r2 = emit-expr st2 (list-at args 2)
   in let loc2 = alloc-local (r2.state)
   in let st3 = store-local (loc2.state) (loc2.reg) (r2.reg)
   in let ptr-loc = alloc-local st3
   in let ptr-tmp = alloc-temp (ptr-loc.state)
   in let st4 = st-append-code (ptr-tmp.state) (mov-rr (ptr-tmp.reg) reg-r10)
   in let st5 = store-local st4 (ptr-loc.reg) (ptr-tmp.reg)
   in let len-ld = load-local st5 (loc2.reg)
   in let ptr-ld = load-local (len-ld.state) (ptr-loc.reg)
   in let st6 = st-append-code (ptr-ld.state) (mov-store (ptr-ld.reg) (len-ld.reg) 0)
   in let st7 = emit-substring-alloc st6 (loc0.reg) (loc1.reg) (loc2.reg)
   in let st8 = emit-substring-copy st7 (loc0.reg) (loc1.reg) (loc2.reg) (ptr-loc.reg)
   in let result = load-local st8 (ptr-loc.reg)
   in EmitResult {
   state = result.state,
   reg = result.reg
  }

  emit-print-line-builtin : CodegenState, List IRExpr -> EmitResult
  emit-print-line-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = when st.exit-mode
    is ExitUefi -> emit-uefi-print-text (r.state) (r.reg)
    is otherwise -> emit-print-text (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-print-no-newline-builtin : CodegenState, List IRExpr -> EmitResult
  emit-print-no-newline-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = when st.exit-mode
    is ExitUefi -> emit-uefi-print-text-no-newline (r.state) (r.reg)
    is otherwise -> emit-print-text-no-newline (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-print-line-raw-builtin : CodegenState, List IRExpr -> EmitResult
  emit-print-line-raw-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = emit-print-text-raw (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-read-file-builtin : CodegenState, List IRExpr -> EmitResult
  emit-read-file-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 "__bare_metal_read_serial"
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-read-file-raw-builtin : CodegenState, List IRExpr -> EmitResult
  emit-read-file-raw-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 "__bare_metal_read_serial_raw"
   in let rd = alloc-temp st2
   in EmitResult {
