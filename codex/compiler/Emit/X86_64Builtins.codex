  emit-memset-builtin : CodegenState, List IRExpr -> EmitResult
  emit-memset-builtin (st) (args) =
   let addr-r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-loc = alloc-local (addr-r.state)
   in let st1 = store-local (addr-loc.state) (addr-loc.reg) (addr-r.reg)
   in let byte-r = emit-expr st1 (list-at args 1)
   in let byte-loc = alloc-local (byte-r.state)
   in let st2 = store-local (byte-loc.state) (byte-loc.reg) (byte-r.reg)
   in let count-r = emit-expr st2 (list-at args 2)
   in let count-loc = alloc-local (count-r.state)
   in let st3 = store-local (count-loc.state) (count-loc.reg) (count-r.reg)
   in let rdi-load = load-local st3 (addr-loc.reg)
   in let st4 = st-append-code (rdi-load.state) (mov-rr reg-rdi (rdi-load.reg))
   in let rax-load = load-local st4 (byte-loc.reg)
   in let st5 = st-append-code (rax-load.state) (mov-rr reg-rax (rax-load.reg))
   in let rcx-load = load-local st5 (count-loc.reg)
   in let st6 = st-append-code (rcx-load.state) (mov-rr reg-rcx (rcx-load.reg))
   in let st7 = st-append-code st6 (cld & rep-stosb)
   in let rd = alloc-temp st7
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-pos-builtin : CodegenState -> EmitResult
  emit-deck-pos-builtin (st) =
   let rd = alloc-temp st
   in let st1 = st-append-code (rd.state) (li (rd.reg) deck-pos-addr)
   in EmitResult {
   state = st-append-code st1 (mov-load (rd.reg) (rd.reg) 0),
   reg = rd.reg
  }

 Evicts RAX for the same reason emit-text-lit does: the mov-ri64 below writes RAX
 before alloc-temp runs, and alloc-temp only evicts the register it allocates, so
 a field cached in RAX would survive in the cache after this instruction had
 overwritten it. This is the second and last site with that shape.

  emit-self-type-defs-builtin : CodegenState -> EmitResult
  emit-self-type-defs-builtin (st) =
   let site = st.code-len + 2
   in let st1 = st-append-code (fc-evict-reg st reg-rax) (mov-ri64 reg-rax 0)
   in let sites = list-push (st1.stype-sites) site
   in let st2 = __record-set st1 "stype-sites" sites
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-deck-set-builtin : CodegenState, List IRExpr -> EmitResult
  emit-deck-set-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-tmp = alloc-temp-avoiding (r.state) (r.reg)
   in let st1 = st-append-code (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let st2 = st-append-code st1 (mov-store (addr-tmp.reg) (r.reg) 0)
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-alloc-builtin : CodegenState, List IRExpr -> EmitResult
  emit-deck-alloc-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-tmp = alloc-temp-avoiding (r.state) (r.reg)
   in let st1 = st-append-code (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let rd = alloc-temp-avoiding st1 (r.reg)
   in let st2 = st-append-code (rd.state) (mov-load (rd.reg) (addr-tmp.reg) 0)
   in let new-tmp = alloc-temp-avoiding st2 (r.reg)
   in let st3 = st-append-code (new-tmp.state) (mov-rr (new-tmp.reg) (rd.reg))
   in let st4 = st-append-code st3 (add-rr (new-tmp.reg) (r.reg))
   in EmitResult {
   state = st-append-code st4 (mov-store (addr-tmp.reg) (new-tmp.reg) 0),
   reg = rd.reg
  }

  emit-deck-enter-builtin : CodegenState -> EmitResult
  emit-deck-enter-builtin (st) =
   let t0 = alloc-temp st
   in let st1 = st-append-code (t0.state) (li (t0.reg) deck-bound-counter-addr)
   in let t1 = alloc-temp st1
   in let st2 = st-append-code (t1.state) (mov-load (t1.reg) (t0.reg) 0)
   in let t2 = alloc-temp st2
   in let st3 = st-append-code (t2.state) (mov-rr (t2.reg) (t1.reg))
   in let st4 = st-append-code st3 (add-ri (t2.reg) 1)
   in let st5 = st-append-code st4 (mov-store (t0.reg) (t2.reg) 0)
   in let st6 = st-append-code st5 (cmp-ri (t1.reg) 0)
   in let jcc-pos = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-ne 0)
   in let t3 = alloc-temp st7
   in let st8 = st-append-code (t3.state) (li (t3.reg) bivy-save-addr)
   in let st9 = st-append-code st8 (mov-store (t3.reg) reg-r10 0)
   in let t4 = alloc-temp st9
   in let st10 = st-append-code (t4.state) (li (t4.reg) deck-pos-addr)
   in let st11 = st-append-code st10 (mov-load reg-r10 (t4.reg) 0)
   in let st12 = patch-jcc-at st11 jcc-pos (st11.code-len)
   in let rd = alloc-temp st12
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-exit-builtin : CodegenState -> EmitResult
  emit-deck-exit-builtin (st) =
   let e0 = alloc-temp st
   in let st1 = st-append-code (e0.state) (li (e0.reg) deck-bound-counter-addr)
   in let e1 = alloc-temp st1
   in let st2 = st-append-code (e1.state) (mov-load (e1.reg) (e0.reg) 0)
   in let st3 = st-append-code st2 (add-ri (e1.reg) (0 - 1))
   in let st4 = st-append-code st3 (mov-store (e0.reg) (e1.reg) 0)
   in let jcc-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-ne 0)
   in let e2 = alloc-temp st5
   in let st6 = st-append-code (e2.state) (li (e2.reg) deck-pos-addr)
   in let st7 = st-append-code st6 (mov-store (e2.reg) reg-r10 0)
   in let e3 = alloc-temp st7
   in let st8 = st-append-code (e3.state) (li (e3.reg) bivy-save-addr)
   in let st9 = st-append-code st8 (mov-load reg-r10 (e3.reg) 0)
   in let st10 = patch-jcc-at st9 jcc-pos (st9.code-len)
   in let rd = alloc-temp st10
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-list-with-capacity-builtin : CodegenState, List IRExpr -> EmitResult
  emit-list-with-capacity-builtin (st) (args) =
   let cap-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in emit-list-with-capacity-builtin-bivy (cap-result.state) (cap-result.reg)

  emit-list-with-capacity-builtin-bivy : CodegenState, Integer -> EmitResult
  emit-list-with-capacity-builtin-bivy (st) (cap-reg) =
   let rd = alloc-temp-avoiding st cap-reg
   in let st1 = st-append-code (rd.state) (mov-store reg-r10 cap-reg 0)
   in let st2 = st-append-code st1 (add-ri reg-r10 8)
   in let st3 = st-append-code st2 (mov-rr (rd.reg) reg-r10)
   in let zero-tmp = alloc-temp-avoiding st3 cap-reg
   in let st4 = st-append-code (zero-tmp.state) (li (zero-tmp.reg) 0)
   in let st5 = st-append-code st4 (mov-store reg-r10 (zero-tmp.reg) 0)
   in let adv-tmp = alloc-temp-avoiding st5 cap-reg
   in let st6 = st-append-code (adv-tmp.state) (mov-rr (adv-tmp.reg) cap-reg)
   in let st7 = st-append-code st6 (shl-ri (adv-tmp.reg) 3)
   in let st8 = st-append-code st7 (add-ri (adv-tmp.reg) 8)
   in EmitResult {
   state = st-append-code st8 (add-rr reg-r10 (adv-tmp.reg)),
   reg = rd.reg
  }

  emit-list-with-capacity-builtin-deck : CodegenState, Integer -> EmitResult
  emit-list-with-capacity-builtin-deck (st) (cap-reg) =
   let addr-tmp = alloc-temp-avoiding st cap-reg
   in let st0 = st-append-code (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let deckp-tmp = alloc-temp-avoiding st0 cap-reg
   in let st1 = st-append-code (deckp-tmp.state) (mov-load (deckp-tmp.reg) (addr-tmp.reg) 0)
   in let st2 = st-append-code st1 (mov-store (deckp-tmp.reg) cap-reg 0)
   in let st3 = st-append-code st2 (add-ri (deckp-tmp.reg) 8)
   in let rd = alloc-temp-avoiding st3 cap-reg
   in let st4 = st-append-code (rd.state) (mov-rr (rd.reg) (deckp-tmp.reg))
   in let zero-tmp = alloc-temp-avoiding st4 cap-reg
   in let st5 = st-append-code (zero-tmp.state) (li (zero-tmp.reg) 0)
   in let st6 = st-append-code st5 (mov-store (deckp-tmp.reg) (zero-tmp.reg) 0)
   in let adv-tmp = alloc-temp-avoiding st6 cap-reg
   in let st7 = st-append-code (adv-tmp.state) (mov-rr (adv-tmp.reg) cap-reg)
   in let st8 = st-append-code st7 (shl-ri (adv-tmp.reg) 3)
   in let st9 = st-append-code st8 (add-ri (adv-tmp.reg) 8)
   in let st10 = st-append-code st9 (add-rr (deckp-tmp.reg) (adv-tmp.reg))
   in EmitResult {
   state = st-append-code st10 (mov-store (addr-tmp.reg) (deckp-tmp.reg) 0),
   reg = rd.reg
  }

  emit-buf-write-byte-builtin : CodegenState, List IRExpr -> EmitResult
  emit-buf-write-byte-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let byte-result = emit-expr st2 (list-at args 2)
   in let byte-loc = alloc-local (byte-result.state)
   in let st3 = store-local (byte-loc.state) (byte-loc.reg) (byte-result.reg)
   in let addr = alloc-temp st3
   in let base2 = load-local (addr.state) (base-loc.reg)
   in let off2 = load-local (base2.state) (off-loc.reg)
   in let st4 = st-append-code (off2.state) (mov-rr (addr.reg) (base2.reg))
   in let st5 = st-append-code st4 (add-rr (addr.reg) (off2.reg))
   in let byte2 = load-local st5 (byte-loc.reg)
   in let st6 = st-append-code (byte2.state) (mov-store-byte (addr.reg) (byte2.reg) 0)
   in let rd = alloc-temp st6
   in let off3 = load-local (rd.state) (off-loc.reg)
   in let st7 = st-append-code (off3.state) (mov-rr (rd.reg) (off3.reg))
   in EmitResult {
   state = st-append-code st7 (add-ri (rd.reg) 1),
   reg = rd.reg
  }

  emit-buf-write-bytes-builtin : CodegenState, List IRExpr -> EmitResult
  emit-buf-write-bytes-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let list-result = emit-expr st2 (list-at args 2)
   in let st3 = st-append-code (list-result.state) (mov-rr reg-rdx (list-result.reg))
   in let off2 = load-local st3 (off-loc.reg)
   in let st4 = st-append-code (off2.state) (mov-rr reg-rsi (off2.reg))
   in let base2 = load-local st4 (base-loc.reg)
   in let st5 = st-append-code (base2.state) (mov-rr reg-rdi (base2.reg))
   in let st6 = emit-call-to st5 "__buf_write_bytes"
   in let rd = alloc-temp st6
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-buf-read-bytes-builtin : CodegenState, List IRExpr -> EmitResult
  emit-buf-read-bytes-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let count-result = emit-expr st2 (list-at args 2)
   in let st3 = st-append-code (count-result.state) (mov-rr reg-rdx (count-result.reg))
   in let off2 = load-local st3 (off-loc.reg)
   in let st4 = st-append-code (off2.state) (mov-rr reg-rsi (off2.reg))
   in let base2 = load-local st4 (base-loc.reg)
   in let st5 = st-append-code (base2.state) (mov-rr reg-rdi (base2.reg))
   in let st6 = emit-call-to st5 "__buf_read_bytes"
   in let rd = alloc-temp st6
   in EmitResult {
   state = st-append-code (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-bit-op-2 : CodegenState, List IRExpr, (Integer, Integer -> List Integer) -> EmitResult
  emit-bit-op-2 (st) (args) (op-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp-avoiding (ld0.state) (r1.reg)
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg) & op-bytes (rd.reg) (r1.reg)),
    reg = rd.reg
   }

  emit-bit-shift : CodegenState, List IRExpr, (Integer -> List Integer) -> EmitResult
  emit-bit-shift (st) (args) (shift-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let st2 = st-append-code (r1.state) (mov-rr reg-rcx (r1.reg))
   in let ld0 = load-local st2 (loc0.reg)
   in let st3 = if int-mod ((ld0.state).next-temp) 6 == 1 then __record-set (ld0.state) "next-temp" ((ld0.state).next-temp + 1) else ld0.state
   in let rd = alloc-temp st3
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg) & shift-bytes (rd.reg)),
    reg = rd.reg
   }

  emit-bit-not : CodegenState, List IRExpr -> EmitResult
  emit-bit-not (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r0.state)
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (r0.reg) & not-r (rd.reg)),
    reg = rd.reg
   }

Section: State Effect

 Integer-width state scoped to a run-state body. State lives in a
 single stack-slot local whose slot index is tracked on
 CodegenState.state-local. Nested run-state saves and restores the
 slot index so inner scopes shadow, not overwrite, outer ones.

  emit-run-state-builtin : CodegenState, List IRExpr -> EmitResult
  emit-run-state-builtin (st) (args) =
   let init = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let cell = alloc-local (init.state)
   in let st1 = store-local (cell.state) (cell.reg) (init.reg)
   in let saved = st1.state-local
   in let st2 = __record-set st1 "state-local" (cell.reg)
   in let body = emit-expr st2 (list-at args 1)
   in let st3 = __record-set (body.state) "state-local" saved
   in EmitResult { state = st3, reg = body.reg }

  emit-get-state-builtin : CodegenState -> EmitResult
  emit-get-state-builtin (st) =
   if st.state-local < 0 then
    let tmp = alloc-temp st
    in EmitResult {
     state = st-append-code (tmp.state) (li (tmp.reg) 0),
     reg = tmp.reg
    }
   else load-local st (st.state-local)

  emit-set-state-builtin : CodegenState, List IRExpr -> EmitResult
  emit-set-state-builtin (st) (args) =
   let v = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = if st.state-local < 0 then v.state
                else store-local (v.state) (st.state-local) (v.reg)
   in let rd = alloc-temp st1
   in EmitResult {
    state = st-append-code (rd.state) (li (rd.reg) 0),
    reg = rd.reg
   }

  emit-vec-splat-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-splat-builtin (st) (args) =
   let val = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (val.state)
   in let st1 = store-local (loc.state) (loc.reg) (val.reg)
   in let alloc = emit-bivy-alloc st1 16
   in let vld = load-local (alloc.state) (loc.reg)
   in let p1 = load-local (vld.state) (alloc.ptr-loc)
   in let st2 = st-append-code (p1.state) (mov-store (p1.reg) (vld.reg) 0)
   in let p2 = load-local st2 (alloc.ptr-loc)
   in let vld2 = load-local (p2.state) (loc.reg)
   in let st3 = st-append-code (vld2.state) (mov-store (p2.reg) (vld2.reg) 8)
   in let result = load-local st3 (alloc.ptr-loc)
   in EmitResult {
    state = result.state,
    reg = result.reg
   }

  emit-vec-extract-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-extract-builtin (st) (args) =
   let vec = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let vec-loc = alloc-local (vec.state)
   in let st1 = store-local (vec-loc.state) (vec-loc.reg) (vec.reg)
   in let idx = emit-expr st1 (list-at args 1)
   in let vld = load-local (idx.state) (vec-loc.reg)
   in let rd = alloc-temp-avoiding (vld.state) (idx.reg)
   in let st2 = st-append-code (rd.state) (
    mov-rr (rd.reg) (idx.reg)
    & shl-ri (rd.reg) 3
    & add-rr (rd.reg) (vld.reg)
    & mov-load (rd.reg) (rd.reg) 0
   )
   in EmitResult {
    state = st2,
    reg = rd.reg
   }

  emit-vec-arith-core : CodegenState, List IRExpr, List Integer -> EmitResult
  emit-vec-arith-core (st) (args) (op-bytes) =
   let lhs = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let lhs-loc = alloc-local (lhs.state)
   in let st1 = store-local (lhs-loc.state) (lhs-loc.reg) (lhs.reg)
   in let rhs = emit-expr (st-set-tail-pos st1 False) (list-at args 1)
   in let rhs-loc = alloc-local (rhs.state)
   in let st2 = store-local (rhs-loc.state) (rhs-loc.reg) (rhs.reg)
   in let lld = load-local st2 (lhs-loc.reg)
   in let st3 = st-append-code (lld.state) (movupd-load 0 (lld.reg) 0)
   in let rld = load-local st3 (rhs-loc.reg)
   in let st4 = st-append-code (rld.state) (movupd-load 1 (rld.reg) 0)
   in let st5 = st-append-code st4 op-bytes
   in let alloc = emit-bivy-alloc st5 16
   in let p1 = load-local (alloc.state) (alloc.ptr-loc)
   in let st6 = st-append-code (p1.state) (movupd-store (p1.reg) 0 0)
   in let result = load-local st6 (alloc.ptr-loc)
   in EmitResult {
    state = result.state,
    reg = result.reg
   }

  emit-vec-add-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-add-builtin (st) (args) = emit-vec-arith-core st args (addpd-xmm 0 1)

  emit-vec-sub-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-sub-builtin (st) (args) = emit-vec-arith-core st args (subpd-xmm 0 1)

  emit-vec-mul-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-mul-builtin (st) (args) = emit-vec-arith-core st args (mulpd-xmm 0 1)

  emit-vec-div-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-div-builtin (st) (args) = emit-vec-arith-core st args (divpd-xmm 0 1)

  vec-reduce-add-insns : Integer, Integer -> List Integer
  vec-reduce-add-insns (ptr-reg) (rd-reg) =
   mov-load rd-reg ptr-reg 8
   & movq-to-xmm 1 rd-reg
   & addsd-xmm 0 1
   & movq-from-xmm rd-reg 0

  emit-vec-reduce-add-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-reduce-add-builtin (st) (args) =
   let vec = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (vec.state)
   in let st1 = store-local (loc.state) (loc.reg) (vec.reg)
   in let vld1 = load-local st1 (loc.reg)
   in let st2 = st-append-code (vld1.state) (movupd-load 0 (vld1.reg) 0)
   in let vld2 = load-local st2 (loc.reg)
   in let rd = alloc-temp (vld2.state)
   in let st3 = st-append-code (rd.state) (vec-reduce-add-insns (vld2.reg) (rd.reg))
   in EmitResult {
    state = st3,
    reg = rd.reg
   }

  emit-vec-load-at-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-load-at-builtin (st) (args) =
   let addr = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (addr.state) (movupd-load 0 (addr.reg) 0)
   in let alloc = emit-bivy-alloc st1 16
   in let p1 = load-local (alloc.state) (alloc.ptr-loc)
   in let st2 = st-append-code (p1.state) (movupd-store (p1.reg) 0 0)
   in let result = load-local st2 (alloc.ptr-loc)
   in EmitResult {
    state = result.state,
    reg = result.reg
   }

  emit-vec-store-at-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-store-at-builtin (st) (args) =
   let addr = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-loc = alloc-local (addr.state)
   in let st1 = store-local (addr-loc.state) (addr-loc.reg) (addr.reg)
   in let vec = emit-expr st1 (list-at args 1)
   in let st2 = st-append-code (vec.state) (movupd-load 0 (vec.reg) 0)
   in let ald = load-local st2 (addr-loc.reg)
   in let st3 = st-append-code (ald.state) (movupd-store (ald.reg) 0 0)
   in let rd = alloc-temp st3
   in EmitResult {
    state = st-append-code (rd.state) (li (rd.reg) 0),
    reg = rd.reg
   }

  emit-vec-select-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec-select-builtin (st) (args) =
   let mask = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let mask-loc = alloc-local (mask.state)
   in let st1 = store-local (mask-loc.state) (mask-loc.reg) (mask.reg)
   in let tv = emit-expr (st-set-tail-pos st1 False) (list-at args 1)
   in let tv-loc = alloc-local (tv.state)
   in let st2 = store-local (tv-loc.state) (tv-loc.reg) (tv.reg)
   in let fv = emit-expr (st-set-tail-pos st2 False) (list-at args 2)
   in let fv-loc = alloc-local (fv.state)
   in let st3 = store-local (fv-loc.state) (fv-loc.reg) (fv.reg)
   in let mld = load-local st3 (mask-loc.reg)
   in let st4 = st-append-code (mld.state) (movupd-load 0 (mld.reg) 0)
   in let tld = load-local st4 (tv-loc.reg)
   in let st5 = st-append-code (tld.state) (movupd-load 1 (tld.reg) 0)
   in let fld = load-local st5 (fv-loc.reg)
   in let st6 = st-append-code (fld.state) (movupd-load 2 (fld.reg) 0)
   in let st7 = st-append-code st6 (andpd-xmm 1 0)
   in let st8 = st-append-code st7 (andnpd-xmm 0 2)
   in let st9 = st-append-code st8 (orpd-xmm 1 0)
   in let alloc = emit-bivy-alloc st9 16
   in let p1 = load-local (alloc.state) (alloc.ptr-loc)
   in let st10 = st-append-code (p1.state) (movupd-store (p1.reg) 0 1)
   in let result = load-local st10 (alloc.ptr-loc)
   in EmitResult {
    state = result.state,
    reg = result.reg
   }

  emit-vec4-splat-builtin : CodegenState, List IRExpr -> EmitResult
  emit-vec4-splat-builtin (st) (args) =
   let val = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-code (val.state) (movq-to-xmm 0 (val.reg) & shufps-xmm 0 0 0)
   in let alloc = emit-bivy-alloc st1 16
   in let p1 = load-local (alloc.state) (alloc.ptr-loc)
   in let st2 = st-append-code (p1.state) (movups-store (p1.reg) 0 0)
   in let result = load-local st2 (alloc.ptr-loc)
   in EmitResult {
    state = result.state,
    reg = result.reg
