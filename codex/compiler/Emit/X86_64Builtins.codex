  emit-atomic-cas-builtin : CodegenState, List IRExpr -> EmitResult
  emit-atomic-cas-builtin (st) (args) =
   let addr-r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-loc = alloc-local (addr-r.state)
   in let st1 = store-local (addr-loc.state) (addr-loc.reg) (addr-r.reg)
   in let expected-r = emit-expr st1 (list-at args 1)
   in let expected-loc = alloc-local (expected-r.state)
   in let st2 = store-local (expected-loc.state) (expected-loc.reg) (expected-r.reg)
   in let desired-r = emit-expr st2 (list-at args 2)
   in let desired-loc = alloc-local (desired-r.state)
   in let st3 = store-local (desired-loc.state) (desired-loc.reg) (desired-r.reg)
   in let rax-load = load-local st3 (expected-loc.reg)
   in let st4 = st-append-code (rax-load.state) (mov-rr reg-rax (rax-load.reg))
   in let src-load = load-local st4 (desired-loc.reg)
   in let addr-reload = load-local (src-load.state) (addr-loc.reg)
   in let st5 = st-append-code (addr-reload.state) (lock-cmpxchg-mem (src-load.reg) (addr-reload.reg) 0)
   in let rd = alloc-temp st5
   in EmitResult {
    state = st-append-code (st-append-code (rd.state) (setcc cc-e (rd.reg))) (movzx-byte-self (rd.reg)),
    reg = rd.reg
   }

