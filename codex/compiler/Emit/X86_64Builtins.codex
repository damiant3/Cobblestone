  emit-bit-op-2 : CodegenState, List IRExpr, (Integer -> Integer -> List Integer) -> EmitResult
  emit-bit-op-2 (st) (args) (op-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp (ld0.state)
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg) & op-bytes (rd.reg) (r1.reg)),
    reg = rd.reg
   }

  emit-bit-shift : CodegenState, List IRExpr, (Integer -> List Integer) -> EmitResult
  emit-bit-shift (st) (args) (shift-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let st2 = st-append-code (r1.state) (mov-rr reg-rcx (r1.reg))
   in let ld0 = load-local st2 (loc0.reg)
   in let st3 = if int-mod ((ld0.state).next-temp) 6 == 1 then __record-set (ld0.state) "next-temp" ((ld0.state).next-temp + 1) else ld0.state
   in let rd = alloc-temp st3
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (ld0.reg) & shift-bytes (rd.reg)),
    reg = rd.reg
   }

  emit-bit-not : CodegenState, List IRExpr -> EmitResult
  emit-bit-not (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r0.state)
   in EmitResult {
    state = st-append-code (rd.state) (mov-rr (rd.reg) (r0.reg) & not-r (rd.reg)),
    reg = rd.reg
   }

Section: State Effect

 Integer-width state scoped to a run-state body. State lives in a
 single stack-slot local whose slot index is tracked on
 CodegenState.state-local. Nested run-state saves and restores the
 slot index so inner scopes shadow, not overwrite, outer ones.

  emit-run-state-builtin : CodegenState, List IRExpr -> EmitResult
  emit-run-state-builtin (st) (args) =
   let init = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let cell = alloc-local (init.state)
   in let st1 = store-local (cell.state) (cell.reg) (init.reg)
   in let saved = st1.state-local
   in let st2 = __record-set st1 "state-local" (cell.reg)
   in let body = emit-expr st2 (list-at args 1)
   in let st3 = __record-set (body.state) "state-local" saved
   in EmitResult { state = st3, reg = body.reg }

  emit-get-state-builtin : CodegenState -> EmitResult
  emit-get-state-builtin (st) =
   if st.state-local < 0 then
    let tmp = alloc-temp st
    in EmitResult {
     state = st-append-code (tmp.state) (li (tmp.reg) 0),
     reg = tmp.reg
    }
   else load-local st (st.state-local)

  emit-set-state-builtin : CodegenState, List IRExpr -> EmitResult
  emit-set-state-builtin (st) (args) =
   let v = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = if st.state-local < 0 then v.state
                else store-local (v.state) (st.state-local) (v.reg)
   in let rd = alloc-temp st1
   in EmitResult {
    state = st-append-code (rd.state) (li (rd.reg) 0),
    reg = rd.reg
   }

Section: Builtin Registry
  BuiltinX86Emitter = record {
   name : Text,
   emit : CodegenState, List IRExpr -> EmitResult
  }

  bsearch-x86-emitter-pos : List BuiltinX86Emitter, Text, Integer, Integer -> Integer
  bsearch-x86-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-x86-emitter-pos entries name lo mid
      else bsearch-x86-emitter-pos entries name (mid + 1) hi

  sort-x86-emitters : List BuiltinX86Emitter -> List BuiltinX86Emitter
  sort-x86-emitters (xs) = sort-by xs (\a b -> text-compare (a.name) (b.name))

  x86-builtin-emitters : List BuiltinX86Emitter
  x86-builtin-emitters = sort-x86-emitters ([
   BuiltinX86Emitter { name = "print-line", emit = \s a -> emit-print-line-raw-builtin s a },
   BuiltinX86Emitter { name = "print-line-raw", emit = \s a -> emit-print-line-raw-builtin s a },
   BuiltinX86Emitter { name = "print-line-uni", emit = \s a -> emit-print-line-builtin s a },
   BuiltinX86Emitter { name = "print-uni", emit = \s a -> emit-print-no-newline-builtin s a },
   BuiltinX86Emitter { name = "print-error", emit = \s a -> emit-print-line-raw-builtin s a },
   BuiltinX86Emitter { name = "print-error-uni", emit = \s a -> emit-print-line-builtin s a },
   BuiltinX86Emitter { name = "read-file", emit = \s a -> emit-read-serial-cce-builtin s a },
   BuiltinX86Emitter { name = "read-file-raw", emit = \s a -> emit-read-file-raw-builtin s a },
   BuiltinX86Emitter { name = "read-file-uni", emit = \s a -> emit-read-file-builtin s a },
   BuiltinX86Emitter { name = "read-serial-cce", emit = \s a -> emit-read-serial-cce-builtin s a },
   BuiltinX86Emitter { name = "write-file", emit = \s a -> emit-write-file-builtin s a },
   BuiltinX86Emitter { name = "read-line", emit = \s a -> emit-read-line-builtin s },
   BuiltinX86Emitter { name = "read-line-cce", emit = \s a -> emit-read-line-cce-builtin s },
   BuiltinX86Emitter { name = "write-binary", emit = \s a -> emit-write-binary-builtin s a },
   BuiltinX86Emitter { name = "text-length", emit = \s a -> emit-text-length-builtin s a },
   BuiltinX86Emitter { name = "integer-to-text", emit = \s a -> emit-helper-call-1 s a "__itoa" },
   BuiltinX86Emitter { name = "show", emit = \s a -> emit-show-builtin s a },
   BuiltinX86Emitter { name = "text-to-integer", emit = \s a -> emit-helper-call-1 s a "__text_to_int" },
   BuiltinX86Emitter { name = "text-to-double-bits", emit = \s a -> emit-helper-call-1 s a "__text_to_double" },
   BuiltinX86Emitter { name = "text-replace", emit = \s a -> emit-helper-call-3 s a "__str_replace" },
   BuiltinX86Emitter { name = "text-contains", emit = \s a -> emit-helper-call-2 s a "__text_contains" },
   BuiltinX86Emitter { name = "text-starts-with", emit = \s a -> emit-helper-call-2 s a "__text_starts_with" },
   BuiltinX86Emitter { name = "text-compare", emit = \s a -> emit-helper-call-2 s a "__text_compare" },
   BuiltinX86Emitter { name = "text-concat-list", emit = \s a -> emit-helper-call-1 s a "__text_concat_list" },
   BuiltinX86Emitter { name = "text-split", emit = \s a -> emit-helper-call-2 s a "__text_split" },
   BuiltinX86Emitter { name = "substring", emit = \s a -> emit-substring-builtin s a },
   BuiltinX86Emitter { name = "list-length", emit = \s a -> emit-list-length-builtin s a },
   BuiltinX86Emitter { name = "list-at", emit = \s a -> emit-list-at-builtin s a },
   BuiltinX86Emitter { name = "list-cons", emit = \s a -> emit-helper-call-2 s a "__list_cons" },
   BuiltinX86Emitter { name = "list-append", emit = \s a -> emit-helper-call-2 s a "__list_append" },
   BuiltinX86Emitter { name = "list-snoc", emit = \s a -> emit-helper-call-2 s a "__list_snoc" },
   BuiltinX86Emitter { name = "list-push", emit = \s a -> emit-helper-call-2 s a "__list_snoc" },
   BuiltinX86Emitter { name = "list-insert-at", emit = \s a -> emit-helper-call-3 s a "__list_insert_at" },
   BuiltinX86Emitter { name = "list-set-at", emit = \s a -> emit-helper-call-3 s a "__list_set_at" },
   BuiltinX86Emitter { name = "char-at", emit = \s a -> emit-char-at-builtin s a },
   BuiltinX86Emitter { name = "char-code-at", emit = \s a -> emit-char-code-at-builtin s a },
   BuiltinX86Emitter { name = "char-code", emit = \s a -> emit-expr (st-set-tail-pos s False) (list-at a 0) },
   BuiltinX86Emitter { name = "code-to-char", emit = \s a -> emit-expr (st-set-tail-pos s False) (list-at a 0) },
   BuiltinX86Emitter { name = "char-to-text", emit = \s a -> emit-char-to-text-builtin s a },
   BuiltinX86Emitter { name = "is-letter", emit = \s a -> emit-is-letter-builtin s a },
   BuiltinX86Emitter { name = "is-digit", emit = \s a -> emit-is-digit-builtin s a },
   BuiltinX86Emitter { name = "is-whitespace", emit = \s a -> emit-is-whitespace-builtin s a },
   BuiltinX86Emitter { name = "negate", emit = \s a -> emit-negate-builtin s a }
  ] & [
   BuiltinX86Emitter { name = "abs", emit = \s a -> emit-abs-builtin s a },
   BuiltinX86Emitter { name = "min", emit = \s a -> emit-min-builtin s a },
   BuiltinX86Emitter { name = "max", emit = \s a -> emit-max-builtin s a },
   BuiltinX86Emitter { name = "__narrow", emit = \s a -> emit-narrow-builtin s a },
   BuiltinX86Emitter { name = "fail", emit = \s a -> emit-fail-builtin s a },
   BuiltinX86Emitter { name = "int-mod", emit = \s a -> emit-int-mod-builtin s a },
   BuiltinX86Emitter { name = "get-args", emit = \s a -> emit-get-args-builtin s },
   BuiltinX86Emitter { name = "current-dir", emit = \s a -> emit-current-dir-builtin s },
   BuiltinX86Emitter { name = "__record-set", emit = \s a -> emit-record-set-builtin s a },
   BuiltinX86Emitter { name = "__linked-list-empty", emit = \s a -> emit-linked-list-empty-builtin s a },
   BuiltinX86Emitter { name = "__linked-list-push", emit = \s a -> emit-linked-list-push-builtin s a },
   BuiltinX86Emitter { name = "__linked-list-to-list", emit = \s a -> emit-linked-list-to-list-builtin s a },
   BuiltinX86Emitter { name = "__heap-save", emit = \s a -> emit-heap-save-builtin s },
   BuiltinX86Emitter { name = "__heap-restore", emit = \s a -> emit-heap-restore-builtin s a },
   BuiltinX86Emitter { name = "__heap-advance", emit = \s a -> emit-heap-advance-builtin s a },
   BuiltinX86Emitter { name = "__deck-pos", emit = \s a -> emit-deck-pos-builtin s },
   BuiltinX86Emitter { name = "__deck-set", emit = \s a -> emit-deck-set-builtin s a },
   BuiltinX86Emitter { name = "__deck-alloc", emit = \s a -> emit-deck-alloc-builtin s a },
   BuiltinX86Emitter { name = "__deck-enter", emit = \s a -> emit-deck-enter-builtin s },
   BuiltinX86Emitter { name = "__deck-exit", emit = \s a -> emit-deck-exit-builtin s },
   BuiltinX86Emitter { name = "__list-with-capacity", emit = \s a -> emit-list-with-capacity-builtin s a },
   BuiltinX86Emitter { name = "__buf-write-byte", emit = \s a -> emit-buf-write-byte-builtin s a },
   BuiltinX86Emitter { name = "__buf-write-bytes", emit = \s a -> emit-buf-write-bytes-builtin s a },
   BuiltinX86Emitter { name = "__buf-read-bytes", emit = \s a -> emit-buf-read-bytes-builtin s a },
   BuiltinX86Emitter { name = "chan-text-send", emit = \s a -> emit-helper-call-2 s a "chan-text-send" },
   BuiltinX86Emitter { name = "chan-text-recv", emit = \s a -> emit-helper-call-1 s a "chan-text-recv" },
   BuiltinX86Emitter { name = "bit-and", emit = \s a -> emit-bit-op-2 s a and-rr },
   BuiltinX86Emitter { name = "bit-or", emit = \s a -> emit-bit-op-2 s a or-rr },
   BuiltinX86Emitter { name = "bit-xor", emit = \s a -> emit-bit-op-2 s a xor-rr64 },
   BuiltinX86Emitter { name = "bit-shl", emit = \s a -> emit-bit-shift s a shl-cl },
   BuiltinX86Emitter { name = "bit-shr", emit = \s a -> emit-bit-shift s a sar-cl },
   BuiltinX86Emitter { name = "bit-shru", emit = \s a -> emit-bit-shift s a shr-cl },
   BuiltinX86Emitter { name = "bit-not", emit = \s a -> emit-bit-not s a },
   BuiltinX86Emitter { name = "file-exists", emit = \s a -> emit-file-exists-builtin s a },
   BuiltinX86Emitter { name = "force", emit = \s a -> emit-force-builtin s a },
   BuiltinX86Emitter { name = "run-state", emit = \s a -> emit-run-state-builtin s a },
   BuiltinX86Emitter { name = "set-state", emit = \s a -> emit-set-state-builtin s a },
   BuiltinX86Emitter { name = "uefi-read-file", emit = \s a -> emit-helper-call-1 s a "__uefi_read_file" },
   BuiltinX86Emitter { name = "prof-dump", emit = \s a -> emit-helper-call-0 s a "__prof_dump" },
   BuiltinX86Emitter { name = "prof-start", emit = \s a -> emit-helper-call-0 s a "__prof_start" },
   BuiltinX86Emitter { name = "Refl", emit = \s a -> emit-proof-builtin s a },
   BuiltinX86Emitter { name = "assume", emit = \s a -> emit-proof-builtin s a },
   BuiltinX86Emitter { name = "sym", emit = \s a -> emit-proof-builtin s a },
   BuiltinX86Emitter { name = "trans", emit = \s a -> emit-proof-builtin s a },
   BuiltinX86Emitter { name = "cong", emit = \s a -> emit-proof-builtin s a }
  ])

  emit-builtin : CodegenState, Text, List IRExpr -> EmitResult
  emit-builtin (st) (name) (args) =
   let len = list-length x86-builtin-emitters
   in let pos = bsearch-x86-emitter-pos x86-builtin-emitters name 0 len
   in if pos >= len then emit-file-exists-builtin st args
      else let e = list-at x86-builtin-emitters pos
      in if e.name == name then (e.emit) st args
         else emit-file-exists-builtin st args


