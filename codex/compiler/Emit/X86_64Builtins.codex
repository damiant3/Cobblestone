   in let addr-loc = alloc-local (addr-r.state)
   in let st1 = store-local (addr-loc.state) (addr-loc.reg) (addr-r.reg)
   in let val-r = emit-expr st1 (list-at args 1)
   in let addr-reload = load-local (val-r.state) (addr-loc.reg)
   in let st2 = st-append-code (addr-reload.state) (xchg-mem (val-r.reg) (addr-reload.reg) 0)
