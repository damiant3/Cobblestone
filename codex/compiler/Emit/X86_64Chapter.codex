 Bare-metal start routine and chapter entry point (x86-64-emit-cdx).
 ConstructedTy resolution is now in IR/ResolveTypes.codex.

Section: Bare-Metal Start
  bare-metal-heap-base : Integer = 6291456

  emit-oom-string : CodegenState, List Integer, Integer -> CodegenState
  emit-oom-string (st) (chars) (i) =
   if i >= list-length chars then st
   else emit-oom-string (emit-control-wait-and-send st (list-at chars i)) chars (i + 1)

  emit-out-of-memory-handler : CodegenState -> CodegenState
  emit-out-of-memory-handler (st) =
   let st1 = record-func-offset st "__out_of_memory"
   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rsp)
   in let st3 = st-append-code st2 (mov-rr reg-r12 reg-r10)
   in let st3a = st-append-code st3 (li reg-rdi ram-size-addr)
   in let st4 = st-append-code st3a (mov-load reg-rsp reg-rdi 0)
   in let st5 = st-append-code st4 (mov-rr reg-rbp reg-rsp)
   in let st6 = emit-oom-string st5 [79, 85, 84, 32, 79, 70, 32, 77, 69, 77, 79, 82, 89, 10] 0
   in let st7 = st-append-code st6 [244]
   in st-append-code st7 (jmp (-6))

  emit-pet-watchdog-helper : CodegenState -> CodegenState
  emit-pet-watchdog-helper (st) =
   let st1 = record-func-offset st "__pet_watchdog"
   in let st2 = st-append-code st1 (push-r reg-rax)
   in let st3 = st-append-code st2 (li reg-rax wd-stale-tick-addr)
   in let st4 = st-append-code st3 [72, 199, 0, 0, 0, 0, 0]
   in let st5 = st-append-code st4 (pop-r reg-rax)
   in st-append-code st5 [195]

  emit-watchdog-dump-slots-loop : CodegenState, Integer -> CodegenState
  emit-watchdog-dump-slots-loop (st) (i) =
   if i >= 4 then st
   else let slot-offset = i * 32
    in let st1 = st-append-code st (li reg-rsi (wd-ring-buf-addr + slot-offset))
    in let st2 = emit-oom-string st1 [82, 61] 0
    in let st3 = st-append-code st2 (mov-load reg-rdi reg-rsi 0)
    in let st4 = emit-print-hex-qword-rdi st3
    in let st5 = emit-oom-string st4 [32, 83, 61] 0
    in let st6 = st-append-code st5 (mov-load reg-rdi reg-rsi 8)
    in let st7 = emit-print-hex-qword-rdi st6
    in let st8 = emit-oom-string st7 [32, 72, 61] 0
    in let st9 = st-append-code st8 (mov-load reg-rdi reg-rsi 16)
    in let st10 = emit-print-hex-qword-rdi st9
    in let st11 = emit-serial-wait-and-send st10 10
    in emit-watchdog-dump-slots-loop st11 (i + 1)

  emit-watchdog-dump-slots-helper : CodegenState -> CodegenState
  emit-watchdog-dump-slots-helper (st) =
   let st1 = record-func-offset st "__watchdog_dump_slots"
   in let st2 = emit-watchdog-dump-slots-loop st1 0
   in st-append-code st2 [195]

  emit-watchdog-tier1-helper : CodegenState -> CodegenState
  emit-watchdog-tier1-helper (st) =
   let st1 = record-func-offset st "__watchdog_tier1"
   in let st2 = st-append-code st1 (push-r reg-rax)
   in let st3 = st-append-code st2 (push-r reg-rcx)
   in let st4 = st-append-code st3 (push-r reg-rdx)
   in let st5 = st-append-code st4 (push-r reg-rsi)
   in let st6 = st-append-code st5 (push-r reg-rdi)
   in let st7 = emit-oom-string st6 [87, 68, 58, 115, 116, 97, 108, 108, 10] 0
   in let st8 = st-append-code st7 (pop-r reg-rdi)
   in let st9 = st-append-code st8 (pop-r reg-rsi)
   in let st10 = st-append-code st9 (pop-r reg-rdx)
   in let st11 = st-append-code st10 (pop-r reg-rcx)
   in let st12 = st-append-code st11 (pop-r reg-rax)
   in st-append-code st12 [195]

  emit-watchdog-tier2-helper : CodegenState -> CodegenState
  emit-watchdog-tier2-helper (st) =
   let st1 = record-func-offset st "__watchdog_tier2"
   in let st2 = st-append-code st1 (push-r reg-rax)
   in let st3 = st-append-code st2 (push-r reg-rcx)
   in let st4 = st-append-code st3 (push-r reg-rdx)
   in let st5 = st-append-code st4 (push-r reg-rsi)
   in let st6 = st-append-code st5 (push-r reg-rdi)
   in let st7 = emit-oom-string st6 [87, 68, 58, 100, 117, 109, 112, 10] 0
   in let st8 = emit-call-to st7 "__watchdog_dump_slots"
   in let st9 = st-append-code st8 (pop-r reg-rdi)
   in let st10 = st-append-code st9 (pop-r reg-rsi)
   in let st11 = st-append-code st10 (pop-r reg-rdx)
   in let st12 = st-append-code st11 (pop-r reg-rcx)
   in let st13 = st-append-code st12 (pop-r reg-rax)
   in st-append-code st13 [195]

  emit-watchdog-stack-walk-loop : CodegenState, Integer -> CodegenState
  emit-watchdog-stack-walk-loop (st) (i) =
   if i >= 4 then emit-serial-wait-and-send st 10
   else let st1 = st-append-code st (push-r reg-rsi)
    in let st2 = st-append-code st1 (mov-load reg-rdi reg-rsi (i * 8))
    in let st3 = emit-print-hex-qword-rdi st2
    in let st4 = st-append-code st3 (pop-r reg-rsi)
    in let st5 = emit-serial-wait-and-send st4 32
    in emit-watchdog-stack-walk-loop st5 (i + 1)

  emit-watchdog-stack-walk : CodegenState -> CodegenState
  emit-watchdog-stack-walk (st) =
   let st1 = emit-oom-string st [83, 84, 75, 61] 0
   in let st2 = st-append-code st1 (li reg-rdi wd-ring-head-addr)
   in let st3 = st-append-code st2 (mov-load reg-rax reg-rdi 0)
   in let st4 = st-append-code st3 (sub-ri reg-rax 1)
   in let st5 = st-append-code st4 (and-ri reg-rax 3)
   in let st6 = st-append-code st5 (shl-ri reg-rax 5)
   in let st7 = st-append-code st6 (li reg-rsi wd-ring-buf-addr)
   in let st8 = st-append-code st7 (add-rr reg-rsi reg-rax)
   in let st9 = st-append-code st8 (mov-load reg-rsi reg-rsi 8)
   in emit-watchdog-stack-walk-loop st9 0

  emit-watchdog-panic-handler : CodegenState -> CodegenState
  emit-watchdog-panic-handler (st) =
   let st1 = record-func-offset st "__watchdog_panic"
   in let st1a = st-append-code st1 (li reg-rdi ram-size-addr)
   in let st2 = st-append-code st1a (mov-load reg-rsp reg-rdi 0)
   in let st3 = st-append-code st2 (mov-rr reg-rbp reg-rsp)
   in let st4 = emit-oom-string st3 [87, 68, 33, 10] 0
   in let st5 = emit-call-to st4 "__watchdog_dump_slots"
   in let st6 = emit-oom-string st5 [72, 87, 77, 61] 0
   in let st7 = st-append-code st6 (li reg-rdi heap-hwm-addr)
   in let st8 = st-append-code st7 (mov-load reg-rdi reg-rdi 0)
   in let st9 = emit-print-hex-qword-rdi st8
   in let st10 = emit-serial-wait-and-send st9 10
   in let st11 = emit-watchdog-stack-walk st10
   in let st12 = st-append-code st11 [244]
   in st-append-code st12 (jmp (-6))

  emit-trace-serial-dump : CodegenState -> CodegenState
  emit-trace-serial-dump (st) =
   let st0 = st-append-code st (push-r reg-rbx & push-r reg-r12)
   in let st1 = st-append-code st0 (li reg-r11 trace-cursor-addr)
   in let st2 = st-append-code st1 (mov-load reg-rbx reg-r11 0)
   in let st3 = st-append-code st2 (test-rr reg-rbx reg-rbx)
   in let skip-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let st5 = emit-serial-wait-and-send st4 84
   in let st6 = emit-serial-wait-and-send st5 82
   in let st7 = emit-serial-wait-and-send st6 65
   in let st8 = emit-serial-wait-and-send st7 67
   in let st9 = emit-serial-wait-and-send st8 69
   in let st10 = emit-serial-wait-and-send st9 58
   in let st11 = st-append-code st10 (mov-rr reg-rax reg-rbx)
   in let st12 = emit-inline-itoa-and-print st11
   in let st13 = emit-serial-wait-and-send st12 10
   in let st14 = st-append-code st13 (li reg-r12 trace-buf-addr)
   in let st15 = st-append-code st14 (xor-rr reg-rbx reg-rbx)
   in let st16 = st-append-code st15 (li reg-r11 trace-cursor-addr)
   in let st17 = st-append-code st16 (mov-load reg-r11 reg-r11 0)
   in let loop-top = st17.code-len
   in let st18 = st-append-code st17 (cmp-rr reg-rbx reg-r11)
   in let done-pos = st18.code-len
   in let st19 = st-append-code st18 (jcc cc-ge 0)
   in let st20 = emit-serial-wait-and-send st19 84
   in let st21 = emit-serial-wait-and-send st20 58
   in let st22 = st-append-code st21 (push-r reg-r11)
   in let st23 = st-append-code st22 (mov-load reg-rdi reg-r12 0)
   in let st24 = emit-print-hex-qword-rdi st23
   in let st25 = emit-serial-wait-and-send st24 58
   in let st26 = st-append-code st25 (mov-load reg-rdi reg-r12 8)
   in let st27 = emit-print-hex-qword-rdi st26
   in let st28 = emit-serial-wait-and-send st27 10
   in let st29 = st-append-code st28 (pop-r reg-r11)
   in let st30 = st-append-code st29 (add-ri reg-r12 16)
   in let st31 = st-append-code st30 (add-ri reg-rbx 1)
   in let st32 = st-append-code st31 (jmp (loop-top - (st31.code-len + 5)))
   in let st33 = patch-jcc-at st32 done-pos (st32.code-len)
   in let st34 = emit-serial-wait-and-send st33 84
   in let st35 = emit-serial-wait-and-send st34 82
   in let st36 = emit-serial-wait-and-send st35 65
   in let st37 = emit-serial-wait-and-send st36 67
   in let st38 = emit-serial-wait-and-send st37 69
   in let st39 = emit-serial-wait-and-send st38 45
   in let st40 = emit-serial-wait-and-send st39 69
   in let st41 = emit-serial-wait-and-send st40 78
   in let st42 = emit-serial-wait-and-send st41 68
   in let st43 = emit-serial-wait-and-send st42 10
   in let st44 = patch-jcc-at st43 skip-pos (st43.code-len)
   in st-append-code st44 (pop-r reg-r12 & pop-r reg-rbx)

  collect-overflow-patches : List Integer, Integer, Integer, List PatchEntry -> List PatchEntry
  collect-overflow-patches (checks) (oom-offset) (i) (acc) =
   if i >= list-length checks then acc
   else let pos = list-at checks i
    in let rel32 = oom-offset - (pos + 6)
    in collect-overflow-patches checks oom-offset (i + 1) (list-push acc (make-i32-patch (pos + 2) rel32))

  peel-effectful-ty-once : CodexType -> CodexType
  peel-effectful-ty-once (ty) =
   when ty
    is EffectfulTy (effs) (sc) (inner) -> inner
    is otherwise -> ty

  opening-bare-print-type : List IRDef -> CodexType
  opening-bare-print-type (defs) = opening-bare-print-type-loop defs 0 (list-length defs)

  opening-bare-print-type-loop : List IRDef, Integer, Integer -> CodexType
  opening-bare-print-type-loop (defs) (i) (len) =
   if i >= len then NothingTy
   else let d = list-at defs i
   in if d.name == opening-entry-point then peel-effectful-ty-once (strip-fun-args (d.type-val))
      else opening-bare-print-type-loop defs (i + 1) len

  emit-opening-result-print : CodegenState -> CodegenState
  emit-opening-result-print (st) =
   when st.opening-ret-type
    is IntegerTy (lo) (hi) (mode) ->
     let st1 = emit-inline-itoa-and-print st
     in emit-serial-wait-and-send st1 10
    is TextTy -> emit-print-text st reg-rax
    is BooleanTy -> emit-print-bool st reg-rax
    is RealTy ->
     let st1 = st-append-code st (mov-rr reg-rdi reg-rax)
     in let st2 = emit-call-to st1 "__real_to_text"
     in emit-print-text st2 reg-rax
    is ConstructedTy (cname) (cargs) ->
     let resolved = resolve-constructed-ty st (st.opening-ret-type)
     in emit-opening-print-sum st resolved cargs reg-rax
    is SumTy (sname) (sargs) (ctors) ->
     emit-opening-print-sum st (st.opening-ret-type) sargs reg-rax
    is UnitTy (n) (inner) -> emit-opening-result-print (__record-set st "opening-ret-type" inner)
    is otherwise -> st

  emit-opening-print-sum : CodegenState, CodexType, List CodexType, Integer -> CodegenState
  emit-opening-print-sum (st) (resolved) (type-args) (ptr-reg) =
   when resolved
    is SumTy (sname) (sargs) (ctors) ->
     let rbx-guard = alloc-local st
     in let sum-loc = alloc-local (rbx-guard.state)
     in let st0 = store-local (sum-loc.state) (sum-loc.reg) ptr-reg
     in let sum-ld = load-local st0 (sum-loc.reg)
     in let st1 = st-append-code (sum-ld.state) (mov-load reg-rcx (sum-ld.reg) 0)
     in let st2 = emit-opening-print-sum-ctors st1 ctors sargs type-args (sum-loc.reg) 0 (list-length ctors) []
     in emit-serial-wait-and-send st2 10
    is otherwise -> st

  emit-opening-print-sum-ctors : CodegenState, List SumCtor, List CodexType, List CodexType, Integer, Integer, Integer, List Integer -> CodegenState
  emit-opening-print-sum-ctors (st) (ctors) (formal-params) (actual-args) (sum-local) (i) (len) (jmp-patches) =
   if i == len then emit-opening-patch-jmps st jmp-patches 0 (list-length jmp-patches) (st.code-len)
   else let c = list-at ctors i
   in let st0 = st-append-code st (cmp-ri reg-rcx i)
   in let jne-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-ne 0)
   in let name-result = emit-text-lit st1 (c.name.value)
   in let st2 = emit-print-text-no-newline (name-result.state) (name-result.reg)
   in let st3 = emit-opening-print-sum-fields st2 (c.fields) formal-params actual-args sum-local 0 (list-length (c.fields))
   in let jmp-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = if i < len - 1 then patch-jcc-at st4 jne-pos (st4.code-len) else st4
   in emit-opening-print-sum-ctors st5 ctors formal-params actual-args sum-local (i + 1) len (list-push jmp-patches jmp-pos)

  emit-opening-patch-jmps : CodegenState, List Integer, Integer, Integer, Integer -> CodegenState
  emit-opening-patch-jmps (st) (patches) (i) (len) (target) =
   if i == len then st
   else emit-opening-patch-jmps (patch-jmp-at st (list-at patches i) target) patches (i + 1) len target

  emit-opening-print-sum-fields : CodegenState, List CodexType, List CodexType, List CodexType, Integer, Integer, Integer -> CodegenState
  emit-opening-print-sum-fields (st) (fields) (formal-params) (actual-args) (sum-local) (i) (len) =
   if i >= len then st
   else let st0 = emit-serial-wait-and-send st 32
   in let decl-ty = list-at fields i
   in let fty = resolve-field-type decl-ty formal-params actual-args
   in let sum-ld = load-local st0 (sum-local)
   in let st1 = st-append-code (sum-ld.state) (emit-narrow-load (field-byte-width decl-ty) (field-byte-signed decl-ty) reg-rax (sum-ld.reg) (sum-ctor-field-offset fields i))
   in let st2 = emit-opening-print-field st1 fty
   in emit-opening-print-sum-fields st2 fields formal-params actual-args sum-local (i + 1) len

  resolve-field-type : CodexType, List CodexType, List CodexType -> CodexType
  resolve-field-type (fty) (formal-params) (actual-args) =
   when fty
    is TypeVar (id) ->
     let mapped = find-type-arg id formal-params actual-args 0
     in when mapped
      is NothingTy -> if id < list-length actual-args then list-at actual-args id else fty
      is otherwise -> mapped
    is otherwise -> fty

  find-type-arg : Integer, List CodexType, List CodexType, Integer -> CodexType
  find-type-arg (id) (formals) (actuals) (i) =
   if i >= list-length formals then NothingTy
   else when list-at formals i
    is TypeVar (fid) -> if fid == id then if i < list-length actuals then list-at actuals i else NothingTy
       else find-type-arg id formals actuals (i + 1)
    is otherwise -> find-type-arg id formals actuals (i + 1)

  emit-opening-print-field : CodegenState, CodexType -> CodegenState
  emit-opening-print-field (st) (fty) =
   when fty
    is IntegerTy (lo) (hi) (mode) -> emit-inline-itoa-and-print st
    is TextTy -> emit-print-text-no-newline st reg-rax
    is BooleanTy -> emit-print-bool-no-newline st reg-rax
    is RealTy ->
     let st1 = st-append-code st (mov-rr reg-rdi reg-rax)
     in let st2 = emit-call-to st1 "__real_to_text"
     in emit-print-text-no-newline st2 reg-rax
    is UnitTy (n) (inner) -> emit-opening-print-field st inner
    is otherwise -> emit-inline-itoa-and-print st

  emit-print-bool-no-newline : CodegenState, Integer -> CodegenState
  emit-print-bool-no-newline (st) (val-reg) =
   let saved-val = alloc-local st
   in let st0 = store-local (saved-val.state) (saved-val.reg) val-reg
   in let val-l = load-local st0 (saved-val.reg)
   in let st1 = st-append-code (val-l.state) (test-rr (val-l.reg) (val-l.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let true-lit = emit-text-lit st2 "True"
   in let st3 = emit-print-text-no-newline (true-lit.state) (true-lit.reg)
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let false-lit = emit-text-lit st5 "False"
   in let st6 = emit-print-text-no-newline (false-lit.state) (false-lit.reg)
   in patch-jmp-at st6 jmp-end-pos (st6.code-len)

 The scope store is the twin of emit-grant-cap-mask: proc 0's authority
 to touch the disk is its capability bits, and the extent of that
 authority is its scope. Both are known at emit time and both are
 written into the process table before opening runs.

 emit-text-lit puts the string in the data buffer and leaves its
 address in a register through the ordinary rodata fixup, so the cell
 holds an honest Text — the same representation every other Text in the
 program has, and the one process-get-scope hands back.

 The value is copied to RAX before RDI is loaded because emit-text-lit
 allocates its result through the rotating temp pool and may hand back
 RDI itself; loading the address first would clobber the string pointer
 with the address it was about to be stored at.

  emit-set-boot-scope : CodegenState, Integer, Integer, Text -> CodegenState
  emit-set-boot-scope (st) (proc-index) (offset) (scope) =
   let lit = emit-text-lit st scope
   in let scope-addr = proc-table-base + proc-index * proc-entry-size + offset
   in let st1 = st-append-code (lit.state) (mov-rr reg-rax (lit.reg))
   in let st2 = st-append-code st1 (li reg-rdi scope-addr)
   in st-append-code st2 (mov-store reg-rdi reg-rax 0)

 The default FileSystem handler install (BACKLOG 1.14). For an op that
 resolved to a handler-table slot -- which is exactly when the program
 cites FileSystem -- allocate an 8-byte closure at the heap frontier whose
 only word is the servicer stub's address, and store the closure pointer
 into the slot. A performed read-text/write-file then reaches the stub the
 way emit-effect-op-call reaches any handler: slot -> closure -> code. A
 user `with FileSystem` still pushes over the slot and pops back to this
 default. R10 is a valid heap pointer here (set in __start, not yet handed
 to the arena) so the closure lives below arena-base and survives the REPL
 loop's R10 reset. find-effect-op-addr returns the slot ADDRESS, not an
 index, so it loads straight into r11.

  emit-seed-fs-handler : CodegenState, Text, Text -> CodegenState
  emit-seed-fs-handler (st) (op-name) (stub-name) =
   let eoa = find-effect-op-addr (st.effect-op-addrs) op-name 0 (list-length (st.effect-op-addrs))
   in if eoa < 0 then st
   else let st1 = emit-load-func-addr st reg-rcx stub-name
   in let st2 = st-append-code st1 (mov-rr reg-rax reg-r10)
   in let st3 = st-append-code st2 (add-ri reg-r10 16)
   in let st4 = st-append-code st3 (mov-store reg-rax reg-rcx 0)
   in let st5 = st-append-code st4 (li reg-r11 eoa)
   in st-append-code st5 (mov-store reg-r11 reg-rax 0)

  emit-start : CodegenState, Integer, Integer, List Text, Text, Text -> CodegenState
  emit-start (st) (first-stub-vaddr) (syscall-handler-offset) (manifest-effs) (fs-scope) (net-scope) =
   let st0 = record-func-offset st "__start"
   in let st1 = st-append-code st0 (push-r reg-rbp & mov-rr reg-rbp reg-rsp & push-r reg-rbx & push-r reg-r12 & push-r reg-r13 & push-r reg-r14 & emit-sub-rsp-imm32 0)
   in let st2 = st-append-code st1 cli
   in let st2a = st-append-code st2 (li reg-rdi ram-size-addr)
   in let st3 = st-append-code st2a (mov-load reg-rsp reg-rdi 0)
   in let st4 = st-append-code st3 (mov-rr reg-rbp reg-rsp)
   in let st5 = st-append-code st4 (li reg-r10 bare-metal-heap-base)
   in let st5a = st-append-code st5 (li reg-rdi deck-pos-addr)
   in let st5b = st-append-code st5a (mov-store reg-rdi reg-r10 0)
   in let st5c = st-append-code st5b (li reg-rdi deck-bound-counter-addr)
   in let st5d = st-append-code st5c (li reg-rax 0)
   in let st5e = st-append-code st5d (mov-store reg-rdi reg-rax 0)
   in let st7 = st-append-code st5e (li reg-r11 stack-min-rsp-addr)
   in let st7a = st-append-code st7 (li reg-rdi ram-size-addr)
   in let st8 = st-append-code st7a (mov-load reg-rax reg-rdi 0)
   in let st11 = st-append-code st8 (mov-store reg-r11 reg-rax 0)
   in let stU0 = st-append-code st11 ([72, 139, 4, 37] & write-i32 32768)
   in let stU1 = st-append-code stU0 (li reg-rdi uefi-systab-addr)
   in let stU2 = st-append-code stU1 (mov-store reg-rdi reg-rax 0)
   in let st12 = emit-process-setup stU2
   in let cap-names = manifest-cap-names manifest-effs 0 (list-length manifest-effs) []
   in let grant-mask = boot-cap-mask cap-names manifest-effs 0 (list-length cap-names) 0
   in let st14 = if grant-mask == 0 then st12 else emit-grant-cap-mask st12 0 grant-mask
   in let st14s = emit-set-boot-scope st14 0 proc-scope-offset fs-scope
   in let st14n = emit-set-boot-scope st14s 0 proc-net-scope-offset net-scope
   in let st15 = emit-grant-capability st14n 1 cap-console
   in let syscall-vaddr = bare-metal-load-addr + syscall-handler-offset
   in let st16 = emit-write-msr st15 3221225601 (8 * 4294967296)
   in let st17 = emit-write-msr st16 3221225602 syscall-vaddr
   in let st18 = emit-write-msr st17 3221225604 512
   in let st19 = st-append-code st18 (li reg-rcx 3221225600)
   in let st20 = st-append-code st19 [15, 50]
   in let st21 = st-append-code st20 [72, 131, 200, 1]
   in let st22 = st-append-code st21 [15, 48]
   in let st23 = emit-idt-entries st22 first-stub-vaddr
   in let st23a = emit-load-idt st23
   in let st23b = emit-load-tss st23a
   in let st24 = emit-out-byte st23b 1019 128
   in let st25 = emit-out-byte st24 1016 1
   in let st26 = emit-out-byte st25 1017 0
   in let st27 = emit-out-byte st26 1019 3
   in let st28 = emit-out-byte st27 1018 199
   in let st29 = emit-out-byte st28 1020 11
   in let st29a = emit-com2-init st29
   in let st30 = emit-out-byte st29a 1017 1
   in let st31 = st-append-code st30 (li reg-rdi serial-write-pos-addr)
   in let st32 = st-append-code st31 (li reg-rax 0)
   in let st33 = st-append-code st32 (mov-store reg-rdi reg-rax 0)
   in let st34 = st-append-code st33 (li reg-rdi serial-read-pos-addr)
   in let st35 = st-append-code st34 (mov-store reg-rdi reg-rax 0)
   in let st35p = emit-blit-probe st35
   in let st35a = emit-control-string st35p [66, 79, 79, 84, 58, 83, 48, 45, 72, 87, 10]
   in let st36 = emit-interrupt-setup st35a
   in let st36-d = emit-vga-progress st36 9 54
   in let st36a = emit-wait-for-tick st36-d
   in let st36a-d = emit-vga-progress st36a 10 55
   in let st36a1 = emit-control-string st36a-d [66, 79, 79, 84, 58, 83, 49, 45, 73, 82, 81, 10]
   in let st36b = emit-ata-init st36a1
   in let st36b-d = emit-vga-progress st36b 11 56
   in let st36b1 = emit-control-string st36b-d [66, 79, 79, 84, 58, 83, 50, 45, 65, 84, 65, 10]
   in let st36c = emit-boot-probe-factstore st36b1
   in let st36c1 = emit-control-string st36c [66, 79, 79, 84, 58, 83, 51, 45, 70, 83, 10]
   in let st36c2 = emit-smp-init st36c1
   in let st36d = emit-nic-init st36c2
   in let st37 = emit-control-string st36d [82, 69, 65, 68, 89, 10]
   in let st37s1 = emit-seed-fs-handler st37 "read-text" "__fs-read-servicer"
   in let st37s2 = emit-seed-fs-handler st37s1 "write-file" "__fs-write-servicer"
   in let st38 = st-append-code st37s2 (li reg-rdi arena-base-addr)
   in let st41 = st-append-code st38 (mov-store reg-rdi reg-r10 0)
   in let repl-loop = st41.code-len
   in let st42 = st-append-code st41 (li reg-rdi heap-hwm-addr)
   in let st42a = st-append-code st42 (mov-load reg-rbx reg-rdi 0)
   in let st42b = st-append-code st42a (li reg-rdi arena-base-addr)
   in let st45 = st-append-code st42b (mov-load reg-r10 reg-rdi 0)
   in let st45c = st-append-code st45 (cmp-rr reg-rbx reg-r10)
   in let poison-skip-pos = st45c.code-len
   in let st45c2 = st-append-code st45c (jcc cc-be 0)
   in let st45c3 = st-append-code st45c2 (push-r reg-rcx & push-r reg-rax)
   in let st45d = st-append-code st45c3 (mov-rr reg-rdi reg-r10)
   in let st45e = st-append-code st45d (mov-rr reg-rcx reg-rbx)
   in let st45f = st-append-code st45e (sub-rr reg-rcx reg-r10)
   in let st45g = st-append-code st45f (li reg-rax 205)
   in let st45h = st-append-code st45g (cld & rep-stosb)
   in let st45i = st-append-code st45h (pop-r reg-rax & pop-r reg-rcx)
   in let st45j = patch-jcc-at st45i poison-skip-pos (st45i.code-len)
   in let st45a = st-append-code st45i (li reg-rdi deck-pos-addr)
   in let st45b = st-append-code st45a (mov-store reg-rdi reg-r10 0)
   in let st46 = st-append-code st45b (li reg-rdi heap-hwm-addr)
   in let st47 = st-append-code st46 (mov-store reg-rdi reg-r10 0)
   in let st47a = st-append-code st47 (li reg-rax 0)
   in let st47b = st-append-code st47a (li reg-rdi stdin-eof-flag-addr)
   in let st47c = st-append-code st47b (mov-store reg-rdi reg-rax 0)
   in let st47d = st-append-code st47c (li reg-rdi stdin-eof-settled-addr)
   in let st47e = st-append-code st47d (mov-store reg-rdi reg-rax 0)
   in let st47f = st-append-code st47e (li reg-rdi try-fail-flag-addr)
   in let st47g = st-append-code st47f (mov-store reg-rdi reg-rax 0)
   in let st47h = st-append-code st47g (li reg-rdi deck-bound-counter-addr)
   in let st47i = st-append-code st47h (mov-store reg-rdi reg-rax 0)
   in let st47t = if st.trace-alloc
    then let sta = st-append-code st47i (li reg-rax 1)
     in let stb = st-append-code sta (li reg-rdi trace-enabled-addr)
     in let stc = st-append-code stb (mov-store reg-rdi reg-rax 0)
     in let std = st-append-code stc (li reg-rax 0)
     in let ste = st-append-code std (li reg-rdi trace-cursor-addr)
     in st-append-code ste (mov-store reg-rdi reg-rax 0)
    else st47i
   in let st48 = emit-call-to st47t opening-entry-point
   in let st48b = emit-opening-result-print st48
   in let st49 = emit-update-heap-hwm st48b
   in let st50 = emit-control-string st49 [72, 69, 65, 80, 58]
   in let st51 = st-append-code st50 (li reg-rdi heap-hwm-addr)
   in let st52 = st-append-code st51 (mov-load reg-rax reg-rdi 0)
   in let st53 = emit-control-inline-itoa-and-print st52
   in let st54 = emit-control-wait-and-send st53 10
   in let st55 = emit-control-string st54 [83, 84, 65, 67, 75, 58]
   in let st55a = st-append-code st55 (li reg-rdi ram-size-addr)
   in let st56 = st-append-code st55a (mov-load reg-rsi reg-rdi 0)
   in let st57 = st-append-code st56 (li reg-rdi stack-min-rsp-addr)
   in let st58 = st-append-code st57 (mov-load reg-rdi reg-rdi 0)
   in let st59 = st-append-code st58 (sub-rr reg-rsi reg-rdi)
   in let st60 = st-append-code st59 (mov-rr reg-rax reg-rsi)
   in let st61 = emit-control-inline-itoa-and-print st60
   in let st62 = emit-control-wait-and-send st61 10
   in let st63 = st-append-code st62 (li reg-r11 stack-min-rsp-addr)
   in let st63a = st-append-code st63 (li reg-rdi ram-size-addr)
   in let st64 = st-append-code st63a (mov-load reg-rax reg-rdi 0)
   in let st65 = st-append-code st64 (mov-store reg-r11 reg-rax 0)
   in let st65t = if st.trace-alloc then emit-trace-serial-dump st65 else st65
   in when st.exit-mode
    is Exit ->
     let st66 = st-append-code st65t (li reg-rax 0)
     in let st67 = st-append-code st66 (li reg-rdx 244)
     in let st68 = st-append-code st67 out-dx-al
     in let halt-pos = st68.code-len
     in let st69 = st-append-code st68 hlt
     in st-append-code st69 (jmp (halt-pos - (st69.code-len + 5)))
    is otherwise -> st-append-code st65t (jmp (repl-loop - (st65t.code-len + 5)))

Section: Chapter Entry Point
  flatten-chunks : LinkedList (List Integer) -> List Integer
  flatten-chunks (chunks) =
   let chunk-list = __linked-list-to-list chunks
   in flatten-chunks-loop chunk-list 0 (list-length chunk-list) []

  flatten-chunks-loop : List (List Integer), Integer, Integer, List Integer -> List Integer
  flatten-chunks-loop (chunks) (i) (len) (acc) =
   if i == len then acc
   else flatten-one-chunk (list-at chunks i) 0 (list-length (list-at chunks i)) acc chunks (i + 1) len

  flatten-one-chunk : List Integer, Integer, Integer, List Integer, List (List Integer), Integer, Integer -> List Integer
  flatten-one-chunk (chunk) (j) (clen) (acc) (chunks) (next-i) (len) =
   if j == clen then flatten-chunks-loop chunks next-i len acc
   else flatten-one-chunk chunk (j + 1) clen (list-push acc (list-at chunk j)) chunks next-i len

  apply-one-patch-buf : Integer, PatchEntry -> Integer
  apply-one-patch-buf (base-addr) (p) =
   buf-write-i32 base-addr (p.pos) (p.value)

  apply-all-patches-buf : Integer, List PatchEntry, Integer -> Integer
  apply-all-patches-buf (base-addr) (patches) (i) =
   if i >= list-length patches then 0
   else let r = apply-one-patch-buf base-addr (list-at patches i)
   in apply-all-patches-buf base-addr patches (i + 1)

  buf-write-i32 : Integer, Integer, Integer -> Integer
  buf-write-i32 (buf) (off) (v) =
   let w0 = __buf-write-byte buf off (int-mod v 256)
   in let w1 = __buf-write-byte buf (off + 1) (int-mod (floor-div v 256) 256)
   in let w2 = __buf-write-byte buf (off + 2) (int-mod (floor-div v 65536) 256)
   in let w3 = __buf-write-byte buf (off + 3) (int-mod (floor-div v 16777216) 256)
   in off + 4

  buf-write-i64 : Integer, Integer, Integer -> Integer
  buf-write-i64 (buf) (off) (v) =
   let w0 = __buf-write-byte buf off (int-mod v 256)
   in let w1 = __buf-write-byte buf (off + 1) (int-mod (floor-div v 256) 256)
   in let w2 = __buf-write-byte buf (off + 2) (int-mod (floor-div v 65536) 256)
   in let w3 = __buf-write-byte buf (off + 3) (int-mod (floor-div v 16777216) 256)
   in let w4 = __buf-write-byte buf (off + 4) (int-mod (floor-div v 4294967296) 256)
   in let w5 = __buf-write-byte buf (off + 5) (int-mod (floor-div v 1099511627776) 256)
   in let w6 = __buf-write-byte buf (off + 6) (int-mod (floor-div v 281474976710656) 256)
   in let w7 = __buf-write-byte buf (off + 7) (int-mod (floor-div v 72057594037927936) 256)
   in off + 8

  apply-call-patches-direct : Integer, List Integer, List Text, OffsetTable, Integer -> Integer
  apply-call-patches-direct (code-buffer) (offsets) (targets) (offset-map) (i) =
   if i >= list-length offsets then 0
   else let po = list-at offsets i
   in let target = list-at targets i
   in let target-offset = offset-table-lookup offset-map target
   in let resolved = if target-offset == -1 then offset-table-lookup offset-map "__unresolved_trap" else target-offset
   in if resolved == -1 then apply-call-patches-direct code-buffer offsets targets offset-map (i + 1)
      else let rel32 = resolved - (po + 5)
      in let w = buf-write-i32 code-buffer (po + 1) rel32
      in apply-call-patches-direct code-buffer offsets targets offset-map (i + 1)

  apply-func-addr-patches-direct : Integer, List Integer, List Text, OffsetTable, Integer, Integer -> Integer
  apply-func-addr-patches-direct (code-buffer) (patch-offsets) (targets) (offset-map) (text-base) (i) =
   if i >= list-length patch-offsets then 0
   else let po = list-at patch-offsets i
   in let target = list-at targets i
   in let func-offset = offset-table-lookup offset-map target
   in let resolved = if func-offset == -1 then offset-table-lookup offset-map "__unresolved_trap" else func-offset
   in if resolved == -1 then apply-func-addr-patches-direct code-buffer patch-offsets targets offset-map text-base (i + 1)
      else let addr = text-base + resolved
      in let w = buf-write-i64 code-buffer po addr
      in apply-func-addr-patches-direct code-buffer patch-offsets targets offset-map text-base (i + 1)

  apply-rodata-patches-direct : Integer, List Integer, List Integer, Integer, Integer -> Integer
  apply-rodata-patches-direct (code-buffer) (patch-offsets) (rodata-offsets) (data-vaddr) (i) =
   if i >= list-length patch-offsets then 0
   else let po = list-at patch-offsets i
   in let ro = list-at rodata-offsets i
   in let addr = data-vaddr + ro
   in let w = buf-write-i64 code-buffer po addr
   in apply-rodata-patches-direct code-buffer patch-offsets rodata-offsets data-vaddr (i + 1)

  apply-overflow-patches-direct : Integer, List Integer, Integer, Integer -> Integer
  apply-overflow-patches-direct (code-buffer) (checks) (oom-offset) (i) =
   if i >= list-length checks then 0
   else let pos = list-at checks i
   in let rel32 = oom-offset - (pos + 6)
   in let w = buf-write-i32 code-buffer (pos + 2) rel32
   in apply-overflow-patches-direct code-buffer checks oom-offset (i + 1)

  patch-stype-sites : Integer, List Integer, Integer, Integer -> Integer
  patch-stype-sites (code-buffer) (sites) (addr) (i) =
   if i >= list-length sites then 0
   else let w = buf-write-i64 code-buffer (list-at sites i) addr
   in patch-stype-sites code-buffer sites addr (i + 1)

  apply-direct-addr-patches-direct : Integer, List Integer, List Integer, Integer, Integer -> Integer
  apply-direct-addr-patches-direct (code-buffer) (patch-offsets) (target-offsets) (text-base) (i) =
   if i >= list-length patch-offsets then 0
   else let po = list-at patch-offsets i
   in let tgt = list-at target-offsets i
   in let addr = text-base + tgt
   in let w = buf-write-i64 code-buffer po addr
   in apply-direct-addr-patches-direct code-buffer patch-offsets target-offsets text-base (i + 1)

Section: Finalize

  x86-64-init-codegen-sorted : List TypeBinding -> CodegenState
  x86-64-init-codegen-sorted (tdefs) =
   let tramp = bare-metal-trampoline
   in let ws = init-emit-workspace code-buffer-size data-buffer-size
   in let bw1 = __buf-write-bytes (ws.code-buffer) 0 (tramp.bytes)
   in let bw2 = __buf-write-bytes (ws.data-buffer) 0 init-rodata
   in CodegenState {
   workspace = ws,
   code-len = list-length (tramp.bytes),
   data-len = list-length init-rodata,
   fo-names = __list-with-capacity accum-capacity,
   fo-offsets = __list-with-capacity accum-capacity,
   cp-offsets = __list-with-capacity (accum-capacity * 4),
   cp-targets = __list-with-capacity (accum-capacity * 4),
   fa-offsets = __list-with-capacity accum-capacity,
   fa-targets = __list-with-capacity accum-capacity,
   rf-poffsets = __list-with-capacity (accum-capacity * 2),
   rf-roffsets = __list-with-capacity (accum-capacity * 2),
   da-poffsets = __list-with-capacity accum-capacity,
   da-offsets = __list-with-capacity accum-capacity,
   stack-overflow-checks = __list-with-capacity accum-capacity,
   locals = [],
   next-temp = 0,
   next-local = 0,
   spill-count = 0,
   load-local-toggle = 0,
   tco = TcoState {
    active = False,
    in-tail-pos = False,
    loop-top = 0,
    param-locals = [],
    temp-locals = [],
    current-func = "",
    saved-next-local = 0,
    saved-next-temp = 0
   },
   type-defs = tdefs,
   builtin-names = sorted-builtin-names,
   emit-work = 0,
   exit-mode = ExitRepl,
   watchdog-mode = WatchdogProgress,
   opening-ret-type = NothingTy,
   state-local = 0 - 1,
   user-arities = [],
   bag = empty-bag,
   deck-bound = False,
   effect-op-addrs = [],
   eo-reads = [],
   eo-handled = [],
   vm-profile = vm-profile-spec,
   poison-alloc = False,
   trace-alloc = False,
   stack-guard = True,
   omit-frame-pointer = False,
   peak-local = 0,
   peak-spill = 0,
   func-local-regs = [],
   noalias-slots = [],
   field-cache = [],
   fresh-slots = [],
   stype-sites = __list-with-capacity accum-capacity
  }

  collect-direct-addr-patches : List Integer, List Integer, Integer, Integer, List PatchEntry -> List PatchEntry
  collect-direct-addr-patches (patch-offsets) (target-offsets) (text-base) (i) (acc) =
   if i >= list-length patch-offsets then acc
   else let po = list-at patch-offsets i
   in let tgt = list-at target-offsets i
   in let addr = text-base + tgt
   in let p0 = make-i32-patch po (bit-and addr 4294967295)
   in let p1 = make-i32-patch (po + 4) (floor-div addr 4294967296)
   in collect-direct-addr-patches patch-offsets target-offsets text-base (i + 1) (list-push (list-push acc p0) p1)

  build-offset-table-parallel : List Text, List Integer -> OffsetTable
  build-offset-table-parallel (names) (offsets) =
   build-offset-table-parallel-loop names offsets 0 (list-length names) offset-table-empty

  build-offset-table-parallel-loop : List Text, List Integer, Integer, Integer, OffsetTable -> OffsetTable
  build-offset-table-parallel-loop (names) (offsets) (i) (len) (acc) =
   if i >= len then acc
   else build-offset-table-parallel-loop names offsets (i + 1) len (offset-table-set acc (list-at names i) (list-at offsets i))

  buf-copy-chunk-size : Integer = 65536

  buf-copy-chunked : Integer, Integer, Integer, Integer, Integer -> Integer
  buf-copy-chunked (dst) (dst-off) (src) (src-off) (remaining) =
   if remaining == 0 then 0
   else let chunk = if remaining > buf-copy-chunk-size then buf-copy-chunk-size else remaining
   in let hp = __heap-save
   in let data = __buf-read-bytes src src-off chunk
   in let w = __buf-write-bytes dst dst-off data
   in let restored = __heap-restore hp
   in buf-copy-chunked dst (dst-off + chunk) src (src-off + chunk) (remaining - chunk)

Section: Capability Manifest

 The manifest is derived from opening's resolved type: the effects
 section lists every effect name on the performing spine, and the
 capabilities section grants each effect's covering capability
 (a dotted effect like Device.Port is covered by its base Device)
 as a full-scope, unbounded-duration entry. The manifest sits after
 rodata INSIDE the hashed and signed content, so the loader's fixed
 224-byte text offset is untouched and the signature covers what
 the binary asks for. The verifier decodes both sections through
 the header offsets, so file position is free to differ from the
 verify-quire encoder's header-first layout.

  manifest-opening-effects : List TypeBinding -> List Text
  manifest-opening-effects (types) = manifest-find-opening types 0 (list-length types)

  manifest-find-opening : List TypeBinding, Integer, Integer -> List Text
  manifest-find-opening (types) (i) (len) =
   if i >= len then []
   else let t = list-at types i
   in if t.name == "opening" then manifest-type-effects (t.bound-type) []
      else manifest-find-opening types (i + 1) len

  manifest-type-effects : CodexType, List Text -> List Text
  manifest-type-effects (ty) (acc) =
   when ty
    is FunTy (p) (row) (r) -> manifest-type-effects r (manifest-label-names (row.labels) 0 (list-length (row.labels)) acc)
    is ForAllTy (id) (b) -> manifest-type-effects b acc
    is ForAllEff (id) (b) -> manifest-type-effects b acc
    is EffectfulTy (effs) (sc) (inner) -> manifest-type-effects inner (manifest-name-values effs 0 (list-length effs) acc)
    is otherwise -> acc

  manifest-label-names : List EffectLabel, Integer, Integer, List Text -> List Text
  manifest-label-names (ls) (i) (len) (acc) =
   if i >= len then acc
   else manifest-label-names ls (i + 1) len (manifest-add-name acc (((list-at ls i).name).value))

  manifest-name-values : List Name, Integer, Integer, List Text -> List Text
  manifest-name-values (ns) (i) (len) (acc) =
   if i >= len then acc
   else manifest-name-values ns (i + 1) len (manifest-add-name acc ((list-at ns i).value))

 The opening's scope for a given effect family, which the boot grant
 hands to proc 0 the same way emit-grant-cap-mask hands it its bits.
 The manifest pipeline is a List Text of NAMES and drops the scope on
 the floor (BACKLOG 1.5, the loader ring) — but the boot ring does not
 need the manifest at all: the scope literal is right here in the row
 at emit time, so it is read straight off the label.

 Two families now have a runtime chokepoint and are carried: the
 filesystem (a path PREFIX, checked at the three Fat16 gates) and the
 network (an AUTHORITY, checked at the fetch chokepoint against a
 runtime URL's host). A console channel is the third relation
 scope-admits knows about and is NOT carried — a channel is fixed at
 compile time by the builtin name and never becomes a runtime value,
 so there is nothing at runtime to check a stored channel against, and
 carrying it would be a promise the machine cannot keep (BACKLOG 1.5).

 The EMPTY STRING is a real answer, not a missing one: an opening that
 names no scope for the family gets "", the cell holds a valid Text,
 and the family's relation admits everything by itself (the empty
 prefix admits every path; an empty authority admits every host). That
 is what keeps a program which never declared the effect from handing
 the chokepoint a null pointer.

  manifest-opening-fs-scope : List TypeBinding -> Text
  manifest-opening-fs-scope (types) = manifest-find-opening-scope types "FileSystem" 0 (list-length types)

  manifest-opening-net-scope : List TypeBinding -> Text
  manifest-opening-net-scope (types) = manifest-find-opening-scope types "Network" 0 (list-length types)

  manifest-find-opening-scope : List TypeBinding, Text, Integer, Integer -> Text
  manifest-find-opening-scope (types) (family) (i) (len) =
   if i >= len then ""
   else let t = list-at types i
   in if t.name == "opening" then manifest-type-scope (t.bound-type) family ""
      else manifest-find-opening-scope types family (i + 1) len

 Both shapes carry the row, and an opening is usually the second one:
 `opening : [Console, FileSystem.Read "/config/"] Nothing` is a VALUE
 with an effect row, not a function, so its type is an EffectfulTy and
 not a FunTy. EffectfulTy's second field is the scope list, parallel to
 its name list — reading the names and ignoring that list is exactly
 how the scope got dropped everywhere else in this pipeline.

  manifest-type-scope : CodexType, Text, Text -> Text
  manifest-type-scope (ty) (family) (acc) =
   when ty
    is FunTy (p) (row) (r) -> manifest-type-scope r family (manifest-label-scope (row.labels) family 0 (list-length (row.labels)) acc)
    is ForAllTy (id) (b) -> manifest-type-scope b family acc
    is ForAllEff (id) (b) -> manifest-type-scope b family acc
    is EffectfulTy (effs) (scs) (inner) -> manifest-type-scope inner family (manifest-name-scope effs scs family 0 (list-length effs) acc)
    is otherwise -> acc

  manifest-name-scope : List Name, List Text, Text, Integer, Integer, Text -> Text
  manifest-name-scope (ns) (scs) (family) (i) (len) (acc) =
   if i >= len then acc
   else if text-length acc > 0 then acc
   else if i >= list-length scs then acc
   else let n = ((list-at ns i).value)
   in let s = list-at scs i
   in if manifest-effect-base n == family & text-length s > 0
      then manifest-name-scope ns scs family (i + 1) len s
      else manifest-name-scope ns scs family (i + 1) len acc

  manifest-label-scope : List EffectLabel, Text, Integer, Integer, Text -> Text
  manifest-label-scope (ls) (family) (i) (len) (acc) =
   if i >= len then acc
   else if text-length acc > 0 then acc
   else let l = list-at ls i
   in let base = manifest-effect-base ((l.name).value)
   in if base == family & text-length (l.scope) > 0
      then manifest-label-scope ls family (i + 1) len (l.scope)
      else manifest-label-scope ls family (i + 1) len acc

  manifest-add-name : List Text, Text -> List Text
  manifest-add-name (acc) (n) =
   if manifest-name-in acc n 0 (list-length acc) then acc else list-push acc n

  manifest-name-in : List Text, Text, Integer, Integer -> Boolean
  manifest-name-in (xs) (n) (i) (len) =
   if i >= len then False
   else if list-at xs i == n then True
   else manifest-name-in xs n (i + 1) len

 manifest-base-loop derives the dot's code from a literal because
 internal text is CCE: a bare 46 is ASCII thinking, and in CCE code
 46 is the letter H — the comparison never matched, so a dotted
 effect (Device.Block) never resolved to its covering capability and
 the boot grant silently dropped it.

  manifest-effect-base : Text -> Text
  manifest-effect-base (n) = manifest-base-loop n 0 (text-length n)

  manifest-base-loop : Text, Integer, Integer -> Text
  manifest-base-loop (n) (i) (len) =
   if i >= len then n
   else if char-code (char-at n i) == char-code (char-at "." 0) then substring n 0 i
   else manifest-base-loop n (i + 1) len

 Direction, derived from the row instead of asserted.

 manifest-cap-bytes used to write a literal `cdx-le16 2` -- readwrite --
 for every capability it emitted, so a program declaring
 [FileSystem.Read] put a READWRITE filesystem capability into its own
 manifest. The loader's dir-bits was never wrong: it honours read-only
 grants exactly as the format intends, and it was simply being TOLD
 readwrite by a compiler that never asked the effect row. Direction was
 broken at the source, and every consumer downstream inherited it.

 The dotted member is the direction: FileSystem.Read is read, .Write is
 write, and a bare FileSystem asks for both. A family with no read/write
 split (Device.Block, Gpu.Compute) has no direction to name, so it takes
 readwrite -- the honest answer, because withholding a bit the family
 does not model would deny an authority the program correctly declared.

 A program naming BOTH .Read and .Write gets readwrite, which is the
 union it asked for and not an escalation.

  manifest-dir-read : Integer = 0
  manifest-dir-write : Integer = 1
  manifest-dir-readwrite : Integer = 2

  manifest-cap-direction : List Text, Text -> Integer
  manifest-cap-direction (effs) (cap) =
   let f = manifest-dir-flags effs cap 0 (list-length effs) 0
   in if bit-and f 4 /= 0 then manifest-dir-readwrite
      else if bit-and f 3 == 3 then manifest-dir-readwrite
      else if bit-and f 1 /= 0 then manifest-dir-read
      else if bit-and f 2 /= 0 then manifest-dir-write
      else manifest-dir-readwrite

  manifest-dir-flags : List Text, Text, Integer, Integer, Integer -> Integer
  manifest-dir-flags (effs) (cap) (i) (len) (acc) =
   if i >= len then acc
   else let e = list-at effs i
   in if manifest-effect-base e /= cap then manifest-dir-flags effs cap (i + 1) len acc
      else if e == cap then manifest-dir-flags effs cap (i + 1) len (bit-or acc 4)
      else if manifest-effect-member e == "Read" then manifest-dir-flags effs cap (i + 1) len (bit-or acc 1)
      else if manifest-effect-member e == "Write" then manifest-dir-flags effs cap (i + 1) len (bit-or acc 2)
      else manifest-dir-flags effs cap (i + 1) len (bit-or acc 4)

  manifest-effect-member : Text -> Text
  manifest-effect-member (n) =
   let base = manifest-effect-base n
   in if text-length base >= text-length n then ""
      else substring n (text-length base + 1) (text-length n - text-length base - 1)

  manifest-cap-id : Text -> Integer
  manifest-cap-id (n) =
   if n == "Console" then 0
   else if n == "FileSystem" then 1
   else if n == "Network" then 2
   else if n == "Concurrent" then 3
   else if n == "Device" then 4
   else if n == "Gpu.Compute" then 5
   else if n == "Gpu.Memory" then 6
   else if n == "Identity" then 7
   else if n == "Capability" then 8
   else if n == "Gpu" then 9
   else if n == "Camera" then 10
   else if n == "Microphone" then 11
   else if n == "Location" then 12
   else if n == "Sensors" then 13
   else if n == "Display" then 14
   else if n == "Flash" then 15
   else if n == "Audio" then 16
   else 0 - 1

 BACKLOG 1.13 -- the anti-drift guard. capability-vocabulary
 (TypeChecker) admits an effect at the type level; manifest-cap-id
 (here) gives it a slot in the CDX capability section. A name in the
 first with no id in the second admitted through the type checker and
 was then SILENTLY dropped by manifest-cap-names, so [Gpu] once
 compiled clean -- exit 0, no diagnostic at any severity -- and was
 denied at runtime the moment 1.6 armed the gpu-memory guard. This
 makes that drift a build error instead: every vocabulary name must
 resolve to a cap id, itself or its base for a dotted refinement
 (Console.Read answers to Console, exactly as manifest-cap-names
 covers it). It walks the vocabulary once per compile, so a drift
 halts the FIRST compile after it is introduced -- the self-compile
 and the BVT among them -- rather than shipping an effect the manifest
 cannot carry. The two hand-kept tables now agree by construction on
 every build, not by inspection.

  cap-vocab-drift-diags : List Text, Integer, Integer, List Diagnostic -> List Diagnostic
  cap-vocab-drift-diags (vocab) (i) (len) (acc) =
   if i >= len then acc
   else let n = list-at-text vocab i
   in let cover = if manifest-cap-id n >= 0 then n else manifest-effect-base n
   in if manifest-cap-id cover >= 0 then cap-vocab-drift-diags vocab (i + 1) len acc
      else cap-vocab-drift-diags vocab (i + 1) len (list-push acc (make-error cdx-capability-not-granted ("capability vocabulary name '" & n & "' has no manifest cap id -- capability-vocabulary (TypeChecker) and manifest-cap-id (X86_64Chapter) have drifted; every vocabulary name must map to a cap id (BACKLOG 1.13)") synthetic-span))

  check-cap-vocab-coherent : List Diagnostic
  check-cap-vocab-coherent = cap-vocab-drift-diags capability-vocabulary 0 (list-length capability-vocabulary) []

 The boot grant for proc 0 derives from the same manifest names the
 capability section records: each covered name contributes its kernel
 capability bits, and anything the manifest does not declare stays
 ungranted (Concurrent covers task spawn, channels, and process
 creation — the three faces of the concurrency authority in this
 kernel). Identity and Capability are effect-row sources like the
 rest: a program that declares Identity earns cap-identity at boot,
 which is what every identity builtin's kernel helper now tests.

 boot-cap-mask-for is the boot path's expansion of the same table
 cdx-cap-to-kern-bits expands for the verified-load path, and the two
 must not disagree -- a binary gets its authority from one of them and
 must not get a different answer depending on which door it came in
 through (BACKLOG 1.12). It used to ignore DIRECTION entirely, granting
 FileSystem read AND write to a program that declared only
 [FileSystem.Read], while the loader honoured the read-only grant. It
 takes the direction now, from the same derivation the manifest writes,
 so the two paths read one table the same way.

 boot-dir-bits is dir-bits (VerifiedLoader) written here rather than
 shared, because the compiler cannot cite the OS quire. That duplication
 is the bug this entry is about, and it is now duplicated CORRECTLY --
 which is not a fix, only a truce. The real fix is one function; see
 1.12's note about deriving one expansion from the other.

  boot-dir-bits : Integer, Integer, Integer -> Integer
  boot-dir-bits (dir) (read-bit) (write-bit) =
   if dir == manifest-dir-read then bit-shl 1 read-bit
   else if dir == manifest-dir-write then bit-shl 1 write-bit
   else bit-or (bit-shl 1 read-bit) (bit-shl 1 write-bit)

  boot-cap-mask-for : Text, Integer -> Integer
  boot-cap-mask-for (n) (dir) =
   if n == "Console" then bit-or (bit-shl 1 cap-console) (boot-dir-bits dir cap-console-read cap-console-write)
   else if n == "FileSystem" then boot-dir-bits dir cap-filesystem-read cap-filesystem-write
   else if n == "Network" then boot-dir-bits dir cap-network-read cap-network-write
   else if n == "Concurrent" then bit-or (bit-shl 1 cap-concurrent) (bit-or (bit-shl 1 cap-ipc) (bit-shl 1 cap-process-create))
   else if n == "Device" then bit-or (bit-shl 1 cap-block-device) (bit-shl 1 cap-device)
   else if n == "Gpu.Compute" then bit-shl 1 cap-gpu-compute
   else if n == "Gpu.Memory" then bit-shl 1 cap-gpu-memory
   else if n == "Gpu" then bit-or (bit-shl 1 cap-gpu-compute) (bit-shl 1 cap-gpu-memory)
   else if n == "Identity" then bit-shl 1 cap-identity
   else if n == "Capability" then bit-shl 1 cap-capability-admin
   else if n == "Camera" then bit-shl 1 cap-camera
   else if n == "Microphone" then bit-shl 1 cap-microphone
   else if n == "Location" then bit-shl 1 cap-location
   else if n == "Sensors" then bit-shl 1 cap-sensors
   else if n == "Display" then bit-shl 1 cap-display
   else if n == "Flash" then bit-shl 1 cap-flash
   else if n == "Audio" then bit-shl 1 cap-audio
   else 0

  boot-cap-mask : List Text, List Text, Integer, Integer, Integer -> Integer
  boot-cap-mask (caps) (effs) (i) (len) (acc) =
   if i >= len then acc
   else let name = list-at caps i
   in boot-cap-mask caps effs (i + 1) len (bit-or acc (boot-cap-mask-for name (manifest-cap-direction effs name)))

  manifest-cap-names : List Text, Integer, Integer, List Text -> List Text
  manifest-cap-names (effs) (i) (len) (acc) =
   if i >= len then acc
   else let e = list-at effs i
   in let cover = if manifest-cap-id e >= 0 then e else manifest-effect-base e
   in if manifest-cap-id cover >= 0 then manifest-cap-names effs (i + 1) len (manifest-add-name acc cover)
      else manifest-cap-names effs (i + 1) len acc

 The capability section carries the scope, and until now it lied about
 having none: the length field was a hardcoded `cdx-le32 0`, so every
 binary this compiler emitted told the verifier its grants were
 unscoped. The verifier has always been able to read a scope —
 `CdxVerifier` decodes the bytes and strides `16 + scope-len`, and
 `CdxBinary` writes them the same way — so the format was never the
 gap. One hardcoded zero was.

 Only the filesystem grant carries one, for the same reason
 manifest-opening-fs-scope carries only that scope: a path is the one
 resource string the machine can check. Writing a scope for a family
 with no runtime chokepoint would be a promise the loader cannot keep.

 The bytes are CCE (`char-code`), which is what `CdxBinary`'s
 `text-to-cap-bytes` writes and `CdxVerifier`'s `bytes-to-text` reads.
 Do not "fix" this into ASCII: both ends of this format agree on CCE,
 and only the two of them ever read it.

  manifest-cap-bytes : List Text, List Text, Text, Text, Integer, Integer, List Integer -> List Integer
  manifest-cap-bytes (caps) (effs) (fs-scope) (net-scope) (i) (len) (acc) =
   if i >= len then acc
   else let name = list-at caps i
   in let scope = if name == "FileSystem" then fs-scope else if name == "Network" then net-scope else ""
   in let scope-bytes = manifest-text-bytes scope 0 (text-length scope) []
   in let dir = manifest-cap-direction effs name
   in manifest-cap-bytes caps effs fs-scope net-scope (i + 1) len (acc & cdx-le16 (manifest-cap-id name) & cdx-le16 dir & cdx-le32 (list-length scope-bytes) & scope-bytes & cdx-le64 0)

  manifest-text-bytes : Text, Integer, Integer, List Integer -> List Integer
  manifest-text-bytes (s) (i) (len) (acc) =
   if i >= len then acc
   else manifest-text-bytes s (i + 1) len (list-push acc (char-code (char-at s i)))

  manifest-eff-bytes : List Text, Integer, Integer, List Integer -> List Integer
  manifest-eff-bytes (effs) (i) (len) (acc) =
   if i >= len then acc
   else let name = list-at effs i
   in manifest-eff-bytes effs (i + 1) len (acc & cdx-le16 (text-length name) & manifest-text-bytes name 0 (text-length name) [])

  manifest-effects-section : List Text -> List Integer
  manifest-effects-section (effs) =
   cdx-le16 (list-length effs) & manifest-eff-bytes effs 0 (list-length effs) []

  x86-64-apply-patches-and-build-cdx : CodegenState, Integer, Boolean, List Text, Text, Text -> EmitChapterResult
  x86-64-apply-patches-and-build-cdx (st) (far-jump-patch-pos) (has-oom) (manifest-effs) (fs-scope) (net-scope) =
   let func-map = build-offset-table-parallel (st.fo-names) (st.fo-offsets)
   in let st2a = check-call-patch-targets st func-map 0
   in let st2b = check-func-addr-targets st2a func-map 0
   in let st2e = check-effect-op-reads st2b 0
   in let st2c = check-runtime-symbol st2e func-map "__start"
   in let st2d = if has-oom then check-runtime-symbol st2c func-map "__out_of_memory" else st2c
   in let start-offset = offset-table-lookup func-map "__start"
   in let start-addr = bare-metal-load-addr + start-offset
   in let w-fj = buf-write-i32 (st2d.workspace.code-buffer) (far-jump-patch-pos + 1) start-addr
   in let w-call = apply-call-patches-direct (st2d.workspace.code-buffer) (st2d.cp-offsets) (st2d.cp-targets) func-map 0
   in let w-addr = apply-func-addr-patches-direct (st2d.workspace.code-buffer) (st2d.fa-offsets) (st2d.fa-targets) func-map bare-metal-load-addr 0
   in let data-vaddr = compute-data-vaddr-bare (st2d.code-len)
   in let has-stype = list-length (st2d.stype-sites) > 0
   in let tbl = if has-stype then emit-self-type-table (st2d.workspace.data-buffer) (st2d.data-len) data-vaddr (st2d.type-defs) else ConstEmit { len = st2d.data-len, off = 0 }
   in let w-stype = if has-stype then patch-stype-sites (st2d.workspace.code-buffer) (st2d.stype-sites) (data-vaddr + tbl.off) 0 else 0
   in let w-rodata = apply-rodata-patches-direct (st2d.workspace.code-buffer) (st2d.rf-poffsets) (st2d.rf-roffsets) data-vaddr 0
   in let w-overflow = if has-oom then let oom-offset = offset-table-lookup func-map "__out_of_memory" in apply-overflow-patches-direct (st2d.workspace.code-buffer) (st2d.stack-overflow-checks) oom-offset 0 else 0
   in let w-direct = apply-direct-addr-patches-direct (st2d.workspace.code-buffer) (st2d.da-poffsets) (st2d.da-offsets) bare-metal-load-addr 0
   in let code-len = st2d.code-len
   in let data-len = tbl.len
   in let text-aligned = align-up code-len 8
   in let content-len = text-aligned + data-len
   in let cap-names = manifest-cap-names manifest-effs 0 (list-length manifest-effs) []
   in let cap-bytes = manifest-cap-bytes cap-names manifest-effs fs-scope net-scope 0 (list-length cap-names) []
   in let eff-bytes = if list-length manifest-effs == 0 then [] else manifest-effects-section manifest-effs
   in let func-count = list-length (st2d.fo-names)
   in let debug-map = build-debug-map (st2d.fo-names) (st2d.fo-offsets) code-len func-count
   in let full-len = content-len + list-length cap-bytes + list-length eff-bytes
   in if full-len + list-length debug-map > st2d.workspace.code-capacity
      then let st-err = st-add-error st2d cdx-resource-exhausted ("CDX content (" & integer-to-text full-len & " bytes) exceeds code-buffer capacity; raise code-buffer-size") synthetic-span
       in EmitChapterResult {
        header-bytes = [],
        content-buf = 0,
        content-len = 0,
        tail-bytes = [],
        bag = st-err.bag,
        symbol-map = []
       }
   else let zpad = __buf-write-bytes (st2d.workspace.code-buffer) code-len (cdx-zeros (text-aligned - code-len))
   in let cpy = buf-copy-chunked (st2d.workspace.code-buffer) text-aligned (st2d.workspace.data-buffer) 0 data-len
   in let wcap = __buf-write-bytes (st2d.workspace.code-buffer) content-len cap-bytes
   in let weff = __buf-write-bytes (st2d.workspace.code-buffer) (content-len + list-length cap-bytes) eff-bytes
   in let wdbg = __buf-write-bytes (st2d.workspace.code-buffer) full-len debug-map
   in let content-hash = sha256-buf (st2d.workspace.code-buffer) 0 full-len
   in let cdx-header-size = 224
   in let text-offset = cdx-header-size
   in let rodata-offset = text-offset + text-aligned
   in let cap-off-v = cdx-header-size + content-len
   in let eff-off-v = cap-off-v + list-length cap-bytes
   in let debug-off = if func-count > 0 then cdx-header-size + full-len else 0
   in let header = cdx-build-header content-hash text-offset code-len rodata-offset data-len start-offset debug-off cap-off-v (list-length cap-bytes) eff-off-v (list-length eff-bytes)
   in let smap = build-symbol-map (st2d.fo-names) (st2d.fo-offsets) bare-metal-load-addr code-len 0 func-count []
   in EmitChapterResult {
    header-bytes = header,
    content-buf = st2d.workspace.code-buffer,
    content-len = full-len + list-length debug-map,
    tail-bytes = [],
    bag = st2d.bag,
    symbol-map = smap
   }

  x86-64-finalize-cdx : CodegenState, Integer, List Text, Text, Text -> EmitChapterResult
  x86-64-finalize-cdx (st1) (far-jump-patch-pos) (manifest-effs) (fs-scope) (net-scope) =
   let isr-result = emit-isr-stubs st1
   in let syscall-result = emit-syscall-handler (isr-result.state)
   in let st1b = emit-runtime-init-fn (syscall-result.state) (isr-result.first-stub-vaddr) (syscall-result.handler-offset)
   in let st2 = emit-start st1b (isr-result.first-stub-vaddr) (syscall-result.handler-offset) manifest-effs fs-scope net-scope
   in x86-64-apply-patches-and-build-cdx st2 far-jump-patch-pos True manifest-effs fs-scope net-scope

  cdx-build-header : List Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  cdx-build-header (hash) (text-off) (text-sz) (ro-off) (ro-sz) (entry-off) (debug-off) (cap-off-v) (cap-sz-v) (eff-off-v) (eff-sz-v) =
   let magic = [67, 68, 88, 49]
   in let version = cdx-le16 1
   in let flag-val = if debug-off > 0 then 19 else 3
   in let flags = cdx-le16 flag-val
   in let hash-bytes = cdx-hash-to-bytes hash 0 []
   in let author-hash = cdx-zeros 32
   in let reserved = cdx-zeros 64
   in let cap-off = cdx-le64 cap-off-v
   in let cap-sz = cdx-le64 cap-sz-v
   in let proof-off = cdx-le64 eff-off-v
   in let proof-sz = cdx-le64 eff-sz-v
   in let text = cdx-le64 text-off & cdx-le64 text-sz
   in let rodata = cdx-le64 ro-off & cdx-le64 ro-sz
   in let entry = cdx-le64 entry-off
   in let stack = cdx-le32 1048576
   in let heap = cdx-le32 (bare-metal-ram-size - bare-metal-heap-base)
   in let trust = cdx-le16 5000 & cdx-le16 0
   in let tail = cdx-le32 debug-off
   in magic & version & flags & hash-bytes & author-hash & reserved & cap-off & cap-sz & proof-off & proof-sz & text & rodata & entry & stack & heap & trust & tail

  cdx-hash-to-bytes : List Integer, Integer, List Integer -> List Integer
  cdx-hash-to-bytes (ws) (i) (acc) =
   if i == list-length ws then acc
   else let w = list-at ws i
   in cdx-hash-to-bytes ws (i + 1) (acc & [bit-and (bit-shru w 24) 255, bit-and (bit-shru w 16) 255, bit-and (bit-shru w 8) 255, bit-and w 255])

  cdx-le16 : Integer -> List Integer
  cdx-le16 (v) = [bit-and v 255, bit-and (bit-shru v 8) 255]

  cdx-le32 : Integer -> List Integer
  cdx-le32 (v) = [bit-and v 255, bit-and (bit-shru v 8) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 24) 255]

  cdx-le64 : Integer -> List Integer
  cdx-le64 (v) = cdx-le32 v & cdx-le32 (bit-shru v 32)

  cdx-zeros : Integer -> List Integer
  cdx-zeros (n) = cdx-zeros-loop n []

  cdx-zeros-loop : Integer, List Integer -> List Integer
  cdx-zeros-loop (n) (acc) =
   if n <= 0 then acc
   else cdx-zeros-loop (n - 1) (list-push acc 0)


Section: Symbol Map

  build-symbol-map : List Text, List Integer, Integer, Integer, Integer, Integer, List Text -> List Text
  build-symbol-map (names) (offsets) (load-addr) (code-len) (i) (len) (acc) =
   if i >= len then acc
   else let addr = load-addr + list-at offsets i
   in let size = if i + 1 < len then (list-at offsets (i + 1)) - (list-at offsets i) else code-len - (list-at offsets i)
   in let line = "0x" & map-hex-pad8 addr & " " & show size & " " & list-at names i
   in build-symbol-map names offsets load-addr code-len (i + 1) len (list-push acc line)

  map-hex-pad8 : Integer -> Text
  map-hex-pad8 (n) =
   let d7 = bit-and (bit-shru n 28) 15
   in let d6 = bit-and (bit-shru n 24) 15
   in let d5 = bit-and (bit-shru n 20) 15
   in let d4 = bit-and (bit-shru n 16) 15
   in let d3 = bit-and (bit-shru n 12) 15
   in let d2 = bit-and (bit-shru n 8) 15
   in let d1 = bit-and (bit-shru n 4) 15
   in let d0 = bit-and n 15
   in map-hex-digit d7 & map-hex-digit d6 & map-hex-digit d5 & map-hex-digit d4 & map-hex-digit d3 & map-hex-digit d2 & map-hex-digit d1 & map-hex-digit d0

  map-hex-digit : Integer -> Text
  map-hex-digit (n) =
   if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
   else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
   else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
   else if n == 9 then "9" else if n == 10 then "A" else if n == 11 then "B"
   else if n == 12 then "C" else if n == 13 then "D" else if n == 14 then "E"
   else "F"

Section: Binary Debug Map (MAP1)

  map1-magic : List Integer = [77, 65, 80, 49]

  MapStrings = record {
   bytes : List Integer,
   offsets : List Integer
  }

  build-debug-map : List Text, List Integer, Integer, Integer -> List Integer
  build-debug-map (names) (offsets) (code-len) (count) =
   if count == 0 then []
   else let strings = build-map-strings names 0 count []
   in let entries-size = count * 12
   in let strings-off = 12 + entries-size
   in let entries = build-map-entries offsets names (strings.offsets) code-len 0 count []
   in map1-magic & cdx-le32 count & cdx-le32 strings-off & entries & (strings.bytes)

  build-map-strings : List Text, Integer, Integer, List Integer -> MapStrings
  build-map-strings (names) (i) (count) (acc-offsets) =
   build-map-strings-inc names 0 count 0 []

  build-map-strings-inc : List Text, Integer, Integer, Integer, List Integer -> MapStrings
  build-map-strings-inc (names) (i) (count) (running-off) (acc-offsets) =
   if i >= count then MapStrings { bytes = build-map-string-bytes names 0 count [], offsets = acc-offsets }
   else let name-len = text-length (list-at names i) + 1
   in build-map-strings-inc names (i + 1) count (running-off + name-len) (list-push acc-offsets running-off)

  build-map-string-bytes : List Text, Integer, Integer, List Integer -> List Integer
  build-map-string-bytes (names) (i) (count) (acc) =
   if i >= count then acc
   else let name = list-at names i
   in let acc1 = map-text-to-cce-bytes name 0 (text-length name) acc
   in build-map-string-bytes names (i + 1) count (list-push acc1 0)

  map-text-to-cce-bytes : Text, Integer, Integer, List Integer -> List Integer
  map-text-to-cce-bytes (t) (i) (len) (acc) =
   if i >= len then acc
   else map-text-to-cce-bytes t (i + 1) len (list-push acc (char-code-at t i))

  build-map-entries : List Integer, List Text, List Integer, Integer, Integer, Integer, List Integer -> List Integer
  build-map-entries (offsets) (names) (str-offsets) (code-len) (i) (count) (acc) =
   if i >= count then acc
   else let off = list-at offsets i
   in let size = if i + 1 < count then (list-at offsets (i + 1)) - off else code-len - off
   in let str-off = list-at str-offsets i
   in build-map-entries offsets names str-offsets code-len (i + 1) count (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push acc (bit-and off 255)) (bit-and (bit-shr off 8) 255)) (bit-and (bit-shr off 16) 255)) (bit-and (bit-shr off 24) 255)) (bit-and size 255)) (bit-and (bit-shr size 8) 255)) (bit-and (bit-shr size 16) 255)) (bit-and (bit-shr size 24) 255)) (bit-and str-off 255)) (bit-and (bit-shr str-off 8) 255)) (bit-and (bit-shr str-off 16) 255)) (bit-and (bit-shr str-off 24) 255))


  x86-64-emit-cdx : IRChapter, List TypeBinding -> EmitChapterResult
  x86-64-emit-cdx (m) (tdefs) = x86-64-emit-cdx-with-exit-mode m tdefs Exit False False WatchdogProgress

  x86-64-emit-cdx-with-exit-mode : IRChapter, List TypeBinding, X86_64ExitMode, Boolean, Boolean, X86_64WatchdogMode -> EmitChapterResult
  x86-64-emit-cdx-with-exit-mode (m) (tdefs) (exit-mode) (poison) (trace) (wd-mode) =
   let emit-deck = emit-build (list-length (m.defs) * 65536 + 25165824)
   in let de = __deck-enter
   in let tramp = bare-metal-trampoline
   in let st0 = x86-64-init-codegen-sorted tdefs
   in let st-mode = __record-set st0 "exit-mode" exit-mode
   in let st-poison = __record-set st-mode "poison-alloc" poison
   in let st-trace = __record-set st-poison "trace-alloc" trace
   in let st-wd = __record-set st-trace "watchdog-mode" wd-mode
   in let st-eo2 = __record-set st-wd "effect-op-addrs" (assign-effect-op-addrs (m.effect-op-names) 0 (list-length (m.effect-op-names)) [])
   in let defs-lifted = m.defs
   in let ret-ty = opening-bare-print-type defs-lifted
   in let st-ret = __record-set st-eo2 "opening-ret-type" ret-ty
   in let arities = build-x86-arities defs-lifted 0 (list-length defs-lifted) []
   in let st-ar = __record-set st-ret "user-arities" arities
   in let st0a = emit-runtime-helpers st-ar
   in let dx = __deck-exit
   in let st1 = emit-all-defs st0a defs-lifted 0
   in x86-64-finalize-cdx st1 (tramp.far-jump-patch-pos) (manifest-opening-effects tdefs) (manifest-opening-fs-scope tdefs) (manifest-opening-net-scope tdefs)

  assign-effect-op-addrs : List Text, Integer between 0 and 65535, Integer, List EffectOpAddr -> List EffectOpAddr
  assign-effect-op-addrs (names) (i) (len) (acc) =
   if i >= len then acc
   else assign-effect-op-addrs names (i + 1) len (list-push acc (EffectOpAddr { name = list-at names i, addr = handler-table-base-addr + i * 8 }))

