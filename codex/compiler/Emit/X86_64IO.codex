Chapter: X86-64 Code Generator

Section: 32-bit Bare-Metal Trampoline
  multiboot-header : List Integer = write-i32 464367618 & write-i32 65536 & write-i32 3830534142 & write-i32 bare-metal-load-addr & write-i32 bare-metal-load-addr & write-i32 0 & write-i32 0 & write-i32 (bare-metal-load-addr + 32)

  tramp-clear-pages : List Integer = [250, 191, 0, 16, 0, 0, 185, 0, 12, 0, 0, 49, 192, 243, 171, 191, 0, 0, 1, 0, 185, 0, 12, 0, 0, 49, 192, 243, 171]

  tramp-page-tables : List Integer = [199, 5, 0, 16, 0, 0, 3, 32, 0, 0, 199, 5, 0, 32, 0, 0, 3, 48, 0, 0, 199, 5, 8, 32, 0, 0, 3, 0, 1, 0, 199, 5, 16, 32, 0, 0, 3, 16, 1, 0, 199, 5, 24, 32, 0, 0, 3, 32, 1, 0, 191, 0, 48, 0, 0, 185, 0, 2, 0, 0, 184, 131, 0, 0, 0, 137, 7, 199, 71, 4, 0, 0, 0, 0, 131, 199, 8, 5, 0, 0, 32, 0, 73, 117, 236, 191, 0, 0, 1, 0, 185, 0, 6, 0, 0, 184, 131, 0, 0, 64, 137, 7, 199, 71, 4, 0, 0, 0, 0, 131, 199, 8, 5, 0, 0, 32, 0, 73, 117, 236]

  tramp-enable-long-mode : List Integer = [184, 0, 16, 0, 0, 15, 34, 216, 15, 32, 224, 13, 32, 6, 0, 0, 15, 34, 224, 185, 128, 0, 0, 192, 15, 50, 13, 0, 9, 0, 0, 15, 48, 15, 32, 192, 37, 251, 255, 255, 255, 13, 2, 0, 0, 128, 15, 34, 192]

  trampoline-code : List Integer = tramp-clear-pages & tramp-page-tables & tramp-enable-long-mode

  tramp-gdt-data : List Integer = [235, 30, 0, 0, 0, 0, 0, 0, 0, 0, 255, 255, 0, 0, 0, 154, 175, 0, 255, 255, 0, 0, 0, 146, 207, 0]

  trampoline-gdt-section : List Integer = tramp-gdt-data & write-i16 23 & write-i32 (bare-metal-load-addr + 232) & [15, 1, 21] & write-i32 (bare-metal-load-addr + 256) & [234, 0, 0, 0, 0, 8, 0]

  bare-metal-trampoline : TrampolineResult
  bare-metal-trampoline =
   let bytes = multiboot-header & trampoline-code & trampoline-gdt-section
   in TrampolineResult {
    bytes = bytes,
    far-jump-patch-pos = 269
  }

Section: Serial I/O
  emit-out-byte : CodegenState, Integer, Integer -> CodegenState
  emit-out-byte (st) (port) (value) =
   let st1 = st-append-code st (li reg-rdx port)
   in let st2 = st-append-code st1 (li reg-rax value)
   in st-append-code st2 out-dx-al

  emit-com1-init : CodegenState -> CodegenState
  emit-com1-init (st) =
   let st1 = emit-out-byte st 1019 128
   in let st2 = emit-out-byte st1 1016 1
   in let st3 = emit-out-byte st2 1017 0
   in let st4 = emit-out-byte st3 1019 3
   in let st5 = emit-out-byte st4 1018 199
   in emit-out-byte st5 1020 11

  emit-serial-wait-and-send : CodegenState, Integer -> CodegenState
  emit-serial-wait-and-send (st) (byte-val) =
   let wait-top = st.code-len
   in let st1 = st-append-code st (li reg-rdx 1021)
   in let st2 = st-append-code st1 [236]
   in let st3 = st-append-code st2 [168, 32]
   in let jne-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (jmp (wait-top - (st4.code-len + 5)))
   in let st6 = patch-jcc-at st5 jne-pos (st5.code-len)
   in let st7 = st-append-code st6 (li reg-rdx 1016)
   in let st8 = st-append-code st7 (li reg-rax byte-val)
   in st-append-code st8 out-dx-al

  emit-serial-send-rdi : CodegenState -> CodegenState
  emit-serial-send-rdi (st) =
   let wait-top = st.code-len
   in let st1 = st-append-code st (li reg-rdx 1021)
   in let st2 = st-append-code st1 [236]
   in let st3 = st-append-code st2 [168, 32]
   in let jne-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (jmp (wait-top - (st4.code-len + 5)))
   in let st6 = patch-jcc-at st5 jne-pos (st5.code-len)
   in let st7 = st-append-code st6 (li reg-rdx 1016)
   in let st8 = st-append-code st7 (mov-rr reg-rax reg-rdi)
   in st-append-code st8 out-dx-al

Section: Control Channel Serial I/O
  emit-com2-init : CodegenState -> CodegenState
  emit-com2-init (st) =
   let st1 = emit-out-byte st 763 128
   in let st2 = emit-out-byte st1 760 1
   in let st3 = emit-out-byte st2 761 0
   in let st4 = emit-out-byte st3 763 3
   in let st5 = emit-out-byte st4 762 199
   in emit-out-byte st5 764 11

  emit-control-wait-and-send : CodegenState, Integer -> CodegenState
  emit-control-wait-and-send (st) (byte-val) =
   let st0 = st-append-code st (li reg-rcx 10000)
   in let wait-top = st0.code-len
   in let st1 = st-append-code st0 (li reg-rdx 765)
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 [168, 32]
   in let done-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (sub-ri reg-rcx 1)
   in let timeout-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let st7 = st-append-code st6 (jmp (wait-top - (st6.code-len + 5)))
   in let st8 = patch-jcc-at st7 done-pos (st7.code-len)
   in let st9 = patch-jcc-at st8 timeout-pos (st8.code-len)
   in let st10 = st-append-code st9 (li reg-rdx 760)
   in let st11 = st-append-code st10 (li reg-rax byte-val)
   in st-append-code st11 out-dx-al

  emit-control-string-loop : CodegenState, List Integer, Integer -> CodegenState
  emit-control-string-loop (st) (chars) (i) =
   if i == list-length chars then st
   else let st1 = emit-control-wait-and-send st (list-at chars i)
   in emit-control-string-loop st1 chars (i + 1)

  emit-control-string : CodegenState, List Integer -> CodegenState
  emit-control-string (st) (chars) =
   emit-control-string-loop st chars 0

  emit-control-send-rdi : CodegenState -> CodegenState
  emit-control-send-rdi (st) =
   let st0 = st-append-code st (push-r reg-rdi)
   in let st0a = st-append-code st0 (li reg-rcx 10000)
   in let wait-top = st0a.code-len
   in let st1 = st-append-code st0a (li reg-rdx 765)
   in let st2 = st-append-code st1 in-al-dx
   in let st3 = st-append-code st2 [168, 32]
   in let done-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ne 0)
   in let st5 = st-append-code st4 (sub-ri reg-rcx 1)
   in let timeout-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-e 0)
   in let st7 = st-append-code st6 (jmp (wait-top - (st6.code-len + 5)))
   in let st8 = patch-jcc-at st7 done-pos (st7.code-len)
   in let st9 = patch-jcc-at st8 timeout-pos (st8.code-len)
   in let st10 = st-append-code st9 (pop-r reg-rdi)
   in let st11 = st-append-code st10 (li reg-rdx 760)
   in let st12 = st-append-code st11 (mov-rr reg-rax reg-rdi)
   in st-append-code st12 out-dx-al

Section: Inline Integer Print
  ItoaState = record {
   cg : CodegenState,
   jmp-done-zero-pos : Integer between 0 and 4294967295
  }

  emit-itoa-zero-check : CodegenState -> ItoaState
  emit-itoa-zero-check (st) =
   let st1 = st-append-code st (mov-rr reg-rbx reg-rax)
   in let st2 = st-append-code st1 (test-rr reg-rbx reg-rbx)
   in let jne-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ne 0)
   in let st4 = emit-serial-wait-and-send st3 48
   in let jmp-pos = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 jne-pos (st5.code-len)
   in ItoaState {
    cg = st6,
    jmp-done-zero-pos = jmp-pos
  }

  emit-itoa-sign-and-digits : CodegenState -> CodegenState
  emit-itoa-sign-and-digits (st) =
   let st1 = st-append-code st (test-rr reg-rbx reg-rbx)
   in let jns-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let st3 = emit-serial-wait-and-send st2 45
   in let st4 = st-append-code st3 (neg-r reg-rbx)
   in let st5 = patch-jcc-at st4 jns-pos (st4.code-len)
   in let st6 = st-append-code st5 (li reg-rcx 0)
   in let st7 = st-append-code st6 (li reg-r11 10)
   in let loop-top = st7.code-len
   in let st8 = st-append-code st7 (mov-rr reg-rax reg-rbx)
   in let st9 = st-append-code st8 cqo
   in let st10 = st-append-code st9 (idiv-r reg-r11)
   in let st11 = st-append-code st10 (mov-rr reg-rbx reg-rax)
   in let st12 = st-append-code st11 (add-ri reg-rdx 48)
   in let st13 = st-append-code st12 (push-r reg-rdx)
   in let st14 = st-append-code st13 (add-ri reg-rcx 1)
   in let st15 = st-append-code st14 (test-rr reg-rbx reg-rbx)
   in st-append-code st15 (jcc cc-ne (loop-top - (st15.code-len + 6)))

  emit-itoa-print-loop : CodegenState -> CodegenState
  emit-itoa-print-loop (st) =
   let loop-top = st.code-len
   in let st1 = st-append-code st (test-rr reg-rcx reg-rcx)
   in let je-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = st-append-code st2 (pop-r reg-rdi)
   in let st4 = st-append-code st3 (push-r reg-rcx)
   in let st5 = emit-serial-send-rdi st4
   in let st6 = st-append-code st5 (pop-r reg-rcx)
   in let st7 = st-append-code st6 (sub-ri reg-rcx 1)
   in let st8 = st-append-code st7 (jmp (loop-top - (st7.code-len + 5)))
   in patch-jcc-at st8 je-pos (st8.code-len)

  emit-inline-itoa-and-print : CodegenState -> CodegenState
  emit-inline-itoa-and-print (st) =
   let zero = emit-itoa-zero-check st
   in let st1 = emit-itoa-sign-and-digits (zero.cg)
   in let st2 = emit-itoa-print-loop st1
   in patch-jmp-at st2 (zero.jmp-done-zero-pos) (st2.code-len)

  emit-control-itoa-zero-check : CodegenState -> ItoaState
  emit-control-itoa-zero-check (st) =
   let st1 = st-append-code st (mov-rr reg-rbx reg-rax)
   in let st2 = st-append-code st1 (test-rr reg-rbx reg-rbx)
   in let jne-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ne 0)
   in let st4 = emit-control-wait-and-send st3 48
   in let jmp-pos = st4.code-len
   in let st5 = st-append-code st4 (jmp 0)
   in let st6 = patch-jcc-at st5 jne-pos (st5.code-len)
   in ItoaState {
    cg = st6,
    jmp-done-zero-pos = jmp-pos
  }

  emit-control-itoa-sign-and-digits : CodegenState -> CodegenState
  emit-control-itoa-sign-and-digits (st) =
   let st1 = st-append-code st (test-rr reg-rbx reg-rbx)
   in let jns-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let st3 = emit-control-wait-and-send st2 45
   in let st4 = st-append-code st3 (neg-r reg-rbx)
   in let st5 = patch-jcc-at st4 jns-pos (st4.code-len)
   in let st6 = st-append-code st5 (li reg-rcx 0)
   in let st7 = st-append-code st6 (li reg-r11 10)
   in let loop-top = st7.code-len
   in let st8 = st-append-code st7 (mov-rr reg-rax reg-rbx)
   in let st9 = st-append-code st8 cqo
   in let st10 = st-append-code st9 (idiv-r reg-r11)
   in let st11 = st-append-code st10 (mov-rr reg-rbx reg-rax)
   in let st12 = st-append-code st11 (add-ri reg-rdx 48)
   in let st13 = st-append-code st12 (push-r reg-rdx)
   in let st14 = st-append-code st13 (add-ri reg-rcx 1)
   in let st15 = st-append-code st14 (test-rr reg-rbx reg-rbx)
   in st-append-code st15 (jcc cc-ne (loop-top - (st15.code-len + 6)))

  emit-control-itoa-print-loop : CodegenState -> CodegenState
  emit-control-itoa-print-loop (st) =
   let loop-top = st.code-len
   in let st1 = st-append-code st (test-rr reg-rcx reg-rcx)
   in let je-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = st-append-code st2 (pop-r reg-rdi)
   in let st4 = st-append-code st3 (push-r reg-rcx)
   in let st5 = emit-control-send-rdi st4
   in let st6 = st-append-code st5 (pop-r reg-rcx)
   in let st7 = st-append-code st6 (sub-ri reg-rcx 1)
   in let st8 = st-append-code st7 (jmp (loop-top - (st7.code-len + 5)))
   in patch-jcc-at st8 je-pos (st8.code-len)

  emit-control-inline-itoa-and-print : CodegenState -> CodegenState
  emit-control-inline-itoa-and-print (st) =
   let zero = emit-control-itoa-zero-check st
   in let st1 = emit-control-itoa-sign-and-digits (zero.cg)
   in let st2 = emit-control-itoa-print-loop st1
   in patch-jmp-at st2 (zero.jmp-done-zero-pos) (st2.code-len)

Section: Print Text
  emit-serial-wait-thr : CodegenState -> CodegenState
  emit-serial-wait-thr (st) =
   let st1 = st-append-code st (push-r reg-rax)
   in let wait-top = st1.code-len
   in let st2 = st-append-code st1 (li reg-rdx 1021)
   in let st3 = st-append-code st2 [236]
   in let st4 = st-append-code st3 [168, 32]
   in let jne-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-ne 0)
   in let st6 = st-append-code st5 (jmp (wait-top - (st5.code-len + 5)))
   in let st7 = patch-jcc-at st6 jne-pos (st6.code-len)
   in st-append-code st7 (pop-r reg-rax)

  emit-print-newline : CodegenState -> CodegenState
  emit-print-newline (st) =
   let st1 = emit-serial-wait-thr st
   in let st2 = st-append-code st1 (li reg-rax 10)
   in let st3 = st-append-code st2 (li reg-rdx 1016)
   in st-append-code st3 out-dx-al

  emit-print-text-loop : CodegenState, Integer, Integer, Integer, Integer -> CodegenState
  emit-print-text-loop (st) (saved-ptr) (saved-table) (saved-len) (saved-idx) =
   let loop-top = st.code-len
   in let idx = load-local st saved-idx
   in let len-check = load-local (idx.state) saved-len
   in let st1 = st-append-code (len-check.state) (cmp-rr (idx.reg) (len-check.reg))
   in let done-jump = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let ptr-l = load-local st2 saved-ptr
   in let idx2 = load-local (ptr-l.state) saved-idx
   in let st3 = st-append-code (idx2.state) (lea reg-rsi (ptr-l.reg) 8)
   in let st4 = st-append-code st3 (add-rr reg-rsi (idx2.reg))
   in let st5 = st-append-code st4 (movzx-byte reg-rax reg-rsi 0)
   in let st5a = st-append-code st5 (cmp-ri reg-rax 128)
   in let multi-pos = st5a.code-len
   in let st5b = st-append-code st5a (jcc cc-ge 0)
   in let tbl = load-local st5b saved-table
   in let st6 = st-append-code (tbl.state) (push-r reg-rax)
   in let st6a = st-append-code st6 (add-rr reg-rax (tbl.reg))
   in let st7 = st-append-code st6a (movzx-byte reg-rax reg-rax 0)
   in let st7a = st-append-code st7 (cmp-ri reg-rax 128)
   in let t0-utf8-pos = st7a.code-len
   in let st7b = st-append-code st7a (jcc cc-ge 0)
   in let st7c = st-append-code st7b (add-ri reg-rsp 8)
   in let st8 = emit-serial-wait-thr st7c
   in let st9 = st-append-code st8 (li reg-rdx 1016)
   in let st10 = st-append-code st9 out-dx-al
   in let idx3 = load-local st10 saved-idx
   in let st11 = st-append-code (idx3.state) (add-ri (idx3.reg) 1)
   in let st12 = store-local st11 saved-idx (idx3.reg)
   in let st13 = st-append-code st12 (jmp (loop-top - (st12.code-len + 5)))
   in let st-t0u = patch-jcc-at st13 t0-utf8-pos (st13.code-len)
   in let st-t0u1 = st-append-code st-t0u (mov-rr reg-r11 reg-rax)
   in let st-t0u2 = st-append-code st-t0u1 (pop-r reg-rcx)
   in let st-t0u3 = emit-load-rodata-addr st-t0u2 reg-rax cce-to-unicode-hi-rodata-offset
   in let st-t0u4 = st-append-code st-t0u3 (add-rr reg-rax reg-rcx)
   in let st-t0u5 = st-append-code st-t0u4 (movzx-byte reg-rax reg-rax 0)
   in let st-t0u6 = st-append-code st-t0u5 (shl-ri reg-rax 8)
   in let st-t0u7 = st-append-code st-t0u6 (add-rr reg-rax reg-r11)
   in let st-t0u8 = st-append-code st-t0u7 (push-r reg-rax)
   in let st-t0u9 = st-append-code st-t0u8 (shr-ri reg-rax 6)
   in let st-t0u10 = st-append-code st-t0u9 (or-ri reg-rax 192)
   in let st-t0u11 = emit-serial-wait-thr st-t0u10
   in let st-t0u12 = st-append-code st-t0u11 (li reg-rdx 1016)
   in let st-t0u13 = st-append-code st-t0u12 out-dx-al
   in let st-t0u14 = st-append-code st-t0u13 (pop-r reg-rax)
   in let st-t0u15 = st-append-code st-t0u14 (and-ri reg-rax 63)
   in let st-t0u16 = st-append-code st-t0u15 (or-ri reg-rax 128)
   in let st-t0u17 = emit-serial-wait-thr st-t0u16
   in let st-t0u18 = st-append-code st-t0u17 (li reg-rdx 1016)
   in let st-t0u19 = st-append-code st-t0u18 out-dx-al
   in let idx-t0u = load-local st-t0u19 saved-idx
   in let st-t0u20 = st-append-code (idx-t0u.state) (add-ri (idx-t0u.reg) 1)
   in let st-t0u21 = store-local st-t0u20 saved-idx (idx-t0u.reg)
   in let st-t0u22 = st-append-code st-t0u21 (jmp (loop-top - (st-t0u21.code-len + 5)))
   in let st14 = patch-jcc-at st-t0u22 multi-pos (st-t0u22.code-len)
   in let ptr-m = load-local st14 saved-ptr
   in let idx-m = load-local (ptr-m.state) saved-idx
   in let st15 = st-append-code (idx-m.state) (mov-rr reg-rdi (ptr-m.reg))
   in let st16 = st-append-code st15 (mov-rr reg-rsi (idx-m.reg))
   in let st17 = emit-call-to st16 "__cce_print_multi"
   in let idx4 = load-local st17 saved-idx
   in let st18 = st-append-code (idx4.state) (add-rr (idx4.reg) reg-rax)
   in let st19 = store-local st18 saved-idx (idx4.reg)
   in let st20 = st-append-code st19 (jmp (loop-top - (st19.code-len + 5)))
   in patch-jcc-at st20 done-jump (st20.code-len)

  emit-print-text-raw-loop : CodegenState, Integer, Integer, Integer -> CodegenState
  emit-print-text-raw-loop (st) (saved-ptr) (saved-len) (saved-idx) =
   let loop-top = st.code-len
   in let idx = load-local st saved-idx
   in let len-check = load-local (idx.state) saved-len
   in let st1 = st-append-code (len-check.state) (cmp-rr (idx.reg) (len-check.reg))
   in let done-jump = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let ptr-l = load-local st2 saved-ptr
   in let idx2 = load-local (ptr-l.state) saved-idx
   in let st3 = st-append-code (idx2.state) (lea reg-rsi (ptr-l.reg) 8)
   in let st4 = st-append-code st3 (add-rr reg-rsi (idx2.reg))
   in let st5 = st-append-code st4 (movzx-byte reg-rax reg-rsi 0)
   in let st6 = emit-serial-wait-thr st5
   in let st7 = st-append-code st6 (li reg-rdx 1016)
   in let st8 = st-append-code st7 out-dx-al
   in let idx3 = load-local st8 saved-idx
   in let st9 = st-append-code (idx3.state) (add-ri (idx3.reg) 1)
   in let st10 = store-local st9 saved-idx (idx3.reg)
   in let st11 = st-append-code st10 (jmp (loop-top - (st10.code-len + 5)))
   in patch-jcc-at st11 done-jump (st11.code-len)

  emit-print-text-raw : CodegenState, Integer -> CodegenState
  emit-print-text-raw (st) (ptr-reg) =
   let saved-ptr = alloc-local st
   in let st1 = store-local (saved-ptr.state) (saved-ptr.reg) ptr-reg
   in let ptr-ld = load-local st1 (saved-ptr.reg)
   in let tmp-len = alloc-temp (ptr-ld.state)
   in let st2 = st-append-code (tmp-len.state) (mov-load (tmp-len.reg) (ptr-ld.reg) 0)
   in let saved-len = alloc-local st2
   in let st3 = store-local (saved-len.state) (saved-len.reg) (tmp-len.reg)
   in let saved-idx = alloc-local st3
   in let st4 = st-append-code (saved-idx.state) (li reg-r11 0)
   in let st5 = store-local st4 (saved-idx.reg) reg-r11
   in let st6 = emit-print-text-raw-loop st5 (saved-ptr.reg) (saved-len.reg) (saved-idx.reg)
   in emit-print-newline st6

  emit-uefi-print-text : CodegenState, Integer -> CodegenState
  emit-uefi-print-text (st) (ptr-reg) =
   let st1 = st-append-code st (mov-rr reg-rdi ptr-reg)
   in emit-call-to st1 "__uefi_print"

  emit-uefi-print-text-no-newline : CodegenState, Integer -> CodegenState
  emit-uefi-print-text-no-newline (st) (ptr-reg) =
   let st1 = st-append-code st (mov-rr reg-rdi ptr-reg)
   in emit-call-to st1 "__uefi_print_no_nl"

  emit-print-text : CodegenState, Integer -> CodegenState
  emit-print-text (st) (ptr-reg) =
   let saved-ptr = alloc-local st
   in let st1 = store-local (saved-ptr.state) (saved-ptr.reg) ptr-reg
   in let saved-table = alloc-local st1
   in let st2 = emit-load-rodata-addr (saved-table.state) reg-r11 cce-to-unicode-rodata-offset
   in let st2a = store-local st2 (saved-table.reg) reg-r11
   in let ptr-ld = load-local st2a (saved-ptr.reg)
   in let tmp-len = alloc-temp (ptr-ld.state)
   in let st3 = st-append-code (tmp-len.state) (mov-load (tmp-len.reg) (ptr-ld.reg) 0)
   in let saved-len = alloc-local st3
   in let st4 = store-local (saved-len.state) (saved-len.reg) (tmp-len.reg)
   in let saved-idx = alloc-local st4
   in let st5 = st-append-code (saved-idx.state) (li reg-r11 0)
   in let st6 = store-local st5 (saved-idx.reg) reg-r11
   in let st7 = emit-print-text-loop st6 (saved-ptr.reg) (saved-table.reg) (saved-len.reg) (saved-idx.reg)
   in emit-print-newline st7

  emit-print-text-no-newline : CodegenState, Integer -> CodegenState
  emit-print-text-no-newline (st) (ptr-reg) =
   let saved-ptr = alloc-local st
   in let st1 = store-local (saved-ptr.state) (saved-ptr.reg) ptr-reg
   in let saved-table = alloc-local st1
   in let st2 = emit-load-rodata-addr (saved-table.state) reg-r11 cce-to-unicode-rodata-offset
   in let st2a = store-local st2 (saved-table.reg) reg-r11
   in let ptr-ld = load-local st2a (saved-ptr.reg)
   in let tmp-len = alloc-temp (ptr-ld.state)
   in let st3 = st-append-code (tmp-len.state) (mov-load (tmp-len.reg) (ptr-ld.reg) 0)
   in let saved-len = alloc-local st3
   in let st4 = store-local (saved-len.state) (saved-len.reg) (tmp-len.reg)
   in let saved-idx = alloc-local st4
   in let st5 = st-append-code (saved-idx.state) (li reg-r11 0)
   in let st6 = store-local st5 (saved-idx.reg) reg-r11
   in emit-print-text-loop st6 (saved-ptr.reg) (saved-table.reg) (saved-len.reg) (saved-idx.reg)

  emit-print-bool : CodegenState, Integer -> CodegenState
  emit-print-bool (st) (val-reg) =
   let saved-val = alloc-local st
   in let st0 = store-local (saved-val.state) (saved-val.reg) val-reg
   in let val-l = load-local st0 (saved-val.reg)
   in let st1 = st-append-code (val-l.state) (test-rr (val-l.reg) (val-l.reg))
   in let je-false-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let true-lit = emit-text-lit st2 "True"
   in let st3 = emit-print-text-no-newline (true-lit.state) (true-lit.reg)
   in let jmp-end-pos = st3.code-len
   in let st4 = st-append-code st3 (jmp 0)
   in let st5 = patch-jcc-at st4 je-false-pos (st4.code-len)
   in let false-lit = emit-text-lit st5 "False"
   in let st6 = emit-print-text-no-newline (false-lit.state) (false-lit.reg)
   in let st7 = patch-jmp-at st6 jmp-end-pos (st6.code-len)
   in emit-print-newline st7


