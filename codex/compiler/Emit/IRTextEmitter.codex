Chapter: IR Text Emitter
  cites Codex chapter OffsetTable (offset-table-empty, offset-table-set, offset-table-get)

 Serializes IRChapter + ATypeDef list as S-expression text. The output
 is the wire format between the compiler and emit-plug programs (e.g.
 the C# plug under plugs/csharp/). Plug programs parse this text back
 into IRChapter + ATypeDef and feed it to a target-specific emitter.

 Format is positional S-expressions: every node is a paren-delimited
 list whose first element is a tag atom. Strings are double-quoted
 with backslash escapes for backslash, double-quote, and newline.
 Identifiers are bare atoms. Spans are elided -- the plug fills
 synthetic-span on parse since downstream emitters don't read span.

Section: Identifier Atoms

 Stable atoms identifying each variant. Plug parsers dispatch on the
 first atom of each form.

  ov-mode-atom : OverflowMode -> Text
  ov-mode-atom (m) =
   when m
    is OvError -> "ov-error"
    is OvWrapping -> "ov-wrap"
    is OvClamping -> "ov-clamp"

  bin-op-atom : IRBinaryOp -> Text
  bin-op-atom (op) =
   when op
    is IrAddInt -> "add-int"
    is IrSubInt -> "sub-int"
    is IrMulInt -> "mul-int"
    is IrDivInt -> "div-int"
    is IrRemInt -> "rem-int"
    is IrPowInt -> "pow-int"
    is IrAddNum -> "add-num"
    is IrSubNum -> "sub-num"
    is IrMulNum -> "mul-num"
    is IrDivNum -> "div-num"
    is IrAddRealApprox -> "add-real-approx"
    is IrSubRealApprox -> "sub-real-approx"
    is IrMulRealApprox -> "mul-real-approx"
    is IrDivRealApprox -> "div-real-approx"
    is IrAddRealTrapping -> "add-real-trapping"
    is IrSubRealTrapping -> "sub-real-trapping"
    is IrMulRealTrapping -> "mul-real-trapping"
    is IrDivRealTrapping -> "div-real-trapping"
    is IrAddRealSaturating -> "add-real-saturating"
    is IrSubRealSaturating -> "sub-real-saturating"
    is IrMulRealSaturating -> "mul-real-saturating"
    is IrDivRealSaturating -> "div-real-saturating"
    is IrEq -> "eq"
    is IrNotEq -> "ne"
    is IrLt -> "lt"
    is IrGt -> "gt"
    is IrLtEq -> "le"
    is IrGtEq -> "ge"
    is IrAnd -> "and"
    is IrOr -> "or"
    is IrAppendText -> "append-text"
    is IrAppendList -> "append-list"
    is IrConsList -> "cons-list"
    is IrApproxEq -> "approx-eq"
    is IrApproxEqExact -> "approx-eq-exact"
    is IrAddVec -> "add-vec"
    is IrSubVec -> "sub-vec"
    is IrMulVec -> "mul-vec"
    is IrDivVec -> "div-vec"
    is IrLtVec -> "lt-vec"
    is IrGtVec -> "gt-vec"
    is IrLtEqVec -> "le-vec"
    is IrGtEqVec -> "ge-vec"

Section: String Escaping

 Strings use double quotes. Backslash, double-quote, newline get
 backslash-escaped. Other CCE bytes pass through literally -- the
 plug parser scans byte-by-byte and reverses the escape mapping.

  ir-quote : Text -> Text
  ir-quote (s) = "\"" & text-concat-list (ir-quote-collect s 0 (text-length s) []) & "\""

  ir-quote-collect : Text, Integer, Integer, List Text -> List Text
  ir-quote-collect (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in ir-quote-collect s (i + 1) len (list-push acc (ir-quote-char c))

  ir-quote-char : Integer -> Text
  ir-quote-char (c) =
   if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "\"" 0 then "\\\""
   else if c == char-code-at "\n" 0 then "\\n"
   else char-to-text (code-to-char c)

Section: List Helpers

 Repeated text-list join used everywhere below. Concatenates a list
 of text fragments with no separator.

  ir-cat : List Text -> Text
  ir-cat (xs) = text-concat-list xs

  ir-strs-quoted : List Text, Integer, List Text -> List Text
  ir-strs-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-strs-quoted xs (i + 1) (list-push acc (" " & ir-quote (list-at xs i)))

  ir-names-quoted : List Name, Integer, List Text -> List Text
  ir-names-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-names-quoted xs (i + 1) (list-push acc (" " & ir-quote ((list-at xs i).value)))

Section: CodexType Emission

 Closed match on every CodexType variant. SumTy/RecordTy include their
 ctor / field lists since downstream emitters dispatch on them.

  is-default-int : Integer, Integer, OverflowMode -> Boolean
  is-default-int (lo) (hi) (mode) =
   if lo == i64-min then if hi == i64-max then is-ov-error mode else False
   else False

  is-ov-error : OverflowMode -> Boolean
  is-ov-error (m) =
   when m
    is OvError -> True
    is otherwise -> False

 i64-min cannot be passed to integer-to-text: the bare-metal __itoa
 helper negates negative inputs to a positive register before its digit
 loop, and abs(i64-min) overflows i64. Emit a sentinel atom instead;
 plug parsers map it back to i64-min.

  safe-int-text : Integer -> Text
  safe-int-text (n) = if n == i64-min then "i64-min" else integer-to-text n

  ir-emit-int-bounds : Integer, Integer, OverflowMode -> Text
  ir-emit-int-bounds (lo) (hi) (mode) =
   if is-default-int lo hi mode then "int-default"
   else "(int " & safe-int-text lo & " " & safe-int-text hi & " " & ov-mode-atom mode & ")"

 A bare reference to a generic record (e.g. `-> SortPartition`) parses as
 a RecordTy with empty type-args but fields whose types carry the free
 type variables (parameterize-walk merges the record's own param names
 with the enclosing signature's, so a field `list : List a` holds the
 function's tvar). We do NOT re-emit the fields (that caused exponential
 IR bloat on recursive types) - instead we recover the type arguments
 from the field tvars so a transpiler can emit `SortPartition<T9>`
 rather than an unparameterized generic.

  ir-int-member : List Integer, Integer -> Boolean
  ir-int-member (xs) (n) = ir-int-member-loop xs n 0 (list-length xs)

  ir-int-member-loop : List Integer, Integer, Integer, Integer -> Boolean
  ir-int-member-loop (xs) (n) (i) (len) =
   if i >= len then False
   else if list-at xs i == n then True
   else ir-int-member-loop xs n (i + 1) len

  ir-tvars-of-type : CodexType, List Integer -> List Integer
  ir-tvars-of-type (ty) (acc) =
   when ty
    is TypeVar (id) -> if ir-int-member acc id then acc else list-push acc id
    is ListTy (elem) | LinkedListTy (elem) -> ir-tvars-of-type elem acc
    is FunTy (p) (row) (r) -> ir-tvars-of-type r (ir-tvars-of-type p acc)
    is ForAllTy (tid) (body) -> ir-tvars-of-type body acc
    is ForAllEff (tid) (body) -> ir-tvars-of-type body acc
    is ConstructedTy (name) (args) | RecordTy (name) (args) (fields) | SumTy (name) (args) (ctors) -> ir-tvars-of-type-list args 0 acc
    is EffectfulTy (effs) (sc) (ret) -> ir-tvars-of-type ret acc
    is VectorTy (vn) (vt) -> ir-tvars-of-type vt acc
    is VectorMaskTy (n) -> acc
    is LinearTy (linner) -> ir-tvars-of-type linner acc
    is otherwise -> acc

  ir-tvars-of-type-list : List CodexType, Integer, List Integer -> List Integer
  ir-tvars-of-type-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else ir-tvars-of-type-list xs (i + 1) (ir-tvars-of-type (list-at xs i) acc)

  ir-record-field-tvars : List RecordField, Integer, List Integer -> List Integer
  ir-record-field-tvars (fields) (i) (acc) =
   if i >= list-length fields then acc
   else ir-record-field-tvars fields (i + 1) (ir-tvars-of-type ((list-at fields i).type-val) acc)

  ir-emit-tvar-args : List Integer, Integer -> Text
  ir-emit-tvar-args (ids) (i) =
   if i >= list-length ids then ""
   else " (tvar " & integer-to-text (list-at ids i) & ")" & ir-emit-tvar-args ids (i + 1)

 THE FOUR ATOMS THAT ALREADY EXISTED KEEP THEIR EXACT SPELLINGS. A plug
 reading this wire matches on the text, so changing "real-approx" to a
 composed form would break every plug for a combination it already
 handles. Only the two f32 modes that could not be spelled before are new
 surface, and a plug that does not know them must refuse rather than fall
 through to ErrorTy.

  ir-emit-real-ty : RealWidth, RealMode -> Text
  ir-emit-real-ty (w) (m) =
   if is-width-f32 w then ir-emit-real-f32-ty m
   else ir-emit-real-f64-ty m

  ir-emit-real-f32-ty : RealMode -> Text
  ir-emit-real-f32-ty (m) =
   when m
    is RmDefault -> "real-approx"
    is RmTrapping -> "real-approx-trapping"
    is RmSaturating -> "real-approx-saturating"

  ir-emit-real-f64-ty : RealMode -> Text
  ir-emit-real-f64-ty (m) =
   when m
    is RmDefault -> "real"
    is RmTrapping -> "real-trapping"
    is RmSaturating -> "real-saturating"

 An arrow's effect row was bound and discarded here until 2026-08-03, so
 a function that declared an effect lost it the moment it took a
 parameter and no consumer of this wire could see it. The row is
 OPTIONAL and trails the two type positions: `(fn p r)` still means an
 empty row and keeps its exact spelling, so a reader taking element 1 and
 element 2 is unaffected.

  ir-emit-row-labels : List EffectLabel -> Text
  ir-emit-row-labels (xs) =
   ir-cat (for l in xs -> " (label " & ir-quote ((l.name).value) & " " & ir-quote (l.scope) & ")")

 Only a row carrying CONCRETE LABELS is published. An open row with no
 labels is a row variable, and rows are inert through the compiler's own
 stage 2 -- concrete effects ride in EffectfulTy until a later stage
 migrates them onto the arrow -- so a bare row variable is a fact no
 consumer can use today, and they are most of the cost. Measured on
 `list-pattern` and `linear-smoke` 2026-08-03: publishing every row grew
 the IR text 15.4 and 9.0 per cent, almost all of it `(row (labels) "" N)`
 on polymorphic arrows; publishing only labelled rows grows it 5.7 and 2.3
 per cent. When row variables become load-bearing this is where they go
 back.

  ir-emit-row : EffectRow -> Text
  ir-emit-row (row) =
   if list-length (row.labels) == 0 then ""
   else " (row (labels" & ir-emit-row-labels (row.labels) & ") " & ir-quote (row.tail-name) & " " & integer-to-text (row.tail-id) & ")"

 `ProofTy`, `PropEqTy`, `TypeCon` and `TypeApply` fell through to the
 `otherwise` arm until 2026-08-04 and emitted the same `error` atom
 `ErrorTy` emits, so a proof type was indistinguishable from a type
 failure on this wire and a reader had to answer UNSUPPORTED on the atom
 rather than treat it as either. That is a hole on its own, and it also
 makes a real defect undiagnosable: a constructor pattern over a
 PARAMETRIC sum binds its variable at `error` while the same variable's
 use carries the real type, and whether the lowering assigned `ErrorTy`
 or a `TypeApply` this emitter had no arm for cannot be read off the
 artifact while both spell it the same way. The `otherwise` arm stays as
 a floor for a variant added later.

  ir-emit-type : CodexType -> Text
  ir-emit-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> ir-emit-int-bounds lo hi mode
    is RealTy (w) (m) -> ir-emit-real-ty w m
    is TextTy -> "text"
    is BooleanTy -> "boolean"
    is CharTy -> "char"
    is VoidTy -> "void"
    is NothingTy -> "nothing"
    is ErrorTy -> "error"
    is FunTy (p) (row) (r) -> "(fn " & ir-emit-type p & " " & ir-emit-type r & ir-emit-row row & ")"
    is ListTy (elem) -> "(list " & ir-emit-type elem & ")"
    is LinkedListTy (elem) -> "(llist " & ir-emit-type elem & ")"
    is TypeVar (id) -> "(tvar " & integer-to-text id & ")"
    is ForAllTy (id) (body) -> "(forall " & integer-to-text id & " " & ir-emit-type body & ")"
    is ForAllEff (id) (body) -> ir-emit-type body
    is SumTy (name) (args) (ctors) -> "(sum " & ir-quote (name.value) & " (args" & ir-emit-type-list args 0 & ") (sum-ctors" & ir-emit-sum-ctors ctors 0 & "))"
    is RecordTy (name) (args) (fields) -> "(record-ty " & ir-quote (name.value) & " (args" & (if list-length args > 0 then ir-emit-type-list args 0 else ir-emit-tvar-args (ir-record-field-tvars fields 0 []) 0) & ") (record-fields" & ir-emit-record-fields fields 0 & "))"
    is ConstructedTy (name) (args) -> "(ctd " & ir-quote (name.value) & " (args" & ir-emit-type-list args 0 & "))"
    is EffectfulTy (effs) (sc) (ret) -> "(effectful (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted sc 0 []) & ") " & ir-emit-type ret & ")"
    is UnitTy (name) (inner) -> "(unit " & ir-quote (name.value) & " " & ir-emit-type inner & ")"
    is VectorTy (n) (t) -> "(vector " & integer-to-text n & " " & ir-emit-type t & ")"
    is VectorMaskTy (n) -> "(vector-mask " & integer-to-text n & ")"
    is LinearTy (linner) -> ir-emit-type linner
    is ProofTy -> "proof"
    is PropEqTy (a) (b) -> "(propeq " & ir-emit-type a & " " & ir-emit-type b & ")"
    is TypeCon (n) -> "(tycon " & ir-quote (n.value) & ")"
    is TypeApply (tf) (ta) -> "(tyapply " & ir-emit-type tf & " " & ir-emit-type ta & ")"
    is otherwise -> "error"

  ir-emit-type-list : List CodexType, Integer -> Text
  ir-emit-type-list (xs) (i) =
   ir-cat (for t in xs -> " " & ir-emit-type t)

  ir-emit-sum-ctors : List SumCtor, Integer -> Text
  ir-emit-sum-ctors (xs) (i) =
   ir-cat (for c in xs -> " (sum-ctor " & ir-quote (c.name.value) & " (fields" & ir-emit-type-list (c.fields) 0 & "))")

  ir-emit-record-fields : List RecordField, Integer -> Text
  ir-emit-record-fields (xs) (i) =
   ir-cat (for f in xs -> " (record-field " & ir-quote (f.name.value) & " " & ir-emit-type (f.type-val) & ")")

Section: ATypeExpr Emission

 Surface AST type expressions. Distinct prefix from CodexType atoms
 ("a" prefix) so a parser can tell them apart structurally.

  ir-emit-atype-expr : ATypeExpr -> Text
  ir-emit-atype-expr (te) =
   when te
    is ANamedType (name) (s) -> "(a-named " & ir-quote (name.value) & ")"
    is AFunType (p) (r) (s) -> "(a-fun " & ir-emit-atype-expr p & " " & ir-emit-atype-expr r & ")"
    is AAppType (base) (args) (s) -> "(a-app " & ir-emit-atype-expr base & " (args" & ir-emit-atype-expr-list args 0 & "))"
    is AEffectType (effs) (scopes) (tail) (r) (s) ->
     if list-length tail == 0 then "(a-eff (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") " & ir-emit-atype-expr r & ")"
     else "(a-eff (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") (tail " & ir-quote ((list-at tail 0).value) & ") " & ir-emit-atype-expr r & ")"
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> "(a-bounded " & ir-emit-atype-expr b & " " & safe-int-text lo & " " & safe-int-text hi & " " & ov-mode-atom mode & ")"
    is ALinearType (inner) (s) -> "(a-linear " & ir-emit-atype-expr inner & ")"
    is otherwise -> "(a-unknown)"

  ir-emit-atype-expr-list : List ATypeExpr, Integer -> Text
  ir-emit-atype-expr-list (xs) (i) =
   ir-cat (for t in xs -> " " & ir-emit-atype-expr t)

Section: Type Parameter Inference

 When a type-def has empty tparams (the parser found no explicit type
 parameters between the name and =), scan field types to find implicit
 type parameters: lowercase-initial names in type position.

  ir-tparam-name-p : Text -> Boolean
  ir-tparam-name-p (name) =
   if text-length name == 0 then False
   else let code = char-code-at name 0
   in code >= char-code-at "e" 0 & code <= char-code-at "z" 0

  ir-text-in-list : List Text, Text, Integer, Integer -> Boolean
  ir-text-in-list (xs) (target) (i) (len) =
   if i == len then False
   else if list-at xs i == target then True
   else ir-text-in-list xs target (i + 1) len

  ir-collect-atexpr-tparams : ATypeExpr, List Text -> List Text
  ir-collect-atexpr-tparams (te) (acc) =
   when te
    is ANamedType (name) (s) ->
     if ir-tparam-name-p (name.value) & ir-text-in-list acc (name.value) 0 (list-length acc) == False
     then list-push acc (name.value)
     else acc
    is AFunType (p) (r) (s) ->
     ir-collect-atexpr-tparams r (ir-collect-atexpr-tparams p acc)
    is AAppType (base) (args) (s) ->
     ir-collect-atexpr-list-tparams args 0 (list-length args) (ir-collect-atexpr-tparams base acc)
    is AEffectType (effs) (scopes) (tail) (r) (s) ->
     ir-collect-atexpr-tparams r acc
    is ABoundedIntType (b) (lo) (hi) (mode) (s) ->
     ir-collect-atexpr-tparams b acc
    is ALinearType (inner) (s) ->
     ir-collect-atexpr-tparams inner acc
    is otherwise -> acc

  ir-collect-atexpr-list-tparams : List ATypeExpr, Integer, Integer, List Text -> List Text
  ir-collect-atexpr-list-tparams (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-collect-atexpr-list-tparams xs (i + 1) len (ir-collect-atexpr-tparams (list-at xs i) acc)

  ir-collect-rec-field-tparams : List ARecordFieldDef, Integer, Integer, List Text -> List Text
  ir-collect-rec-field-tparams (fields) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in ir-collect-rec-field-tparams fields (i + 1) len (ir-collect-atexpr-tparams (f.type-expr) acc)

  ir-collect-var-ctor-tparams : List AVariantCtorDef, Integer, Integer, List Text -> List Text
  ir-collect-var-ctor-tparams (ctors) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in ir-collect-var-ctor-tparams ctors (i + 1) len (ir-collect-atexpr-list-tparams (c.fields) 0 (list-length (c.fields)) acc)

  ir-emit-tparams-text : List Name, List Text -> Text
  ir-emit-tparams-text (explicit) (inferred) =
   if list-length explicit > 0 then ir-cat (ir-names-quoted explicit 0 [])
   else ir-cat (ir-strs-quoted inferred 0 [])

Section: ATypeDef Emission

  ir-emit-atype-defs : List ATypeDef, Integer -> Text
  ir-emit-atype-defs (xs) (i) =
   ir-cat (ir-emit-atype-defs-acc xs i (list-length xs) [])

  ir-emit-atype-defs-acc : List ATypeDef, Integer, Integer, List Text -> List Text
  ir-emit-atype-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-atype-defs-acc xs (i + 1) len (list-push acc ("\n  " & ir-emit-atype-def (list-at xs i)))

  ir-emit-atype-def : ATypeDef -> Text
  ir-emit-atype-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     let inferred = ir-collect-rec-field-tparams fields 0 (list-length fields) []
     in "(rec-def " & ir-quote (name.value) & " (tparams" & ir-emit-tparams-text tparams inferred & ") (fields" & ir-emit-rec-field-defs fields 0 & "))"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     let inferred = ir-collect-var-ctor-tparams ctors 0 (list-length ctors) []
     in "(var-def " & ir-quote (name.value) & " (tparams" & ir-emit-tparams-text tparams inferred & ") (ctors" & ir-emit-var-ctor-defs ctors 0 & "))"
    is AUnitTypeDef (name) (base) (s) ->
     "(unit-def " & ir-quote (name.value) & " " & ir-emit-atype-expr base & ")"

  ir-emit-rec-field-defs : List ARecordFieldDef, Integer -> Text
  ir-emit-rec-field-defs (xs) (i) =
   ir-cat (ir-emit-rec-field-defs-acc xs i (list-length xs) [])

  ir-emit-rec-field-defs-acc : List ARecordFieldDef, Integer, Integer, List Text -> List Text
  ir-emit-rec-field-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at xs i
   in ir-emit-rec-field-defs-acc xs (i + 1) len (list-push acc (" (rec-field " & ir-quote (f.name.value) & " " & ir-emit-atype-expr (f.type-expr) & ")"))

  ir-emit-var-ctor-defs : List AVariantCtorDef, Integer -> Text
  ir-emit-var-ctor-defs (xs) (i) =
   ir-cat (ir-emit-var-ctor-defs-acc xs i (list-length xs) [])

  ir-emit-var-ctor-defs-acc : List AVariantCtorDef, Integer, Integer, List Text -> List Text
  ir-emit-var-ctor-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at xs i
   in ir-emit-var-ctor-defs-acc xs (i + 1) len (list-push acc (" (var-ctor " & ir-quote (c.name.value) & " (fields" & ir-emit-atype-expr-list (c.fields) 0 & "))"))

Section: IRPattern Emission

  ir-emit-pat : IRPat -> Text
  ir-emit-pat (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> "(var-pat " & ir-quote name & " " & ir-emit-type ty & ")"
    is IrLitPat (text) (ty) (sp) -> "(lit-pat " & ir-quote text & " " & ir-emit-type ty & ")"
    is IrCtorPat (name) (subs) (ty) (sp) -> "(ctor-pat " & ir-quote name & " (subs" & ir-emit-pat-list subs 0 & ") " & ir-emit-type ty & ")"
    is IrWildPat (sp) -> "wild-pat"
    is IrVecPat (subs) (ty) (sp) -> "(vec-pat" & ir-emit-pat-list subs 0 & ")"

  ir-emit-pat-list : List IRPat, Integer -> Text
  ir-emit-pat-list (xs) (i) =
   ir-cat (ir-emit-pat-list-acc xs i (list-length xs) [])

  ir-emit-pat-list-acc : List IRPat, Integer, Integer, List Text -> List Text
  ir-emit-pat-list-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-pat-list-acc xs (i + 1) len (list-push acc (" " & ir-emit-pat (list-at xs i)))

Section: IRExpr Emission

 The expression printer. Each variant fits a single (atom ...) form.
 Type tags follow the structural arguments -- match the IRExpr
 constructor order so a parser can read positionally.

  ir-emit-expr : IRExpr -> Text
  ir-emit-expr (e) =
   when e
    is IrIntLit (n) (sp) -> "(int-lit " & safe-int-text n & ")"
    is IrNumLit (n) (sp) -> "(num-lit " & safe-int-text n & ")"
    is IrTextLit (s) (sp) -> "(text-lit " & ir-quote s & ")"
    is IrBoolLit (b) (sp) -> if b then "(bool-lit true)" else "(bool-lit false)"
    is IrCharLit (c) (sp) -> "(char-lit " & integer-to-text c & ")"
    is IrName (n) (ty) (sp) -> "(name " & ir-quote n & " " & ir-emit-type ty & ")"
    is IrBinary (op) (l) (r) (ty) (sp) -> "(binary " & bin-op-atom op & " " & ir-emit-expr l & " " & ir-emit-expr r & " " & ir-emit-type ty & ")"
    is IrNegate (x) (ty) (sp) -> "(negate " & ir-emit-expr x & " " & ir-emit-type ty & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(if " & ir-emit-expr c & " " & ir-emit-expr t & " " & ir-emit-expr el & " " & ir-emit-type ty & ")"
    is IrLet (n) (ty) (v) (b) (sp) -> ir-cat (ir-emit-let-chain e [] 0)
    is IrApply (f) (a) (ty) (sp) -> "(apply " & ir-emit-expr f & " " & ir-emit-expr a & " " & ir-emit-type ty & ")"
    is IrLambda (params) (body) (ty) (sp) -> "(lambda (params" & ir-emit-params params 0 & ") " & ir-emit-expr body & " " & ir-emit-type ty & ")"
    is IrList (es) (ty) (sp) -> "(list-expr (elems" & ir-emit-expr-list es 0 & ") " & ir-emit-type ty & ")"
    is IrMatch (sc) (bs) (ty) (sp) -> "(match " & ir-emit-expr sc & " (branches" & ir-emit-branches bs 0 & ") " & ir-emit-type ty & ")"
    is IrAct (ss) (ty) (sp) -> "(act (stmts" & ir-emit-act-stmts ss 0 & ") " & ir-emit-type ty & ")"
    is IrHandle (eff) (h) (cs) (ty) (sp) -> "(handle " & ir-quote eff & " " & ir-emit-expr h & " (clauses" & ir-emit-handle-clauses cs 0 & ") " & ir-emit-type ty & ")"
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> "(with-timeout " & integer-to-text secs & " (effs" & ir-cat (ir-strs-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") " & ir-emit-expr body & " " & ir-emit-type ty & ")"
    is IrRecord (n) (fs) (ty) (sp) -> "(record " & ir-quote n & " (fields" & ir-emit-field-vals fs 0 & ") " & ir-emit-type ty & ")"
    is IrFieldAccess (r) (f) (ty) (sp) -> let fi = ir-resolve-field-index (ir-expr-type r) f in "(field-access " & ir-emit-expr r & " " & ir-quote (ir-field-with-index f fi) & " " & ir-emit-type ty & ")"
    is IrFieldStore (r) (f) (v) (ty) (sp) -> let fi = ir-resolve-field-index (ir-expr-type r) f in "(field-store " & ir-emit-expr r & " " & ir-quote (ir-field-with-index f fi) & " " & ir-emit-expr v & " " & ir-emit-type ty & ")"
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> "(try " & integer-to-text max & " (body" & ir-emit-act-stmts body 0 & ") (fallback" & ir-emit-act-stmts fb 0 & ") (fail" & ir-emit-act-stmts fail 0 & ") " & ir-emit-type ty & ")"
    is IrFork (b) (ty) (sp) -> "(fork " & ir-emit-expr b & " " & ir-emit-type ty & ")"
    is IrAwait (t) (ty) (sp) -> "(await " & ir-emit-expr t & " " & ir-emit-type ty & ")"
    is IrError (m) (ty) (sp) -> "(error " & ir-quote m & " " & ir-emit-type ty & ")"

 Let-chains are the deepest structure in real Codex (every `in` nests
 the rest), so emitting `IrLet` by naive recursion makes each level
 concatenate the entire inner body -- the left operand is never at the
 heap bump pointer, so __str_concat takes the copy path every level,
 giving O(depth^2) copies. Flatten the chain instead: collect each
 level's "(let name ty val " prefix into one list, emit the innermost
 body, then append one ")" per level, and join once. Byte-identical
 output, O(total). Mirrors codex-emit-let-chain in the Codex text emitter.

  ir-emit-let-chain : IRExpr, List Text, Integer -> List Text
  ir-emit-let-chain (e) (acc) (depth) =
   when e
    is IrLet (n) (ty) (v) (b) (sp) ->
     ir-emit-let-chain b (list-push acc ("(let " & ir-quote n & " " & ir-emit-type ty & " " & ir-emit-expr v & " ")) (depth + 1)
    is otherwise ->
     ir-close-parens (list-push acc (ir-emit-expr e)) depth

  ir-close-parens : List Text, Integer -> List Text
  ir-close-parens (acc) (n) =
   if n == 0 then acc
   else ir-close-parens (list-push acc ")") (n - 1)

  ir-emit-expr-list : List IRExpr, Integer -> Text
  ir-emit-expr-list (xs) (i) =
   ir-cat (ir-emit-expr-list-acc xs i (list-length xs) [])

  ir-emit-expr-list-acc : List IRExpr, Integer, Integer, List Text -> List Text
  ir-emit-expr-list-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-expr-list-acc xs (i + 1) len (list-push acc (" " & ir-emit-expr (list-at xs i)))

  ir-emit-params : List IRParam, Integer -> Text
  ir-emit-params (xs) (i) =
   ir-cat (ir-emit-params-acc xs i (list-length xs) [])

  ir-emit-params-acc : List IRParam, Integer, Integer, List Text -> List Text
  ir-emit-params-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at xs i
   in ir-emit-params-acc xs (i + 1) len (list-push acc (" (param " & ir-quote (p.name) & " " & ir-emit-type (p.type-val) & ")"))

  ir-emit-branches : List IRBranch, Integer -> Text
  ir-emit-branches (xs) (i) =
   ir-cat (ir-emit-branches-acc xs i (list-length xs) [])

  ir-emit-branches-acc : List IRBranch, Integer, Integer, List Text -> List Text
  ir-emit-branches-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at xs i
   in ir-emit-branches-acc xs (i + 1) len (list-push acc (" (branch " & ir-emit-pat (b.pattern) & " " & ir-emit-expr (b.body) & " " & ir-emit-expr (b.guard) & ")"))

  ir-emit-act-stmts : List IRActStmt, Integer -> Text
  ir-emit-act-stmts (xs) (i) =
   ir-cat (ir-emit-act-stmts-acc xs i (list-length xs) [])

  ir-emit-act-stmts-acc : List IRActStmt, Integer, Integer, List Text -> List Text
  ir-emit-act-stmts-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-act-stmts-acc xs (i + 1) len (list-push acc (" " & ir-emit-act-stmt (list-at xs i)))

  ir-emit-act-stmt : IRActStmt -> Text
  ir-emit-act-stmt (s) =
   when s
    is IrDoBind (n) (ty) (v) (sp) -> "(do-bind " & ir-quote n & " " & ir-emit-type ty & " " & ir-emit-expr v & ")"
    is IrDoExec (e) (sp) -> "(do-exec " & ir-emit-expr e & ")"

  ir-emit-handle-clauses : List IRHandleClause, Integer -> Text
  ir-emit-handle-clauses (xs) (i) =
   ir-cat (ir-emit-handle-clauses-acc xs i (list-length xs) [])

  ir-emit-handle-clauses-acc : List IRHandleClause, Integer, Integer, List Text -> List Text
  ir-emit-handle-clauses-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at xs i
   in ir-emit-handle-clauses-acc xs (i + 1) len (list-push acc (" (handle-clause " & ir-quote (c.op-name) & " (params" & ir-cat (ir-strs-quoted (c.params) 0 []) & ") " & ir-quote (c.resume-name) & " " & ir-emit-expr (c.body) & ")"))

  ir-emit-field-vals : List IRFieldVal, Integer -> Text
  ir-emit-field-vals (xs) (i) =
   ir-cat (ir-emit-field-vals-acc xs i (list-length xs) [])

  ir-emit-field-vals-acc : List IRFieldVal, Integer, Integer, List Text -> List Text
  ir-emit-field-vals-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at xs i
   in ir-emit-field-vals-acc xs (i + 1) len (list-push acc (" (field-val " & ir-quote (f.name) & " " & ir-emit-expr (f.value) & ")"))

Section: Field Index Resolution

  ir-resolve-field-index : CodexType, Text -> Integer
  ir-resolve-field-index (ty) (name) =
   when ty
    is RecordTy (rn) (tvars) (fields) -> ir-find-field-in-record fields name 0
    is otherwise -> 0 - 1

  ir-find-field-in-record : List RecordField, Text, Integer -> Integer
  ir-find-field-in-record (fields) (name) (i) =
   if i >= list-length fields then 0 - 1
   else if ((list-at fields i).name).value == name then i
   else ir-find-field-in-record fields name (i + 1)

  ir-field-with-index : Text, Integer -> Text
  ir-field-with-index (name) (idx) =
   if idx >= 0 then name & "/" & integer-to-text idx
   else name

Section: IR Dead Code Elimination

 Reachability pruning of the chapter's def list. A def is kept when it
 is reachable, through referenced names, from the entry point. Operates
 on the structured IR -- no text, no Unicode. The collected name set is
 every atom the text emitter would quote, so the kept set matches a
 substring reachability over the emitted IR text. Type defs, ctors, and
 effect-op names live in the chapter header and are untouched.

  DceWork = record {
   visited : List Boolean,
   frontier : List Integer
  }

  ir-dce-append-list : List Text, Integer, List Text -> List Text
  ir-dce-append-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-append-list xs (i + 1) (list-push acc (list-at xs i))

 What counts as a reference to a definition, and what does not.

 This walk collects the names a definition REACHES. It used to collect
 every name-shaped thing it passed -- text literals, let names, param
 names, field names, pattern variables, error messages -- on the reasoning
 that over-collecting only ever keeps too much. That is true of soundness
 and false of usefulness: a compiler writes its own function names as text
 literals (runtime helper names, builtin names, diagnostics), and a field
 or a parameter routinely shares a name with some definition somewhere. On
 the compiler's own source the walk retained essentially everything and
 the prune was inert -- measured, before this change: zero definitions
 dropped out of 5167.

 So the walk now collects REFERENCES only:

   IrName            a use of a definition -- the reference
   IrRecord          the constructor being applied
   IrCtorPat         the constructor being matched
   handler op-name   the effect operation a clause discharges
   handler resume    the continuation the clause may invoke
   IrHandle eff      the effect being handled
   IrWithTimeout     the effects and scopes it names

 and ignores BINDING occurrences (a let name, a parameter, a pattern
 variable, a clause parameter) because a binding introduces a name rather
 than reaching one, FIELD names because a field is selected from a record
 rather than called, and TEXT (literals, literal patterns, error messages)
 because Codex has no dispatch from a runtime string: there is no
 call-by-name, so a definition cannot be reached by spelling it.

 The one place a name in a string does reach a definition is the emitter
 calling a worker through a hardcoded string of its own -- the fat16
 servicers. That is not something this walk can see from the IR, and it is
 handled where it belongs, as an explicit root (cdx-emit-roots, opening).

 If this list is ever wrong, the build says so and names the definition:
 every call, address-of and effect-op slot is checked at finalize and an
 unresolved one raises CDX2040 and refuses the binary.

  ir-dce-collect-expr : IRExpr, List Text -> List Text
  ir-dce-collect-expr (e) (acc) =
   when e
    is IrIntLit (n) (sp) | IrNumLit (n) (sp) -> acc
    is IrTextLit (s) (sp) -> acc
    is IrBoolLit (b) (sp) | IrCharLit (c) (sp) -> acc
    is IrName (n) (ty) (sp) -> list-push acc n
    is IrBinary (op) (l) (r) (ty) (sp) -> ir-dce-collect-expr r (ir-dce-collect-expr l acc)
    is IrNegate (x) (ty) (sp) -> ir-dce-collect-expr x acc
    is IrIf (c) (t) (el) (ty) (sp) -> ir-dce-collect-expr el (ir-dce-collect-expr t (ir-dce-collect-expr c acc))
    is IrLet (n) (ty) (v) (b) (sp) -> ir-dce-collect-expr b (ir-dce-collect-expr v acc)
    is IrApply (f) (a) (ty) (sp) -> ir-dce-collect-expr a (ir-dce-collect-expr f acc)
    is IrLambda (ps) (body) (ty) (sp) -> ir-dce-collect-expr body acc
    is IrList (es) (ty) (sp) -> ir-dce-collect-expr-list es 0 acc
    is IrMatch (sc) (bs) (ty) (sp) -> ir-dce-collect-branches bs 0 (ir-dce-collect-expr sc acc)
    is IrAct (ss) (ty) (sp) -> ir-dce-collect-stmts ss 0 acc
    is IrHandle (eff) (h) (cs) (ty) (sp) -> ir-dce-collect-clauses cs 0 (ir-dce-collect-expr h (list-push acc eff))
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> ir-dce-collect-expr body (ir-dce-append-list scopes 0 (ir-dce-append-list effs 0 acc))
    is IrRecord (n) (fs) (ty) (sp) -> ir-dce-collect-fields fs 0 (list-push acc n)
    is IrFieldAccess (r) (f) (ty) (sp) -> ir-dce-collect-expr r acc
    is IrFieldStore (r) (f) (v) (ty) (sp) -> ir-dce-collect-expr v (ir-dce-collect-expr r acc)
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> ir-dce-collect-stmts fail 0 (ir-dce-collect-stmts fb 0 (ir-dce-collect-stmts body 0 acc))
    is IrFork (b) (ty) (sp) -> ir-dce-collect-expr b acc
    is IrAwait (t) (ty) (sp) -> ir-dce-collect-expr t acc
    is IrError (m) (ty) (sp) -> acc

  ir-dce-collect-expr-list : List IRExpr, Integer, List Text -> List Text
  ir-dce-collect-expr-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-expr-list xs (i + 1) (ir-dce-collect-expr (list-at xs i) acc)

  ir-dce-collect-branches : List IRBranch, Integer, List Text -> List Text
  ir-dce-collect-branches (xs) (i) (acc) =
   if i == list-length xs then acc
   else let b = list-at xs i
   in ir-dce-collect-branches xs (i + 1) (ir-dce-collect-expr (b.guard) (ir-dce-collect-expr (b.body) (ir-dce-collect-pat (b.pattern) acc)))

  ir-dce-collect-pat : IRPat, List Text -> List Text
  ir-dce-collect-pat (p) (acc) =
   when p
    is IrVarPat (name) (ty) (sp) -> acc
    is IrLitPat (text) (ty) (sp) -> acc
    is IrCtorPat (name) (subs) (ty) (sp) -> ir-dce-collect-pat-list subs 0 (list-push acc name)
    is IrWildPat (sp) -> acc
    is IrVecPat (subs) (ty) (sp) -> ir-dce-collect-pat-list subs 0 acc

  ir-dce-collect-pat-list : List IRPat, Integer, List Text -> List Text
  ir-dce-collect-pat-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-pat-list xs (i + 1) (ir-dce-collect-pat (list-at xs i) acc)

  ir-dce-collect-stmts : List IRActStmt, Integer, List Text -> List Text
  ir-dce-collect-stmts (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-stmts xs (i + 1) (ir-dce-collect-stmt (list-at xs i) acc)

  ir-dce-collect-stmt : IRActStmt, List Text -> List Text
  ir-dce-collect-stmt (s) (acc) =
   when s
    is IrDoBind (n) (ty) (v) (sp) -> ir-dce-collect-expr v acc
    is IrDoExec (e) (sp) -> ir-dce-collect-expr e acc

  ir-dce-collect-clauses : List IRHandleClause, Integer, List Text -> List Text
  ir-dce-collect-clauses (xs) (i) (acc) =
   if i == list-length xs then acc
   else let c = list-at xs i
   in ir-dce-collect-clauses xs (i + 1) (ir-dce-collect-expr (c.body) (list-push (list-push acc (c.op-name)) (c.resume-name)))

  ir-dce-collect-fields : List IRFieldVal, Integer, List Text -> List Text
  ir-dce-collect-fields (xs) (i) (acc) =
   if i == list-length xs then acc
   else let f = list-at xs i
   in ir-dce-collect-fields xs (i + 1) (ir-dce-collect-expr (f.value) acc)

  ir-dce-build-index : List IRDef, Integer, Integer, OffsetTable -> OffsetTable
  ir-dce-build-index (defs) (i) (len) (tbl) =
   if i == len then tbl
   else ir-dce-build-index defs (i + 1) len (offset-table-set tbl ((list-at defs i).name) i)

  ir-dce-falses : Integer, Integer, List Boolean -> List Boolean
  ir-dce-falses (n) (i) (acc) =
   if i >= n then acc
   else ir-dce-falses n (i + 1) (list-push acc False)

  ir-dce-add-name : Text, OffsetTable, DceWork -> DceWork
  ir-dce-add-name (nm) (tbl) (w) =
   let j = offset-table-get tbl nm
   in if j < 0 then w
      else if list-at (w.visited) j then w
      else DceWork { visited = list-set-at (w.visited) j True, frontier = list-push (w.frontier) j }

  ir-dce-add-names : List Text, Integer, Integer, OffsetTable, DceWork -> DceWork
  ir-dce-add-names (names) (i) (len) (tbl) (w) =
   if i == len then w
   else ir-dce-add-names names (i + 1) len tbl (ir-dce-add-name (list-at names i) tbl w)

  ir-dce-flood : List IRDef, OffsetTable, Integer, DceWork -> DceWork
  ir-dce-flood (defs) (tbl) (i) (w) =
   if i >= list-length (w.frontier) then w
   else let cur = list-at (w.frontier) i
   in let names = ir-dce-collect-expr ((list-at defs cur).body) []
   in ir-dce-flood defs tbl (i + 1) (ir-dce-add-names names 0 (list-length names) tbl w)

  ir-dce-filter : List IRDef, List Boolean, Integer, Integer, List IRDef -> List IRDef
  ir-dce-filter (defs) (visited) (i) (len) (acc) =
   if i == len then acc
   else if list-at visited i then ir-dce-filter defs visited (i + 1) len (list-push acc (list-at defs i))
   else ir-dce-filter defs visited (i + 1) len acc

  ir-prune-unreachable : IRChapter, Text -> IRChapter
  ir-prune-unreachable (m) (root) = ir-prune-unreachable-roots m [root]

 The multi-root form. A root naming no definition is skipped rather than
 refused -- ir-dce-add-name already answers -1 for a name the index does
 not hold -- so a caller may offer a root that only some programs carry.
 The FIRST root is different: if it is absent the chapter comes back
 whole, because a chapter with no entry point is one we cannot reason
 about and must not prune. That is the rule the single-root form has
 always had, and the IR-text callers depend on it.

  ir-prune-unreachable-roots : IRChapter, List Text -> IRChapter
  ir-prune-unreachable-roots (m) (roots) =
   if list-length roots == 0 then m
   else ir-prune-roots-indexed m roots (ir-dce-build-index (m.defs) 0 (list-length (m.defs)) offset-table-empty)

  ir-prune-roots-indexed : IRChapter, List Text, OffsetTable -> IRChapter
  ir-prune-roots-indexed (m) (roots) (tbl) =
   if offset-table-get tbl (list-at roots 0) < 0 then m
   else ir-prune-roots-flood m roots tbl

  ir-prune-roots-flood : IRChapter, List Text, OffsetTable -> IRChapter
  ir-prune-roots-flood (m) (roots) (tbl) =
   let defs = m.defs
   in let n = list-length defs
   in let w0 = DceWork { visited = ir-dce-falses n 0 (__list-with-capacity n), frontier = [] }
   in let w = ir-dce-flood defs tbl 0 (ir-dce-add-names roots 0 (list-length roots) tbl w0)
   in __record-set m "defs" (ir-dce-filter defs (w.visited) 0 n [])

 This stores the filtered list back into the chapter it was given and
 hands back THE SAME record. Making it build a fresh chapter instead
 looks like the obvious correction -- a callee does not own a record its
 caller still holds -- and it is NOT a safe change: measured 2026-07-28,
 it makes `keep-proof-defs` collect from the unpruned list and every
 surviving definition gets appended back a second time by
 `ir-chapter-with-proofs`. A punctual function that survives the prune
 was emitted TWICE, at two addresses in the symbol map, and reported its
 WCET line twice. Callers that need the pre-prune list must bind it
 before calling, which is the same discipline `keep-proof-defs` above
 already follows and says so.

 A punctual definition that declares an EXPLICIT budget and does not
 survive the prune is a budget nothing checks. The instruction count is
 taken per emitted body (emit-all-defs), so a definition the inliner
 absorbed into its callers, or one nothing ever calls, reaches
 emit-wcet-check never and both CDX6010 and CDX6011 go silent. Measured
 against seed EFC7FCD0: a five-instruction body declaring a budget of two
 raises CDX6011 with the inliner off and nothing at all under the default
 pipeline, so the declared budget was unenforced in the shipping
 configuration and the author had no way to tell.

 Only an EXPLICIT budget is reported. A wcet-budget of zero means the
 author declared none and emit-wcet-check substitutes the default 256;
 that is not a claim anyone made, so a pruned punctual without a budget
 is ordinary dead code and says nothing.

 The walk takes two cursors rather than an index because ir-dce-filter
 preserves order, so the kept list is a subsequence of the original. That
 costs one pass and no allocation beyond the result. It assumes
 definition names are unique, which is no stronger an assumption than the
 prune already makes -- ir-dce-build-index keys the reachability table by
 the same name.

 It takes two def LISTS and not two chapters, and that is the whole
 correctness of it. ir-prune-roots-flood ends in `__record-set m "defs"`,
 which stores into the field and hands back THE SAME record, so the
 chapter a caller passed in and the chapter it got back are one object.
 Written to take chapters, this function compared the pruned list against
 itself, every name matched, and it reported nothing on a program whose
 budget was demonstrably being dropped. The caller must therefore bind
 the def list BEFORE calling the prune. The old list is safe to hold:
 ir-dce-filter builds a fresh one and `__record-set` only swaps the field.

 Do not try to fix that by making the prune functional instead. It was
 tried and it duplicates every surviving definition -- the note on
 ir-prune-roots-flood has the measurement.

  ir-dropped-budgeted-punctuals : List IRDef, List IRDef -> List IRDef
  ir-dropped-budgeted-punctuals (all-defs) (kept) =
   ir-dbp-loop all-defs kept 0 0 []

  ir-dbp-loop : List IRDef, List IRDef, Integer, Integer, List IRDef -> List IRDef
  ir-dbp-loop (all-defs) (kept) (i) (j) (acc) =
   if i == list-length all-defs then acc
   else let d = list-at all-defs i
   in if j < list-length kept
      then if (list-at kept j).name == d.name
           then ir-dbp-loop all-defs kept (i + 1) (j + 1) acc
           else ir-dbp-take all-defs kept i j acc d
      else ir-dbp-take all-defs kept i j acc d

 The arms are nested rather than joined with `&` so the bounds test
 guards the subscript by control flow. A conjunction would leave
 `list-at kept j` reachable at j equal to the length whenever the last
 definition in the chapter is the pruned one.

  ir-dbp-take : List IRDef, List IRDef, Integer, Integer, List IRDef, IRDef -> List IRDef
  ir-dbp-take (all-defs) (kept) (i) (j) (acc) (d) =
   if d.is-punctual
    then if d.wcet-budget > 0
         then ir-dbp-loop all-defs kept (i + 1) j (list-push acc d)
         else ir-dbp-loop all-defs kept (i + 1) j acc
    else ir-dbp-loop all-defs kept (i + 1) j acc

Section: IRDef Emission

 `unique-params` names the parameters declared `linear`. It is carried the
 whole length of the pipeline and consumed at x86 emit for noalias slots,
 and it was never printed, so linearity did not survive to this wire at
 all: `linear T` and `T` produced byte-identical IR text. It trails the
 form and is omitted when empty, so a def with no linear parameter keeps
 its exact previous spelling and a reader taking elements 1 through 7 is
 unaffected.

  ir-emit-unique : List Text -> Text
  ir-emit-unique (ns) =
   if list-length ns == 0 then ""
   else " (unique" & ir-cat (for n in ns -> " " & ir-quote n) & ")"

  ir-emit-def : IRDef -> Text
  ir-emit-def (d) =
   let punct = if d.is-punctual then "1" else "0"
   in "(def " & ir-quote (d.name) & " " & ir-quote (d.chapter-slug) & " (params" & ir-emit-params (d.params) 0 & ") " & ir-emit-type (d.type-val) & " " & ir-emit-expr (d.body) & " " & punct & " " & show (d.wcet-budget) & ir-emit-unique (d.unique-params) & ")"

  ir-emit-defs : List IRDef, Integer -> Text
  ir-emit-defs (xs) (i) =
   ir-cat (ir-emit-defs-acc xs i (list-length xs) [])

  ir-emit-defs-acc : List IRDef, Integer, Integer, List Text -> List Text
  ir-emit-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-defs-acc xs (i + 1) len (list-push acc ("\n  " & ir-emit-def (list-at xs i)))

Section: IRChapter Emission

 Top-level entry. Plug parsers expect a single (chapter ...) form on
 input. Strings list-fields use a "(strs ...)" wrapper for consistency.

  ir-emit-text-strs : List Text, Integer -> Text
  ir-emit-text-strs (xs) (i) =
   ir-cat (ir-strs-quoted xs i [])

  ir-emit-name-strs : List Name, Integer -> Text
  ir-emit-name-strs (xs) (i) =
   ir-cat (ir-names-quoted xs i [])

 Prose blocks and annotations ride the chapter header so that per-def
 prose survives the wire. A block prints as its anchor and its text;
 the classification is re-derivable from the text and is not sent. An
 annotation prints as kind, target, body. Plug parsers walk the header
 by form name and skip forms they do not ask for, therefore both forms
 are additive.

  ir-pblocks-quoted : List ProseBlock, Integer, List Text -> List Text
  ir-pblocks-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else let p = list-at xs i
   in ir-pblocks-quoted xs (i + 1) (list-push acc (" (pb " & ir-quote (p.anchor) & " " & ir-quote (p.text) & ")"))

  ir-emit-prose-blocks : List ProseBlock, Integer -> Text
  ir-emit-prose-blocks (xs) (i) =
   ir-cat (ir-pblocks-quoted xs i [])

  ir-anns-quoted : List AnnotationNode, Integer, List Text -> List Text
  ir-anns-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else let a = list-at xs i
   in ir-anns-quoted xs (i + 1) (list-push acc (" (ann " & ir-quote (a.kind) & " " & ir-quote (a.target) & " " & ir-quote (a.body) & ")"))

  ir-emit-annotations : List AnnotationNode, Integer -> Text
  ir-emit-annotations (xs) (i) =
   ir-cat (ir-anns-quoted xs i [])

  emit-ir-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-ir-chapter (m) (meta) (type-defs) =
   emit-ir-chapter-prefix m meta type-defs & ir-emit-defs (m.defs) 0 & "))\n"

 `grounds` publishes the chapter's grounds table, one "slug\neffect"
 entry per grounded effect, exactly as the type checker holds it. It is
 keyed like every other form in this header rather than positional, so a
 reader that does not look it up is unaffected; `ir-quote` escapes the
 separating newline and the parser's tokenizer restores it, so the entry
 crosses the wire unchanged. Unlike `unique` it is emitted even when
 empty, matching its siblings here, and an ungrounded chapter pays ten
 bytes for `(grounds)`.

 The chapter header up to and including the "(defs" opener -- everything
 except the per-def list and the closing "))". emit-ir-cce (opening)
 does not call emit-ir-chapter: building the whole chapter as one value
 exhausted the allocator on a wide-citation program (a 17-cite test hit
 the heap floor under the framebuffer at the same address at -MemMB
 3072 and 6144, measured 2026-07-28 -- with no collector every interior
 & of the expression walk is a permanent copy, ir-cat then duplicates
 the payload, and the top-level & copies it again). It uses the two
 helpers below instead: one pass to learn the SIZE the wire frame
 announces before the first payload byte, one pass to print, each def
 bracketed in __heap-save/__heap-restore so peak heap is the largest
 single def. Emission is pure, so the passes agree. emit-ir-uni still
 builds the monolith; it has no SIZE frame and no known large caller.

 The pieces go out through print-text, and only print-text: a payload
 newline is the CCE byte inside the Text, and print-line's appended
 terminator is the raw serial 10, which compile.ps1's byte slice would
 count against SIZE. Delegating the joiners to print-line was tried
 2026-07-28 and corrupted exactly those bytes; the account is in
 red-workplan's outbox. So every "\n  " joiner stays inside its piece,
 the footer keeps its own newline, and the one raw linefeed after the
 payload is print-line's, exactly as the monolith's print-line emitted
 it.

  ir-defs-wire-size : List IRDef, Integer, Integer, Integer -> Integer
  ir-defs-wire-size (xs) (i) (len) (acc) =
   if i == len then acc
   else let h = __heap-save
   in let n = text-length (ir-emit-def (list-at xs i))
   in let restored = __heap-restore h
   in ir-defs-wire-size xs (i + 1) len (acc + n + 3)

 The same walk with the name printed BEFORE the render and the size after, so a
 def that cannot be rendered at all is named by the last line that survives. It
 exists because "peak heap is the largest single def" above is a design
 statement with no instrument behind it: on the compiler's own source the
 whole-compiler `-IrCce` emit dies before `SIZE:` is printed, which puts the
 cost in this pass, and nothing said WHICH def. Reached with
 `compile.ps1 -IrCce -RawFlags "wsz"`.

 **It has its own flag rather than riding `debug`, and that is not tidiness.**
 Wired behind `debug` first, it printed nothing at all: `IR-CCE debug` empties
 the chapter. Measured 2026-08-04 on the compiler's own source, same kernel and
 same input, `IR-CCE` runs 28 s and dies OUT OF MEMORY while `IR-CCE debug`
 finishes in 5 s announcing `SIZE:130` with zero definitions -- and it does the
 same on `seed#587` and `seed#586`, so it long predates this instrument. An
 instrument gated on the flag that destroys its own subject measures nothing,
 which is what running it against the real input is for.

 Not folded into `ir-defs-wire-size`: that one is on the shipping path and pure,
 and giving it a Console effect to carry a diagnostic would put the effect row
 on every caller.

 Per-definition cost of the DCE name collection, which is where the
 whole-compiler `-IrCce` emit dies. Prints the name-occurrence count and the
 bytes the collection actually moved the frontier, each def bracketed so the
 probe itself cannot be what runs out.

 It was written to test a hypothesis that `list-push` copies and makes this
 quadratic, and it REFUTED it: 1.48 MB across all 5,201 definitions of the
 compiler's own source, largest 32,784 bytes, and the per-def figures are
 capacity-doubling rather than quadratic. The DCE collection is not a cost.
 Kept because that is worth being able to re-establish in one run.

 **Print through `print-line-uni`, never `print-text`.** `print-text` emits CCE,
 which is right for the payload and unreadable as ASCII in a raw capture: these
 three probes first shipped on `print-text` and 390 KB of trace read as an empty
 output, which cost a wrong published finding about where the emit dies.

  ir-trace-dce-cost : List IRDef, Integer, Integer -> [Console] Nothing
  ir-trace-dce-cost (xs) (i) (len) =
   if i >= len then print-line-uni "DCE-END"
   else let d = list-at xs i
   in act
    print-line-uni ("DCE " & integer-to-text i & " " & d.name)
    let h = __heap-save
    in let names = ir-dce-collect-expr (d.body) []
    in let k = list-length names
    in let after = __heap-save
    in let restored = __heap-restore h
    in act
     print-line-uni ("DCE-K " & integer-to-text k & " bytes " & integer-to-text (after - h))
     ir-trace-dce-cost xs (i + 1) len
    end
   end

  ir-trace-def-sizes : List IRDef, Integer, Integer -> [Console] Nothing
  ir-trace-def-sizes (xs) (i) (len) =
   if i >= len then print-line-uni "WSZ-END"
   else let d = list-at xs i
   in act
    print-line-uni ("WSZ " & integer-to-text i & " " & d.name)
    let h = __heap-save
    in let n = text-length (ir-emit-def d)
    in let restored = __heap-restore h
    in act
     print-line-uni ("WSZ-SIZE " & integer-to-text n)
     ir-trace-def-sizes xs (i + 1) len
    end
   end

  ir-print-defs : List IRDef, Integer, Integer -> [Console] Nothing
  ir-print-defs (xs) (i) (len) =
   if i == len then print-text "))\n"
   else let h = __heap-save
   in act
    print-text ("\n  " & ir-emit-def (list-at xs i))
    let restored = __heap-restore h
    in ir-print-defs xs (i + 1) len
   end

  emit-ir-chapter-prefix : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-ir-chapter-prefix (m) (meta) (type-defs) =
   "(chapter "
    & ir-quote (m.name.value) & "\n  "
    & "(title " & ir-quote (meta.chapter-title) & ")\n  "
    & "(prose " & ir-quote (meta.prose) & ")\n  "
    & "(pblocks" & ir-emit-prose-blocks (meta.prose-blocks) 0 & ")\n  "
    & "(anns" & ir-emit-annotations (meta.annotations) 0 & ")\n  "
    & "(sections" & ir-emit-text-strs (meta.section-titles) 0 & ")\n  "
    & "(ctors" & ir-emit-text-strs (meta.ctor-names) 0 & ")\n  "
    & "(eff-ops" & ir-emit-text-strs (m.effect-op-names) 0 & ")\n  "
    & "(grounds" & ir-emit-text-strs (meta.ground-effects) 0 & ")\n  "
    & "(type-defs" & ir-emit-atype-defs type-defs 0 & ")\n  "
    & "(defs"

