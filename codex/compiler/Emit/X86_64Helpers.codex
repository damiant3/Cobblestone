Chapter: X86-64 Code Generator

 Runtime helper state records, entry point, I/O boundary helpers,
 VMX, UEFI console, allocator, task scheduler, buffer helpers, and
 binary output. Process lifecycle in X86_64ProcessHelpers.codex;
 IPC and network in X86_64IPCHelpers.codex.
 helpers (CCE<->Unicode conversion, serial I/O), buffer helpers, and

 binary-output helpers. Text/number helpers live in

 X86_64TextHelpers.codex; list helpers in X86_64ListHelpers.codex.



Section: State Records

  StrEqHeadResult = record {

    cg : CodegenState,

    len-ne-pos : Integer between 0 and 4294967295

  }



  StrEqLoopResult = record {

    cg : CodegenState,

    loop-done-pos : Integer between 0 and 4294967295,

    byte-ne-pos : Integer between 0 and 4294967295

  }



  ItoaZeroResult = record {

    cg : CodegenState,

    skip-digits-pos : Integer between 0 and 4294967295

  }



  StrConcatCheckResult = record {

    cg : CodegenState,

    slow-path-pos : Integer between 0 and 4294967295

  }



  StrConcatFastResult = record {

    cg : CodegenState,

    fast-done-pos : Integer between 0 and 4294967295

  }



  HelpResult1 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295

  }



  HelpResult2 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295

  }



  HelpResult3 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295,

    p3 : Integer between 0 and 4294967295

  }



  HelpResult4 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295,

    p3 : Integer between 0 and 4294967295,

    p4 : Integer between 0 and 4294967295

  }



Section: Helpers Entry Point

Section: I/O Boundary Helpers



 emit-uart-poll-drain inlines the UART RX drain that the IRQ-4 handler

 in X86_64Boot performs on each interrupt. Brackets the LSR-read +

 ring-write critical section in CLI/STI so the ISR cannot race the

 polling read on the same write_pos slot. Saves and restores rcx;

 trashes rax, rdx, rsi, rdi.



  emit-uart-poll-drain : CodegenState -> CodegenState

  emit-uart-poll-drain (st) =

   let st0 = st-append-code st (push-r reg-rcx)

   in let stcli = st-append-code st0 cli

   in let st1 = st-append-code stcli (li reg-rdx 1021)

   in let st2 = st-append-code st1 in-al-dx

   in let st3 = st-append-code st2 (and-ri reg-rax 1)

   in let st4 = st-append-code st3 (test-rr reg-rax reg-rax)

   in let no-uart-data = st4.code-len

   in let st5 = st-append-code st4 (jcc cc-e 0)

   in let st6 = st-append-code st5 (li reg-rdx 1016)

   in let st7 = st-append-code st6 in-al-dx

   in let st8 = st-append-code st7 [72, 15, 182, 192]

   in let st9 = st-append-code st8 (li reg-rdi serial-write-pos-addr)

   in let st10 = st-append-code st9 (mov-load reg-rcx reg-rdi 0)

   in let st11 = st-append-code st10 (mov-rr reg-rsi reg-rcx)

   in let st12 = st-append-code st11 (and-ri reg-rsi serial-ring-buf-mask)

   in let st13 = st-append-code st12 (add-ri reg-rsi serial-ring-buf-addr)

   in let st14 = st-append-code st13 [136, 6]

   in let st15 = st-append-code st14 (add-ri reg-rcx 1)

   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)

   in let st17 = patch-jcc-at st16 no-uart-data (st16.code-len)

   in let ststi = st-append-code st17 sti

   in st-append-code ststi (pop-r reg-rcx)



  emit-cce-to-unicode-helper : CodegenState -> CodegenState

  emit-cce-to-unicode-helper (st) =

   let st1 = record-func-offset st "__cce_to_unicode"

   in let st2 = emit-load-rodata-addr st1 reg-rax cce-to-unicode-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret



  emit-unicode-to-cce-helper : CodegenState -> CodegenState

  emit-unicode-to-cce-helper (st) =

   let st1 = record-func-offset st "__unicode_to_cce"

   in let st2 = emit-load-rodata-addr st1 reg-rax unicode-to-cce-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret



  emit-read-line-helper : CodegenState -> CodegenState

  emit-read-line-helper (st) =

   let st1 = record-func-offset st "__read_line"

   in let st2 = st-append-code st1 (push-r reg-rbx)

   in let st3 = st-append-code st2 (push-r reg-r12)

   in let st4 = emit-load-rodata-addr st3 reg-r12 unicode-to-cce-rodata-offset

   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-r10)

   in let st6 = st-append-code st5 (li reg-rcx 0)

   in let read-byte = st6.code-len

   in let st7 = st-append-code st6 (push-r reg-rcx)

   in let wait-loop = st7.code-len

   in let st7a = st-append-code st7 (li reg-rax 0)

   in let st7b = st-append-code st7a (li reg-rdi wd-stale-tick-addr)

   in let st7c = st-append-code st7b (mov-store reg-rdi reg-rax 0)

   in let st-com2a = st-append-code st7c (li reg-rdx 765)

   in let st-com2b = st-append-code st-com2a [236]

   in let st-com2c = st-append-code st-com2b [168, 1]

   in let no-com2-pos = st-com2c.code-len

   in let st-com2d = st-append-code st-com2c (jcc cc-e 0)

   in let st-com2e = st-append-code st-com2d (li reg-rdx 760)

   in let st-com2f = st-append-code st-com2e [236]

   in let st-com2g = st-append-code st-com2f (li reg-rdi stdin-eof-flag-addr)

   in let st-com2h = st-append-code st-com2g (li reg-rax 1)

   in let st-com2i = st-append-code st-com2h (mov-store reg-rdi reg-rax 0)

   in let st-com2j = patch-jcc-at st-com2i no-com2-pos (st-com2i.code-len)

   in let st-drain = emit-uart-poll-drain st-com2j

   in let st8 = st-append-code st-drain (li reg-rdi serial-write-pos-addr)

   in let st9 = st-append-code st8 (mov-load reg-rsi reg-rdi 0)

   in let st10 = st-append-code st9 (li reg-rdi serial-read-pos-addr)

   in let st11 = st-append-code st10 (mov-load reg-r11 reg-rdi 0)

   in let st12 = st-append-code st11 (cmp-rr reg-rsi reg-r11)

   in let has-data = st12.code-len

   in let st13 = st-append-code st12 (jcc cc-ne 0)

   in let st-eof-a = st-append-code st13 (li reg-rdi stdin-eof-flag-addr)

   in let st-eof-b = st-append-code st-eof-a (mov-load reg-rax reg-rdi 0)

   in let st-eof-c = st-append-code st-eof-b (test-rr reg-rax reg-rax)

   in let no-eof-pos = st-eof-c.code-len

   in let st-eof-d = st-append-code st-eof-c (jcc cc-e 0)

   in let st-settle-a = st-append-code st-eof-d (li reg-rdi stdin-eof-settled-addr)

   in let st-settle-b = st-append-code st-settle-a (mov-load reg-rax reg-rdi 0)

   in let st-settle-c = st-append-code st-settle-b (cmp-ri reg-rax 64)

   in let return-none-pos = st-settle-c.code-len

   in let st-settle-d = st-append-code st-settle-c (jcc cc-ge 0)

   in let st-set-a = st-append-code st-settle-d (add-ri reg-rax 1)

   in let st-set-b = st-append-code st-set-a (mov-store reg-rdi reg-rax 0)

   in let st-eof-e = patch-jcc-at st-set-b no-eof-pos (st-set-b.code-len)

   in let st14 = st-append-code st-eof-e [243, 144]

   in let st15 = st-append-code st14 (jmp (wait-loop - (st14.code-len + 5)))

   in let st-rn = patch-jcc-at st15 return-none-pos (st15.code-len)

   in let st-none-a = st-append-code st-rn (pop-r reg-rcx)

   in let st-none-b = st-append-code st-none-a (mov-rr reg-rax reg-r10)

   in let st-none-c = st-append-code st-none-b (li reg-rdi 1)

   in let st-none-d = st-append-code st-none-c (mov-store reg-rax reg-rdi 0)

   in let st-none-e = st-append-code st-none-d (add-ri reg-r10 8)

   in let st-none-f = st-append-code st-none-e (pop-r reg-r12)

   in let st-none-g = st-append-code st-none-f (pop-r reg-rbx)

   in let st-none-h = st-append-code st-none-g x86-ret

   in let st16 = patch-jcc-at st-none-h has-data (st-none-h.code-len)

   in let st17 = st-append-code st16 (mov-rr reg-rax reg-r11)

   in let st18 = st-append-code st17 (and-ri reg-rax serial-ring-buf-mask)

   in let st19 = st-append-code st18 (add-ri reg-rax serial-ring-buf-addr)

   in let st20 = st-append-code st19 (movzx-byte reg-rax reg-rax 0)

   in let st21 = st-append-code st20 (add-ri reg-r11 1)

   in let st22 = st-append-code st21 (li reg-rdi serial-read-pos-addr)

   in let st23 = st-append-code st22 (mov-store reg-rdi reg-r11 0)

   in let st24 = st-append-code st23 (cmp-ri reg-rax 13)

   in let skip-cr = st24.code-len

   in let st25 = st-append-code st24 (jcc cc-e 0)

   in let st26 = st-append-code st25 (pop-r reg-rcx)

   in let st27 = st-append-code st26 (push-r reg-rcx)

   in let st28 = st-append-code st27 (mov-rr reg-rsi reg-rbx)

   in let st29 = st-append-code st28 (add-rr reg-rsi reg-rcx)

   in let st30 = st-append-code st29 (add-ri reg-rsi 8)

   in let st31 = st-append-code st30 [136, 6]

   in let st32 = st-append-code st31 (li reg-rax 1)

   in let st33 = patch-jcc-at st32 skip-cr wait-loop

   in let st34 = st-append-code st33 (pop-r reg-rcx)

   in let st35 = st-append-code st34 (test-rr reg-rax reg-rax)

   in let eof = st35.code-len

   in let st36 = st-append-code st35 (jcc cc-le 0)

   in let st37 = st-append-code st36 (mov-rr reg-rdx reg-rbx)

   in let st38 = st-append-code st37 (add-rr reg-rdx reg-rcx)

   in let st39 = st-append-code st38 (movzx-byte reg-rdx reg-rdx 8)

   in let st40 = st-append-code st39 (cmp-ri reg-rdx 10)

   in let got-nl = st40.code-len

   in let st41 = st-append-code st40 (jcc cc-e 0)

   in let st42 = st-append-code st41 (mov-rr reg-rsi reg-rbx)

   in let st43 = st-append-code st42 (add-rr reg-rsi reg-rcx)

   in let st44 = st-append-code st43 (add-ri reg-rsi 8)

   in let st45 = st-append-code st44 (movzx-byte reg-rax reg-rsi 0)

   in let st46 = st-append-code st45 (add-rr reg-rax reg-r12)

   in let st47 = st-append-code st46 (movzx-byte reg-rax reg-rax 0)

   in let st48 = st-append-code st47 [136, 6]

   in let st49 = st-append-code st48 (add-ri reg-rcx 1)

   in let st50 = st-append-code st49 (jmp (read-byte - (st49.code-len + 5)))

   in let st51 = patch-jcc-at st50 eof (st50.code-len)

   in let st52 = patch-jcc-at st51 got-nl (st51.code-len)

   in let st53 = st-append-code st52 (mov-store reg-rbx reg-rcx 0)

   in let st54 = st-append-code st53 (mov-rr reg-rax reg-rcx)

   in let st55 = st-append-code st54 (add-ri reg-rax 15)

   in let st56 = st-append-code st55 (and-ri reg-rax (-8))

   in let st57 = st-append-code st56 (add-rr reg-r10 reg-rax)

   in let st-just-a = st-append-code st57 (mov-rr reg-rax reg-r10)

   in let st-just-b = st-append-code st-just-a (li reg-rdi 0)

   in let st-just-c = st-append-code st-just-b (mov-store reg-rax reg-rdi 0)

   in let st-just-d = st-append-code st-just-c (mov-store reg-rax reg-rbx 8)

   in let st-just-e = st-append-code st-just-d (add-ri reg-r10 16)

   in let st59 = st-append-code st-just-e (pop-r reg-r12)

   in let st60 = st-append-code st59 (pop-r reg-rbx)

   in st-append-code st60 x86-ret



  emit-read-line-cce-helper : CodegenState -> CodegenState

  emit-read-line-cce-helper (st) =

   let st1 = record-func-offset st "__read_line_cce"

   in let st2 = st-append-code st1 (push-r reg-rbx)

   in let st5 = st-append-code st2 (mov-rr reg-rbx reg-r10)

   in let st6 = st-append-code st5 (li reg-rcx 0)

   in let read-byte = st6.code-len

   in let st7 = st-append-code st6 (push-r reg-rcx)

   in let wait-loop = st7.code-len

   in let st7a = st-append-code st7 (li reg-rax 0)

   in let st7b = st-append-code st7a (li reg-rdi wd-stale-tick-addr)

   in let st7c = st-append-code st7b (mov-store reg-rdi reg-rax 0)

   in let st-com2a = st-append-code st7c (li reg-rdx 765)

   in let st-com2b = st-append-code st-com2a [236]

   in let st-com2c = st-append-code st-com2b [168, 1]

   in let no-com2-pos = st-com2c.code-len

   in let st-com2d = st-append-code st-com2c (jcc cc-e 0)

   in let st-com2e = st-append-code st-com2d (li reg-rdx 760)

   in let st-com2f = st-append-code st-com2e [236]

   in let st-com2g = st-append-code st-com2f (li reg-rdi stdin-eof-flag-addr)

   in let st-com2h = st-append-code st-com2g (li reg-rax 1)

   in let st-com2i = st-append-code st-com2h (mov-store reg-rdi reg-rax 0)

   in let st-com2j = patch-jcc-at st-com2i no-com2-pos (st-com2i.code-len)

   in let st-drain = emit-uart-poll-drain st-com2j

   in let st8 = st-append-code st-drain (li reg-rdi serial-write-pos-addr)

   in let st9 = st-append-code st8 (mov-load reg-rsi reg-rdi 0)

   in let st10 = st-append-code st9 (li reg-rdi serial-read-pos-addr)

   in let st11 = st-append-code st10 (mov-load reg-r11 reg-rdi 0)

   in let st12 = st-append-code st11 (cmp-rr reg-rsi reg-r11)

   in let has-data = st12.code-len

   in let st13 = st-append-code st12 (jcc cc-ne 0)

   in let st-eof-a = st-append-code st13 (li reg-rdi stdin-eof-flag-addr)

   in let st-eof-b = st-append-code st-eof-a (mov-load reg-rax reg-rdi 0)

   in let st-eof-c = st-append-code st-eof-b (test-rr reg-rax reg-rax)

   in let no-eof-pos = st-eof-c.code-len

   in let st-eof-d = st-append-code st-eof-c (jcc cc-e 0)

   in let st-settle-a = st-append-code st-eof-d (li reg-rdi stdin-eof-settled-addr)

   in let st-settle-b = st-append-code st-settle-a (mov-load reg-rax reg-rdi 0)

   in let st-settle-c = st-append-code st-settle-b (cmp-ri reg-rax 64)

   in let return-none-pos = st-settle-c.code-len

   in let st-settle-d = st-append-code st-settle-c (jcc cc-ge 0)

   in let st-set-a = st-append-code st-settle-d (add-ri reg-rax 1)

   in let st-set-b = st-append-code st-set-a (mov-store reg-rdi reg-rax 0)

   in let st-eof-e = patch-jcc-at st-set-b no-eof-pos (st-set-b.code-len)

   in let st14 = st-append-code st-eof-e [243, 144]

   in let st15 = st-append-code st14 (jmp (wait-loop - (st14.code-len + 5)))

   in let st-rn = patch-jcc-at st15 return-none-pos (st15.code-len)

   in let st-none-a = st-append-code st-rn (pop-r reg-rcx)

   in let st-none-b = st-append-code st-none-a (mov-rr reg-rax reg-r10)

   in let st-none-c = st-append-code st-none-b (li reg-rdi 1)

   in let st-none-d = st-append-code st-none-c (mov-store reg-rax reg-rdi 0)

   in let st-none-e = st-append-code st-none-d (add-ri reg-r10 8)

   in let st-none-f = st-append-code st-none-e (pop-r reg-rbx)

   in let st-none-g = st-append-code st-none-f x86-ret

   in let st16 = patch-jcc-at st-none-g has-data (st-none-g.code-len)

   in let st17 = st-append-code st16 (mov-rr reg-rax reg-r11)

   in let st18 = st-append-code st17 (and-ri reg-rax serial-ring-buf-mask)

   in let st19 = st-append-code st18 (add-ri reg-rax serial-ring-buf-addr)

   in let st20 = st-append-code st19 (movzx-byte reg-rax reg-rax 0)

   in let st21 = st-append-code st20 (add-ri reg-r11 1)

   in let st22 = st-append-code st21 (li reg-rdi serial-read-pos-addr)

   in let st23 = st-append-code st22 (mov-store reg-rdi reg-r11 0)

   in let st26 = st-append-code st23 (pop-r reg-rcx)

   in let st27 = st-append-code st26 (push-r reg-rcx)

   in let st28 = st-append-code st27 (mov-rr reg-rsi reg-rbx)

   in let st29 = st-append-code st28 (add-rr reg-rsi reg-rcx)

   in let st30 = st-append-code st29 (add-ri reg-rsi 8)

   in let st31 = st-append-code st30 [136, 6]

   in let st32 = st-append-code st31 (li reg-rax 1)

   in let st34 = st-append-code st32 (pop-r reg-rcx)

   in let st35 = st-append-code st34 (test-rr reg-rax reg-rax)

   in let eof = st35.code-len

   in let st36 = st-append-code st35 (jcc cc-le 0)

   in let st37 = st-append-code st36 (mov-rr reg-rdx reg-rbx)

   in let st38 = st-append-code st37 (add-rr reg-rdx reg-rcx)

   in let st39 = st-append-code st38 (movzx-byte reg-rdx reg-rdx 8)

   in let st40 = st-append-code st39 (cmp-ri reg-rdx 1)

   in let got-nl = st40.code-len

   in let st41 = st-append-code st40 (jcc cc-e 0)

   in let st44 = st-append-code st41 (add-ri reg-rcx 1)

   in let st50 = st-append-code st44 (jmp (read-byte - (st44.code-len + 5)))

   in let st51 = patch-jcc-at st50 eof (st50.code-len)

   in let st52 = patch-jcc-at st51 got-nl (st51.code-len)

   in let st53 = st-append-code st52 (mov-store reg-rbx reg-rcx 0)

   in let st54 = st-append-code st53 (mov-rr reg-rax reg-rcx)

   in let st55 = st-append-code st54 (add-ri reg-rax 15)

   in let st56 = st-append-code st55 (and-ri reg-rax (-8))

   in let st57 = st-append-code st56 (add-rr reg-r10 reg-rax)

   in let st-just-a = st-append-code st57 (mov-rr reg-rax reg-r10)

   in let st-just-b = st-append-code st-just-a (li reg-rdi 0)

   in let st-just-c = st-append-code st-just-b (mov-store reg-rax reg-rdi 0)

   in let st-just-d = st-append-code st-just-c (mov-store reg-rax reg-rbx 8)

   in let st-just-e = st-append-code st-just-d (add-ri reg-r10 16)

   in let st59 = st-append-code st-just-e (pop-r reg-rbx)

   in st-append-code st59 x86-ret

  emit-read-file-helper : CodegenState -> CodegenState

  emit-read-file-helper (st) =

   let st1 = record-func-offset st "__read_file"

   in let st2 = emit-call-to st1 "__bare_metal_read_serial"

   in st-append-code st2 x86-ret



  emit-bare-metal-read-serial : CodegenState -> CodegenState

  emit-bare-metal-read-serial (st) =

   let st1 = record-func-offset st "__bare_metal_read_serial"

   in let st2 = st-append-code st1 (push-r reg-rbx)

   in let st3 = st-append-code st2 (push-r reg-rcx)

   in let st3a = st-append-code st3 (push-r reg-r12)

   in let st4 = emit-load-rodata-addr st3a reg-r12 unicode-to-cce-rodata-offset

   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-r10)

   in let st6 = st-append-code st5 (li reg-rcx 0)

   in let read-loop = st6.code-len

   in let wait-loop = st6.code-len

   in let st6a = st-append-code st6 (li reg-rax 0)

   in let st6b = st-append-code st6a (li reg-rdi wd-stale-tick-addr)

   in let st6c = st-append-code st6b (mov-store reg-rdi reg-rax 0)

   in let st7 = st-append-code st6c (li reg-rdi serial-write-pos-addr)

   in let st8 = st-append-code st7 (mov-load reg-rsi reg-rdi 0)

   in let st9 = st-append-code st8 (li reg-rdi serial-read-pos-addr)

   in let st10 = st-append-code st9 (mov-load reg-r11 reg-rdi 0)

   in let st11 = st-append-code st10 (cmp-rr reg-rsi reg-r11)

   in let has-data = st11.code-len

   in let st12 = st-append-code st11 (jcc cc-ne 0)

   in let st12a = emit-uart-poll-drain st12

   in let st13 = st-append-code st12a hlt

   in let st14 = st-append-code st13 (jmp (wait-loop - (st13.code-len + 5)))

   in let st15 = patch-jcc-at st14 has-data (st14.code-len)

   in let st16 = st-append-code st15 (mov-rr reg-rax reg-r11)

   in let st17 = st-append-code st16 (and-ri reg-rax serial-ring-buf-mask)

   in let st18 = st-append-code st17 (add-ri reg-rax serial-ring-buf-addr)

   in let st19 = st-append-code st18 (movzx-byte reg-rax reg-rax 0)

   in let st20 = st-append-code st19 (add-ri reg-r11 1)

   in let st21 = st-append-code st20 (li reg-rdi serial-read-pos-addr)

   in let st22 = st-append-code st21 (mov-store reg-rdi reg-r11 0)

   in let st23 = st-append-code st22 (cmp-ri reg-rax 4)

