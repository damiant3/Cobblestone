Section: I/O Boundary Helpers

  emit-uart-poll-drain : CodegenState -> CodegenState

  emit-uart-poll-drain (st) =

   let st0 = st-append-code st (push-r reg-rcx)

   in let stcli = st-append-code st0 cli

   in let st1 = st-append-code stcli (li reg-rdx 1021)

   in let st2 = st-append-code st1 in-al-dx

   in let st3 = st-append-code st2 (and-ri reg-rax 1)

   in let st4 = st-append-code st3 (test-rr reg-rax reg-rax)

   in let no-uart-data = st4.code-len

   in let st5 = st-append-code st4 (jcc cc-e 0)

   in let st6 = st-append-code st5 (li reg-rdx 1016)

   in let st7 = st-append-code st6 in-al-dx

   in let st8 = st-append-code st7 [72, 15, 182, 192]

   in let st9 = st-append-code st8 (li reg-rdi serial-write-pos-addr)

   in let st10 = st-append-code st9 (mov-load reg-rcx reg-rdi 0)

   in let st11 = st-append-code st10 (mov-rr reg-rsi reg-rcx)

   in let st12 = st-append-code st11 (and-ri reg-rsi serial-ring-buf-mask)

   in let st13 = st-append-code st12 (add-ri reg-rsi serial-ring-buf-addr)

   in let st14 = st-append-code st13 [136, 6]

   in let st15 = st-append-code st14 (add-ri reg-rcx 1)

   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)

   in let st17 = patch-jcc-at st16 no-uart-data (st16.code-len)

   in let ststi = st-append-code st17 sti

   in st-append-code ststi (pop-r reg-rcx)

  emit-cce-to-unicode-helper : CodegenState -> CodegenState

  emit-cce-to-unicode-helper (st) =

   let st1 = record-func-offset st "__cce_to_unicode"

   in let st2 = emit-load-rodata-addr st1 reg-rax cce-to-unicode-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret

  emit-unicode-to-cce-helper : CodegenState -> CodegenState

  emit-unicode-to-cce-helper (st) =

   let st1 = record-func-offset st "__unicode_to_cce"

   in let st2 = emit-load-rodata-addr st1 reg-rax unicode-to-cce-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret

  emit-unicode-to-cce-tier1-helper : CodegenState -> CodegenState
  emit-unicode-to-cce-tier1-helper (st) =
   let st0 = record-func-offset st "__unicode_to_cce_tier1"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = emit-load-rodata-addr st1 reg-rax tier1-block-rodata-offset
   in let st3 = st-append-code st2 (mov-rr reg-rbx reg-rax)
   in let st4 = st-append-code st3 (li reg-rcx 0)
   in let search-top = st4.code-len
   in let st5 = st-append-code st4 (cmp-ri reg-rcx 16)
   in let notfound-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mov-rr reg-rax reg-rbx)
   in let st8 = st-append-code st7 (add-rr reg-rax reg-rcx)
   in let st9 = st-append-code st8 (movzx-byte reg-rsi reg-rax 0)
   in let st10 = st-append-code st9 (movzx-byte reg-rax reg-rax 16)
   in let st11 = st-append-code st10 (shl-ri reg-rax 8)
   in let st12 = st-append-code st11 (add-rr reg-rsi reg-rax)
   in let st13 = st-append-code st12 (cmp-rr reg-rdi reg-rsi)
   in let next-pos = st13.code-len
   in let st14 = st-append-code st13 (jcc cc-l 0)
   in let st15 = st-append-code st14 (mov-rr reg-rax reg-rdi)
   in let st16 = st-append-code st15 (sub-rr reg-rax reg-rsi)
   in let st17 = st-append-code st16 (cmp-ri reg-rax 128)
   in let next2-pos = st17.code-len
   in let st18 = st-append-code st17 (jcc cc-ge 0)
   in let st19 = st-append-code st18 (shl-ri reg-rcx 7)
   in let st20 = st-append-code st19 (add-rr reg-rax reg-rcx)
   in let st21 = st-append-code st20 (pop-r reg-rbx)
   in let st22 = st-append-code st21 x86-ret
   in let st23 = patch-jcc-at st22 next-pos (st22.code-len)
   in let st24 = patch-jcc-at st23 next2-pos (st23.code-len)
   in let st25 = st-append-code st24 (add-ri reg-rcx 1)
   in let st26 = st-append-code st25 (jmp (search-top - (st25.code-len + 5)))
   in let st27 = patch-jcc-at st26 notfound-pos (st26.code-len)
   in let st28 = st-append-code st27 (li reg-rax 0)
   in let st29 = st-append-code st28 (pop-r reg-rbx)
   in st-append-code st29 x86-ret

  emit-cce-decode-unicode-helper : CodegenState -> CodegenState
  emit-cce-decode-unicode-helper (st) =
   let st-pre = emit-unicode-to-cce-tier1-helper st
   in let st0 = record-func-offset st-pre "__cce_decode_unicode"
   in let st1 = st-append-code st0 (lea reg-rax (reg-rdi) 8)
   in let st2 = st-append-code st1 (add-rr reg-rax reg-rsi)
   in let st3 = st-append-code st2 (movzx-byte reg-rcx reg-rax 0)
   in let st4 = st-append-code st3 (movzx-byte reg-rsi reg-rax 1)
   in let st5 = st-append-code st4 (and-ri reg-rcx 31)
   in let st6 = st-append-code st5 (shl-ri reg-rcx 6)
   in let st7 = st-append-code st6 (and-ri reg-rsi 63)
   in let st8 = st-append-code st7 (add-rr reg-rcx reg-rsi)
   in let st9 = st-append-code st8 (mov-rr reg-rsi reg-rcx)
   in let st10 = st-append-code st9 (shr-ri reg-rsi 7)
   in let st11 = emit-load-rodata-addr st10 reg-rax tier1-block-rodata-offset
   in let st12 = st-append-code st11 (add-rr reg-rax reg-rsi)
   in let st13 = st-append-code st12 (movzx-byte reg-rdi reg-rax 0)
   in let st14 = emit-load-rodata-addr st13 reg-rax (tier1-block-rodata-offset + 16)
   in let st15 = st-append-code st14 (add-rr reg-rax reg-rsi)
   in let st16 = st-append-code st15 (movzx-byte reg-rax reg-rax 0)
   in let st17 = st-append-code st16 (shl-ri reg-rax 8)
   in let st18 = st-append-code st17 (add-rr reg-rdi reg-rax)
   in let st19 = st-append-code st18 (and-ri reg-rcx 127)
   in let st20 = st-append-code st19 (mov-rr reg-rax reg-rdi)
   in let st21 = st-append-code st20 (add-rr reg-rax reg-rcx)
   in st-append-code st21 x86-ret

