   in let st6 = st-append-code st5 (add-rr reg-rbx reg-rsi)

   in let st7 = st-append-code st6 (mov-rr reg-rcx reg-rdx)

   in let st8 = st-append-code st7 (xor-rr reg-rax reg-rax)

   in let st9 = st-append-code st8 (li reg-rdx 1297)

   in let st10 = st-append-code st9 in-al-dx

   in let st11 = st-append-code st10 (cmp-ri reg-rax 183)

   in let legacy-pos = st11.code-len

   in let st12 = st-append-code st11 (jcc cc-ne 0)

   in let st13 = st-append-code st12 (li reg-rdi 36160)

   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rbx 0)

   in let st15 = st-append-code st14 (li reg-rdi 36168)

   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)

   in let st17 = st-append-code st16 (li reg-rax 3)

   in let st18 = st-append-code st17 (li reg-rdx 1296)

   in let st19 = st-append-code st18 out-dx-al

   in let blit-done-pos = st19.code-len

   in let st20 = st-append-code st19 (jmp 0)

   in let st21 = patch-jcc-at st20 legacy-pos (st20.code-len)

   in let st22 = st-append-code st21 (li reg-r11 0)

   in let loop-top = st22.code-len

   in let st23 = st-append-code st22 (li reg-rax 0)

   in let st24 = st-append-code st23 (li reg-rdi wd-stale-tick-addr)

   in let st25 = st-append-code st24 (mov-store reg-rdi reg-rax 0)

   in let st26 = st-append-code st25 (cmp-rr reg-r11 reg-rcx)

   in let done-pos = st26.code-len

   in let st27 = st-append-code st26 (jcc cc-ge 0)

   in let st28 = st-append-code st27 (mov-rr reg-rax reg-rbx)

   in let st29 = st-append-code st28 (add-rr reg-rax reg-r11)

   in let st30 = st-append-code st29 (movzx-byte reg-rax reg-rax 0)

   in let st31 = st-append-code st30 (push-r reg-rax)

   in let wait-top = st31.code-len

   in let st32 = st-append-code st31 (li reg-rdx 1021)

   in let st33 = st-append-code st32 [236]

