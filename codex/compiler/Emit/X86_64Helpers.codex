   in let st29a = st-append-code st29 (cmp-ri reg-rax 2048)
   in let t1-3b-pos = st29a.code-len
   in let st29b = st-append-code st29a (jcc cc-ge 0)
   in let st30 = st-append-code st29b (mov-rr reg-rbx reg-rax)
   in let st31 = st-append-code st30 (shr-ri reg-rax 6)
   in let st32 = st-append-code st31 (or-ri reg-rax 192)
   in let st35 = emit-call-to st32 "__serial_put"
   in let st36 = st-append-code st35 (mov-rr reg-rax reg-rbx)
   in let st37 = st-append-code st36 (and-ri reg-rax 63)
   in let st38 = st-append-code st37 (or-ri reg-rax 128)
   in let st41 = emit-call-to st38 "__serial_put"
