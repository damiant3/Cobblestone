   in let st8 = st-append-code st7 (jcc cc-ge 0)

   in let st9 = st-append-code st8 (push-r reg-rcx)

   in let st10 = st-append-code st9 (lea reg-rax reg-r12 8)

   in let st11 = st-append-code st10 (add-rr reg-rax reg-rcx)

   in let st12 = st-append-code st11 (movzx-byte reg-rax reg-rax 0)

   in let st13 = st-append-code st12 (add-rr reg-rax reg-r14)

   in let st14 = st-append-code st13 (movzx-byte reg-rax reg-rax 0)

   in let st15 = st-append-code st14 (pop-r reg-rcx)

   in let st16 = st-append-code st15 (mov-rr reg-r11 reg-rcx)

   in let st17 = st-append-code st16 (shl-ri reg-r11 1)

   in let st18 = st-append-code st17 (add-rr reg-r11 reg-rsp)

   in let st19 = st-append-code st18 (mov-store-word reg-r11 reg-rax 0)

   in let st20 = st-append-code st19 (add-ri reg-rcx 1)

   in let st21 = st-append-code st20 (jmp (loop-top - (st20.code-len + 5)))

   in let st22 = patch-jcc-at st21 done-pos (st21.code-len)

   in let st23 = st-append-code st22 (mov-rr reg-r11 reg-r13)

   in let st24 = st-append-code st23 (shl-ri reg-r11 1)

   in let st25 = st-append-code st24 (add-rr reg-r11 reg-rsp)

   in let st26 = st-append-code st25 (li reg-rax 13)

   in let st27 = st-append-code st26 (mov-store-word reg-r11 reg-rax 0)

   in let st28 = st-append-code st27 (add-ri reg-r11 2)

   in let st29 = st-append-code st28 (li reg-rax 10)

   in let st30 = st-append-code st29 (mov-store-word reg-r11 reg-rax 0)

   in let st31 = st-append-code st30 (add-ri reg-r11 2)

