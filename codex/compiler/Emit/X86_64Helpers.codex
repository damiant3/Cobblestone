  emit-alloc-helper : CodegenState -> CodegenState

  emit-alloc-helper (st) =

   let st1 = record-func-offset st "__alloc"

   in let st2 = st-append-code st1 (mov-rr reg-rax reg-r10 & add-rr reg-r10 reg-rdi)
   in let st-tr = if st.trace-alloc then emit-alloc-trace st2 else st2
   in let st3 = st-append-code st-tr (push-r reg-rcx & push-r reg-rax)
   in let st4 = st-append-code st3 (mov-rr reg-rcx reg-rdi & mov-rr reg-rdi reg-rax)
   in let fill = if st.poison-alloc then li reg-rax 205 else xor-rr reg-rax reg-rax
   in let st5 = st-append-code st4 (fill & cld & rep-stosb)
   in st-append-code st5 (pop-r reg-rax & pop-r reg-rcx & x86-ret)

  emit-alloc-trace : CodegenState -> CodegenState
  emit-alloc-trace (st) =
   let st0 = st-append-code st (push-r reg-r11)
   in let st1 = st-append-code st0 (li reg-r11 trace-enabled-addr)
   in let st2 = st-append-code st1 (mov-load reg-r11 reg-r11 0)
   in let st3 = st-append-code st2 (test-rr reg-r11 reg-r11)
   in let skip-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let st5 = st-append-code st4 (push-r reg-rcx & push-r reg-rdx)
   in let st6 = st-append-code st5 (li reg-r11 trace-cursor-addr)
   in let st7 = st-append-code st6 (mov-load reg-rcx reg-r11 0)
   in let st8 = st-append-code st7 (cmp-ri reg-rcx trace-max-entries)
   in let full-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ge 0)
   in let st10 = st-append-code st9 (mov-rr reg-rdx reg-rcx)
   in let st11 = st-append-code st10 (shl-ri reg-rdx 4)
   in let st12 = st-append-code st11 (li reg-r11 trace-buf-addr)
   in let st13 = st-append-code st12 (add-rr reg-r11 reg-rdx)
   in let st14 = st-append-code st13 (mov-store reg-r11 reg-rdi 0)
   in let st15 = st-append-code st14 (mov-load reg-rdx reg-rsp 24)
   in let st16 = st-append-code st15 (mov-store reg-r11 reg-rdx 8)
   in let st17 = st-append-code st16 (add-ri reg-rcx 1)
   in let st18 = st-append-code st17 (li reg-r11 trace-cursor-addr)
   in let st19 = st-append-code st18 (mov-store reg-r11 reg-rcx 0)
   in let st20 = patch-jcc-at st19 full-pos (st19.code-len)
   in let st21 = st-append-code st20 (pop-r reg-rdx & pop-r reg-rcx)
   in let st22 = patch-jcc-at st21 skip-pos (st21.code-len)
   in st-append-code st22 (pop-r reg-r11)



