   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 [

     85, 72, 137, 229,

     65, 84, 65, 85, 65, 86, 65, 87,

     72, 137, 230,

     191, 22, 108, 0, 0,

     15, 121, 254,

     72, 141, 5, 21, 0, 0, 0,

     72, 137, 198,

     191, 24, 108, 0, 0,

     15, 121, 254,

     15, 1, 195,

     184, 1, 0, 0, 0,

     235, 5,

     184, 0, 0, 0, 0,

     65, 95, 65, 94, 65, 93, 65, 92,

     93, 195

   ]

   in st1

