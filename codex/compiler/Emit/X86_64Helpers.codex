   let st0 = record-func-offset st "uefi-set-attr"

   in let st1 = st-append-code st0 (push-r reg-rbp & mov-rr reg-rbp reg-rsp)

   in let st2 = st-append-code st1 (mov-rr reg-r8 reg-rdi)

   in let st3 = st-append-code st2 uefi-load-conout

   in let st4 = st-append-code st3 (mov-rr reg-rdx reg-r8)

   in let st5 = st-append-code st4 (uefi-call-conout 40)

   in let st6 = st-append-code st5 (pop-r reg-rbp)

   in st-append-code st6 x86-ret

