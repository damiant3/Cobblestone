   in let st7b = st-append-code st7a (li reg-rdi wd-stale-tick-addr)

   in let st7c = st-append-code st7b (mov-store reg-rdi reg-rax 0)

   in let st8 = st-append-code st7c (cmp-rr reg-r11 reg-rcx)

   in let done-pos = st8.code-len

   in let st9 = st-append-code st8 (jcc cc-ge 0)

   in let st10 = st-append-code st9 (mov-rr reg-rax reg-r11)

   in let st11 = st-append-code st10 (shl-ri reg-rax 3)

   in let st12 = st-append-code st11 (add-rr reg-rax reg-rbx)

   in let st13 = st-append-code st12 (mov-load reg-rax reg-rax 8)

   in let st14 = st-append-code st13 (push-r reg-rax)

   in let wait-top = st14.code-len

   in let st15 = st-append-code st14 (li reg-rdx 1021)

   in let st16 = st-append-code st15 [236]

   in let st17 = st-append-code st16 [168, 32]

   in let thr-ready = st17.code-len

   in let st18 = st-append-code st17 (jcc cc-ne 0)

   in let st19 = st-append-code st18 (jmp (wait-top - (st18.code-len + 5)))

   in let st20 = patch-jcc-at st19 thr-ready (st19.code-len)

   in let st21 = st-append-code st20 (pop-r reg-rax)

   in let st22 = st-append-code st21 (li reg-rdx 1016)

   in let st23 = st-append-code st22 out-dx-al

   in let st24 = st-append-code st23 (add-ri reg-r11 1)

   in let st25 = st-append-code st24 (jmp (loop-top - (st24.code-len + 5)))

   in let st26 = patch-jcc-at st25 done-pos (st25.code-len)

   in let st27 = st-append-code st26 (pop-r reg-r11)

   in let st28 = st-append-code st27 (pop-r reg-rcx)

   in let st29 = st-append-code st28 (pop-r reg-rbx)

   in st-append-code st29 x86-ret

 Flat-buffer variant: rdi = buffer address, rsi = offset, rdx = length.
 Probes port 1297 (0x511) for the codex-vm bulk blit; on the magic
 answer 183 (0xB7) the guest stores address and length into the fixed
 cells 36160 and 36168 and rings doorbell 1296 (0x510) with command 3,
 so the whole buffer leaves in one VM exit. Anywhere else (older VM,
 real hardware) the port floats 255 and the per-byte UART loop below
 runs instead, identical to __write_binary minus the list boxing.

  emit-write-binary-buf-helper : CodegenState -> CodegenState

  emit-write-binary-buf-helper (st) =

   let st1 = record-func-offset st "__write_binary_buf"

   in let st2 = st-append-code st1 (push-r reg-rbx)

