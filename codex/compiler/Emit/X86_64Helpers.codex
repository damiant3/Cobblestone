Chapter: X86-64 Code Generator

 Runtime helper state records, entry point, I/O boundary helpers,
 VMX, UEFI console, allocator, task scheduler, buffer helpers, and
 binary output. Process lifecycle in X86_64ProcessHelpers.codex;
 IPC and network in X86_64IPCHelpers.codex.
 helpers (CCE<->Unicode conversion, serial I/O), buffer helpers, and

 binary-output helpers. Text/number helpers live in

 X86_64TextHelpers.codex; list helpers in X86_64ListHelpers.codex.



Section: State Records

  StrEqHeadResult = record {

    cg : CodegenState,

    len-ne-pos : Integer between 0 and 4294967295

  }



  StrEqLoopResult = record {

    cg : CodegenState,

    loop-done-pos : Integer between 0 and 4294967295,

    byte-ne-pos : Integer between 0 and 4294967295

  }



  ItoaZeroResult = record {

    cg : CodegenState,

    skip-digits-pos : Integer between 0 and 4294967295

  }



  StrConcatCheckResult = record {

    cg : CodegenState,

    slow-path-pos : Integer between 0 and 4294967295

  }



  StrConcatFastResult = record {

    cg : CodegenState,

    fast-done-pos : Integer between 0 and 4294967295

  }



  HelpResult1 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295

  }



  HelpResult2 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295

  }



  HelpResult3 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295,

    p3 : Integer between 0 and 4294967295

  }



  HelpResult4 = record {

    cg : CodegenState,

    p1 : Integer between 0 and 4294967295,

    p2 : Integer between 0 and 4294967295,

    p3 : Integer between 0 and 4294967295,

    p4 : Integer between 0 and 4294967295

  }



Section: Helpers Entry Point

Section: I/O Boundary Helpers



 emit-uart-poll-drain inlines the UART RX drain that the IRQ-4 handler

 in X86_64Boot performs on each interrupt. Brackets the LSR-read +

 ring-write critical section in CLI/STI so the ISR cannot race the

 polling read on the same write_pos slot. Saves and restores rcx;

 trashes rax, rdx, rsi, rdi.



  emit-uart-poll-drain : CodegenState -> CodegenState

  emit-uart-poll-drain (st) =

   let st0 = st-append-code st (push-r reg-rcx)

   in let stcli = st-append-code st0 cli

   in let st1 = st-append-code stcli (li reg-rdx 1021)

   in let st2 = st-append-code st1 in-al-dx

   in let st3 = st-append-code st2 (and-ri reg-rax 1)

   in let st4 = st-append-code st3 (test-rr reg-rax reg-rax)

   in let no-uart-data = st4.code-len

   in let st5 = st-append-code st4 (jcc cc-e 0)

   in let st6 = st-append-code st5 (li reg-rdx 1016)

   in let st7 = st-append-code st6 in-al-dx

   in let st8 = st-append-code st7 [72, 15, 182, 192]

   in let st9 = st-append-code st8 (li reg-rdi serial-write-pos-addr)

   in let st10 = st-append-code st9 (mov-load reg-rcx reg-rdi 0)

   in let st11 = st-append-code st10 (mov-rr reg-rsi reg-rcx)

   in let st12 = st-append-code st11 (and-ri reg-rsi serial-ring-buf-mask)

   in let st13 = st-append-code st12 (add-ri reg-rsi serial-ring-buf-addr)

   in let st14 = st-append-code st13 [136, 6]

   in let st15 = st-append-code st14 (add-ri reg-rcx 1)

   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)

   in let st17 = patch-jcc-at st16 no-uart-data (st16.code-len)

   in let ststi = st-append-code st17 sti

   in st-append-code ststi (pop-r reg-rcx)



  emit-cce-to-unicode-helper : CodegenState -> CodegenState

  emit-cce-to-unicode-helper (st) =

   let st1 = record-func-offset st "__cce_to_unicode"

   in let st2 = emit-load-rodata-addr st1 reg-rax cce-to-unicode-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret



  emit-unicode-to-cce-helper : CodegenState -> CodegenState

  emit-unicode-to-cce-helper (st) =

   let st1 = record-func-offset st "__unicode_to_cce"

   in let st2 = emit-load-rodata-addr st1 reg-rax unicode-to-cce-rodata-offset

   in let st3 = st-append-code st2 (add-rr reg-rax reg-rdi)

   in let st4 = st-append-code st3 (movzx-byte reg-rax reg-rax 0)

   in st-append-code st4 x86-ret

  emit-unicode-to-cce-tier1-helper : CodegenState -> CodegenState
  emit-unicode-to-cce-tier1-helper (st) =
   let st0 = record-func-offset st "__unicode_to_cce_tier1"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = emit-load-rodata-addr st1 reg-rax tier1-block-rodata-offset
   in let st3 = st-append-code st2 (mov-rr reg-rbx reg-rax)
   in let st4 = st-append-code st3 (li reg-rcx 0)
   in let search-top = st4.code-len
   in let st5 = st-append-code st4 (cmp-ri reg-rcx 16)
   in let notfound-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mov-rr reg-rax reg-rbx)
   in let st8 = st-append-code st7 (add-rr reg-rax reg-rcx)
   in let st9 = st-append-code st8 (movzx-byte reg-rsi reg-rax 0)
   in let st10 = st-append-code st9 (movzx-byte reg-rax reg-rax 16)
   in let st11 = st-append-code st10 (shl-ri reg-rax 8)
   in let st12 = st-append-code st11 (add-rr reg-rsi reg-rax)
   in let st13 = st-append-code st12 (cmp-rr reg-rdi reg-rsi)
   in let next-pos = st13.code-len
   in let st14 = st-append-code st13 (jcc cc-l 0)
   in let st15 = st-append-code st14 (mov-rr reg-rax reg-rdi)
   in let st16 = st-append-code st15 (sub-rr reg-rax reg-rsi)
   in let st17 = st-append-code st16 (cmp-ri reg-rax 128)
   in let next2-pos = st17.code-len
   in let st18 = st-append-code st17 (jcc cc-ge 0)
   in let st19 = st-append-code st18 (shl-ri reg-rcx 7)
   in let st20 = st-append-code st19 (add-rr reg-rax reg-rcx)
   in let st21 = st-append-code st20 (pop-r reg-rbx)
   in let st22 = st-append-code st21 x86-ret
   in let st23 = patch-jcc-at st22 next-pos (st22.code-len)
   in let st24 = patch-jcc-at st23 next2-pos (st23.code-len)
   in let st25 = st-append-code st24 (add-ri reg-rcx 1)
   in let st26 = st-append-code st25 (jmp (search-top - (st25.code-len + 5)))
   in let st27 = patch-jcc-at st26 notfound-pos (st26.code-len)
   in let st28 = st-append-code st27 (li reg-rax 0)
   in let st29 = st-append-code st28 (pop-r reg-rbx)
   in st-append-code st29 x86-ret

  emit-cce-decode-unicode-helper : CodegenState -> CodegenState
  emit-cce-decode-unicode-helper (st) =
   let st-pre = emit-unicode-to-cce-tier1-helper st
   in let st0 = record-func-offset st-pre "__cce_decode_unicode"
   in let st1 = st-append-code st0 (lea reg-rax (reg-rdi) 8)
   in let st2 = st-append-code st1 (add-rr reg-rax reg-rsi)
   in let st3 = st-append-code st2 (movzx-byte reg-rcx reg-rax 0)
   in let st4 = st-append-code st3 (movzx-byte reg-rsi reg-rax 1)
   in let st5 = st-append-code st4 (and-ri reg-rcx 31)
   in let st6 = st-append-code st5 (shl-ri reg-rcx 6)
   in let st7 = st-append-code st6 (and-ri reg-rsi 63)
   in let st8 = st-append-code st7 (add-rr reg-rcx reg-rsi)
   in let st9 = st-append-code st8 (mov-rr reg-rsi reg-rcx)
   in let st10 = st-append-code st9 (shr-ri reg-rsi 7)
   in let st11 = emit-load-rodata-addr st10 reg-rax tier1-block-rodata-offset
   in let st12 = st-append-code st11 (add-rr reg-rax reg-rsi)
   in let st13 = st-append-code st12 (movzx-byte reg-rdi reg-rax 0)
   in let st14 = emit-load-rodata-addr st13 reg-rax (tier1-block-rodata-offset + 16)
   in let st15 = st-append-code st14 (add-rr reg-rax reg-rsi)
   in let st16 = st-append-code st15 (movzx-byte reg-rax reg-rax 0)
   in let st17 = st-append-code st16 (shl-ri reg-rax 8)
   in let st18 = st-append-code st17 (add-rr reg-rdi reg-rax)
   in let st19 = st-append-code st18 (and-ri reg-rcx 127)
   in let st20 = st-append-code st19 (mov-rr reg-rax reg-rdi)
   in let st21 = st-append-code st20 (add-rr reg-rax reg-rcx)
   in st-append-code st21 x86-ret

  emit-cce-print-multi-helper : CodegenState -> CodegenState
  emit-cce-print-multi-helper (st) =
   let st-pre = emit-cce-decode-unicode-helper st
   in let st0 = record-func-offset st-pre "__cce_print_multi"
   in let st1 = st-append-code st0 (push-r reg-rbx & push-r reg-r12)
   in let st2 = st-append-code st1 (lea reg-rax (reg-rdi) 8)
   in let st3 = st-append-code st2 (add-rr reg-rax reg-rsi)
   in let st4 = st-append-code st3 (movzx-byte reg-rcx reg-rax 0)
   in let st4a = st-append-code st4 (mov-rr reg-r12 reg-rax)
   in let st4b = st-append-code st4a (mov-rr reg-rbx reg-rcx)
   in let st4c = st-append-code st4b (and-ri reg-rbx 240)
   in let st4d = st-append-code st4c (cmp-ri reg-rbx 224)
   in let tier2-pos = st4d.code-len
   in let st4e = st-append-code st4d (jcc cc-e 0)
   in let st5 = st-append-code st4e (movzx-byte reg-rbx reg-rax 1)
   in let st6 = st-append-code st5 (and-ri reg-rcx 31)
   in let st7 = st-append-code st6 (shl-ri reg-rcx 6)
   in let st8 = st-append-code st7 (and-ri reg-rbx 63)
   in let st9 = st-append-code st8 (add-rr reg-rcx reg-rbx)
   in let st10 = st-append-code st9 (mov-rr reg-rbx reg-rcx)
   in let st11 = st-append-code st10 (shr-ri reg-rbx 7)
   in let st12 = emit-load-rodata-addr st11 reg-rax tier1-block-rodata-offset
   in let st13 = st-append-code st12 (add-rr reg-rax reg-rbx)
   in let st14 = st-append-code st13 (movzx-byte reg-rsi reg-rax 0)
   in let st15 = emit-load-rodata-addr st14 reg-rax (tier1-block-rodata-offset + 16)
   in let st16 = st-append-code st15 (add-rr reg-rax reg-rbx)
   in let st17 = st-append-code st16 (movzx-byte reg-rax reg-rax 0)
   in let st18 = st-append-code st17 (shl-ri reg-rax 8)
   in let st19 = st-append-code st18 (add-rr reg-rsi reg-rax)
   in let st20 = st-append-code st19 (and-ri reg-rcx 127)
   in let st21 = st-append-code st20 (mov-rr reg-rax reg-rsi)
   in let st22 = st-append-code st21 (add-rr reg-rax reg-rcx)
   in let st23 = st-append-code st22 (cmp-ri reg-rax 128)
   in let twobyte-pos = st23.code-len
   in let st24 = st-append-code st23 (jcc cc-ge 0)
   in let st27 = emit-call-to st24 "__serial_put"
   in let t1-skip-pos = st27.code-len
   in let st28 = st-append-code st27 (jmp 0)
   in let st29 = patch-jcc-at st28 twobyte-pos (st28.code-len)
   in let st29a = st-append-code st29 (cmp-ri reg-rax 2048)
   in let t1-3b-pos = st29a.code-len
   in let st29b = st-append-code st29a (jcc cc-ge 0)
   in let st30 = st-append-code st29b (mov-rr reg-rbx reg-rax)
   in let st31 = st-append-code st30 (shr-ri reg-rax 6)
   in let st32 = st-append-code st31 (or-ri reg-rax 192)
   in let st35 = emit-call-to st32 "__serial_put"
   in let st36 = st-append-code st35 (mov-rr reg-rax reg-rbx)
   in let st37 = st-append-code st36 (and-ri reg-rax 63)
   in let st38 = st-append-code st37 (or-ri reg-rax 128)
   in let st41 = emit-call-to st38 "__serial_put"
   in let st42 = patch-jmp-at st41 t1-skip-pos (st41.code-len)
   in let st43 = st-append-code st42 (li reg-rax 2)
   in let st44 = st-append-code st43 (pop-r reg-r12 & pop-r reg-rbx)
   in let st45 = st-append-code st44 x86-ret
   in let stx0 = patch-jcc-at st45 t1-3b-pos (st45.code-len)
   in let stx1 = st-append-code stx0 (mov-rr reg-rbx reg-rax)
   in let stx2 = st-append-code stx1 (shr-ri reg-rax 12)
   in let stx3 = st-append-code stx2 (or-ri reg-rax 224)
   in let stx6 = emit-call-to stx3 "__serial_put"
   in let stx7 = st-append-code stx6 (mov-rr reg-rax reg-rbx)
   in let stx8 = st-append-code stx7 (shr-ri reg-rax 6)
   in let stx9 = st-append-code stx8 (and-ri reg-rax 63)
   in let stx10 = st-append-code stx9 (or-ri reg-rax 128)
   in let stx13 = emit-call-to stx10 "__serial_put"
   in let stx14 = st-append-code stx13 (mov-rr reg-rax reg-rbx)
   in let stx15 = st-append-code stx14 (and-ri reg-rax 63)
   in let stx16 = st-append-code stx15 (or-ri reg-rax 128)
   in let stx19 = emit-call-to stx16 "__serial_put"
   in let stx20 = st-append-code stx19 (li reg-rax 2)
   in let stx21 = st-append-code stx20 (pop-r reg-r12 & pop-r reg-rbx)
   in let stx22 = st-append-code stx21 x86-ret
   in emit-cce-print-tier2-path stx22 tier2-pos

  emit-cce-print-tier2-path : CodegenState, Integer -> CodegenState
  emit-cce-print-tier2-path (st) (tier2-jump-pos) =
   let st0 = patch-jcc-at st tier2-jump-pos (st.code-len)
   in let st1 = st-append-code st0 (movzx-byte reg-rcx reg-r12 0)
   in let st2 = st-append-code st1 (movzx-byte reg-rbx reg-r12 1)
   in let st3 = st-append-code st2 (movzx-byte reg-rsi reg-r12 2)
   in let st4 = st-append-code st3 (and-ri reg-rcx 15)
   in let st5 = st-append-code st4 (shl-ri reg-rcx 12)
   in let st6 = st-append-code st5 (and-ri reg-rbx 63)
   in let st7 = st-append-code st6 (shl-ri reg-rbx 6)
   in let st8 = st-append-code st7 (add-rr reg-rcx reg-rbx)
   in let st9 = st-append-code st8 (and-ri reg-rsi 63)
   in let st10 = st-append-code st9 (add-rr reg-rcx reg-rsi)
   in let st11 = st-append-code st10 (add-ri reg-rcx 2176)
   in let st12 = emit-load-rodata-addr st11 reg-rsi tier2-rodata-offset
   in let st13 = st-append-code st12 (li reg-rbx 0)
   in let scan-top = st13.code-len
   in let st14 = st-append-code st13 (cmp-ri reg-rbx 10)
   in let scan-done-pos = st14.code-len
   in let st15 = st-append-code st14 (jcc cc-ge 0)
   in let st16 = st-append-code st15 (mov-rr reg-rax reg-rbx)
   in let st17 = st-append-code st16 (add-rr reg-rax reg-rbx)
   in let st18 = st-append-code st17 (add-rr reg-rax reg-rbx)
   in let st19 = st-append-code st18 (shl-ri reg-rax 1)
   in let st20 = st-append-code st19 (mov-rr reg-rdi reg-rsi)
   in let st21 = st-append-code st20 (add-rr reg-rdi reg-rax)
   in let st22 = st-append-code st21 (movzx-word reg-rax reg-rdi 0)
   in let st23 = st-append-code st22 (cmp-rr reg-rcx reg-rax)
   in let found-pos = st23.code-len
   in let st24 = st-append-code st23 (jcc cc-l 0)
   in let st25 = st-append-code st24 (add-ri reg-rbx 1)
   in let st26 = st-append-code st25 (jmp (scan-top - (st25.code-len + 5)))
   in let st27 = patch-jcc-at st26 scan-done-pos (st26.code-len)
   in let st28 = st-append-code st27 (li reg-rax 65533)
   in let repl-jmp-pos = st28.code-len
   in let st29 = st-append-code st28 (jmp 0)
   in let st30 = patch-jcc-at st29 found-pos (st29.code-len)
   in let st31 = st-append-code st30 (movzx-byte reg-rax reg-rdi 2)
   in let st32 = st-append-code st31 (movzx-byte reg-rbx reg-rdi 3)
   in let st33 = st-append-code st32 (shl-ri reg-rbx 8)
   in let st34 = st-append-code st33 (add-rr reg-rax reg-rbx)
   in let st35 = st-append-code st34 (movzx-byte reg-rbx reg-rdi 4)
   in let st36 = st-append-code st35 (shl-ri reg-rbx 16)
   in let st37 = st-append-code st36 (add-rr reg-rax reg-rbx)
   in let st38 = st-append-code st37 (movzx-byte reg-rbx reg-rdi 5)
   in let st39 = st-append-code st38 (shl-ri reg-rbx 24)
   in let st40 = st-append-code st39 (add-rr reg-rax reg-rbx)
   in let st41 = st-append-code st40 (add-rr reg-rax reg-rcx)
   in let st42 = patch-jmp-at st41 repl-jmp-pos (st41.code-len)
   in emit-cce-utf8-output st42

  emit-cce-utf8-output : CodegenState -> CodegenState
  emit-cce-utf8-output (st) =
   let st0 = st-append-code st (cmp-ri reg-rax 65536)
   in let fourbyte-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-ge 0)
   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rax)
   in let st3 = st-append-code st2 (shr-ri reg-rax 12)
   in let st4 = st-append-code st3 (or-ri reg-rax 224)
   in let st7 = emit-call-to st4 "__serial_put"
   in let st8 = st-append-code st7 (mov-rr reg-rax reg-rbx)
   in let st9 = st-append-code st8 (shr-ri reg-rax 6)
   in let st10 = st-append-code st9 (and-ri reg-rax 63)
   in let st11 = st-append-code st10 (or-ri reg-rax 128)
   in let st14 = emit-call-to st11 "__serial_put"
   in let st15 = st-append-code st14 (mov-rr reg-rax reg-rbx)
   in let st16 = st-append-code st15 (and-ri reg-rax 63)
   in let st17 = st-append-code st16 (or-ri reg-rax 128)
   in let st20 = emit-call-to st17 "__serial_put"
   in let done-3b-pos = st20.code-len
   in let st21 = st-append-code st20 (jmp 0)
   in let st22 = patch-jcc-at st21 fourbyte-pos (st21.code-len)
   in let st23 = st-append-code st22 (mov-rr reg-rbx reg-rax)
   in let st24 = st-append-code st23 (shr-ri reg-rax 18)
   in let st25 = st-append-code st24 (or-ri reg-rax 240)
   in let st28 = emit-call-to st25 "__serial_put"
   in let st29 = st-append-code st28 (mov-rr reg-rax reg-rbx)
   in let st30 = st-append-code st29 (shr-ri reg-rax 12)
   in let st31 = st-append-code st30 (and-ri reg-rax 63)
   in let st32 = st-append-code st31 (or-ri reg-rax 128)
   in let st35 = emit-call-to st32 "__serial_put"
   in let st36 = st-append-code st35 (mov-rr reg-rax reg-rbx)
   in let st37 = st-append-code st36 (shr-ri reg-rax 6)
   in let st38 = st-append-code st37 (and-ri reg-rax 63)
   in let st39 = st-append-code st38 (or-ri reg-rax 128)
   in let st42 = emit-call-to st39 "__serial_put"
   in let st43 = st-append-code st42 (mov-rr reg-rax reg-rbx)
   in let st44 = st-append-code st43 (and-ri reg-rax 63)
   in let st45 = st-append-code st44 (or-ri reg-rax 128)
   in let st48 = emit-call-to st45 "__serial_put"
   in let st49 = patch-jmp-at st48 done-3b-pos (st48.code-len)
   in let st50 = st-append-code st49 (li reg-rax 3)
   in let st51 = st-append-code st50 (pop-r reg-r12 & pop-r reg-rbx)
   in st-append-code st51 x86-ret

  emit-text-to-unicode-bytes-helper : CodegenState -> CodegenState
  emit-text-to-unicode-bytes-helper (st) =
   let st0 = record-func-offset st "__text_to_unicode_bytes"
   in let st1 = st-append-code st0 (push-r reg-rbx & push-r reg-r12 & push-r reg-r13 & push-r reg-r14 & push-r reg-r15)
   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rdi)
   in let st3 = st-append-code st2 (mov-load reg-r12 reg-rbx 0)
   in let st4 = st-append-code st3 (mov-rr reg-rdi reg-r12)
   in let st4a = st-append-code st4 (shl-ri reg-rdi 3)
   in let st4b = st-append-code st4a (add-ri reg-rdi 8)
   in let st5 = emit-call-to st4b "__alloc"
   in let st6 = st-append-code st5 (mov-rr reg-r13 reg-rax)
   in let st7 = st-append-code st6 (li reg-rsi 0)
   in let st7a = st-append-code st7 (mov-store reg-r13 reg-rsi 0)
   in let st8 = emit-load-rodata-addr st7a reg-r14 cce-to-unicode-rodata-offset
   in let st9 = st-append-code st8 (li reg-rdx 0)
   in let st9a = st-append-code st9 (li reg-r15 0)
   in let loop-top = st9a.code-len
   in let st10 = st-append-code st9a (cmp-rr reg-rdx reg-r12)
   in let done-pos = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-ge 0)
   in let st12 = st-append-code st11 (mov-rr reg-rsi reg-rbx)
   in let st13 = st-append-code st12 (add-rr reg-rsi reg-rdx)
   in let st14 = st-append-code st13 (movzx-byte reg-rsi reg-rsi 8)
   in let st14a = st-append-code st14 (cmp-ri reg-rsi 128)
   in let multi-pos = st14a.code-len
   in let st14b = st-append-code st14a (jcc cc-ge 0)
   in let st15 = st-append-code st14b (add-rr reg-rsi reg-r14)
   in let st16 = st-append-code st15 (movzx-byte reg-rsi reg-rsi 0)
   in let st17 = st-append-code st16 (mov-rr reg-rdi reg-r15)
