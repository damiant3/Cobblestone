 uefi-read-key reads the PS/2 keyboard, not a UEFI system table. After
 ExitBootServices there is no system table at any address -- the old
 body read one through uefi-systab-addr and only ever returned -1 -- so
 console input comes off the same key cell the IRQ1 handler fills from
 port 0x60 (key-buffer-addr). The read is an atomic exchange-with-zero
 so a key is consumed exactly once and does not race the ISR producer,
 masked to the scancode byte; an empty cell reads back 0, which is the
 idle answer every caller already tests for.

  emit-uefi-read-key-helper : CodegenState -> CodegenState

  emit-uefi-read-key-helper (st) =

   let st0 = record-func-offset st "uefi-read-key"

   in let st1 = st-append-code st0 (li reg-rdi key-buffer-addr)

   in let st2 = st-append-code st1 (li reg-rax 0)

   in let st3 = st-append-code st2 [72, 135, 7]

   in let st4 = st-append-code st3 [72, 37, 255, 0, 0, 0]

   in st-append-code st4 x86-ret

 Reads ConIn, which is EFI_SIMPLE_TEXT_INPUT_PROTOCOL at SystemTable+48, and
 calls ReadKeyStroke at vtable offset 8 into an EFI_INPUT_KEY at [rsp+72].

 It used to LocateProtocol EFI_SIMPLE_TEXT_INPUT_EX instead. That protocol is
 UEFI 2.x and OPTIONAL: it worked under OVMF and returned nothing on the ASUS
 TUF's AMI Aptio V, where the probe reported a live SystemTable and a
 succeeding uefi-clear-screen alongside a permanently failing key read. ConIn
 is UEFI 1.x and mandatory, ReadKeyStroke sits at the same offset 8, and the
 first four bytes it writes have the same layout, so the extraction below is
 unchanged.

 The result is ScanCode << 16 | UnicodeChar and nothing else. The Ex path also
 folded EFI_KEY_STATE.KeyShiftState in at bit 32, and that word carries
 EFI_SHIFT_STATE_VALID at bit 31 (0x80000000), which landed on bit 63 -- so
 every SUCCESSFUL read came back negative, indistinguishable from the mov
 rax,-1 failure value below, and callers testing `< 0` read real keystrokes as
 errors for two months. Dropping the field removes the collision by
 construction rather than by masking it. Plain ConIn reports no key state, so
 there is nothing to lose. Account:
 docs/PM/Active/Stories/TheKeyboardWasNeverSilent.md.

 The deck pointer lives in r10 and the firmware call clobbers it (caller-saved
 under the Microsoft x64 ABI), so it is parked in callee-saved r15 across the
 call. That pair was written as raw bytes and the entry half encoded
 `mov r15, rdx`: REX.R clear, so it saved RDX and the exit restored r10 from a
 register that never held it. Every call left the deck pointing at whatever rdx
 happened to be. It was latent while poll-key read the PS/2 cell first and only
 asked the firmware as a fallback; when poll-key was reordered to ask the
 firmware FIRST, it ran on every poll and took six keyboard tests down with it
 (measured 2026-08-03: the raw cell delivered 42/30/170/30 and poll-key-decode
 translated them correctly, while poll-key itself returned zero forever).
 Encoded through mov-rr now, which cannot get the REX bit wrong.

  emit-uefi-read-key-ex-helper : CodegenState -> CodegenState

  emit-uefi-read-key-ex-helper (st) =

   let st0 = record-func-offset st "uefi-read-key-ex"

   in let st1 = st-append-code st0 (push-r reg-rbp & mov-rr reg-rbp reg-rsp & push-r reg-rbx & push-r reg-r12 & push-r reg-r13 & push-r reg-r14 & push-r reg-r15)

   in let st2 = st-append-code st1 [72, 129, 236, 88, 0, 0, 0]

   in let st3 = st-append-code st2 (mov-rr reg-r15 reg-r10)

   in let st8 = st-append-code st3 ([72, 139, 4, 37] & write-i32 uefi-systab-addr)

   in let st8a = st-append-code st8 [72, 133, 192]

   in let have-sys-pos = st8a.code-len

   in let st8b = st-append-code st8a (jcc cc-ne 0)

   in let st8c = st-append-code st8b [72, 199, 192, 255, 255, 255, 255]

   in let nosys-jmp = st8c.code-len

   in let st8d = st-append-code st8c (jmp 0)

   in let st9 = patch-jcc-at st8d have-sys-pos (st8d.code-len)

   in let st10 = st-append-code st9 [76, 139, 104, 48]

   in let st16 = st-append-code st10 [76, 137, 233]

   in let st17 = st-append-code st16 [72, 141, 84, 36, 72]

   in let st18 = st-append-code st17 [65, 255, 85, 8]

   in let st19 = st-append-code st18 [72, 133, 192]

   in let st20 = st-append-code st19 [72, 199, 192, 255, 255, 255, 255]

   in let jnz-pos = st20.code-len

   in let st21 = st-append-code st20 (jcc cc-ne 0)

   in let st22 = st-append-code st21 [15, 183, 68, 36, 72]

   in let st23 = st-append-code st22 [72, 193, 224, 16]

   in let st24 = st-append-code st23 [15, 183, 76, 36, 74]

   in let st25 = st-append-code st24 [72, 9, 200]

   in let st29 = patch-jcc-at st25 jnz-pos (st25.code-len)

   in let st29b = patch-jmp-at st29 nosys-jmp (st29.code-len)

   in let st30 = st-append-code st29b (mov-rr reg-r10 reg-r15)

   in let st31 = st-append-code st30 [72, 129, 196, 88, 0, 0, 0]

   in let st32 = st-append-code st31 (pop-r reg-r15 & pop-r reg-r14 & pop-r reg-r13 & pop-r reg-r12 & pop-r reg-rbx & pop-r reg-rbp)

   in st-append-code st32 x86-ret

Section: Allocator Helpers

  emit-alloc-helper : CodegenState -> CodegenState

  emit-alloc-helper (st) =

   let st1 = record-func-offset st "__alloc"

   in let st2 = st-append-code st1 (mov-rr reg-rax reg-r10 & add-rr reg-r10 reg-rdi)
   in let st-tr = if st.trace-alloc then emit-alloc-trace st2 else st2
   in let st3 = st-append-code st-tr (push-r reg-rcx & push-r reg-rax)
   in let st4 = st-append-code st3 (mov-rr reg-rcx reg-rdi & mov-rr reg-rdi reg-rax)
   in let fill = if st.poison-alloc then li reg-rax 205 else xor-rr reg-rax reg-rax
   in let st5 = st-append-code st4 (fill & cld & rep-stosb)
   in st-append-code st5 (pop-r reg-rax & pop-r reg-rcx & x86-ret)

  emit-alloc-trace : CodegenState -> CodegenState
  emit-alloc-trace (st) =
   let st0 = st-append-code st (push-r reg-r11)
   in let st1 = st-append-code st0 (li reg-r11 trace-enabled-addr)
   in let st2 = st-append-code st1 (mov-load reg-r11 reg-r11 0)
   in let st3 = st-append-code st2 (test-rr reg-r11 reg-r11)
   in let skip-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in let st5 = st-append-code st4 (push-r reg-rcx & push-r reg-rdx)
   in let st6 = st-append-code st5 (li reg-r11 trace-cursor-addr)
   in let st7 = st-append-code st6 (mov-load reg-rcx reg-r11 0)
   in let st8 = st-append-code st7 (cmp-ri reg-rcx trace-max-entries)
   in let full-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ge 0)
   in let st10 = st-append-code st9 (mov-rr reg-rdx reg-rcx)
   in let st11 = st-append-code st10 (shl-ri reg-rdx 4)
   in let st12 = st-append-code st11 (li reg-r11 trace-buf-addr)
   in let st13 = st-append-code st12 (add-rr reg-r11 reg-rdx)
   in let st14 = st-append-code st13 (mov-store reg-r11 reg-rdi 0)
   in let st15 = st-append-code st14 (mov-load reg-rdx reg-rsp 24)
   in let st16 = st-append-code st15 (mov-store reg-r11 reg-rdx 8)
   in let st17 = st-append-code st16 (add-ri reg-rcx 1)
   in let st18 = st-append-code st17 (li reg-r11 trace-cursor-addr)
   in let st19 = st-append-code st18 (mov-store reg-r11 reg-rcx 0)
   in let st20 = patch-jcc-at st19 full-pos (st19.code-len)
   in let st21 = st-append-code st20 (pop-r reg-rdx & pop-r reg-rcx)
   in let st22 = patch-jcc-at st21 skip-pos (st21.code-len)
   in st-append-code st22 (pop-r reg-r11)

