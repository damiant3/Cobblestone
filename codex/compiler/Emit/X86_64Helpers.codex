  emit-fs-servicer-helpers : CodegenState -> CodegenState
  emit-fs-servicer-helpers (st) =
   if find-effect-op-addr (st.effect-op-addrs) "read-text" 0 (list-length (st.effect-op-addrs)) < 0 then st
   else let st1 = emit-fs-read-servicer-helper st
   in emit-fs-write-servicer-helper st1

  emit-fs-read-servicer-helper : CodegenState -> CodegenState
  emit-fs-read-servicer-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "__fs-read-servicer"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st1 = emit-check-capability st0 cap-filesystem-read
   in let deny-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ae 0)
   in let st3 = st-append-code st2 (push-r reg-rdi)
   in let st4 = st-append-code st3 (li reg-rax fs-elevated-addr)
   in let st5 = st-append-code st4 (li reg-rcx 1)
   in let st6 = st-append-code st5 (mov-store reg-rax reg-rcx 0)
   in let st7 = st-append-code st6 (pop-r reg-rdi)
   in let st8 = emit-call-to st7 "fat16-servicer-read"
   in let st9 = st-append-code st8 (push-r reg-rax)
   in let st10 = st-append-code st9 (li reg-rax fs-elevated-addr)
   in let st11 = st-append-code st10 (li reg-rcx 0)
   in let st12 = st-append-code st11 (mov-store reg-rax reg-rcx 0)
   in let st13 = st-append-code st12 (pop-r reg-rax)
   in let st14 = st-append-code st13 x86-ret
   in let deny = st14.code-len
   in let empty = emit-text-lit st14 ""
   in let st15 = st-append-code (empty.state) (mov-rr reg-rax (empty.reg))
   in let st16 = st-append-code st15 x86-ret
   in patch-jcc-at st16 deny-pos deny

  emit-fs-write-servicer-helper : CodegenState -> CodegenState
  emit-fs-write-servicer-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "__fs-write-servicer"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st1 = emit-check-capability st0 cap-filesystem-write
   in let deny-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ae 0)
   in let st3 = st-append-code st2 (push-r reg-rdi)
   in let st3b = st-append-code st3 (push-r reg-rsi)
   in let st4 = st-append-code st3b (li reg-rax fs-elevated-addr)
   in let st5 = st-append-code st4 (li reg-rcx 1)
   in let st6 = st-append-code st5 (mov-store reg-rax reg-rcx 0)
   in let st6b = st-append-code st6 (pop-r reg-rsi)
   in let st7 = st-append-code st6b (pop-r reg-rdi)
   in let st8 = emit-call-to st7 "fat16-servicer-write"
   in let st9 = st-append-code st8 (push-r reg-rax)
   in let st10 = st-append-code st9 (li reg-rax fs-elevated-addr)
   in let st11 = st-append-code st10 (li reg-rcx 0)
   in let st12 = st-append-code st11 (mov-store reg-rax reg-rcx 0)
   in let st13 = st-append-code st12 (pop-r reg-rax)
   in let st14 = st-append-code st13 x86-ret
   in let deny = st14.code-len
   in let st15 = st-append-code st14 (li reg-rax 0)
   in let st16 = st-append-code st15 x86-ret
   in patch-jcc-at st16 deny-pos deny

  emit-prof-start-helper : CodegenState -> CodegenState
  emit-prof-start-helper (st) =
   let st1 = record-func-offset st "__prof_start"
   in let st2 = st-append-code st1 (li reg-rdi prof-enabled-addr)
   in let st3 = st-append-code st2 (li reg-rax 1)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-rax 0)
   in let st5 = st-append-code st4 (li reg-rdi prof-cursor-addr)
   in let st6 = st-append-code st5 (li reg-rax 0)
   in let st7 = st-append-code st6 (mov-store reg-rdi reg-rax 0)
   in st-append-code st7 [195]

  emit-prof-string : CodegenState, List Integer, Integer -> CodegenState
  emit-prof-string (st) (chars) (i) =
   if i >= list-length chars then st
   else emit-prof-string (emit-serial-wait-and-send st (list-at chars i)) chars (i + 1)

  emit-prof-dump-helper : CodegenState -> CodegenState
  emit-prof-dump-helper (st) =
   let st1 = record-func-offset st "__prof_dump"
   in let st2 = st-append-code st1 (push-r reg-rbx)
   in let st3 = st-append-code st2 (push-r reg-r12)
   in let st5 = st-append-code st3 (li reg-rdi prof-enabled-addr)
   in let st6 = st-append-code st5 (li reg-rax 0)
   in let st7 = st-append-code st6 (mov-store reg-rdi reg-rax 0)
   in let st8 = st-append-code st7 (li reg-rdi prof-cursor-addr)
   in let st9 = st-append-code st8 (mov-load reg-r12 reg-rdi 0)
   in let st10 = emit-prof-string st9 [80, 82, 79, 70, 58] 0
   in let st11 = st-append-code st10 (mov-rr reg-rdi reg-r12)
   in let st12 = emit-print-hex-qword-rdi st11
