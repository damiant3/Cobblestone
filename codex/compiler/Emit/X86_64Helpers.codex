   in let st12 = emit-load-rodata-addr st11 reg-rax tier1-block-rodata-offset
   in let st13 = st-append-code st12 (add-rr reg-rax reg-rbx)
   in let st14 = st-append-code st13 (movzx-byte reg-rsi reg-rax 0)
   in let st15 = emit-load-rodata-addr st14 reg-rax (tier1-block-rodata-offset + 16)
   in let st16 = st-append-code st15 (add-rr reg-rax reg-rbx)
   in let st17 = st-append-code st16 (movzx-byte reg-rax reg-rax 0)
   in let st18 = st-append-code st17 (shl-ri reg-rax 8)
   in let st19 = st-append-code st18 (add-rr reg-rsi reg-rax)
