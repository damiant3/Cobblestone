  emit-cce-print-tier2-path : CodegenState, Integer -> CodegenState
  emit-cce-print-tier2-path (st) (tier2-jump-pos) =
   let st0 = patch-jcc-at st tier2-jump-pos (st.code-len)
   in let st1 = st-append-code st0 (movzx-byte reg-rcx reg-r12 0)
   in let st2 = st-append-code st1 (movzx-byte reg-rbx reg-r12 1)
   in let st3 = st-append-code st2 (movzx-byte reg-rsi reg-r12 2)
   in let st4 = st-append-code st3 (and-ri reg-rcx 15)
   in let st5 = st-append-code st4 (shl-ri reg-rcx 12)
   in let st6 = st-append-code st5 (and-ri reg-rbx 63)
   in let st7 = st-append-code st6 (shl-ri reg-rbx 6)
   in let st8 = st-append-code st7 (add-rr reg-rcx reg-rbx)
   in let st9 = st-append-code st8 (and-ri reg-rsi 63)
   in let st10 = st-append-code st9 (add-rr reg-rcx reg-rsi)
   in let st11 = st-append-code st10 (add-ri reg-rcx 2176)
   in let st12 = emit-load-rodata-addr st11 reg-rsi tier2-rodata-offset
   in let st13 = st-append-code st12 (li reg-rbx 0)
   in let scan-top = st13.code-len
   in let st14 = st-append-code st13 (cmp-ri reg-rbx 10)
   in let scan-done-pos = st14.code-len
   in let st15 = st-append-code st14 (jcc cc-ge 0)
   in let st16 = st-append-code st15 (mov-rr reg-rax reg-rbx)
   in let st17 = st-append-code st16 (add-rr reg-rax reg-rbx)
   in let st18 = st-append-code st17 (add-rr reg-rax reg-rbx)
   in let st19 = st-append-code st18 (shl-ri reg-rax 1)
   in let st20 = st-append-code st19 (mov-rr reg-rdi reg-rsi)
   in let st21 = st-append-code st20 (add-rr reg-rdi reg-rax)
   in let st22 = st-append-code st21 (movzx-word reg-rax reg-rdi 0)
   in let st23 = st-append-code st22 (cmp-rr reg-rcx reg-rax)
   in let found-pos = st23.code-len
   in let st24 = st-append-code st23 (jcc cc-l 0)
   in let st25 = st-append-code st24 (add-ri reg-rbx 1)
   in let st26 = st-append-code st25 (jmp (scan-top - (st25.code-len + 5)))
   in let st27 = patch-jcc-at st26 scan-done-pos (st26.code-len)
   in let st28 = st-append-code st27 (li reg-rax 65533)
   in let repl-jmp-pos = st28.code-len
   in let st29 = st-append-code st28 (jmp 0)
   in let st30 = patch-jcc-at st29 found-pos (st29.code-len)
   in let st31 = st-append-code st30 (movzx-byte reg-rax reg-rdi 2)
   in let st32 = st-append-code st31 (movzx-byte reg-rbx reg-rdi 3)
   in let st33 = st-append-code st32 (shl-ri reg-rbx 8)
   in let st34 = st-append-code st33 (add-rr reg-rax reg-rbx)
   in let st35 = st-append-code st34 (movzx-byte reg-rbx reg-rdi 4)
   in let st36 = st-append-code st35 (shl-ri reg-rbx 16)
   in let st37 = st-append-code st36 (add-rr reg-rax reg-rbx)
   in let st38 = st-append-code st37 (movzx-byte reg-rbx reg-rdi 5)
   in let st39 = st-append-code st38 (shl-ri reg-rbx 24)
