   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (add-rr reg-rdi reg-rsi)

   in let g = emit-gpu-mem-guard st1

   in let st2 = st-append-code (g.state) [72, 15, 182, 7]

   in let st3 = st-append-code st2 x86-ret

   in let fail-pos = st3.code-len

   in let st4 = st-append-code st3 (li reg-rax (0 - 1))

   in let st5 = st-append-code st4 x86-ret

   in patch-jcc-at st5 (g.deny-offset) fail-pos

