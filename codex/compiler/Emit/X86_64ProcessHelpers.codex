Chapter: X86-64 Code Generator

 Process lifecycle, spawn, wait, and utility helpers.

Section: Process Scheduler Helpers

  emit-process-resume-helper : CodegenState -> CodegenState
  emit-process-resume-helper (st) =
   let st0 = record-func-offset st "__process_resume"
   in let st1 = st-append-code st0 (mov-load reg-rsp reg-rsi proc-saved-rsp-offset)
   in let st2 = st-append-code st1 (sub-ri reg-rsp 40)
   in let st3 = st-append-code st2 (xor-rr reg-rax reg-rax)
   in let st4 = st-append-code st3 (mov-store reg-rsp reg-rax 32)
   in let st5 = st-append-code st4 (mov-load reg-rax reg-rsi proc-saved-rsp-offset)
   in let st6 = st-append-code st5 (mov-store reg-rsp reg-rax 24)
   in let st7 = st-append-code st6 (mov-load reg-rax reg-rsi proc-saved-rflags-offset)
   in let st8 = st-append-code st7 (mov-store reg-rsp reg-rax 16)
   in let st9 = st-append-code st8 (li reg-rax 8)
   in let st10 = st-append-code st9 (mov-store reg-rsp reg-rax 8)
   in let st11 = st-append-code st10 (mov-load reg-rax reg-rsi proc-saved-rip-offset)
   in let st12 = st-append-code st11 (mov-store reg-rsp reg-rax 0)
   in let st13 = st-append-code st12 (mov-load reg-rbx reg-rsi proc-saved-rbx-offset)
   in let st14 = st-append-code st13 (mov-load reg-rbp reg-rsi proc-saved-rbp-offset)
   in let st15 = st-append-code st14 (mov-load reg-r8 reg-rsi proc-saved-r8-offset)
   in let st16 = st-append-code st15 (mov-load reg-r9 reg-rsi proc-saved-r9-offset)
   in let st17 = st-append-code st16 (mov-load reg-r10 reg-rsi proc-saved-r10-offset)
   in let st18 = st-append-code st17 (mov-load reg-r11 reg-rsi proc-saved-r11-offset)
   in let st19 = st-append-code st18 (mov-load reg-r12 reg-rsi proc-saved-r12-offset)
   in let st20 = st-append-code st19 (mov-load reg-r13 reg-rsi proc-saved-r13-offset)
   in let st21 = st-append-code st20 (mov-load reg-r14 reg-rsi proc-saved-r14-offset)
   in let st22 = st-append-code st21 (mov-load reg-r15 reg-rsi proc-saved-r15-offset)
   in let st23 = st-append-code st22 (mov-load reg-rax reg-rsi proc-saved-rax-offset)
   in let st24 = st-append-code st23 (mov-load reg-rcx reg-rsi proc-saved-rcx-offset)
   in let st25 = st-append-code st24 (mov-load reg-rdx reg-rsi proc-saved-rdx-offset)
   in let st26 = st-append-code st25 (mov-load reg-rdi reg-rsi proc-saved-rdi-offset)
   in let st27 = st-append-code st26 (mov-load reg-rsi reg-rsi proc-saved-rsi-offset)
   in st-append-code st27 iretq

  emit-process-yield-helper : CodegenState -> CodegenState
  emit-process-yield-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-yield"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st1 = st-append-code st0 (li reg-rcx current-proc-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rcx 0)
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (mov-load reg-rsi reg-rsp 0)
   in let st7 = st-append-code st6 (mov-store reg-rcx reg-rsi proc-saved-rip-offset)
   in let st8 = st-append-code st7 (mov-rr reg-rsi reg-rsp)
   in let st9 = st-append-code st8 (add-ri reg-rsi 8)
   in let st10 = st-append-code st9 (mov-store reg-rcx reg-rsi proc-saved-rsp-offset)
   in let st11 = st-append-code st10 (li reg-rsi 514)
   in let st12 = st-append-code st11 (mov-store reg-rcx reg-rsi proc-saved-rflags-offset)
   in let st13 = st-append-code st12 (mov-store reg-rcx reg-r10 proc-saved-r10-offset)
   in let st14 = st-append-code st13 (mov-store reg-rcx reg-rbx proc-saved-rbx-offset)
   in let st15 = st-append-code st14 (mov-store reg-rcx reg-rbp proc-saved-rbp-offset)
   in let st16 = st-append-code st15 (mov-store reg-rcx reg-r12 proc-saved-r12-offset)
   in let st17 = st-append-code st16 (mov-store reg-rcx reg-r13 proc-saved-r13-offset)
   in let st18 = st-append-code st17 (mov-store reg-rcx reg-r14 proc-saved-r14-offset)
   in let st19 = st-append-code st18 (mov-store reg-rcx reg-r15 proc-saved-r15-offset)
   in let st20 = st-append-code st19 (xor-rr reg-rsi reg-rsi)
   in let st21 = st-append-code st20 (mov-store reg-rcx reg-rsi proc-saved-rax-offset)
   in let st22 = st-append-code st21 (li reg-rsi proc-state-ready)
   in let st23 = st-append-code st22 (mov-store reg-rcx reg-rsi 0)
   in let st24 = st-append-code st23 (mov-rr reg-rdx reg-rax)
   in let scan-top = st24.code-len
   in let st25 = st-append-code st24 (add-ri reg-rax 1)
   in let st26 = st-append-code st25 (and-ri reg-rax 15)
   in let st27 = st-append-code st26 (cmp-rr reg-rax reg-rdx)
   in let no-switch = st27.code-len
   in let st28 = st-append-code st27 (jcc cc-e 0)
   in let st29 = st-append-code st28 (mov-rr reg-rsi reg-rax)
   in let st30 = st-append-code st29 (shl-ri reg-rsi 8)
   in let st31 = st-append-code st30 (add-ri reg-rsi proc-table-base)
   in let st32 = st-append-code st31 (mov-load reg-rdi reg-rsi 0)
   in let st33 = st-append-code st32 (cmp-ri reg-rdi proc-state-ready)
   in let not-ready = st33.code-len
   in let st34 = st-append-code st33 (jcc cc-ne 0)
   in let st35 = st-append-code st34 (li reg-rdi current-proc-addr)
   in let st36 = st-append-code st35 (mov-store reg-rdi reg-rax 0)
   in let st37 = st-append-code st36 (li reg-rdi proc-state-running)
   in let st38 = st-append-code st37 (mov-store reg-rsi reg-rdi 0)
   in let st39 = st-append-code st38 (mov-load reg-rdi reg-rsi proc-priority-offset)
   in let st40 = st-append-code st39 (shl-ri reg-rdi 3)
   in let st41 = st-append-code st40 (add-ri reg-rdi slice-table-addr)
   in let st42 = st-append-code st41 (mov-load reg-rdi reg-rdi 0)
   in let st43 = st-append-code st42 (mov-store reg-rsi reg-rdi proc-slice-offset)
   in let st44 = emit-jmp-to st43 "__process_resume"
   in let no-switch-pos = st44.code-len
   in let st45 = st-append-code st44 (li reg-rsi proc-state-running)
   in let st46 = st-append-code st45 (mov-store reg-rcx reg-rsi 0)
   in let st47 = st-append-code st46 (xor-rr reg-rax reg-rax)
   in let st48 = st-append-code st47 x86-ret
   in let st49 = patch-jcc-at st48 no-switch no-switch-pos
   in patch-jcc-at st49 not-ready scan-top

  emit-process-entry-helper : CodegenState -> CodegenState
  emit-process-entry-helper (st) =
   let st0 = record-func-offset st "__proc_entry"
   in let st1 = st-append-code st0 (li reg-rax current-proc-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rax 0)
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (mov-load reg-r11 reg-rcx proc-closure-offset)
   in let st7 = st-append-code st6 (xor-rr reg-rdi reg-rdi)
   in let st8 = st-append-code st7 (mov-load reg-rax reg-r11 0)
   in let st9 = st-append-code st8 [255, 208]
   in emit-call-to st9 "process-exit"

  emit-process-exit-helper : CodegenState -> CodegenState
  emit-process-exit-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-exit"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st1 = st-append-code st0 (li reg-rax current-proc-addr)
   in let st2 = st-append-code st1 (mov-load reg-rax reg-rax 0)
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (li reg-rsi proc-state-free)
   in let st7 = st-append-code st6 (mov-store reg-rcx reg-rsi 0)
   in let ew0 = st-append-code st7 (xor-rr reg-rsi reg-rsi)
   in let wake-top = ew0.code-len
   in let ew1 = st-append-code ew0 (cmp-ri reg-rsi 16)
   in let wake-done = ew1.code-len
   in let ew2 = st-append-code ew1 (jcc cc-ge 0)
   in let ew3 = st-append-code ew2 (mov-rr reg-rdi reg-rsi)
   in let ew4 = st-append-code ew3 (shl-ri reg-rdi 8)
   in let ew5 = st-append-code ew4 (add-ri reg-rdi proc-table-base)
   in let ew6 = st-append-code ew5 (mov-load reg-r8 reg-rdi 0)
   in let ew7 = st-append-code ew6 (cmp-ri reg-r8 proc-state-blocked)
   in let wake-skip = ew7.code-len
   in let ew8 = st-append-code ew7 (jcc cc-ne 0)
   in let ew9 = st-append-code ew8 (mov-load reg-r8 reg-rdi proc-blocked-on-offset)
   in let ew10 = st-append-code ew9 (cmp-rr reg-r8 reg-rax)
   in let wake-skip2 = ew10.code-len
   in let ew11 = st-append-code ew10 (jcc cc-ne 0)
   in let ew12 = st-append-code ew11 (li reg-r8 proc-state-ready)
   in let ew13 = st-append-code ew12 (mov-store reg-rdi reg-r8 0)
   in let wake-next = ew13.code-len
   in let ew14 = st-append-code ew13 (add-ri reg-rsi 1)
   in let ew15 = st-append-code ew14 (jmp (wake-top - (ew14.code-len + 5)))
   in let ew16 = patch-jcc-at ew15 wake-done (ew15.code-len)
   in let ew17 = patch-jcc-at ew16 wake-skip wake-next
   in let ew18 = patch-jcc-at ew17 wake-skip2 wake-next
   in let st8 = st-append-code ew18 (mov-rr reg-rdx reg-rax)
   in let scan-top = st8.code-len
   in let st9 = st-append-code st8 (add-ri reg-rax 1)
   in let st10 = st-append-code st9 (and-ri reg-rax 15)
   in let st11 = st-append-code st10 (cmp-rr reg-rax reg-rdx)
   in let halt-jmp = st11.code-len
   in let st12 = st-append-code st11 (jcc cc-e 0)
   in let st13 = st-append-code st12 (mov-rr reg-rsi reg-rax)
   in let st14 = st-append-code st13 (shl-ri reg-rsi 8)
   in let st15 = st-append-code st14 (add-ri reg-rsi proc-table-base)
   in let st16 = st-append-code st15 (mov-load reg-rdi reg-rsi 0)
   in let st17 = st-append-code st16 (cmp-ri reg-rdi proc-state-ready)
   in let not-ready = st17.code-len
   in let st18 = st-append-code st17 (jcc cc-ne 0)
   in let st19 = st-append-code st18 (li reg-rdi current-proc-addr)
   in let st20 = st-append-code st19 (mov-store reg-rdi reg-rax 0)
   in let st21 = st-append-code st20 (li reg-rdi proc-state-running)
   in let st22 = st-append-code st21 (mov-store reg-rsi reg-rdi 0)
   in let st23 = st-append-code st22 (mov-load reg-rdi reg-rsi proc-priority-offset)
   in let st24 = st-append-code st23 (shl-ri reg-rdi 3)
   in let st25 = st-append-code st24 (add-ri reg-rdi slice-table-addr)
   in let st26 = st-append-code st25 (mov-load reg-rdi reg-rdi 0)
   in let st27 = st-append-code st26 (mov-store reg-rsi reg-rdi proc-slice-offset)
   in let st28 = emit-jmp-to st27 "__process_resume"
   in let halt-pos = st28.code-len
   in let st29 = st-append-code st28 [244]
   in let st30 = st-append-code st29 (jmp (halt-pos - (st29.code-len + 5)))
   in let st31 = patch-jcc-at st30 halt-jmp halt-pos
