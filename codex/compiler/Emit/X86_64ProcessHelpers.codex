Chapter: X86-64 Code Generator

Section: Process Scheduler Helpers

  emit-process-resume-helper : CodegenState -> CodegenState
  emit-process-resume-helper (st) =
   let st0 = record-func-offset st "__process_resume"
   in let st1 = st-append-code st0 (mov-load reg-rsp reg-rsi proc-saved-rsp-offset)
   in let st2 = st-append-code st1 (sub-ri reg-rsp 40)
   in let st3 = st-append-code st2 (xor-rr reg-rax reg-rax)
   in let st4 = st-append-code st3 (mov-store reg-rsp reg-rax 32)
   in let st5 = st-append-code st4 (mov-load reg-rax reg-rsi proc-saved-rsp-offset)
   in let st6 = st-append-code st5 (mov-store reg-rsp reg-rax 24)
   in let st7 = st-append-code st6 (mov-load reg-rax reg-rsi proc-saved-rflags-offset)
   in let st8 = st-append-code st7 (mov-store reg-rsp reg-rax 16)
   in let st9 = st-append-code st8 (li reg-rax 8)
   in let st10 = st-append-code st9 (mov-store reg-rsp reg-rax 8)
   in let st11 = st-append-code st10 (mov-load reg-rax reg-rsi proc-saved-rip-offset)
   in let st12 = st-append-code st11 (mov-store reg-rsp reg-rax 0)
   in let st13 = st-append-code st12 (mov-load reg-rbx reg-rsi proc-saved-rbx-offset)
   in let st14 = st-append-code st13 (mov-load reg-rbp reg-rsi proc-saved-rbp-offset)
   in let st15 = st-append-code st14 (mov-load reg-r8 reg-rsi proc-saved-r8-offset)
   in let st16 = st-append-code st15 (mov-load reg-r9 reg-rsi proc-saved-r9-offset)
   in let st17 = st-append-code st16 (mov-load reg-r10 reg-rsi proc-saved-r10-offset)
   in let st18 = st-append-code st17 (mov-load reg-r11 reg-rsi proc-saved-r11-offset)
   in let st19 = st-append-code st18 (mov-load reg-r12 reg-rsi proc-saved-r12-offset)
   in let st20 = st-append-code st19 (mov-load reg-r13 reg-rsi proc-saved-r13-offset)
   in let st21 = st-append-code st20 (mov-load reg-r14 reg-rsi proc-saved-r14-offset)
   in let st22 = st-append-code st21 (mov-load reg-r15 reg-rsi proc-saved-r15-offset)
   in let st23 = st-append-code st22 (mov-load reg-rax reg-rsi proc-saved-rax-offset)
   in let st24 = st-append-code st23 (mov-load reg-rcx reg-rsi proc-saved-rcx-offset)
   in let st25 = st-append-code st24 (mov-load reg-rdx reg-rsi proc-saved-rdx-offset)
   in let st26 = st-append-code st25 (mov-load reg-rdi reg-rsi proc-saved-rdi-offset)
   in let st27 = st-append-code st26 (mov-load reg-rsi reg-rsi proc-saved-rsi-offset)
   in st-append-code st27 iretq

 Claim first, publish second. The order is the whole correctness argument
 and it is not interchangeable.

 The claim is a LOCK CMPXCHG on the state word (READY -> RUNNING). Losing
 the race is not an error: some other core took that slot, so keep
 scanning. RAX is the comparand and belongs to the instruction, which is
 why the scan cursor lives in R8; R10 is the heap pointer and is never
 touched.

  emit-process-yield-helper : CodegenState -> CodegenState
  emit-process-yield-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-yield"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st2 = emit-load-current-proc st0 reg-rax
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (mov-load reg-rsi reg-rsp 0)
   in let st7 = st-append-code st6 (mov-store reg-rcx reg-rsi proc-saved-rip-offset)
   in let st8 = st-append-code st7 (mov-rr reg-rsi reg-rsp)
   in let st9 = st-append-code st8 (add-ri reg-rsi 8)
   in let st10 = st-append-code st9 (mov-store reg-rcx reg-rsi proc-saved-rsp-offset)
   in let st11 = st-append-code st10 (li reg-rsi 514)
   in let st12 = st-append-code st11 (mov-store reg-rcx reg-rsi proc-saved-rflags-offset)
   in let st13 = st-append-code st12 (mov-store reg-rcx reg-r10 proc-saved-r10-offset)
   in let st14 = st-append-code st13 (mov-store reg-rcx reg-rbx proc-saved-rbx-offset)
   in let st15 = st-append-code st14 (mov-store reg-rcx reg-rbp proc-saved-rbp-offset)
   in let st16 = st-append-code st15 (mov-store reg-rcx reg-r12 proc-saved-r12-offset)
   in let st17 = st-append-code st16 (mov-store reg-rcx reg-r13 proc-saved-r13-offset)
   in let st18 = st-append-code st17 (mov-store reg-rcx reg-r14 proc-saved-r14-offset)
   in let st19 = st-append-code st18 (mov-store reg-rcx reg-r15 proc-saved-r15-offset)
   in let st20 = st-append-code st19 (xor-rr reg-rsi reg-rsi)
   in let st21 = st-append-code st20 (mov-store reg-rcx reg-rsi proc-saved-rax-offset)
   in let y0 = st-append-code st21 (mov-rr reg-rdx reg-rax)
   in let y1 = st-append-code y0 (mov-rr reg-r8 reg-rax)
   in let scan-top = y1.code-len
   in let y2 = st-append-code y1 (add-ri reg-r8 1)
   in let y3 = st-append-code y2 (and-ri reg-r8 15)
   in let y4 = st-append-code y3 (cmp-rr reg-r8 reg-rdx)
   in let no-switch = y4.code-len
   in let y5 = st-append-code y4 (jcc cc-e 0)
   in let y6 = st-append-code y5 (mov-rr reg-rsi reg-r8)
   in let y7 = st-append-code y6 (shl-ri reg-rsi 8)
   in let y8 = st-append-code y7 (add-ri reg-rsi proc-table-base)
   in let ya0 = st-append-code y8 (mov-load reg-rax reg-rsi proc-affinity-offset)
   in let ya1 = st-append-code ya0 (cmp-ri reg-rax (-1))
   in let yaff-ok = ya1.code-len
   in let ya2 = st-append-code ya1 (jcc cc-e 0)
   in let ya3 = st-append-code ya2 (mov-load reg-rdi reg-rcx proc-core-offset)
   in let ya4 = st-append-code ya3 (cmp-rr reg-rax reg-rdi)
   in let yaff-skip = ya4.code-len
   in let ya5 = st-append-code ya4 (jcc cc-ne 0)
   in let ya6 = patch-jcc-at ya5 yaff-ok (ya5.code-len)
   in let y9 = st-append-code ya6 (li reg-rax proc-state-ready)
   in let y10 = st-append-code y9 (li reg-r9 proc-state-running)
   in let y11 = st-append-code y10 (lock-cmpxchg-mem reg-r9 reg-rsi 0)
   in let claim-lost = y11.code-len
   in let y12 = st-append-code y11 (jcc cc-ne 0)
   in let yc1 = st-append-code y12 (mov-load reg-rdi reg-rcx proc-core-offset)
   in let yc2 = st-append-code yc1 (mov-store reg-rsi reg-rdi proc-core-offset)
   in let y13 = st-append-code yc2 (li reg-rdi proc-state-ready)
   in let y14 = st-append-code y13 (mov-store reg-rcx reg-rdi 0)
   in let y15 = st-append-code y14 (mov-load reg-rdi reg-rsi proc-priority-offset)
   in let y16 = st-append-code y15 (shl-ri reg-rdi 3)
   in let y17 = st-append-code y16 (add-ri reg-rdi slice-table-addr)
   in let y18 = st-append-code y17 (mov-load reg-rdi reg-rdi 0)
   in let y19 = st-append-code y18 (mov-store reg-rsi reg-rdi proc-slice-offset)
   in let y20 = emit-jmp-to y19 "__process_resume"
   in let no-switch-pos = y20.code-len
   in let y21 = st-append-code y20 (xor-rr reg-rax reg-rax)
   in let y22 = st-append-code y21 x86-ret
   in let y23 = patch-jcc-at y22 no-switch no-switch-pos
   in let y24 = patch-jcc-at y23 claim-lost scan-top
   in patch-jcc-at y24 yaff-skip scan-top

 Core 0 may claim slot 0; an application processor may not. Slot 0 is the
 program the machine booted, and it owns the boot stack and the main heap.

 A core that completes a full scan of the table without finding claimable
 work executes `hlt` rather than a busy `pause`, so an idle core stops
 burning cycles. Interrupts are enabled here (an application processor
 raised IF when it armed its timer; a core arriving from a block or exit
 kept the flag its process ran with), so the core's own periodic timer
 wakes it within a tick period and the scan resumes past the `hlt`. Work
 published on another core is therefore picked up within one tick rather
 than immediately -- an inter-processor wake would close that gap and is
 the next step. Halting here is only safe because the timer interrupt a
 halted idle core takes lands on its idle stack, and the handler drops any
 tick whose interrupted stack pointer is in the idle-stack band instead of
 mistaking the idle core for the process in slot 0 (see
 emit-common-interrupt-handler). Without that guard a woken idle core
 would preempt the booted program out from under the boot processor.

  emit-idle-dispatch-helper : CodegenState -> CodegenState
  emit-idle-dispatch-helper (st) =
   let st0 = record-func-offset st "__idle_dispatch"
   in let s1 = st-append-code st0 (mov-rr reg-rax reg-r15)
   in let s2 = st-append-code s1 (add-ri reg-rax 1)
   in let s3 = st-append-code s2 (imul-rri reg-rax reg-rax ap-stack-size)
   in let s4 = st-append-code s3 (add-ri reg-rax ap-stacks-base)
   in let s5 = st-append-code s4 (mov-rr reg-rsp reg-rax)
   in let s6 = st-append-code s5 (mov-rr reg-rbp reg-rsp)
   in let s7 = st-append-code s6 (li reg-r14 1)
   in let s8 = st-append-code s7 (test-rr reg-r15 reg-r15)
   in let is-ap = s8.code-len
   in let s9 = st-append-code s8 (jcc cc-ne 0)
   in let s10 = st-append-code s9 (xor-rr reg-r14 reg-r14)
   in let s11 = patch-jcc-at s10 is-ap (s10.code-len)
   in let s12 = st-append-code s11 (mov-rr reg-r8 reg-r15)
   in let scan-top = s12.code-len
   in let s13 = st-append-code s12 (cmp-ri reg-r8 16)
   in let in-range = s13.code-len
   in let s14 = st-append-code s13 (jcc cc-l 0)
   in let s15 = st-append-code s14 (mov-rr reg-r8 reg-r14)
   in let s16 = st-append-code s15 hlt
   in let probe-pos = s16.code-len
   in let s17 = st-append-code s16 (mov-rr reg-rsi reg-r8)
   in let s18 = st-append-code s17 (shl-ri reg-rsi 8)
   in let s19 = st-append-code s18 (add-ri reg-rsi proc-table-base)
   in let af0 = st-append-code s19 (mov-load reg-rdi reg-rsi proc-affinity-offset)
   in let af1 = st-append-code af0 (cmp-ri reg-rdi (-1))
   in let aff-any = af1.code-len
   in let af2 = st-append-code af1 (jcc cc-e 0)
   in let af3 = st-append-code af2 (cmp-rr reg-rdi reg-r15)
   in let aff-skip = af3.code-len
   in let af4 = st-append-code af3 (jcc cc-ne 0)
   in let af5 = patch-jcc-at af4 aff-any (af4.code-len)
   in let s20 = st-append-code af5 (li reg-rax proc-state-ready)
   in let s21 = st-append-code s20 (li reg-r9 proc-state-running)
   in let s22 = st-append-code s21 (lock-cmpxchg-mem reg-r9 reg-rsi 0)
   in let claim-lost = s22.code-len
   in let s23 = st-append-code s22 (jcc cc-ne 0)
   in let s24 = st-append-code s23 (mov-store reg-rsi reg-r15 proc-core-offset)
   in let s25 = st-append-code s24 (test-rr reg-r15 reg-r15)
   in let not-ap = s25.code-len
   in let s26 = st-append-code s25 (jcc cc-e 0)
   in let s27 = st-append-code s26 (li reg-rdi ap-dispatch-count-addr)
   in let s28 = st-append-code s27 (li reg-rax 1)
   in let s29 = st-append-code s28 (lock-xadd-mem reg-rax reg-rdi 0)
   in let s30 = patch-jcc-at s29 not-ap (s29.code-len)
   in let s31 = st-append-code s30 (mov-load reg-rdi reg-rsi proc-priority-offset)
   in let s32 = st-append-code s31 (shl-ri reg-rdi 3)
   in let s33 = st-append-code s32 (add-ri reg-rdi slice-table-addr)
   in let s34 = st-append-code s33 (mov-load reg-rdi reg-rdi 0)
   in let s35 = st-append-code s34 (mov-store reg-rsi reg-rdi proc-slice-offset)
   in let s36 = emit-jmp-to s35 "__process_resume"
   in let next-pos = s36.code-len
   in let s37 = st-append-code s36 (add-ri reg-r8 1)
   in let s38 = st-append-code s37 (jmp (scan-top - (s37.code-len + 5)))
   in let s39 = patch-jcc-at s38 in-range probe-pos
   in let s40 = patch-jcc-at s39 claim-lost next-pos
   in patch-jcc-at s40 aff-skip next-pos

  emit-process-entry-helper : CodegenState -> CodegenState
  emit-process-entry-helper (st) =
   let st0 = record-func-offset st "__proc_entry"
   in let st2 = emit-load-current-proc st0 reg-rax
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (mov-load reg-r11 reg-rcx proc-closure-offset)
   in let st7 = st-append-code st6 (xor-rr reg-rdi reg-rdi)
   in let st8 = st-append-code st7 (mov-load reg-rax reg-r11 0)
   in let st9 = st-append-code st8 [255, 208]
   in let sx0 = emit-load-current-proc st9 reg-rcx
   in let sx1 = st-append-code sx0 (shl-ri reg-rcx 8)
   in let sx2 = st-append-code sx1 (add-ri reg-rcx proc-table-base)
   in let sx3 = st-append-code sx2 (mov-store reg-rcx reg-rax proc-exit-status-offset)
   in emit-call-to sx3 "process-exit-self"

  emit-process-exit-helper : CodegenState -> CodegenState
  emit-process-exit-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-exit-self"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st2 = emit-load-current-proc st0 reg-rax
   in let st3 = st-append-code st2 (mov-rr reg-rcx reg-rax)
   in let st4 = st-append-code st3 (shl-ri reg-rcx 8)
   in let st5 = st-append-code st4 (add-ri reg-rcx proc-table-base)
   in let st6 = st-append-code st5 (li reg-rsi proc-state-free)
   in let st7 = st-append-code st6 (mov-store reg-rcx reg-rsi 0)
   in let st7b = st-append-code st7 (mov-rr reg-r9 reg-rax)
   in let ew0 = st-append-code st7b (xor-rr reg-rsi reg-rsi)
   in let wake-top = ew0.code-len
   in let ew1 = st-append-code ew0 (cmp-ri reg-rsi 16)
   in let wake-done = ew1.code-len
   in let ew2 = st-append-code ew1 (jcc cc-ge 0)
   in let ew3 = st-append-code ew2 (mov-rr reg-rdi reg-rsi)
   in let ew4 = st-append-code ew3 (shl-ri reg-rdi 8)
   in let ew5 = st-append-code ew4 (add-ri reg-rdi proc-table-base)
   in let ew6 = st-append-code ew5 (mov-load reg-r8 reg-rdi 0)
   in let ew7 = st-append-code ew6 (cmp-ri reg-r8 proc-state-blocked)
   in let wake-skip = ew7.code-len
   in let ew8 = st-append-code ew7 (jcc cc-ne 0)
   in let ew9 = st-append-code ew8 (mov-load reg-r8 reg-rdi proc-blocked-on-offset)
   in let ew10 = st-append-code ew9 (cmp-rr reg-r8 reg-r9)
   in let wake-skip2 = ew10.code-len
   in let ew11 = st-append-code ew10 (jcc cc-ne 0)
   in let ews1 = st-append-code ew11 (mov-load reg-r8 reg-rcx proc-exit-status-offset)
   in let ews2 = st-append-code ews1 (mov-store reg-rdi reg-r8 proc-saved-rax-offset)
   in let ew12 = st-append-code ews2 (li reg-rax proc-state-blocked)
   in let ew12b = st-append-code ew12 (li reg-r8 proc-state-ready)
   in let ew13 = st-append-code ew12b (lock-cmpxchg-mem reg-r8 reg-rdi 0)
   in let wake-next = ew13.code-len
   in let ew14 = st-append-code ew13 (add-ri reg-rsi 1)
   in let ew15 = st-append-code ew14 (jmp (wake-top - (ew14.code-len + 5)))
   in let ew16 = patch-jcc-at ew15 wake-done (ew15.code-len)
   in let ew17 = patch-jcc-at ew16 wake-skip wake-next
   in let ew18 = patch-jcc-at ew17 wake-skip2 wake-next
   in let ew18w = emit-wake-ipi ew18
   in let x0 = st-append-code ew18w (mov-load reg-r15 reg-rcx proc-core-offset)
   in emit-jmp-to x0 "__idle_dispatch"

  emit-process-exit-status-helper : CodegenState -> CodegenState
  emit-process-exit-status-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-exit"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st2 = emit-load-current-proc st0 reg-rcx
   in let st3 = st-append-code st2 (shl-ri reg-rcx 8)
   in let st4 = st-append-code st3 (add-ri reg-rcx proc-table-base)
   in let st5 = st-append-code st4 (mov-store reg-rcx reg-rdi proc-exit-status-offset)
   in emit-jmp-to st5 "process-exit-self"

 Spawn-region carve. Child heap and stack come from the slot-indexed
 region spawn-pool-base + slot * spawn-slot-region-size, never from
 the spawner's R10 - a spawned child owns a fixed region, and carving
 a grandchild from the child's own R10 would overlap the child's
 stack. The process table IS the allocator: a slot freed by exit or
 kill frees its region, and the next spawn into that slot reuses the
 same addresses, so a long-running spawn loop plateaus at its working
 set instead of marching across the address space. Every call site
 sets R12 to the claimed slot index before calling; RDX carries the
 region size in; RDI returns the heap base, RSI the stack top.
 process-spawn-with-heap bounds-checks its request against
 spawn-slot-region-size at the call site - a request that cannot fit
 the slot is refused with -1, never silently overlapped.

  emit-spawn-pool-carve-helper : CodegenState -> CodegenState
  emit-spawn-pool-carve-helper (st) =
   let st0 = record-func-offset st "__spawn_pool_carve"
   in let st1 = st-append-code st0 (mov-rr reg-rdi reg-r12)
   in let st2 = st-append-code st1 (shl-ri reg-rdi spawn-slot-region-shift)
   in let st3 = st-append-code st2 (add-ri reg-rdi spawn-pool-base)
   in let st4 = st-append-code st3 (mov-rr reg-rsi reg-rdi)
   in let st5 = st-append-code st4 (add-rr reg-rsi reg-rdx)
   in st-append-code st5 x86-ret

  emit-process-spawn-helper : CodegenState -> CodegenState
  emit-process-spawn-helper (st) =
   let fn-off = st.code-len
   in let n = list-push (st.fo-names) "process-spawn"
   in let o = list-push (st.fo-offsets) fn-off
   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o
   in let st1 = st-append-code st0 (push-r reg-rbx & push-r reg-r12 & push-r reg-r13)
   in let st2 = st-append-code st1 (mov-rr reg-rbx reg-rdi)
   in let cap1 = emit-load-current-proc st2 reg-rcx
   in let cap2 = st-append-code cap1 (shl-ri reg-rcx 8)
   in let cap3 = st-append-code cap2 (add-ri reg-rcx proc-table-base)
   in let cap4 = st-append-code cap3 (mov-load reg-rcx reg-rcx proc-cap-offset)
   in let cap5 = st-append-code cap4 (and-ri reg-rcx (shl-1 cap-process-create))
   in let cap6 = st-append-code cap5 (test-rr reg-rcx reg-rcx)
   in let cap-deny = cap6.code-len
   in let cap7 = st-append-code cap6 (jcc cc-e 0)
   in let st3 = st-append-code cap7 (li reg-rcx 1)
   in let find-top = st3.code-len
   in let st4 = st-append-code st3 (cmp-ri reg-rcx 16)
   in let fail-jmp = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-ge 0)
   in let st6 = st-append-code st5 (mov-rr reg-rdx reg-rcx)
   in let st7 = st-append-code st6 (shl-ri reg-rdx 8)
   in let st8 = st-append-code st7 (add-ri reg-rdx proc-table-base)
   in let st9 = st-append-code st8 (mov-load reg-rsi reg-rdx 0)
   in let st10 = st-append-code st9 (cmp-ri reg-rsi proc-state-free)
   in let found-jmp = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-e 0)
   in let st12 = st-append-code st11 (add-ri reg-rcx 1)
   in let st13 = st-append-code st12 (jmp (find-top - (st12.code-len + 5)))
   in let found-pos = st13.code-len
   in let st14 = patch-jcc-at st13 found-jmp found-pos
   in let st15 = st-append-code st14 (mov-rr reg-r12 reg-rcx)
   in let st16 = st-append-code st15 (mov-rr reg-r13 reg-rdx)
   in let st17 = st-append-code st16 (li reg-rdx (proc-spawn-heap-size + proc-spawn-stack-size))
   in let st19b = emit-call-to st17 "__spawn_pool_carve"
   in let st19c = emit-spawn-stack-pretouch st19b
   in let st20 = emit-load-func-addr st19c reg-rax "__proc_entry"
   in let st21 = st-append-code st20 (mov-store reg-r13 reg-rax proc-saved-rip-offset)
   in let st22 = st-append-code st21 (mov-store reg-r13 reg-rsi proc-saved-rsp-offset)
   in let st23 = st-append-code st22 (mov-store reg-r13 reg-rdi proc-saved-r10-offset)
   in let st24 = st-append-code st23 (li reg-rsi 514)
   in let st25 = st-append-code st24 (mov-store reg-r13 reg-rsi proc-saved-rflags-offset)
   in let st26 = st-append-code st25 (mov-store reg-r13 reg-rbx proc-closure-offset)
   in let st26b = emit-load-current-proc st26 reg-rsi
   in let st26c = st-append-code st26b (shl-ri reg-rsi 8)
   in let st26d = st-append-code st26c (add-ri reg-rsi proc-table-base)
   in let st26e = st-append-code st26d (mov-load reg-rsi reg-rsi proc-cap-offset)
   in let st26f = st-append-code st26e (mov-store reg-r13 reg-rsi proc-cap-offset)
   in let st26g = emit-load-current-proc st26f reg-rsi
   in let st26h = st-append-code st26g (shl-ri reg-rsi 8)
