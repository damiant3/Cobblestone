  pe-uefi-app-stub : Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-uefi-app-stub (text-size) (rodata-size) (start-offset) (data-vaddr) (heap-pages) =
   let stub0 = pe-build-uefi-app-stub text-size rodata-size start-offset data-vaddr 0 heap-pages
   in let stub-size = list-length stub0
   in pe-build-uefi-app-stub text-size rodata-size start-offset data-vaddr stub-size heap-pages

