Chapter: PE Writer
  cites Codex chapter Lists
  cites Emit chapter ELF Writer (write-i16, write-i32, write-i64, pad-zeros, align-up)

Section: PE Format Constants
  pe-machine-amd64 : Integer = 34404
  pe-magic-pe32plus : Integer = 523
  pe-subsystem-efi-app : Integer = 10
  pe-section-code : Integer = 1610612768
  pe-section-idata-read : Integer = 1107296320
  pe-dll-chars-nx : Integer = 352
  pe-file-alignment : Integer = 512
  pe-section-alignment : Integer = 4096
  pe-header-size : Integer = 512

Section: Byte Readers
  pe-read-le32 : List Integer, Integer -> Integer
  pe-read-le32 (b) (off) =
   list-at b off + list-at b (off + 1) * 256 + list-at b (off + 2) * 65536 + list-at b (off + 3) * 16777216

  pe-read-le64 : List Integer, Integer -> Integer
  pe-read-le64 (b) (off) =
   pe-read-le32 b off + pe-read-le32 b (off + 4) * 4294967296

Section: DOS Header
  pe-dos-header : List Integer
  pe-dos-header =
   [77, 90] & pad-zeros 58 & write-i32 128 & pad-zeros (128 - 64)

Section: COFF Header
  pe-coff-header : Integer -> List Integer
  pe-coff-header (optional-hdr-size) =
   write-i16 pe-machine-amd64
   & write-i16 1
   & write-i32 0
   & write-i32 0
   & write-i32 0
   & write-i16 optional-hdr-size
   & write-i16 34

Section: Optional Header
  pe-optional-header : Integer, Integer, Integer -> List Integer
  pe-optional-header (code-size) (entry-rva) (image-size) =
   write-i16 pe-magic-pe32plus
   & [0, 0]
   & write-i32 code-size
   & write-i32 0
   & write-i32 0
   & write-i32 entry-rva
   & write-i32 pe-section-alignment
   & write-i64 0
   & write-i32 pe-section-alignment
   & write-i32 pe-file-alignment
   & pad-zeros 16
   & write-i32 image-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i16 pe-subsystem-efi-app
   & write-i16 0
   & pad-zeros 32
   & write-i32 0
   & write-i32 16
   & pad-zeros 128

Section: Section Header
  pe-text-section-header : Integer, Integer -> List Integer
  pe-text-section-header (virtual-size) (raw-size) =
   [46, 116, 101, 120, 116, 0, 0, 0]
   & write-i32 virtual-size
   & write-i32 pe-section-alignment
   & write-i32 raw-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i32 0
   & write-i16 0
   & write-i16 0
   & write-i32 pe-section-code

Section: UEFI PE Headers
  pe-coff-header-2 : Integer -> List Integer
  pe-coff-header-2 (optional-hdr-size) =
   write-i16 pe-machine-amd64
   & write-i16 2
   & write-i32 0
   & write-i32 0
   & write-i32 0
   & write-i16 optional-hdr-size
   & write-i16 34

  pe-optional-header-uefi : Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-optional-header-uefi (code-size) (entry-rva) (image-size) (reloc-rva) (reloc-size) =
   write-i16 pe-magic-pe32plus
   & [0, 0]
   & write-i32 code-size
   & write-i32 0
   & write-i32 0
   & write-i32 entry-rva
   & write-i32 pe-section-alignment
   & write-i64 0
   & write-i32 pe-section-alignment
   & write-i32 pe-file-alignment
   & pad-zeros 16
   & write-i32 image-size
   & write-i32 pe-header-size
   & write-i32 0
   & write-i16 pe-subsystem-efi-app
   & write-i16 pe-dll-chars-nx
   & pad-zeros 32
   & write-i32 0
   & write-i32 16
   & pad-zeros 40
   & write-i32 reloc-rva
   & write-i32 reloc-size
   & pad-zeros 80

  pe-reloc-section-header : Integer, Integer, Integer -> List Integer
  pe-reloc-section-header (virtual-size) (rva) (raw-offset) =
   [46, 114, 101, 108, 111, 99, 0, 0]
   & write-i32 virtual-size
   & write-i32 rva
   & write-i32 pe-file-alignment
   & write-i32 raw-offset
   & write-i32 0
   & write-i32 0
   & write-i16 0
   & write-i16 0
   & write-i32 pe-section-idata-read

  pe-reloc-dummy : List Integer
  pe-reloc-dummy =
   write-i32 0 & write-i32 8

Section: UEFI Entry Stub
  pe-uefi-stub : Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-uefi-stub (text-size) (rodata-size) (start-offset) (hlt-offset) (data-vaddr) =
   let stub0 = pe-build-stub text-size rodata-size start-offset hlt-offset data-vaddr 0
   in let stub-size = list-length stub0
   in pe-build-stub text-size rodata-size start-offset hlt-offset data-vaddr stub-size

  pe-stub-kernel-prolog : List Integer
  pe-stub-kernel-prolog =
   [85, 72, 137, 229,
    83, 65, 84, 65, 85, 65, 86, 65, 87, 86, 87,
    72, 131, 236, 40,
    73, 137, 215,
    73, 137, 206]

  pe-build-stub : Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-build-stub (text-size) (rodata-size) (start-offset) (hlt-offset) (data-vaddr) (stub-size) =
   let tramp-len = list-length pe-stub-trampoline-template
   in let call-off = list-length pe-stub-kernel-prolog
   in let tramp-data-off = stub-size - tramp-len - call-off
   in let text-data-off = stub-size - call-off
   in let rodata-data-off = stub-size + text-size - call-off
   in pe-stub-kernel-prolog
   & [232, 0, 0, 0, 0,
    91,
    72, 131, 235, 5]
   & pe-stub-alloc-pages ((text-size + rodata-size + 4095) / 4096)
   & pe-stub-copy-section text-data-off text-size 1048576
   & pe-stub-copy-rodata-section rodata-data-off rodata-size data-vaddr
   & pe-stub-patch-hlt-insn hlt-offset
   & pe-stub-store-systable
   & pe-stub-exit-boot-services
   & [185, 27, 0, 0, 0, 15, 50, 37, 255, 247, 255, 255, 15, 48]
   & pe-stub-setup-page-tables
   & pe-stub-copy-trampoline tramp-data-off
   & pe-stub-patch-trampoline start-offset
   & pe-stub-jmp-trampoline
   & pe-stub-trampoline-template

  pe-stub-alloc-pages : Integer -> List Integer
  pe-stub-alloc-pages (pages) =
   [73, 139, 71, 96,
    73, 137, 196,
    72, 199, 68, 36, 32, 0, 0, 16, 0,
    185, 2, 0, 0, 0,
    186, 2, 0, 0, 0,
    65, 184] & write-i32 pages
   & [76, 141, 76, 36, 32,
    65, 255, 84, 36, 40]

  pe-stub-copy-section : Integer, Integer, Integer -> List Integer
  pe-stub-copy-section (data-off) (size) (dest) =
   [72, 141, 179] & write-i32 data-off
   & [72, 199, 199] & write-i32 dest
   & [185] & write-i32 size
   & [243, 164]

  pe-stub-copy-rodata-section : Integer, Integer, Integer -> List Integer
  pe-stub-copy-rodata-section (data-off) (size) (dest) =
   if size == 0 then []
   else [72, 141, 179] & write-i32 data-off
   & [72, 191] & write-i64 dest
   & [185] & write-i32 size
   & [243, 164]

  pe-stub-patch-hlt-insn : Integer -> List Integer
  pe-stub-patch-hlt-insn (hlt-offset) =
   if hlt-offset < 0 then []
   else [72, 191] & write-i64 (1048576 + hlt-offset)
   & [198, 7, 144]

