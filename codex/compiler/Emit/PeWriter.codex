  pe-build-uefi-app-stub : Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  pe-build-uefi-app-stub (text-size) (rodata-size) (start-offset) (data-vaddr) (stub-size) (heap-pages) =
   let call-off = list-length pe-stub-prolog + list-length pe-stub-disable-watchdog + list-length pe-stub-diag-print
   in let text-data-off = stub-size - call-off
   in let rodata-data-off = stub-size + text-size - call-off
   in pe-stub-prolog
   & pe-stub-disable-watchdog
   & pe-stub-diag-print
   & [232, 0, 0, 0, 0,
    91,
    72, 131, 235, 5]
   & pe-stub-alloc-pages ((text-size + rodata-size + 4095) / 4096)
   & pe-stub-diag-print
   & pe-stub-alloc-low-pages heap-pages
   & pe-stub-diag-print
   & pe-stub-store-systable
   & pe-stub-copy-section text-data-off text-size 1048576
   & pe-stub-copy-rodata-section rodata-data-off rodata-size data-vaddr
   & pe-stub-diag-print
   & pe-stub-clear-screen
   & pe-stub-call-start start-offset
   & pe-stub-epilogue

Section: HLT Scan
  pe-find-hlt-in-cdx : List Integer, Integer, Integer -> Integer
  pe-find-hlt-in-cdx (cdx) (text-off) (text-sz) =
   pe-scan-hlt cdx text-off (text-off + text-sz - 8)

  pe-scan-hlt : List Integer, Integer, Integer -> Integer
  pe-scan-hlt (cdx) (i) (limit) =
   if i >= limit then 0 - 1
   else if list-at cdx i == 244 then
    if list-at cdx (i + 1) == 72 then
     if list-at cdx (i + 2) == 199 then
      if list-at cdx (i + 3) == 199 then
       if list-at cdx (i + 4) == 0 then
        if list-at cdx (i + 5) == 112 then
         if list-at cdx (i + 6) == 0 then
          if list-at cdx (i + 7) == 0 then i - (i - i)
          else pe-scan-hlt cdx (i + 1) limit
         else pe-scan-hlt cdx (i + 1) limit
        else pe-scan-hlt cdx (i + 1) limit
       else pe-scan-hlt cdx (i + 1) limit
      else pe-scan-hlt cdx (i + 1) limit
     else pe-scan-hlt cdx (i + 1) limit
    else pe-scan-hlt cdx (i + 1) limit
   else pe-scan-hlt cdx (i + 1) limit

Section: Build PE from CDX Bytes
  build-pe-from-cdx : List Integer -> List Integer
  build-pe-from-cdx (cdx) =
   let text-off = pe-read-le64 cdx 168
   in let text-sz = pe-read-le64 cdx 176
   in let rodata-off = pe-read-le64 cdx 184
   in let rodata-sz = pe-read-le64 cdx 192
   in let entry-off = pe-read-le64 cdx 200
   in let data-vaddr = 1048576 + align-up text-sz 8
   in let hlt-raw = pe-find-hlt-in-cdx cdx text-off text-sz
   in let hlt-off = if hlt-raw < 0 then 0 - 1 else hlt-raw - text-off
   in let text-bytes = pe-extract cdx text-off text-sz
   in let rodata-bytes = pe-extract cdx rodata-off rodata-sz
   in let stub = pe-uefi-stub text-sz rodata-sz entry-off hlt-off data-vaddr
   in let code = stub & text-bytes & rodata-bytes
   in let code-size = list-length code
   in let code-raw = align-up code-size pe-file-alignment
   in let code-sec-end = align-up code-size pe-section-alignment
   in let reloc-rva = pe-section-alignment + code-sec-end
   in let image-size = align-up (reloc-rva + pe-section-alignment) pe-section-alignment
   in let reloc-raw-off = pe-header-size + code-raw
   in let headers = pe-dos-header & [80, 69, 0, 0] & pe-coff-header-2 240 & pe-optional-header-uefi code-raw pe-section-alignment image-size reloc-rva 8 & pe-text-section-header code-size code-raw & pe-reloc-section-header 8 reloc-rva reloc-raw-off
   in let hdr-len = list-length headers
   in let header-pad = pad-zeros (pe-header-size - hdr-len)
   in let code-pad = pad-zeros (code-raw - code-size)
   in let reloc-pad = pad-zeros (pe-file-alignment - 8)
   in headers & header-pad & code & code-pad & pe-reloc-dummy & reloc-pad

  build-uefi-app-pe-from-cdx : List Integer, Integer -> List Integer
  build-uefi-app-pe-from-cdx (cdx) (heap-pages) =
   let text-off = pe-read-le64 cdx 168
   in let text-sz = pe-read-le64 cdx 176
   in let rodata-off = pe-read-le64 cdx 184
   in let rodata-sz = pe-read-le64 cdx 192
   in let entry-off = pe-read-le64 cdx 200
   in let data-vaddr = 1048576 + align-up text-sz 8
   in let text-bytes = pe-extract cdx text-off text-sz
   in let rodata-bytes = pe-extract cdx rodata-off rodata-sz
   in let stub = pe-uefi-app-stub text-sz rodata-sz entry-off data-vaddr heap-pages
   in let code = stub & text-bytes & rodata-bytes
   in let code-size = list-length code
   in let code-raw = align-up code-size pe-file-alignment
   in let code-sec-end = align-up code-size pe-section-alignment
   in let reloc-rva = pe-section-alignment + code-sec-end
   in let image-size = align-up (reloc-rva + pe-section-alignment) pe-section-alignment
   in let reloc-raw-off = pe-header-size + code-raw
   in let headers = pe-dos-header & [80, 69, 0, 0] & pe-coff-header-2 240 & pe-optional-header-uefi code-raw pe-section-alignment image-size reloc-rva 8 & pe-text-section-header code-size code-raw & pe-reloc-section-header 8 reloc-rva reloc-raw-off
   in let hdr-len = list-length headers
   in let header-pad = pad-zeros (pe-header-size - hdr-len)
   in let code-pad = pad-zeros (code-raw - code-size)
   in let reloc-pad = pad-zeros (pe-file-alignment - 8)
   in headers & header-pad & code & code-pad & pe-reloc-dummy & reloc-pad

  pe-extract : List Integer, Integer, Integer -> List Integer
  pe-extract (src) (off) (len) =
   pe-extract-loop src off (off + len) []

  pe-extract-loop : List Integer, Integer, Integer, List Integer -> List Integer
  pe-extract-loop (src) (i) (stop) (acc) =
   if i >= stop then acc
   else pe-extract-loop src (i + 1) stop (list-push acc (list-at src i))

