Chapter: Codex Emitter
  cites Codex chapter Text
  cites Codex chapter Characters
  cites Codex chapter Lists
  cites Codex chapter Concurrency
  cites Codex chapter Build Settings (max-recursion-depth)

 Emits Codex source code from the IR.

Section: Type Definition Emission
  emit-type-defs : List ATypeDef, Integer -> Text
  emit-type-defs (tds) (i) =
   text-concat-list (emit-type-defs-acc tds 0 (list-length tds) [])

  emit-type-defs-acc : List ATypeDef, Integer, Integer, List Text -> List Text
  emit-type-defs-acc (tds) (i) (len) (acc) =
   if i == len then acc
   else emit-type-defs-acc tds (i + 1) len (list-push acc (emit-type-def (list-at tds i) & "\n"))

  emit-type-def : ATypeDef -> Text
  emit-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     let mut-prefix = if is-mut then "mutable " else ""
     in mut-prefix & name.value & emit-tparams tparams 0 & " = record {" & emit-record-field-defs fields 0 & "\n}\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     name.value & emit-tparams tparams 0 & " =\n" & emit-variant-ctors ctors 0

  emit-tparams : List Name, Integer -> Text
  emit-tparams (tparams) (i) =
   text-concat-list (emit-tparams-acc tparams i (list-length tparams) [])

  emit-tparams-acc : List Name, Integer, Integer, List Text -> List Text
  emit-tparams-acc (tparams) (i) (len) (acc) =
   if i == len then acc
   else emit-tparams-acc tparams (i + 1) len (list-push acc (" (" & (list-at tparams i).value & ")"))

  emit-record-field-defs : List ARecordFieldDef, Integer -> Text
  emit-record-field-defs (fields) (i) =
   text-concat-list (emit-record-field-defs-acc fields i (list-length fields) [])

  emit-record-field-defs-acc : List ARecordFieldDef, Integer, Integer, List Text -> List Text
  emit-record-field-defs-acc (fields) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let comma = if i > 0 then "," else ""
   in emit-record-field-defs-acc fields (i + 1) len (list-push acc (comma & "\n  " & f.name.value & " : " & emit-type-expr (f.type-expr)))

  emit-variant-ctors : List AVariantCtorDef, Integer -> Text
  emit-variant-ctors (ctors) (i) =
   text-concat-list (emit-variant-ctors-acc ctors i (list-length ctors) [])

  emit-variant-ctors-acc : List AVariantCtorDef, Integer, Integer, List Text -> List Text
  emit-variant-ctors-acc (ctors) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in emit-variant-ctors-acc ctors (i + 1) len (list-push acc ("  | " & c.name.value & emit-ctor-fields (c.fields) 0 & "\n"))

  emit-ctor-fields : List ATypeExpr, Integer -> Text
  emit-ctor-fields (fields) (i) =
   text-concat-list (emit-ctor-fields-acc fields i (list-length fields) [])

  emit-ctor-fields-acc : List ATypeExpr, Integer, Integer, List Text -> List Text
  emit-ctor-fields-acc (fields) (i) (len) (acc) =
   if i == len then acc
   else emit-ctor-fields-acc fields (i + 1) len (list-push acc (" (" & emit-type-expr (list-at fields i) & ")"))

  emit-type-expr : ATypeExpr -> Text
  emit-type-expr (te) =
   when te
    is ANamedType (name) (s) -> name.value
    is AFunType (p) (r) (s) -> emit-fun-param-chain p r
    is AAppType (base) (args) (s) -> emit-type-expr base & " " & emit-type-expr-args args 0
    is AEffectType (effs) (scopes) (ret) (s) -> "[" & emit-effect-names effs 0 & "] " & emit-type-expr ret
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> emit-type-expr b & " between " & integer-to-text lo & " and " & integer-to-text hi & emit-overflow-mode mode

  emit-overflow-mode : OverflowMode -> Text
  emit-overflow-mode (mode) =
   when mode
    is OvError -> ""
    is OvWrapping -> " wrapping"
    is OvClamping -> " clamping"

  emit-fun-param-chain : ATypeExpr, ATypeExpr -> Text
  emit-fun-param-chain (p) (r) =
   when r
    is AFunType (p2) (r2) (s2) -> emit-fun-param p & ", " & emit-fun-param-chain p2 r2
    is otherwise -> emit-fun-param p & " -> " & emit-type-expr r

  emit-fun-param : ATypeExpr -> Text
  emit-fun-param (te) =
   when te
    is AFunType (p) (r) (s) -> "(" & emit-type-expr te & ")"
    is otherwise -> emit-type-expr te

  emit-type-expr-args : List ATypeExpr, Integer -> Text
  emit-type-expr-args (args) (i) =
   text-concat-list (emit-type-expr-args-acc args i (list-length args) [])

  emit-type-expr-args-acc : List ATypeExpr, Integer, Integer, List Text -> List Text
  emit-type-expr-args-acc (args) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then " " else ""
   in emit-type-expr-args-acc args (i + 1) len (list-push acc (sep & emit-type-expr-wrapped (list-at args i)))

  emit-type-expr-wrapped : ATypeExpr -> Text
  emit-type-expr-wrapped (te) =
   when te
    is AFunType (p) (r) (s) -> "(" & emit-type-expr te & ")"
    is AAppType (base) (args) (s) -> "(" & emit-type-expr te & ")"
    is otherwise -> emit-type-expr te

  emit-effect-names : List Name, Integer -> Text
  emit-effect-names (effs) (i) =
   text-concat-list (emit-effect-names-acc effs i (list-length effs) [])

  emit-effect-names-acc : List Name, Integer, Integer, List Text -> List Text
  emit-effect-names-acc (effs) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then ", " else ""
   in emit-effect-names-acc effs (i + 1) len (list-push acc (sep & (list-at effs i).value))

Section: TypeVar Normalization
  TypeVarMap = record {
   entries : List Integer,
   next-id : Integer between 0 and 65535
  }

  empty-tvar-map : TypeVarMap = TypeVarMap { entries = [], next-id = 0 }

  tvar-map-lookup : List Integer, Integer, Integer -> Integer
  tvar-map-lookup (entries) (id) (i) =
   if i >= list-length entries then -1
   else if list-at entries i == id then i
   else tvar-map-lookup entries id (i + 1)

  tvar-map-insert : TypeVarMap, Integer -> TypeVarMap
  tvar-map-insert (m) (id) =
   if tvar-map-lookup (m.entries) id 0 >= 0 then m
   else TypeVarMap { entries = list-push (m.entries) id, next-id = m.next-id + 1 }

  collect-tvars : CodexType, TypeVarMap -> TypeVarMap
  collect-tvars (ty) (m) =
   when ty
    is TypeVar (id) -> tvar-map-insert m id
    is ForAllTy (id) (body) -> collect-tvars body (tvar-map-insert m id)
    is FunTy (p) (r) -> collect-tvars r (collect-tvars p m)
    is ListTy (elem) -> collect-tvars elem m
    is LinkedListTy (elem) -> collect-tvars elem m
    is EffectfulTy (effs) (sc) (ret) -> collect-tvars ret m
    is ConstructedTy (name) (args) -> collect-tvars-list args 0 m
    is otherwise -> m

  collect-tvars-list : List CodexType, Integer, TypeVarMap -> TypeVarMap
  collect-tvars-list (args) (i) (m) =
   if i == list-length args then m
   else collect-tvars-list args (i + 1) (collect-tvars (list-at args i) m)

  normalize-type : CodexType, TypeVarMap -> CodexType
  normalize-type (ty) (m) =
   when ty
    is TypeVar (id) -> TypeVar (tvar-map-lookup (m.entries) id 0)
    is ForAllTy (id) (body) -> ForAllTy (tvar-map-lookup (m.entries) id 0) (normalize-type body m)
    is FunTy (p) (r) -> FunTy (normalize-type p m) (normalize-type r m)
    is ListTy (elem) -> ListTy (normalize-type elem m)
    is LinkedListTy (elem) -> LinkedListTy (normalize-type elem m)
    is EffectfulTy (effs) (sc) (ret) -> EffectfulTy effs sc (normalize-type ret m)
    is ConstructedTy (name) (args) -> ConstructedTy name (normalize-type-list args 0 m)
    is otherwise -> ty

  normalize-type-list : List CodexType, Integer, TypeVarMap -> List CodexType
  normalize-type-list (args) (i) (m) =
   normalize-type-list-loop args i (list-length args) m []

  normalize-type-list-loop : List CodexType, Integer, Integer, TypeVarMap, List CodexType -> List CodexType
  normalize-type-list-loop (args) (i) (len) (m) (acc) =
   if i == len then acc
   else normalize-type-list-loop args (i + 1) len m (list-push acc (normalize-type (list-at args i) m))

  normalize-type-vars : CodexType -> CodexType
  normalize-type-vars (ty) =
   let m = collect-tvars ty empty-tvar-map
   in if m.next-id == 0 then ty
      else normalize-type ty m

Section: CodexType Emission
  emit-type : CodexType -> Text
  emit-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "Integer"
    is NumberTy -> "Number"
    is TextTy -> "Text"
    is BooleanTy -> "Boolean"
    is CharTy -> "Char"
    is VoidTy -> "Nothing"
    is NothingTy -> "Nothing"
    is ErrorTy -> "Unknown"
    is FunTy (p) (r) -> emit-fun-params p r
    is ListTy (elem) -> "List " & wrap-complex elem
    is LinkedListTy (elem) -> "LinkedList " & wrap-complex elem
    is TypeVar (id) -> "a" & integer-to-text id
    is ForAllTy (id) (body) -> emit-type body
    is SumTy (name) (ty-args) (ctors) -> name.value
    is RecordTy (name) (args) (fields) -> name.value
    is ConstructedTy (name) (args) ->
     if list-length args == 0 then name.value
     else name.value & emit-type-args args 0
    is EffectfulTy (effs) (sc) (ret) -> "[" & emit-type-effect-names effs 0 & "] " & emit-type ret

  emit-fun-params : CodexType, CodexType -> Text
  emit-fun-params (p) (r) =
   when r
    is FunTy (p2) (r2) -> wrap-fun-param p & ", " & emit-fun-params p2 r2
    is otherwise -> wrap-fun-param p & " -> " & emit-type r

  wrap-fun-param : CodexType -> Text
  wrap-fun-param (ty) =
   when ty
    is FunTy (p) (r) -> "(" & emit-type ty & ")"
    is otherwise -> emit-type ty

  wrap-complex : CodexType -> Text
  wrap-complex (ty) =
   when ty
    is FunTy (p) (r) -> "(" & emit-type ty & ")"
    is ListTy (elem) -> "(" & emit-type ty & ")"
    is LinkedListTy (elem) -> "(" & emit-type ty & ")"
    is ConstructedTy (name) (args) ->
     if list-length args == 0 then name.value
     else "(" & emit-type ty & ")"
    is otherwise -> emit-type ty

  emit-type-args : List CodexType, Integer -> Text
  emit-type-args (args) (i) =
   if i == list-length args then ""
   else " " & wrap-complex (list-at args i) & emit-type-args args (i + 1)

  emit-type-effect-names : List Name, Integer -> Text
  emit-type-effect-names (effs) (i) =
   if i == list-length effs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & (list-at effs i).value & emit-type-effect-names effs (i + 1)

Section: Definition Emission
  emit-def : IRDef, List Text -> Text
  emit-def (d) (ctor-names) =
   if skip-def d ctor-names then ""
   else let norm-ty = normalize-type-vars (d.type-val)
   in let sig = d.name & " : " & emit-type norm-ty & "\n" & d.name & emit-def-params (d.params) 0
   in sig & " =\n  " & emit-expr (d.body) ctor-names 2 & "\n"

  skip-def : IRDef, List Text -> Boolean
  skip-def (d) (ctor-names) =
   if text-set-has ctor-names (d.name) then True
   else if text-length (d.name) == 0 then True
   else let first = char-code-at (d.name) 0
   in if first < 13 then True
      else if first > 38 then True
      else False

  emit-def-params : List IRParam, Integer -> Text
  emit-def-params (params) (i) =
   text-concat-list (emit-def-params-acc params i (list-length params) [])

  emit-def-params-acc : List IRParam, Integer, Integer, List Text -> List Text
  emit-def-params-acc (params) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at params i
   in emit-def-params-acc params (i + 1) len (list-push acc (" (" & p.name & ")"))

Section: Expression Emission
  emit-expr : IRExpr, List Text, Integer -> Text
  emit-expr (e) (ctors) (indent) = emit-expr-at e ctors indent 0

  emit-expr-at : IRExpr, List Text, Integer, Integer -> Text
  emit-expr-at (e) (ctors) (indent) (depth) =
   if depth >= max-recursion-depth then "?fuel-exhausted"
   else when e
    is IrIntLit (n) (sp) -> integer-to-text n
    is IrNumLit (n) (sp) -> integer-to-text n
    is IrTextLit (s) (sp) -> "\"" & escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "True" else "False"
    is IrCharLit (n) (sp) -> "'" & escape-char n & "'"
    is IrName (n) (ty) (sp) -> n
    is IrBinary (op) (l) (r) (ty) (sp) -> emit-binary op l r ctors indent
    is IrNegate (operand) (sp) -> "-(" & emit-expr-at operand ctors indent (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> emit-if c t el ctors indent 0
    is IrLet (name) (ty) (val) (body) (sp) -> emit-let name val body ctors indent
    is IrApply (f) (a) (ty) (sp) -> emit-apply e ctors indent
    is IrLambda (params) (body) (ty) (sp) -> emit-lambda params body ctors indent
    is IrList (elems) (ty) (sp) -> emit-list elems ctors indent
    is IrMatch (scrut) (branches) (ty) (sp) -> emit-match scrut branches ctors indent
    is IrAct (stmts) (ty) (sp) -> emit-act stmts ctors indent
    is IrRecord (name) (fields) (ty) (sp) -> emit-record name fields ctors indent
    is IrFieldAccess (rec) (field) (ty) (sp) -> emit-field-access rec field ctors indent
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> emit-field-access rec field ctors indent & " = " & emit-expr val ctors indent
    is IrFork (body) (ty) (sp) -> "fork (" & emit-expr-at body ctors indent (depth + 1) & ")"
    is IrAwait (task) (ty) (sp) -> "await (" & emit-expr-at task ctors indent (depth + 1) & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> emit-handle eff body clauses ctors indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> emit-with-timeout secs effs scopes body ctors indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> emit-try max body fb fail ctors indent
    is IrError (msg) (ty) (sp) -> "0"

Section: Binary Operators
  emit-binary : IRBinaryOp, IRExpr, IRExpr, List Text, Integer -> Text
  emit-binary (op) (l) (r) (ctors) (indent) =
   wrap-binary-left op l ctors indent & " " & bin-op-text op & " " & wrap-binary-right op r ctors indent

  wrap-binary-left : IRBinaryOp, IRExpr, List Text, Integer -> Text
  wrap-binary-left (parent-op) (e) (ctors) (indent) =
   when e
    is IrBinary (child-op) (l2) (r2) (ty) (sp) -> if bin-op-prec child-op < bin-op-prec parent-op then "(" & emit-expr e ctors indent & ")"
    else emit-expr e ctors indent
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-expr e ctors indent & ")"
    is otherwise -> emit-expr e ctors indent

  wrap-binary-right : IRBinaryOp, IRExpr, List Text, Integer -> Text
  wrap-binary-right (parent-op) (e) (ctors) (indent) =
   when e
    is IrBinary (child-op) (l2) (r2) (ty) (sp) -> if needs-right-wrap parent-op child-op then "(" & emit-expr e ctors indent & ")"
    else emit-expr e ctors indent
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & emit-expr e ctors indent & ")"
    is otherwise -> emit-expr e ctors indent

  needs-right-wrap : IRBinaryOp, IRBinaryOp -> Boolean
  needs-right-wrap (parent) (child) =
   if bin-op-prec child < bin-op-prec parent then True
   else if bin-op-prec child > bin-op-prec parent then False
   else if bin-op-text parent == bin-op-text child then if is-associative-op parent then False else True
   else True

  is-associative-op : IRBinaryOp -> Boolean
  is-associative-op (op) =
   when op
    is IrAddInt -> True
    is IrAddNum -> True
    is IrMulInt -> True
    is IrMulNum -> True
    is IrAppendText -> True
    is IrAppendList -> True
    is IrConsList -> True
    is IrAnd -> True
    is IrOr -> True
    is otherwise -> False

  bin-op-prec : IRBinaryOp -> Integer
  bin-op-prec (op) =
   when op
    is IrOr -> 2
    is IrAnd -> 3
    is IrEq -> 4
    is IrNotEq -> 4
    is IrLt -> 4
    is IrGt -> 4
    is IrLtEq -> 4
    is IrGtEq -> 4
    is IrAppendText -> 3
    is IrAppendList -> 3
    is IrConsList -> 5
    is IrAddInt -> 6
    is IrSubInt -> 6
    is IrAddNum -> 6
    is IrSubNum -> 6
    is IrMulInt -> 7
    is IrDivInt -> 7
    is IrMulNum -> 7
    is IrDivNum -> 7
    is IrPowInt -> 8
    is otherwise -> 0

  bin-op-text : IRBinaryOp -> Text
  bin-op-text (op) =
   when op
    is IrAddInt -> "+"
    is IrSubInt -> "-"
    is IrMulInt -> "*"
    is IrDivInt -> "/"
    is IrPowInt -> "^"
    is IrAddNum -> "+"
    is IrSubNum -> "-"
    is IrMulNum -> "*"
    is IrDivNum -> "/"
    is IrEq -> "=="
    is IrNotEq -> "/="
    is IrLt -> "<"
    is IrGt -> ">"
    is IrLtEq -> "<="
    is IrGtEq -> ">="
    is IrAnd -> "&"
    is IrOr -> "|"
    is IrAppendText -> "&"
    is IrAppendList -> "&"
    is IrConsList -> "::"

Section: If/Then/Else
  emit-if : IRExpr, IRExpr, IRExpr, List Text, Integer, Integer -> Text
  emit-if (c) (t) (el) (ctors) (indent) (else-offset) =
   text-concat-list (emit-if-chain c t el ctors indent else-offset [])

  emit-if-chain : IRExpr, IRExpr, IRExpr, List Text, Integer, Integer, List Text -> List Text
  emit-if-chain (c) (t) (el) (ctors) (indent) (else-offset) (acc) =
   let acc2 = list-push acc ("if " & emit-expr c ctors indent & " then " & emit-expr t ctors indent)
   in when el
    is IrIf (c2) (t2) (el2) (ty) (sp) ->
     emit-if-chain c2 t2 el2 ctors indent else-offset (list-push acc2 ("\n" & make-indent indent & pad-spaces else-offset & "else "))
    is otherwise ->
     list-push acc2 ("\n" & make-indent indent & pad-spaces else-offset & "else " & emit-expr el ctors indent)

  pad-spaces : Integer -> Text
  pad-spaces (n) =
   if n <= 0 then ""
   else " " & pad-spaces (n - 1)

Section: Let
  emit-let : Text, IRExpr, IRExpr, List Text, Integer -> Text
  emit-let (name) (val) (body) (ctors) (indent) =
   text-concat-list (emit-let-chain name val body ctors indent [])

  emit-let-chain : Text, IRExpr, IRExpr, List Text, Integer, List Text -> List Text
  emit-let-chain (name) (val) (body) (ctors) (indent) (acc) =
   let acc2 = list-push acc ("let " & name & " = " & emit-expr val ctors (indent + 1))
   in when body
    is IrLet (name2) (ty2) (val2) (body2) (sp2) ->
     emit-let-chain name2 val2 body2 ctors indent (list-push acc2 ("\n" & make-indent indent & "in "))
    is IrIf (c) (t) (el) (ty) (sp) ->
     list-push acc2 ("\n" & make-indent indent & "in " & emit-if c t el ctors indent 3)
    is otherwise ->
     list-push acc2 ("\n" & make-indent indent & "in " & emit-expr body ctors indent)

Section: Apply Chain
  ApplyChain = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> ApplyChain
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> ApplyChain {
     root = e,
     args = acc
    }

Section: Apply
  emit-apply : IRExpr, List Text, Integer -> Text
  emit-apply (e) (ctors) (indent) =
   let chain = collect-apply-chain e []
   in let func = chain.root
   in let args = chain.args
   in emit-expr func ctors indent & emit-apply-args args ctors indent 0 (list-length args) (is-ctor-name func ctors)

  emit-apply-args : List IRExpr, List Text, Integer, Integer, Integer, Boolean -> Text
  emit-apply-args (args) (ctors) (indent) (i) (len) (is-ctor) =
   if i == len then ""
   else let arg = list-at args i
   in " " & wrap-arg arg ctors indent is-ctor & emit-apply-args args ctors indent (i + 1) len is-ctor

  wrap-arg : IRExpr, List Text, Integer, Boolean -> Text
  wrap-arg (e) (ctors) (indent) (is-ctor) =
   if needs-parens e is-ctor then "(" & emit-expr e ctors indent & ")"
   else emit-expr e ctors indent

  is-ctor-name : IRExpr, List Text -> Boolean
  is-ctor-name (e) (ctors) =
   when e
    is IrName (n) (ty) (sp) -> text-set-has ctors n
    is otherwise -> False

  needs-parens : IRExpr, Boolean -> Boolean
  needs-parens (e) (is-ctor) =
   when e
    is IrApply (f) (a) (ty) (sp) -> True
    is IrBinary (op) (l) (r) (ty) (sp) -> True
    is IrIf (c) (t) (el) (ty) (sp) -> True
    is IrLet (name) (ty) (val) (body) (sp) -> True
    is IrMatch (scrut) (branches) (ty) (sp) -> True
    is IrNegate (operand) (sp) -> True
    is IrLambda (params) (body) (ty) (sp) -> True
    is IrFieldAccess (rec) (field) (ty) (sp) -> True
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> True
    is IrRecord (name) (fields) (ty) (sp) -> True
    is IrIntLit (n) (sp) -> n < 0
    is otherwise -> False

Section: Lambda
  emit-lambda : List IRParam, IRExpr, List Text, Integer -> Text
  emit-lambda (params) (body) (ctors) (indent) =
   "\\" & emit-lambda-params params 0 & " -> " & emit-expr body ctors indent

  emit-lambda-params : List IRParam, Integer -> Text
  emit-lambda-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in let sep = if i > 0 then " " else ""
   in sep & p.name & emit-lambda-params params (i + 1)

Section: List
  emit-list : List IRExpr, List Text, Integer -> Text
  emit-list (elems) (ctors) (indent) =
   "[" & emit-list-elems elems ctors indent 0 & "]"

  emit-list-elems : List IRExpr, List Text, Integer, Integer -> Text
  emit-list-elems (elems) (ctors) (indent) (i) =
   text-concat-list (emit-list-elems-acc elems ctors indent i (list-length elems) [])

  emit-list-elems-acc : List IRExpr, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-list-elems-acc (elems) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then ", " else ""
   in emit-list-elems-acc elems ctors indent (i + 1) len (list-push acc (sep & emit-expr (list-at elems i) ctors indent))

Section: Match
  emit-match : IRExpr, List IRBranch, List Text, Integer -> Text
  emit-match (scrut) (branches) (ctors) (indent) =
   "when " & emit-expr scrut ctors indent & emit-branches branches ctors indent 0

  emit-branches : List IRBranch, List Text, Integer, Integer -> Text
  emit-branches (branches) (ctors) (indent) (i) =
   text-concat-list (emit-branches-acc branches ctors indent i (list-length branches) [])

  emit-branches-acc : List IRBranch, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-branches-acc (branches) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at branches i
   in emit-branches-acc branches ctors indent (i + 1) len (list-push acc ("\n" & make-indent (indent + 1) & "is " & emit-pattern (b.pattern) & " -> " & emit-expr (b.body) ctors (indent + 1)))

  emit-pattern : IRPat -> Text
  emit-pattern (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> name
    is IrLitPat (text) (ty) (sp) -> text
    is IrCtorPat (name) (subs) (ty) (sp) -> name & emit-sub-patterns subs 0
    is IrWildPat (sp) -> "otherwise"

  emit-sub-patterns : List IRPat, Integer -> Text
  emit-sub-patterns (subs) (i) =
   text-concat-list (emit-sub-patterns-acc subs i (list-length subs) [])

  emit-sub-patterns-acc : List IRPat, Integer, Integer, List Text -> List Text
  emit-sub-patterns-acc (subs) (i) (len) (acc) =
   if i == len then acc
   else emit-sub-patterns-acc subs (i + 1) len (list-push acc (" (" & emit-pattern (list-at subs i) & ")"))

Section: Act Blocks
  emit-act : List IRActStmt, List Text, Integer -> Text
  emit-act (stmts) (ctors) (indent) =
   "act" & emit-act-stmts stmts ctors indent 0 & "\n" & make-indent indent & "end"

  emit-act-stmts : List IRActStmt, List Text, Integer, Integer -> Text
  emit-act-stmts (stmts) (ctors) (indent) (i) =
   text-concat-list (emit-act-stmts-acc stmts ctors indent i (list-length stmts) [])

  emit-act-stmts-acc : List IRActStmt, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-act-stmts-acc (stmts) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let s = list-at stmts i
   in emit-act-stmts-acc stmts ctors indent (i + 1) len (list-push acc ("\n" & make-indent (indent + 1) & emit-act-stmt s ctors (indent + 1)))

  emit-act-stmt : IRActStmt, List Text, Integer -> Text
  emit-act-stmt (s) (ctors) (indent) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> name & " <- " & emit-expr val ctors indent
    is IrDoExec (e) (sp) -> emit-expr e ctors indent

Section: Records
  emit-record : Text, List IRFieldVal, List Text, Integer -> Text
  emit-record (name) (fields) (ctors) (indent) =
   if list-length fields <= 1 then name & " {" & emit-record-fields-inline fields ctors indent 0 & " }"
   else name & " {\n" & emit-record-fields-multi fields ctors indent 0 & make-indent indent & "}"

  emit-record-fields-inline : List IRFieldVal, List Text, Integer, Integer -> Text
  emit-record-fields-inline (fields) (ctors) (indent) (i) =
   text-concat-list (emit-record-fields-inline-acc fields ctors indent i (list-length fields) [])

  emit-record-fields-inline-acc : List IRFieldVal, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-record-fields-inline-acc (fields) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let sep = if i > 0 then "," else ""
   in emit-record-fields-inline-acc fields ctors indent (i + 1) len (list-push acc (sep & " " & f.name & " = " & emit-expr (f.value) ctors indent))

  emit-record-fields-multi : List IRFieldVal, List Text, Integer, Integer -> Text
  emit-record-fields-multi (fields) (ctors) (indent) (i) =
   text-concat-list (emit-record-fields-multi-acc fields ctors indent i (list-length fields) [])

  emit-record-fields-multi-acc : List IRFieldVal, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-record-fields-multi-acc (fields) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let comma = if i < len - 1 then "," else ""
   in emit-record-fields-multi-acc fields ctors indent (i + 1) len (list-push acc (make-indent (indent + 1) & f.name & " = " & emit-expr (f.value) ctors (indent + 1) & comma & "\n"))

Section: Field Access
  emit-field-access : IRExpr, Text, List Text, Integer -> Text
  emit-field-access (rec) (field) (ctors) (indent) =
   when rec
    is IrName (n) (ty) (sp) -> n & "." & field
    is IrFieldAccess (r) (f) (ty) (sp) -> emit-field-access r f ctors indent & "." & field
    is otherwise -> "(" & emit-expr rec ctors indent & ")." & field

Section: Handle
  emit-handle : Text, IRExpr, List IRHandleClause, List Text, Integer -> Text
  emit-handle (eff) (body) (clauses) (ctors) (indent) =
   "handle " & emit-expr body ctors indent & " with" & emit-handle-clauses clauses ctors indent 0

  emit-handle-clauses : List IRHandleClause, List Text, Integer, Integer -> Text
  emit-handle-clauses (clauses) (ctors) (indent) (i) =
   text-concat-list (emit-handle-clauses-acc clauses ctors indent i (list-length clauses) [])

  emit-handle-clauses-acc : List IRHandleClause, List Text, Integer, Integer, Integer, List Text -> List Text
  emit-handle-clauses-acc (clauses) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at clauses i
   in let param-text = emit-clause-params (c.params) 0 (list-length (c.params))
   in let body-to-emit = unwrap-clause-lambda (c.body) (list-length (c.params))
   in emit-handle-clauses-acc clauses ctors indent (i + 1) len (list-push acc ("\n" & make-indent (indent + 1) & c.op-name & param-text & " (" & c.resume-name & ") -> " & emit-expr body-to-emit ctors (indent + 1)))

  emit-clause-params : List Text, Integer, Integer -> Text
  emit-clause-params (ps) (i) (len) =
   if i >= len then ""
   else " (" & list-at ps i & ")" & emit-clause-params ps (i + 1) len

  unwrap-clause-lambda : IRExpr, Integer -> IRExpr
  unwrap-clause-lambda (e) (n) =
   if n == 0 then e
   else when e
    is IrLambda (ps) (b) (t) (s) -> b
    is otherwise -> e

Section: With-Timeout
  emit-with-timeout : Integer, List Text, List Text, IRExpr, List Text, Integer -> Text
  emit-with-timeout (secs) (effs) (scopes) (body) (ctors) (indent) =
   "with-timeout " & integer-to-text secs & " [" & emit-effect-list effs 0 & "] " & emit-expr body ctors indent

  emit-effect-list : List Text, Integer -> Text
  emit-effect-list (effs) (i) =
   if i == list-length effs then ""
   else if i > 0 then ", " & list-at effs i & emit-effect-list effs (i + 1)
   else list-at effs i & emit-effect-list effs (i + 1)

Section: Trying
  emit-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, List Text, Integer -> Text
  emit-try (max) (body) (fb) (fail) (ctors) (indent) =
   let body-text = emit-act-stmts body ctors indent 0
   in let fb-text = if list-length fb > 0 then "\n" & make-indent indent & "falling back to" & emit-act-stmts fb ctors indent 0 else ""
   in let fail-text = if list-length fail > 0 then "\n" & make-indent indent & "on failure" & emit-act-stmts fail ctors indent 0 else ""
   in "trying " & integer-to-text max & " times" & body-text & fb-text & fail-text & "\n" & make-indent indent & "end"

Section: Utilities
  make-indent : Integer -> Text
  make-indent (n) =
   if n == 0 then ""
   else " " & make-indent (n - 1)

  escape-text : Text -> Text
  escape-text (s) =
   text-concat-list (escape-text-collect s 0 (text-length s) [])

  escape-text-collect : Text, Integer, Integer, List Text -> List Text
  escape-text-collect (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in escape-text-collect s (i + 1) len (list-push acc (escape-one-char c))

  escape-one-char : Integer -> Text
  escape-one-char (c) =
   if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "\"" 0 then "\\\""
   else if c == char-code-at "\n" 0 then "\\n"
   else char-to-text (code-to-char c)

  escape-char : Integer -> Text
  escape-char (c) =
   if c == char-code-at "\n" 0 then "\\n"
   else if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "'" 0 then "\\'"
   else char-to-text (code-to-char c)

Section: Chapter Emission
  emit-codex-text-chapter : IRChapter, List ATypeDef -> Text
  emit-codex-text-chapter (m) (type-defs) =
   let header = if m.chapter-title == "" then ""
      else "Chapter: " & m.chapter-title & "\n\n"
        & if m.prose == "" then "" else " " & m.prose & "\n\n"
   in header & emit-type-defs type-defs 0 & emit-all-defs (m.defs) (m.ctor-names) 0

  emit-all-defs : List IRDef, List Text, Integer -> Text
  emit-all-defs (defs) (ctor-names) (i) =
   text-concat-list (emit-all-defs-acc defs ctor-names 0 (list-length defs) [])

  emit-all-defs-acc : List IRDef, List Text, Integer, Integer, List Text -> List Text
  emit-all-defs-acc (defs) (ctor-names) (i) (len) (acc) =
   if i == len then acc
   else emit-all-defs-acc defs ctor-names (i + 1) len (list-push acc (emit-def (list-at defs i) ctor-names & "\n"))

