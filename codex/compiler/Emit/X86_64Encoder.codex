Section: MOV Instructions
  mov-rr : Integer, Integer -> List Integer
  mov-rr (rd) (rs) =
   if rd == rs then []
   else [rex-w rs rd, 137, modrm 3 rs rd]

  mov-ri64 : Integer, Integer -> List Integer
  mov-ri64 (rd) (imm) =
   [rex True False False (rd >= 8), 184 + int-mod rd 8]
   & write-i64 imm

  mov-ri32 : Integer, Integer -> List Integer
  mov-ri32 (rd) (imm) =
   [rex-w 0 rd, 199, modrm 3 0 rd] & write-i32 imm

  mov-load : Integer, Integer, Integer -> List Integer
  mov-load (rd) (rs) (offset) =
   [rex-w rd rs, 139] & emit-mem-operand rd rs offset

  mov-store : Integer, Integer, Integer -> List Integer
  mov-store (rd) (rs) (offset) =
   [rex-w rs rd, 137] & emit-mem-operand rs rd offset

 A 32-bit store: the same opcode with REX.W clear. Memory-mapped device
 registers are dword-wide and a 64-bit write to one is undefined on real
 silicon, so the LAPIC is written through this and not through mov-store.

  mov-store-32 : Integer, Integer, Integer -> List Integer
  mov-store-32 (rd) (rs) (offset) =
   [rex False (rs >= 8) False (rd >= 8), 137] & emit-mem-operand rs rd offset

  mov-load-rip-rel : Integer, Integer -> List Integer
  mov-load-rip-rel (rd) (disp32) =
   [rex True (rd >= 8) False False, 139, modrm 0 rd 5] & write-i32 disp32

  mov-store-rip-rel : Integer, Integer -> List Integer
  mov-store-rip-rel (rs) (disp32) =
   [rex True (rs >= 8) False False, 137, modrm 0 rs 5] & write-i32 disp32

  movzx-byte : Integer, Integer, Integer -> List Integer
  movzx-byte (rd) (rs) (offset) =
   [rex-w rd rs, 15, 182] & emit-mem-operand rd rs offset

  movsx-byte : Integer, Integer, Integer -> List Integer
  movsx-byte (rd) (rs) (offset) =
   [rex-w rd rs, 15, 190] & emit-mem-operand rd rs offset

  movzx-word : Integer, Integer, Integer -> List Integer
  movzx-word (rd) (rs) (offset) =
   [rex-w rd rs, 15, 183] & emit-mem-operand rd rs offset

  movsx-word : Integer, Integer, Integer -> List Integer
  movsx-word (rd) (rs) (offset) =
   [rex-w rd rs, 15, 191] & emit-mem-operand rd rs offset

  mov-load-u32 : Integer, Integer, Integer -> List Integer
  mov-load-u32 (rd) (rs) (offset) =
   let rex-byte = rex False (rd >= 8) False (rs >= 8)
   in let pfx = if rex-byte /= 64 then [rex-byte] else []
   in pfx & [139] & emit-mem-operand rd rs offset

  movsxd : Integer, Integer, Integer -> List Integer
  movsxd (rd) (rs) (offset) =
   [rex-w rd rs, 99] & emit-mem-operand rd rs offset

  mov-store-byte : Integer, Integer, Integer -> List Integer
  mov-store-byte (rd) (rs) (offset) =
   let rex-byte = rex False (rs >= 8) False (rd >= 8)
   in let pfx = if rex-byte /= 64 | rs >= 4 then [rex-byte] else []
   in pfx & [136] & emit-mem-operand rs rd offset

  mov-store-word : Integer, Integer, Integer -> List Integer
  mov-store-word (rd) (rs) (offset) =
   let rex-byte = rex False (rs >= 8) False (rd >= 8)
   in let pfx = if rex-byte /= 64 then [rex-byte] else []
   in [102] & pfx & [137] & emit-mem-operand rs rd offset

  mov-store-dword : Integer, Integer, Integer -> List Integer
  mov-store-dword (rd) (rs) (offset) =
   let rex-byte = rex False (rs >= 8) False (rd >= 8)
   in let pfx = if rex-byte /= 64 then [rex-byte] else []
   in pfx & [137] & emit-mem-operand rs rd offset

Section: Arithmetic Instructions
  alu-ri : Integer, Integer, Integer -> List Integer
  alu-ri (ext) (rd) (imm) =
   if imm >= -128 & imm <= 127 then [rex-w 0 rd, 131, modrm 3 ext rd] & write-i8 imm
   else [rex-w 0 rd, 129, modrm 3 ext rd] & write-i32 imm

  add-rr : Integer, Integer -> List Integer
  add-rr (rd) (rs) =
   [rex-w rs rd, 1, modrm 3 rs rd]

  add-ri : Integer, Integer -> List Integer
  add-ri (rd) (imm) =
   alu-ri 0 rd imm

  sub-rr : Integer, Integer -> List Integer
  sub-rr (rd) (rs) =
   [rex-w rs rd, 41, modrm 3 rs rd]

  sub-ri : Integer, Integer -> List Integer
  sub-ri (rd) (imm) =
   alu-ri 5 rd imm

  imul-rr : Integer, Integer -> List Integer
  imul-rr (rd) (rs) =
   [rex-w rd rs, 15, 175, modrm 3 rd rs]

  imul-rri : Integer, Integer, Integer -> List Integer
  imul-rri (rd) (rs) (imm) =
   [rex-w rd rs, 105, modrm 3 rd rs] & write-i32 imm

  neg-r : Integer -> List Integer
  neg-r (rd) =
   [rex-w 0 rd, 247, modrm 3 3 rd]

  cqo : List Integer = [rex True False False False, 153]

  idiv-r : Integer -> List Integer
  idiv-r (rs) =
   [rex-w 0 rs, 247, modrm 3 7 rs]

  div-r : Integer -> List Integer
  div-r (rs) =
   [rex-w 0 rs, 247, modrm 3 6 rs]

  and-rr : Integer, Integer -> List Integer
  and-rr (rd) (rs) =
   [rex-w rs rd, 33, modrm 3 rs rd]

  and-ri : Integer, Integer -> List Integer
  and-ri (rd) (imm) =
   alu-ri 4 rd imm

  or-rr : Integer, Integer -> List Integer
  or-rr (rd) (rs) =
   [rex-w rs rd, 9, modrm 3 rs rd]

  or-ri : Integer, Integer -> List Integer
  or-ri (rd) (imm) =
   alu-ri 1 rd imm

  shl-ri : Integer, Integer -> List Integer
  shl-ri (rd) (imm) =
   [rex-w 0 rd, 193, modrm 3 4 rd, imm]

  shr-ri : Integer, Integer -> List Integer
  shr-ri (rd) (imm) =
   [rex-w 0 rd, 193, modrm 3 5 rd, imm]

  shl-cl : Integer -> List Integer
  shl-cl (rd) =
   [rex-w 0 rd, 211, modrm 3 4 rd]

  shr-cl : Integer -> List Integer
  shr-cl (rd) =
   [rex-w 0 rd, 211, modrm 3 5 rd]

  sar-cl : Integer -> List Integer
  sar-cl (rd) =
   [rex-w 0 rd, 211, modrm 3 7 rd]

  not-r : Integer -> List Integer
  not-r (rd) =
   [rex-w 0 rd, 247, modrm 3 2 rd]

  sar-ri : Integer, Integer -> List Integer
  sar-ri (rd) (imm) =
   [rex-w 0 rd, 193, modrm 3 7 rd, imm]

Section: Compare and Test
  cmp-rr : Integer, Integer -> List Integer
  cmp-rr (rd) (rs) =
   [rex-w rs rd, 57, modrm 3 rs rd]

 CMP r64, [disp32]. The SIB no-base form (mod 00, rm 100, index 100, base 101)
 is the only absolute addressing x86-64 offers without a base register, and
 needing no scratch register is the whole reason this exists: the deck guard
 runs at allocation sites where every register is already live.

  cmp-r-abs : Integer, Integer -> List Integer
  cmp-r-abs (rd) (addr) =
   [rex-w rd 0, 59, modrm 0 rd 4, sib 0 4 5] & write-i32 addr

 CMP qword [disp32], imm8, the same no-base SIB form with the group-1 opcode
 and CMP's /7 extension, so the reg field carries the extension and REX.R
 stays clear. It reads the cell without a scratch register, which is what lets
 the deck guard ask whether it is armed at all.

  cmp-abs-imm8 : Integer, Integer -> List Integer
  cmp-abs-imm8 (addr) (imm) =
   [rex-w 0 0, 131, modrm 0 7 4, sib 0 4 5] & write-i32 addr & write-i8 imm

  cmp-ri : Integer, Integer -> List Integer
  cmp-ri (rd) (imm) =
   alu-ri 7 rd imm

  test-rr : Integer, Integer -> List Integer
  test-rr (rd) (rs) =
   [rex-w rs rd, 133, modrm 3 rs rd]

  test-ri : Integer, Integer -> List Integer
  test-ri (rd) (imm) =
   [rex-w 0 rd, 247, modrm 3 0 rd] & write-i32 imm

