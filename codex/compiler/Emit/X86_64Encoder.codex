Section: Stack
  push-r : Integer -> List Integer
  push-r (rd) =
   let pfx = if rd >= 8 then [rex False False False True] else []
   in pfx & [80 + int-mod rd 8]

  push-i32 : Integer -> List Integer
  push-i32 (imm) =
   [104] & write-i32 imm

  pop-r : Integer -> List Integer
  pop-r (rd) =
   let pfx = if rd >= 8 then [rex False False False True] else []
   in pfx & [88 + int-mod rd 8]

Section: LEA
  lea : Integer, Integer, Integer -> List Integer
  lea (rd) (rs) (offset) =
   [rex-w rd rs, 141] & emit-mem-operand rd rs offset

 `lea rd, [base + index]` -- the sum of two registers into a third, which the
 two-operand ALU cannot do in one instruction. It needs the SIB form, so the
 ModRM r/m field is 4 (the escape) and the register pair moves into the SIB
 byte at scale 1. `rex-w` is not enough here because the index needs the X
 bit, which it does not carry.

 Two encoding traps, and the allocator's register pool walks into one of them.
 A SIB base whose low three bits are 5 (RBP, R13) means "no base, disp32" at
 mod 0, so a base of R13 -- which is in the pool -- must be written at mod 1
 with an explicit zero displacement. An index whose low three bits are 4 means
 "no index" unless REX.X is set, so RSP can never be an index and R12 can (X
 disambiguates them); RSP is not allocatable, so only the R12 case arises and
 it encodes correctly.

  lea-rr : Integer, Integer, Integer -> List Integer
  lea-rr (rd) (base-reg) (idx) =
   let r = rex True (rd >= 8) (idx >= 8) (base-reg >= 8)
   in if int-mod base-reg 8 == 5
      then [r, 141, modrm 1 rd 4, sib 0 idx base-reg] & write-i8 0
      else [r, 141, modrm 0 rd 4, sib 0 idx base-reg]

Section: Load Immediate
  li : Integer, Integer -> List Integer
  li (rd) (value) =
   if value == 0 then xor-rr rd rd
   else if value >= -2147483648 & value <= 2147483647 then mov-ri32 rd value
   else mov-ri64 rd value

  xor-rr : Integer, Integer -> List Integer
  xor-rr (rd) (rs) =
   let rex-byte = rex False (rs >= 8) False (rd >= 8)
   in let pfx = if rex-byte /= 64 then [rex-byte] else []
   in pfx & [49, modrm 3 rs rd]

  xor-rr64 : Integer, Integer -> List Integer
  xor-rr64 (rd) (rs) =
   [rex-w rs rd, 49, modrm 3 rs rd]

