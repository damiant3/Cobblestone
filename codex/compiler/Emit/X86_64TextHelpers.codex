   in let st5 = st-append-code st4 (mov-rr reg-rax reg-r11)
   in let st6 = st-append-code st5 (add-rr reg-rax reg-rdx)
   in let st7 = st-append-code st6 (cmp-rr reg-rax reg-r12)
   in let over-pos = st7.code-len
