 The bit loop: acc = 1 (r14); R -= den; then pull 53 bits. Counter at rbx+104.

  emit-ttd-bitloop : CodegenState -> CodegenState
  emit-ttd-bitloop (st) =
    let a0 = st-append-code st (li reg-r14 1)
   in let a1 = st-append-code a0 (lea reg-rdi reg-rbx 32)
   in let a2 = st-append-code a1 (lea reg-rsi reg-rbx 0)
   in let a3 = emit-call-to a2 "__ttd_sub"
   in let a4 = st-append-code a3 (li reg-rcx 53)
   in let a5 = st-append-code a4 (mov-store reg-rbx reg-rcx 104)
   in let bitloop = a5.code-len
   in let b0 = st-append-code a5 (lea reg-rdi reg-rbx 32)
   in let b1 = emit-call-to b0 "__ttd_shl1"
   in let b2 = st-append-code b1 (lea reg-rdi reg-rbx 32)
   in let b3 = st-append-code b2 (lea reg-rsi reg-rbx 0)
   in let b4 = emit-call-to b3 "__ttd_cmp_ge"
   in let b5 = st-append-code b4 (test-rr reg-rax reg-rax)
   in let bit0-pos = b5.code-len
   in let b6 = st-append-code b5 (jcc cc-e 0)
   in let b7 = st-append-code b6 (lea reg-rdi reg-rbx 32)
   in let b8 = st-append-code b7 (lea reg-rsi reg-rbx 0)
   in let b9 = emit-call-to b8 "__ttd_sub"
   in let c0 = st-append-code b9 (shl-ri reg-r14 1)
   in let c1 = st-append-code c0 (or-ri reg-r14 1)
   in let bitnext-pos = c1.code-len
   in let c2 = st-append-code c1 (jmp 0)
   in let bit0 = c2.code-len
   in let c3 = patch-jcc-at c2 bit0-pos bit0
   in let c4 = st-append-code c3 (shl-ri reg-r14 1)
   in let bitnext = c4.code-len
   in let c5 = st-append-code c4 (mov-load reg-rcx reg-rbx 104)
   in let c6 = st-append-code c5 (sub-ri reg-rcx 1)
   in let c7 = st-append-code c6 (mov-store reg-rbx reg-rcx 104)
   in let c8 = st-append-code c7 (test-rr reg-rcx reg-rcx)
   in let c9 = st-append-code c8 (jcc cc-ne (bitloop - (c8.code-len + 6)))
   in let d0 = patch-jmp-at c9 bitnext-pos bitnext
   in d0

 Sticky (r8 nonzero if R != 0), round half-even, assemble the normal bits.

  emit-ttd-finish : CodegenState -> CodegenState
