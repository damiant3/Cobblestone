Section: __text_split

 The list carries a capacity header at [-8], like every list this
 runtime builds: __list-with-capacity, __linked_list_to_list and
 __list_concat_many all store it, and the inlined list-at reads its
 SIGN to pick the inline or the indirect element path. This helper
 alone used to skip the header, so [-8] was whatever the heap held:
 zeros on a fresh VM (positive, inline, correct by luck) and 0xCD
 poison in a REPL session after a failed compile (negative, so every
 element read went through the "indirect" pointer that inline lists
 do not have). That is the defect that killed ten batch-session
 tests -- every quotes-* and prose-* test, all clean standalone --
 at text-starts-with on CCE text bytes used as a pointer.

  emit-text-split-prologue : CodegenState -> CodegenState
  emit-text-split-prologue (st) =
    let st0 = record-func-offset st "__text_split"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (push-r reg-r14)
   in let st5 = st-append-code st4 (push-r reg-r15)
   in let st6 = st-append-code st5 (mov-rr reg-rbx reg-rdi)
   in let st7 = st-append-code st6 (mov-load reg-r12 reg-rbx 0)
   in let st8 = st-append-code st7 (mov-rr reg-r13 reg-rsi)
   in let st8a = st-append-code st8 (mov-rr reg-rax reg-r12)
   in let st8b = st-append-code st8a (add-ri reg-rax 1)
   in let st8c = st-append-code st8b (mov-store reg-r10 reg-rax 0)
   in let st8d = heap-bump-imm st8c 8
   in let st9 = st-append-code st8d (mov-rr reg-r14 reg-r10)
   in let st10 = st-append-code st9 (mov-rr reg-rax reg-r12)
   in let st11 = st-append-code st10 (add-ri reg-rax 2)
   in let st12 = st-append-code st11 (shl-ri reg-rax 3)
   in let st13 = heap-bump-reg st12 reg-rax
   in let st14 = st-append-code st13 (li reg-r15 0)
   in let st15 = st-append-code st14 (li reg-r11 0)
   in st-append-code st15 (mov-rr reg-rcx reg-r11)

