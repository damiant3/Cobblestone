    let a0 = st-append-code st (mov-load reg-r8 reg-rbx 32)
   in let a1 = st-append-code a0 (mov-load reg-rax reg-rbx 40)
   in let a2 = st-append-code a1 (or-rr reg-r8 reg-rax)
   in let a3 = st-append-code a2 (mov-load reg-rax reg-rbx 48)
   in let a4 = st-append-code a3 (or-rr reg-r8 reg-rax)
   in let a5 = st-append-code a4 (mov-load reg-rax reg-rbx 56)
   in let a6 = st-append-code a5 (or-rr reg-r8 reg-rax)
   in let a7 = st-append-code a6 (mov-rr reg-rcx reg-r14)
   in let a8 = st-append-code a7 (and-ri reg-rcx 1)
   in let a9 = st-append-code a8 (mov-rr reg-rax reg-r14)
   in let b0 = st-append-code a9 (shr-ri reg-rax 1)
   in let b1 = st-append-code b0 (mov-rr reg-rdx reg-r12)
   in let b2 = st-append-code b1 (sub-ri reg-rdx 52)
   in let b3 = st-append-code b2 (sub-rr reg-rdx reg-r13)
   in let b4 = st-append-code b3 (test-rr reg-rcx reg-rcx)
   in let noround-pos = b4.code-len
   in let b5 = st-append-code b4 (jcc cc-e 0)
   in let b6 = st-append-code b5 (test-rr reg-r8 reg-r8)
   in let doround-pos = b6.code-len
   in let b7 = st-append-code b6 (jcc cc-ne 0)
   in let b8 = st-append-code b7 (test-ri reg-rax 1)
   in let noround2-pos = b8.code-len
   in let b9 = st-append-code b8 (jcc cc-e 0)
   in let doround = b9.code-len
   in let c0 = st-append-code b9 (add-ri reg-rax 1)
   in let c1 = st-append-code c0 (li reg-r9 9007199254740992)
   in let c2 = st-append-code c1 (cmp-rr reg-rax reg-r9)
   in let nocarry-pos = c2.code-len
   in let c3 = st-append-code c2 (jcc cc-ne 0)
   in let c4 = st-append-code c3 (shr-ri reg-rax 1)
   in let c5 = st-append-code c4 (add-ri reg-rdx 1)
   in let noround = c5.code-len
   in let d0 = st-append-code c5 (add-ri reg-rdx 1075)
   in let d1 = st-append-code d0 (li reg-r9 4503599627370496)
   in let d2 = st-append-code d1 (sub-rr reg-rax reg-r9)
   in let d3 = st-append-code d2 (shl-ri reg-rdx 52)
   in let d4 = st-append-code d3 (or-rr reg-rax reg-rdx)
   in let d5 = st-append-code d4 (mov-load reg-r10 reg-rbx 96)
   in let d6 = st-append-code d5 (test-rr reg-r10 reg-r10)
   in let fin-pos = d6.code-len
   in let d7 = st-append-code d6 (jcc cc-e 0)
   in let d8 = st-append-code d7 (li reg-r9 1)
   in let d9 = st-append-code d8 (shl-ri reg-r9 63)
   in let e0 = st-append-code d9 (or-rr reg-rax reg-r9)
   in let fin = e0.code-len
   in let p1 = patch-jcc-at e0 noround-pos noround
   in let p2 = patch-jcc-at p1 doround-pos doround
   in let p3 = patch-jcc-at p2 noround2-pos noround
   in let p4 = patch-jcc-at p3 nocarry-pos noround
   in let p5 = patch-jcc-at p4 fin-pos fin
   in emit-ttd-epilogue p5

  emit-text-to-double : CodegenState -> CodegenState
  emit-text-to-double (st) =
    let s0 = emit-ttd-shl1 st
   in let s1 = emit-ttd-cmp-ge s0
   in let s2 = emit-ttd-sub s1
   in let s3 = emit-ttd-mul5 s2
   in let st0 = emit-ttd-prologue s3
   in let pr = emit-ttd-parse2 st0
   in let z0 = st-append-code (pr.cg) (test-rr reg-rax reg-rax)
   in let nz-pos = z0.code-len
   in let z1 = st-append-code z0 (jcc cc-ne 0)
   in let zeroret-pos = z1.code-len
   in let z2 = emit-ttd-zero-ret z1
   in let nz = z2.code-len
   in let m0 = emit-ttd-init-bufs z2
   in let m1 = emit-ttd-pow5 m0
   in let m2 = emit-ttd-normalise2 m1
   in let m3 = emit-ttd-bitloop m2
   in let m4 = emit-ttd-finish m3
   in let p1 = patch-jcc-at m4 (pr.empty) zeroret-pos
   in patch-jcc-at p1 nz-pos nz

Section: __real_to_text
  emit-number-to-text-setup : CodegenState -> HelpResult2
  emit-number-to-text-setup (st) =
    let st0 = record-func-offset st "__real_to_text"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (sub-ri reg-rsp 48)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rdi)
   in let st6 = st-append-code st5 (shr-ri reg-r12 63)
   in let st7 = st-append-code st6 (shl-ri reg-rdi 1)
   in let st8 = st-append-code st7 (shr-ri reg-rdi 1)
   in let st9 = st-append-code st8 (movq-to-xmm 0 reg-rdi)
   in let st10 = st-append-code st9 (test-rr reg-rdi reg-rdi)
   in let zero-pos = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-e 0)
   in let st12 = st-append-code st11 (cvttsd2si reg-rbx 0)
   in let st13 = st-append-code st12 (cvtsi2sd 1 reg-rbx)
   in let st14 = st-append-code st13 (subsd-xmm 0 1)
   in let st15 = st-append-code st14 (li reg-rcx 0)
   in let st16 = st-append-code st15 (li reg-r11 10)
   in let st17 = st-append-code st16 (test-rr reg-rbx reg-rbx)
   in let nonzero-int-pos = st17.code-len
   in let st18 = st-append-code st17 (jcc cc-ne 0)
   in let st19 = st-append-code st18 (li reg-rsi 3)
   in let st20 = st-append-code st19 (mov-store-byte reg-rsp reg-rsi 0)
   in let st21 = st-append-code st20 (li reg-rcx 1)
   in let skip-int-pos = st21.code-len
   in let st22 = st-append-code st21 (jmp 0)
   in let st23 = patch-jcc-at st22 nonzero-int-pos (st22.code-len)
   in HelpResult2 {
    cg = st23,
    p1 = zero-pos,
    p2 = skip-int-pos
   }

  emit-number-to-text-int-digits : CodegenState -> CodegenState
  emit-number-to-text-int-digits (st) =
    let digit-loop = st.code-len
   in let st0 = st-append-code st (test-rr reg-rbx reg-rbx)
   in let digit-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-e 0)
   in let st2 = st-append-code st1 (mov-rr reg-rax reg-rbx)
   in let st3 = st-append-code st2 (xor-rr reg-rdx reg-rdx)
   in let st4 = st-append-code st3 (div-r reg-r11)
   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-rax)
   in let st6 = st-append-code st5 (add-ri reg-rdx 3)
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-rsp)
   in let st8 = st-append-code st7 (add-rr reg-rsi reg-rcx)
   in let st9 = st-append-code st8 (mov-store-byte reg-rsi reg-rdx 0)
   in let st10 = st-append-code st9 (add-ri reg-rcx 1)
   in let st11 = st-append-code st10 (jmp (digit-loop - (st10.code-len + 5)))
   in patch-jcc-at st11 digit-done-pos (st11.code-len)

 The 48-byte frame splits at 24, not at 16. The integer digits fill upward
 from `rsp` and the fraction digits from `rsp + 24`, so the split is the
 integer region's size and it must exceed the widest integer part
 `cvttsd2si` can deliver: that is an i64, whose maximum is 19 digits. The
 split was 16, so an integer part of 17 or more digits ran into the
 fraction region and was overwritten -- silently, and as a DIGIT
 SUBSTITUTION rather than a truncation, because the digits are stored
 least-significant-first and the overrun lands on the most significant end.
 With no fraction to write, the zero-fraction path below stored CCE 3 at
 the split and turned that digit into '0': `12345678901234567.0` printed as
 `02345678901234566.0` and `123456789012345678.0` as
 `103456789012345680.0`, while `real-to-int` on the same values was right.
 The fraction loop is capped at 15 digits, so 24 leaves both regions inside
 the frame with room to spare.

  emit-number-to-text-frac-digits : CodegenState -> CodegenState
  emit-number-to-text-frac-digits (st) =
    let st0 = st-append-code st (mov-rr reg-r13 reg-rcx)
   in let st1 = st-append-code st0 (li reg-rdx 4621819117588971520)
   in let st2 = st-append-code st1 (movq-to-xmm 1 reg-rdx)
   in let st3 = st-append-code st2 (li reg-r8 0)
   in let st4 = st-append-code st3 (li reg-r9 15)
   in let frac-loop = st4.code-len
   in let st5 = st-append-code st4 (cmp-rr reg-r8 reg-r9)
   in let frac-done-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ge 0)
   in let st7 = st-append-code st6 (mulsd-xmm 0 1)
   in let st8 = st-append-code st7 (cvttsd2si reg-rdx 0)
   in let st9 = st-append-code st8 (cvtsi2sd 2 reg-rdx)
   in let st10 = st-append-code st9 (subsd-xmm 0 2)
   in let st11 = st-append-code st10 (add-ri reg-rdx 3)
   in let st12 = st-append-code st11 (mov-rr reg-rsi reg-rsp)
   in let st13 = st-append-code st12 (add-ri reg-rsi 24)
   in let st14 = st-append-code st13 (add-rr reg-rsi reg-r8)
   in let st15 = st-append-code st14 (mov-store-byte reg-rsi reg-rdx 0)
   in let st16 = st-append-code st15 (add-ri reg-r8 1)
   in let st17 = st-append-code st16 (movq-from-xmm reg-rdi 0)
   in let st18 = st-append-code st17 (test-rr reg-rdi reg-rdi)
   in let early-exit-pos = st18.code-len
   in let st19 = st-append-code st18 (jcc cc-e 0)
   in let st20 = st-append-code st19 (jmp (frac-loop - (st19.code-len + 5)))
   in let st21 = patch-jcc-at st20 frac-done-pos (st20.code-len)
   in let st22 = patch-jcc-at st21 early-exit-pos (st21.code-len)
   in let st23 = st-append-code st22 (test-rr reg-r8 reg-r8)
   in let has-frac-pos = st23.code-len
   in let st24 = st-append-code st23 (jcc cc-ne 0)
   in let st25 = st-append-code st24 (li reg-rsi 3)
   in let st26 = st-append-code st25 (mov-rr reg-rax reg-rsp)
   in let st27 = st-append-code st26 (add-ri reg-rax 24)
   in let st28 = st-append-code st27 (mov-store-byte reg-rax reg-rsi 0)
   in let st29 = st-append-code st28 (li reg-r8 1)
   in patch-jcc-at st29 has-frac-pos (st29.code-len)

