   in let st5 = st-append-code st4 (add-rr reg-rax reg-rsi)
   in let st6 = st-append-code st5 (movzx-byte reg-rax reg-rax 8)
   in let st7 = st-append-code st6 (mov-rr reg-rdi reg-r14)
   in let st8 = st-append-code st7 (add-rr reg-rdi reg-r15)
